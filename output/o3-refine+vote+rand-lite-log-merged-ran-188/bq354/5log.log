--Description: 1)  Look at the ICD-10-CM catalog to confirm that all acne/atopic-dermatitis/psoriasis/vitiligo
--               codes (L70, L20, L40, L80) exist and note their sub-categories.
SELECT cm_code,
       short_description
FROM   `bigquery-public-data.cms_codes.icd10_diagnoses_2019`
WHERE  cm_code IN ('L70', 'L20', 'L40', 'L80')
   OR  cm_code LIKE 'L70%'  -- acne family
   OR  cm_code LIKE 'L20%'  -- atopic dermatitis family
   OR  cm_code LIKE 'L40%'  -- psoriasis family
   OR  cm_code LIKE 'L80%'  -- vitiligo family
LIMIT 20;
