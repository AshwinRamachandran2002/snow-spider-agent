```sql
--Description: 1)  Look at the ICD-10-CM catalog to confirm that all acne/atopic-dermatitis/psoriasis/vitiligo
--               codes (L70, L20, L40, L80) exist and note their sub-categories.
SELECT cm_code,
       short_description
FROM   `bigquery-public-data.cms_codes.icd10_diagnoses_2019`
WHERE  cm_code IN ('L70', 'L20', 'L40', 'L80')
   OR  cm_code LIKE 'L70%'  -- acne family
   OR  cm_code LIKE 'L20%'  -- atopic dermatitis family
   OR  cm_code LIKE 'L40%'  -- psoriasis family
   OR  cm_code LIKE 'L80%'  -- vitiligo family
LIMIT 20;
```

```sql
--Description: 2)  Pull every concept_id belonging to the four ICD-10-CM families from the OMOP vocabulary.
SELECT concept_id,
       concept_code,
       concept_name
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
WHERE  vocabulary_id = 'ICD10CM'
  AND  (concept_code LIKE 'L70%'    -- acne
        OR concept_code LIKE 'L20%' -- atopic dermatitis
        OR concept_code LIKE 'L40%' -- psoriasis
        OR concept_code LIKE 'L80%') -- vitiligo
LIMIT 20;
```

```sql
--Description: 3)  Map those non-standard ICD-10-CM concepts to their STANDARD concepts through
--               the “Maps to” relationship (concept_id_1 = ICD-10, concept_id_2 = standard).
SELECT cr.concept_id_1      AS source_icd10cm_id,
       c1.concept_code      AS source_icd10cm_code,
       cr.concept_id_2      AS standard_concept_id,
       c2.concept_name      AS standard_name,
       c2.vocabulary_id
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`          c1
       ON c1.concept_id = cr.concept_id_1
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`          c2
       ON c2.concept_id = cr.concept_id_2
WHERE  cr.relationship_id = 'Maps to'
  AND  c1.vocabulary_id    = 'ICD10CM'
  AND  (c1.concept_code LIKE 'L70%' OR c1.concept_code LIKE 'L20%' 
        OR c1.concept_code LIKE 'L40%' OR c1.concept_code LIKE 'L80%')
  AND  c2.standard_concept = 'S'
LIMIT 20;
```

```sql
--Description: 4)  For one mapped STANDARD concept (example: first acne code)
--               explore all of its descendant STANDARD concepts.
SELECT ca.descendant_concept_id,
       c.concept_name
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`          c
       ON c.concept_id = ca.descendant_concept_id
WHERE  ca.ancestor_concept_id = (
          SELECT cr.concept_id_2
          FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
          JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` icd
                 ON icd.concept_id = cr.concept_id_1
          WHERE  icd.concept_code = 'L70'       -- acne root
            AND  cr.relationship_id = 'Maps to'
          LIMIT 1)
  AND  c.standard_concept = 'S'
LIMIT 20;
```

```sql
--Description: 5)  Build a helper table (cte) listing every STANDARD concept id that belongs to the
--               four diagnosis families (root & descendants).
WITH family AS (
  SELECT DISTINCT
         CASE 
           WHEN icd.concept_code LIKE 'L70%' THEN 'acne'
           WHEN icd.concept_code LIKE 'L20%' THEN 'atopic_dermatitis'
           WHEN icd.concept_code LIKE 'L40%' THEN 'psoriasis'
           WHEN icd.concept_code LIKE 'L80%' THEN 'vitiligo'
         END                                   AS disease_group,
         cr.concept_id_2                      AS standard_concept_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` icd
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
           ON cr.concept_id_1 = icd.concept_id
          AND cr.relationship_id = 'Maps to'
  WHERE  icd.vocabulary_id = 'ICD10CM'
    AND  (icd.concept_code LIKE 'L70%' OR icd.concept_code LIKE 'L20%' 
          OR icd.concept_code LIKE 'L40%' OR icd.concept_code LIKE 'L80%')
),
descendants AS (
  SELECT f.disease_group,
         ca.descendant_concept_id AS standard_concept_id
  FROM   family f
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON ca.ancestor_concept_id = f.standard_concept_id
)
SELECT DISTINCT *
FROM   descendants
LIMIT 20;
```

```sql
--Description: 6)  Count distinct participants (person_id) per disease family
--               who have any of the standard concepts identified above.
WITH descendants AS (
  /* same CTE as #5 – shortened here */
  SELECT DISTINCT
         CASE 
           WHEN icd.concept_code LIKE 'L70%' THEN 'acne'
           WHEN icd.concept_code LIKE 'L20%' THEN 'atopic_dermatitis'
           WHEN icd.concept_code LIKE 'L40%' THEN 'psoriasis'
           WHEN icd.concept_code LIKE 'L80%' THEN 'vitiligo'
         END                                   AS disease_group,
         ca.descendant_concept_id              AS concept_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` icd
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON cr.concept_id_1 = icd.concept_id
        AND cr.relationship_id = 'Maps to'
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON ca.ancestor_concept_id = cr.concept_id_2
  WHERE  icd.vocabulary_id = 'ICD10CM'
    AND  (icd.concept_code LIKE 'L70%' OR icd.concept_code LIKE 'L20%' 
          OR icd.concept_code LIKE 'L40%' OR icd.concept_code LIKE 'L80%')
)
SELECT d.disease_group,
       COUNT(DISTINCT co.person_id) AS participant_cnt
FROM   descendants d
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
       ON co.condition_concept_id = d.concept_id
GROUP  BY d.disease_group
LIMIT 20;
```

```sql
--Description: 7)  Determine the overall number of unique participants that
--               appear in *any* condition_occurrence record (denominator).
SELECT COUNT(DISTINCT person_id) AS total_condition_participants
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
LIMIT 20;
```

```sql
--Description: 8)  Produce the final table with percentage of participants for
--               acne, atopic dermatitis, psoriasis and vitiligo.
WITH descendants AS (
  /* identical to step #6 */
  SELECT DISTINCT
         CASE 
           WHEN icd.concept_code LIKE 'L70%' THEN 'acne'
           WHEN icd.concept_code LIKE 'L20%' THEN 'atopic_dermatitis'
           WHEN icd.concept_code LIKE 'L40%' THEN 'psoriasis'
           WHEN icd.concept_code LIKE 'L80%' THEN 'vitiligo'
         END                                   AS disease_group,
         ca.descendant_concept_id              AS concept_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` icd
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON cr.concept_id_1 = icd.concept_id
        AND cr.relationship_id = 'Maps to'
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON ca.ancestor_concept_id = cr.concept_id_2
  WHERE  icd.vocabulary_id = 'ICD10CM'
    AND  (icd.concept_code LIKE 'L70%' OR icd.concept_code LIKE 'L20%' 
          OR icd.concept_code LIKE 'L40%' OR icd.concept_code LIKE 'L80%')
),
counts AS (
  SELECT d.disease_group,
         COUNT(DISTINCT co.person_id) AS participant_cnt
  FROM   descendants d
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
         ON co.condition_concept_id = d.concept_id
  GROUP  BY d.disease_group
),
total AS (
  SELECT COUNT(DISTINCT person_id) AS total_cnt
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
)
SELECT c.disease_group,
       c.participant_cnt,
       ROUND(100.0 * c.participant_cnt / t.total_cnt, 2) AS pct_of_participants
FROM   counts c
CROSS  JOIN total t
ORDER  BY pct_of_participants DESC
LIMIT 20;
```

```sql
--Description: 9)  OPTIONAL sanity-check: bring back a random sample of 20 persons
--               who were classified as having psoriasis to manually inspect.
WITH descendants AS (
  SELECT ca.descendant_concept_id AS concept_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` icd
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
    ON cr.concept_id_1 = icd.concept_id
   AND cr.relationship_id = 'Maps to'
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON ca.ancestor_concept_id = cr.concept_id_2
  WHERE  icd.vocabulary_id = 'ICD10CM'
    AND  icd.concept_code LIKE 'L40%'  -- psoriasis only
)
SELECT DISTINCT co.person_id,
       co.condition_concept_id
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
JOIN   descendants d
       ON d.concept_id = co.condition_concept_id
LIMIT 20;
```

```sql
--Description: 10)  OPTIONAL view of the standard concepts list for vitiligo
