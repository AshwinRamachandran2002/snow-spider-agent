Query:
--Description: 4)  For one mapped STANDARD concept (example: first acne code)
--               explore all of its descendant STANDARD concepts.
SELECT ca.descendant_concept_id,
       c.concept_name
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`          c
       ON c.concept_id = ca.descendant_concept_id
WHERE  ca.ancestor_concept_id = (
          SELECT cr.concept_id_2
          FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
          JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` icd
                 ON icd.concept_id = cr.concept_id_1
          WHERE  icd.concept_code = 'L70'       -- acne root
            AND  cr.relationship_id = 'Maps to'
          LIMIT 1)
