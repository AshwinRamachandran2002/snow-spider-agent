Query:
--Description: 3)  Map those non-standard ICD-10-CM concepts to their STANDARD concepts through
--               the “Maps to” relationship (concept_id_1 = ICD-10, concept_id_2 = standard).
SELECT cr.concept_id_1      AS source_icd10cm_id,
       c1.concept_code      AS source_icd10cm_code,
       cr.concept_id_2      AS standard_concept_id,
       c2.concept_name      AS standard_name,
       c2.vocabulary_id
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`          c1
       ON c1.concept_id = cr.concept_id_1
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`          c2
       ON c2.concept_id = cr.concept_id_2
WHERE  cr.relationship_id = 'Maps to'
  AND  c1.vocabulary_id    = 'ICD10CM'
  AND  (c1.concept_code LIKE 'L70%' OR c1.concept_code LIKE 'L20%' 
        OR c1.concept_code LIKE 'L40%' OR c1.concept_code LIKE 'L80%')
  AND  c2.standard_concept = 'S'
LIMIT 20;
