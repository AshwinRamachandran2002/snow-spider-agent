Query:
--Description: 8)  Produce the final table with percentage of participants for
--               acne, atopic dermatitis, psoriasis and vitiligo.
WITH descendants AS (
  /* identical to step #6 */
  SELECT DISTINCT
         CASE 
           WHEN icd.concept_code LIKE 'L70%' THEN 'acne'
           WHEN icd.concept_code LIKE 'L20%' THEN 'atopic_dermatitis'
           WHEN icd.concept_code LIKE 'L40%' THEN 'psoriasis'
           WHEN icd.concept_code LIKE 'L80%' THEN 'vitiligo'
         END                                   AS disease_group,
         ca.descendant_concept_id              AS concept_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` icd
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON cr.concept_id_1 = icd.concept_id
        AND cr.relationship_id = 'Maps to'
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON ca.ancestor_concept_id = cr.concept_id_2
  WHERE  icd.vocabulary_id = 'ICD10CM'
    AND  (icd.concept_code LIKE 'L70%' OR icd.concept_code LIKE 'L20%' 
          OR icd.concept_code LIKE 'L40%' OR icd.concept_code LIKE 'L80%')
),
counts AS (
  SELECT d.disease_group,
         COUNT(DISTINCT co.person_id) AS participant_cnt
  FROM   descendants d
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
         ON co.condition_concept_id = d.concept_id
  GROUP  BY d.disease_group
),
total AS (
  SELECT COUNT(DISTINCT person_id) AS total_cnt
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
)
SELECT c.disease_group,
       c.participant_cnt,
       ROUND(100.0 * c.participant_cnt / t.total_cnt, 2) AS pct_of_participants
FROM   counts c
CROSS  JOIN total t
ORDER  BY pct_of_participants DESC
LIMIT 20;
