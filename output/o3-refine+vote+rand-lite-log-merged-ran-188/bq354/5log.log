Query:
--Description: 2)  Pull every concept_id belonging to the four ICD-10-CM families from the OMOP vocabulary.
SELECT concept_id,
       concept_code,
       concept_name
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
WHERE  vocabulary_id = 'ICD10CM'
  AND  (concept_code LIKE 'L70%'    -- acne
        OR concept_code LIKE 'L20%' -- atopic dermatitis
        OR concept_code LIKE 'L40%' -- psoriasis
        OR concept_code LIKE 'L80%') -- vitiligo
LIMIT 20;
