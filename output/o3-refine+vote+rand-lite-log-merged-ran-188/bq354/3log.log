```sql
--Description: 7) Assemble one table that holds the DISTINCT participant count for each
--               of the four dermatologic disorders (Acne, Atopic dermatitis,
--               Psoriasis, Vitiligo) using all their ICD-10-CM descendants  
WITH roots AS (
  SELECT 'ACNE'   AS disease, concept_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
   WHERE vocabulary_id='ICD10CM' AND concept_code='L70'
  UNION ALL
  SELECT 'ATOPIC' AS disease, concept_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
   WHERE vocabulary_id='ICD10CM' AND concept_code='L20'
  UNION ALL
  SELECT 'PSO'    AS disease, concept_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
   WHERE vocabulary_id='ICD10CM' AND concept_code='L40'
  UNION ALL
  SELECT 'VIT'    AS disease, concept_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
   WHERE vocabulary_id='ICD10CM' AND concept_code='L80'
),
all_desc AS (
  SELECT r.disease, ca.descendant_concept_id AS concept_id
  FROM roots r
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON ca.ancestor_concept_id = r.concept_id
),
per_dis AS (
  SELECT disease, COUNT(DISTINCT person_id) AS n_participants
  FROM all_desc  d
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
    ON co.condition_concept_id = d.concept_id
  GROUP BY disease
)
SELECT *
FROM per_dis
LIMIT 20;
```

```sql
--Description: 8) Count the total number of unique participants appearing ANYWHERE
--               in the synthetic OMOP data (condition, observation, or procedure)  
WITH ids AS (
  SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
  UNION DISTINCT
  SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.observation`
  UNION DISTINCT
  SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.procedure_occurrence`
)
SELECT COUNT(DISTINCT person_id) AS total_participants
FROM ids;
```

```sql
--Description: 9) FINAL – produce counts and PERCENTAGES of participants with each
--               dermatologic diagnosis (Acne, Atopic dermatitis, Psoriasis, Vitiligo)
--               relative to the total participant population  
WITH roots AS (
  SELECT 'Acne (L70*)'               AS disease, concept_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
   WHERE vocabulary_id='ICD10CM' AND concept_code='L70'
  UNION ALL
  SELECT 'Atopic dermatitis (L20*)', concept_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
   WHERE vocabulary_id='ICD10CM' AND concept_code='L20'
  UNION ALL
  SELECT 'Psoriasis (L40*)',         concept_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
   WHERE vocabulary_id='ICD10CM' AND concept_code='L40'
  UNION ALL
  SELECT 'Vitiligo (L80*)',          concept_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
   WHERE vocabulary_id='ICD10CM' AND concept_code='L80'
),
all_desc AS (
  SELECT r.disease, ca.descendant_concept_id AS concept_id
  FROM roots r
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON ca.ancestor_concept_id = r.concept_id
),
per_dis AS (
  SELECT disease, COUNT(DISTINCT person_id) AS n_participants
  FROM all_desc  d
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
    ON co.condition_concept_id = d.concept_id
  GROUP BY disease
),
total_n AS (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM (
      SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
      UNION DISTINCT
      SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.observation`
      UNION DISTINCT
      SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.procedure_occurrence`
  )
)
SELECT p.disease,
       p.n_participants,
       ROUND(100 * p.n_participants / t.total_participants, 2) AS percent_participants
FROM per_dis p
CROSS JOIN total_n t
ORDER BY percent_participants DESC;
```

