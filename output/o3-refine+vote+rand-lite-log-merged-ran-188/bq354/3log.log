  SELECT d.disease, c.concept_id
  FROM disease_map d
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
    ON c.vocabulary_id = 'ICD10CM'
   AND c.concept_code LIKE CONCAT(d.prefix, '%')
),
per_dis AS (
  SELECT disease, COUNT(DISTINCT person_id) AS n_participants
  FROM concept_sets cs
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
    ON co.condition_concept_id = cs.concept_id
  GROUP BY disease
)
SELECT *
FROM per_dis
LIMIT 20;
```

```sql
--Description: 8) Total number of unique participants across the entire synthetic OMOP cohort  
-- (unchanged – still aggregates ids from three clinical domains).  
WITH ids AS (
  SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
  UNION DISTINCT
  SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.observation`
  UNION DISTINCT
  SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.procedure_occurrence`
)
SELECT COUNT(DISTINCT person_id) AS total_participants
FROM ids;
```

```sql
--Description: 9) Final counts & percentages of participants with each dermatologic diagnosis  
-- Adjustment: concept sets are created by simple prefix match so the root vitiligo   
-- code (L80) is included even if no sub-codes exist.  
WITH disease_map AS (
  SELECT 'Acne (L70*)'               AS disease, 'L70' AS prefix UNION ALL
  SELECT 'Atopic dermatitis (L20*)', 'L20' UNION ALL
  SELECT 'Psoriasis (L40*)',         'L40' UNION ALL
  SELECT 'Vitiligo (L80*)',          'L80'
),
concept_sets AS (
  SELECT d.disease, c.concept_id
  FROM disease_map d
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
    ON c.vocabulary_id = 'ICD10CM'
   AND c.concept_code LIKE CONCAT(d.prefix, '%')
),
per_dis AS (
  SELECT disease, COUNT(DISTINCT person_id) AS n_participants
  FROM concept_sets cs
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
    ON co.condition_concept_id = cs.concept_id
  GROUP BY disease
),
total_n AS (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM (
      SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
      UNION DISTINCT
      SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.observation`
      UNION DISTINCT
      SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.procedure_occurrence`
  )
)
SELECT p.disease,
       p.n_participants,
       ROUND(100 * p.n_participants / t.total_participants, 2) AS percent_participants
FROM per_dis p
CROSS JOIN total_n t
ORDER BY percent_participants DESC;
```

