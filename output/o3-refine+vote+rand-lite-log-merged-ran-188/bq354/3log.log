--Description: 6) Get distinct participant-IDs that have any condition_occurrence mapped to
--               standard Acne (L70*) concepts (root + descendants)  
WITH acne_concepts AS (
  SELECT descendant_concept_id AS concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
  WHERE ancestor_concept_id IN (
        SELECT concept_id
        FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
        WHERE vocabulary_id = 'ICD10CM' AND concept_code = 'L70')
)
SELECT DISTINCT person_id
