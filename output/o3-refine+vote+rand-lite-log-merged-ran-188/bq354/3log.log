--Description: 9) Final counts & percentages of participants with each dermatologic diagnosis (keyword-based STANDARD concepts)
WITH disease_kw AS (
  SELECT 'Acne (L70*)'               AS disease, '%acne%'              AS pattern UNION ALL
  SELECT 'Atopic dermatitis (L20*)', '%atopic dermatitis%' UNION ALL
  SELECT 'Psoriasis (L40*)',         '%psoriasis%'         UNION ALL
  SELECT 'Vitiligo (L80*)',          '%vitiligo%' 
),
concept_sets AS (
  SELECT dk.disease, c.concept_id
  FROM disease_kw dk
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
    ON c.standard_concept = 'S'
   AND c.domain_id = 'Condition'
   AND LOWER(c.concept_name) LIKE dk.pattern
),
per_dis AS (
  SELECT cs.disease,
         COUNT(DISTINCT co.person_id) AS n_participants
  FROM concept_sets cs
  LEFT JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
    ON co.condition_concept_id = cs.concept_id
  GROUP BY cs.disease
),
total_n AS (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM (
      SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
      UNION DISTINCT
      SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.observation`
      UNION DISTINCT
      SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.procedure_occurrence`
  )
)
SELECT p.disease,
       p.n_participants,
       ROUND(100 * p.n_participants / t.total_participants, 2) AS percent_participants
FROM per_dis p
CROSS JOIN total_n t
ORDER BY percent_participants DESC
