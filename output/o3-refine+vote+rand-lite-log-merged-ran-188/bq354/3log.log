Query:
--Description: 7) Count distinct participants per disorder (Acne, Atopic dermatitis, Psoriasis, Vitiligo) using STANDARD condition concepts detected by keyword search
WITH disease_kw AS (
  SELECT 'ACNE'   AS disease, '%acne%'              AS pattern UNION ALL
  SELECT 'ATOPIC' AS disease, '%atopic dermatitis%' UNION ALL
  SELECT 'PSO'    AS disease, '%psoriasis%'         UNION ALL
  SELECT 'VIT'    AS disease, '%vitiligo%' 
),
concept_sets AS (
  SELECT dk.disease, c.concept_id
  FROM disease_kw dk
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
    ON c.standard_concept = 'S'
   AND c.domain_id = 'Condition'
   AND LOWER(c.concept_name) LIKE dk.pattern
),
per_dis AS (
  SELECT cs.disease,
         COUNT(DISTINCT co.person_id) AS n_participants
  FROM concept_sets cs
  LEFT JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
    ON co.condition_concept_id = cs.concept_id
  GROUP BY cs.disease
)
SELECT disease, n_participants
FROM per_dis
ORDER BY disease
Answer:
disease,n_participants
ACNE,26990
ATOPIC,60573
PSO,41107
VIT,31378
