Query:
--Description: 
--Count of distinct persons per dermatologic ICD-10-CM family (L20, L40, L70, L80).
--Steps
-- 1) Grab all ICD-10-CM concepts whose code starts with those roots.
-- 2) Map each to its STANDARD concept(s) via relationship_id = 'Maps to'.
-- 3) Count people whose condition_concept_id equals one of the mapped standard ids.
WITH icd_families AS (
  SELECT concept_id,
         CASE
           WHEN concept_code LIKE 'L20%' THEN 'L20'
           WHEN concept_code LIKE 'L40%' THEN 'L40'
           WHEN concept_code LIKE 'L70%' THEN 'L70'
           WHEN concept_code LIKE 'L80%' THEN 'L80'
         END AS root_code
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE vocabulary_id = 'ICD10CM'
    AND (concept_code LIKE 'L20%' OR concept_code LIKE 'L40%' 
         OR concept_code LIKE 'L70%' OR concept_code LIKE 'L80%')
),
maps AS (
  SELECT DISTINCT i.root_code,
                  cr.concept_id_2 AS std_concept_id   -- SNOMED etc.
  FROM icd_families i
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
    ON cr.concept_id_1 = i.concept_id
  WHERE cr.relationship_id = 'Maps to'
)
SELECT m.root_code                       AS icd10_root,
       COUNT(DISTINCT co.person_id)      AS n_persons
FROM   maps m
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
  ON   co.condition_concept_id = m.std_concept_id
GROUP  BY m.root_code
ORDER  BY m.root_code
LIMIT 20
Answer:
icd10_root,n_persons
L20,59381
L40,133637
L70,26990
L80,31378
Query:
--Description:
--Percentage of participants with each dermatologic condition family using the same
--ICD-10-CM → STANDARD mapping logic as above.
WITH icd_families AS (
  SELECT concept_id,
         CASE
           WHEN concept_code LIKE 'L20%' THEN 'L20'
           WHEN concept_code LIKE 'L40%' THEN 'L40'
           WHEN concept_code LIKE 'L70%' THEN 'L70'
           WHEN concept_code LIKE 'L80%' THEN 'L80'
         END AS root_code
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE vocabulary_id = 'ICD10CM'
    AND (concept_code LIKE 'L20%' OR concept_code LIKE 'L40%' 
         OR concept_code LIKE 'L70%' OR concept_code LIKE 'L80%')
),
maps AS (
  SELECT DISTINCT i.root_code,
                  cr.concept_id_2 AS std_concept_id
  FROM icd_families i
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
    ON cr.concept_id_1 = i.concept_id
  WHERE cr.relationship_id = 'Maps to'
),
persons_per_dx AS (
  SELECT m.root_code,
         COUNT(DISTINCT co.person_id) AS n_persons
  FROM   maps m
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
    ON   co.condition_concept_id = m.std_concept_id
  GROUP  BY m.root_code
),
total_people AS (
  SELECT COUNT(DISTINCT person_id) AS total_n
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
)
SELECT p.root_code                       AS disease_group,
       p.n_persons,
       t.total_n,
       ROUND(100 * p.n_persons / t.total_n, 2) AS pct_participants
FROM persons_per_dx p
CROSS JOIN total_people t
ORDER BY disease_group
