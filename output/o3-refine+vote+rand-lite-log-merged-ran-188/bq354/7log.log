```sql
--Description / Thinking process:
--Goal: Compute the % of participants with any condition mapped to
--      Acne (L70), Atopic Dermatitis (L20), Psoriasis (L40), or Vitiligo (L80),
--      including ALL ICD-10-CM descendant concepts.
--Steps inside CTEs
-- 1) root_codes  : fetch concept_ids for the four ICD-10-CM root codes.
-- 2) descendants : via concept_ancestor, expand each root to every descendant concept_id.
-- 3) persons_dx  : for each root code, count DISTINCT persons in condition_occurrence
--                  whose condition_concept_id is in its descendant list.
-- 4) total_ppl   : total DISTINCT persons in condition_occurrence (denominator).
--Final SELECT     : merge counts & compute percentage.

WITH root_codes AS (
  SELECT concept_id, concept_code
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE vocabulary_id = 'ICD10CM'
    AND concept_code IN ('L20','L40','L70','L80')              -- target dermatologic groups
),
descendants AS (
  SELECT r.concept_code               AS root_code,
         a.descendant_concept_id
  FROM root_codes r
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` a
    ON a.ancestor_concept_id = r.concept_id                    -- expand to all descendants
),
persons_dx AS (
  SELECT d.root_code,
         COUNT(DISTINCT co.person_id) AS n_persons
  FROM descendants d
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
    ON co.condition_concept_id = d.descendant_concept_id       -- match conditions
  GROUP BY d.root_code
),
total_ppl AS (
  SELECT COUNT(DISTINCT person_id) AS total_persons
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
)
SELECT
  p.root_code                   AS disease_group,
  p.n_persons,
  t.total_persons,
  ROUND(100 * p.n_persons / t.total_persons, 2) AS pct_participants
FROM persons_dx p
CROSS JOIN total_ppl t
ORDER BY disease_group;
```
