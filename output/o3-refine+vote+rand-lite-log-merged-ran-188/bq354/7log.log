```sql
-- 6) Count of distinct persons per disease group (root + all descendants)
WITH roots AS (
  SELECT concept_id, concept_code
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE  vocabulary_id = 'ICD10CM'
    AND  concept_code IN ('L20','L40','L70','L80')
),
descendants AS (
  SELECT r.concept_code     AS icd10_root,
         a.descendant_concept_id
  FROM   roots r
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` a
         ON a.ancestor_concept_id = r.concept_id
)
SELECT d.icd10_root,
       COUNT(DISTINCT co.person_id) AS n_persons
FROM   descendants d
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
       ON co.condition_concept_id = d.descendant_concept_id
GROUP  BY d.icd10_root
ORDER  BY d.icd10_root
LIMIT 20;
