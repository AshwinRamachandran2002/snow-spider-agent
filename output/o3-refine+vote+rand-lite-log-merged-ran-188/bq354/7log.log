```sql
--Description: Count of distinct persons per dermatologic family (L20, L40, L70, L80)
--by treating every ICD-10-CM concept whose code starts with the root as belonging
--to that family.  No concept_ancestor needed.
WITH dx_concepts AS (
  SELECT concept_id,
         CASE
           WHEN concept_code LIKE 'L20%' THEN 'L20'
           WHEN concept_code LIKE 'L40%' THEN 'L40'
           WHEN concept_code LIKE 'L70%' THEN 'L70'
           WHEN concept_code LIKE 'L80%' THEN 'L80'
         END AS root_code
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE vocabulary_id = 'ICD10CM'
    AND (concept_code LIKE 'L20%' OR concept_code LIKE 'L40%' 
         OR concept_code LIKE 'L70%' OR concept_code LIKE 'L80%')
)
SELECT d.root_code                  AS icd10_root,
       COUNT(DISTINCT co.person_id) AS n_persons
FROM   dx_concepts d
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
       ON co.condition_concept_id = d.concept_id
GROUP  BY d.root_code
ORDER  BY d.root_code
LIMIT 20;
```

```sql
--Description: Percentage of participants with each dermatologic condition family.
