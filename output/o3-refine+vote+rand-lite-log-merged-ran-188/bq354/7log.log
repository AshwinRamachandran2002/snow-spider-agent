```sql
--Description:
--Top 10 most frequent psoriasis (L40-family) ICD-10-CM codes by counting patient
--records whose STANDARD concept maps back to each L40 code.
WITH l40_icd AS (
  SELECT concept_id, concept_code, concept_name
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE vocabulary_id = 'ICD10CM' AND concept_code LIKE 'L40%'
),
maps AS (
  SELECT i.concept_id       AS icd_id,
         i.concept_code     AS icd_code,
         i.concept_name     AS icd_name,
         cr.concept_id_2    AS std_id
  FROM l40_icd i
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
    ON cr.concept_id_1 = i.concept_id
  WHERE cr.relationship_id = 'Maps to'
)
SELECT m.icd_code,
       m.icd_name,
       COUNT(*) AS occurrences
FROM   maps m
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
  ON   co.condition_concept_id = m.std_id
GROUP  BY m.icd_code, m.icd_name
ORDER  BY occurrences DESC
LIMIT 20;
```

