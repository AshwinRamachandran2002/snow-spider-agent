```sql
--Description: 
--`concept_ancestor` does not carry hierarchy links for these ICD-10-CM chapter-level
--codes (L20, L40, L70, L80).  Therefore the quickest way to see how many concepts
--belong to each family is to scan the `concept` table itself and treat every
--ICD-10-CM concept whose code starts with the root as a “descendant”.
--This query buckets concepts into their root family and counts them.

SELECT
  CASE
    WHEN concept_code LIKE 'L20%' THEN 'L20'   -- Atopic dermatitis family
    WHEN concept_code LIKE 'L40%' THEN 'L40'   -- Psoriasis family
    WHEN concept_code LIKE 'L70%' THEN 'L70'   -- Acne family
    WHEN concept_code LIKE 'L80%' THEN 'L80'   -- Vitiligo family
  END AS icd10cm_root_code,
  COUNT(*) AS n_descendant_concepts
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
WHERE vocabulary_id = 'ICD10CM'
  AND (concept_code LIKE 'L20%' 
       OR concept_code LIKE 'L40%' 
       OR concept_code LIKE 'L70%' 
       OR concept_code LIKE 'L80%')
GROUP BY icd10cm_root_code;
