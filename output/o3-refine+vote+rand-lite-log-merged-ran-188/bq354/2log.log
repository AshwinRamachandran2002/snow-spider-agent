```sql
-- 5.  Description:  Show how Acne (L70*) ICD-10-CM concepts map to STANDARD concepts
SELECT DISTINCT
  r.concept_id_1            AS icd10cm_concept_id,
  c1.concept_code           AS icd10_code,
  r.concept_id_2            AS standard_concept_id,
  c2.concept_name           AS standard_concept_name,
  r.relationship_id
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` AS r
JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept`            AS c1
  ON r.concept_id_1 = c1.concept_id
JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept`            AS c2
  ON r.concept_id_2 = c2.concept_id
WHERE c1.vocabulary_id = 'ICD10CM'
  AND c1.concept_code LIKE 'L70%'
  AND r.relationship_id = 'Maps to'
LIMIT 20;
```

```sql
-- 6.  Description:  Retrieve all descendant STANDARD concepts for mapped Acne concepts
SELECT DISTINCT
  ca.ancestor_concept_id    AS std_ancestor_concept_id,
  ca.descendant_concept_id
FROM (
  -- All standard concepts that Acne (L70*) maps to
  SELECT DISTINCT r.concept_id_2 AS standard_concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` r
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
    ON r.concept_id_1 = c.concept_id
  WHERE c.vocabulary_id = 'ICD10CM'
    AND c.concept_code LIKE 'L70%'
    AND r.relationship_id = 'Maps to'
) AS acne_std
JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
  ON ca.ancestor_concept_id = acne_std.standard_concept_id
LIMIT 20;
```

```sql
-- 7.  Description:  Count distinct participants with Acne (any descendant of mapped concepts)
SELECT
  COUNT(DISTINCT co.person_id) AS acne_patient_cnt
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` AS co
WHERE co.condition_concept_id IN (
  SELECT DISTINCT ca.descendant_concept_id
  FROM (
    SELECT DISTINCT r.concept_id_2 AS standard_concept_id
    FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` r
    JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
      ON r.concept_id_1 = c.concept_id
    WHERE c.vocabulary_id = 'ICD10CM'
      AND c.concept_code LIKE 'L70%'
      AND r.relationship_id = 'Maps to'
  ) AS std
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON ca.ancestor_concept_id = std.standard_concept_id
)
LIMIT 20;
```

```sql
-- 8.  Description:  Total number of unique participants in condition_occurrence (denominator)
SELECT COUNT(DISTINCT person_id) AS total_participants
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
LIMIT 20;
```

```sql
-- 9.  Description:  Count participants for each skin-disease root (L70, L20, L40, L80) separately
WITH target_roots AS (SELECT 'L70' AS root UNION ALL SELECT 'L20' UNION ALL SELECT 'L40' UNION ALL SELECT 'L80'),
icd10 AS (
  SELECT c.concept_id, SUBSTR(c.concept_code,1,3) AS root
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
  WHERE c.vocabulary_id = 'ICD10CM'
    AND SUBSTR(c.concept_code,1,3) IN (SELECT root FROM target_roots)
),
std AS (
  SELECT DISTINCT icd.root,
         r.concept_id_2 AS standard_concept_id
  FROM icd10 icd
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` r
    ON r.concept_id_1 = icd.concept_id
  WHERE r.relationship_id = 'Maps to'
),
all_desc AS (
  SELECT s.root, ca.descendant_concept_id
  FROM std s
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON ca.ancestor_concept_id = s.standard_concept_id
)
SELECT
  ad.root                         AS icd10_root,
  COUNT(DISTINCT co.person_id)    AS patient_cnt
FROM all_desc ad
JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
  ON co.condition_concept_id = ad.descendant_concept_id
GROUP BY ad.root
LIMIT 20;
```

```sql
-- 10.  Description:  Final result – percentage of participants with Acne, Atopic Dermatitis,
--                   Psoriasis, and Vitiligo (including all mapped descendant concepts)
WITH target_roots AS (SELECT 'L70' AS root UNION ALL SELECT 'L20' UNION ALL SELECT 'L40' UNION ALL SELECT 'L80'),
icd10 AS (
  SELECT c.concept_id, SUBSTR(c.concept_code,1,3) AS root
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
  WHERE c.vocabulary_id = 'ICD10CM'
    AND SUBSTR(c.concept_code,1,3) IN (SELECT root FROM target_roots)
),
std AS (
  SELECT DISTINCT icd.root,
         r.concept_id_2 AS standard_concept_id
  FROM icd10 icd
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` r
    ON r.concept_id_1 = icd.concept_id
  WHERE r.relationship_id = 'Maps to'
),
all_desc AS (
  SELECT s.root, ca.descendant_concept_id
  FROM std s
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON ca.ancestor_concept_id = s.standard_concept_id
),
patient_counts AS (
  SELECT
    ad.root                              AS icd10_root,
    COUNT(DISTINCT co.person_id)         AS patient_cnt
  FROM all_desc ad
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
    ON co.condition_concept_id = ad.descendant_concept_id
  GROUP BY ad.root
),
tot AS (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
)
SELECT
  pc.icd10_root                                  AS icd10_code_root,
  pc.patient_cnt                                 AS participants,
  tot.total_participants,
  ROUND(100.0 * pc.patient_cnt / tot.total_participants, 2) 
      AS percentage_of_participants
FROM patient_counts pc
CROSS JOIN tot
ORDER BY icd10_code_root
LIMIT 20;
```
