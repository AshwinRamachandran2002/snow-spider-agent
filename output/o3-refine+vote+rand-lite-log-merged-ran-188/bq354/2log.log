  FROM (
    SELECT DISTINCT r.concept_id_2 AS standard_concept_id
    FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` r
    JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
      ON r.concept_id_1 = c.concept_id
    WHERE c.vocabulary_id = 'ICD10CM'
      AND c.concept_code LIKE 'L70%'
      AND r.relationship_id = 'Maps to'
