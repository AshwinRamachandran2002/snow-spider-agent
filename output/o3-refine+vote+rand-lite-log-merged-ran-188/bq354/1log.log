```sql
--Description: 3)  Distinct participants who have ANY acne-related diagnosis.  
--              Step-1: grab all ICD-10-CM concepts whose code starts with “L70”.  
--              Step-2: use “Maps to” to reach their STANDARD concept(s).  
--              Step-3: include those standards + all their descendants, then pull persons
--              from condition_occurrence.  (Limited to 20 to inspect.)
WITH icd AS (
  SELECT concept_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE  vocabulary_id = 'ICD10CM'
    AND  concept_code LIKE 'L70%'
), std AS (
  SELECT DISTINCT cr.concept_id_2 AS standard_id
  FROM   icd
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
       ON cr.concept_id_1 = icd.concept_id
      AND cr.relationship_id = 'Maps to'
), std_plus_desc AS (
  SELECT standard_id AS concept_id FROM std
  UNION DISTINCT
  SELECT ca.descendant_concept_id
  FROM   std
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON   ca.ancestor_concept_id = std.standard_id
)
SELECT DISTINCT co.person_id
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
WHERE  co.condition_concept_id IN (SELECT concept_id FROM std_plus_desc)
LIMIT 20;
```

```sql
--Description: 4)  Number of distinct persons with acne, atopic dermatitis, psoriasis, and vitiligo  
--              (condition_occurrence only).  For each root (L70/L20/L40/L80) we map ICD-10-CM→STANDARD,  
--              add descendants, count persons, then UNION results.
WITH roots AS (
  SELECT 'L70' AS root, 'Acne'               AS disorder UNION ALL
  SELECT 'L20',          'Atopic Dermatitis' UNION ALL
  SELECT 'L40',          'Psoriasis'         UNION ALL
  SELECT 'L80',          'Vitiligo'
), mapped AS (
  SELECT r.disorder,
         cr.concept_id_2 AS standard_id
  FROM   roots r
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
         ON c.vocabulary_id = 'ICD10CM'
        AND c.concept_code LIKE CONCAT(r.root, '%')
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON cr.concept_id_1 = c.concept_id
        AND cr.relationship_id = 'Maps to'
), std_plus_desc AS (
  SELECT disorder, standard_id AS concept_id FROM mapped
  UNION ALL
  SELECT m.disorder, ca.descendant_concept_id
  FROM   mapped m
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON ca.ancestor_concept_id = m.standard_id
), persons AS (
  SELECT DISTINCT spd.disorder, co.person_id
  FROM   std_plus_desc spd
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
         ON co.condition_concept_id = spd.concept_id
)
SELECT disorder,
       COUNT(DISTINCT person_id) AS n_people
FROM   persons
GROUP BY disorder
ORDER BY disorder
LIMIT 20;
```

