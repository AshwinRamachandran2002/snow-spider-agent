       concept_id,
       concept_code,
       concept_name,
       standard_concept
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
WHERE  vocabulary_id = 'ICD10CM'
  AND  LEFT(concept_code, 3) IN ('L70', 'L20', 'L40', 'L80')
LIMIT 20;
