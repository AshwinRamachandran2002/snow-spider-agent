```sql
--Description: 4)  Row counts (distinct persons) for acne, atopic dermatitis, psoriasis, and vitiligo  
--             using condition_occurrence.  The look-up for each disorder grabs every concept whose  
--             ICD-10-CM code starts with the corresponding three-character root (L70, L20, L40, L80).
WITH roots AS (
  SELECT 'Acne (L70)' AS label, 'L70' AS root UNION ALL
  SELECT 'Atopic dermatitis (L20)', 'L20' UNION ALL
  SELECT 'Psoriasis (L40)', 'L40' UNION ALL
  SELECT 'Vitiligo (L80)', 'L80'
)
SELECT
  r.label              AS disorder,
  COUNT(DISTINCT co.person_id) AS n_people
FROM          roots r
JOIN UNNEST([1])      AS dummy            -- trick to enable JOIN for each root row
LEFT JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
       ON   co.condition_concept_id IN (
              SELECT descendant_concept_id
              FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
              WHERE  ancestor_concept_id IN (
                       SELECT concept_id
                       FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
                       WHERE  vocabulary_id = 'ICD10CM'
                         AND  LEFT(concept_code,3) = r.root
                     )
            )
GROUP BY r.label
ORDER BY disorder
LIMIT 20;
```

