--Description: 5)  Total number of distinct participants recorded in condition_occurrence
SELECT COUNT(DISTINCT person_id) AS total_people
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
LIMIT 20;
```

```sql
--Description: 6)  Distinct participant count for acne (L70*) using condition_era.  
--              Same ICD-10-CM→STANDARD mapping strategy as query-3.
WITH icd AS (
  SELECT concept_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE  vocabulary_id = 'ICD10CM'
    AND  concept_code LIKE 'L70%'
), std AS (
  SELECT DISTINCT cr.concept_id_2 AS standard_id
  FROM   icd
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
       ON cr.concept_id_1 = icd.concept_id
      AND cr.relationship_id = 'Maps to'
), all_ids AS (
  SELECT standard_id AS concept_id FROM std
  UNION DISTINCT
  SELECT descendant_concept_id
  FROM   std
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
       ON ancestor_concept_id = standard_id
)
SELECT COUNT(DISTINCT person_id) AS n_people_acne_era
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_era`
WHERE  condition_concept_id IN (SELECT concept_id FROM all_ids)
LIMIT 20;
```

```sql
--Description: 7)  Union of persons with psoriasis evidence (L40*) in either condition_occurrence or condition_era.
WITH icd AS (
  SELECT concept_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE  vocabulary_id = 'ICD10CM'
    AND  concept_code LIKE 'L40%'
), std AS (
  SELECT DISTINCT cr.concept_id_2 AS standard_id
  FROM   icd
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
       ON cr.concept_id_1 = icd.concept_id
      AND cr.relationship_id = 'Maps to'
), all_ids AS (
  SELECT standard_id AS concept_id FROM std
  UNION DISTINCT
  SELECT descendant_concept_id
  FROM   std
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
       ON ancestor_concept_id = standard_id
), people_occ AS (
  SELECT DISTINCT person_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
  WHERE  condition_concept_id IN (SELECT concept_id FROM all_ids)
), people_era AS (
  SELECT DISTINCT person_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_era`
  WHERE  condition_concept_id IN (SELECT concept_id FROM all_ids)
)
SELECT DISTINCT person_id
FROM (
  SELECT * FROM people_occ
  UNION DISTINCT
  SELECT * FROM people_era
)
LIMIT 20;
```

