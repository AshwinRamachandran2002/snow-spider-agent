```sql
--Description: 9)  Percentage of participants with each disorder (condition_occurrence only).  
--              ICD-10 roots → STANDARD → descendants, then count persons and divide by total.
WITH roots AS (
  SELECT 'L70' AS root, 'Acne'               AS disorder UNION ALL
  SELECT 'L20',          'Atopic Dermatitis' UNION ALL
  SELECT 'L40',          'Psoriasis'         UNION ALL
  SELECT 'L80',          'Vitiligo'
), mapped AS (
  SELECT r.disorder,
         cr.concept_id_2 AS standard_id
  FROM   roots r
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
         ON c.vocabulary_id = 'ICD10CM'
        AND c.concept_code LIKE CONCAT(r.root, '%')
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON cr.concept_id_1 = c.concept_id
        AND cr.relationship_id = 'Maps to'
), std_plus_desc AS (
  SELECT disorder, standard_id AS concept_id FROM mapped
  UNION ALL
  SELECT m.disorder, ca.descendant_concept_id
  FROM   mapped m
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON ca.ancestor_concept_id = m.standard_id
), persons AS (
  SELECT DISTINCT spd.disorder, co.person_id
  FROM   std_plus_desc spd
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
         ON co.condition_concept_id = spd.concept_id
), n_people AS (
  SELECT disorder, COUNT(DISTINCT person_id) AS n_people
  FROM   persons
  GROUP BY disorder
), tot AS (
  SELECT COUNT(DISTINCT person_id) AS total_people
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
)
SELECT n.disorder,
       n.n_people,
       ROUND(100 * n.n_people / tot.total_people, 2) AS pct_of_participants
FROM   n_people n, tot
ORDER BY disorder
LIMIT 20;
```

```sql
--Description: 10)  Percentage of participants with each disorder using BOTH condition_occurrence and condition_era.
WITH roots AS (
  SELECT 'L70' AS root, 'Acne'               AS disorder UNION ALL
  SELECT 'L20',          'Atopic Dermatitis' UNION ALL
  SELECT 'L40',          'Psoriasis'         UNION ALL
  SELECT 'L80',          'Vitiligo'
), mapped AS (
  SELECT r.disorder,
         cr.concept_id_2 AS standard_id
  FROM   roots r
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
         ON c.vocabulary_id = 'ICD10CM'
        AND c.concept_code LIKE CONCAT(r.root, '%')
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON cr.concept_id_1 = c.concept_id
        AND cr.relationship_id = 'Maps to'
), std_plus_desc AS (
  SELECT disorder, standard_id AS concept_id FROM mapped
  UNION ALL
  SELECT m.disorder, ca.descendant_concept_id
  FROM   mapped m
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON ca.ancestor_concept_id = m.standard_id
), people_union AS (
  SELECT spd.disorder, co.person_id
  FROM   std_plus_desc spd
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
         ON co.condition_concept_id = spd.concept_id
  UNION DISTINCT
  SELECT spd.disorder, ce.person_id
  FROM   std_plus_desc spd
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_era` ce
         ON ce.condition_concept_id = spd.concept_id
), n_people AS (
  SELECT disorder, COUNT(DISTINCT person_id) AS n_people
  FROM   people_union
  GROUP BY disorder
), tot AS (
  SELECT COUNT(DISTINCT person_id) AS total_people
  FROM (
    SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
    UNION DISTINCT
    SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_era`
  )
)
SELECT n.disorder,
       n.n_people,
       ROUND(100 * n.n_people / tot.total_people, 2) AS pct_of_participants
FROM   n_people n, tot
ORDER BY disorder
LIMIT 20;
