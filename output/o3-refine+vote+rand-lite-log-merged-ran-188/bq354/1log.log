```sql
--Description: 9)  Final query – calculate percentage of participants with each disorder (using condition_occurrence only)
WITH base AS (
  SELECT 'L70' AS code UNION ALL
  SELECT 'L20' UNION ALL
  SELECT 'L40' UNION ALL
  SELECT 'L80'
),
root_concepts AS (
  SELECT b.code,
         c.concept_id
  FROM   base b
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
    ON   c.concept_code = b.code
   AND   c.vocabulary_id = 'ICD10CM'
   AND   c.standard_concept = 'S'
),
descendants AS (
  SELECT rc.code,
         ca.descendant_concept_id AS concept_id
  FROM   root_concepts rc
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON   ca.ancestor_concept_id = rc.concept_id
),
people_per_dx AS (
  SELECT  d.code,
          person_id
  FROM    descendants d
  JOIN    `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
    ON    co.condition_concept_id = d.concept_id
  GROUP BY d.code, person_id
),
n_people AS (
  SELECT  code,
          COUNT(DISTINCT person_id) AS n_people
  FROM    people_per_dx
  GROUP BY code
),
tot AS (
  SELECT COUNT(DISTINCT person_id) AS total_people
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
)
SELECT  CASE code
          WHEN 'L70' THEN 'Acne'
          WHEN 'L20' THEN 'Atopic Dermatitis'
          WHEN 'L40' THEN 'Psoriasis'
          WHEN 'L80' THEN 'Vitiligo'
        END                                          AS disorder,
        n_people,
        ROUND(100 * n_people / total_people, 2) AS pct_of_participants
FROM    n_people, tot
ORDER BY pct_of_participants DESC
LIMIT 20;
```

```sql
--Description: 10)  Same percentage calculation but expanding the clinical source to include BOTH condition_occurrence and condition_era
WITH base AS (
  SELECT 'L70' AS code UNION ALL
  SELECT 'L20' UNION ALL
  SELECT 'L40' UNION ALL
  SELECT 'L80'
),
root_concepts AS (
  SELECT b.code,
         c.concept_id
  FROM   base b
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
    ON   c.concept_code = b.code
   AND   c.vocabulary_id = 'ICD10CM'
   AND   c.standard_concept = 'S'
),
descendants AS (
  SELECT rc.code,
         ca.descendant_concept_id AS concept_id
  FROM   root_concepts rc
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
    ON   ca.ancestor_concept_id = rc.concept_id
),
people_union AS (
  SELECT  d.code, person_id
  FROM    descendants d
  JOIN    `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
    ON    co.condition_concept_id = d.concept_id
  UNION DISTINCT
  SELECT  d.code, person_id
  FROM    descendants d
  JOIN    `bigquery-public-data.cms_synthetic_patient_data_omop.condition_era` ce
    ON    ce.condition_concept_id = d.concept_id
),
n_people AS (
  SELECT  code,
          COUNT(DISTINCT person_id) AS n_people
  FROM    people_union
  GROUP BY code
),
tot AS (
  SELECT COUNT(DISTINCT person_id) AS total_people
  FROM (
    SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
    UNION DISTINCT
    SELECT person_id FROM `bigquery-public-data.cms_synthetic_patient_data_omop.condition_era`
  )
)
SELECT  CASE code
          WHEN 'L70' THEN 'Acne'
          WHEN 'L20' THEN 'Atopic Dermatitis'
          WHEN 'L40' THEN 'Psoriasis'
          WHEN 'L80' THEN 'Vitiligo'
        END                                          AS disorder,
        n_people,
        ROUND(100 * n_people / total_people, 2) AS pct_of_participants
FROM    n_people, tot
ORDER BY pct_of_participants DESC
LIMIT 20;
