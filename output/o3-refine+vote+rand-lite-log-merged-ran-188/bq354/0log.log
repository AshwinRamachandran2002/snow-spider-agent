```sql
--Description: 8) Provide counts & percentages of participants who have Acne (L70*), Atopic Dermatitis (L20*), Psoriasis (L40*), or Vitiligo (L80*) using only standard concepts plus descendants.
WITH disease_codes AS (
  SELECT 'Acne'               AS disease, 'L70' AS prefix UNION ALL
  SELECT 'Atopic Dermatitis', 'L20'             UNION ALL
  SELECT 'Psoriasis',          'L40'            UNION ALL
  SELECT 'Vitiligo',           'L80'
),
icd10cm_concepts AS (
  SELECT d.disease,
         c.concept_id
  FROM   disease_codes d
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
         ON c.vocabulary_id = 'ICD10CM'
        AND c.concept_code  LIKE CONCAT(d.prefix, '%')
),
standard_concepts AS (
  SELECT d.disease,
         cr.concept_id_2 AS standard_concept_id
  FROM   icd10cm_concepts d
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON d.concept_id = cr.concept_id_1
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` cs
         ON cr.concept_id_2 = cs.concept_id
  WHERE  cr.relationship_id = 'Maps to'
    AND  cs.standard_concept = 'S'
),
all_related_concepts AS (
  -- add descendants + root standard concept itself
  SELECT DISTINCT sc.disease,
         ca.descendant_concept_id AS concept_id
  FROM   standard_concepts sc
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON sc.standard_concept_id = ca.ancestor_concept_id
  UNION DISTINCT
  SELECT disease,
         standard_concept_id
  FROM   standard_concepts
),
disease_persons AS (
  SELECT arc.disease,
         co.person_id
  FROM   all_related_concepts          arc
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
         ON co.condition_concept_id = arc.concept_id
  GROUP BY arc.disease, co.person_id
),
denominator AS (
  SELECT COUNT(DISTINCT person_id) AS total_n
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
)
SELECT dp.disease,
       COUNT(DISTINCT dp.person_id)                          AS participants,
       dn.total_n                                            AS total_participants,
       ROUND(100*COUNT(DISTINCT dp.person_id)/dn.total_n,2)  AS percent_participants
FROM   disease_persons  dp
CROSS JOIN denominator dn
GROUP BY dp.disease,
         dn.total_n
ORDER BY dp.disease
LIMIT 20;
```

```sql
--Description: 9) Break down Acne (L70*) participants by each specific descendant standard concept to check distribution.
WITH acne_root AS (
  SELECT cr.concept_id_2 AS standard_concept_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`              c
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON c.concept_id = cr.concept_id_1
  WHERE  c.vocabulary_id   = 'ICD10CM'
    AND  c.concept_code    LIKE 'L70%'
    AND  cr.relationship_id = 'Maps to'
),
acne_descendants AS (
  SELECT DISTINCT ca.descendant_concept_id
  FROM   acne_root  ar
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON ar.standard_concept_id = ca.ancestor_concept_id
  UNION DISTINCT
  SELECT standard_concept_id FROM acne_root
),
acne_persons AS (
  SELECT condition_concept_id,
         person_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
  WHERE  condition_concept_id IN (SELECT * FROM acne_descendants)
)
SELECT c.concept_name,
       COUNT(DISTINCT person_id) AS n_participants
FROM   acne_persons ap
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
       ON ap.condition_concept_id = c.concept_id
GROUP BY c.concept_name
ORDER BY n_participants DESC
LIMIT 20;
```

```sql
--Description: 10) View a random sample of participants who carry *any* of the four dermatologic conditions of interest.
WITH disease_codes AS (
  SELECT 'L70' AS prefix UNION ALL SELECT 'L20' UNION ALL SELECT 'L40' UNION ALL SELECT 'L80'
),
icd10cm_concepts AS (
  SELECT c.concept_id
  FROM   disease_codes d
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
         ON c.vocabulary_id = 'ICD10CM'
        AND c.concept_code  LIKE CONCAT(d.prefix, '%')
),
standard_concepts AS (
  SELECT cr.concept_id_2 AS standard_concept_id
  FROM   icd10cm_concepts i
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON i.concept_id = cr.concept_id_1
  WHERE  cr.relationship_id = 'Maps to'
),
all_related AS (
  SELECT DISTINCT ca.descendant_concept_id
  FROM   standard_concepts s
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON s.standard_concept_id = ca.ancestor_concept_id
  UNION DISTINCT
  SELECT standard_concept_id FROM standard_concepts
)
SELECT DISTINCT person_id
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
WHERE  condition_concept_id IN (SELECT * FROM all_related)
LIMIT 20;
```
