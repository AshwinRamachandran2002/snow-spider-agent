--Description: 9) Break down Acne (L70*) participants by each specific descendant standard concept to check distribution.
WITH acne_root AS (
  SELECT cr.concept_id_2 AS standard_concept_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`              c
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON c.concept_id = cr.concept_id_1
  WHERE  c.vocabulary_id   = 'ICD10CM'
    AND  c.concept_code    LIKE 'L70%'
    AND  cr.relationship_id = 'Maps to'
),
acne_descendants AS (
  SELECT DISTINCT ca.descendant_concept_id
  FROM   acne_root  ar
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON ar.standard_concept_id = ca.ancestor_concept_id
  UNION DISTINCT
  SELECT standard_concept_id FROM acne_root
),
acne_persons AS (
  SELECT condition_concept_id,
         person_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
  WHERE  condition_concept_id IN (SELECT * FROM acne_descendants)
)
SELECT c.concept_name,
       COUNT(DISTINCT person_id) AS n_participants
FROM   acne_persons ap
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
       ON ap.condition_concept_id = c.concept_id
GROUP BY c.concept_name
ORDER BY n_participants DESC
LIMIT 20;
