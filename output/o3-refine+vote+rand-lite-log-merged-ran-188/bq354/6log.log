--Description: Final query – compute the percentage of total participants represented by each disease group.  
--Reuses the mapping/ancestor logic from the previous query and divides counts by the overall unique participant total.  
WITH src_codes AS (
  SELECT 'Acne'               AS disease, 'L70' AS src_code UNION ALL
  SELECT 'Atopic dermatitis', 'L20' UNION ALL
  SELECT 'Psoriasis',         'L40' UNION ALL
  SELECT 'Vitiligo',          'L80'
),
roots AS (
  SELECT sc.disease,
         cr.concept_id_2 AS std_id
  FROM   src_codes sc
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`            src
         ON src.vocabulary_id = 'ICD10CM' AND src.concept_code = sc.src_code
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON cr.concept_id_1 = src.concept_id
  WHERE  cr.relationship_id = 'Maps to'
),
desc_cte AS (
  SELECT r.disease,
         ca.descendant_concept_id
  FROM   roots r
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON ca.ancestor_concept_id = r.std_id
),
disease_counts AS (
  SELECT d.disease,
         COUNT(DISTINCT co.person_id) AS disease_participants
  FROM   desc_cte d
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
         ON co.condition_concept_id = d.descendant_concept_id
  GROUP BY d.disease
),
total AS (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
)
SELECT  dc.disease,
        dc.disease_participants,
        t.total_participants,
        ROUND(100.0 * dc.disease_participants / t.total_participants, 2) AS pct_of_participants
FROM    disease_counts dc
CROSS JOIN total t
ORDER BY pct_of_participants DESC
