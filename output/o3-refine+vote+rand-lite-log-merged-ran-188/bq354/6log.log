```sql
--Description: Retrieve distinct participants who have any Acne-related condition_occurrence.  
--Steps:  
--  • Map source ICD-10-CM code L70 to its standard concept via “Maps to”.  
--  • Use that standard concept_id as the ancestor in CONCEPT_ANCESTOR to collect all Acne descendants.  
--  • Join those descendants to CONDITION_OCCURRENCE to list persons that carry an Acne diagnosis.  
WITH std_acne AS (                -- standard concept for Acne
  SELECT cr.concept_id_2 AS std_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` src
         ON src.concept_id = cr.concept_id_1
  WHERE  src.vocabulary_id = 'ICD10CM'
    AND  src.concept_code  = 'L70'
    AND  cr.relationship_id = 'Maps to'
  LIMIT 1
),
acne_desc AS (                     -- all descendant concept_ids of Acne
  SELECT ca.descendant_concept_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
  JOIN   std_acne sa
         ON sa.std_id = ca.ancestor_concept_id
)
SELECT DISTINCT
       co.person_id,
       co.condition_concept_id
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
JOIN   acne_desc ad
       ON co.condition_concept_id = ad.descendant_concept_id
LIMIT 20;
```

```sql
--Description: Count the total number of unique participants that have at least one record in CONDITION_OCCURRENCE.  
SELECT COUNT(DISTINCT person_id) AS total_participants
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`;
```

```sql
--Description: Aggregate the number of participants for each disease group (Acne, Atopic dermatitis, Psoriasis, Vitiligo).  
--Every ICD-10-CM root code is first mapped to its standard concept(s); those standard concept_ids are then used   
--as ancestors in CONCEPT_ANCESTOR to collect all descendant condition concept_ids.  
WITH src_codes AS (                -- disease ↔ ICD-10-CM code
  SELECT 'Acne'               AS disease, 'L70' AS src_code UNION ALL
  SELECT 'Atopic dermatitis', 'L20' UNION ALL
  SELECT 'Psoriasis',         'L40' UNION ALL
  SELECT 'Vitiligo',          'L80'
),
roots AS (                         -- map each source code to its standard ancestor concept_id
  SELECT sc.disease,
         cr.concept_id_2 AS std_id
  FROM   src_codes sc
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`            src
         ON src.vocabulary_id = 'ICD10CM' AND src.concept_code = sc.src_code
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON cr.concept_id_1 = src.concept_id
  WHERE  cr.relationship_id = 'Maps to'
),
desc_cte AS (                       -- collect descendants for every disease
  SELECT r.disease,
         ca.descendant_concept_id
  FROM   roots r
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON ca.ancestor_concept_id = r.std_id
)
SELECT  d.disease,
        COUNT(DISTINCT co.person_id) AS disease_participants
FROM    desc_cte d
JOIN    `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
       ON co.condition_concept_id = d.descendant_concept_id
GROUP BY d.disease
ORDER BY d.disease;
```

```sql
--Description: Final query – compute the percentage of total participants represented by each disease group.  
--Reuses the mapping/ancestor logic from the previous query and divides counts by the overall unique participant total.  
WITH src_codes AS (
  SELECT 'Acne'               AS disease, 'L70' AS src_code UNION ALL
  SELECT 'Atopic dermatitis', 'L20' UNION ALL
  SELECT 'Psoriasis',         'L40' UNION ALL
  SELECT 'Vitiligo',          'L80'
),
roots AS (
  SELECT sc.disease,
         cr.concept_id_2 AS std_id
  FROM   src_codes sc
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`            src
         ON src.vocabulary_id = 'ICD10CM' AND src.concept_code = sc.src_code
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON cr.concept_id_1 = src.concept_id
  WHERE  cr.relationship_id = 'Maps to'
),
desc_cte AS (
  SELECT r.disease,
         ca.descendant_concept_id
  FROM   roots r
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
         ON ca.ancestor_concept_id = r.std_id
),
disease_counts AS (
  SELECT d.disease,
         COUNT(DISTINCT co.person_id) AS disease_participants
  FROM   desc_cte d
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
         ON co.condition_concept_id = d.descendant_concept_id
  GROUP BY d.disease
),
total AS (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
)
SELECT  dc.disease,
        dc.disease_participants,
        t.total_participants,
        ROUND(100.0 * dc.disease_participants / t.total_participants, 2) AS pct_of_participants
FROM    disease_counts dc
CROSS JOIN total t
ORDER BY pct_of_participants DESC;
```
