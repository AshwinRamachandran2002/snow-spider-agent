```sql
--Description:
--Goal: list descendant concepts of “Acne” that we can later use for patient counting.
--Why the two-step approach?
--  • ICD-10-CM codes (e.g., L70) are NON-standard in the OMOP vocabulary, so they do not appear as ancestors
--    inside CONCEPT_ANCESTOR.  
--  • We must first translate L70 to its STANDARD concept(s) via the “Maps to” relationship; those standard
--    concept_id(s) are the true ancestors in the hierarchy.
--Single-query logic:
--  1) CTE standard_acne – obtain the standard concept_id mapped from ICD-10-CM code L70.  
--  2) Use that concept_id as ancestor_concept_id in CONCEPT_ANCESTOR to fetch every descendant concept_id.  
--  3) Join to CONCEPT to display readable names/codes.
WITH standard_acne AS (
  SELECT cr.concept_id_2 AS standard_concept_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`            src
         ON src.concept_id = cr.concept_id_1
  WHERE  src.vocabulary_id  = 'ICD10CM'
    AND  src.concept_code   = 'L70'      -- Acne, source (non-standard)
    AND  cr.relationship_id = 'Maps to'  -- translation to standard
  LIMIT 1                                 -- there is typically a single standard map
)
SELECT
    ca.ancestor_concept_id   AS acne_std_concept_id,
    ca.descendant_concept_id,
    d.concept_name,
    d.concept_code,
    d.vocabulary_id
FROM  `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
JOIN  standard_acne sa
      ON sa.standard_concept_id = ca.ancestor_concept_id
JOIN  `bigquery-public-data.cms_synthetic_patient_data_omop.concept` d
      ON d.concept_id = ca.descendant_concept_id
LIMIT 20;
```
