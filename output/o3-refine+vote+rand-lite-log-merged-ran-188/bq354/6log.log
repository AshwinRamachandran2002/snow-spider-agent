--  • Join those descendants to CONDITION_OCCURRENCE to list persons that carry an Acne diagnosis.  
WITH std_acne AS (                -- standard concept for Acne
  SELECT cr.concept_id_2 AS std_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` src
         ON src.concept_id = cr.concept_id_1
  WHERE  src.vocabulary_id = 'ICD10CM'
    AND  src.concept_code  = 'L70'
    AND  cr.relationship_id = 'Maps to'
  LIMIT 1
),
acne_desc AS (                     -- all descendant concept_ids of Acne
  SELECT ca.descendant_concept_id
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
  JOIN   std_acne sa
         ON sa.std_id = ca.ancestor_concept_id
)
SELECT DISTINCT
       co.person_id,
       co.condition_concept_id
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
JOIN   acne_desc ad
       ON co.condition_concept_id = ad.descendant_concept_id
LIMIT 20
