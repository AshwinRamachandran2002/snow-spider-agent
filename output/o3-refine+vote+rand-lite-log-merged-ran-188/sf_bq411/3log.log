Query:
--Description: Aggregate the three highest-ranked terms (1–3) by refresh_date in the same period.
SELECT
    "refresh_date",
    LISTAGG("term", ', ') WITHIN GROUP (ORDER BY "rank") AS "top_terms_1_3"
FROM
    GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE
    "week" BETWEEN '2024-09-01' AND '2024-09-14'
    AND "rank" IN (1, 2, 3)
GROUP BY
    "refresh_date"
ORDER BY
    "refresh_date" DESC
LIMIT 20
