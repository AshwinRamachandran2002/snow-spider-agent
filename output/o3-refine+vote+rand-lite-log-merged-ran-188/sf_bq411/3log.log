```sql
--Description: Preview a handful of rows in the target time-frame (Sept 1–14, 2024) from TOP_TERMS
SELECT *
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
LIMIT 20;
```

```sql
--Description: List the distinct “refresh_date” values that appear in the same time-window
SELECT DISTINCT "refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
ORDER BY "refresh_date" DESC
LIMIT 20;
```

```sql
--Description: Inspect ranks 1–5 (to confirm ranking distribution) for the chosen period
SELECT "week",
       "term",
       "rank",
       "score",
       "refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" <= 5
ORDER BY "week", "rank"
LIMIT 20;
```

```sql
--Description: Show the same result set, but only for business-days (Mon–Fri);  
--DAYOFWEEK() returns 1=Sun … 7=Sat in Snowflake
SELECT "week",
       DAYOFWEEK("week") AS "dow",
       "term",
       "rank",
       "refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DAYOFWEEK("week") BETWEEN 2 AND 6        -- Mon=2 … Fri=6
ORDER BY "week", "rank"
LIMIT 20;
```

```sql
--Description: Verify which ranks 1–3 exist on each “refresh_date” in the same period
SELECT "refresh_date",
       "week",
       "term",
       "rank"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DAYOFWEEK("week") BETWEEN 2 AND 6
  AND "rank" IN (1,2,3)
ORDER BY "refresh_date" DESC, "rank"
LIMIT 20;
```

```sql
--Description: Aggregate terms of ranks 1-3 for every business-day, grouped by “refresh_date”  
--(pre-step before the final answer query)
SELECT "refresh_date",
       LISTAGG("term", ', ') WITHIN GROUP (ORDER BY "rank") AS "top_terms_1_3"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DAYOFWEEK("week") BETWEEN 2 AND 6
  AND "rank" IN (1,2,3)
GROUP BY "refresh_date"
ORDER BY "refresh_date" DESC
LIMIT 20;
```

```sql
--Description: Final query – returns the three top-ranked terms (1, 2, 3) for each business-day,  
--ordered by “refresh_date” (newest first)
SELECT "refresh_date",
       "week",
       "rank",
       "term"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DAYOFWEEK("week") BETWEEN 2 AND 6
  AND "rank" IN (1, 2, 3)
ORDER BY "refresh_date" DESC, "rank"
LIMIT 20;
```

```sql
--Description: Distinct weekdays covered in the result set to double-check Monday–Friday constraint
