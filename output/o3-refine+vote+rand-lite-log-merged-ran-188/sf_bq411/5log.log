```sql
--Description: Look only at rows whose “week” falls between 2024-09-01 and 2024-09-14 (inclusive) to verify data exist for the target window.  
SELECT "week",
       "term",
       "rank",
       "refresh_date",
       "dma_name"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
ORDER BY "week"
LIMIT 20;
```

```sql
--Description: Add a weekday name helper column so we can later filter Monday-Friday.  
SELECT "week",
       TO_CHAR("week", 'DY')               AS "weekday",
       "term",
       "rank",
       "refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
ORDER BY "week"
LIMIT 20;
```

```sql
--Description: Display only Monday-Friday rows in the same two-week window.  
SELECT "week",
       TO_CHAR("week", 'DY') AS "weekday",
       "term",
       "rank",
       "refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND TO_CHAR("week", 'DY') NOT ILIKE '%SAT%'
  AND TO_CHAR("week", 'DY') NOT ILIKE '%SUN%'
ORDER BY "week"
LIMIT 20;
```

```sql
--Description: Focus on the top-ranked terms (ranks 1–3) inside the date window to ensure they are present.  
SELECT "week",
       "term",
       "rank",
       "refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1,2,3)
ORDER BY "week", "rank"
LIMIT 20;
```

```sql
--Description: Check the distinct list of refresh_date values available for the chosen period.  
SELECT DISTINCT "refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
ORDER BY "refresh_date" DESC
LIMIT 20;
```

```sql
--Description: Combine weekday filtering and rank filtering to preview exactly the data of interest.  
SELECT "refresh_date",
       "week",
       "term",
       "rank"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1,2,3)
  AND TO_CHAR("week", 'DY') NOT ILIKE '%SAT%'
  AND TO_CHAR("week", 'DY') NOT ILIKE '%SUN%'
ORDER BY "refresh_date" DESC, "rank"
LIMIT 20;
```

```sql
--Description: Use ROW_NUMBER to validate that only one row per (refresh_date, rank) pair exists when partitioned by refresh_date.  
SELECT "refresh_date",
       "rank",
       "term",
       ROW_NUMBER() OVER (PARTITION BY "refresh_date", "rank" ORDER BY "week") AS "rn"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1,2,3)
  AND TO_CHAR("week", 'DY') NOT ILIKE '%SAT%'
  AND TO_CHAR("week", 'DY') NOT ILIKE '%SUN%'
ORDER BY "refresh_date" DESC, "rank"
LIMIT 20;
```

```sql
--Description: Aggregate to show how many qualifying rows exist for each refresh_date; expect at most 3 (ranks 1–3).  
SELECT "refresh_date",
       COUNT(*) AS "num_rows"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1,2,3)
  AND TO_CHAR("week", 'DY') NOT ILIKE '%SAT%'
  AND TO_CHAR("week", 'DY') NOT ILIKE '%SUN%'
GROUP BY "refresh_date"
ORDER BY "refresh_date" DESC
LIMIT 20;
```

```sql
--Description: Final query – retrieve the top three (rank 1, 2, 3) search terms for each weekday (Mon-Fri) between 2024-09-01 and 2024-09-14, grouped by refresh_date and ordered by refresh_date descending.  
SELECT "refresh_date",
       "week",
       "term",
       "rank"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1,2,3)
  AND TO_CHAR("week", 'DY') NOT ILIKE '%SAT%'
  AND TO_CHAR("week", 'DY') NOT ILIKE '%SUN%'
ORDER BY "refresh_date" DESC,
         "rank"
LIMIT 20;
```
