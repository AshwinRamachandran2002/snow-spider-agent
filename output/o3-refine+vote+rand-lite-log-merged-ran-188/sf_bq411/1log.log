--Description:  LISTAGG needs the Snowflake form `LISTAGG(expr, ', ') WITHIN GROUP (ORDER BY col)`.
--              Ordering by a column literally named "rank" can raise an error because “rank” is a
--              reserved word.  To avoid that, put the needed rows in a sub-query and alias "rank"
--              to RNK.  The outer query then aggregates the ≤3 highest-ranked terms for each
--              (refresh_date, week) between 2024-09-01 and 2024-09-14, concatenating them in
--              rank order.  Results are sorted by newest refresh_date and limited to 20 rows.
SELECT
    t."refresh_date",
    t."week",
    LISTAGG(t."term", ', ') WITHIN GROUP (ORDER BY t.RNK) AS "top_3_terms"
FROM (
    SELECT
        "refresh_date",
        "week",
        "term",
        "rank" AS RNK
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
    WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
      AND "rank" <= 3
) t
GROUP BY
    t."refresh_date",
    t."week"
ORDER BY
    t."refresh_date" DESC
LIMIT 20;
```
