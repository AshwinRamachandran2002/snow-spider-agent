```sql
--Description:  Return the top-three Google-Trends search terms (ranks 1-3) that fall on
--              weekdays (Mon-Fri → DAYOFWEEK 1-5) for the window 01-Sep-2024–14-Sep-2024.
--              For each refresh_date we concatenate the three terms (ordered by rank)
--              into one string so the result is “grouped by refresh_date” and shown
--              from newest to oldest.
SELECT
    "refresh_date",
    LISTAGG(DISTINCT CONCAT('(', "rank", ') ', "term"), ' | ')
            WITHIN GROUP (ORDER BY "rank")     AS "top_3_terms"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1, 2, 3)
  AND DAYOFWEEK("week") BETWEEN 1 AND 5         -- 0=Sun, 1=Mon, … 5=Fri
GROUP BY "refresh_date"
ORDER BY "refresh_date" DESC
LIMIT 20;
```
