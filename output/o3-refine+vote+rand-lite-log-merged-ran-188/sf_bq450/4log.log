```sql
-- Description: Sample of regular ETH transactions that occurred before Jan-01-2017
SELECT DISTINCT 
       "from_address", 
       "to_address", 
       "value", 
       "gas_price", 
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
WHERE  "block_timestamp" < 1483228800000000            -- 2017-01-01 in µs
LIMIT  20;
```

```sql
-- Description: Inspect different trace & call types (first 20 distinct combos)
SELECT DISTINCT 
       "trace_type", 
       "call_type", 
       "status", 
       "error"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
LIMIT  20;
```

```sql
-- Description: Look at mining-reward traces prior to Jan-01-2017
SELECT DISTINCT 
       "to_address"      AS "miner_address",
       "value"           AS "reward_wei",
       "reward_type",
       "block_number",
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE  "trace_type" = 'reward'
  AND  "block_timestamp" < 1483228800000000
LIMIT  20;
```

```sql
-- Description: Token transfer logs that happened before Jan-01-2017
SELECT DISTINCT
       "token_address",
       "from_address",
       "to_address",
       "value",
       "block_number",
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
WHERE  "block_timestamp" < 1483228800000000
LIMIT  20;
```

```sql
-- Description: Contracts created before Jan-01-2017 with their bytecode size
SELECT DISTINCT
       "address",
       LEN("bytecode")       AS "bytecode_size",
       "block_number",
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.CONTRACTS
WHERE  "block_timestamp" < 1483228800000000
LIMIT  20;
```

```sql
-- Description: Transactions where a smart-contract was created (receipt_contract_address not null) before Jan-01-2017
SELECT DISTINCT
       "hash",
       "from_address",
       "receipt_contract_address",
       "gas",
       "receipt_gas_used",
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
WHERE  "receipt_contract_address" IS NOT NULL
  AND  "block_timestamp" < 1483228800000000
LIMIT  20;
```

```sql
-- Description: Failed traces (status = 0) before Jan-01-2017
SELECT DISTINCT
       "transaction_hash",
       "from_address",
       "to_address",
       "trace_type",
       "call_type",
       "error",
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE  "status" = 0
  AND  "block_timestamp" < 1483228800000000
LIMIT  20;
```

```sql
-- Description: Examine ERC-20 token metadata created before Jan-01-2017
SELECT DISTINCT
       "address",
       "symbol",
       "name",
       "decimals",
       "block_number",
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKENS
WHERE  "block_timestamp" < 1483228800000000
LIMIT  20;
```

```sql
-- Description: Quick view of hourly activity (by raw timestamp) for early transactions
SELECT DISTINCT
       "from_address",
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
WHERE  "block_timestamp" < 1483228800000000
ORDER BY "block_timestamp"
LIMIT  20;
```

```sql
-- Description: Sample of incoming traces (call type = 'call', positive value) to inspect gas usage pre-2017
SELECT DISTINCT
       "to_address",
       "from_address",
       "value",
       "gas_used",
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE  "trace_type" = 'call'
  AND  "call_type" = 'call'
  AND  "value"      > 0
  AND  "block_timestamp" < 1483228800000000
LIMIT  20;
```
