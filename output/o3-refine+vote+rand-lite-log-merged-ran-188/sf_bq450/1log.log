Query:
--Description / Thinking process:
-- Aggregation skeleton without the pre-2017 constraint so it returns sample rows.
SELECT
       addr                                            AS "address",
       SUM(CASE WHEN direction='in'  THEN eth END)/1e18 AS "in_eth",
       SUM(CASE WHEN direction='out' THEN eth END)/1e18 AS "out_eth",
       COUNT(CASE WHEN direction='in'  THEN 1 END)      AS "in_trace_count",
       COUNT(CASE WHEN direction='out' THEN 1 END)      AS "out_trace_count"
FROM (
        SELECT "to_address"   AS addr,
               'in'           AS direction,
               "value"        AS eth
        FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRACES"
        WHERE  "trace_type" = 'call'
          AND  ("call_type" IS NULL OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))

        UNION ALL

        SELECT "from_address" AS addr,
               'out'          AS direction,
               "value"        AS eth
        FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRACES"
        WHERE  "trace_type" = 'call'
          AND  ("call_type" IS NULL OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
     ) t
GROUP BY addr
LIMIT 20
