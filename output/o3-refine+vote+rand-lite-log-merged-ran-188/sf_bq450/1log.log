```sql
--Description: Inspect 20 distinct sender addresses that executed any transaction before 1-Jan-2017
SELECT DISTINCT
       "from_address"        AS "address",
       "block_timestamp"
FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRANSACTIONS"
WHERE  "block_timestamp" < 1483228800000000          -- 2017-01-01 in µs
LIMIT  20;
```

```sql
--Description: Preview incoming traces (call-type only) prior to 2017, excluding delegatecall/callcode/staticcall
SELECT DISTINCT
       "to_address"          AS "recipient",
       "from_address"        AS "sender",
       "call_type",
       "value",
       "gas_used",
       "status",
       "block_timestamp"
FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRACES"
WHERE  "block_timestamp" < 1483228800000000
  AND  "trace_type"   = 'call'
  AND  ("call_type" IS NULL OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
LIMIT  20;
```

```sql
--Description: Sample outgoing token transfers (ERC-20) before 2017 to see token & counterparty variety
SELECT DISTINCT
       "from_address",
       "to_address",
       "token_address",
       "value",
       "block_timestamp"
FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
WHERE  "block_timestamp" < 1483228800000000
LIMIT  20;
```

```sql
--Description: List 20 different reward traces (mining / uncle) before 2017 to capture reward receivers
SELECT DISTINCT
       "to_address"       AS "miner",
       "value",
       "reward_type",
       "block_number",
       "block_timestamp"
FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRACES"
WHERE  "block_timestamp" < 1483228800000000
  AND  "trace_type" = 'reward'
LIMIT  20;
```

```sql
--Description: Show 20 contract-creation traces before 2017 to verify creators and bytecode availability
SELECT DISTINCT
       "from_address"     AS "creator",
       "to_address"       AS "new_contract",
       "value",
       "gas_used",
       "block_timestamp"
FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRACES"
WHERE  "block_timestamp" < 1483228800000000
  AND  "trace_type" = 'create'
LIMIT  20;
```

```sql
--Description: Examine failed transactions (receipt_status = 0) initiated before 2017
SELECT DISTINCT
       "from_address",
       "to_address",
       "hash",
       "gas",
       "receipt_gas_used",
       "receipt_status",
       "block_timestamp"
FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRANSACTIONS"
WHERE  "block_timestamp" < 1483228800000000
  AND  "receipt_status" = 0
LIMIT  20;
```

```sql
--Description: Peek at bytecode sizes of contracts deployed before 2017
SELECT
       "address",
       LENGTH("bytecode") AS "bytecode_size",
       "block_timestamp"
FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."CONTRACTS"
WHERE  "block_timestamp" < 1483228800000000
LIMIT  20;
```

```sql
--Description: Calculate per-address ETH sent & fees (gas_used*gas_price) for 20 random early senders
SELECT
       "from_address"                                 AS "sender",
       SUM("value")/1e18                              AS "total_eth_sent",
       SUM("receipt_gas_used"*"gas_price")/1e18       AS "total_fee_eth"
FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRANSACTIONS"
WHERE  "block_timestamp" < 1483228800000000
  AND  "receipt_status" = 1
GROUP  BY "from_address"
LIMIT  20;
```

```sql
--Description: Hourly distribution check – count transactions for each sender by hour of day (UTC) pre-2017
SELECT
       "from_address"                     AS "sender",
       FLOOR(("block_timestamp"/1000000)/3600)%24 AS "tx_hour",
       COUNT(*)                           AS "tx_count"
FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRANSACTIONS"
WHERE  "block_timestamp" < 1483228800000000
GROUP  BY "from_address", FLOOR(("block_timestamp"/1000000)/3600)%24
LIMIT  20;
```

```sql
--Description: Comprehensive aggregation skeleton for addresses active pre-2017 (sample 20 rows)
SELECT
       addr                                        AS "address",
       SUM(CASE WHEN direction='in'  THEN eth END)/1e18  AS "in_eth",
       SUM(CASE WHEN direction='out' THEN eth END)/1e18  AS "out_eth",
       COUNT(CASE WHEN direction='in'  THEN 1 END)       AS "in_trace_count",
       COUNT(CASE WHEN direction='out' THEN 1 END)       AS "out_trace_count"
FROM (
        SELECT "to_address"   AS addr,
               'in'           AS direction,
               "value"        AS eth
        FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRACES"
        WHERE  "block_timestamp" < 1483228800000000
          AND  "trace_type" = 'call'
          AND  ("call_type" IS NULL OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))

        UNION ALL

        SELECT "from_address" AS addr,
               'out'          AS direction,
               "value"        AS eth
        FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRACES"
        WHERE  "block_timestamp" < 1483228800000000
          AND  "trace_type" = 'call'
          AND  ("call_type" IS NULL OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
     ) t
GROUP BY addr
LIMIT 20;
```
