```sql
--Description: 2) List all distinct dates between March and May 2020 that exist in the state table
SELECT DISTINCT date
FROM `bigquery-public-data.covid19_nyt.us_states`
WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
ORDER BY date
LIMIT 20;
```

```sql
--Description: 3) Calculate the daily new-case count for every state (sample 20 rows shown)
SELECT
  date,
  state_name,
  confirmed_cases - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS new_cases
FROM `bigquery-public-data.covid19_nyt.us_states`
WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
ORDER BY date, new_cases DESC
LIMIT 20;
```

```sql
--Description: 4) For each date, pick the top-5 states by new cases (daily increases) during Mar-May 2020
WITH state_daily AS (
  SELECT
    date,
    state_name,
    confirmed_cases - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT *
FROM (
  SELECT
    date,
    state_name,
    new_cases,
    ROW_NUMBER() OVER (PARTITION BY date ORDER BY new_cases DESC) AS rnk
  FROM state_daily
)
WHERE rnk <= 5
ORDER BY date, rnk
LIMIT 20;
```

```sql
--Description: 5) Count how often each state appears in those daily top-5 lists
WITH daily_top5 AS (
  SELECT
    date,
    state_name
  FROM (
      SELECT
        date, state_name,
        ROW_NUMBER() OVER (PARTITION BY date ORDER BY (confirmed_cases - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date)) DESC) AS rnk
      FROM `bigquery-public-data.covid19_nyt.us_states`
      WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
  )
  WHERE rnk <= 5
)
SELECT
  state_name,
  COUNT(*) AS appearances
FROM daily_top5
GROUP BY state_name
ORDER BY appearances DESC
LIMIT 20;
```

```sql
--Description: 6) Produce the full ranking of states by frequency in the daily top-5
WITH daily_top5 AS (
  SELECT
    date,
    state_name
  FROM (
      SELECT
        date, state_name,
        ROW_NUMBER() OVER (PARTITION BY date ORDER BY (confirmed_cases - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date)) DESC) AS rnk
      FROM `bigquery-public-data.covid19_nyt.us_states`
      WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
  )
  WHERE rnk <= 5
)
SELECT
  state_name,
  COUNT(*) AS appearances,
  DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS overall_rank
FROM daily_top5
GROUP BY state_name
ORDER BY overall_rank, state_name
LIMIT 20;
```

```sql
--Description: 7) Identify the single state that ranks 4th overall (there may be ties, sample shown)
WITH ranked AS (
  SELECT
    state_name,
    COUNT(*) AS appearances,
    DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS overall_rank
  FROM (
      SELECT date, state_name
      FROM (
          SELECT
            date, state_name,
            ROW_NUMBER() OVER (PARTITION BY date ORDER BY (confirmed_cases - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date)) DESC) AS rnk
          FROM `bigquery-public-data.covid19_nyt.us_states`
          WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
      )
      WHERE rnk <= 5
  )
  GROUP BY state_name
)
SELECT *
FROM ranked
WHERE overall_rank = 4
LIMIT 20;
```

