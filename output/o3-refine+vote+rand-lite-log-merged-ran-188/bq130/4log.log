```sql
--Description / Thinking process:
--Goal: Find how often each U.S. state appears in the “daily-top-5” list of largest COVID-19
--case increases from 2020-03-01 through 2020-05-31.
--Steps
-- 1. state_daily CTE – Compute each state’s daily new-case count using LAG.
-- 2. Rank states by new cases for every date (ROW_NUMBER over each date).
-- 3. Keep rank ≤ 5 to capture that day’s top-five states (daily_top5).
-- 4. Count appearances of every state in daily_top5; sort by this frequency.
WITH state_daily AS (
  SELECT
    date,
    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
daily_top5 AS (
  SELECT
    date,
    state_name
  FROM (
    SELECT
      date,
      state_name,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY new_cases DESC) AS rnk
    FROM state_daily
  )
  WHERE rnk <= 5
)
SELECT
  state_name,
  COUNT(*) AS appearances
FROM daily_top5
GROUP BY state_name
ORDER BY appearances DESC
LIMIT 20;
```
