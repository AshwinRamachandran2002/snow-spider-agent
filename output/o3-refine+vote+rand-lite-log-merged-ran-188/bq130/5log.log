--Description: 
--Step-by-step in one query.  
--1)  state_daily:     Compute daily new-case counts for every U.S. state (1 Mar–31 May 2020).  
--2)  ranked_states:   For each day keep only states whose daily_new_cases is NOT NULL, rank
--                     them by descending new cases, and keep the Top-5 (rnk ≤ 5).  
--3)  state_counts:    Count how often each state appears in those daily Top-5 lists, then keep
--                     the five most-frequent states (this is the “overall ranking”).  
--4)  fourth_state:    Identify the state that ranks 4th in that overall list.  
--5)  county_daily:    For every county inside the 4th-place state, compute daily new-case
--                     counts over the same period.  
--6)  ranked_counties: Rank those counties each day by new cases (again filter out NULLs)
--                     and keep the Top-5 per day.  
--7)  county_counts:   Count how often each county appears in its state’s daily Top-5 list and
--                     take the five most-frequent counties.  
--8)  Final SELECT:    Present two pieces of information in one result set:  
--                     • the overall Top-5 state ranking (category = 'STATE_RANKING')  
--                     • the Top-5 counties inside the 4th-place state 
--                       (category = 'COUNTY_IN_FOURTH_STATE').  
WITH state_daily AS (
  SELECT
    date,
    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
ranked_states AS (
  SELECT
    date,
    state_name,
    daily_new_cases,
    RANK() OVER (PARTITION BY date ORDER BY daily_new_cases DESC) AS rnk
  FROM state_daily
  WHERE daily_new_cases IS NOT NULL
),
state_counts AS (
  SELECT
    state_name,
    COUNT(*) AS top5_appearances
  FROM ranked_states
  WHERE rnk <= 5
  GROUP BY state_name
  ORDER BY top5_appearances DESC
  LIMIT 5                           -- keep national Top-5
),
fourth_state AS (
  SELECT state_name
  FROM state_counts
  ORDER BY top5_appearances DESC
  LIMIT 1 OFFSET 3                  -- the 4th-place state
),
county_daily AS (
  SELECT
    uc.date,
    uc.county,
    uc.state_name,
    uc.confirmed_cases
      - LAG(uc.confirmed_cases) OVER (PARTITION BY uc.county ORDER BY uc.date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_counties` uc
  JOIN fourth_state fs
    ON uc.state_name = fs.state_name
  WHERE uc.date BETWEEN '2020-03-01' AND '2020-05-31'
),
ranked_counties AS (
  SELECT
    date,
    county,
    daily_new_cases,
    RANK() OVER (PARTITION BY date ORDER BY daily_new_cases DESC) AS rnk
  FROM county_daily
  WHERE daily_new_cases IS NOT NULL
),
county_counts AS (
  SELECT
    county,
    COUNT(*) AS top5_appearances
  FROM ranked_counties
  WHERE rnk <= 5
  GROUP BY county
  ORDER BY top5_appearances DESC
  LIMIT 5                           -- Top-5 counties within the 4th-place state
)
SELECT 'STATE_RANKING'  AS category,
       state_name       AS name,
       top5_appearances
FROM   state_counts

UNION ALL

SELECT 'COUNTY_IN_FOURTH_STATE',
       county,
