```sql
-- 1. Preview cumulative case counts reported for each state during the target window  
SELECT `date`,
       `state_name`,
       `confirmed_cases`
FROM   `bigquery-public-data.covid19_nyt.us_states`
WHERE  `date` BETWEEN '2020-03-01' AND '2020-05-31'
ORDER  BY `date`, `state_name`
LIMIT  20;
```

```sql
-- 2. Compute DAILY new-case counts for every state (lag from previous day)  
WITH state_daily AS (
  SELECT
    `date`,
    `state_name`,
    `confirmed_cases`
           - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name` ORDER BY `date`) 
           AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT *
FROM   state_daily
ORDER  BY `date`, `state_name`
LIMIT  20;
```

```sql
-- 3. For every day, pull the TOP-5 states by daily new cases  
WITH state_daily AS (
  SELECT
    `date`,
    `state_name`,
    `confirmed_cases`
           - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name` ORDER BY `date`) 
           AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
),
ranked AS (
  SELECT
    `date`,
    `state_name`,
    daily_new_cases,
    RANK() OVER (PARTITION BY `date` ORDER BY daily_new_cases DESC) AS rnk
  FROM state_daily
)
SELECT *
FROM   ranked
WHERE  rnk <= 5
ORDER  BY `date`, rnk
LIMIT  20;
```

```sql
-- 4. Count how often each state shows up in those daily TOP-5 lists  
WITH state_daily AS (
  SELECT
    `date`,
    `state_name`,
    `confirmed_cases`
           - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name` ORDER BY `date`) 
           AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
),
ranked AS (
  SELECT
    `date`,
    `state_name`,
    RANK() OVER (PARTITION BY `date` ORDER BY daily_new_cases DESC) AS rnk
  FROM state_daily
)
SELECT
  `state_name`,
  COUNT(*) AS top5_appearances
FROM   ranked
WHERE  rnk <= 5
GROUP  BY `state_name`
ORDER  BY top5_appearances DESC
LIMIT  20;
```

```sql
-- 5. Identify the state that finishes FOURTH in the overall ranking above  
WITH state_daily AS (
  SELECT
    `date`,
    `state_name`,
    `confirmed_cases`
           - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name` ORDER BY `date`) 
           AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
),
ranked AS (
  SELECT
    `date`,
    `state_name`,
    RANK() OVER (PARTITION BY `date` ORDER BY daily_new_cases DESC) AS rnk
  FROM state_daily
),
overall AS (
  SELECT
    `state_name`,
    COUNT(*) AS top5_appearances
  FROM ranked
  WHERE rnk <= 5
  GROUP BY `state_name`
  ORDER BY top5_appearances DESC
)
SELECT `state_name` AS fourth_place_state
FROM   overall
LIMIT  1 OFFSET 3;      -- returns the 4th-ranked state
```

```sql
-- 6. Compute daily new cases for EVERY county that belongs to the 4th-place state  
WITH fourth_state AS (                 -- obtain the state name once
  SELECT `state_name`
  FROM (
    SELECT
      `state_name`,
      COUNT(*) AS top5_appearances
    FROM (
      SELECT
        `date`,
        `state_name`,
        RANK() OVER (PARTITION BY `date`
                     ORDER BY `confirmed_cases` 
                            - LAG(`confirmed_cases`) OVER
                                 (PARTITION BY `state_name` ORDER BY `date`)
                     DESC) AS rnk
      FROM `bigquery-public-data.covid19_nyt.us_states`
      WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
    )
    WHERE rnk <= 5
    GROUP BY `state_name`
    ORDER BY top5_appearances DESC
  )
  LIMIT 1 OFFSET 3
),
county_daily AS (
  SELECT
    uc.`date`,
    uc.`county`,
    uc.`state_name`,
    uc.`confirmed_cases`
       - LAG(uc.`confirmed_cases`) OVER (PARTITION BY uc.`county` ORDER BY uc.`date`)
       AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_counties` AS uc
  JOIN fourth_state fs
    ON uc.`state_name` = fs.`state_name`
  WHERE uc.`date` BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT *
FROM   county_daily
ORDER  BY `date`, daily_new_cases DESC
LIMIT  20;
```

```sql
-- 7. For each day, take the TOP-5 counties (within that 4th-place state) by new cases  
