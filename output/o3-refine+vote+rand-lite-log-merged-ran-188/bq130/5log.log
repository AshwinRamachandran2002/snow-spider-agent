```sql
--Description:  (Query 7)  
--Return the Top-5 counties (per day) by daily new cases inside the 4th-ranked state.  
--Fix:  First create a state‐level CTE that already contains daily_new_cases, then rank
--      states per day without nesting analytic functions.  Identify the 4th-place state,
--      compute county-level daily_new_cases for that state, rank counties each day,
--      and keep the Top-5 rows.
WITH state_daily AS (                         -- state-level daily new cases
  SELECT
    date,
    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
ranked_states AS (                            -- per-day Top-5 states
  SELECT
    date,
    state_name,
    RANK() OVER (PARTITION BY date ORDER BY daily_new_cases DESC) AS rnk
  FROM state_daily
  WHERE daily_new_cases IS NOT NULL
),
overall AS (                                  -- count Top-5 appearances
  SELECT state_name, COUNT(*) AS cnt
  FROM ranked_states
  WHERE rnk <= 5
  GROUP BY state_name
  ORDER BY cnt DESC
),
fourth_state AS (                             -- the 4th-ranked state
  SELECT state_name
  FROM overall
  LIMIT 1 OFFSET 3
),
county_daily AS (                             -- county-level daily new cases
  SELECT
    c.date,
    c.county,
    c.state_name,
    c.confirmed_cases
      - LAG(c.confirmed_cases) OVER (PARTITION BY c.county ORDER BY c.date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_counties` c
  JOIN fourth_state f
    ON c.state_name = f.state_name
  WHERE c.date BETWEEN '2020-03-01' AND '2020-05-31'
),
ranked AS (                                   -- per-day Top-5 counties
  SELECT
    date,
    county,
    daily_new_cases,
    RANK() OVER (PARTITION BY date ORDER BY daily_new_cases DESC) AS rnk
  FROM county_daily
  WHERE daily_new_cases IS NOT NULL
)
SELECT *
FROM ranked
WHERE rnk <= 5
ORDER BY date, rnk
LIMIT 20;
