```sql
--Description: Preview state-level case data for March 2020 to see the basic columns we will use.
SELECT
  `date`,
  `state_name`,
  `confirmed_cases`,
  `deaths`
FROM
  `bigquery-public-data.covid19_nyt.us_states`
WHERE
  `date` BETWEEN '2020-03-01' AND '2020-03-31'
LIMIT 20;
```

```sql
--Description: Compute daily NEW case counts for every state from 1 Mar – 31 May 2020.
SELECT
  `date`,
  `state_name`,
  `confirmed_cases`,
  COALESCE(confirmed_cases
           - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date),0) AS new_cases
FROM
  `bigquery-public-data.covid19_nyt.us_states`
WHERE
  `date` BETWEEN '2020-03-01' AND '2020-05-31'
ORDER BY
  `date`, new_cases DESC
LIMIT 20;
```

```sql
--Description: Pull the TOP-5 states for each day based on the new case count.
SELECT *
FROM (
  SELECT
    `date`,
    `state_name`,
    new_cases,
    ROW_NUMBER() OVER (PARTITION BY `date` ORDER BY new_cases DESC) AS rn
  FROM (
    SELECT
      `date`,
      `state_name`,
      COALESCE(confirmed_cases
               - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date),0) AS new_cases
    FROM
      `bigquery-public-data.covid19_nyt.us_states`
    WHERE
      `date` BETWEEN '2020-03-01' AND '2020-05-31'
  )
)
WHERE rn <= 5
ORDER BY `date`, rn
LIMIT 20;
```

```sql
--Description: Count how many TIMES each state appears in the daily TOP-5 list.
SELECT
  `state_name`,
  COUNT(*) AS appearances_in_top5
FROM (
  SELECT
    `date`,
    `state_name`,
    ROW_NUMBER() OVER (PARTITION BY `date` ORDER BY new_cases DESC) AS rn
  FROM (
    SELECT
      `date`,
      `state_name`,
      COALESCE(confirmed_cases
               - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date),0) AS new_cases
    FROM
      `bigquery-public-data.covid19_nyt.us_states`
    WHERE
      `date` BETWEEN '2020-03-01' AND '2020-05-31'
  )
)
WHERE rn <= 5
GROUP BY `state_name`
ORDER BY appearances_in_top5 DESC
LIMIT 20;
```

```sql
--Description: Identify the STATE that ranks FOURTH overall in Top-5 appearances.
SELECT
  `state_name`
FROM (
  SELECT
    `state_name`,
    COUNT(*) AS appearances_in_top5
  FROM (
    SELECT
      `date`,
      `state_name`,
      ROW_NUMBER() OVER (PARTITION BY `date` ORDER BY new_cases DESC) AS rn
    FROM (
      SELECT
        `date`,
        `state_name`,
        COALESCE(confirmed_cases
                 - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date),0) AS new_cases
      FROM
        `bigquery-public-data.covid19_nyt.us_states`
      WHERE
        `date` BETWEEN '2020-03-01' AND '2020-05-31'
    )
  )
  WHERE rn <= 5
  GROUP BY `state_name`
  ORDER BY appearances_in_top5 DESC, `state_name`
  LIMIT 1 OFFSET 3   -- 0-based offset: 3 = fourth place
);
```

```sql
--Description: Compute daily NEW cases for every COUNTY in the 4th-ranked state for Mar–May 2020.
SELECT
  c.`date`,
  c.`state_name`,
  c.`county`,
  c.`confirmed_cases`,
  COALESCE(c.confirmed_cases
           - LAG(c.confirmed_cases) OVER (PARTITION BY c.state_name, c.county ORDER BY c.date),0)
           AS new_cases
FROM
  `bigquery-public-data.covid19_nyt.us_counties` AS c
WHERE
  c.`date` BETWEEN '2020-03-01' AND '2020-05-31'
  AND c.`state_name` = (
        SELECT `state_name`
        FROM (
          SELECT
            `state_name`,
            COUNT(*) AS appearances_in_top5
          FROM (
            SELECT
              `date`,
              `state_name`,
              ROW_NUMBER() OVER (PARTITION BY `date` ORDER BY new_cases DESC) AS rn
            FROM (
              SELECT
                `date`,
                `state_name`,
                COALESCE(confirmed_cases
                         - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date),0) AS new_cases
              FROM
                `bigquery-public-data.covid19_nyt.us_states`
              WHERE
                `date` BETWEEN '2020-03-01' AND '2020-05-31'
            )
          )
          WHERE rn <= 5
          GROUP BY `state_name`
          ORDER BY appearances_in_top5 DESC, `state_name`
          LIMIT 1 OFFSET 3
        )
      )
ORDER BY c.`date`, new_cases DESC
LIMIT 20;
```

```sql
