```sql
--Description / Thinking process:
-- We need two rankings, but will deliver them in one query using CTEs:
-- 1. National ranking: For every day (01-Mar-2020 → 31-May-2020) compute each state’s NEW cases,
--    keep the national daily Top-5, count how many times each state shows up, then pick the
--    state that comes FOURTH in that count (tie-broken alphabetically).  ➜ “state_rank” CTE.
-- 2. Inside that 4th-ranked state, compute each COUNTY’s daily NEW cases, keep that state’s
--    daily Top-5 counties, count their appearances, and finally return the five counties with
--    the most appearances.  ➜ “county_daily” + “county_top5” CTEs and final SELECT.

WITH
-- Step-1: identify the 4-th ranked state by national Top-5 appearances
state_rank AS (
  SELECT state_name, COUNT(*) AS appearances
  FROM (
    SELECT
      date,
      state_name,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY new_cases DESC) AS rn          -- Top-N per day
    FROM (
      SELECT
        date,
        state_name,
        COALESCE(confirmed_cases
                 - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date),0) AS new_cases
      FROM `bigquery-public-data.covid19_nyt.us_states`
      WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
    )
  )
  WHERE rn <= 5                                                                    -- national daily Top-5
  GROUP BY state_name
  ORDER BY appearances DESC, state_name
  LIMIT 1 OFFSET 3                                                                 -- 4-th place
),

-- Step-2: compute daily NEW cases for every county in that state
county_daily AS (
  SELECT
    date,
    county,
    COALESCE(confirmed_cases
             - LAG(confirmed_cases) OVER (PARTITION BY state_name, county ORDER BY date),0) AS new_cases
  FROM `bigquery-public-data.covid19_nyt.us_counties`
  WHERE
    date BETWEEN '2020-03-01' AND '2020-05-31'
    AND state_name IN (SELECT state_name FROM state_rank)
),

-- Step-3: keep the state’s daily Top-5 counties by NEW cases
county_top5 AS (
  SELECT
    date,
    county,
    ROW_NUMBER() OVER (PARTITION BY date ORDER BY new_cases DESC) AS rn
  FROM county_daily
  QUALIFY rn <= 5                                                                  -- state-level daily Top-5
)

-- Step-4: aggregate appearances and return the five counties with the most Top-5 days
SELECT
  county,
  COUNT(*) AS appearances_in_top5
FROM county_top5
GROUP BY county
ORDER BY appearances_in_top5 DESC
LIMIT 5;
