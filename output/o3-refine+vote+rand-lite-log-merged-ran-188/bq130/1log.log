             confirmed_cases - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new_cases
      FROM `bigquery-public-data.covid19_nyt.us_states`
      WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
    ),
    ranked AS (
      SELECT *, ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
      FROM daily
    ),
    top5 AS (SELECT state_name FROM ranked WHERE rn <= 5),
    state_rank AS (
      SELECT state_name, COUNT(*) AS appearances,
             DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS overall_rank
      FROM top5
      GROUP BY state_name
    )
    SELECT * FROM state_rank WHERE overall_rank = 4
  )
),
county_daily AS (
  SELECT
    c.date,
    c.state_name,
    c.county,
    c.confirmed_cases
    - LAG(c.confirmed_cases) OVER (PARTITION BY c.county ORDER BY c.date) AS county_daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_counties` AS c
  JOIN fourth_state USING (state_name)
  WHERE c.date BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT *
FROM county_daily
ORDER BY date, county
LIMIT 20;
