```sql
-- 4.  Top-five states *for every day* in the study window (first 20 rows)
WITH daily AS (
  SELECT
    date,
    state_name,
    confirmed_cases
    - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
ranked AS (
  SELECT
    *,
    ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
  FROM daily
)
SELECT
  date,
  state_name,
  daily_new_cases
FROM ranked
WHERE rn <= 5
ORDER BY date, rn
LIMIT 20;
```

```sql
-- 5.  Count how often each state appears in a daily top-five list (state ranking)
WITH daily AS (
  SELECT
    date,
    state_name,
    confirmed_cases
    - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
ranked AS (
  SELECT
    *,
    ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
  FROM daily
),
top5 AS (
  SELECT state_name
  FROM ranked
  WHERE rn <= 5
)
SELECT
  state_name,
  COUNT(*) AS appearances,
  DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS overall_rank
FROM top5
GROUP BY state_name
ORDER BY appearances DESC
LIMIT 20;
```

