```sql
--Description: Produce daily new-case counts for every state from 1 Mar 2020 through 31 May 2020  
SELECT
  `date`,
  `state_name`,
  `confirmed_cases` 
    - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name` ORDER BY `date`) AS `new_cases`
FROM `bigquery-public-data.covid19_nyt.us_states`
WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
ORDER BY `date`, `new_cases` DESC
LIMIT 20;
```

```sql
--Description: Show the five states with the largest new-case jump on 15 Apr 2020  
WITH state_daily AS (
  SELECT
    `date`,
    `state_name`,
    `confirmed_cases` 
      - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name` ORDER BY `date`) AS `new_cases`
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE `date` = '2020-04-15'
)
SELECT `state_name`, `new_cases`
FROM state_daily
ORDER BY `new_cases` DESC
LIMIT 20;
```

```sql
--Description: For every date (Mar–May 2020) keep only the five states with the biggest daily increases  
WITH state_daily AS (
  SELECT
    `date`,
    `state_name`,
    `confirmed_cases` 
      - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name` ORDER BY `date`) AS `new_cases`
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
), ranked AS (
  SELECT
    `date`,
    `state_name`,
    `new_cases`,
    DENSE_RANK() OVER (PARTITION BY `date` ORDER BY `new_cases` DESC) AS rk
  FROM state_daily
)
SELECT `date`, `state_name`, `new_cases`, rk
FROM ranked
WHERE rk <= 5
ORDER BY `date`, rk
LIMIT 20;
```

```sql
--Description: Count how often each state appears in a daily top-five list and rank them  
WITH state_daily AS (
  SELECT
    `date`,
    `state_name`,
    `confirmed_cases` 
      - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name` ORDER BY `date`) AS `new_cases`
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
), ranked AS (
  SELECT
    `date`,
    `state_name`,
    DENSE_RANK() OVER (PARTITION BY `date` ORDER BY `new_cases` DESC) AS rk
  FROM state_daily
), top_five AS (
  SELECT `state_name`
  FROM ranked
  WHERE rk <= 5
)
SELECT
  `state_name`,
  COUNT(*) AS appearances
FROM top_five
GROUP BY `state_name`
ORDER BY appearances DESC
LIMIT 20;
```

```sql
--Description: Identify which state ranks 4th in total appearances  
WITH state_daily AS (
  SELECT
    `date`,
    `state_name`,
    `confirmed_cases` 
      - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name` ORDER BY `date`) AS `new_cases`
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
), ranked AS (
  SELECT
    `date`,
    `state_name`,
    DENSE_RANK() OVER (PARTITION BY `date` ORDER BY `new_cases` DESC) AS rk
  FROM state_daily
), top_five AS (
  SELECT `state_name`
  FROM ranked
  WHERE rk <= 5
), tally AS (
  SELECT
    `state_name`,
    COUNT(*) AS appearances,
    DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS overall_rank
  FROM top_five
  GROUP BY `state_name`
)
SELECT *
FROM tally
WHERE overall_rank = 4
LIMIT 20;
```

```sql
--Description: Compute daily new cases for every county belonging to the state found above  
WITH fourth_state AS (
  -- re-use previous logic to isolate that one state
  WITH state_daily AS (
    SELECT
      `date`,
      `state_name`,
      `confirmed_cases` 
        - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name` ORDER BY `date`) AS `new_cases`
    FROM `bigquery-public-data.covid19_nyt.us_states`
    WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
  ), ranked AS (
    SELECT
      `date`,
      `state_name`,
      DENSE_RANK() OVER (PARTITION BY `date` ORDER BY `new_cases` DESC) AS rk
    FROM state_daily
  ), top_five AS (
    SELECT `state_name`
    FROM ranked
    WHERE rk <= 5
  ), tally AS (
    SELECT
      `state_name`,
      COUNT(*) AS appearances,
      DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS overall_rank
    FROM top_five
    GROUP BY `state_name`
  )
  SELECT `state_name`
  FROM tally
  WHERE overall_rank = 4
),
county_daily AS (
  SELECT
    u.`date`,
    u.`county`,
    u.`state_name`,
    u.`county_fips_code`,
    u.`confirmed_cases` 
      - LAG(u.`confirmed_cases`) OVER (PARTITION BY u.`county_fips_code` ORDER BY u.`date`) AS `new_cases`
  FROM `bigquery-public-data.covid19_nyt.us_counties` AS u
  JOIN fourth_state fs USING (`state_name`)
  WHERE u.`date` BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT *
FROM county_daily
ORDER BY `date`, `new_cases` DESC
LIMIT 20;
```

```sql
--Description: Retrieve each day’s five US counties with the largest new-case jump (Mar–May 2020)  
WITH county_daily AS (
  SELECT
    `date`,
    `county`,
    `state_name`,
    `county_fips_code`,
    `confirmed_cases` 
      - LAG(`confirmed_cases`) OVER (PARTITION BY `county_fips_code` ORDER BY `date`) AS `new_cases`
  FROM `bigquery-public-data.covid19_nyt.us_counties`
  WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
), ranked AS (
  SELECT
    `date`,
    `county`,
    `state_name`,
    `new_cases`,
    DENSE_RANK() OVER (PARTITION BY `date` ORDER BY `new_cases` DESC) AS rk
  FROM county_daily
)
SELECT `date`, `county`, `state_name`, `new_cases`, rk
FROM ranked
WHERE rk <= 5
ORDER BY `date`, rk
LIMIT 20;
```

```sql
--Description: Among those daily top-five counties, find the five counties of the 4th-ranked state that appear most often  
WITH fourth_state AS (
  -- isolate the 4th-ranked state exactly as before
  WITH state_daily AS (
    SELECT
      `date`,
      `state_name`,
      `confirmed_cases` 
        - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name` ORDER BY `date`) AS `new_cases`
    FROM `bigquery-public-data.covid19_nyt.us_states`
    WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
  ), ranked AS (
    SELECT
      `date`,
      `state_name`,
      DENSE_RANK() OVER (PARTITION BY `date` ORDER BY `new_cases` DESC) AS rk
    FROM state_daily
  ), top_five AS (
    SELECT `state_name`
    FROM ranked
    WHERE rk <= 5
  ), tally AS (
    SELECT
      `state_name`,
      COUNT(*) AS appearances,
      DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS overall_rank
    FROM top_five
    GROUP BY `state_name`
  )
  SELECT `state_name`
  FROM tally
  WHERE overall_rank = 4
),
county_daily AS (
  SELECT
    `date`,
    `county`,
    `state_name`,
    `county_fips_code`,
    `confirmed_cases` 
      - LAG(`confirmed_cases`) OVER (PARTITION BY `county_fips_code` ORDER BY `date`) AS `new_cases`
  FROM `bigquery-public-data.covid19_nyt.us_counties`
  WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
),
county_ranked AS (
  SELECT
    `date`,
    `county`,
    `state_name`,
    `new_cases`,
    DENSE_RANK() OVER (PARTITION BY `date` ORDER BY `new_cases` DESC) AS rk
  FROM county_daily
),
daily_top_counties AS (
  SELECT `county`, `state_name`
  FROM county_ranked
  WHERE rk <= 5
),
filtered AS (
  SELECT
    dtc.`county`,
    dtc.`state_name`,
    COUNT(*) AS appearances
  FROM daily_top_counties dtc
  JOIN fourth_state fs USING (`state_name`)
  GROUP BY dtc.`county`, dtc.`state_name`
)
SELECT *
FROM filtered
ORDER BY appearances DESC
LIMIT 20;
```
