```sql
--Description: Identify the state that ranks 4-th in how often it appears in the
--             daily Top-5 state-level increases (1 Mar–31 May 2020) and then
--             list up to 20 distinct counties belonging to that state.
--             Logic:
--               1. daily_new     – compute each state's day-over-day case gain.
--               2. daily_top5    – retain the five highest-gain states per day.
--               3. fourth_state  – count appearances, order, and take the 4-th.
--               4. Final output  – fetch counties for the found state.
WITH daily_new AS (
  SELECT
    date,
    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
