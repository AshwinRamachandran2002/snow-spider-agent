    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
state_top5 AS (                                 -- keep Top-5 states each day
  SELECT
    date,
    state_name
  FROM (
    SELECT
      date,
      state_name,
      DENSE_RANK() OVER (PARTITION BY date ORDER BY daily_new DESC) AS rnk
    FROM state_daily_new
  )
  WHERE rnk <= 5
),
state_freq AS (                                 -- appearances per state
  SELECT
    state_name,
    COUNT(*) AS appearances
  FROM state_top5
  GROUP BY state_name
),
target_state AS (                               -- 4-th most-frequent state
  SELECT state_name
  FROM state_freq
  ORDER BY appearances DESC, state_name
  LIMIT 1 OFFSET 3
),
