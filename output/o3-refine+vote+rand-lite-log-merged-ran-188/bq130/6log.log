Query:
--Description: 8) For every day (1 Mar – 31 May 2020) rank ALL U.S. counties
--             by their daily new-case count, keep the Top-5, then retain only
--             the rows that belong to the state that is 4-th most frequent in
--             the daily state-level Top-5 list.  Finally show the Top-5 county
--             rows (≤ 20 output lines).
WITH state_daily_new AS (                       -- state-level daily gains
  SELECT
    date,
    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
state_top5 AS (                                 -- keep Top-5 states each day
  SELECT
    date,
    state_name
  FROM (
    SELECT
      date,
      state_name,
      DENSE_RANK() OVER (PARTITION BY date ORDER BY daily_new DESC) AS rnk
    FROM state_daily_new
  )
  WHERE rnk <= 5
),
state_freq AS (                                 -- appearances per state
  SELECT
    state_name,
    COUNT(*) AS appearances
  FROM state_top5
  GROUP BY state_name
),
target_state AS (                               -- 4-th most-frequent state
  SELECT state_name
  FROM state_freq
  ORDER BY appearances DESC, state_name
  LIMIT 1 OFFSET 3
),
county_daily_new AS (                           -- county-level daily gains
  SELECT
    date,
    county,
    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY county_fips_code ORDER BY date) AS daily_new
  FROM `bigquery-public-data.covid19_nyt.us_counties`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
county_ranked AS (                              -- rank counties per day
  SELECT
    date,
    county,
    state_name,
    daily_new,
    DENSE_RANK() OVER (PARTITION BY date ORDER BY daily_new DESC) AS rnk
  FROM county_daily_new
)
SELECT
  date,
  county,
  state_name,
  daily_new
FROM county_ranked
WHERE rnk <= 5
  AND state_name = (SELECT state_name FROM target_state)
ORDER BY date, daily_new DESC
LIMIT 20
