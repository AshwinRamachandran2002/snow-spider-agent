--Description: Retrieve distinct counties for the state that ranks 4-th in
--             frequency of appearing in the nation-wide daily Top-5 state
--             new-case increases during 1 Mar–31 May 2020.
--             • Build state-level daily-new cases.  
--             • Per day, keep only the Top-5 states (QUALIFY rnk <= 5).  
--             • Count how often each state appears; pick the 4-th most frequent.  
--             • Return up to 20 counties that belong to that state.
SELECT DISTINCT
  c.county,
  c.state_name
FROM `bigquery-public-data.covid19_nyt.us_counties` AS c
WHERE c.state_name = (
  SELECT state_name
  FROM (
