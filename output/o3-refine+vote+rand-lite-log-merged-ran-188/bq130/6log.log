```sql
--Description: Identify the state that ranks 4-th in frequency of appearing in the
--             nation-wide daily Top-5 state-level COVID-19 case increases
--             (1 Mar 2020 – 31 May 2020).  Then list up to 20 distinct counties
--             belonging to that state.
WITH
-- 1. Calculate each state's day-over-day increase
daily_new AS (
  SELECT
    date,
    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
-- 2. Keep the Top-5 states (by new cases) for every day
daily_top5 AS (
  SELECT
    date,
    state_name
  FROM (
    SELECT
      date,
      state_name,
      DENSE_RANK() OVER (PARTITION BY date ORDER BY daily_new DESC) AS rnk
    FROM daily_new
  )
  WHERE rnk <= 5
),
-- 3. Count how often each state appears in those daily Top-5 lists
state_frequency AS (
  SELECT
    state_name,
    COUNT(*) AS appearances
  FROM daily_top5
  GROUP BY state_name
),
-- 4. Pick the 4-th most frequent state (ties broken alphabetically)
fourth_state AS (
  SELECT state_name
  FROM state_frequency
  ORDER BY appearances DESC, state_name
  LIMIT 1 OFFSET 3
)
-- 5. Return distinct counties that belong to that state
SELECT DISTINCT
  county,
  state_name
FROM `bigquery-public-data.covid19_nyt.us_counties`
WHERE state_name = (SELECT state_name FROM fourth_state)
LIMIT 20;
```
