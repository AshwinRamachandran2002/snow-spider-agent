-- 7. Compute daily-new case counts for every county in that 4-th-ranked state
WITH target_state AS (
  SELECT `state_name`
  FROM (
    SELECT
      `state_name`,
      COUNT(*) AS appearances
    FROM (
      SELECT
        `date`,
        `state_name`,
        DENSE_RANK() OVER (PARTITION BY `date` ORDER BY daily_new DESC) AS rnk
      FROM (
        SELECT
          `date`,
          `state_name`,
          `confirmed_cases`
            - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name` ORDER BY `date`) AS daily_new
        FROM `bigquery-public-data.covid19_nyt.us_states`
        WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
      )
      WHERE rnk <= 5
    GROUP BY `state_name`
    ORDER BY appearances DESC, `state_name`
    LIMIT 1 OFFSET 3
  )
),
county_new AS (
  SELECT
    c.`date`,
    c.`county`,
    c.`state_name`,
    c.`confirmed_cases`
      - LAG(c.`confirmed_cases`) OVER (PARTITION BY c.`county_fips_code` ORDER BY c.`date`) AS daily_new
  FROM `bigquery-public-data.covid19_nyt.us_counties` AS c
  JOIN target_state t
  ON c.`state_name` = t.`state_name`
  WHERE c.`date` BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT *
FROM county_new
ORDER BY `date` DESC, daily_new DESC
LIMIT 20;
