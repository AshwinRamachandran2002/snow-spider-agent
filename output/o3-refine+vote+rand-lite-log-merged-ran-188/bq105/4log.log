```sql
--Description:
-- Compute, for each U.S. state, the 2015- and 2016-rate (per-100 000 residents)
-- of traffic crashes in which at least one driver was distracted.  A crash is
-- **excluded** when the distraction label is “Not Distracted”, “Unknown if
-- Distracted”, or “Not Reported”.  Population comes from the 2010 Census ZIP-
-- code file (ZIPs are grouped by their first two digits, which correspond to
-- the NHTSA two-digit state codes).  Finally, return only the five states with
-- the highest rate for each year.
WITH
/* --------------------------------------------------------------
   1.  State-name lookup — union 2015 & 2016 impairment tables so
       we have (state_number, state_name) for every code.
---------------------------------------------------------------- */
state_lu AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
  UNION DISTINCT
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
),
/* --------------------------------------------------------------
   2.  Count 2015 crashes that involve distraction.
---------------------------------------------------------------- */
crash15 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes_2015
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted', 'unknown if distracted', 'not reported')
  GROUP BY state_number
),
/* --------------------------------------------------------------
   3.  Count 2016 crashes that involve distraction.
---------------------------------------------------------------- */
crash16 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes_2016
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted', 'unknown if distracted', 'not reported')
  GROUP BY state_number
),
/* --------------------------------------------------------------
   4.  2010 population aggregated by two-digit ZIP (≈ state_number).
---------------------------------------------------------------- */
pop10 AS (
  SELECT
    CAST(SUBSTR(LPAD(zipcode,5,'0'),1,2) AS INT64) AS state_number,
    SUM(population) AS population_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  GROUP BY state_number
),
/* --------------------------------------------------------------
   5.  Merge counts & population, compute per-100 000 rates.
---------------------------------------------------------------- */
rates AS (
  SELECT
    lu.state_name,
    p.population_2010,
    c15.crashes_2015,
    c16.crashes_2016,
    ROUND(1e5 * c15.crashes_2015 / p.population_2010 , 2) AS rate_2015,
    ROUND(1e5 * c16.crashes_2016 / p.population_2010 , 2) AS rate_2016
  FROM pop10               AS p
  JOIN state_lu            AS lu  USING (state_number)
  LEFT JOIN crash15        AS c15 USING (state_number)
  LEFT JOIN crash16        AS c16 USING (state_number)
),
/* --------------------------------------------------------------
   6.  Produce one row per (year, state) and rank within each year.
---------------------------------------------------------------- */
ranked AS (
  SELECT 2015 AS yr, state_name, rate_2015 AS rate,
         ROW_NUMBER() OVER (ORDER BY rate_2015 DESC) AS rnk
  FROM rates
  UNION ALL
  SELECT 2016 AS yr, state_name, rate_2016 AS rate,
         ROW_NUMBER() OVER (ORDER BY rate_2016 DESC) AS rnk
  FROM rates
)
/* --------------------------------------------------------------
   7.  Return the top-5 states for each year.
---------------------------------------------------------------- */
SELECT yr AS year,
       state_name,
       rate AS accidents_per_100k
FROM ranked
WHERE rnk <= 5
ORDER BY year, accidents_per_100k DESC;
```
