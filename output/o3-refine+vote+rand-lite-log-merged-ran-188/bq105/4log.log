```sql
--Description:
-- The 2015 distraction table (`distract_2015`) only stores `state_number`,
-- so querying `state_name` directly fails.  To obtain readable state names
-- we join to `drimpair_2015`, which contains both `state_number` and
-- `state_name`.
-- Steps:
--   1. Build a DISTINCT lookup of (state_number, state_name) from
--      `drimpair_2015`.
--   2. Join that lookup (`lu`) to `distract_2015` on state_number.
--   3. Filter out rows whose `driver_distracted_by_name` is
--      'Not Distracted', 'Unknown if Distracted', or 'Not Reported'
--      (case-insensitive).
--   4. Count DISTINCT `consecutive_number` (each represents one unique crash)
--      per state.
--   5. List the top 20 states by that crash count.
SELECT
  lu.state_name,
  COUNT(DISTINCT d.consecutive_number) AS crashes_2015
FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015` AS d
JOIN (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
) AS lu
ON lu.state_number = d.state_number
WHERE LOWER(d.driver_distracted_by_name) NOT IN
      ('not distracted', 'unknown if distracted', 'not reported')
GROUP BY lu.state_name
ORDER BY crashes_2015 DESC
LIMIT 20;
