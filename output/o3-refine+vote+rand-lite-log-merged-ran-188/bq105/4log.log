2025-05-05 03:23:15 - Thread-1829 (execute) - INFO - [Try to run SQL in self-refine]
```sql
/*  Traffic crashes attributed to driver distraction in 2015 & 2016
    (per-100,000 residents, population = 2010 Census)                 */

WITH
/* ────────────────────────────────────────────────────────────────────
   1. 2010 Census population rolled-up to state using ZIP–to–state map
   ──────────────────────────────────────────────────────────────────── */
state_pop AS (
  SELECT
    CAST(za.state_fips AS INT64)           AS state_number,
    SUM(zpop.population)                   AS population_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010` zpop
  JOIN `bigquery-public-data.utility_us.zipcode_area`                 za
    ON zpop.zipcode = za.zipcode
  GROUP BY state_number
),

/* ────────────────────────────────────────────────────────────────────
   2. 2015 & 2016 crashes that involved at least one distracted driver
      (exclude “Not Distracted”, “Unknown if Distracted”, “Not Reported”)
   ──────────────────────────────────────────────────────────────────── */
distracted_2015 AS (
  SELECT DISTINCT state_number, consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted','unknown if distracted','not reported')
),
distracted_2016 AS (
  SELECT DISTINCT state_number, consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted','unknown if distracted','not reported')
),

/* ────────────────────────────────────────────────────────────────────
   3. Count distracted crashes per state & year
   ──────────────────────────────────────────────────────────────────── */
crash_counts AS (
  SELECT state_number, 2015 AS year, COUNT(*) AS distracted_crashes
  FROM distracted_2015
  GROUP BY state_number
  UNION ALL
  SELECT state_number, 2016 AS year, COUNT(*) AS distracted_crashes
  FROM distracted_2016
  GROUP BY state_number
),

/* ────────────────────────────────────────────────────────────────────
   4.  Rates per-100 000 population
   ──────────────────────────────────────────────────────────────────── */
rates AS (
  SELECT
    c.year,
    c.state_number,
    c.distracted_crashes,
    p.population_2010,
    (c.distracted_crashes / p.population_2010) * 100000 AS crashes_per_100k
  FROM crash_counts c
  JOIN state_pop        p USING (state_number)
),

/* ────────────────────────────────────────────────────────────────────
   5. Rank states within each year
   ──────────────────────────────────────────────────────────────────── */
ranked AS (
  SELECT
    r.*,
    ROW_NUMBER() OVER (PARTITION BY year ORDER BY crashes_per_100k DESC) AS rank
  FROM rates r
)

/* ────────────────────────────────────────────────────────────────────
   6. Top-5 states each year
   ──────────────────────────────────────────────────────────────────── */
SELECT
  year,
  rank,
  sn.state_name,
  ROUND(crashes_per_100k,4) AS crashes_per_100k
FROM ranked
LEFT JOIN (
    SELECT DISTINCT state_number, state_name
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
) sn USING (state_number)
WHERE rank <= 5
ORDER BY year, rank;
```
