```sql
--Description:
-- Goal: obtain 2016 counts of UNIQUE crashes that involved a distracted driver,
--       grouped by readable state name.
--
-- Data issues & solution
--   • Table `distract_2016` contains only the numeric `state_number`; it does
--     NOT include `state_name`.
--   • Table `drimpair_2016` does contain both `state_number` and `state_name`,
--     so we use it as a lookup (CTE `state_lookup`) to translate the codes.
--
-- Counting logic
--   • One crash = one distinct `consecutive_number`.
--   • We exclude all records whose `driver_distracted_by_name` is any of the
--     three “non-distracted” labels: 'Not Distracted', 'Unknown if Distracted',
--     or 'Not Reported'.  Use LOWER() for case-insensitive comparison.
--
-- Steps performed:
--   1. Build `state_lookup` via SELECT DISTINCT from `drimpair_2016`.
--   2. Join it to `distract_2016` on `state_number`.
--   3. Apply the filter on `driver_distracted_by_name`.
--   4. COUNT DISTINCT `consecutive_number` per state.
--   5. Show the 20 states with the highest counts.
WITH state_lookup AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
)
SELECT
  sl.state_name,
  COUNT(DISTINCT d.consecutive_number) AS distracted_crashes_2016
FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` AS d
JOIN state_lookup AS sl
  ON sl.state_number = d.state_number
WHERE LOWER(d.driver_distracted_by_name) NOT IN
      ('not distracted', 'unknown if distracted', 'not reported')
GROUP BY sl.state_name
ORDER BY distracted_crashes_2016 DESC
LIMIT 20;
```
