```sql
--Description:
-- Purpose  :  For every U.S. State, compute the number of traffic crashes
--             in which driver distraction was recorded in 2015 and 2016
--             (excluding “Not Distracted”, “Unknown if Distracted”,
--             or “Not Reported”), convert each raw count to a rate per
--             100 000 residents using the 2010 Census ZIP-code population
--             data, and finally list the 5 states with the highest rate
--             in each year.
--
-- Method
--   1)  Build a STATE lookup (state_number ↔ state_name) from
--       `drimpair_2015`, the only 2015 table that carries both columns.
--   2)  Count unique crashes (DISTINCT consecutive_number) that involve
--       driver distraction in 2015 and 2016, using the two `distract_*`
--       tables and filtering out the three “non-distracted” labels.
--   3)  Approximate state population with the 2010 ZIP-code file:
--          • Pad every ZIP to 5 chars, take its first 2 digits,
--          • Treat that 2-digit prefix as the numeric `state_number`
--            employed by NHTSA (e.g. 06 → California, 12 → Florida).
--   4)  Merge population, 2015 counts, and 2016 counts.
--   5)  Convert to rates per 100 000 people, round to 2 decimals.
--   6)  Return the 5 highest-rate states for 2015 and for 2016.
WITH
/* ---------- 1.  State lookup from impairment 2015 -------------------- */
state_lu AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
),
/* ---------- 2.  2015 & 2016 distracted-crash counts ------------------ */
distract_2015 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes_2015
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted', 'unknown if distracted', 'not reported')
  GROUP BY state_number
),
distract_2016 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes_2016
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted', 'unknown if distracted', 'not reported')
  GROUP BY state_number
),
/* ---------- 3.  2010 population aggregated to state_number ----------- */
state_pop AS (
  SELECT
    CAST(SUBSTR(LPAD(zipcode,5,'0'),1,2) AS INT64) AS state_number,
    SUM(population)                         AS pop_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  GROUP BY state_number
),
/* ---------- 4.  Combine all elements & compute rates ----------------- */
rates AS (
  SELECT
    s.state_name,
    p.pop_2010,
    d15.crashes_2015,
    d16.crashes_2016,
    ROUND(1e5 * d15.crashes_2015 / p.pop_2010 , 2) AS rate_2015,
    ROUND(1e5 * d16.crashes_2016 / p.pop_2010 , 2) AS rate_2016
  FROM state_lu       AS s
  JOIN state_pop      AS p   USING (state_number)
  LEFT JOIN distract_2015 AS d15 USING (state_number)
  LEFT JOIN distract_2016 AS d16 USING (state_number)
)
/* ---------- 5.  Top-5 states by year --------------------------------- */
SELECT *
FROM (
  SELECT state_name,
         rate_2015 AS rate_per_100k,
         2015      AS year
  FROM   rates
  ORDER  BY rate_2015 DESC
  LIMIT 5
  UNION ALL
  SELECT state_name,
         rate_2016 AS rate_per_100k,
         2016      AS year
  FROM   rates
  ORDER  BY rate_2016 DESC
  LIMIT 5
)
ORDER BY year, rate_per_100k DESC;
```
