)

/* -------------------------------------------------------------- */
/* 7. Return top-5 states for 2015 and 2016                       */
/* -------------------------------------------------------------- */
SELECT
  year,
  rank_state AS rank,
  state_name,
  ROUND(crashes_per_100k, 4) AS crashes_per_100k
FROM ranked
WHERE rank_state <= 5
ORDER BY year, rank_state;
