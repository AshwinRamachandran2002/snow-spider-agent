```sql
--Description: 10) Bring everything together – estimate 2015 & 2016 crashes
--   per-100,000 population for each state (using the 2-digit ZIP proxy),  
--   then list the five states with the highest rates in each year.  
WITH
-- 1.  State ↔ name lookup taken from the 2015 distraction file.
name_lu AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
),
-- 2.  2015 distracted-driver crashes by state.
d15 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes_2015
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted','unknown if distracted','not reported')
  GROUP BY state_number
),
-- 3.  2016 distracted-driver crashes by state.
d16 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes_2016
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted','unknown if distracted','not reported')
  GROUP BY state_number
),
-- 4.  2010 Census population summed by 2-digit ZIP prefix; the prefix is
--     treated here as the numeric state code used in the crash files.
state_pop AS (
  SELECT
    CAST(SUBSTR(LPAD(zipcode,5,'0'),1,2) AS INT64) AS state_number,
    SUM(population)                             AS population_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  GROUP BY state_number
),
-- 5.  Combine crashes & population, compute per-100k rates.
all_rates AS (
  SELECT
    n.state_name,
    p.population_2010,
    d15.crashes_2015,
    ROUND(1e5 * d15.crashes_2015 / p.population_2010 , 2) AS rate_2015,
    d16.crashes_2016,
    ROUND(1e5 * d16.crashes_2016 / p.population_2010 , 2) AS rate_2016
  FROM state_pop      AS p
  LEFT JOIN name_lu   AS n  USING(state_number)
  LEFT JOIN d15       USING(state_number)
  LEFT JOIN d16       USING(state_number)
)
-- 6.  Pick top-5 by year.
SELECT *
FROM (
  SELECT state_name, rate_2015 AS rate, 2015 AS yr
  FROM   all_rates
  ORDER  BY rate_2015 DESC
  LIMIT 5
  UNION ALL
  SELECT state_name, rate_2016 AS rate, 2016 AS yr
  FROM   all_rates
  ORDER  BY rate_2016 DESC
  LIMIT 5
)
ORDER BY yr, rate DESC
LIMIT 20;
```
