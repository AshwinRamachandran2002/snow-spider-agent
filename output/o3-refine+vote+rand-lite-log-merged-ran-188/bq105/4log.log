```sql
--Description:
-- Need: 2016 count of crashes with a distracted driver, by readable state name.
--
-- 1.  Crash data → `distract_2016`
--     • Contains `state_number`, `consecutive_number`, `driver_distracted_by_name`.
--     • Lacks `state_name`.
--
-- 2.  State-code → state-name lookup
--     • Both impairment tables (`drimpair_2015`, `drimpair_2016`) hold the
--       mapping (`state_number`, `state_name`).  UNION them for completeness.
--
-- 3.  Filter out the three “non-distracted” labels
--       – 'Not Distracted'
--       – 'Unknown if Distracted'
--       – 'Not Reported'
--     Comparison done in LOWER() to avoid case mismatch.
--
-- 4.  A crash = one unique `consecutive_number`.
--     COUNT DISTINCT to avoid double-counting when a crash has multiple drivers.
--
-- 5.  Return top-20 states by that count.
WITH state_lookup AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
  UNION DISTINCT
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
)
SELECT
  sl.state_name,
  COUNT(DISTINCT d.consecutive_number) AS distracted_crashes_2016
FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` AS d
JOIN state_lookup AS sl
  ON sl.state_number = d.state_number
WHERE LOWER(d.driver_distracted_by_name) NOT IN
      ('not distracted', 'unknown if distracted', 'not reported')
GROUP BY sl.state_name
ORDER BY distracted_crashes_2016 DESC
LIMIT 20;
