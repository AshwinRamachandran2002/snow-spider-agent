/*  Driver-distraction crashes per 100,000 residents in 2015 & 2016
    – top-5 states each year, population from 2010 Census          */

WITH
/* -------------------------------------------------------------- */
/* 1. Map state FIPS codes (state_number) to state names           */
/* -------------------------------------------------------------- */
state_map AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
),

/* -------------------------------------------------------------- */
/* 2. 2010 state populations                                      */
/* -------------------------------------------------------------- */
state_pop AS (
  SELECT
    sm.state_number,
    sm.state_name,
    p.population AS population_2010
  FROM state_map sm
  JOIN `bigquery-public-data.census_bureau_usa.population_by_state_2010` p
        ON LOWER(sm.state_name) = LOWER(p.state_name)
),

/* -------------------------------------------------------------- */
/* 3. Crashes that involved at least one distracted driver        */
/*    (exclude “Not/Unknown/Not Reported”)                        */
/* -------------------------------------------------------------- */
distracted_2015 AS (
  SELECT DISTINCT state_number, consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted', 'unknown if distracted', 'not reported')
),
distracted_2016 AS (
  SELECT DISTINCT state_number, consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE LOWER(driver_distracted_by_name) NOT IN
        ('not distracted', 'unknown if distracted', 'not reported')
),

/* -------------------------------------------------------------- */
/* 4. Count of distraction-related crashes per state & year        */
/* -------------------------------------------------------------- */
crash_counts AS (
  SELECT state_number, 2015 AS year, COUNT(*) AS distracted_crashes
  FROM distracted_2015
  GROUP BY state_number
  UNION ALL
  SELECT state_number, 2016 AS year, COUNT(*) AS distracted_crashes
  FROM distracted_2016
  GROUP BY state_number
),

/* -------------------------------------------------------------- */
/* 5. Crashes per 100,000 residents                               */
/* -------------------------------------------------------------- */
rates AS (
  SELECT
    cc.year,
    cc.state_number,
    sp.state_name,
    cc.distracted_crashes,
    sp.population_2010,
    (cc.distracted_crashes / sp.population_2010) * 100000 AS crashes_per_100k
  FROM crash_counts cc
  JOIN state_pop sp USING (state_number)
),

/* -------------------------------------------------------------- */
/* 6. Rank states within each year                                */
/* -------------------------------------------------------------- */
ranked AS (
