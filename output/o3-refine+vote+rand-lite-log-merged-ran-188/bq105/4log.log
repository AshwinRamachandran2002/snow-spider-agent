```sql
--Description:
-- We want to know, for calendar-year 2015, how many crashes in every state
-- involved a distracted driver AFTER removing the three “non-distracted”
-- categories (“Not Distracted”, “Unknown if Distracted”, “Not Reported”).
--
-- Technical points
--   • Table `distract_2015` supplies the crash rows but holds only
--     `state_number` (no readable name).
--   • Table `drimpair_2015` contains both `state_number` and `state_name`,
--     so it is used as a lookup to translate the numeric code.
--   • A unique crash is represented by one distinct `consecutive_number`.
--
-- Result: for each state_name we output the count of DISTINCT crashes
-- that satisfy the distraction filter, ordered from highest to lowest.
SELECT
  lu.state_name,
  COUNT(DISTINCT d.consecutive_number) AS crashes_2015
FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015` AS d
JOIN (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
) AS lu
ON lu.state_number = d.state_number
WHERE LOWER(d.driver_distracted_by_name) NOT IN
      ('not distracted',
       'unknown if distracted',
       'not reported')
GROUP BY lu.state_name
ORDER BY crashes_2015 DESC
LIMIT 20;
```
