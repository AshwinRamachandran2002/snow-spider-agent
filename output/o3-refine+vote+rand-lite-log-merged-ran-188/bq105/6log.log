```sql
WITH state_population AS (
  -- 2010 Census population summed to the state level
  SELECT
    CAST(SUBSTR(LPAD(zipcode,5,'0'),1,2) AS INT64) AS state_number,
    SUM(population) AS population
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  GROUP BY state_number
),
state_lookup AS (
  -- Get a single state-name look-up table (from any file that carries the names)
  SELECT DISTINCT state_number, state_name
  FROM (
    SELECT state_number, state_name
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
    UNION ALL
    SELECT state_number, state_name
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
  )
),
accidents AS (
  -- All crashes that involved at least one distracted driver
  SELECT 2015 AS year, state_number, consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE driver_distracted_by_name NOT IN ('Not Distracted','Unknown if Distracted','Not Reported')
  
  UNION ALL
  
  SELECT 2016 AS year, state_number, consecutive_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE driver_distracted_by_name NOT IN ('Not Distracted','Unknown if Distracted','Not Reported')
),
accidents_distinct AS (
  -- Count DISTINCT crashes (case numbers) per state/year
  SELECT
    year,
    state_number,
    COUNT(DISTINCT consecutive_number) AS accidents
  FROM accidents
  GROUP BY year, state_number
),
rates AS (
  -- Merge with population to make “accidents per 100k people”
  SELECT
    ad.year,
    ad.state_number,
    COALESCE(sl.state_name, CONCAT('State_',CAST(ad.state_number AS STRING))) AS state_name,
    ad.accidents,
    sp.population,
    ROUND(ad.accidents / sp.population * 100000, 4) AS accidents_per_100k
  FROM accidents_distinct ad
  JOIN state_population sp USING (state_number)
  LEFT JOIN state_lookup  sl USING (state_number)
),
ranked AS (
  -- Rank by rate within each year
  SELECT
    r.*,
    DENSE_RANK() OVER (PARTITION BY year ORDER BY accidents_per_100k DESC) AS rank_in_year
  FROM rates r
)
-- Return the five states with the highest rates in each year
SELECT
  year,
  state_name,
  accidents_per_100k,
  accidents,
  population,
  rank_in_year
FROM ranked
WHERE rank_in_year <= 5
ORDER BY year, rank_in_year;
```
