```sql
--Description / Thinking Process:
-- Goal:  For 2015 and 2016, find (a) the number of crashes attributed to driver
--        distraction in each state (excluding “Not Distracted”, “Unknown if
--        Distracted”, and “Not Reported”), (b) the 2010 Census population of
--        each state, then (c) calculate crashes per 100 k residents, and finally
--        list the five states with the highest rate in each year.
--
-- Key steps:
-- 1.  STATE LOOK-UP ─ Build a table of `state_number` ↔ `state_name` from the
--    impairment files (they contain names for both 2015 and 2016).
-- 2.  POPULATION ─ Aggregate 2010 ZIP-level population to state level by taking
--    the first two digits of each 5-digit ZIP (treated as the Census “state
--    number” code).  Join to the state look-up so we get an official name.
-- 3.  CRASH COUNTS ─ For each year, count DISTINCT `consecutive_number` values
--    in the corresponding distraction table after filtering out the three
--    unwanted distraction codes.
-- 4.  RATES ─ Combine (2) and (3), compute crashes per 100 000 people.
-- 5.  RANK & FILTER ─ Rank states within each year by the rate and keep the
--    top-five.
WITH
-- 1 ─ state-number ↔ state-name reference
state_names AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
  UNION DISTINCT
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
),
-- 2 ─ 2010 population rolled up to state_number
pop_2010 AS (
  SELECT
    CAST(SUBSTR(LPAD(zipcode,5,'0'),1,2) AS INT64) AS state_number,
    SUM(population)                         AS population_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  GROUP BY state_number
),
-- 3a ─ 2015 distraction-crash counts
crash15 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes_2015
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(driver_distracted_by_name) NOT IN ('not distracted',
                                                 'unknown if distracted',
                                                 'not reported')
  GROUP BY state_number
),
-- 3b ─ 2016 distraction-crash counts
crash16 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes_2016
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE LOWER(driver_distracted_by_name) NOT IN ('not distracted',
                                                 'unknown if distracted',
                                                 'not reported')
  GROUP BY state_number
),
-- 4a ─ 2015 rates
rates_2015 AS (
  SELECT
    s.state_name,
    c15.crashes_2015,
    p.population_2010,
    ROUND(c15.crashes_2015 * 100000.0 / p.population_2010, 2) AS rate_per_100k,
    2015 AS yr
  FROM crash15            AS c15
  JOIN pop_2010           AS p   USING (state_number)
  JOIN state_names        AS s   USING (state_number)
),
-- 4b ─ 2016 rates
rates_2016 AS (
  SELECT
    s.state_name,
    c16.crashes_2016,
    p.population_2010,
    ROUND(c16.crashes_2016 * 100000.0 / p.population_2010, 2) AS rate_per_100k,
    2016 AS yr
  FROM crash16            AS c16
  JOIN pop_2010           AS p   USING (state_number)
  JOIN state_names        AS s   USING (state_number)
),
-- 5 ─ rank within each year and keep top-five
ranked AS (
  SELECT
    yr,
    state_name,
    rate_per_100k,
    ROW_NUMBER() OVER (PARTITION BY yr ORDER BY rate_per_100k DESC) AS rn
  FROM (
    SELECT * FROM rates_2015
    UNION ALL
    SELECT * FROM rates_2016
  )
)
SELECT
  yr AS year,
  state_name,
  rate_per_100k AS crashes_per_100k_population
FROM ranked
WHERE rn <= 5
ORDER BY yr, rate_per_100k DESC;
```
