```sql
--Description:  In a single statement, calculate the number of 2015 and 2016
--              crashes per 100 000 residents that were caused by driver
--              distraction (excluding “Not Distracted”, “Unknown if Distracted”,
--              and “Not Reported”) for every U.S. state, then list the five
--              highest-rate states for each year.
--              Steps performed inside CTEs:
--              1)  state_map  – distinct (state_number, state_name) from the
--                 2015 & 2016 impairment tables (they carry the names).
--              2)  pop_2010   – 2010 census population rolled up to state_number
--                 using the first two digits of each ZIP code.
--              3)  crash_2015 – distraction-crash counts (distinct case numbers)
--                 for 2015 after filtering unwanted labels.
--              4)  crash_2016 – same for 2016.
--              5)  rates_yr   – combine crash counts with population to produce
--                 rates (crashes per 100 k people) for each year.
--              6)  ranked     – rank states within each year by rate and keep
--                 the top five.
WITH
state_map AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
  UNION DISTINCT
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
),
pop_2010 AS (
  SELECT
    CAST(SUBSTR(LPAD(zipcode,5,'0'),1,2) AS INT64) AS state_number,
    SUM(population) AS population_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  GROUP BY state_number
),
crash_2015 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes_2015
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(driver_distracted_by_name) NOT IN ('not distracted',
                                                 'unknown if distracted',
                                                 'not reported')
  GROUP BY state_number
),
crash_2016 AS (
  SELECT
    state_number,
    COUNT(DISTINCT consecutive_number) AS crashes_2016
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE LOWER(driver_distracted_by_name) NOT IN ('not distracted',
                                                 'unknown if distracted',
                                                 'not reported')
  GROUP BY state_number
),
rates_yr AS (
  SELECT
    s.state_name,
    2015 AS yr,
    c15.crashes_2015 AS crashes,
    p.population_2010,
    ROUND(c15.crashes_2015 * 100000.0 / p.population_2010, 2) AS rate_per_100k
  FROM crash_2015 c15
  JOIN pop_2010  p USING (state_number)
  JOIN state_map s USING (state_number)
  UNION ALL
  SELECT
    s.state_name,
    2016 AS yr,
    c16.crashes_2016 AS crashes,
    p.population_2010,
    ROUND(c16.crashes_2016 * 100000.0 / p.population_2010, 2) AS rate_per_100k
  FROM crash_2016 c16
  JOIN pop_2010  p USING (state_number)
  JOIN state_map s USING (state_number)
),
ranked AS (
  SELECT
    yr,
    state_name,
    rate_per_100k,
    ROW_NUMBER() OVER (PARTITION BY yr ORDER BY rate_per_100k DESC) AS rn
  FROM rates_yr
)
SELECT
  yr AS year,
  state_name,
  rate_per_100k AS crashes_per_100k_population
FROM ranked
WHERE rn <= 5
ORDER BY year, rate_per_100k DESC;
```
