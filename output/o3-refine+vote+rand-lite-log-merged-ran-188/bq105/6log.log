```

```sql
-- 2. See the first-two–digit ZIP “prefix” that we will later treat as a state-number proxy
SELECT DISTINCT
       LPAD(`zipcode`,5,'0')       AS padded_zip,
       CAST(SUBSTR(LPAD(`zipcode`,5,'0'),1,2) AS INT64) AS state_number_prefix
FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
LIMIT 20;
```

```sql
-- 3. All distraction status labels that appear in the 2015 file
SELECT DISTINCT `driver_distracted_by_name`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
LIMIT 20;
```

```sql
-- 4. All distraction status labels that appear in the 2016 file
SELECT DISTINCT `driver_distracted_by_name`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
LIMIT 20;
```

```sql
-- 5. 2015 ‑ Count of distraction–related crashes by state (filtered so that
--    “Not Distracted”, “Unknown if Distracted”, and “Not Reported” are excluded)
SELECT
  `state_name`,
  COUNT(DISTINCT `consecutive_number`) AS crash_cnt_2015
FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
WHERE LOWER(`driver_distracted_by_name`) NOT IN ('not distracted','unknown if distracted','not reported')
GROUP BY `state_name`
ORDER BY crash_cnt_2015 DESC
LIMIT 20;
```

```sql
-- 6. 2016 ‑ Join the 2016 distraction table with the 2016 impairment table
--    (the latter carries the state names) and count crashes per state
SELECT
  di6.`state_name`,
  COUNT(DISTINCT di6.`consecutive_number`) AS crash_cnt_2016
FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` AS d6
JOIN (
      SELECT DISTINCT `state_number`, `state_name`
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
     ) AS di6
ON d6.`state_number` = di6.`state_number`
WHERE LOWER(d6.`driver_distracted_by_name`) NOT IN ('not distracted','unknown if distracted','not reported')
GROUP BY di6.`state_name`
ORDER BY crash_cnt_2016 DESC
LIMIT 20;
```

```sql
-- 7. Aggregate 2010 population to a “state_number” constructed from the ZIP prefix,
--    then pull an official state name from the 2015 impairment table
WITH pop AS (
  SELECT
    CAST(SUBSTR(LPAD(`zipcode`,5,'0'),1,2) AS INT64) AS state_number,
    SUM(`population`)                       AS pop_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  GROUP BY state_number
)
SELECT
  imp15.`state_name`,
  pop.`state_number`,
  pop.`pop_2010`
FROM pop
LEFT JOIN (
           SELECT DISTINCT `state_number`, `state_name`
           FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
          ) AS imp15
ON pop.`state_number` = imp15.`state_number`
ORDER BY pop_2010 DESC
LIMIT 20;
```

```sql
-- 8. 2015 ‑ Distraction-caused crashes per 100,000 residents
WITH crash AS (
  SELECT
    `state_name`,
    COUNT(DISTINCT `consecutive_number`) AS crashes_2015
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(`driver_distracted_by_name`) NOT IN ('not distracted','unknown if distracted','not reported')
  GROUP BY `state_name`
),
pop AS (
  SELECT
    imp15.`state_name`,
    SUM(p.`population`) AS pop_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010` AS p
  JOIN (
        SELECT DISTINCT `state_number`, `state_name`
        FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
       ) AS imp15
  ON CAST(SUBSTR(LPAD(p.`zipcode`,5,'0'),1,2) AS INT64) = imp15.`state_number`
  GROUP BY imp15.`state_name`
)
SELECT
  crash.`state_name`,
  crashes_2015,
  pop_2010,
  ROUND(crashes_2015 * 100000.0 / pop_2010, 2) AS crashes_per_100k_2015
FROM crash
JOIN pop USING (`state_name`)
ORDER BY crashes_per_100k_2015 DESC
LIMIT 20;
```

```sql
-- 9. 2016 ‑ Distraction-caused crashes per 100,000 residents
WITH crash AS (
  SELECT
    s.`state_name`,
    COUNT(DISTINCT d6.`consecutive_number`) AS crashes_2016
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` AS d6
  JOIN (
        SELECT DISTINCT `state_number`, `state_name`
        FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
       ) AS s
  ON d6.`state_number` = s.`state_number`
  WHERE LOWER(d6.`driver_distracted_by_name`) NOT IN ('not distracted','unknown if distracted','not reported')
  GROUP BY s.`state_name`
),
pop AS (
  SELECT
    s.`state_name`,
    SUM(p.`population`) AS pop_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010` AS p
  JOIN (
        SELECT DISTINCT `state_number`, `state_name`
        FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
       ) AS s
  ON CAST(SUBSTR(LPAD(p.`zipcode`,5,'0'),1,2) AS INT64) = s.`state_number`
  GROUP BY s.`state_name`
)
SELECT
  crash.`state_name`,
  crashes_2016,
  pop_2010,
  ROUND(crashes_2016 * 100000.0 / pop_2010, 2) AS crashes_per_100k_2016
FROM crash
JOIN pop USING (`state_name`)
ORDER BY crashes_per_100k_2016 DESC
LIMIT 20;
```

```sql
-- 10. Combine the two years and list the TOP-5 states for each
WITH rates_2015 AS (
  -- results from Query 8
  SELECT `state_name`, crashes_per_100k_2015 AS rate, 2015 AS yr
  FROM (
    /* paste Query 8 minus LIMIT here */
  )
),
rates_2016 AS (
  -- results from Query 9
  SELECT `state_name`, crashes_per_100k_2016 AS rate, 2016 AS yr
  FROM (
    /* paste Query 9 minus LIMIT here */
  )
)
SELECT *
FROM (
  SELECT *, ROW_NUMBER() OVER(PARTITION BY yr ORDER BY rate DESC) AS rn
  FROM (SELECT * FROM rates_2015 UNION ALL SELECT * FROM rates_2016)
)
WHERE rn <= 5
ORDER BY yr, rate DESC
LIMIT 20;
```
