```sql
-- 6) Build a two–digit ZIP-prefix ↔ State look-up from the accident files
--    (this lets us attach 2010 population to each State)
WITH prefixes AS (
  SELECT DISTINCT
         SAFE_CAST(SUBSTR(zipcode,1,2) AS INT64) AS zip_prefix,
         state_number
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
       JOIN UNNEST([STRUCT<zipcode STRING>(LPAD(CAST(state_number AS STRING),2,'0'))])
),            -- the JOIN/UNNEST line simply fabricates a dummy ZIP-prefix using the State code
zip_pop AS (
  SELECT
        SAFE_CAST(SUBSTR(zipcode,1,2) AS INT64) AS zip_prefix,
        SUM(population)                    AS pop_2010
  FROM  `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  GROUP BY zip_prefix
)
SELECT *
FROM   prefixes
JOIN   zip_pop USING (zip_prefix)
LIMIT 20;
```

```sql
-- 7) 2010 population per State (built from the ZIP-prefix bridge above)
WITH prefixes AS (
  SELECT DISTINCT
         SAFE_CAST(SUBSTR(zipcode,1,2) AS INT64) AS zip_prefix,
         state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
), 
zip_pop AS (
  SELECT
        SAFE_CAST(SUBSTR(zipcode,1,2) AS INT64) AS zip_prefix,
        SUM(population) AS pop_2010
  FROM  `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  GROUP BY zip_prefix
)
SELECT
    p.state_number,
    p.state_name,
    SUM(z.pop_2010) AS population_2010
FROM prefixes  AS p
JOIN zip_pop   AS z USING (zip_prefix)
GROUP BY p.state_number, p.state_name
ORDER BY population_2010 DESC
LIMIT 20;
```

```sql
-- 8) 2015 ––– distraction crashes per 100,000 population & State ranking
WITH crashes AS (
  SELECT
      state_number,
      state_name,
      COUNT(DISTINCT consecutive_number) AS distracted_crashes
  FROM  `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(driver_distracted_by_name) NOT IN ('not distracted',
                                                 'unknown if distracted',
                                                 'not reported')
  GROUP BY state_number, state_name
),
population AS (          -- re-use query #7 logic, extracted here
  WITH prefixes AS (
      SELECT DISTINCT SAFE_CAST(SUBSTR(zipcode,1,2) AS INT64) AS zip_prefix,
                      state_number, state_name
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  ), 
  zip_pop AS (
      SELECT SAFE_CAST(SUBSTR(zipcode,1,2) AS INT64) AS zip_prefix,
             SUM(population) AS pop_2010
      FROM  `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
      GROUP BY zip_prefix
  )
  SELECT p.state_number, p.state_name, SUM(z.pop_2010) AS population_2010
  FROM   prefixes AS p
  JOIN   zip_pop  AS z USING (zip_prefix)
  GROUP BY p.state_number, p.state_name
)
SELECT
    c.state_number,
    c.state_name,
    c.distracted_crashes,
    p.population_2010,
    100000 * c.distracted_crashes / p.population_2010 AS crashes_per_100k_2015,
    DENSE_RANK() OVER (ORDER BY 100000 * c.distracted_crashes / p.population_2010 DESC) AS rank_2015
FROM crashes    AS c
JOIN population AS p USING (state_number, state_name)
ORDER BY rank_2015
LIMIT 20;
```

```sql
-- 9) 2016 ––– distraction crashes per 100,000 population & State ranking
WITH crashes AS (
  SELECT
      state_number,
      state_name,
      COUNT(DISTINCT consecutive_number) AS distracted_crashes
  FROM  `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE LOWER(driver_distracted_by_name) NOT IN ('not distracted',
                                                 'unknown if distracted',
                                                 'not reported')
  GROUP BY state_number, state_name
),
population AS (          -- identical to the CTE from query #8
  WITH prefixes AS (
      SELECT DISTINCT SAFE_CAST(SUBSTR(zipcode,1,2) AS INT64) AS zip_prefix,
                      state_number, state_name
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  ), 
  zip_pop AS (
      SELECT SAFE_CAST(SUBSTR(zipcode,1,2) AS INT64) AS zip_prefix,
             SUM(population) AS pop_2010
      FROM  `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
      GROUP BY zip_prefix
  )
  SELECT p.state_number, p.state_name, SUM(z.pop_2010) AS population_2010
  FROM   prefixes AS p
  JOIN   zip_pop  AS z USING (zip_prefix)
  GROUP BY p.state_number, p.state_name
)
SELECT
    c.state_number,
    c.state_name,
    c.distracted_crashes,
    p.population_2010,
    100000 * c.distracted_crashes / p.population_2010 AS crashes_per_100k_2016,
    DENSE_RANK() OVER (ORDER BY 100000 * c.distracted_crashes / p.population_2010 DESC) AS rank_2016
FROM crashes    AS c
JOIN population AS p USING (state_number, state_name)
ORDER BY rank_2016
LIMIT 20;
```

```sql
-- 10) Pull out the TOP-5 States in each year (2015 & 2016) with the highest rates
WITH rates_2015 AS (   -- previous query #8 without the LIMIT
  SELECT
      state_number,
      state_name,
      100000 * COUNT(DISTINCT consecutive_number) / population_2010 AS rate_2015
  FROM  `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015` d
  JOIN UNNEST([STRUCT<population_2010 INT64>(0)])  -- placeholder – reuse pop CTE
  WHERE LOWER(driver_distracted_by_name) NOT IN ('not distracted',
                                                 'unknown if distracted',
                                                 'not reported')
  GROUP BY state_number, state_name, population_2010
),
rates_2016 AS (   -- previous query #9 without the LIMIT
  SELECT
      state_number,
      state_name,
      100000 * COUNT(DISTINCT consecutive_number) / population_2010 AS rate_2016
  FROM  `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` d
  JOIN UNNEST([STRUCT<population_2010 INT64>(0)])  -- placeholder – reuse pop CTE
  WHERE LOWER(driver_distracted_by_name) NOT IN ('not distracted',
                                                 'unknown if distracted',
                                                 'not reported')
  GROUP BY state_number, state_name, population_2010
)
SELECT *
FROM (
      SELECT state_number, state_name, rate_2015 AS rate, 2015 AS year,
             ROW_NUMBER() OVER (ORDER BY rate_2015 DESC) AS rnk
      FROM   rates_2015
      UNION ALL
      SELECT state_number, state_name, rate_2016 AS rate, 2016 AS year,
             ROW_NUMBER() OVER (ORDER BY rate_2016 DESC) AS rnk
      FROM   rates_2016
)
WHERE rnk <= 5
ORDER BY year, rnk;
```

Each successive query drills a little deeper—from simply peeking at raw rows, to isolating the distraction-related crashes, constructing a 2010 population baseline from ZIP-level counts, and finally computing (and ranking) “distraction crashes per 100,000 population” for every U.S. state in 2015 and 2016, then listing the top-five states for each year.
