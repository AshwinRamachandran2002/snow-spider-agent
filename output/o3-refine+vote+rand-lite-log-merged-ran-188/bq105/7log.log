--              ‘Not Reported’, then count DISTINCT crash case numbers 
--              (`consecutive_number`) for each state.  Return the 20 states with 
--              the highest counts of distraction-related fatal crashes in 2016.
WITH state_lookup AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
)
SELECT
  l.state_name,
  d.state_number,
  COUNT(DISTINCT d.consecutive_number) AS distracted_crashes_2016
FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016` AS d
JOIN state_lookup AS l
  ON d.state_number = l.state_number
WHERE LOWER(d.driver_distracted_by_name) NOT IN ('not distracted',
                                                 'unknown if distracted',
                                                 'not reported')
GROUP BY l.state_name, d.state_number
ORDER BY distracted_crashes_2016 DESC
LIMIT 20;
