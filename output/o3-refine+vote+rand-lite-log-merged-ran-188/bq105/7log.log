```sql
--Description:  The 2015 distraction table (“distract_2015”) lacks a state_name column, so
--              we first construct a (state_number, state_name) lookup from “drimpair_2015”.
--              After joining that lookup to the distraction data, we exclude the three
--              non-informative distraction categories (‘Not Distracted’, ‘Unknown if
--              Distracted’, ‘Not Reported’).  We then count DISTINCT fatal-crash case
--              numbers (consecutive_number) for each state and return the 20 states with
--              the highest counts of distraction-related crashes in 2015.
WITH state_lookup AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
)
SELECT
    l.state_name,
    d.state_number,
    COUNT(DISTINCT d.consecutive_number) AS distracted_crashes_2015
FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015` AS d
JOIN state_lookup AS l
  ON d.state_number = l.state_number
WHERE LOWER(d.driver_distracted_by_name) NOT IN ('not distracted',
                                                 'unknown if distracted',
                                                 'not reported')
GROUP BY l.state_name, d.state_number
ORDER BY distracted_crashes_2015 DESC
LIMIT 20;
