```sql
--Description:  One-stop query that
--  1) builds a 2010 population figure for every State by summing the Census ZIP-code
--     populations whose first two digits match the two-digit, zero-padded State-number
--     (e.g., State 1 → “01”, State 12 → “12”).  Although this is an approximation, it
--     provides a workable bridge from ZIP data to FARS State codes given the datasets
--     available in this project.
--  2) counts DISTINCT fatal-crash case numbers (consecutive_number) in which at least
--     one driver was distracted during 2015 and 2016, explicitly excluding the three
--     non-informative distraction categories (‘Not Distracted’, ‘Unknown if Distracted’,
--     ‘Not Reported’).
--  3) converts those counts to “crashes per 100 000 population” and ranks States for
--     each year, finally returning only the TOP-5 States per year with the highest rates.
WITH -------------------------------------------------------------------------------
-- A)  State-name lookup (comes from the impairment file, which includes the names)
state_names AS (
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2015`
  UNION DISTINCT
  SELECT DISTINCT state_number, state_name
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.drimpair_2016`
),
-- B)  2010 population per State:  zip -> two-digit prefix -> State
zip_population AS (
  SELECT
    LPAD(SAFE_CAST(SUBSTR(zipcode,1,2) AS STRING),2,'0') AS zip_prefix,
    SUM(population) AS pop_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  GROUP BY zip_prefix
),
state_population AS (
  SELECT
    s.state_number,
    n.state_name,
    COALESCE(SUM(z.pop_2010),0) AS population_2010
  FROM (
        SELECT DISTINCT state_number,
               LPAD(CAST(state_number AS STRING),2,'0') AS zip_prefix     -- bridge key
        FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
       ) AS s
  LEFT JOIN zip_population      AS z ON z.zip_prefix = s.zip_prefix
  LEFT JOIN state_names         AS n USING (state_number)
  GROUP BY s.state_number, n.state_name
),
-- C)  Distraction-crash counts per State for each year
distracted_crashes AS (
  SELECT
      2015 AS yr,
      state_number,
      COUNT(DISTINCT consecutive_number) AS crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(driver_distracted_by_name) NOT IN ('not distracted',
                                                 'unknown if distracted',
                                                 'not reported')
  GROUP BY state_number
  UNION ALL
  SELECT
      2016 AS yr,
      state_number,
      COUNT(DISTINCT consecutive_number) AS crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE LOWER(driver_distracted_by_name) NOT IN ('not distracted',
                                                 'unknown if distracted',
                                                 'not reported')
  GROUP BY state_number
),
-- D)  Combine population & crash counts → rate per 100 000; rank per year
rates AS (
  SELECT
      d.yr,
      d.state_number,
      p.state_name,
      d.crashes,
      p.population_2010,
      100000 * d.crashes / NULLIF(p.population_2010,0) AS crashes_per_100k,
      ROW_NUMBER() OVER (PARTITION BY d.yr
                         ORDER BY 100000 * d.crashes / NULLIF(p.population_2010,0) DESC) AS rnk
  FROM distracted_crashes AS d
  JOIN state_population   AS p USING (state_number)
)
-- E)  Output TOP-5 States for each year
SELECT
  yr        AS year,
  rnk       AS rank_in_year,
  state_name,
  state_number,
  crashes_per_100k,
  crashes   AS distraction_crashes,
  population_2010
FROM rates
WHERE rnk <= 5
ORDER BY yr, rnk;
```
