```sql
--Description / Thinking process:
-- Objective:  Compute, for each state in 2015, the rate of distracted-driver crashes
--             per 100,000 people, where “distracted” excludes the three “non-informative”
--             labels (“Not Distracted”, “Unknown if Distracted”, “Not Reported”).
--
-- Data issues / decisions:
--   • `distract_2015` contains `state_number` but NOT `state_name`, so we drop
--     the latter from our SELECT list.
--   • The 2010 population table lists ZIP-code populations only; a quick nationwide
--     total is therefore used (matching the intent of the earlier query), but
--     note this yields a NATIONAL denominator, not state-by-state population.
--     A true state-level denominator would require an additional mapping that
--     is not available in the permitted tables.
--
-- Steps:
--   1. pop CTE:   sum the 2010 ZIP-code populations to get the national total.
--   2. crashes CTE: count DISTINCT crashes per state_number after filtering out
--      the non-informative distraction labels.
--   3. Final SELECT: compute crash rate = crashes * 100,000 / national population.
--      (Retains state_number, crash count, and computed rate.)
WITH pop AS (
  SELECT SUM(`population`) AS us_pop_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
),
crashes AS (
  SELECT
    `state_number`,
    COUNT(DISTINCT `consecutive_number`) AS crashes_2015
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(`driver_distracted_by_name`) NOT IN ('not distracted',
                                                   'unknown if distracted',
                                                   'not reported')
  GROUP BY `state_number`
)
SELECT
  c.state_number,
  c.crashes_2015,
  ROUND(c.crashes_2015 * 100000.0 / p.us_pop_2010, 6) AS crashes_per_100k_2015
FROM crashes AS c
CROSS JOIN pop AS p
ORDER BY crashes_per_100k_2015 DESC
LIMIT 20;
```
