```sql
-- Description: Compute 2015 distracted-driver crash rate per 100,000 people for every state
WITH pop AS (
  SELECT SUM(`population`) AS us_pop_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
),
crashes AS (
  SELECT
    `state_number`,
    ANY_VALUE(`state_name`) AS state_name,
    COUNT(DISTINCT `consecutive_number`) AS crashes_2015
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(`driver_distracted_by_name`) NOT IN ('not distracted', 'unknown if distracted', 'not reported')
  GROUP BY `state_number`
)
SELECT
  c.state_number,
  c.state_name,
  c.crashes_2015,
  ROUND(c.crashes_2015 * 100000 / p.us_pop_2010, 4) AS crashes_per_100k_2015
FROM crashes c CROSS JOIN pop p
LIMIT 20;
```

