```sql
-- Description: Combine the 2015 and 2016 results in one view for comparison
WITH pop AS (
  SELECT SUM(`population`) AS us_pop_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
),
crashes15 AS (
  SELECT
    `state_number`,
    ANY_VALUE(`state_name`) AS state_name,
    COUNT(DISTINCT `consecutive_number`) AS crashes_2015
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(`driver_distracted_by_name`) NOT IN ('not distracted', 'unknown if distracted', 'not reported')
  GROUP BY `state_number`
),
crashes16 AS (
  SELECT
    `state_number`,
    ANY_VALUE(`state_name`) AS state_name,
    COUNT(DISTINCT `consecutive_number`) AS crashes_2016
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE LOWER(`driver_distracted_by_name`) NOT IN ('not distracted', 'unknown if distracted', 'not reported')
  GROUP BY `state_number`
)
SELECT
  COALESCE(c15.state_name, c16.state_name) AS state_name,
  ROUND(c15.crashes_2015 * 100000 / p.us_pop_2010, 4) AS crashes_per_100k_2015,
  ROUND(c16.crashes_2016 * 100000 / p.us_pop_2010, 4) AS crashes_per_100k_2016
FROM pop p
LEFT JOIN crashes15 c15 USING(state_number)
LEFT JOIN crashes16 c16 USING(state_number)
ORDER BY crashes_per_100k_2015 DESC, crashes_per_100k_2016 DESC
LIMIT 20;
```
