Query:
--Description: Compute 2015 distracted-driver crash rate per 100,000 people for every state
--             (table has no state_name, so we keep state_number only)
WITH pop AS (
  SELECT SUM(`population`) AS us_pop_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
),
crashes AS (
  SELECT
    `state_number`,
    COUNT(DISTINCT `consecutive_number`) AS crashes_2015
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(`driver_distracted_by_name`) NOT IN ('not distracted',
                                                   'unknown if distracted',
                                                   'not reported')
  GROUP BY `state_number`
)
SELECT
  c.state_number,
  c.crashes_2015,
  ROUND(c.crashes_2015 * 100000.0 / p.us_pop_2010, 6) AS crashes_per_100k_2015
FROM crashes AS c
CROSS JOIN pop AS p
ORDER BY crashes_per_100k_2015 DESC
LIMIT 20
