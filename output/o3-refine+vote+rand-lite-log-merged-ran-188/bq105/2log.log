```sql
--Description / Thinking process:
-- Build one combined table that lists, for each state, the distracted-driver crash
-- rates (per 100 000 people) in 2015 and 2016:
--
-- 1. pop         : one-row CTE with the 2010 U.S. population total (national denominator).
-- 2. crashes15   : count DISTINCT crashes in 2015 per state_number after excluding the
--                  three “non-informative” distraction labels.
-- 3. crashes16   : same logic for 2016.
-- 4. combined    : FULL OUTER JOIN the two yearly tables on state_number so every
--                  state that appears in either year is included.  Use COALESCE to
--                  keep a single state_number column; IFNULL() converts missing counts
--                  to zeros.
-- 5. Final step  : CROSS JOIN with pop (because pop has no state_number) and compute
--                  crash rates for both years.  Order by 2015 rate descending, then 2016.
WITH pop AS (
  SELECT SUM(`population`) AS us_pop_2010
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
),
crashes15 AS (
  SELECT
    `state_number`,
    COUNT(DISTINCT `consecutive_number`) AS crashes_2015
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2015`
  WHERE LOWER(`driver_distracted_by_name`) NOT IN ('not distracted',
                                                   'unknown if distracted',
                                                   'not reported')
  GROUP BY `state_number`
),
crashes16 AS (
  SELECT
    `state_number`,
    COUNT(DISTINCT `consecutive_number`) AS crashes_2016
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.distract_2016`
  WHERE LOWER(`driver_distracted_by_name`) NOT IN ('not distracted',
                                                   'unknown if distracted',
                                                   'not reported')
  GROUP BY `state_number`
),
combined AS (
  SELECT
    COALESCE(c15.state_number, c16.state_number) AS state_number,
    IFNULL(c15.crashes_2015, 0) AS crashes_2015,
    IFNULL(c16.crashes_2016, 0) AS crashes_2016
  FROM crashes15 AS c15
  FULL OUTER JOIN crashes16 AS c16
    ON c15.state_number = c16.state_number
)
SELECT
  state_number,
  ROUND(crashes_2015 * 100000.0 / p.us_pop_2010, 6) AS crashes_per_100k_2015,
  ROUND(crashes_2016 * 100000.0 / p.us_pop_2010, 6) AS crashes_per_100k_2016
FROM combined
CROSS JOIN pop AS p
ORDER BY crashes_per_100k_2015 DESC, crashes_per_100k_2016 DESC
LIMIT 20;
```
