Query:
--Description:  (6)  Tag each date with grp = jd-rn; rows that are consecutive calendar days share the same grp.  Return the longest consecutive-day streak for Iran in Jan-2022
WITH d AS (
     SELECT insert_date,
            julianday(insert_date)            AS jd,
            ROW_NUMBER() OVER (ORDER BY insert_date) AS rn
     FROM   cities
     WHERE  country_code_2 = 'ir'
       AND  insert_date LIKE '2022-01-%'
)
SELECT  (jd - rn)                 AS grp,
        MIN(insert_date)          AS streak_start,
        MAX(insert_date)          AS streak_end,
        COUNT(*)                  AS streak_len
FROM    d
GROUP BY grp
ORDER BY streak_len DESC
LIMIT 1
