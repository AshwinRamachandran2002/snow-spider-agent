```sql
-- 1.  Check what January-2022 insert-dates exist in the “cities” table
SELECT DISTINCT insert_date
FROM cities
WHERE insert_date LIKE '2022-01-%'
ORDER BY insert_date
LIMIT 20;
```

```sql
-- 2.  For each country (ISO-2 code) count how many different
--     January-2022 insert-dates it has; keep only those with ≥9 days
SELECT country_code_2,
       COUNT(DISTINCT insert_date) AS jan_days
FROM cities
WHERE insert_date LIKE '2022-01-%'
GROUP BY country_code_2
HAVING jan_days >= 9;
```

```sql
-- 3.  Get the full country name for the candidate(s) from step-2
SELECT cc.country_name,
       c.country_code_2,
       COUNT(DISTINCT c.insert_date) AS jan_days
FROM cities            AS c
JOIN cities_countries  AS cc
     ON cc.country_code_2 = c.country_code_2
WHERE c.insert_date LIKE '2022-01-%'
GROUP BY cc.country_name, c.country_code_2
HAVING jan_days >= 9;
```

```sql
-- 4.  List every January-2022 insertion date for the identified country
--     (replace '??' with the country_code_2 returned above, e.g. 'jp')
SELECT insert_date
FROM cities
WHERE country_code_2 = '??'
  AND insert_date LIKE '2022-01-%'
ORDER BY insert_date;
```

```sql
-- 5.  Add a running index so we can detect consecutive-day streaks
SELECT insert_date,
       julianday(insert_date)               AS jd,
       ROW_NUMBER() OVER (ORDER BY insert_date) AS rn
FROM cities
WHERE country_code_2 = '??'
  AND insert_date LIKE '2022-01-%'
ORDER BY insert_date;
```

```sql
-- 6.  Tag each date with a “group id” = jd-rn.
--     All consecutive days share the same (jd-rn) value.
WITH d AS (
  SELECT insert_date,
         julianday(insert_date)            AS jd,
         ROW_NUMBER() OVER (ORDER BY insert_date) AS rn
  FROM cities
  WHERE country_code_2 = '??'
    AND insert_date LIKE '2022-01-%'
)
SELECT (jd - rn)           AS grp,
       MIN(insert_date)    AS streak_start,
       MAX(insert_date)    AS streak_end,
       COUNT(*)            AS streak_len
FROM d
GROUP BY grp
ORDER BY streak_len DESC
LIMIT 1;
```

```sql
-- 7.  Retrieve every city-row that falls inside the longest streak period
--     (replace the two date literals by the streak_start / streak_end from step-6)
SELECT *
FROM cities
WHERE country_code_2 = '??'
  AND insert_date BETWEEN '2022-01-DD' AND '2022-01-DD';
```

```sql
-- 8.  Within that streak, calculate the proportion of rows that are the capital
WITH streak AS (
  SELECT *
  FROM cities
  WHERE country_code_2 = '??'
    AND insert_date BETWEEN '2022-01-DD' AND '2022-01-DD'
)
SELECT SUM(capital) * 1.0 / COUNT(*)  AS capital_proportion
FROM streak;
```

(The placeholders ‘??’ for country_code_2 and the two ‘DD’ date values should be replaced with the actual country code and the start / end dates returned by the earlier queries.)

These eight queries locate the country with data inserted on nine different January-2022 days, determine its longest consecutive insertion streak, and compute what fraction of those rows correspond to its capital city.
