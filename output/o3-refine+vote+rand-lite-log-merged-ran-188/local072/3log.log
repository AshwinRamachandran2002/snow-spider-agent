--Description:  (5) Add a running index for every January-2022 row of Iran (‘ir’) so consecutive-day streaks can be detected
SELECT
       insert_date,
       julianday(insert_date)               AS jd,
       ROW_NUMBER() OVER (ORDER BY insert_date) AS rn
FROM   cities
WHERE  country_code_2 = 'ir'
  AND  insert_date LIKE '2022-01-%'
ORDER BY insert_date
