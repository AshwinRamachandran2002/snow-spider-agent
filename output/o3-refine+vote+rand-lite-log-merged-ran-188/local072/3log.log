```sql
--Description:  (6)  Tag each date with grp = jd-rn; rows that are consecutive calendar days share the same grp.  Return the longest consecutive-day streak for Iran in Jan-2022
WITH d AS (
     SELECT insert_date,
            julianday(insert_date)            AS jd,
            ROW_NUMBER() OVER (ORDER BY insert_date) AS rn
     FROM   cities
     WHERE  country_code_2 = 'ir'
       AND  insert_date LIKE '2022-01-%'
)
SELECT  (jd - rn)                 AS grp,
        MIN(insert_date)          AS streak_start,
        MAX(insert_date)          AS streak_end,
        COUNT(*)                  AS streak_len
FROM    d
GROUP BY grp
ORDER BY streak_len DESC
LIMIT 1;
```

```sql
--Description:  (7)  Retrieve every city-row that falls inside Iran’s longest consecutive January-2022 insertion streak (dates computed inside the query)
WITH d AS (
     SELECT insert_date,
            julianday(insert_date)            AS jd,
            ROW_NUMBER() OVER (ORDER BY insert_date) AS rn
     FROM   cities
     WHERE  country_code_2 = 'ir'
       AND  insert_date LIKE '2022-01-%'
), streaks AS (
     SELECT  (jd - rn) AS grp,
             MIN(insert_date) AS streak_start,
             MAX(insert_date) AS streak_end,
             COUNT(*) AS streak_len
     FROM    d
     GROUP BY grp
), longest AS (
     SELECT streak_start, streak_end
     FROM   streaks
     ORDER BY streak_len DESC
     LIMIT 1
)
SELECT c.*
FROM   cities AS c,
       longest AS l
WHERE  c.country_code_2 = 'ir'
  AND  c.insert_date BETWEEN l.streak_start AND l.streak_end
ORDER BY c.insert_date, c.city_name;
```

```sql
--Description:  (8)  Within that longest streak, calculate the proportion of rows that correspond to Iran’s capital city (capital = 1)
WITH d AS (
     SELECT insert_date,
            julianday(insert_date)            AS jd,
            ROW_NUMBER() OVER (ORDER BY insert_date) AS rn
     FROM   cities
     WHERE  country_code_2 = 'ir'
       AND  insert_date LIKE '2022-01-%'
), streaks AS (
     SELECT  (jd - rn) AS grp,
             MIN(insert_date) AS streak_start,
             MAX(insert_date) AS streak_end,
             COUNT(*) AS streak_len
     FROM    d
     GROUP BY grp
), longest AS (
     SELECT streak_start, streak_end
     FROM   streaks
     ORDER BY streak_len DESC
     LIMIT 1
), streak_cities AS (
     SELECT *
     FROM   cities, longest
     WHERE  country_code_2 = 'ir'
       AND  insert_date BETWEEN longest.streak_start AND longest.streak_end
)
SELECT
       SUM(capital) * 1.0 / COUNT(*)  AS capital_proportion
FROM   streak_cities;
```
