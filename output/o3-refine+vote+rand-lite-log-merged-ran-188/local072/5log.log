--Description: Build a dated list (for Iran, country_code_2 = 'ir') with row numbers and julianday values so we can spot consecutive-day blocks in January 2022.
WITH d AS (
    SELECT DISTINCT
           insert_date,
           ROW_NUMBER() OVER (ORDER BY insert_date) AS rn,
           julianday(insert_date)                   AS jd
    FROM   cities
    WHERE  country_code_2 = 'ir'
      AND  insert_date BETWEEN '2022-01-01' AND '2022-01-31'
)
SELECT insert_date,
       rn,
       jd,
       rn - jd AS grp_key           -- equal values ⇒ same consecutive sequence
FROM   d
ORDER  BY insert_date
