```sql
-- 1.  Inspect all January-2022 insert dates that appear in the `cities` table  
SELECT DISTINCT insert_date
FROM cities
WHERE insert_date BETWEEN '2022-01-01' AND '2022-01-31'
ORDER BY insert_date
LIMIT 20;
```

```sql
-- 2.  Count how many different January-2022 days each country has data for  
SELECT country_code_2,
       COUNT(DISTINCT insert_date) AS distinct_days
FROM cities
WHERE insert_date BETWEEN '2022-01-01' AND '2022-01-31'
GROUP BY country_code_2
ORDER BY distinct_days DESC
LIMIT 20;
```

```sql
-- 3.  Name the country (only those that have data on 9 different days)  
SELECT cc.country_name,
       cc.country_code_2,
       COUNT(DISTINCT c.insert_date) AS distinct_days
FROM   cities            AS c
JOIN   cities_countries  AS cc
       ON c.country_code_2 = cc.country_code_2
WHERE  c.insert_date BETWEEN '2022-01-01' AND '2022-01-31'
GROUP  BY cc.country_name, cc.country_code_2
HAVING distinct_days = 9;
```

```sql
-- 4.  List the nine January-2022 insert dates for that country  
--     (replace :cc2 with the country code returned in step-3)
SELECT DISTINCT insert_date
FROM   cities
WHERE  country_code_2 = :cc2
  AND  insert_date BETWEEN '2022-01-01' AND '2022-01-31'
ORDER  BY insert_date;
```

```sql
-- 5.  Build a dated list with a row number so we can spot consecutive-day blocks  
WITH d AS (
    SELECT DISTINCT
           insert_date,
           ROW_NUMBER() OVER (ORDER BY insert_date)         AS rn,
           julianday(insert_date)                           AS jd
    FROM   cities
    WHERE  country_code_2 = :cc2
      AND  insert_date BETWEEN '2022-01-01' AND '2022-01-31'
)
SELECT insert_date,
       rn,
       jd,
       rn - jd AS grp_key      -- equal values ⇒ same consecutive sequence
FROM   d
ORDER  BY insert_date;
```

```sql
-- 6.  From those keys, pick the longest consecutive-day sequence  
WITH d AS (
    SELECT DISTINCT
           insert_date,
           ROW_NUMBER() OVER (ORDER BY insert_date)  AS rn,
           julianday(insert_date)                    AS jd
    FROM   cities
    WHERE  country_code_2 = :cc2
      AND  insert_date BETWEEN '2022-01-01' AND '2022-01-31'
), g AS (
    SELECT insert_date,
           rn - jd          AS grp_key
    FROM   d
)
SELECT grp_key,
       MIN(insert_date) AS start_date,
       MAX(insert_date) AS end_date,
       COUNT(*)         AS days_in_run
FROM   g
GROUP  BY grp_key
ORDER  BY days_in_run DESC
LIMIT 1;               -- ← longest consecutive period
```

```sql
-- 7.  Show every city row that falls in that longest consecutive period  
--     (replace :start_d and :end_d with the dates returned in step-6)
SELECT city_name,
       capital,
       insert_date
FROM   cities
WHERE  country_code_2 = :cc2
  AND  insert_date BETWEEN :start_d AND :end_d
ORDER  BY insert_date, city_name
LIMIT 20;
```

```sql
-- 8.  Calculate how many of those rows are the capital vs. total rows  
--     (gives the proportion of capital-city entries)
SELECT 
       SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END)         AS capital_rows,
       COUNT(*)                                             AS total_rows,
       ROUND(
           1.0 * SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END) / COUNT(*),
           3
       ) AS capital_proportion
FROM   cities
WHERE  country_code_2 = :cc2
  AND  insert_date BETWEEN :start_d AND :end_d;
```

```sql
-- 9.  (Optional) Pull the human-readable country name together with the final ratio
SELECT cc.country_name,
       r.capital_rows,
       r.total_rows,
       r.capital_proportion
FROM   (
        SELECT 
               SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END) AS capital_rows,
               COUNT(*)                                     AS total_rows,
               ROUND(
                   1.0 * SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END) / COUNT(*),
                   3
               ) AS capital_proportion
        FROM   cities
        WHERE  country_code_2 = :cc2
          AND  insert_date BETWEEN :start_d AND :end_d
       ) AS r
JOIN   cities_countries  AS cc
       ON cc.country_code_2 = :cc2;
```

```sql
-- 10.  Verify which specific date-range rows are counted as “capital”
SELECT city_name, insert_date
FROM   cities
WHERE  country_code_2 = :cc2
  AND  insert_date BETWEEN :start_d AND :end_d
  AND  capital = 1
ORDER  BY insert_date;
```

Run these queries in order—substituting  
:cc2  → the country code revealed in step-3  
:start_d / :end_d → the start / end dates from step-6—  
to identify:

1. The country having data on nine separate January-2022 days.  
2. Its longest consecutive-day insertion stretch inside that month.  
3. The proportion of rows from the capital city during that stretch.
