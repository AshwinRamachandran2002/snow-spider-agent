--Description: Show every city row that falls inside the longest consecutive insertion period for Iran (derived on-the-fly).
WITH d AS (
    SELECT DISTINCT
           insert_date,
           ROW_NUMBER() OVER (ORDER BY insert_date) AS rn,
           julianday(insert_date)                   AS jd
    FROM   cities
    WHERE  country_code_2 = 'ir'
      AND  insert_date BETWEEN '2022-01-01' AND '2022-01-31'
), g AS (
    SELECT insert_date,
           rn - jd  AS grp_key
    FROM   d
), longest AS (
    SELECT MIN(insert_date) AS start_d,
           MAX(insert_date) AS end_d
    FROM   g
