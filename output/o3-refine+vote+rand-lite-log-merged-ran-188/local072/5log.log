--Description: From those keys, pick the longest consecutive-day sequence of insertions for Iran in January 2022 (start date, end date, length).
WITH d AS (
    SELECT DISTINCT
           insert_date,
           ROW_NUMBER() OVER (ORDER BY insert_date) AS rn,
           julianday(insert_date)                   AS jd
    FROM   cities
    WHERE  country_code_2 = 'ir'
      AND  insert_date BETWEEN '2022-01-01' AND '2022-01-31'
), g AS (
    SELECT insert_date,
           rn - jd  AS grp_key
    FROM   d
)
SELECT grp_key,
       MIN(insert_date) AS start_date,
       MAX(insert_date) AS end_date,
       COUNT(*)         AS days_in_run
FROM   g
GROUP  BY grp_key
ORDER  BY days_in_run DESC
LIMIT 1
