--Description: Bring back the human-readable country name together with the calculated capital-city proportion for Iran’s longest run.
WITH d AS (
    SELECT DISTINCT
           insert_date,
           ROW_NUMBER() OVER (ORDER BY insert_date) AS rn,
           julianday(insert_date)                   AS jd
    FROM   cities
    WHERE  country_code_2 = 'ir'
      AND  insert_date BETWEEN '2022-01-01' AND '2022-01-31'
), g AS (
    SELECT insert_date,
           rn - jd  AS grp_key
    FROM   d
), longest AS (
    SELECT MIN(insert_date) AS start_d,
           MAX(insert_date) AS end_d
    FROM   g
    GROUP  BY grp_key
    ORDER  BY COUNT(*) DESC
    LIMIT 1
), ratio AS (
    SELECT
           SUM(CASE WHEN c.capital = 1 THEN 1 ELSE 0 END) AS capital_rows,
           COUNT(*)                                       AS total_rows,
           ROUND(
               1.0 * SUM(CASE WHEN c.capital = 1 THEN 1 ELSE 0 END) / COUNT(*),
               3
           )                                              AS capital_proportion
    FROM   cities AS c
    CROSS  JOIN longest AS l
    WHERE  c.country_code_2 = 'ir'
      AND  c.insert_date BETWEEN l.start_d AND l.end_d
)
SELECT cc.country_name,
       r.capital_rows,
       r.total_rows,
       r.capital_proportion
FROM   ratio              AS r
JOIN   cities_countries   AS cc
       ON cc.country_code_2 = 'ir';
