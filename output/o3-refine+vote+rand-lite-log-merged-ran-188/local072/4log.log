Query:
--Description: Aggregate by streak‐id to find the longest consecutive insertion period (number of days).
SELECT   (julianday(insert_dt) - rn)                      AS streak_id,
         MIN(insert_dt)                                   AS streak_start,
         MAX(insert_dt)                                   AS streak_end,
         COUNT(*)                                         AS streak_len
FROM     (
          SELECT DISTINCT
                 DATE("insert_date")                       AS insert_dt,
                 ROW_NUMBER() OVER (ORDER BY DATE("insert_date")) AS rn
          FROM   "cities"
          WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
            AND  "country_code_2" = (SELECT "country_code_2"
                                     FROM   "cities"
                                     WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
                                     GROUP  BY "country_code_2"
                                     HAVING COUNT( DISTINCT DATE("insert_date") ) = 9)
         )
GROUP BY streak_id
ORDER BY streak_len DESC
LIMIT 1;
