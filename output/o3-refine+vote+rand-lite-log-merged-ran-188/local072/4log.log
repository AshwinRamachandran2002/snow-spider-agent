```sql
--Description: Find each distinct insertion date together with a running row number to help detect consecutive streaks.
SELECT DISTINCT
       DATE("insert_date")                               AS insert_dt,
       ROW_NUMBER() OVER (ORDER BY DATE("insert_date"))  AS rn
FROM   "cities"
WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
  AND  "country_code_2" = (SELECT "country_code_2"
                           FROM   "cities"
                           WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
                           GROUP  BY "country_code_2"
                           HAVING COUNT( DISTINCT DATE("insert_date") ) = 9)
ORDER BY insert_dt;
```

```sql
--Description: Tag each date with a “streak id” by subtracting the row number from the Julian day; equal results belong to the same consecutive block.
SELECT *
FROM   (
        SELECT DISTINCT
               DATE("insert_date")                         AS insert_dt,
               ROW_NUMBER() OVER (ORDER BY DATE("insert_date")) AS rn,
               julianday(DATE("insert_date"))                AS jul
        FROM   "cities"
        WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
          AND  "country_code_2" = (SELECT "country_code_2"
                                   FROM   "cities"
                                   WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
                                   GROUP  BY "country_code_2"
                                   HAVING COUNT( DISTINCT DATE("insert_date") ) = 9)
       )
-- streak_id = jul - rn   (same value = consecutive days)
```

```sql
--Description: Aggregate by streak‐id to find the longest consecutive insertion period (number of days).
SELECT   (julianday(insert_dt) - rn)                      AS streak_id,
         MIN(insert_dt)                                   AS streak_start,
         MAX(insert_dt)                                   AS streak_end,
         COUNT(*)                                         AS streak_len
FROM     (
          SELECT DISTINCT
                 DATE("insert_date")                       AS insert_dt,
                 ROW_NUMBER() OVER (ORDER BY DATE("insert_date")) AS rn
          FROM   "cities"
          WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
            AND  "country_code_2" = (SELECT "country_code_2"
                                     FROM   "cities"
                                     WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
                                     GROUP  BY "country_code_2"
                                     HAVING COUNT( DISTINCT DATE("insert_date") ) = 9)
         )
GROUP BY streak_id
ORDER BY streak_len DESC
LIMIT 1;
```

```sql
--Description: Pull all rows that fall inside the longest consecutive streak.
WITH longest AS (
      SELECT   MIN(insert_dt) AS start_dt,
               MAX(insert_dt) AS end_dt
      FROM   (
              SELECT DISTINCT
                     DATE("insert_date") AS insert_dt,
                     ROW_NUMBER() OVER (ORDER BY DATE("insert_date")) AS rn
              FROM   "cities"
              WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
                AND  "country_code_2" = (SELECT "country_code_2"
                                         FROM   "cities"
                                         WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
                                         GROUP  BY "country_code_2"
                                         HAVING COUNT( DISTINCT DATE("insert_date") ) = 9)
             )
      GROUP BY (julianday(insert_dt) - rn)
      ORDER BY COUNT(*) DESC
      LIMIT 1
)
SELECT *
FROM   "cities"
WHERE  "country_code_2" = (SELECT "country_code_2"
                           FROM   "cities"
                           WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
                           GROUP  BY "country_code_2"
                           HAVING COUNT( DISTINCT DATE("insert_date") ) = 9)
  AND  DATE("insert_date") BETWEEN (SELECT start_dt FROM longest)
                              AND     (SELECT end_dt   FROM longest)
LIMIT 20;
```

```sql
--Description: Compute the proportion of entries that are from the capital city during this longest consecutive period.
WITH target_country AS (
      SELECT "country_code_2"
      FROM   "cities"
      WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
      GROUP  BY "country_code_2"
      HAVING COUNT( DISTINCT DATE("insert_date") ) = 9
),
longest AS (
      SELECT   MIN(insert_dt) AS start_dt,
               MAX(insert_dt) AS end_dt
      FROM   (
              SELECT DISTINCT
                     DATE("insert_date") AS insert_dt,
                     ROW_NUMBER() OVER (ORDER BY DATE("insert_date")) AS rn
              FROM   "cities"
              WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
                AND  "country_code_2" = (SELECT "country_code_2" FROM target_country)
             )
      GROUP BY (julianday(insert_dt) - rn)
      ORDER BY COUNT(*) DESC
      LIMIT 1
)
SELECT 
       SUM( CASE WHEN "capital" = 1 THEN 1 ELSE 0 END ) * 1.0 / COUNT(*) AS capital_ratio
FROM   "cities"
WHERE  "country_code_2" = (SELECT "country_code_2" FROM target_country)
  AND  DATE("insert_date") BETWEEN (SELECT start_dt FROM longest)
                              AND     (SELECT end_dt   FROM longest);
```
