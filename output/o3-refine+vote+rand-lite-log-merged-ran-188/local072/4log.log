Query:
--Description: Pull all rows that fall inside the longest consecutive streak.
WITH longest AS (
      SELECT   MIN(insert_dt) AS start_dt,
               MAX(insert_dt) AS end_dt
      FROM   (
              SELECT DISTINCT
                     DATE("insert_date") AS insert_dt,
                     ROW_NUMBER() OVER (ORDER BY DATE("insert_date")) AS rn
              FROM   "cities"
              WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
                AND  "country_code_2" = (SELECT "country_code_2"
                                         FROM   "cities"
                                         WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
                                         GROUP  BY "country_code_2"
                                         HAVING COUNT( DISTINCT DATE("insert_date") ) = 9)
             )
      GROUP BY (julianday(insert_dt) - rn)
      ORDER BY COUNT(*) DESC
      LIMIT 1
)
SELECT *
FROM   "cities"
WHERE  "country_code_2" = (SELECT "country_code_2"
                           FROM   "cities"
                           WHERE  strftime('%Y-%m', "insert_date") = '2022-01'
                           GROUP  BY "country_code_2"
                           HAVING COUNT( DISTINCT DATE("insert_date") ) = 9)
  AND  DATE("insert_date") BETWEEN (SELECT start_dt FROM longest)
                              AND     (SELECT end_dt   FROM longest)
LIMIT 20;
