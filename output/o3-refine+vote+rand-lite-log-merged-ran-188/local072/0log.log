```sql
--Description:
-- Step-by-step logic carried out in ONE query:
--   1. “jan22” CTE keeps all rows from January-2022 in the cities table.
--   2. “nine_day_country” finds the single country that has data on exactly nine
--      distinct January-2022 days (→ ‘ir’ for Iran).
--   3. “country_dates” collects each distinct insertion date for that country.
--   4. “numbered” numbers those dates and, by subtracting ROW_NUMBER() from
--      the Julian day, converts consecutive-day sequences into identical “grp” values.
--   5. “streaks” builds every consecutive block; “longest” selects the longest one
--      (start = 2022-01-20, end = 2022-01-22, length = 3 days).
--   6. “stats” counts total rows vs. rows whose ‘capital’ flag = 1 within that
--      longest span.
--   7. The final SELECT shows the country, streak period, counts, and proportion
--      of capital-city rows.
WITH jan22 AS (
    SELECT *
    FROM   cities
    WHERE  insert_date BETWEEN '2022-01-01' AND '2022-01-31'
),
nine_day_country AS (
    SELECT country_code_2
    FROM   jan22
    GROUP  BY country_code_2
    HAVING COUNT(DISTINCT insert_date) = 9        -- exactly nine different days
),
country_dates AS (
    SELECT DISTINCT DATE(insert_date) AS d
    FROM   jan22
    WHERE  country_code_2 = (SELECT country_code_2 FROM nine_day_country)
),
numbered AS (
    SELECT d,
           julianday(d) - ROW_NUMBER() OVER (ORDER BY d) AS grp
    FROM   country_dates
),
streaks AS (
    SELECT MIN(d) AS start_date,
           MAX(d) AS end_date,
           COUNT(*) AS day_len
    FROM   numbered
    GROUP  BY grp
),
longest AS (
    SELECT *
    FROM   streaks
    ORDER  BY day_len DESC, start_date
    LIMIT  1                                   -- longest consecutive streak
),
stats AS (
    SELECT COUNT(*)                                       AS total_rows,
           SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END)   AS capital_rows
    FROM   cities, nine_day_country, longest
    WHERE  country_code_2 = (SELECT country_code_2 FROM nine_day_country)
      AND  insert_date BETWEEN longest.start_date AND longest.end_date
)
SELECT nc.country_code_2                    AS country_code,
       cc.country_name,
       longest.start_date || ' to ' || longest.end_date AS longest_consecutive_period,
       stats.capital_rows     AS capital_city_rows,
       stats.total_rows       AS total_rows,
       ROUND(1.0 * stats.capital_rows / stats.total_rows, 3) AS capital_ratio
FROM   nine_day_country nc
JOIN   cities_countries cc ON cc.country_code_2 = nc.country_code_2
CROSS  JOIN longest
CROSS  JOIN stats;
