-- 6. Build each consecutive-day block for that country and find the LONGEST one
WITH jan_dates AS (
     SELECT DISTINCT date(insert_date) AS d
     FROM   cities
     WHERE  country_code_2 = (SELECT country_code_2
                              FROM   (SELECT country_code_2,
                                             COUNT(DISTINCT insert_date) jan22_days
                                      FROM   cities
                                      WHERE  insert_date BETWEEN '2022-01-01' AND '2022-01-31'
                                      GROUP  BY country_code_2)
                              WHERE  jan22_days = 9)
       AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
),
numbered AS (
     SELECT d,
            julianday(d) -
            ROW_NUMBER() OVER (ORDER BY d) AS grp
     FROM   jan_dates
),
streaks AS (
     SELECT MIN(d) AS start_date,
            MAX(d) AS end_date,
            COUNT(*) AS day_len
     FROM   numbered
     GROUP  BY grp
)
SELECT *
FROM   streaks
ORDER  BY day_len DESC, start_date
LIMIT  1;
