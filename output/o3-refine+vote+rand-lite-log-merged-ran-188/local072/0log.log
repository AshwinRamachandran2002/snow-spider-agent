    FROM   cities
    WHERE  insert_date BETWEEN '2022-01-01' AND '2022-01-31'
),
nine_ctry AS (                        -- country with exactly 9 distinct insert-days
    SELECT country_code_2
    FROM   jan22
    GROUP  BY country_code_2
    HAVING COUNT(DISTINCT insert_date) = 9
),
dates AS (                            -- each distinct date for that country
    SELECT DISTINCT DATE(insert_date) AS d
    FROM   jan22
    WHERE  country_code_2 = (SELECT country_code_2 FROM nine_ctry)
),
grp_dates AS (                        -- group consecutive dates
    SELECT d,
           julianday(d) - ROW_NUMBER() OVER (ORDER BY d) AS grp
    FROM   dates
),
streaks AS (                          -- each consecutive block
    SELECT MIN(d) AS start_date,
           MAX(d) AS end_date,
           COUNT(*) AS span_len
    FROM   grp_dates
    GROUP  BY grp
),
longest AS (                          -- longest consecutive span
    SELECT * 
    FROM   streaks
    ORDER  BY span_len DESC, start_date
    LIMIT  1
),
stats AS (                            -- total vs. capital rows in longest span
    SELECT COUNT(*)                                       AS total_rows,
           SUM(CASE WHEN capital = 1 THEN 1 ELSE 0 END)   AS capital_rows
    FROM   cities c
    JOIN   longest l
      ON   c.insert_date BETWEEN l.start_date AND l.end_date
    WHERE  c.country_code_2 = (SELECT country_code_2 FROM nine_ctry)
)
SELECT nc.country_code_2                        AS country_code,
       cc.country_name,
       longest.start_date || ' to ' || longest.end_date AS longest_consecutive_period,
       stats.capital_rows                        AS capital_city_rows,
       stats.total_rows                          AS total_rows,
       ROUND(1.0 * stats.capital_rows / stats.total_rows, 3) AS capital_ratio
FROM   nine_ctry  nc
JOIN   cities_countries cc ON cc.country_code_2 = nc.country_code_2
CROSS  JOIN longest
CROSS  JOIN stats;
