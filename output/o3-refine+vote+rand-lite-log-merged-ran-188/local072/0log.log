       SUM(CASE WHEN c.capital = 1 THEN 1 ELSE 0 END)            AS capital_rows,
       ROUND(1.0 * SUM(CASE WHEN c.capital = 1 THEN 1 ELSE 0 END) /
                   COUNT(*), 3)                                  AS capital_ratio
FROM   cities AS c
