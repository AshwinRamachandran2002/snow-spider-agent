```

```sql
--Description: Compute the average expression per gene and sex for the target subset  
SELECT      "FEATURE_NAME",
            "SEX",
            AVG("X_VALUE") AS "AVG_X_VALUE"
FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE     "CLUSTERS" = '41'
      AND "DEVELOPMENT_STAGE" ILIKE '%74%year%old%'
      AND "CELL_TYPE" ILIKE '%epithelial%'
GROUP BY "FEATURE_NAME", "SEX"
LIMIT 20;
```

```sql
--Description: Pivot the previous averages so female and male sit on the same row; show the difference (female – male)  
WITH avg_by_sex AS (
    SELECT      "FEATURE_NAME",
                "SEX",
                AVG("X_VALUE") AS avg_val
    FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
    WHERE     "CLUSTERS" = '41'
          AND "DEVELOPMENT_STAGE" ILIKE '%74%year%old%'
          AND "CELL_TYPE" ILIKE '%epithelial%'
    GROUP BY "FEATURE_NAME", "SEX"
)
SELECT  f."FEATURE_NAME",
        f.avg_val  AS "FEMALE_AVG",
        m.avg_val  AS "MALE_AVG",
        f.avg_val - m.avg_val AS "DIFF_F_MINUS_M"
FROM     avg_by_sex f
JOIN     avg_by_sex m
       ON f."FEATURE_NAME" = m."FEATURE_NAME"
WHERE    f."SEX" ILIKE 'female'
  AND    m."SEX" ILIKE 'male'
LIMIT 20;
```

```sql
--Description: Return the 20 genes with the greatest female–male average-expression difference in the requested subset  
WITH avg_by_sex AS (
    SELECT      "FEATURE_NAME",
                "SEX",
                AVG("X_VALUE") AS avg_val
    FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
    WHERE     "CLUSTERS" = '41'
          AND "DEVELOPMENT_STAGE" ILIKE '%74%year%old%'
          AND "CELL_TYPE" ILIKE '%epithelial%'
    GROUP BY "FEATURE_NAME", "SEX"
), pivoted AS (
    SELECT  f."FEATURE_NAME",
            f.avg_val AS female_avg,
            m.avg_val AS male_avg,
            f.avg_val - m.avg_val AS diff_f_minus_m
    FROM     avg_by_sex f
    JOIN     avg_by_sex m
         ON f."FEATURE_NAME" = m."FEATURE_NAME"
    WHERE    f."SEX" ILIKE 'female'
      AND    m."SEX" ILIKE 'male'
)
SELECT *
FROM   pivoted
ORDER BY diff_f_minus_m DESC
LIMIT 20;
```
