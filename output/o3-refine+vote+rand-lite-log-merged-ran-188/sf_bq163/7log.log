```

```sql
-- 4) Check a few distinct genes expressed in this subset
SELECT DISTINCT "FEATURE_NAME"
FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CLUSTERS" = '41'
  AND "CELL_TYPE" ILIKE '%epithelial%'
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
LIMIT 20;
```

```sql
-- 5) Compute the average expression for each gene in females only
SELECT 
  "FEATURE_NAME",
  AVG("X_VALUE") AS "AVG_FEMALE_EXPR"
FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CLUSTERS" = '41'
  AND "CELL_TYPE" ILIKE '%epithelial%'
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
  AND "SEX" = 'female'
GROUP BY "FEATURE_NAME"
LIMIT 20;
```

```sql
-- 6) Compute the average expression for each gene in males only
SELECT 
  "FEATURE_NAME",
  AVG("X_VALUE") AS "AVG_MALE_EXPR"
FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CLUSTERS" = '41'
  AND "CELL_TYPE" ILIKE '%epithelial%'
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
  AND "SEX" = 'male'
GROUP BY "FEATURE_NAME"
LIMIT 20;
```

```sql
-- 7) Side-by-side female vs male averages per gene (conditional aggregation)
SELECT
  "FEATURE_NAME",
  AVG(CASE WHEN "SEX" = 'female' THEN "X_VALUE" END) AS "AVG_FEMALE",
  AVG(CASE WHEN "SEX" = 'male'   THEN "X_VALUE" END) AS "AVG_MALE"
FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CLUSTERS" = '41'
  AND "CELL_TYPE" ILIKE '%epithelial%'
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
GROUP BY "FEATURE_NAME"
LIMIT 20;
```

```sql
-- 8) Calculate the female − male difference, order by largest positive values
SELECT
  "FEATURE_NAME",
  AVG(CASE WHEN "SEX" = 'female' THEN "X_VALUE" END) -
  AVG(CASE WHEN "SEX" = 'male'   THEN "X_VALUE" END)   AS "FEMALE_MINUS_MALE"
FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CLUSTERS" = '41'
  AND "CELL_TYPE" ILIKE '%epithelial%'
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
GROUP BY "FEATURE_NAME"
ORDER BY "FEMALE_MINUS_MALE" DESC
LIMIT 20;
```

```sql
-- 9) Same calculation but order by largest negative values (male > female)
SELECT
  "FEATURE_NAME",
  AVG(CASE WHEN "SEX" = 'female' THEN "X_VALUE" END) -
  AVG(CASE WHEN "SEX" = 'male'   THEN "X_VALUE" END)   AS "FEMALE_MINUS_MALE"
FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CLUSTERS" = '41'
  AND "CELL_TYPE" ILIKE '%epithelial%'
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
GROUP BY "FEATURE_NAME"
ORDER BY "FEMALE_MINUS_MALE" ASC
LIMIT 20;
```

```sql
--10) Final query: top 20 genes with greatest absolute difference (regardless of sign)
SELECT
  "FEATURE_NAME",
  ABS(
    AVG(CASE WHEN "SEX" = 'female' THEN "X_VALUE" END) -
    AVG(CASE WHEN "SEX" = 'male'   THEN "X_VALUE" END)
  ) AS "ABS_DIFF"
FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CLUSTERS" = '41'
  AND "CELL_TYPE" ILIKE '%epithelial%'
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
GROUP BY "FEATURE_NAME"
ORDER BY "ABS_DIFF" DESC
LIMIT 20;
```
