```sql
--Description:  Average expression for female epithelial cells in cluster 41, 74-year-old stage, by gene.
SELECT
  "FEATURE_NAME",
  AVG("X_VALUE") AS "AVG_FEMALE_X"
FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CLUSTERS" = '41'
  AND "CELL_TYPE" ILIKE '%epithelial%'
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
  AND "SEX" = 'female'
GROUP BY "FEATURE_NAME"
LIMIT 20;
```

```sql
--Description:  Average expression for male epithelial cells in the same subset, by gene.
SELECT
  "FEATURE_NAME",
  AVG("X_VALUE") AS "AVG_MALE_X"
FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CLUSTERS" = '41'
  AND "CELL_TYPE" ILIKE '%epithelial%'
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
  AND "SEX" = 'male'
GROUP BY "FEATURE_NAME"
LIMIT 20;
```

```sql
--Description:  Combine the two averages and calculate the female–male difference (positive = higher in females).
WITH female AS (
  SELECT "FEATURE_NAME", AVG("X_VALUE") AS "AVG_F"
  FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
  WHERE "CLUSTERS" = '41'
    AND "CELL_TYPE" ILIKE '%epithelial%'
    AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
    AND "SEX" = 'female'
  GROUP BY "FEATURE_NAME"
),
male AS (
  SELECT "FEATURE_NAME", AVG("X_VALUE") AS "AVG_M"
  FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
  WHERE "CLUSTERS" = '41'
    AND "CELL_TYPE" ILIKE '%epithelial%'
    AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
    AND "SEX" = 'male'
  GROUP BY "FEATURE_NAME"
)
SELECT
  f."FEATURE_NAME",
  f."AVG_F"  - m."AVG_M" AS "FEMALE_MINUS_MALE_DIFF"
FROM female f
JOIN male   m USING ("FEATURE_NAME")
ORDER BY "FEMALE_MINUS_MALE_DIFF" DESC
LIMIT 20;
```

```sql
--Description:  Repeat previous query but show genes where male > female (negative difference) – sanity check.
WITH female AS (
  SELECT "FEATURE_NAME", AVG("X_VALUE") AS "AVG_F"
  FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
  WHERE "CLUSTERS" = '41'
    AND "CELL_TYPE" ILIKE '%epithelial%'
    AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
    AND "SEX" = 'female'
  GROUP BY "FEATURE_NAME"
),
male AS (
  SELECT "FEATURE_NAME", AVG("X_VALUE") AS "AVG_M"
  FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
  WHERE "CLUSTERS" = '41'
    AND "CELL_TYPE" ILIKE '%epithelial%'
    AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
    AND "SEX" = 'male'
  GROUP BY "FEATURE_NAME"
)
SELECT
  f."FEATURE_NAME",
  f."AVG_F"  - m."AVG_M" AS "FEMALE_MINUS_MALE_DIFF"
FROM female f
JOIN male   m USING ("FEATURE_NAME")
ORDER BY "FEMALE_MINUS_MALE_DIFF" ASC
LIMIT 20;
```

```sql
--Description:  Final production query returning the 20 genes with greatest female-minus-male difference (same as #8 but explicit cast for safety).
WITH female AS (
  SELECT "FEATURE_NAME", AVG("X_VALUE") AS "AVG_F"
  FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
  WHERE "CLUSTERS" = '41'
    AND "CELL_TYPE" ILIKE '%epithelial%'
    AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
    AND "SEX" = 'female'
  GROUP BY "FEATURE_NAME"
),
male AS (
  SELECT "FEATURE_NAME", AVG("X_VALUE") AS "AVG_M"
  FROM HTAN_2.HTAN."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
  WHERE "CLUSTERS" = '41'
    AND "CELL_TYPE" ILIKE '%epithelial%'
    AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'
    AND "SEX" = 'male'
  GROUP BY "FEATURE_NAME"
)
SELECT
  f."FEATURE_NAME",
  (f."AVG_F" - m."AVG_M")        AS "FEMALE_MINUS_MALE_DIFF",
  f."AVG_F"                      AS "AVG_FEMALE_X",
  m."AVG_M"                      AS "AVG_MALE_X"
FROM female f
JOIN male   m USING ("FEATURE_NAME")
ORDER BY "FEMALE_MINUS_MALE_DIFF" DESC
LIMIT 20;
```
