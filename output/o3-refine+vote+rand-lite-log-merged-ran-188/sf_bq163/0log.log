FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"  
WHERE "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'  
  AND "CELL_TYPE" ILIKE '%epithelial%'  
LIMIT 20;
```

```sql
--Description: 5) Verify that a “FEATURE_NAME” (gene symbol) column exists and view some examples for cluster 41  
SELECT DISTINCT "FEATURE_NAME"  
FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"  
WHERE "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'  
  AND "CELL_TYPE" ILIKE '%epithelial%'  
  AND "CLUSTERS" = '41'  
LIMIT 20;
```

```sql
--Description: 6) Compute the average expression for each gene in female epithelial cells (cluster 41, 74-yr)  
SELECT "FEATURE_NAME", 
       AVG("X_VALUE") AS "avg_xvalue_female"  
FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"  
WHERE "SEX" = 'female'  
  AND "CELL_TYPE" ILIKE '%epithelial%'  
  AND "CLUSTERS" = '41'  
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'  
GROUP BY "FEATURE_NAME"  
LIMIT 20;
```

```sql
--Description: 7) Compute the average expression for each gene in male epithelial cells (cluster 41, 74-yr)  
SELECT "FEATURE_NAME", 
       AVG("X_VALUE") AS "avg_xvalue_male"  
FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"  
WHERE "SEX" = 'male'  
  AND "CELL_TYPE" ILIKE '%epithelial%'  
  AND "CLUSTERS" = '41'  
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'  
GROUP BY "FEATURE_NAME"  
LIMIT 20;
```

```sql
--Description: 8) Produce female and male averages side-by-side for every gene using conditional aggregation  
SELECT "FEATURE_NAME",  
       AVG(CASE WHEN "SEX" = 'female' THEN "X_VALUE" END) AS "avg_female",  
       AVG(CASE WHEN "SEX" = 'male'   THEN "X_VALUE" END) AS "avg_male"  
FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"  
WHERE "CELL_TYPE" ILIKE '%epithelial%'  
  AND "CLUSTERS" = '41'  
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'  
GROUP BY "FEATURE_NAME"  
LIMIT 20;
```

```sql
--Description: 9) Calculate the female – male difference in average expression for every gene, keep genes with data in both sexes, and sort by the absolute difference  
SELECT "FEATURE_NAME",  
       AVG(CASE WHEN "SEX" = 'female' THEN "X_VALUE" END)  AS "avg_female",  
       AVG(CASE WHEN "SEX" = 'male'   THEN "X_VALUE" END)  AS "avg_male",  
       AVG(CASE WHEN "SEX" = 'female' THEN "X_VALUE" END)  
       - AVG(CASE WHEN "SEX" = 'male'   THEN "X_VALUE" END)  AS "female_minus_male"  
FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"  
WHERE "CELL_TYPE" ILIKE '%epithelial%'  
  AND "CLUSTERS" = '41'  
  AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'  
GROUP BY "FEATURE_NAME"  
HAVING COUNT(DISTINCT "SEX") = 2  
ORDER BY ABS("female_minus_male") DESC  
LIMIT 20;
```

```sql
--Description: 10) Final query – top 20 genes with the greatest positive female – male average difference  
WITH sex_avg AS (  
    SELECT "FEATURE_NAME",  
           AVG(CASE WHEN "SEX" = 'female' THEN "X_VALUE" END) AS "avg_female",  
           AVG(CASE WHEN "SEX" = 'male'   THEN "X_VALUE" END) AS "avg_male"  
    FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"  
    WHERE "CELL_TYPE" ILIKE '%epithelial%'  
      AND "CLUSTERS" = '41'  
      AND "DEVELOPMENT_STAGE" ILIKE '%74-year-old%'  
    GROUP BY "FEATURE_NAME"  
    HAVING COUNT(DISTINCT "SEX") = 2  
)  
SELECT "FEATURE_NAME",  
       "avg_female",  
       "avg_male",  
       "avg_female" - "avg_male" AS "female_minus_male"  
FROM sex_avg  
ORDER BY "female_minus_male" DESC  
LIMIT 20;
```
