```sql
-- Description: For one ticker (e.g. ETH) calculate previous non-zero volume using a correlated sub-query
SELECT p1."ticker",
       p1."market_date",
       p1."volume"                        AS "raw_volume",
       -- numeric volume for the current day
       CASE
            WHEN p1."volume" = '-'                THEN 0
            WHEN p1."volume" LIKE '%K'            THEN CAST(REPLACE(p1."volume",'K','') AS REAL) * 1000
            WHEN p1."volume" LIKE '%M'            THEN CAST(REPLACE(p1."volume",'M','') AS REAL) * 1000000
            ELSE CAST(p1."volume" AS REAL)
       END                                    AS "volume_num",

       -- numeric volume for the most-recent previous non-zero day
       (
           SELECT
                 CASE
                       WHEN p2."volume" = '-'                THEN 0
                       WHEN p2."volume" LIKE '%K'            THEN CAST(REPLACE(p2."volume",'K','') AS REAL) * 1000
                       WHEN p2."volume" LIKE '%M'            THEN CAST(REPLACE(p2."volume",'M','') AS REAL) * 1000000
                       ELSE CAST(p2."volume" AS REAL)
                 END
           FROM "bitcoin_prices" AS p2
           WHERE p2."ticker"      = p1."ticker"
             AND p2."market_date" < p1."market_date"
             AND p2."market_date" >= '01-08-2021'
             AND p2."market_date" <= '10-08-2021'
             -- exclude zero volumes
             AND p2."volume" <> '-'
           ORDER BY p2."market_date" DESC
           LIMIT 1
       )                                       AS "prev_volume_num"
FROM   "bitcoin_prices" AS p1
WHERE  p1."market_date" BETWEEN '01-08-2021' AND '10-08-2021'
  AND  p1."ticker" = 'ETH'
ORDER  BY p1."market_date"
LIMIT 20;
```

```sql
-- Description: Final query – daily % change in trading volume for every ticker, 
--              1–10 Aug 2021, skipping zero volumes when finding the previous day
SELECT p1."ticker",
       p1."market_date",
       ROUND(
             (
                 curr_vol - prev_vol
             ) * 100.0 / NULLIF(prev_vol,0)
       , 2) AS "pct_change_volume"
FROM (
     SELECT p1."ticker",
            p1."market_date",
            -- current day numeric volume
            CASE
                 WHEN p1."volume" = '-'                THEN 0
                 WHEN p1."volume" LIKE '%K'            THEN CAST(REPLACE(p1."volume",'K','') AS REAL) * 1000
                 WHEN p1."volume" LIKE '%M'            THEN CAST(REPLACE(p1."volume",'M','') AS REAL) * 1000000
                 ELSE CAST(p1."volume" AS REAL)
            END AS curr_vol,

            -- most-recent previous non-zero numeric volume
            (
                SELECT
                      CASE
                            WHEN p2."volume" = '-'                THEN 0
                            WHEN p2."volume" LIKE '%K'            THEN CAST(REPLACE(p2."volume",'K','') AS REAL) * 1000
                            WHEN p2."volume" LIKE '%M'            THEN CAST(REPLACE(p2."volume",'M','') AS REAL) * 1000000
                            ELSE CAST(p2."volume" AS REAL)
                      END
                FROM "bitcoin_prices" AS p2
                WHERE p2."ticker"      = p1."ticker"
                  AND p2."market_date" < p1."market_date"
                  AND p2."market_date" >= '01-08-2021'
                  AND p2."market_date" <= '10-08-2021'
                  AND p2."volume" <> '-'
                ORDER BY p2."market_date" DESC
                LIMIT 1
            ) AS prev_vol
     FROM   "bitcoin_prices" AS p1
     WHERE  p1."market_date" BETWEEN '01-08-2021' AND '10-08-2021'
) 
WHERE prev_vol IS NOT NULL               -- ensure we have a previous day to compare
ORDER BY "ticker", "market_date"
LIMIT 20;
```
