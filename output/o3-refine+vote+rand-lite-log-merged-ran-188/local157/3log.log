--Description:  Calculate the day-over-day percentage change in trading volume for
--              each ticker between 01-Aug-2021 and 10-Aug-2021.
--              • Convert “K” → ×1 000 and “M” → ×1 000 000; treat “-” as 0.
--              • When looking for the “previous” day, choose the most-recent earlier
--                date in that window whose converted volume is > 0.
--              • Return rows only when such a previous value exists, ordering by
--                ticker and date.
SELECT r.ticker,
       r.market_date,
       ROUND( (r.curr_vol - r.prev_vol) * 100.0 / NULLIF(r.prev_vol,0) , 2) AS pct_change_volume
FROM (
        SELECT p1.ticker,
               p1.market_date,

               /* numeric volume for the current day */
               CASE
                    WHEN p1.volume = '-'       THEN 0
                    WHEN p1.volume LIKE '%K'   THEN CAST(REPLACE(p1.volume,'K','') AS REAL) * 1000
                    WHEN p1.volume LIKE '%M'   THEN CAST(REPLACE(p1.volume,'M','') AS REAL) * 1000000
                    ELSE CAST(p1.volume AS REAL)
               END AS curr_vol,

               /* numeric volume for the most-recent previous non-zero day */
               (
                 SELECT CASE
                            WHEN p2.volume = '-'       THEN 0
                            WHEN p2.volume LIKE '%K'   THEN CAST(REPLACE(p2.volume,'K','') AS REAL) * 1000
                            WHEN p2.volume LIKE '%M'   THEN CAST(REPLACE(p2.volume,'M','') AS REAL) * 1000000
                            ELSE CAST(p2.volume AS REAL)
                        END
                 FROM bitcoin_prices AS p2
                 WHERE p2.ticker = p1.ticker
                   AND p2.market_date LIKE '%-08-2021'
                   AND CAST(substr(p2.market_date,1,2) AS INTEGER) BETWEEN 1 AND 10
                   AND p2.market_date < p1.market_date
                   AND (
                         CASE
                              WHEN p2.volume = '-'       THEN 0
                              WHEN p2.volume LIKE '%K'   THEN CAST(REPLACE(p2.volume,'K','') AS REAL) * 1000
                              WHEN p2.volume LIKE '%M'   THEN CAST(REPLACE(p2.volume,'M','') AS REAL) * 1000000
                              ELSE CAST(p2.volume AS REAL)
                         END
                       ) > 0
                 ORDER BY p2.market_date DESC
                 LIMIT 1
               ) AS prev_vol
        FROM bitcoin_prices AS p1
        WHERE p1.market_date LIKE '%-08-2021'
          AND CAST(substr(p1.market_date,1,2) AS INTEGER) BETWEEN 1 AND 10
     ) AS r
WHERE r.prev_vol IS NOT NULL              -- ensure a valid previous value exists
ORDER BY r.ticker, r.market_date;
