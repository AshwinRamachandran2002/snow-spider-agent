Query:
-- 8) Calculate the percentage change between current and previous non-zero volume
SELECT DISTINCT
       q."ticker",
       date(substr(q."market_date",7,4)||'-'||substr(q."market_date",4,2)||'-'||substr(q."market_date",1,2)) AS "iso_date",
       q."volume_now",
       q."volume_prev_non_zero",
       ROUND(
             100.0 * (q."volume_now" - q."volume_prev_non_zero")
             / q."volume_prev_non_zero"
       , 2) AS "pct_change_vs_prev_non_zero"
FROM (
        /* sub-query from step 7 */
        SELECT
               p1."ticker",
               p1."market_date",
               CASE
                    WHEN p1."volume" = '-'  THEN 0
                    WHEN p1."volume" LIKE '%K' THEN CAST(REPLACE(p1."volume",'K','') AS REAL)*1000
                    WHEN p1."volume" LIKE '%M' THEN CAST(REPLACE(p1."volume",'M','') AS REAL)*1000000
                    ELSE CAST(p1."volume" AS REAL)
               END                                                    AS "volume_now",
               (
                  SELECT
                         CASE
                              WHEN p2."volume" = '-'  THEN 0
                              WHEN p2."volume" LIKE '%K' THEN CAST(REPLACE(p2."volume",'K','') AS REAL)*1000
                              WHEN p2."volume" LIKE '%M' THEN CAST(REPLACE(p2."volume",'M','') AS REAL)*1000000
                              ELSE CAST(p2."volume" AS REAL)
                         END
                  FROM   "bitcoin_prices" p2
                  WHERE  p2."ticker" = p1."ticker"
                    AND  date(substr(p2."market_date",7,4)||'-'||substr(p2."market_date",4,2)||'-'||substr(p2."market_date",1,2))
                         <  date(substr(p1."market_date",7,4)||'-'||substr(p1."market_date",4,2)||'-'||substr(p1."market_date",1,2))
                    AND  p2."volume" <> '-'
                    AND  p2."volume" NOT IN ('0','0K','0M')
                  ORDER  BY date(substr(p2."market_date",7,4)||'-'||substr(p2."market_date",4,2)||'-'||substr(p2."market_date",1,2)) DESC
                  LIMIT 1
               )                                                      AS "volume_prev_non_zero"
        FROM   "bitcoin_prices" p1
        WHERE  date(substr(p1."market_date",7,4)||'-'||substr(p1."market_date",4,2)||'-'||substr(p1."market_date",1,2))
               BETWEEN '2021-08-01' AND '2021-08-10'
) q
WHERE  q."volume_prev_non_zero" > 0                       -- avoid divide-by-zero
ORDER  BY q."ticker", "iso_date"
LIMIT 20;
