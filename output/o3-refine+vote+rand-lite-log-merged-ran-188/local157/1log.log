Below is a series of exploratory (and progressively more complex) SQL statements that lead up to the final answer.  
All queries use only the `bitcoin_prices` table, are limited to 20 rows, and include short comments so you can follow the investigation path.

```sql
-- 1) Distinct tickers that appear in the price history
SELECT DISTINCT "ticker"
FROM "bitcoin_prices"
LIMIT 20;
```

```sql
-- 2) Distinct raw market_date values for August-2021 (any day)
SELECT DISTINCT "market_date"
FROM "bitcoin_prices"
WHERE "market_date" LIKE '%-08-2021'
ORDER BY "market_date"
LIMIT 20;
```

```sql
-- 3) Sample of the raw volume strings we have to normalise
SELECT DISTINCT "volume"
FROM "bitcoin_prices"
WHERE "market_date" LIKE '%-08-2021'
LIMIT 20;
```

```sql
-- 4) Convert the volume string to a pure numeric value (thousands / millions handled, "-" → 0)
SELECT DISTINCT
       "ticker",
       "market_date",
       CASE
            WHEN "volume" = '-'                          THEN 0
            WHEN "volume" LIKE '%K'                     THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
            WHEN "volume" LIKE '%M'                     THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
            ELSE CAST("volume" AS REAL)
       END AS "volume_num"
FROM   "bitcoin_prices"
WHERE  "market_date" LIKE '%-08-2021'
LIMIT 20;
```

```sql
-- 5) Also convert day-month-year text into ISO-8601 so dates sort correctly
SELECT DISTINCT
       "ticker",
       date(substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2)) AS "iso_date"
FROM   "bitcoin_prices"
WHERE  "market_date" LIKE '%-08-2021'
ORDER  BY "iso_date"
LIMIT 20;
```

```sql
-- 6) Numeric volume + ISO date restricted to 01-Aug-21 .. 10-Aug-21
SELECT DISTINCT
       "ticker",
       date(substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2)) AS "iso_date",
       CASE
            WHEN "volume" = '-'                          THEN 0
            WHEN "volume" LIKE '%K'                     THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
            WHEN "volume" LIKE '%M'                     THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
            ELSE CAST("volume" AS REAL)
       END AS "volume_num"
FROM   "bitcoin_prices"
WHERE  "iso_date" BETWEEN '2021-08-01' AND '2021-08-10'
LIMIT 20;
```

```sql
-- 7) For each row, pull the most recent *non-zero* volume from any prior day
SELECT DISTINCT
       p1."ticker",
       p1."market_date",
       CASE
            WHEN p1."volume" = '-'  THEN 0
            WHEN p1."volume" LIKE '%K' THEN CAST(REPLACE(p1."volume",'K','') AS REAL)*1000
            WHEN p1."volume" LIKE '%M' THEN CAST(REPLACE(p1."volume",'M','') AS REAL)*1000000
            ELSE CAST(p1."volume" AS REAL)
       END                                                    AS "volume_now",
       (
          SELECT
                 CASE
                      WHEN p2."volume" = '-'  THEN 0
                      WHEN p2."volume" LIKE '%K' THEN CAST(REPLACE(p2."volume",'K','') AS REAL)*1000
                      WHEN p2."volume" LIKE '%M' THEN CAST(REPLACE(p2."volume",'M','') AS REAL)*1000000
                      ELSE CAST(p2."volume" AS REAL)
                 END
          FROM   "bitcoin_prices" p2
          WHERE  p2."ticker" = p1."ticker"
            AND  date(substr(p2."market_date",7,4)||'-'||substr(p2."market_date",4,2)||'-'||substr(p2."market_date",1,2))
                     <  date(substr(p1."market_date",7,4)||'-'||substr(p1."market_date",4,2)||'-'||substr(p1."market_date",1,2))
            AND  p2."volume" <> '-'
          ORDER  BY date(substr(p2."market_date",7,4)||'-'||substr(p2."market_date",4,2)||'-'||substr(p2."market_date",1,2)) DESC
          LIMIT 1
       )                                                      AS "volume_prev_non_zero"
FROM   "bitcoin_prices" p1
WHERE  date(substr(p1."market_date",7,4)||'-'||substr(p1."market_date",4,2)||'-'||substr(p1."market_date",1,2))
       BETWEEN '2021-08-01' AND '2021-08-10'
LIMIT 20;
```

```sql
-- 8) Calculate the percentage change between current and previous non-zero volume
SELECT DISTINCT
       q."ticker",
       date(substr(q."market_date",7,4)||'-'||substr(q."market_date",4,2)||'-'||substr(q."market_date",1,2)) AS "iso_date",
       q."volume_now",
       q."volume_prev_non_zero",
       ROUND(
             100.0 * (q."volume_now" - q."volume_prev_non_zero")
             / q."volume_prev_non_zero"
       , 2) AS "pct_change_vs_prev_non_zero"
FROM (
        /* sub-query from step 7 */
        SELECT
               p1."ticker",
               p1."market_date",
               CASE
                    WHEN p1."volume" = '-'  THEN 0
                    WHEN p1."volume" LIKE '%K' THEN CAST(REPLACE(p1."volume",'K','') AS REAL)*1000
                    WHEN p1."volume" LIKE '%M' THEN CAST(REPLACE(p1."volume",'M','') AS REAL)*1000000
                    ELSE CAST(p1."volume" AS REAL)
               END                                                    AS "volume_now",
               (
                  SELECT
                         CASE
                              WHEN p2."volume" = '-'  THEN 0
                              WHEN p2."volume" LIKE '%K' THEN CAST(REPLACE(p2."volume",'K','') AS REAL)*1000
                              WHEN p2."volume" LIKE '%M' THEN CAST(REPLACE(p2."volume",'M','') AS REAL)*1000000
                              ELSE CAST(p2."volume" AS REAL)
                         END
                  FROM   "bitcoin_prices" p2
                  WHERE  p2."ticker" = p1."ticker"
                    AND  date(substr(p2."market_date",7,4)||'-'||substr(p2."market_date",4,2)||'-'||substr(p2."market_date",1,2))
                         <  date(substr(p1."market_date",7,4)||'-'||substr(p1."market_date",4,2)||'-'||substr(p1."market_date",1,2))
                    AND  p2."volume" <> '-'
                    AND  p2."volume" NOT IN ('0','0K','0M')
                  ORDER  BY date(substr(p2."market_date",7,4)||'-'||substr(p2."market_date",4,2)||'-'||substr(p2."market_date",1,2)) DESC
                  LIMIT 1
               )                                                      AS "volume_prev_non_zero"
        FROM   "bitcoin_prices" p1
        WHERE  date(substr(p1."market_date",7,4)||'-'||substr(p1."market_date",4,2)||'-'||substr(p1."market_date",1,2))
               BETWEEN '2021-08-01' AND '2021-08-10'
) q
WHERE  q."volume_prev_non_zero" > 0                       -- avoid divide-by-zero
ORDER  BY q."ticker", "iso_date"
LIMIT 20;
```

```sql
-- 9) FINAL ANSWER: daily % change in trading volume (Aug-01 to Aug-10, 2021)
SELECT
       q."ticker",
       date(substr(q."market_date",7,4)||'-'||substr(q."market_date",4,2)||'-'||substr(q."market_date",1,2)) AS "iso_date",
       ROUND(
             100.0 * (q."volume_now" - q."volume_prev_non_zero")
             / q."volume_prev_non_zero"
       , 2) AS "pct_change_volume"
FROM (
        /* same sub-query used in step 8, repeated here to keep query self-contained */
        SELECT
               p1."ticker",
               p1."market_date",
               CASE
                    WHEN p1."volume" = '-'  THEN 0
                    WHEN p1."volume" LIKE '%K' THEN CAST(REPLACE(p1."volume",'K','') AS REAL)*1000
                    WHEN p1."volume" LIKE '%M' THEN CAST(REPLACE(p1."volume",'M','') AS REAL)*1000000
                    ELSE CAST(p1."volume" AS REAL)
               END                                                    AS "volume_now",
               (
                  SELECT
                         CASE
                              WHEN p2."volume" = '-'  THEN 0
                              WHEN p2."volume" LIKE '%K' THEN CAST(REPLACE(p2."volume",'K','') AS REAL)*1000
                              WHEN p2."volume" LIKE '%M' THEN CAST(REPLACE(p2."volume",'M','') AS REAL)*1000000
                              ELSE CAST(p2."volume" AS REAL)
                         END
                  FROM   "bitcoin_prices" p2
                  WHERE  p2."ticker" = p1."ticker"
                    AND  date(substr(p2."market_date",7,4)||'-'||substr(p2."market_date",4,2)||'-'||substr(p2."market_date",1,2))
                         <  date(substr(p1."market_date",7,4)||'-'||substr(p1."market_date",4,2)||'-'||substr(p1."market_date",1,2))
                    AND  p2."volume" <> '-'
                    AND  p2."volume" NOT IN ('0','0K','0M')
                  ORDER  BY date(substr(p2."market_date",7,4)||'-'||substr(p2."market_date",4,2)||'-'||substr(p2."market_date",1,2)) DESC
                  LIMIT 1
               )                                                      AS "volume_prev_non_zero"
        FROM   "bitcoin_prices" p1
        WHERE  date(substr(p1."market_date",7,4)||'-'||substr(p1."market_date",4,2)||'-'||substr(p1."market_date",1,2))
               BETWEEN '2021-08-01' AND '2021-08-10'
) q
WHERE  q."volume_prev_non_zero" > 0
ORDER  BY q."ticker", "iso_date"
LIMIT 20;
```

