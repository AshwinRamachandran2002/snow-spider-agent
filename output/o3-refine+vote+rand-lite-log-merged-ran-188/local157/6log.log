--Description: 4) Re-format the date string (dd-mm-yyyy) ➜ ISO style (yyyy-mm-dd) so SQLite can sort chronologically.
SELECT  "ticker",
        "market_date",
        SUBSTR("market_date",7,4) || '-' ||
        SUBSTR("market_date",4,2) || '-' ||
        SUBSTR("market_date",1,2)     AS "iso_date"
FROM    "bitcoin_prices"
