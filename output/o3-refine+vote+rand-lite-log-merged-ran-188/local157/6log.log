```sql
--Description: 2) Quick look at raw rows for the period of interest (Aug-01-2021 → Aug-10-2021).
SELECT  "ticker",
        "market_date",
        "volume"
FROM    "bitcoin_prices"
WHERE   "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER BY "ticker", "market_date"
LIMIT 20;
```

```sql
--Description: 3) Convert the “volume” text into a pure numeric value (K ⇒ ×1 000, M ⇒ ×1 000 000, ‘-’ ⇒ 0).
SELECT  "ticker",
        "market_date",
        "volume",
        CASE
            WHEN "volume" = '-'              THEN 0
            WHEN "volume" LIKE '%K'          THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
            WHEN "volume" LIKE '%M'          THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
            ELSE CAST("volume" AS REAL)
        END AS "volume_num"
FROM    "bitcoin_prices"
WHERE   "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER BY "ticker", "market_date"
LIMIT 20;
```

```sql
--Description: 4) Re-format the date string (dd-mm-yyyy) ➜ ISO style (yyyy-mm-dd) so SQLite can sort chronologically.
SELECT  "ticker",
        "market_date",
        SUBSTR("market_date",7,4) || '-' ||
        SUBSTR("market_date",4,2) || '-' ||
        SUBSTR("market_date",1,2)     AS "iso_date"
FROM    "bitcoin_prices"
WHERE   "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER BY "ticker", "iso_date"
LIMIT 20;
```

```sql
--Description: 5) Show each day’s numeric volume together with the most recent **non-zero** volume from earlier dates.
SELECT  bp1."ticker",
        bp1."market_date",
        CASE
            WHEN bp1."volume" = '-'        THEN 0
            WHEN bp1."volume" LIKE '%K'    THEN CAST(REPLACE(bp1."volume",'K','') AS REAL)*1000
            WHEN bp1."volume" LIKE '%M'    THEN CAST(REPLACE(bp1."volume",'M','') AS REAL)*1000000
            ELSE CAST(bp1."volume" AS REAL)
        END                                       AS "vol_now",
        ( SELECT CASE
                    WHEN bp2."volume" = '-'      THEN 0
                    WHEN bp2."volume" LIKE '%K'  THEN CAST(REPLACE(bp2."volume",'K','') AS REAL)*1000
                    WHEN bp2."volume" LIKE '%M'  THEN CAST(REPLACE(bp2."volume",'M','') AS REAL)*1000000
                    ELSE CAST(bp2."volume" AS REAL)
                 END
          FROM   "bitcoin_prices" bp2
          WHERE  bp2."ticker"      = bp1."ticker"
          AND    (CASE
                    WHEN bp2."volume" = '-'      THEN 0
                    WHEN bp2."volume" LIKE '%K'  THEN CAST(REPLACE(bp2."volume",'K','') AS REAL)*1000
                    WHEN bp2."volume" LIKE '%M'  THEN CAST(REPLACE(bp2."volume",'M','') AS REAL)*1000000
                    ELSE CAST(bp2."volume" AS REAL)
                  END) <> 0                           -- non-zero only
          AND    (SUBSTR(bp2."market_date",7,4) || SUBSTR(bp2."market_date",4,2) || SUBSTR(bp2."market_date",1,2))
               < (SUBSTR(bp1."market_date",7,4) || SUBSTR(bp1."market_date",4,2) || SUBSTR(bp1."market_date",1,2))
          ORDER BY SUBSTR(bp2."market_date",7,4) || SUBSTR(bp2."market_date",4,2) || SUBSTR(bp2."market_date",1,2) DESC
          LIMIT 1
        )                                           AS "prev_non_zero_vol"
FROM    "bitcoin_prices"  bp1
WHERE   bp1."market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER BY bp1."ticker", bp1."market_date"
LIMIT 20;
```

```sql
--Description: 6) Compute the daily % change versus the previous **non-zero** volume.
SELECT  q."ticker",
        q."market_date",
        q."vol_now",
        q."prev_non_zero_vol",
        CASE
            WHEN q."prev_non_zero_vol" IS NULL OR q."prev_non_zero_vol" = 0
                 THEN NULL
            ELSE ROUND( (q."vol_now" - q."prev_non_zero_vol") * 100.0 / q."prev_non_zero_vol", 2 )
        END                                                      AS "pct_change"
FROM   (
        SELECT  bp1."ticker",
                bp1."market_date",
                CASE
                    WHEN bp1."volume" = '-'        THEN 0
                    WHEN bp1."volume" LIKE '%K'    THEN CAST(REPLACE(bp1."volume",'K','') AS REAL)*1000
                    WHEN bp1."volume" LIKE '%M'    THEN CAST(REPLACE(bp1."volume",'M','') AS REAL)*1000000
                    ELSE CAST(bp1."volume" AS REAL)
                END                                               AS "vol_now",
                ( SELECT CASE
                            WHEN bp2."volume" = '-'      THEN 0
                            WHEN bp2."volume" LIKE '%K'  THEN CAST(REPLACE(bp2."volume",'K','') AS REAL)*1000
                            WHEN bp2."volume" LIKE '%M'  THEN CAST(REPLACE(bp2."volume",'M','') AS REAL)*1000000
                            ELSE CAST(bp2."volume" AS REAL)
                         END
                  FROM   "bitcoin_prices" bp2
                  WHERE  bp2."ticker" = bp1."ticker"
                  AND    (CASE
                            WHEN bp2."volume" = '-'      THEN 0
                            WHEN bp2."volume" LIKE '%K'  THEN CAST(REPLACE(bp2."volume",'K','') AS REAL)*1000
                            WHEN bp2."volume" LIKE '%M'  THEN CAST(REPLACE(bp2."volume",'M','') AS REAL)*1000000
                            ELSE CAST(bp2."volume" AS REAL)
                          END) <> 0
                  AND    (SUBSTR(bp2."market_date",7,4) || SUBSTR(bp2."market_date",4,2) || SUBSTR(bp2."market_date",1,2))
                       < (SUBSTR(bp1."market_date",7,4) || SUBSTR(bp1."market_date",4,2) || SUBSTR(bp1."market_date",1,2))
                  ORDER BY SUBSTR(bp2."market_date",7,4) || SUBSTR(bp2."market_date",4,2) || SUBSTR(bp2."market_date",1,2) DESC
                  LIMIT 1
                )                                             AS "prev_non_zero_vol"
        FROM    "bitcoin_prices"  bp1
        WHERE   bp1."market_date" BETWEEN '01-08-2021' AND '10-08-2021'
      ) AS q
ORDER BY q."ticker", q."market_date"
LIMIT 20;
```

```sql
--Description: 7) Final answer – percentage change in trading volume for every ticker from Aug-01-2021 to Aug-10-2021, ordered by ticker & date.
SELECT  q."ticker",
        q."market_date",
        q."vol_now"                                AS "volume_numeric",
        ROUND( (q."vol_now" - q."prev_vol") * 100.0 / q."prev_vol", 2 )  AS "pct_change_vs_prev_non_zero"
FROM   (
        SELECT  bp1."ticker",
                bp1."market_date",
                CASE
                    WHEN bp1."volume" = '-'        THEN 0
                    WHEN bp1."volume" LIKE '%K'    THEN CAST(REPLACE(bp1."volume",'K','') AS REAL)*1000
                    WHEN bp1."volume" LIKE '%M'    THEN CAST(REPLACE(bp1."volume",'M','') AS REAL)*1000000
                    ELSE CAST(bp1."volume" AS REAL)
                END                                                   AS "vol_now",
                ( SELECT CASE
                            WHEN bp2."volume" = '-'      THEN 0
                            WHEN bp2."volume" LIKE '%K'  THEN CAST(REPLACE(bp2."volume",'K','') AS REAL)*1000
                            WHEN bp2."volume" LIKE '%M'  THEN CAST(REPLACE(bp2."volume",'M','') AS REAL)*1000000
                            ELSE CAST(bp2."volume" AS REAL)
                         END
                  FROM   "bitcoin_prices" bp2
                  WHERE  bp2."ticker" = bp1."ticker"
                  AND    (CASE
                            WHEN bp2."volume" = '-'      THEN 0
                            WHEN bp2."volume" LIKE '%K'  THEN CAST(REPLACE(bp2."volume",'K','') AS REAL)*1000
                            WHEN bp2."volume" LIKE '%M'  THEN CAST(REPLACE(bp2."volume",'M','') AS REAL)*1000000
                            ELSE CAST(bp2."volume" AS REAL)
                          END) <> 0
                  AND    (SUBSTR(bp2."market_date",7,4) || SUBSTR(bp2."market_date",4,2) || SUBSTR(bp2."market_date",1,2))
                       < (SUBSTR(bp1."market_date",7,4) || SUBSTR(bp1."market_date",4,2) || SUBSTR(bp1."market_date",1,2))
                  ORDER BY SUBSTR(bp2."market_date",7,4) || SUBSTR(bp2."market_date",4,2) || SUBSTR(bp2."market_date",1,2) DESC
                  LIMIT 1
                )                                                      AS "prev_vol"
        FROM    "bitcoin_prices"  bp1
        WHERE   bp1."market_date" BETWEEN '01-08-2021' AND '10-08-2021'
      ) AS q
WHERE   q."prev_vol" IS NOT NULL
ORDER BY q."ticker", 
         SUBSTR(q."market_date",7,4) || SUBSTR(q."market_date",4,2) || SUBSTR(q."market_date",1,2)
LIMIT 20;
```
