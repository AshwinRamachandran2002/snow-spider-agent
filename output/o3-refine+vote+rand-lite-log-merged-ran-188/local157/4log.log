LIMIT 20;
```

```sql
--Description: Convert the text volume to a pure number for a few sample rows
SELECT "ticker",
       "market_date",
       "volume",
       CASE
            WHEN "volume" = '-'         THEN 0
            WHEN "volume" LIKE '%K'     THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
            WHEN "volume" LIKE '%M'     THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
            ELSE CAST("volume" AS REAL)
       END                               AS "volume_numeric"
FROM   "bitcoin_prices"
WHERE  substr("market_date",4,7) = '08-2021'
  AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
LIMIT 20;
```

```sql
--Description: Add an ISO-formatted date column so ordering is reliable
SELECT "ticker",
       substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2) AS "date_iso",
       CASE
            WHEN "volume" = '-'         THEN 0
            WHEN "volume" LIKE '%K'     THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
            WHEN "volume" LIKE '%M'     THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
            ELSE CAST("volume" AS REAL)
       END                               AS "volume_numeric"
FROM   "bitcoin_prices"
WHERE  substr("market_date",4,7) = '08-2021'
  AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
LIMIT 20;
```

```sql
--Description: Keep only rows whose converted volume is non-zero (needed for “previous day” logic)
SELECT "ticker",
       "date_iso",
       "volume_numeric"
FROM  (
    SELECT "ticker",
           substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2) AS "date_iso",
           CASE
                WHEN "volume" = '-'     THEN 0
                WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
                WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
                ELSE CAST("volume" AS REAL)
           END                         AS "volume_numeric"
    FROM   "bitcoin_prices"
    WHERE  substr("market_date",4,7) = '08-2021'
      AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
) tmp
WHERE "volume_numeric" > 0
LIMIT 20;
```

```sql
--Description: For every day in 1-10 Aug 2021 get the *previous* non-zero volume for the same ticker
SELECT bp1."ticker",
       bp1."date_iso",
       bp1."volume_numeric",
       (
           SELECT bp2."volume_numeric"
           FROM (
               SELECT substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2) AS "date_iso",
                      CASE
                           WHEN "volume" = '-'     THEN 0
                           WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
                           WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
                           ELSE CAST("volume" AS REAL)
                      END                         AS "volume_numeric",
                      "ticker"
               FROM   "bitcoin_prices"
               WHERE  substr("market_date",4,7) = '08-2021'
                 AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
           ) bp2
           WHERE bp2."ticker"     = bp1."ticker"
             AND bp2."volume_numeric" > 0            -- only non-zero volumes
             AND bp2."date_iso"   < bp1."date_iso"   -- strictly before current date
           ORDER BY bp2."date_iso" DESC
           LIMIT 1
       )                                            AS "prev_volume"
FROM  (
     SELECT substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2) AS "date_iso",
            CASE
                 WHEN "volume" = '-'     THEN 0
                 WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
                 WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
                 ELSE CAST("volume" AS REAL)
            END                         AS "volume_numeric",
            "ticker"
     FROM   "bitcoin_prices"
     WHERE  substr("market_date",4,7) = '08-2021'
       AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
) bp1
LIMIT 20;
```

```sql
--Description: Build on the previous step to calculate the daily % change vs. the last non-zero day
SELECT bp1."ticker",
       bp1."date_iso"                                            AS "market_date",
       bp1."volume_numeric"                                      AS "volume",
       bp1."prev_volume",
       CASE
            WHEN bp1."prev_volume" IS NOT NULL
                 THEN ROUND( (bp1."volume_numeric" - bp1."prev_volume")*100.0 / bp1."prev_volume", 2)
       END                                                       AS "pct_change"
FROM (
    SELECT bp_outer."ticker",
           bp_outer."date_iso",
           bp_outer."volume_numeric",
           (
               SELECT bp_inner."volume_numeric"
               FROM (
                   SELECT substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2) AS "date_iso",
                          CASE
                               WHEN "volume" = '-'     THEN 0
                               WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
                               WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
                               ELSE CAST("volume" AS REAL)
                          END                         AS "volume_numeric",
                          "ticker"
                   FROM   "bitcoin_prices"
                   WHERE  substr("market_date",4,7) = '08-2021'
                     AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
               ) bp_inner
               WHERE bp_inner."ticker"           = bp_outer."ticker"
                 AND bp_inner."volume_numeric"   > 0
                 AND bp_inner."date_iso"         < bp_outer."date_iso"
               ORDER BY bp_inner."date_iso" DESC
               LIMIT 1
           ) AS "prev_volume"
    FROM (
        SELECT substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2) AS "date_iso",
               CASE
                    WHEN "volume" = '-'     THEN 0
                    WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
                    WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
                    ELSE CAST("volume" AS REAL)
               END                         AS "volume_numeric",
               "ticker"
        FROM   "bitcoin_prices"
        WHERE  substr("market_date",4,7) = '08-2021'
          AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
    ) bp_outer
) bp1
LIMIT 20;
```

```sql
--Description: FINAL – daily % change in trading volume (1-10 Aug 2021) per ticker, ordered by ticker & date
SELECT bp1."ticker",
       bp1."market_date",
       bp1."volume"           AS "current_volume",
       bp1."prev_volume",
       bp1."pct_change"       AS "pct_change_vs_prev_non_zero_day(%)"
FROM (
    SELECT bp_outer."ticker",
           bp_outer."date_iso"                                  AS "market_date",
           bp_outer."volume_numeric"                            AS "volume",
           (
               SELECT bp_inner."volume_numeric"
               FROM (
                   SELECT substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2) AS "date_iso",
                          CASE
                               WHEN "volume" = '-'     THEN 0
                               WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
                               WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
                               ELSE CAST("volume" AS REAL)
                          END                         AS "volume_numeric",
                          "ticker"
                   FROM   "bitcoin_prices"
                   WHERE  substr("market_date",4,7) = '08-2021'
                     AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
               ) bp_inner
               WHERE bp_inner."ticker"           = bp_outer."ticker"
                 AND bp_inner."volume_numeric"   > 0
                 AND bp_inner."date_iso"         < bp_outer."date_iso"
               ORDER BY bp_inner."date_iso" DESC
               LIMIT 1
           )                                                AS "prev_volume",
           CASE
                WHEN (
                       SELECT bp_inner."volume_numeric"
                       FROM (
                           SELECT substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2) AS "date_iso",
                                  CASE
                                       WHEN "volume" = '-'     THEN 0
                                       WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
                                       WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
                                       ELSE CAST("volume" AS REAL)
                                  END                         AS "volume_numeric",
                                  "ticker"
                           FROM   "bitcoin_prices"
                           WHERE  substr("market_date",4,7) = '08-2021'
                             AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
                       ) bp_inner
                       WHERE bp_inner."ticker"         = bp_outer."ticker"
                         AND bp_inner."volume_numeric" > 0
                         AND bp_inner."date_iso"       < bp_outer."date_iso"
                       ORDER BY bp_inner."date_iso" DESC
                       LIMIT 1
                     ) IS NOT NULL
                THEN ROUND( (bp_outer."volume_numeric" -
                             (
                               SELECT bp_inner."volume_numeric"
                               FROM (
                                   SELECT substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2) AS "date_iso",
                                          CASE
                                               WHEN "volume" = '-'     THEN 0
                                               WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
                                               WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
                                               ELSE CAST("volume" AS REAL)
                                          END                         AS "volume_numeric",
                                          "ticker"
                                   FROM   "bitcoin_prices"
                                   WHERE  substr("market_date",4,7) = '08-2021'
                                     AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
                               ) bp_inner
                               WHERE bp_inner."ticker"         = bp_outer."ticker"
                                 AND bp_inner."volume_numeric" > 0
                                 AND bp_inner."date_iso"       < bp_outer."date_iso"
                               ORDER BY bp_inner."date_iso" DESC
                               LIMIT 1
                             )
                             ) * 100.0 /
                             (
                               SELECT bp_inner."volume_numeric"
                               FROM (
                                   SELECT substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2) AS "date_iso",
                                          CASE
                                               WHEN "volume" = '-'     THEN 0
                                               WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
                                               WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
                                               ELSE CAST("volume" AS REAL)
                                          END                         AS "volume_numeric",
                                          "ticker"
                                   FROM   "bitcoin_prices"
                                   WHERE  substr("market_date",4,7) = '08-2021'
                                     AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
                               ) bp_inner
                               WHERE bp_inner."ticker"         = bp_outer."ticker"
                                 AND bp_inner."volume_numeric" > 0
                                 AND bp_inner."date_iso"       < bp_outer."date_iso"
                               ORDER BY bp_inner."date_iso" DESC
                               LIMIT 1
                             ), 2)
           END                                               AS "pct_change"
    FROM (
        SELECT substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2) AS "date_iso",
               CASE
                    WHEN "volume" = '-'     THEN 0
                    WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
                    WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
                    ELSE CAST("volume" AS REAL)
               END                         AS "volume_numeric",
               "ticker"
        FROM   "bitcoin_prices"
        WHERE  substr("market_date",4,7) = '08-2021'
          AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
    ) bp_outer
) bp1
ORDER BY bp1."ticker", bp1."market_date"
LIMIT 20;
```
