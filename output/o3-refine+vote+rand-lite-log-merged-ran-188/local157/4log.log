Query:
--Description: For every day in 1-10 Aug 2021 get the *previous* non-zero volume for the same ticker
SELECT bp1."ticker",
       bp1."date_iso",
       bp1."volume_numeric",
       (
           SELECT bp2."volume_numeric"
           FROM (
               SELECT substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2) AS "date_iso",
                      CASE
                           WHEN "volume" = '-'     THEN 0
                           WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
                           WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
                           ELSE CAST("volume" AS REAL)
                      END                         AS "volume_numeric",
                      "ticker"
               FROM   "bitcoin_prices"
               WHERE  substr("market_date",4,7) = '08-2021'
                 AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
           ) bp2
           WHERE bp2."ticker"     = bp1."ticker"
             AND bp2."volume_numeric" > 0            -- only non-zero volumes
             AND bp2."date_iso"   < bp1."date_iso"   -- strictly before current date
           ORDER BY bp2."date_iso" DESC
           LIMIT 1
       )                                            AS "prev_volume"
FROM  (
     SELECT substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2) AS "date_iso",
            CASE
                 WHEN "volume" = '-'     THEN 0
                 WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
                 WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
                 ELSE CAST("volume" AS REAL)
            END                         AS "volume_numeric",
            "ticker"
     FROM   "bitcoin_prices"
     WHERE  substr("market_date",4,7) = '08-2021'
       AND  CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
) bp1
LIMIT 20;
