```sql
--Description: Calculate the daily % change in trading volume (100 × (today – prev) / prev) for 01-Aug-2021 → 10-Aug-2021, keeping only rows where both today & previous converted volumes are > 0.
SELECT bp_out."ticker",
       bp_out."market_date",
       ROUND(100.0 * (bp_out.vol_today - bp_out.vol_prev) / bp_out.vol_prev, 2) AS "pct_change_volume"
FROM (
       SELECT bp."ticker",
              bp."market_date",
              CASE
                  WHEN bp."volume" LIKE '%K' THEN CAST(REPLACE(bp."volume",'K','') AS REAL) * 1000
                  WHEN bp."volume" LIKE '%M' THEN CAST(REPLACE(bp."volume",'M','') AS REAL) * 1000000
                  ELSE CAST(bp."volume" AS REAL)
              END AS vol_today,
              (
                SELECT CASE
                         WHEN bp2."volume" LIKE '%K' THEN CAST(REPLACE(bp2."volume",'K','') AS REAL) * 1000
                         WHEN bp2."volume" LIKE '%M' THEN CAST(REPLACE(bp2."volume",'M','') AS REAL) * 1000000
                         ELSE CAST(bp2."volume" AS REAL)
                       END
                FROM   "bitcoin_prices" bp2
                WHERE  bp2."ticker"      = bp."ticker"
                  AND  bp2."market_date" < bp."market_date"
                ORDER  BY bp2."market_date" DESC
                LIMIT 1
              ) AS vol_prev
       FROM   "bitcoin_prices" bp
       WHERE  bp."market_date" BETWEEN '01-08-2021' AND '10-08-2021'
     ) bp_out
WHERE bp_out.vol_today > 0
  AND  bp_out.vol_prev  > 0
ORDER BY bp_out."ticker",
         bp_out."market_date"
LIMIT 20;
```

```sql
--Description: Present the final %-change result set for every row from 01-Aug-2021 to 10-Aug-2021, ordered by ticker then date (same logic as previous query, no dash-specific filters).
