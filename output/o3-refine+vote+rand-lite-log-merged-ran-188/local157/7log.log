```sql
--Description: Demonstrate converting the “volume” text into a pure numeric value (thousands / millions handled,
--‘-’ ⇒ 0) just for 01-Aug-2021 so we can confirm the logic.
SELECT "ticker",
       "market_date",
       "volume",
       CASE
           WHEN "volume" = '-'                          THEN 0
           WHEN "volume" LIKE '%K'                      THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
           WHEN "volume" LIKE '%M'                      THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
           ELSE CAST("volume" AS REAL)
       END AS "volume_numeric"
FROM   "bitcoin_prices"
WHERE  "market_date" = '01-08-2021'
LIMIT 20;
```

```sql
--Description: Apply the same numeric-volume conversion to every row from 01-Aug-2021 through 10-Aug-2021
--so we can visually check a handful of tickers and dates.
SELECT "ticker",
       "market_date",
       "volume",
       CASE
           WHEN "volume" = '-'                          THEN 0
           WHEN "volume" LIKE '%K'                      THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
           WHEN "volume" LIKE '%M'                      THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
           ELSE CAST("volume" AS REAL)
       END AS "volume_numeric"
FROM   "bitcoin_prices"
WHERE  "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER  BY "ticker",
          "market_date"
LIMIT 20;
```

```sql
--Description: For each ticker within 01-Aug-2021 to 10-Aug-2021, bring forward the most recent previous NON-ZERO
--volume (using a correlated sub-query) so we can later calculate day-to-day % change correctly.
SELECT bp1."ticker",
       bp1."market_date",
       CASE
           WHEN bp1."volume" = '-'                      THEN 0
           WHEN bp1."volume" LIKE '%K'                  THEN CAST(REPLACE(bp1."volume",'K','') AS REAL) * 1000
           WHEN bp1."volume" LIKE '%M'                  THEN CAST(REPLACE(bp1."volume",'M','') AS REAL) * 1000000
           ELSE CAST(bp1."volume" AS REAL)
       END AS "vol_today",
       (
         SELECT
           CASE
               WHEN bp2."volume" = '-'                  THEN 0
               WHEN bp2."volume" LIKE '%K'              THEN CAST(REPLACE(bp2."volume",'K','') AS REAL) * 1000
               WHEN bp2."volume" LIKE '%M'              THEN CAST(REPLACE(bp2."volume",'M','') AS REAL) * 1000000
               ELSE CAST(bp2."volume" AS REAL)
           END
         FROM "bitcoin_prices" bp2
         WHERE bp2."ticker"      = bp1."ticker"
           AND bp2."market_date" < bp1."market_date"
           AND bp2."volume" NOT IN ('-', '0')
         ORDER BY bp2."market_date" DESC
         LIMIT 1
       )                                               AS "vol_prev_non_zero"
FROM   "bitcoin_prices" bp1
WHERE  bp1."market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER  BY bp1."ticker",
          bp1."market_date"
LIMIT 20;
```

```sql
--Description: Calculate the actual daily % change in trading volume, ignoring days where today’s volume or the
--previous non-zero volume is zero.  (100 * (today – prev) / prev).
SELECT bp1."ticker",
       bp1."market_date",
       ROUND(100.0 * (vol_today - vol_prev) / vol_prev, 2) AS "pct_change_volume"
FROM  (
        SELECT bp."ticker",
               bp."market_date",
               CASE
                   WHEN bp."volume" = '-'               THEN 0
                   WHEN bp."volume" LIKE '%K'           THEN CAST(REPLACE(bp."volume",'K','') AS REAL) * 1000
                   WHEN bp."volume" LIKE '%M'           THEN CAST(REPLACE(bp."volume",'M','') AS REAL) * 1000000
                   ELSE CAST(bp."volume" AS REAL)
               END AS vol_today,
               (
                 SELECT
                   CASE
                       WHEN bp2."volume" = '-'          THEN 0
                       WHEN bp2."volume" LIKE '%K'      THEN CAST(REPLACE(bp2."volume",'K','') AS REAL) * 1000
                       WHEN bp2."volume" LIKE '%M'      THEN CAST(REPLACE(bp2."volume",'M','') AS REAL) * 1000000
                       ELSE CAST(bp2."volume" AS REAL)
                   END
                 FROM "bitcoin_prices" bp2
                 WHERE bp2."ticker"      = bp."ticker"
                   AND bp2."market_date" < bp."market_date"
                   AND bp2."volume" NOT IN ('-', '0')
                 ORDER BY bp2."market_date" DESC
                 LIMIT 1
               )                                       AS vol_prev
        FROM  "bitcoin_prices" bp
        WHERE bp."market_date" BETWEEN '01-08-2021' AND '10-08-2021'
      ) bp1
WHERE vol_today <> 0
  AND vol_prev  <> 0
ORDER BY bp1."ticker",
         bp1."market_date"
LIMIT 20;
```

