Query:
--Description: Calculate daily % change in volume versus the most recent previous NON-ZERO volume for 1–10 Aug 2021
WITH conv AS (
  SELECT "ticker",
         "market_date",
         CASE
             WHEN "volume" = '-'      THEN 0
             WHEN "volume" LIKE '%K'  THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
             WHEN "volume" LIKE '%M'  THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
             ELSE CAST("volume" AS REAL)
         END AS vol_num
  FROM   "bitcoin_prices"
  WHERE  "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
),
ranked AS (
  SELECT c1."ticker",
         c1."market_date",
         c1.vol_num,
         (
           SELECT c2.vol_num
           FROM   conv AS c2
           WHERE  c2."ticker"      = c1."ticker"
             AND  c2."market_date" < c1."market_date"
             AND  c2.vol_num       > 0
           ORDER  BY date(substr(c2."market_date",7,4)||'-'||substr(c2."market_date",4,2)||'-'||substr(c2."market_date",1,2)) DESC
           LIMIT 1
         ) AS prev_nonzero_vol
  FROM   conv AS c1
)
SELECT DISTINCT
       "ticker",
       "market_date",
       vol_num                         AS current_volume,
       prev_nonzero_vol                AS previous_non_zero_volume,
       CASE
           WHEN prev_nonzero_vol IS NULL
                OR prev_nonzero_vol = 0 THEN NULL
           ELSE ROUND(100.0 * (vol_num - prev_nonzero_vol) / prev_nonzero_vol, 2)
       END                            AS pct_change_vs_prev_non_zero
FROM   ranked
ORDER  BY "ticker",
          date(substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2))
LIMIT  20
