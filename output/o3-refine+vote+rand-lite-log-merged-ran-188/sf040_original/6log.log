[{'ADDRESS_ID': 'addressId/dc300a05308812315403177f94140723', 'ID_ZIP': 'zip/76435', 'ID_CITY': 'geoId/4812736', 'ID_STATE': 'geoId/48', 'ID_COUNTRY': 'country/USA', 'LONGITUDE': -98.8322983, 'LATITUDE': 32.2707423, 'NUMBER': '307', 'STREET_DIRECTIONAL_PREFIX': 'W', 'STREET': 'Anthracite', 'STREET_TYPE': 'Street', 'STREET_DIRECTIONAL_SUFFIX': None, 'UNIT': None, 'CITY': 'Carbon', 'STATE': 'TX', 'ZIP': '76435'}, {'ADDRESS_ID': 'addressId/ae15ac2c134974f5599c7f16d391e061', 'ID_ZIP': 'zip/37042', 'ID_CITY': 'geoId/4715160', 'ID_STATE': 'geoId/47', 'ID_COUNTRY': 'country/USA', 'LONGITUDE': -87.4201814, 'LATITUDE': 36.5539342, 'NUMBER': '580', 'STREET_DIRECTIONAL_PREFIX': None, 'STREET': 'Cabot', 'STREET_TYPE': 'Cove', 'STREET_DIRECTIONAL_SUFFIX': None, 'UNIT': None, 'CITY': 'Clarksville', 'STATE': 'TN', 'ZIP': '37042'}, {'ADDRESS_ID': 'addressId/a190cfd4c9532b7c48dbbff6b1b37cbb', 'ID_ZIP': 'zip/46360', 'ID_CITY': 'geoId/1848798', 'ID_STATE': 'geoId/18', 'ID_COUNTRY': 'country/USA', 'LONGITUDE': -86.8169273, 'LATITUDE': 41.7393496, 'NUMBER': '9076', 'STREET_DIRECTIONAL_PREFIX': 'N', 'STREET': 'Meer', 'STREET_TYPE': 'Road', 'STREET_DIRECTIONAL_SUFFIX': None, 'UNIT': None, 'CITY': 'Michigan City', 'STATE': 'IN', 'ZIP': '46360'}, {'ADDRESS_ID': 'addressId/99310c1543cf71878b132c6f023a996b', 'ID_ZIP': 'zip/33033', 'ID_CITY': 'geoId/1232275', 'ID_STATE': 'geoId/12', 'ID_COUNTRY': 'country/USA', 'LONGITUDE': -80.4261244, 'LATITUDE': 25.4701136, 'NUMBER': '3429', 'STREET_DIRECTIONAL_PREFIX': 'SE', 'STREET': '1', 'STREET_TYPE': 'Street', 'STREET_DIRECTIONAL_SUFFIX': None, 'UNIT': None, 'CITY': 'Homestead', 'STATE': 'FL', 'ZIP': '33033'}, {'ADDRESS_ID': 'addressId/18378472fd4ba829589c6b52e7440339', 'ID_ZIP': 'zip/91103', 'ID_CITY': 'geoId/0656000', 'ID_STATE': 'geoId/06', 'ID_COUNTRY': 'country/USA', 'LONGITUDE': -118.1534279, 'LATITUDE': 34.1730104, 'NUMBER': '1582', 'STREET_DIRECTIONAL_PREFIX': None, 'STREET': 'Navarro', 'STREET_TYPE': 'Avenue', 'STREET_DIRECTIONAL_SUFFIX': None