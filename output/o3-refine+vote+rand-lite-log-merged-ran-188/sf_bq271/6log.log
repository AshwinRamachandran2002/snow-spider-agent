```sql
--Description: Quick look at 2021 order records – see time-stamp values, order / user linkage
SELECT 
  "order_id",
  "user_id",
  "status",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "created_at" BETWEEN 1609459200000000 AND 1640995199000000  -- 2021-01-01 00:00:00 to 2021-12-31 23:59:59 µs
LIMIT 20;
```

```sql
--Description: Inspect users who registered during 2021 (check country / state columns)
SELECT 
  "id"            AS "user_id",
  "country",
  "state",
  "city",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
--Description: Peek at inventory items created in 2021 and their distribution center & product link
SELECT 
  "id"                             AS "inventory_item_id",
  "product_id",
  "product_distribution_center_id",
  "created_at",
  "sold_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
WHERE "created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
--Description: Review product master data (cost / retail price / department / category) 
SELECT 
  "id"            AS "product_id",
  "name",
  "department",
  "category",
  "cost",
  "retail_price",
  "distribution_center_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
LIMIT 20;
```

```sql
--Description: Sample join – pull a handful of 2021 order items with their product & inventory details
SELECT 
  oi."id"                 AS "order_item_id",
  oi."order_id",
  oi."user_id",
  oi."product_id",
  oi."inventory_item_id",
  oi."sale_price",
  ii."created_at"         AS "inventory_created_at",
  p."department",
  p."category",
  p."cost",
  p."retail_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"   ii ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"          p  ON oi."product_id"        = p."id"
WHERE oi."created_at" BETWEEN 1609459200000000 AND 1640995199000000   -- order items in 2021
LIMIT 20;
```

```sql
--Description: Distinct list of (country, department, category) combinations involved in 2021 orders
SELECT DISTINCT
  u."country",
  p."department",
  p."category"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p  ON oi."product_id" = p."id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
--Description: Count monthly 2021 orders placed by users who also registered in 2021
SELECT 
  TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1e6), 'YYYY-MM')  AS "order_month",
  COUNT(*)                                                  AS "orders_2021_new_users"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"  u ON o."user_id" = u."id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995199000000
  AND u."created_at" BETWEEN 1609459200000000 AND 1640995199000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Verify how many 2021 inventory items are linked to 2021 order items
SELECT 
  COUNT(DISTINCT oi."inventory_item_id") AS "distinct_inventory_items",
  COUNT(*)                               AS "total_order_items"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii ON oi."inventory_item_id" = ii."id"
WHERE oi."created_at" BETWEEN 1609459200000000 AND 1640995199000000
  AND ii."created_at" BETWEEN 1609459200000000 AND 1640995199000000;
```

```sql
--Description: Compute monthly profit (retail − cost) for a single country (e.g., 'United States') as a sanity check
SELECT 
  TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1e6), 'YYYY-MM')          AS "order_month",
  SUM(p."retail_price") - SUM(p."cost")                             AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u  ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p  ON oi."product_id" = p."id"
WHERE o."created_at"  BETWEEN 1609459200000000 AND 1640995199000000
  AND u."created_at"  BETWEEN 1609459200000000 AND 1640995199000000
  AND ii."created_at" BETWEEN 1609459200000000 AND 1640995199000000
  AND u."country" ILIKE '%United%States%'
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Full grain verification – 2021 records grouped by country, department, category & month (no profit yet)
SELECT 
  TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1e6), 'YYYY-MM') AS "order_month",
  u."country",
  p."department",
  p."category",
  COUNT(*)                                                 AS "order_cnt",
  COUNT(DISTINCT o."user_id")                              AS "unique_purchasers"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u  ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p  ON oi."product_id" = p."id"
WHERE o."created_at"  BETWEEN 1609459200000000 AND 1640995199000000
  AND u."created_at"  BETWEEN 1609459200000000 AND 1640995199000000
  AND ii."created_at" BETWEEN 1609459200000000 AND 1640995199000000
GROUP BY 1,2,3,4
ORDER BY 1,2,3,4
LIMIT 20;
```
