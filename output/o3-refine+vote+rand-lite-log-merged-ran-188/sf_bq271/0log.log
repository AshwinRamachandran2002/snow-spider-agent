```sql
--Description: Inspect a few columns of USERS and convert the micro-second epoch to a readable date  
SELECT 
  "id", 
  "country", 
  "created_at", 
  TO_TIMESTAMP_NTZ("created_at"/1e6)     AS "created_at_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
LIMIT 20;
```

```sql
--Description: List the distinct registration years that appear in USERS  
SELECT DISTINCT 
  YEAR(TO_TIMESTAMP_NTZ("created_at"/1e6))  AS "user_year"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
ORDER BY "user_year"
LIMIT 20;
```

```sql
--Description: Check a sample of ORDERS with a readable order-date and status  
SELECT 
  "order_id", 
  "user_id", 
  "status", 
  "created_at", 
  TO_TIMESTAMP_NTZ("created_at"/1e6)        AS "order_date"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
LIMIT 20;
```

```sql
--Description: Inspect INVENTORY_ITEMS and convert both created_at & sold_at to dates  
SELECT 
  "id", 
  "product_department", 
  "product_category", 
  "cost", 
  "product_retail_price", 
  "created_at", 
  TO_TIMESTAMP_NTZ("created_at"/1e6)        AS "inv_created_date"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
LIMIT 20;
```

```sql
--Description: Confirm which years appear in INVENTORY_ITEMS records  
SELECT DISTINCT 
  YEAR(TO_TIMESTAMP_NTZ("created_at"/1e6))  AS "inv_item_year"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
ORDER BY "inv_item_year"
LIMIT 20;
```

```sql
--Description: Pull 2021 orders placed by users that also registered in 2021  
SELECT 
  o."order_id", 
  o."user_id", 
  TO_TIMESTAMP_NTZ(o."created_at"/1e6)      AS "order_date", 
  u."country"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"  o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"   u
     ON o."user_id" = u."id"
WHERE YEAR(TO_TIMESTAMP_NTZ(o."created_at"/1e6))  = 2021
  AND YEAR(TO_TIMESTAMP_NTZ(u."created_at"/1e6))  = 2021
LIMIT 20;
```

```sql
--Description: Join the above 2021 scope with ORDER_ITEMS and INVENTORY_ITEMS from 2021  
SELECT 
  oi."order_id",
  oi."inventory_item_id",
  inv."product_department",
  inv."product_category",
  inv."product_retail_price",
  inv."cost",
  u."country"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"        oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"              o   ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"               u   ON o."user_id"   = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"     inv ON oi."inventory_item_id" = inv."id"
WHERE YEAR(TO_TIMESTAMP_NTZ(o."created_at"/1e6))  = 2021
  AND YEAR(TO_TIMESTAMP_NTZ(u."created_at"/1e6))  = 2021
  AND YEAR(TO_TIMESTAMP_NTZ(inv."created_at"/1e6))= 2021
LIMIT 20;
```

```sql
--Description: Aggregate the joined data to compute profit & counts per month, country, department & category  
SELECT 
  DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at"/1e6))           AS "order_month",
  u."country",
  inv."product_department",
  inv."product_category",
  COUNT(DISTINCT o."order_id")                                        AS "num_orders",
  COUNT(DISTINCT o."user_id")                                         AS "unique_purchasers",
  SUM(inv."product_retail_price" - inv."cost")                        AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"        oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"              o   ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"               u   ON o."user_id"   = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"     inv ON oi."inventory_item_id" = inv."id"
WHERE YEAR(TO_TIMESTAMP_NTZ(o."created_at"/1e6))   = 2021
  AND YEAR(TO_TIMESTAMP_NTZ(u."created_at"/1e6))   = 2021
  AND YEAR(TO_TIMESTAMP_NTZ(inv."created_at"/1e6)) = 2021
GROUP BY 
  "order_month",
  u."country",
  inv."product_department",
  inv."product_category"
LIMIT 20;
```

```sql
--Description: Same as above but showing both the retail & cost totals that drive profit  
SELECT 
  DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at"/1e6))           AS "order_month",
  u."country",
  inv."product_department",
  inv."product_category",
  COUNT(DISTINCT o."order_id")                                        AS "num_orders",
  COUNT(DISTINCT o."user_id")                                         AS "unique_purchasers",
  SUM(inv."product_retail_price")                                     AS "total_retail",
  SUM(inv."cost")                                                    AS "total_cost",
  SUM(inv."product_retail_price" - inv."cost")                        AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"        oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"              o   ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"               u   ON o."user_id"   = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"     inv ON oi."inventory_item_id" = inv."id"
WHERE YEAR(TO_TIMESTAMP_NTZ(o."created_at"/1e6))   = 2021
  AND YEAR(TO_TIMESTAMP_NTZ(u."created_at"/1e6))   = 2021
  AND YEAR(TO_TIMESTAMP_NTZ(inv."created_at"/1e6)) = 2021
GROUP BY 
  "order_month",
  u."country",
  inv."product_department",
  inv."product_category"
LIMIT 20;
```

