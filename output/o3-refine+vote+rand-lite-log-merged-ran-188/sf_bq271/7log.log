LIMIT 20;
```

```sql
--Description: Review product attributes that will be used for profit calculation
SELECT 
  "id"              AS "product_id",
  "name",
  "department",
  "category",
  "cost",
  "retail_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
LIMIT 20;
```

```sql
--Description: Join order items to their inventory items that were stocked in 2021
SELECT 
  oi."id"                    AS "order_item_id",
  oi."order_id",
  oi."product_id",
  ii."id"                    AS "inventory_item_id",
  ii."created_at"            AS "inventory_created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
  ON oi."inventory_item_id" = ii."id"
WHERE ii."created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: Combine 2021 orders with 2021-registered users (no inventory filter yet)
SELECT DISTINCT
  o."order_id",
  o."user_id",
  u."country",
  o."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"  o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"   u
  ON o."user_id" = u."id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995200000000
  AND u."created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: Preview profit component per line by tying everything together for 2021 constraints
SELECT 
  o."order_id",
  o."created_at"                     AS "order_ts",
  u."country",
  p."department",
  p."category",
  p."retail_price"  - p."cost"       AS "profit_per_item"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o  ON oi."order_id"          = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"         u  ON o."user_id"            = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p  ON oi."product_id"        = p."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii ON oi."inventory_item_id" = ii."id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995200000000     -- order in 2021
  AND u."created_at" BETWEEN 1609459200000000 AND 1640995200000000     -- user joined 2021
  AND ii."created_at" BETWEEN 1609459200000000 AND 1640995200000000    -- item stocked 2021
LIMIT 20;
```

```sql
--Description: Aggregate to find number of orders, distinct purchasers, and total profit by country/department/category per month in 2021
SELECT
  TO_CHAR(TO_TIMESTAMP("order_ts"/1000000), 'YYYY-MM')            AS "order_month",
  "country",
  "department",
  "category",
  COUNT(DISTINCT "order_id")                                       AS "num_orders",
  COUNT(DISTINCT "user_id")                                        AS "unique_purchasers",
  SUM("profit_per_item")                                           AS "total_profit"
FROM (
  SELECT 
    o."order_id",
    o."user_id",
    o."created_at"                        AS "order_ts",
    u."country",
    p."department",
    p."category",
    p."retail_price" - p."cost"           AS "profit_per_item"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o   ON oi."order_id"          = o."order_id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u   ON o."user_id"            = u."id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p   ON oi."product_id"        = p."id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii  ON oi."inventory_item_id" = ii."id"
  WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995200000000
    AND u."created_at" BETWEEN 1609459200000000 AND 1640995200000000
    AND ii."created_at" BETWEEN 1609459200000000 AND 1640995200000000
) as sub
GROUP BY 
  TO_CHAR(TO_TIMESTAMP("order_ts"/1000000), 'YYYY-MM'),
  "country",
  "department",
  "category"
ORDER BY 
  "order_month",
  "country",
  "department",
  "category"
LIMIT 20;
```

```sql
--Description: Same aggregation as above but with roll-up subtotals (country / department / category) for 2021 overview
SELECT
  TO_CHAR(TO_TIMESTAMP("order_ts"/1000000), 'YYYY-MM')  AS "order_month",
  "country",
  "department",
  "category",
  COUNT(DISTINCT "order_id")                            AS "num_orders",
  COUNT(DISTINCT "user_id")                             AS "unique_purchasers",
  SUM("profit_per_item")                                AS "total_profit"
FROM (
  SELECT 
    o."order_id",
    o."user_id",
    o."created_at"                      AS "order_ts",
    u."country",
    p."department",
    p."category",
    p."retail_price" - p."cost"         AS "profit_per_item"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o   ON oi."order_id"          = o."order_id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u   ON o."user_id"            = u."id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p   ON oi."product_id"        = p."id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii  ON oi."inventory_item_id" = ii."id"
  WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995200000000
    AND u."created_at" BETWEEN 1609459200000000 AND 1640995200000000
    AND ii."created_at" BETWEEN 1609459200000000 AND 1640995200000000
) sub
GROUP BY ROLLUP (
  TO_CHAR(TO_TIMESTAMP("order_ts"/1000000), 'YYYY-MM'),
  "country",
  "department",
  "category"
)
ORDER BY 
  "order_month" NULLS LAST,
  "country"     NULLS LAST,
  "department"  NULLS LAST,
  "category"    NULLS LAST
LIMIT 20;
```

```sql
--Description: Final compact query exactly answering the task (no LIMIT) — keep for production use
SELECT
  TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM')               AS "order_month",
  u."country",
  p."department",
  p."category",
  COUNT(DISTINCT o."order_id")                                           AS "num_orders",
  COUNT(DISTINCT u."id")                                                 AS "unique_purchasers",
  SUM(p."retail_price" - p."cost")                                       AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o  ON oi."order_id"          = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u  ON o."user_id"            = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p  ON oi."product_id"        = p."id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995200000000
  AND u."created_at" BETWEEN 1609459200000000 AND 1640995200000000
  AND ii."created_at" BETWEEN 1609459200000000 AND 1640995200000000
GROUP BY 
  TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM'),
  u."country",
  p."department",
  p."category"
ORDER BY 
  "order_month",
  "country",
  "department",
  "category";
```
