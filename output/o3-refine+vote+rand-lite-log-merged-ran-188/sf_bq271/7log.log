Query:
--Description: Same aggregation as above but with roll-up subtotals (country / department / category) for 2021 overview
SELECT
  TO_CHAR(TO_TIMESTAMP("order_ts"/1000000), 'YYYY-MM')  AS "order_month",
  "country",
  "department",
  "category",
  COUNT(DISTINCT "order_id")                            AS "num_orders",
  COUNT(DISTINCT "user_id")                             AS "unique_purchasers",
  SUM("profit_per_item")                                AS "total_profit"
FROM (
  SELECT 
    o."order_id",
    o."user_id",
    o."created_at"                      AS "order_ts",
    u."country",
    p."department",
    p."category",
    p."retail_price" - p."cost"         AS "profit_per_item"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o   ON oi."order_id"          = o."order_id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u   ON o."user_id"            = u."id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p   ON oi."product_id"        = p."id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii  ON oi."inventory_item_id" = ii."id"
  WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995200000000
    AND u."created_at" BETWEEN 1609459200000000 AND 1640995200000000
    AND ii."created_at" BETWEEN 1609459200000000 AND 1640995200000000
) sub
GROUP BY ROLLUP (
  TO_CHAR(TO_TIMESTAMP("order_ts"/1000000), 'YYYY-MM'),
  "country",
  "department",
  "category"
)
ORDER BY 
  "order_month" NULLS LAST,
  "country"     NULLS LAST,
  "department"  NULLS LAST,
  "category"    NULLS LAST
LIMIT 20;
