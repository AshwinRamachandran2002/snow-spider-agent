--Description: Prototype aggregation (limited to 20 rows) showing
--orders, unique purchasers and profit grouped by country, department and category
--for 2021 orders from 2021 users and 2021 inventory items.
SELECT
       u."country",
       p."department",
       p."category",
       COUNT(DISTINCT o."order_id")                 AS "num_orders",
       COUNT(DISTINCT o."user_id")                  AS "unique_purchasers",
       SUM(p."retail_price" - p."cost")             AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"         u
     ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
     ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
     ON i."id" = oi."inventory_item_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
     ON p."id" = i."product_id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995200000000
  AND u."created_at" BETWEEN 1609459200000000 AND 1640995200000000
  AND i."created_at" BETWEEN 1609459200000000 AND 1640995200000000
GROUP BY u."country", p."department", p."category"
LIMIT 20;
