```sql
--Description: Sample of users who registered during 2021 (micro-seconds epoch),
--showing the user id, country and created_at timestamp value.
SELECT DISTINCT 
       "id",
       "country",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: Sample of orders placed during 2021, displaying the order id,
--user id, status and created_at value.
SELECT DISTINCT
       "order_id",
       "user_id",
       "status",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: A quick look at orders from users who also registered in 2021.
SELECT DISTINCT
       o."order_id",
       o."user_id",
       u."country",
       o."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"  o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"   u
     ON o."user_id" = u."id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995200000000
  AND u."created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: Sample of inventory items that were created in 2021
--along with the related product id and distribution center.
SELECT DISTINCT
       "id"               AS "inventory_item_id",
       "product_id",
       "product_distribution_center_id",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
WHERE "created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: View a few products (id, department, category, retail price, cost)
--that can be joined to inventory items.
SELECT DISTINCT
       "id"           AS "product_id",
       "department",
       "category",
       "retail_price",
       "cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
LIMIT 20;
```

```sql
--Description: Sample order items tied to orders created in 2021,
--displaying the inventory item id and product id.
SELECT DISTINCT
       oi."id"                 AS "order_item_id",
       oi."order_id",
       oi."inventory_item_id",
       oi."product_id",
       oi."status",
       oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
     ON oi."order_id" = o."order_id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: Distinct list of countries for users who registered in 2021
--and have at least one 2021 order.
SELECT DISTINCT
       u."country"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"  u
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
     ON o."user_id" = u."id"
WHERE u."created_at" BETWEEN 1609459200000000 AND 1640995200000000
  AND o."created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: Distinct product departments & categories that appear
--in inventory items created during 2021.
SELECT DISTINCT
       p."department",
       p."category"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
     ON i."product_id" = p."id"
WHERE i."created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: Quick profit check on a handful of records:
--retail minus cost for inventory items created in 2021 and later sold
--(i.e., sold_at not null).
SELECT DISTINCT
       i."id"                         AS "inventory_item_id",
       p."retail_price" - p."cost"    AS "profit_per_unit",
       i."sold_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
     ON i."product_id" = p."id"
WHERE i."created_at" BETWEEN 1609459200000000 AND 1640995200000000
  AND i."sold_at" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Prototype aggregation (limited to 20 rows) showing
--orders, unique purchasers and profit grouped by country, department and category
--for 2021 orders from 2021 users and 2021 inventory items.
SELECT
       u."country",
       p."department",
       p."category",
       COUNT(DISTINCT o."order_id")                 AS "num_orders",
       COUNT(DISTINCT o."user_id")                  AS "unique_purchasers",
       SUM(p."retail_price" - p."cost")             AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"         u
     ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
     ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
     ON i."id" = oi."inventory_item_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
     ON p."id" = i."product_id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995200000000
  AND u."created_at" BETWEEN 1609459200000000 AND 1640995200000000
  AND i."created_at" BETWEEN 1609459200000000 AND 1640995200000000
GROUP BY u."country", p."department", p."category"
LIMIT 20;
```
