```sql
--Description: Preview a few orders that were placed during calendar-year 2021
SELECT 
  "order_id",
  "user_id",
  "status",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
--Description: Check which users registered during 2021
SELECT 
  "id"          AS "user_id",
  "first_name",
  "last_name",
  "country",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
--Description: View inventory items that were created in 2021
SELECT 
  "id"                               AS "inventory_item_id",
  "product_id",
  "product_distribution_center_id",
  "created_at",
  "product_department",
  "product_category",
  "product_retail_price",
  "cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
WHERE "created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
--Description: Inspect products to capture department and category information
SELECT DISTINCT 
  "id"            AS "product_id",
  "department",
  "category",
  "retail_price",
  "cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
LIMIT 20;
```

```sql
--Description: Identify order-items tied to 2021 orders (before filtering by user or inventory year)
SELECT 
  "id"                 AS "order_item_id",
  "order_id",
  "product_id",
  "inventory_item_id",
  "status",
  "created_at",
  "sale_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
WHERE "created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
--Description: Join orders (2021) with users (registered 2021) to get purchaser country list
SELECT DISTINCT
  o."order_id",
  u."country"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
     ON o."user_id" = u."id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995199000000
  AND u."created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
--Description: Link order-items (2021) with inventory items that were created in 2021
SELECT 
  oi."order_id",
  oi."inventory_item_id",
  ii."product_department",
  ii."product_category",
  ii."product_retail_price",
  ii."cost",
  ii."created_at"      AS "inventory_created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
     ON oi."inventory_item_id" = ii."id"
WHERE oi."created_at" BETWEEN 1609459200000000 AND 1640995199000000
  AND ii."created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
--Description: Sample profit calculation (retail minus cost) for one month (January 2021) before full aggregation
SELECT 
  oi."order_id",
  (ii."product_retail_price" - ii."cost") AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
     ON oi."inventory_item_id" = ii."id"
WHERE oi."created_at" BETWEEN 1609459200000000 AND 1612137599000000   -- 2021-01-01 thru 2021-01-31
  AND ii."created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
--Description: Bring everything together: orders in 2021, users registered 2021, inventory created 2021, aggregate by month / country / department / category
SELECT 
  TO_CHAR(TO_TIMESTAMP_LTZ(o."created_at"/1000000), 'YYYY-MM') AS "order_month",
  u."country",
  ii."product_department",
  ii."product_category",
  COUNT(DISTINCT o."order_id")                      AS "num_orders",
  COUNT(DISTINCT u."id")                            AS "unique_purchasers",
  SUM(ii."product_retail_price" - ii."cost")        AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
     ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
     ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
     ON oi."inventory_item_id" = ii."id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995199000000
  AND u."created_at" BETWEEN 1609459200000000 AND 1640995199000000
  AND ii."created_at" BETWEEN 1609459200000000 AND 1640995199000000
GROUP BY 
  TO_CHAR(TO_TIMESTAMP_LTZ(o."created_at"/1000000), 'YYYY-MM'),
  u."country",
  ii."product_department",
  ii."product_category"
ORDER BY "order_month" ASC
LIMIT 20;
```

```sql
--Description: Verify the distinct list of (country, department, category) present in the 2021 qualifying data set
SELECT DISTINCT
  u."country",
  ii."product_department",
  ii."product_category"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
     ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
     ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
     ON oi."inventory_item_id" = ii."id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995199000000
  AND u."created_at" BETWEEN 1609459200000000 AND 1640995199000000
  AND ii."created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```
