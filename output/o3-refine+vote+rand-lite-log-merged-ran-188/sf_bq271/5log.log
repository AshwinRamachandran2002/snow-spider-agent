```sql
--Description: 1) Peek at a few orders placed during calendar-year 2021
SELECT 
  "order_id",
  "user_id",
  "status",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "created_at" >= 1609459200000000   -- 2021-01-01
  AND "created_at" <  1640995200000000   -- 2022-01-01
LIMIT 20;
```

```sql
--Description: 2) Show distinct users who registered in 2021
SELECT DISTINCT 
  "id"     AS "user_id",
  "country",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "created_at" >= 1609459200000000
  AND "created_at" <  1640995200000000
LIMIT 20;
```

```sql
--Description: 3) Look at inventory records whose stock items were first created in 2021
SELECT 
  "id"                   AS "inventory_item_id",
  "product_id",
  "product_department",
  "product_category",
  "cost",
  "product_retail_price",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
WHERE "created_at" >= 1609459200000000
  AND "created_at" <  1640995200000000
LIMIT 20;
```

```sql
--Description: 4) Join 2021 orders to 2021 users (quick sanity sample)
SELECT 
  o."order_id",
  o."user_id",
  u."country",
  o."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"  o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"   u
  ON o."user_id" = u."id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995200000000
  AND u."created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: 5) Tie order items to 2021-born inventory items
SELECT 
  oi."id"                AS "order_item_id",
  oi."order_id",
  oi."inventory_item_id",
  ii."product_id",
  ii."created_at"        AS "inventory_created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
  ON oi."inventory_item_id" = ii."id"
WHERE ii."created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: 6) Bring in product cost & retail price for each joined row
SELECT 
  oi."order_id",
  p."department",
  p."category",
  p."retail_price",
  p."cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
     ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
     ON ii."product_id" = p."id"
WHERE ii."created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: 7) Add the purchaser’s country to each qualifying line item
SELECT 
  oi."order_id",
  u."country",
  p."department",
  p."category",
  p."retail_price",
  p."cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
     ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
     ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
     ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
     ON ii."product_id" = p."id"
WHERE o."created_at"  BETWEEN 1609459200000000 AND 1640995200000000
  AND u."created_at"  BETWEEN 1609459200000000 AND 1640995200000000
  AND ii."created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: 8) Derive the calendar month (YYYY-MM) for each line item
SELECT 
  TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM')   AS "order_month",
  u."country",
  p."department",
  p."category",
  p."retail_price",
  p."cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
     ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
     ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
     ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
     ON ii."product_id" = p."id"
WHERE o."created_at"  BETWEEN 1609459200000000 AND 1640995200000000
  AND u."created_at"  BETWEEN 1609459200000000 AND 1640995200000000
  AND ii."created_at" BETWEEN 1609459200000000 AND 1640995200000000
LIMIT 20;
```

```sql
--Description: 9) Aggregate sample results – profit, order count, purchaser count
SELECT 
  TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM')                     AS "order_month",
  u."country",
  p."department",
  p."category",
  COUNT(DISTINCT o."order_id")                                                 AS "orders",
  COUNT(DISTINCT o."user_id")                                                  AS "unique_purchasers",
  SUM(p."retail_price" - p."cost")                                             AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
     ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
     ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
     ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
     ON ii."product_id" = p."id"
WHERE o."created_at"  BETWEEN 1609459200000000 AND 1640995200000000
  AND u."created_at"  BETWEEN 1609459200000000 AND 1640995200000000
  AND ii."created_at" BETWEEN 1609459200000000 AND 1640995200000000
GROUP BY 
  TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM'),
  u."country",
  p."department",
  p."category"
LIMIT 20;
```

```sql
--Description: 10) Final “answer” query – full 2021 monthly report by country / department / category
SELECT
  TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM')                     AS "order_month",
  u."country",
  p."department",
  p."category",
  COUNT(DISTINCT o."order_id")                                                 AS "orders",
  COUNT(DISTINCT o."user_id")                                                  AS "unique_purchasers",
  SUM(p."retail_price" - p."cost")                                             AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
     ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"           u
     ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
     ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
     ON ii."product_id" = p."id"
WHERE o."created_at"  BETWEEN 1609459200000000 AND 1640995200000000
  AND u."created_at"  BETWEEN 1609459200000000 AND 1640995200000000
  AND ii."created_at" BETWEEN 1609459200000000 AND 1640995200000000
GROUP BY 
  TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM'),
  u."country",
  p."department",
  p."category"
ORDER BY 
  "order_month",
  "country",
  "department",
  "category"
LIMIT 20;
```
