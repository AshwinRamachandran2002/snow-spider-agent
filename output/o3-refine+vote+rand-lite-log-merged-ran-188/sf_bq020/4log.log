Query:
--Description: Join variant counts with contig lengths and calculate variant density (variants per kb)
SELECT  
    c."reference_name",
    c."variant_count",
    r."length",
    (c."variant_count" / NULLIF(r."length",0)) * 1000  AS "variants_per_kb"
FROM (
        SELECT  
            "reference_name",
            COUNT(*) AS "variant_count"
        FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_TRANSCRIPTOME_201703
        GROUP BY "reference_name"
     ) c
JOIN GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_REFERENCE_201703 r
  ON c."reference_name" = r."name"
LIMIT 20;
