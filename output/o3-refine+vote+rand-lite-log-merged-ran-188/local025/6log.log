```sql
--Description: Combine batsman and extra runs to obtain total runs in each over of every innings.
SELECT DISTINCT COALESCE(b."match_id", e."match_id")       AS "match_id",
                COALESCE(b."innings_no", e."innings_no")   AS "innings_no",
                COALESCE(b."over_id", e."over_id")         AS "over_id",
                COALESCE(b."batsman_runs", 0) +
                COALESCE(e."extra_total", 0)               AS "over_total"
FROM   (SELECT   "match_id","innings_no","over_id",
                 SUM("runs_scored") AS "batsman_runs"
        FROM     "batsman_scored"
        GROUP BY "match_id","innings_no","over_id") AS b
FULL JOIN
       (SELECT   "match_id","innings_no","over_id",
                 SUM("extra_runs") AS "extra_total"
        FROM     "extra_runs"
        GROUP BY "match_id","innings_no","over_id") AS e
ON     b."match_id"   = e."match_id"
AND    b."innings_no" = e."innings_no"
AND    b."over_id"    = e."over_id"
LIMIT  20;
```

```sql
--Description: From the combined totals, pick the single highest-scoring over of each match.
SELECT DISTINCT t1."match_id",
                t1."innings_no",
                t1."over_id",
                t1."over_total"
FROM   (SELECT   c.*,
                 RANK() OVER (PARTITION BY c."match_id"
                              ORDER BY c."over_total" DESC) AS rnk
        FROM   (/* same combined logic as above */
                SELECT COALESCE(b."match_id", e."match_id") AS "match_id",
                       COALESCE(b."innings_no", e."innings_no") AS "innings_no",
                       COALESCE(b."over_id", e."over_id") AS "over_id",
                       COALESCE(b."batsman_runs",0)+
                       COALESCE(e."extra_total",0) AS "over_total"
                FROM   (SELECT "match_id","innings_no","over_id",
                               SUM("runs_scored") AS "batsman_runs"
                        FROM   "batsman_scored"
                        GROUP BY "match_id","innings_no","over_id") AS b
                FULL JOIN
                       (SELECT "match_id","innings_no","over_id",
                               SUM("extra_runs") AS "extra_total"
                        FROM   "extra_runs"
                        GROUP BY "match_id","innings_no","over_id") AS e
                ON b."match_id"=e."match_id"
               AND b."innings_no"=e."innings_no"
               AND b."over_id"=e."over_id") AS c) AS t1
WHERE  t1.rnk = 1
LIMIT  20;
```

```sql
--Description: For the overs identified above, list every ball so we can see which bowler delivered them.
SELECT DISTINCT o."match_id",
                o."innings_no",
                o."over_id",
                bbb."bowler",
