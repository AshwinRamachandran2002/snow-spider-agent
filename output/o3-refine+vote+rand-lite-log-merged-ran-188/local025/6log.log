--Description: 1) Gather every run scored (batsman + extras) and sum them at the
--                (match, innings, over) level.
--             2) Within each match pick the single over with the highest total
--                runs (RANK = 1).
--             3) Retrieve the bowler who delivered that over (all balls in an
--                over have the same bowler; MIN() is a safe pick).
--             4) Display per-match details and, via a window-AVG, the overall
--                average of these highest-over totals across all matches.
WITH over_runs AS (                       -- step-1
    SELECT  "match_id",
            "innings_no",
            "over_id",
            SUM("runs") AS "over_total"
    FROM (
            SELECT  "match_id",
                    "innings_no",
                    "over_id",
                    "runs_scored" AS "runs"
            FROM    "batsman_scored"
            UNION ALL
            SELECT  "match_id",
                    "innings_no",
                    "over_id",
                    "extra_runs"  AS "runs"
            FROM    "extra_runs"
         )
    GROUP BY "match_id", "innings_no", "over_id"
),
highest_over AS (                         -- step-2
    SELECT  "match_id",
            "innings_no",
            "over_id",
            "over_total"
    FROM (
            SELECT  o.*,
                    RANK() OVER (PARTITION BY o."match_id"
                                 ORDER BY o."over_total" DESC) AS rk
            FROM    over_runs o
         )
    WHERE rk = 1
),
bowler_lookup AS (                        -- step-3
    SELECT  h."match_id",
            h."innings_no",
            h."over_id",
            h."over_total",
            MIN(b."bowler") AS "bowler_id"
    FROM    highest_over h
    JOIN    "ball_by_ball" b
      ON    b."match_id"   = h."match_id"
      AND   b."innings_no" = h."innings_no"
      AND   b."over_id"    = h."over_id"
    GROUP BY h."match_id", h."innings_no", h."over_id", h."over_total"
)
SELECT  bl."match_id",
        bl."innings_no",
        bl."over_id",
        bl."over_total",
        bl."bowler_id",
        AVG(bl."over_total") OVER () AS "avg_highest_over_runs"  -- step-4
FROM    bowler_lookup bl
ORDER BY bl."match_id"
LIMIT 20;
