--Description: From the combined totals (batsman + extras) pick the single highest-scoring over of each match (no FULL JOIN).
WITH over_runs AS (                           -- combine runs at (match,innings,over)
        SELECT  "match_id",
                "innings_no",
                "over_id",
                SUM("runs") AS "over_total"
        FROM   (SELECT "match_id","innings_no","over_id","runs_scored" AS "runs"
                FROM   "batsman_scored"
                UNION ALL
                SELECT "match_id","innings_no","over_id","extra_runs"  AS "runs"
                FROM   "extra_runs")
        GROUP BY "match_id","innings_no","over_id"
),
ranked AS (                                   -- rank overs inside each match
        SELECT  o.*,
                RANK() OVER (PARTITION BY o."match_id"
                             ORDER BY o."over_total" DESC) AS rnk
        FROM    over_runs o)
SELECT DISTINCT "match_id","innings_no","over_id","over_total"
FROM   ranked
WHERE  rnk = 1
LIMIT 20
