```sql
--Description: Join the highest-over table to the bowler table and the player table for a human-readable summary.
SELECT DISTINCT h."match_id",
                h."innings_no",
                h."over_id",
                h."over_total",
                p."player_name" AS "bowler_name"
FROM   (/* reuse query 7 but keep one bowler per over */ 
        SELECT o."match_id",
               o."innings_no",
               o."over_id",
               o."over_total",
               MIN(bbb."bowler") AS "bowler_id"
        FROM  (SELECT  c.*,
                       RANK() OVER (PARTITION BY c."match_id"
                                    ORDER BY c."over_total" DESC) AS rnk
               FROM   (SELECT COALESCE(b."match_id", e."match_id") AS "match_id",
                              COALESCE(b."innings_no", e."innings_no") AS "innings_no",
                              COALESCE(b."over_id", e."over_id") AS "over_id",
                              COALESCE(b."batsman_runs",0)+
                              COALESCE(e."extra_total",0) AS "over_total"
                       FROM   (SELECT "match_id","innings_no","over_id",
                                      SUM("runs_scored") AS "batsman_runs"
                               FROM   "batsman_scored"
                               GROUP BY "match_id","innings_no","over_id") AS b
                       FULL JOIN
                              (SELECT "match_id","innings_no","over_id",
                                      SUM("extra_runs") AS "extra_total"
                               FROM   "extra_runs"
                               GROUP BY "match_id","innings_no","over_id") AS e
                       ON b."match_id"=e."match_id"
                      AND b."innings_no"=e."innings_no"
                      AND b."over_id"=e."over_id") AS c) AS o
        JOIN  "ball_by_ball" AS bbb
        ON    bbb."match_id"   = o."match_id"
        AND   bbb."innings_no" = o."innings_no"
        AND   bbb."over_id"    = o."over_id"
        WHERE o.rnk = 1
        GROUP BY o."match_id",
                 o."innings_no",
                 o."over_id",
                 o."over_total") AS h
JOIN   "player" AS p
ON     p."player_id" = h."bowler_id"
LIMIT  20;
```
