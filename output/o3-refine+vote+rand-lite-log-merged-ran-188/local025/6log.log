```sql
--Description: Human-readable summary of each match’s highest-scoring over with bowler name.
WITH over_runs AS (
        SELECT "match_id","innings_no","over_id",
               SUM("runs") AS "over_total"
        FROM  (SELECT "match_id","innings_no","over_id","runs_scored" AS "runs"
               FROM   "batsman_scored"
               UNION ALL
               SELECT "match_id","innings_no","over_id","extra_runs"  AS "runs"
               FROM   "extra_runs")
        GROUP BY "match_id","innings_no","over_id"
),
highest AS (
        SELECT o.*,
               RANK() OVER (PARTITION BY o."match_id"
                            ORDER BY o."over_total" DESC) AS rnk
        FROM   over_runs o
),
bowler AS (
        SELECT  h."match_id",h."innings_no",h."over_id",h."over_total",
                MIN(b."bowler") AS "bowler_id"
        FROM    highest h
        JOIN    "ball_by_ball" b
          ON    b."match_id"   = h."match_id"
         AND    b."innings_no" = h."innings_no"
         AND    b."over_id"    = h."over_id"
        WHERE   h.rnk = 1
        GROUP BY h."match_id",h."innings_no",h."over_id",h."over_total"
)
SELECT  bo."match_id",
        bo."innings_no",
        bo."over_id",
        bo."over_total",
        p."player_name" AS "bowler_name"
FROM    bowler bo
JOIN    "player" p
  ON    p."player_id" = bo."bowler_id"
LIMIT 20;
