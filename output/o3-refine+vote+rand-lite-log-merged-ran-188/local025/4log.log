```sql
--Description: Combine bat runs and extra runs per delivery so we can see the total runs for each ball.
SELECT DISTINCT bb."match_id",
                bb."over_id",
                bb."ball_id",
                bb."innings_no",
                COALESCE(bs."runs_scored",0) +
                COALESCE(er."extra_runs",0)       AS "runs_this_ball",
                bb."bowler"
FROM   "ball_by_ball" AS bb
LEFT  JOIN "batsman_scored" AS bs
       ON bb."match_id"   = bs."match_id"
      AND bb."over_id"    = bs."over_id"
      AND bb."ball_id"    = bs."ball_id"
      AND bb."innings_no" = bs."innings_no"
LEFT  JOIN "extra_runs"    AS er
       ON bb."match_id"   = er."match_id"
      AND bb."over_id"    = er."over_id"
      AND bb."ball_id"    = er."ball_id"
      AND bb."innings_no" = er."innings_no"
LIMIT 20;
```

```sql
--Description: Aggregate the previous result to get total runs per over (match + innings + over).
SELECT DISTINCT "match_id",
                "innings_no",
                "over_id",
                SUM(COALESCE(bs."runs_scored",0) +
                    COALESCE(er."extra_runs",0)) AS "runs_in_over"
FROM   "ball_by_ball" AS bb
LEFT  JOIN "batsman_scored" AS bs
       ON bb."match_id"   = bs."match_id"
      AND bb."over_id"    = bs."over_id"
      AND bb."ball_id"    = bs."ball_id"
      AND bb."innings_no" = bs."innings_no"
LEFT  JOIN "extra_runs"    AS er
       ON bb."match_id"   = er."match_id"
      AND bb."over_id"    = er."over_id"
      AND bb."ball_id"    = er."ball_id"
      AND bb."innings_no" = er."innings_no"
GROUP BY "match_id","innings_no","over_id"
LIMIT 20;
```

```sql
--Description: For every match & innings, pick the single over that had the maximum total runs.
WITH over_totals AS (
  SELECT "match_id",
         "innings_no",
         "over_id",
         SUM(COALESCE(bs."runs_scored",0)+COALESCE(er."extra_runs",0)) AS "runs_in_over"
  FROM   "ball_by_ball" AS bb
  LEFT   JOIN "batsman_scored" AS bs
         ON bb."match_id"   = bs."match_id"
        AND bb."over_id"    = bs."over_id"
        AND bb."ball_id"    = bs."ball_id"
        AND bb."innings_no" = bs."innings_no"
  LEFT   JOIN "extra_runs"    AS er
         ON bb."match_id"   = er."match_id"
        AND bb."over_id"    = er."over_id"
        AND bb."ball_id"    = er."ball_id"
        AND bb."innings_no" = er."innings_no"
  GROUP  BY "match_id","innings_no","over_id"
)
SELECT DISTINCT ot."match_id",
                ot."innings_no",
                ot."over_id",
                ot."runs_in_over"
FROM   over_totals AS ot
JOIN  (SELECT "match_id",
              "innings_no",
              MAX("runs_in_over") AS max_runs
       FROM   over_totals
       GROUP  BY "match_id","innings_no") AS mx
      ON ot."match_id"   = mx."match_id"
     AND ot."innings_no" = mx."innings_no"
     AND ot."runs_in_over" = mx."max_runs"
LIMIT 20;
```

```sql
--Description: Retrieve the bowler(s) who delivered those highest-scoring overs.
WITH best_overs AS (
  /* re-use the CTE built in the previous query */
  WITH over_totals AS (
    SELECT "match_id",
           "innings_no",
           "over_id",
           SUM(COALESCE(bs."runs_scored",0)+COALESCE(er."extra_runs",0)) AS "runs_in_over"
    FROM   "ball_by_ball" AS bb
    LEFT   JOIN "batsman_scored" AS bs
           ON bb."match_id"   = bs."match_id"
          AND bb."over_id"    = bs."over_id"
          AND bb."ball_id"    = bs."ball_id"
          AND bb."innings_no" = bs."innings_no"
    LEFT   JOIN "extra_runs"    AS er
           ON bb."match_id"   = er."match_id"
          AND bb."over_id"    = er."over_id"
          AND bb."ball_id"    = er."ball_id"
          AND bb."innings_no" = er."innings_no"
    GROUP  BY "match_id","innings_no","over_id"
  )
  SELECT ot."match_id",
         ot."innings_no",
         ot."over_id",
         ot."runs_in_over"
  FROM   over_totals AS ot
  JOIN  (SELECT "match_id",
                "innings_no",
                MAX("runs_in_over") AS max_runs
         FROM   over_totals
         GROUP  BY "match_id","innings_no") AS mx
        ON ot."match_id"   = mx."match_id"
       AND ot."innings_no" = mx."innings_no"
       AND ot."runs_in_over" = mx."max_runs"
)
SELECT DISTINCT bo."match_id",
                bo."innings_no",
                bo."over_id",
                bb."bowler",
                bo."runs_in_over"
FROM   best_overs AS bo
JOIN   "ball_by_ball" AS bb
  ON  bo."match_id"   = bb."match_id"
 AND bo."innings_no" = bb."innings_no"
 AND bo."over_id"    = bb."over_id"
LIMIT 20;
```

```sql
--Description: Add the bowler’s actual name by joining with the player table.
WITH best_overs_with_bowler AS (
  /* query from previous step */
  WITH best_overs AS (
    WITH over_totals AS (
      SELECT "match_id",
             "innings_no",
             "over_id",
             SUM(COALESCE(bs."runs_scored",0)+COALESCE(er."extra_runs",0)) AS "runs_in_over"
      FROM   "ball_by_ball" AS bb
      LEFT   JOIN "batsman_scored" AS bs
             ON bb."match_id"   = bs."match_id"
            AND bb."over_id"    = bs."over_id"
            AND bb."ball_id"    = bs."ball_id"
            AND bb."innings_no" = bs."innings_no"
      LEFT   JOIN "extra_runs"    AS er
             ON bb."match_id"   = er."match_id"
            AND bb."over_id"    = er."over_id"
            AND bb."ball_id"    = er."ball_id"
            AND bb."innings_no" = er."innings_no"
      GROUP  BY "match_id","innings_no","over_id"
    )
    SELECT ot."match_id",
           ot."innings_no",
           ot."over_id",
           ot."runs_in_over"
    FROM   over_totals AS ot
    JOIN  (SELECT "match_id",
                  "innings_no",
                  MAX("runs_in_over") AS max_runs
           FROM   over_totals
           GROUP  BY "match_id","innings_no") AS mx
          ON ot."match_id"   = mx."match_id"
         AND ot."innings_no" = mx."innings_no"
         AND ot."runs_in_over" = mx."max_runs"
  )
  SELECT DISTINCT bo."match_id",
                  bo."innings_no",
                  bo."over_id",
                  bb."bowler",
                  bo."runs_in_over"
  FROM   best_overs AS bo
  JOIN   "ball_by_ball" AS bb
    ON  bo."match_id"   = bb."match_id"
   AND bo."innings_no" = bb."innings_no"
   AND bo."over_id"    = bb."over_id"
)
SELECT DISTINCT b."match_id",
                b."innings_no",
                b."over_id",
                p."player_name"  AS "bowler_name",
                b."runs_in_over"
FROM   best_overs_with_bowler AS b
LEFT  JOIN "player" AS p
       ON b."bowler" = p."player_id"
LIMIT 20;
```

```sql
--Description: Finally, calculate the overall average of the highest over totals across all matches (all innings aggregated).
WITH over_totals AS (
  SELECT "match_id",
         "innings_no",
         "over_id",
         SUM(COALESCE(bs."runs_scored",0)+COALESCE(er."extra_runs",0)) AS "runs_in_over"
  FROM   "ball_by_ball" AS bb
  LEFT   JOIN "batsman_scored" AS bs
         ON bb."match_id"   = bs."match_id"
        AND bb."over_id"    = bs."over_id"
        AND bb."ball_id"    = bs."ball_id"
        AND bb."innings_no" = bs."innings_no"
  LEFT   JOIN "extra_runs"    AS er
         ON bb."match_id"   = er."match_id"
        AND bb."over_id"    = er."over_id"
        AND bb."ball_id"    = er."ball_id"
        AND bb."innings_no" = er."innings_no"
  GROUP  BY "match_id","innings_no","over_id"
),
best_over_each_innings AS (
  SELECT ot."match_id",
         ot."innings_no",
         MAX(ot."runs_in_over") AS "highest_over_runs"
  FROM   over_totals AS ot
  GROUP  BY ot."match_id", ot."innings_no"
)
SELECT DISTINCT AVG("highest_over_runs") AS "average_highest_over_runs"
FROM   best_over_each_innings;
```

These eight progressively more complex queries explore the data, combine bat and extra runs, identify the most expensive over per innings, associate that over with its bowler, and finally compute the average of those peak-over totals across the entire dataset.
