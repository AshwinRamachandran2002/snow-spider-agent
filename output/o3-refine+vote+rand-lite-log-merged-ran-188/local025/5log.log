--Description: 10) Compute the average of the highest-scoring over totals across all matches (UNION ALL replaces FULL OUTER JOIN)
WITH
bat AS (
    SELECT "match_id","innings_no","over_id",
           SUM("runs_scored") AS run_component
    FROM   "batsman_scored"
    GROUP  BY "match_id","innings_no","over_id"
),
ext AS (
    SELECT "match_id","innings_no","over_id",
           SUM("extra_runs") AS run_component
    FROM   "extra_runs"
    GROUP  BY "match_id","innings_no","over_id"
),
over_totals AS (
    SELECT "match_id","innings_no","over_id",
           SUM(run_component) AS total_runs
    FROM  (SELECT * FROM bat
           UNION ALL
           SELECT * FROM ext)
    GROUP BY "match_id","innings_no","over_id"
),
best_over_per_match AS (
    SELECT "match_id",
           MAX("total_runs") AS best_runs
    FROM   over_totals
    GROUP  BY "match_id"
)
SELECT AVG(best_runs) AS avg_highest_over_runs
FROM   best_over_per_match
