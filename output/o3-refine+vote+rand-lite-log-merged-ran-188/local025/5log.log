```sql
--Description: 7) Combine batsman and extra runs to get total runs per over
SELECT coalesce(b."match_id", e."match_id")       AS "match_id",
       coalesce(b."innings_no", e."innings_no")   AS "innings_no",
       coalesce(b."over_id", e."over_id")         AS "over_id",
       coalesce(b."bat_runs", 0) + coalesce(e."extra_runs", 0) AS "total_runs"
FROM (
        SELECT "match_id", "innings_no", "over_id", SUM("runs_scored") AS "bat_runs"
        FROM "batsman_scored"
        GROUP BY "match_id", "innings_no", "over_id"
     ) AS b
FULL OUTER JOIN (
        SELECT "match_id", "innings_no", "over_id", SUM("extra_runs") AS "extra_runs"
        FROM "extra_runs"
        GROUP BY "match_id", "innings_no", "over_id"
     ) AS e
ON  b."match_id"   = e."match_id"
AND b."innings_no" = e."innings_no"
AND b."over_id"    = e."over_id"
LIMIT 20;
```

```sql
--Description: 8) Bring bowler information for each over and show total runs
SELECT t."match_id",
       t."innings_no",
       t."over_id",
       t."total_runs",
       bb."bowler"
FROM (
        -- sub-query from step-7
        SELECT coalesce(b."match_id", e."match_id")       AS "match_id",
               coalesce(b."innings_no", e."innings_no")   AS "innings_no",
               coalesce(b."over_id", e."over_id")         AS "over_id",
               coalesce(b."bat_runs", 0) + coalesce(e."extra_runs", 0) AS "total_runs"
        FROM (
                SELECT "match_id", "innings_no", "over_id", SUM("runs_scored") AS "bat_runs"
                FROM "batsman_scored"
                GROUP BY "match_id", "innings_no", "over_id"
             ) AS b
        FULL OUTER JOIN (
                SELECT "match_id", "innings_no", "over_id", SUM("extra_runs") AS "extra_runs"
                FROM "extra_runs"
                GROUP BY "match_id", "innings_no", "over_id"
             ) AS e
        ON  b."match_id"   = e."match_id"
        AND b."innings_no" = e."innings_no"
        AND b."over_id"    = e."over_id"
     ) AS t
JOIN "ball_by_ball" AS bb
  ON bb."match_id"   = t."match_id"
 AND bb."innings_no" = t."innings_no"
 AND bb."over_id"    = t."over_id"
LIMIT 20;
```

```sql
--Description: 9) For each match, keep only the single over with the highest total runs (tie-break with MIN over_id) and show bowler
WITH over_totals AS (
  SELECT coalesce(b."match_id", e."match_id")       AS "match_id",
         coalesce(b."innings_no", e."innings_no")   AS "innings_no",
         coalesce(b."over_id", e."over_id")         AS "over_id",
         coalesce(b."bat_runs", 0) + coalesce(e."extra_runs", 0) AS "total_runs"
  FROM (
          SELECT "match_id", "innings_no", "over_id", SUM("runs_scored") AS "bat_runs"
          FROM "batsman_scored"
          GROUP BY "match_id", "innings_no", "over_id"
       ) AS b
  FULL OUTER JOIN (
          SELECT "match_id", "innings_no", "over_id", SUM("extra_runs") AS "extra_runs"
          FROM "extra_runs"
          GROUP BY "match_id", "innings_no", "over_id"
       ) AS e
  ON  b."match_id"   = e."match_id"
  AND b."innings_no" = e."innings_no"
  AND b."over_id"    = e."over_id"
),
ranked AS (
  SELECT o.*,
         ROW_NUMBER() OVER (PARTITION BY "match_id" ORDER BY "total_runs" DESC, "innings_no", "over_id") AS rnk
  FROM over_totals AS o
)
SELECT r."match_id",
       r."innings_no",
       r."over_id",
       r."total_runs",
       bb."bowler"
FROM ranked AS r
JOIN "ball_by_ball" AS bb
  ON bb."match_id"   = r."match_id"
 AND bb."innings_no" = r."innings_no"
 AND bb."over_id"    = r."over_id"
WHERE r.rnk = 1
LIMIT 20;
```

```sql
--Description: 10) Compute the average of the highest over totals across all matches
WITH over_totals AS (
  SELECT coalesce(b."match_id", e."match_id")       AS "match_id",
         coalesce(b."innings_no", e."innings_no")   AS "innings_no",
         coalesce(b."over_id", e."over_id")         AS "over_id",
         coalesce(b."bat_runs", 0) + coalesce(e."extra_runs", 0) AS "total_runs"
  FROM (
          SELECT "match_id", "innings_no", "over_id", SUM("runs_scored") AS "bat_runs"
          FROM "batsman_scored"
          GROUP BY "match_id", "innings_no", "over_id"
       ) AS b
  FULL OUTER JOIN (
          SELECT "match_id", "innings_no", "over_id", SUM("extra_runs") AS "extra_runs"
          FROM "extra_runs"
          GROUP BY "match_id", "innings_no", "over_id"
       ) AS e
  ON  b."match_id"   = e."match_id"
  AND b."innings_no" = e."innings_no"
  AND b."over_id"    = e."over_id"
),
best_over_per_match AS (
  SELECT "match_id",
         MAX("total_runs") AS best_runs
  FROM over_totals
  GROUP BY "match_id"
)
SELECT AVG(best_runs) AS "avg_highest_over_runs"
FROM best_over_per_match;
```
