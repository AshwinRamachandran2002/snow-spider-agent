```sql
--Description: Full solution in a single query (“thinking process” embedded as CTE comments):
--   • bat  – sum batsman runs per match-innings-over
--   • ext  – sum extra runs   per match-innings-over
--   • over_totals – UNION ALL the two sets, re-sum → combined runs per over
--   • bowler_over – pick one bowler for each over (MIN() works because bowler is constant)
--   • ranked – rank overs within each match by total_runs (highest first)
--   • final  – select only rank = 1 (best over per match) and take average of their totals
WITH
bat AS (                                                    -- batsman runs
    SELECT "match_id", "innings_no", "over_id",
           SUM("runs_scored") AS run_component
    FROM   "batsman_scored"
    GROUP  BY "match_id", "innings_no", "over_id"
),
ext AS (                                                    -- extra runs
    SELECT "match_id", "innings_no", "over_id",
           SUM("extra_runs")  AS run_component
    FROM   "extra_runs"
    GROUP  BY "match_id", "innings_no", "over_id"
),
over_totals AS (                                            -- combined runs per over
    SELECT "match_id", "innings_no", "over_id",
           SUM(run_component) AS total_runs
    FROM  (SELECT * FROM bat
           UNION ALL
           SELECT * FROM ext)
    GROUP BY "match_id", "innings_no", "over_id"
),
bowler_over AS (                                            -- bowler for each over
    SELECT "match_id", "innings_no", "over_id",
           MIN("bowler") AS bowler
    FROM   "ball_by_ball"
    GROUP  BY "match_id", "innings_no", "over_id"
),
ranked AS (                                                 -- rank overs per match
    SELECT ot."match_id",
           ot."innings_no",
           ot."over_id",
           ot."total_runs",
           bo."bowler",
           ROW_NUMBER() OVER (
               PARTITION BY ot."match_id"
               ORDER BY ot."total_runs" DESC,
                        ot."innings_no",
                        ot."over_id"
           ) AS rk
    FROM   over_totals ot
    JOIN   bowler_over bo
           ON  ot."match_id"   = bo."match_id"
           AND ot."innings_no" = bo."innings_no"
           AND ot."over_id"    = bo."over_id"
)
SELECT AVG(total_runs) AS avg_highest_over_runs            -- final answer
FROM   ranked
WHERE  rk = 1;
```
