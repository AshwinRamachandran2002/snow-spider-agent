           ot."over_id",
           ot."total_runs",
           bo."bowler",
           ROW_NUMBER() OVER (
               PARTITION BY ot."match_id"
               ORDER BY ot."total_runs" DESC,
                        ot."innings_no",
                        ot."over_id"
           ) AS rnk
    FROM   over_totals ot
    JOIN   bowler_over bo
      ON   bo."match_id"   = ot."match_id"
     AND   bo."innings_no" = ot."innings_no"
     AND   bo."over_id"    = ot."over_id"
)
SELECT "match_id",
       "innings_no",
       "over_id",
       "total_runs",
       "bowler"
FROM   ranked
WHERE  rnk = 1
LIMIT 20
