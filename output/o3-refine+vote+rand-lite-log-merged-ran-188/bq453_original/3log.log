```sql
/*  Variants on chr17:41196311‑41277499
    ‑ reference / alt information
    ‑ variant type
    ‑ H‑W χ² value provided by 1KG (HWE column)
    ‑ total number of diploid genotypes
    ‑ observed & expected genotype counts
    ‑ allele frequencies (global and 1KG super–populations)
*/
WITH region_variants AS (
  SELECT
    v.reference_name,
    v.start,
    v.end,
    v.reference_bases,
    v.alternate_bases,           -- ARRAY<STRING>
    v.VT,
    v.HWE,
    v.AF,
    v.AFR_AF,
    v.AMR_AF,
    v.ASN_AF,
    v.EUR_AF,
    v.call
  FROM `spider2-public-data.1000_genomes.variants` v
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
    AND ARRAY_LENGTH(v.alternate_bases) = 1   -- keep simple bi‑allelic sites
),
genotype_stats AS (
  SELECT
    reference_name,
    start,
    end,
    reference_bases,
    alternate_bases[OFFSET(0)]                             AS alt_base,
    VT,
    HWE,
    AF,
    AFR_AF,
    AMR_AF,
    ASN_AF,
    EUR_AF,

    /* genotype tallies */
    COUNTIF(ARRAY_LENGTH(c.genotype)=2)                                                   AS total_genotypes,

    COUNTIF(ARRAY_LENGTH(c.genotype)=2
            AND c.genotype[OFFSET(0)] = 0
            AND c.genotype[OFFSET(1)] = 0)                                                AS obs_hom_ref,

    COUNTIF(ARRAY_LENGTH(c.genotype)=2
            AND ((c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 1)
                 OR (c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 0)))           AS obs_het,

    COUNTIF(ARRAY_LENGTH(c.genotype)=2
            AND c.genotype[OFFSET(0)] = 1
            AND c.genotype[OFFSET(1)] = 1)                                                AS obs_hom_alt,

    /* sample allele‑frequency (ALT) */
    SUM(
      IF(ARRAY_LENGTH(c.genotype)=2,
         c.genotype[OFFSET(0)] + c.genotype[OFFSET(1)],
         0)
    ) / (2 * COUNTIF(ARRAY_LENGTH(c.genotype)=2))                                         AS p_alt
  FROM region_variants,
  UNNEST(call) AS c
  GROUP BY reference_name, start, end, reference_bases, alt_base,
           VT, HWE, AF, AFR_AF, AMR_AF, ASN_AF, EUR_AF
)

SELECT
  reference_name,
  start,
  end,
  reference_bases,
  alt_base                                 AS alternate_bases,
  VT                                       AS variant_type,
  HWE                                      AS chi_squared,
  total_genotypes,
  obs_hom_ref,
  obs_het,
  obs_hom_alt,
  ROUND(total_genotypes * POWER(1 - p_alt, 2), 4)        AS exp_hom_ref,
  ROUND(total_genotypes * 2 * p_alt * (1 - p_alt), 4)    AS exp_het,
  ROUND(total_genotypes * POWER(p_alt, 2), 4)            AS exp_hom_alt,
  AF                                       AS global_AF,
  AFR_AF,
  AMR_AF,
  ASN_AF,
  EUR_AF
FROM genotype_stats
ORDER BY start;
```
