--Description: 2) Show the first-open events that happened in Shanghai time during
--   the cohort-building week 0 (2018-09-01 ~ 2018-09-07).
SELECT
  `user_pseudo_id`,
  DATE(TIMESTAMP_MICROS(event_timestamp), 'Asia/Shanghai')  AS sh_date,
  `event_name`
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180907'
  AND `event_name` = 'first_open'
LIMIT 20;
