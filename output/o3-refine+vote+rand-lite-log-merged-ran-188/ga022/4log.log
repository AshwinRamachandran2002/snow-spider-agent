Query:
--Description: 4) Take a sample of ANY events produced by those cohort users
--   during retention Week-1 (2018-09-08 ~ 2018-09-14, Shanghai time).
WITH cohort AS (
  SELECT DISTINCT `user_pseudo_id`
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180907'
    AND `event_name` = 'first_open'
)
SELECT
  e.`user_pseudo_id`,
  DATE(TIMESTAMP_MICROS(e.event_timestamp), 'Asia/Shanghai') AS sh_date,
  e.`event_name`
FROM `firebase-public-project.analytics_153293282.events_*` AS e
JOIN cohort USING(`user_pseudo_id`)
WHERE e._TABLE_SUFFIX BETWEEN '20180908' AND '20180914'
LIMIT 20;
