    BOOL(MAX(CASE WHEN _TABLE_SUFFIX BETWEEN '20180908' AND '20180914' THEN 1 END)) AS wk1,
    BOOL(MAX(CASE WHEN _TABLE_SUFFIX BETWEEN '20180915' AND '20180921' THEN 1 END)) AS wk2,
