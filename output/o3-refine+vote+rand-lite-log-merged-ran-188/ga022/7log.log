Below is a step-by-step exploration that finishes with a ready-to-use retention-rate table.  
All queries reference the public GA4 game dataset
`firebase-public-project.analytics_153293282` and are restricted to September-2018
tables only.

```sql
--Description: 1.  Take a quick look at the distinct event names that happened
--              in September 2018 (first 20 values only).
SELECT DISTINCT `event_name`
FROM `firebase-public-project.analytics_153293282.events_201809*`
LIMIT 20;
```

```sql
--Description: 2.  Inspect a few raw `first_open` rows on Sept-01 ~ Sept-07
--              in Shanghai time (+8h).  Shows we indeed have new-user events.
SELECT
  FORMAT_TIMESTAMP('%F %T', TIMESTAMP_MICROS(event_timestamp) + INTERVAL 8 HOUR)
      AS shanghai_time,
  user_pseudo_id
FROM `firebase-public-project.analytics_153293282.events_2018090[1-7]`
WHERE `event_name` = 'first_open'
LIMIT 20;
```

```sql
--Description: 3.  Build the cohort: users whose FIRST first_open ever
--              occurred between 2018-09-01 and 2018-09-07 (Shanghai).
SELECT DISTINCT user_pseudo_id
FROM (
  SELECT
    user_pseudo_id,
    MIN(DATE(TIMESTAMP_MICROS(event_timestamp) + INTERVAL 8 HOUR))
        AS first_open_cn
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE event_name = 'first_open'
  GROUP BY user_pseudo_id
)
WHERE first_open_cn BETWEEN '2018-09-01' AND '2018-09-07'
LIMIT 20;
```

```sql
--Description: 4.  Check that some of those cohort users did come back
--              in week-1 (2018-09-08 ~ 2018-09-14 Shanghai).
SELECT DISTINCT e.user_pseudo_id
FROM  `firebase-public-project.analytics_153293282.events_2018090[8-9]` AS e
JOIN (
    -- cohort from step-3
    SELECT user_pseudo_id
    FROM (
      SELECT user_pseudo_id,
             MIN(DATE(TIMESTAMP_MICROS(event_timestamp)+INTERVAL 8 HOUR))
                 AS first_open_cn
      FROM `firebase-public-project.analytics_153293282.events_201809*`
      WHERE event_name='first_open'
      GROUP BY user_pseudo_id)
    WHERE first_open_cn BETWEEN '2018-09-01' AND '2018-09-07'
) AS c
ON  c.user_pseudo_id = e.user_pseudo_id
WHERE DATE(TIMESTAMP_MICROS(e.event_timestamp)+INTERVAL 8 HOUR)
      BETWEEN '2018-09-08' AND '2018-09-14'
LIMIT 20;
```

```sql
--Description: 5.  Flag each cohort user by whether (s)he returned in Week-1.
SELECT
  c.user_pseudo_id,
  COUNTIF( DATE(TIMESTAMP_MICROS(e.event_timestamp)+INTERVAL 8 HOUR)
           BETWEEN '2018-09-08' AND '2018-09-14') > 0
           AS retained_wk1
FROM (
    --cohort again
    SELECT user_pseudo_id
    FROM (
      SELECT user_pseudo_id,
             MIN(DATE(TIMESTAMP_MICROS(event_timestamp)+INTERVAL 8 HOUR))
                 AS first_open_cn
      FROM `firebase-public-project.analytics_153293282.events_201809*`
      WHERE event_name='first_open'
      GROUP BY user_pseudo_id)
    WHERE first_open_cn BETWEEN '2018-09-01' AND '2018-09-07'
) AS c
LEFT JOIN `firebase-public-project.analytics_153293282.events_201809*` AS e
ON  e.user_pseudo_id = c.user_pseudo_id
GROUP BY c.user_pseudo_id
LIMIT 20;
```

```sql
--Description: 6.  Produce a wide user-level table with boolean flags
--              for week-1/2/3 returns.
SELECT
  c.user_pseudo_id,
  BOOL(MAX(CASE
        WHEN DATE(TIMESTAMP_MICROS(e.event_timestamp)+INTERVAL 8 HOUR)
             BETWEEN '2018-09-08' AND '2018-09-14'
        THEN 1 END)) AS wk1_retained,
  BOOL(MAX(CASE
        WHEN DATE(TIMESTAMP_MICROS(e.event_timestamp)+INTERVAL 8 HOUR)
             BETWEEN '2018-09-15' AND '2018-09-21'
        THEN 1 END)) AS wk2_retained,
  BOOL(MAX(CASE
        WHEN DATE(TIMESTAMP_MICROS(e.event_timestamp)+INTERVAL 8 HOUR)
             BETWEEN '2018-09-22' AND '2018-09-28'
        THEN 1 END)) AS wk3_retained
FROM (
    --cohort
    SELECT user_pseudo_id
    FROM (
      SELECT user_pseudo_id,
             MIN(DATE(TIMESTAMP_MICROS(event_timestamp)+INTERVAL 8 HOUR))
                 AS first_open_cn
      FROM `firebase-public-project.analytics_153293282.events_201809*`
      WHERE event_name='first_open'
      GROUP BY user_pseudo_id)
    WHERE first_open_cn BETWEEN '2018-09-01' AND '2018-09-07'
) AS c
LEFT JOIN `firebase-public-project.analytics_153293282.events_201809*` AS e
ON e.user_pseudo_id = c.user_pseudo_id
GROUP BY c.user_pseudo_id
LIMIT 20;
```

```sql
--Description: 7.  Count the size of the cohort (needed for rate calc).
SELECT COUNT(DISTINCT user_pseudo_id) AS cohort_size
FROM (
  SELECT user_pseudo_id
  FROM (
    SELECT user_pseudo_id,
           MIN(DATE(TIMESTAMP_MICROS(event_timestamp)+INTERVAL 8 HOUR))
               AS first_open_cn
    FROM `firebase-public-project.analytics_153293282.events_201809*`
    WHERE event_name='first_open'
    GROUP BY user_pseudo_id)
  WHERE first_open_cn BETWEEN '2018-09-01' AND '2018-09-07'
)
LIMIT 20;
```

```sql
--Description: 8.  Aggregate how many cohort users came back in
--              week-1, week-2 and week-3.
WITH cohort AS (
  SELECT user_pseudo_id
  FROM (
    SELECT user_pseudo_id,
           MIN(DATE(TIMESTAMP_MICROS(event_timestamp)+INTERVAL 8 HOUR))
               AS first_open_cn
    FROM `firebase-public-project.analytics_153293282.events_201809*`
    WHERE event_name='first_open'
    GROUP BY user_pseudo_id)
  WHERE first_open_cn BETWEEN '2018-09-01' AND '2018-09-07'
),
flags AS (
  SELECT
    c.user_pseudo_id,
    BOOL(MAX(CASE
          WHEN DATE(TIMESTAMP_MICROS(e.event_timestamp)+INTERVAL 8 HOUR)
               BETWEEN '2018-09-08' AND '2018-09-14' THEN 1 END)) AS wk1,
    BOOL(MAX(CASE
          WHEN DATE(TIMESTAMP_MICROS(e.event_timestamp)+INTERVAL 8 HOUR)
               BETWEEN '2018-09-15' AND '2018-09-21' THEN 1 END)) AS wk2,
    BOOL(MAX(CASE
          WHEN DATE(TIMESTAMP_MICROS(e.event_timestamp)+INTERVAL 8 HOUR)
               BETWEEN '2018-09-22' AND '2018-09-28' THEN 1 END)) AS wk3
  FROM cohort AS c
  LEFT JOIN `firebase-public-project.analytics_153293282.events_201809*` AS e
  ON  e.user_pseudo_id = c.user_pseudo_id
  GROUP BY c.user_pseudo_id
)
SELECT
  COUNT(*)                             AS cohort_size,
  COUNTIF(wk1)                         AS week1_users,
  COUNTIF(wk2)                         AS week2_users,
  COUNTIF(wk3)                         AS week3_users
FROM flags
LIMIT 20;
```

```sql
--Description: 9.  FINAL – calculate retention % for Week-1/2/3
--              (Shanghai-time cohort starting 2018-09-01).
WITH cohort AS (
  SELECT user_pseudo_id
  FROM (
    SELECT user_pseudo_id,
           MIN(DATE(TIMESTAMP_MICROS(event_timestamp)+INTERVAL 8 HOUR))
               AS first_open_cn
    FROM `firebase-public-project.analytics_153293282.events_201809*`
    WHERE event_name='first_open'
    GROUP BY user_pseudo_id)
  WHERE first_open_cn BETWEEN '2018-09-01' AND '2018-09-07'
),
flags AS (
  SELECT
    c.user_pseudo_id,
    BOOL(MAX(CASE
          WHEN DATE(TIMESTAMP_MICROS(e.event_timestamp)+INTERVAL 8 HOUR)
               BETWEEN '2018-09-08' AND '2018-09-14' THEN 1 END)) AS wk1,
    BOOL(MAX(CASE
          WHEN DATE(TIMESTAMP_MICROS(e.event_timestamp)+INTERVAL 8 HOUR)
               BETWEEN '2018-09-15' AND '2018-09-21' THEN 1 END)) AS wk2,
    BOOL(MAX(CASE
          WHEN DATE(TIMESTAMP_MICROS(e.event_timestamp)+INTERVAL 8 HOUR)
               BETWEEN '2018-09-22' AND '2018-09-28' THEN 1 END)) AS wk3
  FROM cohort AS c
  LEFT JOIN `firebase-public-project.analytics_153293282.events_201809*` AS e
  ON e.user_pseudo_id = c.user_pseudo_id
  GROUP BY c.user_pseudo_id
)
SELECT
  COUNT(*)                               AS cohort_size,
  ROUND(COUNTIF(wk1) / COUNT(*) * 100,2) AS week1_retention_pct,
  ROUND(COUNTIF(wk2) / COUNT(*) * 100,2) AS week2_retention_pct,
  ROUND(COUNTIF(wk3) / COUNT(*) * 100,2) AS week3_retention_pct
FROM flags
LIMIT 20;
```

These nine queries (all capped at `LIMIT 20`) progress from basic inspection to the
final table that reports the cohort size and its Week-1/2/3 retention rates for
new users acquired during 1-7 Sep 2018 in Shanghai time.
