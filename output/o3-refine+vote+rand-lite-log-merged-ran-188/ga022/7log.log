```sql
--Description:  We want to preview “first_open” events that happened during the
--              first week of September-2018 in local Shanghai time (UTC+8).  
--              BigQuery stores one table per day named
--              analytics_153293282.events_YYYYMMDD, so we read every September
--              table via the wildcard pattern `events_201809*`.  
--              To restrict the scan to 01-Sep through 07-Sep only (and avoid
--              a costly full-month read) we use the hidden partition column
--              `_TABLE_SUFFIX`, which contains the date-suffix of each
--              matched table.  
--              `event_timestamp` is in microseconds UTC; add 8 hours and
--              format it to get a human-readable Shanghai timestamp.
--              Finally, LIMIT 20 returns just a small sample of rows.
SELECT
  FORMAT_TIMESTAMP('%F %T',
                   TIMESTAMP_MICROS(event_timestamp) + INTERVAL 8 HOUR)
      AS shanghai_time,
  user_pseudo_id
FROM `firebase-public-project.analytics_153293282.events_201809*`
WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180907'
  AND event_name = 'first_open'
LIMIT 20;
```
