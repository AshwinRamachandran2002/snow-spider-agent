--Description: 8) Full retention table – cohort size plus Week-1/2/3 user counts
--and the corresponding retention-rate columns.
SELECT
  cohort_users,
  week1_retained,
  ROUND(week1_retained / cohort_users, 3) AS week1_retention_rate,
  week2_retained,
  ROUND(week2_retained / cohort_users, 3) AS week2_retention_rate,
  week3_retained,
  ROUND(week3_retained / cohort_users, 3) AS week3_retention_rate
FROM (
  SELECT
    COUNT(DISTINCT CASE WHEN cohort_flag = 1 THEN `user_pseudo_id` END) AS cohort_users,
    COUNT(DISTINCT CASE WHEN week1_flag  = 1 THEN `user_pseudo_id` END) AS week1_retained,
    COUNT(DISTINCT CASE WHEN week2_flag  = 1 THEN `user_pseudo_id` END) AS week2_retained,
    COUNT(DISTINCT CASE WHEN week3_flag  = 1 THEN `user_pseudo_id` END) AS week3_retained
  FROM (
    SELECT
      `user_pseudo_id`,
      MAX(IF(_TABLE_SUFFIX BETWEEN '20180901' AND '20180907'
             AND `event_name` = 'first_open', 1, 0)) AS cohort_flag,
      MAX(IF(_TABLE_SUFFIX BETWEEN '20180908' AND '20180914', 1, 0))   AS week1_flag,
      MAX(IF(_TABLE_SUFFIX BETWEEN '20180915' AND '20180921', 1, 0))   AS week2_flag,
      MAX(IF(_TABLE_SUFFIX BETWEEN '20180922' AND '20180928', 1, 0))   AS week3_flag
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180928'
    GROUP BY `user_pseudo_id`
  )
)
LIMIT 20;
Answer:
cohort_users,week1_retained,week1_retention_rate,week2_retained,week2_retention_rate,week3_retained,week3_retention_rate
