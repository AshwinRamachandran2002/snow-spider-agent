```sql
--Description: ❹  Find users whose VERY FIRST “first_open” happened in Shanghai time
--               between 1-Sep-2018 and 7-Sep-2018 (the cohort we care about)  
WITH first_open AS (
  SELECT
    `user_pseudo_id`,
    MIN( TIMESTAMP_MICROS(`event_timestamp` + 28800000000) ) AS first_open_cn
  FROM
    `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
)
SELECT  `user_pseudo_id`, first_open_cn
FROM    first_open
WHERE   first_open_cn BETWEEN TIMESTAMP '2018-09-01 00:00:00+08'
                         AND   TIMESTAMP '2018-09-07 23:59:59+08'
LIMIT 20;
```

```sql
--Description: ❺  Grab any event these cohort users fired during September  
WITH cohort AS (
  SELECT  `user_pseudo_id`
  FROM    (
           SELECT `user_pseudo_id`,
                  MIN(TIMESTAMP_MICROS(`event_timestamp` + 28800000000)) AS first_open_cn
           FROM   `firebase-public-project.analytics_153293282.events_201809*`
           WHERE  `event_name` = 'first_open'
           GROUP  BY `user_pseudo_id`
          )
  WHERE   first_open_cn BETWEEN TIMESTAMP '2018-09-01 00:00:00+08'
                          AND   TIMESTAMP '2018-09-07 23:59:59+08'
)
SELECT  e.`event_date`,
        e.`event_name`,
        e.`user_pseudo_id`
FROM    `firebase-public-project.analytics_153293282.events_201809*`  AS e
JOIN    cohort c
ON      e.`user_pseudo_id` = c.`user_pseudo_id`
LIMIT 20;
```

```sql
--Description: ❻  Calculate each cohort user’s FIRST return date
--               (any event after the first_open) & the day-difference  
WITH cohort AS (
  SELECT  `user_pseudo_id`,
          MIN(TIMESTAMP_MICROS(`event_timestamp` + 28800000000)) AS day0
  FROM    `firebase-public-project.analytics_153293282.events_201809*`
  WHERE   `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
  HAVING  day0 BETWEEN TIMESTAMP '2018-09-01 00:00:00+08'
                   AND TIMESTAMP '2018-09-07 23:59:59+08'
),
activity AS (
  SELECT  e.`user_pseudo_id`,
          MIN( TIMESTAMP_MICROS(e.`event_timestamp` + 28800000000) )  AS first_return
  FROM    `firebase-public-project.analytics_153293282.events_201809*` e
  JOIN    cohort c
  ON      e.`user_pseudo_id` = c.`user_pseudo_id`
  WHERE   TIMESTAMP_MICROS(e.`event_timestamp` + 28800000000) > c.day0
  GROUP BY e.`user_pseudo_id`, c.day0
)
SELECT  `user_pseudo_id`,
        DATE_DIFF( DATE(first_return) , DATE(day0) , DAY ) AS days_after_open
FROM    activity
JOIN    cohort USING (`user_pseudo_id`)
LIMIT 20;
```

```sql
--Description: ❼  Assign each cohort user to Week-1 / Week-2 / Week-3 buckets  
WITH cohort AS (
  SELECT  `user_pseudo_id`,
          MIN(TIMESTAMP_MICROS(`event_timestamp` + 28800000000)) AS day0
  FROM    `firebase-public-project.analytics_153293282.events_201809*`
  WHERE   `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
  HAVING  day0 BETWEEN TIMESTAMP '2018-09-01 00:00:00+08'
                   AND TIMESTAMP '2018-09-07 23:59:59+08'
),
returns AS (
  SELECT  e.`user_pseudo_id`,
          DATE_DIFF( DATE(TIMESTAMP_MICROS(e.`event_timestamp` + 28800000000)),
                     DATE(c.day0), DAY) AS diff_days
  FROM    `firebase-public-project.analytics_153293282.events_201809*` e
  JOIN    cohort c
  ON      e.`user_pseudo_id` = c.`user_pseudo_id`
  WHERE   TIMESTAMP_MICROS(e.`event_timestamp` + 28800000000) > c.day0
)
SELECT  `user_pseudo_id`,
        CASE
          WHEN diff_days BETWEEN 1  AND 7  THEN 'week_1'
          WHEN diff_days BETWEEN 8  AND 14 THEN 'week_2'
          WHEN diff_days BETWEEN 15 AND 21 THEN 'week_3'
        END AS active_week
FROM    returns
WHERE   diff_days BETWEEN 1 AND 21
LIMIT 20;
```

```sql
--Description: ❽  Count DISTINCT cohort users active in each of Weeks 1-3  
WITH cohort AS (
  SELECT  `user_pseudo_id`,
          MIN(TIMESTAMP_MICROS(`event_timestamp` + 28800000000)) AS day0
  FROM    `firebase-public-project.analytics_153293282.events_201809*`
  WHERE   `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
  HAVING  day0 BETWEEN TIMESTAMP '2018-09-01 00:00:00+08'
                   AND TIMESTAMP '2018-09-07 23:59:59+08'
),
returns AS (
  SELECT  DISTINCT
          e.`user_pseudo_id`,
          DATE_DIFF( DATE(TIMESTAMP_MICROS(e.`event_timestamp` + 28800000000)),
                     DATE(c.day0), DAY) AS diff_days
  FROM    `firebase-public-project.analytics_153293282.events_201809*` e
  JOIN    cohort c
  ON      e.`user_pseudo_id` = c.`user_pseudo_id`
  WHERE   TIMESTAMP_MICROS(e.`event_timestamp` + 28800000000) > c.day0
          AND DATE_DIFF(DATE(TIMESTAMP_MICROS(e.`event_timestamp` + 28800000000)),
                         DATE(c.day0), DAY) BETWEEN 1 AND 21
)
SELECT  CASE
          WHEN diff_days BETWEEN 1  AND 7  THEN 'week_1'
          WHEN diff_days BETWEEN 8  AND 14 THEN 'week_2'
          WHEN diff_days BETWEEN 15 AND 21 THEN 'week_3'
        END AS active_week,
        COUNT(DISTINCT `user_pseudo_id`)                      AS active_users
FROM    returns
GROUP BY active_week
LIMIT 20;
```

```sql
--Description: ❾  Final query – show Week-1, Week-2 & Week-3 retention rates
--               for the 1-7 Sep 2018 Shanghai cohort (single summary row)  
WITH cohort AS (
  SELECT  `user_pseudo_id`,
          MIN(TIMESTAMP_MICROS(`event_timestamp` + 28800000000)) AS day0
  FROM    `firebase-public-project.analytics_153293282.events_201809*`
  WHERE   `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
  HAVING  day0 BETWEEN TIMESTAMP '2018-09-01 00:00:00+08'
                   AND TIMESTAMP '2018-09-07 23:59:59+08'
),
returns AS (
  SELECT  DISTINCT
          e.`user_pseudo_id`,
          DATE_DIFF( DATE(TIMESTAMP_MICROS(e.`event_timestamp` + 28800000000)),
                     DATE(c.day0), DAY) AS diff_days
  FROM    `firebase-public-project.analytics_153293282.events_201809*` e
  JOIN    cohort c
  ON      e.`user_pseudo_id` = c.`user_pseudo_id`
  WHERE   DATE_DIFF( DATE(TIMESTAMP_MICROS(e.`event_timestamp` + 28800000000)),
                     DATE(c.day0), DAY) BETWEEN 1 AND 21
)
SELECT
  COUNT(DISTINCT c.`user_pseudo_id`)                                            AS cohort_size,
  COUNT(DISTINCT IF(diff_days BETWEEN 1  AND 7 , r.`user_pseudo_id`, NULL)) /
  COUNT(DISTINCT c.`user_pseudo_id`)                                            AS week1_retention ,
  COUNT(DISTINCT IF(diff_days BETWEEN 8  AND 14, r.`user_pseudo_id`, NULL)) /
  COUNT(DISTINCT c.`user_pseudo_id`)                                            AS week2_retention ,
  COUNT(DISTINCT IF(diff_days BETWEEN 15 AND 21, r.`user_pseudo_id`, NULL)) /
  COUNT(DISTINCT c.`user_pseudo_id`)                                            AS week3_retention
FROM   cohort c
LEFT  JOIN returns r
ON     c.`user_pseudo_id` = r.`user_pseudo_id`
LIMIT 20;
```

