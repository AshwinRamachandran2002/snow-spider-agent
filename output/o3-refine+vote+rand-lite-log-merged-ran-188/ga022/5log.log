Query:
--Description: ❹  Find users whose VERY FIRST “first_open” happened in Shanghai time
--               between 1-Sep-2018 and 7-Sep-2018 (the cohort we care about)  
WITH first_open AS (
  SELECT
    `user_pseudo_id`,
    MIN( TIMESTAMP_MICROS(`event_timestamp` + 28800000000) ) AS first_open_cn
  FROM
    `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
)
SELECT  `user_pseudo_id`, first_open_cn
FROM    first_open
WHERE   first_open_cn BETWEEN TIMESTAMP '2018-09-01 00:00:00+08'
                         AND   TIMESTAMP '2018-09-07 23:59:59+08'
LIMIT 20;
