  COUNT(DISTINCT IF(diff_days BETWEEN 8  AND 14, r.`user_pseudo_id`, NULL)) /
  COUNT(DISTINCT c.`user_pseudo_id`)                                            AS week2_retention ,
  COUNT(DISTINCT IF(diff_days BETWEEN 15 AND 21, r.`user_pseudo_id`, NULL)) /
  COUNT(DISTINCT c.`user_pseudo_id`)                                            AS week3_retention
FROM   cohort c
LEFT  JOIN returns r
ON     c.`user_pseudo_id` = r.`user_pseudo_id`
