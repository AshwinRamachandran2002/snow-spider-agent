```sql
--Description: 8) Produce one row with cohort size and the three weekly
--   return counts side-by-side (still without the % rates).
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180907'
    AND event_name = 'first_open'
    AND DATE(TIMESTAMP_MICROS(event_timestamp),'Asia/Shanghai')
        BETWEEN '2018-09-01' AND '2018-09-07'
),
week1 AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180908' AND '20180914'
    AND DATE(TIMESTAMP_MICROS(event_timestamp),'Asia/Shanghai')
        BETWEEN '2018-09-08' AND '2018-09-14'
),
week2 AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180915' AND '20180921'
    AND DATE(TIMESTAMP_MICROS(event_timestamp),'Asia/Shanghai')
        BETWEEN '2018-09-15' AND '2018-09-21'
),
week3 AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180922' AND '20180928'
    AND DATE(TIMESTAMP_MICROS(event_timestamp),'Asia/Shanghai')
        BETWEEN '2018-09-22' AND '2018-09-28'
)
SELECT
  (SELECT COUNT(*) FROM cohort)               AS cohort_size ,
  (SELECT COUNT(DISTINCT user_pseudo_id)
     FROM week1  WHERE user_pseudo_id IN (SELECT user_pseudo_id FROM cohort)) AS week1_users ,
  (SELECT COUNT(DISTINCT user_pseudo_id)
     FROM week2  WHERE user_pseudo_id IN (SELECT user_pseudo_id FROM cohort)) AS week2_users ,
  (SELECT COUNT(DISTINCT user_pseudo_id)
     FROM week3  WHERE user_pseudo_id IN (SELECT user_pseudo_id FROM cohort)) AS week3_users
LIMIT 20;
```

```sql
--Description: 9) FINAL — Weekly retention rates (Week-1/2/3) for the
--   Sep-01 – Sep-07 “first_open” cohort, shown in column format.
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180907'
    AND event_name = 'first_open'
    AND DATE(TIMESTAMP_MICROS(event_timestamp),'Asia/Shanghai')
        BETWEEN '2018-09-01' AND '2018-09-07'
),
week1 AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180908' AND '20180914'
    AND DATE(TIMESTAMP_MICROS(event_timestamp),'Asia/Shanghai')
        BETWEEN '2018-09-08' AND '2018-09-14'
),
week2 AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180915' AND '20180921'
    AND DATE(TIMESTAMP_MICROS(event_timestamp),'Asia/Shanghai')
        BETWEEN '2018-09-15' AND '2018-09-21'
),
week3 AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180922' AND '20180928'
    AND DATE(TIMESTAMP_MICROS(event_timestamp),'Asia/Shanghai')
        BETWEEN '2018-09-22' AND '2018-09-28'
)
SELECT
  COUNT(*)                                          AS cohort_size ,
  ROUND( COUNTIF(user_pseudo_id IN (SELECT * FROM week1))*100.0 / COUNT(*), 2) AS retention_week1_pct ,
  ROUND( COUNTIF(user_pseudo_id IN (SELECT * FROM week2))*100.0 / COUNT(*), 2) AS retention_week2_pct ,
  ROUND( COUNTIF(user_pseudo_id IN (SELECT * FROM week3))*100.0 / COUNT(*), 2) AS retention_week3_pct
FROM cohort
LIMIT 20;
```

