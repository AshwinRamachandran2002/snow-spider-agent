Query:
--Description: 1) Look at some “first_open” events that happened between
--   Sep-01 and Sep-07 2018 (Asia/Shanghai local date).
SELECT DISTINCT
  _TABLE_SUFFIX                         AS table_day ,
  `event_date`                          ,
  user_pseudo_id                        ,
  DATE(TIMESTAMP_MICROS(event_timestamp),'Asia/Shanghai') AS shanghai_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180907'
  AND event_name = 'first_open'
LIMIT 20;
