Query:
--Description: 4) Show a sample of ANY events those cohort users generated
--   in Week-1 (Sep-08 – Sep-14).
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180907'
    AND event_name = 'first_open'
    AND DATE(TIMESTAMP_MICROS(event_timestamp),'Asia/Shanghai')
        BETWEEN '2018-09-01' AND '2018-09-07'
)
SELECT DISTINCT
  e.user_pseudo_id                       ,
  e.event_name                           ,
  DATE(TIMESTAMP_MICROS(e.event_timestamp),'Asia/Shanghai') AS shanghai_date
FROM `firebase-public-project.analytics_153293282.events_*` AS e
JOIN cohort USING (user_pseudo_id)
WHERE _TABLE_SUFFIX BETWEEN '20180908' AND '20180914'
  AND DATE(TIMESTAMP_MICROS(e.event_timestamp),'Asia/Shanghai')
      BETWEEN '2018-09-08' AND '2018-09-14'
LIMIT 20;
