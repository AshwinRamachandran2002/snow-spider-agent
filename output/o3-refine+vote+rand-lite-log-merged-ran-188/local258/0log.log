LIMIT 20;
```

```sql
-- 5. Description: Look at different extra types (to know which ones to exclude for economy calculations)
SELECT DISTINCT "extra_type"
FROM   "extra_runs"
LIMIT 20;
```

```sql
-- 6. Description: Peek at runs scored off the bat for a handful of deliveries
SELECT *
FROM   "batsman_scored"
LIMIT 20;
```

```sql
-- 7. Description: Sample view of how many runs (off the bat) a bowler concedes in one match  
--    (sum of batsman_scored where he is the bowler)
SELECT bb."bowler",
       bb."match_id",
       SUM(bs."runs_scored") AS runs_off_bat
FROM   "ball_by_ball" AS bb
JOIN   "batsman_scored" AS bs
  ON   bb."match_id" = bs."match_id"
 AND   bb."over_id"  = bs."over_id"
 AND   bb."ball_id"  = bs."ball_id"
GROUP BY bb."bowler", bb."match_id"
LIMIT 20;
```

```sql
-- 8. Description: Count how many wickets each bowler gets in a single match (excluding run-outs etc.)
SELECT bb."bowler",
       bb."match_id",
       COUNT(*) AS wickets_in_match
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
  ON   wt."match_id" = bb."match_id"
 AND   wt."over_id"  = bb."over_id"
 AND   wt."ball_id"  = bb."ball_id"
WHERE  wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')  -- adjust if needed
GROUP BY bb."bowler", bb."match_id"
LIMIT 20;
```

```sql
-- 9. Description: Retrieve total balls bowled by each bowler in a season (useful for strike-rate)
SELECT bb."bowler",
       m."season_id",
       COUNT(*) AS balls_bowled
FROM   "ball_by_ball" AS bb
JOIN   "match" AS m
  ON   bb."match_id" = m."match_id"
GROUP BY bb."bowler", m."season_id"
LIMIT 20;
```

```sql
-- 10. Description: Combine wickets and runs conceded for one bowler across all his matches (quick sanity check)
SELECT bow."player_name",
       agg.*
FROM (
     SELECT bb."bowler"           AS player_id,
            COUNT(*)              AS balls_bowled,
            SUM(bs."runs_scored") AS runs_off_bat,
            SUM(CASE WHEN wt."kind_out" IS NOT NULL
                      AND wt."kind_out" NOT IN ('run out','retired hurt','obstructing the field')
                      THEN 1 ELSE 0 END) AS wickets
     FROM   "ball_by_ball" AS bb
     LEFT JOIN "batsman_scored" AS bs
       ON bb."match_id" = bs."match_id"
      AND bb."over_id"  = bs."over_id"
      AND bb."ball_id"  = bs."ball_id"
     LEFT JOIN "wicket_taken" AS wt
       ON bb."match_id" = wt."match_id"
      AND bb."over_id"  = wt."over_id"
      AND bb."ball_id"  = wt."ball_id"
     GROUP BY bb."bowler"
) AS agg
JOIN "player" AS bow
  ON agg."player_id" = bow."player_id"
LIMIT 20;
```
