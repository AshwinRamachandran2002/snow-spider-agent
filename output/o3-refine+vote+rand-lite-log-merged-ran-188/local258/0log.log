```sql
-- 2. Description: Look at a few dismissals together with the corresponding ball information  
--    (helps confirm the column-to-column relationship between wicket_taken and ball_by_ball)
SELECT wt."match_id",
       wt."over_id",
       wt."ball_id",
       wt."player_out",
       bb."bowler",
       wt."kind_out"
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
  ON   wt."match_id" = bb."match_id"
 AND   wt."over_id"  = bb."over_id"
 AND   wt."ball_id"  = bb."ball_id"
LIMIT 20;
```

```sql
-- 3. Description: List some distinct bowler-ids appearing in ball_by_ball
SELECT DISTINCT "bowler"
FROM   "ball_by_ball"
LIMIT 20;
```

```sql
-- 4. Description: Map a few bowler-ids to their names (bowler -> player table)
SELECT DISTINCT p."player_id",
       p."player_name"
FROM   "player" AS p
