-- 10. Description: Combine wickets and runs conceded for one bowler across all his matches (quick sanity check)
SELECT bow."player_name",
       agg.*
FROM (
     SELECT bb."bowler"           AS player_id,
            COUNT(*)              AS balls_bowled,
            SUM(bs."runs_scored") AS runs_off_bat,
            SUM(CASE WHEN wt."kind_out" IS NOT NULL
                      AND wt."kind_out" NOT IN ('run out','retired hurt','obstructing the field')
                      THEN 1 ELSE 0 END) AS wickets
     FROM   "ball_by_ball" AS bb
     LEFT JOIN "batsman_scored" AS bs
       ON bb."match_id" = bs."match_id"
      AND bb."over_id"  = bs."over_id"
      AND bb."ball_id"  = bs."ball_id"
     LEFT JOIN "wicket_taken" AS wt
       ON bb."match_id" = wt."match_id"
      AND bb."over_id"  = wt."over_id"
      AND bb."ball_id"  = wt."ball_id"
     GROUP BY bb."bowler"
) AS agg
JOIN "player" AS bow
  ON agg."player_id" = bow."player_id"
LIMIT 20;
