```sql
--Description: 1) Inspect the different kinds of dismissals recorded so we can later exclude ones not credited to the bowler (e.g. run-outs).
SELECT DISTINCT kind_out
FROM wicket_taken
LIMIT 20;
```

```sql
--Description: 2) Display a few wicket events together with the bowler who delivered the ball (join wicket_taken ↔ ball_by_ball).
SELECT wt.match_id,
       wt.over_id,
       wt.ball_id,
       bb.bowler,
       wt.player_out,
       wt.kind_out
FROM wicket_taken AS wt
JOIN ball_by_ball AS bb
  ON bb.match_id = wt.match_id
 AND bb.over_id  = wt.over_id
 AND bb.ball_id  = wt.ball_id
LIMIT 20;
```

```sql
--Description: 3) Get the player names corresponding to the bowler ids seen above.
SELECT DISTINCT p.player_id,
       p.player_name
FROM player AS p
JOIN ball_by_ball AS bb
  ON p.player_id = bb.bowler
LIMIT 20;
```

```sql
--Description: 4) Look at the extra types so we know which runs to ignore when calculating economy (ignore wides, no-balls, leg-byes, byes).
SELECT DISTINCT extra_type
FROM extra_runs
LIMIT 20;
```

```sql
--Description: 5) Sample of deliveries with the runs scored off the bat (batsman_scored) and who bowled them.
SELECT bb.match_id,
       bb.over_id,
       bb.ball_id,
       bb.bowler,
       bs.runs_scored
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs
  ON bb.match_id = bs.match_id
 AND bb.over_id  = bs.over_id
 AND bb.ball_id  = bs.ball_id
LIMIT 20;
```

```sql
--Description: 6) Aggregate: total wickets credited to every bowler (excluding run-outs & other non-bowler dismissals).
SELECT bb.bowler,
       COUNT(*) AS wickets
FROM wicket_taken AS wt
JOIN ball_by_ball AS bb
  ON (wt.match_id, wt.over_id, wt.ball_id) = (bb.match_id, bb.over_id, bb.ball_id)
WHERE wt.kind_out NOT IN ('run out', 'retired hurt', 'obstructing the field')  -- adjust list after inspecting #1
GROUP BY bb.bowler
ORDER BY wickets DESC
LIMIT 20;
```

```sql
--Description: 7) Aggregate: total runs conceded (off the bat only) and balls bowled for each bowler.
SELECT bb.bowler,
       COUNT(*)                            AS balls_bowled,
       SUM(bs.runs_scored)                 AS runs_conceded_bat
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs
  ON (bb.match_id, bb.over_id, bb.ball_id) = (bs.match_id, bs.over_id, bs.ball_id)
GROUP BY bb.bowler
LIMIT 20;
```

```sql
--Description: 8) Combine runs and wickets to compute economy (runs / overs) and strike-rate (balls / wicket) for bowlers with ≥1 wicket.
SELECT t.bowler,
       t.balls_bowled,
       t.runs_conceded_bat,
       w.wickets,
       ROUND(t.runs_conceded_bat / (t.balls_bowled / 6.0), 2) AS economy,
       ROUND(t.balls_bowled * 1.0 / w.wickets, 2)            AS strike_rate
FROM (
      SELECT bb.bowler,
             COUNT(*)  AS balls_bowled,
             SUM(bs.runs_scored) AS runs_conceded_bat
      FROM ball_by_ball AS bb
      JOIN batsman_scored AS bs
        ON (bb.match_id, bb.over_id, bb.ball_id) = (bs.match_id, bs.over_id, bs.ball_id)
      GROUP BY bb.bowler
     ) AS t
JOIN (
      SELECT bb.bowler,
             COUNT(*) AS wickets
      FROM wicket_taken AS wt
      JOIN ball_by_ball AS bb
        ON (wt.match_id, wt.over_id, wt.ball_id) = (bb.match_id, bb.over_id, bb.ball_id)
      WHERE wt.kind_out NOT IN ('run out', 'retired hurt', 'obstructing the field')
      GROUP BY bb.bowler
     ) AS w
  ON t.bowler = w.bowler
LIMIT 20;
```

```sql
--Description: 9) Determine each bowler’s best figures in a single match (most wickets, show wickets and runs).
SELECT perf.bowler,
       perf.match_id,
       perf.wkts,
       perf.runs,
       printf('%d-%d', perf.wkts, perf.runs) AS best_figures
FROM (
      SELECT bb.bowler,
             bb.match_id,
             COUNT(CASE WHEN wt.kind_out NOT IN ('run out','retired hurt','obstructing the field') THEN 1 END) AS wkts,
             SUM(bs.runs_scored) AS runs
      FROM ball_by_ball AS bb
      LEFT JOIN wicket_taken AS wt
        ON (bb.match_id, bb.over_id, bb.ball_id) = (wt.match_id, wt.over_id, wt.ball_id)
      JOIN batsman_scored AS bs
        ON (bb.match_id, bb.over_id, bb.ball_id) = (bs.match_id, bs.over_id, bs.ball_id)
      GROUP BY bb.bowler, bb.match_id
     ) AS perf
ORDER BY perf.wkts DESC, perf.runs ASC
LIMIT 20;
```

```sql
--Description: 10) Final comprehensive view: bring together name, total wickets, economy, strike-rate, and best bowling in one query.
SELECT p.player_name,
       agg.wickets,
       ROUND(agg.runs_conceded_bat / (agg.balls_bowled / 6.0), 2) AS economy,
       ROUND(agg.balls_bowled * 1.0 / agg.wickets, 2)            AS strike_rate,
       best.best_figures
FROM (
      SELECT t.bowler,
             t.balls_bowled,
             t.runs_conceded_bat,
             w.wickets
      FROM (
            SELECT bb.bowler,
                   COUNT(*)  AS balls_bowled,
                   SUM(bs.runs_scored) AS runs_conceded_bat
            FROM ball_by_ball AS bb
            JOIN batsman_scored AS bs
              ON (bb.match_id, bb.over_id, bb.ball_id) = (bs.match_id, bs.over_id, bs.ball_id)
            GROUP BY bb.bowler
           ) AS t
      JOIN (
            SELECT bb.bowler,
                   COUNT(*) AS wickets
            FROM wicket_taken AS wt
            JOIN ball_by_ball AS bb
              ON (wt.match_id, wt.over_id, wt.ball_id) = (bb.match_id, bb.over_id, bb.ball_id)
            WHERE wt.kind_out NOT IN ('run out','retired hurt','obstructing the field')
            GROUP BY bb.bowler
           ) AS w
        ON t.bowler = w.bowler
     ) AS agg
JOIN player AS p
  ON p.player_id = agg.bowler
JOIN (
      SELECT b.bowler,
             printf('%d-%d', b.wkts, b.runs) AS best_figures
      FROM (
            SELECT bb.bowler,
                   bb.match_id,
                   COUNT(CASE WHEN wt.kind_out NOT IN ('run out','retired hurt','obstructing the field') THEN 1 END) AS wkts,
                   SUM(bs.runs_scored) AS runs,
                   ROW_NUMBER() OVER (PARTITION BY bb.bowler ORDER BY COUNT(CASE WHEN wt.kind_out NOT IN ('run out','retired hurt','obstructing the field') THEN 1 END) DESC,
                                                               SUM(bs.runs_scored)) AS rn
            FROM ball_by_ball AS bb
            LEFT JOIN wicket_taken AS wt
              ON (bb.match_id, bb.over_id, bb.ball_id) = (wt.match_id, wt.over_id, wt.ball_id)
            JOIN batsman_scored AS bs
              ON (bb.match_id, bb.over_id, bb.ball_id) = (bs.match_id, bs.over_id, bs.ball_id)
            GROUP BY bb.bowler, bb.match_id
           ) AS b
      WHERE b.rn = 1
     ) AS best
  ON best.bowler = agg.bowler
ORDER BY agg.wickets DESC
LIMIT 20;
```
