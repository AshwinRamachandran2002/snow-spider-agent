-- 8. Description: Combine balls bowled and wickets to compute strike-rate (balls per wicket) for bowlers with ≥1 wicket.
SELECT b."bowler",
       b."balls_bowled",
       w."wickets",
       ROUND(1.0 * b."balls_bowled" / w."wickets", 2) AS "strike_rate"
FROM  (SELECT "bowler", COUNT(*) AS "balls_bowled"
       FROM   "ball_by_ball"
       GROUP  BY "bowler") AS b
JOIN  (SELECT bb."bowler", COUNT(*) AS "wickets"
       FROM   "wicket_taken" AS wt
       JOIN   "ball_by_ball" AS bb
              ON wt."match_id" = bb."match_id"
             AND wt."over_id"  = bb."over_id"
             AND wt."ball_id"  = bb."ball_id"
       WHERE  wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
       GROUP  BY bb."bowler") AS w
  ON b."bowler" = w."bowler"
ORDER BY "strike_rate"
LIMIT 20;
