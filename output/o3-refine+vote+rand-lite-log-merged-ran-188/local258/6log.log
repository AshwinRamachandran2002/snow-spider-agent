```sql
-- 1. Description: Look at the different kinds of dismissals recorded so we know which ones to exclude (e.g. run-out).
SELECT DISTINCT "kind_out"
FROM "wicket_taken"
LIMIT 20;
```

```sql
-- 2. Description: Retrieve 20 sample wicket deliveries together with the bowler who delivered the ball.
SELECT wt."match_id",
       wt."over_id",
       wt."ball_id",
       bb."bowler",
       wt."player_out",
       wt."kind_out"
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
       ON wt."match_id" = bb."match_id"
      AND wt."over_id"  = bb."over_id"
      AND wt."ball_id"  = bb."ball_id"
LIMIT 20;
```

```sql
-- 3. Description: Inspect the different kinds of extra runs so we can ignore wides & no-balls when computing economy.
SELECT DISTINCT "extra_type"
FROM   "extra_runs"
LIMIT 20;
```

```sql
-- 4. Description: Show 20 sample deliveries with (a) the bowler, (b) runs scored off the bat and (c) any extra runs.
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."bowler",
       bs."runs_scored",
       er."extra_runs",
       er."extra_type"
FROM   "ball_by_ball" AS bb
LEFT JOIN "batsman_scored" AS bs
       ON bs."match_id" = bb."match_id"
      AND bs."over_id"  = bb."over_id"
      AND bs."ball_id"  = bb."ball_id"
LEFT JOIN "extra_runs" AS er
       ON er."match_id" = bb."match_id"
      AND er."over_id"  = bb."over_id"
      AND er."ball_id"  = bb."ball_id"
LIMIT 20;
```

```sql
-- 5. Description: Count total balls bowled by each bowler (all formats, no filtering yet).
SELECT bb."bowler",
       COUNT(*) AS "balls_bowled"
FROM   "ball_by_ball" AS bb
GROUP  BY bb."bowler"
ORDER  BY "balls_bowled" DESC
LIMIT 20;
```

```sql
-- 6. Description: Compute total runs conceded off the bat by each bowler (ignoring extras).
SELECT bb."bowler",
       SUM(COALESCE(bs."runs_scored",0)) AS "runs_conceded_off_bat"
FROM   "ball_by_ball" AS bb
LEFT JOIN "batsman_scored" AS bs
       ON bs."match_id" = bb."match_id"
      AND bs."over_id"  = bb."over_id"
      AND bs."ball_id"  = bb."ball_id"
GROUP  BY bb."bowler"
ORDER  BY "runs_conceded_off_bat" DESC
LIMIT 20;
```

```sql
-- 7. Description: Count how many wickets each bowler took (excluding run-outs & other kinds not credited to bowler).
SELECT bb."bowler",
       COUNT(*) AS "wickets"
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
       ON wt."match_id" = bb."match_id"
      AND wt."over_id"  = bb."over_id"
      AND wt."ball_id"  = bb."ball_id"
WHERE  wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field') 
GROUP  BY bb."bowler"
ORDER  BY "wickets" DESC
LIMIT 20;
```

```sql
-- 8. Description: Combine balls bowled and wickets to compute strike-rate (balls per wicket) for bowlers with ≥1 wicket.
SELECT b."bowler",
       b."balls_bowled",
       w."wickets",
       ROUND(1.0 * b."balls_bowled" / w."wickets", 2) AS "strike_rate"
FROM  (SELECT "bowler", COUNT(*) AS "balls_bowled"
       FROM   "ball_by_ball"
       GROUP  BY "bowler") AS b
JOIN  (SELECT bb."bowler", COUNT(*) AS "wickets"
       FROM   "wicket_taken" AS wt
       JOIN   "ball_by_ball" AS bb
              ON wt."match_id" = bb."match_id"
             AND wt."over_id"  = bb."over_id"
             AND wt."ball_id"  = bb."ball_id"
       WHERE  wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
       GROUP  BY bb."bowler") AS w
  ON b."bowler" = w."bowler"
ORDER BY "strike_rate"
LIMIT 20;
```

```sql
-- 9. Description: Find each bowler’s best wicket haul in a single match (wickets & runs conceded off the bat).
SELECT perf."bowler",
       MAX(perf."wickets")  AS "best_wkts",
       MIN(perf."runs_when_best") AS "runs_in_best",
       MAX(perf."wickets") || '-' || MIN(perf."runs_when_best") AS "best_figures"
FROM (
       SELECT bb."bowler",
              bb."match_id",
              COUNT(wt."player_out") AS "wickets",
              SUM(COALESCE(bs."runs_scored",0)) AS "runs_when_best"
       FROM   "ball_by_ball" AS bb
       LEFT JOIN "batsman_scored" AS bs
              ON bs."match_id" = bb."match_id"
             AND bs."over_id"  = bb."over_id"
             AND bs."ball_id"  = bb."ball_id"
       LEFT JOIN "wicket_taken" AS wt
              ON wt."match_id" = bb."match_id"
             AND wt."over_id"  = bb."over_id"
             AND wt."ball_id"  = bb."ball_id"
             AND wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
       GROUP  BY bb."bowler", bb."match_id"
) AS perf
GROUP BY perf."bowler"
LIMIT 20;
```

```sql
-- 10. Description: Assemble full bowling summary: wickets, economy (runs per over), strike-rate and best figures.
SELECT p."player_name",
       summary."wickets"                    AS "total_wkts",
       ROUND(1.0 * summary."runs" / summary."overs", 2)  AS "economy",
       ROUND(1.0 * summary."balls" / summary."wickets",2) AS "strike_rate",
       best."best_figures"
FROM (
      SELECT bb."bowler",
             COUNT(*)                        AS "balls",
             COUNT(*)/6.0                    AS "overs",
             SUM(COALESCE(bs."runs_scored",0)) AS "runs",
             SUM(CASE WHEN wt."player_out" IS NOT NULL THEN 1 ELSE 0 END) AS "wickets"
      FROM   "ball_by_ball" AS bb
      LEFT JOIN "batsman_scored" AS bs
             ON bs."match_id" = bb."match_id"
            AND bs."over_id"  = bb."over_id"
            AND bs."ball_id"  = bb."ball_id"
      LEFT JOIN "wicket_taken" AS wt
             ON wt."match_id" = bb."match_id"
            AND wt."over_id"  = bb."over_id"
            AND wt."ball_id"  = bb."ball_id"
            AND wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
      GROUP  BY bb."bowler"
      HAVING SUM(CASE WHEN wt."player_out" IS NOT NULL THEN 1 END) > 0
) AS summary
JOIN (
      SELECT perf."bowler",
             MAX(perf."wickets") || '-' || MIN(perf."runs_when_best") AS "best_figures"
      FROM (
            SELECT bb."bowler",
                   bb."match_id",
                   COUNT(wt."player_out") AS "wickets",
                   SUM(COALESCE(bs."runs_scored",0)) AS "runs_when_best"
            FROM   "ball_by_ball" AS bb
            LEFT JOIN "batsman_scored" AS bs
                   ON bs."match_id" = bb."match_id"
                  AND bs."over_id"  = bb."over_id"
                  AND bs."ball_id"  = bb."ball_id"
            LEFT JOIN "wicket_taken" AS wt
                   ON wt."match_id" = bb."match_id"
                  AND wt."over_id"  = bb."over_id"
                  AND wt."ball_id"  = bb."ball_id"
                  AND wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
            GROUP  BY bb."bowler", bb."match_id"
      ) AS perf
      GROUP BY perf."bowler"
) AS best
  ON summary."bowler" = best."bowler"
JOIN "player" AS p
  ON p."player_id"   = summary."bowler"
ORDER BY summary."wickets" DESC
LIMIT 20;
```
