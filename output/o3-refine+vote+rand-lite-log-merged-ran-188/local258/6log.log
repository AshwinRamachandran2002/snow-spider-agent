-- 10. Description: Assemble full bowling summary: wickets, economy (runs per over), strike-rate and best figures.
SELECT p."player_name",
       summary."wickets"                    AS "total_wkts",
       ROUND(1.0 * summary."runs" / summary."overs", 2)  AS "economy",
       ROUND(1.0 * summary."balls" / summary."wickets",2) AS "strike_rate",
       best."best_figures"
FROM (
      SELECT bb."bowler",
             COUNT(*)                        AS "balls",
             COUNT(*)/6.0                    AS "overs",
             SUM(COALESCE(bs."runs_scored",0)) AS "runs",
             SUM(CASE WHEN wt."player_out" IS NOT NULL THEN 1 ELSE 0 END) AS "wickets"
      FROM   "ball_by_ball" AS bb
      LEFT JOIN "batsman_scored" AS bs
             ON bs."match_id" = bb."match_id"
            AND bs."over_id"  = bb."over_id"
            AND bs."ball_id"  = bb."ball_id"
      LEFT JOIN "wicket_taken" AS wt
             ON wt."match_id" = bb."match_id"
            AND wt."over_id"  = bb."over_id"
            AND wt."ball_id"  = bb."ball_id"
            AND wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
      GROUP  BY bb."bowler"
      HAVING SUM(CASE WHEN wt."player_out" IS NOT NULL THEN 1 END) > 0
) AS summary
JOIN (
      SELECT perf."bowler",
             MAX(perf."wickets") || '-' || MIN(perf."runs_when_best") AS "best_figures"
      FROM (
            SELECT bb."bowler",
                   bb."match_id",
                   COUNT(wt."player_out") AS "wickets",
                   SUM(COALESCE(bs."runs_scored",0)) AS "runs_when_best"
            FROM   "ball_by_ball" AS bb
            LEFT JOIN "batsman_scored" AS bs
                   ON bs."match_id" = bb."match_id"
                  AND bs."over_id"  = bb."over_id"
                  AND bs."ball_id"  = bb."ball_id"
