```sql
-- 1. Description: Look at the different dismissal kinds recorded in the wicket_taken table
SELECT DISTINCT kind_out
FROM wicket_taken
LIMIT 20;
```

```sql
-- 2. Description: Inspect a few rows in wicket_taken together with the innings number
SELECT *
FROM wicket_taken
LIMIT 20;
```

```sql
-- 3. Description: Join wicket_taken to ball_by_ball to see who the bowler was for each dismissal
SELECT wt.match_id,
       wt.over_id,
       wt.ball_id,
       wt.player_out,
       wt.kind_out,
       bb.bowler
FROM wicket_taken AS wt
JOIN ball_by_ball AS bb
  ON wt.match_id = bb.match_id
 AND wt.over_id  = bb.over_id
 AND wt.ball_id  = bb.ball_id
LIMIT 20;
```

```sql
-- 4. Description: Get a list of bowlers who have taken at least one wicket (excluding run-outs)
SELECT DISTINCT bb.bowler
FROM wicket_taken AS wt
JOIN ball_by_ball AS bb
  ON wt.match_id = bb.match_id
 AND wt.over_id  = bb.over_id
 AND wt.ball_id  = bb.ball_id
WHERE wt.kind_out NOT LIKE '%run%'
LIMIT 20;
```

```sql
-- 5. Description: Inspect bat-runs (off the bat only) delivered by a bowler on the same ball
SELECT bb.match_id,
       bb.over_id,
       bb.ball_id,
       bb.bowler,
       bs.runs_scored
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs
  ON bb.match_id = bs.match_id
 AND bb.over_id  = bs.over_id
 AND bb.ball_id  = bs.ball_id
LIMIT 20;
```

```sql
-- 6. Description: Aggregate total runs conceded off the bat by each bowler in one match
SELECT bb.match_id,
       bb.bowler,
       SUM(bs.runs_scored) AS runs_conceded_off_bat
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs
  ON bb.match_id = bs.match_id
 AND bb.over_id  = bs.over_id
 AND bb.ball_id  = bs.ball_id
GROUP BY bb.match_id, bb.bowler
LIMIT 20;
```

```sql
-- 7. Description: Count legal deliveries (balls bowled) by each bowler in a match
SELECT bb.match_id,
       bb.bowler,
       COUNT(*) AS balls_bowled
FROM ball_by_ball AS bb
GROUP BY bb.match_id, bb.bowler
LIMIT 20;
```

```sql
-- 8. Description: Count wickets (excluding run-outs) taken by each bowler in a match
SELECT bb.match_id,
       bb.bowler,
       COUNT(*) AS wickets_in_match
FROM wicket_taken AS wt
JOIN ball_by_ball AS bb
  ON wt.match_id = bb.match_id
 AND wt.over_id  = bb.over_id
 AND wt.ball_id  = bb.ball_id
WHERE wt.kind_out NOT LIKE '%run%'
GROUP BY bb.match_id, bb.bowler
LIMIT 20;
```

```sql
-- 9. Description: Overall career summary – balls bowled, runs conceded off the bat, wickets for every bowler
SELECT bb.bowler,
       COUNT(*)                      AS total_balls,
       SUM(bs.runs_scored)           AS total_runs_off_bat,
       SUM(CASE WHEN wt.kind_out NOT LIKE '%run%' THEN 1 ELSE 0 END) AS total_wkts
FROM ball_by_ball AS bb
LEFT JOIN batsman_scored AS bs
       ON bb.match_id = bs.match_id
      AND bb.over_id  = bs.over_id
      AND bb.ball_id  = bs.ball_id
LEFT JOIN wicket_taken AS wt
       ON bb.match_id = wt.match_id
      AND bb.over_id  = wt.over_id
      AND bb.ball_id  = wt.ball_id
GROUP BY bb.bowler
LIMIT 20;
```

```sql
-- 10. Description: Identify the bowler’s best bowling figure in any match (most wickets, then fewest runs)
WITH per_match AS (
  SELECT bb.bowler,
         bb.match_id,
         COUNT(*) FILTER (WHERE wt.kind_out NOT LIKE '%run%') AS wkts,
         SUM(bs.runs_scored) AS runs_off_bat
  FROM ball_by_ball AS bb
  LEFT JOIN batsman_scored AS bs
         ON bb.match_id = bs.match_id
        AND bb.over_id  = bs.over_id
        AND bb.ball_id  = bs.ball_id
  LEFT JOIN wicket_taken AS wt
         ON bb.match_id = wt.match_id
        AND bb.over_id  = wt.over_id
        AND bb.ball_id  = wt.ball_id
  GROUP BY bb.bowler, bb.match_id
)
SELECT p.bowler,
       p.match_id,
       p.wkts,
       p.runs_off_bat,
       printf('%d-%d', p.wkts, p.runs_off_bat) AS best_fig
FROM per_match AS p
ORDER BY p.wkts DESC, p.runs_off_bat ASC
LIMIT 20;
```
