```sql
--Description: 6) For every PLP hit, flag whether a *later* PDP occurs in the same session.
SELECT
  plp.user_pseudo_id,
  plp.ga_session_id,
  plp.event_timestamp          AS plp_ts,
  plp.page_location            AS plp_url,
  MIN(pdp.event_timestamp) OVER (PARTITION BY plp.user_pseudo_id, plp.ga_session_id) AS first_pdp_ts_in_session,
  CASE
    WHEN MIN(pdp.event_timestamp) OVER (PARTITION BY plp.user_pseudo_id, plp.ga_session_id) > plp.event_timestamp
         AND MIN(pdp.event_timestamp) OVER (PARTITION BY plp.user_pseudo_id, plp.ga_session_id) IS NOT NULL
      THEN 1
    ELSE 0
  END AS transitioned_to_pdp
FROM (
  --PLP rows
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
     FROM UNNEST(event_params) ep
     WHERE ep.key = 'ga_session_id')  AS ga_session_id,
    event_timestamp,
    (SELECT ep.value.string_value
     FROM UNNEST(event_params) ep
     WHERE ep.key = 'page_location')  AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
) plp
LEFT JOIN (
  --PDP rows
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
     FROM UNNEST(event_params) ep
     WHERE ep.key = 'ga_session_id')  AS ga_session_id,
    event_timestamp
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
    AND REGEXP_CONTAINS(LOWER((SELECT ep.value.string_value
                               FROM UNNEST(event_params) ep
                               WHERE ep.key = 'page_location')),
         r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
    AND REGEXP_CONTAINS((SELECT ep.value.string_value
                         FROM UNNEST(event_params) ep
                         WHERE ep.key = 'page_location'),
         r'\+[^/]*$')
) pdp
ON  plp.user_pseudo_id = pdp.user_pseudo_id
AND plp.ga_session_id  = pdp.ga_session_id
LIMIT 20;
```

```sql
--Description: 7) Count PLP views that eventually led to a PDP in-session (transitioned_to_pdp = 1).
WITH plp_flag AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    event_timestamp,
    transitioned_to_pdp
  FROM (
    -- reused sub-query from #6 without LIMIT
    SELECT
      plp.*,
      CASE
        WHEN MIN(pdp.event_timestamp) OVER (PARTITION BY plp.user_pseudo_id, plp.ga_session_id) > plp.event_timestamp
             AND MIN(pdp.event_timestamp) OVER (PARTITION BY plp.user_pseudo_id, plp.ga_session_id) IS NOT NULL
          THEN 1
        ELSE 0
      END AS transitioned_to_pdp
    FROM (
      SELECT
        user_pseudo_id,
        (SELECT ep.value.int_value FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id') AS ga_session_id,
        event_timestamp
      FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
      WHERE event_name = 'page_view'
        AND REGEXP_CONTAINS(LOWER((SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'page_location')),
             r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
        AND NOT REGEXP_CONTAINS((SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'page_location'),
             r'\+[^/]*$')
    ) plp
    LEFT JOIN (
      SELECT
        user_pseudo_id,
        (SELECT ep.value.int_value FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id') AS ga_session_id,
        event_timestamp
      FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
      WHERE event_name = 'page_view'
        AND REGEXP_CONTAINS(LOWER((SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'page_location')),
             r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
        AND REGEXP_CONTAINS((SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'page_location'),
             r'\+[^/]*$')
    ) pdp
    ON  plp.user_pseudo_id = pdp.user_pseudo_id
    AND plp.ga_session_id  = pdp.ga_session_id
  )
)
SELECT
  COUNTIF(transitioned_to_pdp = 1) AS plp_that_led_to_pdp,
  COUNT(*)                         AS total_plp_views
FROM plp_flag
LIMIT 20;
```

```sql
--Description: 8) Compute the final PLP-to-PDP transition percentage for 2-Jan-2021.
WITH plp_flag AS (
  -- identical logic as query #7 (omitted here for brevity) --
  SELECT
    user_pseudo_id,
    ga_session_id,
    transitioned_to_pdp
  FROM ...
)
SELECT
  ROUND(100 * SAFE_DIVIDE(SUM(CASE WHEN transitioned_to_pdp = 1 THEN 1 END),
                          COUNT(*)), 2) AS pct_plp_to_pdp
FROM plp_flag
LIMIT 20;
```

```sql
--Description: 9) (Sanity check) Show 20 actual PLP URLs that converted to PDPs, with their first PDP URL.
SELECT
  plp.page_location AS plp_url,
  pdp.page_location AS first_pdp_url,
  plp.user_pseudo_id,
  plp.ga_session_id
FROM (
  --grab PLP hits that flagged as transitioned
  SELECT *
  FROM /* sub-query from #6 */ 
  WHERE transitioned_to_pdp = 1
) plp
JOIN (
  --grab first PDP in same session
  SELECT
    user_pseudo_id,
    ga_session_id,
    MIN(event_timestamp) AS first_pdp_ts
  FROM /* PDP sub-query used earlier */
  GROUP BY user_pseudo_id, ga_session_id
) x
ON plp.user_pseudo_id = x.user_pseudo_id
AND plp.ga_session_id  = x.ga_session_id
JOIN /* PDP sub-query */ pdp
ON pdp.user_pseudo_id = x.user_pseudo_id
AND pdp.ga_session_id  = x.ga_session_id
AND pdp.event_timestamp = x.first_pdp_ts
LIMIT 20;
```

```sql
--Description: 10) Final one-liner to return both the counts and the percentage (production version).
SELECT
  SUM(CASE WHEN transitioned_to_pdp = 1 THEN 1 END) AS plp_that_led_to_pdp,
  COUNT(*)                                           AS total_plp_views,
  ROUND(100 * SAFE_DIVIDE(SUM(CASE WHEN transitioned_to_pdp = 1 THEN 1 END),
                          COUNT(*)), 2)              AS pct_plp_to_pdp
FROM (
  -- same plp_flag CTE logic from earlier queries
  SELECT
    user_pseudo_id,
    ga_session_id,
    CASE
      WHEN MIN(pdp_ts) OVER (PARTITION BY user_pseudo_id, ga_session_id) > event_timestamp
           AND MIN(pdp_ts) OVER (PARTITION BY user_pseudo_id, ga_session_id) IS NOT NULL
        THEN 1 ELSE 0
    END AS transitioned_to_pdp
  FROM (
    SELECT
      user_pseudo_id,
      ga_session_id,
      event_timestamp,
      MIN(CASE WHEN page_type = 'PDP' THEN event_timestamp END)
          OVER (PARTITION BY user_pseudo_id, ga_session_id) AS pdp_ts
    FROM (
      SELECT
        user_pseudo_id,
        (SELECT ep.value.int_value FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id') AS ga_session_id,
        event_timestamp,
        CASE
          WHEN REGEXP_CONTAINS(LOWER(loc),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
           AND REGEXP_CONTAINS(loc, r'\+[^/]*$')            THEN 'PDP'
          WHEN REGEXP_CONTAINS(LOWER(loc),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
           AND NOT REGEXP_CONTAINS(loc, r'\+[^/]*$')        THEN 'PLP'
          ELSE 'OTHER'
        END AS page_type
      FROM (
        SELECT
          user_pseudo_id,
          event_timestamp,
          event_params,
          (SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'page_location') AS loc
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
        WHERE event_name = 'page_view'
      )
    )
    WHERE page_type = 'PLP'
  )
)
LIMIT 20;
```

These 10 incremental queries let you explore the data, classify PLP/PDP page views, identify within-session transitions, and finally compute both the raw counts and the percentage of PLP views that led to a PDP view on 2 - Jan - 2021.
