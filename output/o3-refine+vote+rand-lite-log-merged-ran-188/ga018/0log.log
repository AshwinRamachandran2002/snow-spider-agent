--Description: 7) Count PLP views that eventually led to a PDP in-session (transitioned_to_pdp = 1).
WITH plp_flag AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    event_timestamp,
    transitioned_to_pdp
  FROM (
    -- reused sub-query from #6 without LIMIT
    SELECT
      plp.*,
      CASE
        WHEN MIN(pdp.event_timestamp) OVER (PARTITION BY plp.user_pseudo_id, plp.ga_session_id) > plp.event_timestamp
             AND MIN(pdp.event_timestamp) OVER (PARTITION BY plp.user_pseudo_id, plp.ga_session_id) IS NOT NULL
          THEN 1
        ELSE 0
      END AS transitioned_to_pdp
    FROM (
      SELECT
        user_pseudo_id,
        (SELECT ep.value.int_value FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id') AS ga_session_id,
        event_timestamp
      FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
      WHERE event_name = 'page_view'
        AND REGEXP_CONTAINS(LOWER((SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'page_location')),
             r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
        AND NOT REGEXP_CONTAINS((SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'page_location'),
             r'\+[^/]*$')
    ) plp
    LEFT JOIN (
      SELECT
        user_pseudo_id,
        (SELECT ep.value.int_value FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id') AS ga_session_id,
        event_timestamp
      FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
      WHERE event_name = 'page_view'
        AND REGEXP_CONTAINS(LOWER((SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'page_location')),
             r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
        AND REGEXP_CONTAINS((SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'page_location'),
             r'\+[^/]*$')
    ) pdp
    ON  plp.user_pseudo_id = pdp.user_pseudo_id
    AND plp.ga_session_id  = pdp.ga_session_id
  )
)
SELECT
  COUNTIF(transitioned_to_pdp = 1) AS plp_that_led_to_pdp,
  COUNT(*)                         AS total_plp_views
FROM plp_flag
LIMIT 20;
