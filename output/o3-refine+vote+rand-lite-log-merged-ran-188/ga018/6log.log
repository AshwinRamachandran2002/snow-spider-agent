-- 9. How many PLP page_views eventually see a PDP later in SAME session?  
WITH pageviews AS (
  SELECT  up.user_pseudo_id,
          MAX(IF(ep.key='ga_session_id', ep.value.int_value,   NULL)) AS sess,
          MAX(IF(ep.key='page_location', ep.value.string_value,NULL)) AS url,
          up.event_timestamp
  FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` up,
          UNNEST(up.event_params) ep
  WHERE   up.event_name='page_view'
  GROUP   BY 1,4
),
classified AS (
  SELECT *,
         CASE 
           WHEN REGEXP_CONTAINS(url, r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                AND REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$')  THEN 'PDP'
           WHEN REGEXP_CONTAINS(url, r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                AND NOT REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$') THEN 'PLP'
           ELSE 'OTHER'
         END AS page_type
  FROM   pageviews
),
plp_events AS (
  SELECT  c.*
  FROM    classified c
  WHERE   c.page_type = 'PLP'
),
pdp_events AS (
  SELECT  c.*
  FROM    classified c
  WHERE   c.page_type = 'PDP'
)
SELECT  COUNT(*) AS plp_views_with_subsequent_pdp
FROM    plp_events p
WHERE   EXISTS (
         SELECT 1
         FROM   pdp_events d
         WHERE  d.user_pseudo_id = p.user_pseudo_id
           AND  d.sess           = p.sess
           AND  d.event_timestamp > p.event_timestamp )
LIMIT 20;
