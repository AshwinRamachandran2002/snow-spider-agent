--Description:  End-to-end calculation, in one query, of the share of Product-Listing-Page (PLP)
--              views on 2-Jan-2021 that are followed by a Product-Detail-Page (PDP) view in
--              the same user-session.  Inline comments document each reasoning step.
WITH
/*---------------------------------------------------------------------------
 STEP 1 – Extract raw “page_view” rows with the three items we need:
          user_pseudo_id (visitor), session_id (ga_session_id), timestamp,
          and the page_location URL.
---------------------------------------------------------------------------*/
pageviews AS (
  SELECT
    ev.user_pseudo_id,
    MAX(CASE WHEN ep.key = 'ga_session_id'  THEN ep.value.int_value    END) AS session_id,
    MAX(CASE WHEN ep.key = 'page_location'  THEN ep.value.string_value END) AS url,
    ev.event_timestamp
  FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` ev
  CROSS JOIN UNNEST(ev.event_params) AS ep
  WHERE ev.event_name = 'page_view'
  GROUP BY 1, ev.event_timestamp
),
/*---------------------------------------------------------------------------
 STEP 2 – Classify each URL as PDP / PLP / OTHER using the refined rules:
          • must contain one of the category slugs
          • PDPs also contain a “+” in the last path segment
---------------------------------------------------------------------------*/
classified AS (
  SELECT
    *,
    CASE
      WHEN REGEXP_CONTAINS(LOWER(url),
           r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
       AND REGEXP_CONTAINS(LOWER(url), r'/[^/]*\+[^/]*$')
        THEN 'PDP'
      WHEN REGEXP_CONTAINS(LOWER(url),
           r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
       AND NOT REGEXP_CONTAINS(LOWER(url), r'/[^/]*\+[^/]*$')
        THEN 'PLP'
      ELSE 'OTHER'
    END AS page_type
  FROM pageviews
),
/*---------------------------------------------------------------------------
 STEP 3 – Isolate PLP and PDP events separately for easier look-ups.
---------------------------------------------------------------------------*/
plp_events AS (
  SELECT * FROM classified WHERE page_type = 'PLP'
),
pdp_events AS (
  SELECT * FROM classified WHERE page_type = 'PDP'
),
/*---------------------------------------------------------------------------
 STEP 4 – For every PLP view, flag whether a later PDP occurs in the same
          user-session (user_pseudo_id + session_id) and *after* the PLP time.
---------------------------------------------------------------------------*/
plp_flagged AS (
  SELECT
    p.*,
    EXISTS (SELECT 1
            FROM   pdp_events d
            WHERE  d.user_pseudo_id = p.user_pseudo_id
              AND  d.session_id     = p.session_id
              AND  d.event_timestamp > p.event_timestamp) AS led_to_pdp
  FROM plp_events p
)
/*---------------------------------------------------------------------------
 STEP 5 – Aggregate: total PLP views vs. those that transition to PDP,
          then compute the percentage.
---------------------------------------------------------------------------*/
SELECT
  COUNTIF(led_to_pdp)  AS plp_views_with_pdp,
  COUNT(*)             AS total_plp_views,
  ROUND(100 * COUNTIF(led_to_pdp) / COUNT(*), 2) AS pct_plp_to_pdp
FROM plp_flagged;
