Query:
--Description: Count PLP page_view events that are followed by a PDP view later in the
--             same session on 2021-01-02 (preview result limited to 20 rows).  We classify
--             every page_view, separate PLP and PDP sets, then use EXISTS to test the
--             transition for each PLP.

WITH pageviews AS (
  SELECT
    up.user_pseudo_id,
    MAX(CASE WHEN ep.key = 'ga_session_id'  THEN ep.value.int_value    END) AS session_id,
    MAX(CASE WHEN ep.key = 'page_location'  THEN ep.value.string_value END) AS url,
    up.event_timestamp
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` up
  CROSS  JOIN UNNEST(up.event_params) AS ep
  WHERE  up.event_name = 'page_view'
  GROUP  BY 1, up.event_timestamp
),
classified AS (
  SELECT *,
         CASE
           WHEN REGEXP_CONTAINS(LOWER(url),
                r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
            AND REGEXP_CONTAINS(LOWER(url), r'/[^/]*\+[^/]*$')  THEN 'PDP'
           WHEN REGEXP_CONTAINS(LOWER(url),
                r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
            AND NOT REGEXP_CONTAINS(LOWER(url), r'/[^/]*\+[^/]*$') THEN 'PLP'
           ELSE 'OTHER'
         END AS page_type
  FROM pageviews
),
plp_events AS (
  SELECT * FROM classified WHERE page_type = 'PLP'
),
pdp_events AS (
  SELECT * FROM classified WHERE page_type = 'PDP'
)
SELECT
  COUNT(*) AS plp_views_with_subsequent_pdp
FROM plp_events p
WHERE EXISTS (
  SELECT 1
  FROM   pdp_events d
  WHERE  d.user_pseudo_id = p.user_pseudo_id
    AND  d.session_id     = p.session_id      -- same session
    AND  d.event_timestamp > p.event_timestamp
)
LIMIT 20
