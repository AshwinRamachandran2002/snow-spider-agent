--Description: (Query #9) List 20 distinct PLP URLs from 2021-01-02 that were
--             followed by a PDP in the same session, for sanity checking.
WITH raw AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value FROM UNNEST(event_params) ep WHERE ep.key='ga_session_id') AS ga_session_id,
    (SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key='page_location') AS page_location,
    event_timestamp
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name='page_view'
),
pv AS (
  SELECT
    raw.*,
    REGEXP_CONTAINS(page_location,r'/[^/]*\+[^/]*$') AS is_pdp,
    (REGEXP_CONTAINS(LOWER(page_location),
       r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
     AND NOT REGEXP_CONTAINS(page_location,r'/[^/]*\+[^/]*$')) AS is_plp
  FROM raw
),
plp_with_flag AS (
  SELECT
    pv.*,
    EXISTS (
      SELECT 1
      FROM pv AS later
      WHERE later.user_pseudo_id = pv.user_pseudo_id
        AND later.ga_session_id  = pv.ga_session_id
        AND later.is_pdp         = TRUE
        AND later.event_timestamp > pv.event_timestamp
    ) AS has_pdp_after
  FROM pv
  WHERE is_plp
)
SELECT DISTINCT page_location
FROM plp_with_flag
WHERE has_pdp_after
LIMIT 20
