```sql
-- 6) For every PLP view record, mark if a later PDP exists in same user-session
WITH pv AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    page_location,
    event_timestamp,
    is_pdp,
    is_plp
  FROM (
    SELECT
      user_pseudo_id,
      (SELECT ep.value.int_value    FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id')    AS ga_session_id,
      (SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'page_location')    AS page_location,
      event_timestamp,
      REGEXP_CONTAINS(page_location, r'/[^/]*\+[^/]*$')                                            AS is_pdp,
      (REGEXP_CONTAINS(LOWER(page_location),
          r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
       AND NOT REGEXP_CONTAINS(page_location, r'/[^/]*\+[^/]*$'))                                  AS is_plp
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
    WHERE event_name = 'page_view'
  )
)
SELECT
  user_pseudo_id,
  ga_session_id,
  event_timestamp                                                   AS plp_ts,
  page_location                                                     AS plp_url,
  EXISTS (
    SELECT 1
    FROM pv p2
    WHERE p2.user_pseudo_id = pv.user_pseudo_id
      AND p2.ga_session_id   = pv.ga_session_id
      AND p2.is_pdp          = TRUE
      AND p2.event_timestamp > pv.event_timestamp
  ) AS plp_followed_by_pdp
FROM pv
WHERE is_plp = TRUE
LIMIT 20;
```

```sql
-- 7) Aggregate counts: total PLP views vs those that are followed by a PDP within session
WITH pv AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value    FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id')    AS ga_session_id,
    (SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'page_location')    AS page_location,
    event_timestamp,
    REGEXP_CONTAINS(page_location, r'/[^/]*\+[^/]*$')                                            AS is_pdp,
    (REGEXP_CONTAINS(LOWER(page_location),
        r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
     AND NOT REGEXP_CONTAINS(page_location, r'/[^/]*\+[^/]*$'))                                  AS is_plp
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
),
plp_marked AS (
  SELECT
    *,
    EXISTS (
      SELECT 1
      FROM pv p2
      WHERE p2.user_pseudo_id = pv.user_pseudo_id
        AND p2.ga_session_id   = pv.ga_session_id
        AND p2.is_pdp          = TRUE
        AND p2.event_timestamp > pv.event_timestamp
    ) AS plp_followed_by_pdp
  FROM pv
  WHERE is_plp = TRUE
)
SELECT
  COUNT(*)                                   AS total_plp_views,
  SUM(CASE WHEN plp_followed_by_pdp THEN 1 ELSE 0 END) AS plp_views_leading_to_pdp,
  ROUND(100 * SUM(CASE WHEN plp_followed_by_pdp THEN 1 ELSE 0 END) / COUNT(*), 2)
    AS pct_plp_to_pdp
FROM plp_marked
LIMIT 20;
```

```sql
-- 8) Same computation but deduplicated at session level (did session ever move from any PLP to any PDP?)
WITH pv AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value    FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id')    AS ga_session_id,
    (SELECT ep.value.string_value FROM UNNEST(event_params) ep WHERE ep.key = 'page_location')    AS page_location,
    event_timestamp,
    REGEXP_CONTAINS(page_location, r'/[^/]*\+[^/]*$')                                            AS is_pdp,
    (REGEXP_CONTAINS(LOWER(page_location),
        r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
     AND NOT REGEXP_CONTAINS(page_location, r'/[^/]*\+[^/]*$'))                                  AS is_plp
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
),
session_paths AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    MIN(CASE WHEN is_plp THEN event_timestamp END)  AS first_plp_ts,
    MIN(CASE WHEN is_pdp THEN event_timestamp END)  AS first_pdp_ts
  FROM pv
  GROUP BY user_pseudo_id, ga_session_id
)
SELECT
  COUNTIF(first_plp_ts IS NOT NULL)                                         AS sessions_with_plp,
  COUNTIF(first_plp_ts IS NOT NULL AND first_pdp_ts > first_plp_ts)         AS sessions_plp_to_pdp,
  ROUND(100 * COUNTIF(first_plp_ts IS NOT NULL AND first_pdp_ts > first_plp_ts)
/ NULLIF(COUNTIF(first_plp_ts IS NOT NULL),0), 2)                           AS pct_sessions_plp_to_pdp
FROM session_paths
LIMIT 20;
```

