```sql
--Description: To prevent the “Unrecognized name: page_location” error we must
--             first select page_location (and any other extracted parameters)
--             in an inner CTE, then reference that column in an outer layer
--             where we add the PLP/PDP flags.  This single query therefore:
--             1) Pulls 2-Jan-2021 page_view rows and extracts ga_session_id
--                and page_location (CTE raw).
--             2) Calculates two Boolean flags:
--                   • is_pdp  – URL’s last segment contains a ‘+’.
--                   • is_plp  – URL contains any category keyword (case-insensitive)
--                               AND the last segment does NOT contain ‘+’.
--             3) Returns only rows flagged as PLP or PDP, limited to 20 so we
--                can visually confirm the classification logic.
WITH raw AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
     FROM UNNEST(event_params) ep
