```sql
--Description / Thinking process:
-- We want to see sample Product-Detail-Page (PDP) URLs for 2-Jan-2021.
--  • Step 1: pull only `page_view` events from the table for that date.
--  • Step 2: extract the value of the `page_location` parameter (it sits in
--           the repeated `event_params` array).
--  • Step 3: derive just the “path” part of the URL (everything after the host)
--           using REGEXP_EXTRACT; we need this to test the last segment.
--  • Step 4: filter for rows whose FINAL path-segment contains a “+”,
--           our heuristic for PDP pages.
--  • Step 5: return DISTINCT examples (plus the path for clarity) and LIMIT 20.

WITH pageviews AS (
  SELECT
    (SELECT ep.value.string_value
     FROM UNNEST(event_params) AS ep
     WHERE ep.key = 'page_location') AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
)
SELECT DISTINCT
  page_location,
  REGEXP_EXTRACT(page_location, r'https?://[^/]+(/.*)') AS path_after_host
FROM pageviews
WHERE REGEXP_CONTAINS(
        REGEXP_EXTRACT(page_location, r'https?://[^/]+(/.*)'),
        r'/[^/]*\+[^/]*$'          -- “last segment has a plus”
      )
LIMIT 20;
