--Description: Inspect how to identify sessions – show user_pseudo_id,
--             ga_session_id, timestamp and URL for sample page_views.  
SELECT
  user_pseudo_id,
  (SELECT ep.value.int_value
   FROM UNNEST(event_params) AS ep
   WHERE ep.key = 'ga_session_id') AS ga_session_id,
