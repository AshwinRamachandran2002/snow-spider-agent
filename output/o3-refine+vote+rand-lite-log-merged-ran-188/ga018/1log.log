--Description / Thinking process:
-- FINAL STEP – in one query produce the three key numbers for 2-Jan-2021:
--   1) total number of PLP page_view rows
--   2) number of those PLP rows that belong to sessions which also contain ≥1 PDP
--   3) the PLP-to-PDP transition percentage
--
-- Approach
--   • CTE base ............. extract user_pseudo_id, ga_session_id, page_location.
--   • CTE pageviews ........ classify each row as ‘PLP’ or ‘PDP’ (or NULL).
--   • CTE sessions_with_pdp  list distinct sessions that include a PDP.
--   • Final SELECT ......... COUNT the PLP rows overall and within the
--                            sessions_with_pdp list, then compute the %
--                            with SAFE_DIVIDE to avoid division-by-zero.

WITH base AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'ga_session_id')                         AS ga_session_id,
    (SELECT ep.value.string_value
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'page_location')                         AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
),
pageviews AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    CASE
      WHEN REGEXP_CONTAINS(
             LOWER(page_location),
             r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables))/'
           )
        AND NOT REGEXP_CONTAINS(
              REGEXP_EXTRACT(page_location, r'https?://[^/]+(/.*)'),
              r'/[^/]*\+[^/]*$'
            )                            THEN 'PLP'
      WHEN REGEXP_CONTAINS(
             REGEXP_EXTRACT(page_location, r'https?://[^/]+(/.*)'),
             r'/[^/]*\+[^/]*$'
           )                            THEN 'PDP'
    END AS page_type
  FROM base
),
sessions_with_pdp AS (
  SELECT DISTINCT user_pseudo_id, ga_session_id
  FROM pageviews
  WHERE page_type = 'PDP'
)
SELECT
  COUNTIF(page_type = 'PLP') AS total_plp_views,
  COUNTIF(
    page_type = 'PLP'
    AND (user_pseudo_id, ga_session_id) IN (
          SELECT user_pseudo_id, ga_session_id FROM sessions_with_pdp
        )
  )                         AS plp_views_with_pdp,
  SAFE_DIVIDE(
    COUNTIF(
      page_type = 'PLP'
      AND (user_pseudo_id, ga_session_id) IN (
            SELECT user_pseudo_id, ga_session_id FROM sessions_with_pdp
          )
    ),
    COUNTIF(page_type = 'PLP')
  ) * 100                   AS plp_to_pdp_percentage
FROM pageviews;
