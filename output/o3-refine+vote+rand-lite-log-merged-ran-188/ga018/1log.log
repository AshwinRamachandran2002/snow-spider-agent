```sql
--Description / Thinking process:
-- Compute the PLP-to-PDP transition rate for 2-Jan-2021 in one shot.
--   1) CTE base            – extract user_pseudo_id, ga_session_id, and page_location
--                            from every page_view event on that date.
--   2) CTE pageviews       – classify each URL as ‘PLP’ or ‘PDP’ using
--                            category-regex + “+” logic.
--   3) CTE sessions_with_pdp – list DISTINCT sessions that include ≥1 PDP view.
--   4) Final SELECT        – count
--         • total PLP views
--         • PLP views that belong to sessions in sessions_with_pdp
--         • percentage  (SAFE_DIVIDE to avoid div-by-zero).
WITH base AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'ga_session_id')                    AS ga_session_id,
    (SELECT ep.value.string_value
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'page_location')                    AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
),
pageviews AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    CASE
      WHEN REGEXP_CONTAINS(
             LOWER(page_location),
             r'/((accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables))/')
        AND NOT REGEXP_CONTAINS(
              REGEXP_EXTRACT(page_location, r'https?://[^/]+(/.*)'), r'/[^/]*\+[^/]*$')
      THEN 'PLP'
      WHEN REGEXP_CONTAINS(
             REGEXP_EXTRACT(page_location, r'https?://[^/]+(/.*)'), r'/[^/]*\+[^/]*$')
      THEN 'PDP'
    END AS page_type
  FROM base
),
sessions_with_pdp AS (
  SELECT DISTINCT user_pseudo_id, ga_session_id
  FROM pageviews
  WHERE page_type = 'PDP'
)
SELECT
  COUNTIF(page_type = 'PLP')                                                            AS total_plp_views,
  COUNTIF(page_type = 'PLP'
          AND (user_pseudo_id, ga_session_id) IN (SELECT * FROM sessions_with_pdp))     AS plp_views_with_pdp,
  SAFE_DIVIDE(
      COUNTIF(page_type = 'PLP'
              AND (user_pseudo_id, ga_session_id) IN (SELECT * FROM sessions_with_pdp)),
      COUNTIF(page_type = 'PLP')
  ) * 100                                                                               AS plp_to_pdp_percentage
FROM pageviews;
```
