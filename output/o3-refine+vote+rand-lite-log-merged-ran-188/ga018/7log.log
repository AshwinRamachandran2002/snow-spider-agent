--Description:  Goal → “What % of Product-Listing-Page (PLP) views on 2021-01-02
--  were followed by at least one Product-Detail-Page (PDP) view later in the
--  *same* GA4 session?”
--
--  Thinking process, step-by-step (all executed inside this single query):
--  1. base      – pull every page_view on 2021-01-02, extracting:
--                 • user_pseudo_id  • ga_session_id  • event_timestamp
--                 • page_location URL  (alias = url)
--  2. classified – add a ‘page_type’ label using the supplied PLP/PDP rules:
--                 • ≥5 URL segments
--                 • segment-4 or segment-5 matches category list
--                 • “+” in last segment ⇒ PDP, otherwise ⇒ PLP
--  3. first_pdp – for each (user,session) keep the earliest PDP timestamp.
--  4. plp_flags – join every PLP view to first_pdp; flag TRUE when the PLP
--                 occurred *before* that PDP (i.e. led_to_pdp).
--  5. final     – aggregate:
--                 • total PLP views
--                 • PLP views that led_to_pdp = TRUE
--                 • % = led / total
--
--  The result is a single row with the requested percentage.
WITH base AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
       FROM UNNEST(event_params) ep
      WHERE ep.key = 'ga_session_id')                AS session_id,
    event_timestamp,
    (SELECT ep.value.string_value
       FROM UNNEST(event_params) ep
      WHERE ep.key = 'page_location')                AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
),
classified AS (
  SELECT
    *,
    CASE
      /* ---------- PDP rules ---------- */
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND REGEXP_CONTAINS(
                 LOWER(SPLIT(url,'/')[ORDINAL(ARRAY_LENGTH(SPLIT(url,'/')))]),
                 r'\+')
           AND (
             REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(3)]),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
             OR
             REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(4)]),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
           )
           THEN 'PDP'
      /* ---------- PLP rules ---------- */
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND NOT REGEXP_CONTAINS(
                 LOWER(SPLIT(url,'/')[ORDINAL(ARRAY_LENGTH(SPLIT(url,'/')))]),
                 r'\+')
           AND (
             REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(3)]),
               r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
