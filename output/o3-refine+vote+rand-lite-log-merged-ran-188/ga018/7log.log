```sql
--Description: 8) For every page_view on 2-Jan-2021 classify it; keep only PLP
--   views; attach the timestamp of the first PDP (if any) that occurs later in
--   the same session.
WITH classified AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
     FROM UNNEST(event_params) ep
     WHERE ep.key = 'ga_session_id') AS session_id,
    event_timestamp,
    (SELECT ep.value.string_value
     FROM UNNEST(event_params) ep
     WHERE ep.key = 'page_location') AS url,
    CASE
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(ARRAY_LENGTH(SPLIT(url,'/'))-1)]), r'\+')
           AND (
             REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
             OR
             REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
           )
        THEN 'PDP'
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND NOT REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(ARRAY_LENGTH(SPLIT(url,'/'))-1)]), r'\+')
           AND (
             REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
             OR
             REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
           )
        THEN 'PLP'
      ELSE 'OTHER'
    END AS page_type
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
),
pdp_times AS (
  SELECT
    user_pseudo_id,
    session_id,
    MIN(event_timestamp) AS first_pdp_ts
  FROM classified
  WHERE page_type = 'PDP'
  GROUP BY user_pseudo_id, session_id
)
SELECT
  *
FROM (
  SELECT
    c.user_pseudo_id,
    c.session_id,
    c.event_timestamp        AS plp_ts,
    p.first_pdp_ts,
    p.first_pdp_ts > c.event_timestamp AS led_to_pdp
  FROM classified AS c
  LEFT JOIN pdp_times AS p
    ON p.user_pseudo_id = c.user_pseudo_id
   AND p.session_id      = c.session_id
  WHERE c.page_type = 'PLP'
)
LIMIT 20;
```

```sql
--Description: 9) Aggregate the previous result to get:
--   a) total PLP views,
--   b) PLP views that eventually led to a PDP in the same session.
WITH classified AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
     FROM UNNEST(event_params) ep
     WHERE ep.key = 'ga_session_id') AS session_id,
    event_timestamp,
    (SELECT ep.value.string_value
     FROM UNNEST(event_params) ep
     WHERE ep.key = 'page_location') AS url,
    CASE
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(ARRAY_LENGTH(SPLIT(url,'/'))-1)]), r'\+')
           AND (
             REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
             OR
             REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
           )
        THEN 'PDP'
      WHEN ARRAY_LENGTH(SPLIT(url,'/')) >= 5
           AND NOT REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(ARRAY_LENGTH(SPLIT(url,'/'))-1)]), r'\+')
           AND (
             REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
             OR
             REGEXP_CONTAINS(LOWER(SPLIT(url,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
           )
        THEN 'PLP'
      ELSE 'OTHER'
    END AS page_type
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
),
pdp_times AS (
  SELECT
    user_pseudo_id,
    session_id,
    MIN(event_timestamp) AS first_pdp_ts
  FROM classified
  WHERE page_type = 'PDP'
  GROUP BY user_pseudo_id, session_id
),
plp_with_flags AS (
  SELECT
    c.event_timestamp,
    p.first_pdp_ts
  FROM classified AS c
  LEFT JOIN pdp_times AS p
    ON p.user_pseudo_id = c.user_pseudo_id
   AND p.session_id      = c.session_id
  WHERE c.page_type = 'PLP'
)
SELECT
  COUNT(*)                                         AS total_plp_views,
  COUNTIF(first_pdp_ts > event_timestamp)          AS plp_views_with_pdp_after,
  SAFE_DIVIDE(COUNTIF(first_pdp_ts > event_timestamp), COUNT(*))
    AS plp_to_pdp_percentage
FROM plp_with_flags
LIMIT 20;
