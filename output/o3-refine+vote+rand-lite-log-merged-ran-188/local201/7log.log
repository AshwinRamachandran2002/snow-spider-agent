           (LENGTH(w2."words")-LENGTH(REPLACE(w2."words",'z','')))
WHERE   (LENGTH(w1."words") = 4 OR LENGTH(w1."words") = 5)
  AND   w1."words" LIKE 'r%'
GROUP BY w1."words"
HAVING  COUNT(DISTINCT w2."words") >= 1;
```

```sql
-- 4) Same as query (3) but only keep the alphabetically first 10
--    and sort alphabetically so we get “first 10 words” as required.
SELECT  w1."words"                              AS word,
        COUNT(DISTINCT w2."words")              AS anagram_count
FROM    "word_list" AS w1
JOIN    "word_list" AS w2
       ON  w1."words" <> w2."words"
       AND LENGTH(w1."words") = LENGTH(w2."words")
       AND (LENGTH(w1."words")-LENGTH(REPLACE(w1."words",'a',''))) =
           (LENGTH(w2."words")-LENGTH(REPLACE(w2."words",'a','')))
       --  (--- the same 24 equality checks for letters b … z go here ‑--)
       AND (LENGTH(w1."words")-LENGTH(REPLACE(w1."words",'z',''))) =
           (LENGTH(w2."words")-LENGTH(REPLACE(w2."words",'z','')))
WHERE   (LENGTH(w1."words") = 4 OR LENGTH(w1."words") = 5)
  AND   w1."words" LIKE 'r%'
GROUP BY w1."words"
HAVING  COUNT(DISTINCT w2."words") >= 1
ORDER BY w1."words"
LIMIT 10;
```

```sql
-- 5) (Optional) If you also want to see the full list of anagrams
--    for any single word “r***”, replace :target with the word you care about.
SELECT  w2."words"  AS anagram_of_target
FROM    "word_list" AS w1
JOIN    "word_list" AS w2
       ON  w1."words" = :target                  -- ← change this
       AND w1."words" <> w2."words"
       AND LENGTH(w1."words") = LENGTH(w2."words")
       -- same 26 equality checks as in queries 3 & 4
ORDER BY w2."words";
```

Query (4) directly returns the requested result:  
the first 10 alphabetically-sorted 4- or 5-letter words that start with “r” and have at least one anagram of the same length, together with the count of such anagrams for each word.
