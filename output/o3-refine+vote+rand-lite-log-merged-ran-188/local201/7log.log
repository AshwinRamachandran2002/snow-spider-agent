Query:
-- 3) Count, for every word, how many other words have the same length
--    and exactly the same letter–frequency profile (i.e. are anagrams).
--    LENGTH(x)-LENGTH(REPLACE(x,'a','')) gives the number of “a”s, etc.
--    Only words that start with 'r' and are 4–5 characters long are kept.
--    The HAVING clause makes sure we keep only those that have ≥1 anagram.
SELECT  w1."words"                              AS word,
        COUNT(DISTINCT w2."words")              AS anagram_count
FROM    "word_list" AS w1
JOIN    "word_list" AS w2
       ON  w1."words" <> w2."words"
       AND LENGTH(w1."words") = LENGTH(w2."words")
       -- compare counts for every letter a-z
