--Description: Find signatures that correspond to more than one word (i.e., have anagrams)
WITH RECURSIVE
chars(word, pos) AS (
  SELECT "words", 1
  FROM "word_list"
  WHERE length("words") BETWEEN 4 AND 5
  UNION ALL
  SELECT word, pos + 1
  FROM chars
  WHERE pos + 1 <= length(word)
),
charlist AS (
  SELECT word, substr(word, pos, 1) AS ch
  FROM chars
),
signature AS (
  SELECT word,
         group_concat(ch, '') AS sig
  FROM (
    SELECT word, ch
    FROM charlist
    ORDER BY word, ch
  )
  GROUP BY word
),
sig_counts AS (
  SELECT sig, COUNT(*) AS anagram_count
  FROM signature
  GROUP BY sig
  HAVING COUNT(*) > 1
)
SELECT sig,
       anagram_count
FROM sig_counts
LIMIT 20;
