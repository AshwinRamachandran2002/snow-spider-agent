```sql
--Description: Words that are 4-5 characters long and begin with “r”
SELECT "words"
FROM "word_list"
WHERE length("words") BETWEEN 4 AND 5
  AND "words" LIKE 'r%'
LIMIT 20;
```

```sql
--Description: Split the selected words into individual characters (first 20 rows)
WITH RECURSIVE
chars(word, pos) AS (
  SELECT "words", 1
  FROM "word_list"
  WHERE length("words") BETWEEN 4 AND 5
    AND "words" LIKE 'r%'
  UNION ALL
  SELECT word, pos + 1
  FROM chars
  WHERE pos + 1 <= length(word)
)
SELECT word   AS "word_sample",
       pos    AS "char_position",
       substr(word, pos, 1) AS "single_char"
FROM chars
LIMIT 20;
```

```sql
--Description: Build a canonical “signature” (sorted characters) for each 4-5-letter word
WITH RECURSIVE
chars(word, pos) AS (
  SELECT "words", 1
  FROM "word_list"
  WHERE length("words") BETWEEN 4 AND 5
  UNION ALL
  SELECT word, pos + 1
  FROM chars
  WHERE pos + 1 <= length(word)
),
charlist AS (
  SELECT word, substr(word, pos, 1) AS ch
  FROM chars
),
signature AS (
  SELECT word,
         group_concat(ch, '') AS sig
  FROM (
    SELECT word, ch
    FROM charlist
    ORDER BY word, ch
  )
  GROUP BY word
)
SELECT word,
       sig
FROM signature
LIMIT 20;
```

```sql
--Description: Find signatures that correspond to more than one word (i.e., have anagrams)
WITH RECURSIVE
chars(word, pos) AS (
  SELECT "words", 1
  FROM "word_list"
  WHERE length("words") BETWEEN 4 AND 5
  UNION ALL
  SELECT word, pos + 1
  FROM chars
  WHERE pos + 1 <= length(word)
),
charlist AS (
  SELECT word, substr(word, pos, 1) AS ch
  FROM chars
),
signature AS (
  SELECT word,
         group_concat(ch, '') AS sig
  FROM (
    SELECT word, ch
    FROM charlist
    ORDER BY word, ch
  )
  GROUP BY word
),
sig_counts AS (
  SELECT sig, COUNT(*) AS anagram_count
  FROM signature
  GROUP BY sig
  HAVING COUNT(*) > 1
)
SELECT sig,
       anagram_count
FROM sig_counts
LIMIT 20;
```

```sql
--Description: First 10 alphabetically sorted words that start with “r”, are 4-5 letters long,
--             and have at least one anagram, together with the number of such anagrams
WITH RECURSIVE
chars(word, pos) AS (
  SELECT "words", 1
  FROM "word_list"
  WHERE length("words") BETWEEN 4 AND 5
  UNION ALL
  SELECT word, pos + 1
  FROM chars
  WHERE pos + 1 <= length(word)
),
charlist AS (
  SELECT word, substr(word, pos, 1) AS ch
  FROM chars
),
signature AS (
  SELECT word,
         group_concat(ch, '') AS sig
  FROM (
    SELECT word, ch
    FROM charlist
    ORDER BY word, ch
  )
  GROUP BY word
),
sig_counts AS (
  SELECT sig, COUNT(*) AS anagram_count
  FROM signature
  GROUP BY sig
  HAVING COUNT(*) > 1
),
qualified_words AS (
  SELECT s.word,
         sc.anagram_count
  FROM signature AS s
  JOIN sig_counts AS sc
    ON s.sig = sc.sig
  WHERE length(s.word) BETWEEN 4 AND 5
    AND s.word LIKE 'r%'
)
SELECT word,
       anagram_count
FROM qualified_words
ORDER BY word
LIMIT 20;
```
