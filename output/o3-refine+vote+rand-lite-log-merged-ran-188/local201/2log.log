Below is a step-by-step exploration (6 queries, all different and each capped at 20 rows) that finishes with the query returning the required first 10 words together with how many anagrams each one has.

```sql
-- Description: 1) Peek at a few raw words in the dictionary
SELECT DISTINCT "words"
FROM "word_list"
LIMIT 20;
```

```sql
-- Description: 2) How many words begin with the letter “r”?
SELECT COUNT(*) AS "r_words"
FROM "word_list"
WHERE substr("words",1,1) = 'r'
LIMIT 20;
```

```sql
-- Description: 3) Show sample words that start with “r” and are 4–5 characters long
SELECT "words"
FROM "word_list"
WHERE (length("words") = 4 OR length("words") = 5)
  AND substr("words",1,1) = 'r'
LIMIT 20;
```

```sql
-- Description: 4) Break one sample word into its characters (demonstrates the split technique)
WITH RECURSIVE chars AS (
  SELECT 'race' AS "word", 1 AS "pos",
         substr('race',1,1) AS "ch", length('race') AS "len"
  UNION ALL
  SELECT "word", "pos"+1,
         substr("word","pos"+1,1), "len"
  FROM chars
  WHERE "pos" < "len"
)
SELECT "word","pos","ch"
FROM chars
ORDER BY "pos"
LIMIT 20;
```

```sql
-- Description: 5) For every 4–5 letter “r” word, build a sorted-letter signature
WITH RECURSIVE chars AS (
  SELECT "words" AS "word", 1 AS "pos",
         substr("words",1,1) AS "ch", length("words") AS "len"
  FROM "word_list"
  WHERE (length("words") = 4 OR length("words") = 5)
    AND substr("words",1,1) = 'r'
  UNION ALL
  SELECT "word", "pos"+1,
         substr("word","pos"+1,1), "len"
  FROM chars
  WHERE "pos" < "len"
),
signatures AS (
  SELECT "word",
         (SELECT group_concat("ch",'')
            FROM (SELECT "ch" 
                  FROM chars c2 
                  WHERE c2."word" = chars."word" 
                  ORDER BY "ch")
         ) AS "signature"
  FROM chars
  GROUP BY "word"
)
SELECT *
FROM signatures
LIMIT 20;
```

```sql
-- Description: 6) Final answer – first 10 eligible words (alphabetical) and
--               the number of anagrams of the same length they possess
WITH RECURSIVE chars AS (
  SELECT "words" AS "word", 1 AS "pos",
         substr("words",1,1) AS "ch", length("words") AS "len"
  FROM "word_list"
  WHERE (length("words") = 4 OR length("words") = 5)
    AND substr("words",1,1) = 'r'
  UNION ALL
  SELECT "word", "pos"+1,
         substr("word","pos"+1,1), "len"
  FROM chars
  WHERE "pos" < "len"
),
signatures AS (
  SELECT "word",
         (SELECT group_concat("ch",'')
            FROM (SELECT "ch"
                  FROM chars c2
                  WHERE c2."word" = chars."word"
                  ORDER BY "ch")
         ) AS "signature"
  FROM chars
  GROUP BY "word"
),
sig_counts AS (
  SELECT "signature", COUNT(*) AS "family_cnt"
  FROM signatures
  GROUP BY "signature"
  HAVING COUNT(*) > 1          -- keeps only signatures that have anagrams
)
SELECT s."word",
       (sc."family_cnt" - 1) AS "anagram_count"   -- exclude the word itself
FROM signatures AS s
JOIN sig_counts  AS sc
  ON s."signature" = sc."signature"
ORDER BY s."word"
LIMIT 10;
```
