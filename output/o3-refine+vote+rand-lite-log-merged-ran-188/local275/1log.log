       "mth",
       ROUND("qty" / "cma_13m",3) AS "ratio"
FROM   cte
WHERE  substr("mth",1,4) = '2017'
  AND  ("qty" / "cma_13m") > 2
ORDER  BY "product_id", "mth"
LIMIT 20;
