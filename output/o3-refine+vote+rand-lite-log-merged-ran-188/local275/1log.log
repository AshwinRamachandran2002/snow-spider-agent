```sql
--Description:  
--  Goal: examine how strongly each product out-performed its own centred 13-month
--  trend line during 2017.  For every product/month we compute the ratio
--      ratio = actual_qty ÷ centred_moving_avg(±6 months)
--  then summarise per product:
--      • months_present   – how many 2017 months exist (should be 12)
--      • months_above_2   – how many of those months have ratio > 2
--      • min_ratio        – the worst (lowest) monthly ratio
--      • avg_ratio        – overall average ratio in 2017
--  This single SQL therefore shows at a glance which products were
--  “consistently high” (e.g., months_above_2 ≥ 6, or min_ratio > 2, etc.).
--  No filter is applied in the outer SELECT so the analyst can choose a
--  threshold after seeing the figures; the query returns one row per product.
WITH ratios AS (
    SELECT  product_id,
            mth,
            qty * 1.0 /
            AVG(qty) OVER (
                PARTITION BY product_id
                ORDER BY mth
                ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
            ) AS ratio
    FROM    monthly_sales
    WHERE   substr(mth,1,4) = '2017'
), summary AS (
    SELECT  product_id,
            COUNT(*)                                   AS months_present,
            SUM(CASE WHEN ratio > 2 THEN 1 END)        AS months_above_2,
            MIN(ratio)                                 AS min_ratio,
            ROUND(AVG(ratio), 3)                       AS avg_ratio
    FROM    ratios
    GROUP BY product_id
)
SELECT *
FROM   summary
ORDER  BY avg_ratio DESC, product_id;
```
