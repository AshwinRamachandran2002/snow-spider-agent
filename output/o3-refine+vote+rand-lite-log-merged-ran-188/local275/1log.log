Query:
--Description:  For every product/month compute the seasonality-adjusted sales ratio
--              (actual ÷ centred MA) and keep only months from calendar-year 2017.
WITH cte AS (
    SELECT "product_id",
           "mth",
           "qty",
           AVG("qty") OVER (PARTITION BY "product_id"
                            ORDER BY "mth"
                            ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING) AS "cma_13m"
    FROM   "monthly_sales"
)
SELECT "product_id",
       "mth",
       "qty",
       ROUND("qty" / "cma_13m", 3) AS "ratio"
FROM   cte
WHERE  substr("mth",1,4) = '2017'
ORDER  BY "product_id", "mth"
LIMIT 20;
