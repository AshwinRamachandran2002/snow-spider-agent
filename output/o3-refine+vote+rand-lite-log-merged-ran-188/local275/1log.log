```sql
WITH sales_with_ratio AS (
    SELECT
        "product_id",
        "mth",
        "qty",
        "qty" * 1.0 /
        AVG("qty") OVER (
            PARTITION BY "product_id"
            ORDER BY "mth"
            ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
        ) AS ratio
    FROM "monthly_sales"
),
ratio_2017 AS (
    SELECT
        "product_id",
        COUNT(*)   AS months_in_2017,
        MIN(ratio) AS min_ratio_2017
    FROM   sales_with_ratio
    WHERE  substr("mth",1,4) = '2017'
    GROUP  BY "product_id"
)
SELECT
    p."id"   AS product_id,
    p."name" AS product_name
FROM   ratio_2017 r
JOIN   "products" p ON p."id" = r."product_id"
WHERE  r."months_in_2017" = 12   -- must have all 12 months
  AND  r."min_ratio_2017" > 2    -- ratio stayed above 2 every month
ORDER  BY p."id";
```
