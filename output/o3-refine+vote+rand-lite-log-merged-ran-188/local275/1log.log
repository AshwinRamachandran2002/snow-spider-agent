--  trend (ratio > 2.0) in at least two different months of 2017.
--  Steps
--    1. “ratios” CTE – calculate the seasonality-adjusted ratio for every
--       product-month in 2017.
--    2. “tally” CTE  – count, per product, how many 2017 months have ratio > 2.
--    3.  Final SELECT lists the qualifying products together with that count.
WITH ratios AS (                 -- 1. monthly ratios for 2017
    SELECT  product_id,
            mth,
            qty * 1.0 /
            AVG(qty) OVER (PARTITION BY product_id
                           ORDER BY mth
                           ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING) AS ratio
    FROM    monthly_sales
    WHERE   substr(mth,1,4) = '2017'
), tally AS (                    -- 2. per-product count of “ratio > 2” months
    SELECT  product_id,
            SUM(CASE WHEN ratio > 2.0 THEN 1 ELSE 0 END) AS months_above_2
    FROM    ratios
    GROUP BY product_id
)
SELECT  p.id   AS product_id,
        p.name AS product_name,
        t.months_above_2
FROM    tally t
JOIN    products p ON p.id = t.product_id
WHERE   t.months_above_2 >= 2          -- at least two months beating 2× trend
ORDER BY t.months_above_2 DESC,
         p.id
LIMIT 20;
