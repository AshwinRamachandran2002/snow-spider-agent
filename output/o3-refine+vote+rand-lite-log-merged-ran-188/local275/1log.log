```sql
--Description:  Count how many months of data each product has for the years 2016-2018,
--              to verify we have the full 12 months needed for a centred moving average.
SELECT "product_id",
       substr("mth",1,4)  AS "year",
       COUNT(*)           AS "months_recorded"
FROM   "monthly_sales"
WHERE  substr("mth",1,4) BETWEEN '2016' AND '2018'
GROUP  BY "product_id", substr("mth",1,4)
LIMIT 20;
```

```sql
--Description:  Example – compute a centred (±6-month) moving average for one
--              specific product to be sure the window logic works.
SELECT "product_id",
       "mth",
       "qty",
       ROUND( AVG("qty") OVER (PARTITION BY "product_id"
                               ORDER BY "mth"
                               ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING), 2) AS "cma_13m"
FROM   "monthly_sales"
WHERE  "product_id" = 4040
ORDER  BY "mth"
LIMIT 20;
```

```sql
--Description:  For every product/month compute the seasonality-adjusted sales ratio
--              (actual ÷ centred MA) and keep only months from calendar-year 2017.
WITH cte AS (
    SELECT "product_id",
           "mth",
           "qty",
           AVG("qty") OVER (PARTITION BY "product_id"
                            ORDER BY "mth"
                            ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING) AS "cma_13m"
    FROM   "monthly_sales"
)
SELECT "product_id",
       "mth",
       "qty",
       ROUND("qty" / "cma_13m", 3) AS "ratio"
FROM   cte
WHERE  substr("mth",1,4) = '2017'
ORDER  BY "product_id", "mth"
LIMIT 20;
```

```sql
--Description:  Identify every 2017 record whose ratio is above 2.0.
WITH cte AS (
    SELECT "product_id",
           "mth",
           "qty",
           AVG("qty") OVER (PARTITION BY "product_id"
                            ORDER BY "mth"
                            ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING) AS "cma_13m"
    FROM   "monthly_sales"
)
SELECT "product_id",
       "mth",
       ROUND("qty" / "cma_13m",3) AS "ratio"
FROM   cte
WHERE  substr("mth",1,4) = '2017'
  AND  ("qty" / "cma_13m") > 2
ORDER  BY "product_id", "mth"
LIMIT 20;
```

```sql
--Description:  For each product ensure that *all* twelve months in 2017 have
--              a ratio greater than 2.  Only such products are retained.
WITH ratios AS (
    SELECT "product_id",
           "mth",
           ("qty" /
            AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING)) AS "ratio"
    FROM   "monthly_sales"
    WHERE  substr("mth",1,4) = '2017'
)
SELECT  "product_id"
FROM    ratios
GROUP BY "product_id"
HAVING  COUNT(*) = 12                 -- all 12 months present
   AND  MIN(CASE WHEN "ratio" > 2 THEN 1 ELSE 0 END) = 1  -- every month >2
LIMIT 20;
```

```sql
--Description:  Present the final, human-readable list by joining to the products
--              dimension to fetch the product names.
WITH ratios AS (
    SELECT "product_id",
           ("qty" /
            AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING)) AS "ratio"
    FROM   "monthly_sales"
    WHERE  substr("mth",1,4) = '2017'
), qualified AS (
    SELECT  "product_id"
    FROM    ratios
    GROUP BY "product_id"
    HAVING  COUNT(*) = 12
       AND  MIN(CASE WHEN "ratio" > 2 THEN 1 ELSE 0 END) = 1
)
SELECT DISTINCT p."id"       AS "product_id",
                p."name"     AS "product_name"
FROM   qualified   q
JOIN   "products" p ON p."id" = q."product_id"
ORDER  BY p."id"
LIMIT 20;
```
