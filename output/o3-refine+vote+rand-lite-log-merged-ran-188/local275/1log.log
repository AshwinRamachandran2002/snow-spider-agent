WITH ratios AS (                 -- step-1: seasonality-adjusted ratio for every record
    SELECT
        product_id,
        mth,
        qty,
        qty * 1.0 /
        AVG(qty) OVER (
            PARTITION BY product_id
            ORDER BY mth
            ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
        ) AS ratio
    FROM monthly_sales
),
ratio_2017 AS (                  -- step-2: keep 2017 and aggregate per product
    SELECT
        product_id,
        COUNT(DISTINCT mth) AS month_cnt,   -- how many distinct 2017 months we have
        MIN(ratio)          AS min_ratio    -- lowest ratio within 2017
    FROM   ratios
    WHERE  substr(mth,1,4) = '2017'
    GROUP  BY product_id
)
SELECT
    p.id   AS product_id,
    p.name AS product_name
FROM   ratio_2017 r
JOIN   products   p ON p.id = r.product_id
WHERE  r.month_cnt = 12        -- must have data for all 12 months of 2017
  AND  r.min_ratio  > 2        -- ratio stayed strictly above 2 every month
ORDER  BY p.id;
