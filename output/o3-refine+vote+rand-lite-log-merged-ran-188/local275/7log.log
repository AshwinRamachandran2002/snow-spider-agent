Query:
--Description:  (8)  Month-by-month ratios for those products that reached a
--              seasonality-adjusted ratio > 2 in at least one 2017 month.
SELECT ms.product_id,
       pr.name,
       ms.mth,
       ROUND(
             ms.qty /
             AVG(ms.qty) OVER (PARTITION BY ms.product_id
                                ORDER BY ms.mth
                                ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING)
       ,2) AS ratio
FROM   monthly_sales AS ms
JOIN   products      AS pr  ON pr.id = ms.product_id
WHERE  ms.product_id IN (          -- products with MAX(ratio) > 2 during 2017
        SELECT  product_id
        FROM   (
                SELECT  product_id,
                        mth,
                        qty /
                        AVG(qty) OVER (PARTITION BY product_id
                                       ORDER BY mth
                                       ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING) AS ratio
                FROM    monthly_sales
                WHERE   mth BETWEEN '2017-01-01' AND '2017-12-31'
               ) AS r
        GROUP BY product_id
        HAVING MAX(ratio) > 2
)
  AND ms.mth BETWEEN '2017-01-01' AND '2017-12-31'
ORDER BY ms.product_id, ms.mth
LIMIT 20
