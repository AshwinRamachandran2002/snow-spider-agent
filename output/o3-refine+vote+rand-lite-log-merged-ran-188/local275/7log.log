```sql
--Description:  (9)  Summary per product of its 2017 seasonality-adjusted ratios
--              for the same “MAX > 2” candidate list: minimum, maximum, and the
--              count of months that exceeded 2.0.
SELECT
        ms.product_id,
        pr.name,
        ROUND(MIN(ratio),2)                       AS min_ratio_2017,
        ROUND(MAX(ratio),2)                       AS max_ratio_2017,
        COUNT(CASE WHEN ratio > 2 THEN 1 END)     AS months_above_2
FROM (
        SELECT  product_id,
                mth,
                qty /
                AVG(qty) OVER (PARTITION BY product_id
                               ORDER BY mth
                               ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING) AS ratio
        FROM    monthly_sales
        WHERE   mth BETWEEN '2017-01-01' AND '2017-12-31'
     ) AS ms
JOIN products AS pr  ON pr.id = ms.product_id
GROUP BY ms.product_id
HAVING MAX(ratio) > 2
ORDER BY months_above_2 DESC, ms.product_id
LIMIT 20;
```

```sql
--Description:  (10)  “Most boosted” products: those whose 2017 ratio was above
--              2.0 in at least half of the year (≥ 6 months).  Lists the number
--              of months clearing the threshold so we can see how strongly each
--              product benefitted from seasonality.
SELECT
        p.name,
        s.months_above_2
FROM   products AS p
JOIN  (
        SELECT  product_id,
                COUNT(*) AS months_above_2
        FROM   (
                SELECT  product_id,
                        mth,
                        qty /
                        AVG(qty) OVER (PARTITION BY product_id
                                       ORDER BY mth
                                       ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING) AS ratio
                FROM    monthly_sales
                WHERE   mth BETWEEN '2017-01-01' AND '2017-12-31'
               ) AS r
        WHERE  ratio > 2
        GROUP BY product_id
        HAVING months_above_2 >= 6        -- at least half the months > 2
      ) AS s
      ON s.product_id = p.id
ORDER BY s.months_above_2 DESC, p.name
LIMIT 20;
```
