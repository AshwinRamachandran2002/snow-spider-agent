        SELECT  product_id
        FROM   (
                SELECT  product_id,
                        mth,
                        qty /
                        AVG(qty) OVER (PARTITION BY product_id
                                       ORDER BY mth
                                       ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING) AS ratio
                FROM    monthly_sales
                WHERE   mth BETWEEN '2017-01-01' AND '2017-12-31'
               ) AS r
        GROUP BY product_id
        HAVING MAX(ratio) > 2
)
  AND ms.mth BETWEEN '2017-01-01' AND '2017-12-31'
ORDER BY ms.product_id, ms.mth
