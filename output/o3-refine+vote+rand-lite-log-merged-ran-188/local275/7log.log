```sql
WITH ratios AS (
    SELECT
        product_id,
        mth,
        ROUND(
            qty / AVG(qty) OVER (
                     PARTITION BY product_id
                     ORDER BY mth
                     ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
                 ), 2
        ) AS ratio
    FROM monthly_sales
),
good_products AS (
    SELECT
        product_id
    FROM ratios
    WHERE mth BETWEEN '2017-01-01' AND '2017-12-31'
    GROUP BY product_id
    HAVING COUNT(*) = 12                -- all 12 months present
       AND MIN(ratio) >= 2              -- ratio ≥ 2 in every month
)
SELECT
    gp.product_id,
    p.name
FROM good_products gp
JOIN products      p ON p.id = gp.product_id
ORDER BY gp.product_id;
```
