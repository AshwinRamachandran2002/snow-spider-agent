```sql
--Description:  List the products whose seasonality-adjusted sales ratio
--              (actual quantity ÷ centred 12-month moving average) exceeded
--              2.0 in *any* month of 2017.  The sub-query calculates the ratio
--              month-by-month, restricted to 2017; the outer query converts the
--              product_id’s to names, keeps only those with MAX(ratio) > 2, and
--              shows the peak ratio each product achieved that year.
SELECT
        p.id,
        p.name,
        ROUND(MAX(r.ratio), 2) AS max_ratio_2017,
        COUNT(*)               AS months_in_2017
FROM   (
        SELECT  product_id,
                mth,
                qty /
                AVG(qty) OVER (PARTITION BY product_id
                               ORDER BY mth
                               ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING) AS ratio
        FROM    monthly_sales
        WHERE   mth BETWEEN '2017-01-01' AND '2017-12-31'
       ) AS r
JOIN   products AS p
       ON p.id = r.product_id
GROUP BY p.id, p.name
HAVING MAX(r.ratio) > 2          -- at least one month above the 2.0 threshold
ORDER BY max_ratio_2017 DESC, p.id
LIMIT 20;
```
