--Description:  Return each product that exceeded a seasonality-adjusted sales
--              ratio of 2.0 in at least THREE different months of 2017.
--              Steps:
--              1.  For every product and 2017 month, compute the ratio
--                  (actual qty ÷ centred 12-month moving average).
--              2.  Keep only the months where that ratio > 2.
--              3.  Aggregate by product: count the qualifying months and record
--                  the peak ratio reached.
--              4.  Require ≥ 3 qualifying months, then attach product names and
--                  list the results.
SELECT
        p.id,
        p.name,
        s.months_above_2,
        ROUND(s.max_ratio, 2) AS max_ratio_2017
FROM   products AS p
JOIN  (
        SELECT  product_id,
                COUNT(*)   AS months_above_2,   -- how many 2017 months > 2
                MAX(ratio) AS max_ratio         -- peak ratio in 2017
        FROM   (
                SELECT  product_id,
                        mth,
                        qty /
                        AVG(qty) OVER (PARTITION BY product_id
                                       ORDER BY mth
                                       ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING) AS ratio
                FROM    monthly_sales
                WHERE   mth BETWEEN '2017-01-01' AND '2017-12-31'
              ) AS r
        WHERE  ratio > 2                        -- keep boosted months only
        GROUP BY product_id
        HAVING months_above_2 >= 3              -- need at least 3 such months
      ) AS s
      ON p.id = s.product_id
ORDER BY s.months_above_2 DESC, p.id
LIMIT 20;
