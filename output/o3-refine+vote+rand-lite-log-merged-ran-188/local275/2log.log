```sql
--Description: 
-- 1.  Build a 12-month centred moving average (CMA) for every product/month (5 months before + current + 6 months after).
-- 2.  Restrict to 2017 rows whose CMA exists, then compute the seasonality-adjusted ratio (qty / CMA).
-- 3.  For each product, ensure all 12 months of 2017 are present and every month’s ratio is > 2.
-- 4.  Return the qualifying product IDs and names.
WITH cma AS (
    SELECT
        ms.product_id,
        ms.mth,
        ms.qty,
        AVG(ms.qty) OVER (
            PARTITION BY ms.product_id
            ORDER BY ms.mth
            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
        ) AS cma
    FROM monthly_sales AS ms
),
ratio_2017 AS (
    SELECT
        c.product_id,
        c.mth,
        c.qty / c.cma AS ratio
    FROM cma AS c
    WHERE substr(c.mth, 1, 4) = '2017'
      AND c.cma IS NOT NULL
),
good_products AS (
    SELECT
        r.product_id
    FROM ratio_2017 AS r
    GROUP BY r.product_id
    HAVING COUNT(*) = 12          -- all twelve 2017 months exist
       AND MIN(r.ratio) > 2       -- every month’s ratio > 2
)
SELECT
    p.id   AS product_id,
    p.name AS product_name
FROM products AS p
JOIN good_products AS g
  ON p.id = g.product_id;
```
