Query:
-- Description: For one sample product (4040) calculate a 12-month centred moving average (CMA) 
--              and the seasonality-adjusted ratio (qty / CMA).
SELECT product_id,
       mth,
       qty,
       AVG(qty) OVER (
           PARTITION BY product_id
           ORDER BY mth
           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
       )                        AS cma,
       qty /
       AVG(qty) OVER (
           PARTITION BY product_id
           ORDER BY mth
           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
       )                        AS ratio
FROM monthly_sales
WHERE product_id = 4040
ORDER BY mth
LIMIT 36;
