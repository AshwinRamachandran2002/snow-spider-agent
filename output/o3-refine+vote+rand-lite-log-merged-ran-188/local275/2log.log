```sql
-- Description: For one sample product (4040) calculate a 12-month centred moving average (CMA) 
--              and the seasonality-adjusted ratio (qty / CMA).
SELECT product_id,
       mth,
       qty,
       AVG(qty) OVER (
           PARTITION BY product_id
           ORDER BY mth
           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
       )                        AS cma,
       qty /
       AVG(qty) OVER (
           PARTITION BY product_id
           ORDER BY mth
           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
       )                        AS ratio
FROM monthly_sales
WHERE product_id = 4040
ORDER BY mth
LIMIT 36;
```

```sql
-- Description: Compute CMA and the seasonality-adjusted ratio for EVERY product & month in the set.
WITH cma_calc AS (
    SELECT product_id,
           mth,
           qty,
           AVG(qty) OVER (
               PARTITION BY product_id
               ORDER BY mth
               ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
           ) AS cma
    FROM monthly_sales
)
SELECT product_id,
       mth,
       qty,
       cma,
       qty / cma AS ratio
FROM cma_calc
WHERE cma IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Keep only the 2017 rows where the seasonality-adjusted ratio exceeds 2.
WITH cma_calc AS (
    SELECT product_id,
           mth,
           qty,
           AVG(qty) OVER (
               PARTITION BY product_id
               ORDER BY mth
               ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
           ) AS cma
    FROM monthly_sales
),
ratio_2017 AS (
    SELECT product_id,
           mth,
           qty / cma AS ratio
    FROM cma_calc
    WHERE substr(mth, 1, 4) = '2017'
      AND cma IS NOT NULL
)
SELECT *
FROM ratio_2017
WHERE ratio > 2
LIMIT 20;
```

```sql
-- Description: Count, for every product, how many 2017 months have ratio > 2.
WITH cma_calc AS (
    SELECT product_id,
           mth,
           qty,
           AVG(qty) OVER (
               PARTITION BY product_id
               ORDER BY mth
               ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
           ) AS cma
),
ratio_2017 AS (
    SELECT product_id,
           mth,
           qty / cma AS ratio
    FROM cma_calc
    WHERE substr(mth, 1, 4) = '2017'
      AND cma IS NOT NULL
)
SELECT product_id,
       COUNT(*) AS months_above_2
FROM ratio_2017
WHERE ratio > 2
GROUP BY product_id
ORDER BY months_above_2 DESC
LIMIT 20;
```

```sql
-- Description: Pick the products whose ratio stayed above 2 for ALL 12 months of 2017.
WITH cma_calc AS (
    SELECT product_id,
           mth,
           qty,
           AVG(qty) OVER (
               PARTITION BY product_id
               ORDER BY mth
               ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
           ) AS cma
),
ratio_2017 AS (
    SELECT product_id,
           mth,
           qty / cma AS ratio
    FROM cma_calc
    WHERE substr(mth, 1, 4) = '2017'
      AND cma IS NOT NULL
)
SELECT product_id
FROM ratio_2017
GROUP BY product_id
HAVING COUNT(*) = 12               -- all 12 months present
   AND MIN(ratio) > 2;             -- every month above 2
```

```sql
-- Description: Return the product names for the qualifying IDs found above.
WITH cma_calc AS (
    SELECT product_id,
           mth,
           qty,
           AVG(qty) OVER (
               PARTITION BY product_id
               ORDER BY mth
               ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
           ) AS cma
),
ratio_2017 AS (
    SELECT product_id,
           mth,
           qty / cma AS ratio
    FROM cma_calc
    WHERE substr(mth, 1, 4) = '2017'
      AND cma IS NOT NULL
),
good_products AS (
    SELECT product_id
    FROM ratio_2017
    GROUP BY product_id
    HAVING COUNT(*) = 12
       AND MIN(ratio) > 2
)
SELECT DISTINCT p.name
FROM products AS p
JOIN good_products AS g
  ON p.id = g.product_id;
