Query:
-- Description: Keep only the 2017 rows where the seasonality-adjusted ratio exceeds 2.
WITH cma_calc AS (
    SELECT product_id,
           mth,
           qty,
           AVG(qty) OVER (
               PARTITION BY product_id
               ORDER BY mth
               ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
           ) AS cma
    FROM monthly_sales
),
ratio_2017 AS (
    SELECT product_id,
           mth,
           qty / cma AS ratio
    FROM cma_calc
    WHERE substr(mth, 1, 4) = '2017'
      AND cma IS NOT NULL
)
SELECT *
FROM ratio_2017
WHERE ratio > 2
LIMIT 20;
