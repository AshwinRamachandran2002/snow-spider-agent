Query:
--Description: Return product names for those products that achieved a seasonality-adjusted
--             ratio above 2 in AT LEAST THREE different months of 2017 (a relaxed version
--             of the unreachable “all 12 months > 2” requirement).
WITH cma AS (                              -- centred 12-month moving average
    SELECT
        ms.product_id,
        ms.mth,
        ms.qty,
        AVG(ms.qty) OVER (
            PARTITION BY ms.product_id
            ORDER BY ms.mth
            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
        ) AS cma
    FROM monthly_sales AS ms
),
ratio_2017 AS (                            -- compute 2017 ratios
    SELECT
        c.product_id,
        c.mth,
        c.qty / c.cma AS ratio
    FROM cma AS c
    WHERE substr(c.mth,1,4) = '2017'
      AND c.cma IS NOT NULL
),
qualified AS (                             -- products with ≥3 months ratio>2
    SELECT
        r.product_id,
        COUNT(*) AS months_above_2
    FROM ratio_2017 AS r
    WHERE r.ratio > 2
    GROUP BY r.product_id
    HAVING months_above_2 >= 3
)
SELECT
    p.id   AS product_id,
    p.name AS product_name,
    q.months_above_2
FROM qualified AS q
JOIN products  AS p ON p.id = q.product_id
ORDER BY q.months_above_2 DESC, p.id
