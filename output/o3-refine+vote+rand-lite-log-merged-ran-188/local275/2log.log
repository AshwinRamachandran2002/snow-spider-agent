Query:
--Description: Summarise, for every product, how many 2017 months have a seasonality-adjusted
--             ratio (qty ÷ centred 12-month moving average) above 2, plus that product’s
--             minimum and maximum ratio in 2017.  This lets us see who comes closest to
--             meeting an “always-above-2” condition without filtering anyone out.
WITH cma AS (                              -- centred 12-month moving average
    SELECT
        ms.product_id,
        ms.mth,
        ms.qty,
        AVG(ms.qty) OVER (
            PARTITION BY ms.product_id
            ORDER BY ms.mth
            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
        ) AS cma
    FROM monthly_sales AS ms
),
ratio_2017 AS (                            -- compute 2017 ratios
    SELECT
        c.product_id,
        c.mth,
        c.qty / c.cma AS ratio
    FROM cma AS c
    WHERE substr(c.mth,1,4) = '2017'
      AND c.cma IS NOT NULL
)
SELECT
    r.product_id,
    COUNT(CASE WHEN r.ratio > 2 THEN 1 END) AS months_above_2,
    MIN(r.ratio)                             AS min_ratio_2017,
    MAX(r.ratio)                             AS max_ratio_2017
FROM ratio_2017 AS r
GROUP BY r.product_id
ORDER BY months_above_2 DESC, r.product_id
