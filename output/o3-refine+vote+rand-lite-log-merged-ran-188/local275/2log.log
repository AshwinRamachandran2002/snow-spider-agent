-- Description: Compute CMA and the seasonality-adjusted ratio for EVERY product & month in the set.
WITH cma_calc AS (
    SELECT product_id,
           mth,
           qty,
           AVG(qty) OVER (
               PARTITION BY product_id
               ORDER BY mth
               ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
           ) AS cma
    FROM monthly_sales
)
SELECT product_id,
       mth,
       qty,
       cma,
       qty / cma AS ratio
FROM cma_calc
WHERE cma IS NOT NULL
LIMIT 20;
