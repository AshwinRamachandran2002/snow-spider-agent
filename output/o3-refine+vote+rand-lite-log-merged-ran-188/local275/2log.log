```sql
--Description: Identify every product whose seasonality-adjusted sales ratio (qty ÷ centred 12-month moving average)
--             exceeded 2 in EACH of the 12 months of 2017.
WITH cma AS (                                   -- 1. centred 12-month moving average
    SELECT
        ms.product_id,
        ms.mth,
        ms.qty,
        AVG(ms.qty) OVER (
            PARTITION BY ms.product_id
            ORDER BY ms.mth
            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
        ) AS cma
    FROM monthly_sales AS ms
),
ratio_2017 AS (                                 -- 2. 2017 rows + ratio
    SELECT
        c.product_id,
        c.mth,
        c.qty / c.cma AS ratio
    FROM cma AS c
    WHERE substr(c.mth, 1, 4) = '2017'
      AND c.cma IS NOT NULL
)
SELECT
    r.product_id
FROM ratio_2017 AS r
GROUP BY r.product_id
HAVING COUNT(*) = 12                 -- all twelve months present
   AND MIN(r.ratio)  > 2;            -- every month’s ratio above 2
