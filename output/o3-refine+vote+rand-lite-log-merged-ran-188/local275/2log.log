```sql
--Description: 
-- To understand why our previous “ratio > 2” filter produced no rows, we first
--  examine *all* 2017 seasonality-adjusted ratios (qty ÷ centred 12-month moving
--  average).  We:  
--    1) calculate the centred 12-month moving average (CMA) for every product/month;  
--    2) keep just the 2017 months that have a CMA;  
--    3) show each row’s ratio, ordering by ratio descending so we can inspect  
--       the highest values and decide on a realistic threshold later.
WITH cma AS (
    SELECT
        ms.product_id,
        ms.mth,
        ms.qty,
        AVG(ms.qty) OVER (
            PARTITION BY ms.product_id
            ORDER BY ms.mth
            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
        ) AS cma
    FROM monthly_sales AS ms
),
ratio_2017 AS (
    SELECT
        c.product_id,
        c.mth,
        c.qty / c.cma AS ratio
    FROM cma AS c
    WHERE substr(c.mth, 1, 4) = '2017'
      AND c.cma IS NOT NULL
)
SELECT
    r.product_id,
    r.mth,
    ROUND(r.ratio, 3) AS ratio     -- rounded for readability
FROM ratio_2017 AS r
ORDER BY r.ratio DESC
LIMIT 30;
```
