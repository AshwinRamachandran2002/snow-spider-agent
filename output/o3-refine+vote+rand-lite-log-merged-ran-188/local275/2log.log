```sql
--Description:
-- Goal: after the strict “ratio > 2 for ALL 12 months of 2017” gave no results, identify which products
-- nevertheless achieved a seasonality-adjusted ratio (qty ÷ centred 12-month moving average) above 2
-- in at least THREE separate 2017 months.  Reasoning steps, all embedded below:
--   1) Build a centred 12-month moving average (CMA) per product-month (5 months before, current, 6 after).
--   2) Keep only 2017 rows that have a CMA and compute the ratio.
--   3) Count, per product, the number of 2017 months whose ratio > 2.
--   4) Return products with ≥ 3 such months, along with the count and product name for inspection.
WITH cma AS (                            -- 1. centred moving average
    SELECT
        ms.product_id,
        ms.mth,
        ms.qty,
        AVG(ms.qty) OVER (
            PARTITION BY ms.product_id
            ORDER BY ms.mth
            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
        ) AS cma
    FROM monthly_sales AS ms
),
ratio_2017 AS (                          -- 2. compute 2017 ratios
    SELECT
        c.product_id,
        c.mth,
        c.qty / c.cma AS ratio
    FROM cma AS c
    WHERE substr(c.mth, 1, 4) = '2017'
      AND c.cma IS NOT NULL
),
cnt AS (                                 -- 3. count ratio>2 months
    SELECT
        r.product_id,
        COUNT(*) AS months_above_2
    FROM ratio_2017 AS r
    WHERE r.ratio > 2
    GROUP BY r.product_id
)
-- 4. final list
SELECT
    p.id   AS product_id,
    p.name AS product_name,
    cnt.months_above_2
FROM cnt
JOIN products AS p ON p.id = cnt.product_id
WHERE cnt.months_above_2 >= 3
ORDER BY cnt.months_above_2 DESC, p.id;
```
