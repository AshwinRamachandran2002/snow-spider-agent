```

```sql
-- 2) How many months of data do we have per product from 2016-01 onward?
SELECT product_id,
       COUNT(*) AS months_cnt
FROM monthly_sales
WHERE mth >= '2016-01-01'
GROUP BY product_id
LIMIT 20;
```

```sql
-- 3) Example: see two years of sales for product 4040 (Jan-2016 … Dec-2017)
SELECT mth,
       qty
FROM monthly_sales
WHERE product_id = 4040
  AND mth BETWEEN '2016-01-01' AND '2017-12-01'
ORDER BY mth
LIMIT 24;
```

```sql
-- 4) For each 4040 month, compute a centred 13-month moving average (6 before + month + 6 after)
SELECT a.product_id,
       a.mth,
       a.qty,
       (SELECT AVG(b.qty)
        FROM monthly_sales AS b
        WHERE b.product_id = a.product_id
          AND ABS( (CAST(strftime('%Y',b.mth) AS INTEGER) - CAST(strftime('%Y',a.mth) AS INTEGER))*12
                    + (CAST(strftime('%m',b.mth) AS INTEGER) - CAST(strftime('%m',a.mth) AS INTEGER)) ) <= 6
       ) AS centred_ma
FROM monthly_sales AS a
WHERE a.product_id = 4040
  AND a.mth BETWEEN '2016-01-01' AND '2017-12-01'
ORDER BY a.mth
LIMIT 24;
```

```sql
-- 5) Seasonality-adjusted ratio (qty / centred MA) for product 4040 during 2017
SELECT a.mth,
       ROUND( a.qty / centred_ma , 3 ) AS seasonality_ratio
FROM (
        SELECT a.mth,
               a.qty,
               (SELECT AVG(b.qty)
                FROM monthly_sales AS b
                WHERE b.product_id = a.product_id
                  AND ABS( (CAST(strftime('%Y',b.mth) AS INTEGER) - CAST(strftime('%Y',a.mth) AS INTEGER))*12
                            + (CAST(strftime('%m',b.mth) AS INTEGER) - CAST(strftime('%m',a.mth) AS INTEGER)) ) <= 6
               ) AS centred_ma
        FROM monthly_sales AS a
        WHERE a.product_id = 4040
  ) AS a
WHERE strftime('%Y', a.mth) = '2017'
ORDER BY a.mth;
```

```sql
-- 6) Compute seasonality ratio for ALL products for every month in 2017
WITH centred AS (
    SELECT a.product_id,
           a.mth,
           a.qty,
           (SELECT AVG(b.qty)
            FROM monthly_sales AS b
            WHERE b.product_id = a.product_id
              AND ABS( (CAST(strftime('%Y',b.mth) AS INTEGER) - CAST(strftime('%Y',a.mth) AS INTEGER))*12
                        + (CAST(strftime('%m',b.mth) AS INTEGER) - CAST(strftime('%m',a.mth) AS INTEGER)) ) <= 6
           ) AS centred_ma
    FROM monthly_sales AS a
)
SELECT product_id,
       mth,
       ROUND(qty / centred_ma, 3) AS seasonality_ratio
FROM centred
WHERE centred_ma IS NOT NULL
  AND strftime('%Y', mth) = '2017'
LIMIT 20;
```

```sql
-- 7) Minimum 2017 seasonality ratio per product
WITH centred AS (
    SELECT a.product_id,
           a.mth,
           a.qty,
           (SELECT AVG(b.qty)
            FROM monthly_sales AS b
            WHERE b.product_id = a.product_id
              AND ABS( (CAST(strftime('%Y',b.mth) AS INTEGER) - CAST(strftime('%Y',a.mth) AS INTEGER))*12
                        + (CAST(strftime('%m',b.mth) AS INTEGER) - CAST(strftime('%m',a.mth) AS INTEGER)) ) <= 6
           ) AS centred_ma
    FROM monthly_sales AS a
),
ratio AS (
    SELECT product_id,
           mth,
           qty / centred_ma AS seasonality_ratio
    FROM centred
    WHERE centred_ma IS NOT NULL
      AND strftime('%Y', mth) = '2017'
)
SELECT product_id,
       MIN(seasonality_ratio) AS min_ratio_2017
FROM ratio
GROUP BY product_id
LIMIT 20;
```

```sql
-- 8) FINAL ANSWER – products whose seasonality-adjusted ratio was > 2 for every month in 2017
WITH centred AS (
    SELECT a.product_id,
           a.mth,
           a.qty,
           (SELECT AVG(b.qty)
            FROM monthly_sales AS b
            WHERE b.product_id = a.product_id
              AND ABS( (CAST(strftime('%Y',b.mth) AS INTEGER) - CAST(strftime('%Y',a.mth) AS INTEGER))*12
                        + (CAST(strftime('%m',b.mth) AS INTEGER) - CAST(strftime('%m',a.mth) AS INTEGER)) ) <= 6
           ) AS centred_ma
    FROM monthly_sales AS a
    WHERE a.mth >= '2016-01-01'
),
ratio AS (
    SELECT product_id,
           mth,
           qty / centred_ma AS seasonality_ratio
    FROM centred
    WHERE centred_ma IS NOT NULL
      AND strftime('%Y', mth) = '2017'
),
good_products AS (
    SELECT product_id
    FROM ratio
    GROUP BY product_id
    HAVING MIN(seasonality_ratio) > 2
)
SELECT p.id AS product_id,
       p.name
FROM good_products AS g
JOIN products     AS p ON p.id = g.product_id;
