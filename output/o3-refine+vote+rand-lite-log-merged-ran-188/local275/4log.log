--Description / thinking process:
-- We simplify the earlier requirement by simply reporting, for every product,
-- the **lowest** seasonality-adjusted ratio it achieved in 2017.
-- Steps
-- 1. centred CTE: for each (product, month) we calculate a 13-month centred moving
--    average (“trend”) using the 6 months before and after the current month.
-- 2. ratio   CTE: restrict to 2017 months and compute the seasonality ratio
--       ratio = qty / trend
-- 3. Final SELECT: group by product and return the minimum ratio observed in 2017.
--    This helps us see whether any product stayed above (or fell below) a
--    particular threshold such as 2.
WITH centred AS (
    SELECT a.product_id,
           a.mth,
           a.qty,
           (SELECT AVG(b.qty)
            FROM monthly_sales b
            WHERE b.product_id = a.product_id
              AND ABS( (CAST(strftime('%Y',b.mth) AS INTEGER) - CAST(strftime('%Y',a.mth) AS INTEGER))*12
                        + (CAST(strftime('%m',b.mth) AS INTEGER) - CAST(strftime('%m',a.mth) AS INTEGER)) ) <= 6
           ) AS trend
    FROM monthly_sales a
    WHERE a.mth >= '2016-01-01'           -- ensure the 13-month window is available for 2017
),
ratio AS (
    SELECT product_id,
           mth,
           qty / trend AS seasonality_ratio
    FROM centred
    WHERE trend IS NOT NULL
      AND strftime('%Y', mth) = '2017'
)
SELECT p.id                AS product_id,
       p.name              AS product_name,
       ROUND(MIN(seasonality_ratio), 3) AS min_ratio_2017
FROM ratio r
