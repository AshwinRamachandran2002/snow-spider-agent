--              For each product-month we compute a centred 13-month moving
--              average (six months before, the month itself, six months after),
--              derive the seasonality ratio (actual quantity ÷ moving average),
--              flag months where the ratio exceeds 2, count those “hot” months
--              per product, and finally join to the products table so we see
--              readable names.  The output lists any product that managed at
--              least one such hot month, ordered by how many times it happened.
WITH ratio_2017 AS (
    SELECT product_id,
           qty / AVG(qty) OVER (
                   PARTITION BY product_id
                   ORDER BY mth
                   ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
           ) AS seas_ratio
    FROM   monthly_sales
    WHERE  mth BETWEEN '2017-01-01' AND '2017-12-31'
),
hot_counts AS (
    SELECT product_id,
           SUM(CASE WHEN seas_ratio > 2 THEN 1 ELSE 0 END) AS hot_months
    FROM   ratio_2017
    GROUP BY product_id
    HAVING hot_months >= 1                    -- simplified: at least one hot month
)
SELECT p.id   AS product_id,
       p.name AS product_name,
       h.hot_months
FROM   products   AS p
JOIN   hot_counts AS h  ON p.id = h.product_id
ORDER  BY h.hot_months DESC,
          p.id;
```
