```sql
--Description:  To relax the earlier (empty-result) requirement, we now look for
--              products whose overall seasonality-adjusted performance was
--              strong on average: we calculate each product’s average ratio
--              (actual quantity ÷ 13-month centred moving average) across the
--              12 months of 2017 and keep those whose average ratio exceeds 2.
--              Steps
--                1. Restrict rows to 2017.
--                2. For every product-month, compute the centred 13-month moving
--                   average (6 months before + current + 6 months after).
--                3. Derive the ratio (qty / moving-avg).
--                4. Aggregate by product to get the 2017 average ratio.
--                5. Return products whose average ratio > 2, ordering by that
--                   average so the most “over-trend” items appear first.
SELECT  product_id,
        ROUND(AVG(qty / AVG(qty) OVER (
                     PARTITION BY product_id
                     ORDER BY mth
                     ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
                 )), 2) AS avg_ratio_2017
FROM   monthly_sales
WHERE  mth BETWEEN '2017-01-01' AND '2017-12-31'
GROUP BY product_id
HAVING avg_ratio_2017 > 2
ORDER  BY avg_ratio_2017 DESC, product_id;
```
