--Description:  Identify products whose demand was exceptionally high for the
--              whole of 2017.  For every product-month we
--                • compute a 13-month centred moving average of quantity
--                • compare the actual quantity to that average
--              We then count, per product, how many 2017 months exceeded
--              double the moving average.  Only products that managed this
--              in ALL 12 months are returned (i.e. they were >2 every month).
SELECT product_id
FROM (
        SELECT product_id,
               CASE
                   WHEN qty / AVG(qty) OVER (
                            PARTITION BY product_id
                            ORDER BY mth
                            ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
                        ) > 2
                   THEN 1 ELSE 0
               END AS above2_flag
        FROM   monthly_sales
        WHERE  mth BETWEEN '2017-01-01' AND '2017-12-31'
) AS ratio_flags
GROUP BY product_id
HAVING SUM(above2_flag) = 12;   -- only keep those above 2 in all 12 months
