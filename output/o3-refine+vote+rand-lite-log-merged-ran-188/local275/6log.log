WITH seasonality AS (
    SELECT
        ms.product_id,
        ms.mth,
        ms.qty,
        AVG(ms.qty) OVER (
            PARTITION BY ms.product_id
            ORDER BY ms.mth
            ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
        ) AS mov_avg_13m
    FROM monthly_sales AS ms
),
ratio_2017 AS (
    SELECT
        product_id,
        mth,
        qty / mov_avg_13m AS ratio
    FROM seasonality
    WHERE mth BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT
    p.id   AS product_id,
    p.name AS product_name
FROM ratio_2017 AS r
JOIN products AS p ON p.id = r.product_id
GROUP BY p.id, p.name
HAVING COUNT(*) = 12          -- all 12 months present
   AND MIN(ratio) > 2;        -- ratio above 2 for every month
```
