        ms.qty,
        AVG(ms.qty) OVER (
            PARTITION BY ms.product_id
            ORDER BY ms.mth
            ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
        ) AS mov_avg_13m
    FROM monthly_sales AS ms
),
ratio_2017 AS (
