```sql
-- 1) Peek at the first few rows of the sales fact table
SELECT *
FROM "monthly_sales"
LIMIT 20;
```

```sql
-- 2) Find the full month span we have in the fact table
SELECT MIN("mth")  AS first_month ,
       MAX("mth")  AS last_month ,
       COUNT(DISTINCT "mth") AS month_count
FROM "monthly_sales";
```

```sql
-- 3) Which products already have data for every month of calendar-year 2017?
SELECT "product_id",
       COUNT(*) AS months_2017
FROM   "monthly_sales"
WHERE  "mth" BETWEEN '2017-01-01' AND '2017-12-31'
GROUP  BY "product_id"
HAVING COUNT(*) = 12
LIMIT 20;
```

```sql
-- 4) Inspect one example product across 2016-2018 to get a feel for volumes
SELECT *
FROM   "monthly_sales"
WHERE  "product_id" = 4040          -- sample product
  AND  "mth" BETWEEN '2016-01-01' AND '2018-12-31'
ORDER  BY "mth"
LIMIT 20;
```

```sql
-- 5) Compute a centred 12-month moving average per product and month
--    (6 months behind + the month itself + 6 months ahead = 13 months)
SELECT product_id,
       mth,
       qty,
       ROUND( AVG(qty) OVER (
                PARTITION BY product_id
                ORDER BY mth
                ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
             ), 2 )           AS mov_avg_13m
FROM   monthly_sales
ORDER  BY product_id, mth
LIMIT 20;
```

```sql
-- 6) Turn that into a seasonality ratio (actual ÷ centred moving average)
SELECT product_id,
       mth,
       qty,
       mov_avg_13m,
       ROUND( qty / mov_avg_13m , 2 ) AS seas_ratio
FROM (
        SELECT product_id,
               mth,
               qty,
               AVG(qty) OVER (
                   PARTITION BY product_id
                   ORDER BY mth
                   ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
               ) AS mov_avg_13m
        FROM   monthly_sales
) AS t
ORDER BY product_id, mth
LIMIT 20;
```

```sql
-- 7) Keep only the 2017 rows and flag whether ratio > 2
SELECT product_id,
       mth,
       CASE WHEN (qty / mov_avg_13m) > 2 THEN 1 ELSE 0 END AS above2_flag
FROM (
        SELECT product_id,
               mth,
               qty,
               AVG(qty) OVER (
                   PARTITION BY product_id
                   ORDER BY mth
                   ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
               ) AS mov_avg_13m
        FROM   monthly_sales
) AS t
WHERE  mth BETWEEN '2017-01-01' AND '2017-12-31'
ORDER BY product_id, mth
LIMIT 20;
```

```sql
-- 8) Count how many of the 12 months in 2017 each product kept the ratio > 2
SELECT  product_id,
        SUM(above2_flag)          AS months_above2,
        COUNT(*)                  AS months_total
FROM (
        SELECT product_id,
               mth,
               CASE WHEN (qty / mov_avg_13m) > 2 THEN 1 ELSE 0 END AS above2_flag
        FROM (
                SELECT product_id,
                       mth,
                       qty,
                       AVG(qty) OVER (
                           PARTITION BY product_id
                           ORDER BY mth
                           ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
                       ) AS mov_avg_13m
                FROM   monthly_sales
        ) AS s
        WHERE  mth BETWEEN '2017-01-01' AND '2017-12-31'
) AS t
GROUP  BY product_id
LIMIT 20;
```

```sql
-- 9) FINAL ANSWER – products whose seasonality-adjusted ratio stayed >2
--    on ALL twelve months of 2017
SELECT DISTINCT product_id
FROM (
        SELECT  product_id,
                SUM(above2_flag) AS months_above2
        FROM (
                SELECT product_id,
                       mth,
                       CASE WHEN (qty / mov_avg_13m) > 2 THEN 1 ELSE 0 END AS above2_flag
                FROM (
                        SELECT product_id,
                               mth,
                               qty,
                               AVG(qty) OVER (
                                   PARTITION BY product_id
                                   ORDER BY mth
                                   ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
                               ) AS mov_avg_13m
                        FROM   monthly_sales
                ) AS x
                WHERE  mth BETWEEN '2017-01-01' AND '2017-12-31'
        ) AS y
        GROUP BY product_id
        HAVING months_above2 = 12
);
```

