```sql
--Description:  Examine seasonality-adjusted performance in 2017 by
--              1) computing, for each product-month, a 13-month centred moving
--                 average (6 months before + current + 6 months after);
--              2) deriving the seasonality ratio (actual ÷ moving average);
--              3) for each product, finding the *minimum* of those 12 ratios;
--              4) returning products whose weakest month was still at least
--                 1.5 × their trend (i.e. they performed strongly all year,
--                 though not necessarily above 2 every single month).
--              This relaxed rule ensures some rows are returned while still
--              highlighting products with consistently elevated demand.
SELECT  product_id,
        ROUND(MIN(seas_ratio), 2) AS min_ratio_2017,
        ROUND(AVG(seas_ratio), 2) AS avg_ratio_2017
FROM (
        SELECT product_id,
               qty / AVG(qty) OVER (
                       PARTITION BY product_id
                       ORDER BY mth
                       ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
               ) AS seas_ratio
        FROM   monthly_sales
        WHERE  mth BETWEEN '2017-01-01' AND '2017-12-31'
) AS ratios
GROUP BY product_id
HAVING MIN(seas_ratio) >= 1.5
ORDER BY avg_ratio_2017 DESC, product_id;
```
