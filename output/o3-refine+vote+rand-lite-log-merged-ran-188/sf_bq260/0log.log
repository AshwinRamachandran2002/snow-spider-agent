Query:
--Description: 9) For each gender, count how many users are at that gender’s youngest age.  
WITH gender_min AS (
  SELECT "gender", MIN("age") AS "youngest_age"
  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651276800000000
  GROUP BY "gender"
)
SELECT u."gender",
       COUNT(*) AS "num_at_gender_youngest_age"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
JOIN gender_min g
     ON u."gender" = g."gender"
    AND u."age" = g."youngest_age"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651276800000000
GROUP BY u."gender"
ORDER BY u."gender";
