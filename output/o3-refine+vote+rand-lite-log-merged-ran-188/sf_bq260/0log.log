```

```sql
--Description: 4) List the distinct genders that appear in the USERS table.  
SELECT DISTINCT "gender"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS";
```

```sql
--Description: 5) Find the youngest and oldest age observed (without gender split) inside the date window.  
SELECT MIN("age") AS "youngest_age_overall",
       MAX("age") AS "oldest_age_overall"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1651276800000000;
```

```sql
--Description: 6) Retrieve the youngest and oldest age for every gender in that same window.  
SELECT "gender",
       MIN("age") AS "youngest_age",
       MAX("age") AS "oldest_age"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1651276800000000
GROUP BY "gender";
```

```sql
--Description: 7) Count how many users are at the youngest age OVERALL (ignores gender) in the timeframe.  
WITH base AS (
  SELECT MIN("age") AS "youngest_age"
  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651276800000000
)
SELECT COUNT(*) AS "num_youngest_users"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS", base
WHERE "created_at" BETWEEN 1546300800000000 AND 1651276800000000
  AND "age" = base."youngest_age";
```

```sql
--Description: 8) Count how many users are at the oldest age OVERALL (ignores gender) within the window.  
WITH base AS (
  SELECT MAX("age") AS "oldest_age"
  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651276800000000
)
SELECT COUNT(*) AS "num_oldest_users"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS", base
WHERE "created_at" BETWEEN 1546300800000000 AND 1651276800000000
  AND "age" = base."oldest_age";
```

```sql
--Description: 9) For each gender, count how many users are at that gender’s youngest age.  
WITH gender_min AS (
  SELECT "gender", MIN("age") AS "youngest_age"
  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651276800000000
  GROUP BY "gender"
)
SELECT u."gender",
       COUNT(*) AS "num_at_gender_youngest_age"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
JOIN gender_min g
     ON u."gender" = g."gender"
    AND u."age" = g."youngest_age"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651276800000000
GROUP BY u."gender"
ORDER BY u."gender";
```

