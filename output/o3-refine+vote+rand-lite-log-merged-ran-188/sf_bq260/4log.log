```sql
--Description: 1) Look at a random sample of users created between 1-Jan-2019 and 30-Apr-2022
SELECT *
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
ORDER BY RANDOM()
LIMIT 20;
```

```sql
--Description: 2) Show the distinct ages that appear for every gender in the period
SELECT DISTINCT "gender", "age"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
ORDER BY "gender", "age"
LIMIT 20;
```

```sql
--Description: 3) Get the youngest (MIN) and oldest (MAX) age values observed for each gender
SELECT "gender",
       MIN("age") AS "youngest_age",
       MAX("age") AS "oldest_age"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY "gender"
LIMIT 20;
```

```sql
--Description: 4) Count users at the youngest age for every gender
WITH age_bounds AS (
  SELECT "gender", MIN("age") AS "youngest_age"
  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
  GROUP BY "gender"
)
SELECT u."gender",
       a."youngest_age",
       COUNT(*) AS "num_users_at_youngest_age"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
JOIN age_bounds a
  ON u."gender" = a."gender"
 AND u."age"    = a."youngest_age"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY u."gender", a."youngest_age"
LIMIT 20;
```

```sql
--Description: 5) Count users at the oldest age for every gender
WITH age_bounds AS (
  SELECT "gender", MAX("age") AS "oldest_age"
  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
  GROUP BY "gender"
)
SELECT u."gender",
       a."oldest_age",
       COUNT(*) AS "num_users_at_oldest_age"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
JOIN age_bounds a
  ON u."gender" = a."gender"
 AND u."age"    = a."oldest_age"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY u."gender", a."oldest_age"
LIMIT 20;
```

```sql
--Description: 6) Show in one row per gender the youngest & oldest ages and their respective user counts
WITH bounds AS (
  SELECT "gender",
         MIN("age") AS "youngest_age",
         MAX("age") AS "oldest_age"
  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
  GROUP BY "gender"
)
SELECT b."gender",
       b."youngest_age",
       COUNT(CASE WHEN u."age" = b."youngest_age" THEN 1 END) AS "users_at_youngest_age",
       b."oldest_age",
       COUNT(CASE WHEN u."age" = b."oldest_age"  THEN 1 END) AS "users_at_oldest_age"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
JOIN bounds b
  ON u."gender" = b."gender"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY b."gender", b."youngest_age", b."oldest_age"
LIMIT 20;
```

```sql
--Description: 7) Produce two rows (youngest & oldest) for every gender with counts, easy to UNION later
WITH youngest AS (
  SELECT "gender",
         MIN("age") AS "age_bound"
  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
  GROUP BY "gender"
), oldest AS (
  SELECT "gender",
         MAX("age") AS "age_bound"
  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
  GROUP BY "gender"
)
SELECT y."gender", 'youngest' AS "age_type", y."age_bound" AS "age",
       COUNT(u."id") AS "num_users"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
JOIN youngest y ON u."gender" = y."gender" AND u."age" = y."age_bound"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY y."gender", y."age_bound"
UNION ALL
SELECT o."gender", 'oldest'   AS "age_type", o."age_bound" AS "age",
       COUNT(u."id") AS "num_users"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
JOIN oldest  o ON u."gender" = o."gender" AND u."age" = o."age_bound"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY o."gender", o."age_bound"
LIMIT 20;
```

```sql
--Description: 8) Peek at the five youngest and five oldest ages (with user counts) for every gender
SELECT "gender", "age", COUNT(*) AS "num_users"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY "gender", "age"
QUALIFY ROW_NUMBER() OVER (PARTITION BY "gender" ORDER BY "age" ASC) <= 5
   OR  ROW_NUMBER() OVER (PARTITION BY "gender" ORDER BY "age" DESC) <= 5
ORDER BY "gender", "age"
LIMIT 20;
```

```sql
--Description: 9) Check user counts per year (to make sure the date filter catches data points)
SELECT TO_CHAR(TO_TIMESTAMP("created_at"/1000000), 'YYYY') AS "year",
       COUNT(*) AS "num_users"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY "year"
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: 10) Final concise summary: youngest / oldest age values and user counts for each gender
WITH bounds AS (
  SELECT "gender",
         MIN("age") AS "youngest_age",
         MAX("age") AS "oldest_age"
  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
  GROUP BY "gender"
)
SELECT b."gender",
       b."youngest_age",
       SUM(CASE WHEN u."age" = b."youngest_age" THEN 1 ELSE 0 END) AS "users_at_youngest_age",
       b."oldest_age",
       SUM(CASE WHEN u."age" = b."oldest_age"  THEN 1 ELSE 0 END) AS "users_at_oldest_age"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
JOIN bounds b ON u."gender" = b."gender"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY b."gender", b."youngest_age", b."oldest_age"
LIMIT 20;
```
