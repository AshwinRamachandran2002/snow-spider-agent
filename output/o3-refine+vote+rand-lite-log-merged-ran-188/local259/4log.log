Query:
--Description: Number of matches in which players scored 50 or more runs (sample 20)
WITH player_match_runs AS (
    SELECT   b.striker                AS player_id,
             b.match_id,
             SUM(bs.runs_scored)      AS runs_in_match
    FROM     ball_by_ball   AS b
    JOIN     batsman_scored AS bs
           ON bs.match_id   = b.match_id
          AND bs.over_id    = b.over_id
          AND bs.ball_id    = b.ball_id
          AND bs.innings_no = b.innings_no
    GROUP BY b.striker, b.match_id
)
SELECT
       player_id,
       COUNT(CASE WHEN runs_in_match >= 50 THEN 1 END) AS fifty_or_more
FROM   player_match_runs
GROUP  BY player_id
ORDER  BY fifty_or_more DESC
LIMIT 20
