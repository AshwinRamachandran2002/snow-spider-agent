```sql
--Description: Retrieve the different kinds of roles a player can have in a match
SELECT DISTINCT 
       role
FROM   player_match
LIMIT 20;
```

```sql
--Description: View how particular players were used (role + match date) in a few matches
SELECT DISTINCT 
       pm.player_id,
       p.player_name,
       pm.role,
       pm.match_id,
       m.match_date
FROM   player_match AS pm
JOIN   player        AS p ON p.player_id = pm.player_id
JOIN   match         AS m ON m.match_id  = pm.match_id
LIMIT 20;
```

```sql
--Description: Total career runs scored by each player (top 20 run-scorers)
SELECT DISTINCT
       b.striker AS player_id,
       SUM(bs.runs_scored) AS total_runs
FROM   ball_by_ball  AS b
JOIN   batsman_scored AS bs 
       USING (match_id, over_id, ball_id, innings_no)
GROUP  BY b.striker
ORDER  BY total_runs DESC
LIMIT 20;
```

```sql
--Description: Total career balls faced by each player (top 20)
SELECT DISTINCT
       striker  AS player_id,
       COUNT(*) AS balls_faced
FROM   ball_by_ball
GROUP  BY striker
ORDER  BY balls_faced DESC
LIMIT 20;
```

```sql
--Description: Number of times each player has been dismissed (top 20)
SELECT DISTINCT
       player_out AS player_id,
       COUNT(*)   AS dismissals
FROM   wicket_taken
GROUP  BY player_out
ORDER  BY dismissals DESC
LIMIT 20;
```

```sql
--Description: Total wickets taken by each bowler (top 20 wicket-takers)
SELECT DISTINCT
       bowler    AS player_id,
       COUNT(*)  AS wickets_taken
FROM   wicket_taken
GROUP  BY bowler
ORDER  BY wickets_taken DESC
LIMIT 20;
```

```sql
--Description: Total runs conceded by bowlers (sample of 20 bowlers)
SELECT DISTINCT
       b.bowler                    AS player_id,
       SUM(bs.runs_scored)         AS runs_conceded
FROM   ball_by_ball   AS b
JOIN   batsman_scored AS bs 
       USING (match_id, over_id, ball_id, innings_no)
GROUP  BY b.bowler
LIMIT 20;
```

```sql
--Description: Best bowling display per bowler (most wkts, then fewest runs) – sample 20
SELECT DISTINCT
       b.bowler                    AS player_id,
       COUNT(*)                    AS wickets_in_match,
       SUM(bs.runs_scored)         AS runs_conceded,
       b.match_id
FROM   wicket_taken  AS w
JOIN   ball_by_ball  AS b
       ON  b.match_id   = w.match_id
       AND b.over_id    = w.over_id
       AND b.ball_id    = w.ball_id
       AND b.innings_no = w.innings_no
JOIN   batsman_scored AS bs
       ON  bs.match_id   = b.match_id
       AND bs.over_id    = b.over_id
       AND bs.ball_id    = b.ball_id
       AND bs.innings_no = b.innings_no
GROUP  BY b.bowler, b.match_id
ORDER  BY wickets_in_match DESC, runs_conceded ASC
LIMIT 20;
```

```sql
--Description: Number of matches in which players scored 50+ runs (sample 20)
WITH player_match_runs AS (
    SELECT   b.striker  AS player_id,
             b.match_id,
             SUM(bs.runs_scored) AS runs_in_match
    FROM     ball_by_ball   AS b
    JOIN     batsman_scored AS bs 
             USING (match_id, over_id, ball_id, innings_no)
    GROUP BY b.striker, b.match_id
)
SELECT DISTINCT
       player_id,
       COUNT(CASE WHEN runs_in_match >= 50 THEN 1 END) AS fifty_or_more
FROM   player_match_runs
GROUP  BY player_id
ORDER  BY fifty_or_more DESC
LIMIT 20;
```
