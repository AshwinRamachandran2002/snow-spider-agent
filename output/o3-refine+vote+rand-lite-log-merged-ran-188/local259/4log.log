Query:
--Description: Best bowling performance (most wickets, then fewest runs) per bowler in a single match – consider all deliveries, not just wicket balls
WITH per_ball AS (
    SELECT  b.match_id,
            b.bowler                          AS player_id,
            bs.runs_scored                    AS runs_conceded,
            CASE WHEN w.player_out IS NULL
                 THEN 0 ELSE 1 END            AS is_wicket
    FROM   ball_by_ball   AS b
    JOIN   batsman_scored AS bs
           ON  bs.match_id   = b.match_id
          AND bs.over_id    = b.over_id
          AND bs.ball_id    = b.ball_id
          AND bs.innings_no = b.innings_no
    LEFT JOIN wicket_taken AS w
           ON  w.match_id    = b.match_id
          AND w.over_id     = b.over_id
          AND w.ball_id     = b.ball_id
          AND w.innings_no  = b.innings_no
)
SELECT
       player_id,
       SUM(is_wicket)          AS wickets_in_match,
       SUM(runs_conceded)      AS runs_conceded,
       match_id
FROM   per_ball
GROUP  BY player_id, match_id
ORDER  BY wickets_in_match DESC,
          runs_conceded ASC
LIMIT 20
