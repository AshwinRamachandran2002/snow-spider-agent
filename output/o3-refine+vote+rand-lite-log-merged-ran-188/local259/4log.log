```sql
--Description / Thinking process:
-- We need to list how many wickets each bowler has taken.
-- The wicket_taken table tells us a wicket happened but NOT the bowler.
-- The bowler for every delivery is stored in ball_by_ball using the same composite key:
--   (match_id, over_id, ball_id, innings_no).
-- Therefore, join wicket_taken (alias w) to ball_by_ball (alias b) on those four columns
-- to attach the bowler to every dismissal.
-- Once the bowler is known for every wicket, group by b.bowler and count rows
-- (each row = 1 wicket for that bowler).  Finally order by this count and limit to 20.
SELECT
       b.bowler AS player_id,
       COUNT(*) AS wickets_taken
FROM   wicket_taken AS w
JOIN   ball_by_ball AS b
       ON b.match_id   = w.match_id
      AND b.over_id    = w.over_id
      AND b.ball_id    = w.ball_id
      AND b.innings_no = w.innings_no
GROUP  BY b.bowler
ORDER  BY wickets_taken DESC
LIMIT 20;
```
