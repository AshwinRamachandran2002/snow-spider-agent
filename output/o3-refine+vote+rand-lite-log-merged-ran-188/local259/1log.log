```sql
-- 1. Description: Look at basic information for a few players  
SELECT DISTINCT  
       p.player_id,  
       p.player_name,  
       p.batting_hand,  
       p.bowling_skill,  
       p.country_name  
FROM   player AS p  
LIMIT 20;
```

```sql
-- 2. Description: Check the different roles a player can have in a match  
SELECT DISTINCT  
       pm.role  
FROM   player_match AS pm  
LIMIT 20;
```

```sql
-- 3. Description: Inspect how many runs each ball produced for a striker (joined with player)  
SELECT DISTINCT  
       bs.match_id,  
       bs.over_id,  
       bs.ball_id,  
       bs.runs_scored,  
       bb.striker AS player_id,  
       p.player_name  
FROM   batsman_scored AS bs  
JOIN   ball_by_ball AS bb  
       ON bb.match_id = bs.match_id  
      AND bb.over_id  = bs.over_id  
      AND bb.ball_id  = bs.ball_id  
JOIN   player AS p  
       ON p.player_id = bb.striker  
LIMIT 20;
```

```sql
-- 4. Description: Get total runs scored by each player (career aggregate)  
SELECT DISTINCT  
       bb.striker   AS player_id,  
       SUM(bs.runs_scored) AS total_runs  
FROM   batsman_scored AS bs  
JOIN   ball_by_ball  AS bb  
       ON bb.match_id = bs.match_id  
      AND bb.over_id  = bs.over_id  
      AND bb.ball_id  = bs.ball_id  
GROUP  BY bb.striker  
LIMIT 20;
```

```sql
-- 5. Description: Number of matches each player appeared in  
SELECT DISTINCT  
       player_id,  
       COUNT(DISTINCT match_id) AS matches_played  
FROM   player_match  
GROUP  BY player_id  
LIMIT 20;
```

```sql
-- 6. Description: How many times every player got out (dismissals)  
SELECT DISTINCT  
       wt.player_out AS player_id,  
       COUNT(*)      AS dismissals  
FROM   wicket_taken AS wt  
GROUP  BY wt.player_out  
LIMIT 20;
```

```sql
-- 7. Description: Total balls faced by each batsman (each striker-ball counts as one)  
SELECT DISTINCT  
       striker AS player_id,  
       COUNT(*) AS balls_faced  
FROM   ball_by_ball  
GROUP  BY striker  
LIMIT 20;
```

```sql
-- 8. Description: Career wickets taken by each bowler (join wicket_taken to ball_by_ball to know the bowler)  
SELECT DISTINCT  
       bb.bowler AS player_id,  
       COUNT(*)  AS wickets_taken  
FROM   wicket_taken AS wt  
JOIN   ball_by_ball AS bb  
       ON bb.match_id = wt.match_id  
      AND bb.over_id  = wt.over_id  
      AND bb.ball_id  = wt.ball_id  
GROUP  BY bb.bowler  
LIMIT 20;
```

```sql
-- 9. Description: Best bowling performance per bowler per match  
SELECT DISTINCT  
       bb.bowler      AS player_id,  
       wt.match_id,  
       COUNT(*)       AS wickets_in_match  
FROM   wicket_taken AS wt  
JOIN   ball_by_ball AS bb  
       ON bb.match_id = wt.match_id  
      AND bb.over_id  = wt.over_id  
      AND bb.ball_id  = wt.ball_id  
GROUP  BY bb.bowler, wt.match_id  
ORDER  BY wickets_in_match DESC  
LIMIT 20;
```

```sql
-- 10. Description: Highest score by each batsman in a single match  
SELECT DISTINCT  
       bb.striker            AS player_id,  
       bs.match_id,  
       SUM(bs.runs_scored)   AS runs_in_match  
FROM   batsman_scored AS bs  
JOIN   ball_by_ball  AS bb  
       ON bb.match_id = bs.match_id  
      AND bb.over_id  = bs.over_id  
      AND bb.ball_id  = bs.ball_id  
GROUP  BY bb.striker, bs.match_id  
ORDER BY runs_in_match DESC  
LIMIT 20;
```
