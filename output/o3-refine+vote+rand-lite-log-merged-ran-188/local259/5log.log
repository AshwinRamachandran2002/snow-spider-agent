     SELECT bb.striker AS player_id,
            p.player_name,
            bb.match_id,
            SUM(bs.runs_scored) AS match_runs
     FROM   batsman_scored AS bs
     JOIN   ball_by_ball   AS bb ON  bb.match_id = bs.match_id
                                AND bb.over_id  = bs.over_id
                                AND bb.ball_id  = bs.ball_id
     JOIN   player         AS p  ON p.player_id  = bb.striker
     GROUP  BY bb.match_id, bb.striker
) AS scorer
GROUP BY scorer.player_id, scorer.player_name
LIMIT 20;
