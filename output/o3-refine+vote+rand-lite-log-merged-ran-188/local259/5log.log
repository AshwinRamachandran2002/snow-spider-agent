```sql
-- 1. Description: Inspect basic player details (ID, name, batting hand, bowling skill).
SELECT DISTINCT
       player_id,
       player_name,
       batting_hand,
       bowling_skill
FROM   player
LIMIT 20;
```

```sql
-- 2. Description: See the set of different roles a player can have in the “player_match” table.
SELECT DISTINCT
       role
FROM   player_match
LIMIT 20;
```

```sql
-- 3. Description: Look at how a player’s role is recorded together with the team for a match.
SELECT DISTINCT
       player_id,
       match_id,
       role,
       team_id
FROM   player_match
LIMIT 20;
```

```sql
-- 4. Description: Get a feel for the “ball_by_ball” data – who batted/bowled on the first few deliveries.
SELECT DISTINCT
       match_id,
       over_id,
       ball_id,
       striker,
       bowler
FROM   ball_by_ball
LIMIT 20;
```

```sql
-- 5. Description: Combine “batsman_scored” with player names to see runs scored on individual balls.
SELECT DISTINCT
       bs.match_id,
       bs.over_id,
       bs.ball_id,
       p.player_name,
       bs.runs_scored
FROM   batsman_scored AS bs
JOIN   ball_by_ball   AS bb ON  bb.match_id = bs.match_id
                            AND bb.over_id  = bs.over_id
                            AND bb.ball_id  = bs.ball_id
JOIN   player         AS p  ON p.player_id  = bb.striker
LIMIT 20;
```

```sql
-- 6. Description: Aggregate sample – total runs per player (first 20 rows of the result).
SELECT DISTINCT
       p.player_id,
       p.player_name,
       SUM(bs.runs_scored) AS total_runs
FROM   batsman_scored AS bs
JOIN   ball_by_ball   AS bb ON  bb.match_id = bs.match_id
                            AND bb.over_id  = bs.over_id
                            AND bb.ball_id  = bs.ball_id
JOIN   player         AS p  ON p.player_id  = bb.striker
GROUP  BY p.player_id, p.player_name
LIMIT 20;
```

```sql
-- 7. Description: How many times has each player been dismissed? (sample 20 rows)
SELECT DISTINCT
       p.player_id,
       p.player_name,
       COUNT(wt.player_out) AS dismissals
FROM   wicket_taken AS wt
JOIN   player       AS p ON p.player_id = wt.player_out
GROUP  BY p.player_id, p.player_name
LIMIT 20;
```

```sql
-- 8. Description: Highest score a player achieved in any single match (sample 20).
SELECT DISTINCT
       scorer.player_id,
       scorer.player_name,
       MAX(scorer.match_runs) AS highest_score
FROM (
     SELECT bb.striker AS player_id,
            p.player_name,
            bb.match_id,
            SUM(bs.runs_scored) AS match_runs
     FROM   batsman_scored AS bs
     JOIN   ball_by_ball   AS bb ON  bb.match_id = bs.match_id
                                AND bb.over_id  = bs.over_id
                                AND bb.ball_id  = bs.ball_id
     JOIN   player         AS p  ON p.player_id  = bb.striker
     GROUP  BY bb.match_id, bb.striker
) AS scorer
GROUP BY scorer.player_id, scorer.player_name
LIMIT 20;
```

```sql
-- 9. Description: Total wickets each bowler has taken (sample 20 rows).
SELECT DISTINCT
       p.player_id,
       p.player_name,
       COUNT(*) AS wickets_taken
FROM   wicket_taken AS wt
JOIN   ball_by_ball AS bb ON  bb.match_id = wt.match_id
                          AND bb.over_id  = wt.over_id
                          AND bb.ball_id  = wt.ball_id
JOIN   player       AS p  ON p.player_id  = bb.bowler
GROUP  BY p.player_id, p.player_name
LIMIT 20;
```

```sql
-- 10. Description: Runs conceded by each bowler on the balls they delivered (sample 20 rows).
SELECT DISTINCT
       p.player_id,
       p.player_name,
       SUM(bs.runs_scored) AS runs_conceded,
       COUNT(*)            AS balls_bowled
FROM   ball_by_ball   AS bb
JOIN   batsman_scored AS bs ON  bs.match_id = bb.match_id
                           AND bs.over_id  = bb.over_id
                           AND bs.ball_id  = bb.ball_id
JOIN   player         AS p  ON p.player_id = bb.bowler
GROUP  BY p.player_id, p.player_name
LIMIT 20;
```
