            WHEN tc."TissueCode" = '17621005' THEN 'normal'
            WHEN tc."TissueCode" = '86049000' THEN 'tumor'
       END                                   AS "tissue_type",
       CASE
            WHEN a."collection_id" = 'tcga_luad' THEN 'luad'
            WHEN a."collection_id" = 'tcga_lusc' THEN 'lscc'
       END                                   AS "cancer_subtype"
FROM   IDC.IDC_V17.DICOM_ALL   a
JOIN   IDC.IDC_V17.DICOM_PIVOT p
       ON p."crdc_instance_uuid" = a."UID"
JOIN   LATERAL (
         SELECT f.value:"SpecimenCodeSequence":0:"CodeValue"::STRING AS "TissueCode"
         FROM   LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
       ) tc ON TRUE
WHERE  p."Modality" = 'SM'
  AND  p."ImageType" ILIKE '%VOLUME%'
  AND  a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND  tc."TissueCode" IN ('17621005','86049000')
  AND  EXISTS (
         SELECT 1
         FROM   LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f2
         WHERE  f2.value:"EmbeddingMedium"::STRING ILIKE '%tissue%freezing%medium%'
       )
  AND  LOWER(a."CompressionCode") IN ('jpeg','jpeg2000')
ORDER BY a."UID"
LIMIT 20;
```
