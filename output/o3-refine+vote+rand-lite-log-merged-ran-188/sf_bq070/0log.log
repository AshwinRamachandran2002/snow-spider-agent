```sql
--Description: 10) Assemble a prototype of the final dataset with all filters applied (JPEG/JPEG2000 only).
SELECT  
       t."UID"                               AS "instance_id",
       t."idc_case_id"                       AS "case_id",
       t."PatientID"                         AS "patient_id",
       t."collection_id",
       t."Rows"                              AS "height_px",
       t."Columns"                           AS "width_px",
       t."PixelSpacing",
       t."CompressionCode"                   AS "compression",
       p."gcs_url",
       CASE 
            WHEN tissue_codes."TissueCode" = '17621005' THEN 'normal'
            WHEN tissue_codes."TissueCode" = '86049000' THEN 'tumor'
       END                                    AS "tissue_type",
       CASE 
            WHEN t."collection_id" ILIKE '%luad%' THEN 'luad'
            WHEN t."collection_id" ILIKE '%lusc%' THEN 'lscc'
       END                                    AS "cancer_subtype"
FROM   IDC.IDC_V17.DICOM_ALL t
JOIN   IDC.IDC_V17.DICOM_PIVOT p
       ON t."UID" = p."crdc_instance_uuid"
JOIN   LATERAL (
         SELECT f.value:"SpecimenCodeSequence":0:"CodeValue"::STRING AS "TissueCode"
         FROM   LATERAL FLATTEN(input => t."SpecimenDescriptionSequence") f
       ) tissue_codes
WHERE  (t."collection_id" ILIKE 'tcga%luad%' 
        OR t."collection_id" ILIKE 'tcga%lusc%')
  AND  t."Type" = 'SM'
  AND  t."ImageType" ILIKE '%VOLUME%'
  AND  tissue_codes."TissueCode" IN ('17621005','86049000')
  AND  EXISTS (
         SELECT 1
         FROM   LATERAL FLATTEN(input => t."SpecimenDescriptionSequence") f2
         WHERE  f2.value:"EmbeddingMedium"::STRING ILIKE '%tissue%freezing%medium%'
       )
  AND  LOWER("CompressionCode") IN ('jpeg','jpeg2000')
ORDER BY t."UID"
LIMIT 20;
```
