```sql
--Description: Prototype query to verify whether ANY slide-microscopy (SM) instances exist in the
--TCGA-LUAD or TCGA-LUSC collections and, if so, to display basic image attributes, compression
--type, the GCS URL, and any SNOMED tissue CodeValue stored in the PrimaryAnatomicStructureSequence.
--Approach:
-- 1) Pull instance UUIDs and URLs for LUAD/LUSC from DICOM_PIVOT where Modality = 'SM'.
-- 2) Join to DICOM_ALL for pixel-matrix dimensions, spacing and compression.
-- 3) Use CROSS JOIN LATERAL with OUTER => TRUE to safely flatten SpecimenDescriptionSequence and
--    its nested PrimaryAnatomicStructureSequence—even when either array is absent.
--If the result set is empty, it confirms that no SM data are present for those collections.
SELECT  
       a."UID"                              AS "instance_id",
       a."idc_case_id"                      AS "case_id",
       a."PatientID"                        AS "patient_id",
       a."collection_id",
       a."Rows"                             AS "height_px",
       a."Columns"                          AS "width_px",
       a."PixelSpacing",
       a."CompressionCode"                  AS "compression",
       p."gcs_url",
       pas.value:"CodeValue"::STRING        AS "tissue_code"
FROM  ( SELECT "crdc_instance_uuid", "gcs_url"
        FROM   IDC.IDC_V17.DICOM_PIVOT
        WHERE  "Modality" = 'SM'
          AND  "collection_id" IN ('tcga_luad','tcga_lusc')
      ) p
JOIN   IDC.IDC_V17.DICOM_ALL a
       ON a."UID" = p."crdc_instance_uuid"
CROSS  JOIN LATERAL FLATTEN(input => a."SpecimenDescriptionSequence", OUTER => TRUE) sd
CROSS  JOIN LATERAL FLATTEN(input => sd.value:"PrimaryAnatomicStructureSequence", OUTER => TRUE) pas
ORDER BY a."UID"
LIMIT 20;
```
