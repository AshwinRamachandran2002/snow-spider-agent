```sql
--Description: 10) Prototype dataset for any LUAD/LUSC slide-microscopy (SM) instances, without the
--“VOLUME” restriction that eliminated all rows.  Shows basic image attributes, compression code,
--GCS URL, and any available tissue CodeValue extracted from PrimaryAnatomicStructureSequence.
SELECT  
       a."UID"                     AS "instance_id",
       a."idc_case_id"             AS "case_id",
       a."PatientID"               AS "patient_id",
       a."collection_id",
       a."Rows"                    AS "height_px",
       a."Columns"                 AS "width_px",
       a."PixelSpacing",
       a."CompressionCode"         AS "compression",
       p."gcs_url",
       pas.value:"CodeValue"::STRING AS "tissue_code"
FROM   IDC.IDC_V17.DICOM_PIVOT p
JOIN   IDC.IDC_V17.DICOM_ALL   a
       ON a."UID" = p."crdc_instance_uuid"
LEFT JOIN   LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") s
       ON TRUE
LEFT JOIN   LATERAL FLATTEN(input => s.value:"PrimaryAnatomicStructureSequence") pas
       ON TRUE
WHERE  p."Modality" = 'SM'
  AND  p."collection_id" IN ('tcga_luad','tcga_lusc')
ORDER BY a."UID"
LIMIT 20;
```
