```sql
/*  Structured slide–microscopy (SM) dataset for TCGA-LUAD / TCGA-LUSC
    -------------------------------------------------------------------
    – SM modality, ImageType token ‘VOLUME’
    – only LUAD / LUSC collections
    – JPEG or JPEG-2000 transfer syntaxes                (compression_type ≠ 'other')
    – Embedding medium explicitly “Tissue freezing medium”
    – Tissue codes 17621005 (normal) or 86049000 (tumor)
    – Required output columns, ordered by instance_id
*/
SELECT
       m."SOPInstanceUID"                                      AS "digital_slide_id",
       a."StudyInstanceUID"                                    AS "case_id",
       a."FrameOfReferenceUID"                                 AS "physical_slide_id",
       a."PatientID"                                           AS "patient_id",
       a."collection_id"                                       AS "collection_id",
       p."crdc_instance_uuid"                                  AS "instance_id",
       p."gcs_url"                                             AS "gcs_url",
       a."Columns"                                             AS "width",
       a."Rows"                                                AS "height",
       a."PixelSpacing"                                        AS "pixel_spacing",
       /* classify compression */
       CASE
            WHEN m."TransferSyntaxUID" IN
                 ('1.2.840.10008.1.2.4.50',                    -- JPEG-Baseline
                  '1.2.840.10008.1.2.4.51',                    -- JPEG-Extended
                  '1.2.840.10008.1.2.4.57',                    -- JPEG-Lossless
                  '1.2.840.10008.1.2.4.70')                    -- JPEG-Lossless, SV1
                 THEN 'jpeg'
            WHEN m."TransferSyntaxUID" IN
                 ('1.2.840.10008.1.2.4.90',                    -- JPEG-2000, lossless
                  '1.2.840.10008.1.2.4.91')                    -- JPEG-2000, lossy
                 THEN 'jpeg2000'
            ELSE 'other'
       END                                                    AS "compression_type",
       /* derive tissue label from SNOMED code */
       CASE
            WHEN p."SegmentedPropertyTypeCodeSequence" ILIKE '%17621005%' THEN 'normal'
            WHEN p."SegmentedPropertyTypeCodeSequence" ILIKE '%86049000%' THEN 'tumor'
       END                                                    AS "tissue_type",
       /* derive cancer subtype from collection */
       CASE
            WHEN a."collection_id" = 'tcga_luad' THEN 'luad'
            WHEN a."collection_id" = 'tcga_lusc' THEN 'lscc'
       END                                                    AS "cancer_subtype"
FROM   IDC.IDC_V17.DICOM_PIVOT     p
JOIN   IDC.IDC_V17.DICOM_ALL       a  ON a."UID" = p."crdc_instance_uuid"
JOIN   IDC.IDC_V17.DICOM_METADATA  m  ON m."UID" = p."crdc_instance_uuid"
WHERE  p."Modality" = 'SM'
  AND  p."ImageType" ILIKE '%VOLUME%'
  AND  a."collection_id" IN ('tcga_luad', 'tcga_lusc')
  /* embedding medium requirement */
  AND  a."SpecimenDescriptionSequence" ILIKE '%Tissue freezing medium%'
  /* tissue-type SNOMED codes */
  AND (p."SegmentedPropertyTypeCodeSequence" ILIKE '%17621005%'
       OR p."SegmentedPropertyTypeCodeSequence" ILIKE '%86049000%')
  /* keep only JPEG / JPEG2000 compressed slides */
  AND m."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                '1.2.840.10008.1.2.4.51',
                                '1.2.840.10008.1.2.4.57',
                                '1.2.840.10008.1.2.4.70',
                                '1.2.840.10008.1.2.4.90',
                                '1.2.840.10008.1.2.4.91')
ORDER BY
       p."crdc_instance_uuid" ASC;
```
