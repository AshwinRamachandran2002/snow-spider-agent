    – JPEG or JPEG-2000 compressed
    – Embedding medium = “Tissue freezing medium”
    – Tissue type codes 17621005 (normal) or 86049000 (tumor)
    – Outputs sorted by instance_id                                          */
SELECT DISTINCT
       m."SOPInstanceUID"                                       AS "digital_slide_id",
       a."StudyInstanceUID"                                     AS "case_id",
       a."FrameOfReferenceUID"                                  AS "physical_slide_id",
       p."PatientID"                                            AS "patient_id",
       p."collection_id"                                        AS "collection_id",
       p."crdc_instance_uuid"                                   AS "instance_id",
       p."gcs_url"                                              AS "gcs_url",
       m."Columns"                                              AS "width",
       m."Rows"                                                 AS "height",
       m."PixelSpacing"                                         AS "pixel_spacing",
       /* compression type */
       CASE
            WHEN m."TransferSyntaxUID" IN
                 ('1.2.840.10008.1.2.4.50',                     -- JPEG baseline
                  '1.2.840.10008.1.2.4.51',                     -- JPEG extended
                  '1.2.840.10008.1.2.4.57',                     -- JPEG lossless
                  '1.2.840.10008.1.2.4.70')                     -- JPEG lossless, SV1
                 THEN 'jpeg'
            WHEN m."TransferSyntaxUID" IN
                 ('1.2.840.10008.1.2.4.90',                     -- JPEG-2000 lossless
                  '1.2.840.10008.1.2.4.91')                     -- JPEG-2000 lossy
                 THEN 'jpeg2000'
            ELSE 'other'
       END                                                     AS "compression_type",
       /* labels */
       CASE
            WHEN p."SegmentedPropertyTypeCodeSequence" ILIKE '%17621005%' THEN 'normal'
            WHEN p."SegmentedPropertyTypeCodeSequence" ILIKE '%86049000%' THEN 'tumor'
       END                                                     AS "tissue_type",
