            '1.2.840.10008.1.2.4.90',
            '1.2.840.10008.1.2.4.91'
        )
),
specimen_ok AS (
    SELECT
        s.*,
        f.value::VARIANT AS specimen_json
    FROM sm_images s,
         LATERAL FLATTEN(input => s."SpecimenDescriptionSequence") f
    WHERE f.value::STRING ILIKE '%Tissue%freezing%medium%'
      AND ( f.value::STRING ILIKE '%17621005%'    -- normal tissue code
         OR f.value::STRING ILIKE '%86049000%' )  -- tumor tissue code
)
SELECT
    digital_slide_id                                    AS "digital_slide_id",
    case_id                                             AS "case_id",
    specimen_json:"SpecimenIdentifier"::STRING          AS "physical_slide_id",
    patient_id                                          AS "patient_id",
