```sql
/*  TCGA-LUAD / TCGA-LUSC whole-slide microscopy (SM, VOLUME) images
    – JPEG or JPEG2000 compressed
    – “Tissue freezing medium” embedding
    – tissue_type ∈ {normal,tumor}
*/
WITH
-- 1) WSI instances whose transfer-syntax indicates JPEG/JPEG2000 compression
wsi_md AS (
    SELECT *
    FROM "IDC"."IDC_V17"."DICOM_METADATA"
    WHERE "SOPClassUID" = '1.2.840.10008.5.1.4.1.1.77.1.6'          -- VL Whole-Slide Microscopy Image
      AND "TransferSyntaxUID" IN (                                  -- JPEG or JPEG2000
            '1.2.840.10008.1.2.4.50','1.2.840.10008.1.2.4.51',
            '1.2.840.10008.1.2.4.57','1.2.840.10008.1.2.4.70',
            '1.2.840.10008.1.2.4.80','1.2.840.10008.1.2.4.81',
            '1.2.840.10008.1.2.4.90','1.2.840.10008.1.2.4.91'
        )
),
-- 2) TCGA LUAD / LUSC rows that are SM VOLUME images
tcga_da AS (
    SELECT *
    FROM "IDC"."IDC_V17"."DICOM_ALL"
    WHERE "collection_id" IN ('tcga_luad','tcga_lusc')
      AND "ImageType" ILIKE '%VOLUME%'            -- digital slide, not LABEL/OVERVIEW
),
-- 3) merge metadata & ALL using any matching UID variant
merged AS (
    SELECT
        md."UID"                       AS instance_id,
        md."TransferSyntaxUID",
        md."Rows"                      AS height_px,
        md."Columns"                   AS width_px,
        md."PixelSpacing",
        da."PatientID",
        da."collection_id",
        da."idc_case_id"               AS case_id,
        da."SpecimenDescriptionSequence",
        md."UID"                       AS digital_slide_id
    FROM wsi_md md
    JOIN tcga_da da
      ON  da."UID" = md."UID"
       OR da."UID" = md."SOPInstanceUID"
       OR da."UID" = md."MediaStorageSOPInstanceUID"
),
-- 4) retain only slides prepared with tissue-freezing medium and with normal/tumor codes
specimen_filtered AS (
    SELECT
        m.*,
        f.value::VARIANT AS specimen_json
    FROM merged m,
         LATERAL FLATTEN(input => m."SpecimenDescriptionSequence") f
    WHERE f.value::STRING ILIKE '%Tissue%freezing%medium%'
      AND ( f.value::STRING ILIKE '%17621005%'      -- normal
         OR f.value::STRING ILIKE '%86049000%' )    -- tumor
)
SELECT
    digital_slide_id                                    AS "digital_slide_id",
    case_id                                             AS "case_id",
    specimen_json:"SpecimenIdentifier"::STRING          AS "physical_slide_id",
    PatientID                                           AS "patient_id",
    collection_id                                       AS "collection_id",
    instance_id                                         AS "instance_id",
    NULL                                                AS "gcs_url",          -- gcs_url not directly linkable from available tables
    width_px                                            AS "width_px",
    height_px                                           AS "height_px",
    PixelSpacing                                        AS "pixel_spacing",
    CASE
        WHEN TransferSyntaxUID IN ('1.2.840.10008.1.2.4.90',
                                   '1.2.840.10008.1.2.4.91')
             THEN 'jpeg2000'
        ELSE 'jpeg'
    END                                                 AS "compression_type",
    CASE
        WHEN specimen_json::STRING ILIKE '%17621005%' THEN 'normal'
        ELSE                                            'tumor'
    END                                                 AS "tissue_type",
    CASE
        WHEN collection_id = 'tcga_luad' THEN 'luad'
        ELSE                               'lscc'
    END                                                 AS "cancer_subtype"
FROM specimen_filtered
ORDER BY "instance_id" ASC;
```
