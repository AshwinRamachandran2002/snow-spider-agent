```sql
/*  Digital slide microscopy images (SM, VOLUME) from TCGA-LUAD / TCGA-LUSC
    – JPEG / JPEG2000 compressed only
    – “Tissue freezing medium” embedding
    – tissue_type ∈ {normal,tumor}
*/
WITH sm_images AS (
    SELECT
        md."UID"                                   AS digital_slide_id,        -- SOP Instance UID (numeric dotted string)
        da."idc_case_id"                           AS case_id,
        md."PatientID",
        da."collection_id",
        md."UID"                                   AS instance_id,             -- same dotted UID (acts as instance identifier)
        pv."crdc_instance_uuid"                    AS instance_uuid,           -- IDC-assigned UUID
        pv."gcs_url",
        md."Columns"                               AS width_px,
        md."Rows"                                  AS height_px,
        md."PixelSpacing",
        md."TransferSyntaxUID",
        da."SpecimenDescriptionSequence"
    FROM  "IDC"."IDC_V17"."DICOM_METADATA" md
    JOIN  "IDC"."IDC_V17"."DICOM_ALL"      da  ON md."UID" = da."UID"
    LEFT JOIN "IDC"."IDC_V17"."DICOM_PIVOT" pv ON md."UID" = pv."crdc_instance_uuid"
    WHERE da."collection_id"         IN ('tcga_luad','tcga_lusc')
      AND md."SOPClassUID"           =  '1.2.840.10008.5.1.4.1.1.77.1.6'          -- VL Whole-Slide Microscopy Image
      AND da."ImageType"             ILIKE '%VOLUME%'                              -- digital slide images
      AND md."TransferSyntaxUID"     IN (                                          -- JPEG / JPEG2000 only
              '1.2.840.10008.1.2.4.50',  -- JPEG Baseline
              '1.2.840.10008.1.2.4.51',  -- JPEG Extended
              '1.2.840.10008.1.2.4.57',  -- JPEG Lossless (Diff Huffman)
              '1.2.840.10008.1.2.4.70',  -- JPEG Lossless
              '1.2.840.10008.1.2.4.80',  -- JPEG-LS Lossless
              '1.2.840.10008.1.2.4.81',  -- JPEG-LS Near-Lossless
              '1.2.840.10008.1.2.4.90',  -- JPEG2000 Lossless
              '1.2.840.10008.1.2.4.91'   -- JPEG2000
          )
),
specimen_ok AS (                               -- keep only specimens fulfilling bio-criteria
    SELECT
        s.*,
        f.value::VARIANT   AS specimen_json
    FROM sm_images  s,
         LATERAL FLATTEN(input => s."SpecimenDescriptionSequence") f
    WHERE f.value::STRING ILIKE '%Tissue%freezing%medium%'          -- embedding medium
      AND (   f.value::STRING ILIKE '%17621005%'     -- normal
           OR f.value::STRING ILIKE '%86049000%')    -- tumor
)
SELECT
    digital_slide_id                                    AS "digital_slide_id",
    case_id                                             AS "case_id",
    specimen_json:"SpecimenIdentifier"::STRING          AS "physical_slide_id",
    PatientID                                           AS "patient_id",
    collection_id                                       AS "collection_id",
    COALESCE(instance_uuid, instance_id)                AS "instance_id",
    gcs_url                                             AS "gcs_url",
    width_px                                            AS "width_px",
    height_px                                           AS "height_px",
    PixelSpacing                                        AS "pixel_spacing",
    CASE
        WHEN TransferSyntaxUID IN ('1.2.840.10008.1.2.4.90','1.2.840.10008.1.2.4.91')
            THEN 'jpeg2000' ELSE 'jpeg' END            AS "compression_type",
    CASE
        WHEN specimen_json::STRING ILIKE '%17621005%' THEN 'normal'
        WHEN specimen_json::STRING ILIKE '%86049000%' THEN 'tumor'
    END                                                AS "tissue_type",
    CASE
        WHEN collection_id = 'tcga_luad'  THEN 'luad'
        WHEN collection_id = 'tcga_lusc'  THEN 'lscc'
    END                                                AS "cancer_subtype"
FROM specimen_ok
ORDER BY "instance_id" ASC;
```
