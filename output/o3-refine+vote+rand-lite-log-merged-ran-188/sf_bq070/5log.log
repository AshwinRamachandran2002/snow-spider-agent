```sql
--Description: 1) Inspect the distinct values of the “Type” attribute for LUAD/LUSC slides
SELECT DISTINCT "Type"
FROM "IDC"."IDC_V17"."DICOM_ALL"
WHERE "collection_id" IN ('tcga_luad','tcga_lusc')
LIMIT 20;
```

```sql
--Description: 2) Preview SM-modality (slide-microscopy) rows in LUAD/LUSC collections
SELECT *
FROM "IDC"."IDC_V17"."DICOM_ALL"
WHERE "collection_id" IN ('tcga_luad','tcga_lusc')
  AND "Type" ILIKE '%SM%'
LIMIT 20;
```

```sql
--Description: 3) Check the compression codes that appear for SM slides
SELECT DISTINCT "CompressionCode"
FROM "IDC"."IDC_V17"."DICOM_ALL"
WHERE "collection_id" IN ('tcga_luad','tcga_lusc')
  AND "Type" ILIKE '%SM%'
LIMIT 20;
```

```sql
--Description: 4) Look up transfer-syntax UIDs for the same SM slides (helps map to JPEG/JPEG2000)
SELECT DISTINCT m."TransferSyntaxUID"
FROM "IDC"."IDC_V17"."DICOM_ALL"  a
JOIN "IDC"."IDC_V17"."DICOM_METADATA" m
          ON a."UID" = m."SOPInstanceUID"
WHERE a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND a."Type" ILIKE '%SM%'
LIMIT 20;
```

```sql
--Description: 5) Verify that the SM slides’ ImageType list really contains “VOLUME”
SELECT DISTINCT a."ImageType"
FROM "IDC"."IDC_V17"."DICOM_ALL" a
WHERE a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND a."Type" ILIKE '%SM%'
  AND a."ImageType" ILIKE '%VOLUME%'
LIMIT 20;
```

```sql
--Description: 6) Quickly view dimensional / spacing info for a few SM-VOLUME slides
SELECT a."UID"  AS "instance_id",
       a."Rows" AS "height",
       a."Columns" AS "width",
       a."PixelSpacing"
FROM "IDC"."IDC_V17"."DICOM_ALL" a
WHERE a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND a."Type" ILIKE '%SM%'
  AND a."ImageType" ILIKE '%VOLUME%'
LIMIT 20;
```

```sql
--Description: 7) Inspect the raw SpecimenDescriptionSequence JSON for candidate slides
SELECT a."UID",
       f.value
FROM "IDC"."IDC_V17"."DICOM_ALL" a,
     LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
WHERE a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND a."Type" ILIKE '%SM%'
LIMIT 20;
```

```sql
--Description: 8) Detect any content mentioning “Tissue freezing medium” in the specimen data
SELECT a."UID",
       f.value
FROM "IDC"."IDC_V17"."DICOM_ALL" a,
     LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
WHERE a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND a."Type" ILIKE '%SM%'
  AND f.value::STRING ILIKE '%Tissue%freezing%medium%'
LIMIT 20;
```

```sql
--Description: 9) Search the specimen JSON for normal (17621005) or tumor (86049000) codes
SELECT a."UID",
       f.value
FROM "IDC"."IDC_V17"."DICOM_ALL" a,
     LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
WHERE a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND a."Type" ILIKE '%SM%'
  AND (f.value::STRING ILIKE '%17621005%' OR f.value::STRING ILIKE '%86049000%')
LIMIT 20;
```

```sql
--Description: 10) Pull a consolidated subset of SM-VOLUME slides already filtered for JPEG/JPEG2000
SELECT a."UID"            AS "instance_id",
       a."PatientID"      AS "patient_id",
       a."collection_id",
       a."Rows"           AS "height",
       a."Columns"        AS "width",
       a."PixelSpacing",
       a."CompressionCode",
       a."ImageType"
FROM   "IDC"."IDC_V17"."DICOM_ALL" a
WHERE  a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND  a."Type"          ILIKE '%SM%'
  AND  a."ImageType"     ILIKE '%VOLUME%'
  AND  a."CompressionCode" IN ('JPEG','JPEG2000')
LIMIT 20;
```
