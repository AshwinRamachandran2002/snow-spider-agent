    WHERE da."collection_id" IN ('tcga_luad','tcga_lusc')
      AND md."SOPClassUID"  = '1.2.840.10008.5.1.4.1.1.77.1.6'          -- VL WSI
      AND da."ImageType"    ILIKE '%VOLUME%'                           -- digital (not overview/label)
