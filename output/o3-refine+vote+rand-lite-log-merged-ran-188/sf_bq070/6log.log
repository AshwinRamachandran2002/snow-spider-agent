```sql
--Description: 7)  Confirm presence of normal (17621005) or tumor (86049000) SNOMED codes in
--             SegmentedPropertyTypeCodeSequence for LUAD / LUSC SM images.
SELECT
       "PatientID",
       "crdc_instance_uuid",
       "SegmentedPropertyTypeCodeSequence"
