```sql
/*  Slide-microscopy (SM) “VOLUME” instances from TCGA-LUAD / TCGA-LUSC
    – JPEG or JPEG-2000 compressed
    – embedding medium = Tissue freezing medium
    – tissue type normal (17621005) or tumor (86049000)
*/
WITH compression_map AS (          -- map every instance to a compression label
    SELECT
        "SOPInstanceUID",
        CASE
            /* JPEG (baseline & lossless) */
            WHEN "TransferSyntaxUID" IN (
                   '1.2.840.10008.1.2.4.50',
                   '1.2.840.10008.1.2.4.51',
                   '1.2.840.10008.1.2.4.57',
                   '1.2.840.10008.1.2.4.70'
                 ) THEN 'jpeg'
            /* JPEG-2000 */
            WHEN "TransferSyntaxUID" IN (
                   '1.2.840.10008.1.2.4.90',
                   '1.2.840.10008.1.2.4.91'
                 ) THEN 'jpeg2000'
            ELSE 'other'
        END AS compression_type
    FROM IDC.IDC_V17.DICOM_METADATA
), tissue_freezing AS (            -- keep only instances whose specimen description mentions tissue-freezing medium
    SELECT DISTINCT
        "UID"   AS instance_uid
    FROM IDC.IDC_V17.DICOM_ALL,
         LATERAL FLATTEN(INPUT => "SpecimenDescriptionSequence") sd
    WHERE LOWER(sd.value::string) LIKE '%tissue freezing medium%'
)
