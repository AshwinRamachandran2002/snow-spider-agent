```sql
--Description: 8)  List TransferSyntaxUIDs (compression types) for LUAD / LUSC SM images by joining
--             DICOM_PIVOT to DICOM_METADATA.
SELECT
       p."crdc_instance_uuid"                        AS "instance_uid",
       m."TransferSyntaxUID"
FROM   IDC.IDC_V17.DICOM_PIVOT   p
JOIN   IDC.IDC_V17.DICOM_METADATA m
       ON p."crdc_instance_uuid" = m."SOPInstanceUID"
WHERE  p."Modality"      = 'SM'
  AND  p."collection_id" IN ('tcga_luad', 'tcga_lusc')
  AND  m."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',  -- JPEG
                                 '1.2.840.10008.1.2.4.51',
                                 '1.2.840.10008.1.2.4.70',
                                 '1.2.840.10008.1.2.4.57',
                                 '1.2.840.10008.1.2.4.90',  -- JPEG2000
                                 '1.2.840.10008.1.2.4.91')
LIMIT 20;
```

```sql
--Description: 9)  Retrieve image dimensions and pixel spacing for candidate LUAD / LUSC SM images
--             together with their compression UID.
SELECT
       p."crdc_instance_uuid"                        AS "instance_uid",
       p."Rows"                                      AS "height",
       p."Columns"                                   AS "width",
       p."PixelSpacing",
       m."TransferSyntaxUID"
FROM   IDC.IDC_V17.DICOM_PIVOT   p
JOIN   IDC.IDC_V17.DICOM_METADATA m
       ON p."crdc_instance_uuid" = m."SOPInstanceUID"
WHERE  p."Modality"      = 'SM'
  AND  p."collection_id" IN ('tcga_luad', 'tcga_lusc')
LIMIT 20;
```

```sql
--Description: 10)  Consolidated query applying all study requirements: SM modality, LUAD/LUSC
--             collections, ImageType includes VOLUME, allowed JPEG/JPEG2000 syntaxes, tissue-type
--             codes normal/tumor, and evidence of “Tissue freezing medium” in any flattened
--             SpecimenDescriptionSequence element.
SELECT
       p."crdc_instance_uuid"                                    AS "instance_id",
       p."collection_id",
       p."PatientID"                                             AS "patient_id",
       m."UID"                                                   AS "digital_slide_id",
       p."Rows"                                                  AS "height",
       p."Columns"                                               AS "width",
       p."PixelSpacing",
       CASE 
            WHEN m."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                           '1.2.840.10008.1.2.4.51',
                                           '1.2.840.10008.1.2.4.70',
                                           '1.2.840.10008.1.2.4.57') THEN 'jpeg'
            WHEN m."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.90',
                                           '1.2.840.10008.1.2.4.91') THEN 'jpeg2000'
            ELSE 'other'
       END                                                        AS "compression_type",
       CASE 
            WHEN p."SegmentedPropertyTypeCodeSequence" ILIKE '%17621005%' THEN 'normal'
            WHEN p."SegmentedPropertyTypeCodeSequence" ILIKE '%86049000%' THEN 'tumor'
       END                                                        AS "tissue_type",
       CASE
            WHEN p."collection_id" = 'tcga_luad'  THEN 'luad'
            WHEN p."collection_id" = 'tcga_lusc' THEN 'lscc'
       END                                                        AS "cancer_subtype"
FROM   IDC.IDC_V17.DICOM_PIVOT    p
JOIN   IDC.IDC_V17.DICOM_METADATA m
       ON p."crdc_instance_uuid" = m."SOPInstanceUID"
JOIN   IDC.IDC_V17.DICOM_ALL      a
       ON a."UID" = p."crdc_instance_uuid"
WHERE  p."Modality"      = 'SM'
  AND  p."collection_id" IN ('tcga_luad', 'tcga_lusc')
  AND  p."ImageType" ILIKE '%VOLUME%'
  AND  ( p."SegmentedPropertyTypeCodeSequence" ILIKE '%17621005%'
      OR p."SegmentedPropertyTypeCodeSequence" ILIKE '%86049000%' )
  AND  EXISTS (
        SELECT 1
        FROM   LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
        WHERE  f.value::STRING ILIKE '%Tissue%freezing%medium%'
       )
  AND  m."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                 '1.2.840.10008.1.2.4.51',
                                 '1.2.840.10008.1.2.4.70',
                                 '1.2.840.10008.1.2.4.57',
                                 '1.2.840.10008.1.2.4.90',
                                 '1.2.840.10008.1.2.4.91')
ORDER BY "instance_id" ASC
LIMIT 20;
```
