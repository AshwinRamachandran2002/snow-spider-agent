```sql
--Description: 5)  Flatten one level of “SpecimenDescriptionSequence” for Slide-Microscopy (SM) images
--             from TCGA-LUAD or TCGA-LUSC.  Join DICOM_PIVOT (for modality/collection) with DICOM_ALL
--             (which holds the JSON), then LATERAL FLATTEN the sequence.
SELECT
       p."crdc_instance_uuid"                        AS "instance_uid",
       f.value                                       AS "specimen_item"
FROM   IDC.IDC_V17.DICOM_PIVOT  p
JOIN   IDC.IDC_V17.DICOM_ALL    a
       ON a."UID" = p."crdc_instance_uuid",
       LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
WHERE  p."Modality"      = 'SM'
  AND  p."collection_id" IN ('tcga_luad', 'tcga_lusc')
LIMIT 20;
```

```sql
--Description: 6)  For the same LUAD/LUSC SM images, try to pull an “Embedding medium” field from each
--             element in SpecimenDescriptionSequence.  The exact JSON key may vary, so we use a
--             wildcard (%).  This shows any values that resemble “Tissue freezing medium”.
SELECT
       p."crdc_instance_uuid"                        AS "instance_uid",
       f.value:"Embedding%medium"::STRING            AS "embedding_medium"
FROM   IDC.IDC_V17.DICOM_PIVOT  p
JOIN   IDC.IDC_V17.DICOM_ALL    a
       ON a."UID" = p."crdc_instance_uuid",
       LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
WHERE  p."Modality"      = 'SM'
  AND  p."collection_id" IN ('tcga_luad', 'tcga_lusc')
LIMIT 20;
```

```sql
--Description: 7)  Verify that the tissue-type codes (normal = 17621005, tumor = 86049000) appear in
--             SegmentedPropertyTypeCodeSequence for LUAD/LUSC SM images.  Parentheses ensure correct
--             precedence for the OR condition.
SELECT
       "PatientID",
       "crdc_instance_uuid",
       "SegmentedPropertyTypeCodeSequence"
FROM   IDC.IDC_V17.DICOM_PIVOT
WHERE  "Modality"      = 'SM'
  AND  "collection_id" IN ('tcga_luad', 'tcga_lusc')
  AND  ( "SegmentedPropertyTypeCodeSequence" ILIKE '%17621005%'   -- normal
      OR "SegmentedPropertyTypeCodeSequence" ILIKE '%86049000%' ) -- tumor
LIMIT 20;
```

```sql
--Description: 8)  Check the JPEG/JPEG2000 TransferSyntaxUID values for LUAD/LUSC SM images by joining
--             DICOM_PIVOT with DICOM_METADATA.
SELECT
       p."crdc_instance_uuid"                        AS "instance_uid",
       m."TransferSyntaxUID"
FROM   IDC.IDC_V17.DICOM_PIVOT   p
JOIN   IDC.IDC_V17.DICOM_METADATA m
       ON p."crdc_instance_uuid" = m."SOPInstanceUID"
WHERE  p."Modality"      = 'SM'
  AND  p."collection_id" IN ('tcga_luad', 'tcga_lusc')
  AND  m."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',  -- JPEG baseline
                                 '1.2.840.10008.1.2.4.51',  -- JPEG extended
                                 '1.2.840.10008.1.2.4.70',  -- JPEG lossless
                                 '1.2.840.10008.1.2.4.57',  -- JPEG lossless (non-hierarchical)
                                 '1.2.840.10008.1.2.4.90',  -- JPEG2000 lossless
                                 '1.2.840.10008.1.2.4.91')  -- JPEG2000
LIMIT 20;
```

```sql
--Description: 9)  Collect width, height and pixel spacing for candidate LUAD/LUSC SM images together
--             with their TransferSyntaxUID (compression).
SELECT
       p."crdc_instance_uuid"                        AS "instance_uid",
       p."Rows"                                      AS "height",
       p."Columns"                                   AS "width",
       p."PixelSpacing",
       m."TransferSyntaxUID"
FROM   IDC.IDC_V17.DICOM_PIVOT   p
JOIN   IDC.IDC_V17.DICOM_METADATA m
       ON p."crdc_instance_uuid" = m."SOPInstanceUID"
WHERE  p."Modality"      = 'SM'
  AND  p."collection_id" IN ('tcga_luad', 'tcga_lusc')
LIMIT 20;
```

```sql
--Description: 10)  Consolidated sample (20 rows) that applies all required filters: modality = SM,
--             LUAD/LUSC collections, ImageType contains VOLUME, acceptable JPEG/JPEG2000 transfer
--             syntaxes, tissue-type codes normal/tumor, and “Tissue freezing medium” embedded in the
--             SpecimenDescriptionSequence.  Produces metadata and derived labels.
SELECT
       p."crdc_instance_uuid"                                    AS "instance_id",
       p."collection_id",
       p."PatientID"                                             AS "patient_id",
       m."UID"                                                   AS "digital_slide_id",
       p."Rows"                                                  AS "height",
       p."Columns"                                               AS "width",
       p."PixelSpacing",
       CASE 
            WHEN m."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                           '1.2.840.10008.1.2.4.51',
                                           '1.2.840.10008.1.2.4.70',
                                           '1.2.840.10008.1.2.4.57') THEN 'jpeg'
            WHEN m."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.90',
                                           '1.2.840.10008.1.2.4.91') THEN 'jpeg2000'
            ELSE 'other'
       END                                                        AS "compression_type",
       CASE 
            WHEN p."SegmentedPropertyTypeCodeSequence" ILIKE '%17621005%' THEN 'normal'
            WHEN p."SegmentedPropertyTypeCodeSequence" ILIKE '%86049000%' THEN 'tumor'
       END                                                        AS "tissue_type",
       CASE
            WHEN p."collection_id" = 'tcga_luad'  THEN 'luad'
            WHEN p."collection_id" = 'tcga_lusc' THEN 'lscc'
       END                                                        AS "cancer_subtype"
FROM   IDC.IDC_V17.DICOM_PIVOT    p
JOIN   IDC.IDC_V17.DICOM_METADATA m
       ON p."crdc_instance_uuid" = m."SOPInstanceUID"
JOIN   IDC.IDC_V17.DICOM_ALL      a
       ON a."UID" = p."crdc_instance_uuid"
WHERE  p."Modality"      = 'SM'
  AND  p."collection_id" IN ('tcga_luad', 'tcga_lusc')
  AND  p."ImageType" ILIKE '%VOLUME%'
  AND  ( p."SegmentedPropertyTypeCodeSequence" ILIKE '%17621005%'  -- normal
      OR p."SegmentedPropertyTypeCodeSequence" ILIKE '%86049000%' )-- tumor
  AND  EXISTS (  -- confirm “Tissue freezing medium” appears in any JSON element
        SELECT 1
        FROM   LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
        WHERE  f.value:"Embedding%medium"::STRING ILIKE '%Tissue%freezing%medium%'
       )
  AND  m."TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                 '1.2.840.10008.1.2.4.51',
                                 '1.2.840.10008.1.2.4.70',
                                 '1.2.840.10008.1.2.4.57',
                                 '1.2.840.10008.1.2.4.90',
                                 '1.2.840.10008.1.2.4.91')
ORDER BY "instance_id" ASC
LIMIT 20;
```
