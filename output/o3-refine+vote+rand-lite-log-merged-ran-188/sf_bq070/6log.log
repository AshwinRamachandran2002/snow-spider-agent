2025-05-05 04:16:04 - Thread-2663 (execute) - INFO - [Try to run SQL in self-refine]
```sql
/*  Slide-microscopy instances (SM) coming from TCGA-LUAD or TCGA-LUSC
    – JPEG/JPEG2000 only
    – ImageType contains VOLUME
    – embedding medium = “Tissue freezing medium”
    – tissue type code 17621005 (normal) or 86049000 (tumor)
*/
WITH compression_map AS (      -- classify compression once
  SELECT
      "SOPInstanceUID",
      CASE
        WHEN "TransferSyntaxUID" IN
             ('1.2.840.10008.1.2.4.50',  -- JPEG baseline
              '1.2.840.10008.1.2.4.51',
              '1.2.840.10008.1.2.4.57',
              '1.2.840.10008.1.2.4.70')          THEN 'jpeg'
        WHEN "TransferSyntaxUID" IN
             ('1.2.840.10008.1.2.4.90',  -- JPEG-2000
              '1.2.840.10008.1.2.4.91')         THEN 'jpeg2000'
        ELSE                                        'other'
      END AS compression_type
  FROM IDC.IDC_V17.DICOM_METADATA
)
SELECT
    A."UID"                       AS digital_slide_id,
    A."StudyInstanceUID"          AS case_id,
    A."SeriesInstanceUID"         AS physical_slide_id,
    A."PatientID"                 AS patient_id,
    A."collection_id"             AS collection_id,
    P."crdc_instance_uuid"        AS instance_id,
    P."gcs_url"                   AS gcs_url,
    A."Columns"                   AS width,
    A."Rows"                      AS height,
    A."PixelSpacing"              AS pixel_spacing,
    C.compression_type            AS compression_type,
    CASE
        WHEN P."SegmentedPropertyTypeCodeSequence" ILIKE '%17621005%' THEN 'normal'
        WHEN P."SegmentedPropertyTypeCodeSequence" ILIKE '%86049000%' THEN 'tumor'
    END                          AS tissue_type,
    CASE
        WHEN A."collection_id" = 'tcga_luad'  THEN 'luad'
        WHEN A."collection_id" = 'tcga_lusc'  THEN 'lscc'
    END                          AS cancer_subtype
FROM  IDC.IDC_V17.DICOM_ALL        A
JOIN  IDC.IDC_V17.DICOM_PIVOT      P
      ON  A."SeriesInstanceUID" = P."SeriesInstanceUID"
      AND A."PatientID"        = P."PatientID"
      AND A."collection_id"    = P."collection_id"
JOIN  compression_map              C
      ON  A."UID" = C."SOPInstanceUID"
WHERE A."collection_id" IN ('tcga_luad','tcga_lusc')
  AND P."Modality"            = 'SM'
  AND A."ImageType"           ILIKE '%VOLUME%'
  AND C.compression_type     IN ('jpeg','jpeg2000')          -- exclude “other”
  AND (  P."SegmentedPropertyTypeCodeSequence" ILIKE '%17621005%'
      OR P."SegmentedPropertyTypeCodeSequence" ILIKE '%86049000%' )
  AND LOWER(TO_VARCHAR(A."SpecimenDescriptionSequence"))
          LIKE '%tissue freezing medium%'
ORDER BY instance_id ASC;
```
