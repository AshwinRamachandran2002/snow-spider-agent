```sql
--Description: Determine whether any Slide-Microscopy (SM) instances record an “EmbeddingMedium”
--             that includes the word fragment “freez” (to catch “freezing”, “frozen”, etc.).
--             1)  Use DICOM_PIVOT to restrict to SM modality and supply the instance UID
--                 (“crdc_instance_uuid”) plus collection context (helpful for inspection later).
--             2)  Join to DICOM_ALL to access the SpecimenDescriptionSequence JSON stored per instance.
--             3)  FLATTEN the SpecimenDescriptionSequence array so each element is evaluated
--                 individually (alias f).  
--             4)  Keep only elements where the JSON key "EmbeddingMedium" exists AND its value
--                 ILIKE '%freez%'.  
--             5)  Return the collection_id, instance UID, and the embedding_medium text for up to
--                 20 rows so we can confirm that such records exist before re-introducing LUAD/LUSC
--                 collection filters or more specific matching.
SELECT
       p."collection_id",
       p."crdc_instance_uuid"                       AS "instance_uid",
       f.value:"EmbeddingMedium"::STRING            AS "embedding_medium"
FROM   IDC.IDC_V17.DICOM_PIVOT p
JOIN   IDC.IDC_V17.DICOM_ALL   a
       ON a."UID" = p."crdc_instance_uuid",
       LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
WHERE  p."Modality" = 'SM'
  AND  f.value:"EmbeddingMedium" IS NOT NULL
  AND  f.value:"EmbeddingMedium"::STRING ILIKE '%freez%'
LIMIT 20;
```
