--Description: 9)  Combine (a) Utah ZIP Code(s) with the statewide minimum branch count  
--              and (b) that count itself.  The requested ACS employment data are not  
--              available within the permitted datasets, so the employment_rate_2017  
--              column is returned as NULL.  
WITH bank_cnt AS (
  SELECT z.zip_code, COUNT(l.branch_fdic_uninum) AS cnt_bank_locations
  FROM `bigquery-public-data.geo_us_boundaries.zip_codes` z
  LEFT JOIN `bigquery-public-data.fdic_banks.locations`   l
         ON z.zip_code = l.zip_code
  WHERE z.state_code = 'UT'
  GROUP BY z.zip_code
),
min_zip AS (
  SELECT zip_code
  FROM bank_cnt
  WHERE cnt_bank_locations = (SELECT MIN(cnt_bank_locations) FROM bank_cnt)
)
SELECT
  m.zip_code,
  b.cnt_bank_locations,
  NULL AS employment_rate_2017             -- not available in allowed data
FROM min_zip  m
JOIN bank_cnt b USING (zip_code)
