--Description: 7)  Geometry & metadata for Utah ZIP Code(s) that have the fewest (zero)  
--              FDIC-insured bank locations, using only allowed datasets.  
WITH bank_cnt AS (                         -- count branches per ZIP
  SELECT
    z.zip_code,
    COUNT(l.branch_fdic_uninum) AS cnt_bank_locations
  FROM `bigquery-public-data.geo_us_boundaries.zip_codes` z
  LEFT JOIN `bigquery-public-data.fdic_banks.locations`   l
         ON z.zip_code = l.zip_code
  WHERE z.state_code = 'UT'
  GROUP BY z.zip_code
),
min_zip AS (                               -- ZIP(s) whose count = statewide minimum
  SELECT zip_code
  FROM bank_cnt
  WHERE cnt_bank_locations = (SELECT MIN(cnt_bank_locations) FROM bank_cnt)
)
SELECT                                     -- geometry / basic attributes
  z.zip_code,
  z.city,
  z.county,
  z.area_land_meters,
  z.area_water_meters,
  z.internal_point_lat,
  z.internal_point_lon
FROM `bigquery-public-data.geo_us_boundaries.zip_codes` z
JOIN min_zip USING (zip_code)
LIMIT 20
