-- Utah ZIP code with the fewest FDIC-insured bank branches
-- and its 2017 ACS employment rate (population 16 +)

WITH bank_counts AS (      -- count FDIC branches by ZIP
  SELECT
    z.zip_code,
    COUNT(l.branch_fdic_uninum) AS branch_cnt
  FROM `bigquery-public-data.geo_us_boundaries.zip_codes` z
  LEFT JOIN `bigquery-public-data.fdic_banks.locations` l
         ON z.zip_code = l.zip_code
  WHERE z.state_code = 'UT'
  GROUP BY z.zip_code
),

min_zip AS (               -- ZIP that has the minimum branch count
  SELECT zip_code
  FROM bank_counts
  ORDER BY branch_cnt ASC, zip_code      -- tie-break alphabetically
  LIMIT 1
),

acs_2017_zcta AS (         -- 2017 ACS employment data at ZCTA level
  SELECT
    SUBSTR(geography_id, 11, 5)                     AS zip_code,      -- extract 5-digit ZIP
    MAX(IF(column_id = '001E', estimate, NULL))     AS pop_16_plus,   -- total pop 16+
    MAX(IF(column_id = '004E', estimate, NULL))     AS employed       -- employed pop
  FROM `bigquery-public-data.census_bureau_acs.acs_2017_5yr`
  WHERE table_id = 'B23025'                         -- Employment Status
    AND geography_id LIKE '8600000US%'              -- ZCTA geographies
  GROUP BY zip_code
)

SELECT
  m.zip_code,
  ROUND( (CAST(a.employed AS FLOAT64) /
          NULLIF(CAST(a.pop_16_plus AS FLOAT64),0)) * 100 , 2)
        AS employment_rate_2017
FROM min_zip         AS m
JOIN acs_2017_zcta   AS a
  USING (zip_code);
```
