```sql
--Description:  One‐statement solution that (1) counts FDIC-insured bank locations in every Utah
--              ZIP, (2) keeps the ZIP(s) whose count equals the statewide minimum (zero),
--              (3) pulls 2017 ACS 5-year data for each ZIP – total population age 16+
--              (variable B23025_001E) and employed age 16+ (variable B23025_005E),
--              and (4) returns the employment-to-population (16+) rate for that ZIP.
--
--              Logic
--              ▸ bank_cnt  – FDIC branch count per Utah ZIP.
--              ▸ min_zip   – ZIP(s) whose count = MIN(count).
--              ▸ acs_zip   – 2017 ACS values per ZIP Code Tabulation Area (ZCTA);
--                             RIGHT(geoid,5) converts GEOID to 5-digit ZIP.
--              ▸ Final SELECT joins min_zip ↔ acs_zip and computes
--                employment_rate_2017 = employed16_plus / pop16_plus.
WITH bank_cnt AS (                           -- FDIC branches per ZIP
  SELECT
    z.zip_code,
    COUNT(l.branch_fdic_uninum) AS cnt_bank_locations
  FROM `bigquery-public-data.geo_us_boundaries.zip_codes`  AS z
  LEFT JOIN `bigquery-public-data.fdic_banks.locations`    AS l
         ON z.zip_code = l.zip_code
  WHERE z.state_code = 'UT'
  GROUP BY z.zip_code
),
min_zip AS (                                 -- ZIPs with the fewest banks (zero)
  SELECT zip_code
  FROM bank_cnt
  WHERE cnt_bank_locations = (SELECT MIN(cnt_bank_locations) FROM bank_cnt)
),
acs_zip AS (                                 -- 2017 ACS employment & pop (age 16+)
  SELECT
    RIGHT(geoid,5)                                                     AS zip_code,
    MAX(CASE WHEN variable = 'B23025_001E' THEN value END) AS pop16_plus,
    MAX(CASE WHEN variable = 'B23025_005E' THEN value END) AS employed16_plus
  FROM `bigquery-public-data.census_bureau_acs.acs_2017_5yr`
  WHERE geotype = 'zip code tabulation area'
    AND variable IN ('B23025_001E','B23025_005E')
  GROUP BY zip_code
)
SELECT
  mz.zip_code,
  SAFE_DIVIDE(a.employed16_plus, a.pop16_plus) AS employment_rate_2017
FROM min_zip AS mz
JOIN acs_zip AS a USING (zip_code);
```
