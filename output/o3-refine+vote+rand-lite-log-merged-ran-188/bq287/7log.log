```sql
-- 1.  Count FDIC-insured bank branches in every Utah ZIP code
WITH bank_counts AS (
  SELECT
    z.zip_code,                                  -- 5–digit USPS ZIP
    COUNT(l.branch_fdic_uninum) AS branch_cnt    -- # of FDIC branches
  FROM `bigquery-public-data.geo_us_boundaries.zip_codes` z
  LEFT JOIN `bigquery-public-data.fdic_banks.locations`   l
         ON z.zip_code = l.zip_code
  WHERE z.state_code = 'UT'                      -- Utah only
  GROUP BY z.zip_code
),

-- 2.  Identify the single ZIP code that has the fewest (minimum) branches
min_zip AS (
  SELECT zip_code
  FROM bank_counts
  ORDER BY branch_cnt ASC, zip_code              -- tie-break with ZIP
  LIMIT 1
),

-- 3.  Pull 2017 ACS employment data for that ZIP (ZCTA) and compute rate
acs_2017 AS (
  SELECT
    zcta                                AS zip_code,
    SAFE_CAST(B23025_001E AS FLOAT64)   AS pop_16_plus,   -- population 16+
    SAFE_CAST(B23025_004E AS FLOAT64)   AS employed       -- employed persons
  FROM `bigquery-public-data.census_bureau_acs.zcta_2017_5yr`
)

-- 4.  Final answer: 2017 employment rate for the ZIP with the fewest branches
SELECT
  m.zip_code,
  ROUND( (a.employed / a.pop_16_plus) * 100, 2 ) AS employment_rate_2017
FROM min_zip   AS m
JOIN acs_2017  AS a
  USING (zip_code);
```
