```sql
--Description:  One‐pass solution that finishes the whole task:
--              • bank_cnt : count FDIC-insured branch offices in each Utah ZIP.
--              • min_zip  : retain those ZIP(s) whose count equals the statewide minimum
--                           ( = 0, i.e. no bank locations).
--              • acs_zip  : pull 2017 ACS 5-year totals for every ZIP Code Tabulation
--                           Area (ZCTA) – population age 16 +  and employed age 16 +.
--              • Final SELECT joins the two sub-results and computes the required
--                           employment-to-population ratio (SAFE_DIVIDE avoids ÷0).
WITH bank_cnt AS (        -- ❶ FDIC branches per ZIP
  SELECT
    z.zip_code,
    COUNT(l.branch_fdic_uninum) AS cnt_bank_locations
  FROM `bigquery-public-data.geo_us_boundaries.zip_codes` AS z
  LEFT JOIN `bigquery-public-data.fdic_banks.locations`   AS l
         ON z.zip_code = l.zip_code
  WHERE z.state_code = 'UT'
  GROUP BY z.zip_code
),
min_zip AS (              -- ❷ ZIP(s) that have the minimum branch count (0)
  SELECT zip_code
  FROM bank_cnt
  WHERE cnt_bank_locations = (SELECT MIN(cnt_bank_locations) FROM bank_cnt)
),
acs_zip AS (              -- ❸ 2017 ACS employment & population (age 16+) by ZIP
  SELECT
    zip_code,
    total_population_16_years_and_over          AS pop16_plus,
    civilian_employed_16_years_and_over         AS employed16_plus
  FROM `bigquery-public-data.census_acs.zip_2017_5yr`
)
SELECT                    -- ❹ Final answer
  mz.zip_code,
  SAFE_DIVIDE(a.employed16_plus, a.pop16_plus) AS employment_rate_2017
FROM min_zip AS mz
JOIN acs_zip AS a USING (zip_code);
```
