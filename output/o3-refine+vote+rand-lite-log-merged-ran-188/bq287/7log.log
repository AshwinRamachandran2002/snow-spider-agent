  GROUP BY z.zip_code
),

min_zip AS (               -- ZIP that has the fewest branches
  SELECT zip_code
  FROM bank_counts
  ORDER BY branch_cnt ASC, zip_code   -- tie-break by ZIP
  LIMIT 1
),

acs_2017 AS (              -- 2017 ACS 5-yr employment data (ZCTA level)
  SELECT
    SUBSTR(geo_id, 10, 5)                         AS zip_code,      -- 5-digit ZCTA
    SAFE_CAST(B23025_001E AS FLOAT64)             AS pop_16_plus,   -- population 16+
    SAFE_CAST(B23025_004E AS FLOAT64)             AS employed       -- employed persons
  FROM `bigquery-public-data.census_bureau_acs.zip_codes_2017_5yr`
)

