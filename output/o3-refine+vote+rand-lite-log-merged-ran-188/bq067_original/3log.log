    AND speed_limit_int  NOT IN (98, 99)          -- coded / unknown limits
    AND travel_speed_int <= 151
    AND speed_limit_int  <=  80
  GROUP BY state_number, consecutive_number
),
speed_categories AS (            -- bucket the average difference (0‑4)
  SELECT
