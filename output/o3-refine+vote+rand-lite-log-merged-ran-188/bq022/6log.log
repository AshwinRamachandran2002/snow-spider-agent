```sql
--Description: 1) Peek at some raw taxi–trip records to understand the columns we will use.
SELECT 
  `unique_key`,
  `trip_seconds`,
  `trip_miles`,
  `fare`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
--Description: 2) See the distinct forms of payment that appear in the data set.
SELECT DISTINCT
  `payment_type`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
--Description: 3) Sample only trips whose duration is between 0 s and 3 600 s (0–60 min).
SELECT 
  `unique_key`,
  `trip_seconds`,
  `fare`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` BETWEEN 0 AND 3600
LIMIT 20;
```

```sql
--Description: 4) Convert the duration to minutes (rounded) and view a few examples.
SELECT 
  `unique_key`,
  ROUND(`trip_seconds`/60.0) AS trip_minutes,
  `fare`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` BETWEEN 0 AND 3600
LIMIT 20;
```

```sql
--Description: 5) Count how many trips fall into each rounded-minute bucket (first 20 buckets shown).
SELECT
  ROUND(`trip_seconds`/60.0) AS trip_minutes,
  COUNT(*) AS trips_in_bucket
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` BETWEEN 0 AND 3600
GROUP BY trip_minutes
ORDER BY trip_minutes
LIMIT 20;
```

```sql
--Description: 6) Get the six-quantile break points for trip duration (in minutes).
SELECT
  APPROX_QUANTILES(`trip_seconds`/60.0, 6) AS minute_quantiles
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` BETWEEN 0 AND 3600
LIMIT 20;
```

```sql
--Description: 7) Show a sample of trips together with the NTILE-assigned quantile group (1–6).
SELECT
  `unique_key`,
  ROUND(`trip_seconds`/60.0) AS trip_minutes,
  NTILE(6) OVER (ORDER BY ROUND(`trip_seconds`/60.0)) AS duration_group,
  `fare`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` BETWEEN 0 AND 3600
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – For each of six equal-sized quantile groups (by duration),
--return the minimum & maximum duration (rounded minutes), trip count, and average fare.
WITH filtered AS (
  SELECT 
    ROUND(`trip_seconds`/60.0) AS trip_minutes,
    `fare`
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE `trip_seconds` BETWEEN 0 AND 3600        -- 0-60 minutes
),
quantiled AS (
  SELECT 
    trip_minutes,
    fare,
    NTILE(6) OVER (ORDER BY trip_minutes) AS duration_group
  FROM filtered
)
SELECT
  duration_group                                 AS quantile_group,
  MIN(trip_minutes)                              AS min_duration_min,
  MAX(trip_minutes)                              AS max_duration_min,
  COUNT(*)                                       AS total_trips,
  AVG(fare)                                      AS avg_fare
FROM quantiled
GROUP BY quantile_group
ORDER BY quantile_group
LIMIT 20;
```
