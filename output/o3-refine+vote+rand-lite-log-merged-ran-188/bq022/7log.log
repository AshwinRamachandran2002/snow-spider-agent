-- 9) Description: Aggregate per-quantile statistics that the final answer will need (no ordering yet)
WITH filtered AS (
  SELECT
    ROUND(trip_seconds/60.0) AS trip_minutes,
    fare,
    NTILE(6) OVER (ORDER BY trip_seconds) AS quantile
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 1 AND 3600
)
SELECT
  quantile,
  MIN(trip_minutes) AS min_minutes,
  MAX(trip_minutes) AS max_minutes,
  COUNT(*)          AS total_trips,
  AVG(fare)         AS avg_fare
FROM filtered
GROUP BY quantile
LIMIT 20;
