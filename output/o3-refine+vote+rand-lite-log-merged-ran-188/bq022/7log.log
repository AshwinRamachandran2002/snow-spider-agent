-- 10) Description (FINAL ANSWER):  For trips lasting 0–60 minutes, compute for each of six equal-sized
--     duration quantile groups: min & max rounded duration (minutes), total trips, and average fare.
WITH filtered AS (
  SELECT
    ROUND(trip_seconds/60.0)                       AS trip_minutes,      -- duration in whole minutes
    fare,
    NTILE(6) OVER (ORDER BY trip_seconds)          AS quantile           -- six equal quantiles
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 1 AND 3600                                 -- 0 < t ≤ 60 min
),
agg AS (
  SELECT
    quantile,
    MIN(trip_minutes)                              AS min_trip_minutes,
    MAX(trip_minutes)                              AS max_trip_minutes,
    COUNT(*)                                       AS total_trips,
    AVG(fare)                                      AS average_fare
  FROM filtered
  GROUP BY quantile
)
SELECT *
FROM agg
ORDER BY quantile;
