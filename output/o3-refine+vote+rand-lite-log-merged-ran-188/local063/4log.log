```sql
--Description: Cities whose promo-999 sales grew ≥20 % from Q4-2019 to Q4-2020
WITH q19 AS (
      SELECT cu.cust_city AS city ,
             SUM(s.amount_sold) AS amt19
      FROM   sales     AS s
      JOIN   customers AS cu ON cu.cust_id = s.cust_id
      JOIN   times     AS t  ON t.time_id  = s.time_id
      WHERE  s.promo_id            = 999
        AND  cu.country_id         = (SELECT country_id 
                                      FROM   countries 
                                      WHERE  country_name LIKE 'United States%' 
                                      LIMIT 1)
        AND  t.calendar_quarter_id = 1772
      GROUP BY cu.cust_city
), q20 AS (
      SELECT cu.cust_city AS city ,
             SUM(s.amount_sold) AS amt20
      FROM   sales     AS s
      JOIN   customers AS cu ON cu.cust_id = s.cust_id
      JOIN   times     AS t  ON t.time_id  = s.time_id
      WHERE  s.promo_id            = 999
        AND  cu.country_id         = (SELECT country_id 
                                      FROM   countries 
                                      WHERE  country_name LIKE 'United States%' 
                                      LIMIT 1)
        AND  t.calendar_quarter_id = 1776
      GROUP BY cu.cust_city
)
SELECT q20.city ,
       amt19 ,
       amt20 ,
       ROUND( (amt20-amt19)*1.0/amt19 , 3) AS growth_ratio
FROM   q19
JOIN   q20 USING (city)
WHERE  amt20 >= 1.2*amt19
LIMIT 20;
```

```sql
--Description: Product totals (per quarter) restricted to the growth-qualified cities
WITH growth_cities AS (
      /* re-use previous CTE to list cities that grew ≥20 % */
      WITH q19 AS (
            SELECT cu.cust_city AS city ,
                   SUM(s.amount_sold) AS amt19
            FROM   sales     AS s
            JOIN   customers AS cu ON cu.cust_id = s.cust_id
            JOIN   times     AS t  ON t.time_id  = s.time_id
            WHERE  s.promo_id            = 999
              AND  cu.country_id         = (SELECT country_id 
                                            FROM   countries 
                                            WHERE  country_name LIKE 'United States%' 
                                            LIMIT 1)
              AND  t.calendar_quarter_id = 1772
            GROUP BY cu.cust_city
      ), q20 AS (
            SELECT cu.cust_city AS city ,
                   SUM(s.amount_sold) AS amt20
            FROM   sales     AS s
            JOIN   customers AS cu ON cu.cust_id = s.cust_id
            JOIN   times     AS t  ON t.time_id  = s.time_id
            WHERE  s.promo_id            = 999
              AND  cu.country_id         = (SELECT country_id 
                                            FROM   countries 
                                            WHERE  country_name LIKE 'United States%' 
                                            LIMIT 1)
              AND  t.calendar_quarter_id = 1776
            GROUP BY cu.cust_city
      )
      SELECT q19.city
      FROM   q19
      JOIN   q20 USING (city)
      WHERE  q20.amt20 >= 1.2*q19.amt19
)
SELECT  s.prod_id ,
        t.calendar_quarter_id ,
        SUM(s.amount_sold) AS total_amount
FROM    sales      AS s
JOIN    customers  AS cu ON cu.cust_id = s.cust_id
JOIN    times      AS t  ON t.time_id   = s.time_id
WHERE   s.promo_id            = 999
  AND   cu.country_id         = (SELECT country_id 
                                 FROM   countries 
                                 WHERE  country_name LIKE 'United States%' 
                                 LIMIT 1)
  AND   cu.cust_city IN (SELECT city FROM growth_cities)
  AND   t.calendar_quarter_id IN (1772,1776)
GROUP BY s.prod_id ,
         t.calendar_quarter_id
LIMIT 20;
```

```sql
--Description: Rank products (combined sales both quarters) and keep Top-20 %
WITH growth_cities AS (
      -- (same definition as above)
      WITH q19 AS (
            SELECT cu.cust_city AS city ,
                   SUM(s.amount_sold) AS amt19
            FROM   sales     AS s
            JOIN   customers AS cu ON cu.cust_id = s.cust_id
            JOIN   times     AS t  ON t.time_id  = s.time_id
            WHERE  s.promo_id            = 999
              AND  cu.country_id         = (SELECT country_id 
                                            FROM   countries 
                                            WHERE  country_name LIKE 'United States%' 
                                            LIMIT 1)
              AND  t.calendar_quarter_id = 1772
            GROUP BY cu.cust_city
      ), q20 AS (
            SELECT cu.cust_city AS city ,
                   SUM(s.amount_sold) AS amt20
            FROM   sales     AS s
            JOIN   customers AS cu ON cu.cust_id = s.cust_id
            JOIN   times     AS t  ON t.time_id  = s.time_id
            WHERE  s.promo_id            = 999
              AND  cu.country_id         = (SELECT country_id 
                                            FROM   countries 
                                            WHERE  country_name LIKE 'United States%' 
                                            LIMIT 1)
              AND  t.calendar_quarter_id = 1776
            GROUP BY cu.cust_city
      )
      SELECT q19.city
      FROM   q19
      JOIN   q20 USING (city)
      WHERE  q20.amt20 >= 1.2*q19.amt19
), prod_tot AS (
      SELECT s.prod_id ,
             SUM(s.amount_sold) AS grand_total
      FROM   sales      AS s
      JOIN   customers  AS cu ON cu.cust_id = s.cust_id
      JOIN   times      AS t  ON t.time_id  = s.time_id
      WHERE  s.promo_id            = 999
        AND  cu.country_id         = (SELECT country_id 
                                      FROM   countries 
                                      WHERE  country_name LIKE 'United States%' 
                                      LIMIT 1)
        AND  cu.cust_city IN (SELECT city FROM growth_cities)
        AND  t.calendar_quarter_id IN (1772,1776)
      GROUP BY s.prod_id
), ranked AS (
      SELECT prod_id ,
             grand_total ,
             NTILE(5) OVER (ORDER BY grand_total DESC) AS quintile
      FROM   prod_tot
)
SELECT prod_id ,
       grand_total
FROM   ranked
WHERE  quintile = 1       -- top 20 %
LIMIT 20;
```

```sql
--Description: Pick the top-quintile product whose share-of-sales changed the least
WITH growth_cities AS (
      /* same definition as previous queries */
      WITH q19 AS (
            SELECT cu.cust_city AS city ,
                   SUM(s.amount_sold) AS amt19
            FROM   sales     AS s
            JOIN   customers AS cu ON cu.cust_id = s.cust_id
            JOIN   times     AS t  ON t.time_id  = s.time_id
            WHERE  s.promo_id            = 999
              AND  cu.country_id         = (SELECT country_id 
                                            FROM   countries 
                                            WHERE  country_name LIKE 'United States%' 
                                            LIMIT 1)
              AND  t.calendar_quarter_id = 1772
            GROUP BY cu.cust_city
      ), q20 AS (
            SELECT cu.cust_city AS city ,
                   SUM(s.amount_sold) AS amt20
            FROM   sales     AS s
            JOIN   customers AS cu ON cu.cust_id = s.cust_id
            JOIN   times     AS t  ON t.time_id = s.time_id
            WHERE  s.promo_id            = 999
              AND  cu.country_id         = (SELECT country_id 
                                            FROM   countries 
                                            WHERE  country_name LIKE 'United States%' 
                                            LIMIT 1)
              AND  t.calendar_quarter_id = 1776
            GROUP BY cu.cust_city
      )
      SELECT q19.city
      FROM   q19
      JOIN   q20 USING (city)
      WHERE  q20.amt20 >= 1.2*q19.amt19
), core_sales AS (
      SELECT s.prod_id ,
             t.calendar_quarter_id ,
             SUM(s.amount_sold) AS amt
      FROM   sales      AS s
      JOIN   customers  AS cu ON cu.cust_id = s.cust_id
      JOIN   times      AS t  ON t.time_id   = s.time_id
      WHERE  s.promo_id            = 999
        AND  cu.country_id         = (SELECT country_id 
                                      FROM   countries 
                                      WHERE  country_name LIKE 'United States%' 
                                      LIMIT 1)
        AND  cu.cust_city IN (SELECT city FROM growth_cities)
        AND  t.calendar_quarter_id IN (1772,1776)
      GROUP BY s.prod_id ,
               t.calendar_quarter_id
), quarter_tot AS (
      SELECT calendar_quarter_id ,
             SUM(amt) AS tot_amt
      FROM   core_sales
      GROUP BY calendar_quarter_id
), prod_share AS (
      SELECT cs.prod_id ,
             cs.calendar_quarter_id ,
             cs.amt * 1.0 / qt.tot_amt AS share
      FROM   core_sales  AS cs
      JOIN   quarter_tot AS qt USING (calendar_quarter_id)
), pair AS (
      SELECT p19.prod_id ,
             p19.share AS share_2019 ,
             p20.share AS share_2020 ,
             (p20.share - p19.share) AS delta
      FROM   prod_share AS p19
      JOIN   prod_share AS p20 
             ON p19.prod_id = p20.prod_id
            AND p19.calendar_quarter_id = 1772
            AND p20.calendar_quarter_id = 1776
), top20 AS (
      SELECT prod_id ,
             SUM(amt) AS grand_total
      FROM   core_sales
      GROUP BY prod_id
      ORDER BY grand_total DESC
      LIMIT (SELECT ROUND(COUNT(*)*0.20) FROM (SELECT DISTINCT prod_id FROM core_sales))
)
SELECT  pair.prod_id                AS smallest_change_prod_id ,
        ROUND(pair.delta,5)         AS pct_point_change
FROM    pair
WHERE   pair.prod_id IN (SELECT prod_id FROM top20)
ORDER BY ABS(pair.delta) ASC
LIMIT 1;
```
