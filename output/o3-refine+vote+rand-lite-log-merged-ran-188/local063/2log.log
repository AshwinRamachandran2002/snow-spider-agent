Query:
--Description: Cities whose promo 999 sales rose ≥20 % from Q4-2019 to Q4-2020
SELECT inc.city,
       inc.amount_q4_2019,
       inc.amount_q4_2020,
       (inc.amount_q4_2020 - inc.amount_q4_2019)*100.0/inc.amount_q4_2019 AS pct_increase
FROM  (
       SELECT city,
              SUM(CASE WHEN quarter = 1772 THEN amount END) AS amount_q4_2019,
              SUM(CASE WHEN quarter = 1776 THEN amount END) AS amount_q4_2020
       FROM (
             SELECT c.cust_city AS city,
                    t.calendar_quarter_id AS quarter,
                    s.amount_sold        AS amount
             FROM   sales      AS s
             JOIN   times      AS t ON s.time_id   = t.time_id
             JOIN   customers  AS c ON s.cust_id   = c.cust_id
             WHERE  t.calendar_quarter_id IN (1772,1776)
               AND  s.promo_id = 999
               AND  c.country_id = (SELECT country_id
                                    FROM countries
                                    WHERE country_name LIKE '%United States%'
                                    LIMIT 1)
            )
       GROUP BY city
      ) AS inc
WHERE inc.amount_q4_2019 > 0
  AND inc.amount_q4_2020 >= 1.2 * inc.amount_q4_2019
LIMIT 20;
