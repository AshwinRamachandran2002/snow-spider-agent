```sql
--Description: Example U.S. sales in Q4-2019 with promo_id 999
SELECT s.*,
       t.calendar_quarter_id,
       c.cust_city
FROM   sales      AS s
JOIN   times      AS t ON s.time_id = t.time_id
JOIN   customers  AS c ON s.cust_id = c.cust_id
WHERE  t.calendar_quarter_id = 1772
  AND  s.promo_id = 999
  AND  c.country_id = (SELECT country_id
                       FROM countries
                       WHERE country_name LIKE '%United States%'
                       LIMIT 1)
LIMIT 20;
```

```sql
--Description: Total amount sold per city (promo 999, Q4-2019, U.S.)
SELECT c.cust_city,
       SUM(s.amount_sold) AS amount_q4_2019
FROM   sales      AS s
JOIN   times      AS t ON s.time_id = t.time_id
JOIN   customers  AS c ON s.cust_id = c.cust_id
WHERE  t.calendar_quarter_id = 1772
  AND  s.promo_id = 999
  AND  c.country_id = (SELECT country_id
                       FROM countries
                       WHERE country_name LIKE '%United States%'
                       LIMIT 1)
GROUP  BY c.cust_city
ORDER  BY amount_q4_2019 DESC
LIMIT 20;
```

```sql
--Description: Total amount sold per city (promo 999, Q4-2020, U.S.)
SELECT c.cust_city,
       SUM(s.amount_sold) AS amount_q4_2020
FROM   sales      AS s
JOIN   times      AS t ON s.time_id = t.time_id
JOIN   customers  AS c ON s.cust_id = c.cust_id
WHERE  t.calendar_quarter_id = 1776
  AND  s.promo_id = 999
  AND  c.country_id = (SELECT country_id
                       FROM countries
                       WHERE country_name LIKE '%United States%'
                       LIMIT 1)
GROUP  BY c.cust_city
ORDER  BY amount_q4_2020 DESC
LIMIT 20;
```

```sql
--Description: Cities whose promo 999 sales rose ≥20 % from Q4-2019 to Q4-2020
SELECT inc.city,
       inc.amount_q4_2019,
       inc.amount_q4_2020,
       (inc.amount_q4_2020 - inc.amount_q4_2019)*100.0/inc.amount_q4_2019 AS pct_increase
FROM  (
       SELECT city,
              SUM(CASE WHEN quarter = 1772 THEN amount END) AS amount_q4_2019,
              SUM(CASE WHEN quarter = 1776 THEN amount END) AS amount_q4_2020
       FROM (
             SELECT c.cust_city AS city,
                    t.calendar_quarter_id AS quarter,
                    s.amount_sold        AS amount
             FROM   sales      AS s
             JOIN   times      AS t ON s.time_id   = t.time_id
             JOIN   customers  AS c ON s.cust_id   = c.cust_id
             WHERE  t.calendar_quarter_id IN (1772,1776)
               AND  s.promo_id = 999
               AND  c.country_id = (SELECT country_id
                                    FROM countries
                                    WHERE country_name LIKE '%United States%'
                                    LIMIT 1)
            )
       GROUP BY city
      ) AS inc
WHERE inc.amount_q4_2019 > 0
  AND inc.amount_q4_2020 >= 1.2 * inc.amount_q4_2019
LIMIT 20;
```

```sql
--Description: Top-selling products (total of both quarters) in qualifying cities
SELECT s.prod_id,
       SUM(s.amount_sold) AS total_amount
FROM   sales      AS s
JOIN   times      AS t ON s.time_id = t.time_id
JOIN   customers  AS c ON s.cust_id = c.cust_id
WHERE  t.calendar_quarter_id IN (1772,1776)
  AND  s.promo_id = 999
  AND  c.country_id = (SELECT country_id
                       FROM countries
                       WHERE country_name LIKE '%United States%'
                       LIMIT 1)
  AND  c.cust_city IN (          -- cities with ≥20 % growth
        SELECT city
        FROM (
              SELECT c.cust_city AS city,
                     SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END) AS amt19,
                     SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END) AS amt20
              FROM   sales      AS s
              JOIN   times      AS t ON s.time_id = t.time_id
              JOIN   customers  AS c ON s.cust_id = c.cust_id
              WHERE  t.calendar_quarter_id IN (1772,1776)
                AND  s.promo_id  = 999
                AND  c.country_id = (SELECT country_id
                                     FROM countries
                                     WHERE country_name LIKE '%United States%'
                                     LIMIT 1)
              GROUP  BY c.cust_city
              HAVING amt19 IS NOT NULL AND amt20 >= 1.2*amt19
             )
       )
GROUP  BY s.prod_id
ORDER  BY total_amount DESC
LIMIT 20;
```

```sql
--Description: Sales share of each product per quarter within qualifying cities
SELECT prod_id,
       quarter,
       SUM(amount_sold) AS amount
FROM  (
       SELECT s.prod_id,
              t.calendar_quarter_id AS quarter,
              s.amount_sold
       FROM   sales      AS s
       JOIN   times      AS t ON s.time_id = t.time_id
       JOIN   customers  AS c ON s.cust_id = c.cust_id
       WHERE  t.calendar_quarter_id IN (1772,1776)
         AND  s.promo_id = 999
         AND  c.country_id = (SELECT country_id
                              FROM countries
                              WHERE country_name LIKE '%United States%'
                              LIMIT 1)
         AND  c.cust_city IN (
               SELECT city
               FROM (
                     SELECT c.cust_city AS city,
                            SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END) AS amt19,
                            SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END) AS amt20
                     FROM   sales      AS s
                     JOIN   times      AS t ON s.time_id = t.time_id
                     JOIN   customers  AS c ON s.cust_id = c.cust_id
                     WHERE  t.calendar_quarter_id IN (1772,1776)
                       AND  s.promo_id = 999
                       AND  c.country_id = (SELECT country_id
                                            FROM countries
                                            WHERE country_name LIKE '%United States%'
                                            LIMIT 1)
                     GROUP  BY c.cust_city
                     HAVING amt19 IS NOT NULL AND amt20 >= 1.2*amt19
                    )
              )
      ) AS sub
GROUP BY prod_id, quarter
ORDER BY quarter, amount DESC
LIMIT 20;
```

```sql
--Description: Product in top 20 % of total sales with the smallest change in share (pct-points)
WITH
city_list AS (
  SELECT c.cust_city AS city,
         SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END) AS amt19,
         SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END) AS amt20
  FROM   sales      AS s
  JOIN   times      AS t ON s.time_id = t.time_id
  JOIN   customers  AS c ON s.cust_id = c.cust_id
  WHERE  t.calendar_quarter_id IN (1772,1776)
    AND  s.promo_id = 999
    AND  c.country_id = (SELECT country_id
                         FROM countries
                         WHERE country_name LIKE '%United States%'
                         LIMIT 1)
  GROUP  BY c.cust_city
  HAVING amt19 IS NOT NULL AND amt20 >= 1.2*amt19
),
sales_filtered AS (
  SELECT s.prod_id,
         t.calendar_quarter_id AS quarter,
         s.amount_sold
  FROM   sales      AS s
  JOIN   times      AS t ON s.time_id = t.time_id
  JOIN   customers  AS c ON s.cust_id = c.cust_id
  WHERE  t.calendar_quarter_id IN (1772,1776)
    AND  s.promo_id = 999
    AND  c.country_id = (SELECT country_id
                         FROM countries
                         WHERE country_name LIKE '%United States%'
                         LIMIT 1)
    AND  c.cust_city IN (SELECT city FROM city_list)
),
prod_totals AS (
  SELECT prod_id,
         SUM(amount_sold) AS total_amount
  FROM   sales_filtered
  GROUP  BY prod_id
),
threshold AS (
  SELECT MAX(total_amount) * 0.2 AS cutoff FROM prod_totals
),
top_prods AS (
  SELECT prod_id
  FROM   prod_totals, threshold
  WHERE  total_amount >= cutoff
),
shares AS (
  SELECT sf.prod_id,
         sf.quarter,
         SUM(sf.amount_sold) AS amt
  FROM   sales_filtered AS sf
  WHERE  sf.prod_id IN (SELECT prod_id FROM top_prods)
  GROUP  BY sf.prod_id, sf.quarter
),
tot_by_q AS (
  SELECT quarter,
         SUM(amt) AS tot_q_amt
  FROM   shares
  GROUP  BY quarter
),
prod_share AS (
  SELECT s.prod_id,
         s.quarter,
         (s.amt * 1.0) / t.tot_q_amt AS share
  FROM   shares    AS s
  JOIN   tot_by_q  AS t ON s.quarter = t.quarter
),
pivot AS (
  SELECT prod_id,
         MAX(CASE WHEN quarter = 1772 THEN share END) AS share_2019,
         MAX(CASE WHEN quarter = 1776 THEN share END) AS share_2020
  FROM   prod_share
  GROUP  BY prod_id
)
SELECT prod_id,
       (share_2020 - share_2019) * 100.0 AS share_change_pct_point
FROM   pivot
ORDER  BY ABS(share_change_pct_point) ASC
LIMIT 20;
```
