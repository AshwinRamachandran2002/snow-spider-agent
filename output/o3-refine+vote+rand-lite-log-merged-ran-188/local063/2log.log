Query:
--Description: Top-selling products (total of both quarters) in qualifying cities
SELECT s.prod_id,
       SUM(s.amount_sold) AS total_amount
FROM   sales      AS s
JOIN   times      AS t ON s.time_id = t.time_id
JOIN   customers  AS c ON s.cust_id = c.cust_id
WHERE  t.calendar_quarter_id IN (1772,1776)
  AND  s.promo_id = 999
  AND  c.country_id = (SELECT country_id
                       FROM countries
                       WHERE country_name LIKE '%United States%'
                       LIMIT 1)
  AND  c.cust_city IN (          -- cities with ≥20 % growth
        SELECT city
        FROM (
              SELECT c.cust_city AS city,
                     SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END) AS amt19,
                     SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END) AS amt20
              FROM   sales      AS s
              JOIN   times      AS t ON s.time_id = t.time_id
              JOIN   customers  AS c ON s.cust_id = c.cust_id
              WHERE  t.calendar_quarter_id IN (1772,1776)
                AND  s.promo_id  = 999
                AND  c.country_id = (SELECT country_id
                                     FROM countries
                                     WHERE country_name LIKE '%United States%'
                                     LIMIT 1)
              GROUP  BY c.cust_city
              HAVING amt19 IS NOT NULL AND amt20 >= 1.2*amt19
             )
       )
GROUP  BY s.prod_id
ORDER  BY total_amount DESC
LIMIT 20;
