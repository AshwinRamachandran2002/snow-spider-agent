--Description: Product in top 20 % of total sales with the smallest change in share (pct-points)
WITH
city_list AS (
  SELECT c.cust_city AS city,
         SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END) AS amt19,
         SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END) AS amt20
  FROM   sales      AS s
  JOIN   times      AS t ON s.time_id = t.time_id
  JOIN   customers  AS c ON s.cust_id = c.cust_id
  WHERE  t.calendar_quarter_id IN (1772,1776)
    AND  s.promo_id = 999
    AND  c.country_id = (SELECT country_id
                         FROM countries
                         WHERE country_name LIKE '%United States%'
                         LIMIT 1)
  GROUP  BY c.cust_city
  HAVING amt19 IS NOT NULL AND amt20 >= 1.2*amt19
),
sales_filtered AS (
  SELECT s.prod_id,
         t.calendar_quarter_id AS quarter,
         s.amount_sold
  FROM   sales      AS s
  JOIN   times      AS t ON s.time_id = t.time_id
  JOIN   customers  AS c ON s.cust_id = c.cust_id
  WHERE  t.calendar_quarter_id IN (1772,1776)
    AND  s.promo_id = 999
    AND  c.country_id = (SELECT country_id
                         FROM countries
                         WHERE country_name LIKE '%United States%'
                         LIMIT 1)
    AND  c.cust_city IN (SELECT city FROM city_list)
),
prod_totals AS (
  SELECT prod_id,
         SUM(amount_sold) AS total_amount
  FROM   sales_filtered
  GROUP  BY prod_id
),
threshold AS (
  SELECT MAX(total_amount) * 0.2 AS cutoff FROM prod_totals
),
top_prods AS (
  SELECT prod_id
  FROM   prod_totals, threshold
  WHERE  total_amount >= cutoff
),
shares AS (
  SELECT sf.prod_id,
         sf.quarter,
         SUM(sf.amount_sold) AS amt
  FROM   sales_filtered AS sf
  WHERE  sf.prod_id IN (SELECT prod_id FROM top_prods)
  GROUP  BY sf.prod_id, sf.quarter
),
tot_by_q AS (
  SELECT quarter,
         SUM(amt) AS tot_q_amt
  FROM   shares
  GROUP  BY quarter
),
prod_share AS (
  SELECT s.prod_id,
         s.quarter,
         (s.amt * 1.0) / t.tot_q_amt AS share
  FROM   shares    AS s
  JOIN   tot_by_q  AS t ON s.quarter = t.quarter
),
pivot AS (
  SELECT prod_id,
         MAX(CASE WHEN quarter = 1772 THEN share END) AS share_2019,
         MAX(CASE WHEN quarter = 1776 THEN share END) AS share_2020
  FROM   prod_share
  GROUP  BY prod_id
)
SELECT prod_id,
       (share_2020 - share_2019) * 100.0 AS share_change_pct_point
FROM   pivot
ORDER  BY ABS(share_change_pct_point) ASC
LIMIT 20;
