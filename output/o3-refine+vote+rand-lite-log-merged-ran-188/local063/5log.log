FROM times
WHERE calendar_quarter_id = 1772
ORDER BY time_id
LIMIT 20;
```

```sql
--Description: 5) Preview some United-States sales rows that use promo_id = 999 so we know the shape of the data we will join on.
SELECT s.prod_id, s.cust_id, s.time_id, s.quantity_sold, s.amount_sold
FROM   sales AS s
JOIN   customers AS c  ON c.cust_id = s.cust_id
WHERE  c.country_id IN (SELECT country_id
                        FROM countries
                        WHERE country_name LIKE '%United%States%')
  AND  s.promo_id = 999
LIMIT 20;
```

```sql
--Description: 6) Aggregate total sales (amount_sold) at city level for Q4 2019.
SELECT c.cust_city,
       SUM(s.amount_sold) AS amt_2019_Q4
FROM   sales      AS s
JOIN   customers  AS c ON c.cust_id = s.cust_id
JOIN   times      AS t ON t.time_id = s.time_id
WHERE  c.country_id IN (SELECT country_id
                        FROM countries
                        WHERE country_name LIKE '%United%States%')
  AND  s.promo_id = 999
  AND  t.calendar_quarter_id = 1772        -- Q4 2019
GROUP  BY c.cust_city
LIMIT 20;
```

```sql
--Description: 7) Aggregate total sales at city level for Q4 2020 in the same way.
SELECT c.cust_city,
       SUM(s.amount_sold) AS amt_2020_Q4
FROM   sales      AS s
JOIN   customers  AS c ON c.cust_id = s.cust_id
JOIN   times      AS t ON t.time_id = s.time_id
WHERE  c.country_id IN (SELECT country_id
                        FROM countries
                        WHERE country_name LIKE '%United%States%')
  AND  s.promo_id = 999
  AND  t.calendar_quarter_id = 1776        -- Q4 2020
GROUP  BY c.cust_city
LIMIT 20;
```

```sql
--Description: 8) Find the U.S. cities whose total sales grew by at least 20 % from Q4 2019 to Q4 2020.
WITH q4_2019 AS (
    SELECT c.cust_city, SUM(s.amount_sold) AS amt_2019
    FROM   sales s
    JOIN   customers c ON c.cust_id = s.cust_id
    JOIN   times t     ON t.time_id = s.time_id
    WHERE  c.country_id IN (SELECT country_id FROM countries
                             WHERE country_name LIKE '%United%States%')
      AND  s.promo_id = 999
      AND  t.calendar_quarter_id = 1772
    GROUP  BY c.cust_city
),
q4_2020 AS (
    SELECT c.cust_city, SUM(s.amount_sold) AS amt_2020
    FROM   sales s
    JOIN   customers c ON c.cust_id = s.cust_id
    JOIN   times t     ON t.time_id = s.time_id
    WHERE  c.country_id IN (SELECT country_id FROM countries
                             WHERE country_name LIKE '%United%States%')
      AND  s.promo_id = 999
      AND  t.calendar_quarter_id = 1776
    GROUP  BY c.cust_city
)
SELECT q20.cust_city,
       q19.amt_2019,
       q20.amt_2020,
       ROUND((q20.amt_2020 - q19.amt_2019)*100.0 / q19.amt_2019, 2) AS pct_growth
FROM   q4_2019 q19
JOIN   q4_2020 q20 USING (cust_city)
WHERE  q20.amt_2020 >= 1.20 * q19.amt_2019
LIMIT 20;
```

```sql
--Description: 9) For the qualifying cities, compute each product’s total sales in each quarter as well as its share of the quarter total.
WITH qualified_cities AS (   -- cities that grew ≥20 %
    WITH q4_2019 AS (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt_2019
        FROM   sales s
        JOIN   customers c ON c.cust_id = s.cust_id
        JOIN   times t     ON t.time_id = s.time_id
        WHERE  c.country_id IN (SELECT country_id FROM countries
                                 WHERE country_name LIKE '%United%States%')
          AND  s.promo_id = 999
          AND  t.calendar_quarter_id = 1772
        GROUP  BY c.cust_city
    ),
    q4_2020 AS (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt_2020
        FROM   sales s
        JOIN   customers c ON c.cust_id = s.cust_id
        JOIN   times t     ON t.time_id = s.time_id
        WHERE  c.country_id IN (SELECT country_id FROM countries
                                 WHERE country_name LIKE '%United%States%')
          AND  s.promo_id = 999
          AND  t.calendar_quarter_id = 1776
        GROUP  BY c.cust_city
    )
    SELECT q20.cust_city
    FROM   q4_2019 q19
    JOIN   q4_2020 q20 USING (cust_city)
    WHERE  q20.amt_2020 >= 1.20 * q19.amt_2019
),
sales_by_prod_qtr AS (
    SELECT s.prod_id,
           t.calendar_quarter_id AS qtr_id,
           SUM(s.amount_sold)    AS prod_sales
    FROM   sales s
    JOIN   customers c ON c.cust_id = s.cust_id
    JOIN   times t     ON t.time_id = s.time_id
    WHERE  c.cust_city IN (SELECT cust_city FROM qualified_cities)
      AND  c.country_id IN (SELECT country_id FROM countries
                             WHERE country_name LIKE '%United%States%')
      AND  s.promo_id = 999
      AND  t.calendar_quarter_id IN (1772, 1776)
    GROUP  BY s.prod_id, t.calendar_quarter_id
),
totals_by_qtr AS (
    SELECT qtr_id, SUM(prod_sales) AS qtr_total
    FROM   sales_by_prod_qtr
    GROUP  BY qtr_id
),
shares AS (
    SELECT p.prod_id,
           p.qtr_id,
           p.prod_sales,
           ROUND(100.0 * p.prod_sales / t.qtr_total, 4) AS prod_share_pct
    FROM   sales_by_prod_qtr  p
    JOIN   totals_by_qtr      t ON t.qtr_id = p.qtr_id
)
SELECT *
FROM   shares
LIMIT 20;
```

```sql
--Description: 10) Identify products in the top 20 % of combined sales and pick the one whose share changed the least between the two quarters.
WITH qualified_cities AS (
    WITH q4_2019 AS (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt_2019
        FROM   sales s
        JOIN   customers c ON c.cust_id = s.cust_id
        JOIN   times t     ON t.time_id = s.time_id
        WHERE  c.country_id IN (SELECT country_id FROM countries
                                 WHERE country_name LIKE '%United%States%')
          AND  s.promo_id = 999
          AND  t.calendar_quarter_id = 1772
        GROUP  BY c.cust_city
    ),
    q4_2020 AS (
        SELECT c.cust_city, SUM(s.amount_sold) AS amt_2020
        FROM   sales s
        JOIN   customers c ON c.cust_id = s.cust_id
        JOIN   times t     ON t.time_id = s.time_id
        WHERE  c.country_id IN (SELECT country_id FROM countries
                                 WHERE country_name LIKE '%United%States%')
          AND  s.promo_id = 999
          AND  t.calendar_quarter_id = 1776
        GROUP  BY c.cust_city
    )
    SELECT q20.cust_city
    FROM   q4_2019 q19
    JOIN   q4_2020 q20 USING (cust_city)
    WHERE  q20.amt_2020 >= 1.20 * q19.amt_2019
),
sales_by_prod AS (
    SELECT s.prod_id,
           CASE WHEN t.calendar_quarter_id = 1772 THEN 'Q4_2019' ELSE 'Q4_2020' END AS which_qtr,
           SUM(s.amount_sold) AS amt
    FROM   sales s
    JOIN   customers c ON c.cust_id = s.cust_id
    JOIN   times     t ON t.time_id = s.time_id
    WHERE  c.cust_city IN (SELECT cust_city FROM qualified_cities)
      AND  c.country_id IN (SELECT country_id FROM countries
                             WHERE country_name LIKE '%United%States%')
      AND  s.promo_id = 999
      AND  t.calendar_quarter_id IN (1772, 1776)
    GROUP  BY s.prod_id, which_qtr
),
totals AS (  -- combined sales per product across both quarters
    SELECT prod_id, SUM(amt) AS total_amt
    FROM   sales_by_prod
    GROUP  BY prod_id
),
top20 AS (  -- top-20 % products by total sales
    SELECT prod_id
    FROM   totals
    ORDER  BY total_amt DESC
    LIMIT (SELECT CAST(0.2 * COUNT(*) AS INTEGER) FROM totals)
),
shares AS (  -- get each product’s share in its quarter
    SELECT sp.prod_id,
           sp.which_qtr,
           sp.amt,
           100.0 * sp.amt / (SELECT SUM(amt) FROM sales_by_prod WHERE which_qtr = sp.which_qtr) AS share_pct
    FROM   sales_by_prod sp
),
pivot AS (  -- pivot shares to have both quarters on one row
    SELECT s19.prod_id,
           s19.share_pct AS share_2019,
           s20.share_pct AS share_2020,
           (s20.share_pct - s19.share_pct) AS pct_point_change
    FROM   shares s19
    JOIN   shares s20 ON s20.prod_id = s19.prod_id
    WHERE  s19.which_qtr = 'Q4_2019'
      AND  s20.which_qtr = 'Q4_2020'
      AND  s19.prod_id IN (SELECT prod_id FROM top20)
)
SELECT prod_id,
       share_2019,
       share_2020,
       pct_point_change
FROM   pivot
ORDER  BY ABS(pct_point_change) ASC   -- smallest absolute change
LIMIT 20;
```
