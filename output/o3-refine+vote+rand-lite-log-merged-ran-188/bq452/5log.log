-- 7. For the same 100 variants, compute Yates-corrected χ² statistic
WITH counts AS (
  SELECT  v.start, v.end,
          SUM(IF(s.Super_Population = 'EAS',
                 (SELECT SUM(IF(x = 1,1,0)) FROM UNNEST(c.genotype) AS x),0))  AS a, -- alt_case
          SUM(IF(s.Super_Population = 'EAS',
                 (SELECT SUM(IF(x = 0,1,0)) FROM UNNEST(c.genotype) AS x),0))  AS b, -- ref_case
          SUM(IF(s.Super_Population != 'EAS',
                 (SELECT SUM(IF(x = 1,1,0)) FROM UNNEST(c.genotype) AS x),0))  AS c, -- alt_ctrl
          SUM(IF(s.Super_Population != 'EAS',
                 (SELECT SUM(IF(x = 0,1,0)) FROM UNNEST(c.genotype) AS x),0))  AS d  -- ref_ctrl
  FROM    `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  LEFT  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
         ON s.Sample = c.call_set_name
  WHERE   v.reference_name = '12'
  GROUP BY v.start, v.end
  LIMIT   100
)
SELECT *, 
       POWER(ABS(a*d - b*c) - ( (a+b+c+d)/2.0 ), 2) * (a+b+c+d)
       / ( (a+b)*(c+d)*(a+c)*(b+d) )                                                   AS chi2_yates
FROM   counts;
```

```sql
-- 8. Full scan on chromosome 12 – χ² with Yates, keep variants whose expected counts ≥ 5
WITH allele_counts AS (
  SELECT  v.start, v.end,
          SUM(IF(s.Super_Population = 'EAS',
                 (SELECT SUM(IF(x = 1,1,0)) FROM UNNEST(c.genotype) AS x),0)) AS a,
          SUM(IF(s.Super_Population = 'EAS',
                 (SELECT SUM(IF(x = 0,1,0)) FROM UNNEST(c.genotype) AS x),0)) AS b,
          SUM(IF(s.Super_Population != 'EAS',
                 (SELECT SUM(IF(x = 1,1,0)) FROM UNNEST(c.genotype) AS x),0)) AS c,
          SUM(IF(s.Super_Population != 'EAS',
                 (SELECT SUM(IF(x = 0,1,0)) FROM UNNEST(c.genotype) AS x),0)) AS d
  FROM    `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  LEFT  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
         ON s.Sample = c.call_set_name
  WHERE   v.reference_name = '12'
  GROUP BY v.start, v.end
),
expected_ok AS (
  SELECT *,
         (a+c) AS alt_all,  (b+d) AS ref_all,
         (a+b) AS case_all, (c+d) AS ctrl_all,
         (a+b+c+d)                          AS N
  FROM   allele_counts
),
chi2 AS (
  SELECT start, end,
         a, b, c, d, N,
         (alt_all * case_all / N)               AS E_alt_case,
         (alt_all * ctrl_all / N)               AS E_alt_ctrl,
         (ref_all * case_all / N)               AS E_ref_case,
         (ref_all * ctrl_all / N)               AS E_ref_ctrl,
         POWER(ABS(a*d - b*c) - (N/2.0), 2) * N
         / ( (a+b)*(c+d)*(a+c)*(b+d) )          AS chi2_yates
  FROM   expected_ok
  WHERE  N >= 20  -- at least 10 diploid individuals overall
         AND LEAST(alt_all * case_all / N,
                    alt_all * ctrl_all / N,
                    ref_all * case_all / N,
                    ref_all * ctrl_all / N) >= 5
)
SELECT  start,
        end,
        chi2_yates
FROM    chi2
WHERE   chi2_yates >= 29.71679
ORDER BY chi2_yates DESC;
```

