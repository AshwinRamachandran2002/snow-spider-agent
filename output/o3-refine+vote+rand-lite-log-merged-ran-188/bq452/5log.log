--Description:
-- Compute Yates-corrected χ² statistics for every chromosome-12 variant contrasting
-- “cases” (EAS super-population) vs. “controls” (all other super-populations).
--   • Step 1 (allele_counts):  explode the nested `call` array, translate each
--     genotype into counts of ALT (1) and REF (0) alleles, and sum them per variant
--     separately for EAS and non-EAS individuals → a, b, c, d.
--   • Step 2 (filtered):  keep only variants whose four expected counts in the
--     2×2 table are ≥ 5 and whose total allele count N ≥ 20 (≈ 10 diploid people),
--     satisfying χ² assumptions.
--   • Step 3 (chi2):  apply Yates’s continuity-corrected χ² formula:
--         χ² = (|ad − bc| − N/2)² × N / [(a+b)(c+d)(a+c)(b+d)]
--   • Final SELECT:  return start, end and χ² for variants whose statistic
--     meets the threshold 29.71679, ordered from highest to lowest.
WITH allele_counts AS (
  SELECT
    v.start,
    v.end,
    -- a: ALT alleles in EAS (cases)
    SUM(
      IF(s.Super_Population = 'EAS',
         (SELECT SUM(IF(g = 1, 1, 0)) FROM UNNEST(c.genotype) AS g),
         0)
    ) AS a,
    -- b: REF alleles in EAS
    SUM(
      IF(s.Super_Population = 'EAS',
         (SELECT SUM(IF(g = 0, 1, 0)) FROM UNNEST(c.genotype) AS g),
         0)
    ) AS b,
    -- c: ALT alleles in non-EAS (controls)
    SUM(
      IF(s.Super_Population <> 'EAS',
         (SELECT SUM(IF(g = 1, 1, 0)) FROM UNNEST(c.genotype) AS g),
         0)
    ) AS c,
    -- d: REF alleles in non-EAS
    SUM(
      IF(s.Super_Population <> 'EAS',
         (SELECT SUM(IF(g = 0, 1, 0)) FROM UNNEST(c.genotype) AS g),
         0)
    ) AS d
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  LEFT JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.end
),
filtered AS (
  SELECT
    *,
    (a + b + c + d)                             AS N,
    (a + c)                                     AS alt_total,
    (b + d)                                     AS ref_total,
    (a + b)                                     AS case_total,
    (c + d)                                     AS ctrl_total
  FROM allele_counts
  WHERE (a + b + c + d) >= 20          -- ensure sufficient data
    AND LEAST(
          alt_total * case_total / (a + b + c + d),
          alt_total * ctrl_total / (a + b + c + d),
          ref_total * case_total / (a + b + c + d),
          ref_total * ctrl_total / (a + b + c + d)
        ) >= 5                         -- each expected cell ≥ 5
),
chi2 AS (
  SELECT
    start,
    end,
    POWER(ABS(a * d - b * c) - (N / 2.0), 2) * N /
         ((a + b) * (c + d) * (a + c) * (b + d))  AS chi2_yates
  FROM filtered
)
SELECT
  start,
  end,
  chi2_yates
FROM chi2
WHERE chi2_yates >= 29.71679
ORDER BY chi2_yates DESC;
