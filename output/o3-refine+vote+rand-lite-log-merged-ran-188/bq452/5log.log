--Description:
-- Compute Yates-corrected χ² statistics for every chromosome-12 variant,
-- contrasting allele counts in “cases” (EAS super-population) versus
-- “controls” (all other super-populations).  The column name `end`
-- is back-ticked to avoid the reserved word END.  Only variants whose
-- four expected counts are ≥ 5 are kept, and we report those whose
-- χ² ≥ 29.71679.
WITH per_call AS (             -- one row per (variant, sample) call
  SELECT
    v.start                      AS var_start,
    v.`end`                      AS var_end,
    s.Super_Population           AS super_pop,
    -- count ALT and REF alleles in the genotype array
    (SELECT COUNTIF(g > 0) FROM UNNEST(c.genotype) AS g) AS alt_cnt,
    (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) AS g) AS ref_cnt
  FROM  `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  LEFT JOIN  `spider2-public-data.1000_genomes.sample_info` AS s
         ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'
),
allele_counts AS (            -- aggregate to a, b, c, d per variant
  SELECT
    var_start,
    var_end,
    SUM(IF(super_pop = 'EAS', alt_cnt, 0)) AS a,   -- ALT  in cases
    SUM(IF(super_pop = 'EAS', ref_cnt, 0)) AS b,   -- REF  in cases
    SUM(IF(super_pop <> 'EAS', alt_cnt, 0)) AS c,  -- ALT  in controls
    SUM(IF(super_pop <> 'EAS', ref_cnt, 0)) AS d   -- REF  in controls
  FROM per_call
  GROUP BY var_start, var_end
),
filtered AS (                 -- enforce χ² validity: all expected ≥ 5
  SELECT *,
         (a + b + c + d)                               AS N,
         (a + c)                                       AS alt_tot,
         (b + d)                                       AS ref_tot,
         (a + b)                                       AS case_tot,
         (c + d)                                       AS ctrl_tot
  FROM allele_counts
  WHERE (a + b + c + d) >= 20
    AND LEAST( alt_tot * case_tot / (a + b + c + d),
               alt_tot * ctrl_tot / (a + b + c + d),
               ref_tot * case_tot / (a + b + c + d),
               ref_tot * ctrl_tot / (a + b + c + d) ) >= 5
),
chi2 AS (                    -- Yates-corrected χ² statistic
  SELECT
    var_start AS `start`,
    var_end   AS `end`,
    POWER(ABS(a * d - b * c) - ((a + b + c + d) / 2.0), 2) *
         (a + b + c + d) /
         ((a + b) * (c + d) * (a + c) * (b + d))          AS chi2_yates
  FROM filtered
)
SELECT
  `start`,
  `end`,
  chi2_yates
FROM chi2
WHERE chi2_yates >= 29.71679
ORDER BY chi2_yates DESC;
```
