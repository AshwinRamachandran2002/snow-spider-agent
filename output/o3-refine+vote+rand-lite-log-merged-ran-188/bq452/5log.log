```sql
--Description: Aggregate ALT/REF allele counts for 100 chromosome-12 variants,
--separating EAS (cases) from non-EAS (controls).
SELECT
  v.start,
  SUM(IF(s.Super_Population = 'EAS',
         (SELECT SUM(IF(x = 1, 1, 0)) FROM UNNEST(c.genotype) AS x), 0)) AS alt_case,
  SUM(IF(s.Super_Population = 'EAS',
         (SELECT SUM(IF(x = 0, 1, 0)) FROM UNNEST(c.genotype) AS x), 0)) AS ref_case,
  SUM(IF(s.Super_Population <> 'EAS',
         (SELECT SUM(IF(x = 1, 1, 0)) FROM UNNEST(c.genotype) AS x), 0)) AS alt_ctrl,
  SUM(IF(s.Super_Population <> 'EAS',
         (SELECT SUM(IF(x = 0, 1, 0)) FROM UNNEST(c.genotype) AS x), 0)) AS ref_ctrl
FROM  `bigquery-public-data.human_genome_variants.1000_genomes_variants` AS v
CROSS JOIN UNNEST(v.call) AS c
LEFT  JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS s
       ON s.Sample = c.call_set_name
WHERE v.reference_name = '12'
GROUP BY v.start
LIMIT 100;
