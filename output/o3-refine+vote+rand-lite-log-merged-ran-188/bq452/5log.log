--Description:
-- Solve the full task in one statement:
--   • explode chromosome-12 variant calls,
--   • count ALT/REF alleles for EAS (“cases”) and non-EAS (“controls”),
--   • retain variants whose four expected χ² counts are ≥ 5,
--   • compute Yates-corrected χ²,
--   • return positions whose statistic ≥ 29.71679.
-- Column name `end` is back-ticked to avoid collision with the END keyword.
WITH per_call AS (
  SELECT
    v.start                      AS var_start,
    v.`end`                      AS var_end,
    IF(s.Super_Population = 'EAS', TRUE, FALSE) AS is_eas,
    (SELECT COUNTIF(g > 0) FROM UNNEST(c.genotype) AS g) AS alt_cnt,
    (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) AS g) AS ref_cnt
  FROM  `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  LEFT  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
         ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'
),
allele_counts AS (
  SELECT
    var_start,
    var_end,
    SUM(IF(is_eas, alt_cnt, 0)) AS a,   -- ALT in cases
    SUM(IF(is_eas, ref_cnt, 0)) AS b,   -- REF in cases
    SUM(IF(NOT is_eas, alt_cnt, 0)) AS c, -- ALT in controls
    SUM(IF(NOT is_eas, ref_cnt, 0)) AS d  -- REF in controls
  FROM per_call
  GROUP BY var_start, var_end
),
valid AS (
  SELECT *,
         (a+b+c+d)                         AS N,
         (a+c)                             AS alt_total,
         (b+d)                             AS ref_total,
         (a+b)                             AS case_total,
         (c+d)                             AS ctrl_total
  FROM allele_counts
  WHERE N >= 20
    AND LEAST(
          alt_total * case_total / N,
          alt_total * ctrl_total / N,
          ref_total * case_total / N,
          ref_total * ctrl_total / N
        ) >= 5
),
chi2 AS (
  SELECT
    var_start AS start,
    var_end   AS `end`,
    POWER(ABS(a*d - b*c) - (N/2.0), 2) * N /
         ((a+b)*(c+d)*(a+c)*(b+d))     AS chi2_yates
  FROM valid
)
SELECT start, `end`, chi2_yates
FROM   chi2
WHERE  chi2_yates >= 29.71679
ORDER  BY chi2_yates DESC;
