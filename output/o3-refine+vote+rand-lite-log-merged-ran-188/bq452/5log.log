```sql
--Description: Compute Yates-corrected χ² for the same 100 chromosome-12 variants.
WITH counts AS (
  SELECT
    v.start,
    v.`end`,
    SUM(IF(s.Super_Population = 'EAS',
           (SELECT SUM(IF(x = 1, 1, 0)) FROM UNNEST(c.genotype) AS x), 0)) AS a,
    SUM(IF(s.Super_Population = 'EAS',
           (SELECT SUM(IF(x = 0, 1, 0)) FROM UNNEST(c.genotype) AS x), 0)) AS b,
    SUM(IF(s.Super_Population <> 'EAS',
           (SELECT SUM(IF(x = 1, 1, 0)) FROM UNNEST(c.genotype) AS x), 0)) AS c,
    SUM(IF(s.Super_Population <> 'EAS',
           (SELECT SUM(IF(x = 0, 1, 0)) FROM UNNEST(c.genotype) AS x), 0)) AS d
  FROM  `bigquery-public-data.human_genome_variants.1000_genomes_variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  LEFT  JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS s
         ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.`end`
  LIMIT 100
)
SELECT *,
       POWER(ABS(a*d - b*c) - ((a+b+c+d)/2.0), 2) * (a+b+c+d) /
       ((a+b)*(c+d)*(a+c)*(b+d)) AS chi2_yates
FROM counts;
```

```sql
--Description: Full chromosome-12 scan: Yates χ², keep variants whose expected
--counts ≥ 5 and χ² ≥ 29.71679.
WITH allele_counts AS (
  SELECT
    v.start,
    v.`end`,
    SUM(IF(s.Super_Population = 'EAS',
           (SELECT SUM(IF(g = 1, 1, 0)) FROM UNNEST(c.genotype) AS g), 0)) AS a,
    SUM(IF(s.Super_Population = 'EAS',
           (SELECT SUM(IF(g = 0, 1, 0)) FROM UNNEST(c.genotype) AS g), 0)) AS b,
    SUM(IF(s.Super_Population <> 'EAS',
           (SELECT SUM(IF(g = 1, 1, 0)) FROM UNNEST(c.genotype) AS g), 0)) AS c,
    SUM(IF(s.Super_Population <> 'EAS',
           (SELECT SUM(IF(g = 0, 1, 0)) FROM UNNEST(c.genotype) AS g), 0)) AS d
  FROM  `bigquery-public-data.human_genome_variants.1000_genomes_variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  LEFT  JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS s
         ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.`end`
),
stats AS (
  SELECT
    start,
    `end`,
    a, b, c, d,
    (a+b+c+d)                           AS N,
    (a+c)                               AS alt_total,
    (b+d)                               AS ref_total,
    (a+b)                               AS case_total,
    (c+d)                               AS ctrl_total
  FROM allele_counts
),
chi2 AS (
  SELECT
    start,
    `end`,
    POWER(ABS(a*d - b*c) - (N/2.0), 2) * N /
      ((a+b)*(c+d)*(a+c)*(b+d))        AS chi2_yates
  FROM stats
  WHERE N >= 20
    AND LEAST( alt_total * case_total / N,
               alt_total * ctrl_total / N,
               ref_total * case_total / N,
               ref_total * ctrl_total / N ) >= 5
)
SELECT start, `end`, chi2_yates
FROM chi2
WHERE chi2_yates >= 29.71679
ORDER BY chi2_yates DESC;
```

