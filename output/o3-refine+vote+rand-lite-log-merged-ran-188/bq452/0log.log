  SELECT
    v.start,
    v.end,
    CASE WHEN si.Super_Population = 'EAS' THEN 'EAS' ELSE 'OTH' END AS grp,
    SUM(CASE WHEN g = 0 THEN 1 ELSE 0 END) AS ref_cnt,
    SUM(CASE WHEN g  > 0 THEN 1 ELSE 0 END) AS alt_cnt
  FROM
    `bigquery-public-data.1000_genomes.variants` AS v
    CROSS JOIN UNNEST(v.call)                  AS c
    JOIN `bigquery-public-data.1000_genomes.sample_info` AS si
      ON si.Sample = c.call_set_name
    CROSS JOIN UNNEST(c.genotype) AS g
  WHERE
    v.reference_name = '12'
  GROUP BY
    v.start, v.end, grp
),
cont AS (
  -- Pivot to obtain 2×2 observed counts per variant
  SELECT
    start,
    end,
    MAX(IF(grp='EAS', alt_cnt, 0)) AS A,   -- alt in cases
    MAX(IF(grp='EAS', ref_cnt, 0)) AS B,   -- ref in cases
    MAX(IF(grp='OTH', alt_cnt, 0)) AS C,   -- alt in controls
    MAX(IF(grp='OTH', ref_cnt, 0)) AS D    -- ref in controls
  FROM allele_by_grp
  GROUP BY start, end
),
chi2 AS (
  -- Compute expected counts and Yates-corrected χ²
  SELECT
    start,
    end,
    A, B, C, D,
    (A+B)*(A+C)/(A+B+C+D) AS exp_A,
    (A+B)*(B+D)/(A+B+C+D) AS exp_B,
    (C+D)*(A+C)/(A+B+C+D) AS exp_C,
    (C+D)*(B+D)/(A+B+C+D) AS exp_D,
    (
      POW(ABS(A - ( (A+B)*(A+C)/(A+B+C+D) )) - 0.5, 2) / ( (A+B)*(A+C)/(A+B+C+D) ) +
      POW(ABS(B - ( (A+B)*(B+D)/(A+B+C+D) )) - 0.5, 2) / ( (A+B)*(B+D)/(A+B+C+D) ) +
      POW(ABS(C - ( (C+D)*(A+C)/(A+B+C+D) )) - 0.5, 2) / ( (C+D)*(A+C)/(A+B+C+D) ) +
      POW(ABS(D - ( (C+D)*(B+D)/(A+B+C+D) )) - 0.5, 2) / ( (C+D)*(B+D)/(A+B+C+D) )
    ) AS chi2_yates
  FROM cont
)
