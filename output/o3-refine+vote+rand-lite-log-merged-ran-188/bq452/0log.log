```sql
--Description: Build 2×2 contingency tables for every chromosome-12 variant using EAS samples as “cases” and all other super-populations as “controls”; compute Yates-corrected χ², retain variants whose four expected counts ≥ 5 and whose statistic ≥ 29.71679, and return their genomic coordinates with the χ² value.
WITH per_call AS (        -- allele counts for each variant-sample call
  SELECT
    v.start,
    v.end,
    CASE WHEN si.Super_Population = 'EAS' THEN 'EAS' ELSE 'OTH' END AS grp,
    /* number of alternate alleles in this call */
    (SELECT COUNTIF(g > 0) FROM UNNEST(c.genotype) AS g WHERE g IS NOT NULL) AS alt_cnt,
    /* number of reference alleles in this call */
    (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) AS g WHERE g IS NOT NULL) AS ref_cnt
  FROM
    `bigquery-public-data.1000_genomes.variants`      AS v
  CROSS JOIN UNNEST(v.call)                           AS c
  JOIN `bigquery-public-data.1000_genomes.sample_info` AS si
    ON si.Sample = c.call_set_name
  WHERE v.reference_name = '12'              -- chromosome 12 only
),
allele_by_grp AS (     -- aggregate alleles per variant & group
  SELECT
    start,
    end,
    grp,
    SUM(alt_cnt) AS alt_cnt,
    SUM(ref_cnt) AS ref_cnt
  FROM per_call
  GROUP BY start, end, grp
),
pivot AS (             -- observed 2×2 table
  SELECT
    start,
    end,
    COALESCE(MAX(IF(grp = 'EAS', alt_cnt, NULL)), 0) AS A,  -- alt in cases
    COALESCE(MAX(IF(grp = 'EAS', ref_cnt, NULL)), 0) AS B,  -- ref in cases
    COALESCE(MAX(IF(grp = 'OTH', alt_cnt, NULL)), 0) AS C,  -- alt in controls
    COALESCE(MAX(IF(grp = 'OTH', ref_cnt, NULL)), 0) AS D   -- ref in controls
  FROM allele_by_grp
  GROUP BY start, end
),
expected AS (          -- expected counts and χ² with Yates correction
  SELECT
    start,
    end,
    A, B, C, D,
    (A+B+C+D)                                   AS N,
    -- expected counts
    (A+B)*(A+C)/CAST(A+B+C+D AS FLOAT64) AS exp_A,
    (A+B)*(B+D)/CAST(A+B+C+D AS FLOAT64) AS exp_B,
    (C+D)*(A+C)/CAST(A+B+C+D AS FLOAT64) AS exp_C,
    (C+D)*(B+D)/CAST(A+B+C+D AS FLOAT64) AS exp_D
  FROM pivot
),
final AS (
  SELECT
    start,
    end,
    /* Yates-corrected χ² */
    (
      POW(ABS(CAST(A AS FLOAT64) - exp_A) - 0.5, 2)/exp_A +
      POW(ABS(CAST(B AS FLOAT64) - exp_B) - 0.5, 2)/exp_B +
      POW(ABS(CAST(C AS FLOAT64) - exp_C) - 0.5, 2)/exp_C +
      POW(ABS(CAST(D AS FLOAT64) - exp_D) - 0.5, 2)/exp_D
    ) AS chi2_yates
  FROM expected
  WHERE exp_A >= 5 AND exp_B >= 5 AND exp_C >= 5 AND exp_D >= 5   -- validity requirement
)
SELECT
  start,
  end,
  chi2_yates
FROM final
WHERE chi2_yates >= 29.71679
ORDER BY chi2_yates DESC;
```
