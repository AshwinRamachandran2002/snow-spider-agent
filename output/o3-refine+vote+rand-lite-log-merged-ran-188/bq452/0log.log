FROM   `spider2-public-data.1000_genomes.sample_info`
WHERE  `Super_Population` = 'EAS'
LIMIT  20;
```

```sql
--Description: 3) Take a quick look at one chromosome-12 variant to understand the nested `call` field
SELECT  reference_name, start, end, alternate_bases, call[OFFSET(0)] AS first_call
FROM    `spider2-public-data.1000_genomes.variants`
WHERE   reference_name = '12'
LIMIT   20;
```

```sql
--Description: 4) Unnest calls for a few chr-12 variants and join to sample_info to see allele counts sample-by-sample
SELECT  v.start,
        c.call_set_name                                        AS sample_id,
        si.Super_Population,
        (SELECT SUM(g) FROM UNNEST(c.genotype) AS g)           AS alt_alleles,
        2 - (SELECT SUM(g) FROM UNNEST(c.genotype) AS g)       AS ref_alleles
FROM    `spider2-public-data.1000_genomes.variants`  AS v,
        UNNEST(v.call)                                         AS c
JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
        ON si.Sample = c.call_set_name
WHERE   v.reference_name = '12'
LIMIT   20;
```

```sql
--Description: 5) Aggregate reference & alternate allele counts per variant **and** per EAS / non-EAS group
SELECT  v.start, v.end,
        CASE WHEN si.Super_Population = 'EAS' THEN 'EAS' ELSE 'OTH' END AS grp,
        SUM( (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) )            AS alt_cnt,
        SUM( 2 - (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) )        AS ref_cnt
FROM    `spider2-public-data.1000_genomes.variants`  AS v,
        UNNEST(v.call)                                                 AS c
JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
        ON si.Sample = c.call_set_name
WHERE   v.reference_name = '12'
GROUP BY v.start, v.end, grp
LIMIT   20;
```

```sql
--Description: 6) Pivot the previous result so that each variant has the four observed counts needed for a 2×2 table
WITH allele_by_grp AS (
  SELECT  v.start, v.end,
          CASE WHEN si.Super_Population = 'EAS' THEN 'EAS' ELSE 'OTH' END AS grp,
          SUM( (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) )            AS alt_cnt,
          SUM( 2 - (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) )        AS ref_cnt
  FROM    `spider2-public-data.1000_genomes.variants`  AS v,
          UNNEST(v.call)                                                 AS c
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
          ON si.Sample = c.call_set_name
  WHERE   v.reference_name = '12'
  GROUP BY v.start, v.end, grp
)
SELECT  start, end,
        MAX(IF(grp='EAS', alt_cnt, NULL)) AS A,     --alt in cases
        MAX(IF(grp='EAS', ref_cnt, NULL)) AS B,     --ref in cases
        MAX(IF(grp='OTH', alt_cnt, NULL)) AS C,     --alt in controls
        MAX(IF(grp='OTH', ref_cnt, NULL)) AS D      --ref in controls
FROM    allele_by_grp
GROUP BY start, end
LIMIT   20;
```

```sql
--Description: 7) Compute expected counts & Yates-corrected χ², but keep *all* variants for now
WITH cont AS (
  /* same pivot as step-6 */
  SELECT  start, end,
          MAX(IF(grp='EAS', alt_cnt, NULL)) AS A,
          MAX(IF(grp='EAS', ref_cnt, NULL)) AS B,
          MAX(IF(grp='OTH', alt_cnt, NULL)) AS C,
          MAX(IF(grp='OTH', ref_cnt, NULL)) AS D
  FROM (
      SELECT  v.start, v.end,
              CASE WHEN si.Super_Population = 'EAS' THEN 'EAS' ELSE 'OTH' END AS grp,
              SUM( (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) )            AS alt_cnt,
              SUM( 2 - (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) )        AS ref_cnt
      FROM    `spider2-public-data.1000_genomes.variants`  AS v,
              UNNEST(v.call)                                                 AS c
      JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
              ON si.Sample = c.call_set_name
      WHERE   v.reference_name = '12'
      GROUP BY v.start, v.end, grp
  )
  GROUP BY start, end
)
SELECT  *,
        /* totals */
        (A+C) AS alt_total, (B+D) AS ref_total, (A+B) AS case_total, (C+D) AS ctrl_total,
        /* expected counts */
        (A+B)*(A+C)/(A+B+C+D) AS exp_A,
        (A+B)*(B+D)/(A+B+C+D) AS exp_B,
        (C+D)*(A+C)/(A+B+C+D) AS exp_C,
        (C+D)*(B+D)/(A+B+C+D) AS exp_D,
        /* Yates corrected χ² */
        (
          POW(ABS(A - ((A+B)*(A+C)/(A+B+C+D))) - 0.5, 2)/((A+B)*(A+C)/(A+B+C+D)) +
          POW(ABS(B - ((A+B)*(B+D)/(A+B+C+D))) - 0.5, 2)/((A+B)*(B+D)/(A+B+C+D)) +
          POW(ABS(C - ((C+D)*(A+C)/(A+B+C+D))) - 0.5, 2)/((C+D)*(A+C)/(A+B+C+D)) +
          POW(ABS(D - ((C+D)*(B+D)/(A+B+C+D))) - 0.5, 2)/((C+D)*(B+D)/(A+B+C+D))
        ) AS chi2_yates
FROM    cont
LIMIT   20;
```

```sql
--Description: 8) Keep only variants whose every expected cell ≥ 5 (standard χ² assumption)
WITH cont AS ( /* same CTE as step-7 */ ... )
SELECT  start, end, chi2_yates
FROM    (
  SELECT  *,
          /* same χ² calculation as above */  -- omitted here for brevity
  FROM    cont
)
WHERE   exp_A >= 5 AND exp_B >= 5 AND exp_C >= 5 AND exp_D >= 5
LIMIT   20;
```

```sql
--Description: 9) Retrieve variants whose Yates-corrected χ² ≥ 29.71679 and sort descending
WITH cont AS ( /* same CTE as step-7 */ ... )
SELECT  start, end, chi2_yates
FROM    (
  SELECT  *,
          /* χ² calculation here too */  -- omitted for brevity
  FROM    cont
)
WHERE   exp_A >= 5 AND exp_B >= 5 AND exp_C >= 5 AND exp_D >= 5
  AND   chi2_yates >= 29.71679
ORDER BY chi2_yates DESC
LIMIT   20;
```

```sql
--Description: 10) Final answer: top chr-12 variants meeting the threshold (returning only asked columns)
WITH allele_by_grp AS (
  SELECT  v.start, v.end,
          CASE WHEN si.Super_Population = 'EAS' THEN 'EAS' ELSE 'OTH' END AS grp,
          SUM( (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) )            AS alt_cnt,
          SUM( 2 - (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) )        AS ref_cnt
  FROM    `spider2-public-data.1000_genomes.variants`  AS v,
          UNNEST(v.call)                                                 AS c
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
          ON si.Sample = c.call_set_name
  WHERE   v.reference_name = '12'
  GROUP BY v.start, v.end, grp
),
cont AS (
  SELECT  start, end,
          MAX(IF(grp='EAS', alt_cnt, NULL)) AS A,
          MAX(IF(grp='EAS', ref_cnt, NULL)) AS B,
          MAX(IF(grp='OTH', alt_cnt, NULL)) AS C,
          MAX(IF(grp='OTH', ref_cnt, NULL)) AS D
  FROM    allele_by_grp
  GROUP BY start, end
),
chi AS (
  SELECT  start, end, A, B, C, D,
          (A+B)*(A+C)/(A+B+C+D) AS exp_A,
          (A+B)*(B+D)/(A+B+C+D) AS exp_B,
          (C+D)*(A+C)/(A+B+C+D) AS exp_C,
          (C+D)*(B+D)/(A+B+C+D) AS exp_D,
          (
            POW(ABS(A - ((A+B)*(A+C)/(A+B+C+D))) - 0.5, 2)/((A+B)*(A+C)/(A+B+C+D)) +
            POW(ABS(B - ((A+B)*(B+D)/(A+B+C+D))) - 0.5, 2)/((A+B)*(B+D)/(A+B+C+D)) +
            POW(ABS(C - ((C+D)*(A+C)/(A+B+C+D))) - 0.5, 2)/((C+D)*(A+C)/(A+B+C+D)) +
            POW(ABS(D - ((C+D)*(B+D)/(A+B+C+D))) - 0.5, 2)/((C+D)*(B+D)/(A+B+C+D))
          ) AS chi2_yates
  FROM    cont
  WHERE   A IS NOT NULL AND B IS NOT NULL AND C IS NOT NULL AND D IS NOT NULL
          /* ensure expected >=5 */
          AND ( (A+B)*(A+C)/(A+B+C+D) ) >= 5
          AND ( (A+B)*(B+D)/(A+B+C+D) ) >= 5
          AND ( (C+D)*(A+C)/(A+B+C+D) ) >= 5
          AND ( (C+D)*(B+D)/(A+B+C+D) ) >= 5
)
SELECT  start, end, chi2_yates
FROM    chi
WHERE   chi2_yates >= 29.71679
ORDER BY chi2_yates DESC;
```
