```sql
--Description:  End-to-end reasoning and query in one block.
-- 1)  Explode every called genotype on chromosome 12 down to single alleles
--     (0 = reference, 1 = alternate) with UNNEST(..genotype).
-- 2)  Join each call to the public pedigree table to obtain the sample’s
--     Population label; we cannot use sample_info because of access limits.
-- 3)  Define “cases” as the five East-Asian populations (CDX CHB CHS JPT KHV);
--     everything else is a “control”.
-- 4)  Build a 2×2 contingency table for each variant:
--        a = alt alleles in cases
--        b = ref alleles in cases
--        c = alt alleles in controls
--        d = ref alleles in controls
-- 5)  Derive row / column totals, require every expected count ≥ 5
--     (χ² assumption) using SAFE_DIVIDE to avoid division-by-zero.
-- 6)  Compute Yates-corrected chi-square:
--         χ² = n·(|ad − bc| − 0.5·n)² / ((a+b)(c+d)(a+c)(b+d))
-- 7)  Return chr 12 variants whose χ² ≥ 29.71679, ordered by score.
WITH alleles AS (
  SELECT
    v.start      AS pos_start,
    v.end        AS pos_end,
    p.Population AS pop,
    g            AS allele                    -- 0 = ref, 1 = alt
  FROM  `spider2-public-data.1000_genomes.variants`  v
  CROSS JOIN UNNEST(v.call)      AS c
  CROSS JOIN UNNEST(c.genotype)  AS g
  JOIN  `spider2-public-data.1000_genomes.pedigree`  p
    ON  p.Individual_ID = c.call_set_name
  WHERE v.reference_name = '12'
    AND g IN (0,1)                                -- exclude missing (-1)
),
ct AS (
  SELECT
    pos_start,
    pos_end,
    SUM(CASE WHEN pop IN ('CDX','CHB','CHS','JPT','KHV') AND allele = 1 THEN 1 ELSE 0 END) AS a,
    SUM(CASE WHEN pop IN ('CDX','CHB','CHS','JPT','KHV') AND allele = 0 THEN 1 ELSE 0 END) AS b,
    SUM(CASE WHEN pop NOT IN ('CDX','CHB','CHS','JPT','KHV') AND allele = 1 THEN 1 ELSE 0 END) AS c,
    SUM(CASE WHEN pop NOT IN ('CDX','CHB','CHS','JPT','KHV') AND allele = 0 THEN 1 ELSE 0 END) AS d
  FROM alleles
  GROUP BY pos_start, pos_end
),
valid AS (
  SELECT *,
         (a+b)             AS n_cases,
         (c+d)             AS n_ctrl,
         (a+c)             AS n_alt,
         (b+d)             AS n_ref,
         (a+b+c+d)         AS n_tot
  FROM   ct
  WHERE  -- every expected count ≥ 5
         SAFE_DIVIDE((a+b)*(a+c), n_tot) >= 5
     AND SAFE_DIVIDE((a+b)*(b+d), n_tot) >= 5
     AND SAFE_DIVIDE((c+d)*(a+c), n_tot) >= 5
     AND SAFE_DIVIDE((c+d)*(b+d), n_tot) >= 5
),
chi2 AS (
  SELECT
    pos_start AS start,
    pos_end   AS end,
    (POWER(ABS(a*d - b*c) - 0.5*n_tot, 2) * n_tot) /
    ((a+b)*(c+d)*(a+c)*(b+d))       AS chi_sq
  FROM valid
)
SELECT start, end, chi_sq
FROM   chi2
WHERE  chi_sq >= 29.71679
ORDER  BY chi_sq DESC
LIMIT 20;
```
