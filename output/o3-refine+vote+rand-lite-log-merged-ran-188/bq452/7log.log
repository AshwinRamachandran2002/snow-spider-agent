```sql
--Description:  End-to-end query that (1) explodes every allele of every call on
--              chromosome 12, (2) tags each allele with its population via the
--              open-access pedigree table, (3) defines “cases” as the five East
--              Asian populations (CDX CHB CHS JPT KHV) and “controls” as all
--              others, (4) builds a 2×2 contingency table of alt/ref alleles in
--              cases vs. controls, (5) discards variants whose four expected
--              counts are < 5, (6) computes the Yates-corrected χ² statistic,
--              and (7) returns chr 12 variants whose χ² ≥ 29.71679.
WITH alleles AS (
  SELECT
      v.start,
      v.end,
      p.Population,
      g AS allele
  FROM   `spider2-public-data.1000_genomes.variants`   AS v
  CROSS  JOIN UNNEST(v.call)                           AS c
  CROSS  JOIN UNNEST(c.genotype)                       AS g
  JOIN   `spider2-public-data.1000_genomes.pedigree`   AS p
         ON p.Individual_ID = c.call_set_name
  WHERE  v.reference_name = '12'
         AND g IN (0,1)                -- ignore missing (-1) calls
),
counts AS (
  SELECT
      start,
      end,
      -- a = alt alleles in cases (EAS)
      SUM(CASE WHEN Population IN ('CDX','CHB','CHS','JPT','KHV') AND allele = 1 THEN 1 ELSE 0 END) AS a,
      -- b = ref alleles in cases
      SUM(CASE WHEN Population IN ('CDX','CHB','CHS','JPT','KHV') AND allele = 0 THEN 1 ELSE 0 END) AS b,
      -- c = alt alleles in controls (non-EAS)
      SUM(CASE WHEN Population NOT IN ('CDX','CHB','CHS','JPT','KHV') AND allele = 1 THEN 1 ELSE 0 END) AS c,
      -- d = ref alleles in controls
      SUM(CASE WHEN Population NOT IN ('CDX','CHB','CHS','JPT','KHV') AND allele = 0 THEN 1 ELSE 0 END) AS d
  FROM   alleles
  GROUP  BY start, end
),
valid AS (
  SELECT *,
         (a+b)           AS n_cases,
         (c+d)           AS n_ctrl,
         (a+c)           AS n_alt,
         (b+d)           AS n_ref,
         (a+b+c+d)       AS n_total
  FROM   counts
  WHERE  (a+b) > 0 AND (c+d) > 0 AND (a+c) > 0 AND (b+d) > 0    -- avoid /0
         AND ( (a+b)*(a+c) ) / (a+b+c+d) >= 5                   -- expected alt in cases
         AND ( (a+b)*(b+d) ) / (a+b+c+d) >= 5                   -- expected ref in cases
         AND ( (c+d)*(a+c) ) / (a+b+c+d) >= 5                   -- expected alt in ctrls
         AND ( (c+d)*(b+d) ) / (a+b+c+d) >= 5                   -- expected ref in ctrls
),
chi2 AS (
  SELECT
      start,
      end,
      -- Yates-corrected χ²
      (POWER(ABS(a*d - b*c) - 0.5 * n_total, 2) * n_total) /
      ( (a+b)*(c+d)*(a+c)*(b+d) )        AS chi_sq
  FROM valid
)
SELECT start, end, chi_sq
FROM   chi2
WHERE  chi_sq >= 29.71679
ORDER  BY chi_sq DESC
LIMIT 20;
