```sql
--Description: 5.  Join those exploded calls with the sample_info table so each
--              genotype can be tagged with its super-population label.
SELECT   v.`start`,
         v.`end`,
         c.`call_set_name`                 AS sample_id,
         si.`Super_Population`             AS super_pop,
         c.`genotype`
FROM     `spider2-public-data.1000_genomes.variants` AS v,
         UNNEST(v.`call`)                   AS c
JOIN     `spider2-public-data.1000_genomes.sample_info` AS si
       ON si.`Sample` = c.`call_set_name`
WHERE    v.`reference_name` = '12'
LIMIT 20;
```

```sql
--Description: 6.  For a single example variant, aggregate reference (0) and
--              alternate (1) allele counts in EAS cases vs. all controls.
WITH one_var AS (
  SELECT   v.`start`, v.`end`, c.`call_set_name` AS sample_id, c.`genotype`
  FROM     `spider2-public-data.1000_genomes.variants` AS v,
           UNNEST(v.`call`) AS c
  WHERE    v.`reference_name` = '12'
  LIMIT    1                 -- <-- pick one variant just for inspection
)
SELECT
  ov.`start`, ov.`end`,
  SUM(IF(si.`Super_Population`='EAS',
          (SELECT COUNTIF(g = 1) FROM UNNEST(ov.genotype) AS g), 0)) AS alt_cases,
  SUM(IF(si.`Super_Population`='EAS',
          (SELECT COUNTIF(g = 0) FROM UNNEST(ov.genotype) AS g), 0)) AS ref_cases,
  SUM(IF(si.`Super_Population`!='EAS',
          (SELECT COUNTIF(g = 1) FROM UNNEST(ov.genotype) AS g), 0)) AS alt_ctrl,
  SUM(IF(si.`Super_Population`!='EAS',
          (SELECT COUNTIF(g = 0) FROM UNNEST(ov.genotype) AS g), 0)) AS ref_ctrl
FROM     one_var AS ov
JOIN     `spider2-public-data.1000_genomes.sample_info` AS si
       ON si.`Sample` = ov.sample_id
GROUP BY ov.`start`, ov.`end`
LIMIT 20;
```

```sql
--Description: 7.  Produce allele counts (alt / ref in cases & controls)
--              for *all* chr 12 variants.
WITH exploded AS (
  SELECT   v.`start`, v.`end`,
           c.`call_set_name` AS sample_id,
           c.`genotype`
  FROM     `spider2-public-data.1000_genomes.variants` AS v,
           UNNEST(v.`call`) AS c
  WHERE    v.`reference_name` = '12'
),
allele_cnt AS (
  SELECT
      e.`start`,
      e.`end`,
      SUM(IF(si.`Super_Population`='EAS',
              (SELECT COUNTIF(g = 1) FROM UNNEST(e.genotype) AS g), 0)) AS a_alt_cases,
      SUM(IF(si.`Super_Population`='EAS',
              (SELECT COUNTIF(g = 0) FROM UNNEST(e.genotype) AS g), 0)) AS b_ref_cases,
      SUM(IF(si.`Super_Population`!='EAS',
              (SELECT COUNTIF(g = 1) FROM UNNEST(e.genotype) AS g), 0)) AS c_alt_ctrl,
      SUM(IF(si.`Super_Population`!='EAS',
              (SELECT COUNTIF(g = 0) FROM UNNEST(e.genotype) AS g), 0)) AS d_ref_ctrl
  FROM   exploded AS e
  JOIN   `spider2-public-data.1000_genomes.sample_info` AS si
    ON   si.`Sample` = e.sample_id
  GROUP BY e.`start`, e.`end`
)
SELECT * FROM allele_cnt
LIMIT 20;
```

```sql
--Description: 8.  On top of those allele counts, compute expected counts for
--              each of the four cells and keep only rows whose every expected
--              count is ≥ 5 (rule for chi-square validity).
WITH counts AS (
  -- (same CTE as previous query)
  SELECT
      e.`start`,
      e.`end`,
      SUM(IF(si.`Super_Population`='EAS',
              (SELECT COUNTIF(g = 1) FROM UNNEST(e.genotype) AS g), 0)) AS a,
      SUM(IF(si.`Super_Population`='EAS',
              (SELECT COUNTIF(g = 0) FROM UNNEST(e.genotype) AS g), 0)) AS b,
      SUM(IF(si.`Super_Population`!='EAS',
              (SELECT COUNTIF(g = 1) FROM UNNEST(e.genotype) AS g), 0)) AS c,
      SUM(IF(si.`Super_Population`!='EAS',
              (SELECT COUNTIF(g = 0) FROM UNNEST(e.genotype) AS g), 0)) AS d
  FROM   (
          SELECT v.`start`, v.`end`, c.`call_set_name`, c.`genotype`
          FROM   `spider2-public-data.1000_genomes.variants` AS v,
                 UNNEST(v.`call`) AS c
          WHERE  v.`reference_name` = '12'
        ) AS e
  JOIN   `spider2-public-data.1000_genomes.sample_info` AS si
    ON   si.`Sample` = e.`call_set_name`
  GROUP BY e.`start`, e.`end`
),
expected_ok AS (
  SELECT *,
         (a+b)           AS n_cases,
         (c+d)           AS n_ctrl,
         (a+c)           AS n_alt,
         (b+d)           AS n_ref,
         (a+b+c+d)       AS n_total
  FROM   counts
)
SELECT *
FROM   expected_ok
WHERE  (n_cases * n_alt) / n_total >= 5   -- expected alt in cases
  AND  (n_cases * n_ref) / n_total >= 5   -- expected ref in cases
  AND  (n_ctrl  * n_alt) / n_total >= 5   -- expected alt in controls
  AND  (n_ctrl  * n_ref) / n_total >= 5
LIMIT 20;
```

```sql
--Description: 9.  Compute Yates-corrected chi-square for those variants whose
--              expected counts are all ≥ 5, then preview variants with a high
--              chi-square statistic (≥ 29.71679 as requested).
WITH counts AS (  -- exactly as in query 8
  SELECT
      e.`start`,
      e.`end`,
      SUM(IF(si.`Super_Population`='EAS',
              (SELECT COUNTIF(g = 1) FROM UNNEST(e.genotype) AS g), 0)) AS a,
      SUM(IF(si.`Super_Population`='EAS',
              (SELECT COUNTIF(g = 0) FROM UNNEST(e.genotype) AS g), 0)) AS b,
      SUM(IF(si.`Super_Population`!='EAS',
              (SELECT COUNTIF(g = 1) FROM UNNEST(e.genotype) AS g), 0)) AS c,
      SUM(IF(si.`Super_Population`!='EAS',
              (SELECT COUNTIF(g = 0) FROM UNNEST(e.genotype) AS g), 0)) AS d
  FROM   (
          SELECT v.`start`, v.`end`, c.`call_set_name`, c.`genotype`
          FROM   `spider2-public-data.1000_genomes.variants` AS v,
                 UNNEST(v.`call`) AS c
          WHERE  v.`reference_name` = '12'
        ) AS e
  JOIN   `spider2-public-data.1000_genomes.sample_info` AS si
    ON   si.`Sample` = e.`call_set_name`
  GROUP BY e.`start`, e.`end`
),
filtered AS (
  SELECT *,
         (a+b)           AS n_cases,
         (c+d)           AS n_ctrl,
         (a+c)           AS n_alt,
         (b+d)           AS n_ref,
         (a+b+c+d)       AS n_total
  FROM   counts
  WHERE  ( (a+b)*(c+d)*(a+c)*(b+d) ) > 0      -- avoid division by zero
),
chi2 AS (
  SELECT
      `start`,
      `end`,
      a, b, c, d,
      n_total,
      -- Yates corrected χ² :  n*(|ad−bc| − 0.5*n)² / ((a+b)(c+d)(a+c)(b+d))
      (POWER(ABS(a*d - b*c) - 0.5 * n_total, 2) * n_total) /
      ( (a+b)*(c+d)*(a+c)*(b+d) )                      AS chi_sq
  FROM  filtered
)
SELECT `start`, `end`, chi_sq
FROM   chi2
WHERE  chi_sq >= 29.71679
ORDER BY chi_sq DESC
LIMIT 20;
```

```sql
--Description: 10. FINAL ANSWER — return the chr 12 variants whose Yates-
--               corrected chi-square ≥ 29.71679 (all expected counts ≥ 5),
--               sorted by score (top variants first).
WITH exploded AS (
  SELECT   v.`start`, v.`end`,
           c.`call_set_name` AS sample_id,
           c.`genotype`
  FROM     `spider2-public-data.1000_genomes.variants` AS v,
           UNNEST(v.`call`) AS c
  WHERE    v.`reference_name` = '12'
),
allele_cnt AS (
  SELECT
      e.`start`,
      e.`end`,
      SUM(IF(si.`Super_Population`='EAS',
              (SELECT COUNTIF(g = 1) FROM UNNEST(e.genotype) AS g), 0)) AS a,
      SUM(IF(si.`Super_Population`='EAS',
              (SELECT COUNTIF(g = 0) FROM UNNEST(e.genotype) AS g), 0)) AS b,
      SUM(IF(si.`Super_Population`!='EAS',
              (SELECT COUNTIF(g = 1) FROM UNNEST(e.genotype) AS g), 0)) AS c,
      SUM(IF(si.`Super_Population`!='EAS',
              (SELECT COUNTIF(g = 0) FROM UNNEST(e.genotype) AS g), 0)) AS d
  FROM   exploded AS e
  JOIN   `spider2-public-data.1000_genomes.sample_info` AS si
    ON   si.`Sample` = e.sample_id
  GROUP BY e.`start`, e.`end`
),
valid AS (
  SELECT *,
         (a+b)           AS n_cases,
         (c+d)           AS n_ctrl,
         (a+c)           AS n_alt,
         (b+d)           AS n_ref,
         (a+b+c+d)       AS n_total
  FROM   allele_cnt
  WHERE  ( (a+b)*(c+d)*(a+c)*(b+d) ) > 0
         -- expected counts ≥ 5
         AND (n_cases * n_alt) / n_total >= 5
         AND (n_cases * n_ref) / n_total >= 5
         AND (n_ctrl  * n_alt) / n_total >= 5
         AND (n_ctrl  * n_ref) / n_total >= 5
),
chi2 AS (
  SELECT
      `start`,
      `end`,
      (POWER(ABS(a*d - b*c) - 0.5 * n_total, 2) * n_total) /
      ( (a+b)*(c+d)*(a+c)*(b+d) )  AS chi_sq
  FROM  valid
)
SELECT  `start`,
        `end`,
        chi_sq
FROM    chi2
WHERE   chi_sq >= 29.71679
ORDER BY chi_sq DESC
LIMIT   20;
```
