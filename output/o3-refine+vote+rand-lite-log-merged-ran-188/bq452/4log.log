```sql
-- 4. Description:  Unnest a single variant’s calls (first row that comes back)
--    and join to the sample_info table to see what the genotype array and
--    super-population look like side-by-side.
SELECT
  v.`start`,
  c.`call_set_name`                 AS sample,
  si.`Super_Population`             AS super_pop,
  c.`genotype`
FROM `spider2-public-data.1000_genomes.variants` AS v
JOIN UNNEST(v.`call`) AS c
LEFT JOIN `spider2-public-data.1000_genomes.sample_info` AS si
       ON si.`Sample` = c.`call_set_name`
WHERE v.`reference_name` = '12'
LIMIT 20;
```

```sql
-- 5. Description:  For a small slice of chromosome-12 variants, turn the
--    genotype array into individual allele counts (0 = ref, 1 = alt) for each
--    sample so we can later aggregate them by case / control.
SELECT
  v.`start`,
  c.`call_set_name`  AS sample,
  si.`Super_Population` AS super_pop,
  a AS allele
FROM `spider2-public-data.1000_genomes.variants` AS v
JOIN UNNEST(v.`call`) AS c
JOIN UNNEST(c.`genotype`) AS a
LEFT JOIN `spider2-public-data.1000_genomes.sample_info` AS si
       ON si.`Sample` = c.`call_set_name`
WHERE v.`reference_name` = '12'
LIMIT 20;
```

```sql
-- 6. Description:  Aggregate, for each variant, the raw reference / alternate
--    allele counts in CASES (EAS) and CONTROLS (non-EAS).
SELECT
  v.`start`,
  v.`end`,
  SUM(CASE WHEN si.`Super_Population` = 'EAS'  AND al = 0 THEN 1 ELSE 0 END) AS a_ref,
  SUM(CASE WHEN si.`Super_Population` = 'EAS'  AND al = 1 THEN 1 ELSE 0 END) AS b_alt,
  SUM(CASE WHEN si.`Super_Population` <> 'EAS' AND al = 0 THEN 1 ELSE 0 END) AS c_ref,
  SUM(CASE WHEN si.`Super_Population` <> 'EAS' AND al = 1 THEN 1 ELSE 0 END) AS d_alt
FROM `spider2-public-data.1000_genomes.variants` AS v
JOIN UNNEST(v.`call`)  AS c
JOIN UNNEST(c.`genotype`) AS al
LEFT JOIN `spider2-public-data.1000_genomes.sample_info` AS si
       ON si.`Sample` = c.`call_set_name`
WHERE v.`reference_name` = '12'
GROUP BY v.`start`, v.`end`
LIMIT 20;
```

```sql
-- 7. Description:  For the same slice, calculate totals & expected counts
--    so we can check the ≥5 rule (Yates condition).
SELECT
  *,
  (a_ref+b_alt+c_ref+d_alt)                             AS N,
  (a_ref+b_alt)                                         AS row1,
  (c_ref+d_alt)                                         AS row2,
  (a_ref+c_ref)                                         AS col1,
  (b_alt+d_alt)                                         AS col2
FROM (
  -- reuse query 6 as a sub-select
  SELECT
    v.`start`,
    v.`end`,
    SUM(CASE WHEN si.`Super_Population` = 'EAS'  AND al = 0 THEN 1 ELSE 0 END) AS a_ref,
    SUM(CASE WHEN si.`Super_Population` = 'EAS'  AND al = 1 THEN 1 ELSE 0 END) AS b_alt,
    SUM(CASE WHEN si.`Super_Population` <> 'EAS' AND al = 0 THEN 1 ELSE 0 END) AS c_ref,
    SUM(CASE WHEN si.`Super_Population` <> 'EAS' AND al = 1 THEN 1 ELSE 0 END) AS d_alt
  FROM `spider2-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.`call`)  AS c
  JOIN UNNEST(c.`genotype`) AS al
  LEFT JOIN `spider2-public-data.1000_genomes.sample_info` AS si
         ON si.`Sample` = c.`call_set_name`
  WHERE v.`reference_name` = '12'
  GROUP BY v.`start`, v.`end`
)
LIMIT 20;
```

```sql
-- 8. Description:  Compute the Yates-corrected chi-squared statistic and
--    keep only rows where every expected count is at least 5.
SELECT
  *,
  -- Yates-corrected chi-square
  POW(ABS(a_ref*d_alt - b_alt*c_ref) - N/2.0, 2) * N /
  (row1 * row2 * col1 * col2)                       AS chi_sq
FROM (
  -- sub-select identical to query 7 (for brevity)
  SELECT
    v.`start`,
    v.`end`,
    SUM(CASE WHEN si.`Super_Population` = 'EAS'  AND al = 0 THEN 1 ELSE 0 END) AS a_ref,
    SUM(CASE WHEN si.`Super_Population` = 'EAS'  AND al = 1 THEN 1 ELSE 0 END) AS b_alt,
    SUM(CASE WHEN si.`Super_Population` <> 'EAS' AND al = 0 THEN 1 ELSE 0 END) AS c_ref,
    SUM(CASE WHEN si.`Super_Population` <> 'EAS' AND al = 1 THEN 1 ELSE 0 END) AS d_alt,
    COUNT(1)                                                                   AS total_alleles
  FROM `spider2-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.`call`)  AS c
  JOIN UNNEST(c.`genotype`) AS al
  LEFT JOIN `spider2-public-data.1000_genomes.sample_info` AS si
         ON si.`Sample` = c.`call_set_name`
  WHERE v.`reference_name` = '12'
  GROUP BY v.`start`, v.`end`
) WITH
  N         AS (a_ref+b_alt+c_ref+d_alt),
  row1      AS (a_ref+b_alt),
  row2      AS (c_ref+d_alt),
  col1      AS (a_ref+c_ref),
  col2      AS (b_alt+d_alt)
HAVING
  (row1*col1)/N >= 5 AND (row1*col2)/N >= 5
  AND (row2*col1)/N >= 5 AND (row2*col2)/N >= 5
LIMIT 20;
```

```sql
-- 9. Description:  Add a WHERE-filter to show only variants whose Yates-
--    corrected chi-square statistic meets / exceeds the given threshold.
SELECT
  `start`,
  `end`,
  chi_sq
FROM (
  -- query 8 without LIMIT, reused as a sub-select
  SELECT
    v.`start`,
    v.`end`,
    SUM(CASE WHEN si.`Super_Population` = 'EAS'  AND al = 0 THEN 1 ELSE 0 END) AS a_ref,
    SUM(CASE WHEN si.`Super_Population` = 'EAS'  AND al = 1 THEN 1 ELSE 0 END) AS b_alt,
    SUM(CASE WHEN si.`Super_Population` <> 'EAS' AND al = 0 THEN 1 ELSE 0 END) AS c_ref,
    SUM(CASE WHEN si.`Super_Population` <> 'EAS' AND al = 1 THEN 1 ELSE 0 END) AS d_alt,
    COUNT(1)                                                                   AS total_alleles
  FROM `spider2-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.`call`)  AS c
  JOIN UNNEST(c.`genotype`) AS al
  LEFT JOIN `spider2-public-data.1000_genomes.sample_info` AS si
         ON si.`Sample` = c.`call_set_name`
  WHERE v.`reference_name` = '12'
  GROUP BY v.`start`, v.`end`
) CROSS JOIN (
  SELECT
    (a_ref+b_alt+c_ref+d_alt)                             AS N,
    (a_ref+b_alt)                                         AS row1,
    (c_ref+d_alt)                                         AS row2,
    (a_ref+c_ref)                                         AS col1,
    (b_alt+d_alt)                                         AS col2
)
WHERE
  -- Yates-corrected chi-square
  POW(ABS(a_ref*d_alt - b_alt*c_ref) - N/2.0, 2) * N /
  (row1 * row2 * col1 * col2) >= 29.71679
LIMIT 20;
```

```sql
-- 10. Description (FINAL ANSWER):  Produce the chromosome-12 variants
--     whose Yates-corrected chi-square is ≥ 29.71679, ordered from highest
--     to lowest score, returning the start, end, and chi-square statistic.
SELECT
  `start`,
  `end`,
  chi_sq
FROM (
  SELECT
    v.`start`,
    v.`end`,
    SUM(CASE WHEN si.`Super_Population` = 'EAS'  AND al = 0 THEN 1 ELSE 0 END) AS a_ref,
    SUM(CASE WHEN si.`Super_Population` = 'EAS'  AND al = 1 THEN 1 ELSE 0 END) AS b_alt,
    SUM(CASE WHEN si.`Super_Population` <> 'EAS' AND al = 0 THEN 1 ELSE 0 END) AS c_ref,
    SUM(CASE WHEN si.`Super_Population` <> 'EAS' AND al = 1 THEN 1 ELSE 0 END) AS d_alt
  FROM `spider2-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.`call`)  AS c
  JOIN UNNEST(c.`genotype`) AS al
  LEFT JOIN `spider2-public-data.1000_genomes.sample_info` AS si
         ON si.`Sample` = c.`call_set_name`
  WHERE v.`reference_name` = '12'
  GROUP BY v.`start`, v.`end`
) CROSS JOIN (
  SELECT
    (a_ref+b_alt+c_ref+d_alt) AS N,
    (a_ref+b_alt)             AS row1,
    (c_ref+d_alt)             AS row2,
    (a_ref+c_ref)             AS col1,
    (b_alt+d_alt)             AS col2
) WITH
  chi_sq AS (
    POW(ABS(a_ref*d_alt - b_alt*c_ref) - N/2.0, 2) * N /
    (row1 * row2 * col1 * col2)
)
WHERE
  -- Expected counts ≥5 for all 4 cells
  (row1*col1)/N >= 5 AND (row1*col2)/N >= 5
  AND (row2*col1)/N >= 5 AND (row2*col2)/N >= 5
  AND chi_sq >= 29.71679
ORDER BY chi_sq DESC
LIMIT 20;
```
