```sql
--Description:  On chromosome 12, compute Yates-corrected χ² statistics that compare
--              allele counts between CASES (samples whose `Super_Population` = 'EAS')
--              and CONTROLS (all other samples).  Steps:
--              1)  Unnest every allele (0 = reference, 1 = alternate) from the
--                 `genotype` arrays in `variants.call`.
--              2)  Join each allele to its sample’s super-population in
--                 `sample_info`, counting ref / alt alleles separately for cases
--                 and controls.
--              3)  Derive the 2×2 contingency table (A=cases_ref, B=cases_alt,
--                 C=controls_ref, D=controls_alt) and total N.
--              4)  Apply Yates’s continuity-corrected χ² formula:
--                 χ² = N * (|AD-BC| - N/2)² / (row1*row2*col1*col2)
--              5)  Keep only variants whose expected counts in every cell are ≥ 5
--                 and whose χ² ≥ 29.71679, then list their start/end positions and
--                 χ² score, ordered from highest to lowest.
WITH allele_counts AS (
  SELECT
    v.start,
    v.end,
    SUM(CASE WHEN si.Super_Population = 'EAS'  AND allele = 0 THEN 1 ELSE 0 END) AS cases_ref,
    SUM(CASE WHEN si.Super_Population = 'EAS'  AND allele = 1 THEN 1 ELSE 0 END) AS cases_alt,
    SUM(CASE WHEN si.Super_Population <> 'EAS' AND allele = 0 THEN 1 ELSE 0 END) AS controls_ref,
    SUM(CASE WHEN si.Super_Population <> 'EAS' AND allele = 1 THEN 1 ELSE 0 END) AS controls_alt
  FROM `spider2-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.call) AS c
  JOIN UNNEST(c.genotype) AS allele
  JOIN `spider2-public-data.1000_genomes.sample_info` AS si
    ON si.Sample = c.call_set_name
  WHERE v.reference_name = '12'
    AND allele IN (0, 1)            -- skip missing values (-1)
  GROUP BY v.start, v.end
),
chi_table AS (
  SELECT
    start,
    end,
    cases_ref  AS A,
    cases_alt  AS B,
    controls_ref AS C,
    controls_alt AS D,
    (cases_ref + cases_alt + controls_ref + controls_alt) AS N
  FROM allele_counts
),
stats AS (
  SELECT
    start,
    end,
    A, B, C, D,
    N,
    (A+B)                         AS row_cases,
    (C+D)                         AS row_controls,
    (A+C)                         AS col_ref,
    (B+D)                         AS col_alt,
    -- Yates-corrected χ²
    POW(ABS(A*D - B*C) - N/2.0, 2) * N /
    ((A+B) * (C+D) * (A+C) * (B+D)) AS chi_sq
  FROM chi_table
)
SELECT
  start,
  end,
  chi_sq
FROM stats
WHERE
      (row_cases * col_ref)   / N >= 5
  AND (row_cases * col_alt)   / N >= 5
  AND (row_controls * col_ref)/ N >= 5
  AND (row_controls * col_alt)/ N >= 5
  AND chi_sq >= 29.71679
ORDER BY chi_sq DESC
LIMIT 100;
```
