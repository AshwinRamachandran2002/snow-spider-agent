```sql
--Description:  Explode genotype arrays into individual allele rows (0 = ref, 1 = alt)
--              for a handful of chromosome-12 variants, together with each sample’s
--              super-population.  Uses `c.name` (sample ID) instead of the nonexistent
--              `call_set_name`.
SELECT
  v.start_position,
  c.name                      AS sample,
  si.super_population         AS super_pop,
  allele
FROM `bigquery-public-data.human_genome_variants.1000_genomes_phase_3_variants_20150220` AS v
JOIN UNNEST(v.call)     AS c
JOIN UNNEST(c.genotype) AS allele
LEFT JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS si
       ON si.sample = c.name
WHERE v.reference_name = '12'
LIMIT 20;
```

```sql
--Description:  Build the 2×2 contingency table (A,B,C,D) of ref/alt allele counts
--              in CASES (EAS) vs CONTROLS (non-EAS) for each chromosome-12 variant.
WITH allele_rows AS (
  SELECT
    v.start_position,
    v.end_position,
    allele,
    si.super_population
  FROM `bigquery-public-data.human_genome_variants.1000_genomes_phase_3_variants_20150220` AS v
  JOIN UNNEST(v.call)     AS c
  JOIN UNNEST(c.genotype) AS allele
  LEFT JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS si
         ON si.sample = c.name
  WHERE v.reference_name = '12'
)
SELECT
  start_position,
  end_position,
  SUM(CASE WHEN super_population = 'EAS'  AND allele = 0 THEN 1 ELSE 0 END) AS a_ref,
  SUM(CASE WHEN super_population = 'EAS'  AND allele = 1 THEN 1 ELSE 0 END) AS b_alt,
  SUM(CASE WHEN super_population <> 'EAS' AND allele = 0 THEN 1 ELSE 0 END) AS c_ref,
  SUM(CASE WHEN super_population <> 'EAS' AND allele = 1 THEN 1 ELSE 0 END) AS d_alt
FROM allele_rows
GROUP BY start_position, end_position
LIMIT 20;
```

```sql
--Description:  Add totals and marginal sums for each chr-12 variant so we can verify
--              that every expected count (Yates condition) is ≥ 5.
WITH counts AS (
  SELECT
    v.start_position,
    v.end_position,
    SUM(CASE WHEN si.super_population = 'EAS'  AND allele = 0 THEN 1 ELSE 0 END) AS a_ref,
    SUM(CASE WHEN si.super_population = 'EAS'  AND allele = 1 THEN 1 ELSE 0 END) AS b_alt,
    SUM(CASE WHEN si.super_population <> 'EAS' AND allele = 0 THEN 1 ELSE 0 END) AS c_ref,
    SUM(CASE WHEN si.super_population <> 'EAS' AND allele = 1 THEN 1 ELSE 0 END) AS d_alt
  FROM `bigquery-public-data.human_genome_variants.1000_genomes_phase_3_variants_20150220` AS v
  JOIN UNNEST(v.call)     AS c
  JOIN UNNEST(c.genotype) AS allele
  LEFT JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS si
         ON si.sample = c.name
  WHERE v.reference_name = '12'
  GROUP BY v.start_position, v.end_position
)
SELECT
  *,
  (a_ref+b_alt+c_ref+d_alt) AS N,
  (a_ref+b_alt)             AS row_cases,
  (c_ref+d_alt)             AS row_controls,
  (a_ref+c_ref)             AS col_ref,
  (b_alt+d_alt)             AS col_alt
FROM counts
LIMIT 20;
```

