--    versus the rest; this gives a feel for the case / control sizes.
SELECT
  SUM(CASE WHEN `Super_Population` = 'EAS' THEN 1 ELSE 0 END) AS eas_samples,
  SUM(CASE WHEN `Super_Population` <> 'EAS' THEN 1 ELSE 0 END) AS other_samples
FROM `spider2-public-data.1000_genomes.sample_info`
LIMIT 20;
