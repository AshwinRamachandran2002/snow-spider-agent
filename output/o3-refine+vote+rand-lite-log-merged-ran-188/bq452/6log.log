```sql
--Description: 7)  Keep only variants whose EXPECTED allele counts are ≥ 5 in
--                every cell of the 2×2 table (Yates requirement)
WITH cnt AS (
  SELECT  v.start, v.end,
          SUM(IF(grp='case'    AND allele=1,1,0)) AS a,
          SUM(IF(grp='case'    AND allele=0,1,0)) AS b,
          SUM(IF(grp='control' AND allele=1,1,0)) AS c,
          SUM(IF(grp='control' AND allele=0,1,0)) AS d
  FROM (
        SELECT  v.start, v.end,
                CASE WHEN s.Super_Population='EAS' THEN 'case' ELSE 'control' END AS grp,
                gt AS allele
        FROM    `spider2-public-data.1000_genomes.variants`  AS v
        JOIN    UNNEST(v.call)     AS c
        JOIN    UNNEST(c.genotype) AS gt
        JOIN    `spider2-public-data.1000_genomes.sample_info` AS s
               ON s.Sample = c.call_set_name
        WHERE   v.reference_name='12'
          AND   ARRAY_LENGTH(v.alternate_bases)=1
          AND   gt>=0
       ) x
  GROUP BY start,end
)
SELECT  start, end, a, b, c, d,
        (a+b)*(a+c)/(a+b+c+d)  AS exp_case_alt,
        (a+b)*(b+d)/(a+b+c+d)  AS exp_case_ref,
        (c+d)*(a+c)/(a+b+c+d)  AS exp_ctrl_alt,
        (c+d)*(b+d)/(a+b+c+d)  AS exp_ctrl_ref
FROM    cnt
WHERE   exp_case_alt>=5 AND exp_case_ref>=5
   AND  exp_ctrl_alt>=5 AND exp_ctrl_ref>=5
LIMIT   20;
```

```sql
--Description: 8)  Compute the Yates-corrected χ² statistic for all eligible
--                chromosome-12 variants (show 20 rows)
WITH tbl AS (
  SELECT  v.start, v.end,
          SUM(IF(grp='case'    AND allele=1,1,0)) AS a,
          SUM(IF(grp='case'    AND allele=0,1,0)) AS b,
          SUM(IF(grp='control' AND allele=1,1,0)) AS c,
          SUM(IF(grp='control' AND allele=0,1,0)) AS d
  FROM (
        SELECT  v.start, v.end,
                CASE WHEN s.Super_Population='EAS' THEN 'case' ELSE 'control' END AS grp,
                gt AS allele
        FROM    `spider2-public-data.1000_genomes.variants`  AS v
        JOIN    UNNEST(v.call)     AS c
        JOIN    UNNEST(c.genotype) AS gt
        JOIN    `spider2-public-data.1000_genomes.sample_info` AS s
               ON s.Sample = c.call_set_name
        WHERE   v.reference_name='12'
          AND   ARRAY_LENGTH(v.alternate_bases)=1
          AND   gt>=0
       ) z
  GROUP BY start,end
  HAVING  (a+b)>0 AND (c+d)>0 AND (a+c)>0 AND (b+d)>0         -- safety
)
SELECT  start, end,
        a,b,c,d,
        -- Yates χ²  :  χ² = N*(|ad-bc|-N/2)² /((a+b)(c+d)(a+c)(b+d))
        ( (a+b+c+d) * POW(ABS(a*d - b*c) - ( (a+b+c+d)/2.0 ), 2)
          / ( (a+b)*(c+d)*(a+c)*(b+d) ) )         AS chi_sq
FROM    tbl
LIMIT   20;
```

```sql
--Description: 9)  Retrieve variants whose Yates-corrected χ² ≥ 29.71679
--                (P≈5×10⁻⁸ with 1 df) – show 20 rows
WITH tbl AS (
  SELECT  v.start, v.end,
          SUM(IF(grp='case'    AND allele=1,1,0)) AS a,
          SUM(IF(grp='case'    AND allele=0,1,0)) AS b,
          SUM(IF(grp='control' AND allele=1,1,0)) AS c,
          SUM(IF(grp='control' AND allele=0,1,0)) AS d
  FROM (
        SELECT  v.start, v.end,
                CASE WHEN s.Super_Population='EAS' THEN 'case' ELSE 'control' END AS grp,
                gt AS allele
        FROM    `spider2-public-data.1000_genomes.variants`  AS v
        JOIN    UNNEST(v.call)     AS c
        JOIN    UNNEST(c.genotype) AS gt
        JOIN    `spider2-public-data.1000_genomes.sample_info` AS s
               ON s.Sample = c.call_set_name
        WHERE   v.reference_name='12'
          AND   ARRAY_LENGTH(v.alternate_bases)=1
          AND   gt>=0
       ) allg
  GROUP BY start,end
  HAVING  (a+b)>0 AND (c+d)>0 AND (a+c)>0 AND (b+d)>0
),
chi AS (
  SELECT  start, end,
          ( (a+b+c+d) * POW(ABS(a*d - b*c) - ( (a+b+c+d)/2.0 ), 2)
            / ( (a+b)*(c+d)*(a+c)*(b+d) ) )  AS chi_sq
  FROM    tbl
  WHERE   ( (a+b)*(c+d)*(a+c)*(b+d) ) >= 25   -- ensures all expected ≥5
)
SELECT  start, end, chi_sq
FROM    chi
WHERE   chi_sq >= 29.71679
ORDER BY chi_sq DESC
LIMIT   20;
```

