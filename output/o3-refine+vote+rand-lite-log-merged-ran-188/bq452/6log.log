```sql
--Description:
-- Single-query pipeline to discover chromosome-12 variants whose allele
-- frequencies differ significantly between East-Asian (EAS) samples
-- (“cases”) and all other super-populations (“controls”), using
-- Yates-corrected χ² ≥ 29.71679.
--
-- 1) alleles  – explode every allele (0 = ref, 1 = alt) from every
--               genotype call and tag the sample as EAS (case) or Other
--               (control).
-- 2) counts   – build the 2×2 contingency table (a,b,c,d) per variant and
--               keep only those for which the four EXPECTED cell counts
--               are all ≥ 5 (needed for χ² validity).
-- 3) chi      – compute Yates-corrected χ²:
--                  χ² = N·(|ad − bc| − N/2)² / ((a+b)(c+d)(a+c)(b+d)),
--               where N = a+b+c+d.
-- 4) final    – return start/end positions and χ² for variants meeting
--               the genome-wide threshold.
WITH alleles AS (
  SELECT
    v.start AS var_start,
    v.end   AS var_end,
    IF(si.Super_Population = 'EAS', 1, 0) AS is_eas,   -- 1 = case, 0 = control
    gt AS allele                                        -- 0 = ref, 1 = alt
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  CROSS JOIN UNNEST(c.genotype) AS gt
  JOIN `spider2-public-data.1000_genomes.sample_info` AS si
    ON si.Sample = c.call_set_name
  WHERE v.reference_name = '12'                -- chromosome 12
    AND ARRAY_LENGTH(v.alternate_bases) = 1    -- bi-allelic variants
    AND gt >= 0                                -- ignore missing (-1)
),
counts AS (
  SELECT
    var_start,
    var_end,
    SUM(IF(is_eas = 1 AND allele = 1, 1, 0)) AS a,   -- cases alt
    SUM(IF(is_eas = 1 AND allele = 0, 1, 0)) AS b,   -- cases ref
    SUM(IF(is_eas = 0 AND allele = 1, 1, 0)) AS c,   -- ctrls alt
    SUM(IF(is_eas = 0 AND allele = 0, 1, 0)) AS d    -- ctrls ref
  FROM alleles
  GROUP BY var_start, var_end
  HAVING
    -- Expected counts  ≥ 5  in all four cells
    (a+b)*(a+c)/(a+b+c+d) >= 5 AND
    (a+b)*(b+d)/(a+b+c+d) >= 5 AND
    (c+d)*(a+c)/(a+b+c+d) >= 5 AND
    (c+d)*(b+d)/(a+b+c+d) >= 5
),
chi AS (
  SELECT
    var_start,
    var_end,
    ( (a+b+c+d) *
      POW(ABS(a*d - b*c) - ((a+b+c+d)/2.0), 2) /
      ((a+b)*(c+d)*(a+c)*(b+d))
    ) AS chi_sq
  FROM counts
)
SELECT
  var_start AS start_position,
  var_end   AS end_position,
  chi_sq
FROM chi
