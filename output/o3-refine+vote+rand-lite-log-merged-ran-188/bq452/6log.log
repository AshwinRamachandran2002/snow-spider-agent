```sql
--Description:
-- One-pass query that finds chromosome-12 variants whose association with the
-- East-Asian super-population (EAS = “cases”, everyone else = “controls”)
-- is genome-wide significant (Yates χ² ≥ 29.71679).
--
-- 1) alleles  – explode every allele (0 = ref, 1 = alt) for every genotype and
--               tag the sample as EAS or non-EAS.
-- 2) counts   – build the 2×2 table (a,b,c,d) per variant.  In the HAVING clause
--               we keep only variants whose four *expected* cell counts are all
--               ≥ 5, which is required for the χ² approximation with Yates’s
--               continuity correction to be valid.
-- 3) chi      – compute the Yates-corrected statistic:
--                   χ² = N·(|ad−bc| − N/2)² / ((a+b)(c+d)(a+c)(b+d)),
--               where N = a+b+c+d.
-- 4) final    – list start, end and χ² for variants that clear the threshold.
WITH alleles AS (
  SELECT
    v.start AS start_pos,
    v.end   AS end_pos,
    CASE WHEN s.Super_Population = 'EAS' THEN 1 ELSE 0 END AS is_eas,
    gt AS allele                               -- 0 = ref, 1 = alt
  FROM  `spider2-public-data.1000_genomes.variants`      AS v
  JOIN  UNNEST(v.call)                                   AS c
  JOIN  UNNEST(c.genotype)                               AS gt
  JOIN  `spider2-public-data.1000_genomes.sample_info`   AS s
        ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'                -- chromosome 12
    AND ARRAY_LENGTH(v.alternate_bases) = 1    -- bi-allelic variants only
    AND gt >= 0                                -- ignore missing alleles
),
counts AS (
  SELECT
    start_pos,
    end_pos,
    SUM(IF(is_eas = 1 AND allele = 1, 1, 0)) AS a,   -- EAS alt
    SUM(IF(is_eas = 1 AND allele = 0, 1, 0)) AS b,   -- EAS ref
    SUM(IF(is_eas = 0 AND allele = 1, 1, 0)) AS c,   -- non-EAS alt
    SUM(IF(is_eas = 0 AND allele = 0, 1, 0)) AS d    -- non-EAS ref
  FROM alleles
  GROUP BY start_pos, end_pos
  HAVING
    -- expected counts = (row total × column total) / N, all must be ≥ 5
    ((a+b) * (a+c)) / (a+b+c+d) >= 5 AND
    ((a+b) * (b+d)) / (a+b+c+d) >= 5 AND
    ((c+d) * (a+c)) / (a+b+c+d) >= 5 AND
    ((c+d) * (b+d)) / (a+b+c+d) >= 5
),
chi AS (
  SELECT
    start_pos,
    end_pos,
    ( (a+b+c+d) *
      POW(ABS(a*d - b*c) - ( (a+b+c+d) / 2.0 ), 2) /
      ( (a+b) * (c+d) * (a+c) * (b+d) )
    ) AS chi_sq
  FROM counts
)
SELECT
  start_pos AS start_position,
  end_pos   AS end_position,
  chi_sq
FROM chi
WHERE chi_sq >= 29.71679
ORDER BY chi_sq DESC;
```
