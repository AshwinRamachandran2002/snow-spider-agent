```sql
--Description: 6)  Aggregate reference (0) and alternate (1) allele counts for
--                cases vs. controls – 20 example rows
WITH alleles AS (
  SELECT  v.start, v.end,
          CASE WHEN s.Super_Population = 'EAS' THEN 'case' ELSE 'control' END AS grp,
          gt AS allele
  FROM    `spider2-public-data.1000_genomes.variants` AS v
  JOIN    UNNEST(v.call)     AS c
  JOIN    UNNEST(c.genotype) AS gt
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS s
             ON s.Sample = c.call_set_name
  WHERE   v.reference_name = '12'
    AND   ARRAY_LENGTH(v.alternate_bases) = 1
    AND   gt >= 0                               -- ignore missing (-1)
)
SELECT  start, end,
        SUM(IF(grp='case'    AND allele=1,1,0)) AS case_alt,
        SUM(IF(grp='case'    AND allele=0,1,0)) AS case_ref,
        SUM(IF(grp='control' AND allele=1,1,0)) AS ctrl_alt,
        SUM(IF(grp='control' AND allele=0,1,0)) AS ctrl_ref
FROM    alleles
GROUP   BY start, end
LIMIT   20;
