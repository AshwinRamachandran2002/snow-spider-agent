--Description:
-- Objective → identify chromosome-12 variants whose association with the East-Asian
-- (EAS) super-population is genome-wide significant (Yates-corrected χ² ≥ 29.71679).
-- Logical steps encoded as CTEs:
--
-- 1. alleles : explode every allele (0 = ref, 1 = alt) from every genotype call,
--              tag the sample as ‘eas’ or ‘other’.  NOTE ‑ avoid the reserved word
--              CASE as a column alias by using grp_label instead.
-- 2. counts  : build the 2×2 contingency table per variant (a,b,c,d) and keep only
--              variants whose marginal totals ensure each expected count ≥ 5.
-- 3. chi     : compute Yates-corrected χ²
--                χ² = N * (|ad − bc| − N/2)² / ((a+b)(c+d)(a+c)(b+d)).
-- 4. final   : output start, end, χ² for variants meeting the threshold,
--              ordered by decreasing χ².
WITH alleles AS (
  SELECT
    v.start  AS variant_start,
    v.end    AS variant_end,
    -- label sample
    CASE
      WHEN s.Super_Population = 'EAS' THEN 'eas'
      ELSE 'other'
    END                       AS grp_label,
    gt                        AS allele              -- 0 or 1
  FROM  `spider2-public-data.1000_genomes.variants`      AS v
  JOIN  UNNEST(v.call)                                    AS c
  JOIN  UNNEST(c.genotype)                                AS gt
  JOIN  `spider2-public-data.1000_genomes.sample_info`    AS s
        ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'                -- chr 12 only
    AND ARRAY_LENGTH(v.alternate_bases) = 1    -- bi-allelic
    AND gt >= 0                                -- ignore missing (-1)
),
counts AS (
  SELECT
    variant_start,
    variant_end,
    SUM(IF(grp_label = 'eas'   AND allele = 1, 1, 0)) AS a,   -- EAS alt
    SUM(IF(grp_label = 'eas'   AND allele = 0, 1, 0)) AS b,   -- EAS ref
    SUM(IF(grp_label = 'other' AND allele = 1, 1, 0)) AS c,   -- others alt
    SUM(IF(grp_label = 'other' AND allele = 0, 1, 0)) AS d    -- others ref
  FROM   alleles
  GROUP  BY variant_start, variant_end
  HAVING (a + b) >= 5          -- ensures each expected cell ≥ 5
     AND (c + d) >= 5
     AND (a + c) >= 5
     AND (b + d) >= 5
),
chi AS (
  SELECT
    variant_start AS start,
    variant_end   AS end,
    ( (a + b + c + d) *
      POW( ABS(a * d - b * c) - ( (a + b + c + d) / 2.0 ), 2 )
      / ( (a + b) * (c + d) * (a + c) * (b + d) )
    ) AS chi_sq
  FROM counts
)
SELECT
  start,
  end,
  chi_sq
FROM chi
WHERE chi_sq >= 29.71679
ORDER BY chi_sq DESC;
