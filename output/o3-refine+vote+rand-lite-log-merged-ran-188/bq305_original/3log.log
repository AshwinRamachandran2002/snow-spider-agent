[{'id': 4742863, 'title': None, 'body': "SlimDX is an MIT-licensed, open-source framework that allows developers working with managed languages like C# and IronPython to leverage DirectX and many of Microsoft's other gaming-related multimedia APIs.", 'accepted_answer_id': None, 'answer_count': None, 'comment_count': 0, 'community_owned_date': 'NaT', 'creation_date': '2011-01-20 02:14:32.800000+00:00', 'favorite_count': None, 'last_activity_date': '2011-01-20 02:14:32.800000+00:00', 'last_edit_date': '2011-01-20 02:14:32.800000+00:00', 'last_editor_display_name': 'user197015', 'last_editor_user_id': None, 'owner_display_name': 'user197015', 'owner_user_id': None, 'parent_id': None, 'post_type_id': 4, 'score': 0, 'tags': None, 'view_count': None}, {'id': 5062416, 'title': None, 'body': 'Celerity is a JRuby wrapper around HtmlUnit – a headless Java browser with JavaScript support. It provides a simple API for programmatic navigation through web applications. Celerity aims at being API compatible with Watir.', 'accepted_answer_id': None, 'answer_count': None, 'comment_count': 0, 'community_owned_date': 'NaT', 'creation_date': '2011-02-21 04:49:10.940000+00:00', 'favorite_count': None, 'last_activity_date': '2011-02-21 04:54:07.800000+00:00', 'last_edit_date': '2011-02-21 04:54:07.800000+00:00', 'last_editor_display_name': 'user479911', 'last_editor_user_id': None, 'owner_display_name': 'user479911', 'owner_user_id': None, 'parent_id': None, 'post_type_id': 4, 'score': 0, 'tags': None, 'view_count': None}, {'id': 5130475, 'title': None, 'body': 'Ramaze is a simple, light and modular open-source web application framework written in Ruby.', 'accepted_answer_id': None, 'answer_count': None, 'comment_count': 0, 'community_owned_date': 'NaT', 'creation_date': '2011-02-26 23:38:37.057000+00:00', 'favorite_count': None, 'last_activity_date': '2011-02-27 00:08:46.880000+00:00', 'last_edit_date': '2011-02-27 00:08:46.880000+00:00', 'last_editor_display_name': 'user290102', 'last_editor_user_id': None, 'owner_display_name': 'user290102', 'owner_user_id': None, 'parent_id': None, 'post_type_id': 4, 'score': 0, 'tags': None, 'view_count': None}, {'id': 5304008, 'title': None, 'body': 'WebMachine is an Erlang framework for creating RESTful Web Services using Erlang/OTP best practices.', 'accepted_answer_id': None, 'answer_count': None, 'comment_count': 0, 'community_owned_date': 'NaT', 'creation_date': '2011-03-14 20:20:45.170000+00:00', 'favorite_count': None, 'last_activity_date': '2011-03-14 20:44:11.377000+00:00', 'last_edit_date': '2011-03-14 20:44:11.377000+00:00', 'last_editor_display_name': 'user177800', 'last_editor_user_id': None, 'owner_display_name': 'user177800', 'owner_user_id': None, 'parent_id': None, 'post_type_id': 4, 'score': 0, 'tags': None, 'view_count': None}, {'id': 5354120, 'title': None, 'body': 'TCP/IP (Transmission Control Protocol/Internet Protocol) is the basic communication language or protocol of the Internet. It can also be used as a communications protocol in a private network (either an intranet or an extranet).', 'accepted_answer_id': None, 'answer_count': None, 'comment_count': 0, 'community_owned_date': 'NaT', 'creation_date': '2011-03-18 15:24:37.813000+00:00', 'favorite_count': None, 'last_activity_date': '2011-03-18 15:27:51.537000+00:00', 'last_edit_date': '2011-03-18 15:27:51.537000+00:00', 'last_editor_display_name': 'user614868', 'last_editor_user_id': None, 'owner_display_name': 'user614868', 'owner_user_id': None, 'parent_id': None, 'post_type_id': 4, 'score': 0, 'tags': None, 'view_count': None}]

