Query:
-- Description: Add month-over-month % change in revenue and order count using window functions.
SELECT
    agg."category",
    agg."year_month",
    agg."total_revenue",
    agg."completed_orders",
    agg."total_cost",
    agg."profit",
    CASE WHEN LAG(agg."total_revenue") OVER (PARTITION BY agg."category" ORDER BY agg."year_month") = 0
         THEN NULL
         ELSE ROUND(100 * (agg."total_revenue" - LAG(agg."total_revenue") OVER (PARTITION BY agg."category" ORDER BY agg."year_month"))
                     / NULLIF(LAG(agg."total_revenue") OVER (PARTITION BY agg."category" ORDER BY agg."year_month"),0), 2)
    END AS "mom_revenue_growth_pct",
    CASE WHEN LAG(agg."completed_orders") OVER (PARTITION BY agg."category" ORDER BY agg."year_month") = 0
         THEN NULL
         ELSE ROUND(100 * (agg."completed_orders" - LAG(agg."completed_orders") OVER (PARTITION BY agg."category" ORDER BY agg."year_month"))
                     / NULLIF(LAG(agg."completed_orders") OVER (PARTITION BY agg."category" ORDER BY agg."year_month"),0), 2)
    END AS "mom_order_growth_pct",
    CASE WHEN agg."total_cost" = 0 THEN NULL ELSE ROUND(agg."profit" / agg."total_cost", 4) END AS "profit_to_cost_ratio"
FROM (
    SELECT
        p."category",
        TO_CHAR(TO_TIMESTAMP_NTZ(oi."delivered_at" / 1000000), 'YYYY-MM') AS "year_month",
        SUM(oi."sale_price")                                              AS "total_revenue",
        COUNT(DISTINCT oi."order_id")                                     AS "completed_orders",
        SUM(p."cost")                                                     AS "total_cost",
        SUM(oi."sale_price") - SUM(p."cost")                              AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" AS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"   AS p
          ON p."id" = oi."product_id"
    WHERE oi."status" = 'Complete'
      AND TO_CHAR(TO_TIMESTAMP_NTZ(oi."delivered_at" / 1000000), 'YYYY') < '2022'
    GROUP BY p."category", "year_month"
) AS agg
ORDER BY agg."category", agg."year_month"
LIMIT 20;
