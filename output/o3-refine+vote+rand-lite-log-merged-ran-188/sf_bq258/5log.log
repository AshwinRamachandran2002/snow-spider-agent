-- If a bucket’s total_cost truly equals 0 it will appear at the very top; otherwise  
-- we verify that every bucket carries at least some positive cost, meaning our  
-- profit-to-cost ratio calculations are safe from divide-by-zero errors.
SELECT  p."category",
        TO_CHAR(
             DATE_TRUNC('month', TO_TIMESTAMP(oi."delivered_at" / 1000000)),
             'YYYY-MM'
        )                         AS "year_month",
        SUM(p."cost")             AS "total_cost"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
