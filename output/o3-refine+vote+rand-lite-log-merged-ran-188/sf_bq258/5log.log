Query:
--Description: 8)  Bring in a window function to calculate month-over-month
--                 percentage growth for revenue as well as order count.
SELECT  *
FROM   (
        SELECT p."category",
               TO_CHAR( DATE_TRUNC('month',
                        TO_TIMESTAMP( oi."delivered_at" / 1000000 )),
                        'YYYY-MM')           AS "year_month",
               SUM( oi."sale_price")         AS "revenue",
               COUNT(*)                      AS "completed_orders",
               LAG( SUM( oi."sale_price") )  OVER (PARTITION BY p."category"
                                                   ORDER BY DATE_TRUNC('month',
                                                   TO_TIMESTAMP( oi."delivered_at" / 1000000 ))) AS "prev_revenue",
               LAG( COUNT(*) )               OVER (PARTITION BY p."category"
                                                   ORDER BY DATE_TRUNC('month',
                                                   TO_TIMESTAMP( oi."delivered_at" / 1000000 ))) AS "prev_orders"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
        JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
               ON oi."product_id" = p."id"
        WHERE  oi."status"       = 'Complete'
          AND  oi."delivered_at" IS NOT NULL
          AND  oi."delivered_at" < 1640995200000000
        GROUP  BY p."category",
                  DATE_TRUNC('month', TO_TIMESTAMP( oi."delivered_at" / 1000000 ))
       ) t
LIMIT 20;
