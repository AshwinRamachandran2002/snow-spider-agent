```sql
--Description: 1)  Quick look at the different statuses an order item can take.
SELECT DISTINCT "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: 2)  Inspect a handful of “Complete” order-items that were delivered **before** 2022-01-01
--              ( 1 640 995 200 000 000 micro-seconds from epoch ) to make sure the
--              numeric “delivered_at” flag works as expected.
SELECT "id",
       "order_id",
       "product_id",
       "sale_price",
       "delivered_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
WHERE "status" = 'Complete'
  AND "delivered_at" IS NOT NULL
  AND "delivered_at" < 1640995200000000          -- 2022-01-01
LIMIT 20;
```

```sql
--Description: 3)  Review all product categories that exist in the catalogue.
SELECT DISTINCT "category"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
LIMIT 20;
```

```sql
--Description: 4)  Sample join between completed, pre-2022 order-items and their
--                 associated product categories.
SELECT oi."id"              AS "order_item_id",
       oi."order_id",
       oi."sale_price",
       p."category",
       oi."delivered_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
       ON oi."product_id" = p."id"
WHERE  oi."status" = 'Complete'
  AND  oi."delivered_at" IS NOT NULL
  AND  oi."delivered_at" < 1640995200000000
LIMIT 20;
```

```sql
--Description: 5)  Aggregate **monthly revenue** per product category for completed,
--                 delivered-before-2022 order-items (showing a 20-row sample).
SELECT p."category",
       TO_CHAR( DATE_TRUNC('month',
                 TO_TIMESTAMP( oi."delivered_at" / 1000000 )),
                'YYYY-MM')              AS "year_month",
       SUM( oi."sale_price" )           AS "monthly_revenue",
       COUNT(*)                         AS "completed_orders"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
       ON oi."product_id" = p."id"
WHERE  oi."status"       = 'Complete'
  AND  oi."delivered_at" IS NOT NULL
  AND  oi."delivered_at" < 1640995200000000
GROUP  BY p."category",
          DATE_TRUNC('month', TO_TIMESTAMP( oi."delivered_at" / 1000000 ))
ORDER  BY p."category", "year_month"
LIMIT 20;
```

```sql
--Description: 6)  Add each product’s manufacturing “cost” to the join so we can
--                 later work out total cost & profit.
SELECT oi."id"               AS "order_item_id",
       oi."sale_price",
       p."cost"              AS "unit_cost",
       (oi."sale_price" - p."cost") AS "unit_profit",
       p."category",
       oi."delivered_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
       ON oi."product_id" = p."id"
WHERE  oi."status" = 'Complete'
  AND  oi."delivered_at" IS NOT NULL
  AND  oi."delivered_at" < 1640995200000000
LIMIT 20;
```

```sql
--Description: 7)  Compute **monthly totals** of revenue, total cost and profit
--                 for each product category (sample 20 rows).
SELECT p."category",
       TO_CHAR( DATE_TRUNC('month',
                TO_TIMESTAMP( oi."delivered_at" / 1000000 )),
                'YYYY-MM')         AS "year_month",
       SUM( oi."sale_price")       AS "revenue",
       SUM( p."cost")              AS "total_cost",
       SUM( oi."sale_price" - p."cost") AS "profit"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
       ON oi."product_id" = p."id"
WHERE  oi."status"       = 'Complete'
  AND  oi."delivered_at" IS NOT NULL
  AND  oi."delivered_at" < 1640995200000000
GROUP  BY p."category",
          DATE_TRUNC('month', TO_TIMESTAMP( oi."delivered_at" / 1000000 ))
ORDER  BY p."category", "year_month"
LIMIT 20;
```

```sql
--Description: 8)  Bring in a window function to calculate month-over-month
--                 percentage growth for revenue as well as order count.
SELECT  *
FROM   (
        SELECT p."category",
               TO_CHAR( DATE_TRUNC('month',
                        TO_TIMESTAMP( oi."delivered_at" / 1000000 )),
                        'YYYY-MM')           AS "year_month",
               SUM( oi."sale_price")         AS "revenue",
               COUNT(*)                      AS "completed_orders",
               LAG( SUM( oi."sale_price") )  OVER (PARTITION BY p."category"
                                                   ORDER BY DATE_TRUNC('month',
                                                   TO_TIMESTAMP( oi."delivered_at" / 1000000 ))) AS "prev_revenue",
               LAG( COUNT(*) )               OVER (PARTITION BY p."category"
                                                   ORDER BY DATE_TRUNC('month',
                                                   TO_TIMESTAMP( oi."delivered_at" / 1000000 ))) AS "prev_orders"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
        JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
               ON oi."product_id" = p."id"
        WHERE  oi."status"       = 'Complete'
          AND  oi."delivered_at" IS NOT NULL
          AND  oi."delivered_at" < 1640995200000000
        GROUP  BY p."category",
                  DATE_TRUNC('month', TO_TIMESTAMP( oi."delivered_at" / 1000000 ))
       ) t
LIMIT 20;
```

```sql
--Description: 9)  Finish by also calculating the profit-to-cost ratio for each
--                 (category, month) pair and preview 20 rows.
SELECT res."category",
       res."year_month",
       res."revenue",
       res."completed_orders",
       res."prev_revenue",
       res."prev_orders",
       res."total_cost",
       res."profit",
       CASE WHEN res."total_cost" = 0 THEN NULL
            ELSE res."profit" / res."total_cost"
       END                              AS "profit_to_cost_ratio"
FROM  (
       SELECT p."category",
              TO_CHAR( DATE_TRUNC('month',
                       TO_TIMESTAMP( oi."delivered_at" / 1000000 )),
                       'YYYY-MM')              AS "year_month",
              SUM( oi."sale_price")            AS "revenue",
              COUNT(*)                         AS "completed_orders",
              SUM( p."cost")                   AS "total_cost",
              SUM( oi."sale_price" - p."cost") AS "profit",
              LAG( SUM( oi."sale_price") )     OVER (PARTITION BY p."category"
                                                      ORDER BY DATE_TRUNC('month',
                                                      TO_TIMESTAMP( oi."delivered_at" / 1000000 ))) AS "prev_revenue",
              LAG( COUNT(*) )                  OVER (PARTITION BY p."category"
                                                      ORDER BY DATE_TRUNC('month',
                                                      TO_TIMESTAMP( oi."delivered_at" / 1000000 ))) AS "prev_orders"
       FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
       JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
              ON oi."product_id" = p."id"
       WHERE  oi."status"       = 'Complete'
         AND  oi."delivered_at" IS NOT NULL
         AND  oi."delivered_at" < 1640995200000000
       GROUP  BY p."category",
                 DATE_TRUNC('month', TO_TIMESTAMP( oi."delivered_at" / 1000000 ))
      ) res
LIMIT 20;
```

```sql
--Description: 10)  (Optional)  Verify how many category-months have zero cost
--                  after filtering, to make sure the ratio won’t divide by zero.
SELECT "category",
       COUNT(*) AS "months_with_zero_cost"
FROM (
      SELECT p."category",
             TO_CHAR( DATE_TRUNC('month',
                      TO_TIMESTAMP( oi."delivered_at" / 1000000 )),
                      'YYYY-MM')  AS "year_month",
             SUM( p."cost")      AS "total_cost"
      FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
      JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
             ON oi."product_id" = p."id"
      WHERE  oi."status" = 'Complete'
        AND  oi."delivered_at" IS NOT NULL
        AND  oi."delivered_at" < 1640995200000000
      GROUP  BY p."category",
                DATE_TRUNC('month', TO_TIMESTAMP( oi."delivered_at" / 1000000 ))
      HAVING SUM( p."cost") = 0
) z
GROUP BY "category"
LIMIT 20;
```
