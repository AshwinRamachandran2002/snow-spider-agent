```sql
--Description: Join products to order items to see category, sale_price, and cost for a quick sanity check
SELECT  oi."id"              AS "order_item_id",
        oi."order_id",
        p."category"         AS "product_category",
        oi."sale_price",
        p."cost"             AS "product_cost"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
       ON p."id" = oi."product_id"
WHERE   oi."status" = 'Complete'
LIMIT   20;
```

```sql
--Description: Join order items with orders to ensure both tables show a 'Complete' status
SELECT  oi."id"              AS "order_item_id",
        oi."order_id",
        o."status"           AS "order_status",
        oi."status"          AS "order_item_status",
        oi."sale_price",
        oi."delivered_at"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
       ON o."order_id" = oi."order_id"
WHERE   oi."status" = 'Complete'
  AND   o."status"  = 'Complete'
LIMIT   20;
```

```sql
--Description: Sample orders delivered before 2022 (micro-second epoch < 1640995200000000)
SELECT  "order_id",
        "user_id",
        "status",
        "delivered_at"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE   "status"       = 'Complete'
  AND   "delivered_at" < 1640995200000000
LIMIT   20;
```

```sql
--Description: Aggregate total revenue by product category for completed orders delivered before 2022
SELECT  p."category"                    AS "product_category",
        SUM(oi."sale_price")            AS "total_revenue"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
       ON p."id" = oi."product_id"
WHERE   oi."status"       = 'Complete'
  AND   oi."delivered_at" < 1640995200000000
GROUP BY p."category"
ORDER BY "total_revenue" DESC
LIMIT   20;
```

```sql
--Description: Aggregate total product cost by product category for the same subset of completed orders
SELECT  p."category"                    AS "product_category",
        SUM(p."cost")                   AS "total_cost"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
       ON p."id" = oi."product_id"
WHERE   oi."status"       = 'Complete'
  AND   oi."delivered_at" < 1640995200000000
GROUP BY p."category"
ORDER BY "total_cost" DESC
LIMIT   20;
```

