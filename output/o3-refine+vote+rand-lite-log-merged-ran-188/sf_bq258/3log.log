      ON O."product_id" = P."id"
WHERE O."status" = 'Complete'
  AND O."delivered_at" IS NOT NULL
  AND O."delivered_at" < 1640995200000000
GROUP BY P."category"
LIMIT 20;
```

```sql
-- 7. Add total cost & profit (revenue – cost) to the category summary
SELECT
  P."category",
  SUM(O."sale_price")                 AS "total_revenue",
  SUM(P."cost")                       AS "total_cost",
  SUM(O."sale_price")-SUM(P."cost")   AS "total_profit"
FROM  "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  O
JOIN  "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      P
      ON O."product_id" = P."id"
WHERE O."status" = 'Complete'
  AND O."delivered_at" IS NOT NULL
  AND O."delivered_at" < 1640995200000000
GROUP BY P."category"
LIMIT 20;
```

```sql
-- 8. Bring the time dimension: year-month of delivery for each category
SELECT
  P."category",
  TO_CHAR(TO_TIMESTAMP_NTZ(O."delivered_at"/1000000),'YYYY-MM') AS "yr_mo",
  SUM(O."sale_price")                                           AS "revenue",
  COUNT(*)                                                      AS "orders",
  SUM(P."cost")                                                 AS "cost",
  SUM(O."sale_price")-SUM(P."cost")                             AS "profit"
FROM  "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  O
JOIN  "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      P
      ON O."product_id" = P."id"
WHERE O."status" = 'Complete'
  AND O."delivered_at" IS NOT NULL
  AND O."delivered_at" < 1640995200000000
GROUP BY P."category",
         TO_CHAR(TO_TIMESTAMP_NTZ(O."delivered_at"/1000000),'YYYY-MM')
LIMIT 20;
```

```sql
-- 9. Add month-over-month growth for revenue & orders (per category)
WITH base AS (
  SELECT
    P."category",
    TO_CHAR(TO_TIMESTAMP_NTZ(O."delivered_at"/1000000),'YYYY-MM') AS "yr_mo",
    SUM(O."sale_price")                                           AS "revenue",
    COUNT(*)                                                      AS "orders"
  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  O
  JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      P
        ON O."product_id" = P."id"
  WHERE O."status" = 'Complete'
    AND O."delivered_at" IS NOT NULL
    AND O."delivered_at" < 1640995200000000
  GROUP BY P."category",
           TO_CHAR(TO_TIMESTAMP_NTZ(O."delivered_at"/1000000),'YYYY-MM')
)
SELECT
  category,
  yr_mo,
  revenue,
  orders,
  ROUND(100 * (revenue  - LAG(revenue ) OVER (PARTITION BY category ORDER BY yr_mo))
              / NULLIF(LAG(revenue ) OVER (PARTITION BY category ORDER BY yr_mo),0),2)
        AS "revenue_mom_pct",
  ROUND(100 * (orders   - LAG(orders  ) OVER (PARTITION BY category ORDER BY yr_mo))
              / NULLIF(LAG(orders  ) OVER (PARTITION BY category ORDER BY yr_mo),0),2)
        AS "orders_mom_pct"
FROM base
LIMIT 20;
```

```sql
-- 10. Final monthly report: revenue, orders, MoM growth, cost, profit & profit/cost
WITH monthly AS (
  SELECT
    P."category",
    TO_CHAR(TO_TIMESTAMP_NTZ(O."delivered_at"/1000000),'YYYY-MM')  AS "yr_mo",
    SUM(O."sale_price")                                            AS "revenue",
    COUNT(*)                                                       AS "orders",
    SUM(P."cost")                                                  AS "cost"
  FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  O
  JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      P
        ON O."product_id" = P."id"
  WHERE O."status" = 'Complete'
    AND O."delivered_at" IS NOT NULL
    AND O."delivered_at" < 1640995200000000
  GROUP BY P."category",
           TO_CHAR(TO_TIMESTAMP_NTZ(O."delivered_at"/1000000),'YYYY-MM')
)
SELECT
  "category",
  "yr_mo",
  "revenue",
  "orders",
  ROUND(100 * (revenue - LAG(revenue) OVER (PARTITION BY category ORDER BY yr_mo))
              / NULLIF(LAG(revenue) OVER (PARTITION BY category ORDER BY yr_mo),0),2)
      AS "revenue_mom_pct",
  ROUND(100 * (orders  - LAG(orders )  OVER (PARTITION BY category ORDER BY yr_mo))
              / NULLIF(LAG(orders )  OVER (PARTITION BY category ORDER BY yr_mo),0),2)
      AS "orders_mom_pct",
  "cost",
  (revenue - cost)                             AS "profit",
  ROUND( (revenue - cost) / NULLIF(cost,0), 4) AS "profit_to_cost_ratio"
FROM monthly
LIMIT 20;
```
