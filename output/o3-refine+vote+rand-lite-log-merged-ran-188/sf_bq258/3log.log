Query:
--Description: 
-- This single query builds a CTE “monthly” that aggregates revenue, orders and cost for each
-- (product category, year-month) where order-item status = ‘Complete’ and delivery occurred
-- before 2022-01-01.  The outer SELECT then:
--   • Calculates MoM % growth for revenue and orders (using LAG over a category partition),
--   • Derives profit (revenue – cost) and profit-to-cost ratio.
-- All derived column names are quoted (e.g. "revenue") so later references inside analytic
-- functions are valid in Snowflake’s case-sensitive environment.

WITH "monthly" AS (
    SELECT
        P."category"                                                     AS "category",
        TO_CHAR(
            TO_TIMESTAMP_NTZ( O."delivered_at" / 1000000 ),
            'YYYY-MM'
        )                                                                AS "yr_mo",
        SUM( O."sale_price" )                                            AS "revenue",
        COUNT(*)                                                         AS "orders",
        SUM( P."cost" )                                                  AS "cost"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  O
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      P
          ON O."product_id" = P."id"
    WHERE O."status" = 'Complete'
      AND O."delivered_at" IS NOT NULL
      AND O."delivered_at" < 1640995200000000          -- 2022-01-01 in μs epoch
    GROUP BY
        P."category",
        TO_CHAR( TO_TIMESTAMP_NTZ( O."delivered_at" / 1000000 ), 'YYYY-MM' )
)

SELECT
    "category",
    "yr_mo",
    "revenue",
    "orders",
    ROUND(
        100 * ( "revenue" - LAG("revenue") OVER (PARTITION BY "category" ORDER BY "yr_mo") )
        / NULLIF( LAG("revenue") OVER (PARTITION BY "category" ORDER BY "yr_mo"), 0 ),
        2
    ) AS "revenue_mom_pct",
    ROUND(
        100 * ( "orders"  - LAG("orders")  OVER (PARTITION BY "category" ORDER BY "yr_mo") )
        / NULLIF( LAG("orders")  OVER (PARTITION BY "category" ORDER BY "yr_mo"), 0 ),
        2
    ) AS "orders_mom_pct",
    "cost",
    ("revenue" - "cost")                             AS "profit",
    ROUND( ("revenue" - "cost") / NULLIF("cost", 0), 4 ) AS "profit_to_cost_ratio"
FROM "monthly"
ORDER BY "category", "yr_mo"
LIMIT 20
