LIMIT 20;
```

```sql
--Description: 5) Join order-items with products to see which categories are represented.
SELECT oi."id"            AS "order_item_id",
       oi."order_id",
       p."category",
       p."cost",
       oi."sale_price"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
  ON oi."product_id" = p."id"
LIMIT 20;
```

```sql
--Description: 6) Basic monthly aggregation – total revenue & completed-order count per category.
SELECT TO_CHAR(TO_TIMESTAMP(oi."delivered_at"/1e6), 'YYYY-MM') AS "year_month",
       p."category",
       SUM(oi."sale_price")                                    AS "total_revenue",
       COUNT(DISTINCT oi."order_id")                           AS "completed_orders"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
  ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
  AND oi."delivered_at" IS NOT NULL
  AND oi."delivered_at" < 1640995200000000
GROUP BY "year_month", p."category"
ORDER BY "year_month", p."category"
LIMIT 20;
```

```sql
--Description: 7) Same aggregation but also summing total product cost for profit analysis.
SELECT TO_CHAR(TO_TIMESTAMP(oi."delivered_at"/1e6), 'YYYY-MM') AS "year_month",
       p."category",
       SUM(oi."sale_price")                      AS "total_revenue",
       SUM(p."cost")                             AS "total_cost",
       SUM(oi."sale_price") - SUM(p."cost")      AS "profit"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
  ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
  AND oi."delivered_at" IS NOT NULL
  AND oi."delivered_at" < 1640995200000000
GROUP BY "year_month", p."category"
ORDER BY "year_month", p."category"
LIMIT 20;
```

```sql
--Description: 8) Retrieve a list of all distinct product categories that ever appeared in     “Complete” order-items delivered before 2022.
SELECT DISTINCT p."category"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
  ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
  AND oi."delivered_at" IS NOT NULL
  AND oi."delivered_at" < 1640995200000000
LIMIT 20;
```

```sql
--Description: 9) Compute month-over-month (MoM) % growth for revenue and orders
--              (window functions; profits & cost included).
SELECT "year_month",
       "category",
       "total_revenue",
       "completed_orders",
       "total_cost",
       "profit",
       ROUND(100 * ( "total_revenue"
                     - LAG("total_revenue")
                       OVER (PARTITION BY "category" ORDER BY "year_month")
                   ) / NULLIF(LAG("total_revenue")
                       OVER (PARTITION BY "category" ORDER BY "year_month"),0), 2)    AS "MoM_revenue_growth_pct",
       ROUND(100 * ( "completed_orders"
                     - LAG("completed_orders")
                       OVER (PARTITION BY "category" ORDER BY "year_month")
                   ) / NULLIF(LAG("completed_orders")
                       OVER (PARTITION BY "category" ORDER BY "year_month"),0), 2)    AS "MoM_orders_growth_pct",
       ROUND("profit" / NULLIF("total_cost",0), 2)                                    AS "profit_to_cost_ratio"
FROM (
      SELECT TO_CHAR(TO_TIMESTAMP(oi."delivered_at"/1e6), 'YYYY-MM') AS "year_month",
             p."category",
             SUM(oi."sale_price")                 AS "total_revenue",
             COUNT(DISTINCT oi."order_id")        AS "completed_orders",
             SUM(p."cost")                        AS "total_cost",
             SUM(oi."sale_price") - SUM(p."cost") AS "profit"
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
        ON oi."product_id" = p."id"
      WHERE oi."status" = 'Complete'
        AND oi."delivered_at" IS NOT NULL
        AND oi."delivered_at" < 1640995200000000
      GROUP BY "year_month", p."category"
) sub
ORDER BY "category", "year_month"
LIMIT 20;
```

```sql
--Description: 10) Same as query 9 but restricted to a single example category (“Accessories”)
--               so it is shorter and easier to validate the MoM logic.
SELECT *
FROM (
      SELECT TO_CHAR(TO_TIMESTAMP(oi."delivered_at"/1e6), 'YYYY-MM') AS "year_month",
             p."category",
             SUM(oi."sale_price")                 AS "total_revenue",
             COUNT(DISTINCT oi."order_id")        AS "completed_orders",
             SUM(p."cost")                        AS "total_cost",
             SUM(oi."sale_price") - SUM(p."cost") AS "profit"
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
        ON oi."product_id" = p."id"
      WHERE oi."status" = 'Complete'
        AND oi."delivered_at" IS NOT NULL
        AND oi."delivered_at" < 1640995200000000
        AND p."category" ILIKE '%Accessories%'
      GROUP BY "year_month", p."category"
) acc
ORDER BY "year_month"
LIMIT 20;
```
