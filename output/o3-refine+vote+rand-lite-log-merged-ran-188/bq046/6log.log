```sql
--Description: 3)  FULL JOIN the two sets; keep rows where there is NO “bad-history/redaction” hit.
WITH anno AS (
  SELECT DISTINCT case_barcode,
         category   AS categoryName,
         classification AS classificationName
  FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
  WHERE entity_type = 'Patient'
    AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
         OR classification = 'Redaction')
),
young_brca AS (
  SELECT DISTINCT case_barcode
  FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
  WHERE UPPER(gender) = 'FEMALE'
    AND disease_code = 'BRCA'
    AND age_at_diagnosis <= 30
)
SELECT
  y.case_barcode,
  a.categoryName,
  a.classificationName
FROM young_brca  y
FULL JOIN anno a
ON y.case_barcode = a.case_barcode
WHERE a.categoryName IS NULL
  AND a.classificationName IS NULL
LIMIT 20;
```

```sql
--Description: 4)  Map the remaining case barcodes to their GDC case UUIDs (rel14_caseData).
WITH clean_cases AS (
  /* paste the previous FULL-JOIN here without the LIMIT */
  SELECT DISTINCT y.case_barcode
  FROM (
      SELECT DISTINCT case_barcode
      FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
      WHERE UPPER(gender) = 'FEMALE'
        AND disease_code = 'BRCA'
        AND age_at_diagnosis <= 30
  ) y
  LEFT JOIN (
      SELECT DISTINCT case_barcode
      FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
      WHERE entity_type = 'Patient'
        AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
             OR classification = 'Redaction')
  ) a
  ON y.case_barcode = a.case_barcode
  WHERE a.case_barcode IS NULL
)
SELECT c.case_barcode,
       d.project_id,
       d.case_gdc_id   -- UUID that will match file tables
FROM clean_cases c
JOIN `isb-cgc.GDC_metadata.rel14_caseData` d
ON c.case_barcode = d.case_barcode
LIMIT 20;
```

```sql
--Description: 5)  Retrieve all current (rel14) file UUIDs for the kept case UUIDs.
WITH good_cases AS (
  /* same CTE as query 4 returning case_gdc_id */
  SELECT d.case_gdc_id
  FROM (
      SELECT DISTINCT y.case_barcode
      FROM (
          SELECT DISTINCT case_barcode
          FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
          WHERE UPPER(gender) = 'FEMALE'
            AND disease_code = 'BRCA'
            AND age_at_diagnosis <= 30
      ) y
      LEFT JOIN (
          SELECT DISTINCT case_barcode
          FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
          WHERE entity_type = 'Patient'
            AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
                 OR classification = 'Redaction')
      ) a
      ON y.case_barcode = a.case_barcode
      WHERE a.case_barcode IS NULL
  ) c
  JOIN `isb-cgc.GDC_metadata.rel14_caseData` d
  ON c.case_barcode = d.case_barcode
)
SELECT DISTINCT
  f.associated_entities__case_gdc_id AS case_gdc_id,
  f.file_gdc_id,
  f.file_name,
  f.data_category,
  f.data_type
FROM good_cases g
JOIN `isb-cgc.GDC_metadata.rel14_fileData_current` f
ON g.case_gdc_id = f.associated_entities__case_gdc_id
LIMIT 20;
```

```sql
--Description: 6)  Attach GCS URLs for those file UUIDs.
WITH files AS (
  /* query 5 without LIMIT, producing file_gdc_id and case_gdc_id */
  SELECT DISTINCT
    f.associated_entities__case_gdc_id AS case_gdc_id,
    f.file_gdc_id
  FROM (
      /* good_cases CTE from query 5 */
      SELECT d.case_gdc_id
      FROM (
          SELECT DISTINCT y.case_barcode
          FROM (
              SELECT DISTINCT case_barcode
              FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
              WHERE UPPER(gender) = 'FEMALE'
                AND disease_code = 'BRCA'
                AND age_at_diagnosis <= 30
          ) y
          LEFT JOIN (
              SELECT DISTINCT case_barcode
              FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
              WHERE entity_type = 'Patient'
                AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
                     OR classification = 'Redaction')
          ) a
          ON y.case_barcode = a.case_barcode
          WHERE a.case_barcode IS NULL
      ) c
      JOIN `isb-cgc.GDC_metadata.rel14_caseData` d
      ON c.case_barcode = d.case_barcode
  ) g
  JOIN `isb-cgc.GDC_metadata.rel14_fileData_current` f
  ON g.case_gdc_id = f.associated_entities__case_gdc_id
)
SELECT
  f.case_gdc_id,
  u.file_gdc_id,
  u.file_gdc_url         AS gcs_url
FROM files f
JOIN `isb-cgc.GDC_metadata.rel14_GDCfileID_to_GCSurl_NEW` u
ON f.file_gdc_id = u.file_gdc_id
LIMIT 20;
```

```sql
--Description: 7)  Final consolidated list: case barcode + file URL (ready for download).
WITH young_female_brca AS (
  SELECT DISTINCT case_barcode
  FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
  WHERE UPPER(gender) = 'FEMALE'
    AND disease_code = 'BRCA'
    AND age_at_diagnosis <= 30
),
bad_history AS (
  SELECT DISTINCT case_barcode
  FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
  WHERE entity_type = 'Patient'
    AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
         OR classification = 'Redaction')
),
eligible_cases AS (
  SELECT y.case_barcode
  FROM young_female_brca y
  LEFT JOIN bad_history b USING (case_barcode)
  WHERE b.case_barcode IS NULL   -- remove patients with disqualifying annotations
),
case2uuid AS (
  SELECT e.case_barcode,
         c.case_gdc_id
  FROM eligible_cases e
  JOIN `isb-cgc.GDC_metadata.rel14_caseData` c
  ON e.case_barcode = c.case_barcode
),
case_files AS (
  SELECT c.case_barcode,
         f.file_gdc_id
  FROM case2uuid c
  JOIN `isb-cgc.GDC_metadata.rel14_fileData_current` f
  ON c.case_gdc_id = f.associated_entities__case_gdc_id
)
SELECT DISTINCT
  cf.case_barcode,
  g.file_gdc_url AS gdc_file_gcs_url
FROM case_files cf
JOIN `isb-cgc.GDC_metadata.rel14_GDCfileID_to_GCSurl_NEW` g
ON cf.file_gdc_id = g.file_gdc_id
ORDER BY cf.case_barcode
LIMIT 20;
```

