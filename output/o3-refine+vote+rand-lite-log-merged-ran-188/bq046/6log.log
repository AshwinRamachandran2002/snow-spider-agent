  fi.case_barcode,
  u.file_gdc_url
FROM files                                            fi
JOIN `isb-cgc.GDC_metadata.rel14_GDCfileID_to_GCSurl_NEW` u
  ON fi.file_gdc_id = u.file_gdc_id
ORDER BY fi.case_barcode;
