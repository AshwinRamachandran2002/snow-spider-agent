Query:
--Description: 3)  FULL JOIN the two sets; keep rows where there is NO “bad-history/redaction” hit.
WITH anno AS (
  SELECT DISTINCT case_barcode,
         category   AS categoryName,
         classification AS classificationName
  FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
  WHERE entity_type = 'Patient'
    AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
         OR classification = 'Redaction')
),
young_brca AS (
  SELECT DISTINCT case_barcode
  FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
  WHERE UPPER(gender) = 'FEMALE'
    AND disease_code = 'BRCA'
    AND age_at_diagnosis <= 30
)
SELECT
  y.case_barcode,
  a.categoryName,
  a.classificationName
FROM young_brca  y
FULL JOIN anno a
ON y.case_barcode = a.case_barcode
WHERE a.categoryName IS NULL
  AND a.classificationName IS NULL
LIMIT 20;
Answer:
case_barcode,categoryName,classificationName
TCGA-PL-A8LZ,,
TCGA-S3-A6ZH,,
TCGA-AO-A129,,
TCGA-AO-A03M,,
TCGA-B6-A0RG,,
TCGA-E9-A1NE,,
TCGA-C8-A273,,
Query:
--Description: 4)  Map the remaining case barcodes to their GDC case UUIDs (rel14_caseData).
WITH clean_cases AS (
  /* paste the previous FULL-JOIN here without the LIMIT */
  SELECT DISTINCT y.case_barcode
  FROM (
      SELECT DISTINCT case_barcode
      FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
      WHERE UPPER(gender) = 'FEMALE'
        AND disease_code = 'BRCA'
        AND age_at_diagnosis <= 30
  ) y
  LEFT JOIN (
      SELECT DISTINCT case_barcode
      FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
      WHERE entity_type = 'Patient'
        AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
             OR classification = 'Redaction')
  ) a
  ON y.case_barcode = a.case_barcode
  WHERE a.case_barcode IS NULL
)
SELECT c.case_barcode,
       d.project_id,
       d.case_gdc_id   -- UUID that will match file tables
FROM clean_cases c
JOIN `isb-cgc.GDC_metadata.rel14_caseData` d
ON c.case_barcode = d.case_barcode
LIMIT 20;
Answer:
case_barcode,project_id,case_gdc_id
TCGA-AN-A041,TCGA-BRCA,316e021c-5175-4ab3-bdb6-2bf9683f657a
TCGA-AO-A03M,TCGA-BRCA,095c7985-3842-494f-b591-706ad1cd2133
TCGA-AO-A129,TCGA-BRCA,c70ee5e1-4703-4996-bb5c-f4cca0fb53ba
TCGA-AR-A0TQ,TCGA-BRCA,5dc1bee9-c44d-4fdc-9ae5-83426c4d6880
TCGA-AR-A24L,TCGA-BRCA,de646f6a-6d50-4be2-b3cd-f17554b234df
Query:
--Description: 5)  Retrieve all current (rel14) file UUIDs for the kept case UUIDs.
WITH good_cases AS (
  /* same CTE as query 4 returning case_gdc_id */
  SELECT d.case_gdc_id
  FROM (
      SELECT DISTINCT y.case_barcode
      FROM (
          SELECT DISTINCT case_barcode
          FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
          WHERE UPPER(gender) = 'FEMALE'
            AND disease_code = 'BRCA'
            AND age_at_diagnosis <= 30
      ) y
      LEFT JOIN (
          SELECT DISTINCT case_barcode
          FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
          WHERE entity_type = 'Patient'
            AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
                 OR classification = 'Redaction')
      ) a
      ON y.case_barcode = a.case_barcode
      WHERE a.case_barcode IS NULL
  ) c
  JOIN `isb-cgc.GDC_metadata.rel14_caseData` d
  ON c.case_barcode = d.case_barcode
)
SELECT DISTINCT
  f.associated_entities__case_gdc_id AS case_gdc_id,
  f.file_gdc_id,
  f.file_name,
  f.data_category,
  f.data_type
FROM good_cases g
JOIN `isb-cgc.GDC_metadata.rel14_fileData_current` f
