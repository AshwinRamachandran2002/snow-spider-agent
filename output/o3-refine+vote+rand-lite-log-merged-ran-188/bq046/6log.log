--Description / Thinking process:
-- Goal: return all (case_barcode , file_gcs_url) pairs for TCGA female BRCA patients
--       ≤30 yrs old who do NOT have the disqualifying annotations.
--
-- Steps encoded as CTEs:
--   1) young_female_brca   – select BRCA, FEMALE, age≤30 barcodes (Clinical table).
--   2) bad_history         – select barcodes with “bad-history” or “Redaction” annotations.
--   3) eligible_cases      – subtract bad_history from young_female_brca.
--   4) case2uuid           – map barcodes → case UUIDs via rel14_caseData.
--   5) case_files          – collect every file UUID for each case UUID (rel14_fileData_current).
--   6) final SELECT        – attach GCS URL for each file (rel14_GDCfileID_to_GCSurl_NEW)
--                            and output the requested information.
--
-- The single query below embodies all steps.

WITH young_female_brca AS (
  SELECT DISTINCT case_barcode
  FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
  WHERE UPPER(gender) = 'FEMALE'
    AND disease_code  = 'BRCA'
    AND age_at_diagnosis <= 30
),
bad_history AS (
  SELECT DISTINCT case_barcode
  FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
  WHERE entity_type = 'Patient'
    AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
         OR classification = 'Redaction')
),
eligible_cases AS (
  SELECT y.case_barcode
  FROM young_female_brca y
  LEFT JOIN bad_history b USING (case_barcode)
  WHERE b.case_barcode IS NULL         -- keep only clean barcodes
),
case2uuid AS (
  SELECT e.case_barcode,
         c.case_gdc_id
  FROM eligible_cases e
  JOIN `isb-cgc.GDC_metadata.rel14_caseData` c
    ON e.case_barcode = c.case_barcode
),
case_files AS (
  SELECT c.case_barcode,
         f.file_gdc_id
  FROM case2uuid c
  JOIN `isb-cgc.GDC_metadata.rel14_fileData_current` f
    ON c.case_gdc_id = f.associated_entities__case_gdc_id
)
SELECT DISTINCT
  cf.case_barcode,
  g.file_gdc_url
FROM case_files cf
JOIN `isb-cgc.GDC_metadata.rel14_GDCfileID_to_GCSurl_NEW` g
  ON cf.file_gdc_id = g.file_gdc_id
ORDER BY cf.case_barcode
LIMIT 100;
