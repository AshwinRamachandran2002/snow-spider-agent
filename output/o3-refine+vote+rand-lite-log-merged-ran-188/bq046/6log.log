--Description: Retrieve slide-image (SVS) file URLs for all eligible TCGA female BRCA
--             patients diagnosed at age ≤ 30 who have NO disqualifying annotations.
--             Steps:
--   1. young_female_brca  – BRCA, FEMALE, age≤30 (Clinical).
--   2. bad_history        – barcodes with “bad-history”/“Redaction” annotations (Annotations).
--   3. eligible_cases     – barcodes in (1) but not in (2).
--   4. case2uuid          – map barcode → case UUID (rel14_caseData).
--   5. case_files         – grab file UUIDs whose data_type contains “slide image”
--                           for each eligible case UUID (rel14_fileData_current).
--   6. Final SELECT       – attach the GCS URL (rel14_GDCfileID_to_GCSurl_NEW) and
--                           output distinct (barcode , file_gcs_url) pairs.

WITH young_female_brca AS (
  SELECT DISTINCT case_barcode
  FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
  WHERE UPPER(gender) = 'FEMALE'
    AND disease_code  = 'BRCA'
    AND age_at_diagnosis <= 30
),
bad_history AS (
  SELECT DISTINCT case_barcode
  FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
  WHERE entity_type = 'Patient'
    AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
         OR classification = 'Redaction')
),
eligible_cases AS (
  SELECT y.case_barcode
  FROM young_female_brca y
  LEFT JOIN bad_history b USING (case_barcode)
  WHERE b.case_barcode IS NULL            -- exclude disqualified barcodes
),
case2uuid AS (
  SELECT e.case_barcode,
         d.case_gdc_id
  FROM eligible_cases   AS e
  JOIN `isb-cgc.GDC_metadata.rel14_caseData` AS d
    ON e.case_barcode = d.case_barcode
),
case_files AS (
  SELECT c.case_barcode,
         f.file_gdc_id
  FROM case2uuid                             AS c
  JOIN `isb-cgc.GDC_metadata.rel14_fileData_current` AS f
    ON c.case_gdc_id = f.associated_entities__case_gdc_id
  WHERE LOWER(f.data_type) LIKE '%slide image%'      -- keep SVS slide images only
)
SELECT DISTINCT
  cf.case_barcode,
  g.file_gdc_url
FROM case_files cf
JOIN `isb-cgc.GDC_metadata.rel14_GDCfileID_to_GCSurl_NEW` AS g
  ON cf.file_gdc_id = g.file_gdc_id
ORDER BY cf.case_barcode
LIMIT 20;
