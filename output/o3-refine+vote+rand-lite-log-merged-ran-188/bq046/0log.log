2025-05-05 03:48:30 - Thread-2353 (execute) - INFO - [Exploration]
Below are up-to-10 exploratory → final BigQuery SQL statements that illustrate how to move from the source tables to the requested
“case_barcode + GDC file URL” list.  
(Every query is limited to 20 rows just for inspection.)

```sql
--Description: 1)  Inspect TCGA_bioclin_v0.Annotations records that could flag a patient
--               (entity_type = 'Patient' AND category/category OR classification criteria)
SELECT
  entity_type,
  category,
  classification,
  case_barcode
FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
WHERE entity_type = 'Patient'
  AND (
        category       = 'History of unacceptable prior treatment related to a prior/other malignancy'
     OR classification = 'Redaction'
      )
LIMIT 20;
```

```sql
--Description: 2)  Inspect Clinical table rows for Breast Cancer (BRCA) females
--               aged 30 or younger.
SELECT
  case_barcode,
  disease_code,
  age_at_diagnosis,
  gender
FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
WHERE disease_code       = 'BRCA'
  AND gender             = 'FEMALE'
  AND age_at_diagnosis  <= 30
LIMIT 20;
```

```sql
--Description: 3)  Grab the DISTINCT barcodes that are “flagged” in Annotations
--               (will be used later to exclude these cases).
SELECT DISTINCT
  case_barcode AS flagged_barcode
FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
WHERE entity_type = 'Patient'
  AND (
        category       = 'History of unacceptable prior treatment related to a prior/other malignancy'
     OR classification = 'Redaction'
      )
LIMIT 20;
```

```sql
--Description: 4)  Grab DISTINCT barcodes of eligible BRCA female patients (≤30 yr)
SELECT DISTINCT
  case_barcode
FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
WHERE disease_code      = 'BRCA'
  AND gender            = 'FEMALE'
  AND age_at_diagnosis <= 30
LIMIT 20;
```

```sql
--Description: 5)  FULL JOIN the two barcode lists and keep rows where the annotation
--               columns are NULL  ➔ patients NOT present in the “flagged” list.
WITH flagged AS (
  SELECT DISTINCT case_barcode,
         category       AS categoryName,
         classification AS classificationName
  FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
  WHERE entity_type = 'Patient'
    AND (
          category       = 'History of unacceptable prior treatment related to a prior/other malignancy'
       OR classification = 'Redaction'
        )
),
eligible AS (
  SELECT DISTINCT case_barcode
  FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
  WHERE disease_code      = 'BRCA'
    AND gender            = 'FEMALE'
    AND age_at_diagnosis <= 30
)
SELECT
  e.case_barcode
FROM eligible   AS e
FULL JOIN flagged AS f
ON e.case_barcode = f.case_barcode
WHERE f.categoryName IS NULL           -- keep only un-flagged
  AND f.classificationName IS NULL
LIMIT 20;
```

```sql
--Description: 6)  Examine release-14 file metadata and extract the
--               case barcode (first 12 chars of file_name) to confirm pattern.
SELECT
  file_gdc_id,
  file_name,
  SUBSTR(file_name, 1, 12) AS extracted_barcode
FROM `isb-cgc.GDC_metadata.rel14_fileData_current`
LIMIT 20;
```

```sql
--Description: 7)  Join the clean barcode list from step-5 to rel14_fileData_current
--               via the extracted barcode to retrieve file UUIDs.
WITH clean_cases AS (
  SELECT
    e.case_barcode
  FROM (
        SELECT DISTINCT case_barcode
        FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
        WHERE disease_code      = 'BRCA'
          AND gender            = 'FEMALE'
          AND age_at_diagnosis <= 30
       ) AS e
  LEFT JOIN (
        SELECT DISTINCT case_barcode
        FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
        WHERE entity_type = 'Patient'
          AND (
                category       = 'History of unacceptable prior treatment related to a prior/other malignancy'
             OR classification = 'Redaction'
              )
       ) AS f
  ON e.case_barcode = f.case_barcode
  WHERE f.case_barcode IS NULL        -- exclude flagged
)
SELECT
  c.case_barcode,
  fd.file_gdc_id
FROM clean_cases AS c
JOIN `isb-cgc.GDC_metadata.rel14_fileData_current` AS fd
ON c.case_barcode = SUBSTR(fd.file_name, 1, 12)
LIMIT 20;
```

```sql
--Description: 8)  Look up the corresponding GCS URLs for the file UUIDs
SELECT
  file_gdc_id,
  file_gdc_url
FROM `isb-cgc.GDC_metadata.rel14_GDCfileID_to_GCSurl_NEW`
LIMIT 20;
```

```sql
--Description: 9)  Combine steps 7 & 8 to return case_barcode + file_url pairs.
WITH clean_cases AS (
  SELECT
    e.case_barcode
  FROM (
        SELECT DISTINCT case_barcode
        FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
        WHERE disease_code      = 'BRCA'
          AND gender            = 'FEMALE'
          AND age_at_diagnosis <= 30
       ) AS e
  LEFT JOIN (
        SELECT DISTINCT case_barcode
        FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
        WHERE entity_type = 'Patient'
          AND (
                category       = 'History of unacceptable prior treatment related to a prior/other malignancy'
             OR classification = 'Redaction'
              )
       ) AS f
  ON e.case_barcode = f.case_barcode
  WHERE f.case_barcode IS NULL
),
files AS (
  SELECT
    SUBSTR(fd.file_name, 1, 12) AS case_barcode,
    fd.file_gdc_id
  FROM `isb-cgc.GDC_metadata.rel14_fileData_current` AS fd
)
SELECT DISTINCT
  cc.case_barcode,
  url.file_gdc_url AS gdc_file_url
FROM clean_cases                AS cc
JOIN files                      AS f  ON cc.case_barcode = f.case_barcode
JOIN `isb-cgc.GDC_metadata.rel14_GDCfileID_to_GCSurl_NEW` AS url
ON f.file_gdc_id = url.file_gdc_id
LIMIT 20;
```

```sql
--Description: 10)  (Optional) Count how many unique BRCA ≤30-yr female cases
--                  survive all filters and have at least one file in release-14.
WITH final AS (
  /* use the same logic as query 9 without LIMIT */
  -- (omitted here for brevity)
)
SELECT COUNT(DISTINCT case_barcode) AS total_cases_with_files
FROM final;
```

These progressively build toward the final answer: case barcodes for BRCA female patients (≤30 yrs) with **no disqualifying annotations**, paired with their corresponding GDC file URLs from archive release 14.
