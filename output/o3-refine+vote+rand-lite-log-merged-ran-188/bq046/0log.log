```sql
--Description:
--  THINKING PROCESS (each CTE name follows the step):
--  1) flagged      : barcodes that MUST be excluded based on Annotations criteria.
--  2) eligible     : BRCA, FEMALE, age_at_diagnosis ≤ 30 (Clinical table).
--  3) clean_cases  : eligible MINUS flagged → patients we keep.
--  4) rel14_files  : all archive-release-14 file UUIDs + extracted case barcode.
--  5) urls         : map each UUID to its GCS URL.
--  6) FINAL SELECT : distinct case_barcode + GDC file URL for the requested cohort.
WITH flagged AS (
  SELECT DISTINCT case_barcode
  FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
  WHERE entity_type = 'Patient'
    AND (
          category       = 'History of unacceptable prior treatment related to a prior/other malignancy'
       OR classification = 'Redaction'
        )
),
eligible AS (
  SELECT DISTINCT case_barcode
  FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
  WHERE disease_code       = 'BRCA'
    AND gender             = 'FEMALE'
    AND age_at_diagnosis  <= 30
),
clean_cases AS (
  SELECT e.case_barcode
  FROM eligible e
  LEFT JOIN flagged f USING (case_barcode)
  WHERE f.case_barcode IS NULL
),
rel14_files AS (
  SELECT
    SUBSTR(file_name, 1, 12) AS case_barcode,
    file_gdc_id
  FROM `isb-cgc.GDC_metadata.rel14_fileData_current`
),
urls AS (
  SELECT file_gdc_id, file_gdc_url
  FROM `isb-cgc.GDC_metadata.rel14_GDCfileID_to_GCSurl_NEW`
)
SELECT DISTINCT
  cc.case_barcode,
  u.file_gdc_url
FROM clean_cases  AS cc
JOIN rel14_files  AS rf ON rf.case_barcode = cc.case_barcode
JOIN urls         AS u  ON u.file_gdc_id   = rf.file_gdc_id
ORDER BY cc.case_barcode;
```
