```sql
--Description / thinking process:
--1. The earlier error came from using DISTINCT together with an explicit ',' separator in GROUP_CONCAT.
--   SQLite permits DISTINCT *or* a custom separator, not both simultaneously.
--2. We still need the list of unique years, so we keep DISTINCT and omit the separator argument.
--3. The PIDs in M_Cast contain leading spaces; TRIM() is applied to ensure they match
--   the PIDs stored in Person.
--4. The query joins M_Cast → Movie (for years) → Person (for names), groups by each actor,
--   and concatenates the distinct years they appeared in films.
SELECT TRIM(mc."PID") AS "PID",
       p."Name",
       GROUP_CONCAT(DISTINCT CAST(m."year" AS INTEGER)) AS "years_active"
FROM   "M_Cast" AS mc
JOIN   "Movie"  AS m ON mc."MID" = m."MID"
JOIN   "Person" AS p ON TRIM(mc."PID") = TRIM(p."PID")
GROUP  BY TRIM(mc."PID")
LIMIT 20;
```
