--Description: Compute the year-to-year gaps for every actor (PIDs trimmed for matching); 
--shows a sample of results with each credited year and the gap from the previous one.
WITH actor_years AS (
    SELECT TRIM(mc."PID") AS "PID",
           CAST(m."year" AS INTEGER) AS yr
    FROM   "M_Cast" AS mc
    JOIN   "Movie"  AS m ON mc."MID" = m."MID"
    GROUP  BY "PID", yr
),
gaps AS (
    SELECT ay."PID",
           ay.yr,
           ay.yr - LAG(ay.yr) OVER (PARTITION BY ay."PID" ORDER BY ay.yr) AS gap
    FROM   actor_years AS ay
)
SELECT g."PID",
       p."Name",
       g.yr,
       COALESCE(g.gap, 0) AS "gap_from_prev_year"
