```sql
-- Description: Inspect distinct production years that exist in the Movie table.
SELECT DISTINCT CAST("year" AS INTEGER) AS "yr"
FROM "Movie"
ORDER BY "yr"
LIMIT 20;
```

```sql
-- Description: Join cast with movies to observe the (actor, year) pairs that will be analysed.
SELECT DISTINCT mc."PID",
       p."Name",
       CAST(m."year" AS INTEGER) AS "yr",
       mc."MID"
FROM   "M_Cast"  AS mc
JOIN   "Movie"   AS m ON mc."MID" = m."MID"
JOIN   "Person"  AS p ON mc."PID" = p."PID"
ORDER  BY mc."PID", "yr"
LIMIT 20;
```

```sql
-- Description: For each actor, list all distinct active years in a single row (string) for a quick visual check.
SELECT mc."PID",
       p."Name",
       GROUP_CONCAT(DISTINCT CAST(m."year" AS INTEGER), ',') AS "years_active"
FROM   "M_Cast" AS mc
JOIN   "Movie"  AS m ON mc."MID" = m."MID"
JOIN   "Person" AS p ON mc."PID" = p."PID"
GROUP  BY mc."PID"
LIMIT 20;
```

```sql
-- Description: Compute the year-to-year gaps for every actor using LAG; show a sample.
WITH actor_years AS (
  SELECT mc."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS mc
  JOIN   "Movie"  AS m ON mc."MID" = m."MID"
  GROUP  BY mc."PID", yr
),
gaps AS (
  SELECT ay."PID",
         ay.yr,
         ay.yr - LAG(ay.yr) OVER (PARTITION BY ay."PID" ORDER BY ay.yr) AS gap
  FROM   actor_years AS ay
)
SELECT g."PID",
       p."Name",
       g.yr,
       COALESCE(g.gap, 0) AS "gap_from_prev_year"
FROM   gaps AS g
JOIN   "Person" AS p ON p."PID" = g."PID"
ORDER  BY g."PID", g.yr
LIMIT 20;
```

```sql
-- Description: For every actor, find the maximum gap between consecutive credited years.
WITH actor_years AS (
  SELECT mc."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS mc
  JOIN   "Movie"  AS m ON mc."MID" = m."MID"
  GROUP  BY mc."PID", yr
),
gaps AS (
  SELECT ay."PID",
         ay.yr,
         ay.yr - LAG(ay.yr) OVER (PARTITION BY ay."PID" ORDER BY ay.yr) AS gap
  FROM   actor_years AS ay
),
max_gap AS (
  SELECT "PID",
         MAX(COALESCE(gap,0)) AS max_gap
  FROM   gaps
  GROUP  BY "PID"
)
SELECT mg."PID",
       p."Name",
       mg.max_gap
FROM   max_gap AS mg
JOIN   "Person" AS p ON p."PID" = mg."PID"
ORDER  BY mg.max_gap DESC
LIMIT 20;
```

```sql
-- Description: Count how many actors never have a gap larger than 3 years (i.e., max_gap ≤ 3).
WITH actor_years AS (
  SELECT mc."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS mc
  JOIN   "Movie"  AS m ON mc."MID" = m."MID"
  GROUP  BY mc."PID", yr
),
gaps AS (
  SELECT ay."PID",
         ay.yr,
         ay.yr - LAG(ay.yr) OVER (PARTITION BY ay."PID" ORDER BY ay.yr) AS gap
  FROM   actor_years AS ay
),
max_gap AS (
  SELECT "PID",
         MAX(COALESCE(gap,0)) AS max_gap
  FROM   gaps
  GROUP  BY "PID"
)
SELECT COUNT(*) AS "actors_no_gap_over_3_years"
FROM   max_gap
WHERE  max_gap <= 3;
```

