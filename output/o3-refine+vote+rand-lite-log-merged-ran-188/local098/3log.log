--Description: 8) Final answer – number of actors whose careers never contain a four-year gap
WITH years_per_actor AS (
     SELECT DISTINCT TRIM(c."PID") AS "PID",
            CAST(m."year" AS INT)  AS "yr"
     FROM   "M_Cast" AS c
     JOIN   "Movie"  AS m
       ON   c."MID" = m."MID"
),
gaps AS (
     SELECT y."PID",
            y."yr" - LAG(y."yr") OVER (PARTITION BY y."PID" ORDER BY y."yr") AS "gap"
     FROM   years_per_actor AS y
),
max_gap AS (
     SELECT "PID",
            COALESCE(MAX("gap"),0) AS "max_gap"
     FROM   gaps
     GROUP  BY "PID"
)
SELECT COUNT(*) AS "actors_without_big_gap"
FROM   max_gap
WHERE  "max_gap" <= 3
