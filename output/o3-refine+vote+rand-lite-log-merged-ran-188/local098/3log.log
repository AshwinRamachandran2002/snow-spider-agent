```sql
--Description: 1) Inspect a few distinct actor (PID) values appearing in the cast table
SELECT DISTINCT "PID"
FROM "M_Cast"
LIMIT 20;
```

```sql
--Description: 2) For a sample actor, list all of the movies and years they appeared in
SELECT c."PID",
       m."MID",
       m."title",
       m."year"
FROM   "M_Cast" AS c
JOIN   "Movie"  AS m
  ON   c."MID" = m."MID"
WHERE  c."PID" = 'nm0000288'          -- sample actor
ORDER  BY CAST(m."year" AS INT)
LIMIT 20;
```

```sql
--Description: 3) For every actor, list the distinct years in which they had at least one movie
SELECT c."PID",
       CAST(m."year" AS INT) AS "yr"
FROM   "M_Cast" AS c
JOIN   "Movie"  AS m
  ON   c."MID" = m."MID"
GROUP  BY c."PID", CAST(m."year" AS INT)
ORDER  BY c."PID", "yr"
LIMIT 20;
```

```sql
--Description: 4) Using the window function LAG, show each actor’s consecutive-year gaps
SELECT sub."PID",
       sub."yr",
       sub."yr" - LAG(sub."yr") OVER (PARTITION BY sub."PID" ORDER BY sub."yr") AS "gap"
FROM (
      SELECT c."PID",
             CAST(m."year" AS INT) AS "yr"
      FROM   "M_Cast" AS c
      JOIN   "Movie"  AS m
        ON   c."MID" = m."MID"
      GROUP  BY c."PID", CAST(m."year" AS INT)
) AS sub
ORDER  BY sub."PID", sub."yr"
LIMIT 40;
```

```sql
--Description: 5) Find every actor who, somewhere in their career, had a gap strictly larger than 3 years
SELECT DISTINCT bad."PID"
FROM (
      SELECT sub."PID",
             sub."yr",
             sub."yr" - LAG(sub."yr") OVER (PARTITION BY sub."PID" ORDER BY sub."yr") AS "gap"
      FROM (
            SELECT c."PID",
                   CAST(m."year" AS INT) AS "yr"
            FROM   "M_Cast" AS c
            JOIN   "Movie"  AS m
              ON   c."MID" = m."MID"
            GROUP  BY c."PID", CAST(m."year" AS INT)
      ) AS sub
) AS bad
WHERE bad."gap" > 3
LIMIT 20;
```

```sql
--Description: 6) Count how many distinct actors ever had a gap larger than three consecutive years
SELECT COUNT(DISTINCT bad."PID") AS "actors_with_big_gap"
FROM (
      SELECT sub."PID",
             sub."yr",
             sub."yr" - LAG(sub."yr") OVER (PARTITION BY sub."PID" ORDER BY sub."yr") AS "gap"
      FROM (
            SELECT c."PID",
                   CAST(m."year" AS INT) AS "yr"
            FROM   "M_Cast" AS c
            JOIN   "Movie"  AS m
              ON   c."MID" = m."MID"
            GROUP  BY c."PID", CAST(m."year" AS INT)
      ) AS sub
) AS bad
WHERE bad."gap" > 3;
```

```sql
--Description: 7) Count the total number of actors in the database (those with at least one cast credit)
SELECT COUNT(DISTINCT "PID") AS "total_actors"
FROM "M_Cast";
```

```sql
--Description: 8) Final answer: actors whose entire active span never contains a four-year gap (i.e., NO gap > 3)
SELECT COUNT(DISTINCT good."PID") AS "actors_without_big_gap"
FROM (
      SELECT c."PID"
      FROM   "M_Cast" AS c
      GROUP  BY c."PID"
      HAVING MAX(
             (SELECT MAX(sub."yr" - LAG(sub."yr") OVER (ORDER BY sub."yr"))
              FROM (
                    SELECT DISTINCT CAST(m2."year" AS INT) AS "yr"
                    FROM   "M_Cast" AS c2
                    JOIN   "Movie"  AS m2
                      ON   c2."MID" = m2."MID"
                    WHERE  c2."PID" = c."PID"
              ) AS sub
             )
           ) <= 3
) AS good;
```


