      SELECT DISTINCT TRIM(c."PID") AS "PID",
             CAST(m."year" AS INT) AS "yr"
      FROM   "M_Cast" AS c
      JOIN   "Movie"  AS m
        ON   c."MID" = m."MID"
) AS sub
ORDER  BY sub."PID", sub."yr"
