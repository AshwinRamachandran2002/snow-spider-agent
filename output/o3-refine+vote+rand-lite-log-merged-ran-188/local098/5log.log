Query:
--Description: Corrected SQL 5.  Each actor’s year-to-year gap is computed with a
--cleaned PID obtained via TRIM, ensuring consistency across joins/aggregations.
WITH actor_years AS (
    SELECT
           TRIM(mc."PID")         AS PID,
           CAST(m."year" AS INTEGER) AS act_year
    FROM   "M_Cast"  AS mc
    JOIN   "Movie"   AS m ON m."MID" = mc."MID"
    GROUP  BY PID, act_year
)
SELECT
       PID,
       act_year,
       act_year - LAG(act_year) OVER (PARTITION BY PID ORDER BY act_year) AS gap_since_prev
FROM   actor_years
ORDER  BY PID, act_year
LIMIT 30
