Query:
--Description: Corrected SQL 6.  Uses TRIMmed PIDs throughout to obtain each
--actor’s maximum gap between appearances.
WITH actor_years AS (
    SELECT
           TRIM(mc."PID")         AS PID,
           CAST(m."year" AS INTEGER) AS act_year
    FROM   "M_Cast"  AS mc
    JOIN   "Movie"   AS m ON m."MID" = mc."MID"
    GROUP  BY PID, act_year
),
gaps AS (
    SELECT
           PID,
           act_year - LAG(act_year) OVER (PARTITION BY PID ORDER BY act_year) AS gap_len
    FROM   actor_years
)
SELECT
       PID,
       COALESCE(MAX(gap_len),0) AS max_gap
FROM   gaps
GROUP  BY PID
ORDER  BY max_gap DESC, PID
LIMIT 20
