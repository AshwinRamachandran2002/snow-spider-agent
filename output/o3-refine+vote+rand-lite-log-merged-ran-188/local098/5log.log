2025-05-05 04:39:31 - Thread-3662 (execute) - INFO - [Exploration]
```sql
-- 1) Inspect a few raw cast‐to‐movie links (who acted in what)
SELECT *
FROM "M_Cast"
LIMIT 20;
```

```sql
-- 2) Attach actor names to the links we just looked at
SELECT DISTINCT mc."PID",
                p."Name",
                mc."MID"
FROM   "M_Cast" AS mc
JOIN   "Person" AS p
       ON p."PID" = mc."PID"
LIMIT 20;
```

```sql
-- 3) Add the release year of every appearance
SELECT DISTINCT mc."PID",
                p."Name",
                m."year"         AS act_year,
                mc."MID"
FROM   "M_Cast"  AS mc
JOIN   "Movie"   AS m ON m."MID" = mc."MID"
JOIN   "Person"  AS p ON p."PID" = mc."PID"
ORDER BY mc."PID", act_year
LIMIT 20;
```

```sql
-- 4) List every unique acting year for every actor
SELECT DISTINCT mc."PID",
                CAST(m."year" AS INTEGER) AS act_year
FROM   "M_Cast" AS mc
JOIN   "Movie"  AS m ON m."MID" = mc."MID"
ORDER BY mc."PID",
         act_year
LIMIT 20;
```

```sql
-- 5) For each actor, show the gap (in years) to the next appearance
--    LAG gives us the previous acting year; we then compute the difference
WITH actor_years AS (
    SELECT mc."PID",
           CAST(m."year" AS INTEGER) AS act_year
    FROM   "M_Cast" AS mc
    JOIN   "Movie"  AS m ON m."MID" = mc."MID"
    GROUP  BY mc."PID", act_year
)
SELECT pid,
       act_year,
       act_year - LAG(act_year) OVER (PARTITION BY pid ORDER BY act_year) AS gap_since_prev
FROM   actor_years
ORDER BY pid, act_year
LIMIT 30;
```

```sql
-- 6) Obtain the maximum gap inside each actor’s career
WITH actor_years AS (
    SELECT mc."PID",
           CAST(m."year" AS INTEGER) AS act_year
    FROM   "M_Cast" AS mc
    JOIN   "Movie"  AS m ON m."MID" = mc."MID"
    GROUP  BY mc."PID", act_year
),
gaps AS (
    SELECT pid,
           act_year - LAG(act_year) OVER (PARTITION BY pid ORDER BY act_year) AS gap_len
    FROM   actor_years
)
SELECT pid,
       COALESCE(MAX(gap_len),0) AS max_gap
FROM   gaps
GROUP  BY pid
ORDER BY max_gap DESC, pid
LIMIT 20;
```

```sql
-- 7) Count how many actors never went longer than 3 consecutive
--    years without a movie appearance (i.e., max_gap ≤ 3, or only one credit)
WITH actor_years AS (
    SELECT mc."PID",
           CAST(m."year" AS INTEGER) AS act_year
    FROM   "M_Cast" AS mc
    JOIN   "Movie"  AS m ON m."MID" = mc."MID"
    GROUP  BY mc."PID", act_year
),
gaps AS (
    SELECT pid,
           act_year - LAG(act_year) OVER (PARTITION BY pid ORDER BY act_year) AS gap_len
    FROM   actor_years
),
max_gaps AS (
    SELECT pid,
           COALESCE(MAX(gap_len),0) AS max_gap
    FROM   gaps
    GROUP  BY pid
)
SELECT COUNT(*) AS actors_without_4yr_gap
FROM   max_gaps
WHERE  max_gap <= 3;
```

(The final query returns the number of actors whose careers never show a four-year span without at least one new movie appearance.)
