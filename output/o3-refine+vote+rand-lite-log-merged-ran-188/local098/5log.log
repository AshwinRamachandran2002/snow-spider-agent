Query:
--Description: Corrected version of SQL 3.  We TRIM the leading space in M_Cast.PID
--before joining to Person and before displaying, so actor names appear properly.
SELECT DISTINCT
       TRIM(mc."PID") AS PID,
       p."Name",
       m."year"       AS act_year,
       mc."MID"
FROM   "M_Cast"  AS mc
JOIN   "Movie"   AS m ON m."MID" = mc."MID"
JOIN   "Person"  AS p ON p."PID" = TRIM(mc."PID")
ORDER  BY PID, act_year
LIMIT 20
