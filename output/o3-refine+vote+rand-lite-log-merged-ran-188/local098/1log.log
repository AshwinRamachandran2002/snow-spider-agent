```sql
--Description: Get a first glimpse of the actors that exist in the database  
SELECT DISTINCT "PID", "Name"
FROM "Person"
LIMIT 20;
```

```sql
--Description: Inspect how movies and actors are connected through the cast table  
SELECT DISTINCT "MID", "PID"
FROM "M_Cast"
LIMIT 20;
```

```sql
--Description: Look at some movies with their release years  
SELECT DISTINCT "MID", "title", "year"
FROM "Movie"
LIMIT 20;
```

```sql
--Description: Combine cast and movie tables to see which actor appeared in which year  
SELECT DISTINCT c."PID", m."MID", m."year"
FROM "M_Cast" AS c
JOIN "Movie"  AS m ON c."MID" = m."MID"
LIMIT 20;
```

```sql
--Description: For one sample actor (the very first in the Person table), list all active years in order  
SELECT sub."PID", sub."year"
FROM (
    SELECT c."PID", CAST(m."year" AS INTEGER) AS year
    FROM "M_Cast" c
    JOIN "Movie"  m ON m."MID" = c."MID"
) sub
WHERE sub."PID" = (SELECT "PID" FROM "Person" LIMIT 1)
ORDER BY sub."year"
LIMIT 20;
```

```sql
--Description: Compute year-to-year gaps for every actor (uses LAG window function)  
SELECT
  ay."PID",
  ay."year",
  ay."year" - LAG(ay."year") OVER (PARTITION BY ay."PID" ORDER BY ay."year") AS gap
FROM (
    SELECT c."PID", CAST(m."year" AS INTEGER) AS year
    FROM "M_Cast" c
    JOIN "Movie"  m ON m."MID" = c."MID"
    GROUP BY c."PID", year
) ay
ORDER BY ay."PID", ay."year"
LIMIT 20;
```

```sql
--Description: For each actor, find the maximum gap between consecutive active years  
SELECT
  gaps."PID",
  MAX(gaps.gap) AS max_gap
FROM (
    SELECT
      ay."PID",
      ay."year" - LAG(ay."year") OVER (PARTITION BY ay."PID" ORDER BY ay."year") AS gap
    FROM (
        SELECT c."PID", CAST(m."year" AS INTEGER) AS year
        FROM "M_Cast" c
        JOIN "Movie"  m ON m."MID" = c."MID"
        GROUP BY c."PID", year
    ) ay
) gaps
GROUP BY gaps."PID"
LIMIT 20;
```

```sql
--Description: Count how many actors never had a gap larger than 3 years (main target metric)  
SELECT COUNT(*)
FROM (
    SELECT
      gaps."PID",
      MAX(COALESCE(gaps.gap,0)) AS max_gap
    FROM (
        SELECT
          ay."PID",
          ay."year" - LAG(ay."year") OVER (PARTITION BY ay."PID" ORDER BY ay."year") AS gap
        FROM (
            SELECT c."PID", CAST(m."year" AS INTEGER) AS year
            FROM "M_Cast" c
            JOIN "Movie"  m ON m."MID" = c."MID"
            GROUP BY c."PID", year
        ) ay
    ) gaps
    GROUP BY gaps."PID"
) actor_max_gap
WHERE max_gap <= 3
LIMIT 20;
```

```sql
--Description: List the first 20 actors who satisfy the “no gap > 3 years” rule  
SELECT actor_max_gap."PID"
FROM (
    SELECT
      gaps."PID",
      MAX(COALESCE(gaps.gap,0)) AS max_gap
    FROM (
        SELECT
          ay."PID",
          ay."year" - LAG(ay."year") OVER (PARTITION BY ay."PID" ORDER BY ay."year") AS gap
        FROM (
            SELECT c."PID", CAST(m."year" AS INTEGER) AS year
            FROM "M_Cast" c
            JOIN "Movie"  m ON m."MID" = c."MID"
            GROUP BY c."PID", year
        ) ay
    ) gaps
    GROUP BY gaps."PID"
) actor_max_gap
WHERE actor_max_gap.max_gap <= 3
LIMIT 20;
```

```sql
--Description: Conversely, show a few actors whose maximum inactive gap exceeds 3 years (sanity check)  
SELECT actor_max_gap."PID", actor_max_gap.max_gap
FROM (
    SELECT
      gaps."PID",
      MAX(COALESCE(gaps.gap,0)) AS max_gap
    FROM (
        SELECT
          ay."PID",
          ay."year" - LAG(ay."year") OVER (PARTITION BY ay."PID" ORDER BY ay."year") AS gap
        FROM (
            SELECT c."PID", CAST(m."year" AS INTEGER) AS year
            FROM "M_Cast" c
            JOIN "Movie"  m ON m."MID" = c."MID"
            GROUP BY c."PID", year
        ) ay
    ) gaps
    GROUP BY gaps."PID"
) actor_max_gap
WHERE actor_max_gap.max_gap > 3
LIMIT 20;
```
