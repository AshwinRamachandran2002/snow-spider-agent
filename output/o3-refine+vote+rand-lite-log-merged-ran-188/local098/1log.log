--Description: Count how many actors never had a gap larger than 3 consecutive years
--between movie appearances (i.e., max_gap ≤ 3).  Returns a single count value.
SELECT COUNT(*) AS actors_without_4_year_gap
FROM (
    SELECT
        gaps."PID",
        MAX(COALESCE(gaps.gap, 0)) AS max_gap
    FROM (
        SELECT
            ay."PID",
            ay."year" - LAG(ay."year") OVER (PARTITION BY ay."PID" ORDER BY ay."year") AS gap
        FROM (
            SELECT
                TRIM(c."PID")             AS "PID",
                CAST(m."year" AS INTEGER) AS "year"
            FROM "M_Cast" c
            JOIN "Movie"  m ON m."MID" = c."MID"
            GROUP BY TRIM(c."PID"), "year"
        ) ay
    ) gaps
    GROUP BY gaps."PID"
) actor_max_gap
WHERE max_gap <= 3
