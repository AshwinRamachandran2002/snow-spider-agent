--Description: For each actor, find the maximum gap between consecutive active years
--(PID trimmed).  Shows 20 actors with their max_gap.
SELECT
    gaps."PID",
    MAX(gaps.gap) AS max_gap
FROM (
    SELECT
        ay."PID",
        ay."year" - LAG(ay."year") OVER (PARTITION BY ay."PID" ORDER BY ay."year") AS gap
    FROM (
        SELECT
            TRIM(c."PID")             AS "PID",
            CAST(m."year" AS INTEGER) AS "year"
        FROM "M_Cast" c
        JOIN "Movie"  m ON m."MID" = c."MID"
        GROUP BY TRIM(c."PID"), "year"
    ) ay
) gaps
GROUP BY gaps."PID"
LIMIT 20
