```sql
--Description / Thinking process:
--We must count actors that, from their first to last film, never go four consecutive
--years without appearing in at least one new movie.  That means each gap between
--successive “active” years is ≤ 3.
--
--Steps:
--1. actor_years  : Build a list of distinct (actor-PID, year) pairs.
--   • TRIM() cleans leading spaces present in M_Cast.PID so they match Person.PID.
--2. gaps         : For every actor, use the window function LAG to compute the
--   difference between the current active year and the previous one.
--3. max_gap      : For each actor, find the maximum of those differences
--   (COALESCE to 0 for an actor’s first credit where gap is NULL).
--4. Final SELECT : Count actors whose maximum gap ≤ 3.
WITH actor_years AS (
    SELECT
        TRIM(c."PID")             AS "PID",
        CAST(m."year" AS INTEGER) AS yr
    FROM   "M_Cast"  AS c
    JOIN   "Movie"   AS m ON m."MID" = c."MID"
    GROUP BY TRIM(c."PID"), yr
),
gaps AS (
    SELECT
        ay."PID",
        ay.yr - LAG(ay.yr) OVER (PARTITION BY ay."PID" ORDER BY ay.yr) AS gap
    FROM actor_years AS ay
),
max_gap AS (
    SELECT
        "PID",
        COALESCE(MAX(gap), 0) AS max_gap
    FROM gaps
    GROUP BY "PID"
)
SELECT COUNT(*) AS actors_without_4_year_gap
FROM   max_gap
WHERE  max_gap <= 3;
```
