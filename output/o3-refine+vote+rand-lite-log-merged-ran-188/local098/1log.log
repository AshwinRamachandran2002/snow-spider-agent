--Description: Compute year-to-year gaps for every actor (PID values trimmed so they
--match those in Person).  Shows 20 rows.
SELECT
    ay."PID",
    ay."year",
    ay."year" - LAG(ay."year") OVER (PARTITION BY ay."PID" ORDER BY ay."year") AS gap
FROM (
    SELECT
        TRIM(c."PID")             AS "PID",
        CAST(m."year" AS INTEGER) AS "year"
    FROM "M_Cast" c
    JOIN "Movie"  m ON m."MID" = c."MID"
    GROUP BY TRIM(c."PID"), "year"
) ay
ORDER BY ay."PID", ay."year"
LIMIT 20
