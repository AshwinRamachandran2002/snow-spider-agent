```sql
-- Description: Look at a few cast links to see how movie IDs (“MID”) are tied to actor IDs (“PID”).
SELECT DISTINCT "MID",
                "PID"
FROM   "M_Cast"
LIMIT 20;
```

```sql
-- Description: Join Movie-to-Cast-to-Person to view the release year attached to an actor’s credit.
SELECT p."Name"      AS actor_name,
       p."PID",
       m."title",
       m."year"
FROM   "M_Cast"  AS c
JOIN   "Movie"   AS m ON m."MID" = c."MID"
JOIN   "Person"  AS p ON p."PID" = c."PID"
LIMIT 20;
```

```sql
-- Description: Pick one example actor (“Christian Bale”) and list every distinct credit year to see the pattern.
SELECT DISTINCT CAST(m."year" AS INTEGER) AS credit_year
FROM   "Person"  AS p
JOIN   "M_Cast"  AS c ON c."PID" = p."PID"
JOIN   "Movie"   AS m ON m."MID" = c."MID"
WHERE  p."Name" LIKE '%Christian Bale%'
ORDER  BY credit_year
LIMIT 20;
```

```sql
-- Description: Build a temporary list of each actor’s DISTINCT credit years (as integers).
WITH actor_years AS (
    SELECT c."PID",
           CAST(m."year" AS INTEGER) AS yr
    FROM   "M_Cast" AS c
    JOIN   "Movie"  AS m ON m."MID" = c."MID"
    GROUP  BY c."PID", yr            -- DISTINCT years per actor
)
SELECT *
FROM   actor_years
ORDER  BY "PID", yr
LIMIT 20;
```

```sql
-- Description: For every actor, calculate the year-to-previous-year gap between consecutive credits.
WITH actor_years AS (
    SELECT c."PID",
           CAST(m."year" AS INTEGER) AS yr
    FROM   "M_Cast" AS c
    JOIN   "Movie"  AS m ON m."MID" = c."MID"
    GROUP  BY c."PID", yr
),
gaps AS (
    SELECT ay."PID",
           ay.yr,
           LAG(ay.yr) OVER (PARTITION BY ay."PID" ORDER BY ay.yr) AS prev_yr
    FROM   actor_years AS ay
)
SELECT "PID",
       yr,
       COALESCE(yr - prev_yr, 0) AS gap_size
FROM   gaps
ORDER  BY "PID", yr
LIMIT 20;
```

```sql
-- Description: For each actor, find the maximum gap and count actors whose largest gap ≤ 4 years (i.e., no four-year span without a movie).
WITH actor_years AS (
    SELECT c."PID",
           CAST(m."year" AS INTEGER) AS yr
    FROM   "M_Cast" AS c
    JOIN   "Movie"  AS m ON m."MID" = c."MID"
    GROUP  BY c."PID", yr
),
gaps AS (
    SELECT ay."PID",
           ay.yr,
           LAG(ay.yr) OVER (PARTITION BY ay."PID" ORDER BY ay.yr) AS prev_yr
    FROM   actor_years AS ay
),
max_gap AS (
    SELECT "PID",
           MAX(yr - prev_yr) AS largest_gap
    FROM   gaps
    GROUP  BY "PID"
)
SELECT COUNT(*) AS actors_without_four_year_gap
FROM   max_gap
WHERE  largest_gap <= 4
LIMIT 20;
```
