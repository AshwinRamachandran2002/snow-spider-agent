-- Description: Build a sample list of each actor’s distinct credit years, using TRIM()
--              so the “PID” value is space-free and consistent across queries.
WITH actor_years AS (
    SELECT TRIM(c."PID")                 AS "PID",
           CAST(m."year" AS INTEGER)     AS yr
    FROM   "M_Cast" AS c
    JOIN   "Movie"  AS m ON m."MID" = c."MID"
    GROUP  BY "PID", yr                  -- one row per actor per year
)
SELECT *
FROM   actor_years
ORDER  BY "PID", yr
LIMIT 20
