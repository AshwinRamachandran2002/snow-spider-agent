Query:
-- Description: List the distinct credit years for “Christian Bale”, fixing the join by
--              trimming the leading space in M_Cast."PID".
SELECT DISTINCT CAST(m."year" AS INTEGER) AS credit_year
FROM   "Person"  AS p
JOIN   "M_Cast"  AS c ON p."PID" = TRIM(c."PID")
JOIN   "Movie"   AS m ON m."MID" = c."MID"
WHERE  p."Name" LIKE '%Christian Bale%'
ORDER  BY credit_year
LIMIT 20
