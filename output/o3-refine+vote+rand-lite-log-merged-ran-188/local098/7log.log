Query:
-- Description: Count how many actors never have a gap longer than 3 consecutive years
--              (i.e., maximum gap ≤ 4) in their active careers, using trimmed PIDs.
WITH actor_years AS (
    SELECT TRIM(c."PID")             AS "PID",
           CAST(m."year" AS INTEGER) AS yr
    FROM   "M_Cast" AS c
    JOIN   "Movie"  AS m ON m."MID" = c."MID"
    GROUP  BY "PID", yr
),
gaps AS (
    SELECT ay."PID",
           ay.yr,
           LAG(ay.yr) OVER (PARTITION BY ay."PID" ORDER BY ay.yr) AS prev_yr
    FROM   actor_years AS ay
),
max_gap AS (
    SELECT "PID",
           MAX(yr - prev_yr) AS largest_gap
    FROM   gaps
    GROUP  BY "PID"
)
SELECT COUNT(*) AS actors_without_four_year_gap
FROM   max_gap
WHERE  largest_gap <= 4
LIMIT 20
