Query:
-- Description: Compute year-to-year gaps for every actor; TRIM() keeps the PID format
--              consistent with other queries.
WITH actor_years AS (
    SELECT TRIM(c."PID")             AS "PID",
           CAST(m."year" AS INTEGER) AS yr
    FROM   "M_Cast" AS c
    JOIN   "Movie"  AS m ON m."MID" = c."MID"
    GROUP  BY "PID", yr
),
gaps AS (
    SELECT ay."PID",
           ay.yr,
           LAG(ay.yr) OVER (PARTITION BY ay."PID" ORDER BY ay.yr) AS prev_yr
    FROM   actor_years AS ay
)
SELECT "PID",
       yr,
       COALESCE(yr - prev_yr, 0) AS gap_size
FROM   gaps
ORDER  BY "PID", yr
LIMIT 20
