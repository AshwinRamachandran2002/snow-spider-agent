--10)  Convert projected 2021 monthly averages to USD and return their MEDIAN
WITH base AS (
    /* compute projected 2021 avg (local) exactly as in step-9 */
    SELECT strftime('%m', t."time_id") AS "month",
           AVG(CASE WHEN strftime('%Y', t."time_id") = '2019' THEN s."amount_sold" END) AS "avg19",
           AVG(CASE WHEN strftime('%Y', t."time_id") = '2020' THEN s."amount_sold" END) AS "avg20"
    FROM   "sales"      AS s
    JOIN   "customers"  AS cu ON cu."cust_id"   = s."cust_id"
    JOIN   "countries"  AS co ON co."country_id"= cu."country_id"
    JOIN   "promotions" AS p  ON p."promo_id"   = s."promo_id"
    JOIN   "channels"   AS ch ON ch."channel_id"= s."channel_id"
    JOIN   "times"      AS t  ON t."time_id"    = s."time_id"
    WHERE  co."country_name"  = 'France'
      AND  p."promo_total_id" = 1
      AND  ch."channel_total_id" = 1
      AND  strftime('%Y', t."time_id") IN ('2019','2020')
    GROUP BY 1
),
proj AS (
    /* projected 2021 avg in local currency */
    SELECT b."month",
           b."avg20" * (b."avg20" / b."avg19") AS "proj21_local"
    FROM   base AS b
),
proj_usd AS (
    /* attach exchange rate of 2020 (latest known) to convert to USD */
    SELECT p."month",
           p."proj21_local",
           c."to_us",
           p."proj21_local" * c."to_us" AS "proj21_usd"
    FROM   proj AS p
    JOIN   "currency" AS c
         ON c."country" = 'France'
        AND c."year"    = 2020
        AND printf('%02d', c."month") = p."month"
)
SELECT /* median of 12 monthly values */
       AVG("proj21_usd") AS "median_monthly_proj_sales_usd"
FROM   (
        SELECT pu."proj21_usd",
               ROW_NUMBER() OVER (ORDER BY pu."proj21_usd")          AS rn,
               COUNT(*)     OVER ()                                  AS cnt
        FROM   proj_usd AS pu
     )
WHERE  rn IN ( cnt/2, cnt/2 + 1 );   -- standard median logic for even-sized set
