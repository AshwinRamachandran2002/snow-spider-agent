-- 9)  Derive monthly growth rates (2020 ÷ 2019) and project 2021
WITH yr AS (
    SELECT strftime('%m', t."time_id") AS "month",
           AVG(CASE WHEN strftime('%Y', t."time_id") = '2019' THEN s."amount_sold" END) AS "avg19",
           AVG(CASE WHEN strftime('%Y', t."time_id") = '2020' THEN s."amount_sold" END) AS "avg20"
    FROM   "sales"      AS s
    JOIN   "customers"  AS cu ON cu."cust_id"   = s."cust_id"
    JOIN   "countries"  AS co ON co."country_id"= cu."country_id"
    JOIN   "promotions" AS p  ON p."promo_id"   = s."promo_id"
    JOIN   "channels"   AS ch ON ch."channel_id"= s."channel_id"
    JOIN   "times"      AS t  ON t."time_id"    = s."time_id"
    WHERE  co."country_name"  = 'France'
      AND  p."promo_total_id" = 1
      AND  ch."channel_total_id" = 1
      AND  strftime('%Y', t."time_id") IN ('2019','2020')
    GROUP BY 1
)
SELECT y."month",
       y."avg19",
       y."avg20",
       (y."avg20" / y."avg19")                              AS "growth_factor",
       y."avg20" * (y."avg20" / y."avg19")                  AS "proj21_local"
FROM   yr AS y
ORDER BY y."month";
