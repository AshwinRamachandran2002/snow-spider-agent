Query:
-- 8)  Bring in the currency table to convert both 2019 & 2020 monthly
--     averages to USD
SELECT tmp."year",
       tmp."month",
       tmp."avg_local",
       c."to_us",
       tmp."avg_local" * c."to_us" AS "avg_usd"
FROM (
        SELECT strftime('%Y', t."time_id") AS "year",
               strftime('%m', t."time_id") AS "month",
               AVG(s."amount_sold")       AS "avg_local"
        FROM   "sales"      AS s
        JOIN   "customers"  AS cu ON cu."cust_id"   = s."cust_id"
        JOIN   "countries"  AS co ON co."country_id"= cu."country_id"
        JOIN   "promotions" AS p  ON p."promo_id"   = s."promo_id"
        JOIN   "channels"   AS ch ON ch."channel_id"= s."channel_id"
        JOIN   "times"      AS t  ON t."time_id"    = s."time_id"
        WHERE  co."country_name"  = 'France'
          AND  p."promo_total_id" = 1
          AND  ch."channel_total_id" = 1
          AND  strftime('%Y', t."time_id") IN ('2019','2020')
        GROUP BY 1,2
     ) AS tmp
JOIN "currency" AS c
     ON c."country" = 'France'
    AND c."year"    = tmp."year"
    AND printf('%02d', c."month") = tmp."month"
ORDER BY tmp."year", tmp."month"
LIMIT 20;
