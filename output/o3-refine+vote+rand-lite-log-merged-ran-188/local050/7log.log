```sql
-- 5)  Look at a few raw sales rows for French customers, restricted to 2019-20,
--     and already filtered to “total” promos & channels
SELECT s.*
FROM   "sales"      AS s
JOIN   "customers"  AS cu ON cu."cust_id"   = s."cust_id"
JOIN   "countries"  AS co ON co."country_id"= cu."country_id"
JOIN   "promotions" AS p  ON p."promo_id"   = s."promo_id"
JOIN   "channels"   AS ch ON ch."channel_id"= s."channel_id"
JOIN   "times"      AS t  ON t."time_id"    = s."time_id"
WHERE  co."country_name"  = 'France'
  AND  p."promo_total_id" = 1
  AND  ch."channel_total_id" = 1
  AND  strftime('%Y', t."time_id") IN ('2019','2020')
LIMIT 20;
```

```sql
-- 6)  Compute the average monthly SALES (already in local currency) for 2019
SELECT strftime('%m', t."time_id") AS "month",
       AVG(s."amount_sold")        AS "avg_amount_2019"
FROM   "sales"      AS s
JOIN   "customers"  AS cu ON cu."cust_id"   = s."cust_id"
JOIN   "countries"  AS co ON co."country_id"= cu."country_id"
JOIN   "promotions" AS p  ON p."promo_id"   = s."promo_id"
JOIN   "channels"   AS ch ON ch."channel_id"= s."channel_id"
JOIN   "times"      AS t  ON t."time_id"    = s."time_id"
WHERE  co."country_name"  = 'France'
  AND  p."promo_total_id" = 1
  AND  ch."channel_total_id" = 1
  AND  strftime('%Y', t."time_id") = '2019'
GROUP BY 1
ORDER BY 1;
```

```sql
-- 7)  Compute the average monthly SALES for 2020
SELECT strftime('%m', t."time_id") AS "month",
       AVG(s."amount_sold")        AS "avg_amount_2020"
FROM   "sales"      AS s
JOIN   "customers"  AS cu ON cu."cust_id"   = s."cust_id"
JOIN   "countries"  AS co ON co."country_id"= cu."country_id"
JOIN   "promotions" AS p  ON p."promo_id"   = s."promo_id"
JOIN   "channels"   AS ch ON ch."channel_id"= s."channel_id"
JOIN   "times"      AS t  ON t."time_id"    = s."time_id"
WHERE  co."country_name"  = 'France'
  AND  p."promo_total_id" = 1
  AND  ch."channel_total_id" = 1
  AND  strftime('%Y', t."time_id") = '2020'
GROUP BY 1
ORDER BY 1;
```

```sql
-- 8)  Bring in the currency table to convert both 2019 & 2020 monthly
--     averages to USD
SELECT tmp."year",
       tmp."month",
       tmp."avg_local",
       c."to_us",
       tmp."avg_local" * c."to_us" AS "avg_usd"
FROM (
        SELECT strftime('%Y', t."time_id") AS "year",
               strftime('%m', t."time_id") AS "month",
               AVG(s."amount_sold")       AS "avg_local"
        FROM   "sales"      AS s
        JOIN   "customers"  AS cu ON cu."cust_id"   = s."cust_id"
        JOIN   "countries"  AS co ON co."country_id"= cu."country_id"
        JOIN   "promotions" AS p  ON p."promo_id"   = s."promo_id"
        JOIN   "channels"   AS ch ON ch."channel_id"= s."channel_id"
        JOIN   "times"      AS t  ON t."time_id"    = s."time_id"
        WHERE  co."country_name"  = 'France'
          AND  p."promo_total_id" = 1
          AND  ch."channel_total_id" = 1
          AND  strftime('%Y', t."time_id") IN ('2019','2020')
        GROUP BY 1,2
     ) AS tmp
JOIN "currency" AS c
     ON c."country" = 'France'
    AND c."year"    = tmp."year"
    AND printf('%02d', c."month") = tmp."month"
ORDER BY tmp."year", tmp."month"
LIMIT 20;
```

```sql
-- 9)  Derive monthly growth rates (2020 ÷ 2019) and project 2021
WITH yr AS (
    SELECT strftime('%m', t."time_id") AS "month",
           AVG(CASE WHEN strftime('%Y', t."time_id") = '2019' THEN s."amount_sold" END) AS "avg19",
           AVG(CASE WHEN strftime('%Y', t."time_id") = '2020' THEN s."amount_sold" END) AS "avg20"
    FROM   "sales"      AS s
    JOIN   "customers"  AS cu ON cu."cust_id"   = s."cust_id"
    JOIN   "countries"  AS co ON co."country_id"= cu."country_id"
    JOIN   "promotions" AS p  ON p."promo_id"   = s."promo_id"
    JOIN   "channels"   AS ch ON ch."channel_id"= s."channel_id"
    JOIN   "times"      AS t  ON t."time_id"    = s."time_id"
    WHERE  co."country_name"  = 'France'
      AND  p."promo_total_id" = 1
      AND  ch."channel_total_id" = 1
      AND  strftime('%Y', t."time_id") IN ('2019','2020')
    GROUP BY 1
)
SELECT y."month",
       y."avg19",
       y."avg20",
       (y."avg20" / y."avg19")                              AS "growth_factor",
       y."avg20" * (y."avg20" / y."avg19")                  AS "proj21_local"
FROM   yr AS y
ORDER BY y."month";
```

```sql
--10)  Convert projected 2021 monthly averages to USD and return their MEDIAN
WITH base AS (
    /* compute projected 2021 avg (local) exactly as in step-9 */
    SELECT strftime('%m', t."time_id") AS "month",
           AVG(CASE WHEN strftime('%Y', t."time_id") = '2019' THEN s."amount_sold" END) AS "avg19",
           AVG(CASE WHEN strftime('%Y', t."time_id") = '2020' THEN s."amount_sold" END) AS "avg20"
    FROM   "sales"      AS s
    JOIN   "customers"  AS cu ON cu."cust_id"   = s."cust_id"
    JOIN   "countries"  AS co ON co."country_id"= cu."country_id"
    JOIN   "promotions" AS p  ON p."promo_id"   = s."promo_id"
    JOIN   "channels"   AS ch ON ch."channel_id"= s."channel_id"
    JOIN   "times"      AS t  ON t."time_id"    = s."time_id"
    WHERE  co."country_name"  = 'France'
      AND  p."promo_total_id" = 1
      AND  ch."channel_total_id" = 1
      AND  strftime('%Y', t."time_id") IN ('2019','2020')
    GROUP BY 1
),
proj AS (
    /* projected 2021 avg in local currency */
    SELECT b."month",
           b."avg20" * (b."avg20" / b."avg19") AS "proj21_local"
    FROM   base AS b
),
proj_usd AS (
    /* attach exchange rate of 2020 (latest known) to convert to USD */
    SELECT p."month",
           p."proj21_local",
           c."to_us",
           p."proj21_local" * c."to_us" AS "proj21_usd"
    FROM   proj AS p
    JOIN   "currency" AS c
         ON c."country" = 'France'
        AND c."year"    = 2020
        AND printf('%02d', c."month") = p."month"
)
SELECT /* median of 12 monthly values */
       AVG("proj21_usd") AS "median_monthly_proj_sales_usd"
FROM   (
        SELECT pu."proj21_usd",
               ROW_NUMBER() OVER (ORDER BY pu."proj21_usd")          AS rn,
               COUNT(*)     OVER ()                                  AS cnt
        FROM   proj_usd AS pu
     )
WHERE  rn IN ( cnt/2, cnt/2 + 1 );   -- standard median logic for even-sized set
```
