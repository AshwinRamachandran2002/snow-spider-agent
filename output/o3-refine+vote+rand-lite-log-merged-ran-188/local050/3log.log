```sql
-- 4) Description: Show a few sales rows that belong to French customers
--                 and also satisfy promo_total_id = 1 and channel_total_id = 1.
SELECT s.*, p.promo_total_id, c.channel_total_id
FROM   sales      AS s
JOIN   customers  AS cu ON cu.cust_id  = s.cust_id
JOIN   countries  AS co ON co.country_id = cu.country_id
JOIN   promotions AS p  ON p.promo_id = s.promo_id
JOIN   channels   AS c  ON c.channel_id = s.channel_id
WHERE  co.country_name = 'France'
  AND  p.promo_total_id    = 1
  AND  c.channel_total_id  = 1
LIMIT 20;
```

```sql
-- 5) Description: 2019 monthly TOTAL sales (local currency) for France
--                 with the required promo/channel filters.
SELECT strftime('%m', s.time_id) AS month,
       SUM(s.amount_sold)        AS month_total_2019
FROM   sales      AS s
JOIN   customers  AS cu ON cu.cust_id   = s.cust_id
JOIN   countries  AS co ON co.country_id = cu.country_id
JOIN   promotions AS p  ON p.promo_id    = s.promo_id
JOIN   channels   AS ch ON ch.channel_id = s.channel_id
WHERE  co.country_name     = 'France'
  AND  p.promo_total_id     = 1
  AND  ch.channel_total_id  = 1
  AND  strftime('%Y', s.time_id) = '2019'
GROUP  BY month
ORDER  BY month
LIMIT 20;
```

```sql
-- 6) Description: 2020 monthly TOTAL sales (local currency) for France
--                 with the same filters.
SELECT strftime('%m', s.time_id) AS month,
       SUM(s.amount_sold)        AS month_total_2020
FROM   sales      AS s
JOIN   customers  AS cu ON cu.cust_id   = s.cust_id
JOIN   countries  AS co ON co.country_id = cu.country_id
JOIN   promotions AS p  ON p.promo_id    = s.promo_id
JOIN   channels   AS ch ON ch.channel_id = s.channel_id
WHERE  co.country_name     = 'France'
  AND  p.promo_total_id     = 1
  AND  ch.channel_total_id  = 1
  AND  strftime('%Y', s.time_id) = '2020'
GROUP  BY month
ORDER  BY month
LIMIT 20;
```

```sql
-- 7) Description: Compute the month-by-month growth factor 
--                 from 2019 to 2020 for France.
WITH y19 AS (
     SELECT strftime('%m', s.time_id) AS month,
            SUM(s.amount_sold)        AS total_2019
     FROM   sales s
     JOIN   customers cu  ON cu.cust_id = s.cust_id
     JOIN   countries co  ON co.country_id = cu.country_id
     JOIN   promotions p  ON p.promo_id = s.promo_id
     JOIN   channels   ch ON ch.channel_id = s.channel_id
     WHERE  co.country_name   = 'France'
       AND  p.promo_total_id  = 1
       AND  ch.channel_total_id = 1
       AND  strftime('%Y', s.time_id) = '2019'
     GROUP  BY month
),
y20 AS (
     SELECT strftime('%m', s.time_id) AS month,
            SUM(s.amount_sold)        AS total_2020
     FROM   sales s
     JOIN   customers cu  ON cu.cust_id = s.cust_id
     JOIN   countries co  ON co.country_id = cu.country_id
     JOIN   promotions p  ON p.promo_id = s.promo_id
     JOIN   channels   ch ON ch.channel_id = s.channel_id
     WHERE  co.country_name   = 'France'
       AND  p.promo_total_id  = 1
       AND  ch.channel_total_id = 1
       AND  strftime('%Y', s.time_id) = '2020'
     GROUP  BY month
)
SELECT y19.month,
       total_2019,
       total_2020,
       ROUND(total_2020 * 1.0 / NULLIF(total_2019,0), 4) AS growth_factor
FROM   y19
JOIN   y20 USING (month)
ORDER BY month
LIMIT 20;
```

```sql
-- 8) Description: Project 2021 monthly sales (local currency)
--                 by applying the growth factor again to 2020 totals.
WITH y19 AS (
     SELECT strftime('%m', s.time_id) AS month,
            SUM(s.amount_sold) AS tot_2019
     FROM   sales s
     JOIN   customers cu  ON cu.cust_id = s.cust_id
     JOIN   countries co  ON co.country_id = cu.country_id
     JOIN   promotions p  ON p.promo_id = s.promo_id
     JOIN   channels   ch ON ch.channel_id = s.channel_id
     WHERE  co.country_name   = 'France'
       AND  p.promo_total_id  = 1
       AND  ch.channel_total_id = 1
       AND  strftime('%Y', s.time_id) = '2019'
     GROUP  BY month
),
y20 AS (
     SELECT strftime('%m', s.time_id) AS month,
            SUM(s.amount_sold) AS tot_2020
     FROM   sales s
     JOIN   customers cu  ON cu.cust_id = s.cust_id
     JOIN   countries co  ON co.country_id = cu.country_id
     JOIN   promotions p  ON p.promo_id = s.promo_id
     JOIN   channels   ch ON ch.channel_id = s.channel_id
     WHERE  co.country_name   = 'France'
       AND  p.promo_total_id  = 1
       AND  ch.channel_total_id = 1
       AND  strftime('%Y', s.time_id) = '2020'
     GROUP  BY month
)
SELECT y20.month,
       tot_2020,
       ROUND(tot_2020 * (tot_2020 * 1.0 / NULLIF(tot_2019,0)), 2) AS projected_2021_local
FROM   y20
JOIN   y19 USING (month)
ORDER BY month
LIMIT 20;
```

```sql
-- 9) Description: Show France’s FX rate (to_us) for each month of 2020
--                 (assuming the 2021 rate will stay the same).
SELECT year, month, to_us
FROM   currency
WHERE  country = 'France'
  AND  year = 2020
LIMIT 20;
```

```sql
-- 10) Description: Project 2021 monthly sales in USD for France,
--                  then take the median of the 12 projected monthly averages.
WITH y19 AS (
     SELECT strftime('%m', s.time_id) AS month,
            SUM(s.amount_sold) AS tot_2019
     FROM   sales s
     JOIN   customers cu  ON cu.cust_id = s.cust_id
     JOIN   countries co  ON co.country_id = cu.country_id
     JOIN   promotions p  ON p.promo_id = s.promo_id
     JOIN   channels   ch ON ch.channel_id = s.channel_id
     WHERE  co.country_name   = 'France'
       AND  p.promo_total_id  = 1
       AND  ch.channel_total_id = 1
       AND  strftime('%Y', s.time_id) = '2019'
     GROUP  BY month
),
y20 AS (
     SELECT strftime('%m', s.time_id) AS month,
            SUM(s.amount_sold) AS tot_2020
     FROM   sales s
     JOIN   customers cu  ON cu.cust_id = s.cust_id
     JOIN   countries co  ON co.country_id = cu.country_id
     JOIN   promotions p  ON p.promo_id = s.promo_id
     JOIN   channels   ch ON ch.channel_id = s.channel_id
     WHERE  co.country_name   = 'France'
       AND  p.promo_total_id  = 1
       AND  ch.channel_total_id = 1
       AND  strftime('%Y', s.time_id) = '2020'
     GROUP  BY month
),
proj AS (
     SELECT y20.month,
            ROUND(tot_2020 * (tot_2020 * 1.0 / NULLIF(tot_2019,0)), 2) AS proj_2021_local
     FROM   y20 JOIN y19 USING (month)
),
proj_usd AS (
     SELECT p.month,
            p.proj_2021_local * c.to_us AS proj_2021_usd
     FROM   proj p
     JOIN   currency c
           ON c.country = 'France'
          AND c.year    = 2020      -- assume same rate for 2021
          AND c.month   = CAST(p.month AS INTEGER)
)
SELECT
       -- median of 12 projected monthly USD amounts
       (SELECT AVG(proj_2021_usd)
        FROM (
              SELECT proj_2021_usd
              FROM   proj_usd
              ORDER BY proj_2021_usd
              LIMIT 2 - (SELECT COUNT(*) FROM proj_usd) % 2      -- odd/even handling
              OFFSET (SELECT (COUNT(*) - 1) / 2 FROM proj_usd)
        )
       ) AS median_projected_2021_usd
FROM proj_usd
LIMIT 20;
```
