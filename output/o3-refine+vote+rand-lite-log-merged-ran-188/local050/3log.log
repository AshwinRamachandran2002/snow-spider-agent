-- 7) Description: Compute the month-by-month growth factor 
--                 from 2019 to 2020 for France.
WITH y19 AS (
     SELECT strftime('%m', s.time_id) AS month,
            SUM(s.amount_sold)        AS total_2019
     FROM   sales s
     JOIN   customers cu  ON cu.cust_id = s.cust_id
     JOIN   countries co  ON co.country_id = cu.country_id
     JOIN   promotions p  ON p.promo_id = s.promo_id
     JOIN   channels   ch ON ch.channel_id = s.channel_id
     WHERE  co.country_name   = 'France'
       AND  p.promo_total_id  = 1
       AND  ch.channel_total_id = 1
       AND  strftime('%Y', s.time_id) = '2019'
     GROUP  BY month
),
y20 AS (
     SELECT strftime('%m', s.time_id) AS month,
            SUM(s.amount_sold)        AS total_2020
     FROM   sales s
     JOIN   customers cu  ON cu.cust_id = s.cust_id
     JOIN   countries co  ON co.country_id = cu.country_id
     JOIN   promotions p  ON p.promo_id = s.promo_id
     JOIN   channels   ch ON ch.channel_id = s.channel_id
     WHERE  co.country_name   = 'France'
       AND  p.promo_total_id  = 1
       AND  ch.channel_total_id = 1
       AND  strftime('%Y', s.time_id) = '2020'
     GROUP  BY month
)
SELECT y19.month,
       total_2019,
       total_2020,
       ROUND(total_2020 * 1.0 / NULLIF(total_2019,0), 4) AS growth_factor
FROM   y19
JOIN   y20 USING (month)
ORDER BY month
LIMIT 20;
