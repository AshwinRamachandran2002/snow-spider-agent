-- 10) Description: Project 2021 monthly sales in USD for France,
--                  then take the median of the 12 projected monthly averages.
WITH y19 AS (
     SELECT strftime('%m', s.time_id) AS month,
            SUM(s.amount_sold) AS tot_2019
     FROM   sales s
     JOIN   customers cu  ON cu.cust_id = s.cust_id
     JOIN   countries co  ON co.country_id = cu.country_id
     JOIN   promotions p  ON p.promo_id = s.promo_id
     JOIN   channels   ch ON ch.channel_id = s.channel_id
     WHERE  co.country_name   = 'France'
       AND  p.promo_total_id  = 1
       AND  ch.channel_total_id = 1
       AND  strftime('%Y', s.time_id) = '2019'
     GROUP  BY month
),
y20 AS (
     SELECT strftime('%m', s.time_id) AS month,
            SUM(s.amount_sold) AS tot_2020
     FROM   sales s
     JOIN   customers cu  ON cu.cust_id = s.cust_id
     JOIN   countries co  ON co.country_id = cu.country_id
     JOIN   promotions p  ON p.promo_id = s.promo_id
     JOIN   channels   ch ON ch.channel_id = s.channel_id
     WHERE  co.country_name   = 'France'
       AND  p.promo_total_id  = 1
       AND  ch.channel_total_id = 1
       AND  strftime('%Y', s.time_id) = '2020'
     GROUP  BY month
),
proj AS (
     SELECT y20.month,
            ROUND(tot_2020 * (tot_2020 * 1.0 / NULLIF(tot_2019,0)), 2) AS proj_2021_local
     FROM   y20 JOIN y19 USING (month)
),
proj_usd AS (
     SELECT p.month,
            p.proj_2021_local * c.to_us AS proj_2021_usd
     FROM   proj p
     JOIN   currency c
           ON c.country = 'France'
          AND c.year    = 2020      -- assume same rate for 2021
          AND c.month   = CAST(p.month AS INTEGER)
)
SELECT
       -- median of 12 projected monthly USD amounts
       (SELECT AVG(proj_2021_usd)
        FROM (
              SELECT proj_2021_usd
              FROM   proj_usd
              ORDER BY proj_2021_usd
              LIMIT 2 - (SELECT COUNT(*) FROM proj_usd) % 2      -- odd/even handling
              OFFSET (SELECT (COUNT(*) - 1) / 2 FROM proj_usd)
        )
       ) AS median_projected_2021_usd
FROM proj_usd
LIMIT 20;
