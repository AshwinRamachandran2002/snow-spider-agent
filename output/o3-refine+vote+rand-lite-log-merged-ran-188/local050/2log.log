  AND p.promo_total_id = 1
  AND ch.channel_total_id = 1
GROUP BY year_month
LIMIT 20;
```

```sql
--Description: Month-wise growth rate from 2019→2020 and the corresponding projected 2021 average
WITH m19 AS (
  SELECT substr(s.time_id, 1, 7) AS ym,
         AVG(s.amount_sold)      AS avg19
  FROM sales      AS s
  JOIN customers  AS c  ON s.cust_id  = c.cust_id
  JOIN promotions AS p  ON s.promo_id = p.promo_id
  JOIN channels   AS ch ON s.channel_id = ch.channel_id
  WHERE c.country_id IN (SELECT country_id FROM countries WHERE country_name = 'France')
    AND substr(s.time_id, 1, 4) = '2019'
    AND p.promo_total_id = 1
    AND ch.channel_total_id = 1
  GROUP BY ym
),
m20 AS (
  SELECT substr(s.time_id, 1, 7) AS ym,
         AVG(s.amount_sold)      AS avg20
  FROM sales      AS s
  JOIN customers  AS c  ON s.cust_id  = c.cust_id
  JOIN promotions AS p  ON s.promo_id = p.promo_id
  JOIN channels   AS ch ON s.channel_id = ch.channel_id
  WHERE c.country_id IN (SELECT country_id FROM countries WHERE country_name = 'France')
    AND substr(s.time_id, 1, 4) = '2020'
    AND p.promo_total_id = 1
    AND ch.channel_total_id = 1
  GROUP BY ym
)
SELECT m20.ym                                           AS year_month,
       m19.avg19,
       m20.avg20,
       CASE WHEN m19.avg19 IS NOT NULL
             AND m19.avg19 != 0
            THEN m20.avg20 * 1.0 / m19.avg19 END       AS growth_rate,
       CASE WHEN m19.avg19 IS NOT NULL
             AND m19.avg19 != 0
            THEN m20.avg20 * 1.0 / m19.avg19 * m20.avg20 END AS projected_2021
FROM m20
JOIN m19 ON substr(m20.ym, 6, 2) = substr(m19.ym, 6, 2)
LIMIT 20;
```

