-- 8) Description: Project 2021 monthly sales (local currency) using the 2019→2020 growth
WITH sales19 AS (
   SELECT t.calendar_month_number AS month,
          SUM(s.amount_sold)      AS amt2019
   FROM   sales s
   JOIN   customers c ON s.cust_id = c.cust_id
   JOIN   countries cn ON c.country_id = cn.country_id
   JOIN   channels ch  ON s.channel_id = ch.channel_id
   JOIN   promotions p ON s.promo_id  = p.promo_id
   JOIN   times t      ON s.time_id   = t.time_id
   WHERE  cn.country_name     = 'France'
     AND  ch.channel_total_id = 1
     AND  p.promo_total_id    = 1
     AND  t.calendar_year     = 2019
   GROUP BY month
),
sales20 AS (
   SELECT t.calendar_month_number AS month,
          SUM(s.amount_sold)      AS amt2020
   FROM   sales s
   JOIN   customers c ON s.cust_id = c.cust_id
   JOIN   countries cn ON c.country_id = cn.country_id
   JOIN   channels ch  ON s.channel_id = ch.channel_id
   JOIN   promotions p ON s.promo_id  = p.promo_id
   JOIN   times t      ON s.time_id   = t.time_id
   WHERE  cn.country_name     = 'France'
     AND  ch.channel_total_id = 1
     AND  p.promo_total_id    = 1
     AND  t.calendar_year     = 2020
   GROUP BY month
)
SELECT s20.month,
       s20.amt2020,
       CASE WHEN s19.amt2019 > 0
            THEN s20.amt2020 * (s20.amt2020 / s19.amt2019)
       END AS projected_2021_local
FROM   sales19 s19
JOIN   sales20 s20 USING (month)
LIMIT 20;
