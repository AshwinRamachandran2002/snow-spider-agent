```sql
-- 3) Description: List every promotion that is marked as “Promotion total” (promo_total_id = 1)
SELECT DISTINCT promo_id,
                promo_name
FROM promotions
WHERE promo_total_id = 1
LIMIT 20;
```

```sql
-- 4) Description: Show a few raw sales lines for France in 2019 that match the required
--    channel & promotion filters
SELECT s.*
FROM   sales       AS s
JOIN   customers   AS c   ON s.cust_id  = c.cust_id
JOIN   countries   AS cn  ON c.country_id = cn.country_id
JOIN   channels    AS ch  ON s.channel_id = ch.channel_id
JOIN   promotions  AS p   ON s.promo_id   = p.promo_id
WHERE  cn.country_name   = 'France'
  AND  ch.channel_total_id = 1
  AND  p.promo_total_id    = 1
  AND  s.time_id LIKE '2019-%'
LIMIT 20;
```

```sql
-- 5) Description: Aggregate monthly sales (total amount_sold) for France in 2019
SELECT t.calendar_month_number AS month,
       SUM(s.amount_sold)      AS total_amount_2019
FROM   sales       AS s
JOIN   customers   AS c   ON s.cust_id  = c.cust_id
JOIN   countries   AS cn  ON c.country_id = cn.country_id
JOIN   channels    AS ch  ON s.channel_id = ch.channel_id
JOIN   promotions  AS p   ON s.promo_id   = p.promo_id
JOIN   times       AS t   ON s.time_id    = t.time_id
WHERE  cn.country_name      = 'France'
  AND  ch.channel_total_id  = 1
  AND  p.promo_total_id     = 1
  AND  t.calendar_year      = 2019
GROUP  BY t.calendar_month_number
ORDER  BY t.calendar_month_number
LIMIT 20;
```

```sql
-- 6) Description: Aggregate monthly sales (total amount_sold) for France in 2020
SELECT t.calendar_month_number AS month,
       SUM(s.amount_sold)      AS total_amount_2020
FROM   sales       AS s
JOIN   customers   AS c   ON s.cust_id  = c.cust_id
JOIN   countries   AS cn  ON c.country_id = cn.country_id
JOIN   channels    AS ch  ON s.channel_id = ch.channel_id
JOIN   promotions  AS p   ON s.promo_id   = p.promo_id
JOIN   times       AS t   ON s.time_id    = t.time_id
WHERE  cn.country_name      = 'France'
  AND  ch.channel_total_id  = 1
  AND  p.promo_total_id     = 1
  AND  t.calendar_year      = 2020
GROUP  BY t.calendar_month_number
ORDER  BY t.calendar_month_number
LIMIT 20;
```

```sql
-- 7) Description: Calculate the growth rate from 2019 to 2020 for each month
WITH sales19 AS (
   SELECT t.calendar_month_number AS month,
          SUM(s.amount_sold)      AS amt2019
   FROM   sales s
   JOIN   customers c   ON s.cust_id = c.cust_id
   JOIN   countries cn  ON c.country_id = cn.country_id
   JOIN   channels ch   ON s.channel_id = ch.channel_id
   JOIN   promotions p  ON s.promo_id  = p.promo_id
   JOIN   times t       ON s.time_id   = t.time_id
   WHERE  cn.country_name     = 'France'
     AND  ch.channel_total_id = 1
     AND  p.promo_total_id    = 1
     AND  t.calendar_year     = 2019
   GROUP BY month
),
sales20 AS (
   SELECT t.calendar_month_number AS month,
          SUM(s.amount_sold)      AS amt2020
   FROM   sales s
   JOIN   customers c   ON s.cust_id = c.cust_id
   JOIN   countries cn  ON c.country_id = cn.country_id
   JOIN   channels ch   ON s.channel_id = ch.channel_id
   JOIN   promotions p  ON s.promo_id  = p.promo_id
   JOIN   times t       ON s.time_id   = t.time_id
   WHERE  cn.country_name     = 'France'
     AND  ch.channel_total_id = 1
     AND  p.promo_total_id    = 1
     AND  t.calendar_year     = 2020
   GROUP BY month
)
SELECT s19.month,
       s19.amt2019,
       s20.amt2020,
       CASE WHEN s19.amt2019 > 0
            THEN (s20.amt2020 - s19.amt2019) / s19.amt2019
       END AS growth_rate
FROM   sales19 s19
LEFT   JOIN sales20 s20 USING (month)
LIMIT 20;
```

```sql
-- 8) Description: Project 2021 monthly sales (local currency) using the 2019→2020 growth
WITH sales19 AS (
   SELECT t.calendar_month_number AS month,
          SUM(s.amount_sold)      AS amt2019
   FROM   sales s
   JOIN   customers c ON s.cust_id = c.cust_id
   JOIN   countries cn ON c.country_id = cn.country_id
   JOIN   channels ch  ON s.channel_id = ch.channel_id
   JOIN   promotions p ON s.promo_id  = p.promo_id
   JOIN   times t      ON s.time_id   = t.time_id
   WHERE  cn.country_name     = 'France'
     AND  ch.channel_total_id = 1
     AND  p.promo_total_id    = 1
     AND  t.calendar_year     = 2019
   GROUP BY month
),
sales20 AS (
   SELECT t.calendar_month_number AS month,
          SUM(s.amount_sold)      AS amt2020
   FROM   sales s
   JOIN   customers c ON s.cust_id = c.cust_id
   JOIN   countries cn ON c.country_id = cn.country_id
   JOIN   channels ch  ON s.channel_id = ch.channel_id
   JOIN   promotions p ON s.promo_id  = p.promo_id
   JOIN   times t      ON s.time_id   = t.time_id
   WHERE  cn.country_name     = 'France'
     AND  ch.channel_total_id = 1
     AND  p.promo_total_id    = 1
     AND  t.calendar_year     = 2020
   GROUP BY month
)
SELECT s20.month,
       s20.amt2020,
       CASE WHEN s19.amt2019 > 0
            THEN s20.amt2020 * (s20.amt2020 / s19.amt2019)
       END AS projected_2021_local
FROM   sales19 s19
JOIN   sales20 s20 USING (month)
LIMIT 20;
```

```sql
-- 9) Description: Show France’s exchange rates in the currency table (needed for USD conversion)
SELECT DISTINCT year,
                month,
                to_us
FROM   currency
WHERE  country = 'France'
ORDER BY year,
         month
LIMIT 20;
```

```sql
-- 10) Description: Convert the projected 2021 numbers to USD, compute each month’s average,
--     then take the median of those 12 monthly averages
WITH sales19 AS (
   SELECT t.calendar_month_number AS month,
          SUM(s.amount_sold)      AS amt2019
   FROM   sales s
   JOIN   customers c ON s.cust_id = c.cust_id
   JOIN   countries cn ON c.country_id = cn.country_id
   JOIN   channels ch  ON s.channel_id = ch.channel_id
   JOIN   promotions p ON s.promo_id  = p.promo_id
   JOIN   times t      ON s.time_id   = t.time_id
   WHERE  cn.country_name     = 'France'
     AND  ch.channel_total_id = 1
     AND  p.promo_total_id    = 1
     AND  t.calendar_year     = 2019
   GROUP BY month
),
sales20 AS (
   SELECT t.calendar_month_number AS month,
          SUM(s.amount_sold)      AS amt2020
   FROM   sales s
   JOIN   customers c ON s.cust_id = c.cust_id
   JOIN   countries cn ON c.country_id = cn.country_id
   JOIN   channels ch  ON s.channel_id = ch.channel_id
   JOIN   promotions p ON s.promo_id  = p.promo_id
   JOIN   times t      ON s.time_id   = t.time_id
   WHERE  cn.country_name     = 'France'
     AND  ch.channel_total_id = 1
     AND  p.promo_total_id    = 1
     AND  t.calendar_year     = 2020
   GROUP BY month
),
proj_local AS (
   SELECT s20.month,
          CASE WHEN s19.amt2019 > 0
               THEN s20.amt2020 * (s20.amt2020 / s19.amt2019)
          END AS projected_2021_local
   FROM  sales19 s19
   JOIN  sales20 s20 USING (month)
),
proj_usd AS (
   SELECT p.month,
          p.projected_2021_local / c.to_us AS projected_2021_usd
   FROM   proj_local p
   JOIN   currency  c
          ON  c.country = 'France'
          AND c.year   = 2021
          AND c.month  = p.month
),
ordered AS (
   SELECT projected_2021_usd,
          ROW_NUMBER() OVER (ORDER BY projected_2021_usd) AS rn,
          COUNT(*)  OVER ()                                AS cnt
   FROM   proj_usd
)
SELECT AVG(projected_2021_usd) AS median_projected_2021_usd
FROM   ordered
WHERE  rn IN (cnt/2, cnt/2 + 1)
LIMIT 20;
```
