```

```sql
-- Description: Retrieve the 2019-2021 exchange rates for France from the currency table (to convert to USD later).
SELECT DISTINCT year, month, to_us
FROM currency
WHERE country = 'France'
  AND year IN (2019, 2020, 2021)
ORDER BY year, month
LIMIT 20;
```

```sql
-- Description: Join everything together for one month (e.g., 2019-01) just to validate the full join logic.  
SELECT DISTINCT substr(s.time_id, 1, 7)               AS year_month,
                SUM(s.amount_sold)                    AS euro_sales,
                curr.to_us                            AS eur_to_usd_rate,
                SUM(s.amount_sold) * curr.to_us       AS usd_sales
FROM   sales      AS s
JOIN   customers  AS c    ON c.cust_id    = s.cust_id
JOIN   countries  AS co   ON co.country_id = c.country_id
JOIN   currency   AS curr ON curr.country = co.country_name
                         AND curr.year    = CAST(substr(s.time_id, 1, 4) AS INTEGER)
                         AND curr.month   = CAST(substr(s.time_id, 6, 2) AS INTEGER)
WHERE  co.country_name = 'France'
  AND  substr(s.time_id, 1, 7) = '2019-01'
  AND  s.promo_id  IN (SELECT promo_id  FROM promotions WHERE promo_total_id = 1)
  AND  s.channel_id IN (SELECT channel_id FROM channels   WHERE channel_total_id = 1)
GROUP  BY year_month, curr.to_us
LIMIT 20;
```
