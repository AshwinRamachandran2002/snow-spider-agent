```sql
-- Description: Inspect a handful of sales made to French customers (no date restriction yet).
SELECT DISTINCT s.prod_id, s.cust_id, s.time_id, s.channel_id, s.promo_id, s.amount_sold
FROM   sales      AS s
JOIN   customers  AS c  ON c.cust_id   = s.cust_id
JOIN   countries  AS co ON co.country_id = c.country_id
WHERE  co.country_name = 'France'
LIMIT 20;
```

```sql
-- Description: Get distinct calendar years that exist in the sales data for French customers.
SELECT DISTINCT substr(s.time_id, 1, 4) AS sales_year
FROM   sales      AS s
JOIN   customers  AS c  ON c.cust_id   = s.cust_id
JOIN   countries  AS co ON co.country_id = c.country_id
WHERE  co.country_name = 'France'
ORDER  BY sales_year
LIMIT 20;
```

```sql
-- Description: Pull monthly Euro sales (amount_sold) of French customers for 2019 that are tagged to the total promo & total channel roll-ups.
SELECT DISTINCT substr(s.time_id, 1, 7) AS year_month, s.amount_sold
FROM   sales      AS s
JOIN   customers  AS c  ON c.cust_id   = s.cust_id
JOIN   countries  AS co ON co.country_id = c.country_id
WHERE  co.country_name = 'France'
  AND  substr(s.time_id, 1, 4) = '2019'
  AND  s.promo_id IN (SELECT promo_id FROM promotions WHERE promo_total_id = 1)
  AND  s.channel_id IN (SELECT channel_id FROM channels   WHERE channel_total_id = 1)
LIMIT 20;
```

```sql
-- Description: Pull monthly Euro sales of French customers for 2020 (same promo/channel filter).
SELECT DISTINCT substr(s.time_id, 1, 7) AS year_month, s.amount_sold
