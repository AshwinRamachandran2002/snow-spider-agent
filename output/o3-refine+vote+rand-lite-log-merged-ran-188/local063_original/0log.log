```sql
WITH sales_base AS (
    /*  Sales in the USA made under promo 999 in the two quarters of interest */
    SELECT  s.prod_id,
            s.cust_id,
            s.amount_sold,
            cu.cust_city,
            t.calendar_quarter_id
    FROM    sales      AS s
    JOIN    customers  AS cu ON cu.cust_id  = s.cust_id
    JOIN    countries  AS co ON co.country_id = cu.country_id
    JOIN    times      AS t  ON t.time_id   = s.time_id
    WHERE   co.country_name          = 'United States'
      AND   s.promo_id               = 999
      AND   t.calendar_quarter_id IN (1772,1776)         -- Q4‑2019 & Q4‑2020
),
/*  How much each city sold in each quarter                                     */
city_qtr AS (
    SELECT  cust_city                 AS city,
            calendar_quarter_id       AS qtr,
            SUM(amount_sold)          AS amt
    FROM    sales_base
    GROUP BY city, qtr
),
/*  Cities whose Q4‑2020 sales are at least 120 % of their Q4‑2019 sales         */
growth_cities AS (
    SELECT  c19.city
    FROM    city_qtr c19
    JOIN    city_qtr c20
           ON c20.city = c19.city
    WHERE   c19.qtr = 1772            -- Q4‑2019
      AND   c20.qtr = 1776            -- Q4‑2020
      AND   c20.amt >= 1.2 * c19.amt
),
/*  Keep only sales that occurred in those growing cities                        */
filtered_sales AS (
    SELECT  sb.*
    FROM    sales_base sb
    WHERE   sb.cust_city IN (SELECT city FROM growth_cities)
),
/*  Product totals per quarter                                                   */
prod_qtr AS (
    SELECT  prod_id,
            calendar_quarter_id       AS qtr,
            SUM(amount_sold)          AS amt
    FROM    filtered_sales
    GROUP BY prod_id, qtr
),
/*  Grand total for each quarter                                                 */
tot_qtr AS (
    SELECT  qtr,
            SUM(amt)                  AS total_amt
    FROM    prod_qtr
    GROUP BY qtr
),
/*  Product share within each quarter                                            */
prod_share AS (
    SELECT  p.prod_id,
            p.qtr,
            p.amt,
            1.0 * p.amt / t.total_amt AS share
    FROM    prod_qtr p
    JOIN    tot_qtr t USING (qtr)
),
/*  Put the two quarters side‑by‑side for every product                          */
prod_cmp AS (
    SELECT  p19.prod_id,
            p19.share                 AS share_2019,
            p20.share                 AS share_2020,
            ABS(p20.share - p19.share)AS abs_change,
            (p19.amt + p20.amt)       AS total_amt_both
    FROM    prod_share p19
    JOIN    prod_share p20
           ON p20.prod_id = p19.prod_id
    WHERE   p19.qtr = 1772            -- Q4‑2019
      AND   p20.qtr = 1776            -- Q4‑2020
),
/*  Rank products by total sales and keep the top 20 % (NTILE(5)=1)              */
ranked AS (
    SELECT  pc.*,
            NTILE(5) OVER (ORDER BY total_amt_both DESC) AS bucket
    FROM    prod_cmp pc
)
SELECT  pr.prod_id,
        pr.prod_name,
        r.share_2019,
        r.share_2020,
        r.abs_change
FROM    ranked      AS r
JOIN    products    AS pr ON pr.prod_id = r.prod_id
WHERE   r.bucket = 1                      -- top 20 %
ORDER BY r.abs_change ASC, pr.prod_id
LIMIT 1;
```
