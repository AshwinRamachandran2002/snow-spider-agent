--Description / Thinking process:
-- Goal: deliver the final answer table – one row for every qualifying pair of
--       activities (different molecules, same assay & standard_type) that meets
--       all the specifications.  Steps inside CTEs:
--   1. small_assays – (assay_id, standard_type) combos that have < 5 qualifying
--      rows (pChEMBL > 10 & non-null standard_value).
--   2. filtered      – activities from those assays whose compounds have
--      10-15 heavy atoms, pChEMBL > 10, non-null value, and ≤ 1 duplicate flag.
--      activities_30.molregno is INT64; convert to STRING to join property tables.
--   3. pairs         – ordered, non-self pairs built by self-joining filtered;
--      classify value change (increase / decrease / no-change).
--   4. acts          – helper mapping activity → molregno/doc_id as STRING.
--   5. docs_dates    – compute synthetic publication dates.  Use SAFE_CAST on
--      first_page (handles “291S”), percent-rank within (journal, year), then
--      rank→month/day mapping per rules; default missing year to 1970.
--   6. Final SELECT  – join heavy-atom counts, SMILES, and synthetic dates;
--      calculate:
--         • max_heavy_atoms  – larger of the two heavy-atom counts
--         • highest_doc_id   – larger numeric doc_id (as string)
--         • latest_pubdate   – later synthetic date
--         • mmp_delta_uuid   – MD5(JSON(activity_id_1, activity_id_2))
--         • smiles_pair_uuid – MD5(JSON(smiles_1, smiles_2))
--      SAFE_CAST is used wherever non-numeric strings may appear.

WITH
small_assays AS (
  SELECT assay_id, standard_type
  FROM `bigquery-public-data.ebi_chembl.activities_30`
  WHERE pchembl_value  > 10
    AND standard_value IS NOT NULL
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5
),
filtered AS (
  SELECT a.*
  FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
    ON CAST(a.molregno AS STRING) = cp.molregno
  JOIN small_assays USING (assay_id, standard_type)
  WHERE SAFE_CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND a.pchembl_value  > 10
    AND a.standard_value IS NOT NULL
    AND (a.potential_duplicate IS NULL OR a.potential_duplicate < 2)
),
pairs AS (
  SELECT
    t1.activity_id  AS activity_id_1,
    t2.activity_id  AS activity_id_2,
    t1.assay_id,
    t1.standard_type,
    t1.standard_value AS value_1,
    t2.standard_value AS value_2,
    CASE
      WHEN t1.standard_value = t2.standard_value THEN 'no-change'
      WHEN t1.standard_value > t2.standard_value THEN 'decrease'
      ELSE                                          'increase'
    END AS change_class
  FROM filtered AS t1
  JOIN filtered AS t2
    ON  t1.assay_id      = t2.assay_id
    AND t1.standard_type = t2.standard_type
    AND t1.molregno      <> t2.molregno
    AND t1.activity_id   <  t2.activity_id      -- order to avoid duplicates
),
acts AS (
  SELECT
    activity_id,
    CAST(molregno AS STRING) AS molregno_str,
    CAST(doc_id   AS STRING) AS doc_id_str
  FROM `bigquery-public-data.ebi_chembl.activities_30`
),
docs_dates AS (
  WITH doc_pages AS (
    SELECT
      doc_id,
      journal,
      year,
      first_page,
      COALESCE(SAFE_CAST(first_page AS INT64), 0) AS page_num
    FROM `bigquery-public-data.ebi_chembl.docs_29`
  ),
  ranked AS (
    SELECT
      d.*,
      PERCENT_RANK() OVER (PARTITION BY journal, year ORDER BY page_num) AS pr
    FROM doc_pages AS d
  )
  SELECT
    doc_id,
    DATE(
      COALESCE(CAST(year AS INT64), 1970),
      1 + CAST(FLOOR(pr * 11)  AS INT64),
      1 + MOD(CAST(FLOOR(pr * 308) AS INT64), 28)
    ) AS synthetic_pubdate
