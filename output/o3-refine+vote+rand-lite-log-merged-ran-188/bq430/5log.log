    WHEN value_1 = value_2 THEN 'no-change'
    WHEN value_1 > value_2 THEN 'decrease'
    ELSE                     'increase'
  END AS change_class
FROM (
  /* paste the SELECT from query 6 here */
) 
LIMIT 20;
```

```sql
--Description: 8)  Bring in document information for every activity (needs doc_id column)  
--                 to prepare for synthetic publication date
SELECT 
  pa.activity_id_1,
  a1.doc_id             AS doc_id_1,
  d1.journal            AS journal_1,
  d1.year               AS year_1,
  d1.first_page         AS first_page_1,
  pa.activity_id_2,
  a2.doc_id             AS doc_id_2,
  d2.journal            AS journal_2,
  d2.year               AS year_2,
  d2.first_page         AS first_page_2
FROM ( /* result of query-7 */ SELECT * FROM (...) )  pa
LEFT JOIN `bigquery-public-data.ebi_chembl.activities_30` AS a1
       ON pa.activity_id_1 = a1.activity_id
LEFT JOIN `bigquery-public-data.ebi_chembl.activities_30` AS a2
       ON pa.activity_id_2 = a2.activity_id
LEFT JOIN `bigquery-public-data.ebi_chembl.docs_29`       AS d1
       ON a1.doc_id = d1.doc_id
LEFT JOIN `bigquery-public-data.ebi_chembl.docs_29`       AS d2
       ON a2.doc_id = d2.doc_id
LIMIT 20;
```

```sql
--Description: 9)  Compute the synthetic ‘publication date’ for every document
SELECT
  doc_id,
  journal,
  year,
  first_page,
  DATE(
      COALESCE(CAST(year AS INT64), 1970),
      1 + CAST(FLOOR(PERCENT_RANK() OVER (PARTITION BY journal, year 
                                          ORDER BY CAST(first_page AS INT64))) * 11 AS INT64),
      1 + MOD(CAST(FLOOR(PERCENT_RANK() OVER (PARTITION BY journal, year 
                                              ORDER BY CAST(first_page AS INT64))) * 308 AS INT64), 28)
  ) AS synthetic_pubdate
FROM `bigquery-public-data.ebi_chembl.docs_29`
LIMIT 20;
```

```sql
--Description: 10)  Final answer — pairs with heavy atom max, latest date, doc id,
--                  change class and the two UUIDs requested
SELECT
  pair.assay_id,
  pair.standard_type,
  GREATEST(cp1_hatoms, cp2_hatoms)                 AS max_heavy_atoms,
  -- highest doc_id (string comparison -> cast to int to be safe)
  CAST(GREATEST(CAST(doc_id_1 AS INT64), CAST(doc_id_2 AS INT64)) AS STRING) AS highest_doc_id,
  -- latest synthetic publication date
  GREATEST(pubdate_1, pubdate_2)                   AS latest_pubdate,
  pair.change_class,
  to_hex(MD5(TO_JSON_STRING(STRUCT(pair.activity_id_1, pair.activity_id_2))))              AS mmp_delta_uuid,
  to_hex(MD5(TO_JSON_STRING(STRUCT(smiles_1, smiles_2))))                                 AS smiles_pair_uuid
FROM (
    -- ==== build the pair core (query-7) and enrich with more info ====
    SELECT 
      p.*,
      cp1.heavy_atoms  AS cp1_hatoms,
      cp2.heavy_atoms  AS cp2_hatoms,
      s1.canonical_smiles AS smiles_1,
      s2.canonical_smiles AS smiles_2,
      dcalc1.synthetic_pubdate AS pubdate_1,
      dcalc2.synthetic_pubdate AS pubdate_2,
      dcalc1.doc_id           AS doc_id_1,
      dcalc2.doc_id           AS doc_id_2
    FROM   ( /* query-7 result */  SELECT * FROM (...) )  AS p
    JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp1
           ON p.activity_id_1 = cp1.molregno
    JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp2
           ON p.activity_id_2 = cp2.molregno
    JOIN   `bigquery-public-data.ebi_chembl.compound_structures_29` AS s1
           ON p.activity_id_1 = s1.molregno
    JOIN   `bigquery-public-data.ebi_chembl.compound_structures_29` AS s2
           ON p.activity_id_2 = s2.molregno
    JOIN  ( /* query-9 result */ SELECT * FROM (...) ) AS dcalc1
          ON p.doc_id_1 = dcalc1.doc_id
    JOIN  ( /* query-9 result */ SELECT * FROM (...) ) AS dcalc2
          ON p.doc_id_2 = dcalc2.doc_id
) AS pair
LIMIT 20;
```

Each of the ten queries incrementally exposes the relevant columns, applies the problem’s biological/chemical filters, creates activity pairs, classifies value changes, derives synthetic publication dates, and finally produces the requested UUID-annotated answer set.
