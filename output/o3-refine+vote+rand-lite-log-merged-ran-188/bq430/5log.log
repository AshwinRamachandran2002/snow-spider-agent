--Description:
-- We need to assign a synthetic publication date to every entry in
-- `docs_29`.  The original error (Bad int64 value) occurred when trying
-- to CAST FIRST_PAGE strings that include letters (e.g., “291S”) directly
-- to INT64.  Fix:
--   1. Use SAFE_CAST so illegal casts return NULL instead of error.
--   2. Replace NULL with 0 (COALESCE) to obtain a sortable numeric value
--      called page_num for the window‐function ordering.
--   3. Compute PERCENT_RANK() within each (journal, year) partition based
--      on page_num.
--   4. Convert that rank into month and day according to the given rules:
--        month = ⌊rank * 11⌋ + 1
--        day   = (⌊rank * 308⌋ mod 28) + 1
--   5. Default missing YEAR to 1970.
-- The query below implements these steps and shows 20 sample rows.

WITH doc_pages AS (
  SELECT
    doc_id,
    journal,
    year,
    first_page,
    COALESCE( SAFE_CAST(first_page AS INT64), 0 ) AS page_num
  FROM `bigquery-public-data.ebi_chembl.docs_29`
),
ranked AS (
  SELECT
    d.*,
    PERCENT_RANK() OVER (
      PARTITION BY journal, year
      ORDER BY page_num
    ) AS pr
  FROM doc_pages AS d
)
SELECT
  doc_id,
  journal,
  year,
  first_page,
  DATE(
    COALESCE( CAST(year AS INT64), 1970 ),      -- Year (or 1970 default)
    1 + CAST( FLOOR(pr * 11)  AS INT64 ),       -- Synthetic month   (1-12)
    1 + MOD( CAST( FLOOR(pr * 308) AS INT64 ), 28 )  -- Synthetic day (1-28)
  ) AS synthetic_pubdate
FROM ranked
LIMIT 20;
