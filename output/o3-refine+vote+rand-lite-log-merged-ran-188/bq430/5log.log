```sql
--Description:
-- Create ordered pairs of activities that (i) come from molecules with
-- 10-15 heavy atoms, (ii) have pChEMBL > 10, (iii) have a non-null
-- standard_value, (iv) are in “small” assays (< 5 such rows), and
-- (v) are not marked as potential duplicates (>1).  Then classify each
-- pair as an ‘increase’, ‘decrease’, or ‘no-change’ depending on the two
-- standard_values.
--
-- Main steps inside CTEs:
--   small_assays :  keeps (assay_id, standard_type) that satisfy criterion (iv).
--   filtered     :  joins activities_30 with compound_properties_29 (fixing the
--                   INT64 vs STRING molregno disparity) and applies every filter
--                   including membership in small_assays.
--   pairs        :  self-joins filtered to create unique, non-self activity pairs
--                   within the same assay & standard_type.
-- The outer SELECT adds the change classification.

WITH small_assays AS (
  SELECT assay_id, standard_type
  FROM `bigquery-public-data.ebi_chembl.activities_30`
  WHERE pchembl_value  > 10
    AND standard_value IS NOT NULL
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5                      -- “small” assays
),
filtered AS (
  SELECT a.*
  FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
       ON CAST(a.molregno AS STRING) = cp.molregno              -- type-safe join
  JOIN small_assays USING (assay_id, standard_type)
  WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15          -- 10-15 atoms
    AND a.pchembl_value  > 10                                    -- potency filter
    AND a.standard_value IS NOT NULL
    AND (a.potential_duplicate IS NULL OR a.potential_duplicate < 2)
),
pairs AS (
  SELECT
    t1.activity_id    AS activity_id_1,
    t2.activity_id    AS activity_id_2,
    t1.assay_id,
    t1.standard_type,
    t1.standard_value AS value_1,
    t2.standard_value AS value_2
  FROM filtered AS t1
  JOIN filtered AS t2
       ON  t1.assay_id      = t2.assay_id
       AND t1.standard_type = t2.standard_type
       AND t1.molregno      <> t2.molregno        -- different molecules
       AND t1.activity_id   <  t2.activity_id     -- ordered pairs
)
SELECT
  *,
  CASE
    WHEN value_1 = value_2 THEN 'no-change'
    WHEN value_1 > value_2 THEN 'decrease'
    ELSE                      'increase'
  END AS change_class
FROM pairs
LIMIT 20;
```
