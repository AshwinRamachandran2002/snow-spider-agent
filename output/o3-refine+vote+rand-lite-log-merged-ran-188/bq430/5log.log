```sql
--Description: 8)  Add publication metadata (journal, year, first_page) for every
--               activity present in a qualifying pair.  We rebuild the pair set
--               exactly as in query 7 (small_assays → filtered → pairs), then join
--               activities_30 to pull their INT64 doc_id, cast it to STRING, and
--               finally join the docs_29 table.  The sample output shows both
--               activity IDs and their associated document details.

WITH small_assays AS (
  SELECT assay_id, standard_type
  FROM `bigquery-public-data.ebi_chembl.activities_30`
  WHERE pchembl_value  > 10
    AND standard_value IS NOT NULL
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5
),
filtered AS (
  SELECT a.*
  FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
    ON CAST(a.molregno AS STRING) = cp.molregno
  JOIN small_assays USING (assay_id, standard_type)
  WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND a.pchembl_value  > 10
    AND a.standard_value IS NOT NULL
    AND (a.potential_duplicate IS NULL OR a.potential_duplicate < 2)
),
pairs AS (
  SELECT
    t1.activity_id AS activity_id_1,
    t2.activity_id AS activity_id_2
  FROM filtered AS t1
  JOIN filtered AS t2
    ON  t1.assay_id      = t2.assay_id
    AND t1.standard_type = t2.standard_type
    AND t1.molregno      <> t2.molregno
    AND t1.activity_id   <  t2.activity_id
),
act_docs AS (
  SELECT
    activity_id,
    CAST(doc_id AS STRING) AS doc_id_str
  FROM `bigquery-public-data.ebi_chembl.activities_30`
)
SELECT
  p.activity_id_1,
  d1.journal  AS journal_1,
  d1.year     AS year_1,
  d1.first_page AS first_page_1,
  p.activity_id_2,
  d2.journal  AS journal_2,
  d2.year     AS year_2,
  d2.first_page AS first_page_2
FROM pairs           AS p
LEFT JOIN act_docs   AS ad1 ON p.activity_id_1 = ad1.activity_id
LEFT JOIN act_docs   AS ad2 ON p.activity_id_2 = ad2.activity_id
LEFT JOIN `bigquery-public-data.ebi_chembl.docs_29` AS d1 ON ad1.doc_id_str = d1.doc_id
LEFT JOIN `bigquery-public-data.ebi_chembl.docs_29` AS d2 ON ad2.doc_id_str = d2.doc_id
LIMIT 20;
```

```sql
--Description: 9)  Produce a table of documents with a synthetic publication date
--               computed from journal/year/first_page ordering.  No joins are
--               required, so there are no type-mismatch concerns.

SELECT
  doc_id,
  journal,
  year,
  first_page,
  DATE(
    COALESCE(CAST(year AS INT64), 1970),
    1 + CAST( FLOOR( PERCENT_RANK() OVER (PARTITION BY journal, year
                                           ORDER BY CAST(first_page AS INT64)) * 11 )
              AS INT64),
    1 + MOD(
          CAST( FLOOR( PERCENT_RANK() OVER (PARTITION BY journal, year
                                             ORDER BY CAST(first_page AS INT64)) * 308 )
                AS INT64),
          28)
  ) AS synthetic_pubdate
FROM `bigquery-public-data.ebi_chembl.docs_29`
LIMIT 20;
```

```sql
--Description: 10)  Assemble the final answer set: for every qualifying activity
--               pair, report the max heavy-atom count, latest synthetic
--               publication date, highest doc_id, change class, and both UUIDs
--               (activity-pair & SMILES-pair).  All joins that involve molregno
--               or doc_id cast INT64 columns to STRING to avoid type conflicts.

WITH
  -- ----- (A) recreate the classified pairs -----------------------------------
  small_assays AS (
    SELECT assay_id, standard_type
    FROM `bigquery-public-data.ebi_chembl.activities_30`
    WHERE pchembl_value  > 10
      AND standard_value IS NOT NULL
    GROUP BY assay_id, standard_type
    HAVING COUNT(*) < 5
  ),
  filtered AS (
    SELECT a.*
    FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
    JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
      ON CAST(a.molregno AS STRING) = cp.molregno
    JOIN small_assays USING (assay_id, standard_type)
    WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
      AND a.pchembl_value  > 10
      AND a.standard_value IS NOT NULL
      AND (a.potential_duplicate IS NULL OR a.potential_duplicate < 2)
  ),
  pairs AS (
    SELECT
      t1.activity_id    AS activity_id_1,
      t2.activity_id    AS activity_id_2,
      t1.assay_id,
      t1.standard_type,
      t1.standard_value AS value_1,
      t2.standard_value AS value_2,
      CASE
        WHEN t1.standard_value = t2.standard_value THEN 'no-change'
        WHEN t1.standard_value > t2.standard_value THEN 'decrease'
        ELSE                                          'increase'
      END AS change_class
    FROM filtered AS t1
    JOIN filtered AS t2
      ON  t1.assay_id      = t2.assay_id
      AND t1.standard_type = t2.standard_type
      AND t1.molregno      <> t2.molregno
      AND t1.activity_id   <  t2.activity_id
  ),

  -- ----- (B) look-up helpers --------------------------------------------------
  acts AS (
    SELECT
      activity_id,
      CAST(molregno AS STRING) AS molregno_str,
      CAST(doc_id   AS STRING) AS doc_id_str
    FROM `bigquery-public-data.ebi_chembl.activities_30`
  ),
  props AS `bigquery-public-data.ebi_chembl.compound_properties_29`,
  smiles AS `bigquery-public-data.ebi_chembl.compound_structures_29`,
  docs_dates AS (
    SELECT
      d.*,
      DATE(
        COALESCE(CAST(year AS INT64), 1970),
        1 + CAST( FLOOR( PERCENT_RANK() OVER (PARTITION BY journal, year
                                               ORDER BY CAST(first_page AS INT64)) * 11 )
                  AS INT64),
        1 + MOD(
              CAST( FLOOR( PERCENT_RANK() OVER (PARTITION BY journal, year
                                                 ORDER BY CAST(first_page AS INT64)) * 308 )
                    AS INT64),
              28)
      ) AS synthetic_pubdate
    FROM `bigquery-public-data.ebi_chembl.docs_29` AS d
  )

-- ----- (C) final assembly -----------------------------------------------------
SELECT
  p.assay_id,
  p.standard_type,
  GREATEST( CAST(prop1.heavy_atoms AS INT64),
            CAST(prop2.heavy_atoms AS INT64) )                              AS max_heavy_atoms,
  CAST( GREATEST( CAST(act1.doc_id_str AS INT64),
                  CAST(act2.doc_id_str AS INT64) ) AS STRING )              AS highest_doc_id,
  GREATEST( dd1.synthetic_pubdate, dd2.synthetic_pubdate )                  AS latest_pubdate,
  p.change_class,
  TO_HEX( MD5( TO_JSON_STRING(STRUCT(p.activity_id_1, p.activity_id_2)) ) ) AS mmp_delta_uuid,
  TO_HEX( MD5( TO_JSON_STRING(STRUCT(sm1.canonical_smiles, sm2.canonical_smiles)) ) )
                                                                           AS smiles_pair_uuid
FROM pairs  AS p
JOIN acts   AS act1 ON p.activity_id_1 = act1.activity_id
JOIN acts   AS act2 ON p.activity_id_2 = act2.activity_id
JOIN props  AS prop1 ON act1.molregno_str = prop1.molregno
JOIN props  AS prop2 ON act2.molregno_str = prop2.molregno
JOIN smiles AS sm1   ON act1.molregno_str = sm1.molregno
JOIN smiles AS sm2   ON act2.molregno_str = sm2.molregno
LEFT JOIN docs_dates AS dd1 ON act1.doc_id_str = dd1.doc_id
LEFT JOIN docs_dates AS dd2 ON act2.doc_id_str = dd2.doc_id
LIMIT 20;
```
