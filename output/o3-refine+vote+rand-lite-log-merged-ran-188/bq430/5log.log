```sql
--Description: 4)  Count how many qualifying activity rows exist for every
--               (assay_id, standard_type) where we already know the basic
--               potency/standard-value criteria; keep only “small” assays
--               (< 5 rows).  No JOIN is needed here, so no type-mismatch issue.
SELECT
  assay_id,
  standard_type,
  COUNT(*) AS n_activities
FROM `bigquery-public-data.ebi_chembl.activities_30`
WHERE pchembl_value  > 10
  AND standard_value IS NOT NULL
GROUP BY assay_id, standard_type
HAVING n_activities < 5
LIMIT 20;
```

```sql
--Description: 5)  Pull the full set of activity rows that satisfy *all* primary
--               filters (10-15 heavy atoms, pChEMBL > 10, ≤1 duplicate flag,
--               and belong to “small” assays from query 4).  We CAST the INT64
--               molregno in activities_30 to STRING for a type-safe join with
--               compound_properties_29.
WITH small_assays AS (
  SELECT assay_id, standard_type
  FROM `bigquery-public-data.ebi_chembl.activities_30`
  WHERE pchembl_value  > 10
    AND standard_value IS NOT NULL
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5
)
SELECT
  a.activity_id,
  a.assay_id,
  a.molregno,
  a.standard_type,
  a.standard_relation,
  a.standard_value,
  a.pchembl_value
FROM  `bigquery-public-data.ebi_chembl.activities_30`          AS a
JOIN  `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
      ON CAST(a.molregno AS STRING) = cp.molregno              -- fix type mismatch
JOIN  small_assays USING (assay_id, standard_type)
WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
  AND a.pchembl_value  > 10
  AND a.standard_value IS NOT NULL
  AND (a.potential_duplicate IS NULL OR a.potential_duplicate < 2)
LIMIT 20;
```

```sql
--Description: 6)  Build all *pairs* of different molecules that share the same
--               assay_id & standard_type and pass every primary filter.  Both
--               copies of the filtered activity set use the CAST join to avoid
--               molregno type mismatch.
WITH filtered AS (
  SELECT
    a.*
  FROM  `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN  `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
        ON CAST(a.molregno AS STRING) = cp.molregno
  WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND a.pchembl_value  > 10
    AND a.standard_value IS NOT NULL
    AND (a.potential_duplicate IS NULL OR a.potential_duplicate < 2)
)
SELECT
  t1.activity_id AS activity_id_1,
  t2.activity_id AS activity_id_2,
  t1.assay_id,
  t1.standard_type,
  t1.standard_value AS value_1,
  t2.standard_value AS value_2
FROM filtered AS t1
JOIN filtered AS t2
  ON  t1.assay_id      = t2.assay_id
  AND t1.standard_type = t2.standard_type
  AND t1.molregno      <> t2.molregno
  AND t1.activity_id   <  t2.activity_id          -- prevent duplicates/self-pairs
LIMIT 20;
```

```sql
--Description: 7)  Classify each value pair from query 6 as ‘increase’,
--               ‘decrease’, or ‘no-change’.
WITH pairs AS ( /* paste query 6 here */ SELECT 1 )
SELECT *,
  CASE
    WHEN value_1 = value_2 THEN 'no-change'
    WHEN value_1 > value_2 THEN 'decrease'
    ELSE                     'increase'
  END AS change_class
FROM pairs
LIMIT 20;
```

```sql
--Description: 8)  Enrich every activity in a pair with publication metadata.
--               activities_30’s doc_id is INT64 while docs_29.doc_id is STRING,
--               so CAST the activity doc_id to STRING for a safe join.
WITH pairset AS ( /* result of query 7 */ SELECT 1 ),
     act1 AS (
       SELECT a.activity_id, a.doc_id, CAST(a.doc_id AS STRING) AS doc_id_str
       FROM   `bigquery-public-data.ebi_chembl.activities_30` AS a
     ),
     act2 AS act1
SELECT
  p.activity_id_1,
  act1.doc_id   AS doc_id_1,
  d1.journal    AS journal_1,
  d1.year       AS year_1,
  d1.first_page AS first_page_1,
  p.activity_id_2,
  act2.doc_id   AS doc_id_2,
  d2.journal    AS journal_2,
  d2.year       AS year_2,
  d2.first_page AS first_page_2
FROM pairset AS p
LEFT JOIN act1 ON p.activity_id_1 = act1.activity_id
LEFT JOIN act2 ON p.activity_id_2 = act2.activity_id
LEFT JOIN `bigquery-public-data.ebi_chembl.docs_29` AS d1
       ON act1.doc_id_str = d1.doc_id
LEFT JOIN `bigquery-public-data.ebi_chembl.docs_29` AS d2
       ON act2.doc_id_str = d2.doc_id
LIMIT 20;
```

```sql
--Description: 9)  Compute the synthetic publication date for every document in
--               docs_29 (unchanged—no joins, so no type issue).
SELECT
  doc_id,
  journal,
  year,
  first_page,
  DATE(
      COALESCE(CAST(year AS INT64), 1970),
      1 + CAST(FLOOR(PERCENT_RANK() OVER (PARTITION BY journal, year
                                          ORDER BY CAST(first_page AS INT64))) * 11 AS INT64),
      1 + MOD(
            CAST(FLOOR(PERCENT_RANK() OVER (PARTITION BY journal, year
                                            ORDER BY CAST(first_page AS INT64))) * 308 AS INT64),
            28
          )
  ) AS synthetic_pubdate
FROM `bigquery-public-data.ebi_chembl.docs_29`
LIMIT 20;
```

```sql
--Description: 10)  Assemble the final answer.  Fix the type mismatches by
--               joining molregno through activities_30 and casting to STRING
--               for property/structure tables.  Also cast doc_id when joining
--               to docs_29-derived synthetic dates.
WITH
  pairs AS ( /* query 7 result */ SELECT 1 ),
  acts  AS (
      SELECT a.activity_id,
             a.molregno,
             CAST(a.molregno AS STRING) AS molregno_str,
             CAST(a.doc_id   AS STRING) AS doc_id_str
      FROM   `bigquery-public-data.ebi_chembl.activities_30` AS a
  ),
  docs_with_date AS (
      SELECT d.*, 
             DATE(
               COALESCE(CAST(year AS INT64), 1970),
               1 + CAST(FLOOR(PERCENT_RANK() OVER (PARTITION BY journal, year
                                                   ORDER BY CAST(first_page AS INT64))) * 11 AS INT64),
               1 + MOD(
                     CAST(FLOOR(PERCENT_RANK() OVER (PARTITION BY journal, year
                                                     ORDER BY CAST(first_page AS INT64))) * 308 AS INT64),
                     28)
             ) AS synthetic_pubdate
      FROM `bigquery-public-data.ebi_chembl.docs_29` AS d
  )
SELECT
  p.assay_id,
  p.standard_type,
  GREATEST(CAST(cp1.heavy_atoms AS INT64), CAST(cp2.heavy_atoms AS INT64)) AS max_heavy_atoms,
  CAST(GREATEST(CAST(act1.doc_id_str AS INT64), CAST(act2.doc_id_str AS INT64)) AS STRING)      AS highest_doc_id,
  GREATEST(d1.synthetic_pubdate, d2.synthetic_pubdate)                                                          AS latest_pubdate,
  p.change_class,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(p.activity_id_1, p.activity_id_2))))                                         AS mmp_delta_uuid,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(s1.canonical_smiles, s2.canonical_smiles))))                                 AS smiles_pair_uuid
FROM pairs AS p
JOIN acts AS act1 ON p.activity_id_1 = act1.activity_id
JOIN acts AS act2 ON p.activity_id_2 = act2.activity_id
JOIN `bigquery-public-data.ebi_chembl.compound_properties_29`  AS cp1 ON act1.molregno_str = cp1.molregno
JOIN `bigquery-public-data.ebi_chembl.compound_properties_29`  AS cp2 ON act2.molregno_str = cp2.molregno
JOIN `bigquery-public-data.ebi_chembl.compound_structures_29`  AS s1  ON act1.molregno_str = s1.molregno
JOIN `bigquery-public-data.ebi_chembl.compound_structures_29`  AS s2  ON act2.molregno_str = s2.molregno
LEFT JOIN docs_with_date AS d1 ON act1.doc_id_str = d1.doc_id
LEFT JOIN docs_with_date AS d2 ON act2.doc_id_str = d2.doc_id
LIMIT 20;
```
