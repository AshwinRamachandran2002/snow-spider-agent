  molregno,
  CAST(heavy_atoms AS INT64) AS heavy_atoms
FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
LIMIT 20;
```

```sql
--Description: 2)  Add the canonical SMILES for these ‘light’ compounds
SELECT 
  p.molregno,
  CAST(p.heavy_atoms AS INT64)        AS heavy_atoms,
  s.canonical_smiles
FROM `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS s
USING (molregno)
WHERE CAST(p.heavy_atoms AS INT64) BETWEEN 10 AND 15
LIMIT 20;
```

```sql
--Description: 3)  Activities for 10-15-atom molecules that have pChEMBL > 10
SELECT 
  a.activity_id,
  a.assay_id,
  a.molregno,
  a.standard_type,
  a.standard_relation,
  a.standard_value,
  a.pchembl_value
FROM `bigquery-public-data.ebi_chembl.activities_30` AS a
WHERE a.molregno IN (
        SELECT molregno 
        FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
        WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
      )
  AND a.pchembl_value      > 10
  AND a.standard_value  IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4)  How many activities are reported for each (assay, standard_type)  
--               – we want < 5 so we keep only the “small” assays
SELECT 
  assay_id,
  standard_type,
  COUNT(*) AS n_activities
FROM `bigquery-public-data.ebi_chembl.activities_30`
WHERE pchembl_value  > 10 
  AND standard_value IS NOT NULL
GROUP BY assay_id, standard_type
HAVING n_activities < 5
LIMIT 20;
```

```sql
--Description: 5)  Activities that satisfy ALL basic filters  
--               (10-15 heavy atoms, pChEMBL >10, ≤1 duplicate, assay <5 rows)
SELECT
  a.activity_id,
  a.assay_id,
  a.molregno,
  a.standard_type,
  a.standard_relation,
  a.standard_value,
  a.pchembl_value
FROM  `bigquery-public-data.ebi_chembl.activities_30` AS a
JOIN  `bigquery-public-data.ebi_chembl.compound_properties_29`   AS cp
      ON a.molregno = cp.molregno
JOIN (
       SELECT assay_id, standard_type
       FROM   `bigquery-public-data.ebi_chembl.activities_30`
       WHERE  pchembl_value  > 10
         AND  standard_value IS NOT NULL
       GROUP  BY assay_id, standard_type
       HAVING COUNT(*) < 5                    -- “small” assays
     ) AS small USING (assay_id, standard_type)
WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
  AND a.pchembl_value  > 10
  AND a.standard_value IS NOT NULL
  AND (a.potential_duplicate IS NULL OR a.potential_duplicate < 2)
LIMIT 20;
```

```sql
--Description: 6)  Pair up *different* molecules that share assay & standard_type
SELECT
  t1.activity_id AS activity_id_1,
  t2.activity_id AS activity_id_2,
  t1.assay_id,
  t1.standard_type,
  t1.standard_value AS value_1,
  t2.standard_value AS value_2
FROM ( /* filtered activities once */  SELECT * FROM (
         SELECT
           a.*
         FROM  `bigquery-public-data.ebi_chembl.activities_30` AS a
         JOIN  `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
               ON a.molregno = cp.molregno
         WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
           AND a.pchembl_value  > 10
           AND a.standard_value IS NOT NULL
           AND (a.potential_duplicate IS NULL OR a.potential_duplicate < 2)
       )) AS t1
JOIN ( /* same filter – second copy for self-join */ SELECT * FROM (
         SELECT
           a.*
         FROM  `bigquery-public-data.ebi_chembl.activities_30` AS a
         JOIN  `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
               ON a.molregno = cp.molregno
         WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
           AND a.pchembl_value  > 10
           AND a.standard_value IS NOT NULL
           AND (a.potential_duplicate IS NULL OR a.potential_duplicate < 2)
       )) AS t2
  ON  t1.assay_id      = t2.assay_id
  AND t1.standard_type = t2.standard_type
  AND t1.molregno      <> t2.molregno
  AND t1.activity_id   <  t2.activity_id        -- avoid duplicate & self pairs
LIMIT 20;
```

