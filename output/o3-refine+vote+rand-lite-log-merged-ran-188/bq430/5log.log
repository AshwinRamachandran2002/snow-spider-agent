```sql
--Description / Thinking process:
-- 1. Goal: list activities for compounds that have 10-15 heavy atoms,
--    possess pChEMBL > 10, and hold a non-null standard_value.
-- 2. Problem we hit earlier: activities_30.molregno is INT64, whereas
--    compound_properties_29.molregno (and heavy_atoms) are stored as STRING.
-- 3. Solution: join the two tables and CAST the INT64 molregno from
--    activities_30 to STRING so types align.
-- 4. Filter heavy_atoms (cast to INT64) between 10 and 15, plus the other
--    requested conditions.
-- 5. Return a small sample (LIMIT 20) to verify.

SELECT
  a.activity_id,
  a.assay_id,
  a.molregno,            -- still INT64 here; cast only for the join
  a.standard_type,
  a.standard_relation,
  a.standard_value,
  a.pchembl_value
FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
  ON CAST(a.molregno AS STRING) = cp.molregno
WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15   -- 10-15 heavy atoms
  AND a.pchembl_value  > 10                             -- strong potency
  AND a.standard_value IS NOT NULL                      -- must have value
LIMIT 20;
