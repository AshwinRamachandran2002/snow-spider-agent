Query:
--Description: 5)  Pull the full set of activity rows that satisfy *all* primary
--               filters (10-15 heavy atoms, pChEMBL > 10, ≤1 duplicate flag,
--               and belong to “small” assays from query 4).  We CAST the INT64
--               molregno in activities_30 to STRING for a type-safe join with
--               compound_properties_29.
WITH small_assays AS (
  SELECT assay_id, standard_type
  FROM `bigquery-public-data.ebi_chembl.activities_30`
  WHERE pchembl_value  > 10
    AND standard_value IS NOT NULL
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5
)
SELECT
  a.activity_id,
  a.assay_id,
  a.molregno,
  a.standard_type,
  a.standard_relation,
  a.standard_value,
  a.pchembl_value
FROM  `bigquery-public-data.ebi_chembl.activities_30`          AS a
JOIN  `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
      ON CAST(a.molregno AS STRING) = cp.molregno              -- fix type mismatch
JOIN  small_assays USING (assay_id, standard_type)
WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
  AND a.pchembl_value  > 10
  AND a.standard_value IS NOT NULL
  AND (a.potential_duplicate IS NULL OR a.potential_duplicate < 2)
LIMIT 20
