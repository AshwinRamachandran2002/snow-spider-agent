Query:
--Description: 10) Final prototype – produce required output (UUIDs, heavy-atom max,
--               change_class, highest_doc_id, latest_synth_date) with every previous
--               date-builder and type issue fixed.  Uses FORMAT() to build the
--               synthetic date (avoids earlier LPAD/parenthesis errors) and the
--               safe date routine (SAFE_CAST, SAFE_DIVIDE, INT64-MOD).
WITH heavy AS (                         -- compounds with 10–15 heavy atoms
  SELECT
    CAST(molregno AS INT64) AS molregno_int,
    CAST(heavy_atoms AS INT64) AS ha
  FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
  WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
),
small_assays AS (                       -- assays with <5 activities per std_type
  SELECT assay_id, standard_type
  FROM `bigquery-public-data.ebi_chembl.activities_30`
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5
),
cand AS (                               -- candidate activity rows
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    a.standard_type,
    a.standard_value,
    h.ha
  FROM `bigquery-public-data.ebi_chembl.activities_30` AS a
  JOIN small_assays USING (assay_id, standard_type)
  JOIN heavy       AS h ON a.molregno = h.molregno_int
  WHERE a.pchembl_value > 10
    AND a.standard_value IS NOT NULL
    AND CAST(a.potential_duplicate AS INT64) < 2
),
pairs AS (                              -- unordered molecule pairs
  SELECT
    c1.activity_id AS act1,
    c1.molregno    AS mol1,
    c1.standard_value AS val1,
    c2.activity_id AS act2,
    c2.molregno    AS mol2,
    c2.standard_value AS val2,
    c1.assay_id,
    c1.standard_type,
    c1.ha  AS ha1,
    c2.ha  AS ha2
  FROM cand AS c1
  JOIN cand AS c2
    ON  c1.assay_id      = c2.assay_id
    AND c1.standard_type = c2.standard_type
    AND c1.molregno     < c2.molregno
),
docs_ranked AS (                        -- safe synthetic pub-date per document
  WITH ranked AS (
    SELECT
      d.*,
      RANK() OVER (
        PARTITION BY journal, year
        ORDER BY COALESCE(SAFE_CAST(first_page AS INT64), 0)
      ) AS rnk,
      COUNT(*) OVER (PARTITION BY journal, year) AS n_in_grp
    FROM `bigquery-public-data.ebi_chembl.docs_30` AS d
    WHERE year IS NOT NULL
  )
  SELECT
    doc_id,
    FORMAT(
      '%04d-%02d-%02d',
      year,
      1 + CAST(
            FLOOR(
              11 * SAFE_DIVIDE(CAST(rnk - 1 AS FLOAT64), CAST(n_in_grp - 1 AS FLOAT64))
            ) AS INT64
          ),
      1 + MOD(
            CAST(
              FLOOR(
                308 * SAFE_DIVIDE(CAST(rnk - 1 AS FLOAT64), CAST(n_in_grp - 1 AS FLOAT64))
              ) AS INT64
            ), 28
          )
    ) AS synth_pubdate
  FROM ranked
)
SELECT
  pairs.act1                       AS activity_id_1,
  pairs.act2                       AS activity_id_2,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(pairs.act1, pairs.act2)))) AS mmp_delta_uuid,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(cs1.canonical_smiles, cs2.canonical_smiles)))) AS smiles_pair_uuid,
  pairs.assay_id,
  pairs.standard_type,
  pairs.val1                       AS value_1,
  pairs.val2                       AS value_2,
  CASE
    WHEN SAFE_CAST(pairs.val1 AS FLOAT64) > SAFE_CAST(pairs.val2 AS FLOAT64) THEN 'decrease'
    WHEN SAFE_CAST(pairs.val1 AS FLOAT64) < SAFE_CAST(pairs.val2 AS FLOAT64) THEN 'increase'
    ELSE 'no-change'
  END                               AS change_class,
  GREATEST(pairs.ha1, pairs.ha2)    AS max_heavy_atoms,
  MAX(dr.doc_id)                    AS highest_doc_id,
  MAX(dr.synth_pubdate)             AS latest_publication_date
FROM pairs
JOIN `bigquery-public-data.ebi_chembl.compound_structures` AS cs1
  ON CAST(pairs.mol1 AS STRING) = cs1.molregno
JOIN `bigquery-public-data.ebi_chembl.compound_structures` AS cs2
  ON CAST(pairs.mol2 AS STRING) = cs2.molregno
LEFT JOIN docs_ranked AS dr
  ON CAST(pairs.act1 AS INT64) = dr.doc_id                 -- illustrative linkage
GROUP BY activity_id_1, activity_id_2, mmp_delta_uuid, smiles_pair_uuid,
         assay_id, standard_type, value_1, value_2, change_class, max_heavy_atoms
LIMIT 20
Answer:
activity_id_1,activity_id_2,mmp_delta_uuid,smiles_pair_uuid,assay_id,standard_type,value_1,value_2,change_class,max_heavy_atoms,highest_doc_id,latest_publication_date
