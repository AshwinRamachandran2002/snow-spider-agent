```sql
--Description: 
-- Build valid molecule pairs (10–15 heavy atoms, pChEMBL > 10, <5 activities / assay / type,
-- ≤1 duplicate) and enrich them with canonical SMILES, max-heavy-atom count, and
-- change‐classification – taking care to CAST molregno so INT64 matches STRING.
WITH small_sets AS (                          -- 1) assays with <5 activities
  SELECT assay_id, standard_type
  FROM `bigquery-public-data.ebi_chembl.activities_30`
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5
),
candidates AS (                               -- 2) filter activities & add heavy-atoms
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,                              -- INT64
    a.standard_type,
    a.standard_relation,
    a.standard_value,
    CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
  FROM `bigquery-public-data.ebi_chembl.activities_30`            AS a
  JOIN small_sets                                                 USING (assay_id, standard_type)
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29`   AS cp
       ON a.molregno = CAST(cp.molregno AS INT64)                -- INT64 = STRING
  WHERE a.pchembl_value  > 10
    AND a.standard_value IS NOT NULL
    AND CAST(a.potential_duplicate AS INT64) < 2
    AND CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
),
pairs AS (                                     -- 3) unordered pairs inside same assay/type
  SELECT
    c1.activity_id         AS activity_id_1,
    c1.molregno            AS molregno_1,
    c1.standard_value      AS std_val_1,
    c1.standard_relation   AS rel_1,
    c1.heavy_atoms         AS heavy_atoms_1,
    c2.activity_id         AS activity_id_2,
    c2.molregno            AS molregno_2,
    c2.standard_value      AS std_val_2,
    c2.standard_relation   AS rel_2,
    c2.heavy_atoms         AS heavy_atoms_2,
    c1.assay_id,
    c1.standard_type
  FROM candidates AS c1
  JOIN candidates AS c2
    ON  c1.assay_id      = c2.assay_id
    AND c1.standard_type = c2.standard_type
    AND c1.molregno     < c2.molregno                -- avoid duplicates/self-pairs
)
SELECT
  p.*,
  cs1.canonical_smiles AS smiles_1,
  cs2.canonical_smiles AS smiles_2,
  GREATEST(p.heavy_atoms_1, p.heavy_atoms_2) AS max_heavy_atoms,
  CASE                                            -- change classification
    WHEN SAFE_CAST(p.std_val_1 AS FLOAT64) > SAFE_CAST(p.std_val_2 AS FLOAT64) THEN 'decrease'
    WHEN SAFE_CAST(p.std_val_1 AS FLOAT64) < SAFE_CAST(p.std_val_2 AS FLOAT64) THEN 'increase'
    ELSE 'no-change'
  END AS change_class
FROM pairs AS p
JOIN `bigquery-public-data.ebi_chembl.compound_structures` AS cs1
  ON CAST(p.molregno_1 AS STRING) = cs1.molregno          -- INT64→STRING
JOIN `bigquery-public-data.ebi_chembl.compound_structures` AS cs2
  ON CAST(p.molregno_2 AS STRING) = cs2.molregno
LIMIT 20;
