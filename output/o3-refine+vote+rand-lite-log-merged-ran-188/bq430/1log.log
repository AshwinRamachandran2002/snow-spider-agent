--Description: 
-- Build unordered molecule–pairs that meet all specified criteria and, for each
-- (assay_id, standard_type) pair, attach two document metrics obtained from
-- docs_30 via a SAFE synthetic-date routine:
--   • highest_doc_id      – maximum DOC_ID encountered (placeholder linkage)
--   • latest_synth_date   – most recent synthetic publication date
-- Main safeguards:
--   • heavy-atom filter via compound_properties_29 with INT64-cast molregno.
--   • pChEMBL >10, non-null standard_value, ≤1 duplicate, <5 activities per assay/type.
--   • SAFE synthetic date uses SAFE_CAST, SAFE_DIVIDE, INT64-MOD, and FORMAT to
--     avoid earlier syntax errors.
WITH small_sets AS (                            -- 1. assays with <5 activities
  SELECT assay_id, standard_type
  FROM `bigquery-public-data.ebi_chembl.activities_30`
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5
),
candidates AS (                                 -- 2. qualifying activity rows
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    a.standard_type,
    a.standard_value
  FROM `bigquery-public-data.ebi_chembl.activities_30` AS a
  JOIN small_sets USING (assay_id, standard_type)
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
       ON a.molregno = CAST(cp.molregno AS INT64)               -- align INT64=STRING
  WHERE a.pchembl_value  > 10
    AND a.standard_value IS NOT NULL
    AND CAST(a.potential_duplicate AS INT64) < 2
    AND CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
),
pairs AS (                                      -- 3. unordered molecule pairs
  SELECT
    c1.assay_id,
    c1.standard_type,
    c1.activity_id AS activity_id_1,
    c1.molregno    AS molregno_1,
    c1.standard_value AS value_1,
    c2.activity_id AS activity_id_2,
    c2.molregno    AS molregno_2,
    c2.standard_value AS value_2
  FROM candidates AS c1
  JOIN candidates AS c2
    ON  c1.assay_id      = c2.assay_id
    AND c1.standard_type = c2.standard_type
    AND c1.molregno     < c2.molregno
),
doc_dates AS (                                  -- 4. safe synthetic pub-date
  WITH ranked AS (
    SELECT
      d.*,
      RANK()  OVER (
        PARTITION BY journal, year
        ORDER BY COALESCE(SAFE_CAST(first_page AS INT64), 0)
      )                          AS rnk,
      COUNT(*) OVER (PARTITION BY journal, year) AS n_in_grp
    FROM `bigquery-public-data.ebi_chembl.docs_30` AS d
    WHERE year IS NOT NULL
  )
  SELECT
    doc_id,
    FORMAT(
      '%04d-%02d-%02d',
      year,
      1 + CAST(
            FLOOR(
              11 * SAFE_DIVIDE(CAST(rnk - 1 AS FLOAT64), CAST(n_in_grp - 1 AS FLOAT64))
            ) AS INT64
          ),
      1 + MOD(
            CAST(
              FLOOR(
                308 * SAFE_DIVIDE(CAST(rnk - 1 AS FLOAT64), CAST(n_in_grp - 1 AS FLOAT64))
              ) AS INT64
            ),
            28
          )
    ) AS synth_pubdate
  FROM ranked
)
SELECT
  p.*,
  MAX(dd.doc_id)        AS highest_doc_id,
  MAX(dd.synth_pubdate) AS latest_synth_date
FROM pairs AS p
LEFT JOIN doc_dates AS dd
  ON CAST(p.activity_id_1 AS INT64) = dd.doc_id      -- placeholder linkage
GROUP BY p.assay_id, p.standard_type,
         p.activity_id_1, p.molregno_1, p.value_1,
         p.activity_id_2, p.molregno_2, p.value_2
LIMIT 20;
