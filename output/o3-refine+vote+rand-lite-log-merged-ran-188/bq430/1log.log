        GROUP BY assay_id, standard_type
        HAVING COUNT(*) < 5
       ) AS s USING (assay_id, standard_type)
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
    ON a.molregno = CAST(p.molregno AS INT64)          -- fixed
  WHERE CAST(p.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND a.pchembl_value  > 10
    AND a.standard_value IS NOT NULL
    AND CAST(a.potential_duplicate AS INT64) < 2
)
SELECT
  c1.activity_id  AS activity_id_1,
  c1.molregno     AS molregno_1,
  c1.standard_value AS std_val_1,
  c1.standard_relation AS rel_1,
  c2.activity_id  AS activity_id_2,
  c2.molregno     AS molregno_2,
