```sql
--Description: 
-- Compute a “synthetic” publication date for each document in
-- `bigquery-public-data.ebi_chembl.docs_30`.  Steps & key decisions:
--   1. Rank every document inside its (journal, year) cohort by the numeric
--      part of `first_page`.  Non-numeric values (e.g., “291S”) are handled with
--      SAFE_CAST; if cast fails, treat as 0 via COALESCE so ranking still works.
--   2. Count cohort size (n_in_grp) to calculate a 0-to-1 fractional position:
--        frac = (rank - 1) / (n_in_grp - 1)   (FLOAT64)
--   3. Derive synthetic calendar pieces:
--        month = 1 + FLOOR(11 * frac)                             (INT64 1-12)
--        day   = 1 + MOD( FLOOR(308 * frac)  AS INT64, 28 )       (INT64 1-28)
--      MOD requires INT64 inputs, so the FLOOR result is CAST to INT64 first.
WITH ranked AS (
  SELECT
    d.*,
    RANK()  OVER (
      PARTITION BY journal, year
      ORDER BY COALESCE(SAFE_CAST(first_page AS INT64), 0)
    ) AS rnk,
    COUNT(*) OVER (PARTITION BY journal, year) AS n_in_grp
  FROM `bigquery-public-data.ebi_chembl.docs_30` AS d
  WHERE year IS NOT NULL
)
SELECT
  doc_id,
  journal,
  year,
  first_page,
  (rnk - 1) / NULLIF(n_in_grp - 1, 0)                         AS pct_rank,
  1 + CAST(
        FLOOR(11 * (rnk - 1) / NULLIF(n_in_grp - 1, 1))
      AS INT64)                                               AS synth_month,
  1 + MOD(
        CAST(
          FLOOR(308 * (rnk - 1) / NULLIF(n_in_grp - 1, 1))
        AS INT64),
        28
      )                                                       AS synth_day
FROM ranked
LIMIT 20;
