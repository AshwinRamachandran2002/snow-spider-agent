--Description: 
-- Goal: assign each document in `bigquery-public-data.ebi_chembl.docs_30` a
--        synthetic publication month (1-12) and day (1-28) based on its position
--        within the same journal/year, ordered by first_page.
-- Reasoning / safeguards:
--   1. first_page is TEXT; some rows contain non-numeric values like “291S”.  
--      Convert with SAFE_CAST; if conversion fails, default to 0 via COALESCE so
--      ordering still works without errors. 
--   2. Use window functions to get RANK() (1-based) and cohort size n_in_grp.  
--   3. Fractional rank “frac” = SAFE_DIVIDE(rnk-1 , n_in_grp-1); SAFE_DIVIDE avoids
--      divide-by-zero when n_in_grp = 1 (single paper for that journal/year).  
--   4. Synthetic month  = 1 + FLOOR(11 * frac)      → INT64  (1-12).  
--   5. Synthetic day    = 1 + MOD( FLOOR(308 * frac)  AS INT64 , 28 ).  
--      MOD needs INT64 inputs, so cast the FLOOR result.
WITH ranked AS (
  SELECT
    d.*,
    RANK() OVER (
      PARTITION BY journal, year
      ORDER BY COALESCE(SAFE_CAST(first_page AS INT64), 0)
    ) AS rnk,
    COUNT(*) OVER (PARTITION BY journal, year) AS n_in_grp
  FROM `bigquery-public-data.ebi_chembl.docs_30` AS d
  WHERE year IS NOT NULL
)
SELECT
  doc_id,
  journal,
  year,
  first_page,
  SAFE_DIVIDE(CAST(rnk - 1 AS FLOAT64), CAST(n_in_grp - 1 AS FLOAT64)) AS pct_rank,
  1 + CAST(
        FLOOR(
          11 * SAFE_DIVIDE(CAST(rnk - 1 AS FLOAT64), CAST(n_in_grp - 1 AS FLOAT64))
        ) AS INT64
      ) AS synth_month,
  1 + MOD(
        CAST(
          FLOOR(
            308 * SAFE_DIVIDE(CAST(rnk - 1 AS FLOAT64), CAST(n_in_grp - 1 AS FLOAT64))
          ) AS INT64
        ),
        28
      ) AS synth_day
FROM ranked
LIMIT 20;
