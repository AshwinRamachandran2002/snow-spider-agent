```sql
--Description: 8) Compute the synthetic publication date for every row in `docs_30`.
--               (No molregno joins, so no INT64-vs-STRING issues.)
WITH ranked AS (
  SELECT
    d.*,
    RANK()  OVER (PARTITION BY journal, year ORDER BY CAST(first_page AS INT64)) AS rnk,
    COUNT(*) OVER (PARTITION BY journal, year)                                  AS n_in_grp
  FROM `bigquery-public-data.ebi_chembl.docs_30` AS d
  WHERE year IS NOT NULL
)
SELECT
  doc_id,
  journal,
  year,
  first_page,
  -- percent-rank (0-1); denominator safeguarded
  (rnk - 1) / NULLIF(n_in_grp - 1, 0)                    AS pct_rank,
  -- synthetic month (1-12)
  1 + CAST(FLOOR(11 * (rnk - 1) / NULLIF(n_in_grp - 1, 1)) AS INT64) AS synth_month,
  -- synthetic day   (1-28)
  1 + CAST(MOD(FLOOR(308 * (rnk - 1) / NULLIF(n_in_grp - 1, 1)), 28)  AS INT64) AS synth_day
FROM ranked
LIMIT 20;
```

```sql
--Description: 9) For every qualifying assay/standard_type pair, attach the latest
--               synthetic publication date and highest doc_id found in docs_30.
--               Steps: build `candidates` (same filtering as before), build `pairs`,
--               compute doc_dates (from Query-8 logic), then aggregate.
WITH small_sets AS (
  SELECT assay_id, standard_type
  FROM `bigquery-public-data.ebi_chembl.activities_30`
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5
),
candidates AS (
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    a.standard_type,
    a.standard_value
  FROM `bigquery-public-data.ebi_chembl.activities_30`            AS a
  JOIN small_sets                                                 USING (assay_id, standard_type)
  WHERE a.pchembl_value  > 10
    AND a.standard_value IS NOT NULL
    AND CAST(a.potential_duplicate AS INT64) < 2
),
pairs AS (                     -- unordered pairs of DIFFERENT molregno
  SELECT
    c1.assay_id,
    c1.standard_type,
    c1.activity_id AS act1,
    c1.molregno    AS mol1,
    c1.standard_value AS val1,
    c2.activity_id AS act2,
    c2.molregno    AS mol2,
    c2.standard_value AS val2
  FROM candidates AS c1
  JOIN candidates AS c2
    ON  c1.assay_id      = c2.assay_id
    AND c1.standard_type = c2.standard_type
    AND c1.molregno     < c2.molregno
),
-- synthetic publication date for every document
doc_dates AS (
  WITH ranked AS (
    SELECT
      d.*,
      RANK()  OVER (PARTITION BY journal, year ORDER BY CAST(first_page AS INT64)) AS rnk,
      COUNT(*) OVER (PARTITION BY journal, year)                                  AS n_in_grp
    FROM `bigquery-public-data.ebi_chembl.docs_30` AS d
    WHERE year IS NOT NULL
  )
  SELECT
    doc_id,
    CONCAT(
      CAST(year AS STRING), '-',
      LPAD(CAST(1+FLOOR(11*(rnk-1)/NULLIF(n_in_grp-1,1)) AS STRING),2,'0'), '-',
      LPAD(CAST(1+MOD(FLOOR(308*(rnk-1)/NULLIF(n_in_grp-1,1)),28) AS STRING),2,'0')
    ) AS synth_pubdate
  FROM ranked
)
SELECT
  p.*,
  MAX(dd.doc_id)      AS highest_doc_id,
  MAX(dd.synth_pubdate) AS latest_synth_date
FROM pairs AS p
LEFT JOIN doc_dates AS dd
  ON CAST(p.act1 AS INT64) = dd.doc_id  -- illustrative link; adjust as needed
GROUP BY p.assay_id, p.standard_type,
         p.act1, p.mol1, p.val1,
         p.act2, p.mol2, p.val2
LIMIT 20;
```

```sql
--Description: 10) Final prototype – produce required fields (UUIDs, heavy-atom max,
--               change class, synthetic publication date, highest doc_id) with every
--               molregno join properly type-aligned.
WITH heavy AS (
  SELECT
    CAST(molregno AS INT64) AS molregno_int,
    CAST(heavy_atoms AS INT64) AS ha
  FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
  WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
),
small_assays AS (
  SELECT assay_id, standard_type
  FROM `bigquery-public-data.ebi_chembl.activities_30`
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5
),
cand AS (
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    a.standard_type,
    a.standard_relation,
    a.standard_value,
    h.ha
  FROM `bigquery-public-data.ebi_chembl.activities_30` AS a
  JOIN small_assays          USING (assay_id, standard_type)
  JOIN heavy            AS h ON a.molregno = h.molregno_int      -- INT64 = INT64
  WHERE a.pchembl_value > 10
    AND a.standard_value IS NOT NULL
    AND CAST(a.potential_duplicate AS INT64) < 2
),
pairs AS (
  SELECT
    c1.activity_id AS act1,
    c1.molregno    AS mol1,
    c1.standard_value AS val1,
    c2.activity_id AS act2,
    c2.molregno    AS mol2,
    c2.standard_value AS val2,
    c1.assay_id,
    c1.standard_type,
    c1.ha          AS ha1,
    c2.ha          AS ha2
  FROM cand AS c1
  JOIN cand AS c2
    ON  c1.assay_id      = c2.assay_id
    AND c1.standard_type = c2.standard_type
    AND c1.molregno     < c2.molregno
),
docs_ranked AS (
  -- synthetic publication date per document
  WITH ranked AS (
    SELECT
      d.*,
      RANK()  OVER (PARTITION BY journal, year ORDER BY CAST(first_page AS INT64)) AS rnk,
      COUNT(*) OVER (PARTITION BY journal, year)                                  AS n_in_grp
    FROM `bigquery-public-data.ebi_chembl.docs_30` AS d
    WHERE year IS NOT NULL
  )
  SELECT
    doc_id,
    CONCAT(
      CAST(year AS STRING), '-',
      LPAD(CAST(1+FLOOR(11*(rnk-1)/NULLIF(n_in_grp-1,1)) AS STRING),2,'0'), '-',
      LPAD(CAST(1+MOD(FLOOR(308*(rnk-1)/NULLIF(n_in_grp-1,1)),28) AS STRING),2,'0')
    ) AS synth_pubdate
  FROM ranked
)
SELECT
  pairs.act1               AS activity_id_1,
  pairs.act2               AS activity_id_2,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(pairs.act1, pairs.act2)))) AS mmp_delta_uuid,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(cs1.canonical_smiles, cs2.canonical_smiles)))) AS smiles_pair_uuid,
  pairs.assay_id,
  pairs.standard_type,
  pairs.val1               AS value_1,
  pairs.val2               AS value_2,
  CASE
    WHEN SAFE_CAST(pairs.val1 AS FLOAT64) > SAFE_CAST(pairs.val2 AS FLOAT64) THEN 'decrease'
    WHEN SAFE_CAST(pairs.val1 AS FLOAT64) < SAFE_CAST(pairs.val2 AS FLOAT64) THEN 'increase'
    ELSE 'no-change'
  END                      AS change_class,
  GREATEST(pairs.ha1, pairs.ha2) AS max_heavy_atoms,
  MAX(dr.doc_id)                AS highest_doc_id,
  MAX(dr.synth_pubdate)         AS latest_publication_date
FROM pairs
JOIN `bigquery-public-data.ebi_chembl.compound_structures` AS cs1
  ON CAST(pairs.mol1 AS STRING) = cs1.molregno             -- INT64→STRING
JOIN `bigquery-public-data.ebi_chembl.compound_structures` AS cs2
  ON CAST(pairs.mol2 AS STRING) = cs2.molregno
LEFT JOIN docs_ranked AS dr
  ON CAST(pairs.act1 AS INT64) = dr.doc_id                 -- illustrative linkage
GROUP BY activity_id_1, activity_id_2, mmp_delta_uuid, smiles_pair_uuid,
         assay_id, standard_type, value_1, value_2, change_class, max_heavy_atoms
LIMIT 20;
```
