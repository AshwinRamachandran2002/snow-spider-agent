```sql
--Description: 
-- Compute a “synthetic” publication month (1-12) and day (1-28) for every record in
-- bigquery-public-data.ebi_chembl.docs_30.
-- • Rank each document within its (journal, year) cohort by numeric first_page.
-- • Convert that rank to a 0-1 fraction (percent-rank style).
-- • Scale to 11 months → month  = 1 + FLOOR(11 * frac).   (INT64)
-- • Scale to 308 ≈ 11*28 days → day = 1 + MOD( FLOOR(308 * frac), 28 ).
--   IMPORTANT: the MOD function needs INT64 operands, so CAST before using MOD.
WITH ranked AS (
  SELECT
    d.*,
    RANK()  OVER (PARTITION BY journal, year ORDER BY CAST(first_page AS INT64)) AS rnk,
    COUNT(*) OVER (PARTITION BY journal, year)                                  AS n_in_grp
  FROM `bigquery-public-data.ebi_chembl.docs_30` AS d
  WHERE year IS NOT NULL
)
SELECT
  doc_id,
  journal,
  year,
  first_page,
  -- fractional position within the journal-year group
  (rnk - 1) / NULLIF(n_in_grp - 1, 0)                                AS pct_rank,
  -- synthetic month (1-12)
  1 + CAST(
        FLOOR(11 * (rnk - 1) / NULLIF(n_in_grp - 1, 1))
      AS INT64)                                                     AS synth_month,
  -- synthetic day  (1-28) – cast to INT64 before MOD to avoid type error
  1 + MOD(
        CAST(FLOOR(308 * (rnk - 1) / NULLIF(n_in_grp - 1, 1)) AS INT64),
        28
      )                                                           AS synth_day
FROM ranked
LIMIT 20;
