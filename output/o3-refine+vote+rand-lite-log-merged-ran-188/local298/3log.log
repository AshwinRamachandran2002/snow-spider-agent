```sql
-- 1. Inspect the different transaction types so we know which ones add to /
--    subtract from a customer’s balance.
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 2. List the first few rows in the customer_transactions table so we can
--    see the date format and some sample amounts.
SELECT *
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 3. Extract year-month from each transaction date – this makes it easier
--    to aggregate by calendar month later on.
SELECT DISTINCT 
       strftime('%Y-%m', "txn_date") AS "year_month"
FROM "customer_transactions"
ORDER BY "year_month"
LIMIT 20;
```

```sql
-- 4. Work out the signed value for each transaction
--    (deposits are positive, everything else negative) so that
--    monthly balances can be built correctly.
SELECT 
       "customer_id",
       "txn_date",
       CASE 
            WHEN "txn_type" = 'deposit' THEN  1
            ELSE -1
       END * "txn_amount" AS "signed_amount"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 5. Sum the signed amounts per customer and per month.
SELECT
       "customer_id",
       strftime('%Y-%m', "txn_date") AS "year_month",
       SUM(
           CASE WHEN "txn_type" = 'deposit' THEN  1
                ELSE -1
           END * "txn_amount"
       ) AS "net_change_this_month"
FROM   "customer_transactions"
GROUP  BY "customer_id", "year_month"
ORDER  BY "customer_id", "year_month"
LIMIT 20;
```

```sql
-- 6. Calculate each customer’s running balance as of the *1st* of every month
--    using a windowed cumulative sum of their net monthly changes.
SELECT
       "customer_id",
       "year_month",
       SUM("net_change_this_month")
           OVER (PARTITION BY "customer_id"
                 ORDER BY "year_month")   AS "balance_as_of_1st"
FROM (
        SELECT
               "customer_id",
               strftime('%Y-%m', "txn_date") AS "year_month",
               SUM(
                   CASE WHEN "txn_type" = 'deposit' THEN  1
                        ELSE -1
                   END * "txn_amount"
               ) AS "net_change_this_month"
        FROM   "customer_transactions"
        GROUP  BY "customer_id", "year_month"
) AS m
ORDER BY "customer_id", "year_month"
LIMIT 20;
```

```sql
-- 7. Replace any negative balances with zero and keep only the latest
--    balance per customer/month (they are already unique in previous step).
SELECT
       "customer_id",
       "year_month",
       CASE
            WHEN "balance_as_of_1st" < 0 THEN 0
            ELSE "balance_as_of_1st"
       END AS "non_negative_balance"
FROM (
        SELECT
               "customer_id",
               "year_month",
               SUM("net_change_this_month") OVER (
                     PARTITION BY "customer_id"
                     ORDER BY "year_month"
               ) AS "balance_as_of_1st"
        FROM (
                SELECT
                       "customer_id",
                       strftime('%Y-%m', "txn_date") AS "year_month",
                       SUM(
                           CASE WHEN "txn_type" = 'deposit' THEN  1
                                ELSE -1
                           END * "txn_amount"
                       ) AS "net_change_this_month"
                FROM   "customer_transactions"
                GROUP  BY "customer_id", "year_month"
        )
) 
ORDER BY "customer_id", "year_month"
LIMIT 20;
```

```sql
-- 8. Add up all customers’ non-negative balances so we have one
--    figure per month.
SELECT
       "year_month",
       SUM("non_negative_balance") AS "total_balance"
FROM (
        SELECT
               "customer_id",
               "year_month",
               CASE
                    WHEN "balance_as_of_1st" < 0 THEN 0
                    ELSE "balance_as_of_1st"
               END AS "non_negative_balance"
        FROM (
                SELECT
                       "customer_id",
                       "year_month",
                       SUM("net_change_this_month") OVER (
                             PARTITION BY "customer_id"
                             ORDER BY "year_month"
                       ) AS "balance_as_of_1st"
                FROM (
                        SELECT
                               "customer_id",
                               strftime('%Y-%m', "txn_date") AS "year_month",
                               SUM(
                                   CASE WHEN "txn_type" = 'deposit' THEN  1
                                        ELSE -1
                                   END * "txn_amount"
                               ) AS "net_change_this_month"
                        FROM   "customer_transactions"
                        GROUP  BY "customer_id", "year_month"
                )
        )
)
GROUP  BY "year_month"
ORDER  BY "year_month"
LIMIT 20;
```

```sql
-- 9. For every month, grab the *previous* month’s total balance.
--    Use LAG to bring the prior month’s figure forward.
SELECT
       "year_month"                                            AS "month",
       LAG("total_balance") OVER (ORDER BY "year_month")       AS "prev_month_total_balance"
FROM (
        SELECT
               "year_month",
               SUM("non_negative_balance") AS "total_balance"
        FROM (
                SELECT
                       "customer_id",
                       "year_month",
                       CASE
                            WHEN "balance_as_of_1st" < 0 THEN 0
                            ELSE "balance_as_of_1st"
                       END AS "non_negative_balance"
                FROM (
                        SELECT
                               "customer_id",
                               "year_month",
                               SUM("net_change_this_month") OVER (
                                     PARTITION BY "customer_id"
                                     ORDER BY "year_month"
                               ) AS "balance_as_of_1st"
                        FROM (
                                SELECT
                                       "customer_id",
                                       strftime('%Y-%m', "txn_date") AS "year_month",
                                       SUM(
                                           CASE WHEN "txn_type" = 'deposit' THEN  1
                                                ELSE -1
                                           END * "txn_amount"
                                       ) AS "net_change_this_month"
                                FROM   "customer_transactions"
                                GROUP  BY "customer_id", "year_month"
                        )
                )
        )
        GROUP  BY "year_month"
)
ORDER BY "month"
LIMIT 20;
```

```sql
-- 10. Final answer: exclude the very first calendar month (because no
--     “previous” month exists for it) and show the previous month’s
--     total non-negative balance for every subsequent month.
SELECT
       "month",
       "prev_month_total_balance"
FROM (
        SELECT
               "year_month"                                            AS "month",
               LAG("total_balance") OVER (ORDER BY "year_month")       AS "prev_month_total_balance",
               ROW_NUMBER()  OVER (ORDER BY "year_month")              AS rn
        FROM (
                SELECT
                       "year_month",
                       SUM("non_negative_balance") AS "total_balance"
                FROM (
                        SELECT
                               "customer_id",
                               "year_month",
                               CASE
                                    WHEN "balance_as_of_1st" < 0 THEN 0
                                    ELSE "balance_as_of_1st"
                               END AS "non_negative_balance"
                        FROM (
                                SELECT
                                       "customer_id",
                                       "year_month",
                                       SUM("net_change_this_month") OVER (
                                             PARTITION BY "customer_id"
                                             ORDER BY "year_month"
                                       ) AS "balance_as_of_1st"
                                FROM (
                                        SELECT
                                               "customer_id",
                                               strftime('%Y-%m', "txn_date") AS "year_month",
                                               SUM(
                                                   CASE WHEN "txn_type" = 'deposit' THEN  1
                                                        ELSE -1
                                                   END * "txn_amount"
                                               ) AS "net_change_this_month"
                                        FROM   "customer_transactions"
                                        GROUP  BY "customer_id", "year_month"
                                )
                        )
                )
                GROUP  BY "year_month"
        )
)
WHERE rn > 1                 -- drop the first calendar month
ORDER BY "month"
LIMIT 20;
```
