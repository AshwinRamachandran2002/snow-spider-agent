                                               ) AS "net_change_this_month"
                                        FROM   "customer_transactions"
                                        GROUP  BY "customer_id", "year_month"
                                )
                        )
                )
                GROUP  BY "year_month"
        )
)
WHERE rn > 1                 -- drop the first calendar month
ORDER BY "month"
