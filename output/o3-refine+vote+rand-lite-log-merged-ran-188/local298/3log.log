Query:
-- 6. Calculate each customer’s running balance as of the *1st* of every month
--    using a windowed cumulative sum of their net monthly changes.
SELECT
       "customer_id",
       "year_month",
       SUM("net_change_this_month")
           OVER (PARTITION BY "customer_id"
                 ORDER BY "year_month")   AS "balance_as_of_1st"
FROM (
        SELECT
               "customer_id",
               strftime('%Y-%m', "txn_date") AS "year_month",
               SUM(
                   CASE WHEN "txn_type" = 'deposit' THEN  1
                        ELSE -1
                   END * "txn_amount"
               ) AS "net_change_this_month"
        FROM   "customer_transactions"
        GROUP  BY "customer_id", "year_month"
) AS m
ORDER BY "customer_id", "year_month"
LIMIT 20;
