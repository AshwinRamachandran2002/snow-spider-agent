-- 10.  Final answer:  previous-month total balances
WITH monthly_change AS (
    SELECT "customer_id",
           DATE(DATE("txn_date", '+1 month', 'start of month')) AS "month_start",
           CASE WHEN "txn_type" = 'deposit'
                THEN "txn_amount"
                ELSE -1 * "txn_amount"
           END AS "signed_amount"
    FROM "customer_transactions"
), summed AS (
    SELECT "customer_id", "month_start",
           SUM("signed_amount") AS "chg"
    FROM monthly_change
    GROUP BY "customer_id", "month_start"
), running AS (
    SELECT "customer_id",
           "month_start",
           SUM("chg") OVER (PARTITION BY "customer_id"
                            ORDER BY "month_start") AS "bal"
    FROM summed
), positive AS (
    SELECT "month_start",
           CASE WHEN "bal" < 0 THEN 0 ELSE "bal" END AS "pos_bal"
    FROM running
), month_totals AS (
    SELECT "month_start",
           SUM("pos_bal") AS "total_balance"
    FROM positive
    GROUP BY "month_start"
), first_m AS (
    SELECT MIN("month_start") AS "first_month"
    FROM month_totals
)
SELECT "month_start"        AS "month_first_day",
       "total_balance"
FROM month_totals
WHERE "month_start" > (SELECT "first_month" FROM first_m) -- exclude the baseline month
ORDER BY "month_start";
