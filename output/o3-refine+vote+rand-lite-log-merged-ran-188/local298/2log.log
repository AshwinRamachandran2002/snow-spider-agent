```sql
-- 1.  What months exist in the customer_transactions table?
SELECT DISTINCT strftime('%Y-%m', "txn_date") AS "month"
FROM "customer_transactions"
ORDER BY "month"
LIMIT 20;
```

```sql
-- 2.  What kinds of transactions are stored?
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 3.  Sample raw transactions for one customer (id = 1)
SELECT *
FROM "customer_transactions"
WHERE "customer_id" = 1
ORDER BY "txn_date"
LIMIT 20;
```

```sql
-- 4.  Add a “signed” amount (+ for deposits, – for withdrawals)
SELECT "customer_id",
       "txn_date",
       "txn_type",
       "txn_amount",
       CASE WHEN "txn_type" = 'deposit'
            THEN "txn_amount"
            ELSE -1 * "txn_amount"
       END AS "signed_amount"
FROM "customer_transactions"
ORDER BY "txn_date"
LIMIT 20;
```

```sql
-- 5.  Map every transaction to the 1st day of the NEXT month
SELECT "customer_id",
       "txn_date",
       DATE(DATE("txn_date", '+1 month', 'start of month')) AS "balance_month_start",
       CASE WHEN "txn_type" = 'deposit'
            THEN "txn_amount"
            ELSE -1 * "txn_amount"
       END AS "signed_amount"
FROM "customer_transactions"
ORDER BY "txn_date"
LIMIT 20;
```

```sql
-- 6.  Aggregate each customer’s net change that will apply on every 1st-of-month
SELECT "customer_id",
       "balance_month_start",
       SUM("signed_amount") AS "monthly_change"
FROM (
    SELECT "customer_id",
           DATE(DATE("txn_date", '+1 month', 'start of month')) AS "balance_month_start",
           CASE WHEN "txn_type" = 'deposit'
                THEN "txn_amount"
                ELSE -1 * "txn_amount"
           END AS "signed_amount"
    FROM "customer_transactions"
)
GROUP BY "customer_id", "balance_month_start"
ORDER BY "balance_month_start", "customer_id"
LIMIT 20;
```

```sql
-- 7.  Derive each customer’s running balance as-of every 1st day of month
WITH monthly_change AS (
    SELECT "customer_id",
           DATE(DATE("txn_date", '+1 month', 'start of month')) AS "month_start",
           CASE WHEN "txn_type" = 'deposit'
                THEN "txn_amount"
                ELSE -1 * "txn_amount"
           END AS "signed_amount"
    FROM "customer_transactions"
), summed AS (
    SELECT "customer_id", "month_start",
           SUM("signed_amount") AS "chg"
    FROM monthly_change
    GROUP BY "customer_id", "month_start"
)
SELECT "customer_id",
       "month_start",
       SUM("chg") OVER (PARTITION BY "customer_id"
                        ORDER BY "month_start") AS "running_balance"
FROM summed
ORDER BY "month_start", "customer_id"
LIMIT 20;
```

```sql
-- 8.  Replace any negative balances with zero (per customer & month)
WITH monthly_change AS (
    SELECT "customer_id",
           DATE(DATE("txn_date", '+1 month', 'start of month')) AS "month_start",
           CASE WHEN "txn_type" = 'deposit'
                THEN "txn_amount"
                ELSE -1 * "txn_amount"
           END AS "signed_amount"
    FROM "customer_transactions"
), summed AS (
    SELECT "customer_id", "month_start",
           SUM("signed_amount") AS "chg"
    FROM monthly_change
    GROUP BY "customer_id", "month_start"
), running AS (
    SELECT "customer_id",
           "month_start",
           SUM("chg") OVER (PARTITION BY "customer_id"
                            ORDER BY "month_start") AS "bal"
    FROM summed
)
SELECT "customer_id",
       "month_start",
       CASE WHEN "bal" < 0 THEN 0 ELSE "bal" END AS "positive_balance"
FROM running
ORDER BY "month_start", "customer_id"
LIMIT 20;
```

```sql
-- 9.  Sum the non–negative balances across ALL customers, month by month
WITH monthly_change AS (
    SELECT "customer_id",
           DATE(DATE("txn_date", '+1 month', 'start of month')) AS "month_start",
           CASE WHEN "txn_type" = 'deposit'
                THEN "txn_amount"
                ELSE -1 * "txn_amount"
           END AS "signed_amount"
    FROM "customer_transactions"
), summed AS (
    SELECT "customer_id", "month_start",
           SUM("signed_amount") AS "chg"
    FROM monthly_change
    GROUP BY "customer_id", "month_start"
), running AS (
    SELECT "customer_id",
           "month_start",
           SUM("chg") OVER (PARTITION BY "customer_id"
                            ORDER BY "month_start") AS "bal"
    FROM summed
), positive AS (
    SELECT "month_start",
           CASE WHEN "bal" < 0 THEN 0 ELSE "bal" END AS "pos_bal"
    FROM running
)
SELECT "month_start",
       SUM("pos_bal") AS "total_balance_all_users"
FROM positive
GROUP BY "month_start"
ORDER BY "month_start"
LIMIT 20;
```

```sql
-- 10.  Final answer:  previous-month total balances
WITH monthly_change AS (
    SELECT "customer_id",
           DATE(DATE("txn_date", '+1 month', 'start of month')) AS "month_start",
           CASE WHEN "txn_type" = 'deposit'
                THEN "txn_amount"
                ELSE -1 * "txn_amount"
           END AS "signed_amount"
    FROM "customer_transactions"
), summed AS (
    SELECT "customer_id", "month_start",
           SUM("signed_amount") AS "chg"
    FROM monthly_change
    GROUP BY "customer_id", "month_start"
), running AS (
    SELECT "customer_id",
           "month_start",
           SUM("chg") OVER (PARTITION BY "customer_id"
                            ORDER BY "month_start") AS "bal"
    FROM summed
), positive AS (
    SELECT "month_start",
           CASE WHEN "bal" < 0 THEN 0 ELSE "bal" END AS "pos_bal"
    FROM running
), month_totals AS (
    SELECT "month_start",
           SUM("pos_bal") AS "total_balance"
    FROM positive
    GROUP BY "month_start"
), first_m AS (
    SELECT MIN("month_start") AS "first_month"
    FROM month_totals
)
SELECT "month_start"        AS "month_first_day",
       "total_balance"
FROM month_totals
WHERE "month_start" > (SELECT "first_month" FROM first_m) -- exclude the baseline month
ORDER BY "month_start";
```
