Query:
--Description: 7. FINAL ANSWER – for every month, report the previous month’s
--               total balance (measured on the 1st of that month).  
--               Negative balances are floored to zero; the very first month
--               (used only as baseline) is excluded from the results.
WITH customer_month_net AS (
    SELECT customer_id,
           substr(txn_date,1,7)                   AS month_yyyy_mm,
           SUM(CASE WHEN txn_type='deposit'  THEN  txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
                    ELSE 0 END)                  AS net_month_amount
    FROM customer_transactions
    GROUP BY customer_id, month_yyyy_mm
),
customer_cum AS (
    SELECT customer_id,
           month_yyyy_mm,
           SUM(net_month_amount)
             OVER (PARTITION BY customer_id
                   ORDER BY month_yyyy_mm)        AS cumulative_balance
    FROM customer_month_net
),
month_totals AS (
    SELECT month_yyyy_mm,
           SUM(cumulative_balance)                AS total_balance
    FROM customer_cum
    GROUP BY month_yyyy_mm
),
prev_balance AS (
    SELECT month_yyyy_mm                         AS current_month,
           COALESCE(
                CASE
                    WHEN LAG(total_balance) OVER (ORDER BY month_yyyy_mm) < 0
                    THEN 0
                    ELSE LAG(total_balance) OVER (ORDER BY month_yyyy_mm)
                END ,0)                          AS prev_month_total_balance
    FROM month_totals
)
SELECT current_month   AS month,
       prev_month_total_balance
FROM prev_balance
WHERE prev_month_total_balance IS NOT NULL          -- drops the first baseline month
ORDER BY month
LIMIT 20;
Answer:
month,prev_month_total_balance
