--Description:  End-to-end query (single SQL block) that delivers the exact
--              navigation flow for user_pseudo_id = '1362228.4966015575'
--              on 28-Jan-2021.  “Thinking process” is documented inline:
--
--  • pageviews  : filter to that user & date, pull page_title / page_location
--                 from event_params, and pre-split the URL into `segments`.
--  • classified : apply URL rules to mark each row as PDP, PLP, or Other.
--                 - Needs ≥5 segments.
--                 - 4th OR 5th segment contains category keyword  → product page.
--                 - Last segment contains “+”                     → PDP else PLP.
--  • collapsed  : remove any consecutive duplicate page_titles so repeated
--                 refreshes don’t appear multiple times.
--  • output     : replace product rows with their label (PDP / PLP), keep
--                 Other rows as page_title, and concatenate chronologically
--                 with “ >> ” to form a single navigation string.
WITH pageviews AS (                    -- fetch & prepare data
  SELECT
    event_timestamp,
    ARRAY(SELECT ep.value.string_value
          FROM UNNEST(event_params) ep
          WHERE ep.key = 'page_title')[SAFE_OFFSET(0)]      AS page_title,
    ARRAY(SELECT ep.value.string_value
          FROM UNNEST(event_params) ep
          WHERE ep.key = 'page_location')[SAFE_OFFSET(0)]   AS page_location,
    SPLIT(                                                  -- break URL path
      REGEXP_REPLACE(
        ARRAY(SELECT ep.value.string_value
              FROM UNNEST(event_params) ep
              WHERE ep.key = 'page_location')[SAFE_OFFSET(0)],
        r'^https?://', ''
      ),
      '/'
    ) AS segments
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE user_pseudo_id = '1362228.4966015575'
    AND event_date     = '20210128'
    AND event_name     = 'page_view'
),
classified AS (                 -- apply PLP/PDP/Other logic
  SELECT
    event_timestamp,
    page_title,
    CASE
      WHEN page_location IS NULL THEN 'Other'
      WHEN ARRAY_LENGTH(segments) >= 5
           AND ( REGEXP_CONTAINS(LOWER(segments[ORDINAL(4)]),
                 r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
              OR REGEXP_CONTAINS(LOWER(segments[ORDINAL(5)]),
                 r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)') )
        THEN IF(
               REGEXP_CONTAINS(
                 segments[OFFSET(ARRAY_LENGTH(segments)-1)], r'\+'),
               'PDP',
               'PLP')
      ELSE 'Other'
    END AS label            -- PDP / PLP / Other
  FROM pageviews
),
collapsed AS (                 -- drop consecutive duplicates
  SELECT *
  FROM (
    SELECT *,
           LAG(page_title) OVER (ORDER BY event_timestamp) AS prev_title
    FROM classified
  )
  WHERE prev_title IS NULL OR prev_title != page_title
)
SELECT                          -- build final navigation flow string
  STRING_AGG(
    CASE WHEN label IN ('PDP','PLP') THEN label ELSE page_title END,
    ' >> '
    ORDER BY event_timestamp
  ) AS navigation_flow
FROM collapsed;
