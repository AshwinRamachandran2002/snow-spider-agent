```sql
--Description: 6) For every page_view row build a PDP / PLP / Other label
WITH pageviews AS (
  SELECT
    event_timestamp ,
    ARRAY(
      SELECT ep.value.string_value FROM UNNEST(event_params) AS ep
      WHERE ep.key='page_title')[SAFE_OFFSET(0)]  AS page_title ,
    ARRAY(
      SELECT ep.value.string_value FROM UNNEST(event_params) AS ep
      WHERE ep.key='page_location')[SAFE_OFFSET(0)] AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE user_pseudo_id = '1362228.4966015575'
    AND event_date    = '20210128'
    AND event_name    = 'page_view'
)
SELECT
  event_timestamp ,
  page_title      ,
  page_location   ,
  CASE
    WHEN page_location IS NULL THEN 'Other'
    ELSE (
      WITH seg AS (
        SELECT SPLIT(REGEXP_REPLACE(page_location,r'^https?://',''),'/') AS s
      )
      SELECT
        CASE
          WHEN ARRAY_LENGTH(s) >= 5
               AND (
                 REGEXP_CONTAINS(LOWER(s[ORDINAL(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                 OR
                 REGEXP_CONTAINS(LOWER(s[ORDINAL(5)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
               )
            THEN IF (REGEXP_CONTAINS(s[OFFSET(ARRAY_LENGTH(s)-1)], r'\+'), 'PDP', 'PLP')
          ELSE 'Other'
        END
      FROM seg
    )
  END                                           AS page_type
FROM pageviews
ORDER BY event_timestamp
LIMIT 20 ;
```

```sql
--Description: 7) Add previous row title to let us collapse consecutive duplicates  
WITH typed_pages AS ( /*== query 6 without LIMIT ==*/
  SELECT
    event_timestamp ,
    page_title      ,
    CASE
      WHEN page_location IS NULL THEN 'Other'
      ELSE (
        WITH seg AS (
          SELECT SPLIT(REGEXP_REPLACE(page_location,r'^https?://',''),'/') AS s
        )
        SELECT
          CASE
            WHEN ARRAY_LENGTH(s) >= 5
                 AND (
                   REGEXP_CONTAINS(LOWER(s[ORDINAL(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                   OR
                   REGEXP_CONTAINS(LOWER(s[ORDINAL(5)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                 )
              THEN IF (REGEXP_CONTAINS(s[OFFSET(ARRAY_LENGTH(s)-1)], r'\+'), 'PDP', 'PLP')
            ELSE 'Other'
          END
        FROM seg
      )
    END AS page_type
  FROM (
    SELECT
      event_timestamp,
      ARRAY(SELECT ep.value.string_value FROM UNNEST(event_params) AS ep WHERE ep.key='page_title')[SAFE_OFFSET(0)] AS page_title,
      ARRAY(SELECT ep.value.string_value FROM UNNEST(event_params) AS ep WHERE ep.key='page_location')[SAFE_OFFSET(0)] AS page_location
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
    WHERE user_pseudo_id='1362228.4966015575'
      AND event_date='20210128'
      AND event_name='page_view'
  )
)
SELECT
  event_timestamp ,
  page_title      ,
  page_type       ,
  LAG(page_title) OVER(ORDER BY event_timestamp) AS prev_title
FROM typed_pages
ORDER BY event_timestamp
LIMIT 20 ;
```

```sql
--Description: 8) Keep only the first record of every run of identical consecutive pages  
WITH typed_pages AS ( /*== the CTE built in query 7 ==*/ ),
collapsed AS (
  SELECT
    event_timestamp ,
    page_title      ,
    page_type
  FROM (
    SELECT
      *,
      LAG(page_title) OVER(ORDER BY event_timestamp) AS prev_title
    FROM typed_pages
  )
  WHERE prev_title IS NULL OR prev_title != page_title
)
SELECT *
FROM collapsed
ORDER BY event_timestamp ;
```

```sql
--Description: 9) Produce the final navigation string: titles for “Other” pages,
--               the words PDP / PLP for product-related ones, joined with “>>”  
WITH typed_pages AS ( /*== same CTE as in query 7 ==*/ ),
collapsed AS (
  SELECT
    event_timestamp ,
    page_title      ,
    page_type
  FROM (
    SELECT
      *,
      LAG(page_title) OVER(ORDER BY event_timestamp) AS prev_title
    FROM typed_pages
  )
  WHERE prev_title IS NULL OR prev_title != page_title
)
SELECT
  STRING_AGG(
    CASE
      WHEN page_type IN ('PDP','PLP') THEN page_type         -- convert
      ELSE page_title                                        -- keep other pages readable
    END ,
    ' >> '
    ORDER BY event_timestamp
  )  AS navigation_flow
FROM collapsed ;
```

These nine queries move from quick inspection to the final consolidated user-journey string that fits the requested PLP/PDP replacement and adjacent-page deduplication.
