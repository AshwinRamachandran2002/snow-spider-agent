```sql
--Description:  Build the complete navigation flow for user_pseudo_id
--              '1362228.4966015575' on 28-Jan-2021 in ONE query.
--   • Step-1  (pageviews)  – isolate that day’s page_view events and pull
--              page_title + page_location from event_params.
--   • Step-2  (classified) – classify each URL as PDP / PLP / Other.
--              ▸ strip protocol, split to segments
--              ▸ if 4th or 5th segment contains a category keyword → product page
--              ▸ last segment contains “+” → PDP else PLP
--   • Step-3  (collapsed)  – drop consecutive duplicate page_titles so a page
--              shown several times in a row appears only once.
--   • Step-4  (output)     – convert PDP / PLP rows to those labels, keep
--              Other rows as their page_title, join chronologically with “ >> ”.
WITH pageviews AS (            -- Step-1
  SELECT
    event_timestamp,
    ARRAY(SELECT ep.value.string_value
          FROM UNNEST(event_params) ep
          WHERE ep.key = 'page_title')[SAFE_OFFSET(0)]      AS page_title,
    ARRAY(SELECT ep.value.string_value
          FROM UNNEST(event_params) ep
          WHERE ep.key = 'page_location')[SAFE_OFFSET(0)]   AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE user_pseudo_id = '1362228.4966015575'
    AND event_date     = '20210128'
    AND event_name     = 'page_view'
),
classified AS (              -- Step-2
  SELECT
    event_timestamp,
    page_title,
    CASE
      WHEN page_location IS NULL THEN 'Other'
      ELSE (
        -- prepare URL segments once
        WITH seg AS (
          SELECT SPLIT(REGEXP_REPLACE(page_location, r'^https?://', ''), '/') AS s
        )
