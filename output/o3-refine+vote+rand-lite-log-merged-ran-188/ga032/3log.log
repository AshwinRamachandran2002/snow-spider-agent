```sql
--Description:  Single-shot query that delivers the required navigation flow.
--              Thinking process embedded as numbered comment steps:
--  (1)   Filter the table to page_view events for the user & date.
--  (2)   From event_params, pull page_title and page_location.
--  (3)   Classify every row as PDP / PLP / Other using the business rules:
--          • Strip protocol, split path → segments.
--          • If 4th or 5th segment contains a category keyword → product page.
--          • If last segment holds “+” → PDP else PLP.
--  (4)   Remove consecutive duplicate pages (same page_title in a row).
--  (5)   Build a string: PDP/PLP labels for product pages, otherwise the title,
--        joined chronologically with “ >> ”.
--  (6)   Return that single string.
WITH pageviews AS (        -- (1) + (2)
  SELECT
    event_timestamp,
    ARRAY(SELECT ep.value.string_value
          FROM UNNEST(event_params) ep
          WHERE ep.key='page_title')[SAFE_OFFSET(0)]      AS page_title,
    ARRAY(SELECT ep.value.string_value
          FROM UNNEST(event_params) ep
          WHERE ep.key='page_location')[SAFE_OFFSET(0)]   AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE user_pseudo_id = '1362228.4966015575'
    AND event_date     = '20210128'
    AND event_name     = 'page_view'
),
typed AS (                  -- (3)
  SELECT
    event_timestamp,
    page_title,
    CASE
      WHEN page_location IS NULL THEN 'Other'
      ELSE (
        WITH seg AS (
          SELECT SPLIT(REGEXP_REPLACE(page_location, r'^https?://', ''), '/') AS s
        )
        SELECT CASE
                 WHEN ARRAY_LENGTH(s) >= 5
                      AND ( REGEXP_CONTAINS(LOWER(s[ORDINAL(4)]),
                           r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                         OR REGEXP_CONTAINS(LOWER(s[ORDINAL(5)]),
                           r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)') )
                 THEN IF(REGEXP_CONTAINS(s[OFFSET(ARRAY_LENGTH(s)-1)], r'\+'),
                         'PDP','PLP')
                 ELSE 'Other'
               END
        FROM seg
      )
    END AS page_type
  FROM pageviews
),
collapsed AS (              -- (4)
  SELECT *
  FROM (
    SELECT *,
           LAG(page_title) OVER(ORDER BY event_timestamp) AS prev_title
    FROM typed
  )
  WHERE prev_title IS NULL OR prev_title != page_title
)
SELECT                       -- (5) + (6)
  STRING_AGG(
    CASE WHEN page_type IN ('PDP','PLP') THEN page_type ELSE page_title END,
    ' >> ' ORDER BY event_timestamp
  ) AS navigation_flow
FROM collapsed;
