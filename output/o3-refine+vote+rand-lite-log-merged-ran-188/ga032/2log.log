--Description / Thinking process:
-- • Select page_view events for pseudo-user 1362228.4966015575 on 2021-01-28.
-- • Pull `page_location` + `page_title` out of event_params.
-- • Classify each URL:
--     - PDP  = contains an approved category segment (case-insensitive) AND the
--              last segment holds a “+” (detail marker).
--     - PLP  = contains a category segment but the last segment has NO “+”.
--     - else keep the original page_title (e.g., “Shopping Cart”).
-- • Chronologically order then collapse consecutive duplicates with QUALIFY.
-- • Concatenate the remaining steps with “ >> ” to get the navigation flow.

WITH base AS (
  SELECT
    event_timestamp,
    (SELECT ep.value.string_value
       FROM UNNEST(event_params) ep
      WHERE ep.key = 'page_location') AS page_location,
    (SELECT ep.value.string_value
       FROM UNNEST(event_params) ep
      WHERE ep.key = 'page_title')    AS page_title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE user_pseudo_id = '1362228.4966015575'
    AND event_name     = 'page_view'
),
classified AS (
  SELECT
    event_timestamp,
    CASE
      WHEN REGEXP_CONTAINS(page_location, r'/([^/]*\+[^/]*)$')
           AND REGEXP_CONTAINS(
                 LOWER(page_location),
                 r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/'
               )
        THEN 'PDP'
      WHEN REGEXP_CONTAINS(
                 LOWER(page_location),
                 r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/'
               )
           AND NOT REGEXP_CONTAINS(page_location, r'/([^/]*\+[^/]*)$')
        THEN 'PLP'
      ELSE page_title
    END AS page_step
  FROM base
  ORDER BY event_timestamp
),
dedup AS (
  SELECT
    event_timestamp,
    page_step
  FROM classified
  QUALIFY page_step != LAG(page_step) OVER (ORDER BY event_timestamp)  -- drop adjacent duplicates
)
SELECT STRING_AGG(page_step, ' >> ' ORDER BY event_timestamp) AS navigation_flow
FROM dedup;
```
