FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
WHERE  user_pseudo_id = '1362228.4966015575'
LIMIT  20;
```

```sql
-- 2️⃣ Description: Restrict to the required event type (page_view) only.
SELECT  event_timestamp,
        event_params
FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
WHERE   user_pseudo_id = '1362228.4966015575'
  AND   event_name     = 'page_view'
LIMIT  20;
```

```sql
-- 3️⃣ Description: Explode `event_params` to see the raw keys we are interested in.
SELECT  event_timestamp,
        ep.key             AS param_key,
        ep.value.string_value AS string_val,
        ep.value.int_value    AS int_val
FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`,
        UNNEST(event_params) AS ep
WHERE   user_pseudo_id = '1362228.4966015575'
  AND   event_name     = 'page_view'
LIMIT  20;
```

```sql
-- 4️⃣ Description: Pull the page_location of each page_view the user generated.
SELECT  event_timestamp,
        (SELECT ep.value.string_value
         FROM   UNNEST(event_params) ep
         WHERE  ep.key = 'page_location') AS page_location
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
WHERE  user_pseudo_id = '1362228.4966015575'
  AND  event_name     = 'page_view'
LIMIT 20;
```

```sql
-- 5️⃣ Description: Pull page_location + page_title together so we can later classify.
SELECT  event_timestamp,
        (SELECT ep.value.string_value
         FROM   UNNEST(event_params) ep
         WHERE  ep.key = 'page_location') AS page_location,
        (SELECT ep.value.string_value
         FROM   UNNEST(event_params) ep
         WHERE  ep.key = 'page_title')    AS page_title
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
WHERE  user_pseudo_id = '1362228.4966015575'
  AND  event_name     = 'page_view'
ORDER  BY event_timestamp
LIMIT 20;
```

```sql
-- 6️⃣ Description: Classify every page as PDP, PLP, or keep the original title.
WITH base AS (
  SELECT  event_timestamp,
          (SELECT ep.value.string_value
           FROM   UNNEST(event_params) ep
           WHERE  ep.key = 'page_location') AS page_location,
          (SELECT ep.value.string_value
           FROM   UNNEST(event_params) ep
           WHERE  ep.key = 'page_title')    AS page_title
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE  user_pseudo_id = '1362228.4966015575'
    AND  event_name     = 'page_view'
)
SELECT event_timestamp,
       page_location,
       page_title,
       CASE
         WHEN REGEXP_CONTAINS(page_location, r'/([^/]*\+[^/]*)$')               -- “+” in last segment
              AND REGEXP_CONTAINS(LOWER(page_location),
                                  r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
           THEN 'PDP'
         WHEN REGEXP_CONTAINS(LOWER(page_location),
                                  r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
              AND NOT REGEXP_CONTAINS(page_location, r'/([^/]*\+[^/]*)$')
           THEN 'PLP'
         ELSE page_title                          -- leave as-is for other pages
       END AS page_step
FROM   base
ORDER  BY event_timestamp
LIMIT 20;
```

```sql
-- 7️⃣ Description: Remove adjacent duplicates so a sequence of identical pages collapses to one.
WITH classified AS (
  SELECT  event_timestamp,
          CASE
            WHEN REGEXP_CONTAINS(page_location, r'/([^/]*\+[^/]*)$')
                 AND REGEXP_CONTAINS(LOWER(page_location),
                                     r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
              THEN 'PDP'
            WHEN REGEXP_CONTAINS(LOWER(page_location),
                                     r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
                 AND NOT REGEXP_CONTAINS(page_location, r'/([^/]*\+[^/]*)$')
              THEN 'PLP'
            ELSE page_title
          END AS page_step
  FROM (
      SELECT  event_timestamp,
              (SELECT ep.value.string_value
               FROM   UNNEST(event_params) ep
               WHERE  ep.key = 'page_location') AS page_location,
              (SELECT ep.value.string_value
               FROM   UNNEST(event_params) ep
               WHERE  ep.key = 'page_title')    AS page_title
      FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
      WHERE  user_pseudo_id = '1362228.4966015575'
        AND  event_name     = 'page_view'
  )
  ORDER BY event_timestamp
)
SELECT event_timestamp,
       page_step,
       LAG(page_step) OVER (ORDER BY event_timestamp) AS prior_step
FROM   classified
WHERE  page_step != LAG(page_step) OVER (ORDER BY event_timestamp)  -- keeps only first of runs
LIMIT 20;
```

```sql
-- 8️⃣ Description: Build a clean ordered array of the collapsed steps for the whole day.
WITH classified AS (
  SELECT  event_timestamp,
          CASE
            WHEN REGEXP_CONTAINS(page_location, r'/([^/]*\+[^/]*)$')
                 AND REGEXP_CONTAINS(LOWER(page_location),
                                     r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
              THEN 'PDP'
            WHEN REGEXP_CONTAINS(LOWER(page_location),
                                     r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
                 AND NOT REGEXP_CONTAINS(page_location, r'/([^/]*\+[^/]*)$')
              THEN 'PLP'
            ELSE page_title
          END AS page_step
  FROM (
      SELECT  event_timestamp,
              (SELECT ep.value.string_value
               FROM   UNNEST(event_params) ep
               WHERE  ep.key = 'page_location') AS page_location,
              (SELECT ep.value.string_value
               FROM   UNNEST(event_params) ep
               WHERE  ep.key = 'page_title')    AS page_title
      FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
      WHERE  user_pseudo_id = '1362228.4966015575'
        AND  event_name     = 'page_view'
  )
)
, dedup AS (
  SELECT event_timestamp,
         page_step,
         LAG(page_step) OVER (ORDER BY event_timestamp) AS prev_step
  FROM   classified
)
SELECT ARRAY_AGG(page_step ORDER BY event_timestamp) AS ordered_steps
FROM   dedup
WHERE  page_step != prev_step
;
```

```sql
-- 9️⃣ Description: Final answer – same logic as above but directly returns the
--                 navigation path string with “>>” between steps.
WITH classified AS (
  SELECT  event_timestamp,
          CASE
            WHEN REGEXP_CONTAINS(page_location, r'/([^/]*\+[^/]*)$')
                 AND REGEXP_CONTAINS(LOWER(page_location),
                                     r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
              THEN 'PDP'
            WHEN REGEXP_CONTAINS(LOWER(page_location),
                                     r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
                 AND NOT REGEXP_CONTAINS(page_location, r'/([^/]*\+[^/]*)$')
              THEN 'PLP'
            ELSE page_title
          END AS page_step,
          event_timestamp
  FROM (
      SELECT  event_timestamp,
              (SELECT ep.value.string_value
               FROM   UNNEST(event_params) ep
               WHERE  ep.key = 'page_location') AS page_location,
              (SELECT ep.value.string_value
               FROM   UNNEST(event_params) ep
               WHERE  ep.key = 'page_title')    AS page_title
      FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
      WHERE  user_pseudo_id = '1362228.4966015575'
        AND  event_name     = 'page_view'
  )
)
, dedup AS (
  SELECT event_timestamp,
         page_step,
         LAG(page_step) OVER (ORDER BY event_timestamp) AS prev_step
  FROM   classified
)
SELECT STRING_AGG(page_step, ' >> ' ORDER BY event_timestamp) AS navigation_flow
FROM   dedup
WHERE  page_step != prev_step;
```

Running the last query (`9️⃣`) returns exactly one row – a single string like:

```
Home >> PLP >> PDP >> PLP >> PDP
```

(Your actual titles / page names will appear instead of “Home” depending on what the first non-PLP/PDP screen was.) That is the deduplicated navigation path for user `1362228.4966015575` on 2021-01-28, showing only `page_view` events with PDP/PLP substitutions and adjacent duplicates merged as requested.
