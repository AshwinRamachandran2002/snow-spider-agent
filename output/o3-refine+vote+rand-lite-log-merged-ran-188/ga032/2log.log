Query:
--Description:  Build a clean ordered ARRAY of the user’s pages (PDP / PLP /
--              or original title) for 2021-01-28.  We replace the former
--              WHERE-with-window-function pattern by using QUALIFY, which is
--              BigQuery’s supported way to filter on results of window
--              functions (thus avoiding the analytic-in-WHERE error).
--              1)  Pull page_location & page_title, classify each row.
--              2)  QUALIFY keeps only the first row of every run of identical
--                  page_step (collapses adjacent duplicates).
--              3)  ARRAY_AGG(ORDER BY) returns the final ordered sequence.
WITH classified AS (
  SELECT
    event_timestamp,
    CASE
      WHEN REGEXP_CONTAINS(page_location, r'/([^/]*\+[^/]*)$')
           AND REGEXP_CONTAINS(
                 LOWER(page_location),
                 r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/'
               )
        THEN 'PDP'
      WHEN REGEXP_CONTAINS(
                 LOWER(page_location),
                 r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/'
               )
           AND NOT REGEXP_CONTAINS(page_location, r'/([^/]*\+[^/]*)$')
        THEN 'PLP'
      ELSE page_title
    END AS page_step
  FROM (
    SELECT
      event_timestamp,
      (SELECT ep.value.string_value
         FROM UNNEST(event_params) ep
        WHERE ep.key = 'page_location') AS page_location,
      (SELECT ep.value.string_value
         FROM UNNEST(event_params) ep
        WHERE ep.key = 'page_title')    AS page_title
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
    WHERE user_pseudo_id = '1362228.4966015575'
      AND event_name     = 'page_view'
  )
)
SELECT
  ARRAY_AGG(page_step ORDER BY event_timestamp) AS ordered_steps
FROM (
  SELECT
    event_timestamp,
    page_step
  FROM classified
  QUALIFY page_step != LAG(page_step) OVER (ORDER BY event_timestamp)   -- collapse duplicates
)
