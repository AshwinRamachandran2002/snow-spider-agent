```sql
--Description: Aggregate total trips per decile to be sure they’re roughly equal.
WITH base AS (
  SELECT 
    ROUND(trip_seconds/60.0) AS duration_minutes
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 60 AND 3000
),
q AS (
  SELECT 
    duration_minutes,
    NTILE(10) OVER (ORDER BY duration_minutes) AS decile
  FROM base
)
SELECT 
  decile,
  COUNT(*) AS trips_in_decile
FROM q
GROUP BY decile
ORDER BY decile
LIMIT 20;
```

```sql
--Description: Add min / max duration in each decile to build the time range.
WITH base AS (
  SELECT 
    ROUND(trip_seconds/60.0) AS duration_minutes
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 60 AND 3000
),
q AS (
  SELECT 
    duration_minutes,
    NTILE(10) OVER (ORDER BY duration_minutes) AS decile
  FROM base
)
SELECT 
  decile,
  MIN(duration_minutes) AS min_min,
  MAX(duration_minutes) AS max_min,
  COUNT(*) AS trips
FROM q
GROUP BY decile
ORDER BY decile
LIMIT 20;
```

```sql
--Description: Compute total trips and average fare per decile (still raw numbers).
WITH base AS (
  SELECT 
    ROUND(trip_seconds/60.0) AS duration_minutes,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 60 AND 3000
),
q AS (
  SELECT 
    duration_minutes,
    fare,
    NTILE(10) OVER (ORDER BY duration_minutes) AS decile
  FROM base
)
SELECT
  decile,
  MIN(duration_minutes) AS min_min,
  MAX(duration_minutes) AS max_min,
  COUNT(*)           AS total_trips,
  ROUND(AVG(fare),2) AS avg_fare
FROM q
GROUP BY decile
ORDER BY decile
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – formatted time range, total trips, and average fare (two decimals) for each of the 10 quantiles.
WITH base AS (
  SELECT 
    ROUND(trip_seconds/60.0) AS duration_minutes,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 60 AND 3000        -- 1–50 minutes only
),
q AS (
  SELECT 
    duration_minutes,
    fare,
    NTILE(10) OVER (ORDER BY duration_minutes) AS decile
  FROM base
),
agg AS (
  SELECT
    decile,
    MIN(duration_minutes)                    AS min_min,
    MAX(duration_minutes)                    AS max_min,
    COUNT(*)                                 AS total_trips,
    ROUND(AVG(fare),2)                       AS avg_fare
  FROM q
  GROUP BY decile
)
SELECT
  FORMAT('%02dm to %02dm', min_min, max_min) AS time_range,
  total_trips,
  FORMAT('%.2f', avg_fare)                   AS average_fare
FROM agg
ORDER BY min_min
LIMIT 20;
```
