```sql
--Description / Thinking process:
-- Goal: 10 equal-sized quantile groups (NTILE) on rounded trip duration (1-50 min);
--       for each group output zero-padded “XXm to XXm”, trip count, and 2-decimal avg fare.
-- Steps
--   1. base : convert seconds→minutes (rounded), cast to INT, keep fares, filter 1-50 min.
--   2. q    : apply NTILE(10) over duration to tag each trip’s decile.
--   3. agg  : per decile collect min/minutes, max/minutes, trip count, avg fare.
--   4. final: format the time range and average fare, order by earliest duration.
WITH base AS (
  SELECT
    CAST(ROUND(trip_seconds / 60.0) AS INT64) AS duration_minutes,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 60 AND 3000            -- keep trips 1-50 minutes
),
q AS (
  SELECT
    duration_minutes,
    fare,
    NTILE(10) OVER (ORDER BY duration_minutes) AS decile
  FROM base
),
agg AS (
  SELECT
    decile,
    MIN(duration_minutes) AS min_min,
    MAX(duration_minutes) AS max_min,
    COUNT(*)             AS total_trips,
    ROUND(AVG(fare), 2)  AS avg_fare
  FROM q
  GROUP BY decile
)
SELECT
  FORMAT('%02dm to %02dm', min_min, max_min) AS time_range,
  total_trips,
  FORMAT('%.2f', avg_fare)                   AS average_fare
FROM agg
ORDER BY min_min;
```
