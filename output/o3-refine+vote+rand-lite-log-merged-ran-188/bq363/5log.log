Query:
--Description: Build zero-padded time-range labels for each decile.
WITH base AS (
  SELECT
    CAST(ROUND(`trip_seconds`/60.0) AS INT64) AS duration_min,
    `fare`
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE `trip_seconds` IS NOT NULL
    AND CAST(ROUND(`trip_seconds`/60.0) AS INT64) BETWEEN 1 AND 50
),
q AS (
  SELECT
    duration_min,
    `fare`,
    NTILE(10) OVER (ORDER BY duration_min) AS decile
  FROM base
)
SELECT
  decile,
  FORMAT('%02dm to %02dm',
         MIN(duration_min),
         MAX(duration_min)) AS time_range
FROM q
GROUP BY decile
ORDER BY decile
LIMIT 20;
