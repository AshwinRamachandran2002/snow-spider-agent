Query:
--Description: Quick decile summary (min/max duration, trip count).
WITH base AS (
  SELECT
    CAST(ROUND(`trip_seconds`/60.0) AS INT64) AS duration_min,
    `fare`
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE `trip_seconds` IS NOT NULL
    AND CAST(ROUND(`trip_seconds`/60.0) AS INT64) BETWEEN 1 AND 50
),
q AS (
  SELECT
    duration_min,
    `fare`,
    NTILE(10) OVER (ORDER BY duration_min) AS decile
  FROM base
)
SELECT
  decile,
  MIN(duration_min) AS min_dur,
  MAX(duration_min) AS max_dur,
  COUNT(*)          AS trips
FROM q
GROUP BY decile
ORDER BY decile
LIMIT 20;
