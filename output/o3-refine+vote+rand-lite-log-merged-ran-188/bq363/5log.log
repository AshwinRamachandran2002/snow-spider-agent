Below are nine progressively-built BigQuery queries (all `SELECT` only).  
Each block is annotated to explain what it shows, ending with the complete solution that satisfies the task.

```sql
--Description: Peek at raw trip information (seconds, rounded minutes, fare).
SELECT
  `unique_key`,
  `trip_seconds`,
  ROUND(`trip_seconds`/60.0)     AS duration_min,
  `fare`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` IS NOT NULL
LIMIT 20;
```

```sql
--Description: Distinct rounded trip-duration minutes (1-50) to see the spread.
SELECT DISTINCT
  CAST(ROUND(`trip_seconds`/60.0) AS INT64) AS duration_min
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` BETWEEN 60 AND 3000          -- 1-50 minutes
ORDER BY duration_min
LIMIT 20;
```

```sql
--Description: How many trips fall into the 1-50 minute window?
SELECT
  COUNT(*) AS trips_between_1_and_50_min
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` IS NOT NULL
  AND CAST(ROUND(`trip_seconds`/60.0) AS INT64) BETWEEN 1 AND 50;
```

```sql
--Description: Sample of NTILE(10) assignment based on rounded minutes.
WITH durations AS (
  SELECT
    `unique_key`,
    CAST(ROUND(`trip_seconds`/60.0) AS INT64) AS duration_min
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE `trip_seconds` IS NOT NULL
    AND CAST(ROUND(`trip_seconds`/60.0) AS INT64) BETWEEN 1 AND 50
)
SELECT
  `unique_key`,
  duration_min,
  NTILE(10) OVER (ORDER BY duration_min) AS decile
FROM durations
LIMIT 20;
```

```sql
--Description: Quick decile summary (min/max duration, trip count).
WITH base AS (
  SELECT
    CAST(ROUND(`trip_seconds`/60.0) AS INT64) AS duration_min,
    `fare`
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE `trip_seconds` IS NOT NULL
    AND CAST(ROUND(`trip_seconds`/60.0) AS INT64) BETWEEN 1 AND 50
),
q AS (
  SELECT
    duration_min,
    `fare`,
    NTILE(10) OVER (ORDER BY duration_min) AS decile
  FROM base
)
SELECT
  decile,
  MIN(duration_min) AS min_dur,
  MAX(duration_min) AS max_dur,
  COUNT(*)          AS trips
FROM q
GROUP BY decile
ORDER BY decile
LIMIT 20;
```

```sql
--Description: Verify fare distribution inside one example decile.
WITH base AS (
  SELECT
    CAST(ROUND(`trip_seconds`/60.0) AS INT64) AS duration_min,
    `fare`
