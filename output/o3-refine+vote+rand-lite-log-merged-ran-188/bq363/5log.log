  WHERE `trip_seconds` IS NOT NULL
    AND CAST(ROUND(`trip_seconds`/60.0) AS INT64) BETWEEN 1 AND 50
),
q AS (
  SELECT
    duration_min,
    `fare`,
    NTILE(10) OVER (ORDER BY duration_min) AS decile
  FROM base
)
SELECT
  duration_min,
  `fare`
FROM q
WHERE decile = 1
LIMIT 20;
```

```sql
--Description: Average fare per decile without formatting (raw numeric).
WITH base AS (
  SELECT
    CAST(ROUND(`trip_seconds`/60.0) AS INT64) AS duration_min,
    `fare`
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE `trip_seconds` IS NOT NULL
    AND CAST(ROUND(`trip_seconds`/60.0) AS INT64) BETWEEN 1 AND 50
),
q AS (
  SELECT
    duration_min,
    `fare`,
    NTILE(10) OVER (ORDER BY duration_min) AS decile
  FROM base
)
SELECT
  decile,
  AVG(`fare`) AS avg_fare_raw
FROM q
GROUP BY decile
ORDER BY decile
LIMIT 20;
```

```sql
--Description: Build zero-padded time-range labels for each decile.
WITH base AS (
  SELECT
    CAST(ROUND(`trip_seconds`/60.0) AS INT64) AS duration_min,
    `fare`
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE `trip_seconds` IS NOT NULL
    AND CAST(ROUND(`trip_seconds`/60.0) AS INT64) BETWEEN 1 AND 50
),
q AS (
  SELECT
    duration_min,
    `fare`,
    NTILE(10) OVER (ORDER BY duration_min) AS decile
  FROM base
)
SELECT
  decile,
  FORMAT('%02dm to %02dm',
         MIN(duration_min),
         MAX(duration_min)) AS time_range
FROM q
GROUP BY decile
ORDER BY decile
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – total trips and formatted average fare for each of the
--ten equal-sized quantile groups, ordered chronologically by time range.
WITH base AS (
  SELECT
    CAST(ROUND(`trip_seconds`/60.0) AS INT64) AS duration_min,
    `fare`
  FROM `bigquery-public-data`. `chicago_taxi_trips`. `taxi_trips`
  WHERE `trip_seconds` IS NOT NULL
    AND CAST(ROUND(`trip_seconds`/60.0) AS INT64) BETWEEN 1 AND 50
),
q AS (
  SELECT
    duration_min,
    `fare`,
    NTILE(10) OVER (ORDER BY duration_min) AS tile
  FROM base
)
SELECT
  FORMAT('%02dm to %02dm',
         MIN(duration_min),
         MAX(duration_min))           AS time_range,
  COUNT(*)                           AS total_trips,
  FORMAT('%.2f', AVG(`fare`))        AS avg_fare
FROM q
GROUP BY tile
ORDER BY MIN(duration_min);
```

The last query returns the requested table with each quantile’s time span, trip count, and two-decimal average fare, sorted chronologically by the duration range.
