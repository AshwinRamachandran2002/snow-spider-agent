Query:
--Description: Final answer – trips and average fare for ten equal-sized quantile groups (1–50 rounded minutes).
WITH trips AS (
  SELECT
    ROUND(`trip_seconds` / 60.0) AS rounded_minutes,
    `fare`,
    NTILE(10) OVER (ORDER BY ROUND(`trip_seconds` / 60.0)) AS decile
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE `trip_seconds` IS NOT NULL
    AND ROUND(`trip_seconds` / 60.0) BETWEEN 1 AND 50
)
SELECT
  CONCAT(
    LPAD(CAST(MIN(rounded_minutes) AS STRING), 2, '0'), 'm to ',
    LPAD(CAST(MAX(rounded_minutes) AS STRING), 2, '0'), 'm'
  ) AS time_range,
  COUNT(*) AS total_trips,
  FORMAT('%.2f', AVG(fare)) AS average_fare
FROM trips
GROUP BY decile
ORDER BY MIN(rounded_minutes)
LIMIT 20;
