```sql
--Description: Peek at raw trip durations and fares.
SELECT `trip_seconds`, `fare`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` IS NOT NULL
LIMIT 20;
```

```sql
--Description: Calculate the rounded trip duration in minutes.
SELECT `trip_seconds`,
       ROUND(`trip_seconds` / 60.0) AS rounded_minutes
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` IS NOT NULL
LIMIT 20;
```

```sql
--Description: Show rounded trip-minutes restricted to 1–50 minutes.
SELECT DISTINCT
       ROUND(`trip_seconds` / 60.0) AS rounded_minutes
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` IS NOT NULL
  AND ROUND(`trip_seconds` / 60.0) BETWEEN 1 AND 50
ORDER BY rounded_minutes
LIMIT 20;
```

```sql
--Description: Count trips for every rounded minute (1–50) to gauge distribution.
SELECT ROUND(`trip_seconds` / 60.0) AS rounded_minutes,
       COUNT(*) AS trips
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` IS NOT NULL
  AND ROUND(`trip_seconds` / 60.0) BETWEEN 1 AND 50
GROUP BY rounded_minutes
ORDER BY rounded_minutes
LIMIT 20;
```

```sql
--Description: Add NTILE(10) deciles across rounded minutes (1–50) to inspect grouping.
SELECT
  ROUND(`trip_seconds` / 60.0) AS rounded_minutes,
  NTILE(10) OVER (ORDER BY ROUND(`trip_seconds` / 60.0)) AS decile
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` IS NOT NULL
  AND ROUND(`trip_seconds` / 60.0) BETWEEN 1 AND 50
LIMIT 20;
```

```sql
--Description: Show min/max duration for each decile to confirm time-range boundaries.
WITH durations AS (
  SELECT
    ROUND(`trip_seconds` / 60.0) AS rounded_minutes,
    NTILE(10) OVER (ORDER BY ROUND(`trip_seconds` / 60.0)) AS decile
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE `trip_seconds` IS NOT NULL
    AND ROUND(`trip_seconds` / 60.0) BETWEEN 1 AND 50
)
SELECT
  decile,
  MIN(rounded_minutes) AS min_min,
  MAX(rounded_minutes) AS max_min
FROM durations
GROUP BY decile
ORDER BY decile
LIMIT 20;
```

```sql
--Description: Final answer – trips and average fare for ten equal-sized quantile groups (1–50 rounded minutes).
WITH trips AS (
  SELECT
    ROUND(`trip_seconds` / 60.0) AS rounded_minutes,
    `fare`,
    NTILE(10) OVER (ORDER BY ROUND(`trip_seconds` / 60.0)) AS decile
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE `trip_seconds` IS NOT NULL
    AND ROUND(`trip_seconds` / 60.0) BETWEEN 1 AND 50
)
SELECT
  CONCAT(
    LPAD(CAST(MIN(rounded_minutes) AS STRING), 2, '0'), 'm to ',
    LPAD(CAST(MAX(rounded_minutes) AS STRING), 2, '0'), 'm'
  ) AS time_range,
  COUNT(*) AS total_trips,
  FORMAT('%.2f', AVG(fare)) AS average_fare
FROM trips
GROUP BY decile
ORDER BY MIN(rounded_minutes)
LIMIT 20;
```
