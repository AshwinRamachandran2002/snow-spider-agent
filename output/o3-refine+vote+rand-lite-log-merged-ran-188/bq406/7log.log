Query:
--Description: 8)  OPTIONAL – growth rates in percentage terms from 2014 to latest year
WITH latest AS (
  SELECT MAX(report_year) AS maxyr
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
),
y14 AS (
  SELECT * EXCEPT(workforce)
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall' AND report_year = 2014
),
yLatest AS (
  SELECT * EXCEPT(workforce)
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`, latest
  WHERE workforce = 'overall' AND report_year = latest.maxyr
)
SELECT
  CONCAT(ROUND(100*(yLatest.race_asian           - y14.race_asian          ) / y14.race_asian          ,2),'%') AS asian_growth_pct,
  CONCAT(ROUND(100*(yLatest.race_black           - y14.race_black          ) / y14.race_black          ,2),'%') AS black_growth_pct,
  CONCAT(ROUND(100*(yLatest.race_hispanic_latinx - y14.race_hispanic_latinx) / y14.race_hispanic_latinx,2),'%') AS latinx_growth_pct,
  CONCAT(ROUND(100*(yLatest.race_native_american - y14.race_native_american) / y14.race_native_american,2),'%') AS native_growth_pct,
  CONCAT(ROUND(100*(yLatest.race_white           - y14.race_white          ) / y14.race_white          ,2),'%') AS white_growth_pct,
  CONCAT(ROUND(100*(yLatest.gender_us_women      - y14.gender_us_women     ) / y14.gender_us_women     ,2),'%') AS us_women_growth_pct,
  CONCAT(ROUND(100*(yLatest.gender_us_men        - y14.gender_us_men       ) / y14.gender_us_men       ,2),'%') AS us_men_growth_pct,
  CONCAT(ROUND(100*(yLatest.gender_global_women  - y14.gender_global_women ) / y14.gender_global_women ,2),'%') AS global_women_growth_pct,
  CONCAT(ROUND(100*(yLatest.gender_global_men    - y14.gender_global_men   ) / y14.gender_global_men   ,2),'%') AS global_men_growth_pct
FROM y14 CROSS JOIN yLatest
LIMIT 20
