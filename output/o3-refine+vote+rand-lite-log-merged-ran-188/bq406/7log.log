Query:
--Description: 7)  FINAL – calculate growth rates from 2014 to the latest year ((latest−2014)/2014)
WITH latest AS (
  SELECT MAX(report_year) AS maxyr
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
),
y14 AS (
  SELECT * EXCEPT(workforce)
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall' AND report_year = 2014
),
yLatest AS (
  SELECT * EXCEPT(workforce)
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`, latest
  WHERE workforce = 'overall' AND report_year = latest.maxyr
)
SELECT
  ROUND( (yLatest.race_asian           - y14.race_asian          ) / y14.race_asian          , 4) AS growth_rate_asian,
  ROUND( (yLatest.race_black           - y14.race_black          ) / y14.race_black          , 4) AS growth_rate_black,
  ROUND( (yLatest.race_hispanic_latinx - y14.race_hispanic_latinx) / y14.race_hispanic_latinx, 4) AS growth_rate_latinx,
  ROUND( (yLatest.race_native_american - y14.race_native_american) / y14.race_native_american, 4) AS growth_rate_native,
  ROUND( (yLatest.race_white           - y14.race_white          ) / y14.race_white          , 4) AS growth_rate_white,
  ROUND( (yLatest.gender_us_women      - y14.gender_us_women     ) / y14.gender_us_women     , 4) AS growth_rate_us_women,
  ROUND( (yLatest.gender_us_men        - y14.gender_us_men       ) / y14.gender_us_men       , 4) AS growth_rate_us_men,
  ROUND( (yLatest.gender_global_women  - y14.gender_global_women ) / y14.gender_global_women , 4) AS growth_rate_global_women,
  ROUND( (yLatest.gender_global_men    - y14.gender_global_men   ) / y14.gender_global_men   , 4) AS growth_rate_global_men
FROM y14 CROSS JOIN yLatest
LIMIT 20
