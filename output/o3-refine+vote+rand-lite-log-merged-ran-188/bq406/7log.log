Below is a step-by-step set of BigQuery SQL statements that explore the data set and finally compute the requested 2014 → 2024 growth rates for the “overall” Google workforce.  
(Replace the project id if you have the data copied in your own project.)

```sql
--Description: 1)  List the available workforce categories in the DEI representation file
SELECT DISTINCT `workforce`
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
LIMIT 20;
```

```sql
--Description: 2)  Show all report years that exist for the “overall” workforce
SELECT DISTINCT `report_year`
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
ORDER BY `report_year`
LIMIT 20;
```

```sql
--Description: 3)  Inspect the 2014 baseline percentages for each dimension (overall workforce)
SELECT `report_year`,
       `race_asian`,
       `race_black`,
       `race_hispanic_latinx`,
       `race_native_american`,
       `race_white`,
       `gender_us_women`,
       `gender_us_men`,
       `gender_global_women`,
       `gender_global_men`
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
  AND `report_year` = 2014
LIMIT 20;
```

```sql
--Description: 4)  Inspect the 2024 percentages for each dimension (overall workforce)
SELECT `report_year`,
       `race_asian`,
       `race_black`,
       `race_hispanic_latinx`,
       `race_native_american`,
       `race_white`,
       `gender_us_women`,
       `gender_us_men`,
       `gender_global_women`,
       `gender_global_men`
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
  AND `report_year` = 2024
LIMIT 20;
```

```sql
--Description: 5)  Quickly compare the two snapshots side-by-side
SELECT *
FROM (
  SELECT '2014' AS yr, * EXCEPT(workforce,report_year) 
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce='overall' AND report_year=2014
) 
UNION ALL
SELECT *
FROM (
  SELECT '2024' AS yr, * EXCEPT(workforce,report_year) 
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce='overall' AND report_year=2024
)
LIMIT 20;
```

```sql
--Description: 6)  Compute the absolute change from 2014 → 2024
WITH y14 AS (
  SELECT * EXCEPT(workforce) 
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce='overall' AND report_year=2014
),
y24 AS (
  SELECT * EXCEPT(workforce) 
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce='overall' AND report_year=2024
)
SELECT
  y24.report_year AS year_2024,
  y14.report_year AS year_2014,
  y24.race_asian  - y14.race_asian          AS delta_asian,
  y24.race_black  - y14.race_black          AS delta_black,
  y24.race_hispanic_latinx - y14.race_hispanic_latinx AS delta_latinx,
  y24.race_native_american - y14.race_native_american AS delta_native,
  y24.race_white - y14.race_white            AS delta_white,
  y24.gender_us_women   - y14.gender_us_women   AS delta_us_women,
  y24.gender_us_men     - y14.gender_us_men     AS delta_us_men,
  y24.gender_global_women - y14.gender_global_women AS delta_global_women,
  y24.gender_global_men   - y14.gender_global_men   AS delta_global_men
FROM y14 CROSS JOIN y24
LIMIT 20;
```

```sql
--Description: 7)  FINAL – calculate growth rates ((2024−2014)/2014)
WITH y14 AS (
  SELECT * EXCEPT(workforce) 
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce='overall' AND report_year=2014
),
y24 AS (
  SELECT * EXCEPT(workforce) 
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce='overall' AND report_year=2024
)
SELECT
  ROUND( (y24.race_asian           - y14.race_asian          ) / y14.race_asian          , 4) AS growth_rate_asian,
  ROUND( (y24.race_black           - y14.race_black          ) / y14.race_black          , 4) AS growth_rate_black,
  ROUND( (y24.race_hispanic_latinx - y14.race_hispanic_latinx) / y14.race_hispanic_latinx, 4) AS growth_rate_latinx,
  ROUND( (y24.race_native_american - y14.race_native_american) / y14.race_native_american, 4) AS growth_rate_native,
  ROUND( (y24.race_white           - y14.race_white          ) / y14.race_white          , 4) AS growth_rate_white,
  ROUND( (y24.gender_us_women      - y14.gender_us_women     ) / y14.gender_us_women     , 4) AS growth_rate_us_women,
  ROUND( (y24.gender_us_men        - y14.gender_us_men       ) / y14.gender_us_men       , 4) AS growth_rate_us_men,
  ROUND( (y24.gender_global_women  - y14.gender_global_women ) / y14.gender_global_women , 4) AS growth_rate_global_women,
  ROUND( (y24.gender_global_men    - y14.gender_global_men   ) / y14.gender_global_men   , 4) AS growth_rate_global_men
FROM y14 CROSS JOIN y24
LIMIT 20;
```

```sql
--Description: 8)  OPTIONAL – show the same growth rates in percentage format
WITH y14 AS (
  SELECT * EXCEPT(workforce) 
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce='overall' AND report_year=2014
),
y24 AS (
  SELECT * EXCEPT(workforce) 
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce='overall' AND report_year=2024
)
SELECT
  CONCAT(ROUND(100 * (y24.race_asian - y14.race_asian) / y14.race_asian ,2), '%') AS asian_growth_pct,
  CONCAT(ROUND(100 * (y24.race_black - y14.race_black) / y14.race_black ,2), '%') AS black_growth_pct,
  CONCAT(ROUND(100 * (y24.race_hispanic_latinx - y14.race_hispanic_latinx) / y14.race_hispanic_latinx ,2), '%') AS latinx_growth_pct,
  CONCAT(ROUND(100 * (y24.race_native_american - y14.race_native_american) / y14.race_native_american ,2), '%') AS native_growth_pct,
  CONCAT(ROUND(100 * (y24.race_white - y14.race_white) / y14.race_white ,2), '%') AS white_growth_pct,
  CONCAT(ROUND(100 * (y24.gender_us_women - y14.gender_us_women) / y14.gender_us_women ,2), '%') AS us_women_growth_pct,
  CONCAT(ROUND(100 * (y24.gender_us_men - y14.gender_us_men) / y14.gender_us_men ,2), '%') AS us_men_growth_pct,
  CONCAT(ROUND(100 * (y24.gender_global_women - y14.gender_global_women) / y14.gender_global_women ,2), '%') AS global_women_growth_pct,
  CONCAT(ROUND(100 * (y24.gender_global_men - y14.gender_global_men) / y14.gender_global_men ,2), '%') AS global_men_growth_pct
FROM y14 CROSS JOIN y24
LIMIT 20;
```

These queries will produce the individual 2014 and 2024 snapshots as well as the absolute and proportional (growth-rate) changes for each demographic dimension you requested.
