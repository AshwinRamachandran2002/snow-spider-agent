Query:
--Description: 6)  Compute absolute change from 2014 to the latest year instead of fixed 2024
WITH latest AS (
  SELECT MAX(report_year) AS maxyr
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
),
y14 AS (
  SELECT * EXCEPT(workforce)
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall' AND report_year = 2014
),
yLatest AS (
  SELECT * EXCEPT(workforce)
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`, latest
  WHERE workforce = 'overall' AND report_year = latest.maxyr
)
SELECT
  yLatest.report_year AS latest_year,
  y14.report_year     AS year_2014,
  yLatest.race_asian           - y14.race_asian            AS delta_asian,
  yLatest.race_black           - y14.race_black            AS delta_black,
  yLatest.race_hispanic_latinx - y14.race_hispanic_latinx  AS delta_latinx,
  yLatest.race_native_american - y14.race_native_american  AS delta_native,
  yLatest.race_white           - y14.race_white            AS delta_white,
  yLatest.gender_us_women      - y14.gender_us_women       AS delta_us_women,
  yLatest.gender_us_men        - y14.gender_us_men         AS delta_us_men,
  yLatest.gender_global_women  - y14.gender_global_women   AS delta_global_women,
  yLatest.gender_global_men    - y14.gender_global_men     AS delta_global_men
FROM y14 CROSS JOIN yLatest
LIMIT 20
