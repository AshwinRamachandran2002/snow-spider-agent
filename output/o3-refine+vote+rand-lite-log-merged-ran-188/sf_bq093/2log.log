```sql
--Description: 2) Total ETC sent (“credits”) by each address on 14-Oct-2016
SELECT 
  "from_address"  AS "address",
  SUM("value")    AS "total_sent"
FROM CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRANSACTIONS
WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489599999999
  AND "receipt_status" = 1
GROUP BY "from_address"
ORDER BY "total_sent" DESC
LIMIT 20;
```

```sql
--Description: 3) Total ETC received (“debits”) by each address on 14-Oct-2016
SELECT 
  "to_address"    AS "address",
  SUM("value")    AS "total_received"
FROM CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRANSACTIONS
WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489599999999
  AND "receipt_status" = 1
GROUP BY "to_address"
ORDER BY "total_received" DESC
LIMIT 20;
```

```sql
--Description: 4) Gas fees paid by every transaction sender on 14-Oct-2016  
--   (gas_price * receipt_gas_used)
SELECT
  "from_address"                                AS "address",
  SUM("gas_price" * "receipt_gas_used")         AS "total_gas_fee_paid"
FROM CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRANSACTIONS
WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489599999999
  AND "receipt_status" = 1
GROUP BY "from_address"
ORDER BY "total_gas_fee_paid" DESC
LIMIT 20;
```

```sql
--Description: 5) Identify all blocks from 14-Oct-2016 and the miners who produced them
SELECT 
  "number"          AS "block_number",
  "miner",
  "gas_used",
  "gas_limit",
  "timestamp"
FROM CRYPTO.CRYPTO_ETHEREUM_CLASSIC.BLOCKS
WHERE "timestamp" BETWEEN 1476403200000000 AND 1476489599999999
ORDER BY "number"
LIMIT 20;
```

```sql
--Description: 6) Aggregate the gas fees earned by each miner on 14-Oct-2016  
--   (sum over their blocks: Σ gas_used * average gas_price of txs in that block)
SELECT 
  b."miner"                                            AS "miner_address",
  SUM(b."gas_used")                                    AS "total_gas_used",
  AVG(t."gas_price")                                   AS "avg_gas_price",
  SUM(b."gas_used") * AVG(t."gas_price")               AS "gas_fee_earned"
FROM CRYPTO.CRYPTO_ETHEREUM_CLASSIC.BLOCKS       b
JOIN CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRANSACTIONS t
     ON b."number" = t."block_number"
WHERE b."timestamp" BETWEEN 1476403200000000 AND 1476489599999999
  AND t."receipt_status" = 1
GROUP BY b."miner"
ORDER BY "gas_fee_earned" DESC
LIMIT 20;
```

```sql
--Description: 7) Compute per-address net value transfer (received − sent) on 14-Oct-2016
WITH sent AS (
  SELECT "from_address" AS addr, SUM("value") AS sent_val
  FROM CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRANSACTIONS
  WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489599999999
    AND "receipt_status" = 1
  GROUP BY "from_address"
),
recv AS (
  SELECT "to_address"   AS addr, SUM("value") AS recv_val
  FROM CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRANSACTIONS
  WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489599999999
    AND "receipt_status" = 1
  GROUP BY "to_address"
)
SELECT
  COALESCE(r.addr, s.addr)                                   AS "address",
  COALESCE(recv_val, 0) - COALESCE(sent_val, 0)              AS "net_value"
FROM recv r
FULL OUTER JOIN sent s ON r.addr = s.addr
ORDER BY "net_value" DESC
LIMIT 20;
```

```sql
--Description: 8) Include gas fees to get net balance change ( value + gas rewards – gas paid )
WITH tx AS (
  SELECT 
     "from_address",
     "to_address",
     "value",
     ("gas_price" * "receipt_gas_used") AS gas_fee,
     "block_number"
  FROM CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRANSACTIONS
  WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489599999999
    AND "receipt_status" = 1
),
send AS (
  SELECT "from_address" AS addr,
         SUM("value" + gas_fee) AS debit          -- sent value plus fee paid
  FROM tx
  GROUP BY "from_address"
),
recv AS (
  SELECT "to_address" AS addr,
         SUM("value") AS credit                    -- received value (no fee)
  FROM tx
  GROUP BY "to_address"
),
miner_fee AS (
  SELECT 
     b."miner"       AS addr,
     SUM(b."gas_used") * AVG(t."gas_price") AS miner_reward
  FROM CRYPTO.CRYPTO_ETHEREUM_CLASSIC.BLOCKS b
  JOIN CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRANSACTIONS t
       ON b."number" = t."block_number"
  WHERE b."timestamp" BETWEEN 1476403200000000 AND 1476489599999999
    AND t."receipt_status" = 1
  GROUP BY b."miner"
)
SELECT 
  COALESCE(r.addr,s.addr,m.addr)                                   AS "address",
  COALESCE(credit,0) + COALESCE(miner_reward,0) - COALESCE(debit,0) AS "net_balance_change"
FROM recv r
FULL OUTER JOIN send s      ON r.addr = s.addr
FULL OUTER JOIN miner_fee m ON COALESCE(r.addr,s.addr) = m.addr
ORDER BY "net_balance_change" DESC
LIMIT 20;
```

```sql
--Description: 9) Show addresses with the largest negative net balance change (most out-flows)
SELECT *
FROM (
  -- reuse the CTE logic from query (8) but invert ordering
  WITH tx AS (
    SELECT 
       "from_address",
       "to_address",
       "value",
       ("gas_price" * "receipt_gas_used") AS gas_fee,
       "block_number"
    FROM CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRANSACTIONS
    WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489599999999999
      AND "receipt_status" = 1
  ),
  send AS (
    SELECT "from_address" AS addr,
           SUM("value" + gas_fee) AS debit
    FROM tx
    GROUP BY "from_address"
  ),
  recv AS (
    SELECT "to_address" AS addr,
           SUM("value") AS credit
    FROM tx
    GROUP BY "to_address"
  )
  SELECT 
     COALESCE(r.addr,s.addr)                             AS "address",
     COALESCE(credit,0) - COALESCE(debit,0)              AS "net_value"
  FROM recv r
  FULL OUTER JOIN send s ON r.addr = s.addr
)
ORDER BY "net_value" ASC
LIMIT 20;
```

```sql
--Description: 10) Distinct list of all participant addresses (senders, receivers, miners) on 14-Oct-2016
SELECT DISTINCT "address"
FROM (
    SELECT "from_address" AS "address"
    FROM CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRANSACTIONS
    WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489599999999
      AND "receipt_status" = 1
    UNION
    SELECT "to_address" AS "address"
    FROM CRYPTO.CRYPTO_ETHEREUM_CLASSIC.TRANSACTIONS
    WHERE "block_timestamp" BETWEEN 1476403200000000 AND 1476489599999999
      AND "receipt_status" = 1
    UNION
    SELECT "miner" AS "address"
    FROM CRYPTO.CRYPTO_ETHEREUM_CLASSIC.BLOCKS
    WHERE "timestamp" BETWEEN 1476403200000000 AND 1476489599999999
)
LIMIT 20;
```
