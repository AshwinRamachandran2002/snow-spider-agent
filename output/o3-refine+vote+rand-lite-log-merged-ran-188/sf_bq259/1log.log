```sql
--Description: Peek at raw “ORDERS” records (chronological) to understand the purchase-time field we will cohort by.
SELECT 
  "order_id",
  "user_id",
  "status",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
ORDER BY "created_at"
LIMIT 20;
```

```sql
--Description: Discover every order status present in the data set.
SELECT DISTINCT 
  "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
LIMIT 20;
```

```sql
--Description: Retrieve the very first purchase date for a handful of users (earliest “created_at” per user).
SELECT 
  "user_id",
  MIN("created_at") AS "first_purchase_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "status" ILIKE '%complete%'
GROUP BY "user_id"
ORDER BY "first_purchase_ts"
LIMIT 20;
```

```sql
--Description: View monthly order counts (all statuses) up to the end of 2022.
SELECT 
  TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1e6), 'YYYY-MM')   AS "order_month",
  COUNT(*)                                                 AS "orders_in_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1e6), 'YYYY') <= '2022'
GROUP BY "order_month"
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: Sample join of “ORDERS” with their “ORDER_ITEMS” to see sale price and status details.
SELECT 
  oi."id"                 AS "order_item_id",
  o."order_id",
  o."user_id",
  oi."product_id",
  oi."sale_price",
  oi."status",
  o."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
     ON oi."order_id" = o."order_id"
ORDER BY oi."created_at"
LIMIT 20;
```

```sql
--Description: List the distinct statuses that an “ORDER_ITEMS” row can take.
SELECT DISTINCT 
  "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: Examine orders created in calendar year 2022 only (confirming date filter logic).
SELECT 
  "order_id",
  "user_id",
  "status",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1e6), 'YYYY') = '2022'
LIMIT 20;
```

```sql
--Description: Count unique purchasers per month through 2022 (needed for cohort denominators).
SELECT 
  TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1e6), 'YYYY-MM') AS "order_month",
  COUNT(DISTINCT "user_id")                              AS "unique_buyers"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1e6), 'YYYY') <= '2022'
GROUP BY "order_month"
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: Inspect user sign-up timestamps and demographics in case we need to segment.
SELECT 
  "id"          AS "user_id",
  "gender",
  "age",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
ORDER BY "created_at"
LIMIT 20;
```

```sql
--Description: For a sample of users, list each purchase month versus their first purchase month (helps validate month-index logic).
WITH first_purchase AS (
  SELECT 
    "user_id",
    MIN("created_at") AS "first_purchase_ts"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  WHERE "status" ILIKE '%complete%'
  GROUP BY "user_id"
)
SELECT 
  o."user_id",
  TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_purchase_ts"/1e6), 'YYYY-MM')               AS "first_month",
  TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1e6), 'YYYY-MM')                       AS "order_month",
  DATEDIFF(month,
           TO_DATE(TO_TIMESTAMP_NTZ(fp."first_purchase_ts"/1e6)),
           TO_DATE(TO_TIMESTAMP_NTZ(o."created_at"/1e6)))                         AS "months_since_first"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN first_purchase fp
  ON o."user_id" = fp."user_id"
WHERE o."status" ILIKE '%complete%'
ORDER BY o."user_id", o."created_at"
LIMIT 20;
```
