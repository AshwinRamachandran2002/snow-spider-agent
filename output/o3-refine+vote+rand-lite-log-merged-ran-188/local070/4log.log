Query:
-- Description: (Complex) Continuous-date streak lengths with one city per date for July-2021 Chinese cities
WITH jul_dates AS (
    SELECT DISTINCT "insert_date"
    FROM "cities"
    WHERE "country_code_2" = 'cn'
      AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
),
ordered AS (
    SELECT "insert_date",
           ROW_NUMBER() OVER (ORDER BY "insert_date") AS rn
    FROM jul_dates
),
grp AS (
    SELECT o.*,
           DATE("insert_date", '-' || rn || ' day') AS grp_key
    FROM ordered o
),
streaks AS (
    SELECT grp_key,
           MIN("insert_date") AS streak_start,
           MAX("insert_date") AS streak_end,
           COUNT(*)         AS len
    FROM grp
    GROUP BY grp_key
)
SELECT s.grp_key, s.streak_start, s.streak_end, s.len
FROM streaks s
ORDER BY s.len ASC, s.streak_start
LIMIT 20;
