```sql
-- Description: Build a list with row_number so we can later spot consecutive-date gaps
SELECT "insert_date",
       ROW_NUMBER() OVER (ORDER BY "insert_date") AS rn
FROM (
    SELECT DISTINCT "insert_date"
    FROM "cities"
    WHERE "country_code_2" = 'cn'
      AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
) AS d
ORDER BY "insert_date"
LIMIT 20;
```

```sql
-- Description: Prepare each date along with its (Jul-2021) row_number & (row_number – 1 day) key for streak detection
SELECT d."insert_date",
       ROW_NUMBER() OVER (ORDER BY d."insert_date") AS rn,
       DATE(d."insert_date", '-1 day') AS prev_day
FROM (
    SELECT DISTINCT "insert_date"
    FROM "cities"
    WHERE "country_code_2" = 'cn'
      AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
) AS d
ORDER BY d."insert_date"
LIMIT 20;
```

```sql
-- Description: Pick one exemplar city per date (capitalized) for July-2021 Chinese records
SELECT DISTINCT d."insert_date",
       UPPER(SUBSTR(c."city_name", 1, 1)) || LOWER(SUBSTR(c."city_name", 2)) AS city_name_cap
FROM "cities" AS c
JOIN (
    SELECT DISTINCT "insert_date"
    FROM "cities"
    WHERE "country_code_2" = 'cn'
      AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
) AS d
ON c."insert_date" = d."insert_date"
WHERE c."country_code_2" = 'cn'
ORDER BY d."insert_date"
LIMIT 20;
```

```sql
-- Description: (Complex) Continuous-date streak lengths with one city per date for July-2021 Chinese cities
WITH jul_dates AS (
    SELECT DISTINCT "insert_date"
    FROM "cities"
    WHERE "country_code_2" = 'cn'
      AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
),
ordered AS (
    SELECT "insert_date",
           ROW_NUMBER() OVER (ORDER BY "insert_date") AS rn
    FROM jul_dates
),
grp AS (
    SELECT o.*,
           DATE("insert_date", '-' || rn || ' day') AS grp_key
    FROM ordered o
),
streaks AS (
    SELECT grp_key,
           MIN("insert_date") AS streak_start,
           MAX("insert_date") AS streak_end,
           COUNT(*)         AS len
    FROM grp
    GROUP BY grp_key
)
SELECT s.grp_key, s.streak_start, s.streak_end, s.len
FROM streaks s
ORDER BY s.len ASC, s.streak_start
LIMIT 20;
```
