Query:
-- 6.  Length (number of days) of every consecutive-date streak in July-2021
WITH dates AS (
    SELECT DISTINCT DATE(insert_date) AS dt
    FROM   cities
    WHERE  country_code_2 = 'cn'
      AND  insert_date BETWEEN '2021-07-01' AND '2021-07-31'
),
ordered AS (
    SELECT dt,
           ROW_NUMBER() OVER (ORDER BY dt) AS rn,
           julianday(dt)                   AS jd
    FROM   dates
),
groups AS (
    SELECT dt,
           rn - CAST(jd AS INTEGER) AS grp
    FROM   ordered
)
SELECT grp,
       MIN(dt)            AS start_date,
       MAX(dt)            AS end_date,
       COUNT(*)           AS streak_len
FROM   groups
GROUP  BY grp
ORDER  BY streak_len DESC, start_date
LIMIT 20;
