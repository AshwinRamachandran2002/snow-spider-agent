-- 10.  FINAL ANSWER: July-2021 dates & city names for both the shortest and
--     the longest consecutive-date streaks, one row per date, ordered by date
WITH julydates AS (
    SELECT DISTINCT DATE(insert_date) AS dt
    FROM   cities
    WHERE  country_code_2 = 'cn'
      AND  insert_date BETWEEN '2021-07-01' AND '2021-07-31'
),
ordered AS (
    SELECT dt,
           ROW_NUMBER() OVER (ORDER BY dt) AS rn,
           julianday(dt)                   AS jd
    FROM   julydates
),
groups AS (
    SELECT dt,
           rn - CAST(jd AS INTEGER) AS grp
    FROM   ordered
),
streaks AS (
    SELECT grp, COUNT(*) AS streak_len
    FROM   groups
    GROUP  BY grp
),
limits AS (
    SELECT MIN(streak_len) AS shortest , MAX(streak_len) AS longest FROM streaks
),
sel_dates AS (
    SELECT g.dt
    FROM   groups  AS g
    JOIN   streaks AS s  USING (grp)
    JOIN   limits  l ON s.streak_len IN (l.shortest, l.longest)
)
SELECT DISTINCT DATE(c.insert_date)                                AS date ,
       UPPER(SUBSTR(c.city_name,1,1)) ||
       LOWER(SUBSTR(c.city_name,2))                                AS city
FROM   cities  AS c
JOIN   sel_dates s ON DATE(c.insert_date) = s.dt
WHERE  c.country_code_2 = 'cn'
ORDER  BY date;
