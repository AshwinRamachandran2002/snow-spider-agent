```sql
-- 4.  Every July-2021 date for China together with how many rows each date has
SELECT DATE(insert_date)            AS dt ,
       COUNT(*)                     AS rows_in_that_date
FROM   cities
WHERE  country_code_2 = 'cn'
  AND  insert_date BETWEEN '2021-07-01' AND '2021-07-31'
GROUP  BY DATE(insert_date)
ORDER  BY dt
LIMIT 31;
```

```sql
-- 5.  Create “date groups” (grp) : consecutive calendar days share the same grp
WITH dates AS (
    SELECT DISTINCT DATE(insert_date) AS dt
    FROM   cities
    WHERE  country_code_2 = 'cn'
      AND  insert_date BETWEEN '2021-07-01' AND '2021-07-31'
),
ordered AS (
    SELECT dt,
           ROW_NUMBER()  OVER (ORDER BY dt)       AS rn,
           julianday(dt)                          AS jd
    FROM   dates
)
SELECT dt,
       rn - CAST(jd AS INTEGER) AS grp            -- constant inside a streak
FROM   ordered
ORDER  BY dt
LIMIT 31;
```

```sql
-- 6.  Length (number of days) of every consecutive-date streak in July-2021
WITH dates AS (
    SELECT DISTINCT DATE(insert_date) AS dt
    FROM   cities
    WHERE  country_code_2 = 'cn'
      AND  insert_date BETWEEN '2021-07-01' AND '2021-07-31'
),
ordered AS (
    SELECT dt,
           ROW_NUMBER() OVER (ORDER BY dt) AS rn,
           julianday(dt)                   AS jd
    FROM   dates
),
groups AS (
    SELECT dt,
           rn - CAST(jd AS INTEGER) AS grp
    FROM   ordered
)
SELECT grp,
       MIN(dt)            AS start_date,
       MAX(dt)            AS end_date,
       COUNT(*)           AS streak_len
FROM   groups
GROUP  BY grp
ORDER  BY streak_len DESC, start_date
LIMIT 20;
```

```sql
-- 7.  Identify the shortest and longest streak lengths
WITH streaks AS (
    /* use query #6 but keep only grp & streak_len */
    WITH dates AS (
        SELECT DISTINCT DATE(insert_date) AS dt
        FROM   cities
        WHERE  country_code_2 = 'cn'
          AND  insert_date BETWEEN '2021-07-01' AND '2021-07-31'
    ),
    ordered AS (
        SELECT dt,
               ROW_NUMBER() OVER (ORDER BY dt) AS rn,
               julianday(dt)                   AS jd
        FROM   dates
    ),
    groups AS (
        SELECT dt,
               rn - CAST(jd AS INTEGER) AS grp
        FROM   ordered
    )
    SELECT grp, COUNT(*) AS streak_len
    FROM   groups
    GROUP  BY grp
)
SELECT MIN(streak_len) AS shortest_streak ,
       MAX(streak_len) AS longest_streak
FROM   streaks;
```

```sql
-- 8.  All July-2021 dates that belong to either the shortest OR longest streak
WITH dates AS (
    SELECT DISTINCT DATE(insert_date) AS dt
    FROM   cities
    WHERE  country_code_2 = 'cn'
      AND  insert_date BETWEEN '2021-07-01' AND '2021-07-31'
),
ordered AS (
    SELECT dt,
           ROW_NUMBER() OVER (ORDER BY dt) AS rn,
           julianday(dt)                   AS jd
    FROM   dates
),
groups AS (
    SELECT dt,
           rn - CAST(jd AS INTEGER) AS grp
    FROM   ordered
),
streaks AS (
    SELECT grp, COUNT(*) AS streak_len
    FROM   groups
    GROUP  BY grp
),
thresholds AS (
    SELECT MIN(streak_len) AS shortest , MAX(streak_len) AS longest FROM streaks
)
SELECT g.dt
FROM   groups  AS g
JOIN   streaks AS s  USING (grp)
JOIN   thresholds t ON s.streak_len IN (t.shortest, t.longest)
ORDER  BY g.dt
LIMIT 40;
```

```sql
-- 9.  Pick exactly ONE sample row (city) for every date returned in query #8
WITH target_dates AS (
    /* reuse query #8 */
    WITH dates AS (
        SELECT DISTINCT DATE(insert_date) AS dt
        FROM   cities
        WHERE  country_code_2 = 'cn'
          AND  insert_date BETWEEN '2021-07-01' AND '2021-07-31'
    ),
    ordered AS (
        SELECT dt,
               ROW_NUMBER() OVER (ORDER BY dt) AS rn,
               julianday(dt)                   AS jd
        FROM   dates
    ),
    groups AS (
        SELECT dt,
               rn - CAST(jd AS INTEGER) AS grp
        FROM   ordered
    ),
    streaks AS (
        SELECT grp, COUNT(*) AS streak_len
        FROM   groups
        GROUP  BY grp
    ),
    thresholds AS (
        SELECT MIN(streak_len) AS shortest , MAX(streak_len) AS longest
        FROM   streaks
    )
    SELECT g.dt
    FROM   groups  AS g
    JOIN   streaks AS s  USING (grp)
    JOIN   thresholds t ON s.streak_len IN (t.shortest, t.longest)
)
SELECT DISTINCT DATE(c.insert_date)                                AS date ,
       UPPER(SUBSTR(c.city_name,1,1)) ||
       LOWER(SUBSTR(c.city_name,2))                                AS city
FROM   cities  AS c
JOIN   target_dates td ON DATE(c.insert_date) = td.dt
WHERE  c.country_code_2 = 'cn'
ORDER  BY date
LIMIT 40;
```

```sql
-- 10.  FINAL ANSWER: July-2021 dates & city names for both the shortest and
--     the longest consecutive-date streaks, one row per date, ordered by date
WITH julydates AS (
    SELECT DISTINCT DATE(insert_date) AS dt
    FROM   cities
    WHERE  country_code_2 = 'cn'
      AND  insert_date BETWEEN '2021-07-01' AND '2021-07-31'
),
ordered AS (
    SELECT dt,
           ROW_NUMBER() OVER (ORDER BY dt) AS rn,
           julianday(dt)                   AS jd
    FROM   julydates
),
groups AS (
    SELECT dt,
           rn - CAST(jd AS INTEGER) AS grp
    FROM   ordered
),
streaks AS (
    SELECT grp, COUNT(*) AS streak_len
    FROM   groups
    GROUP  BY grp
),
limits AS (
    SELECT MIN(streak_len) AS shortest , MAX(streak_len) AS longest FROM streaks
),
sel_dates AS (
    SELECT g.dt
    FROM   groups  AS g
    JOIN   streaks AS s  USING (grp)
    JOIN   limits  l ON s.streak_len IN (l.shortest, l.longest)
)
SELECT DISTINCT DATE(c.insert_date)                                AS date ,
       UPPER(SUBSTR(c.city_name,1,1)) ||
       LOWER(SUBSTR(c.city_name,2))                                AS city
FROM   cities  AS c
JOIN   sel_dates s ON DATE(c.insert_date) = s.dt
WHERE  c.country_code_2 = 'cn'
ORDER  BY date;
```
