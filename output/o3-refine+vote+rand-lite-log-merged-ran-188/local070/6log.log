Query:
-- 8.  Fetch every date that belongs to the shortest consecutive streak  
WITH
dates AS (
    SELECT DISTINCT DATE("insert_date")             AS "dt",
           JULIANDAY(DATE("insert_date"))            AS "jd",
           ROW_NUMBER() OVER (ORDER BY DATE("insert_date")) AS "rn"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
),
streaks AS (
    SELECT (jd - rn) AS "grp",
           COUNT(*)  AS "len"
    FROM   dates
    GROUP  BY (jd - rn)
),
target AS (
    SELECT grp
    FROM   streaks
    WHERE  len = (SELECT MIN(len) FROM streaks)
)
SELECT d.dt,
       MIN(c.city_name) AS "city_name"
FROM   dates d
JOIN   target t          ON (jd - rn) = t.grp
JOIN   "cities" c        ON DATE(c.insert_date) = d.dt
WHERE  c.country_code_2 = 'cn'
GROUP  BY d.dt
ORDER  BY d.dt;
