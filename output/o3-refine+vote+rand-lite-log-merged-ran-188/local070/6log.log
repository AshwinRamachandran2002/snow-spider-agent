Query:
-- 7.  Isolate the shortest and longest streak lengths  
WITH dates AS (
    SELECT DISTINCT DATE("insert_date")             AS "dt",
           JULIANDAY(DATE("insert_date"))            AS "jd",
           ROW_NUMBER() OVER (ORDER BY DATE("insert_date")) AS "rn"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
),
streaks AS (
    SELECT (jd - rn)               AS "grp",
           COUNT(*)                AS "len"
    FROM   dates
    GROUP  BY (jd - rn)
)
SELECT MIN(len) AS "shortest_len",
       MAX(len) AS "longest_len"
FROM   streaks;
