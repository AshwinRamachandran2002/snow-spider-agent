Query:
-- 6.  Build streak‐ids (jd-rn) and calculate the length of every consecutive-date streak  
WITH dates AS (
    SELECT DISTINCT DATE("insert_date")             AS "dt",
           JULIANDAY(DATE("insert_date"))            AS "jd",
           ROW_NUMBER() OVER (ORDER BY DATE("insert_date")) AS "rn"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
)
SELECT (jd - rn)                      AS "streak_id",
       MIN(dt)                        AS "start_dt",
       MAX(dt)                        AS "end_dt",
       COUNT(*)                       AS "streak_len"
FROM   dates
GROUP  BY (jd - rn)
ORDER  BY "streak_len"
LIMIT 20;
