```sql
-- 5.  Give every distinct July-2021 date a running row number for later gap analysis  
SELECT DATE("insert_date")                                        AS "dt",
       ROW_NUMBER() OVER (ORDER BY DATE("insert_date"))           AS "rn"
FROM   "cities"
WHERE  "country_code_2" = 'cn'
  AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
GROUP  BY "dt"
ORDER  BY "dt"
LIMIT 20;
```

```sql
-- 6.  Build streak‐ids (jd-rn) and calculate the length of every consecutive-date streak  
WITH dates AS (
    SELECT DISTINCT DATE("insert_date")             AS "dt",
           JULIANDAY(DATE("insert_date"))            AS "jd",
           ROW_NUMBER() OVER (ORDER BY DATE("insert_date")) AS "rn"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
)
SELECT (jd - rn)                      AS "streak_id",
       MIN(dt)                        AS "start_dt",
       MAX(dt)                        AS "end_dt",
       COUNT(*)                       AS "streak_len"
FROM   dates
GROUP  BY (jd - rn)
ORDER  BY "streak_len"
LIMIT 20;
```

```sql
-- 7.  Isolate the shortest and longest streak lengths  
WITH dates AS (
    SELECT DISTINCT DATE("insert_date")             AS "dt",
           JULIANDAY(DATE("insert_date"))            AS "jd",
           ROW_NUMBER() OVER (ORDER BY DATE("insert_date")) AS "rn"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
),
streaks AS (
    SELECT (jd - rn)               AS "grp",
           COUNT(*)                AS "len"
    FROM   dates
    GROUP  BY (jd - rn)
)
SELECT MIN(len) AS "shortest_len",
       MAX(len) AS "longest_len"
FROM   streaks;
```

```sql
-- 8.  Fetch every date that belongs to the shortest consecutive streak  
WITH
dates AS (
    SELECT DISTINCT DATE("insert_date")             AS "dt",
           JULIANDAY(DATE("insert_date"))            AS "jd",
           ROW_NUMBER() OVER (ORDER BY DATE("insert_date")) AS "rn"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
),
streaks AS (
    SELECT (jd - rn) AS "grp",
           COUNT(*)  AS "len"
    FROM   dates
    GROUP  BY (jd - rn)
),
target AS (
    SELECT grp
    FROM   streaks
    WHERE  len = (SELECT MIN(len) FROM streaks)
)
SELECT d.dt,
       MIN(c.city_name) AS "city_name"
FROM   dates d
JOIN   target t          ON (jd - rn) = t.grp
JOIN   "cities" c        ON DATE(c.insert_date) = d.dt
WHERE  c.country_code_2 = 'cn'
GROUP  BY d.dt
ORDER  BY d.dt;
```

```sql
-- 9.  Fetch every date that belongs to the longest consecutive streak  
WITH
dates AS (
    SELECT DISTINCT DATE("insert_date")             AS "dt",
           JULIANDAY(DATE("insert_date"))            AS "jd",
           ROW_NUMBER() OVER (ORDER BY DATE("insert_date")) AS "rn"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
),
streaks AS (
    SELECT (jd - rn) AS "grp",
           COUNT(*)  AS "len"
    FROM   dates
    GROUP  BY (jd - rn)
),
target AS (
    SELECT grp
    FROM   streaks
    WHERE  len = (SELECT MAX(len) FROM streaks)
)
SELECT d.dt,
       MIN(c.city_name) AS "city_name"
FROM   dates d
JOIN   target t          ON (jd - rn) = t.grp
JOIN   "cities" c        ON DATE(c.insert_date) = d.dt
WHERE  c.country_code_2 = 'cn'
GROUP  BY d.dt
ORDER  BY d.dt;
```

```sql
-- 10.  FINAL ANSWER:  show all dates for both the shortest and the longest July-2021 streaks
WITH cn_july AS (
    SELECT DATE("insert_date") AS dt,
           "city_name"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
),
ordered AS (
    SELECT DISTINCT dt,
           JULIANDAY(dt)                               AS jd,
           ROW_NUMBER() OVER (ORDER BY dt)             AS rn
    FROM   cn_july
),
streaks AS (
    SELECT jd - rn                                     AS grp,
           COUNT(*)                                    AS len
    FROM   ordered
    GROUP  BY grp
),
target_grp AS (
    SELECT grp
    FROM   streaks
    WHERE  len = (SELECT MIN(len) FROM streaks)
       OR  len = (SELECT MAX(len) FROM streaks)
),
target_dates AS (
    SELECT o.dt
    FROM   ordered o
    JOIN   target_grp tg ON (o.jd - o.rn) = tg.grp
),
one_city_per_date AS (
    SELECT td.dt,
           MIN(cj.city_name) AS city_name
    FROM   target_dates td
    JOIN   cn_july cj ON cj.dt = td.dt
    GROUP  BY td.dt
)
SELECT dt                                   AS "date",
       SUBSTR(UPPER(city_name),1,1) ||
       LOWER(SUBSTR(city_name,2))           AS "city_name"
FROM   one_city_per_date
ORDER  BY dt;
```
