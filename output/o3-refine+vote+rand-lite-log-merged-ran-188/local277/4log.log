     FROM   monthly_sales
     WHERE  product_id IN (4160, 7790)
       AND  mth >= '2016-01-01'
       AND  mth <  '2019-01-01'
),
weighed AS (
     SELECT product_id,
            CAST(idx AS REAL)                         AS x,
            qty                                       AS y,
            CASE WHEN idx BETWEEN 7 AND 30 THEN 2.0 ELSE 1.0 END AS w
     FROM   seq
),
sums AS (
     SELECT product_id,
            SUM(w)      AS sw,
            SUM(w*x)    AS swx,
            SUM(w*x*x)  AS swx2,
            SUM(w*y)    AS swy,
            SUM(w*x*y)  AS swxy
     FROM   weighed
     GROUP BY product_id
),
params AS (
     SELECT product_id,
            (swxy - swx*swy/sw) / (swx2 - swx*swx/sw)                   AS slope,
            (swy  - ((swxy - swx*swy/sw) / (swx2 - swx*swx/sw))*swx) / sw AS intercept
     FROM   sums
),
forecast AS (
     SELECT w.product_id,
            w.x                        AS idx,
            params.intercept + params.slope*w.x  AS y_hat
     FROM   weighed AS w
     JOIN   params  USING (product_id)
     WHERE  w.idx BETWEEN 25 AND 36          -- the 12 months of 2018
)
SELECT product_id,
       AVG(y_hat) AS avg_forecast_2018
FROM   forecast
GROUP  BY product_id;
