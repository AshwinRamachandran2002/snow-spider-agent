```sql
-- 5) Build the modelling data set (month index + seasonality weight)
WITH seq AS (
     SELECT product_id,
            mth,
            qty,
            ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY mth) AS idx
     FROM   monthly_sales
     WHERE  product_id IN (4160, 7790)
       AND  mth >= '2016-01-01'
       AND  mth <  '2019-01-01'          -- only the first 36 months
),
weighed AS (
     SELECT product_id,
            idx,
            qty,
            CASE WHEN idx BETWEEN 7 AND 30 THEN 2.0 ELSE 1.0 END AS w   -- seasonality weight
     FROM   seq
)
SELECT DISTINCT * 
FROM weighed
ORDER BY product_id, idx
LIMIT 20;
```

```sql
-- 6) Compute all weighted sums needed for a weighted least-squares regression
WITH seq AS (
     SELECT product_id,
            mth,
            qty,
            ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY mth) AS idx
     FROM   monthly_sales
     WHERE  product_id IN (4160, 7790)
       AND  mth >= '2016-01-01'
       AND  mth <  '2019-01-01'
),
weighed AS (
     SELECT product_id,
            CAST(idx AS REAL)                         AS x,
            qty                                       AS y,
            CASE WHEN idx BETWEEN 7 AND 30 THEN 2.0 ELSE 1.0 END AS w
     FROM   seq
)
SELECT DISTINCT product_id,
       SUM(w)      AS sw,
       SUM(w*x)    AS swx,
       SUM(w*x*x)  AS swx2,
       SUM(w*y)    AS swy,
       SUM(w*x*y)  AS swxy
FROM   weighed
GROUP  BY product_id
LIMIT 20;
```

```sql
-- 7) Derive slope & intercept for each product’s weighted regression line
WITH seq AS (
     SELECT product_id,
            mth,
            qty,
            ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY mth) AS idx
     FROM   monthly_sales
     WHERE  product_id IN (4160, 7790)
       AND  mth >= '2016-01-01'
       AND  mth <  '2019-01-01'
),
weighed AS (
     SELECT product_id,
            CAST(idx AS REAL)                         AS x,
            qty                                       AS y,
            CASE WHEN idx BETWEEN 7 AND 30 THEN 2.0 ELSE 1.0 END AS w
     FROM   seq
),
sums AS (
     SELECT product_id,
            SUM(w)      AS sw,
            SUM(w*x)    AS swx,
            SUM(w*x*x)  AS swx2,
            SUM(w*y)    AS swy,
            SUM(w*x*y)  AS swxy
     FROM   weighed
     GROUP BY product_id
)
SELECT DISTINCT product_id,
       (swxy - swx*swy/sw) / (swx2 - swx*swx/sw)                   AS slope,
       (swy  - ((swxy - swx*swy/sw) / (swx2 - swx*swx/sw))*swx) / sw AS intercept
FROM   sums
LIMIT 20;
```

