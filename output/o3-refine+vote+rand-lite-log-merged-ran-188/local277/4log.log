weighed AS (
    SELECT product_id,
           CAST(idx AS REAL)                                        AS x,
           qty                                                      AS y,
           CASE WHEN idx BETWEEN 7 AND 30 THEN 2.0 ELSE 1.0 END     AS w
    FROM   seq
),
sums AS (
    SELECT product_id,
           SUM(w)        AS sw,
           SUM(w*x)      AS swx,
           SUM(w*x*x)    AS swx2,
           SUM(w*y)      AS swy,
           SUM(w*x*y)    AS swxy
    FROM   weighed
