```sql
--Description: Forecast 2018 average sales for products 4160 & 7790 in one go. 
--Steps: (1) pull 36-month history (Jan-2016‥Dec-2018) and assign sequential index 1-36; 
--(2) apply seasonality weight=2 for indices 7-30, otherwise 1; 
--(3) compute weighted-least-squares sums Σw, Σwx, Σwx², Σwy, Σwxy; 
--(4) solve for slope & intercept; 
--(5) predict sales for indices 25-36 (the twelve months of 2018); 
--(6) return each product’s average 2018 forecast.  
WITH seq AS (
    SELECT product_id,
           qty,
           ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY mth) AS idx
    FROM   monthly_sales
    WHERE  product_id IN (4160, 7790)
      AND  mth BETWEEN '2016-01-01' AND '2018-12-01'
),
weighed AS (
    SELECT product_id,
           CAST(idx AS REAL)                                        AS x,
           qty                                                      AS y,
           CASE WHEN idx BETWEEN 7 AND 30 THEN 2.0 ELSE 1.0 END     AS w
    FROM   seq
),
sums AS (
    SELECT product_id,
           SUM(w)        AS sw,
           SUM(w*x)      AS swx,
           SUM(w*x*x)    AS swx2,
           SUM(w*y)      AS swy,
           SUM(w*x*y)    AS swxy
    FROM   weighed
    GROUP BY product_id
),
params AS (
    SELECT product_id,
           (swxy - swx*swy/sw) / (swx2 - swx*swx/sw)                       AS slope,
           (swy  - ((swxy - swx*swy/sw) / (swx2 - swx*swx/sw))*swx) / sw   AS intercept
    FROM   sums
),
forecast AS (
    SELECT w.product_id,
           params.intercept + params.slope*w.x AS y_hat
    FROM   weighed AS w
    JOIN   params USING (product_id)
    WHERE  w.x BETWEEN 25 AND 36
)
SELECT product_id,
       AVG(y_hat) AS avg_forecast_2018
FROM   forecast
GROUP BY product_id;
```
