--Description: Determine the earliest and latest order dates that actually contain product 7790 in the orderlines-plus-orders data, so we know which date range would be valid before applying any detailed filters.
SELECT
    MIN(o."ordered") AS first_order_date,
    MAX(o."ordered") AS last_order_date
FROM   "orders"      AS o
JOIN   "orderlines"  AS l
       ON o."id" = l."order_id"
WHERE  l."product_id" = 7790
