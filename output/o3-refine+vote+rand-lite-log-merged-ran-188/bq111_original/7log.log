--  Pearson correlations, by chromosome and aberration class,
--  between Mitelman‐DB (breast carcinoma: Morph = 3111, Topo = 0401)
--  and TCGA GISTIC2 thresholded copy‑number calls
--
--  Aberration classes considered
--      2 → “Amp”  (high–level amplification)
--      1 → “Gain”
--     -1 → “Loss”
--     -2 → “Del”  (deep deletion)
--
--  Only chromosomes / aberration classes that have ≥ 5 cytobands shared
--  between the two resources are reported.
WITH
/* -----------------------------------------------------------
   1.  Mitelman cases that correspond to breast carcinoma
------------------------------------------------------------ */
mitelman_breast_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111'             -- breast carcinoma
     AND Topo  = '0401'             -- primary site: breast
),

/* -----------------------------------------------------------
   2.  Mitelman CNV calls mapped to cytobands
------------------------------------------------------------ */
mitelman_band_counts AS (
  SELECT
      cb.chromosome                       AS chr,           -- e.g. 'chr8'
      cb.cytoband_name                    AS band,          -- e.g. '8q24'
      c.Type                              AS aberration,    -- 'Gain','Amp','Loss','Del'
      COUNT(DISTINCT CONCAT(CAST(c.RefNo AS STRING),'_',c.CaseNo))
                                            AS n_cases_band
  FROM   `mitelman-db.prod.CytoConverted`          AS c
  JOIN   mitelman_breast_cases                     AS bc
           ON  c.RefNo  = bc.RefNo
           AND c.CaseNo = bc.CaseNo
  JOIN   `mitelman-db.prod.CytoBands_hg38`         AS cb
           ON  c.Chr             = cb.chromosome
          AND  c.Start < cb.hg38_stop              -- interval overlap
          AND  c.End   > cb.hg38_start
  WHERE  c.Type IN ('Gain','Amp','Loss','Del')
  GROUP BY chr, band, aberration
),

/* total Mitelman cases per (chr,band) – will be the denominator
   when turning raw counts into within‑band frequencies            */
mitelman_band_totals AS (
  SELECT chr, band, SUM(n_cases_band) AS total_cases_band
  FROM   mitelman_band_counts
  GROUP  BY chr, band
),

mitelman_band_freq AS (
  SELECT
      m.chr,
      m.band,
      m.aberration,
      SAFE_DIVIDE(m.n_cases_band, t.total_cases_band) AS mitelman_freq
  FROM   mitelman_band_counts  AS m
  JOIN   mitelman_band_totals  AS t
           USING (chr, band)
),

/* -----------------------------------------------------------
   3.  TCGA GISTIC2 thresholded calls mapped to cytobands
------------------------------------------------------------ */
tcga_threshold AS (
  SELECT
      CASE
        WHEN chromosome = '23' THEN 'chrX'
        WHEN chromosome = '24' THEN 'chrY'
        ELSE CONCAT('chr', chromosome)
      END                                           AS chr,
      cytoband                                      AS band,        -- already in “1p36”, “8q24” form
      CASE value
          WHEN  2  THEN 'Amp'
          WHEN  1  THEN 'Gain'
          WHEN -1  THEN 'Loss'
          WHEN -2  THEN 'Del'
      END                                           AS aberration,
      sample_barcode                                AS sample
  FROM  `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Gistic2_Thresholded`
  WHERE value IN (2,1,-1,-2)        -- keep only aberrant calls
),

tcga_band_counts AS (
  SELECT
      chr,
      band,
      aberration,
      COUNT(DISTINCT sample)              AS n_samples_band
  FROM  tcga_threshold
  GROUP BY chr, band, aberration
),

tcga_band_totals AS (
  SELECT chr, band, SUM(n_samples_band) AS total_samples_band
  FROM   tcga_band_counts
  GROUP  BY chr, band
),

tcga_band_freq AS (
  SELECT
      t.chr,
      t.band,
      t.aberration,
      SAFE_DIVIDE(t.n_samples_band, s.total_samples_band) AS tcga_freq
  FROM   tcga_band_counts  AS t
  JOIN   tcga_band_totals  AS s
         USING (chr, band)
),

/* -----------------------------------------------------------
   4.  Join the two resources on (chr,band,aberration) and
       prepare vectors for correlation
------------------------------------------------------------ */
combined AS (
  SELECT
      m.chr,
      m.band,
      m.aberration,
      m.mitelman_freq,
      t.tcga_freq
  FROM   mitelman_band_freq  AS m
  JOIN   tcga_band_freq      AS t
         ON  m.chr        = t.chr
         AND m.band       = t.band
         AND m.aberration = t.aberration
)

/* -----------------------------------------------------------
   5.  Per‑chromosome / aberration class correlations
------------------------------------------------------------ */
SELECT
    chr,
    aberration                                       AS aberration_type,
    CORR(mitelman_freq, tcga_freq)                   AS pearson_r,
    /* p‑value via ISB‑CGC helper UDF                */
    `isb-cgc-bq.functions.corr_pvalue_current`
        ( ARRAY_AGG(mitelman_freq ORDER BY band),
          ARRAY_AGG(tcga_freq     ORDER BY band) )   AS p_value,
    COUNT(*)                                         AS n_shared_bands
FROM combined
GROUP BY chr, aberration
HAVING n_shared_bands >= 5
ORDER BY chr, aberration;
