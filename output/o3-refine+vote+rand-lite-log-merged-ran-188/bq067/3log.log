```sql
--Description: Compute the average |travel_speed – speed_limit| per crash and bucket it (0-4)
SELECT
  state_number,
  consecutive_number,
  CASE
    WHEN avg_diff < 20 THEN 0
    WHEN avg_diff < 40 THEN 1
    WHEN avg_diff < 60 THEN 2
    WHEN avg_diff < 80 THEN 3
    ELSE 4
  END AS speed_diff_bucket
FROM (
  SELECT
    state_number,
    consecutive_number,
    AVG(ABS(travel_speed - speed_limit)) AS avg_diff
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  WHERE travel_speed BETWEEN 0 AND 151
    AND speed_limit BETWEEN 5 AND 80
  GROUP BY state_number, consecutive_number
)
LIMIT 20;
