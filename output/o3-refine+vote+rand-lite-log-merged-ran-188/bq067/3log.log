```sql
--Description:
-- Goal: create a modeling table (preview 20 rows) that predicts whether a crash
--       with more than one distinct person has >1 fatal injuries (label = 1).
-- Thinking process embedded step-by-step:
-- 1) accident_2016 supplies crash-level predictors:
--      • state_number
--      • number_of_drunk_drivers
--      • day_of_week, hour_of_crash
--      • work_zone  → engineer binary flag (0 if 'None', else 1)
-- 2) person_2016 determines which crashes involve >1 person and
--      counts fatalities (injury_severity = 4) for the label.
-- 3) vehicle_2016 serves two purposes:
--      a) choose a representative body_type for the crash
--         (here the smallest code per crash, MIN(body_type)).
--      b) compute average absolute speed difference
--         |travel_speed – speed_limit| using rows whose codes are truly numeric
--         (travel_speed 0-151, speed_limit 5-80).  Bucket the average
--         into 20-mph bands: 0:[0-20), 1:[20-40), 2:[40-60), 3:[60-80), 4:≥80.
-- 4) Join these three derived subqueries on (state_number, consecutive_number).
-- 5) Keep only crashes with >1 person (person_total > 1).
-- 6) Label = 1 if fatal_count > 1; else 0.
-- 7) LIMIT 20 just for a quick look.
SELECT
  a.state_number,
  v.body_type,
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
  CASE WHEN a.work_zone = 'None' THEN 0 ELSE 1 END                    AS work_zone_indicator,
  sd.speed_diff_bucket,
  CASE WHEN pf.fatal_count > 1 THEN 1 ELSE 0 END                      AS label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` AS a
/* ---------- representative body_type per crash ---------- */
JOIN (
  SELECT
    state_number,
    consecutive_number,
    MIN(body_type) AS body_type
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  GROUP BY state_number, consecutive_number
) AS v
USING (state_number, consecutive_number)
/* ---------- average |Δ speed| bucketed per crash ---------- */
JOIN (
  SELECT
    state_number,
    consecutive_number,
    CASE
      WHEN avg_diff < 20 THEN 0
      WHEN avg_diff < 40 THEN 1
      WHEN avg_diff < 60 THEN 2
      WHEN avg_diff < 80 THEN 3
      ELSE 4
    END AS speed_diff_bucket
  FROM (
    SELECT
      state_number,
      consecutive_number,
      AVG(ABS(travel_speed - speed_limit)) AS avg_diff
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
    WHERE travel_speed BETWEEN 0 AND 151        -- exclude 997/998/999
      AND speed_limit  BETWEEN 5 AND 80         -- exclude 98/99
    GROUP BY state_number, consecutive_number
  )
) AS sd
USING (state_number, consecutive_number)
/* ---------- crashes with >1 person & fatal counts ---------- */
JOIN (
  SELECT
    state_number,
    consecutive_number,
    COUNT(*)                       AS person_total,
    COUNTIF(injury_severity = 4)   AS fatal_count
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
  GROUP BY state_number, consecutive_number
  HAVING person_total > 1          -- enforce >1 distinct person
) AS pf
USING (state_number, consecutive_number)
LIMIT 20;
```
