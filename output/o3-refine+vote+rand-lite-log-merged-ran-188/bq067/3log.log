```sql
--Description: Final labeled dataset (one row per crash) with engineered features and label
SELECT
  a.state_number,
  v.body_type,
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
  CASE WHEN a.work_zone = 0 THEN 0 ELSE 1 END AS work_zone_indicator,
  sd.speed_diff_bucket,
  CASE WHEN pf.fatal_count > 1 THEN 1 ELSE 0 END AS label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` AS a
JOIN (
    -- Choose one body_type per crash (e.g., first/min)
    SELECT state_number, consecutive_number, MIN(body_type) AS body_type
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
    GROUP BY state_number, consecutive_number
) AS v
USING (state_number, consecutive_number)
JOIN (
    -- Average speed-difference bucket
    SELECT
      state_number,
      consecutive_number,
      CASE
        WHEN avg_diff < 20 THEN 0
        WHEN avg_diff < 40 THEN 1
        WHEN avg_diff < 60 THEN 2
        WHEN avg_diff < 80 THEN 3
        ELSE 4
      END AS speed_diff_bucket
    FROM (
      SELECT
        state_number,
        consecutive_number,
        AVG(ABS(travel_speed - speed_limit)) AS avg_diff
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
      WHERE travel_speed BETWEEN 0 AND 151
        AND speed_limit BETWEEN 5 AND 80
      GROUP BY state_number, consecutive_number
    )
) AS sd
USING (state_number, consecutive_number)
JOIN (
    -- Filter to crashes with >1 person and capture fatal counts
    SELECT
      state_number,
      consecutive_number,
      COUNT(*)                         AS person_total,
      COUNTIF(injury_severity = 4)     AS fatal_count
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
    GROUP BY state_number, consecutive_number
    HAVING person_total > 1
) AS pf
USING (state_number, consecutive_number)
LIMIT 20;
```
