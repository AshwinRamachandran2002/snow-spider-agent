```sql
--Description: 
-- Build the labelled dataset (target = 1 if >1 fatality, else 0) for accidents that involve >1 person.
-- Fixes applied relative to earlier version:
--   • work_zone is STRING, so compare to the literal 'None' (or NULL) instead of numeric 0.
--   • Put the CASE expression directly in GROUP BY instead of using its alias.
--   • Keep engineered speed-difference feature & representative body_type.
-- Steps:
--   1) speed_feature  – average |travel_speed-speed_limit| per crash, bucketed (0–4).
--   2) accident-level join with person_2016 and vehicle_2016.
--   3) label = 1 when fatal_persons >1; keep crashes with >1 distinct people.
--   LIMIT 20 for a quick look.
WITH speed_feature AS (
  SELECT
    v.state_number,
    v.consecutive_number,
    CASE
      WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 20 THEN 0
      WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 40 THEN 1
      WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 60 THEN 2
      WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 80 THEN 3
      ELSE 4
    END AS speed_diff_level
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016` v
  WHERE v.travel_speed BETWEEN 0 AND 151   -- exclude 997/998/999
    AND v.speed_limit  BETWEEN 5 AND 80    -- exclude 0/98/99
  GROUP BY v.state_number, v.consecutive_number
)
SELECT
  a.state_number,
  a.consecutive_number,
  ANY_VALUE(v.body_type)                                  AS body_type,        -- one body_type per crash
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
  CASE WHEN a.work_zone = 'None' OR a.work_zone IS NULL THEN 0 ELSE 1 END AS work_zone_ind,
  s.speed_diff_level,
  CASE WHEN SUM(CASE WHEN p.injury_severity = 4 THEN 1 ELSE 0 END) > 1 THEN 1 ELSE 0 END AS label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`  a
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`    p
  ON a.state_number = p.state_number
 AND a.consecutive_number = p.consecutive_number
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`   v
  ON a.state_number = v.state_number
 AND a.consecutive_number = v.consecutive_number
JOIN speed_feature s
  ON a.state_number = s.state_number
 AND a.consecutive_number = s.consecutive_number
GROUP BY
  a.state_number,
  a.consecutive_number,
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
  work_zone_ind,
  s.speed_diff_level
HAVING COUNT(DISTINCT p.person_number) > 1
LIMIT 20;
```
