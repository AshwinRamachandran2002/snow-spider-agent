```sql
--Description: 
-- Build the labelled learning set in one query.  Steps (inside CTEs):
--  1. speed_feature   – engineered average |travel_speed-speed_limit| bucketed into 20-mph levels (0-4),
--                       using only valid codes (travel_speed 0–151, speed_limit 5–80).
--  2. person_agg      – for every crash count distinct persons and how many of them were fatally injured;
--                       keep those crashes with >1 person and produce label = 1 if fatal_persons >1 else 0.
--  3. vehicle_sample  – choose one representative body_type per crash (ANY_VALUE) just to have a vehicle-level predictor.
--  4. Final SELECT    – join accident_2016 with the three CTEs and create predictors:
--        • state_number
--        • body_type
--        • number_of_drunk_drivers
--        • day_of_week
--        • hour_of_crash
--        • work_zone_ind  (0 when work_zone = 'None' or NULL, 1 otherwise)
--        • speed_diff_level (engineered feature)
--        • label  (target: 1 = >1 fatality, 0 otherwise)
--  LIMIT 20 just to inspect sample rows.
WITH speed_feature AS (
  SELECT
    v.state_number,
    v.consecutive_number,
    CASE
      WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 20 THEN 0
      WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 40 THEN 1
      WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 60 THEN 2
      WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 80 THEN 3
      ELSE 4
    END AS speed_diff_level
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016` v
  WHERE v.travel_speed BETWEEN 0 AND 151   -- drop 997/998/999
    AND v.speed_limit  BETWEEN 5 AND 80    -- drop 0/98/99
  GROUP BY v.state_number, v.consecutive_number
),
person_agg AS (
  SELECT
    p.state_number,
    p.consecutive_number,
    COUNT(DISTINCT p.person_number)                                   AS persons_in_crash,
    SUM(CASE WHEN p.injury_severity = 4 THEN 1 ELSE 0 END)           AS fatal_persons,
    CASE
      WHEN SUM(CASE WHEN p.injury_severity = 4 THEN 1 ELSE 0 END) > 1 THEN 1
      ELSE 0
    END AS label
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016` p
  GROUP BY p.state_number, p.consecutive_number
  HAVING persons_in_crash > 1
),
vehicle_sample AS (
  SELECT
    state_number,
    consecutive_number,
    ANY_VALUE(body_type) AS body_type             -- representative body_type per crash
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
  GROUP BY state_number, consecutive_number
)
SELECT
  a.state_number,
  a.consecutive_number,
  vs.body_type,
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
  CASE
    WHEN a.work_zone = 'None' OR a.work_zone IS NULL THEN 0
    ELSE 1
  END AS work_zone_ind,
  sf.speed_diff_level,
  pa.label
FROM person_agg             pa
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` a
  ON a.state_number = pa.state_number
 AND a.consecutive_number = pa.consecutive_number
JOIN vehicle_sample          vs
  ON vs.state_number = pa.state_number
 AND vs.consecutive_number = pa.consecutive_number
JOIN speed_feature           sf
  ON sf.state_number = pa.state_number
 AND sf.consecutive_number = pa.consecutive_number
LIMIT 20;
```
