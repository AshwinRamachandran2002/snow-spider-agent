Query:
--Description: Count the number of distinct persons involved in each crash and keep only those crashes with more than one person
SELECT 
  p.state_number,
  p.consecutive_number,
  COUNT(DISTINCT p.person_number) AS persons_in_crash
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016` AS p
GROUP BY  p.state_number, p.consecutive_number
HAVING  COUNT(DISTINCT p.person_number) > 1
LIMIT 20;
