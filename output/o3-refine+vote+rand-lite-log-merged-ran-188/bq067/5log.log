```sql
--Description: Count the number of distinct persons involved in each crash and keep only those crashes with more than one person
SELECT 
  p.state_number,
  p.consecutive_number,
  COUNT(DISTINCT p.person_number) AS persons_in_crash
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016` AS p
GROUP BY  p.state_number, p.consecutive_number
HAVING  COUNT(DISTINCT p.person_number) > 1
LIMIT 20;
```

```sql
--Description: Determine, for crashes involving >1 person, how many have more than one fatal injury (injury_severity = 4)
SELECT
  p.state_number,
  p.consecutive_number,
  SUM(CASE WHEN p.injury_severity = 4 THEN 1 ELSE 0 END) AS fatal_persons,
  COUNT(DISTINCT p.person_number)                          AS persons_in_crash
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016` AS p
GROUP BY p.state_number, p.consecutive_number
HAVING COUNT(DISTINCT p.person_number) > 1
ORDER BY fatal_persons DESC
LIMIT 20;
```

```sql
--Description: Compute the per-vehicle absolute speed difference (|travel_speed – speed_limit|) keeping only valid coded values
SELECT
  v.state_number,
  v.consecutive_number,
  v.travel_speed,
  v.speed_limit,
  ABS(v.travel_speed - v.speed_limit) AS abs_speed_diff
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016` AS v
WHERE v.travel_speed BETWEEN 0 AND 151            -- drop 997/998/999
  AND v.speed_limit BETWEEN 5 AND 80              -- drop 0/98/99, keep statutory mph limits
LIMIT 20;
```

```sql
--Description: For every crash, calculate the average speed difference (valid vehicles only) and bucket it into 20-mph levels (0-4)
SELECT
  v.state_number,
  v.consecutive_number,
  AVG(ABS(v.travel_speed - v.speed_limit)) AS avg_abs_speed_diff,
  CASE
    WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 20 THEN 0
    WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 40 THEN 1
    WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 60 THEN 2
    WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 80 THEN 3
    ELSE 4
  END AS speed_diff_level
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016` AS v
WHERE v.travel_speed BETWEEN 0 AND 151
  AND v.speed_limit BETWEEN 5 AND 80
GROUP BY v.state_number, v.consecutive_number
LIMIT 20;
```

```sql
--Description: Assemble accident-level predictors together with the engineered speed-difference feature
SELECT
  a.state_number,
  a.consecutive_number,
  a.day_of_week,
  a.hour_of_crash,
  a.number_of_drunk_drivers,
  CASE WHEN a.work_zone = 0 THEN 0 ELSE 1 END AS work_zone_ind,
  s.speed_diff_level
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` AS a
JOIN (
    SELECT
      v.state_number,
      v.consecutive_number,
      CASE
        WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 20 THEN 0
        WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 40 THEN 1
        WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 60 THEN 2
        WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 80 THEN 3
        ELSE 4
      END AS speed_diff_level
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016` AS v
    WHERE v.travel_speed BETWEEN 0 AND 151
      AND v.speed_limit BETWEEN 5 AND 80
    GROUP BY v.state_number, v.consecutive_number
) AS s
  ON a.state_number = s.state_number
 AND a.consecutive_number = s.consecutive_number
LIMIT 20;
```

```sql
--Description: Produce the labeled data set: 1 = >1 fatal persons, 0 otherwise, restricted to crashes with >1 person
SELECT
  a.state_number,
  a.consecutive_number,
  a.day_of_week,
  a.hour_of_crash,
  a.number_of_drunk_drivers,
  CASE WHEN a.work_zone = 0 THEN 0 ELSE 1 END          AS work_zone_ind,
  ANY_VALUE(v.body_type)                                AS body_type,            -- pick one body_type per crash (e.g., first)
  s.speed_diff_level,
  CASE WHEN SUM(CASE WHEN p.injury_severity = 4 THEN 1 END) > 1 THEN 1 ELSE 0 END AS label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` AS a

JOIN `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`   AS p
  ON a.state_number = p.state_number
 AND a.consecutive_number = p.consecutive_number

JOIN `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`  AS v
  ON a.state_number = v.state_number
 AND a.consecutive_number = v.consecutive_number

JOIN (
    SELECT
      v.state_number,
      v.consecutive_number,
      CASE
        WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 20 THEN 0
        WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 40 THEN 1
        WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 60 THEN 2
        WHEN AVG(ABS(v.travel_speed - v.speed_limit)) < 80 THEN 3
        ELSE 4
      END AS speed_diff_level
    FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016` AS v
    WHERE v.travel_speed BETWEEN 0 AND 151
      AND v.speed_limit BETWEEN 5 AND 80
    GROUP BY v.state_number, v.consecutive_number
) AS s
  ON a.state_number = s.state_number
 AND a.consecutive_number = s.consecutive_number

GROUP BY
  a.state_number,
  a.consecutive_number,
  a.day_of_week,
  a.hour_of_crash,
  a.number_of_drunk_drivers,
  work_zone_ind,
  s.speed_diff_level
HAVING COUNT(DISTINCT p.person_number) > 1
LIMIT 20;
```
