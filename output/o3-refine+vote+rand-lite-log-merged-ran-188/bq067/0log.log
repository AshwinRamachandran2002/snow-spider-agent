--Description / Thinking process:
-- We need a one-row-per-accident table with the predictors + label.
-- 1. accident_2016 supplies: state_number, number_of_drunk_drivers, day_of_week, hour_of_crash,
--    and work_zone (turned into a binary flag: 1 = not “None”).
-- 2. vehicle_2016 is aggregated by (state_number, consecutive_number) to obtain
--      • avg_speed_diff = AVG(|travel_speed – speed_limit|) using only rows whose
--        travel_speed ∈ [0,151] and speed_limit ∈ [5,80] (valid numeric codes);
--      • ANY_VALUE(body_type) as a representative body type.
-- 3. person_2016 is aggregated by the same keys to get
--      • total_persons          (distinct person_number count)
--      • fatal_persons          (COUNTIF injury_severity = 4).
-- 4. Keep only accidents where total_persons > 1.
-- 5. Bucket avg_speed_diff into 20-mph bands → speed_diff_level 0–4.
-- 6. Label = 1 if fatal_persons > 1 else 0.
-- 7. LIMIT 20 just to preview.
SELECT
  a.state_number,
  v.body_type,
  a.number_of_drunk_drivers,
  a.day_of_week,
  a.hour_of_crash,
  CASE WHEN a.work_zone = 'None' THEN 0 ELSE 1 END                                    AS in_work_zone,
  CASE
    WHEN v.avg_speed_diff < 20 THEN 0
    WHEN v.avg_speed_diff < 40 THEN 1
    WHEN v.avg_speed_diff < 60 THEN 2
    WHEN v.avg_speed_diff < 80 THEN 3
    ELSE 4
  END                                                                                 AS speed_diff_level,
  CASE WHEN p.fatal_persons > 1 THEN 1 ELSE 0 END                                     AS label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` AS a
JOIN (
      SELECT
        state_number,
        consecutive_number,
        AVG(ABS(travel_speed - speed_limit)) AS avg_speed_diff,
        ANY_VALUE(body_type)                 AS body_type
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016`
      WHERE travel_speed BETWEEN 0 AND 151
        AND speed_limit   BETWEEN 5 AND 80
      GROUP BY state_number, consecutive_number
     ) AS v
  ON a.state_number       = v.state_number
 AND a.consecutive_number = v.consecutive_number
JOIN (
      SELECT
        state_number,
        consecutive_number,
        COUNT(DISTINCT person_number)     AS total_persons,
        COUNTIF(injury_severity = 4)      AS fatal_persons
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016`
      GROUP BY state_number, consecutive_number
     ) AS p
  ON a.state_number       = p.state_number
 AND a.consecutive_number = p.consecutive_number
WHERE p.total_persons > 1
LIMIT 20;
