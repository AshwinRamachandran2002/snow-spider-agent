```sql
--Description: Compute the per-accident average absolute speed-difference (valid speeds & limits only).
SELECT v.`state_number`,
       v.`consecutive_number`,
       AVG(ABS(v.`travel_speed` - v.`speed_limit`)) AS avg_speed_diff
FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016` AS v
WHERE v.`travel_speed` BETWEEN 0 AND 151
  AND v.`speed_limit`  BETWEEN 5 AND 80
GROUP BY v.`state_number`, v.`consecutive_number`
LIMIT 20;
```

```sql
--Description: Bucket that average speed difference into 20-mph bands (0-19, 20-39, … 80+ treated as level 4).
SELECT *,
       CASE
         WHEN avg_speed_diff < 20  THEN 0
         WHEN avg_speed_diff < 40  THEN 1
         WHEN avg_speed_diff < 60  THEN 2
         WHEN avg_speed_diff < 80  THEN 3
         ELSE 4
       END AS speed_diff_level
FROM (
      SELECT v.`state_number`,
             v.`consecutive_number`,
             AVG(ABS(v.`travel_speed` - v.`speed_limit`)) AS avg_speed_diff
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016` AS v
      WHERE v.`travel_speed` BETWEEN 0 AND 151
        AND v.`speed_limit`  BETWEEN 5 AND 80
      GROUP BY v.`state_number`, v.`consecutive_number`
     )
LIMIT 20;
```

```sql
--Description: Assemble a labeled analytic dataset (one row per accident) with all requested predictors and the binary label.
SELECT
  a.`state_number`,
  FIRST_VALUE(v.`body_type`)          OVER (PARTITION BY a.`state_number`, a.`consecutive_number`) AS body_type,
  a.`number_of_drunk_drivers`,
  a.`day_of_week`,
  a.`hour_of_crash`,
  CASE WHEN a.`work_zone` = 0 THEN 0 ELSE 1 END AS in_work_zone,
  CASE
    WHEN avg_speed_diff < 20  THEN 0
    WHEN avg_speed_diff < 40  THEN 1
    WHEN avg_speed_diff < 60  THEN 2
    WHEN avg_speed_diff < 80  THEN 3
    ELSE 4
  END AS speed_diff_level,
  CASE WHEN fatal_persons > 1 THEN 1 ELSE 0 END AS label
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` AS a
JOIN (
      SELECT v.`state_number`,
             v.`consecutive_number`,
             AVG(ABS(v.`travel_speed` - v.`speed_limit`)) AS avg_speed_diff,
             ANY_VALUE(v.`body_type`) AS body_type
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.vehicle_2016` AS v
      WHERE v.`travel_speed` BETWEEN 0 AND 151
        AND v.`speed_limit`  BETWEEN 5 AND 80
      GROUP BY v.`state_number`, v.`consecutive_number`
     ) AS v
  ON a.`state_number`      = v.`state_number`
 AND a.`consecutive_number`= v.`consecutive_number`
JOIN (
      SELECT p.`state_number`,
             p.`consecutive_number`,
             COUNT(DISTINCT p.`person_number`)                           AS total_persons,
             COUNTIF(p.`injury_severity` = 4)                            AS fatal_persons
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2016` AS p
      GROUP BY p.`state_number`, p.`consecutive_number`
     ) AS p
  ON a.`state_number`      = p.`state_number`
 AND a.`consecutive_number`= p.`consecutive_number`
WHERE p.total_persons > 1                          -- only accidents involving >1 person
LIMIT 20;
```
