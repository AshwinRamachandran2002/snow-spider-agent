-- Description: Cross-reference raw LOGS with decoded events for block 29815485 where the
--              first topic equals the DepositFinalized hash, using FLATTEN to identify the
--              relevant decoded rows.
WITH matched AS (
  SELECT
    e.TRANSACTION_HASH,
    e.LOG_INDEX,
    e.BLOCK_NUMBER,
    e.ARGS
  FROM
    GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS e,
    LATERAL FLATTEN (input => e.TOPICS) f
  WHERE
    e.BLOCK_NUMBER = 29815485
    AND f.SEQ = 0
    AND LOWER(f.VALUE::STRING) = '0x3303facd24627943a92e9dc87cfbb34b15c49b726eec3ad3487c16be9ab8efe8'
)
SELECT
  m.TRANSACTION_HASH,
  m.LOG_INDEX,
  m.BLOCK_NUMBER,
  l.DATA,
  m.ARGS
FROM
  matched m
JOIN
  GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS l
    ON m.TRANSACTION_HASH = l.TRANSACTION_HASH
LIMIT 20;
```
