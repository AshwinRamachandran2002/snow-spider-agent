    FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
    WHERE EVENT_SIGNATURE ILIKE '%Deposit%'
) d
ON l.TRANSACTION_HASH = d.TRANSACTION_HASH
LIMIT 20;
