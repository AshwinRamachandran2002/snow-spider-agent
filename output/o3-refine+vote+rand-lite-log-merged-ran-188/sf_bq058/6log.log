WITH ev AS (
    SELECT
        "TRANSACTION_HASH",
        PARSE_JSON("ARGS") AS a
    FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS"
    WHERE "BLOCK_NUMBER" = 29815485
      AND (
           "EVENT_HASH"      = '0x3303facd24627943a92e9dc87cfbb34b15c49b726eec3ad3487c16be9ab8efe8'
        OR "EVENT_SIGNATURE" ILIKE 'DepositFinalized%'
      )
)
SELECT
    "TRANSACTION_HASH"                                                     AS "transaction_hash",
    CONCAT('https://optimistic.etherscan.io/tx/', "TRANSACTION_HASH")       AS "etherscan_link",
    REGEXP_REPLACE(LOWER(a[0]::STRING), '^0x0*', '')                        AS "l1_token",
    REGEXP_REPLACE(LOWER(a[1]::STRING), '^0x0*', '')                        AS "l2_token",
    REGEXP_REPLACE(LOWER(a[2]::STRING), '^0x0*', '')                        AS "sender",
    REGEXP_REPLACE(LOWER(a[3]::STRING), '^0x0*', '')                        AS "receiver",
    CASE
        WHEN REGEXP_LIKE(a[4]::STRING, '^0x')
        THEN TO_NUMBER(SUBSTR(a[4]::STRING, 3), 16)
        ELSE a[4]::NUMBER
    END                                                                     AS "amount"
FROM ev
ORDER BY "transaction_hash";
