SELECT
    "TRANSACTION_HASH"                                                            AS "transaction_hash",
    CONCAT('https://optimistic.etherscan.io/tx/', "TRANSACTION_HASH")             AS "etherscan_link",
    REGEXP_REPLACE(LOWER(jargs[0]::STRING), '^0x0*', '')                          AS "l1_token",
