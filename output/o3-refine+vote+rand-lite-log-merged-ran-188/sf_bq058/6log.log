```

```sql
--Description: List unique contract addresses that emitted at least one decoded deposit-related event.
SELECT DISTINCT ADDRESS
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE EVENT_SIGNATURE ILIKE '%Deposit%'
LIMIT 20;
