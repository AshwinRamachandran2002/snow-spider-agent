```sql
--Description: First session (timestamp & length) for each visitor in the whole period.
SELECT
  fullVisitorId,
  first_session.visitStartTime AS first_visit_ts,
  first_session.timeOnSite   AS first_visit_timeOnSite
FROM (
  SELECT
    fullVisitorId,
    ARRAY_AGG(STRUCT(visitStartTime, totals.timeOnSite)
              ORDER BY visitStartTime ASC LIMIT 1)[OFFSET(0)] AS first_session
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
  GROUP BY fullVisitorId
)
WHERE first_session.timeOnSite > 300
LIMIT 20;
```

```sql
--Description: All sessions in the period that contain a purchase.
SELECT
  fullVisitorId,
  visitStartTime,
  totals.transactions,
  totals.transactionRevenue
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
  AND (totals.transactions IS NOT NULL OR totals.transactionRevenue IS NOT NULL)
LIMIT 20;
```

```sql
--Description: Visitors whose first session (>5 min) and ANY later session had a purchase.
WITH first_session AS (
  SELECT
    fullVisitorId,
    ARRAY_AGG(STRUCT(visitStartTime, totals.timeOnSite)
              ORDER BY visitStartTime ASC LIMIT 1)[OFFSET(0)] AS first
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
  GROUP BY fullVisitorId
),
purchasing_sessions AS (
  SELECT DISTINCT fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
    AND (totals.transactions IS NOT NULL OR totals.transactionRevenue IS NOT NULL)
)
SELECT
  fs.fullVisitorId,
  fs.first.timeOnSite AS initial_timeOnSite
FROM first_session fs
JOIN purchasing_sessions ps
ON fs.fullVisitorId = ps.fullVisitorId
WHERE fs.first.timeOnSite > 300
LIMIT 20;
```

```sql
--Description: Total count of NEW users (first-time visitors) in the period.
SELECT
  COUNT(DISTINCT fullVisitorId) AS total_new_users
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
  AND totals.newVisits = 1;
```

```sql
--Description: Count of visitors whose first session >5 min AND a later purchase.
WITH first_session AS (
  SELECT
    fullVisitorId,
    ARRAY_AGG(STRUCT(visitStartTime, totals.timeOnSite)
              ORDER BY visitStartTime ASC LIMIT 1)[OFFSET(0)] AS first
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
  GROUP BY fullVisitorId
),
purchasing_sessions AS (
  SELECT DISTINCT fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
    AND (totals.transactions IS NOT NULL OR totals.transactionRevenue IS NOT NULL)
)
SELECT
  COUNT(*) AS qualifying_users
FROM first_session fs
JOIN purchasing_sessions ps
ON fs.fullVisitorId = ps.fullVisitorId
WHERE fs.first.timeOnSite > 300;
```

```sql
--Description: Final percentage of qualifying users over all new users (single-row result).
WITH first_session AS (
  SELECT
    fullVisitorId,
    ARRAY_AGG(STRUCT(visitStartTime, totals.timeOnSite, totals.newVisits)
              ORDER BY visitStartTime ASC LIMIT 1)[OFFSET(0)] AS first
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
  GROUP BY fullVisitorId
),
qualifying_users AS (
  SELECT
    fs.fullVisitorId
  FROM first_session fs
  JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS later
  ON fs.fullVisitorId = later.fullVisitorId
  WHERE later.visitStartTime > fs.first.visitStartTime
    AND (later.totals.transactions IS NOT NULL OR later.totals.transactionRevenue IS NOT NULL)
    AND fs.first.timeOnSite > 300
),
total_new_users AS (
  SELECT DISTINCT fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
    AND totals.newVisits = 1
)
SELECT
  100.0 * COUNT(DISTINCT q.fullVisitorId) / COUNT(DISTINCT t.fullVisitorId) AS pct_qualifying_new_users
FROM total_new_users t
LEFT JOIN qualifying_users q
ON t.fullVisitorId = q.fullVisitorId
LIMIT 20;
```
