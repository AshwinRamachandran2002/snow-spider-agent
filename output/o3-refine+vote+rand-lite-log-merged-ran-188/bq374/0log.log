Query:
--Description: 2) Check how much time new users spend on-site in their initial visit
--(totals.timeOnSite is in seconds).
SELECT
  fullVisitorId ,
  totals.timeOnSite                     AS seconds_on_site
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
  AND totals.newVisits = 1
  AND totals.timeOnSite IS NOT NULL
ORDER BY seconds_on_site DESC
LIMIT 20;
