Query:
--Description: 9) Count NEW users whose first session lasted >5 min AND who later
--made at least one purchase (numerator).  Uses ROW_NUMBER() and fully qualified
--transactions field to avoid previous errors.
WITH first_sessions AS (
  SELECT *
  FROM (
    SELECT
      fullVisitorId,
      visitStartTime                     AS first_ts,
      totals.timeOnSite                  AS first_time_on_site,
      ROW_NUMBER() OVER (PARTITION BY fullVisitorId
                         ORDER BY visitStartTime) AS rn
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
    WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
      AND totals.newVisits = 1
  )
  WHERE rn = 1
),
qualified_first AS (
  SELECT fullVisitorId, first_ts
  FROM first_sessions
  WHERE first_time_on_site > 300
),
later_buys AS (
  SELECT DISTINCT s.fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s
  JOIN qualified_first AS q
    ON s.fullVisitorId = q.fullVisitorId
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
    AND s.visitStartTime > q.first_ts
    AND s.totals.transactions IS NOT NULL
    AND s.totals.transactions > 0
)
SELECT COUNT(DISTINCT fullVisitorId) AS qualified_buyer_users
FROM later_buys
LIMIT 20
