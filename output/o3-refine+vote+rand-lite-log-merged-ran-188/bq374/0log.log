Query:
--Description: 7) Confirm that the purchase actually occurred AFTER the visitor’s
--first session (compare visitStartTime values).  Re-implemented with ROW_NUMBER()
--to avoid Oracle-only KEEP syntax and fully qualify totals.transactions.
WITH first_visit AS (
  SELECT
    fullVisitorId,
    visitStartTime               AS first_vst_ts
  FROM (
    SELECT
      fullVisitorId,
      visitStartTime,
      ROW_NUMBER() OVER (PARTITION BY fullVisitorId
                         ORDER BY visitStartTime) AS rn
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
    WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
      AND totals.newVisits = 1
  )
  WHERE rn = 1
),
later_purchases AS (
  SELECT DISTINCT s.fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s
  JOIN first_visit  AS f USING (fullVisitorId)
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
    AND s.visitStartTime > f.first_vst_ts      -- later than initial visit
    AND s.totals.transactions IS NOT NULL
    AND s.totals.transactions > 0
)
SELECT *
FROM later_purchases
LIMIT 20
