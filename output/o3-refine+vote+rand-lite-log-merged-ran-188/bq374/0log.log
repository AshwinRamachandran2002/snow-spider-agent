Query:
--Description: 1) Sample the daily session tables (2016-08-01 → 2017-04-30) to see
--new-users’ first sessions (totals.newVisits = 1).
SELECT DISTINCT
  _TABLE_SUFFIX   AS session_day ,
  fullVisitorId ,
  visitNumber ,
  totals.newVisits
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
  AND totals.newVisits = 1
LIMIT 20;
