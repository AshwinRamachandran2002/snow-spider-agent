--Description: 10) Final percentage of new users whose first visit (>5 min) was
--followed by a purchase on a later visit.  Rewritten with ROW_NUMBER() instead of
--KEEP syntax and fully qualified transactions field.
WITH denominator AS (      -- all new users’ first sessions
  SELECT DISTINCT fullVisitorId
  FROM (
    SELECT
      fullVisitorId,
      ROW_NUMBER() OVER (PARTITION BY fullVisitorId ORDER BY visitStartTime) AS rn
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
    WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
      AND totals.newVisits = 1
  )
  WHERE rn = 1
),
first_sessions AS (
  SELECT
    d.fullVisitorId,
    fs.visitStartTime           AS first_ts,
    fs.totals.timeOnSite        AS first_time_on_site
  FROM denominator AS d
  JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS fs
    ON d.fullVisitorId = fs.fullVisitorId
  WHERE fs.totals.newVisits = 1
    AND _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
),
long_first_visit AS (
  SELECT fullVisitorId, first_ts
  FROM first_sessions
  WHERE first_time_on_site > 300
),
later_purchase AS (
  SELECT DISTINCT s.fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s
  JOIN long_first_visit AS l
    ON s.fullVisitorId = l.fullVisitorId
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
    AND s.visitStartTime > l.first_ts
    AND s.totals.transactions IS NOT NULL
    AND s.totals.transactions > 0
)
SELECT
  100 * COUNT(DISTINCT later_purchase.fullVisitorId) /
        COUNT(DISTINCT denominator.fullVisitorId) AS pct_new_users_longstay_buy
FROM denominator
LEFT JOIN later_purchase USING (fullVisitorId)
LIMIT 20;
