Query:
--Description: 5) For a given purchaser, inspect the full timeline to confirm
--that buying can happen on a visitNumber > 1.
WITH any_buyer AS (
  SELECT DISTINCT fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
    AND totals.transactions >= 1
  LIMIT 1
)
SELECT
  date ,
  visitNumber ,
  totals.timeOnSite ,
  totals.transactions
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
  AND fullVisitorId IN (SELECT fullVisitorId FROM any_buyer)
ORDER BY visitNumber
LIMIT 20;
