Query:
--Description: 3) List those first-time sessions that already last > 5 minutes
--(300 seconds) – they form our candidate numerator base.
SELECT
  fullVisitorId ,
  totals.timeOnSite                     AS seconds_on_site ,
  date
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
  AND totals.newVisits = 1
  AND totals.timeOnSite > 300
LIMIT 20;
