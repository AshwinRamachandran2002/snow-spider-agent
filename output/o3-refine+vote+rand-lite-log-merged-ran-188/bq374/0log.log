```sql
--Description:  Single-query solution that delivers the requested percentage.
--Logic flow:
-- 1. sessions         – every session (1-Aug-2016 → 30-Apr-2017) with fields we need.
-- 2. first_sessions   – each visitor’s very first session in that window
--                       (totals.newVisits = 1, ROW_NUMBER = 1).
-- 3. numerator_users  – among users whose first session lasted > 5 minutes
--                       (timeOnSite > 300 s), find those who later (visitStartTime >
--                       first_ts) completed a transaction (transactions > 0).
-- 4. denominator_users– all new users (first_sessions) in the window.
-- 5. Final SELECT     – counts & percentage (numerator / denominator * 100).
WITH sessions AS (
  SELECT
    fullVisitorId,
    visitStartTime,
    totals.timeOnSite      AS time_on_site,
    totals.newVisits       AS is_new_visit,
    totals.transactions    AS transactions
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
),
first_sessions AS (
  SELECT
    fullVisitorId,
    visitStartTime               AS first_ts,
    time_on_site
  FROM (
    SELECT
      fullVisitorId,
      visitStartTime,
      time_on_site,
      ROW_NUMBER() OVER (PARTITION BY fullVisitorId
                         ORDER BY visitStartTime) AS rn
    FROM sessions
    WHERE is_new_visit = 1                         -- ensure initial visit
  )
  WHERE rn = 1                                     -- keep earliest only
),
numerator_users AS (                               -- long-stayers who purchased later
  SELECT DISTINCT s.fullVisitorId
  FROM sessions        AS s
  JOIN first_sessions  AS f
    ON s.fullVisitorId = f.fullVisitorId
  WHERE f.time_on_site > 300                       -- first session >5 min
    AND s.visitStartTime > f.first_ts              -- later sessions only
    AND s.transactions IS NOT NULL
    AND s.transactions > 0                         -- at least one purchase
),
denominator_users AS (                             -- all new users
  SELECT DISTINCT fullVisitorId
  FROM first_sessions
)
SELECT
  (SELECT COUNT(*) FROM numerator_users)                AS users_longstay_bought,
  (SELECT COUNT(*) FROM denominator_users)              AS total_new_users,
  ROUND(
    100 * (SELECT COUNT(*) FROM numerator_users)
        / (SELECT COUNT(*) FROM denominator_users)
  , 4)                                                  AS pct_longstay_buyers;
```
