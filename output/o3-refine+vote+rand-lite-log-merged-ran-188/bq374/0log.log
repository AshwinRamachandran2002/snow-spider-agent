```sql
--Description: 9) Count those new users whose first session lasted >5 min AND
--who later bought anything.  (Numerator.)
WITH first_sessions AS (
  SELECT
    fullVisitorId ,
    MIN(visitStartTime)                                              AS first_ts ,
    ANY_VALUE(totals.timeOnSite) KEEP (DENSE_RANK FIRST ORDER BY visitStartTime) AS first_timeOnSite
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
  GROUP BY fullVisitorId
),
qualified_first AS (
  SELECT *
  FROM first_sessions
  WHERE first_timeOnSite > 300
),
later_buys AS (
  SELECT DISTINCT
    s.fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s
  JOIN qualified_first                                              AS q
    ON s.fullVisitorId = q.fullVisitorId
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
    AND s.visitStartTime > q.first_ts
    AND s.totals.transactions >= 1
)
SELECT COUNT(DISTINCT fullVisitorId) AS qualified_buyer_users
FROM later_buys
LIMIT 20;
