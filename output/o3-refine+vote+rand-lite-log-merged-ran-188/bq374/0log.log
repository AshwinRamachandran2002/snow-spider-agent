```sql
--Description:  One-shot computation of the percentage of NEW users whose first
--session occurred between 1-Aug-2016 and 30-Apr-2017, lasted more than five
--minutes (>300 s), and who completed a purchase on any *later* visit (up to the
--end of the demo data set).  The steps are expressed as CTEs:
--  • first_visits        – each visitor’s earliest session in the window
--  • denominator         – total # of such new users
--  • long_first_visits   – keep only those whose first visit >5 min
--  • later_purchasers    – same visitors who made a transaction after that first visit
--  • numerator           – count of qualified users
--  • final SELECT        – percentage = numerator / denominator
WITH first_visits AS (
  SELECT
    fullVisitorId,
    visitStartTime                       AS first_ts,
    totals.timeOnSite                    AS first_time_on_site
  FROM (
    SELECT
      fullVisitorId,
      visitStartTime,
      totals.timeOnSite,
      ROW_NUMBER() OVER (PARTITION BY fullVisitorId
                         ORDER BY visitStartTime) AS rn
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
    WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'       -- window for new users
      AND totals.newVisits = 1                                  -- marks initial visit
  )
  WHERE rn = 1                                                  -- keep earliest only
),
denominator AS (
  SELECT COUNT(DISTINCT fullVisitorId) AS total_new_users
  FROM first_visits
),
long_first_visits AS (
  SELECT fullVisitorId, first_ts
  FROM first_visits
  WHERE first_time_on_site > 300                                -- stayed >5 minutes
),
later_purchasers AS (
  SELECT DISTINCT s.fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s
  JOIN long_first_visits                                          AS l
    ON s.fullVisitorId = l.fullVisitorId
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170801'           -- full data horizon
    AND s.visitStartTime > l.first_ts                             -- later than first visit
    AND s.totals.transactions >= 1                                -- purchase occurred
),
numerator AS (
  SELECT COUNT(DISTINCT fullVisitorId) AS qualified_users
  FROM later_purchasers
)
SELECT
  qualified_users,
  total_new_users,
  ROUND(100 * qualified_users / total_new_users, 4) AS pct_new_users_longstay_purchase
FROM numerator, denominator;
```
