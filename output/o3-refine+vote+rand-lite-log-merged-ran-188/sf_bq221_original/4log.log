WITH RECURSIVE
/*------------------------------------------------------------
1. Map each publication to the LEVEL‑5 CPC group that the
   very first CPC code (cp.index = 0) belongs to.
------------------------------------------------------------*/
first_cpc AS (
    SELECT
        /* ------------------------- CPC GROUP (LEVEL‑5) */
        COALESCE(
            /* the code itself if it already is level‑5 … */
            CASE WHEN cd_child."level" = 5 THEN cd_child."symbol" END,
            /* … otherwise its first ancestor that is level‑5            */
            lvl5_parent."symbol"
        )                                                      AS "CPC_GROUP",
        /* filing year (YYYY)                                   */
        FLOOR(p."filing_date" / 10000)                         AS "FILING_YEAR"
    FROM PATENTS.PATENTS.PUBLICATIONS               p
         , LATERAL FLATTEN(input => p."cpc")         cp
         /* full CPC symbol of the first code ---------------------------*/
         JOIN PATENTS.PATENTS.CPC_DEFINITION cd_child
              ON cd_child."symbol" = UPPER(cp.value:"code"::string)
         /* find a level‑5 ancestor ------------------------------------*/
         LEFT JOIN LATERAL (
                 SELECT cd_parent."symbol"
                 FROM LATERAL FLATTEN(input => cd_child."parents") pr
                 JOIN PATENTS.PATENTS.CPC_DEFINITION cd_parent
                   ON cd_parent."symbol" = pr.value::string
                  AND cd_parent."level"  = 5
                 ORDER BY cd_parent."symbol"
                 LIMIT 1                       -- take the first hit
         ) lvl5_parent ON TRUE
    WHERE cp.index = 0                               -- first CPC code only
      AND p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
      AND p."application_number" IS NOT NULL
      AND TRIM(p."application_number") <> ''
      /* make sure the mapping succeeded */
      AND COALESCE(
              CASE WHEN cd_child."level" = 5 THEN cd_child."symbol" END,
              lvl5_parent."symbol"
          ) IS NOT NULL
),
/*------------------------------------------------------------
2. Annual filing counts per CPC group
------------------------------------------------------------*/
agg AS (
    SELECT
        "CPC_GROUP",
        "FILING_YEAR",
        COUNT(*) AS "FILINGS"
    FROM first_cpc
    GROUP BY "CPC_GROUP", "FILING_YEAR"
),
/*------------------------------------------------------------
3. Order years per CPC group to drive the recursive EMA
------------------------------------------------------------*/
ordered AS (
    SELECT
        "CPC_GROUP",
        "FILING_YEAR",
        "FILINGS",
        ROW_NUMBER() OVER (PARTITION BY "CPC_GROUP"
                           ORDER BY "FILING_YEAR") AS rn
    FROM agg
),
/*------------------------------------------------------------
4. Recursive exponential moving average (α = 0.2)
   EMA₁ = α·x₁
   EMAₙ = α·xₙ + (1‑α)·EMAₙ₋₁
------------------------------------------------------------*/
rec AS (
    /* anchor: earliest year for every CPC group */
    SELECT
        "CPC_GROUP",
        "FILING_YEAR",
        "FILINGS",
        "FILINGS" * 0.20              AS ema,
        rn
    FROM ordered
    WHERE rn = 1

    UNION ALL

    /* step */
    SELECT
        o."CPC_GROUP",
        o."FILING_YEAR",
        o."FILINGS",
        (o."FILINGS" * 0.20) + (r.ema * 0.80)  AS ema,
        o.rn
    FROM rec r
    JOIN ordered o
      ON o."CPC_GROUP" = r."CPC_GROUP"
     AND o.rn          = r.rn + 1
),
/*------------------------------------------------------------
5. Pick, for each CPC group, the filing year with the
   highest EMA value
------------------------------------------------------------*/
best_year AS (
    SELECT
        "CPC_GROUP",
        "FILING_YEAR"                                         AS "BEST_YEAR",
        ema                                                   AS "HIGHEST_EMA",
        ROW_NUMBER() OVER (PARTITION BY "CPC_GROUP"
                           ORDER BY ema DESC, "FILING_YEAR")  AS rk
    FROM rec
)
/*------------------------------------------------------------
6. Attach CPC full title (level‑5) and show the result
------------------------------------------------------------*/
SELECT
    b."CPC_GROUP",
    d."titleFull"      AS "CPC_TITLE",
    b."BEST_YEAR",
    b."HIGHEST_EMA"
FROM best_year b
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = b."CPC_GROUP"
 WHERE d."level" = 5
   AND b.rk = 1                       -- keep only best year per CPC
ORDER BY b."HIGHEST_EMA" DESC NULLS LAST,
         b."CPC_GROUP";
