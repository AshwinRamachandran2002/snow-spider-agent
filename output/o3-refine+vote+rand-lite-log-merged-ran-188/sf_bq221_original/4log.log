WITH RECURSIVE
/*----------------------------------------------------
1. Get the first CPC code for every publication that
   has a valid filing date and application number
----------------------------------------------------*/
first_cpc AS (
    SELECT
        /* roll‑up to CPC main‑group (level‑5) e.g. H04L9/00 */
        REGEXP_REPLACE(UPPER(cp.value:"code"::string), '/.*', '/00')               AS "CPC_GROUP",
        FLOOR(p."filing_date" / 10000)                                             AS "FILING_YEAR"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") cp
    WHERE cp.index = 0                                    -- only the first CPC code
      AND p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
      AND p."application_number" IS NOT NULL
      AND TRIM(p."application_number") <> ''
),
/*----------------------------------------------------
2. Annual filing counts per CPC level‑5 group
----------------------------------------------------*/
agg AS (
    SELECT
        "CPC_GROUP",
        "FILING_YEAR",
        COUNT(*) AS "FILINGS"
    FROM first_cpc
    GROUP BY "CPC_GROUP", "FILING_YEAR"
),
/*----------------------------------------------------
3. Attach an order column to drive the recursion
----------------------------------------------------*/
ordered AS (
    SELECT
        "CPC_GROUP",
        "FILING_YEAR",
        "FILINGS",
        ROW_NUMBER() OVER (PARTITION BY "CPC_GROUP"
                           ORDER BY "FILING_YEAR")        AS rn
    FROM agg
),
/*----------------------------------------------------
4. Recursive EMA (α = 0.2) calculation
   EMA₁ = α*x₁
   EMAₙ = α*xₙ + (1‑α)*EMAₙ₋₁
----------------------------------------------------*/
rec AS (
    /* anchor row (earliest year per CPC group) */
    SELECT
        "CPC_GROUP",
        "FILING_YEAR",
        "FILINGS",
        "FILINGS" * 0.20                                   AS ema,
        rn
    FROM ordered
    WHERE rn = 1

    UNION ALL

    /* recursive step */
    SELECT
        o."CPC_GROUP",
        o."FILING_YEAR",
        o."FILINGS",
        (o."FILINGS" * 0.20) + (r.ema * 0.80)             AS ema,
        o.rn
    FROM rec r
    JOIN ordered o
      ON o."CPC_GROUP" = r."CPC_GROUP"
     AND o.rn         = r.rn + 1
),
/*----------------------------------------------------
5. For each CPC group, keep the year with the
   highest EMA value
----------------------------------------------------*/
best_year AS (
    SELECT
        "CPC_GROUP",
        "FILING_YEAR"                                      AS "BEST_YEAR",
        ema,
        ROW_NUMBER() OVER (PARTITION BY "CPC_GROUP"
                           ORDER BY ema DESC, "FILING_YEAR") AS rk
    FROM rec
)
/*----------------------------------------------------
6. Attach CPC full title (level = 5) and present
----------------------------------------------------*/
SELECT
    b."CPC_GROUP",
    d."titleFull"            AS "CPC_TITLE",
    b."BEST_YEAR",
    b.ema                    AS "HIGHEST_EMA"
FROM best_year b
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = b."CPC_GROUP"
WHERE d."level" = 5
  AND b.rk = 1                       -- highest EMA per CPC group
ORDER BY b.ema DESC NULLS LAST,
         b."CPC_GROUP";
```
