/*======================================================================
Identify, for every CPC technology area (main‑group, i.e. the code
truncated to “…/00”), the calendar year in which its exponential
moving‑average (α = 0.20) of patent filings peaks.
======================================================================*/
WITH RECURSIVE
/*--------------------------------------------------------------------
1. Take the very first CPC code (cp.index = 0) of every publication
   that has a valid filing date and application number, then roll it
   up to its main‑group form “…/00”.
--------------------------------------------------------------------*/
first_cpc AS (
    SELECT
        /* main‑group, e.g. H04L9/00                                    */
        REGEXP_REPLACE(UPPER(cp.value:"code"::string), '/.*', '/00')    AS "CPC_GROUP",
        /* filing year (YYYY)                                           */
        FLOOR(p."filing_date" / 10000)                                  AS "FILING_YEAR"
    FROM PATENTS.PATENTS.PUBLICATIONS p
    /*--- unnest the CPC array ---------------------------------------*/
    JOIN LATERAL FLATTEN(input => p."cpc") cp
         ON cp.index = 0               /* keep only the first CPC code */
    WHERE p."filing_date"            IS NOT NULL
      AND p."filing_date"            > 0
      AND p."application_number"     IS NOT NULL
      AND TRIM(p."application_number") <> ''
),
/*--------------------------------------------------------------------
2. Count yearly filings for every CPC main‑group
--------------------------------------------------------------------*/
agg AS (
    SELECT
        "CPC_GROUP",
        "FILING_YEAR",
        COUNT(*) AS "FILINGS"
    FROM first_cpc
    GROUP BY "CPC_GROUP", "FILING_YEAR"
),
/*--------------------------------------------------------------------
3. Order years per CPC group to drive the recursive EMA
--------------------------------------------------------------------*/
ordered AS (
    SELECT
        "CPC_GROUP",
        "FILING_YEAR",
        "FILINGS",
        ROW_NUMBER() OVER (PARTITION BY "CPC_GROUP"
                           ORDER BY "FILING_YEAR") AS rn
    FROM agg
),
/*--------------------------------------------------------------------
4. Recursive EMA calculation   (α = 0.20)
   EMA₁ = α·x₁
   EMAₙ = α·xₙ + (1‑α)·EMAₙ₋₁
--------------------------------------------------------------------*/
rec AS (
    /* anchor row -----------------------------------------------------*/
    SELECT
        "CPC_GROUP",
        "FILING_YEAR",
        "FILINGS",
        "FILINGS" * 0.20                          AS ema,
        rn
    FROM ordered
    WHERE rn = 1

    UNION ALL

    /* recursive step -------------------------------------------------*/
    SELECT
        o."CPC_GROUP",
        o."FILING_YEAR",
        o."FILINGS",
        (o."FILINGS" * 0.20) + (r.ema * 0.80)     AS ema,
        o.rn
    FROM rec r
    JOIN ordered o
      ON o."CPC_GROUP" = r."CPC_GROUP"
     AND o.rn          = r.rn + 1
),
/*--------------------------------------------------------------------
5. For each CPC group, keep the year with the maximum EMA
--------------------------------------------------------------------*/
best_year AS (
    SELECT
        "CPC_GROUP",
        "FILING_YEAR"                                         AS "BEST_YEAR",
        ema                                                   AS "HIGHEST_EMA",
        ROW_NUMBER() OVER (PARTITION BY "CPC_GROUP"
                           ORDER BY ema DESC, "FILING_YEAR")  AS rk
    FROM rec
)
/*--------------------------------------------------------------------
6. Present results with CPC title where available
--------------------------------------------------------------------*/
SELECT
    b."CPC_GROUP",
    d."titleFull"                 AS "CPC_TITLE",
    b."BEST_YEAR",
    b."HIGHEST_EMA"
FROM best_year b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."CPC_GROUP"
WHERE b.rk = 1                                  -- top year per group
ORDER BY b."HIGHEST_EMA" DESC NULLS LAST,
         b."CPC_GROUP";
