```sql
/*  Identify, for every CPC technology area at hierarchy level 5,
    the calendar year in which its exponential‑moving‑average (α = 0.2)
    of patent‑filing counts attains its maximum.                           */

WITH cpc_first_code AS (          -- 1) keep only the very first CPC code per patent
    SELECT
        p."publication_number",
        p."filing_date",
        p."application_number",
        f.value:"code"::STRING        AS "cpc_code"
    FROM PATENTS.PATENTS.PUBLICATIONS                p,
         LATERAL TABLE(FLATTEN(INPUT => p."cpc"))    f
    WHERE f."index" = 0                              -- first element in the CPC array
      AND p."application_number" IS NOT NULL         -- valid application number
      AND TRIM(p."application_number") <> ''
      AND p."filing_date" IS NOT NULL                -- valid filing date
      AND p."filing_date" <> 0
),

counts AS (                     -- 2) yearly filing counts for each CPC level‑5 group
    SELECT
        cd."symbol"                                         AS "cpc_group",
        cd."titleFull"                                      AS "cpc_title",
        TO_NUMBER(SUBSTR(cfc."filing_date"::STRING,1,4))    AS "yr",
        COUNT(*)                                            AS "filings"
    FROM cpc_first_code                      cfc
    JOIN PATENTS.PATENTS.CPC_DEFINITION      cd
           ON cd."level" = 5
          AND cfc."cpc_code" ILIKE cd."symbol" || '%'
    GROUP BY cd."symbol", cd."titleFull",
             TO_NUMBER(SUBSTR(cfc."filing_date"::STRING,1,4))
),

ordered_counts AS (             -- 3) impose an ordering of years per group
    SELECT
        "cpc_group",
        "cpc_title",
        "yr",
        "filings",
        ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY "yr") AS rn
    FROM counts
),

/* 4) recursively compute EMAt = 0.2·Xt + 0.8·EMAt‑1                       */
EMA_RECURSIVE AS (
    -- seed: first year of each CPC group
    SELECT
        "cpc_group",
        "cpc_title",
        "yr",
        "filings",
        CAST("filings" AS FLOAT) AS ema,
        rn
    FROM ordered_counts
    WHERE rn = 1

    UNION ALL

    -- recursive step
    SELECT
        oc."cpc_group",
        oc."cpc_title",
        oc."yr",
        oc."filings",
        0.2 * oc."filings" + 0.8 * er.ema      AS ema,
        oc.rn
    FROM EMA_RECURSIVE     er
    JOIN ordered_counts    oc
          ON oc."cpc_group" = er."cpc_group"
         AND oc.rn         = er.rn + 1
),

best_year AS (                  -- 5) pick the year with the highest EMA per group
    SELECT
        "cpc_group",
        "cpc_title",
        "yr"  AS "best_year",
        ema   AS "max_ema",
        ROW_NUMBER() OVER (PARTITION BY "cpc_group"
                           ORDER BY ema DESC, "yr" ASC) AS rnk
    FROM EMA_RECURSIVE
)

SELECT
    "cpc_group",          -- CPC symbol (level‑5 group)
    "cpc_title",          -- full CPC title
    "best_year",          -- year in which EMA is maximal
    "max_ema"             -- corresponding EMA value
FROM best_year
WHERE rnk = 1
ORDER BY "cpc_group";
```
