```sql
--Description: Find, for patents assigned to DENSO that are cited by others,
--             (i) who the citing assignees are (excluding any assignee that itself contains “DENSO”),
--             (ii) the title of the primary CPC subclass of the citing patent (based on the CPC entry where "first" = TRUE),
--             (iii) how many such citations occur for each (assignee × CPC-title) combination.
--Logic / thinking inside the query:
-- 1.  Start from PUBLICATIONS as “citing”.
-- 2.  Flatten citing.citation → every cited publication number.
-- 3.  Self-join that cited publication to PUBLICATIONS (cited_doc) to inspect its assignees.
-- 4.  Keep a row only if cited_doc has an assignee whose name ILIKE '%DENSO%'.
-- 5.  Flatten citing.assignee_harmonized → extract the citing assignee; immediately exclude any assignee ILIKE '%DENSO%'.
-- 6.  Flatten citing.cpc → restrict to element with "first" = TRUE to pick the primary CPC code.
-- 7.  Require citing.filing_date > 0 to avoid missing / invalid dates.
-- 8.  Wrap the above as sub-query “cit”; outer query joins CPC_DEFINITION on the primary CPC symbol
--     to fetch its full title, then aggregates and orders by citation count.
SELECT
       cit."citing_assignee",
       COALESCE(def."titleFull", cit."primary_cpc_code") AS "primary_cpc_title",
       COUNT(*)                                         AS "citation_count"
FROM (
        -- Sub-query builds one record per (citation link × primary CPC of the citer).
        SELECT
               ah1.value:"name"::STRING   AS "citing_assignee",
               cpc_f.value:"code"::STRING AS "primary_cpc_code"
        FROM   PATENTS.PATENTS.PUBLICATIONS             citing
        ,      LATERAL FLATTEN(input => citing."citation")               cited
        ,      PATENTS.PATENTS.PUBLICATIONS             cited_doc
        ,      LATERAL FLATTEN(input => cited_doc."assignee_harmonized") ah2
        ,      LATERAL FLATTEN(input => citing."assignee_harmonized")    ah1
        ,      LATERAL FLATTEN(input => citing."cpc")                    cpc_f
        WHERE  cited_doc."publication_number" = cited.value:"publication_number"::STRING
          AND  ah2.value:"name"::STRING ILIKE '%DENSO%'        -- cited patent belongs to DENSO
          AND  ah1.value:"name"::STRING NOT ILIKE '%DENSO%'    -- citing assignee is NOT DENSO
          AND  cpc_f.value:"first"::BOOLEAN = TRUE             -- primary CPC code only
          AND  citing."filing_date" > 0                        -- ensure valid filing date
) cit
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION def
       ON def."symbol" = cit."primary_cpc_code"
GROUP BY
       cit."citing_assignee",
       def."titleFull",
       cit."primary_cpc_code"
ORDER BY
       "citation_count" DESC
LIMIT 20;
```
