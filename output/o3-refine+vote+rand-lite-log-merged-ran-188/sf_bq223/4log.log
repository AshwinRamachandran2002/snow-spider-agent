```sql
--Description: 6) Inspect the CPC array of a sample citing patent to locate the “first=true” element
SELECT 
    t."publication_number",
    cpc_f.value:"code"::STRING          AS "cpc_code",
    cpc_f.value:"first"::BOOLEAN        AS "is_first"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN (input => t."cpc") cpc_f
WHERE t."publication_number" ILIKE '%US%-%'
LIMIT 20;
```

```sql
--Description: 7) Bring CPC (first=true) information into the citation link table
SELECT 
    citing."publication_number"                                 AS "citing_pub",
    ah1.value:"name"::STRING                                    AS "citing_assignee",
    cpc_f.value:"code"::STRING                                  AS "primary_cpc_code"
FROM PATENTS.PATENTS.PUBLICATIONS  citing,
     LATERAL FLATTEN (input => citing."citation")               cited,
     PATENTS.PATENTS.PUBLICATIONS  cited_doc,
     LATERAL FLATTEN (input => cited_doc."assignee_harmonized") ah2,
     LATERAL FLATTEN (input => citing."assignee_harmonized")    ah1,
     LATERAL FLATTEN (input => citing."cpc")                    cpc_f
WHERE cited_doc."publication_number" = cited.value:"publication_number"::STRING
  AND ah2.value:"name"::STRING ILIKE '%DENSO%'
  AND ah1.value:"name"::STRING NOT ILIKE '%DENSO%'
  AND cpc_f.value:"first"::BOOLEAN = TRUE
  AND citing."filing_date" > 0
LIMIT 20;
```

```sql
--Description: 8) Join the primary CPC code with the CPC_DEFINITION table to get the full subclass titles
SELECT DISTINCT
    cpc_join."primary_cpc_code",
    def."titleFull"
FROM (
    SELECT 
        cpc_f.value:"code"::STRING  AS "primary_cpc_code"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc") cpc_f
    WHERE cpc_f.value:"first"::BOOLEAN = TRUE
      AND t."publication_number" ILIKE '%US%-%'
    LIMIT 100
) cpc_join
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION def
       ON def."symbol" = cpc_join."primary_cpc_code"
LIMIT 20;
```

```sql
--Description: 9) Aggregate: count citations by (citing assignee, CPC title) excluding DENSO as citer
SELECT
    citing_assignee,
    def."titleFull"                                  AS "primary_cpc_title",
    COUNT(*)                                         AS "n_citations"
FROM (
      SELECT 
          ah1.value:"name"::STRING                   AS citing_assignee,
          cpc_f.value:"code"::STRING                 AS primary_cpc_code
      FROM PATENTS.PATENTS.PUBLICATIONS  citing,
           LATERAL FLATTEN (input => citing."citation")               cited,
           PATENTS.PATENTS.PUBLICATIONS  cited_doc,
           LATERAL FLATTEN (input => cited_doc."assignee_harmonized") ah2,
           LATERAL FLATTEN (input => citing."assignee_harmonized")    ah1,
           LATERAL FLATTEN (input => citing."cpc")                    cpc_f
      WHERE cited_doc."publication_number" = cited.value:"publication_number"::STRING
        AND ah2.value:"name"::STRING ILIKE '%DENSO%'
        AND ah1.value:"name"::STRING NOT ILIKE '%DENSO%'
        AND cpc_f.value:"first"::BOOLEAN = TRUE
        AND citing."filing_date" > 0
) cit
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION def
       ON def."symbol" = cit."primary_cpc_code"
GROUP BY citing_assignee, def."titleFull"
ORDER BY n_citations DESC
LIMIT 20;
```

```sql
--Description: 10) (Final-form query) Produce the requested list of citing assignee, CPC subclass title, and citation count
SELECT
    cit."citing_assignee",
    def."titleFull"                        AS "primary_cpc_title",
    COUNT(*)                               AS "citation_count"
FROM (
      SELECT 
          ah1.value:"name"::STRING         AS citing_assignee,
          cpc_f.value:"code"::STRING       AS primary_cpc_code
      FROM PATENTS.PATENTS.PUBLICATIONS  citing
      ,    LATERAL FLATTEN (input => citing."citation")               cited
      ,    PATENTS.PATENTS.PUBLICATIONS  cited_doc
      ,    LATERAL FLATTEN (input => cited_doc."assignee_harmonized") ah2
      ,    LATERAL FLATTEN (input => citing."assignee_harmonized")    ah1
      ,    LATERAL FLATTEN (input => citing."cpc")                    cpc_f
      WHERE cited_doc."publication_number" = cited.value:"publication_number"::STRING
        AND ah2.value:"name"::STRING ILIKE '%DENSO%'
        AND ah1.value:"name"::STRING NOT ILIKE '%DENSO%'
        AND cpc_f.value:"first"::BOOLEAN = TRUE
        AND citing."filing_date" > 0
) cit
JOIN PATENTS.PATENTS.CPC_DEFINITION def
  ON def."symbol" = cit."primary_cpc_code"
GROUP BY cit."citing_assignee", def."titleFull"
ORDER BY citation_count DESC
LIMIT 20;
```
