```sql
--Description: 4) Identify those citation links where the cited patent is assigned to DENSO
SELECT 
    citing."publication_number"                                 AS "citing_pub",
    cited.value:"publication_number"::STRING                    AS "cited_pub",
    ah2.value:"name"::STRING                                    AS "cited_assignee"
FROM PATENTS.PATENTS.PUBLICATIONS citing,
     LATERAL FLATTEN (input => citing."citation") cited,
     PATENTS.PATENTS.PUBLICATIONS cited_doc,
