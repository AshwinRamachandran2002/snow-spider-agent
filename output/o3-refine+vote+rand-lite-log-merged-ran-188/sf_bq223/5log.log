```sql
--Description: 7) Examine the CPC array of those citing patents and pull only the first CPC code (first element in the array)  
WITH target_citing AS (
    WITH denso_pubs AS (
        SELECT DISTINCT t."publication_number"
        FROM PATENTS.PATENTS.PUBLICATIONS t, 
             LATERAL FLATTEN(input => t."assignee_harmonized") ah
        WHERE ah.value:"name"::STRING ILIKE '%DENSO%'
          AND t."filing_date" IS NOT NULL
          AND t."filing_date" > 0
    )
    SELECT DISTINCT citing."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS citing,
         LATERAL FLATTEN(input => citing."citation") c
    WHERE c.value:"publication_number"::STRING IN (SELECT * FROM denso_pubs)
      AND citing."filing_date" IS NOT NULL
      AND citing."filing_date" > 0
)
SELECT 
    tc."publication_number",
    cp.value:"code"::STRING AS "first_cpc_code"
FROM PATENTS.PATENTS.PUBLICATIONS tc,
     LATERAL FLATTEN(input => tc."cpc") cp
WHERE tc."publication_number" IN (SELECT "publication_number" FROM target_citing)
  AND cp.index = 0          -- first element in CPC array
LIMIT 20;
```

```sql
--Description: 8) Join the first-CPC subclass (first 4 characters) to CPC_DEFINITION and show the full title  
WITH citing_cpc AS (
    WITH target_citing AS (
        WITH denso_pubs AS (
            SELECT DISTINCT t."publication_number"
            FROM PATENTS.PATENTS.PUBLICATIONS t, 
                 LATERAL FLATTEN(input => t."assignee_harmonized") ah
            WHERE ah.value:"name"::STRING ILIKE '%DENSO%'
              AND t."filing_date" IS NOT NULL
              AND t."filing_date" > 0
        )
        SELECT DISTINCT citing."publication_number"
        FROM PATENTS.PATENTS.PUBLICATIONS citing,
             LATERAL FLATTEN(input => citing."citation") c
        WHERE c.value:"publication_number"::STRING IN (SELECT * FROM denso_pubs)
          AND citing."filing_date" IS NOT NULL
          AND citing."filing_date" > 0
    )
    SELECT 
        tc."publication_number",
        SUBSTR(cp.value:"code"::STRING, 0, 4) AS "cpc4"
    FROM PATENTS.PATENTS.PUBLICATIONS tc,
         LATERAL FLATTEN(input => tc."cpc") cp
    WHERE tc."publication_number" IN (SELECT "publication_number" FROM target_citing)
      AND cp.index = 0
)
SELECT 
    cc."publication_number",
    cd."titleFull"          AS "cpc_title"
FROM citing_cpc cc
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
      ON cd."symbol" = cc."cpc4"
LIMIT 20;
```

```sql
--Description: 9) Combine citing assignee, CPC subclass title, and count the number of citations for each pair  
WITH denso_pubs AS (
    SELECT DISTINCT t."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS t, 
         LATERAL FLATTEN(input => t."assignee_harmonized") ah
    WHERE ah.value:"name"::STRING ILIKE '%DENSO%'
      AND t."filing_date" IS NOT NULL
      AND t."filing_date" > 0
), citing_info AS (
    SELECT 
        citing."publication_number"                             AS "citing_pub",
        ah.value:"name"::STRING                                 AS "citing_assignee"
    FROM PATENTS.PATENTS.PUBLICATIONS citing,
         LATERAL FLATTEN(input => citing."citation") c,
         LATERAL FLATTEN(input => citing."assignee_harmonized") ah
    WHERE c.value:"publication_number"::STRING IN (SELECT * FROM denso_pubs)
      AND citing."filing_date" IS NOT NULL
      AND citing."filing_date" > 0
      AND ah.value:"name"::STRING NOT ILIKE '%DENSO%'
), citing_cpc AS (
    SELECT 
        tc."publication_number"                                 AS "citing_pub",
        SUBSTR(cp.value:"code"::STRING, 0, 4)                   AS "cpc4"
    FROM PATENTS.PATENTS.PUBLICATIONS tc,
         LATERAL FLATTEN(input => tc."cpc") cp
    WHERE tc."publication_number" IN (SELECT "citing_pub" FROM citing_info)
      AND cp.index = 0
), combined AS (
    SELECT 
        ci."citing_assignee",
        cd."titleFull"                      AS "cpc_title"
    FROM citing_info ci
    JOIN citing_cpc cc       ON cc."citing_pub" = ci."citing_pub"
    LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
           ON cd."symbol" = cc."cpc4"
)
SELECT 
    "citing_assignee",
    "cpc_title",
    COUNT(*) AS "citation_count"
FROM combined
GROUP BY "citing_assignee", "cpc_title"
ORDER BY "citation_count" DESC
LIMIT 20;
```

