--Description: 6. Find publications that cite any of the DENSO publications identified in step 5.
SELECT 
    t."publication_number"              AS "citing_pub_no",
    c.value:"publication_number"::STRING AS "cited_pub_no"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") c
WHERE c.value:"publication_number"::STRING IN (
      SELECT DISTINCT
          d."denso_pub_no"
      FROM (
            SELECT t2."publication_number" AS "denso_pub_no"
            FROM PATENTS.PATENTS.PUBLICATIONS t2,
                 LATERAL FLATTEN(input => t2."assignee_harmonized") ah2
            WHERE ah2.value:"name"::STRING ILIKE '%DENSO%'
              AND t2."filing_date" > 0
           ) d
)
LIMIT 20;
