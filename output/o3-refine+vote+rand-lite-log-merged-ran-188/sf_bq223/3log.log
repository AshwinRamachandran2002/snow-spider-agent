--Description: 9. Join the primary CPC symbol with CPC_DEFINITION to obtain the full CPC subclass title.
SELECT 
    cpdata."primary_cpc_code",
    def."titleFull" AS "cpc_title"
FROM (
    SELECT DISTINCT
        cp.value:"code"::STRING AS "primary_cpc_code"
    FROM PATENTS.PATENTS.PUBLICATIONS citing,
         LATERAL FLATTEN(input => citing."citation") cit,
         LATERAL FLATTEN(input => citing."cpc") cp
    WHERE cit.value:"publication_number"::STRING IN (
          SELECT DISTINCT
              d."denso_pub_no"
          FROM (
                SELECT t2."publication_number" AS "denso_pub_no"
                FROM PATENTS.PATENTS.PUBLICATIONS t2,
                     LATERAL FLATTEN(input => t2."assignee_harmonized") ah2
                WHERE ah2.value:"name"::STRING ILIKE '%DENSO%'
                  AND t2."filing_date" > 0
               ) d
    )
      AND cp.value:"first"::BOOLEAN = TRUE
) cpdata
JOIN PATENTS.PATENTS.CPC_DEFINITION def
  ON def."symbol" = cpdata."primary_cpc_code"
LIMIT 20;
