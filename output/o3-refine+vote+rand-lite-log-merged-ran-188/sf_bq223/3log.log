--Description: 10. Final aggregation: count how many times each non-DENSO assignee cites DENSO patents, grouped by CPC subclass title.
SELECT 
    citing_info."citing_assignee",
    def."titleFull"                     AS "cpc_subclass_title",
    COUNT(*)                            AS "citation_count"
FROM (
    SELECT 
        citing."publication_number"                     AS "citing_pub_no",
        ah.value:"name"::STRING                         AS "citing_assignee",
        cp.value:"code"::STRING                         AS "primary_cpc_code"
    FROM PATENTS.PATENTS.PUBLICATIONS citing,
         LATERAL FLATTEN(input => citing."citation") cit,
         LATERAL FLATTEN(input => citing."assignee_harmonized") ah,
         LATERAL FLATTEN(input => citing."cpc") cp
    WHERE cit.value:"publication_number"::STRING IN (
          SELECT DISTINCT
              d."denso_pub_no"
          FROM (
                SELECT t2."publication_number" AS "denso_pub_no"
                FROM PATENTS.PATENTS.PUBLICATIONS t2,
                     LATERAL FLATTEN(input => t2."assignee_harmonized") ah2
                WHERE ah2.value:"name"::STRING ILIKE '%DENSO%'
                  AND t2."filing_date" > 0
               ) d
    )
      AND ah.value:"name"::STRING NOT ILIKE '%DENSO%'
      AND cp.value:"first"::BOOLEAN = TRUE
) citing_info
JOIN PATENTS.PATENTS.CPC_DEFINITION def
  ON def."symbol" = citing_info."primary_cpc_code"
GROUP BY 
    citing_info."citing_assignee",
    def."titleFull"
LIMIT 20;
