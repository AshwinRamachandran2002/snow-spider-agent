--Description: 7. Retrieve assignee names of the citing patents (excluding DENSO CORP itself) for the relationships found above.
SELECT DISTINCT
    citing."publication_number"                         AS "citing_pub_no",
    ah.value:"name"::STRING                             AS "citing_assignee"
FROM PATENTS.PATENTS.PUBLICATIONS citing,
     LATERAL FLATTEN(input => citing."citation") cit,
     LATERAL FLATTEN(input => citing."assignee_harmonized") ah
WHERE cit.value:"publication_number"::STRING IN (
      SELECT DISTINCT
          d."denso_pub_no"
      FROM (
            SELECT t2."publication_number" AS "denso_pub_no"
            FROM PATENTS.PATENTS.PUBLICATIONS t2,
                 LATERAL FLATTEN(input => t2."assignee_harmonized") ah2
            WHERE ah2.value:"name"::STRING ILIKE '%DENSO%'
              AND t2."filing_date" > 0
           ) d
)
  AND ah.value:"name"::STRING NOT ILIKE '%DENSO%'
LIMIT 20;
