```sql
--Description: Retrieve the *first* CPC symbol for a set of citing patents (row_number = 1)
WITH citing AS (
    SELECT DISTINCT
        citing."publication_number"
    FROM 
        PATENTS.PATENTS.PUBLICATIONS  citing,
        LATERAL FLATTEN(input => citing."citation") cited
    WHERE 
        cited.value:"publication_number"::STRING IN (
            SELECT DISTINCT "publication_number"
            FROM PATENTS.PATENTS.PUBLICATIONS
            WHERE "assignee_harmonized" ILIKE '%DENSO%CORP%' 
              AND "filing_date" > 0
        )
        AND citing."filing_date" > 0
)
SELECT 
    p."publication_number",
    FIRST_VALUE(cpc_item.value:"code"::STRING) 
        OVER (PARTITION BY p."publication_number" ORDER BY cpc_item.index)  AS "first_cpc_code"
FROM 
    citing c
JOIN 
    PATENTS.PATENTS.PUBLICATIONS p
        ON p."publication_number" = c."publication_number"
JOIN 
    LATERAL FLATTEN(input => p."cpc") cpc_item
        ON TRUE
QUALIFY 
    cpc_item.index = 0                                             -- pick the first element only
LIMIT 20;
```

```sql
--Description: Map the first CPC code to its full title from CPC_DEFINITION
WITH first_cpc AS (
    SELECT 
        p."publication_number",
        FIRST_VALUE(cpc_item.value:"code"::STRING)
            OVER (PARTITION BY p."publication_number" ORDER BY cpc_item.index)  AS "first_cpc"
    FROM 
        PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc") cpc_item
    WHERE 
        p."publication_number" = 'US-8000000-B2'                  -- example citing pub
    QUALIFY 
