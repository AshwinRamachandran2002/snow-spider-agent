```sql
--Description: Map each publication’s first CPC code (array index 0) to its full CPC title
--             for a quick 20-row sample.  LATERAL FLATTEN is placed directly in the FROM
--             clause to avoid unsupported JOIN-LATERAL syntax.
WITH first_cpc AS (
    SELECT
        p."publication_number",
        cpc_item.value:"code"::STRING AS "first_cpc"
    FROM
        PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc") cpc_item
    WHERE
        cpc_item.index = 0
    LIMIT 20
)
SELECT
    f."publication_number",
    f."first_cpc",
    d."titleFull"
FROM
    first_cpc f
LEFT JOIN
    PATENTS.PATENTS.CPC_DEFINITION d
        ON d."symbol" = f."first_cpc";
```

```sql
--Description: List harmonized assignee names for the set of publications that cite
--             at least one DENSO-assigned patent (20-row sample).
SELECT
    p."publication_number",
    p."assignee_harmonized"
FROM
    PATENTS.PATENTS.PUBLICATIONS p
WHERE
    p."publication_number" IN (
        SELECT DISTINCT
            cit."publication_number"
        FROM
            PATENTS.PATENTS.PUBLICATIONS  cit,
            LATERAL FLATTEN(input => cit."citation") cited
        WHERE
            cited.value:"publication_number"::STRING IN (
                SELECT DISTINCT "publication_number"
                FROM PATENTS.PATENTS.PUBLICATIONS
                WHERE "assignee_harmonized" ILIKE '%DENSO%CORP%'
                  AND "filing_date" > 0
            )
            AND cit."filing_date" > 0
    )
LIMIT 20;
```

```sql
--Description: Aggregate citation counts by (citing assignee, CPC subclass title) for patents
--             that cite a DENSO patent, excluding DENSO CORP itself.  Uses FLATTEN in FROM
--             clauses to avoid unsupported JOIN-LATERAL syntax (20-row sample).
WITH denso_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "assignee_harmonized" ILIKE '%DENSO%CORP%'
      AND "filing_date" > 0
),
citing_links AS (
    SELECT DISTINCT
        cit."publication_number" AS citing_pub
    FROM
        PATENTS.PATENTS.PUBLICATIONS cit,
        LATERAL FLATTEN(input => cit."citation") cited
    WHERE
        cited.value:"publication_number"::STRING IN (SELECT * FROM denso_pubs)
        AND cit."filing_date" > 0
),
citing_w_cpc AS (
    SELECT
        cl.citing_pub,
        cpc_item.value:"code"::STRING AS first_cpc
    FROM
        citing_links cl,
        PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc") cpc_item
    WHERE
        p."publication_number" = cl.citing_pub
        AND cpc_item.index = 0
),
cpc_title AS (
    SELECT
        cw.citing_pub,
        cw.first_cpc,
        d."titleFull"
    FROM
        citing_w_cpc cw
    LEFT JOIN
        PATENTS.PATENTS.CPC_DEFINITION d
          ON d."symbol" = cw.first_cpc
)
SELECT
    p."assignee_harmonized"  AS citing_assignee,
    ct."titleFull"           AS cpc_title,
    COUNT(*)                 AS citation_cnt
FROM
    PATENTS.PATENTS.PUBLICATIONS p
    JOIN cpc_title ct
      ON p."publication_number" = ct.citing_pub
WHERE
    p."assignee_harmonized" NOT ILIKE '%DENSO%CORP%'
GROUP BY
    citing_assignee,
    cpc_title
LIMIT 20;
```

```sql
--Description: Same aggregation as above but ordered by descending citation count to highlight
--             the most frequent (assignee, CPC subclass) combinations (top 20 rows).
WITH denso_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "assignee_harmonized" ILIKE '%DENSO%CORP%'
      AND "filing_date" > 0
),
citing_links AS (
    SELECT DISTINCT
        cit."publication_number" AS citing_pub
    FROM
        PATENTS.PATENTS.PUBLICATIONS cit,
        LATERAL FLATTEN(input => cit."citation") cited
    WHERE
        cited.value:"publication_number"::STRING IN (SELECT * FROM denso_pubs)
        AND cit."filing_date" > 0
),
citing_w_cpc AS (
    SELECT
        cl.citing_pub,
        cpc_item.value:"code"::STRING AS first_cpc
    FROM
        citing_links cl,
        PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc") cpc_item
    WHERE
        p."publication_number" = cl.citing_pub
        AND cpc_item.index = 0
),
cpc_title AS (
    SELECT
        cw.citing_pub,
        cw.first_cpc,
        d."titleFull"
    FROM
        citing_w_cpc cw
    LEFT JOIN
        PATENTS.PATENTS.CPC_DEFINITION d
          ON d."symbol" = cw.first_cpc
),
agg AS (
    SELECT
        p."assignee_harmonized"  AS citing_assignee,
        ct."titleFull"           AS cpc_title,
        COUNT(*)                 AS citation_cnt
    FROM
        PATENTS.PATENTS.PUBLICATIONS p
        JOIN cpc_title ct
          ON p."publication_number" = ct.citing_pub
    WHERE
        p."assignee_harmonized" NOT ILIKE '%DENSO%CORP%'
    GROUP BY
        citing_assignee,
        cpc_title
)
SELECT
    citing_assignee,
    cpc_title,
    citation_cnt
FROM
    agg
ORDER BY
    citation_cnt DESC
LIMIT 20;
```
