```sql
--Description:  1) Find all publications that cite at least one DENSO-assigned patent
--                 (DENSO publications are identified through the harmonised assignee field
--                  and restricted to those with a valid filing date).
--              2) For every such citing publication, explode its CPC list and
--                 keep only the element with array index 0 – interpreted as the
--                 “first” CPC code for that patent.
--              The query returns the citing publication number together with that
--              first CPC subclass code (20 sample rows shown).
WITH citing AS (
    SELECT DISTINCT
        c."publication_number"
    FROM
        PATENTS.PATENTS.PUBLICATIONS c,
        LATERAL FLATTEN(input => c."citation") cited
    WHERE
        cited.value:"publication_number"::STRING IN (
            SELECT DISTINCT "publication_number"
            FROM PATENTS.PATENTS.PUBLICATIONS
            WHERE "assignee_harmonized" ILIKE '%DENSO%CORP%'
              AND "filing_date" > 0
        )
        AND c."filing_date" > 0
)
SELECT
    p."publication_number",
    cpc_item.value:"code"::STRING AS "first_cpc_code"
FROM
    citing,                                   -- set of citing publication numbers
    PATENTS.PATENTS.PUBLICATIONS p,
    LATERAL FLATTEN(input => p."cpc") cpc_item
WHERE
    p."publication_number" = citing."publication_number"
    AND cpc_item.index = 0                    -- keep only the first CPC entry
LIMIT 20;
```
