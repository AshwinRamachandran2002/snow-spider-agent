Query:
--Description: Aggregate citation counts by (citing assignee, CPC subclass title) for patents
--             that cite a DENSO patent, excluding DENSO CORP itself.  Uses FLATTEN in FROM
--             clauses to avoid unsupported JOIN-LATERAL syntax (20-row sample).
WITH denso_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "assignee_harmonized" ILIKE '%DENSO%CORP%'
      AND "filing_date" > 0
),
citing_links AS (
    SELECT DISTINCT
        cit."publication_number" AS citing_pub
    FROM
        PATENTS.PATENTS.PUBLICATIONS cit,
        LATERAL FLATTEN(input => cit."citation") cited
    WHERE
        cited.value:"publication_number"::STRING IN (SELECT * FROM denso_pubs)
        AND cit."filing_date" > 0
),
citing_w_cpc AS (
    SELECT
        cl.citing_pub,
        cpc_item.value:"code"::STRING AS first_cpc
    FROM
        citing_links cl,
        PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc") cpc_item
    WHERE
        p."publication_number" = cl.citing_pub
        AND cpc_item.index = 0
),
cpc_title AS (
    SELECT
        cw.citing_pub,
        cw.first_cpc,
        d."titleFull"
    FROM
        citing_w_cpc cw
    LEFT JOIN
        PATENTS.PATENTS.CPC_DEFINITION d
          ON d."symbol" = cw.first_cpc
)
SELECT
    p."assignee_harmonized"  AS citing_assignee,
    ct."titleFull"           AS cpc_title,
    COUNT(*)                 AS citation_cnt
FROM
    PATENTS.PATENTS.PUBLICATIONS p
    JOIN cpc_title ct
      ON p."publication_number" = ct.citing_pub
WHERE
    p."assignee_harmonized" NOT ILIKE '%DENSO%CORP%'
GROUP BY
    citing_assignee,
    cpc_title
LIMIT 20
