```sql
--Description: Bring everything together – preliminary aggregation of citation counts 
--             by citing assignee and CPC subclass title, excluding DENSO CORP
WITH denso_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "assignee_harmonized" ILIKE '%DENSO%CORP%' 
      AND "filing_date" > 0
),
citing_links AS (
    SELECT DISTINCT
        citing."publication_number"     AS citing_pub
    FROM 
        PATENTS.PATENTS.PUBLICATIONS  citing,
        LATERAL FLATTEN(input => citing."citation") cited
    WHERE 
        cited.value:"publication_number"::STRING IN (SELECT * FROM denso_pubs)
        AND citing."filing_date" > 0
),
citing_w_cpc AS (
    SELECT 
        c.citing_pub,
        FIRST_VALUE(cpc_item.value:"code"::STRING)
          OVER (PARTITION BY c.citing_pub ORDER BY cpc_item.index)  AS first_cpc
    FROM 
        citing_links c
    JOIN 
        PATENTS.PATENTS.PUBLICATIONS p 
          ON p."publication_number" = c.citing_pub
    JOIN 
        LATERAL FLATTEN(input => p."cpc") cpc_item
          ON TRUE
    QUALIFY 
        cpc_item.index = 0
),
cpc_title AS (
    SELECT 
        cw.citing_pub,
        cw.first_cpc,
        d."titleFull"
    FROM 
        citing_w_cpc cw
    LEFT JOIN 
        PATENTS.PATENTS.CPC_DEFINITION d
          ON d."symbol" = cw.first_cpc
),
final AS (
    SELECT 
        p."assignee_harmonized"          AS citing_assignee,
        c."titleFull"                    AS cpc_title,
        COUNT(*)                         AS citation_cnt
    FROM 
        PATENTS.PATENTS.PUBLICATIONS p
    JOIN 
        cpc_title c
          ON p."publication_number" = c.citing_pub
    WHERE 
        p."assignee_harmonized" NOT ILIKE '%DENSO%CORP%'
    GROUP BY 
        citing_assignee,
        cpc_title
)
SELECT * FROM final
LIMIT 20;
```

