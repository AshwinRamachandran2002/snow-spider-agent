Query:
--Description: Map each publication’s first CPC code (array index 0) to its full CPC title
--             for a quick 20-row sample.  LATERAL FLATTEN is placed directly in the FROM
--             clause to avoid unsupported JOIN-LATERAL syntax.
WITH first_cpc AS (
    SELECT
        p."publication_number",
        cpc_item.value:"code"::STRING AS "first_cpc"
    FROM
        PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc") cpc_item
    WHERE
        cpc_item.index = 0
    LIMIT 20
)
SELECT
    f."publication_number",
    f."first_cpc",
    d."titleFull"
FROM
    first_cpc f
LEFT JOIN
    PATENTS.PATENTS.CPC_DEFINITION d
        ON d."symbol" = f."first_cpc"
