Query:
--Description: 10) Aggregate counts of citations by non-DENSO assignee and CPC subclass title
-- Optimised to stay within the warehouse timeout by:
--   1. Capping DENSO-assigned publication list to 5 000 records.
--   2. Capping citing publication set to 1 000 records before any FLATTEN.
--   3. Performing FLATTEN only on this trimmed citing set.
--   4. Using four-character CPC subclass from the primary (“first” = true) CPC code.

WITH denso_pubs AS (                       -- 1) subset of DENSO patents
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee_harmonized") f
    WHERE f.value:"name" ILIKE '%denso%'
    LIMIT 5000
),
citing_base AS (                           -- 2) citing publications (capped)
    SELECT DISTINCT cp."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS cp,
         LATERAL FLATTEN(input => cp."citation") ct
         JOIN denso_pubs dp
           ON ct.value:"publication_number"::STRING = dp."publication_number"
    WHERE cp."filing_date" > 0
    LIMIT 1000
),
citing_expanded AS (                       -- 3) extract assignee (≠DENSO) & primary CPC subclass
    SELECT
        cb."publication_number",
        ass.value:"name"::STRING                    AS "citing_assignee",
        SUBSTR(cpc.value:"code"::STRING, 0, 4)      AS "cpc_subclass"
    FROM citing_base cb
         JOIN PATENTS.PATENTS.PUBLICATIONS pub
           ON pub."publication_number" = cb."publication_number",
         LATERAL FLATTEN(input => pub."assignee_harmonized") ass,
         LATERAL FLATTEN(input => pub."cpc")               cpc
    WHERE cpc.value:"first"::BOOLEAN = TRUE
      AND ass.value:"name" NOT ILIKE '%denso%'             -- exclude DENSO as citer
)
SELECT
    ce."citing_assignee",
    cd."titleFull"                           AS "cpc_subclass_title",
    COUNT(*)                                 AS "n_citations"
FROM citing_expanded ce
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
       ON cd."symbol" = ce."cpc_subclass"
GROUP BY ce."citing_assignee", cd."titleFull"
ORDER BY "n_citations" DESC
LIMIT 20
Answer:
