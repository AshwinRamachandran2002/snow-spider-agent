--   4. final SELECT    : join CPC subclass to CPC_DEFINITION for the full title, group & count.
-- The result is ordered by descending citation count; adjust / remove the LIMIT at bottom as needed.

WITH denso_pubs AS (          -- CTE 1: all DENSO publications
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE a.value:"name" ILIKE '%denso%'
),

citing_base AS (              -- CTE 2: publications citing any DENSO pub
    SELECT DISTINCT cit."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS cit,
         LATERAL FLATTEN(input => cit."citation") c
         JOIN denso_pubs d
           ON c.value:"publication_number"::STRING = d."publication_number"
    WHERE cit."filing_date" > 0
    LIMIT 5000                         -- performance safeguard
),

citing_data AS (              -- CTE 3: extract assignee (≠DENSO) & primary CPC subclass
    SELECT 
        cb."publication_number"                                   AS "citing_pub",
        ass.value:"name"::STRING                                  AS "citing_assignee",
        SUBSTR(cpc.value:"code"::STRING, 0, 4)                    AS "cpc_subclass"
    FROM citing_base cb
         JOIN PATENTS.PATENTS.PUBLICATIONS p
           ON p."publication_number" = cb."publication_number",
         LATERAL FLATTEN(input => p."assignee_harmonized") ass,
         LATERAL FLATTEN(input => p."cpc") cpc
    WHERE cpc.value:"first"::BOOLEAN = TRUE
      AND ass.value:"name" NOT ILIKE '%denso%'    -- exclude DENSO as citing assignee
)

SELECT 
    cd."titleFull"                                  AS "cpc_subclass_title",
    cd."symbol"                                     AS "cpc_subclass",
    citing_data."citing_assignee",
    COUNT(*)                                        AS "citation_count"
FROM citing_data
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
       ON cd."symbol" = citing_data."cpc_subclass"
GROUP BY citing_data."citing_assignee", cd."symbol", cd."titleFull"
ORDER BY "citation_count" DESC
LIMIT 100;
