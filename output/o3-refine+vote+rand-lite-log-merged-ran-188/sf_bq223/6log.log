--Description: 
-- Provide a quick, low-cost snapshot (≤20 rows) of patents that cite a DENSO-assigned patent.
-- Each output row lists:
--   • citing publication number
--   • citing assignee name (excluding any “DENSO” spelling)
--   • the primary CPC subclass code (first CPC entry, four-character level)
-- Performance-saving measures:
--   1. Limit the starting DENSO publication list to 5 000 rows.
--   2. Limit the citing publication list to 150 rows before any FLATTEN operations.
--   3. Apply FLATTEN only on this trimmed citing list.

WITH denso_pubs AS (                       -- 1) DENSO publications (capped)
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee_harmonized") ah
    WHERE ah.value:"name" ILIKE '%denso%'
    LIMIT 5000
),
citing_subset AS (                         -- 2) citing publications with valid filing_date (capped)
    SELECT DISTINCT cp."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS cp,
         LATERAL FLATTEN(input => cp."citation") ct
         JOIN denso_pubs dp
           ON ct.value:"publication_number"::STRING = dp."publication_number"
    WHERE cp."filing_date" > 0
    LIMIT 150
)
SELECT
    cs."publication_number"                               AS "citing_pub",
    ass.value:"name"::STRING                              AS "citing_assignee",
    SUBSTR(cpc.value:"code"::STRING, 0, 4)                AS "primary_cpc_subclass"
FROM citing_subset cs
JOIN PATENTS.PATENTS.PUBLICATIONS pub
      ON pub."publication_number" = cs."publication_number",
     LATERAL FLATTEN(input => pub."assignee_harmonized") ass,
     LATERAL FLATTEN(input => pub."cpc")               cpc
WHERE cpc.value:"first"::BOOLEAN = TRUE
  AND ass.value:"name" NOT ILIKE '%denso%'              -- exclude DENSO as citer
LIMIT 20;
