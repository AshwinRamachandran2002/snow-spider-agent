```sql
-- Description: 9) Combine citing publication, assignee (excluding DENSO), first CPC subclass & title
WITH denso_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS d,
         LATERAL FLATTEN(input => d."assignee_harmonized") fx
    WHERE fx.value:"name" ILIKE '%denso%'
),
citing_info AS (
    SELECT 
        citing."publication_number"                              AS "citing_pub",
        ass.value:"name"::STRING                                 AS "citing_assignee",
        cp.value:"code"::STRING                                  AS "first_cpc_code"
    FROM PATENTS.PATENTS.PUBLICATIONS citing
         ,LATERAL FLATTEN(input => citing."citation") cit
         ,LATERAL FLATTEN(input => citing."assignee_harmonized") ass
         ,LATERAL FLATTEN(input => citing."cpc") cp
    JOIN denso_pubs d
         ON cit.value:"publication_number"::STRING = d."publication_number"
    WHERE citing."filing_date" > 0
          AND cp.value:"first"::BOOLEAN = TRUE
          AND ass.value:"name" NOT ILIKE '%denso%'      -- exclude DENSO as citing assignee
)
SELECT *
FROM citing_info
LIMIT 20;
```

```sql
-- Description: 10) Final aggregation: count of citations by citing assignee & CPC subclass title
WITH denso_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS d,
         LATERAL FLATTEN(input => d."assignee_harmonized") fx
    WHERE fx.value:"name" ILIKE '%denso%'
),
citing_base AS (
    SELECT 
        citing."publication_number"                              AS "citing_pub",
        ass.value:"name"::STRING                                 AS "citing_assignee",
        SUBSTR(cp.value:"code"::STRING, 0, 4)                    AS "cpc_subclass"  -- first 4 chars
    FROM PATENTS.PATENTS.PUBLICATIONS citing
         ,LATERAL FLATTEN(input => citing."citation") cit
         ,LATERAL FLATTEN(input => citing."assignee_harmonized") ass
         ,LATERAL FLATTEN(input => citing."cpc") cp
    JOIN denso_pubs d
         ON cit.value:"publication_number"::STRING = d."publication_number"
    WHERE citing."filing_date" > 0
          AND cp.value:"first"::BOOLEAN = TRUE
          AND ass.value:"name" NOT ILIKE '%denso%'
)
SELECT 
    cb."citing_assignee",
    cd."titleFull"                              AS "cpc_subclass_title",
    COUNT(*)                                    AS "n_citations"
FROM citing_base cb
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
       ON cd."symbol" = cb."cpc_subclass"
GROUP BY cb."citing_assignee", cd."titleFull"
ORDER BY "n_citations" DESC
LIMIT 20;
```
