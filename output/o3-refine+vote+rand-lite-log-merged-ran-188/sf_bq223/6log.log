--Description: 10) Aggregate counts of citations by non-DENSO assignee and CPC subclass title
WITH denso_pubs AS (
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."assignee_harmonized") f
    WHERE f.value:"name" ILIKE '%denso%'
),
citing_base AS (
    SELECT DISTINCT cpub."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS cpub,
         LATERAL FLATTEN(input => cpub."citation") ct
         JOIN denso_pubs d
           ON ct.value:"publication_number"::STRING = d."publication_number"
    WHERE cpub."filing_date" > 0
    LIMIT 5000                               -- limit to avoid long runtime
),
citing_expanded AS (
    SELECT 
        cb."publication_number",
        ass.value:"name"::STRING                       AS "citing_assignee",
        SUBSTR(cpc.value:"code"::STRING, 0, 4)         AS "cpc_subclass"
    FROM citing_base cb
         JOIN PATENTS.PATENTS.PUBLICATIONS pub
           ON pub."publication_number" = cb."publication_number",
         LATERAL FLATTEN(input => pub."assignee_harmonized") ass,
         LATERAL FLATTEN(input => pub."cpc")           cpc
    WHERE cpc.value:"first"::BOOLEAN = TRUE
      AND ass.value:"name" NOT ILIKE '%denso%'
)
SELECT 
    ce."citing_assignee",
    cd."titleFull"            AS "cpc_subclass_title",
    COUNT(*)                  AS "n_citations"
FROM citing_expanded ce
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
       ON cd."symbol" = ce."cpc_subclass"
GROUP BY ce."citing_assignee", cd."titleFull"
ORDER BY "n_citations" DESC
LIMIT 20;
