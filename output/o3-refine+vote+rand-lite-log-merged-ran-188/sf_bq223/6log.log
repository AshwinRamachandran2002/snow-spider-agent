```sql
-- Description: 6) Pull out the FIRST CPC code (where "first" = true) for those citing publications
WITH citing_set AS (
    /* build citing publication list that cite a DENSO patent */
    WITH denso_pubs AS (
        SELECT DISTINCT "publication_number"
        FROM PATENTS.PATENTS.PUBLICATIONS d,
             LATERAL FLATTEN(input => d."assignee_harmonized") fx
        WHERE fx.value:"name" ILIKE '%denso%'
    )
    SELECT DISTINCT citing."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS citing,
         LATERAL FLATTEN(input => citing."citation") c
    JOIN denso_pubs d
          ON c.value:"publication_number"::STRING = d."publication_number"
    WHERE citing."filing_date" > 0
)
SELECT 
    cs."publication_number",
    cp.value:"code"::STRING           AS "first_cpc_code"
FROM citing_set cs
JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON p."publication_number" = cs."publication_number",
     LATERAL FLATTEN(input => p."cpc") cp
WHERE cp.value:"first"::BOOLEAN = TRUE
LIMIT 20;
