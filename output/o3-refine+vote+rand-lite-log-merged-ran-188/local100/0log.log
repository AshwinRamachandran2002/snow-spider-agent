```sql
-- 1. Find Shah Rukh Khan’s record in Person to get his PID
SELECT "PID", "Name"
FROM "Person"
WHERE "Name" LIKE '%Shahrukh%Khan%'            -- try every reasonable spelling
   OR "Name" LIKE '%Shah Rukh%Khan%'
LIMIT 20;
```

```sql
-- 2. All movies in which Shah Rukh Khan appeared
SELECT DISTINCT "MID"
FROM "M_Cast"
WHERE TRIM("PID") IN (
      SELECT TRIM("PID") FROM "Person"
      WHERE "Name" LIKE '%Shahrukh%Khan%'
         OR "Name" LIKE '%Shah Rukh%Khan%')
LIMIT 20;
```

```sql
-- 3. PIDs of actors who acted **with** Shah Rukh Khan (his direct co-stars)
