WHERE  mc1."PID" = (SELECT "PID"
                    FROM "Person"
                    WHERE TRIM("Name") LIKE '%Shah%Rukh%Khan%'
                    LIMIT 1)
  AND  mc2."PID" <> mc1."PID";
```

```sql
-- 6. List every movie featuring any of Shahrukh Khan’s direct co-actors
SELECT DISTINCT mc2."MID"
FROM   "M_Cast" AS mc1       -- Shahrukh’s cast rows
JOIN   "M_Cast" AS mc2       -- rows of his co-actors
       ON mc1."MID" = mc2."MID"
WHERE  mc1."PID" = (SELECT "PID"
                    FROM "Person"
                    WHERE TRIM("Name") LIKE '%Shah%Rukh%Khan%'
                    LIMIT 1)
  AND  mc2."PID" <> mc1."PID"
LIMIT 20;
```

```sql
-- 7. From those movies, collect all *second-degree* actors (could include Shahrukh & direct co-actors)
SELECT DISTINCT mc3."PID"
FROM  ( /* movies of direct co-actors */
        SELECT DISTINCT mc2."MID"
        FROM   "M_Cast" AS mc1
        JOIN   "M_Cast" AS mc2
               ON mc1."MID" = mc2."MID"
        WHERE  mc1."PID" = (SELECT "PID"
                            FROM "Person"
                            WHERE TRIM("Name") LIKE '%Shah%Rukh%Khan%'
                            LIMIT 1)
          AND  mc2."PID" <> mc1."PID"
      ) AS co_movies
JOIN  "M_Cast" AS mc3
      ON co_movies."MID" = mc3."MID"
LIMIT 20;
```

```sql
-- 8. Filter out Shahrukh Khan himself from that list
