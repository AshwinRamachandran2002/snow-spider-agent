      AND TRIM("PID") <> 'nm0451321'
      AND TRIM("PID") NOT IN (SELECT "PID" FROM direct_coactors)
)
SELECT COUNT(DISTINCT "PID") AS shahrukh_number_2
FROM second_deg_actors;
