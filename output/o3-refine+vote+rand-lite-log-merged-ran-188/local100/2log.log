               ON mc1."MID" = mc2."MID"
        WHERE  mc1."PID" = (SELECT "PID"
                            FROM "Person"
                            WHERE TRIM("Name") LIKE '%Shah%Rukh%Khan%'
                            LIMIT 1)
          AND  mc2."PID" <> mc1."PID"
      ) AS co_movies
JOIN  "M_Cast" AS mc3
      ON co_movies."MID" = mc3."MID"
