--Description: (4) Count distinct actors whose Shahrukh-number is 1 (they acted in at least one film with a
-- performer whose name contains “Shahrukh”, “Shah Rukh”, or “Khan”).  We use TRIM on every M_Cast.PID because
-- that column is stored with leading blanks.
SELECT COUNT(DISTINCT TRIM(mc2."PID")) AS degree1_count
FROM   "Person"  AS p1
JOIN   "M_Cast" AS mc1 ON p1."PID" = TRIM(mc1."PID")        -- Shahrukh-like actor’s credits
JOIN   "M_Cast" AS mc2 ON mc1."MID" = mc2."MID"             -- co-actors in the same movie
WHERE  (p1."Name" LIKE '%Shahrukh%'  COLLATE NOCASE
     OR p1."Name" LIKE '%Shah Rukh%' COLLATE NOCASE
     OR p1."Name" LIKE '%Khan%'      COLLATE NOCASE)
  AND  TRIM(mc2."PID") <> p1."PID";
