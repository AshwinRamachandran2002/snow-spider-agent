```sql
--Description: 6. FIFO queue of inventory fragments for every product.
-- Retrieves every individual inventory fragment (inv_id) together with its purchase
-- date and remaining quantity, and ranks them inside each product by (earliest date,
-- then smallest quantity).  This “fifo_rank” will later let us take the very first
-- fragment (rk = 1) for any product.
SELECT  i."id"          AS "inv_id",
        i."product_id",
        pu."purchased"  AS "purchase_date",
        i."qty",
        ROW_NUMBER() OVER (
            PARTITION BY i."product_id"
            ORDER BY pu."purchased", i."qty"
        ) AS "fifo_rank"
FROM    "inventory" AS i
JOIN    "purchases" AS pu  ON pu."id" = i."purchase_id"
ORDER BY i."product_id", "fifo_rank"
LIMIT 20;
```

```sql
--Description: 7. Match each order-line to the very first (rk = 1) FIFO fragment
-- so we can calculate how much of the requirement can be satisfied (“picked_qty”).
WITH fifo AS (
    SELECT  i."id"          AS "inv_id",
            i."product_id",
            i."qty",
            pu."purchased",
            ROW_NUMBER() OVER (
                PARTITION BY i."product_id"
                ORDER BY pu."purchased", i."qty"
            ) AS "rk"
    FROM "inventory" i
    JOIN "purchases" pu ON pu."id" = i."purchase_id"
)
SELECT  ol."id"          AS "orderline_id",
        ol."product_id",
        ol."qty"         AS "required_qty",
        f."inv_id",
        f."qty"          AS "avail_qty",
        MIN(ol."qty", f."qty") AS "picked_qty"
FROM    "orderlines" AS ol
JOIN    fifo          AS f
          ON f."product_id" = ol."product_id"
         AND f."rk" = 1
LIMIT 20;
```

```sql
--Description: 8. Pick-percentage per order-line (picked / required).
-- Builds on the previous CTE to compute the individual fulfilment ratio.
WITH fifo AS (
    SELECT  i."id" AS "inv_id",
            i."product_id",
            i."qty",
            pu."purchased",
            ROW_NUMBER() OVER (
                PARTITION BY i."product_id"
                ORDER BY pu."purchased", i."qty"
            ) AS "rk"
    FROM "inventory" i
    JOIN "purchases" pu ON pu."id" = i."purchase_id"
), match AS (
    SELECT  ol."id"  AS "orderline_id",
            ol."product_id",
            ol."qty" AS "required_qty",
            MIN(ol."qty", f."qty") AS "picked_qty"
    FROM   "orderlines" AS ol
    JOIN   fifo         AS f
             ON f."product_id" = ol."product_id"
            AND f."rk" = 1
)
SELECT  "orderline_id",
        "product_id",
        1.0 * "picked_qty" / "required_qty" AS "pick_pct"
FROM    match
LIMIT 20;
```

```sql
