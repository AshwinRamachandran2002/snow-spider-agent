        i."product_id",
        pu."purchased"  AS "purchase_date",
        i."qty"         AS "qty_left"
FROM    "inventory" AS i
JOIN    "purchases" AS pu  ON pu."id" = i."purchase_id"
ORDER BY i."product_id", pu."purchased", i."qty"
LIMIT 20;
```

```sql
-- 5. Each order-line that triggered a pick together with the ordered quantity
SELECT  pl."id"                       AS "pickline_id",
        pl."order_id",
        ol."product_id",
        ol."qty"                      AS "required_qty"
FROM    "picking_line" AS pl
JOIN    "orderlines"  AS ol ON ol."order_id" = pl."order_id"
                            AND ol."product_id" = pl."product_id"
LIMIT 20;
```

```sql
-- 6. First-in-first-out (FIFO) queue of inventory fragments
SELECT  i."product_id",
        i."id"         AS "inv_id",
        pu."purchased" AS "purchase_date",
        i."qty",
        ROW_NUMBER() OVER (
            PARTITION BY i."product_id"
            ORDER BY pu."purchased", i."qty"
        )              AS "fifo_rank"
FROM    "inventory" AS i
JOIN    "purchases" AS pu ON pu."id" = i."purchase_id"
ORDER BY i."product_id", "fifo_rank"
LIMIT 20;
```

```sql
-- 7. Match every order-requirement to the very first FIFO fragment
WITH fifo AS (
    SELECT  i."id"         AS "inv_id",
            i."product_id",
            i."qty",
            pu."purchased",
            ROW_NUMBER() OVER (
                PARTITION BY i."product_id"
                ORDER BY pu."purchased", i."qty"
            ) AS "rk"
    FROM "inventory" i
    JOIN "purchases" pu ON pu."id" = i."purchase_id"
)
SELECT  ol."id"        AS "orderline_id",
        ol."product_id",
        ol."qty"       AS "required_qty",
        f."inv_id",
        f."qty"        AS "avail_qty",
        MIN(ol."qty", f."qty") AS "picked_qty"   -- overlap
FROM        "orderlines" AS ol
JOIN        fifo         AS f
                 ON f."product_id" = ol."product_id"
                AND f."rk" = 1               -- earliest fragment
LIMIT 20;
```

```sql
-- 8. Pick percentage per order-line (overlap ÷ requirement)
WITH fifo AS (
    SELECT i."id" AS "inv_id",
           i."product_id",
           i."qty",
           pu."purchased",
           ROW_NUMBER() OVER (
               PARTITION BY i."product_id"
               ORDER BY pu."purchased", i."qty"
           ) AS "rk"
    FROM "inventory" i
    JOIN "purchases" pu ON pu."id" = i."purchase_id"
), match AS (
    SELECT  ol."id"  AS "orderline_id",
            ol."product_id",
            ol."qty" AS "required_qty",
            MIN(ol."qty", f."qty") AS "picked_qty"
    FROM   "orderlines" AS ol
    JOIN   fifo         AS f
           ON f."product_id" = ol."product_id"
          AND f."rk" = 1
)
SELECT  "orderline_id",
        "product_id",
        1.0 * "picked_qty" / "required_qty" AS "pick_pct"
FROM    match
LIMIT 20;
```

```sql
-- 9. Average pick percentage grouped by product
WITH fifo AS (
    SELECT i."id" AS "inv_id",
           i."product_id",
           i."qty",
           pu."purchased",
           ROW_NUMBER() OVER (
               PARTITION BY i."product_id"
               ORDER BY pu."purchased", i."qty"
           ) AS "rk"
    FROM "inventory" i
    JOIN "purchases" pu ON pu."id" = i."purchase_id"
), match AS (
    SELECT  ol."id"  AS "orderline_id",
            ol."product_id",
            ol."qty" AS "required_qty",
            MIN(ol."qty", f."qty") AS "picked_qty"
    FROM   "orderlines" AS ol
    JOIN   fifo         AS f
           ON f."product_id" = ol."product_id"
          AND f."rk" = 1
), perc AS (
    SELECT  "product_id",
            1.0 * "picked_qty" / "required_qty" AS "pick_pct"
    FROM    match
)
SELECT  pr."name"                     AS "product_name",
        AVG(perc."pick_pct")          AS "avg_pick_pct"
FROM    perc
JOIN    "products" pr ON pr."id" = perc."product_id"
GROUP BY pr."name"
ORDER BY pr."name"
LIMIT 20;
