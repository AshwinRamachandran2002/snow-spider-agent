```sql
--Description: For every pick-line (picklist_id + line_no) select the ONE inventory
--batch that will be taken first by FIFO (earliest purchase_date, then smallest
--batch-qty).  Shows how much was ordered (pick_qty) vs. what that FIFO batch
--contains (inv_qty).
SELECT
        pl.picklist_id,
        pl.line_no                  AS pickline_no,
        pl.order_id,
        pl.product_id,
        pl.qty                      AS pick_qty,
        i.qty                       AS inv_qty,
        pu.purchased                AS purchase_date
FROM    picking_line AS pl
JOIN    inventory    AS i
       ON  i.location_id = pl.location_id
      AND i.product_id  = pl.product_id
JOIN    purchases    AS pu
       ON  pu.id = i.purchase_id
WHERE   (pu.purchased, i.qty) = (
          SELECT  pu2.purchased, i2.qty
          FROM    inventory  AS i2
          JOIN    purchases  AS pu2
                 ON pu2.id = i2.purchase_id
          WHERE   i2.location_id = pl.location_id
            AND   i2.product_id  = pl.product_id
          ORDER BY pu2.purchased ASC,          -- earliest first
                   i2.qty        ASC           -- then smallest qty
          LIMIT 1
       )
ORDER BY pl.picklist_id, pl.line_no
LIMIT 20;
```

```sql
--Description: For each pick-line, compute the “overlap” (how many units can
--actually be taken from that single FIFO batch).  Displays pick_qty, batch_qty
--and overlap_qty to verify logic.
SELECT
        pl.picklist_id,
        pl.line_no                AS pickline_no,
        pl.product_id,
        pl.qty                    AS pick_qty,
        i.qty                     AS inv_qty,
        MIN(pl.qty, i.qty)        AS overlap_qty
FROM    picking_line AS pl
JOIN    inventory    AS i
       ON  i.location_id = pl.location_id
      AND i.product_id  = pl.product_id
JOIN    purchases    AS pu
       ON  pu.id = i.purchase_id
WHERE   (pu.purchased, i.qty) = (
          SELECT  pu2.purchased, i2.qty
          FROM    inventory  AS i2
          JOIN    purchases  AS pu2
                 ON pu2.id = i2.purchase_id
          WHERE   i2.location_id = pl.location_id
            AND   i2.product_id  = pl.product_id
          ORDER BY pu2.purchased ASC, i2.qty ASC
          LIMIT 1
       )
LIMIT 20;
```

```sql
--Description (FINAL ANSWER): Average pick-percentage per product name.
--For each pick-line we keep only the FIFO-selected batch (earliest date,
--then smallest quantity), compute overlap_qty / inv_qty, and average those
--percentages per product.
WITH fifo AS (
    SELECT
            pl.picklist_id,
            pl.line_no,
            pl.product_id,
            pl.qty                    AS pick_qty,
            i.qty                     AS inv_qty,
            MIN(pl.qty, i.qty)        AS overlap_qty,
            ROW_NUMBER() OVER (
                  PARTITION BY pl.picklist_id, pl.line_no
                  ORDER BY pu.purchased ASC, i.qty ASC
            )                         AS rn
    FROM    picking_line AS pl
    JOIN    inventory    AS i
           ON  i.location_id = pl.location_id
          AND i.product_id  = pl.product_id
    JOIN    purchases    AS pu
           ON  pu.id = i.purchase_id
)
SELECT  pr.name                                            AS product_name,
        AVG(1.0 * fifo.overlap_qty / fifo.inv_qty)         AS avg_pick_percentage
FROM    fifo
JOIN    products AS pr
       ON pr.id = fifo.product_id
WHERE   fifo.rn = 1                 -- only the FIFO batch per pick-line
GROUP BY pr.name
ORDER BY pr.name;
```
