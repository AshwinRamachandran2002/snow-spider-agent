Query:
--Description: For each pick-line, compute the “overlap” (how many units can
--actually be taken from that single FIFO batch).  Displays pick_qty, batch_qty
--and overlap_qty to verify logic.
SELECT
        pl.picklist_id,
        pl.line_no                AS pickline_no,
        pl.product_id,
        pl.qty                    AS pick_qty,
        i.qty                     AS inv_qty,
        MIN(pl.qty, i.qty)        AS overlap_qty
FROM    picking_line AS pl
JOIN    inventory    AS i
       ON  i.location_id = pl.location_id
      AND i.product_id  = pl.product_id
JOIN    purchases    AS pu
       ON  pu.id = i.purchase_id
WHERE   (pu.purchased, i.qty) = (
          SELECT  pu2.purchased, i2.qty
          FROM    inventory  AS i2
          JOIN    purchases  AS pu2
                 ON pu2.id = i2.purchase_id
          WHERE   i2.location_id = pl.location_id
            AND   i2.product_id  = pl.product_id
          ORDER BY pu2.purchased ASC, i2.qty ASC
          LIMIT 1
       )
LIMIT 20
