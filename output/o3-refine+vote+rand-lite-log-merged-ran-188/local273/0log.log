```sql
--Description / thinking process:
--1.  For every pick-line (identified by picklist_id + line_no) we may have several
--    inventory batches in the same location & product.  
--2.  FIFO rule: pick the batch with the earliest purchase_date; if a tie, choose
--    the one with the smaller on-hand qty.  A window ROW_NUMBER() does that ranking.  
--3.  For that single chosen batch we compute the amount that can actually be taken
--    (overlap = MIN(pick_qty, inv_qty)) and divide by inv_qty to get a “pick
--    percentage” for that batch.  
--4.  Finally average those percentages per product name.

SELECT  pr.name                                                  AS product_name,
        AVG(1.0 * chosen.overlap_qty / chosen.inv_qty)           AS avg_pick_percentage
FROM   (
        SELECT  pl.picklist_id,
                pl.line_no,
                pl.product_id,
                pl.qty                      AS pick_qty,
                i.qty                       AS inv_qty,
                MIN(pl.qty, i.qty)          AS overlap_qty,
                ROW_NUMBER() OVER (
                       PARTITION BY pl.picklist_id, pl.line_no
                       ORDER BY pu.purchased ASC, i.qty ASC
                )                            AS rn
        FROM   picking_line AS pl
        JOIN   inventory    AS i
               ON  i.location_id = pl.location_id
              AND i.product_id  = pl.product_id
        JOIN   purchases    AS pu
               ON  pu.id = i.purchase_id
      ) AS chosen
JOIN   products AS pr
       ON pr.id = chosen.product_id
WHERE  chosen.rn = 1              -- keep only the FIFO-selected batch
GROUP BY pr.name
ORDER BY pr.name;
```
