```sql
--Description: bring picking lines together with their matching inventory rows
--so we can see, line-by-line, how much was picked vs. how much was available
SELECT DISTINCT pl.id            AS pickline_id,
                pl.product_id,
                pl.location_id,
                pl.qty           AS picked_qty,
                i.qty            AS inv_qty,
                pu.purchased     AS purchase_date
FROM picking_line AS pl
JOIN inventory    AS i
     ON i.location_id = pl.location_id
    AND i.product_id = pl.product_id
JOIN purchases    AS pu
     ON pu.id = i.purchase_id
ORDER BY pl.id, pu.purchased, i.qty
LIMIT 20;
```

```sql
--Description: for every pickline choose the single inventory batch that would be
--selected first by FIFO (earliest purchase date, then smallest quantity)
SELECT DISTINCT pl.id            AS pickline_id,
                pl.order_id,
                pl.product_id,
                pl.qty           AS picked_qty,
                i.qty            AS inv_qty,
                pu.purchased     AS purchase_date
FROM picking_line AS pl
JOIN inventory    AS i
     ON i.location_id = pl.location_id
    AND i.product_id = pl.product_id
JOIN purchases    AS pu
     ON pu.id = i.purchase_id
WHERE (pu.purchased, i.qty) IN (
      SELECT MIN(pu2.purchased), MIN(i2.qty)
      FROM inventory AS i2
      JOIN purchases AS pu2 ON pu2.id = i2.purchase_id
      WHERE i2.location_id = pl.location_id
        AND i2.product_id  = pl.product_id
)
ORDER BY pl.id
LIMIT 20;
```

```sql
--Description: calculate the overlap quantity (the part of the pick that can truly be
--filled by the chosen FIFO inventory batch) for every pickline
SELECT DISTINCT pl.id                                          AS pickline_id,
                pl.product_id,
                MIN(pl.qty, i.qty)                             AS overlap_qty,   -- actual taken
                pl.qty                                         AS picked_qty,
                i.qty                                          AS inv_qty
FROM picking_line AS pl
JOIN inventory    AS i
     ON i.location_id = pl.location_id
    AND i.product_id = pl.product_id
JOIN purchases    AS pu
     ON pu.id = i.purchase_id
WHERE (pu.purchased, i.qty) IN (
      SELECT MIN(pu2.purchased), MIN(i2.qty)
      FROM inventory AS i2
      JOIN purchases AS pu2 ON pu2.id = i2.purchase_id
      WHERE i2.location_id = pl.location_id
        AND i2.product_id  = pl.product_id
)
LIMIT 20;
```

```sql
--Description (FINAL ANSWER): average pick percentage per product name, using FIFO
--earliest-date+smallest-qty batch per pickline and only the overlapped quantity
SELECT p.name                                                   AS product_name,
       AVG(1.0 * MIN(pl.qty, i.qty) / i.qty)                    AS avg_pick_percentage
FROM picking_line AS pl
JOIN inventory    AS i
     ON i.location_id = pl.location_id
    AND i.product_id = pl.product_id
JOIN purchases    AS pu
     ON pu.id = i.purchase_id
JOIN products     AS p
     ON p.id = pl.product_id
-- keep only the single FIFO batch per pickline
WHERE (pu.purchased, i.qty) IN (
      SELECT MIN(pu2.purchased), MIN(i2.qty)
      FROM inventory AS i2
      JOIN purchases AS pu2 ON pu2.id = i2.purchase_id
      WHERE i2.location_id = pl.location_id
        AND i2.product_id  = pl.product_id
)
GROUP BY p.name
ORDER BY p.name
LIMIT 20;
```
