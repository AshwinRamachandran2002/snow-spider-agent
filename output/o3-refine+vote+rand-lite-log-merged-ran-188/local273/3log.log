-- 8) FIFO sequence for each product: every inventory record with its rank
SELECT DISTINCT i."product_id",
       i."id"                     AS "inv_id",
       pu."purchased",
       i."qty",
       RANK() OVER(
           PARTITION BY i."product_id"
           ORDER BY pu."purchased", i."qty"
       )                          AS "fifo_rank"
FROM   "inventory" AS i
JOIN   "purchases" AS pu  ON pu."id" = i."purchase_id"
