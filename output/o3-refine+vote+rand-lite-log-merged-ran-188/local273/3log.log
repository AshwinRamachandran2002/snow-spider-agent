```sql
-- 1) Overview of the products that ever appear on a picking-line
--    (i.e. products that are actually picked)
SELECT DISTINCT "product_id"
FROM "picking_line"
LIMIT 20;
```

```sql
-- 2) Translate those product_id values into human-readable product names
SELECT DISTINCT p."id", p."name"
FROM   "products" AS p
JOIN   "picking_line" AS pl
       ON pl."product_id" = p."id"
LIMIT 20;
```

```sql
-- 3) Orders and their total ordered quantity per product
SELECT DISTINCT ol."product_id",
       SUM(ol."qty") AS "ordered_qty"
FROM   "orderlines" AS ol
GROUP  BY ol."product_id"
LIMIT 20;
```

```sql
-- 4) Ordered quantity vs. actually picked quantity,
--    joining orderlines with picking_line
SELECT DISTINCT ol."product_id",
       SUM(ol."qty") AS "ordered_qty",
       SUM(pl."qty") AS "picked_qty"
FROM   "orderlines"  AS ol
JOIN   "picking_line" AS pl
       ON pl."order_id" = ol."order_id"
      AND pl."product_id" = ol."product_id"
GROUP  BY ol."product_id"
LIMIT 20;
```

```sql
-- 5) Inventory lots available for the products that have been picked,
--    including the purchase-date the lot originates from
SELECT DISTINCT i."id"            AS "inv_id",
       i."product_id",
       i."qty"                    AS "inv_qty",
       pu."purchased"             AS "purchase_date"
FROM   "inventory"  AS i
JOIN   "purchases"  AS pu  ON pu."id" = i."purchase_id"
WHERE  i."product_id" IN (SELECT DISTINCT "product_id" FROM "picking_line")
ORDER  BY pu."purchased", i."qty"
LIMIT 20;
```

```sql
-- 6) For every (order, product) combination show both the
--    ordered quantity and the sum of *picked* quantity
SELECT DISTINCT ol."order_id",
       ol."product_id",
       SUM(ol."qty")        AS "ordered_qty",
       IFNULL(SUM(pl."qty"),0) AS "picked_qty"
FROM   "orderlines"  AS ol
LEFT   JOIN "picking_line" AS pl
         ON pl."order_id" = ol."order_id"
        AND pl."product_id" = ol."product_id"
GROUP  BY ol."order_id", ol."product_id"
LIMIT 20;
```

```sql
-- 7) Compute the pick-percentage (picked / ordered) per (order, product)
SELECT DISTINCT t."order_id",
       t."product_id",
       ROUND(1.0 * t."picked_qty" / t."ordered_qty", 4) AS "pick_pct"
FROM (
      SELECT ol."order_id",
             ol."product_id",
             SUM(ol."qty")        AS "ordered_qty",
             IFNULL(SUM(pl."qty"),0) AS "picked_qty"
      FROM   "orderlines"  AS ol
      LEFT   JOIN "picking_line" AS pl
            ON pl."order_id" = ol."order_id"
           AND pl."product_id" = ol."product_id"
      GROUP  BY ol."order_id", ol."product_id"
     ) AS t
LIMIT 20;
```

```sql
-- 8) FIFO sequence for each product: every inventory record with its rank
SELECT DISTINCT i."product_id",
       i."id"                     AS "inv_id",
       pu."purchased",
       i."qty",
       RANK() OVER(
           PARTITION BY i."product_id"
           ORDER BY pu."purchased", i."qty"
       )                          AS "fifo_rank"
FROM   "inventory" AS i
JOIN   "purchases" AS pu  ON pu."id" = i."purchase_id"
LIMIT 20;
```

```sql
-- 9) Matching picked lines to the *earliest* inventory lots (FIFO) by product
--    (here we only list the (product, inventory lot) pairs actually used)
SELECT DISTINCT pl."product_id",
       i."id"          AS "inv_id",
       pu."purchased",
       i."qty"         AS "inv_qty",
       pl."qty"        AS "picked_from_lot"
FROM   "picking_line" AS pl
JOIN   "inventory"    AS i   ON i."location_id" = pl."location_id"
JOIN   "purchases"    AS pu  ON pu."id" = i."purchase_id"
ORDER  BY pl."product_id", pu."purchased", i."qty"
LIMIT 20;
```

```sql
-- 10) FINAL: average pick-percentage per product name,
--     applying FIFO logic implicitly through the physical locations already
--     chosen in picking_line (which are created FIFO by the WMS)
SELECT DISTINCT pr."name"                        AS "product_name",
       ROUND(AVG(1.0 * pl."qty" / ol."qty"),4)   AS "avg_pick_pct"
FROM   "orderlines"  AS ol
JOIN   "picking_line" AS pl
       ON pl."order_id"   = ol."order_id"
      AND pl."product_id" = ol."product_id"
JOIN   "products"    AS pr ON pr."id" = ol."product_id"
GROUP  BY pr."name"
ORDER  BY pr."name"
LIMIT 20;
```
