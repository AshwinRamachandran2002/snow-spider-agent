Query:
-- 8. FINAL: average pick-percentage per product name
--    (picked qty ÷ available qty) * 100
SELECT inv."name"                            AS product_name,
       ROUND(
             (COALESCE(pick.total_pick_qty,0) * 100.0)
             / inv.total_inv_qty
       , 2)                                  AS avg_pick_pct
FROM (
        SELECT pr."name",
               SUM(i."qty") AS total_inv_qty
        FROM   "inventory" AS i
        JOIN   "products"  AS pr
               ON pr."id" = i."product_id"
        GROUP  BY pr."name"
     ) AS inv
LEFT JOIN (
        SELECT pr."name",
               SUM(pl."qty") AS total_pick_qty
        FROM   "picking_line" AS pl
        JOIN   "products"     AS pr
               ON pr."id" = pl."product_id"
        GROUP  BY pr."name"
     ) AS pick
       ON pick."name" = inv."name"
ORDER BY inv."name"
LIMIT 20;
