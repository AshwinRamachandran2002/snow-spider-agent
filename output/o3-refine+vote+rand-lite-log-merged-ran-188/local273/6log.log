```sql
-- 1. Inspect which products currently have inventory entries
SELECT DISTINCT "product_id"
FROM "inventory"
LIMIT 20;
```

```sql
-- 2. Look at inventory rows together with their corresponding purchase dates   
SELECT DISTINCT i."product_id",
                p."purchased",
                p."qty"          AS purchase_qty,
                i."qty"          AS inventory_qty
FROM   "inventory" AS i
JOIN   "purchases" AS p
       ON p."id" = i."purchase_id"
ORDER BY p."purchased"
LIMIT 20;
```

```sql
-- 3. Inspect what products actually get picked on picking lines
SELECT DISTINCT "product_id"
FROM   "picking_line"
LIMIT 20;
```

```sql
-- 4. Translate picked product-ids to product names
SELECT DISTINCT pl."product_id",
                pr."name"
FROM   "picking_line" AS pl
JOIN   "products"     AS pr
       ON pr."id" = pl."product_id"
LIMIT 20;
```

```sql
-- 5. Sample detail of each pick line (qty per product & picklist)
SELECT pl."product_id",
       pr."name",
       pl."qty"        AS pick_qty,
       pl."picklist_id"
FROM   "picking_line" AS pl
JOIN   "products"     AS pr
       ON pr."id" = pl."product_id"
LIMIT 20;
```

```sql
-- 6. Total on-hand inventory (FIFO “supply” side) per product name
SELECT pr."name",
       SUM(i."qty")   AS total_inv_qty
FROM   "inventory" AS i
JOIN   "products"  AS pr
       ON pr."id" = i."product_id"
GROUP BY pr."name"
ORDER BY pr."name"
LIMIT 20;
```

```sql
-- 7. Total quantity picked (FIFO “demand” side) per product name
SELECT pr."name",
       SUM(pl."qty") AS total_pick_qty
FROM   "picking_line" AS pl
JOIN   "products"     AS pr
       ON pr."id" = pl."product_id"
GROUP BY pr."name"
ORDER BY pr."name"
LIMIT 20;
```

```sql
-- 8. FINAL: average pick-percentage per product name
--    (picked qty ÷ available qty) * 100
SELECT inv."name"                            AS product_name,
       ROUND(
             (COALESCE(pick.total_pick_qty,0) * 100.0)
             / inv.total_inv_qty
       , 2)                                  AS avg_pick_pct
FROM (
        SELECT pr."name",
               SUM(i."qty") AS total_inv_qty
        FROM   "inventory" AS i
        JOIN   "products"  AS pr
               ON pr."id" = i."product_id"
        GROUP  BY pr."name"
     ) AS inv
LEFT JOIN (
        SELECT pr."name",
               SUM(pl."qty") AS total_pick_qty
        FROM   "picking_line" AS pl
        JOIN   "products"     AS pr
               ON pr."id" = pl."product_id"
        GROUP  BY pr."name"
     ) AS pick
       ON pick."name" = inv."name"
ORDER BY inv."name"
LIMIT 20;
```
