-- 6. Total on-hand inventory (FIFO “supply” side) per product name
SELECT pr."name",
       SUM(i."qty")   AS total_inv_qty
FROM   "inventory" AS i
JOIN   "products"  AS pr
       ON pr."id" = i."product_id"
GROUP BY pr."name"
ORDER BY pr."name"
LIMIT 20;
