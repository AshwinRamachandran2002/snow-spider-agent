```sql
--Description: Return term, rank and DMA for the stored week that is closest to
--exactly one-year-ago from the latest available week (± any drift), ordered by rank.
SELECT "term",
       "rank",
       "dma_name"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "week" = (   /* pick the single stored week nearest to the target date */
        SELECT "week"
        FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
        ORDER BY ABS(DATEDIFF(day,
                              "week",
                              DATEADD(year, -1,
                                      (SELECT MAX("week")
                                       FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
                                       WHERE "refresh_date" = (SELECT MAX("refresh_date")
                                                               FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS)
                                      )
                                     )
                             )) ASC
        LIMIT 1
      )
ORDER BY "rank" ASC
LIMIT 20;
```

