WITH latest_refresh AS (
    SELECT MAX("refresh_date") AS max_refresh
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
),
latest_week AS (
    SELECT MAX("week") AS latest_week
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
    WHERE "refresh_date" = (SELECT max_refresh FROM latest_refresh)
),
target_day AS (
