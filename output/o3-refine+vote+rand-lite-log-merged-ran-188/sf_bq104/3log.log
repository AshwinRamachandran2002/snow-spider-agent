```sql
/* Identify the top-ranked rising search term for the week exactly
   one year prior to the latest available week (using the newest refresh). */

WITH latest_refresh AS (
    SELECT MAX("refresh_date") AS "max_refresh"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
),
latest_week AS (
    SELECT MAX("week") AS "latest_week"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
    WHERE "refresh_date" = (SELECT "max_refresh" FROM latest_refresh)
),
target_week AS (
    SELECT DATEADD(year,-1,"latest_week") AS "week_1yr_ago"
    FROM latest_week
),
best_rank AS (
    SELECT MIN("rank") AS "min_rank"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
    WHERE "week" = (SELECT "week_1yr_ago" FROM target_week)
)
SELECT "term",
       "rank",
       "week"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_RISING_TERMS
WHERE "week" = (SELECT "week_1yr_ago" FROM target_week)
  AND "rank" = (SELECT "min_rank" FROM best_rank)
ORDER BY "percent_gain" DESC NULLS LAST
LIMIT 1;
```
