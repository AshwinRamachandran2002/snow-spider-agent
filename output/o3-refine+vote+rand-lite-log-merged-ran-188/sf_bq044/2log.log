```sql
--Description: 6) Inspect expression values for MDM2 in BLCA RNA-seq release-39  
SELECT
  "sample_barcode",
  "gene_name",
  "tpm_unstranded",
  "fpkm_unstranded"
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"
WHERE "project_short_name" = 'TCGA-BLCA'
  AND "gene_name" = 'MDM2'
LIMIT 20;
```

```sql
--Description: 7) Pull expression for the four downstream genes of interest in BLCA  
SELECT
  "sample_barcode",
  "gene_name",
  "tpm_unstranded",
  "fpkm_unstranded"
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"
WHERE "project_short_name" = 'TCGA-BLCA'
  AND "gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
LIMIT 20;
```

```sql
--Description: 8) Link CDKN2A-mutant cases to expression of the four genes (case barcode derived from sample barcode)  
SELECT DISTINCT
  SUBSTRING(e."sample_barcode",1,12)            AS "case_barcode",
  e."gene_name",
  e."tpm_unstranded",
  e."fpkm_unstranded"
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"                e
JOIN TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39" m
  ON SUBSTRING(e."sample_barcode",1,12) = m."case_barcode"
WHERE m."project_short_name" = 'TCGA-BLCA'
  AND m."Hugo_Symbol" = 'CDKN2A'
  AND e."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
LIMIT 20;
```

```sql
--Description: 9) Combine mutation, clinical, and expression data for final per-patient view  
SELECT
  m."case_barcode",
  m."Variant_Classification",
  m."Variant_Type",
  c."demo__gender",
  c."demo__vital_status",
  c."demo__days_to_death",
  e."gene_name",
  e."tpm_unstranded",
  e."fpkm_unstranded"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"  m
LEFT JOIN TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                 c
  ON m."case_barcode" = c."case_barcode"
LEFT JOIN TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"              e
  ON SUBSTRING(e."sample_barcode",1,12) = m."case_barcode"
  AND e."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
WHERE m."project_short_name" = 'TCGA-BLCA'
  AND m."Hugo_Symbol" = 'CDKN2A'
LIMIT 20;
```

```sql
--Description: 10) Count how many CDKN2A-mutant BLCA patients fall into each mutation class  
SELECT
  m."Variant_Classification",
  COUNT(DISTINCT m."case_barcode") AS "patient_count"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39" m
WHERE m."project_short_name" = 'TCGA-BLCA'
  AND m."Hugo_Symbol" = 'CDKN2A'
GROUP BY m."Variant_Classification"
ORDER BY "patient_count" DESC
LIMIT 20;
```
