--Description: 8) Link CDKN2A-mutant cases to expression of the four downstream genes (case barcode = first 12 chars of sample barcode)  
SELECT DISTINCT
  SUBSTRING(e."sample_barcode",1,12) AS "case_barcode",
  e."project_short_name"             AS "expr_project",
  e."gene_name",
  e."tpm_unstranded",
  e."fpkm_unstranded"
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"                 e
JOIN TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39" m
  ON SUBSTRING(e."sample_barcode",1,12) = m."case_barcode"
WHERE m."Hugo_Symbol" = 'CDKN2A'
  AND e."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
LIMIT 20
