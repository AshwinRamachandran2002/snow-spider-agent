--Description: 2) Retrieve the distinct projects, classes, and types of CDKN2A mutations observed anywhere in the Release-39 masked-somatic table (broader search – no bladder filter)
SELECT DISTINCT
  "project_short_name",
  "Variant_Classification",
  "Variant_Type"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"
WHERE "Hugo_Symbol" = 'CDKN2A'
LIMIT 20
Answer:
project_short_name,Variant_Classification,Variant_Type
TCGA-LUAD,Frame_Shift_Ins,INS
Query:
--Description: 3) List unique patient (case) barcodes – from any project – that carry a CDKN2A mutation  
SELECT DISTINCT
  "project_short_name",
  "case_barcode"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"
WHERE "Hugo_Symbol" = 'CDKN2A'
LIMIT 20
Answer:
project_short_name,case_barcode
TCGA-LUAD,TCGA-55-1594
Query:
--Description: 5) Join ALL CDKN2A-mutant cases to their clinical info using CLINICAL_GDC_R29 (identifier = submitter_id)  
SELECT
  m."case_barcode",
  m."project_short_name",
  m."Variant_Classification",
  m."Variant_Type",
  c."demo__gender",
  c."demo__vital_status",
  c."demo__days_to_death"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39" m
JOIN TCGA.TCGA_VERSIONED."CLINICAL_GDC_R29"                      c
  ON m."case_barcode" = c."submitter_id"
WHERE m."Hugo_Symbol" = 'CDKN2A'
LIMIT 20
Answer:
case_barcode,project_short_name,Variant_Classification,Variant_Type,demo__gender,demo__vital_status,demo__days_to_death
