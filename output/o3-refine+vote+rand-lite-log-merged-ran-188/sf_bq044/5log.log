-- Description: 1) Take a quick look at the first twenty rows of the **clinical
--               release-39** table to see which identifying columns (barcode /
--               case id / submitter id …) are available for joining later on.
SELECT *
FROM TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"
LIMIT 20;
