Query:
-- Description: 3) Retrieve the distinct TCGA projects that harbour
--               CDKN2A alterations in the release-39 mutation table.
--               (Used to make sure “TCGA-BLCA” indeed appears.)
SELECT DISTINCT "project_short_name"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"
WHERE "Hugo_Symbol" ILIKE '%CDKN2A%';
Answer:
project_short_name
TCGA-LUAD
Query:
-- Description: 6)  Join CDKN2A-mutated TCGA-BLCA cases (from the MC3
--                mutation set) to the GDC-R39 clinical table in order to
--                retrieve gender, vital-status and days-to-death.
SELECT  m."project_short_name",
        m."Hugo_Symbol",
        m."Variant_Classification",
        m."Variant_Type",
        m."case_barcode",
        c."demo__gender"       AS "gender",
        c."demo__vital_status" AS "vital_status",
        c."demo__days_to_death"
FROM   TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG19_MC3_2017_02"  m
JOIN   TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                   c
       ON m."case_barcode" = c."submitter_id"
WHERE  m."Hugo_Symbol" = 'CDKN2A'
  AND  m."project_short_name" = 'TCGA-BLCA'
LIMIT 20
Answer:
project_short_name,Hugo_Symbol,Variant_Classification,Variant_Type,case_barcode,gender,vital_status,demo__days_to_death
TCGA-BLCA,CDKN2A,Nonsense_Mutation,SNP,TCGA-DK-A3X1,female,Alive,
TCGA-BLCA,CDKN2A,Nonsense_Mutation,SNP,TCGA-FD-A6TI,male,Dead,294
TCGA-BLCA,CDKN2A,Nonsense_Mutation,INS,TCGA-ZF-A9RD,female,Dead,408
Query:
-- Description: 8)  Obtain TP53 expression (normalized_count) for every RNA-seq
--                sample from TCGA-BLCA that belongs to a case with a CDKN2A
--                mutation (MC3).  Uses the hg19 2017-02 RNA-seq table, which
--                contains sample-level barcodes for the BLCA cohort.
SELECT DISTINCT
       r."case_barcode",
       r."normalized_count" AS "TP53_normalized_expr"
FROM   TCGA.TCGA_VERSIONED."RNASEQ_HG19_GDC_2017_02"            r
JOIN   TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG19_MC3_2017_02"  m
       ON r."case_barcode" = m."case_barcode"
WHERE  m."Hugo_Symbol"  = 'CDKN2A'
  AND  m."project_short_name" = 'TCGA-BLCA'
  AND  r."HGNC_gene_symbol"   = 'TP53'
LIMIT 20
Answer:
case_barcode,TP53_normalized_expr
TCGA-ZF-A9RD,997.319
