```sql
/*  CDKN2A-mutated bladder-cancer patients (TCGA-BLCA)
    – mutation type(s), clinical outcome, and expression of four genes          */

WITH cdkn2a_mut AS (   -- 1) CDKN2A mutations (Masked-Somatic, release-39)
    SELECT
        "case_barcode",
        LISTAGG(DISTINCT "Variant_Classification"||':'||"Variant_Type",
                '; ') WITHIN GROUP (ORDER BY "Variant_Classification","Variant_Type") 
            AS "mutation_types"
    FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"
    WHERE  "project_short_name" = 'TCGA-BLCA'
      AND  "Hugo_Symbol"        = 'CDKN2A'
    GROUP  BY "case_barcode"
),

clinical AS (          -- 2) Clinical information (GDC release-39)
    SELECT
        "submitter_id"       AS "case_barcode",
        "demo__gender"       AS "gender",
        "demo__vital_status" AS "vital_status",
        "demo__days_to_death"
            AS "days_to_death"
    FROM   TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"
),

expr AS (              -- 3) RNA-seq expression for four downstream genes
