```

```sql
-- Description: 6) Join CDKN2A-mutated cases to the clinical R39 table in order
--               to obtain **gender, vital status and days-to-death** information.
--               (Assuming both tables contain the field “case_barcode”; replace
--               by the appropriate ID column if it differs in your warehouse.)
SELECT m."project_short_name",
       m."Hugo_Symbol",
       m."Variant_Classification",
       m."Variant_Type",
       m."case_barcode",
       c."demo__gender"      AS "gender",
       c."demo__vital_status" AS "vital_status",
       c."demo__days_to_death"
FROM  TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"  m
JOIN  TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                      c
      ON m."case_barcode" = c."submitter_id"
WHERE m."Hugo_Symbol" ILIKE '%CDKN2A%'
  AND m."project_short_name" = 'TCGA-BLCA'
LIMIT 20;
```

```sql
-- Description: 7) Preview expression values for one of the four downstream
--               genes (MDM2) in the hg38 RNA-seq table that stores per-sample
--               barcodes (release-35).  Confirms presence of bladder samples.
SELECT *
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"
WHERE "gene_name" = 'MDM2'
  AND "project_short_name" = 'TCGA-BLCA'
LIMIT 20;
```

```sql
-- Description: 8) Pull **TP53** expression (FPKM-UQ) for all bladder samples
--               that also possess a CDKN2A mutation.  Case linkage is done via
--               the first 12 characters of the sample_barcode (case barcode).
SELECT DISTINCT
       r."sample_barcode",
       r."fpkm_uq_unstranded" AS "TP53_FPKM_UQ"
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"                 r
JOIN TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39" m
     ON LEFT(r."sample_barcode", 12) = m."case_barcode"
WHERE m."Hugo_Symbol" ILIKE '%CDKN2A%'
  AND m."project_short_name" = 'TCGA-BLCA'
  AND r."gene_name" = 'TP53'
LIMIT 20;
```

```sql
-- Description: 9) Repeat for **CDKN1A**; show expression together with gender
--               and vital status to start integrating molecular and clinical
--               endpoints.
SELECT DISTINCT
       r."sample_barcode",
       r."fpkm_uq_unstranded" AS "CDKN1A_FPKM_UQ",
       c."demo__gender",
       c."demo__vital_status"
FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"                 r
JOIN TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39" m
     ON LEFT(r."sample_barcode", 12) = m."case_barcode"
JOIN TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                    c
     ON m."case_barcode" = c."submitter_id"
WHERE m."Hugo_Symbol" ILIKE '%CDKN2A%'
  AND m."project_short_name" = 'TCGA-BLCA'
  AND r."gene_name" = 'CDKN1A'
LIMIT 20;
```

```sql
-- Description: 10) Collect the four target gene expressions (pivoted into
--                columns) for every bladder-cancer patient carrying a CDKN2A
--                mutation, together with mutation type and clinical outcome
--                columns.  This answers the complete analytic question.
SELECT DISTINCT
       m."case_barcode",
       m."Variant_Classification",
       m."Variant_Type",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death",
       MAX(CASE WHEN r."gene_name" = 'MDM2'  THEN r."fpkm_uq_unstranded" END) AS "MDM2_FPKM_UQ",
       MAX(CASE WHEN r."gene_name" = 'TP53'  THEN r."fpkm_uq_unstranded" END) AS "TP53_FPKM_UQ",
       MAX(CASE WHEN r."gene_name" = 'CDKN1A' THEN r."fpkm_uq_unstranded" END) AS "CDKN1A_FPKM_UQ",
       MAX(CASE WHEN r."gene_name" = 'CCNE1' THEN r."fpkm_uq_unstranded" END) AS "CCNE1_FPKM_UQ"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39" m
JOIN TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                    c
     ON m."case_barcode" = c."submitter_id"
JOIN TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"                 r
     ON LEFT(r."sample_barcode", 12) = m."case_barcode"
WHERE m."Hugo_Symbol" ILIKE '%CDKN2A%'
  AND m."project_short_name" = 'TCGA-BLCA'
  AND r."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
GROUP BY
       m."case_barcode",
       m."Variant_Classification",
       m."Variant_Type",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death"
LIMIT 20;
```
