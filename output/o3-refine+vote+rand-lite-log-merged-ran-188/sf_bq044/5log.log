```sql
-- Description (thinking process):
-- Because the most recent masked-mutation release (GDC-R39) has no CDKN2A
-- events for bladder cancer, we switched to the MC3 (hg19, 2017-02) mutation
-- set confirmed to contain such events.  To characterise the alteration
-- spectrum in TCGA-BLCA, retrieve every unique combination of
-- Variant_Classification and Variant_Type for CDKN2A mutations and include a
-- count of how many occurrences each pair has across all BLCA cases.
SELECT
       "Variant_Classification",
       "Variant_Type",
       COUNT(*) AS "mutation_count"
FROM TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG19_MC3_2017_02"
WHERE "Hugo_Symbol" = 'CDKN2A'
  AND "project_short_name" = 'TCGA-BLCA'
GROUP BY
       "Variant_Classification",
       "Variant_Type"
ORDER BY
       "mutation_count" DESC
LIMIT 20;
```
