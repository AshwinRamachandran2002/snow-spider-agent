       MAX(CASE WHEN r."gene_name" = 'MDM2'  THEN r."fpkm_uq_unstranded" END) AS "MDM2_FPKM_UQ",
       MAX(CASE WHEN r."gene_name" = 'TP53'  THEN r."fpkm_uq_unstranded" END) AS "TP53_FPKM_UQ",
       MAX(CASE WHEN r."gene_name" = 'CDKN1A' THEN r."fpkm_uq_unstranded" END) AS "CDKN1A_FPKM_UQ",
       MAX(CASE WHEN r."gene_name" = 'CCNE1' THEN r."fpkm_uq_unstranded" END) AS "CCNE1_FPKM_UQ"
FROM   TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG19_MC3_2017_02"  m
JOIN   TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                   c
       ON m."case_barcode" = c."submitter_id"
JOIN   TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"                r
       ON LEFT(r."sample_barcode", 12) = m."case_barcode"
WHERE  m."Hugo_Symbol" = 'CDKN2A'
  AND  m."project_short_name" = 'TCGA-BLCA'
  AND  r."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
GROUP BY
       m."case_barcode",
       m."Variant_Classification",
       m."Variant_Type",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death"
LIMIT 20;
