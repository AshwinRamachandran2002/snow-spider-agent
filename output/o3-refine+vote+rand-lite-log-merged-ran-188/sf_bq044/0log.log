--Description: Retrieve RNA-seq TPM expression values for the four downstream genes
-- (MDM2, TP53, CDKN1A, CCNE1) in the bladder-cancer case(s) that harbor a CDKN2A
-- mutation.  First, obtain the distinct BLCA case_barcode(s) with a CDKN2A mutation
-- (earlier found to include “TCGA-G2-A2ES”), then join to the RNA-seq table on the
-- first 12 characters of the sample_barcode.  The IN list filters the desired genes.
SELECT
       expr."sample_barcode",
       SUBSTR(expr."sample_barcode",1,12) AS "case_barcode",
       expr."gene_name",
       expr."tpm_unstranded"
FROM   TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"  expr
JOIN  ( SELECT DISTINCT m."case_barcode"
        FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R36" m
        WHERE m."project_short_name" = 'TCGA-BLCA'
          AND m."Hugo_Symbol"        = 'CDKN2A' ) mut
  ON  SUBSTR(expr."sample_barcode",1,12) = mut."case_barcode"
WHERE UPPER(expr."gene_name") IN ('MDM2','TP53','CDKN1A','CCNE1')
LIMIT 20;
```
