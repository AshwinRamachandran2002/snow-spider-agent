Some few-shot examples may be useful:
Query:
--Description: 1)  List BLCA (bladder cancer) cases that carry a mutation in the CDKN2A gene  
SELECT DISTINCT 
       m."case_barcode"
FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R36" m
WHERE  m."project_short_name" = 'TCGA-BLCA'
  AND  m."Hugo_Symbol"       = 'CDKN2A'
LIMIT  20;
Answer:
case_barcode
TCGA-G2-A2ES
Query:
--Description: 2)  Show the distinct mutation consequences and mutation types seen in CDKN2A for BLCA  
SELECT DISTINCT 
       m."Variant_Classification",
       m."Variant_Type"
FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R36" m
WHERE  m."project_short_name" = 'TCGA-BLCA'
  AND  m."Hugo_Symbol"       = 'CDKN2A'
LIMIT  20;
Answer:
Variant_Classification,Variant_Type
Splice_Site,SNP
Query:
--Description: 3)  Inspect detailed mutation records for CDKN2A in BLCA  
SELECT 
       m."case_barcode",
       m."Chromosome",
       m."Start_Position",
       m."End_Position",
       m."Variant_Classification",
       m."Variant_Type",
       m."Reference_Allele",
       m."Tumor_Seq_Allele1",
       m."Tumor_Seq_Allele2"
FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R36" m
WHERE  m."project_short_name" = 'TCGA-BLCA'
  AND  m."Hugo_Symbol"       = 'CDKN2A'
LIMIT  20;
Answer:
case_barcode,Chromosome,Start_Position,End_Position,Variant_Classification,Variant_Type,Reference_Allele,Tumor_Seq_Allele1,Tumor_Seq_Allele2
TCGA-G2-A2ES,chr9,21971210,21971210,Splice_Site,SNP,T,T,A
Query:
--Description: 4)  Retrieve gender, vital status and days-to-death for the CDKN2A-mutated BLCA patients  
SELECT 
       c."submitter_id"              AS "case_barcode",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death"
FROM   TCGA.TCGA_VERSIONED."CLINICAL_GDC_R29"                    c
JOIN  (SELECT DISTINCT m."case_barcode"
       FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R36" m
       WHERE  m."project_short_name" = 'TCGA-BLCA'
         AND  m."Hugo_Symbol"       = 'CDKN2A') mut
  ON  c."submitter_id" = mut."case_barcode"
LIMIT  20;
Answer:
case_barcode,demo__gender,demo__vital_status,demo__days_to_death
TCGA-G2-A2ES,male,Dead,1004
