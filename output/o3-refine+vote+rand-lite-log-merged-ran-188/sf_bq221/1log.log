```sql
--Description: Goal – get a non-empty list of publication counts by CPC “group”.
-- Logic / thinking:
--   • FLATTEN the CPC array to individual entries and keep those with "first" = TRUE
--     (the primary CPC for each publication).
--   • Use QUALIFY + ROW_NUMBER() so each publication contributes at most one CPC row.
--   • Normalise the symbol to its group form:
--       ‑ if the code contains a slash (“/”), strip everything after it and append “/00”
--         (e.g. H04L9/0656 → H04L9/00);
--       ‑ if there is no slash, leave the symbol unchanged.
--   • Aggregate counts by this normalised group symbol.
--   • LEFT JOIN to CPC_DEFINITION to fetch a human-readable title when available;
--     do NOT filter on level so we always get data (titles may still be NULL).
WITH primary_cpc AS (
    SELECT  CASE
              WHEN POSITION('/' IN f.value:"code"::STRING) > 0
                   THEN REGEXP_REPLACE(f.value:"code"::STRING, '/.*', '/00')
              ELSE f.value:"code"::STRING
            END AS "group_symbol"
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."cpc") f
    WHERE   p."application_number" IS NOT NULL
      AND   f.value:"first"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY p."publication_number"
                               ORDER BY f.index) = 1
)
SELECT  pc."group_symbol"                           AS "cpc_group",
        COALESCE(d."titleFull", '[title unavailable]') AS "group_title",
        COUNT(*)                                     AS "pub_count"
FROM    primary_cpc pc
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = pc."group_symbol"
GROUP  BY pc."group_symbol", COALESCE(d."titleFull", '[title unavailable]')
ORDER  BY "pub_count" DESC
LIMIT   20;
```
