```sql
--Description: Create a CTE to capture ONE primary (“first”) CPC record per publication
--             then aggregate by the calendar year of the filing date.
--  • FLATTEN turns the CPC JSON array into rows.
--  • Filter where the JSON key "first" is TRUE → primary CPC entries only.
--  • QUALIFY + ROW_NUMBER() guarantees a single CPC row for each publication_number.
--  • The outer SELECT converts the numeric YYYYMMDD filing_date to DATE,
--    extracts the year, and counts publications per year.
WITH primary_cpc AS (
    SELECT  p."filing_date"
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."cpc") f
    WHERE   p."application_number" IS NOT NULL
      AND   p."filing_date"        IS NOT NULL
      AND   f.value:"first"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY p."publication_number"
                               ORDER BY f.index) = 1
)
SELECT  YEAR(TO_DATE("filing_date"::STRING, 'YYYYMMDD')) AS "filing_year",
        COUNT(*)                                         AS "pub_count"
FROM    primary_cpc
GROUP  BY "filing_year"
ORDER  BY "filing_year"
LIMIT   20;
```
