```sql
/* ---------------------------------------------------------------
   CPC level-5 groups with the year of highest
   exponential moving average (α = 0.2) of
   patent filings – Snowflake dialect
---------------------------------------------------------------- */
WITH
/* 1. keep only the first CPC code per publication having
      a valid filing date and an application number            */
first_cpc AS (             -- ❶
    SELECT
        p."publication_number",
        f.value:"code"::STRING                    AS "cpc_code",
        TRY_TO_DATE(p."filing_date"::STRING,'YYYYMMDD') AS filing_dt
    FROM PATENTS.PATENTS.PUBLICATIONS  p
         ,LATERAL FLATTEN(input => p."cpc") f
    WHERE f.value:"first"::BOOLEAN = TRUE
      AND p."application_number" IS NOT NULL
      AND p."filing_date"        IS NOT NULL
      AND TRY_TO_DATE(p."filing_date"::STRING,'YYYYMMDD') IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (PARTITION BY p."publication_number"
                               ORDER BY f.index) = 1
),

/* 2. map the CPC code to its level-5 group
      (first four characters) and count yearly filings          */
year_counts AS (           -- ❷
    SELECT
        SUBSTR("cpc_code",1,4)     AS group_symbol,
        YEAR(filing_dt)            AS yr,
        COUNT(*)                   AS year_count
    FROM first_cpc
    GROUP BY group_symbol , yr
),

/* 3. impose an ordering index within every group               */
ordered AS (                -- ❸
    SELECT
        group_symbol,
        yr,
        year_count,
        ROW_NUMBER() OVER (PARTITION BY group_symbol ORDER BY yr) AS rn
    FROM year_counts
),

/* 4. recursive EMA (α = 0.2) calculation                       */
RECURSIVE ema_calc AS (     -- ❹
    /* anchor: first year of each group */
    SELECT
        group_symbol,
        yr,
        year_count,
        year_count * 0.2              AS ema,
        rn
    FROM ordered
    WHERE rn = 1

    UNION ALL

    /* recursion: later years */
    SELECT
        o.group_symbol,
        o.yr,
        o.year_count,
        0.2 * o.year_count + 0.8 * e.ema  AS ema,
        o.rn
    FROM ema_calc e
    JOIN ordered  o
      ON  o.group_symbol = e.group_symbol
     AND o.rn         = e.rn + 1
),

/* 5. pick the year having the highest EMA for every group      */
best_year AS (             -- ❺
    SELECT
        group_symbol,
        yr          AS best_year,
        ema,
        ROW_NUMBER() OVER (PARTITION BY group_symbol
                           ORDER BY ema DESC, yr ASC) AS rk
    FROM ema_calc
)

/* 6. attach the official CPC title (level = 5) and show result */
SELECT
    b.group_symbol                     AS "cpc_group",
    d."titleFull"                      AS "cpc_title",
    b.best_year                        AS "best_year",
    ROUND(b.ema,4)                     AS "max_ema"
FROM best_year b
JOIN PATENTS.PATENTS.CPC_DEFINITION d
      ON d."symbol" = b.group_symbol
WHERE d."level" = 5
  AND b.rk = 1
ORDER BY b.max_ema DESC NULLS LAST;
```
