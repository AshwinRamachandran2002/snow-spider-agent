```sql
--Description: Use TRY_TO_DATE to safely parse filing dates, discarding rows that convert to NULL.
--             Steps:
--               1) Flatten CPC array; keep entries with "first" = TRUE (primary CPC).
--               2) QUALIFY + ROW_NUMBER() → one primary CPC per publication.
--               3) TRY_TO_DATE converts the numeric YYYYMMDD value; invalid dates become NULL.
--               4) Aggregate the surviving rows by calendar year and count publications.
WITH primary_cpc AS (
    SELECT  TRY_TO_DATE(p."filing_date"::STRING, 'YYYYMMDD') AS filing_dt
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."cpc") f
    WHERE   p."application_number" IS NOT NULL
      AND   p."filing_date"        IS NOT NULL
      AND   p."filing_date"        > 0
      AND   f.value:"first"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY p."publication_number"
                               ORDER BY f.index) = 1
)
SELECT  YEAR(filing_dt) AS "filing_year",
        COUNT(*)        AS "pub_count"
FROM    primary_cpc
WHERE   filing_dt IS NOT NULL              -- drop rows with invalid dates
GROUP  BY "filing_year"
ORDER  BY "filing_year"
LIMIT   20;
```
