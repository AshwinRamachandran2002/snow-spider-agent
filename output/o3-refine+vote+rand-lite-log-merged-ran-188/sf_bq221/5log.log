--Description:
--Goal: verify that PUBLICATIONS actually contains patents whose first CPC code begins with
--“G06F” (computer technology).  In earlier attempts, restricting to the exact 5-character
--group “G06F” returned zero rows—probably because real codes are longer (e.g., G06F1/32).
--Strategy: (1) flatten the “cpc” JSON array; (2) keep only the very first entry (f.index = 0),
--which represents the primary CPC code assigned to the patent; (3) match the first **4**
--characters of that code against “G06F” to include every G06F sub-class; (4) derive the
--filing year by integer-dividing the YYYYMMDD number by 10 000; (5) count filings per year.
--This single query should now return data, proving the filter is not too strict, and will
--serve as a foundation for computing the exponential moving average later on.
SELECT
    FLOOR(p."filing_date" / 10000) AS "filing_year",
    COUNT(*)                       AS "num_filings"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f
WHERE f.index = 0
  AND SUBSTR(f.value:"code"::STRING, 1, 4) = 'G06F'
  AND p."filing_date" > 0
GROUP BY FLOOR(p."filing_date" / 10000)
ORDER BY "filing_year"
LIMIT 20;
