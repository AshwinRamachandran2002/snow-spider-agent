            OVER (ORDER BY p1."filing_year")                        AS "weighted_sum",
        SUM(POWER(1 - 0.2, p1."t" - p2."t"))
            OVER (ORDER BY p1."filing_year")                        AS "weight_div"
    FROM prep p1
    JOIN prep p2
      ON p2."t" <= p1."t"
)
SELECT
    "filing_year",
    "num_filings",
    ROUND("weighted_sum" / NULLIF("weight_div", 0), 2) AS "ema_alpha_0_2"
FROM weights
ORDER BY "filing_year"
LIMIT 20;
```

```sql
--Description: Full workflow to find, for EVERY level-5 CPC group, the year with the
--highest exponential moving average (α = 0.2) of patent filings.  No CPC-specific
--filter is applied, but the earlier “application_number IS NOT NULL” restriction
--is retained (as it should be for the final task).  Only 20 rows of the result are
--shown for inspection.
WITH first_codes AS (
    SELECT
        p."publication_number",
        SUBSTR(f.value:"code"::STRING, 1, 5)  AS "cpc_group_lvl5",
        FLOOR(p."filing_date" / 10000)        AS "filing_year"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE f.index = 0
      AND p."application_number" IS NOT NULL
      AND p."filing_date" > 0
), yearly AS (
    SELECT
        "cpc_group_lvl5",
        "filing_year",
        COUNT(*) AS "num_filings"
    FROM first_codes
    GROUP BY "cpc_group_lvl5", "filing_year"
), enumerated AS (
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY y."cpc_group_lvl5"
                           ORDER BY y."filing_year") - 1 AS "t"
    FROM yearly y
), weights AS (
    SELECT
        p1."cpc_group_lvl5",
        p1."filing_year",
        p1."num_filings",
        SUM(p2."num_filings" * POWER(1 - 0.2, p1."t" - p2."t"))
            OVER (PARTITION BY p1."cpc_group_lvl5", p1."filing_year") AS "w_sum",
        SUM(POWER(1 - 0.2, p1."t" - p2."t"))
            OVER (PARTITION BY p1."cpc_group_lvl5", p1."filing_year") AS "w_div"
    FROM enumerated p1
    JOIN enumerated p2
      ON p1."cpc_group_lvl5" = p2."cpc_group_lvl5"
     AND p2."t" <= p1."t"
), ema AS (
    SELECT
        "cpc_group_lvl5",
        "filing_year",
        ROUND("w_sum" / NULLIF("w_div", 0), 2) AS "ema_0_2"
    FROM weights
), best_year AS (
    SELECT *
    FROM (
        SELECT
            e.*,
            ROW_NUMBER() OVER (PARTITION BY e."cpc_group_lvl5"
                               ORDER BY e."ema_0_2" DESC) AS rnk
        FROM ema e
    )
    WHERE rnk = 1
)
SELECT
    b."cpc_group_lvl5",
    b."filing_year" AS "best_year",
    b."ema_0_2"     AS "max_ema",
    cd."titleFull"
FROM best_year b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
       ON SUBSTR(cd."symbol", 1, 5) = b."cpc_group_lvl5"
ORDER BY b."max_ema" DESC
LIMIT 20;
