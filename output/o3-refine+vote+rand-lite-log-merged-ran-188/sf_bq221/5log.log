Query:
--Description: Derive the exponential moving average (α = 0.2) of yearly filing
--counts for patents whose FIRST CPC code begins with “G06F”.  The comparison
--is now done on the first 4 characters (SUBSTR(...,1,4) = 'G06F') and the
--application-number filter has been removed to avoid empty-result issues.
--Only 20 rows are shown.
WITH yearly AS (
    SELECT
        FLOOR(p."filing_date" / 10000) AS "filing_year",
        COUNT(*)                       AS "num_filings"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE f.index = 0
      AND SUBSTR(f.value:"code"::STRING, 1, 4) = 'G06F'
      AND p."filing_date" > 0
    GROUP BY FLOOR(p."filing_date" / 10000)
), prep AS (
    SELECT
        y.*,
        ROW_NUMBER() OVER (ORDER BY y."filing_year") - 1 AS "t"   -- 0,1,2,… for weighting
    FROM yearly y
), weights AS (
    SELECT
        p1."filing_year",
        p1."num_filings",
        SUM(p2."num_filings" * POWER(1 - 0.2, p1."t" - p2."t"))
            OVER (ORDER BY p1."filing_year")                        AS "weighted_sum",
        SUM(POWER(1 - 0.2, p1."t" - p2."t"))
            OVER (ORDER BY p1."filing_year")                        AS "weight_div"
    FROM prep p1
    JOIN prep p2
      ON p2."t" <= p1."t"
)
SELECT
    "filing_year",
    "num_filings",
    ROUND("weighted_sum" / NULLIF("weight_div", 0), 2) AS "ema_alpha_0_2"
FROM weights
ORDER BY "filing_year"
LIMIT 20
