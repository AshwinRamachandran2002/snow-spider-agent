```sql
--Description: Join the level-5 CPC group with CPC_DEFINITION to fetch the full CPC title. 
--We match on the first five characters of the CPC symbol.
SELECT DISTINCT 
    cg."cpc_group_lvl5",
    cd."symbol",
    cd."titleFull"
FROM (
    SELECT DISTINCT SUBSTR(f.value:"code"::STRING,1,5) AS "cpc_group_lvl5"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE f.index = 0
) cg
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
       ON SUBSTR(cd."symbol",1,5) = cg."cpc_group_lvl5"
LIMIT 20;
