```sql
--Description:
--Find, for each CPC level-5 group (first 5 characters of the first CPC code), the year
--with the highest exponential moving average (EMA, α = 0.2) of patent-filing counts.
--Pipeline:
-- 1) first_codes  : one row per publication with its first CPC group and filing year.
-- 2) yearly       : count filings per (group, year).
-- 3) enumerated   : give each (group, year) a sequential index “t”.
-- 4) ema_calc     : compute EMA for every (group, year) via weighted sums.
-- 5) best_year    : pick the year where EMA is maximal for each group.
-- 6) final SELECT : attach CPC title and list the top 20 groups by their peak EMA.
WITH first_codes AS (
    SELECT
        SUBSTR(f.value:"code"::STRING, 1, 5)   AS cpc_group_lvl5,
        FLOOR(p."filing_date" / 10000)         AS filing_year
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE f.index = 0                       -- only the first CPC code
      AND p."application_number" IS NOT NULL
      AND p."filing_date" > 0
), yearly AS (
    SELECT
        cpc_group_lvl5,
        filing_year,
        COUNT(*) AS num_filings
    FROM first_codes
    GROUP BY cpc_group_lvl5, filing_year
), enumerated AS (
    SELECT
        y.*,
        ROW_NUMBER() OVER (PARTITION BY y.cpc_group_lvl5
                           ORDER BY y.filing_year) - 1 AS t
    FROM yearly y
), ema_calc AS (
    SELECT
        p1.cpc_group_lvl5,
        p1.filing_year,
        ROUND(
            SUM(p2.num_filings * POWER(1 - 0.2, p1.t - p2.t))
            / NULLIF(SUM(POWER(1 - 0.2, p1.t - p2.t)), 0), 2
        ) AS ema_0_2
    FROM enumerated p1
    JOIN enumerated p2
      ON p1.cpc_group_lvl5 = p2.cpc_group_lvl5
     AND p2.t <= p1.t
    GROUP BY p1.cpc_group_lvl5, p1.filing_year
), best_year AS (
    SELECT
        cpc_group_lvl5,
        filing_year,
        ema_0_2,
        ROW_NUMBER() OVER (PARTITION BY cpc_group_lvl5
                           ORDER BY ema_0_2 DESC) AS rnk
    FROM ema_calc
)
SELECT
    b.cpc_group_lvl5,
    b.filing_year      AS best_year,
    b.ema_0_2          AS max_ema,
    cd."titleFull"
FROM best_year b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
       ON SUBSTR(cd."symbol", 1, 5) = b.cpc_group_lvl5
WHERE b.rnk = 1
ORDER BY max_ema DESC
LIMIT 20;
```
