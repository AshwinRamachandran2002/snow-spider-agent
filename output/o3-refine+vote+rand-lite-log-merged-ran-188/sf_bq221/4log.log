--Description:  Find, for every CPC technology area defined at level-5, the year in
--              which its exponential moving average (EMA, α = 0.2) of patent
--              filings reaches its maximum.  Steps:
--              1) first_cpc     – grab the first CPC code of each patent plus year.
--              2) yearly_counts – count filings per CPC×year.
--              3) ordered       – add a sequential row number within each CPC.
--              4) ema_calc      – recursive EMA:  EMA₁ = count₁;
--                                   EMAₜ = 0.2*countₜ + 0.8*EMAₜ₋₁.
--              5) best          – pick the year with the highest EMA per CPC.
--              6) Join to CPC_DEFINITION, keep only level-5 groups, show results.

WITH
/* 1) first CPC code, filing year */
first_cpc AS (
    SELECT
        c.value:"code"::STRING                 AS "first_cpc_code",
        FLOOR(p."filing_date" / 10000)         AS "year"
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE c.index = 0
      AND p."application_number" IS NOT NULL
      AND p."filing_date" IS NOT NULL
),
/* 2) yearly filing counts per CPC */
yearly_counts AS (
    SELECT
        "first_cpc_code",
        "year",
        COUNT(*) AS "filing_count"
    FROM first_cpc
    GROUP BY "first_cpc_code", "year"
),
/* 3) chronological row number inside each CPC */
ordered AS (
    SELECT
        "first_cpc_code",
        "year",
        "filing_count",
        ROW_NUMBER() OVER (
            PARTITION BY "first_cpc_code"
            ORDER BY "year"
        ) AS rn
    FROM yearly_counts
),
/* 4) recursive EMA computation per CPC */
RECURSIVE ema_calc (first_cpc_code, rn, year, filing_count, ema) AS (
    -- anchor: earliest year for each CPC
    SELECT
        "first_cpc_code",
        rn,
        "year",
        "filing_count",
        CAST("filing_count" AS FLOAT) AS ema
    FROM ordered
    WHERE rn = 1
    UNION ALL
    -- recursion: later years
    SELECT
        o."first_cpc_code",
        o.rn,
        o."year",
        o."filing_count",
        0.2 * o."filing_count" + 0.8 * e.ema AS ema
    FROM ema_calc e
    JOIN ordered  o
      ON  o."first_cpc_code" = e."first_cpc_code"
      AND o.rn = e.rn + 1
),
/* 5) best year (highest EMA) for each CPC */
best AS (
    SELECT
        first_cpc_code,
        year,
        ema,
        ROW_NUMBER() OVER (
            PARTITION BY first_cpc_code
            ORDER BY ema DESC
        ) AS rn_best
    FROM ema_calc
)
/* 6) attach CPC level-5 title and output */
SELECT
    b.first_cpc_code            AS "cpc_symbol",
    d."titleFull"               AS "cpc_title",
    b.year                      AS "best_year",
    ROUND(b.ema, 2)             AS "max_ema"
FROM best b
JOIN PATENTS.PATENTS."CPC_DEFINITION" d
  ON b.first_cpc_code = d."symbol"
WHERE b.rn_best = 1
  AND d."level" = 5
LIMIT 20;
