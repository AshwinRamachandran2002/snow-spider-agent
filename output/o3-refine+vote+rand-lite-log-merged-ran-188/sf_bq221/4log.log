```sql
--Description:  Compute the exponential moving average (EMA, α = 0.2) of yearly
--              patent-filing counts for CPC symbol ‘G01N35/026’.
--              Thinking process (embedded):
--              1) yearly   – aggregate filings per calendar year.
--              2) ordered  – assign a chronological row number (rn).
--              3) ema_calc – recursive CTE using  EMA_t = 0.2*count_t + 0.8*EMA_{t-1}.
--              4) Final output lists year, count, and EMA rounded to 2 decimals.

WITH RECURSIVE
/* 1) Yearly filing counts */
yearly AS (
    SELECT
        FLOOR(p."filing_date" / 10000) AS "year",
        COUNT(*)                       AS "filing_count"
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(INPUT => p."cpc") c
    WHERE c.index = 0
      AND c.value:"code"::STRING = 'G01N35/026'   -- target CPC
      AND p."application_number" IS NOT NULL
