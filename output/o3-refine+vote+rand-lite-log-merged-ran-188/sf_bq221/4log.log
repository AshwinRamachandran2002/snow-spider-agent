Query:
--Description: Count yearly patent filings (simple family count) for a sample CPC group
SELECT 
  FLOOR(p."filing_date" / 10000) AS "year",
  COUNT(*)                       AS "patent_count"
FROM PATENTS.PATENTS."PUBLICATIONS" p,
     LATERAL FLATTEN(input => p."cpc") c
WHERE c.index = 0
  AND c.value:"code"::STRING = 'H04L9/08'   --sample CPC symbol
  AND p."application_number" IS NOT NULL
  AND p."filing_date" IS NOT NULL
GROUP BY FLOOR(p."filing_date" / 10000)
ORDER BY "year"
LIMIT 20;
