```sql
--Description:  Compute, for each level-5 CPC technology area, the calendar year in
--              which its exponential moving average (EMA, α = 0.2) of patent filings
--              attains its peak.  Steps executed in successive CTEs:
--              1) first_cpc   – extract first CPC code (index 0) and filing year for
--                               every patent with valid filing date & application No.
--              2) yearly_cnt  – count filings for each CPC×year pair.
--              3) ordered     – assign chronological row numbers within each CPC group.
--              4) ema_calc    – recursive computation of EMA per CPC
--                               (EMA₁ = count₁;  EMAₜ = 0.2·countₜ + 0.8·EMAₜ₋₁).
--              5) best        – pick the year having the highest EMA for every CPC.
--              6) Join with CPC_DEFINITION, keep only level-5 groups, and present the
--                 CPC symbol, full title, best year, and max EMA (rounded).  Limited
--                 to 20 rows for preview.

WITH RECURSIVE
/* 1) First CPC code & filing year per patent */
first_cpc AS (
    SELECT
        c.value:"code"::STRING          AS first_cpc_code,
        FLOOR(p."filing_date" / 10000)  AS year
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE c.index = 0
      AND p."application_number" IS NOT NULL
      AND p."filing_date" IS NOT NULL
),
/* 2) Year-by-year filing counts per CPC */
yearly_cnt AS (
    SELECT
        first_cpc_code,
        year,
        COUNT(*) AS filing_count
    FROM first_cpc
    GROUP BY first_cpc_code, year
),
/* 3) Chronological index inside each CPC */
ordered AS (
    SELECT
        first_cpc_code,
        year,
        filing_count,
        ROW_NUMBER() OVER (PARTITION BY first_cpc_code ORDER BY year) AS rn
    FROM yearly_cnt
),
/* 4) Recursive EMA calculation */
ema_calc (first_cpc_code, rn, year, filing_count, ema) AS (
    -- Base case: earliest year (rn = 1)
    SELECT
        first_cpc_code,
        rn,
        year,
        filing_count,
        CAST(filing_count AS FLOAT)                       -- EMA₁
    FROM ordered
    WHERE rn = 1
    UNION ALL
    -- Recursive step: subsequent years
    SELECT
        o.first_cpc_code,
        o.rn,
        o.year,
        o.filing_count,
        0.2 * o.filing_count + 0.8 * e.ema               -- EMA formula
    FROM ema_calc e
    JOIN ordered o
      ON o.first_cpc_code = e.first_cpc_code
     AND o.rn = e.rn + 1
),
/* 5) Identify best-year (max EMA) for each CPC */
best AS (
    SELECT
        first_cpc_code,
        year,
        ema,
        ROW_NUMBER() OVER (
            PARTITION BY first_cpc_code
            ORDER BY ema DESC
        ) AS rn_best
    FROM ema_calc
)
/* 6) Attach CPC level-5 definition & output */
SELECT
    b.first_cpc_code        AS cpc_symbol,
    d."titleFull"           AS cpc_title,
    b.year                  AS best_year,
    ROUND(b.ema, 2)         AS max_ema
FROM best b
JOIN PATENTS.PATENTS."CPC_DEFINITION" d
  ON b.first_cpc_code = d."symbol"
WHERE b.rn_best = 1
  AND d."level" = 5
LIMIT 20;
