```sql
/*  Identify, for every level-5 CPC technology area (sub-class),
    the calendar year in which its exponential moving average (EMA)
    of patent filings (α = 0.2) reaches the maximum value.
    Only the first CPC symbol of each patent with a valid filing date
    and application number is considered.                                               */

WITH
/* ------------------------------------------------------------------ */
/* 1. Keep only the first CPC code of each patent + filing year        */
first_cpc AS (                       -- about 150 M rows → strongly reduced
    SELECT
        /* level-5 CPC symbol = one section-letter, two digits, one subclass-letter */
        REGEXP_SUBSTR
            ( c.value : "code" :: STRING , '^[A-Z][0-9]{2}[A-Z]' )   AS "symbol",
        FLOOR( p."filing_date" / 10000 )                             AS "year"
    FROM PATENTS.PATENTS."PUBLICATIONS"  p ,
         LATERAL FLATTEN( INPUT => p."cpc") c
    WHERE c.index                         = 0
      AND p."application_number"          IS NOT NULL
      AND p."filing_date"                 IS NOT NULL
      AND c.value : "code"                IS NOT NULL
),

/* ------------------------------------------------------------------ */
/* 2. Yearly filing counts per CPC level-5 symbol                      */
yearly_counts AS (
    SELECT
        "symbol",
        "year",
        COUNT(*)                       AS "filing_count"
    FROM first_cpc
    GROUP BY "symbol", "year"
),

/* ------------------------------------------------------------------ */
/* 3. Ensure deterministic order within each CPC time-series           */
ordered_counts AS (
    SELECT
        "symbol",
        "year",
        "filing_count",
        ROW_NUMBER() OVER (PARTITION BY "symbol" ORDER BY "year") AS "rn"
    FROM yearly_counts
),

/* ------------------------------------------------------------------ */
/* 4. Recursive EMA calculation (α = 0.20)                             */
RECURSIVE ema_calc AS (
      /* 4a. seed — earliest year for each CPC                           */
      SELECT
          "symbol",
          "year",
          "filing_count",
          "rn",
          CAST("filing_count" AS FLOAT)          AS "ema"
      FROM ordered_counts
      WHERE "rn" = 1

      UNION ALL

      /* 4b. forward recursion                                            */
      SELECT
          o."symbol",
          o."year",
          o."filing_count",
          o."rn",
          0.20 * o."filing_count" + 0.80 * e."ema"  AS "ema"
      FROM ema_calc        e
      JOIN ordered_counts  o
        ON  o."symbol" = e."symbol"
       AND o."rn"      = e."rn" + 1
),

/* ------------------------------------------------------------------ */
/* 5. Pick, for each CPC, the year where EMA attains its maximum       */
best_rows AS (
    SELECT
        "symbol",
        "year"      AS "best_year",
        "ema"       AS "highest_ema",
        ROW_NUMBER() OVER (PARTITION BY "symbol"
                           ORDER BY "ema" DESC)  AS "rank_in_cpc"
    FROM ema_calc
),
best_year AS (
    SELECT
        "symbol",
        "best_year",
        "highest_ema"
    FROM best_rows
    WHERE "rank_in_cpc" = 1
)

/* ------------------------------------------------------------------ */
/* 6. Attach human-readable CPC titles (level = 5) and return results  */
SELECT
    b."symbol"                                 AS "cpc_symbol",
    d."titleFull"                              AS "cpc_title",
    b."best_year",
    ROUND(b."highest_ema", 4)                  AS "highest_ema"
FROM best_year            b
LEFT JOIN PATENTS.PATENTS."CPC_DEFINITION" d
       ON d."symbol" = b."symbol"  AND d."level" = 5
ORDER BY b."highest_ema" DESC NULLS LAST;
```
