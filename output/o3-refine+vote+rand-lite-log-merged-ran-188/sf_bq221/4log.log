```sql
--Description: Compute exponential moving average (α = 0.2) of yearly filings for one CPC symbol using window functions
WITH yearly AS (
  SELECT 
    FLOOR(p."filing_date" / 10000)               AS "year",
    COUNT(*)                                     AS "filing_count"
  FROM PATENTS.PATENTS."PUBLICATIONS" p,
       LATERAL FLATTEN(input => p."cpc") c
  WHERE c.index = 0
    AND c.value:"code"::STRING = 'G01N35/026'    --sample CPC
    AND p."application_number" IS NOT NULL
    AND p."filing_date" IS NOT NULL
  GROUP BY FLOOR(p."filing_date" / 10000)
)
SELECT 
  "year",
  "filing_count",
  -- Exponential moving average with α = 0.2
  ROUND(
    SUM("filing_count" * POWER(1 - 0.2, ROW_NUMBER() OVER (ORDER BY "year" DESC) - 1))
      OVER (ORDER BY "year" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),
    2
  ) AS "ema_alpha_0_2"
FROM yearly
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: Pull the best (highest-EMA) year for every level-5 CPC group (framework query – heavy, preview limited)
WITH first_cpc AS (
  SELECT 
    p."publication_number",
    FLOOR(p."filing_date" / 10000)       AS "year",
    c.value:"code"::STRING               AS "first_cpc_code"
  FROM PATENTS.PATENTS."PUBLICATIONS" p,
       LATERAL FLATTEN(input => p."cpc") c
  WHERE c.index = 0
    AND p."application_number" IS NOT NULL
    AND p."filing_date" IS NOT NULL
), yearly_counts AS (
  SELECT 
    "first_cpc_code",
    "year",
    COUNT(*) AS "filing_count"
  FROM first_cpc
  GROUP BY "first_cpc_code", "year"
), ema_calc AS (
  SELECT 
    "first_cpc_code",
    "year",
    "filing_count",
    -- EMA α = 0.2 via recursive formula inside window
    SUM("filing_count" * POWER(1 - 0.2, ROW_NUMBER() OVER (PARTITION BY "first_cpc_code" ORDER BY "year" DESC) - 1))
      OVER (PARTITION BY "first_cpc_code" ORDER BY "year") AS "ema"
  FROM yearly_counts
)
SELECT 
  e."first_cpc_code",
  d."titleFull",
  e."year"               AS "best_year",
  e."ema"                AS "max_ema"
FROM (
  SELECT 
    "first_cpc_code",
    "year",
    "ema",
    ROW_NUMBER() OVER (PARTITION BY "first_cpc_code" ORDER BY "ema" DESC) AS rn
  FROM ema_calc
) e
LEFT JOIN PATENTS.PATENTS."CPC_DEFINITION" d
  ON e."first_cpc_code" = d."symbol"
WHERE e.rn = 1
LIMIT 20;
```
