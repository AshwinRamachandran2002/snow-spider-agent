--Description:  Objective ‑ For every CPC “sub-class” (first four characters of the
--              first CPC code attached to a patent), identify the calendar year in
--              which its exponential moving average (EMA, α = 0.2) of patent filings
--              is the highest.  Reasoning pathway:
--              • first_cpc   → grab the first CPC code (index 0) + filing year (YYYY).
--              • yearly_cnt  → aggregate filings per cpc_sub × year.
--              • ordered     → assign a row sequence (rn) by ascending year inside
--                               each cpc_sub so we can walk through time.
--              • ema_calc    → recursive CTE computes EMA per cpc_sub using
--                               EMA₁ = count₁ and EMAₜ = 0.2·countₜ + 0.8·EMAₜ₋₁.
--              • best        → pick the row where EMA is maximal for that cpc_sub.
--              • LEFT JOIN   → attach a human-readable CPC title when available
--                               (CPC_DEFINITION); rows remain even if title absent.
--              Result sample limited to 20 rows.

WITH RECURSIVE
/* first CPC symbol (4-char sub-class) + filing year for each patent */
first_cpc AS (
    SELECT
        SUBSTR(c.value:"code"::STRING, 1, 4) AS cpc_sub,
        FLOOR(p."filing_date" / 10000)       AS year
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(INPUT => p."cpc") c
    WHERE c.index = 0
      AND p."application_number" IS NOT NULL
      AND p."filing_date"       IS NOT NULL
),
/* count filings per cpc_sub and year */
yearly_cnt AS (
    SELECT
        cpc_sub,
        year,
        COUNT(*) AS filing_count
    FROM first_cpc
    GROUP BY cpc_sub, year
),
/* chronological ordering within each cpc_sub */
ordered AS (
    SELECT
        cpc_sub,
        year,
        filing_count,
        ROW_NUMBER() OVER (PARTITION BY cpc_sub ORDER BY year) AS rn
    FROM yearly_cnt
),
/* recursive EMA calculation */
ema_calc (cpc_sub, rn, year, filing_count, ema) AS (
    -- base year (rn = 1)
    SELECT
        cpc_sub,
        rn,
        year,
        filing_count,
        filing_count::FLOAT                       -- EMA₁
    FROM ordered
    WHERE rn = 1
    UNION ALL
    -- subsequent years
    SELECT
        o.cpc_sub,
        o.rn,
        o.year,
        o.filing_count,
        0.2 * o.filing_count + 0.8 * e.ema        -- EMA formula
    FROM ema_calc e
    JOIN ordered  o
      ON o.cpc_sub = e.cpc_sub
     AND o.rn      = e.rn + 1
),
/* choose the max-EMA year for each cpc_sub */
best AS (
    SELECT
        cpc_sub,
        year,
        ema,
        ROW_NUMBER() OVER (PARTITION BY cpc_sub ORDER BY ema DESC) AS rn_best
    FROM ema_calc
)
/* output + optional CPC title */
SELECT
    b.cpc_sub                     AS cpc_symbol,
    d."titleFull"                 AS cpc_title,
    b.year                        AS best_year,
    ROUND(b.ema, 2)               AS max_ema
FROM best b
LEFT JOIN PATENTS.PATENTS."CPC_DEFINITION" d
  ON b.cpc_sub = d."symbol"
WHERE b.rn_best = 1
LIMIT 20;
