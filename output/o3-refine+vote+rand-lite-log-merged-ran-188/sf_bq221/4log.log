```sql
--Description:  Goal is to compute an exponential moving average (EMA) with α = 0.2
--              for yearly patent-filing counts of CPC symbol ‘G01N35/026’.
-- Thinking process in-line:
--   • First CTE (yearly) aggregates counts by year.
--   • Second CTE (ordered) assigns a sequential row number so we can step year-by-year.
--   • Recursive CTE (ema_calc) starts at the earliest year, then for each next year
--     applies  EMAt = 0.2 * countt + 0.8 * EMA{t-1}.
--   • Final SELECT shows the year, raw count, and EMA rounded to 2 decimals.

WITH yearly AS (                               -- aggregate counts (step-1)
    SELECT
        FLOOR(p."filing_date" / 10000) AS "year",
        COUNT(*)                       AS "filing_count"
    FROM PATENTS.PATENTS."PUBLICATIONS" p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE c.index = 0
      AND c.value:"code"::STRING = 'G01N35/026'  -- chosen CPC
      AND p."application_number" IS NOT NULL
      AND p."filing_date" IS NOT NULL
    GROUP BY FLOOR(p."filing_date" / 10000)
), ordered AS (                                -- chronological index (step-2)
    SELECT
        "year",
        "filing_count",
        ROW_NUMBER() OVER (ORDER BY "year") AS rn
    FROM yearly
), RECURSIVE ema_calc AS (                     -- recursive EMA (step-3)
    -- anchor row = earliest year
    SELECT
        "year",
        "filing_count",
        rn,
        CAST("filing_count" AS FLOAT) AS ema
    FROM ordered
    WHERE rn = 1
    UNION ALL
    -- induction rows = later years
    SELECT
        o."year",
        o."filing_count",
        o.rn,
        0.2 * o."filing_count" + 0.8 * e.ema AS ema
    FROM ema_calc e
    JOIN ordered  o
      ON o.rn = e.rn + 1
)
SELECT
    "year",
    "filing_count",
    ROUND(ema, 2) AS "ema_alpha_0_2"
FROM ema_calc
ORDER BY "year"
LIMIT 20;
```
