--Description: View daily ordered and shipped units and revenues for 'Manufacturing' distributor_view in the 30-day look-back period prior to 2022-02-06.
SELECT 
    "DATE",
    "ASIN",
    "ORDERED_UNITS",
    "ORDERED_REVENUE",
    "SHIPPED_UNITS",
    "SHIPPED_REVENUE"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"
WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND "DATE" >= '2022-01-07' 
  AND "DATE" < '2022-02-06'
LIMIT 20;
