Query:
--Description: Compute daily conversion rate (ordered_units / glance_views) by joining sales and traffic.
SELECT
    s."DATE",
    s."ASIN",
    s."ORDERED_UNITS",
    t."GLANCE_VIEWS",
    CASE WHEN t."GLANCE_VIEWS" > 0 THEN s."ORDERED_UNITS" / t."GLANCE_VIEWS" ELSE NULL END AS "CONVERSION_RATE"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"     s
JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC"   t
  ON s."DATE" = t."DATE"
 AND s."ASIN" = t."ASIN"
 AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" >= '2022-01-07'
  AND s."DATE" < '2022-02-06'
LIMIT 20;
Answer:
DATE,ASIN,ORDERED_UNITS,GLANCE_VIEWS,CONVERSION_RATE
