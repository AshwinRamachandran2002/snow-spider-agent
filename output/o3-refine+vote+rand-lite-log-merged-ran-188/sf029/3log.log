```sql
--Description: Compute daily conversion rate (ordered_units / glance_views) by joining sales and traffic.
SELECT
    s."DATE",
    s."ASIN",
    s."ORDERED_UNITS",
    t."GLANCE_VIEWS",
    CASE WHEN t."GLANCE_VIEWS" > 0 THEN s."ORDERED_UNITS" / t."GLANCE_VIEWS" ELSE NULL END AS "CONVERSION_RATE"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"     s
JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC"   t
  ON s."DATE" = t."DATE"
 AND s."ASIN" = t."ASIN"
 AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" >= '2022-01-07'
  AND s."DATE" < '2022-02-06'
LIMIT 20;
```

```sql
--Description: Join sales and inventory to examine on-hand units alongside average selling price.
SELECT
    s."DATE",
    s."ASIN",
    s."ORDERED_REVENUE",
    s."ORDERED_UNITS",
    CASE WHEN s."ORDERED_UNITS" > 0 THEN s."ORDERED_REVENUE" / s."ORDERED_UNITS" END AS "AVG_SELLING_PRICE",
    i."SELLABLE_ON_HAND_UNITS",
    i."UNSELLABLE_ON_HAND_UNITS"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"      s
JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_INVENTORY"  i
  ON s."DATE" = i."DATE"
 AND s."ASIN" = i."ASIN"
 AND s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" >= '2022-01-07'
  AND s."DATE" < '2022-02-06'
LIMIT 20;
```

```sql
--Description: Preview combined daily metrics across sales, traffic, inventory and net PPM.
SELECT
    s."DATE",
    s."ASIN",
    s."ORDERED_UNITS",
    s."ORDERED_REVENUE",
    t."GLANCE_VIEWS",
    p."NET_PPM",
    i."PROCURABLE_PRODUCT_OOS"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"      s
LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC" t
    ON s."DATE" = t."DATE" AND s."ASIN" = t."ASIN" AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_NET_PPM" p
    ON s."DATE" = p."DATE" AND s."ASIN" = p."ASIN" AND s."DISTRIBUTOR_VIEW" = p."DISTRIBUTOR_VIEW"
LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_INVENTORY" i
    ON s."DATE" = i."DATE" AND s."ASIN" = i."ASIN" AND s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" >= '2022-01-07'
  AND s."DATE" < '2022-02-06'
LIMIT 20;
```

```sql
--Description: Aggregate requested KPIs per ASIN per day across the 30-day window.
SELECT
    s."DATE",
    s."ASIN",
    SUM(s."ORDERED_UNITS") AS "TOTAL_ORDERED_UNITS",
    SUM(s."ORDERED_REVENUE") AS "TOTAL_ORDERED_REVENUE",
    AVG(CASE WHEN s."ORDERED_UNITS" > 0 THEN s."ORDERED_REVENUE" / s."ORDERED_UNITS" END) AS "AVG_SELLING_PRICE",
    SUM(t."GLANCE_VIEWS") AS "GLANCE_VIEWS",
    AVG(CASE WHEN t."GLANCE_VIEWS" > 0 THEN s."ORDERED_UNITS" / t."GLANCE_VIEWS" END) AS "CONVERSION_RATE",
    SUM(s."SHIPPED_UNITS") AS "SHIPPED_UNITS",
    SUM(s."SHIPPED_REVENUE") AS "SHIPPED_REVENUE",
    AVG(p."NET_PPM") AS "AVG_NET_PPM",
    AVG(i."PROCURABLE_PRODUCT_OOS") AS "AVG_PROCURABLE_OOS",
    AVG(i."SELLABLE_ON_HAND_UNITS" + i."UNSELLABLE_ON_HAND_UNITS") AS "ON_HAND_UNITS",
    AVG(i."SELLABLE_ON_HAND_UNITS" * (CASE WHEN s."ORDERED_UNITS" > 0 THEN s."ORDERED_REVENUE" / s."ORDERED_UNITS" END)) AS "ON_HAND_VALUE",
    AVG(i."NET_RECEIVED_UNITS") AS "NET_RECEIVED_UNITS",
    AVG(i."NET_RECEIVED") AS "NET_RECEIVED_VALUE",
    AVG(i."OPEN_PURCHASE_ORDER_QUANTITY") AS "OPEN_PO_QTY",
    AVG(i."UNFILLED_CUSTOMER_ORDERED_UNITS") AS "UNFILLED_CUSTOMER_ORDERED_UNITS",
    AVG(i."VENDOR_CONFIRMATION_RATE") AS "AVG_VENDOR_CONFIRMATION_RATE",
    AVG(i."RECEIVE_FILL_RATE") AS "AVG_RECEIVE_FILL_RATE",
    AVG(i."SELL_THROUGH_RATE") AS "AVG_SELL_THROUGH_RATE",
    AVG(i."OVERALL_VENDOR_LEAD_TIME_DAYS") AS "AVG_VENDOR_LEAD_TIME"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES" s
LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC" t
    ON s."DATE" = t."DATE" AND s."ASIN" = t."ASIN" AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_NET_PPM" p
    ON s."DATE" = p."DATE" AND s."ASIN" = p."ASIN" AND s."DISTRIBUTOR_VIEW" = p."DISTRIBUTOR_VIEW"
LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_INVENTORY" i
    ON s."DATE" = i."DATE" AND s."ASIN" = i."ASIN" AND s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" >= '2022-01-07'
  AND s."DATE" < '2022-02-06'
GROUP BY s."DATE", s."ASIN"
LIMIT 20;
```

```sql
--Description: Produce 30-day cumulative KPIs per ASIN (one row per ASIN).
SELECT
    s."ASIN",
    SUM(s."ORDERED_UNITS")  AS "TOTAL_ORDERED_UNITS_30D",
    SUM(s."ORDERED_REVENUE") AS "TOTAL_ORDERED_REVENUE_30D",
    SUM(s."SHIPPED_UNITS")  AS "TOTAL_SHIPPED_UNITS_30D",
    SUM(s."SHIPPED_REVENUE") AS "TOTAL_SHIPPED_REVENUE_30D",
    AVG(p."NET_PPM")        AS "AVG_NET_PPM_30D",
    AVG(i."PROCURABLE_PRODUCT_OOS")       AS "AVG_PROCURABLE_OOS_30D",
    AVG(i."VENDOR_CONFIRMATION_RATE")     AS "AVG_VENDOR_CONFIRMATION_RATE_30D"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"     s
LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_NET_PPM" p
      ON s."DATE" = p."DATE" AND s."ASIN" = p."ASIN" AND s."DISTRIBUTOR_VIEW" = p."DISTRIBUTOR_VIEW"
LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_INVENTORY" i
      ON s."DATE" = i."DATE" AND s."ASIN" = i."ASIN" AND s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" >= '2022-01-07'
  AND s."DATE" < '2022-02-06'
GROUP BY s."ASIN"
LIMIT 20;
```

