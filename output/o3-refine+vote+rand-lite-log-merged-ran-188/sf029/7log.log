        AVG(iv."SELLABLE_ON_HAND_UNITS" + iv."UNSELLABLE_ON_HAND_UNITS")
                                                                AS "AVG_TOTAL_ON_HAND_UNITS",
        AVG(iv."OPEN_PURCHASE_ORDER_QUANTITY")                  AS "AVG_OPEN_PO_QTY",
        AVG(iv."UNFILLED_CUSTOMER_ORDERED_UNITS")               AS "AVG_UNFILLED_CUST_UNITS",
        AVG(iv."VENDOR_CONFIRMATION_RATE")                      AS "AVG_VENDOR_CONFIRM_RATE",
        AVG(iv."RECEIVE_FILL_RATE")                             AS "AVG_RECEIVE_FILL_RATE",
        AVG(iv."SELL_THROUGH_RATE")                             AS "AVG_SELL_THROUGH_RATE",
        AVG(iv."OVERALL_VENDOR_LEAD_TIME_DAYS")                 AS "AVG_VENDOR_LEAD_TIME_DAYS"
