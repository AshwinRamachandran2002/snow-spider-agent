DATE,ASIN,ORDERED_UNITS,ORDERED_REVENUE,SHIPPED_UNITS,SHIPPED_REVENUE,GLANCE_VIEWS,NET_PPM,OPEN_PURCHASE_ORDER_QUANTITY,PROCURABLE_PRODUCT_OOS,TOTAL_ON_HAND_UNITS,UNFILLED_CUSTOMER_ORDERED_UNITS,VENDOR_CONFIRMATION_RATE,RECEIVE_FILL_RATE,SELL_THROUGH_RATE,OVERALL_VENDOR_LEAD_TIME_DAYS
