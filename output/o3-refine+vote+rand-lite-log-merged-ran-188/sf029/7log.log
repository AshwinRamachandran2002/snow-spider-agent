```sql
--Description: 10) Final daily detailed sales report (30-day window) with
--               all requested metrics & derived fields (limited preview).
SELECT  s."DATE",
        s."ASIN",
        /* demand */
        s."ORDERED_UNITS"                                          AS "TOT_ORDERED_UNITS",
        s."ORDERED_REVENUE"                                        AS "TOT_ORDERED_REVENUE",
        (s."ORDERED_REVENUE" / NULLIF(s."ORDERED_UNITS",0))        AS "AVG_SELLING_PRICE",
        /* visibility */
        t."GLANCE_VIEWS",
        (s."SHIPPED_UNITS" / NULLIF(t."GLANCE_VIEWS",0))           AS "CONVERSION_RATE",
        /* fulfillment & revenue */
        s."SHIPPED_UNITS",
        s."SHIPPED_REVENUE",
        /* profitability */
        np."NET_PPM"                                               AS "AVG_NET_PPM",
        /* inventory health */
        iv."PROCURABLE_PRODUCT_OOS"                                AS "AVG_OOS_RATE",
        (iv."SELLABLE_ON_HAND_UNITS" + iv."UNSELLABLE_ON_HAND_UNITS")
                                                                    AS "TOTAL_ON_HAND_UNITS",
        ((iv."SELLABLE_ON_HAND_UNITS" + iv."UNSELLABLE_ON_HAND_UNITS")
             * (s."SHIPPED_REVENUE" / NULLIF(s."SHIPPED_UNITS",1))) AS "ON_HAND_VALUE_EST",
        iv."NET_RECEIVED_UNITS",
        (iv."NET_RECEIVED" )                                       AS "NET_RECEIVED_VALUE",
        iv."OPEN_PURCHASE_ORDER_QUANTITY",
        iv."UNFILLED_CUSTOMER_ORDERED_UNITS",
        /* efficiency rates */
        iv."VENDOR_CONFIRMATION_RATE",
        iv."RECEIVE_FILL_RATE",
        iv."SELL_THROUGH_RATE",
        iv."OVERALL_VENDOR_LEAD_TIME_DAYS"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
  ON  s."DATE" = t."DATE"
 AND s."ASIN" = t."ASIN"
 AND s."PROGRAM" = t."PROGRAM"
 AND s."PERIOD"  = t."PERIOD"
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" iv
  ON  s."DATE" = iv."DATE"
 AND s."ASIN" = iv."ASIN"
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_NET_PPM" np
  ON  s."DATE" = np."DATE"
 AND s."ASIN" = np."ASIN"
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```
