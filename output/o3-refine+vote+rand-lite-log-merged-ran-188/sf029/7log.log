Query:
--Description: 7) Bring NET_PPM into the combined set to observe profitability.
SELECT  si."DATE",
        si."ASIN",
        si."ORDERED_UNITS",
        si."SHIPPED_UNITS",
        si."SELLABLE_ON_HAND_UNITS",
        np."NET_PPM"
FROM   (
          /* sub-query from step-6 */
          SELECT st."DATE",
                 st."ASIN",
                 st."ORDERED_UNITS",
                 st."SHIPPED_UNITS",
                 iv."SELLABLE_ON_HAND_UNITS"
          FROM (
                  SELECT s."DATE",
                         s."ASIN",
                         s."ORDERED_UNITS",
                         s."SHIPPED_UNITS"
                  FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES" s
                  WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
                    AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
               ) st
          JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" iv
            ON  st."DATE" = iv."DATE"
           AND  st."ASIN" = iv."ASIN"
          WHERE iv."DISTRIBUTOR_VIEW" = 'Manufacturing'
       ) si
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_NET_PPM" np
  ON  si."DATE" = np."DATE"
 AND si."ASIN" = np."ASIN"
WHERE np."DISTRIBUTOR_VIEW" = 'Manufacturing'
LIMIT 20;
Answer:
DATE,ASIN,ORDERED_UNITS,SHIPPED_UNITS,SELLABLE_ON_HAND_UNITS,NET_PPM
