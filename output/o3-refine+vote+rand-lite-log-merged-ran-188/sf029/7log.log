```sql
--Description: 5) Join SALES & TRAFFIC on shared keys to examine basic
--              commerce-plus-visibility signals (conversion, ASP, etc.).
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       s."ORDERED_REVENUE",
       s."SHIPPED_UNITS",
       s."SHIPPED_REVENUE",
       t."GLANCE_VIEWS",
       (s."SHIPPED_UNITS" / NULLIF(t."GLANCE_VIEWS",0))             AS "CONVERSION_RATE",
       (s."SHIPPED_REVENUE" / NULLIF(s."SHIPPED_UNITS",0))           AS "AVG_SELL_PRICE"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"    s
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"  t
  ON   s."DATE"            = t."DATE"
 AND   s."ASIN"            = t."ASIN"
 AND   s."PROGRAM"         = t."PROGRAM"
 AND   s."PERIOD"          = t."PERIOD"
 AND   s."DISTRIBUTOR_VIEW"= t."DISTRIBUTOR_VIEW"
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT  20;
```

```sql
--Description: 6) Extend the above by pulling INVENTORY to add supply-chain fields.
SELECT st."DATE",
       st."ASIN",
       st."ORDERED_UNITS",
       st."SHIPPED_UNITS",
       iv."SELLABLE_ON_HAND_UNITS",
       iv."UNSELLABLE_ON_HAND_UNITS",
       iv."OPEN_PURCHASE_ORDER_QUANTITY",
       iv."UNFILLED_CUSTOMER_ORDERED_UNITS",
       iv."PROCURABLE_PRODUCT_OOS",
       iv."VENDOR_CONFIRMATION_RATE",
       iv."RECEIVE_FILL_RATE",
       iv."SELL_THROUGH_RATE",
       iv."OVERALL_VENDOR_LEAD_TIME_DAYS"
FROM (
        SELECT s."DATE",
               s."ASIN",
               s."ORDERED_UNITS",
               s."SHIPPED_UNITS"
        FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES" s
        WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
          AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
     ) st
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" iv
  ON  st."DATE" = iv."DATE"
  AND st."ASIN" = iv."ASIN"
WHERE iv."DISTRIBUTOR_VIEW" = 'Manufacturing'
LIMIT 20;
```

```sql
--Description: 7) Bring NET_PPM into the combined set to observe profitability.
SELECT  si."DATE",
        si."ASIN",
        si."ORDERED_UNITS",
        si."SHIPPED_UNITS",
        si."SELLABLE_ON_HAND_UNITS",
        np."NET_PPM"
FROM   (
          /* sub-query from step-6 */
          SELECT st."DATE",
                 st."ASIN",
                 st."ORDERED_UNITS",
                 st."SHIPPED_UNITS",
                 iv."SELLABLE_ON_HAND_UNITS"
          FROM (
                  SELECT s."DATE",
                         s."ASIN",
                         s."ORDERED_UNITS",
                         s."SHIPPED_UNITS"
                  FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES" s
                  WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
                    AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
               ) st
          JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" iv
            ON  st."DATE" = iv."DATE"
           AND  st."ASIN" = iv."ASIN"
          WHERE iv."DISTRIBUTOR_VIEW" = 'Manufacturing'
       ) si
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_NET_PPM" np
  ON  si."DATE" = np."DATE"
 AND si."ASIN" = np."ASIN"
WHERE np."DISTRIBUTOR_VIEW" = 'Manufacturing'
LIMIT 20;
```

```sql
--Description: 8) Aggregate 30-day metrics for each ASIN (Manufacturing view).
SELECT  s."ASIN",
        SUM(s."ORDERED_UNITS")                                  AS "TOT_ORDERED_UNITS",
        SUM(s."ORDERED_REVENUE")                                AS "TOT_ORDERED_REV",
        SUM(t."GLANCE_VIEWS")                                   AS "TOT_GLANCE_VIEWS",
        SUM(s."SHIPPED_UNITS")                                  AS "TOT_SHIPPED_UNITS",
        SUM(s."SHIPPED_REVENUE")                                AS "TOT_SHIPPED_REV",
        AVG(np."NET_PPM")                                       AS "AVG_NET_PPM",
        AVG(iv."PROCURABLE_PRODUCT_OOS")                        AS "AVG_OOS_RATE",
        AVG(iv."SELLABLE_ON_HAND_UNITS" + iv."UNSELLABLE_ON_HAND_UNITS")
                                                                AS "AVG_TOTAL_ON_HAND_UNITS",
        AVG(iv."OPEN_PURCHASE_ORDER_QUANTITY")                  AS "AVG_OPEN_PO_QTY",
        AVG(iv."UNFILLED_CUSTOMER_ORDERED_UNITS")               AS "AVG_UNFILLED_CUST_UNITS",
        AVG(iv."VENDOR_CONFIRMATION_RATE")                      AS "AVG_VENDOR_CONFIRM_RATE",
        AVG(iv."RECEIVE_FILL_RATE")                             AS "AVG_RECEIVE_FILL_RATE",
        AVG(iv."SELL_THROUGH_RATE")                             AS "AVG_SELL_THROUGH_RATE",
        AVG(iv."OVERALL_VENDOR_LEAD_TIME_DAYS")                 AS "AVG_VENDOR_LEAD_TIME_DAYS"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
  ON  s."DATE" = t."DATE"
 AND s."ASIN" = t."ASIN"
 AND s."PROGRAM" = t."PROGRAM"
 AND s."PERIOD"  = t."PERIOD"
 AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" iv
  ON s."DATE" = iv."DATE"
 AND s."ASIN" = iv."ASIN"
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_NET_PPM" np
  ON s."DATE" = np."DATE"
 AND s."ASIN" = np."ASIN"
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
GROUP BY s."ASIN"
LIMIT 20;
```

