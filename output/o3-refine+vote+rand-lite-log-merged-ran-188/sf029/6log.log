```sql
--Description: 6) Join sales and traffic to compute conversion rate (ordered_units / glance_views)
SELECT 
  s."DATE",
  s."ASIN",
  s."ORDERED_UNITS",
  t."GLANCE_VIEWS",
  CASE WHEN t."GLANCE_VIEWS" = 0 THEN NULL 
       ELSE s."ORDERED_UNITS" / t."GLANCE_VIEWS" END AS "CONVERSION_RATE"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"  s
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
  ON s."DATE" = t."DATE"
 AND s."ASIN" = t."ASIN"
 AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."PROGRAM" = 'Amazon Retail'
  AND s."PERIOD" = 'DAILY'
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: 7) Combine sales with inventory to attach on-hand units & PO quantities
SELECT 
  s."DATE",
  s."ASIN",
  s."ORDERED_UNITS",
  s."SHIPPED_UNITS",
  i."SELLABLE_ON_HAND_UNITS" + i."UNSELLABLE_ON_HAND_UNITS" AS "TOTAL_ON_HAND_UNITS",
  i."OPEN_PURCHASE_ORDER_QUANTITY" AS "OPEN_PO_QTY",
  i."UNFILLED_CUSTOMER_ORDERED_UNITS"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"  s
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
  ON s."DATE" = i."DATE"
 AND s."ASIN" = i."ASIN"
 AND s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."PROGRAM" = 'Amazon Retail'
  AND s."PERIOD" = 'DAILY'
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: 8) Bring in Net-PPM alongside sales to see profitability together
SELECT 
  s."DATE",
  s."ASIN",
  s."ORDERED_REVENUE",
  p."NET_PPM"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"  s
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_NET_PPM" p
  ON s."DATE" = p."DATE"
 AND s."ASIN" = p."ASIN"
 AND s."DISTRIBUTOR_VIEW" = p."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."PROGRAM" = 'Amazon Retail'
  AND s."PERIOD" = 'DAILY'
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: 9) Calculate average selling price (ASP) and attach key operational KPIs
SELECT 
  s."DATE",
  s."ASIN",
  s."ORDERED_UNITS",
  s."ORDERED_REVENUE",
  CASE WHEN s."ORDERED_UNITS" = 0 THEN NULL 
       ELSE s."ORDERED_REVENUE" / s."ORDERED_UNITS" END AS "AVG_SELLING_PRICE",
  i."VENDOR_CONFIRMATION_RATE",
  i."RECEIVE_FILL_RATE",
  i."SELL_THROUGH_RATE",
  i."OVERALL_VENDOR_LEAD_TIME_DAYS"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES" s
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
  ON s."DATE" = i."DATE"
 AND s."ASIN" = i."ASIN"
 AND s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."PROGRAM" = 'Amazon Retail'
  AND s."PERIOD" = 'DAILY'
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: 10) Final comprehensive daily report joining sales, traffic, inventory and net-PPM
SELECT 
  s."DATE",
  s."ASIN",
  -- demand metrics
  s."ORDERED_UNITS",
  s."ORDERED_REVENUE",
  ROUND(CASE WHEN s."ORDERED_UNITS" = 0 THEN NULL 
             ELSE s."ORDERED_REVENUE" / s."ORDERED_UNITS" END , 2) AS "AVG_SELLING_PRICE",
  t."GLANCE_VIEWS",
  ROUND(CASE WHEN t."GLANCE_VIEWS" = 0 THEN NULL 
             ELSE s."ORDERED_UNITS" / t."GLANCE_VIEWS" END , 4) AS "CONVERSION_RATE",
  s."SHIPPED_UNITS",
  s."SHIPPED_REVENUE",
  -- profitability
  p."NET_PPM" AS "DAILY_NET_PPM",
  -- inventory / ops
  i."PROCURABLE_PRODUCT_OOS",
  i."SELLABLE_ON_HAND_UNITS" + i."UNSELLABLE_ON_HAND_UNITS"      AS "TOTAL_ON_HAND_UNITS",
  (i."SELLABLE_ON_HAND_UNITS" + i."UNSELLABLE_ON_HAND_UNITS")
    * NULLIF(ROUND(CASE WHEN s."ORDERED_UNITS" = 0 THEN NULL 
                        ELSE s."ORDERED_REVENUE" / s."ORDERED_UNITS" END ,2),0)     AS "ON_HAND_VALUE_EST",
  i."NET_RECEIVED_UNITS",
  i."NET_RECEIVED_UNITS" 
    * NULLIF(ROUND(CASE WHEN s."SHIPPED_UNITS" = 0 THEN NULL 
                        ELSE s."SHIPPED_REVENUE" / s."SHIPPED_UNITS" END ,2),0)     AS "NET_RECEIVED_VALUE_EST",
  i."OPEN_PURCHASE_ORDER_QUANTITY",
  i."UNFILLED_CUSTOMER_ORDERED_UNITS",
  i."VENDOR_CONFIRMATION_RATE",
  i."RECEIVE_FILL_RATE",
  i."SELL_THROUGH_RATE",
  i."OVERALL_VENDOR_LEAD_TIME_DAYS"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"     s
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"  t
       ON s."DATE" = t."DATE"
      AND s."ASIN" = t."ASIN"
      AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
       ON s."DATE" = i."DATE"
      AND s."ASIN" = i."ASIN"
      AND s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_NET_PPM"  p
       ON s."DATE" = p."DATE"
      AND s."ASIN" = p."ASIN"
      AND s."DISTRIBUTOR_VIEW" = p."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."PROGRAM" = 'Amazon Retail'
  AND s."PERIOD" = 'DAILY'
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```
