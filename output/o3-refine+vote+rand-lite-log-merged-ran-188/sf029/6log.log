--Description: 1) Inspect daily sales records for 30-day window prior to 6-Feb-2022
SELECT 
  s."DATE",
  s."ASIN",
  s."ORDERED_UNITS",
  s."ORDERED_REVENUE",
  s."SHIPPED_UNITS",
  s."SHIPPED_REVENUE"
