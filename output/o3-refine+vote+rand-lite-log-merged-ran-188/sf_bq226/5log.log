--Description: Find the address that appears most often as the sender (first argument) in “Transfer(address,address,uint256)” events,   
--restricted to (a) blocks since 1 Jan 2023, (b) logs whose raw DATA field is larger than 4 096 bytes, and (c) transfers where the
--receiver (second argument) is not the zero-address.  We join the decoded-events table to the raw logs to enforce the DATA-size
--condition, parse the JSON-array ARGS column to extract sender/receiver, aggregate, then return the top sender as a complete
--Cronoscan URL together with its transfer count.
SELECT
    'https://cronoscan.com/address/' || top_sender."sender" AS "cronoscan_url",
    top_sender."transfer_count"
FROM (
    SELECT
        args[0]::STRING                         AS "sender",
        COUNT(*)                                AS "transfer_count"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
    JOIN "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
          ON d."TRANSACTION_HASH" = l."transaction_hash"
         AND d."LOG_INDEX"        = l."log_index"
    , LATERAL FLATTEN(input => PARSE_JSON(d."ARGS")) f         -- converts ARGS text → JSON array, exposes elements
    QUALIFY f."index" IN (0,1)                                 -- keep only element 0 (sender) & element 1 (receiver)
    ) AS flattened
    PIVOT( MAX(f."value"::STRING) FOR f."index" IN (0,1) ) p   -- turn the two elements into columns 0,1
    WHERE p."1" IS NOT NULL                                     -- receiver non-null
      AND p."1" <> '0x0000000000000000000000000000000000000000' -- receiver not zero address
      AND d."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND l."block_timestamp" >= 1672531200000000               -- ≥ 2023-01-01 (µs)
      AND LENGTH(l."data") > 4096                               -- raw log’s DATA > 4 KB
GROUP BY "sender"
ORDER BY "transfer_count" DESC
LIMIT 1
) AS top_sender;
