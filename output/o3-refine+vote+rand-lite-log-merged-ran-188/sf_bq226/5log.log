```sql
--Description: Locate the single most-frequent sender (first element of ARGS) among all
--“Transfer(address,address,uint256)” events whose corresponding raw log entry has
--DATA larger than 1 024 bytes and a block-timestamp on/after 2023-01-01.  The query
--(1) joins LOGS with DECODED_EVENTS on transaction-hash + log-index so both size
--and decoded information are available, (2) converts the ARGS text into JSON and
--grabs element 0 (sender), (3) aggregates to count how many such transfers each
--sender initiated, and (4) returns the top sender as a complete Cronoscan URL
--along with its transfer count.
SELECT
    'https://cronoscan.com/address/' || sender           AS "cronoscan_url",
    transfer_count
FROM (
    SELECT
        (PARSE_JSON(d."ARGS"))[0]::STRING  AS sender,
        COUNT(*)                           AS transfer_count
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"  l
    JOIN "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
          ON l."transaction_hash" = d."TRANSACTION_HASH"
         AND l."log_index"        = d."LOG_INDEX"
    WHERE l."block_timestamp" >= 1672531200000000      -- ≥ 2023-01-01 (µs)
      AND LENGTH(l."data") > 1024                      -- DATA > 1 KB
      AND d."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
    GROUP BY sender
) t
ORDER BY transfer_count DESC
LIMIT 1;
```
