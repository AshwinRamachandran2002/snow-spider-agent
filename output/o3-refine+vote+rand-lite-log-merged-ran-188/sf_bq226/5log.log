```sql
--Description: 8) Join LOGS and DECODED_EVENTS on transaction-hash & log-index to view both raw and decoded versions of large-DATA logs (>4 KB) since 1 Jan 2023.  
SELECT 
  l."transaction_hash",
  l."log_index",
  l."address"                AS "log_emitter",
  d."ADDRESS"                AS "decoded_emitter",
  d."EVENT_SIGNATURE",
  d."ARGS"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"  l
JOIN "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
     ON  l."transaction_hash" = d."TRANSACTION_HASH"
     AND l."log_index"        = d."LOG_INDEX"
WHERE l."block_timestamp" >= 1672531200000000
  AND LENGTH(l."data") > 4096
LIMIT 20;
```

```sql
--Description: 9) Determine which emitting address appears most often in large-DATA logs (>4 KB) that also decode to ‘Transfer’ events since 1 Jan 2023.  
SELECT
  l."address"                  AS "emitting_address",
  COUNT(*)                     AS "matching_log_count"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"  l
JOIN "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
     ON  l."transaction_hash" = d."TRANSACTION_HASH"
     AND l."log_index"        = d."LOG_INDEX"
WHERE l."block_timestamp" >= 1672531200000000
  AND LENGTH(l."data") > 4096
  AND d."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
GROUP BY l."address"
ORDER BY "matching_log_count" DESC
LIMIT 20;
```

```sql
--Description: 10) Craft the Cronos-scan URL for the single most-frequent emitter derived above (example uses a placeholder address).  
SELECT 
  'https://cronoscan.com/address/' || "emitting_address" AS "cronoscan_url",
  "matching_log_count"
FROM (
    SELECT
      l."address" AS "emitting_address",
      COUNT(*)    AS "matching_log_count"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"  l
    JOIN "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
         ON  l."transaction_hash" = d."TRANSACTION_HASH"
         AND l."log_index"        = d."LOG_INDEX"
    WHERE l."block_timestamp" >= 1672531200000000
      AND LENGTH(l."data") > 4096
      AND d."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
    GROUP BY l."address"
    ORDER BY "matching_log_count" DESC
    LIMIT 1
) t;
```
