--Description: 4) Restrict to logs whose DATA field is larger than 4,096 bytes; show which addresses emit the most such logs (since 1 Jan 2023).  
SELECT 
  "address",
  COUNT(*) AS "big_data_log_count"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE "block_timestamp" >= 1672531200000000
  AND LENGTH("data") > 4096          -- surrogate for “block size > 4096 bytes”
GROUP BY "address"
ORDER BY "big_data_log_count" DESC
LIMIT 20;
