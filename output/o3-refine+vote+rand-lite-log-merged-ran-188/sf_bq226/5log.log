Query:
--Description: Produce the Cronoscan URL for the single address that emitted the greatest
--number of raw-log records with DATA length > 4 096 bytes (our proxy for “blocks larger
--than 4 096 bytes”) since 1 Jan 2023, together with that log count.
SELECT
    'https://cronoscan.com/address/' || t."address" AS "cronoscan_url",
    t."large_block_log_count"
FROM (
    SELECT
        l."address",
        COUNT(*) AS "large_block_log_count"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
    WHERE l."block_timestamp" >= 1672531200000000      -- ≥ 2023-01-01 (µs)
      AND LENGTH(l."data") > 4096                      -- DATA > 4 KB
    GROUP BY l."address"
    ORDER BY "large_block_log_count" DESC
    LIMIT 1
) t
