```sql
WITH big_logs AS (   -- logs whose DATA length > 4 096 bytes since 2023-01-01
    SELECT
        "transaction_hash",
        "log_index"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "block_timestamp" >= 1672531200000000           -- 2023-01-01 00:00:00 UTC (µs)
      AND LENGTH("data") > 4096                           -- proxy for “blocks larger than 4 096 bytes”
), transfer_events AS (     -- decoded Transfer events
    SELECT
        "TRANSACTION_HASH",
        "LOG_INDEX",
        LOWER( PARSE_JSON("ARGS")[0]::string ) AS "from_addr",   -- sender
        LOWER( PARSE_JSON("ARGS")[1]::string ) AS "to_addr"      -- receiver
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
)
SELECT
    'https://cronoscan.com/address/' || "from_addr" AS "cronoscan_url",
    COUNT(*) AS "tx_count"
FROM transfer_events te
JOIN big_logs bl
  ON te."TRANSACTION_HASH" = bl."transaction_hash"
 AND te."LOG_INDEX"        = bl."log_index"
WHERE "to_addr" IS NOT NULL
  AND "to_addr" <> '0x0000000000000000000000000000000000000000'  -- exclude null / burn address
GROUP BY "from_addr"
ORDER BY "tx_count" DESC NULLS LAST
LIMIT 1;
```
