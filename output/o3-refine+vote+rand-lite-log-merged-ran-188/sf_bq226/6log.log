FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
LIMIT 20;
```

```sql
--Description: Review transfers that happened in 2023 or later (block timestamps are in micro-seconds)
SELECT 
  "BLOCK_NUMBER",
  "BLOCK_TIMESTAMP",
  PARSE_JSON("ARGS")[0]::STRING AS "FROM_ADDRESS",
  PARSE_JSON("ARGS")[1]::STRING AS "TO_ADDRESS"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000      -- 2023-01-01 UTC in µs
LIMIT 20;
```

```sql
--Description: Filter 2023+ transfers where TO address is not the null-address (all zeroes)
SELECT 
  PARSE_JSON("ARGS")[0]::STRING AS "FROM_ADDRESS",
  PARSE_JSON("ARGS")[1]::STRING AS "TO_ADDRESS",
  "BLOCK_NUMBER",
  "BLOCK_TIMESTAMP"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
  AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
LIMIT 20;
```

```sql
--Description: Count how many times each sender (FROM_ADDRESS) appears since 2023 with a non-null TO address
SELECT 
  PARSE_JSON("ARGS")[0]::STRING AS "FROM_ADDRESS",
  COUNT(*)                      AS "TX_COUNT"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
  AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
GROUP BY 1
ORDER BY "TX_COUNT" DESC
LIMIT 20;
```

```sql
--Description: Same as above, but show the sender address as a full Cronoscan URL
SELECT 
  CONCAT('https://cronoscan.com/address/', PARSE_JSON("ARGS")[0]::STRING) AS "SENDER_CRONOSCAN_URL",
  COUNT(*) AS "TX_COUNT"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
  AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
GROUP BY 1
ORDER BY "TX_COUNT" DESC
LIMIT 20;
```

```sql
--Description: Inspect blocks over an assumed large-size threshold (here > 4096) – size not present, so proxy using number of events per block
SELECT 
  "BLOCK_NUMBER",
  COUNT(*) AS "EVENTS_IN_BLOCK"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "BLOCK_TIMESTAMP" >= 1672531200000000
GROUP BY "BLOCK_NUMBER"
HAVING COUNT(*) > 4096        -- treating “size” as event count proxy
ORDER BY "EVENTS_IN_BLOCK" DESC
LIMIT 20;
```

```sql
--Description: Combine the previous proxy for “large blocks” (>4096 events) with sender frequency
WITH large_blocks AS (
  SELECT "BLOCK_NUMBER"
  FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
  WHERE "BLOCK_TIMESTAMP" >= 1672531200000000
  GROUP BY "BLOCK_NUMBER"
  HAVING COUNT(*) > 4096
)
SELECT 
  CONCAT('https://cronoscan.com/address/', PARSE_JSON(e."ARGS")[0]::STRING) AS "SENDER_CRONOSCAN_URL",
  COUNT(*) AS "TX_COUNT"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
JOIN large_blocks lb
  ON e."BLOCK_NUMBER" = lb."BLOCK_NUMBER"
WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON(e."ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
GROUP BY 1
ORDER BY "TX_COUNT" DESC
LIMIT 20;
```
