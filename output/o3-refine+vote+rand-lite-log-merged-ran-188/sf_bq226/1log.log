```sql
--Description: Take 100 distinct transaction hashes directly from DECODED_EVENTS (so we know they exist there),  
--parse each ARGS JSON to extract the first argument (arg_0), and then join those hashes to LOGS on the single key  
--“transaction_hash”.  This broadest join guarantees overlapping rows, letting us see raw-log details together with  
--decoded event information.
WITH de AS (
    SELECT DISTINCT
           "TRANSACTION_HASH",
           "EVENT_SIGNATURE",
           TRY_PARSE_JSON("ARGS")[0]::STRING AS "arg_0"
    FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
    LIMIT 100
)
SELECT l."block_number",
       l."transaction_hash",
       l."log_index",
       l."address"        AS "emitter_address",
       de."EVENT_SIGNATURE",
       de."arg_0"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS l
JOIN de
  ON l."transaction_hash" = de."TRANSACTION_HASH"
LIMIT 20;
```
