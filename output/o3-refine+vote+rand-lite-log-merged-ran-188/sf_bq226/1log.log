SELECT DISTINCT "address"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
WHERE "block_timestamp" >= 1672531200000000
LIMIT 20;
```

```sql
--Description: Top 20 most-frequent emitter addresses since Jan-01-2023 (simple frequency count on LOGS).
SELECT "address",
       COUNT(*) AS "logs_emitted"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
WHERE "block_timestamp" >= 1672531200000000
GROUP BY "address"
ORDER BY "logs_emitted" DESC
LIMIT 20;
```

```sql
--Description: Quick look at the size of LOGS by block_number to spot very large blocks (≥ 4 096 logs here as an approximation of “block larger than 4096 bytes”).
SELECT "block_number",
       COUNT(*) AS "logs_in_block"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
GROUP BY "block_number"
HAVING COUNT(*) >= 4096
ORDER BY "logs_in_block" DESC
LIMIT 20;
```

```sql
--Description: Distinct transaction_hash values that belong to blocks with at least 4 096 logs.
WITH big_blocks AS (
  SELECT "block_number"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
  GROUP BY "block_number"
  HAVING COUNT(*) >= 4096
)
SELECT DISTINCT l."transaction_hash"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS l
JOIN big_blocks b
  ON l."block_number" = b."block_number"
LIMIT 20;
```

```sql
--Description: Inspect corresponding decoded events for those “big blocks”.
WITH big_blocks AS (
  SELECT "block_number"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
  GROUP BY "block_number"
  HAVING COUNT(*) >= 4096
)
SELECT *
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS e
JOIN big_blocks b
  ON e."BLOCK_NUMBER" = b."block_number"
LIMIT 20;
```

```sql
--Description: Distinct EVENT_SIGNATURE values seen in big blocks after Jan-01-2023.
WITH big_blocks AS (
  SELECT "block_number"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
  WHERE "block_timestamp" >= 1672531200000000
  GROUP BY "block_number"
  HAVING COUNT(*) >= 4096
)
SELECT DISTINCT e."EVENT_SIGNATURE"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS e
JOIN big_blocks b
  ON e."BLOCK_NUMBER" = b."block_number"
LIMIT 20;
```

```sql
--Description: Flatten TOPICS array in LOGS to inspect individual topic hashes inside big blocks.
WITH big_blocks AS (
  SELECT "block_number"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
  GROUP BY "block_number"
  HAVING COUNT(*) >= 4096
)
SELECT l."block_number",
       f.value::STRING AS "topic"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS l,
     LATERAL FLATTEN(input => l."topics") f
JOIN big_blocks b
  ON l."block_number" = b."block_number"
LIMIT 20;
```

```sql
--Description: Flatten ARGS array in DECODED_EVENTS for big blocks to reveal decoded parameters (addresses, amounts, etc.).
WITH big_blocks AS (
  SELECT "block_number"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
  GROUP BY "block_number"
  HAVING COUNT(*) >= 4096
)
SELECT e."BLOCK_NUMBER",
       e."EVENT_SIGNATURE",
       f.value::STRING AS "arg_value"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS e,
     LATERAL FLATTEN(input => e."ARGS") f
JOIN big_blocks b
  ON e."BLOCK_NUMBER" = b."block_number"
LIMIT 20;
```

```sql
--Description: Join LOGS with their DECODED_EVENTS on transaction_hash + log_index to expose both raw and decoded information for analysis.
SELECT l."block_number",
       l."transaction_hash",
       l."log_index",
       l."address"                  AS "emitter_address",
       e."EVENT_SIGNATURE",
       e."ARGS"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS           l
JOIN GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS e
  ON l."transaction_hash" = e."TRANSACTION_HASH"
 AND l."log_index"       = e."LOG_INDEX"
WHERE l."block_timestamp" >= 1672531200000000
LIMIT 20;
```
