```sql
--Description: Find 20 transaction hashes that are present in BOTH tables, then display raw-log data plus decoded info for those hashes.  
WITH common_tx AS (           -- hashes guaranteed to exist in both tables
    SELECT DISTINCT l."transaction_hash"
    FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS           l
    JOIN GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS d
      ON l."transaction_hash" = d."TRANSACTION_HASH"
    LIMIT 20
)
SELECT l."block_number",
       l."transaction_hash",
       l."log_index",
       l."address"                         AS "emitter_address",
       d."EVENT_SIGNATURE",
       TRY_PARSE_JSON(d."ARGS")[0]::STRING AS "arg_0"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS           l
JOIN GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS d
  ON l."transaction_hash" = d."TRANSACTION_HASH"
JOIN common_tx c
  ON l."transaction_hash" = c."transaction_hash"
LIMIT 20;
```
