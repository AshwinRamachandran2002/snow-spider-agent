Query:
--Description: Flatten TOPICS arrays for blocks that contain at least 4 096 logs (confirmed to exist: blocks 138023063 and 138024734).  
--This uses a CTE to collect such block numbers from LOGS, then flattens the "topics" VARIANT array for those blocks.
WITH big_blocks AS (
    SELECT "block_number"
    FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
    GROUP BY "block_number"
    HAVING COUNT(*) >= 4096
)
SELECT l."block_number",
       f.value::STRING AS "topic"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS l
JOIN big_blocks b
  ON l."block_number" = b."block_number",
LATERAL FLATTEN(input => l."topics") f
LIMIT 20
