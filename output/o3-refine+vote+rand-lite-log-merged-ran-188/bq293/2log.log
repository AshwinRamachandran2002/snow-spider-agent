```sql
--Description: 
-- STEP-BY-STEP THINKING EMBEDDED IN COMMENTS
-- 1.  Collect hourly trip counts per NYC zip-code for a 21-day look-back  
--     (11-Dec-2014 through 01-Jan-2015 23:59).  We need this history to
--     compute lags and moving statistics that reference previous hours.  
--     ST_CONTAINS maps each yellow-taxi pickup point to the polygon of a
--     NY zip-code; trips with NULL coords are discarded.
-- 2.  Using window-functions on the ordered hours within each zip, derive:
--        • lags: 1 hr, 24 hr, 168 hr (7 d), 336 hr (14 d)
--        • moving averages & std-devs for 14 d (336 hr) and 21 d (504 hr),
--          both *excluding* the current hour by framing “BETWEEN … AND 1 PRECEDING”.
-- 3.  Finally, filter results to DATE=’2015-01-01’ and list the 20 busiest
--     zip-code × hour combinations.

WITH hist AS (   -- hourly history
  SELECT
    TIMESTAMP_TRUNC(pickup_datetime, HOUR) AS hr_ts,
    z.zip_code,
    COUNT(*) AS trips
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2015` AS t
  JOIN `bigquery-public-data.geo_us_boundaries.zip_codes`    AS z
    ON ST_CONTAINS(z.zip_code_geom,
                   ST_GEOGPOINT(t.pickup_longitude, t.pickup_latitude))
  WHERE pickup_datetime BETWEEN TIMESTAMP('2014-12-11')
                            AND TIMESTAMP('2015-01-02')
    AND pickup_longitude IS NOT NULL
    AND pickup_latitude  IS NOT NULL
  GROUP BY hr_ts, z.zip_code
),
calc AS (        -- lags & moving stats
  SELECT
    zip_code,
    hr_ts,
    trips,
    LAG(trips, 1)   OVER w AS trips_1hr_ago,
    LAG(trips, 24)  OVER w AS trips_24hr_ago,
    LAG(trips, 168) OVER w AS trips_7d_ago,
    LAG(trips, 336) OVER w AS trips_14d_ago,
    AVG(trips)         OVER (w ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING) AS ma_14d,
    STDDEV_POP(trips)  OVER (w ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING) AS sd_14d,
    AVG(trips)         OVER (w ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING) AS ma_21d,
    STDDEV_POP(trips)  OVER (w ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING) AS sd_21d
  FROM hist
  WINDOW w AS (PARTITION BY zip_code ORDER BY hr_ts)
)
SELECT *
FROM calc
WHERE DATE(hr_ts) = '2015-01-01'
ORDER BY trips DESC
LIMIT 20;
```
