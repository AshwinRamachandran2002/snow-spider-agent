```sql
-- 4) Demonstrate point-in-polygon join for 20 random trips on 1-Jan-2015
WITH sample AS (
  SELECT *
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2015`
  WHERE DATE(pickup_datetime) = '2015-01-01'
    AND pickup_longitude IS NOT NULL
    AND pickup_latitude  IS NOT NULL
  LIMIT 20
)
SELECT
  s.pickup_datetime,
  z.zip_code,
  z.county,
  z.state_code
FROM sample            AS s
JOIN `bigquery-public-data.geo_us_boundaries.zip_codes` AS z
ON ST_CONTAINS(z.zip_code_geom,
               ST_GEOGPOINT(s.pickup_longitude, s.pickup_latitude))
LIMIT 20;
```

```sql
-- 5) Trip counts by zip code & hour for 1-Jan-2015 (non-zero rows only)
WITH trips AS (
  SELECT
    TIMESTAMP_TRUNC(pickup_datetime, HOUR)  AS hr_ts,
    z.zip_code
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2015` t
  JOIN `bigquery-public-data.geo_us_boundaries.zip_codes`   z
  ON  ST_CONTAINS(z.zip_code_geom,
                  ST_GEOGPOINT(t.pickup_longitude, t.pickup_latitude))
  WHERE DATE(pickup_datetime) = '2015-01-01'
    AND pickup_longitude IS NOT NULL AND pickup_latitude IS NOT NULL
)
SELECT
  zip_code,
  hr_ts,
  COUNT(*) AS trips
FROM trips
GROUP BY zip_code, hr_ts
ORDER BY trips DESC
LIMIT 20;
```

```sql
-- 6) Create a complete 24-hour grid for every NYC zip code (show 20 rows)
WITH zips AS (
  SELECT DISTINCT zip_code
  FROM `bigquery-public-data.geo_us_boundaries.zip_codes`
  WHERE state_code = 'NY'
)
SELECT
  z.zip_code,
  TIMESTAMP '2015-01-01' + INTERVAL h HOUR AS hr_ts
FROM zips AS z
CROSS JOIN UNNEST(GENERATE_ARRAY(0,23)) AS h
LIMIT 20;
```

```sql
-- 7) Left-join the grid with real counts so missing hours appear with zero
WITH grid AS (
  SELECT
    z.zip_code,
    TIMESTAMP '2015-01-01' + INTERVAL h HOUR AS hr_ts
  FROM (
     SELECT DISTINCT zip_code
     FROM `bigquery-public-data.geo_us_boundaries.zip_codes`
     WHERE state_code = 'NY'
  ) AS z
  CROSS JOIN UNNEST(GENERATE_ARRAY(0,23)) AS h
),
counts AS (
  SELECT
    TIMESTAMP_TRUNC(pickup_datetime, HOUR)  AS hr_ts,
    z.zip_code,
    COUNT(*) AS trips
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2015` t
  JOIN `bigquery-public-data.geo_us_boundaries.zip_codes`   z
  ON  ST_CONTAINS(z.zip_code_geom,
                  ST_GEOGPOINT(t.pickup_longitude, t.pickup_latitude))
  WHERE DATE(pickup_datetime) = '2015-01-01'
    AND pickup_longitude IS NOT NULL AND pickup_latitude IS NOT NULL
  GROUP BY hr_ts, z.zip_code
)
SELECT
  g.zip_code,
  g.hr_ts,
  COALESCE(c.trips,0) AS trips
FROM grid  AS g
LEFT JOIN counts AS c
USING (zip_code, hr_ts)
ORDER BY trips DESC
LIMIT 20;
```

```sql
-- 8) Build 21-day history (11-Dec-2014 – 1-Jan-2015) of hourly counts per zip
WITH hist AS (
  SELECT
    TIMESTAMP_TRUNC(pickup_datetime, HOUR)  AS hr_ts,
    z.zip_code,
    COUNT(*) AS trips
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2015` t
  JOIN `bigquery-public-data.geo_us_boundaries.zip_codes`   z
  ON  ST_CONTAINS(z.zip_code_geom,
                  ST_GEOGPOINT(t.pickup_longitude, t.pickup_latitude))
  WHERE pickup_datetime BETWEEN TIMESTAMP('2014-12-11') AND TIMESTAMP('2015-01-02')
    AND pickup_longitude IS NOT NULL AND pickup_latitude IS NOT NULL
  GROUP BY hr_ts, z.zip_code
)
SELECT *
FROM hist
ORDER BY hr_ts DESC
LIMIT 20;
```

```sql
-- 9) For 1-Jan-2015, compute lagged counts & 14-/21-day moving stats per zip/hour
WITH hist AS (
  SELECT
    TIMESTAMP_TRUNC(pickup_datetime, HOUR)  AS hr_ts,
    z.zip_code,
    COUNT(*) AS trips
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2015` t
  JOIN `bigquery-public-data.geo_us_boundaries.zip_codes`   z
  ON  ST_CONTAINS(z.zip_code_geom,
                  ST_GEOGPOINT(t.pickup_longitude, t.pickup_latitude))
  WHERE pickup_datetime BETWEEN TIMESTAMP('2014-12-11') AND TIMESTAMP('2015-01-02')
    AND pickup_longitude IS NOT NULL AND pickup_latitude IS NOT NULL
  GROUP BY hr_ts, z.zip_code
),
calc AS (
  SELECT
    zip_code,
    hr_ts,
    trips,
    LAG(trips, 1)   OVER w AS trips_1hr_ago,
    LAG(trips, 24)  OVER w AS trips_24hr_ago,
    LAG(trips, 168) OVER w AS trips_7d_ago,
    LAG(trips, 336) OVER w AS trips_14d_ago,
    AVG(trips) OVER (w RANGE BETWEEN 336 HOUR PRECEDING AND 1 HOUR PRECEDING) AS ma_14d,
    STDDEV_POP(trips) OVER (w RANGE BETWEEN 336 HOUR PRECEDING AND 1 HOUR PRECEDING) AS sd_14d,
    AVG(trips) OVER (w RANGE BETWEEN 504 HOUR PRECEDING AND 1 HOUR PRECEDING) AS ma_21d,
    STDDEV_POP(trips) OVER (w RANGE BETWEEN 504 HOUR PRECEDING AND 1 HOUR PRECEDING) AS sd_21d
  FROM hist
  WINDOW w AS (PARTITION BY zip_code ORDER BY hr_ts)
)
SELECT *
FROM calc
WHERE DATE(hr_ts) = '2015-01-01'
ORDER BY trips DESC
LIMIT 20;
```

```sql
-- 10) Show the 5 zip-code × hour groups on 1-Jan-2015 with the most trips
SELECT
  zip_code,
  hr_ts,
  trips,
  trips_1hr_ago,
  trips_24hr_ago,
  trips_7d_ago,
  trips_14d_ago,
  ma_14d,
  sd_14d,
  ma_21d,
  sd_21d
FROM (
  -- reuse the `calc` CTE from query #9
  WITH hist AS (
    SELECT
      TIMESTAMP_TRUNC(pickup_datetime, HOUR)  AS hr_ts,
      z.zip_code,
      COUNT(*) AS trips
    FROM `bigquery-public-data.new_york.tlc_yellow_trips_2015` t
    JOIN `bigquery-public-data.geo_us_boundaries.zip_codes`   z
    ON  ST_CONTAINS(z.zip_code_geom,
                    ST_GEOGPOINT(t.pickup_longitude, t.pickup_latitude))
    WHERE pickup_datetime BETWEEN TIMESTAMP('2014-12-11') AND TIMESTAMP('2015-01-02')
      AND pickup_longitude IS NOT NULL AND pickup_latitude IS NOT NULL
    GROUP BY hr_ts, z.zip_code
  ),
  calc AS (
    SELECT
      zip_code,
      hr_ts,
      trips,
      LAG(trips, 1)   OVER w AS trips_1hr_ago,
      LAG(trips, 24)  OVER w AS trips_24hr_ago,
      LAG(trips, 168) OVER w AS trips_7d_ago,
      LAG(trips, 336) OVER w AS trips_14d_ago,
      AVG(trips) OVER (w RANGE BETWEEN 336 HOUR PRECEDING AND 1 HOUR PRECEDING) AS ma_14d,
      STDDEV_POP(trips) OVER (w RANGE BETWEEN 336 HOUR PRECEDING AND 1 HOUR PRECEDING) AS sd_14d,
      AVG(trips) OVER (w RANGE BETWEEN 504 HOUR PRECEDING AND 1 HOUR PRECEDING) AS ma_21d,
      STDDEV_POP(trips) OVER (w RANGE BETWEEN 504 HOUR PRECEDING AND 1 HOUR PRECEDING) AS sd_21d
    FROM hist
    WINDOW w AS (PARTITION BY zip_code ORDER BY hr_ts)
  )
  SELECT * FROM calc
  WHERE DATE(hr_ts) = '2015-01-01'
)
ORDER BY trips DESC
LIMIT 5;
```
