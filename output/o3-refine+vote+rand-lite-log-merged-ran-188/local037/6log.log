```sql
-- Description: Inspect the various payment methods shoppers can use
SELECT DISTINCT "payment_type"
FROM "olist_order_payments"
LIMIT 20;
```

```sql
-- Description: Take a look at how orders are linked to product categories (one line per SK-U in the order)
SELECT ooi."order_id",
       op."product_category_name"
FROM   "olist_order_items"  AS ooi
JOIN   "olist_products"     AS op
       ON op."product_id" = ooi."product_id"
LIMIT 20;
```

```sql
-- Description: Count how many payments fall into each (category, payment-type) pair
SELECT op."product_category_name"        AS "category",
       oop."payment_type",
       COUNT(*)                          AS "payments_cnt"
FROM   "olist_order_payments"  AS oop
JOIN   "olist_order_items"     AS ooi  ON ooi."order_id" = oop."order_id"
JOIN   "olist_products"        AS op   ON op."product_id" = ooi."product_id"
GROUP  BY op."product_category_name",
          oop."payment_type"
LIMIT 20;
```

```sql
-- Description: For every category, rank payment types by their volume (1 = most used)
SELECT op."product_category_name"                AS "category",
       oop."payment_type",
       COUNT(*)                                   AS "payments_cnt",
       ROW_NUMBER() OVER (PARTITION BY op."product_category_name"
                          ORDER BY COUNT(*) DESC) AS "rn"
FROM   "olist_order_payments"  AS oop
JOIN   "olist_order_items"     AS ooi  ON ooi."order_id" = oop."order_id"
JOIN   "olist_products"        AS op   ON op."product_id" = ooi."product_id"
GROUP  BY op."product_category_name",
          oop."payment_type"
LIMIT 20;
```

```sql
-- Description: Keep only the dominant (most used) payment type of each category
SELECT *
FROM (
        SELECT op."product_category_name"                AS "category",
               oop."payment_type",
               COUNT(*)                                   AS "payments_cnt",
               ROW_NUMBER() OVER (PARTITION BY op."product_category_name"
                                  ORDER BY COUNT(*) DESC) AS "rn"
        FROM   "olist_order_payments"  AS oop
        JOIN   "olist_order_items"     AS ooi  ON ooi."order_id" = oop."order_id"
        JOIN   "olist_products"        AS op   ON op."product_id" = ooi."product_id"
        GROUP  BY op."product_category_name",
                  oop."payment_type"
     )
WHERE  "rn" = 1
LIMIT 20;
```

```sql
-- Description: Order the dominant-payment rows by payment volume so we can spot the leaders
SELECT *
FROM (
        SELECT op."product_category_name"                AS "category",
               oop."payment_type",
               COUNT(*)                                   AS "payments_cnt",
               ROW_NUMBER() OVER (PARTITION BY op."product_category_name"
                                  ORDER BY COUNT(*) DESC) AS "rn"
        FROM   "olist_order_payments"  AS oop
        JOIN   "olist_order_items"     AS ooi  ON ooi."order_id" = oop."order_id"
        JOIN   "olist_products"        AS op   ON op."product_id" = ooi."product_id"
        GROUP  BY op."product_category_name",
                  oop."payment_type"
     )
WHERE  "rn" = 1
ORDER  BY "payments_cnt" DESC
LIMIT 10;
```

```sql
-- Description: Final answer – the three categories whose most-common payment type has the largest number of payments
SELECT *
FROM (
        SELECT op."product_category_name"                AS "category",
               oop."payment_type",
               COUNT(*)                                   AS "payments_cnt",
               ROW_NUMBER() OVER (PARTITION BY op."product_category_name"
                                  ORDER BY COUNT(*) DESC) AS "rn"
        FROM   "olist_order_payments"  AS oop
        JOIN   "olist_order_items"     AS ooi  ON ooi."order_id" = oop."order_id"
        JOIN   "olist_products"        AS op   ON op."product_id" = ooi."product_id"
        GROUP  BY op."product_category_name",
                  oop."payment_type"
     )
WHERE  "rn" = 1
ORDER  BY "payments_cnt" DESC
LIMIT 3;
```
