Query:
--Description: One–stop summary: variants, total AC, total alt-alleles, gene symbols & mutation density.
SELECT
  variant_count,
  total_allele_count,
  total_alt_alleles,
  region_length,
  ROUND(region_length / variant_count, 2) AS bases_per_variant,
  gene_symbols
FROM (
  SELECT
    COUNT(DISTINCT start_position)                            AS variant_count,
    SUM(alt.AC)                                               AS total_allele_count,
    SUM(alt.n_alt_alleles)                                    AS total_alt_alleles,
    ARRAY_AGG(DISTINCT vep.SYMBOL IGNORE NULLS)               AS gene_symbols,
    (55064852 - 55039447 + 1)                                 AS region_length
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
  UNNEST(alternate_bases) AS alt
  LEFT JOIN UNNEST(alt.vep) AS vep
  WHERE reference_name = 'chr1'
    AND start_position BETWEEN 55039447 AND 55064852
)
LIMIT 20;
Answer:
variant_count,total_allele_count,total_alt_alleles,region_length,bases_per_variant,gene_symbols
