```sql
--Description: Peek at the first 20 variants (one row per alt allele) in the target region.
SELECT
  reference_name,
  start_position,
  alternate.alt            AS alt_base,
  alternate.AC             AS allele_count,
  alternate.AF             AS allele_freq
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
UNNEST(alternate_bases) AS alternate
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
--Description: Count how many variant *records* (one row per genomic position) fall in the region.
SELECT
  COUNT(*) AS variant_count
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
--Description: Sum the total allele count (AC) across all alternate alleles in the region.
SELECT
  SUM(alternate.AC) AS total_allele_count
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
UNNEST(alternate_bases) AS alternate
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
--Description: Sum the number of alternate alleles reported at every variant site (n_alt_alleles).
SELECT
  SUM(alternate.n_alt_alleles) AS total_number_of_alt_alleles
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
UNNEST(alternate_bases) AS alternate
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
--Description: List distinct gene symbols (from VEP annotation) touched by variants in the region.
SELECT DISTINCT
  vep.SYMBOL
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
UNNEST(alternate_bases) AS alt,
UNNEST(alt.vep)        AS vep
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
  AND vep.SYMBOL IS NOT NULL
LIMIT 20;
```

```sql
--Description: Compute mutation density = region length / #variants (bases per variant).
SELECT
  COUNT(*)                                          AS variant_count,
  (55064852 - 55039447 + 1)                         AS region_length_bp,
  (55064852 - 55039447 + 1) / COUNT(*) AS bases_per_variant
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
--Description: One–stop summary: variants, total AC, total alt-alleles, gene symbols & mutation density.
SELECT
  variant_count,
  total_allele_count,
  total_alt_alleles,
  region_length,
  ROUND(region_length / variant_count, 2) AS bases_per_variant,
  gene_symbols
FROM (
  SELECT
    COUNT(DISTINCT start_position)                            AS variant_count,
    SUM(alt.AC)                                               AS total_allele_count,
    SUM(alt.n_alt_alleles)                                    AS total_alt_alleles,
    ARRAY_AGG(DISTINCT vep.SYMBOL IGNORE NULLS)               AS gene_symbols,
    (55064852 - 55039447 + 1)                                 AS region_length
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
  UNNEST(alternate_bases) AS alt
  LEFT JOIN UNNEST(alt.vep) AS vep
  WHERE reference_name = 'chr1'
    AND start_position BETWEEN 55039447 AND 55064852
)
LIMIT 20;
```
