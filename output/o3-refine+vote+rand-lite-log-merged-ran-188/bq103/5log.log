Replace or remove the LIMIT clause when you need the full result set.

```sql
-- Description: Peek at raw records in the target interval (basic sanity check)
SELECT
  reference_name,
  start_position,
  end_position,
  alternate_bases
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- Description: Count how many variant rows are present in this region
SELECT
  COUNT(*) AS number_of_variants
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- Description: Sum the alternate-allele counts (AC) for every ALT in the region
SELECT
  SUM(ab.AC) AS total_AC
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
     UNNEST(alternate_bases) AS ab
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- Description: Sum the raw alternate-allele counts (AC_raw) for every ALT
SELECT
  SUM(ab.AC_raw) AS total_AC_raw
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
     UNNEST(alternate_bases) AS ab
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- Description: Count total number of individual alternate alleles reported
SELECT
  COUNT(*) AS total_alt_alleles
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
     UNNEST(alternate_bases) AS ab
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- Description: List all distinct gene symbols (VEP.SYMBOL) found in the region
SELECT DISTINCT
  vep_entry.SYMBOL
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
     UNNEST(alternate_bases) AS ab,
     UNNEST(ab.vep)         AS vep_entry
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
ORDER BY SYMBOL
LIMIT 20;
```

```sql
-- Description: Produce one-row summary: #variants, total_AC_raw, region length, density
WITH region_variants AS (
  SELECT
    COUNT(*)                       AS num_variants,
    SUM(ab.AC_raw)                 AS total_AC_raw
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
       UNNEST(alternate_bases) AS ab
  WHERE reference_name = 'chr1'
    AND start_position BETWEEN 55039447 AND 55064852
)
SELECT
  num_variants,
  total_AC_raw,
  55064852 - 55039447 + 1 AS region_length_bp,
  CAST(region_length_bp AS FLOAT64) / num_variants AS mutation_density_bp_per_variant
FROM region_variants
LIMIT 20;
```

```sql
-- Description: Show each distinct gene symbol with how many variants map to it
SELECT
  vep_entry.SYMBOL,
  COUNT(DISTINCT start_position) AS variants_per_gene
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
     UNNEST(alternate_bases) AS ab,
     UNNEST(ab.vep)         AS vep_entry
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
GROUP BY vep_entry.SYMBOL
ORDER BY variants_per_gene DESC
LIMIT 20;
```
