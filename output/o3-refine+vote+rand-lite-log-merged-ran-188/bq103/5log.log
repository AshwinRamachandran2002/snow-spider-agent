```sql
--Description / Thinking process:
-- • Goal: create a one-row summary for chr1 positions 55 039 447–55 064 852 in gnomAD v3 genomes.
-- • We need the number of variant *rows* (num_variants) and the sum of raw allele counts (total_AC_raw).
-- • Also want the length of the interval (region_length_bp) so we can derive mutation_density.
-- • region_length_bp is a constant, but if we reference it outside its definition BigQuery complains,
--   so we define it inside the same SELECT that produces num_variants and total_AC_raw.
-- • Finally we compute mutation_density_bp_per_variant = region_length_bp / num_variants.
-- • Wrapping everything in a single subquery keeps the calculation readable and prevents name errors.

SELECT
  num_variants,
  total_AC_raw,
  region_length_bp,
  region_length_bp / num_variants AS mutation_density_bp_per_variant
FROM (
  SELECT
    COUNT(*) AS num_variants,          -- count of variant rows in interval
    SUM(ab.AC_raw) AS total_AC_raw,    -- sum of raw allele counts across all ALT alleles
    55064852 - 55039447 + 1 AS region_length_bp
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
  CROSS JOIN UNNEST(alternate_bases) AS ab
  WHERE reference_name = 'chr1'
    AND start_position BETWEEN 55039447 AND 55064852
) AS region_stats
LIMIT 20;
```
