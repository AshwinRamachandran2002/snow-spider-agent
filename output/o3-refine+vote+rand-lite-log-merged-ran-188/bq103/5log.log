--Description: Count distinct variant rows that map to each gene symbol (VEP.SYMBOL) 
--             within chr1 positions 55 039 447–55 064 852.  
--             Uses CROSS JOIN syntax to make joins explicit; no external column
--             references, so it avoids the “unrecognized name” issue.

SELECT
  vep.SYMBOL,
  COUNT(DISTINCT v.start_position) AS variants_per_gene
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` AS v
CROSS JOIN UNNEST(v.alternate_bases) AS alt
CROSS JOIN UNNEST(alt.vep)          AS vep
WHERE v.reference_name = 'chr1'
  AND v.start_position BETWEEN 55039447 AND 55064852
GROUP BY vep.SYMBOL
ORDER BY variants_per_gene DESC
LIMIT 20
