```sql
--Description / thinking process:
-- • Goal: list all unique gene symbols (non-NULL) annotated by VEP for variants
--   located in chr1:55,039,447-55,064,852 in gnomAD v3 genomes, and count them.
-- • Steps:
--   1) Restrict rows to chromosome 1 and desired coordinate window.
--   2) UNNEST alternate_bases to examine each alternate allele separately.
--   3) UNNEST alt.vep to reach per-consequence gene annotations.
--   4) Filter out NULL symbols so ARRAY_AGG does not raise a “null element” error.
--   5) Use ARRAY_AGG(DISTINCT … IGNORE NULLS) to gather the distinct symbols,
--      and COUNT(DISTINCT …) to obtain how many genes occur in the interval.

SELECT
  ARRAY_AGG(DISTINCT vep.SYMBOL IGNORE NULLS) AS genes,   -- all distinct gene symbols
  COUNT(DISTINCT vep.SYMBOL)                  AS gene_count
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
CROSS JOIN UNNEST(alternate_bases) AS alt
CROSS JOIN UNNEST(alt.vep)         AS vep
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
  AND vep.SYMBOL IS NOT NULL;
```
