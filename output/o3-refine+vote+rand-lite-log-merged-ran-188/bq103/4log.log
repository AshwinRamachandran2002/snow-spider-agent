Below are 10 progressively-more-complex queries that explore, then summarise, the gnomAD v3 chr1 data in the interval 55 039 447 – 55 064 852.  
(Replace, add or remove the LIMIT clause while working – it is kept here just to stay within the requested 20-row preview.)

```sql
-- 1) Quick look at the raw rows that fall inside the target region
SELECT
  reference_name,
  start_position,
  end_position,
  alternate_bases
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 2) Unnest the `alternate_bases` array to inspect per-allele fields
SELECT
  start_position,
  alt.alt,
  alt.AC,
  alt.AF,
  alt.n_alt_alleles,
  alt.vep                       -- still an ARRAY; inspect next
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
  UNNEST(alternate_bases) AS alt
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 3) Drill one level deeper: explode the VEP annotations
SELECT
  start_position,
  vep.SYMBOL     AS gene_symbol,
  vep.Consequence
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
  UNNEST(alternate_bases) AS alt,
  UNNEST(alt.vep)    AS vep
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 4) Count how many variant rows (one row ≈ one variant position) exist
SELECT
  COUNT(*) AS variant_count
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 5) Total allele count (SUM of AC across every alternate allele)
SELECT
  SUM(alt.AC) AS total_AC
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
  UNNEST(alternate_bases) AS alt
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 6) Total raw allele count (SUM of AC_raw across every alternate allele)
SELECT
  SUM(alt.AC_raw) AS total_AC_raw
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
  UNNEST(alternate_bases) AS alt
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 7) List distinct gene symbols that VEP assigns in this interval
SELECT DISTINCT
  vep.SYMBOL AS gene_symbol
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
  UNNEST(alternate_bases) AS alt,
  UNNEST(alt.vep)    AS vep
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
  AND vep.SYMBOL IS NOT NULL
LIMIT 20;
```

```sql
-- 8) Aggregate all unique gene symbols into an ARRAY and count them
SELECT
  ARRAY_AGG(DISTINCT vep.SYMBOL) AS genes,
  COUNT(DISTINCT vep.SYMBOL)     AS gene_count
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`,
  UNNEST(alternate_bases) AS alt,
  UNNEST(alt.vep)          AS vep
WHERE reference_name = 'chr1'
  AND start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 9) Compute mutation density: bases per variant (region length / N variants)
WITH variant_ct AS (
  SELECT COUNT(*) AS variant_count
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
  WHERE reference_name = 'chr1'
    AND start_position BETWEEN 55039447 AND 55064852
)
SELECT
  55064852 - 55039447 + 1                           AS region_length,
  variant_count,
  (55064852 - 55039447 + 1) / variant_count         AS bases_per_variant
FROM variant_ct
LIMIT 20;
```

```sql
-- 10) Final one-shot summary: variant count, allele totals, gene list & density
WITH region AS (
  SELECT *
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
  WHERE reference_name = 'chr1'
    AND start_position BETWEEN 55039447 AND 55064852
),
allele_totals AS (
  SELECT
    SUM(alt.AC)      AS total_AC,
    SUM(alt.AC_raw)  AS total_AC_raw
  FROM region, UNNEST(alternate_bases) AS alt
),
gene_syms AS (
  SELECT ARRAY_AGG(DISTINCT vep.SYMBOL) AS distinct_genes
  FROM region, UNNEST(alternate_bases) AS alt, UNNEST(alt.vep) AS vep
  WHERE vep.SYMBOL IS NOT NULL
),
variant_ct AS (
  SELECT COUNT(*) AS variant_count
  FROM region
)
SELECT
  55064852 - 55039447 + 1                                    AS region_length,
  variant_ct.variant_count,
  allele_totals.total_AC,
  allele_totals.total_AC_raw,
  distinct_genes,
  (55064852 - 55039447 + 1) / variant_ct.variant_count       AS bases_per_variant
FROM variant_ct, allele_totals, gene_syms
LIMIT 20;
```

These queries should let you inspect the data, derive the requested statistics, and finally obtain a concise summary for chromosome 1 positions 55 039 447-55 064 852 in gnomAD v3 genomes.
