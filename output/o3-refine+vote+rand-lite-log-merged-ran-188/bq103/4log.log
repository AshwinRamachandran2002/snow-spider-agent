Query:
--Description: Compute the mutation density for the region
--             chr1:55 039 447-55 064 852 in gnomAD v3 genomes.
--             1) Count how many variants (rows) fall in the interval.
--             2) Region length = end – start + 1.
--             3) Density (bases per variant) = region_length / variant_count.
WITH variant_ct AS (
  SELECT COUNT(*) AS variant_count
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
  WHERE reference_name = 'chr1'
    AND start_position BETWEEN 55039447 AND 55064852
)
SELECT
  55064852 - 55039447 + 1                       AS region_length,
  variant_count,
  (55064852 - 55039447 + 1) / variant_count     AS bases_per_variant
FROM variant_ct
LIMIT 20
Answer:
region_length,variant_count,bases_per_variant
25406,5604,4.533547466095646
Query:
--Description: One-shot summary for chr1:55 039 447-55 064 852 in gnomAD v3 genomes.
--             Returns region length, variant count, summed allele counts (AC & AC_raw),
--             array of distinct gene symbols (NULLs ignored), and mutation density.
WITH region AS (
  SELECT *
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
  WHERE reference_name = 'chr1'
    AND start_position BETWEEN 55039447 AND 55064852
),
allele_totals AS (
  SELECT
    SUM(alt.AC)     AS total_AC,
    SUM(alt.AC_raw) AS total_AC_raw
  FROM region
  CROSS JOIN UNNEST(alternate_bases) AS alt
),
gene_syms AS (
  SELECT
    ARRAY_AGG(DISTINCT vep.SYMBOL IGNORE NULLS) AS distinct_genes
  FROM region
  CROSS JOIN UNNEST(alternate_bases) AS alt
  CROSS JOIN UNNEST(alt.vep)          AS vep
  WHERE vep.SYMBOL IS NOT NULL        -- remove NULLs to avoid array error
),
variant_ct AS (
  SELECT COUNT(*) AS variant_count
  FROM region
)
SELECT
  55064852 - 55039447 + 1                                AS region_length,
  variant_ct.variant_count,
  allele_totals.total_AC,
  allele_totals.total_AC_raw,
  distinct_genes,
  (55064852 - 55039447 + 1) / variant_ct.variant_count   AS bases_per_variant
FROM variant_ct, allele_totals, gene_syms
LIMIT 20
Answer:
region_length,variant_count,total_AC,total_AC_raw,distinct_genes,bases_per_variant
25406,5604,7917038,7957421,"['PCSK9', 'USP24']",4.533547466095646
