Below are up-to-ten different BigQuery SQL snippets that gradually explore the requested region on chromosome 17 and finally compute Hardy-Weinberg χ² together with the requested counts and allele frequencies.

```sql
-- 1.  Preview the raw rows for the region of interest
SELECT *
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 2.  List the distinct (reference_bases, alternate_bases) pairs in the interval
SELECT DISTINCT reference_bases,
       alternate_bases
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499;
```

```sql
-- 3.  See which Variant Types (‘VT’ tag) are annotated in this interval
SELECT DISTINCT VT
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499;
```

```sql
-- 4.  Inspect a few genotypes (UNNEST the call array) for one variant
SELECT v.start,
       c.call_set_name,
       c.genotype                 AS gt_array
FROM   `spider2-public-data.1000_genomes.variants` AS v,
       UNNEST(v.call)             AS c
WHERE  v.reference_name = '17'
  AND  v.start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 5.  Count non-missing diploid genotypes per variant
SELECT start,
       COUNTIF(ARRAY_LENGTH(c.genotype)=2 AND c.genotype[OFFSET(0)]!=-1 AND c.genotype[OFFSET(1)]!=-1) AS n_genotypes
FROM   `spider2-public-data.1000_genomes.variants` AS v,
       UNNEST(v.call) AS c
WHERE  v.reference_name = '17'
  AND  v.start BETWEEN 41196311 AND 41277499
GROUP BY start
LIMIT 20;
```

```sql
-- 6.  Observed genotype category counts (hom-ref, het, hom-alt) per variant
SELECT v.reference_name,
       v.start,
       v.end,
       SUM(CASE WHEN gt[0]=0 AND gt[1]=0               THEN 1 ELSE 0 END) AS obs_hom_ref,
       SUM(CASE WHEN (gt[0]=0 AND gt[1]=1) OR
                      (gt[0]=1 AND gt[1]=0)           THEN 1 ELSE 0 END) AS obs_het,
       SUM(CASE WHEN gt[0]=1 AND gt[1]=1               THEN 1 ELSE 0 END) AS obs_hom_alt
FROM   `spider2-public-data.1000_genomes.variants` AS v,
       UNNEST(v.call)                AS c,
       UNNEST([c.genotype])          AS gt
WHERE  v.reference_name = '17'
  AND  v.start BETWEEN 41196311 AND 41277499
  AND  ARRAY_LENGTH(c.genotype)=2
  AND  gt[0] IN (0,1) AND gt[1] IN (0,1)            -- ignore missing / multi-allelic
GROUP BY v.reference_name, v.start, v.end
LIMIT 20;
```

```sql
-- 7.  Add allele counts & allele frequencies (p = ref, q = alt) per variant
WITH genos AS (
  SELECT v.start,
         ARRAY_LENGTH(c.genotype)=2 AS dip,
         c.genotype                 AS g
  FROM   `spider2-public-data.1000_genomes.variants` AS v,
         UNNEST(v.call) AS c
  WHERE  v.reference_name = '17'
    AND  v.start BETWEEN 41196311 AND 41277499
)
SELECT start,
       SUM(CASE WHEN dip THEN 2 END)                       AS total_alleles,
       SUM(CASE WHEN dip THEN 2 - (g[0]+g[1]) END)         AS ref_alleles,
       SUM(CASE WHEN dip THEN      (g[0]+g[1]) END)        AS alt_alleles,
       SAFE_DIVIDE(SUM(CASE WHEN dip THEN      (g[0]+g[1]) END),
                   SUM(CASE WHEN dip THEN 2 END))          AS q_freq,
       1 - SAFE_DIVIDE(SUM(CASE WHEN dip THEN (g[0]+g[1]) END),
                       SUM(CASE WHEN dip THEN 2 END))      AS p_freq
FROM genos
WHERE dip AND g[0] IN (0,1) AND g[1] IN (0,1)
GROUP BY start
LIMIT 20;
```

```sql
-- 8.  Compute expected genotype counts under HWE and χ² statistic per variant
WITH obs AS (
  SELECT v.start,
         SUM(CASE WHEN gt[0]=0 AND gt[1]=0 THEN 1 END) AS hom_ref,
         SUM(CASE WHEN (gt[0]=0 AND gt[1]=1) OR (gt[0]=1 AND gt[1]=0) THEN 1 END) AS het,
         SUM(CASE WHEN gt[0]=1 AND gt[1]=1 THEN 1 END) AS hom_alt
  FROM   `spider2-public-data.1000_genomes.variants` AS v,
         UNNEST(v.call) AS c,
         UNNEST([c.genotype]) AS gt
  WHERE  v.reference_name = '17'
    AND  v.start BETWEEN 41196311 AND 41277499
    AND  ARRAY_LENGTH(gt)=2
    AND  gt[0] IN (0,1) AND gt[1] IN (0,1)
  GROUP BY v.start
)
SELECT start,
       hom_ref, het, hom_alt,
       (hom_ref+het+hom_alt)                        AS n,
       -- allele freq q = (het + 2*hom_alt)/(2n)
       SAFE_DIVIDE(het + 2*hom_alt , 2*(hom_ref+het+hom_alt)) AS q,
       SAFE_DIVIDE(2*hom_ref + het , 2*(hom_ref+het+hom_alt)) AS p,
       -- expected counts
       (hom_ref+het+hom_alt)*POW(SAFE_DIVIDE(2*hom_ref + het , 2*(hom_ref+het+hom_alt)),2) AS exp_hom_ref,
       2*(hom_ref+het+hom_alt)*
         SAFE_DIVIDE(het + 2*hom_alt , 2*(hom_ref+het+hom_alt))*
         SAFE_DIVIDE(2*hom_ref + het , 2*(hom_ref+het+hom_alt))  AS exp_het,
       (hom_ref+het+hom_alt)*
         POW(SAFE_DIVIDE(het + 2*hom_alt , 2*(hom_ref+het+hom_alt)),2)                       AS exp_hom_alt,
       -- χ²
       ((hom_ref -
         (hom_ref+het+hom_alt)*POW(p,2))*(hom_ref -
         (hom_ref+het+hom_alt)*POW(p,2)) /
         NULLIF((hom_ref+het+hom_alt)*POW(p,2),0) )
     + ((het -
         2*(hom_ref+het+hom_alt)*p*q)*(het -
         2*(hom_ref+het+hom_alt)*p*q) /
         NULLIF(2*(hom_ref+het+hom_alt)*p*q,0) )
     + ((hom_alt -
         (hom_ref+het+hom_alt)*POW(q,2))*(hom_alt -
         (hom_ref+het+hom_alt)*POW(q,2)) /
         NULLIF((hom_ref+het+hom_alt)*POW(q,2),0) )            AS chi_sq
FROM obs
LIMIT 20;
```

```sql
-- 9.  Combine χ², observed/expected counts, allele freqs with INFO-level AF & VT tags
WITH hwe AS ( /* same sub-query as in #8 but keeping all columns */ SELECT * FROM obs )
SELECT v.reference_name,
       v.start,
       v.end,
       v.reference_bases,
       ARRAY_DISTINCT(v.alternate_bases)[OFFSET(0)]         AS alternate_base,
       v.VT                                                 AS variant_type,
       h.chi_sq,
       h.n,
       h.hom_ref   AS obs_hom_ref,
       h.het       AS obs_het,
       h.hom_alt   AS obs_hom_alt,
       h.exp_hom_ref,
       h.exp_het,
       h.exp_hom_alt,
       h.p         AS ref_allele_freq,
       h.q         AS alt_allele_freq,
       v.AF        AS af_from_1kg
FROM   `spider2-public-data.1000_genomes.variants` AS v
JOIN   hwe             h
ON     v.start = h.start
WHERE  v.reference_name = '17'
  AND  v.start BETWEEN 41196311 AND 41277499;
```

```sql
--10.  Final tidy answer, ordered by position
SELECT reference_name,
       start,
       end,
       reference_bases,
       ARRAY_DISTINCT(alternate_bases)[OFFSET(0)]                 AS alternate_base,
       VT                                                         AS variant_type,
       ROUND(chi_sq, 3)                                           AS chi_squared,
       n                                                          AS total_genotypes,
       obs_hom_ref, obs_het, obs_hom_alt,
       ROUND(exp_hom_ref,2) AS exp_hom_ref,
       ROUND(exp_het,2)     AS exp_het,
       ROUND(exp_hom_alt,2) AS exp_hom_alt,
       ROUND(ref_allele_freq,4)  AS p_freq,
       ROUND(alt_allele_freq,4)  AS q_freq,
       AF                                                        AS af_from_1kg
FROM (
  -- Re-use query #9 as sub-query
  SELECT *
  FROM /* query #9 */
)
ORDER BY start
LIMIT 20;
```

Each successive query deepens the analysis, culminating in a single statement (query 10) that returns all requested fields for every variant located on chromosome 17 between positions 41 196 311 and 41 277 499.
