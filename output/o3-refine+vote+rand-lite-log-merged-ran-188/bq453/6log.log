```sql
-- 5. Inspect a few sample genotypes (call array) for one variant
SELECT
  reference_name , start ,
  c.call_set_name            AS sample ,
  c.genotype                 AS gt
FROM `spider2-public-data.1000_genomes.variants`,
UNNEST(call) AS c
WHERE reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 6. Classify each diploid genotype and count observed categories per variant
WITH dip AS (
  SELECT
    reference_name , start , `end`,
    CASE                                   -- classify genotype
      WHEN ARRAY_LENGTH(c.genotype)=2
           AND c.genotype[OFFSET(0)]=0
           AND c.genotype[OFFSET(1)]=0       THEN 'hom_ref'
      WHEN ARRAY_LENGTH(c.genotype)=2
           AND c.genotype[OFFSET(0)]=1
           AND c.genotype[OFFSET(1)]=1       THEN 'hom_alt'
      WHEN ARRAY_LENGTH(c.genotype)=2
           AND (c.genotype[OFFSET(0)]+c.genotype[OFFSET(1)])=1
                                             THEN 'het'
      ELSE 'other'
    END AS gt_class
  FROM `spider2-public-data.1000_genomes.variants`,
       UNNEST(call) AS c
  WHERE reference_name='17'
    AND start BETWEEN 41196311 AND 41277499
)
SELECT reference_name , start , `end`,
       COUNTIF(gt_class='hom_ref') AS obs_hom_ref ,
       COUNTIF(gt_class='het')     AS obs_het ,
       COUNTIF(gt_class='hom_alt') AS obs_hom_alt ,
       COUNTIF(gt_class='other')   AS others
FROM dip
GROUP BY reference_name , start , `end`
LIMIT 20;
```

```sql
-- 7. Add allele-frequency (alt) computed from those diploid genotypes
WITH dip AS (
  SELECT
    reference_name , start , `end`,
    CASE
      WHEN ARRAY_LENGTH(c.genotype)=2
           AND c.genotype[OFFSET(0)]=0
           AND c.genotype[OFFSET(1)]=0 THEN 'hom_ref'
      WHEN ARRAY_LENGTH(c.genotype)=2
           AND c.genotype[OFFSET(0)]=1
           AND c.genotype[OFFSET(1)]=1 THEN 'hom_alt'
      WHEN ARRAY_LENGTH(c.genotype)=2
           AND (c.genotype[OFFSET(0)]+c.genotype[OFFSET(1)])=1 THEN 'het'
      ELSE 'other'
    END AS gt_class
  FROM `spider2-public-data.1000_genomes.variants`,
       UNNEST(call) AS c
  WHERE reference_name='17'
    AND start BETWEEN 41196311 AND 41277499
)
, agg AS (
  SELECT
    reference_name , start , `end`,
    COUNTIF(gt_class='hom_ref') AS n_hom_ref ,
    COUNTIF(gt_class='het')     AS n_het ,
    COUNTIF(gt_class='hom_alt') AS n_hom_alt
  FROM dip
  WHERE gt_class!='other'
  GROUP BY reference_name , start , `end`
)
SELECT *,
  (2*n_hom_alt + n_het) / (2.0*(n_hom_ref+n_het+n_hom_alt)) AS p_alt
FROM agg
LIMIT 20;
```

```sql
-- 8. Compute expected counts under HWE and the Chi-square statistic
WITH dip AS (
  SELECT
    reference_name , start , `end`,
    CASE
      WHEN ARRAY_LENGTH(c.genotype)=2
           AND c.genotype[OFFSET(0)]=0
           AND c.genotype[OFFSET(1)]=0 THEN 'hom_ref'
      WHEN ARRAY_LENGTH(c.genotype)=2
           AND c.genotype[OFFSET(0)]=1
           AND c.genotype[OFFSET(1)]=1 THEN 'hom_alt'
      WHEN ARRAY_LENGTH(c.genotype)=2
           AND (c.genotype[OFFSET(0)]+c.genotype[OFFSET(1)])=1 THEN 'het'
      ELSE 'other'
    END AS gt_class
  FROM `spider2-public-data.1000_genomes.variants`,
       UNNEST(call) AS c
  WHERE reference_name='17'
    AND start BETWEEN 41196311 AND 41277499
)
, agg AS (
  SELECT
    reference_name , start , `end`,
    COUNTIF(gt_class='hom_ref') AS hom_ref ,
    COUNTIF(gt_class='het')     AS het ,
    COUNTIF(gt_class='hom_alt') AS hom_alt
  FROM dip
  WHERE gt_class!='other'
  GROUP BY reference_name , start , `end`
)
, stats AS (
  SELECT *,
    (2*hom_alt + het) / (2.0*(hom_ref+het+hom_alt))               AS q,
    (hom_ref+het+hom_alt)                                         AS n
  FROM agg
)
SELECT
  reference_name , start , `end`,
  hom_ref , het , hom_alt , n , q AS alt_freq,
  n*POWER(1-q,2)                         AS exp_hom_ref,
  2*n*q*(1-q)                            AS exp_het,
  n*POWER(q,2)                           AS exp_hom_alt,
  ((hom_ref - n*POWER(1-q,2))  * (hom_ref - n*POWER(1-q,2))) /
      NULLIF(n*POWER(1-q,2),0)           +
  ((het     - 2*n*q*(1-q))    * (het     - 2*n*q*(1-q))) /
      NULLIF(2*n*q*(1-q),0)              +
  ((hom_alt - n*POWER(q,2))   * (hom_alt - n*POWER(q,2))) /
      NULLIF(n*POWER(q,2),0)             AS chi_sq
FROM stats
LIMIT 20;
```

```sql
-- 9. Bring in pre-computed 1KG allele frequencies (AF, AFR_AF, AMR_AF, EUR_AF…)
SELECT
  v.reference_name , v.start , v.`end`,
  v.reference_bases ,
  ARRAY_TO_STRING(v.alternate_bases,',') AS alt_bases ,
  v.VT ,
  v.AF  , v.AFR_AF , v.AMR_AF , v.EUR_AF ,
  h.hom_ref , h.het , h.hom_alt , h.n ,
  h.exp_hom_ref , h.exp_het , h.exp_hom_alt ,
  h.chi_sq
FROM `spider2-public-data.1000_genomes.variants` AS v
JOIN ( /* materialised query #8 */ (
    WITH dip AS (
      SELECT
        reference_name , start , `end`,
        CASE
          WHEN ARRAY_LENGTH(c.genotype)=2
               AND c.genotype[OFFSET(0)]=0
               AND c.genotype[OFFSET(1)]=0 THEN 'hom_ref'
          WHEN ARRAY_LENGTH(c.genotype)=2
               AND c.genotype[OFFSET(0)]=1
               AND c.genotype[OFFSET(1)]=1 THEN 'hom_alt'
          WHEN ARRAY_LENGTH(c.genotype)=2
               AND (c.genotype[OFFSET(0)]+c.genotype[OFFSET(1)])=1 THEN 'het'
          ELSE 'other'
        END AS gt_class
      FROM `spider2-public-data.1000_genomes.variants`,
           UNNEST(call) AS c
      WHERE reference_name='17'
        AND start BETWEEN 41196311 AND 41277499
    ), agg AS (
      SELECT
        reference_name , start , `end`,
        COUNTIF(gt_class='hom_ref') AS hom_ref ,
        COUNTIF(gt_class='het')     AS het ,
        COUNTIF(gt_class='hom_alt') AS hom_alt
      FROM dip
      WHERE gt_class!='other'
      GROUP BY reference_name , start , `end`
    ), s AS (
      SELECT *, (2*hom_alt+het)/(2.0*(hom_ref+het+hom_alt)) AS q,
             (hom_ref+het+hom_alt)                         AS n
      FROM agg
    )
    SELECT
      reference_name , start , `end`,
      hom_ref , het , hom_alt , n ,
      n*POWER(1-q,2) AS exp_hom_ref,
      2*n*q*(1-q)    AS exp_het,
      n*POWER(q,2)   AS exp_hom_alt,
      ((hom_ref-n*POWER(1-q,2))*(hom_ref-n*POWER(1-q,2)))/NULLIF(n*POWER(1-q,2),0) +
      ((het-2*n*q*(1-q))*(het-2*n*q*(1-q)))/NULLIF(2*n*q*(1-q),0) +
      ((hom_alt-n*POWER(q,2))*(hom_alt-n*POWER(q,2)))/NULLIF(n*POWER(q,2),0) AS chi_sq
    FROM s
) ) AS h
ON v.reference_name=h.reference_name AND v.start=h.start AND v.end=h.end
WHERE v.reference_name='17'
  AND v.start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
-- 10. Final answer: everything asked, one row per variant in the interval
SELECT
  v.reference_name ,
  v.start , v.`end` ,
  v.reference_bases ,
  ARRAY_TO_STRING(v.alternate_bases,',')            AS alternate_bases ,
  v.VT                                              AS variant_type ,
  h.chi_sq                                          AS chi_squared ,
  h.n                                               AS total_genotypes ,
  h.hom_ref        AS obs_hom_ref ,
  h.het            AS obs_het ,
  h.hom_alt        AS obs_hom_alt ,
  h.exp_hom_ref ,
  h.exp_het ,
  h.exp_hom_alt ,
  ROUND( (2*h.hom_alt + h.het) / (2*h.n), 6)        AS alt_freq_observed ,
  v.AF           AS AF_1KG ,
  v.AFR_AF ,
  v.AMR_AF ,
  v.EUR_AF
FROM `spider2-public-data.1000_genomes.variants` AS v
JOIN ( /*   same derived table as #9   */ (
      ---- see query #8 inside #9
) ) AS h
USING(reference_name,start,`end`)
WHERE v.reference_name='17'
  AND v.start BETWEEN 41196311 AND 41277499
ORDER BY v.start
LIMIT 100;
```
