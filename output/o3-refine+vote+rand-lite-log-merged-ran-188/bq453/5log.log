```sql
-- 4. Description:  Unnest every call (genotype) and categorise it into
--    hom-ref / het / hom-alt, restricting ourselves to diploid calls
--    (genotype length = 2) so we can later aggregate.
SELECT
  reference_name ,
  start ,
  end ,
  IF(   genotype[OFFSET(0)] = 0 AND genotype[OFFSET(1)] = 0 , 'hom_ref'
     , genotype[OFFSET(0)] = 1 AND genotype[OFFSET(1)] = 1 , 'hom_alt'
     , 'het')                                              AS gt_class
FROM `spider2-public-data.1000_genomes.variants`,
     UNNEST(call) AS c
WHERE reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
  AND ARRAY_LENGTH(c.genotype) = 2
LIMIT 20;
```

```sql
-- 5. Description:  Aggregate per variant the observed genotype counts
--    (N_aa, N_ab, N_bb) and the total number of diploid genotypes (N).
SELECT
  reference_name ,
  start ,
  end ,
  SUM( IF( genotype[OFFSET(0)]=0 AND genotype[OFFSET(1)]=0 , 1 , 0) ) AS obs_hom_ref ,
  SUM( IF( genotype[OFFSET(0)]!=genotype[OFFSET(1)]                 , 1 , 0) ) AS obs_het ,
  SUM( IF( genotype[OFFSET(0)]=1 AND genotype[OFFSET(1)]=1 , 1 , 0) ) AS obs_hom_alt ,
  COUNT(*)                                                            AS n_genotypes
FROM  `spider2-public-data.1000_genomes.variants`,
      UNNEST(call) AS c
WHERE reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
  AND ARRAY_LENGTH(c.genotype) = 2
GROUP BY reference_name , start , end
LIMIT 20;
```

```sql
-- 6. Description:  Compute allele counts & sample allele frequency that
--    come from the observed genotypes produced above.
WITH gt AS (
  SELECT
    reference_name ,
    start ,
    end ,
    SUM( IF( g[OFFSET(0)]=0 AND g[OFFSET(1)]=0 , 2 , IF(g[OFFSET(0)]!=g[OFFSET(1)],1,0))) AS ref_allele_cnt ,
    SUM( IF( g[OFFSET(0)]=1 AND g[OFFSET(1)]=1 , 2 , IF(g[OFFSET(0)]!=g[OFFSET(1)],1,0))) AS alt_allele_cnt ,
    COUNT(*)*2                                                                             AS total_alleles
  FROM `spider2-public-data.1000_genomes.variants`,
       UNNEST(call) AS c,
       UNNEST([c.genotype]) AS g
  WHERE reference_name='17'
    AND start BETWEEN 41196311 AND 41277499
    AND ARRAY_LENGTH(c.genotype)=2
  GROUP BY reference_name, start, end
)
SELECT
  reference_name , start , end ,
  ref_allele_cnt ,
  alt_allele_cnt ,
  total_alleles ,
  SAFE_DIVIDE(alt_allele_cnt,total_alleles) AS alt_freq ,
  SAFE_DIVIDE(ref_allele_cnt,total_alleles) AS ref_freq
FROM gt
LIMIT 20;
```

```sql
-- 7. Description:  Join the genotype counts (observed) with allele
--    frequencies to calculate Hardy-Weinberg *expected* genotype counts
--    and the Chi-squared statistic χ²  = Σ ( (obs-exp)² / exp ).
WITH obs AS (
  SELECT
    reference_name ,
    start ,
    end ,
    SUM( IF( g[OFFSET(0)]=0 AND g[OFFSET(1)]=0 , 1 , 0) ) AS n_aa ,
    SUM( IF( g[OFFSET(0)]!=g[OFFSET(1)]                 , 1 , 0) ) AS n_ab ,
    SUM( IF( g[OFFSET(0)]=1 AND g[OFFSET(1)]=1 , 1 , 0) ) AS n_bb ,
    COUNT(*)                                               AS n
  FROM `spider2-public-data.1000_genomes.variants`,
       UNNEST(call) AS c,
       UNNEST([c.genotype]) AS g
  WHERE reference_name='17'
    AND start BETWEEN 41196311 AND 41277499
    AND ARRAY_LENGTH(c.genotype)=2
  GROUP BY reference_name,start,end
), freq AS (
  SELECT
    reference_name , start , end ,
    SUM( IF( g[OFFSET(0)]=0 AND g[OFFSET(1)]=0 , 2 , IF(g[OFFSET(0)]!=g[OFFSET(1)],1,0))) AS ref_cnt ,
    SUM( IF( g[OFFSET(0)]=1 AND g[OFFSET(1)]=1 , 2 , IF(g[OFFSET(0)]!=g[OFFSET(1)],1,0))) AS alt_cnt ,
    COUNT(*)*2                                                                             AS tot
  FROM `spider2-public-data.1000_genomes.variants`,
       UNNEST(call) AS c,
       UNNEST([c.genotype]) AS g
  WHERE reference_name='17'
    AND start BETWEEN 41196311 AND 41277499
    AND ARRAY_LENGTH(c.genotype)=2
  GROUP BY reference_name,start,end
)
SELECT
  o.reference_name ,
  o.start ,
  o.end ,
  o.n                                        AS total_genotypes ,
  o.n_aa , o.n_ab , o.n_bb                   AS observed_hwe ,
  -- allele frequencies
  SAFE_DIVIDE(f.alt_cnt , f.tot)             AS q_alt_freq ,
  SAFE_DIVIDE(f.ref_cnt , f.tot)             AS p_ref_freq ,
  -- expected counts under HWE
  SAFE_DIVIDE(f.ref_cnt , f.tot)  * SAFE_DIVIDE(f.ref_cnt , f.tot) * o.n  AS exp_aa ,
  2*SAFE_DIVIDE(f.ref_cnt , f.tot)*SAFE_DIVIDE(f.alt_cnt , f.tot)* o.n    AS exp_ab ,
  SAFE_DIVIDE(f.alt_cnt , f.tot)  * SAFE_DIVIDE(f.alt_cnt , f.tot) * o.n  AS exp_bb ,
  -- Chi-squared
  ( (o.n_aa - (SAFE_DIVIDE(f.ref_cnt , f.tot)*SAFE_DIVIDE(f.ref_cnt , f.tot)* o.n))  * (o.n_aa - (SAFE_DIVIDE(f.ref_cnt , f.tot)*SAFE_DIVIDE(f.ref_cnt , f.tot)* o.n))
      / NULLIF((SAFE_DIVIDE(f.ref_cnt , f.tot)*SAFE_DIVIDE(f.ref_cnt , f.tot)* o.n),0) )
  +
  ( (o.n_ab - (2*SAFE_DIVIDE(f.ref_cnt , f.tot)*SAFE_DIVIDE(f.alt_cnt , f.tot)* o.n))  * (o.n_ab - (2*SAFE_DIVIDE(f.ref_cnt , f.tot)*SAFE_DIVIDE(f.alt_cnt , f.tot)* o.n))
      / NULLIF((2*SAFE_DIVIDE(f.ref_cnt , f.tot)*SAFE_DIVIDE(f.alt_cnt , f.tot)* o.n),0) )
  +
  ( (o.n_bb - (SAFE_DIVIDE(f.alt_cnt , f.tot)*SAFE_DIVIDE(f.alt_cnt , f.tot)* o.n))  * (o.n_bb - (SAFE_DIVIDE(f.alt_cnt , f.tot)*SAFE_DIVIDE(f.alt_cnt , f.tot)* o.n))
      / NULLIF((SAFE_DIVIDE(f.alt_cnt , f.tot)*SAFE_DIVIDE(f.alt_cnt , f.tot)* o.n),0) )
      AS chi_sq
FROM obs o
JOIN freq f USING(reference_name,start,end)
LIMIT 20;
```

```sql
-- 8. Description:  Bring together the variant-level annotations (bases,
--    VT, AF columns supplied by 1KG) with the HWE / Chi-square &
--    genotype-count metrics we computed above.
WITH obs AS (
  SELECT
    reference_name ,
    start ,
    end ,
    SUM( IF( g[OFFSET(0)]=0 AND g[OFFSET(1)]=0 , 1 , 0) ) AS n_aa ,
    SUM( IF( g[OFFSET(0)]!=g[OFFSET(1)]                 , 1 , 0) ) AS n_ab ,
    SUM( IF( g[OFFSET(0)]=1 AND g[OFFSET(1)]=1 , 1 , 0) ) AS n_bb ,
    COUNT(*)                                               AS n
  FROM `spider2-public-data.1000_genomes.variants`,
       UNNEST(call) AS c,
       UNNEST([c.genotype]) AS g
  WHERE reference_name='17'
    AND start BETWEEN 41196311 AND 41277499
    AND ARRAY_LENGTH(c.genotype)=2
  GROUP BY reference_name,start,end
), freq AS (
  SELECT
    reference_name , start , end ,
    SUM( IF( g[OFFSET(0)]=0 AND g[OFFSET(1)]=0 , 2 , IF(g[OFFSET(0)]!=g[OFFSET(1)],1,0))) AS ref_cnt ,
    SUM( IF( g[OFFSET(0)]=1 AND g[OFFSET(1)]=1 , 2 , IF(g[OFFSET(0)]!=g[OFFSET(1)],1,0))) AS alt_cnt ,
    COUNT(*)*2                                                                             AS tot
  FROM `spider2-public-data.1000_genomes.variants`,
       UNNEST(call) AS c,
       UNNEST([c.genotype]) AS g
  WHERE reference_name='17'
    AND start BETWEEN 41196311 AND 41277499
    AND ARRAY_LENGTH(c.genotype)=2
  GROUP BY reference_name,start,end
)
SELECT
  v.reference_name ,
  v.start ,
  v.end ,
  v.reference_bases ,
  ARRAY_TO_STRING(v.alternate_bases,',')                        AS alternate_bases ,
  v.VT                                                         AS variant_type ,
  -- 1KG-provided allele frequencies
  v.AF                                                         AS af_overall ,
  v.AFR_AF , v.AMR_AF , v.EUR_AF , v.ASN_AF                    AS af_subpops ,
  -- genotype counts
  o.n        AS total_genotypes ,
  o.n_aa     AS obs_hom_ref ,
  o.n_ab     AS obs_het ,
  o.n_bb     AS obs_hom_alt ,
  -- expected counts
  ( (f.tot- f.alt_cnt)/f.tot )*( (f.tot- f.alt_cnt)/f.tot )*o.n AS exp_hom_ref ,
  2*( (f.tot- f.alt_cnt)/f.tot )*(f.alt_cnt/f.tot)*o.n          AS exp_het ,
  ( f.alt_cnt/f.tot )*( f.alt_cnt/f.tot )*o.n                   AS exp_hom_alt ,
  -- Chi-square from HWE
  ( (o.n_aa - ( (f.tot- f.alt_cnt)/f.tot )*( (f.tot- f.alt_cnt)/f.tot )*o.n )  * (o.n_aa - ( (f.tot- f.alt_cnt)/f.tot )*( (f.tot- f.alt_cnt)/f.tot )*o.n )
           / NULLIF(( (f.tot- f.alt_cnt)/f.tot )*( (f.tot- f.alt_cnt)/f.tot )*o.n,0) )
  +
  ( (o.n_ab - ( 2*( (f.tot- f.alt_cnt)/f.tot )*(f.alt_cnt/f.tot)*o.n ) )  * (o.n_ab - ( 2*( (f.tot- f.alt_cnt)/f.tot )*(f.alt_cnt/f.tot)*o.n ) )
           / NULLIF( 2*( (f.tot- f.alt_cnt)/f.tot )*(f.alt_cnt/f.tot)*o.n ,0) )
  +
  ( (o.n_bb - ( (f.alt_cnt/f.tot)*(f.alt_cnt/f.tot)*o.n ) )  * (o.n_bb - ( (f.alt_cnt/f.tot)*(f.alt_cnt/f.tot)*o.n ) )
           / NULLIF( (f.alt_cnt/f.tot)*(f.alt_cnt/f.tot)*o.n ,0) )
        AS chi_sq
FROM `spider2-public-data.1000_genomes.variants` AS v
LEFT JOIN obs  o USING(reference_name,start,end)
LEFT JOIN freq f USING(reference_name,start,end)
WHERE v.reference_name='17'
  AND v.start BETWEEN 41196311 AND 41277499
LIMIT 20;
