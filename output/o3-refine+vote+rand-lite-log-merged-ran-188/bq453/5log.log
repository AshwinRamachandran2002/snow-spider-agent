```sql
--Description:  Extract a preview (20 rows) of the distinct alternate alleles
--              present on chromosome 17 between positions 41 196 311 and 41 277 499.
--              Steps:  
--                1.  UNNEST(alternate_bases) to convert the ARRAY into one row
--                    per allele.  
--                2.  Use DISTINCT to show each unique allele only once.  
--                3.  Back-tick `start` in the WHERE clause because it is a SQL
--                    keyword.  
--                4.  Limit to 20 rows for a concise inspection.
SELECT DISTINCT
  alt AS alternate_base
FROM `spider2-public-data.1000_genomes.variants`,
     UNNEST(alternate_bases) AS alt
WHERE reference_name = '17'
  AND `start` BETWEEN 41196311 AND 41277499
LIMIT 20;
```
