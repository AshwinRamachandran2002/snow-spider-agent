    ) - SUM(`existing_installs_count`)                               AS gap_installations
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  GROUP BY `state_name`
) AS ct
USING (`state_name`)
LIMIT 20;
