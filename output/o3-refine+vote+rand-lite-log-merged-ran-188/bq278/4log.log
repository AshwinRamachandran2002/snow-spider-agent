      )
    )                                AS pc_potential
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
  GROUP BY `state_name`
),
ct AS (
  SELECT
    `state_name`,
    SUM(`count_qualified`)           AS ct_total_buildings,
    AVG(`percent_covered`)           AS ct_avg_covered,
    AVG(`percent_qualified`)         AS ct_avg_suitable,
    SUM(`number_of_panels_total`)    AS ct_panels,
    SUM(`kw_total`)                  AS ct_kw,
    SUM(`yearly_sunlight_kwh_total`) AS ct_kwh,
    SUM(`carbon_offset_metric_tons`) AS ct_co2,
    SUM(`existing_installs_count`)   AS ct_current,
    SUM(
      SAFE_DIVIDE(
        SAFE_DIVIDE(`count_qualified`, NULLIF(`percent_qualified`,0)/100.0),
        NULLIF(`percent_covered`,0)/100.0
      )
    )                                AS ct_potential
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  GROUP BY `state_name`
)
SELECT
  pc.`state_name`,
  pc_total_buildings,  ct_total_buildings,
  pc_avg_covered,      ct_avg_covered,
  pc_avg_suitable,     ct_avg_suitable,
  pc_panels,           ct_panels,
  pc_kw,               ct_kw,
  pc_kwh,              ct_kwh,
  pc_co2,              ct_co2,
  pc_current,          ct_current,
  (pc_potential - pc_current) AS pc_gap,
  (ct_potential - ct_current) AS ct_gap
FROM pc
FULL JOIN ct
USING (`state_name`)
LIMIT 20;
