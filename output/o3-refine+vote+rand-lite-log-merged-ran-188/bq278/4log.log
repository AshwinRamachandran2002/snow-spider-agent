SELECT
  pc.`state_name`,
  pc.total_qualified_buildings     AS postal_total_buildings,
  ct.total_qualified_buildings     AS census_total_buildings,
  pc.avg_percent_covered           AS postal_avg_covered,
  ct.avg_percent_covered           AS census_avg_covered,
  pc.avg_percent_qualified         AS postal_avg_suitable,
  ct.avg_percent_qualified         AS census_avg_suitable,
  pc.total_panel_count             AS postal_panel_count,
  ct.total_panel_count             AS census_panel_count,
  pc.total_kw_capacity             AS postal_kw_capacity,
  ct.total_kw_capacity             AS census_kw_capacity,
  pc.total_kwh_potential           AS postal_kwh_potential,
  ct.total_kwh_potential           AS census_kwh_potential,
  pc.total_carbon_offset_tons      AS postal_co2_offset,
  ct.total_carbon_offset_tons      AS census_co2_offset,
  pc.current_installs              AS postal_current_installs,
  ct.current_installs              AS census_current_installs,
  pc.gap_installations             AS postal_gap_installations,
  ct.gap_installations             AS census_gap_installations
FROM (
  SELECT
    `state_name`,
    SUM(`count_qualified`)                                           AS total_qualified_buildings,
    AVG(`percent_covered`)                                           AS avg_percent_covered,
    AVG(`percent_qualified`)                                         AS avg_percent_qualified,
    SUM(`number_of_panels_total`)                                    AS total_panel_count,
    SUM(`kw_total`)                                                  AS total_kw_capacity,
    SUM(`yearly_sunlight_kwh_total`)                                 AS total_kwh_potential,
    SUM(`carbon_offset_metric_tons`)                                 AS total_carbon_offset_tons,
    SUM(`existing_installs_count`)                                   AS current_installs,
