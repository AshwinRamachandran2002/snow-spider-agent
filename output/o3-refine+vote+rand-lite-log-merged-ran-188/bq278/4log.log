```sql
-- 3. Description: Aggregate key solar-potential figures by state (postal-code view)  
SELECT
  `state_name`,
  SUM(`count_qualified`)                                           AS total_qualified_buildings,
  AVG(`percent_covered`)                                           AS avg_percent_covered,
  AVG(`percent_qualified`)                                         AS avg_percent_qualified,
  SUM(`number_of_panels_total`)                                    AS total_panel_count,
  SUM(`kw_total`)                                                  AS total_kw_capacity,
  SUM(`yearly_sunlight_kwh_total`)                                 AS total_kwh_potential,
  SUM(`carbon_offset_metric_tons`)                                 AS total_carbon_offset_tons,
  SUM(`existing_installs_count`)                                   AS current_installs
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
GROUP BY `state_name`
LIMIT 20;
```

```sql
-- 4. Description: Aggregate the same figures by state (census-tract view)  
SELECT
  `state_name`,
  SUM(`count_qualified`)           AS total_qualified_buildings,
  AVG(`percent_covered`)           AS avg_percent_covered,
  AVG(`percent_qualified`)         AS avg_percent_qualified,
  SUM(`number_of_panels_total`)    AS total_panel_count,
  SUM(`kw_total`)                  AS total_kw_capacity,
  SUM(`yearly_sunlight_kwh_total`) AS total_kwh_potential,
  SUM(`carbon_offset_metric_tons`) AS total_carbon_offset_tons,
  SUM(`existing_installs_count`)   AS current_installs
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
GROUP BY `state_name`
LIMIT 20;
```

```sql
-- 5. Description: Compute an estimated “gap” in solar installations, postal-code level.  
--     Assumption:  potential_buildings = (count_qualified / (percent_qualified/100)) / (percent_covered/100)
--     gap = potential_buildings – existing_installs_count
SELECT
  `state_name`,
  SUM(`count_qualified`) AS total_qualified_buildings,
  SUM(
      SAFE_DIVIDE(
        SAFE_DIVIDE(`count_qualified`, NULLIF(`percent_qualified`,0)/100.0),
        NULLIF(`percent_covered`,0)/100.0
      )
  )                      AS potential_buildings,
  SUM(`existing_installs_count`)                       AS current_installs,
  SUM(
      SAFE_DIVIDE(
        SAFE_DIVIDE(`count_qualified`, NULLIF(`percent_qualified`,0)/100.0),
        NULLIF(`percent_covered`,0)/100.0
      )
  )
  - SUM(`existing_installs_count`)                     AS gap_installations
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
GROUP BY `state_name`
LIMIT 20;
```

```sql
-- 6. Description: Compute the installation “gap” the same way at census-tract level  
SELECT
  `state_name`,
  SUM(`count_qualified`) AS total_qualified_buildings,
  SUM(
      SAFE_DIVIDE(
        SAFE_DIVIDE(`count_qualified`, NULLIF(`percent_qualified`,0)/100.0),
        NULLIF(`percent_covered`,0)/100.0
      )
  )                      AS potential_buildings,
  SUM(`existing_installs_count`)                       AS current_installs,
  SUM(
      SAFE_DIVIDE(
        SAFE_DIVIDE(`count_qualified`, NULLIF(`percent_qualified`,0)/100.0),
        NULLIF(`percent_covered`,0)/100.0
      )
  )
  - SUM(`existing_installs_count`)                     AS gap_installations
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
GROUP BY `state_name`
LIMIT 20;
```

```sql
-- 7. Description: Join postal-code and census-tract summaries to compare side by side  
WITH pc AS (
  SELECT
    `state_name`,
    SUM(`count_qualified`)           AS pc_total_buildings,
    AVG(`percent_covered`)           AS pc_avg_covered,
    AVG(`percent_qualified`)         AS pc_avg_suitable,
    SUM(`number_of_panels_total`)    AS pc_panels,
    SUM(`kw_total`)                  AS pc_kw,
    SUM(`yearly_sunlight_kwh_total`) AS pc_kwh,
    SUM(`carbon_offset_metric_tons`) AS pc_co2,
    SUM(`existing_installs_count`)   AS pc_current,
    SUM(
      SAFE_DIVIDE(
        SAFE_DIVIDE(`count_qualified`, NULLIF(`percent_qualified`,0)/100.0),
        NULLIF(`percent_covered`,0)/100.0
      )
    )                                AS pc_potential
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
  GROUP BY `state_name`
),
ct AS (
  SELECT
    `state_name`,
    SUM(`count_qualified`)           AS ct_total_buildings,
    AVG(`percent_covered`)           AS ct_avg_covered,
    AVG(`percent_qualified`)         AS ct_avg_suitable,
    SUM(`number_of_panels_total`)    AS ct_panels,
    SUM(`kw_total`)                  AS ct_kw,
    SUM(`yearly_sunlight_kwh_total`) AS ct_kwh,
    SUM(`carbon_offset_metric_tons`) AS ct_co2,
    SUM(`existing_installs_count`)   AS ct_current,
    SUM(
      SAFE_DIVIDE(
        SAFE_DIVIDE(`count_qualified`, NULLIF(`percent_qualified`,0)/100.0),
        NULLIF(`percent_covered`,0)/100.0
      )
    )                                AS ct_potential
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  GROUP BY `state_name`
)
SELECT
  pc.`state_name`,
  pc_total_buildings,  ct_total_buildings,
  pc_avg_covered,      ct_avg_covered,
  pc_avg_suitable,     ct_avg_suitable,
  pc_panels,           ct_panels,
  pc_kw,               ct_kw,
  pc_kwh,              ct_kwh,
  pc_co2,              ct_co2,
  pc_current,          ct_current,
  (pc_potential - pc_current) AS pc_gap,
  (ct_potential - ct_current) AS ct_gap
FROM pc
FULL JOIN ct
USING (`state_name`)
LIMIT 20;
```

```sql
-- 8. Description: Inspect the JSON bucket field and extract the number of buildings in the 5-kW bucket  
SELECT
  `state_name`,
  `region_name`,
  JSON_EXTRACT_SCALAR(bucket, '$[0]')     AS bucket_kw_lower_bound,
  JSON_EXTRACT_SCALAR(bucket, '$[1]')     AS buildings_in_bucket
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`,
     UNNEST(JSON_EXTRACT_ARRAY(`install_size_kw_buckets`)) AS bucket
WHERE `state_name` IS NOT NULL
LIMIT 20;
```

```sql
-- 9. Description: Compare average “percent_covered” values between postal vs. census levels per state  
SELECT
  p.`state_name`,
  AVG(p.`percent_covered`) AS postal_avg_covered,
  AVG(c.`percent_covered`) AS census_avg_covered
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code` AS p
JOIN `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`  AS c
USING (`state_name`)
GROUP BY p.`state_name`
LIMIT 20;
```

```sql
-- 10. Description: Final, single-step query producing the full state comparison with computed gaps  
SELECT
  pc.`state_name`,
  pc.total_qualified_buildings     AS postal_total_buildings,
  ct.total_qualified_buildings     AS census_total_buildings,
  pc.avg_percent_covered           AS postal_avg_covered,
  ct.avg_percent_covered           AS census_avg_covered,
  pc.avg_percent_qualified         AS postal_avg_suitable,
  ct.avg_percent_qualified         AS census_avg_suitable,
  pc.total_panel_count             AS postal_panel_count,
  ct.total_panel_count             AS census_panel_count,
  pc.total_kw_capacity             AS postal_kw_capacity,
  ct.total_kw_capacity             AS census_kw_capacity,
  pc.total_kwh_potential           AS postal_kwh_potential,
  ct.total_kwh_potential           AS census_kwh_potential,
  pc.total_carbon_offset_tons      AS postal_co2_offset,
  ct.total_carbon_offset_tons      AS census_co2_offset,
  pc.current_installs              AS postal_current_installs,
  ct.current_installs              AS census_current_installs,
  pc.gap_installations             AS postal_gap_installations,
  ct.gap_installations             AS census_gap_installations
FROM (
  SELECT
    `state_name`,
    SUM(`count_qualified`)                                           AS total_qualified_buildings,
    AVG(`percent_covered`)                                           AS avg_percent_covered,
    AVG(`percent_qualified`)                                         AS avg_percent_qualified,
    SUM(`number_of_panels_total`)                                    AS total_panel_count,
    SUM(`kw_total`)                                                  AS total_kw_capacity,
    SUM(`yearly_sunlight_kwh_total`)                                 AS total_kwh_potential,
    SUM(`carbon_offset_metric_tons`)                                 AS total_carbon_offset_tons,
    SUM(`existing_installs_count`)                                   AS current_installs,
    SUM(
        SAFE_DIVIDE(
          SAFE_DIVIDE(`count_qualified`, NULLIF(`percent_qualified`,0)/100.0),
          NULLIF(`percent_covered`,0)/100.0
        )
    ) - SUM(`existing_installs_count`)                               AS gap_installations
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
  GROUP BY `state_name`
) AS pc
JOIN (
  SELECT
    `state_name`,
    SUM(`count_qualified`)                                           AS total_qualified_buildings,
    AVG(`percent_covered`)                                           AS avg_percent_covered,
    AVG(`percent_qualified`)                                         AS avg_percent_qualified,
    SUM(`number_of_panels_total`)                                    AS total_panel_count,
    SUM(`kw_total`)                                                  AS total_kw_capacity,
    SUM(`yearly_sunlight_kwh_total`)                                 AS total_kwh_potential,
    SUM(`carbon_offset_metric_tons`)                                 AS total_carbon_offset_tons,
    SUM(`existing_installs_count`)                                   AS current_installs,
    SUM(
        SAFE_DIVIDE(
          SAFE_DIVIDE(`count_qualified`, NULLIF(`percent_qualified`,0)/100.0),
          NULLIF(`percent_covered`,0)/100.0
        )
    ) - SUM(`existing_installs_count`)                               AS gap_installations
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  GROUP BY `state_name`
) AS ct
USING (`state_name`)
LIMIT 20;
```
