Query:
-- 9) Combine both granularities side-by-side for every state
WITH postal AS (
  SELECT
    state_name,
    SUM(count_qualified)                        AS qual_pc,
    AVG(percent_covered)                        AS pct_cov_pc,
    AVG(percent_qualified)                      AS pct_suit_pc,
    SUM(number_of_panels_total)                 AS panels_pc,
    SUM(kw_total)                               AS kw_pc,
    SUM(yearly_sunlight_kwh_total)              AS kwh_pc,
    SUM(carbon_offset_metric_tons)              AS co2_pc,
    SUM(existing_installs_count)                AS installs_pc,
    SUM(count_qualified)  / (AVG(percent_covered)/100.0 *
                              AVG(percent_qualified)/100.0)
      - SUM(existing_installs_count)            AS gap_pc
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
  GROUP BY state_name
),
tract AS (
  SELECT
    state_name,
    SUM(count_qualified)                        AS qual_ct,
    AVG(percent_covered)                        AS pct_cov_ct,
    AVG(percent_qualified)                      AS pct_suit_ct,
    SUM(number_of_panels_total)                 AS panels_ct,
    SUM(kw_total)                               AS kw_ct,
    SUM(yearly_sunlight_kwh_total)              AS kwh_ct,
    SUM(carbon_offset_metric_tons)              AS co2_ct,
    SUM(existing_installs_count)                AS installs_ct,
    SUM(count_qualified)  / (AVG(percent_covered)/100.0 *
                              AVG(percent_qualified)/100.0)
      - SUM(existing_installs_count)            AS gap_ct
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  GROUP BY state_name
)
SELECT
  COALESCE(p.state_name, t.state_name)                         AS state_name,
  -- postal-code level metrics
  p.qual_pc,  p.pct_cov_pc,  p.pct_suit_pc,  p.panels_pc,  p.kw_pc,
  p.kwh_pc,   p.co2_pc,      p.installs_pc,  ROUND(p.gap_pc)  AS install_gap_pc,
  -- census-tract level metrics
  t.qual_ct,  t.pct_cov_ct,  t.pct_suit_ct,  t.panels_ct,  t.kw_ct,
  t.kwh_ct,   t.co2_ct,      t.installs_ct,  ROUND(t.gap_ct)  AS install_gap_ct
FROM postal p
FULL JOIN tract t
USING (state_name)
ORDER BY state_name
LIMIT 20;
