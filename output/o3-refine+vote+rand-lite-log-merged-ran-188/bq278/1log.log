Below are 10 progressively-complex inspection / aggregation queries that let you compare the solar potential of every U.S. state at the postal–code level versus the census-tract level.  
(Replace or remove the LIMIT clauses when you are ready to look at the complete results.)

```sql
-- 1) Distinct list of states represented in the postal-code data
SELECT DISTINCT state_name
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
ORDER BY state_name
LIMIT 20;
```

```sql
-- 2) Distinct list of states represented in the census-tract data
SELECT DISTINCT state_name
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
ORDER BY state_name
LIMIT 20;
```

```sql
-- 3) How many geographic rows (postal codes / census tracts) exist for each state?
SELECT state_name,
       COUNT(*) AS postalcode_rows
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
GROUP BY state_name
ORDER BY postalcode_rows DESC
LIMIT 20;
```

```sql
-- 4) Same row counts for the census-tract table
SELECT state_name,
       COUNT(*) AS censustract_rows
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
GROUP BY state_name
ORDER BY censustract_rows DESC
LIMIT 20;
```

```sql
-- 5) Postal-code-level: core summary metrics by state
SELECT
  state_name,
  SUM(count_qualified)                         AS total_qualified_bldgs,
  AVG(percent_covered)                         AS avg_percent_covered,
  AVG(percent_qualified)                       AS avg_percent_qualified,
  SUM(number_of_panels_total)                  AS total_potential_panels,
  SUM(kw_total)                                AS total_kw_capacity,
  SUM(yearly_sunlight_kwh_total)               AS total_kwh_generation,
  SUM(carbon_offset_metric_tons)               AS total_carbon_offset_tons,
  SUM(existing_installs_count)                 AS current_installs
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
GROUP BY state_name
ORDER BY total_qualified_bldgs DESC
LIMIT 20;
```

```sql
-- 6) Census-tract-level: the same summary metrics
SELECT
  state_name,
  SUM(count_qualified)                         AS total_qualified_bldgs,
  AVG(percent_covered)                         AS avg_percent_covered,
  AVG(percent_qualified)                       AS avg_percent_qualified,
  SUM(number_of_panels_total)                  AS total_potential_panels,
  SUM(kw_total)                                AS total_kw_capacity,
  SUM(yearly_sunlight_kwh_total)               AS total_kwh_generation,
  SUM(carbon_offset_metric_tons)               AS total_carbon_offset_tons,
  SUM(existing_installs_count)                 AS current_installs
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
GROUP BY state_name
ORDER BY total_qualified_bldgs DESC
LIMIT 20;
```

```sql
-- 7) Postal-code-level: add an estimated “installation gap” per state
--    Formula: adjust qualified buildings for coverage & suitability,
--    then subtract the current installations.
SELECT
  state_name,
  SUM(count_qualified)                                              AS total_qualified_bldgs,
  AVG(percent_covered) / 100.0                                      AS pct_cov,
  AVG(percent_qualified) / 100.0                                    AS pct_suit,
  SUM(existing_installs_count)                                      AS current_installs,
  ROUND( SUM(count_qualified) / (AVG(percent_covered)/100.0 * 
                                  AVG(percent_qualified)/100.0)
         - SUM(existing_installs_count) )                           AS installation_gap
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
GROUP BY state_name
ORDER BY installation_gap DESC
LIMIT 20;
```

```sql
-- 8) Census-tract-level: same gap calculation
SELECT
  state_name,
  SUM(count_qualified)                                              AS total_qualified_bldgs,
  AVG(percent_covered) / 100.0                                      AS pct_cov,
  AVG(percent_qualified) / 100.0                                    AS pct_suit,
  SUM(existing_installs_count)                                      AS current_installs,
  ROUND( SUM(count_qualified) / (AVG(percent_covered)/100.0 * 
                                  AVG(percent_qualified)/100.0)
         - SUM(existing_installs_count) )                           AS installation_gap
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
GROUP BY state_name
ORDER BY installation_gap DESC
LIMIT 20;
```

```sql
-- 9) Combine both granularities side-by-side for every state
WITH postal AS (
  SELECT
    state_name,
    SUM(count_qualified)                        AS qual_pc,
    AVG(percent_covered)                        AS pct_cov_pc,
    AVG(percent_qualified)                      AS pct_suit_pc,
    SUM(number_of_panels_total)                 AS panels_pc,
    SUM(kw_total)                               AS kw_pc,
    SUM(yearly_sunlight_kwh_total)              AS kwh_pc,
    SUM(carbon_offset_metric_tons)              AS co2_pc,
    SUM(existing_installs_count)                AS installs_pc,
    SUM(count_qualified)  / (AVG(percent_covered)/100.0 *
                              AVG(percent_qualified)/100.0)
      - SUM(existing_installs_count)            AS gap_pc
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
  GROUP BY state_name
),
tract AS (
  SELECT
    state_name,
    SUM(count_qualified)                        AS qual_ct,
    AVG(percent_covered)                        AS pct_cov_ct,
    AVG(percent_qualified)                      AS pct_suit_ct,
    SUM(number_of_panels_total)                 AS panels_ct,
    SUM(kw_total)                               AS kw_ct,
    SUM(yearly_sunlight_kwh_total)              AS kwh_ct,
    SUM(carbon_offset_metric_tons)              AS co2_ct,
    SUM(existing_installs_count)                AS installs_ct,
    SUM(count_qualified)  / (AVG(percent_covered)/100.0 *
                              AVG(percent_qualified)/100.0)
      - SUM(existing_installs_count)            AS gap_ct
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  GROUP BY state_name
)
SELECT
  COALESCE(p.state_name, t.state_name)                         AS state_name,
  -- postal-code level metrics
  p.qual_pc,  p.pct_cov_pc,  p.pct_suit_pc,  p.panels_pc,  p.kw_pc,
  p.kwh_pc,   p.co2_pc,      p.installs_pc,  ROUND(p.gap_pc)  AS install_gap_pc,
  -- census-tract level metrics
  t.qual_ct,  t.pct_cov_ct,  t.pct_suit_ct,  t.panels_ct,  t.kw_ct,
  t.kwh_ct,   t.co2_ct,      t.installs_ct,  ROUND(t.gap_ct)  AS install_gap_ct
FROM postal p
FULL JOIN tract t
USING (state_name)
ORDER BY state_name
LIMIT 20;
```

```sql
-- 10) (Optional) Show the national-level roll-up to sanity-check totals
SELECT
  'USA'                             AS level,
  'postal_code'                     AS granularity,
  SUM(count_qualified)              AS total_qualified_bldgs,
  AVG(percent_covered)              AS avg_percent_covered,
  AVG(percent_qualified)            AS avg_percent_qualified,
  SUM(number_of_panels_total)       AS total_potential_panels,
  SUM(kw_total)                     AS total_kw_capacity,
  SUM(yearly_sunlight_kwh_total)    AS total_kwh_generation,
  SUM(carbon_offset_metric_tons)    AS total_carbon_offset_tons,
  SUM(existing_installs_count)      AS current_installs,
  ROUND( SUM(count_qualified) /
         (AVG(percent_covered)/100.0 * AVG(percent_qualified)/100.0)
         - SUM(existing_installs_count) )  AS installation_gap
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
UNION ALL
SELECT
  'USA',
  'census_tract',
  SUM(count_qualified),
  AVG(percent_covered),
  AVG(percent_qualified),
  SUM(number_of_panels_total),
  SUM(kw_total),
  SUM(yearly_sunlight_kwh_total),
  SUM(carbon_offset_metric_tons),
  SUM(existing_installs_count),
  ROUND( SUM(count_qualified) /
         (AVG(percent_covered)/100.0 * AVG(percent_qualified)/100.0)
         - SUM(existing_installs_count) )
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
LIMIT 20;
```

These ten queries progress from simple exploration to a comprehensive state-by-state comparison that includes all requested metrics and an “installation gap” estimate at both geographic granularities.
