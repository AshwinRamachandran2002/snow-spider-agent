```sql
--Description / Thinking process:
-- Each row’s `install_size_kw_buckets` is a STRING that looks like
--   '[[0,599],[5,38], ... ]'
-- 1. Use JSON_EXTRACT_ARRAY() to turn that STRING into an ARRAY of JSON strings,
--    where every element is something like "[5,38]".
-- 2. UNNEST that ARRAY so each bucket becomes its own row (alias elem).
-- 3. Parse elem: '$[0]' → lower-kW bound, '$[1]' → number of buildings.
-- 4. SAFE_CAST to INT64 so we get numeric columns.
-- 5. Filter to Pennsylvania ZIP codes and show 20 sample rows.
SELECT
  t.region_name,
  SAFE_CAST(JSON_EXTRACT_SCALAR(elem, '$[0]') AS INT64) AS lower_kw_bound_kw,
  SAFE_CAST(JSON_EXTRACT_SCALAR(elem, '$[1]') AS INT64) AS building_count
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code` AS t
CROSS JOIN UNNEST( JSON_EXTRACT_ARRAY(t.install_size_kw_buckets) ) AS elem
WHERE t.state_name = 'Pennsylvania'
LIMIT 20;
```
