```sql
--Description / Thinking process:
-- We want a single, self-contained query that compares ZIP-level and Census-tract-level
-- solar-potential metrics for every state, plus each geography’s “installation gap”.
--
-- 1) Build two CTEs (zip, ct) that aggregate the needed columns for each geography.
--    • SAFE_DIVIDE shields us from rows where either percent_covered or
--      percent_qualified is zero when estimating the total technically-suitable pool.
--    • ‘gap’ = estimated technically-suitable buildings – existing installations.
-- 2) FULL JOIN the two CTEs so every state appears even if data exists in only one
--    of the tables.
-- 3) Present both sets of metrics side-by-side and show which geography reports the
--    larger qualified pool.
WITH zip AS (
  SELECT
    state_name,
    SUM(count_qualified) AS q_zip,
    SUM(number_of_panels_total) AS panels_zip,
    SUM(kw_total) AS kw_zip,
    SUM(yearly_sunlight_kwh_total) AS kwh_zip,
    SUM(carbon_offset_metric_tons) AS co2_zip,
    SUM(existing_installs_count) AS exist_zip,
    SUM( SAFE_DIVIDE(
            count_qualified,
            (percent_covered * percent_qualified) / 10000.0) ) AS est_suitable_zip,
    SUM( SAFE_DIVIDE(
            count_qualified,
            (percent_covered * percent_qualified) / 10000.0) )
      - SUM(existing_installs_count) AS gap_zip
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
  GROUP BY state_name
),
ct AS (
  SELECT
    state_name,
    SUM(count_qualified) AS q_ct,
    SUM(number_of_panels_total) AS panels_ct,
    SUM(kw_total) AS kw_ct,
    SUM(yearly_sunlight_kwh_total) AS kwh_ct,
    SUM(carbon_offset_metric_tons) AS co2_ct,
    SUM(existing_installs_count) AS exist_ct,
    SUM( SAFE_DIVIDE(
            count_qualified,
            (percent_covered * percent_qualified) / 10000.0) ) AS est_suitable_ct,
    SUM( SAFE_DIVIDE(
            count_qualified,
            (percent_covered * percent_qualified) / 10000.0) )
      - SUM(existing_installs_count) AS gap_ct
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  GROUP BY state_name
)
SELECT
  COALESCE(zip.state_name, ct.state_name)                    AS state_name,
  -- core building counts
  q_zip, q_ct,
  -- installation gaps
  gap_zip, gap_ct,
  -- capacity & energy
  kw_zip, kw_ct,
  kwh_zip, kwh_ct,
  -- environmental impact
  co2_zip, co2_ct,
  -- which geography shows the bigger opportunity?
  CASE
    WHEN gap_zip > gap_ct THEN 'Postal code larger gap'
    WHEN gap_ct > gap_zip THEN 'Census tract larger gap'
    ELSE 'Tie / Only one source'
  END AS larger_gap_source
FROM zip
FULL JOIN ct
USING (state_name)
ORDER BY state_name
LIMIT 20;
```
