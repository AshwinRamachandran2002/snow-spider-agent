Query:
--Description: 10) State-level “report card” comparing ZIP- vs. Census-based potential
WITH zip AS (
  SELECT
    state_name,
    SUM(count_qualified) AS q_zip,
    SUM(kw_total) AS kw_zip,
    SUM(yearly_sunlight_kwh_total) AS kwh_zip,
    SUM(carbon_offset_metric_tons) AS co2_zip,
    SUM(existing_installs_count) AS exist_zip,
    SUM(
      SAFE_DIVIDE(
        count_qualified,
        (percent_covered * percent_qualified) / 10000.0
      )
    ) - SUM(existing_installs_count) AS gap_zip
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
  GROUP BY state_name
),
ct AS (
  SELECT
    state_name,
    SUM(count_qualified) AS q_ct,
    SUM(kw_total) AS kw_ct,
    SUM(yearly_sunlight_kwh_total) AS kwh_ct,
    SUM(carbon_offset_metric_tons) AS co2_ct,
    SUM(existing_installs_count) AS exist_ct,
    SUM(
      SAFE_DIVIDE(
        count_qualified,
        (percent_covered * percent_qualified) / 10000.0
      )
    ) - SUM(existing_installs_count) AS gap_ct
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  GROUP BY state_name
)
SELECT
  COALESCE(zip.state_name, ct.state_name)        AS state_name,
  q_zip, q_ct,
  kw_zip, kw_ct,
  kwh_zip, kwh_ct,
  co2_zip, co2_ct,
  exist_zip, exist_ct,
  gap_zip, gap_ct,
  CASE
    WHEN q_zip > q_ct THEN 'Postal code higher'
    WHEN q_ct > q_zip THEN 'Census tract higher'
    ELSE 'Tie / Only one source'
  END AS larger_dataset
FROM zip
FULL JOIN ct USING (state_name)
ORDER BY state_name
LIMIT 20
