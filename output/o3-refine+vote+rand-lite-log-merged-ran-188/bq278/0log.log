Below are 10 BigQuery SQL examples that take you, step-by-step, from very simple inspections to a complete “state-by-state / postal-vs-census” comparison of solar potential, including the requested “installation gap”.  
(Replace LIMIT 20 with larger limits when you need the complete result set.)

```sql
-- 1) Quick look: distinct list of states that have ZIP-level data
SELECT DISTINCT state_name
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
ORDER BY state_name
LIMIT 20;
```

```sql
-- 2) Peek at a few ZIP-level rows for one state (e.g. Pennsylvania)
SELECT *
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
WHERE state_name = 'Pennsylvania'
LIMIT 20;
```

```sql
-- 3) Distinct list of states that have Census-tract-level data
SELECT DISTINCT state_name
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
ORDER BY state_name
LIMIT 20;
```

```sql
-- 4) Aggregate the key metrics by state at the ZIP (postal-code) level
SELECT
  state_name,
  SUM(count_qualified)                          AS total_qualified_buildings,
  AVG(percent_covered)                          AS avg_percent_covered,
  AVG(percent_qualified)                        AS avg_percent_qualified,
  SUM(number_of_panels_total)                   AS total_panels,
  SUM(kw_total)                                 AS total_kw_capacity,
  SUM(yearly_sunlight_kwh_total)                AS total_energy_kwh,
  SUM(carbon_offset_metric_tons)                AS total_carbon_offset_tons,
  SUM(existing_installs_count)                  AS total_existing_installations
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
GROUP BY state_name
ORDER BY state_name
LIMIT 20;
```

```sql
-- 5) Same aggregation, but at the Census-tract level
SELECT
  state_name,
  SUM(count_qualified)                          AS total_qualified_buildings,
  AVG(percent_covered)                          AS avg_percent_covered,
  AVG(percent_qualified)                        AS avg_percent_qualified,
  SUM(number_of_panels_total)                   AS total_panels,
  SUM(kw_total)                                 AS total_kw_capacity,
  SUM(yearly_sunlight_kwh_total)                AS total_energy_kwh,
  SUM(carbon_offset_metric_tons)                AS total_carbon_offset_tons,
  SUM(existing_installs_count)                  AS total_existing_installations
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
GROUP BY state_name
ORDER BY state_name
LIMIT 20;
```

```sql
-- 6) ZIP-level “installation gap” by state
--    gap = (Qualified / (%Covered * %Qualified)) – Existing installs
SELECT
  state_name,
  SUM(count_qualified)                                              AS qualified_zip,
  SUM(existing_installs_count)                                      AS existing_zip,
  SUM(count_qualified / (percent_covered/100) / (percent_qualified/100))
      AS estimated_total_suitable_zip,
  SUM(count_qualified / (percent_covered/100) / (percent_qualified/100))
      - SUM(existing_installs_count)                                AS installation_gap_zip
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
GROUP BY state_name
ORDER BY installation_gap_zip DESC
LIMIT 20;
```

```sql
-- 7) Census-tract “installation gap” by state (same formula)
SELECT
  state_name,
  SUM(count_qualified)                                              AS qualified_ct,
  SUM(existing_installs_count)                                      AS existing_ct,
  SUM(count_qualified / (percent_covered/100) / (percent_qualified/100))
      AS estimated_total_suitable_ct,
  SUM(count_qualified / (percent_covered/100) / (percent_qualified/100))
      - SUM(existing_installs_count)                                AS installation_gap_ct
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
GROUP BY state_name
ORDER BY installation_gap_ct DESC
LIMIT 20;
```

```sql
-- 8) Example of unpacking the JSON install-size buckets
SELECT
  region_name,
  JSON_EXTRACT_SCALAR(bkt.value, '$[0]')  AS lower_kw_bound,
  JSON_EXTRACT_SCALAR(bkt.value, '$[1]')  AS building_count
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code` AS t,
     UNNEST(JSON_EXTRACT_ARRAY(t.install_size_kw_buckets)) AS bkt
WHERE state_name = 'Pennsylvania'
LIMIT 20;
```

```sql
-- 9) Side-by-side comparison: join the ZIP and Census aggregates
WITH zip AS (
  SELECT
    state_name,
    SUM(count_qualified)                          AS zip_qualified,
    AVG(percent_covered)                          AS zip_avg_covered,
    AVG(percent_qualified)                        AS zip_avg_suitable,
    SUM(number_of_panels_total)                   AS zip_panels,
    SUM(kw_total)                                 AS zip_kw,
    SUM(yearly_sunlight_kwh_total)                AS zip_energy,
    SUM(carbon_offset_metric_tons)                AS zip_carbon,
    SUM(existing_installs_count)                  AS zip_existing,
    SUM(count_qualified / (percent_covered/100) / (percent_qualified/100))
      - SUM(existing_installs_count)              AS zip_gap
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
  GROUP BY state_name
),
ct AS (
  SELECT
    state_name,
    SUM(count_qualified)                          AS ct_qualified,
    AVG(percent_covered)                          AS ct_avg_covered,
    AVG(percent_qualified)                        AS ct_avg_suitable,
    SUM(number_of_panels_total)                   AS ct_panels,
    SUM(kw_total)                                 AS ct_kw,
    SUM(yearly_sunlight_kwh_total)                AS ct_energy,
    SUM(carbon_offset_metric_tons)                AS ct_carbon,
    SUM(existing_installs_count)                  AS ct_existing,
    SUM(count_qualified / (percent_covered/100) / (percent_qualified/100))
      - SUM(existing_installs_count)              AS ct_gap
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  GROUP BY state_name
)
SELECT
  COALESCE(zip.state_name, ct.state_name)         AS state_name,
  zip_qualified,  ct_qualified,
  zip_avg_covered,ct_avg_covered,
  zip_avg_suitable,ct_avg_suitable,
  zip_panels,     ct_panels,
  zip_kw,         ct_kw,
  zip_energy,     ct_energy,
  zip_carbon,     ct_carbon,
  zip_existing,   ct_existing,
  zip_gap,        ct_gap
FROM zip
FULL JOIN ct
ON zip.state_name = ct.state_name
ORDER BY state_name
LIMIT 20;
```

```sql
-- 10) Final “report card” for every state:
--     (a) pick whichever geography has the *larger* qualified pool,
--     (b) show both geographies side-by-side, and
--     (c) flag which one is larger.
WITH zip AS (
  SELECT state_name,
         SUM(count_qualified) AS q_zip,
         SUM(kw_total) AS kw_zip,
         SUM(yearly_sunlight_kwh_total) AS kwh_zip,
         SUM(carbon_offset_metric_tons) AS co2_zip,
         SUM(existing_installs_count) AS exist_zip,
         SUM(count_qualified / (percent_covered/100) / (percent_qualified/100))
             - SUM(existing_installs_count) AS gap_zip
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_postal_code`
  GROUP BY state_name
),
ct AS (
  SELECT state_name,
         SUM(count_qualified) AS q_ct,
         SUM(kw_total) AS kw_ct,
         SUM(yearly_sunlight_kwh_total) AS kwh_ct,
         SUM(carbon_offset_metric_tons) AS co2_ct,
         SUM(existing_installs_count) AS exist_ct,
         SUM(count_qualified / (percent_covered/100) / (percent_qualified/100))
             - SUM(existing_installs_count) AS gap_ct
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  GROUP BY state_name
)
SELECT
  COALESCE(zip.state_name, ct.state_name)                          AS state_name,
  q_zip, q_ct,
  kw_zip, kw_ct,
  kwh_zip, kwh_ct,
  co2_zip, co2_ct,
  exist_zip, exist_ct,
  gap_zip,  gap_ct,
  CASE
    WHEN q_zip > q_ct THEN 'Postal code higher'
    WHEN q_ct > q_zip THEN 'Census tract higher'
    ELSE 'Tie'
  END AS larger_dataset
FROM zip
FULL JOIN ct
ON zip.state_name = ct.state_name
ORDER BY state_name
LIMIT 20;
```

These queries let you explore, aggregate, and directly compare the solar-potential metrics for every state at both postal-code and census-tract granularity, culminating in a full state-level dashboard (Query 10) that highlights which geography holds the higher untapped opportunity for additional solar installations.
