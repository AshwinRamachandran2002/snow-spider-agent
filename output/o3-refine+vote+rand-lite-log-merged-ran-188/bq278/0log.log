Query:
--Description:  7) Census-tract “installation gap” by state, now using SAFE_DIVIDE
SELECT
  state_name,
  SUM(count_qualified) AS qualified_ct,
  SUM(existing_installs_count) AS existing_ct,
  SUM(
      SAFE_DIVIDE(
        count_qualified,
        (percent_covered * percent_qualified) / 10000.0    -- convert two % values to a fraction
      )
  ) AS estimated_total_suitable_ct,
  SUM(
      SAFE_DIVIDE(
        count_qualified,
        (percent_covered * percent_qualified) / 10000.0
      )
  ) - SUM(existing_installs_count) AS installation_gap_ct
FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
GROUP BY state_name
ORDER BY installation_gap_ct DESC
LIMIT 20
