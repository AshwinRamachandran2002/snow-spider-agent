    SUM(
      SAFE_DIVIDE(
        count_qualified,
        (percent_covered * percent_qualified) / 10000.0
      )
    ) - SUM(existing_installs_count) AS gap_ct
  FROM `bigquery-public-data.sunroof_solar.solar_potential_by_censustract`
  GROUP BY state_name
)
SELECT
  COALESCE(zip.state_name, ct.state_name)        AS state_name,
  q_zip, q_ct,
  kw_zip, kw_ct,
  kwh_zip, kwh_ct,
  co2_zip, co2_ct,
  exist_zip, exist_ct,
  gap_zip, gap_ct,
  CASE
    WHEN q_zip > q_ct THEN 'Postal code higher'
    WHEN q_ct > q_zip THEN 'Census tract higher'
    ELSE 'Tie / Only one source'
  END AS larger_dataset
FROM zip
FULL JOIN ct USING (state_name)
ORDER BY state_name
LIMIT 20
