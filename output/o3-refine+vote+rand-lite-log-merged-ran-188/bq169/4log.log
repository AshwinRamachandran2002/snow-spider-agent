LIMIT 20;
```

```sql
-- 5. Clones showing BOTH chr13-loss and chr17-loss (pre-check)
SELECT DISTINCT a.RefNo, a.CaseNo, a.InvNo, a.Clone
FROM (
  SELECT RefNo, CaseNo, InvNo, Clone
  FROM `mitelman-db.prod.CytoConverted`
  WHERE Chr = 'chr13'
    AND `Type` = 'Loss'
    AND Start <= 48481890
    AND End   >= 48303751
) AS a
JOIN (
  SELECT RefNo, CaseNo, InvNo, Clone
  FROM `mitelman-db.prod.CytoConverted`
  WHERE Chr = 'chr17'
    AND `Type` = 'Loss'
    AND Start <= 7687490
    AND End   >= 7668421
) AS b
USING (RefNo, CaseNo, InvNo, Clone)
LIMIT 20;
```

```sql
-- 6. Clones showing ALL THREE alterations (13-loss, 17-loss, 11-gain)
SELECT DISTINCT t1.RefNo, t1.CaseNo, t1.InvNo, t1.Clone
FROM (
  -- chr13 loss
  SELECT RefNo, CaseNo, InvNo, Clone
  FROM `mitelman-db.prod.CytoConverted`
  WHERE Chr = 'chr13'
    AND `Type` = 'Loss'
    AND Start <= 48481890
    AND End   >= 48303751
) AS t1
JOIN (
  -- chr17 loss
  SELECT RefNo, CaseNo, InvNo, Clone
  FROM `mitelman-db.prod.CytoConverted`
  WHERE Chr = 'chr17'
    AND `Type` = 'Loss'
    AND Start <= 7687490
    AND End   >= 7668421
) AS t2
USING (RefNo, CaseNo, InvNo, Clone)
JOIN (
  -- chr11 gain
  SELECT RefNo, CaseNo, InvNo, Clone
  FROM `mitelman-db.prod.CytoConverted`
  WHERE Chr = 'chr11'
    AND `Type` = 'Gain'
    AND Start <= 108369102
    AND End   >= 108223067
) AS t3
USING (RefNo, CaseNo, InvNo, Clone)
LIMIT 20;
```

```sql
-- 7. Add the karyotype description from KaryClone for those clones
SELECT DISTINCT z.RefNo, z.CaseNo, z.InvNo, z.Clone,
       k.CloneShort
FROM (
  -- sub-query from step 6
  SELECT DISTINCT t1.RefNo, t1.CaseNo, t1.InvNo, t1.Clone
  FROM (
    SELECT RefNo, CaseNo, InvNo, Clone
    FROM `mitelman-db.prod.CytoConverted`
    WHERE Chr = 'chr13' AND `Type` = 'Loss'
      AND Start <= 48481890 AND End >= 48303751
  ) AS t1
  JOIN (
    SELECT RefNo, CaseNo, InvNo, Clone
    FROM `mitelman-db.prod.CytoConverted`
    WHERE Chr = 'chr17' AND `Type` = 'Loss'
      AND Start <= 7687490 AND End >= 7668421
  ) AS t2 USING (RefNo, CaseNo, InvNo, Clone)
  JOIN (
    SELECT RefNo, CaseNo, InvNo, Clone
    FROM `mitelman-db.prod.CytoConverted`
    WHERE Chr = 'chr11' AND `Type` = 'Gain'
      AND Start <= 108369102 AND End >= 108223067
  ) AS t3 USING (RefNo, CaseNo, InvNo, Clone)
) AS z
LEFT JOIN `mitelman-db.prod.KaryClone` AS k
  ON k.RefNo = z.RefNo
 AND k.CaseNo = z.CaseNo
 AND k.InvNo  = z.InvNo
 AND k.CloneNo = z.Clone
LIMIT 20;
```

```sql
-- 8. FINAL: detailed output with one row per clone listing the
--         chromosome coordinates for each of the three target regions
--         along with the karyotype short description.
SELECT DISTINCT
  base.RefNo,
  base.CaseNo,
  base.InvNo,
  base.Clone,
  
  -- chr13 loss region actually recorded
  chr13.ChrOrd  AS Chr13_ChrOrd,
  chr13.Start   AS Chr13_Start,
  chr13.End     AS Chr13_End,
  
  -- chr17 loss region
  chr17.ChrOrd  AS Chr17_ChrOrd,
  chr17.Start   AS Chr17_Start,
  chr17.End     AS Chr17_End,
  
  -- chr11 gain region
  chr11.ChrOrd  AS Chr11_ChrOrd,
  chr11.Start   AS Chr11_Start,
  chr11.End     AS Chr11_End,
  
  k.CloneShort  AS KaryotypeShort
FROM (
  -- set of clones that have all three events (built once)
  SELECT DISTINCT t1.RefNo, t1.CaseNo, t1.InvNo, t1.Clone
  FROM (
    SELECT RefNo, CaseNo, InvNo, Clone
    FROM `mitelman-db.prod.CytoConverted`
    WHERE Chr = 'chr13' AND `Type` = 'Loss'
      AND Start <= 48481890 AND End >= 48303751
  ) AS t1
  JOIN (
    SELECT RefNo, CaseNo, InvNo, Clone
    FROM `mitelman-db.prod.CytoConverted`
    WHERE Chr = 'chr17' AND `Type` = 'Loss'
      AND Start <= 7687490 AND End >= 7668421
  ) AS t2 USING (RefNo, CaseNo, InvNo, Clone)
  JOIN (
    SELECT RefNo, CaseNo, InvNo, Clone
    FROM `mitelman-db.prod.CytoConverted`
    WHERE Chr = 'chr11' AND `Type` = 'Gain'
      AND Start <= 108369102 AND End >= 108223067
  ) AS t3 USING (RefNo, CaseNo, InvNo, Clone)
) AS base

-- bring in the actual rows for each region
LEFT JOIN `mitelman-db.prod.CytoConverted`  AS chr13
  ON chr13.RefNo = base.RefNo  AND chr13.CaseNo = base.CaseNo
 AND chr13.InvNo = base.InvNo  AND chr13.Clone  = base.Clone
 AND chr13.Chr   = 'chr13'     AND chr13.`Type` = 'Loss'
 AND chr13.Start <= 48481890   AND chr13.End >= 48303751

LEFT JOIN `mitelman-db.prod.CytoConverted`  AS chr17
  ON chr17.RefNo = base.RefNo  AND chr17.CaseNo = base.CaseNo
 AND chr17.InvNo = base.InvNo  AND chr17.Clone  = base.Clone
 AND chr17.Chr   = 'chr17'     AND chr17.`Type` = 'Loss'
 AND chr17.Start <= 7687490    AND chr17.End  >= 7668421

LEFT JOIN `mitelman-db.prod.CytoConverted`  AS chr11
  ON chr11.RefNo = base.RefNo  AND chr11.CaseNo = base.CaseNo
 AND chr11.InvNo = base.InvNo  AND chr11.Clone  = base.Clone
 AND chr11.Chr   = 'chr11'     AND chr11.`Type` = 'Gain'
 AND chr11.Start <= 108369102  AND chr11.End  >= 108223067

-- karyotype description
LEFT JOIN `mitelman-db.prod.KaryClone` AS k
  ON k.RefNo   = base.RefNo
 AND k.CaseNo  = base.CaseNo
 AND k.InvNo   = base.InvNo
 AND k.CloneNo = base.Clone

LIMIT 20;
```

Each query builds logically on the previous one, culminating in the final statement that lists every clone carrying all three specified alterations together with the requested chromosomal coordinates and karyotype short description.
