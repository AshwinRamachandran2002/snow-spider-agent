```sql
-- 6. Description:  Extend to clones having chr13 loss, chr17 loss, AND chr11 gain  
SELECT DISTINCT c13.RefNo, c13.CaseNo, c13.InvNo, c13.Clone
FROM `mitelman-db.prod.CytoConverted` AS c13
JOIN `mitelman-db.prod.CytoConverted` AS c17
  ON  c13.RefNo  = c17.RefNo
  AND c13.CaseNo = c17.CaseNo
  AND c13.InvNo  = c17.InvNo
  AND c13.Clone  = c17.Clone
JOIN `mitelman-db.prod.CytoConverted` AS c11
  ON  c13.RefNo  = c11.RefNo
  AND c13.CaseNo = c11.CaseNo
  AND c13.InvNo  = c11.InvNo
  AND c13.Clone  = c11.Clone
WHERE c13.ChrOrd = 13 AND c13.Type = 'Loss'
  AND c13.Start <= 48481890 AND c13.End >= 48303751
  AND c17.ChrOrd = 17 AND c17.Type = 'Loss'
  AND c17.Start <= 7687490 AND c17.End >= 7668421
  AND c11.ChrOrd = 11 AND c11.Type = 'Gain'
  AND c11.Start <= 108369102 AND c11.End >= 108223067
LIMIT 20;
```

```sql
-- 7. Description:  Attach karyotype information (CloneShort) for clones with the three alterations  
SELECT DISTINCT mc.RefNo,
       mc.CaseNo,
       mc.InvNo,
       mc.Clone,
       kc.CloneShort
FROM (
      -- sub-query is the result of step 6 without LIMIT
      SELECT c13.RefNo, c13.CaseNo, c13.InvNo, c13.Clone
      FROM `mitelman-db.prod.CytoConverted` AS c13
      JOIN `mitelman-db.prod.CytoConverted` AS c17
        ON  c13.RefNo  = c17.RefNo
        AND c13.CaseNo = c17.CaseNo
        AND c13.InvNo  = c17.InvNo
        AND c13.Clone  = c17.Clone
      JOIN `mitelman-db.prod.CytoConverted` AS c11
        ON  c13.RefNo  = c11.RefNo
        AND c13.CaseNo = c11.CaseNo
        AND c13.InvNo  = c11.InvNo
        AND c13.Clone  = c11.Clone
      WHERE c13.ChrOrd = 13 AND c13.Type = 'Loss'
        AND c13.Start <= 48481890 AND c13.End >= 48303751
        AND c17.ChrOrd = 17 AND c17.Type = 'Loss'
        AND c17.Start <= 7687490 AND c17.End >= 7668421
        AND c11.ChrOrd = 11 AND c11.Type = 'Gain'
        AND c11.Start <= 108369102 AND c11.End >= 108223067
     ) AS mc
JOIN `mitelman-db.prod.KaryClone` AS kc
  ON  mc.RefNo  = kc.RefNo
  AND mc.CaseNo = kc.CaseNo
  AND mc.InvNo  = kc.InvNo
  AND mc.Clone  = kc.CloneNo
LIMIT 20;
```

```sql
-- 8. Description:  Final answer – list each matching clone once and show the three
--                  regional rows (chr13 loss, chr17 loss, chr11 gain) plus the karyotype
SELECT DISTINCT
  c13.RefNo,
  c13.CaseNo,
  c13.InvNo,
  c13.Clone                       AS CloneNo,
  -- chr13 loss
  c13.ChrOrd                      AS Chr13_Ord,
  c13.Start                       AS Chr13_Start,
  c13.End                         AS Chr13_End,
  -- chr17 loss
  c17.ChrOrd                      AS Chr17_Ord,
  c17.Start                       AS Chr17_Start,
  c17.End                         AS Chr17_End,
  -- chr11 gain
  c11.ChrOrd                      AS Chr11_Ord,
  c11.Start                       AS Chr11_Start,
  c11.End                         AS Chr11_End,
  -- karyotype
  kc.CloneShort
FROM `mitelman-db.prod.CytoConverted` AS c13
JOIN `mitelman-db.prod.CytoConverted` AS c17
  ON  c13.RefNo  = c17.RefNo
  AND c13.CaseNo = c17.CaseNo
  AND c13.InvNo  = c17.InvNo
  AND c13.Clone  = c17.Clone
JOIN `mitelman-db.prod.CytoConverted` AS c11
  ON  c13.RefNo  = c11.RefNo
  AND c13.CaseNo = c11.CaseNo
  AND c13.InvNo  = c11.InvNo
  AND c13.Clone  = c11.Clone
JOIN `mitelman-db.prod.KaryClone`      AS kc
  ON  c13.RefNo  = kc.RefNo
  AND c13.CaseNo = kc.CaseNo
  AND c13.InvNo  = kc.InvNo
  AND c13.Clone  = kc.CloneNo
WHERE c13.ChrOrd = 13 AND c13.Type = 'Loss'
  AND c13.Start <= 48481890 AND c13.End >= 48303751
  AND c17.ChrOrd = 17 AND c17.Type = 'Loss'
  AND c17.Start <= 7687490  AND c17.End >= 7668421
  AND c11.ChrOrd = 11 AND c11.Type = 'Gain'
  AND c11.Start <= 108369102 AND c11.End >= 108223067
LIMIT 20;
```

Above sequence moves from simple exploration to the complete query that returns the requested clones, their three chromosomal alterations (with ChrOrd, start, end), and the corresponding `CloneShort` description from `KaryClone`.
