FROM `mitelman-db.prod.CytoConverted`
WHERE `ChrOrd` = 13
  AND `Type`   = 'Loss'
  AND `Start` <= 48481890      -- region end
  AND `End`   >= 48303751      -- region start
LIMIT 20;
