13363,33,1,1,"51,XY,+X,der(1)add(1)(p36)del(1)(q42q44),der(1)del(1)(p36p32)ins(1;?)(q21;?),add(2)(p11),der(2)t(2;7)(p21;q11),del(3)(p25p13),add(5)(q31),+der(5)t(5;14)(p14;q24)t(14;18)(q32;q21),+der(6)t(6;18)(q27;q21)t(14;18)(q32;q21),+7,add(8)(q24),ins(8;?)(q22;?),+add"
