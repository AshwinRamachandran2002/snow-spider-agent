Query:
--Description: 
-- 7) All CytoConverted rows (three regions) for every clone that matches query-6.
SELECT
  cc.RefNo, cc.CaseNo, cc.InvNo, cc.Clone,
  cc.ChrOrd, cc.`Start`, cc.`End`, cc.Type
FROM `mitelman-db.prod.CytoConverted` AS cc
JOIN (
  SELECT RefNo, CaseNo, InvNo, Clone
  FROM (
    SELECT RefNo, CaseNo, InvNo, Clone
    FROM `mitelman-db.prod.CytoConverted`
    WHERE ChrOrd = 13 AND Type = 'Loss'
      AND `End`   > 48303751 AND `Start` < 48481890
  ) a
  JOIN (
    SELECT RefNo, CaseNo, InvNo, Clone
    FROM `mitelman-db.prod.CytoConverted`
    WHERE ChrOrd = 17 AND Type = 'Loss'
      AND `End`   >  7668421 AND `Start` <  7687490
  ) b USING (RefNo, CaseNo, InvNo, Clone)
  JOIN (
    SELECT RefNo, CaseNo, InvNo, Clone
    FROM `mitelman-db.prod.CytoConverted`
    WHERE ChrOrd = 11 AND Type = 'Gain'
      AND `End`   > 108223067 AND `Start` < 108369102
  ) c USING (RefNo, CaseNo, InvNo, Clone)
) AS keep
USING (RefNo, CaseNo, InvNo, Clone)
ORDER BY RefNo, CaseNo, InvNo, Clone, ChrOrd
LIMIT 20
