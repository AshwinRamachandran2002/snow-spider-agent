Query:
--Description: 
-- 10) Count of distinct clones that satisfy all three alterations.
SELECT COUNT(DISTINCT FORMAT('%d|%s|%d|%d', RefNo, CaseNo, InvNo, CloneNo))
       AS Clones_with_three_events
FROM (
  SELECT c13.RefNo, c13.CaseNo, c13.InvNo, c13.Clone AS CloneNo
  FROM `mitelman-db.prod.CytoConverted` AS c13
  JOIN `mitelman-db.prod.CytoConverted` AS c17
    ON c17.RefNo  = c13.RefNo  AND c17.CaseNo = c13.CaseNo
    AND c17.InvNo = c13.InvNo  AND c17.Clone  = c13.Clone
  JOIN `mitelman-db.prod.CytoConverted` AS c11
    ON c11.RefNo  = c13.RefNo  AND c11.CaseNo = c13.CaseNo
    AND c11.InvNo = c13.InvNo  AND c11.Clone  = c13.Clone
  WHERE c13.ChrOrd = 13 AND c13.Type = 'Loss'
    AND c13.`End`   > 48303751 AND c13.`Start` < 48481890
    AND c17.ChrOrd = 17 AND c17.Type = 'Loss'
    AND c17.`End`   >  7668421 AND c17.`Start` <  7687490
    AND c11.ChrOrd = 11 AND c11.Type = 'Gain'
    AND c11.`End`   > 108223067 AND c11.`Start` < 108369102
)
