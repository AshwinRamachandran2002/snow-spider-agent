```sql
-- 5. Retrieve the list of clones that satisfy all three criteria
WITH
loss13 AS (
  SELECT DISTINCT RefNo, CaseNo, InvNo, Clone
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 13 AND Type = 'Loss'
    AND  Start < 48481890 AND End > 48303751
),
loss17 AS (
  SELECT DISTINCT RefNo, CaseNo, InvNo, Clone
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 17 AND Type = 'Loss'
    AND  Start < 7687490 AND End > 7668421
),
gain11 AS (
  SELECT DISTINCT RefNo, CaseNo, InvNo, Clone
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 11 AND Type = 'Gain'
    AND  Start < 108369102 AND End > 108223067
)
SELECT DISTINCT l13.RefNo,
       l13.CaseNo,
       l13.InvNo,
       l13.Clone
FROM   loss13  AS l13
JOIN   loss17  AS l17 USING (RefNo,CaseNo,InvNo,Clone)
JOIN   gain11  AS g11 USING (RefNo,CaseNo,InvNo,Clone)
LIMIT 20;
```

```sql
-- 6. Show chromosomal ranges for the three regions *per clone*
WITH
criteria AS (
  SELECT DISTINCT RefNo, CaseNo, InvNo, Clone
  FROM (
    SELECT RefNo, CaseNo, InvNo, Clone
    FROM   `mitelman-db.prod.CytoConverted`
    WHERE  (ChrOrd = 13 AND Type = 'Loss' AND Start < 48481890 AND End > 48303751)
       OR (ChrOrd = 17 AND Type = 'Loss' AND Start < 7687490 AND End > 7668421)
       OR (ChrOrd = 11 AND Type = 'Gain' AND Start < 108369102 AND End > 108223067)
  )
  GROUP BY RefNo, CaseNo, InvNo, Clone
  HAVING COUNTIF(ChrOrd = 13 AND Type='Loss') > 0
     AND COUNTIF(ChrOrd = 17 AND Type='Loss') > 0
     AND COUNTIF(ChrOrd = 11 AND Type='Gain') > 0
)
SELECT cv.RefNo,
       cv.CaseNo,
       cv.InvNo,
       cv.Clone,
       cv.ChrOrd,
       cv.Start,
       cv.End,
       cv.Type
FROM   `mitelman-db.prod.CytoConverted` AS cv
JOIN   criteria                       AS c
  ON   cv.RefNo  = c.RefNo
 AND   cv.CaseNo = c.CaseNo
 AND   cv.InvNo  = c.InvNo
 AND   cv.Clone  = c.Clone
WHERE  (cv.ChrOrd = 13 AND cv.Type = 'Loss' AND cv.Start < 48481890 AND cv.End > 48303751)
   OR  (cv.ChrOrd = 17 AND cv.Type = 'Loss' AND cv.Start < 7687490  AND cv.End > 7668421)
   OR  (cv.ChrOrd = 11 AND cv.Type = 'Gain' AND cv.Start < 108369102 AND cv.End > 108223067)
ORDER  BY cv.RefNo, cv.CaseNo, cv.InvNo, cv.Clone, cv.ChrOrd
LIMIT 50;
```

```sql
-- 7. Join the qualifying clones to KaryClone to view their karyotype
WITH
loss13 AS (
  SELECT DISTINCT RefNo, CaseNo, InvNo, Clone
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 13 AND Type = 'Loss'
    AND  Start < 48481890 AND End > 48303751
),
loss17 AS (
  SELECT DISTINCT RefNo, CaseNo, InvNo, Clone
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 17 AND Type = 'Loss'
    AND  Start < 7687490 AND End > 7668421
),
gain11 AS (
  SELECT DISTINCT RefNo, CaseNo, InvNo, Clone
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 11 AND Type = 'Gain'
    AND  Start < 108369102 AND End > 108223067
),
clones AS (
  SELECT l13.RefNo, l13.CaseNo, l13.InvNo, l13.Clone
  FROM   loss13 l13
  JOIN   loss17 USING (RefNo,CaseNo,InvNo,Clone)
  JOIN   gain11 USING (RefNo,CaseNo,InvNo,Clone)
)
SELECT kc.RefNo,
       kc.CaseNo,
       kc.InvNo,
       kc.CloneNo      AS Clone,
       kc.ChromoMin,
       kc.ChromoMax,
       kc.CloneShort   AS KaryShort
FROM   `mitelman-db.prod.KaryClone` AS kc
JOIN   clones                       AS c
  ON   kc.RefNo  = c.RefNo
 AND   kc.CaseNo = c.CaseNo
 AND   kc.InvNo  = c.InvNo
 AND   kc.CloneNo= c.Clone
LIMIT 20;
```

```sql
-- 8. Final report: combine chromosomal details for each interval together
--    with KaryClone’s short karyotype description.
WITH
-- records that satisfy each single criterion
loss13 AS (
  SELECT RefNo, CaseNo, InvNo, Clone,
         ChrOrd     AS chr13_ChrOrd,
         Start      AS chr13_Start,
         End        AS chr13_End
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 13 AND Type = 'Loss'
    AND  Start < 48481890 AND End > 48303751
),
loss17 AS (
  SELECT RefNo, CaseNo, InvNo, Clone,
         ChrOrd     AS chr17_ChrOrd,
         Start      AS chr17_Start,
         End        AS chr17_End
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 17 AND Type = 'Loss'
    AND  Start < 7687490 AND End > 7668421
),
gain11 AS (
  SELECT RefNo, CaseNo, InvNo, Clone,
         ChrOrd     AS chr11_ChrOrd,
         Start      AS chr11_Start,
         End        AS chr11_End
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 11 AND Type = 'Gain'
    AND  Start < 108369102 AND End > 108223067
),
-- intersect the three alteration sets
triples AS (
  SELECT l13.RefNo,
         l13.CaseNo,
         l13.InvNo,
         l13.Clone,
         l13.chr13_ChrOrd,
         l13.chr13_Start,
         l13.chr13_End,
         l17.chr17_ChrOrd,
         l17.chr17_Start,
         l17.chr17_End,
         g11.chr11_ChrOrd,
         g11.chr11_Start,
         g11.chr11_End
  FROM   loss13 AS l13
  JOIN   loss17 AS l17 USING (RefNo,CaseNo,InvNo,Clone)
  JOIN   gain11 AS g11 USING (RefNo,CaseNo,InvNo,Clone)
)
SELECT t.RefNo,
       t.CaseNo,
       t.InvNo,
       t.Clone,
       -- 13q loss details
       t.chr13_ChrOrd AS ChrOrd_13,
       t.chr13_Start  AS Start_13,
       t.chr13_End    AS End_13,
       -- 17p loss details
       t.chr17_ChrOrd AS ChrOrd_17,
       t.chr17_Start  AS Start_17,
       t.chr17_End    AS End_17,
       -- 11q gain details
       t.chr11_ChrOrd AS ChrOrd_11,
       t.chr11_Start  AS Start_11,
       t.chr11_End    AS End_11,
       kc.CloneShort  AS Karyotype
FROM   triples                    AS t
LEFT JOIN `mitelman-db.prod.KaryClone` AS kc
  ON   kc.RefNo   = t.RefNo
 AND  kc.CaseNo  = t.CaseNo
 AND  kc.InvNo   = t.InvNo
 AND  kc.CloneNo = t.Clone
ORDER BY t.RefNo, t.CaseNo, t.InvNo, t.Clone;
```

