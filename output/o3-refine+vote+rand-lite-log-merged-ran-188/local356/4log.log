Query:
-- Description: 5) Count, for every driver, how many times they gained or lost places on track  
WITH race_deltas AS (
    SELECT  "race_id",
            "driver_id",
            "lap",
            "position" - LAG("position") OVER
                (PARTITION BY "race_id", "driver_id" ORDER BY "lap") AS "pos_change"
    FROM    "lap_positions"
    WHERE   "lap_type" = 'Race'
      AND   "lap"      > 1
)
SELECT  "driver_id",
        SUM(CASE WHEN "pos_change" > 0 THEN 1 ELSE 0 END) AS "times_overtaken",
        SUM(CASE WHEN "pos_change" < 0 THEN 1 ELSE 0 END) AS "times_overtake"
FROM    race_deltas
WHERE   "pos_change" <> 0
GROUP BY "driver_id"
LIMIT 20;
