-- Description: 4) Produce position changes only for genuine race laps  
WITH race_laps AS (
    SELECT  "race_id",
            "driver_id",
            "lap",
            "position",
            LAG("position") OVER (PARTITION BY "race_id", "driver_id" ORDER BY "lap") AS "prev_pos"
    FROM    "lap_positions"
    WHERE   "lap_type" = 'Race'    -- exclude pit-in / pit-out / start etc.
      AND   "lap"      > 1         -- ignore the first racing lap (start movements)
)
SELECT  *
FROM    race_laps
WHERE   "prev_pos" IS NOT NULL
LIMIT 20;
