```sql
-- Description: 1) Inspect the different kinds of lap records that exist  
SELECT DISTINCT "lap_type"
FROM "lap_positions"
LIMIT 20;
```

```sql
-- Description: 2) Look at a few sequential lap-by-lap position records for one sample driver  
SELECT  "race_id",
        "driver_id",
        "lap",
        "position",
        "lap_type"
FROM    "lap_positions"
WHERE   "driver_id" = 1               -- sample driver
  AND   "race_id"  = 1                -- sample race
ORDER BY "lap"
LIMIT 20;
```

```sql
-- Description: 3) Calculate lap-to-lap position changes (all lap types) for the same sample driver  
SELECT  lp."race_id",
        lp."driver_id",
        lp."lap",
        lp."position",
        lp."lap_type",
        lp."position"
        - LAG(lp."position") OVER (PARTITION BY lp."race_id", lp."driver_id" ORDER BY lp."lap")
          AS "pos_change"
FROM    "lap_positions" AS lp
WHERE   lp."driver_id" = 1
  AND   lp."race_id"  = 1
ORDER BY lp."lap"
LIMIT 20;
```

```sql
-- Description: 4) Produce position changes only for genuine race laps  
WITH race_laps AS (
    SELECT  "race_id",
            "driver_id",
            "lap",
            "position",
            LAG("position") OVER (PARTITION BY "race_id", "driver_id" ORDER BY "lap") AS "prev_pos"
    FROM    "lap_positions"
    WHERE   "lap_type" = 'Race'    -- exclude pit-in / pit-out / start etc.
      AND   "lap"      > 1         -- ignore the first racing lap (start movements)
)
SELECT  *
FROM    race_laps
WHERE   "prev_pos" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: 5) Count, for every driver, how many times they gained or lost places on track  
WITH race_deltas AS (
    SELECT  "race_id",
            "driver_id",
            "lap",
            "position" - LAG("position") OVER
                (PARTITION BY "race_id", "driver_id" ORDER BY "lap") AS "pos_change"
    FROM    "lap_positions"
    WHERE   "lap_type" = 'Race'
      AND   "lap"      > 1
)
SELECT  "driver_id",
        SUM(CASE WHEN "pos_change" > 0 THEN 1 ELSE 0 END) AS "times_overtaken",
        SUM(CASE WHEN "pos_change" < 0 THEN 1 ELSE 0 END) AS "times_overtake"
FROM    race_deltas
WHERE   "pos_change" <> 0
GROUP BY "driver_id"
LIMIT 20;
```

```sql
-- Description: 6) Drivers whose on-track losses are greater than their gains  
WITH race_deltas AS (
    SELECT  "race_id",
            "driver_id",
            "lap",
            "position" - LAG("position") OVER
                (PARTITION BY "race_id", "driver_id" ORDER BY "lap") AS "pos_change"
    FROM    "lap_positions"
    WHERE   "lap_type" = 'Race'
      AND   "lap"      > 1
),
driver_balance AS (
    SELECT  "driver_id",
            SUM(CASE WHEN "pos_change" > 0 THEN 1 ELSE 0 END) AS "times_overtaken",
            SUM(CASE WHEN "pos_change" < 0 THEN 1 ELSE 0 END) AS "times_overtake"
    FROM    race_deltas
    WHERE   "pos_change" <> 0
    GROUP BY "driver_id"
)
SELECT  db.*
FROM    driver_balance AS db
WHERE   db."times_overtaken" > db."times_overtake"
LIMIT 20;
```

```sql
-- Description: 7) Final answer – full names of drivers overtaken more often than they overtake  
WITH race_deltas AS (
    SELECT  "race_id",
            "driver_id",
            "lap",
            "position" - LAG("position") OVER
                (PARTITION BY "race_id", "driver_id" ORDER BY "lap") AS "pos_change"
    FROM    "lap_positions"
    WHERE   "lap_type" = 'Race'
      AND   "lap"      > 1
),
driver_balance AS (
    SELECT  "driver_id",
            SUM(CASE WHEN "pos_change" > 0 THEN 1 ELSE 0 END) AS "times_overtaken",
            SUM(CASE WHEN "pos_change" < 0 THEN 1 ELSE 0 END) AS "times_overtake"
    FROM    race_deltas
    WHERE   "pos_change" <> 0
    GROUP BY "driver_id"
    HAVING  "times_overtaken" > "times_overtake"
)
SELECT  DISTINCT de."full_name"
FROM    driver_balance AS db
JOIN    "drivers_ext" AS de
      ON db."driver_id" = de."driver_id"
LIMIT 20;
```
