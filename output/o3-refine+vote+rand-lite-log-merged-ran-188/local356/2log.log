-- 8) Exclude laps that are either own-pit laps OR one lap AFTER a pit-stop exit
WITH pit AS (
  SELECT race_id, driver_id, lap   -- pit-entry lap
  FROM pit_stops
),
lp AS (
  SELECT race_id,
         driver_id,
         lap,
         position,
         LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
  FROM lap_positions
  WHERE lap_type = 'Race'
),
valid_moves AS (
  SELECT l.*,
         CASE WHEN p1.lap IS NOT NULL               -- pit-entry
               OR p2.lap IS NOT NULL               -- lap immediately after pit exit
              THEN 1 END AS pit_related
  FROM lp AS l
  LEFT JOIN pit AS p1
         ON p1.race_id = l.race_id
        AND p1.driver_id = l.driver_id
        AND p1.lap = l.lap
  LEFT JOIN pit AS p2
         ON p2.race_id = l.race_id
        AND p2.driver_id = l.driver_id
        AND p2.lap = l.lap - 1                     -- exit lap
)
SELECT race_id,
       driver_id,
       lap,
       prev_pos,
       position,
       pit_related
FROM valid_moves
WHERE prev_pos IS NOT NULL
  AND lap > 1
  AND pit_related IS NULL                          -- keep only on-track moves
LIMIT 20;
