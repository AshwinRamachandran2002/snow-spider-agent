-- 6) Tag every delta as ‘overtake’ (driver gains) or ‘overtaken’ (driver loses)
WITH lp AS (
  SELECT race_id,
         driver_id,
         lap,
         position,
         LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
  FROM lap_positions
  WHERE lap_type = 'Race'
)
SELECT race_id,
       driver_id,
       lap,
       CASE WHEN prev_pos  > position THEN 1 ELSE 0 END AS made_pass,
       CASE WHEN prev_pos  < position THEN 1 ELSE 0 END AS got_passed
FROM lp
WHERE prev_pos IS NOT NULL
  AND lap > 1                                 -- exclude lap-1 start moves
LIMIT 20;
