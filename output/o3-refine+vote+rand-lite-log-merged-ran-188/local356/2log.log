2025-05-05 05:01:24 - Thread-4227 (execute) - INFO - [Exploration]
Below is a step-by-step exploration (10 queries maximum) that gradually inspects the information needed to discover the drivers who, during race laps, were overtaken more times than they overtook others, after excluding start-lap changes, pit-stop position swaps (entry-& exit) and retirements.

```sql
-- 1) Look at a handful of lap-by-lap position records that are marked as actual “Race” laps
SELECT DISTINCT race_id,
       driver_id,
       lap,
       position,
       lap_type
FROM lap_positions
WHERE lap_type = 'Race'
LIMIT 20;
```

```sql
-- 2) Inspect some pit-stop information (lap numbers on which each stop occurred)
SELECT DISTINCT race_id,
       driver_id,
       lap,
       stop,
       duration,
       milliseconds
FROM pit_stops
LIMIT 20;
```

```sql
-- 3) Check every lap_type that exists to understand what must be filtered out
SELECT DISTINCT lap_type
FROM lap_positions
LIMIT 20;
```

```sql
-- 4) See how retirements are logged (lap on which driver stopped and status reason)
SELECT DISTINCT race_id,
       driver_id,
       lap,
       status_id,
       retirement_type
FROM retirements
LIMIT 20;
```

```sql
-- 5) Compute lap-to-lap position deltas (restricted to real “Race” laps)
WITH lp AS (
  SELECT race_id,
         driver_id,
         lap,
         position,
         LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
  FROM lap_positions
  WHERE lap_type = 'Race'
)
SELECT race_id,
       driver_id,
       lap,
       prev_pos,
       position,
       (prev_pos - position) AS delta            -- +ve = gained places, ‑ve = lost places
FROM lp
WHERE prev_pos IS NOT NULL
LIMIT 20;
```

```sql
-- 6) Tag every delta as ‘overtake’ (driver gains) or ‘overtaken’ (driver loses)
WITH lp AS (
  SELECT race_id,
         driver_id,
         lap,
         position,
         LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
  FROM lap_positions
  WHERE lap_type = 'Race'
)
SELECT race_id,
       driver_id,
       lap,
       CASE WHEN prev_pos  > position THEN 1 ELSE 0 END AS made_pass,
       CASE WHEN prev_pos  < position THEN 1 ELSE 0 END AS got_passed
FROM lp
WHERE prev_pos IS NOT NULL
  AND lap > 1                                 -- exclude lap-1 start moves
LIMIT 20;
```

```sql
-- 7) Remove laps that coincide with a pit-stop by the SAME driver
WITH lp AS (
  SELECT race_id,
         driver_id,
         lap,
         position,
         LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
  FROM lap_positions
  WHERE lap_type = 'Race'
),
tagged AS (
  SELECT l.*,
         (CASE WHEN p.driver_id IS NOT NULL THEN 1 END) AS is_own_pit
  FROM lp  AS l
  LEFT JOIN pit_stops AS p
         ON p.race_id = l.race_id
        AND p.driver_id = l.driver_id
        AND p.lap      = l.lap                -- pit-entry lap
)
SELECT race_id, driver_id, lap, prev_pos, position, is_own_pit
FROM tagged
WHERE prev_pos IS NOT NULL
  AND lap > 1
LIMIT 20;
```

```sql
-- 8) Exclude laps that are either own-pit laps OR one lap AFTER a pit-stop exit
WITH pit AS (
  SELECT race_id, driver_id, lap   -- pit-entry lap
  FROM pit_stops
),
lp AS (
  SELECT race_id,
         driver_id,
         lap,
         position,
         LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
  FROM lap_positions
  WHERE lap_type = 'Race'
),
valid_moves AS (
  SELECT l.*,
         CASE WHEN p1.lap IS NOT NULL               -- pit-entry
               OR p2.lap IS NOT NULL               -- lap immediately after pit exit
              THEN 1 END AS pit_related
  FROM lp AS l
  LEFT JOIN pit AS p1
         ON p1.race_id = l.race_id
        AND p1.driver_id = l.driver_id
        AND p1.lap = l.lap
  LEFT JOIN pit AS p2
         ON p2.race_id = l.race_id
        AND p2.driver_id = l.driver_id
        AND p2.lap = l.lap - 1                     -- exit lap
)
SELECT race_id,
       driver_id,
       lap,
       prev_pos,
       position,
       pit_related
FROM valid_moves
WHERE prev_pos IS NOT NULL
  AND lap > 1
  AND pit_related IS NULL                          -- keep only on-track moves
LIMIT 20;
```

```sql
-- 9) Aggregate on-track position changes into overtakes vs. being overtaken
WITH pit AS (
  SELECT race_id, driver_id, lap
  FROM pit_stops
),
moves AS (
  SELECT l.race_id,
         l.driver_id,
         l.lap,
         l.prev_pos,
         l.position
  FROM (
      SELECT race_id,
             driver_id,
             lap,
             position,
             LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
      FROM lap_positions
      WHERE lap_type = 'Race'
  ) AS l
  LEFT JOIN pit AS p1
         ON p1.race_id = l.race_id
        AND p1.driver_id = l.driver_id
        AND p1.lap = l.lap
  LEFT JOIN pit AS p2
         ON p2.race_id = l.race_id
        AND p2.driver_id = l.driver_id
        AND p2.lap = l.lap - 1
  WHERE l.prev_pos IS NOT NULL
    AND l.lap > 1
    AND p1.lap IS NULL
    AND p2.lap IS NULL
)
SELECT driver_id,
       SUM(CASE WHEN prev_pos > position THEN 1 ELSE 0 END) AS overtakes_made,
       SUM(CASE WHEN prev_pos < position THEN 1 ELSE 0 END) AS times_overtaken
FROM moves
GROUP BY driver_id
LIMIT 20;
```

```sql
-- 10) Final selection: drivers with negative net passes, joined to full names
WITH pit AS (
  SELECT race_id, driver_id, lap
  FROM pit_stops
),
moves AS (
  SELECT l.race_id,
         l.driver_id,
         l.lap,
         l.prev_pos,
         l.position
  FROM (
      SELECT race_id,
             driver_id,
             lap,
             position,
             LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
      FROM lap_positions
      WHERE lap_type = 'Race'
  ) AS l
  LEFT JOIN pit AS p1
         ON p1.race_id = l.race_id
        AND p1.driver_id = l.driver_id
        AND p1.lap = l.lap
  LEFT JOIN pit AS p2
         ON p2.race_id = l.race_id
        AND p2.driver_id = l.driver_id
        AND p2.lap = l.lap - 1
  WHERE l.prev_pos IS NOT NULL
    AND l.lap > 1
    AND p1.lap IS NULL
    AND p2.lap IS NULL
),
driver_totals AS (
  SELECT driver_id,
         SUM(CASE WHEN prev_pos > position THEN 1 ELSE 0 END) AS overtakes_made,
         SUM(CASE WHEN prev_pos < position THEN 1 ELSE 0 END) AS times_overtaken
  FROM moves
  GROUP BY driver_id
),
neg_net AS (
  SELECT driver_id
  FROM driver_totals
  WHERE times_overtaken > overtakes_made            -- more lost than gained
)
SELECT DISTINCT d.forename || ' ' || d.surname AS full_name
FROM drivers AS d
JOIN neg_net   AS n
  ON n.driver_id = d.driver_id
LIMIT 20;
```

Each successive query digs deeper—from basic inspection of lap data, pit-stop & retirement details, to calculating valid on-track moves and, finally, listing the full names of drivers whose “times overtaken” exceeds “overtakes made”.
