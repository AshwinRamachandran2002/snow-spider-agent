-- 7) Remove laps that coincide with a pit-stop by the SAME driver
WITH lp AS (
  SELECT race_id,
         driver_id,
         lap,
         position,
         LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
  FROM lap_positions
  WHERE lap_type = 'Race'
),
tagged AS (
  SELECT l.*,
         (CASE WHEN p.driver_id IS NOT NULL THEN 1 END) AS is_own_pit
  FROM lp  AS l
  LEFT JOIN pit_stops AS p
         ON p.race_id = l.race_id
        AND p.driver_id = l.driver_id
        AND p.lap      = l.lap                -- pit-entry lap
)
SELECT race_id, driver_id, lap, prev_pos, position, is_own_pit
FROM tagged
WHERE prev_pos IS NOT NULL
  AND lap > 1
LIMIT 20;
