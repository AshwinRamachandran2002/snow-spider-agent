-- 9) Aggregate on-track position changes into overtakes vs. being overtaken
WITH pit AS (
  SELECT race_id, driver_id, lap
  FROM pit_stops
),
moves AS (
  SELECT l.race_id,
         l.driver_id,
         l.lap,
         l.prev_pos,
         l.position
  FROM (
      SELECT race_id,
             driver_id,
             lap,
             position,
             LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
      FROM lap_positions
      WHERE lap_type = 'Race'
  ) AS l
  LEFT JOIN pit AS p1
         ON p1.race_id = l.race_id
        AND p1.driver_id = l.driver_id
        AND p1.lap = l.lap
  LEFT JOIN pit AS p2
         ON p2.race_id = l.race_id
        AND p2.driver_id = l.driver_id
        AND p2.lap = l.lap - 1
  WHERE l.prev_pos IS NOT NULL
    AND l.lap > 1
    AND p1.lap IS NULL
    AND p2.lap IS NULL
)
SELECT driver_id,
       SUM(CASE WHEN prev_pos > position THEN 1 ELSE 0 END) AS overtakes_made,
       SUM(CASE WHEN prev_pos < position THEN 1 ELSE 0 END) AS times_overtaken
FROM moves
GROUP BY driver_id
LIMIT 20;
