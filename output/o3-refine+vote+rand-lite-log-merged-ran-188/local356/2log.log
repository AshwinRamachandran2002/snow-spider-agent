-- 5) Compute lap-to-lap position deltas (restricted to real “Race” laps)
WITH lp AS (
  SELECT race_id,
         driver_id,
         lap,
         position,
         LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
  FROM lap_positions
  WHERE lap_type = 'Race'
)
SELECT race_id,
       driver_id,
       lap,
       prev_pos,
       position,
       (prev_pos - position) AS delta            -- +ve = gained places, ‑ve = lost places
FROM lp
WHERE prev_pos IS NOT NULL
LIMIT 20;
