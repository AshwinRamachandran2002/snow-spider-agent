-- 10) Final selection: drivers with negative net passes, joined to full names
WITH pit AS (
  SELECT race_id, driver_id, lap
  FROM pit_stops
),
moves AS (
  SELECT l.race_id,
         l.driver_id,
         l.lap,
         l.prev_pos,
         l.position
  FROM (
      SELECT race_id,
             driver_id,
             lap,
             position,
             LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
      FROM lap_positions
      WHERE lap_type = 'Race'
  ) AS l
  LEFT JOIN pit AS p1
         ON p1.race_id = l.race_id
        AND p1.driver_id = l.driver_id
        AND p1.lap = l.lap
  LEFT JOIN pit AS p2
         ON p2.race_id = l.race_id
        AND p2.driver_id = l.driver_id
        AND p2.lap = l.lap - 1
  WHERE l.prev_pos IS NOT NULL
    AND l.lap > 1
    AND p1.lap IS NULL
    AND p2.lap IS NULL
),
driver_totals AS (
  SELECT driver_id,
         SUM(CASE WHEN prev_pos > position THEN 1 ELSE 0 END) AS overtakes_made,
         SUM(CASE WHEN prev_pos < position THEN 1 ELSE 0 END) AS times_overtaken
  FROM moves
  GROUP BY driver_id
),
neg_net AS (
  SELECT driver_id
  FROM driver_totals
  WHERE times_overtaken > overtakes_made            -- more lost than gained
)
SELECT DISTINCT d.forename || ' ' || d.surname AS full_name
FROM drivers AS d
JOIN neg_net   AS n
  ON n.driver_id = d.driver_id
LIMIT 20;
