Query:
--Description: Rank the 10 worst drivers by “net negative” overtakes (times_overtaken − overtakes_made)
WITH deltas AS (
  SELECT curr.race_id,
         curr.driver_id,
         (prev.position - curr.position) AS gain
  FROM lap_positions AS curr
  JOIN lap_positions AS prev
       ON curr.race_id  = prev.race_id
      AND curr.driver_id = prev.driver_id
      AND curr.lap       = prev.lap + 1
  LEFT JOIN retirements AS r
       ON curr.race_id  = r.race_id
      AND curr.driver_id = r.driver_id
  WHERE curr.lap_type = 'Race'
    AND prev.lap_type = 'Race'
    AND curr.lap      > 1
    AND (r.lap IS NULL OR curr.lap < r.lap)
), agg AS (
  SELECT driver_id,
         SUM(CASE WHEN gain > 0 THEN 1 ELSE 0 END) AS overtakes_made,
         SUM(CASE WHEN gain < 0 THEN 1 ELSE 0 END) AS times_overtaken
  FROM deltas
  GROUP BY driver_id
)
SELECT d.full_name,
       (agg.times_overtaken - agg.overtakes_made) AS net_negative_overtakes,
       agg.overtakes_made,
       agg.times_overtaken
FROM agg
JOIN drivers AS d ON d.driver_id = agg.driver_id
WHERE agg.times_overtaken > agg.overtakes_made
ORDER BY net_negative_overtakes DESC
LIMIT 10;
