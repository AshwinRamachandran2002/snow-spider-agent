```sql
--Description: Preview how drivers’ positions evolve during the opening laps of race 1
SELECT race_id,
       driver_id,
       lap,
       position,
       lap_type
FROM lap_positions
WHERE race_id = 1
ORDER BY lap, driver_id
LIMIT 20;
```

```sql
--Description: Compute lap-to-lap position changes for every driver in race 1 (ignoring start-lap)
SELECT curr.driver_id,
       curr.lap,
       prev.position AS prev_pos,
       curr.position AS curr_pos,
       (prev.position - curr.position) AS position_gain          -- >0 = made overtake; <0 = was overtaken
FROM lap_positions AS curr
JOIN lap_positions AS prev
  ON curr.race_id = prev.race_id
 AND curr.driver_id = prev.driver_id
 AND curr.lap       = prev.lap + 1
WHERE curr.race_id  = 1
  AND curr.lap_type = 'Race'
  AND prev.lap_type = 'Race'
  AND curr.lap      > 1                                         -- exclude start-lap movements
ORDER BY curr.lap, curr.driver_id
LIMIT 20;
```

```sql
--Description: Aggregate on-track overtakes vs. times being overtaken for every driver (all races, no pit / no start-lap)
WITH deltas AS (
  SELECT curr.driver_id,
         (prev.position - curr.position) AS gain
  FROM lap_positions AS curr
  JOIN lap_positions AS prev
    ON curr.race_id = prev.race_id
   AND curr.driver_id = prev.driver_id
   AND curr.lap       = prev.lap + 1
  WHERE curr.lap_type = 'Race'
    AND prev.lap_type = 'Race'
    AND curr.lap      > 1
)
SELECT driver_id,
       SUM(CASE WHEN gain > 0 THEN 1 ELSE 0 END) AS overtakes_made,
       SUM(CASE WHEN gain < 0 THEN 1 ELSE 0 END) AS times_overtaken
FROM deltas
GROUP BY driver_id
LIMIT 20;
```

```sql
--Description: Exclude laps recorded after a driver retired from a race
WITH deltas AS (
  SELECT curr.race_id,
         curr.driver_id,
         curr.lap,
         (prev.position - curr.position) AS gain
  FROM lap_positions AS curr
  JOIN lap_positions AS prev
       ON curr.race_id  = prev.race_id
      AND curr.driver_id = prev.driver_id
      AND curr.lap       = prev.lap + 1
  LEFT JOIN retirements AS r
       ON curr.race_id  = r.race_id
      AND curr.driver_id = r.driver_id
  WHERE curr.lap_type = 'Race'
    AND prev.lap_type = 'Race'
    AND curr.lap      > 1
    AND (r.lap IS NULL OR curr.lap < r.lap)                      -- keep only laps before retirement
)
SELECT driver_id,
       SUM(CASE WHEN gain > 0 THEN 1 ELSE 0 END) AS overtakes_made,
       SUM(CASE WHEN gain < 0 THEN 1 ELSE 0 END) AS times_overtaken
FROM deltas
GROUP BY driver_id
LIMIT 20;
```

```sql
--Description: List driver_ids that have been overtaken more times than they have overtaken others
WITH deltas AS (
  SELECT curr.race_id,
         curr.driver_id,
         (prev.position - curr.position) AS gain
  FROM lap_positions AS curr
  JOIN lap_positions AS prev
       ON curr.race_id  = prev.race_id
      AND curr.driver_id = prev.driver_id
      AND curr.lap       = prev.lap + 1
  LEFT JOIN retirements AS r
       ON curr.race_id  = r.race_id
      AND curr.driver_id = r.driver_id
  WHERE curr.lap_type = 'Race'
    AND prev.lap_type = 'Race'
    AND curr.lap      > 1
    AND (r.lap IS NULL OR curr.lap < r.lap)
), agg AS (
  SELECT driver_id,
         SUM(CASE WHEN gain > 0 THEN 1 ELSE 0 END) AS overtakes_made,
         SUM(CASE WHEN gain < 0 THEN 1 ELSE 0 END) AS times_overtaken
  FROM deltas
  GROUP BY driver_id
)
SELECT DISTINCT driver_id
FROM agg
WHERE times_overtaken > overtakes_made
LIMIT 20;
```

```sql
--Description: Retrieve the full names of those drivers
WITH deltas AS (
  SELECT curr.race_id,
         curr.driver_id,
         (prev.position - curr.position) AS gain
  FROM lap_positions AS curr
  JOIN lap_positions AS prev
       ON curr.race_id  = prev.race_id
      AND curr.driver_id = prev.driver_id
      AND curr.lap       = prev.lap + 1
  LEFT JOIN retirements AS r
       ON curr.race_id  = r.race_id
      AND curr.driver_id = r.driver_id
  WHERE curr.lap_type = 'Race'
    AND prev.lap_type = 'Race'
    AND curr.lap      > 1
    AND (r.lap IS NULL OR curr.lap < r.lap)
), agg AS (
  SELECT driver_id,
         SUM(CASE WHEN gain > 0 THEN 1 ELSE 0 END) AS overtakes_made,
         SUM(CASE WHEN gain < 0 THEN 1 ELSE 0 END) AS times_overtaken
  FROM deltas
  GROUP BY driver_id
)
SELECT d.full_name
FROM agg
JOIN drivers AS d ON d.driver_id = agg.driver_id
WHERE agg.times_overtaken > agg.overtakes_made
LIMIT 20;
```

```sql
--Description: Rank the 10 worst drivers by “net negative” overtakes (times_overtaken − overtakes_made)
WITH deltas AS (
  SELECT curr.race_id,
         curr.driver_id,
         (prev.position - curr.position) AS gain
  FROM lap_positions AS curr
  JOIN lap_positions AS prev
       ON curr.race_id  = prev.race_id
      AND curr.driver_id = prev.driver_id
      AND curr.lap       = prev.lap + 1
  LEFT JOIN retirements AS r
       ON curr.race_id  = r.race_id
      AND curr.driver_id = r.driver_id
  WHERE curr.lap_type = 'Race'
    AND prev.lap_type = 'Race'
    AND curr.lap      > 1
    AND (r.lap IS NULL OR curr.lap < r.lap)
), agg AS (
  SELECT driver_id,
         SUM(CASE WHEN gain > 0 THEN 1 ELSE 0 END) AS overtakes_made,
         SUM(CASE WHEN gain < 0 THEN 1 ELSE 0 END) AS times_overtaken
  FROM deltas
  GROUP BY driver_id
)
SELECT d.full_name,
       (agg.times_overtaken - agg.overtakes_made) AS net_negative_overtakes,
       agg.overtakes_made,
       agg.times_overtaken
FROM agg
JOIN drivers AS d ON d.driver_id = agg.driver_id
WHERE agg.times_overtaken > agg.overtakes_made
ORDER BY net_negative_overtakes DESC
LIMIT 10;
```

