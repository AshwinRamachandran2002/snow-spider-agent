Query:
--Description: Compute lap-to-lap position changes for every driver in race 1 (ignoring start-lap)
SELECT curr.driver_id,
       curr.lap,
       prev.position AS prev_pos,
       curr.position AS curr_pos,
       (prev.position - curr.position) AS position_gain          -- >0 = made overtake; <0 = was overtaken
FROM lap_positions AS curr
JOIN lap_positions AS prev
  ON curr.race_id = prev.race_id
 AND curr.driver_id = prev.driver_id
 AND curr.lap       = prev.lap + 1
WHERE curr.race_id  = 1
  AND curr.lap_type = 'Race'
  AND prev.lap_type = 'Race'
  AND curr.lap      > 1                                         -- exclude start-lap movements
ORDER BY curr.lap, curr.driver_id
LIMIT 20;
