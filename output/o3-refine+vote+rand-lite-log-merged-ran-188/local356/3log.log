Query:
--Description: Flag laps that coincide with a pit-stop for any race (removed race-id = 1 filter so rows actually exist).
SELECT lp."race_id",
       lp."driver_id",
       lp."lap",
       lp."position",
       CASE WHEN ps."lap" IS NOT NULL THEN 1 ELSE 0 END AS "is_pit_lap"
FROM   "lap_positions" AS lp
LEFT   JOIN "pit_stops" AS ps
       ON lp."race_id"  = ps."race_id"
      AND lp."driver_id"= ps."driver_id"
      AND lp."lap"      = ps."lap"
WHERE  ps."lap" IS NOT NULL          -- keep only laps that are pit-related so the result set is small
ORDER  BY lp."race_id", lp."driver_id", lp."lap"
LIMIT 20
