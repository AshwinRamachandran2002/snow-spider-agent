Query:
--Description: Compute lap-to-lap position changes (Δ) in race 1 while ignoring the first lap; this query was already valid and requires no change.
WITH lp AS (
     SELECT *
     FROM   "lap_positions"
     WHERE  "race_id" = 1
       AND  "lap_type" = 'Race'
),
pc AS (
     SELECT lp."race_id",
            lp."driver_id",
            lp."lap",
            LAG(lp."position")
              OVER (PARTITION BY lp."race_id", lp."driver_id" ORDER BY lp."lap") AS "prev_pos",
            lp."position" AS "curr_pos"
     FROM   lp
)
SELECT "race_id",
       "driver_id",
       "lap",
       "prev_pos",
       "curr_pos",
       ("prev_pos" - "curr_pos") AS "delta"
FROM   pc
WHERE  "prev_pos" IS NOT NULL
  AND  "lap" > 1
ORDER  BY "driver_id", "lap"
LIMIT 20
