```

```sql
--Description: Flag each lap in race 1 that coincides with a pit-stop (1 = pit lap, 0 = normal lap).
SELECT lp."race_id",
       lp."driver_id",
       lp."lap",
       lp."position",
       CASE WHEN ps."lap" IS NOT NULL THEN 1 ELSE 0 END AS "is_pit_lap"
FROM "lap_positions" AS lp
LEFT JOIN "pit_stops" AS ps
  ON lp."race_id" = ps."race_id"
 AND lp."driver_id" = ps."driver_id"
 AND lp."lap" = ps."lap"
WHERE lp."race_id" = 1
ORDER BY lp."driver_id", lp."lap"
LIMIT 20;
```

```sql
--Description: Compute lap-to-lap position changes (Δ) in race 1, ignoring the first lap.
WITH lp AS (
  SELECT *
  FROM "lap_positions"
  WHERE "race_id" = 1
    AND "lap_type" = 'Race'
),
pc AS (
  SELECT lp."race_id",
         lp."driver_id",
         lp."lap",
         LAG(lp."position")
           OVER (PARTITION BY lp."race_id", lp."driver_id" ORDER BY lp."lap") AS "prev_pos",
         lp."position"                                 AS "curr_pos"
  FROM lp
)
SELECT "race_id",
       "driver_id",
       "lap",
       "prev_pos",
       "curr_pos",
       ("prev_pos" - "curr_pos") AS "delta"
FROM pc
WHERE "prev_pos" IS NOT NULL
  AND "lap" > 1
ORDER BY "driver_id", "lap"
LIMIT 20;
```

```sql
--Description: For all races, show every clean (non-pit, post-lap-1) position change and aggregate overtakes made vs. times being passed.
WITH race_laps AS (      -- keep only pure race laps
     SELECT lp."race_id",
            lp."driver_id",
            lp."lap",
            lp."position",
            LAG(lp."position") OVER
              (PARTITION BY lp."race_id", lp."driver_id" ORDER BY lp."lap") AS "prev_position"
     FROM   "lap_positions" AS lp
     WHERE  lp."lap_type" = 'Race'
),
clean_laps AS (          -- remove first lap & pit-stop laps
     SELECT rl.*
     FROM   race_laps AS rl
     LEFT   JOIN "pit_stops" AS ps
            ON rl."race_id"  = ps."race_id"
           AND rl."driver_id"= ps."driver_id"
           AND rl."lap"      = ps."lap"
     WHERE  rl."prev_position" IS NOT NULL
       AND  rl."lap" > 1
       AND  ps."lap" IS NULL
),
deltas AS (
     SELECT "race_id",
            "driver_id",
            ("prev_position" - "position") AS "delta"
     FROM   clean_laps
)
SELECT d."full_name",
       SUM(CASE WHEN delta > 0 THEN delta ELSE 0 END)                     AS "overtakes_made",
       ABS(SUM(CASE WHEN delta < 0 THEN delta ELSE 0 END))               AS "times_overtaken"
FROM   deltas
JOIN   "drivers_ext" AS d
       ON d."driver_id" = deltas."driver_id"
GROUP  BY deltas."driver_id"
ORDER  BY "times_overtaken" DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – drivers whose on-track losses (being passed) exceed the passes they executed,
--             excluding pit-related laps, retirements, and start-lap movements.
WITH retirement_laps AS (                -- first lap on which each driver retired
     SELECT "race_id",
            "driver_id",
            MIN("lap") AS "retire_lap"
     FROM   "retirements"
     GROUP  BY "race_id", "driver_id"
),
race_laps AS (                           -- only “Race” laps
     SELECT lp."race_id",
            lp."driver_id",
            lp."lap",
            lp."position",
            LAG(lp."position") OVER
              (PARTITION BY lp."race_id", lp."driver_id" ORDER BY lp."lap") AS "prev_position"
     FROM   "lap_positions" AS lp
     WHERE  lp."lap_type" = 'Race'
),
clean_laps AS (                          -- remove first lap, pit laps, and laps on/after retirement
     SELECT rl.*
     FROM   race_laps AS rl
     LEFT   JOIN "pit_stops"      AS ps
            ON rl."race_id"   = ps."race_id"
           AND rl."driver_id" = ps."driver_id"
           AND rl."lap"       = ps."lap"
     LEFT   JOIN retirement_laps AS r
            ON rl."race_id"   = r."race_id"
           AND rl."driver_id" = r."driver_id"
     WHERE  rl."prev_position" IS NOT NULL
       AND  rl."lap" > 1
       AND  ps."lap" IS NULL
       AND (r."retire_lap" IS NULL OR rl."lap" < r."retire_lap")
),
deltas AS (                              -- position deltas (+ = overtake made, − = overtaken)
     SELECT "race_id",
            "driver_id",
            ("prev_position" - "position") AS "delta"
     FROM   clean_laps
),
agg AS (                                 -- total overtakes made vs. suffered
     SELECT "driver_id",
            SUM(CASE WHEN delta > 0 THEN  delta ELSE 0 END)                AS "overtakes_made",
            ABS(SUM(CASE WHEN delta < 0 THEN delta ELSE 0 END))            AS "times_overtaken"
     FROM   deltas
     GROUP  BY "driver_id"
)
SELECT DISTINCT d."full_name"
FROM   agg
JOIN   "drivers_ext" AS d
       ON d."driver_id" = agg."driver_id"
WHERE  "times_overtaken" > "overtakes_made";
```
