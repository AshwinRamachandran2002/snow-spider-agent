--Description: Show every clean (non-pit, post-lap-1) position change and aggregate overtakes vs. times passed for all races; original query already functioned without race-specific filters.
WITH race_laps AS (
     SELECT lp."race_id",
            lp."driver_id",
            lp."lap",
            lp."position",
            LAG(lp."position") OVER
              (PARTITION BY lp."race_id", lp."driver_id" ORDER BY lp."lap") AS "prev_position"
     FROM   "lap_positions" AS lp
     WHERE  lp."lap_type" = 'Race'
),
clean_laps AS (
     SELECT rl.*
     FROM   race_laps AS rl
     LEFT   JOIN "pit_stops" AS ps
            ON rl."race_id"  = ps."race_id"
           AND rl."driver_id"= ps."driver_id"
           AND rl."lap"      = ps."lap"
     WHERE  rl."prev_position" IS NOT NULL
       AND  rl."lap" > 1
       AND  ps."lap" IS NULL
),
deltas AS (
     SELECT "race_id",
            "driver_id",
            ("prev_position" - "position") AS "delta"
     FROM   clean_laps
)
SELECT d."full_name",
       SUM(CASE WHEN delta > 0 THEN delta ELSE 0 END)  AS "overtakes_made",
       ABS(SUM(CASE WHEN delta < 0 THEN delta ELSE 0 END)) AS "times_overtaken"
FROM   deltas
JOIN   "drivers_ext" AS d
       ON d."driver_id" = deltas."driver_id"
GROUP  BY deltas."driver_id"
ORDER  BY "times_overtaken" DESC
LIMIT 20
