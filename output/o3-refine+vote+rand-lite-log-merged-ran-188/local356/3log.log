     LEFT   JOIN "pit_stops" AS ps
            ON rl."race_id"  = ps."race_id"
           AND rl."driver_id"= ps."driver_id"
           AND rl."lap"      = ps."lap"
     LEFT   JOIN retirement_laps AS r
            ON rl."race_id"  = r."race_id"
           AND rl."driver_id"= r."driver_id"
     WHERE  rl."prev_position" IS NOT NULL
       AND  rl."lap" > 1
