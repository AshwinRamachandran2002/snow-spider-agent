```sql
-- 5. For every driver-lap pair in every race, compare the position to the previous lap
--    (ignoring lap-1, pit-stop laps, retirement laps and non-race lap types).
--    We calculate two counters: overtakes (improved position) and times-overtaken (lost position).
SELECT  lp1."race_id",
        lp1."driver_id",
        SUM(CASE WHEN lp1."position" < lp0."position" THEN 1 END) AS "overtakes",
        SUM(CASE WHEN lp1."position" > lp0."position" THEN 1 END) AS "times_overtaken"
FROM    "lap_positions" AS lp1
JOIN    "lap_positions" AS lp0
           ON  lp1."race_id"  = lp0."race_id"
           AND lp1."driver_id"= lp0."driver_id"
           AND lp1."lap"      = lp0."lap" + 1
LEFT JOIN "pit_stops"    AS ps
           ON  lp1."race_id"  = ps."race_id"
           AND lp1."driver_id"= ps."driver_id"
           AND lp1."lap"      = ps."lap"
LEFT JOIN "retirements"  AS rt
           ON  lp1."race_id"  = rt."race_id"
           AND lp1."driver_id"= rt."driver_id"
           AND lp1."lap"      >= rt."lap"
WHERE   lp1."lap"        > 1
  AND   lp1."lap_type"   = 'Race'
  AND   lp0."lap_type"   = 'Race'
  AND   ps."driver_id"   IS NULL        -- exclude pit-in / pit-out moves
  AND   rt."driver_id"   IS NULL        -- exclude laps after retirement
GROUP BY lp1."race_id", lp1."driver_id"
LIMIT 20;
```

```sql
-- 6. Aggregate the two counters across all races for every driver.
WITH per_race AS (
    SELECT  lp1."driver_id",
            SUM(CASE WHEN lp1."position" < lp0."position" THEN 1 END) AS "overtakes",
            SUM(CASE WHEN lp1."position" > lp0."position" THEN 1 END) AS "times_overtaken"
    FROM    "lap_positions" AS lp1
    JOIN    "lap_positions" AS lp0
               ON  lp1."race_id"  = lp0."race_id"
               AND lp1."driver_id"= lp0."driver_id"
               AND lp1."lap"      = lp0."lap" + 1
    LEFT JOIN "pit_stops"    AS ps
               ON  lp1."race_id"  = ps."race_id"
               AND lp1."driver_id"= ps."driver_id"
               AND lp1."lap"      = ps."lap"
    LEFT JOIN "retirements"  AS rt
               ON  lp1."race_id"  = rt."race_id"
               AND lp1."driver_id"= rt."driver_id"
               AND lp1."lap"      >= rt."lap"
    WHERE   lp1."lap"        > 1
      AND   lp1."lap_type"   = 'Race'
      AND   lp0."lap_type"   = 'Race'
      AND   ps."driver_id"   IS NULL
      AND   rt."driver_id"   IS NULL
    GROUP BY lp1."race_id", lp1."driver_id"
)
SELECT  "driver_id",
        SUM("overtakes")        AS "total_overtakes",
        SUM("times_overtaken")  AS "total_times_overtaken"
FROM    per_race
GROUP BY "driver_id"
LIMIT 20;
```

```sql
-- 7. Identify the drivers whose total_times_overtaken > total_overtakes.
WITH per_race AS (
    SELECT  lp1."driver_id",
            SUM(CASE WHEN lp1."position" < lp0."position" THEN 1 END) AS "overtakes",
            SUM(CASE WHEN lp1."position" > lp0."position" THEN 1 END) AS "times_overtaken"
    FROM    "lap_positions" AS lp1
    JOIN    "lap_positions" AS lp0
               ON  lp1."race_id"  = lp0."race_id"
               AND lp1."driver_id"= lp0."driver_id"
               AND lp1."lap"      = lp0."lap" + 1
    LEFT JOIN "pit_stops"    AS ps
               ON  lp1."race_id"  = ps."race_id"
               AND lp1."driver_id"= ps."driver_id"
               AND lp1."lap"      = ps."lap"
    LEFT JOIN "retirements"  AS rt
               ON  lp1."race_id"  = rt."race_id"
               AND lp1."driver_id"= rt."driver_id"
               AND lp1."lap"      >= rt."lap"
    WHERE   lp1."lap"        > 1
      AND   lp1."lap_type"   = 'Race'
      AND   lp0."lap_type"   = 'Race'
      AND   ps."driver_id"   IS NULL
      AND   rt."driver_id"   IS NULL
    GROUP BY lp1."race_id", lp1."driver_id"
),
totals AS (
    SELECT  "driver_id",
            SUM("overtakes")        AS "total_overtakes",
            SUM("times_overtaken")  AS "total_times_overtaken"
    FROM    per_race
    GROUP BY "driver_id"
)
SELECT  "driver_id",
        "total_overtakes",
        "total_times_overtaken"
FROM    totals
WHERE   "total_times_overtaken" > "total_overtakes"
LIMIT 20;
```

```sql
-- 8. Join with drivers table to get the full names of those drivers.
WITH per_race AS (
    SELECT  lp1."driver_id",
            SUM(CASE WHEN lp1."position" < lp0."position" THEN 1 END) AS "overtakes",
            SUM(CASE WHEN lp1."position" > lp0."position" THEN 1 END) AS "times_overtaken"
    FROM    "lap_positions" AS lp1
    JOIN    "lap_positions" AS lp0
               ON  lp1."race_id"  = lp0."race_id"
               AND lp1."driver_id"= lp0."driver_id"
               AND lp1."lap"      = lp0."lap" + 1
    LEFT JOIN "pit_stops"    AS ps
               ON  lp1."race_id"  = ps."race_id"
               AND lp1."driver_id"= ps."driver_id"
               AND lp1."lap"      = ps."lap"
    LEFT JOIN "retirements"  AS rt
               ON  lp1."race_id"  = rt."race_id"
               AND lp1."driver_id"= rt."driver_id"
               AND lp1."lap"      >= rt."lap"
    WHERE   lp1."lap"        > 1
      AND   lp1."lap_type"   = 'Race'
      AND   lp0."lap_type"   = 'Race'
      AND   ps."driver_id"   IS NULL
      AND   rt."driver_id"   IS NULL
    GROUP BY lp1."race_id", lp1."driver_id"
),
totals AS (
    SELECT  "driver_id",
            SUM("overtakes")        AS "total_overtakes",
            SUM("times_overtaken")  AS "total_times_overtaken"
    FROM    per_race
    GROUP BY "driver_id"
)
SELECT  d."full_name"
FROM    totals  AS t
JOIN    "drivers_ext" AS d
       ON  d."driver_id" = t."driver_id"
WHERE   t."total_times_overtaken" > t."total_overtakes"
ORDER BY (t."total_times_overtaken" - t."total_overtakes") DESC
LIMIT 20;
