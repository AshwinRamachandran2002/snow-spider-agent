--Description: Build simplified channel groups for the whole of December-2020.  
--             Extract sid inside a sub-query, filter non-NULL, then aggregate.
WITH dec_events AS (
  SELECT DISTINCT
    `user_pseudo_id`,
    sid,
    LOWER(ts.medium) AS medium,
    ts.source        AS source
  FROM (
    SELECT
      `user_pseudo_id`,
      `traffic_source` AS ts,
      (SELECT ep.value.int_value
         FROM UNNEST(`event_params`) ep
         WHERE ep.key = 'ga_session_id') AS sid
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  )
  WHERE sid IS NOT NULL
),
channels AS (
  SELECT
    CASE
      WHEN source = '(direct)' AND medium IN ('(not set)','(none)') THEN 'Direct'
      WHEN medium = 'organic'                                           THEN 'Organic Search'
      WHEN medium = 'referral'                                          THEN 'Referral'
      ELSE 'Unassigned'
    END AS channel_group
  FROM dec_events
)
SELECT
  channel_group,
  COUNT(*) AS sessions
FROM channels
GROUP BY channel_group
ORDER BY sessions DESC
LIMIT 20
