```sql
-- 7. Description:  Map those media into simplified channel groups (1-Dec only)
WITH s AS (
  SELECT DISTINCT
    `user_pseudo_id`,
    (SELECT ep.value.int_value 
       FROM UNNEST(`event_params`) ep 
       WHERE ep.key = 'ga_session_id') AS sid,
    LOWER(`traffic_source`.medium)  AS medium,
    `traffic_source`.source        AS source
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
  WHERE sid IS NOT NULL
)
SELECT
  CASE
    WHEN source = '(direct)' AND medium IN ('(not set)','(none)') THEN 'Direct'
    WHEN medium = 'organic'                                           THEN 'Organic Search'
    WHEN medium = 'referral'                                          THEN 'Referral'
    ELSE 'Unassigned'
  END AS channel_group,
  COUNT(*) AS sessions
FROM s
GROUP BY channel_group
ORDER BY sessions DESC
LIMIT 20;
```

```sql
-- 8. Description:  Build the same simplified channels for the **whole of December 2020**
WITH dec_events AS (
  SELECT DISTINCT
    `user_pseudo_id`,
    (SELECT ep.value.int_value 
       FROM UNNEST(`event_params`) ep 
       WHERE ep.key = 'ga_session_id') AS sid,
    LOWER(`traffic_source`.medium)  AS medium,
    `traffic_source`.source        AS source
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE sid IS NOT NULL
),
channels AS (
  SELECT
    CASE
      WHEN source = '(direct)' AND medium IN ('(not set)','(none)') THEN 'Direct'
      WHEN medium = 'organic'                                           THEN 'Organic Search'
      WHEN medium = 'referral'                                          THEN 'Referral'
      ELSE 'Unassigned'
    END AS channel_group
  FROM dec_events
)
SELECT 
  channel_group,
  COUNT(*) AS sessions
FROM channels
GROUP BY channel_group
ORDER BY sessions DESC
LIMIT 20;
```

```sql
-- 9. Description:  Rank those December channels by session volume
WITH base AS (
  -- (same CTE as query 8)
  SELECT DISTINCT
    `user_pseudo_id`,
    (SELECT ep.value.int_value 
       FROM UNNEST(`event_params`) ep 
       WHERE ep.key = 'ga_session_id') AS sid,
    LOWER(`traffic_source`.medium)  AS medium,
    `traffic_source`.source        AS source
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE sid IS NOT NULL
),
agg AS (
  SELECT
    CASE
      WHEN source = '(direct)' AND medium IN ('(not set)','(none)') THEN 'Direct'
      WHEN medium = 'organic'                                           THEN 'Organic Search'
      WHEN medium = 'referral'                                          THEN 'Referral'
      ELSE 'Unassigned'
    END                     AS channel_group,
    COUNT(DISTINCT CONCAT(`user_pseudo_id`,'-',sid)) AS sessions
  FROM base
  GROUP BY channel_group
)
SELECT
  channel_group,
  sessions,
  DENSE_RANK() OVER (ORDER BY sessions DESC) AS rnk
FROM agg
ORDER BY rnk
LIMIT 20;
