--Description: Map 1-Dec sessions into simplified channel groups.  
--             Same “sid” extraction; COUNT sessions where sid present.
WITH s AS (
  SELECT DISTINCT
    `user_pseudo_id`,
    (SELECT ep.value.int_value
       FROM UNNEST(`event_params`) AS ep
       WHERE ep.key = 'ga_session_id') AS sid,
    LOWER(`traffic_source`.medium)  AS medium,
    `traffic_source`.source        AS source
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
)
SELECT
  CASE
    WHEN source = '(direct)' AND medium IN ('(not set)','(none)') THEN 'Direct'
    WHEN medium = 'organic'                                           THEN 'Organic Search'
    WHEN medium = 'referral'                                          THEN 'Referral'
    ELSE 'Unassigned'
  END AS channel_group,
  COUNTIF(sid IS NOT NULL) AS sessions
FROM s
GROUP BY channel_group
ORDER BY sessions DESC
LIMIT 20
Answer:
channel_group,sessions
Organic Search,1675
Unassigned,1245
Direct,1136
Referral,944
Query:
--Description: Build simplified channel groups for the whole of December-2020.  
--             Extract sid inside a sub-query, filter non-NULL, then aggregate.
WITH dec_events AS (
  SELECT DISTINCT
    `user_pseudo_id`,
    sid,
    LOWER(ts.medium) AS medium,
    ts.source        AS source
  FROM (
    SELECT
      `user_pseudo_id`,
      `traffic_source` AS ts,
      (SELECT ep.value.int_value
         FROM UNNEST(`event_params`) ep
         WHERE ep.key = 'ga_session_id') AS sid
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  )
  WHERE sid IS NOT NULL
),
channels AS (
  SELECT
    CASE
      WHEN source = '(direct)' AND medium IN ('(not set)','(none)') THEN 'Direct'
      WHEN medium = 'organic'                                           THEN 'Organic Search'
      WHEN medium = 'referral'                                          THEN 'Referral'
      ELSE 'Unassigned'
    END AS channel_group
  FROM dec_events
)
SELECT
  channel_group,
  COUNT(*) AS sessions
FROM channels
GROUP BY channel_group
ORDER BY sessions DESC
LIMIT 20
Answer:
channel_group,sessions
Organic Search,45656
Unassigned,33411
Direct,30825
Referral,23476
Query:
--Description: Rank December-2020 channels by session volume.  
--             “base” CTE extracts sid (non-NULL); “agg” counts distinct sessions; outer query ranks.
WITH base AS (
  SELECT DISTINCT
    `user_pseudo_id`,
    sid,
    LOWER(ts.medium) AS medium,
    ts.source        AS source
  FROM (
    SELECT
      `user_pseudo_id`,
      `traffic_source` AS ts,
      (SELECT ep.value.int_value
         FROM UNNEST(`event_params`) ep
         WHERE ep.key = 'ga_session_id') AS sid
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  )
  WHERE sid IS NOT NULL
),
agg AS (
  SELECT
    CASE
      WHEN source = '(direct)' AND medium IN ('(not set)','(none)') THEN 'Direct'
      WHEN medium = 'organic'                                           THEN 'Organic Search'
      WHEN medium = 'referral'                                          THEN 'Referral'
      ELSE 'Unassigned'
    END AS channel_group,
    COUNT(DISTINCT CONCAT(`user_pseudo_id`,'-',sid)) AS sessions
  FROM base
  GROUP BY channel_group
)
SELECT
  channel_group,
  sessions,
  DENSE_RANK() OVER (ORDER BY sessions DESC) AS rnk
FROM agg
ORDER BY rnk
LIMIT 20
Answer:
channel_group,sessions,rnk
Organic Search,45656,1
Unassigned,33411,2
Direct,30825,3
Referral,23476,4
