Query:
--Description: Count distinct sessions on 1-Dec-2020.  
--             1) Build CTE “sessions” that extracts ga_session_id via a correlated sub-query.  
--             2) Keep only rows where that id is present.  
--             3) COUNT(*) gives the number of sessions; LIMIT 20 just caps the single-row result.
WITH sessions AS (
  SELECT DISTINCT
    `user_pseudo_id`,
    (SELECT ep.value.int_value
       FROM UNNEST(`event_params`) AS ep
       WHERE ep.key = 'ga_session_id') AS ga_session_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
)
SELECT COUNT(*) AS sessions_20201201
FROM sessions
WHERE ga_session_id IS NOT NULL
LIMIT 20
Answer:
sessions_20201201
5000
Query:
--Description: Sessions per traffic-source medium for 1-Dec-2020.  
--             Create CTE “s” that carries session id (sid); filter non-NULL inside outer query.
WITH s AS (
  SELECT DISTINCT
    `user_pseudo_id`,
    (SELECT ep.value.int_value
       FROM UNNEST(`event_params`) AS ep
       WHERE ep.key = 'ga_session_id') AS sid,
    `traffic_source`.medium AS medium
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
)
SELECT
  medium,
  COUNTIF(sid IS NOT NULL) AS sessions
FROM s
GROUP BY medium
ORDER BY sessions DESC
LIMIT 20
