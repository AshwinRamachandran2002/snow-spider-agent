--Description: 10) Daily trend for whichever channel ranked 4-th (identified in query 8)
WITH channel_sessions AS (
  SELECT
    CASE
      WHEN LOWER(traffic_source.medium) IN ('(not set)', '(none)') 
           AND traffic_source.source = '(direct)' THEN 'Direct'
      WHEN LOWER(traffic_source.medium) = 'organic'  THEN 'Organic Search'
      WHEN LOWER(traffic_source.medium) = 'referral' THEN 'Referral'
      ELSE 'Other'
    END AS channel,
    event_date,
    CONCAT(
      user_pseudo_id, '-', 
      (SELECT ep.value.int_value
         FROM UNNEST(event_params) ep
         WHERE ep.key = 'ga_session_id')
    ) AS session_key
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
),
ranked AS (
  SELECT 
    channel,
    COUNT(DISTINCT session_key) AS sessions,
    ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT session_key) DESC) AS rn
  FROM channel_sessions
  GROUP BY channel
)
SELECT 
  cs.event_date,
  cs.channel,
  COUNT(DISTINCT cs.session_key) AS sessions
FROM channel_sessions cs
JOIN ranked r
  ON cs.channel = r.channel
WHERE r.rn = 4
GROUP BY cs.event_date, cs.channel
ORDER BY cs.event_date
LIMIT 20
