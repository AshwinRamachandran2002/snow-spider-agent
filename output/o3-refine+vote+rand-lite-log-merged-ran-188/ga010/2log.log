Query:
--Description: 6) Roll-up: sessions by simple channel group (Direct / Organic / Referral / Other)
SELECT
  CASE
    WHEN LOWER(traffic_source.medium) IN ('(not set)', '(none)') 
         AND traffic_source.source = '(direct)' THEN 'Direct'
    WHEN LOWER(traffic_source.medium) = 'organic'  THEN 'Organic Search'
    WHEN LOWER(traffic_source.medium) = 'referral' THEN 'Referral'
    ELSE 'Other'
  END AS channel,
  COUNT(
    DISTINCT CONCAT(
      user_pseudo_id, '-', 
      (SELECT ep.value.int_value
         FROM UNNEST(event_params) ep
         WHERE ep.key = 'ga_session_id')
    )
  ) AS sessions
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
GROUP BY channel
ORDER BY sessions DESC
LIMIT 20
