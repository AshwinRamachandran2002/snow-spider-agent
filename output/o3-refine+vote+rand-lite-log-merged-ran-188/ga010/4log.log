Query:
--Description: Show 20 sample sessions that belong to the channel ranking 4-th for December-2020
WITH classified_events AS (                       -- tag each event with a simple channel group
  SELECT
    CASE
      WHEN LOWER(traffic_source.source) = '(direct)'
           AND LOWER(traffic_source.medium) IN ('(not set)', '(none)')                 THEN 'Direct'
      WHEN LOWER(traffic_source.medium) = 'referral'                                   THEN 'Referral'
      WHEN LOWER(traffic_source.medium) = 'organic'                                    THEN 'Organic Search'
      WHEN LOWER(traffic_source.medium) IN ('email','e-mail','e_mail','e mail')        THEN 'Email'
      WHEN LOWER(traffic_source.medium) IN ('display','banner','cpm')                  THEN 'Display'
      ELSE 'Unassigned'
    END                                                        AS channel_group,
    user_pseudo_id,
    (SELECT ep.value.int_value               -- grab ga_session_id from nested event_params
       FROM UNNEST(event_params) AS ep
       WHERE ep.key = 'ga_session_id'
       LIMIT 1)                                               AS ga_session_id,
    event_name
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
),
ranked_channels AS (                           -- work out session totals & assign rank
  SELECT
    channel_group,
    COUNTIF(event_name = 'session_start') AS sessions,
    RANK() OVER (ORDER BY COUNTIF(event_name = 'session_start') DESC) AS rnk
  FROM  classified_events
  GROUP BY channel_group
)
SELECT DISTINCT
       user_pseudo_id,
       ga_session_id
FROM   classified_events
WHERE  event_name   = 'session_start'
  AND  channel_group = (SELECT channel_group          -- keep only 4-th-ranked channel
                        FROM   ranked_channels
                        WHERE  rnk = 4)
LIMIT  20
