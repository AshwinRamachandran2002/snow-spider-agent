```sql
--Description: 8)  Build a simplified GA4 “Channel group” out of source / medium pairs  
SELECT
  CASE
      WHEN LOWER(traffic_source.source) = '(direct)'
           AND LOWER(traffic_source.medium) IN ('(not set)', '(none)')          THEN 'Direct'
      WHEN LOWER(traffic_source.medium) = 'referral'                           THEN 'Referral'
      WHEN LOWER(traffic_source.medium) = 'organic'                            THEN 'Organic Search'
      WHEN LOWER(traffic_source.medium) IN ('email','e-mail','e_mail','e mail')THEN 'Email'
      WHEN LOWER(traffic_source.medium) IN ('display','banner','cpm')          THEN 'Display'
      ELSE 'Unassigned'
  END                                       AS channel_group,
  COUNTIF(event_name = 'session_start')     AS sessions
FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
GROUP BY channel_group
ORDER BY sessions DESC
LIMIT   20;
```

```sql
--Description: 9)  Isolate the channel that ranks 4th in sessions in December 2020  
WITH channel_sessions AS (
  SELECT
    CASE
        WHEN LOWER(traffic_source.source) = '(direct)'
             AND LOWER(traffic_source.medium) IN ('(not set)', '(none)')          THEN 'Direct'
        WHEN LOWER(traffic_source.medium) = 'referral'                           THEN 'Referral'
        WHEN LOWER(traffic_source.medium) = 'organic'                            THEN 'Organic Search'
        WHEN LOWER(traffic_source.medium) IN ('email','e-mail','e_mail','e mail')THEN 'Email'
        WHEN LOWER(traffic_source.medium) IN ('display','banner','cpm')          THEN 'Display'
        ELSE 'Unassigned'
    END                               AS channel_group,
    COUNTIF(event_name = 'session_start') AS sessions
  FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  GROUP BY channel_group
)
SELECT  channel_group,
        sessions
FROM    channel_sessions
ORDER BY sessions DESC
OFFSET  3      -- 0-based index → 4th place
LIMIT   20;
```

```sql
--Description: 10)  Take a quick look at 20 individual sessions that belong to that 4th-place channel  
WITH channel_sessions AS (
  SELECT
    CASE
        WHEN LOWER(traffic_source.source) = '(direct)'
             AND LOWER(traffic_source.medium) IN ('(not set)', '(none)')          THEN 'Direct'
        WHEN LOWER(traffic_source.medium) = 'referral'                           THEN 'Referral'
        WHEN LOWER(traffic_source.medium) = 'organic'                            THEN 'Organic Search'
        WHEN LOWER(traffic_source.medium) IN ('email','e-mail','e_mail','e mail')THEN 'Email'
        WHEN LOWER(traffic_source.medium) IN ('display','banner','cpm')          THEN 'Display'
        ELSE 'Unassigned'
    END                       AS channel_group,
    user_pseudo_id,
    (SELECT value.int_value
       FROM UNNEST(event_params) AS ep
       WHERE ep.key = 'ga_session_id' LIMIT 1) AS ga_session_id
  FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE event_name = 'session_start'
)
SELECT  DISTINCT user_pseudo_id,
        ga_session_id
FROM    channel_sessions
WHERE   channel_group = (       -- reuse the 4th place calculated above
          SELECT channel_group
          FROM   (SELECT channel_group, sessions,
                         RANK() OVER (ORDER BY sessions DESC) AS rnk
                  FROM   (SELECT channel_group, COUNT(*) AS sessions
                          FROM channel_sessions
                          GROUP BY channel_group))
          WHERE  rnk = 4
        )
LIMIT   20;
```
