```sql
-- 6.  Build a simple channel grouping following the default GA4 rules subset
-- Description:  Attach a channel name to every session_start row for December
SELECT
  CASE
      WHEN LOWER(traffic_source.source)  = '(direct)'
           AND (traffic_source.medium IS NULL
                OR traffic_source.medium IN ('(not set)', '(none)'))              THEN 'Direct'
      WHEN LOWER(traffic_source.medium) = 'organic'                               THEN 'Organic Search'
      WHEN LOWER(traffic_source.medium) = 'referral'                              THEN 'Referral'
      WHEN LOWER(traffic_source.medium) IN ('display','banner','expandable',
                                            'interstitial','cpm')                 THEN 'Display'
      WHEN REGEXP_CONTAINS(LOWER(traffic_source.medium), r'cpc|ppc|paid')         THEN 'Paid Search'
      ELSE 'Unassigned'
  END AS channel_group,
  traffic_source.source,
  traffic_source.medium,
  user_pseudo_id,
  (SELECT ep.value.int_value FROM UNNEST(event_params) ep WHERE ep.key = 'ga_session_id' LIMIT 1) 
        AS session_id
FROM
  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
WHERE
  event_name = 'session_start'
LIMIT 20;
```

```sql
-- 7.  Aggregate the December sessions by the derived channel group
-- Description:  Sessions per channel; using DISTINCT user/ga_session_id pairs
SELECT
  channel_group,
  COUNT(DISTINCT CONCAT(user_pseudo_id,'-',CAST(session_id AS STRING))) AS sessions
FROM (
  SELECT
    CASE
        WHEN LOWER(traffic_source.source)  = '(direct)'
             AND (traffic_source.medium IS NULL
                  OR traffic_source.medium IN ('(not set)', '(none)'))              THEN 'Direct'
        WHEN LOWER(traffic_source.medium) = 'organic'                               THEN 'Organic Search'
        WHEN LOWER(traffic_source.medium) = 'referral'                              THEN 'Referral'
        WHEN LOWER(traffic_source.medium) IN ('display','banner','expandable',
                                              'interstitial','cpm')                 THEN 'Display'
        WHEN REGEXP_CONTAINS(LOWER(traffic_source.medium), r'cpc|ppc|paid')         THEN 'Paid Search'
        ELSE 'Unassigned'
    END                                                             AS channel_group,
    user_pseudo_id,
    (SELECT ep.value.int_value FROM UNNEST(event_params) ep
      WHERE ep.key = 'ga_session_id' LIMIT 1)                       AS session_id
  FROM
    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE
    event_name = 'session_start'
)
GROUP BY
  channel_group
ORDER BY
  sessions DESC
LIMIT 20;
```

```sql
-- 8.  Identify the channel with the 4th-highest number of sessions in December-2020
-- Description:  Rank channels by session volume and pick rank = 4
WITH ranked AS (
  SELECT
    channel_group,
    COUNT(DISTINCT CONCAT(user_pseudo_id,'-',CAST(session_id AS STRING))) AS sessions,
    DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT CONCAT(user_pseudo_id,'-',CAST(session_id AS STRING))) DESC) AS rnk
  FROM (
    SELECT
      CASE
          WHEN LOWER(traffic_source.source)  = '(direct)'
               AND (traffic_source.medium IS NULL
                    OR traffic_source.medium IN ('(not set)', '(none)'))            THEN 'Direct'
          WHEN LOWER(traffic_source.medium) = 'organic'                             THEN 'Organic Search'
          WHEN LOWER(traffic_source.medium) = 'referral'                            THEN 'Referral'
          WHEN LOWER(traffic_source.medium) IN ('display','banner','expandable',
                                                'interstitial','cpm')               THEN 'Display'
          WHEN REGEXP_CONTAINS(LOWER(traffic_source.medium), r'cpc|ppc|paid')       THEN 'Paid Search'
          ELSE 'Unassigned'
      END AS channel_group,
      user_pseudo_id,
      (SELECT ep.value.int_value FROM UNNEST(event_params) ep
        WHERE ep.key = 'ga_session_id' LIMIT 1)                     AS session_id
    FROM
      `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
    WHERE
      event_name = 'session_start'
  )
  GROUP BY
    channel_group
)
SELECT
  channel_group,
  sessions
FROM
  ranked
WHERE
  rnk = 4
LIMIT 20;
```

These eight queries move from simple inspection to the final answer—the channel that ranks fourth in December 2020 by number of sessions.
