```sql
--Description:  We calculate the share of users who first opened in September-2018,
--              then uninstalled within seven days, and who experienced at least
--              one crash (app_exception).  Steps embodied in this single query:
--   1) per_user CTE:
--        • scans all September-2018 daily tables (events_20180901-30);
--        • retains only rows whose user_first_touch_timestamp also falls in
--          September-2018 (guarantees “first-opened in September”);
--        • per user it captures
--              – first_touch_ts  = MIN(user_first_touch_timestamp);
--              – uninstall_ts    = earliest app_remove in Sept (NULL if none);
--              – has_crash       = 1 if any app_exception in Sept else 0.
--   2) qualified CTE:
--        • keeps users who actually uninstalled and did so
--          DATE_DIFF(uninstall_date, first_touch_date) between 0 and 7 days.
--   3) final SELECT:
--        • counts qualified users with crashes (crash_cnt),
--          total qualified users (uninstall_cnt),
--          computes percentage (pct_with_crash).
WITH per_user AS (
  SELECT
    user_pseudo_id,
    MIN(user_first_touch_timestamp)                                    AS first_touch_ts,
    MIN(IF(event_name = 'app_remove', event_timestamp, NULL))          AS uninstall_ts,
    MAX(IF(event_name = 'app_exception', 1, 0))                        AS has_crash
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
    AND DATE(TIMESTAMP_MICROS(user_first_touch_timestamp))
        BETWEEN '2018-09-01' AND '2018-09-30'
  GROUP BY user_pseudo_id
),
qualified AS (
  SELECT
    user_pseudo_id,
    has_crash
  FROM per_user
  WHERE uninstall_ts IS NOT NULL
    AND DATE_DIFF(
          DATE(TIMESTAMP_MICROS(uninstall_ts)),
          DATE(TIMESTAMP_MICROS(first_touch_ts)),
          DAY) BETWEEN 0 AND 7
)
SELECT
  COUNTIF(has_crash = 1)                              AS crash_cnt,
  COUNT(*)                                            AS uninstall_cnt,
  SAFE_DIVIDE(COUNTIF(has_crash = 1), COUNT(*)) * 100 AS pct_with_crash
FROM qualified;
