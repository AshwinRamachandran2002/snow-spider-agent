```sql
--Description: 7) Count the distinct September-first-touch users who
--   uninstalled within seven days.
SELECT
  COUNT(DISTINCT user_pseudo_id) AS sept_users_uninstalled_within_7d
FROM (
  SELECT
    user_pseudo_id,
    DATE_DIFF(
      DATE(TIMESTAMP_MICROS(event_timestamp)),
      DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)),
      DAY) AS d
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
    AND DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)) BETWEEN '2018-09-01' AND '2018-09-30'
    AND event_name = 'app_remove'
)
WHERE d BETWEEN 0 AND 7;
```

```sql
--Description: 8) Of those same users, how many generated at least one
--   “app_exception” event (crash) at any time during those seven days?
SELECT
  COUNT(DISTINCT a.user_pseudo_id) AS sept_users_uninstalled_with_crash
FROM (
  --users + uninstall ≤ 7 days
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
    AND DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)) BETWEEN '2018-09-01' AND '2018-09-30'
    AND event_name = 'app_remove'
    AND DATE_DIFF(
          DATE(TIMESTAMP_MICROS(event_timestamp)),
          DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)),
          DAY) BETWEEN 0 AND 7
) AS t
JOIN `firebase-public-project.analytics_153293282.events_*` AS a
  USING (user_pseudo_id)
WHERE a._TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
  AND a.event_name = 'app_exception';
```

```sql
--Description: 9) Put it together – total Sept-first-open uninstalls ≤ 7 days
--   vs. those that also crashed – to compute the percentage.
SELECT
  crash_cnt,
  uninstall_cnt,
  SAFE_DIVIDE(crash_cnt, uninstall_cnt) * 100 AS pct_with_crash
FROM (
  SELECT
    COUNT(DISTINCT CASE WHEN crashed THEN user_pseudo_id END) AS crash_cnt,
    COUNT(DISTINCT user_pseudo_id)                            AS uninstall_cnt
  FROM (
    SELECT
      user_pseudo_id,
      MAX( CASE WHEN event_name = 'app_exception' THEN 1 ELSE 0 END ) > 0 AS crashed
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
      AND DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)) BETWEEN '2018-09-01' AND '2018-09-30'
      AND (
            event_name = 'app_remove'
            OR event_name = 'app_exception'
          )
    GROUP BY user_pseudo_id
    HAVING
      -- keep only users who actually uninstalled ≤ 7 days
      MIN( CASE
             WHEN event_name = 'app_remove' THEN
               DATE_DIFF(
                 DATE(TIMESTAMP_MICROS(MIN(IF(event_name='app_remove',event_timestamp, NULL)) OVER())),
                 DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)),
                 DAY)
           END ) BETWEEN 0 AND 7
  )
);
```

