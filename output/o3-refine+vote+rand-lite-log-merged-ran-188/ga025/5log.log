Query:
--Description: 6) For those September-first-touch users, fetch their uninstall
--   records and work out how many days passed until the uninstall happened.
SELECT
  u.user_pseudo_id,
  DATE(TIMESTAMP_MICROS(u.user_first_touch_timestamp))          AS first_touch_date,
  DATE(TIMESTAMP_MICROS(e.event_timestamp))                     AS uninstall_date,
  DATE_DIFF(
    DATE(TIMESTAMP_MICROS(e.event_timestamp)),
    DATE(TIMESTAMP_MICROS(u.user_first_touch_timestamp)),
    DAY)                                                        AS days_to_uninstall
FROM  `firebase-public-project.analytics_153293282.events_*` AS e
JOIN  `firebase-public-project.analytics_153293282.events_*` AS u
  USING (user_pseudo_id)
WHERE e._TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
  AND u._TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
  AND DATE(TIMESTAMP_MICROS(u.user_first_touch_timestamp)) BETWEEN '2018-09-01' AND '2018-09-30'
  AND e.event_name = 'app_remove'
LIMIT 20;
