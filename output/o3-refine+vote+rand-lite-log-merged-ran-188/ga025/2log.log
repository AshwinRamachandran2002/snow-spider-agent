```sql
--Description: Compare first_open and subsequent app_remove (uninstall) dates for a sample
--             user who opened in September 2018.
WITH first_open AS (
  SELECT `user_pseudo_id`,
         PARSE_DATE('%Y%m%d', `event_date`) AS fo_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'first_open'
  LIMIT 20
)
SELECT f.`user_pseudo_id`,
       f.fo_date,
       PARSE_DATE('%Y%m%d', e.`event_date`) AS uninstall_date,
       DATE_DIFF(PARSE_DATE('%Y%m%d', e.`event_date`), f.fo_date, DAY) AS days_to_uninstall
FROM first_open f
JOIN `firebase-public-project.analytics_153293282.events_201809*` e
  ON e.`user_pseudo_id` = f.`user_pseudo_id`
WHERE e.`event_name` = 'app_remove'
LIMIT 20;
```

```sql
--Description: List users whose first_open was in September 2018 and who uninstalled within
--             7 days of that first_open.
WITH first_open AS (
  SELECT `user_pseudo_id`,
         MIN(PARSE_DATE('%Y%m%d', `event_date`)) AS fo_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
),
uninstall AS (
  SELECT `user_pseudo_id`,
         MIN(PARSE_DATE('%Y%m%d', `event_date`)) AS uninstall_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'app_remove'
  GROUP BY `user_pseudo_id`
)
SELECT u.`user_pseudo_id`,
       f.fo_date,
       u.uninstall_date,
       DATE_DIFF(u.uninstall_date, f.fo_date, DAY) AS days_to_uninstall
FROM uninstall u
JOIN first_open f
  ON u.`user_pseudo_id` = f.`user_pseudo_id`
WHERE DATE_DIFF(u.uninstall_date, f.fo_date, DAY) BETWEEN 0 AND 7
LIMIT 20;
```

```sql
--Description: For the above qualifying users, get any app_exception occurring within the
--             7-day window after first_open.
WITH first_open AS (
  SELECT `user_pseudo_id`,
         MIN(PARSE_DATE('%Y%m%d', `event_date`)) AS fo_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
),
uninstall AS (
  SELECT `user_pseudo_id`,
         MIN(PARSE_DATE('%Y%m%d', `event_date`)) AS uninstall_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'app_remove'
  GROUP BY `user_pseudo_id`
),
qualified AS (
  SELECT u.`user_pseudo_id`,
         f.fo_date
  FROM uninstall u
  JOIN first_open f
    ON u.`user_pseudo_id` = f.`user_pseudo_id`
  WHERE DATE_DIFF(u.uninstall_date, f.fo_date, DAY) BETWEEN 0 AND 7
)
SELECT q.`user_pseudo_id`,
       PARSE_DATE('%Y%m%d', e.`event_date`) AS crash_date
FROM qualified q
JOIN `firebase-public-project.analytics_153293282.events_201809*` e
  ON e.`user_pseudo_id` = q.`user_pseudo_id`
WHERE e.`event_name` = 'app_exception'
  AND PARSE_DATE('%Y%m%d', e.`event_date`) BETWEEN q.fo_date
                                               AND q.fo_date + 7
LIMIT 20;
```

```sql
--Description: Count total qualified users (uninstalled within 7 days) and the subset that
--             had at least one crash in that window.
WITH first_open AS (
  SELECT `user_pseudo_id`,
         MIN(PARSE_DATE('%Y%m%d', `event_date`)) AS fo_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
),
uninstall AS (
  SELECT `user_pseudo_id`,
         MIN(PARSE_DATE('%Y%m%d', `event_date`)) AS uninstall_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'app_remove'
  GROUP BY `user_pseudo_id`
),
qualified AS (
  SELECT u.`user_pseudo_id`,
         f.fo_date
  FROM uninstall u
  JOIN first_open f
    ON u.`user_pseudo_id` = f.`user_pseudo_id`
  WHERE DATE_DIFF(u.uninstall_date, f.fo_date, DAY) BETWEEN 0 AND 7
),
crashed AS (
  SELECT DISTINCT q.`user_pseudo_id`
  FROM qualified q
  JOIN `firebase-public-project.analytics_153293282.events_201809*` e
    ON e.`user_pseudo_id` = q.`user_pseudo_id`
  WHERE e.`event_name` = 'app_exception'
    AND PARSE_DATE('%Y%m%d', e.`event_date`) BETWEEN q.fo_date
                                                 AND q.fo_date + 7
)
SELECT 
  (SELECT COUNT(*) FROM qualified) AS total_uninstall_7d,
  (SELECT COUNT(*) FROM crashed)  AS crashed_in_7d
LIMIT 20;
```

```sql
--Description: Calculate the percentage of users who uninstalled within 7 days and experienced
--             at least one crash in that 7-day window.
WITH first_open AS (
  SELECT `user_pseudo_id`,
         MIN(PARSE_DATE('%Y%m%d', `event_date`)) AS fo_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
),
uninstall AS (
  SELECT `user_pseudo_id`,
         MIN(PARSE_DATE('%Y%m%d', `event_date`)) AS uninstall_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'app_remove'
  GROUP BY `user_pseudo_id`
),
qualified AS (
  SELECT u.`user_pseudo_id`,
         f.fo_date
  FROM uninstall u
  JOIN first_open f
    ON u.`user_pseudo_id` = f.`user_pseudo_id`
  WHERE DATE_DIFF(u.uninstall_date, f.fo_date, DAY) BETWEEN 0 AND 7
),
crashed AS (
  SELECT DISTINCT q.`user_pseudo_id`
  FROM qualified q
  JOIN `firebase-public-project.analytics_153293282.events_201809*` e
    ON e.`user_pseudo_id` = q.`user_pseudo_id`
  WHERE e.`event_name` = 'app_exception'
    AND PARSE_DATE('%Y%m%d', e.`event_date`) BETWEEN q.fo_date
                                                 AND q.fo_date + 7
)
SELECT 
  COUNT(DISTINCT crashed.`user_pseudo_id`) * 100.0
  / COUNT(DISTINCT qualified.`user_pseudo_id`) AS pct_with_crash
FROM qualified
LEFT JOIN crashed
  ON qualified.`user_pseudo_id` = crashed.`user_pseudo_id`
LIMIT 20;
```

