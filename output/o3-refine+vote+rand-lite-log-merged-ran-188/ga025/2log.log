Query:
--Description: Compare first_open and subsequent app_remove (uninstall) dates for a sample
--             user who opened in September 2018.
WITH first_open AS (
  SELECT `user_pseudo_id`,
         PARSE_DATE('%Y%m%d', `event_date`) AS fo_date
  FROM `firebase-public-project.analytics_153293282.events_201809*`
  WHERE `event_name` = 'first_open'
  LIMIT 20
)
SELECT f.`user_pseudo_id`,
       f.fo_date,
       PARSE_DATE('%Y%m%d', e.`event_date`) AS uninstall_date,
       DATE_DIFF(PARSE_DATE('%Y%m%d', e.`event_date`), f.fo_date, DAY) AS days_to_uninstall
FROM first_open f
JOIN `firebase-public-project.analytics_153293282.events_201809*` e
  ON e.`user_pseudo_id` = f.`user_pseudo_id`
WHERE e.`event_name` = 'app_remove'
LIMIT 20;
