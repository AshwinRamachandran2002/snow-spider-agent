Query:
-- 10. Final construction: build one output row per (row_id, order) with the
--     pizza name, then the alphabetically-sorted final ingredient list,
--     doubling any topping that appears both in standard and as an extra
SELECT
    co.order_id          AS "order_id",
    co.customer_id       AS "customer_id",
    pn.pizza_name        AS "pizza_name",
    pr.rowid             AS "row_id",                -- rowid = unique row in recipes table
    pn.pizza_name || ': ' ||
    group_concat(
        CASE
            WHEN cnt > 1 THEN '2x' || topping_name
            ELSE topping_name
        END,
        ', '
        )                   AS "final_ingredients"
FROM pizza_customer_orders AS co
JOIN pizza_names           AS pn ON pn.pizza_id = co.pizza_id

/* standard toppings */
JOIN pizza_recipes         AS pr ON pr.pizza_id = co.pizza_id
JOIN pizza_toppings        AS std_tp
     ON ',' || pr.toppings || ',' LIKE '%,' || std_tp.topping_id || ',%'

/* extras / exclusions */
LEFT JOIN pizza_get_extras     AS ge  ON ge.order_id = co.order_id
LEFT JOIN pizza_get_exclusions AS gx  ON gx.order_id = co.order_id

/* build a single tally of each topping occurrence */
JOIN (
     SELECT topping_id,
            SUM(source_standard) + SUM(source_extra) AS cnt
     FROM (
          SELECT std_tp.topping_id, 1 AS source_standard, 0 AS source_extra
          FROM pizza_recipes AS pr
          JOIN pizza_customer_orders AS co2
            ON co2.pizza_id = pr.pizza_id
          JOIN pizza_toppings AS std_tp
            ON ',' || pr.toppings || ',' LIKE '%,' || std_tp.topping_id || ',%'
          UNION ALL
          SELECT ge.extras AS topping_id, 0, 1
          FROM pizza_get_extras AS ge
     )
     GROUP BY topping_id
) AS all_tp
   ON all_tp.topping_id = std_tp.topping_id

WHERE std_tp.topping_id NOT IN (SELECT exclusions FROM pizza_get_exclusions WHERE order_id = co.order_id)

GROUP BY pr.rowid, co.order_id, co.customer_id, pn.pizza_name
ORDER BY pr.rowid
LIMIT 20;
