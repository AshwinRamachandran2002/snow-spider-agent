```sql
--Description: Bring everything together for a single example order (id = 9) to understand all moving parts.
SELECT o.order_id,
       o.customer_id,
       pn.pizza_name,
       pr.toppings            AS recipe_toppings,
       ge.extras,             -- numeric topping id added
       ge.extras_count,       -- how many times added
       gx.exclusions,         -- numeric topping id removed
       gx.total_exclusions    -- how many removed
FROM   "pizza_customer_orders"      AS o
LEFT JOIN "pizza_names"             AS pn ON o.pizza_id = pn.pizza_id
LEFT JOIN "pizza_recipes"           AS pr ON o.pizza_id = pr.pizza_id
LEFT JOIN "pizza_get_extras"        AS ge ON o.order_id = ge.order_id
LEFT JOIN "pizza_get_exclusions"    AS gx ON o.order_id = gx.order_id
WHERE  o.order_id = 9
LIMIT 20;
```
