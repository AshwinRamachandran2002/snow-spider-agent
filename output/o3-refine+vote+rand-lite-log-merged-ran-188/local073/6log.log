```sql
--Description: Preview each order’s final ingredient list (handles exclusions & extras, uses correct json_each `value` field).
WITH std AS (   -- explode the standard recipe toppings per order
        SELECT  o.order_id,
                o.customer_id,
                pn.pizza_name,
                CAST(j.value AS INTEGER) AS topping_id,
                1 AS cnt                   -- each recipe topping counts once
        FROM    pizza_customer_orders o
        JOIN    pizza_names      pn ON pn.pizza_id = o.pizza_id
        JOIN    pizza_recipes    r  ON r.pizza_id  = o.pizza_id
        JOIN    json_each('[' || r.toppings || ']') AS j
),
excl AS (       -- toppings to exclude
        SELECT  order_id,
                exclusions AS topping_id
        FROM    pizza_get_exclusions
),
extras AS (     -- toppings to add (may appear multiple times)
        SELECT  order_id,
                extras AS topping_id,
                extras_count AS cnt
        FROM    pizza_get_extras
),
base AS (       -- recipe toppings after removing exclusions
        SELECT  s.order_id,
                s.customer_id,
                s.pizza_name,
                s.topping_id,
                s.cnt
        FROM    std s
        LEFT JOIN excl e
               ON e.order_id   = s.order_id
              AND e.topping_id = s.topping_id
        WHERE   e.topping_id IS NULL
),
all_toppings AS (   -- union recipe (post-exclusion) + extras
        SELECT order_id, customer_id, pizza_name, topping_id, cnt
        FROM   base
        UNION ALL
        SELECT order_id, NULL, NULL, topping_id, cnt   -- customer/pizza not needed for extras
        FROM   extras
),
tot AS (        -- total count per topping per order
        SELECT  order_id,
                topping_id,
                SUM(cnt) AS total_cnt
        FROM    all_toppings
        GROUP BY order_id, topping_id
),
named AS (      -- attach topping names and prefix “2x ” where needed
        SELECT  t.order_id,
                CASE WHEN t.total_cnt > 1
                     THEN '2x ' || p.topping_name
                     ELSE        p.topping_name
                END AS topping_str
        FROM    tot t
        JOIN    pizza_toppings p ON p.topping_id = t.topping_id
),
alphabet AS (   -- alphabetically order toppings then concatenate
        SELECT  order_id,
                GROUP_CONCAT(topping_str, ', ') AS toppings_list
        FROM   (SELECT order_id, topping_str
                FROM   named
                ORDER  BY topping_str)
        GROUP BY order_id
)
SELECT  o.order_id,
        o.customer_id,
        pn.pizza_name,
        pn.pizza_name || ': ' || a.toppings_list AS final_ingredients
FROM    pizza_customer_orders o
JOIN    pizza_names pn ON pn.pizza_id = o.pizza_id
JOIN    alphabet      a ON a.order_id = o.order_id
GROUP BY o.order_id, o.customer_id, pn.pizza_name
ORDER BY o.order_id
LIMIT 20;
```
