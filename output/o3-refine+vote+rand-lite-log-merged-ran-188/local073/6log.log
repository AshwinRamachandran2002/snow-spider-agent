```sql
--Description: End-to-end construction of the requested output.
--  ▸ orders        : capture every pizza-row (using SQLite implicit rowid).
--  ▸ recipe        : explode each pizza’s standard topping list via json_each.
--  ▸ exclusions    : toppings the customer removed.
--  ▸ extras        : toppings the customer added (with extras_count).
--  ▸ base          : recipe toppings after removing exclusions.
--  ▸ added         : rows representing the extras (duplicates kept through cnt).
--  ▸ total         : sum recipe + extras counts, giving how many times each topping appears.
--  ▸ name_cnt      : attach topping names; prefix with ‘2x ’ when a topping is present ≥2 times.
--  ▸ ordered       : alphabetically sort those names and GROUP_CONCAT into one comma-separated string.
--  ▸ final SELECT  : deliver row_id, order_id, customer_id, pizza_name, and
--                    “pizza_name: toppings …”  one line per order-row, ordered by row_id.
WITH orders AS (
    SELECT rowid AS row_id,
           order_id,
           customer_id,
           pizza_id,
           order_time
    FROM   pizza_customer_orders
),
recipe AS (
    SELECT  o.row_id,
            o.order_id,
            CAST(j.value AS INTEGER) AS topping_id      -- json_each yields “value”
    FROM    orders o
    JOIN    pizza_recipes r  ON r.pizza_id = o.pizza_id
    JOIN    json_each('[' || r.toppings || ']') j
),
exclusions AS (
    SELECT  order_id,
            exclusions AS topping_id
    FROM    pizza_get_exclusions
),
extras AS (
    SELECT  order_id,
            extras AS topping_id,
            extras_count
    FROM    pizza_get_extras
),
base AS (                                            -- recipe MINUS exclusions
    SELECT  r.row_id,
            r.order_id,
            r.topping_id,
            1 AS cnt
    FROM    recipe r
    LEFT JOIN exclusions e
           ON e.order_id   = r.order_id
          AND e.topping_id = r.topping_id
    WHERE   e.topping_id IS NULL
),
added AS (                                           -- rows for extras
    SELECT  o.row_id,
            e.order_id,
            e.topping_id,
            e.extras_count AS cnt
    FROM    extras e
    JOIN    orders o ON o.order_id = e.order_id
),
total AS (                                           -- total occurrences per topping
    SELECT  row_id,
            order_id,
            topping_id,
            SUM(cnt) AS total_cnt
    FROM   (
            SELECT * FROM base
            UNION ALL
            SELECT * FROM added
           )
    GROUP BY row_id, order_id, topping_id
),
name_cnt AS (                                        -- translate IDs to names, add “2x ” prefix
    SELECT  t.row_id,
            t.order_id,
            CASE WHEN t.total_cnt > 1
                 THEN '2x ' || p.topping_name
                 ELSE        p.topping_name
            END AS topping_str
    FROM    total t
    JOIN    pizza_toppings p ON p.topping_id = t.topping_id
),
ordered AS (                                         -- alphabetically order then concatenate
    SELECT  row_id,
            order_id,
            GROUP_CONCAT(topping_str, ', ') AS toppings_list
    FROM   (
            SELECT row_id,
                   order_id,
                   topping_str
            FROM   name_cnt
            ORDER  BY topping_str
           )
    GROUP BY row_id, order_id
)
SELECT  o.row_id,
        o.order_id,
        o.customer_id,
        pn.pizza_name,
        pn.pizza_name || ': ' || ordered.toppings_list AS final_ingredients
FROM    orders      o
JOIN    pizza_names pn     ON pn.pizza_id = o.pizza_id   -- 1 = Meatlovers, 2 = Vegetarian
JOIN    ordered     ON ordered.row_id = o.row_id
ORDER BY o.row_id;
```
