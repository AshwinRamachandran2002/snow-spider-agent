-- Description: 9) Preview a merged view: recipe + customer extras + exclusions (one row per topping per order)
SELECT c."order_id",
       c."customer_id",
       pn."pizza_name",
       tr."topping_id"         AS "recipe_topping_id",
       te."extras"             AS "extra_topping_id",
       ex."exclusions"         AS "exclusion_topping_id"
FROM   "pizza_customer_orders" AS c
JOIN   "pizza_names"           AS pn ON pn."pizza_id" = c."pizza_id"
LEFT JOIN "pizza_recipes"      AS r  ON r."pizza_id"  = c."pizza_id"
LEFT JOIN json_each('[' || r."toppings" || ']') AS tr ON TRUE              -- split recipe string
LEFT JOIN "pizza_get_extras"   AS te ON te."order_id" = c."order_id"
LEFT JOIN "pizza_get_exclusions" AS ex ON ex."order_id" = c."order_id"
ORDER BY c."order_id"
LIMIT 20;
```

```sql
-- Description: 10) Construct the final, alphabetically-sorted ingredient list for each order (target format preview)
SELECT  c."order_id",
        c."customer_id",
        pn."pizza_name",
        GROUP_CONCAT(
              CASE WHEN cnt > 1 THEN '2x ' || name ELSE name END,
              ', '
        )  AS "final_ingredients"
FROM   (
        -- explode standard recipe into rows
        SELECT  o."order_id",
                o."customer_id",
                o."pizza_id",
                CAST(value AS INTEGER) AS topping_id
        FROM    "pizza_customer_orders" AS o
        JOIN    "pizza_recipes"         AS r ON r."pizza_id" = o."pizza_id",
                json_each('[' || r."toppings" || ']')
       ) AS std
LEFT JOIN "pizza_get_exclusions"  AS ex ON ex."order_id" = std."order_id"
LEFT JOIN "pizza_get_extras"      AS ad ON ad."order_id" = std."order_id"
LEFT JOIN "pizza_toppings"        AS tp ON tp."topping_id" = std."topping_id"
-- aggregate counts considering exclusions & extras
JOIN  (
        SELECT topping_id, "topping_name" AS name
        FROM   "pizza_toppings"
      ) AS tname ON tname.topping_id = std.topping_id
LEFT JOIN (
        -- count repeats coming from extras
        SELECT "order_id", "extras" AS topping_id, SUM("extras_count") AS repeat_n
        FROM   "pizza_get_extras"
        GROUP  BY "order_id", "extras"
      ) AS rep ON rep."order_id" = std."order_id"
GROUP BY c."order_id", c."customer_id", pn."pizza_name"
ORDER BY c."order_id"
LIMIT 20;
```
