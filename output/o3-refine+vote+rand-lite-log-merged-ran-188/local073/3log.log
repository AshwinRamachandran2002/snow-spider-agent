```sql
WITH orders AS (         -- every row in the customer order table
        SELECT
               rowid                                     AS row_id,
               c.order_id,
               c.customer_id,
               CASE WHEN pn.pizza_name = 'Meatlovers'
                    THEN 1 ELSE 2 END                   AS pizza_id,   -- force id mapping
               pn.pizza_name,
               c.order_time
        FROM   pizza_customer_orders   AS c
        JOIN   pizza_names             AS pn
               ON pn.pizza_id = c.pizza_id
), --------------------------------------------------------------------
--              1. split every pizza’s standard recipe
RECURSIVE std_split(row_id, order_id, topping_id, rest) AS (
        SELECT  o.row_id,
                o.order_id,
                CAST(TRIM(SUBSTR(pr.toppings,
                                 1,
                                 INSTR(pr.toppings||',',',')-1)) AS INTEGER)     AS topping_id,
                SUBSTR(pr.toppings||',',
                       INSTR(pr.toppings||',',',')+1)                           AS rest
        FROM   orders         AS o
        JOIN   pizza_recipes  AS pr  ON pr.pizza_id = o.pizza_id

        UNION ALL
        SELECT  row_id,
                order_id,
                CAST(TRIM(SUBSTR(rest,
                                 1,
                                 INSTR(rest,',')-1)) AS INTEGER),
                SUBSTR(rest,
                       INSTR(rest,',')+1)
        FROM    std_split
        WHERE   rest LIKE '%,%'

        UNION ALL
        SELECT  row_id,
                order_id,
                CAST(TRIM(rest) AS INTEGER),
                ''
        FROM    std_split
        WHERE   rest NOT LIKE '%,%' AND rest <> ''
), --------------------------------------------------------------------
--              2. exclusions (remove entirely)
excl AS (
        SELECT  order_id,
                CAST(exclusions AS INTEGER) AS topping_id
        FROM    pizza_get_exclusions
        GROUP BY order_id, exclusions
), --------------------------------------------------------------------
std_no_excl AS (        -- standard toppings after exclusions
        SELECT  ss.row_id,
                ss.order_id,
                ss.topping_id,
                1 AS cnt
        FROM    std_split AS ss
        LEFT JOIN excl
               ON  excl.order_id  = ss.order_id
               AND excl.topping_id= ss.topping_id
        WHERE   excl.topping_id IS NULL
), --------------------------------------------------------------------
--              3. extras (may be repeated, keep counts)
extras_cnt AS (
        SELECT  order_id,
                CAST(extras AS INTEGER) AS topping_id,
                SUM(extras_count)        AS cnt
        FROM    pizza_get_extras
        GROUP BY order_id, extras
),
extras_rows AS (
        SELECT  o.row_id,
                ec.order_id,
                ec.topping_id,
                ec.cnt
        FROM    orders AS o
        JOIN    extras_cnt  ec
               ON ec.order_id = o.order_id
), --------------------------------------------------------------------
--              4. combine std+extras and total the counts
combined AS (
        SELECT * FROM std_no_excl
        UNION ALL
        SELECT * FROM extras_rows
),
final_counts AS (
        SELECT  row_id,
                topping_id,
                SUM(cnt) AS cnt
        FROM    combined
        GROUP BY row_id, topping_id
), --------------------------------------------------------------------
--              5. make human-readable topping strings
topping_strings AS (
        SELECT  fc.row_id,
                pt.topping_name,
                CASE WHEN fc.cnt > 1
                     THEN '2x ' || pt.topping_name
                     ELSE        pt.topping_name
                END AS topping_string
        FROM    final_counts  fc
        JOIN    pizza_toppings pt USING (topping_id)
), --------------------------------------------------------------------
--              6. assemble comma-separated, alphabetically-sorted list
ingredients AS (
        SELECT  row_id,
                GROUP_CONCAT(topping_string, ', ') AS ingredient_list
        FROM    (
                SELECT  row_id,
                        topping_name,
                        topping_string
                FROM    topping_strings
                ORDER BY row_id, topping_name           -- alphabetical
        )
        GROUP BY row_id
) --------------------------------------------------------------------
SELECT  o.row_id,
        o.order_id,
        o.customer_id,
        o.pizza_name,
        o.pizza_name || ': ' || ingredient_list  AS final_ingredients
FROM    orders      AS o
JOIN    ingredients AS i  USING (row_id)
ORDER BY o.row_id;
```
