--Description: Build the definitive ingredient list for every pizza order, following the
--              rules “recipe – exclusions + extras”, while keeping duplicates (2x, 3x …),
--              sorting ingredients alphabetically, and producing one final row per order.
--              CTE pipeline:
--              1. base      – explode each recipe string into (order_id, topping_id) rows
--              2. std_cnts  – count each standard topping per order
--              3. extra_cnts/excl_cnts – total extras (+) and exclusions (–)
--              4. all_cnts  – net quantity = std + extras – exclusions   (retain >0)
--              5. named     – translate topping_id → topping_name, add “2x ” if qty>1
--              6. ingr_list – alphabetically concatenate ingredients for every order
--              The final SELECT returns: surrogate row_id (extras.row_id → exclusions.row_id
--              → fallback order_id), order_id, customer_id, pizza_name, and
--              “pizza_name: ingredient list”.  Alias row_id_final prevents ambiguity,
--              and ORDER BY 1 guarantees ascending order by that surrogate id.
WITH RECURSIVE base(order_id, topping_id, rest) AS (
        /* first slice of each recipe string */
        SELECT pco.order_id,
               CAST(TRIM(SUBSTR(pr.toppings, 1, INSTR(pr.toppings, ',')-1)) AS INTEGER),
               SUBSTR(pr.toppings, INSTR(pr.toppings, ',')+1)
        FROM   pizza_customer_orders AS pco
        JOIN   pizza_recipes         AS pr ON pr.pizza_id = pco.pizza_id
        UNION ALL
        /* keep slicing while we still have commas */
        SELECT order_id,
               CAST(TRIM(SUBSTR(rest, 1, INSTR(rest, ',')-1)) AS INTEGER),
               SUBSTR(rest, INSTR(rest, ',')+1)
        FROM   base
        WHERE  rest LIKE '%,%'
        UNION ALL
        /* final fragment (no comma left) */
        SELECT order_id,
               CAST(TRIM(rest) AS INTEGER),
               ''
        FROM   base
        WHERE  rest NOT LIKE '%,%' AND rest <> ''
),
std_cnts AS (
    SELECT order_id, topping_id, COUNT(*) AS cnt
    FROM   base
    GROUP BY order_id, topping_id
),
extra_cnts AS (
    SELECT order_id, extras AS topping_id, SUM(extras_count) AS cnt
    FROM   pizza_get_extras
    GROUP BY order_id, extras
),
excl_cnts AS (
    SELECT order_id, exclusions AS topping_id, SUM(total_exclusions) AS cnt
    FROM   pizza_get_exclusions
    GROUP BY order_id, exclusions
),
all_cnts AS (      /* net quantity: std + extras – exclusions */
    SELECT order_id, topping_id, SUM(cnt) AS final_cnt
    FROM (
        SELECT * FROM std_cnts
        UNION ALL
        SELECT * FROM extra_cnts
        UNION ALL
        SELECT order_id, topping_id, -cnt FROM excl_cnts
    )
    GROUP BY order_id, topping_id
    HAVING SUM(cnt) > 0
),
named AS (         /* add ingredient names & quantity prefixes */
    SELECT ac.order_id,
           CASE WHEN ac.final_cnt > 1
                THEN ac.final_cnt || 'x ' || pt.topping_name
                ELSE pt.topping_name
           END AS ingredient
    FROM   all_cnts ac
    JOIN   pizza_toppings pt ON pt.topping_id = ac.topping_id
),
ingr_list AS (     /* alphabetical ingredient list for each order */
    SELECT order_id,
           GROUP_CONCAT(ingredient, ', ') AS ingredients
    FROM  (SELECT order_id, ingredient
           FROM   named
           ORDER  BY ingredient)
    GROUP BY order_id
)
SELECT
       COALESCE(pe.row_id, px.row_id, pco.order_id) AS row_id_final,
       pco.order_id,
       pco.customer_id,
       pn.pizza_name,
       pn.pizza_name || ': ' || il.ingredients       AS final_ingredients
FROM   pizza_customer_orders  AS pco
JOIN   pizza_names            AS pn  ON pn.pizza_id = pco.pizza_id
JOIN   ingr_list              AS il  ON il.order_id = pco.order_id
LEFT   JOIN pizza_get_extras        pe ON pe.order_id = pco.order_id
LEFT   JOIN pizza_get_exclusions    px ON px.order_id = pco.order_id
GROUP  BY 1, 2, 3, 4, 5
ORDER  BY 1;
