-- 9.  Expand every order’s standard recipe so we have one row per (order, topping_id)
WITH RECURSIVE split(order_id, topping_id, rest) AS (
    SELECT pco.order_id,
           TRIM(SUBSTR(pr.toppings, 1, INSTR(pr.toppings, ',')-1)) AS topping_id,
           SUBSTR(pr.toppings, INSTR(pr.toppings, ',')+1)          AS rest
    FROM   pizza_customer_orders AS pco
    JOIN   pizza_recipes         AS pr  ON pr.pizza_id = pco.pizza_id

    UNION ALL
    SELECT order_id,
           TRIM(SUBSTR(rest, 1, INSTR(rest, ',')-1)),
           SUBSTR(rest, INSTR(rest, ',')+1)
    FROM   split
    WHERE  rest LIKE '%,%'

    UNION ALL
    SELECT order_id,
           TRIM(rest),
           ''
    FROM   split
    WHERE  rest NOT LIKE '%,%' AND rest <> ''
)
SELECT order_id,
       CAST(topping_id AS INTEGER) AS topping_id,   -- numeric id
       COUNT(*)  AS std_cnt        -- always 1, but keep as COUNT for clarity
FROM   split
GROUP BY order_id, topping_id
LIMIT 20;
