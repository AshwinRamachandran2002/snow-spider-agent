-- 9.  Expand every order’s standard recipe so we have one row per (order, topping_id)
WITH RECURSIVE split(order_id, topping_id, rest) AS (
    SELECT pco.order_id,
           TRIM(SUBSTR(pr.toppings, 1, INSTR(pr.toppings, ',')-1)) AS topping_id,
           SUBSTR(pr.toppings, INSTR(pr.toppings, ',')+1)          AS rest
    FROM   pizza_customer_orders AS pco
    JOIN   pizza_recipes         AS pr  ON pr.pizza_id = pco.pizza_id

    UNION ALL
    SELECT order_id,
           TRIM(SUBSTR(rest, 1, INSTR(rest, ',')-1)),
           SUBSTR(rest, INSTR(rest, ',')+1)
    FROM   split
    WHERE  rest LIKE '%,%'

    UNION ALL
    SELECT order_id,
           TRIM(rest),
           ''
    FROM   split
    WHERE  rest NOT LIKE '%,%' AND rest <> ''
)
SELECT order_id,
       CAST(topping_id AS INTEGER) AS topping_id,   -- numeric id
       COUNT(*)  AS std_cnt        -- always 1, but keep as COUNT for clarity
FROM   split
GROUP BY order_id, topping_id
LIMIT 20;
```

```sql
-- 10.  FINAL ANSWER — one row per pizza order with the requested output
WITH
-- A)  Normalise every order’s standard toppings (one row per topping)
RECURSIVE base(order_id, topping_id, rest) AS (
    SELECT pco.order_id,
           CAST(TRIM(SUBSTR(pr.toppings, 1, INSTR(pr.toppings, ',')-1)) AS INTEGER),
           SUBSTR(pr.toppings, INSTR(pr.toppings, ',')+1)
    FROM   pizza_customer_orders AS pco
    JOIN   pizza_recipes         AS pr ON pr.pizza_id = pco.pizza_id
    UNION ALL
    SELECT order_id,
           CAST(TRIM(SUBSTR(rest, 1, INSTR(rest, ',')-1)) AS INTEGER),
           SUBSTR(rest, INSTR(rest, ',')+1)
    FROM   base
    WHERE  rest LIKE '%,%'
    UNION ALL
    SELECT order_id,
           CAST(TRIM(rest) AS INTEGER),
           ''
    FROM   base
    WHERE  rest NOT LIKE '%,%' AND rest <> ''
),
std_cnts AS (                         -- one row = one standard topping
    SELECT order_id,
           topping_id,
           COUNT(*) AS cnt            -- =1 for each standard topping
    FROM   base
    GROUP BY order_id, topping_id
),
extra_cnts AS (                       -- extras supplied by the diner
    SELECT order_id,
           extras AS topping_id,
           SUM(extras_count) AS cnt
    FROM   pizza_get_extras
    GROUP BY order_id, extras
),
excl_cnts  AS (                       -- exclusions requested by the diner
    SELECT order_id,
           exclusions AS topping_id,
           SUM(total_exclusions) AS cnt
    FROM   pizza_get_exclusions
    GROUP BY order_id, exclusions
),
-- B)  Sum (+) standard, (+) extras, (–) exclusions  ➔ final net count
all_cnts AS (
    SELECT order_id, topping_id, SUM(cnt) AS final_cnt
    FROM (
          SELECT *               FROM std_cnts
          UNION ALL
          SELECT *               FROM extra_cnts
          UNION ALL
          SELECT order_id,
                 topping_id,
                -cnt             -- subtract exclusions
          FROM   excl_cnts
    )
    GROUP BY order_id, topping_id
    HAVING SUM(cnt) > 0          -- keep toppings that are present in the end
),
-- C) Turn topping_id into topping_name; prefix with “2x ” if repeated
named AS (
    SELECT ac.order_id,
           CASE
               WHEN ac.final_cnt > 1
                    THEN ac.final_cnt || 'x ' || pt.topping_name
               ELSE pt.topping_name
           END AS ingredient
    FROM   all_cnts       AS ac
    JOIN   pizza_toppings AS pt ON pt.topping_id = ac.topping_id
),
-- D)  Ingredient list per order, alphabetically sorted
ingr_list AS (
    SELECT  order_id,
            GROUP_CONCAT(ingredient, ', ') AS ingredients
    FROM   ( SELECT *
             FROM   named
             ORDER  BY order_id,
                     ingredient            -- alphabetic inside each order
           )
    GROUP BY order_id
)
-- E)  Final output
SELECT
       COALESCE(pe.row_id, px.row_id, pco.order_id)         AS row_id,  -- if no row_id in helper tables fall back to order_id
       pco.order_id,
       pco.customer_id,
       pn.pizza_name,
       pn.pizza_name || ': ' || il.ingredients              AS final_ingredients
FROM   pizza_customer_orders            AS pco
JOIN   pizza_names                      AS pn  ON pn.pizza_id  = pco.pizza_id
JOIN   ingr_list                        AS il  ON il.order_id  = pco.order_id
LEFT   JOIN pizza_get_extras            AS pe  ON pe.order_id  = pco.order_id
LEFT   JOIN pizza_get_exclusions        AS px  ON px.order_id  = pco.order_id
GROUP  BY row_id, pco.order_id, pco.customer_id, pn.pizza_name, final_ingredients
ORDER BY row_id;
```
