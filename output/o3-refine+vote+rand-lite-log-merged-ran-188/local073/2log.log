```sql
--Description: For one sample order, explode (split) recipe, exclusions, and extras into individual
--             topping_id rows so we can eyeball what will be kept / removed / added.
WITH sample AS (
     SELECT rowid AS row_id, * 
     FROM   pizza_clean_customer_orders
     LIMIT  1                                   -- pick a single order for the demo
),
recipe AS (
     SELECT s.row_id,
            trim(json_each.value) AS topping_id
     FROM   sample AS s,
            json_each('[' || s.pizza_id || ']')   -- dummy split (recipe will be refined later)
)
SELECT *
FROM   recipe
LIMIT  20;
```

```sql
--Description: FINAL RESULT – build the requested “final ingredients” string for every order.
WITH orders AS (          -- 1) base orders (one row per pizza order)
     SELECT rowid AS row_id,
            order_id,
            customer_id,
            CASE WHEN pizza_id = 1 THEN 1 ELSE 2 END AS pizza_id,   -- force Meatlovers = 1
            exclusions,
            extras
     FROM   pizza_customer_orders
),
recipe AS (               -- 2) explode each pizza’s default toppings
     SELECT pr.pizza_id,
            trim(j.value) AS topping_id
     FROM   pizza_recipes AS pr,
            json_each('[' || pr.toppings || ']') AS j
),
excl AS (                 -- 3) explode per-order exclusions
     SELECT o.row_id,
            trim(j.value) AS topping_id
     FROM   orders AS o,
            json_each('[' || IFNULL(o.exclusions,'') || ']') AS j
     WHERE  o.exclusions IS NOT NULL AND o.exclusions <> ''
),
ext AS (                  -- 4) explode per-order extras
     SELECT o.row_id,
            trim(j.value) AS topping_id
     FROM   orders AS o,
            json_each('[' || IFNULL(o.extras,'') || ']') AS j
     WHERE  o.extras IS NOT NULL AND o.extras <> ''
),
base AS (                 -- 5) recipe minus exclusions
     SELECT o.row_id,
            r.topping_id
     FROM   orders AS o
     JOIN   recipe AS r USING (pizza_id)
     WHERE  r.topping_id NOT IN (
              SELECT topping_id
              FROM   excl
              WHERE  row_id = o.row_id
            )
),
combined AS (             -- 6) add extras (duplicates possible)
     SELECT row_id, topping_id              FROM base
     UNION ALL
     SELECT row_id, topping_id              FROM ext
),
counted AS (              -- 7) count how many times each topping now appears
     SELECT row_id,
            topping_id,
            COUNT(*) AS cnt
     FROM   combined
     GROUP  BY row_id, topping_id
),
alphabet AS (             -- 8) turn ids → names & build the display string pieces
     SELECT c.row_id,
            CASE WHEN c.cnt > 1
                 THEN '2x ' || pt.topping_name
                 ELSE        pt.topping_name
            END AS ingredient
     FROM   counted        AS c
     JOIN   pizza_toppings AS pt ON pt.topping_id = c.topping_id
),
list AS (                 -- 9) concatenate alphabetically for each order
     SELECT row_id,
            GROUP_CONCAT(ingredient, ', ') AS ingredient_list
     FROM   alphabet
     GROUP  BY row_id
),
final AS (                -- 10) assemble final presentation
     SELECT o.row_id,
            o.order_id,
            o.customer_id,
            pn.pizza_name,
            pn.pizza_name || ': ' || l.ingredient_list AS final_ingredients
     FROM   orders      AS o
     JOIN   pizza_names AS pn USING (pizza_id)
     JOIN   list        AS l  USING (row_id)
)
SELECT row_id,
       order_id,
       customer_id,
       pizza_name,
       final_ingredients
FROM   final
ORDER  BY row_id
LIMIT  20;
```
