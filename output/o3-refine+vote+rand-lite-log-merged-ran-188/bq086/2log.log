```sql
--Description: 1) Peek at national-level COVID-19 data on 30-Jun-2020  
SELECT
  iso_3166_1_alpha_3 AS country_code,
  country_name,
  cumulative_confirmed,
  cumulative_deceased
FROM `bigquery-public-data.covid19_open_data.covid19_open_data`
WHERE aggregation_level = 0                -- country level
  AND date = '2020-06-30'
LIMIT 20;
```

```sql
--Description: 2) What values does the aggregation_level column take?  
SELECT DISTINCT aggregation_level
FROM `bigquery-public-data.covid19_open_data.covid19_open_data`
LIMIT 20;
```

```sql
--Description: 3) Sample of World-Bank 2018 population figures  
SELECT
  country_code,            -- ISO-3
  country       AS country_name,
  year_2018
FROM `bigquery-public-data.world_bank_global_population.population_by_country`
WHERE year_2018 IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4) Join test – make sure ISO-3 codes match across both datasets  
SELECT
  c.iso_3166_1_alpha_3 AS country_code,
  c.country_name       AS covid_country,
  p.country            AS wb_country,
  p.year_2018          AS population_2018
FROM `bigquery-public-data.covid19_open_data.covid19_open_data` AS c
JOIN `bigquery-public-data.world_bank_global_population.population_by_country` AS p
  ON c.iso_3166_1_alpha_3 = p.country_code
WHERE c.aggregation_level = 0
  AND c.date = '2020-06-30'
LIMIT 20;
```

```sql
--Description: 5) Compute % of population confirmed for a handful of countries  
SELECT
  c.iso_3166_1_alpha_3                           AS country_code,
  c.country_name,
  c.cumulative_confirmed,
  p.year_2018                                    AS population_2018,
  SAFE_DIVIDE(c.cumulative_confirmed, p.year_2018)*100  AS percent_population_confirmed
FROM `bigquery-public-data.covid19_open_data.covid19_open_data` AS c
JOIN `bigquery-public-data.world_bank_global_population.population_by_country` AS p
  ON c.iso_3166_1_alpha_3 = p.country_code
WHERE c.aggregation_level = 0
  AND c.date = '2020-06-30'
LIMIT 20;
```

```sql
--Description: 6) Identify countries lacking 2018 population figures (if any)  
SELECT
  c.iso_3166_1_alpha_3 AS country_code,
  c.country_name,
  p.year_2018
FROM `bigquery-public-data.covid19_open_data.covid19_open_data` AS c
LEFT JOIN `bigquery-public-data.world_bank_global_population.population_by_country` AS p
  ON c.iso_3166_1_alpha_3 = p.country_code
WHERE c.aggregation_level = 0
  AND c.date = '2020-06-30'
  AND (p.year_2018 IS NULL OR p.year_2018 = 0)
LIMIT 20;
```

```sql
--Description: 7) Final answer – % of each country’s population confirmed with COVID-19  
SELECT
  c.iso_3166_1_alpha_3                                      AS country_code,
  c.country_name,
  c.cumulative_confirmed,
  p.year_2018                                               AS population_2018,
  ROUND(SAFE_DIVIDE(c.cumulative_confirmed, p.year_2018)*100, 4)
     AS percent_population_confirmed_2020_06_30
FROM `bigquery-public-data.covid19_open_data.covid19_open_data` AS c
JOIN `bigquery-public-data.world_bank_global_population.population_by_country` AS p
  ON c.iso_3166_1_alpha_3 = p.country_code
WHERE c.aggregation_level = 0
  AND c.date = '2020-06-30'
  AND p.year_2018 IS NOT NULL
ORDER BY percent_population_confirmed_2020_06_30 DESC
LIMIT 20;
```
