```sql
--Description: View sample US B2 publications with grant dates in June-August 2022
SELECT  t."publication_number",
        t."grant_date",
        t."country_code",
        t."kind_code",
        t."application_kind",
        t."ipc"
FROM    PATENTS.PATENTS.PUBLICATIONS t
WHERE   t."country_code" = 'US'
  AND   t."kind_code"   = 'B2'
  AND   t."grant_date" BETWEEN 20220601 AND 20220831
LIMIT 20;
```

```sql
--Description: Inspect IPC codes (one row per code) for those US B2 patents
SELECT  t."publication_number",
        f.value:"code"::STRING AS "ipc_code"
FROM    PATENTS.PATENTS.PUBLICATIONS t,
        LATERAL FLATTEN(input => t."ipc") f
WHERE   t."country_code" = 'US'
  AND   t."kind_code"   = 'B2'
  AND   t."grant_date" BETWEEN 20220601 AND 20220831
LIMIT 20;
```

```sql
