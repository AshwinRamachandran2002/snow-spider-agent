-- 7. Allocate population & income from tracts to ZIPs using that area-based weight (sample)  
WITH z AS (
  SELECT zip_code, zip_code_geom
  FROM   `bigquery-public-data.geo_us_boundaries.zip_codes`
  WHERE  ST_DWITHIN( ST_GEOGPOINT(-122.191667, 47.685833),
                     ST_GEOGPOINT(internal_point_lon, internal_point_lat), 8046.72 )
),
tracts AS (
  SELECT a.geo_id,
         a.total_pop,
         a.income_per_capita,
         g.tract_geom
  FROM   `bigquery-public-data.census_bureau_acs.censustract_2017_5yr` a
  JOIN   `bigquery-public-data.geo_census_tracts.census_tracts_washington` g
  USING  (geo_id)
)
SELECT  z.zip_code,
        t.geo_id                    AS tract_id,
        SAFE_DIVIDE(
             ST_AREA( ST_INTERSECTION(z.zip_code_geom, t.tract_geom) ),
             ST_AREA( t.tract_geom) )                AS weight,
        t.total_pop,
        t.income_per_capita
FROM    z
JOIN    tracts t
ON      ST_INTERSECTS(z.zip_code_geom, t.tract_geom)
LIMIT   20;
