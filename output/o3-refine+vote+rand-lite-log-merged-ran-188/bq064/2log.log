```sql
-- 4. Zip codes whose internal point sits within 5-miles of the target coordinate  
--    (47.685833 N , -122.191667 W)  – ≈ 8046.72 metres  
SELECT zip_code,
       state_name,
       ST_DISTANCE( ST_GEOGPOINT(-122.191667, 47.685833),
                    ST_GEOGPOINT(internal_point_lon, internal_point_lat)) AS metres_to_pt
FROM   `bigquery-public-data.geo_us_boundaries.zip_codes`
WHERE  ST_DWITHIN( ST_GEOGPOINT(-122.191667, 47.685833),
                   ST_GEOGPOINT(internal_point_lon, internal_point_lat),
                   8046.72 )        -- 5 miles in metres
ORDER  BY metres_to_pt
LIMIT  20;
```

```sql
-- 5. Quickly check which of those nearby ZIPs spatially intersect any WA tract                  
WITH z AS (
  SELECT zip_code, zip_code_geom
  FROM   `bigquery-public-data.geo_us_boundaries.zip_codes`
  WHERE  ST_DWITHIN( ST_GEOGPOINT(-122.191667, 47.685833),
                     ST_GEOGPOINT(internal_point_lon, internal_point_lat),
                     8046.72 )
)
SELECT  z.zip_code,
        t.geo_id                 AS tract_id,
        ST_INTERSECTS(t.tract_geom, z.zip_code_geom) AS does_intersect
FROM    z
JOIN    `bigquery-public-data.geo_census_tracts.census_tracts_washington` t
ON      ST_INTERSECTS(t.tract_geom, z.zip_code_geom)
LIMIT   20;
```

```sql
-- 6. For a handful of tract/ZIP pairs compute the overlap fraction  
WITH z AS (
  SELECT zip_code, zip_code_geom
  FROM   `bigquery-public-data.geo_us_boundaries.zip_codes`
  WHERE  ST_DWITHIN( ST_GEOGPOINT(-122.191667, 47.685833),
                     ST_GEOGPOINT(internal_point_lon, internal_point_lat), 8046.72 )
),
pairs AS (
  SELECT  z.zip_code,
          t.geo_id                       AS tract_id,
          z.zip_code_geom,
          t.tract_geom,
          ST_AREA( ST_INTERSECTION(z.zip_code_geom, t.tract_geom) )          AS inter_area,
          ST_AREA( t.tract_geom )                                            AS tract_area
  FROM    z
  JOIN    `bigquery-public-data.geo_census_tracts.census_tracts_washington` t
  ON      ST_INTERSECTS(z.zip_code_geom, t.tract_geom)
)
SELECT *, SAFE_DIVIDE(inter_area, tract_area) AS frac_of_tract
FROM   pairs
WHERE  inter_area > 0
LIMIT  20;
```

```sql
-- 7. Allocate population & income from tracts to ZIPs using that area-based weight (sample)  
WITH z AS (
  SELECT zip_code, zip_code_geom
  FROM   `bigquery-public-data.geo_us_boundaries.zip_codes`
  WHERE  ST_DWITHIN( ST_GEOGPOINT(-122.191667, 47.685833),
                     ST_GEOGPOINT(internal_point_lon, internal_point_lat), 8046.72 )
),
tracts AS (
  SELECT a.geo_id,
         a.total_pop,
         a.income_per_capita,
         g.tract_geom
  FROM   `bigquery-public-data.census_bureau_acs.censustract_2017_5yr` a
  JOIN   `bigquery-public-data.geo_census_tracts.census_tracts_washington` g
  USING  (geo_id)
)
SELECT  z.zip_code,
        t.geo_id                    AS tract_id,
        SAFE_DIVIDE(
             ST_AREA( ST_INTERSECTION(z.zip_code_geom, t.tract_geom) ),
             ST_AREA( t.tract_geom) )                AS weight,
        t.total_pop,
        t.income_per_capita
FROM    z
JOIN    tracts t
ON      ST_INTERSECTS(z.zip_code_geom, t.tract_geom)
LIMIT   20;
```

```sql
-- 8. Summarise allocated population & aggregate income per ZIP (still sample, 20 rows)  
WITH zips AS (
  SELECT zip_code, zip_code_geom
  FROM   `bigquery-public-data.geo_us_boundaries.zip_codes`
  WHERE  ST_DWITHIN( ST_GEOGPOINT(-122.191667, 47.685833),
                     ST_GEOGPOINT(internal_point_lon, internal_point_lat), 8046.72 )
),
tracts AS (
  SELECT a.geo_id,
         a.total_pop,
         a.income_per_capita,
         g.tract_geom
  FROM   `bigquery-public-data.census_bureau_acs.censustract_2017_5yr` a
  JOIN   `bigquery-public-data.geo_census_tracts.census_tracts_washington` g
  USING  (geo_id)
),
alloc AS (
  SELECT z.zip_code,
         SAFE_DIVIDE(
             ST_AREA( ST_INTERSECTION(z.zip_code_geom, t.tract_geom) ),
             ST_AREA( t.tract_geom) )                AS w,
         t.total_pop,
         t.income_per_capita
  FROM   zips z
  JOIN   tracts t
  ON     ST_INTERSECTS(z.zip_code_geom, t.tract_geom)
)
SELECT  zip_code,
        SUM( w * total_pop )                                    AS alloc_pop,
        SUM( w * total_pop * income_per_capita ) / NULLIF(SUM(w*total_pop),0) AS pop_weighted_pc_income
FROM    alloc
GROUP BY zip_code
LIMIT 20;
```

```sql
-- 9. Final report: total pop & avg individual income (rounded) for every ZIP within 5-mi, ordered by income  
WITH zips AS (
  SELECT zip_code, zip_code_geom
  FROM   `bigquery-public-data.geo_us_boundaries.zip_codes`
  WHERE  ST_DWITHIN( ST_GEOGPOINT(-122.191667, 47.685833),
                     ST_GEOGPOINT(internal_point_lon, internal_point_lat), 8046.72 )
),
tracts AS (
  SELECT a.geo_id,
         a.total_pop,
         a.income_per_capita,
         g.tract_geom
  FROM   `bigquery-public-data.census_bureau_acs.censustract_2017_5yr` a
  JOIN   `bigquery-public-data.geo_census_tracts.census_tracts_washington` g
  USING  (geo_id)
),
alloc AS (
  SELECT z.zip_code,
         SAFE_DIVIDE(
             ST_AREA( ST_INTERSECTION(z.zip_code_geom, t.tract_geom) ),
             ST_AREA( t.tract_geom) )                AS w,
         t.total_pop,
         t.income_per_capita
  FROM   zips z
  JOIN   tracts t
  ON     ST_INTERSECTS(z.zip_code_geom, t.tract_geom)
)
SELECT  zip_code,
        ROUND( SUM(w * total_pop), 1 )                           AS total_population,
        ROUND( SUM( w * total_pop * income_per_capita )
               / NULLIF( SUM(w * total_pop),0 ), 1)             AS avg_indiv_income
FROM    alloc
GROUP BY zip_code
ORDER  BY avg_indiv_income DESC
LIMIT  20;
```

