```sql
--Description: Event counts (send, open, bounce, influenced-open) by campaign within the hour
SELECT
  s."CAMPAIGN_ID",
  COUNT(*)                                                   AS "push_notification_sends",
  ( SELECT COUNT(*) FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"  o
      WHERE o."CAMPAIGN_ID" = s."CAMPAIGN_ID"
        AND o."TIME" >= 1685606400 AND o."TIME" < 1685610000 ) AS "push_notification_open",
  ( SELECT COUNT(*) FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_BOUNCE_VIEW" b
      WHERE b."CAMPAIGN_ID" = s."CAMPAIGN_ID"
        AND b."TIME" >= 1685606400 AND b."TIME" < 1685610000 ) AS "push_notification_bounced",
  ( SELECT COUNT(*) FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_INFLUENCEDOPEN_VIEW" io
      WHERE io."CAMPAIGN_ID" = s."CAMPAIGN_ID"
        AND io."TIME" >= 1685606400 AND io."TIME" < 1685610000 ) AS "push_notification_influenced_open"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW" s
WHERE s."TIME" >= 1685606400
  AND s."TIME" <  1685610000
GROUP BY s."CAMPAIGN_ID"
LIMIT 20;
```

```sql
--Description: UNION of user-campaign pairs who either RECEIVED or OPENED a push notification in the hour
SELECT DISTINCT "USER_ID", "CAMPAIGN_ID", 'send'  AS "event_type"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
UNION
SELECT DISTINCT "USER_ID", "CAMPAIGN_ID", 'open'  AS "event_type"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
LIMIT 20;
```

```sql
--Description: Message variations that were both SENT and BOUNCED within the one-hour window
SELECT DISTINCT
  s."MESSAGE_VARIATION_ID"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"   s
JOIN BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_BOUNCE_VIEW" b
  ON s."MESSAGE_VARIATION_ID" = b."MESSAGE_VARIATION_ID"
WHERE s."TIME" >= 1685606400 AND s."TIME" < 1685610000
  AND b."TIME" >= 1685606400 AND b."TIME" < 1685610000
LIMIT 20;
```

```sql
--Description: Platform-level aggregation of SEND events in the hour (useful for engagement split)
SELECT
  "PLATFORM",
  COUNT(*) AS "push_notification_sends"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
WHERE "TIME" >= 1685606400
  AND "TIME" <  1685610000
GROUP BY "PLATFORM"
LIMIT 20;
```
