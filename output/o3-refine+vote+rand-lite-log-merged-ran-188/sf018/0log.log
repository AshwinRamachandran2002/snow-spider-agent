FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
WHERE "TIME" >= 1685606400   -- 2023-06-01 08:00:00 UTC
  AND "TIME" < 1685610000    -- 2023-06-01 09:00:00 UTC
LIMIT 20;
