```sql
--Description: ① Raw list of push-notification “send” events that occurred between 08:00 and 09:00 UTC on 2023-06-01.  
SELECT *
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
WHERE "TIME" >= 1685606400   -- 2023-06-01 08:00:00 UTC
  AND "TIME" < 1685610000    -- 2023-06-01 09:00:00 UTC
LIMIT 20;
```

```sql
--Description: ② Distinct campaigns that delivered at least one “send” event in the same one-hour window.  
SELECT DISTINCT "CAMPAIGN_ID"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
WHERE "TIME" >= 1685606400
  AND "TIME" < 1685610000
LIMIT 20;
```

```sql
--Description: ③ Count of notifications sent per campaign during the window (top 20).  
SELECT "CAMPAIGN_ID",
       COUNT(*)                AS "push_notification_sends"
FROM   BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
WHERE  "TIME" >= 1685606400
  AND  "TIME" < 1685610000
GROUP  BY "CAMPAIGN_ID"
ORDER  BY "push_notification_sends" DESC
LIMIT 20;
```

```sql
--Description: ④ Raw list of “open” events that happened between 08:00-09:00 UTC on 2023-06-01.  
SELECT *
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
WHERE "TIME" >= 1685606400
  AND "TIME" < 1685610000
LIMIT 20;
```

```sql
--Description: ⑤ Unique users who opened a push notification in that window.  
SELECT DISTINCT "USER_ID"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
WHERE "TIME" >= 1685606400
  AND "TIME" < 1685610000
LIMIT 20;
```

```sql
--Description: ⑥ Join sends → opens (same user & message variation) to view messages both sent and opened within the hour.  
SELECT s."CAMPAIGN_ID",
       s."MESSAGE_VARIATION_ID",
       s."USER_ID",
       s."PLATFORM",
       s."TIME"  AS "send_time",
       o."TIME"  AS "open_time"
FROM   BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"  s
JOIN   BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"  o
       ON  s."USER_ID"             = o."USER_ID"
       AND s."MESSAGE_VARIATION_ID"= o."MESSAGE_VARIATION_ID"
WHERE  s."TIME" >= 1685606400 AND s."TIME" < 1685610000
  AND  o."TIME" >= 1685606400 AND o."TIME" < 1685610000
LIMIT 20;
```

```sql
--Description: ⑦ Identify “bounce” events for notifications that had been sent in the same hour.  
SELECT s."CAMPAIGN_ID",
       s."MESSAGE_VARIATION_ID",
       s."USER_ID",
       s."PLATFORM",
       b."TIME" AS "bounce_time"
FROM   BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"   s
JOIN   BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_BOUNCE_VIEW" b
       ON  s."USER_ID"             = b."USER_ID"
       AND s."MESSAGE_VARIATION_ID"= b."MESSAGE_VARIATION_ID"
WHERE  s."TIME" >= 1685606400 AND s."TIME" < 1685610000
  AND  b."TIME" >= 1685606400 AND b."TIME" < 1685610000
LIMIT 20;
```

```sql
--Description: ⑧ Match sends with “influenced-open” events occurring inside the window.  
SELECT s."CAMPAIGN_ID",
       s."MESSAGE_VARIATION_ID",
       s."USER_ID",
       s."PLATFORM",
       i."TIME" AS "influenced_open_time"
FROM   BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"          s
JOIN   BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_INFLUENCEDOPEN_VIEW" i
       ON  s."USER_ID"             = i."USER_ID"
       AND s."MESSAGE_VARIATION_ID"= i."MESSAGE_VARIATION_ID"
WHERE  s."TIME" >= 1685606400 AND s."TIME" < 1685610000
  AND  i."TIME" >= 1685606400 AND i."TIME" < 1685610000
LIMIT 20;
```

```sql
--Description: ⑨ Platform-level summary of send vs. open counts during the one-hour period.  
SELECT s."PLATFORM",
       COUNT(*)                          AS "push_notification_sends",
       COUNT(DISTINCT o."ID")            AS "push_notification_open"
FROM   BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"  s
LEFT  JOIN BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"  o
       ON  s."USER_ID"             = o."USER_ID"
       AND s."MESSAGE_VARIATION_ID"= o."MESSAGE_VARIATION_ID"
       AND o."TIME" >= 1685606400  AND o."TIME" < 1685610000
WHERE  s."TIME" >= 1685606400
  AND  s."TIME" < 1685610000
GROUP BY s."PLATFORM"
LIMIT 20;
```

```sql
--Description: ⑩ Comprehensive campaign-level engagement metrics (send, open, influenced open, bounce) for the hour.  
SELECT  s."CAMPAIGN_ID",
        COUNT(*)                                     AS "push_notification_sends",
        COUNT(DISTINCT o."USER_ID")                  AS "unique_opens",
        COUNT(DISTINCT b."USER_ID")                  AS "unique_bounces",
        COUNT(DISTINCT i."USER_ID")                  AS "unique_influenced_opens"
FROM    BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"           s
LEFT    JOIN BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"      o
           ON s."USER_ID" = o."USER_ID"
          AND s."MESSAGE_VARIATION_ID" = o."MESSAGE_VARIATION_ID"
          AND o."TIME" >= 1685606400 AND o."TIME" < 1685610000
LEFT    JOIN BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_BOUNCE_VIEW"    b
           ON s."USER_ID" = b."USER_ID"
          AND s."MESSAGE_VARIATION_ID" = b."MESSAGE_VARIATION_ID"
          AND b."TIME" >= 1685606400 AND b."TIME" < 1685610000
LEFT    JOIN BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_INFLUENCEDOPEN_VIEW" i
           ON s."USER_ID" = i."USER_ID"
          AND s."MESSAGE_VARIATION_ID" = i."MESSAGE_VARIATION_ID"
          AND i."TIME" >= 1685606400 AND i."TIME" < 1685610000
WHERE   s."TIME" >= 1685606400
  AND   s."TIME" < 1685610000
GROUP   BY s."CAMPAIGN_ID"
ORDER   BY "push_notification_sends" DESC
LIMIT 20;
```
