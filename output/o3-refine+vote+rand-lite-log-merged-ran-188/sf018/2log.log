Query:
--Description: 10) Break down engagement metrics by CAMPAIGN and PLATFORM
--              for the one-hour window (sends vs opens).
WITH sends AS (
    SELECT "CAMPAIGN_ID", "PLATFORM", COUNT(*) AS "sends"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
    WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
    GROUP BY "CAMPAIGN_ID", "PLATFORM"
), opens AS (
    SELECT "CAMPAIGN_ID", "PLATFORM", COUNT(*) AS "opens"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
    WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
    GROUP BY "CAMPAIGN_ID", "PLATFORM"
)
SELECT s."CAMPAIGN_ID",
       s."PLATFORM",
       s."sends",
       o."opens"
FROM sends s
LEFT JOIN opens o
  ON s."CAMPAIGN_ID" = o."CAMPAIGN_ID"
 AND s."PLATFORM"    = o."PLATFORM"
LIMIT 20;
