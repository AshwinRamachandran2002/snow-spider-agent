Query:
--Description: 9) Aggregate counts of sends, opens, bounces, and influenced opens
--             by campaign within the one-hour window.
WITH send_ct AS (
    SELECT "CAMPAIGN_ID", COUNT(*) AS "send_count"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
    WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
    GROUP BY "CAMPAIGN_ID"
), open_ct AS (
    SELECT "CAMPAIGN_ID", COUNT(*) AS "open_count"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
    WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
    GROUP BY "CAMPAIGN_ID"
), bounce_ct AS (
    SELECT "CAMPAIGN_ID", COUNT(*) AS "bounce_count"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_BOUNCE_VIEW"
    WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
    GROUP BY "CAMPAIGN_ID"
), infl_ct AS (
    SELECT "CAMPAIGN_ID", COUNT(*) AS "influenced_open_count"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_INFLUENCEDOPEN_VIEW"
    WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
    GROUP BY "CAMPAIGN_ID"
)
SELECT COALESCE(s."CAMPAIGN_ID", o."CAMPAIGN_ID", b."CAMPAIGN_ID", i."CAMPAIGN_ID") AS "CAMPAIGN_ID",
       s."send_count",
       o."open_count",
       b."bounce_count",
       i."influenced_open_count"
FROM send_ct s
FULL OUTER JOIN open_ct  o ON s."CAMPAIGN_ID" = o."CAMPAIGN_ID"
FULL OUTER JOIN bounce_ct b ON COALESCE(s."CAMPAIGN_ID", o."CAMPAIGN_ID") = b."CAMPAIGN_ID"
FULL OUTER JOIN infl_ct  i ON COALESCE(s."CAMPAIGN_ID", o."CAMPAIGN_ID", b."CAMPAIGN_ID") = i."CAMPAIGN_ID"
LIMIT 20;
