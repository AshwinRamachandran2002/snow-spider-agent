Query:
--Description: 1) Inspect all push-notification SEND events that occurred
--             between 08:00 and 09:00 (UTC) on 2023-06-01.
SELECT *
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
WHERE "TIME" >= 1685606400
  AND "TIME" < 1685610000
LIMIT 20;
