--             during the timeframe.
SELECT DISTINCT "USER_ID"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
WHERE "TIME" >= 1685606400
  AND "TIME" < 1685610000
LIMIT 20;
```

```sql
--Description: 7) Inspect all INFLUENCED OPEN events in the same window.
SELECT *
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_INFLUENCEDOPEN_VIEW"
WHERE "TIME" >= 1685606400
  AND "TIME" < 1685610000
LIMIT 20;
```

```sql
--Description: 8) Join SEND and OPEN events to see which sends were opened
--             within the hour (same "MESSAGE_VARIATION_ID").
SELECT s."USER_ID",
       s."CAMPAIGN_ID",
       s."MESSAGE_VARIATION_ID",
       s."PLATFORM",
       o."TIME" AS "open_time"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"  s
JOIN BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"  o
  ON s."USER_ID" = o."USER_ID"
 AND s."MESSAGE_VARIATION_ID" = o."MESSAGE_VARIATION_ID"
WHERE s."TIME" >= 1685606400
  AND s."TIME" < 1685610000
  AND o."TIME" >= 1685606400
  AND o."TIME" < 1685610000
LIMIT 20;
```

```sql
--Description: 9) Aggregate counts of sends, opens, bounces, and influenced opens
--             by campaign within the one-hour window.
WITH send_ct AS (
    SELECT "CAMPAIGN_ID", COUNT(*) AS "send_count"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
    WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
    GROUP BY "CAMPAIGN_ID"
), open_ct AS (
    SELECT "CAMPAIGN_ID", COUNT(*) AS "open_count"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
    WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
    GROUP BY "CAMPAIGN_ID"
), bounce_ct AS (
    SELECT "CAMPAIGN_ID", COUNT(*) AS "bounce_count"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_BOUNCE_VIEW"
    WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
    GROUP BY "CAMPAIGN_ID"
), infl_ct AS (
    SELECT "CAMPAIGN_ID", COUNT(*) AS "influenced_open_count"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_INFLUENCEDOPEN_VIEW"
    WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
    GROUP BY "CAMPAIGN_ID"
)
SELECT COALESCE(s."CAMPAIGN_ID", o."CAMPAIGN_ID", b."CAMPAIGN_ID", i."CAMPAIGN_ID") AS "CAMPAIGN_ID",
       s."send_count",
       o."open_count",
       b."bounce_count",
       i."influenced_open_count"
FROM send_ct s
FULL OUTER JOIN open_ct  o ON s."CAMPAIGN_ID" = o."CAMPAIGN_ID"
FULL OUTER JOIN bounce_ct b ON COALESCE(s."CAMPAIGN_ID", o."CAMPAIGN_ID") = b."CAMPAIGN_ID"
FULL OUTER JOIN infl_ct  i ON COALESCE(s."CAMPAIGN_ID", o."CAMPAIGN_ID", b."CAMPAIGN_ID") = i."CAMPAIGN_ID"
LIMIT 20;
```

```sql
--Description: 10) Break down engagement metrics by CAMPAIGN and PLATFORM
--              for the one-hour window (sends vs opens).
WITH sends AS (
    SELECT "CAMPAIGN_ID", "PLATFORM", COUNT(*) AS "sends"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
    WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
    GROUP BY "CAMPAIGN_ID", "PLATFORM"
), opens AS (
    SELECT "CAMPAIGN_ID", "PLATFORM", COUNT(*) AS "opens"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
    WHERE "TIME" >= 1685606400 AND "TIME" < 1685610000
    GROUP BY "CAMPAIGN_ID", "PLATFORM"
)
SELECT s."CAMPAIGN_ID",
       s."PLATFORM",
       s."sends",
       o."opens"
FROM sends s
LEFT JOIN opens o
  ON s."CAMPAIGN_ID" = o."CAMPAIGN_ID"
 AND s."PLATFORM"    = o."PLATFORM"
LIMIT 20;
```
