/*  Top-10 states by “vulnerable-population” score (2017 ACS 5-YR)
    plus their average change in median household income, 2015→2018   */

WITH weights AS (          -- constants supplied in task description
    SELECT  0.38423645320197042  AS w_wholesale ,
            0.48071410777129553  AS w_natconstr,
            0.89455676291236841  AS w_arts      ,
            0.31315240083507306  AS w_info      ,
            0.51                 AS w_retail    ,
            0.039299298394228743 AS w_pubadmin  ,
            0.36555534476489654  AS w_services  ,
            0.20323178400562944  AS w_edhealth  ,
            0.36805065936180870  AS w_transport ,
            0.40618955512572535  AS w_manufact
),

/* ---------- 1.  Vulnerable-population score per state (2017) ---------- */
vulnerable AS (
    SELECT
        LPAD("geo_id", 2, '0')                                          AS state_fips,
        /* weighted-sum across employment sectors */
        w.w_wholesale * "employed_wholesale_trade"                             +
        w.w_natconstr * "occupation_natural_resources_construction_maintenance"+
        w.w_arts      * "employed_arts_entertainment_recreation_accommodation_food"+
        w.w_info      * "employed_information"                                  +
        w.w_retail    * "employed_retail_trade"                                 +
        w.w_pubadmin  * "employed_public_administration"                        +
        w.w_services  * "occupation_services"                                   +
        w.w_edhealth  * "employed_education_health_social"                      +
        w.w_transport * "employed_transportation_warehousing_utilities"         +
        w.w_manufact  * "employed_manufacturing"                          AS vulnerable_population
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_5YR"
    CROSS JOIN weights w
),

/* ---------- 2.  Average ZIP-level median income, 2015 ---------- */
income_2015 AS (
    SELECT
        b."state_code",
        AVG( TRY_TO_NUMBER( z."median_income" ) ) AS avg_income_2015
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"        b
         ON z."geo_id" = b."zip_code"
    WHERE z."median_income" IS NOT NULL
      AND TRY_TO_NUMBER( z."median_income" ) > 0             -- exclude blanks / sentinels
    GROUP BY b."state_code"
),

/* ---------- 3.  Average ZIP-level median income, 2018 ---------- */
income_2018 AS (
    SELECT
        b."state_code",
        AVG( z."median_income" )        AS avg_income_2018
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"        b
         ON z."geo_id" = b."zip_code"
    WHERE z."median_income" IS NOT NULL
      AND z."median_income" > 0
    GROUP BY b."state_code"
),

/* ---------- 4.  Income change 2015 → 2018 by state ---------- */
income_change AS (
    SELECT
        i18."state_code",
        i18."avg_income_2018" - i15."avg_income_2015"  AS income_change_2015_2018
    FROM income_2018 i18
    JOIN income_2015 i15 USING ("state_code")
),

/* ---------- 5.  Combine vulnerability + income change ---------- */
combined AS (
    SELECT
        f."state",
        v."vulnerable_population",
        ic."income_change_2015_2018"
    FROM vulnerable v
    JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS" f
         ON v.state_fips = LPAD( f."fips", 2, '0')
    JOIN income_change    ic
         ON ic."state_code" = f."postal_code"
)

/* ---------- 6.  Top-10 output ---------- */
SELECT
    "state",
    "vulnerable_population",
    "income_change_2015_2018"
FROM combined
ORDER BY "vulnerable_population" DESC NULLS LAST
LIMIT 10;
```
