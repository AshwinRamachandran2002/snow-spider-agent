-- Description: 10) Combine vulnerable-population score with income-change
--               and rank states (top 10 highest vulnerability shown).
WITH vuln AS (
  SELECT
    "geo_id",
    0.38423645320197042 * "employed_wholesale_trade" +
    0.48071410777129553 * "occupation_natural_resources_construction_maintenance" +
    0.89455676291236841 * "employed_arts_entertainment_recreation_accommodation_food" +
    0.31315240083507306 * "employed_information" +
    0.51                    * "employed_retail_trade" +
    0.039299298394228743  * "employed_public_administration" +
    0.36555534476489654   * "occupation_services" +
    0.20323178400562944   * "employed_education_health_social" +
    0.3680506593618087    * "employed_transportation_warehousing_utilities" +
    0.40618955512572535   * "employed_manufacturing"
    AS "vulnerable_population"
  FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_5YR"
),
inc_change AS (
  WITH inc15 AS (
    SELECT b."state_code",
           AVG(CAST(z."median_income" AS FLOAT)) AS "avg_income_2015"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" b
      ON z."geo_id" = b."zip_code"
    WHERE z."median_income" IS NOT NULL
    GROUP BY b."state_code"
  ),
  inc18 AS (
    SELECT b."state_code",
           AVG(CAST(z."median_income" AS FLOAT)) AS "avg_income_2018"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" b
      ON z."geo_id" = b."zip_code"
    WHERE z."median_income" IS NOT NULL
    GROUP BY b."state_code"
  )
  SELECT
    inc18."state_code",
    inc18."avg_income_2018" - inc15."avg_income_2015" AS "income_change_2015_2018"
  FROM inc18
  JOIN inc15 USING ("state_code")
)
SELECT
  f."state",
  v."vulnerable_population",
  i."income_change_2015_2018"
FROM vuln v
JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS" f
  ON v."geo_id" = LPAD(f."fips", 2, '0')   -- STATE_2017_5YR geo_id is 2-digit FIPS
JOIN inc_change i
  ON f."postal_code" = i."state_code"
ORDER BY v."vulnerable_population" DESC
LIMIT 10;
