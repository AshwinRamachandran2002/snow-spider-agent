        w.w_services  * "occupation_services" +
        w.w_edhealth  * "employed_education_health_social" +
        w.w_transport * "employed_transportation_warehousing_utilities" +
        w.w_manufact  * "employed_manufacturing"                                  AS vulnerable_population
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.STATE_2017_5YR
    CROSS JOIN weights w
),

/* ---------- 2. Average ZIP-level median income, 2015 ---------- */
income_2015 AS (
    SELECT
        b.state_code,
        AVG(CAST(z.median_income AS FLOAT))                                       AS AVG_INCOME_2015
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.ZIP_CODES_2015_5YR z
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES.ZIP_CODES        b
          ON z.geo_id = b.zip_code
    WHERE z.median_income IS NOT NULL
      AND CAST(z.median_income AS FLOAT) > 0
    GROUP BY b.state_code
),

/* ---------- 3. Average ZIP-level median income, 2018 ---------- */
income_2018 AS (
    SELECT
        b.state_code,
        AVG(CAST(z.median_income AS FLOAT))                                       AS AVG_INCOME_2018
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR z
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES.ZIP_CODES        b
          ON z.geo_id = b.zip_code
    WHERE z.median_income IS NOT NULL
      AND CAST(z.median_income AS FLOAT) > 0
    GROUP BY b.state_code
),

/* ---------- 4. Income change 2015 → 2018 ---------- */
income_change AS (
    SELECT
        i18.state_code,
        i18.AVG_INCOME_2018 - i15.AVG_INCOME_2015                 AS income_change_2015_2018
    FROM income_2018 i18
    JOIN income_2015 i15
          ON i18.state_code = i15.state_code
),

/* ---------- 5. Combine vulnerability & income change ---------- */
combined AS (
    SELECT
        f.state,
        v.vulnerable_population,
        ic.income_change_2015_2018
    FROM vulnerable                               v
    JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC.STATE_FIPS f
          ON v.state_fips = LPAD(f.fips, 2, '0')
    JOIN income_change                            ic
          ON ic.state_code = f.postal_code
)

/* ---------- 6. Top-10 result ---------- */
SELECT
    state,
    vulnerable_population,
    income_change_2015_2018
FROM combined
ORDER BY vulnerable_population DESC NULLS LAST
LIMIT 10;
