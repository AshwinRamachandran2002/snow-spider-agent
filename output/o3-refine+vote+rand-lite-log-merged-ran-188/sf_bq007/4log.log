```sql
-- 5. Description: Preview 2018 zip-code-level median income data (limited to 20 zips)
SELECT 
  "geo_id"        AS "zip_code",
  "median_income"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
LIMIT 20;
```

```sql
-- 6. Description: Compute average 2015 median income by state (using boundary table to map ZIP → state)
SELECT 
  g."state_name",
  AVG(z15."median_income") AS "avg_median_income_2015"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"  z15
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"           g
      ON g."zip_code" = z15."geo_id"
GROUP BY g."state_name"
LIMIT 20;
```

```sql
-- 7. Description: Compute average 2018 median income by state (ZIP → state)
SELECT 
  g."state_name",
  AVG(z18."median_income") AS "avg_median_income_2018"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"  z18
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"           g
      ON g."zip_code" = z18."geo_id"
GROUP BY g."state_name"
LIMIT 20;
```

```sql
-- 8. Description: Combine 2015 & 2018 averages to get income change for each state
WITH inc15 AS (
  SELECT g."state_name", AVG(z15."median_income") AS "avg_2015"
  FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
  JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"          g
        ON g."zip_code" = z15."geo_id"
  GROUP BY g."state_name"
),
inc18 AS (
  SELECT g."state_name", AVG(z18."median_income") AS "avg_2018"
  FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
  JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"          g
        ON g."zip_code" = z18."geo_id"
  GROUP BY g."state_name"
)
SELECT 
  i15."state_name",
  i15."avg_2015",
  i18."avg_2018",
  (i18."avg_2018" - i15."avg_2015") AS "income_change_2015_2018"
FROM inc15 i15
JOIN inc18 i18
  ON i18."state_name" = i15."state_name"
LIMIT 20;
```

```sql
-- 9. Description: Attach the vulnerable_score (from state table) to each state and bring along income change
WITH vuln AS (
  SELECT 
    CAST(s."geo_id" AS INTEGER) AS "fips",
    (
        s."employed_wholesale_trade"  * 0.38423645320197042 +
        s."occupation_natural_resources_construction_maintenance" * 0.48071410777129553 +
        s."employed_arts_entertainment_recreation_accommodation_food" * 0.89455676291236841 +
        s."employed_information" * 0.31315240083507306 +
        s."employed_retail_trade" * 0.51 +
        s."employed_public_administration" * 0.039299298394228743 +
        s."occupation_services" * 0.36555534476489654 +
        s."employed_education_health_social" * 0.20323178400562944 +
        s."employed_transportation_warehousing_utilities" * 0.3680506593618087 +
        s."employed_manufacturing" * 0.40618955512572535
    ) AS "vulnerable_score"
  FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_5YR" s
),
inc_change AS (
  /* re-use query 8 but keep it brief here */
  SELECT 
    g."state_name",
    (AVG(z18."median_income") - AVG(z15."median_income")) AS "income_change_2015_2018"
  FROM CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" g
  JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
    ON g."zip_code" = z15."geo_id"
  JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
    ON g."zip_code" = z18."geo_id"
  GROUP BY g."state_name"
)
SELECT 
  f."state",
  v."vulnerable_score",
  i."income_change_2015_2018"
FROM vuln v
JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"                 f ON f."fips" = v."fips"
JOIN inc_change                                                 i ON i."state_name" = f."state"
LIMIT 20;
```

```sql
-- 10. Description: Rank states by vulnerable_score (highest first) and show the top 10 with their income change
WITH vuln AS (
  SELECT 
    CAST(s."geo_id" AS INTEGER) AS "fips",
    (
        s."employed_wholesale_trade"  * 0.38423645320197042 +
        s."occupation_natural_resources_construction_maintenance" * 0.48071410777129553 +
        s."employed_arts_entertainment_recreation_accommodation_food" * 0.89455676291236841 +
        s."employed_information" * 0.31315240083507306 +
        s."employed_retail_trade" * 0.51 +
        s."employed_public_administration" * 0.039299298394228743 +
        s."occupation_services" * 0.36555534476489654 +
        s."employed_education_health_social" * 0.20323178400562944 +
        s."employed_transportation_warehousing_utilities" * 0.3680506593618087 +
        s."employed_manufacturing" * 0.40618955512572535
    ) AS "vulnerable_score"
  FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_5YR" s
),
inc_change AS (
  SELECT 
    g."state_name",
    (AVG(z18."median_income") - AVG(z15."median_income")) AS "income_change_2015_2018"
  FROM CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" g
  JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
    ON g."zip_code" = z15."geo_id"
  JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
    ON g."zip_code" = z18."geo_id"
  GROUP BY g."state_name"
)
SELECT 
  f."state"                            AS "state_name",
  v."vulnerable_score",
  i."income_change_2015_2018"
FROM vuln v
JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"  f ON f."fips" = v."fips"
JOIN inc_change                                i ON i."state_name" = f."state"
ORDER BY v."vulnerable_score" DESC
LIMIT 10;
```
