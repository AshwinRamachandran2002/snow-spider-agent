Query:
--Description:  Attempting to join “2015” and “2018” snapshots is impossible; instead demonstrate a self-join on the
--single 2014 snapshot (it will return identical income figures in both columns and a zero change).

SELECT
  a.geo_id,
  a.median_income_2014        AS median_income_left,
  b.median_income_2014_dup    AS median_income_right
FROM (
      SELECT geo_id,
             median_income AS median_income_2014
      FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
      WHERE geo_id LIKE '06%'
        AND do_date = '2014-01-01'
     ) AS a
JOIN (
      SELECT geo_id,
             median_income AS median_income_2014_dup
      FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
      WHERE geo_id LIKE '06%'
        AND do_date = '2014-01-01'
     ) AS b
USING (geo_id)
LIMIT 20
