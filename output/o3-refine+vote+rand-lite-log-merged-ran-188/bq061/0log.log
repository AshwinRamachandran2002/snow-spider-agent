Query:
--Description:  Compute a (trivial) change using the duplicated 2014 columns; every income_change will be 0
--because no second snapshot exists, but this confirms the logic compiles and runs.

SELECT
  geo_id,
  median_income_left,
  median_income_right,
  (median_income_right - median_income_left) AS income_change
FROM (
      SELECT
        a.geo_id,
        a.median_income_2014        AS median_income_left,
        b.median_income_2014_dup    AS median_income_right
      FROM (
            SELECT geo_id,
                   median_income AS median_income_2014
            FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
            WHERE geo_id LIKE '06%'
              AND do_date = '2014-01-01'
           ) AS a
      JOIN (
            SELECT geo_id,
                   median_income AS median_income_2014_dup
            FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
            WHERE geo_id LIKE '06%'
              AND do_date = '2014-01-01'
           ) AS b
      USING (geo_id)
     )
ORDER BY income_change DESC
LIMIT 20
