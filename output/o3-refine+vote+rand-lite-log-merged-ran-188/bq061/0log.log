```sql
-- Largest median-income increase (2015 → 2018) among California census tracts
WITH all_years AS (
  SELECT
    geo_id,
    median_income,
    _TABLE_SUFFIX AS src_year                         -- “2015_5yr” or “2018_5yr”
  FROM `bigquery-public-data.census_bureau_acs.censustract_*_5yr`
  WHERE _TABLE_SUFFIX IN ('2015_5yr','2018_5yr')      -- pick the two snapshots
    AND geo_id LIKE '06%'                             -- California tracts (FIPS “06”)
),
pivot AS (
  SELECT
    geo_id,
    MAX(IF(src_year='2015_5yr', median_income, NULL)) AS median_income_2015,
    MAX(IF(src_year='2018_5yr', median_income, NULL)) AS median_income_2018
  FROM all_years
  GROUP BY geo_id
),
changes AS (
  SELECT
    geo_id,
    median_income_2015,
    median_income_2018,
    median_income_2018 - median_income_2015 AS income_change
  FROM pivot
  WHERE median_income_2015 IS NOT NULL
    AND median_income_2018 IS NOT NULL
)
SELECT
  geo_id AS tract_code
FROM changes
ORDER BY income_change DESC
LIMIT 1;
```
