Below is a step-by-step set of exploratory SQLs that narrow the search to California census-tract rows, pick 2015 and 2018 values, compute the change in median household income, and finally reveal the tract that experienced the largest gain.

```sql
-- 1. Quick look at the census-tract ACS 5-year table (sample rows)
SELECT * 
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
LIMIT 20;
```

```sql
-- 2. See what “do_date” snapshots exist in the table
SELECT DISTINCT do_date
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
ORDER BY do_date
LIMIT 20;
```

```sql
-- 3. Check one California tract (geo_id starts with '06') for the two years of interest
SELECT geo_id, do_date, median_income
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE geo_id LIKE '06%'               -- California FIPS 06
  AND do_date IN ('2015-01-01','2018-01-01')
LIMIT 20;
```

```sql
-- 4. Pull every California tract’s 2015 median income
SELECT geo_id,
       median_income AS median_income_2015
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE geo_id LIKE '06%'
  AND do_date = '2015-01-01'
LIMIT 20;
```

```sql
-- 5. Pull every California tract’s 2018 median income
SELECT geo_id,
       median_income AS median_income_2018
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE geo_id LIKE '06%'
  AND do_date = '2018-01-01'
LIMIT 20;
```

```sql
-- 6. Join the two snapshots together for California tracts
SELECT a.geo_id,
       a.median_income_2015,
       b.median_income_2018
FROM  (
        SELECT geo_id,
               median_income AS median_income_2015
        FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
        WHERE geo_id LIKE '06%'
          AND do_date = '2015-01-01'
      ) AS a
JOIN  (
        SELECT geo_id,
               median_income AS median_income_2018
        FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
        WHERE geo_id LIKE '06%'
          AND do_date = '2018-01-01'
      ) AS b
USING (geo_id)
LIMIT 20;
```

```sql
-- 7. Compute the absolute change (2018 – 2015) and look at the biggest movers
SELECT geo_id,
       median_income_2015,
       median_income_2018,
       (median_income_2018 - median_income_2015) AS income_change
FROM (
      SELECT a.geo_id,
             a.median_income_2015,
             b.median_income_2018
      FROM  (
              SELECT geo_id,
                     median_income AS median_income_2015
              FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
              WHERE geo_id LIKE '06%'
                AND do_date = '2015-01-01'
            ) AS a
      JOIN  (
              SELECT geo_id,
                     median_income AS median_income_2018
              FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
              WHERE geo_id LIKE '06%'
                AND do_date = '2018-01-01'
            ) AS b
      USING (geo_id)
     )
ORDER BY income_change DESC
LIMIT 20;
```

```sql
-- 8. Remove tracts that have NULL values in either year
SELECT geo_id,
       median_income_2015,
       median_income_2018,
       (median_income_2018 - median_income_2015) AS income_change
FROM (
      SELECT a.geo_id,
             a.median_income_2015,
             b.median_income_2018
      FROM  (
              SELECT geo_id,
                     median_income AS median_income_2015
              FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
              WHERE geo_id LIKE '06%'
                AND do_date = '2015-01-01'
                AND median_income IS NOT NULL
            ) AS a
      JOIN  (
              SELECT geo_id,
                     median_income AS median_income_2018
              FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
              WHERE geo_id LIKE '06%'
                AND do_date = '2018-01-01'
                AND median_income IS NOT NULL
            ) AS b
      USING (geo_id)
     )
ORDER BY income_change DESC
LIMIT 20;
```

```sql
-- 9. FINAL – Which California tract saw the largest jump? (single row answer)
SELECT geo_id                                                     AS tract_code,
       median_income_2015,
       median_income_2018,
       (median_income_2018 - median_income_2015)                  AS income_change
FROM (
      SELECT a.geo_id,
             a.median_income_2015,
             b.median_income_2018
      FROM  (
              SELECT geo_id,
                     median_income AS median_income_2015
              FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
              WHERE geo_id LIKE '06%'
                AND do_date = '2015-01-01'
                AND median_income IS NOT NULL
            ) AS a
      JOIN  (
              SELECT geo_id,
                     median_income AS median_income_2018
              FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
              WHERE geo_id LIKE '06%'
                AND do_date = '2018-01-01'
                AND median_income IS NOT NULL
            ) AS b
      USING (geo_id)
     )
ORDER BY income_change DESC
LIMIT 1;
```

Running query 9 returns the tract code with the greatest 2015-to-2018 median-income increase. 
