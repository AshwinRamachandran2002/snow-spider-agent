--Description: 1)  Which survey years are available in the ACS census‐tract table?
SELECT DISTINCT EXTRACT(YEAR FROM `do_date`) AS survey_year
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
ORDER BY survey_year
LIMIT 20;
```

```sql
--Description: 2)  Take a quick look at 20 California census‐tract records.
SELECT `geo_id`, `do_date`, `median_income`
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE SUBSTR(`geo_id`,1,2) = '06'          -- 06 = California FIPS
ORDER BY `geo_id`, `do_date`
LIMIT 20;
```

```sql
--Description: 3)  Inspect one California tract across all years to be sure the figures vary by time.
SELECT `geo_id`, EXTRACT(YEAR FROM `do_date`) AS yr, `median_income`
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE `geo_id` = '06001400100'             -- any CA tract; pick one that appears
ORDER BY yr
LIMIT 20;
```

```sql
--Description: 4)  Pull only 2015 records for California to check their availability.
SELECT `geo_id`, `median_income`
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE SUBSTR(`geo_id`,1,2) = '06'
  AND EXTRACT(YEAR FROM `do_date`) = 2015
ORDER BY `median_income` DESC
LIMIT 20;
```

```sql
--Description: 5)  Pull only 2018 records for California for comparison.
SELECT `geo_id`, `median_income`
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE SUBSTR(`geo_id`,1,2) = '06'
  AND EXTRACT(YEAR FROM `do_date`) = 2018
ORDER BY `median_income` DESC
LIMIT 20;
```

```sql
--Description: 6)  Build a two-column (2015 vs 2018) view of median income for each CA tract.
SELECT
  `geo_id`,
  MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2015 THEN `median_income` END) AS income_2015,
  MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2018 THEN `median_income` END) AS income_2018
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE SUBSTR(`geo_id`,1,2) = '06'
GROUP BY `geo_id`
LIMIT 20;
```

```sql
--Description: 7)  Compute the change (2018 − 2015) for every CA tract, keeping both components.
SELECT
  `geo_id`,
  MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2015 THEN `median_income` END) AS income_2015,
  MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2018 THEN `median_income` END) AS income_2018,
  (MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2018 THEN `median_income` END) -
   MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2015 THEN `median_income` END))     AS income_change
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE SUBSTR(`geo_id`,1,2) = '06'
GROUP BY `geo_id`
LIMIT 20;
```

```sql
--Description: 8)  Order those changes from largest to smallest to see which tracts jump out.
SELECT
  `geo_id`,
  (MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2018 THEN `median_income` END) -
   MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2015 THEN `median_income` END)) AS income_change
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE SUBSTR(`geo_id`,1,2) = '06'
GROUP BY `geo_id`
ORDER BY income_change DESC
LIMIT 20;
```

```sql
--Description: 9)  Include both annual figures along with the change for easy sanity-check, still ordered.
SELECT
  `geo_id`,
  MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2015 THEN `median_income` END) AS income_2015,
  MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2018 THEN `median_income` END) AS income_2018,
  (MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2018 THEN `median_income` END) -
   MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2015 THEN `median_income` END)) AS income_change
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE SUBSTR(`geo_id`,1,2) = '06'
GROUP BY `geo_id`
ORDER BY income_change DESC
LIMIT 20;
```

```sql
--Description: 10)  FINAL – the California census tract with the single largest increase
--               in median household income from 2015-01-01 to 2018-01-01.
SELECT
  `geo_id` AS tract_code
FROM (
  SELECT
    `geo_id`,
    (MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2018 THEN `median_income` END) -
     MAX(CASE WHEN EXTRACT(YEAR FROM `do_date`)=2015 THEN `median_income` END)) AS income_change
  FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
  WHERE SUBSTR(`geo_id`,1,2) = '06'
  GROUP BY `geo_id`
)
ORDER BY income_change DESC
LIMIT 20;        -- top tract appears first; its geo_id is the answer
```

Running the final query will list the 20 largest jumps, with the very first `geo_id` in that result being the census-tract code that experienced the greatest median-income increase in California between 2015 and 2018.
