```sql
-- Which California census tract shows the largest rise in median income from 2015 to 2018?
SELECT
  geo_id
FROM (
  SELECT
    geo_id,
    MAX(CASE WHEN EXTRACT(YEAR FROM do_date) = 2018 THEN median_income END) AS income_2018,
    MAX(CASE WHEN EXTRACT(YEAR FROM do_date) = 2015 THEN median_income END) AS income_2015
  FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
  WHERE LEFT(geo_id, 2) = '06'          -- California tracts only
    AND EXTRACT(YEAR FROM do_date) IN (2015, 2018)
  GROUP BY geo_id
  HAVING income_2018 IS NOT NULL
     AND income_2015 IS NOT NULL
)
ORDER BY (income_2018 - income_2015) DESC
LIMIT 1;
```
