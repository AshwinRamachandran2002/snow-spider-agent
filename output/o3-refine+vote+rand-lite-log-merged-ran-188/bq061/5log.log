LIMIT 20;
```

```sql
--Description: 2) View a few California tracts’ median-income values in 2015  
SELECT `geo_id`, `do_date`, `median_income`
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE LEFT(`geo_id`,2)='06' 
  AND `do_date`='2015-01-01'
LIMIT 20;
```

```sql
--Description: 3) View the same tracts’ values in 2018  
SELECT `geo_id`, `do_date`, `median_income`
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE LEFT(`geo_id`,2)='06' 
  AND `do_date`='2018-01-01'
LIMIT 20;
```

```sql
--Description: 4) Check how many California tract rows exist in each of the two target years  
SELECT EXTRACT(YEAR FROM `do_date`) AS yr,
       COUNT(*) AS rows_ct
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE LEFT(`geo_id`,2)='06'
  AND `do_date` IN ('2015-01-01','2018-01-01')
GROUP BY yr
ORDER BY yr
LIMIT 20;
```

```sql
--Description: 5) Produce 2015 and 2018 median-income side-by-side for every CA tract  
SELECT  `geo_id`,
        MAX(CASE WHEN `do_date`='2015-01-01' THEN `median_income` END) AS inc_2015,
        MAX(CASE WHEN `do_date`='2018-01-01' THEN `median_income` END) AS inc_2018
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE LEFT(`geo_id`,2)='06'
  AND `do_date` IN ('2015-01-01','2018-01-01')
GROUP BY `geo_id`
LIMIT 20;
```

```sql
--Description: 6) Calculate income increase (2018-2015) for each CA tract  
SELECT  `geo_id`,
        inc_2018 - inc_2015 AS inc_diff
FROM (
  SELECT  `geo_id`,
          MAX(CASE WHEN `do_date`='2015-01-01' THEN `median_income` END) AS inc_2015,
          MAX(CASE WHEN `do_date`='2018-01-01' THEN `median_income` END) AS inc_2018
  FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
  WHERE LEFT(`geo_id`,2)='06'
    AND `do_date` IN ('2015-01-01','2018-01-01')
  GROUP BY `geo_id`
) 
WHERE inc_2015 IS NOT NULL AND inc_2018 IS NOT NULL
LIMIT 20;
```

```sql
--Description: 7) Order all CA tracts by largest increase and preview the top results  
SELECT  `geo_id`,
        inc_2018 - inc_2015 AS inc_diff
FROM (
  SELECT  `geo_id`,
          MAX(CASE WHEN `do_date`='2015-01-01' THEN `median_income` END) AS inc_2015,
          MAX(CASE WHEN `do_date`='2018-01-01' THEN `median_income` END) AS inc_2018
  FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
  WHERE LEFT(`geo_id`,2)='06'
    AND `do_date` IN ('2015-01-01','2018-01-01')
  GROUP BY `geo_id`
) 
WHERE inc_2015 IS NOT NULL AND inc_2018 IS NOT NULL
ORDER BY inc_diff DESC
LIMIT 20;
```

```sql
--Description: 8) Confirm that there are no ties at the top (see first few rows)  
SELECT inc_diff, COUNT(*) AS tracts_with_same_diff
FROM (
  SELECT  `geo_id`,
          inc_2018 - inc_2015 AS inc_diff
  FROM (
    SELECT  `geo_id`,
            MAX(CASE WHEN `do_date`='2015-01-01' THEN `median_income` END) AS inc_2015,
            MAX(CASE WHEN `do_date`='2018-01-01' THEN `median_income` END) AS inc_2018
    FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
    WHERE LEFT(`geo_id`,2)='06'
      AND `do_date` IN ('2015-01-01','2018-01-01')
    GROUP BY `geo_id`
  ) 
  WHERE inc_2015 IS NOT NULL AND inc_2018 IS NOT NULL
)
GROUP BY inc_diff
ORDER BY inc_diff DESC
LIMIT 20;
```

```sql
--Description: 9) Retrieve only the single tract code with the maximum increase  
SELECT  `geo_id`
FROM (
  SELECT  `geo_id`,
          inc_2018 - inc_2015 AS inc_diff,
          RANK() OVER (ORDER BY inc_2018 - inc_2015 DESC) AS rnk
  FROM (
    SELECT  `geo_id`,
            MAX(CASE WHEN `do_date`='2015-01-01' THEN `median_income` END) AS inc_2015,
            MAX(CASE WHEN `do_date`='2018-01-01' THEN `median_income` END) AS inc_2018
    FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
    WHERE LEFT(`geo_id`,2)='06'
      AND `do_date` IN ('2015-01-01','2018-01-01')
    GROUP BY `geo_id`
  ) 
  WHERE inc_2015 IS NOT NULL AND inc_2018 IS NOT NULL
)
WHERE rnk = 1
LIMIT 20;
```

```sql
--Description: 10) FINAL – show tract, 2015 income, 2018 income, and increase for the biggest gainer in California  
SELECT  `geo_id`,
        inc_2015,
        inc_2018,
        inc_2018 - inc_2015 AS inc_diff
FROM (
  SELECT  `geo_id`,
          MAX(CASE WHEN `do_date`='2015-01-01' THEN `median_income` END) AS inc_2015,
          MAX(CASE WHEN `do_date`='2018-01-01' THEN `median_income` END) AS inc_2018,
          RANK() OVER (ORDER BY MAX(CASE WHEN `do_date`='2018-01-01' THEN `median_income` END) -
                                   MAX(CASE WHEN `do_date`='2015-01-01' THEN `median_income` END) DESC) AS rnk
  FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
  WHERE LEFT(`geo_id`,2)='06'
    AND `do_date` IN ('2015-01-01','2018-01-01')
  GROUP BY `geo_id`
)
WHERE rnk = 1
LIMIT 20;
```

The tract code appearing in queries 9 & 10—the one ranked #1—will be the California census tract that experienced the largest median-income increase between 2015 and 2018.
