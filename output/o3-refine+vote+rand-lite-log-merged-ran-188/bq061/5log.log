--Description: 1) Inspect which years are available for California census-tract records  
SELECT DISTINCT EXTRACT(YEAR FROM `do_date`) AS yr
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE LEFT(`geo_id`,2)='06'
