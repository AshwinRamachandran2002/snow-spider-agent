```sql
-- 5. Build the 2015 income table for every California tract
SELECT geo_id, median_income AS income_2015
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE do_date = DATE '2015-01-01'
  AND geo_id LIKE '06%'
LIMIT 20;
```

```sql
-- 6. Build the 2018 income table for every California tract
SELECT geo_id, median_income AS income_2018
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE do_date = DATE '2018-01-01'
  AND geo_id LIKE '06%'
LIMIT 20;
```

```sql
-- 7. Join 2015 & 2018 tables and compute the income change
SELECT t2018.geo_id,
       t2015.income_2015,
       t2018.income_2018,
       (t2018.income_2018 - t2015.income_2015) AS income_change
FROM (
    SELECT geo_id, median_income AS income_2018
    FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
    WHERE do_date = DATE '2018-01-01'
      AND geo_id LIKE '06%'
) AS t2018
JOIN (
    SELECT geo_id, median_income AS income_2015
    FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
    WHERE do_date = DATE '2015-01-01'
      AND geo_id LIKE '06%'
) AS t2015
USING (geo_id)
LIMIT 20;
```

```sql
-- 8. Order every California tract by the size of the increase
SELECT geo_id,
       income_2015,
       income_2018,
       income_change
FROM (
    SELECT t2018.geo_id,
           t2015.income_2015,
           t2018.income_2018,
           (t2018.income_2018 - t2015.income_2015) AS income_change
    FROM (
        SELECT geo_id, median_income AS income_2018
        FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
        WHERE do_date = DATE '2018-01-01'
          AND geo_id LIKE '06%'
    ) AS t2018
    JOIN (
        SELECT geo_id, median_income AS income_2015
        FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
        WHERE do_date = DATE '2015-01-01'
          AND geo_id LIKE '06%'
    ) AS t2015
    USING (geo_id)
) 
ORDER BY income_change DESC
LIMIT 20;
```

```sql
-- 9. Return only the tract with the single largest jump in median income
SELECT geo_id
FROM (
    SELECT geo_id,
           (income_2018 - income_2015) AS income_change,
           ROW_NUMBER() OVER (ORDER BY (income_2018 - income_2015) DESC) AS rn
    FROM (
        SELECT t2018.geo_id,
               t2015.income_2015,
               t2018.income_2018
        FROM (
            SELECT geo_id, median_income AS income_2018
            FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
            WHERE do_date = DATE '2018-01-01'
              AND geo_id LIKE '06%'
        ) AS t2018
        JOIN (
            SELECT geo_id, median_income AS income_2015
            FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
            WHERE do_date = DATE '2015-01-01'
              AND geo_id LIKE '06%'
        ) AS t2015
        USING (geo_id)
    )
)
WHERE rn = 1
LIMIT 20;
```

```sql
-- 10. (Optional) verify the exact amounts for that winner tract
WITH winner AS (
  SELECT geo_id
  FROM (
      SELECT geo_id,
             (income_2018 - income_2015) AS income_change,
             ROW_NUMBER() OVER (ORDER BY (income_2018 - income_2015) DESC) AS rn
      FROM (
          SELECT t2018.geo_id,
                 t2015.income_2015,
                 t2018.income_2018
          FROM (
              SELECT geo_id, median_income AS income_2018
              FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
              WHERE do_date = DATE '2018-01-01'
                AND geo_id LIKE '06%'
          ) AS t2018
          JOIN (
              SELECT geo_id, median_income AS income_2015
              FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
              WHERE do_date = DATE '2015-01-01'
                AND geo_id LIKE '06%'
          ) AS t2015
          USING (geo_id)
      )
  )
  WHERE rn = 1
)
SELECT c.geo_id, c.do_date, c.median_income
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS c
JOIN winner USING (geo_id)
WHERE c.do_date IN (DATE '2015-01-01', DATE '2018-01-01')
ORDER BY c.do_date
LIMIT 20;
```

