  FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`, dates
  WHERE do_date = dates.start_d
    AND geo_id LIKE '06%'
),
fin AS (
  SELECT geo_id, median_income AS income_end
  FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`, dates
  WHERE do_date = dates.end_d
    AND geo_id LIKE '06%'
),
diffs AS (
  SELECT fin.geo_id,
         (fin.income_end - start.income_start) AS income_change,
         ROW_NUMBER() OVER (ORDER BY (fin.income_end - start.income_start) DESC) AS rn
  FROM fin
  JOIN start USING (geo_id)
)
SELECT geo_id
FROM diffs
WHERE rn = 1
LIMIT 20;
