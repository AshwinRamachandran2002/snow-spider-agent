--Description: 10. Verify exact amounts for the winning tract using the dynamic start & end dates.  
WITH dates AS (
  SELECT MIN(do_date) AS start_d, MAX(do_date) AS end_d
  FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
  WHERE geo_id LIKE '06%'
),
start AS (
  SELECT geo_id, median_income AS income_start
  FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`, dates
  WHERE do_date = dates.start_d
    AND geo_id LIKE '06%'
),
fin AS (
  SELECT geo_id, median_income AS income_end
  FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`, dates
  WHERE do_date = dates.end_d
    AND geo_id LIKE '06%'
),
winner AS (
  SELECT fin.geo_id
  FROM fin
  JOIN start USING (geo_id)
  ORDER BY (fin.income_end - start.income_start) DESC
  LIMIT 1
)
SELECT c.geo_id, c.do_date, c.median_income
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS c
JOIN winner USING (geo_id)
JOIN dates
WHERE c.do_date IN (dates.start_d, dates.end_d)
ORDER BY c.do_date
LIMIT 20;
```
