  FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`, dates
  WHERE do_date = dates.end_d
    AND geo_id LIKE '06%'
)
SELECT t_end.geo_id,
       t_start.income_start,
       t_end.income_end,
       (t_end.income_end - t_start.income_start) AS income_change
FROM t_end
JOIN t_start USING (geo_id)
