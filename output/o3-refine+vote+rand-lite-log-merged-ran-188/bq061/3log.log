-- Which California census tract showed the largest jump in median income between 2015 and 2018?
WITH pivot AS (
  SELECT
    geo_id,
    MAX(CASE WHEN do_date = DATE '2015-01-01' THEN median_income END) AS income_2015,
    MAX(CASE WHEN do_date = DATE '2018-01-01' THEN median_income END) AS income_2018
  FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
  WHERE geo_id LIKE '06%'                                   -- California tracts
    AND do_date IN (DATE '2015-01-01', DATE '2018-01-01')   -- keep only needed years
  GROUP BY geo_id
),
changes AS (
  SELECT
    geo_id,
    income_2018 - income_2015 AS income_change
  FROM pivot
  WHERE income_2015 IS NOT NULL
    AND income_2018 IS NOT NULL
)
SELECT geo_id
FROM changes
ORDER BY income_change DESC
LIMIT 1;
```
