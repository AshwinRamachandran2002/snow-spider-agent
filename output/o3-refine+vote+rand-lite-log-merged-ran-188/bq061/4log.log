```sql
-- California census tract with the largest median-income increase between 2015 and 2018
SELECT
  geo_id AS tract_code
FROM
  `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE
  geo_id LIKE '06%'                         -- California FIPS prefix
  AND do_date IN ('2015-01-01', '2018-01-01')   -- years of interest
GROUP BY
  geo_id
HAVING
  COUNT(DISTINCT do_date) = 2               -- ensure both years are present
ORDER BY
  MAX(CASE WHEN do_date = '2018-01-01' THEN median_income END) -
  MAX(CASE WHEN do_date = '2015-01-01' THEN median_income END) DESC
LIMIT 1;
