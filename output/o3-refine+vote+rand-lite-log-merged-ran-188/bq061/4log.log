```sql
-- Tract in California with the largest median-income increase between the
-- 2015 and 2018 ACS 5-year releases
WITH ca_tracts AS (
  SELECT
    geo_id,
    CASE _TABLE_SUFFIX
      WHEN '2015_5yr' THEN 2015
      WHEN '2018_5yr' THEN 2018
    END AS yr,
    median_income
  FROM `bigquery-public-data.census_bureau_acs.censustract_*_5yr`
  WHERE _TABLE_SUFFIX IN ('2015_5yr', '2018_5yr')   -- desired releases
    AND geo_id LIKE '06%'                           -- California FIPS
),

paired AS (
  SELECT
    geo_id,
    MAX(CASE WHEN yr = 2015 THEN median_income END) AS income_2015,
    MAX(CASE WHEN yr = 2018 THEN median_income END) AS income_2018
  FROM ca_tracts
  GROUP BY geo_id
  HAVING income_2015 IS NOT NULL
     AND income_2018 IS NOT NULL                    -- keep tracts with both years
)

SELECT
  geo_id AS tract_code
FROM paired
ORDER BY (income_2018 - income_2015) DESC
LIMIT 1;
```
