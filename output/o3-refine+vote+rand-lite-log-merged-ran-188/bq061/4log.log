```sql
--Description: Compute the 2015 vs. 2018 income difference for each California tract (first 20 rows, unsorted).
SELECT
  `geo_id`,
  MAX(CASE WHEN `do_date` = '2018-01-01' THEN `median_income` END) AS income_2018,
  MAX(CASE WHEN `do_date` = '2015-01-01' THEN `median_income` END) AS income_2015,
  MAX(CASE WHEN `do_date` = '2018-01-01' THEN `median_income` END) -
  MAX(CASE WHEN `do_date` = '2015-01-01' THEN `median_income` END) AS diff_2018_2015
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE `geo_id` LIKE '06%'
GROUP BY `geo_id`
LIMIT 20;
```

```sql
--Description: Same as above, but order by the largest increases and show top 20.
SELECT
  `geo_id`,
  MAX(CASE WHEN `do_date` = '2018-01-01' THEN `median_income` END) AS income_2018,
  MAX(CASE WHEN `do_date` = '2015-01-01' THEN `median_income` END) AS income_2015,
  MAX(CASE WHEN `do_date` = '2018-01-01' THEN `median_income` END) -
  MAX(CASE WHEN `do_date` = '2015-01-01' THEN `median_income` END) AS diff_2018_2015
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE `geo_id` LIKE '06%'
GROUP BY `geo_id`
ORDER BY diff_2018_2015 DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – return the California census tract with the single largest 2015→2018 median-income increase (tract code only).
SELECT
  `geo_id` AS tract_code
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE `geo_id` LIKE '06%'
GROUP BY `geo_id`
HAVING
  MAX(CASE WHEN `do_date` = '2018-01-01' THEN `median_income` END) IS NOT NULL
  AND MAX(CASE WHEN `do_date` = '2015-01-01' THEN `median_income` END) IS NOT NULL
ORDER BY
  MAX(CASE WHEN `do_date` = '2018-01-01' THEN `median_income` END) -
  MAX(CASE WHEN `do_date` = '2015-01-01' THEN `median_income` END) DESC
LIMIT 1;
```

