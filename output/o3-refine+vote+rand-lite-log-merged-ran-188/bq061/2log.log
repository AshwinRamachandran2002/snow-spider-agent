       `median_income` AS median_2015
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE LEFT(`geo_id`,2) = '06'
  AND `do_date` = '2015-01-01'
LIMIT 20;
```

```sql
--Description: 4) Get 2018 median income for every California tract  
SELECT `geo_id`,
       `median_income` AS median_2018
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE LEFT(`geo_id`,2) = '06'
  AND `do_date` = '2018-01-01'
LIMIT 20;
```

```sql
--Description: 5) Join 2015 and 2018 data for California tracts to compute the change  
SELECT a.`geo_id`,
       a.median_2015,
       b.median_2018,
       (b.median_2018 - a.median_2015) AS income_change
FROM (
      SELECT `geo_id`, `median_income` AS median_2015
      FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
      WHERE LEFT(`geo_id`,2) = '06' AND `do_date` = '2015-01-01'
     ) AS a
JOIN (
      SELECT `geo_id`, `median_income` AS median_2018
      FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
      WHERE LEFT(`geo_id`,2) = '06' AND `do_date` = '2018-01-01'
     ) AS b
USING (`geo_id`)
LIMIT 20;
```

```sql
--Description: 6) Order California tracts by the size of the increase (largest first)  
SELECT a.`geo_id`,
       a.median_2015,
       b.median_2018,
       (b.median_2018 - a.median_2015) AS income_change
FROM (
      SELECT `geo_id`, `median_income` AS median_2015
      FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
      WHERE LEFT(`geo_id`,2) = '06' AND `do_date` = '2015-01-01'
     ) AS a
JOIN (
      SELECT `geo_id`, `median_income` AS median_2018
      FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
      WHERE LEFT(`geo_id`,2) = '06' AND `do_date` = '2018-01-01'
     ) AS b
USING (`geo_id`)
ORDER BY income_change DESC
LIMIT 20;
```

```sql
--Description: 7) Same as above but remove tracts that have NULL values in either year  
SELECT a.`geo_id`,
       a.median_2015,
       b.median_2018,
       (b.median_2018 - a.median_2015) AS income_change
FROM (
      SELECT `geo_id`, `median_income` AS median_2015
      FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
      WHERE LEFT(`geo_id`,2) = '06'
        AND `do_date` = '2015-01-01'
        AND `median_income` IS NOT NULL
     ) AS a
JOIN (
      SELECT `geo_id`, `median_income` AS median_2018
      FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
      WHERE LEFT(`geo_id`,2) = '06'
        AND `do_date` = '2018-01-01'
        AND `median_income` IS NOT NULL
     ) AS b
USING (`geo_id`)
ORDER BY income_change DESC
LIMIT 20;
```

```sql
--Description: 8) FINAL – Return the single California census-tract code with the largest increase in median income from 2015 to 2018  
SELECT a.`geo_id`   -- ← this is the tract code with the biggest rise
FROM (
      SELECT `geo_id`, `median_income` AS median_2015
      FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
      WHERE LEFT(`geo_id`,2) = '06'
        AND `do_date` = '2015-01-01'
        AND `median_income` IS NOT NULL
     ) AS a
JOIN (
      SELECT `geo_id`, `median_income` AS median_2018
      FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
      WHERE LEFT(`geo_id`,2) = '06'
        AND `do_date` = '2018-01-01'
        AND `median_income` IS NOT NULL
     ) AS b
USING (`geo_id`)
ORDER BY (b.median_2018 - a.median_2015) DESC
LIMIT 1;
```
