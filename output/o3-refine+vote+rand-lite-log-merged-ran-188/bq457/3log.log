Query:
-- 4)  Distinct feature–toggle artefacts found in repository manifests
SELECT DISTINCT
  dependency_project_name
FROM `bigquery-public-data.libraries_io.repository_dependencies`
WHERE LOWER(dependency_project_name) IN (
  'ldclient-js','ldclient-node','ldclient-py',
  'unleash-client','unleash-client-node',
  'featuretoggle','featureswitcher',
  'flipper','togglz-core'
)
LIMIT 20;
