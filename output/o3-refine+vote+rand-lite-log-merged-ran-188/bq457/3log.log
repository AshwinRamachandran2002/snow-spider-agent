dependency_project_name
FeatureSwitcher
ldclient-js
flipper
FeatureToggle
ldclient-node
Query:
-- 5)  How many different repositories use at least one of those artefacts?
SELECT COUNT(DISTINCT repository_id) AS repo_count
FROM `bigquery-public-data.libraries_io.repository_dependencies`
WHERE LOWER(dependency_project_name) IN (
  'ldclient-js','ldclient-node','ldclient-py',
  'unleash-client','unleash-client-node',
  'featuretoggle','featureswitcher',
  'flipper','togglz-core'
)
LIMIT 20;
Answer:
repo_count
23
Query:
--Description:
-- 7) Repository details for a broader set of feature-toggle artefacts.
--    Re-implemented with a LEFT JOIN that links the two tables on the textual
--    key `repository_name_with_owner` (instead of `repository_id`) so that rows
--    are returned even when the numeric id is missing or mismatched.
SELECT
  rd.repository_name_with_owner                   AS name_with_owner,
  COALESCE(r.host_type, rd.host_type)             AS host_type,
  r.size * 1024                                   AS size_bytes,
  r.language,
  r.fork_source_name_with_owner,
  r.updated_timestamp,
  rd.dependency_project_name
FROM `bigquery-public-data.libraries_io.repository_dependencies` rd
LEFT JOIN `bigquery-public-data.libraries_io.repositories` r
       ON rd.repository_name_with_owner = r.name_with_owner
WHERE LOWER(rd.dependency_project_name) IN (
        'ldclient-js', 'ldclient-node',
        'unleash-client', 'featuretoggle',
        'flipper'
      )
LIMIT 20
