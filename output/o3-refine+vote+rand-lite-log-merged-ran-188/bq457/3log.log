-- 3)  Repositories whose manifests refer to any LaunchDarkly package
SELECT DISTINCT
  dependency_project_name,
  manifest_platform,
  repository_name_with_owner
FROM `bigquery-public-data.libraries_io.repository_dependencies`
WHERE LOWER(dependency_project_name) LIKE '%launchdarkly%'
LIMIT 20;
