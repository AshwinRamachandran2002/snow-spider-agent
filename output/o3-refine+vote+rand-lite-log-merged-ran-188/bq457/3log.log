```sql
--Description:
-- FINAL, consolidated query that lists repositories which depend on any
-- selected feature-toggle libraries.  Reasoning steps:
--   1.  Start with `repository_dependencies`, because that table tells us
--       which artefact each repository declares.
--   2.  Many rows have a NULL / unmapped `repository_id`, so we join to the
--       `repositories` table via the safer textual key
--       `repository_name_with_owner`.
--   3.  We create an in-memory list (`libs`) of artefact identifiers together
--       with the library name and its implementation languages.  Each STRUCT
--       explicitly names its fields, which avoids the BigQuery alias syntax
--       error encountered earlier.
--   4.  We join `libs` to the dependency rows using a LIKE predicate so that
--       artefacts embedded inside Maven coordinates (e.g. “org.togglz:togglz-core”)
--       still match.
--   5.  For every matching repository we output: repository full name, host
--       type, size (converted from KiB to bytes), primary language, fork
--       source (if any), last update timestamp, plus the artefact and
--       library details from `libs`.
--   6.  LIMIT 20 gives a quick, inspectable sample.
SELECT
  rd.repository_name_with_owner                         AS name_with_owner,
  COALESCE(r.host_type, rd.host_type)                   AS host_type,
  r.size * 1024                                         AS size_bytes,
  r.language                                            AS primary_language,
  r.fork_source_name_with_owner,
  r.updated_timestamp                                   AS repository_last_update,
  libs.artifact                                         AS dependency_artifact,
  libs.library                                          AS feature_toggle_library,
  libs.languages                                        AS library_languages
FROM `bigquery-public-data.libraries_io.repository_dependencies` rd
LEFT JOIN `bigquery-public-data.libraries_io.repositories` r
       ON rd.repository_name_with_owner = r.name_with_owner
JOIN UNNEST([
  STRUCT('LaunchDarkly'    AS library, 'ldclient-js'          AS artifact, 'JavaScript, TypeScript' AS languages),
  STRUCT('LaunchDarkly'    AS library, 'ldclient-node'        AS artifact, 'JavaScript, TypeScript' AS languages),
  STRUCT('LaunchDarkly'    AS library, 'ldclient-py'          AS artifact, 'Python'                 AS languages),
  STRUCT('Unleash'         AS library, 'unleash-client'       AS artifact, 'JavaScript, TypeScript' AS languages),
  STRUCT('Unleash'         AS library, 'unleash-client-node'  AS artifact, 'JavaScript, TypeScript' AS languages),
  STRUCT('FeatureToggle'   AS library, 'featuretoggle'        AS artifact, 'C#, Visual Basic'       AS languages),
  STRUCT('FeatureSwitcher' AS library, 'featureswitcher'      AS artifact, 'C#, Visual Basic'       AS languages),
  STRUCT('Flipper'         AS library, 'flipper'              AS artifact, 'Ruby'                   AS languages),
  STRUCT('Togglz'          AS library, 'togglz-core'          AS artifact, 'Kotlin, Java'           AS languages)
]) AS libs
  ON LOWER(rd.dependency_project_name) LIKE CONCAT('%', LOWER(libs.artifact), '%')
LIMIT 20;
