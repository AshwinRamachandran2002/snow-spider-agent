```sql
--Description: Core query – repository details together with the feature-toggle artefact & its language  
SELECT
  r.name_with_owner,
  r.host_type,
  r.size * 1024                         AS size_bytes,      -- KB → bytes
  r.language                            AS repo_language,
  r.fork_source_name_with_owner,
  r.updated_timestamp,
  p.name                                AS artefact_name,
  CASE
    WHEN LOWER(p.name) LIKE '%unleash%'      THEN 'Unleash'
    WHEN LOWER(p.name) LIKE '%launchdarkly%' THEN 'LaunchDarkly'
    WHEN LOWER(p.name) LIKE '%togglz%'       THEN 'Togglz'
    WHEN LOWER(p.name) LIKE '%flipper%'      THEN 'Flipper'
    WHEN LOWER(p.name) LIKE '%ff4j%'         THEN 'FF4J'
    ELSE p.name
  END                                       AS library_name,
  p.language                                AS library_languages
FROM `bigquery-public-data.libraries_io.repository_dependencies` AS d
JOIN `bigquery-public-data.libraries_io.projects`                AS p
  ON d.dependency_project_id = p.id
JOIN `bigquery-public-data.libraries_io.repositories`            AS r
  ON d.repository_id = r.id
WHERE LOWER(p.name) IN ('unleash-client', 'unleash', 'unleash-client-dotnet',
                        'unleash-client-node', 'unleash-client-java',
                        'unleash-client-go', 'launchdarkly', 'ldclient-js',
                        'ldclient-node', 'launchdarkly-client', 'ldclient-py',
                        'togglz-core', 'flipper', 'ff4j-core')
LIMIT 20;
```

```sql
--Description: Distinct package-manager platforms & languages for the chosen libraries  
SELECT DISTINCT
  p.platform,
  p.language,
  p.name
FROM `bigquery-public-data.libraries_io.projects` p
WHERE LOWER(p.name) IN ('unleash-client', 'unleash',
                        'launchdarkly', 'togglz-core',
                        'flipper', 'ff4j-core')
LIMIT 20;
```

```sql
--Description: Number of dependent repositories per hosting service for the selected libraries  
SELECT
  r.host_type,
  COUNT(DISTINCT r.id) AS repo_cnt
FROM `bigquery-public-data.libraries_io.repository_dependencies` AS d
JOIN `bigquery-public-data.libraries_io.projects`                AS p
  ON d.dependency_project_id = p.id
JOIN `bigquery-public-data.libraries_io.repositories`            AS r
  ON d.repository_id = r.id
WHERE LOWER(p.name) IN ('unleash-client', 'unleash',
                        'launchdarkly', 'togglz-core',
                        'flipper', 'ff4j-core')
GROUP BY r.host_type
LIMIT 20;
```
