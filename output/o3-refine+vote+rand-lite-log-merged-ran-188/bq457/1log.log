Query:
--Description: Core query – repository details plus the feature-toggle artefact & its language
SELECT
  COALESCE(r.name_with_owner, d.repository_name_with_owner) AS name_with_owner,
  d.host_type,
  r.size * 1024                       AS size_bytes,     -- KB → bytes (NULL if r absent)
  r.language                          AS repo_language,
  r.fork_source_name_with_owner,
  r.updated_timestamp,
  p.name                              AS artefact_name,
  CASE
    WHEN LOWER(p.name) LIKE '%unleash%'      THEN 'Unleash'
    WHEN LOWER(p.name) LIKE '%launchdarkly%' THEN 'LaunchDarkly'
    WHEN LOWER(p.name) LIKE '%togglz%'       THEN 'Togglz'
    WHEN LOWER(p.name) LIKE '%flipper%'      THEN 'Flipper'
    WHEN LOWER(p.name) LIKE '%ff4j%'         THEN 'FF4J'
    ELSE p.name
  END                                     AS library_name,
  p.language                             AS library_languages
FROM `bigquery-public-data.libraries_io.repository_dependencies` AS d
JOIN `bigquery-public-data.libraries_io.projects`                AS p
  ON d.dependency_project_id = p.id
LEFT JOIN `bigquery-public-data.libraries_io.repositories`       AS r
  ON d.repository_id = r.id
WHERE LOWER(p.name) IN ('unleash-client', 'unleash', 'unleash-client-dotnet',
                        'unleash-client-node', 'unleash-client-java',
                        'unleash-client-go', 'launchdarkly', 'ldclient-js',
                        'ldclient-node', 'launchdarkly-client', 'ldclient-py',
                        'togglz-core', 'flipper', 'ff4j-core')
LIMIT 20
Answer:
name_with_owner,host_type,size_bytes,repo_language,fork_source_name_with_owner,updated_timestamp,artefact_name,library_name,library_languages
yusinto/launchdarkly-meetup-example,GitHub,,,,,ldclient-js,ldclient-js,JavaScript
spinecone/feature-flap,GitHub,,,,,flipper,Flipper,Ruby
