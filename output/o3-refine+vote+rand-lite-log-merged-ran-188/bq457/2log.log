feature_projects AS (
  /* Map the catalogue rows to real Libraries.io project IDs */
  SELECT
    f.platform,
    f.artifact_name,
    f.library_name,
    f.library_languages,
    p.id AS project_id
  FROM feature_toggle_libs AS f
  JOIN `bigquery-public-data.libraries_io.projects` AS p
    ON p.platform = f.platform
   AND p.name     = f.artifact_name
)

SELECT DISTINCT
  r.name_with_owner             AS repository_full_name,
  r.host_type                   AS repository_host_type,
  r.size * 1024                 AS repository_size_bytes,   -- size stored in KiB → bytes
  r.language                    AS repository_primary_language,
  r.fork_source_name_with_owner AS fork_source_name_with_owner,
  r.updated_timestamp           AS repository_last_update_timestamp,
  fp.artifact_name              AS feature_toggle_artifact,
  fp.library_name               AS feature_toggle_library,
  fp.library_languages          AS feature_toggle_library_languages
FROM `bigquery-public-data.libraries_io.repository_dependencies` AS rd
JOIN feature_projects AS fp
  ON rd.dependency_project_id = fp.project_id
JOIN `bigquery-public-data.libraries_io.repositories` AS r
  ON r.id = rd.repository_id
ORDER BY repository_full_name,
         feature_toggle_artifact;
