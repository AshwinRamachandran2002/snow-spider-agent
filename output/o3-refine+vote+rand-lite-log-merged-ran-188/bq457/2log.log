Query:
-- Description: ①  Look at some dependency names that obviously belong to feature-toggle
--               libraries.  This helps to understand the spelling that appears
--               in `repository_dependencies.dependency_project_name`.
SELECT DISTINCT dependency_project_name
FROM   `bigquery-public-data.libraries_io.repository_dependencies`
WHERE  LOWER(dependency_project_name) LIKE '%unleash%'
   OR  LOWER(dependency_project_name) LIKE '%launchdarkly%'
   OR  LOWER(dependency_project_name) LIKE '%toggl%'
   OR  LOWER(dependency_project_name) LIKE '%feature%'
LIMIT  20;
