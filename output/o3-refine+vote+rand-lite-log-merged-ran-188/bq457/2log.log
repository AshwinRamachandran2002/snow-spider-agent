Query:
-- Description: ②  See which package-manager “platforms” those dependency projects
--               belong to, using the project table that owns every project id.
SELECT DISTINCT p.platform,
       p.name                AS project_name,
       p.language            AS project_language
FROM   `bigquery-public-data.libraries_io.projects`               AS p
JOIN   `bigquery-public-data.libraries_io.repository_dependencies` AS rd
       ON rd.dependency_project_id = p.id
WHERE  rd.dependency_project_name IN (
          'unleash-client', 'unleash', 'unleash-client-node',
          'ldclient-js', 'ldclient-node', 'gutter',
          'flipper', 'togglz-core', 'ff4j-core',
          'featuretoggle', 'FeatureToggle', 'FeatureSwitcher'
       )
LIMIT  20;
