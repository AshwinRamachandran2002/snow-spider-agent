```sql
-- Description: ⑦  Example filtering only GitHub repos, and ensuring the manifest
--               actually comes from an npm lockfile (manifest_kind = 'lockfile').
SELECT DISTINCT r.name_with_owner,
       r.size,
       r.language,
       rd.manifest_platform,
       rd.manifest_kind,
       rd.manifest_filepath,
       p.name      AS feature_toggle_library
FROM   `bigquery-public-data.libraries_io.repositories`            AS r
JOIN   `bigquery-public-data.libraries_io.repository_dependencies` AS rd
       ON rd.repository_id = r.id
JOIN   `bigquery-public-data.libraries_io.projects`                AS p
       ON p.id = rd.dependency_project_id
WHERE  r.host_type = 'GitHub'
  AND  rd.manifest_kind = 'lockfile'
  AND  p.name IN ('ldclient-js', 'feature-toggles', 'fflip')
LIMIT  20;
```

