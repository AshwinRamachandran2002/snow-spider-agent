```sql
--Description: Final answer table — confirmed cases on 20-Apr-2020 and incidence
--             per 100 000 people, using World-Bank 2019 population as proxy.
--             Steps:
--               1. Aggregate JHU confirmed counts.
--               2. Join to population_by_country with name harmonisation
--                  (“US”→“United States”, “Iran”→“Iran, Islamic Rep.”).
--               3. Compute cases per 100 000 and list alphabetically.
WITH cases AS (
  SELECT
    country_region,
    SUM(confirmed) AS total_confirmed
  FROM `bigquery-public-data.covid19_jhu_csse.summary`
  WHERE date = '2020-04-20'
    AND country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country_region
)
SELECT
  pb.country                                   AS country,
  c.total_confirmed,
  SAFE_CAST(pb.year_2019 AS INT64)             AS population_2019,
  ROUND(100000 * c.total_confirmed
        / SAFE_CAST(pb.year_2019 AS INT64), 2) AS cases_per_100k
FROM cases AS c
JOIN `bigquery-public-data.world_bank_global_population.population_by_country` AS pb
  ON pb.country = CASE
                    WHEN c.country_region = 'US'   THEN 'United States'
                    WHEN c.country_region = 'Iran' THEN 'Iran, Islamic Rep.'
                    ELSE c.country_region
                  END
ORDER BY country;
