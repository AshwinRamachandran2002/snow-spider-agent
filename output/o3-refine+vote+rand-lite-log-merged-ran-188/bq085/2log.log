```sql
--Description: Combine confirmed cases with 2020 population to compute cases per 100,000  
WITH cases AS (
  SELECT country_region AS summary_country,
         SUM(confirmed) AS total_confirmed
  FROM   `bigquery-public-data.covid19_jhu_csse.summary`
  WHERE  date = '2020-04-20'
    AND  country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
  GROUP BY summary_country
),
pop AS (
  SELECT country_name AS pop_country,
         SUM(value) AS population_2020
  FROM   `bigquery-public-data.world_bank_health_population.health_nutrition_population`
  WHERE  year = 2020
    AND  indicator_name = 'Population, total'
    AND  country_name IN ('United States','France','China','Italy','Spain','Germany','Iran')
  GROUP BY pop_country
),
xwalk AS (
  SELECT 'US'      AS summary_country, 'United States' AS pop_country UNION ALL
  SELECT 'France', 'France'        UNION ALL
  SELECT 'China',  'China'         UNION ALL
  SELECT 'Italy',  'Italy'         UNION ALL
  SELECT 'Spain',  'Spain'         UNION ALL
  SELECT 'Germany','Germany'       UNION ALL
  SELECT 'Iran',   'Iran'
)
SELECT x.pop_country                     AS country,
       c.total_confirmed,
       p.population_2020,
       ROUND(100000 * c.total_confirmed / p.population_2020, 2) AS cases_per_100k
FROM   xwalk AS x
JOIN   cases AS c ON c.summary_country = x.summary_country
JOIN   pop   AS p ON p.pop_country     = x.pop_country
ORDER  BY cases_per_100k DESC
LIMIT 20;
