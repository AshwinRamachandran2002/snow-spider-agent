-- 1. Johns-Hopkins table (covid19_jhu_csse.summary) holds province-level rows; we
--    SUM(confirmed) for each target nation on 2020-04-20.
-- 2. World-Bank population table (world_bank_global_population.population_by_country)
--    stores annual population in columns named year_####.  Inspection shows
--    `year_2019` is the latest reliable column, so we use it as a 2020 proxy.
-- 3. Country names differ: JHU uses “US” and “Iran”, whereas World-Bank uses
--    “United States” and “Iran, Islamic Rep.”.  A CASE expression harmonises them.
-- 4. Convert the population string to INT64, compute cases per 100 000 people,
--    and order by that rate.

SELECT
  pb.country                                   AS country,
  c.total_confirmed,
  SAFE_CAST(pb.year_2019 AS INT64)             AS population_2019,
  ROUND(100000 * c.total_confirmed
        / SAFE_CAST(pb.year_2019 AS INT64), 2) AS cases_per_100k
FROM (
  /* Step-1: aggregate confirmed cases on 20-Apr-2020 */
  SELECT
    country_region,
    SUM(confirmed) AS total_confirmed
  FROM `bigquery-public-data.covid19_jhu_csse.summary`
  WHERE date = '2020-04-20'
    AND country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country_region
) AS c
/* Step-2: join to population data with name alignment */
JOIN `bigquery-public-data.world_bank_global_population.population_by_country` AS pb
  ON pb.country = CASE
                    WHEN c.country_region = 'US'   THEN 'United States'
                    WHEN c.country_region = 'Iran' THEN 'Iran, Islamic Rep.'
                    ELSE c.country_region
                  END
ORDER BY cases_per_100k DESC;
