```sql
--Description:
-- One–stop query to deliver, for 20-Apr-2020, each of the seven requested
-- countries’ (United States, France, China, Italy, Spain, Germany, Iran)
--  • total confirmed COVID-19 cases (JHU “summary” table)
--  • 2020 population (World-Bank “population_by_country” table)
--  • cases per 100 000 people
--
-- Embedded thinking:
--  1. The JHU table stores many province-level rows; we therefore SUM(confirmed)
--     per country_region for the required date.
--  2. Country names do not always match between data sets:
--        JHU ‘US’  → WB ‘United States’
--        JHU ‘Iran’→ WB ‘Iran, Islamic Rep.’
--     We harmonise them with a CASE expression while joining.
--  3. World-Bank populations are in columns named year_####; we need year_2020.
--  4. Population values are strings, so we SAFE_CAST to INT64.
--  5. Compute the rate (cases / population * 100 000) and present results.
SELECT
  pb.country                                         AS country,
  c.total_confirmed,
  SAFE_CAST(pb.`year_2020` AS INT64)                AS population_2020,
  ROUND(100000 * c.total_confirmed
        / SAFE_CAST(pb.`year_2020` AS INT64), 2)    AS cases_per_100k
FROM (
  /* Step 1: national case totals on 2020-04-20 */
  SELECT
    country_region,
    SUM(confirmed) AS total_confirmed
  FROM `bigquery-public-data.covid19_jhu_csse.summary`
  WHERE date = '2020-04-20'
    AND country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country_region
) AS c
JOIN `bigquery-public-data.world_bank_global_population.population_by_country` AS pb
     /* Step 2: name harmonisation for join */
     ON pb.country = CASE
                        WHEN c.country_region = 'US'   THEN 'United States'
                        WHEN c.country_region = 'Iran' THEN 'Iran, Islamic Rep.'
                        ELSE c.country_region
                     END
ORDER BY cases_per_100k DESC;
```
