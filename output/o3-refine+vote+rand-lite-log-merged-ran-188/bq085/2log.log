--Description: Sanity-check — total combined population (2019 proxy) of the seven
--             countries, using World-Bank `population_by_country` (latest year
--             column available = year_2019).  Note the World Bank names:
--             • “United States”
--             • “Iran, Islamic Rep.”
SELECT
  SUM(SAFE_CAST(year_2019 AS INT64)) AS total_population_seven
