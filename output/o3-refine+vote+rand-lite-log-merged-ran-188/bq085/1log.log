```sql
--Description: Sum 2020 population values for every target country (handles duplicates if any)  
SELECT `country_name`,
       SUM(`value`) AS population_2020
FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
WHERE `indicator_name` = 'Population, total'
  AND `year` = 2020
  AND `country_name` IN ('United States','France','China','Italy','Spain','Germany','Iran')
GROUP BY `country_name`
LIMIT 20;
```

```sql
--Description: Sum confirmed cases on 20-Apr-2020 and also standardize the U.S. name to match WB data  
SELECT
  CASE WHEN `country_region` = 'US' THEN 'United States' ELSE `country_region` END AS country,
  SUM(`confirmed`) AS confirmed_total
FROM `bigquery-public-data.covid19_jhu_csse.summary`
WHERE `date` = '2020-04-20'
  AND `country_region` IN ('US','France','China','Italy','Spain','Germany','Iran')
GROUP BY country
LIMIT 20;
```

```sql
--Description: Final answer – confirmed cases and cases per 100,000 people for the seven countries  
WITH confirmed AS (
  SELECT
    CASE WHEN `country_region` = 'US' THEN 'United States' ELSE `country_region` END AS country,
    SUM(`confirmed`) AS confirmed_total
  FROM `bigquery-public-data.covid19_jhu_csse.summary`
  WHERE `date` = '2020-04-20'
    AND `country_region` IN ('US','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country
),
population AS (
  SELECT `country_name` AS country,
         SUM(`value`) AS population_2020
  FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
  WHERE `indicator_name` = 'Population, total'
    AND `year` = 2020
    AND `country_name` IN ('United States','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country
)
SELECT
  c.country,
  c.confirmed_total,
  p.population_2020,
  ROUND(c.confirmed_total / p.population_2020 * 100000, 2) AS cases_per_100k
FROM confirmed AS c
JOIN population AS p
ON c.country = p.country
LIMIT 20;
```

