LIMIT 20;
```

```sql
-- 6. Quick cross-check that country names line up across the two data sets  
SELECT DISTINCT c.country_or_region AS covid_name,
                p.country_name      AS wb_name
FROM   `bigquery-public-data.covid19_jhu_csse.confirmed_cases`           AS c
JOIN   `bigquery-public-data.world_bank_health_population.health_nutrition_population` AS p
       ON LOWER(c.country_or_region) = LOWER(p.country_name)
WHERE  p.year = 2020
  AND  p.indicator_name = 'Population, total'
LIMIT 20;
```

```sql
-- 7. Build a small helper table holding our country-name mapping  
WITH mapping AS (
  SELECT 'US'    AS covid_name, 'United States'      AS wb_name UNION ALL
  SELECT 'France',            'France'              UNION ALL
  SELECT 'China',             'China'               UNION ALL
  SELECT 'Italy',             'Italy'               UNION ALL
  SELECT 'Spain',             'Spain'               UNION ALL
  SELECT 'Germany',           'Germany'             UNION ALL
  SELECT 'Iran',              'Iran, Islamic Rep.'
)
SELECT *
FROM   mapping
LIMIT 20;
```

```sql
-- 8. Confirmed cases (4-20-2020) joined to 2020 population, using the mapping  
WITH mapping AS (
  SELECT 'US'    AS covid_name, 'United States'      AS wb_name UNION ALL
  SELECT 'France',            'France'              UNION ALL
  SELECT 'China',             'China'               UNION ALL
  SELECT 'Italy',             'Italy'               UNION ALL
  SELECT 'Spain',             'Spain'               UNION ALL
  SELECT 'Germany',           'Germany'             UNION ALL
  SELECT 'Iran',              'Iran, Islamic Rep.'
),
cases AS (
  SELECT country_or_region AS covid_name,
         CAST(`_4_20_20` AS INT64) AS cases_20200420
  FROM   `bigquery-public-data.covid19_jhu_csse.confirmed_cases`
  WHERE  country_or_region IN ('US','France','China','Italy','Spain','Germany','Iran')
),
pops AS (
  SELECT country_name AS wb_name,
         value        AS population_2020
  FROM   `bigquery-public-data.world_bank_health_population.health_nutrition_population`
  WHERE  year = 2020
    AND  indicator_name = 'Population, total'
    AND  country_name IN ('United States','France','China','Italy','Spain','Germany',
                          'Iran, Islamic Rep.')
)
SELECT m.covid_name,
       m.wb_name,
       c.cases_20200420,
       p.population_2020,
       100000 * c.cases_20200420 / p.population_2020 AS cases_per_100k
FROM   mapping AS m
JOIN   cases   AS c USING (covid_name)
JOIN   pops    AS p USING (wb_name)
LIMIT 20;
```

```sql
-- 9. Same as #8 but ordered for readability  
WITH mapping AS (
  SELECT 'US'    AS covid_name, 'United States'      AS wb_name UNION ALL
  SELECT 'France',            'France'              UNION ALL
  SELECT 'China',             'China'               UNION ALL
  SELECT 'Italy',             'Italy'               UNION ALL
  SELECT 'Spain',             'Spain'               UNION ALL
  SELECT 'Germany',           'Germany'             UNION ALL
  SELECT 'Iran',              'Iran, Islamic Rep.'
),
cases AS (
  SELECT country_or_region AS covid_name,
         CAST(`_4_20_20` AS INT64) AS cases_20200420
  FROM   `bigquery-public-data.covid19_jhu_csse.confirmed_cases`
  WHERE  country_or_region IN ('US','France','China','Italy','Spain','Germany','Iran')
),
pops AS (
  SELECT country_name AS wb_name,
         value        AS population_2020
  FROM   `bigquery-public-data.world_bank_health_population.health_nutrition_population`
  WHERE  year = 2020
    AND  indicator_name = 'Population, total'
    AND  country_name IN ('United States','France','China','Italy','Spain','Germany',
                          'Iran, Islamic Rep.')
)
SELECT m.covid_name                     AS country_region_code,
       m.wb_name                        AS country_name,
       c.cases_20200420                 AS confirmed_cases_apr20,
       p.population_2020,
       ROUND(100000 * c.cases_20200420 / p.population_2020, 2)
                                         AS cases_per_100k_population
FROM   mapping AS m
JOIN   cases   AS c USING (covid_name)
JOIN   pops    AS p USING (wb_name)
ORDER BY confirmed_cases_apr20 DESC
LIMIT 20;
```

