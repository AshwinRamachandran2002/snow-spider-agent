  FROM   `bigquery-public-data.covid19_jhu_csse.confirmed_cases`
  WHERE  country_or_region IN ('US','France','China','Italy','Spain','Germany','Iran')
),
pops AS (
  SELECT country_name AS wb_name,
         value        AS population_2020
  FROM   `bigquery-public-data.world_bank_health_population.health_nutrition_population`
  WHERE  year = 2020
    AND  indicator_name = 'Population, total'
    AND  country_name IN ('United States','France','China','Italy','Spain','Germany',
                          'Iran, Islamic Rep.')
)
SELECT m.wb_name                              AS country,
       c.cases_20200420                       AS confirmed_cases_as_of_2020_04_20,
       p.population_2020,
       ROUND(100000 * c.cases_20200420 / p.population_2020, 2)
                                              AS cases_per_100k_population
FROM   mapping AS m
JOIN   cases   AS c USING (covid_name)
JOIN   pops    AS p USING (wb_name)
ORDER BY country;
