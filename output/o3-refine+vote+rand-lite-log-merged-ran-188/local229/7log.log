```

```sql
-- 2. Description: Inspect how many runs a batsman got on every ball.
SELECT DISTINCT "match_id",
       "over_id",
       "ball_id",
       "innings_no",
       "runs_scored"
FROM "batsman_scored"
LIMIT 20;
```

```sql
-- 3. Description: Join the previous two tables to view (per ball) the striker, non-striker and runs scored off the bat.
SELECT DISTINCT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."striker",
       bb."non_striker",
       bs."runs_scored"
FROM   "ball_by_ball"  AS bb
JOIN   "batsman_scored" AS bs
       ON  bb."match_id"  = bs."match_id"
       AND bb."over_id"   = bs."over_id"
       AND bb."ball_id"   = bs."ball_id"
       AND bb."innings_no"= bs."innings_no"
LIMIT 20;
```

```sql
-- 4. Description: Add extra runs that also belong to the partnership (wides, byes, etc.).
SELECT DISTINCT bb."match_id",
       bb."over_id",
       bb."ball_id",
       er."extra_type",
       er."extra_runs"
FROM   "ball_by_ball" AS bb
JOIN   "extra_runs"   AS er
       ON  bb."match_id"  = er."match_id"
       AND bb."over_id"   = er."over_id"
       AND bb."ball_id"   = er."ball_id"
       AND bb."innings_no"= er."innings_no"
LIMIT 20;
```

```sql
-- 5. Description: See where wickets fell (needed to cut one partnership and start the next).
SELECT DISTINCT "match_id",
       "over_id",
       "ball_id",
       "player_out",
       "kind_out",
       "innings_no"
FROM   "wicket_taken"
LIMIT 20;
```

```sql
-- 6. Description: Build one “delivery” row with bat-runs + extras + a flag if a wicket fell.
SELECT DISTINCT bb."match_id",
       bb."innings_no",
       bb."over_id",
       bb."ball_id",
       bb."striker",
       bb."non_striker",
       bs."runs_scored"                       AS bat_runs,
       COALESCE(er."extra_runs",0)            AS extra_runs,
       (bs."runs_scored" + COALESCE(er."extra_runs",0)) AS total_runs,
       CASE WHEN wt."player_out" IS NOT NULL THEN 1 ELSE 0 END AS is_wicket
FROM   "ball_by_ball"    AS bb
JOIN   "batsman_scored"  AS bs
       ON  bb."match_id"   = bs."match_id"
       AND bb."over_id"    = bs."over_id"
       AND bb."ball_id"    = bs."ball_id"
       AND bb."innings_no" = bs."innings_no"
LEFT  JOIN "extra_runs"   AS er
       ON  bb."match_id"   = er."match_id"
       AND bb."over_id"    = er."over_id"
       AND bb."ball_id"    = er."ball_id"
       AND bb."innings_no" = er."innings_no"
LEFT  JOIN "wicket_taken" AS wt
       ON  bb."match_id"   = wt."match_id"
       AND bb."over_id"    = wt."over_id"
       AND bb."ball_id"    = wt."ball_id"
       AND bb."innings_no" = wt."innings_no"
LIMIT 20;
```

```sql
-- 7. Description: Mark every ball with how many wickets had already fallen *before* it – that value
--                 will be the partnership number within the innings.
WITH delivery AS (
    SELECT bb."match_id",
           bb."innings_no",
           bb."over_id",
           bb."ball_id",
           bb."striker",
           bb."non_striker",
           bs."runs_scored"                       AS bat_runs,
           COALESCE(er."extra_runs",0)            AS extra_runs,
           (bs."runs_scored" + COALESCE(er."extra_runs",0)) AS total_runs,
           CASE WHEN wt."player_out" IS NOT NULL THEN 1 ELSE 0 END AS is_wicket
    FROM   "ball_by_ball"    AS bb
    JOIN   "batsman_scored"  AS bs
           ON  bb."match_id"   = bs."match_id"
           AND bb."over_id"    = bs."over_id"
           AND bb."ball_id"    = bs."ball_id"
           AND bb."innings_no" = bs."innings_no"
    LEFT  JOIN "extra_runs"   AS er
           ON  bb."match_id"   = er."match_id"
           AND bb."over_id"    = er."over_id"
           AND bb."ball_id"    = er."ball_id"
           AND bb."innings_no" = er."innings_no"
    LEFT  JOIN "wicket_taken" AS wt
           ON  bb."match_id"   = wt."match_id"
           AND bb."over_id"    = wt."over_id"
           AND bb."ball_id"    = wt."ball_id"
           AND bb."innings_no" = wt."innings_no"
)
SELECT DISTINCT d."match_id",
       d."over_id",
       d."ball_id",
       d."innings_no",
       SUM(d.is_wicket) OVER (
            PARTITION BY d."match_id", d."innings_no"
            ORDER BY d."over_id", d."ball_id"
            ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
       )                          AS partnership_no_before_ball,
       d."striker",
       d."non_striker",
       d.total_runs
FROM   delivery AS d
LIMIT 20;
```

```sql
-- 8. Description: Aggregate runs for each (match, partnership) – total partnership runs.
WITH delivery AS (
    SELECT bb."match_id",
           bb."innings_no",
           bb."over_id",
           bb."ball_id",
           bb."striker",
           bb."non_striker",
           bs."runs_scored"                       AS bat_runs,
           COALESCE(er."extra_runs",0)            AS extra_runs,
           (bs."runs_scored" + COALESCE(er."extra_runs",0)) AS total_runs,
           CASE WHEN wt."player_out" IS NOT NULL THEN 1 ELSE 0 END AS is_wicket
    FROM   "ball_by_ball"    AS bb
    JOIN   "batsman_scored"  AS bs
           ON  bb."match_id"   = bs."match_id"
           AND bb."over_id"    = bs."over_id"
           AND bb."ball_id"    = bs."ball_id"
           AND bb."innings_no" = bs."innings_no"
    LEFT  JOIN "extra_runs"   AS er
           ON  bb."match_id"   = er."match_id"
           AND bb."over_id"    = er."over_id"
           AND bb."ball_id"    = er."ball_id"
           AND bb."innings_no" = er."innings_no"
    LEFT  JOIN "wicket_taken" AS wt
           ON  bb."match_id"   = wt."match_id"
           AND bb."over_id"    = wt."over_id"
           AND bb."ball_id"    = wt."ball_id"
           AND bb."innings_no" = wt."innings_no"
),
balls AS (
    SELECT d.*,
           SUM(d.is_wicket) OVER (
                 PARTITION BY d."match_id", d."innings_no"
                 ORDER BY d."over_id", d."ball_id"
                 ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
           ) AS partnership_no
    FROM   delivery AS d
)
SELECT DISTINCT "match_id",
       "partnership_no",
       SUM(total_runs) AS partnership_total_runs
FROM   balls
GROUP  BY "match_id", "partnership_no"
LIMIT 20;
```

```sql
-- 9. Description: Calculate individual batsman runs *inside each partnership*.
WITH delivery AS (
    SELECT bb."match_id",
           bb."innings_no",
           bb."over_id",
           bb."ball_id",
           bb."striker",
           bb."non_striker",
           bs."runs_scored"                       AS bat_runs,
           COALESCE(er."extra_runs",0)            AS extra_runs,
           (bs."runs_scored" + COALESCE(er."extra_runs",0)) AS total_runs,
           CASE WHEN wt."player_out" IS NOT NULL THEN 1 ELSE 0 END AS is_wicket
    FROM   "ball_by_ball"    AS bb
    JOIN   "batsman_scored"  AS bs
           ON  bb."match_id"   = bs."match_id"
           AND bb."over_id"    = bs."over_id"
           AND bb."ball_id"    = bs."ball_id"
           AND bb."innings_no" = bs."innings_no"
    LEFT  JOIN "extra_runs"   AS er
           ON  bb."match_id"   = er."match_id"
           AND bb."over_id"    = er."over_id"
           AND bb."ball_id"    = er."ball_id"
           AND bb."innings_no" = er."innings_no"
    LEFT  JOIN "wicket_taken" AS wt
           ON  bb."match_id"   = wt."match_id"
           AND bb."over_id"    = wt."over_id"
           AND bb."ball_id"    = wt."ball_id"
           AND bb."innings_no" = wt."innings_no"
),
balls AS (
    SELECT d.*,
           SUM(d.is_wicket) OVER (
                 PARTITION BY d."match_id", d."innings_no"
                 ORDER BY d."over_id", d."ball_id"
                 ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
           ) AS partnership_no
    FROM   delivery AS d
),
player_runs AS (
    -- union striker & non-striker so every ball counts for the “current batsman”
    SELECT DISTINCT "match_id",
           "partnership_no",
           "striker"       AS player_id,
           SUM(bat_runs)   AS player_runs
    FROM   balls
    GROUP  BY "match_id", "partnership_no", "striker"

    UNION ALL

    SELECT DISTINCT "match_id",
           "partnership_no",
           "non_striker"   AS player_id,
           SUM(bat_runs)   AS player_runs
    FROM   balls
    GROUP  BY "match_id", "partnership_no", "non_striker"
)
SELECT DISTINCT * FROM player_runs
LIMIT 20;
```

```sql
-- 10. Description (FINAL ANSWER): Highest-run partnership(s) for every match, with the two players,
--                                their individual runs, and total partnership runs.  If both players
--                                scored the same, the one with the higher player_id is shown first.
WITH delivery AS (
    SELECT bb."match_id",
           bb."innings_no",
           bb."over_id",
           bb."ball_id",
           bb."striker",
           bb."non_striker",
           bs."runs_scored"                       AS bat_runs,
           COALESCE(er."extra_runs",0)            AS extra_runs,
           (bs."runs_scored" + COALESCE(er."extra_runs",0)) AS total_runs,
           CASE WHEN wt."player_out" IS NOT NULL THEN 1 ELSE 0 END AS is_wicket
    FROM   "ball_by_ball"    AS bb
    JOIN   "batsman_scored"  AS bs
           ON  bb."match_id"   = bs."match_id"
           AND bb."over_id"    = bs."over_id"
           AND bb."ball_id"    = bs."ball_id"
           AND bb."innings_no" = bs."innings_no"
    LEFT  JOIN "extra_runs"   AS er
           ON  bb."match_id"   = er."match_id"
           AND bb."over_id"    = er."over_id"
           AND bb."ball_id"    = er."ball_id"
           AND bb."innings_no" = er."innings_no"
    LEFT  JOIN "wicket_taken" AS wt
           ON  bb."match_id"   = wt."match_id"
           AND bb."over_id"    = wt."over_id"
           AND bb."ball_id"    = wt."ball_id"
           AND bb."innings_no" = wt."innings_no"
),
balls AS (
    SELECT d.*,
           SUM(d.is_wicket) OVER (
                 PARTITION BY d."match_id", d."innings_no"
                 ORDER BY d."over_id", d."ball_id"
                 ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
           ) AS partnership_no
    FROM   delivery AS d
),
partnership_totals AS (
    SELECT "match_id",
           "partnership_no",
           SUM(total_runs) AS partnership_runs
    FROM   balls
    GROUP  BY "match_id", "partnership_no"
),
player_runs AS (
    SELECT "match_id",
           "partnership_no",
           "striker" AS player_id,
           SUM(bat_runs) AS player_runs
    FROM   balls
    GROUP  BY "match_id", "partnership_no", "striker"

    UNION ALL

    SELECT "match_id",
           "partnership_no",
           "non_striker" AS player_id,
           SUM(bat_runs) AS player_runs
    FROM   balls
    GROUP  BY "match_id", "partnership_no", "non_striker"
),
two_batsmen AS (
    -- join exactly two different players for each partnership
    SELECT pr1."match_id",
           pr1."partnership_no",
           pr1."player_id" AS p1,
           pr1."player_runs" AS p1_runs,
           pr2."player_id" AS p2,
           pr2."player_runs" AS p2_runs
    FROM   player_runs pr1
    JOIN   player_runs pr2
           ON  pr1."match_id"      = pr2."match_id"
           AND pr1."partnership_no"= pr2."partnership_no"
           AND pr1."player_id"     < pr2."player_id"
),
ordered_pair AS (
    -- order inside the pair so that the higher individual scorer becomes player1.
    SELECT tp."match_id",
           tp."partnership_no",
           CASE
               WHEN tp.p1_runs > tp.p2_runs THEN tp.p1
               WHEN tp.p1_runs < tp.p2_runs THEN tp.p2
               WHEN tp.p1       > tp.p2     THEN tp.p1
               ELSE tp.p2
           END AS player1_id,

           CASE
               WHEN tp.p1_runs > tp.p2_runs THEN tp.p1_runs
               WHEN tp.p1_runs < tp.p2_runs THEN tp.p2_runs
               WHEN tp.p1       > tp.p2     THEN tp.p1_runs
               ELSE tp.p2_runs
           END AS player1_runs,

           CASE
               WHEN tp.p1_runs > tp.p2_runs THEN tp.p2
               WHEN tp.p1_runs < tp.p2_runs THEN tp.p1
               WHEN tp.p1       > tp.p2     THEN tp.p2
               ELSE tp.p1
           END AS player2_id,

           CASE
               WHEN tp.p1_runs > tp.p2_runs THEN tp.p2_runs
               WHEN tp.p1_runs < tp.p2_runs THEN tp.p1_runs
               WHEN tp.p1       > tp.p2     THEN tp.p2_runs
               ELSE tp.p1_runs
           END AS player2_runs
    FROM   two_batsmen tp
),
full_partnership AS (
    SELECT op."match_id",
           op."player1_id",
           op."player1_runs",
           op."player2_id",
           op."player2_runs",
           pt."partnership_runs"
    FROM   ordered_pair      AS op
    JOIN   partnership_totals AS pt
           ON  op."match_id"       = pt."match_id"
           AND op."partnership_no" = pt."partnership_no"
),
ranked AS (
    -- keep every tie for “top” partnership(s) within a match
    SELECT fp.*,
           RANK() OVER (PARTITION BY fp."match_id"
                        ORDER BY fp."partnership_runs" DESC) AS rnk
    FROM   full_partnership fp
)
SELECT DISTINCT "match_id"            AS match_id,
       "player1_id"          AS player1_id,
       "player1_runs"        AS player1_runs,
       "player2_id"          AS player2_id,
       "player2_runs"        AS player2_runs,
       "partnership_runs"    AS partnership_runs
FROM   ranked
WHERE  rnk = 1
ORDER  BY "match_id";
```
