```sql
-- 4) Join the three ball–level tables to calculate total runs on each delivery  
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."innings_no",
       bb."striker",
       bb."non_striker",
       COALESCE(bs."runs_scored",0)          AS "bat_runs",
       COALESCE(er."extra_runs",0)           AS "extra_runs",
       COALESCE(bs."runs_scored",0)
       + COALESCE(er."extra_runs",0)         AS "total_runs"
FROM   "ball_by_ball"    AS bb
LEFT JOIN "batsman_scored" AS bs
       ON bb."match_id"  = bs."match_id"
      AND bb."over_id"   = bs."over_id"
      AND bb."ball_id"   = bs."ball_id"
      AND bb."innings_no"= bs."innings_no"
LEFT JOIN "extra_runs"   AS er
       ON bb."match_id"  = er."match_id"
      AND bb."over_id"   = er."over_id"
      AND bb."ball_id"   = er."ball_id"
      AND bb."innings_no"= er."innings_no"
WHERE  bb."match_id" = 335987
LIMIT 20;
```

```sql
-- 5) Aggregate every delivery into partnership blocks (unordered pair)  
WITH per_ball AS (
     SELECT bb."match_id",
            bb."innings_no",
            bb."striker",
            bb."non_striker",
            COALESCE(bs."runs_scored",0) AS bat_runs,
            COALESCE(er."extra_runs",0)  AS extra_runs
     FROM   "ball_by_ball"    AS bb
     LEFT JOIN "batsman_scored" AS bs
       ON bb."match_id"  = bs."match_id"
      AND bb."over_id"   = bs."over_id"
      AND bb."ball_id"   = bs."ball_id"
      AND bb."innings_no"= bs."innings_no"
     LEFT JOIN "extra_runs"   AS er
       ON bb."match_id"  = er."match_id"
      AND bb."over_id"   = er."over_id"
      AND bb."ball_id"   = er."ball_id"
      AND bb."innings_no"= er."innings_no"
), pairs AS (
     SELECT "match_id",
            "innings_no",
            CASE WHEN "striker" > "non_striker" THEN "striker"     ELSE "non_striker" END AS p_high,
            CASE WHEN "striker" > "non_striker" THEN "non_striker" ELSE "striker"     END AS p_low,
            "striker",
            "bat_runs",
            "extra_runs"
     FROM   per_ball
)
SELECT "match_id",
       "p_high" AS "player_a",
       "p_low"  AS "player_b",
       SUM("bat_runs" + "extra_runs") AS "partnership_runs"
FROM   pairs
GROUP  BY "match_id", "player_a", "player_b"
LIMIT 20;
```

```sql
-- 6) Calculate each player’s individual contribution inside every unordered pair  
WITH per_ball AS (
     SELECT bb."match_id",
            bb."innings_no",
            bb."striker",
            bb."non_striker",
            COALESCE(bs."runs_scored",0) AS bat_runs,
            COALESCE(er."extra_runs",0)  AS extra_runs
     FROM   "ball_by_ball"    AS bb
     LEFT JOIN "batsman_scored" AS bs
       ON bb."match_id"  = bs."match_id"
      AND bb."over_id"   = bs."over_id"
      AND bb."ball_id"   = bs."ball_id"
      AND bb."innings_no"= bs."innings_no"
     LEFT JOIN "extra_runs"   AS er
       ON bb."match_id"  = er."match_id"
      AND bb."over_id"   = er."over_id"
      AND bb."ball_id"   = er."ball_id"
      AND bb."innings_no"= er."innings_no"
), pairs AS (
     SELECT "match_id",
            CASE WHEN "striker" > "non_striker" THEN "striker"     ELSE "non_striker" END AS p1,
            CASE WHEN "striker" > "non_striker" THEN "non_striker" ELSE "striker"     END AS p2,
            SUM(CASE WHEN "striker" = 
                        CASE WHEN "striker" > "non_striker" THEN "striker" ELSE "non_striker" END
                     THEN "bat_runs" ELSE 0 END)                 AS p1_individual,
            SUM(CASE WHEN "striker" = 
                        CASE WHEN "striker" > "non_striker" THEN "non_striker" ELSE "striker" END
                     THEN "bat_runs" ELSE 0 END)                 AS p2_individual,
            SUM("bat_runs" + "extra_runs")                       AS partnership_total
     FROM   per_ball
     GROUP  BY "match_id", p1, p2
)
SELECT *
FROM   pairs
LIMIT 20;
```

```sql
-- 7) For every match, find the maximum partnership_total value  
WITH pair_totals AS ( /* reuse CTE from query 6 */ 
     SELECT "match_id",
            CASE WHEN "striker" > "non_striker" THEN "striker"     ELSE "non_striker" END AS p1,
            CASE WHEN "striker" > "non_striker" THEN "non_striker" ELSE "striker"     END AS p2,
            SUM(CASE WHEN "striker" = 
                        CASE WHEN "striker" > "non_striker" THEN "striker" ELSE "non_striker" END
                     THEN "bat_runs" ELSE 0 END)                 AS p1_individual,
            SUM(CASE WHEN "striker" = 
                        CASE WHEN "striker" > "non_striker" THEN "non_striker" ELSE "striker" END
                     THEN "bat_runs" ELSE 0 END)                 AS p2_individual,
            SUM("bat_runs" + "extra_runs")                       AS partnership_total
     FROM   (
            SELECT bb."match_id",
                   bb."striker",
                   bb."non_striker",
                   COALESCE(bs."runs_scored",0) AS bat_runs,
                   COALESCE(er."extra_runs",0)  AS extra_runs
            FROM   "ball_by_ball"    AS bb
            LEFT JOIN "batsman_scored" AS bs
              ON bb."match_id"  = bs."match_id"
             AND bb."over_id"   = bs."over_id"
             AND bb."ball_id"   = bs."ball_id"
             AND bb."innings_no"= bs."innings_no"
            LEFT JOIN "extra_runs"   AS er
              ON bb."match_id"  = er."match_id"
             AND bb."over_id"   = er."over_id"
             AND bb."ball_id"   = er."ball_id"
             AND bb."innings_no"= er."innings_no"
     ) sub
     GROUP  BY "match_id", p1, p2
), ranked AS (
     SELECT pt.*,
            MAX("partnership_total") OVER(PARTITION BY "match_id") AS max_partnership
     FROM   pair_totals AS pt
)
SELECT *
FROM   ranked
WHERE  "partnership_total" = "max_partnership"
LIMIT 20;
```

```sql
-- 8) Enforce the final ordering rule (higher individual score first;  
--    if equal, higher player_id first) and project required columns  
WITH pair_totals AS ( /* same body as query 7 */ 
     SELECT "match_id",
            CASE WHEN "striker" > "non_striker" THEN "striker"     ELSE "non_striker" END AS p1,
            CASE WHEN "striker" > "non_striker" THEN "non_striker" ELSE "striker"     END AS p2,
            SUM(CASE WHEN "striker" = 
                        CASE WHEN "striker" > "non_striker" THEN "striker" ELSE "non_striker" END
                     THEN "bat_runs" ELSE 0 END)                 AS p1_individual,
            SUM(CASE WHEN "striker" = 
                        CASE WHEN "striker" > "non_striker" THEN "non_striker" ELSE "striker" END
                     THEN "bat_runs" ELSE 0 END)                 AS p2_individual,
            SUM("bat_runs" + "extra_runs")                       AS partnership_total
     FROM   (
            SELECT bb."match_id",
                   bb."striker",
                   bb."non_striker",
                   COALESCE(bs."runs_scored",0) AS bat_runs,
                   COALESCE(er."extra_runs",0)  AS extra_runs
            FROM   "ball_by_ball"    AS bb
            LEFT JOIN "batsman_scored" AS bs
              ON bb."match_id"  = bs."match_id"
             AND bb."over_id"   = bs."over_id"
             AND bb."ball_id"   = bs."ball_id"
             AND bb."innings_no"= bs."innings_no"
            LEFT JOIN "extra_runs"   AS er
              ON bb."match_id"  = er."match_id"
             AND bb."over_id"   = er."over_id"
             AND bb."ball_id"   = er."ball_id"
             AND bb."innings_no"= er."innings_no"
     ) sub
     GROUP  BY "match_id", p1, p2
), ranked AS (
     SELECT pt.*,
            MAX("partnership_total") OVER(PARTITION BY "match_id") AS max_partnership
     FROM   pair_totals AS pt
)
SELECT "match_id",
       CASE 
            WHEN p1_individual >  p2_individual THEN p1
            WHEN p1_individual <  p2_individual THEN p2
            WHEN p1           >  p2            THEN p1
            ELSE                                    p2
       END AS player1_id,
       CASE 
            WHEN p1_individual >  p2_individual THEN p2
            WHEN p1_individual <  p2_individual THEN p1
            WHEN p1           >  p2            THEN p2
            ELSE                                    p1
       END AS player2_id,
       CASE 
            WHEN p1_individual >  p2_individual THEN p1_individual
            WHEN p1_individual <  p2_individual THEN p2_individual
            WHEN p1           >  p2            THEN p1_individual
            ELSE                                    p2_individual
       END AS player1_runs,
       CASE 
            WHEN p1_individual >  p2_individual THEN p2_individual
            WHEN p1_individual <  p2_individual THEN p1_individual
            WHEN p1           >  p2            THEN p2_individual
            ELSE                                    p1_individual
       END AS player2_runs,
       "partnership_total"
FROM   ranked
WHERE  "partnership_total" = "max_partnership"
LIMIT 20;
