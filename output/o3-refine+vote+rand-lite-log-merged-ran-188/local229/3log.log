```

```sql
-- 3. Preview extra runs recorded for each ball
SELECT DISTINCT "match_id",
       "over_id",
       "ball_id",
       "innings_no",
       "extra_type",
       "extra_runs"
FROM "extra_runs"
LIMIT 20;
```

```sql
-- 4. Join one match’s balls with batsman and extra information to see the
--    data we need for partnership-run computation
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."striker",
       bb."non_striker",
       bs."runs_scored",
       COALESCE(er."extra_runs",0) AS "extra_runs"
FROM   "ball_by_ball" AS bb
LEFT JOIN "batsman_scored" AS bs
       USING ("match_id","over_id","ball_id","innings_no")
LEFT JOIN "extra_runs"    AS er
       USING ("match_id","over_id","ball_id","innings_no")
WHERE  bb."match_id" = (SELECT "match_id" FROM "ball_by_ball" LIMIT 1)
LIMIT 20;
```

```sql
-- 5. Compute, for every match and batting pair (unordered),
--    total partnership runs and each player’s individual runs
WITH ball AS (
  SELECT bb."match_id",
         MIN(bb."striker",bb."non_striker") AS "p1",
         MAX(bb."striker",bb."non_striker") AS "p2",
         bb."striker",
         bs."runs_scored",
         COALESCE(er."extra_runs",0)          AS "extra_runs"
  FROM   "ball_by_ball" AS bb
  LEFT  JOIN "batsman_scored" AS bs
         USING ("match_id","over_id","ball_id","innings_no")
  LEFT  JOIN "extra_runs"    AS er
         USING ("match_id","over_id","ball_id","innings_no")
)
SELECT "match_id",
       "p1",
       "p2",
       SUM("runs_scored" + "extra_runs")                                   AS "partnership_runs",
       SUM(CASE WHEN "striker" = "p1" THEN "runs_scored" ELSE 0 END)       AS "p1_runs",
       SUM(CASE WHEN "striker" = "p2" THEN "runs_scored" ELSE 0 END)       AS "p2_runs"
FROM   ball
GROUP  BY "match_id","p1","p2"
LIMIT 20;
```

```sql
-- 6. For every match, find the highest partnership-run value
WITH pair_runs AS (
  SELECT "match_id",
         MIN("striker","non_striker") AS "p1",
         MAX("striker","non_striker") AS "p2",
         SUM(bs."runs_scored" + COALESCE(er."extra_runs",0)) AS "partnership_runs"
  FROM   "ball_by_ball" AS bb
  JOIN   "batsman_scored" AS bs
         USING ("match_id","over_id","ball_id","innings_no")
  LEFT   JOIN "extra_runs" AS er
         USING ("match_id","over_id","ball_id","innings_no")
  GROUP  BY "match_id","p1","p2"
)
SELECT "match_id",
       MAX("partnership_runs") AS "max_partnership_runs"
FROM   pair_runs
GROUP  BY "match_id"
LIMIT 20;
```

```sql
-- 7. Collect every pair that reaches the match’s maximum partnership runs
WITH ball AS (
  SELECT bb."match_id",
         MIN(bb."striker",bb."non_striker") AS "p1",
         MAX(bb."striker",bb."non_striker") AS "p2",
         bb."striker",
         bs."runs_scored",
         COALESCE(er."extra_runs",0) AS "extra_runs"
  FROM   "ball_by_ball" AS bb
  LEFT  JOIN "batsman_scored" AS bs
         USING ("match_id","over_id","ball_id","innings_no")
  LEFT  JOIN "extra_runs"    AS er
         USING ("match_id","over_id","ball_id","innings_no")
),
pair_runs AS (
  SELECT "match_id",
         "p1","p2",
         SUM("runs_scored" + "extra_runs") AS "partnership_runs",
         SUM(CASE WHEN "striker" = "p1" THEN "runs_scored" ELSE 0 END) AS "p1_runs",
         SUM(CASE WHEN "striker" = "p2" THEN "runs_scored" ELSE 0 END) AS "p2_runs"
  FROM   ball
  GROUP  BY "match_id","p1","p2"
),
max_pair AS (
  SELECT "match_id",
         MAX("partnership_runs") AS "max_runs"
  FROM   pair_runs
  GROUP  BY "match_id"
)
SELECT pr.*
FROM   pair_runs AS pr
JOIN   max_pair AS mp
       ON pr."match_id" = mp."match_id"
      AND pr."partnership_runs" = mp."max_runs"
LIMIT 20;
```

```sql
-- 8. Final answer: for every match, report the two players ordered by
--    higher individual score (or higher ID when scores tie), each player’s
--    contribution and the total partnership runs
WITH ball AS (
  SELECT bb."match_id",
         MIN(bb."striker",bb."non_striker") AS "p1",
         MAX(bb."striker",bb."non_striker") AS "p2",
         bb."striker",
         bs."runs_scored",
         COALESCE(er."extra_runs",0) AS "extra_runs"
  FROM   "ball_by_ball" AS bb
  LEFT  JOIN "batsman_scored" AS bs
         USING ("match_id","over_id","ball_id","innings_no")
  LEFT  JOIN "extra_runs"    AS er
         USING ("match_id","over_id","ball_id","innings_no")
),
pair_runs AS (
  SELECT "match_id",
         "p1","p2",
         SUM("runs_scored" + "extra_runs") AS "partnership_runs",
         SUM(CASE WHEN "striker" = "p1" THEN "runs_scored" ELSE 0 END) AS "p1_runs",
         SUM(CASE WHEN "striker" = "p2" THEN "runs_scored" ELSE 0 END) AS "p2_runs"
  FROM   ball
  GROUP  BY "match_id","p1","p2"
),
max_pair AS (
  SELECT "match_id",
         MAX("partnership_runs") AS "max_runs"
  FROM   pair_runs
  GROUP  BY "match_id"
),
top_pair AS (
  SELECT pr."match_id",
         pr."p1",
         pr."p2",
         pr."p1_runs",
         pr."p2_runs",
         pr."partnership_runs"
  FROM   pair_runs AS pr
  JOIN   max_pair AS mp
    ON   pr."match_id" = mp."match_id"
   AND   pr."partnership_runs" = mp."max_runs"
)
SELECT "match_id",
       CASE
           WHEN "p1_runs" > "p2_runs"
                OR ("p1_runs" = "p2_runs" AND "p1" > "p2")
           THEN "p1" ELSE "p2" END                       AS "player1_id",
       CASE
           WHEN "p1_runs" > "p2_runs"
                OR ("p1_runs" = "p2_runs" AND "p1" > "p2")
           THEN "p1_runs" ELSE "p2_runs" END             AS "player1_score",
       CASE
           WHEN "p1_runs" > "p2_runs"
                OR ("p1_runs" = "p2_runs" AND "p1" > "p2")
           THEN "p2" ELSE "p1" END                       AS "player2_id",
       CASE
           WHEN "p1_runs" > "p2_runs"
                OR ("p1_runs" = "p2_runs" AND "p1" > "p2")
           THEN "p2_runs" ELSE "p1_runs" END             AS "player2_score",
       "partnership_runs"
FROM   top_pair
ORDER  BY "match_id", "player1_id", "player2_id"
LIMIT 20;
```
