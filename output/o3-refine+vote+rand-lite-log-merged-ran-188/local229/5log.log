--Description: Highest-scoring partnership(s) with each partner’s individual contribution, ordered by rules
WITH ball_runs AS (
    SELECT b.match_id,
           b.striker,
           b.non_striker,
           r.runs_scored
    FROM   ball_by_ball   AS b
    JOIN   batsman_scored AS r
           ON  r.match_id = b.match_id
          AND r.over_id  = b.over_id
          AND r.ball_id  = b.ball_id
),
pair_totals AS (                                           -- unordered pair plus individual tallies
    SELECT  match_id,
            CASE WHEN striker < non_striker THEN striker ELSE non_striker END AS p_low,
            CASE WHEN striker > non_striker THEN striker ELSE non_striker END AS p_high,
            SUM(CASE WHEN striker < non_striker THEN runs_scored ELSE 0 END) AS runs_low,
            SUM(CASE WHEN striker > non_striker THEN runs_scored ELSE 0 END) AS runs_high,
            SUM(runs_scored)                                                 AS partnership_runs
    FROM   ball_runs
    GROUP BY match_id, p_low, p_high
),
max_pair AS (
    SELECT match_id, MAX(partnership_runs) AS max_runs
    FROM   pair_totals
    GROUP BY match_id
)
SELECT pt.match_id,
       CASE                                               -- player1_id
            WHEN pt.runs_high > pt.runs_low THEN pt.p_high
            WHEN pt.runs_high < pt.runs_low THEN pt.p_low
            ELSE pt.p_high
       END AS player1_id,
       CASE                                               -- player1_runs
            WHEN pt.runs_high >= pt.runs_low THEN pt.runs_high ELSE pt.runs_low
       END AS player1_runs,
       CASE                                               -- player2_id
            WHEN pt.runs_high > pt.runs_low THEN pt.p_low
            WHEN pt.runs_high < pt.runs_low THEN pt.p_high
            ELSE pt.p_low
       END AS player2_id,
       CASE                                               -- player2_runs
            WHEN pt.runs_high >= pt.runs_low THEN pt.runs_low ELSE pt.runs_high
       END AS player2_runs,
       pt.partnership_runs
FROM   pair_totals AS pt
JOIN   max_pair    AS mp
     ON pt.match_id         = mp.match_id
    AND pt.partnership_runs = mp.max_runs
ORDER BY pt.match_id, player1_id DESC, player2_id
