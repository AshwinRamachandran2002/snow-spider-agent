            CASE WHEN striker < non_striker THEN striker ELSE non_striker END AS p_low,
            CASE WHEN striker > non_striker THEN striker ELSE non_striker END AS p_high,
            SUM(CASE WHEN striker < non_striker THEN runs_scored ELSE 0 END) AS runs_low,
            SUM(CASE WHEN striker > non_striker THEN runs_scored ELSE 0 END) AS runs_high,
            SUM(runs_scored)                                                 AS partnership_runs
    FROM   ball_runs
    GROUP BY match_id, p_low, p_high
),
max_pair AS (
    SELECT match_id, MAX(partnership_runs) AS max_runs
    FROM   pair_runs
    GROUP BY match_id
)
SELECT pr.match_id,
       CASE
            WHEN pr.runs_high > pr.runs_low THEN pr.p_high
            WHEN pr.runs_high < pr.runs_low THEN pr.p_low
            ELSE pr.p_high
       END AS player1_id,
       CASE
            WHEN pr.runs_high >= pr.runs_low THEN pr.runs_high ELSE pr.runs_low
       END AS player1_runs,
       CASE
            WHEN pr.runs_high > pr.runs_low THEN pr.p_low
            WHEN pr.runs_high < pr.runs_low THEN pr.p_high
            ELSE pr.p_low
       END AS player2_id,
       CASE
            WHEN pr.runs_high >= pr.runs_low THEN pr.runs_low ELSE pr.runs_high
       END AS player2_runs,
       pr.partnership_runs
FROM   pair_runs AS pr
JOIN   max_pair  AS mp
     ON pr.match_id         = mp.match_id
    AND pr.partnership_runs = mp.max_runs
ORDER BY pr.match_id, player1_id DESC, player2_id
