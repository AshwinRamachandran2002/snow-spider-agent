```sql
--Description: Join one match’s deliveries with the runs table to get (striker, non-striker, runs) per ball
SELECT b."match_id",
       b."over_id",
       b."ball_id",
       b."striker"        AS "striker_id",
       b."non_striker"    AS "non_striker_id",
       r."runs_scored"
FROM   "ball_by_ball"  AS b
JOIN   "batsman_scored" AS r
       ON  b."match_id" = r."match_id"
       AND b."over_id"  = r."over_id"
       AND b."ball_id"  = r."ball_id"
WHERE  b."match_id" = 335987
LIMIT 20;
```

```sql
--Description: Aggregate runs for every (striker, non-striker) pair in one match
SELECT b."match_id",
       b."striker"      AS "player1_id",
       b."non_striker"  AS "player2_id",
       SUM(r."runs_scored") AS "partnership_runs"
FROM   "ball_by_ball"  AS b
JOIN   "batsman_scored" AS r
       ON  b."match_id" = r."match_id"
       AND b."over_id"  = r."over_id"
       AND b."ball_id"  = r."ball_id"
WHERE  b."match_id" = 335987
GROUP  BY b."match_id", b."striker", b."non_striker"
ORDER  BY "partnership_runs" DESC
LIMIT 20;
```

```sql
--Description: Order the two partners the way the final answer requires (higher runs first, then higher ID)
SELECT b."match_id",
       CASE WHEN SUM(CASE WHEN b."striker" = p THEN r."runs_scored" END) >=
                 SUM(CASE WHEN b."non_striker" = p THEN r."runs_scored" END)
            THEN b."striker" ELSE b."non_striker" END AS "player1_id",
       CASE WHEN SUM(CASE WHEN b."striker" = p THEN r."runs_scored" END) <
                 SUM(CASE WHEN b."non_striker" = p THEN r."runs_scored" END)
            THEN b."striker" ELSE b."non_striker" END AS "player2_id",
       SUM(r."runs_scored") AS "partnership_runs"
FROM   "ball_by_ball"  AS b
JOIN   "batsman_scored" AS r
       ON  b."match_id" = r."match_id"
       AND b."over_id"  = r."over_id"
       AND b."ball_id"  = r."ball_id",
       (SELECT 1) p              -- dummy sub-query just to reuse alias ‘p’
WHERE  b."match_id" = 335987
GROUP  BY b."match_id", "player1_id", "player2_id"
ORDER  BY "partnership_runs" DESC
LIMIT 20;
```

```sql
--Description: Compute partnerships across *all* matches and pick the highest-scoring one for each match
WITH partnership AS (
    SELECT b."match_id",
           CASE WHEN b."striker" > b."non_striker"
                THEN b."striker" ELSE b."non_striker" END AS "p_high",
           CASE WHEN b."striker" > b."non_striker"
                THEN b."non_striker" ELSE b."striker" END AS "p_low",
           SUM(r."runs_scored") AS "partnership_runs"
    FROM   "ball_by_ball"  AS b
    JOIN   "batsman_scored" AS r
           ON  b."match_id" = r."match_id"
           AND b."over_id"  = r."over_id"
           AND b."ball_id"  = r."ball_id"
    GROUP  BY b."match_id", "p_high", "p_low"
),
max_partnership AS (
    SELECT "match_id", MAX("partnership_runs") AS "max_runs"
    FROM   partnership
    GROUP  BY "match_id"
)
SELECT p."match_id",
       p."p_high" AS "player1_id",
       p."p_low"  AS "player2_id",
       p."partnership_runs"
FROM   partnership  AS p
JOIN   max_partnership AS m
       ON  p."match_id" = m."match_id"
       AND p."partnership_runs" = m."max_runs"
ORDER  BY p."match_id"
LIMIT 20;
```

```sql
--Description: Add each partner’s individual contribution to the partnership
WITH ball_runs AS (
    SELECT b."match_id",
           b."striker",
           b."non_striker",
           r."runs_scored"
    FROM   "ball_by_ball"  AS b
    JOIN   "batsman_scored" AS r
           ON  b."match_id" = r."match_id"
           AND b."over_id"  = r."over_id"
           AND b."ball_id"  = r."ball_id"
),
pair_runs AS (
    SELECT "match_id",
           CASE WHEN "striker" > "non_striker" THEN "striker" ELSE "non_striker" END AS "p_high",
           CASE WHEN "striker" > "non_striker" THEN "non_striker" ELSE "striker" END AS "p_low",
           SUM(CASE WHEN "striker" > "non_striker" THEN "runs_scored" ELSE 0 END) AS "runs_high",
           SUM(CASE WHEN "striker" > "non_striker" THEN 0 ELSE "runs_scored" END) AS "runs_low",
           SUM("runs_scored") AS "partnership_runs"
    FROM   ball_runs
    GROUP  BY "match_id", "p_high", "p_low"
),
max_pair AS (
    SELECT "match_id", MAX("partnership_runs") AS "max_runs"
    FROM   pair_runs
    GROUP  BY "match_id"
)
SELECT p."match_id",
       p."p_high"        AS "player1_id",
       p."runs_high"     AS "player1_runs",
       p."p_low"         AS "player2_id",
       p."runs_low"      AS "player2_runs",
       p."partnership_runs"
FROM   pair_runs  AS p
JOIN   max_pair   AS m
       ON  p."match_id" = m."match_id"
       AND p."partnership_runs" = m."max_runs"
ORDER  BY p."match_id"
LIMIT 20;
```

```sql
--Description: Display the final answer – highest-scoring partnership(s) for every match in the database
WITH ball_runs AS (
    SELECT b."match_id",
           b."striker",
           b."non_striker",
           r."runs_scored"
    FROM   "ball_by_ball"  AS b
    JOIN   "batsman_scored" AS r
           ON  b."match_id" = r."match_id"
           AND b."over_id"  = r."over_id"
           AND b."ball_id"  = r."ball_id"
),
pair_runs AS (
    SELECT "match_id",
           CASE WHEN "striker" > "non_striker" THEN "striker" ELSE "non_striker" END AS "player1_id",
           CASE WHEN "striker" > "non_striker" THEN "non_striker" ELSE "striker" END AS "player2_id",
           SUM(CASE WHEN "striker" > "non_striker" THEN "runs_scored" ELSE 0 END) AS "player1_runs",
           SUM(CASE WHEN "striker" > "non_striker" THEN 0 ELSE "runs_scored" END) AS "player2_runs",
           SUM("runs_scored") AS "partnership_runs"
    FROM   ball_runs
    GROUP  BY "match_id", "player1_id", "player2_id"
),
max_pair AS (
    SELECT "match_id", MAX("partnership_runs") AS "max_runs"
    FROM   pair_runs
    GROUP  BY "match_id"
)
SELECT p."match_id",
       p."player1_id",
       p."player1_runs",
       p."player2_id",
       p."player2_runs",
       p."partnership_runs"
FROM   pair_runs AS p
JOIN   max_pair  AS m
       ON  p."match_id" = m."match_id"
       AND p."partnership_runs" = m."max_runs"
ORDER  BY p."match_id", p."player1_id" DESC, p."player2_id"
LIMIT 20;
