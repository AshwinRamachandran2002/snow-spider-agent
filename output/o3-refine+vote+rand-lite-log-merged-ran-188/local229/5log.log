```sql
--Description: Highest-scoring batting partnerships for every match.
--Logic inside CTEs
-- 1. ball_runs   : every ball with striker/non-striker and runs (credited only to striker).
-- 2. pair_runs   : aggregate to unordered pairs (p_low < p_high), keeping
--                  each partner’s individual runs (runs_low / runs_high) and total partnership runs.
-- 3. max_pair    : maximum partnership total per match.
-- 4. final list  : for pairs that equal the max, label player1 as
--                  • the partner with the larger individual score, or
--                  • when equal, the partner with the higher player_id.
WITH ball_runs AS (
    SELECT  b.match_id,
            b.striker,
            b.non_striker,
            r.runs_scored
    FROM    ball_by_ball   AS b
    JOIN    batsman_scored AS r
           ON  r.match_id = b.match_id
          AND r.over_id  = b.over_id
          AND r.ball_id  = b.ball_id
),
pair_runs AS (
    SELECT  match_id,
            CASE WHEN striker < non_striker THEN striker ELSE non_striker END AS p_low,
            CASE WHEN striker > non_striker THEN striker ELSE non_striker END AS p_high,
            SUM(CASE WHEN striker < non_striker THEN runs_scored ELSE 0 END) AS runs_low,
            SUM(CASE WHEN striker > non_striker THEN runs_scored ELSE 0 END) AS runs_high,
            SUM(runs_scored)                                                 AS partnership_runs
    FROM    ball_runs
    GROUP BY match_id, p_low, p_high
),
max_pair AS (
    SELECT  match_id,
            MAX(partnership_runs) AS max_runs
    FROM    pair_runs
    GROUP BY match_id
)
SELECT  pr.match_id,
        /* decide player1 / player2 per rules */
        CASE
             WHEN pr.runs_high > pr.runs_low THEN pr.p_high
             WHEN pr.runs_high < pr.runs_low THEN pr.p_low
             ELSE pr.p_high                      -- equal runs → higher ID first
        END  AS player1_id,
        CASE
             WHEN pr.runs_high > pr.runs_low THEN pr.runs_high
             WHEN pr.runs_high < pr.runs_low THEN pr.runs_low
             ELSE pr.runs_high                  -- equal, same number
        END  AS player1_runs,
        CASE
             WHEN pr.runs_high > pr.runs_low THEN pr.p_low
             WHEN pr.runs_high < pr.runs_low THEN pr.p_high
             ELSE pr.p_low                      -- equal runs → lower ID second
        END  AS player2_id,
        CASE
             WHEN pr.runs_high > pr.runs_low THEN pr.runs_low
             WHEN pr.runs_high < pr.runs_low THEN pr.runs_high
             ELSE pr.runs_low
        END  AS player2_runs,
        pr.partnership_runs
FROM    pair_runs AS pr
JOIN    max_pair  AS mp
      ON pr.match_id        = mp.match_id
     AND pr.partnership_runs = mp.max_runs
ORDER BY pr.match_id, player1_id DESC, player2_id;
```
