--Description: Check how many matches have more than one partnership tied for the highest runs
WITH ball_runs AS (
    SELECT b."match_id",
           b."striker",
           b."non_striker",
           r."runs_scored"
    FROM   "ball_by_ball"  AS b
    JOIN   "batsman_scored" AS r
           ON  b."match_id" = r."match_id"
           AND b."over_id"  = r."over_id"
           AND b."ball_id"  = r."ball_id"
),
pair_runs AS (
    SELECT "match_id",
           CASE WHEN "striker" > "non_striker" THEN "striker" ELSE "non_striker" END AS "p_high",
           CASE WHEN "striker" > "non_striker" THEN "non_striker" ELSE "striker" END AS "p_low",
           SUM("runs_scored") AS "partnership_runs"
    FROM   ball_runs
    GROUP  BY "match_id", "p_high", "p_low"
),
max_pair AS (
    SELECT "match_id", MAX("partnership_runs") AS "max_runs"
    FROM   pair_runs
    GROUP  BY "match_id"
)
SELECT COUNT(*) AS "matches_with_ties"
FROM (
    SELECT p."match_id"
    FROM   pair_runs AS p
    JOIN   max_pair  AS m
           ON  p."match_id" = m."match_id"
           AND p."partnership_runs" = m."max_runs"
    GROUP  BY p."match_id"
    HAVING COUNT(*) > 1
);
