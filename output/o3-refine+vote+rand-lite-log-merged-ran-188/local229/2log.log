```sql
-- 1. Peek into the basic scoring-pair information that lives in ball_by_ball  
SELECT DISTINCT "match_id",
                "over_id",
                "ball_id",
                "innings_no",
                "striker",
                "non_striker"
FROM "ball_by_ball"
LIMIT 20;
```

```sql
-- 2. Look at the runs that have actually been credited to the striker on every ball  
SELECT DISTINCT "match_id",
                "over_id",
                "ball_id",
                "runs_scored",
                "innings_no"
FROM "batsman_scored"
LIMIT 20;
```

```sql
-- 3. Join the two tables to confirm we can see striker, non-striker & runs together  
SELECT DISTINCT b."match_id",
                b."over_id",
                b."ball_id",
                b."striker",
                b."non_striker",
                bs."runs_scored"
FROM   "ball_by_ball"   AS b
JOIN   "batsman_scored" AS bs
       ON  b."match_id"   = bs."match_id"
      AND  b."over_id"    = bs."over_id"
      AND  b."ball_id"    = bs."ball_id"
      AND  b."innings_no" = bs."innings_no"
LIMIT 20;
```

```sql
-- 4. Aggregate to see how many runs every player scores as a striker in a match  
SELECT DISTINCT b."match_id",
                b."striker"               AS "player_id",
                SUM(bs."runs_scored")     AS "total_runs"
FROM   "ball_by_ball"   AS b
JOIN   "batsman_scored" AS bs
       ON  b."match_id"   = bs."match_id"
      AND  b."over_id"    = bs."over_id"
      AND  b."ball_id"    = bs."ball_id"
      AND  b."innings_no" = bs."innings_no"
GROUP  BY b."match_id",
          b."striker"
LIMIT 20;
```

```sql
-- 5. Partnership runs for every unordered pair of batsmen in every match  
SELECT DISTINCT
       b."match_id",
       CASE WHEN b."striker" < b."non_striker" THEN b."striker"
            ELSE b."non_striker" END          AS "player_low",
       CASE WHEN b."striker" < b."non_striker" THEN b."non_striker"
            ELSE b."striker" END              AS "player_high",
       SUM(bs."runs_scored")                  AS "partnership_runs"
FROM   "ball_by_ball"   AS b
JOIN   "batsman_scored" AS bs
       ON  b."match_id"   = bs."match_id"
      AND  b."over_id"    = bs."over_id"
      AND  b."ball_id"    = bs."ball_id"
      AND  b."innings_no" = bs."innings_no"
GROUP  BY b."match_id",
          "player_low",
          "player_high"
LIMIT 20;
```

```sql
-- 6. Partnership runs PLUS how much each player of the pair scored while together  
SELECT DISTINCT
       t."match_id",
       t."player_low",
       t."player_high",
       SUM(t."runs_scored")                                             AS "partnership_runs",
       SUM(CASE WHEN t."striker" = t."player_low"  THEN t."runs_scored"
                ELSE 0 END)                                             AS "runs_low",
       SUM(CASE WHEN t."striker" = t."player_high" THEN t."runs_scored"
                ELSE 0 END)                                             AS "runs_high"
FROM (
      SELECT b."match_id",
             b."striker",
             b."non_striker",
             CASE WHEN b."striker" < b."non_striker" THEN b."striker"
                  ELSE b."non_striker" END                              AS "player_low",
             CASE WHEN b."striker" < b."non_striker" THEN b."non_striker"
                  ELSE b."striker" END                                  AS "player_high",
             bs."runs_scored"
      FROM   "ball_by_ball"   AS b
      JOIN   "batsman_scored" AS bs
             ON  b."match_id"   = bs."match_id"
            AND  b."over_id"    = bs."over_id"
            AND  b."ball_id"    = bs."ball_id"
            AND  b."innings_no" = bs."innings_no"
) AS t
GROUP  BY t."match_id",
          t."player_low",
          t."player_high"
LIMIT 20;
```

```sql
-- 7. Rank partnerships inside every match by total partnership runs (1 = highest)  
WITH "partnership" AS (
     SELECT
            t."match_id",
            t."player_low",
            t."player_high",
            SUM(t."runs_scored")                                        AS "partnership_runs",
            SUM(CASE WHEN t."striker" = t."player_low"  THEN t."runs_scored" ELSE 0 END) AS "runs_low",
            SUM(CASE WHEN t."striker" = t."player_high" THEN t."runs_scored" ELSE 0 END) AS "runs_high"
     FROM (
           SELECT b."match_id",
                  b."striker",
                  b."non_striker",
                  CASE WHEN b."striker" < b."non_striker" THEN b."striker"
                       ELSE b."non_striker" END                        AS "player_low",
                  CASE WHEN b."striker" < b."non_striker" THEN b."non_striker"
                       ELSE b."striker" END                            AS "player_high",
                  bs."runs_scored"
           FROM   "ball_by_ball"   AS b
           JOIN   "batsman_scored" AS bs
                  ON  b."match_id"   = bs."match_id"
                 AND  b."over_id"    = bs."over_id"
                 AND  b."ball_id"    = bs."ball_id"
                 AND  b."innings_no" = bs."innings_no"
     )
     GROUP  BY "match_id","player_low","player_high"
),
"ranked" AS (
     SELECT *,
            RANK() OVER (PARTITION BY "match_id"
                         ORDER BY "partnership_runs" DESC)             AS "rnk"
     FROM   "partnership"
)
SELECT DISTINCT "match_id",
                "player_low",
                "player_high",
                "partnership_runs"
FROM   "ranked"
WHERE  "rnk" = 1
LIMIT 20;
```

```sql
-- 8. FINAL ANSWER – top partnership(s) per match with players ordered by
--    (i) higher individual contribution, (ii) if tied then higher ID first  
WITH "per_ball" AS (
     SELECT b."match_id",
            b."striker",
            b."non_striker",
            bs."runs_scored"
     FROM   "ball_by_ball"   AS b
     JOIN   "batsman_scored" AS bs
            ON  b."match_id"   = bs."match_id"
           AND  b."over_id"    = bs."over_id"
           AND  b."ball_id"    = bs."ball_id"
           AND  b."innings_no" = bs."innings_no"
),
"partnership" AS (
     SELECT
            "match_id",
            CASE WHEN "striker" < "non_striker" THEN "striker"
                 ELSE "non_striker" END                                 AS "low_id",
            CASE WHEN "striker" < "non_striker" THEN "non_striker"
                 ELSE "striker" END                                     AS "high_id",
            SUM("runs_scored")                                         AS "partnership_runs",
            SUM(CASE WHEN "striker" = CASE WHEN "striker" < "non_striker" THEN "striker"
                                           ELSE "non_striker" END
                     THEN "runs_scored" ELSE 0 END)                    AS "runs_low",
            SUM(CASE WHEN "striker" = CASE WHEN "striker" < "non_striker" THEN "non_striker"
                                           ELSE "striker" END
                     THEN "runs_scored" ELSE 0 END)                    AS "runs_high"
     FROM "per_ball"
     GROUP BY "match_id","low_id","high_id"
),
"ranked" AS (
     SELECT *,
            RANK() OVER (PARTITION BY "match_id"
                         ORDER BY "partnership_runs" DESC)             AS "rnk"
     FROM   "partnership"
),
"top_parts" AS (
     SELECT * FROM "ranked" WHERE "rnk" = 1
),
"ordered" AS (
     SELECT
            "match_id",
            CASE
               WHEN "runs_low" > "runs_high" THEN "low_id"
               WHEN "runs_low" < "runs_high" THEN "high_id"
               ELSE CASE WHEN "low_id" > "high_id" THEN "low_id" ELSE "high_id" END
            END                                                        AS "player1_id",
            CASE
               WHEN "runs_low" > "runs_high" THEN "high_id"
               WHEN "runs_low" < "runs_high" THEN "low_id"
               ELSE CASE WHEN "low_id" > "high_id" THEN "high_id" ELSE "low_id" END
            END                                                        AS "player2_id",
            CASE
               WHEN "runs_low" > "runs_high" THEN "runs_low"
               WHEN "runs_low" < "runs_high" THEN "runs_high"
               ELSE "runs_low"
            END                                                        AS "player1_runs",
            CASE
               WHEN "runs_low" > "runs_high" THEN "runs_high"
               WHEN "runs_low" < "runs_high" THEN "runs_low"
               ELSE "runs_high"
            END                                                        AS "player2_runs",
            "partnership_runs"                                         AS "total_partnership_runs"
     FROM   "top_parts"
)
SELECT DISTINCT *
FROM   "ordered"
ORDER  BY "match_id",
          "player1_id" DESC
LIMIT 20;
```
