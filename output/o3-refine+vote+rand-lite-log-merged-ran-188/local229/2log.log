            WHEN runs_low  < runs_high                        THEN runs_high
            ELSE runs_high
        END                                                   AS player1_runs,
        CASE
            WHEN runs_low  > runs_high                        THEN high_id
            WHEN runs_low  < runs_high                        THEN low_id
            ELSE low_id
