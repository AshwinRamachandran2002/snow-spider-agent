-- 6. Partnership runs PLUS how much each player of the pair scored while together  
SELECT DISTINCT
       t."match_id",
       t."player_low",
       t."player_high",
       SUM(t."runs_scored")                                             AS "partnership_runs",
       SUM(CASE WHEN t."striker" = t."player_low"  THEN t."runs_scored"
                ELSE 0 END)                                             AS "runs_low",
       SUM(CASE WHEN t."striker" = t."player_high" THEN t."runs_scored"
                ELSE 0 END)                                             AS "runs_high"
FROM (
      SELECT b."match_id",
             b."striker",
             b."non_striker",
             CASE WHEN b."striker" < b."non_striker" THEN b."striker"
                  ELSE b."non_striker" END                              AS "player_low",
             CASE WHEN b."striker" < b."non_striker" THEN b."non_striker"
                  ELSE b."striker" END                                  AS "player_high",
             bs."runs_scored"
      FROM   "ball_by_ball"   AS b
      JOIN   "batsman_scored" AS bs
             ON  b."match_id"   = bs."match_id"
            AND  b."over_id"    = bs."over_id"
            AND  b."ball_id"    = bs."ball_id"
            AND  b."innings_no" = bs."innings_no"
) AS t
GROUP  BY t."match_id",
          t."player_low",
          t."player_high"
LIMIT 20;
