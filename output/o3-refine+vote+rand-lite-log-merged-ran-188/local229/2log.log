-- 5. Partnership runs for every unordered pair of batsmen in every match  
SELECT DISTINCT
       b."match_id",
       CASE WHEN b."striker" < b."non_striker" THEN b."striker"
            ELSE b."non_striker" END          AS "player_low",
       CASE WHEN b."striker" < b."non_striker" THEN b."non_striker"
            ELSE b."striker" END              AS "player_high",
       SUM(bs."runs_scored")                  AS "partnership_runs"
FROM   "ball_by_ball"   AS b
JOIN   "batsman_scored" AS bs
       ON  b."match_id"   = bs."match_id"
      AND  b."over_id"    = bs."over_id"
      AND  b."ball_id"    = bs."ball_id"
      AND  b."innings_no" = bs."innings_no"
GROUP  BY b."match_id",
          "player_low",
          "player_high"
LIMIT 20;
