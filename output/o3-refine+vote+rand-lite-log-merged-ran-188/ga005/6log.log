--Description: 6) Count the size of every weekly cohort whose Monday falls between 9-Jul and 17-Sep-2018.
WITH new_users AS (
  SELECT DISTINCT
    user_pseudo_id,
    DATE_TRUNC(DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)), WEEK(MONDAY)) AS cohort_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180917'
