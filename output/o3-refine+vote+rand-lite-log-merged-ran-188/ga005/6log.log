```sql
--Description: 7) For one cohort (9-Jul-2018) show users who return with a session_start  
--   in exactly Week 2 (14-20 days after the cohort week).
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND event_date = FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)))
    AND DATE_TRUNC(DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)), WEEK(MONDAY)) = '2018-07-09'
),
events AS (
  SELECT 
    user_pseudo_id,
    DATE(TIMESTAMP_MICROS(event_timestamp)) AS ev_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180723' AND '20180729'   --14-20 days window
)
SELECT DISTINCT e.user_pseudo_id
FROM cohort c
JOIN events e USING (user_pseudo_id)
LIMIT 20;
```

```sql
--Description: 8) Compute Week 2 retained users and retention rate only for the 9-Jul-2018 cohort.
WITH base AS (
  SELECT 
    user_pseudo_id,
    DATE_TRUNC(DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)), WEEK(MONDAY)) AS cohort_week_start,
    DATE(TIMESTAMP_MICROS(event_timestamp)) AS ev_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180805'   --covers cohort + two weeks
    AND event_name = 'session_start'
),
cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM base
  WHERE cohort_week_start = '2018-07-09'
    AND ev_date = DATE('2018-07-09')        --day-0 event = new user
),
retained AS (
  SELECT DISTINCT b.user_pseudo_id
  FROM base b
  JOIN cohort c USING (user_pseudo_id)
  WHERE ev_date BETWEEN DATE('2018-07-23') AND DATE('2018-07-29')   --week 2 window
)
SELECT
  (SELECT COUNT(*) FROM cohort) AS cohort_size,
  (SELECT COUNT(*) FROM retained) AS retained_users,
  SAFE_DIVIDE((SELECT COUNT(*) FROM retained), (SELECT COUNT(*) FROM cohort)) AS week2_retention_rate
LIMIT 20;
```

```sql
--Description: 9) Produce Week 2 retained-user counts for every cohort Monday from 09-Jul-2018 to 17-Sep-2018.
WITH base_events AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)), WEEK(MONDAY)) AS cohort_week_start,
    DATE(TIMESTAMP_MICROS(event_timestamp)) AS ev_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
),
new_users AS (
  SELECT DISTINCT user_pseudo_id, cohort_week_start
  FROM base_events
  WHERE ev_date = cohort_week_start          --day-0 of the cohort
    AND cohort_week_start BETWEEN '2018-07-09' AND '2018-09-17'
),
week2_events AS (
  SELECT DISTINCT
    b.user_pseudo_id,
    n.cohort_week_start
  FROM new_users n
  JOIN base_events b
    ON b.user_pseudo_id = n.user_pseudo_id
   AND b.ev_date BETWEEN DATE_ADD(n.cohort_week_start, INTERVAL 14 DAY)
                     AND DATE_ADD(n.cohort_week_start, INTERVAL 20 DAY)
)
SELECT
  n.cohort_week_start,
  COUNT(DISTINCT n.user_pseudo_id) AS cohort_size,
  COUNT(DISTINCT w.user_pseudo_id) AS retained_users
FROM new_users n
LEFT JOIN week2_events w
  ON n.user_pseudo_id = w.user_pseudo_id
GROUP BY n.cohort_week_start
ORDER BY n.cohort_week_start
LIMIT 20;
```

```sql
--Description: 10) FINAL – Week 2 retention rate for each weekly cohort (Mon-based)  
--   09-Jul-2018 → 17-Sep-2018, ordered chronologically.
WITH base AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)), WEEK(MONDAY)) AS cohort_week_start,
    DATE(TIMESTAMP_MICROS(event_timestamp)) AS ev_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
),
new_users AS (
  -- Users whose very first session happens during their cohort week (day-0)
  SELECT DISTINCT
    user_pseudo_id,
    cohort_week_start
  FROM base
  WHERE ev_date = cohort_week_start
    AND cohort_week_start BETWEEN '2018-07-09' AND '2018-09-17'
),
week2_retained AS (
  -- Those same users having another session_start in week 2 (days 14-20)
  SELECT DISTINCT
    b.user_pseudo_id,
    n.cohort_week_start
  FROM new_users n
  JOIN base b
    ON b.user_pseudo_id = n.user_pseudo_id
   AND b.ev_date BETWEEN DATE_ADD(n.cohort_week_start, INTERVAL 14 DAY)
                     AND DATE_ADD(n.cohort_week_start, INTERVAL 20 DAY)
)
SELECT
  cohort_week_start                                         AS cohort_date,
  SAFE_DIVIDE(COUNT(DISTINCT week2_retained.user_pseudo_id),
              COUNT(DISTINCT new_users.user_pseudo_id))     AS week2_retention_rate
FROM new_users
LEFT JOIN week2_retained
  USING (user_pseudo_id, cohort_week_start)
GROUP BY cohort_week_start
ORDER BY cohort_week_start
LIMIT 20;
```
