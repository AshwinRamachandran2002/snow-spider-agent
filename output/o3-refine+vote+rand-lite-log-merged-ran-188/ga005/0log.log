--Description: 7) Number of users retained in WEEK 2 (week_gap = 2) for each cohort  
SELECT
  c.cohort_week_start ,
  COUNT(DISTINCT r.user_pseudo_id) AS retained_wk2_users
FROM (
  --cohort members
  SELECT
    user_pseudo_id ,
    DATE_TRUNC( PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) , WEEK(MONDAY) ) AS cohort_week_start
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180930'
    AND event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) = DATE( TIMESTAMP_MICROS(user_first_touch_timestamp) )
)  c
JOIN `firebase-public-project.analytics_153293282.events_*` r
ON  r.user_pseudo_id = c.user_pseudo_id
WHERE r._TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
  AND r.event_name   = 'session_start'
  AND DATE_DIFF( DATE_TRUNC( PARSE_DATE('%Y%m%d', r._TABLE_SUFFIX) , WEEK(MONDAY)) ,
                 c.cohort_week_start ,
                 WEEK(MONDAY) ) = 2
GROUP BY c.cohort_week_start
ORDER BY c.cohort_week_start
LIMIT 20;
