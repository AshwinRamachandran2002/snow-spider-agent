             u.cohort_week_start ,
             WEEK(MONDAY) )                                         AS week_gap
FROM (
  --cohort membership
  SELECT
    user_pseudo_id ,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', _TABLE_SUFFIX), WEEK(MONDAY)) AS cohort_week_start
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180715'   --week of 9-Jul-2018
    AND event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) = DATE(TIMESTAMP_MICROS(user_first_touch_timestamp))
) u
JOIN `firebase-public-project.analytics_153293282.events_*` AS e
ON  e.user_pseudo_id = u.user_pseudo_id
WHERE e._TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
  AND e.event_name   = 'session_start'
LIMIT 20;
```

```sql
--Description: 6) Cohort sizes for every Monday between 2018-07-09 & 2018-09-17  
SELECT
  cohort_week_start ,
  COUNT(DISTINCT user_pseudo_id) AS cohort_size
FROM (
  SELECT
    user_pseudo_id ,
    DATE_TRUNC( PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) , WEEK(MONDAY) ) AS cohort_week_start
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180930'
    AND event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) = DATE( TIMESTAMP_MICROS(user_first_touch_timestamp) )
)
GROUP BY cohort_week_start
ORDER BY cohort_week_start
LIMIT 20;
```

```sql
--Description: 7) Number of users retained in WEEK 2 (week_gap = 2) for each cohort  
SELECT
  c.cohort_week_start ,
  COUNT(DISTINCT r.user_pseudo_id) AS retained_wk2_users
FROM (
  --cohort members
  SELECT
    user_pseudo_id ,
    DATE_TRUNC( PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) , WEEK(MONDAY) ) AS cohort_week_start
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180930'
    AND event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) = DATE( TIMESTAMP_MICROS(user_first_touch_timestamp) )
)  c
JOIN `firebase-public-project.analytics_153293282.events_*` r
ON  r.user_pseudo_id = c.user_pseudo_id
WHERE r._TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
  AND r.event_name   = 'session_start'
  AND DATE_DIFF( DATE_TRUNC( PARSE_DATE('%Y%m%d', r._TABLE_SUFFIX) , WEEK(MONDAY)) ,
                 c.cohort_week_start ,
                 WEEK(MONDAY) ) = 2
GROUP BY c.cohort_week_start
ORDER BY c.cohort_week_start
LIMIT 20;
```

```sql
--Description: 8) FINAL – Week-2 retention rate for cohorts Monday 2018-07-09 through 2018-09-17  
SELECT
  cohort_week_start ,
  cohort_size ,
  retained_wk2_users ,
  SAFE_DIVIDE(retained_wk2_users , cohort_size) AS week2_retention_rate
FROM (
  --cohort sizes
  SELECT
    cohort_week_start ,
    COUNT(DISTINCT user_pseudo_id) AS cohort_size
  FROM (
    SELECT
      user_pseudo_id ,
      DATE_TRUNC( PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) , WEEK(MONDAY)) AS cohort_week_start
    FROM  `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180930'
      AND event_name = 'session_start'
      AND PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) = DATE( TIMESTAMP_MICROS(user_first_touch_timestamp) )
  )
  GROUP BY cohort_week_start
)  s
LEFT JOIN (
  --retained users (week_gap = 2)
  SELECT
    c.cohort_week_start ,
    COUNT(DISTINCT r.user_pseudo_id) AS retained_wk2_users
  FROM (
    SELECT
      user_pseudo_id ,
      DATE_TRUNC( PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) , WEEK(MONDAY)) AS cohort_week_start
    FROM  `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180930'
      AND event_name = 'session_start'
      AND PARSE_DATE('%Y%m%d', _TABLE_SUFFIX) = DATE( TIMESTAMP_MICROS(user_first_touch_timestamp) )
  ) c
  JOIN `firebase-public-project.analytics_153293282.events_*` r
  ON  r.user_pseudo_id = c.user_pseudo_id
  WHERE r._TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND r.event_name   = 'session_start'
    AND DATE_DIFF( DATE_TRUNC( PARSE_DATE('%Y%m%d', r._TABLE_SUFFIX) , WEEK(MONDAY)),
                   c.cohort_week_start ,
                   WEEK(MONDAY) ) = 2
  GROUP BY c.cohort_week_start
)  r
USING (cohort_week_start)
WHERE cohort_week_start BETWEEN DATE '2018-07-09' AND DATE '2018-09-17'
ORDER BY cohort_week_start
LIMIT 20;
```
