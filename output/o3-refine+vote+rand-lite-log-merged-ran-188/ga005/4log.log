Query:
--Description: 5)  Inspect whether those new-cohort users appear again exactly 2 weeks later.
WITH new_users AS (
  SELECT DISTINCT
        user_pseudo_id,
        DATE_TRUNC(DATE(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180917'           -- cohorts we can study
    AND event_name = 'session_start'
    AND event_date = FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
)
SELECT
  cohort_week_start,
  COUNT(DISTINCT user_pseudo_id) AS users_in_cohort
FROM new_users
GROUP BY cohort_week_start
ORDER BY cohort_week_start
LIMIT 20;
