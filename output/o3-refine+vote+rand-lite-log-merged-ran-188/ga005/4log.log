--Description: 7)  Aggregate previous query: count “week-2” returners for every cohort-week.
WITH cohorts AS (
  SELECT DISTINCT
        user_pseudo_id,
        DATE_TRUNC(DATE(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180917'
    AND event_name = 'session_start'
    AND event_date = FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
),
week2 AS (
  SELECT DISTINCT
        c.user_pseudo_id,
        c.cohort_week_start
  FROM cohorts         AS c
  JOIN `firebase-public-project.analytics_153293282.events_*` AS s
    ON s.user_pseudo_id = c.user_pseudo_id
  WHERE s.event_name = 'session_start'
    AND s._TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND DATE(PARSE_DATE('%Y%m%d', s.event_date))
        BETWEEN DATE_ADD(c.cohort_week_start, INTERVAL 14 DAY)
            AND DATE_ADD(c.cohort_week_start, INTERVAL 20 DAY)
)
SELECT
  cohort_week_start,
  COUNT(DISTINCT user_pseudo_id) AS week2_returning_users
FROM week2
GROUP BY cohort_week_start
ORDER BY cohort_week_start
LIMIT 20;
