Query:
--Description: 3)  Count how many *new* users there are each calendar day
--                 (a new user is one whose first_touch date = event_date).
SELECT
  event_date,
  COUNT(DISTINCT user_pseudo_id) AS new_users
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180701' AND '20181002'
  AND event_name = 'session_start'
  AND event_date = FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
GROUP BY event_date
ORDER BY event_date
LIMIT 20;
