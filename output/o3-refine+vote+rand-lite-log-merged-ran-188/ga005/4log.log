--Description: 10)  Final answer exactly as requested ‑ week-by-week 2-week retention,
--                  restricted to cohorts 09-Jul-2018 through 17-Sep-2018, ordered chronologically.
WITH
sessions AS (
  SELECT user_pseudo_id,
         DATE(PARSE_DATE('%Y%m%d', event_date))                           AS event_day,
         TIMESTAMP_MICROS(user_first_touch_timestamp)                     AS first_touch_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
),
new_users AS (
  SELECT DISTINCT
    user_pseudo_id,
    DATE_TRUNC(event_day, WEEK(MONDAY))                                   AS cohort_week_start
  FROM sessions
  WHERE event_day = DATE(first_touch_ts)
    AND DATE_TRUNC(event_day, WEEK(MONDAY)) BETWEEN '2018-07-09' AND '2018-09-17'
),
week2_sessions AS (
  SELECT DISTINCT
    s.user_pseudo_id,
    n.cohort_week_start
  FROM sessions  AS s
  JOIN new_users AS n
    ON s.user_pseudo_id = n.user_pseudo_id
  WHERE s.event_day BETWEEN DATE_ADD(n.cohort_week_start, INTERVAL 14 DAY)
                        AND DATE_ADD(n.cohort_week_start, INTERVAL 20 DAY)
)
SELECT
  n.cohort_week_start                                         AS cohort_monday,
  ROUND(100 * SAFE_DIVIDE(COUNT(DISTINCT w.user_pseudo_id),
                           COUNT(DISTINCT n.user_pseudo_id)), 2) AS week2_retention_pct
FROM new_users n
LEFT JOIN week2_sessions w
       ON n.user_pseudo_id = w.user_pseudo_id
GROUP BY cohort_monday
ORDER BY cohort_monday
LIMIT 20;
