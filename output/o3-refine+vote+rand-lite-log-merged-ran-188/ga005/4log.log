```

```sql
--Description: 2)  See a few raw “session_start” rows in the week that will become our first cohort (week of 9-Jul-2018).
SELECT
  event_date,
  user_pseudo_id,
  TIMESTAMP_MICROS(user_first_touch_timestamp)  AS first_touch_ts
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX = '20180709'                 -- Monday 9-Jul-2018
  AND event_name   = 'session_start'
LIMIT 20;
```

```sql
--Description: 3)  Count how many *new* users there are each calendar day
--                 (a new user is one whose first_touch date = event_date).
SELECT
  event_date,
  COUNT(DISTINCT user_pseudo_id) AS new_users
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180701' AND '20181002'
  AND event_name = 'session_start'
  AND event_date = FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
GROUP BY event_date
ORDER BY event_date
LIMIT 20;
```

```sql
--Description: 4)  Show how those new-user days collapse into their cohort-week
--                 (weeks are Monday-to-Sunday).
SELECT
  DATE_TRUNC(DATE(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_week_start,
  COUNT(DISTINCT user_pseudo_id)                                   AS cohort_users
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180701' AND '20181002'
  AND event_name = 'session_start'
  AND event_date = FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
GROUP BY cohort_week_start
ORDER BY cohort_week_start
LIMIT 20;
```

```sql
--Description: 5)  Inspect whether those new-cohort users appear again exactly 2 weeks later.
WITH new_users AS (
  SELECT DISTINCT
        user_pseudo_id,
        DATE_TRUNC(DATE(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180917'           -- cohorts we can study
    AND event_name = 'session_start'
    AND event_date = FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
)
SELECT
  cohort_week_start,
  COUNT(DISTINCT user_pseudo_id) AS users_in_cohort
FROM new_users
GROUP BY cohort_week_start
ORDER BY cohort_week_start
LIMIT 20;
```

```sql
--Description: 6)  Pull all session_start rows for those cohort users during their “week 2”
WITH cohorts AS (
  SELECT DISTINCT
        user_pseudo_id,
        DATE_TRUNC(DATE(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180917'
    AND event_name = 'session_start'
    AND event_date = FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
)
SELECT
  c.cohort_week_start,
  s.event_date,
  c.user_pseudo_id
FROM cohorts   AS c
JOIN `firebase-public-project.analytics_153293282.events_*`  AS s
  ON s.user_pseudo_id = c.user_pseudo_id
WHERE s.event_name   = 'session_start'
  AND s._TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
  AND DATE(PARSE_DATE('%Y%m%d', s.event_date))
      BETWEEN DATE_ADD(c.cohort_week_start, INTERVAL 14 DAY)
          AND DATE_ADD(c.cohort_week_start, INTERVAL 20 DAY)
LIMIT 20;
```

```sql
--Description: 7)  Aggregate previous query: count “week-2” returners for every cohort-week.
WITH cohorts AS (
  SELECT DISTINCT
        user_pseudo_id,
        DATE_TRUNC(DATE(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180917'
    AND event_name = 'session_start'
    AND event_date = FORMAT_TIMESTAMP('%Y%m%d', TIMESTAMP_MICROS(user_first_touch_timestamp))
),
week2 AS (
  SELECT DISTINCT
        c.user_pseudo_id,
        c.cohort_week_start
  FROM cohorts         AS c
  JOIN `firebase-public-project.analytics_153293282.events_*` AS s
    ON s.user_pseudo_id = c.user_pseudo_id
  WHERE s.event_name = 'session_start'
    AND s._TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND DATE(PARSE_DATE('%Y%m%d', s.event_date))
        BETWEEN DATE_ADD(c.cohort_week_start, INTERVAL 14 DAY)
            AND DATE_ADD(c.cohort_week_start, INTERVAL 20 DAY)
)
SELECT
  cohort_week_start,
  COUNT(DISTINCT user_pseudo_id) AS week2_returning_users
FROM week2
GROUP BY cohort_week_start
ORDER BY cohort_week_start
LIMIT 20;
```

```sql
--Description: 8)  Bring cohort size and week-2 returners together to compute retention rate.
WITH
sessions AS (
  SELECT
    user_pseudo_id,
    event_date,
    _TABLE_SUFFIX,
    event_name,
    TIMESTAMP_MICROS(user_first_touch_timestamp) AS first_touch_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
),
new_users AS (            -- users whose very first session is the one we observe
  SELECT DISTINCT
    user_pseudo_id,
    DATE_TRUNC(DATE(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_week_start
  FROM sessions
  WHERE event_date = FORMAT_TIMESTAMP('%Y%m%d', first_touch_ts)
    AND DATE_TRUNC(DATE(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY))
        BETWEEN '2018-07-09' AND '2018-09-17'
),
week2_sessions AS (
  SELECT DISTINCT
    s.user_pseudo_id,
    n.cohort_week_start
  FROM sessions AS s
  JOIN new_users AS n
    ON s.user_pseudo_id = n.user_pseudo_id
  WHERE DATE(PARSE_DATE('%Y%m%d', s.event_date))
        BETWEEN DATE_ADD(n.cohort_week_start, INTERVAL 14 DAY)
            AND DATE_ADD(n.cohort_week_start, INTERVAL 20 DAY)
)
SELECT
  n.cohort_week_start                                              AS cohort_week_monday,
  COUNT(DISTINCT n.user_pseudo_id)                                 AS users_in_cohort,
  COUNT(DISTINCT w.user_pseudo_id)                                 AS users_in_week2,
  SAFE_DIVIDE(COUNT(DISTINCT w.user_pseudo_id),
              COUNT(DISTINCT n.user_pseudo_id))                    AS week2_retention_rate
FROM new_users n
LEFT JOIN week2_sessions w
       ON n.user_pseudo_id = w.user_pseudo_id
GROUP BY cohort_week_monday
ORDER BY cohort_week_monday
LIMIT 20;
```

```sql
--Description: 9)  (Optional)  Show the top-10 cohorts with the highest week-2 retention.
WITH analytic AS (
  /* ===  previous query (8) without the final LIMIT  === */
  WITH
  sessions AS (
    SELECT user_pseudo_id, event_date, _TABLE_SUFFIX, event_name,
           TIMESTAMP_MICROS(user_first_touch_timestamp) AS first_touch_ts
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
      AND event_name = 'session_start'
  ),
  new_users AS (
    SELECT DISTINCT
      user_pseudo_id,
      DATE_TRUNC(DATE(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_week_start
    FROM sessions
    WHERE event_date = FORMAT_TIMESTAMP('%Y%m%d', first_touch_ts)
      AND DATE_TRUNC(DATE(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY))
          BETWEEN '2018-07-09' AND '2018-09-17'
  ),
  week2_sessions AS (
    SELECT DISTINCT
      s.user_pseudo_id,
      n.cohort_week_start
    FROM sessions AS s
    JOIN new_users AS n
      ON s.user_pseudo_id = n.user_pseudo_id
    WHERE DATE(PARSE_DATE('%Y%m%d', s.event_date))
          BETWEEN DATE_ADD(n.cohort_week_start, INTERVAL 14 DAY)
              AND DATE_ADD(n.cohort_week_start, INTERVAL 20 DAY)
  )
  SELECT
    n.cohort_week_start  AS cohort_week_monday,
    COUNT(DISTINCT n.user_pseudo_id) AS users_in_cohort,
    COUNT(DISTINCT w.user_pseudo_id) AS users_in_week2,
    SAFE_DIVIDE(COUNT(DISTINCT w.user_pseudo_id),
                COUNT(DISTINCT n.user_pseudo_id)) AS week2_retention_rate
  FROM new_users n
  LEFT JOIN week2_sessions w
         ON n.user_pseudo_id = w.user_pseudo_id
  GROUP BY cohort_week_monday
)
SELECT *
FROM analytic
ORDER BY week2_retention_rate DESC
LIMIT 10;
```

```sql
--Description: 10)  Final answer exactly as requested ‑ week-by-week 2-week retention,
--                  restricted to cohorts 09-Jul-2018 through 17-Sep-2018, ordered chronologically.
WITH
sessions AS (
  SELECT user_pseudo_id,
         DATE(PARSE_DATE('%Y%m%d', event_date))                           AS event_day,
         TIMESTAMP_MICROS(user_first_touch_timestamp)                     AS first_touch_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
),
new_users AS (
  SELECT DISTINCT
    user_pseudo_id,
    DATE_TRUNC(event_day, WEEK(MONDAY))                                   AS cohort_week_start
  FROM sessions
  WHERE event_day = DATE(first_touch_ts)
    AND DATE_TRUNC(event_day, WEEK(MONDAY)) BETWEEN '2018-07-09' AND '2018-09-17'
),
week2_sessions AS (
  SELECT DISTINCT
    s.user_pseudo_id,
    n.cohort_week_start
  FROM sessions  AS s
  JOIN new_users AS n
    ON s.user_pseudo_id = n.user_pseudo_id
  WHERE s.event_day BETWEEN DATE_ADD(n.cohort_week_start, INTERVAL 14 DAY)
                        AND DATE_ADD(n.cohort_week_start, INTERVAL 20 DAY)
)
SELECT
  n.cohort_week_start                                         AS cohort_monday,
  ROUND(100 * SAFE_DIVIDE(COUNT(DISTINCT w.user_pseudo_id),
                           COUNT(DISTINCT n.user_pseudo_id)), 2) AS week2_retention_pct
FROM new_users n
LEFT JOIN week2_sessions w
       ON n.user_pseudo_id = w.user_pseudo_id
GROUP BY cohort_monday
ORDER BY cohort_monday
LIMIT 20;
```
