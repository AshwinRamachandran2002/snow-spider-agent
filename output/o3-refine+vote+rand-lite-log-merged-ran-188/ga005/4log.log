Query:
--Description: 1)  What event-days are contained in the public GA4 export that we will analyse?
SELECT DISTINCT
  event_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180701' AND '20181002'
ORDER BY event_date
LIMIT 20;
