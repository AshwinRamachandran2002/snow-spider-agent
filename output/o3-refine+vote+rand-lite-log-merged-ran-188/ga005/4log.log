Query:
--Description: 8)  Bring cohort size and week-2 returners together to compute retention rate.
WITH
sessions AS (
  SELECT
    user_pseudo_id,
    event_date,
    _TABLE_SUFFIX,
    event_name,
    TIMESTAMP_MICROS(user_first_touch_timestamp) AS first_touch_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
),
new_users AS (            -- users whose very first session is the one we observe
  SELECT DISTINCT
    user_pseudo_id,
    DATE_TRUNC(DATE(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_week_start
  FROM sessions
  WHERE event_date = FORMAT_TIMESTAMP('%Y%m%d', first_touch_ts)
    AND DATE_TRUNC(DATE(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY))
        BETWEEN '2018-07-09' AND '2018-09-17'
),
week2_sessions AS (
  SELECT DISTINCT
    s.user_pseudo_id,
    n.cohort_week_start
  FROM sessions AS s
  JOIN new_users AS n
    ON s.user_pseudo_id = n.user_pseudo_id
  WHERE DATE(PARSE_DATE('%Y%m%d', s.event_date))
        BETWEEN DATE_ADD(n.cohort_week_start, INTERVAL 14 DAY)
            AND DATE_ADD(n.cohort_week_start, INTERVAL 20 DAY)
)
SELECT
  n.cohort_week_start                                              AS cohort_week_monday,
  COUNT(DISTINCT n.user_pseudo_id)                                 AS users_in_cohort,
  COUNT(DISTINCT w.user_pseudo_id)                                 AS users_in_week2,
  SAFE_DIVIDE(COUNT(DISTINCT w.user_pseudo_id),
              COUNT(DISTINCT n.user_pseudo_id))                    AS week2_retention_rate
FROM new_users n
LEFT JOIN week2_sessions w
       ON n.user_pseudo_id = w.user_pseudo_id
GROUP BY cohort_week_monday
ORDER BY cohort_week_monday
LIMIT 20;
