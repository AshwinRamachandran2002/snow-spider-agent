    n.cohort_week_start
  FROM sessions AS s
  JOIN new_users AS n
    ON s.user_pseudo_id = n.user_pseudo_id
  WHERE DATE(PARSE_DATE('%Y%m%d', s.event_date))
        BETWEEN DATE_ADD(n.cohort_week_start, INTERVAL 14 DAY)
            AND DATE_ADD(n.cohort_week_start, INTERVAL 20 DAY)
)
SELECT
