/*  Kings County (FIPS 36047) census tracts that
    • are in the nationwide top-20 for % population growth (2011→2018)
    • are in the nationwide top-20 for absolute median-income growth (2011→2018)
    • had >1,000 residents in both years
*/

WITH joined AS (        -- 2011 vs 2018 tract-level comparison
  SELECT
    t11.geo_id,
    t11.total_pop                                    AS pop_2011,
    t18.total_pop                                    AS pop_2018,
    t11.median_income                                AS inc_2011,
    t18.median_income                                AS inc_2018,
    SAFE_DIVIDE(t18.total_pop - t11.total_pop,
                t11.total_pop)                       AS pct_pop_growth,
    (t18.median_income - t11.median_income)          AS abs_inc_growth
  FROM  `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` t11
  JOIN  `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` t18
  USING (geo_id)
  WHERE t11.total_pop  > 1000             -- residence threshold (both years)
    AND t18.total_pop  > 1000
    AND t11.median_income IS NOT NULL
    AND t18.median_income IS NOT NULL
),

-- nationwide top-20 by % population growth
pop_top AS (
  SELECT geo_id
  FROM   joined
  ORDER BY pct_pop_growth DESC
  LIMIT  20
),

-- nationwide top-20 by absolute median-income growth
inc_top AS (
  SELECT geo_id
  FROM   joined
  ORDER BY abs_inc_growth DESC
  LIMIT  20
)

SELECT
  j.geo_id,
  j.pop_2011,
  j.pop_2018,
  ROUND(j.pct_pop_growth, 4) AS pct_pop_growth,
  j.inc_2011,
  j.inc_2018,
  j.abs_inc_growth
FROM   joined AS j
JOIN   pop_top USING (geo_id)
JOIN   inc_top USING (geo_id)
WHERE  j.geo_id LIKE '36047%'          -- Kings County tracts
ORDER  BY j.geo_id;
