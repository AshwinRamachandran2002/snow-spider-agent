```sql
--Description: Join 2011 & 2018 tract tables (Kings County only) and preview growth metrics
SELECT
  t11.geo_id,
  t11.total_pop  AS pop_2011,
  t18.total_pop  AS pop_2018,
  (t18.total_pop - t11.total_pop)/t11.total_pop AS pct_pop_growth,
  t11.median_income AS inc_2011,
  t18.median_income AS inc_2018,
  (t18.median_income - t11.median_income)       AS abs_inc_growth
FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` t11
JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` t18
USING (geo_id)
WHERE geo_id LIKE '36047%'
LIMIT 20;
```

```sql
--Description: Across the entire U.S., find top-20 tracts by percentage population increase (2011→2018)
WITH joined AS (
  SELECT
    t11.geo_id,
    t11.total_pop AS pop_2011,
    t18.total_pop AS pop_2018,
    (t18.total_pop - t11.total_pop)/t11.total_pop AS pct_pop_growth
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr`  t11
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`  t18
  USING (geo_id)
  WHERE t11.total_pop > 1000 AND t18.total_pop > 1000
)
SELECT geo_id, pop_2011, pop_2018, pct_pop_growth
FROM joined
ORDER BY pct_pop_growth DESC
LIMIT 20;
```

```sql
--Description: Across the entire U.S., find top-20 tracts by absolute median-income increase (2011→2018)
WITH joined AS (
  SELECT
    t11.geo_id,
    t11.median_income AS inc_2011,
    t18.median_income AS inc_2018,
    (t18.median_income - t11.median_income) AS abs_inc_growth
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr`  t11
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`  t18
  USING (geo_id)
  WHERE t11.total_pop > 1000 AND t18.total_pop > 1000
)
SELECT geo_id, inc_2011, inc_2018, abs_inc_growth
FROM joined
ORDER BY abs_inc_growth DESC
LIMIT 20;
```

```sql
--Description: Final answer – Kings County tracts ranking in BOTH top-20 lists above and with >1,000 residents
WITH metrics AS (
  SELECT
    t11.geo_id,
    t11.total_pop AS pop_2011,
    t18.total_pop AS pop_2018,
    (t18.total_pop - t11.total_pop)/t11.total_pop AS pct_pop_growth,
    t11.median_income AS inc_2011,
    t18.median_income AS inc_2018,
    (t18.median_income - t11.median_income)      AS abs_inc_growth
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr`  t11
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`  t18
  USING (geo_id)
  WHERE t11.total_pop > 1000 AND t18.total_pop > 1000
),
ranks AS (
  SELECT
    *,
    RANK() OVER (ORDER BY pct_pop_growth DESC) AS pop_pct_rank,
    RANK() OVER (ORDER BY abs_inc_growth DESC) AS inc_abs_rank
  FROM metrics
)
SELECT
  geo_id,
  pop_2011,
  pop_2018,
  ROUND(pct_pop_growth*100,2)      AS pct_pop_growth_percent,
  inc_2011,
  inc_2018,
  abs_inc_growth
FROM ranks
WHERE pop_pct_rank <= 20
  AND inc_abs_rank <= 20
  AND geo_id LIKE '36047%'
ORDER BY pop_pct_rank, inc_abs_rank;
```
