```sql
--Description / Thinking process:
-- We need Kings County (NY – FIPS prefix 36047) census tracts that:
--   1. Had more than 1,000 residents in both 2011 and 2018 (5-year ACS).
--   2. Are in the TOP-20 within Kings County for
--        a) percent population growth (2011 → 2018) AND
--        b) absolute median-income growth (2011 → 2018).
--
-- Steps implemented below:
--   • Join 2011_5yr and 2018_5yr tract tables on geo_id.
--   • Filter to geo_id LIKE '36047%' and pop > 1,000 both years.
--   • Compute pct_pop_growth and abs_inc_growth.
--   • Rank (within the county) on each metric.
--   • Select tracts whose ranks ≤ 20 on BOTH lists.
WITH metrics AS (
  SELECT
    t11.geo_id,
    t11.total_pop                           AS pop_2011,
    t18.total_pop                           AS pop_2018,
    SAFE_DIVIDE(t18.total_pop - t11.total_pop,
                t11.total_pop)              AS pct_pop_growth,
    t11.median_income                       AS inc_2011,
    t18.median_income                       AS inc_2018,
    (t18.median_income - t11.median_income) AS abs_inc_growth
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` t11
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` t18
    USING (geo_id)
  WHERE geo_id LIKE '36047%'      -- Kings County tracts
    AND t11.total_pop > 1000
    AND t18.total_pop > 1000
    AND t11.median_income IS NOT NULL
    AND t18.median_income IS NOT NULL
),
ranked AS (
  SELECT
    *,
    RANK() OVER (ORDER BY pct_pop_growth DESC) AS pop_rank,
    RANK() OVER (ORDER BY abs_inc_growth DESC) AS inc_rank
  FROM metrics
)
SELECT
  geo_id,
  pop_2011,
  pop_2018,
  ROUND(pct_pop_growth * 100, 2) AS pct_pop_growth_pct,
  inc_2011,
  inc_2018,
  abs_inc_growth,
  pop_rank,
  inc_rank
FROM ranked
WHERE pop_rank <= 20
  AND inc_rank <= 20
ORDER BY pop_rank, inc_rank;
