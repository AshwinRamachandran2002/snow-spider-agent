```sql
-- Tracts in Kings County (FIPS 36047) that are simultaneously
--  • Top-20 nationwide in % population growth (2011→2018)
--  • Top-20 nationwide in absolute median-income growth (2011→2018)
--  • Had >1,000 residents in both 2011 & 2018

WITH joined AS (
  SELECT
    t11.geo_id,
    t11.total_pop        AS pop_2011,
    t18.total_pop        AS pop_2018,
    t11.median_income    AS inc_2011,
    t18.median_income    AS inc_2018,
    SAFE_DIVIDE(t18.total_pop - t11.total_pop, t11.total_pop) AS pct_pop_growth,
    (t18.median_income - t11.median_income)                  AS abs_inc_growth
  FROM `bigquery-public-data.census_bureau_acs.censustract_2011_5yr` t11
  JOIN `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` t18
  USING (geo_id)
  WHERE t11.total_pop     > 1000
    AND t18.total_pop     > 1000
    AND t11.median_income > 0
    AND t18.median_income > 0
),
ranked AS (
  SELECT
    j.*,
    DENSE_RANK() OVER (ORDER BY pct_pop_growth DESC) AS pop_rank,
    DENSE_RANK() OVER (ORDER BY abs_inc_growth DESC) AS inc_rank
  FROM joined j
)
SELECT
  geo_id,
  pop_2011,
  pop_2018,
  ROUND(pct_pop_growth, 4) AS pct_pop_growth,
  inc_2011,
  inc_2018,
  abs_inc_growth
FROM ranked
WHERE pop_rank <= 20            -- top 20 by % pop growth
  AND inc_rank <= 20            -- top 20 by $ income growth
  AND geo_id LIKE '36047%'      -- Kings County tracts
ORDER BY geo_id;
