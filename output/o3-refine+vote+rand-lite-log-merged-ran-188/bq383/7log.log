2025-05-02 06:33:42 - Thread-1024 (execute) - INFO - [Try to run SQL in self-refine]
```sql
/* Highest precipitation (mm), lowest minimum‑temperature (°C), and highest maximum‑temperature (°C)
   during the last 15 days (Dec 17 – Dec 31) of each calendar year 2013–2016
   for weather station USW00094846.
*/
WITH period_data AS (
  SELECT
    EXTRACT(YEAR FROM `date`)                  AS yr,
    element,
    ROUND(value / 10.0, 4)                    AS val          -- convert: tenths → full units
  FROM `bigquery-public-data.ghcn_d.ghcnd_20*`
  WHERE _TABLE_SUFFIX IN ('2013','2014','2015','2016')         -- keep only needed tables
    AND id = 'USW00094846'                                     -- target station
    AND qflag IS NULL                                          -- use only validated rows
    AND value IS NOT NULL
    AND `date` BETWEEN DATE(EXTRACT(YEAR FROM `date`),12,17)   -- last 15 days of the year
                  AND DATE(EXTRACT(YEAR FROM `date`),12,31)
    AND element IN ('PRCP','TMIN','TMAX')
)

SELECT
  yr                                        AS year,
  MAX(CASE WHEN element = 'PRCP' THEN val END) AS precip_max_mm,
  MIN(CASE WHEN element = 'TMIN' THEN val END) AS tmin_min_c,
  MAX(CASE WHEN element = 'TMAX' THEN val END) AS tmax_max_c
FROM period_data
GROUP BY yr
ORDER BY yr;
```
