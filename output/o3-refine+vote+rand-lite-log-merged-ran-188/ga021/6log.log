```sql
-- 6. Description:  Users who returned exactly 14–20 days after their *first* quick-play event
--     (retained users set).
WITH cohort AS (
  SELECT
    qp.user_pseudo_id,
    qp.event_name                       AS quickplay_event,
    qp.event_timestamp                  AS first_qp_ts
  FROM (
    SELECT
      qp.user_pseudo_id,
      qp.event_name,
      qp.event_timestamp,
      ROW_NUMBER() OVER (PARTITION BY qp.user_pseudo_id, qp.event_name ORDER BY qp.event_timestamp) AS rn
    FROM `firebase-public-project.analytics_153293282.events_*`  qp
    JOIN (
      SELECT user_pseudo_id
      FROM   `firebase-public-project.analytics_153293282.events_*`
      WHERE  _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
        AND  event_name = 'session_start'
      GROUP  BY user_pseudo_id
    ) fs
      ON qp.user_pseudo_id = fs.user_pseudo_id
    WHERE LOWER(qp.event_name) LIKE '%quickplay%'
      AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  )
  WHERE rn = 1
),
returns AS (
  SELECT DISTINCT
         c.quickplay_event,
         c.user_pseudo_id
  FROM   cohort c
  JOIN   `firebase-public-project.analytics_153293282.events_*`  e
    ON   e.user_pseudo_id  = c.user_pseudo_id
   AND   e.event_name      = c.quickplay_event          -- same quick-play type
   AND   e.event_timestamp >= c.first_qp_ts + 14 * 24 * 60 * 60 * 1000000
   AND   e.event_timestamp <  c.first_qp_ts + 21 * 24 * 60 * 60 * 1000000  -- ≤ 20 days after
   AND   _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
)
SELECT quickplay_event,
       COUNT(DISTINCT user_pseudo_id) AS retained_users
FROM   returns
GROUP  BY quickplay_event
LIMIT 20;
```

```sql
-- 7. Description:  Join cohort size (#5) with retained set (#6) to compute the 2-week retention rate.
WITH cohort AS (
  SELECT
    quickplay_event,
    COUNT(DISTINCT user_pseudo_id) AS cohort_users
  FROM (
    SELECT
      qp.user_pseudo_id,
      qp.event_name                       AS quickplay_event,
      ROW_NUMBER() OVER (PARTITION BY qp.user_pseudo_id, qp.event_name ORDER BY qp.event_timestamp) AS rn
    FROM `firebase-public-project.analytics_153293282.events_*` qp
    JOIN (
      SELECT user_pseudo_id
      FROM   `firebase-public-project.analytics_153293282.events_*`
      WHERE  _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
        AND  event_name = 'session_start'
      GROUP  BY user_pseudo_id
    ) fs
      ON qp.user_pseudo_id = fs.user_pseudo_id
    WHERE LOWER(qp.event_name) LIKE '%quickplay%'
      AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  )
  WHERE rn = 1
  GROUP BY quickplay_event
),
retained AS (
  SELECT
    c.quickplay_event,
    COUNT(DISTINCT e.user_pseudo_id) AS retained_users
  FROM cohort        c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = c.user_pseudo_id        -- uses the implicit field coming from cohort
   AND e.event_name    = c.quickplay_event
   AND e.event_timestamp >= c.first_qp_ts + 14 * 24 * 60 * 60 * 1000000
   AND e.event_timestamp <  c.first_qp_ts + 21 * 24 * 60 * 60 * 1000000
   AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
  GROUP BY c.quickplay_event
)
SELECT
  c.quickplay_event,
  c.cohort_users,
  r.retained_users,
  SAFE_DIVIDE(r.retained_users, c.cohort_users) AS retention_rate_2week
FROM cohort   c
LEFT JOIN retained r
  ON c.quickplay_event = r.quickplay_event
ORDER BY retention_rate_2week DESC
LIMIT 20;
```

```sql
-- 8. Description:  Same as #7 but showing concrete percentage & rounded for readability.
WITH cohort AS (
  SELECT
    qp.event_name                       AS quickplay_event,
    qp.user_pseudo_id,
    MIN(qp.event_timestamp) AS first_qp_ts
  FROM `firebase-public-project.analytics_153293282.events_*` qp
  JOIN (
    SELECT user_pseudo_id
    FROM   `firebase-public-project.analytics_153293282.events_*`
    WHERE  _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
      AND  event_name = 'session_start'
    GROUP  BY user_pseudo_id
  ) fs
    ON qp.user_pseudo_id = fs.user_pseudo_id
  WHERE LOWER(qp.event_name) LIKE '%quickplay%'
    AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  GROUP BY qp.event_name, qp.user_pseudo_id
),
retained AS (
  SELECT DISTINCT
         c.quickplay_event,
         c.user_pseudo_id
  FROM   cohort c
  JOIN   `firebase-public-project.analytics_153293282.events_*` e
         ON  e.user_pseudo_id = c.user_pseudo_id
         AND e.event_name     = c.quickplay_event
         AND e.event_timestamp >= c.first_qp_ts + 14 * 24 * 60 * 60 * 1000000
         AND e.event_timestamp <  c.first_qp_ts + 21 * 24 * 60 * 60 * 1000000
         AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
)
SELECT
  quickplay_event,
  COUNT(DISTINCT user_pseudo_id) AS cohort_users,
  COUNT(DISTINCT IF(user_pseudo_id IN (SELECT user_pseudo_id FROM retained WHERE retained.quickplay_event = cohort.quickplay_event), user_pseudo_id, NULL)) AS retained_users,
  ROUND(100 * SAFE_DIVIDE(
        COUNT(DISTINCT IF(user_pseudo_id IN (SELECT user_pseudo_id FROM retained WHERE retained.quickplay_event = cohort.quickplay_event), user_pseudo_id, NULL)),
        COUNT(DISTINCT user_pseudo_id)
       ), 2) AS retention_pct_2week
FROM  cohort
GROUP BY quickplay_event
ORDER BY retention_pct_2week DESC
LIMIT 20;
```

The final query (#8) produces the 14-day (two-week) retention rate for every quick-play event type for users that began a session between 2-Jul-2018 and 16-Jul-2018.
