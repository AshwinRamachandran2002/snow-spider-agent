```sql
--Description (thinking process inline):
-- 1. Identify the “cohort users” = anyone whose first session_start happens 2-16 Jul 2018.
-- 2. For those users, grab their FIRST timestamp of every quick-play event type
--    (level_start_quickplay, level_fail_quickplay, …) within the same 2-16 Jul window.
-- 3. A user is considered “retained” for that quick-play if they perform the SAME event
--    again 14-20 days (inclusive of day-14, exclusive of day-21) after the first time.
-- 4. Finally, compute cohort size, retained users, and retention % per quick-play type.

WITH cohort_users AS (                 -- 1️⃣ users entering the cohort
  SELECT DISTINCT user_pseudo_id
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND  event_name = 'session_start'
),

first_quickplay AS (                   -- 2️⃣ first quick-play occurrence per user/type
  SELECT
    e.user_pseudo_id,
    e.event_name                    AS quickplay_event,
    MIN(e.event_timestamp) AS first_qp_ts
  FROM   `firebase-public-project.analytics_153293282.events_*` e
  JOIN   cohort_users cu
    ON   cu.user_pseudo_id = e.user_pseudo_id
  WHERE  LOWER(e.event_name) LIKE '%quickplay%'
    AND  _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  GROUP  BY e.user_pseudo_id, e.event_name
),

retained AS (                          -- 3️⃣ users repeating the same quick-play 14-20 d later
  SELECT DISTINCT
         fq.quickplay_event,
