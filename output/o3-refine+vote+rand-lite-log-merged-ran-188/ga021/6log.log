Query:
-- 3. Description:  Show all quick-play events for one example user (helps to see the time gaps we’ll later measure).
SELECT
  _TABLE_SUFFIX         AS event_date,
  event_name            AS quickplay_event,
  TIMESTAMP_MICROS(event_timestamp) AS event_time
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE user_pseudo_id = 'B458770ED6E295374FEEB3A68902CC28'     -- ← picked from query #2
  AND LOWER(event_name) LIKE '%quickplay%'
  AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
ORDER BY event_timestamp
LIMIT 20;
