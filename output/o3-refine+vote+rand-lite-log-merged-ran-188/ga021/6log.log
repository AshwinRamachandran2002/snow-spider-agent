-- 5. Description:  Cohort size per quick-play type (how many unique users entered the cohort).
WITH cohort AS (
  -- reuse CTE from query-4
  SELECT quickplay_event, user_pseudo_id
  FROM (
    SELECT
      qp.user_pseudo_id,
      qp.event_name                       AS quickplay_event,
      ROW_NUMBER() OVER (PARTITION BY qp.user_pseudo_id, qp.event_name ORDER BY qp.event_timestamp) AS rn
    FROM `firebase-public-project.analytics_153293282.events_*`  qp
    JOIN (
      SELECT user_pseudo_id
      FROM   `firebase-public-project.analytics_153293282.events_*`
      WHERE  _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
        AND  event_name = 'session_start'
      GROUP  BY user_pseudo_id
    ) fs
      ON qp.user_pseudo_id = fs.user_pseudo_id
    WHERE LOWER(qp.event_name) LIKE '%quickplay%'
      AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
  )
  WHERE rn = 1
)
SELECT
  quickplay_event,
  COUNT(DISTINCT user_pseudo_id) AS cohort_users
FROM cohort
GROUP BY quickplay_event
