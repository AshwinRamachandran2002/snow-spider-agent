Query:
--Description:  (#7 corrected) Compute two-week retention rate per quick-play type.
-- 1️⃣ cohort_users = users whose first session_start fell 2-16 Jul 2018.
-- 2️⃣ first_quickplay = first occurrence of every quick-play event by those users.
-- 3️⃣ retained = users repeating the SAME quick-play 14-20 days later.
-- 4️⃣ Final SELECT returns cohort size, retained users, and retention rate.

WITH cohort_users AS (                       -- users entering cohort
  SELECT DISTINCT user_pseudo_id
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND  event_name = 'session_start'
),
first_quickplay AS (                          -- first qp per user & type
  SELECT
    e.user_pseudo_id,
    e.event_name            AS quickplay_event,
    MIN(e.event_timestamp)  AS first_qp_ts
  FROM   `firebase-public-project.analytics_153293282.events_*` e
  JOIN   cohort_users cu
    ON   cu.user_pseudo_id = e.user_pseudo_id
  WHERE  LOWER(e.event_name) LIKE '%quickplay%'
    AND  _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  GROUP  BY e.user_pseudo_id, e.event_name
),
retained AS (                                  -- repeats 14-20 days later
  SELECT DISTINCT
         fq.quickplay_event,
         fq.user_pseudo_id
  FROM   first_quickplay fq
  JOIN   `firebase-public-project.analytics_153293282.events_*` e
    ON   e.user_pseudo_id = fq.user_pseudo_id
   AND   e.event_name     = fq.quickplay_event
   AND   e.event_timestamp >= fq.first_qp_ts + 14*24*60*60*1000000
   AND   e.event_timestamp <  fq.first_qp_ts + 21*24*60*60*1000000
   AND   _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
)
SELECT
  fq.quickplay_event,
  COUNT(DISTINCT fq.user_pseudo_id)                     AS cohort_users,
  COUNT(DISTINCT r.user_pseudo_id)                      AS retained_users,
  SAFE_DIVIDE(COUNT(DISTINCT r.user_pseudo_id),
              COUNT(DISTINCT fq.user_pseudo_id))        AS retention_rate_2week
FROM first_quickplay fq
LEFT JOIN retained r
  ON  r.quickplay_event = fq.quickplay_event
 AND r.user_pseudo_id  = fq.user_pseudo_id
GROUP BY fq.quickplay_event
ORDER BY retention_rate_2week DESC
LIMIT 20
