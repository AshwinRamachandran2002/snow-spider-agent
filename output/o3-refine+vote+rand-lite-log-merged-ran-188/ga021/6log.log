Query:
-- 1. Description:  Which event names contain the word “quickplay” in July-2018 data (needed to know the different quick-play types).
SELECT DISTINCT
       event_name
FROM   `firebase-public-project.analytics_153293282.events_*`
WHERE  _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
  AND  LOWER(event_name) LIKE '%quickplay%'
LIMIT 20;
Answer:
event_name
level_complete_quickplay
level_fail_quickplay
level_end_quickplay
level_retry_quickplay
level_reset_quickplay
level_start_quickplay
Query:
-- 2. Description:  Sample of users that opened the game (session_start) during the cohort-building range 2-Jul-2018 → 16-Jul-2018.
SELECT
  event_date,
  user_pseudo_id,
  event_timestamp
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND event_name = 'session_start'
LIMIT 20;
