event_name
level_complete_quickplay
level_fail_quickplay
level_end_quickplay
level_start_quickplay
level_reset_quickplay
level_retry_quickplay
Query:
--Description: 3) How many users fired each quick-play event (cohort size) between 2-Jul and 16-Jul?
SELECT
  event_name,
  COUNT(DISTINCT user_pseudo_id) AS cohort_users
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND event_name LIKE '%quickplay%'
  AND user_pseudo_id IS NOT NULL
GROUP BY event_name
LIMIT 20;
