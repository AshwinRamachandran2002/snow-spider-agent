Query:
--Description: 5) Show a few cohort rows together with the calendar date we will look at for “week-2” retention
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS cohort_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name LIKE '%quickplay%'
  GROUP BY user_pseudo_id, event_name
)
SELECT
  user_pseudo_id,
  event_name,
  cohort_date,
  DATE_ADD(cohort_date, INTERVAL 14 DAY) AS check_date   -- day-14 mark
FROM cohort
LIMIT 20;
