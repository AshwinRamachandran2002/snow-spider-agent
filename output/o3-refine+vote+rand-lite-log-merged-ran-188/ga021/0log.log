--Description: 1) What Quick-play related event names exist on 2-Jul-2018?
SELECT DISTINCT event_name
FROM   `firebase-public-project.analytics_153293282.events_20180702`
WHERE  event_name LIKE '%quickplay%'
LIMIT 20;
