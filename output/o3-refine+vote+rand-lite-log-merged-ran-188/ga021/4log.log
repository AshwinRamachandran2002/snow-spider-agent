WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND event_name LIKE '%quickplay%'
  AND user_pseudo_id IN (
        SELECT DISTINCT user_pseudo_id
        FROM `firebase-public-project.analytics_153293282.events_*`
        WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
          AND event_name = 'session_start'
      )
GROUP BY user_pseudo_id, event_name
LIMIT 20;
```

```sql
--Description: 6)  Sample rows that show if the same user fired the same quick-play event exactly 14 days after the first one.  
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS d0
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name LIKE '%quickplay%'
  GROUP BY user_pseudo_id, event_name
)
SELECT
  c.user_pseudo_id,
  c.event_name,
  c.d0,
  e.event_date        AS d14_event_date
FROM cohort AS c
JOIN `firebase-public-project.analytics_153293282.events_*`  AS e
  ON  e.user_pseudo_id = c.user_pseudo_id
  AND e.event_name     = c.event_name
  AND PARSE_DATE('%Y%m%d', e.event_date) = DATE_ADD(c.d0, INTERVAL 14 DAY)
LIMIT 20;
```

```sql
--Description: 7)  Count the size of every quick-play cohort (users whose first quick-play event occurs in the window).  
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name LIKE '%quickplay%'
  GROUP BY user_pseudo_id, event_name
)
SELECT
  event_name,
  COUNT(DISTINCT user_pseudo_id) AS cohort_users
FROM cohort
GROUP BY event_name
LIMIT 20;
```

```sql
--Description: 8)  Count how many of those cohort users repeat the same quick-play event exactly 14 days later.  
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS d0
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name LIKE '%quickplay%'
  GROUP BY user_pseudo_id, event_name
),
repeaters AS (
  SELECT DISTINCT
    c.event_name,
    c.user_pseudo_id
  FROM cohort AS c
  JOIN `firebase-public-project.analytics_153293282.events_*` AS e
    ON  e.user_pseudo_id = c.user_pseudo_id
    AND e.event_name     = c.event_name
    AND PARSE_DATE('%Y%m%d', e.event_date) = DATE_ADD(c.d0, INTERVAL 14 DAY)
)
SELECT
  event_name,
  COUNT(DISTINCT user_pseudo_id) AS retained_users
FROM repeaters
GROUP BY event_name
LIMIT 20;
```

```sql
--Description: 9)  Combine the two previous sub-queries to obtain the 2-week retention rate for every quick-play event type for users that opened a session in the window.  
WITH quickplay_initial AS (
  SELECT
    user_pseudo_id,
    event_name,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name LIKE '%quickplay%'
    AND user_pseudo_id IN (
          SELECT DISTINCT user_pseudo_id
          FROM `firebase-public-project.analytics_153293282.events_*`
          WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
            AND event_name = 'session_start'
        )
  GROUP BY user_pseudo_id, event_name
),
retained AS (
  SELECT DISTINCT
    qi.event_name,
    qi.user_pseudo_id
  FROM quickplay_initial AS qi
  JOIN `firebase-public-project.analytics_153293282.events_*` AS e
    ON  e.user_pseudo_id = qi.user_pseudo_id
    AND e.event_name     = qi.event_name
    AND PARSE_DATE('%Y%m%d', e.event_date) = DATE_ADD(qi.first_date, INTERVAL 14 DAY)
)
SELECT
  qi.event_name                           AS quickplay_event_type,
  COUNT(DISTINCT qi.user_pseudo_id)       AS cohort_users,
  COUNT(DISTINCT r.user_pseudo_id)        AS retained_users,
  SAFE_DIVIDE(COUNT(DISTINCT r.user_pseudo_id),
              COUNT(DISTINCT qi.user_pseudo_id)) AS retention_rate_2w
FROM quickplay_initial qi
LEFT JOIN retained r
  ON qi.user_pseudo_id = r.user_pseudo_id
  AND qi.event_name    = r.event_name
GROUP BY quickplay_event_type
LIMIT 20;
```
