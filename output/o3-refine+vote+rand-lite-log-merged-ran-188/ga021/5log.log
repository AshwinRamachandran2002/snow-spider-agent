Query:
--Description: 7)  Did the user come back on the 14-day mark?  
--                 Join cohort with session_start happening exactly on retention_check_date
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name AS quickplay_type,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_quickplay_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, quickplay_type
)
SELECT
  c.user_pseudo_id,
  c.quickplay_type,
  DATE_ADD(c.first_quickplay_date, INTERVAL 14 DAY) AS retention_check_date,
  s.event_date                                  AS session_date
FROM cohort AS c
LEFT JOIN `firebase-public-project.analytics_153293282.events_*`  AS s
  ON s.user_pseudo_id = c.user_pseudo_id
     AND s.event_name   = 'session_start'
     AND PARSE_DATE('%Y%m%d', s.event_date) = DATE_ADD(c.first_quickplay_date, INTERVAL 14 DAY)
     AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
LIMIT 20;
Answer:
user_pseudo_id,quickplay_type,retention_check_date,session_date
