```sql
--Description: 6)  Pair every cohort member with its target retention day (= first_quickplay_date + 14)
SELECT
  user_pseudo_id,
  quickplay_type,
  first_quickplay_date,
  DATE_ADD(first_quickplay_date, INTERVAL 14 DAY) AS retention_check_date
FROM (
  SELECT
    user_pseudo_id,
    event_name AS quickplay_type,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_quickplay_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, quickplay_type
)
LIMIT 20;
```

```sql
--Description: 7)  Did the user come back on the 14-day mark?  
--                 Join cohort with session_start happening exactly on retention_check_date
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name AS quickplay_type,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_quickplay_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, quickplay_type
)
SELECT
  c.user_pseudo_id,
  c.quickplay_type,
  DATE_ADD(c.first_quickplay_date, INTERVAL 14 DAY) AS retention_check_date,
  s.event_date                                  AS session_date
FROM cohort AS c
LEFT JOIN `firebase-public-project.analytics_153293282.events_*`  AS s
  ON s.user_pseudo_id = c.user_pseudo_id
     AND s.event_name   = 'session_start'
     AND PARSE_DATE('%Y%m%d', s.event_date) = DATE_ADD(c.first_quickplay_date, INTERVAL 14 DAY)
     AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
LIMIT 20;
```

```sql
--Description: 8)  Aggregate the previous step → users retained (= had session_start on day 14)
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name AS quickplay_type,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_quickplay_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, quickplay_type
),
retained AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    c.quickplay_type
  FROM cohort AS c
  JOIN `firebase-public-project.analytics_153293282.events_*`  AS s
    ON s.user_pseudo_id = c.user_pseudo_id
       AND s.event_name   = 'session_start'
       AND PARSE_DATE('%Y%m%d', s.event_date) = DATE_ADD(c.first_quickplay_date, INTERVAL 14 DAY)
       AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
)
SELECT
  quickplay_type,
  COUNT(DISTINCT user_pseudo_id) AS users_retained
FROM retained
GROUP BY quickplay_type
LIMIT 20;
```

```sql
--Description: 9)  Combine cohort size & retained users →  two-week retention rate for every quickplay event
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name AS quickplay_type,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_quickplay_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
    AND user_pseudo_id IN (            -- keep only users that actually started a session in the period
        SELECT DISTINCT user_pseudo_id
        FROM `firebase-public-project.analytics_153293282.events_*`
        WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
          AND event_name = 'session_start')
  GROUP BY user_pseudo_id, quickplay_type
),
retained AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    c.quickplay_type
  FROM cohort AS c
  JOIN `firebase-public-project.analytics_153293282.events_*`  AS s
    ON s.user_pseudo_id = c.user_pseudo_id
       AND s.event_name   = 'session_start'
       AND PARSE_DATE('%Y%m%d', s.event_date) = DATE_ADD(c.first_quickplay_date, INTERVAL 14 DAY)
       AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
)
SELECT
  c.quickplay_type,
  COUNT(DISTINCT c.user_pseudo_id)                       AS cohort_users,
  COUNT(DISTINCT r.user_pseudo_id)                       AS retained_users,
  ROUND(100 * COUNT(DISTINCT r.user_pseudo_id)
/ COUNT(DISTINCT c.user_pseudo_id), 2) || '%'            AS retention_rate_2w
FROM cohort AS c
LEFT JOIN retained AS r
  ON r.user_pseudo_id   = c.user_pseudo_id
 AND r.quickplay_type = c.quickplay_type
GROUP BY c.quickplay_type
ORDER BY retention_rate_2w DESC
LIMIT 20;
```

```sql
--Description: 10)  (Optional deep dive)  List the first 20 users that WERE retained for the most popular quickplay event
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name AS quickplay_type,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_quickplay_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, quickplay_type
),
retained AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    c.quickplay_type,
    DATE_ADD(c.first_quickplay_date, INTERVAL 14 DAY) AS retained_on
  FROM cohort AS c
  JOIN `firebase-public-project.analytics_153293282.events_*`  AS s
    ON s.user_pseudo_id = c.user_pseudo_id
       AND s.event_name   = 'session_start'
       AND PARSE_DATE('%Y%m%d', s.event_date) = DATE_ADD(c.first_quickplay_date, INTERVAL 14 DAY)
       AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
)
SELECT *
FROM retained
WHERE quickplay_type = (
      SELECT quickplay_type
      FROM cohort
      GROUP BY quickplay_type
      ORDER BY COUNT(*) DESC
      LIMIT 1)
LIMIT 20;
```

The ninth query returns, for every individual quick-play event type,  
• cohort size (users whose very first occurrence of that quick-play fell between 2-Jul-18 and 16-Jul-18 and who opened at least one session during that span)  
• how many of those users came back exactly 14 days later (using a fresh `session_start`)  
• the Two-Week retention rate expressed as a percentage.
