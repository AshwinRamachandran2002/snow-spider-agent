```sql
--  Calculate, for breast-cancer cases (Morph = 3111, Topo = 0401),
--  the Pearson correlation (and its p-value) between the per-chromosome
--  frequencies of copy-number aberrations observed in the Mitelman DB
--  and the corresponding frequencies derived from TCGA data
--  (here the TCGA frequencies come from the public table that already
--  contains per-cytoband copy-number event rates for all TCGA samples).
--
--  Four aberration categories are considered:
--        •  Amplification   (Amp)  – TCGA “freq_amp”
--        •  Gain            (Gain) – TCGA “freq_gain”
--        •  Loss            (Loss) – TCGA “freq_heterodel + freq_homodel”
--        •  Deletion        (Del)  – identical to “Loss” in Mitelman
--  In the Mitelman CytoConverted table, the only CNA labels are “Gain”
--  and “Loss”;  we map “Gain” to both Amp/Gain and “Loss” to both
--  Loss/Del so that every aberration type can be compared.
--
--  Correlations are returned only when at least five chromosomes
--  possess data for the aberration type.

WITH  /*------------------------------------------------------------*/
      /* 1)  Mitelman – per-chromosome CNA counts                   */
      /*------------------------------------------------------------*/
      mtl AS (
        SELECT
            cc.Chr                                        AS chromosome,
            CASE cc.Type
              WHEN 'Gain' THEN 'Gain'     -- used for Amp and Gain
              WHEN 'Loss' THEN 'Loss'     -- used for Loss and Del
            END                                          AS aberration_type,
            COUNT(*)                                     AS mitelman_events
        FROM   `mitelman-db.prod.CytoConverted`  AS cc
        JOIN   `mitelman-db.prod.Cytogen`        AS cg
               ON  cg.RefNo  = cc.RefNo
               AND cg.CaseNo = cc.CaseNo
        WHERE  cg.Morph = '3111'          -- breast carcinoma
          AND  cg.Topo  = '0401'          -- mammary gland
          AND  cc.Type IN ('Gain','Loss')
        GROUP  BY chromosome, aberration_type
      ),

      /*------------------------------------------------------------*/
      /* 2)  TCGA – per-chromosome CNA frequencies                  */
      /*     (table contains BRCA cytoband CNA frequencies)         */
      /*------------------------------------------------------------*/
      tcga_raw AS (
        SELECT
            chromosome,
            SUM(freq_amp)        AS freq_amp,
            SUM(freq_gain)       AS freq_gain,
            SUM(freq_homodel)    AS freq_homodel,
            SUM(freq_heterodel)  AS freq_heterodel
        FROM  `isb-cgc-04-0032.analyses_tcga.cytoband_copy_number_frequencies`
        WHERE cancer_type = 'BRCA'        -- restrict to TCGA-BRCA cohort
        GROUP BY chromosome
      ),

      /*  Expand the 4 TCGA frequency columns into row form */
      tcga AS (
        SELECT chromosome, 'Amp'  AS aberration_type, freq_amp                       AS tcga_freq FROM tcga_raw UNION ALL
        SELECT chromosome, 'Gain' AS aberration_type, freq_gain                      AS tcga_freq FROM tcga_raw UNION ALL
        SELECT chromosome, 'Loss' AS aberration_type, (freq_homodel+freq_heterodel)  AS tcga_freq FROM tcga_raw UNION ALL
        SELECT chromosome, 'Del'  AS aberration_type, (freq_homodel+freq_heterodel)  AS tcga_freq FROM tcga_raw
      ),

      /*------------------------------------------------------------*/
      /* 3)  Match Mitelman & TCGA on chromosome + aberration type  */
      /*------------------------------------------------------------*/
      joined AS (
        SELECT
            m.chromosome,
            CASE
              WHEN t.aberration_type = 'Amp'  THEN 'Amp'
              WHEN t.aberration_type = 'Gain' THEN 'Gain'
              WHEN t.aberration_type = 'Loss' THEN 'Loss'
              WHEN t.aberration_type = 'Del'  THEN 'Del'
            END                                              AS aberration_type,
            m.mitelman_events,
            t.tcga_freq
        FROM   tcga  AS t
        JOIN   mtl   AS m
               ON  m.chromosome       = t.chromosome
               AND (
                    -- map Mitelman “Gain” to both Amp & Gain
                    (t.aberration_type IN ('Amp','Gain')  AND m.aberration_type = 'Gain')
                 OR -- map Mitelman “Loss” to both Loss & Del
                    (t.aberration_type IN ('Loss','Del')  AND m.aberration_type = 'Loss')
               )
      ),

      /*------------------------------------------------------------*/
      /* 4)  Compute correlation per aberration type               */
      /*------------------------------------------------------------*/
      corr AS (
        SELECT
            aberration_type,
            COUNT(*)                                           AS n_chromosomes,
            CORR(mitelman_events, tcga_freq)                   AS pearson_r,
            `isb-cgc-bq.functions.corr_pvalue_current`
               (CORR(mitelman_events, tcga_freq),
                COUNT(*))                                      AS p_value
        FROM   joined
        GROUP  BY aberration_type
        HAVING COUNT(*) >= 5          -- keep only well-supported results
      )

/*==================================================================*/
/*  Final result                                                    */
/*==================================================================*/
SELECT aberration_type,
       n_chromosomes,
       pearson_r,
       p_value
FROM   corr
ORDER  BY aberration_type;
