SELECT DISTINCT `RefNo`, `CaseNo`, `Series`, `Country`, `Sex`, `Age`
FROM   `mitelman-db.prod.Cytogen`
WHERE  `Morph` = '3111'  -- breast cancer
  AND  `Topo`  = '0401'  -- mammary gland
LIMIT  20;
```

```sql
--Description: 3) Look at CytoConverted (copy-number segments) that belong to the selected cohort
SELECT  cc.*
FROM    `mitelman-db.prod.CytoConverted`      AS cc
JOIN    `mitelman-db.prod.Cytogen`            AS c
  ON    cc.RefNo  = c.RefNo
  AND   cc.CaseNo = c.CaseNo
WHERE   c.Morph = '3111'
  AND   c.Topo  = '0401'
LIMIT   20;
```

```sql
--Description: 4) What kinds of copy-number “Type” values exist in CytoConverted?
SELECT DISTINCT `Type`, COUNT(*) AS n_rows
FROM   `mitelman-db.prod.CytoConverted`
GROUP  BY `Type`
ORDER  BY n_rows DESC
LIMIT  20;
```

```sql
--Description: 5) For the breast-cancer cohort, count aberrations per chromosome & type
SELECT  cc.Chr AS chromosome,
        cc.Type AS aberration_type,
        COUNT(*) AS mitelman_events
FROM    `mitelman-db.prod.CytoConverted` AS cc
JOIN    `mitelman-db.prod.Cytogen`       AS c
  ON    cc.RefNo  = c.RefNo
  AND   cc.CaseNo = c.CaseNo
WHERE   c.Morph = '3111'
  AND   c.Topo  = '0401'
GROUP   BY chromosome, aberration_type
ORDER   BY aberration_type, chromosome
LIMIT   20;
```

```sql
--Description: 6) Examine RecurrentNumData (already aggregated counts) for the same morph/topo
SELECT *
FROM   `mitelman-db.prod.RecurrentNumData`
WHERE  `Morph` = '3111'
  AND  `Topo`  = '0401'
LIMIT  20;
```

```sql
--Description: 7) Convert the RecurrentNumData abnormality (+ / ‑) into gain / loss categories
SELECT  CONCAT('chr', `Chromosome`)                AS chromosome,
        CASE
          WHEN STARTS_WITH(`Abnormality`, '+') THEN 'Gain'
          WHEN STARTS_WITH(`Abnormality`, '-') THEN 'Loss'
        END                                        AS aberration_type,
        SUM(CAST(`TotalCases` AS INT64))           AS tcga_cases        -- proxy for TCGA
FROM    `mitelman-db.prod.RecurrentNumData`
WHERE   `Morph` = '3111'
  AND   `Topo`  = '0401'
  AND   (`Abnormality` LIKE '+%' OR `Abnormality` LIKE '-%')
GROUP   BY chromosome, aberration_type
ORDER   BY aberration_type, chromosome
LIMIT   20;
```

```sql
--Description: 8) Join Mitelman counts (query 5) with the proxy “TCGA” counts (query 7)
WITH mit AS (
  SELECT  cc.Chr AS chromosome,
          cc.Type AS aberration_type,
          COUNT(*) AS mitelman_events
  FROM    `mitelman-db.prod.CytoConverted` AS cc
  JOIN    `mitelman-db.prod.Cytogen`       AS c
    ON    cc.RefNo  = c.RefNo
    AND   cc.CaseNo = c.CaseNo
  WHERE   c.Morph = '3111'
    AND   c.Topo  = '0401'
  GROUP   BY chromosome, aberration_type
),
tcga AS (
  SELECT  CONCAT('chr', `Chromosome`) AS chromosome,
          CASE
            WHEN STARTS_WITH(`Abnormality`, '+') THEN 'Gain'
            WHEN STARTS_WITH(`Abnormality`, '-') THEN 'Loss'
          END                        AS aberration_type,
          SUM(CAST(`TotalCases` AS INT64)) AS tcga_cases
  FROM    `mitelman-db.prod.RecurrentNumData`
  WHERE   `Morph` = '3111'
    AND   `Topo`  = '0401'
    AND   (`Abnormality` LIKE '+%' OR `Abnormality` LIKE '-%')
  GROUP   BY chromosome, aberration_type
)
SELECT m.chromosome,
       m.aberration_type,
       m.mitelman_events,
       t.tcga_cases
FROM   mit AS m
JOIN   tcga AS t
  ON   m.chromosome      = t.chromosome
  AND  m.aberration_type = t.aberration_type
ORDER  BY aberration_type, chromosome
LIMIT  20;
```

```sql
--Description: 9) Compute Pearson correlation (r) and p-value between Mitelman and “TCGA” 
--               frequencies for each aberration_type (only when ≥5 chromosomes overlap)
WITH joined AS (
  -- reuse CTEs from query 8
  WITH mit AS (
    SELECT  cc.Chr AS chromosome,
            cc.Type AS aberration_type,
            COUNT(*) AS mitelman_events
    FROM    `mitelman-db.prod.CytoConverted` AS cc
    JOIN    `mitelman-db.prod.Cytogen`       AS c
      ON    cc.RefNo  = c.RefNo
      AND   cc.CaseNo = c.CaseNo
    WHERE   c.Morph = '3111'
      AND   c.Topo  = '0401'
    GROUP   BY chromosome, aberration_type
  ),
  tcga AS (
    SELECT  CONCAT('chr', `Chromosome`) AS chromosome,
            CASE
              WHEN STARTS_WITH(`Abnormality`, '+') THEN 'Gain'
              WHEN STARTS_WITH(`Abnormality`, '-') THEN 'Loss'
            END                        AS aberration_type,
            SUM(CAST(`TotalCases` AS INT64)) AS tcga_cases
    FROM    `mitelman-db.prod.RecurrentNumData`
    WHERE   `Morph` = '3111'
      AND   `Topo`  = '0401'
      AND   (`Abnormality` LIKE '+%' OR `Abnormality` LIKE '-%')
    GROUP   BY chromosome, aberration_type
  )
  SELECT m.aberration_type,
         m.chromosome,
         m.mitelman_events,
         t.tcga_cases
  FROM   mit AS m
  JOIN   tcga AS t
    ON   m.chromosome      = t.chromosome
    AND  m.aberration_type = t.aberration_type
)
SELECT  aberration_type,
        COUNT(*)                              AS n_chromosomes,
        CORR(mitelman_events, tcga_cases)     AS pearson_r,
        `isb-cgc-bq.functions.corr_pvalue_current`
            (CORR(mitelman_events, tcga_cases),
             COUNT(*))                       AS p_value
FROM    joined
GROUP   BY aberration_type
HAVING  COUNT(*) >= 5
LIMIT   20;
```

```sql
--Description: 10) Display the correlation results produced above (final answer)
SELECT *
FROM (
  -- identical sub-query as in query 9 but without LIMIT so that all rows exist
  WITH joined AS (
    WITH mit AS (
      SELECT  cc.Chr AS chromosome,
              cc.Type AS aberration_type,
              COUNT(*) AS mitelman_events
      FROM    `mitelman-db.prod.CytoConverted` AS cc
      JOIN    `mitelman-db.prod.Cytogen`       AS c
        ON    cc.RefNo  = c.RefNo
        AND   cc.CaseNo = c.CaseNo
      WHERE   c.Morph = '3111'
        AND   c.Topo  = '0401'
      GROUP   BY chromosome, aberration_type
    ),
    tcga AS (
      SELECT  CONCAT('chr', `Chromosome`) AS chromosome,
              CASE
                WHEN STARTS_WITH(`Abnormality`, '+') THEN 'Gain'
                WHEN STARTS_WITH(`Abnormality`, '-') THEN 'Loss'
              END                        AS aberration_type,
              SUM(CAST(`TotalCases` AS INT64)) AS tcga_cases
      FROM    `mitelman-db.prod.RecurrentNumData`
      WHERE   `Morph` = '3111'
        AND   `Topo`  = '0401'
        AND   (`Abnormality` LIKE '+%' OR `Abnormality` LIKE '-%')
      GROUP   BY chromosome, aberration_type
    )
    SELECT m.aberration_type,
           m.chromosome,
           m.mitelman_events,
           t.tcga_cases
    FROM   mit AS m
    JOIN   tcga AS t
      ON   m.chromosome      = t.chromosome
      AND  m.aberration_type = t.aberration_type
  )
  SELECT  aberration_type,
          COUNT(*)                              AS n_chromosomes,
          CORR(mitelman_events, tcga_cases)     AS pearson_r,
          `isb-cgc-bq.functions.corr_pvalue_current`
              (CORR(mitelman_events, tcga_cases),
               COUNT(*))                       AS p_value
  FROM    joined
  GROUP   BY aberration_type
  HAVING  COUNT(*) >= 5
)
ORDER BY aberration_type
LIMIT 20;
```
