--Description:  (Query 8 – Mitelman-only summary)  
--  From Mitelman’s RecurrentNumData (chromosome-level copy-number counts),  
--  summarise per-chromosome totals for GAIN-type abnormalities (those whose  
--  text begins with ‘+’) and LOSS-type abnormalities (those beginning with  
--  ‘-’).  This yields an internal, TCGA-independent reference that we can use
--  for downstream comparisons or correlation tests.
SELECT
  CAST(`Chromosome` AS STRING)                         AS chromosome,
  SUM(CASE WHEN LEFT(`Abnormality`, 1) = '+' 
           THEN CAST(`TotalCases` AS INT64) END)       AS total_gain_cases,
  SUM(CASE WHEN LEFT(`Abnormality`, 1) = '-' 
           THEN CAST(`TotalCases` AS INT64) END)       AS total_loss_cases
FROM `mitelman-db.prod.RecurrentNumData`
GROUP BY chromosome
ORDER BY SAFE_CAST(chromosome AS INT64)
