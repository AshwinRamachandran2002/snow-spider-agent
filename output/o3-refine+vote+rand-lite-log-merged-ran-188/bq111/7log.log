```sql
--Description (thinking process):
--  Extend the previous cytoband-mapping (step 5) by converting raw event
--  counts into within-chromosome frequencies for each aberration type.
--  1) Identify breast-cancer Mitelman investigations (Morph 3111 / Topo 0401).
--  2) Join their CytoConverted CNV intervals to hg38 cytobands to obtain
--     (chromosome, cytoband, aberration_type) triples.
--  3) Aggregate counts and compute frequency = count / total-per-chromosome-
--     per-aberration-class.  Aliasing prevents any “ambiguous column” errors.
WITH mitelman_cytoband AS (
  SELECT
    cv.`Chr`              AS chromosome,
    b.`cytoband_name`     AS cytoband_name,
    cv.`Type`             AS aberration_type
  FROM `mitelman-db.prod.CytoConverted`  AS cv
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
        ON  cv.`Chr`   = b.`chromosome`
       AND cv.`Start` < b.`hg38_stop`
       AND cv.`End`   > b.`hg38_start`
  JOIN (
        SELECT DISTINCT
               c.`RefNo`  AS RefNo,
               c.`CaseNo` AS CaseNo,
               i.`InvNo`  AS InvNo
        FROM `mitelman-db.prod.Cytogen`    AS c
        JOIN `mitelman-db.prod.CytogenInv` AS i
              ON  c.`RefNo`  = i.`RefNo`
             AND c.`CaseNo` = i.`CaseNo`
        WHERE c.`Morph` = '3111'
          AND c.`Topo`  = '0401'
       ) AS bc
        ON  cv.`RefNo`  = bc.RefNo
       AND cv.`CaseNo` = bc.CaseNo
       AND cv.`InvNo`  = bc.InvNo
)
SELECT
  chromosome,
  cytoband_name,
  aberration_type,
  COUNT(*)                                           AS mitelman_events,
  COUNT(*) / SUM(COUNT(*)) OVER (PARTITION BY chromosome, aberration_type)
                                                    AS mitelman_frequency
FROM mitelman_cytoband
GROUP BY chromosome, cytoband_name, aberration_type
