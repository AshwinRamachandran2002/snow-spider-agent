[{'MolClin': 'C', 'RefNo': 2578, 'InvNo': 1, 'Morph': '1501', 'Topo': ' ', 'Immunology': ' ', 'GeneLength': None, 'GeneShort': None, 'GeneLong': None, 'KaryLength': None, 'KaryShort': None, 'KaryLong': None}, {'MolClin': 'C', 'RefNo': 2668, 'InvNo': 1, 'Morph': '1602', 'Topo': ' ', 'Immunology': ' ', 'GeneLength': None, 'GeneShort': None, 'GeneLong': None, 'KaryLength': None, 'KaryShort': None, 'KaryLong': None}, {'MolClin': 'C', 'RefNo': 2889, 'InvNo': 1, 'Morph': '1602', 'Topo': ' ', 'Immunology': ' ', 'GeneLength': None, 'GeneShort': None, 'GeneLong': None, 'KaryLength': None, 'KaryShort': None, 'KaryLong': None}, {'MolClin': 'C', 'RefNo': 2993, 'InvNo': 1, 'Morph': '1501', 'Topo': ' ', 'Immunology': ' ', 'GeneLength': None, 'GeneShort': None, 'GeneLong': None, 'KaryLength': None, 'KaryShort': None, 'KaryLong': None}, {'MolClin': 'C', 'RefNo': 2994, 'InvNo': 1, 'Morph': '1602', 'Topo': ' ', 'Immunology': ' ', 'GeneLength': None, 'GeneShort': None, 'GeneLong': None, 'KaryLength': None, 'KaryShort': None, 'KaryLong': None}]

