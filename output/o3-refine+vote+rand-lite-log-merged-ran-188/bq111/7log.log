--Description:  (Query 8)  
--  Collapse TCGA cytoband-level table to chromosome-level means for each
--  of the four aberration classes (amp, gain, hetero-del, homo-del).
SELECT
  `chromosome`,
  AVG(`freq_amp`)       AS tcga_amp,
  AVG(`freq_gain`)      AS tcga_gain,
  AVG(`freq_homodel`)   AS tcga_homodel,
  AVG(`freq_heterodel`) AS tcga_heterodel
FROM `isb-cgc-bq.TCGA_copy_number_gistic.hg38_cytoband_freq`
GROUP BY chromosome
LIMIT 20;
