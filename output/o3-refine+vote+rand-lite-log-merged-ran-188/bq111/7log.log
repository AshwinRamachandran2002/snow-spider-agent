```sql
--Description:  (Query 8 – Mitelman-only summary)  
--  From Mitelman’s RecurrentNumData (chromosome-level copy-number counts),  
--  summarise per-chromosome totals for GAIN-type abnormalities (those whose  
--  text begins with ‘+’) and LOSS-type abnormalities (those beginning with  
--  ‘-’).  This yields an internal, TCGA-independent reference that we can use
--  for downstream comparisons or correlation tests.
SELECT
  CAST(`Chromosome` AS STRING)                         AS chromosome,
  SUM(CASE WHEN LEFT(`Abnormality`, 1) = '+' 
           THEN CAST(`TotalCases` AS INT64) END)       AS total_gain_cases,
  SUM(CASE WHEN LEFT(`Abnormality`, 1) = '-' 
           THEN CAST(`TotalCases` AS INT64) END)       AS total_loss_cases
FROM `mitelman-db.prod.RecurrentNumData`
GROUP BY chromosome
ORDER BY SAFE_CAST(chromosome AS INT64);
```

```sql
--Description:  (Query 9 – correlation of chromosome-level GAINS)  
--  Compare chromosome-level GAIN frequencies from our breast-cancer subset  
--  (Morph 3111 / Topo 0401) against the whole-database GAIN counts derived  
--  in Query 8.  For each chromosome we compute the frequency of “Gain” events
--  in the subset, then join to the overall total_gain_cases.  Finally, a single
--  CORR() across all chromosomes gives an internal correlation coefficient.
WITH bc_gain AS (          -- breast-cancer subset: Gain events per chromosome
  SELECT
    cv.`Chr`                                 AS chromosome,
    COUNT(*)                                 AS bc_gain_events
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN (
        SELECT DISTINCT
               c.`RefNo`, c.`CaseNo`, i.`InvNo`
        FROM `mitelman-db.prod.Cytogen`    AS c
        JOIN `mitelman-db.prod.CytogenInv` AS i
              ON  c.`RefNo`  = i.`RefNo`
             AND c.`CaseNo` = i.`CaseNo`
        WHERE c.`Morph` = '3111'
          AND c.`Topo`  = '0401'
       ) AS bc
       ON  cv.`RefNo`  = bc.`RefNo`
      AND cv.`CaseNo` = bc.`CaseNo`
      AND cv.`InvNo`  = bc.`InvNo`
  WHERE cv.`Type` = 'Gain'
  GROUP BY chromosome
),
overall_gain AS (          -- total Gain cases from Query 8 logic
  SELECT
    CAST(`Chromosome` AS STRING)            AS chromosome,
    SUM(CAST(`TotalCases` AS INT64))        AS total_gain_cases
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE LEFT(`Abnormality`,1) = '+'
  GROUP BY chromosome
)
SELECT
  CORR(bc.bc_gain_events, og.total_gain_cases) AS pearson_r,
  COUNT(*)                                     AS n_chromosomes
FROM bc_gain AS bc
JOIN overall_gain AS og
  ON bc.chromosome = og.chromosome;
```

```sql
--Description:  (Query 10 – correlation for GAINS *and* LOSSES)  
--  Extend Query 9: compute separate Pearson correlations for both Gain and
--  Loss classes.  The result shows two rows (class = Gain / Loss) with their
--  correlation coefficients and number of chromosomes compared.
WITH
bc_counts AS (  -- breast-cancer subset counts per chromosome & class
  SELECT
    cv.`Chr`                                AS chromosome,
    cv.`Type`                               AS class,        -- Gain or Loss
    COUNT(*)                                AS bc_events
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN (
        SELECT DISTINCT c.`RefNo`, c.`CaseNo`, i.`InvNo`
        FROM `mitelman-db.prod.Cytogen`    AS c
        JOIN `mitelman-db.prod.CytogenInv` AS i
              ON  c.`RefNo`  = i.`RefNo`
             AND c.`CaseNo` = i.`CaseNo`
        WHERE c.`Morph` = '3111'
          AND c.`Topo`  = '0401'
       ) AS bc
       ON  cv.`RefNo`  = bc.`RefNo`
      AND cv.`CaseNo` = bc.`CaseNo`
      AND cv.`InvNo`  = bc.`InvNo`
  WHERE cv.`Type` IN ('Gain','Loss')
  GROUP BY chromosome, class
),
overall_counts AS (  -- whole-database totals per chromosome & class
  SELECT
    CAST(`Chromosome` AS STRING)            AS chromosome,
    CASE WHEN LEFT(`Abnormality`,1) = '+' THEN 'Gain' ELSE 'Loss' END AS class,
    SUM(CAST(`TotalCases` AS INT64))        AS total_cases
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE LEFT(`Abnormality`,1) IN ('+','-')
  GROUP BY chromosome, class
)
SELECT
  bc.class,
  CORR(bc.bc_events, oc.total_cases) AS pearson_r,
  COUNT(*)                           AS n_chromosomes
FROM bc_counts     AS bc
JOIN overall_counts AS oc
  ON bc.chromosome = oc.chromosome
 AND bc.class      = oc.class
GROUP BY bc.class;
```
