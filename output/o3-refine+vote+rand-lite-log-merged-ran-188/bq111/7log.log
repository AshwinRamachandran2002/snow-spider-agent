```sql
--Description:  (Query 9)  
--  Compute Pearson correlation (per chromosome) between Mitelman and TCGA
--  “Gain” frequencies.  Only chromosomes with ≥ 5 matching cytobands are kept.
WITH mitelman_gain AS (
  -- build Mitelman cytoband frequencies, keep only Type='Gain'
  WITH mitelman_cytoband AS (
    SELECT
      cv.`Chr`              AS chromosome,
      b.`cytoband_name`     AS cytoband_name,
      cv.`Type`             AS aberration_type
    FROM `mitelman-db.prod.CytoConverted`  AS cv
    JOIN `mitelman-db.prod.CytoBands_hg38` AS b
           ON  cv.`Chr`   = b.`chromosome`
          AND cv.`Start` < b.`hg38_stop`
          AND cv.`End`   > b.`hg38_start`
    JOIN (
          SELECT DISTINCT
                 c.`RefNo`  AS RefNo,
                 c.`CaseNo` AS CaseNo,
                 i.`InvNo`  AS InvNo
          FROM `mitelman-db.prod.Cytogen`    AS c
          JOIN `mitelman-db.prod.CytogenInv` AS i
                ON  c.`RefNo`  = i.`RefNo`
               AND c.`CaseNo` = i.`CaseNo`
          WHERE c.`Morph` = '3111'
            AND c.`Topo`  = '0401'
         ) AS bc
           ON  cv.`RefNo`  = bc.RefNo
          AND cv.`CaseNo` = bc.CaseNo
          AND cv.`InvNo`  = bc.InvNo
  )
  SELECT
    chromosome,
    cytoband_name,
    COUNT(*) / SUM(COUNT(*)) OVER (PARTITION BY chromosome) AS mitelman_freq
  FROM mitelman_cytoband
  WHERE aberration_type = 'Gain'
  GROUP BY chromosome, cytoband_name
),
tcga_gain AS (
  SELECT
    `chromosome`,
    `cytoband_name`,
    `freq_gain` AS tcga_freq
  FROM `isb-cgc-bq.TCGA_copy_number_gistic.hg38_cytoband_freq`
)
SELECT
  m.chromosome,
  CORR(m.mitelman_freq, t.tcga_freq) AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(
        CORR(m.mitelman_freq, t.tcga_freq),
        COUNT(*)
  )                                  AS p_value,
  COUNT(*)                           AS n_cytobands
FROM mitelman_gain AS m
JOIN tcga_gain     AS t
  ON m.chromosome      = t.chromosome
 AND m.cytoband_name   = t.cytoband_name
GROUP BY m.chromosome
HAVING COUNT(*) >= 5
LIMIT 20;
```

```sql
--Description:  (Query 10 – final)  
--  For every chromosome and each CNV class (Amp, Gain, Loss, Del), calculate
--  the Pearson correlation between Mitelman and TCGA cytoband frequencies.
--  Only aberration classes with ≥ 5 matching cytobands are retained.
WITH mitelman AS (
  -- Mitelman breast-cancer cytoband frequencies for all CNV classes
  WITH mitelman_cytoband AS (
    SELECT
      cv.`Chr`              AS chromosome,
      b.`cytoband_name`     AS cytoband_name,
      cv.`Type`             AS aberration_type
    FROM `mitelman-db.prod.CytoConverted`  AS cv
    JOIN `mitelman-db.prod.CytoBands_hg38` AS b
           ON  cv.`Chr`   = b.`chromosome`
          AND cv.`Start` < b.`hg38_stop`
          AND cv.`End`   > b.`hg38_start`
    JOIN (
          SELECT DISTINCT
                 c.`RefNo`  AS RefNo,
                 c.`CaseNo` AS CaseNo,
                 i.`InvNo`  AS InvNo
          FROM `mitelman-db.prod.Cytogen`    AS c
          JOIN `mitelman-db.prod.CytogenInv` AS i
                ON  c.`RefNo`  = i.`RefNo`
               AND c.`CaseNo` = i.`CaseNo`
          WHERE c.`Morph` = '3111'
            AND c.`Topo`  = '0401'
         ) AS bc
           ON  cv.`RefNo`  = bc.RefNo
          AND cv.`CaseNo` = bc.CaseNo
          AND cv.`InvNo`  = bc.InvNo
  )
  SELECT
    chromosome,
    cytoband_name,
    aberration_type,
    COUNT(*) / SUM(COUNT(*)) OVER (PARTITION BY chromosome, aberration_type)
      AS mitelman_freq
  FROM mitelman_cytoband
  GROUP BY chromosome, cytoband_name, aberration_type
),
tcga AS (
  SELECT `chromosome`, `cytoband_name`, 'Amp'  AS aberration_type, `freq_amp`       AS tcga_freq FROM `isb-cgc-bq.TCGA_copy_number_gistic.hg38_cytoband_freq`
  UNION ALL
  SELECT `chromosome`, `cytoband_name`, 'Gain' AS aberration_type, `freq_gain`      AS tcga_freq FROM `isb-cgc-bq.TCGA_copy_number_gistic.hg38_cytoband_freq`
  UNION ALL
  SELECT `chromosome`, `cytoband_name`, 'Loss' AS aberration_type, `freq_heterodel` AS tcga_freq FROM `isb-cgc-bq.TCGA_copy_number_gistic.hg38_cytoband_freq`
  UNION ALL
  SELECT `chromosome`, `cytoband_name`, 'Del'  AS aberration_type, `freq_homodel`   AS tcga_freq FROM `isb-cgc-bq.TCGA_copy_number_gistic.hg38_cytoband_freq`
)
SELECT
  m.chromosome,
  m.aberration_type,
  CORR(m.mitelman_freq, t.tcga_freq) AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(
        CORR(m.mitelman_freq, t.tcga_freq),
        COUNT(*)
  )                                  AS p_value,
  COUNT(*)                           AS n_cytobands
FROM mitelman AS m
JOIN tcga     AS t
  ON m.chromosome     = t.chromosome
 AND m.cytoband_name  = t.cytoband_name
 AND m.aberration_type= t.aberration_type
GROUP BY m.chromosome, m.aberration_type
HAVING COUNT(*) >= 5
ORDER BY m.chromosome, m.aberration_type
LIMIT 20;
```
