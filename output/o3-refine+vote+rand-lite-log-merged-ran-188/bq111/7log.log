```sql
-- 2) Description: Show the distinct Topography codes that appear in the
--    Cytogen table (quick check that code “0401” exists).
SELECT DISTINCT `Topo`
FROM `mitelman-db.prod.Cytogen`
LIMIT 20;
```

```sql
-- 3) Description: Retrieve the Mitelman cases (RefNo + CaseNo + InvNo) that
--    correspond to breast-cancer morphology = 3111 and topography = 0401.
SELECT DISTINCT
  c.`RefNo`,
  c.`CaseNo`,
  ci.`InvNo`
FROM   `mitelman-db.prod.Cytogen`      AS c
JOIN   `mitelman-db.prod.CytogenInv`   AS ci
  ON   c.`RefNo`  = ci.`RefNo`
 AND   c.`CaseNo` = ci.`CaseNo`
WHERE  c.`Morph` = '3111'
  AND  c.`Topo`  = '0401'
LIMIT 20;
```

```sql
-- 4) Description: Show the copy-number aberrations (Gain/Loss/etc.)
--    for the breast-cancer cases selected above.
SELECT
  cv.`RefNo`,
  cv.`CaseNo`,
  cv.`InvNo`,
  cv.`Clone`,
  cv.`Chr`,
  cv.`Type`,
  cv.`Start`,
  cv.`End`
FROM   `mitelman-db.prod.CytoConverted` AS cv
JOIN (
        SELECT DISTINCT `RefNo`, `CaseNo`, `InvNo`
        FROM   `mitelman-db.prod.Cytogen`      AS c
        JOIN   `mitelman-db.prod.CytogenInv`   AS ci
          ON   c.`RefNo`  = ci.`RefNo`
         AND  c.`CaseNo` = ci.`CaseNo`
        WHERE  c.`Morph` = '3111'
          AND  c.`Topo`  = '0401'
     ) AS bc
  ON  cv.`RefNo`  = bc.`RefNo`
 AND cv.`CaseNo`  = bc.`CaseNo`
 AND cv.`InvNo`   = bc.`InvNo`
LIMIT 20;
```

```sql
-- 5) Description: Map every Mitelman CNV event to an hg38 cytoband and
--    count events per cytoband and aberration type.
WITH mitelman_bc AS (
  SELECT
    cv.`Chr`,
    b.`cytoband_name`,
    cv.`Type`
  FROM `mitelman-db.prod.CytoConverted`  AS cv
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON  cv.`Chr` = b.`chromosome`
   AND cv.`Start` < b.`hg38_stop`
   AND cv.`End`   > b.`hg38_start`
  JOIN (
        SELECT DISTINCT `RefNo`, `CaseNo`, `InvNo`
        FROM   `mitelman-db.prod.Cytogen`      AS c
        JOIN   `mitelman-db.prod.CytogenInv`   AS ci
          ON   c.`RefNo`  = ci.`RefNo`
         AND  c.`CaseNo` = ci.`CaseNo`
        WHERE  c.`Morph` = '3111'
          AND  c.`Topo`  = '0401'
       ) AS bc
    ON  cv.`RefNo`  = bc.`RefNo`
   AND cv.`CaseNo`  = bc.`CaseNo`
   AND cv.`InvNo`   = bc.`InvNo`
)
SELECT
  `Chr`         AS chromosome,
  `cytoband_name`,
  `Type`        AS aberration_type,
  COUNT(*)      AS mitelman_events
FROM mitelman_bc
GROUP BY chromosome, cytoband_name, aberration_type
LIMIT 20;
```

```sql
-- 6) Description: Aggregate the counts from (5) to cytoband-level
--    FREQUENCIES for each aberration type within Mitelman.
WITH mitelman_cytoband AS (
  -- (same CTE as in query 5)
  SELECT
    cv.`Chr`,
    b.`cytoband_name`,
    cv.`Type`
  FROM `mitelman-db.prod.CytoConverted`  AS cv
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON  cv.`Chr` = b.`chromosome`
   AND cv.`Start` < b.`hg38_stop`
   AND cv.`End`   > b.`hg38_start`
  JOIN (
        SELECT DISTINCT `RefNo`, `CaseNo`, `InvNo`
        FROM   `mitelman-db.prod.Cytogen`      AS c
        JOIN   `mitelman-db.prod.CytogenInv`   AS ci
          ON   c.`RefNo`  = ci.`RefNo`
         AND  c.`CaseNo` = ci.`CaseNo`
        WHERE  c.`Morph` = '3111'
          AND  c.`Topo`  = '0401'
       ) AS bc
    ON  cv.`RefNo`  = bc.`RefNo`
   AND cv.`CaseNo`  = bc.`CaseNo`
   AND cv.`InvNo`   = bc.`InvNo`
)
SELECT
  `Chr`                AS chromosome,
  `cytoband_name`,
  `Type`               AS aberration_type,
  COUNT(*)             AS mitelman_events,
  ROUND( COUNT(*) / SUM(COUNT(*)) OVER () , 6 ) AS mitelman_frequency
FROM mitelman_cytoband
GROUP BY chromosome, cytoband_name, aberration_type
LIMIT 20;
```

```sql
-- 7) Description: Inspect the pre-calculated TCGA cytoband-level
--    copy-number frequencies (contains freq_amp, freq_gain, etc.).
SELECT
  `chromosome`,
  `cytoband_name`,
  `freq_amp`,
  `freq_gain`,
  `freq_homodel`,
  `freq_heterodel`
FROM  `isb-cgc-bq.TCGA_copy_number_gistic.hg38_cytoband_freq`
LIMIT 20;
```

```sql
-- 8) Description: Summarise the TCGA cytoband-level table to obtain
--    chromosome-level mean frequencies for the four aberration classes.
SELECT
  `chromosome`,
  AVG(`freq_amp`)        AS tcga_amp,
  AVG(`freq_gain`)       AS tcga_gain,
  AVG(`freq_homodel`)    AS tcga_homodel,
  AVG(`freq_heterodel`)  AS tcga_heterodel
FROM  `isb-cgc-bq.TCGA_copy_number_gistic.hg38_cytoband_freq`
GROUP BY chromosome
LIMIT 20;
```

```sql
-- 9) Description: Compute Pearson correlation, by chromosome,
--    between Mitelman and TCGA “Gain” frequencies (require ≥ 5
--    cytobands per chromosome).
WITH mitelman_freq AS (
  -- Re-use query (6) and keep only “Gain”.
  SELECT
    chromosome,
    cytoband_name,
    mitelman_frequency
  FROM (
        /* query 6’s SELECT without LIMIT */
        WITH mitelman_cytoband AS (
          SELECT
            cv.`Chr`,
            b.`cytoband_name`,
            cv.`Type`
          FROM `mitelman-db.prod.CytoConverted`  AS cv
          JOIN `mitelman-db.prod.CytoBands_hg38` AS b
            ON  cv.`Chr` = b.`chromosome`
           AND cv.`Start` < b.`hg38_stop`
           AND cv.`End`   > b.`hg38_start`
          JOIN (
                SELECT DISTINCT `RefNo`, `CaseNo`, `InvNo`
                FROM   `mitelman-db.prod.Cytogen`      AS c
                JOIN   `mitelman-db.prod.CytogenInv`   AS ci
                  ON   c.`RefNo`  = ci.`RefNo`
                 AND  c.`CaseNo` = ci.`CaseNo`
                WHERE  c.`Morph` = '3111'
                  AND  c.`Topo`  = '0401'
             ) AS bc
            ON  cv.`RefNo`  = bc.`RefNo`
           AND cv.`CaseNo`  = bc.`CaseNo`
           AND cv.`InvNo`   = bc.`InvNo`
        )
        SELECT
          `Chr`            AS chromosome,
          `cytoband_name`,
          COUNT(*) / SUM(COUNT(*)) OVER (PARTITION BY `Chr`) AS mitelman_frequency,
          `Type` AS aberration_type
        FROM mitelman_cytoband
        GROUP BY chromosome, cytoband_name, aberration_type
  )
  WHERE aberration_type = 'Gain'
),
tcga_gain AS (
  SELECT
    `chromosome`,
    `cytoband_name`,
    `freq_gain` AS tcga_frequency
  FROM `isb-cgc-bq.TCGA_copy_number_gistic.hg38_cytoband_freq`
)
SELECT
  m.chromosome,
  CORR(m.mitelman_frequency, t.tcga_frequency)                            AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(
        CORR(m.mitelman_frequency, t.tcga_frequency),
        COUNT(*) )                                                        AS p_value,
  COUNT(*)                                                               AS n_cytobands
FROM   mitelman_freq AS m
JOIN   tcga_gain     AS t
  ON   m.chromosome    = t.chromosome
 AND   m.cytoband_name = t.cytoband_name
GROUP BY m.chromosome
HAVING COUNT(*) >= 5
LIMIT 20;
```

```sql
--10) Description: Final query – compute, for every chromosome, the Pearson
--    correlation coefficients and p-values for ALL four aberration classes
--    (amp, gain, heterozygous-del, homozygous-del) where at least five
--    matching cytobands exist for that class.
WITH mitelman AS (
  -------------------------------------------------------------------
  --  (Same logic used in queries 5/6 but collapsed for brevity.)
  -------------------------------------------------------------------
  SELECT
    cv.`Chr`                AS chromosome,
    b.`cytoband_name`,
    cv.`Type`               AS aberration_type,
    COUNT(*) / SUM(COUNT(*)) OVER (PARTITION BY cv.`Chr`, cv.`Type`) 
                            AS mitelman_freq
  FROM `mitelman-db.prod.CytoConverted`  AS cv
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON  cv.`Chr` = b.`chromosome`
   AND cv.`Start` < b.`hg38_stop`
   AND cv.`End`   > b.`hg38_start`
  JOIN (
        SELECT DISTINCT `RefNo`, `CaseNo`, `InvNo`
        FROM   `mitelman-db.prod.Cytogen`      AS c
        JOIN   `mitelman-db.prod.CytogenInv`   AS ci
          ON   c.`RefNo`  = ci.`RefNo`
         AND  c.`CaseNo` = ci.`CaseNo`
        WHERE  c.`Morph` = '3111'
          AND  c.`Topo`  = '0401'
       ) AS bc
    ON  cv.`RefNo`  = bc.`RefNo`
   AND cv.`CaseNo`  = bc.`CaseNo`
   AND cv.`InvNo`   = bc.`InvNo`
GROUP BY chromosome, cytoband_name, aberration_type
),
tcga AS (
  SELECT
    `chromosome`,
    `cytoband_name`,
    'Amp'         AS aberration_type, `freq_amp`       AS tcga_freq  FROM `isb-cgc-bq.TCGA_copy_number_gistic.hg38_cytoband_freq`
  UNION ALL
  SELECT `chromosome`, `cytoband_name`, 'Gain' ,        `freq_gain`       FROM `isb-cgc-bq.TCGA_copy_number_gistic.hg38_cytoband_freq`
  UNION ALL
  SELECT `chromosome`, `cytoband_name`, 'Loss' ,        `freq_heterodel`  FROM `isb-cgc-bq.TCGA_copy_number_gistic.hg38_cytoband_freq`
  UNION ALL
  SELECT `chromosome`, `cytoband_name`, 'Del'  ,        `freq_homodel`    FROM `isb-cgc-bq.TCGA_copy_number_gistic.hg38_cytoband_freq`
)
SELECT
  m.chromosome,
  m.aberration_type,
  CORR(m.mitelman_freq, t.tcga_freq) AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(
        CORR(m.mitelman_freq, t.tcga_freq),
        COUNT(*) )                   AS p_value,
  COUNT(*)                          AS n_cytobands
FROM  mitelman AS m
JOIN  tcga     AS t
  ON  m.chromosome      = t.chromosome
 AND m.cytoband_name    = t.cytoband_name
 AND m.aberration_type  = t.aberration_type
GROUP BY m.chromosome, m.aberration_type
HAVING COUNT(*) >= 5
ORDER BY m.chromosome, m.aberration_type
LIMIT 20;
```

These ten progressively more complex queries start from simple field inspections, build the Mitelman breast-cancer CNV frequencies, bring in TCGA cytoband-level frequencies, and finish with a per-chromosome Pearson correlation and associated p-value (only when at least five cytobands are available) for amplifications, gains, heterozygous losses, and homozygous deletions.
