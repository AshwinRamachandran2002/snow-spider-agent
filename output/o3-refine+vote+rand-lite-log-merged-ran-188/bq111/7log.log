2025-05-05 04:07:13 - Thread-2480 (execute) - INFO - [Try to run SQL in self-refine]
```sql
/*------------------------------------------------------------
  Pearson correlations (per-chromosome) between Mitelman DB and
  TCGA–BRCA copy-number aberration frequencies (Amplification,
  Gain, Loss, Deletion).  Only aberration–chromosome pairs that
  have ≥ 5 matching cytobands are returned; both the correlation
  coefficient and its two-tailed p-value are reported.
------------------------------------------------------------*/
WITH
/*--- 1) Breast-cancer (Morph = 3111, Topo = 0401) Mitelman cases ---*/
bc_cases AS (
  SELECT DISTINCT
         c.RefNo,
         c.CaseNo,
         inv.InvNo
  FROM `mitelman-db.prod.Cytogen`      AS c
  JOIN `mitelman-db.prod.CytogenInv`   AS inv
    ON inv.RefNo  = c.RefNo
   AND inv.CaseNo = c.CaseNo
  WHERE c.Morph = '3111'
    AND c.Topo  = '0401'
),
/*--- 2) Mitelman CNV events mapped to cytobands ---------------*/
mit_events AS (
  SELECT
    bands.chromosome,
    bands.cytoband_name,
    cv.Type                         AS aberration_type,
    CONCAT(cv.RefNo,'|',cv.CaseNo,'|',cv.InvNo) AS case_id
  FROM `mitelman-db.prod.CytoConverted`  AS cv
  JOIN bc_cases                          AS bc
       ON  bc.RefNo  = cv.RefNo
      AND bc.CaseNo = cv.CaseNo
      AND bc.InvNo  = cv.InvNo
  JOIN `mitelman-db.prod.CytoBands_hg38` AS bands
       ON  cv.Chr   = bands.chromosome
      AND cv.Start < bands.hg38_stop
      AND cv.End   > bands.hg38_start
  WHERE cv.Type IN ('Gain','Loss','Amplification','Deletion')
),
/*   distinct cases in the subset                                         */
mit_totals AS (
  SELECT COUNT(DISTINCT case_id) AS total_cases
  FROM mit_events
),
/*   frequency per cytoband                                               */
mit_freq AS (
  SELECT
    chromosome,
    cytoband_name,
    aberration_type,
    COUNT(DISTINCT case_id) / t.total_cases  AS mitelman_freq
  FROM mit_events, mit_totals AS t
  GROUP BY chromosome, cytoband_name, aberration_type, t.total_cases
),
/*--- 3) TCGA-BRCA copy-number segment calls -------------------*/
tcga_segments AS (      --  hg38 segmentation table
  SELECT
    sample_barcode,
    CONCAT('chr', CAST(chromosome AS STRING))      AS chromosome,
    chromStart                                     AS seg_start,
    chromEnd                                       AS seg_end,
    segment_mean
  FROM `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Segment`
  WHERE project_short_name = 'TCGA-BRCA'
),
/*   classify segments into discrete CNV categories                        */
tcga_calls AS (
  SELECT
    sample_barcode,
    chromosome,
    seg_start,
    seg_end,
    CASE
      WHEN segment_mean >=  0.90 THEN 'Amplification'
      WHEN segment_mean >=  0.30 THEN 'Gain'
      WHEN segment_mean <= -0.90 THEN 'Deletion'
      WHEN segment_mean <= -0.30 THEN 'Loss'
    END AS aberration_type
  FROM tcga_segments
  WHERE segment_mean >= 0.30 OR segment_mean <= -0.30
),
/*   map TCGA calls to cytobands                                           */
tcga_events AS (
  SELECT DISTINCT
         bands.chromosome,
         bands.cytoband_name,
         calls.aberration_type,
         calls.sample_barcode
  FROM tcga_calls                            AS calls
  JOIN `mitelman-db.prod.CytoBands_hg38`     AS bands
    ON  calls.chromosome = bands.chromosome
   AND calls.seg_start  < bands.hg38_stop
   AND calls.seg_end    > bands.hg38_start
),
tcga_total AS (   -- number of BRCA samples analysed
  SELECT COUNT(DISTINCT sample_barcode) AS total_samples
  FROM tcga_segments
),
/*   frequency (proportion of samples) per cytoband                        */
tcga_freq AS (
  SELECT
    chromosome,
    cytoband_name,
    aberration_type,
    COUNT(DISTINCT sample_barcode) / t.total_samples AS tcga_freq
  FROM tcga_events, tcga_total AS t
  GROUP BY chromosome, cytoband_name, aberration_type, t.total_samples
),
/*--- 4) Combine Mitelman & TCGA frequencies -------------------*/
freq_pairs AS (
  SELECT
    COALESCE(m.chromosome,  t.chromosome)      AS chromosome,
    COALESCE(m.cytoband_name,t.cytoband_name)  AS cytoband_name,
    COALESCE(m.aberration_type,
             t.aberration_type)                AS aberration_type,
    IFNULL(m.mitelman_freq, 0.0)               AS mitelman_freq,
    IFNULL(t.tcga_freq,      0.0)              AS tcga_freq
  FROM mit_freq AS m
  FULL OUTER JOIN tcga_freq AS t
    USING (chromosome, cytoband_name, aberration_type)
),
/*--- 5) Per-chromosome correlations -------------------------------------*/
per_chr_corr AS (
  SELECT
    chromosome,
    aberration_type,
    CORR(mitelman_freq, tcga_freq) AS pearson_r,
    COUNT(*)                      AS n_bands
  FROM freq_pairs
  GROUP BY chromosome, aberration_type
  HAVING n_bands >= 5
)
/*--- 6) Final output ----------------------------------------------------*/
SELECT
  chromosome,
  aberration_type                         AS aberration,
  pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(pearson_r, n_bands) AS p_value,
  n_bands                               AS matched_cytobands
FROM per_chr_corr
ORDER BY chromosome, aberration;
```
