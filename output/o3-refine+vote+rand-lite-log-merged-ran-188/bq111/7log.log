/*------------------------------------------------------------
  Per-chromosome Pearson correlations between Mitelman breast-
  cancer CNV frequencies (Morph = 3111, Topo = 0401) and
  TCGA-BRCA frequencies for Amplification, Gain, Loss, Deletion.
  Only aberration–chromosome pairs with ≥ 5 cytoband matches
  are reported.  Two-tailed p-values are included.
------------------------------------------------------------*/
WITH
/* 1) Mitelman breast-cancer cases -------------------------------------*/
bc_cases AS (
  SELECT DISTINCT
         c.RefNo,
         c.CaseNo,
         i.InvNo
  FROM `mitelman-db.prod.Cytogen`    AS c
  JOIN `mitelman-db.prod.CytogenInv` AS i
    ON i.RefNo  = c.RefNo
   AND i.CaseNo = c.CaseNo
  WHERE c.Morph = '3111'   -- breast carcinoma
    AND c.Topo  = '0401'   -- breast site
),

/* 2) Mitelman CNV events mapped to cytobands --------------------------*/
mit_events AS (
  SELECT
    b.chromosome,
    b.cytoband_name,
    cv.Type                                      AS aberration_type,
    CONCAT(cv.RefNo,'|',cv.CaseNo,'|',cv.InvNo)  AS case_id
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN bc_cases                         AS bc
    ON  bc.RefNo  = cv.RefNo
   AND bc.CaseNo = cv.CaseNo
   AND bc.InvNo  = cv.InvNo
  JOIN `mitelman-db.prod.CytoBands_hg38` b
    ON  cv.Chr   = b.chromosome
   AND cv.Start < b.hg38_stop
   AND cv.End   > b.hg38_start
  WHERE cv.Type IN ('Gain','Loss','Amplification','Deletion')
),
mit_tot AS ( SELECT COUNT(DISTINCT case_id) AS n_cases FROM mit_events ),
mit_freq AS (
  SELECT
    chromosome,
    cytoband_name,
    aberration_type,
    COUNT(DISTINCT case_id) / n_cases AS mitelman_freq
  FROM mit_events, mit_tot
  GROUP BY chromosome, cytoband_name, aberration_type, n_cases
),

/* 3) TCGA-BRCA copy-number segment data -------------------------------*/
tcga_seg AS (
  SELECT
    sample_barcode,
    CONCAT('chr', chromosome) AS chromosome,
    chrom_start              AS seg_start,
    chrom_end                AS seg_end,
    segment_mean
  FROM `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Segment_Masked`
  WHERE project_short_name = 'TCGA-BRCA'
),
tcga_calls AS (
  SELECT
    sample_barcode,
    chromosome,
    seg_start,
    seg_end,
    CASE
      WHEN segment_mean >=  0.90 THEN 'Amplification'
      WHEN segment_mean >=  0.30 THEN 'Gain'
      WHEN segment_mean <= -0.90 THEN 'Deletion'
      WHEN segment_mean <= -0.30 THEN 'Loss'
    END AS aberration_type
  FROM tcga_seg
  WHERE segment_mean >= 0.30 OR segment_mean <= -0.30
),
tcga_events AS (
  SELECT DISTINCT
         b.chromosome,
         b.cytoband_name,
         c.aberration_type,
         c.sample_barcode
  FROM tcga_calls               AS c
  JOIN `mitelman-db.prod.CytoBands_hg38` b
    ON  c.chromosome = b.chromosome
   AND c.seg_start  < b.hg38_stop
   AND c.seg_end    > b.hg38_start
),
tcga_tot AS ( SELECT COUNT(DISTINCT sample_barcode) AS n_samples FROM tcga_seg ),
tcga_freq AS (
  SELECT
    chromosome,
    cytoband_name,
    aberration_type,
    COUNT(DISTINCT sample_barcode) / n_samples AS tcga_freq
  FROM tcga_events, tcga_tot
  GROUP BY chromosome, cytoband_name, aberration_type, n_samples
),

/* 4) Merge Mitelman & TCGA frequencies -------------------------------*/
pairs AS (
  SELECT
    COALESCE(m.chromosome,  t.chromosome)      AS chromosome,
    COALESCE(m.cytoband_name, t.cytoband_name) AS cytoband_name,
    COALESCE(m.aberration_type,
             t.aberration_type)                AS aberration_type,
    IFNULL(m.mitelman_freq, 0.0)               AS mitelman_freq,
    IFNULL(t.tcga_freq,      0.0)              AS tcga_freq
  FROM mit_freq AS m
  FULL OUTER JOIN tcga_freq AS t
    USING (chromosome, cytoband_name, aberration_type)
),

/* 5) Per-chromosome correlations --------------------------------------*/
per_chr AS (
  SELECT
    chromosome,
    aberration_type,
    CORR(mitelman_freq, tcga_freq) AS r,
    COUNT(*)                      AS n_bands
  FROM pairs
  GROUP BY chromosome, aberration_type
  HAVING n_bands >= 5
)

/* 6) Final output ------------------------------------------------------*/
SELECT
  chromosome,
  aberration_type               AS aberration,
  r                             AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(r, n_bands) AS p_value,
  n_bands                       AS matched_cytobands
FROM per_chr
ORDER BY chromosome, aberration;
