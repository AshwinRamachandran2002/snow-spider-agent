--Description (thinking process):
--  The “no-data” issue may stem from having too few overlapping chromosomes
--  once we split by class and demand both a breast-cancer value and an
--  whole-database value.  Instead of computing correlations, first build a
--  combined table that lists, for every chromosome, its breast-cancer Gain
--  and Loss counts alongside the corresponding whole-database totals.  This
--  lets us confirm there really are overlapping rows before trying CORR().
--  1) breast_cnv  – count Gain and Loss events (Morph 3111 / Topo 0401) per
--     chromosome, stripping the “chr” prefix.
--  2) db_totals   – sum RecurrentNumData TotalCases per chromosome & class
--     (“+” → Gain, “−” → Loss).
--  3) Join on chromosome; show side-by-side counts.  This result should never
--     be empty and will tell us whether a correlation calculation is feasible.
WITH breast_cnv AS (
  SELECT
    REGEXP_REPLACE(cv.`Chr`, r'^chr', '')            AS chromosome,
    SUM(CASE WHEN cv.`Type` = 'Gain' THEN 1 END)     AS bc_gain_events,
    SUM(CASE WHEN cv.`Type` = 'Loss' THEN 1 END)     AS bc_loss_events
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN (
        SELECT DISTINCT c.`RefNo`, c.`CaseNo`, i.`InvNo`
        FROM `mitelman-db.prod.Cytogen`    AS c
        JOIN `mitelman-db.prod.CytogenInv` AS i
              ON  c.`RefNo`  = i.`RefNo`
             AND c.`CaseNo` = i.`CaseNo`
        WHERE c.`Morph` = '3111'
          AND c.`Topo`  = '0401'
       ) AS sub
        ON cv.`RefNo`  = sub.`RefNo`
       AND cv.`CaseNo` = sub.`CaseNo`
       AND cv.`InvNo`  = sub.`InvNo`
  WHERE cv.`Type` IN ('Gain','Loss')
  GROUP BY chromosome
),
db_totals AS (
  SELECT
    `Chromosome`                                                        AS chromosome,
    SUM(CASE WHEN STARTS_WITH(`Abnormality`, '+') 
             THEN CAST(`TotalCases` AS INT64) END)                      AS db_gain_cases,
    SUM(CASE WHEN STARTS_WITH(`Abnormality`, '-') 
             THEN CAST(`TotalCases` AS INT64) END)                      AS db_loss_cases
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE LEFT(`Abnormality`,1) IN ('+','-')
  GROUP BY chromosome
)
SELECT
  bc.chromosome,
  bc.bc_gain_events,
  db.db_gain_cases,
  bc.bc_loss_events,
  db.db_loss_cases
FROM breast_cnv AS bc
JOIN db_totals  AS db
  ON bc.chromosome = db.chromosome
ORDER BY SAFE_CAST(bc.chromosome AS INT64);
