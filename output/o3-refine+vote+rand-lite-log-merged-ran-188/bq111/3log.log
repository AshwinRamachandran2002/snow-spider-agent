```sql
--Description: 8)  Correlate per-chromosome *gains* between Mitelman cohort and
--                TCGA-proxy counts, mapping X→23, Y→24 and using SAFE_CAST.
WITH cohort AS (
  SELECT DISTINCT `RefNo`, `CaseNo`
  FROM `mitelman-db.prod.Cytogen`
  WHERE `Morph` = '3111' AND `Topo` = '0401'
),
mitelman_gain AS (
  SELECT cv.`ChrOrd`,
         COUNT(DISTINCT CONCAT(cv.`RefNo`, '-', cv.`CaseNo`)) AS mit_cases
  FROM   `mitelman-db.prod.CytoConverted` AS cv
  JOIN   cohort USING (`RefNo`, `CaseNo`)
  WHERE  cv.`Type` = 'Gain'
  GROUP  BY cv.`ChrOrd`
),
tcga_gain AS (
  SELECT ChrOrd,
         SUM(tc) AS tcga_cases
  FROM (
    SELECT
      CASE
        WHEN `Chromosome` = 'X' THEN 23
        WHEN `Chromosome` = 'Y' THEN 24
        ELSE SAFE_CAST(`Chromosome` AS INT64)
      END AS ChrOrd,
      CAST(`TotalCases` AS INT64) AS tc
    FROM `mitelman-db.prod.RecurrentNumData`
    WHERE `Morph` = '3111'
      AND `Topo`  = '0401'
      AND STARTS_WITH(`Abnormality`, '+')
  )
  WHERE ChrOrd IS NOT NULL
  GROUP BY ChrOrd
),
joined AS (
  SELECT m.ChrOrd, m.mit_cases, t.tcga_cases
  FROM   mitelman_gain AS m
  JOIN   tcga_gain     AS t USING (ChrOrd)
)
SELECT
  CORR(mit_cases, tcga_cases)                                           AS gain_corr,
  `isb-cgc-bq.functions.corr_pvalue_current`(mit_cases, tcga_cases)     AS p_value
FROM joined
HAVING COUNT(*) >= 5;
```

```sql
--Description: 9)  Correlate per-chromosome *losses* between Mitelman cohort
--                and TCGA-proxy counts, with safe chromosome casting.
WITH cohort AS (
  SELECT DISTINCT `RefNo`, `CaseNo`
  FROM `mitelman-db.prod.Cytogen`
  WHERE `Morph` = '3111' AND `Topo` = '0401'
),
mitelman_loss AS (
  SELECT cv.`ChrOrd`,
         COUNT(DISTINCT CONCAT(cv.`RefNo`, '-', cv.`CaseNo`)) AS mit_cases
  FROM   `mitelman-db.prod.CytoConverted` AS cv
  JOIN   cohort USING (`RefNo`, `CaseNo`)
  WHERE  cv.`Type` = 'Loss'
  GROUP  BY cv.`ChrOrd`
),
tcga_loss AS (
  SELECT ChrOrd,
         SUM(tc) AS tcga_cases
  FROM (
    SELECT
      CASE
        WHEN `Chromosome` = 'X' THEN 23
        WHEN `Chromosome` = 'Y' THEN 24
        ELSE SAFE_CAST(`Chromosome` AS INT64)
      END AS ChrOrd,
      CAST(`TotalCases` AS INT64) AS tc
    FROM `mitelman-db.prod.RecurrentNumData`
    WHERE `Morph` = '3111'
      AND `Topo`  = '0401'
      AND STARTS_WITH(`Abnormality`, '-')
  )
  WHERE ChrOrd IS NOT NULL
  GROUP BY ChrOrd
),
joined AS (
  SELECT m.ChrOrd, m.mit_cases, t.tcga_cases
  FROM   mitelman_loss AS m
  JOIN   tcga_loss     AS t USING (ChrOrd)
)
SELECT
  CORR(mit_cases, tcga_cases)                                           AS loss_corr,
  `isb-cgc-bq.functions.corr_pvalue_current`(mit_cases, tcga_cases)     AS p_value
FROM joined
HAVING COUNT(*) >= 5;
```

```sql
--Description: 10)  Correlate per-chromosome *amplifications* (Amp) and
--                 *deletions* (Del) between datasets, using safe chromosome mapping.
WITH cohort AS (
  SELECT DISTINCT `RefNo`, `CaseNo`
  FROM `mitelman-db.prod.Cytogen`
  WHERE `Morph` = '3111' AND `Topo` = '0401'
),
mitelman AS (
  SELECT cv.`ChrOrd`,
         cv.`Type`,
         COUNT(DISTINCT CONCAT(cv.`RefNo`, '-', cv.`CaseNo`)) AS mit_cases
  FROM   `mitelman-db.prod.CytoConverted` AS cv
  JOIN   cohort USING (`RefNo`, `CaseNo`)
  WHERE  cv.`Type` IN ('Amp','Del')
  GROUP  BY cv.`ChrOrd`, cv.`Type`
),
tcga AS (
  SELECT ChrOrd, Type, SUM(tc) AS tcga_cases
  FROM (
    SELECT
      CASE
        WHEN `Chromosome` = 'X' THEN 23
        WHEN `Chromosome` = 'Y' THEN 24
        ELSE SAFE_CAST(`Chromosome` AS INT64)
      END AS ChrOrd,
      CASE
        WHEN LOWER(`Abnormality`) LIKE 'amp%' THEN 'Amp'
        WHEN LOWER(`Abnormality`) LIKE 'del%' THEN 'Del'
      END AS Type,
      CAST(`TotalCases` AS INT64) AS tc
    FROM `mitelman-db.prod.RecurrentNumData`
    WHERE `Morph` = '3111'
      AND `Topo`  = '0401'
      AND (LOWER(`Abnormality`) LIKE 'amp%' OR LOWER(`Abnormality`) LIKE 'del%')
  )
  WHERE ChrOrd IS NOT NULL AND Type IS NOT NULL
