```sql
--Description / thinking process:
--  Establish whether Mitelman and RecurrentNumData share enough chromosomes
--  for a correlation of “Amp” (amplification) and “Del” (deletion) events.
--  Instead of computing the correlation itself, this query simply counts
--  HOW MANY chromosomes overlap for each class, using the entire data sets
--  (no Morph/Topo filters) so we can gauge feasibility.
--
--  Steps
--    1) mitelman_chr  – distinct (ChrOrd, Type) where Type ∈ ('Amp','Del')
--                       in CytoConverted.
--    2) tcga_chr      – distinct (ChrOrd, Type) where Abnormality text begins
--                       with “amp” or “del” in RecurrentNumData; chromosome
--                       strings mapped to numeric order (X→23, Y→24,
--                       SAFE_CAST autosomes); invalid casts discarded.
--    3) overlap       – inner-join on (ChrOrd, Type).
--    4) Final SELECT  – report the count of overlapping chromosomes per class
--                       so we know whether a Pearson correlation is possible.
WITH mitelman_chr AS (
  SELECT DISTINCT ChrOrd, Type
  FROM `mitelman-db.prod.CytoConverted`
  WHERE Type IN ('Amp','Del')
),
tcga_chr AS (
  SELECT DISTINCT
    CASE
      WHEN Chromosome = 'X' THEN 23
      WHEN Chromosome = 'Y' THEN 24
      ELSE SAFE_CAST(Chromosome AS INT64)
    END AS ChrOrd,
    CASE
      WHEN LOWER(Abnormality) LIKE 'amp%' THEN 'Amp'
      WHEN LOWER(Abnormality) LIKE 'del%' THEN 'Del'
    END AS Type
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE (LOWER(Abnormality) LIKE 'amp%' OR LOWER(Abnormality) LIKE 'del%')
    AND Type IS NOT NULL
    AND Chromosome IS NOT NULL
),
overlap AS (
  SELECT m.ChrOrd, m.Type
  FROM   mitelman_chr AS m
  JOIN   tcga_chr     AS t USING (ChrOrd, Type)
)
SELECT
  Type,
  COUNT(*) AS overlapping_chromosomes
FROM overlap
GROUP BY Type;
```
