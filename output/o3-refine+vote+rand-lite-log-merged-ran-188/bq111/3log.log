[{'chromosome': 'chr1', 'cytoband_name': '1p36', 'hg38_start': 0, 'hg38_stop': 27600000}, {'chromosome': 'chr1', 'cytoband_name': '1p35', 'hg38_start': 27600000, 'hg38_stop': 34300000}, {'chromosome': 'chr1', 'cytoband_name': '1p34', 'hg38_start': 34300000, 'hg38_stop': 46300000}, {'chromosome': 'chr1', 'cytoband_name': '1p33', 'hg38_start': 46300000, 'hg38_stop': 50200000}, {'chromosome': 'chr1', 'cytoband_name': '1p32', 'hg38_start': 50200000, 'hg38_stop': 60800000}]

