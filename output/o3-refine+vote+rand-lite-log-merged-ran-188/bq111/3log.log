```sql
/* ---------------------------------------------------------------
   Pearson correlation (per chromosome) between Mitelman CNA
   frequencies and TCGA CNA frequencies for breast-cancer cases
   (Morph = 3111  AND  Topo = 0401).

   – Aberration types considered:  Amp(lification), Gain, Loss, Del(etion)
   – Only chromosomes with data in BOTH data-sets are used.
   – Only aberration-type rows having ≥ 5 matching chromosomes are returned.
------------------------------------------------------------------*/

WITH
/* 1)  Breast-cancer cohort from Mitelman (all unique cases) */
cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111'
    AND  Topo  = '0401'
),

/* 2)  Mitelman copy-number counts per chromosome & aberration type   */
mit_counts AS (
  SELECT
      CASE
        WHEN cv.Type IN ('Amp','Amplification')                      THEN 'Amp'
        WHEN cv.Type IN ('Del','Deletion')                           THEN 'Del'
        WHEN cv.Type IN ('Gain','gain','Gains')                      THEN 'Gain'
        WHEN cv.Type IN ('Loss','loss','Losses')                     THEN 'Loss'
        ELSE NULL
      END                                    AS AberrType,
      cv.ChrOrd                              AS ChrOrd,
      COUNT(DISTINCT CONCAT(cv.RefNo,'-',cv.CaseNo)) AS mit_cases
  FROM   `mitelman-db.prod.CytoConverted` AS cv
  JOIN   cohort                            USING (RefNo, CaseNo)
  WHERE  cv.Type IN ('Amp','Amplification','Gain','Loss','Del','Deletion')
  GROUP  BY AberrType, ChrOrd
),

/* 3)  TCGA: copy-number counts per chromosome & aberration type.
       Derive from TCGA GISTIC calls that are stored in the public
       ISB-CGC tables (hg38, thresholded by cytoband).               */
tcga_raw AS (
  SELECT
      CASE
        WHEN value =  2 THEN 'Amp'                  -- high-level amplification
        WHEN value =  1 THEN 'Gain'                 -- low-level gain
        WHEN value = -1 THEN 'Del'                  -- heterozygous deletion
        WHEN value = -2 THEN 'Loss'                 -- homozygous deletion
        ELSE NULL
      END                       AS AberrType,
      CASE
        WHEN chromosome = 'X' THEN 23
        WHEN chromosome = 'Y' THEN 24
        ELSE SAFE_CAST(chromosome AS INT64)
      END                       AS ChrOrd,
      aliquot_barcode           AS sample_id
  FROM  `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Gistic2_Thresholded_By_Cytoband`
  WHERE project_short_name = 'TCGA-BRCA'
        -- keep only aberrant calls (drop neutral “0” rows)
        AND value <> 0
        AND AberrType IS NOT NULL
),
tcga_counts AS (
  SELECT
      AberrType,
      ChrOrd,
      COUNT(DISTINCT sample_id) AS tcga_cases
  FROM  tcga_raw
  WHERE ChrOrd IS NOT NULL
  GROUP BY AberrType, ChrOrd
),

/* 4)  Join the two count tables (Mitelman–vs–TCGA) */
joined AS (
  SELECT
      m.AberrType,
      m.ChrOrd,
      m.mit_cases,
      t.tcga_cases
  FROM   mit_counts  AS m
  JOIN   tcga_counts AS t
      ON m.AberrType = t.AberrType
     AND m.ChrOrd    = t.ChrOrd
),

/* 5)  Compute correlation & p-value per aberration type              */
per_type_corr AS (
  SELECT
      AberrType,
      COUNT(*)                                  AS n_chroms,
      CORR(mit_cases, tcga_cases)               AS r_value
  FROM   joined
  GROUP  BY AberrType
  HAVING COUNT(*) >= 5                          -- keep only robust results
)

/* 6)  Final output -------------------------------------------------*/
SELECT
    AberrType                     AS aberration_type,
    n_chroms,
    r_value                       AS pearson_correlation,
    `isb-cgc-bq.functions.corr_pvalue_current`(r_value, n_chroms) AS p_value
FROM  per_type_corr
ORDER BY aberration_type;
```
