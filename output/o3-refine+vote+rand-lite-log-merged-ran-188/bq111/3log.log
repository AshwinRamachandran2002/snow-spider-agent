[{'MolClin': 'C', 'RefNo': 1696, 'InvNo': 1, 'OrderNo': 1, 'Abnormality': 'r'}, {'MolClin': 'C', 'RefNo': 2844, 'InvNo': 1, 'OrderNo': 1, 'Abnormality': 'r'}, {'MolClin': 'C', 'RefNo': 4556, 'InvNo': 1, 'OrderNo': 11, 'Abnormality': 'r'}, {'MolClin': 'C', 'RefNo': 15564, 'InvNo': 1, 'OrderNo': 1, 'Abnormality': 'r'}, {'MolClin': 'C', 'RefNo': 15564, 'InvNo': 2, 'OrderNo': 1, 'Abnormality': 'r'}]

