  and TCGA-BRCA copy-number–aberration frequencies, by chromosome.
----------------------------------------------------------------*/

WITH
/* 1)  Mitelman breast-cancer cohort (unique RefNo-CaseNo pairs) */
cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111'
    AND  Topo  = '0401'
),

/* 2)  Mitelman – count cases with each CNA class on each chromosome */
mit_counts AS (
  SELECT
    CASE
      WHEN cv.Type IN ('Amp','Amplification')  THEN 'Amp'
      WHEN cv.Type IN ('Gain','gain','Gains')  THEN 'Gain'
      WHEN cv.Type IN ('Del','Deletion')       THEN 'Del'
      WHEN cv.Type IN ('Loss','loss','Losses') THEN 'Loss'
    END                                 AS AberrType,
    cv.ChrOrd                           AS ChrOrd,
    COUNT(DISTINCT CONCAT(cv.RefNo,'-',cv.CaseNo)) AS mit_cases
  FROM   `mitelman-db.prod.CytoConverted` AS cv
  JOIN   cohort USING (RefNo, CaseNo)
  WHERE  cv.Type IN ('Amp','Amplification','Gain','Loss','Del','Deletion')
  GROUP  BY AberrType, ChrOrd
),

/* 3)  TCGA-BRCA GISTIC2 thresholded copy-number calls (gene-level, hg38) */
tcga_raw AS (
  SELECT
    CASE
      WHEN value =  2 THEN 'Amp'    -- high-level amplification
      WHEN value =  1 THEN 'Gain'   -- low-level gain
      WHEN value = -1 THEN 'Del'    -- heterozygous deletion
      WHEN value = -2 THEN 'Loss'   -- homozygous deletion
    END                                               AS AberrType,
    CASE
      WHEN REGEXP_REPLACE(chromosome, r'(?i)^chr', '') = 'X' THEN 23
      WHEN REGEXP_REPLACE(chromosome, r'(?i)^chr', '') = 'Y' THEN 24
      ELSE SAFE_CAST(REGEXP_REPLACE(chromosome, r'(?i)^chr', '') AS INT64)
    END                                               AS ChrOrd,
    COALESCE(aliquot_barcode, sample_barcode, participant_barcode) AS sample_id
  FROM  `isb-cgc.TCGA_hg38_data_v1.Copy_Number_Gistic2_Thresholded_By_Gene`
  WHERE project_short_name = 'TCGA-BRCA'
    AND value <> 0                      -- keep only aberrant calls
    AND chromosome IS NOT NULL
    AND ChrOrd IS NOT NULL
    AND AberrType IS NOT NULL
),
tcga_counts AS (
  SELECT
    AberrType,
    ChrOrd,
    COUNT(DISTINCT sample_id) AS tcga_cases
  FROM  tcga_raw
  GROUP BY AberrType, ChrOrd
),

/* 4)  Join Mitelman and TCGA counts on (Aberration type, Chromosome) */
joined AS (
  SELECT
    m.AberrType,
    m.ChrOrd,
    m.mit_cases,
    t.tcga_cases
  FROM   mit_counts  AS m
  JOIN   tcga_counts AS t
    ON   m.AberrType = t.AberrType
   AND   m.ChrOrd    = t.ChrOrd
),

/* 5)  Compute Pearson correlation & p-value per aberration class    */
corr_per_type AS (
  SELECT
    AberrType,
    COUNT(*)                      AS n_chroms,
    CORR(mit_cases, tcga_cases)   AS r_val
  FROM   joined
  GROUP  BY AberrType
  HAVING COUNT(*) >= 5            -- require ≥5 matching chromosomes
)

/* 6)  Final output -------------------------------------------------*/
SELECT
  AberrType                                           AS aberration_type,
  n_chroms,
  r_val                                               AS pearson_correlation,
  `isb-cgc-bq.functions.corr_pvalue_current`(r_val, n_chroms) AS p_value
FROM corr_per_type
ORDER BY aberration_type;
