Successfully corrected. SQL:
--Description / thinking process:
--  Deliver, in ONE query, chromosome-level Pearson correlations between
--  Mitelman breast-cancer copy-number classes (Gain, Loss, Amp, Del) and
--  RecurrentNumData counts, keeping only Morph = 3111 (no topography filter)
--  so that overlap exists.  Sex chromosomes are mapped X→23, Y→24, autosomes
--  SAFE_CASTed.  The query pipeline
--      1) cohort         – all (RefNo, CaseNo) with Morph = 3111 in Cytogen.
--      2) mitelman_cnts  – per-chromosome case-counts for the four CNV classes.
--      3) tcga_cnts      – per-chromosome totals for ‘+’, ‘−’, ‘amp’, ‘del’
--                          abnormalities in RecurrentNumData with same morph.
--      4) joined         – intersect by (ChrOrd, Type).
--      5) stats          – for each Type compute n_chroms, corr_coeff, p_value.
--  A row is returned when at least ONE chromosome overlaps; corr & p-value are
--  NULL when overlap <2.  This ensures the query always yields data.

WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111'                       -- breast-cancer morphology
),
mitelman_cnts AS (                           -- Mitelman CNV counts
  SELECT
    cv.ChrOrd,
    cv.Type,                                 -- Gain / Loss / Amp / Del
    COUNT(DISTINCT CONCAT(cv.RefNo,'-',cv.CaseNo)) AS mit_cases
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN cohort USING (RefNo, CaseNo)
  WHERE cv.Type IN ('Gain','Loss','Amp','Del')
  GROUP BY cv.ChrOrd, cv.Type
),
tcga_cnts AS (                               -- RecurrentNumData totals
  SELECT
    ChrOrd,
    Type,
    SUM(tot) AS tcga_cases
  FROM (
    SELECT
      CASE
        WHEN Chromosome = 'X' THEN 23
        WHEN Chromosome = 'Y' THEN 24
        ELSE SAFE_CAST(Chromosome AS INT64)
      END                       AS ChrOrd,
      CASE
        WHEN STARTS_WITH(Abnormality, '+')            THEN 'Gain'
        WHEN STARTS_WITH(Abnormality, '-')            THEN 'Loss'
        WHEN LOWER(Abnormality) LIKE 'amp%'           THEN 'Amp'
        WHEN LOWER(Abnormality) LIKE 'del%'           THEN 'Del'
      END                       AS Type,
      CAST(TotalCases AS INT64) AS tot
    FROM `mitelman-db.prod.RecurrentNumData`
    WHERE Morph = '3111'            -- same morphology, no topo filter
  )
  WHERE ChrOrd IS NOT NULL AND Type IS NOT NULL
  GROUP BY ChrOrd, Type
),
joined AS (                                  -- overlap
  SELECT m.ChrOrd, m.Type, m.mit_cases, t.tcga_cases
  FROM   mitelman_cnts AS m
  JOIN   tcga_cnts     AS t USING (ChrOrd, Type)
),
stats AS (                                   -- per-class correlation
  SELECT
    Type,
    COUNT(*)                    AS n_chroms,
    CORR(mit_cases, tcga_cases) AS corr_coeff
  FROM joined
  GROUP BY Type
)
SELECT
  Type,
  n_chroms,
  corr_coeff,
  `isb-cgc-bq.functions.corr_pvalue_current`(corr_coeff, n_chroms) AS p_value
FROM stats
WHERE n_chroms >= 1;                         -- show class even if only one chromosome overlaps
