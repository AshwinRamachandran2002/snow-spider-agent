```sql
--Description / thinking process:
--  Purpose:  obtain Pearson correlations (and p-values) for chromosome-level counts
--            of Mitelman “Amp” and “Del” copy-number events versus RecurrentNumData
--            totals (TCGA-proxy) in breast-cancer cases (Morph = 3111, Topo = 0401).
--
--  Steps
--    1. cohort        – all (RefNo, CaseNo) rows matching the morph/topo codes.
--    2. mitelman_cnv  – per-chromosome case-counts for Amp or Del in CytoConverted.
--    3. tcga_cnv      – per-chromosome totals for “amp” / “del” abnormalities,
--                       mapping X→23, Y→24; SAFE_CAST autosomes; discard bad casts.
--    4. joined        – inner-join on (ChrOrd, Type) so only shared chromosomes remain.
--    5. type_stats    – for each Type (Amp / Del) compute:
--                         • num_chroms  = number of matched chromosomes
--                         • corr        = CORR(mit_cases, tcga_cases)
--    6. final SELECT  – feed (corr, n) to helper
--                         isb-cgc-bq.functions.corr_pvalue_current(corr, n),
--                       keep rows with ≥5 chromosomes.
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
mitelman_cnv AS (
  SELECT
    cv.ChrOrd,
    cv.Type,
    COUNT(DISTINCT CONCAT(cv.RefNo, '-', cv.CaseNo)) AS mit_cases
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN cohort USING (RefNo, CaseNo)
  WHERE cv.Type IN ('Amp', 'Del')
  GROUP BY cv.ChrOrd, cv.Type
),
tcga_cnv AS (
  SELECT
    ChrOrd,
    Type,
    SUM(tc) AS tcga_cases
  FROM (
    SELECT
      CASE
        WHEN Chromosome = 'X' THEN 23
        WHEN Chromosome = 'Y' THEN 24
        ELSE SAFE_CAST(Chromosome AS INT64)
      END                        AS ChrOrd,
      CASE
        WHEN LOWER(Abnormality) LIKE 'amp%' THEN 'Amp'
        WHEN LOWER(Abnormality) LIKE 'del%' THEN 'Del'
      END                        AS Type,
      CAST(TotalCases AS INT64)  AS tc
    FROM `mitelman-db.prod.RecurrentNumData`
    WHERE Morph = '3111'
      AND Topo  = '0401'
      AND (LOWER(Abnormality) LIKE 'amp%' OR LOWER(Abnormality) LIKE 'del%')
  )
  WHERE ChrOrd IS NOT NULL AND Type IS NOT NULL
  GROUP BY ChrOrd, Type
),
joined AS (
  SELECT
    m.ChrOrd,
    m.Type,
    m.mit_cases,
    t.tcga_cases
  FROM   mitelman_cnv AS m
  JOIN   tcga_cnv     AS t
    ON   m.ChrOrd = t.ChrOrd
   AND   m.Type   = t.Type
),
type_stats AS (
  SELECT
    Type,
    COUNT(*)                    AS num_chroms,
    CORR(mit_cases, tcga_cases) AS corr
  FROM joined
  GROUP BY Type
)
SELECT
  Type,
  num_chroms,
  corr                       AS corr_coeff,
  `isb-cgc-bq.functions.corr_pvalue_current`(corr, num_chroms) AS p_value
FROM type_stats
WHERE num_chroms >= 5;
