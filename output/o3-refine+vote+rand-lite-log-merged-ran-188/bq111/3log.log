2025-05-05 03:55:51 - Thread-2476 (execute) - INFO - [Exploration]
Below are ten exploratory-to-analytic SQL statements that walk from inspecting the data needed for breast-cancer
(morph = 3111, topo = 0401) cases, through computing copy-number frequencies per chromosome, and finally
estimating Pearson correlations (with p-values) between Mitelman case-level frequencies and the
(pre-aggregated) counts stored in `RecurrentNumData` (used here as the TCGA-comparison proxy).
All queries use only tables in `mitelman-db.prod`.  

```sql
--Description: 1)  Inspect which (Morph, Topo) code pairs exist in Cytogen.
SELECT DISTINCT `Morph`, `Topo`
FROM `mitelman-db.prod.Cytogen`
LIMIT 20;
```

```sql
--Description: 2)  Show a few Cytogen rows for breast-cancer (Morph 3111, Topo 0401).
SELECT *
FROM `mitelman-db.prod.Cytogen`
WHERE `Morph` = '3111'
  AND `Topo` = '0401'
LIMIT 20;
```

```sql
--Description: 3)  Retrieve the (RefNo, CaseNo) set for the breast-cancer cohort.
SELECT DISTINCT `RefNo`, `CaseNo`
FROM `mitelman-db.prod.Cytogen`
WHERE `Morph` = '3111'
  AND `Topo`  = '0401'
LIMIT 20;
```

```sql
--Description: 4)  Look at copy-number rows (CytoConverted) that belong to the cohort.
WITH cohort AS (
  SELECT DISTINCT `RefNo`, `CaseNo`
  FROM `mitelman-db.prod.Cytogen`
  WHERE `Morph` = '3111' AND `Topo` = '0401'
)
SELECT cv.`RefNo`, cv.`CaseNo`, cv.`Chr`, cv.`ChrOrd`, cv.`Type`
FROM   `mitelman-db.prod.CytoConverted` AS cv
JOIN   cohort USING (`RefNo`, `CaseNo`)
LIMIT 20;
```

```sql
--Description: 5)  Count number of cohort cases per chromosome and aberration type.
WITH cohort AS (
  SELECT DISTINCT `RefNo`, `CaseNo`
  FROM `mitelman-db.prod.Cytogen`
  WHERE `Morph` = '3111' AND `Topo` = '0401'
)
SELECT cv.`ChrOrd`,
       cv.`Type`,
       COUNT(DISTINCT CONCAT(cv.`RefNo`, '-', cv.`CaseNo`)) AS case_cnt
FROM   `mitelman-db.prod.CytoConverted` AS cv
JOIN   cohort USING (`RefNo`, `CaseNo`)
GROUP  BY cv.`ChrOrd`, cv.`Type`
ORDER  BY cv.`Type`, cv.`ChrOrd`
LIMIT 20;
```

```sql
--Description: 6)  Inspect RecurrentNumData entries that relate to breast-cancer (Morph 3111, Topo 0401).
SELECT `Chromosome`,
       `Abnormality`,
       `TotalCases`
FROM   `mitelman-db.prod.RecurrentNumData`
WHERE  `Morph` = '3111'
  AND  `Topo`  = '0401'
LIMIT 20;
```

```sql
--Description: 7)  Summarise RecurrentNumData into chromosome-level copy-number categories.
WITH tcga_like AS (
  SELECT CAST(`Chromosome` AS INT64)              AS ChrOrd,
         CASE
           WHEN STARTS_WITH(`Abnormality`, '+')         THEN 'Gain'
           WHEN STARTS_WITH(`Abnormality`, '-')         THEN 'Loss'
           WHEN LOWER(`Abnormality`) LIKE 'amp%'        THEN 'Amp'
           WHEN LOWER(`Abnormality`) LIKE 'del%'        THEN 'Del'
         END                                           AS Type,
         SUM(CAST(`TotalCases` AS INT64))              AS total_cases
  FROM   `mitelman-db.prod.RecurrentNumData`
  WHERE  `Morph` = '3111'
    AND  `Topo`  = '0401'
  GROUP  BY ChrOrd, Type
)
SELECT *
FROM   tcga_like
ORDER  BY Type, ChrOrd
LIMIT 20;
```

```sql
--Description: 8)  Correlate per-chromosome *gains* between Mitelman cohort and TCGA-proxy counts.
WITH cohort AS (
  SELECT DISTINCT `RefNo`, `CaseNo`
  FROM `mitelman-db.prod.Cytogen`
  WHERE `Morph` = '3111' AND `Topo` = '0401'
),
mitelman_gain AS (
  SELECT cv.`ChrOrd`,
         COUNT(DISTINCT CONCAT(cv.`RefNo`, '-', cv.`CaseNo`)) AS mit_cases
  FROM   `mitelman-db.prod.CytoConverted` AS cv
  JOIN   cohort USING (`RefNo`, `CaseNo`)
  WHERE  cv.`Type` = 'Gain'
  GROUP  BY cv.`ChrOrd`
),
tcga_gain AS (
  SELECT ChrOrd,
         total_cases AS tcga_cases
  FROM (
    SELECT CAST(`Chromosome` AS INT64) AS ChrOrd,
           SUM(CAST(`TotalCases` AS INT64)) AS total_cases
    FROM   `mitelman-db.prod.RecurrentNumData`
    WHERE  `Morph` = '3111'
      AND  `Topo`  = '0401'
      AND  STARTS_WITH(`Abnormality`, '+')
    GROUP  BY ChrOrd
  )
),
joined AS (
  SELECT m.ChrOrd,
         m.mit_cases,
         t.tcga_cases
  FROM   mitelman_gain AS m
  JOIN   tcga_gain     AS t USING (ChrOrd)
  WHERE  m.mit_cases IS NOT NULL
    AND  t.tcga_cases IS NOT NULL
)
SELECT CORR(mit_cases, tcga_cases) AS gain_corr,
       `isb-cgc-bq.functions.corr_pvalue_current`(mit_cases, tcga_cases) AS p_value
FROM   joined
HAVING COUNT(*) >= 5
LIMIT 20;
```

```sql
--Description: 9)  Correlate per-chromosome *losses* between the two datasets.
WITH cohort AS (
  SELECT DISTINCT `RefNo`, `CaseNo`
  FROM `mitelman-db.prod.Cytogen`
  WHERE `Morph` = '3111' AND `Topo` = '0401'
),
mitelman_loss AS (
  SELECT cv.`ChrOrd`,
         COUNT(DISTINCT CONCAT(cv.`RefNo`, '-', cv.`CaseNo`)) AS mit_cases
  FROM   `mitelman-db.prod.CytoConverted` AS cv
  JOIN   cohort USING (`RefNo`, `CaseNo`)
  WHERE  cv.`Type` = 'Loss'
  GROUP  BY cv.`ChrOrd`
),
tcga_loss AS (
  SELECT ChrOrd,
         total_cases AS tcga_cases
  FROM (
    SELECT CAST(`Chromosome` AS INT64) AS ChrOrd,
           SUM(CAST(`TotalCases` AS INT64)) AS total_cases
    FROM   `mitelman-db.prod.RecurrentNumData`
    WHERE  `Morph` = '3111'
      AND  `Topo`  = '0401'
      AND  STARTS_WITH(`Abnormality`, '-')
    GROUP  BY ChrOrd
  )
),
joined AS (
  SELECT m.ChrOrd,
         m.mit_cases,
         t.tcga_cases
  FROM   mitelman_loss AS m
  JOIN   tcga_loss     AS t USING (ChrOrd)
)
SELECT CORR(mit_cases, tcga_cases) AS loss_corr,
       `isb-cgc-bq.functions.corr_pvalue_current`(mit_cases, tcga_cases) AS p_value
FROM   joined
HAVING COUNT(*) >= 5
LIMIT 20;
```

```sql
--Description: 10)  Repeat correlation for *amplifications* (Amp) and *deletions* (Del) in one shot.
WITH cohort AS (
  SELECT DISTINCT `RefNo`, `CaseNo`
  FROM `mitelman-db.prod.Cytogen`
  WHERE `Morph` = '3111' AND `Topo` = '0401'
),
mitelman AS (
  SELECT cv.`ChrOrd`,
         cv.`Type`,
         COUNT(DISTINCT CONCAT(cv.`RefNo`, '-', cv.`CaseNo`)) AS mit_cases
  FROM   `mitelman-db.prod.CytoConverted` AS cv
  JOIN   cohort USING (`RefNo`, `CaseNo`)
  WHERE  cv.`Type` IN ('Amp','Del')
  GROUP  BY cv.`ChrOrd`, cv.`Type`
),
tcga AS (
  SELECT CAST(`Chromosome` AS INT64) AS ChrOrd,
         CASE
           WHEN LOWER(`Abnormality`) LIKE 'amp%' THEN 'Amp'
           WHEN LOWER(`Abnormality`) LIKE 'del%' THEN 'Del'
         END AS Type,
         SUM(CAST(`TotalCases` AS INT64)) AS tcga_cases
  FROM   `mitelman-db.prod.RecurrentNumData`
  WHERE  `Morph` = '3111'
    AND  `Topo`  = '0401'
    AND  (LOWER(`Abnormality`) LIKE 'amp%' OR LOWER(`Abnormality`) LIKE 'del%')
  GROUP  BY ChrOrd, Type
),
joined AS (
  SELECT m.ChrOrd, m.Type, m.mit_cases, t.tcga_cases
  FROM   mitelman AS m
  JOIN   tcga     AS t USING (ChrOrd, Type)
)
SELECT Type,
       CORR(mit_cases, tcga_cases)                                               AS corr_coeff,
       `isb-cgc-bq.functions.corr_pvalue_current`(mit_cases, tcga_cases)         AS p_value
FROM   joined
GROUP  BY Type
HAVING COUNT(*) >= 5
LIMIT 20;
```

Each successive query builds context, leading to the final correlations (and p-values) for
Gains, Losses, Amplifications and Deletions, restricted to chromosomes represented by at least
five matching records in both datasets.
