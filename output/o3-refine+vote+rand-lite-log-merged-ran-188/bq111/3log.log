```sql
--Description / Thinking process:
-- Objective: compute Pearson correlation (and p-value) for chromosome-level *Loss*
--            counts between Mitelman breast-cancer cases (Morph = 3111, Topo = 0401)
--            and RecurrentNumData “−” abnormalities (TCGA-proxy).
-- Key points addressed
--   • Chromosome field is STRING; map ‘X’→23, ‘Y’→24, SAFE_CAST others, discard NULLs.
--   • Build per-chromosome counts in each dataset, then inner-join on ChrOrd.
--   • Use ARRAY_AGG in the p-value helper to satisfy aggregation rules.
--   • Return result only if at least 5 chromosomes are represented.
WITH cohort AS (                             -- breast-cancer case set
  SELECT DISTINCT `RefNo`, `CaseNo`
  FROM `mitelman-db.prod.Cytogen`
  WHERE `Morph` = '3111'
    AND `Topo`  = '0401'
),
mitelman_loss AS (                           -- Mitelman “Loss” counts / chromosome
  SELECT
    cv.`ChrOrd`,
    COUNT(DISTINCT CONCAT(cv.`RefNo`, '-', cv.`CaseNo`)) AS mit_cases
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN cohort USING (`RefNo`, `CaseNo`)
  WHERE cv.`Type` = 'Loss'
  GROUP BY cv.`ChrOrd`
),
tcga_loss AS (                               -- TCGA-proxy “−” counts / chromosome
  SELECT
    chr AS ChrOrd,
    SUM(tot) AS tcga_cases
  FROM (
    SELECT
      CASE
        WHEN `Chromosome` = 'X' THEN 23
        WHEN `Chromosome` = 'Y' THEN 24
        ELSE SAFE_CAST(`Chromosome` AS INT64)
      END                          AS chr,
      CAST(`TotalCases` AS INT64)  AS tot
    FROM `mitelman-db.prod.RecurrentNumData`
    WHERE `Morph` = '3111'
      AND `Topo`  = '0401'
      AND STARTS_WITH(`Abnormality`, '-')
  )
  WHERE chr IS NOT NULL
  GROUP BY chr
),
joined AS (                                  -- common chromosomes only
  SELECT
    m.ChrOrd,
    m.mit_cases,
    t.tcga_cases
  FROM mitelman_loss AS m
  JOIN tcga_loss     AS t USING (ChrOrd)
)
SELECT
  COUNT(*)                                               AS num_chroms,
  CORR(mit_cases, tcga_cases)                            AS loss_corr,
  `isb-cgc-bq.functions.corr_pvalue_current`(
      ARRAY_AGG(mit_cases),
      ARRAY_AGG(tcga_cases)
  )                                                      AS p_value
FROM joined
HAVING num_chroms >= 5;         -- ensure minimum of five matched chromosomes
