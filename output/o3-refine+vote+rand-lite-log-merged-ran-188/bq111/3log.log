--Description / thinking process:
-- Compute the chromosome-level Pearson correlation between Mitelman breast-cancer
-- “Gain” events and the corresponding “+” abnormalities in RecurrentNumData.
-- • cohort            – all (RefNo, CaseNo) with Morph 3111 & Topo 0401.
-- • mitelman_gain     – number of cohort cases that display Type='Gain' per ChrOrd.
-- • tcga_gain         – total “+” cases per chromosome in RecurrentNumData, mapping
--                       Chromosome STRING → numeric order (X→23, Y→24, SAFE_CAST others);
--                       rows where the cast fails are discarded.
-- • joined            – chromosomes present in both datasets.
-- • stats             – derive:
--       n_chroms  : number of matched chromosomes (must be ≥2 for CORR).
--       corr_val  : Pearson correlation of mit_cases vs. tcga_cases.
--       p_value   : two-sided p-value via helper
--                   isb-cgc-bq.functions.corr_pvalue_current(corr FLOAT64, n INT64).
-- The query returns exactly one row (or zero if <2 chromosomes overlap).

WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
mitelman_gain AS (
  SELECT
    cv.ChrOrd,
    COUNT(DISTINCT CONCAT(cv.RefNo, '-', cv.CaseNo)) AS mit_cases
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN cohort USING (RefNo, CaseNo)
  WHERE cv.Type = 'Gain'
  GROUP BY cv.ChrOrd
),
tcga_gain AS (
  SELECT
    ChrOrd,
    SUM(total) AS tcga_cases
  FROM (
    SELECT
      CASE
        WHEN Chromosome = 'X' THEN 23
        WHEN Chromosome = 'Y' THEN 24
        ELSE SAFE_CAST(Chromosome AS INT64)
      END                        AS ChrOrd,
      CAST(TotalCases AS INT64)  AS total
    FROM `mitelman-db.prod.RecurrentNumData`
    WHERE Morph = '3111'
      AND Topo  = '0401'
      AND STARTS_WITH(Abnormality, '+')
  )
  WHERE ChrOrd IS NOT NULL
  GROUP BY ChrOrd
),
joined AS (
  SELECT
    m.ChrOrd,
    m.mit_cases,
    t.tcga_cases
  FROM mitelman_gain AS m
  JOIN tcga_gain     AS t USING (ChrOrd)
)
SELECT
  n_chroms,
  corr_val                         AS gain_corr,
  `isb-cgc-bq.functions.corr_pvalue_current`(corr_val, n_chroms) AS p_value
FROM (
  SELECT
    COUNT(*)                    AS n_chroms,
    CORR(mit_cases, tcga_cases) AS corr_val
  FROM joined
)
WHERE n_chroms >= 2;   -- ensure enough points for correlation
