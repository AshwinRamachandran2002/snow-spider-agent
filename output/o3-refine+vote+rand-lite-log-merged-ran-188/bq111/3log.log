--Description / thinking process:
--  Compute per-chromosome correlations between Mitelman “Amp” and “Del” breast-cancer
--  events (Morph = 3111, all topographies) and RecurrentNumData totals for the same
--  CNV classes (also Morph = 3111, no topography filter).  Sex chromosomes are mapped
--  to numeric order (X→23, Y→24) and autosomes SAFE_CASTed.  For each CNV class we
--  count overlapping chromosomes (n_chroms), calculate the Pearson correlation
--  (corr_coeff), and obtain a two-sided p-value with
--  isb-cgc-bq.functions.corr_pvalue_current(corr, n).  A row is reported when at
--  least one chromosome overlaps; with a single chromosome corr/p-value will be NULL.

WITH cohort AS (                        -- all breast-cancer cases (any topology)
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111'
),
mitelman AS (                           -- Amp / Del case counts per chromosome
  SELECT
    cv.ChrOrd,
    cv.Type,                                           -- 'Amp' or 'Del'
    COUNT(DISTINCT CONCAT(cv.RefNo,'-',cv.CaseNo)) AS mit_cases
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN cohort USING (RefNo, CaseNo)
  WHERE cv.Type IN ('Amp','Del')
  GROUP BY cv.ChrOrd, cv.Type
),
tcga AS (                               -- RecurrentNumData totals (Morph 3111)
  SELECT
    ChrOrd,
    Type,
    SUM(cases) AS tcga_cases
  FROM (
    SELECT
      CASE
        WHEN Chromosome = 'X' THEN 23
        WHEN Chromosome = 'Y' THEN 24
        ELSE SAFE_CAST(Chromosome AS INT64)
      END                               AS ChrOrd,
      CASE
        WHEN LOWER(Abnormality) LIKE 'amp%' THEN 'Amp'
        WHEN LOWER(Abnormality) LIKE 'del%' THEN 'Del'
      END                               AS Type,
      CAST(TotalCases AS INT64)         AS cases
    FROM `mitelman-db.prod.RecurrentNumData`
    WHERE Morph = '3111'
      AND (LOWER(Abnormality) LIKE 'amp%' OR LOWER(Abnormality) LIKE 'del%')
  )
  WHERE ChrOrd IS NOT NULL AND Type IS NOT NULL
  GROUP BY ChrOrd, Type
),
joined AS (                            -- chromosomes present in both datasets
  SELECT m.ChrOrd, m.Type, m.mit_cases, t.tcga_cases
  FROM   mitelman AS m
  JOIN   tcga     AS t USING (ChrOrd, Type)
),
stats AS (                             -- correlation per CNV class
  SELECT
    Type,
    COUNT(*)                    AS n_chroms,
    CORR(mit_cases, tcga_cases) AS corr_coeff
  FROM joined
  GROUP BY Type
)
SELECT
  Type,
  n_chroms,
  corr_coeff,
  `isb-cgc-bq.functions.corr_pvalue_current`(corr_coeff, n_chroms) AS p_value
FROM stats
WHERE n_chroms >= 1;                 -- show result even if only one chromosome overlaps
