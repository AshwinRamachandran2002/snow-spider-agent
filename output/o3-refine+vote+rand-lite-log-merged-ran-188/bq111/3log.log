--Description / Thinking process:
-- 1. Need chromosome-level counts of copy-number categories (Gain, Loss, Amp, Del)
--    for breast-cancer cohort (Morph = 3111, Topo = 0401) in RecurrentNumData.
-- 2. Chromosome column is STRING and may be 'X' or 'Y'; INT64 cast fails on letters.
--    Map 'X' → 23, 'Y' → 24, and SAFE_CAST numeric strings; later discard NULLs.
-- 3. Classify abnormalities:
--        prefix '+'  → Gain
--        prefix '-'  → Loss
--        starts with 'amp' → Amp
--        starts with 'del' → Del
-- 4. Aggregate SUM(TotalCases) per (ChrOrd, Type).  
-- 5. Return results ordered by Type then chromosome, trimming invalid rows.
WITH chrom_totals AS (
  SELECT
      CASE
          WHEN `Chromosome` = 'X' THEN 23         -- map sex chromosomes
          WHEN `Chromosome` = 'Y' THEN 24
          ELSE SAFE_CAST(`Chromosome` AS INT64)   -- numeric autosomes
      END AS ChrOrd,
      CASE
          WHEN STARTS_WITH(`Abnormality`, '+')               THEN 'Gain'
          WHEN STARTS_WITH(`Abnormality`, '-')               THEN 'Loss'
          WHEN LOWER(`Abnormality`) LIKE 'amp%'              THEN 'Amp'
          WHEN LOWER(`Abnormality`) LIKE 'del%'              THEN 'Del'
      END AS Type,
      SUM(CAST(`TotalCases` AS INT64)) AS total_cases
  FROM `mitelman-db.prod.RecurrentNumData`
  WHERE `Morph` = '3111'
    AND `Topo`  = '0401'
  GROUP BY ChrOrd, Type
)
SELECT *
FROM   chrom_totals
WHERE  ChrOrd IS NOT NULL            -- exclude rows where SAFE_CAST failed
ORDER  BY Type, ChrOrd
LIMIT 20;
