Query:
--Description: 9)  Correlate per-chromosome “Loss” counts (Mitelman vs TCGA-proxy)
--              for breast-cancer (Morph 3111, Topo 0401) using safe chromosome
--              casting and correct p-value signature.
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
mitelman_loss AS (
  SELECT
    cv.ChrOrd,
    COUNT(DISTINCT CONCAT(cv.RefNo, '-', cv.CaseNo)) AS mit_cases
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN cohort USING (RefNo, CaseNo)
  WHERE cv.Type = 'Loss'
  GROUP BY cv.ChrOrd
),
tcga_loss AS (
  SELECT
    ChrOrd,
    SUM(tot) AS tcga_cases
  FROM (
    SELECT
      CASE
        WHEN Chromosome = 'X' THEN 23
        WHEN Chromosome = 'Y' THEN 24
        ELSE SAFE_CAST(Chromosome AS INT64)
      END                       AS ChrOrd,
      CAST(TotalCases AS INT64) AS tot
    FROM `mitelman-db.prod.RecurrentNumData`
    WHERE Morph = '3111' AND Topo = '0401'
      AND STARTS_WITH(Abnormality, '-')
  )
  WHERE ChrOrd IS NOT NULL
  GROUP BY ChrOrd
),
joined AS (
  SELECT m.ChrOrd, m.mit_cases, t.tcga_cases
  FROM   mitelman_loss AS m
  JOIN   tcga_loss     AS t USING (ChrOrd)
)
SELECT
  n_chroms,
  corr_val                         AS loss_corr,
  `isb-cgc-bq.functions.corr_pvalue_current`(corr_val, n_chroms) AS p_value
FROM (
  SELECT
    COUNT(*)                    AS n_chroms,
    CORR(mit_cases, tcga_cases) AS corr_val
  FROM joined
)
WHERE n_chroms >= 2
