```sql
--Description: 01) Show some breast-cancer (morph = 3111, topo = 0401) cases stored in the Cytogen table
SELECT `RefNo`, `CaseNo`, `Morph`, `Topo`, `Series`, `Country`
FROM   `mitelman-db.prod.Cytogen`
WHERE  `Morph` = '3111' AND `Topo` = '0401'
LIMIT  20;
```

```sql
--Description: 02) Count the number of unique (RefNo-CaseNo) breast-cancer cases
SELECT COUNT(DISTINCT CONCAT(CAST(`RefNo` AS STRING),'-',`CaseNo`)) AS total_cases
FROM   `mitelman-db.prod.Cytogen`
WHERE  `Morph` = '3111' AND `Topo` = '0401'
LIMIT  20;
```

```sql
--Description: 03) Retrieve CytoConverted copy-number rows that belong to the same cohort
SELECT cc.*
FROM   `mitelman-db.prod.CytoConverted` AS cc
JOIN   `mitelman-db.prod.Cytogen`      AS cg
ON     cc.RefNo = cg.RefNo
WHERE  cg.Morph = '3111' AND cg.Topo = '0401'
LIMIT  20;
```

```sql
--Description: 04) How many copy-number events of each type (Gain/Loss/Amp/Del) per chromosome in the cohort?
SELECT cc.Chr,
       cc.Type,
       COUNT(*) AS event_cnt
FROM   `mitelman-db.prod.CytoConverted` AS cc
JOIN   `mitelman-db.prod.Cytogen`      AS cg
ON     cc.RefNo = cg.RefNo
WHERE  cg.Morph = '3111' AND cg.Topo = '0401'
GROUP  BY cc.Chr, cc.Type
ORDER  BY cc.Chr, cc.Type
LIMIT  20;
```

```sql
--Description: 05) Compute per-chromosome absolute and relative frequency of GAIN/Amp events
WITH cohort AS (
  SELECT DISTINCT RefNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111' AND Topo = '0401'
),
gain_events AS (
  SELECT Chr, COUNT(*) AS gain_cnt
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  Type IN ('Gain','Amp')
    AND  RefNo IN (SELECT RefNo FROM cohort)
  GROUP  BY Chr
),
total_ev AS (
  SELECT COUNT(*) AS all_cnt
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  RefNo IN (SELECT RefNo FROM cohort)
)
SELECT g.Chr,
       g.gain_cnt,
       ROUND(g.gain_cnt / t.all_cnt, 4) AS gain_freq
FROM   gain_events g
CROSS JOIN total_ev t
ORDER  BY g.Chr
LIMIT  20;
```

```sql
--Description: 06) Compute per-chromosome absolute and relative frequency of LOSS/Deletion events
WITH cohort AS (
  SELECT DISTINCT RefNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111' AND Topo = '0401'
),
loss_events AS (
  SELECT Chr, COUNT(*) AS loss_cnt
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  Type IN ('Loss','Del')
    AND  RefNo IN (SELECT RefNo FROM cohort)
  GROUP  BY Chr
),
total_ev AS (
  SELECT COUNT(*) AS all_cnt
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  RefNo IN (SELECT RefNo FROM cohort)
)
SELECT l.Chr,
       l.loss_cnt,
       ROUND(l.loss_cnt / t.all_cnt, 4) AS loss_freq
FROM   loss_events l
CROSS JOIN total_ev t
ORDER  BY l.Chr
LIMIT  20;
```

```sql
--Description: 07) Inspect pre-aggregated RecurrentNumData rows for this morphology & topology
SELECT `Chromosome`, `Abnormality`, `TotalCases`
FROM   `mitelman-db.prod.RecurrentNumData`
WHERE  `Morph` = '3111' AND `Topo` = '0401'
LIMIT  20;
```

```sql
--Description: 08) Aggregate numbers of ‘gain’ (+) and ‘loss’ (–) abnormalities per chromosome from RecurrentNumData
SELECT Chromosome,
       SUM(CASE WHEN STARTS_WITH(Abnormality,'+') THEN CAST(TotalCases AS INT64) ELSE 0 END) AS gains,
       SUM(CASE WHEN STARTS_WITH(Abnormality,'-') THEN CAST(TotalCases AS INT64) ELSE 0 END) AS losses,
       SUM(CAST(TotalCases AS INT64))                                                     AS total_aberr
FROM   `mitelman-db.prod.RecurrentNumData`
WHERE  Morph = '3111' AND Topo = '0401'
GROUP  BY Chromosome
ORDER  BY Chromosome
LIMIT  20;
```

```sql
--Description: 09) Compute the Pearson correlation between per-chromosome gains and losses in the Mitelman cohort
WITH per_chr AS (
  SELECT Chromosome,
         SUM(CASE WHEN STARTS_WITH(Abnormality,'+') THEN CAST(TotalCases AS INT64) ELSE 0 END) AS gains,
         SUM(CASE WHEN STARTS_WITH(Abnormality,'-') THEN CAST(TotalCases AS INT64) ELSE 0 END) AS losses
  FROM   `mitelman-db.prod.RecurrentNumData`
  WHERE  Morph = '3111' AND Topo = '0401'
  GROUP  BY Chromosome
)
SELECT CORR(gains, losses) AS gain_vs_loss_corr
FROM   per_chr
LIMIT  20;
```

```sql
--Description: 10) Example join to compare two Mitelman-derived gain datasets (case-level vs. RecurrentNumData) – 
--              this illustrates the structure you’d later reuse to add an external TCGA table
WITH cohort AS (
  SELECT DISTINCT RefNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111' AND Topo = '0401'
),
case_level AS (                         -- CytoConverted gains
  SELECT REGEXP_REPLACE(Chr, r'^chr','') AS Chromosome,
         COUNT(*)                        AS case_gain_cnt
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  Type IN ('Gain','Amp')
    AND  RefNo IN (SELECT RefNo FROM cohort)
  GROUP  BY Chromosome
),
recurrent AS (                          -- RecurrentNumData gains
  SELECT Chromosome,
         SUM(CAST(TotalCases AS INT64)) AS recur_gain_cnt
  FROM   `mitelman-db.prod.RecurrentNumData`
  WHERE  Morph = '3111' AND Topo = '0401'
    AND  STARTS_WITH(Abnormality,'+')
  GROUP  BY Chromosome
),
joined AS (
  SELECT c.Chromosome,
         c.case_gain_cnt,
         r.recur_gain_cnt
  FROM   case_level c
  JOIN   recurrent  r USING (Chromosome)
)
SELECT *
FROM   joined
WHERE  joined.case_gain_cnt IS NOT NULL
LIMIT  20;
```
