/*------------------------------------------------------------------------------
   Pearson correlation ( r ) and p-value between Mitelman and TCGA copy-number
   frequencies (Amplification, Gain, Loss, Deletion) computed chromosome-wise
   for breast-cancer (Morph = 3111,  Topo = 0401).

   • Mitelman copy-number events come from CytoConverted (hg38 coordinates).
   • TCGA events are derived on-the-fly from BRCA copy-number SEGMENT data
     (Copy_Number_Segment_Masked, hg38) using common log2-ratio thresholds:
           ≥ 0.90 → Amp     0.30–0.90 → Gain
           ≤ -0.90 → Del    ‑0.30–-0.90 → Loss
   • Frequencies are calculated for every cytoband; correlations are returned
     only when ≥ 5 cytobands are shared by both data sets for the given
     chromosome × aberration-type pair.
------------------------------------------------------------------------------*/

DECLARE morph STRING DEFAULT '3111';     -- morphology  (breast carcinoma)
DECLARE topo  STRING DEFAULT '0401';     -- topography (breast)

WITH
/*---------------------------------------------------------------------------
   1.  Mitelman breast-cancer cohort
---------------------------------------------------------------------------*/
mitelman_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = morph
    AND  Topo  = topo
),
mitel_tot AS (
  SELECT COUNT(DISTINCT CONCAT(RefNo,'-',CaseNo)) AS n_mitelman
  FROM   mitelman_cases
),
mitelman_events AS (                       -- map CNA events to cytobands
  SELECT
      cc.RefNo,
      cc.CaseNo,
      cc.Type,                                   -- Amp | Gain | Loss | Del
      REGEXP_REPLACE(cb.chromosome, r'^chr','') AS chromosome,
      cb.cytoband_name                           AS cytoband
  FROM   `mitelman-db.prod.CytoConverted`  AS cc
  JOIN   mitelman_cases                     mc  ON cc.RefNo  = mc.RefNo
                                               AND cc.CaseNo = mc.CaseNo
  JOIN   `mitelman-db.prod.CytoBands_hg38` cb  ON cb.chromosome = cc.Chr
                                              AND cc.Start < cb.hg38_stop
                                              AND cc.End   > cb.hg38_start
  WHERE  cc.Type IN ('Amp','Gain','Loss','Del')
),
mitelman_freq AS (                         -- cytoband-level frequency
  SELECT
      chromosome,
      cytoband,
      Type,
      COUNT(DISTINCT CONCAT(RefNo,'-',CaseNo))
        / (SELECT n_mitelman FROM mitel_tot) AS freq_mitelman
  FROM  mitelman_events
  GROUP BY chromosome, cytoband, Type
),

/*---------------------------------------------------------------------------
   2.  TCGA BRCA copy-number calls  (derive Amp/Gain/Loss/Del from segments)
---------------------------------------------------------------------------*/
tcga_seg AS (                              -- BRCA segments (hg38)
  SELECT
      ParticipantBarcode                     AS sample_id,
      CASE                                   -- translate log2 ratio to call
        WHEN Segment_Mean >=  0.90 THEN 'Amp'
        WHEN Segment_Mean >=  0.30 THEN 'Gain'
        WHEN Segment_Mean <= -0.90 THEN 'Del'
        WHEN Segment_Mean <= -0.30 THEN 'Loss'
      END                                   AS Type,
      CASE                                   -- unify chromosome naming
        WHEN Chromosome IN ('23','X') THEN 'X'
        WHEN Chromosome IN ('24','Y') THEN 'Y'
        ELSE Chromosome
      END                                   AS chromosome,
      Start_Position                         AS start_bp,
      End_Position                           AS end_bp
