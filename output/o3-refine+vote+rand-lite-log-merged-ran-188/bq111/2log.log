--Description: 08) Aggregate numbers of ‘gain’ (+) and ‘loss’ (–) abnormalities per chromosome from RecurrentNumData
SELECT Chromosome,
       SUM(CASE WHEN STARTS_WITH(Abnormality,'+') THEN CAST(TotalCases AS INT64) ELSE 0 END) AS gains,
       SUM(CASE WHEN STARTS_WITH(Abnormality,'-') THEN CAST(TotalCases AS INT64) ELSE 0 END) AS losses,
       SUM(CAST(TotalCases AS INT64))                                                     AS total_aberr
FROM   `mitelman-db.prod.RecurrentNumData`
WHERE  Morph = '3111' AND Topo = '0401'
GROUP  BY Chromosome
ORDER  BY Chromosome
LIMIT  20;
