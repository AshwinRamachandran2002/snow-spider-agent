/*------------------------------------------------------------------------------
  Pearson correlation (and p-value) between Mitelman and TCGA copy-number
  frequencies, calculated per chromosome and aberration type (Amp, Gain, Loss,
  Del) for breast-cancer cases  (Morph = 3111 , Topo = 0401).

  – Mitelman frequencies are computed at cytoband-resolution with CytoConverter
    coordinates.
  – TCGA frequencies come from the public GISTIC2 thresholded calls table that
    is available in the “isb-cgc-bq” project.
  – Correlations are returned only when ≥ 5 cytobands are present in both data
    sets for the chromosome / aberration-type pair.
------------------------------------------------------------------------------*/

DECLARE morph STRING DEFAULT '3111';      -- breast‐cancer morphology code
DECLARE topo  STRING DEFAULT '0401';      -- breast‐cancer topography code

WITH
/*---------------------------------------------------------------------------
  1.  Breast-cancer cohort in Mitelman
---------------------------------------------------------------------------*/
mitelman_cases AS (
  SELECT DISTINCT RefNo , CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = morph
    AND  Topo  = topo
),

cohort_size AS (
  SELECT COUNT(DISTINCT CONCAT(RefNo,'-',CaseNo)) AS n_mitelman
  FROM   mitelman_cases
),

/* Copy-number events mapped to cytobands (via CytoBands_hg38) */
mitelman_events AS (
  SELECT
      cc.RefNo,
      cc.CaseNo,
      cc.Type,                                   -- Amp | Gain | Loss | Del
      REGEXP_REPLACE(cb.chromosome , r'^chr','') AS chromosome,
      cb.cytoband_name                           AS cytoband
  FROM `mitelman-db.prod.CytoConverted`  AS cc
  JOIN mitelman_cases                     AS mc
    ON cc.RefNo  = mc.RefNo
   AND cc.CaseNo = mc.CaseNo
  JOIN `mitelman-db.prod.CytoBands_hg38`  AS cb
    ON cb.chromosome = cc.Chr
   AND cc.Start < cb.hg38_stop              -- interval overlap
   AND cc.End   > cb.hg38_start
  WHERE cc.Type IN ('Amp','Gain','Loss','Del')
),

mitelman_freq AS (                          -- frequency per cytoband & type
  SELECT
      chromosome,
      cytoband,
      Type,
      COUNT(DISTINCT CONCAT(RefNo,'-',CaseNo))
        / (SELECT n_mitelman FROM cohort_size)   AS freq_mitelman
  FROM mitelman_events
  GROUP BY chromosome, cytoband, Type
),

/*---------------------------------------------------------------------------
  2.  TCGA public GISTIC2 thresholded copy-number calls
---------------------------------------------------------------------------*/
tcga_calls AS (
  /*  Public table: one row per (sample,gene) call  */
  SELECT
      ParticipantBarcode                        AS sample_id,
      CASE
        WHEN Call =  2 THEN 'Amp'
        WHEN Call =  1 THEN 'Gain'
        WHEN Call = -1 THEN 'Loss'
        WHEN Call = -2 THEN 'Del'
      END                                       AS Type,
      Chromosome                                AS chromosome,
      Cytoband                                  AS cytoband
  FROM  `isb-cgc-bq.TCGA_copy_number_data.gistic2_threshold_by_gene`
  WHERE Call IN (-2,-1,1,2)                     -- retain defined calls
    AND Cytoband IS NOT NULL
    AND Chromosome IS NOT NULL
),

tcga_tot AS (                                  -- number of TCGA samples
  SELECT COUNT(DISTINCT sample_id) AS n_tcga FROM tcga_calls
),

tcga_freq AS (                                 -- frequency per cytoband & type
  SELECT
      chromosome,
      cytoband,
      Type,
      COUNT(DISTINCT sample_id)
        / (SELECT n_tcga FROM tcga_tot)        AS freq_tcga
  FROM tcga_calls
  GROUP BY chromosome, cytoband, Type
),

/*---------------------------------------------------------------------------
  3.  Join frequencies, compute chromosome-level correlations
---------------------------------------------------------------------------*/
joined AS (
  SELECT
      m.chromosome,
      m.cytoband,
      m.Type                 AS aberration_type,
      m.freq_mitelman,
      t.freq_tcga
  FROM  mitelman_freq AS m
  JOIN  tcga_freq     AS t
    ON  m.chromosome = t.chromosome
   AND  m.cytoband   = t.cytoband
   AND  m.Type       = t.Type
),

per_chr_type AS (                             -- correlation & point count
  SELECT
      chromosome,
      aberration_type,
      CORR(freq_mitelman , freq_tcga) AS pearson_r,
      COUNT(*)                        AS n_points
  FROM   joined
  GROUP  BY chromosome, aberration_type
),

results AS (
  SELECT
      chromosome,
      aberration_type,
      pearson_r,
      `isb-cgc-bq.functions.corr_pvalue_current`(pearson_r, n_points)
        AS p_value,
      n_points
  FROM per_chr_type
)

SELECT
    chromosome        AS Chromosome,
    aberration_type   AS AberrationType,
    ROUND(pearson_r,4) AS PearsonR,
    ROUND(p_value ,4)  AS PValue
FROM results
WHERE n_points >= 5                      -- ensure ≥ 5 matched cytobands
ORDER BY Chromosome , AberrationType;
