Query:
--Description: 06) Compute per-chromosome absolute and relative frequency of LOSS/Deletion events
WITH cohort AS (
  SELECT DISTINCT RefNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111' AND Topo = '0401'
),
loss_events AS (
  SELECT Chr, COUNT(*) AS loss_cnt
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  Type IN ('Loss','Del')
    AND  RefNo IN (SELECT RefNo FROM cohort)
  GROUP  BY Chr
),
total_ev AS (
  SELECT COUNT(*) AS all_cnt
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  RefNo IN (SELECT RefNo FROM cohort)
)
SELECT l.Chr,
       l.loss_cnt,
       ROUND(l.loss_cnt / t.all_cnt, 4) AS loss_freq
FROM   loss_events l
CROSS JOIN total_ev t
ORDER  BY l.Chr
LIMIT  20;
