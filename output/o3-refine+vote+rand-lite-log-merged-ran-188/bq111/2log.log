gain_vs_loss_corr
-0.15309728167029524
Query:
--Description: 10) Example join to compare two Mitelman-derived gain datasets (case-level vs. RecurrentNumData) – 
--              this illustrates the structure you’d later reuse to add an external TCGA table
WITH cohort AS (
  SELECT DISTINCT RefNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111' AND Topo = '0401'
),
case_level AS (                         -- CytoConverted gains
  SELECT REGEXP_REPLACE(Chr, r'^chr','') AS Chromosome,
         COUNT(*)                        AS case_gain_cnt
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  Type IN ('Gain','Amp')
    AND  RefNo IN (SELECT RefNo FROM cohort)
  GROUP  BY Chromosome
),
recurrent AS (                          -- RecurrentNumData gains
  SELECT Chromosome,
         SUM(CAST(TotalCases AS INT64)) AS recur_gain_cnt
  FROM   `mitelman-db.prod.RecurrentNumData`
  WHERE  Morph = '3111' AND Topo = '0401'
    AND  STARTS_WITH(Abnormality,'+')
  GROUP  BY Chromosome
),
joined AS (
  SELECT c.Chromosome,
         c.case_gain_cnt,
         r.recur_gain_cnt
  FROM   case_level c
  JOIN   recurrent  r USING (Chromosome)
)
SELECT *
FROM   joined
WHERE  joined.case_gain_cnt IS NOT NULL
LIMIT  20;
Answer:
