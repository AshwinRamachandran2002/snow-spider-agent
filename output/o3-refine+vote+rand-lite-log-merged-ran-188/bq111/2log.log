Query:
--Description: 05) Compute per-chromosome absolute and relative frequency of GAIN/Amp events
WITH cohort AS (
  SELECT DISTINCT RefNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111' AND Topo = '0401'
),
gain_events AS (
  SELECT Chr, COUNT(*) AS gain_cnt
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  Type IN ('Gain','Amp')
    AND  RefNo IN (SELECT RefNo FROM cohort)
  GROUP  BY Chr
),
total_ev AS (
  SELECT COUNT(*) AS all_cnt
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  RefNo IN (SELECT RefNo FROM cohort)
)
SELECT g.Chr,
       g.gain_cnt,
       ROUND(g.gain_cnt / t.all_cnt, 4) AS gain_freq
FROM   gain_events g
CROSS JOIN total_ev t
ORDER  BY g.Chr
LIMIT  20;
