```sql
--  Pearson correlations (and p-values) between Mitelman and TCGA copy–number
--  frequencies,   computed per chromosome and per aberration type
--  (Amp, Gain, Loss, Del) for the breast-cancer cohort
--      Morphology = 3111   |   Topography = 0401
--
--  Only chromosome / aberration-type pairs having at least five matching
--  cytobands in BOTH data sets are returned.

DECLARE morph STRING DEFAULT '3111';    -- ductal / lobular carcinoma of breast
DECLARE topo  STRING DEFAULT '0401';

--------------------------------------------------------------------------------
-- 1) BREAST-CANCER COHORT (Mitelman)
--------------------------------------------------------------------------------
WITH mitelman_cases AS (                          -- cohort definition
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = morph AND Topo = topo
),

cohort_size AS (                                 -- number of Mitelman cases
  SELECT COUNT(DISTINCT CONCAT(RefNo,'-',CaseNo)) AS n_mitelman
  FROM   mitelman_cases
),

mitelman_events AS (                             -- copy-number events
  SELECT  cc.RefNo,
          cc.CaseNo,
          cc.Type,                               -- Amp | Gain | Loss | Del
          cb.cytoband_name              AS cytoband,
          REGEXP_REPLACE(cb.chromosome,r'^chr','') AS chromosome
  FROM   `mitelman-db.prod.CytoConverted`  cc
  JOIN   mitelman_cases                   mc
         ON  cc.RefNo  = mc.RefNo
         AND cc.CaseNo = mc.CaseNo
  JOIN   `mitelman-db.prod.CytoBands_hg38` cb
         ON  cb.chromosome = cc.Chr
         AND cc.Start < cb.hg38_stop      -- interval overlap
         AND cc.End   > cb.hg38_start
  WHERE  cc.Type IN ('Amp','Gain','Loss','Del')
),

mitelman_freq AS (                              -- frequency per cytoband
  SELECT  chromosome,
          cytoband,
          Type,
          COUNT(DISTINCT CONCAT(RefNo,'-',CaseNo)) /
          (SELECT n_mitelman FROM cohort_size)   AS freq_mitelman
  FROM    mitelman_events
  GROUP BY chromosome, cytoband, Type
),

--------------------------------------------------------------------------------
-- 2) TCGA COPY-NUMBER DATA (GISTIC thresholded calls, hg38 coordinates)
--------------------------------------------------------------------------------
tcga_calls AS (  --  +2 = Amp | +1 = Gain | -1 = Loss | -2 = Del
  SELECT  ParticipantBarcode            AS sample_id,
          CASE
            WHEN Call =  2 THEN 'Amp'
            WHEN Call =  1 THEN 'Gain'
            WHEN Call = -1 THEN 'Loss'
            WHEN Call = -2 THEN 'Del'
          END                          AS Type,
          Chromosome                   AS chromosome,
          StartPosition                AS start_bp,
          EndPosition                  AS end_bp
  FROM    `isb-cgc.TCGA_copy_number_data.gistic2_threshold_by_gene`
  WHERE   Call IN (-2,-1,1,2)          -- keep only defined CNA calls
),

tcga_tot AS (                             -- number of TCGA samples
  SELECT COUNT(DISTINCT sample_id) AS n_tcga
  FROM   tcga_calls
),

tcga_overlap AS (                         -- map calls to cytobands
  SELECT DISTINCT
         sample_id,
         Type,
         REGEXP_REPLACE(cb.chromosome,r'^chr','') AS chromosome,
         cb.cytoband_name                         AS cytoband
  FROM   tcga_calls  t
  JOIN   `mitelman-db.prod.CytoBands_hg38` cb
         ON  cb.chromosome = CONCAT('chr',t.chromosome)
         AND t.start_bp < cb.hg38_stop
         AND t.end_bp   > cb.hg38_start
),

tcga_freq AS (                            -- frequency per cytoband
  SELECT  chromosome,
          cytoband,
          Type,
          COUNT(DISTINCT sample_id) /
          (SELECT n_tcga FROM tcga_tot) AS freq_tcga
  FROM    tcga_overlap
  GROUP BY chromosome, cytoband, Type
),

--------------------------------------------------------------------------------
-- 3) JOIN & CORRELATION
--------------------------------------------------------------------------------
joined AS (
  SELECT  m.chromosome,
          m.cytoband,
          m.Type                                AS aberration_type,
          m.freq_mitelman,
          t.freq_tcga
  FROM    mitelman_freq  m
  JOIN    tcga_freq      t
         USING (chromosome, cytoband, Type)
),

per_chr_type AS (                          -- correlation, #points
  SELECT  chromosome,
          aberration_type,
          CORR(freq_mitelman , freq_tcga)         AS pearson_r,
          COUNT(*)                                AS n_points
  FROM    joined
  GROUP BY chromosome, aberration_type
),

results AS (
  SELECT  chromosome,
          aberration_type,
          pearson_r,
          `isb-cgc-bq.functions.corr_pvalue_current`(pearson_r, n_points)
            AS p_value,
          n_points
  FROM    per_chr_type
)

-- ---------------------------------------------------------------------------
SELECT  chromosome               AS Chromosome,
        aberration_type          AS AberrationType,
        ROUND(pearson_r, 4)      AS PearsonR,
        ROUND(p_value , 4)       AS PValue
FROM    results
WHERE   n_points >= 5            -- demand at least 5 matched cytobands
ORDER BY Chromosome, AberrationType;
```
