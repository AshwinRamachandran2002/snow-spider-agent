```sql
WITH ordered AS (
    SELECT
        geolocation_state,
        geolocation_city,
        geolocation_zip_code_prefix,
        geolocation_lat,
        geolocation_lng,
        LAG(geolocation_state)  OVER w AS prev_state,
        LAG(geolocation_city)   OVER w AS prev_city,
        LAG(geolocation_lat)    OVER w AS prev_lat,
        LAG(geolocation_lng)    OVER w AS prev_lng
    FROM olist_geolocation
    WINDOW w AS (
        ORDER BY
            geolocation_state,
            geolocation_city,
            geolocation_zip_code_prefix,
            geolocation_lat,
            geolocation_lng
    )
),
distances AS (
    SELECT
        *,
        /* Euclidean distance in degrees between consecutive points */
        SQRT(
            (geolocation_lat - prev_lat) * (geolocation_lat - prev_lat) +
            (geolocation_lng - prev_lng) * (geolocation_lng - prev_lng)
        ) AS distance
    FROM ordered
    WHERE prev_lat IS NOT NULL   -- skip the very first row
),
max_dist AS (
    SELECT MAX(distance) AS max_distance
    FROM distances
)
SELECT
    prev_state  AS from_state,
    prev_city   AS from_city,
    geolocation_state AS to_state,
    geolocation_city  AS to_city,
    distance
FROM distances
JOIN max_dist ON distance = max_distance;
```
