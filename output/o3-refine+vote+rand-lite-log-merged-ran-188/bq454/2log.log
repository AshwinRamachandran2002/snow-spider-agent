```sql
-- 1) List each super–population and how many samples it contains (population size).
SELECT
  `Super_Population`          AS super_pop,
  COUNT(*)                    AS pop_size
FROM
  `spider2-public-data.1000_genomes.sample_info`
GROUP BY
  super_pop
ORDER BY
  pop_size DESC
LIMIT 20;
```

```sql
-- 2) See the distinct chromosome names present in the variants table.
SELECT DISTINCT
  `reference_name`
FROM
  `spider2-public-data.1000_genomes.variants`
ORDER BY
  reference_name
LIMIT 20;
```

```sql
-- 3) Preview autosomal variants whose global allele-frequency (AF) ≥ 0.05.
SELECT
  `reference_name`, `start`, `AF`
FROM
  `spider2-public-data.1000_genomes.variants`
WHERE
      `reference_name` NOT IN ('X','Y','MT')
  AND `AF` >= 0.05
LIMIT 20;
```

```sql
-- 4) For one variant, show the first 20 carriers that actually have ≥1 alternate allele.
SELECT
  v.reference_name, v.start,
  c.call_set_name  AS sample,
  c.genotype
FROM
  `spider2-public-data.1000_genomes.variants` AS v
CROSS JOIN
  UNNEST(v.call)        AS c
WHERE
      v.reference_name NOT IN ('X','Y','MT')
  AND v.AF >= 0.05
  AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g > 0)   -- at least one alt allele
LIMIT 20;
```

```sql
-- 5) Join carriers (from #4) to sample_info to see their super-populations.
SELECT
  c.call_set_name    AS sample,
  s.Super_Population AS super_pop,
  c.genotype
FROM
  `spider2-public-data.1000_genomes.variants` AS v
CROSS JOIN
  UNNEST(v.call)        AS c
JOIN
  `spider2-public-data.1000_genomes.sample_info` AS s
ON
  s.Sample = c.call_set_name
WHERE
      v.reference_name NOT IN ('X','Y','MT')
  AND v.AF >= 0.05
  AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g > 0)
LIMIT 20;
```

```sql
-- 6) Count, for a handful of variants, how many carriers each has inside AFR
--    (super-population chosen just for illustration).
SELECT
  v.reference_name, v.start,
  COUNT(DISTINCT s.Sample) AS afr_carriers
FROM
  `spider2-public-data.1000_genomes.variants`      AS v
CROSS JOIN
  UNNEST(v.call)                                   AS c
JOIN
  `spider2-public-data.1000_genomes.sample_info`   AS s
ON
  s.Sample = c.call_set_name
WHERE
      v.reference_name NOT IN ('X','Y','MT')
  AND v.AF >= 0.05
  AND s.Super_Population = 'AFR'
  AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g > 0)
GROUP BY
  v.reference_name, v.start
LIMIT 20;
```

```sql
-- 7) For AFR, bucket the previous counts: how many variants are carried by
--    exactly N AFR samples (first 20 distinct N values shown).
WITH afr_variant_carriers AS (
  SELECT
    v.reference_name, v.start,
    COUNT(DISTINCT s.Sample) AS carriers
  FROM
    `spider2-public-data.1000_genomes.variants`    AS v
  CROSS JOIN UNNEST(v.call)                        AS c
  JOIN  `spider2-public-data.1000_genomes.sample_info` AS s
  ON    s.Sample = c.call_set_name
  WHERE
        v.reference_name NOT IN ('X','Y','MT')
    AND v.AF >= 0.05
    AND s.Super_Population = 'AFR'
    AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g > 0)
  GROUP BY v.reference_name, v.start
)
SELECT
  carriers        AS num_afr_samples,
  COUNT(*)        AS variant_count
FROM
  afr_variant_carriers
GROUP BY
  num_afr_samples
ORDER BY
  num_afr_samples
LIMIT 20;
```

```sql
-- 8) Same idea as #7 but now for EUR, demonstrating another super-population.
WITH eur_variant_carriers AS (
  SELECT
    v.reference_name, v.start,
    COUNT(DISTINCT s.Sample) AS carriers
  FROM
    `spider2-public-data.1000_genomes.variants`    AS v
  CROSS JOIN UNNEST(v.call)                        AS c
  JOIN  `spider2-public-data.1000_genomes.sample_info` AS s
  ON    s.Sample = c.call_set_name
  WHERE
        v.reference_name NOT IN ('X','Y','MT')
    AND v.AF >= 0.05
    AND s.Super_Population = 'EUR'
    AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g > 0)
  GROUP BY v.reference_name, v.start
)
SELECT
  carriers        AS num_eur_samples,
  COUNT(*)        AS variant_count
FROM
  eur_variant_carriers
GROUP BY
  num_eur_samples
ORDER BY
  num_eur_samples
LIMIT 20;
```

```sql
-- 9) Prepare a helper table giving the size of each super-population.
SELECT
  Super_Population AS super_pop,
  COUNT(*)         AS pop_size
FROM
  `spider2-public-data.1000_genomes.sample_info`
GROUP BY
  super_pop
LIMIT 20;
```

```sql
-- 10) FINAL: For every super-population, report (a) its size, (b) that the
--     variant satisfied AF ≥ 0.05 (common), (c) how many samples share it,
--     and (d) how many distinct variants fall into that bucket.
WITH pop_size AS (                       -- total samples per super-population
  SELECT
    Super_Population AS super_pop,
    COUNT(*)         AS pop_size
  FROM
    `spider2-public-data.1000_genomes.sample_info`
  GROUP BY super_pop
),
variant_carriers AS (                   -- carriers of common autosomal variants
  SELECT
    v.reference_name,
    v.start,
    s.Super_Population AS super_pop,
    COUNT(DISTINCT s.Sample) AS carriers         -- samples w/ ≥1 alt allele
  FROM
    `spider2-public-data.1000_genomes.variants`   AS v
  CROSS JOIN UNNEST(v.call)                       AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
  ON   s.Sample = c.call_set_name
  WHERE
        v.reference_name NOT IN ('X','Y','MT')    -- autosomes only
    AND v.AF >= 0.05                              -- common variants
    AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g > 0)
  GROUP BY
    v.reference_name, v.start, super_pop
),
summary AS (                        -- bucket by #carriers inside each super-pop
  SELECT
    super_pop,
    carriers            AS num_samples,
    COUNT(*)            AS variant_count
  FROM
    variant_carriers
  GROUP BY
    super_pop, num_samples
)
SELECT
  s.super_pop,
  p.pop_size,                       -- total samples in that population
  TRUE  AS is_common,               -- AF ≥ 0.05 by construction
  s.num_samples     AS samples_with_variant,
  s.variant_count   AS variants_shared_by_that_many_samples
FROM
  summary AS s
JOIN
  pop_size AS p
USING (super_pop)
ORDER BY
  super_pop, samples_with_variant
LIMIT 20;
```

