Below is a sequence of ≤10 exploratory-to-analytic BigQuery SQL statements (each limited to 20 rows) that progressively show how to answer  
“for each super population, among autosomal variants keep only the common ones (allele-frequency ≥ 0.05 inside that super-population) and count how many variants are shared by a given number of samples that carry ≥1 alternate allele”.

```sql
-- 1.  What super–populations are present and how many samples belong to each one?
SELECT
  `Super_Population`,
  COUNT(*) AS n_samples
FROM `spider2-public-data.1000_genomes.sample_info`
GROUP BY 1
ORDER BY 2 DESC;
```

```sql
-- 2.  Verify the distinct autosomal chromosomes in the variants table (exclude X, Y, MT).
SELECT DISTINCT `reference_name`
FROM `spider2-public-data.1000_genomes.variants`
WHERE `reference_name` NOT IN ('X','Y','MT')
ORDER BY CAST(`reference_name` AS INT64)
LIMIT 20;
```

```sql
-- 3.  Peek at one variant record on an autosome together with its embedded calls.
SELECT
  `reference_name`, `start`, `alternate_bases`, `call`
FROM `spider2-public-data.1000_genomes.variants`
WHERE `reference_name`='1'
LIMIT 1;
```

```sql
-- 4.  For a single variant, unnest the calls and see which samples carry any ALT allele.
SELECT
  v.reference_name, v.start,
  c.call_set_name AS sample,
  c.genotype,
  EXISTS (SELECT val FROM UNNEST(c.genotype) val WHERE val>0) AS has_alt
FROM `spider2-public-data.1000_genomes.variants` v
CROSS JOIN UNNEST(v.call) c
WHERE v.reference_name='1'
LIMIT 20;
```

```sql
-- 5.  Join calls with sample_info to bring in super–population information,
--     keeping only samples that carry ≥1 ALT allele (still one variant).
SELECT
  v.reference_name, v.start,
  s.Super_Population,
  COUNTIF(EXISTS (SELECT val FROM UNNEST(c.genotype) val WHERE val>0)) AS alt_carriers
FROM `spider2-public-data.1000_genomes.variants` v
CROSS JOIN UNNEST(v.call) c
JOIN `spider2-public-data.1000_genomes.sample_info` s
     ON s.Sample = c.call_set_name
WHERE v.reference_name='1'
GROUP BY 1,2,3
LIMIT 20;
```

```sql
-- 6.  Compute, for a *small slice* of variants, the allele-frequency inside each super-population.
WITH autosomal AS (
  SELECT *
  FROM `spider2-public-data.1000_genomes.variants`
  WHERE reference_name NOT IN ('X','Y','MT')
  LIMIT 200        -- safety slice; remove or raise later for full run
),
calls AS (
  SELECT
    reference_name, start,
    c.call_set_name AS sample,
    EXISTS (SELECT val FROM UNNEST(c.genotype) val WHERE val>0) AS has_alt
  FROM autosomal CROSS JOIN UNNEST(call) c
),
joined AS (
  SELECT
    reference_name, start, s.Super_Population, has_alt
  FROM calls
  JOIN `spider2-public-data.1000_genomes.sample_info` s
       ON s.Sample = calls.sample
)
SELECT
  reference_name, start, Super_Population,
  SUM(IF(has_alt,1,0)) AS n_alt_samples,
  COUNT(*)            AS n_total_samples,
  SAFE_DIVIDE(SUM(IF(has_alt,1,0)), COUNT(*)) AS alt_freq
FROM joined
GROUP BY 1,2,3
HAVING alt_freq >= 0.05
LIMIT 20;
```

```sql
-- 7.  For the same slice, bucket the “number of samples that share the variant”
--     (only common ones, AF>=0.05) inside each super-population.
WITH autosomal AS (
  SELECT * FROM `spider2-public-data.1000_genomes.variants`
  WHERE reference_name NOT IN ('X','Y','MT')
  LIMIT 200
),
calls AS (
  SELECT
    reference_name, start,
    c.call_set_name AS sample,
    EXISTS (SELECT val FROM UNNEST(c.genotype) val WHERE val>0) AS has_alt
  FROM autosomal CROSS JOIN UNNEST(call) c
),
j AS (
  SELECT
    reference_name, start, s.Super_Population, has_alt
  FROM calls
  JOIN `spider2-public-data.1000_genomes.sample_info` s
       ON s.Sample = calls.sample
),
agg AS (
  SELECT
    reference_name, start, Super_Population,
    SUM(IF(has_alt,1,0)) AS n_alt_samples,
    COUNT(*) AS n_total_samples
  FROM j
  GROUP BY 1,2,3
  HAVING SAFE_DIVIDE(SUM(IF(has_alt,1,0)), COUNT(*)) >= 0.05   -- common
)
SELECT
  Super_Population,
  n_alt_samples,
  COUNT(*) AS n_variants_shared_by_that_many_samples
FROM agg
GROUP BY 1,2
ORDER BY 1,2
LIMIT 20;
```

```sql
-- 8.  Add the total population size in the output (one super-population shown).
WITH pop_size AS (
  SELECT Super_Population, COUNT(*) AS pop_n
  FROM `spider2-public-data.1000_genomes.sample_info`
  GROUP BY 1
),
common_variants AS (
  -- identical logic as above, whole table abbreviated for demo
  SELECT 'AFR' AS Super_Population, 42 AS n_alt_samples, 123 AS n_variants  -- ← placeholder
)
SELECT
  c.Super_Population,
  p.pop_n AS population_size,
  c.n_alt_samples,
  c.n_variants
FROM common_variants c
JOIN pop_size p USING (Super_Population)
LIMIT 20;
```

```sql
-- 9.  FINAL full query (remove LIMIT to run entire data set) that produces:
--     super-population, its sample size, whether variant is common (always TRUE here),
--     number_of_alt_samples, and how many variants have that count.
WITH pop_size AS (
  SELECT Super_Population, COUNT(*) AS pop_n
  FROM `spider2-public-data.1000_genomes.sample_info`
  GROUP BY 1
),
calls AS (
  SELECT
    v.reference_name, v.start,
    c.call_set_name AS sample,
    EXISTS (SELECT val FROM UNNEST(c.genotype) val WHERE val>0) AS has_alt
  FROM `spider2-public-data.1000_genomes.variants` v
  CROSS JOIN UNNEST(v.call) c
  WHERE v.reference_name NOT IN ('X','Y','MT')          -- autosomes only
),
joined AS (
  SELECT
    reference_name, start, s.Super_Population, has_alt
  FROM calls
  JOIN `spider2-public-data.1000_genomes.sample_info` s
       ON s.Sample = calls.sample
),
per_var_pop AS (
  SELECT
    reference_name, start, Super_Population,
    SUM(IF(has_alt,1,0)) AS n_alt_samples,
    COUNT(*)             AS n_total_samples
  FROM joined
  GROUP BY 1,2,3
  HAVING SAFE_DIVIDE(SUM(IF(has_alt,1,0)), COUNT(*)) >= 0.05   -- common variants only
)
SELECT
  p.Super_Population,
  ps.pop_n                                       AS population_size,
  TRUE                                           AS is_common_variant,  -- by construction
  p.n_alt_samples                                AS samples_with_alt,
  COUNT(*) AS n_variants_shared_by_that_many_samples
FROM per_var_pop p
JOIN pop_size ps USING (Super_Population)
GROUP BY 1,2,3,4
ORDER BY Super_Population, samples_with_alt
LIMIT 20;
```

```sql
-- 10.  (Optional check) Show a few rows from the final result for visual inspection.
SELECT * FROM (
  /* paste the final query above here */ )
LIMIT 20;
```

Each successive query builds understanding:

1. discover population sizes  
2. verify autosomes  
3-4. inspect variant / calls structure  
5. join to super-populations  
6. compute allele frequency per variant-pop pair  
7. count common variants by “# samples with ALT” bucket  
8. attach population size  
9-10. produce the requested summary result set.

All queries select data only, never touch schema metadata, and are trimmed to ≤20 rows for safety.
