```sql
--Description: 1) How many samples belong to each super–population?
SELECT `Super_Population`,
       COUNT(*) AS super_pop_size
FROM   `spider2-public-data.1000_genomes.sample_info`
GROUP  BY `Super_Population`
ORDER  BY super_pop_size DESC
LIMIT  20;
```

```sql
--Description: 2) Look at a few autosomal variant records (exclude X, Y, MT).
SELECT  `reference_name`, `start`, `AF`, `AC`, `AN`
FROM    `spider2-public-data.1000_genomes.variants`
WHERE   `reference_name` NOT IN ('X','Y','MT')
LIMIT   20;
```

```sql
--Description: 3) Inspect the structure of a single variant’s calls after expanding the nested array.
SELECT  v.`reference_name`,
        v.`start`,
        c.`call_set_name`,
        c.`genotype`
FROM    `spider2-public-data.1000_genomes.variants` AS v,
        UNNEST(v.`call`) AS c
WHERE   v.`reference_name` NOT IN ('X','Y','MT')
LIMIT   20;
```

```sql
--Description: 4) Identify samples that actually carry an alternate allele 
--               (any non-reference genotype value > 0) for a few variants.
SELECT  v.`reference_name`,
        v.`start`,
        c.`call_set_name`,
        c.`genotype`
FROM    `spider2-public-data.1000_genomes.variants` AS v,
        UNNEST(v.`call`) AS c
WHERE   v.`reference_name` NOT IN ('X','Y','MT')
  AND   EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x > 0)
LIMIT   20;
```

```sql
--Description: 5) Join those carrier samples to the sample_info table to get their super–population.
SELECT  c.`call_set_name`               AS sample,
        si.`Super_Population`           AS super_pop,
        v.`reference_name`,
        v.`start`
FROM    `spider2-public-data.1000_genomes.variants`  AS v,
        UNNEST(v.`call`) AS c
JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
        ON  si.`Sample` = c.`call_set_name`
WHERE   v.`reference_name` NOT IN ('X','Y','MT')
  AND   EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x > 0)
LIMIT   20;
```

```sql
--Description: 6) For a small slice, count how many carriers each variant has inside each super–population.
SELECT  v.`reference_name`,
        v.`start`,
        si.`Super_Population`,
        COUNT(*) AS carriers_in_super_pop
FROM    `spider2-public-data.1000_genomes.variants` AS v,
        UNNEST(v.`call`) AS c
JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
        ON si.`Sample` = c.`call_set_name`
WHERE   v.`reference_name` NOT IN ('X','Y','MT')
  AND   EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x > 0)
GROUP   BY v.`reference_name`, v.`start`, si.`Super_Population`
LIMIT   20;
```

```sql
--Description: 7) Filter to “common” autosomal variants (global AF ≥ 0.05).
SELECT  `reference_name`,
        `start`,
        `AF` AS global_AF
FROM    `spider2-public-data.1000_genomes.variants`
WHERE   `reference_name` NOT IN ('X','Y','MT')
  AND   `AF` >= 0.05
LIMIT   20;
```

```sql
--Description: 8) For common autosomal variants, count carriers per variant per super–population.
SELECT  v.`reference_name`,
        v.`start`,
        si.`Super_Population`,
        COUNT(*) AS carriers_cnt
FROM    `spider2-public-data.1000_genomes.variants` AS v
JOIN    UNNEST(v.`call`) AS c
JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
      ON si.`Sample` = c.`call_set_name`
WHERE   v.`reference_name` NOT IN ('X','Y','MT')
  AND   v.`AF` >= 0.05
  AND   EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x > 0)
GROUP   BY v.`reference_name`, v.`start`, si.`Super_Population`
LIMIT   20;
```

```sql
--Description: 9) For each super-population and each “carriers_cnt”, count how many variants have exactly that many carriers.
WITH common_variant_carriers AS (
  SELECT  CONCAT(v.`reference_name`, ':', v.`start`)       AS variant_id,
          si.`Super_Population`                            AS super_pop,
          COUNT(*)                                         AS carriers_cnt
  FROM    `spider2-public-data.1000_genomes.variants` AS v
  JOIN    UNNEST(v.`call`) AS c
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
         ON si.`Sample` = c.`call_set_name`
  WHERE   v.`reference_name` NOT IN ('X','Y','MT')
    AND   v.`AF` >= 0.05
    AND   EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x > 0)
  GROUP   BY variant_id, super_pop
)
SELECT  super_pop,
        carriers_cnt,
        COUNT(*) AS variants_with_this_cnt
FROM    common_variant_carriers
GROUP   BY super_pop, carriers_cnt
ORDER   BY super_pop, carriers_cnt
LIMIT   20;
```

```sql
--Description: 10) Final summary: include super-population size, the “is_common” flag (always TRUE here), 
--                the #carriers, and how many common autosomal variants are shared by that # of carriers.
WITH
super_pop_sizes AS (
  SELECT `Super_Population` AS super_pop,
         COUNT(*)           AS pop_size
  FROM   `spider2-public-data.1000_genomes.sample_info`
  GROUP  BY super_pop
),
common_variant_carriers AS (
  SELECT  CONCAT(v.`reference_name`, ':', v.`start`) AS variant_id,
          si.`Super_Population`                      AS super_pop,
          COUNT(*)                                   AS carriers_cnt
  FROM    `spider2-public-data.1000_genomes.variants` AS v
  JOIN    UNNEST(v.`call`) AS c
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
        ON si.`Sample` = c.`call_set_name`
  WHERE   v.`reference_name` NOT IN ('X','Y','MT')
    AND   v.`AF` >= 0.05                          -- common variant definition
    AND   EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x > 0)
  GROUP   BY variant_id, super_pop
)
SELECT  cvc.super_pop,
        sps.pop_size,
        TRUE        AS is_common,           -- AF ≥ 0.05
        cvc.carriers_cnt,
        COUNT(*)    AS variants_shared_by_that_many
FROM    common_variant_carriers AS cvc
JOIN    super_pop_sizes        AS sps
  ON    sps.super_pop = cvc.super_pop
GROUP   BY cvc.super_pop, sps.pop_size, is_common, cvc.carriers_cnt
ORDER   BY cvc.super_pop, cvc.carriers_cnt
LIMIT   20;
```
