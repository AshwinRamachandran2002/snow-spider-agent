```sql
--Description: Preview a few autosomal‐chromosome variant rows from the publicly-readable
--             1000 Genomes variant table in BigQuery.
-- Thinking process
--  • The table that is open to everyone lives in dataset
--      `bigquery-public-data.human_genome_variants`, table `1000_genomes_variants`.
--  • It stores INFO fields (AF, AC, AN, etc.) inside the RECORD column `info`.
--  • AF and AC are arrays; selecting the first value with SAFE_OFFSET(0) gives a
--    scalar preview without errors.
--  • We exclude sex-chromosome (X, Y) and mitochondrial (MT) records to focus on
--    autosomes.
--  • LIMIT 20 keeps the output small while confirming the data look correct.
SELECT
  reference_name,
  start_position AS start,
  info.AF[SAFE_OFFSET(0)] AS AF,
  info.AC[SAFE_OFFSET(0)] AS AC,
  info.AN                 AS AN
FROM
  `bigquery-public-data.human_genome_variants.1000_genomes_variants`
WHERE
  reference_name NOT IN ('X','Y','MT')
LIMIT
  20;
```
