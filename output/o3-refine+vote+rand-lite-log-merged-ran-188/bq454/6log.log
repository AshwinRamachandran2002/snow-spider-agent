Below are up-to-ten exploratory BigQuery statements that go step-by-step from very simple inspection of the tables to the complete aggregation asked for in the task.  
All queries only touch the three tables that belong to the 1000 Genomes dataset and all of them finish with `LIMIT 20`.

```sql
-- 1. Description: how many samples belong to every super-population
SELECT
  Super_Population,
  COUNT(*) AS pop_size
FROM `spider2-public-data.1000_genomes.sample_info`
GROUP BY Super_Population
LIMIT 20;
```

```sql
-- 2. Description: see the distinct chromosome (reference_name) values that exist
SELECT DISTINCT reference_name
FROM `spider2-public-data.1000_genomes.variants`
LIMIT 20;
```

```sql
-- 3. Description: preview a handful of autosomal variants (chromosome ‘1’) only
SELECT
  reference_name,
  start,
  alternate_bases,
  AA,
  AC1,
  AF1
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name = '1'
LIMIT 20;
```

```sql
-- 4. Description: explode one variant’s calls, join to sample_info and
--     calculate how many non-reference alleles each sample carries
SELECT
  v.reference_name,
  v.start,
  c.call_set_name AS sample,
  s.Super_Population,
  ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0)) AS alt_allele_count
FROM `spider2-public-data.1000_genomes.variants` AS v
CROSS JOIN UNNEST(v.call) AS c
JOIN `spider2-public-data.1000_genomes.sample_info` AS s
  ON s.Sample = c.call_set_name
WHERE v.reference_name = '1'
LIMIT 20;
```

```sql
-- 5. Description: per-variant / per-super-population counts of
--     samples with any alternate allele and estimated allele frequency (AF)
SELECT
  CONCAT(v.reference_name,'-',v.start) AS variant_id,
  s.Super_Population,
  COUNTIF(ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0))>0) AS samples_with_alt,
  SUM(ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0))) AS alt_alleles,
  COUNT(*)*2 AS total_alleles,
  SUM(ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0)))/(COUNT(*)*2.0) AS allele_freq
FROM `spider2-public-data.1000_genomes.variants` AS v
CROSS JOIN UNNEST(v.call) AS c
JOIN `spider2-public-data.1000_genomes.sample_info` AS s
  ON s.Sample = c.call_set_name
WHERE v.reference_name NOT IN ('X','Y','MT')  -- autosomes only
GROUP BY variant_id, s.Super_Population
LIMIT 20;
```

```sql
-- 6. Description: restrict to COMMON autosomal variants inside every
--     super-population (AF ≥ 0.05) and keep the number of samples that carry them
WITH per_var AS (
  SELECT
    CONCAT(v.reference_name,'-',v.start) AS variant_id,
    s.Super_Population,
    COUNTIF(ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0))>0) AS samples_with_alt,
    SUM(ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0)))/(COUNT(*)*2.0) AS allele_freq
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = c.call_set_name
  WHERE v.reference_name NOT IN ('X','Y','MT')
  GROUP BY variant_id, s.Super_Population
)
SELECT *
FROM per_var
WHERE allele_freq >= 0.05
LIMIT 20;
```

```sql
-- 7. Description: for each super-population, bucket common variants by the
--     exact number of samples that share them
WITH common_variants AS (
  /* re-use query (6) */
  SELECT
    variant_id,
    Super_Population,
    samples_with_alt
  FROM (
    SELECT
      CONCAT(v.reference_name,'-',v.start) AS variant_id,
      s.Super_Population,
      COUNTIF(ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0))>0) AS samples_with_alt,
      SUM(ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0)))/(COUNT(*)*2.0) AS allele_freq
    FROM `spider2-public-data.1000_genomes.variants` AS v
    CROSS JOIN UNNEST(v.call) AS c
    JOIN `spider2-public-data.1000_genomes.sample_info` AS s
      ON s.Sample = c.call_set_name
    WHERE v.reference_name NOT IN ('X','Y','MT')
    GROUP BY variant_id, s.Super_Population
    HAVING allele_freq >= 0.05
  )
)
SELECT
  Super_Population,
  samples_with_alt,
  COUNT(*) AS variant_count
FROM common_variants
GROUP BY Super_Population, samples_with_alt
ORDER BY Super_Population, samples_with_alt
LIMIT 20;
```

```sql
-- 8. Description: bring in population sizes so we can report them together
WITH pop_size AS (
  SELECT Super_Population, COUNT(*) AS pop_size
  FROM `spider2-public-data.1000_genomes.sample_info`
  GROUP BY Super_Population
),
common_variants AS (
  /* same sub-query logic as in (7) */
  SELECT
    CONCAT(v.reference_name,'-',v.start) AS variant_id,
    s.Super_Population,
    COUNTIF(ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0))>0) AS samples_with_alt
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = c.call_set_name
  WHERE v.reference_name NOT IN ('X','Y','MT')
  GROUP BY variant_id, s.Super_Population
  HAVING SUM(ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0)))/(COUNT(*)*2.0) >= 0.05
)
SELECT
  cv.Super_Population,
  ps.pop_size,
  cv.samples_with_alt,
  COUNT(*) AS variant_count
FROM common_variants AS cv
JOIN pop_size AS ps
  ON ps.Super_Population = cv.Super_Population
GROUP BY cv.Super_Population, ps.pop_size, cv.samples_with_alt
ORDER BY cv.Super_Population, cv.samples_with_alt
LIMIT 20;
```

```sql
-- 9. Description: explicitly flag that the variants being summarised are ‘common’
--     (AF ≥ 0.05); the aggregation stays the same
SELECT
  *, TRUE AS is_common_variant
FROM (
  /* wrap query (8) without ORDER BY for brevity */
  WITH pop_size AS (
    SELECT Super_Population, COUNT(*) AS pop_size
    FROM `spider2-public-data.1000_genomes.sample_info`
    GROUP BY Super_Population
  ),
  common_variants AS (
    SELECT
      CONCAT(v.reference_name,'-',v.start) AS variant_id,
      s.Super_Population,
      COUNTIF(ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0))>0) AS samples_with_alt
    FROM `spider2-public-data.1000_genomes.variants` AS v
    CROSS JOIN UNNEST(v.call) AS c
    JOIN `spider2-public-data.1000_genomes.sample_info` AS s
      ON s.Sample = c.call_set_name
    WHERE v.reference_name NOT IN ('X','Y','MT')
    GROUP BY variant_id, s.Super_Population
    HAVING SUM(ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0)))/(COUNT(*)*2.0) >= 0.05
  )
  SELECT
    cv.Super_Population,
    ps.pop_size,
    cv.samples_with_alt,
    COUNT(*) AS variant_count
  FROM common_variants AS cv
  JOIN pop_size AS ps
    ON ps.Super_Population = cv.Super_Population
  GROUP BY cv.Super_Population, ps.pop_size, cv.samples_with_alt
)
LIMIT 20;
```

```sql
-- 10. Description: inspect one super-population (e.g., AFR) in detail –
--      list 20 common autosomal variants and how many AFR samples carry each.
WITH afr AS (
  SELECT
    CONCAT(v.reference_name,'-',v.start) AS variant_id,
    COUNTIF(ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0))>0) AS afr_samples_with_alt,
    SUM(ARRAY_LENGTH(ARRAY(SELECT g FROM UNNEST(c.genotype) g WHERE g>0)))/(COUNT(*)*2.0) AS afr_af
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = c.call_set_name
  WHERE v.reference_name NOT IN ('X','Y','MT')
    AND s.Super_Population = 'AFR'
  GROUP BY variant_id
  HAVING afr_af >= 0.05
)
SELECT *
FROM afr
LIMIT 20;
```

These ten queries progress from basic table understanding toward a complete answer:  
• population size,  
• autosomal filtering,  
• per-variant allele-counting,  
• allele-frequency threshold (≥ 0.05 → common),  
• sample-sharing buckets,  
• final aggregation that reports, for every super-population, the population size, the exact number of samples that share a common autosomal variant, and the total count of such variants.
