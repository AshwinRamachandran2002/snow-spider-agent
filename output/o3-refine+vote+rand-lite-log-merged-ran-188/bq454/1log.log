Query:
--Description:  Summarise common autosomal variants across all super-populations by carrier count
WITH pop_size AS (
  SELECT
    super_population AS super_pop,
    COUNT(*)         AS pop_size
  FROM
    `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`
  WHERE
    super_population IS NOT NULL
  GROUP BY super_pop
), per_variant AS (
  SELECT
    si.super_population                           AS super_pop,
    v.reference_name,
    v.start,
    COUNTIF(EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0)) AS carrier_cnt
  FROM
    `genomics-public-data.1000_genomes.variants` AS v
  CROSS JOIN
    UNNEST(v.call) AS c
  JOIN
    `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS si
  ON  si.sample = c.call_set_name
  WHERE
    v.reference_name NOT IN ('X','Y','MT')
  GROUP BY
    super_pop, v.reference_name, v.start
), with_freq AS (
  SELECT
    pv.*,
