```sql
-- 4. Description:  verify that autosomal chromosomes can be isolated by removing X, Y and MT
SELECT DISTINCT `reference_name`
FROM   `spider2-public-data.1000_genomes.variants`
WHERE  `reference_name` NOT IN ('X','Y','MT')
LIMIT 20;
```

```sql
-- 5. Description:  count, for one super–population (e.g. AFR), how many samples carry ≥1 alt allele per variant
SELECT  v.`reference_name`,
        v.`start`,
        COUNT(DISTINCT si.`Sample`) AS carriers_in_AFR
FROM    `spider2-public-data.1000_genomes.variants` AS v
JOIN    UNNEST(v.`call`) AS c
ON      TRUE
JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
ON      si.`Sample` = c.`call_set_name`
WHERE   v.`reference_name` NOT IN ('X','Y','MT')                          -- autosomes only
  AND   si.`Super_Population` = 'AFR'                                     -- one super–pop
  AND   EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x > 0)      -- carries alt allele
GROUP BY v.`reference_name`, v.`start`
LIMIT 20;
```

```sql
-- 6. Description:  compute allele frequency per variant inside one super–population (example AFR)
WITH pop AS (
  SELECT COUNT(*) AS pop_size
  FROM   `spider2-public-data.1000_genomes.sample_info`
  WHERE  `Super_Population` = 'AFR'
)
SELECT  v.`reference_name`,
        v.`start`,
        COUNTIF( EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x>0) )
            AS carrier_cnt,                       -- # samples with ≥1 alt allele
        2 * (SELECT pop_size FROM pop)            AS total_alleles,
        COUNTIF( EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x>0) ) /
        (2 * (SELECT pop_size FROM pop))          AS allele_freq
FROM    `spider2-public-data.1000_genomes.variants` AS v
JOIN    UNNEST(v.`call`) AS c
ON      TRUE
JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
ON      si.`Sample` = c.`call_set_name`
JOIN    pop
ON      TRUE
WHERE   v.`reference_name` NOT IN ('X','Y','MT')
  AND   si.`Super_Population` = 'AFR'
GROUP BY v.`reference_name`, v.`start`
LIMIT 20;
```

```sql
-- 7. Description:  pick only COMMON variants (allele frequency ≥ 0.05) for AFR
WITH pop AS (
  SELECT COUNT(*) AS pop_size
  FROM   `spider2-public-data.1000_genomes.sample_info`
  WHERE  `Super_Population` = 'AFR'
), per_variant AS (
  SELECT  v.`reference_name`,
          v.`start`,
          COUNTIF( EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x>0) )
              AS carrier_cnt,
          COUNTIF( EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x>0) ) /
          (2 * (SELECT pop_size FROM pop))        AS allele_freq
  FROM    `spider2-public-data.1000_genomes.variants` AS v
  JOIN    UNNEST(v.`call`) AS c ON TRUE
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
         ON si.`Sample` = c.`call_set_name`
  WHERE   v.`reference_name` NOT IN ('X','Y','MT')
    AND   si.`Super_Population` = 'AFR'
  GROUP BY v.`reference_name`, v.`start`
)
SELECT *
FROM   per_variant
WHERE  allele_freq >= 0.05
LIMIT 20;
```

```sql
-- 8. Description:  for AFR, bucket common variants by number of carriers
WITH pop AS (
  SELECT COUNT(*) AS pop_size
  FROM   `spider2-public-data.1000_genomes.sample_info`
  WHERE  `Super_Population` = 'AFR'
), per_variant AS (
  SELECT  v.`reference_name`,
          v.`start`,
          COUNTIF( EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x>0) )
              AS carrier_cnt,
          COUNTIF( EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x>0) ) /
          (2 * (SELECT pop_size FROM pop))        AS allele_freq
  FROM    `spider2-public-data.1000_genomes.variants` AS v
  JOIN    UNNEST(v.`call`) AS c ON TRUE
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
         ON si.`Sample` = c.`call_set_name`
  WHERE   v.`reference_name` NOT IN ('X','Y','MT')
    AND   si.`Super_Population` = 'AFR'
  GROUP BY v.`reference_name`, v.`start`
)
SELECT  carrier_cnt               AS samples_with_variant,
        COUNT(*)                  AS variants_count
FROM    per_variant
WHERE   allele_freq >= 0.05
GROUP BY carrier_cnt
ORDER BY carrier_cnt
LIMIT 20;
```

```sql
-- 9. Description:  repeat the previous computation for *all* super–populations at once.
WITH pop_size AS (
  SELECT  `Super_Population` AS super_pop,
          COUNT(*)           AS pop_size
  FROM    `spider2-public-data.1000_genomes.sample_info`
  WHERE   `Super_Population` IS NOT NULL
  GROUP BY super_pop
), per_variant AS (
  SELECT  si.`Super_Population`                       AS super_pop,
          v.`reference_name`,
          v.`start`,
          COUNTIF( EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x>0) )
              AS carrier_cnt
  FROM    `spider2-public-data.1000_genomes.variants` AS v
  JOIN    UNNEST(v.`call`) AS c ON TRUE
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
         ON si.`Sample` = c.`call_set_name`
  WHERE   v.`reference_name` NOT IN ('X','Y','MT')
  GROUP BY super_pop, v.`reference_name`, v.`start`
), with_freq AS (
  SELECT  pv.*,
          pv.carrier_cnt / (2 * ps.pop_size) AS allele_freq,
          ps.pop_size
  FROM    per_variant AS pv
  JOIN    pop_size   AS ps
  ON      pv.super_pop = ps.super_pop
)
SELECT  super_pop,
        pop_size                      AS population_size,
        carrier_cnt                   AS samples_with_variant,
        COUNT(*)                      AS variants_count
FROM    with_freq
WHERE   allele_freq >= 0.05           -- common variants only
GROUP BY super_pop, pop_size, carrier_cnt
ORDER BY super_pop, samples_with_variant
LIMIT 20;
```

```sql
-- 10. Description (FINAL ANSWER):  distribution of common (AF ≥ 0.05) autosomal variants per super–population.
WITH pop_size AS (
  SELECT  `Super_Population` AS super_pop,
          COUNT(*)           AS pop_size
  FROM    `spider2-public-data.1000_genomes.sample_info`
  WHERE   `Super_Population` IS NOT NULL
  GROUP BY super_pop
), per_variant AS (
  SELECT  si.`Super_Population`                       AS super_pop,
          v.`reference_name`,
          v.`start`,
          COUNTIF( EXISTS (SELECT x FROM UNNEST(c.`genotype`) AS x WHERE x>0) )
              AS carrier_cnt
  FROM    `spider2-public-data.1000_genomes.variants` AS v
  JOIN    UNNEST(v.`call`) AS c ON TRUE
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
         ON si.`Sample` = c.`call_set_name`
  WHERE   v.`reference_name` NOT IN ('X','Y','MT')     -- autosomes only
  GROUP BY super_pop, v.`reference_name`, v.`start`
), with_freq AS (
  SELECT  pv.super_pop,
          pv.reference_name,
          pv.start,
          pv.carrier_cnt,
          pv.carrier_cnt / (2 * ps.pop_size) AS allele_freq,
          ps.pop_size
  FROM    per_variant AS pv
  JOIN    pop_size   AS ps
  ON      pv.super_pop = ps.super_pop
)
SELECT  super_pop                                AS super_population,
        pop_size                                 AS population_size,
        carrier_cnt                              AS samples_with_variant,
        TRUE                                     AS is_common_variant,   -- AF ≥ 0.05 by construction
        COUNT(*)                                 AS variants_count
FROM    with_freq
WHERE   allele_freq >= 0.05
GROUP BY super_pop, pop_size, carrier_cnt
ORDER BY super_pop, carrier_cnt;
```

The final query ( #10 ) returns, for every super–population:  
• its total population size,  
• the exact number of samples that share a common autosomal variant,  
• and how many distinct variants are shared by that number of samples.
