```sql
--Description:  Compute, for the AFR super-population, per-variant carrier count and
--              allele frequency (simple estimate: carriers ÷ 2N) for autosomal variants.
WITH pop AS (
  SELECT COUNT(*) AS pop_size
  FROM   `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`
  WHERE  super_population = 'AFR'
)
SELECT
  v.reference_name,
  v.start_position,
  COUNTIF(EXISTS (SELECT x FROM UNNEST(c.genotype) AS x WHERE x>0)) AS carrier_cnt,
  2 * (SELECT pop_size FROM pop)                                    AS total_alleles,
  COUNTIF(EXISTS (SELECT x FROM UNNEST(c.genotype) AS x WHERE x>0))
      / (2 * (SELECT pop_size FROM pop))                           AS allele_freq
FROM
  `bigquery-public-data.human_genome_variants.1000_genomes_variants` AS v
JOIN
  UNNEST(v.call) AS c
ON  TRUE
JOIN
  `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS si
ON  si.sample = c.call_set_name
WHERE
  v.reference_name NOT IN ('X','Y','MT')
  AND si.super_population = 'AFR'
GROUP BY
  v.reference_name, v.start_position
LIMIT 20;
