Query:
--Description:  Bucket AFR common variants by number of carrier samples
WITH pop AS (
  SELECT COUNT(*) AS pop_size
  FROM   `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`
  WHERE  super_population = 'AFR'
), per_variant AS (
  SELECT
    v.reference_name,
    v.start,
    COUNTIF(EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0)) AS carrier_cnt,
    COUNTIF(EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0))
      / (2 * (SELECT pop_size FROM pop))                                AS allele_freq
  FROM
    `genomics-public-data.1000_genomes.variants` AS v
  CROSS JOIN
    UNNEST(v.call) AS c
  JOIN
    `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS si
  ON  si.sample = c.call_set_name
  WHERE
    v.reference_name NOT IN ('X','Y','MT')
    AND si.super_population = 'AFR'
  GROUP BY
    v.reference_name, v.start
)
SELECT
  carrier_cnt  AS samples_with_variant,
  COUNT(*)     AS variants_count
FROM   per_variant
WHERE  allele_freq >= 0.05
GROUP BY carrier_cnt
ORDER BY carrier_cnt
LIMIT 20
