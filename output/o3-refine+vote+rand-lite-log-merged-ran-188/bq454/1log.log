```sql
--Description:  Verify autosomal chromosome names by excluding X, Y, and MT
SELECT DISTINCT
       reference_name
FROM   `genomics-public-data.1000_genomes.variants`
WHERE  reference_name NOT IN ('X','Y','MT')
LIMIT 20;
```

```sql
--Description:  For AFR, count how many samples carry ≥1 alternate allele for every autosomal variant
SELECT
  v.reference_name,
  v.start,
  COUNT(DISTINCT si.sample) AS carriers_in_AFR
FROM
  `genomics-public-data.1000_genomes.variants` AS v
CROSS JOIN
  UNNEST(v.call) AS c
JOIN
  `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS si
ON  si.sample = c.call_set_name
WHERE
  v.reference_name NOT IN ('X','Y','MT')
  AND si.super_population = 'AFR'
  AND EXISTS (SELECT x FROM UNNEST(c.genotype) AS x WHERE x > 0)
GROUP BY
  v.reference_name, v.start
LIMIT 20;
```

```sql
--Description:  Compute carrier count and allele frequency for each autosomal variant in AFR
WITH pop AS (
  SELECT COUNT(*) AS pop_size
  FROM   `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`
  WHERE  super_population = 'AFR'
)
SELECT
  v.reference_name,
  v.start,
  COUNTIF(EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0))       AS carrier_cnt,
  2 * (SELECT pop_size FROM pop)                                            AS total_alleles,
  COUNTIF(EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0))
      / (2 * (SELECT pop_size FROM pop))                                    AS allele_freq
FROM
  `genomics-public-data.1000_genomes.variants` AS v
CROSS JOIN
  UNNEST(v.call) AS c
JOIN
  `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS si
ON  si.sample = c.call_set_name
WHERE
  v.reference_name NOT IN ('X','Y','MT')
  AND si.super_population = 'AFR'
GROUP BY
  v.reference_name, v.start
LIMIT 20;
```

```sql
--Description:  List common (AF ≥ 0.05) autosomal variants in AFR
WITH pop AS (
  SELECT COUNT(*) AS pop_size
  FROM   `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`
  WHERE  super_population = 'AFR'
), per_variant AS (
  SELECT
    v.reference_name,
    v.start,
    COUNTIF(EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0)) AS carrier_cnt,
    COUNTIF(EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0))
      / (2 * (SELECT pop_size FROM pop))                                AS allele_freq
  FROM
    `genomics-public-data.1000_genomes.variants` AS v
  CROSS JOIN
    UNNEST(v.call) AS c
  JOIN
    `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS si
  ON  si.sample = c.call_set_name
  WHERE
    v.reference_name NOT IN ('X','Y','MT')
    AND si.super_population = 'AFR'
  GROUP BY
    v.reference_name, v.start
)
SELECT *
FROM   per_variant
WHERE  allele_freq >= 0.05
LIMIT 20;
```

```sql
--Description:  Bucket AFR common variants by number of carrier samples
WITH pop AS (
  SELECT COUNT(*) AS pop_size
  FROM   `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`
  WHERE  super_population = 'AFR'
), per_variant AS (
  SELECT
    v.reference_name,
    v.start,
    COUNTIF(EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0)) AS carrier_cnt,
    COUNTIF(EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0))
      / (2 * (SELECT pop_size FROM pop))                                AS allele_freq
  FROM
    `genomics-public-data.1000_genomes.variants` AS v
  CROSS JOIN
    UNNEST(v.call) AS c
  JOIN
    `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS si
  ON  si.sample = c.call_set_name
  WHERE
    v.reference_name NOT IN ('X','Y','MT')
    AND si.super_population = 'AFR'
  GROUP BY
    v.reference_name, v.start
)
SELECT
  carrier_cnt  AS samples_with_variant,
  COUNT(*)     AS variants_count
FROM   per_variant
WHERE  allele_freq >= 0.05
GROUP BY carrier_cnt
ORDER BY carrier_cnt
LIMIT 20;
```

```sql
--Description:  Summarise common autosomal variants across all super-populations by carrier count
WITH pop_size AS (
  SELECT
    super_population AS super_pop,
    COUNT(*)         AS pop_size
  FROM
    `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`
  WHERE
    super_population IS NOT NULL
  GROUP BY super_pop
), per_variant AS (
  SELECT
    si.super_population                           AS super_pop,
    v.reference_name,
    v.start,
    COUNTIF(EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0)) AS carrier_cnt
  FROM
    `genomics-public-data.1000_genomes.variants` AS v
  CROSS JOIN
    UNNEST(v.call) AS c
  JOIN
    `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS si
  ON  si.sample = c.call_set_name
  WHERE
    v.reference_name NOT IN ('X','Y','MT')
  GROUP BY
    super_pop, v.reference_name, v.start
), with_freq AS (
  SELECT
    pv.*,
    pv.carrier_cnt / (2 * ps.pop_size) AS allele_freq,
    ps.pop_size
  FROM
    per_variant AS pv
  JOIN
    pop_size   AS ps
  ON  pv.super_pop = ps.super_pop
)
SELECT
  super_pop                     AS super_population,
  pop_size                      AS population_size,
  carrier_cnt                   AS samples_with_variant,
  COUNT(*)                      AS variants_count
FROM   with_freq
WHERE  allele_freq >= 0.05
GROUP BY super_pop, pop_size, carrier_cnt
ORDER BY super_pop, samples_with_variant
LIMIT 20;
```

```sql
--Description:  FINAL — distribution of common (AF ≥ 0.05) autosomal variants per super-population
WITH pop_size AS (
  SELECT
    super_population AS super_pop,
    COUNT(*)         AS pop_size
  FROM
    `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`
  WHERE
    super_population IS NOT NULL
  GROUP BY super_pop
), per_variant AS (
  SELECT
    si.super_population                           AS super_pop,
    v.reference_name,
    v.start,
    COUNTIF(EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0)) AS carrier_cnt
  FROM
    `genomics-public-data.1000_genomes.variants` AS v
  CROSS JOIN
    UNNEST(v.call) AS c
  JOIN
    `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS si
  ON  si.sample = c.call_set_name
  WHERE
    v.reference_name NOT IN ('X','Y','MT')
  GROUP BY
    super_pop, v.reference_name, v.start
), with_freq AS (
  SELECT
    pv.super_pop,
    pv.carrier_cnt,
    pv.carrier_cnt / (2 * ps.pop_size) AS allele_freq,
    ps.pop_size
  FROM
    per_variant AS pv
  JOIN
    pop_size   AS ps
  ON  pv.super_pop = ps.super_pop
)
SELECT
  super_pop        AS super_population,
  pop_size         AS population_size,
  carrier_cnt      AS samples_with_variant,
  TRUE             AS is_common_variant,
  COUNT(*)         AS variants_count
FROM   with_freq
WHERE  allele_freq >= 0.05
GROUP BY super_pop, pop_size, carrier_cnt
ORDER BY super_pop, carrier_cnt;
```
