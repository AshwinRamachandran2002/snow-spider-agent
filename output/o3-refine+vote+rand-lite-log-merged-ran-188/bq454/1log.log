--Description:  The initial query referenced a restricted project and the camel-case
--              column `Super_Population`.  The publicly accessible metadata for the
--              1000 Genomes samples lives in
--              `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`,
--              where the correct column is lowercase `super_population`.
--              Count the number of samples in each super-population to obtain the
--              population size needed for downstream allele-frequency calculations.
SELECT
  super_population,
  COUNT(*) AS population_size
FROM
  `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`
WHERE
  super_population IS NOT NULL
GROUP BY
  super_population
ORDER BY
  super_population;
