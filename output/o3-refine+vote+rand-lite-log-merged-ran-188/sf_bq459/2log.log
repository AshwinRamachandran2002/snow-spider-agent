WITH
/* ------------------------------------------------------------------ */
/* 1)  Build the query’s weighted-unit vector                         */
/* ------------------------------------------------------------------ */
query_tokens AS (          -- tokenize & lowercase
    SELECT LOWER(value::string) AS token
    FROM TABLE(
             FLATTEN(
                 INPUT => SPLIT(
                            REGEXP_REPLACE(
                               'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                               '[^A-Za-z ]',' ')
                            ,' ')
             )
         )
    WHERE token <> ''
),
query_word_vecs AS (       -- weight each query word vector
    SELECT
        gv_el.index                                             AS dim,
        gv_el.value::FLOAT
        * ( 1 / POWER( COALESCE(wf."frequency",1) , 0.4) )      AS weighted_value
    FROM query_tokens qt
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
         ON gv."word" = qt.token
    LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON wf."word" = qt.token,
         TABLE(FLATTEN(INPUT => gv."vector")) gv_el
),
query_sum   AS ( SELECT dim, SUM(weighted_value) AS dim_value FROM query_word_vecs GROUP BY dim ),
query_norm  AS ( SELECT SQRT(SUM(dim_value*dim_value)) AS norm_val FROM query_sum ),
query_unit  AS ( SELECT dim, dim_value/norm_val AS unit_value FROM query_sum, query_norm ),

/* ------------------------------------------------------------------ */
/* 2)  Token counts for every Nature article                          */
/* ------------------------------------------------------------------ */
article_token_counts AS (
    SELECT
        n."id",
        n."date",
        n."title",
        LOWER(tok.value::string)                  AS token,
        COUNT(*)                                  AS cnt
    FROM WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n,
         TABLE(FLATTEN(
                 INPUT => SPLIT(
                            REGEXP_REPLACE(n."body",'[^A-Za-z ]',' ')
                           ,' ')
              )) tok
    WHERE tok.value::string <> ''
    GROUP BY n."id", n."date", n."title", LOWER(tok.value::string)
),

/* weight (count / freq^0.4) for each article-word pair */
article_word_weights AS (
    SELECT
        atc."id",
        atc."date",
        atc."title",
        atc.token,
        atc.cnt / POWER(COALESCE(wf."frequency",1) , 0.4)   AS weight
    FROM article_token_counts atc
    LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
           ON wf."word" = atc.token
),

/* ------------------------------------------------------------------ */
/* 3)  Pre-compute, per word:                                         */
/*       (a)  its dot-product with the query vector                   */
/*       (b)  its own ‖vector‖²                                       */
/* ------------------------------------------------------------------ */
word_features AS (
    SELECT
        gv."word"                                            AS word,
        SUM( gv_el.value::FLOAT *
             COALESCE(qu.unit_value,0) )                     AS dot_to_query,
        SUM( POWER(gv_el.value::FLOAT,2) )                   AS vec_l2_sq
    FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
    JOIN ( SELECT DISTINCT token FROM article_word_weights ) rw
         ON rw.token = gv."word",
         TABLE(FLATTEN(INPUT => gv."vector")) gv_el
    LEFT JOIN query_unit qu
         ON qu.dim = gv_el.index
    GROUP BY gv."word"
),

/* ------------------------------------------------------------------ */
/* 4)  Aggregate per article:                                         */
/*       • dot_product  = Σ weight * (vec · query)                    */
/*       • norm_sq      ≈ Σ weight² * ‖vec‖²  (diagonal terms)        */
/* ------------------------------------------------------------------ */
article_dot_norm AS (
    SELECT
        aw."id",
        aw."date",
        aw."title",
        SUM( aw.weight * wf.dot_to_query )          AS dot_product,
        SUM( POWER(aw.weight,2) * wf.vec_l2_sq )    AS norm_sq
    FROM article_word_weights aw
    JOIN word_features wf
         ON wf.word = aw.token
    GROUP BY aw."id", aw."date", aw."title"
)

/* ------------------------------------------------------------------ */
/* 5)  Final similarity & top-10                                       */
/* ------------------------------------------------------------------ */
SELECT
    "id",
    "date",
    "title",
    dot_product / SQRT(norm_sq)                    AS cosine_similarity
FROM article_dot_norm
WHERE norm_sq > 0
ORDER BY cosine_similarity DESC NULLS LAST
LIMIT 10;
```
