/* ----------------------------------------------------------------------
   Compute cosine–similarity between the query
   “Epigenetics and cerebral organoids: promising directions in autism spectrum disorders”
   and Nature articles, returning the 10 most-similar records
   (lighter version that tokenises only articles containing at least one
    of the four salient query keywords to stay within the execution limit)
------------------------------------------------------------------------*/
WITH
/* ========================= 0)  Settings  ============================ */
query_text AS (
    SELECT
      'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders'
        AS qtxt
),

/* ========================= 1)  Query vector ========================= */
q_tokens AS (
    SELECT LOWER(tok.value::string) AS token
    FROM   query_text,
           LATERAL SPLIT_TO_TABLE(
                REGEXP_REPLACE(qtxt,'[^A-Za-z ]',' '),' '
           ) tok
    WHERE  tok.value IS NOT NULL AND tok.value <> ''
),
q_vec_components AS (
    SELECT
        gv_el.index                                   AS dim,
        gv_el.value::FLOAT /
        POWER( COALESCE(wf."frequency",1) , 0.4 )     AS weighted_val
    FROM q_tokens qt
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
         ON gv."word" = qt.token
