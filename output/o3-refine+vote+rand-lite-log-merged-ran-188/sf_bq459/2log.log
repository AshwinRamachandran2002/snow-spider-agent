WITH
/* ----------------------------------------------------------------------
   1)  --- build the weighted, unit-length query vector -----------------
------------------------------------------------------------------------*/
query_tokens AS (   -- tokenize & lowercase the query phrase
    SELECT LOWER(value::string) AS token
    FROM TABLE(
             FLATTEN(
                 INPUT => SPLIT(
                              REGEXP_REPLACE(
                                  'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                                  '[^A-Za-z ]', ' ')
                              ,' ')
             )
         )
    WHERE token <> ''
),
query_word_vecs AS (               -- join to GloVe vectors and word frequencies
    SELECT
        gv_el.index                                                     AS dim ,
        gv_el.value::FLOAT
        * ( 1 / POWER( COALESCE(wf."frequency",1) , 0.4) )              AS weighted_value
    FROM query_tokens qt
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
          ON gv."word" = qt.token
    LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
          ON wf."word" = qt.token
         ,TABLE(FLATTEN(INPUT => gv."vector")) gv_el
),
query_sum AS (                      -- sum dimensions
    SELECT dim , SUM(weighted_value) AS dim_value
    FROM query_word_vecs
    GROUP BY dim
),
query_norm AS (                     -- L2-norm
    SELECT SQRT( SUM(dim_value * dim_value) ) AS norm_val
    FROM query_sum
),
query_unit AS (                     -- final unit vector
    SELECT dim , dim_value / norm_val AS unit_value
    FROM query_sum , query_norm
),

/* ----------------------------------------------------------------------
   2)  --- build weighted, unit vectors for every Nature article --------
------------------------------------------------------------------------*/
article_tokens AS (    -- tokenize every article body
    SELECT
        n."id" ,
        n."date" ,
        n."title" ,
        LOWER(tok.value::string) AS token
    FROM WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n ,
         TABLE(FLATTEN(
                 INPUT => SPLIT(
                             REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' ')
                            ,' ')
               )) tok
    WHERE tok.value::string <> ''
),
article_word_vecs AS (              -- map tokens to vectors + frequency weighting
    SELECT
        at."id",
        at."date",
        at."title",
        gv_el.index                                                     AS dim ,
        gv_el.value::FLOAT
        * ( 1 / POWER( COALESCE(wf."frequency",1) , 0.4) )              AS weighted_value
    FROM article_tokens at
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
          ON gv."word" = at.token
    LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
          ON wf."word" = at.token
         ,TABLE(FLATTEN(INPUT => gv."vector")) gv_el
),
article_vec_sum AS (                -- summed article vectors
    SELECT
        "id",
        "date",
        "title",
        dim,
        SUM(weighted_value)                        AS dim_value
    FROM article_word_vecs
    GROUP BY "id","date","title",dim
),
article_norm AS (                   -- L2-norm per article
    SELECT
        "id",
        "date",
        "title",
        SQRT( SUM(dim_value * dim_value) )         AS norm_val
    FROM article_vec_sum
    GROUP BY "id","date","title"
),
article_unit AS (                   -- unit-length article vectors
    SELECT
        avs."id",
        avs."date",
        avs."title",
        avs.dim,
        avs.dim_value / an.norm_val               AS unit_value
    FROM article_vec_sum avs
    JOIN article_norm an
      ON an."id" = avs."id"
),

/* ----------------------------------------------------------------------
   3)  --- cosine similarity between query & every article --------------
------------------------------------------------------------------------*/
similarities AS (
    SELECT
        au."id",
        au."date",
        au."title",
        SUM( au.unit_value * qu.unit_value )       AS cosine_similarity
    FROM article_unit au
    JOIN query_unit   qu
      ON qu.dim = au.dim
    GROUP BY au."id", au."date", au."title"
)

/* ----------------------------------------------------------------------
   4)  --- top-10 most similar articles ---------------------------------
------------------------------------------------------------------------*/
SELECT
    "id",
    "date",
    "title",
    cosine_similarity
FROM similarities
ORDER BY cosine_similarity DESC NULLS LAST
LIMIT 10;
```
