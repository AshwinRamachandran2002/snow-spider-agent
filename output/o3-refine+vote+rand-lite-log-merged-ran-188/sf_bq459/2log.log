FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
LIMIT 20;
```

```sql
-- Description: List distinct category values appearing in the corpus
SELECT DISTINCT "category"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
LIMIT 20;
```

```sql
-- Description: Find a few Nature articles whose title mentions autism (fuzzy search)
