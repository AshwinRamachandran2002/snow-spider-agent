```sql
--Description / thinking process:
-- Goal: For every word in the query
--   “Epigenetics and cerebral organoids: promising directions in autism spectrum disorders”
--   1) clean & lowercase it to keep only alphabetic characters,
--   2) look-up its corpus frequency in WORD_FREQUENCIES,
--   3) fetch its 300-dimensional embedding from GLOVE_VECTORS,
--   4) compute a weight = 1 / frequency^0.4,
--   5) scale every dimension of the embedding by that weight.
-- We then list the token, its weight, and its weighted vector (capped at 20 rows
-- just for inspection).  All identifiers are referenced un-aliased inside their
-- scope (e.g., f.frequency) to avoid the prior “invalid identifier” error.

WITH cleaned_tokens AS (                       -- step-1: split & clean
    SELECT
        LOWER(REGEXP_REPLACE(value, '[^a-zA-Z]+', '')) AS token
    FROM TABLE(
        SPLIT_TO_TABLE(
            'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
            ' '
        )
    )
    WHERE REGEXP_REPLACE(value, '[^a-zA-Z]+', '') <> ''   -- discard empties
),
token_info AS (                               -- steps-2 & 3: add freq + vector
    SELECT
        c.token,
        f.frequency   AS freq,
        g.vector      AS vec
    FROM cleaned_tokens c
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
         ON c.token = f.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    g
         ON c.token = g.word
)
SELECT                                         -- steps-4 & 5: weight & scale
    token,
    1 / POWER(freq, 0.4)                                   AS weight,
    ARRAY_TRANSFORM(vec, x -> x / POWER(freq, 0.4))        AS weighted_vec
FROM token_info
LIMIT 20;
