```sql
--Description: 
-- 1. Tokenise the query “Epigenetics and cerebral organoids: promising directions in autism spectrum disorders”.
--    • Split on spaces, lowercase, strip non-alphabetic characters, and discard empties. 
-- 2. Join each token to WORD_FREQUENCIES (“frequency” column = corpus count) and to GLOVE_VECTORS (“vector” column = 300-D embedding). 
-- 3. Compute the scaling weight  w = 1 / frequency^0.4 . 
-- 4. Apply that weight to every dimension of the embedding via ARRAY_TRANSFORM.  Inside the lambda we reference the column
--    alias-free ("frequency") so Snowflake resolves it correctly (using f."frequency" inside the lambda causes the earlier error). 
-- 5. Return token, weight, and weighted_vec (limit 20 for inspection). 
WITH tokens AS (
    SELECT
        LOWER(REGEXP_REPLACE(value, '[^a-zA-Z]+', '')) AS token
    FROM TABLE(
        SPLIT_TO_TABLE(
            'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
            ' '
        )
    )
    WHERE REGEXP_REPLACE(value, '[^a-zA-Z]+', '') <> ''
),
joined AS (
    SELECT
        t.token,
        f."frequency",
        g."vector"
    FROM tokens t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
      ON t.token = f."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
      ON t.token = g."word"
)
SELECT
    token,
    1 / POWER("frequency", 0.4)                                  AS weight,
    ARRAY_TRANSFORM("vector", v -> v / POWER("frequency", 0.4))  AS weighted_vec
FROM joined
LIMIT 20;
```
