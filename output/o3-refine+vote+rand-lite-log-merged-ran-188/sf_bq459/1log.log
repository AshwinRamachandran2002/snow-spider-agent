--Description: Aggregate (element-wise sum) the weighted vectors for the query phrase
WITH token_vecs AS (
  SELECT ARRAY_TRANSFORM(g."vector", x -> x / POWER(f."frequency", 0.4)) AS "wvec"
  FROM (
        SELECT LOWER(REGEXP_REPLACE(value, '[^a-zA-Z]+', '')) AS "token"
        FROM TABLE(
               SPLIT_TO_TABLE(
                 'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                 ' '
               )
             )
        WHERE REGEXP_REPLACE(value, '[^a-zA-Z]+', '') <> ''
       ) q
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
       ON q."token" = f."word"
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
       ON q."token" = g."word"
)
SELECT ARRAY_AGG_FLATTEN("wvec") AS "query_raw_sum_vec"
FROM token_vecs;
```

```sql
--Description: Normalise the query vector to unit length ( √Σx²  then divide every dimension )
WITH qsum AS (
  SELECT ARRAY_AGG_FLATTEN(
           ARRAY_TRANSFORM(g."vector", x -> x / POWER(f."frequency", 0.4))
         ) AS "vec"
  FROM (
        SELECT LOWER(REGEXP_REPLACE(value, '[^a-zA-Z]+', '')) AS "token"
        FROM TABLE(
               SPLIT_TO_TABLE(
                 'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                 ' '
               )
             )
        WHERE REGEXP_REPLACE(value, '[^a-zA-Z]+', '') <> ''
       ) t
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
       ON t."token" = f."word"
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
       ON t."token" = g."word"
)
SELECT 
  ARRAY_TRANSFORM(
    qsum."vec", 
    x -> x / SQRT(ARRAY_SUM(ARRAY_TRANSFORM(qsum."vec", y -> y*y)))
  ) AS "query_unit_vec"
FROM qsum
LIMIT 1;
```

