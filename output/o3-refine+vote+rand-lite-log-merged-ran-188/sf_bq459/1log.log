--Description: Build the raw (unnormalised) query vector in four logical steps  
-- 1. Tokenise the query sentence (“Epigenetics and cerebral organoids: promising directions in autism spectrum disorders”)  
--    – split on blanks, lowercase, keep alphabetic characters only, discard empties.  
-- 2. Join each token to WORD_FREQUENCIES to obtain its corpus count ("frequency")  
--    and to GLOVE_VECTORS to obtain its 300-dim embedding ("vector").  
-- 3. Compute a scalar weight = 1 / frequency^0.4, then scale each dimension of the  
--    embedding by that weight with ARRAY_TRANSFORM.  (The weight is calculated first,  
--    then multiplied inside the transform to avoid scope issues.)  
-- 4. Sum the weighted vectors element-wise with ARRAY_AGG_FLATTEN → one raw query vector.  
WITH tokens AS (                                     -- step-1  tokenise & clean
    SELECT
        LOWER(REGEXP_REPLACE(value,'[^a-zA-Z]+','')) AS token
    FROM TABLE(
        SPLIT_TO_TABLE(
            'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
            ' '
        )
    )
    WHERE REGEXP_REPLACE(value,'[^a-zA-Z]+','') <> ''
),
token_vecs AS (                                      -- steps-2 & 3  join + weight
    SELECT
        gv."vector",
        1 / POWER(wf."frequency", 0.4)               AS weight
    FROM tokens t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
      ON t.token = wf."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
      ON t.token = gv."word"
),
weighted AS (                                        -- apply weight to each vector
    SELECT
        ARRAY_TRANSFORM(
            "vector",
            v -> v * weight
        ) AS wvec
    FROM token_vecs
)
SELECT                                               -- step-4  sum element-wise
    ARRAY_AGG_FLATTEN(wvec) AS query_raw_sum_vec
FROM weighted;
```
