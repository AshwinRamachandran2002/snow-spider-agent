--Description:
-- We need a single (unnormalised) vector that represents the full query sentence.
-- Design / reasoning:
--   1) Tokenise and clean the query by: split on blanks, lowercase, strip any
--      non-alphabetic characters, discard empty results.
--   2) Join each token to:
--       • WORD_FREQUENCIES  → get corpus count “frequency”.
--       • GLOVE_VECTORS     → get 300-dim GloVe “vector”.
--   3) Weight every dimension of that vector by 1 / frequency^0.4.  We perform
--      the weighting directly inside ARRAY_TRANSFORM so the lambda sees the
--      column name frequency without alias-scope issues.
--   4) ARRAY_AGG_FLATTEN sums those weighted vectors element-wise, yielding
--      one raw (unnormalised) query vector.
WITH tokens AS (                                 -- (1) tokenise & clean
    SELECT
        LOWER(REGEXP_REPLACE(value, '[^a-zA-Z]+', '')) AS token
    FROM TABLE(
        SPLIT_TO_TABLE(
            'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
            ' '
        )
    )
    WHERE REGEXP_REPLACE(value, '[^a-zA-Z]+', '') <> ''
)
SELECT                                           -- (2‒4) weight & sum
    ARRAY_AGG_FLATTEN(
        ARRAY_TRANSFORM(
            g.vector,                            -- 300-D embedding
            v -> v / POWER(f.frequency, 0.4)     -- apply weight per dimension
        )
    ) AS query_raw_sum_vec
FROM tokens t
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
  ON t.token = f.word
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
  ON t.token = g.word;
