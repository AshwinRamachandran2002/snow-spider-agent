--Description: Produce a unit vector (same weighting scheme) for each article; here we show it for 20 sample rows
WITH art_tokens AS (
  SELECT 
    n."id",
    LOWER(REGEXP_REPLACE(word.value, '[^a-zA-Z]+', '')) AS "token"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL SPLIT_TO_TABLE(n."body", ' ') AS word
  WHERE REGEXP_REPLACE(word.value, '[^a-zA-Z]+', '') <> ''
)
, art_token_vecs AS (
  SELECT
    a."id",
    ARRAY_TRANSFORM(g."vector", x -> x / POWER(f."frequency", 0.4)) AS "wvec"
  FROM art_tokens a
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
       ON a."token" = f."word"
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
       ON a."token" = g."word"
)
, art_sums AS (
  SELECT 
    "id",
    ARRAY_AGG_FLATTEN("wvec") AS "raw_sum_vec"
  FROM art_token_vecs
  GROUP BY "id"
  LIMIT 20
)
SELECT
  "id",
  ARRAY_TRANSFORM(
    "raw_sum_vec",
    x -> x / SQRT(ARRAY_SUM(ARRAY_TRANSFORM("raw_sum_vec", y -> y*y)))
  ) AS "article_unit_vec"
FROM art_sums;
