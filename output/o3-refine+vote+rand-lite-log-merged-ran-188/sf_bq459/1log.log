```sql
--Description: Compute cosine similarity between the prepared query unit-vector and every article unit-vector, then return top-10 articles
WITH query_unit AS (  -----------------------------------------------------------
  SELECT 
    ARRAY_TRANSFORM(
      ARRAY_AGG_FLATTEN(
        ARRAY_TRANSFORM(g."vector", x -> x / POWER(f."frequency", 0.4))
      ),
      z -> z / SQRT(ARRAY_SUM(
                      ARRAY_TRANSFORM(
                        ARRAY_AGG_FLATTEN(
                          ARRAY_TRANSFORM(g."vector", x -> x / POWER(f."frequency", 0.4))
                        ),
                        y -> y*y
                      )
                    ))
    ) AS "qvec"
  FROM (
        SELECT LOWER(REGEXP_REPLACE(value, '[^a-zA-Z]+', '')) AS "token"
        FROM TABLE(
               SPLIT_TO_TABLE(
                 'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                 ' '
               )
             )
        WHERE REGEXP_REPLACE(value, '[^a-zA-Z]+', '') <> ''
       ) t
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
       ON t."token" = f."word"
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
       ON t."token" = g."word"
)
, art_unit AS (  ---------------------------------------------------------------
  SELECT 
    s."id",
    s."date",
    n."title",
    ARRAY_TRANSFORM(
      s."raw_sum_vec",
      x -> x / SQRT(ARRAY_SUM(ARRAY_TRANSFORM(s."raw_sum_vec", y -> y*y)))
    ) AS "avec"
  FROM (
        SELECT 
          "id",
          ARRAY_AGG_FLATTEN("wvec") AS "raw_sum_vec"
        FROM (
              SELECT
                n."id",
                ARRAY_TRANSFORM(g."vector", x -> x / POWER(f."frequency", 0.4)) AS "wvec"
              FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
                   LATERAL SPLIT_TO_TABLE(n."body", ' ') AS word
              JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
                   ON LOWER(REGEXP_REPLACE(word.value, '[^a-zA-Z]+', '')) = f."word"
              JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
                   ON LOWER(REGEXP_REPLACE(word.value, '[^a-zA-Z]+', '')) = g."word"
             )
        GROUP BY "id"
       ) s
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
       ON s."id" = n."id"
)
SELECT
  a."id",
  a."date",
  a."title",
  ARRAY_SUM(
    ARRAY_ZIP_WITH(
      (SELECT "qvec" FROM query_unit),
      a."avec",
      (x, y) -> x * y
    )
  )                 AS "cosine_similarity"
FROM art_unit a
ORDER BY "cosine_similarity" DESC
LIMIT 10;
```
