--Description: Join those query tokens to frequencies and GloVe vectors (keep only tokens that appear in both helper tables)
WITH query_tokens AS (
  SELECT 
    LOWER(REGEXP_REPLACE(value, '[^a-zA-Z]+', '')) AS "token"
  FROM TABLE(
         SPLIT_TO_TABLE(
           'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
