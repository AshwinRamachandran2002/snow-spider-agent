--Description: Build the un-normalised query vector.
-- Steps / reasoning:
--   1. Tokenise the query sentence (lower-case, keep letters only).
--   2. Join every token to WORD_FREQUENCIES (gives column “frequency”) and
--      to GLOVE_VECTORS (gives column “vector”).
--   3. Weight each 300-D embedding by 1 / frequency^0.4 using ARRAY_TRANSFORM.
--      Inside the lambda we reference the column name frequency directly
--      (not f.frequency) to avoid the earlier identifier error.
--   4. ARRAY_AGG_FLATTEN then adds the weighted vectors element-wise,
--      producing the single raw summed query vector.
WITH tokens AS (
    SELECT LOWER(REGEXP_REPLACE(value,'[^a-zA-Z]+','')) AS token
    FROM TABLE(
        SPLIT_TO_TABLE(
            'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
            ' '
        )
    )
    WHERE REGEXP_REPLACE(value,'[^a-zA-Z]+','') <> ''
),
weighted AS (
    SELECT
        ARRAY_TRANSFORM(
            g.vector,
            x -> x / POWER(frequency, 0.4)   -- use column name, not aliased reference
        ) AS wvec
    FROM tokens t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
      ON t.token = f.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
      ON t.token = g.word
)
SELECT ARRAY_AGG_FLATTEN(wvec) AS query_raw_sum_vec
FROM weighted;
