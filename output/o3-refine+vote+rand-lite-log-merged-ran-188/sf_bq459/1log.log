```sql
--Description:  We want to see how each individual word from the query
--‘Epigenetics and cerebral organoids: promising directions in autism spectrum disorders’
--is converted into its TF-adjusted GloVe vector.  Steps:
--  1. Split the sentence on spaces, lowercase each token and strip punctuation.
--  2. Discard empty tokens.
--  3. Join every token to WORD_FREQUENCIES (for corpus counts) and GLOVE_VECTORS
--     (for the 300-dimensional embedding).
--  4. Compute a weight = 1 / frequency^0.4 .
--  5. Scale every dimension of the vector by that weight using ARRAY_TRANSFORM.
--  6. Show the token, its weight and first 20 weighted vectors so we can confirm
--     numbers are produced correctly.
WITH query_tokens AS (
    SELECT
        LOWER(REGEXP_REPLACE(value, '[^a-zA-Z]+', '')) AS token
    FROM TABLE(
        SPLIT_TO_TABLE(
            'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
            ' '
        )
    )
    WHERE REGEXP_REPLACE(value, '[^a-zA-Z]+', '') <> ''    -- keep non-empty tokens
),
token_vecs AS (
    SELECT
        q.token,
        1 / POWER(f."frequency", 0.4)                                                    AS weight,
        ARRAY_TRANSFORM(g."vector", x -> x / POWER(f."frequency", 0.4))                  AS weighted_vec
    FROM query_tokens            q
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f  ON q.token = f."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS      g ON q.token = g."word"
)
SELECT *
FROM token_vecs
LIMIT 20;
