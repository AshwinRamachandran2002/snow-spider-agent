WITH
/* --------------------  stop-words -------------------- */
stopwords(word) AS (
  SELECT column1 FROM VALUES
    ('a'),('an'),('and'),('are'),('as'),('at'),('be'),('but'),('by'),
    ('for'),('from'),('if'),('in'),('into'),('is'),('it'),('no'),('not'),
    ('of'),('on'),('or'),('such'),('the'),('their'),('then'),('there'),
    ('these'),('they'),('this'),('to'),('was'),('will'),('with'),('that'),
    ('which')
),

/* --------------------  query vector ------------------ */
query_tokens AS (
  SELECT LOWER(TRIM(f.value::string)) AS token
  FROM (
        SELECT SPLIT(
                 LOWER(REGEXP_REPLACE(
                   'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                   '[^A-Za-z ]',' '
                 )),
                 ' '
               ) AS arr
       ) q
       ,LATERAL FLATTEN(input => q.arr) f
  WHERE f.value::string <> ''
    AND LOWER(TRIM(f.value::string)) NOT IN (SELECT word FROM stopwords)
),

query_weighted_flat AS (
  SELECT
      fv.index                               AS dim,
      fv.value::float *
      POWER(wf."frequency", -0.4)            AS wval
  FROM query_tokens qt
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
       ON gv."word" = qt.token
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
       ON wf."word" = qt.token
      ,LATERAL FLATTEN(input => gv."vector") fv
),

query_vector AS (
