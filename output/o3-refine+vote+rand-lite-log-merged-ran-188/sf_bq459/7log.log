```sql
--Description / Thinking process:
-- Objective: Attach GloVe vectors to every token appearing in the query phrase
--  “Epigenetics and cerebral organoids: promising directions in autism spectrum disorders”.
-- Approach:
--   1. Lower-case the full phrase and SPLIT it on spaces → array of tokens.
--   2. Use LATERAL FLATTEN to turn that array into one row per token.
--   3. Wrap the FLATTEN inside a CTE (query_tokens) to avoid lateral-view-on-left-side join errors.
--   4. LEFT JOIN this token list to WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS
--      so we can see which tokens have vectors.
--   5. LIMIT 20 for a quick preview.
WITH query_tokens AS (
    SELECT
        f.value::STRING AS token
    FROM (
        SELECT SPLIT(
                 LOWER(
                   'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders'
                 ),
                 ' '
               ) AS token_array
    ) q,
    LATERAL FLATTEN(input => q.token_array) f
)
SELECT
    qt.token,
    gv."vector"
FROM query_tokens qt
LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
       ON gv."word" = qt.token
LIMIT 20;
```
