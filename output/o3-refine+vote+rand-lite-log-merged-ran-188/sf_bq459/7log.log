```sql
--Description / Thinking process:
-- Fix for “Tokenise one sample article body and join each token to its corpus frequency”.
-- Problem: the original query put LATERAL FLATTEN on the left-hand side of a JOIN,
--          producing:  “Lateral View cannot be on the left side of join”.
-- Solution: perform the FLATTEN inside a CTE (tokens_cte); afterwards we can
--           LEFT JOIN that neat token list to WORD_FREQUENCIES.
WITH article AS (
    SELECT "id", "body"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    LIMIT 1
),
clean AS (
    SELECT
        "id",
        LOWER(REGEXP_REPLACE("body", '[^A-Za-z ]', '')) AS clean_body
    FROM article
),
tokens_cte AS (
    SELECT
        c."id",
        f.value::STRING AS token
    FROM clean c,
         LATERAL FLATTEN(input => SPLIT(c.clean_body, ' ')) f
    WHERE f.value::STRING <> ''
)
SELECT
    t."id",
    t.token,
    wf."frequency"
FROM tokens_cte t
LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
       ON wf."word" = t.token
LIMIT 20;
```

```sql
--Description / Thinking process:
-- Fix for “pull vector + frequency so the weight 1/f^0.4 can be applied”.
-- Although the original worked, we mirror the safer pattern: isolate FLATTEN in
-- a CTE (tokens_cte) first, then JOIN to GloVe/Frequency tables.
WITH article AS (
    SELECT "id", "body"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    LIMIT 1
),
tokens_cte AS (
    SELECT
        a."id",
        f.value::STRING AS token
    FROM article a,
         LATERAL FLATTEN(
             input => SPLIT(
                         LOWER(REGEXP_REPLACE(a."body", '[^A-Za-z ]', '')),
                         ' '
                     )
         ) f
    WHERE f.value::STRING <> ''
    LIMIT 100          -- keep same sampling behaviour
),
glove_freq AS (
    SELECT
        tc."id",
        tc.token,
        gv."vector",
        wf."frequency"
    FROM tokens_cte tc
    LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"   gv ON gv."word" = tc.token
    LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf ON wf."word" = tc.token
)
SELECT
    "id",
    token,
    POWER("frequency", -0.4) AS weight,
    "vector"
FROM glove_freq
WHERE "vector" IS NOT NULL
  AND "frequency" IS NOT NULL
LIMIT 20;
```

