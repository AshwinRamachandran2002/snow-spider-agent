```sql
--Description: Tokenise one sample article body and join each token to its corpus frequency
WITH article AS (
  SELECT "id", "body"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
  LIMIT 1
),
clean AS (
  SELECT
    "id",
    LOWER(REGEXP_REPLACE("body", '[^A-Za-z ]', '')) AS "clean_body"
  FROM article
),
split AS (
  SELECT
    "id",
    SPLIT("clean_body", ' ') AS "token_array"
  FROM clean
)
SELECT
  s."id",
  t.value::STRING                         AS "token",
  f."frequency"
FROM split s,
     LATERAL FLATTEN(input => s."token_array") t
LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" f
  ON f."word" = t.value::STRING
LIMIT 20;
```

```sql
--Description: For the same sample article, pull vector + frequency so the weight 1/f^0.4 can be applied
WITH article AS (
  SELECT "id", "body"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
  LIMIT 1
),
tokens AS (
  SELECT
    "id",
    SPLIT(LOWER(REGEXP_REPLACE("body", '[^A-Za-z ]', '')), ' ') AS "token_array"
  FROM article
),
tok_tbl AS (
  SELECT
    a."id",
    t.value::STRING AS "token"
  FROM tokens a,
       LATERAL FLATTEN(input => a."token_array") t
  WHERE t.value::STRING <> ''
  LIMIT 100
),
glove_freq AS (
  SELECT
    tt."id",
    tt."token",
    g."vector",
    f."frequency"
  FROM tok_tbl tt
  LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"   g ON g."word" = tt."token"
  LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" f ON f."word" = tt."token"
)
SELECT
  "id",
  "token",
  POWER("frequency", -0.4)      AS "weight",
  "vector"
FROM glove_freq
WHERE "vector" IS NOT NULL
  AND "frequency" IS NOT NULL
LIMIT 20;
```

