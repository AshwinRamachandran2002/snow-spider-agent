--Description: Derive 2-digit state FIPS from each ZIP and join to state-name lookup
SELECT
    z."geo_id",
    z."employed_wholesale_trade",
    z."employed_manufacturing",
    TO_NUMBER(LEFT(z."geo_id", 2)) AS "state_fips",
    s."state"
FROM  "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR"  z
