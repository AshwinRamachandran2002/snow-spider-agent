```sql
--Description: Summarise vulnerable workers by state (no income filter applied yet)
WITH zip_vuln AS (
    SELECT
        TO_NUMBER(LEFT(GEO_ID, 2))             AS STATE_FIPS,
        EMPLOYED_WHOLESALE_TRADE * 0.38        AS VULN_WHOLESALE,
        EMPLOYED_MANUFACTURING   * 0.41        AS VULN_MFG
    FROM  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.ZIP_CODES_2017_5YR
)
SELECT
    s.STATE,
    SUM(v.VULN_WHOLESALE) AS VULNERABLE_WHOLESALE_TRADE,
    SUM(v.VULN_MFG)       AS VULNERABLE_MANUFACTURING,
    SUM(v.VULN_WHOLESALE) + SUM(v.VULN_MFG) AS TOTAL_VULNERABLE
FROM  zip_vuln v
JOIN  CENSUS_BUREAU_ACS_2.CYCLISTIC.STATE_FIPS s
      ON v.STATE_FIPS = s.FIPS
GROUP BY s.STATE
LIMIT 20;
```

```sql
--Description: Identify ZIP codes whose median household income fell from 2015 to 2018
WITH income_change AS (
    SELECT
        a.GEO_ID,
        b.MEDIAN_HOUSEHOLD_INCOME - a.MEDIAN_HOUSEHOLD_INCOME AS INCOME_CHANGE
    FROM  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.ZIP_CODES_2015_5YR a
    JOIN  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR b
          ON a.GEO_ID = b.GEO_ID
    WHERE b.MEDIAN_HOUSEHOLD_INCOME < a.MEDIAN_HOUSEHOLD_INCOME   -- income fell
)
SELECT *
FROM   income_change
LIMIT 20;
```

```sql
--Description: Combine ZIPs with falling income and 2017 vulnerable-worker counts; list top states
WITH income_change AS (
    SELECT a.GEO_ID
    FROM  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.ZIP_CODES_2015_5YR a
    JOIN  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR b
          ON a.GEO_ID = b.GEO_ID
    WHERE b.MEDIAN_HOUSEHOLD_INCOME < a.MEDIAN_HOUSEHOLD_INCOME
),
zip_vuln AS (
    SELECT
        z.GEO_ID,
        TO_NUMBER(LEFT(z.GEO_ID, 2)) AS STATE_FIPS,
        z.EMPLOYED_WHOLESALE_TRADE * 0.38 AS VULN_WHOLESALE,
        z.EMPLOYED_MANUFACTURING   * 0.41 AS VULN_MFG
    FROM  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.ZIP_CODES_2017_5YR z
    JOIN  income_change ic USING (GEO_ID)
)
SELECT
    s.STATE,
    SUM(zv.VULN_WHOLESALE) AS VULNERABLE_WHOLESALE_TRADE,
    SUM(zv.VULN_MFG)       AS VULNERABLE_MANUFACTURING,
    SUM(zv.VULN_WHOLESALE) + SUM(zv.VULN_MFG) AS TOTAL_VULNERABLE
FROM  zip_vuln zv
JOIN  CENSUS_BUREAU_ACS_2.CYCLISTIC.STATE_FIPS s
      ON zv.STATE_FIPS = s.FIPS
GROUP BY s.STATE
ORDER BY TOTAL_VULNERABLE DESC
LIMIT 20;
