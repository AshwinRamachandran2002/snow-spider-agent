--             joins the 2015 and 2018 ZIP-level tables on GEO_ID, pulls the median
--             household income for each year, and computes the change; it uses unquoted
--             column names to avoid the identifier error and shows 20 sample rows. 
SELECT
    a.geo_id,
    a.median_household_income  AS income_2015,
    b.median_household_income  AS income_2018,
    b.median_household_income - a.median_household_income AS income_change_15_18
FROM  "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR"  a
JOIN  "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"  b
      ON a.geo_id = b.geo_id
LIMIT 20;
