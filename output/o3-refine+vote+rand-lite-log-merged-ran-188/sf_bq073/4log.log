```sql
--Description: Summarise vulnerable workers by state (still at ZIP grain, no income filter yet).  
WITH zip_vuln AS (
  SELECT LEFT(z."geo_id",2)::NUMBER  AS "state_fips",
         z."employed_wholesale_trade"*0.38  AS "vuln_wholesale",
         z."employed_manufacturing"  *0.41  AS "vuln_mfg"
  FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" z
)
SELECT s."state",
       SUM(v."vuln_wholesale") AS "vulnerable_wholesale_trade",
       SUM(v."vuln_mfg")       AS "vulnerable_manufacturing",
       SUM(v."vuln_wholesale")+SUM(v."vuln_mfg") AS "total_vulnerable"
FROM   zip_vuln v
JOIN   "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS" s
  ON   v."state_fips" = s."fips"
GROUP  BY s."state"
LIMIT 20;
```

```sql
--Description: Identify ZIPs whose median income dropped (or rose below a threshold) between 2015-2018.  
WITH income_change AS (
  SELECT a."geo_id",
         b."median_household_income" - a."median_household_income" AS "income_change"
  FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR" a
  JOIN   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR" b
    ON   a."geo_id" = b."geo_id"
  WHERE  b."median_household_income" - a."median_household_income" < 0    --income fell
)
SELECT * FROM income_change
LIMIT 20;
```

```sql
--Description: Combine the “income-decline” ZIP list with vulnerable-worker counts for 2017.  
WITH income_change AS (
  SELECT a."geo_id"
  FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR" a
  JOIN   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR" b
    ON   a."geo_id" = b."geo_id"
  WHERE  b."median_household_income" < a."median_household_income"   --income fell
), zip_vuln AS (
  SELECT z."geo_id",
         LEFT(z."geo_id",2)::NUMBER AS "state_fips",
         z."employed_wholesale_trade"*0.38 AS "vuln_wholesale",
         z."employed_manufacturing"*0.41   AS "vuln_mfg"
  FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" z
  JOIN   income_change ic USING ("geo_id")
)
SELECT s."state",
       SUM(zip_vuln."vuln_wholesale") AS "vulnerable_wholesale_trade",
       SUM(zip_vuln."vuln_mfg")       AS "vulnerable_manufacturing",
       SUM(zip_vuln."vuln_wholesale")+SUM(zip_vuln."vuln_mfg") AS "total_vulnerable"
FROM   zip_vuln
JOIN   "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS" s
  ON   zip_vuln."state_fips" = s."fips"
GROUP  BY s."state"
ORDER  BY "total_vulnerable" DESC
LIMIT 20;
```

