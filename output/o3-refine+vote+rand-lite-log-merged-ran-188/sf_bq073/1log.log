        v."vuln_wholesale",
        v."vuln_manufacturing",
        v."vuln_wholesale" + v."vuln_manufacturing" AS "total_vulnerable"
FROM (
        SELECT  "geo_id",
                ("employed_wholesale_trade" * 0.38) AS "vuln_wholesale",
                ("employed_manufacturing"   * 0.41) AS "vuln_manufacturing"
        FROM    "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."STATE_2017_1YR"
     ) v
JOIN    "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS" f
  ON    TO_NUMBER(v."geo_id") = f."fips"
LIMIT 20;
```

```sql
--Description: Produce the final list of states ordered by total vulnerable workers (rounded values for readability).
SELECT  f."state",
        ROUND(v."vuln_wholesale")      AS "vulnerable_wholesale_trade",
        ROUND(v."vuln_manufacturing")  AS "vulnerable_manufacturing",
        ROUND(v."total_vulnerable")    AS "total_vulnerable_workers"
FROM (
        SELECT  "geo_id",
                ("employed_wholesale_trade" * 0.38) AS "vuln_wholesale",
                ("employed_manufacturing"   * 0.41) AS "vuln_manufacturing",
                ("employed_wholesale_trade" * 0.38) +
                ("employed_manufacturing"   * 0.41) AS "total_vulnerable"
        FROM    "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."STATE_2017_1YR"
     ) v
JOIN    "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS" f
  ON    TO_NUMBER(v."geo_id") = f."fips"
ORDER BY "total_vulnerable_workers" DESC
LIMIT 20;
```
