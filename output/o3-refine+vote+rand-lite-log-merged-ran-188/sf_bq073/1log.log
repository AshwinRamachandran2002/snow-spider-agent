```sql
-- 1) Preview 2015 ZIP Code table to discover income–related columns
SELECT *
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR"
LIMIT 20;
```

```sql
-- 2) Preview 2018 ZIP Code table to locate the same income columns
SELECT *
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"
LIMIT 20;
```

```sql
-- 3) Inspect only the geo_id and the most common income column that appears in these tables
SELECT "geo_id",
       "median_household_income"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR"
LIMIT 20;
```

```sql
-- 4) Grab the same income field for 2018 to prepare for a difference calculation
SELECT "geo_id",
       "median_household_income"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"
LIMIT 20;
```

```sql
-- 5) Join 2015-vs-2018 ZIP tables to calculate each ZIP’s change in median income
SELECT a."geo_id",
       b."median_household_income" - a."median_household_income" AS "income_diff_2015_18"
FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR"  a
JOIN   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"  b
  ON   a."geo_id" = b."geo_id"
LIMIT 20;
```

```sql
-- 6) Preview 2017 ACS employment figures at the State level
SELECT "geo_id",
       "employed_wholesale_trade",
       "employed_manufacturing"
FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."STATE_2017_1YR"
LIMIT 20;
```

```sql
-- 7) Show the State-name ↔ FIPS cross-walk we will need for joining
SELECT DISTINCT "state",
       "fips"
FROM   "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS"
ORDER BY "state"
LIMIT 20;
```

```sql
-- 8) Compute vulnerable workers (38 % wholesale, 41 % manufacturing) for every state
SELECT s."geo_id"                     AS "state_fips",
       (s."employed_wholesale_trade" * 0.38) AS "vuln_wholesale",
       (s."employed_manufacturing"   * 0.41) AS "vuln_manufacturing"
FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."STATE_2017_1YR"  s
LIMIT 20;
```

```sql
-- 9) Add State names to those vulnerable-worker counts
SELECT f."state",
       v."vuln_wholesale",
       v."vuln_manufacturing",
       v."vuln_wholesale" + v."vuln_manufacturing" AS "total_vulnerable"
FROM (
    SELECT "geo_id",
           ("employed_wholesale_trade" * 0.38) AS "vuln_wholesale",
           ("employed_manufacturing"   * 0.41) AS "vuln_manufacturing"
    FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."STATE_2017_1YR"
) v
JOIN "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS" f
  ON TO_NUMBER(v."geo_id") = f."fips"
LIMIT 20;
```

```sql
-- 10) Final combined query: order states by total vulnerable workers (highest → lowest)
SELECT f."state",
       ROUND(v."vuln_wholesale")      AS "vulnerable_wholesale_trade",
       ROUND(v."vuln_manufacturing")  AS "vulnerable_manufacturing",
       ROUND(v."total_vulnerable")    AS "total_vulnerable_workers"
FROM (
    SELECT "geo_id",
           ("employed_wholesale_trade" * 0.38) AS "vuln_wholesale",
           ("employed_manufacturing"   * 0.41) AS "vuln_manufacturing",
           ("employed_wholesale_trade" * 0.38) +
           ("employed_manufacturing"   * 0.41) AS "total_vulnerable"
    FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."STATE_2017_1YR"
) v
JOIN "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS" f
  ON TO_NUMBER(v."geo_id") = f."fips"
ORDER BY "total_vulnerable_workers" DESC
LIMIT 20;
```
