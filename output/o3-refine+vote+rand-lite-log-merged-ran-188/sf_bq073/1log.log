ORDER  BY "state"
LIMIT 20;
```

```sql
--Description: Compute the vulnerable-worker counts for every state in 2017 (38 % of wholesale-trade jobs and 41 % of manufacturing jobs).
SELECT  "geo_id"                                   AS "state_fips",
        ("employed_wholesale_trade" * 0.38)        AS "vuln_wholesale",
        ("employed_manufacturing"   * 0.41)        AS "vuln_manufacturing"
FROM    "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."STATE_2017_1YR"
LIMIT 20;
