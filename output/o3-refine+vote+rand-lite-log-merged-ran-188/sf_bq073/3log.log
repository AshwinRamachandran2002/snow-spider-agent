Query:
-- Description: Aggregate those vulnerable-worker numbers and order states by largest totals.
SELECT  sf."state",
        SUM(s."employed_wholesale_trade" * 0.38)                AS "vulnerable_wholesale_trade",
        SUM(s."employed_manufacturing"  * 0.41)                 AS "vulnerable_manufacturing",
        SUM(s."employed_wholesale_trade" * 0.38
          + s."employed_manufacturing"  * 0.41)                 AS "total_vulnerable_workers"
FROM    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_1YR"   s
JOIN    CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"               sf
      ON TO_NUMBER(s."geo_id") = sf."fips"
GROUP BY sf."state"
ORDER BY "total_vulnerable_workers" DESC
LIMIT 20;
