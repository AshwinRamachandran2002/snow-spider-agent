```sql
--Description:  Compute each state’s average ZIP-level change in median household income
--              from 2015 to 2018.  
--              · Join the 2015- and 2018-vintage ZIP tables on GEO_ID.  
--              · Calculate INCOME_CHANGE per ZIP (2018 – 2015).  
--              · Convert the first two digits of GEO_ID to a numeric FIPS code and join
--                to STATE_FIPS for the state name.  
--              · "state" and "fips" are quoted because they are stored in lower-case in
--                STATE_FIPS, making them case-sensitive identifiers in Snowflake.  
--              · Group by the same quoted state field to avoid identifier-mismatch errors.
SELECT  sf."state"                                                AS state_name,
        AVG(b.median_household_income - a.median_household_income) AS avg_income_change,
        COUNT(*)                                                   AS zip_count
FROM    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.ZIP_CODES_2015_5YR  a
JOIN    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR  b
          ON a.geo_id = b.geo_id
JOIN    CENSUS_BUREAU_ACS_2.CYCLISTIC.STATE_FIPS                  sf
          ON TO_NUMBER(LEFT(a.geo_id, 2)) = sf."fips"
GROUP BY sf."state"
LIMIT 20;
```
