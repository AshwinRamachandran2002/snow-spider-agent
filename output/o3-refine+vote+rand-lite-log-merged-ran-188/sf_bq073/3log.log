--Description:  Join the 2015- and 2018-ZIP ACS tables on GEO_ID, calculate each ZIP’s
--              change in median-household-income, convert the first two digits of GEO_ID
--              to a numeric state FIPS code, join to STATE_FIPS to obtain the state name,
--              then average the ZIP-level income change within every state.  The columns
--              "state" and "fips" are quoted because they exist in lower-case (and are
--              therefore case-sensitive) in STATE_FIPS, while GEO_ID and
--              MEDIAN_HOUSEHOLD_INCOME are referenced exactly as stored in the ZIP tables.
SELECT  sf."state"                                                  AS state_name,
        AVG( b."median_household_income"  -  a."median_household_income")  AS avg_income_change,
        COUNT(*)                                                      AS zip_count
FROM    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"  a
JOIN    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"  b
          ON a."geo_id" = b."geo_id"
JOIN    CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"                  sf
          ON TO_NUMBER(LEFT(a."geo_id", 2)) = sf."fips"
GROUP BY sf."state"
LIMIT 20;
```
