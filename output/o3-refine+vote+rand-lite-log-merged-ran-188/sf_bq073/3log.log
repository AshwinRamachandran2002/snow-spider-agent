```sql
--Description:  Final state-level list of “vulnerable” workers.  A worker is considered
--              vulnerable if they are in (a) wholesale trade and we take 38 % of those
--              2017 employees, or (b) manufacturing and we take 41 % of those 2017
--              employees.  The query:
--                • joins STATE_2017_1YR (employment counts) to STATE_FIPS (state names),
--                • multiplies employment counts by the given vulnerability fractions,
--                • rounds results to whole persons,
--                • orders states by the combined vulnerable total (largest → smallest).
SELECT  sf.state                                       AS state,
        ROUND(s.employed_wholesale_trade * 0.38)       AS vulnerable_wholesale_trade,
        ROUND(s.employed_manufacturing  * 0.41)        AS vulnerable_manufacturing,
        ROUND(s.employed_wholesale_trade * 0.38
            + s.employed_manufacturing  * 0.41)        AS total_vulnerable_workers
FROM    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.STATE_2017_1YR  s
JOIN    CENSUS_BUREAU_ACS_2.CYCLISTIC.STATE_FIPS              sf
          ON TO_NUMBER(s.geo_id) = sf.fips
ORDER BY total_vulnerable_workers DESC;
```
