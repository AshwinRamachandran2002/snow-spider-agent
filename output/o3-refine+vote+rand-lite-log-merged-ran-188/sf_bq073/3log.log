```sql
-- Description: For each ZIP code, calculate the change in median household income between 2015 and 2018.
SELECT  a."geo_id",
        a."median_household_income"          AS "income_2015",
        b."median_household_income"          AS "income_2018",
        b."median_household_income" 
          - a."median_household_income"      AS "income_change"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"  a
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"  b
      ON a."geo_id" = b."geo_id"
LIMIT 20;
```

```sql
-- Description: Inspect 2017 1-year ACS state-level employment counts.
SELECT "geo_id",
       "employed_wholesale_trade",
       "employed_manufacturing"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_1YR"
LIMIT 20;
```

```sql
-- Description: Join state FIPS codes to readable state names while keeping 2017 employment figures.
SELECT  sf."state",
        s."employed_wholesale_trade",
        s."employed_manufacturing"
FROM    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_1YR"   s
JOIN    CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"               sf
      ON TO_NUMBER(s."geo_id") = sf."fips"
LIMIT 20;
```

```sql
-- Description: Compute vulnerable workers (38 % of wholesale-trade + 41 % of manufacturing) for each state.
SELECT  sf."state",
        s."employed_wholesale_trade" * 0.38  AS "vulnerable_wholesale_trade",
        s."employed_manufacturing"  * 0.41   AS "vulnerable_manufacturing",
        s."employed_wholesale_trade" * 0.38
      + s."employed_manufacturing"  * 0.41   AS "total_vulnerable_workers"
FROM    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_1YR"   s
JOIN    CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"               sf
      ON TO_NUMBER(s."geo_id") = sf."fips"
LIMIT 20;
```

```sql
-- Description: Aggregate those vulnerable-worker numbers and order states by largest totals.
SELECT  sf."state",
        SUM(s."employed_wholesale_trade" * 0.38)                AS "vulnerable_wholesale_trade",
        SUM(s."employed_manufacturing"  * 0.41)                 AS "vulnerable_manufacturing",
        SUM(s."employed_wholesale_trade" * 0.38
          + s."employed_manufacturing"  * 0.41)                 AS "total_vulnerable_workers"
FROM    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_1YR"   s
JOIN    CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"               sf
      ON TO_NUMBER(s."geo_id") = sf."fips"
GROUP BY sf."state"
ORDER BY "total_vulnerable_workers" DESC
LIMIT 20;
```

```sql
-- Description: Example of attaching ZIP-level income change to a state using the first two ZIP digits (approx. state FIPS),
--              then averaging income change per state.
SELECT  sf."state",
        AVG(z."income_change")               AS "avg_income_change",
        COUNT(*)                             AS "zip_count"
FROM  (
        SELECT  a."geo_id",
                b."median_household_income" - a."median_household_income" AS "income_change"
        FROM    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
        JOIN    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
             ON a."geo_id" = b."geo_id"
      ) z
JOIN  CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"  sf
      ON TO_NUMBER(LEFT(z."geo_id", 2)) = sf."fips"
GROUP BY sf."state"
LIMIT 20;
```

```sql
-- Description: Final result – list states with vulnerable wholesale, vulnerable manufacturing, and total vulnerable workers,
--              sorted by total (top 20 shown).
SELECT  v."state",
        v."vulnerable_wholesale_trade",
        v."vulnerable_manufacturing",
        v."total_vulnerable_workers"
FROM  (
        SELECT  sf."state",
                ROUND(s."employed_wholesale_trade" * 0.38, 0)                 AS "vulnerable_wholesale_trade",
                ROUND(s."employed_manufacturing"  * 0.41, 0)                  AS "vulnerable_manufacturing",
                ROUND(s."employed_wholesale_trade" * 0.38
                    + s."employed_manufacturing"  * 0.41, 0)                  AS "total_vulnerable_workers"
        FROM    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_1YR"   s
        JOIN    CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"               sf
              ON TO_NUMBER(s."geo_id") = sf."fips"
      ) v
ORDER BY v."total_vulnerable_workers" DESC
LIMIT 20;
```

```sql
-- Description: (Optional) National-level sum of vulnerable workers for context.
SELECT  SUM("vulnerable_wholesale_trade")    AS "total_vulnerable_wholesale_trade",
        SUM("vulnerable_manufacturing")      AS "total_vulnerable_manufacturing",
        SUM("total_vulnerable_workers")      AS "national_total_vulnerable_workers"
FROM (
        SELECT  s."employed_wholesale_trade" * 0.38  AS "vulnerable_wholesale_trade",
                s."employed_manufacturing"  * 0.41   AS "vulnerable_manufacturing",
                s."employed_wholesale_trade" * 0.38
              + s."employed_manufacturing"  * 0.41   AS "total_vulnerable_workers"
        FROM    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_1YR"  s
     ) t
LIMIT 20;
```
