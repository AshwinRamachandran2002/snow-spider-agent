```sql
--Description: Pull the 2018 median household income to pair with 2015;   
--again, update the column name after confirming it in step-2.
SELECT 
    "geo_id",
    "median_household_income"       AS "mhi_2018"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"
LIMIT 20;
```

```sql
--Description: Join 2015 & 2018 files on ZIP code to calculate the change in median income (Δ = 2018-2015).
SELECT 
    a."geo_id",
    a."mhi_2015",
    b."mhi_2018",
    b."mhi_2018" - a."mhi_2015"     AS "mhi_change"
FROM (
        SELECT "geo_id", "median_household_income" AS "mhi_2015"
        FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR"
     ) a
JOIN (
        SELECT "geo_id", "median_household_income" AS "mhi_2018"
        FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"
     ) b
ON a."geo_id" = b."geo_id"
LIMIT 20;
```

```sql
--Description: Combine the median-income change from step-6 with 2017 employment counts  
--so we have everything at the ZIP level in one record.
SELECT
    z."geo_id",
    z."mhi_change",
    e."employed_wholesale_trade",
    e."employed_manufacturing"
FROM (
        /* Δ Median income */
        SELECT 
            a."geo_id",
            b."mhi_2018" - a."mhi_2015" AS "mhi_change"
        FROM (
                SELECT "geo_id", "median_household_income" AS "mhi_2015"
                FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR"
             ) a
        JOIN (
                SELECT "geo_id", "median_household_income" AS "mhi_2018"
                FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"
             ) b
          ON a."geo_id" = b."geo_id"
     ) z
JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" e
  ON z."geo_id" = e."geo_id"
LIMIT 20;
```

```sql
--Description: Add the “vulnerable” worker counts (38 % wholesale, 41 % manufacturing) at the ZIP level.
SELECT
    z."geo_id",
    z."mhi_change",
    e."employed_wholesale_trade",
    e."employed_manufacturing",
    0.38 * e."employed_wholesale_trade"  AS "vul_wholesale",
    0.41 * e."employed_manufacturing"    AS "vul_manufacturing"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" e
JOIN (
        SELECT 
            a."geo_id",
            b."mhi_2018" - a."mhi_2015" AS "mhi_change"
        FROM (
                SELECT "geo_id", "median_household_income" AS "mhi_2015"
                FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR"
             ) a
        JOIN (
                SELECT "geo_id", "median_household_income" AS "mhi_2018"
                FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"
             ) b
          ON a."geo_id" = b."geo_id"
     ) z
  ON z."geo_id" = e."geo_id"
LIMIT 20;
```

```sql
--Description: Map ZIP codes to state FIPS (first 2 digits of ZIP’s geo_id) and fetch state names.
SELECT DISTINCT
    s."state",
    SUBSTR(z."geo_id", 1, 2)::NUMBER AS "state_fips"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" z
JOIN "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS"               s
  ON s."fips" = SUBSTR(z."geo_id", 1, 2)::NUMBER
LIMIT 20;
```

```sql
--Description: Aggregate to the state level – total vulnerable wholesale, manufacturing & combined,   
--and order by combined vulnerable workers (highest first).  
--(This is the final roll-up that answers the business question.)
SELECT
    s."state"                                             AS "state_name",
    SUM(0.38 * e."employed_wholesale_trade")  AS "vul_wholesale_trade",
    SUM(0.41 * e."employed_manufacturing")    AS "vul_manufacturing",
    SUM(0.38 * e."employed_wholesale_trade")
      + SUM(0.41 * e."employed_manufacturing") AS "total_vulnerable_workers"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" e
JOIN "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS"  s
  ON s."fips" = SUBSTR(e."geo_id", 1, 2)::NUMBER
GROUP BY s."state"
ORDER BY "total_vulnerable_workers" DESC
LIMIT 20;
```
