    TABLE_NAME,
    COLUMN_NAME
FROM "CENSUS_BUREAU_ACS_2".INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'CENSUS_BUREAU_ACS'
  AND TABLE_NAME IN ('ZIP_CODES_2015_5YR', 'ZIP_CODES_2018_5YR')
