FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" e
JOIN (
        SELECT 
            a."geo_id",
            b."median_household_income" - a."median_household_income" AS "mhi_change"
        FROM (
                SELECT "geo_id", "median_household_income"
                FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR"
             ) a
        JOIN (
                SELECT "geo_id", "median_household_income"
                FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"
             ) b
          ON a."geo_id" = b."geo_id"
     ) z
  ON z."geo_id" = e."geo_id"
LIMIT 20;
```

```sql
--Description: Map ZIPs to state FIPS (first two digits of quoted “geo_id”) and show distinct pairs.
SELECT DISTINCT
    s."state",
    SUBSTR(z."geo_id", 1, 2)::NUMBER AS "state_fips"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" z
JOIN "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS" s
  ON s."fips" = SUBSTR(z."geo_id", 1, 2)::NUMBER
LIMIT 20;
```

```sql
--Description: Aggregate vulnerable-worker totals by state, quoting “geo_id” in SUBSTR.
SELECT
    s."state"                                            AS "state_name",
    SUM(0.38 * e."employed_wholesale_trade") AS "vul_wholesale_trade",
    SUM(0.41 * e."employed_manufacturing")   AS "vul_manufacturing",
    SUM(0.38 * e."employed_wholesale_trade") +
    SUM(0.41 * e."employed_manufacturing")   AS "total_vulnerable_workers"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" e
JOIN "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS" s
  ON s."fips" = SUBSTR(e."geo_id", 1, 2)::NUMBER
GROUP BY s."state"
ORDER BY "total_vulnerable_workers" DESC
LIMIT 20;
```
