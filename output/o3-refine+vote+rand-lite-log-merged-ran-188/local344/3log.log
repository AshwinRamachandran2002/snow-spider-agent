```sql
-- Description: Show races that definitely have pit-stop information by matching races_ext
-- with at least one record in pit_stops.  Gives us the pool of races we can study.
SELECT DISTINCT r."race_id", r."year", r."round", r."short_name"
FROM "races_ext" AS r
JOIN "pit_stops" AS p
  ON p."race_id" = r."race_id"
LIMIT 20;
```

```sql
-- Description: Discover every label that appears in lap_positions.lap_type
-- (e.g. “Race”, “Starting Position – Grid Drop”, etc.).
SELECT DISTINCT "lap_type"
FROM "lap_positions"
LIMIT 20;
```

```sql
-- Description: List the official finish / retirement / disqualification texts
-- that can be referenced when filtering out cars that left the race.
SELECT DISTINCT "status_id", "status"
FROM "status"
LIMIT 20;
```

```sql
-- Description: Look at some retirement rows to understand how the
-- retirement_type text is stored and which lap it happened on.
SELECT DISTINCT "race_id", "driver_id", "lap", "retirement_type"
FROM "retirements"
LIMIT 20;
```

```sql
-- Description: Examine a sample of pit-stop occurrences to see which lap
-- they happened on and the recorded duration.
SELECT DISTINCT "race_id", "driver_id", "lap", "duration"
FROM "pit_stops"
LIMIT 20;
```

```sql
-- Description: Track one driver’s position evolution during the first
-- laps of race 1 (just as an example of the raw data we will compare).
SELECT DISTINCT "lap", "position"
FROM "lap_positions"
WHERE "race_id" = 1
  AND "driver_id" = 1
ORDER BY "lap"
LIMIT 20;
```

```sql
-- Description: Map driver_id to a readable full name so we can interpret
-- any future overtake lists.
SELECT DISTINCT d."driver_id", dx."full_name"
FROM "drivers"      AS d
JOIN "drivers_ext"  AS dx
  ON dx."driver_id" = d."driver_id"
LIMIT 20;
```

```sql
-- Description: Compare the same lap positions of two drivers in race 1 to
-- spot when one is ahead of the other (basis for on-track overtakes).
SELECT DISTINCT lp1."lap"   AS "current_lap",
                lp1."position" AS "driver1_pos",
                lp2."position" AS "driver2_pos"
FROM "lap_positions" AS lp1
JOIN "lap_positions" AS lp2
  ON lp1."race_id" = lp2."race_id"
 AND lp1."lap"     = lp2."lap"
WHERE lp1."race_id"  = 1
  AND lp1."driver_id" = 1   -- driver 1
  AND lp2."driver_id" = 2   -- driver 2
LIMIT 20;
```

```sql
-- Description: Find all laps where a driver’s position became worse than on
-- the previous lap – a crude list of “somebody passed him”.
SELECT DISTINCT cur."race_id",
                cur."driver_id",
                cur."lap"      AS "current_lap",
                prev."position" AS "prev_pos",
                cur."position"  AS "cur_pos"
FROM "lap_positions" AS cur
JOIN "lap_positions" AS prev
  ON prev."race_id"   = cur."race_id"
 AND prev."driver_id" = cur."driver_id"
 AND prev."lap"       = cur."lap" - 1
WHERE cur."position" > prev."position"
LIMIT 20;
```

```sql
-- Description: Count how many position records (not yet filtered for
-- genuine overtakes) fall under each lap_type category.
SELECT DISTINCT "lap_type", COUNT(*) AS "position_records"
FROM "lap_positions"
GROUP BY "lap_type"
LIMIT 20;
```

