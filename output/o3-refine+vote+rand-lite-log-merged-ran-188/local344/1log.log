Below is a possible sequence of (at most) ten SQLite queries – from very simple inspection queries to a final aggregation – that can be used to count the number of Formula 1 overtakes of each “type” (race-start, on-track, pit-entry, pit-exit, retirement) in all races for which pit-stop data exist.

```sql
-- 1) Races that have at least one recorded pit-stop ( = races we will analyse )
SELECT DISTINCT ps."race_id", r."year", r."round", r."name"
FROM "pit_stops"  AS ps
JOIN "races"      AS r  USING("race_id")
LIMIT 20;
```

```sql
-- 2) Lap-by-lap positions for one sample race (choose any race_id from query-1)
SELECT *
FROM "lap_positions"
WHERE "race_id" = 1
ORDER BY "lap", "position"
LIMIT 20;
```

```sql
-- 3) Pit-stops for the same sample race (to see the lap column we will use later)
SELECT *
FROM "pit_stops"
WHERE "race_id" = 1
ORDER BY "lap", "driver_id"
LIMIT 20;
```

```sql
-- 4) Retirements for the same race (lap on which the car retired)
SELECT *
FROM "retirements"
WHERE "race_id" = 1
ORDER BY "lap", "driver_id"
LIMIT 20;
```

```sql
-- 5) Driver-by-driver position change between consecutive laps
--    (positive positions_gained  means the driver moved forward)
SELECT  curr."race_id",
        curr."driver_id",
        curr."lap",
        prev."position" AS prev_pos,
        curr."position" AS curr_pos,
        prev."position" - curr."position" AS positions_gained
FROM   "lap_positions" AS curr
JOIN   "lap_positions" AS prev
       ON  curr."race_id"   = prev."race_id"
       AND curr."driver_id" = prev."driver_id"
       AND curr."lap"       = prev."lap" + 1
WHERE  curr."race_id" IN (SELECT DISTINCT "race_id" FROM "pit_stops")
ORDER  BY curr."race_id", curr."driver_id", curr."lap"
LIMIT 20;
```

```sql
-- 6) Every individual pass (one row per position gained) produced
--    with a recursive “tally” CTE so that a +3 jump becomes 3 rows.
WITH pos_change AS (
        SELECT  curr."race_id",
                curr."driver_id",
                curr."lap",
                prev."position" - curr."position" AS positions_gained
        FROM   "lap_positions" AS curr
        JOIN   "lap_positions" AS prev
               ON  curr."race_id"   = prev."race_id"
               AND curr."driver_id" = prev."driver_id"
               AND curr."lap"       = prev."lap" + 1
        WHERE  curr."race_id" IN (SELECT DISTINCT "race_id" FROM "pit_stops")
          AND  (prev."position" - curr."position") > 0          -- driver moved forward
), tally(n) AS (
        SELECT 1
        UNION ALL
        SELECT n + 1 FROM tally WHERE n < 50                    -- 50 is safely > max grid
), individual_passes AS (
        SELECT pc."race_id",
               pc."driver_id"      AS overtaker_id,
               pc."lap",
               tp.n                AS pass_no                   -- 1 … positions_gained
        FROM   pos_change pc
        JOIN   tally      tp
               ON tp.n <= pc.positions_gained
)
SELECT * FROM individual_passes
LIMIT 20;
```

```sql
-- 7) Identify the car that has just been overtaken on each lap-pass
WITH individual_passes AS ( …same CTE block from query-6… ),
overtaken AS (
        /*  Driver whose position number became *worse* by exactly one
            on this lap (loses one place = got passed once).           */
        SELECT  curr."race_id",
                curr."driver_id"   AS overtaken_id,
                curr."lap"
        FROM   "lap_positions" AS curr
        JOIN   "lap_positions" AS prev
               ON  curr."race_id"   = prev."race_id"
               AND curr."driver_id" = prev."driver_id"
               AND curr."lap"       = prev."lap" + 1
        WHERE  curr."position" - prev."position" = 1
)
SELECT ip."race_id",
       ip."lap",
       ip."overtaker_id",
       o."overtaken_id"
FROM   individual_passes  AS ip
JOIN   overtaken          AS o
       ON  o."race_id" = ip."race_id"
       AND o."lap"     = ip."lap"
LIMIT 20;
```

```sql
-- 8) Classify each pass according to *why* the order changed
WITH individual_passes AS ( …same CTE block from query-6… ),
overtaken AS (        …same block from query-7…                 ),
pass_pairs AS (
        SELECT ip."race_id",
               ip."lap",
               ip."overtaker_id",
               o."overtaken_id"
        FROM   individual_passes ip
        JOIN   overtaken       o
               ON  o."race_id" = ip."race_id"
               AND o."lap"     = ip."lap"
), pass_types AS (
        SELECT pp.*,
               CASE
                   WHEN pp."lap" = 1
                        THEN 'race_start'                       -- Grid start
                   WHEN EXISTS (SELECT 1
                                 FROM "retirements" r
                                 WHERE r."race_id" = pp."race_id"
                                   AND r."driver_id" = pp."overtaken_id"
                                   AND r."lap"       = pp."lap")
                        THEN 'retirement'                       -- Overtaken car retired
                   WHEN EXISTS (SELECT 1
                                 FROM "pit_stops" ps
                                 WHERE ps."race_id" = pp."race_id"
                                   AND ps."driver_id" = pp."overtaken_id"
                                   AND ps."lap"       = pp."lap")
                        THEN 'pit_entry'                        -- Passed when rival *entered* pits
                   WHEN EXISTS (SELECT 1
                                 FROM "pit_stops" ps
                                 WHERE ps."race_id" = pp."race_id"
                                   AND ps."driver_id" = pp."overtaker_id"
                                   AND ps."lap"       = pp."lap")
                        THEN 'pit_exit'                         -- Passed just after own pit exit
                   ELSE 'on_track'                              -- Conventional on-track pass
               END AS overtake_type
        FROM  pass_pairs pp
)
SELECT * FROM pass_types
LIMIT 20;
```

```sql
-- 9) How many times each type of overtake happened (raw counts)
WITH individual_passes AS ( …same CTE block from query-6… ),
overtaken         AS ( …same from query-7… ),
pass_pairs        AS ( …same from query-8… ),
pass_types        AS ( …same from query-8… )
SELECT  overtake_type,
        COUNT(*)  AS num_overtakes
FROM    pass_types
GROUP BY overtake_type
ORDER BY num_overtakes DESC;
```

```sql
-- 10) The final answer, including percentage share of all analysed passes
WITH individual_passes AS ( …same CTE block from query-6… ),
overtaken         AS ( …same from query-7… ),
pass_pairs        AS ( …same from query-8… ),
pass_types        AS ( …same from query-8… ),
totals AS (
        SELECT COUNT(*) AS total_passes
        FROM   pass_types
)
SELECT  pt."overtake_type",
        COUNT(*)                                     AS num_overtakes,
        ROUND(100.0 * COUNT(*) / t.total_passes, 2) AS percentage_of_all
FROM    pass_types pt
CROSS JOIN totals  t
GROUP  BY pt."overtake_type"
ORDER  BY num_overtakes DESC;
```

Each successive query builds on the previous ones, finishing with a single statement (query 10) that returns how many overtakes of each type have ever occurred – exactly what is requested in the task.
