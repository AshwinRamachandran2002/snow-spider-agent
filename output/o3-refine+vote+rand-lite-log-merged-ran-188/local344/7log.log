FROM   "races_ext"
LIMIT 20;
```

```sql
--Description: List a few races for which detailed pit–stop data is flagged as available  
SELECT DISTINCT "race_id",
                "year",
                "round",
                "short_name"
FROM   "races_ext"
WHERE  "is_pit_data_available" = 1
LIMIT 20;
```

```sql
--Description: Look at some raw lap-by-lap positions (and their lap_type) for races with pit data  
SELECT "race_id",
       "driver_id",
       "lap",
       "position",
       "lap_type"
FROM   "lap_positions"
WHERE  "race_id" IN (SELECT "race_id"
                     FROM   "races_ext"
                     WHERE  "is_pit_data_available" = 1)
LIMIT 20;
```

```sql
--Description: Inspect pit-stop events for the same subset of races  
SELECT "race_id",
       "driver_id",
       "lap",
       "stop",
       "duration",
       "milliseconds"
FROM   "pit_stops"
WHERE  "race_id" IN (SELECT "race_id"
                     FROM   "races_ext"
                     WHERE  "is_pit_data_available" = 1)
LIMIT 20;
```

```sql
--Description: Inspect retirements that occurred in those races  
SELECT "race_id",
       "driver_id",
       "lap",
       "status_id",
       "retirement_type"
FROM   "retirements"
WHERE  "race_id" IN (SELECT "race_id"
                     FROM   "races_ext"
                     WHERE  "is_pit_data_available" = 1)
LIMIT 20;
```

```sql
--Description: For every driver, show how their position changed from the previous lap  
SELECT "race_id",
       "driver_id",
       "lap",
       "position",
       LAG("position") OVER (PARTITION BY "race_id","driver_id"
                             ORDER BY "lap") AS "prev_position"
FROM   "lap_positions"
WHERE  "race_id" IN (SELECT "race_id"
                     FROM   "races_ext"
                     WHERE  "is_pit_data_available" = 1)
LIMIT 20;
```

```sql
--Description: Display laps where a driver lost places (= someone overtook them)  
SELECT "race_id",
       "driver_id",
       "lap",
       "position",
       "prev_position",
       ("position"-"prev_position") AS "places_lost"
FROM (
      SELECT "race_id",
             "driver_id",
             "lap",
             "position",
             LAG("position") OVER (PARTITION BY "race_id","driver_id"
                                   ORDER BY "lap") AS "prev_position"
      FROM   "lap_positions"
      WHERE  "race_id" IN (SELECT "race_id"
                           FROM   "races_ext"
                           WHERE  "is_pit_data_available" = 1)
) 
WHERE  "prev_position" IS NOT NULL
  AND  "position" > "prev_position"
LIMIT 20;
```

```sql
--Description: Classify each position-loss event into an overtake type; show a sample  
SELECT "race_id",
       "driver_id",
       "lap",
       "position",
       "prev_position",
       ("position"-"prev_position") AS "overtakes",
       CASE
           WHEN "prev_lap_type" LIKE '%Starting%'          THEN 'Race start'
           WHEN "prev_lap_type" LIKE '%Pit Entry%'         THEN 'Pit entry'
           WHEN "lap_type"      LIKE '%Pit Exit%'          THEN 'Pit exit'
           WHEN "lap_type"      LIKE '%Retirement%' 
             OR "prev_lap_type" LIKE '%Retirement%'       THEN 'Retirement'
           ELSE                                             'On track'
       END                                                AS "overtake_type"
FROM (
      SELECT lp."race_id",
             lp."driver_id",
             lp."lap",
             lp."position",
             lp."lap_type",
             LAG(lp."position")   OVER (PARTITION BY lp."race_id",lp."driver_id"
                                        ORDER BY lp."lap")      AS "prev_position",
             LAG(lp."lap_type")   OVER (PARTITION BY lp."race_id",lp."driver_id"
                                        ORDER BY lp."lap")      AS "prev_lap_type"
      FROM   "lap_positions"  lp
      JOIN   "races_ext"      re ON re."race_id" = lp."race_id"
      WHERE  re."is_pit_data_available" = 1
) 
WHERE  "prev_position" IS NOT NULL
  AND  "position" > "prev_position"
LIMIT 20;
```

```sql
--Description: Final aggregation – total number of overtakes of each type in all
--             Formula 1 races that have pit-stop data  
SELECT "overtake_type",
       SUM("overtakes") AS "total_overtakes"
FROM (
      SELECT ("position"-"prev_position") AS "overtakes",
             CASE
                 WHEN "prev_lap_type" LIKE '%Starting%'          THEN 'Race start'
                 WHEN "prev_lap_type" LIKE '%Pit Entry%'         THEN 'Pit entry'
                 WHEN "lap_type"      LIKE '%Pit Exit%'          THEN 'Pit exit'
                 WHEN "lap_type"      LIKE '%Retirement%' 
                   OR "prev_lap_type" LIKE '%Retirement%'       THEN 'Retirement'
                 ELSE                                             'On track'
             END AS "overtake_type"
      FROM (
            SELECT lp."race_id",
                   lp."driver_id",
                   lp."lap",
                   lp."position",
                   lp."lap_type",
                   LAG(lp."position") OVER (PARTITION BY lp."race_id",lp."driver_id"
                                            ORDER BY lp."lap") AS "prev_position",
                   LAG(lp."lap_type") OVER (PARTITION BY lp."race_id",lp."driver_id"
                                            ORDER BY lp."lap") AS "prev_lap_type"
            FROM   "lap_positions"  lp
            JOIN   "races_ext"      re ON re."race_id" = lp."race_id"
            WHERE  re."is_pit_data_available" = 1
      )
      WHERE  "prev_position" IS NOT NULL
        AND  "position" > "prev_position"
)
GROUP BY "overtake_type";
```
