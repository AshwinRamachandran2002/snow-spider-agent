```sql
-- 1. Description: Which races already have pit stop information recorded?
SELECT DISTINCT "race_id", "year", "round", "name"
FROM "races_ext"
WHERE "is_pit_data_available" = 1
LIMIT 20;
```

```sql
-- 2. Description: What different “lap_type” values exist in the lap-by-lap position data?
SELECT DISTINCT "lap_type"
FROM "lap_positions"
LIMIT 20;
```

```sql
-- 3. Description: Show the first 20 position traces (one row per driver-lap) for the
--    very first race that contains pit data.
SELECT lp.*
FROM   "lap_positions" AS lp
JOIN   (SELECT "race_id"
        FROM   "races_ext"
        WHERE  "is_pit_data_available" = 1
        LIMIT  1) AS r
        ON lp."race_id" = r."race_id"
ORDER  BY lp."lap", lp."position"
LIMIT  20;
```

```sql
-- 4. Description: Pit-stop events for that same race (lap on which the car ENTERS the pit lane).
SELECT ps."race_id",
       ps."driver_id",
       ps."lap"        AS "pit_in_lap",
       ps."stop",
       ps."duration"
FROM   "pit_stops" AS ps
WHERE  ps."race_id" IN (SELECT "race_id"
                        FROM   "races_ext"
                        WHERE  "is_pit_data_available" = 1
                        LIMIT  1)
ORDER  BY ps."lap", ps."driver_id"
LIMIT  20;
```

```sql
-- 5. Description: Drivers that retired in that same race (with the textual reason).
SELECT rt."race_id",
       rt."driver_id",
       rt."lap"         AS "ret_lap",
       st."status"
FROM   "retirements"  AS rt
JOIN   "status"       AS st
       ON st."status_id" = rt."status_id"
WHERE  rt."race_id" IN (SELECT "race_id"
                        FROM   "races_ext"
                        WHERE  "is_pit_data_available" = 1
                        LIMIT  1)
ORDER  BY rt."lap"
LIMIT  20;
```

```sql
-- 6. Description: Grid order (lap = 0) for that race – useful as “previous-lap” context
--    when analysing overtakes on lap 1.
SELECT lp."race_id",
       lp."driver_id",
       lp."position"
FROM   "lap_positions" AS lp
WHERE  lp."lap"      = 0
AND    lp."race_id" IN (SELECT "race_id"
                        FROM   "races_ext"
                        WHERE  "is_pit_data_available" = 1
                        LIMIT  1)
ORDER  BY lp."position"
LIMIT  20;
```

```sql
-- 7. Description: Example of *on-track* position swaps between successive laps that are
--    NOT explained by a pit-stop or retirement on the current lap.
--    (This shows potential baseline “normal” overtakes.)
SELECT DISTINCT lp_curr."race_id",
       lp_curr."lap"                                       AS "current_lap",
       lp_curr."driver_id"                                 AS "driver",
       lp_prev."position"      AS "pos_prev",
       lp_curr."position"      AS "pos_curr"
FROM   "lap_positions" AS lp_curr
JOIN   "lap_positions" AS lp_prev
       ON  lp_curr."race_id" = lp_prev."race_id"
       AND lp_curr."driver_id" = lp_prev."driver_id"
       AND lp_curr."lap"  = lp_prev."lap" + 1            -- successive laps
LEFT  JOIN "pit_stops" AS ps
       ON  ps."race_id" = lp_curr."race_id"
       AND ps."driver_id" = lp_curr."driver_id"
       AND ps."lap"      = lp_curr."lap"                 -- pit-in on current lap
LEFT  JOIN "retirements" AS rt
       ON  rt."race_id" = lp_curr."race_id"
       AND rt."driver_id" = lp_curr."driver_id"
       AND rt."lap"      = lp_curr."lap"                 -- retirement on current lap
WHERE  lp_prev."position" > lp_curr."position"           -- driver moved forward
AND    ps."driver_id" IS NULL                            -- not pitting-in now
AND    rt."driver_id" IS NULL                            -- not retiring now
AND    lp_curr."race_id" IN (SELECT "race_id"
                             FROM   "races_ext"
                             WHERE  "is_pit_data_available" = 1
                             LIMIT  1)
LIMIT  20;
```

```sql
-- 8. Description: Possible “pit-exit” overtakes – driver gains positions on the lap
--    AFTER he exits the pit lane (pit stop on previous lap, gain on current lap).
SELECT DISTINCT lp_next."race_id",
       lp_next."driver_id",
       ps."lap"                         AS "pit_in_lap",
       lp_prev."position"               AS "pos_before_pit",
       lp_next."position"               AS "pos_after_pit"
FROM   "pit_stops"     AS ps
JOIN   "lap_positions" AS lp_prev
       ON lp_prev."race_id"  = ps."race_id"
       AND lp_prev."driver_id" = ps."driver_id"
       AND lp_prev."lap"     = ps."lap" - 1              -- lap before pit-in
JOIN   "lap_positions" AS lp_next
       ON lp_next."race_id"  = ps."race_id"
       AND lp_next."driver_id" = ps."driver_id"
       AND lp_next."lap"     = ps."lap" + 1              -- lap after pit-exit
WHERE  lp_prev."position" > lp_next."position"           -- driver moved forward
AND    ps."race_id" IN (SELECT "race_id"
                        FROM   "races_ext"
                        WHERE  "is_pit_data_available" = 1
                        LIMIT  1)
LIMIT  20;
```

```sql
-- 9. Description: Possible “undercut” / “overcut” overtakes – the *other* driver pits
--    and this driver leap-frogs him without stopping himself.
SELECT DISTINCT lp_curr."race_id",
       lp_curr."lap",
       lp_curr."driver_id"             AS "beneficiary",
       ps."driver_id"                  AS "pitting_driver"
FROM   "pit_stops"     AS ps
JOIN   "lap_positions" AS lp_prev
       ON lp_prev."race_id"   = ps."race_id"
       AND lp_prev."lap"      = ps."lap" - 1
JOIN   "lap_positions" AS lp_curr
       ON lp_curr."race_id"   = ps."race_id"
       AND lp_curr."driver_id" = lp_prev."driver_id"
       AND lp_curr."lap"      = ps."lap"               -- same lap as rival pits
WHERE  lp_prev."position" > lp_curr."position"         -- beneficiary moves forward
AND    ps."race_id" IN (SELECT "race_id"
                        FROM   "races_ext"
                        WHERE  "is_pit_data_available" = 1
                        LIMIT  1)
LIMIT  20;
```

```sql
-- 10. Description: Overtakes created by a retirement on the current lap –
--     every driver behind the retiring car moves forward.
SELECT DISTINCT lp_curr."race_id",
       lp_curr."lap",
       rt."driver_id"            AS "retiring_driver",
       lp_curr."driver_id"       AS "gaining_driver"
FROM   "retirements"  AS rt
JOIN   "lap_positions" AS lp_prev
       ON lp_prev."race_id" = rt."race_id"
       AND lp_prev."lap"    = rt."lap" - 1
JOIN   "lap_positions" AS lp_curr
       ON lp_curr."race_id" = rt."race_id"
       AND lp_curr."lap"    = rt."lap"
       AND lp_curr."driver_id" = lp_prev."driver_id"
WHERE  lp_prev."position" > lp_curr."position"         -- moved ahead
AND    rt."race_id" IN (SELECT "race_id"
                        FROM   "races_ext"
                        WHERE  "is_pit_data_available" = 1
                        LIMIT  1)
LIMIT  20;
```

These ten exploratory queries examine races with usable pit-stop information, classify lap records, and sample the different mechanisms (normal racing passes, pit-entry/exit exchanges, and retirements) that together form the foundation for counting each “type” of Formula 1 overtake described in the task.
