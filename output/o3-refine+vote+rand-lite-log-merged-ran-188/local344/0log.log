Successfully corrected. SQL:
--Description:
-- Identify potential on-track overtakes in the first 2011 race with pit-stop data
-- (race_id = 841).  For every pair of drivers A (overtaker) and B (overtaken),
-- we check two consecutive laps L and L+1:
--   • On lap L  : A is BEHIND B  (position number larger → further back)
--   • On lap L+1: A is AHEAD of B (position number smaller → moved forward)
-- No pit-stop or retirement filters are applied here; the aim is to obtain a
-- broad list of raw position swaps that can later be categorised.
-- The output shows the race_id, lap on which the pass is first visible (L+1),
-- the two drivers involved, and their positions before and after the swap.

SELECT
    lpA_curr."race_id",
    lpA_curr."lap"                    AS "lap_of_swap",
    lpA_prev."driver_id"              AS "overtaker_driver_id",
    lpB_prev."driver_id"              AS "overtaken_driver_id",
    lpA_prev."position"               AS "A_pos_lap_L",
    lpB_prev."position"               AS "B_pos_lap_L",
    lpA_curr."position"               AS "A_pos_lap_Lplus1",
    lpB_curr."position"               AS "B_pos_lap_Lplus1"
FROM   "lap_positions" AS lpA_prev                           -- driver A on lap L
JOIN   "lap_positions" AS lpA_curr                           -- driver A on lap L+1
       ON lpA_curr."race_id" = lpA_prev."race_id"
      AND lpA_curr."driver_id" = lpA_prev."driver_id"
      AND lpA_curr."lap" = lpA_prev."lap" + 1
JOIN   "lap_positions" AS lpB_prev                           -- driver B on lap L
       ON lpB_prev."race_id" = lpA_prev."race_id"
      AND lpB_prev."lap"      = lpA_prev."lap"
JOIN   "lap_positions" AS lpB_curr                           -- driver B on lap L+1
       ON lpB_curr."race_id" = lpB_prev."race_id"
      AND lpB_curr."driver_id" = lpB_prev."driver_id"
      AND lpB_curr."lap" = lpB_prev."lap" + 1
WHERE  lpA_prev."race_id" = 841                              -- first pit-data race
  AND  lpA_prev."lap_type" = 'Race'
  AND  lpA_curr."lap_type" = 'Race'
  AND  lpB_prev."lap_type" = 'Race'
  AND  lpB_curr."lap_type" = 'Race'
  -- A is behind B on lap L …
  AND  lpA_prev."position" > lpB_prev."position"
  -- … but ahead on lap L+1 (swap detected)
  AND  lpA_curr."position" < lpB_curr."position"
ORDER BY lpA_curr."lap", lpA_prev."driver_id", lpB_prev."driver_id"
LIMIT 20;
