--Description:
-- Examine position changes triggered by a retirement in the first 2011 race (race_id = 841).
-- For each retirement event (driver R) on lap L, show how every *other* driver D’s
-- position changed between lap L-1 and lap L.   
-- The pos_change column (negative = places gained by D, positive = lost) helps spot
-- overtakes that occurred purely because R left the race.
SELECT
    rt."race_id",
    rt."lap"                          AS "retirement_lap",
    rt."driver_id"                    AS "retiring_driver_id",
    lp_prev."driver_id"               AS "affected_driver_id",
    lp_prev."position"                AS "pos_before_retirement",
    lp_curr."position"                AS "pos_after_retirement",
    (lp_curr."position" - lp_prev."position") AS "pos_change"
FROM   "retirements"  AS rt
JOIN   "lap_positions" AS lp_prev
       ON lp_prev."race_id" = rt."race_id"
      AND lp_prev."lap"    = rt."lap" - 1          -- lap before retirement
JOIN   "lap_positions" AS lp_curr
       ON lp_curr."race_id" = rt."race_id"
      AND lp_curr."driver_id" = lp_prev."driver_id"
      AND lp_curr."lap"    = rt."lap"              -- same lap as retirement
WHERE  rt."race_id" = 841
  AND  lp_prev."driver_id" <> rt."driver_id"       -- exclude the retiring driver
ORDER  BY rt."lap", lp_prev."driver_id"
LIMIT  20
