Query:
--Description: FINAL ANSWER — return the latest approval date for every molecule
--(trade name) where the applicant name contains both “sanofi” and “aventis”.
SELECT
  trade_name,
  MAX(approval_date) AS latest_approval_date
FROM `bigquery-public-data.ebi_chembl.products_23`
WHERE LOWER(applicant_full_name) LIKE '%sanofi%'
  AND LOWER(applicant_full_name) LIKE '%aventis%'
GROUP BY trade_name
ORDER BY latest_approval_date DESC, trade_name
LIMIT 20
