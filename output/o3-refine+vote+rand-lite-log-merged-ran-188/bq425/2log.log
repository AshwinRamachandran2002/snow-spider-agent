```sql
--Description:  To retrieve every molecule whose FDA application was filed by a company
--whose name includes both “Sanofi” and “Aventis”, we (1) limit the search to
--ChEMBL Release 23 (`products_23`), (2) apply case-insensitive filters that
--require the two words to be present in the `applicant_full_name`, and (3) use
--MAX() to keep only the most recent approval date for each molecule (`trade_name`).
--The approval_date column is stored as text, so we convert it to a true DATE in
--order to compare values correctly when taking the maximum.
SELECT
  trade_name,
  MAX(PARSE_DATE('%Y-%m-%d', approval_date)) AS latest_approval_date
FROM `bigquery-public-data.ebi_chembl.products_23`
WHERE LOWER(applicant_full_name) LIKE '%sanofi%'   -- contains “sanofi”
  AND LOWER(applicant_full_name) LIKE '%aventis%'  -- contains “aventis”
GROUP BY trade_name
ORDER BY trade_name;
```
