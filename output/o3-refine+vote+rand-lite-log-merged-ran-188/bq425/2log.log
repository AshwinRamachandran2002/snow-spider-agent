Query:
--Description: 9. Show both the raw text date and its parsed version side-by-side for validation.
SELECT
  trade_name,
  approval_date AS approval_date_raw,
  PARSE_DATE('%Y-%m-%d', approval_date) AS approval_dt_parsed
FROM `bigquery-public-data.ebi_chembl.products_23`
