--Description: 6. Convert the textual approval_date into a DATE object for proper ordering.
SELECT
  trade_name,
  PARSE_DATE('%Y-%m-%d', approval_date) AS approval_dt
FROM `bigquery-public-data.ebi_chembl.products_23`
WHERE LOWER(applicant_full_name) LIKE '%sanofi%'
  AND LOWER(applicant_full_name) LIKE '%aventis%'
