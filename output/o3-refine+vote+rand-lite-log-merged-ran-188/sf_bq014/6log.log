```sql
--Description: 5) For every shopper pull the first order_id that contains at least one non-cancelled/non-returned item
WITH clean_items AS (
    SELECT "user_id",
           "order_id",
           MIN("created_at") AS "first_item_ts"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
    WHERE "status" NOT ILIKE '%cancel%'
      AND "returned_at" IS NULL
    GROUP BY "user_id", "order_id"
), ranked AS (
    SELECT "user_id",
           "order_id",
           ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "first_item_ts") AS "rn"
    FROM clean_items
)
SELECT *
FROM ranked
WHERE "rn" = 1
LIMIT 20;
```

```sql
--Description: 6) Bring the products that appear in those first orders
WITH first_orders AS (
    /* previous CTE repeated for clarity */
    WITH clean_items AS (
        SELECT "user_id",
               "order_id",
               MIN("created_at") AS "first_item_ts"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
        WHERE "status" NOT ILIKE '%cancel%'
          AND "returned_at" IS NULL
        GROUP BY "user_id", "order_id"
    ), ranked AS (
        SELECT "user_id",
               "order_id",
               ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "first_item_ts") AS "rn"
        FROM clean_items
    )
    SELECT "user_id", "order_id"
    FROM ranked
    WHERE "rn" = 1
)
SELECT oi."user_id",
       oi."order_id",
       oi."product_id",
       p."category"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
JOIN first_orders fo
  ON fo."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
  ON p."id" = oi."product_id"
WHERE oi."status" NOT ILIKE '%cancel%'
  AND oi."returned_at" IS NULL
LIMIT 20;
```

```sql
--Description: 7) Count unique shoppers (customers) by product category in their first qualifying order
WITH first_orders_products AS (
    /* borrow CTE from #6 */
    WITH clean_items AS (
        SELECT "user_id", "order_id", MIN("created_at") AS "first_item_ts"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
        WHERE "status" NOT ILIKE '%cancel%'
          AND "returned_at" IS NULL
        GROUP BY "user_id", "order_id"
    ), ranked AS (
        SELECT "user_id", "order_id",
               ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "first_item_ts") AS "rn"
        FROM clean_items
    )
    SELECT r."user_id", r."order_id"
    FROM ranked r
    WHERE r."rn" = 1
)
SELECT p."category",
       COUNT(DISTINCT oi."user_id") AS "customer_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
JOIN first_orders_products fop
  ON fop."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
  ON p."id" = oi."product_id"
WHERE oi."status" NOT ILIKE '%cancel%'
  AND oi."returned_at" IS NULL
GROUP BY p."category"
ORDER BY "customer_cnt" DESC
LIMIT 20;
```

```sql
--Description: 8) Identify which category tops the list (same query, but ranked)
WITH category_counts AS (
    /* reuse logic from #7 */
    WITH first_orders_products AS (
        WITH clean_items AS (
            SELECT "user_id", "order_id", MIN("created_at") AS "first_item_ts"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
            WHERE "status" NOT ILIKE '%cancel%'
              AND "returned_at" IS NULL
            GROUP BY "user_id", "order_id"
        ), ranked AS (
            SELECT "user_id", "order_id",
                   ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "first_item_ts") AS "rn"
            FROM clean_items
        )
        SELECT "user_id", "order_id"
        FROM ranked
        WHERE "rn" = 1
    )
    SELECT p."category",
           COUNT(DISTINCT oi."user_id") AS "customer_cnt"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
    JOIN first_orders_products fop
      ON fop."order_id" = oi."order_id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
      ON p."id" = oi."product_id"
    WHERE oi."status" NOT ILIKE '%cancel%'
      AND oi."returned_at" IS NULL
    GROUP BY p."category"
)
SELECT *,
       RANK() OVER (ORDER BY "customer_cnt" DESC) AS "rk"
FROM category_counts
ORDER BY "rk"
LIMIT 20;
```

```sql
--Description: 9) For every category compute total revenue (sale_price) in those first orders
WITH first_orders_products AS (
    /* same first-order logic */
    WITH clean_items AS (
        SELECT "user_id", "order_id", MIN("created_at") AS "first_item_ts"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
        WHERE "status" NOT ILIKE '%cancel%'
          AND "returned_at" IS NULL
        GROUP BY "user_id", "order_id"
    ), ranked AS (
        SELECT "user_id", "order_id",
               ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "first_item_ts") AS "rn"
        FROM clean_items
    )
    SELECT "user_id", "order_id"
    FROM ranked
    WHERE "rn" = 1
)
SELECT p."category",
       SUM(oi."sale_price") AS "revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
JOIN first_orders_products fop
  ON fop."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
  ON p."id" = oi."product_id"
WHERE oi."status" NOT ILIKE '%cancel%'
  AND oi."returned_at" IS NULL
GROUP BY p."category"
ORDER BY "revenue" DESC
LIMIT 20;
```

```sql
--Description: 10) One-shot query: grab the category with the most first-time customers and return its total revenue
WITH first_orders AS (
    WITH clean_items AS (
        SELECT "user_id", "order_id", MIN("created_at") AS "first_item_ts"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
        WHERE "status" NOT ILIKE '%cancel%'
          AND "returned_at" IS NULL
        GROUP BY "user_id", "order_id"
    ), ranked AS (
        SELECT "user_id", "order_id",
               ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "first_item_ts") AS "rn"
        FROM clean_items
    )
    SELECT "user_id", "order_id"
    FROM ranked
    WHERE "rn" = 1
), category_stats AS (
    SELECT p."category",
           COUNT(DISTINCT oi."user_id") AS "customer_cnt",
           SUM(oi."sale_price")       AS "revenue"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
    JOIN first_orders fo
      ON fo."order_id" = oi."order_id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
      ON p."id" = oi."product_id"
    WHERE oi."status" NOT ILIKE '%cancel%'
      AND oi."returned_at" IS NULL
    GROUP BY p."category"
), ranked AS (
    SELECT *,
           RANK() OVER (ORDER BY "customer_cnt" DESC) AS "rk"
    FROM category_stats
)
SELECT "category",
       "customer_cnt",
       "revenue"
FROM ranked
WHERE "rk" = 1
LIMIT 20;
```
