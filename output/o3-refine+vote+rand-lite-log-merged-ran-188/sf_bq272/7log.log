FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
LIMIT 20;
```

```sql
--Description: Look at some orders and their corresponding items, focusing on records that are NOT cancelled or returned
SELECT oi."order_id",
       oi."status"  AS "item_status",
       o."status"   AS "order_status",
       oi."returned_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
  ON oi."order_id" = o."order_id"
WHERE o."status" NOT ILIKE '%cancel%'
  AND oi."status" NOT ILIKE '%cancel%'
  AND oi."returned_at" IS NULL
LIMIT 20;
```

```sql
--Description: Join ORDER_ITEMS with INVENTORY_ITEMS to calculate profit per individual sale (row-level)
SELECT oi."id"                 AS "order_item_id",
       oi."sale_price",
       ii."cost",
       (oi."sale_price" - ii."cost") AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"   ii
  ON oi."inventory_item_id" = ii."id"
WHERE oi."status"  ILIKE '%complete%'          -- keep examples that look completed
  AND oi."returned_at" IS NULL
LIMIT 20;
```

```sql
--Description: Aggregate monthly profit by product (still raw product_id) for all non-cancelled / non-returned items
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))  AS "order_month",
       oi."product_id",
       SUM(oi."sale_price")                AS "total_revenue",
       SUM(ii."cost")                      AS "total_cost",
       SUM(oi."sale_price" - ii."cost")    AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
  ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
  ON oi."inventory_item_id" = ii."id"
WHERE o."status" NOT ILIKE '%cancel%'
  AND oi."status" NOT ILIKE '%cancel%'
  AND oi."returned_at" IS NULL
GROUP BY 1, 2
LIMIT 20;
```

```sql
--Description: Rank products within each month by profit (top-3 logic using window function)
WITH monthly_profit AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) AS "order_month",
         oi."product_id",
         SUM(oi."sale_price" - ii."cost") AS "profit"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
    ON oi."order_id" = o."order_id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
    ON oi."inventory_item_id" = ii."id"
  WHERE o."status" NOT ILIKE '%cancel%'
    AND oi."status" NOT ILIKE '%cancel%'
    AND oi."returned_at" IS NULL
  GROUP BY 1, 2
)
SELECT *,
       RANK() OVER (PARTITION BY "order_month"
                    ORDER BY "profit" DESC) AS "profit_rank"
FROM monthly_profit
LIMIT 20;
```

```sql
--Description: Bring in product names to see which SKUs are appearing in the top ranks
WITH monthly_profit AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) AS "order_month",
         oi."product_id",
         SUM(oi."sale_price" - ii."cost") AS "profit"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
    ON oi."order_id" = o."order_id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
    ON oi."inventory_item_id" = ii."id"
  WHERE o."status" NOT ILIKE '%cancel%'
    AND oi."status" NOT ILIKE '%cancel%'
    AND oi."returned_at" IS NULL
  GROUP BY 1, 2
),
ranked AS (
  SELECT mp.*,
         RANK() OVER (PARTITION BY mp."order_month"
                      ORDER BY mp."profit" DESC) AS "profit_rank"
  FROM monthly_profit mp
)
SELECT r."order_month",
       p."name"           AS "product_name",
       r."profit",
       r."profit_rank"
FROM ranked r
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
  ON r."product_id" = p."id"
WHERE r."profit_rank" <= 3
LIMIT 20;
```

```sql
--Description: Quick view of what months exist between 2019-01 and 2022-08 that have qualifying sales
SELECT DISTINCT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) AS "order_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
  ON oi."order_id" = o."order_id"
WHERE o."status" NOT ILIKE '%cancel%'
  AND oi."status" NOT ILIKE '%cancel%'
  AND oi."returned_at" IS NULL
  AND DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) BETWEEN '2019-01-01' AND '2022-08-01'
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Full query (still capped at 20 rows) that produces the top-three most profitable products per month from Jan-2019 to Aug-2022
WITH monthly_profit AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) AS "order_month",
         oi."product_id",
         SUM(oi."sale_price" - ii."cost") AS "profit"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
    ON oi."order_id" = o."order_id"
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
    ON oi."inventory_item_id" = ii."id"
  WHERE o."status" NOT ILIKE '%cancel%'
    AND oi."status" NOT ILIKE '%cancel%'
    AND oi."returned_at" IS NULL
    AND DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) BETWEEN '2019-01-01' AND '2022-08-01'
  GROUP BY 1, 2
),
ranked AS (
  SELECT mp.*,
         RANK() OVER (PARTITION BY mp."order_month"
                      ORDER BY mp."profit" DESC) AS "profit_rank"
  FROM monthly_profit mp
)
SELECT r."order_month",
       p."name"                 AS "product_name",
       r."profit",
       r."profit_rank"
FROM ranked r
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
  ON r."product_id" = p."id"
WHERE r."profit_rank" <= 3
ORDER BY r."order_month" DESC, r."profit_rank"
LIMIT 20;
```
