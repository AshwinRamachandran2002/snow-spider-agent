    GROUP BY
        1, 2
),
ranked_profit AS (
    SELECT
        "year_month",
        "product_name",
        "profit",
        ROW_NUMBER() OVER (
            PARTITION BY "year_month"
            ORDER BY "profit" DESC
        ) AS "rnk"
    FROM monthly_product_profit
)
SELECT
