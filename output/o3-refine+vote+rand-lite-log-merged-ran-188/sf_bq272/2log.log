```sql
--Description: 4) Join order-items with products to view sale vs. listed retail price for a sample  
SELECT 
  oi."id"               AS "order_item_id",
  oi."status",
  p."name"              AS "product_name",
  oi."sale_price",
  p."retail_price",
  oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
  ON oi."product_id" = p."id"
LIMIT 20;
```

```sql
--Description: 5) Join order-items with inventory items to compare sale_price and cost (exclude cancelled / returned)
SELECT
  oi."id"                        AS "order_item_id",
  oi."status",
  oi."sale_price",
  ii."cost",
  (oi."sale_price" - ii."cost") AS "profit_sample",
  oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
  ON oi."inventory_item_id" = ii."id"
WHERE oi."status" NOT ILIKE '%cancel%'          -- excludes “Cancelled”
  AND oi."status" NOT ILIKE '%return%'          -- excludes “Returned”
LIMIT 20;
```

```sql
--Description: 6) Aggregate monthly profit for every product in January-2019 (no cancelled/returned)
SELECT
  TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6), 'YYYY-MM') AS "year_month",
  p."name"                                                  AS "product_name",
  SUM(oi."sale_price") - SUM(ii."cost")                     AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
  ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON oi."product_id" = p."id"
WHERE oi."status" NOT ILIKE '%cancel%'
  AND oi."status" NOT ILIKE '%return%'
  AND TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6),'YYYY-MM') = '2019-01'
GROUP BY 1,2
ORDER BY "profit" DESC
LIMIT 20;
```

```sql
--Description: 7) Pick top-3 profitable products for August-2021  
SELECT *
FROM (
    SELECT
      TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6),'YYYY-MM')    AS "year_month",
      p."name"                                                    AS "product_name",
      SUM(oi."sale_price") - SUM(ii."cost")                       AS "profit",
      ROW_NUMBER() OVER (PARTITION BY TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6),'YYYY-MM') 
                         ORDER BY SUM(oi."sale_price") - SUM(ii."cost") DESC) AS "rnk"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
      ON oi."inventory_item_id" = ii."id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
      ON oi."product_id" = p."id"
    WHERE oi."status" NOT ILIKE '%cancel%'
      AND oi."status" NOT ILIKE '%return%'
      AND TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6),'YYYY-MM') = '2021-08'
    GROUP BY 1,2
) 
WHERE "rnk" <= 3
ORDER BY "profit" DESC
LIMIT 20;
```

```sql
--Description: 8) Produce monthly profit for every product from 2019-01 through 2022-08 (no cancelled/returned)
SELECT
  TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6),'YYYY-MM') AS "year_month",
  p."name"                                                 AS "product_name",
  SUM(oi."sale_price") - SUM(ii."cost")                    AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
  ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON oi."product_id" = p."id"
WHERE oi."status" NOT ILIKE '%cancel%'
  AND oi."status" NOT ILIKE '%return%'
  AND TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6),'YYYY-MM') BETWEEN '2019-01' AND '2022-08'
GROUP BY 1,2
ORDER BY "year_month", "profit" DESC
LIMIT 20;
```

```sql
--Description: 9) Identify top-3 products per month (2019-01 ~ 2022-08) using window functions
SELECT *
FROM (
    SELECT
      TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6),'YYYY-MM')     AS "year_month",
      p."name"                                                     AS "product_name",
      SUM(oi."sale_price") - SUM(ii."cost")                        AS "profit",
      ROW_NUMBER() OVER (
          PARTITION BY TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6),'YYYY-MM')
          ORDER BY SUM(oi."sale_price") - SUM(ii."cost") DESC)     AS "rnk"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
      ON oi."inventory_item_id" = ii."id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
      ON oi."product_id" = p."id"
    WHERE oi."status" NOT ILIKE '%cancel%'
      AND oi."status" NOT ILIKE '%return%'
      AND TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6),'YYYY-MM') BETWEEN '2019-01' AND '2022-08'
    GROUP BY 1,2
) 
WHERE "rnk" <= 3
ORDER BY "year_month", "profit" DESC
LIMIT 20;
```

