SELECT "id",
       "order_id",
       "product_id",
       "sale_price",
       "status",
       "created_at"      -- micro-seconds since epoch
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
WHERE  "status" = 'Complete'
LIMIT 20;
```

```sql
-- Description: Inspect the matching inventory rows (where the revenue event actually depleted stock)
SELECT "id"                      AS "inventory_item_id",
       "product_id",
       "cost",
       "sold_at",                -- micro-seconds since epoch
       "product_distribution_center_id"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
WHERE  "sold_at" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Join a few “good” order items with their inventory rows to see
-- sale price versus cost side-by-side
SELECT oi."id"            AS "order_item_id",
       oi."product_id",
       oi."sale_price",
       inv."cost",
       oi."created_at"    AS "order_item_time",
       inv."sold_at"      AS "inventory_sold_time"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" inv
       ON inv."id" = oi."inventory_item_id"
WHERE  oi."status" = 'Complete'
LIMIT 20;
```

```sql
-- Description: Peek at product master data we’ll eventually want for names / departments
SELECT "id",
       "name",
       "brand",
       "category",
       "department",
       "retail_price",
       "distribution_center_id"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
LIMIT 20;
```

```sql
-- Description: Aggregate revenue and cost by product for a single month (e.g., January 2019) just to validate logic
SELECT   DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1e6))   AS "month",
         pr."name"                                                AS "product_name",
         SUM(oi."sale_price")                                     AS "revenue",
         SUM(inv."cost")                                          AS "cost",
         SUM(oi."sale_price") - SUM(inv."cost")                   AS "profit"
FROM     THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"        oi
JOIN     THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"    inv
         ON inv."id" = oi."inventory_item_id"
JOIN     THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"           pr
         ON pr."id" = oi."product_id"
WHERE    oi."status"   = 'Complete'
  AND    oi."returned_at" IS NULL
  AND    DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1e6)) = '2019-01-01'
GROUP BY 1,2
ORDER BY "profit" DESC
LIMIT 20;
```

```sql
-- Description: For one recent month (August 2022) pull the top-3 most profitable products
SELECT   DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1e6))   AS "month",
         pr."name"                                                AS "product_name",
         SUM(oi."sale_price") - SUM(inv."cost")                   AS "profit"
FROM     THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"        oi
JOIN     THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"    inv
         ON inv."id" = oi."inventory_item_id"
JOIN     THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"           pr
         ON pr."id" = oi."product_id"
WHERE    oi."status"   = 'Complete'
  AND    oi."returned_at" IS NULL
  AND    DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1e6)) = '2022-08-01'
GROUP BY 1,2
ORDER BY "profit" DESC
LIMIT 3;
```

```sql
-- Description: Verify that each order item really lines up with the same product in inventory
-- (sanity check: product_id matches on both sides)
SELECT  oi."product_id",
        inv."product_id"      AS "inventory_product_id",
        COUNT(*)              AS "row_cnt"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" inv
        ON inv."id" = oi."inventory_item_id"
WHERE   oi."status" = 'Complete'
GROUP BY 1,2
HAVING  COUNT(*) > 0
LIMIT 20;
```

```sql
-- Description: List monthly profit for a single product to observe fluctuations across the requested window
SELECT   DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1e6))   AS "month",
         pr."name"                                                AS "product_name",
         SUM(oi."sale_price") - SUM(inv."cost")                   AS "profit"
FROM     THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"        oi
JOIN     THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"    inv
         ON inv."id" = oi."inventory_item_id"
JOIN     THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"           pr
         ON pr."id" = oi."product_id"
WHERE    oi."status"   = 'Complete'
  AND    oi."returned_at" IS NULL
  AND    pr."name" ILIKE '%Cap%'        -- example fuzzy search to pick one product
  AND    oi."created_at" BETWEEN 1546300800000000 -- 2019-01-01
                            AND 1661990400000000 -- 2022-09-01
GROUP BY 1,2
ORDER BY "month"
LIMIT 20;
```

```sql
-- Description: (Template) Final-step aggregation that will eventually give the answer for every month
-- The QUALIFY clause keeps only the 3 most profitable products inside each month window.
SELECT   DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1e6))          AS "month",
         pr."name"                                                       AS "product_name",
         SUM(oi."sale_price") - SUM(inv."cost")                          AS "profit"
FROM     THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"               oi
JOIN     THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"           inv
         ON inv."id" = oi."inventory_item_id"
JOIN     THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"                  pr
         ON pr."id" = oi."product_id"
WHERE    oi."status"   = 'Complete'
  AND    oi."returned_at" IS NULL
  AND    DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1e6)) BETWEEN '2019-01-01' AND '2022-08-01'
GROUP BY 1,2
QUALIFY  ROW_NUMBER() OVER (PARTITION BY "month" ORDER BY SUM(oi."sale_price") - SUM(inv."cost") DESC) <= 3
ORDER BY "month", "profit" DESC
LIMIT 20;
```
