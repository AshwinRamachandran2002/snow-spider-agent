```sql
--Description: 1)  Inspect the different life-cycle “status” values that appear in ORDER_ITEMS.  
SELECT DISTINCT "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: 2)  Peek at a few non-cancelled / non-returned order-item rows (the records that will be kept for profit).  
SELECT *
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
WHERE "status" NOT ILIKE '%cancel%'
  AND "returned_at" IS NULL
LIMIT 20;
```

```sql
--Description: 3)  Look at INVENTORY_ITEMS to understand the cost field and the “sold_at” timestamp.  
SELECT "id",
       "product_id",
       "product_distribution_center_id",
       "cost",
       "sold_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
LIMIT 20;
```

```sql
--Description: 4)  Join ORDER_ITEMS to INVENTORY_ITEMS (via inventory_item_id) to see sale price beside cost & timestamps.  
SELECT oi."id"          AS "order_item_id",
       oi."sale_price",
       ii."cost",
       oi."created_at",
       ii."sold_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"    oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
     ON oi."inventory_item_id" = ii."id"
LIMIT 20;
```

```sql
--Description: 5)  Bring in PRODUCTS so we also have each product’s name, category and brand.  
SELECT oi."id"          AS "order_item_id",
       p."name"         AS "product_name",
       p."category",
       p."brand",
       oi."sale_price",
       ii."cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"    oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
     ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
     ON oi."product_id" = p."id"
LIMIT 20;
```

```sql
--Description: 6)  Calculate “profit” for each individual order-item (sale_price – cost).  
SELECT oi."id" AS "order_item_id",
       p."name" AS "product_name",
       oi."sale_price" - ii."cost" AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"    oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
     ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
     ON oi."product_id" = p."id"
WHERE oi."status" NOT ILIKE '%cancel%'
  AND oi."returned_at" IS NULL
LIMIT 20;
```

```sql
--Description: 7)  Roll those profits up by month & product for the whole time period (2019-01 through 2022-08).  
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
       p."id"   AS "product_id",
       p."name" AS "product_name",
       SUM(oi."sale_price") AS "revenue",
       SUM(ii."cost")       AS "cost",
       SUM(oi."sale_price") - SUM(ii."cost") AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"    oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
     ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
     ON oi."product_id" = p."id"
WHERE oi."status" NOT ILIKE '%cancel%'
  AND oi."returned_at" IS NULL
  AND TO_TIMESTAMP(oi."created_at"/1000000) BETWEEN '2019-01-01' AND '2022-08-31'
GROUP BY 1,2,3
ORDER BY "order_month", "profit" DESC
LIMIT 20;
```

```sql
--Description: 8)  Apply a window function to rank products by profit within each month.  
SELECT *
FROM (
      SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
             p."id"   AS "product_id",
             p."name" AS "product_name",
             SUM(oi."sale_price" - ii."cost") AS "profit",
             RANK() OVER (PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))
                          ORDER BY SUM(oi."sale_price" - ii."cost") DESC) AS "profit_rank"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"    oi
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
           ON oi."inventory_item_id" = ii."id"
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
           ON oi."product_id" = p."id"
      WHERE oi."status" NOT ILIKE '%cancel%'
        AND oi."returned_at" IS NULL
        AND TO_TIMESTAMP(oi."created_at"/1000000) BETWEEN '2019-01-01' AND '2022-08-31'
      GROUP BY 1,2,3
     )
WHERE "profit_rank" <= 3
LIMIT 20;
```

```sql
--Description: 9)  Display the final list of the top-3 most profitable products for every month between Jan-2019 and Aug-2022.  
SELECT "order_month",
       "product_name",
       "profit",
       "profit_rank"
FROM (
      SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
             p."name" AS "product_name",
             SUM(oi."sale_price" - ii."cost") AS "profit",
             RANK() OVER (PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))
                          ORDER BY SUM(oi."sale_price" - ii."cost") DESC) AS "profit_rank"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"    oi
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
           ON oi."inventory_item_id" = ii."id"
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
           ON oi."product_id" = p."id"
      WHERE oi."status" NOT ILIKE '%cancel%'
        AND oi."returned_at" IS NULL
        AND TO_TIMESTAMP(oi."created_at"/1000000) BETWEEN '2019-01-01' AND '2022-08-31'
      GROUP BY 1,2
     )
WHERE "profit_rank" <= 3
ORDER BY "order_month", "profit_rank"
LIMIT 20;
```

