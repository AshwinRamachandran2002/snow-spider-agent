```sql
WITH
/* every airport that serves the city Abakan */
abakan_airports AS (
    SELECT airport_code
    FROM airports_data
    WHERE lower(json_extract(city,'$.en')) = 'abakan'
),

/* longitude / latitude (in degrees) for every airport */
airports_coords AS (
    SELECT
        airport_code,
        /*  point is stored like "(lon,lat)" – strip brackets and split  */
        CAST(substr(coordinates, 2,
                    instr(coordinates, ',') - 2)                         ) AS lon,
        CAST(substr(coordinates,
                    instr(coordinates, ',') + 1,
                    length(coordinates) - instr(coordinates, ',') - 2)   ) AS lat
    FROM airports_data
),

/* all flights that start or end in Abakan */
flights_from_or_to_abakan AS (
    SELECT flight_id, departure_airport, arrival_airport
    FROM flights
    WHERE departure_airport IN (SELECT airport_code FROM abakan_airports)
       OR arrival_airport   IN (SELECT airport_code FROM abakan_airports)
),

/* add coordinates of both ends of every such flight */
flight_points AS (
    SELECT
        f.flight_id,
        d.lat AS lat1, d.lon AS lon1,
        a.lat AS lat2, a.lon AS lon2
    FROM flights_from_or_to_abakan f
    JOIN airports_coords d ON d.airport_code = f.departure_airport
    JOIN airports_coords a ON a.airport_code = f.arrival_airport
),

/* haversine distance in kilometres */
distances AS (
    SELECT
        flight_id,
        6371.0 * 2.0 *
        asin(
            sqrt(
                pow( sin( ( (lat2 - lat1) * 3.141592653589793 / 180.0 ) / 2.0 ), 2 )
              + cos( lat1 * 3.141592653589793 / 180.0 )
              * cos( lat2 * 3.141592653589793 / 180.0 )
              * pow( sin( ( (lon2 - lon1) * 3.141592653589793 / 180.0 ) / 2.0 ), 2 )
            )
        ) AS distance_km
    FROM flight_points
)

/* longest distance where Abakan is involved */
SELECT ROUND(MAX(distance_km), 4) AS longest_distance_km
FROM distances;
```
