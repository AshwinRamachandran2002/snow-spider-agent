```sql
WITH
abakan_airports AS (                      -- airport code(s) that serve Abakan
    SELECT airport_code
    FROM airports_data
    WHERE lower(json_extract(city,'$.en')) = 'abakan'
),
coords AS (                               -- longitude / latitude (°) for every airport
    SELECT
        airport_code,
        CAST(substr(coordinates, 2, instr(coordinates, ',') - 2) AS REAL)  AS lon_deg,
        CAST(substr(coordinates,
                    instr(coordinates, ',') + 1,
                    length(coordinates) - instr(coordinates, ',') - 2) AS REAL) AS lat_deg
    FROM airports_data
),
flights_abakan AS (                       -- every flight that starts OR ends in Abakan
    SELECT flight_id, departure_airport, arrival_airport
    FROM flights
    WHERE departure_airport IN (SELECT airport_code FROM abakan_airports)
       OR arrival_airport   IN (SELECT airport_code FROM abakan_airports)
),
pair_points AS (                          -- add coordinates of both ends of the flight
    SELECT
        f.flight_id,
        d.lat_deg AS lat1_deg, d.lon_deg AS lon1_deg,
        a.lat_deg AS lat2_deg, a.lon_deg AS lon2_deg
    FROM flights_abakan f
    JOIN coords d ON d.airport_code = f.departure_airport
    JOIN coords a ON a.airport_code = f.arrival_airport
),
dist_in_rad AS (                          -- prepare figures in radians
    SELECT
        flight_id,
        lat1_deg * (3.141592653589793/180.0) AS lat1,
        lat2_deg * (3.141592653589793/180.0) AS lat2,
        lon1_deg * (3.141592653589793/180.0) AS lon1,
        lon2_deg * (3.141592653589793/180.0) AS lon2
    FROM pair_points
),
dist_squared AS (                         -- equirectangular approximation, NO trig functions
    SELECT
        flight_id,
        (lon2 - lon1)                               AS dlon,
        (lat2 - lat1)                               AS dlat,
        (lat1 + lat2) / 2.0                         AS mean_lat
    FROM dist_in_rad
),
dist2_km AS (                             -- (Δσ)² ⋅ R²   (R = 6 371 km)
    SELECT
        flight_id,
        -- cosine(mean_lat)  via 8‑order Taylor polynomial
        1
        - (mean_lat*mean_lat)/2.0
        + (mean_lat*mean_lat*mean_lat*mean_lat)/24.0
        - (mean_lat*mean_lat*mean_lat*mean_lat*mean_lat*mean_lat)/720.0
        + (mean_lat*mean_lat*mean_lat*mean_lat*mean_lat*mean_lat*mean_lat*mean_lat)/40320.0  AS cos_mean,
        dlon,
        dlat
    FROM dist_squared
),
angular_sq AS (                           -- (angular distance in rad)²
    SELECT
        flight_id,
        (dlon * cos_mean)*(dlon * cos_mean) + dlat*dlat  AS ang_sq
    FROM dist2_km
),
km_sq AS (                                -- distance² in km²
    SELECT
        flight_id,
        ang_sq * 40689641.0               AS dist_km_sq        -- 6 371²
    FROM angular_sq
),
max_sq AS (                               -- biggest (distance)²
    SELECT MAX(dist_km_sq) AS max_km_sq
    FROM km_sq
),

/* ---------- square‑root without built‑in sqrt() : Newton–Raphson ------------- */
RECURSIVE sqrt_iter(val, guess, step) AS (
      SELECT max_km_sq,
             max_km_sq/2.0,              -- initial guess
             0
      FROM   max_sq
      UNION ALL
      SELECT val,
             (guess + val/guess)/2.0,    -- next guess
             step + 1
      FROM   sqrt_iter
      WHERE  step < 30                   -- 30 iterations are plenty for convergence
)
/* ----------------------------------------------------------------------------  */
SELECT ROUND(
           (SELECT guess                    -- last (most accurate) iteration
            FROM   sqrt_iter
            ORDER  BY step DESC
            LIMIT  1)
       , 4)         AS longest_distance_km;
```
