```sql
WITH
-- all Abakan airports
abakan_airports AS (
    SELECT airport_code
    FROM airports_data
    WHERE lower(json_extract(city, '$.en')) = 'abakan'
),

-- every airport with its numeric longitude / latitude
airport_coords AS (
    SELECT
        airport_code,
        /* longitude  = text between '(' and ',' */
        CAST(substr(coordinates, 2, instr(coordinates, ',') - 2) AS REAL)              AS lon,
        /* latitude   = text after ',' with the closing ')' removed                     */
        CAST(replace(substr(coordinates,
                            instr(coordinates, ',') + 1), ')', '')        AS REAL)     AS lat
    FROM airports_data
)

SELECT
    MAX(                       -- longest of all Abakan‑related routes
        6371 *                 -- Earth radius (km)
        acos(
            sin(dep.lat * 0.017453292519943295) * sin(arr.lat * 0.017453292519943295) +
            cos(dep.lat * 0.017453292519943295) * cos(arr.lat * 0.017453292519943295) *
            cos((arr.lon - dep.lon) * 0.017453292519943295)
        )
    ) AS longest_distance_km
FROM flights f
JOIN airport_coords dep ON dep.airport_code = f.departure_airport
JOIN airport_coords arr ON arr.airport_code = f.arrival_airport
WHERE f.departure_airport IN (SELECT airport_code FROM abakan_airports)
   OR f.arrival_airport   IN (SELECT airport_code FROM abakan_airports);
