        12742 /* 2 * 6371 km (Earth radius) */ *
        atan2(
            sqrt(
                sin(( (lat2 - lat1) * 0.017453292519943295 ) / 2) *
                sin(( (lat2 - lat1) * 0.017453292519943295 ) / 2) +
                cos(lat1 * 0.017453292519943295) *
