```sql
WITH
--------------------------------------------------------------------
-- 1.  Abakan airport codes
--------------------------------------------------------------------
abakan_airports AS (
    SELECT airport_code
    FROM airports_data
    WHERE lower(json_extract(city,'$.en')) = 'abakan'
),
--------------------------------------------------------------------
-- 2.  Every airport’s longitude / latitude in decimal degrees
--------------------------------------------------------------------
airport_coords AS (
    SELECT
        airport_code,
        CAST(substr(coordinates, 2, instr(coordinates, ',') - 2) AS REAL)               AS lon,
        CAST(replace(substr(coordinates, instr(coordinates, ',') + 1), ')','') AS REAL) AS lat
    FROM airports_data
),
--------------------------------------------------------------------
-- 3.  All flights where Abakan is either the origin or destination
--------------------------------------------------------------------
routes AS (
    SELECT
        ROW_NUMBER() OVER ()            AS rid,            -- unique id for recursion
        dep.lat                         AS lat1,
        dep.lon                         AS lon1,
        arr.lat                         AS lat2,
        arr.lon                         AS lon2
    FROM flights f
    JOIN airport_coords dep ON dep.airport_code = f.departure_airport
    JOIN airport_coords arr ON arr.airport_code = f.arrival_airport
    WHERE f.departure_airport IN (SELECT airport_code FROM abakan_airports)
       OR f.arrival_airport   IN (SELECT airport_code FROM abakan_airports)
),
--------------------------------------------------------------------
-- 4.  Haversine “a” value for every route  (needs only sin / cos)
--------------------------------------------------------------------
haversine AS (
    SELECT
        rid,
        -- constants
        0.017453292519943295                 AS rad,        -- π / 180
        lat1, lon1, lat2, lon2,
        sin(((lat2 - lat1) * 0.017453292519943295) / 2.0)  *
        sin(((lat2 - lat1) * 0.017453292519943295) / 2.0)  +
        cos(lat1 * 0.017453292519943295) *
        cos(lat2 * 0.017453292519943295) *
        sin(((lon2 - lon1) * 0.017453292519943295) / 2.0)  *
        sin(((lon2 - lon1) * 0.017453292519943295) / 2.0)   AS a
    FROM routes
),
--------------------------------------------------------------------
-- 5a.  √a   (square‑root via six Newton iterations, no sqrt() func)
--------------------------------------------------------------------
sqrt_a_iter AS (
    -- initial guess
    SELECT rid, a,
           CASE WHEN a <= 0 THEN 0.0 ELSE a / 2.0 END       AS g,
           0                                                AS iter
    FROM haversine
    UNION ALL
    -- Newton step :  g_{n+1} = ½ ( g_n + a / g_n )
    SELECT rid, a,
           0.5 * (g + a / g)                                AS g,
           iter + 1
    FROM sqrt_a_iter
    WHERE a  > 0              -- no division by zero
      AND g  > 0
      AND iter < 6            -- six iterations give ~10⁻¹² accuracy
),
sqrt_a AS (
    SELECT rid, a, g AS sqrt_a
    FROM (
        SELECT rid, a, g,
               ROW_NUMBER() OVER (PARTITION BY rid ORDER BY iter DESC) AS rn
        FROM sqrt_a_iter
    )
    WHERE rn = 1
),
--------------------------------------------------------------------
-- 5b.  √(1‑a)  (needed for atan2 formula)
--------------------------------------------------------------------
one_minus AS (
    SELECT rid, a, (1.0 - a) AS b
    FROM sqrt_a
),
sqrt_b_iter AS (
    SELECT rid, b,
           CASE WHEN b <= 0 THEN 0.0 ELSE b / 2.0 END       AS g,
           0                                                AS iter
    FROM one_minus
    UNION ALL
    SELECT rid, b,
           0.5 * (g + b / g)                                AS g,
           iter + 1
    FROM sqrt_b_iter
    WHERE b  > 0
      AND g  > 0
      AND iter < 6
),
sqrt_b AS (
    SELECT rid, g AS sqrt_b
    FROM (
        SELECT rid, g,
               ROW_NUMBER() OVER (PARTITION BY rid ORDER BY iter DESC) AS rn
        FROM sqrt_b_iter
    )
    WHERE rn = 1
),
--------------------------------------------------------------------
-- 6.  Great‑circle distance (km) with atan2( √a , √(1‑a) )
--------------------------------------------------------------------
distances AS (
    SELECT
        12742.0 * atan2(sa.sqrt_a, sb.sqrt_b) AS distance_km
    FROM sqrt_a sa
    JOIN sqrt_b sb USING (rid)
)
--------------------------------------------------------------------
-- 7.  Result : the longest Abakan route in kilometres
--------------------------------------------------------------------
SELECT MAX(distance_km) AS longest_distance_km
FROM distances;
