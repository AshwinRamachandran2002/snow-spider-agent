WITH abakan_airports AS (          /* Abakan airport code(s) */
    SELECT airport_code
    FROM airports_data
    WHERE LOWER(json_extract(city,'$.en')) = 'abakan'
),
coords AS (                        /* numeric longitude / latitude for every airport */
    SELECT
        airport_code,
        CAST(
            substr(
                REPLACE(REPLACE(coordinates,'(',''),')',''),
                1,
                instr(REPLACE(REPLACE(coordinates,'(',''),')',''),',')-1
            ) AS REAL
        ) AS lon,
        CAST(
            substr(
                REPLACE(REPLACE(coordinates,'(',''),')',''),
                instr(REPLACE(REPLACE(coordinates,'(',''),')',''),',')+1
            ) AS REAL
        ) AS lat
    FROM airports_data
),
routes AS (                        /* routes where Abakan is origin or destination */
    SELECT DISTINCT
           f.departure_airport AS dep_code,
           f.arrival_airport   AS arr_code
    FROM flights AS f
    WHERE f.departure_airport IN (SELECT airport_code FROM abakan_airports)
       OR f.arrival_airport   IN (SELECT airport_code FROM abakan_airports)
),
distances AS (                     /* simple planar‑distance approximation, km */
    SELECT
        111.111 *                                   /* km per degree (≈)        */
        sqrt( (dep.lat - arr.lat)*(dep.lat - arr.lat) +
              (dep.lon - arr.lon)*(dep.lon - arr.lon) ) AS distance_km
    FROM routes
    JOIN coords AS dep ON dep.airport_code = routes.dep_code
    JOIN coords AS arr ON arr.airport_code = routes.arr_code
)
SELECT ROUND(MAX(distance_km),4) AS longest_route_km
FROM distances;
