```sql
WITH abakan_airports AS (
    /* All airports that serve the city “Abakan” */
    SELECT airport_code
    FROM airports_data
    WHERE LOWER(json_extract(city,'$.en')) = 'abakan'
),
coords AS (
    /* Longitude / latitude split out of the “(lon,lat)” text held in coordinates */
    SELECT
        airport_code,
        CAST(
            substr(
                REPLACE(REPLACE(coordinates,'(',''),')',''),
                1,
                instr(REPLACE(REPLACE(coordinates,'(',''),')',''),',')-1
            ) AS REAL
        ) AS lon,
        CAST(
            substr(
                REPLACE(REPLACE(coordinates,'(',''),')',''),
                instr(REPLACE(REPLACE(coordinates,'(',''),')',''),',')+1
            ) AS REAL
        ) AS lat
    FROM airports_data
),
routes AS (
    /* Every DISTINCT route on which Abakan is either the origin or destination */
    SELECT DISTINCT
           f.departure_airport AS dep_code,
           f.arrival_airport   AS arr_code
    FROM flights AS f
    WHERE f.departure_airport IN (SELECT airport_code FROM abakan_airports)
       OR f.arrival_airport   IN (SELECT airport_code FROM abakan_airports)
),
distances AS (
    /* Great‑circle distance (Haversine) for each of those routes, in km */
    SELECT
        6371 *
        acos(
            cos(radians(dep.lat)) * cos(radians(arr.lat)) *
            cos(radians(arr.lon) - radians(dep.lon)) +
            sin(radians(dep.lat)) * sin(radians(arr.lat))
        ) AS distance_km
    FROM routes
    JOIN coords AS dep ON dep.airport_code = routes.dep_code
    JOIN coords AS arr ON arr.airport_code = routes.arr_code
)
SELECT ROUND(MAX(distance_km),4) AS longest_route_km
FROM distances;
```
