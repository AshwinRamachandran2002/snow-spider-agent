```sql
WITH abakan_airports AS (
    SELECT airport_code
    FROM airports_data
    WHERE lower(json_extract(city,'$.en')) = 'abakan'
),
coords AS (
    SELECT airport_code,
           /* longitude  */
           CAST(substr(coordinates, 2, instr(coordinates, ',')-2) AS REAL) AS lon,
           /* latitude   */
           CAST(substr(
                    coordinates,
                    instr(coordinates, ',') + 1,
                    instr(coordinates, ')') - instr(coordinates, ',') - 1) AS REAL) AS lat
    FROM airports_data
),
routes AS (
    SELECT f.departure_airport  AS dep,
           f.arrival_airport    AS arr
    FROM flights AS f
    WHERE f.departure_airport IN (SELECT airport_code FROM abakan_airports)
       OR f.arrival_airport   IN (SELECT airport_code FROM abakan_airports)
),
distances AS (
    SELECT
        2 * 6371 *
        asin(
            sqrt(
                  pow( sin( (c2.lat - c1.lat) * pi() / 180 / 2 ), 2 )
                + cos( c1.lat * pi() / 180 )
                  * cos( c2.lat * pi() / 180 )
                  * pow( sin( (c2.lon - c1.lon) * pi() / 180 / 2 ), 2 )
            )
        ) AS distance_km
    FROM routes
    JOIN coords AS c1 ON c1.airport_code = routes.dep
    JOIN coords AS c2 ON c2.airport_code = routes.arr
)
SELECT MAX(distance_km) AS longest_route_km
FROM distances;
```
