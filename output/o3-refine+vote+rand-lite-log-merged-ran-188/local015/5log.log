JOIN parties      AS p ON p.case_id = c.case_id
WHERE c.motorcycle_collision = 1
  AND p.statewide_vehicle_type LIKE '%motorcycle%'
  AND (p.party_safety_equipment_1 LIKE '%helmet%' OR
       p.party_safety_equipment_2 LIKE '%helmet%');
