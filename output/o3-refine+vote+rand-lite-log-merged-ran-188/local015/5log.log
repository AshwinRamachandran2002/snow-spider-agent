```sql
-- Description: 7) Check the flag that signals the crash involved a motorcycle
SELECT DISTINCT motorcycle_collision
FROM collisions
LIMIT 20;
```

```sql
-- Description: 8) Count motorcycle collisions overall
SELECT COUNT(*) AS total_motorcycle_collisions
FROM collisions
WHERE motorcycle_collision = 1;
```

```sql
-- Description: 9) Count motorcycle collisions in which at least one party used a helmet
SELECT COUNT(DISTINCT c.case_id) AS collisions_with_helmet
FROM collisions   AS c
JOIN parties      AS p ON p.case_id = c.case_id
WHERE c.motorcycle_collision = 1
  AND p.statewide_vehicle_type LIKE '%motorcycle%'
  AND (p.party_safety_equipment_1 LIKE '%helmet%' OR
       p.party_safety_equipment_2 LIKE '%helmet%');
```

```sql
-- Description: 10) Count motorcycle collisions in which at least one motorcycle party had no helmet
SELECT COUNT(DISTINCT c.case_id) AS collisions_without_helmet
FROM collisions   AS c
JOIN parties      AS p ON p.case_id = c.case_id
WHERE c.motorcycle_collision = 1
  AND p.statewide_vehicle_type LIKE '%motorcycle%'
  AND ( (p.party_safety_equipment_1 NOT LIKE '%helmet%' OR p.party_safety_equipment_1 IS NULL)
     AND (p.party_safety_equipment_2 NOT LIKE '%helmet%' OR p.party_safety_equipment_2 IS NULL) );
```
