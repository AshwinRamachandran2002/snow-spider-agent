Query:
-- 7) Sum motorcyclist fatalities in those helmet-yes collisions
SELECT SUM(c."motorcyclist_killed_count") AS "helmet_yes_killed"
FROM "collisions" c
WHERE c."case_id" IN (
        SELECT DISTINCT p."case_id"
        FROM   "parties" p
        WHERE  p."statewide_vehicle_type" LIKE '%motorcycle%'
          AND (   p."party_safety_equipment_1" LIKE '%helmet%'
               OR p."party_safety_equipment_2" LIKE '%helmet%')
)
LIMIT 20;
