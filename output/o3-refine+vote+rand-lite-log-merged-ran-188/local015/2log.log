Query:
-- 10) Final report: fatality rate (percentage) for motorcycle collisions
--     split by helmet usage
WITH
helmet_yes AS (
    SELECT DISTINCT p."case_id"
    FROM "parties" p
    JOIN "collisions" c ON c."case_id" = p."case_id"
    WHERE c."motorcycle_collision" = 1
      AND p."statewide_vehicle_type" LIKE '%motorcycle%'
      AND (   p."party_safety_equipment_1" LIKE '%helmet%'
           OR p."party_safety_equipment_2" LIKE '%helmet%')
),
helmet_no AS (
    SELECT DISTINCT p."case_id"
    FROM "parties" p
    JOIN "collisions" c ON c."case_id" = p."case_id"
    WHERE c."motorcycle_collision" = 1
      AND p."statewide_vehicle_type" LIKE '%motorcycle%'
      AND (   p."party_safety_equipment_1" LIKE '%helmet not used%'
           OR p."party_safety_equipment_2" LIKE '%helmet not used%')
)
SELECT
    100.0 * SUM(CASE WHEN c."case_id" IN (SELECT * FROM helmet_yes) THEN c."motorcyclist_killed_count" ELSE 0 END)
         / COUNT(DISTINCT CASE WHEN c."case_id" IN (SELECT * FROM helmet_yes) THEN c."case_id" END)
         AS "fatality_rate_helmet_yes",
    100.0 * SUM(CASE WHEN c."case_id" IN (SELECT * FROM helmet_no) THEN c."motorcyclist_killed_count" ELSE 0 END)
         / COUNT(DISTINCT CASE WHEN c."case_id" IN (SELECT * FROM helmet_no) THEN c."case_id" END)
         AS "fatality_rate_helmet_no"
FROM "collisions" c
WHERE c."motorcycle_collision" = 1
LIMIT 20;
Answer:
fatality_rate_helmet_yes,fatality_rate_helmet_no
