```sql
-- 1) What vehicle‐type codes exist in the Parties table?
SELECT DISTINCT statewide_vehicle_type
FROM parties
LIMIT 20;
```

```sql
-- 2) Focus on the motorcycle-related codes only
SELECT DISTINCT statewide_vehicle_type
FROM parties
WHERE statewide_vehicle_type LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- 3) Which safety-equipment codes (1st field) appear for motorcyclists?
SELECT DISTINCT party_safety_equipment_1
FROM parties
WHERE statewide_vehicle_type LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- 4) Which safety-equipment codes (2nd field) appear for motorcyclists?
SELECT DISTINCT party_safety_equipment_2
FROM parties
WHERE statewide_vehicle_type LIKE '%motorcycle%'
LIMIT 20;
```

```sql
-- 5) Take a quick look at some motorcycle parties that DO list a helmet
SELECT id, case_id, party_number, party_safety_equipment_1, party_safety_equipment_2,
       party_number_killed
FROM parties
WHERE statewide_vehicle_type LIKE '%motorcycle%'
  AND (party_safety_equipment_1 LIKE '%helmet%' OR party_safety_equipment_2 LIKE '%helmet%')
LIMIT 20;
```

```sql
-- 6) How many COLLISIONS (distinct case_id) involve motorcyclists WITH helmets?
SELECT COUNT(DISTINCT case_id) AS collisions_helmet_used
FROM parties
WHERE statewide_vehicle_type LIKE '%motorcycle%'
  AND (party_safety_equipment_1 LIKE '%helmet%' OR party_safety_equipment_2 LIKE '%helmet%')
LIMIT 20;
```

```sql
-- 7) How many motorcyclist FATALITIES occur in those helmet collisions?
SELECT SUM(party_number_killed) AS fatalities_helmet_used
FROM parties
WHERE statewide_vehicle_type LIKE '%motorcycle%'
  AND (party_safety_equipment_1 LIKE '%helmet%' OR party_safety_equipment_2 LIKE '%helmet%')
LIMIT 20;
```

```sql
-- 8) Repeat for motorcyclists WITHOUT helmets
SELECT COUNT(DISTINCT case_id)  AS collisions_no_helmet,
       SUM(party_number_killed) AS fatalities_no_helmet
FROM parties
WHERE statewide_vehicle_type LIKE '%motorcycle%'
  AND (party_safety_equipment_1 NOT LIKE '%helmet%'
       AND party_safety_equipment_2 NOT LIKE '%helmet%')
LIMIT 20;
```

```sql
-- 9) FINAL – fatality rate (%) for motorcycle collisions, split by helmet use
WITH motorcycle_parties AS (
    SELECT case_id,
           party_number_killed,
           CASE
             WHEN (party_safety_equipment_1 LIKE '%helmet%'
                   OR party_safety_equipment_2 LIKE '%helmet%') THEN 1
             ELSE 0
           END AS helmet_used
    FROM parties
    WHERE statewide_vehicle_type LIKE '%motorcycle%'
)
SELECT
  100.0 * SUM(CASE WHEN helmet_used = 1 THEN party_number_killed ELSE 0 END)
        / (SELECT COUNT(DISTINCT case_id) FROM motorcycle_parties WHERE helmet_used = 1)
        AS fatality_rate_helmet_pct,
  100.0 * SUM(CASE WHEN helmet_used = 0 THEN party_number_killed ELSE 0 END)
        / (SELECT COUNT(DISTINCT case_id) FROM motorcycle_parties WHERE helmet_used = 0)
        AS fatality_rate_no_helmet_pct
FROM motorcycle_parties
LIMIT 20;
```
