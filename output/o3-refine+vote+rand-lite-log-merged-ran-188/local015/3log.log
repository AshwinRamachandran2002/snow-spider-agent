-- 9) FINAL – fatality rate (%) for motorcycle collisions, split by helmet use
WITH motorcycle_parties AS (
    SELECT case_id,
           party_number_killed,
           CASE
             WHEN (party_safety_equipment_1 LIKE '%helmet%'
                   OR party_safety_equipment_2 LIKE '%helmet%') THEN 1
             ELSE 0
           END AS helmet_used
    FROM parties
    WHERE statewide_vehicle_type LIKE '%motorcycle%'
)
SELECT
  100.0 * SUM(CASE WHEN helmet_used = 1 THEN party_number_killed ELSE 0 END)
        / (SELECT COUNT(DISTINCT case_id) FROM motorcycle_parties WHERE helmet_used = 1)
        AS fatality_rate_helmet_pct,
  100.0 * SUM(CASE WHEN helmet_used = 0 THEN party_number_killed ELSE 0 END)
        / (SELECT COUNT(DISTINCT case_id) FROM motorcycle_parties WHERE helmet_used = 0)
        AS fatality_rate_no_helmet_pct
FROM motorcycle_parties
LIMIT 20;
