Query:
--Description: Same as above but also join to GENES to expose HGNC symbols;
--             uses the pre-aggregated “best” CTE to avoid window functions.
WITH best AS (
    SELECT
        "study_id",
        "gene_id",
        MIN("pval") AS "best_pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
    GROUP BY "study_id", "gene_id"
)
SELECT 
       g."gene_name",
       d."gene_id",
       d."study_id",
       d."tag_chrom",
       d."tag_pos",
       d."pval"
FROM   best
JOIN   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE" d
       ON  d."study_id" = best."study_id"
       AND d."gene_id"  = best."gene_id"
       AND d."pval"     = best."best_pval"
LEFT  JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."GENES" g
       ON g."gene_id" = d."gene_id"
ORDER BY d."pval" ASC
LIMIT 10
