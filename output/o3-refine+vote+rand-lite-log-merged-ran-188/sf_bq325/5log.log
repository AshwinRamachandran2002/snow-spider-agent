Query:
--Description: Get the globally strongest 10 gene–study associations by first collapsing to 
--             the minimum p-value per (study_id, gene_id) pair, then attaching one example 
--             variant that attains that minimum.  (Replaces heavy ROW_NUMBER windowing.)
WITH best AS (
    SELECT
        "study_id",
        "gene_id",
        MIN("pval") AS "best_pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
    GROUP BY "study_id", "gene_id"
)
SELECT 
       d."study_id",
       d."gene_id",
       d."tag_chrom",
       d."tag_pos",
       d."pval"
FROM   best
JOIN   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE" d
       ON  d."study_id" = best."study_id"
       AND d."gene_id"  = best."gene_id"
       AND d."pval"     = best."best_pval"
ORDER  BY d."pval" ASC
LIMIT  10
