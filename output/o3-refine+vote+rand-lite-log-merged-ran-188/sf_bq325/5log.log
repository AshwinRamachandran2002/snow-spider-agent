```sql
--Description / Thinking process:
--  Goal: Top-10 genes with the strongest associations across ALL studies.
--  Steps implemented below:
--    1. Scan DISEASE_VARIANT_GENE, where each row is a variant–gene link with a p-value.
--    2. For every (study_id, gene_id) pair, keep the *minimum* p-value using MIN().
--       • This avoids expensive window functions and sidesteps the previous timeout.
--    3. The intermediate CTE “best” now holds one record per study–gene, with its
--       strongest (smallest) p-value.
--    4. Join to GENES to attach a readable HGNC symbol (gene_name).
--    5. Sort the aggregated rows by p-value ascending and keep the global top-10.
WITH "best" AS (
    SELECT
        "study_id",
        "gene_id",
        MIN("pval") AS "best_pval"
    FROM   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE  "pval" IS NOT NULL
    GROUP  BY "study_id", "gene_id"
)
SELECT
    g."gene_name",
    b."gene_id",
    b."study_id",
    b."best_pval"
FROM   "best" b
LEFT JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."GENES" g
       ON g."gene_id" = b."gene_id"
ORDER  BY b."best_pval" ASC
LIMIT  10;
```
