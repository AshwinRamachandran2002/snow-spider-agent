```sql
--Description: Get the globally strongest 10 gene–study associations by first collapsing to 
--             the minimum p-value per (study_id, gene_id) pair, then attaching one example 
--             variant that attains that minimum.  (Replaces heavy ROW_NUMBER windowing.)
WITH best AS (
    SELECT
        "study_id",
        "gene_id",
        MIN("pval") AS "best_pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
    GROUP BY "study_id", "gene_id"
)
SELECT 
       d."study_id",
       d."gene_id",
       d."tag_chrom",
       d."tag_pos",
       d."pval"
FROM   best
JOIN   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE" d
       ON  d."study_id" = best."study_id"
       AND d."gene_id"  = best."gene_id"
       AND d."pval"     = best."best_pval"
ORDER  BY d."pval" ASC
LIMIT  10;
```

```sql
--Description: Same as above but also join to GENES to expose HGNC symbols;
--             uses the pre-aggregated “best” CTE to avoid window functions.
WITH best AS (
    SELECT
        "study_id",
        "gene_id",
        MIN("pval") AS "best_pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
    GROUP BY "study_id", "gene_id"
)
SELECT 
       g."gene_name",
       d."gene_id",
       d."study_id",
       d."tag_chrom",
       d."tag_pos",
       d."pval"
FROM   best
JOIN   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE" d
       ON  d."study_id" = best."study_id"
       AND d."gene_id"  = best."gene_id"
       AND d."pval"     = best."best_pval"
LEFT  JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."GENES" g
       ON g."gene_id" = d."gene_id"
ORDER BY d."pval" ASC
LIMIT 10;
```

```sql
--Description: Attach publication metadata to the top-10 strongest gene–study pairs
--             using the same MIN(pval) aggregation strategy for efficiency.
WITH best AS (
    SELECT
        "study_id",
        "gene_id",
        MIN("pval") AS "best_pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
    GROUP BY "study_id", "gene_id"
)
SELECT 
       g."gene_name",
       d."gene_id",
       d."study_id",
       s."pub_author",
       s."pub_date",
       s."pub_journal",
       d."pval"
FROM   best
JOIN   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE" d
       ON  d."study_id" = best."study_id"
       AND d."gene_id"  = best."gene_id"
       AND d."pval"     = best."best_pval"
LEFT  JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."GENES"   g ON g."gene_id"  = d."gene_id"
LEFT  JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."STUDIES" s ON s."study_id" = d."study_id"
ORDER BY d."pval" ASC
LIMIT 10;
```

```sql
--Description: Validation query – ensure no variant exists with p-value smaller than the
--             chosen MIN(pval) for its (study_id, gene_id); should return 0.
WITH best AS (
    SELECT
        "study_id",
        "gene_id",
        MIN("pval") AS "best_p"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
    GROUP BY "study_id", "gene_id"
)
SELECT COUNT(*) AS "n_not_unique_best"
FROM   OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE" d
JOIN   best b
       ON  d."study_id" = b."study_id"
       AND d."gene_id"  = b."gene_id"
WHERE  d."pval" < b."best_p";
```

