Query:
--Description: 9) Create the final pick-list proposal: for each order-line (keeps sequence), list the exact locations & quantities to be picked, obeying priority (oldest, smallest qty) and not exceeding the qty still needed.
SELECT DISTINCT ol."id"            AS "orderline_id",
                ol."product_id",
                l."aisle",
                l."position",
                CASE
                  WHEN ol."qty" <= i."qty" THEN ol."qty"
                  ELSE i."qty"
                END                AS "qty_to_pick"
FROM   "orderlines" ol
JOIN   "inventory"  i ON i."product_id" = ol."product_id"
JOIN   "purchases" p  ON p."id"        = i."purchase_id"
JOIN   "locations" l  ON l."id"        = i."location_id"
WHERE  ol."order_id" = 423
  AND  l."warehouse" = 1
ORDER  BY ol."id",               -- preserves order-line sequence
          p."purchased",         -- oldest purchase first
          i."qty"                -- then smallest remaining qty
LIMIT 20;
