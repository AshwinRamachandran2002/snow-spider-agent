```sql
--Description:
--Thinking process: Build the actual pick-plan for order 423 in one statement.
--1) need      – total quantity required per product for the order.
--2) inv       – every inventory row in warehouse 1 for those products, ordered by
--              oldest purchase date then smallest lot size (pick priority rule).
--3) ranked    – add a running cumulative sum (cum_qty_before) so we can see how
--              far we have satisfied the required amount while scanning the
--              inventory in priority order.
--4) final     – calculate the exact quantity to take from each location:
--              pick_qty = 0 if we already reached the needed total,
--              else the smaller of (lot qty) or (still_needed).
--The result shows only the rows from which stock must be picked, giving
--product, aisle, position and the precise pick_qty; totals per product
--match the order quantities and never exceed available inventory.
WITH need AS (
    SELECT product_id,
           SUM(qty) AS total_needed
    FROM   orderlines
    WHERE  order_id = 423
    GROUP  BY product_id
),
inv AS (
    SELECT i.id            AS inv_id,
           i.product_id,
           l.aisle,
           l.position,
           p.purchased,
           i.qty
    FROM   inventory  i
    JOIN   locations  l ON l.id = i.location_id
    JOIN   purchases  p ON p.id = i.purchase_id
    WHERE  l.warehouse = 1
      AND  i.product_id IN (SELECT product_id FROM need)
    ORDER  BY i.product_id, p.purchased, i.qty
),
ranked AS (
    SELECT inv.*,
           SUM(inv.qty) OVER (
               PARTITION BY inv.product_id
               ORDER BY     inv.purchased, inv.qty
               ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
           ) AS cum_qty_before
    FROM   inv
),
final AS (
    SELECT product_id,
           aisle,
           position,
           CASE
               WHEN COALESCE(cum_qty_before,0) >= n.total_needed
                 THEN 0                                    -- already fulfilled
               WHEN COALESCE(cum_qty_before,0) + qty <= n.total_needed
                 THEN qty                                   -- take whole lot
               ELSE n.total_needed - COALESCE(cum_qty_before,0)  -- take part
           END AS pick_qty
    FROM   ranked r
    JOIN   need   n ON n.product_id = r.product_id
)
SELECT product_id,
       aisle,
       position,
       pick_qty
FROM   final
WHERE  pick_qty > 0               -- only the locations we need to pick from
ORDER  BY product_id, aisle, position;
```
