```sql
--Description: 
--Thinking process: We must list the warehouse-1 inventory lots that will *not* be touched
--when fulfilling order 423, respecting the FIFO rule (oldest purchase date first, then
--smallest lot size).  
--Steps inside one query:  
--1. need     – total quantity required per product in order 423.  
--2. inv_w1   – every inventory lot in warehouse 1 for those products, with its purchase
--              date and location data.  
--3. fifo     – adds a running total (run_qty) of on-hand units for each product in
--              FIFO order.  If the running total *before* the current lot already
--              meets the requirement, that lot remains untouched.  
--The final SELECT therefore returns only the lots whose stock is **beyond** what the
--order needs (i.e. untouched). 
WITH need AS (
    SELECT product_id,
           SUM(qty) AS total_needed
    FROM   orderlines
    WHERE  order_id = 423
    GROUP  BY product_id
),
inv_w1 AS (
    SELECT i.id            AS inv_id,
           i.product_id,
           i.qty,
           p.purchased,
           l.aisle,
           l.position
    FROM   inventory  i
    JOIN   locations  l ON l.id = i.location_id
    JOIN   purchases  p ON p.id = i.purchase_id
    WHERE  l.warehouse = 1
      AND  i.product_id IN (SELECT product_id FROM need)
),
fifo AS (
    SELECT inv_w1.*,
           SUM(inv_w1.qty) OVER (
               PARTITION BY inv_w1.product_id
               ORDER BY     inv_w1.purchased,
                            inv_w1.qty,
                            inv_w1.inv_id
           ) AS run_qty
    FROM   inv_w1
)
SELECT  f.product_id,
        f.aisle,
        f.position,
        f.qty AS qty_untouched
FROM    fifo        f
JOIN    need        n ON n.product_id = f.product_id
WHERE   (f.run_qty - f.qty) >= n.total_needed      -- requirement already met before this lot
ORDER BY f.product_id, f.purchased, f.inv_id
LIMIT 20;
```
