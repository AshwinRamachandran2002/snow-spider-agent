                i."product_id",
                p."purchased"   AS "purch_date",
                i."qty",
                i."location_id"
FROM   "inventory"  i
JOIN   "purchases"  p  ON p."id" = i."purchase_id"
WHERE  i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
LIMIT 20;
```

```sql
--Description: 6) Same as (5) but keep only inventory that is in warehouse 1 and sort it by (oldest purchase, then smallest qty) – this matches the picking priority rule.
SELECT DISTINCT i."product_id",
                i."location_id",
                l."aisle",
                l."position",
                p."purchased"   AS "purch_date",
                i."qty"
FROM   "inventory"  i
JOIN   "purchases"  p  ON p."id" = i."purchase_id"
JOIN   "locations"  l  ON l."id" = i."location_id"
WHERE  i."product_id" IN (SELECT "product_id"
                          FROM "orderlines"
                          WHERE "order_id" = 423)
  AND  l."warehouse" = 1
ORDER  BY i."product_id",
          p."purchased",
          i."qty"
LIMIT 20;
```

```sql
--Description: 7) Aggregate the on-hand inventory per product (warehouse-1 only) to verify there is enough to fulfil the order quantities.
SELECT DISTINCT i."product_id",
       SUM(i."qty") AS "on_hand_qty_warehouse1"
FROM   "inventory" i
JOIN   "locations" l ON l."id" = i."location_id"
WHERE  i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
  AND  l."warehouse" = 1
GROUP  BY i."product_id"
LIMIT 20;
```

```sql
--Description: 8) Compare the total quantity required vs. total on-hand for each product.
SELECT DISTINCT need."product_id",
       need."total_qty_needed",
       stock."on_hand_qty_warehouse1"
FROM  (
        SELECT "product_id",
               SUM("qty") AS "total_qty_needed"
        FROM   "orderlines"
        WHERE  "order_id" = 423
        GROUP  BY "product_id"
      ) AS need
JOIN (
        SELECT i."product_id",
               SUM(i."qty") AS "on_hand_qty_warehouse1"
        FROM   "inventory" i
        JOIN   "locations" l ON l."id" = i."location_id"
        WHERE  l."warehouse" = 1
        GROUP  BY i."product_id"
     ) AS stock
  ON need."product_id" = stock."product_id"
LIMIT 20;
```

```sql
--Description: 9) Create the final pick-list proposal: for each order-line (keeps sequence), list the exact locations & quantities to be picked, obeying priority (oldest, smallest qty) and not exceeding the qty still needed.
SELECT DISTINCT ol."id"            AS "orderline_id",
                ol."product_id",
                l."aisle",
                l."position",
                CASE
                  WHEN ol."qty" <= i."qty" THEN ol."qty"
                  ELSE i."qty"
                END                AS "qty_to_pick"
FROM   "orderlines" ol
JOIN   "inventory"  i ON i."product_id" = ol."product_id"
JOIN   "purchases" p  ON p."id"        = i."purchase_id"
JOIN   "locations" l  ON l."id"        = i."location_id"
WHERE  ol."order_id" = 423
  AND  l."warehouse" = 1
ORDER  BY ol."id",               -- preserves order-line sequence
          p."purchased",         -- oldest purchase first
          i."qty"                -- then smallest remaining qty
LIMIT 20;
```

```sql
--Description: 10) Extra safety-check – show any inventory lines from warehouse-1 that remain untouched after the planned picks for order 423.
SELECT DISTINCT i."product_id",
                l."aisle",
                l."position",
                i."qty"
FROM   "inventory" i
JOIN   "locations" l ON l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT "product_id"
                           FROM "orderlines"
                           WHERE "order_id" = 423)
  AND  i."id" NOT IN (SELECT DISTINCT inv_sub."id"
                      FROM (
                           SELECT i2."id",
                                  SUM(CASE
                                        WHEN ol2."qty" <= i2."qty" THEN ol2."qty"
                                        ELSE i2."qty"
                                      END) AS "picked"
                           FROM   "orderlines" ol2
                           JOIN   "inventory"  i2 ON i2."product_id" = ol2."product_id"
                           JOIN   "purchases"  p2  ON p2."id" = i2."purchase_id"
                           JOIN   "locations"  l2  ON l2."id" = i2."location_id"
                           WHERE  ol2."order_id" = 423
                             AND  l2."warehouse" = 1
                           GROUP  BY i2."id"
                      ) AS inv_sub)
LIMIT 20;
```
