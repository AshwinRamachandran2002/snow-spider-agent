```sql
--Description: 3)  Inventory lots in warehouse 1 that contain any of the products ordered on 423.
SELECT DISTINCT i."id"        AS inv_id,
                i."product_id",
                i."qty",
                i."location_id",
                l."aisle",
                l."position"
FROM   "inventory" AS i
JOIN   "locations" AS l  ON l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
LIMIT 20;
```

```sql
--Description: 4)  Same inventory rows as above but now with purchase date (for FIFO / oldest first).
SELECT DISTINCT i."id"        AS inv_id,
                i."product_id",
                i."qty",
                p."purchased",
                i."location_id",
                l."aisle",
                l."position"
FROM   "inventory"  AS i
JOIN   "purchases"  AS p ON p."id" = i."purchase_id"
JOIN   "locations"  AS l ON l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
ORDER BY i."product_id", p."purchased", i."qty"
LIMIT 20;
```

```sql
--Description: 5)  Aggregated inventory (warehouse 1) per product and purchase date – helps compare with order demand.
SELECT DISTINCT i."product_id",
                p."purchased",
                SUM(i."qty") AS qty_on_hand
FROM   "inventory"  AS i
JOIN   "purchases"  AS p ON p."id" = i."purchase_id"
JOIN   "locations"  AS l ON l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
GROUP  BY i."product_id", p."purchased"
ORDER  BY i."product_id", p."purchased"
LIMIT 20;
```

```sql
--Description: 6)  Cumulative quantity ordered per product for order 423.
SELECT DISTINCT "product_id",
                SUM("qty") AS ordered_qty
FROM   "orderlines"
WHERE  "order_id" = 423
GROUP  BY "product_id"
LIMIT 20;
```

```sql
--Description: 7)  Compare ordered quantity to total inventory available in warehouse 1.
SELECT DISTINCT o."product_id",
                o.ordered_qty,
                IFNULL(inv.qty_available,0) AS qty_available
FROM  (SELECT "product_id", SUM("qty") AS ordered_qty
       FROM   "orderlines"
       WHERE  "order_id" = 423
       GROUP  BY "product_id") AS o
LEFT JOIN
      (SELECT i."product_id", SUM(i."qty") AS qty_available
       FROM   "inventory" AS i
       JOIN   "locations" AS l ON l."id" = i."location_id"
       WHERE  l."warehouse" = 1
       GROUP  BY i."product_id") AS inv
ON inv."product_id" = o."product_id"
LIMIT 20;
```

