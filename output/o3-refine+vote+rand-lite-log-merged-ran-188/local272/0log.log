WITH needed AS (
    SELECT DISTINCT "product_id", SUM("qty") AS "qty_needed"
    FROM   "orderlines"
    WHERE  "order_id" = 423
    GROUP BY "product_id"
), inv AS (
    SELECT i."id" AS "inv_id", i."product_id", i."qty" AS "inv_qty",
