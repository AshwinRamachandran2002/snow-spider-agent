```sql
--Description: aggregate the total quantity that must be supplied for each product in order 423
SELECT DISTINCT "product_id", SUM("qty") AS "qty_needed"
FROM "orderlines"
WHERE "order_id" = 423
GROUP BY "product_id"
LIMIT 20;
```

```sql
--Description: show the stock we have in warehouse 1 for those same products, together with aisle / position
SELECT DISTINCT i."product_id", i."qty"       AS "inv_qty",
                l."id"        AS "location_id",
                l."aisle", l."position"
FROM   "inventory"  AS i
JOIN   "locations"  AS l ON l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
LIMIT 20;
```

```sql
--Description: add the purchase date for each inventory record so we can prioritise the oldest stock
SELECT DISTINCT i."product_id", i."qty" AS "inv_qty",
                p."purchased",
                l."aisle", l."position"
FROM   "inventory" AS i
JOIN   "purchases" AS p ON p."id"  = i."purchase_id"
JOIN   "locations" AS l ON l."id"  = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT "product_id"
                          FROM   "orderlines"
                          WHERE  "order_id" = 423)
ORDER BY i."product_id", p."purchased", i."qty"
LIMIT 20;
```

```sql
--Description: rank every inventory line per product by (older purchase date, then smaller qty)
SELECT DISTINCT i."inv_id", i."product_id", i."inv_qty",
                i."purchased",
                i."aisle", i."position",
                ROW_NUMBER() OVER (PARTITION BY i."product_id"
                                   ORDER BY i."purchased", i."inv_qty") AS "rank_no"
FROM (
    SELECT   i."id" AS "inv_id", i."product_id", i."qty" AS "inv_qty",
             p."purchased", l."aisle", l."position"
    FROM     "inventory" AS i
    JOIN     "purchases" AS p ON p."id" = i."purchase_id"
    JOIN     "locations" AS l ON l."id" = i."location_id"
    WHERE    l."warehouse" = 1
      AND    i."product_id" IN (SELECT "product_id"
                                FROM   "orderlines"
                                WHERE  "order_id" = 423)
) AS i
LIMIT 20;
```

```sql
--Description: compute the running (cumulative) inventory quantity for each product in that priority order
SELECT DISTINCT i."inv_id", i."product_id", i."inv_qty",
                i."purchased",
                i."aisle", i."position",
                SUM(i."inv_qty") OVER (PARTITION BY i."product_id"
                                       ORDER BY i."purchased", i."inv_qty"
                                       ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "cum_qty"
FROM (
    SELECT   i."id" AS "inv_id", i."product_id", i."qty" AS "inv_qty",
             p."purchased", l."aisle", l."position"
    FROM     "inventory" AS i
    JOIN     "purchases" AS p ON p."id" = i."purchase_id"
    JOIN     "locations" AS l ON l."id" = i."location_id"
    WHERE    l."warehouse" = 1
      AND    i."product_id" IN (SELECT "product_id"
                                FROM   "orderlines"
                                WHERE  "order_id" = 423)
) AS i
LIMIT 20;
```

```sql
--Description: attach the ‘needed’ amount to every inventory line so we can decide how much to take
WITH needed AS (
    SELECT DISTINCT "product_id", SUM("qty") AS "qty_needed"
    FROM   "orderlines"
    WHERE  "order_id" = 423
    GROUP BY "product_id"
), inv AS (
    SELECT i."id" AS "inv_id", i."product_id", i."qty" AS "inv_qty",
           p."purchased", l."aisle", l."position",
           SUM(i."qty") OVER (PARTITION BY i."product_id"
                              ORDER BY p."purchased", i."qty"
                              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "cum_qty"
    FROM   "inventory" AS i
    JOIN   "purchases" AS p ON p."id" = i."purchase_id"
    JOIN   "locations" AS l ON l."id" = i."location_id"
    WHERE  l."warehouse" = 1
      AND  i."product_id" IN (SELECT "product_id"
                              FROM   needed)
)
SELECT DISTINCT inv."product_id", inv."aisle", inv."position",
       CASE
           WHEN inv."cum_qty" - inv."inv_qty" >= needed."qty_needed" THEN 0
           WHEN inv."cum_qty" <= needed."qty_needed"                THEN inv."inv_qty"
           ELSE needed."qty_needed" - (inv."cum_qty" - inv."inv_qty")
       END AS "pick_qty"
FROM   inv
JOIN   needed ON needed."product_id" = inv."product_id"
WHERE  CASE
           WHEN inv."cum_qty" - inv."inv_qty" >= needed."qty_needed" THEN 0
           WHEN inv."cum_qty" <= needed."qty_needed"                THEN inv."inv_qty"
           ELSE needed."qty_needed" - (inv."cum_qty" - inv."inv_qty")
       END > 0
ORDER  BY inv."product_id", inv."purchased", inv."inv_qty"
LIMIT 20;
```

```sql
--Description: FINAL answer – exact pick-list (product, aisle, position, quantity) for order 423
