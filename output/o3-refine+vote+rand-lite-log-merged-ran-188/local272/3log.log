Query:
--Description: 9) (Optional) Compare cumulative running sum with quantity required, keeping only what will actually be picked
SELECT t."product_id",
       t."aisle",
       t."position",
       CASE
           WHEN t."cumulative_qty" - t."qty" < o."qty_ordered"
           THEN MIN(t."qty", o."qty_ordered" - (t."cumulative_qty" - t."qty"))
           ELSE 0
       END AS "qty_to_pick"
FROM (
    SELECT i."product_id",
           l."aisle",
           l."position",
           i."qty",
           p."purchased",
           SUM(i."qty") OVER (PARTITION BY i."product_id"
                              ORDER BY p."purchased", i."qty") AS "cumulative_qty"
    FROM   "inventory" i
    JOIN   "locations" l  ON l."id" = i."location_id"
    JOIN   "purchases" p ON p."id" = i."purchase_id"
    WHERE  l."warehouse" = 1
      AND  i."product_id" IN (SELECT "product_id" FROM "orderlines" WHERE "order_id" = 423)
) t
JOIN (
    SELECT "product_id", SUM("qty") AS "qty_ordered"
    FROM   "orderlines"
    WHERE  "order_id" = 423
    GROUP  BY "product_id"
) o ON o."product_id" = t."product_id"
WHERE "qty_to_pick" > 0
ORDER BY t."product_id", t."purchased", t."qty";
