```sql
--Description: 3) Check all inventory held in warehouse-1 locations for the products on order 423
SELECT i.*
FROM "inventory" AS i
JOIN "locations"  AS l ON l."id" = i."location_id"
WHERE l."warehouse" = 1
  AND i."product_id" IN (SELECT "product_id" FROM "orderlines" WHERE "order_id" = 423)
LIMIT 20;
```

```sql
--Description: 4) Add purchase date to every inventory record so we can later sort by oldest purchase first
SELECT i."id",
       i."location_id",
       i."product_id",
       i."qty",
       p."purchased"
FROM   "inventory" AS i
JOIN   "purchases" AS p ON p."id" = i."purchase_id"
WHERE  i."product_id" IN (SELECT "product_id" FROM "orderlines" WHERE "order_id" = 423)
  AND  i."location_id" IN (SELECT "id" FROM "locations" WHERE "warehouse" = 1)
LIMIT 20;
```

```sql
--Description: 5) Summarise on hand inventory by product in warehouse-1 (total available)
SELECT i."product_id",
       SUM(i."qty") AS "qty_on_hand"
FROM   "inventory" AS i
JOIN   "locations" AS l ON l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT "product_id" FROM "orderlines" WHERE "order_id" = 423)
GROUP  BY i."product_id";
```

```sql
--Description: 6) Confirm cumulative quantity needed for each product across all lines in order 423
SELECT "product_id",
       SUM("qty") AS "qty_ordered"
FROM   "orderlines"
WHERE  "order_id" = 423
GROUP  BY "product_id";
```

```sql
--Description: 7) Detailed list of candidate pick locations with purchase-date priority and smallest quantities first
SELECT i."product_id",
       l."aisle",
       l."position",
       i."qty",
       p."purchased"
FROM   "inventory" i
JOIN   "locations" l  ON l."id" = i."location_id"
JOIN   "purchases" p ON p."id" = i."purchase_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT "product_id" FROM "orderlines" WHERE "order_id" = 423)
ORDER  BY i."product_id",
          p."purchased",      -- older purchases first
          i."qty"             -- smaller lot sizes first
LIMIT 20;
```

```sql
--Description: 8) (Optional) Create running sum per product to simulate how much each location will supply
SELECT *
FROM (
    SELECT i."product_id",
           l."aisle",
           l."position",
           i."qty",
           p."purchased",
           SUM(i."qty") OVER (PARTITION BY i."product_id"
                              ORDER BY p."purchased", i."qty") AS "cumulative_qty"
    FROM   "inventory" i
    JOIN   "locations" l  ON l."id" = i."location_id"
    JOIN   "purchases" p ON p."id" = i."purchase_id"
    WHERE  l."warehouse" = 1
      AND  i."product_id" IN (SELECT "product_id" FROM "orderlines" WHERE "order_id" = 423)
)
LIMIT 20;
```

```sql
--Description: 9) (Optional) Compare cumulative running sum with quantity required, keeping only what will actually be picked
SELECT t."product_id",
       t."aisle",
       t."position",
       CASE
           WHEN t."cumulative_qty" - t."qty" < o."qty_ordered"
           THEN MIN(t."qty", o."qty_ordered" - (t."cumulative_qty" - t."qty"))
           ELSE 0
       END AS "qty_to_pick"
FROM (
    SELECT i."product_id",
           l."aisle",
           l."position",
           i."qty",
           p."purchased",
           SUM(i."qty") OVER (PARTITION BY i."product_id"
                              ORDER BY p."purchased", i."qty") AS "cumulative_qty"
    FROM   "inventory" i
    JOIN   "locations" l  ON l."id" = i."location_id"
    JOIN   "purchases" p ON p."id" = i."purchase_id"
    WHERE  l."warehouse" = 1
      AND  i."product_id" IN (SELECT "product_id" FROM "orderlines" WHERE "order_id" = 423)
) t
JOIN (
    SELECT "product_id", SUM("qty") AS "qty_ordered"
    FROM   "orderlines"
    WHERE  "order_id" = 423
    GROUP  BY "product_id"
) o ON o."product_id" = t."product_id"
WHERE "qty_to_pick" > 0
ORDER BY t."product_id", t."purchased", t."qty";
```

These queries progress from getting basic order information to producing a pick-list plan that obeys warehouse-1 availability, oldest-stock-first and smallest-lot-first rules, and matches the cumulative quantity required for each product on order 423.
