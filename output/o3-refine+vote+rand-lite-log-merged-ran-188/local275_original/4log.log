    WHERE mth >= '2016-01-01'
    GROUP BY product_id, DATE(mth)
),
-- 13‑month centred moving average (6 months before and after)
trend AS (
    SELECT
        product_id,
        mth,
        qty,
        AVG(qty) OVER (
            PARTITION BY product_id
            ORDER BY mth
            ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
        ) AS cma_qty
    FROM sales
),
-- seasonality‑adjusted ratio = actual / trend
ratios AS (
    SELECT
        product_id,
        mth,
        qty / cma_qty AS ratio
    FROM trend
    WHERE cma_qty IS NOT NULL                      -- ensure denominator
),
-- restrict to the twelve months of 2017
ratios_2017 AS (
    SELECT *
    FROM ratios
    WHERE mth BETWEEN '2017-01-01' AND '2017-12-31'
),
-- products whose ratio is > 2 in every 2017 month
qualified AS (
    SELECT
        product_id,
        MIN(ratio)  AS min_ratio_2017,
        COUNT(*)    AS months_present
    FROM ratios_2017
    GROUP BY product_id
)
SELECT
    p.id   AS product_id,
    p.name AS product_name
FROM qualified q
JOIN products p
  ON p.id = q.product_id
WHERE q.months_present = 12        -- all 12 months present
  AND q.min_ratio_2017 > 2         -- ratio above 2 every month
ORDER BY p.id;
```
