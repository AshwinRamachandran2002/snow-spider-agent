2025-05-02 07:54:59 - Thread-4053 (execute) - INFO - [Try to run SQL in self-refine]
```sql
WITH sales AS (
    SELECT 
        product_id,
        DATE(mth) AS mth,
        qty
    FROM monthly_sales
    WHERE mth >= '2016-01-01'
),
-- 3‑month centred moving average (one month before and after)
cma AS (
    SELECT
        product_id,
        mth,
        qty,
        AVG(qty) OVER (
            PARTITION BY product_id
            ORDER BY mth
            ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING
        ) AS cma_qty
    FROM sales
),
-- seasonality‑adjusted sales ratio
ratio_2017 AS (
    SELECT
        product_id,
        mth,
        qty / cma_qty AS ratio
    FROM cma
    WHERE mth BETWEEN '2017-01-01' AND '2017-12-31'
          AND cma_qty IS NOT NULL          -- need a valid moving average
),
check_products AS (
    SELECT
        product_id,
        MIN(ratio)  AS min_ratio_2017,
        COUNT(*)    AS months_present
    FROM ratio_2017
    GROUP BY product_id
)
SELECT product_id
FROM check_products
WHERE min_ratio_2017 > 2          -- above 2 for every month
  AND months_present = 12;        -- all 12 months of 2017 present
```
