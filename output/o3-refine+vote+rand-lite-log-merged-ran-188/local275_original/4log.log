```sql
WITH sales AS (
    /* aggregate in case a product has more than one record per month */
    SELECT
        product_id,
        date(mth) AS mth,
        SUM(qty) AS qty
    FROM monthly_sales
    WHERE mth >= '2016-01-01'
    GROUP BY product_id, date(mth)
),
/* 12‑month trailing moving average (seasonality baseline) */
cma AS (
    SELECT
        product_id,
        mth,
        qty,
        AVG(qty) OVER (
            PARTITION BY product_id
            ORDER BY mth
            ROWS BETWEEN 11 PRECEDING AND CURRENT ROW        -- 12 months
        ) AS cma_qty
    FROM sales
),
/* seasonality‑adjusted ratio = actual / moving‑average */
ratios AS (
    SELECT
        product_id,
        mth,
        qty / cma_qty AS ratio
    FROM cma
    WHERE cma_qty IS NOT NULL          -- ensure denominator exists
),
/* pick only the 12 months of 2017 */
r2017 AS (
    SELECT *
    FROM ratios
    WHERE mth BETWEEN '2017-01-01' AND '2017-12-31'
),
/* test the condition “above 2 every month” */
chk AS (
    SELECT
        product_id,
        MIN(ratio)  AS min_ratio,
        COUNT(*)    AS months_cnt
    FROM r2017
    GROUP BY product_id
)
SELECT product_id
FROM chk
WHERE min_ratio > 2          -- ratio above 2 for the whole year
  AND months_cnt = 12;       -- all 12 months present
```
