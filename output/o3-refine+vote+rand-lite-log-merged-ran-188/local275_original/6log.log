/*  products whose seasonality‑adjusted sales ratio (actual ÷ centred 12‑month
    moving average that excludes the current month) was above 2 in *every*
    calendar month of 2017                                               */

WITH centred AS (                   -- 6 months before + 6 months after
    SELECT
        product_id,
        mth,
        qty,
        SUM(qty)   OVER w AS sum13,     -- sum of the 13‑month window
        COUNT(qty) OVER w AS cnt13      -- number of months in the window
    FROM monthly_sales
    WHERE mth >= '2016-01-01'
    WINDOW w AS (
        PARTITION BY product_id
        ORDER BY mth
        ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
    )
),
cma AS (                             -- centred moving average *excluding* current
    SELECT
        product_id,
        mth,
        qty,
        CASE WHEN cnt13 > 1
             THEN (sum13 - qty) * 1.0 / (cnt13 - 1)      -- 12‑month average
        END AS cma
    FROM centred
),
ratio2017 AS (                       -- ratio for every month of 2017
    SELECT
        product_id,
        mth,
        qty / cma AS ratio
    FROM cma
    WHERE cma IS NOT NULL
      AND substr(mth,1,4) = '2017'
),
qualified AS (                       -- products with ratio > 2 for all 12 months
    SELECT product_id
    FROM ratio2017
    GROUP BY product_id
    HAVING COUNT(DISTINCT substr(mth,6,2)) = 12   -- data present for Jan‑Dec
       AND MIN(ratio) > 2                         -- lowest ratio still > 2
)
SELECT
    q.product_id,
    p.name
FROM qualified AS q
JOIN products AS p
  ON p.id = q.product_id
ORDER BY q.product_id;
```
