2025-05-02 07:55:35 - Thread-4055 (execute) - INFO - [Try to run SQL in self-refine]
```sql
WITH cma AS (            -- centred 13‑month (6 preceding + 6 following) moving average
    SELECT
        product_id,
        mth,
        qty,
        AVG(qty) OVER (
            PARTITION BY product_id
            ORDER BY mth
            ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
        ) AS cma
    FROM monthly_sales
    WHERE mth >= '2016-01-01'
),
ratio2017 AS (           -- ratio of actual sales to centred moving average for 2017
    SELECT
        product_id,
        mth,
        qty / cma AS ratio
    FROM cma
    WHERE substr(mth,1,4) = '2017'
      AND cma IS NOT NULL
),
summary AS (             -- products whose ratio is > 2 for every 2017 month
    SELECT
        product_id,
        COUNT(*)  AS months_present,
        MIN(ratio) AS min_ratio
    FROM ratio2017
    GROUP BY product_id
    HAVING months_present = 12       -- all twelve months present
       AND min_ratio > 2             -- ratio always above 2
)
SELECT
    s.product_id,
    p.name
FROM summary AS s
JOIN products AS p
  ON p.id = s.product_id
ORDER BY s.product_id;
```
