Query:
--Description: 4) Confirm the sex values appearing in studies whose BodyPartExamined contains the substring “MEDIA”.  
--MEDIA rows exist in DICOM_ALL and DICOM_PIVOT, so union those tables and list distinct PatientSex codes.
SELECT DISTINCT "PatientSex"
FROM (
        SELECT "PatientSex"
        FROM IDC.IDC_V17.DICOM_ALL
        WHERE "BodyPartExamined" ILIKE '%MEDIA%'
        
        UNION
        
        SELECT "PatientSex"
        FROM IDC.IDC_V17.DICOM_PIVOT
        WHERE "BodyPartExamined" ILIKE '%MEDIA%'
) AS combined_sex
LIMIT 20
Answer:
PatientSex
F
M
Query:
--Description: 5) List male patients who are exactly 18 years old in “MEDIA” studies after 2014-09-01.  
--Patient-level details (PatientID, Age, Sex, StudyDate) reside in DICOM_PIVOT, so query this table directly.
SELECT "PatientID",
       "StudyInstanceUID",
       "SeriesInstanceUID",
       "StudyDate",
       "PatientAge",
       "PatientSex",
       "BodyPartExamined"
FROM IDC.IDC_V17.DICOM_PIVOT
WHERE "BodyPartExamined" ILIKE '%MEDIA%'
  AND "PatientSex" = 'M'
  AND "PatientAge" ILIKE '018%'
  AND "StudyDate" > '2014-09-01'
LIMIT 20
