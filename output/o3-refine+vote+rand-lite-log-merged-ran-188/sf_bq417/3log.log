Query:
--Description: 9) Identify the collections that contain these “MEDIA”, 18-year-old male studies by joining DICOM_PIVOT filters with DICOM_ALL collection fields.  
SELECT DISTINCT a."collection_id",
       a."collection_name"
FROM IDC.IDC_V17.DICOM_ALL   AS a
JOIN IDC.IDC_V17.DICOM_PIVOT AS p
  ON a."SeriesInstanceUID" = p."SeriesInstanceUID"
WHERE p."BodyPartExamined" ILIKE '%MEDIA%'
  AND p."PatientSex" = 'M'
  AND p."PatientAge" ILIKE '018%'
  AND p."StudyDate" > '2014-09-01'
LIMIT 20
