Query:
--Description: 8) Compute the total size (MB) of each qualifying series under the broader “MEDIA” criteria by joining DICOM_PIVOT filters with DICOM_ALL sizes.  
SELECT a."SeriesInstanceUID",
       ROUND(SUM(a."instance_size")/1000000, 2) AS "series_size_MB"
FROM IDC.IDC_V17.DICOM_ALL   AS a
JOIN IDC.IDC_V17.DICOM_PIVOT AS p
  ON a."SeriesInstanceUID" = p."SeriesInstanceUID"
WHERE p."BodyPartExamined" ILIKE '%MEDIA%'
  AND p."PatientSex" = 'M'
  AND p."PatientAge" ILIKE '018%'
  AND p."StudyDate" > '2014-09-01'
GROUP BY a."SeriesInstanceUID"
LIMIT 20
