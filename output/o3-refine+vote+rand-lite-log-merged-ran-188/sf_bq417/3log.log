Query:
--Description: 7) Show storage URLs and instance sizes for series that meet the relaxed “MEDIA” condition by joining DICOM_PIVOT (filters) with DICOM_ALL (storage info).  
SELECT a."SeriesInstanceUID",
       a."series_aws_url",
       a."instance_size",
       a."UID"
FROM IDC.IDC_V17.DICOM_ALL   AS a
JOIN IDC.IDC_V17.DICOM_PIVOT AS p
  ON a."SeriesInstanceUID" = p."SeriesInstanceUID"
WHERE p."BodyPartExamined" ILIKE '%MEDIA%'
  AND p."PatientSex" = 'M'
  AND p."PatientAge" ILIKE '018%'
  AND p."StudyDate" > '2014-09-01'
LIMIT 20
