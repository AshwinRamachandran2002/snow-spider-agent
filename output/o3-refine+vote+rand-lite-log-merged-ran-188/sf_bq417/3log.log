Query:
--Description: 6) Retrieve distinct StudyInstanceUID / SeriesInstanceUID pairs that satisfy the “MEDIA”, male, 18 y, post-2014-09-01 conditions (using DICOM_PIVOT).  
SELECT DISTINCT "StudyInstanceUID",
       "SeriesInstanceUID"
FROM IDC.IDC_V17.DICOM_PIVOT
WHERE "BodyPartExamined" ILIKE '%MEDIA%'
  AND "PatientSex" = 'M'
  AND "PatientAge" ILIKE '018%'
  AND "StudyDate" > '2014-09-01'
LIMIT 20
