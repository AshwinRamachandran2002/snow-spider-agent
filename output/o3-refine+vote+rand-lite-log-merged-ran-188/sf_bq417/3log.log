LIMIT 20;
```

```sql
--Description: 6) Retrieve distinct study / series combinations that satisfy the task conditions  
SELECT DISTINCT "StudyInstanceUID",
       "SeriesInstanceUID"
FROM IDC.IDC_V17.DICOM_METADATA
WHERE "BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND "PatientSex" = 'M'
  AND "PatientAge" ILIKE '018%'
  AND "StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description: 7) Look at the storage URLs and instance sizes for one qualifying series  
SELECT a."SeriesInstanceUID",
       a."series_aws_url",
       a."instance_size",
       a."UID"
FROM IDC.IDC_V17.DICOM_ALL        AS a
JOIN IDC.IDC_V17.DICOM_METADATA   AS m
  ON a."SeriesInstanceUID" = m."SeriesInstanceUID"
WHERE m."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND m."PatientSex" = 'M'
  AND m."PatientAge" ILIKE '018%'
  AND m."StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description: 8) Compute the total size (in MB) of each qualifying series  
SELECT a."SeriesInstanceUID",
       ROUND(SUM(a."instance_size")/1000000, 2) AS "series_size_MB"
FROM IDC.IDC_V17.DICOM_ALL        AS a
JOIN IDC.IDC_V17.DICOM_METADATA   AS m
  ON a."SeriesInstanceUID" = m."SeriesInstanceUID"
WHERE m."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND m."PatientSex" = 'M'
  AND m."PatientAge" ILIKE '018%'
  AND m."StudyDate" > '2014-09-01'
GROUP BY a."SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 9) Identify the collections that contain these MEDIASTINUM, 18-year-old male studies  
SELECT DISTINCT a."collection_id",
       a."collection_name"
FROM IDC.IDC_V17.DICOM_ALL        AS a
JOIN IDC.IDC_V17.DICOM_METADATA   AS m
  ON a."SeriesInstanceUID" = m."SeriesInstanceUID"
WHERE m."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND m."PatientSex" = 'M'
  AND m."PatientAge" ILIKE '018%'
  AND m."StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description: 10) Final combined query: patient, study, series, storage URL, and total size (MB)  
SELECT m."PatientID",
       m."StudyInstanceUID",
       m."SeriesInstanceUID",
       m."StudyDate",
       m."PatientAge",
       m."PatientSex",
       m."BodyPartExamined",
       a."series_aws_url",
       ROUND(SUM(a."instance_size")/1000000, 2) AS "series_size_MB"
FROM IDC.IDC_V17.DICOM_METADATA   AS m
JOIN IDC.IDC_V17.DICOM_ALL        AS a
  ON a."SeriesInstanceUID" = m."SeriesInstanceUID"
WHERE m."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND m."PatientSex" = 'M'
  AND m."PatientAge" ILIKE '018%'
  AND m."StudyDate" > '2014-09-01'
GROUP BY m."PatientID",
         m."StudyInstanceUID",
         m."SeriesInstanceUID",
         m."StudyDate",
         m."PatientAge",
