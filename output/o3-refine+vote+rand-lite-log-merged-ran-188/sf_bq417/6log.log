  AND   "PatientAge" = '018Y'
LIMIT 20;
```

```sql
-- Description: Combine the age and mediastinum filters with the post-2014-09-01 study-date requirement to see if any rows surface.  
SELECT  "PatientID",
        "PatientSex",
        "PatientAge",
        "BodyPartExamined",
        "StudyDate",
        "SeriesInstanceUID",
        "StudyInstanceUID"
FROM    "IDC"."IDC_V17"."DICOM_ALL"
