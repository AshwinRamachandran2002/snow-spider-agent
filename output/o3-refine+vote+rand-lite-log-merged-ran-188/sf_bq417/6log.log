Query:
-- Description: Demonstrate how to total instance sizes per series (bytes → MB) for the filtered cohort.  
SELECT  "SeriesInstanceUID",
        ROUND(SUM("instance_size") / 1000000.0, 2) AS "series_size_MB"
FROM    "IDC"."IDC_V17"."DICOM_ALL"
WHERE   "PatientSex"          = 'M'
  AND   "PatientAge"          = '018Y'
  AND   "BodyPartExamined"    = 'MEDIASTINUM'
  AND   "StudyDate"           > '2014-09-01'
GROUP BY "SeriesInstanceUID"
LIMIT 20;
