  AND   "PatientAge"          = '018Y'
  AND   "BodyPartExamined"    = 'MEDIASTINUM'
  AND   "StudyDate"           > '2014-09-01'
LIMIT 20;
```

```sql
-- Description: List distinct study-UIDs that satisfy all task filters so we can later aggregate at study or series level.  
SELECT DISTINCT
        "StudyInstanceUID"
FROM    "IDC"."IDC_V17"."DICOM_ALL"
WHERE   "PatientSex"          = 'M'
  AND   "PatientAge"          = '018Y'
  AND   "BodyPartExamined"    = 'MEDIASTINUM'
  AND   "StudyDate"           > '2014-09-01'
LIMIT 20;
```

```sql
-- Description: Retrieve series-level identifiers plus the AWS folder URL for filtered rows (helps locate data in storage).  
SELECT DISTINCT
        "SeriesInstanceUID",
        "StudyInstanceUID",
        "series_aws_url"
FROM    "IDC"."IDC_V17"."DICOM_ALL"
WHERE   "PatientSex"          = 'M'
  AND   "PatientAge"          = '018Y'
  AND   "BodyPartExamined"    = 'MEDIASTINUM'
  AND   "StudyDate"           > '2014-09-01'
LIMIT 20;
```

```sql
-- Description: Peek at per-instance sizes to gauge raw byte counts before converting to megabytes.  
SELECT  "SeriesInstanceUID",
        "StudyInstanceUID",
        "instance_size"
FROM    "IDC"."IDC_V17"."DICOM_ALL"
WHERE   "PatientSex"          = 'M'
  AND   "PatientAge"          = '018Y'
  AND   "BodyPartExamined"    = 'MEDIASTINUM'
  AND   "StudyDate"           > '2014-09-01'
LIMIT 20;
```

```sql
-- Description: Bring in the pivot table to cross-check that the same patient/series exist there and note any GCS URLs.  
SELECT  p."PatientID",
        p."SeriesInstanceUID",
        p."StudyInstanceUID",
        p."gcs_url",
        p."instance_size"
FROM    "IDC"."IDC_V17"."DICOM_PIVOT"  p
WHERE   p."PatientSex"       = 'M'
  AND   p."PatientAge"       = '018Y'
  AND   p."BodyPartExamined" = 'MEDIASTINUM'
  AND   p."StudyDate"        > '2014-09-01'
LIMIT 20;
```

```sql
-- Description: Demonstrate how to total instance sizes per series (bytes → MB) for the filtered cohort.  
SELECT  "SeriesInstanceUID",
        ROUND(SUM("instance_size") / 1000000.0, 2) AS "series_size_MB"
FROM    "IDC"."IDC_V17"."DICOM_ALL"
WHERE   "PatientSex"          = 'M'
  AND   "PatientAge"          = '018Y'
  AND   "BodyPartExamined"    = 'MEDIASTINUM'
  AND   "StudyDate"           > '2014-09-01'
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```
