LIMIT 20;
```

```sql
--Description: Preview rows that already satisfy all major conditions (male, 18 years old, mediastinum, study date after 2014-09-01).
SELECT "PatientID",
       "StudyDate",
       "PatientAge",
       "PatientSex",
       "BodyPartExamined",
       "StudyInstanceUID",
       "SeriesInstanceUID"
FROM "IDC"."IDC_V17"."DICOM_PIVOT"
WHERE "PatientSex" = 'M'
  AND "PatientAge"  LIKE '018%'
  AND "BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND "StudyDate"    >  '2014-09-01'
LIMIT 20;
```

```sql
--Description: List the unique series identifiers for the qualifying male 18-year-old mediastinum studies.
SELECT DISTINCT "SeriesInstanceUID"
FROM "IDC"."IDC_V17"."DICOM_PIVOT"
WHERE "PatientSex" = 'M'
  AND "PatientAge"  LIKE '018%'
  AND "BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND "StudyDate"    >  '2014-09-01'
LIMIT 20;
```

```sql
--Description: Retrieve the AWS storage URL associated with each qualifying series.
SELECT DISTINCT a."SeriesInstanceUID",
                b."series_aws_url"
FROM "IDC"."IDC_V17"."DICOM_PIVOT" a
JOIN "IDC"."IDC_V17"."DICOM_ALL"   b
  ON a."SeriesInstanceUID" = b."SeriesInstanceUID"
WHERE a."PatientSex" = 'M'
  AND a."PatientAge"  LIKE '018%'
  AND a."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND a."StudyDate"    >  '2014-09-01'
LIMIT 20;
```

```sql
--Description: Calculate the total data volume (MB) for each qualifying series.
SELECT a."SeriesInstanceUID",
       ROUND(SUM(b."instance_size") / 1000000, 2) AS "series_size_MB"
FROM "IDC"."IDC_V17"."DICOM_PIVOT" a
JOIN "IDC"."IDC_V17"."DICOM_ALL"   b
  ON a."SeriesInstanceUID" = b."SeriesInstanceUID"
WHERE a."PatientSex" = 'M'
  AND a."PatientAge"  LIKE '018%'
  AND a."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND a."StudyDate"    >  '2014-09-01'
GROUP BY a."SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: Assemble patient, study, and series identifiers together with the computed series size in MB.
SELECT a."PatientID",
       a."StudyInstanceUID",
       a."SeriesInstanceUID",
       ROUND(SUM(b."instance_size") / 1000000, 2) AS "series_size_MB"
FROM "IDC"."IDC_V17"."DICOM_PIVOT" a
JOIN "IDC"."IDC_V17"."DICOM_ALL"   b
  ON a."SeriesInstanceUID" = b."SeriesInstanceUID"
WHERE a."PatientSex" = 'M'
  AND a."PatientAge"  LIKE '018%'
  AND a."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND a."StudyDate"    >  '2014-09-01'
GROUP BY a."PatientID",
         a."StudyInstanceUID",
         a."SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: Extend the previous query by including the series-level AWS folder location.
SELECT a."PatientID",
       a."StudyInstanceUID",
       a."SeriesInstanceUID",
       MIN(b."series_aws_url")                       AS "series_aws_url",
       ROUND(SUM(b."instance_size") / 1000000, 2)    AS "series_size_MB"
FROM "IDC"."IDC_V17"."DICOM_PIVOT" a
JOIN "IDC"."IDC_V17"."DICOM_ALL"   b
  ON a."SeriesInstanceUID" = b."SeriesInstanceUID"
WHERE a."PatientSex" = 'M'
  AND a."PatientAge"  LIKE '018%'
  AND a."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND a."StudyDate"    >  '2014-09-01'
GROUP BY a."PatientID",
         a."StudyInstanceUID",
         a."SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: Summarize each qualifying study (not just series) with how many series it contains and the total study size in MB.
SELECT a."PatientID",
       a."StudyInstanceUID",
       COUNT(DISTINCT a."SeriesInstanceUID")         AS "series_count",
       ROUND(SUM(b."instance_size") / 1000000, 2)    AS "study_size_MB"
FROM "IDC"."IDC_V17"."DICOM_PIVOT" a
JOIN "IDC"."IDC_V17"."DICOM_ALL"   b
  ON a."SeriesInstanceUID" = b."SeriesInstanceUID"
WHERE a."PatientSex" = 'M'
  AND a."PatientAge"  LIKE '018%'
  AND a."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND a."StudyDate"    >  '2014-09-01'
GROUP BY a."PatientID",
         a."StudyInstanceUID"
LIMIT 20;
```

```sql
--Description: Double-check that every retrieved record has a study date strictly after 2014-09-01.
SELECT DISTINCT a."StudyDate"
FROM "IDC"."IDC_V17"."DICOM_PIVOT" a
WHERE a."PatientSex" = 'M'
  AND a."PatientAge"  LIKE '018%'
  AND a."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND a."StudyDate"    >  '2014-09-01'
ORDER BY a."StudyDate"
LIMIT 20;
```
