Query:
-- Description: Retrieve candidate Series from DICOM_PIVOT then join to DICOM_ALL to pick up AWS storage location  
SELECT p."PatientID",
       p."StudyInstanceUID",
       p."SeriesInstanceUID",
       a."series_aws_url",
       a."instance_size"
FROM   "IDC"."IDC_V17"."DICOM_PIVOT"  p
JOIN   "IDC"."IDC_V17"."DICOM_ALL"    a
  ON   p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  p."PatientSex" = 'M'
  AND  p."PatientAge" ILIKE '018%'
  AND  p."BodyPartExamined" = 'MEDIASTINUM'
  AND  p."StudyDate" > '2014-09-01'
LIMIT 20;
