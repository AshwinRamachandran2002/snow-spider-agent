```sql
-- Description: Quick look at a few mediastinum rows in DICOM_PIVOT to verify useful fields are present  
SELECT "PatientID",
       "PatientSex",
       "PatientAge",
       "BodyPartExamined",
       "StudyDate",
       "StudyInstanceUID",
       "SeriesInstanceUID",
       "gcs_url"
FROM "IDC"."IDC_V17"."DICOM_PIVOT"
WHERE "BodyPartExamined" = 'MEDIASTINUM'
LIMIT 20;
```

```sql
-- Description: Identify 18-year-old male patients (age starts with 018 and sex = 'M') with mediastinum studies after 2014-09-01 in DICOM_PIVOT  
SELECT DISTINCT "PatientID",
       "StudyDate",
       "StudyInstanceUID",
       "SeriesInstanceUID"
FROM "IDC"."IDC_V17"."DICOM_PIVOT"
WHERE "PatientSex" = 'M'
  AND "PatientAge" ILIKE '018%'
  AND "BodyPartExamined" = 'MEDIASTINUM'
  AND "StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
-- Description: Do the same basic filter in DICOM_ALL to confirm overlap and locate AWS URLs  
SELECT DISTINCT "SeriesInstanceUID",
       "StudyInstanceUID",
       "series_aws_url",
       "instance_size"
FROM "IDC"."IDC_V17"."DICOM_ALL"
WHERE "PatientSex" = 'M'
  AND "PatientAge" ILIKE '018%'
  AND "BodyPartExamined" = 'MEDIASTINUM'
  AND "StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
-- Description: Retrieve candidate Series from DICOM_PIVOT then join to DICOM_ALL to pick up AWS storage location  
SELECT p."PatientID",
       p."StudyInstanceUID",
       p."SeriesInstanceUID",
       a."series_aws_url",
       a."instance_size"
FROM   "IDC"."IDC_V17"."DICOM_PIVOT"  p
JOIN   "IDC"."IDC_V17"."DICOM_ALL"    a
  ON   p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  p."PatientSex" = 'M'
  AND  p."PatientAge" ILIKE '018%'
  AND  p."BodyPartExamined" = 'MEDIASTINUM'
  AND  p."StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
-- Description: Aggregate total size (in bytes) for each qualifying series  
SELECT a."SeriesInstanceUID",
       SUM(a."instance_size") AS "total_bytes"
FROM   "IDC"."IDC_V17"."DICOM_PIVOT"  p
JOIN   "IDC"."IDC_V17"."DICOM_ALL"    a
  ON   p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  p."PatientSex" = 'M'
  AND  p."PatientAge" ILIKE '018%'
  AND  p."BodyPartExamined" = 'MEDIASTINUM'
  AND  p."StudyDate" > '2014-09-01'
GROUP  BY a."SeriesInstanceUID"
LIMIT 20;
```

```sql
-- Description: Convert aggregated size into MB (divide by 1,000,000 and round to 2 decimals)  
SELECT a."SeriesInstanceUID",
       ROUND(SUM(a."instance_size")/1000000, 2) AS "series_size_MB"
FROM   "IDC"."IDC_V17"."DICOM_PIVOT"  p
JOIN   "IDC"."IDC_V17"."DICOM_ALL"    a
  ON   p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  p."PatientSex" = 'M'
  AND  p."PatientAge" ILIKE '018%'
  AND  p."BodyPartExamined" = 'MEDIASTINUM'
  AND  p."StudyDate" > '2014-09-01'
GROUP  BY a."SeriesInstanceUID"
LIMIT 20;
```

```sql
-- Description: Produce study-level summary (sum all series within a study) for qualifying cohort  
SELECT p."PatientID",
       p."StudyInstanceUID",
       ROUND(SUM(a."instance_size")/1000000, 2) AS "study_size_MB"
FROM   "IDC"."IDC_V17"."DICOM_PIVOT"  p
JOIN   "IDC"."IDC_V17"."DICOM_ALL"    a
  ON   p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  p."PatientSex" = 'M'
  AND  p."PatientAge" ILIKE '018%'
  AND  p."BodyPartExamined" = 'MEDIASTINUM'
  AND  p."StudyDate" > '2014-09-01'
GROUP  BY p."PatientID", p."StudyInstanceUID"
LIMIT 20;
```

```sql
-- Description: Final query – return all required identification, study & series info, storage URL, and series size (MB) for each matching series  
SELECT p."PatientID",
       p."StudyInstanceUID",
       p."SeriesInstanceUID",
       a."series_aws_url",
       ROUND(SUM(a."instance_size")/1000000, 2) AS "series_size_MB"
FROM   "IDC"."IDC_V17"."DICOM_PIVOT"  p
JOIN   "IDC"."IDC_V17"."DICOM_ALL"    a
  ON   p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  p."PatientSex" = 'M'
  AND  p."PatientAge" ILIKE '018%'          -- exactly 18 years old
  AND  p."BodyPartExamined" = 'MEDIASTINUM' -- required body part
  AND  p."StudyDate" > '2014-09-01'         -- strictly after 2014-09-01
GROUP  BY p."PatientID",
          p."StudyInstanceUID",
          p."SeriesInstanceUID",
          a."series_aws_url"
LIMIT 20;
```
