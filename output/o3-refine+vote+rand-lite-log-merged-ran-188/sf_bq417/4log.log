Query:
-- Description: Final query – return all required identification, study & series info, storage URL, and series size (MB) for each matching series  
SELECT p."PatientID",
       p."StudyInstanceUID",
       p."SeriesInstanceUID",
       a."series_aws_url",
       ROUND(SUM(a."instance_size")/1000000, 2) AS "series_size_MB"
FROM   "IDC"."IDC_V17"."DICOM_PIVOT"  p
JOIN   "IDC"."IDC_V17"."DICOM_ALL"    a
  ON   p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  p."PatientSex" = 'M'
  AND  p."PatientAge" ILIKE '018%'          -- exactly 18 years old
  AND  p."BodyPartExamined" = 'MEDIASTINUM' -- required body part
  AND  p."StudyDate" > '2014-09-01'         -- strictly after 2014-09-01
GROUP  BY p."PatientID",
          p."StudyInstanceUID",
          p."SeriesInstanceUID",
          a."series_aws_url"
LIMIT 20;
Answer:
PatientID,StudyInstanceUID,SeriesInstanceUID,series_aws_url,series_size_MB
