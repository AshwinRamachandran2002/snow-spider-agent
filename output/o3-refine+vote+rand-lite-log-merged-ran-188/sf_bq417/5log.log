```sql
--Description: Join metadata with storage info to view AWS location and instance size for each qualifying image  
SELECT DISTINCT
       m."SeriesInstanceUID",
       m."StudyInstanceUID",
       m."PatientID",
       m."PatientAge",
       m."PatientSex",
       m."BodyPartExamined",
       m."StudyDate",
       a."series_aws_url",
       a."instance_size"
FROM IDC.IDC_V17.DICOM_METADATA  m
JOIN IDC.IDC_V17.DICOM_ALL       a
  ON m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE m."PatientAge" ILIKE '018%'
  AND m."PatientSex" = 'M'
  AND m."BodyPartExamined" ILIKE '%MEDIAST%'
  AND m."StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description: Aggregate total byte size per series and convert to megabytes (MB) for the filtered cohort  
SELECT
       m."SeriesInstanceUID",
       SUM(a."instance_size") / 1000000.0  AS "series_size_MB"
FROM IDC.IDC_V17.DICOM_METADATA  m
JOIN IDC.IDC_V17.DICOM_ALL       a
  ON m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE m."PatientAge" ILIKE '018%'
  AND m."PatientSex" = 'M'
  AND m."BodyPartExamined" ILIKE '%MEDIAST%'
  AND m."StudyDate" > '2014-09-01'
GROUP BY m."SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: Count how many qualifying series appear in each study and show the study date reference  
SELECT
       m."StudyInstanceUID",
       COUNT(DISTINCT m."SeriesInstanceUID") AS "series_count",
       MIN(m."StudyDate")                    AS "study_date"
FROM IDC.IDC_V17.DICOM_METADATA m
WHERE m."PatientAge" ILIKE '018%'
  AND m."PatientSex" = 'M'
  AND m."BodyPartExamined" ILIKE '%MEDIAST%'
  AND m."StudyDate" > '2014-09-01'
GROUP BY m."StudyInstanceUID"
LIMIT 20;
```

