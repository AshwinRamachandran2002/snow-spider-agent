Query:
--Description:  Generate the per-series AWS storage location and total series size (MB) for all records whose PatientAge
--              begins with “18” and whose StudyDate is after 2014-09-01.  These conditions have already returned valid
--              rows (e.g., ages “181M” and “182M”) in earlier steps, so the query is kept as-is.  
SELECT
       p."SeriesInstanceUID",
       a."series_aws_url",
       ROUND(SUM(a."instance_size") / 1000000.0, 2) AS "series_size_MB"
FROM IDC.IDC_V17.DICOM_PIVOT p
JOIN IDC.IDC_V17.DICOM_ALL   a
  ON p."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE p."PatientAge" ILIKE '18%'
  AND p."StudyDate" > '2014-09-01'
GROUP BY p."SeriesInstanceUID", a."series_aws_url"
LIMIT 20
