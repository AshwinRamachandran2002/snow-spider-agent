Query:
--Description:  Count how many qualifying “18-prefix” series appear in each study (StudyInstanceUID)  
--              where the earliest study date is after 2014-09-01.  
SELECT
       p."StudyInstanceUID",
       COUNT(DISTINCT p."SeriesInstanceUID") AS "series_count",
       MIN(p."StudyDate")                    AS "study_date"
FROM IDC.IDC_V17.DICOM_PIVOT p
WHERE p."PatientAge" ILIKE '18%'
  AND p."StudyDate" > '2014-09-01'
GROUP BY p."StudyInstanceUID"
LIMIT 20
