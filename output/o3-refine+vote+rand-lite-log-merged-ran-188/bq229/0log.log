```sql
--Description: 1) Find the label_name that corresponds to the English word “Cat”.
SELECT
  label_name,
  label_display_name
FROM `bigquery-public-data.open_images.dict`
WHERE LOWER(label_display_name) = 'cat'
LIMIT 20;
```

```sql
--Description: 2) Inspect some rows from the labels table that use the cat label.
SELECT
  image_id,
  source,
  confidence
FROM `bigquery-public-data.open_images.labels`
WHERE label_name = '/m/01yrx'
LIMIT 20;
```

```sql
--Description: 3) Look only at cat labels that were given the highest confidence (1).
SELECT
  image_id,
  confidence
FROM `bigquery-public-data.open_images.labels`
WHERE label_name = '/m/01yrx'
  AND confidence = 1
LIMIT 20;
```

```sql
--Description: 4) Pull a sample of distinct image URLs whose images are confidently labeled as cats.
SELECT DISTINCT
  i.original_url
FROM `bigquery-public-data.open_images.labels` AS l
JOIN `bigquery-public-data.open_images.images` AS i
  ON l.image_id = i.image_id
WHERE l.label_name = '/m/01yrx'
  AND l.confidence = 1
LIMIT 20;
```

```sql
--Description: 5) Count how many distinct image URLs are confidently labeled as cats.
SELECT
  COUNT(DISTINCT i.original_url) AS cat_url_count
FROM `bigquery-public-data.open_images.labels` AS l
JOIN `bigquery-public-data.open_images.images` AS i
  ON l.image_id = i.image_id
WHERE l.label_name = '/m/01yrx'
  AND l.confidence = 1
LIMIT 20;
```

```sql
--Description: 6) Count the total number of distinct image URLs in the entire images table.
SELECT
  COUNT(DISTINCT original_url) AS total_url_count
FROM `bigquery-public-data.open_images.images`
LIMIT 20;
```

```sql
--Description: 7) Count distinct image URLs that have NO cat label at all (all confidence levels).
WITH cat_images AS (
  SELECT DISTINCT image_id
  FROM `bigquery-public-data.open_images.labels`
  WHERE label_name = '/m/01yrx'
)
SELECT
  COUNT(DISTINCT i.original_url) AS other_url_count
FROM `bigquery-public-data.open_images.images` AS i
LEFT JOIN cat_images AS c
  ON i.image_id = c.image_id
WHERE c.image_id IS NULL
LIMIT 20;
```

```sql
--Description: 8) Final query – return both counts in one shot: “cat” URLs vs “other” URLs.
WITH cat_urls AS (
  SELECT DISTINCT i.original_url
  FROM `bigquery-public-data.open_images.labels` AS l
  JOIN `bigquery-public-data.open_images.images` AS i
    ON l.image_id = i.image_id
  WHERE l.label_name = '/m/01yrx'
    AND l.confidence = 1
),
all_urls AS (
  SELECT DISTINCT original_url
  FROM `bigquery-public-data.open_images.images`
)
SELECT
  (SELECT COUNT(*) FROM cat_urls)  AS cat_url_count,
  (SELECT COUNT(*) FROM all_urls) - (SELECT COUNT(*) FROM cat_urls) AS other_url_count
LIMIT 20;
```
