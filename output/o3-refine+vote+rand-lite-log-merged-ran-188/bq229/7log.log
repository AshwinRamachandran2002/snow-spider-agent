```sql
--Description: Confirm the “Cat” label and its machine ID.
SELECT label_name, label_display_name
FROM `bigquery-public-data.open_images.dict`
WHERE label_display_name = 'Cat'
LIMIT 20;
```

```sql
--Description: Look at some bounding–box annotations that are certainly “Cat” (confidence = 1).
SELECT image_id, label_name, confidence
FROM `bigquery-public-data.open_images.annotations_bbox`
WHERE label_name = '/m/01yrx' AND confidence = 1
LIMIT 20;
```

```sql
--Description: Join those cat–annotated image-ids with the image table to see their URL.
SELECT a.image_id, i.original_url
FROM `bigquery-public-data.open_images.annotations_bbox` AS a
JOIN `bigquery-public-data.open_images.images`        AS i
ON a.image_id = i.image_id
WHERE a.label_name = '/m/01yrx' AND a.confidence = 1
LIMIT 20;
```

```sql
--Description: How many DISTINCT URLs belong to “cat” images?
SELECT COUNT(DISTINCT i.original_url) AS cat_url_count
FROM `bigquery-public-data.open_images.annotations_bbox` AS a
JOIN `bigquery-public-data.open_images.images`        AS i
ON a.image_id = i.image_id
WHERE a.label_name = '/m/01yrx' AND a.confidence = 1
LIMIT 20;
```

```sql
--Description: Grab a quick list of unique image_ids that are cats (for later anti-join).
SELECT DISTINCT image_id
FROM `bigquery-public-data.open_images.annotations_bbox`
WHERE label_name = '/m/01yrx' AND confidence = 1
LIMIT 20;
```

```sql
--Description: Total count of DISTINCT image URLs in the full images table.
SELECT COUNT(DISTINCT original_url) AS total_url_count
FROM `bigquery-public-data.open_images.images`
LIMIT 20;
```

```sql
--Description: Number of DISTINCT URLs whose images have NO cat annotation at all (“other”).
SELECT COUNT(DISTINCT i.original_url) AS other_url_count
FROM `bigquery-public-data.open_images.images` AS i
LEFT JOIN (
  SELECT DISTINCT image_id
  FROM `bigquery-public-data.open_images.annotations_bbox`
  WHERE label_name = '/m/01yrx' AND confidence = 1
) AS c
ON i.image_id = c.image_id
WHERE c.image_id IS NULL
LIMIT 20;
```

```sql
--Description: One-query view of both groups, counting by DISTINCT original_url.
SELECT
  SUM(CASE WHEN c.image_id IS NOT NULL THEN 1 ELSE 0 END) AS cat_image_url_cnt,
  SUM(CASE WHEN c.image_id IS NULL  THEN 1 ELSE 0 END) AS other_image_url_cnt
FROM `bigquery-public-data.open_images.images` AS i
LEFT JOIN (
  SELECT DISTINCT image_id
  FROM `bigquery-public-data.open_images.annotations_bbox`
  WHERE label_name = '/m/01yrx' AND confidence = 1
) AS c
ON i.image_id = c.image_id
LIMIT 20;
```

```sql
--Description: Final answer using CTEs—clean separation of “cat” URLs and all URLs, then subtraction.
WITH cat_images AS (
  SELECT DISTINCT i.original_url
  FROM `bigquery-public-data.open_images.annotations_bbox` AS a
  JOIN `bigquery-public-data.open_images.images`          AS i
    ON a.image_id = i.image_id
  WHERE a.label_name = '/m/01yrx' AND a.confidence = 1
    AND i.original_url IS NOT NULL
),
all_images AS (
  SELECT DISTINCT original_url
  FROM `bigquery-public-data.open_images.images`
  WHERE original_url IS NOT NULL
)
SELECT
  (SELECT COUNT(*) FROM cat_images)                         AS cat_url_count,
  (SELECT COUNT(*) FROM all_images) -
  (SELECT COUNT(*) FROM cat_images)                         AS other_url_count
LIMIT 20;
```
