Query:
--Description: How many DISTINCT URLs belong to “cat” images?
SELECT COUNT(DISTINCT i.original_url) AS cat_url_count
FROM `bigquery-public-data.open_images.annotations_bbox` AS a
JOIN `bigquery-public-data.open_images.images`        AS i
ON a.image_id = i.image_id
WHERE a.label_name = '/m/01yrx' AND a.confidence = 1
LIMIT 20;
