```sql
--Description: Look-up the dictionary entry whose display name is “cat”.
SELECT *
FROM `bigquery-public-data.open_images.dict`
WHERE LOWER(label_display_name) = 'cat'
LIMIT 20;
```

```sql
--Description: Verify the unique label_name that corresponds to “cat”.
SELECT DISTINCT label_name
FROM `bigquery-public-data.open_images.dict`
WHERE LOWER(label_display_name) = 'cat'
LIMIT 20;
```

```sql
--Description: Inspect a few `labels` rows that positively mark an image as “cat”.
SELECT *
FROM `bigquery-public-data.open_images.labels`
WHERE label_name = '/m/01yrx'
  AND confidence = 1
LIMIT 20;
```

```sql
--Description: Pull distinct image_ids that have a positive cat label.
SELECT DISTINCT image_id
FROM `bigquery-public-data.open_images.labels`
WHERE label_name = '/m/01yrx'
  AND confidence = 1
LIMIT 20;
```

```sql
--Description: Join to the `images` table to see sample URLs of cat images.
SELECT i.image_id, i.original_url
FROM `bigquery-public-data.open_images.images`   AS i
JOIN (
  SELECT DISTINCT image_id
  FROM `bigquery-public-data.open_images.labels`
  WHERE label_name = '/m/01yrx'
    AND confidence = 1
) AS c
ON i.image_id = c.image_id
LIMIT 20;
```

```sql
--Description: Count how many DISTINCT image URLs are positively labeled as cat.
SELECT COUNT(DISTINCT i.original_url) AS cat_url_count
FROM `bigquery-public-data.open_images.images`  AS i
JOIN `bigquery-public-data.open_images.labels`  AS l
ON   i.image_id = l.image_id
WHERE l.label_name = '/m/01yrx'
  AND l.confidence = 1
LIMIT 20;
```

```sql
--Description: Count total distinct URLs in the whole images table.
SELECT COUNT(DISTINCT original_url) AS total_url_count
FROM `bigquery-public-data.open_images.images`
LIMIT 20;
```

```sql
--Description: Count URLs whose images have NO cat label at all (“other”).
SELECT COUNT(DISTINCT i.original_url) AS other_url_count
FROM `bigquery-public-data.open_images.images` AS i
WHERE NOT EXISTS (
  SELECT 1
  FROM `bigquery-public-data.open_images.labels` AS l
  WHERE l.image_id = i.image_id
    AND l.label_name = '/m/01yrx'
)
LIMIT 20;
```

```sql
--Description: Produce cat vs. other URL counts in one result using UNION ALL.
SELECT 'cat'   AS category, COUNT(DISTINCT i.original_url) AS url_count
FROM   `bigquery-public-data.open_images.images` AS i
JOIN   `bigquery-public-data.open_images.labels` AS l
ON     i.image_id = l.image_id
WHERE  l.label_name = '/m/01yrx'
  AND  l.confidence = 1

UNION ALL

SELECT 'other' AS category, COUNT(DISTINCT i.original_url) AS url_count
FROM   `bigquery-public-data.open_images.images` AS i
WHERE  NOT EXISTS (
  SELECT 1
  FROM `bigquery-public-data.open_images.labels` AS l
  WHERE l.image_id = i.image_id
    AND l.label_name = '/m/01yrx'
)
LIMIT 20;
```

```sql
--Description: Same result via conditional aggregation.
SELECT
  COUNT(DISTINCT CASE WHEN l.label_name = '/m/01yrx' AND l.confidence = 1 THEN i.original_url END) AS cat_url_count,
  COUNT(DISTINCT CASE WHEN l.label_name IS NULL                                       THEN i.original_url END) AS other_url_count
FROM `bigquery-public-data.open_images.images` AS i
LEFT JOIN (
  SELECT image_id, label_name, confidence
  FROM `bigquery-public-data.open_images.labels`
  WHERE label_name = '/m/01yrx'
) AS l
ON i.image_id = l.image_id
LIMIT 20;
```
