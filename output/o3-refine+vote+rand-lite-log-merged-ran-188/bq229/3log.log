Query:
--Description: Produce cat vs. other URL counts in one result using UNION ALL.
SELECT 'cat'   AS category, COUNT(DISTINCT i.original_url) AS url_count
FROM   `bigquery-public-data.open_images.images` AS i
JOIN   `bigquery-public-data.open_images.labels` AS l
ON     i.image_id = l.image_id
WHERE  l.label_name = '/m/01yrx'
  AND  l.confidence = 1

UNION ALL

SELECT 'other' AS category, COUNT(DISTINCT i.original_url) AS url_count
FROM   `bigquery-public-data.open_images.images` AS i
WHERE  NOT EXISTS (
  SELECT 1
  FROM `bigquery-public-data.open_images.labels` AS l
  WHERE l.image_id = i.image_id
    AND l.label_name = '/m/01yrx'
)
LIMIT 20;
