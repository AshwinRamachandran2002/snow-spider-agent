Query:
--Description: Final query that returns the number of CAT URLs and OTHER URLs in one result set.
WITH cat_urls AS (
  SELECT DISTINCT i.original_url
  FROM `bigquery-public-data.open_images.images`           AS i
  JOIN `bigquery-public-data.open_images.annotations_bbox` AS b
    ON i.image_id = b.image_id
  WHERE b.label_name = '/m/01yrx'
    AND b.confidence = 1
),
all_urls AS (
  SELECT DISTINCT original_url
  FROM `bigquery-public-data.open_images.images`
)
SELECT
  COUNT(*)                                               AS cat_url_cnt,
  (SELECT COUNT(*) FROM all_urls) - COUNT(*)             AS other_url_cnt
FROM cat_urls
Answer:
cat_url_cnt,other_url_cnt
5481,9172794
