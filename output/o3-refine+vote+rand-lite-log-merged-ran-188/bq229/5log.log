Query:
--Description: Count the number of DISTINCT image URLs whose images contain a cat (label ‘/m/01yrx’, confidence = 1).
SELECT COUNT(DISTINCT i.original_url) AS cat_url_cnt
FROM   `bigquery-public-data.open_images.images`           AS i
JOIN   `bigquery-public-data.open_images.annotations_bbox` AS b
  ON  i.image_id = b.image_id
WHERE b.label_name = '/m/01yrx'
  AND b.confidence = 1
Answer:
cat_url_cnt
5481
Query:
--Description: Count the total number of DISTINCT image URLs in the entire images table.
SELECT COUNT(DISTINCT original_url) AS total_url_cnt
FROM   `bigquery-public-data.open_images.images`
