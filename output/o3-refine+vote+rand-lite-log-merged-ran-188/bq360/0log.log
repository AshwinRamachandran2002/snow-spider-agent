--specializations for Mountain View, CA.
WITH top10 AS (
  SELECT
    t.specialization,
    COUNT(DISTINCT r.npi) AS npi_cnt
  FROM `bigquery-public-data.nppes.npi_raw` AS r
  CROSS JOIN UNNEST([
