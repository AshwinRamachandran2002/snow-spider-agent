    t.specialization,
    COUNT(DISTINCT r.npi) AS npi_cnt
  FROM `bigquery-public-data.nppes.npi_raw` AS r
  CROSS JOIN UNNEST([
    r.healthcare_provider_taxonomy_code_1,  r.healthcare_provider_taxonomy_code_2,
