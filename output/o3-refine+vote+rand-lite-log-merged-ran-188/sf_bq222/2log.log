```sql
--Description:  Identify the single 4-character CPC group (from those present in German
--              patents granted in December-2016) that achieves the overall highest
--              exponential moving average (EMA, α = 0.1) of yearly filing counts, then
--              attach a representative CPC title (lowest-level definition row).
WITH RECURSIVE
    /* 1. Target 4-char CPC codes that appear in DE grants of Dec-2016 */
    target_groups AS (
        SELECT DISTINCT LEFT(c.value:"code"::STRING,4) AS cpc_group
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(INPUT => p."cpc") c
        WHERE p."country_code" = 'DE'
          AND p."grant_date" BETWEEN 20161201 AND 20161231
    ),
    /* 2. Yearly filing counts for those CPC groups */
    filings AS (
        SELECT LEFT(c.value:"code"::STRING,4) AS cpc_group,
               FLOOR(p."filing_date"/10000)   AS year,
               COUNT(*)                       AS x
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(INPUT => p."cpc") c
        WHERE p."country_code" = 'DE'
          AND LEFT(c.value:"code"::STRING,4) IN (SELECT cpc_group FROM target_groups)
        GROUP BY 1,2
    ),
    /* 3. Add sequential row numbers within each group */
    ordered AS (
        SELECT cpc_group,
               year,
               x,
               ROW_NUMBER() OVER (PARTITION BY cpc_group ORDER BY year) AS rn
        FROM filings
    ),
    /* 4. Recursive EMA calculation (α = 0.1) */
    ema_cte (cpc_group, year, x, rn, ema) AS (
        -- anchor
        SELECT cpc_group,
               year,
               x,
               rn,
               x * 0.1
        FROM ordered
        WHERE rn = 1
        UNION ALL
        -- recursion
        SELECT o.cpc_group,
               o.year,
               o.x,
               o.rn,
               o.x * 0.1 + e.ema * 0.9
        FROM ema_cte e
        JOIN ordered o
          ON o.cpc_group = e.cpc_group
         AND o.rn        = e.rn + 1
    ),
    /* 5. Best (highest-EMA) year per group */
    best AS (
        SELECT cpc_group,
               year  AS best_year,
               ema,
               ROW_NUMBER() OVER (PARTITION BY cpc_group ORDER BY ema DESC) AS r
        FROM ema_cte
        WHERE ema IS NOT NULL
    ),
    /* 6. Rank groups by their peak EMA, keep top one */
    ranked AS (
        SELECT b.*,
               ROW_NUMBER() OVER (ORDER BY b.ema DESC) AS overall_rank
        FROM best b
        WHERE b.r = 1
    ),
    /* 7. Grab a representative CPC title (lowest level row) for each 4-char code */
    titles AS (
        SELECT LEFT(d."symbol",4) AS cpc_group,
               d."titleFull",
               ROW_NUMBER() OVER (PARTITION BY LEFT(d."symbol",4) ORDER BY d."level") AS lvl_rank
        FROM PATENTS.PATENTS.CPC_DEFINITION d
    )
/* 8. Final output: only the single highest-EMA CPC group */
SELECT  r.cpc_group,
        t."titleFull" AS cpc_title,
        r.best_year,
        r.ema
FROM    ranked r
LEFT JOIN titles t
       ON t.cpc_group = r.cpc_group
      AND t.lvl_rank  = 1
WHERE   r.overall_rank = 1;
