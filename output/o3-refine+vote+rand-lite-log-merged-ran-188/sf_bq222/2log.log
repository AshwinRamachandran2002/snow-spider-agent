```sql
--Description:  Calculate the 0.1 EMA for every 4-character CPC group that appears in
--              German patents granted during Dec-2016, pick the year with the peak EMA
--              for each group, and attach the CPC level-4 title.  A single WITH RECURSIVE
--              block is used, with the recursive CTE (ema_cte) declared last.
WITH RECURSIVE
    target_groups AS (                          -- groups present in Dec-2016 grants
        SELECT DISTINCT LEFT(c.value:"code"::STRING,4) AS cpc_group
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."cpc") c
        WHERE p."country_code" = 'DE'
          AND p."grant_date" BETWEEN 20161201 AND 20161231
    ),
    filings AS (                                -- yearly filing counts
        SELECT LEFT(c.value:"code"::STRING,4)  AS cpc_group,
               FLOOR(p."filing_date"/10000)    AS year,
               COUNT(*)                        AS x
        FROM   PATENTS.PATENTS.PUBLICATIONS p,
               LATERAL FLATTEN(input => p."cpc") c
        WHERE  p."country_code" = 'DE'
          AND  LEFT(c.value:"code"::STRING,4) IN (SELECT cpc_group FROM target_groups)
        GROUP  BY 1,2
    ),
    ordered AS (                                -- add sequential row numbers per group
        SELECT cpc_group,
               year,
               x,
               ROW_NUMBER() OVER (PARTITION BY cpc_group ORDER BY year) AS rn
        FROM   filings
    ),
    ema_cte (cpc_group, year, x, rn, ema) AS (  -- recursive EMA calculation
        -- anchor row for each group
        SELECT cpc_group,
               year,
               x,
               rn,
               x * 0.1
        FROM   ordered
        WHERE  rn = 1
        UNION ALL
        -- recursive continuation
        SELECT o.cpc_group,
               o.year,
               o.x,
               o.rn,
               o.x * 0.1 + e.ema * 0.9
        FROM   ema_cte e
        JOIN   ordered o
               ON  o.cpc_group = e.cpc_group
              AND o.rn        = e.rn + 1
    ),
    best AS (                                   -- pick the peak-EMA year per group
        SELECT cpc_group,
               year  AS best_year,
               ema,
               ROW_NUMBER() OVER (PARTITION BY cpc_group ORDER BY ema DESC) AS r
        FROM   ema_cte
    )
SELECT  b.cpc_group,
        d.titleFull        AS cpc_title,
        b.best_year,
        b.ema
FROM    best b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d      -- join on first 4 chars, level-4 rows
       ON LEFT(d."symbol",4) = b.cpc_group
      AND d."level" = 4
WHERE   b.r = 1
ORDER BY b.ema DESC
LIMIT 20;
