--Description:  Re-run the EMA test for CPC group ‘H04L’.  We first aggregate yearly
--              filing counts for German patents (filings), then order them (ordered),
--              and finally use a recursive CTE (ema_cte) to compute the 0.1 exponential
--              moving average:
--                  ema₁ = x₁*0.1
--                  emaₜ = xₜ*0.1 + emaₜ₋₁*0.9
--              The query shows each year, its raw filing count, and the smoothed EMA.
WITH
filings AS (                               -- yearly filing counts
    SELECT FLOOR(p."filing_date"/10000) AS year,
           COUNT(*)                     AS x
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") c
    WHERE  p."country_code" = 'DE'
      AND  LEFT(c.value:"code"::STRING,4) = 'H04L'
    GROUP  BY 1
),
ordered AS (                               -- chronological ordering + row numbers
    SELECT year,
           x,
           ROW_NUMBER() OVER (ORDER BY year) AS rn
    FROM   filings
),
RECURSIVE ema_cte (year, x, rn, ema) AS (  -- exponential moving average
    SELECT year,
           x,
           rn,
           x * 0.1
    FROM   ordered
    WHERE  rn = 1
    UNION ALL
    SELECT o.year,
           o.x,
           o.rn,
           o.x * 0.1 + e.ema * 0.9
    FROM   ema_cte e
    JOIN   ordered o
      ON   o.rn = e.rn + 1
)
SELECT year,
       x   AS patent_filings,
       ema
FROM   ema_cte
ORDER  BY year
LIMIT 20;
