--Description:  Return only the single CPC group (among those seen in Dec-2016 German
--              grants) that has the highest exponential moving average overall.
WITH RECURSIVE
    target_groups AS (
        SELECT DISTINCT LEFT(c.value:"code"::STRING,4) AS cpc_group
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."cpc") c
        WHERE p."country_code" = 'DE'
          AND p."grant_date" BETWEEN 20161201 AND 20161231
    ),
    filings AS (
        SELECT LEFT(c.value:"code"::STRING,4) AS cpc_group,
               FLOOR(p."filing_date"/10000)   AS year,
               COUNT(*)                       AS x
        FROM   PATENTS.PATENTS.PUBLICATIONS p,
               LATERAL FLATTEN(input => p."cpc") c
        WHERE  p."country_code" = 'DE'
          AND  LEFT(c.value:"code"::STRING,4) IN (SELECT cpc_group FROM target_groups)
        GROUP  BY 1,2
    ),
    ordered AS (
        SELECT cpc_group,
               year,
               x,
               ROW_NUMBER() OVER (PARTITION BY cpc_group ORDER BY year) AS rn
        FROM   filings
    ),
    ema_cte (cpc_group, year, x, rn, ema) AS (
        SELECT cpc_group,
               year,
               x,
               rn,
               x * 0.1
        FROM   ordered
        WHERE  rn = 1
        UNION ALL
        SELECT o.cpc_group,
               o.year,
               o.x,
               o.rn,
               o.x * 0.1 + e.ema * 0.9
        FROM   ema_cte e
        JOIN   ordered o
               ON o.cpc_group = e.cpc_group
              AND o.rn        = e.rn + 1
    ),
    best AS (                                   -- peak EMA for each group
        SELECT cpc_group,
               year  AS best_year,
               ema,
               ROW_NUMBER() OVER (PARTITION BY cpc_group ORDER BY ema DESC) AS r
        FROM   ema_cte
        WHERE  ema IS NOT NULL
    ),
    ranked AS (                                 -- rank groups by their peak EMA
        SELECT b.*,
               ROW_NUMBER() OVER (ORDER BY b.ema DESC) AS overall_rank
        FROM   best b
        WHERE  b.r = 1
    )
SELECT  r.cpc_group,
        d.titleFull AS cpc_title,
        r.best_year,
        r.ema
FROM    ranked r
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON LEFT(d."symbol",4) = r.cpc_group
      AND d."level" = 4
WHERE   r.overall_rank = 1;
