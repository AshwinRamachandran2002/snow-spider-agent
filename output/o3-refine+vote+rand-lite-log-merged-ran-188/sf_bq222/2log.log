```sql
--Description: The earlier attempt returned no rows because CPC_DEFINITION often stores symbols
--             at deeper hierarchical levels (e.g., “B60R1/00”, “B60R99/00”) rather than the
--             4-character group “B60R”.  To confirm what levels actually exist, we:
--               1) Build a list (CTE grp) of the DISTINCT 4-character CPC codes that occur
--                  in patents granted in Germany during Dec-2016.
--               2) Join CPC_DEFINITION on any symbol that STARTS WITH one of those codes
--                  (d."symbol" LIKE grp.cpc_group || '%').
--             This lets us inspect which definition rows (and their levels) map back to our
--             target groups, so we can decide how best to link titles later.
WITH grp AS (
    SELECT DISTINCT LEFT(c.value:"code"::STRING, 4) AS cpc_group
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231
)
SELECT
    d."symbol",
    d."level",
    d."titleFull"
FROM PATENTS.PATENTS.CPC_DEFINITION d
JOIN grp
  ON d."symbol" LIKE grp.cpc_group || '%'
LIMIT 20;
