```sql
--Description: Count yearly German patent filings (based on filing_date) for every 4-character CPC
--             group that shows up in German patents granted during Dec-2016.
WITH target_groups AS (          -- collect the 4-char codes once
    SELECT DISTINCT LEFT(c.value:"code"::STRING,4) AS cpc_group
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE p."country_code" = 'DE'
      AND p."grant_date"  BETWEEN 20161201 AND 20161231
)
SELECT
    LEFT(c.value:"code"::STRING,4)                AS "cpc_group",
    FLOOR(p."filing_date"/10000)                  AS "filing_year",
    COUNT(*)                                      AS "patent_filings"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") c
WHERE p."country_code" = 'DE'
  AND LEFT(c.value:"code"::STRING,4) IN (SELECT cpc_group FROM target_groups)
GROUP BY 1,2
ORDER BY 1,2
LIMIT 20;
