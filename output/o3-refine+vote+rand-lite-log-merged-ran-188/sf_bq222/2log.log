```sql
--Description: Compute a 0.1 exponential moving average (EMA) of yearly filing counts
--             for the CPC group ‘H04L’ to validate the recursive EMA logic.
WITH filings AS (
    SELECT FLOOR(p."filing_date"/10000) AS "year",
           COUNT(*)                      AS "x"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE p."country_code" = 'DE'
      AND LEFT(c.value:"code"::STRING,4) = 'H04L'
    GROUP BY 1
), ordered AS (
    SELECT "year","x",
           ROW_NUMBER() OVER (ORDER BY "year") AS rn
    FROM   filings
), RECURSIVE ema AS (
    SELECT "year","x",
           "x"*0.1               AS "ema",
           rn
    FROM   ordered
    WHERE  rn = 1
    UNION ALL
    SELECT o."year", o."x",
           o."x"*0.1 + e."ema"*0.9 AS "ema",
           o.rn
    FROM   ema e
    JOIN   ordered o
           ON o.rn = e.rn + 1
)
SELECT * FROM ema
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: Calculate the 0.1 EMA for every CPC group that appears in Dec-2016 German
--             grants, pick the peak EMA year for each group, and attach the CPC title.
WITH target_groups AS (                             -- Dec-2016 groups
    SELECT DISTINCT LEFT(c.value:"code"::STRING,4) AS cpc_group
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231
), filings AS (                                     -- yearly counts
    SELECT LEFT(c.value:"code"::STRING,4)  AS cpc_group,
           FLOOR(p."filing_date"/10000)    AS year,
           COUNT(*)                        AS x
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") c
    WHERE  p."country_code" = 'DE'
      AND  LEFT(c.value:"code"::STRING,4) IN (SELECT cpc_group FROM target_groups)
    GROUP  BY 1,2
), ordered AS (
    SELECT cpc_group,year,x,
           ROW_NUMBER() OVER (PARTITION BY cpc_group ORDER BY year) AS rn
    FROM   filings
), RECURSIVE ema AS (                                -- recursive EMA
    SELECT cpc_group,year,x,
           x*0.1                     AS ema,
           rn
    FROM   ordered
    WHERE  rn = 1
    UNION ALL
    SELECT o.cpc_group,o.year,o.x,
           o.x*0.1 + e.ema*0.9       AS ema,
           o.rn
    FROM   ema e
    JOIN   ordered o
       ON  o.cpc_group = e.cpc_group
      AND  o.rn       = e.rn + 1
), best AS (                                         -- peak per group
    SELECT cpc_group,
           year        AS best_year,
           ema,
           ROW_NUMBER() OVER (PARTITION BY cpc_group ORDER BY ema DESC) AS r
    FROM   ema
)
SELECT  b.cpc_group,
        d.titleFull   AS cpc_title,
        b.best_year,
        b.ema
FROM    best b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d          -- match on first 4 chars, level 4 rows
       ON LEFT(d."symbol",4) = b.cpc_group
      AND d."level" = 4
WHERE   b.r = 1
ORDER BY b.ema DESC
LIMIT 20;
```

