--Description:  Compute a 0.1 exponential moving average (EMA) of yearly German patent
--              filings for CPC group “H04L”.  Strategy:
--                 1) filings  – yearly counts (non-recursive).
--                 2) ordered  – add row numbers (non-recursive).
--                 3) ema_cte  – recursive CTE that derives the EMA.
--              Snowflake requires a single WITH RECURSIVE clause, so all three CTEs are
--              listed together, with the recursive one (ema_cte) appearing last.
WITH RECURSIVE
    filings AS (                               -- yearly filing counts
        SELECT FLOOR(p."filing_date"/10000) AS year,
               COUNT(*)                     AS x
        FROM   PATENTS.PATENTS.PUBLICATIONS p,
               LATERAL FLATTEN(input => p."cpc") c
        WHERE  p."country_code" = 'DE'
          AND  LEFT(c.value:"code"::STRING,4) = 'H04L'
        GROUP  BY 1
    ),
    ordered AS (                               -- add sequential row numbers
        SELECT year,
               x,
               ROW_NUMBER() OVER (ORDER BY year) AS rn
        FROM   filings
    ),
    ema_cte (year, x, rn, ema) AS (            -- recursive EMA calculation
        -- anchor row
        SELECT year,
               x,
               rn,
               x * 0.1
        FROM   ordered
        WHERE  rn = 1
        UNION ALL
        -- recursive continuation
        SELECT o.year,
               o.x,
               o.rn,
               o.x * 0.1 + e.ema * 0.9
        FROM   ema_cte e
        JOIN   ordered o
               ON o.rn = e.rn + 1
)
SELECT year,
       x   AS patent_filings,
       ema
FROM   ema_cte
ORDER  BY year
LIMIT 20;
