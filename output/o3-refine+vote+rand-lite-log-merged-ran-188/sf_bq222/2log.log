```sql
--Description:  Example – compute a 0.1 exponential moving average (EMA) for one CPC group (‘H04L’) to validate logic
WITH    filings AS (
        SELECT FLOOR(p."filing_date"/10000) AS "year",
               COUNT(*)                      AS "x"
        FROM PATENTS.PATENTS.PUBLICATIONS  p,
             LATERAL FLATTEN(input => p."cpc") c
        WHERE p."country_code" = 'DE'
          AND LEFT(c.value:"code"::STRING,4) = 'H04L'
        GROUP BY 1
        ORDER BY 1
),      ordered AS (
        SELECT "year","x",
               ROW_NUMBER() OVER (ORDER BY "year") AS rn
        FROM   filings
),      RECURSIVE ema AS (
        SELECT "year","x",
               "x"*0.1                     AS "ema",
               rn
        FROM   ordered
        WHERE  rn = 1
        UNION ALL
        SELECT o."year", o."x",
               o."x"*0.1 + e."ema"*0.9     AS "ema",
               o.rn
        FROM   ema e
        JOIN   ordered o
               ON o.rn = e.rn + 1
)
SELECT * FROM ema
ORDER BY "year"
LIMIT 20;
```

```sql
--Description:  Calculate the 0.1 EMA for every CPC group (level 4) linked to December 2016 German grants
WITH   target_groups AS (                         -- groups present in 12/2016 grants
        SELECT DISTINCT LEFT(c.value:"code"::STRING,4) AS "cpc_group"
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."cpc") c
        WHERE p."country_code" = 'DE'
          AND p."grant_date" BETWEEN 20161201 AND 20161231
),    filings AS (                                -- yearly filing counts
        SELECT LEFT(c.value:"code"::STRING,4)        AS "cpc_group",
               FLOOR(p."filing_date"/10000)          AS "year",
               COUNT(*)                              AS "x"
        FROM   PATENTS.PATENTS.PUBLICATIONS p,
               LATERAL FLATTEN(input => p."cpc") c
        WHERE  p."country_code" = 'DE'
          AND  LEFT(c.value:"code"::STRING,4) IN (SELECT "cpc_group" FROM target_groups)
        GROUP  BY 1,2
),    ordered AS (
        SELECT "cpc_group","year","x",
               ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY "year") AS rn
        FROM   filings
),    RECURSIVE ema AS (                          -- recursive EMA per group
        SELECT "cpc_group","year","x",
               "x"*0.1                             AS "ema",
               rn
        FROM   ordered
        WHERE  rn = 1
        UNION ALL
        SELECT o."cpc_group", o."year", o."x",
               o."x"*0.1 + e."ema"*0.9             AS "ema",
               o.rn
        FROM   ema e
        JOIN   ordered o
               ON  o."cpc_group" = e."cpc_group"
               AND o.rn = e.rn + 1
),    best AS (                                   -- pick the peak EMA year for each group
        SELECT  e."cpc_group",
                e."year"              AS "best_year",
                e."ema",
                ROW_NUMBER() OVER (PARTITION BY e."cpc_group" ORDER BY e."ema" DESC) AS r
        FROM    ema e
)
SELECT  b."cpc_group",
        d."titleFull"             AS "cpc_title",
        b."best_year",
        b."ema"
FROM    best  b
JOIN    PATENTS.PATENTS.CPC_DEFINITION d
        ON d."symbol" = b."cpc_group" AND d."level" = 4
WHERE   b.r = 1
ORDER BY b."ema" DESC
LIMIT 20;
```

