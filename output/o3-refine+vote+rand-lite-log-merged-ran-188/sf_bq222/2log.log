```sql
--Description:  For every 4-character CPC group that appears in German patents granted
--              during December 2016, compute the yearly filing counts, smooth them with a
--              0.1 exponential moving average (EMA), keep the year with the highest EMA
--              for each group, then attach a representative CPC title.  The query is
--              organised in a single WITH RECURSIVE block (Snowflake requirement); the
--              recursive CTE (ema_cte) is declared last.
WITH RECURSIVE
    /* 1. 4-char CPC codes present in DE patents granted in Dec-2016 */
    target_groups AS (
        SELECT DISTINCT LEFT(c.value:"code"::STRING,4) AS cpc_group
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(INPUT => p."cpc") c
        WHERE p."country_code" = 'DE'
          AND p."grant_date" BETWEEN 20161201 AND 20161231
    ),
    /* 2. Yearly filing counts for those CPC groups */
    filings AS (
        SELECT LEFT(c.value:"code"::STRING,4) AS cpc_group,
               FLOOR(p."filing_date"/10000)  AS year,
               COUNT(*)                      AS x
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(INPUT => p."cpc") c
        WHERE p."country_code" = 'DE'
          AND LEFT(c.value:"code"::STRING,4) IN (SELECT cpc_group FROM target_groups)
        GROUP BY 1,2
    ),
    /* 3. Add sequential row numbers within each group (chronological order) */
    ordered AS (
        SELECT cpc_group,
               year,
               x,
               ROW_NUMBER() OVER (PARTITION BY cpc_group ORDER BY year) AS rn
        FROM filings
    ),
    /* 4. Recursive EMA calculation with α = 0.1 */
    ema_cte (cpc_group, year, x, rn, ema) AS (
        -- anchor row (first year per group)
        SELECT cpc_group,
               year,
               x,
               rn,
               x * 0.1
        FROM ordered
        WHERE rn = 1
        UNION ALL
        -- recursive step
        SELECT o.cpc_group,
               o.year,
               o.x,
               o.rn,
               o.x * 0.1 + e.ema * 0.9
        FROM ema_cte e
        JOIN ordered o
          ON o.cpc_group = e.cpc_group
         AND o.rn        = e.rn + 1
    ),
    /* 5. Retain the year having the peak EMA for each group */
    best AS (
        SELECT cpc_group,
               year      AS best_year,
               ema,
               ROW_NUMBER() OVER (PARTITION BY cpc_group ORDER BY ema DESC) AS r
        FROM ema_cte
    ),
    /* 6. Choose one CPC title per 4-char group (lowest level row in CPC_DEFINITION) */
    titles AS (
        SELECT
            LEFT(d."symbol",4)                   AS cpc_group,
            d."titleFull",
            ROW_NUMBER() OVER (
                PARTITION BY LEFT(d."symbol",4)
                ORDER BY d."level"
            ) AS lvl_rank
        FROM PATENTS.PATENTS.CPC_DEFINITION d
        WHERE d."titleFull" IS NOT NULL
    )
/* 7. Final list: CPC group, title, best year, highest EMA */
SELECT
    b.cpc_group,
    t."titleFull"            AS cpc_title,
    b.best_year,
    b.ema
FROM best  b
LEFT JOIN titles t
       ON t.cpc_group = b.cpc_group
      AND t.lvl_rank  = 1     -- pick representative title
WHERE b.r = 1                 -- keep only highest-EMA year per group
