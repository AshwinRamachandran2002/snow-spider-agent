  WHERE p."country_code" = 'DE'
    AND p."grant_date" BETWEEN 20161201 AND 20161231
),
yearly AS (
  SELECT 
      REGEXP_SUBSTR(f.value:"code"::STRING, '^[A-HY][0-9]{2}[A-Z]') AS "cpc_group_lvl4",
      TO_NUMBER(LEFT(p."grant_date",4))                             AS "grant_year",
      COUNT(*)                                                      AS "grant_count"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f
  WHERE p."country_code" = 'DE'
  GROUP BY 1,2
), ema AS (
  SELECT 
      "cpc_group_lvl4",
      "grant_year",
      EXP_MOVING_AVG("grant_count", 0.1) OVER (PARTITION BY "cpc_group_lvl4" ORDER BY "grant_year") 
        AS "ema_val"
  FROM yearly
), best AS (
  SELECT *
  FROM (
       SELECT 
           "cpc_group_lvl4",
           "grant_year" AS "best_year",
           "ema_val",
           ROW_NUMBER() OVER (PARTITION BY "cpc_group_lvl4" ORDER BY "ema_val" DESC) AS rnk
       FROM ema
  )
