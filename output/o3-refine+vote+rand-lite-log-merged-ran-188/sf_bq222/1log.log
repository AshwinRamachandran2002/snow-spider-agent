```sql
--Description: 1)  Look at a few German patent publications that were granted in December 2016  
SELECT 
    "publication_number",
    "grant_date",
    "publication_date",
    "country_code",
    "kind_code"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'DE' 
  AND "grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
--Description: 2)  Inspect the CPC list (raw JSON) attached to those same publications  
SELECT 
    "publication_number",
    "cpc"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'DE' 
  AND "grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
--Description: 3)  Flatten the CPC array to see individual CPC symbols for those December 2016 German grants  
SELECT 
    p."publication_number",
    f.value:"code"::STRING  AS "cpc_symbol"
FROM PATENTS.PATENTS.PUBLICATIONS  p,
     LATERAL FLATTEN(input => p."cpc") f
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
--Description: 4)  Derive the CPC “group” level (first 4-character subgroup such as H04L9/08 → H04L) for those symbols  
SELECT 
    f.value:"code"::STRING                              AS "cpc_symbol",
    REGEXP_SUBSTR(f.value:"code"::STRING, '^[A-HY][0-9]{2}[A-Z]') AS "cpc_group_lvl4"
FROM PATENTS.PATENTS.PUBLICATIONS  p,
     LATERAL FLATTEN(input => p."cpc") f
WHERE p."country_code" = 'DE'
  AND p."grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
--Description: 5)  Count how many DE publications were granted each year for every CPC level-4 group  
WITH grp AS (
  SELECT
      REGEXP_SUBSTR(f.value:"code"::STRING, '^[A-HY][0-9]{2}[A-Z]') AS "cpc_group_lvl4",
      TO_NUMBER(LEFT(p."grant_date",4))                             AS "grant_year"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f
  WHERE p."country_code" = 'DE'
)
SELECT 
    "cpc_group_lvl4",
    "grant_year",
    COUNT(*) AS "grant_count"
FROM grp
GROUP BY "cpc_group_lvl4", "grant_year"
ORDER BY "cpc_group_lvl4", "grant_year"
LIMIT 20;
```

```sql
--Description: 6)  Compute the exponential moving average (α = 0.1) of the yearly grant counts per CPC group  
WITH yearly AS (
  SELECT 
      REGEXP_SUBSTR(f.value:"code"::STRING, '^[A-HY][0-9]{2}[A-Z]') AS "cpc_group_lvl4",
      TO_NUMBER(LEFT(p."grant_date",4))                             AS "grant_year",
      COUNT(*)                                                      AS "grant_count"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f
  WHERE p."country_code" = 'DE'
  GROUP BY 1,2
)
SELECT 
    "cpc_group_lvl4",
    "grant_year",
    "grant_count",
    EXP_MOVING_AVG("grant_count", 0.1) OVER (PARTITION BY "cpc_group_lvl4" ORDER BY "grant_year") 
        AS "ema_0_1"
FROM yearly
ORDER BY "cpc_group_lvl4", "grant_year"
LIMIT 20;
```

```sql
--Description: 7)  For every CPC group, pick the year whose EMA value is highest  
WITH yearly AS (
  SELECT 
      REGEXP_SUBSTR(f.value:"code"::STRING, '^[A-HY][0-9]{2}[A-Z]') AS "cpc_group_lvl4",
      TO_NUMBER(LEFT(p."grant_date",4))                             AS "grant_year",
      COUNT(*)                                                      AS "grant_count"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f
  WHERE p."country_code" = 'DE'
  GROUP BY 1,2
), ema AS (
  SELECT 
      "cpc_group_lvl4",
      "grant_year",
      EXP_MOVING_AVG("grant_count", 0.1) OVER (PARTITION BY "cpc_group_lvl4" ORDER BY "grant_year") 
        AS "ema_val"
  FROM yearly
)
SELECT *
FROM (
     SELECT 
         "cpc_group_lvl4",
         "grant_year"   AS "best_year",
         "ema_val",
         ROW_NUMBER() OVER (PARTITION BY "cpc_group_lvl4" ORDER BY "ema_val" DESC) AS rnk
     FROM ema
) 
WHERE rnk = 1
ORDER BY "ema_val" DESC
LIMIT 20;
```

```sql
--Description: 8)  Bring in the CPC definition table to grab the full title for each level-4 group  
WITH yearly AS (
  SELECT 
      REGEXP_SUBSTR(f.value:"code"::STRING, '^[A-HY][0-9]{2}[A-Z]') AS "cpc_group_lvl4",
      TO_NUMBER(LEFT(p."grant_date",4))                             AS "grant_year",
      COUNT(*)                                                      AS "grant_count"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f
  WHERE p."country_code" = 'DE'
  GROUP BY 1,2
), ema AS (
  SELECT 
      "cpc_group_lvl4",
      "grant_year",
      EXP_MOVING_AVG("grant_count", 0.1) OVER (PARTITION BY "cpc_group_lvl4" ORDER BY "grant_year") 
        AS "ema_val"
  FROM yearly
), best AS (
  SELECT *
  FROM (
       SELECT 
           "cpc_group_lvl4",
           "grant_year" AS "best_year",
           "ema_val",
           ROW_NUMBER() OVER (PARTITION BY "cpc_group_lvl4" ORDER BY "ema_val" DESC) AS rnk
       FROM ema
  )
  WHERE rnk = 1
)
SELECT 
    b."cpc_group_lvl4"                           AS "cpc_group",
    d."titleFull"                                AS "cpc_full_title",
    b."best_year",
    b."ema_val"
FROM best b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."cpc_group_lvl4"
ORDER BY b."ema_val" DESC
LIMIT 20;
```

