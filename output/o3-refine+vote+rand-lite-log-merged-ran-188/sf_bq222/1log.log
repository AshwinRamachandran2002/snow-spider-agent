```sql
--Description:  Replace the unavailable EXP_MOVING_AVG() window function with a
--              recursive-CTE implementation of the exponential moving average
--              (EMA, α = 0.10) on yearly German-grant counts per CPC level-4 group.
--              Steps inside one query:
--              1. yearly  – raw count of DE grants for each (CPC-L4, year).
--              2. ranked  – add a row number to impose chronological order.
--              3. ema_r   – recursive CTE that applies
--                           EMA_n = 0.10·X_n + 0.90·EMA_{n-1}.
--              The output shows the first 20 rows (ordered) to validate the logic.
WITH RECURSIVE
/*------------------------------------------------------------*
 * 1)  Yearly grant counts per CPC level-4 group               *
 *------------------------------------------------------------*/
yearly AS (
    SELECT
        REGEXP_SUBSTR(f.value:"code"::STRING, '^[A-HY][0-9]{2}[A-Z]')            AS "cpc_group_lvl4",
        TO_NUMBER(LEFT(p."grant_date", 4))                                       AS "grant_year",
        COUNT(*)                                                                 AS "grant_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE p."country_code" = 'DE'
    GROUP BY 1, 2
),
/*------------------------------------------------------------*
 * 2)  Add ordinal row within each CPC group                   *
 *------------------------------------------------------------*/
ranked AS (
    SELECT
        y."cpc_group_lvl4",
        y."grant_year",
        y."grant_count",
        ROW_NUMBER() OVER (PARTITION BY y."cpc_group_lvl4" ORDER BY y."grant_year") AS "rn"
    FROM yearly y
),
/*------------------------------------------------------------*
 * 3)  Recursive EMA calculation (α = 0.10)                    *
 *------------------------------------------------------------*/
ema_r AS (
    /* anchor: first (oldest) year in each group */
    SELECT
        r."cpc_group_lvl4",
        r."grant_year",
        r."grant_count",
        r."rn",
        CAST(r."grant_count" AS FLOAT)                                            AS "ema_val"
    FROM ranked r
    WHERE r."rn" = 1
    
    UNION ALL
    
    /* recursion: compute EMA for the next chronological year */
    SELECT
        r."cpc_group_lvl4",
        r."grant_year",
        r."grant_count",
        r."rn",
        0.10 * r."grant_count" + 0.90 * e."ema_val"                               AS "ema_val"
    FROM ema_r        e
    JOIN ranked       r
      ON r."cpc_group_lvl4" = e."cpc_group_lvl4"
     AND r."rn"            = e."rn" + 1
)
/*------------------------------------------------------------*
 * 4)  Display sample results                                  *
 *------------------------------------------------------------*/
SELECT
    "cpc_group_lvl4",
    "grant_year",
    "grant_count",
    "ema_val"
FROM ema_r
ORDER BY "cpc_group_lvl4", "grant_year"
LIMIT 20;
```
