Query:
--Description: 7)  For every CPC-L4 group, compute EMA(0.1) recursively and pick the year
--              whose EMA is highest (first 20 groups shown)
WITH RECURSIVE
yearly AS (                                         -- yearly counts
    SELECT
        REGEXP_SUBSTR(f.value:"code"::STRING,'^[A-HY][0-9]{2}[A-Z]') AS "cpc_group_lvl4",
        TO_NUMBER(LEFT(p."grant_date",4))                           AS "grant_year",
        COUNT(*)                                                    AS "grant_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(INPUT=>p."cpc") f
    WHERE p."country_code"='DE'
    GROUP BY 1,2
),
ranked AS (                                         -- sequence within each group
    SELECT
        y.*,
        ROW_NUMBER() OVER(PARTITION BY y."cpc_group_lvl4" ORDER BY y."grant_year") AS "rn"
    FROM yearly y
),
ema_r AS (                                          -- recursive EMA(0.1)
    SELECT r.*, CAST(r."grant_count" AS FLOAT) AS "ema_val"
    FROM ranked r
    WHERE r."rn"=1
    UNION ALL
    SELECT
        r."cpc_group_lvl4", r."grant_year", r."grant_count", r."rn",
        0.1*r."grant_count" + 0.9*e."ema_val"
    FROM ema_r e
    JOIN ranked r
      ON r."cpc_group_lvl4"=e."cpc_group_lvl4" AND r."rn"=e."rn"+1
),
best AS (                                           -- highest EMA year per group
    SELECT *
    FROM (
        SELECT
            "cpc_group_lvl4",
            "grant_year" AS "best_year",
            "ema_val",
            ROW_NUMBER() OVER(PARTITION BY "cpc_group_lvl4" ORDER BY "ema_val" DESC) AS rk
        FROM ema_r
    )
    WHERE rk=1
)
SELECT *
FROM best
ORDER BY "ema_val" DESC
LIMIT 20
