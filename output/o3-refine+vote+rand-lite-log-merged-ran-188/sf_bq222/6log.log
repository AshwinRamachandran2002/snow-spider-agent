--Description: 2) Flatten the CPC list to see individual CPC codes for those December 2016 German grants  
SELECT t."publication_number",
       c.value:"code"::STRING AS "cpc_code"
FROM   PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN (input => t."cpc") c
WHERE  t."country_code" = 'DE'
  AND  t."grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
