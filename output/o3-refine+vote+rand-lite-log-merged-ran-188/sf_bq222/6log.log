```sql
--Description: 5) Count patent filings per year for each German level-4 CPC group (limited rows preview)  
SELECT SUBSTR(c.value:"code"::STRING,1,4)                     AS "cpc_group",
       FLOOR(t."filing_date"/10000)                           AS "filing_year",
       COUNT(DISTINCT t."publication_number")                 AS "filings"
FROM   PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN (input => t."cpc") c
WHERE  t."country_code" = 'DE'
  AND  t."grant_date" BETWEEN 20161201 AND 20161231
GROUP  BY "cpc_group","filing_year"
ORDER  BY "cpc_group","filing_year"
LIMIT 20;
```

```sql
--Description: 6) Add row numbers to prepare the ordered yearly series per CPC group  
WITH yearly AS (
  SELECT SUBSTR(c.value:"code"::STRING,1,4) AS "cpc_group",
         FLOOR(t."filing_date"/10000)        AS "filing_year",
         COUNT(DISTINCT t."publication_number") AS "filings"
  FROM   PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN (input => t."cpc") c
  WHERE  t."country_code" = 'DE'
    AND  t."grant_date" BETWEEN 20161201 AND 20161231
  GROUP  BY "cpc_group","filing_year"
)
SELECT *,
       ROW_NUMBER() OVER (PARTITION BY "cpc_group"
                          ORDER BY "filing_year") AS "rn"
FROM   yearly
ORDER  BY "cpc_group","filing_year"
LIMIT 20;
```

```sql
--Description: 7) Recursive calculation of exponential moving average (α = 0.1) for each CPC group  
WITH yearly AS (
  SELECT SUBSTR(c.value:"code"::STRING,1,4) AS "cpc_group",
         FLOOR(t."filing_date"/10000)        AS "filing_year",
         COUNT(DISTINCT t."publication_number") AS "filings",
         ROW_NUMBER() OVER (PARTITION BY SUBSTR(c.value:"code"::STRING,1,4)
                            ORDER BY FLOOR(t."filing_date"/10000)) AS "rn"
  FROM   PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN (input => t."cpc") c
  WHERE  t."country_code" = 'DE'
    AND  t."grant_date" BETWEEN 20161201 AND 20161231
  GROUP  BY 1,2
),
ema_rec AS (
  -- seed with the earliest year per group
  SELECT "cpc_group","filing_year","filings","rn",
         "filings"::FLOAT AS "ema"
  FROM   yearly
  WHERE  "rn" = 1
  UNION ALL
  -- recursive step
  SELECT y."cpc_group",
         y."filing_year",
         y."filings",
         y."rn",
         0.1*y."filings" + 0.9*e."ema" AS "ema"
  FROM   ema_rec e
  JOIN   yearly  y
    ON   y."cpc_group" = e."cpc_group"
   AND   y."rn"        = e."rn" + 1
)
SELECT *
FROM   ema_rec
ORDER  BY "cpc_group","filing_year"
LIMIT 20;
```

```sql
--Description: 8) For each CPC group, pick the year in which EMA is highest  
WITH ema AS ( /* same CTE from query #7 */ 
  SELECT * FROM ( /* placeholder to shorten text */ )
),
best_year AS (
  SELECT "cpc_group",
         "filing_year" AS "best_year",
         "ema",
         ROW_NUMBER() OVER (PARTITION BY "cpc_group"
                            ORDER BY "ema" DESC) AS "rank_ema"
  FROM   ema
)
SELECT *
FROM   best_year
WHERE  "rank_ema" = 1
ORDER  BY "ema" DESC
LIMIT 20;
```

```sql
--Description: 9) Join the best-year EMA results with CPC_DEFINITION titles (filter to level 4 groups)  
WITH ema AS ( /* same CTE from query #7 */ 
  SELECT * FROM ( /* placeholder */ )
),
best_year AS (
  SELECT "cpc_group",
         "filing_year" AS "best_year",
         "ema",
         ROW_NUMBER() OVER (PARTITION BY "cpc_group"
                            ORDER BY "ema" DESC) AS "rank_ema"
  FROM   ema
),
final AS (
