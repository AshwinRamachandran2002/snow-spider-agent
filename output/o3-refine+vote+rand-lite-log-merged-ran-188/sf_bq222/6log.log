```sql
--Description (thinking process inline):
-- Step-0  Objective: For patents granted in Germany during Dec-2016,
--         take every CPC code, roll it up to its 4-character “level-4” group,
--         count the number of filings per year, calculate an exponential
--         moving average (EMA, α = 0.1) through the years for each group,
--         and keep the single year where that EMA peaks.  Finally attach
--         the CPC full title from CPC_DEFINITION and show the top results.
--
-- Step-1  YEARLY  – build yearly filing counts per CPC-4 group.
-- Step-2  EMA_REC – recursive CTE to walk chronologically and
--         compute EMA_t = 0.1·count_t + 0.9·EMA_{t-1}.
-- Step-3  BEST_YEAR – within each group keep the max-EMA year.
-- Step-4  Join to CPC_DEFINITION for the human-readable title.
WITH
yearly AS (                                                          -- Step-1
    SELECT  SUBSTR(c.value:"code"::STRING, 1, 4)         AS "cpc_group",
            FLOOR(t."filing_date" / 10000)               AS "filing_year",
            COUNT(DISTINCT t."publication_number")       AS "filings",
            ROW_NUMBER() OVER (
                PARTITION BY SUBSTR(c.value:"code"::STRING, 1, 4)
                ORDER BY FLOOR(t."filing_date" / 10000)
            )                                            AS "rn"
    FROM   PATENTS.PATENTS.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."cpc") c
    WHERE  t."country_code" = 'DE'
      AND  t."grant_date"   BETWEEN 20161201 AND 20161231
    GROUP  BY 1, 2
),
RECURSIVE ema_rec AS (                                               -- Step-2
    -- seed row (earliest year) per CPC group
    SELECT  "cpc_group",
            "filing_year",
            "filings",
            "rn",
            "filings"::FLOAT                         AS "ema"
    FROM    yearly
    WHERE   "rn" = 1
    UNION ALL
    -- recursive calculation for subsequent years
    SELECT  y."cpc_group",
            y."filing_year",
            y."filings",
            y."rn",
            0.1 * y."filings" + 0.9 * e."ema"        AS "ema"
    FROM    ema_rec e
    JOIN    yearly y
           ON y."cpc_group" = e."cpc_group"
          AND y."rn"        = e."rn" + 1
),
best_year AS (                                                      -- Step-3
    SELECT  "cpc_group",
            "filing_year"                          AS "best_year",
            "ema",
            ROW_NUMBER() OVER (
                PARTITION BY "cpc_group"
                ORDER BY "ema" DESC, "filing_year"
            ) AS "rk"
    FROM    ema_rec
)
SELECT  d."titleFull"                         AS "cpc_title",
