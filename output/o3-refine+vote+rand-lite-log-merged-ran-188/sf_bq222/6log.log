--Description: 10) Show the top CPC technology areas (level-4) with the highest peak EMA across all groups
WITH RECURSIVE
/*───────────── yearly: distinct-patent counts by filing year & CPC-4 ─────────────*/
yearly AS (
    SELECT  SUBSTR(c.value:"code"::STRING,1,4)            AS "cpc_group",
            FLOOR(t."filing_date"/10000)                  AS "filing_year",
            COUNT(DISTINCT t."publication_number")        AS "filings",
            ROW_NUMBER() OVER (
                PARTITION BY SUBSTR(c.value:"code"::STRING,1,4)
                ORDER BY FLOOR(t."filing_date"/10000)
            )                                             AS "rn"
    FROM   PATENTS.PATENTS.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."cpc") c
    WHERE  t."country_code" = 'DE'
      AND  t."grant_date"   BETWEEN 20161201 AND 20161231
    GROUP  BY 1,2
),
/*───────────── ema_rec: recursive EMA calculation (α = 0.1) ─────────────────────*/
ema_rec AS (
    SELECT "cpc_group","filing_year","filings","rn","filings"::FLOAT AS "ema"
    FROM   yearly
    WHERE  "rn" = 1
    UNION ALL
    SELECT y."cpc_group",
           y."filing_year",
           y."filings",
           y."rn",
           0.1*y."filings" + 0.9*e."ema"                             AS "ema"
    FROM   ema_rec e
    JOIN   yearly  y
           ON y."cpc_group" = e."cpc_group"  AND  y."rn" = e."rn" + 1
),
/*───────────── best_year: keep peak-EMA year per group ──────────────────────────*/
best_year AS (
    SELECT  "cpc_group",
            "filing_year"                               AS "best_year",
            "ema",
            ROW_NUMBER() OVER (
                PARTITION BY "cpc_group"
                ORDER BY "ema" DESC, "filing_year"
            ) AS "rk"
    FROM    ema_rec
),
/*───────────── final: attach CPC titles (no level filter) ───────────────────────*/
final AS (
    SELECT  b."cpc_group",
            b."best_year",
            b."ema",
            d."titleFull"
    FROM    best_year b
    LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
           ON d."symbol" = b."cpc_group"
    WHERE   b."rk" = 1
)
SELECT *
FROM   final
ORDER  BY "ema" DESC
LIMIT 20
