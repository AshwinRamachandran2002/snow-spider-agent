                ORDER BY FLOOR(t."filing_date"/10000)
            )                                             AS "rn"
    FROM   PATENTS.PATENTS.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."cpc") c
    WHERE  t."country_code" = 'DE'
      AND  t."grant_date"   BETWEEN 20161201 AND 20161231
    GROUP  BY 1,2
),
/*───────────── ema_rec: recursive EMA calculation (α = 0.1) ─────────────────────*/
ema_rec AS (
    SELECT "cpc_group","filing_year","filings","rn","filings"::FLOAT AS "ema"
    FROM   yearly
    WHERE  "rn" = 1
    UNION ALL
    SELECT y."cpc_group",
