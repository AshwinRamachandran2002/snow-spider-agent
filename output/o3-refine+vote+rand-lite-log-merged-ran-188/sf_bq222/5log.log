--                     EMA₀ = 0.1 × grants₀  
--                     EMAₜ = 0.1 × grantsₜ + 0.9 × EMAₜ₋₁  
--              • Step 5  (best):  select, for each CPC group, the calendar year where its EMA is
--                highest.  
--              • Final  :  join CPC_DEFINITION (level 4) to fetch the full technology title and
--                list the CPC group, its “best year”, and the peak EMA value.  Results are sorted
--                by peak EMA (descending) and limited to the top 20 rows.
WITH dec_groups AS (  /* Step 1 */
    SELECT DISTINCT SUBSTR(f.value:"code"::STRING,1,4) AS "cpc_group"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
