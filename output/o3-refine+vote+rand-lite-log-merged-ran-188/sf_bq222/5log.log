--Description:  End-to-end query, written once, that:
--  • Identifies every CPC level-4 group present on German patents granted in December 2016.
--  • Builds annual German-grant counts for those groups across all years.
--  • Calculates an exponential moving average (EMA) of the yearly counts with α = 0.1
--      via a recursive CTE (EMA₀ = 0.1·x₀;  EMAₜ = 0.1·xₜ + 0.9·EMAₜ₋₁).
--  • Selects, for each CPC group, the calendar year where that EMA reaches its maximum.
--  • Joins CPC_DEFINITION (level 4) to obtain the full technology title.
--  • Returns the 20 technology areas whose peak EMA values are highest.
WITH
dec_groups AS (                 /* CPC-L4 codes on DE patents granted in Dec-2016 */
    SELECT DISTINCT SUBSTR(f.value:"code"::STRING,1,4) AS "cpc_group"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") f
    WHERE  p."country_code" = 'DE'
      AND  p."grant_date"   BETWEEN 20161201 AND 20161231
),
yearly AS (                     /* annual grant counts for those CPC groups */
    SELECT SUBSTR(f.value:"code"::STRING,1,4) AS "cpc_group",
           FLOOR(p."grant_date"/10000)        AS "year",
           COUNT(*)                           AS "grants"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") f
    WHERE  p."country_code" = 'DE'
      AND  p."grant_date"   IS NOT NULL
      AND  SUBSTR(f.value:"code"::STRING,1,4) IN (SELECT "cpc_group" FROM dec_groups)
    GROUP  BY 1,2
),
ordered AS (                    /* contiguous row numbers per group for recursion */
    SELECT "cpc_group","year","grants",
           ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY "year") AS rn
    FROM   yearly
),
rec AS (                        /* recursive EMA calculation (α = 0.1) */
    SELECT "cpc_group","year","grants", rn,
           CAST("grants" AS FLOAT)*0.1 AS ema            -- seed per group
    FROM   ordered
    WHERE  rn = 1
    UNION ALL
    SELECT o."cpc_group", o."year", o."grants", o.rn,
           0.1*o."grants" + 0.9*r.ema  AS ema            -- recursive step
    FROM   rec r
    JOIN   ordered o
      ON   o."cpc_group" = r."cpc_group"
     AND   o.rn          = r.rn + 1
),
best AS (                       /* pick the highest-EMA year for each group */
    SELECT "cpc_group",
           "year"           AS "best_year",
           ROUND(ema,2)     AS "peak_ema",
           ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY ema DESC) AS rk
    FROM   rec
)
SELECT d."titleFull"            AS "cpc_title",
       b."cpc_group",
       b."best_year",
       b."peak_ema"
FROM   best b
JOIN   PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."cpc_group"
      AND d."level"  = 4
WHERE  b.rk = 1                 -- keep only the max-EMA row per group
ORDER  BY b."peak_ema" DESC
LIMIT  20;
