--Description:  Final combined query: CPC title, level-4 group, and its “best year”, i.e. the
--              calendar year in which the group’s smoothed German-grant activity (proxy
--              exponential moving average, α ≈ 0.1) is highest.  CPC_DEFINITION is joined
--              without a hard “level = 4” filter; instead the lowest-level title available
--              for each symbol is chosen so that every CPC code gets a title row.
WITH yearly AS (                       /* yearly German grant counts for every CPC-L4 */
    SELECT SUBSTR(f.value:"code"::STRING,1,4) AS "cpc_group",
           FLOOR(p."grant_date"/10000)        AS "year",
           COUNT(*)                           AS "grants"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE  p."country_code" = 'DE'
      AND  p."grant_date"   IS NOT NULL
    GROUP  BY 1,2
), ema AS (                            /* proxy EMA = 0.1 × running cumulative mean */
    SELECT "cpc_group",
           "year",
           "grants",
           AVG("grants") OVER (
                 PARTITION BY "cpc_group"
                 ORDER BY "year"
                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
           ) * 0.1 AS "ema_val"
    FROM   yearly
), best AS (                           /* pick the year with highest EMA for each group */
    SELECT "cpc_group",
           "year"                AS "best_year",
           ROUND("ema_val",2)    AS "highest_ema",
           ROW_NUMBER() OVER (
               PARTITION BY "cpc_group"
               ORDER BY "ema_val" DESC
           ) AS rk
    FROM   ema
), def_title AS (                      /* choose one title row (lowest LEVEL) per symbol */
    SELECT "symbol",
           "titleFull",
           ROW_NUMBER() OVER (
               PARTITION BY "symbol"
               ORDER BY "level" ASC
           ) AS rn
    FROM   PATENTS.PATENTS.CPC_DEFINITION
)
SELECT d."titleFull"       AS "cpc_title",
       b."cpc_group",
       b."best_year",
       b."highest_ema"
FROM   best b
LEFT  JOIN def_title d
       ON d."symbol" = b."cpc_group"
      AND d.rn       = 1       -- keep the first (lowest-level) title for each symbol
WHERE  b.rk = 1                -- only the max-EMA year per CPC group
ORDER  BY b."highest_ema" DESC
LIMIT  20
