```sql
--Description:  Full pipeline in ONE statement.  
--              Goal → For every CPC level-4 technology area that occurs on German patents granted
--              in December 2016, find the calendar year in which its German grant-count achieved
--              the highest exponential moving average (EMA) using α = 0.1.  
--              Logic flow (inside CTE chain):  
--              ① dec2016_groups  : list distinct CPC-L4 codes from DE grants in Dec-2016.  
--              ② yearly          : build annual grant counts (all years) for just those codes.  
--              ③ ordered         : add row numbers (per CPC group) to drive recursion.  
--              ④ rec (recursive) : compute EMA iteratively (EMA₀ = 0.1·x₀; thereafter  
--                                   EMAₜ = 0.1·xₜ + 0.9·EMAₜ₋₁).  
--              ⑤ best            : pick the year with the maximum EMA for each CPC group.  
--              ⑥ Join CPC_DEFINITION (level 4) to show full technology titles, and output the top
--                 20 groups by highest EMA.  All column references are double-quoted to conform to
--                 Snowflake naming rules.
WITH
dec2016_groups AS (   -- ① CPC-L4 groups present in DE grants during Dec-2016
    SELECT DISTINCT SUBSTR(f.value:"code"::STRING,1,4) AS "cpc_group"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") f
    WHERE  p."country_code" = 'DE'
      AND  p."grant_date" BETWEEN 20161201 AND 20161231
),
yearly AS (           -- ② annual DE grant counts for those groups (all years)
    SELECT SUBSTR(f.value:"code"::STRING,1,4) AS "cpc_group",
           FLOOR(p."grant_date"/10000)        AS "year",
           COUNT(*)                           AS "grants"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") f
    WHERE  p."country_code" = 'DE'
      AND  p."grant_date" IS NOT NULL
      AND  SUBSTR(f.value:"code"::STRING,1,4) IN (SELECT "cpc_group" FROM dec2016_groups)
    GROUP  BY 1,2
),
ordered AS (          -- ③ chronological ordering with row numbers per group
    SELECT "cpc_group","year","grants",
           ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY "year") AS rn
    FROM   yearly
),
rec AS (              -- ④ recursive EMA computation
    SELECT "cpc_group","year","grants",
           CAST("grants" AS FLOAT)*0.1 AS ema,"rn"
    FROM   ordered
    WHERE  rn = 1
    UNION ALL
    SELECT o."cpc_group", o."year", o."grants",
           0.1*o."grants" + 0.9*r.ema         AS ema,
           o.rn
    FROM   rec r
