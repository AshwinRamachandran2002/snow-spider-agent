--Description:  ONE self-contained query that answers the task.  
--              Objective → For each CPC level-4 technology area that appears on German patents
--              granted in December 2016, find the calendar year in which its German grant count
--              attains the highest exponential moving average (EMA) using a smoothing factor
--              α = 0.1.  Finally, list the CPC group, its full title (level 4), the “best year”,
--              and the peak EMA value.  
--              ── Thinking process encoded in the CTE chain ──────────────────────────  
--              ① dec2016_groups : grab distinct CPC-L4 codes from DE patents granted 1-31 Dec 2016.  
--              ② yearly         : for those codes, count how many DE patents were granted each
--                                 calendar year (all years in the database).  
--              ③ ordered        : add a contiguous row number per CPC group so the recursion can
--                                 march step-by-step even if some years are missing.  
--              ④ rec            : recursive EMA computation  
--                                     • seed row  = 0.1 × grants₀  
--                                     • EMAₜ = 0.1 × grantsₜ + 0.9 × EMAₜ₋₁  
--              ⑤ best           : pick the year with the highest EMA for each CPC group.  
--              ⑥ Join CPC_DEFINITION (level 4) to fetch human-readable technology titles.  
--              Result shows the 20 CPC groups with the greatest peak EMA values.
WITH
dec2016_groups AS (     /* ① CPC-L4 groups present on German patents granted in Dec-2016 */
    SELECT DISTINCT SUBSTR(f.value:"code"::STRING,1,4) AS "cpc_group"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") f
    WHERE  p."country_code" = 'DE'
      AND  p."grant_date" BETWEEN 20161201 AND 20161231
),
yearly AS (             /* ② yearly grant counts for those CPC groups (all years) */
    SELECT SUBSTR(f.value:"code"::STRING,1,4) AS "cpc_group",
           FLOOR(p."grant_date"/10000)        AS "year",
           COUNT(*)                           AS "grants"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") f
    WHERE  p."country_code" = 'DE'
      AND  p."grant_date" IS NOT NULL
      AND  SUBSTR(f.value:"code"::STRING,1,4) IN (SELECT "cpc_group" FROM dec2016_groups)
    GROUP  BY 1,2
),
ordered AS (            /* ③ impose sequential order per CPC group */
    SELECT "cpc_group","year","grants",
           ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY "year") AS rn
    FROM   yearly
),
rec AS (                /* ④ recursive EMA calculation */
    -- seed: first row for each CPC group
    SELECT rn,
           "cpc_group",
           "year",
           "grants",
           CAST("grants" AS FLOAT)*0.1 AS ema
    FROM   ordered
    WHERE  rn = 1
    UNION ALL
    -- recursion: next row (rn + 1)
    SELECT o.rn,
           o."cpc_group",
           o."year",
           o."grants",
           0.1*o."grants" + 0.9*r.ema AS ema
    FROM   rec r
    JOIN   ordered o
      ON   o."cpc_group" = r."cpc_group"
     AND   o.rn          = r.rn + 1
),
best AS (               /* ⑤ select the year with highest EMA for each CPC group */
    SELECT "cpc_group",
           "year"        AS best_year,
           ROUND(ema,2)  AS highest_ema,
           ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY ema DESC) AS rk
    FROM   rec
)
SELECT d."titleFull"       AS "cpc_title",
       b."cpc_group",
       b."best_year",
       b."highest_ema"
FROM   best b
JOIN   PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."cpc_group"  AND d."level" = 4
WHERE  b.rk = 1                   /* keep only the max-EMA year per group */
ORDER  BY b."highest_ema" DESC
LIMIT  20;
