    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") f
    WHERE  p."country_code" = 'DE'
      AND  p."grant_date"   > 0                          -- discard missing dates
      AND  SUBSTR(f.value:"code"::STRING,1,4) IN (SELECT "cpc_group" FROM dec_groups)
    GROUP  BY 1,2
),
ordered AS (        /* Step 3 */
    SELECT "cpc_group","year","grants",
           ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY "year") AS rn
    FROM   yearly
),
rec AS (            /* Step 4: recursive EMA */
