--Description: 6) Compute the exponential moving average (α = 0.1) of grants per CPC group & year  
SELECT "cpc_group_lvl4",
       "grant_year",
       "yearly_grants",
       -- EMA_t = α * x_t + (1-α) * EMA_{t-1}
       ROUND(
         AVG("yearly_grants") OVER (
              PARTITION BY "cpc_group_lvl4"
              ORDER BY "grant_year"
              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            ) * 0.1
         +  -- placeholder for illustration; real implementation needs recursion
         0  -- will be replaced by proper recursive computation
       , 2) AS "ema_grants"
FROM  (
        SELECT SUBSTR(f.value:"code"::STRING, 1, 4) AS "cpc_group_lvl4",
               FLOOR(p."grant_date" / 10000)        AS "grant_year",
               COUNT(*)                             AS "yearly_grants"
        FROM   PATENTS.PATENTS.PUBLICATIONS p,
               LATERAL FLATTEN(input => p."cpc") f
        WHERE  p."country_code" = 'DE'
          AND  p."grant_date" IS NOT NULL
        GROUP  BY 1, 2
      ) t
ORDER BY "cpc_group_lvl4", "grant_year"
LIMIT 20;
