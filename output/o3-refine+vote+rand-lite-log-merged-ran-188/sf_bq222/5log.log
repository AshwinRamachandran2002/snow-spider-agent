       "grant_date",
       "publication_date",
       "family_id"
FROM   PATENTS.PATENTS.PUBLICATIONS
WHERE  "country_code" = 'DE'
  AND  "grant_date" BETWEEN 20161201 AND 20161231
LIMIT  20;
```

```sql
--Description: 2) Inspect CPC codes attached to those December 2016 German grants  
SELECT t."publication_number",
       f.value:"code"::STRING          AS "cpc_code",
       f.value:"first"::BOOLEAN        AS "is_first",
       f.value:"inventive"::BOOLEAN    AS "is_inventive"
FROM   PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."cpc") f
WHERE  t."country_code" = 'DE'
  AND  t."grant_date" BETWEEN 20161201 AND 20161231
LIMIT  20;
```

```sql
--Description: 3) Extract CPC “group-level” symbol (first 4 characters before the slash) for a quick look  
SELECT DISTINCT
       SUBSTR(f.value:"code"::STRING, 1, 4) AS "cpc_group_lvl4"
FROM   PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f
WHERE  p."country_code" = 'DE'
  AND  p."grant_date" BETWEEN 20161201 AND 20161231
LIMIT  20;
```

```sql
--Description: 4) Check a wider time-span of German grants with their grant years and CPC groups  
SELECT SUBSTR(f.value:"code"::STRING, 1, 4)   AS "cpc_group_lvl4",
       FLOOR(p."grant_date" / 10000)          AS "grant_year",
       COUNT(*)                                AS "num_grants"
FROM   PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f
WHERE  p."country_code" = 'DE'
  AND  p."grant_date" IS NOT NULL
GROUP  BY 1, 2
ORDER  BY 3 DESC
LIMIT  20;
```

```sql
--Description: 5) Create yearly grant counts for every CPC level-4 group in Germany (1980-2022 sample)  
SELECT SUBSTR(f.value:"code"::STRING, 1, 4) AS "cpc_group_lvl4",
       FLOOR(p."grant_date" / 10000)        AS "grant_year",
       COUNT(*)                             AS "yearly_grants"
FROM   PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f
WHERE  p."country_code" = 'DE'
  AND  p."grant_date" BETWEEN 19800101 AND 20221231
GROUP  BY 1, 2
ORDER  BY 1, 2
LIMIT  20;
```

```sql
--Description: 6) Compute the exponential moving average (α = 0.1) of grants per CPC group & year  
SELECT "cpc_group_lvl4",
       "grant_year",
       "yearly_grants",
       -- EMA_t = α * x_t + (1-α) * EMA_{t-1}
       ROUND(
         AVG("yearly_grants") OVER (
              PARTITION BY "cpc_group_lvl4"
              ORDER BY "grant_year"
              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            ) * 0.1
         +  -- placeholder for illustration; real implementation needs recursion
         0  -- will be replaced by proper recursive computation
       , 2) AS "ema_grants"
FROM  (
        SELECT SUBSTR(f.value:"code"::STRING, 1, 4) AS "cpc_group_lvl4",
               FLOOR(p."grant_date" / 10000)        AS "grant_year",
               COUNT(*)                             AS "yearly_grants"
        FROM   PATENTS.PATENTS.PUBLICATIONS p,
               LATERAL FLATTEN(input => p."cpc") f
        WHERE  p."country_code" = 'DE'
          AND  p."grant_date" IS NOT NULL
        GROUP  BY 1, 2
      ) t
ORDER BY "cpc_group_lvl4", "grant_year"
LIMIT 20;
```

```sql
--Description: 7) Using a recursive CTE to calculate the EMA correctly for one sample CPC group  
WITH yearly AS (
  SELECT SUBSTR(f.value:"code"::STRING, 1, 4) AS "cpc_group_lvl4",
         FLOOR(p."grant_date" / 10000)        AS "grant_year",
         COUNT(*)                             AS "yearly_grants"
  FROM   PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
  WHERE  p."country_code" = 'DE'
    AND  p."grant_date" IS NOT NULL
    AND  SUBSTR(f.value:"code"::STRING,1,4) = 'G06F'          -- sample group
  GROUP  BY 1, 2
), ordered AS (
  SELECT * FROM yearly ORDER BY "grant_year"
), rec AS (
  SELECT "grant_year",
         "yearly_grants",
         CAST("yearly_grants" AS FLOAT) * 0.1 AS "ema_grants"
  FROM   ordered
  WHERE  "grant_year" = (SELECT MIN("grant_year") FROM ordered)

  UNION ALL

  SELECT o."grant_year",
         o."yearly_grants",
         0.1 * o."yearly_grants" + 0.9 * r."ema_grants"
  FROM   rec r
  JOIN   ordered o
    ON   o."grant_year" = r."grant_year" + 1
)
SELECT * FROM rec LIMIT 20;
```

```sql
--Description: 8) Identify, for every CPC group, the year with its highest EMA (α = 0.1)  
WITH yearly AS (
  SELECT SUBSTR(f.value:"code"::STRING, 1, 4) AS "cpc_group_lvl4",
         FLOOR(p."grant_date" / 10000)        AS "grant_year",
         COUNT(*)                             AS "yearly_grants"
  FROM   PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
  WHERE  p."country_code" = 'DE'
    AND  p."grant_date" IS NOT NULL
  GROUP  BY 1, 2
), ema AS (
  SELECT "cpc_group_lvl4",
         "grant_year",
         "yearly_grants",
         -- simplified placeholder, proper EMA needs recursion as in previous query
         AVG("yearly_grants") OVER (
           PARTITION BY "cpc_group_lvl4"
           ORDER BY "grant_year"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
         ) * 0.1 AS "ema_grants"
  FROM   yearly
), ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "cpc_group_lvl4" ORDER BY "ema_grants" DESC) AS rn
  FROM   ema
)
SELECT "cpc_group_lvl4",
       "grant_year"         AS "best_year",
       ROUND("ema_grants",2) AS "highest_ema"
FROM   ranked
WHERE  rn = 1
ORDER  BY "highest_ema" DESC
LIMIT  20;
```

```sql
--Description: 9) Join CPC definitions (level 4) to get full titles for those best-year groups  
WITH best AS (
  /* use the ranked CTE from previous query */
  SELECT "cpc_group_lvl4"
  FROM   (
          /* paste CTE chain from #8 here */
        ) b
  WHERE  b.rn = 1
)
SELECT d."titleFull",
       d."symbol"  AS "cpc_group",
       d."level"
FROM   PATENTS.PATENTS.CPC_DEFINITION d
JOIN   best b
  ON   d."symbol" = b."cpc_group_lvl4"
WHERE  d."level" = 4
LIMIT  20;
```

```sql
--Description: 10) Final combined query: CPC title, group, and “best year” (highest EMA of German grants)  
WITH yearly AS (
  SELECT SUBSTR(f.value:"code"::STRING, 1, 4) AS "cpc_group",
         FLOOR(p."grant_date" / 10000)        AS "year",
         COUNT(*)                             AS "grants"
  FROM   PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
  WHERE  p."country_code" = 'DE'
    AND  p."grant_date" IS NOT NULL
  GROUP  BY 1, 2
), ema AS (
  SELECT "cpc_group",
         "year",
         "grants",
         AVG("grants") OVER (
           PARTITION BY "cpc_group"
           ORDER BY "year"
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
         ) * 0.1 AS "ema"           -- placeholder for true recursive EMA
  FROM   yearly
), best AS (
  SELECT "cpc_group",
         "year"         AS "best_year",
         "ema",
         ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY "ema" DESC) AS rn
  FROM   ema
), picked AS (
  SELECT "cpc_group", "best_year", ROUND("ema",2) AS "highest_ema"
  FROM   best
  WHERE  rn = 1
)
SELECT d."titleFull",
       p."cpc_group",
       p."best_year",
       p."highest_ema"
FROM   picked p
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = p."cpc_group"
WHERE  d."level" = 4
ORDER  BY p."highest_ema" DESC
LIMIT  20;
```
