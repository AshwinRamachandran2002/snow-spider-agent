--Description:  End-to-end query (one statement) that
--              1) gets every CPC level-4 group (first 4 chars of CPC code) appearing on
--                 German patents granted in December 2016;
--              2) counts, for each of those groups, how many German patents were granted
--                 in every calendar year;
--              3) computes a proper exponential moving average (EMA, α = 0.1) of the yearly
--                 counts via recursion (EMA₀ = 0.1·x₀, EMAₜ = 0.1·xₜ + 0.9·EMAₜ₋₁);
--              4) picks, for each group, the year whose EMA reaches the maximum (“best year”);
--              5) joins CPC_DEFINITION to attach one human-readable title per CPC symbol
--                 (choose the row with the lowest LEVEL value for that symbol);
--              6) returns the 20 technology areas with the highest peak-EMA values.
WITH dec_groups AS (            /* 1 ─ CPC-L4 codes on DE grants in Dec-2016 */
    SELECT DISTINCT SUBSTR(f.value:"code"::STRING,1,4) AS "cpc_group"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE  p."country_code" = 'DE'
      AND  p."grant_date" BETWEEN 20161201 AND 20161231
),
yearly AS (                     /* 2 ─ annual grant counts for those groups */
    SELECT SUBSTR(f.value:"code"::STRING,1,4) AS "cpc_group",
           FLOOR(p."grant_date"/10000)        AS "year",
           COUNT(*)                           AS "grants"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(INPUT => p."cpc") f
    WHERE  p."country_code" = 'DE'
      AND  p."grant_date"  > 0
      AND  SUBSTR(f.value:"code"::STRING,1,4) IN (SELECT "cpc_group" FROM dec_groups)
    GROUP  BY 1,2
),
ordered AS (                   /* 3 ─ contiguous row numbers per group */
    SELECT "cpc_group","year","grants",
           ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY "year") AS rn
    FROM   yearly
),
rec AS (                       /* 3 (cont.) ─ recursive EMA calculation */
    /* seed row (rn = 1) */
    SELECT "cpc_group","year","grants", rn,
           CAST("grants" AS FLOAT)*0.1 AS ema
    FROM   ordered
    WHERE  rn = 1
    UNION ALL
    /* recursive step */
    SELECT o."cpc_group", o."year", o."grants", o.rn,
           0.1*o."grants" + 0.9*r.ema AS ema
    FROM   rec r
    JOIN   ordered o
      ON   o."cpc_group" = r."cpc_group"
     AND   o.rn          = r.rn + 1
),
best AS (                      /* 4 ─ choose best EMA year per group */
    SELECT "cpc_group",
           "year"            AS "best_year",
           ROUND(ema,2)      AS "peak_ema",
           ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY ema DESC) AS rk
    FROM   rec
),
def_title AS (                 /* 5 ─ one title (lowest LEVEL) per symbol */
    SELECT "symbol",
           "titleFull",
           ROW_NUMBER() OVER (PARTITION BY "symbol" ORDER BY "level" ASC) AS rn
    FROM   PATENTS.PATENTS.CPC_DEFINITION
)
SELECT d."titleFull"           AS "cpc_title",
       b."cpc_group",
       b."best_year",
       b."peak_ema"
FROM   best b
LEFT  JOIN def_title d
       ON d."symbol" = b."cpc_group"
      AND d.rn       = 1
WHERE  b.rk = 1                -- keep only the peak-EMA row per group
ORDER  BY b."peak_ema" DESC
LIMIT  20;
