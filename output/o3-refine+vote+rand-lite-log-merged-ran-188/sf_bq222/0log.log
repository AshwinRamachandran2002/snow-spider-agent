--Description: 10) Final report – top CPC level-4 technology areas in Germany ranked by the highest EMA of patent filings (α = 0.1) and their best year  
WITH base AS (
    SELECT  FLOOR(t."publication_date"/10000)           AS "pub_year",
            SUBSTR(f.value::VARIANT:"code"::STRING,1,4) AS "cpc_group",
            COUNT(*)                                    AS "filing_cnt"
    FROM    PATENTS.PATENTS.PUBLICATIONS t,
            LATERAL FLATTEN(input => t."cpc") f
    WHERE   t."country_code" = 'DE'
    GROUP   BY FLOOR(t."publication_date"/10000), SUBSTR(f.value::VARIANT:"code"::STRING,1,4)
), years AS (
    SELECT  "cpc_group",
            "pub_year",
            "filing_cnt",
            ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY "pub_year") AS "rn"
    FROM    base
), rec AS (
    SELECT  y."cpc_group",
            y."pub_year",
            y."filing_cnt",
            y."filing_cnt"::FLOAT AS "ema",
            y."rn"
    FROM    years y
    WHERE   y."rn" = 1
    UNION ALL
    SELECT  y."cpc_group",
            y."pub_year",
            y."filing_cnt",
            0.1*y."filing_cnt" + 0.9*r."ema"  AS "ema",
            y."rn"
    FROM    rec r
    JOIN    years y
       ON  y."cpc_group" = r."cpc_group"
       AND y."rn"        = r."rn" + 1
), best AS (
    SELECT  "cpc_group",
            MAX_BY("pub_year","ema") AS "best_year",
            MAX("ema")              AS "max_ema"
    FROM    rec
    GROUP   BY "cpc_group"
)
SELECT  b."cpc_group",
        d."titleFull"            AS "cpc_title",
        b."best_year",
        b."max_ema"
FROM    best b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."cpc_group"
ORDER BY b."max_ema" DESC
LIMIT 20;
