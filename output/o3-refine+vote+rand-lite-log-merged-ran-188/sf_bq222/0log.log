```sql
--Description: Final single-statement solution (with inline “thinking process” comments)
-- 1.  Filter German patents (country_code = 'DE') that were granted in December-2016.
-- 2.  Explode their CPC array; keep only the first 4 characters of each code
--     so that we work at “level-4” (e.g., H04L, B65D …).
-- 3.  Count how many such patents (from our Dec-2016 cohort) fall in each
--     CPC-level-4 group per publication year (pub_year = YYYY portion of publication_date).
-- 4.  Recursively walk through the years – per CPC group – to calculate the
--     Exponential Moving Average (EMA) with α = 0.10:
--       EMA_t = 0.1 * filings_t  +  0.9 * EMA_{t-1}
--     The recursion seeds with the earliest year for each group
--     (EMA_0 = first_year_filings).
-- 5.  For every CPC group, pick the year that reached the highest EMA value
--     (best_year), together with that peak EMA (max_ema).
-- 6.  Join to CPC_DEFINITION to obtain the human-readable “titleFull”.
-- 7.  Return CPC group, full title, best year, and its max EMA,
--     ordered by descending max_ema (top technology areas first).
WITH
/* ------------------------------------------------------- *
 * STEP-1 & STEP-2  :  December-2016 German patents, CPC L4
 * ------------------------------------------------------- */
dec16 AS (
    SELECT  t."publication_number",
            FLOOR(t."publication_date" / 10000)                        AS "pub_year",
            SUBSTR(f.value::VARIANT:"code"::STRING, 1, 4)              AS "cpc_group",
            1                                                          AS "one_patent"
    FROM    PATENTS.PATENTS.PUBLICATIONS t,
            LATERAL FLATTEN(input => t."cpc") f
    WHERE   t."country_code" = 'DE'
      AND   t."grant_date"   BETWEEN 20161201 AND 20161231             -- Dec-2016 grants
),
/* ------------------------------------------------------- *
 * STEP-3 : annual filing counts per CPC-L4
 * ------------------------------------------------------- */
annual_cnt AS (
    SELECT  "cpc_group",
            "pub_year",
            COUNT(*)                    AS "filing_cnt"
    FROM    dec16
    GROUP BY "cpc_group", "pub_year"
),
/* ------------------------------------------------------- *
 * STEP-4 : recursive EMA for each CPC group
 * ------------------------------------------------------- */
RECURSIVE ema_calc ("cpc_group","pub_year","filing_cnt","ema","rn") AS (
    /* seed = earliest year per group */
    SELECT  a."cpc_group",
            a."pub_year",
            a."filing_cnt",
            a."filing_cnt"::FLOAT      AS "ema",
            ROW_NUMBER() OVER (PARTITION BY a."cpc_group" ORDER BY a."pub_year") AS "rn"
    FROM    annual_cnt a
    QUALIFY "rn" = 1
    
    UNION ALL
    
    /* recursive step: attach next chronological year inside same group */
    SELECT  n."cpc_group",
            n."pub_year",
            n."filing_cnt",
            0.1 * n."filing_cnt" + 0.9 * p."ema"   AS "ema",
            p."rn" + 1                             AS "rn"
    FROM    ema_calc p
    JOIN    annual_cnt n
         ON n."cpc_group" = p."cpc_group"
        AND n."pub_year"  = p."pub_year" + 1
),
/* ------------------------------------------------------- *
 * STEP-5 : best EMA year per CPC group
 * ------------------------------------------------------- */
best_year AS (
    SELECT  "cpc_group",
            MAX_BY("pub_year","ema")   AS "best_year",
            MAX("ema")                 AS "max_ema"
    FROM    ema_calc
    GROUP BY "cpc_group"
)
/* ------------------------------------------------------- *
 * STEP-6 & STEP-7 : attach CPC title and present results
 * ------------------------------------------------------- */
SELECT  b."cpc_group",
        d."titleFull"        AS "cpc_title",
        b."best_year",
        b."max_ema"
FROM    best_year b
LEFT  JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."cpc_group"
ORDER BY b."max_ema" DESC
LIMIT 20;
```
