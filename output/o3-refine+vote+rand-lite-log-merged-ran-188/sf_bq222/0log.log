Query:
--Description: 9) Bring in human-readable CPC titles from CPC_DEFINITION.
--              The query repeats the full EMA workflow ( α = 0.1 ) for every
--              German CPC-L4 group, then joins the peak-EMA result to the
--              CPC_DEFINITION table to fetch the descriptive title.
WITH RECURSIVE
/*───────────────────────── ① Yearly counts ─────────────────────────*/
base AS (
    SELECT
        FLOOR(p."publication_date" / 10000)               AS "pub_year",
        SUBSTR(c.value::VARIANT:"code"::STRING, 1, 4)     AS "cpc_l4",
        COUNT(*)                                          AS "filing_cnt"
    FROM   PATENTS.PATENTS.PUBLICATIONS  p,
           LATERAL FLATTEN (INPUT => p."cpc")            c
    WHERE  p."country_code" = 'DE'
    GROUP  BY FLOOR(p."publication_date" / 10000),
              SUBSTR(c.value::VARIANT:"code"::STRING, 1, 4)
),
years AS (
    SELECT
        "cpc_l4",
        "pub_year",
        "filing_cnt",
        ROW_NUMBER() OVER (PARTITION BY "cpc_l4" ORDER BY "pub_year") AS "rn"
    FROM  base
),
/*───────────────────────── ② Recursive EMA ─────────────────────────*/
rec ("cpc_l4","pub_year","filing_cnt","ema","rn") AS (
    SELECT  y."cpc_l4", y."pub_year", y."filing_cnt",
            y."filing_cnt"::FLOAT                    AS "ema",
            y."rn"
    FROM    years y
    WHERE   y."rn" = 1
    UNION ALL
    SELECT  y."cpc_l4", y."pub_year", y."filing_cnt",
            0.1 * y."filing_cnt" + 0.9 * r."ema"     AS "ema",
            y."rn"
    FROM    rec r
    JOIN    years y
          ON y."cpc_l4" = r."cpc_l4"
         AND y."rn"     = r."rn" + 1
),
/*───────────────────────── ③ Peak EMA per group ────────────────────*/
best AS (
    SELECT
        "cpc_l4"                               AS "cpc_group",
        MAX_BY("pub_year","ema")               AS "best_year",
        MAX("ema")                             AS "max_ema"
    FROM   rec
    GROUP  BY "cpc_l4"
)
/*───────────────────────── ④ Attach title & report ─────────────────*/
SELECT
    b."cpc_group",
    d."titleFull"           AS "cpc_title",
    b."best_year",
    b."max_ema"
FROM   best b
LEFT  JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."cpc_group"
ORDER  BY b."max_ema" DESC
LIMIT 20
