```sql
--Description:  Single-statement solution (with inline comments showing the thinking process)
--              Objective:  • Take German (DE) patent publications whose CPC array
--                            contains “H04L”.
--                          • Compute annual filing counts (pub_year vs. filings).
--                          • Use a recursive CTE to calculate the Exponential
--                            Moving Average (EMA) with smoothing α = 0.1.
--                          • Display the resulting time-series (first 20 rows).

WITH RECURSIVE
/*───────────────────────────────────────────────────────────────
  STEP-1  –  Aggregate yearly counts
───────────────────────────────────────────────────────────────*/
yearly AS (
    SELECT  FLOOR("publication_date" / 10000)      AS "pub_year",   -- extract YYYY
            COUNT(*)                               AS "filing_cnt"
    FROM    PATENTS.PATENTS.PUBLICATIONS
    WHERE   "country_code" = 'DE'                                  -- Germany only
      AND   "cpc" ILIKE '%H04L%'                                   -- CPC contains H04L
    GROUP BY FLOOR("publication_date" / 10000)
),
/*───────────────────────────────────────────────────────────────
  STEP-2  –  Recursive EMA computation
            Columns of the CTE:  (pub_year, filing_cnt, ema)
───────────────────────────────────────────────────────────────*/
ema_cte (pub_year, filing_cnt, ema) AS (
    /* Seed row: earliest year  →  EMA₀ = filing_cnt₀ */
    SELECT  y."pub_year",
            y."filing_cnt",
            y."filing_cnt"::FLOAT                     AS "ema"
    FROM    yearly y
    WHERE   y."pub_year" = (SELECT MIN("pub_year") FROM yearly)

    UNION ALL

    /* Recursive step: advance one calendar year */
    SELECT  y."pub_year",
            y."filing_cnt",
            0.1 * y."filing_cnt" + 0.9 * e."ema"      AS "ema"
    FROM    ema_cte e
    JOIN    yearly  y
          ON y."pub_year" = e."pub_year" + 1
)
/*───────────────────────────────────────────────────────────────
  STEP-3  –  Present the EMA time-series
───────────────────────────────────────────────────────────────*/
SELECT *
FROM   ema_cte
ORDER  BY "pub_year"
LIMIT 20;
```
