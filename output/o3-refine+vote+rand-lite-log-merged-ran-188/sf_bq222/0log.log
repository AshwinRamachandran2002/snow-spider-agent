```sql
--Description:  Single-statement workflow (the comments narrate the “thinking process”).
--              Objective:  For every CPC level-4 technology group present in German
--              patent publications, determine the calendar year in which the
--              exponential moving average (EMA, α = 0.1) of filings peaks, then
--              show that peak year/value together with the CPC’s full title.
WITH RECURSIVE
/*────────────────────────────── ① Yearly filing counts ──────────────────────────────*/
base AS (
    SELECT
        FLOOR(p."publication_date" / 10000)               AS "pub_year",      -- YYYY
        SUBSTR(c.value::VARIANT:"code"::STRING, 1, 4)     AS "cpc_l4",        -- level-4 group
        COUNT(*)                                          AS "filing_cnt"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(INPUT => p."cpc") c
    WHERE  p."country_code" = 'DE'                                            -- Germany
    GROUP  BY FLOOR(p."publication_date" / 10000),
              SUBSTR(c.value::VARIANT:"code"::STRING, 1, 4)
),
/* Give each (group,year) row a sequential number to drive recursion */
years AS (
    SELECT
        "cpc_l4",
        "pub_year",
        "filing_cnt",
        ROW_NUMBER() OVER (PARTITION BY "cpc_l4" ORDER BY "pub_year") AS "rn"
    FROM  base
),
/*────────────────────────────── ② Recursive EMA calculation ─────────────────────────*/
rec ("cpc_l4","pub_year","filing_cnt","ema","rn") AS (
    -- Seed row: earliest year in each group (EMA₀ = count₀)
    SELECT
        y."cpc_l4",
        y."pub_year",
        y."filing_cnt",
        y."filing_cnt"::FLOAT                           AS "ema",
        y."rn"
    FROM  years y
    WHERE y."rn" = 1

    UNION ALL

    -- Recursive row: advance one calendar year, apply EMA = 0.1*x + 0.9*EMA_prev
    SELECT
        y."cpc_l4",
        y."pub_year",
        y."filing_cnt",
        0.1 * y."filing_cnt" + 0.9 * r."ema"           AS "ema",
        y."rn"
    FROM  rec  r
    JOIN  years y
          ON y."cpc_l4" = r."cpc_l4"
         AND y."rn"     = r."rn" + 1
),
/*────────────────────────────── ③ Select best EMA year per group ───────────────────*/
best AS (
    SELECT
        "cpc_l4",
        MAX_BY("pub_year", "ema")  AS "best_year",      -- year of peak EMA
        MAX("ema")                 AS "max_ema"
    FROM   rec
    GROUP  BY "cpc_l4"
)
/*────────────────────────────── ④ Attach CPC title & present results ───────────────*/
SELECT
    b."cpc_l4"                       AS "cpc_group",
    d."titleFull"                    AS "cpc_title",
    b."best_year",
    b."max_ema"
FROM   best b
LEFT  JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."cpc_l4"
ORDER  BY b."max_ema" DESC
LIMIT 20;
```
