```sql
--Description:  Single SQL statement (with inline “thinking process” comments) that
--              1) aggregates German patent publications containing CPC text “H04L”
--                 into yearly filing counts, and
--              2) uses a recursive CTE to compute an Exponential Moving Average
--                 (EMA) with smoothing factor α = 0.1, then
--              3) returns the EMA timeline (first 20 rows).

WITH RECURSIVE
/*─────────────────────────────  STEP 1  ─────────────────────────────
  Build yearly filing counts.
  - FLOOR(publication_date / 10000) extracts the 4-digit year (YYYY)
    from the numeric yyyymmdd date format.
  - Restrict rows to Germany (country_code = 'DE').
  - Fuzzy search the CPC JSON column for substring 'H04L'.
───────────────────────────────────────────────────────────────────*/
yearly AS (
    SELECT  FLOOR("publication_date" / 10000)   AS "pub_year",
            COUNT(*)                            AS "filing_cnt"
    FROM    PATENTS.PATENTS.PUBLICATIONS
    WHERE   "country_code" = 'DE'
      AND   "cpc" ILIKE '%H04L%'
    GROUP BY FLOOR("publication_date" / 10000)
),
/*─────────────────────────────  STEP 2  ─────────────────────────────
  Recursive EMA computation.
  - Column list after the CTE name is mandatory for Snowflake.
  - Seed row (earliest year) sets EMA = filing_cnt.
  - Recursive rows join to the next calendar year and apply:
        EMA_t = 0.1 * filings_t  +  0.9 * EMA_{t-1}
───────────────────────────────────────────────────────────────────*/
ema_cte (pub_year, filing_cnt, ema) AS (
    /* Seed row ------------------------------------------------------*/
    SELECT  y."pub_year",
            y."filing_cnt",
            y."filing_cnt"::FLOAT                 AS "ema"
    FROM    yearly y
    WHERE   y."pub_year" = (SELECT MIN("pub_year") FROM yearly)

    UNION ALL

    /* Recursive row -------------------------------------------------*/
    SELECT  y."pub_year",
            y."filing_cnt",
            0.1 * y."filing_cnt" + 0.9 * e."ema"  AS "ema"
    FROM    ema_cte e
    JOIN    yearly  y
           ON y."pub_year" = e."pub_year" + 1
)
/*─────────────────────────────  STEP 3  ─────────────────────────────
  Output ordered EMA series.
───────────────────────────────────────────────────────────────────*/
SELECT *
FROM   ema_cte
ORDER  BY "pub_year"
LIMIT 20;
