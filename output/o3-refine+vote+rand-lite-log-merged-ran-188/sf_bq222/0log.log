--Description: 7) General-purpose EMA for every CPC level-4 group for German patents  
WITH base AS (
    SELECT  FLOOR(t."publication_date"/10000)           AS "pub_year",
            SUBSTR(f.value::VARIANT:"code"::STRING,1,4) AS "cpc_group_lvl4",
            COUNT(*)                                    AS "filing_cnt"
    FROM    PATENTS.PATENTS.PUBLICATIONS t,
            LATERAL FLATTEN(input => t."cpc") f
    WHERE   t."country_code" = 'DE'
    GROUP   BY FLOOR(t."publication_date"/10000), SUBSTR(f.value::VARIANT:"code"::STRING,1,4)
),
years AS (
    /* create ordered rows per group */
    SELECT  "cpc_group_lvl4",
            "pub_year",
            "filing_cnt",
            ROW_NUMBER() OVER (PARTITION BY "cpc_group_lvl4" ORDER BY "pub_year") AS "rn"
    FROM    base
),
rec AS (
    /* recursive EMA per group */
    SELECT  y."cpc_group_lvl4",
            y."pub_year",
            y."filing_cnt",
            y."filing_cnt"::FLOAT AS "ema",
            y."rn"
    FROM    years y
    WHERE   y."rn" = 1
    UNION ALL
    SELECT  y."cpc_group_lvl4",
            y."pub_year",
            y."filing_cnt",
            0.1*y."filing_cnt" + 0.9*r."ema"  AS "ema",
            y."rn"
    FROM    rec r
    JOIN    years y
           ON     y."cpc_group_lvl4" = r."cpc_group_lvl4"
           AND    y."rn"             = r."rn" + 1
)
SELECT * FROM rec
LIMIT 20;
