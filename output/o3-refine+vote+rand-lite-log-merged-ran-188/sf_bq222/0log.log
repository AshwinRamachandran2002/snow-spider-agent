```sql
--Description: 6) Build a yearly series per CPC-group and compute the exponential moving average (α = 0.1) with a recursive CTE for one sample group (“H04L”)  
WITH yearly AS (
    SELECT  FLOOR("publication_date"/10000) AS "pub_year",
            COUNT(*)                       AS "filing_cnt"
    FROM    PATENTS.PATENTS.PUBLICATIONS
    WHERE   "country_code" = 'DE'
      AND   "cpc" ILIKE '%H04L%'            -- quick fuzzy filter
    GROUP   BY FLOOR("publication_date"/10000)
), rec AS (
    SELECT  "pub_year",
            "filing_cnt",
            /* first year’s EMA = its own count */
            "filing_cnt"::FLOAT             AS "ema"
    FROM    yearly
    ORDER   BY "pub_year"
    LIMIT   1
    UNION ALL
    SELECT  y."pub_year",
            y."filing_cnt",
            0.1*y."filing_cnt" + 0.9*r."ema"  AS "ema"
    FROM    rec r
    JOIN    yearly y
           ON y."pub_year" = r."pub_year" + 1
)
SELECT * FROM rec
LIMIT 20;
```

```sql
--Description: 7) General-purpose EMA for every CPC level-4 group for German patents  
WITH base AS (
    SELECT  FLOOR(t."publication_date"/10000)           AS "pub_year",
            SUBSTR(f.value::VARIANT:"code"::STRING,1,4) AS "cpc_group_lvl4",
            COUNT(*)                                    AS "filing_cnt"
    FROM    PATENTS.PATENTS.PUBLICATIONS t,
            LATERAL FLATTEN(input => t."cpc") f
    WHERE   t."country_code" = 'DE'
    GROUP   BY FLOOR(t."publication_date"/10000), SUBSTR(f.value::VARIANT:"code"::STRING,1,4)
),
years AS (
    /* create ordered rows per group */
    SELECT  "cpc_group_lvl4",
            "pub_year",
            "filing_cnt",
            ROW_NUMBER() OVER (PARTITION BY "cpc_group_lvl4" ORDER BY "pub_year") AS "rn"
    FROM    base
),
rec AS (
    /* recursive EMA per group */
    SELECT  y."cpc_group_lvl4",
            y."pub_year",
            y."filing_cnt",
            y."filing_cnt"::FLOAT AS "ema",
            y."rn"
    FROM    years y
    WHERE   y."rn" = 1
    UNION ALL
    SELECT  y."cpc_group_lvl4",
            y."pub_year",
            y."filing_cnt",
            0.1*y."filing_cnt" + 0.9*r."ema"  AS "ema",
            y."rn"
    FROM    rec r
    JOIN    years y
           ON     y."cpc_group_lvl4" = r."cpc_group_lvl4"
           AND    y."rn"             = r."rn" + 1
)
SELECT * FROM rec
LIMIT 20;
```

