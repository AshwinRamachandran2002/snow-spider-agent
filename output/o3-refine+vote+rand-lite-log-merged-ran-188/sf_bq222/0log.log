Query:
--Description: 5) Count German patent publications per year & 4-character CPC group  
WITH cte AS (
    SELECT  FLOOR(t."publication_date"/10000)              AS "pub_year",
            SUBSTR(f.value::VARIANT:"code"::STRING,1,4)    AS "cpc_group_lvl4"
    FROM    PATENTS.PATENTS.PUBLICATIONS t,
            LATERAL FLATTEN(input => t."cpc") f
    WHERE   t."country_code" = 'DE'
)
SELECT "pub_year",
       "cpc_group_lvl4",
       COUNT(*) AS "filing_cnt"
FROM   cte
GROUP  BY "pub_year","cpc_group_lvl4"
ORDER  BY "pub_year" ASC, "filing_cnt" DESC
LIMIT 20;
