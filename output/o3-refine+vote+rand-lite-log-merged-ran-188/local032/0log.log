```sql
-- Description: Sample of seller–order–customer relationships restricted to delivered orders
SELECT DISTINCT oi."seller_id",
                o."order_id",
                c."customer_unique_id"
FROM   "olist_orders"  AS o
JOIN   "olist_order_items" AS oi ON o."order_id" = oi."order_id"
JOIN   "olist_customers"   AS c  ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
LIMIT 20;
```

```sql
-- Description: Sellers ranked by the number of DISTINCT customer_unique_id’s (top 20)
SELECT  oi."seller_id",
        COUNT(DISTINCT c."customer_unique_id") AS distinct_customers
FROM    "olist_orders"  AS o
JOIN    "olist_order_items" AS oi ON o."order_id" = oi."order_id"
JOIN    "olist_customers"   AS c  ON o."customer_id" = c."customer_id"
WHERE   o."order_status" = 'delivered'
GROUP BY oi."seller_id"
ORDER BY distinct_customers DESC
LIMIT 20;
```

```sql
-- Description: Sellers ranked by total profit (Σ(price − freight_value) on delivered orders, top 20)
SELECT  oi."seller_id",
        SUM(oi."price" - oi."freight_value") AS total_profit
FROM    "olist_orders"       AS o
JOIN    "olist_order_items"  AS oi ON o."order_id" = oi."order_id"
WHERE   o."order_status" = 'delivered'
GROUP BY oi."seller_id"
ORDER BY total_profit DESC
LIMIT 20;
```

```sql
-- Description: Sellers ranked by the number of DISTINCT delivered orders they handled (top 20)
SELECT  oi."seller_id",
        COUNT(DISTINCT oi."order_id") AS distinct_orders
FROM    "olist_orders"      AS o
JOIN    "olist_order_items" AS oi ON o."order_id" = oi."order_id"
WHERE   o."order_status" = 'delivered'
GROUP BY oi."seller_id"
ORDER BY distinct_orders DESC
LIMIT 20;
```

```sql
-- Description: Sellers ranked by the number of 5-star reviews received on delivered orders (top 20)
SELECT  oi."seller_id",
        COUNT(DISTINCT r."review_id") AS five_star_reviews
FROM    "olist_orders"       AS o
JOIN    "olist_order_items"  AS oi ON o."order_id" = oi."order_id"
JOIN    "olist_order_reviews" AS r  ON o."order_id" = r."order_id"
WHERE   o."order_status" = 'delivered'
  AND   r."review_score" = 5
GROUP BY oi."seller_id"
ORDER BY five_star_reviews DESC
LIMIT 20;
```

```sql
-- Description: Consolidated view – the single best seller for each of the four requested categories
SELECT 'Most distinct customers' AS description,
       seller_id,
       distinct_value AS value
FROM (
      SELECT oi."seller_id",
             COUNT(DISTINCT c."customer_unique_id") AS distinct_value
      FROM   "olist_orders"  AS o
      JOIN   "olist_order_items" AS oi ON o."order_id" = oi."order_id"
      JOIN   "olist_customers"   AS c  ON o."customer_id" = c."customer_id"
      WHERE  o."order_status" = 'delivered'
      GROUP BY oi."seller_id"
      ORDER BY distinct_value DESC
      LIMIT 1
) 

UNION ALL

SELECT 'Highest profit'        AS description,
       seller_id,
       profit_value            AS value
FROM (
      SELECT oi."seller_id",
             SUM(oi."price" - oi."freight_value") AS profit_value
      FROM   "olist_orders"      AS o
      JOIN   "olist_order_items" AS oi ON o."order_id" = oi."order_id"
      WHERE  o."order_status" = 'delivered'
      GROUP BY oi."seller_id"
      ORDER BY profit_value DESC
      LIMIT 1
)

UNION ALL

SELECT 'Most distinct orders'  AS description,
       seller_id,
       orders_value            AS value
FROM (
      SELECT oi."seller_id",
             COUNT(DISTINCT oi."order_id") AS orders_value
      FROM   "olist_orders"      AS o
      JOIN   "olist_order_items" AS oi ON o."order_id" = oi."order_id"
      WHERE  o."order_status" = 'delivered'
      GROUP BY oi."seller_id"
      ORDER BY orders_value DESC
      LIMIT 1
)

UNION ALL

SELECT 'Most 5-star reviews'   AS description,
       seller_id,
       reviews_value           AS value
FROM (
      SELECT oi."seller_id",
             COUNT(DISTINCT r."review_id") AS reviews_value
      FROM   "olist_orders"       AS o
      JOIN   "olist_order_items"  AS oi ON o."order_id" = oi."order_id"
      JOIN   "olist_order_reviews" AS r  ON o."order_id" = r."order_id"
      WHERE  o."order_status" = 'delivered'
        AND  r."review_score" = 5
      GROUP BY oi."seller_id"
      ORDER BY reviews_value DESC
      LIMIT 1
);
```

These seven queries (all `SELECT` statements, each limited to 20 rows where appropriate) progressively explore the relevant columns and finally return the seller IDs that lead in:

1. Number of distinct customer unique IDs  
2. Total profit (price − freight)  
3. Number of distinct delivered orders handled  
4. Number of 5-star reviews received
