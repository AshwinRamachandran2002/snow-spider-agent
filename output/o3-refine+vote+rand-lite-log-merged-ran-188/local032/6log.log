```sql
-- 1) Basic check – all orders that were really delivered (id + status)
SELECT DISTINCT "order_id", "order_status"
FROM "olist_orders"
WHERE "order_status" = 'delivered'
LIMIT 20;
```

```sql
-- 2) Delivered order-items (what each seller actually sold)
SELECT DISTINCT oi."order_id", oi."seller_id", oi."price", oi."freight_value"
FROM "olist_order_items" AS oi
JOIN "olist_orders"  AS o
  ON o."order_id" = oi."order_id"
WHERE o."order_status" = 'delivered'
LIMIT 20;
```

```sql
-- 3) Map delivered orders to the customers’ unique ids
SELECT DISTINCT oi."seller_id",
       c."customer_unique_id",
       oi."order_id"
FROM "olist_order_items"            AS oi
JOIN "olist_orders"                 AS o  ON o."order_id"   = oi."order_id"
JOIN "olist_customers"              AS c  ON c."customer_id"= o."customer_id"
WHERE o."order_status" = 'delivered'
LIMIT 20;
```

```sql
-- 4) TOP sellers by distinct customer_unique_id (first 20 rows)
SELECT  oi."seller_id",
        COUNT(DISTINCT c."customer_unique_id") AS "distinct_customers"
FROM "olist_order_items"  AS oi
JOIN "olist_orders"       AS o  ON o."order_id"    = oi."order_id"
JOIN "olist_customers"    AS c  ON c."customer_id" = o."customer_id"
WHERE o."order_status" = 'delivered'
GROUP BY oi."seller_id"
ORDER BY "distinct_customers" DESC
LIMIT 20;
```

```sql
-- 5) TOP sellers by TOTAL PROFIT = Σ(price – freight_value) on delivered orders
SELECT  oi."seller_id",
        SUM(oi."price" - oi."freight_value")  AS "total_profit"
FROM "olist_order_items" AS oi
JOIN "olist_orders"      AS o ON o."order_id" = oi."order_id"
WHERE o."order_status" = 'delivered'
GROUP BY oi."seller_id"
ORDER BY "total_profit" DESC
LIMIT 20;
```

```sql
-- 6) TOP sellers by number of distinct delivered orders
SELECT  oi."seller_id",
        COUNT(DISTINCT oi."order_id") AS "distinct_orders"
FROM "olist_order_items" AS oi
JOIN "olist_orders"      AS o ON o."order_id" = oi."order_id"
WHERE o."order_status" = 'delivered'
GROUP BY oi."seller_id"
ORDER BY "distinct_orders" DESC
LIMIT 20;
```

```sql
-- 7) TOP sellers by count of 5-star reviews on delivered orders
SELECT  oi."seller_id",
        COUNT(*) AS "five_star_reviews"
FROM "olist_order_items"  AS oi
JOIN "olist_order_reviews" AS r ON r."order_id" = oi."order_id"
JOIN "olist_orders"        AS o ON o."order_id" = oi."order_id"
WHERE o."order_status"   = 'delivered'
  AND r."review_score"   = 5
GROUP BY oi."seller_id"
ORDER BY "five_star_reviews" DESC
LIMIT 20;
```

```sql
-- 8) One-shot query: winners for each requested metric, with a label
SELECT 'Most distinct customers' AS "achievement",
       s1."seller_id",
       s1."distinct_customers"   AS "value"
FROM (
      SELECT  oi."seller_id",
              COUNT(DISTINCT c."customer_unique_id") AS "distinct_customers"
      FROM "olist_order_items"  AS oi
      JOIN "olist_orders"       AS o  ON o."order_id"    = oi."order_id"
      JOIN "olist_customers"    AS c  ON c."customer_id" = o."customer_id"
      WHERE o."order_status" = 'delivered'
      GROUP BY oi."seller_id"
      ORDER BY "distinct_customers" DESC
      LIMIT 1
) AS s1

UNION ALL
SELECT 'Highest profit',
       s2."seller_id",
       s2."total_profit"
FROM (
      SELECT  oi."seller_id",
              SUM(oi."price" - oi."freight_value") AS "total_profit"
      FROM "olist_order_items" AS oi
      JOIN "olist_orders"      AS o ON o."order_id" = oi."order_id"
      WHERE o."order_status" = 'delivered'
      GROUP BY oi."seller_id"
      ORDER BY "total_profit" DESC
      LIMIT 1
) AS s2

UNION ALL
SELECT 'Most distinct orders',
       s3."seller_id",
       s3."distinct_orders"
FROM (
      SELECT  oi."seller_id",
              COUNT(DISTINCT oi."order_id") AS "distinct_orders"
      FROM "olist_order_items" AS oi
      JOIN "olist_orders"      AS o ON o."order_id" = oi."order_id"
      WHERE o."order_status" = 'delivered'
      GROUP BY oi."seller_id"
      ORDER BY "distinct_orders" DESC
      LIMIT 1
) AS s3

UNION ALL
SELECT 'Most 5-star reviews',
       s4."seller_id",
       s4."five_star_reviews"
FROM (
      SELECT  oi."seller_id",
              COUNT(*) AS "five_star_reviews"
      FROM "olist_order_items"  AS oi
      JOIN "olist_order_reviews" AS r ON r."order_id" = oi."order_id"
      JOIN "olist_orders"        AS o ON o."order_id" = oi."order_id"
      WHERE o."order_status"   = 'delivered'
        AND r."review_score"   = 5
      GROUP BY oi."seller_id"
      ORDER BY "five_star_reviews" DESC
      LIMIT 1
) AS s4
LIMIT 20;
```
