```sql
--Description: Quick look at the key identifying columns for a handful of Nature-articles
SELECT "id",
       "date",
       "title"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE
LIMIT  20;
```

```sql
--Description: Inspect the range of scientific categories represented in the Nature table
SELECT DISTINCT "category"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE
LIMIT  20;
```

```sql
--Description: Sample the WORD_FREQUENCIES table – word and its corpus frequency
SELECT "word",
       "frequency"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES
LIMIT  20;
```

```sql
--Description: Retrieve the highest-frequency tokens to gauge the frequency scale
SELECT "word",
       "frequency"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES
ORDER  BY "frequency" DESC
LIMIT  20;
```

```sql
--Description: Pull one example GloVe vector (first row in the table)
SELECT "word",
       "vector"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS
LIMIT  1;
```

```sql
--Description: Check that both frequency and vector exist for the specific token “serum”
SELECT wf."word",
       wf."frequency",
       gv."vector"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  wf
JOIN   WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS     gv
       ON wf."word" = gv."word"
WHERE  wf."word" ILIKE 'serum'
LIMIT  20;
```

```sql
--Description: Tokenise the body text of one arbitrary article into individual words (lower-cased, punctuation removed)
SELECT n."id",
       f.value::STRING        AS "word"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
             input => SPLIT(
                             LOWER(
                                   REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' ')
                             ),
                             ' '
                           )
       ) f
LIMIT  20;
```

```sql
--Description: Join the tokenised words of an article with their corpus frequencies
SELECT n."id",
       w."word",
       wf."frequency"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE             n,
       LATERAL FLATTEN(
             input => SPLIT(
                             LOWER(
                                   REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' ')
                             ),
                             ' '
                           )
       ) w,
       WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES   wf
WHERE  w.value::STRING = wf."word"
LIMIT  20;
```

```sql
--Description: Attach the GloVe vector to each token of an article (only tokens for which we have a vector)
SELECT n."id",
       w."word",
       wf."frequency",
       gv."vector"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE             n,
       LATERAL FLATTEN(
             input => SPLIT(
                             LOWER(
                                   REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' ')
                             ),
                             ' '
                           )
       ) w
JOIN   WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES   wf
       ON w.value::STRING = wf."word"
JOIN   WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS      gv
       ON w.value::STRING = gv."word"
LIMIT  20;
```

```sql
--Description: Illustrative computation – weight each word’s vector by 1 / power(frequency, 0.4) for a single article and show the first few weighted vectors (vector math kept as VARIANT for inspection)
SELECT n."id",
       w."word",
       gv."vector"                                           AS original_vec,
       POWER(wf."frequency", 0.4)                            AS freq_pow_04,
       ARRAY_TRANSFORM(gv."vector", v -> v / POWER(wf."frequency", 0.4))  AS weighted_vec
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE             n,
       LATERAL FLATTEN(
             input => SPLIT(
                             LOWER(
                                   REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' ')
                             ),
                             ' '
                           )
       ) w
JOIN   WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES   wf
       ON w.value::STRING = wf."word"
JOIN   WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS      gv
       ON w.value::STRING = gv."word"
LIMIT  20;
```
