--Description: 
-- Create a small sample of Nature-article tokens, attach their corpus frequency and GloVe
-- vector, then compute a weighted vector for each token where each component is divided
-- by frequency^0.4.  A CTE (token_vectors) is used so that the column aliases (“freq”,
-- “vec”) are clearly in scope when we perform the weighting; this avoids the identifier
-- error seen previously.

WITH token_vectors AS (
    SELECT n."id",
           w.value::STRING                               AS "word",
           wf."frequency"                                AS "freq",
           gv."vector"                                   AS "vec"
    FROM   WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n
         , LATERAL FLATTEN(
               input => SPLIT(
                                 LOWER(
                                       REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' ')
                                 ),
                                 ' '
                              )
           ) w
    JOIN   WORD_VECTORS_US.WORD_VECTORS_US."WORD_FREQUENCIES" wf
           ON w.value::STRING = wf."word"
    JOIN   WORD_VECTORS_US.WORD_VECTORS_US."GLOVE_VECTORS"    gv
           ON w.value::STRING = gv."word"
    LIMIT 20
)
SELECT "id",
       "word",
       "vec"                                                   AS original_vec,
       POWER("freq", 0.4)                                      AS freq_pow_04,
       ARRAY_TRANSFORM("vec", v -> v / POWER("freq", 0.4))     AS weighted_vec
FROM   token_vectors;
