WITH "stop_words"(word) AS (         -- basic list of stop-words to discard
    SELECT * FROM VALUES
        ('the'),('of'),('and'),('in'),('to'),('a'),('is'),('was'),('were'),
        ('with'),('for'),('on'),('that'),('by'),('an'),('as'),('at'),
        ('from'),('it'),('this'),('be'),('are'),('or'),('which'),('we'),
        ('has'),('had'),('have'),('but'),('not'),('can'),('also'),('than'),
        ('these'),('those'),('their'),('its'),('into'),('may'),('such'),
        ('other'),('more'),('less'),('been'),('our'),('using'),('use'),
        ('used'),('over'),('between'),('both'),('all')
),

/* ------------------------------------------------------------
   Tokenise each article, keep tokens that have a frequency entry
   and a GloVe vector, and are NOT stop-words
------------------------------------------------------------ */
"word_instances" AS (
    SELECT
        n."id",
        n."date",
        n."title",
        gv."vector"                    AS glove_vector,
        wf."frequency"                 AS freq
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE              n
         , LATERAL FLATTEN(
               INPUT => SPLIT(
                           REGEXP_REPLACE(LOWER(n."body"), '[^a-z ]', ' '),
                           ' '
                        )
           )                                                  tok
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES    wf
         ON tok.value::STRING = wf."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS       gv
         ON tok.value::STRING = gv."word"
    WHERE tok.value::STRING NOT IN (SELECT word FROM "stop_words")
),

/* ------------------------------------------------------------
   Decompose each GloVe vector, apply the frequency weight,
   and sum per article/component
------------------------------------------------------------ */
"component_sums" AS (
    SELECT
        w."id",
        w."date",
        w."title",
        v.index                                           AS idx,
        SUM( (v.value::FLOAT) / POWER(w.freq, 0.4) )      AS comp_sum
    FROM "word_instances"     w
         , LATERAL FLATTEN(INPUT => w.glove_vector)  v
    GROUP BY w."id", w."date", w."title", v.index
),

/* magnitude of each (unnormalised) article vector */
"magnitudes" AS (
    SELECT
        "id",
        SQRT(SUM(comp_sum * comp_sum)) AS mag
    FROM "component_sums"
    GROUP BY "id"
),

/* ------------------------------------------------------------
   Normalise every component by the article’s vector magnitude
------------------------------------------------------------ */
"normalized_components" AS (
    SELECT
        c."id",
        c."date",
        c."title",
        c.idx,
        c.comp_sum / m.mag            AS comp_norm
    FROM "component_sums"  c
         JOIN "magnitudes" m
           ON c."id" = m."id"
    WHERE m.mag > 0                          -- avoid divide-by-zero
),

/* ------------------------------------------------------------
   Re-assemble the full article vector (as a VARIANT array)
------------------------------------------------------------ */
"article_vectors" AS (
    SELECT
        "id",
        "date",
        "title",
        ARRAY_AGG(comp_norm ORDER BY idx)    AS article_vector
    FROM "normalized_components"
    GROUP BY "id", "date", "title"
)

/* -------------------- final output ------------------------- */
SELECT
    "id",
    "date",
    "title",
    article_vector
FROM "article_vectors";
```
