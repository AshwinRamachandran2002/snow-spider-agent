```sql
--Description: 
-- We want: article id + each body-token + its corpus frequency.
-- Key points in the fix:
--   • Token column comes from the FLATTEN output => w.value
--   • Cast w.value to STRING for joining
--   • Join to WORD_FREQUENCIES on that token
--   • Use LIMIT 20 for a quick preview

SELECT n."id",
       w.value::STRING AS "word",
       wf."frequency"
FROM   WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n,
       LATERAL FLATTEN(
              input => SPLIT(
                               LOWER(
                                     REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' ')
                               ),
                               ' '
                             )
       ) w
JOIN   WORD_VECTORS_US.WORD_VECTORS_US."WORD_FREQUENCIES" wf
       ON w.value::STRING = wf."word"
LIMIT  20;
```
