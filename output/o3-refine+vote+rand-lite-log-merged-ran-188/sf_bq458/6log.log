```sql
--Description: 
-- 1. Tokenise Nature-article text: remove punctuation, lower-case, split on space, FLATTEN.
-- 2. Join each token to WORD_FREQUENCIES for its corpus count (freq) and to GLOVE_VECTORS
--    for the 300-D embedding (vec).
-- 3. Use a CTE (token_vectors) so the aliases id, word, freq, vec are defined before the
--    outer query does the weighting; this prevents “invalid identifier” errors.
-- 4. In the final SELECT compute freq_pow_04 = freq^0.4 and create the weighted_vec by
--    dividing each component of vec by freq_pow_04 with ARRAY_TRANSFORM.
-- 5. LIMIT 20 inside the CTE to keep the demonstration small.

WITH token_vectors AS (
    SELECT n."id"                                            AS id,
           w.value::STRING                                   AS word,
           wf."frequency"                                    AS freq,
           gv."vector"                                       AS vec
    FROM  WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n
        , LATERAL FLATTEN(
              input => SPLIT(
                               LOWER(
                                     REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' ')
                               ),
                               ' '
                            )
          ) w
    JOIN WORD_VECTORS_US.WORD_VECTORS_US."WORD_FREQUENCIES"  wf
         ON w.value::STRING = wf."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US."GLOVE_VECTORS"     gv
         ON w.value::STRING = gv."word"
    LIMIT 20
)
SELECT id,
       word,
       vec                                                    AS original_vec,
       POWER(freq, 0.4)                                       AS freq_pow_04,
       ARRAY_TRANSFORM(vec, v -> v / POWER(freq, 0.4))        AS weighted_vec
FROM   token_vectors;
```
