WHERE t."title" ILIKE '%polyamines%'
LIMIT 20;
```

```sql
--Description: Join tokens with their frequency & glove vector (for one article) – foundation for later weighting
SELECT 
  tok."id",
  tok."token",
  wf."frequency",
  gv."vector"
FROM (
        SELECT 
          t."id",
          LOWER(TRIM(tokens.value::STRING)) AS "token"
        FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" t,
             LATERAL SPLIT_TO_TABLE(REGEXP_REPLACE(LOWER(t."body"), '[^a-z0-9 ]', ' '), ' ') tokens
        WHERE t."title" ILIKE '%polyamines%'
     ) tok
LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
       ON tok."token" = wf."word"
LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
       ON tok."token" = gv."word"
LIMIT 20;
```
