```sql
--Description: Compute the frequency-weighted GloVe vector for each token that appears
--in the body of the very first NATURE article (MIN(id)).  We tokenise, drop a few
--stop-words, join to WORD_FREQUENCIES and GLOVE_VECTORS, then divide every vector
--component by frequency^0.4.  Inside ARRAY_TRANSFORM the frequency column is
--referenced as wf.frequency (unquoted) because quoting a dotted name caused
--“invalid identifier” in earlier attempts.
SELECT
  tok."token",
  ARRAY_TRANSFORM(
      gv."vector",
      x -> x / POWER(wf.frequency, 0.4)          -- weighting step
  ) AS "weighted_vector"
FROM (
  /* Tokenise body text of the article with the smallest id and remove stop-words */
