/* ------------------------------------------------------------
   For every Nature article:
   1. Tokenise body, drop simple stop-words.
   2. Keep tokens that have BOTH a GloVe vector and a corpus-frequency.
   3. For each token component:  value / frequency^0.4   (weighting)
   4. Sum the weighted components → article vector.
   5. Normalise the vector to unit length.
   6. Return article id, date, title, normalised vector.
-------------------------------------------------------------*/
WITH TOKENS AS (
    SELECT
        n."id",
        n."date",
        n."title",
        tok.value::STRING            AS "token"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE  n ,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                         LOWER(
                             REGEXP_REPLACE(n."body", '[^a-zA-Z ]', '')
                         ),
                         ' '
                     )
         ) tok
    WHERE tok.value::STRING NOT IN
          ('the','and','of','to','in','a','for','is','on','with')          -- simple stop-word list
),
TOKENS_WITH_VECTORS AS (
    SELECT
        t."id",
        t."date",
        t."title",
        gv."vector"                  AS "vec",
        wf."frequency"               AS "freq"
    FROM TOKENS t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS     gv
          ON t."token" = gv."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  wf
          ON t."token" = wf."word"
),
WEIGHTED_COMPONENTS AS (           -- explode each word-vector, apply weighting
    SELECT
        twv."id",
        twv."date",
        twv."title",
        comp.index                  AS "idx",                  -- component position
        SUM( comp.value::FLOAT / POWER(twv."freq", 0.4) )      AS "comp_sum"
    FROM TOKENS_WITH_VECTORS twv,
         LATERAL FLATTEN(INPUT => twv."vec") comp
    GROUP BY twv."id", twv."date", twv."title", comp.index
),
ARTICLE_VECTORS AS (               -- gather components per article & get magnitude
    SELECT
        "id",
        "date",
        "title",
        ARRAY_AGG("comp_sum" ORDER BY "idx")              AS "raw_vec",
        SQRT(SUM(POWER("comp_sum", 2)))                   AS "mag"
    FROM WEIGHTED_COMPONENTS
    GROUP BY "id", "date", "title"
)
SELECT
    "id",
    "date",
    "title",
    ARRAY_TRANSFORM(
        "raw_vec",
        x -> x / "mag"                                    -- normalise to unit length
    )                AS "normalized_article_vector"
FROM ARTICLE_VECTORS
WHERE "mag" <> 0;                                         -- exclude empty articles
```
