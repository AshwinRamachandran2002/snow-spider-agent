--Description: Build and normalise a vector that represents the entire article with
--the smallest id in WORD_VECTORS_US.WORD_VECTORS_US.NATURE.  
--Pipeline inside one statement:
-- 1) Tokenise the article’s body (lower-case, strip non-letters, split on spaces).
-- 2) Remove a few common stop-words and empty strings.
-- 3) Join tokens to WORD_FREQUENCIES (to fetch the column  frequency ) and to
--    GLOVE_VECTORS (to fetch the 300-D GloVe vector).
-- 4) Weight every vector component by dividing by  frequency^0.4 .
--    NOTE: inside ARRAY_TRANSFORM the lambda references  frequency  directly
--    (no table alias) because Snowflake lambdas cannot resolve dotted names —
--    this eliminates the “invalid identifier” errors seen earlier.
-- 5) Aggregate all weighted token vectors element-wise with ARRAY_SUM to obtain
--    vec_sum, also sum the squares (vec_sq_sum) to compute magnitudes.
-- 6) Normalise: divide each element of vec_sum by √(vec_sq_sum[idx]).
-- 7) Return article id, date, title, and its normalised 300-D vector.
SELECT
    art.id,
    art.date,
    art.title,
    ARRAY_TRANSFORM(
        calc.vec_sum,
        (v, idx) -> v / SQRT(calc.vec_sq_sum[idx])
    ) AS normalised_article_vector
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE AS art
/* --------------------------------------------------------------------------- */
JOIN LATERAL (        -- build vec_sum and vec_sq_sum for this article
    SELECT
        ARRAY_SUM(token_vecs)                                         AS vec_sum,
        ARRAY_SUM(
            ARRAY_TRANSFORM(token_vecs, (v, i) -> v * v)
        )                                                             AS vec_sq_sum
    FROM (
        /* -------- create a weighted vector for every token in the article ---- */
        SELECT
            ARRAY_TRANSFORM(
                gv.vector,
                x -> x / POWER(frequency, 0.4)        -- weighting step
            ) AS w_vec
        FROM LATERAL FLATTEN(
                 input => SPLIT(
                     LOWER(REGEXP_REPLACE(art.body, '[^a-zA-Z ]', '')),
                     ' ')
             ) word
        JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
          ON word.value::STRING = wf.word
        JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
          ON word.value::STRING = gv.word
        WHERE word.value::STRING NOT IN
              ('the','and','of','to','in','a','for','is','on','with')
          AND LENGTH(word.value::STRING) > 0
    ) token_table,
    LATERAL (SELECT ARRAY_AGG(w_vec) AS token_vecs) agg               -- collect vectors
) AS calc
/* --------------------------------------------------------------------------- */
WHERE art.id = (SELECT MIN(id) FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE)
LIMIT 20;
