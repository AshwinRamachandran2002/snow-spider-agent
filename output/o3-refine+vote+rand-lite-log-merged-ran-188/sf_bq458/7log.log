--Description: Construct a unit-length (normalised) 300-dimensional vector that
--represents the NATURE article whose id is the smallest in the table.
--Pipeline inside one query:
-- 1) article   : pick that article.
-- 2) tokens    : tokenise its body (lower-case, strip non-letters, split on spaces),
--                drop a few stop-words and empty strings.
-- 3) weighted  : join every token to WORD_FREQUENCIES and GLOVE_VECTORS, then
--                build a frequency-weighted GloVe vector
--                       weight_vec = glove_vec / frequency^0.4
--                The lambda inside ARRAY_TRANSFORM refers to column name
--                frequency directly—Snowflake lambdas cannot use dotted aliases.
-- 4) vec_sum   : element-wise sum of all weighted vectors.
-- 5) magnitude : compute √(Σ component²) of vec_sum (via FLATTEN).
-- 6) Final SELECT normalises vec_sum by this magnitude and returns id, date, title,
--    and the unit-length article vector (LIMIT 20 for safety).
WITH article AS (
    SELECT id, date, title, body
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
    ORDER BY id
    LIMIT 1
),
tokens AS (
    SELECT word.value::STRING AS token
    FROM article a,
         LATERAL FLATTEN(
             input => SPLIT(
                 LOWER(REGEXP_REPLACE(a.body, '[^a-zA-Z ]', '')),
                 ' ')
         ) word
    WHERE word.value::STRING NOT IN
          ('the','and','of','to','in','a','for','is','on','with')
      AND LENGTH(word.value::STRING) > 0
),
weighted AS (
    SELECT ARRAY_TRANSFORM(
               gv.vector,
               x -> x / POWER(wf.frequency, 0.4)         -- weighting step
           ) AS w_vec
    FROM tokens t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
      ON t.token = wf.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
      ON t.token = gv.word
),
vec_sum AS (
    SELECT ARRAY_SUM(ARRAY_AGG(w_vec)) AS v_sum
    FROM weighted
),
magnitude AS (
    SELECT SQRT(SUM(POWER(f.value::FLOAT, 2))) AS mag
    FROM vec_sum vs,
         LATERAL FLATTEN(input => vs.v_sum) f
)
SELECT
    a.id,
    a.date,
    a.title,
    ARRAY_TRANSFORM(
        vs.v_sum,
        comp -> comp / m.mag                         -- normalise
    ) AS normalised_article_vector
FROM article a
JOIN vec_sum   vs ON TRUE
JOIN magnitude m  ON TRUE
LIMIT 20;
```
