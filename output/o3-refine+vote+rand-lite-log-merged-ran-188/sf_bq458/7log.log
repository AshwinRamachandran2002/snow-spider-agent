--Description (thinking process embedded):
-- We need to recompute the weighted GloVe vectors for tokens in one article, fixing
-- the previous scope issue (lambda could not access wf."frequency").
-- Approach:
-- 1) Tokenise the body text of the first article (MIN(id)) after lower-casing and
--    removing non-letters.  Split on spaces and filter out a few common stop words.
-- 2) Join each token to WORD_FREQUENCIES to obtain its corpus frequency and to
--    GLOVE_VECTORS to get the 300-dimensional vector.
-- 3) Weight each vector component by dividing by frequency^0.4.
--      The lambda used inside ARRAY_TRANSFORM can only reference columns in
--      its scope, so we expose wf."frequency" as a scalar alias (freq) via a
--      LATERAL sub-select, then use that alias inside the lambda.
-- 4) Return the token and its weighted vector, limited to the first 20 rows.
SELECT
    tok."token",
    ARRAY_TRANSFORM(
        gv."vector",
        (x, idx) -> x / POWER(freq, 0.4)   -- weight each component
    ) AS "weighted_vector"
FROM (
    /* Step 1: tokenise body of the lexicographically first article */
    SELECT word.value::STRING AS "token"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             input => SPLIT(
                 LOWER(REGEXP_REPLACE(n."body", '[^a-zA-Z ]', '')),
                 ' ')
         ) word
    WHERE n."id" = (SELECT MIN("id") FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE)
      AND word.value::STRING NOT IN ('the','and','of','to','in','a','for','is','on','with')
) tok
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON tok."token" = wf."word"
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON tok."token" = gv."word"
, LATERAL (SELECT wf."frequency" AS freq) f   -- expose frequency to lambda
LIMIT 20;
