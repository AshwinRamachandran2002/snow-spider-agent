```sql
/* -------- Build unit-length vectors for all Nature articles ------------- */
WITH TOKENS AS (                         -- 1) tokenize & remove simple stop-words
    SELECT
        n."id"      AS id,
        n."date"    AS article_date,
        n."title"   AS title,
        tok.value::STRING AS token
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                         LOWER( REGEXP_REPLACE(n."body", '[^a-zA-Z ]', '') ),
                         ' '
                     )
         ) tok
    WHERE tok.value::STRING NOT IN
          ('the','and','of','to','in','a','for','is','on','with')
),
TOKENS_WITH_VECTORS AS (                 -- 2) keep tokens that have both GloVe vector & frequency
    SELECT
        t.id,
        t.article_date,
        t.title,
        gv."vector"     AS vec,
        wf."frequency"  AS freq
    FROM TOKENS t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS     gv
          ON t.token = gv."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  wf
          ON t.token = wf."word"
),
WEIGHTED_COMPONENTS AS (                 -- 3) explode vector & apply weighting
    SELECT
        twv.id,
        twv.article_date,
        twv.title,
        comp.index                       AS idx,
        SUM( comp.value::FLOAT / POWER(twv.freq, 0.4) )   AS comp_sum
    FROM TOKENS_WITH_VECTORS twv,
         LATERAL FLATTEN( INPUT => twv.vec ) comp
    GROUP BY twv.id, twv.article_date, twv.title, comp.index
),
ARTICLE_VECTORS AS (                     -- 4) assemble full article vector
    SELECT
        id,
        article_date,
        title,
        ARRAY_AGG(comp_sum) WITHIN GROUP (ORDER BY idx)   AS raw_vec,
        SQRT( SUM( POWER(comp_sum, 2) ) )                 AS mag
    FROM WEIGHTED_COMPONENTS
    GROUP BY id, article_date, title
)
SELECT                                    -- 5) normalise to unit length & output
    id,
    article_date AS "date",
    title,
    ARRAY_TRANSFORM(raw_vec, x -> x / mag) AS normalized_article_vector
FROM ARTICLE_VECTORS
WHERE mag <> 0;
