```sql
--Description: 8) For one article: join tokens to frequency and GloVe tables, keep those that exist in both.
SELECT
  tok."token",
  wf."frequency",
  gv."vector"
FROM (
  SELECT word.value::STRING AS "token"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(input => SPLIT(LOWER(REGEXP_REPLACE(n."body", '[^a-zA-Z ]', '')), ' ')) word
  WHERE n."id" = (SELECT MIN("id") FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE)
    AND word.value::STRING NOT IN ('the','and','of','to','in','a','for','is','on','with')
) tok
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON tok."token" = wf."word"
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON tok."token" = gv."word"
LIMIT 20;
```

```sql
--Description: 9) Compute the weighted GloVe vector for each token of one article
--   (divide every component by frequency^0.4).  Shows first 20 weighted vectors.
SELECT
  tok."token",
  ARRAY_TRANSFORM(gv."vector", (x, idx) -> x / POWER(wf."frequency", 0.4)) AS "weighted_vector"
FROM (
  SELECT word.value::STRING AS "token"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(input => SPLIT(LOWER(REGEXP_REPLACE(n."body", '[^a-zA-Z ]', '')), ' ')) word
  WHERE n."id" = (SELECT MIN("id") FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE)
    AND word.value::STRING NOT IN ('the','and','of','to','in','a','for','is','on','with')
) tok
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON tok."token" = wf."word"
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON tok."token" = gv."word"
LIMIT 20;
```

```sql
--Description: 10) Sum the weighted vectors to create an (unnormalised) article vector
--    and then normalise it to unit length for the same article.
SELECT
  art."id",
  art."date",
  art."title",
  ARRAY_TRANSFORM(
        ARRAY_SUM(agg.weighted_vectors),   -- numerator
        (v, idx) -> v / SQRT(ARRAY_SUM(agg.weighted_vectors_squared)[idx])  -- divide by magnitude
  ) AS "normalised_article_vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE art
JOIN LATERAL (
     SELECT
       ARRAY_SUM(collected) AS weighted_vectors,
       ARRAY_SUM(ARRAY_TRANSFORM(collected, (v, idx) -> v * v)) AS weighted_vectors_squared
     FROM (
         SELECT 
           ARRAY_TRANSFORM(gv."vector", (x, idx) -> x / POWER(wf."frequency", 0.4)) AS vec
         FROM LATERAL FLATTEN(input => SPLIT(LOWER(REGEXP_REPLACE(art."body", '[^a-zA-Z ]', '')), ' ')) word
         JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
           ON word.value::STRING = wf."word"
         JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
           ON word.value::STRING = gv."word"
       ) vtbl,
       LATERAL (SELECT ARRAY_AGG(vec) AS collected) c
) agg
WHERE art."id" = (SELECT MIN("id") FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE)
LIMIT 20;
```

