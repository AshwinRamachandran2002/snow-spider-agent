--Description: Build a single, unit-length vector that represents the NATURE article
--with the smallest id.  Fixes earlier “invalid identifier” errors by:
--  • computing the weighted vector in a scope where gv.vector and wf.frequency
--    are directly visible to the ARRAY_TRANSFORM lambda,
--  • keeping all lambda expressions inside the same SELECT block that defines
--    those columns, so no dotted identifiers are referenced inside the lambda.
WITH
article AS (       -- the target article
    SELECT id, date, title, body
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
    ORDER BY id
    LIMIT 1
),
tokens AS (        -- tokenise & basic stop-word filter
    SELECT word.value::STRING AS token
    FROM article a,
         LATERAL FLATTEN(
             input => SPLIT(
                 LOWER(REGEXP_REPLACE(a.body, '[^a-zA-Z ]', '')),
                 ' ')
         ) word
    WHERE word.value::STRING NOT IN ('the','and','of','to','in','a','for',
                                     'is','on','with')
      AND LENGTH(word.value::STRING) > 0
),
weighted AS (      -- join to freq & GloVe and create weighted vectors
    SELECT
        ARRAY_TRANSFORM(
            gv.vector,
            x -> x / POWER(wf.frequency, 0.4)   -- frequency-based weighting
        ) AS w_vec
    FROM tokens t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
      ON t.token = wf.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
      ON t.token = gv.word
),
vec_sum AS (       -- element-wise sum of all weighted vectors
    SELECT ARRAY_SUM(ARRAY_AGG(w_vec)) AS v_sum
    FROM weighted
),
magnitude AS (     -- √(Σ component²) for v_sum
    SELECT SQRT(SUM(POWER(comp.value::FLOAT, 2))) AS mag
    FROM vec_sum vs,
         LATERAL FLATTEN(input => vs.v_sum) comp
)
SELECT
    a.id,
    a.date,
    a.title,
    ARRAY_TRANSFORM(
        vs.v_sum,
        comp -> comp / m.mag                -- normalise to unit length
    ) AS normalised_article_vector
FROM article   a
JOIN vec_sum   vs ON TRUE
JOIN magnitude m  ON TRUE
LIMIT 20;
```
