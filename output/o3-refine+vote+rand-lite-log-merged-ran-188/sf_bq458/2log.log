```sql
/* --------------------------------------------------------------
   Build a unit-length (normalized) vector for every Nature article
   --------------------------------------------------------------*/
WITH
/* 1) minimal stop–word list */
STOP_WORDS(word) AS (
    VALUES
        ('the'),('of'),('and'),('in'),('to'),('a'),('with'),('for'),('is'),('on'),
        ('that'),('was'),('were'),('as'),('by'),('from'),('at'),('this'),('an'),
        ('be'),('are'),('or'),('which'),('it'),('we'),('has'),('have'),('had'),
        ('not'),('but'),('can'),('its'),('his'),('her'),('their'),('they')
),

/* 2) clean body text → lower-case alpha words only */
ARTICLE_TOKENS AS (
    SELECT  n."id",
            n."date",
            n."title",
            LOWER( REGEXP_REPLACE(n."body",'[^A-Za-z]+',' ') )  AS clean_body
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n
),

/* 3) explode into individual tokens, dropping stop-words & empties */
WORDS_PER_ARTICLE AS (
    SELECT  at."id",
            at."date",
            at."title",
            TRIM(tok)  AS word
    FROM    ARTICLE_TOKENS at,
            LATERAL SPLIT_TO_TABLE(at.clean_body,' ') t(tok)
    WHERE   tok <> ''
      AND   tok NOT IN (SELECT word FROM STOP_WORDS)
),

/* 4) join frequency + GloVe vector for every kept word           */
WORD_VECTORS AS (
    SELECT  wpa."id",
            wpa."date",
            wpa."title",
            wf."frequency",
            gv."vector"
    FROM    WORDS_PER_ARTICLE wpa
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
           ON wf."word" = wpa.word
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"  gv
           ON gv."word" = wpa.word
),

/* 5) weight each vector component by  frequency^(-0.4)            */
WEIGHTED_COMPONENTS AS (
    SELECT  wv."id",
            wv."date",
            wv."title",
            f.index        AS idx,
            (f.value::FLOAT) / POWER(wv."frequency",0.4) AS comp_val
    FROM    WORD_VECTORS wv,
            LATERAL FLATTEN(input=>wv."vector") f
),

/* 6) sum weighted components per article                         */
SUM_COMPONENTS AS (
    SELECT  "id","date","title", idx,
            SUM(comp_val)          AS sum_val
    FROM    WEIGHTED_COMPONENTS
    GROUP BY "id","date","title", idx
),

/* 7) collect summed components into an array & compute magnitude */
ARTICLE_VECTORS AS (
    SELECT  "id","date","title",
            ARRAY_AGG(sum_val ORDER BY idx)      AS vec,
            SQRT( SUM(sum_val*sum_val) )         AS mag
    FROM    SUM_COMPONENTS
    GROUP BY "id","date","title"
),

/* 8) normalise to unit length                                    */
NORMALISED AS (
    SELECT  "id","date","title",
            ARRAY_TRANSFORM(vec, v -> v / NULLIF(mag,0)) AS article_vector
    FROM    ARTICLE_VECTORS
)

SELECT  "id",
        "date",
        "title",
        article_vector     -- unit-length vector
FROM    NORMALISED;
```
