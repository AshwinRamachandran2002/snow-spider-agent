```sql
--Description:  
-- Produce the fully normalised (unit-length) article vector for one Nature paper.  
-- Logical steps captured in this single query:  
--   1) Tokenise the article’s “body” (letters-only, split by space) via CROSS JOIN LATERAL FLATTEN.  
--   2) For every token, look up its corpus frequency and 300-D GloVe vector.  
--   3) Weight each vector component by 1 / frequency^0.4.  
--   4) Sum the weighted values per dimension (0‒299).  
--   5) Compute the Euclidean norm (square-root of sum-of-squares).  
--   6) Divide each dimension’s sum by that norm to obtain a unit vector.  
--   7) Return one row: id, date, title, and the 300-component normalised vector (ordered ARRAY).  
WITH token_weights AS (          -- steps 1-3
    SELECT
        n."id",
        n."date",
        n."title",
        gv_comp.index                                    AS dim_idx,
        gv_comp.value::FLOAT / POW(wf."frequency", 0.4)  AS weighted_val
    FROM  "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n
    CROSS JOIN LATERAL FLATTEN(
               input => SPLIT(REGEXP_REPLACE(n."body", '[^A-Za-z]', ' '), ' ')
         ) tok
    JOIN  "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
          ON LOWER(tok.value::STRING) = wf."word"
    JOIN  "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
          ON wf."word" = gv."word"
    CROSS JOIN LATERAL FLATTEN(input => gv."vector") gv_comp
    WHERE n."id" = 'b8f29c08-2530-4ff1-bd49-da1f483b73ed'
      AND tok.value IS NOT NULL
      AND tok.value <> ''
),
dim_sums AS (                     -- step 4
    SELECT dim_idx,
           SUM(weighted_val) AS dim_val
    FROM   token_weights
    GROUP  BY dim_idx
),
magnitude AS (                    -- step 5
    SELECT SQRT(SUM(POWER(dim_val, 2))) AS mag
    FROM   dim_sums
)
SELECT
    (SELECT DISTINCT "id"    FROM token_weights)               AS "id",
    (SELECT DISTINCT "date"  FROM token_weights)               AS "date",
    (SELECT DISTINCT "title" FROM token_weights)               AS "title",
    (SELECT ARRAY_AGG(dim_val / mag ORDER BY dim_idx)
       FROM dim_sums, magnitude)                              AS "article_vector_normalised";
