--Description:  
-- End-to-end construction of a unit-length, weighted GloVe article vector for one Nature paper.  
-- Thinking steps encoded directly in the query:  
--   1️⃣ Tokenise the body text (letters-only → split by space) with CROSS JOIN LATERAL FLATTEN.  
--   2️⃣ Join each token to its corpus frequency and 300-D GloVe embedding.  
--   3️⃣ Weight every vector component by 1 / frequency^0.4.  
--   4️⃣ Sum the weighted components for each of the 300 dimensions.  
--   5️⃣ Compute the vector’s Euclidean norm and divide every dimension by that norm.  
--   6️⃣ Return one row containing the article’s id, date, title and the ordered 300-component
--      normalised vector (ARRAY).  
WITH token_weights AS (  -- 1️⃣-3️⃣  explode tokens & components, apply weighting
    SELECT
        n."id",
        n."date",
        n."title",
        gv_comp.index                                    AS dim_idx,          -- 0‒299
        gv_comp.value::FLOAT /
        POW(wf."frequency", 0.4)                        AS weighted_val
