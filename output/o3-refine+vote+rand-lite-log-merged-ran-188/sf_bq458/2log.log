```sql
--Description:  
-- Assess how many distinct tokens in a chosen Nature article have matching GloVe embeddings.  
-- Steps embodied here:  
--   1) Select the article by its id.  
--   2) Clean its “body” (letters-only), split on spaces, flatten to get tokens.  
--   3) Keep lower-case, non-empty tokens and de-duplicate them.  
--   4) LEFT JOIN to GLOVE_VECTORS to see which tokens carry an embedding.  
--   5) Return a one-row summary: total distinct tokens, how many have vectors, and how many do not.  
WITH tokenised AS (
    SELECT LOWER(tok.value::STRING) AS token
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n
    CROSS JOIN LATERAL FLATTEN(
        input => SPLIT(
                  REGEXP_REPLACE(n."body", '[^A-Za-z]', ' '),
                  ' '
                )
    ) tok
    WHERE n."id" = 'b8f29c08-2530-4ff1-bd49-da1f483b73ed'
      AND tok.value IS NOT NULL
      AND tok.value <> ''
), distinct_tokens AS (
    SELECT DISTINCT token FROM tokenised
)
SELECT COUNT(*)                                                       AS total_distinct_tokens,
       COUNT(gv."word")                                               AS tokens_with_glove_vector,
       COUNT(*) - COUNT(gv."word")                                    AS tokens_without_vector
FROM   distinct_tokens dt
LEFT  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
       ON dt.token = gv."word";
```
