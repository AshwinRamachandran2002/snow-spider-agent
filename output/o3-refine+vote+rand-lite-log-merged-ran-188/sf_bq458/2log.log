```sql
--Description: Join WORD_FREQUENCIES and GLOVE_VECTORS to show frequency & vector for words beginning with ‘bio%’  
SELECT wf."word",
       wf."frequency",
       gv."vector"
FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"     gv
       ON wf."word" = gv."word"
WHERE  wf."word" ILIKE 'bio%'
LIMIT 20;
```

```sql
--Description: Tokenise the body of a single article (by id) into lower-case words and view distinct tokens  
SELECT DISTINCT LOWER(token.value::STRING) AS "token"
FROM  "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
      LATERAL FLATTEN(
             input => SPLIT(REGEXP_REPLACE(n."body", '[^A-Za-z]', ' '), ' ')
      ) token
WHERE n."id" = 'some_article_id'            -- replace with an actual id
  AND token.value IS NOT NULL
LIMIT 50;
```

```sql
--Description: Example of computing a weighted, summed vector for one article (core idea of final task)  
SELECT n."id",
       n."date",
       n."title",
       NORMALIZE(ARRAY_AGG(
           gv_comp.value::FLOAT /
           POW(wf."frequency", 0.4)
       )) AS "article_vector"
FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"           n,
     LATERAL FLATTEN(
         input => SPLIT(REGEXP_REPLACE(n."body", '[^A-Za-z]', ' '), ' ')
     ) tokens
     JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
       ON LOWER(tokens.value::STRING) = wf."word"
     JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
       ON wf."word" = gv."word"
     , LATERAL FLATTEN(input => gv."vector") gv_comp
WHERE n."id" = 'some_article_id'            -- replace with an actual id
GROUP BY n."id", n."date", n."title"
LIMIT 20;
```

