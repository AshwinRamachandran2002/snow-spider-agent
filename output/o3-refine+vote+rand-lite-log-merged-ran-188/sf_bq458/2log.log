```sql
--Description:  
-- Corrected version of the “weighted-sum article vector” example without any ON-clause
-- LATERAL joins (uses CROSS JOIN LATERAL everywhere).  
-- 1) Choose a real article id (b8f29c08-2530-4ff1-bd49-da1f483b73ed).  
-- 2) Tokenise its body (letters only → split on spaces).  
-- 3) Join each token to WORD_FREQUENCIES and GLOVE_VECTORS.  
-- 4) FLATTEN every 300-dim GloVe vector; weight each component by 1/freq^0.4.  
-- 5) Sum the weighted components per dimension, re-assemble as an ordered array.  
WITH token_weights AS (                               -- token, freq, each vector component → weighted component
    SELECT n."id",
           n."date",
           n."title",
           gv_comp.index                         AS dim_idx,                    -- 0 … 299
           gv_comp.value::FLOAT / POW(wf."frequency", 0.4) AS weighted_val
    FROM  "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n
    CROSS JOIN LATERAL FLATTEN(                                                 -- tokenise
                 input => SPLIT(
                           REGEXP_REPLACE(n."body", '[^A-Za-z]', ' '),
                           ' '
                         )
         ) tok
    JOIN  "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf             -- freq lookup
          ON LOWER(tok.value::STRING) = wf."word"
    JOIN  "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv                -- vector lookup
          ON wf."word" = gv."word"
    CROSS JOIN LATERAL FLATTEN(input => gv."vector") gv_comp                    -- explode 300 dims
    WHERE n."id" = 'b8f29c08-2530-4ff1-bd49-da1f483b73ed'
      AND tok.value IS NOT NULL
      AND tok.value <> ''
)
SELECT tw."id",
       tw."date",
       tw."title",
       ARRAY_AGG(SUM(tw.weighted_val) ORDER BY tw.dim_idx) AS "article_vector"  -- summed (not yet normalised)
FROM   token_weights tw
GROUP  BY tw."id", tw."date", tw."title"
LIMIT 1;
```
