```sql
--Description:  
-- Single-step demonstration of the full reasoning pathway for one Nature article.  
-- 1) Pick an existing article id.  
-- 2) Clean “body” → keep letters only, split on spaces → tokens.  
-- 3) Convert to lower-case and remove empty tokens.  
-- 4) Join every distinct token to WORD_FREQUENCIES for its corpus count.  
-- 5) Join to GLOVE_VECTORS to see if a vector exists.  
-- 6) Show each token, its frequency, the weighting factor (1 / freq^0.4) and the first 5
--    numeric components of its GloVe embedding (as proof of concept).  
WITH tokenized AS (                                                          -- step 2
    SELECT LOWER(tok.value::STRING) AS token
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
         LATERAL FLATTEN(
             input => SPLIT(
                 REGEXP_REPLACE(n."body", '[^A-Za-z]', ' '),                -- letters only
                 ' '
             )
         ) tok
    WHERE n."id" = 'b8f29c08-2530-4ff1-bd49-da1f483b73ed'                   -- real article id
),
distinct_tokens AS (                                                         -- step 3
    SELECT DISTINCT token
    FROM tokenized
    WHERE token <> ''
)
SELECT dt.token,
       wf."frequency",
       ROUND(1 / POW(wf."frequency", 0.4), 6)       AS weight_factor,        -- step 6
       gv_comp.value::FLOAT                         AS vector_component
FROM   distinct_tokens                                   dt
LEFT  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
       ON dt.token = wf."word"                           -- step 4
LEFT  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
       ON dt.token = gv."word"                           -- step 5
LEFT  JOIN LATERAL FLATTEN(input => gv."vector") gv_comp
       ON TRUE
WHERE gv_comp.index < 5                                   -- show only first 5 dims for brevity
LIMIT 50;
```
