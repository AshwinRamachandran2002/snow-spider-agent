Query:
-- 9.  Combine the previous three results to split the raw position
--     changes into the four requested categories.
--     (Everything left after removing pit/retirement/start counts is
--      treated as “standard on-track” passes.)
SELECT   pc."race_id",
         rt."retirements_first5",
         ps."pitstops_first5",
         st."start_related_overtakes",
         (pc."pos_changes_laps1_5"
           - COALESCE(rt."retirements_first5",0)
           - COALESCE(ps."pitstops_first5",0)
           - COALESCE(st."start_related_overtakes",0)
         ) AS "standard_ontrack_passes"
FROM     ( /*  position-changes  */           -- query 8
           SELECT  lp1."race_id",
                   SUM(CASE WHEN lp2."position" <> lp1."position"
                            THEN 1 ELSE 0 END) AS "pos_changes_laps1_5"
           FROM    "lap_positions" AS lp1
           JOIN    "lap_positions" AS lp2
              ON   lp2."race_id"   = lp1."race_id"
             AND   lp2."driver_id" = lp1."driver_id"
             AND   lp2."lap"       = lp1."lap" + 1
           WHERE   lp1."lap_type" = 'Race'
             AND   lp2."lap_type" = 'Race'
             AND   lp1."lap" BETWEEN 1 AND 4
           GROUP BY lp1."race_id"
         ) AS pc
LEFT JOIN ( /* retirements */                 -- query 5
            SELECT  "race_id",
                    COUNT(*) AS "retirements_first5"
            FROM    "retirements"
            WHERE   "lap" BETWEEN 1 AND 5
            GROUP BY "race_id"
          ) AS rt  ON rt."race_id" = pc."race_id"
LEFT JOIN ( /* pit-stops */                   -- query 6
            SELECT  "race_id",
                    COUNT(*) AS "pitstops_first5"
            FROM    "pit_stops"
            WHERE   "lap" BETWEEN 1 AND 5
            GROUP BY "race_id"
          ) AS ps  ON ps."race_id" = pc."race_id"
LEFT JOIN ( /* start-related */               -- query 7
            SELECT  lp0."race_id",
                    COUNT(*) AS "start_related_overtakes"
            FROM    "lap_positions" AS lp0
            JOIN    "lap_positions" AS lp1
              ON    lp1."race_id"   = lp0."race_id"
             AND    lp1."driver_id" = lp0."driver_id"
            WHERE   lp0."lap" = 0
              AND   lp1."lap" = 1
              AND   lp1."position" <> lp0."position"
            GROUP BY lp0."race_id"
          ) AS st  ON st."race_id" = pc."race_id"
LIMIT 20;
