```sql
--Description:  Answer “In laps 1-5, how many overtakes came from (a) retirements,
--              (b) pit-stops, (c) the start phase, and (d) standard on-track moves?”
--              The entire calculation is done in one query with CTEs:
--   • pos_changes  – for every race, count driver-by-driver position changes
--                    between consecutive RACE laps 1-4 vs. 2-5 (raw moves).
--   • ret          – count retirements that occur on laps 1-5 (each counts as
--                    one positional gain for another driver).
--   • pst          – count pit-stops on laps 1-5 (each stop treated as one
--                    overtake in absence of detailed delta-time data).
--   • start        – compare grid (lap 0) with lap 1; any difference is a
--                    “start-related” overtake.
--   • Final SELECT – subtract the first three categories from the raw total
--                    to obtain “Standard Passes”.
WITH pos_changes AS (
       SELECT lp1."race_id",
              SUM(CASE WHEN lp2."position" <> lp1."position" THEN 1 ELSE 0 END)
                  AS "raw_pos_changes"
       FROM   "lap_positions" lp1
       JOIN   "lap_positions" lp2
              ON lp2."race_id"   = lp1."race_id"
             AND lp2."driver_id" = lp1."driver_id"
             AND lp2."lap"       = lp1."lap" + 1        -- consecutive lap
       WHERE  lp1."lap_type" = 'Race'
         AND  lp2."lap_type" = 'Race'
         AND  lp1."lap" BETWEEN 1 AND 4                 -- ensures lp2 ≤ 5
       GROUP BY lp1."race_id"
),
ret AS (
       SELECT "race_id",
              COUNT(*) AS "retirements_first5"
       FROM   "retirements"
       WHERE  "lap" BETWEEN 1 AND 5
       GROUP BY "race_id"
),
pst AS (
       SELECT "race_id",
              COUNT(*) AS "pitstops_first5"
       FROM   "pit_stops"
       WHERE  "lap" BETWEEN 1 AND 5
       GROUP BY "race_id"
),
start AS (
       SELECT lp0."race_id",
              COUNT(*) AS "start_overtakes"
       FROM   "lap_positions" lp0
       JOIN   "lap_positions" lp1
              ON lp1."race_id"   = lp0."race_id"
             AND lp1."driver_id" = lp0."driver_id"
       WHERE  lp0."lap" = 0       -- grid positions
         AND  lp1."lap" = 1       -- first racing lap
         AND  lp1."position" <> lp0."position"
       GROUP BY lp0."race_id"
)
SELECT pc."race_id",
       COALESCE(rt."retirements_first5",0)      AS "Retirements",
       COALESCE(ps."pitstops_first5",0)         AS "Pit Stops",
       COALESCE(st."start_overtakes",0)         AS "Start Overtakes",
       ( pc."raw_pos_changes"
         - COALESCE(rt."retirements_first5",0)
         - COALESCE(ps."pitstops_first5",0)
         - COALESCE(st."start_overtakes",0)
       )                                        AS "Standard On-track Passes"
FROM   pos_changes pc
LEFT  JOIN ret   rt ON rt."race_id" = pc."race_id"
LEFT  JOIN pst   ps ON ps."race_id" = pc."race_id"
LEFT  JOIN start st ON st."race_id" = pc."race_id"
ORDER BY pc."race_id"
LIMIT 20;
```
