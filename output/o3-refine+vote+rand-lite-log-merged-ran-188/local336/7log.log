Here are (progressively more complex) exploration queries that can be used to work-out the number of first-five-lap overtakes attributable to each of the four categories:

```sql
-- 1.  What kinds of lap entries are stored?
SELECT DISTINCT "lap_type"
FROM "lap_positions"
LIMIT 20;
```

```sql
-- 2.  Show the starting grid (lap = 0) and the first racing lap (lap = 1)
--     so we can spot “start-related” position changes.
SELECT  lp0."race_id",
        lp0."driver_id",
        lp0."position"  AS "grid_pos",
        lp1."position"  AS "lap1_pos"
FROM    "lap_positions"  AS lp0
JOIN    "lap_positions"  AS lp1
       ON lp1."race_id"  = lp0."race_id"
      AND lp1."driver_id"= lp0."driver_id"
WHERE   lp0."lap" = 0
  AND   lp1."lap" = 1
LIMIT 20;
```

```sql
-- 3.  Retirements that happened on laps 1-5
SELECT DISTINCT "race_id",
                "driver_id",
                "lap",
                "status_id"
FROM   "retirements"
WHERE  "lap" BETWEEN 1 AND 5
LIMIT 20;
```

```sql
-- 4.  Pit-stops made in laps 1-5 (often trigger position losses)
SELECT DISTINCT "race_id",
                "driver_id",
                "lap",
                "duration"
FROM   "pit_stops"
WHERE  "lap" BETWEEN 1 AND 5
LIMIT 20;
```

```sql
-- 5.  Quick count of first-five-lap retirements per race
SELECT  "race_id",
        COUNT(*) AS "retirements_first5"
FROM    "retirements"
WHERE   "lap" BETWEEN 1 AND 5
GROUP BY "race_id"
LIMIT 20;
```

```sql
-- 6.  Quick count of pit-stops in the first five laps per race
SELECT  "race_id",
        COUNT(*) AS "pitstops_first5"
FROM    "pit_stops"
WHERE   "lap" BETWEEN 1 AND 5
GROUP BY "race_id"
LIMIT 20;
```

```sql
-- 7.  Count of drivers whose position changed between the grid (lap 0)
--     and lap-1  →  “start-related overtakes”
SELECT  lp0."race_id",
        COUNT(*) AS "start_related_overtakes"
FROM    "lap_positions" AS lp0
JOIN    "lap_positions" AS lp1
       ON lp1."race_id"   = lp0."race_id"
      AND lp1."driver_id" = lp0."driver_id"
WHERE   lp0."lap" = 0
  AND   lp1."lap" = 1
  AND   lp1."position" <> lp0."position"
GROUP BY lp0."race_id"
LIMIT 20;
```

```sql
-- 8.  Raw position changes between every consecutive racing lap
--     inside laps 1-5  (lap_type = 'Race')
SELECT  lp1."race_id",
        SUM(CASE WHEN lp2."position" <> lp1."position" THEN 1 ELSE 0 END)
               AS "pos_changes_laps1_5"
FROM    "lap_positions" AS lp1
JOIN    "lap_positions" AS lp2
       ON lp2."race_id"   = lp1."race_id"
      AND lp2."driver_id" = lp1."driver_id"
      AND lp2."lap"       = lp1."lap" + 1
WHERE   lp1."lap_type" = 'Race'
  AND   lp2."lap_type" = 'Race'
  AND   lp1."lap" BETWEEN 1 AND 4          -- 1-4 so that lp1+1 ≤ 5
GROUP BY lp1."race_id"
LIMIT 20;
```

```sql
-- 9.  Combine the previous three results to split the raw position
--     changes into the four requested categories.
--     (Everything left after removing pit/retirement/start counts is
--      treated as “standard on-track” passes.)
SELECT   pc."race_id",
         rt."retirements_first5",
         ps."pitstops_first5",
         st."start_related_overtakes",
         (pc."pos_changes_laps1_5"
           - COALESCE(rt."retirements_first5",0)
           - COALESCE(ps."pitstops_first5",0)
           - COALESCE(st."start_related_overtakes",0)
         ) AS "standard_ontrack_passes"
FROM     ( /*  position-changes  */           -- query 8
           SELECT  lp1."race_id",
                   SUM(CASE WHEN lp2."position" <> lp1."position"
                            THEN 1 ELSE 0 END) AS "pos_changes_laps1_5"
           FROM    "lap_positions" AS lp1
           JOIN    "lap_positions" AS lp2
              ON   lp2."race_id"   = lp1."race_id"
             AND   lp2."driver_id" = lp1."driver_id"
             AND   lp2."lap"       = lp1."lap" + 1
           WHERE   lp1."lap_type" = 'Race'
             AND   lp2."lap_type" = 'Race'
             AND   lp1."lap" BETWEEN 1 AND 4
           GROUP BY lp1."race_id"
         ) AS pc
LEFT JOIN ( /* retirements */                 -- query 5
            SELECT  "race_id",
                    COUNT(*) AS "retirements_first5"
            FROM    "retirements"
            WHERE   "lap" BETWEEN 1 AND 5
            GROUP BY "race_id"
          ) AS rt  ON rt."race_id" = pc."race_id"
LEFT JOIN ( /* pit-stops */                   -- query 6
            SELECT  "race_id",
                    COUNT(*) AS "pitstops_first5"
            FROM    "pit_stops"
            WHERE   "lap" BETWEEN 1 AND 5
            GROUP BY "race_id"
          ) AS ps  ON ps."race_id" = pc."race_id"
LEFT JOIN ( /* start-related */               -- query 7
            SELECT  lp0."race_id",
                    COUNT(*) AS "start_related_overtakes"
            FROM    "lap_positions" AS lp0
            JOIN    "lap_positions" AS lp1
              ON    lp1."race_id"   = lp0."race_id"
             AND    lp1."driver_id" = lp0."driver_id"
            WHERE   lp0."lap" = 0
              AND   lp1."lap" = 1
              AND   lp1."position" <> lp0."position"
            GROUP BY lp0."race_id"
          ) AS st  ON st."race_id" = pc."race_id"
LIMIT 20;
```

```sql
-- 10.  (Optional)  Pull just one race to see the final category counts
--      in the format required by the question.
SELECT "race_id",
       "retirements_first5"     AS "Retirements",
       "pitstops_first5"        AS "Pit Stops",
       "start_related_overtakes"AS "Start Overtakes",
       "standard_ontrack_passes"AS "Standard Passes"
FROM (
   /* Use query 9 as a CTE or sub-query here */
) LIMIT 20;
```

Running these queries (in order) produces the numbers of first-five-lap overtakes broken-down into:  
• retirements  
• pit-stop-triggered position losses  
• start-phase gains/losses  
• regular on-track passes.
