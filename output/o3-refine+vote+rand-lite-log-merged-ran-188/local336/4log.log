Query:
--Description: Re-compute overtakes by category for the first five laps.
--  • ret  : counts retirements (one “overtake opportunity” per retirement).
--  • pit  : counts pit stops (none exist for race_id = 18, so this will be 0).
--  • start: drivers who gained places from grid to lap 1 (“start-related” overtakes).
--  • total: all lap-to-lap position gains from laps 1–5.
--  • standard_ontrack_passes = total − ret − pit − start.
WITH
ret AS (
    SELECT COUNT(*) AS retire_overtakes
    FROM   "retirements"
    WHERE  "race_id" = 18
      AND  "lap"     <= 5
),
pit AS (
    SELECT COUNT(*) AS pit_overtakes
    FROM   "pit_stops"
    WHERE  "race_id" = 18
      AND  "lap"     <= 5
),
start AS (
    SELECT SUM(CASE WHEN lp."position" < r."grid" THEN 1 ELSE 0 END) AS start_overtakes
    FROM   "results"        AS r
    JOIN   "lap_positions" AS lp
           ON lp."race_id"  = r."race_id"
          AND lp."driver_id" = r."driver_id"
    WHERE  r."race_id" = 18
      AND  lp."lap"   = 1
),
total AS (
    SELECT SUM(CASE WHEN lp1."position" < lp0."position" THEN 1 ELSE 0 END) AS total_gains
    FROM   "lap_positions" lp1
    JOIN   "lap_positions" lp0
           ON lp0."race_id"  = lp1."race_id"
          AND lp0."driver_id" = lp1."driver_id"
          AND lp0."lap"       = lp1."lap" - 1
    WHERE  lp1."race_id" = 18
      AND  lp1."lap" BETWEEN 1 AND 5
)
SELECT total_gains
       - retire_overtakes
       - pit_overtakes
       - start_overtakes   AS "standard_ontrack_passes",
       retire_overtakes,
       pit_overtakes,
       start_overtakes
FROM   total, ret, pit, start
