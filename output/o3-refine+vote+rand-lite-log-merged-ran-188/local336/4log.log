Query:
-- 5) Compare grid position (results.grid) with position on lap 1
SELECT r."driver_id",
       r."grid"           AS "starting_grid",
       lp."position"      AS "lap1_position"
FROM   "results"        AS r
JOIN   "lap_positions" AS lp
       ON lp."race_id"  = r."race_id"
      AND lp."driver_id" = r."driver_id"
