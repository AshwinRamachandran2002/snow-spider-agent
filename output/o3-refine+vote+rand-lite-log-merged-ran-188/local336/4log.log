ORDER BY "driver_id", "lap"
LIMIT 20;
```

```sql
-- 3) How many retirements happened in the first five laps?
SELECT COUNT(*) AS "retirements_first_5_laps"
FROM   "retirements"
WHERE  "race_id" = 18
  AND  "lap" <= 5;
```

```sql
-- 4) How many pit-stops took place in the first five laps?
SELECT COUNT(*) AS "pit_stops_first_5_laps"
FROM   "pit_stops"
WHERE  "race_id" = 18
  AND  "lap" <= 5;
```

```sql
-- 5) Compare grid position (results.grid) with position on lap 1
SELECT r."driver_id",
       r."grid"           AS "starting_grid",
       lp."position"      AS "lap1_position"
FROM   "results"        AS r
JOIN   "lap_positions" AS lp
       ON lp."race_id"  = r."race_id"
      AND lp."driver_id" = r."driver_id"
WHERE  r."race_id" = 18
  AND  lp."lap"   = 1
LIMIT 20;
```

```sql
-- 6) Count the drivers who improved their position between the grid and lap 1
SELECT SUM(CASE WHEN lp."position" < r."grid" THEN 1 ELSE 0 END)
       AS "start_related_overtakes"
FROM   "results"        AS r
JOIN   "lap_positions" AS lp
       ON lp."race_id"  = r."race_id"
      AND lp."driver_id" = r."driver_id"
WHERE  r."race_id" = 18
  AND  lp."lap"   = 1;
```

```sql
-- 7) Total position gains (overtakes) lap-by-lap from lap 1 to lap 5
WITH laps AS (
    SELECT lp1."driver_id",
           lp1."lap"                      AS "curr_lap",
           lp1."position"                 AS "curr_pos",
           lp0."position"                 AS "prev_pos"
    FROM   "lap_positions" lp1
    JOIN   "lap_positions" lp0
           ON lp0."race_id"  = lp1."race_id"
          AND lp0."driver_id" = lp1."driver_id"
          AND lp0."lap"       = lp1."lap" - 1
    WHERE  lp1."race_id" = 18
      AND  lp1."lap" BETWEEN 1 AND 5
)
SELECT SUM(CASE WHEN "curr_pos" < "prev_pos" THEN 1 ELSE 0 END)
       AS "all_position_gains_laps_1_to_5"
FROM   laps;
```

```sql
-- 8) List every pit-stop in laps 1-5 (to match them against position changes)
SELECT "driver_id",
       "lap",
       "stop",
       "milliseconds"
FROM   "pit_stops"
WHERE  "race_id" = 18
  AND  "lap" <= 5
ORDER BY "lap", "time"
LIMIT 20;
```

```sql
-- 9) List every retirement in laps 1-5 (to match them against position changes)
SELECT "driver_id",
       "lap",
       "status_id",
       "retirement_type"
FROM   "retirements"
WHERE  "race_id" = 18
  AND  "lap" <= 5
ORDER BY "lap"
LIMIT 20;
```

```sql
-- 10) Bring everything together: numbers of overtakes caused by
--     retirements, pit-stops, the start, and the remaining on-track passes
WITH
ret AS (                 -- overtakes due to retirements
    SELECT SUM( 56 - "position_order") AS "retire_overtakes"  -- 56 cars = max grid size
    FROM   "retirements"
    WHERE  "race_id" = 18 AND "lap" <= 5
),
pit AS (                 -- overtakes due to pit-stops (one overtake per pit)               
    SELECT COUNT(*)      AS "pit_overtakes"
    FROM   "pit_stops"
    WHERE  "race_id" = 18 AND "lap" <= 5
),
start AS (               -- grid vs. lap 1 improvements
    SELECT SUM(CASE WHEN lp."position" < r."grid" THEN 1 ELSE 0 END)
           AS "start_overtakes"
    FROM   "results"        AS r
    JOIN   "lap_positions" AS lp
           ON lp."race_id"  = r."race_id"
          AND lp."driver_id" = r."driver_id"
    WHERE  r."race_id" = 18
      AND  lp."lap"   = 1
),
total AS (               -- all position gains laps 1-5
    SELECT SUM(CASE WHEN lp1."position" < lp0."position" THEN 1 ELSE 0 END)
           AS "total_gains"
    FROM   "lap_positions" lp1
    JOIN   "lap_positions" lp0
           ON lp0."race_id"  = lp1."race_id"
          AND lp0."driver_id" = lp1."driver_id"
          AND lp0."lap"       = lp1."lap" - 1
    WHERE  lp1."race_id" = 18
      AND  lp1."lap" BETWEEN 1 AND 5
)
SELECT total_gains
       - retire_overtakes
       - pit_overtakes
       - start_overtakes  AS "standard_ontrack_passes",
       retire_overtakes,
       pit_overtakes,
       start_overtakes
FROM   total, ret, pit, start;
```
