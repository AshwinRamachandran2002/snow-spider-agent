```sql
--Description: 5) Combine lap_positions with retirements to see the position just before any retirement that
--              happens within the first five laps (across all races, not just race_id = 1).
SELECT lp."race_id",
       lp."driver_id",
       lp."lap",
       lp."position",
       r."retirement_type"
FROM   "lap_positions" AS lp
JOIN   "retirements"   AS r
       ON lp."race_id"  = r."race_id"
      AND lp."driver_id" = r."driver_id"
      AND lp."lap"       = r."lap"
WHERE  lp."lap" <= 5
LIMIT 20;
```

```sql
--Description: 6) Find position changes caused by pit-stops during laps 1-5 for every race
--              (removed specific race filter so we capture any early pit activity).
SELECT ps."race_id",
       ps."driver_id",
       ps."lap"            AS "pit_lap",
       lp1."position"      AS "pos_before_pit",
       lp2."position"      AS "pos_after_pit"
FROM   "pit_stops"      AS ps
LEFT JOIN "lap_positions" AS lp1
       ON lp1."race_id"   = ps."race_id"
      AND lp1."driver_id" = ps."driver_id"
      AND lp1."lap"       = ps."lap" - 1
LEFT JOIN "lap_positions" AS lp2
       ON lp2."race_id"   = ps."race_id"
      AND lp2."driver_id" = ps."driver_id"
      AND lp2."lap"       = ps."lap" + 1
WHERE  ps."lap" BETWEEN 1 AND 5
LIMIT 20;
```

```sql
--Description: 7) Derive start-related gains for every driver in every race by comparing
--              grid position (lap 0) with position after lap 1 (no race filter).
WITH grid AS (
    SELECT "race_id",
           "driver_id",
           "position" AS "grid_pos"
    FROM   "lap_positions"
    WHERE  "lap" = 0
),
lap1 AS (
    SELECT "race_id",
           "driver_id",
           "position" AS "pos_after_lap1"
    FROM   "lap_positions"
    WHERE  "lap" = 1
)
SELECT g."race_id",
       g."driver_id",
       g."grid_pos",
       l1."pos_after_lap1",
       (g."grid_pos" - l1."pos_after_lap1") AS "net_gain"
FROM   grid AS g
JOIN   lap1 AS l1
  ON   l1."race_id"   = g."race_id"
 AND   l1."driver_id" = g."driver_id"
LIMIT 20;
```

```sql
--Description: 8) Identify normal on-track passes (position changes not triggered by pit-stops
--              or retirements) within laps 1-5 across all races.
WITH pos AS (
    SELECT "race_id",
           "driver_id",
           "lap",
           "position",
           LAG("position") OVER (PARTITION BY "race_id","driver_id"
                                 ORDER BY "lap") AS "prev_pos"
    FROM   "lap_positions"
    WHERE  "lap" BETWEEN 1 AND 5
),
early_pits AS (
    SELECT DISTINCT "race_id", "driver_id"
    FROM   "pit_stops"
    WHERE  "lap" BETWEEN 1 AND 5
),
early_rets AS (
    SELECT DISTINCT "race_id", "driver_id"
    FROM   "retirements"
    WHERE  "lap" BETWEEN 1 AND 5
)
SELECT p.*
FROM   pos AS p
LEFT  JOIN early_pits AS ep
       ON ep."race_id" = p."race_id"
      AND ep."driver_id" = p."driver_id"
LEFT  JOIN early_rets AS er
       ON er."race_id" = p."race_id"
      AND er."driver_id" = p."driver_id"
WHERE  p."prev_pos" IS NOT NULL
  AND  p."prev_pos" <> p."position"   -- position actually changed
  AND  ep."driver_id" IS NULL         -- exclude pit-stop laps
  AND  er."driver_id" IS NULL         -- exclude retirements
LIMIT 20;
```
