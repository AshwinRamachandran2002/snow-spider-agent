```

```sql
-- Description: 2)  Inspect how the running order changed during the first-five laps of one sample race (race_id = 1).
SELECT *
FROM "lap_positions"
WHERE "race_id" = 1
  AND "lap" BETWEEN 0 AND 5            -- grid (0) + first five race laps
ORDER BY "driver_id", "lap"
LIMIT 20;
```

```sql
-- Description: 3)  See which drivers retired and on which laps for the same race.
SELECT *
FROM "retirements"
WHERE "race_id" = 1
  AND "lap" <= 5                       -- first-five-lap window
LIMIT 20;
```

```sql
-- Description: 4)  Check pit stops that happened in the first-five laps of the race.
SELECT *
FROM "pit_stops"
WHERE "race_id" = 1
  AND "lap" <= 5
LIMIT 20;
```

```sql
-- Description: 5)  Combine lap_positions with retirements to see the position just before retirement in first five laps.
SELECT lp."driver_id",
       lp."lap",
       lp."position",
       r."retirement_type"
FROM   "lap_positions" AS lp
JOIN   "retirements"    AS r
  ON   lp."race_id" = r."race_id"
 AND   lp."driver_id" = r."driver_id"
WHERE  lp."race_id" = 1
  AND  lp."lap"      = r."lap"
  AND  lp."lap" <= 5
LIMIT 20;
```

```sql
-- Description: 6)  Find position changes caused by pit-stops in laps 1-5 (compare the lap before & after each stop).
SELECT ps."driver_id",
       ps."lap"          AS "pit_lap",
       lp1."position"    AS "pos_before_pit",
       lp2."position"    AS "pos_after_pit"
FROM   "pit_stops"   AS ps
LEFT JOIN "lap_positions" AS lp1
       ON lp1."race_id" = ps."race_id"
      AND lp1."driver_id" = ps."driver_id"
      AND lp1."lap"   = ps."lap" - 1
LEFT JOIN "lap_positions" AS lp2
       ON lp2."race_id" = ps."race_id"
      AND lp2."driver_id" = ps."driver_id"
      AND lp2."lap"   = ps."lap" + 1
WHERE  ps."race_id" = 1
  AND  ps."lap" BETWEEN 1 AND 5
LIMIT 20;
```

```sql
-- Description: 7)  Derive “start-related” gains: compare grid (lap 0) vs. lap 1 position.
SELECT lp0."driver_id",
       lp0."position" AS "grid_pos",
       lp1."position" AS "pos_after_lap1",
       (lp0."position" - lp1."position") AS "net_gain"
FROM   "lap_positions" AS lp0
JOIN   "lap_positions" AS lp1
  ON   lp1."race_id"   = lp0."race_id"
 AND   lp1."driver_id" = lp0."driver_id"
WHERE  lp0."race_id" = 1
  AND  lp0."lap" = 0
  AND  lp1."lap" = 1
LIMIT 20;
```

```sql
-- Description: 8)  Identify normal on-track passes (no pit stop or retirement) between laps 1-5.
WITH pos AS (
  SELECT "race_id","driver_id","lap","position",
         LAG("position") OVER (PARTITION BY "race_id","driver_id"
                               ORDER BY "lap") AS prev_pos
  FROM   "lap_positions"
  WHERE  "race_id" = 1
    AND  "lap" BETWEEN 1 AND 5
)
SELECT *
FROM   pos
WHERE  prev_pos IS NOT NULL
  AND  prev_pos <> "position"          -- position changed
  AND  "driver_id" NOT IN (SELECT "driver_id"
                           FROM   "pit_stops"
                           WHERE  "race_id" = 1
                             AND "lap" BETWEEN 1 AND 5)
  AND  "driver_id" NOT IN (SELECT "driver_id"
                           FROM   "retirements"
                           WHERE  "race_id" = 1
                             AND "lap" BETWEEN 1 AND 5)
LIMIT 20;
```

The eight queries together give you the data you need to count overtakes in each category—retirements, pit stops, start-related (grid to lap 1), and standard on-track passes—during the first five laps.
