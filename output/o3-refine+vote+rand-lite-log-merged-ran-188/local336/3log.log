--Description: 7) Count the number of retirement events that occurred during laps 1-5
--              of race 1. COUNT(*) naturally returns 0 when no rows match.
SELECT COUNT(*) AS "early_retirement_events"
FROM   "retirements"
WHERE  "race_id" = 1
  AND  "lap" BETWEEN 1 AND 5
