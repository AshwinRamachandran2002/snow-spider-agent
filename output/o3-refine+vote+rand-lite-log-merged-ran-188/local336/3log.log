-- 4) Description:  Total count of start-related overtakes (sum of all positions
--    gained between lap-0 and lap-1).
SELECT SUM( CASE WHEN (lp0."position" - lp1."position") > 0
                 THEN (lp0."position" - lp1."position") ELSE 0 END )
       AS "start_related_overtakes"
FROM   "lap_positions" AS lp0
JOIN   "lap_positions" AS lp1
         ON lp0."race_id" = lp1."race_id"
        AND lp0."driver_id" = lp1."driver_id"
WHERE  lp0."race_id" = 1
  AND  lp0."lap"  = 0
  AND  lp1."lap"  = 1;
