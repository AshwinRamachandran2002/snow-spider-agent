```sql
-- 1) Description:  Discover the different kinds of records stored in the lap-by-lap
--    position table – this tells us which “event” labels are available.
SELECT DISTINCT "lap_type"
FROM   "lap_positions";
```

```sql
-- 2) Description:  Inspect every driver’s position from the start (grid-lap 0)
--    through lap-5 for the race we are analysing (race_id = 1 in the sample data).
SELECT  "race_id",
        "driver_id",
        "lap",
        "position",
        "lap_type"
FROM    "lap_positions"
WHERE   "race_id" = 1
  AND   "lap"     <= 5
ORDER BY "driver_id","lap"
LIMIT   20;
```

```sql
-- 3) Description:  Compare grid position (lap-0) with lap-1 position for each driver.
--    A positive value in “positions_gained_on_start” is an overtake made
--    immediately after the start signal.
SELECT  lp0."driver_id",
        lp0."position" AS "grid_position",
        lp1."position" AS "lap1_position",
        (lp0."position" - lp1."position") AS "positions_gained_on_start"
FROM    "lap_positions" AS lp0
JOIN    "lap_positions" AS lp1
          ON lp0."race_id" = lp1."race_id"
         AND lp0."driver_id" = lp1."driver_id"
WHERE   lp0."race_id" = 1
  AND   lp0."lap"  = 0
  AND   lp1."lap"  = 1
ORDER BY "positions_gained_on_start" DESC
LIMIT   20;
```

```sql
-- 4) Description:  Total count of start-related overtakes (sum of all positions
--    gained between lap-0 and lap-1).
SELECT SUM( CASE WHEN (lp0."position" - lp1."position") > 0
                 THEN (lp0."position" - lp1."position") ELSE 0 END )
       AS "start_related_overtakes"
FROM   "lap_positions" AS lp0
JOIN   "lap_positions" AS lp1
         ON lp0."race_id" = lp1."race_id"
        AND lp0."driver_id" = lp1."driver_id"
WHERE  lp0."race_id" = 1
  AND  lp0."lap"  = 0
  AND  lp1."lap"  = 1;
```

```sql
-- 5) Description:  List every pit-stop that happens on laps 1-5; each one could
--    trigger overtakes by other cars.
SELECT  "driver_id",
        "lap",
        "stop",
        "time",
        "duration"
FROM    "pit_stops"
WHERE   "race_id" = 1
  AND   "lap" BETWEEN 1 AND 5
ORDER BY "lap","driver_id"
LIMIT   20;
```

```sql
-- 6) Description:  How many overtakes were caused by those early pit-stops?
--    For every stop we compare the pitting driver’s position on the lap before
--    the stop with the position on the pit-lap itself.  Any fall in position
--    equals the number of cars that overtook.
SELECT SUM(
           CASE WHEN (before."position" - after."position") < 0
                     THEN (after."position" - before."position")
                     ELSE 0 END
         ) AS "pit_stop_overtakes"
FROM (
        SELECT ps."driver_id",
               ps."lap"     AS pit_lap
        FROM   "pit_stops"  AS ps
        WHERE  ps."race_id" = 1
          AND  ps."lap" BETWEEN 1 AND 5
        GROUP BY ps."driver_id", ps."lap"
     ) AS p
JOIN "lap_positions" AS before
     ON before."race_id"  = 1
    AND before."driver_id"= p."driver_id"
    AND before."lap"      = p."pit_lap" - 1
JOIN "lap_positions" AS after
     ON after."race_id"   = 1
    AND after."driver_id" = p."driver_id"
    AND after."lap"       = p."pit_lap";
```

```sql
-- 7) Description:  Identify every retirement that happens inside the first five
--    laps – these often gift positions to the cars behind.
SELECT  "driver_id",
        "lap",
        "status_id",
        "retirement_type"
FROM    "retirements"
WHERE   "race_id" = 1
  AND   "lap" BETWEEN 1 AND 5;
```

```sql
-- 8) Description:  For each of those retirements, count how many cars were
--    running behind the retiring driver on that lap – every one of them
--    gains a place (i.e. an “overtake” caused by retirement).
SELECT SUM( affected."behind_count" ) AS "retirement_overtakes"
FROM (
        SELECT r."driver_id",
               r."lap",
               ( SELECT COUNT(*)
                 FROM   "lap_positions" lp
                 WHERE  lp."race_id" = r."race_id"
                   AND  lp."lap"     = r."lap"
                   AND  lp."position" >
                        ( SELECT lp2."position"
                          FROM   "lap_positions" lp2
                          WHERE  lp2."race_id"  = r."race_id"
                            AND  lp2."driver_id"= r."driver_id"
                            AND  lp2."lap"      = r."lap" )
               ) AS "behind_count"
        FROM   "retirements" r
        WHERE  r."race_id" = 1
          AND  r."lap" BETWEEN 1 AND 5
     ) AS affected;
```

```sql
-- 9) Description:  Compute the remaining “standard on-track” passes by subtracting
--    start-, pit- and retirement-based overtakes from the total lap-by-lap
--    position changes recorded in laps 1-5.
WITH position_changes AS (
       SELECT  curr."driver_id",
               curr."lap",
               (prev."position" - curr."position") AS "delta"
       FROM    "lap_positions" AS curr
       JOIN    "lap_positions" AS prev
         ON    curr."race_id"  = prev."race_id"
        AND    curr."driver_id"= prev."driver_id"
        AND    curr."lap"      = prev."lap" + 1
       WHERE   curr."race_id"  = 1
         AND   curr."lap" BETWEEN 1 AND 5
),
total_overtakes AS (
       SELECT SUM( CASE WHEN delta>0 THEN delta ELSE 0 END ) AS tot
       FROM   position_changes
),
start_overtakes AS (
       SELECT SUM( CASE WHEN (lp0."position" - lp1."position") > 0
                        THEN (lp0."position" - lp1."position") ELSE 0 END ) AS so
       FROM   "lap_positions" lp0
       JOIN   "lap_positions" lp1
              ON lp0."race_id" = lp1."race_id"
             AND lp0."driver_id" = lp1."driver_id"
       WHERE  lp0."race_id" = 1 AND lp0."lap" = 0 AND lp1."lap" = 1
),
pit_overtakes AS (
       SELECT SUM(
                CASE WHEN (before."position" - after."position") < 0
                     THEN (after."position" - before."position") ELSE 0 END
             ) AS po
       FROM (
              SELECT ps."driver_id", ps."lap"
              FROM   "pit_stops" ps
              WHERE  ps."race_id" = 1 AND ps."lap" BETWEEN 1 AND 5
              GROUP BY ps."driver_id", ps."lap"
            ) p
       JOIN "lap_positions" before
              ON before."race_id" = 1 AND before."driver_id" = p."driver_id"
             AND before."lap"     = p."lap" - 1
       JOIN "lap_positions" after
              ON after."race_id"  = 1 AND after."driver_id"  = p."driver_id"
             AND after."lap"      = p."lap"
),
ret_overtakes AS (
       SELECT SUM( affected."behind_count" ) AS ro
       FROM (
              SELECT r."driver_id",
                     r."lap",
                     ( SELECT COUNT(*)
                       FROM   "lap_positions" lp
                       WHERE  lp."race_id" = r."race_id"
                         AND  lp."lap"     = r."lap"
                         AND  lp."position" >
                              ( SELECT lp2."position"
                                FROM   "lap_positions" lp2
                                WHERE  lp2."race_id"  = r."race_id"
                                  AND  lp2."driver_id"= r."driver_id"
                                  AND  lp2."lap"      = r."lap") ) AS "behind_count"
              FROM   "retirements" r
              WHERE  r."race_id" = 1 AND r."lap" BETWEEN 1 AND 5
            ) AS affected
)
SELECT  (SELECT tot FROM total_overtakes)
      - (SELECT so  FROM start_overtakes)
      - (SELECT po  FROM pit_overtakes)
      - (SELECT ro  FROM ret_overtakes)     AS "standard_on_track_overtakes";
```

```sql
-- 10) Description:  (Optional cross-check)  Bring the four categories together
--     so they can be reported side-by-side.
WITH so AS (SELECT ... ),           -- (use the CTEs built in query-9)
     po AS (SELECT ... ),
     ro AS (SELECT ... ),
     st AS (SELECT ... )
SELECT (SELECT so FROM so)  AS "Start",
       (SELECT po FROM po)  AS "Pit",
       (SELECT ro FROM ro)  AS "Retirement",
       (SELECT st FROM st)  AS "Standard";
```
