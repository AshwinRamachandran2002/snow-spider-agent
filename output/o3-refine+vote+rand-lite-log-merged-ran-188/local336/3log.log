Query:
--Description: 8) Compute how many positions were gained because of those early-lap
--              retirements in race 1.  For each retirement we count the cars that
--              were running behind the retiring driver on that lap; summing these
--              counts gives the total “retirement-induced” overtakes. COALESCE
--              ensures the query returns 0 if there are no such retirements.
WITH early_ret AS (
    SELECT "driver_id", "lap"
    FROM   "retirements"
    WHERE  "race_id" = 1
      AND  "lap" BETWEEN 1 AND 5
),
gains AS (
    SELECT
        ( SELECT COUNT(*)
          FROM   "lap_positions" lp
          WHERE  lp."race_id" = 1
            AND  lp."lap"     = er."lap"
            AND  lp."position" >
                 ( SELECT lp2."position"
                   FROM   "lap_positions" lp2
                   WHERE  lp2."race_id"  = 1
                     AND  lp2."driver_id"= er."driver_id"
                     AND  lp2."lap"      = er."lap") ) AS gained_places
    FROM   early_ret er
)
SELECT COALESCE(SUM(gained_places),0) AS "retirement_overtakes"
FROM   gains
Answer:
retirement_overtakes
0
Query:
--Description: 9) Determine the number of “standard on-track” passes in laps 1-5 of
--              race 1.  Total position gains between successive laps are computed,
--              then start-, pit- and retirement-related gains are subtracted.  Each
--              component is wrapped in COALESCE so the final result is never NULL.
WITH position_changes AS (
       SELECT (prev."position" - curr."position") AS delta
       FROM   "lap_positions" curr
       JOIN   "lap_positions" prev
              ON curr."race_id"  = prev."race_id"
             AND curr."driver_id"= prev."driver_id"
             AND curr."lap"      = prev."lap" + 1
       WHERE  curr."race_id" = 1
         AND  curr."lap" BETWEEN 1 AND 5
), total_overtakes AS (
       SELECT COALESCE(SUM(CASE WHEN delta > 0 THEN delta ELSE 0 END),0) AS tot
       FROM   position_changes
), start_overtakes AS (
       SELECT COALESCE(
              SUM(CASE WHEN (lp0."position" - lp1."position") > 0
                       THEN  lp0."position" - lp1."position" ELSE 0 END),0) AS so
       FROM   "lap_positions" lp0
       JOIN   "lap_positions" lp1
              ON lp0."race_id" = lp1."race_id"
             AND lp0."driver_id" = lp1."driver_id"
       WHERE  lp0."race_id" = 1
         AND  lp0."lap" = 0
         AND  lp1."lap" = 1
), pit_overtakes AS (
       WITH early_pits AS (
            SELECT "driver_id","lap"
            FROM   "pit_stops"
            WHERE  "race_id" = 1
              AND  "lap" BETWEEN 1 AND 5
            GROUP  BY "driver_id","lap"
       ), diff AS (
            SELECT (after."position" - before."position") AS lost_to_others
            FROM   early_pits ep
            JOIN   "lap_positions" before
                   ON before."race_id" = 1
                  AND before."driver_id" = ep."driver_id"
                  AND before."lap" = ep."lap" - 1
            JOIN   "lap_positions" after
                   ON after."race_id" = 1
                  AND after."driver_id" = ep."driver_id"
                  AND after."lap" = ep."lap"
       )
       SELECT COALESCE(
              SUM(CASE WHEN lost_to_others > 0 THEN lost_to_others ELSE 0 END),0) AS po
       FROM   diff
), ret_overtakes AS (
       WITH early_ret AS (
            SELECT "driver_id","lap"
            FROM   "retirements"
            WHERE  "race_id" = 1
              AND  "lap" BETWEEN 1 AND 5
       ), gain AS (
            SELECT ( SELECT COUNT(*)
                     FROM   "lap_positions" lp
                     WHERE  lp."race_id" = 1
                       AND  lp."lap"     = er."lap"
                       AND  lp."position" >
                            ( SELECT lp2."position"
                              FROM   "lap_positions" lp2
                              WHERE  lp2."race_id"  = 1
                                AND  lp2."driver_id"= er."driver_id"
                                AND  lp2."lap"      = er."lap") ) AS gained
            FROM   early_ret er
       )
       SELECT COALESCE(SUM(gained),0) AS ro
       FROM   gain
)
SELECT (SELECT tot FROM total_overtakes)
     - (SELECT so  FROM start_overtakes)
     - (SELECT po  FROM pit_overtakes)
     - (SELECT ro  FROM ret_overtakes) AS "standard_on_track_overtakes"
Answer:
standard_on_track_overtakes
6
Query:
--Description: 10) Summarise the four overtake categories for laps 1-5 of race 1 in
--              a single row.  The individual totals are obtained using the same
--              sub-queries defined above, each protected by COALESCE.
WITH start_overtakes AS (
       SELECT COALESCE(
              SUM(CASE WHEN (lp0."position" - lp1."position") > 0
                       THEN lp0."position" - lp1."position" ELSE 0 END),0) AS val
       FROM   "lap_positions" lp0
       JOIN   "lap_positions" lp1
              ON lp0."race_id" = lp1."race_id"
             AND lp0."driver_id" = lp1."driver_id"
       WHERE  lp0."race_id" = 1
         AND  lp0."lap" = 0
         AND  lp1."lap" = 1
), pit_overtakes AS (
       WITH early_pits AS (
            SELECT "driver_id","lap"
            FROM   "pit_stops"
            WHERE  "race_id" = 1
              AND  "lap" BETWEEN 1 AND 5
            GROUP  BY "driver_id","lap"
       ), diff AS (
            SELECT (after."position" - before."position") AS lost_to_others
            FROM   early_pits ep
            JOIN   "lap_positions" before
                   ON before."race_id" = 1
                  AND before."driver_id" = ep."driver_id"
                  AND before."lap" = ep."lap" - 1
            JOIN   "lap_positions" after
                   ON after."race_id" = 1
                  AND after."driver_id" = ep."driver_id"
                  AND after."lap" = ep."lap"
       )
       SELECT COALESCE(
              SUM(CASE WHEN lost_to_others > 0 THEN lost_to_others ELSE 0 END),0) AS val
       FROM   diff
), retirement_overtakes AS (
       WITH early_ret AS (
            SELECT "driver_id","lap"
            FROM   "retirements"
            WHERE  "race_id" = 1
              AND  "lap" BETWEEN 1 AND 5
       ), gain AS (
            SELECT ( SELECT COUNT(*)
                     FROM   "lap_positions" lp
                     WHERE  lp."race_id" = 1
                       AND  lp."lap"     = er."lap"
                       AND  lp."position" >
                            ( SELECT lp2."position"
                              FROM   "lap_positions" lp2
                              WHERE  lp2."race_id"  = 1
                                AND  lp2."driver_id"= er."driver_id"
                                AND  lp2."lap"      = er."lap") ) AS gained
            FROM   early_ret er
       )
       SELECT COALESCE(SUM(gained),0) AS val
       FROM   gain
), total_changes AS (
       WITH pc AS (
            SELECT (prev."position" - curr."position") AS delta
            FROM   "lap_positions" curr
            JOIN   "lap_positions" prev
                   ON curr."race_id"  = prev."race_id"
                  AND curr."driver_id"= prev."driver_id"
                  AND curr."lap"      = prev."lap" + 1
            WHERE  curr."race_id" = 1
              AND  curr."lap" BETWEEN 1 AND 5
       )
       SELECT COALESCE(SUM(CASE WHEN delta > 0 THEN delta ELSE 0 END),0) AS val
       FROM   pc
)
SELECT (SELECT val FROM start_overtakes)                              AS "Start-related",
       (SELECT val FROM pit_overtakes)                                AS "Pit-stop",
       (SELECT val FROM retirement_overtakes)                         AS "Retirement",
       ( (SELECT val FROM total_changes)
         - (SELECT val FROM start_overtakes)
         - (SELECT val FROM pit_overtakes)
         - (SELECT val FROM retirement_overtakes) )                   AS "Standard on-track"
Answer:
Start-related,Pit-stop,Retirement,Standard on-track
39,0,0,6
