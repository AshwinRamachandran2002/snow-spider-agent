-- 3) Description:  Compare grid position (lap-0) with lap-1 position for each driver.
--    A positive value in “positions_gained_on_start” is an overtake made
--    immediately after the start signal.
SELECT  lp0."driver_id",
        lp0."position" AS "grid_position",
        lp1."position" AS "lap1_position",
        (lp0."position" - lp1."position") AS "positions_gained_on_start"
FROM    "lap_positions" AS lp0
JOIN    "lap_positions" AS lp1
          ON lp0."race_id" = lp1."race_id"
         AND lp0."driver_id" = lp1."driver_id"
WHERE   lp0."race_id" = 1
  AND   lp0."lap"  = 0
  AND   lp1."lap"  = 1
ORDER BY "positions_gained_on_start" DESC
LIMIT   20;
