```sql
--Description:  Calculate how many positions other cars gained when a driver
--              made a pit-stop in laps 1-5 of race 1.  
--              1) early_pits finds all such stops (could be empty).
--              2) deltas compares each pitting driver’s position on the lap before
--                 the stop with the position on the pit lap; a positive difference
--                 equals the number of cars that overtook that driver.
--              3) The outer SELECT sums those positive differences and returns 0
--                 if no qualifying pit-stops exist.
WITH early_pits AS (
    SELECT "driver_id",
           "lap"
    FROM   "pit_stops"
    WHERE  "race_id" = 1
      AND  "lap" BETWEEN 1 AND 5
    GROUP  BY "driver_id", "lap"
),
deltas AS (
    SELECT (after."position" - before."position") AS gained_by_others
    FROM   early_pits ep
    JOIN   "lap_positions" before
           ON before."race_id"  = 1
          AND before."driver_id"= ep."driver_id"
          AND before."lap"      = ep."lap" - 1
    JOIN   "lap_positions" after
           ON after."race_id"   = 1
          AND after."driver_id" = ep."driver_id"
          AND after."lap"       = ep."lap"
)
SELECT COALESCE(
         SUM( CASE WHEN gained_by_others > 0 THEN gained_by_others ELSE 0 END ),
         0
       ) AS "pit_stop_overtakes"
FROM   deltas;
