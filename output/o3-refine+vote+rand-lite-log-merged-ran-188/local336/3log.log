```sql
--Description: 6) Robustly compute the number of places gained (“overtakes”) that other cars
--              achieve when someone pits in laps 1-5 of race 1.  
--              If no such pit-stops exist the query still returns a single row with 0.
WITH early_pits AS (
    SELECT "driver_id",
           "lap"                        -- lap on which the stop occurs
    FROM   "pit_stops"
    WHERE  "race_id" = 1
      AND  "lap" BETWEEN 1 AND 5
    GROUP  BY "driver_id", "lap"
),
deltas AS (
    SELECT (after."position" - before."position") AS gained_by_others
    FROM   early_pits  ep
    JOIN   "lap_positions" before
           ON before."race_id"  = 1
          AND before."driver_id"= ep."driver_id"
          AND before."lap"      = ep."lap" - 1       -- lap before the stop
    JOIN   "lap_positions" after
           ON after."race_id"   = 1
          AND after."driver_id" = ep."driver_id"
          AND after."lap"       = ep."lap"           -- lap of the stop
)
SELECT COALESCE(
         SUM( CASE WHEN gained_by_others > 0 THEN gained_by_others ELSE 0 END )
       ,0) AS "pit_stop_overtakes";
```

```sql
--Description: 7) Return a safe, single-row count of retirement events that occurred
--              inside the first five laps of race 1 (returns 0 if none).
SELECT COUNT(*) AS "early_retirement_events"
FROM   "retirements"
WHERE  "race_id" = 1
  AND  "lap" BETWEEN 1 AND 5;
```

```sql
--Description: 8) Calculate how many positions were gained because of those
--              early-lap retirements in race 1.  
--              The COALESCE ensures a “0” row is always produced even if no retirements exist.
WITH early_ret AS (
    SELECT "driver_id", "lap"
    FROM   "retirements"
    WHERE  "race_id" = 1
      AND  "lap" BETWEEN 1 AND 5
),
gains AS (
    SELECT
        ( SELECT COUNT(*)
          FROM   "lap_positions" lp
          WHERE  lp."race_id" = 1
            AND  lp."lap"     = er."lap"
            AND  lp."position" >
                 ( SELECT lp2."position"
                   FROM   "lap_positions" lp2
                   WHERE  lp2."race_id"  = 1
                     AND  lp2."driver_id"= er."driver_id"
                     AND  lp2."lap"      = er."lap") ) AS gained_places
    FROM   early_ret er
)
SELECT COALESCE(SUM(gained_places),0) AS "retirement_overtakes"
FROM   gains;
```

```sql
--Description: 9) Work out the number of “standard on-track” passes in laps 1-5 of race 1
--              by subtracting start-, pit- and retirement-related gains from the total
--              lap-by-lap position changes.  All sub-totals are wrapped with COALESCE so
--              the final arithmetic never yields NULL.
WITH position_changes AS (
       SELECT (prev."position" - curr."position") AS delta
       FROM   "lap_positions" curr
       JOIN   "lap_positions" prev
              ON curr."race_id"  = prev."race_id"
             AND curr."driver_id"= prev."driver_id"
             AND curr."lap"      = prev."lap" + 1
       WHERE  curr."race_id" = 1
         AND  curr."lap" BETWEEN 1 AND 5
), total_overtakes AS (
       SELECT COALESCE(SUM(CASE WHEN delta > 0 THEN delta ELSE 0 END),0) AS tot
       FROM   position_changes
), start_overtakes AS (
       SELECT COALESCE(
              SUM( CASE WHEN (lp0."position" - lp1."position") > 0 
                        THEN  lp0."position" - lp1."position" ELSE 0 END ),0) AS so
       FROM   "lap_positions" lp0
       JOIN   "lap_positions" lp1
              ON lp0."race_id" = lp1."race_id"
             AND lp0."driver_id" = lp1."driver_id"
       WHERE  lp0."race_id" = 1
         AND  lp0."lap" = 0
         AND  lp1."lap" = 1
), pit_overtakes AS (
       WITH early_pits AS (
            SELECT "driver_id","lap"
            FROM   "pit_stops"
            WHERE  "race_id" = 1
              AND  "lap" BETWEEN 1 AND 5
            GROUP  BY "driver_id","lap"
       ), diff AS (
            SELECT (after."position" - before."position") AS lost_to_others
            FROM   early_pits ep
            JOIN   "lap_positions" before
                   ON before."race_id" = 1
                  AND before."driver_id" = ep."driver_id"
                  AND before."lap" = ep."lap" - 1
            JOIN   "lap_positions" after
                   ON after."race_id" = 1
                  AND after."driver_id" = ep."driver_id"
                  AND after."lap" = ep."lap"
       )
       SELECT COALESCE(
              SUM( CASE WHEN lost_to_others > 0 THEN lost_to_others ELSE 0 END ),0) AS po
       FROM   diff
), ret_overtakes AS (
       WITH early_ret AS (
             SELECT "driver_id","lap"
             FROM   "retirements"
             WHERE  "race_id" = 1
               AND  "lap" BETWEEN 1 AND 5
       ), gain AS (
             SELECT ( SELECT COUNT(*)
                      FROM   "lap_positions" lp
                      WHERE  lp."race_id" = 1
                        AND  lp."lap"     = er."lap"
                        AND  lp."position" >
                             ( SELECT lp2."position"
                               FROM   "lap_positions" lp2
                               WHERE  lp2."race_id"  = 1
                                 AND  lp2."driver_id"= er."driver_id"
                                 AND  lp2."lap"      = er."lap") ) AS gained
             FROM   early_ret er
       )
       SELECT COALESCE(SUM(gained),0) AS ro
       FROM   gain
)
SELECT (SELECT tot FROM total_overtakes)
     - (SELECT so  FROM start_overtakes)
     - (SELECT po  FROM pit_overtakes)
     - (SELECT ro  FROM ret_overtakes) AS "standard_on_track_overtakes";
```

