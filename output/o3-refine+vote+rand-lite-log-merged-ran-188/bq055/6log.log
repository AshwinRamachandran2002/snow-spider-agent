Query:
--Description: 2) Distinct 2021 BLS ‘Information’-sector records to see wording of technology-related rows
SELECT DISTINCT sector, subsector, industry_group, industry
FROM `bigquery-public-data.bls.cpsaat18`
WHERE year = 2021 AND sector LIKE '%Information%'
LIMIT 20;
