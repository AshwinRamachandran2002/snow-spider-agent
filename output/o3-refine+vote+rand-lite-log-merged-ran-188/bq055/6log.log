  SELECT 'Asian'            AS race, ABS(g.google_asian   - b.bls_asian ) AS pct_diff UNION ALL
  SELECT 'Hispanic/Latinx'  AS race, ABS(g.google_hispanic- b.bls_hispanic) AS pct_diff
  FROM google g CROSS JOIN bls b
)
