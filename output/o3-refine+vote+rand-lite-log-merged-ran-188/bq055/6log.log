```sql
--Description:  One-shot query to find the three races with the largest percentage-point
--gap between Google’s 2021 overall U.S. hiring (google_dei table) and the 2021 BLS
--tech-sector average (CPSAAT18 rows whose descriptors contain “internet”, “software”,
--“processing/hosting”, or “computer systems design”).  We build two CTEs—google and bls—
--then CROSS JOIN them, calculate absolute gaps for White, Black, Asian, and Hispanic/Latinx,
--and return the top three gaps.
WITH google AS (
  SELECT
    race_white           AS g_white,
    race_black           AS g_black,
    race_asian           AS g_asian,
    race_hispanic_latinx AS g_hispanic
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_hiring`
  WHERE workforce = 'overall'
    AND report_year = 2021
),
bls AS (
  SELECT
    AVG(percent_white)                     AS b_white,
    AVG(percent_black_or_african_american) AS b_black,
    AVG(percent_asian)                     AS b_asian,
    AVG(percent_hispanic_or_latino)        AS b_hispanic
  FROM `bigquery-public-data.bls.cpsaat18`
  WHERE year = 2021
    AND (
          LOWER(industry)       LIKE '%internet%'            OR
          LOWER(industry)       LIKE '%software%'            OR
          LOWER(industry)       LIKE '%processing%'          OR
          LOWER(industry)       LIKE '%hosting%'             OR
          LOWER(industry_group) LIKE '%computer systems design%'
        )
)
SELECT race, pct_diff
FROM (
  SELECT 'White'            AS race, ABS(g_white    - b_white   ) AS pct_diff FROM google CROSS JOIN bls UNION ALL
  SELECT 'Black'            AS race, ABS(g_black    - b_black   )              FROM google CROSS JOIN bls UNION ALL
  SELECT 'Asian'            AS race, ABS(g_asian    - b_asian   )              FROM google CROSS JOIN bls UNION ALL
  SELECT 'Hispanic/Latinx'  AS race, ABS(g_hispanic - b_hispanic)              FROM google CROSS JOIN bls
)
ORDER BY pct_diff DESC
LIMIT 3;
```
