FROM google, bls
UNION ALL
SELECT 'White', google_white, bls_white, ABS(google_white - bls_white)
FROM google, bls
UNION ALL
SELECT 'Black', google_black, bls_black, ABS(google_black - bls_black)
FROM google, bls
ORDER BY pct_diff DESC
LIMIT 3;
