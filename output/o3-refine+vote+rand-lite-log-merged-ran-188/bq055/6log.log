Query:
--Description: 4) Retrieve 2021 BLS CPS rows that mention “software” (captures “Software publishers” and any similar wording)
SELECT *
FROM `bigquery-public-data.bls.cpsaat18`
WHERE year = 2021
  AND (
        LOWER(industry)       LIKE '%software%'       OR
        LOWER(industry_group) LIKE '%software%'       OR
        LOWER(subsector)      LIKE '%software%'
      )
