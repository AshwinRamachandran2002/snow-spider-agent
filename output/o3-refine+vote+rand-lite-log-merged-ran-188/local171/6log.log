```sql
-- 1. Description:  Quickly check the two–letter state codes recorded in legislators_terms to be sure “LA” is present.
SELECT DISTINCT state
FROM legislators_terms
LIMIT 20;
```

```sql
-- 2. Description:  See what gender codes are used in legislators (we expect “M” for male).
SELECT DISTINCT gender
FROM legislators
LIMIT 20;
```

```sql
-- 3. Description:  List the BioGuide IDs of male legislators whose home-state in at least one term is Louisiana.
SELECT DISTINCT l.id_bioguide
FROM legislators            AS l
JOIN legislators_terms      AS t ON l.id_bioguide = t.id_bioguide
WHERE l.gender = 'M'
  AND t.state  = 'LA'
LIMIT 20;
```

```sql
-- 4. Description:  For those male Louisiana legislators, show every term with its start and end dates.
SELECT DISTINCT t.id_bioguide,
       t.term_start,
       t.term_end
FROM legislators_terms AS t
JOIN legislators       AS l ON l.id_bioguide = t.id_bioguide
WHERE l.gender = 'M'
  AND t.state  = 'LA'
LIMIT 20;
```

```sql
-- 5. Description:  Obtain each legislator’s FIRST term_start date (earliest) – this will be used to measure service length.
SELECT DISTINCT t.id_bioguide,
       MIN(t.term_start) AS first_term_start
FROM legislators_terms AS t
JOIN legislators       AS l ON l.id_bioguide = t.id_bioguide
WHERE l.gender = 'M'
  AND t.state  = 'LA'
GROUP BY t.id_bioguide
LIMIT 20;
```

```sql
-- 6. Description:  Grab all rows in legislation_date_dim that are December 31 (one row per year).
SELECT DISTINCT date
FROM legislation_date_dim
WHERE month_name   = 'December'
  AND day_of_month = 31
LIMIT 20;
```

```sql
-- 7. Description:  Combine the December 31 dates with every term to know whether the legislator was “in office” on that day.
SELECT DISTINCT t.id_bioguide,
       d.date
FROM legislators_terms      AS t
JOIN legislators            AS l ON l.id_bioguide = t.id_bioguide
JOIN legislation_date_dim   AS d ON d.date BETWEEN t.term_start AND t.term_end
WHERE l.gender = 'M'
  AND t.state  = 'LA'
  AND d.month_name = 'December'
  AND d.day_of_month = 31
LIMIT 20;
```

```sql
-- 8. Description:  Attach each legislator’s first_term_start to the December 31 rows to compute years elapsed.
SELECT DISTINCT a.id_bioguide,
       a.date                           AS dec31_date,
       f.first_term_start,
       CAST(substr(a.date,1,4) AS INT) -
       CAST(substr(f.first_term_start,1,4) AS INT) AS years_elapsed
FROM (
    /* December 31s on which the legislator was serving */
    SELECT t.id_bioguide, d.date
    FROM legislators_terms      AS t
    JOIN legislators            AS l ON l.id_bioguide = t.id_bioguide
    JOIN legislation_date_dim   AS d ON d.date BETWEEN t.term_start AND t.term_end
    WHERE l.gender = 'M'
      AND t.state  = 'LA'
      AND d.month_name = 'December'
      AND d.day_of_month = 31
) AS a
JOIN (
    /* first term for each legislator */
    SELECT t.id_bioguide, MIN(t.term_start) AS first_term_start
    FROM legislators_terms AS t
    JOIN legislators       AS l ON l.id_bioguide = t.id_bioguide
    WHERE l.gender = 'M'
      AND t.state  = 'LA'
    GROUP BY t.id_bioguide
) AS f ON a.id_bioguide = f.id_bioguide
LIMIT 20;
```

```sql
-- 9. Description:  Keep only those December 31 dates that are >30 and <50 full years after the first term.
SELECT DISTINCT id_bioguide,
       dec31_date,
       years_elapsed
FROM (
    /* result from the previous step */
    SELECT a.id_bioguide,
           a.dec31_date,
           a.years_elapsed
    FROM (
        SELECT DISTINCT a.id_bioguide,
               a.date                           AS dec31_date,
               f.first_term_start,
               CAST(substr(a.date,1,4) AS INT) -
               CAST(substr(f.first_term_start,1,4) AS INT) AS years_elapsed
        FROM (
            SELECT t.id_bioguide, d.date
            FROM legislators_terms      AS t
            JOIN legislators            AS l ON l.id_bioguide = t.id_bioguide
            JOIN legislation_date_dim   AS d ON d.date BETWEEN t.term_start AND t.term_end
            WHERE l.gender = 'M'
              AND t.state  = 'LA'
              AND d.month_name = 'December'
              AND d.day_of_month = 31
        ) AS a
        JOIN (
            SELECT t.id_bioguide, MIN(t.term_start) AS first_term_start
            FROM legislators_terms AS t
            JOIN legislators       AS l ON l.id_bioguide = t.id_bioguide
            WHERE l.gender = 'M'
              AND t.state  = 'LA'
            GROUP BY t.id_bioguide
        ) AS f ON a.id_bioguide = f.id_bioguide
    ) AS a
    WHERE years_elapsed > 30
      AND years_elapsed < 50
) AS q
LIMIT 20;
```

```sql
-- 10. Description:  FINAL ANSWER – for male Louisiana legislators, count distinct legislators active on Dec 31 of each year whose
--                   service is >30 and <50 years from their first term, grouping by the exact years-elapsed value.
SELECT q.years_elapsed,
       COUNT(DISTINCT q.id_bioguide) AS legislators_active
FROM (
    /* Step 8 logic with the >30 & <50 filter applied */
    SELECT a.id_bioguide,
           CAST(substr(a.date,1,4) AS INT) -
           CAST(substr(f.first_term_start,1,4) AS INT) AS years_elapsed
    FROM (
        SELECT t.id_bioguide, d.date
        FROM legislators_terms      AS t
        JOIN legislators            AS l ON l.id_bioguide = t.id_bioguide
        JOIN legislation_date_dim   AS d ON d.date BETWEEN t.term_start AND t.term_end
        WHERE l.gender = 'M'
          AND t.state  = 'LA'
          AND d.month_name = 'December'
          AND d.day_of_month = 31
    ) AS a
    JOIN (
        SELECT t.id_bioguide,
               MIN(t.term_start) AS first_term_start
        FROM legislators_terms AS t
        JOIN legislators       AS l ON l.id_bioguide = t.id_bioguide
        WHERE l.gender = 'M'
          AND t.state  = 'LA'
        GROUP BY t.id_bioguide
    ) AS f ON a.id_bioguide = f.id_bioguide
    WHERE (CAST(substr(a.date,1,4) AS INT) -
           CAST(substr(f.first_term_start,1,4) AS INT)) > 30
      AND (CAST(substr(a.date,1,4) AS INT) -
           CAST(substr(f.first_term_start,1,4) AS INT)) < 50
) AS q
GROUP BY q.years_elapsed
ORDER BY q.years_elapsed;
```
