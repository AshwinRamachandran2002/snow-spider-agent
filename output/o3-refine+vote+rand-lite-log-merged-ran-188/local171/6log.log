    JOIN (
        SELECT t.id_bioguide,
               MIN(t.term_start) AS first_term_start
        FROM legislators_terms AS t
        JOIN legislators       AS l ON l.id_bioguide = t.id_bioguide
        WHERE l.gender = 'M'
          AND t.state  = 'LA'
        GROUP BY t.id_bioguide
    ) AS f ON a.id_bioguide = f.id_bioguide
    WHERE (CAST(substr(a.date,1,4) AS INT) -
           CAST(substr(f.first_term_start,1,4) AS INT)) > 30
      AND (CAST(substr(a.date,1,4) AS INT) -
           CAST(substr(f.first_term_start,1,4) AS INT)) < 50
) AS q
GROUP BY q.years_elapsed
ORDER BY q.years_elapsed;
