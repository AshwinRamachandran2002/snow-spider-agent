```sql
--Description: Determine, for every male legislator who has ever represented Louisiana,
--             whether he was still in office on 31 December of each calendar year that lies
--             strictly more than 30 but less than 50 years after his very first recorded
--             term began.  The query proceeds in four steps:
--               1. la_males   – collects BioGuide IDs of all male legislators with at least
--                               one Louisiana term.
--               2. first_term – finds the first calendar year (YYYY) each of those legislators
--                               entered Congress.
--               3. span_years – recursively generates every “candidate” year Y such that
--                               first_year + 31 ≤ Y ≤ first_year + 49 and annotates each with
--                               yrs_elapsed = Y − first_year.
--               4. active     – keeps only those (legislator, yrs_elapsed) pairs whose
--                               31-Dec-Y falls inside a term the legislator was actually
--                               serving.  Finally we count, for every yrs_elapsed bucket, how
--                               many distinct legislators meet the condition.  The output
--                               answers: “For each elapsed-year value (31 … 49), how many
--                               male Louisiana legislators were active on 31 December of at
--                               least one such year?”
WITH la_males AS (
    SELECT DISTINCT l.id_bioguide
    FROM legislators        AS l
    JOIN legislators_terms  AS t  ON t.id_bioguide = l.id_bioguide
    WHERE l.gender = 'M'
      AND t.state  = 'LA'
),
first_term AS (
    SELECT t.id_bioguide,
           MIN(CAST(SUBSTR(t.term_start,1,4) AS INTEGER)) AS first_year
    FROM legislators_terms AS t
    JOIN la_males         AS m ON m.id_bioguide = t.id_bioguide
    GROUP BY t.id_bioguide
),
span_years(id_bioguide, yr, yrs_elapsed) AS (
    SELECT id_bioguide,
           first_year + 31 AS yr,
           31              AS yrs_elapsed
    FROM first_term
    UNION ALL
    SELECT id_bioguide,
           yr + 1,
           yrs_elapsed + 1
    FROM span_years
    WHERE yrs_elapsed + 1 < 50          -- stop after 49 years elapsed
),
active AS (
    SELECT s.id_bioguide,
           s.yrs_elapsed
    FROM span_years        AS s
    JOIN legislators_terms AS t
         ON t.id_bioguide = s.id_bioguide
        AND DATE(s.yr || '-12-31') BETWEEN DATE(t.term_start) AND DATE(t.term_end)
)
SELECT yrs_elapsed                    AS years_since_first_term,
       COUNT(DISTINCT id_bioguide)    AS active_legislators
FROM active
GROUP BY yrs_elapsed
ORDER BY yrs_elapsed;
```
