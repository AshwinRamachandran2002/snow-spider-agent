```sql
-- 3.  List the BioGuide IDs & names of male legislators that have ever represented Louisiana
SELECT DISTINCT l.id_bioguide,
       l.full_name
FROM legislators            AS l
JOIN legislators_terms      AS t
      ON l.id_bioguide = t.id_bioguide
WHERE l.gender = 'M'
  AND t.state  = 'LA'
LIMIT 20;
```

```sql
-- 4.  Show all terms for those Louisiana males so we can see start / end dates
SELECT t.id_bioguide,
       t.term_number,
       t.term_start,
       t.term_end
FROM legislators_terms AS t
WHERE t.id_bioguide IN (
        SELECT l.id_bioguide
        FROM legislators AS l
        JOIN legislators_terms AS tt
          ON l.id_bioguide = tt.id_bioguide
        WHERE l.gender = 'M'
          AND tt.state = 'LA')
ORDER BY t.id_bioguide, t.term_start
LIMIT 20;
```

```sql
-- 5.  Calculate the first year each of those legislators entered office
SELECT t.id_bioguide,
       MIN(substr(t.term_start,1,4)) AS first_term_year
FROM legislators_terms AS t
JOIN legislators         AS l
  ON l.id_bioguide = t.id_bioguide
WHERE l.gender = 'M'
  AND t.state  = 'LA'
GROUP BY t.id_bioguide
LIMIT 20;
```

```sql
-- 6.  Produce, for one sample legislator, all years from (first_year+31) through (first_year+49)
--     just to confirm the recursive-year logic works (example uses first row only)
WITH first AS (
  SELECT t.id_bioguide,
         MIN(substr(t.term_start,1,4)*1) AS fy
  FROM legislators_terms AS t
  JOIN legislators AS l ON l.id_bioguide = t.id_bioguide
  WHERE l.gender='M' AND t.state='LA'
  GROUP BY t.id_bioguide
  LIMIT 1
),
yrs(id_bioguide, yr, yrs_elapsed) AS (
  SELECT id_bioguide, fy+31, 31 FROM first
  UNION ALL
  SELECT id_bioguide, yr+1, yrs_elapsed+1
  FROM yrs
  WHERE yrs_elapsed+1 < 50
)
SELECT * FROM yrs LIMIT 20;
```

```sql
-- 7.  For the same sample legislator, keep only those “years” where 31 ≤ elapsed < 50
--     and December 31 actually falls inside one of their terms
WITH first AS (
  SELECT t.id_bioguide,
         MIN(substr(t.term_start,1,4)*1) AS fy
  FROM legislators_terms AS t
  JOIN legislators AS l ON l.id_bioguide = t.id_bioguide
  WHERE l.gender='M' AND t.state='LA'
  GROUP BY t.id_bioguide
  LIMIT 1
),
yrs(id_bioguide, yr, yrs_elapsed) AS (
  SELECT id_bioguide, fy+31, 31 FROM first
  UNION ALL
  SELECT id_bioguide, yr+1, yrs_elapsed+1
  FROM yrs
  WHERE yrs_elapsed+1 < 50
)
SELECT y.id_bioguide,
       y.yr,
       y.yrs_elapsed
FROM yrs AS y
JOIN legislators_terms AS t
  ON t.id_bioguide = y.id_bioguide
 WHERE date(y.yr || '-12-31') BETWEEN date(t.term_start) AND date(t.term_end);
```

```sql
-- 8.  FINAL ANSWER:
--     How many distinct male legislators from Louisiana were actively serving on
--     December 31 more than 30 and less than 50 years after their very first term,
--     grouped by the exact number of years elapsed.
WITH la_males AS (
  SELECT DISTINCT l.id_bioguide, l.full_name
  FROM legislators        AS l
  JOIN legislators_terms  AS t
        ON l.id_bioguide = t.id_bioguide
  WHERE l.gender = 'M'
    AND t.state  = 'LA'
),
first_term AS (
  SELECT t.id_bioguide,
         MIN(substr(t.term_start,1,4)*1) AS first_year
  FROM legislators_terms AS t
  JOIN la_males          AS m ON m.id_bioguide = t.id_bioguide
  GROUP BY t.id_bioguide
),
years(id_bioguide, first_year, yr, yrs_elapsed) AS (
  SELECT ft.id_bioguide, ft.first_year, ft.first_year+31, 31
  FROM first_term AS ft
  UNION ALL
  SELECT id_bioguide, first_year, yr+1, yrs_elapsed+1
  FROM years
  WHERE yrs_elapsed+1 < 50
),
active_on_dec31 AS (
  SELECT y.id_bioguide,
         y.yrs_elapsed
  FROM years              AS y
  JOIN legislators_terms  AS t
       ON t.id_bioguide = y.id_bioguide
      AND date(y.yr || '-12-31') BETWEEN date(t.term_start) AND date(t.term_end)
)
SELECT yrs_elapsed                   AS years_since_first_term,
       COUNT(DISTINCT id_bioguide)   AS active_legislators
FROM active_on_dec31
GROUP BY yrs_elapsed
ORDER BY yrs_elapsed;
```
