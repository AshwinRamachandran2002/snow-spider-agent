-- 6.  Produce, for one sample legislator, all years from (first_year+31) through (first_year+49)
--     just to confirm the recursive-year logic works (example uses first row only)
WITH first AS (
  SELECT t.id_bioguide,
         MIN(substr(t.term_start,1,4)*1) AS fy
  FROM legislators_terms AS t
  JOIN legislators AS l ON l.id_bioguide = t.id_bioguide
  WHERE l.gender='M' AND t.state='LA'
  GROUP BY t.id_bioguide
  LIMIT 1
),
yrs(id_bioguide, yr, yrs_elapsed) AS (
  SELECT id_bioguide, fy+31, 31 FROM first
  UNION ALL
  SELECT id_bioguide, yr+1, yrs_elapsed+1
  FROM yrs
  WHERE yrs_elapsed+1 < 50
)
SELECT * FROM yrs LIMIT 20;
