```sql
--Description: “Final answer” query ­– counts, for each exact elapsed-year bucket (31-49),
--             how many distinct male legislators who have represented Louisiana were
--             actively in office on 31 December of at least one calendar year lying
--             that many years after their very first term began.  The CTE chain is the
--             same logic proven earlier (la_males → first_term → span_years → active).
WITH la_males AS (                       -- male legislators with any Louisiana service
    SELECT DISTINCT l.id_bioguide
    FROM legislators        AS l
    JOIN legislators_terms  AS t ON t.id_bioguide = l.id_bioguide
    WHERE l.gender = 'M'
      AND t.state  = 'LA'
),
first_term AS (                          -- first year each such legislator entered office
    SELECT t.id_bioguide,
           MIN(CAST(SUBSTR(t.term_start, 1, 4) AS INTEGER)) AS first_year
    FROM legislators_terms AS t
    JOIN la_males         AS m ON m.id_bioguide = t.id_bioguide
    GROUP BY t.id_bioguide
),
span_years(id_bioguide, yr, yrs_elapsed) AS (  -- generate candidate years (31-49 after first)
    SELECT id_bioguide,
           first_year + 31          AS yr,
           31                       AS yrs_elapsed
    FROM first_term
    UNION ALL
    SELECT id_bioguide,
           yr + 1,
           yrs_elapsed + 1
    FROM span_years
    WHERE yrs_elapsed + 1 < 50
),
active AS (                              -- retain only where 31-Dec-yr falls inside a term
    SELECT s.id_bioguide,
           s.yrs_elapsed
    FROM span_years        AS s
    JOIN legislators_terms AS t
         ON t.id_bioguide = s.id_bioguide
        AND DATE(s.yr || '-12-31') BETWEEN DATE(t.term_start) AND DATE(t.term_end)
)
SELECT yrs_elapsed                    AS years_since_first_term,
       COUNT(DISTINCT id_bioguide)    AS active_legislators
FROM active
GROUP BY yrs_elapsed
ORDER BY yrs_elapsed;
