```sql
-- Description: List male legislators whose terms are recorded as representing Louisiana (LA)
SELECT DISTINCT l."id_bioguide",
       l."full_name",
       lt."state"
FROM   "legislators"        AS l
JOIN   "legislators_terms"  AS lt
       ON l."id_bioguide" = lt."id_bioguide"
WHERE  lt."state" = 'LA'
  AND  l."gender" = 'M'
LIMIT 20;
```

```sql
-- Description: Retrieve each male Louisiana legislator’s first (earliest) term start date
SELECT l."id_bioguide",
       l."full_name",
       MIN(lt."term_start") AS "first_term_start"
FROM   "legislators"        AS l
JOIN   "legislators_terms"  AS lt
       ON l."id_bioguide" = lt."id_bioguide"
WHERE  lt."state" = 'LA'
  AND  l."gender" = 'M'
GROUP BY l."id_bioguide",
         l."full_name"
LIMIT 20;
```

```sql
-- Description: Show all terms (start & end dates) for those male Louisiana legislators
SELECT lt."id_bioguide",
       lt."term_start",
       lt."term_end"
FROM   "legislators_terms"  AS lt
JOIN   "legislators"        AS l
       ON lt."id_bioguide" = l."id_bioguide"
WHERE  lt."state" = 'LA'
  AND  l."gender" = 'M'
ORDER BY lt."id_bioguide",
         lt."term_start"
LIMIT 20;
```

```sql
-- Description: Check that legislation_date_dim really contains one row per calendar date; 
--              here we extract a few December-31 rows
SELECT "date",
       SUBSTR("date", 1, 4) AS "year"
FROM   "legislation_date_dim"
WHERE  "month_name" = 'December'
  AND  "day_of_month" = 31
LIMIT 20;
```

```sql
-- Description: For every December-31 date, find male Louisiana legislators whose term covered that day;
--              compute the exact years elapsed since their first term start
SELECT l."id_bioguide",
       l."full_name",
       dd."date"                                   AS "dec31_date",
       (CAST(SUBSTR(dd."date",1,4) AS INTEGER) -
        CAST(SUBSTR(ft."first_term_start",1,4) AS INTEGER)) AS "years_elapsed"
FROM  ( SELECT lt."id_bioguide",
               MIN(lt."term_start") AS "first_term_start"
        FROM   "legislators_terms"  AS lt
        JOIN   "legislators"        AS l
               ON l."id_bioguide" = lt."id_bioguide"
        WHERE  lt."state" = 'LA'
          AND  l."gender" = 'M'
        GROUP BY lt."id_bioguide"
      )                             AS ft
JOIN  "legislators"                 AS l
      ON l."id_bioguide" = ft."id_bioguide"
JOIN  "legislation_date_dim"        AS dd
      ON dd."month_name"  = 'December'
     AND dd."day_of_month" = 31
JOIN  "legislators_terms"           AS lt
      ON lt."id_bioguide" = l."id_bioguide"
     AND dd."date" BETWEEN lt."term_start" AND lt."term_end"
WHERE (CAST(SUBSTR(dd."date",1,4) AS INTEGER) -
       CAST(SUBSTR(ft."first_term_start",1,4) AS INTEGER)) > 30
  AND (CAST(SUBSTR(dd."date",1,4) AS INTEGER) -
       CAST(SUBSTR(ft."first_term_start",1,4) AS INTEGER)) < 50
LIMIT 20;
```

```sql
-- Description: Aggregate the previous result – how many distinct male LA legislators
--              were active on each December-31 that is 31-49 years after their first term
SELECT "years_elapsed",
       COUNT(DISTINCT "id_bioguide") AS "active_legislators"
FROM  (
        SELECT l."id_bioguide",
               (CAST(SUBSTR(dd."date",1,4) AS INTEGER) -
                CAST(SUBSTR(ft."first_term_start",1,4) AS INTEGER)) AS "years_elapsed"
        FROM  ( SELECT lt."id_bioguide",
                       MIN(lt."term_start") AS "first_term_start"
                FROM   "legislators_terms"  AS lt
                JOIN   "legislators"        AS l
                       ON l."id_bioguide" = lt."id_bioguide"
                WHERE  lt."state" = 'LA'
                  AND  l."gender" = 'M'
                GROUP BY lt."id_bioguide"
              )                             AS ft
        JOIN  "legislators"                 AS l
              ON l."id_bioguide" = ft."id_bioguide"
        JOIN  "legislation_date_dim"        AS dd
              ON dd."month_name"  = 'December'
             AND dd."day_of_month" = 31
        JOIN  "legislators_terms"           AS lt
              ON lt."id_bioguide" = l."id_bioguide"
             AND dd."date" BETWEEN lt."term_start" AND lt."term_end"
      )
GROUP BY "years_elapsed"
ORDER BY "years_elapsed"
LIMIT 20;
```

```sql
-- Description (Final Answer): Same aggregation without the LIMIT clause to show the full result set
