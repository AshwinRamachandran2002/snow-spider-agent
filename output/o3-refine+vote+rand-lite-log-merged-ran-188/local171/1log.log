```sql
-- 1. Look at the possible values recorded for a legislator’s gender
SELECT DISTINCT gender
FROM legislators
LIMIT 20;
```

```sql
-- 2. Inspect the two–letter state codes that appear in legislators’ terms
SELECT DISTINCT state
FROM legislators_terms
LIMIT 20;
```

```sql
-- 3. List male (“M”) legislators who have at least one term from Louisiana (“LA”)
SELECT DISTINCT l.id_bioguide,
                l.full_name
FROM legislators            AS l
JOIN legislators_terms      AS t  ON t.id_bioguide = l.id_bioguide
WHERE l.gender = 'M'
  AND t.state  = 'LA'
LIMIT 20;
```

```sql
-- 4. Display the individual Louisiana-male legislators’ term start & end dates
SELECT DISTINCT l.id_bioguide,
                t.term_number,
                t.term_start,
                t.term_end
FROM legislators            AS l
JOIN legislators_terms      AS t  ON t.id_bioguide = l.id_bioguide
WHERE l.gender = 'M'
  AND t.state  = 'LA'
ORDER BY l.id_bioguide,
         t.term_start
LIMIT 20;
```

```sql
-- 5. Find the very first term_start date for every male Louisiana legislator
SELECT l.id_bioguide,
       MIN(t.term_start) AS first_term_start
FROM legislators       AS l
JOIN legislators_terms AS t ON t.id_bioguide = l.id_bioguide
WHERE l.gender = 'M'
  AND t.state  = 'LA'
GROUP BY l.id_bioguide
LIMIT 20;
```

```sql
-- 6. Extract every December-31 date that exists in the calendar table
SELECT DISTINCT date
FROM legislation_date_dim
WHERE substr(date, 6, 5) = '12-31'
ORDER BY date
LIMIT 20;
```

```sql
-- 7. Match those Dec-31 dates to any Louisiana-male legislator’s active terms
SELECT DISTINCT m.id_bioguide,
                d.date            AS dec31_date,
                t.term_start,
                t.term_end
FROM (SELECT l.id_bioguide
      FROM legislators l
      JOIN legislators_terms t ON t.id_bioguide = l.id_bioguide
      WHERE l.gender = 'M'
        AND t.state  = 'LA')           AS m
JOIN legislators_terms      AS t  ON t.id_bioguide = m.id_bioguide
JOIN legislation_date_dim   AS d  ON d.date BETWEEN t.term_start AND t.term_end
WHERE substr(d.date, 6, 5) = '12-31'
ORDER BY m.id_bioguide,
         d.date
LIMIT 20;
```

```sql
-- 8. Calculate “years elapsed since FIRST term_start” for each such Dec-31 date
WITH first_start AS (
    SELECT l.id_bioguide,
           MIN(t.term_start) AS first_start
    FROM legislators l
    JOIN legislators_terms t ON t.id_bioguide = l.id_bioguide
    WHERE l.gender = 'M'
      AND t.state  = 'LA'
    GROUP BY l.id_bioguide
)
SELECT DISTINCT f.id_bioguide,
       d.date                       AS dec31_date,
       CAST(strftime('%Y', d.date) AS INTEGER)
         - CAST(strftime('%Y', f.first_start) AS INTEGER) AS years_elapsed
FROM first_start                AS f
JOIN legislators_terms          AS t  ON t.id_bioguide = f.id_bioguide
JOIN legislation_date_dim       AS d  ON d.date BETWEEN t.term_start AND t.term_end
WHERE substr(d.date, 6, 5) = '12-31'
ORDER BY f.id_bioguide,
         d.date
LIMIT 20;
```

```sql
-- 9. Keep only those December-31 anniversaries that are >30 and <50 years out
WITH first_start AS (
    SELECT l.id_bioguide,
           MIN(t.term_start) AS first_start
    FROM legislators l
    JOIN legislators_terms t ON t.id_bioguide = l.id_bioguide
    WHERE l.gender = 'M'
      AND t.state  = 'LA'
    GROUP BY l.id_bioguide
),
dec31s AS (
    SELECT date
    FROM legislation_date_dim
    WHERE substr(date, 6, 5) = '12-31'
)
SELECT DISTINCT f.id_bioguide,
       d.date                       AS dec31_date,
       CAST(strftime('%Y', d.date) AS INTEGER)
         - CAST(strftime('%Y', f.first_start) AS INTEGER) AS years_elapsed
FROM first_start          AS f
JOIN legislators_terms    AS t ON t.id_bioguide = f.id_bioguide
JOIN dec31s               AS d ON d.date BETWEEN t.term_start AND t.term_end
WHERE (CAST(strftime('%Y', d.date) AS INTEGER)
         - CAST(strftime('%Y', f.first_start) AS INTEGER)) > 30
  AND (CAST(strftime('%Y', d.date) AS INTEGER)
         - CAST(strftime('%Y', f.first_start) AS INTEGER)) < 50
ORDER BY years_elapsed,
         f.id_bioguide
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: group by exact years-elapsed and count distinct legislators
WITH male_la AS (
    SELECT l.id_bioguide,
           MIN(t.term_start) AS first_start
    FROM legislators l
    JOIN legislators_terms t ON t.id_bioguide = l.id_bioguide
    WHERE l.gender = 'M'
      AND t.state  = 'LA'
    GROUP BY l.id_bioguide
),
dec31s AS (
    SELECT date
    FROM legislation_date_dim
    WHERE substr(date, 6, 5) = '12-31'
),
active_dec31 AS (
    SELECT DISTINCT m.id_bioguide,
           d.date                        AS dec31_date,
           CAST(strftime('%Y', d.date) AS INTEGER)
             - CAST(strftime('%Y', m.first_start) AS INTEGER) AS years_elapsed
    FROM male_la               AS m
    JOIN legislators_terms     AS t ON t.id_bioguide = m.id_bioguide
    JOIN dec31s                AS d ON d.date BETWEEN t.term_start AND t.term_end
)
SELECT years_elapsed,
       COUNT(DISTINCT id_bioguide) AS distinct_legislators
FROM active_dec31
WHERE years_elapsed > 30
  AND years_elapsed < 50
GROUP BY years_elapsed
ORDER BY years_elapsed
LIMIT 20;
```
