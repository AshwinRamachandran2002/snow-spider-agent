-- 8. Calculate “years elapsed since FIRST term_start” for each such Dec-31 date
WITH first_start AS (
    SELECT l.id_bioguide,
           MIN(t.term_start) AS first_start
    FROM legislators l
    JOIN legislators_terms t ON t.id_bioguide = l.id_bioguide
    WHERE l.gender = 'M'
      AND t.state  = 'LA'
    GROUP BY l.id_bioguide
)
SELECT DISTINCT f.id_bioguide,
       d.date                       AS dec31_date,
       CAST(strftime('%Y', d.date) AS INTEGER)
         - CAST(strftime('%Y', f.first_start) AS INTEGER) AS years_elapsed
FROM first_start                AS f
JOIN legislators_terms          AS t  ON t.id_bioguide = f.id_bioguide
JOIN legislation_date_dim       AS d  ON d.date BETWEEN t.term_start AND t.term_end
WHERE substr(d.date, 6, 5) = '12-31'
ORDER BY f.id_bioguide,
         d.date
LIMIT 20;
