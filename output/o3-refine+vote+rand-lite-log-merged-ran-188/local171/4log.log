```sql
--Description: 1) See which state codes exist in the legislators_terms table
SELECT DISTINCT state 
FROM legislators_terms 
LIMIT 20;
```

```sql
--Description: 2) Check what gender codes are stored in the legislators table
SELECT DISTINCT gender 
FROM legislators 
LIMIT 20;
```

```sql
--Description: 3) List every male legislator (gender = 'M') that ever represented Louisiana (state = 'LA')
SELECT DISTINCT l.id_bioguide,
       l.full_name,
       l.gender,
       lt.state
FROM legislators            AS l
JOIN legislators_terms      AS lt
  ON l.id_bioguide = lt.id_bioguide
WHERE l.gender = 'M'
  AND lt.state = 'LA'
LIMIT 20;
```

```sql
--Description: 4) Show every congressional term for the male Louisiana legislators found above
SELECT lt.id_bioguide,
       lt.term_number,
       lt.term_start,
       lt.term_end
FROM legislators_terms AS lt
WHERE lt.id_bioguide IN (
      SELECT l.id_bioguide
      FROM legislators       AS l
      JOIN legislators_terms AS lt2
        ON l.id_bioguide = lt2.id_bioguide
      WHERE l.gender = 'M'
        AND lt2.state = 'LA'
)
ORDER BY lt.id_bioguide,
         lt.term_start
LIMIT 20;
```

```sql
--Description: 5) Determine the first-term starting year for every male Louisiana legislator
SELECT lt.id_bioguide,
       MIN( CAST(substr(lt.term_start,1,4) AS INTEGER) ) AS first_term_year
FROM legislators_terms AS lt
JOIN legislators        AS l
  ON l.id_bioguide = lt.id_bioguide
WHERE l.gender = 'M'
  AND lt.state = 'LA'
GROUP BY lt.id_bioguide
LIMIT 20;
```

```sql
--Description: 6) List all dates that fall on December 31 in the date dimension
SELECT date
FROM legislation_date_dim
WHERE month_name   = 'December'
  AND day_of_month = 31
LIMIT 20;
```

```sql
--Description: 7) For every male Louisiana legislator, link each 31-Dec date that falls inside one of their terms
SELECT lt.id_bioguide,
       d.date
FROM legislators_terms      AS lt
JOIN legislators            AS l  ON l.id_bioguide = lt.id_bioguide
JOIN legislation_date_dim   AS d  ON d.month_name = 'December'
                                   AND d.day_of_month = 31
WHERE l.gender = 'M'
  AND lt.state = 'LA'
  AND d.date BETWEEN lt.term_start AND lt.term_end
LIMIT 20;
```

```sql
--Description: 8) Add “years elapsed since first term” to every matched 31-Dec date
SELECT lt.id_bioguide,
       d.date,
       CAST(substr(d.date,1,4) AS INTEGER) -
       (SELECT MIN( CAST(substr(term_start,1,4) AS INTEGER) )
        FROM legislators_terms
        WHERE id_bioguide = lt.id_bioguide)            AS years_elapsed
FROM legislators_terms      AS lt
JOIN legislators            AS l  ON l.id_bioguide = lt.id_bioguide
JOIN legislation_date_dim   AS d  ON d.month_name = 'December'
                                   AND d.day_of_month = 31
WHERE l.gender = 'M'
  AND lt.state = 'LA'
  AND d.date BETWEEN lt.term_start AND lt.term_end
LIMIT 20;
```

```sql
--Description: 9) Keep only the dates that are >30 and <50 years after each legislator’s first term start
SELECT id_bioguide,
       date,
       years_elapsed
FROM (
     SELECT lt.id_bioguide,
            d.date,
            CAST(substr(d.date,1,4) AS INTEGER) -
            (SELECT MIN( CAST(substr(term_start,1,4) AS INTEGER) )
             FROM legislators_terms
             WHERE id_bioguide = lt.id_bioguide)  AS years_elapsed
     FROM legislators_terms      AS lt
     JOIN legislators            AS l  ON l.id_bioguide = lt.id_bioguide
     JOIN legislation_date_dim   AS d  ON d.month_name = 'December'
                                        AND d.day_of_month = 31
     WHERE l.gender = 'M'
       AND lt.state = 'LA'
       AND d.date BETWEEN lt.term_start AND lt.term_end
)
WHERE years_elapsed > 30
  AND years_elapsed < 50
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – count distinct male Louisiana legislators active on each 31-Dec that is 31-49 years after their first term, grouped by the exact years elapsed
SELECT years_elapsed,
       COUNT(DISTINCT id_bioguide) AS num_legislators
FROM (
     SELECT lt.id_bioguide,
            CAST(substr(d.date,1,4) AS INTEGER) -
            (SELECT MIN( CAST(substr(term_start,1,4) AS INTEGER) )
             FROM legislators_terms
             WHERE id_bioguide = lt.id_bioguide)  AS years_elapsed
     FROM legislators_terms      AS lt
     JOIN legislators            AS l  ON l.id_bioguide = lt.id_bioguide
     JOIN legislation_date_dim   AS d  ON d.month_name = 'December'
                                        AND d.day_of_month = 31
     WHERE l.gender = 'M'
       AND lt.state = 'LA'
       AND d.date BETWEEN lt.term_start AND lt.term_end
)
WHERE years_elapsed > 30
  AND years_elapsed < 50
GROUP BY years_elapsed
ORDER BY years_elapsed
LIMIT 20;
```
