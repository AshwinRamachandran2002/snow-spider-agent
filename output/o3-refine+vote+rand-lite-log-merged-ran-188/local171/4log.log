--Description: 9) Keep only the dates that are >30 and <50 years after each legislator’s first term start
SELECT id_bioguide,
       date,
       years_elapsed
FROM (
     SELECT lt.id_bioguide,
            d.date,
            CAST(substr(d.date,1,4) AS INTEGER) -
            (SELECT MIN( CAST(substr(term_start,1,4) AS INTEGER) )
             FROM legislators_terms
             WHERE id_bioguide = lt.id_bioguide)  AS years_elapsed
     FROM legislators_terms      AS lt
     JOIN legislators            AS l  ON l.id_bioguide = lt.id_bioguide
     JOIN legislation_date_dim   AS d  ON d.month_name = 'December'
                                        AND d.day_of_month = 31
     WHERE l.gender = 'M'
       AND lt.state = 'LA'
       AND d.date BETWEEN lt.term_start AND lt.term_end
)
WHERE years_elapsed > 30
  AND years_elapsed < 50
LIMIT 20;
