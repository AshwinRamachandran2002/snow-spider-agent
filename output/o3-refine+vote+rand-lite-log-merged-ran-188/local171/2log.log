Query:
--Description: 7) Pair each male Louisiana legislator with every Dec-31 date that is 31–49 years after his first term
SELECT m."id_bioguide",
       d."date",
       CAST(substr(d."date",1,4) AS INTEGER)
       - CAST(m."first_year"      AS INTEGER) AS "years_elapsed"
FROM  (SELECT l."id_bioguide",
              MIN(substr(t."term_start",1,4)) AS "first_year"
       FROM   "legislators"       AS l
       JOIN   "legislators_terms" AS t
              ON l."id_bioguide" = t."id_bioguide"
       WHERE  l."gender" = 'M'
         AND  t."state"  = 'LA'
       GROUP  BY l."id_bioguide") AS m
JOIN  "legislation_date_dim" AS d
      ON CAST(substr(d."date",1,4) AS INTEGER)
         - CAST(m."first_year"      AS INTEGER)
         BETWEEN 31 AND 49
WHERE d."month_name"   = 'December'
  AND d."day_of_month" = 31
LIMIT 20;
