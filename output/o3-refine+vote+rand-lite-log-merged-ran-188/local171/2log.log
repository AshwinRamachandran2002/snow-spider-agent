Query:
--Description: 9) FINAL – count distinct active male Louisiana legislators on each Dec-31 that is >30 & <50 years after their first term, grouping by the exact years elapsed
WITH lu_male_la AS (
     SELECT l."id_bioguide",
            MIN(substr(t."term_start",1,4)) AS "first_year"
     FROM   "legislators"       AS l
     JOIN   "legislators_terms" AS t
            ON l."id_bioguide" = t."id_bioguide"
     WHERE  l."gender" = 'M'
       AND  t."state"  = 'LA'
     GROUP  BY l."id_bioguide"
),
dec31_dates AS (
     SELECT "date"
     FROM   "legislation_date_dim"
     WHERE  "month_name"   = 'December'
       AND  "day_of_month" = 31
),
eligible_dates AS (
     SELECT d."date",
            m."id_bioguide",
            CAST(substr(d."date",1,4) AS INTEGER)
            - CAST(m."first_year"      AS INTEGER) AS "years_elapsed"
     FROM   dec31_dates AS d
     JOIN   lu_male_la  AS m
     WHERE  years_elapsed > 30
       AND  years_elapsed < 50
),
active_legislators AS (
     SELECT e."years_elapsed",
            e."id_bioguide"
     FROM   eligible_dates        AS e
     JOIN   "legislators_terms"   AS t
            ON t."id_bioguide" = e."id_bioguide"
     WHERE  t."term_start" <= e."date"
       AND  t."term_end"   >= e."date"
)
SELECT   "years_elapsed",
         COUNT(DISTINCT "id_bioguide") AS "num_legislators"
FROM     active_legislators
GROUP BY "years_elapsed"
ORDER BY "years_elapsed"
LIMIT 20;
Answer:
years_elapsed,num_legislators
