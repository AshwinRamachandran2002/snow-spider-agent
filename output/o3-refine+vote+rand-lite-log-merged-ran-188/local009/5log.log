```sql
-- 3) Coordinates of every airport appearing in those Abakan–related flights
SELECT DISTINCT
       f.departure_airport AS airport_code,
       ad.coordinates
FROM   flights        AS f
JOIN   airports_data  AS ad  ON ad.airport_code = f.departure_airport
WHERE  f.departure_airport = 'ABA'
   OR  f.arrival_airport   = 'ABA'

UNION

SELECT DISTINCT
       f.arrival_airport   AS airport_code,
       ad.coordinates
FROM   flights        AS f
JOIN   airports_data  AS ad  ON ad.airport_code = f.arrival_airport
WHERE  f.departure_airport = 'ABA'
   OR  f.arrival_airport   = 'ABA'
LIMIT 20;
```

```sql
-- 4) Distances (in km) for every leg that involves Abakan
--    Haversine formula;  π taken as acos(-1)
SELECT
       f.flight_id,
       f.departure_airport,
       f.arrival_airport,
       ROUND( 6371 *
              ACOS(
                   SIN( (ad1.coordinates[1] * acos(-1) / 180) ) *
                   SIN( (ad2.coordinates[1] * acos(-1) / 180) ) +
                   COS( (ad1.coordinates[1] * acos(-1) / 180) ) *
                   COS( (ad2.coordinates[1] * acos(-1) / 180) ) *
                   COS( (ad2.coordinates[0] - ad1.coordinates[0]) * acos(-1) / 180 )
              ), 0)  AS distance_km
FROM   flights        AS f
JOIN   airports_data  AS ad1 ON ad1.airport_code = f.departure_airport
JOIN   airports_data  AS ad2 ON ad2.airport_code = f.arrival_airport
WHERE  f.departure_airport = 'ABA'
   OR  f.arrival_airport   = 'ABA'
LIMIT 20;
```

```sql
-- 5) The maximum (longest) distance among those Abakan routes
SELECT MAX(distance_km) AS longest_distance_km
FROM (
      SELECT
             ROUND( 6371 *
                    ACOS(
                         SIN( (ad1.coordinates[1] * acos(-1) / 180) ) *
                         SIN( (ad2.coordinates[1] * acos(-1) / 180) ) +
                         COS( (ad1.coordinates[1] * acos(-1) / 180) ) *
                         COS( (ad2.coordinates[1] * acos(-1) / 180) ) *
                         COS( (ad2.coordinates[0] - ad1.coordinates[0]) * acos(-1) / 180 )
                    ), 0)  AS distance_km
      FROM   flights        AS f
      JOIN   airports_data  AS ad1 ON ad1.airport_code = f.departure_airport
      JOIN   airports_data  AS ad2 ON ad2.airport_code = f.arrival_airport
      WHERE  f.departure_airport = 'ABA'
         OR  f.arrival_airport   = 'ABA'
) AS distances;
```
