```sql
--Description: Fix PostgreSQL-specific parts in all remaining queries so they work in SQLite.
--             (1) Query flights involving Abakan — unchanged (plain SQL).
--             (2) Pull coordinates of every airport in those flights; wrap the UNION and put
--                 LIMIT after the whole UNION so SQLite applies it to the combined set.
--             (3) Compute great-circle (Haversine) distances; SQLite lacks point-array syntax,
--                 so longitude/latitude are parsed from the “(lon,lat)” text using SUBSTR/INSTR,
--                 and radians are obtained via *π/180.  Uses a CTE for clarity.
--             (4) Find the maximum of those distances with the same parsing logic.
------------------------------------------------------------------------------------------------
-- 2) All flights where Abakan (airport_code = 'ABA') is the point of departure or arrival
SELECT DISTINCT
       flight_id,
       flight_no,
       departure_airport,
       arrival_airport,
       scheduled_departure,
       scheduled_arrival
FROM   flights
WHERE  departure_airport = 'ABA'
   OR  arrival_airport   = 'ABA'
LIMIT 20;

------------------------------------------------------------------------------------------------
-- 3) Coordinates of every airport appearing in those Abakan-related flights
SELECT * FROM (
        SELECT DISTINCT
               f.departure_airport AS airport_code,
               ad.coordinates
        FROM   flights        AS f
        JOIN   airports_data  AS ad  ON ad.airport_code = f.departure_airport
        WHERE  f.departure_airport = 'ABA'
           OR  f.arrival_airport   = 'ABA'
        UNION
        SELECT DISTINCT
               f.arrival_airport   AS airport_code,
               ad.coordinates
        FROM   flights        AS f
        JOIN   airports_data  AS ad  ON ad.airport_code = f.arrival_airport
        WHERE  f.departure_airport = 'ABA'
           OR  f.arrival_airport   = 'ABA'
) LIMIT 20;

------------------------------------------------------------------------------------------------
-- 4) Distances (in km) for every leg that involves Abakan
WITH coords AS (
     SELECT
            f.flight_id,
            f.departure_airport,
            f.arrival_airport,
            CAST(SUBSTR(ad1.coordinates, 2,
                        INSTR(ad1.coordinates, ',') - 2) AS REAL)               AS lon1,
            CAST(SUBSTR(ad1.coordinates,
                        INSTR(ad1.coordinates, ',') + 1,
                        INSTR(ad1.coordinates, ')') - INSTR(ad1.coordinates, ',') - 1)
                 AS REAL)                                                      AS lat1,
            CAST(SUBSTR(ad2.coordinates, 2,
                        INSTR(ad2.coordinates, ',') - 2) AS REAL)               AS lon2,
            CAST(SUBSTR(ad2.coordinates,
                        INSTR(ad2.coordinates, ',') + 1,
                        INSTR(ad2.coordinates, ')') - INSTR(ad2.coordinates, ',') - 1)
                 AS REAL)                                                      AS lat2
     FROM   flights AS f
     JOIN   airports_data AS ad1 ON ad1.airport_code = f.departure_airport
     JOIN   airports_data AS ad2 ON ad2.airport_code = f.arrival_airport
     WHERE  f.departure_airport = 'ABA'
        OR  f.arrival_airport   = 'ABA'
)
SELECT
       flight_id,
       departure_airport,
       arrival_airport,
       ROUND( 6371 *
              ACOS(
                   SIN(lat1 * 3.141592653589793 / 180.0) *
                   SIN(lat2 * 3.141592653589793 / 180.0) +
                   COS(lat1 * 3.141592653589793 / 180.0) *
                   COS(lat2 * 3.141592653589793 / 180.0) *
                   COS((lon2 - lon1) * 3.141592653589793 / 180.0)
              ), 0 ) AS distance_km
FROM   coords
LIMIT 20;

------------------------------------------------------------------------------------------------
-- 5) The maximum (longest) distance among those Abakan routes
WITH coords AS (
     SELECT
            CAST(SUBSTR(ad1.coordinates, 2,
                        INSTR(ad1.coordinates, ',') - 2) AS REAL)               AS lon1,
            CAST(SUBSTR(ad1.coordinates,
                        INSTR(ad1.coordinates, ',') + 1,
                        INSTR(ad1.coordinates, ')') - INSTR(ad1.coordinates, ',') - 1)
                 AS REAL)                                                      AS lat1,
            CAST(SUBSTR(ad2.coordinates, 2,
                        INSTR(ad2.coordinates, ',') - 2) AS REAL)               AS lon2,
            CAST(SUBSTR(ad2.coordinates,
                        INSTR(ad2.coordinates, ',') + 1,
                        INSTR(ad2.coordinates, ')') - INSTR(ad2.coordinates, ',') - 1)
                 AS REAL)                                                      AS lat2
     FROM   flights AS f
     JOIN   airports_data AS ad1 ON ad1.airport_code = f.departure_airport
     JOIN   airports_data AS ad2 ON ad2.airport_code = f.arrival_airport
     WHERE  f.departure_airport = 'ABA'
        OR  f.arrival_airport   = 'ABA'
), distances AS (
     SELECT ROUND( 6371 *
                  ACOS(
                       SIN(lat1 * 3.141592653589793 / 180.0) *
                       SIN(lat2 * 3.141592653589793 / 180.0) +
                       COS(lat1 * 3.141592653589793 / 180.0) *
                       COS(lat2 * 3.141592653589793 / 180.0) *
                       COS((lon2 - lon1) * 3.141592653589793 / 180.0)
                  ), 0) AS distance_km
     FROM   coords
)
SELECT MAX(distance_km) AS longest_distance_km
FROM   distances;
