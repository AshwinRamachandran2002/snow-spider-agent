```sql
--Description: Identify Abakan’s airport code dynamically, collect every flight that departs from or
--arrives at that code, compute the great-circle (Haversine) distance for each such flight using
--both airports’ coordinates, and finally return the maximum of these distances (rounded, km).  
WITH abakan AS (
    SELECT "airport_code"
    FROM   "airports_data"
    WHERE  lower(json_extract("city", '$.en')) LIKE '%abakan%'         -- Abakan airport(s)
), abakan_flights AS (
    SELECT f."flight_id",
           f."departure_airport",
           f."arrival_airport"
    FROM   "flights" f
    JOIN   abakan a
           ON  f."departure_airport" = a."airport_code"
            OR f."arrival_airport"   = a."airport_code"               -- flights involving Abakan
), distance_calc AS (
    SELECT f."flight_id",
           acos(
               sin(radians(dep."coordinates"[1])) * sin(radians(arr."coordinates"[1])) +
               cos(radians(dep."coordinates"[1])) * cos(radians(arr."coordinates"[1])) *
               cos(radians(arr."coordinates"[0] - dep."coordinates"[0]))
           ) * 6371 AS dist_km                                        -- Earth-radius 6371 km
    FROM   abakan_flights f
    JOIN   "airports_data" dep ON dep."airport_code" = f."departure_airport"
    JOIN   "airports_data" arr ON arr."airport_code" = f."arrival_airport"
)
SELECT ROUND(MAX(dist_km), 1) AS longest_abakan_route_km
FROM   distance_calc;
