--Description: bring in coordinates of both endpoints for every flight that involves Abakan
WITH abakan AS (
    SELECT airport_code
    FROM   airports_data
    WHERE  lower(json_extract(city,'$.en')) LIKE '%abakan%'
), flts AS (
    SELECT flight_id,
           departure_airport,
           arrival_airport
    FROM   flights
    WHERE  departure_airport IN (SELECT airport_code FROM abakan)
       OR  arrival_airport   IN (SELECT airport_code FROM abakan)
)
SELECT f.flight_id,
       dep.airport_code  AS dep_code,
       dep.coordinates   AS dep_point,
       arr.airport_code  AS arr_code,
       arr.coordinates   AS arr_point
FROM   flts AS f
JOIN   airports_data dep ON dep.airport_code = f.departure_airport
JOIN   airports_data arr ON arr.airport_code = f.arrival_airport
LIMIT 20
