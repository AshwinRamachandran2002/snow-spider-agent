--Description: calculate great-circle distance (Haversine) for each individual Abakan flight  
SELECT  f."flight_id",
        f."departure_airport",
        f."arrival_airport",
        ROUND(
          acos(
            sin(radians(dep."coordinates"[1])) * sin(radians(arr."coordinates"[1])) +
            cos(radians(dep."coordinates"[1])) * cos(radians(arr."coordinates"[1])) *
            cos(radians(arr."coordinates"[0] - dep."coordinates"[0]))
          ) * 6371,                 -- 6371 km = earth radius
        1) AS "distance_km"
FROM    "flights"        AS f
JOIN    "airports_data"  AS dep ON dep."airport_code" = f."departure_airport"
JOIN    "airports_data"  AS arr ON arr."airport_code" = f."arrival_airport"
WHERE   f."departure_airport" = 'ABA'
    OR  f."arrival_airport"   = 'ABA'
LIMIT 20;
