    SELECT airport_code
    FROM   airports_data
    WHERE  lower(json_extract(city,'$.en')) LIKE '%abakan%'
), flts AS (
    SELECT DISTINCT arrival_airport
    FROM   flights
    WHERE  departure_airport IN (SELECT airport_code FROM abakan)
)
SELECT arr.airport_code,
       CAST(substr(rc,1,instr(rc,',')-1) AS REAL) AS arr_lon,
       CAST(substr(rc,instr(rc,',')+1)   AS REAL) AS arr_lat
