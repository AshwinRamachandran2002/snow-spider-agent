```sql
--Description: ➊ Locate Abakan’s airport code via JSON city->'en'; ➋ gather every flight whose departure or
--   arrival matches that code; ➌ pull each endpoint’s coordinates (stored as the text '(lon,lat)');
--   strip parentheses, split on the comma to obtain numeric lon/lat; ➍ apply the Haversine formula
--   (Earth-radius = 6371 km) to compute distance for every such flight; ➎ return the maximum distance,
--   i.e. the longest route that either starts or ends in Abakan.
WITH abakan AS (
    SELECT airport_code
    FROM   airports_data
    WHERE  lower(json_extract(city,'$.en')) LIKE '%abakan%'
), flts AS (
    SELECT flight_id, departure_airport, arrival_airport
    FROM   flights
    WHERE  departure_airport IN (SELECT airport_code FROM abakan)
       OR  arrival_airport   IN (SELECT airport_code FROM abakan)
), coords AS (
    SELECT f.flight_id,
           dep.coordinates AS dep_c,
           arr.coordinates AS arr_c
    FROM   flts f
    JOIN   airports_data dep ON dep.airport_code = f.departure_airport
    JOIN   airports_data arr ON arr.airport_code = f.arrival_airport
), parsed AS (
    SELECT flight_id,
           CAST(substr(rdep,1,instr(rdep,',')-1) AS REAL) AS dep_lon,
           CAST(substr(rdep,instr(rdep,',')+1)         AS REAL) AS dep_lat,
           CAST(substr(rarr,1,instr(rarr,',')-1) AS REAL) AS arr_lon,
           CAST(substr(rarr,instr(rarr,',')+1)         AS REAL) AS arr_lat
    FROM (
        SELECT flight_id,
               replace(replace(dep_c,'(',''),')','') AS rdep,
               replace(replace(arr_c,'(',''),')','') AS rarr
        FROM   coords
    )
), dist AS (
    SELECT flight_id,
           6371 * acos(
               cos(dep_lat*0.017453292519943) * cos(arr_lat*0.017453292519943) *
               cos((arr_lon-dep_lon)*0.017453292519943) +
               sin(dep_lat*0.017453292519943) * sin(arr_lat*0.017453292519943)
           ) AS km
    FROM   parsed
)
SELECT ROUND(MAX(km),1) AS longest_abakan_route_km
FROM   dist;
```
