```sql
--Description: Inspect the artists table to understand available artist names and their IDs
SELECT DISTINCT "ArtistId", "Name"
FROM "artists"
LIMIT 20;
```

```sql
--Description: Calculate total sales (Quantity * UnitPrice) for every artist
SELECT ar."ArtistId",
       ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
FROM "invoice_items" AS ii
JOIN "tracks"  AS t  ON t."TrackId"  = ii."TrackId"
JOIN "albums"  AS al ON al."AlbumId"  = t."AlbumId"
JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
GROUP BY ar."ArtistId", ar."Name"
LIMIT 20;
```

```sql
--Description: Show the 20 highest-selling artists (for tie-breaking we’ll need alphabetical order later)
SELECT ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
FROM "invoice_items" AS ii
JOIN "tracks"  AS t  ON t."TrackId"  = ii."TrackId"
JOIN "albums"  AS al ON al."AlbumId"  = t."AlbumId"
JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
GROUP BY ar."Name"
ORDER BY "TotalSales" DESC, ar."Name" ASC
LIMIT 20;
```

```sql
--Description: Show the 20 lowest-selling artists (again ordered alphabetically for ties)
SELECT ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
FROM "invoice_items" AS ii
JOIN "tracks"  AS t  ON t."TrackId"  = ii."TrackId"
JOIN "albums"  AS al ON al."AlbumId"  = t."AlbumId"
JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
GROUP BY ar."Name"
ORDER BY "TotalSales" ASC, ar."Name" ASC
LIMIT 20;
```

```sql
--Description: Retrieve the single top-selling artist after applying the alphabetical tie-break
SELECT ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
FROM "invoice_items" AS ii
JOIN "tracks"  AS t  ON t."TrackId"  = ii."TrackId"
JOIN "albums"  AS al ON al."AlbumId"  = t."AlbumId"
JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
GROUP BY ar."Name"
ORDER BY "TotalSales" DESC, ar."Name" ASC
LIMIT 1;
```

```sql
--Description: Retrieve the single lowest-selling artist after applying the alphabetical tie-break
SELECT ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "TotalSales"
FROM "invoice_items" AS ii
JOIN "tracks"  AS t  ON t."TrackId"  = ii."TrackId"
JOIN "albums"  AS al ON al."AlbumId"  = t."AlbumId"
JOIN "artists" AS ar ON ar."ArtistId" = al."ArtistId"
GROUP BY ar."Name"
ORDER BY "TotalSales" ASC, ar."Name" ASC
LIMIT 1;
```

```sql
--Description: Amount each customer spent on the top-selling artist’s albums
SELECT c."CustomerId",
       c."FirstName" || ' ' || c."LastName" AS "CustomerName",
       SUM(ii."UnitPrice" * ii."Quantity") AS "SpendOnTopArtist"
FROM "invoice_items" AS ii
JOIN "invoices" AS inv ON inv."InvoiceId" = ii."InvoiceId"
JOIN "tracks"  AS t   ON t."TrackId"    = ii."TrackId"
JOIN "albums"  AS al  ON al."AlbumId"   = t."AlbumId"
JOIN "artists" AS ar  ON ar."ArtistId"  = al."ArtistId"
JOIN "customers" AS c ON c."CustomerId" = inv."CustomerId"
WHERE ar."Name" = (  /* sub-query gets top-selling artist */
       SELECT ar2."Name"
       FROM "invoice_items" AS ii2
       JOIN "tracks"  AS t2  ON t2."TrackId"  = ii2."TrackId"
       JOIN "albums"  AS al2 ON al2."AlbumId" = t2."AlbumId"
       JOIN "artists" AS ar2 ON ar2."ArtistId"= al2."ArtistId"
       GROUP BY ar2."Name"
       ORDER BY SUM(ii2."UnitPrice"*ii2."Quantity") DESC, ar2."Name" ASC
       LIMIT 1
)
GROUP BY c."CustomerId", "CustomerName"
ORDER BY "SpendOnTopArtist" DESC
LIMIT 20;
```

```sql
--Description: Amount each customer spent on the lowest-selling artist’s albums
SELECT c."CustomerId",
       c."FirstName" || ' ' || c."LastName" AS "CustomerName",
       SUM(ii."UnitPrice" * ii."Quantity") AS "SpendOnLowestArtist"
FROM "invoice_items" AS ii
JOIN "invoices" AS inv ON inv."InvoiceId" = ii."InvoiceId"
JOIN "tracks"  AS t   ON t."TrackId"    = ii."TrackId"
JOIN "albums"  AS al  ON al."AlbumId"   = t."AlbumId"
JOIN "artists" AS ar  ON ar."ArtistId"  = al."ArtistId"
JOIN "customers" AS c ON c."CustomerId" = inv."CustomerId"
WHERE ar."Name" = (  /* sub-query gets lowest-selling artist */
       SELECT ar2."Name"
       FROM "invoice_items" AS ii2
       JOIN "tracks"  AS t2  ON t2."TrackId"  = ii2."TrackId"
       JOIN "albums"  AS al2 ON al2."AlbumId" = t2."AlbumId"
       JOIN "artists" AS ar2 ON ar2."ArtistId"= al2."ArtistId"
       GROUP BY ar2."Name"
       ORDER BY SUM(ii2."UnitPrice"*ii2."Quantity") ASC, ar2."Name" ASC
       LIMIT 1
)
GROUP BY c."CustomerId", "CustomerName"
ORDER BY "SpendOnLowestArtist" DESC
LIMIT 20;
```

```sql
--Description: Average amount spent by customers who purchased the top-selling artist versus those who bought the lowest-selling artist
SELECT
  (SELECT AVG("SpendOnTopArtist")
   FROM (
       SELECT inv."CustomerId",
              SUM(ii."UnitPrice" * ii."Quantity") AS "SpendOnTopArtist"
       FROM "invoice_items" AS ii
       JOIN "invoices" AS inv ON inv."InvoiceId" = ii."InvoiceId"
       JOIN "tracks"  AS t   ON t."TrackId"    = ii."TrackId"
       JOIN "albums"  AS al  ON al."AlbumId"   = t."AlbumId"
       JOIN "artists" AS ar  ON ar."ArtistId"  = al."ArtistId"
       WHERE ar."Name" = (
            SELECT ar2."Name"
            FROM "invoice_items" AS ii2
            JOIN "tracks"  AS t2  ON t2."TrackId"  = ii2."TrackId"
            JOIN "albums"  AS al2 ON al2."AlbumId" = t2."AlbumId"
            JOIN "artists" AS ar2 ON ar2."ArtistId"= al2."ArtistId"
            GROUP BY ar2."Name"
            ORDER BY SUM(ii2."UnitPrice"*ii2."Quantity") DESC, ar2."Name" ASC
            LIMIT 1
       )
       GROUP BY inv."CustomerId"
   )) AS "AvgSpendOnTopArtist",

  (SELECT AVG("SpendOnLowestArtist")
   FROM (
       SELECT inv."CustomerId",
              SUM(ii."UnitPrice" * ii."Quantity") AS "SpendOnLowestArtist"
       FROM "invoice_items" AS ii
       JOIN "invoices" AS inv ON inv."InvoiceId" = ii."InvoiceId"
       JOIN "tracks"  AS t   ON t."TrackId"    = ii."TrackId"
       JOIN "albums"  AS al  ON al."AlbumId"   = t."AlbumId"
       JOIN "artists" AS ar  ON ar."ArtistId"  = al."ArtistId"
       WHERE ar."Name" = (
            SELECT ar2."Name"
            FROM "invoice_items" AS ii2
            JOIN "tracks"  AS t2  ON t2."TrackId"  = ii2."TrackId"
            JOIN "albums"  AS al2 ON al2."AlbumId" = t2."AlbumId"
            JOIN "artists" AS ar2 ON ar2."ArtistId"= al2."ArtistId"
            GROUP BY ar2."Name"
            ORDER BY SUM(ii2."UnitPrice"*ii2."Quantity") ASC, ar2."Name" ASC
            LIMIT 1
       )
       GROUP BY inv."CustomerId"
   )) AS "AvgSpendOnLowestArtist"
LIMIT 20;
```

```sql
--Description: Compute the absolute difference between the two customer-average spends obtained in the previous query
SELECT ABS( 
   (SELECT AVG("SpendOnTopArtist")
    FROM (
        SELECT inv."CustomerId",
               SUM(ii."UnitPrice" * ii."Quantity") AS "SpendOnTopArtist"
        FROM "invoice_items" AS ii
        JOIN "invoices" AS inv ON inv."InvoiceId" = ii."InvoiceId"
        JOIN "tracks"  AS t   ON t."TrackId"    = ii."TrackId"
        JOIN "albums"  AS al  ON al."AlbumId"   = t."AlbumId"
        JOIN "artists" AS ar  ON ar."ArtistId"  = al."ArtistId"
        WHERE ar."Name" = (
             SELECT ar2."Name"
             FROM "invoice_items" AS ii2
             JOIN "tracks"  AS t2  ON t2."TrackId"  = ii2."TrackId"
             JOIN "albums"  AS al2 ON al2."AlbumId" = t2."AlbumId"
             JOIN "artists" AS ar2 ON ar2."ArtistId"= al2."ArtistId"
             GROUP BY ar2."Name"
             ORDER BY SUM(ii2."UnitPrice"*ii2."Quantity") DESC, ar2."Name" ASC
             LIMIT 1
        )
        GROUP BY inv."CustomerId"
    ) )
 -
   (SELECT AVG("SpendOnLowestArtist")
    FROM (
        SELECT inv."CustomerId",
               SUM(ii."UnitPrice" * ii."Quantity") AS "SpendOnLowestArtist"
        FROM "invoice_items" AS ii
        JOIN "invoices" AS inv ON inv."InvoiceId" = ii."InvoiceId"
        JOIN "tracks"  AS t   ON t."TrackId"    = ii."TrackId"
        JOIN "albums"  AS al  ON al."AlbumId"   = t."AlbumId"
        JOIN "artists" AS ar  ON ar."ArtistId"  = al."ArtistId"
        WHERE ar."Name" = (
             SELECT ar2."Name"
             FROM "invoice_items" AS ii2
             JOIN "tracks"  AS t2  ON t2."TrackId"  = ii2."TrackId"
             JOIN "albums"  AS al2 ON al2."AlbumId" = t2."AlbumId"
             JOIN "artists" AS ar2 ON ar2."ArtistId"= al2."ArtistId"
             GROUP BY ar2."Name"
             ORDER BY SUM(ii2."UnitPrice"*ii2."Quantity") ASC, ar2."Name" ASC
             LIMIT 1
        )
        GROUP BY inv."CustomerId"
    ) )
) AS "AbsoluteDifferenceInAverages"
LIMIT 20;
```
