```sql
--Description: Show a few artist names to get oriented.
SELECT DISTINCT "Name"
FROM "artists"
LIMIT 20;
```

```sql
--Description: Total revenue for each artist; show the 20 highest-selling artists.
SELECT a."Name" AS ArtistName,
       SUM(ii."UnitPrice" * ii."Quantity") AS Revenue
FROM "artists"        AS a
JOIN "albums"         AS al ON al."ArtistId" = a."ArtistId"
JOIN "tracks"         AS t  ON t."AlbumId"  = al."AlbumId"
JOIN "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
GROUP BY a."ArtistId"
ORDER BY Revenue DESC, ArtistName ASC
LIMIT 20;
```

```sql
--Description: Total revenue for each artist; show the 20 lowest-selling (but non-zero) artists.
SELECT a."Name" AS ArtistName,
       SUM(ii."UnitPrice" * ii."Quantity") AS Revenue
FROM "artists"        AS a
JOIN "albums"         AS al ON al."ArtistId" = a."ArtistId"
JOIN "tracks"         AS t  ON t."AlbumId"  = al."AlbumId"
JOIN "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
GROUP BY a."ArtistId"
HAVING Revenue > 0
ORDER BY Revenue ASC, ArtistName ASC
LIMIT 20;
```

```sql
--Description: Identify the single top-selling artist (highest revenue, tie broken alphabetically).
SELECT a."ArtistId", a."Name"
FROM "artists"        AS a
JOIN "albums"         AS al ON al."ArtistId" = a."ArtistId"
JOIN "tracks"         AS t  ON t."AlbumId"  = al."AlbumId"
JOIN "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
GROUP BY a."ArtistId"
ORDER BY SUM(ii."UnitPrice"*ii."Quantity") DESC, a."Name" ASC
LIMIT 1;
```

```sql
--Description: Identify the single lowest-selling artist with at least one sale (tie broken alphabetically).
SELECT a."ArtistId", a."Name"
FROM "artists"        AS a
JOIN "albums"         AS al ON al."ArtistId" = a."ArtistId"
JOIN "tracks"         AS t  ON t."AlbumId"  = al."AlbumId"
JOIN "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
GROUP BY a."ArtistId"
ORDER BY SUM(ii."UnitPrice"*ii."Quantity") ASC, a."Name" ASC
LIMIT 1;
```

```sql
--Description: What every customer spent on the top-selling artist.
WITH top_artist AS (
  SELECT a."ArtistId"
  FROM "artists"        AS a
  JOIN "albums"         AS al ON al."ArtistId" = a."ArtistId"
  JOIN "tracks"         AS t  ON t."AlbumId"  = al."AlbumId"
  JOIN "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
  GROUP BY a."ArtistId"
  ORDER BY SUM(ii."UnitPrice"*ii."Quantity") DESC, a."Name" ASC
  LIMIT 1
)
SELECT c."CustomerId",
       c."FirstName" || ' ' || c."LastName" AS CustomerName,
       SUM(ii."UnitPrice"*ii."Quantity")    AS SpendOnTopArtist
FROM top_artist         AS ta
JOIN "albums"           AS al ON al."ArtistId" = ta."ArtistId"
JOIN "tracks"           AS t  ON t."AlbumId"  = al."AlbumId"
JOIN "invoice_items"    AS ii ON ii."TrackId" = t."TrackId"
JOIN "invoices"         AS i  ON i."InvoiceId" = ii."InvoiceId"
JOIN "customers"        AS c  ON c."CustomerId" = i."CustomerId"
GROUP BY c."CustomerId"
ORDER BY SpendOnTopArtist DESC
LIMIT 20;
```

```sql
--Description: What every customer spent on the lowest-selling artist.
WITH bottom_artist AS (
  SELECT a."ArtistId"
  FROM "artists"        AS a
  JOIN "albums"         AS al ON al."ArtistId" = a."ArtistId"
  JOIN "tracks"         AS t  ON t."AlbumId"  = al."AlbumId"
  JOIN "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
  GROUP BY a."ArtistId"
  HAVING SUM(ii."UnitPrice"*ii."Quantity") > 0
  ORDER BY SUM(ii."UnitPrice"*ii."Quantity") ASC, a."Name" ASC
  LIMIT 1
)
SELECT c."CustomerId",
       c."FirstName" || ' ' || c."LastName" AS CustomerName,
       SUM(ii."UnitPrice"*ii."Quantity")    AS SpendOnBottomArtist
FROM bottom_artist      AS ba
JOIN "albums"           AS al ON al."ArtistId" = ba."ArtistId"
JOIN "tracks"           AS t  ON t."AlbumId"  = al."AlbumId"
JOIN "invoice_items"    AS ii ON ii."TrackId" = t."TrackId"
JOIN "invoices"         AS i  ON i."InvoiceId" = ii."InvoiceId"
JOIN "customers"        AS c  ON c."CustomerId" = i."CustomerId"
GROUP BY c."CustomerId"
ORDER BY SpendOnBottomArtist DESC
LIMIT 20;
```

```sql
--Description: Average spending of customers who bought from the top-selling artist.
WITH top_artist AS (
  SELECT a."ArtistId"
  FROM "artists"        AS a
  JOIN "albums"         AS al ON al."ArtistId" = a."ArtistId"
  JOIN "tracks"         AS t  ON t."AlbumId"  = al."AlbumId"
  JOIN "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
  GROUP BY a."ArtistId"
  ORDER BY SUM(ii."UnitPrice"*ii."Quantity") DESC, a."Name" ASC
  LIMIT 1
),
cust_spend AS (
  SELECT c."CustomerId", SUM(ii."UnitPrice"*ii."Quantity") AS Spend
  FROM top_artist        AS ta
  JOIN "albums"          AS al ON al."ArtistId" = ta."ArtistId"
  JOIN "tracks"          AS t  ON t."AlbumId"  = al."AlbumId"
  JOIN "invoice_items"   AS ii ON ii."TrackId" = t."TrackId"
  JOIN "invoices"        AS i  ON i."InvoiceId" = ii."InvoiceId"
  JOIN "customers"       AS c  ON c."CustomerId" = i."CustomerId"
  GROUP BY c."CustomerId"
)
SELECT AVG(Spend) AS AvgTopArtistSpend
FROM cust_spend
LIMIT 20;
```

```sql
--Description: Compute averages for top and bottom artists and return their absolute difference.
WITH
top_artist AS (
  SELECT a."ArtistId"
  FROM "artists"       AS a
  JOIN "albums"        AS al ON al."ArtistId" = a."ArtistId"
  JOIN "tracks"        AS t  ON t."AlbumId"  = al."AlbumId"
  JOIN "invoice_items" AS ii ON ii."TrackId" = t."TrackId"
  GROUP BY a."ArtistId"
  ORDER BY SUM(ii."UnitPrice"*ii."Quantity") DESC, a."Name" ASC
  LIMIT 1
),
bottom_artist AS (
  SELECT a."ArtistId"
  FROM "artists"       AS a
  JOIN "albums"        AS al ON al."ArtistId" = a."ArtistId"
  JOIN "tracks"        AS t  ON t."AlbumId"  = al."AlbumId"
  JOIN "invoice_items" AS ii ON ii."TrackId" = t."TrackId"
  GROUP BY a."ArtistId"
  HAVING SUM(ii."UnitPrice"*ii."Quantity") > 0
  ORDER BY SUM(ii."UnitPrice"*ii."Quantity") ASC, a."Name" ASC
  LIMIT 1
),
top_spend AS (
  SELECT c."CustomerId", SUM(ii."UnitPrice"*ii."Quantity") AS Spend
  FROM top_artist       AS ta
  JOIN "albums"         AS al ON al."ArtistId" = ta."ArtistId"
  JOIN "tracks"         AS t  ON t."AlbumId"  = al."AlbumId"
  JOIN "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
  JOIN "invoices"       AS i  ON i."InvoiceId" = ii."InvoiceId"
  JOIN "customers"      AS c  ON c."CustomerId" = i."CustomerId"
  GROUP BY c."CustomerId"
),
bottom_spend AS (
  SELECT c."CustomerId", SUM(ii."UnitPrice"*ii."Quantity") AS Spend
  FROM bottom_artist    AS ba
  JOIN "albums"         AS al ON al."ArtistId" = ba."ArtistId"
  JOIN "tracks"         AS t  ON t."AlbumId"  = al."AlbumId"
  JOIN "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
  JOIN "invoices"       AS i  ON i."InvoiceId" = ii."InvoiceId"
  JOIN "customers"      AS c  ON c."CustomerId" = i."CustomerId"
  GROUP BY c."CustomerId"
)
SELECT ABS( (SELECT AVG(Spend) FROM top_spend) -
            (SELECT AVG(Spend) FROM bottom_spend) ) AS AbsoluteAverageDifference
LIMIT 20;
```
