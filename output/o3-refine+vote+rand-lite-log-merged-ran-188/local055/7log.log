Query:
--Description: What every customer spent on the top-selling artist.
WITH top_artist AS (
  SELECT a."ArtistId"
  FROM "artists"        AS a
  JOIN "albums"         AS al ON al."ArtistId" = a."ArtistId"
  JOIN "tracks"         AS t  ON t."AlbumId"  = al."AlbumId"
  JOIN "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
  GROUP BY a."ArtistId"
  ORDER BY SUM(ii."UnitPrice"*ii."Quantity") DESC, a."Name" ASC
  LIMIT 1
)
SELECT c."CustomerId",
       c."FirstName" || ' ' || c."LastName" AS CustomerName,
       SUM(ii."UnitPrice"*ii."Quantity")    AS SpendOnTopArtist
FROM top_artist         AS ta
JOIN "albums"           AS al ON al."ArtistId" = ta."ArtistId"
JOIN "tracks"           AS t  ON t."AlbumId"  = al."AlbumId"
JOIN "invoice_items"    AS ii ON ii."TrackId" = t."TrackId"
JOIN "invoices"         AS i  ON i."InvoiceId" = ii."InvoiceId"
JOIN "customers"        AS c  ON c."CustomerId" = i."CustomerId"
GROUP BY c."CustomerId"
ORDER BY SpendOnTopArtist DESC
LIMIT 20;
