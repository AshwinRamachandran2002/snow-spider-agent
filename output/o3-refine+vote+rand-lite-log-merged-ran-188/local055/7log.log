       SUM(ii."UnitPrice" * ii."Quantity") AS Revenue
FROM "artists"        AS a
JOIN "albums"         AS al ON al."ArtistId" = a."ArtistId"
JOIN "tracks"         AS t  ON t."AlbumId"  = al."AlbumId"
