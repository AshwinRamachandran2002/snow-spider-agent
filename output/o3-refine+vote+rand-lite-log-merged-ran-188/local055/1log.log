--Description: Average customer spending for the top-selling artist vs lowest-selling artist.
WITH artist_totals AS (
    SELECT artists."ArtistId",
           artists."Name",
           SUM(invoice_items."UnitPrice" * invoice_items."Quantity") AS total_sales
    FROM invoice_items
    JOIN tracks  ON tracks."TrackId" = invoice_items."TrackId"
    JOIN albums  ON albums."AlbumId" = tracks."AlbumId"
    JOIN artists ON artists."ArtistId"= albums."ArtistId"
    GROUP BY artists."ArtistId", artists."Name"
),
top_artist AS (
    SELECT "ArtistId" AS id FROM artist_totals
    ORDER BY total_sales DESC, "Name" ASC LIMIT 1
),
low_artist AS (
    SELECT "ArtistId" AS id FROM artist_totals
    WHERE total_sales > 0
    ORDER BY total_sales ASC, "Name" ASC LIMIT 1
),
spending AS (
    SELECT invoices."CustomerId",
           albums."ArtistId",
           SUM(invoice_items."UnitPrice" * invoice_items."Quantity") AS customer_artist_spent
    FROM invoice_items
    JOIN invoices ON invoices."InvoiceId" = invoice_items."InvoiceId"
    JOIN tracks   ON tracks."TrackId"   = invoice_items."TrackId"
    JOIN albums   ON albums."AlbumId"   = tracks."AlbumId"
    GROUP BY invoices."CustomerId", albums."ArtistId"
)
SELECT (SELECT AVG(customer_artist_spent)
        FROM spending
        WHERE ArtistId = (SELECT id FROM top_artist)) AS avg_top_artist_spending,
       (SELECT AVG(customer_artist_spent)
        FROM spending
        WHERE ArtistId = (SELECT id FROM low_artist)) AS avg_low_artist_spending;
