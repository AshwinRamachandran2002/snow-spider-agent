Query:
--Description: Total sales per artist (highest first, break ties alphabetically).
SELECT artists."ArtistId",
       artists."Name"                         AS artist_name,
       SUM(invoice_items."UnitPrice"
           * invoice_items."Quantity")        AS total_sales
FROM invoice_items
JOIN tracks  ON tracks."TrackId" = invoice_items."TrackId"
JOIN albums  ON albums."AlbumId" = tracks."AlbumId"
JOIN artists ON artists."ArtistId"= albums."ArtistId"
GROUP BY artists."ArtistId", artists."Name"
ORDER BY total_sales DESC, artist_name ASC
LIMIT 20;
