```sql
--Description: Preview sales data per track & artist (first 20 rows).
SELECT DISTINCT artists."Name"      AS artist_name,
                invoice_items."UnitPrice" * invoice_items."Quantity" AS sale_amount
FROM invoice_items
JOIN tracks   ON tracks."TrackId"  = invoice_items."TrackId"
JOIN albums   ON albums."AlbumId"  = tracks."AlbumId"
JOIN artists  ON artists."ArtistId"= albums."ArtistId"
LIMIT 20;
```

```sql
--Description: Total sales per artist (highest first, break ties alphabetically).
SELECT artists."ArtistId",
       artists."Name"                         AS artist_name,
       SUM(invoice_items."UnitPrice"
           * invoice_items."Quantity")        AS total_sales
FROM invoice_items
JOIN tracks  ON tracks."TrackId" = invoice_items."TrackId"
JOIN albums  ON albums."AlbumId" = tracks."AlbumId"
JOIN artists ON artists."ArtistId"= albums."ArtistId"
GROUP BY artists."ArtistId", artists."Name"
ORDER BY total_sales DESC, artist_name ASC
LIMIT 20;
```

```sql
--Description: Artist with the highest overall sales (tie-breaker by name).
SELECT sub."ArtistId", sub."Name" AS top_artist_name
FROM (
    SELECT artists."ArtistId", artists."Name",
           SUM(invoice_items."UnitPrice" * invoice_items."Quantity") AS total_sales
    FROM invoice_items
    JOIN tracks  ON tracks."TrackId" = invoice_items."TrackId"
    JOIN albums  ON albums."AlbumId" = tracks."AlbumId"
    JOIN artists ON artists."ArtistId"= albums."ArtistId"
    GROUP BY artists."ArtistId", artists."Name"
) AS sub
ORDER BY sub.total_sales DESC, sub."Name" ASC
LIMIT 1;
```

```sql
--Description: Artist with the lowest (non-zero) overall sales (tie-breaker by name).
SELECT sub."ArtistId", sub."Name" AS low_artist_name
FROM (
    SELECT artists."ArtistId", artists."Name",
           SUM(invoice_items."UnitPrice" * invoice_items."Quantity") AS total_sales
    FROM invoice_items
    JOIN tracks  ON tracks."TrackId" = invoice_items."TrackId"
    JOIN albums  ON albums."AlbumId" = tracks."AlbumId"
    JOIN artists ON artists."ArtistId"= albums."ArtistId"
    GROUP BY artists."ArtistId", artists."Name"
    HAVING total_sales > 0
) AS sub
ORDER BY sub.total_sales ASC, sub."Name" ASC
LIMIT 1;
```

```sql
--Description: How much each customer spent on the top-selling artist.
WITH top_artist AS (
    SELECT artists."ArtistId"
    FROM invoice_items
    JOIN tracks  ON tracks."TrackId" = invoice_items."TrackId"
    JOIN albums  ON albums."AlbumId" = tracks."AlbumId"
    JOIN artists ON artists."ArtistId"= albums."ArtistId"
    GROUP BY artists."ArtistId", artists."Name"
    ORDER BY SUM(invoice_items."UnitPrice" * invoice_items."Quantity") DESC,
             artists."Name" ASC
    LIMIT 1
)
SELECT customers."CustomerId",
       customers."FirstName" || ' ' || customers."LastName" AS customer_name,
       SUM(invoice_items."UnitPrice" * invoice_items."Quantity") AS spent_on_top_artist
FROM invoice_items
JOIN invoices  ON invoices."InvoiceId" = invoice_items."InvoiceId"
JOIN customers ON customers."CustomerId" = invoices."CustomerId"
JOIN tracks    ON tracks."TrackId"    = invoice_items."TrackId"
JOIN albums    ON albums."AlbumId"    = tracks."AlbumId"
JOIN top_artist ON top_artist."ArtistId" = albums."ArtistId"
GROUP BY customers."CustomerId", customer_name
ORDER BY spent_on_top_artist DESC
LIMIT 20;
```

```sql
--Description: How much each customer spent on the lowest-selling artist.
WITH low_artist AS (
    SELECT artists."ArtistId"
    FROM invoice_items
    JOIN tracks  ON tracks."TrackId" = invoice_items."TrackId"
    JOIN albums  ON albums."AlbumId" = tracks."AlbumId"
    JOIN artists ON artists."ArtistId"= albums."ArtistId"
    GROUP BY artists."ArtistId", artists."Name"
    HAVING SUM(invoice_items."UnitPrice" * invoice_items."Quantity") > 0
    ORDER BY SUM(invoice_items."UnitPrice" * invoice_items."Quantity") ASC,
             artists."Name" ASC
    LIMIT 1
)
SELECT customers."CustomerId",
       customers."FirstName" || ' ' || customers."LastName" AS customer_name,
       SUM(invoice_items."UnitPrice" * invoice_items."Quantity") AS spent_on_low_artist
FROM invoice_items
JOIN invoices  ON invoices."InvoiceId" = invoice_items."InvoiceId"
JOIN customers ON customers."CustomerId" = invoices."CustomerId"
JOIN tracks    ON tracks."TrackId"    = invoice_items."TrackId"
JOIN albums    ON albums."AlbumId"    = tracks."AlbumId"
JOIN low_artist ON low_artist."ArtistId" = albums."ArtistId"
GROUP BY customers."CustomerId", customer_name
ORDER BY spent_on_low_artist DESC
LIMIT 20;
```

```sql
--Description: Average customer spending for the top-selling artist vs lowest-selling artist.
WITH artist_totals AS (
    SELECT artists."ArtistId",
           artists."Name",
           SUM(invoice_items."UnitPrice" * invoice_items."Quantity") AS total_sales
    FROM invoice_items
    JOIN tracks  ON tracks."TrackId" = invoice_items."TrackId"
    JOIN albums  ON albums."AlbumId" = tracks."AlbumId"
    JOIN artists ON artists."ArtistId"= albums."ArtistId"
    GROUP BY artists."ArtistId", artists."Name"
),
top_artist AS (
    SELECT "ArtistId" AS id FROM artist_totals
    ORDER BY total_sales DESC, "Name" ASC LIMIT 1
),
low_artist AS (
    SELECT "ArtistId" AS id FROM artist_totals
    WHERE total_sales > 0
    ORDER BY total_sales ASC, "Name" ASC LIMIT 1
),
spending AS (
    SELECT invoices."CustomerId",
           albums."ArtistId",
           SUM(invoice_items."UnitPrice" * invoice_items."Quantity") AS customer_artist_spent
    FROM invoice_items
    JOIN invoices ON invoices."InvoiceId" = invoice_items."InvoiceId"
    JOIN tracks   ON tracks."TrackId"   = invoice_items."TrackId"
    JOIN albums   ON albums."AlbumId"   = tracks."AlbumId"
    GROUP BY invoices."CustomerId", albums."ArtistId"
)
SELECT (SELECT AVG(customer_artist_spent)
        FROM spending
        WHERE ArtistId = (SELECT id FROM top_artist)) AS avg_top_artist_spending,
       (SELECT AVG(customer_artist_spent)
        FROM spending
        WHERE ArtistId = (SELECT id FROM low_artist)) AS avg_low_artist_spending;
```

```sql
--Description: Absolute difference between the two average spendings.
WITH artist_totals AS (
    SELECT artists."ArtistId",
           artists."Name",
           SUM(invoice_items."UnitPrice" * invoice_items."Quantity") AS total_sales
    FROM invoice_items
    JOIN tracks  ON tracks."TrackId" = invoice_items."TrackId"
    JOIN albums  ON albums."AlbumId" = tracks."AlbumId"
    JOIN artists ON artists."ArtistId"= albums."ArtistId"
    GROUP BY artists."ArtistId", artists."Name"
),
top_artist AS (
    SELECT "ArtistId" AS id FROM artist_totals
    ORDER BY total_sales DESC, "Name" ASC LIMIT 1
),
low_artist AS (
    SELECT "ArtistId" AS id FROM artist_totals
    WHERE total_sales > 0
    ORDER BY total_sales ASC, "Name" ASC LIMIT 1
),
spending AS (
    SELECT invoices."CustomerId",
           albums."ArtistId",
           SUM(invoice_items."UnitPrice" * invoice_items."Quantity") AS customer_artist_spent
    FROM invoice_items
    JOIN invoices ON invoices."InvoiceId" = invoice_items."InvoiceId"
    JOIN tracks   ON tracks."TrackId"   = invoice_items."TrackId"
    JOIN albums   ON albums."AlbumId"   = tracks."AlbumId"
    GROUP BY invoices."CustomerId", albums."ArtistId"
),
avg_vals AS (
    SELECT (SELECT AVG(customer_artist_spent)
            FROM spending
            WHERE ArtistId = (SELECT id FROM top_artist)) AS avg_top,
           (SELECT AVG(customer_artist_spent)
            FROM spending
            WHERE ArtistId = (SELECT id FROM low_artist)) AS avg_low
)
SELECT ABS(avg_top - avg_low) AS absolute_difference
FROM avg_vals;
```
