```sql
--Description: View how albums map to artists.
SELECT DISTINCT a."AlbumId", a."Title", ar."Name" AS "Artist_Name"
FROM "albums" AS a
JOIN "artists" AS ar ON a."ArtistId" = ar."ArtistId"
LIMIT 20;
```

```sql
--Description: Explore how tracks connect an artist’s album to invoice-level sales data.
SELECT DISTINCT t."TrackId",
       al."AlbumId",
       ar."Name"      AS "Artist_Name",
       ii."InvoiceId",
       ii."UnitPrice",
       ii."Quantity"
FROM "tracks"        AS t
JOIN "albums"        AS al ON t."AlbumId"  = al."AlbumId"
JOIN "artists"       AS ar ON al."ArtistId" = ar."ArtistId"
JOIN "invoice_items" AS ii ON t."TrackId"  = ii."TrackId"
LIMIT 20;
```

```sql
--Description: Compute total sales (revenue) for every artist, ordered from highest to lowest (tie-break by name).
SELECT DISTINCT ar."ArtistId",
       ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Total_Sales"
FROM "artists"       AS ar
JOIN "albums"        AS al ON ar."ArtistId" = al."ArtistId"
JOIN "tracks"        AS t  ON al."AlbumId"  = t."AlbumId"
JOIN "invoice_items" AS ii ON t."TrackId"   = ii."TrackId"
GROUP BY ar."ArtistId", ar."Name"
ORDER BY "Total_Sales" DESC, ar."Name" ASC
LIMIT 20;
```

```sql
--Description: Compute total sales for every artist, ordered from lowest to highest (tie-break by name).
SELECT DISTINCT ar."ArtistId",
       ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Total_Sales"
FROM "artists"       AS ar
JOIN "albums"        AS al ON ar."ArtistId" = al."ArtistId"
JOIN "tracks"        AS t  ON al."AlbumId"  = t."AlbumId"
JOIN "invoice_items" AS ii ON t."TrackId"   = ii."TrackId"
GROUP BY ar."ArtistId", ar."Name"
ORDER BY "Total_Sales" ASC, ar."Name" ASC
LIMIT 20;
```

```sql
--Description: Identify the single top-selling and single lowest-selling artist in one query.
SELECT DISTINCT ar."ArtistId",
       ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Total_Sales"
FROM "artists"       AS ar
JOIN "albums"        AS al ON ar."ArtistId" = al."ArtistId"
JOIN "tracks"        AS t  ON al."AlbumId"  = t."AlbumId"
JOIN "invoice_items" AS ii ON t."TrackId"   = ii."TrackId"
GROUP BY ar."ArtistId", ar."Name"
HAVING "Total_Sales" = (
        SELECT MAX(sales."Total_Sales") FROM (
              SELECT SUM(ii2."UnitPrice"*ii2."Quantity") AS "Total_Sales"
              FROM "artists" ar2
              JOIN "albums" al2 ON ar2."ArtistId" = al2."ArtistId"
              JOIN "tracks" t2  ON al2."AlbumId"  = t2."AlbumId"
              JOIN "invoice_items" ii2 ON t2."TrackId" = ii2."TrackId"
              GROUP BY ar2."ArtistId", ar2."Name"
        ) AS sales
    )
   OR "Total_Sales" = (
        SELECT MIN(sales."Total_Sales") FROM (
              SELECT SUM(ii2."UnitPrice"*ii2."Quantity") AS "Total_Sales"
              FROM "artists" ar2
              JOIN "albums" al2 ON ar2."ArtistId" = al2."ArtistId"
              JOIN "tracks" t2  ON al2."AlbumId"  = t2."AlbumId"
              JOIN "invoice_items" ii2 ON t2."TrackId" = ii2."TrackId"
              GROUP BY ar2."ArtistId", ar2."Name"
        ) AS sales
    )
ORDER BY "Total_Sales" DESC, ar."Name" ASC   -- will show Top first then Bottom
LIMIT 20;
```

```sql
--Description: Determine how much each customer spent on the top-selling artist.
WITH top_artist AS (
    SELECT ar."ArtistId"
    FROM "artists" ar
    JOIN "albums" al ON ar."ArtistId" = al."ArtistId"
    JOIN "tracks" t  ON al."AlbumId"  = t."AlbumId"
    JOIN "invoice_items" ii ON t."TrackId" = ii."TrackId"
    GROUP BY ar."ArtistId", ar."Name"
    ORDER BY SUM(ii."UnitPrice"*ii."Quantity") DESC, ar."Name" ASC
    LIMIT 1
)
SELECT DISTINCT c."CustomerId",
       c."FirstName" || ' ' || c."LastName" AS "Customer_Name",
       SUM(ii."UnitPrice" * ii."Quantity")  AS "Spent_On_Top"
FROM top_artist       ta
JOIN "albums"         al ON ta."ArtistId" = al."ArtistId"
JOIN "tracks"         t  ON al."AlbumId"  = t."AlbumId"
JOIN "invoice_items"  ii ON t."TrackId"   = ii."TrackId"
JOIN "invoices"       inv ON ii."InvoiceId" = inv."InvoiceId"
JOIN "customers"      c   ON inv."CustomerId" = c."CustomerId"
GROUP BY c."CustomerId", "Customer_Name"
ORDER BY "Spent_On_Top" DESC
LIMIT 20;
```

```sql
--Description: Determine how much each customer spent on the lowest-selling artist.
WITH bottom_artist AS (
    SELECT ar."ArtistId"
    FROM "artists" ar
    JOIN "albums" al ON ar."ArtistId" = al."ArtistId"
    JOIN "tracks" t  ON al."AlbumId"  = t."AlbumId"
    JOIN "invoice_items" ii ON t."TrackId" = ii."TrackId"
    GROUP BY ar."ArtistId", ar."Name"
    ORDER BY SUM(ii."UnitPrice"*ii."Quantity") ASC, ar."Name" ASC
    LIMIT 1
)
SELECT DISTINCT c."CustomerId",
       c."FirstName" || ' ' || c."LastName" AS "Customer_Name",
       SUM(ii."UnitPrice" * ii."Quantity")  AS "Spent_On_Bottom"
FROM bottom_artist    ba
JOIN "albums"         al ON ba."ArtistId" = al."ArtistId"
JOIN "tracks"         t  ON al."AlbumId"  = t."AlbumId"
JOIN "invoice_items"  ii ON t."TrackId"   = ii."TrackId"
JOIN "invoices"       inv ON ii."InvoiceId" = inv."InvoiceId"
JOIN "customers"      c   ON inv."CustomerId" = c."CustomerId"
GROUP BY c."CustomerId", "Customer_Name"
ORDER BY "Spent_On_Bottom" DESC
LIMIT 20;
```

```sql
--Description: Compute the average spending of customers who purchased from the top-selling artist and from the lowest-selling artist.
WITH top_artist AS (
    SELECT ar."ArtistId"
    FROM "artists" ar
    JOIN "albums" al ON ar."ArtistId" = al."ArtistId"
    JOIN "tracks" t  ON al."AlbumId"  = t."AlbumId"
    JOIN "invoice_items" ii ON t."TrackId" = ii."TrackId"
    GROUP BY ar."ArtistId", ar."Name"
    ORDER BY SUM(ii."UnitPrice"*ii."Quantity") DESC, ar."Name" ASC
    LIMIT 1
), bottom_artist AS (
    SELECT ar."ArtistId"
    FROM "artists" ar
    JOIN "albums" al ON ar."ArtistId" = al."ArtistId"
    JOIN "tracks" t  ON al."AlbumId"  = t."AlbumId"
    JOIN "invoice_items" ii ON t."TrackId" = ii."TrackId"
    GROUP BY ar."ArtistId", ar."Name"
    ORDER BY SUM(ii."UnitPrice"*ii."Quantity") ASC, ar."Name" ASC
    LIMIT 1
), top_spend AS (
    SELECT inv."CustomerId",
           SUM(ii."UnitPrice"*ii."Quantity") AS spend
    FROM top_artist ta
    JOIN "albums"  al ON ta."ArtistId" = al."ArtistId"
    JOIN "tracks"  t  ON al."AlbumId"  = t."AlbumId"
    JOIN "invoice_items" ii ON t."TrackId" = ii."TrackId"
    JOIN "invoices" inv ON ii."InvoiceId" = inv."InvoiceId"
    GROUP BY inv."CustomerId"
), bottom_spend AS (
    SELECT inv."CustomerId",
           SUM(ii."UnitPrice"*ii."Quantity") AS spend
    FROM bottom_artist ba
    JOIN "albums"  al ON ba."ArtistId" = al."ArtistId"
    JOIN "tracks"  t  ON al."AlbumId"  = t."AlbumId"
    JOIN "invoice_items" ii ON t."TrackId" = ii."TrackId"
    JOIN "invoices" inv ON ii."InvoiceId" = inv."InvoiceId"
    GROUP BY inv."CustomerId"
)
SELECT DISTINCT
       (SELECT AVG(spend) FROM top_spend)    AS "Avg_Top_Artist",
       (SELECT AVG(spend) FROM bottom_spend) AS "Avg_Bottom_Artist"
LIMIT 20;
```

```sql
--Description: Return the absolute difference between the two average spendings.
WITH top_artist AS (
    SELECT ar."ArtistId"
    FROM "artists" ar
    JOIN "albums" al ON ar."ArtistId" = al."ArtistId"
    JOIN "tracks" t  ON al."AlbumId"  = t."AlbumId"
    JOIN "invoice_items" ii ON t."TrackId" = ii."TrackId"
    GROUP BY ar."ArtistId", ar."Name"
    ORDER BY SUM(ii."UnitPrice"*ii."Quantity") DESC, ar."Name" ASC
    LIMIT 1
), bottom_artist AS (
    SELECT ar."ArtistId"
    FROM "artists" ar
    JOIN "albums" al ON ar."ArtistId" = al."ArtistId"
    JOIN "tracks" t  ON al."AlbumId"  = t."AlbumId"
    JOIN "invoice_items" ii ON t."TrackId" = ii."TrackId"
    GROUP BY ar."ArtistId", ar."Name"
    ORDER BY SUM(ii."UnitPrice"*ii."Quantity") ASC, ar."Name" ASC
    LIMIT 1
), top_spend AS (
    SELECT inv."CustomerId",
           SUM(ii."UnitPrice"*ii."Quantity") AS spend
    FROM top_artist ta
    JOIN "albums"  al ON ta."ArtistId" = al."ArtistId"
    JOIN "tracks"  t  ON al."AlbumId"  = t."AlbumId"
    JOIN "invoice_items" ii ON t."TrackId" = ii."TrackId"
    JOIN "invoices" inv ON ii."InvoiceId" = inv."InvoiceId"
    GROUP BY inv."CustomerId"
), bottom_spend AS (
    SELECT inv."CustomerId",
           SUM(ii."UnitPrice"*ii."Quantity") AS spend
    FROM bottom_artist ba
    JOIN "albums"  al ON ba."ArtistId" = al."ArtistId"
    JOIN "tracks"  t  ON al."AlbumId"  = t."AlbumId"
    JOIN "invoice_items" ii ON t."TrackId" = ii."TrackId"
    JOIN "invoices" inv ON ii."InvoiceId" = inv."InvoiceId"
    GROUP BY inv."CustomerId"
), averages AS (
    SELECT (SELECT AVG(spend) FROM top_spend)    AS avg_top,
           (SELECT AVG(spend) FROM bottom_spend) AS avg_bottom
)
SELECT DISTINCT ABS(avg_top - avg_bottom) AS "Absolute_Difference"
FROM averages
LIMIT 20;
```
