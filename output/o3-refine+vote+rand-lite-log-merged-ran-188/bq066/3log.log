```sql
--Description: Check the possible values of the Maternal_Morbidity_YN flag
--(0 = “No”, 1 = “Yes”).
SELECT DISTINCT Maternal_Morbidity_YN
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
LIMIT 20;
```

```sql
--Description: 2016-2018 birth counts by morbidity flag – verifies that we have
--both the “0” and “1” categories we’ll need for rates.
SELECT
  EXTRACT(YEAR FROM Year) AS birth_year,
  Maternal_Morbidity_YN,
  SUM(Births) AS births
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM Year) BETWEEN 2016 AND 2018
GROUP BY birth_year, Maternal_Morbidity_YN
ORDER BY birth_year, Maternal_Morbidity_YN
LIMIT 20;
```

```sql
--Description: Sample 2017 rows to confirm the county identifier we will join on.
SELECT
  EXTRACT(YEAR FROM Year) AS birth_year,
  State,
  County,
  County_FIPS_Code,
  Maternal_Morbidity_YN,
  Births
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM Year)=2017
LIMIT 20;
```

```sql
--Description: Inspect the 2016 five-year ACS county table (poverty + population).
SELECT *
FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
LIMIT 20;
```

```sql
--Description: Compute 2016 poverty rates (poverty ÷ total_pop) for each county.
SELECT
  geo_id AS county_fips,
  SAFE_DIVIDE(poverty , total_pop) AS poverty_rate_2016
FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
WHERE total_pop IS NOT NULL
LIMIT 20;
```

```sql
--Description: Build 2017 county-level percentage of births with NO maternal
--morbidity (=1-maternal morbidity rate).
WITH birth_tot AS (
  SELECT County_FIPS_Code AS county_fips,
         SUM(Births) AS total_births
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year)=2017
  GROUP BY county_fips
),
birth_nomorb AS (
  SELECT County_FIPS_Code AS county_fips,
         SUM(Births) AS births_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year)=2017
    AND Maternal_Morbidity_YN = 0
  GROUP BY county_fips
)
SELECT
  t.county_fips,
  SAFE_DIVIDE(n.births_no_morbidity, t.total_births) AS pct_births_no_morbidity_2017
FROM birth_tot t
LEFT JOIN birth_nomorb n USING (county_fips)
LIMIT 20;
```

```sql
--Description: Join 2016 poverty with 2017 “no-morbidity” percentages and get
--the Pearson correlation for 2017.
WITH poverty AS (
  SELECT geo_id AS county_fips,
         SAFE_DIVIDE(poverty , total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
  WHERE total_pop IS NOT NULL
),
nomorb AS (
  SELECT County_FIPS_Code AS county_fips,
         SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN=0 THEN Births END),
                     SUM(Births)) AS pct_births_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year)=2017
  GROUP BY county_fips
)
SELECT CORR(poverty_rate, pct_births_no_morbidity) AS pearson_corr_2017
FROM poverty
JOIN nomorb USING (county_fips);
```

```sql
--Description: Repeat the correlation for 2018 births, pairing them with the
--latest available 5-year ACS poverty estimates (2018_5yr).
WITH poverty AS (
  SELECT geo_id AS county_fips,
         SAFE_DIVIDE(poverty , total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE total_pop IS NOT NULL
),
nomorb AS (
  SELECT County_FIPS_Code AS county_fips,
         SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN=0 THEN Births END),
                     SUM(Births)) AS pct_births_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year)=2018
  GROUP BY county_fips
)
SELECT CORR(poverty_rate, pct_births_no_morbidity) AS pearson_corr_2018
FROM poverty
JOIN nomorb USING (county_fips);
```

```sql
--Description: Pull the year-specific Pearson correlations together (2017 & 2018)
--so we can compare them side-by-side.
WITH corr_2017 AS (
  SELECT 2017 AS birth_year,
         CORR(poverty_rate, pct_births_no_morbidity) AS pearson_corr
  FROM (
      SELECT geo_id AS county_fips,
             SAFE_DIVIDE(poverty , total_pop) AS poverty_rate
      FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
      WHERE total_pop IS NOT NULL
  ) p
  JOIN (
      SELECT County_FIPS_Code AS county_fips,
             SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN=0 THEN Births END),
                         SUM(Births)) AS pct_births_no_morbidity
      FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
      WHERE EXTRACT(YEAR FROM Year)=2017
      GROUP BY county_fips
  ) n USING (county_fips)
),
corr_2018 AS (
  SELECT 2018 AS birth_year,
         CORR(poverty_rate, pct_births_no_morbidity) AS pearson_corr
  FROM (
      SELECT geo_id AS county_fips,
             SAFE_DIVIDE(poverty , total_pop) AS poverty_rate
      FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
      WHERE total_pop IS NOT NULL
  ) p
  JOIN (
      SELECT County_FIPS_Code AS county_fips,
             SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN=0 THEN Births END),
                         SUM(Births)) AS pct_births_no_morbidity
      FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
      WHERE EXTRACT(YEAR FROM Year)=2018
      GROUP BY county_fips
  ) n USING (county_fips)
)
SELECT * FROM corr_2017
UNION ALL
SELECT * FROM corr_2018;
```
