Query:
--Description: Consolidate the year-specific Pearson correlations (2017 & 2018)
--for side-by-side comparison; all joins use County_of_Residence_FIPS.
WITH corr_2017 AS (
  SELECT 2017 AS birth_year,
         CORR(poverty_rate, pct_births_no_morbidity) AS pearson_corr
  FROM (
      SELECT geo_id AS county_fips,
             SAFE_DIVIDE(poverty , total_pop) AS poverty_rate
      FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
      WHERE total_pop IS NOT NULL
  ) p
  JOIN (
      SELECT County_of_Residence_FIPS AS county_fips,
             SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN=0 THEN Births END),
                         SUM(Births)) AS pct_births_no_morbidity
      FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
      WHERE EXTRACT(YEAR FROM Year)=2017
      GROUP BY county_fips
  ) n USING (county_fips)
),
corr_2018 AS (
  SELECT 2018 AS birth_year,
         CORR(poverty_rate, pct_births_no_morbidity) AS pearson_corr
  FROM (
      SELECT geo_id AS county_fips,
             SAFE_DIVIDE(poverty , total_pop) AS poverty_rate
      FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
      WHERE total_pop IS NOT NULL
  ) p
  JOIN (
      SELECT County_of_Residence_FIPS AS county_fips,
             SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN=0 THEN Births END),
                         SUM(Births)) AS pct_births_no_morbidity
      FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
      WHERE EXTRACT(YEAR FROM Year)=2018
      GROUP BY county_fips
  ) n USING (county_fips)
)
SELECT * FROM corr_2017
UNION ALL
SELECT * FROM corr_2018
