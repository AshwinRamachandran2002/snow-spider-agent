```sql
--Description: Check which years are present (we are interested in 2016-2018)
--and confirm that the maternal-morbidity flag contains both “0” and “1”.
SELECT DISTINCT Year , Maternal_Morbidity_YN
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE Year BETWEEN '2016-01-01' AND '2018-12-31'
LIMIT 20;
```

```sql
--Description: Aggregate births at the county–year–morbidity flag level
--(this shows raw counts before turning them into percentages).
SELECT
  Year,
  County_FIPS_Code,
  Maternal_Morbidity_YN,
  SUM(Births) AS births
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE Year BETWEEN '2016-01-01' AND '2018-12-31'
GROUP BY Year, County_FIPS_Code, Maternal_Morbidity_YN
LIMIT 20;
```

```sql
--Description: For 2016-2018, compute the percentage of births that had
--NO maternal morbidity (Maternal_Morbidity_YN = 0) in every county.
SELECT
  Year,
  County_FIPS_Code        AS geo_id,
  SAFE_DIVIDE(
      SUM(CASE WHEN Maternal_Morbidity_YN = 0 THEN Births ELSE 0 END),
      SUM(Births)
  )                       AS pct_no_morbidity
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE Year BETWEEN '2016-01-01' AND '2018-12-31'
GROUP BY Year, County_FIPS_Code
LIMIT 20;
```

```sql
--Description: Inspect the 2015 five-year ACS county file that will serve as the
--poverty source for the 2016 natality year (poverty counts + total population).
SELECT geo_id, poverty, total_pop
FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
LIMIT 20;
```

```sql
--Description: Calculate county-level poverty RATE for 2015
--(will be linked to 2016 natality outcomes).
SELECT
  geo_id,
  SAFE_DIVIDE(poverty, total_pop) AS poverty_rate_2015
FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
LIMIT 20;
```

```sql
--Description: Pearson correlation between 2015 poverty rate and the
--percentage of 2016 births without maternal morbidity.
SELECT
  CORR(poverty_rate, pct_no_morbidity) AS corr_2016
FROM  (
        SELECT
          geo_id,
          SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
        FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
      ) AS acs
JOIN  (
        SELECT
          County_FIPS_Code AS geo_id,
          SAFE_DIVIDE(
              SUM(CASE WHEN Maternal_Morbidity_YN = 0 THEN Births ELSE 0 END),
              SUM(Births)
          ) AS pct_no_morbidity
        FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
        WHERE Year = '2016-01-01'
        GROUP BY County_FIPS_Code
      ) AS natal
USING (geo_id);
```

