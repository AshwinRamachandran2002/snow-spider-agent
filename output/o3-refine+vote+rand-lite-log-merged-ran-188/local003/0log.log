--Description: Combine recency date, total spend and order count to lay groundwork for RFM scoring.
SELECT  r."customer_unique_id",
        r."latest_purchase",
        tf."total_spend",
        tf."num_orders"
FROM   (SELECT  c."customer_unique_id",
                MAX(o."order_purchase_timestamp") AS "latest_purchase"
        FROM    "orders"    AS o
        JOIN    "customers" AS c
          ON    c."customer_id" = o."customer_id"
        WHERE   o."order_status" = 'delivered'
        GROUP   BY c."customer_unique_id") AS r
JOIN   (SELECT  c."customer_unique_id",
                COUNT(*)  AS "num_orders",
                SUM(op."order_total") AS "total_spend"
        FROM   (SELECT "order_id",
                       SUM("payment_value") AS "order_total"
               FROM   "order_payments"
               GROUP  BY "order_id") AS op
        JOIN   "orders"    AS o  ON o."order_id"   = op."order_id"
        JOIN   "customers" AS c  ON c."customer_id"= o."customer_id"
        WHERE  o."order_status" = 'delivered'
        GROUP  BY c."customer_unique_id") AS tf
  ON  r."customer_unique_id" = tf."customer_unique_id"
LIMIT 20;
