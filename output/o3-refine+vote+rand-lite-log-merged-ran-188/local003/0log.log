```sql
--Description: Retrieve the count of delivered orders per customer (original customer_id).
SELECT  o."customer_id",
        COUNT(*) AS "delivered_orders"
FROM    "orders" AS o
WHERE   o."order_status" = 'delivered'
GROUP   BY o."customer_id"
LIMIT 20;
```

```sql
--Description: Compute total spend and number of delivered orders per customer_unique_id.
SELECT  c."customer_unique_id",
        COUNT(*)                                    AS "num_orders",
        SUM(op."order_total")                       AS "total_spend"
FROM    (SELECT "order_id",
                SUM("payment_value") AS "order_total"
         FROM   "order_payments"
         GROUP  BY "order_id") AS op
JOIN    "orders"    AS o  ON o."order_id"   = op."order_id"
JOIN    "customers" AS c  ON c."customer_id"= o."customer_id"
WHERE   o."order_status" = 'delivered'
GROUP   BY c."customer_unique_id"
LIMIT 20;
```

```sql
--Description: See the most recent delivered purchase per customer_unique_id 
--             (needed for the Recency component of RFM).
SELECT  c."customer_unique_id",
        MAX(o."order_purchase_timestamp") AS "latest_purchase"
FROM    "orders"    AS o
JOIN    "customers" AS c
  ON    c."customer_id" = o."customer_id"
WHERE   o."order_status" = 'delivered'
GROUP   BY c."customer_unique_id"
LIMIT 20;
```

```sql
--Description: Combine recency date, total spend and order count to lay groundwork for RFM scoring.
SELECT  r."customer_unique_id",
        r."latest_purchase",
        tf."total_spend",
        tf."num_orders"
FROM   (SELECT  c."customer_unique_id",
                MAX(o."order_purchase_timestamp") AS "latest_purchase"
        FROM    "orders"    AS o
        JOIN    "customers" AS c
          ON    c."customer_id" = o."customer_id"
        WHERE   o."order_status" = 'delivered'
        GROUP   BY c."customer_unique_id") AS r
JOIN   (SELECT  c."customer_unique_id",
                COUNT(*)  AS "num_orders",
                SUM(op."order_total") AS "total_spend"
        FROM   (SELECT "order_id",
                       SUM("payment_value") AS "order_total"
               FROM   "order_payments"
               GROUP  BY "order_id") AS op
        JOIN   "orders"    AS o  ON o."order_id"   = op."order_id"
        JOIN   "customers" AS c  ON c."customer_id"= o."customer_id"
        WHERE  o."order_status" = 'delivered'
        GROUP  BY c."customer_unique_id") AS tf
  ON  r."customer_unique_id" = tf."customer_unique_id"
LIMIT 20;
```

```sql
--Description: (Example full RFM segmentation skeleton) Assign quantile-based R, F & M scores 
--             and compute average sales per order for each resulting segment.
SELECT seg."customer_unique_id",
       seg."R_score",
       seg."F_score",
       seg."M_score",
       (seg."total_spend" * 1.0 / seg."num_orders") AS "avg_sales_per_order"
FROM  (
       SELECT  base.*,
               -- Recency: 1 = most recent, 4 = oldest (quartiles)
               NTILE(4) OVER (ORDER BY base."days_since_last_purchase" ASC) AS "R_score",
               -- Frequency: 1 = most orders, 4 = fewest (reverse quartiles)
               NTILE(4) OVER (ORDER BY base."num_orders" DESC)              AS "F_score",
               -- Monetary: 1 = highest spend, 4 = lowest (reverse quartiles)
               NTILE(4) OVER (ORDER BY base."total_spend" DESC)             AS "M_score"
       FROM (
             SELECT  r."customer_unique_id",
                     JULIANDAY('now') - JULIANDAY(r."latest_purchase") AS "days_since_last_purchase",
                     tf."num_orders",
                     tf."total_spend"
             FROM    ( /* the recency subquery above */ ) AS r
             JOIN    ( /* the frequency & monetary subquery above */ ) AS tf
               ON     r."customer_unique_id" = tf."customer_unique_id"
       ) AS base
) AS seg
LIMIT 20;
```
