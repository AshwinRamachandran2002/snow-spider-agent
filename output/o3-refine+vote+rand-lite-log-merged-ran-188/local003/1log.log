-- 4. Description:  Build one row per delivered order that already contains
--                 (a) customer_unique_id, (b) purchase date, (c) total amount paid.
--                 (Payment table is summed in case of split payments.)
SELECT DISTINCT o."order_id",
       c."customer_unique_id",
       o."order_purchase_timestamp",
       SUM(p."payment_value") AS "order_amount"
FROM   "orders"          AS o
JOIN   "customers"       AS c ON o."customer_id" = c."customer_id"
JOIN   "order_payments"  AS p ON o."order_id"    = p."order_id"
WHERE  o."order_status"  = 'delivered'
GROUP  BY o."order_id", c."customer_unique_id", o."order_purchase_timestamp"
LIMIT 20;
