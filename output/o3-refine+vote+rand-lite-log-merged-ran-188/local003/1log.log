Query:
-- 7. Description:  Combine Recency, Frequency, Monetary,
--                 then bucket each metric into terciles (1,2,3 = low–high).
WITH base AS (
    SELECT c."customer_unique_id",
           MAX(o."order_purchase_timestamp")                              AS last_purchase,
           ROUND(julianday( (SELECT MAX("order_purchase_timestamp") FROM "orders" WHERE "order_status"='delivered') )
                - julianday( MAX(o."order_purchase_timestamp") ))         AS recency_days,
           COUNT(*)                                                       AS frequency_orders,
           ROUND(SUM(p."payment_value"),2)                                AS monetary_total
    FROM   "orders"         AS o
    JOIN   "customers"      AS c ON o."customer_id" = c."customer_id"
    JOIN   "order_payments" AS p ON o."order_id"    = p."order_id"
    WHERE  o."order_status" = 'delivered'
    GROUP  BY c."customer_unique_id"
),
ranked AS (
    SELECT b.*,
           NTILE(3) OVER(ORDER BY recency_days  ASC) AS r_score,   -- recent = score 3
           NTILE(3) OVER(ORDER BY frequency_orders DESC) AS f_score, -- more orders = 3
           NTILE(3) OVER(ORDER BY monetary_total  DESC) AS m_score   -- higher spend = 3
    FROM   base AS b
)
SELECT DISTINCT
       "customer_unique_id",
       r_score, f_score, m_score,
       (r_score || f_score || m_score) AS rfm_code
FROM   ranked
LIMIT 20;
