Query:
-- 6. Description:  Show Frequency (# delivered orders) and Monetary (total spend)
--                 per customer_unique_id.
WITH delivered AS (
  SELECT c."customer_unique_id",
         o."order_id",
         SUM(p."payment_value") AS "order_amount"
  FROM   "orders"         AS o
  JOIN   "customers"      AS c ON o."customer_id" = c."customer_id"
  JOIN   "order_payments" AS p ON o."order_id"    = p."order_id"
  WHERE  o."order_status" = 'delivered'
  GROUP  BY o."order_id", c."customer_unique_id"
)
SELECT DISTINCT
       d."customer_unique_id",
       COUNT(*)                    AS "frequency_orders",
       ROUND(SUM(d."order_amount"),2) AS "monetary_total"
FROM   delivered AS d
GROUP  BY d."customer_unique_id"
LIMIT 20;
