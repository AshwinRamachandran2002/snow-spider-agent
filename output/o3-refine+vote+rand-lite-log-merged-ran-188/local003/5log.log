2025-05-05 04:27:36 - Thread-3166 (execute) - INFO - [Exploration]
Below is an investigation that starts with simple column inspections and ends with the requested RFM-segment view that shows the “average sales per order” for each segment (only “delivered” orders are taken into account and the customer **unique** identifier is used).

```sql
-- 1) See the different statuses an order can have
SELECT DISTINCT "order_status"
FROM "orders"
LIMIT 20;
```

```sql
-- 2) Look at a few “delivered” orders together with the purchasing time-stamp
SELECT DISTINCT "order_id",
                "customer_id",
                "order_purchase_timestamp"
FROM "orders"
WHERE "order_status" = 'delivered'
LIMIT 20;
```

```sql
-- 3) Verify that one customer_id can map to a unique customer_unique_id
SELECT DISTINCT c."customer_id",
                c."customer_unique_id"
FROM "customers" AS c
LIMIT 20;
```

```sql
-- 4) Inspect how much a single order is worth (price + freight)  
SELECT DISTINCT oi."order_id",
                SUM(oi."price" + oi."freight_value") AS "order_total"
FROM "order_items" AS oi
GROUP BY oi."order_id"
LIMIT 20;
```

```sql
-- 5) Build the value of every delivered order
SELECT DISTINCT o."order_id",
                SUM(oi."price" + oi."freight_value") AS "order_total"
FROM "orders"        AS o
JOIN "order_items"   AS oi ON oi."order_id" = o."order_id"
WHERE o."order_status" = 'delivered'
GROUP BY o."order_id"
LIMIT 20;
```

```sql
-- 6) Aggregate Frequency (#orders) & Monetary (total spend) per customer_unique_id
WITH delivered_orders AS (
    SELECT o."order_id",
           o."customer_id",
           o."order_purchase_timestamp"
    FROM   "orders" AS o
    WHERE  o."order_status" = 'delivered'
)
SELECT DISTINCT cu."customer_unique_id",
       COUNT(DISTINCT d."order_id")                         AS "frequency",
       SUM(oi."price" + oi."freight_value")                 AS "monetary",
       MAX(d."order_purchase_timestamp")                    AS "last_purchase"
FROM delivered_orders  AS d
JOIN "customers"        AS cu ON cu."customer_id" = d."customer_id"
JOIN "order_items"      AS oi ON oi."order_id" = d."order_id"
GROUP BY cu."customer_unique_id"
LIMIT 20;
```

```sql
-- 7) Add Recency (days since last purchase, relative to the latest purchase in the data set)
WITH delivered_orders AS (
    SELECT o."order_id",
           o."customer_id",
           o."order_purchase_timestamp"
    FROM "orders" AS o
    WHERE o."order_status" = 'delivered'
),
cust_value AS (
    SELECT cu."customer_unique_id",
           COUNT(DISTINCT d."order_id")                     AS "frequency",
           SUM(oi."price" + oi."freight_value")             AS "monetary",
           MAX(d."order_purchase_timestamp")                AS "last_purchase"
    FROM delivered_orders AS d
    JOIN "customers"     AS cu ON cu."customer_id" = d."customer_id"
    JOIN "order_items"   AS oi ON oi."order_id"  = d."order_id"
    GROUP BY cu."customer_unique_id"
)
SELECT DISTINCT *,
       ( julianday( (SELECT MAX("order_purchase_timestamp") FROM "orders") )
         - julianday("last_purchase") )                    AS "recency_days"
FROM cust_value
LIMIT 20;
```

```sql
-- 8) Score every customer (R,F,M = 1‒4) + compute average sales per order
WITH delivered_orders AS (
    SELECT o."order_id",
           o."customer_id",
           o."order_purchase_timestamp"
    FROM "orders" AS o
    WHERE o."order_status" = 'delivered'
),
cust_value AS (
    SELECT cu."customer_unique_id",
           COUNT(DISTINCT d."order_id")                     AS "frequency",
           SUM(oi."price" + oi."freight_value")             AS "monetary",
           MAX(d."order_purchase_timestamp")                AS "last_purchase"
    FROM delivered_orders AS d
    JOIN "customers"     AS cu ON cu."customer_id" = d."customer_id"
    JOIN "order_items"   AS oi ON oi."order_id"  = d."order_id"
    GROUP BY cu."customer_unique_id"
),
recency_calc AS (
    SELECT cv.*,
           ( julianday( (SELECT MAX("order_purchase_timestamp") FROM "orders") )
             - julianday(cv."last_purchase") )              AS "recency_days"
    FROM cust_value AS cv
),
rfm AS (
    SELECT *,
           /* --- Recency: lower days = better --- */
           CASE WHEN recency_days <=  30 THEN 4
                WHEN recency_days <=  90 THEN 3
                WHEN recency_days <= 180 THEN 2
                ELSE                           1 END        AS "R_score",
           /* --- Frequency: more orders = better --- */
           CASE WHEN frequency >= 10 THEN 4
                WHEN frequency >=  5 THEN 3
                WHEN frequency >=  2 THEN 2
                ELSE                   1 END               AS "F_score",
           /* --- Monetary: more spend = better --- */
           CASE WHEN monetary > 1000 THEN 4
                WHEN monetary >  500 THEN 3
                WHEN monetary >  100 THEN 2
                ELSE                     1 END             AS "M_score",
           monetary * 1.0 / frequency                      AS "avg_sales_per_order"
    FROM recency_calc
)
SELECT DISTINCT *,
       CAST("R_score" AS TEXT) || CAST("F_score" AS TEXT) || CAST("M_score" AS TEXT)
           AS "RFM_segment"
FROM rfm
LIMIT 20;
```

```sql
-- 9) Average sales per order for each distinct RFM segment
WITH delivered_orders AS (
    SELECT o."order_id",
           o."customer_id",
           o."order_purchase_timestamp"
    FROM "orders" AS o
    WHERE o."order_status" = 'delivered'
),
cust_value AS (
    SELECT cu."customer_unique_id",
           COUNT(DISTINCT d."order_id")                     AS "frequency",
           SUM(oi."price" + oi."freight_value")             AS "monetary",
           MAX(d."order_purchase_timestamp")                AS "last_purchase"
    FROM delivered_orders AS d
    JOIN "customers"     AS cu ON cu."customer_id" = d."customer_id"
    JOIN "order_items"   AS oi ON oi."order_id"  = d."order_id"
    GROUP BY cu."customer_unique_id"
),
recency_calc AS (
    SELECT cv.*,
           ( julianday( (SELECT MAX("order_purchase_timestamp") FROM "orders") )
             - julianday(cv."last_purchase") )              AS "recency_days"
    FROM cust_value AS cv
),
rfm AS (
    SELECT *,
           CASE WHEN recency_days <=  30 THEN 4
                WHEN recency_days <=  90 THEN 3
                WHEN recency_days <= 180 THEN 2
                ELSE                           1 END        AS "R_score",
           CASE WHEN frequency >= 10 THEN 4
                WHEN frequency >=  5 THEN 3
                WHEN frequency >=  2 THEN 2
                ELSE                   1 END               AS "F_score",
           CASE WHEN monetary > 1000 THEN 4
                WHEN monetary >  500 THEN 3
                WHEN monetary >  100 THEN 2
                ELSE                     1 END             AS "M_score",
           monetary * 1.0 / frequency                      AS "avg_sales_per_order"
    FROM recency_calc
)
SELECT (CAST(R_score AS TEXT) || CAST(F_score AS TEXT) || CAST(M_score AS TEXT)) 
           AS "RFM_segment",
       COUNT(DISTINCT customer_unique_id)                   AS "n_customers",
       AVG(avg_sales_per_order)                             AS "avg_sales_per_order"
FROM rfm
GROUP BY RFM_segment
ORDER BY avg_sales_per_order DESC
LIMIT 20;
```

```sql
-- 10) Same as #9 but with friendly names for key segments
WITH delivered_orders AS (
    SELECT o."order_id",
           o."customer_id",
           o."order_purchase_timestamp"
    FROM "orders" AS o
    WHERE o."order_status" = 'delivered'
),
cust_value AS (
    SELECT cu."customer_unique_id",
           COUNT(DISTINCT d."order_id")                     AS "frequency",
           SUM(oi."price" + oi."freight_value")             AS "monetary",
           MAX(d."order_purchase_timestamp")                AS "last_purchase"
    FROM delivered_orders AS d
    JOIN "customers"     AS cu ON cu."customer_id" = d."customer_id"
    JOIN "order_items"   AS oi ON oi."order_id"  = d."order_id"
    GROUP BY cu."customer_unique_id"
),
recency_calc AS (
    SELECT cv.*,
           ( julianday( (SELECT MAX("order_purchase_timestamp") FROM "orders") )
             - julianday(cv."last_purchase") )              AS "recency_days"
    FROM cust_value AS cv
),
rfm AS (
    SELECT *,
           CASE WHEN recency_days <=  30 THEN 4
                WHEN recency_days <=  90 THEN 3
                WHEN recency_days <= 180 THEN 2
                ELSE                           1 END        AS "R_score",
           CASE WHEN frequency >= 10 THEN 4
                WHEN frequency >=  5 THEN 3
                WHEN frequency >=  2 THEN 2
                ELSE                   1 END               AS "F_score",
           CASE WHEN monetary > 1000 THEN 4
                WHEN monetary >  500 THEN 3
                WHEN monetary >  100 THEN 2
                ELSE                     1 END             AS "M_score",
           monetary * 1.0 / frequency                      AS "avg_sales_per_order"
    FROM recency_calc
),
rfm_labeled AS (
    SELECT *,
           CASE 
                WHEN R_score = 4 AND F_score = 4 AND M_score = 4     THEN 'Champions'
                WHEN R_score >=3 AND F_score >=3 AND M_score >=3    THEN 'Loyal_Customers'
                WHEN R_score >=3 AND F_score <=2 AND M_score <=2    THEN 'Potential_Loyalist'
                WHEN R_score = 2 AND  F_score >=3 AND M_score >=3   THEN 'Promising'
                ELSE                                                   'Others'
           END                                                      AS "segment_label"
    FROM rfm
)
SELECT segment_label                          AS "RFM_segment",
       COUNT(DISTINCT customer_unique_id)     AS "n_customers",
       AVG(avg_sales_per_order)               AS "avg_sales_per_order"
FROM rfm_labeled
GROUP BY segment_label
ORDER BY avg_sales_per_order DESC
LIMIT 20;
```

Explanation of RFM choices used in the queries
1. Recency: number of days between the latest purchase in the database and a customer’s most recent purchase  
   • ≤ 30 days → 4 • 31-90 days → 3 • 91-180 days → 2 • > 180 days → 1  

2. Frequency: number of delivered orders per customer_unique_id  
   • ≥ 10 orders → 4 • 5-9 orders → 3 • 2-4 orders → 2 • 1 order → 1  

3. Monetary: total spend (price + freight) across delivered orders  
   • > 1000 R$ → 4 • 501-1000 R$ → 3 • 101-500 R$ → 2 • ≤ 100 R$ → 1  

4. The concatenation R_score||F_score||M_score constitutes the classic “RFM segment”; query #10 also maps those numeric codes to friendlier business labels.

Expected Insights
• Segments with high R & F but low M often show moderate average-sales-per-order, signaling frequent but inexpensive purchases.  
• “Champions” (444) or “Loyal_Customers” (≥333) should clearly top the ranking in average sales per order, reinforcing their value.  
• “Potential_Loyalist” or “Promising” groups show room for monetary up-sell (avg sales noticeably below champions).  
• All remaining “Others” lag behind both in frequency and monetary terms, generating the lowest average order value.
