```sql
--Description: One-shot query that:  
-- 1) gets the latest delivered-order date (for Recency);  
-- 2) builds R, F, M per customer_unique_id;  
-- 3) identifies which RFM segment has the highest average ticket;  
-- 4) lists the 20 customers in that winning segment with the biggest tickets.  
-- (R buckets: ≤30 days=Recent, ≤90 days=Moderate, else Old.  
--  F buckets: ≥5=Frequent, ≥3=Medium, else Rare.  
--  M buckets (average ticket): ≥150=High, ≥75=Medium, else Low.)

WITH
latest AS (                         -- step-1
    SELECT MAX(order_purchase_timestamp) AS max_ts
    FROM   orders
    WHERE  order_status = 'delivered'
),
rfm AS (                            -- step-2
    SELECT cu.customer_unique_id,
           ROUND(julianday(l.max_ts) - julianday(MAX(o.order_purchase_timestamp)),1)          AS recency,
           COUNT(DISTINCT o.order_id)                                                         AS freq,
           SUM(op.payment_value)                                                              AS monetary,
           ROUND(SUM(op.payment_value)*1.0 / COUNT(DISTINCT o.order_id),2)                    AS avg_ticket,
           CASE WHEN ROUND(julianday(l.max_ts) - julianday(MAX(o.order_purchase_timestamp)),1) <= 30 THEN 'R_Recent'
                WHEN ROUND(julianday(l.max_ts) - julianday(MAX(o.order_purchase_timestamp)),1) <= 90 THEN 'R_Moderate'
                ELSE 'R_Old' END                                                               AS R_tag,
           CASE WHEN COUNT(DISTINCT o.order_id) >= 5 THEN 'F_Frequent'
                WHEN COUNT(DISTINCT o.order_id) >= 3 THEN 'F_Medium'
                ELSE 'F_Rare' END                                                              AS F_tag,
           CASE WHEN SUM(op.payment_value)*1.0 / COUNT(DISTINCT o.order_id) >= 150 THEN 'M_High'
                WHEN SUM(op.payment_value)*1.0 / COUNT(DISTINCT o.order_id) >= 75  THEN 'M_Medium'
                ELSE 'M_Low' END                                                               AS M_tag
    FROM   orders          o
    JOIN   customers       cu  ON cu.customer_id = o.customer_id
    JOIN   order_payments  op  ON op.order_id     = o.order_id
    CROSS  JOIN latest     l
    WHERE  o.order_status = 'delivered'
    GROUP  BY cu.customer_unique_id
),
best_segment AS (                   -- step-3
    SELECT R_tag || '_' || F_tag || '_' || M_tag AS seg,
           AVG(avg_ticket)                       AS seg_avg
    FROM   rfm
    GROUP  BY seg
    ORDER  BY seg_avg DESC
    LIMIT  1
)
-- step-4: final output
SELECT r.customer_unique_id,
       r.R_tag || '_' || r.F_tag || '_' || r.M_tag AS RFM_segment,
       r.avg_ticket                                AS Avg_sales_per_order
FROM   rfm r
JOIN   best_segment b ON (r.R_tag || '_' || r.F_tag || '_' || r.M_tag) = b.seg
ORDER  BY r.avg_ticket DESC
LIMIT  20;
```
