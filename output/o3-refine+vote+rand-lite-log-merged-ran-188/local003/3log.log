Query:
-- 6) Compute Recency (days since last purchase), Frequency (#orders) and Monetary (total spend) per customer_unique_id
SELECT cu."customer_unique_id",
       ROUND(julianday( (SELECT MAX("order_purchase_timestamp")
                         FROM "orders"
                         WHERE "order_status"='delivered')
             ) 
             - julianday(MAX(o."order_purchase_timestamp")), 1) AS "Recency_days",
       COUNT(DISTINCT o."order_id")                              AS "Frequency_orders",
       SUM(op."payment_value")                                   AS "Monetary_value"
FROM   "orders"         AS o
JOIN   "customers"      AS cu  ON o."customer_id" = cu."customer_id"
JOIN   "order_payments" AS op  ON o."order_id"    = op."order_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY cu."customer_unique_id"
LIMIT 20;
