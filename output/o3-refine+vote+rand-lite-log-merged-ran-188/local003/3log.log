```sql
-- 1) Distinct order status values to confirm we should filter by “delivered”
SELECT DISTINCT "order_status"
FROM "orders"
LIMIT 20;
```

```sql
-- 2) Sample “delivered” orders with their purchase-timestamps
SELECT "order_id",
       "customer_id",
       "order_purchase_timestamp"
FROM "orders"
WHERE "order_status" = 'delivered'
LIMIT 20;
```

```sql
-- 3) Link orders → customers to fetch the stable customer_unique_id
SELECT o."order_id",
       c."customer_unique_id"
FROM   "orders" AS o
JOIN   "customers" AS c
       ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
LIMIT 20;
```

```sql
-- 4) What is the total payment per order?  
SELECT op."order_id",
       SUM(op."payment_value") AS "order_revenue"
FROM   "order_payments" AS op
GROUP  BY op."order_id"
LIMIT 20;
```

```sql
-- 5) Latest purchase-date among delivered orders  
SELECT MAX("order_purchase_timestamp") AS "data_max_date"
FROM   "orders"
WHERE  "order_status" = 'delivered'
LIMIT 20;
```

```sql
-- 6) Compute Recency (days since last purchase), Frequency (#orders) and Monetary (total spend) per customer_unique_id
SELECT cu."customer_unique_id",
       ROUND(julianday( (SELECT MAX("order_purchase_timestamp")
                         FROM "orders"
                         WHERE "order_status"='delivered')
             ) 
             - julianday(MAX(o."order_purchase_timestamp")), 1) AS "Recency_days",
       COUNT(DISTINCT o."order_id")                              AS "Frequency_orders",
       SUM(op."payment_value")                                   AS "Monetary_value"
FROM   "orders"         AS o
JOIN   "customers"      AS cu  ON o."customer_id" = cu."customer_id"
JOIN   "order_payments" AS op  ON o."order_id"    = op."order_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY cu."customer_unique_id"
LIMIT 20;
```

```sql
-- 7) Classify each metric into three buckets (High/Medium/Low) and build an RFM segment tag
SELECT *,
       CASE
            WHEN "Recency_days" <= 30  THEN 'R_Recent'
            WHEN "Recency_days" <= 90  THEN 'R_Moderate'
            ELSE                           'R_Old'
       END                                                   AS "R_class",
       CASE
            WHEN "Frequency_orders" >= 5 THEN 'F_Frequent'
            WHEN "Frequency_orders" >= 3 THEN 'F_Medium'
            ELSE                          'F_Rare'
       END                                                   AS "F_class",
       CASE
            WHEN ("Monetary_value" * 1.0) / "Frequency_orders" >= 150 THEN 'M_High'
            WHEN ("Monetary_value" * 1.0) / "Frequency_orders" >= 75  THEN 'M_Medium'
            ELSE                                                        'M_Low'
       END                                                   AS "M_class"
FROM (
      /* re-use aggregated R, F, M from previous step */
      SELECT cu."customer_unique_id",
             ROUND(julianday( (SELECT MAX("order_purchase_timestamp")
                               FROM "orders"
                               WHERE "order_status"='delivered')
                   ) 
                   - julianday(MAX(o."order_purchase_timestamp")), 1) AS "Recency_days",
             COUNT(DISTINCT o."order_id")                              AS "Frequency_orders",
             SUM(op."payment_value")                                   AS "Monetary_value"
      FROM   "orders"         AS o
      JOIN   "customers"      AS cu  ON o."customer_id" = cu."customer_id"
      JOIN   "order_payments" AS op  ON o."order_id"    = op."order_id"
      WHERE  o."order_status" = 'delivered'
      GROUP  BY cu."customer_unique_id"
)
LIMIT 20;
```

```sql
-- 8) Compute average sales per order and produce the final RFM segment string
SELECT "customer_unique_id",
       "R_class" || '_' || "F_class" || '_' || "M_class"     AS "RFM_segment",
       ROUND("Monetary_value" * 1.0 / "Frequency_orders", 2) AS "Avg_sales_per_order"
FROM (
      /* same sub-query as step 7, already categorised */
      SELECT *,
             CASE
                  WHEN "Recency_days" <= 30  THEN 'R_Recent'
                  WHEN "Recency_days" <= 90  THEN 'R_Moderate'
                  ELSE                           'R_Old'
             END                                                   AS "R_class",
             CASE
                  WHEN "Frequency_orders" >= 5 THEN 'F_Frequent'
                  WHEN "Frequency_orders" >= 3 THEN 'F_Medium'
                  ELSE                          'F_Rare'
             END                                                   AS "F_class",
             CASE
                  WHEN ("Monetary_value" * 1.0) / "Frequency_orders" >= 150 THEN 'M_High'
                  WHEN ("Monetary_value" * 1.0) / "Frequency_orders" >= 75  THEN 'M_Medium'
                  ELSE                                                        'M_Low'
             END                                                   AS "M_class"
      FROM (
            SELECT cu."customer_unique_id",
                   ROUND(julianday( (SELECT MAX("order_purchase_timestamp")
                                     FROM "orders"
                                     WHERE "order_status"='delivered')
                         ) 
                         - julianday(MAX(o."order_purchase_timestamp")), 1) AS "Recency_days",
                   COUNT(DISTINCT o."order_id")                              AS "Frequency_orders",
                   SUM(op."payment_value")                                   AS "Monetary_value"
            FROM   "orders"         AS o
            JOIN   "customers"      AS cu  ON o."customer_id" = cu."customer_id"
            JOIN   "order_payments" AS op  ON o."order_id"    = op."order_id"
            WHERE  o."order_status" = 'delivered'
            GROUP  BY cu."customer_unique_id"
      )
)
LIMIT 20;
```

```sql
-- 9) Compare average sales across the different RFM segments
SELECT "RFM_segment",
       COUNT(DISTINCT "customer_unique_id")                        AS "num_customers",
       ROUND(AVG("Avg_sales_per_order"), 2)                        AS "avg_sales_per_order_segment"
FROM (
      /* sub-query from step 8 without LIMIT */
      SELECT "customer_unique_id",
             "R_class" || '_' || "F_class" || '_' || "M_class"     AS "RFM_segment",
             ROUND("Monetary_value" * 1.0 / "Frequency_orders", 2) AS "Avg_sales_per_order"
      FROM (
            SELECT *,
                   CASE
                        WHEN "Recency_days" <= 30  THEN 'R_Recent'
                        WHEN "Recency_days" <= 90  THEN 'R_Moderate'
                        ELSE                           'R_Old'
                   END AS "R_class",
                   CASE
                        WHEN "Frequency_orders" >= 5 THEN 'F_Frequent'
                        WHEN "Frequency_orders" >= 3 THEN 'F_Medium'
                        ELSE                          'F_Rare'
                   END AS "F_class",
                   CASE
                        WHEN ("Monetary_value" * 1.0) / "Frequency_orders" >= 150 THEN 'M_High'
                        WHEN ("Monetary_value" * 1.0) / "Frequency_orders" >= 75  THEN 'M_Medium'
                        ELSE                                                        'M_Low'
                   END AS "M_class"
            FROM (
                  SELECT cu."customer_unique_id",
                         ROUND(julianday( (SELECT MAX("order_purchase_timestamp")
                                           FROM "orders"
                                           WHERE "order_status"='delivered')
                               ) 
                               - julianday(MAX(o."order_purchase_timestamp")), 1) AS "Recency_days",
                         COUNT(DISTINCT o."order_id")                              AS "Frequency_orders",
                         SUM(op."payment_value")                                   AS "Monetary_value"
                  FROM   "orders"         AS o
                  JOIN   "customers"      AS cu  ON o."customer_id" = cu."customer_id"
                  JOIN   "order_payments" AS op  ON o."order_id"    = op."order_id"
                  WHERE  o."order_status" = 'delivered'
                  GROUP  BY cu."customer_unique_id"
            )
      )
)
GROUP  BY "RFM_segment"
ORDER  BY "avg_sales_per_order_segment" DESC
LIMIT 20;
```

```sql
--10) Inspect the top customers (by average sales per order) within the best-performing RFM segment
SELECT *
FROM (
      /* base table with Avg_sales_per_order + RFM tag (step 8 without LIMIT) */
      SELECT "customer_unique_id",
             "R_class" || '_' || "F_class" || '_' || "M_class"     AS "RFM_segment",
             ROUND("Monetary_value" * 1.0 / "Frequency_orders", 2) AS "Avg_sales_per_order"
      FROM (
            SELECT *,
                   CASE
                        WHEN "Recency_days" <= 30  THEN 'R_Recent'
                        WHEN "Recency_days" <= 90  THEN 'R_Moderate'
                        ELSE                           'R_Old'
                   END AS "R_class",
                   CASE
                        WHEN "Frequency_orders" >= 5 THEN 'F_Frequent'
                        WHEN "Frequency_orders" >= 3 THEN 'F_Medium'
                        ELSE                          'F_Rare'
                   END AS "F_class",
                   CASE
                        WHEN ("Monetary_value" * 1.0) / "Frequency_orders" >= 150 THEN 'M_High'
                        WHEN ("Monetary_value" * 1.0) / "Frequency_orders" >= 75  THEN 'M_Medium'
                        ELSE                                                        'M_Low'
                   END AS "M_class"
            FROM (
                  SELECT cu."customer_unique_id",
                         ROUND(julianday( (SELECT MAX("order_purchase_timestamp")
                                           FROM "orders"
                                           WHERE "order_status"='delivered')
                               ) 
                               - julianday(MAX(o."order_purchase_timestamp")), 1) AS "Recency_days",
                         COUNT(DISTINCT o."order_id")                              AS "Frequency_orders",
                         SUM(op."payment_value")                                   AS "Monetary_value"
                  FROM   "orders"         AS o
                  JOIN   "customers"      AS cu  ON o."customer_id" = cu."customer_id"
                  JOIN   "order_payments" AS op  ON o."order_id"    = op."order_id"
                  WHERE  o."order_status" = 'delivered'
                  GROUP  BY cu."customer_unique_id"
            )
      )
)
WHERE "RFM_segment" = (          /* best segment picked from query 9 result set */
      SELECT "RFM_segment"
      FROM   (
              /* re-use query 9 without LIMIT, we just need top segment */
              SELECT "RFM_segment",
                     ROUND(AVG("Avg_sales_per_order"), 2) AS "avg_sales"
              FROM (
                    SELECT "customer_unique_id",
                           "R_class" || '_' || "F_class" || '_' || "M_class"     AS "RFM_segment",
                           ROUND("Monetary_value" * 1.0 / "Frequency_orders", 2) AS "Avg_sales_per_order"
                    FROM (
                          /* aggregated R,F,M */
                          SELECT cu."customer_unique_id",
                                 ROUND(julianday( (SELECT MAX("order_purchase_timestamp")
                                                   FROM "orders"
                                                   WHERE "order_status"='delivered')
                                       ) 
                                       - julianday(MAX(o."order_purchase_timestamp")), 1) AS "Recency_days",
                                 COUNT(DISTINCT o."order_id")                              AS "Frequency_orders",
                                 SUM(op."payment_value")                                   AS "Monetary_value"
                          FROM   "orders"         AS o
                          JOIN   "customers"      AS cu  ON o."customer_id" = cu."customer_id"
                          JOIN   "order_payments" AS op  ON o."order_id"    = op."order_id"
                          WHERE  o."order_status" = 'delivered'
                          GROUP  BY cu."customer_unique_id"
                    )
              )
              GROUP BY "RFM_segment"
              ORDER BY "avg_sales" DESC
              LIMIT 1
      )
)
ORDER BY "Avg_sales_per_order" DESC
LIMIT 20;
```
