```sql
--Description: Compute the human-readable token amount (TRY_TO_NUMBER / 1e6) for
--             the 20 largest ERC-20 Transfers across all contracts, ordering by
--             that converted value.  Conversion uses TRY_TO_NUMBER so any value
--             that overflows NUMERIC simply returns NULL (and is ignored by the
--             ORDER BY).
SELECT
       "BLOCK_NUMBER",
       PARSE_JSON("ARGS")[0]::STRING                         AS "from_address_hex",
       PARSE_JSON("ARGS")[1]::STRING                         AS "to_address_hex",
       TRY_TO_NUMBER(PARSE_JSON("ARGS")[2]::STRING) / 1e6    AS "amount_6dec"
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE  "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
ORDER  BY "amount_6dec" DESC NULLS LAST
LIMIT 20;
```

