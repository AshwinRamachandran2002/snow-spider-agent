```sql
/*  Top-3 largest USDT (TRC-20) transfers on TRON  */

WITH usdt_transfers AS (
    SELECT
        "BLOCK_NUMBER",
        HEX_TO_TRON( PARSE_JSON("ARGS")[0]::STRING ) AS "from_address_tron",
        HEX_TO_TRON( PARSE_JSON("ARGS")[1]::STRING ) AS "to_address_tron",
        TRY_TO_NUMBER( PARSE_JSON("ARGS")[2]::STRING ) / 1e6  AS "usdt_amount"
    FROM  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_TRON_MAINNET_US"."DECODED_EVENTS"
    WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
      AND "ADDRESS"    = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'   -- USDT (TRON)
)

SELECT *
FROM   usdt_transfers
ORDER  BY "usdt_amount" DESC NULLS LAST
LIMIT  3;
```
