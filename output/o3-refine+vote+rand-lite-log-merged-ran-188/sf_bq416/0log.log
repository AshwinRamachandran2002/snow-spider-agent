LIMIT 20;
```

```sql
--Description: Order the converted transfers by amount in descending order to locate the largest.
SELECT "BLOCK_NUMBER",
       HEXTOTRON(PARSE_JSON("ARGS")[0]::STRING)  AS "from_tron",
       HEXTOTRON(PARSE_JSON("ARGS")[1]::STRING)  AS "to_tron",
       (PARSE_JSON("ARGS")[2]::NUMBER / 1000000) AS "amount_usdt"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
ORDER BY "amount_usdt" DESC
LIMIT 20;
```

