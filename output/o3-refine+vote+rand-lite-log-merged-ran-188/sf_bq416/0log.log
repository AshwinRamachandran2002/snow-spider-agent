Query:
--Description: 
--Return the three largest decoded ERC-20 “Transfer” events on Arbitrum-One, showing
--block, contract address, sender, receiver (hex), and the value scaled to 6-decimals.
SELECT
    block_number,
    address,
    PARSE_JSON(args)[0]::STRING                               AS from_hex,
    PARSE_JSON(args)[1]::STRING                               AS to_hex,
    TRY_TO_DECIMAL(PARSE_JSON(args)[2]::STRING,38,0)/1000000  AS usdt_amount
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE event_hash = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND TRY_TO_DECIMAL(PARSE_JSON(args)[2]::STRING,38,0) IS NOT NULL
ORDER BY usdt_amount DESC
LIMIT 3
