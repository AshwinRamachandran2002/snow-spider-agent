Query:
--Description: 
--Convert the raw token value to “amount_usdt” by dividing by 1,000,000, but first
--ensure the numeric conversion is safe with TRY_TO_DECIMAL.  The strict USDT-TRON
--address filter is removed (contract absent on this chain).  We sample generic
--ERC-20 Transfer events.
SELECT
    block_number,
    PARSE_JSON(args)[0]::STRING                      AS from_hex,
    PARSE_JSON(args)[1]::STRING                      AS to_hex,
    TRY_TO_DECIMAL(PARSE_JSON(args)[2]::STRING,38,0)/1000000 AS amount_usdt
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE event_hash = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND TRY_TO_DECIMAL(PARSE_JSON(args)[2]::STRING,38,0) IS NOT NULL
LIMIT 20
