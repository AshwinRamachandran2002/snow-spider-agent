/* ────────────────────────────────────────────────────────────────
   Create a temporary JavaScript UDF to convert an 0x-prefixed
   20-byte hex address into a Base58-encoded TRON (TronLink) address
   ──────────────────────────────────────────────────────────────── */
CREATE OR REPLACE TEMPORARY FUNCTION "HEX_TO_TRON"(hex_addr STRING)
RETURNS STRING
LANGUAGE JAVASCRIPT
AS
$$
const crypto = require('crypto');
const ALPHABET = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';

/* Base58 encoder ------------------------------------------------*/
function encode58(buf) {
  const digits = [0];
  for (let i = 0; i < buf.length; i++) {
    let carry = buf[i];
    for (let j = 0; j < digits.length; j++) {
      carry += digits[j] << 8;          // multiply previous digit by 256 and add new byte
      digits[j] = carry % 58;
      carry = (carry / 58) | 0;
    }
    while (carry) {
      digits.push(carry % 58);
      carry = (carry / 58) | 0;
    }
  }
  /* leading zeros -> leading '1's */
  let result = '';
  for (let k = 0; buf[k] === 0 && k < buf.length - 1; k++) result += '1';
  for (let q = digits.length - 1; q >= 0; q--) result += ALPHABET[digits[q]];
  return result;
}

/* Helper: hex → Buffer -----------------------------------------*/
function hexToBytes(h) {
  const out = [];
  for (let i = 0; i < h.length; i += 2) out.push(parseInt(h.substr(i, 2), 16));
  return Buffer.from(out);
}

/* Main conversion routine --------------------------------------*/
function toTron(hexAddr) {
  if (!hexAddr) return null;
  hexAddr = hexAddr.toLowerCase().replace(/^0x/, '');
  if (hexAddr.length !== 40) return null;      // must be 20-byte address
  const addrBytes = Buffer.concat([Buffer.from([0x41]), hexToBytes(hexAddr)]); // prepend TRON network byte 0x41
  const hash1 = crypto.createHash('sha256').update(addrBytes).digest();
  const hash2 = crypto.createHash('sha256').update(hash1).digest();
  const checksum = hash2.slice(0, 4);
  return encode58(Buffer.concat([addrBytes, checksum]));
}
return toTron(hex_addr);
$$;

/* ────────────────────────────────────────────────────────────────
   Query: fetch the three largest USDT transfers on TRON
   ──────────────────────────────────────────────────────────────── */
WITH usdt_transfers AS (
    SELECT
        "BLOCK_NUMBER",
        PARSE_JSON("ARGS")[0]::STRING                          AS "FROM_ADDRESS",
        PARSE_JSON("ARGS")[1]::STRING                          AS "TO_ADDRESS_HEX",
        TRY_TO_NUMBER(PARSE_JSON("ARGS")[2]::STRING) / 1000000 AS "USDT_AMOUNT"
    FROM  GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
    WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'   -- Transfer
      AND LOWER("ADDRESS") = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'                         -- TRON-USDT
      AND TRY_TO_NUMBER(PARSE_JSON("ARGS")[2]::STRING) IS NOT NULL
)
SELECT
    "BLOCK_NUMBER",
    "FROM_ADDRESS",
    HEX_TO_TRON("TO_ADDRESS_HEX") AS "TO_ADDRESS_TRON",
    "USDT_AMOUNT"
FROM  usdt_transfers
ORDER BY "USDT_AMOUNT" DESC NULLS LAST
LIMIT 3;
