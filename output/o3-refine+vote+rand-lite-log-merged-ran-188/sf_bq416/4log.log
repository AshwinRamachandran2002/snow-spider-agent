```sql
WITH usdt_transfers AS (
    SELECT
        "BLOCK_NUMBER",
        PARSE_JSON("ARGS")[0]::STRING                                AS "FROM_ADDRESS",
        PARSE_JSON("ARGS")[1]::STRING                                AS "TO_ADDRESS_HEX",
        TRY_TO_NUMBER(PARSE_JSON("ARGS")[2]::STRING) / 1_000_000     AS "USDT_AMOUNT"
    FROM   GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
    WHERE  "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'  -- Transfer events
      AND  LOWER("ADDRESS") = LOWER('0xa614f803b6fd780986a42c78ec9c7f77e6ded13c')                  -- TRON-USDT contract
      AND  TRY_TO_NUMBER(PARSE_JSON("ARGS")[2]::STRING) IS NOT NULL
)
SELECT
    "BLOCK_NUMBER",
    "FROM_ADDRESS",
    hexToTron("TO_ADDRESS_HEX")                                   AS "TO_ADDRESS_TRON",  -- convert to TronLink format
    "USDT_AMOUNT"
FROM   usdt_transfers
ORDER  BY "USDT_AMOUNT" DESC NULLS LAST
LIMIT 3;
```
