--Description: Retrieve the 20 largest ERC-20 “Transfer” amounts.  
--TRY_TO_NUMBER safely casts the raw value (3rd ARGS element) to NUMBER; rows
--that overflow Snowflake’s numeric precision convert to NULL and are removed,
--preventing the earlier error.  The value is then divided by 1 000 000 to
--express it in 6-decimal “USDT-style” units.
SELECT "BLOCK_NUMBER",
       PARSE_JSON("ARGS")[0]::STRING                              AS "FROM_HEX",
       PARSE_JSON("ARGS")[1]::STRING                              AS "TO_HEX",
       TRY_TO_NUMBER(PARSE_JSON("ARGS")[2]::STRING) / 1000000     AS "TOKEN_AMOUNT"
FROM   GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE  "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND  TRY_TO_NUMBER(PARSE_JSON("ARGS")[2]::STRING) IS NOT NULL
ORDER  BY "TOKEN_AMOUNT" DESC
LIMIT 20;
```
