    FROM   times
    WHERE (calendar_year = 2019 AND calendar_quarter_number = 4)
       OR (calendar_year = 2020 AND calendar_quarter_number = 4)
),

-- U.S. sales that were made WITHOUT a promotion
-- “Without promotion” = promo_id not present in the promotions table
us_sales AS (
    SELECT  s.amount_sold,
            s.prod_id,
            s.cust_id,
            tq.yr,
            cu.cust_city
    FROM    sales       AS s
    JOIN    time_qtr    AS tq ON s.time_id = tq.time_id
    JOIN    customers   AS cu ON s.cust_id = cu.cust_id
    JOIN    countries   AS co ON cu.country_id = co.country_id
    WHERE   co.country_iso_code = 'US'
      AND   NOT EXISTS (SELECT 1
                        FROM   promotions p
                        WHERE  p.promo_id = s.promo_id)
),

-- city‑level totals per quarter
city_qtr_sales AS (
    SELECT  cust_city AS city,
            yr,
            SUM(amount_sold) AS total_sales
    FROM    us_sales
    GROUP BY cust_city, yr
),

-- cities whose Q4 2020 sales grew at least 20 % over Q4 2019
city_growth AS (
    SELECT  c19.city
    FROM    city_qtr_sales c19
    JOIN    city_qtr_sales c20
           ON c19.city = c20.city
          AND c19.yr   = 2019
          AND c20.yr   = 2020
    WHERE   c20.total_sales >= 1.2 * c19.total_sales
      AND   c19.total_sales > 0
),

-- sales only from the growing cities
filtered_sales AS (
    SELECT *
    FROM   us_sales
    WHERE  cust_city IN (SELECT city FROM city_growth)
),

-- total amount per product (both years together) in those cities
product_totals AS (
    SELECT  prod_id,
            SUM(amount_sold) AS total_amt
    FROM    filtered_sales
    GROUP BY prod_id
),

-- rank products, keep the top 20 %
ranked_products AS (
    SELECT  prod_id,
            NTILE(5) OVER (ORDER BY total_amt DESC) AS bucket
    FROM    product_totals
),
top_products AS (
    SELECT prod_id
    FROM   ranked_products
    WHERE  bucket = 1          -- top 20 %
),

-- product × year totals for the chosen products
product_qtr_sales AS (
    SELECT  fs.prod_id,
            fs.yr,
            SUM(fs.amount_sold) AS amt
    FROM    filtered_sales fs
    WHERE   fs.prod_id IN (SELECT prod_id FROM top_products)
    GROUP BY fs.prod_id, fs.yr
),

-- overall city‑set totals per year
total_qtr_sales AS (
    SELECT  yr,
            SUM(amount_sold) AS total_amt
    FROM    filtered_sales
    GROUP BY yr
),

-- shares for every top product per year
product_shares AS (
