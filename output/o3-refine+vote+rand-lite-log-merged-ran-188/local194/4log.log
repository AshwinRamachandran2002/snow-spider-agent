```sql
-- 1) Take a quick look at the list of actors
SELECT DISTINCT
       "actor_id",
       "first_name",
       "last_name"
FROM   "actor"
LIMIT 20;
```

```sql
-- 2) See which films exist and their titles
SELECT DISTINCT
       "film_id",
       "title"
FROM   "film"
LIMIT 20;
```

```sql
-- 3) Find every film that ever produced revenue
SELECT DISTINCT
       i."film_id"
FROM   "payment"  AS p
JOIN   "rental"   AS r ON p."rental_id"   = r."rental_id"
JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
LIMIT 20;
```

```sql
-- 4) Aggregate total revenue earned by each film
SELECT
       i."film_id",
       SUM(p."amount") AS "film_revenue"
FROM   "payment"  AS p
JOIN   "rental"   AS r ON p."rental_id"   = r."rental_id"
JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
GROUP BY i."film_id"
ORDER BY "film_revenue" DESC
LIMIT 20;
```

```sql
-- 5) How many actors appear in every film?
SELECT
       fa."film_id",
       COUNT(DISTINCT fa."actor_id") AS "num_actors"
FROM   "film_actor" AS fa
GROUP BY fa."film_id"
ORDER BY "num_actors" DESC
LIMIT 20;
```

```sql
-- 6) Join the two previous queries to compute each actor’s share of a film’s revenue
WITH film_rev AS (
     SELECT i."film_id",
            SUM(p."amount") AS "total_revenue"
     FROM   "payment"  AS p
     JOIN   "rental"   AS r ON p."rental_id"   = r."rental_id"
     JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
     GROUP BY i."film_id"
), actor_cnt AS (
     SELECT fa."film_id",
            COUNT(DISTINCT fa."actor_id") AS "num_actors"
     FROM   "film_actor" AS fa
     GROUP BY fa."film_id"
)
SELECT
       fa."actor_id",
       fr."film_id",
       fr."total_revenue" / ac."num_actors" AS "actor_revenue_share"
FROM   "film_actor" AS fa
JOIN   film_rev  AS fr ON fa."film_id" = fr."film_id"
JOIN   actor_cnt AS ac ON fa."film_id" = ac."film_id"
LIMIT 20;
```

```sql
-- 7) Add the film titles to the previous result
WITH film_rev AS (
     SELECT i."film_id",
            SUM(p."amount") AS "total_revenue"
     FROM   "payment"  AS p
     JOIN   "rental"   AS r ON p."rental_id"   = r."rental_id"
     JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
     GROUP BY i."film_id"
), actor_cnt AS (
     SELECT fa."film_id",
            COUNT(DISTINCT fa."actor_id") AS "num_actors"
     FROM   "film_actor" AS fa
     GROUP BY fa."film_id"
)
SELECT
       fa."actor_id",
       f."title",
       fr."total_revenue" / ac."num_actors" AS "actor_revenue_share"
FROM   "film_actor" AS fa
JOIN   film_rev  AS fr ON fa."film_id" = fr."film_id"
JOIN   actor_cnt AS ac ON fa."film_id" = ac."film_id"
JOIN   "film"     AS f  ON fa."film_id" = f."film_id"
LIMIT 20;
```

```sql
-- 8) Rank every actor’s films by that per-actor revenue
WITH film_rev AS (
     SELECT i."film_id",
            SUM(p."amount") AS "total_revenue"
     FROM   "payment"  AS p
     JOIN   "rental"   AS r ON p."rental_id"   = r."rental_id"
     JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
     GROUP BY i."film_id"
), actor_cnt AS (
     SELECT fa."film_id",
            COUNT(DISTINCT fa."actor_id") AS "num_actors"
     FROM   "film_actor" AS fa
     GROUP BY fa."film_id"
), actor_film AS (
     SELECT
            fa."actor_id",
            f."title",
            fr."total_revenue" / ac."num_actors" AS "actor_revenue",
            ROW_NUMBER() OVER (PARTITION BY fa."actor_id"
                               ORDER BY fr."total_revenue" / ac."num_actors" DESC) AS "rk"
     FROM   "film_actor" AS fa
     JOIN   film_rev  AS fr ON fa."film_id" = fr."film_id"
     JOIN   actor_cnt AS ac ON fa."film_id" = ac."film_id"
     JOIN   "film"     AS f  ON fa."film_id" = f."film_id"
)
SELECT * FROM actor_film
WHERE  "rk" <= 3
LIMIT 20;
```

```sql
-- 9) Add the actor’s name and compute the average of his/her TOP-3 films
WITH film_rev AS (
     SELECT i."film_id",
            SUM(p."amount") AS "total_revenue"
     FROM   "payment"  AS p
     JOIN   "rental"   AS r ON p."rental_id"   = r."rental_id"
     JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
     GROUP BY i."film_id"
), actor_cnt AS (
     SELECT fa."film_id",
            COUNT(DISTINCT fa."actor_id") AS "num_actors"
     FROM   "film_actor" AS fa
     GROUP BY fa."film_id"
), actor_film AS (
     SELECT
            fa."actor_id",
            f."title",
            fr."total_revenue" / ac."num_actors" AS "actor_revenue",
            ROW_NUMBER() OVER (PARTITION BY fa."actor_id"
                               ORDER BY fr."total_revenue" / ac."num_actors" DESC) AS "rk"
     FROM   "film_actor" AS fa
     JOIN   film_rev  AS fr ON fa."film_id" = fr."film_id"
     JOIN   actor_cnt AS ac ON fa."film_id" = ac."film_id"
     JOIN   "film"     AS f  ON fa."film_id" = f."film_id"
), top3 AS (
     SELECT *
     FROM   actor_film
     WHERE  "rk" <= 3
)
SELECT
       a."actor_id",
       a."first_name",
       a."last_name",
       t."title"               AS "film_title",
       ROUND(t."actor_revenue",2) AS "actor_revenue",
       ROUND(AVG(t."actor_revenue") OVER (PARTITION BY a."actor_id"),2) 
                              AS "avg_top3_revenue"
FROM   top3 AS t
JOIN   "actor" AS a ON t."actor_id" = a."actor_id"
ORDER BY a."actor_id",
         t."actor_revenue" DESC;
```

```sql
-- 10) (Final answer) Same as #9 but without LIMIT to list the full result set
WITH film_rev AS (
     SELECT i."film_id",
            SUM(p."amount") AS "total_revenue"
     FROM   "payment"  AS p
     JOIN   "rental"   AS r ON p."rental_id"   = r."rental_id"
     JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
     GROUP BY i."film_id"
), actor_cnt AS (
     SELECT fa."film_id",
            COUNT(DISTINCT fa."actor_id") AS "num_actors"
     FROM   "film_actor" AS fa
     GROUP BY fa."film_id"
), actor_film AS (
     SELECT
            fa."actor_id",
            f."title",
            fr."total_revenue" / ac."num_actors" AS "actor_revenue",
            ROW_NUMBER() OVER (PARTITION BY fa."actor_id"
                               ORDER BY fr."total_revenue" / ac."num_actors" DESC) AS "rk"
     FROM   "film_actor" AS fa
     JOIN   film_rev  AS fr ON fa."film_id" = fr."film_id"
     JOIN   actor_cnt AS ac ON fa."film_id" = ac."film_id"
     JOIN   "film"     AS f  ON fa."film_id" = f."film_id"
), top3 AS (
     SELECT *
     FROM   actor_film
     WHERE  "rk" <= 3
)
SELECT
       a."actor_id",
       a."first_name",
       a."last_name",
       t."title"               AS "film_title",
       ROUND(t."actor_revenue",2) AS "actor_revenue",
       ROUND(AVG(t."actor_revenue") OVER (PARTITION BY a."actor_id"),2) 
                              AS "avg_top3_revenue"
FROM   top3 AS t
JOIN   "actor" AS a ON t."actor_id" = a."actor_id"
ORDER BY a."actor_id",
         t."actor_revenue" DESC;
```
