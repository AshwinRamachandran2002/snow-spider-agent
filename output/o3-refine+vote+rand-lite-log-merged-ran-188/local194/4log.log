Query:
-- 6) Join the two previous queries to compute each actor’s share of a film’s revenue
WITH film_rev AS (
     SELECT i."film_id",
            SUM(p."amount") AS "total_revenue"
     FROM   "payment"  AS p
     JOIN   "rental"   AS r ON p."rental_id"   = r."rental_id"
     JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
     GROUP BY i."film_id"
), actor_cnt AS (
     SELECT fa."film_id",
            COUNT(DISTINCT fa."actor_id") AS "num_actors"
     FROM   "film_actor" AS fa
     GROUP BY fa."film_id"
)
SELECT
       fa."actor_id",
       fr."film_id",
       fr."total_revenue" / ac."num_actors" AS "actor_revenue_share"
FROM   "film_actor" AS fa
JOIN   film_rev  AS fr ON fa."film_id" = fr."film_id"
JOIN   actor_cnt AS ac ON fa."film_id" = ac."film_id"
LIMIT 20;
