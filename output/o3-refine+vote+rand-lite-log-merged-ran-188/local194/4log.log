Query:
-- 9) Add the actor’s name and compute the average of his/her TOP-3 films
WITH film_rev AS (
     SELECT i."film_id",
            SUM(p."amount") AS "total_revenue"
     FROM   "payment"  AS p
     JOIN   "rental"   AS r ON p."rental_id"   = r."rental_id"
     JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
     GROUP BY i."film_id"
), actor_cnt AS (
     SELECT fa."film_id",
            COUNT(DISTINCT fa."actor_id") AS "num_actors"
     FROM   "film_actor" AS fa
     GROUP BY fa."film_id"
), actor_film AS (
     SELECT
            fa."actor_id",
            f."title",
            fr."total_revenue" / ac."num_actors" AS "actor_revenue",
            ROW_NUMBER() OVER (PARTITION BY fa."actor_id"
                               ORDER BY fr."total_revenue" / ac."num_actors" DESC) AS "rk"
     FROM   "film_actor" AS fa
     JOIN   film_rev  AS fr ON fa."film_id" = fr."film_id"
     JOIN   actor_cnt AS ac ON fa."film_id" = ac."film_id"
     JOIN   "film"     AS f  ON fa."film_id" = f."film_id"
), top3 AS (
     SELECT *
     FROM   actor_film
     WHERE  "rk" <= 3
)
SELECT
       a."actor_id",
       a."first_name",
       a."last_name",
       t."title"               AS "film_title",
       ROUND(t."actor_revenue",2) AS "actor_revenue",
       ROUND(AVG(t."actor_revenue") OVER (PARTITION BY a."actor_id"),2) 
                              AS "avg_top3_revenue"
FROM   top3 AS t
JOIN   "actor" AS a ON t."actor_id" = a."actor_id"
ORDER BY a."actor_id",
         t."actor_revenue" DESC;
