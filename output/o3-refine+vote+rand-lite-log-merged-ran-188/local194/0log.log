```sql
--Description: 8) Rank each actor’s films by their individual revenue share and keep the top three (sample of 20 rows).
WITH actor_film AS (                               -- revenue per actor-film
        SELECT fa."actor_id",
               f."film_id",
               f."title",
               SUM(p."amount") / COUNT(DISTINCT fa2."actor_id") AS actor_share
        FROM   "payment"   p
        JOIN   "rental"    r  ON p."rental_id"  = r."rental_id"
        JOIN   "inventory" i  ON r."inventory_id" = i."inventory_id"
        JOIN   "film"      f  ON i."film_id"      = f."film_id"
        JOIN   "film_actor" fa  ON f."film_id"    = fa."film_id"
        JOIN   "film_actor" fa2 ON fa2."film_id"  = f."film_id"   -- to count cast
        GROUP  BY fa."actor_id", f."film_id"
), ranked AS (                                      -- rank films within each actor
        SELECT actor_id,
               title,
               ROUND(actor_share,2) AS actor_share,
               ROW_NUMBER() OVER (PARTITION BY actor_id
                                  ORDER BY actor_share DESC) AS rn
        FROM   actor_film
)
SELECT *
FROM   ranked
WHERE  rn <= 3
LIMIT  20;
```

