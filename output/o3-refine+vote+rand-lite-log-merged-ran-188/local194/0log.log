--Description: 9) Add the actor’s full name to the ranked result for readability (sample of 20 rows).
WITH actor_film AS (
        SELECT fa."actor_id",
               f."film_id",
               f."title",
               SUM(p."amount") / COUNT(DISTINCT fa2."actor_id") AS actor_share
        FROM   "payment"   p
