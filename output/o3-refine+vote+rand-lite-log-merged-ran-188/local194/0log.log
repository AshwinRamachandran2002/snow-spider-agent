```sql
--Description: 1) Look at a few distinct films and their IDs.
SELECT DISTINCT "film_id", "title"
FROM "film"
LIMIT 20;
```

```sql
--Description: 2) Inspect some payment facts (each row is one customer payment for a rental).
SELECT DISTINCT "payment_id", "rental_id", "amount"
FROM "payment"
LIMIT 20;
```

```sql
--Description: 3) See how a rental maps to an inventory item (which then maps to a film).
SELECT DISTINCT r."rental_id", r."inventory_id", i."film_id"
FROM "rental" AS r
JOIN "inventory" AS i ON r."inventory_id" = i."inventory_id"
LIMIT 20;
```

```sql
--Description: 4) Verify the link all the way to the film title for a sample of rentals.
SELECT DISTINCT r."rental_id", f."film_id", f."title"
FROM "rental"  AS r
JOIN "inventory" AS i ON r."inventory_id" = i."inventory_id"
JOIN "film"     AS f ON i."film_id"      = f."film_id"
LIMIT 20;
```

```sql
--Description: 5) Aggregate: total revenue per film (all payments summed).
SELECT i."film_id", f."title", SUM(p."amount") AS "film_revenue"
FROM   "payment"  AS p
JOIN   "rental"   AS r ON p."rental_id"  = r."rental_id"
JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
JOIN   "film"      AS f ON i."film_id"      = f."film_id"
GROUP  BY i."film_id", f."title"
LIMIT 20;
```

```sql
--Description: 6) Count how many actors appear in each film; needed later to split revenue equally.
SELECT fa."film_id", COUNT(*) AS "actor_cnt"
FROM   "film_actor" AS fa
GROUP  BY fa."film_id"
LIMIT 20;
```

```sql
--Description: 7) Combine film revenue with actor counts to compute each actor’s share for a sample.
SELECT  fa."actor_id",
        frev."film_id",
        frev."title",
        ROUND(frev."film_revenue" * 1.0 / ac."actor_cnt", 2) AS "actor_share"
FROM  (SELECT i."film_id", SUM(p."amount") AS "film_revenue"
       FROM   "payment"  AS p
       JOIN   "rental"   AS r ON p."rental_id"  = r."rental_id"
       JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
       GROUP  BY i."film_id") AS frev
JOIN  "film"        AS f  ON frev."film_id" = f."film_id"
JOIN  "film_actor"  AS fa ON frev."film_id" = fa."film_id"
JOIN  (SELECT "film_id", COUNT(*) AS "actor_cnt"
       FROM "film_actor"
       GROUP BY "film_id") AS ac ON ac."film_id" = f."film_id"
LIMIT 20;
```

```sql
--Description: 8) Rank each actor’s films by their individual revenue share and keep the top three.
SELECT *
FROM (
      SELECT  fa."actor_id",
              f."title",
              ROUND(SUM(p."amount") / COUNT(fa2."actor_id"), 2) AS "actor_share",
              ROW_NUMBER() OVER (PARTITION BY fa."actor_id" 
                                 ORDER BY SUM(p."amount") / COUNT(fa2."actor_id") DESC) AS rn
      FROM   "payment"  AS p
      JOIN   "rental"   AS r  ON p."rental_id"  = r."rental_id"
      JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
      JOIN   "film"      AS f ON i."film_id"      = f."film_id"
      JOIN   "film_actor" AS fa ON f."film_id"    = fa."film_id"
      JOIN   "film_actor" AS fa2 ON fa2."film_id" = f."film_id"   -- to count actors
      GROUP  BY fa."actor_id", f."film_id"
) 
WHERE rn <= 3
LIMIT 20;
```

```sql
--Description: 9) Add the actor’s name to the previous ranking result for readability.
SELECT  a."first_name" || ' ' || a."last_name" AS "actor_name",
        t."title",
        t."actor_share"
FROM (
      SELECT  fa."actor_id",
              f."title",
              ROUND(SUM(p."amount") / COUNT(fa2."actor_id"), 2) AS "actor_share",
              ROW_NUMBER() OVER (PARTITION BY fa."actor_id" 
                                 ORDER BY SUM(p."amount") / COUNT(fa2."actor_id") DESC) AS rn
      FROM   "payment"  AS p
      JOIN   "rental"   AS r  ON p."rental_id"  = r."rental_id"
      JOIN   "inventory" AS i ON r."inventory_id" = i."inventory_id"
      JOIN   "film"      AS f ON i."film_id"      = f."film_id"
      JOIN   "film_actor" AS fa  ON f."film_id"   = fa."film_id"
      JOIN   "film_actor" AS fa2 ON fa2."film_id" = f."film_id"
      GROUP  BY fa."actor_id", f."film_id"
) AS t
JOIN "actor" AS a ON a."actor_id" = t."actor_id"
WHERE t.rn <= 3
LIMIT 20;
```

```sql
--Description: 10) Final answer – full list (no LIMIT) of each actor’s top-3 revenue-generating films and their average revenue share.
SELECT  a."actor_id",
        a."first_name" || ' ' || a."last_name" AS "actor_name",
        sub."title"        AS "film_title",
        sub."actor_share"  AS "avg_revenue_for_actor"
FROM (
      SELECT  fa."actor_id",
              f."title",
              ROUND(SUM(p."amount") / COUNT(fa2."actor_id"), 2) AS "actor_share",
              ROW_NUMBER() OVER (PARTITION BY fa."actor_id"
                                 ORDER BY SUM(p."amount") / COUNT(fa2."actor_id") DESC) AS rn
      FROM   "payment"   AS p
      JOIN   "rental"    AS r  ON p."rental_id"  = r."rental_id"
      JOIN   "inventory" AS i  ON r."inventory_id" = i."inventory_id"
      JOIN   "film"      AS f  ON i."film_id"      = f."film_id"
      JOIN   "film_actor" AS fa ON f."film_id"     = fa."film_id"
      JOIN   "film_actor" AS fa2 ON fa2."film_id"  = f."film_id"
      GROUP  BY fa."actor_id", f."film_id"
) AS sub
JOIN "actor" AS a ON a."actor_id" = sub."actor_id"
WHERE sub.rn <= 3
ORDER BY a."actor_id", sub."actor_share" DESC, sub."title";
```
