--Description: 10) Final answer – full list (no LIMIT) of each actor’s top-3 revenue-generating films and their average revenue share.
WITH actor_film AS (
        SELECT fa."actor_id",
               f."film_id",
               f."title",
               SUM(p."amount") / COUNT(DISTINCT fa2."actor_id") AS actor_share
        FROM   "payment"   p
        JOIN   "rental"    r  ON p."rental_id"  = r."rental_id"
        JOIN   "inventory" i  ON r."inventory_id" = i."inventory_id"
        JOIN   "film"      f  ON i."film_id"      = f."film_id"
        JOIN   "film_actor" fa  ON f."film_id"    = fa."film_id"
        JOIN   "film_actor" fa2 ON fa2."film_id"  = f."film_id"
        GROUP  BY fa."actor_id", f."film_id"
), ranked AS (
        SELECT actor_id,
               title,
               ROUND(actor_share,2) AS actor_share,
               ROW_NUMBER() OVER (PARTITION BY actor_id
                                  ORDER BY actor_share DESC) AS rn
        FROM   actor_film
)
SELECT  a."actor_id",
        a."first_name" || ' ' || a."last_name" AS actor_name,
        r."title"       AS film_title,
        r."actor_share" AS avg_revenue_for_actor
FROM    ranked r
JOIN    "actor" a ON a."actor_id" = r."actor_id"
WHERE   r.rn <= 3
ORDER   BY a."actor_id", r."actor_share" DESC, r."title"
