```sql
--Description: We need each actor’s three highest-earning films, where an actor’s “earnings” from a film
--             are the film’s total revenue divided equally among its cast.
--             Thinking process (encoded directly in CTE order):
--               1. film_rev   – sum all payment amounts per film (total revenue).
--               2. actor_cnt  – count how many actors appear in each film.
--               3. actor_rev  – compute every actor’s share: revenue ÷ actor_cnt.
--               4. ranked     – rank an actor’s films by that share.
--               5. final      – keep rank ≤ 3, add actor name, present results.
--             LIMIT 20 shown only for quick verification; remove for full report.
WITH film_rev AS (
        SELECT i."film_id",
               SUM(p."amount") AS film_revenue
        FROM   "payment"   p
        JOIN   "rental"    r ON p."rental_id"  = r."rental_id"
        JOIN   "inventory" i ON r."inventory_id" = i."inventory_id"
        GROUP  BY i."film_id"
),
actor_cnt AS (
        SELECT "film_id",
               COUNT(*) AS actor_cnt
        FROM   "film_actor"
        GROUP  BY "film_id"
),
actor_rev AS (
        SELECT fa."actor_id",
               fr."film_id",
               fr.film_revenue * 1.0 / ac.actor_cnt AS actor_share
        FROM   "film_actor" fa
        JOIN   film_rev  fr ON fr."film_id" = fa."film_id"
        JOIN   actor_cnt ac ON ac."film_id" = fa."film_id"
),
ranked AS (
        SELECT ar."actor_id",
               f."title",
               ROUND(ar.actor_share, 2) AS actor_share,
               ROW_NUMBER() OVER (PARTITION BY ar."actor_id"
                                  ORDER BY ar.actor_share DESC) AS rn
        FROM   actor_rev ar
        JOIN   "film"    f ON f."film_id" = ar."film_id"
)
SELECT  a."actor_id",
        a."first_name" || ' ' || a."last_name" AS actor_name,
        r."title"        AS film_title,
        r."actor_share"  AS avg_revenue_for_actor
FROM    ranked r
JOIN    "actor" a ON a."actor_id" = r."actor_id"
WHERE   r.rn <= 3
ORDER   BY a."actor_id", r.actor_share DESC, r."title"
LIMIT   20;
```
