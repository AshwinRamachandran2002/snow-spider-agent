                 (x,i) => x / NULLIFZERO( SQRT( ARRAY_SUM( ARRAY_TRANSFORM(n."vec",(y,j)=>y*y) ) ) )
             ) AS "norm_vector"
     FROM    agg n
)
SELECT  normed."id"                     AS "article_id",
