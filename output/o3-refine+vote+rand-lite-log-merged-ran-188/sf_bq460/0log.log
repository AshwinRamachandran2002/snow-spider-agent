--Description: 9) Explode each normalised vector, giving one row per
--              (article_id, dimension_index, value).  ARRAY_AGG … WITHIN GROUP
--              ensures ordered vectors; FLATTEN column names are quoted.
WITH summed AS (
    SELECT  t."id",
            dims."INDEX"                                    AS dim_index,
            SUM(dims."VALUE"::FLOAT /
                POWER(COALESCE(wf."frequency",1),0.4))      AS weighted_sum
    FROM  "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"      t
    CROSS JOIN LATERAL FLATTEN(
