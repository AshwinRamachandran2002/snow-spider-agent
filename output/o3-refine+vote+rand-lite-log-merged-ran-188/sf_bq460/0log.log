```sql
-- 4) Description: Join the produced tokens to the WORD_FREQUENCIES table so that
--    each token also carries its corpus frequency.
SELECT tok."word",
       wf."frequency"
FROM  (
        SELECT tok.value::STRING AS "word"
        FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" t,
               LATERAL FLATTEN(
                       INPUT => "spider2-public-data".word_vectors_us.tokenise_no_stop(t."body")
               ) tok
        WHERE  t."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
      ) tok
LEFT  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
       ON wf."word" = tok."word"
LIMIT 20;
```

```sql
-- 5) Description: Extend the previous join so that each token additionally
--    carries its GloVe vector (stored as a VARIANT array).
SELECT tok."word",
       wf."frequency",
       gv."vector"
FROM  (
        SELECT tok.value::STRING AS "word"
        FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" t,
               LATERAL FLATTEN(
                       INPUT => "spider2-public-data".word_vectors_us.tokenise_no_stop(t."body")
               ) tok
        WHERE  t."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
      ) tok
JOIN  "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
      ON wf."word" = tok."word"
JOIN  "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
      ON gv."word" = tok."word"
LIMIT 20;
```

```sql
-- 6) Description: For *all* Nature articles, compute the per-dimension, frequency-
--    weighted sum of vectors (vector/ frequency^0.4) – one row per article & 
--    dimension.  Only 20 rows are previewed.
SELECT t."id",
       dims.index            AS "dim_index",
       SUM( dims.value::FLOAT / POWER(wf."frequency", 0.4) ) AS "weighted_sum"
FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" t
       ,LATERAL FLATTEN(
              INPUT => "spider2-public-data".word_vectors_us.tokenise_no_stop(t."body")
       ) tok
       LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
              ON wf."word" = tok.value::STRING
       JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
              ON gv."word" = tok.value::STRING
       ,LATERAL FLATTEN( INPUT => gv."vector" ) dims
GROUP  BY t."id", dims.index
LIMIT 20;
```

```sql
-- 7) Description: Collapse the per-dimension rows back into an ordered array so
--    each article now has its full aggregate vector.
WITH summed AS (
      SELECT t."id",
             dims.index AS "dim_index",
             SUM( dims.value::FLOAT / POWER(wf."frequency", 0.4) ) AS "weighted_sum"
      FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" t
             ,LATERAL FLATTEN(
                    INPUT => "spider2-public-data".word_vectors_us.tokenise_no_stop(t."body")
             ) tok
             LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
                    ON wf."word" = tok.value::STRING
             JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
                    ON gv."word" = tok.value::STRING
             ,LATERAL FLATTEN( INPUT => gv."vector" ) dims
      GROUP  BY t."id", dims.index
)
SELECT  "id",
        ARRAY_AGG("weighted_sum" ORDER BY "dim_index") AS "agg_vector"
FROM    summed
GROUP   BY "id"
LIMIT   20;
```

```sql
-- 8) Description: Compute the L2-norm of each aggregate vector and build a
--    normalised (unit-length) vector for every article.
WITH agg AS (
      SELECT  "id",
              ARRAY_AGG("weighted_sum" ORDER BY "dim_index") AS "vec"
      FROM   (
              SELECT t."id",
                     dims.index AS "dim_index",
                     SUM(dims.value::FLOAT / POWER(wf."frequency", 0.4)) AS "weighted_sum"
              FROM   "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" t
                     ,LATERAL FLATTEN(
                            INPUT => "spider2-public-data".word_vectors_us.tokenise_no_stop(t."body")
                     ) tok
                     LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
                            ON wf."word" = tok.value::STRING
                     JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
                            ON gv."word" = tok.value::STRING
                     ,LATERAL FLATTEN( INPUT => gv."vector" ) dims
              GROUP  BY t."id", dims.index
             )
      GROUP BY "id"
)
SELECT  "id",
        "vec"                                           AS "agg_vector",
        SQRT( ARRAY_SUM( ARRAY_TRANSFORM("vec", (x,i) => x*x) ) ) AS "norm",
        ARRAY_TRANSFORM(
            "vec",
            (x,i) => IFF(
                          SQRT(ARRAY_SUM(ARRAY_TRANSFORM("vec",(y,j)=>y*y))) = 0,
                          0,
                          x / SQRT(ARRAY_SUM(ARRAY_TRANSFORM("vec",(y,j)=>y*y)))
                         )
        )                                               AS "norm_vector"
FROM    agg
LIMIT   20;
```

```sql
-- 9) Description: Prepare a helper view that explodes every article’s normalised
--    vector, keeping one row per (article, dimension) so that dot-products can
--    be calculated.
WITH normed AS ( /* same content as previous CTE ‘agg’ + norm computation */ )
SELECT  n."id"                       AS "article_id",
        n."date",
        n."title",
        f.index                      AS "dim_index",
        f.value::FLOAT               AS "dim_value"
FROM    normed n,
        LATERAL FLATTEN( INPUT => n."norm_vector" ) f
LIMIT   20;
```

```sql
-- 10) Description: Compute cosine similarity between the reference article and
--     all others; return the ten most-similar articles (ID, date, title,
--     similarity score).
WITH normed AS ( /* build normalised vectors for every article, as in step 8 */ ),
     base   AS (
         SELECT  f.index AS idx,
                 f.value::FLOAT AS val
         FROM    normed,
                 LATERAL FLATTEN( INPUT => normed."norm_vector" ) f
         WHERE   normed."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
     ),
     others AS (
         SELECT  n."id",
                 n."date",
                 n."title",
                 f.index        AS idx,
                 f.value::FLOAT AS val
         FROM    normed n,
                 LATERAL FLATTEN( INPUT => n."norm_vector" ) f
         WHERE   n."id" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
     )
SELECT  o."id",
        o."date",
        o."title",
        SUM( b.val * o.val ) AS "cosine_similarity"
FROM    base b
JOIN    others o
  ON    o.idx = b.idx
GROUP  BY o."id", o."date", o."title"
ORDER BY "cosine_similarity" DESC
LIMIT  10;
```
