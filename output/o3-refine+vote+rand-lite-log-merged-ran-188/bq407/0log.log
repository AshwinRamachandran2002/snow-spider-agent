```sql
--Description: 4) Join COVID data for 27-Aug-2020 with 2020 census data (all counties, keep raw fields).  
SELECT s.county_fips_code,
       s.county_name,
       s.state,
       c.total_pop,
       c.median_age,
       s.confirmed_cases,
       s.deaths
FROM   `bigquery-public-data.covid19_usafacts.summary`        AS s
JOIN   `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c
ON     s.county_fips_code = LPAD(c.geo_id,5,'0')
WHERE  s.date = '2020-08-27'
LIMIT  20;
```

```sql
--Description: 5) From the joined data, keep only counties with population > 50,000.  
SELECT county_fips_code,
       county_name,
       state,
       total_pop
FROM   (
        SELECT s.county_fips_code,
               s.county_name,
               s.state,
               c.total_pop
        FROM   `bigquery-public-data.covid19_usafacts.summary`        AS s
        JOIN   `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c
        ON     s.county_fips_code = LPAD(c.geo_id,5,'0')
        WHERE  s.date = '2020-08-27'
       )
WHERE  total_pop > 50000
LIMIT  20;
```

```sql
--Description: 6) Compute per-100k confirmed cases & deaths plus case-fatality rate (CFR %) for pop >50k.  
SELECT county_name,
       state,
       confirmed_cases / total_pop * 100000 AS cases_per_100k,
       deaths          / total_pop * 100000 AS deaths_per_100k,
       SAFE_DIVIDE(deaths, confirmed_cases) * 100 AS cfr_pct
FROM   (
        SELECT s.county_name,
               s.state,
               c.total_pop,
               s.confirmed_cases,
               s.deaths
        FROM   `bigquery-public-data.covid19_usafacts.summary`        AS s
        JOIN   `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c
        ON     s.county_fips_code = LPAD(c.geo_id,5,'0')
        WHERE  s.date = '2020-08-27'
          AND  c.total_pop > 50000
       )
ORDER  BY cfr_pct DESC
LIMIT  20;
```

```sql
--Description: 7) Show top 10 counties (pop>50k) with highest CFR, bringing median age too.  
SELECT county_name,
       state,
       median_age,
       total_pop,
       ROUND(confirmed_cases / total_pop * 100000, 1) AS cases_per_100k,
       ROUND(deaths          / total_pop * 100000, 1) AS deaths_per_100k,
       ROUND(SAFE_DIVIDE(deaths, confirmed_cases) * 100, 2) AS cfr_pct
FROM   (
        SELECT s.county_name,
               s.state,
               c.median_age,
               c.total_pop,
               s.confirmed_cases,
               s.deaths
        FROM   `bigquery-public-data.covid19_usafacts.summary`        AS s
        JOIN   `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c
        ON     s.county_fips_code = LPAD(c.geo_id,5,'0')
        WHERE  s.date = '2020-08-27'
          AND  c.total_pop > 50000
       )
ORDER  BY cfr_pct DESC
LIMIT  10;
```

```sql
--Description: 8) Final answer – top 3 counties (pop>50k) with highest COVID-19 case fatality rates on 27-Aug-2020.  
SELECT county_name               AS county,
       state,
       median_age,
       total_pop,
       ROUND(confirmed_cases / total_pop * 100000, 1) AS cases_per_100k,
       ROUND(deaths          / total_pop * 100000, 1) AS deaths_per_100k,
       ROUND(SAFE_DIVIDE(deaths, confirmed_cases) * 100, 2) AS case_fatality_rate_pct
FROM   (
        SELECT s.county_name,
               s.state,
               c.median_age,
               c.total_pop,
               s.confirmed_cases,
               s.deaths
        FROM   `bigquery-public-data.covid19_usafacts.summary`        AS s
        JOIN   `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c
        ON     s.county_fips_code = LPAD(c.geo_id,5,'0')
        WHERE  s.date = '2020-08-27'
          AND  c.total_pop > 50000
       )
ORDER  BY case_fatality_rate_pct DESC
LIMIT  3;
```

```sql
--Description: 9) (Optional) Check distinct states represented in the final top-3 output.  
SELECT DISTINCT state
FROM (
      SELECT s.state,
             SAFE_DIVIDE(s.deaths, s.confirmed_cases) AS cfr
      FROM   `bigquery-public-data.covid19_usafacts.summary`        AS s
      JOIN   `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c
      ON     s.county_fips_code = LPAD(c.geo_id,5,'0')
      WHERE  s.date = '2020-08-27'
        AND  c.total_pop > 50000
     )
ORDER  BY state
LIMIT  20;
```

```sql
--Description: 10) (Optional) Retrieve the raw figures for confirmed cases & deaths for the final 3 counties.  
SELECT county_name,
       state,
       confirmed_cases,
       deaths
FROM   `bigquery-public-data.covid19_usafacts.summary`
WHERE  date = '2020-08-27'
  AND  LPAD(county_fips_code,5,'0') IN (
        SELECT LPAD(geo_id,5,'0')
        FROM   `bigquery-public-data.census_bureau_acs.county_2020_5yr`
        WHERE  total_pop > 50000
        ORDER  BY total_pop DESC
        LIMIT  200 -- large enough list; actual join in query 8 narrowed to 3
       )
LIMIT  20;
