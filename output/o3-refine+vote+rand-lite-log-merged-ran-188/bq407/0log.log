Query:
--Description: 6) Compute per-100k confirmed cases & deaths plus case-fatality rate (CFR %) for pop >50k.  
SELECT county_name,
       state,
       confirmed_cases / total_pop * 100000 AS cases_per_100k,
       deaths          / total_pop * 100000 AS deaths_per_100k,
       SAFE_DIVIDE(deaths, confirmed_cases) * 100 AS cfr_pct
FROM   (
        SELECT s.county_name,
               s.state,
               c.total_pop,
               s.confirmed_cases,
               s.deaths
        FROM   `bigquery-public-data.covid19_usafacts.summary`        AS s
        JOIN   `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c
        ON     s.county_fips_code = LPAD(c.geo_id,5,'0')
        WHERE  s.date = '2020-08-27'
          AND  c.total_pop > 50000
       )
ORDER  BY cfr_pct DESC
LIMIT  20;
