Query:
--Description: 4) Join COVID data for 27-Aug-2020 with 2020 census data (all counties, keep raw fields).  
SELECT s.county_fips_code,
       s.county_name,
       s.state,
       c.total_pop,
       c.median_age,
       s.confirmed_cases,
       s.deaths
FROM   `bigquery-public-data.covid19_usafacts.summary`        AS s
JOIN   `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c
ON     s.county_fips_code = LPAD(c.geo_id,5,'0')
WHERE  s.date = '2020-08-27'
LIMIT  20;
