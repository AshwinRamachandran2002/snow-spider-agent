        FROM   `bigquery-public-data.census_bureau_acs.county_2020_5yr`
        WHERE  total_pop > 50000
        ORDER  BY total_pop DESC
        LIMIT  200 -- large enough list; actual join in query 8 narrowed to 3
       )
LIMIT  20;
