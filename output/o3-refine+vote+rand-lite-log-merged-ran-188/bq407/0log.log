```sql
--Description: 3) Which counties (27-Aug-2020) had ≥1,000 confirmed cases?  
SELECT county_fips_code,
       county_name,
       state,
       confirmed_cases
FROM   `bigquery-public-data.covid19_usafacts.summary`
WHERE  date = '2020-08-27'
  AND  confirmed_cases >= 1000
