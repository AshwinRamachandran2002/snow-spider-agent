Query:
--Description: 10) (Optional) Retrieve the raw figures for confirmed cases & deaths for the final 3 counties.  
SELECT county_name,
       state,
       confirmed_cases,
       deaths
FROM   `bigquery-public-data.covid19_usafacts.summary`
WHERE  date = '2020-08-27'
  AND  LPAD(county_fips_code,5,'0') IN (
        SELECT LPAD(geo_id,5,'0')
        FROM   `bigquery-public-data.census_bureau_acs.county_2020_5yr`
        WHERE  total_pop > 50000
        ORDER  BY total_pop DESC
        LIMIT  200 -- large enough list; actual join in query 8 narrowed to 3
       )
LIMIT  20;
