    COUNT_IF("rounded_cn" = 3)::FLOAT / COUNT(*) * 100 AS "gain_pct",
    COUNT_IF("rounded_cn" > 3)::FLOAT / COUNT(*) * 100 AS "amp_pct"
  FROM per_band
  GROUP BY "cytoband_name","hg38_start","hg38_stop"
)
SELECT *
FROM freq
ORDER BY "cytoband_name"
LIMIT 20;
