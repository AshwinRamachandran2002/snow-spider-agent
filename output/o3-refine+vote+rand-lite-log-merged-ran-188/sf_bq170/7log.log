```sql
--Description: 6) For one example BRCA case (first 1 in sub-query) on chr14, join segments to cytobands and compute bp-overlap.
SELECT 
  seg."case_barcode",
  seg."chromosome",
  seg."start_pos"     AS "seg_start",
  seg."end_pos"       AS "seg_end",
  cyto."cytoband_name",
  cyto."hg38_start"   AS "band_start",
  cyto."hg38_stop"    AS "band_end",
  /* base-pair overlap length */
  LEAST(seg."end_pos",cyto."hg38_stop") - GREATEST(seg."start_pos",cyto."hg38_start") + 1 AS "overlap_bp",
  seg."copy_number"
FROM (
      SELECT * 
      FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
      WHERE "project_short_name"='TCGA-BRCA' 
      LIMIT 1
     ) seg
JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" cyto
  ON cyto."chromosome" = seg."chromosome"
 WHERE LEAST(seg."end_pos",cyto."hg38_stop") 
       >  GREATEST(seg."start_pos",cyto."hg38_start")
LIMIT 20;
```

```sql
--Description: 7) Compute the overlap-weighted average copy number per cytoband for the same case shown above.
WITH joined AS (
  SELECT 
    seg."case_barcode",
    cyto."cytoband_name",
    LEAST(seg."end_pos",cyto."hg38_stop") - GREATEST(seg."start_pos",cyto."hg38_start") + 1 AS "ov",
    seg."copy_number"
  FROM (
        SELECT * 
        FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
        WHERE "project_short_name"='TCGA-BRCA'
        LIMIT 1
       ) seg
  JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" cyto
    ON cyto."chromosome" = seg."chromosome"
  WHERE LEAST(seg."end_pos",cyto."hg38_stop") 
        >  GREATEST(seg."start_pos",cyto."hg38_start")
)
SELECT 
  "case_barcode",
  "cytoband_name",
  ROUND(SUM("ov" * "copy_number") / NULLIF(SUM("ov"),0),2) AS "weighted_copy_number"
FROM joined
GROUP BY "case_barcode","cytoband_name"
LIMIT 20;
```

```sql
--Description: 8) Classify the rounded weighted copy number into CNV categories for those rows.
WITH per_band AS (
  /* use previous CTE query logic */
  SELECT 
    "case_barcode",
    "cytoband_name",
    ROUND(SUM("ov" * "copy_number") / NULLIF(SUM("ov"),0)) AS "rounded_cn"
  FROM (
        SELECT 
          seg."case_barcode",
          cyto."cytoband_name",
          LEAST(seg."end_pos",cyto."hg38_stop") - GREATEST(seg."start_pos",cyto."hg38_start") + 1 AS "ov",
          seg."copy_number"
        FROM (
              SELECT * 
              FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
              WHERE "project_short_name"='TCGA-BRCA'
              LIMIT 1
             ) seg
        JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" cyto
          ON cyto."chromosome" = seg."chromosome"
        WHERE LEAST(seg."end_pos",cyto."hg38_stop") 
              >  GREATEST(seg."start_pos",cyto."hg38_start")
       )
  GROUP BY "case_barcode","cytoband_name"
)
SELECT 
  "case_barcode",
  "cytoband_name",
  "rounded_cn",
  CASE 
     WHEN "rounded_cn" = 0 THEN 'homozygous_deletion'
     WHEN "rounded_cn" = 1 THEN 'heterozygous_deletion'
     WHEN "rounded_cn" = 2 THEN 'diploid'
     WHEN "rounded_cn" = 3 THEN 'gain'
     WHEN "rounded_cn" > 3 THEN 'amplification'
  END AS "cnv_class"
FROM per_band
LIMIT 20;
```

```sql
--Description: 9) For one chromosome (chr17) across ALL TCGA-BRCA cases, calculate weighted copy number per cytoband & classify.
WITH seg AS (
  SELECT *
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
  WHERE "project_short_name"='TCGA-BRCA' 
    AND "chromosome"='chr17'
),
joined AS (
  SELECT 
    seg."case_barcode",
    cyto."cytoband_name",
    LEAST(seg."end_pos",cyto."hg38_stop") - GREATEST(seg."start_pos",cyto."hg38_start") + 1 AS "ov",
    seg."copy_number"
  FROM seg
  JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" cyto
    ON cyto."chromosome" = seg."chromosome"
  WHERE LEAST(seg."end_pos",cyto."hg38_stop") 
        >  GREATEST(seg."start_pos",cyto."hg38_start")
),
per_band AS (
  SELECT 
    "case_barcode",
    "cytoband_name",
    ROUND(SUM("ov" * "copy_number") / NULLIF(SUM("ov"),0)) AS "rounded_cn"
  FROM joined
  GROUP BY "case_barcode","cytoband_name"
)
SELECT 
  "cytoband_name",
  COUNT_IF("rounded_cn" = 0) / COUNT(*)::FLOAT * 100 AS "perc_homdel",
  COUNT_IF("rounded_cn" = 1) / COUNT(*)::FLOAT * 100 AS "perc_hetloss",
  COUNT_IF("rounded_cn" = 2) / COUNT(*)::FLOAT * 100 AS "perc_diploid",
  COUNT_IF("rounded_cn" = 3) / COUNT(*)::FLOAT * 100 AS "perc_gain",
  COUNT_IF("rounded_cn" > 3) / COUNT(*)::FLOAT * 100 AS "perc_amp"
FROM per_band
GROUP BY "cytoband_name"
ORDER BY "cytoband_name"
LIMIT 20;
```

```sql
--Description: 10) Extend #9 to all chromosomes – final frequency table across every cytoband (may be long, so LIMIT 20 here).
WITH seg AS (
  SELECT *
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
  WHERE "project_short_name"='TCGA-BRCA'
),
joined AS (
  SELECT 
    seg."case_barcode",
    cyto."cytoband_name",
    cyto."hg38_start",
    cyto."hg38_stop",
    LEAST(seg."end_pos",cyto."hg38_stop") - GREATEST(seg."start_pos",cyto."hg38_start") + 1 AS "ov",
    seg."copy_number"
  FROM seg
  JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" cyto
    ON cyto."chromosome" = seg."chromosome"
  WHERE LEAST(seg."end_pos",cyto."hg38_stop") 
        >  GREATEST(seg."start_pos",cyto."hg38_start")
),
per_band AS (
  SELECT 
    "case_barcode",
    "cytoband_name",
    "hg38_start",
    "hg38_stop",
    ROUND(SUM("ov" * "copy_number") / NULLIF(SUM("ov"),0)) AS "rounded_cn"
  FROM joined
  GROUP BY "case_barcode","cytoband_name","hg38_start","hg38_stop"
),
freq AS (
  SELECT 
    "cytoband_name",
    "hg38_start",
    "hg38_stop",
    COUNT_IF("rounded_cn" = 0)::FLOAT / COUNT(*) * 100 AS "homdel_pct",
    COUNT_IF("rounded_cn" = 1)::FLOAT / COUNT(*) * 100 AS "hetloss_pct",
    COUNT_IF("rounded_cn" = 2)::FLOAT / COUNT(*) * 100 AS "diploid_pct",
    COUNT_IF("rounded_cn" = 3)::FLOAT / COUNT(*) * 100 AS "gain_pct",
    COUNT_IF("rounded_cn" > 3)::FLOAT / COUNT(*) * 100 AS "amp_pct"
  FROM per_band
  GROUP BY "cytoband_name","hg38_start","hg38_stop"
)
SELECT *
FROM freq
ORDER BY "cytoband_name"
LIMIT 20;
```
