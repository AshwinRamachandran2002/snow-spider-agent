--Description: 10) Extend #9 to all chromosomes – final frequency table across every cytoband (may be long, so LIMIT 20 here).
WITH seg AS (
  SELECT *
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
  WHERE "project_short_name"='TCGA-BRCA'
),
joined AS (
  SELECT 
    seg."case_barcode",
    cyto."cytoband_name",
    cyto."hg38_start",
    cyto."hg38_stop",
    LEAST(seg."end_pos",cyto."hg38_stop") - GREATEST(seg."start_pos",cyto."hg38_start") + 1 AS "ov",
    seg."copy_number"
  FROM seg
  JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" cyto
    ON cyto."chromosome" = seg."chromosome"
  WHERE LEAST(seg."end_pos",cyto."hg38_stop") 
        >  GREATEST(seg."start_pos",cyto."hg38_start")
),
per_band AS (
  SELECT 
    "case_barcode",
    "cytoband_name",
    "hg38_start",
    "hg38_stop",
    ROUND(SUM("ov" * "copy_number") / NULLIF(SUM("ov"),0)) AS "rounded_cn"
  FROM joined
  GROUP BY "case_barcode","cytoband_name","hg38_start","hg38_stop"
),
freq AS (
  SELECT 
    "cytoband_name",
    "hg38_start",
    "hg38_stop",
