```sql
-- Description: 1) Look at the different values recorded for weather in 2016 to see how “clear” and “rain” appear in the data
SELECT DISTINCT `atmospheric_conditions_1_name`
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
ORDER BY 1
LIMIT 20;
```

```sql
-- Description: 2) Check how many crashes for each of those weather-strings just on Saturday/Sunday
SELECT `atmospheric_conditions_1_name`,
       COUNT(*) AS crashes_weekend
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE `day_of_week` IN (1,7)       -- 1 = Sunday, 7 = Saturday
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- Description: 3) Weekend “clear-weather” crashes by state
SELECT `state_name`,
       COUNT(*) AS clear_weekend_crashes
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE `day_of_week` IN (1,7)
  AND LOWER(`atmospheric_conditions_1_name`) = 'clear'
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- Description: 4) Weekend “rain-weather” crashes by state
SELECT `state_name`,
       COUNT(*) AS rain_weekend_crashes
FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE `day_of_week` IN (1,7)
  AND LOWER(`atmospheric_conditions_1_name`) = 'rain'
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- Description: 5) Put clear & rain counts side-by-side for every state (weekends only)
SELECT
  clr.state_name,
  clr.clear_weekend_crashes,
  IFNULL(rn.rain_weekend_crashes,0) AS rain_weekend_crashes
FROM (
      SELECT `state_name`, COUNT(*) AS clear_weekend_crashes
      FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
      WHERE `day_of_week` IN (1,7)
        AND LOWER(`atmospheric_conditions_1_name`) = 'clear'
      GROUP BY 1
     ) AS clr
LEFT JOIN (
      SELECT `state_name`, COUNT(*) AS rain_weekend_crashes
      FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
      WHERE `day_of_week` IN (1,7)
        AND LOWER(`atmospheric_conditions_1_name`) = 'rain'
      GROUP BY 1
     ) AS rn
USING (state_name)
ORDER BY clr.clear_weekend_crashes DESC
LIMIT 20;
```

```sql
-- Description: 6) Add the absolute difference (Rain – Clear) for every state
SELECT
  state_name,
  rain_weekend_crashes,
  clear_weekend_crashes,
  ABS(rain_weekend_crashes - clear_weekend_crashes) AS weekend_rain_vs_clear_diff
FROM (
      -- Re-use the side-by-side query from step 5
      SELECT
        clr.state_name,
        clr.clear_weekend_crashes,
        IFNULL(rn.rain_weekend_crashes,0) AS rain_weekend_crashes
      FROM (
            SELECT `state_name`, COUNT(*) AS clear_weekend_crashes
            FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
            WHERE `day_of_week` IN (1,7)
              AND LOWER(`atmospheric_conditions_1_name`) = 'clear'
            GROUP BY 1
           ) AS clr
      LEFT JOIN (
            SELECT `state_name`, COUNT(*) AS rain_weekend_crashes
            FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
            WHERE `day_of_week` IN (1,7)
              AND LOWER(`atmospheric_conditions_1_name`) = 'rain'
            GROUP BY 1
           ) AS rn
      USING (state_name)
     )
ORDER BY weekend_rain_vs_clear_diff DESC
LIMIT 20;
```

```sql
-- Description: 7) Show the 3 states with the largest differences (Rain – Clear) on weekends in 2016
SELECT
  state_name,
  rain_weekend_crashes,
  clear_weekend_crashes,
  ABS(rain_weekend_crashes - clear_weekend_crashes) AS weekend_rain_vs_clear_diff
FROM (
      SELECT
        clr.state_name,
        clr.clear_weekend_crashes,
        IFNULL(rn.rain_weekend_crashes,0) AS rain_weekend_crashes
      FROM (
            SELECT `state_name`, COUNT(*) AS clear_weekend_crashes
            FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
            WHERE `day_of_week` IN (1,7)
              AND LOWER(`atmospheric_conditions_1_name`) = 'clear'
            GROUP BY 1
           ) AS clr
      LEFT JOIN (
            SELECT `state_name`, COUNT(*) AS rain_weekend_crashes
            FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
            WHERE `day_of_week` IN (1,7)
              AND LOWER(`atmospheric_conditions_1_name`) = 'rain'
            GROUP BY 1
           ) AS rn
      USING (state_name)
     )
ORDER BY weekend_rain_vs_clear_diff DESC
LIMIT 3;
```

```sql
-- Description: 8) (Optional) Flip the sign to see whether rain or clear was higher and by how much
SELECT
  state_name,
  rain_weekend_crashes - clear_weekend_crashes AS rain_minus_clear,
  IF(rain_weekend_crashes > clear_weekend_crashes, 'More rain', 'More clear') AS which_is_higher
FROM (
      SELECT
        clr.state_name,
        clr.clear_weekend_crashes,
        IFNULL(rn.rain_weekend_crashes,0) AS rain_weekend_crashes
      FROM (
            SELECT `state_name`, COUNT(*) AS clear_weekend_crashes
            FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
            WHERE `day_of_week` IN (1,7)
              AND LOWER(`atmospheric_conditions_1_name`) = 'clear'
            GROUP BY 1
           ) AS clr
      LEFT JOIN (
            SELECT `state_name`, COUNT(*) AS rain_weekend_crashes
            FROM  `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
            WHERE `day_of_week` IN (1,7)
              AND LOWER(`atmospheric_conditions_1_name`) = 'rain'
            GROUP BY 1
           ) AS rn
      USING (state_name)
     )
ORDER BY ABS(rain_minus_clear) DESC
LIMIT 20;
```

```sql
-- Description: 9) Check raw counts for one of the high-difference states (replace 'Texas' with a state you saw in step 7)
