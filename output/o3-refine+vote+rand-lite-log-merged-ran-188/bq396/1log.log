FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE LOWER(`state_name`) = 'texas'
  AND `day_of_week` IN (1,7)
  AND LOWER(`atmospheric_conditions_1_name`) IN ('clear','rain')
LIMIT 20;
```

