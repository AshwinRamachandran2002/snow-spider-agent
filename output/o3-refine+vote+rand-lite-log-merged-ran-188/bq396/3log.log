  SELECT state_name, COUNT(*) AS clear_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE year_of_crash = 2016
    AND day_of_week IN (1, 7)
    AND atmospheric_conditions_1_name = 'Clear'
  GROUP BY state_name
),
rain_tbl AS (
  SELECT state_name, COUNT(*) AS rain_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE year_of_crash = 2016
    AND day_of_week IN (1, 7)
    AND atmospheric_conditions_1_name = 'Rain'
  GROUP BY state_name
)
SELECT
  r.state_name,
  r.rain_cnt,
  c.clear_cnt,
  (r.rain_cnt - c.clear_cnt) AS diff_cnt
FROM rain_tbl r
LEFT JOIN clear_tbl c USING (state_name)
LIMIT 20
