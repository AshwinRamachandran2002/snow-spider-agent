```sql
--Description: Thinking process inside comments:  
-- • Goal: return the three states with the largest gap between RAIN and CLEAR weekend crashes in 2016.  
-- • Weekend = Saturday (7) or Sunday (1).  
-- • Build two CTEs that count weekend crashes whose primary weather is ‘Clear’ or ‘Rain’.  
-- • Join the two count tables, fill any NULLs with 0, compute the absolute difference,  
--   sort by that difference, and pick the top 3.  
WITH clear_tbl AS (                      -- count “Clear” weekend crashes per state
  SELECT
    state_name,
    COUNT(*) AS clear_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE year_of_crash = 2016
    AND day_of_week IN (1, 7)            -- 1 = Sunday, 7 = Saturday
    AND atmospheric_conditions_1_name = 'Clear'
  GROUP BY state_name
),
rain_tbl AS (                           -- count “Rain” weekend crashes per state
  SELECT
    state_name,
    COUNT(*) AS rain_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE year_of_crash = 2016
    AND day_of_week IN (1, 7)
    AND atmospheric_conditions_1_name = 'Rain'
  GROUP BY state_name
)
SELECT
  COALESCE(r.state_name, c.state_name)                            AS state_name,
  COALESCE(r.rain_cnt,  0)                                        AS rain_accidents,
  COALESCE(c.clear_cnt, 0)                                        AS clear_accidents,
  ABS(COALESCE(r.rain_cnt, 0) - COALESCE(c.clear_cnt, 0))         AS difference_between_rain_and_clear
FROM  rain_tbl r
FULL JOIN clear_tbl c USING (state_name)   -- include states appearing in only one set
ORDER BY difference_between_rain_and_clear DESC
LIMIT 3;                                   -- top 3 states
```
