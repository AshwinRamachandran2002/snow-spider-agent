```sql
-- 1. Peek at a few 2016 accident records to understand available columns
SELECT * 
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
LIMIT 20;
```

```sql
-- 2. Verify the numeric codes for days-of-week
SELECT DISTINCT day_of_week, day_of_week_name
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
ORDER BY day_of_week
LIMIT 20;
```

```sql
-- 3. List all distinct atmospheric condition names to see how “Rain” or “Clear” appear
SELECT DISTINCT atmospheric_conditions_1_name AS cond
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
ORDER BY cond
LIMIT 20;
```

```sql
-- 4. Count weekend (Saturday/Sunday) accidents that took place in RAIN
SELECT
  state_name,
  COUNT(*) AS rainy_accidents
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1,7)                          -- 1 = Sunday, 7 = Saturday
  AND (atmospheric_conditions_1_name = 'Rain'
       OR atmospheric_conditions_2_name = 'Rain')
GROUP BY state_name
ORDER BY rainy_accidents DESC
LIMIT 20;
```

```sql
-- 5. Count weekend accidents that took place in CLEAR weather
SELECT
  state_name,
  COUNT(*) AS clear_accidents
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1,7)
  AND (atmospheric_conditions_1_name = 'Clear'
       OR atmospheric_conditions_2_name = 'Clear')
GROUP BY state_name
ORDER BY clear_accidents DESC
LIMIT 20;
```

```sql
-- 6. Combine the two counts: rainy vs. clear weekend accidents per state
SELECT
  state_name,
  SUM(CASE WHEN atmospheric_conditions_1_name = 'Rain'  OR atmospheric_conditions_2_name = 'Rain'  THEN 1 ELSE 0 END) AS rainy_accidents,
  SUM(CASE WHEN atmospheric_conditions_1_name = 'Clear' OR atmospheric_conditions_2_name = 'Clear' THEN 1 ELSE 0 END) AS clear_accidents
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1,7)
GROUP BY state_name
ORDER BY state_name
LIMIT 20;
```

```sql
-- 7. Calculate the absolute difference and surface the Top-3 states
SELECT
  state_name,
  ABS(rainy_accidents - clear_accidents) AS diff_accidents
FROM (
  SELECT
    state_name,
    SUM(CASE WHEN atmospheric_conditions_1_name = 'Rain'  OR atmospheric_conditions_2_name = 'Rain'  THEN 1 ELSE 0 END) AS rainy_accidents,
    SUM(CASE WHEN atmospheric_conditions_1_name = 'Clear' OR atmospheric_conditions_2_name = 'Clear' THEN 1 ELSE 0 END) AS clear_accidents
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
  GROUP BY state_name
)
ORDER BY diff_accidents DESC
LIMIT 3;
```

```sql
-- 8. Display the rainy & clear counts together for just those Top-3 states
WITH weekend_counts AS (
  SELECT
    state_name,
    SUM(CASE WHEN atmospheric_conditions_1_name = 'Rain'  OR atmospheric_conditions_2_name = 'Rain'  THEN 1 ELSE 0 END) AS rainy_accidents,
    SUM(CASE WHEN atmospheric_conditions_1_name = 'Clear' OR atmospheric_conditions_2_name = 'Clear' THEN 1 ELSE 0 END) AS clear_accidents
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
  GROUP BY state_name
),
top3 AS (
  SELECT state_name
  FROM weekend_counts
  ORDER BY ABS(rainy_accidents - clear_accidents) DESC
  LIMIT 3
)
SELECT c.*
FROM weekend_counts AS c
JOIN top3 USING (state_name)
ORDER BY ABS(rainy_accidents - clear_accidents) DESC;
```

```sql
-- 9. Same result as #8 but formatted with the explicit difference column
WITH weekend_counts AS (
  SELECT
    state_name,
    SUM(CASE WHEN atmospheric_conditions_1_name = 'Rain'  OR atmospheric_conditions_2_name = 'Rain'  THEN 1 ELSE 0 END) AS rainy_accidents,
    SUM(CASE WHEN atmospheric_conditions_1_name = 'Clear' OR atmospheric_conditions_2_name = 'Clear' THEN 1 ELSE 0 END) AS clear_accidents
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
  GROUP BY state_name
)
SELECT
  state_name,
  rainy_accidents,
  clear_accidents,
  ABS(rainy_accidents - clear_accidents) AS difference
FROM weekend_counts
ORDER BY difference DESC
LIMIT 3;
```

```sql
-- 10. Final concise query to answer the question directly in one step
SELECT
  state_name,
  ABS(SUM(CASE WHEN atmospheric_conditions_1_name = 'Rain'  OR atmospheric_conditions_2_name = 'Rain'  THEN 1 ELSE 0 END) -
      SUM(CASE WHEN atmospheric_conditions_1_name = 'Clear' OR atmospheric_conditions_2_name = 'Clear' THEN 1 ELSE 0 END)) AS difference
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1,7)      -- weekend only
GROUP BY state_name
ORDER BY difference DESC
LIMIT 3;
```
