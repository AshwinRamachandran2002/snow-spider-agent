Query:
--Description: 8. Show Rain and Clear weekend counts only for the Top-3 states
--identified above, plus their differences.
WITH weekend_counts AS (
  SELECT
    state_name,
    SUM(CASE WHEN atmospheric_conditions_1_name = 'Rain'
              OR atmospheric_conditions_2_name = 'Rain'  THEN 1 ELSE 0 END) AS rainy_accidents,
    SUM(CASE WHEN atmospheric_conditions_1_name = 'Clear'
              OR atmospheric_conditions_2_name = 'Clear' THEN 1 ELSE 0 END) AS clear_accidents
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
  GROUP BY state_name
),
top3 AS (
  SELECT state_name
  FROM weekend_counts
  ORDER BY ABS(rainy_accidents - clear_accidents) DESC
  LIMIT 3
)
SELECT
  c.state_name,
  c.rainy_accidents,
  c.clear_accidents,
  ABS(c.rainy_accidents - c.clear_accidents) AS difference
FROM weekend_counts AS c
JOIN top3 USING (state_name)
ORDER BY difference DESC
