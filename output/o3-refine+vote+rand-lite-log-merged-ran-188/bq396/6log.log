Query:
--Description: 4. Count weekend (Saturday / Sunday) crashes that occurred during
--Rain in 2016, grouped by state.
SELECT
  state_name,
  COUNT(*) AS rainy_accidents
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1,7)        -- 1 = Sunday, 7 = Saturday
  AND (atmospheric_conditions_1_name = 'Rain'
       OR atmospheric_conditions_2_name = 'Rain')
GROUP BY state_name
ORDER BY rainy_accidents DESC
LIMIT 20
