--Description: 6. For every state, compute both Rain and Clear weekend-crash
--counts side-by-side.
SELECT
  state_name,
  SUM(CASE WHEN atmospheric_conditions_1_name = 'Rain'
            OR atmospheric_conditions_2_name = 'Rain'  THEN 1 ELSE 0 END) AS rainy_accidents,
  SUM(CASE WHEN atmospheric_conditions_1_name = 'Clear'
            OR atmospheric_conditions_2_name = 'Clear' THEN 1 ELSE 0 END) AS clear_accidents
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1,7)
GROUP BY state_name
ORDER BY state_name
LIMIT 20
