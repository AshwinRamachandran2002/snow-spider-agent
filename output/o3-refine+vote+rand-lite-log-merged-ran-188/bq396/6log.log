```sql
--Description:
--Step-by-step inside one query:
--1. Focus on 2016 weekend crashes (numeric day_of_week 1 = Sunday, 7 = Saturday).
--2. Count, per state, how many of those crashes occurred in “Rain” versus “Clear”
--   weather.  A crash is tagged Rain/Clear if either atmospheric_conditions_1_name
--   or atmospheric_conditions_2_name equals that label.
--3. Compute the absolute difference between the two counts.
--4. Return the Top-3 states with the largest differences, alongside their
--   rainy- and clear-weekend accident counts.
WITH weekend_counts AS (
  SELECT
    state_name,
    SUM(CASE
          WHEN day_of_week IN (1,7)
           AND (atmospheric_conditions_1_name = 'Rain'
                OR atmospheric_conditions_2_name = 'Rain')
         THEN 1 ELSE 0 END) AS rainy_accidents,
    SUM(CASE
          WHEN day_of_week IN (1,7)
           AND (atmospheric_conditions_1_name = 'Clear'
                OR atmospheric_conditions_2_name = 'Clear')
         THEN 1 ELSE 0 END) AS clear_accidents
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  GROUP BY state_name
)
SELECT
  state_name,
  rainy_accidents,
  clear_accidents,
  ABS(rainy_accidents - clear_accidents) AS difference
FROM weekend_counts
ORDER BY difference DESC
LIMIT 3;
```
