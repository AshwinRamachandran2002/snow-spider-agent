FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1,7)
  AND atmospheric_conditions_1_name = 'Rain'
GROUP BY state_name
ORDER BY rain_cnt DESC
LIMIT 20;
```

```sql
--Description: 6) Build separate weekend counts for CLEAR and RAIN, then join them  
WITH clear AS (
  SELECT state_name, COUNT(*) AS clear_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND atmospheric_conditions_1_name = 'Clear'
  GROUP BY state_name
), rain AS (
  SELECT state_name, COUNT(*) AS rain_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND atmospheric_conditions_1_name = 'Rain'
  GROUP BY state_name
)
SELECT
  c.state_name,
  c.clear_cnt,
  r.rain_cnt
FROM clear c
LEFT JOIN rain r
USING (state_name)
LIMIT 20;
```

```sql
--Description: 7) Compute absolute differences between RAIN and CLEAR counts for every state  
WITH clear AS (
  SELECT state_name, COUNT(*) AS clear_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND atmospheric_conditions_1_name = 'Clear'
  GROUP BY state_name
), rain AS (
  SELECT state_name, COUNT(*) AS rain_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND atmospheric_conditions_1_name = 'Rain'
  GROUP BY state_name
)
SELECT
  COALESCE(c.state_name, r.state_name) AS state_name,
  COALESCE(r.rain_cnt,0) AS rain_cnt,
  COALESCE(c.clear_cnt,0) AS clear_cnt,
  ABS(COALESCE(r.rain_cnt,0) - COALESCE(c.clear_cnt,0)) AS diff_cnt
FROM clear c
FULL OUTER JOIN rain r
ON c.state_name = r.state_name
ORDER BY diff_cnt DESC
LIMIT 20;
```

```sql
--Description: 8) Final answer – top 3 states with largest (Rain – Clear) weekend accident differences in 2016  
WITH clear AS (
  SELECT state_name, COUNT(*) AS clear_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND atmospheric_conditions_1_name = 'Clear'
  GROUP BY state_name
), rain AS (
  SELECT state_name, COUNT(*) AS rain_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND atmospheric_conditions_1_name = 'Rain'
  GROUP BY state_name
)
SELECT
  COALESCE(c.state_name, r.state_name) AS state_name,
  COALESCE(r.rain_cnt,0) AS rain_accidents,
  COALESCE(c.clear_cnt,0) AS clear_accidents,
  ABS(COALESCE(r.rain_cnt,0) - COALESCE(c.clear_cnt,0)) AS difference
FROM clear c
FULL OUTER JOIN rain r
ON c.state_name = r.state_name
ORDER BY difference DESC
LIMIT 3;
```

```sql
--Description: 9) (Optional deeper dive) Show both Saturday vs Sunday breakdown for one of the top states  
WITH top_state AS (
  SELECT state_name
  FROM (
    WITH clear AS (
      SELECT state_name, COUNT(*) AS clear_cnt
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
      WHERE day_of_week IN (1,7) AND atmospheric_conditions_1_name='Clear'
      GROUP BY state_name
    ), rain AS (
      SELECT state_name, COUNT(*) AS rain_cnt
      FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
      WHERE day_of_week IN (1,7) AND atmospheric_conditions_1_name='Rain'
      GROUP BY state_name
    )
    SELECT COALESCE(c.state_name,r.state_name) AS state_name,
           ABS(COALESCE(r.rain_cnt,0)-COALESCE(c.clear_cnt,0)) AS diff
    FROM clear c FULL OUTER JOIN rain r USING(state_name)
    ORDER BY diff DESC
    LIMIT 1
  )
)
SELECT
  a.state_name,
  a.day_of_week_name,
  COUNT(*) AS total_accidents
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016` a
JOIN top_state t
  ON a.state_name = t.state_name
WHERE a.day_of_week IN (1,7)
  AND a.atmospheric_conditions_1_name IN ('Rain','Clear')
GROUP BY a.state_name, a.day_of_week_name
ORDER BY day_of_week_name;
```

