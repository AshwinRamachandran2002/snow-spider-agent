FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1,7)
  AND LOWER(atmospheric_conditions_1_name) = 'rain'
GROUP BY state_name
ORDER BY rain_crashes DESC
LIMIT 20;
```

```sql
--Description: 5) Get weekend-Clear crashes by state.
SELECT 
  state_name,
  COUNT(*) AS clear_crashes
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
WHERE day_of_week IN (1,7)
  AND LOWER(atmospheric_conditions_1_name) = 'clear'
GROUP BY state_name
ORDER BY clear_crashes DESC
LIMIT 20;
```

```sql
--Description: 6) Join the two previous sub-results to line up Rain vs Clear counts per state.
WITH rain AS (
  SELECT state_name, COUNT(*) AS rain_crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND LOWER(atmospheric_conditions_1_name) = 'rain'
  GROUP BY state_name
),
clear AS (
  SELECT state_name, COUNT(*) AS clear_crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND LOWER(atmospheric_conditions_1_name) = 'clear'
  GROUP BY state_name
)
SELECT 
  COALESCE(c.state_name, r.state_name) AS state_name,
  clear_crashes,
  rain_crashes
FROM clear c
FULL JOIN rain r
USING(state_name)
LIMIT 20;
```

```sql
--Description: 7) Add absolute difference between Clear and Rain weekend crashes.
WITH rain AS (
  SELECT state_name, COUNT(*) AS rain_crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND LOWER(atmospheric_conditions_1_name) = 'rain'
  GROUP BY state_name
),
clear AS (
  SELECT state_name, COUNT(*) AS clear_crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1,7)
    AND LOWER(atmospheric_conditions_1_name) = 'clear'
  GROUP BY state_name
)
SELECT 
  COALESCE(c.state_name, r.state_name)               AS state_name,
  IFNULL(clear_crashes,0)                            AS clear_crashes,
  IFNULL(rain_crashes,0)                             AS rain_crashes,
  ABS(IFNULL(clear_crashes,0) - IFNULL(rain_crashes,0)) AS diff
FROM clear c
FULL JOIN rain r
USING(state_name)
LIMIT 20;
```

