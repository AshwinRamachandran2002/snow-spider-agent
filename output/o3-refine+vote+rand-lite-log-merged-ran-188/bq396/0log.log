```sql
--Description:
-- Goal: Identify the top-3 states whose weekend (Sun=1, Sat=7) crash counts in 2016 differ
--       the most between “Clear” and “Rain” weather.
-- Thinking process inside the query:
--   1. Two CTEs: “rain” counts weekend crashes where the primary weather equals “Rain”,
--      “clear” does the same for “Clear”.
--   2. Use a FULL JOIN on state_name so we keep states that appear in only one CTE.
--   3. Convert NULLs to 0 with IFNULL, compute the absolute difference, then order by it.
--   4. LIMIT 3 returns the three states with the largest gaps.
WITH rain AS (
  SELECT
    state_name,
    COUNT(*) AS rain_crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1, 7)                    -- weekends
    AND LOWER(atmospheric_conditions_1_name) = 'rain'
  GROUP BY state_name
),
clear AS (
  SELECT
    state_name,
    COUNT(*) AS clear_crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1, 7)                    -- weekends
    AND LOWER(atmospheric_conditions_1_name) = 'clear'
  GROUP BY state_name
)
SELECT
  COALESCE(c.state_name, r.state_name) AS state_name,
  IFNULL(clear_crashes, 0)             AS clear_crashes,
  IFNULL(rain_crashes, 0)              AS rain_crashes,
  ABS(IFNULL(clear_crashes, 0) - IFNULL(rain_crashes, 0)) AS difference
FROM clear AS c
FULL JOIN rain AS r
USING (state_name)
ORDER BY difference DESC
LIMIT 3;
```
