--Description: 6) Join Rain vs. Clear weekend counts per state
WITH rain AS (
  SELECT state_name, COUNT(*) AS rain_crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1, 7) AND LOWER(atmospheric_conditions_1_name) = 'rain'
  GROUP BY state_name
),
clear AS (
  SELECT state_name, COUNT(*) AS clear_crashes
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2016`
  WHERE day_of_week IN (1, 7) AND LOWER(atmospheric_conditions_1_name) = 'clear'
  GROUP BY state_name
)
SELECT
  COALESCE(c.state_name, r.state_name) AS state_name,
  clear_crashes,
  rain_crashes
FROM clear AS c
FULL JOIN rain AS r
USING (state_name)
LIMIT 20
