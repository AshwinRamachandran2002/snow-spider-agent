Query:
--Description: For every high-volume seller, show which English product category brings them the most sales.  
SELECT  final."seller_id",
        final."product_category_name_english",
        MAX(final."items_sold_in_cat") AS "max_items_in_cat"
FROM   (
        SELECT  oi."seller_id",
                pct."product_category_name_english",
                COUNT(*) AS "items_sold_in_cat"
        FROM    "order_items" AS oi
        JOIN    "products"    AS p
                ON oi."product_id" = p."product_id"
        JOIN    "product_category_name_translation" AS pct
                ON p."product_category_name" = pct."product_category_name"
        GROUP BY oi."seller_id", pct."product_category_name_english"
       ) AS final
GROUP BY final."seller_id"
HAVING  SUM(final."items_sold_in_cat") > 100
LIMIT 20
