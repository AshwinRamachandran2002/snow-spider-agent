```sql
--Description: Preview unique seller records together with their location details. 
SELECT DISTINCT 
       "seller_id",
       "seller_zip_code_prefix",
       "seller_city",
       "seller_state"
FROM   "sellers"
LIMIT 20;


--Description: List distinct sellers that actually appear in the order flow (i.e. who sold at least one item).  
SELECT DISTINCT 
       "seller_id"
FROM   "order_items"
LIMIT 20;


--Description: Count the number of products sold per seller and keep only high-volume ones (>100 items).  
SELECT  "seller_id",
        COUNT(*) AS "products_sold"
FROM    "order_items"
GROUP BY "seller_id"
HAVING  COUNT(*) > 100
LIMIT 20;


--Description: For every high-volume seller compute total sales value and the average selling price.  
SELECT  "seller_id",
        SUM("price") AS "total_sales_value",
        AVG("price") AS "avg_item_price",
        COUNT(*)    AS "products_sold"
FROM    "order_items"
GROUP BY "seller_id"
HAVING  COUNT(*) > 100
LIMIT 20;


--Description: Inspect how order reviews map to the items (needed for later seller-level review aggregation).  
SELECT DISTINCT
       oi."order_id",
       orv."review_score"
FROM   "order_items" AS oi
JOIN   "order_reviews" AS orv
       ON oi."order_id" = orv."order_id"
LIMIT 20;


--Description: Calculate the average review score obtained by every high-volume seller.  
SELECT  oi."seller_id",
        AVG(orv."review_score")            AS "avg_review_score",
        COUNT(DISTINCT oi."order_id")      AS "reviewed_orders"
FROM    "order_items"  AS oi
JOIN    "order_reviews" AS orv
        ON oi."order_id" = orv."order_id"
GROUP BY oi."seller_id"
HAVING  COUNT(*) > 100
LIMIT 20;


--Description: Display purchase and carrier-handoff timestamps for sample seller orders to analyse packing times.  
SELECT DISTINCT
       oi."seller_id",
       o."order_id",
       o."order_purchase_timestamp",
       o."order_delivered_carrier_date"
FROM   "order_items" AS oi
JOIN   "orders"      AS o
       ON oi."order_id" = o."order_id"
LIMIT 20;


--Description: Estimate each high-volume seller’s average packing time in days (purchase → carrier).  
SELECT  oi."seller_id",
        AVG(julianday(o."order_delivered_carrier_date") -
            julianday(o."order_purchase_timestamp")) AS "avg_packing_days"
FROM    "order_items" AS oi
JOIN    "orders"      AS o
        ON oi."order_id" = o."order_id"
GROUP BY oi."seller_id"
HAVING  COUNT(*) > 100
LIMIT 20;


--Description: Identify the English product categories with the largest absolute sales volume.  
SELECT  pct."product_category_name_english",
        COUNT(*) AS "items_sold"
FROM    "order_items" AS oi
JOIN    "products"    AS p
        ON oi."product_id" = p."product_id"
JOIN    "product_category_name_translation" AS pct
        ON p."product_category_name" = pct."product_category_name"
GROUP BY pct."product_category_name_english"
ORDER BY COUNT(*) DESC
LIMIT 20;


--Description: For every high-volume seller, show which English product category brings them the most sales.  
SELECT  final."seller_id",
        final."product_category_name_english",
        MAX(final."items_sold_in_cat") AS "max_items_in_cat"
FROM   (
        SELECT  oi."seller_id",
                pct."product_category_name_english",
                COUNT(*) AS "items_sold_in_cat"
        FROM    "order_items" AS oi
        JOIN    "products"    AS p
                ON oi."product_id" = p."product_id"
        JOIN    "product_category_name_translation" AS pct
                ON p."product_category_name" = pct."product_category_name"
        GROUP BY oi."seller_id", pct."product_category_name_english"
       ) AS final
GROUP BY final."seller_id"
HAVING  SUM(final."items_sold_in_cat") > 100
LIMIT 20;
```
