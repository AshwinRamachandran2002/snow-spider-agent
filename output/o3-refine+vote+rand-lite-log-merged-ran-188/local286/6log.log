```sql
--Description: Preview distinct seller IDs with their location data
SELECT DISTINCT s."seller_id",
       s."seller_city",
       s."seller_state"
FROM "sellers" AS s
LIMIT 20;
```

```sql
--Description: Sellers that have sold more than 100 items – total items and total revenue
SELECT oi."seller_id",
       COUNT(*)                                    AS "total_items_sold",
       SUM(oi."price")                             AS "total_sales_value"
FROM "order_items" AS oi
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: Average item price for every high-volume seller (>100 items)
SELECT oi."seller_id",
       AVG(oi."price")                            AS "avg_item_price"
FROM "order_items" AS oi
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: Average review score received by each high-volume seller
SELECT oi."seller_id",
       AVG(r."review_score")                      AS "avg_review_score"
FROM "order_items"  AS oi
JOIN "order_reviews" AS r
  ON r."order_id" = oi."order_id"
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: Sample purchase vs. carrier-delivery timestamps for one (random) seller
SELECT DISTINCT o."order_id",
       o."order_purchase_timestamp",
       o."order_delivered_carrier_date"
FROM "orders"      AS o
JOIN "order_items" AS oi
  ON oi."order_id" = o."order_id"
WHERE oi."seller_id" = (
      SELECT DISTINCT oi2."seller_id"
      FROM "order_items" AS oi2
      LIMIT 1)
LIMIT 20;
```

```sql
--Description: Average packing time (days from purchase to carrier hand-off) per high-volume seller
SELECT oi."seller_id",
       AVG(julianday(o."order_delivered_carrier_date") 
           - julianday(o."order_purchase_timestamp")) AS "avg_packing_time_days"
FROM "order_items" AS oi
JOIN "orders"      AS o
  ON o."order_id" = oi."order_id"
WHERE o."order_delivered_carrier_date" IS NOT NULL
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: Top product categories in English by overall quantity sold
SELECT pt."product_category_name_english"         AS "category_en",
       COUNT(*)                                   AS "items_sold"
FROM "order_items" AS oi
JOIN "products"     AS p  ON p."product_id" = oi."product_id"
JOIN "product_category_name_translation" AS pt
     ON pt."product_category_name" = p."product_category_name"
GROUP BY pt."product_category_name_english"
ORDER BY COUNT(*) DESC
LIMIT 20;
```

```sql
--Description: Product categories (English) and volume for each high-volume seller
SELECT oi."seller_id",
       pt."product_category_name_english"         AS "category_en",
       COUNT(*)                                   AS "items_sold"
FROM "order_items" AS oi
JOIN "products"     AS p  ON p."product_id" = oi."product_id"
JOIN "product_category_name_translation" AS pt
     ON pt."product_category_name" = p."product_category_name"
WHERE oi."seller_id" IN (
      SELECT oi2."seller_id"
      FROM "order_items" AS oi2
      GROUP BY oi2."seller_id"
      HAVING COUNT(*) > 100)
GROUP BY oi."seller_id", pt."product_category_name_english"
ORDER BY COUNT(*) DESC
LIMIT 20;
```

```sql
--Description: Comprehensive performance metrics for high-volume sellers (>100 items)
SELECT s."seller_id",
       s."seller_city",
       s."seller_state",
       sales."total_items_sold",
       sales."total_sales_value",
       price."avg_item_price",
       rev."avg_review_score",
       pack."avg_packing_time_days"
FROM "sellers" AS s
JOIN (
      SELECT oi."seller_id",
             COUNT(*)                AS "total_items_sold",
             SUM(oi."price")         AS "total_sales_value"
      FROM "order_items" AS oi
      GROUP BY oi."seller_id"
      HAVING COUNT(*) > 100
) AS sales ON sales."seller_id" = s."seller_id"
LEFT JOIN (
      SELECT oi."seller_id",
             AVG(oi."price")         AS "avg_item_price"
      FROM "order_items" AS oi
      GROUP BY oi."seller_id"
) AS price ON price."seller_id" = s."seller_id"
LEFT JOIN (
      SELECT oi."seller_id",
             AVG(r."review_score")   AS "avg_review_score"
      FROM "order_items"  AS oi
      JOIN "order_reviews" AS r
        ON r."order_id" = oi."order_id"
      GROUP BY oi."seller_id"
) AS rev   ON rev."seller_id"   = s."seller_id"
LEFT JOIN (
      SELECT oi."seller_id",
             AVG(julianday(o."order_delivered_carrier_date") 
                 - julianday(o."order_purchase_timestamp")) AS "avg_packing_time_days"
      FROM "order_items" AS oi
      JOIN "orders"      AS o
        ON o."order_id" = oi."order_id"
      WHERE o."order_delivered_carrier_date" IS NOT NULL
      GROUP BY oi."seller_id"
) AS pack  ON pack."seller_id"  = s."seller_id"
LIMIT 20;
```

```sql
--Description: Highest-selling product categories (English) restricted to high-volume sellers
SELECT pt."product_category_name_english"         AS "top_category_en",
       COUNT(*)                                   AS "items_sold"
FROM "order_items" AS oi
JOIN "products"     AS p  ON p."product_id" = oi."product_id"
JOIN "product_category_name_translation" AS pt
     ON pt."product_category_name" = p."product_category_name"
WHERE oi."seller_id" IN (
      SELECT oi2."seller_id"
      FROM "order_items" AS oi2
      GROUP BY oi2."seller_id"
      HAVING COUNT(*) > 100)
GROUP BY pt."product_category_name_english"
ORDER BY COUNT(*) DESC
LIMIT 20;
```
