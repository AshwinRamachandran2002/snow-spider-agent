Query:
--Description: Comprehensive performance metrics for high-volume sellers (>100 items)
SELECT s."seller_id",
       s."seller_city",
       s."seller_state",
       sales."total_items_sold",
       sales."total_sales_value",
       price."avg_item_price",
       rev."avg_review_score",
       pack."avg_packing_time_days"
FROM "sellers" AS s
JOIN (
      SELECT oi."seller_id",
             COUNT(*)                AS "total_items_sold",
             SUM(oi."price")         AS "total_sales_value"
      FROM "order_items" AS oi
      GROUP BY oi."seller_id"
      HAVING COUNT(*) > 100
) AS sales ON sales."seller_id" = s."seller_id"
LEFT JOIN (
      SELECT oi."seller_id",
             AVG(oi."price")         AS "avg_item_price"
      FROM "order_items" AS oi
      GROUP BY oi."seller_id"
) AS price ON price."seller_id" = s."seller_id"
LEFT JOIN (
      SELECT oi."seller_id",
             AVG(r."review_score")   AS "avg_review_score"
      FROM "order_items"  AS oi
      JOIN "order_reviews" AS r
        ON r."order_id" = oi."order_id"
      GROUP BY oi."seller_id"
) AS rev   ON rev."seller_id"   = s."seller_id"
LEFT JOIN (
      SELECT oi."seller_id",
             AVG(julianday(o."order_delivered_carrier_date") 
                 - julianday(o."order_purchase_timestamp")) AS "avg_packing_time_days"
      FROM "order_items" AS oi
      JOIN "orders"      AS o
        ON o."order_id" = oi."order_id"
      WHERE o."order_delivered_carrier_date" IS NOT NULL
      GROUP BY oi."seller_id"
) AS pack  ON pack."seller_id"  = s."seller_id"
LIMIT 20;
