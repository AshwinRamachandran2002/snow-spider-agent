```sql
-- 1) Overview of all sellers we have in the platform
SELECT DISTINCT 
       s."seller_id",
       s."seller_city",
       s."seller_state"
FROM   "sellers" AS s
LIMIT 20;
```

```sql
-- 2) Raw information about what every seller sold (one line per order-item)
SELECT DISTINCT 
       oi."seller_id",
       oi."order_id",
       oi."product_id",
       oi."price",
       oi."freight_value"
FROM   "order_items" AS oi
LIMIT 20;
```

```sql
-- 3) First aggregation – total number of items sold and gross sales by seller
SELECT 
       oi."seller_id",
       COUNT(*)               AS "qty_sold",
       SUM(oi."price")        AS "total_sales_value",
       AVG(oi."price")        AS "avg_item_price"
FROM   "order_items" AS oi
GROUP  BY oi."seller_id"
HAVING COUNT(*) > 100          -- keep only the active ones
LIMIT 20;
```

```sql
-- 4) Look at the review scores that customers left for each order
SELECT DISTINCT 
       r."order_id",
       r."review_score"
FROM   "order_reviews" AS r
LIMIT 20;
```

```sql
-- 5) Average review score obtained by every seller (only sellers with >100 sold items kept)
SELECT 
       oi."seller_id",
       ROUND(AVG(r."review_score"), 2) AS "avg_review_score"
FROM   "order_items"  AS oi
JOIN   "order_reviews" AS r    ON r."order_id" = oi."order_id"
GROUP  BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
-- 6) Inspect purchase / approval / carrier dispatch timestamps for building packing-time metric
SELECT DISTINCT
       o."order_id",
       o."order_approved_at",
       o."order_delivered_carrier_date"
FROM   "orders" AS o
LIMIT 20;
```

```sql
-- 7) Average packing time (in hours) per seller – time between order approval and seller dispatch
SELECT 
       oi."seller_id",
       ROUND(AVG(
             (julianday(o."order_delivered_carrier_date") - 
              julianday(o."order_approved_at")) * 24), 2) AS "avg_packing_time_hrs"
FROM   "order_items" AS oi
JOIN   "orders"      AS o  ON o."order_id" = oi."order_id"
WHERE  o."order_delivered_carrier_date" IS NOT NULL
  AND  o."order_approved_at"            IS NOT NULL
GROUP  BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
-- 8) Product catalogue with the English translation of category names
SELECT DISTINCT
       p."product_id",
       p."product_category_name",
       t."product_category_name_english"
FROM   "products"                          AS p
LEFT   JOIN "product_category_name_translation" AS t
       ON t."product_category_name" = p."product_category_name"
LIMIT 20;
```

```sql
-- 9) Which product categories (English) sell the most items on the whole marketplace
SELECT 
       t."product_category_name_english",
       COUNT(*) AS "items_sold"
FROM   "order_items" AS oi
JOIN   "products"    AS p ON p."product_id" = oi."product_id"
LEFT   JOIN "product_category_name_translation" AS t
       ON t."product_category_name" = p."product_category_name"
GROUP  BY t."product_category_name_english"
ORDER  BY COUNT(*) DESC
LIMIT 20;
```

```sql
-- 10) FINAL PERFORMANCE REPORT – all KPIs per high-volume seller (>100 items sold)
SELECT
       base."seller_id",
       base."qty_sold",
       base."total_sales_value",
       ROUND(base."avg_item_price", 2)         AS "avg_item_price",
       rev."avg_review_score",
       pack."avg_packing_time_hrs"
FROM   (
         SELECT 
                oi."seller_id",
                COUNT(*)        AS "qty_sold",
                SUM(oi."price") AS "total_sales_value",
                AVG(oi."price") AS "avg_item_price"
         FROM   "order_items" AS oi
         GROUP  BY oi."seller_id"
         HAVING COUNT(*) > 100
       ) AS base
LEFT JOIN (
         SELECT 
                oi."seller_id",
                ROUND(AVG(r."review_score"), 2) AS "avg_review_score"
         FROM   "order_items"  AS oi
         JOIN   "order_reviews" AS r ON r."order_id" = oi."order_id"
         GROUP  BY oi."seller_id"
       ) AS rev   ON rev."seller_id"  = base."seller_id"
LEFT JOIN (
         SELECT 
                oi."seller_id",
                ROUND(AVG(
                      (julianday(o."order_delivered_carrier_date") - 
                       julianday(o."order_approved_at")) * 24), 2) AS "avg_packing_time_hrs"
         FROM   "order_items" AS oi
         JOIN   "orders"      AS o ON o."order_id" = oi."order_id"
         WHERE  o."order_delivered_carrier_date" IS NOT NULL
           AND  o."order_approved_at"            IS NOT NULL
         GROUP  BY oi."seller_id"
       ) AS pack ON pack."seller_id" = base."seller_id"
ORDER BY base."total_sales_value" DESC
LIMIT 20;
```
