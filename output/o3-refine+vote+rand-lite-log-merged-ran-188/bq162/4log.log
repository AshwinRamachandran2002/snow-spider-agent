```

```sql
--Description: Pull the entityIds for WUSTL Level-2 imaging files; we will join these to
--id_provenance_r5 to find higher-level records derived from them.
SELECT
  `entityId`,
  `Imaging_Assay_Type`
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE LOWER(`HTAN_Center`) = 'htan wustl'
  AND LOWER(`Component`) = 'imaginglevel2'
  AND LOWER(`Imaging_Assay_Type`) NOT LIKE '%electron%'
LIMIT 20;
```

```sql
--Description: Inspect what Components exist in id_provenance_r5 for the WUSTL center
--(this shows all data levels, not just imaging).
SELECT DISTINCT
  `Component`
FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE LOWER(`HTAN_Center`) = 'htan wustl'
  AND `Component` IS NOT NULL
  AND LOWER(`Component`) NOT LIKE '%auxiliary%'
  AND LOWER(`Component`) NOT LIKE '%otherassay%'
LIMIT 20;
```

```sql
--Description: Restrict the previous list to imaging Components that are Level-3 or Level-4.
SELECT DISTINCT
  `Component`
FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE LOWER(`HTAN_Center`) = 'htan wustl'
  AND (LOWER(`Component`) LIKE 'imaginglevel3%' OR LOWER(`Component`) LIKE 'imaginglevel4%')
LIMIT 20;
```

```sql
--Description: Join WUSTL Level-2 imaging rows to id_provenance to see if the exact same
--entityId also shows up as a Level-3 or Level-4 record (direct derivations).
SELECT DISTINCT
  l2.`Imaging_Assay_Type`,
  idp.`Component` AS higher_level_component
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`          AS idp
  ON l2.`entityId` = idp.`entityId`
WHERE LOWER(l2.`HTAN_Center`) = 'htan wustl'
  AND LOWER(l2.`Component`)   = 'imaginglevel2'
  AND idp.`Component` IS NOT NULL
  AND LOWER(idp.`Component`) NOT LIKE '%auxiliary%'
  AND LOWER(idp.`Component`) NOT LIKE '%otherassay%'
  AND (LOWER(idp.`Component`) LIKE 'imaginglevel3%' OR LOWER(idp.`Component`) LIKE 'imaginglevel4%')
LIMIT 20;
```

```sql
--Description: Count, per imaging assay type, how many Level-3 and Level-4 files share the
--same entityId with a WUSTL Level-2 imaging record.
SELECT
  l2.`Imaging_Assay_Type`,
  SUM(CASE WHEN LOWER(idp.`Component`) LIKE 'imaginglevel3%' THEN 1 ELSE 0 END) AS level3_cnt,
  SUM(CASE WHEN LOWER(idp.`Component`) LIKE 'imaginglevel4%' THEN 1 ELSE 0 END) AS level4_cnt
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`          AS idp
  ON l2.`entityId` = idp.`entityId`
WHERE LOWER(l2.`HTAN_Center`) = 'htan wustl'
  AND LOWER(l2.`Component`)   = 'imaginglevel2'
  AND idp.`Component` IS NOT NULL
  AND LOWER(idp.`Component`) NOT LIKE '%auxiliary%'
  AND LOWER(idp.`Component`) NOT LIKE '%otherassay%'
  AND (LOWER(idp.`Component`) LIKE 'imaginglevel3%' OR LOWER(idp.`Component`) LIKE 'imaginglevel4%')
GROUP BY l2.`Imaging_Assay_Type`
LIMIT 20;
```

```sql
--Description: In some cases the higher-level files have new entityIds.  Search for any
--Level-3/4 imaging files from WUSTL and link them back to a Level-2 file via shared
--Imaging_Assay_Type and HTAN_Center (looser linkage).
SELECT DISTINCT
  l3_4.`entityId` AS higher_entity,
  l3_4.`Component` AS higher_component,
  l2.`Imaging_Assay_Type`
FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5`          AS l3_4
JOIN `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  ON LOWER(l3_4.`HTAN_Center`) = LOWER(l2.`HTAN_Center`)
     AND l3_4.`Component` IS NOT NULL
     AND (LOWER(l3_4.`Component`) LIKE 'imaginglevel3%' OR LOWER(l3_4.`Component`) LIKE 'imaginglevel4%')
WHERE LOWER(l2.`HTAN_Center`) = 'htan wustl'
  AND LOWER(l2.`Component`)   = 'imaginglevel2'
  AND LOWER(l2.`Imaging_Assay_Type`) NOT LIKE '%electron%'
LIMIT 20;
```

```sql
--Description: Final concise list of WUSTL imaging assay types together with which higher
--levels exist (any match found).  This is the query you can use to create the answer table.
SELECT
  l2.`Imaging_Assay_Type`,
  'Level2'                                  AS Level2_Available,
  MAX(IF(LOWER(idp.`Component`) LIKE 'imaginglevel3%', 'Level3', NULL)) AS Level3_Available,
  MAX(IF(LOWER(idp.`Component`) LIKE 'imaginglevel4%', 'Level4', NULL)) AS Level4_Available
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`      AS idp
  ON l2.`entityId` = idp.`entityId`
WHERE LOWER(l2.`HTAN_Center`) = 'htan wustl'
  AND LOWER(l2.`Component`)   = 'imaginglevel2'
  AND LOWER(l2.`Imaging_Assay_Type`) NOT LIKE '%electron%'
  AND (idp.`Component` IS NULL
       OR (LOWER(idp.`Component`) NOT LIKE '%auxiliary%'
           AND LOWER(idp.`Component`) NOT LIKE '%otherassay%'))
GROUP BY l2.`Imaging_Assay_Type`
LIMIT 20;
```
