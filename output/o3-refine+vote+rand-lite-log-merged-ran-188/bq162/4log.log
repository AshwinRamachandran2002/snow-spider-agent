--Description: 
--Goal: Verify whether any HTAN WUSTL Level-2 imaging files (imaging_level2_metadata_r5) have
--corresponding entries in id_provenance_r5.  
--Strategy:  
--  • Select all WUSTL Level-2 imaging rows.  
--  • LEFT JOIN to id_provenance_r5 on the same entityId.  
--  • Show the entityId, assay type, and the Component recorded in id_provenance (if any).  
--Interpretation:  
--  • If provenance_component is NULL → that Level-2 file has no entry in id_provenance_r5.  
--  • If provenance_component is ‘ImagingLevel2’ → only Level-2 is registered.  
--  • If provenance_component starts with ‘ImagingLevel3’ or ‘ImagingLevel4’ → a higher-level
--    imaging file shares the same entityId (which would answer the original question).  
--Limiting to 20 rows keeps it lightweight while revealing the pattern.

SELECT DISTINCT
  l2.`entityId`,
  l2.`Imaging_Assay_Type`,
  idp.`Component` AS provenance_component
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`      AS idp
       ON l2.`entityId` = idp.`entityId`
WHERE LOWER(l2.`HTAN_Center`) = 'htan wustl'
  AND LOWER(l2.`Component`)   = 'imaginglevel2'
LIMIT 20;
