Query:
--Description: Look at all rows in the r5 Level-2 imaging metadata and see which imaging-assay
--types the WUSTL center has (quick sanity check).
SELECT DISTINCT
  `Imaging_Assay_Type`
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE LOWER(`HTAN_Center`) = 'htan wustl'
  AND LOWER(`Imaging_Assay_Type`) NOT LIKE '%electron%'
LIMIT 20;
Answer:
Imaging_Assay_Type
IMC
H&E
CODEX
Query:
--Description: Confirm that these WUSTL Level-2 rows really have Component = ‘ImagingLevel2’
--and that none is “Auxiliary/OtherAssay”.
SELECT DISTINCT
  `Component`, `Imaging_Assay_Type`
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE LOWER(`HTAN_Center`) = 'htan wustl'
  AND LOWER(`Component`) NOT LIKE '%auxiliary%'
  AND LOWER(`Component`) NOT LIKE '%otherassay%'
LIMIT 20;
Answer:
Component,Imaging_Assay_Type
ImagingLevel2,IMC
ImagingLevel2,H&E
ImagingLevel2,CODEX
Query:
--Description: Pull the entityIds for WUSTL Level-2 imaging files; we will join these to
--id_provenance_r5 to find higher-level records derived from them.
SELECT
  `entityId`,
