Query:
--Description: Count, by assay type, how many ImagingLevel-3 and ImagingLevel-4 records
--share the exact same entityId with a WUSTL ImagingLevel-2 file.  Because the LEFT JOIN
--does not filter anything in the WHERE clause, assay types with zero higher-level files
--still appear with counts of 0.
SELECT
  l2.`Imaging_Assay_Type`,
  SUM(CASE WHEN LOWER(idp.`Component`) LIKE 'imaginglevel3%' THEN 1 ELSE 0 END) AS level3_cnt,
  SUM(CASE WHEN LOWER(idp.`Component`) LIKE 'imaginglevel4%' THEN 1 ELSE 0 END) AS level4_cnt
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`      AS idp
       ON l2.`entityId` = idp.`entityId`
      AND LOWER(idp.`Component`) LIKE 'imaginglevel%'        -- keep only imaging components
WHERE LOWER(l2.`HTAN_Center`) = 'htan wustl'
  AND LOWER(l2.`Component`)   = 'imaginglevel2'
GROUP BY l2.`Imaging_Assay_Type`
LIMIT 20
