Query:
--Description:
-- 7. How many Level-2 entityIds (HTAN WUSTL) also appear in id_provenance_r5?
SELECT l2.`Imaging_Assay_Type`,
       COUNT(*) AS level2_entityIds_also_in_provenance
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS prov
  ON   l2.`entityId` = prov.`entityId`
WHERE  l2.`HTAN_Center` = 'HTAN WUSTL'
  AND  LOWER(l2.`Component`) = 'imaginglevel2'   -- corrected spelling
GROUP  BY l2.`Imaging_Assay_Type`
LIMIT 20
