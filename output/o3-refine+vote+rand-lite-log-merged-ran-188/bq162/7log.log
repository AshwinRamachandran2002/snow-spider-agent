--   1) level2  – distinct assay types occurring with Component = 'ImagingLevel2'.
--   2) levels34 – collect any WUSTL provenance rows whose Component starts with
--      'ImagingLevel3' or 'ImagingLevel4', tagging them as Level3 / Level4.
--   3) Final  – cartesian‐join every assay type to the set of observed levels,
--      then aggregate distinct level names into a comma-separated string.
WITH level2 AS (
  SELECT DISTINCT `Imaging_Assay_Type`, 'Level2' AS lvl
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE `HTAN_Center` = 'HTAN WUSTL'
    AND LOWER(`Component`) = 'imaginglevel2'
),
levels34 AS (
  SELECT DISTINCT
         'Level' || REGEXP_EXTRACT(LOWER(`Component`), r'level([34])') AS lvl
  FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
  WHERE `HTAN_Center` = 'HTAN WUSTL'
    AND `Component` IS NOT NULL
    AND LOWER(`Component`) LIKE 'imaginglevel%'      -- ImagingLevel3 / ImagingLevel4
)
SELECT l2.`Imaging_Assay_Type`,
       STRING_AGG(DISTINCT l3.lvl ORDER BY l3.lvl) AS available_levels
FROM   level2 AS l2
LEFT  JOIN levels34 AS l3 ON TRUE
GROUP  BY l2.`Imaging_Assay_Type`
LIMIT 20;
```
