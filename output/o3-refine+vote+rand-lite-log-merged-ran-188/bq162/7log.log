```sql
-- 1.  Distinct imaging assay types that have Level-2 metadata at the WUSTL center (r5 release)
SELECT DISTINCT `Imaging_Assay_Type`
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE  `HTAN_Center` = 'HTAN WUSTL'
  AND  LOWER(`Component`) = 'imagenglevel2'
ORDER BY `Imaging_Assay_Type`
LIMIT 20;
```

```sql
-- 2.  Number of Level-2 files available per imaging assay type for HTAN WUSTL
SELECT   `Imaging_Assay_Type`,
         COUNT(*) AS level2_file_count
FROM     `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE    `HTAN_Center` = 'HTAN WUSTL'
  AND    LOWER(`Component`) = 'imagenglevel2'
GROUP BY `Imaging_Assay_Type`
ORDER BY level2_file_count DESC
LIMIT 20;
```

```sql
-- 3.  Sample Level-2 entityIds for each assay type (HTAN WUSTL)
SELECT   `Imaging_Assay_Type`,
         ARRAY_AGG(`entityId` ORDER BY `entityId` LIMIT 3) AS sample_level2_entityIds
FROM     `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE    `HTAN_Center` = 'HTAN WUSTL'
  AND    LOWER(`Component`) = 'imagenglevel2'
GROUP BY `Imaging_Assay_Type`
LIMIT 20;
```

```sql
-- 4.  Distinct imaging Components in id_provenance_r5 for HTAN WUSTL
SELECT DISTINCT `Component`
FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE  `HTAN_Center` = 'HTAN WUSTL'
  AND  `Component` IS NOT NULL
  AND  LOWER(`Component`) NOT LIKE '%auxiliary%'
  AND  LOWER(`Component`) NOT LIKE '%otherassay%'
ORDER BY `Component`
LIMIT 20;
```

```sql
-- 5.  Count of Level-3 / Level-4 imaging files recorded in id_provenance_r5 for HTAN WUSTL
SELECT   CASE
           WHEN LOWER(`Component`) LIKE '%level3%' THEN 'Level3'
           WHEN LOWER(`Component`) LIKE '%level4%' THEN 'Level4'
         END                                            AS data_level,
         COUNT(*)                                       AS file_count
FROM     `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE    `HTAN_Center` = 'HTAN WUSTL'
  AND    `Component` IS NOT NULL
  AND    LOWER(`Component`) LIKE 'imaginglevel%'
GROUP BY data_level
ORDER BY data_level
LIMIT 20;
```

```sql
-- 6.  Example Level-3 / Level-4 imaging entityIds for HTAN WUSTL
SELECT `Component`, ARRAY_AGG(`entityId` ORDER BY `entityId` LIMIT 5) AS sample_entityIds
FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE  `HTAN_Center` = 'HTAN WUSTL'
  AND  `Component` IS NOT NULL
  AND  LOWER(`Component`) LIKE 'imaginglevel%'
GROUP BY `Component`
LIMIT 20;
```

```sql
-- 7.  Link Level-2 files to any identically-named entityId rows that appear in id_provenance_r5
SELECT l2.`Imaging_Assay_Type`,
       COUNT(*) AS level2_entityIds_also_in_provenance
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`            AS prov
  ON   l2.`entityId` = prov.`entityId`
WHERE  l2.`HTAN_Center` = 'HTAN WUSTL'
  AND  LOWER(l2.`Component`) = 'imagenglevel2'
GROUP  BY l2.`Imaging_Assay_Type`
LIMIT 20;
```

```sql
-- 8.  For each imaging assay type, list the highest data levels observed (Level-2/3/4)
WITH level2 AS (
  SELECT DISTINCT `Imaging_Assay_Type`, 'Level2' AS lvl
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE  `HTAN_Center` = 'HTAN WUSTL'
    AND  LOWER(`Component`) = 'imagenglevel2'
),
levels34 AS (
  SELECT DISTINCT
         'Level' || REGEXP_EXTRACT(LOWER(`Component`), r'level([34])') AS lvl,
         -- crude mapping of assay type via suffix after first underscore in entityId: HTA?_XXX_...
         SPLIT(prov.`entityId`, '_')[OFFSET(2)]                       AS imaging_assay_hint
  FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5` AS prov
  WHERE  prov.`HTAN_Center` = 'HTAN WUSTL'
    AND  prov.`Component` IS NOT NULL
    AND  LOWER(prov.`Component`) LIKE 'imaginglevel%'
)
SELECT DISTINCT l2.`Imaging_Assay_Type`,
       STRING_AGG(DISTINCT l.lvl ORDER BY l.lvl) AS available_levels
FROM   level2 AS l2
JOIN   levels34 AS l
  ON   TRUE     -- (no direct mapping; inspection query to see coverage)
GROUP  BY l2.`Imaging_Assay_Type`
LIMIT 20;
```

