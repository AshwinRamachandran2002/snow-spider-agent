Query:
--Description:
-- 5. Count Level-3 and Level-4 imaging files (any assay) for HTAN WUSTL in id_provenance_r5.
SELECT   CASE
           WHEN LOWER(`Component`) LIKE '%level3%' THEN 'Level3'
           WHEN LOWER(`Component`) LIKE '%level4%' THEN 'Level4'
         END  AS data_level,
         COUNT(*) AS file_count
FROM     `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE    `HTAN_Center` = 'HTAN WUSTL'
  AND    `Component` IS NOT NULL
  AND    LOWER(`Component`) LIKE 'imaginglevel%'   -- keep only imaging levels
GROUP BY data_level
ORDER BY data_level
LIMIT 20
Answer:
data_level,file_count
,199
Query:
--Description:
-- 6. Provide five example entityIds for each imaging Level-3 / Level-4 Component at HTAN WUSTL.
SELECT `Component`,
       ARRAY_AGG(`entityId` ORDER BY `entityId` LIMIT 5) AS sample_entityIds
FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE  `HTAN_Center` = 'HTAN WUSTL'
  AND  `Component` IS NOT NULL
  AND  LOWER(`Component`) LIKE 'imaginglevel%'   -- imaging only
GROUP BY `Component`
LIMIT 20
