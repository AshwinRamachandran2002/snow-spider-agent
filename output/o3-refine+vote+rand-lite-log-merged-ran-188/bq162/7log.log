Query:
--Description:
-- 2. Count how many Level-2 files each imaging assay type has at HTAN WUSTL (r5).
SELECT   `Imaging_Assay_Type`,
         COUNT(*) AS level2_file_count
FROM     `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE    `HTAN_Center` = 'HTAN WUSTL'
  AND    LOWER(`Component`) = 'imaginglevel2'   -- corrected spelling
GROUP BY `Imaging_Assay_Type`
ORDER BY level2_file_count DESC
LIMIT 20
Answer:
Imaging_Assay_Type,level2_file_count
IMC,78
H&E,72
CODEX,49
Query:
--Description:
-- 3. Show three sample Level-2 entityIds for every imaging assay type from HTAN WUSTL.
SELECT   `Imaging_Assay_Type`,
         ARRAY_AGG(`entityId` ORDER BY `entityId` LIMIT 3) AS sample_level2_entityIds
FROM     `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE    `HTAN_Center` = 'HTAN WUSTL'
  AND    LOWER(`Component`) = 'imaginglevel2'   -- corrected spelling
GROUP BY `Imaging_Assay_Type`
LIMIT 20
