--Description: Query 10 (corrected FINAL) – return each HTAN WUSTL imaging-assay type
--             that has Level-2 data AND at least one higher imaging level (3 or 4),
--             excluding Electron microscopy, Auxiliary, OtherAssay.  Join uses the
--             parent/child HTAN_Data_File_ID relationship.
WITH l2 AS (   -- Level-2 files
  SELECT DISTINCT
         HTAN_Data_File_ID,
         Imaging_Assay_Type
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE HTAN_Center = 'HTAN WUSTL'
    AND LOWER(Imaging_Assay_Type) NOT LIKE '%electron%'
),
derived AS (   -- Higher-level imaging files
  SELECT
    p.HTAN_Parent_Data_File_ID AS parent_l2_file,
    CASE
      WHEN LOWER(p.Component) LIKE 'imaginglevel3%' THEN 'Level3'
      WHEN LOWER(p.Component) LIKE 'imaginglevel4%' THEN 'Level4'
    END AS higher_level
  FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5` AS p
  WHERE p.HTAN_Center = 'HTAN WUSTL'
    AND p.Component IS NOT NULL
    AND LOWER(p.Component) NOT LIKE '%auxiliary%'
    AND LOWER(p.Component) NOT LIKE '%otherassay%'
    AND (LOWER(p.Component) LIKE 'imaginglevel3%' OR
         LOWER(p.Component) LIKE 'imaginglevel4%')
)
SELECT
  l2.Imaging_Assay_Type,
  ARRAY_AGG(DISTINCT higher_level ORDER BY higher_level) AS higher_levels_present
FROM l2
JOIN derived
  ON derived.parent_l2_file = l2.HTAN_Data_File_ID
GROUP BY l2.Imaging_Assay_Type
LIMIT 20;
