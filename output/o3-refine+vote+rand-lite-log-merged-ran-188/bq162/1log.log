Query:
--Description: Query 7 (corrected) – list every distinct data level (Level2/3/4) that exists
--             for each imaging-assay type at HTAN WUSTL.  Level-3/4 rows are found by
--             matching the provenance column HTAN_Parent_Data_File_ID to the Level-2
--             HTAN_Data_File_ID.
WITH joined AS (
  -- Level-2 always present
  SELECT DISTINCT
         l2.Imaging_Assay_Type,
         'Level2' AS data_level
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  WHERE l2.HTAN_Center = 'HTAN WUSTL'

  UNION DISTINCT

  -- Level-3 & Level-4 derived files
  SELECT
    l2.Imaging_Assay_Type,
    CASE
      WHEN LOWER(p.Component) LIKE 'imaginglevel3%' THEN 'Level3'
      WHEN LOWER(p.Component) LIKE 'imaginglevel4%' THEN 'Level4'
    END AS data_level
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`            AS p
    ON p.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
  WHERE l2.HTAN_Center = 'HTAN WUSTL'
    AND p.Component IS NOT NULL
    AND LOWER(p.Component) NOT LIKE '%auxiliary%'
    AND LOWER(p.Component) NOT LIKE '%otherassay%'
    AND (LOWER(p.Component) LIKE 'imaginglevel3%' OR
         LOWER(p.Component) LIKE 'imaginglevel4%')
)
SELECT DISTINCT *
FROM joined
ORDER BY Imaging_Assay_Type, data_level
LIMIT 20
Answer:
Imaging_Assay_Type,data_level
CODEX,Level2
H&E,Level2
IMC,Level2
Query:
--Description: Query 8 (corrected) – aggregate the previous result so each imaging-assay
--             type is accompanied by a comma-separated list of available levels.
WITH joined AS (
  -- Level-2
  SELECT DISTINCT
         l2.Imaging_Assay_Type,
         'Level2' AS data_level
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  WHERE l2.HTAN_Center = 'HTAN WUSTL'

  UNION DISTINCT

  -- Level-3 / Level-4
  SELECT
    l2.Imaging_Assay_Type,
    CASE
      WHEN LOWER(p.Component) LIKE 'imaginglevel3%' THEN 'Level3'
      WHEN LOWER(p.Component) LIKE 'imaginglevel4%' THEN 'Level4'
    END AS data_level
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`            AS p
    ON p.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
  WHERE l2.HTAN_Center = 'HTAN WUSTL'
    AND p.Component IS NOT NULL
    AND LOWER(p.Component) NOT LIKE '%auxiliary%'
    AND LOWER(p.Component) NOT LIKE '%otherassay%'
    AND (LOWER(p.Component) LIKE 'imaginglevel3%' OR
         LOWER(p.Component) LIKE 'imaginglevel4%')
)
SELECT
  Imaging_Assay_Type,
  STRING_AGG(DISTINCT data_level ORDER BY data_level) AS available_levels
FROM joined
GROUP BY Imaging_Assay_Type
LIMIT 20
