--Description: 
-- Return every HTAN WUSTL imaging-assay type that has Level-2 data **and**
-- at least one higher-level imaging file (Level 3 or Level 4) derived from
-- those Level-2 files.  
-- Key points / thinking:
--   • l2 CTE gathers WUSTL Level-2 imaging rows (HTAN_Data_File_ID + assay type),
--     explicitly excluding anything whose assay name contains “electron”.
--   • derived CTE pulls provenance rows whose HTAN_Parent_Data_File_ID matches a
--     Level-2 file and whose Component starts with “ImagingLevel3” or “ImagingLevel4”,
--     while filtering out NULL / Auxiliary / OtherAssay components.
--   • Final SELECT joins the two CTEs, grouping by Imaging_Assay_Type and collecting
--     the unique higher levels present.  Limiting to 20 rows keeps the preview short.
WITH l2 AS (   -- Level-2 files for HTAN WUSTL
  SELECT DISTINCT
         HTAN_Data_File_ID,
         Imaging_Assay_Type
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE HTAN_Center = 'HTAN WUSTL'
    AND LOWER(Imaging_Assay_Type) NOT LIKE '%electron%'
),
derived AS (   -- Level-3 / Level-4 imaging files derived from those Level-2 files
  SELECT
    p.HTAN_Parent_Data_File_ID AS parent_l2_file,
    CASE
      WHEN LOWER(p.Component) LIKE 'imaginglevel3%' THEN 'Level3'
      WHEN LOWER(p.Component) LIKE 'imaginglevel4%' THEN 'Level4'
    END AS higher_level
  FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5` AS p
  WHERE p.HTAN_Center = 'HTAN WUSTL'
    AND p.Component IS NOT NULL
    AND LOWER(p.Component) NOT LIKE '%auxiliary%'
    AND LOWER(p.Component) NOT LIKE '%otherassay%'
    AND (LOWER(p.Component) LIKE 'imaginglevel3%' OR
         LOWER(p.Component) LIKE 'imaginglevel4%')
)
SELECT
  l2.Imaging_Assay_Type,
  ARRAY_AGG(DISTINCT higher_level ORDER BY higher_level) AS higher_levels_present
FROM l2
JOIN derived
  ON derived.parent_l2_file = l2.HTAN_Data_File_ID
GROUP BY l2.Imaging_Assay_Type
LIMIT 20;
```
