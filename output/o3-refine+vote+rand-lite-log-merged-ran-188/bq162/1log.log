Below is a sequence of (≤ 10) exploratory BigQuery SQL statements – from simple inspections to the final summary – that isolates the HTAN WUSTL imaging-assay types that possess Level 2 data in the fifth revision (r5) and shows any Level 3 / Level 4 data derived from them through the relationships recorded in `id_provenance_r5`.   
(Each query is limited to 20 rows for inspection purposes and skips Components that are NULL, contain “Auxiliary”, or “OtherAssay”; Electron-microscopy assay types and Level 1 data are not considered.)

```sql
-- 1. Peek at the r5 Level-2 imaging-metadata table to verify available columns
SELECT *
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
LIMIT 20;
```

```sql
-- 2. List distinct HTAN centers represented in the Level-2 imaging r5 table
SELECT DISTINCT HTAN_Center
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
LIMIT 20;
```

```sql
-- 3. Retrieve the imaging-assay types available at HTAN WUSTL (Level-2, r5)
SELECT DISTINCT Imaging_Assay_Type
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE HTAN_Center = 'HTAN WUSTL'
LIMIT 20;
```

```sql
-- 4. Inspect a few rows of the provenance table for HTAN WUSTL to see field names
SELECT *
FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE HTAN_Center = 'HTAN WUSTL'
LIMIT 20;
```

```sql
-- 5. Show the distinct component names in the provenance table for WUSTL,
--     keeping only imaging-related entries and excluding Auxiliary/OtherAssay/NULL
SELECT DISTINCT Component
FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE HTAN_Center = 'HTAN WUSTL'
  AND Component IS NOT NULL
  AND LOWER(Component) NOT LIKE '%auxiliary%'
  AND LOWER(Component) NOT LIKE '%otherassay%'
  AND LOWER(Component) LIKE 'imaginglevel%'
LIMIT 20;
```

```sql
-- 6. Join Level-2 metadata to provenance on the Level-2 entityId to pick up
--     any derived Level-3 / Level-4 entityIds (childId) that link back to
--     the same Level-2 file.  The column 'inputEntityId' (parent) is inferred
--     from the provenance table after inspection in step 4.
SELECT l2.Imaging_Assay_Type,
       l2.entityId              AS level2_entity,
       p.entityId               AS level3_or_4_entity,
       p.Component              AS level3_or_4_component
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`          AS p
  ON   p.inputEntityId = l2.entityId
WHERE  l2.HTAN_Center = 'HTAN WUSTL'
  AND  LOWER(p.Component) LIKE 'imaginglevel3%'  -- ‑-Level 3
     OR LOWER(p.Component) LIKE 'imaginglevel4%' -- ‑-Level 4
LIMIT 20;
```

```sql
-- 7. Collect the distinct data levels (2/3/4) that exist for each imaging assay
WITH joined AS (
  SELECT l2.Imaging_Assay_Type,
         'Level2'                            AS data_level
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  WHERE  l2.HTAN_Center = 'HTAN WUSTL'

  UNION DISTINCT

  SELECT l2.Imaging_Assay_Type,
         CASE
           WHEN LOWER(p.Component) LIKE 'imaginglevel3%' THEN 'Level3'
           WHEN LOWER(p.Component) LIKE 'imaginglevel4%' THEN 'Level4'
         END                                           AS data_level
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  JOIN   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`          AS p
    ON   p.inputEntityId = l2.entityId
  WHERE  l2.HTAN_Center = 'HTAN WUSTL'
    AND (LOWER(p.Component) LIKE 'imaginglevel3%' OR
         LOWER(p.Component) LIKE 'imaginglevel4%')
)
SELECT DISTINCT *
FROM   joined
ORDER  BY Imaging_Assay_Type, data_level
LIMIT 20;
```

```sql
-- 8. Aggregate the previous result to list, for every imaging assay type,
--     all available data levels concatenated into a single field
WITH joined AS (
  SELECT l2.Imaging_Assay_Type,
         'Level2' AS data_level
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  WHERE  l2.HTAN_Center = 'HTAN WUSTL'

  UNION DISTINCT

  SELECT l2.Imaging_Assay_Type,
         CASE
           WHEN LOWER(p.Component) LIKE 'imaginglevel3%' THEN 'Level3'
           WHEN LOWER(p.Component) LIKE 'imaginglevel4%' THEN 'Level4'
         END AS data_level
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  JOIN   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`          AS p
    ON   p.inputEntityId = l2.entityId
  WHERE  l2.HTAN_Center = 'HTAN WUSTL'
    AND (LOWER(p.Component) LIKE 'imaginglevel3%' OR
         LOWER(p.Component) LIKE 'imaginglevel4%')
)
SELECT   Imaging_Assay_Type,
         STRING_AGG(DISTINCT data_level ORDER BY data_level) AS available_levels
FROM     joined
GROUP BY Imaging_Assay_Type
LIMIT 20;
```

```sql
-- 9. Verify that Electron-microscopy assay types are absent from the result
SELECT DISTINCT Imaging_Assay_Type
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE HTAN_Center = 'HTAN WUSTL'
  AND LOWER(Imaging_Assay_Type) LIKE '%electron%'
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER – imaging assay types at HTAN WUSTL with Level-2 and at least
--     one higher data level (3 or 4), omitting Electron Microscopy and unwanted Components
WITH l2 AS (
  SELECT DISTINCT entityId,
                  Imaging_Assay_Type
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE  HTAN_Center = 'HTAN WUSTL'
    AND  LOWER(Imaging_Assay_Type) NOT LIKE '%electron%'
),
derived AS (
  SELECT DISTINCT p.inputEntityId   AS parent_l2_id,
                  CASE
                    WHEN LOWER(p.Component) LIKE 'imaginglevel3%' THEN 'Level3'
                    WHEN LOWER(p.Component) LIKE 'imaginglevel4%' THEN 'Level4'
                  END                                             AS higher_level
  FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5` AS p
  WHERE  p.HTAN_Center = 'HTAN WUSTL'
    AND (LOWER(p.Component) LIKE 'imaginglevel3%' OR
         LOWER(p.Component) LIKE 'imaginglevel4%')
    AND p.Component IS NOT NULL
    AND LOWER(p.Component) NOT LIKE '%auxiliary%'
    AND LOWER(p.Component) NOT LIKE '%otherassay%'
)
SELECT   l2.Imaging_Assay_Type,
         ARRAY_AGG(DISTINCT higher_level ORDER BY higher_level) AS higher_levels_present
FROM     l2
JOIN     derived ON derived.parent_l2_id = l2.entityId
GROUP BY l2.Imaging_Assay_Type
LIMIT 20;
```

These ten queries progress from exploration of the raw r5 metadata to a concise list of HTAN WUSTL imaging-assay types that possess Level 2 files plus corresponding Level 3/Level 4 derivatives, satisfying all stated constraints.
