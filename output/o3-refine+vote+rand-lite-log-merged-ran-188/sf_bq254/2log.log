```sql
--Description:  Identify the two multipolygons (within the Q191 area, OSM way-id = 853624461)
--that have no ‘wikidata’ tag yet contain the most point-features.  Steps:
--1️⃣  q191 CTE fetches Q191 geometry. 
--2️⃣  candidates CTE collects overlapping multipolygons that *lack* any wikidata tag
--    (checked via NOT EXISTS + FLATTEN). 
--3️⃣  point_counts CTE counts how many PLANET_FEATURES_POINTS each candidate contains. 
--4️⃣  Final SELECT joins counts back to candidates, extracts each polygon’s “name”
--    tag with a per-row scalar subquery + FLATTEN, orders by point count, and
--    returns the top two.
WITH q191 AS (
    SELECT TO_GEOGRAPHY("geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES"
    WHERE  "osm_way_id" = 853624461          -- Q191 multipolygon
),
candidates AS (
    SELECT pf."osm_way_id",
           pf."geometry",
           pf."all_tags"
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES" pf
    CROSS  JOIN q191
    WHERE  pf."feature_type" = 'multipolygons'
      AND  NOT EXISTS (
             SELECT 1
             FROM   LATERAL FLATTEN(INPUT => pf."all_tags") t
             WHERE  t.value:"key"::STRING = 'wikidata'          -- ensure no wikidata
           )
      AND  ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q191.geom )
),
point_counts AS (
    SELECT  c."osm_way_id",
            COUNT(*) AS point_cnt
    FROM    candidates c
    JOIN    GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES_POINTS" pts
          ON ST_CONTAINS( TO_GEOGRAPHY(c."geometry"), TO_GEOGRAPHY(pts."geometry") )
    GROUP  BY c."osm_way_id"
)
SELECT  pc."osm_way_id",
        /* extract the 'name' tag for each candidate */
        ( SELECT tag.value:"value"::STRING
          FROM   LATERAL FLATTEN(INPUT => cand."all_tags") tag
          WHERE  tag.value:"key"::STRING = 'name'
          LIMIT 1 )                      AS "name",
        pc.point_cnt
FROM    point_counts pc
JOIN    candidates   cand  ON cand."osm_way_id" = pc."osm_way_id"
ORDER BY pc.point_cnt DESC
LIMIT 2;
```
