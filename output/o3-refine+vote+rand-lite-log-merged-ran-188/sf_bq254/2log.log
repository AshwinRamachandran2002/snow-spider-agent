```sql
--Description: Count how many OSM point-features fall inside each intersecting
--multipolygon (no wikidata) that overlaps the Q191 polygon, and list their names.
--Steps:
-- 1. q191 CTE fetches the Q191 geometry.
-- 2. candidates CTE selects overlapping multipolygons that lack a wikidata tag.
-- 3. Final SELECT joins every candidate with PLANET_FEATURES_POINTS, counts the
--    contained points, pulls each candidate’s “name” tag, and ranks by count.
WITH q191 AS (
    SELECT TO_GEOGRAPHY("geometry") AS geom
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES"
    WHERE  "osm_way_id" = 853624461          -- Q191 polygon
), candidates AS (
    SELECT pf."osm_way_id",
           pf."geometry",
           pf."all_tags"
    FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES" pf
    CROSS  JOIN q191
    WHERE  pf."feature_type" = 'multipolygons'
      AND  NOT EXISTS (                    -- exclude if it has a wikidata tag
           SELECT 1
           FROM   LATERAL FLATTEN(INPUT => pf."all_tags") t
           WHERE  t.value:"key"::STRING = 'wikidata' )
      AND  ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q191.geom )
)
SELECT  c."osm_way_id",
        name_tag.value:"value"::STRING  AS "name",
        COUNT(*)                       AS "point_cnt"
FROM    candidates c
LEFT JOIN LATERAL FLATTEN(INPUT => c."all_tags") name_tag
       ON name_tag.value:"key"::STRING = 'name'
JOIN    GEO_OPENSTREETMAP.GEO_OPENSTREETMAP."PLANET_FEATURES_POINTS" pts
      ON ST_CONTAINS( TO_GEOGRAPHY(c."geometry"), TO_GEOGRAPHY(pts."geometry") )
GROUP  BY c."osm_way_id", "name"
ORDER  BY "point_cnt" DESC
LIMIT 20;
```
