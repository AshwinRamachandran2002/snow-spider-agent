    for (var i = 0; i < Math.max(V1.length , V2.length); i++)
        out.push((V1[i] || 0) + (V2[i] || 0));
    return out;
$$;

CREATE OR REPLACE TEMPORARY FUNCTION NORM_VECTOR(VEC VARIANT)
RETURNS FLOAT
LANGUAGE JAVASCRIPT
AS $$
    var s = 0.0;
    for (var i = 0; i < VEC.length; i++)  s += VEC[i] * VEC[i];
    return Math.sqrt(s);
$$;

CREATE OR REPLACE TEMPORARY FUNCTION DIV_VECTOR(VEC VARIANT , DEN FLOAT)
RETURNS VARIANT
LANGUAGE JAVASCRIPT
AS $$ return VEC.map(v => v / DEN); $$;

CREATE OR REPLACE TEMPORARY FUNCTION COSINE_SIM(V1 VARIANT , V2 VARIANT)
RETURNS FLOAT
LANGUAGE JAVASCRIPT
AS $$
    var dot = 0.0 , n1 = 0.0 , n2 = 0.0;
    for (var i = 0; i < V1.length; i++){
        dot += V1[i] * V2[i];
        n1  += V1[i] * V1[i];
        n2  += V2[i] * V2[i];
    }
    return dot / (Math.sqrt(n1) * Math.sqrt(n2));
$$;

/*──────────────────────────  MAIN QUERY  ──────────────────────────────────*/
WITH
-- small stop‑word list
STOPWORDS AS (
  SELECT column1 AS WORD
  FROM VALUES
   ('a'),('an'),('and'),('are'),('as'),('at'),('be'),('but'),('by'),
   ('for'),('from'),('has'),('have'),('in'),('is'),('it'),('its'),
   ('of'),('on'),('or'),('that'),('the'),('to'),('was'),('were'),
   ('will'),('with')
),

/*-----------------  build TOKEN list for the query  ----------------------*/
QUERY_TOKENS AS (
  SELECT LOWER(token) AS TOKEN
  FROM TABLE(
         REGEXP_SPLIT_TO_TABLE(
            'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
            '\\W+'
         )
       ) AS T(token)
  WHERE token IS NOT NULL
    AND token <> ''
    AND LOWER(token) NOT IN (SELECT WORD FROM STOPWORDS)
),

/*-----------------  weighted‑sum vector for the query  -------------------*/
QUERY_VEC AS (
  SELECT
     DIV_VECTOR(
         ARRAY_REDUCE(
             ARRAY_AGG(
                SCALE_VECTOR( GV."vector",
                              1/POWER( COALESCE(WF."frequency",1) , 0.4) )
             ),
             ADD_VECTOR,
             ARRAY_CONSTRUCT()
         ),
         NORM_VECTOR(
             ARRAY_REDUCE(
                 ARRAY_AGG(
                    SCALE_VECTOR( GV."vector",
                                  1/POWER( COALESCE(WF."frequency",1) , 0.4) )
                 ),
                 ADD_VECTOR,
                 ARRAY_CONSTRUCT()
             )
         )
     ) AS UNIT_VEC
  FROM QUERY_TOKENS QT
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS GV
       ON GV."word" = QT.TOKEN
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES WF
       ON WF."word" = QT.TOKEN
),

/*-----------------  explode bodies into tokens  --------------------------*/
ARTICLE_TOKENS AS (
  SELECT
      N."id",
      N."date",
      N."title",
      LOWER(F.VALUE::STRING) AS TOKEN
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE N,
       LATERAL FLATTEN( INPUT => REGEXP_SPLIT_TO_ARRAY( LOWER(N."body"), '\\W+' ) ) F
  WHERE F.VALUE IS NOT NULL
),

ARTICLE_TOKENS_CLEAN AS (
  SELECT *
  FROM ARTICLE_TOKENS
  WHERE TOKEN <> ''
    AND TOKEN NOT IN (SELECT WORD FROM STOPWORDS)
),

/*-----------------  weighted‑sum vectors for every article  --------------*/
ARTICLE_VECS AS (
  SELECT
      ATC."id",
      ATC."date",
      ATC."title",
      ARRAY_REDUCE(
          ARRAY_AGG(
              SCALE_VECTOR( GV."vector",
                            1/POWER( COALESCE(WF."frequency",1) , 0.4) )
          ),
          ADD_VECTOR,
          ARRAY_CONSTRUCT()
      ) AS SUM_VEC
  FROM ARTICLE_TOKENS_CLEAN ATC
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS GV
       ON GV."word" = ATC.TOKEN
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES WF
       ON WF."word" = ATC.TOKEN
  GROUP BY ATC."id", ATC."date", ATC."title"
),

ARTICLE_UNIT AS (
  SELECT
      "id",
      "date",
      "title",
      DIV_VECTOR(SUM_VEC, NORM_VECTOR(SUM_VEC)) AS UNIT_VEC
  FROM ARTICLE_VECS
)

/*-----------------  similarity & top‑10  ---------------------------------*/
SELECT
    A."id",
    A."date",
    A."title",
    COSINE_SIM(A.UNIT_VEC , Q.UNIT_VEC) AS COSINE_SIMILARITY
FROM ARTICLE_UNIT A
CROSS JOIN QUERY_VEC Q
ORDER BY COSINE_SIMILARITY DESC NULLS LAST, A."id"
LIMIT 10;
```
