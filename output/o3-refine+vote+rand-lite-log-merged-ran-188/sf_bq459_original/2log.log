CREATE OR REPLACE TEMPORARY FUNCTION SCALE_VECTOR(VEC VARIANT , WEIGHT FLOAT)
RETURNS VARIANT
LANGUAGE JAVASCRIPT
AS
$$
  return VEC.map(v => v * WEIGHT);
$$
;

CREATE OR REPLACE TEMPORARY FUNCTION ADD_VECTOR(V1 VARIANT , V2 VARIANT)
RETURNS VARIANT
LANGUAGE JAVASCRIPT
AS
$$
  if (V1.length === 0) return V2;
  if (V2.length === 0) return V1;
  var out = [];
  for (var i = 0; i < V1.length; i++)  out.push( (V1[i] || 0) + (V2[i] || 0) );
  return out;
$$
;

CREATE OR REPLACE TEMPORARY FUNCTION NORM_VECTOR(VEC VARIANT)
RETURNS FLOAT
LANGUAGE JAVASCRIPT
AS
$$
  var s = 0.0;
  for (var i = 0; i < VEC.length; i++) s += VEC[i]*VEC[i];
  return Math.sqrt(s);
$$
;

CREATE OR REPLACE TEMPORARY FUNCTION DIV_VECTOR(VEC VARIANT , DEN FLOAT)
RETURNS VARIANT
LANGUAGE JAVASCRIPT
AS
$$
  return VEC.map(v => v / DEN);
$$
;

CREATE OR REPLACE TEMPORARY FUNCTION COSINE_SIM(V1 VARIANT , V2 VARIANT)
RETURNS FLOAT
LANGUAGE JAVASCRIPT
AS
$$
  var dot = 0.0;
  for (var i = 0; i < V1.length; i++) dot += V1[i]*V2[i];
  var n1 = 0.0 , n2 = 0.0;
  for (var i = 0; i < V1.length; i++) { n1 += V1[i]*V1[i]; n2 += V2[i]*V2[i]; }
  return dot / (Math.sqrt(n1)*Math.sqrt(n2));
$$
;

/*---------------------------------------------------------------------
  STEP‑2 :  build the QUERY vector  (unit length)
 --------------------------------------------------------------------*/
QUERY_VEC AS (
SELECT
    DIV_VECTOR( SUM_VEC , NORM_VECTOR(SUM_VEC) )   AS UNIT_VEC
FROM (
      SELECT
          /* ---- sum all scaled word‑vectors of query ---- */
          ARRAY_AGG( SCALE_VECTOR( GV."vector"
                                  , 1/POWER( COALESCE(WF."frequency",1) , 0.4) )
                     )      AS VEC_ARRAY
      FROM (  /* ---- tokenise query ---- */
             SELECT LOWER( VALUE::STRING ) AS TOKEN
             FROM TABLE( REGEXP_SPLIT_TO_TABLE(
                             'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders'
                           , '\\W+' ) )
             WHERE TOKEN IS NOT NULL AND TOKEN <> ''
           ) QT
      JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS GV
           ON GV."word" = QT.TOKEN
      LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES WF
           ON WF."word" = QT.TOKEN
      LEFT JOIN STOPWORDS SW ON SW.WORD = QT.TOKEN
      WHERE SW.WORD IS NULL        -- remove stop‑words
     ),
     /* helper to fold the array of arrays to one single vector */
     LATERAL (
       SELECT
         /* start with a zero‑vector (empty array), then add each */
         ARRAY_REDUCE( VEC_ARRAY
                      , ADD_VECTOR
                      , ARRAY_CONSTRUCT() ) AS SUM_VEC )
),


/*---------------------------------------------------------------------
  STEP‑3 :  build every ARTICLE’s unit vector
 --------------------------------------------------------------------*/
ARTICLE_VECS AS (
SELECT
        N."id",
        N."date",
        N."title",
        DIV_VECTOR( SUM_VEC , NORM_VECTOR(SUM_VEC) )  AS UNIT_VEC
FROM (
      SELECT
             N."id",
             N."date",
             N."title",
             ARRAY_AGG(
                 SCALE_VECTOR( GV."vector"
                             , 1/POWER( COALESCE(WF."frequency",1) , 0.4) )
                 )         AS VEC_ARRAY
      FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE N
      ,    LATERAL FLATTEN( INPUT =>
                            REGEXP_SPLIT_TO_ARRAY( LOWER(N."body") , '\\W+' )
                          ) T
           /* word/token = T.VALUE::STRING */
      JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS GV
           ON GV."word" = T.VALUE::STRING
      LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES WF
           ON WF."word" = T.VALUE::STRING
      LEFT JOIN STOPWORDS SW
           ON SW.WORD = T.VALUE::STRING
      WHERE T.VALUE IS NOT NULL
        AND SW.WORD IS NULL        -- remove stop‑words
      GROUP BY N."id", N."date", N."title"
     )
     , LATERAL (
         SELECT ARRAY_REDUCE( VEC_ARRAY , ADD_VECTOR , ARRAY_CONSTRUCT() )
                AS SUM_VEC )
)

/*---------------------------------------------------------------------
  STEP‑4 :  final ranking  –  cosine similarity
 --------------------------------------------------------------------*/
SELECT
       A."id",
       A."date",
       A."title",
       COSINE_SIM( A.UNIT_VEC , Q.UNIT_VEC ) AS COSINE_SIMILARITY
FROM   ARTICLE_VECS  A
JOIN   QUERY_VEC     Q
ON     TRUE
ORDER  BY COSINE_SIMILARITY DESC NULLS LAST , A."id"
LIMIT  10
;
```
