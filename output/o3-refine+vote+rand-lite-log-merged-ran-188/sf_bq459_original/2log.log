ARTICLE_TOKENS_CLEAN AS (
  SELECT *
  FROM ARTICLE_TOKENS
  WHERE TOKEN <> ''
    AND TOKEN NOT IN (SELECT WORD FROM STOPWORDS)
),

/*-----------------  weighted‑sum vectors for every article  --------------*/
ARTICLE_VECS AS (
  SELECT
      ATC."id",
      ATC."date",
      ATC."title",
      ARRAY_REDUCE(
          ARRAY_AGG(
              SCALE_VECTOR( GV."vector",
                            1/POWER( COALESCE(WF."frequency",1) , 0.4) )
          ),
          ADD_VECTOR,
          ARRAY_CONSTRUCT()
      ) AS SUM_VEC
  FROM ARTICLE_TOKENS_CLEAN ATC
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS GV
       ON GV."word" = ATC.TOKEN
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES WF
       ON WF."word" = ATC.TOKEN
  GROUP BY ATC."id", ATC."date", ATC."title"
),

ARTICLE_UNIT AS (
  SELECT
      "id",
      "date",
      "title",
      DIV_VECTOR(SUM_VEC, NORM_VECTOR(SUM_VEC)) AS UNIT_VEC
  FROM ARTICLE_VECS
)

/*-----------------  similarity & top‑10  ---------------------------------*/
SELECT
    A."id",
    A."date",
    A."title",
    COSINE_SIM(A.UNIT_VEC , Q.UNIT_VEC) AS COSINE_SIMILARITY
FROM ARTICLE_UNIT A
CROSS JOIN QUERY_VEC Q
ORDER BY COSINE_SIMILARITY DESC NULLS LAST, A."id"
LIMIT 10;
