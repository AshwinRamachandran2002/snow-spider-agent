/*──────────────────────  TOP‑10 SIMILAR NATURE ARTICLES  ─────────────────────*/
WITH
/*------------------------------------------------------------------*
 |  1. stop‑word list                                               |
 *------------------------------------------------------------------*/
STOPWORDS(WORD) AS (
  SELECT column1
  FROM VALUES
   ('a'),('an'),('and'),('are'),('as'),('at'),('be'),('but'),('by'),
   ('for'),('from'),('has'),('have'),('in'),('is'),('it'),('its'),
   ('of'),('on'),('or'),('that'),('the'),('to'),('was'),('were'),
   ('will'),('with')
),

/*------------------------------------------------------------------*
 |  2. QUERY tokens (use REGEXP_REPLACE + SPLIT + FLATTEN)          |
 *------------------------------------------------------------------*/
QUERY_TOKENS AS (
  SELECT LOWER(value::string) AS TOKEN
  FROM TABLE(
         FLATTEN(
           INPUT =>
             SPLIT(
               REGEXP_REPLACE(
                 'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                 '\\W+',            -- replace all non‑word chars
                 ' '
               ),
               ' '                 -- split on single space
             )
         )
       )
  WHERE TOKEN <> ''
    AND TOKEN NOT IN (SELECT WORD FROM STOPWORDS)
),

/*------------------------------------------------------------------*
 |  3.  QUERY vector components  (index , weighted component)       |
 *------------------------------------------------------------------*/
QUERY_COMPONENTS AS (
  SELECT
      f.index                              AS IDX,
      SUM( f.value::float *
           ( 1 / POWER( COALESCE(wf."frequency",1) , 0.4) )
         )                                AS COMP
  FROM QUERY_TOKENS qt
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
       ON gv."word" = qt.TOKEN
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
       ON wf."word" = qt.TOKEN
  ,    LATERAL FLATTEN( INPUT => gv."vector" ) f
  GROUP BY f.index
),

/*------------------------------------------------------------------*
 |  4.  QUERY‑vector norm                                           |
 *------------------------------------------------------------------*/
QUERY_NORM AS (
  SELECT SQRT( SUM( COMP*COMP ) ) AS NORM
  FROM QUERY_COMPONENTS
),

/*------------------------------------------------------------------*
 |  5.  ARTICLE tokens                                              |
 *------------------------------------------------------------------*/
ARTICLE_TOKENS AS (
  SELECT
      n."id",
      n."date",
      n."title",
      LOWER(f.value::string)        AS TOKEN
  FROM WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n,
       LATERAL FLATTEN(
         INPUT =>
           SPLIT(
             REGEXP_REPLACE( LOWER(n."body"), '\\W+', ' ' ),
             ' '
           )
       ) f
  WHERE f.value IS NOT NULL
),

ARTICLE_TOKENS_CLEAN AS (
  SELECT *
  FROM ARTICLE_TOKENS
  WHERE TOKEN <> ''
    AND TOKEN NOT IN (SELECT WORD FROM STOPWORDS)
),

/*------------------------------------------------------------------*
 |  6.  ARTICLE vector components                                   |
 *------------------------------------------------------------------*/
ARTICLE_COMPONENTS AS (
  SELECT
      atc."id",
      atc."date",
      atc."title",
      f.index                                             AS IDX,
      SUM( f.value::float *
           ( 1 / POWER( COALESCE(wf."frequency",1) , 0.4) )
         )                                               AS COMP
  FROM ARTICLE_TOKENS_CLEAN atc
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
       ON gv."word" = atc.TOKEN
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
       ON wf."word" = atc.TOKEN
  ,    LATERAL FLATTEN( INPUT => gv."vector" ) f
  GROUP BY atc."id", atc."date", atc."title", f.index
),

/*------------------------------------------------------------------*
 |  7.  ARTICLE vector norms                                        |
 *------------------------------------------------------------------*/
ARTICLE_NORMS AS (
  SELECT
      "id",
      "date",
      "title",
      SQRT( SUM( COMP*COMP ) ) AS NORM
  FROM ARTICLE_COMPONENTS
  GROUP BY "id","date","title"
),

/*------------------------------------------------------------------*
 |  8.  DOT products (article • query)                              |
 *------------------------------------------------------------------*/
DOTS AS (
  SELECT
      ac."id",
      SUM( ac.COMP * qc.COMP ) AS DOT
  FROM ARTICLE_COMPONENTS ac
  JOIN QUERY_COMPONENTS  qc
        ON ac.IDX = qc.IDX
  GROUP BY ac."id"
