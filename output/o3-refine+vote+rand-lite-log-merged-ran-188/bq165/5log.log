Query:
--Description: 5)  Map converted segments to cytogenetic bands (hg38);  
--                 show how the coordinates overlap a band.  
SELECT  ccv.`RefNo`,
        ccv.`CaseNo`,
        ccv.`Chr`,
        ccv.`Start`,
        ccv.`End`,
        cb.`cytoband_name`,
        cb.`hg38_start`,
        cb.`hg38_stop`,
        ccv.`Type`
FROM    `mitelman-db.prod.CytoConverted` AS ccv
JOIN    `mitelman-db.prod.Cytogen`       AS cg 
  ON    ccv.`RefNo`  = cg.`RefNo`
 AND    ccv.`CaseNo` = cg.`CaseNo`
JOIN    `mitelman-db.prod.CytoBands_hg38` AS cb
  ON    ccv.`Chr` = cb.`chromosome`
WHERE   (ccv.`Start` < cb.`hg38_stop`)      -- interval overlap
  AND   (ccv.`End`   > cb.`hg38_start`)
  AND  (cg.`Morph` = '3111' OR cg.`Topo` = '0401')
LIMIT 20;
