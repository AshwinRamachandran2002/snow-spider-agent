```sql
--Description / Thinking process:
-- We want to count SINGLE-COPY GAINS for breast-cancer (Morph = 3111) and
-- adenocarcinoma (Topo = 0401) cases, per cytogenetic band.  
-- The steps carried out in this one query are:
--  1.  Identify the cohort: rows in Cytogen whose Morph is 3111 OR Topo is 0401.
--  2.  Join the CytoConverted table to get genomic segments for those cases.
--  3.  Join to CytoBands_hg38 to assign every segment to one or more bands
--      (interval-overlap condition Start < band_end  AND  End > band_start).
--  4.  Restrict to segments annotated as “Gain” (i.e. +1 copy).
--  5.  GROUP BY chromosome, band name, and hg38_start so that we can also
--      ORDER BY hg38_start (physical position) without violating SQL rules.
--  6.  Return the count of Gain segments (could later be divided by #cases to
--      obtain a frequency).
--  7.  LIMIT 20 just to sample a few rows.
SELECT
  cb.chromosome,
  cb.cytoband_name,
  cb.hg38_start,                      -- included for ordering
  COUNT(*) AS gain_segments
FROM  `mitelman-db.prod.CytoConverted`  AS ccv
JOIN  `mitelman-db.prod.Cytogen`        AS cg
      ON  ccv.RefNo  = cg.RefNo
     AND ccv.CaseNo = cg.CaseNo
JOIN  `mitelman-db.prod.CytoBands_hg38` AS cb
      ON  ccv.Chr   = cb.chromosome
     AND ccv.Start  < cb.hg38_stop      -- overlap condition
     AND ccv.End    > cb.hg38_start
WHERE (cg.Morph = '3111' OR cg.Topo = '0401')   -- cohort filter
  AND ccv.Type   = 'Gain'                        -- single-copy gain
GROUP BY
  cb.chromosome,
  cb.cytoband_name,
  cb.hg38_start
ORDER BY
  cb.chromosome,
  cb.hg38_start
LIMIT 20;
```
