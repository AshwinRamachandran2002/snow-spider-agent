--Description: 7) Count single-copy “Gain” segments per cytoband
--              (breast cancer Morph = 3111 OR adenocarcinoma Topo = 0401).
--              Add hg38_start to SELECT / GROUP BY so it can appear in ORDER BY.
SELECT
  cb.chromosome,
  cb.cytoband_name,
  cb.hg38_start,                       -- needed for ORDER BY
  COUNT(*) AS gains
FROM  `mitelman-db.prod.CytoConverted`   AS ccv
JOIN  `mitelman-db.prod.Cytogen`         AS cg
      ON  ccv.RefNo  = cg.RefNo
     AND ccv.CaseNo = cg.CaseNo
JOIN  `mitelman-db.prod.CytoBands_hg38`  AS cb
      ON  ccv.Chr   = cb.chromosome
     AND ccv.Start  < cb.hg38_stop       -- interval overlap
     AND ccv.End    > cb.hg38_start
WHERE (cg.Morph = '3111' OR cg.Topo = '0401')
  AND ccv.Type = 'Gain'
GROUP BY
  cb.chromosome,
  cb.cytoband_name,
  cb.hg38_start
ORDER BY
  cb.chromosome,
  cb.hg38_start
LIMIT 20
