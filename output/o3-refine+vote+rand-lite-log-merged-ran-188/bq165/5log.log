```sql
--Description: 10) All-in-one: counts & frequencies of Amplification, Gain, Loss,
--                Homozygous deletion per cytoband, sorted by chromosome order
--                and genomic start coordinate.
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111' OR Topo = '0401'
),
events AS (
  SELECT
    ccv.RefNo,
    ccv.CaseNo,
    cb.chromosome,
    cb.cytoband_name,
    cb.hg38_start,
    ccv.Type
  FROM   `mitelman-db.prod.CytoConverted`  AS ccv
  JOIN   cohort                            AS co  USING (RefNo, CaseNo)
  JOIN   `mitelman-db.prod.CytoBands_hg38` AS cb
         ON ccv.Chr   = cb.chromosome
        AND ccv.Start < cb.hg38_stop
        AND ccv.End   > cb.hg38_start
),
band_totals AS (
  SELECT
    chromosome,
    cytoband_name,
    hg38_start,
    COUNT(DISTINCT CONCAT(RefNo, '-', CaseNo)) AS n_cases
  FROM   events
  GROUP BY chromosome, cytoband_name, hg38_start
),
band_counts AS (
  SELECT
    chromosome,
    cytoband_name,
    hg38_start,
    SUM(CASE WHEN Type = 'Amplification'       THEN 1 ELSE 0 END) AS amp_cnt,
    SUM(CASE WHEN Type = 'Gain'                THEN 1 ELSE 0 END) AS gain_cnt,
    SUM(CASE WHEN Type = 'Loss'                THEN 1 ELSE 0 END) AS loss_cnt,
    SUM(CASE WHEN Type = 'Homozygous deletion' THEN 1 ELSE 0 END) AS homdel_cnt
  FROM   events
  GROUP BY chromosome, cytoband_name, hg38_start
)
SELECT
  bc.chromosome,
  bc.cytoband_name,
  bc.hg38_start,
  amp_cnt,
  gain_cnt,
  loss_cnt,
  homdel_cnt,
  ROUND(100 * amp_cnt    / bt.n_cases, 2) AS amp_pct,
  ROUND(100 * gain_cnt   / bt.n_cases, 2) AS gain_pct,
  ROUND(100 * loss_cnt   / bt.n_cases, 2) AS loss_pct,
  ROUND(100 * homdel_cnt / bt.n_cases, 2) AS homdel_pct
FROM   band_counts AS bc
JOIN   band_totals AS bt
       ON  bc.chromosome   = bt.chromosome
       AND bc.cytoband_name = bt.cytoband_name
       AND bc.hg38_start    = bt.hg38_start
ORDER BY
  -- numeric order of chromosome (chr1-22, chrX=23, chrY=24)
  CASE
    WHEN bc.chromosome = 'chrX' THEN 23
    WHEN bc.chromosome = 'chrY' THEN 24
    ELSE CAST(REGEXP_REPLACE(bc.chromosome, r'chr', '') AS INT64)
  END,
  bc.hg38_start;
