FROM    `mitelman-db.prod.CytoConverted` AS ccv
JOIN    `mitelman-db.prod.Cytogen`       AS cg 
  ON    ccv.`RefNo`  = cg.`RefNo`
 AND    ccv.`CaseNo` = cg.`CaseNo`
JOIN    `mitelman-db.prod.CytoBands_hg38` AS cb
  ON    ccv.`Chr` = cb.`chromosome`
WHERE   (ccv.`Start` < cb.`hg38_stop`)
  AND   (ccv.`End`   > cb.`hg38_start`)
  AND  (cg.`Morph` = '3111' OR cg.`Topo` = '0401')
  AND   ccv.`Type` = 'Gain'
GROUP  BY cb.`chromosome`, cb.`cytoband_name`
ORDER  BY cb.`chromosome`, cb.`hg38_start`
LIMIT 20;
```

```sql
