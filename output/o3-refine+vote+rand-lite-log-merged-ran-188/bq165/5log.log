```sql
--Description: 9)  Count homozygous deletions (assuming the CytoConverter flag “HomozygousDeletion”).  
SELECT  cb.`chromosome`,
        cb.`cytoband_name`,
        COUNT(*) AS homdel
FROM    `mitelman-db.prod.CytoConverted` AS ccv
JOIN    `mitelman-db.prod.Cytogen`       AS cg 
  ON    ccv.`RefNo`  = cg.`RefNo`
 AND    ccv.`CaseNo` = cg.`CaseNo`
JOIN    `mitelman-db.prod.CytoBands_hg38` AS cb
  ON    ccv.`Chr` = cb.`chromosome`
WHERE   (ccv.`Start` < cb.`hg38_stop`)
  AND   (ccv.`End`   > cb.`hg38_start`)
  AND  (cg.`Morph` = '3111' OR cg.`Topo` = '0401')
  AND   ccv.`Type` = 'Homozygous deletion'
GROUP  BY cb.`chromosome`, cb.`cytoband_name`
ORDER  BY cb.`chromosome`, cb.`hg38_start`
LIMIT 20;
```

```sql
--Description: 10)  Single all-in-one query:  
--                  for every band, output number of samples with each event type  
--                  and the corresponding frequencies (%) in the cohort.  
WITH cohort AS (
  SELECT DISTINCT `RefNo`, `CaseNo`
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  `Morph` = '3111' OR `Topo` = '0401'
), events AS (
  SELECT  ccv.`RefNo`,
          ccv.`CaseNo`,
          cb.`chromosome`,
          cb.`cytoband_name`,
          ccv.`Type`
  FROM    `mitelman-db.prod.CytoConverted` AS ccv
  JOIN    cohort                           AS co  USING (`RefNo`,`CaseNo`)
  JOIN    `mitelman-db.prod.CytoBands_hg38` AS cb
         ON ccv.`Chr` = cb.`chromosome`
        AND ccv.`Start` < cb.`hg38_stop`
        AND ccv.`End`   > cb.`hg38_start`
), band_totals AS (
  SELECT  `chromosome`,
          `cytoband_name`,
          COUNT(DISTINCT CONCAT(`RefNo`,'-',`CaseNo`)) AS n_cases
  FROM    events
  GROUP  BY 1,2
), band_counts AS (
  SELECT  `chromosome`,
          `cytoband_name`,
          SUM(CASE WHEN `Type` = 'Amplification'        THEN 1 ELSE 0 END) AS amp_cnt,
          SUM(CASE WHEN `Type` = 'Gain'                 THEN 1 ELSE 0 END) AS gain_cnt,
          SUM(CASE WHEN `Type` = 'Loss'                 THEN 1 ELSE 0 END) AS loss_cnt,
          SUM(CASE WHEN `Type` = 'Homozygous deletion'  THEN 1 ELSE 0 END) AS homdel_cnt
  FROM    events
  GROUP  BY 1,2
)
SELECT  bc.`chromosome`,
        bc.`cytoband_name`,
        amp_cnt,
        gain_cnt,
        loss_cnt,
        homdel_cnt,
        ROUND(100 * amp_cnt    / bt.n_cases , 2) AS amp_pct,
        ROUND(100 * gain_cnt   / bt.n_cases , 2) AS gain_pct,
        ROUND(100 * loss_cnt   / bt.n_cases , 2) AS loss_pct,
        ROUND(100 * homdel_cnt / bt.n_cases , 2) AS homdel_pct
FROM    band_counts bc
JOIN    band_totals bt
  ON    bc.`chromosome`   = bt.`chromosome`
 AND    bc.`cytoband_name`= bt.`cytoband_name`
ORDER  BY CAST(REGEXP_REPLACE(bc.`chromosome`,'chr','') AS INT64), 
          bt.`chromosome`,
          bc.`cytoband_name`;
```
