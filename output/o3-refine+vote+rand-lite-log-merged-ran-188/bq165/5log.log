Query:
--Description: 10) All-in-one summary for the breast-cancer (Morph = 3111) and
--              adenocarcinoma (Topo = 0401) cohort: for every cytogenetic band
--              report the number of Gain (+1 copy) and Loss (–1 copy) segments
--              actually observed, plus placeholders for Amplification (>1 copy)
--              and Homozygous-deletion (–2 copies) which may be zero because
--              those “Type” labels are not present in CytoConverted.  Frequencies
--              are given as % of the cases that have *any* segment overlapping
--              the band.  hg38_start is included in SELECT / GROUP BY so that
--              it can be used safely in ORDER BY.
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111' OR Topo = '0401'
),
events AS (
  SELECT
    ccv.RefNo,
    ccv.CaseNo,
    cb.chromosome,
    cb.cytoband_name,
    cb.hg38_start,
    ccv.Type
  FROM   `mitelman-db.prod.CytoConverted`  AS ccv
  JOIN   cohort                            AS co  USING (RefNo, CaseNo)
  JOIN   `mitelman-db.prod.CytoBands_hg38` AS cb
         ON ccv.Chr   = cb.chromosome
        AND ccv.Start < cb.hg38_stop
        AND ccv.End   > cb.hg38_start
),
band_totals AS (
  SELECT
    chromosome,
    cytoband_name,
    hg38_start,
    COUNT(DISTINCT CONCAT(RefNo,'-',CaseNo)) AS n_cases
  FROM   events
  GROUP  BY chromosome, cytoband_name, hg38_start
),
band_counts AS (
  SELECT
    chromosome,
    cytoband_name,
    hg38_start,
    SUM(CASE WHEN Type = 'Amplification'       THEN 1 ELSE 0 END) AS amp_cnt,
    SUM(CASE WHEN Type = 'Gain'                THEN 1 ELSE 0 END) AS gain_cnt,
    SUM(CASE WHEN Type = 'Loss'                THEN 1 ELSE 0 END) AS loss_cnt,
    SUM(CASE WHEN Type = 'Homozygous deletion' THEN 1 ELSE 0 END) AS homdel_cnt
  FROM   events
  GROUP  BY chromosome, cytoband_name, hg38_start
)
SELECT
  bc.chromosome,
  bc.cytoband_name,
  bc.hg38_start,
  amp_cnt,
  gain_cnt,
  loss_cnt,
  homdel_cnt,
  ROUND(100 * SAFE_DIVIDE(amp_cnt , bt.n_cases), 2) AS amp_pct,
  ROUND(100 * SAFE_DIVIDE(gain_cnt, bt.n_cases), 2) AS gain_pct,
  ROUND(100 * SAFE_DIVIDE(loss_cnt, bt.n_cases), 2) AS loss_pct,
  ROUND(100 * SAFE_DIVIDE(homdel_cnt, bt.n_cases), 2) AS homdel_pct
FROM   band_counts AS bc
JOIN   band_totals AS bt
       ON  bc.chromosome    = bt.chromosome
       AND bc.cytoband_name = bt.cytoband_name
       AND bc.hg38_start    = bt.hg38_start
ORDER BY
  CASE
    WHEN bc.chromosome = 'chrX' THEN 23
    WHEN bc.chromosome = 'chrY' THEN 24
    ELSE CAST(REGEXP_REPLACE(bc.chromosome, r'^chr', '') AS INT64)
  END,
  bc.hg38_start
Answer:
chromosome,cytoband_name,hg38_start,amp_cnt,gain_cnt,loss_cnt,homdel_cnt,amp_pct,gain_pct,loss_pct,homdel_pct
