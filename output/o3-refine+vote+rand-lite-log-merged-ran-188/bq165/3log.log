--Description: Aggregate the number of segments of each class that overlap each
--             cytoband in breast-cancer adenocarcinoma cases (Morph='3111',
--             Topo='0401'); show first 20 rows so we can inspect the result.
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111'
    AND Topo  = '0401'
),
segments AS (
  SELECT cc.RefNo,
         cc.CaseNo,
         cc.Type,
         cc.Chr,
         cc.Start,
         cc.End
  FROM `mitelman-db.prod.CytoConverted` AS cc
  JOIN cohort AS co
    ON cc.RefNo  = co.RefNo
   AND cc.CaseNo = co.CaseNo
),
band_hits AS (
  SELECT
    cb.chromosome,
    cb.cytoband_name,
    cb.hg38_start,
    cb.hg38_stop,
    s.Type,
    COUNT(DISTINCT CONCAT(s.RefNo, '_', s.CaseNo)) AS n_cases
  FROM segments AS s
  JOIN `mitelman-db.prod.CytoBands_hg38` AS cb
    ON s.Chr    = cb.chromosome
   AND s.Start  < cb.hg38_stop
   AND s.End    > cb.hg38_start
  GROUP BY
    cb.chromosome,
    cb.cytoband_name,
    cb.hg38_start,
    cb.hg38_stop,
    s.Type
)
SELECT *
FROM band_hits
LIMIT 20
