--Description: Build the final frequency table for every cytoband, showing
--             counts and percentages (2-decimals) of Amplification, Gain,
--             Loss, and Homozygous Deletion among breast-adenocarcinoma
--             samples; order by chromosome ordinal and band position.
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111'
    AND Topo  = '0401'
),
total AS (
  SELECT COUNT(*) AS total_samples
  FROM cohort
),
segments AS (
  SELECT cc.RefNo,
         cc.CaseNo,
         cc.Type,
         cc.Chr,
         cc.Start,
         cc.End
  FROM `mitelman-db.prod.CytoConverted` AS cc
  JOIN cohort AS co
    ON cc.RefNo  = co.RefNo
   AND cc.CaseNo = co.CaseNo
),
band_hits AS (
  SELECT
    cb.cytoband_name,
    cb.chromosome,
    cb.hg38_start,
    cb.hg38_stop,
    s.Type,
    COUNT(DISTINCT CONCAT(s.RefNo, '_', s.CaseNo)) AS n_cases
  FROM segments AS s
  JOIN `mitelman-db.prod.CytoBands_hg38` AS cb
    ON s.Chr    = cb.chromosome
   AND s.Start  < cb.hg38_stop
   AND s.End    > cb.hg38_start
  GROUP BY
    cb.cytoband_name,
    cb.chromosome,
    cb.hg38_start,
    cb.hg38_stop,
    s.Type
),
pivot AS (
  SELECT
    cytoband_name,
    chromosome,
    hg38_start,
    hg38_stop,
    SUM(CASE WHEN Type = 'Amplification' THEN n_cases ELSE 0 END) AS n_amp,
    SUM(CASE WHEN Type = 'Gain'          THEN n_cases ELSE 0 END) AS n_gain,
    SUM(CASE WHEN Type = 'Loss'          THEN n_cases ELSE 0 END) AS n_loss,
    SUM(CASE WHEN Type IN ('HomDel', 'HomLoss') THEN n_cases ELSE 0 END) AS n_homdel
  FROM band_hits
  GROUP BY
    cytoband_name,
    chromosome,
    hg38_start,
    hg38_stop
),
final AS (
  SELECT
    p.*,
    ROUND(100 * n_amp    / t.total_samples, 2) AS pct_amp,
    ROUND(100 * n_gain   / t.total_samples, 2) AS pct_gain,
    ROUND(100 * n_loss   / t.total_samples, 2) AS pct_loss,
    ROUND(100 * n_homdel / t.total_samples, 2) AS pct_homdel
  FROM pivot AS p
  CROSS JOIN total AS t
)
SELECT *
FROM final
ORDER BY
  CAST(REGEXP_REPLACE(chromosome, r'^chr', '') AS INT64),
  hg38_start,
  hg38_stop
