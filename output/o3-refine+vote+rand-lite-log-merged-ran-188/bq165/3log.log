```sql
--8) Description: Aggregate the number of segments of each category that
--   overlap each cytoband across the cohort (first 20 bands to inspect).
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111'
    AND  Topo  = '0401'
),
segments AS (
  SELECT cc.RefNo, cc.CaseNo, cc.Type,
         cc.Chr, cc.Start, cc.End
  FROM   `mitelman-db.prod.CytoConverted` AS cc
  JOIN   cohort USING (RefNo, CaseNo)
),
band_hits AS (
  SELECT cb.chromosome,
         cb.cytoband_name,
         cb.hg38_start,
         cb.hg38_stop,
         s.Type,
         COUNT(DISTINCT CONCAT(s.RefNo,'_',s.CaseNo)) AS n_cases
  FROM   segments AS s
  JOIN   `mitelman-db.prod.CytoBands_hg38` AS cb
    ON   s.Chr      = cb.chromosome
   AND   s.Start   < cb.hg38_stop
   AND   s.End     > cb.hg38_start
  GROUP BY chromosome, cytoband_name, hg38_start, hg38_stop, Type
)
SELECT *
FROM band_hits
LIMIT 20;
```

```sql
--9) Description: Produce the final requested table:
--   for every cytoband give counts / frequencies (Amplification, Gain,
--   Loss, HomDel) among the cohort.  Two-decimal percentages; ordered by
--   chromosome ordinal then band start.
WITH cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111'
    AND  Topo  = '0401'
),
total AS (
  SELECT COUNT(DISTINCT CONCAT(RefNo,'_',CaseNo)) AS total_samples
  FROM cohort
),
segments AS (
  SELECT cc.RefNo, cc.CaseNo, cc.Type,
         cc.Chr, cc.Start, cc.End
  FROM   `mitelman-db.prod.CytoConverted` AS cc
  JOIN   cohort USING (RefNo, CaseNo)
),
band_hits AS (
  SELECT cb.cytoband_name,
         cb.chromosome,
         cb.hg38_start,
         cb.hg38_stop,
         s.Type,
         COUNT(DISTINCT CONCAT(s.RefNo,'_',s.CaseNo)) AS n_cases
  FROM   segments AS s
  JOIN   `mitelman-db.prod.CytoBands_hg38` AS cb
    ON   s.Chr      = cb.chromosome
   AND   s.Start   < cb.hg38_stop
   AND   s.End     > cb.hg38_start
  GROUP BY cb.cytoband_name, cb.chromosome, cb.hg38_start, cb.hg38_stop, s.Type
),
pivot AS (
  SELECT cytoband_name,
         chromosome,
         hg38_start,
         hg38_stop,
         COALESCE(SUM(CASE WHEN Type = 'Amplification' THEN n_cases END),0) AS n_amp,
         COALESCE(SUM(CASE WHEN Type = 'Gain'          THEN n_cases END),0) AS n_gain,
         COALESCE(SUM(CASE WHEN Type = 'Loss'          THEN n_cases END),0) AS n_loss,
         COALESCE(SUM(CASE WHEN Type IN ('HomDel','HomLoss') THEN n_cases END),0) AS n_homdel
  FROM band_hits
  GROUP BY cytoband_name, chromosome, hg38_start, hg38_stop
),
final AS (
  SELECT p.*,
         ROUND(100 * n_amp    / t.total_samples, 2) AS pct_amp,
         ROUND(100 * n_gain   / t.total_samples, 2) AS pct_gain,
         ROUND(100 * n_loss   / t.total_samples, 2) AS pct_loss,
         ROUND(100 * n_homdel / t.total_samples, 2) AS pct_homdel
  FROM   pivot AS p
  CROSS JOIN total AS t
)
SELECT *
FROM   final
ORDER BY CAST(REGEXP_REPLACE(chromosome, r'chr', '') AS INT64),
         hg38_start,
         hg38_stop
LIMIT 20;
```

The nine progressively more complex queries above demonstrate how one could investigate and finally obtain the requested frequency table of amplifications, gains, losses, and homozygous deletions for every cytoband in breast-adenocarcinoma cases, ordered by chromosome and base-pair position.
