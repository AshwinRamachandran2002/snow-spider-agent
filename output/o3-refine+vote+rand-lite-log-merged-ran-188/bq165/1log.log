Query:
-- 9.  Aggregate raw counts of each event-class per cytoband for the cohort
SELECT
       cb.chromosome,
       cb.cytoband_name,
       COUNTIF(cc.Type = 'Amplification')        AS n_amp,
       COUNTIF(cc.Type = 'Gain')                 AS n_gain,
       COUNTIF(cc.Type = 'Loss')                 AS n_loss,
       COUNTIF(cc.Type = 'HomozygousDeletion')   AS n_homdel
FROM   `mitelman-db.prod.CytoConverted` AS cc
JOIN   (
        SELECT DISTINCT `RefNo`, `CaseNo`
        FROM `mitelman-db.prod.Cytogen`
        WHERE `Morph` = '3111' OR `Topo` = '0401'
       ) AS cohort
  ON  cohort.RefNo  = cc.RefNo
 AND cohort.CaseNo = cc.CaseNo
JOIN   `mitelman-db.prod.CytoBands_hg38` AS cb
  ON  cb.chromosome = cc.Chr
 AND cc.Start < cb.hg38_stop
 AND cc.End   > cb.hg38_start
GROUP BY cb.chromosome, cb.cytoband_name
ORDER BY cb.chromosome, MIN(cb.hg38_start)
LIMIT 20;
