```sql
-- 7.  Copy-number segments from the breast/adenocarc cohort
SELECT c.*
FROM   `mitelman-db.prod.CytoConverted` AS c
JOIN   (
        SELECT DISTINCT `RefNo`, `CaseNo`
        FROM `mitelman-db.prod.Cytogen`
        WHERE `Morph` = '3111'
           OR `Topo`  = '0401'
       ) AS cohort
  ON  cohort.RefNo  = c.RefNo
 AND cohort.CaseNo = c.CaseNo
LIMIT 20;
```

```sql
-- 8.  Map those segments to cytobands (show how the overlap is done)
SELECT cc.RefNo,
       cc.CaseNo,
       cc.Chr,
       cb.cytoband_name,
       cb.hg38_start,
       cb.hg38_stop,
       cc.Start,
       cc.End,
       cc.Type
FROM   `mitelman-db.prod.CytoConverted`  AS cc
JOIN   (
        SELECT DISTINCT `RefNo`, `CaseNo`
        FROM `mitelman-db.prod.Cytogen`
        WHERE `Morph` = '3111' OR `Topo` = '0401'
       ) AS cohort
  ON  cohort.RefNo  = cc.RefNo
 AND cohort.CaseNo = cc.CaseNo
JOIN   `mitelman-db.prod.CytoBands_hg38` AS cb
  ON  cb.chromosome = cc.Chr
 AND cc.Start < cb.hg38_stop
 AND cc.End   > cb.hg38_start
LIMIT 20;
```

```sql
-- 9.  Aggregate raw counts of each event-class per cytoband for the cohort
SELECT
       cb.chromosome,
       cb.cytoband_name,
       COUNTIF(cc.Type = 'Amplification')        AS n_amp,
       COUNTIF(cc.Type = 'Gain')                 AS n_gain,
       COUNTIF(cc.Type = 'Loss')                 AS n_loss,
       COUNTIF(cc.Type = 'HomozygousDeletion')   AS n_homdel
FROM   `mitelman-db.prod.CytoConverted` AS cc
JOIN   (
        SELECT DISTINCT `RefNo`, `CaseNo`
        FROM `mitelman-db.prod.Cytogen`
        WHERE `Morph` = '3111' OR `Topo` = '0401'
       ) AS cohort
  ON  cohort.RefNo  = cc.RefNo
 AND cohort.CaseNo = cc.CaseNo
JOIN   `mitelman-db.prod.CytoBands_hg38` AS cb
  ON  cb.chromosome = cc.Chr
 AND cc.Start < cb.hg38_stop
 AND cc.End   > cb.hg38_start
GROUP BY cb.chromosome, cb.cytoband_name
ORDER BY cb.chromosome, MIN(cb.hg38_start)
LIMIT 20;
```

```sql
-- 10.  Final result – counts and cohort-wide frequencies (rounded to 2 decimals) per cytoband
WITH cohort_cases AS (
    SELECT DISTINCT RefNo, CaseNo
    FROM   `mitelman-db.prod.Cytogen`
    WHERE  Morph = '3111'          -- breast cancer
       OR  Topo  = '0401'          -- adenocarcinoma
),
band_events AS (
    SELECT
        cb.chromosome,
        cb.cytoband_name,
        cb.hg38_start,
        cb.hg38_stop,
        cc.Type
    FROM   `mitelman-db.prod.CytoConverted` AS cc
    JOIN   cohort_cases                       AS co  USING (RefNo, CaseNo)
    JOIN   `mitelman-db.prod.CytoBands_hg38`  AS cb
      ON  cb.chromosome = cc.Chr
     AND cc.Start < cb.hg38_stop
     AND cc.End   > cb.hg38_start
)
SELECT
    chromosome                                                             AS Chr,
    cytoband_name                                                          AS Band,
    COUNTIF(Type = 'Amplification')                          AS n_amp,
    COUNTIF(Type = 'Gain')                                 AS n_gain,
    COUNTIF(Type = 'Loss')                                 AS n_loss,
    COUNTIF(Type = 'HomozygousDeletion')                   AS n_homdel,
    ROUND(100 * COUNTIF(Type = 'Amplification')      / COUNT(*) , 2) || '%' AS freq_amp,
    ROUND(100 * COUNTIF(Type = 'Gain')               / COUNT(*) , 2) || '%' AS freq_gain,
    ROUND(100 * COUNTIF(Type = 'Loss')               / COUNT(*) , 2) || '%' AS freq_loss,
    ROUND(100 * COUNTIF(Type = 'HomozygousDeletion') / COUNT(*) , 2) || '%' AS freq_homdel
FROM   band_events
GROUP BY chromosome, cytoband_name, hg38_start, hg38_stop
ORDER BY
        CAST(REGEXP_EXTRACT(chromosome, r'chr(\d+|X|Y)') AS STRING),
        hg38_start,
        hg38_stop
LIMIT 20;
```

