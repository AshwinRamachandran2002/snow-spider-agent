Query:
-- 9. Final answer: committee id (used as “name” here),
--    # of candidates it supported, alphabetical list of those candidates,
--    and its total small-dollar haul (>$0 & ≤$200)
SELECT
  sm.cmte_id                          AS committee_name,          -- id used for name
  ARRAY_LENGTH(cands.candidate_names) AS num_unique_candidates,
  ARRAY_TO_STRING(cands.candidate_names, ', ') AS candidate_names_alphabetical,
  sm.total_small_amt                  AS total_small_donations
FROM (
  SELECT
    cmte_id,
    SUM(transaction_amt) AS total_small_amt
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE transaction_amt > 0
    AND transaction_amt <= 200
  GROUP BY cmte_id
  HAVING total_small_amt > 0
     AND total_small_amt <= 200
) AS sm
JOIN (
  SELECT
    cmte_id,
    ARRAY_AGG(DISTINCT name ORDER BY name) AS candidate_names
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  GROUP BY cmte_id
) AS cands
ON sm.cmte_id = cands.cmte_id
LIMIT 20;
