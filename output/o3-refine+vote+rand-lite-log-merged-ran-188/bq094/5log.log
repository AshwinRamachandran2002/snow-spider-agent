```sql
-- 1. Preview the 2016 individual–to–committee contribution file
SELECT
  cmte_id,
  name,              -- contributor name (not committee name)
  transaction_amt
FROM `bigquery-public-data.fec.individuals_2016`
LIMIT 20;
```

```sql
-- 2. Preview the 2016 committee-to-candidate contribution file
SELECT
  cmte_id,           -- donating committee
  cand_id,           -- supported candidate
  name,              -- candidate (committee) name
  transaction_amt
FROM `bigquery-public-data.fec.committee_contributions_2016`
LIMIT 20;
```

```sql
-- 3. How many small-dollar (>$0 and ≤$200) individual contributions are there?
SELECT
  COUNT(*) AS small_txn_cnt
FROM `bigquery-public-data.fec.individuals_2016`
WHERE transaction_amt > 0
  AND transaction_amt <= 200;
```

```sql
-- 4. Total small-dollar amount each committee received
SELECT
  cmte_id,
  SUM(transaction_amt) AS total_small_amt
FROM `bigquery-public-data.fec.individuals_2016`
WHERE transaction_amt > 0
  AND transaction_amt <= 200
GROUP BY cmte_id
HAVING total_small_amt > 0
LIMIT 20;
```

```sql
-- 5. Committees whose summed small-dollar haul is >$0 and ≤$200
SELECT
  cmte_id,
  SUM(transaction_amt) AS total_small_amt
FROM `bigquery-public-data.fec.individuals_2016`
WHERE transaction_amt > 0
  AND transaction_amt <= 200
GROUP BY cmte_id
HAVING total_small_amt > 0
   AND total_small_amt <= 200
LIMIT 20;
```

```sql
-- 6. Committees that supported at least one candidate in 2016
SELECT
  cmte_id,
  COUNT(DISTINCT cand_id) AS num_supported_candidates
FROM `bigquery-public-data.fec.committee_contributions_2016`
GROUP BY cmte_id
HAVING num_supported_candidates > 0
LIMIT 20;
```

```sql
-- 7. Alphabetical list of distinct candidate names each committee supported
SELECT
  cmte_id,
  ARRAY_TO_STRING(ARRAY_AGG(DISTINCT name ORDER BY name), ', ') AS candidate_names
FROM `bigquery-public-data.fec.committee_contributions_2016`
GROUP BY cmte_id
LIMIT 20;
```

```sql
-- 8. Committees that BOTH (a) took in >$0 & ≤$200 total in small-dollar gifts
--    and (b) backed ≥1 candidate
SELECT
  small.cmte_id,
  small.total_small_amt,
  supp.num_supported_candidates
FROM (
  SELECT cmte_id,
         SUM(transaction_amt) AS total_small_amt
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE transaction_amt > 0
    AND transaction_amt <= 200
  GROUP BY cmte_id
  HAVING total_small_amt > 0
     AND total_small_amt <= 200
) AS small
JOIN (
  SELECT cmte_id,
         COUNT(DISTINCT cand_id) AS num_supported_candidates
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  GROUP BY cmte_id
  HAVING num_supported_candidates > 0
) AS supp
ON small.cmte_id = supp.cmte_id
LIMIT 20;
```

```sql
-- 9. Final answer: committee id (used as “name” here),
--    # of candidates it supported, alphabetical list of those candidates,
--    and its total small-dollar haul (>$0 & ≤$200)
SELECT
  sm.cmte_id                          AS committee_name,          -- id used for name
  ARRAY_LENGTH(cands.candidate_names) AS num_unique_candidates,
  ARRAY_TO_STRING(cands.candidate_names, ', ') AS candidate_names_alphabetical,
  sm.total_small_amt                  AS total_small_donations
FROM (
  SELECT
    cmte_id,
    SUM(transaction_amt) AS total_small_amt
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE transaction_amt > 0
    AND transaction_amt <= 200
  GROUP BY cmte_id
  HAVING total_small_amt > 0
     AND total_small_amt <= 200
) AS sm
JOIN (
  SELECT
    cmte_id,
    ARRAY_AGG(DISTINCT name ORDER BY name) AS candidate_names
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  GROUP BY cmte_id
) AS cands
ON sm.cmte_id = cands.cmte_id
LIMIT 20;
```

