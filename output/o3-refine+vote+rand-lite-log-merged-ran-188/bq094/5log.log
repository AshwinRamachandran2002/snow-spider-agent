Query:
-- 8. Committees that BOTH (a) took in >$0 & ≤$200 total in small-dollar gifts
--    and (b) backed ≥1 candidate
SELECT
  small.cmte_id,
  small.total_small_amt,
  supp.num_supported_candidates
FROM (
  SELECT cmte_id,
         SUM(transaction_amt) AS total_small_amt
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE transaction_amt > 0
    AND transaction_amt <= 200
  GROUP BY cmte_id
  HAVING total_small_amt > 0
     AND total_small_amt <= 200
) AS small
JOIN (
  SELECT cmte_id,
         COUNT(DISTINCT cand_id) AS num_supported_candidates
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  GROUP BY cmte_id
  HAVING num_supported_candidates > 0
) AS supp
ON small.cmte_id = supp.cmte_id
LIMIT 20;
