```sql
-- 1) Take a quick look at the candidate–support records for 2016
SELECT *
FROM `bigquery-public-data.fec.committee_contributions_2016`
LIMIT 20;
```

```sql
-- 2) Peek at the 2016 individual-contribution file we will mine for small-dollar gifts
SELECT *
FROM `bigquery-public-data.fec.individuals_2016`
LIMIT 20;
```

```sql
-- 3) Inspect only those individual contributions whose amount is >0 and <200 (“small-dollar” definition here)
SELECT cmte_id,
       name,
       transaction_amt
FROM `bigquery-public-data.fec.individuals_2016`
WHERE transaction_amt > 0
  AND transaction_amt < 200
  AND REGEXP_CONTAINS(cmte_id, r'^C\d{8}')      -- keep only well-formed committee IDs
LIMIT 20;
```

```sql
-- 4) Calculate, for every committee, the total of its qualifying small-dollar contributions
SELECT cmte_id,
       SUM(transaction_amt) AS small_dollar_total
FROM `bigquery-public-data.fec.individuals_2016`
WHERE transaction_amt > 0
  AND transaction_amt < 200
  AND REGEXP_CONTAINS(cmte_id, r'^C\d{8}')
GROUP BY cmte_id
HAVING small_dollar_total > 0
LIMIT 20;
```

```sql
-- 5) Check which candidates (their committees’ names) a single committee happened to support
SELECT cmte_id,
       name                                   AS candidate_cmte_name
FROM `bigquery-public-data.fec.committee_contributions_2016`
WHERE cmte_id = 'C00027342'                   -- sample ID from the earlier preview
GROUP BY cmte_id, candidate_cmte_name
LIMIT 20;
```

```sql
-- 6) Pull the distinct list of candidates each committee supported in 2016
SELECT cmte_id,
       ARRAY_AGG(DISTINCT name ORDER BY name) AS cand_names
FROM `bigquery-public-data.fec.committee_contributions_2016`
GROUP BY cmte_id
LIMIT 20;
```

```sql
-- 7) Join small-dollar donors with candidate-support data to see which committees qualify on both counts
WITH small AS (
  SELECT cmte_id,
         SUM(transaction_amt) AS small_dollar_total
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE transaction_amt > 0
    AND transaction_amt < 200
    AND REGEXP_CONTAINS(cmte_id, r'^C\d{8}')
  GROUP BY cmte_id
  HAVING small_dollar_total > 0
),
cand AS (
  SELECT cmte_id,
         ARRAY_AGG(DISTINCT name ORDER BY name) AS cand_names
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  GROUP BY cmte_id
)
SELECT s.cmte_id,
       s.small_dollar_total,
       ARRAY_LENGTH(c.cand_names) AS num_cands,
       c.cand_names
FROM small AS s
JOIN cand  AS c
ON  s.cmte_id = c.cmte_id
LIMIT 20;
```

```sql
-- 8) Verify that every committee in the joined set really has at least one supported candidate
SELECT DISTINCT cmte_id
FROM `bigquery-public-data.fec.committee_contributions_2016`
WHERE cmte_id IN (
      SELECT cmte_id
      FROM `bigquery-public-data.fec.individuals_2016`
      WHERE transaction_amt > 0 AND transaction_amt < 200
)
LIMIT 20;
```

```sql
-- 9) Order the still-provisional answer by total small-dollar receipts (largest first)
WITH small AS (
  SELECT cmte_id,
         SUM(transaction_amt) AS small_dollar_total
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE transaction_amt > 0
    AND transaction_amt < 200
    AND REGEXP_CONTAINS(cmte_id, r'^C\d{8}')
  GROUP BY cmte_id
  HAVING small_dollar_total > 0
),
cand AS (
  SELECT cmte_id,
         ARRAY_AGG(DISTINCT name ORDER BY name) AS cand_names
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  GROUP BY cmte_id
)
SELECT s.cmte_id,
       ARRAY_LENGTH(c.cand_names)                    AS num_candidates_supported,
       ARRAY_TO_STRING(c.cand_names, ', ')           AS candidates_supported,
       s.small_dollar_total
FROM small AS s
JOIN cand  AS c
ON  s.cmte_id = c.cmte_id
ORDER BY s.small_dollar_total DESC
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: every 2016 committee that (i) backed ≥1 candidate
--     and (ii) collected >$0 but <$200 in individual contributions overall.
WITH small AS (
  SELECT cmte_id,
         SUM(transaction_amt) AS small_dollar_total
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE transaction_amt > 0
    AND transaction_amt < 200
    AND REGEXP_CONTAINS(cmte_id, r'^C\d{8}')
  GROUP BY cmte_id
  HAVING small_dollar_total > 0
),
cand AS (
  SELECT cmte_id,
         ARRAY_AGG(DISTINCT name ORDER BY name) AS cand_names
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  GROUP BY cmte_id
)
SELECT s.cmte_id                         AS committee_id,
       ARRAY_LENGTH(c.cand_names)        AS num_unique_candidates,
       ARRAY_TO_STRING(c.cand_names, ', ') AS candidate_names_alphabetical,
       s.small_dollar_total              AS total_small_dollar_received
FROM small AS s
JOIN cand  AS c
ON  s.cmte_id = c.cmte_id
ORDER BY committee_id
LIMIT 20;
```
