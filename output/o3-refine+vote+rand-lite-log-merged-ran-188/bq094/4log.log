2025-05-05 04:06:44 - Thread-2605 (execute) - INFO - [Try to run SQL in self-refine]
```sql
/*  1)  find, for 2016, every committee that                                     */
/*      – received any individual contribution >0 and ≤200 USD, and              */
/*      – gave money to at least one candidate                                    */
/*  2)  return                                                                   */
/*      • committee name                                                         */
/*      • number of unique candidates it backed                                  */
/*      • those candidates’ names (A-Z, comma-separated)                         */
/*      • total of the qualifying “small-dollar” receipts                        */
WITH small_dollars AS (         -- step-1 : committees with small-dollar money
  SELECT
    cmte_id,
    SUM(transaction_amt) AS small_dollar_total
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE transaction_amt > 0          -- > $0
    AND transaction_amt <= 200       -- ≤ $200
  GROUP BY cmte_id
  HAVING SUM(transaction_amt) > 0
),
committee_to_candidate AS (      -- step-2 : committees that supported a candidate
  SELECT
    cmte_id,
    cand_id
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  WHERE cand_id IS NOT NULL
),
qualified AS (                   -- committees that satisfy BOTH conditions
  SELECT
    sd.cmte_id,
    sd.small_dollar_total,
    ctc.cand_id
  FROM small_dollars AS sd
  JOIN committee_to_candidate AS ctc
  ON sd.cmte_id = ctc.cmte_id
)
SELECT
  COALESCE(cm.cmte_nm, q.cmte_id)                                          AS committee_name,
  COUNT(DISTINCT q.cand_id)                                                AS num_candidates_supported,
  ARRAY_TO_STRING(ARRAY_AGG(DISTINCT cand.cand_nm ORDER BY cand.cand_nm), ', ') 
                                                                           AS candidate_names,
  ROUND(MAX(q.small_dollar_total), 4)                                      AS total_small_dollar_donations
FROM qualified AS q
LEFT JOIN `bigquery-public-data.fec.committee_master_2016`        AS cm
       ON q.cmte_id = cm.cmte_id
LEFT JOIN `bigquery-public-data.fec.candidate_summary_2016`       AS cand
       ON q.cand_id = cand.cand_id
GROUP BY committee_name, q.cmte_id
ORDER BY total_small_dollar_donations DESC;
```
