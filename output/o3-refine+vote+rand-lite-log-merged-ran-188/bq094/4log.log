  AND `transaction_amt` <= 200
LIMIT 20;
```

```sql
--Description: aggregate the total small-dollar individual receipts per committee
SELECT `cmte_id`,
       SUM(`transaction_amt`) AS small_dollar_total
FROM `bigquery-public-data.fec.individuals_2016`
WHERE `transaction_amt` > 0
  AND `transaction_amt` <= 200
GROUP BY `cmte_id`
LIMIT 20;
```

```sql
--Description: keep only committees whose summed small-dollar donations are greater than $0
SELECT `cmte_id`,
       SUM(`transaction_amt`) AS small_dollar_total
FROM `bigquery-public-data.fec.individuals_2016`
WHERE `transaction_amt` > 0
  AND `transaction_amt` <= 200
GROUP BY `cmte_id`
HAVING SUM(`transaction_amt`) > 0
LIMIT 20;
```

```sql
--Description: identify committees that both (a) supported at least one candidate and
--             (b) received qualifying small-dollar donations
SELECT DISTINCT cc.`cmte_id`
FROM `bigquery-public-data.fec.committee_contributions_2016` AS cc
JOIN (
  SELECT `cmte_id`
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE `transaction_amt` > 0
    AND `transaction_amt` <= 200
  GROUP BY `cmte_id`
  HAVING SUM(`transaction_amt`) > 0
) AS sm
ON cc.`cmte_id` = sm.`cmte_id`
LIMIT 20;
```

```sql
--Description: count how many unique candidates every qualifying committee supported
SELECT cc.`cmte_id`,
       COUNT(DISTINCT cc.`cand_id`) AS num_candidates_supported
FROM `bigquery-public-data.fec.committee_contributions_2016` AS cc
JOIN (
  SELECT `cmte_id`
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE `transaction_amt` > 0
    AND `transaction_amt` <= 200
  GROUP BY `cmte_id`
  HAVING SUM(`transaction_amt`) > 0
) AS sm
ON cc.`cmte_id` = sm.`cmte_id`
GROUP BY cc.`cmte_id`
LIMIT 20;
```

```sql
--Description: FINAL – list committees, number of supported candidates, alphabetical list
--             of candidate names, and total qualifying small-dollar donations received
SELECT
  cc.`cmte_id`                                          AS committee_name,          -- committee ID used as name surrogate
  COUNT(DISTINCT cc.`cand_id`)                          AS num_unique_candidates,
  STRING_AGG(DISTINCT cc.`name` ORDER BY cc.`name`, ', ') AS candidate_names_alpha,
  sm.`small_dollar_total`
FROM (
  SELECT `cmte_id`,
         SUM(`transaction_amt`) AS small_dollar_total
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE `transaction_amt` > 0
    AND `transaction_amt` <= 200
  GROUP BY `cmte_id`
  HAVING SUM(`transaction_amt`) > 0
) AS sm
JOIN `bigquery-public-data.fec.committee_contributions_2016` AS cc
ON sm.`cmte_id` = cc.`cmte_id`
GROUP BY committee_name, sm.`small_dollar_total`
ORDER BY committee_name
LIMIT 20;
```

