/*  Committees (2016 cycle) that                                                *
 *  • received individual contributions >0 and ≤200 USD (small-dollar)          *
 *  • contributed to at least one candidate                                     *
 *                                                                              *
 *  Report: committee name, number of unique candidates supported,              *
 *          alphabetical list of candidate names, total small-dollar receipts   */
WITH small_dollars AS (   -- committees with qualifying individual receipts
  SELECT
    cmte_id,
    SUM(transaction_amt) AS small_dollar_total
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE transaction_amt > 0
    AND transaction_amt <= 200
  GROUP BY cmte_id
  HAVING SUM(transaction_amt) > 0
),
committee_to_candidate AS (   -- committees that supported candidates
  SELECT
    cmte_id,
    cand_id
  FROM `bigquery-public-data.fec.committee_contributions_2016`
  WHERE cand_id IS NOT NULL
),
qualified AS (              -- committees satisfying both conditions
  SELECT
    sd.cmte_id,
    sd.small_dollar_total,
    ctc.cand_id
  FROM small_dollars AS sd
  JOIN committee_to_candidate AS ctc
    ON sd.cmte_id = ctc.cmte_id
)
SELECT
  COALESCE(comm.cmte_nm, q.cmte_id)                                   AS committee_name,
  COUNT(DISTINCT q.cand_id)                                           AS num_candidates_supported,
  ARRAY_TO_STRING(
      ARRAY_AGG(DISTINCT cand.cand_nm ORDER BY cand.cand_nm), ', '
  )                                                                   AS candidate_names,
  ROUND(MAX(q.small_dollar_total), 4)                                 AS total_small_dollar_donations
FROM qualified AS q
LEFT JOIN `bigquery-public-data.fec.committees`  AS comm
       ON q.cmte_id = comm.cmte_id
LEFT JOIN `bigquery-public-data.fec.candidates`  AS cand
       ON q.cand_id = cand.cand_id
GROUP BY committee_name, q.cmte_id
ORDER BY total_small_dollar_donations DESC;
