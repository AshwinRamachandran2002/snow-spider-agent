```sql
--Description / thinking process:
--  Goal: 2016 committees that (a) gave money to ≥1 candidate and (b) took in
--        small-dollar individual donations (0 < amount ≤ 200) whose total > 0.
--
--  1.  Build CTE sm (“small money”):
--        • Filter individuals_2016 on 0 < transaction_amt ≤ 200.
--        • Sum per committee; keep only committees with SUM > 0.
--
--  2.  Join sm to committee_contributions_2016 to retain only committees
--        that actually contributed to at least one candidate.
--
--  3.  Aggregate on that join to compute:
--        • committee_id  (used as name surrogate),
--        • count of distinct candidates supported,
--        • alphabetical list of candidate names (STRING_AGG … ORDER BY …),
--        • total small-dollar receipts from sm.
--
--  4.  Order results by committee_id and LIMIT 20 for brevity.
WITH sm AS (
  SELECT
    cmte_id,
    SUM(transaction_amt) AS small_dollar_total
  FROM `bigquery-public-data.fec.individuals_2016`
  WHERE transaction_amt > 0
    AND transaction_amt <= 200
  GROUP BY cmte_id
  HAVING SUM(transaction_amt) > 0
)
SELECT
  cc.cmte_id                                              AS committee_name,
  COUNT(DISTINCT cc.cand_id)                              AS num_unique_candidates,
  STRING_AGG(DISTINCT cc.name, ', ' ORDER BY cc.name)     AS candidate_names_alpha,
  sm.small_dollar_total
FROM `bigquery-public-data.fec.committee_contributions_2016` AS cc
JOIN sm
  ON cc.cmte_id = sm.cmte_id
GROUP BY committee_name, sm.small_dollar_total
ORDER BY committee_name
LIMIT 20;
```
