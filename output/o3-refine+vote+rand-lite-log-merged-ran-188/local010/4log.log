```sql
WITH
-- 1. take airport data, get city name (English) and numeric lon/lat
airports AS (
    SELECT
        airport_code,
        json_extract(airport_name, '$.en')  AS airport_name_en,
        json_extract(city, '$.en')          AS city,
        CAST(substr(clean, 1, instr(clean, ',') - 1) AS REAL) AS lon,
        CAST(substr(clean, instr(clean, ',') + 1)    AS REAL) AS lat
    FROM (
        SELECT
            airport_code,
            airport_name,
            city,
            REPLACE(REPLACE(coordinates, '(', ''), ')', '') AS clean
        FROM airports_data
    )
),

-- 2. every scheduled route with its cities and coordinates
routes AS (
    SELECT
        f.flight_id,
        d.city  AS dep_city,
        a.city  AS arr_city,
        d.lat   AS dep_lat,
        d.lon   AS dep_lon,
        a.lat   AS arr_lat,
        a.lon   AS arr_lon
    FROM flights AS f
    JOIN airports d ON d.airport_code = f.departure_airport
    JOIN airports a ON a.airport_code = f.arrival_airport
),

-- 3. distance (km) for each single flight using equirectangular approximation
distances AS (
    SELECT
        CASE WHEN dep_city < arr_city THEN dep_city ELSE arr_city END AS city_a,
        CASE WHEN dep_city < arr_city THEN arr_city ELSE dep_city END AS city_b,
        6371.0 * sqrt(
            pow(((arr_lon - dep_lon) * 0.0174532925199433) * 
                cos( ((arr_lat + dep_lat)/2.0) * 0.0174532925199433 ), 2) +
            pow((arr_lat - dep_lat) * 0.0174532925199433, 2)
        ) AS distance_km
    FROM routes
),

-- 4. average distance for every unique (unordered) city pair
pair_avg AS (
    SELECT
        city_a,
        city_b,
        AVG(distance_km) AS avg_distance
    FROM distances
    GROUP BY city_a, city_b
),

-- 5. predefined distance buckets
ranges(label, lower, upper) AS (
    VALUES
        ('0000-0999', 0,     1000),
        ('1000-1999', 1000,  2000),
        ('2000-2999', 2000,  3000),
        ('3000-3999', 3000,  4000),
        ('4000-4999', 4000,  5000),
        ('5000-5999', 5000,  6000),
        ('6000+',     6000,  NULL)
),

-- 6. count pairs falling into every bucket (missing ones get 0)
bucketed AS (
    SELECT
        r.label,
        COUNT(p.city_a) AS pair_cnt
    FROM ranges r
    LEFT JOIN pair_avg p
        ON p.avg_distance >= r.lower
       AND (r.upper IS NULL OR p.avg_distance < r.upper)
    GROUP BY r.label
)

-- 7. final answer: fewest count among all buckets
SELECT MIN(pair_cnt) AS fewest_pairs
FROM bucketed;
```
