```sql
WITH city_coords AS (
    SELECT
        airport_code,
        json_extract(city,'$.en')                  AS city,
        /* coordinates are stored like '(lon,lat)' */
        CAST(substr(coordinates,2,
                    instr(coordinates,',')-2)      AS REAL) AS lon,
        CAST(substr(coordinates,
                    instr(coordinates,',')+1,
                    length(coordinates)
                    -instr(coordinates,',')-1)     AS REAL) AS lat
    FROM airports_data
), 
routes AS (               -- every airport‑to‑airport route that exists at least once
    SELECT DISTINCT departure_airport,
                    arrival_airport
    FROM flights
    WHERE departure_airport <> arrival_airport
), 
pair_distances AS (       -- great‑circle distance for every flight direction
    SELECT
        CASE WHEN c1.city < c2.city THEN c1.city ELSE c2.city END AS city_a,
        CASE WHEN c1.city < c2.city THEN c2.city ELSE c1.city END AS city_b,
        6371 * 2 *
        ASIN(
            SQRT(
                POWER(SIN(RADIANS(c2.lat-c1.lat)/2),2) +
                COS(RADIANS(c1.lat))*COS(RADIANS(c2.lat))*
                POWER(SIN(RADIANS(c2.lon-c1.lon)/2),2)
            )
        ) AS dist_km
    FROM routes r
    JOIN city_coords c1 ON c1.airport_code = r.departure_airport
    JOIN city_coords c2 ON c2.airport_code = r.arrival_airport
), 
avg_pair_distance AS (    -- average over all airport combinations of the same two cities
    SELECT city_a,
           city_b,
           AVG(dist_km) AS avg_dist
    FROM pair_distances
    GROUP BY city_a, city_b
), 
bucketed AS (             -- map each pair to the requested distance range
    SELECT
        CASE
            WHEN avg_dist < 1000 THEN '0‑999'
            WHEN avg_dist < 2000 THEN '1000‑1999'
            WHEN avg_dist < 3000 THEN '2000‑2999'
            WHEN avg_dist < 4000 THEN '3000‑3999'
            WHEN avg_dist < 5000 THEN '4000‑4999'
            WHEN avg_dist < 6000 THEN '5000‑5999'
            ELSE '6000+' END AS distance_range
    FROM avg_pair_distance
), 
range_counts AS (         -- how many unique city pairs in every range
    SELECT distance_range,
           COUNT(*) AS pairs_in_range
    FROM bucketed
    GROUP BY distance_range
)
SELECT pairs_in_range      -- the smallest of those counts
FROM range_counts
ORDER BY pairs_in_range
LIMIT 1;
```
