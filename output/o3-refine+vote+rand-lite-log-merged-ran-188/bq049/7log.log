```sql
WITH cleaned_sales AS (
  -- 1. 2022 Bourbon whiskey sales in Dubuque County with a 5‑digit ZIP
  SELECT
    DATE_TRUNC(`date`, MONTH)                    AS month,
    LPAD(CAST(CAST(SAFE_CAST(zip_code AS FLOAT64) AS INT64) AS STRING), 5, '0') AS zipcode,
    sale_dollars
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE `date` BETWEEN '2022-01-01' AND '2022-12-31'
    AND UPPER(county) = 'DUBUQUE'
    AND UPPER(category_name) LIKE '%BOURBON%'     -- Bourbon‑whiskey rows
),
ranked_zip AS (
  -- 2. Rank Dubuque‑county ZIPs by total 2022 Bourbon sales
  SELECT
    zipcode,
    SUM(sale_dollars)                         AS total_sales,
    RANK() OVER (ORDER BY SUM(sale_dollars) DESC) AS rk
  FROM cleaned_sales
  GROUP BY zipcode
),
target_zip AS (
  -- 3. Keep the ZIP that ranks third
  SELECT zipcode
  FROM ranked_zip
  WHERE rk = 3
),
monthly_sales AS (
  -- 4. Monthly Bourbon sales for that ZIP
  SELECT
    c.month,
    SUM(c.sale_dollars) AS monthly_sales
  FROM cleaned_sales c
  JOIN target_zip t
  ON c.zipcode = t.zipcode
  GROUP BY c.month
),
population21 AS (
  -- 5. 21+ population from the 2010 Census
  SELECT
    LPAD(zipcode, 5, '0')              AS zipcode,
    SUM(population)                    AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE gender IS NULL                 -- total (not male / female split)
    AND minimum_age IS NOT NULL
    AND minimum_age >= 21              -- adults 21+
  GROUP BY zipcode
),
results AS (
  -- 6. Per‑capita monthly sales
  SELECT
    m.month,
    m.monthly_sales / p.pop_21_plus AS per_capita_sales
  FROM monthly_sales m
  JOIN target_zip t         ON TRUE
  JOIN population21 p       ON p.zipcode = t.zipcode
)
SELECT
  FORMAT_DATE('%Y-%m', month)         AS month,
  ROUND(per_capita_sales, 4)          AS per_capita_sales
FROM results
ORDER BY month;
```
