```sql
--Description: Compare 2015 vs 2018 median income at the same ZIP to get raw differences
SELECT a."geo_id",
       a."median_income" AS "median_2015",
       b."median_income" AS "median_2018",
       b."median_income" - a."median_income" AS "income_diff"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
JOIN   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
       ON a."geo_id" = b."geo_id"
LIMIT  20;
```

```sql
--Description: Aggregate average ZIP-level income change by a two-digit ZIP prefix
SELECT SUBSTR(a."geo_id",1,2) AS "state_zip_prefix",
       AVG(b."median_income" - a."median_income") AS "avg_income_diff_15_to_18"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
JOIN   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
       ON a."geo_id" = b."geo_id"
GROUP  BY SUBSTR(a."geo_id",1,2)
ORDER  BY "avg_income_diff_15_to_18" DESC
LIMIT  20;
```

```sql
--Description: Preview 2017 ACS 5-Year employment counts used for vulnerability weighting
SELECT "geo_id",
       "employed_wholesale_trade",
       "employed_construction",
       "employed_arts_entertainment_recreation_accommodation_food",
       "employed_information",
       "employed_retail_trade"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"
LIMIT  20;
```

```sql
--Description: Calculate weighted vulnerable-employment per ZIP code for 2017
SELECT "geo_id",
       0.38423645320197042  * "employed_wholesale_trade" +
       0.48071410777129553  * "employed_construction"     +
       0.89455676291236841  * "employed_arts_entertainment_recreation_accommodation_food" +
       0.31315240083507306  * "employed_information"      +
       0.51                 * "employed_retail_trade"     AS "vulnerable_emp_2017"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"
LIMIT  20;
```

```sql
--Description: Average 2017 weighted vulnerable employment by two-digit ZIP prefix
WITH z AS (
  SELECT "geo_id",
         0.38423645320197042  * "employed_wholesale_trade" +
         0.48071410777129553  * "employed_construction"     +
         0.89455676291236841  * "employed_arts_entertainment_recreation_accommodation_food" +
         0.31315240083507306  * "employed_information"      +
         0.51                 * "employed_retail_trade"     AS "vulnerable_emp_2017"
  FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"
)
SELECT SUBSTR("geo_id",1,2) AS "state_zip_prefix",
       AVG("vulnerable_emp_2017") AS "avg_vulnerable_emp_2017"
FROM   z
GROUP  BY SUBSTR("geo_id",1,2)
ORDER  BY "avg_vulnerable_emp_2017" DESC
LIMIT  20;
```

```sql
--Description: Combine average income change (2015→2018) with 2017 vulnerable employment by prefix
WITH diff AS (
    SELECT SUBSTR(a."geo_id",1,2) AS "state_zip_prefix",
           AVG(b."median_income" - a."median_income") AS "avg_income_diff"
    FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
    JOIN   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
           ON a."geo_id" = b."geo_id"
    GROUP  BY SUBSTR(a."geo_id",1,2)
),
vuln AS (
    SELECT SUBSTR("geo_id",1,2) AS "state_zip_prefix",
           AVG( 0.38423645320197042  * "employed_wholesale_trade" +
                0.48071410777129553  * "employed_construction"     +
                0.89455676291236841  * "employed_arts_entertainment_recreation_accommodation_food" +
                0.31315240083507306  * "employed_information"      +
                0.51                 * "employed_retail_trade" )  AS "avg_vulnerable_emp"
    FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"
    GROUP  BY SUBSTR("geo_id",1,2)
)
SELECT d."state_zip_prefix",
       d."avg_income_diff",
       v."avg_vulnerable_emp"
FROM   diff d
JOIN   vuln v
       ON d."state_zip_prefix" = v."state_zip_prefix"
ORDER  BY d."avg_income_diff" DESC
LIMIT  10;
```

```sql
--Description: Inspect one high-difference prefix’s individual ZIP codes for validation (adjust prefix as needed)
