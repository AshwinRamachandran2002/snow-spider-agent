```sql
/*  CPC groups (level‑4) that appear in patents granted in Germany during
    December 2016, together with the year in which every group reached its
    highest exponential moving average (α = 0.1) of German patent filings  */

WITH RECURSIVE
/* 1. CPC groups occurring in DE patents granted in December‑2016 */
groups_dec2016 AS (
    SELECT DISTINCT
           UPPER(SUBSTR(c.value:"code"::STRING,1,4))      AS cpc_group
    FROM PATENTS.PATENTS.PUBLICATIONS p
         ,LATERAL FLATTEN(INPUT => p."cpc") c
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231
      AND c.value:"code" IS NOT NULL
),

/* 2. Annual filing counts for those groups (all filing years)              */
yearly_counts AS (
    SELECT
        g.cpc_group,
        FLOOR(p."filing_date" / 10000)                    AS yr,   -- extract year
        COUNT(DISTINCT p."publication_number")            AS filings
    FROM PATENTS.PATENTS.PUBLICATIONS p
         ,LATERAL FLATTEN(INPUT => p."cpc") c
         JOIN groups_dec2016 g
           ON g.cpc_group = UPPER(SUBSTR(c.value:"code"::STRING,1,4))
    WHERE p."country_code" = 'DE'
      AND p."filing_date" > 0
      AND c.value:"code" IS NOT NULL
    GROUP BY g.cpc_group, yr
),

/* 3. Impose a chronological order inside each CPC group                    */
ordered AS (
    SELECT
        cpc_group,
        yr,
        filings,
        ROW_NUMBER() OVER (PARTITION BY cpc_group ORDER BY yr) AS rn
    FROM yearly_counts
),

/* 4. Recursively compute the Exponential Moving Average (EMA)              */
recursive_ema AS (       -- α = 0.1
    /* seed (first year) */
    SELECT
        cpc_group,
        yr,
        filings,
        rn,
        CAST(filings AS FLOAT)                                AS ema
    FROM ordered
    WHERE rn = 1

    UNION ALL

    /* recursive step */
    SELECT
        o.cpc_group,
        o.yr,
        o.filings,
        o.rn,
        0.1 * o.filings + 0.9 * r.ema                         AS ema
    FROM ordered        o
    JOIN recursive_ema  r
      ON  o.cpc_group = r.cpc_group
     AND o.rn        = r.rn + 1
),

/* 5. Pick, for every CPC group, the year with the highest EMA              */
best_year AS (
    SELECT
        cpc_group,
        yr                         AS best_year,
        ema,
        ROW_NUMBER() OVER (PARTITION BY cpc_group
                           ORDER BY ema DESC, yr)            AS rnk
    FROM recursive_ema
)

/* 6. Attach CPC titles and return result                                   */
SELECT
    d."titleFull"                     AS "full_title",
    b.cpc_group                       AS "cpc_group",
    b.best_year                       AS "year_with_highest_ema"
FROM best_year                       b
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = b.cpc_group
 WHERE d."level" = 4
   AND b.rnk   = 1
ORDER BY b."year_with_highest_ema" NULLS LAST,
         b.cpc_group;
```
