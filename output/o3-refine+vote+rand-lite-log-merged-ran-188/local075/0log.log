```sql
--Description:  7️⃣  Count how many visits added each product to the cart (product pages 3-11 only).
WITH add_visits AS (
    SELECT DISTINCT e."visit_id",
                    ph."product_id"
    FROM   "shopping_cart_events"          AS e
    JOIN   "shopping_cart_page_hierarchy"  AS ph
           ON e."page_id" = ph."page_id"
    WHERE  e."event_type" = 2                 -- Add-to-Cart
      AND  e."page_id" NOT IN (1,2,12,13)     -- exclude non-product pages
)
SELECT  "product_id",
        COUNT(*) AS "visits_with_add"
FROM    add_visits
GROUP BY "product_id"
ORDER BY "product_id"
LIMIT 20;
```

```sql
--Description:  8️⃣  Count how many of those add-to-cart visits resulted in a purchase.
--              Since purchase events are logged on separate checkout pages (no product_id),
--              we link them back to the product via the visit_id that earlier held an Add-to-Cart.
WITH add_visits AS (
    SELECT DISTINCT e."visit_id",
                    ph."product_id"
    FROM   "shopping_cart_events"          AS e
    JOIN   "shopping_cart_page_hierarchy"  AS ph
           ON e."page_id" = ph."page_id"
    WHERE  e."event_type" = 2
      AND  e."page_id" NOT IN (1,2,12,13)
), purchase_visits AS (
    SELECT DISTINCT av."product_id",
                    av."visit_id"
    FROM   add_visits      AS av
    JOIN   "shopping_cart_events" AS e
           ON e."visit_id" = av."visit_id"
    WHERE  e."event_type" = 3              -- Purchase happened in same visit
)
SELECT  "product_id",
        COUNT(*) AS "visits_with_purchase"
FROM    purchase_visits
GROUP BY "product_id"
ORDER BY "product_id"
LIMIT 20;
```

```sql
--Description:  9️⃣  FINAL BREAKDOWN – views, adds, purchases, and abandons for every product.
--              Purchases are attributed to a product when a Purchase (event_type=3) occurs
--              in a visit that previously added that product to the cart.
WITH page_events AS (        -- all product-page events (views + add-to-cart )
    SELECT  e."visit_id",
            ph."product_id",
            e."event_type"
    FROM    "shopping_cart_events"         AS e
    JOIN    "shopping_cart_page_hierarchy" AS ph
            ON e."page_id" = ph."page_id"
    WHERE   ph."product_id" IS NOT NULL
      AND   e."page_id" NOT IN (1,2,12,13)
),
views AS (                   -- page views per product
    SELECT  "product_id", COUNT(*) AS view_count
    FROM    page_events
    WHERE   event_type = 1
    GROUP BY "product_id"
),
adds AS (                    -- add-to-cart events per product
    SELECT  "product_id", COUNT(*) AS add_to_cart_count
    FROM    page_events
    WHERE   event_type = 2
    GROUP BY "product_id"
),
add_visits AS (              -- distinct visits that added a product
    SELECT DISTINCT "product_id", "visit_id"
    FROM   page_events
    WHERE  event_type = 2
),
purchase_events AS (         -- purchases joined back via visit_id
    SELECT  av."product_id",
            e."visit_id"
    FROM    add_visits              AS av
    JOIN    "shopping_cart_events"  AS e
           ON e."visit_id" = av."visit_id"
    WHERE   e."event_type" = 3
),
purchases AS (               -- purchase counts per product
    SELECT  "product_id", COUNT(*) AS purchase_count
    FROM    purchase_events
    GROUP BY "product_id"
),
abandoned AS (               -- add visits with NO purchase
    SELECT  av."product_id",
            COUNT(*) AS left_in_cart_without_purchase
    FROM    add_visits AS av
    LEFT  JOIN purchase_events AS pe
           ON  av."product_id" = pe."product_id"
          AND av."visit_id"   = pe."visit_id"
    WHERE   pe."visit_id" IS NULL
    GROUP BY av."product_id"
)
SELECT  ph."product_id",
        COALESCE(v.view_count,0)                    AS views,
        COALESCE(a.add_to_cart_count,0)             AS added_to_cart,
        COALESCE(ab.left_in_cart_without_purchase,0) AS left_in_cart_no_purchase,
        COALESCE(p.purchase_count,0)                AS purchases
FROM    "shopping_cart_page_hierarchy" AS ph
LEFT JOIN views      AS v  ON ph."product_id" = v."product_id"
LEFT JOIN adds       AS a  ON ph."product_id" = a."product_id"
LEFT JOIN abandoned  AS ab ON ph."product_id" = ab."product_id"
LEFT JOIN purchases  AS p  ON ph."product_id" = p."product_id"
WHERE   ph."product_id" IS NOT NULL
  AND   ph."page_id" NOT IN (1,2,12,13)
GROUP BY ph."product_id"
ORDER BY ph."product_id"
LIMIT 20;
```
