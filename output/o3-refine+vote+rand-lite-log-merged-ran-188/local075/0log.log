```sql
-- 9️⃣  FINAL ANSWER:
--      Full breakdown for every product (excluding pages 1,2,12,13)
WITH page_events AS (
    SELECT e."visit_id",
           ph."product_id",
           e."event_type"
    FROM "shopping_cart_events"  AS e
    JOIN "shopping_cart_page_hierarchy" AS ph
         ON e."page_id" = ph."page_id"
    WHERE e."page_id" NOT IN (1,2,12,13)
      AND ph."product_id" IS NOT NULL
),
views AS (
    SELECT "product_id", COUNT(*) AS "view_count"
    FROM page_events
    WHERE "event_type" = 1
    GROUP BY "product_id"
),
adds AS (
    SELECT "product_id", COUNT(*) AS "add_to_cart_count"
    FROM page_events
    WHERE "event_type" = 2
    GROUP BY "product_id"
),
purchases AS (
    SELECT "product_id", COUNT(*) AS "purchase_count"
    FROM page_events
    WHERE "event_type" = 3
    GROUP BY "product_id"
),
add_visits AS (
    SELECT DISTINCT "product_id", "visit_id"
    FROM page_events
    WHERE "event_type" = 2
),
purchase_visits AS (
    SELECT DISTINCT "product_id", "visit_id"
    FROM page_events
    WHERE "event_type" = 3
),
abandoned AS (
    SELECT av."product_id",
           COUNT(*) AS "left_in_cart_without_purchase"
    FROM add_visits AS av
    LEFT JOIN purchase_visits AS pv
           ON  av."product_id" = pv."product_id"
          AND av."visit_id"   = pv."visit_id"
    WHERE pv."visit_id" IS NULL              -- no purchase in that visit
    GROUP BY av."product_id"
)
SELECT ph."product_id",
       COALESCE(v."view_count",0)                       AS "views",
       COALESCE(a."add_to_cart_count",0)                AS "added_to_cart",
       COALESCE(ab."left_in_cart_without_purchase",0)   AS "left_in_cart_no_purchase",
       COALESCE(p."purchase_count",0)                   AS "purchases"
FROM "shopping_cart_page_hierarchy" AS ph
LEFT JOIN views      AS v  ON ph."product_id" = v."product_id"
LEFT JOIN adds       AS a  ON ph."product_id" = a."product_id"
LEFT JOIN abandoned  AS ab ON ph."product_id" = ab."product_id"
LEFT JOIN purchases  AS p  ON ph."product_id" = p."product_id"
WHERE ph."product_id" IS NOT NULL
  AND ph."page_id" NOT IN (1,2,12,13)
GROUP BY ph."product_id"
ORDER BY ph."product_id"
LIMIT 20;
```

Each step builds toward the final breakdown:

• views  ― number of page-view events (event_type = 1)  
• added_to_cart ― number of add-to-cart events (event_type = 2)  
• left_in_cart_no_purchase ― visits that added the product but never purchased it  
• purchases ― number of purchase events (event_type = 3)  

The filter `page_id NOT IN (1,2,12,13)` is applied everywhere so these navigation-only pages are excluded.
