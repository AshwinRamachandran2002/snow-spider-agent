LEFT JOIN "shopping_cart_page_hierarchy" AS ph
       ON e."page_id" = ph."page_id"
WHERE    e."event_type" = 3               -- Purchase events
GROUP BY e."page_id", ph."product_id"
ORDER BY purchase_count DESC
LIMIT 20;
