Query:
--Description: 7. Re-create the side-by-side summary of views, adds and purchases,
--              but build the “purchase” sub-query without relying on a JOIN to
--              the hierarchy (because purchase rows might not have a matching
--              product page).  We count purchases by page_id first and then
--              attach the descriptive data; COALESCE keeps missing measures as 0.
SELECT
       ph.product_id,
       ph.page_name,
       COALESCE(v.view_count,      0) AS view_count,
       COALESCE(a.add_cart_count,  0) AS add_cart_count,
       COALESCE(pr.purchase_count, 0) AS purchase_count
FROM  (SELECT DISTINCT product_id, page_name, page_id
       FROM   shopping_cart_page_hierarchy
       WHERE  page_id NOT IN (1,2,12,13))                           AS ph
LEFT JOIN (
       SELECT p.product_id, COUNT(*) AS view_count
       FROM   shopping_cart_events         AS e
       JOIN   shopping_cart_page_hierarchy AS p
              ON e.page_id = p.page_id
       WHERE  e.event_type = 1
         AND  e.page_id   NOT IN (1,2,12,13)
       GROUP BY p.product_id)                                        AS v
       ON ph.product_id = v.product_id
LEFT JOIN (
       SELECT p.product_id, COUNT(*) AS add_cart_count
       FROM   shopping_cart_events         AS e
       JOIN   shopping_cart_page_hierarchy AS p
              ON e.page_id = p.page_id
       WHERE  e.event_type = 2
         AND  e.page_id   NOT IN (1,2,12,13)
       GROUP BY p.product_id)                                        AS a
       ON ph.product_id = a.product_id
LEFT JOIN (
       -- purchase counts captured straight from the events table
       SELECT  e.page_id, COUNT(*) AS purchase_count
       FROM    shopping_cart_events AS e
       WHERE   e.event_type = 3
