Query:
--Description: 4.  Count how many times each product was merely VIEWED
--              (event_type = 1) on its product page.
SELECT
       p.product_id,
       p.page_name,
       COUNT(*)  AS view_count
FROM   shopping_cart_events         AS e
JOIN   shopping_cart_page_hierarchy AS p 
       ON e.page_id = p.page_id
WHERE  e.event_type = 1
  AND  e.page_id   NOT IN (1,2,12,13)
GROUP BY p.product_id, p.page_name
ORDER BY view_count DESC
LIMIT 20;
