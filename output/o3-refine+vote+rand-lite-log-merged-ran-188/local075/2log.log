```sql
--Description: 7.  Bring the three individual aggregates together so we can
--              see views, adds, and purchases side-by-side for each product.
SELECT
       p.product_id,
       p.page_name,
       COALESCE(v.view_count, 0)      AS view_count,
       COALESCE(a.add_cart_count, 0)  AS add_cart_count,
       COALESCE(pr.purchase_count, 0) AS purchase_count
FROM  (SELECT DISTINCT product_id, page_name
       FROM   shopping_cart_page_hierarchy
       WHERE  page_id NOT IN (1,2,12,13))                            AS p
LEFT JOIN (
       SELECT p.product_id, COUNT(*) AS view_count
       FROM   shopping_cart_events         AS e
       JOIN   shopping_cart_page_hierarchy AS p 
              ON e.page_id = p.page_id
       WHERE  e.event_type = 1
         AND  e.page_id   NOT IN (1,2,12,13)
       GROUP BY p.product_id)                                         AS v
       ON p.product_id = v.product_id
LEFT JOIN (
       SELECT p.product_id, COUNT(*) AS add_cart_count
       FROM   shopping_cart_events         AS e
       JOIN   shopping_cart_page_hierarchy AS p 
              ON e.page_id = p.page_id
       WHERE  e.event_type = 2
         AND  e.page_id   NOT IN (1,2,12,13)
       GROUP BY p.product_id)                                         AS a
       ON p.product_id = a.product_id
LEFT JOIN (
       SELECT p.product_id, COUNT(*) AS purchase_count
       FROM   shopping_cart_events         AS e
       JOIN   shopping_cart_page_hierarchy AS p 
              ON e.page_id = p.page_id
       WHERE  e.event_type = 3
         AND  e.page_id   NOT IN (1,2,12,13)
       GROUP BY p.product_id)                                         AS pr
       ON p.product_id = pr.product_id
LIMIT 20;
```

```sql
--Description: 8.  Add a “left_in_cart” metric: items added but never bought
--              (simple difference between adds and purchases).
SELECT
       t.product_id,
       t.page_name,
       t.view_count,
       t.add_cart_count,
       t.purchase_count,
       (t.add_cart_count - t.purchase_count) AS left_in_cart
FROM  (
      -- inner query is the same aggregate in step 7
      SELECT
             p.product_id,
             p.page_name,
             COALESCE(v.view_count, 0)      AS view_count,
             COALESCE(a.add_cart_count, 0)  AS add_cart_count,
             COALESCE(pr.purchase_count, 0) AS purchase_count
      FROM  (SELECT DISTINCT product_id, page_name
             FROM   shopping_cart_page_hierarchy
             WHERE  page_id NOT IN (1,2,12,13))   AS p
      LEFT JOIN (
             SELECT p.product_id, COUNT(*) AS view_count
             FROM   shopping_cart_events         AS e
             JOIN   shopping_cart_page_hierarchy AS p 
                    ON e.page_id = p.page_id
             WHERE  e.event_type = 1
               AND  e.page_id   NOT IN (1,2,12,13)
             GROUP BY p.product_id)               AS v
             ON p.product_id = v.product_id
      LEFT JOIN (
             SELECT p.product_id, COUNT(*) AS add_cart_count
             FROM   shopping_cart_events         AS e
             JOIN   shopping_cart_page_hierarchy AS p 
                    ON e.page_id = p.page_id
             WHERE  e.event_type = 2
               AND  e.page_id   NOT IN (1,2,12,13)
             GROUP BY p.product_id)               AS a
             ON p.product_id = a.product_id
      LEFT JOIN (
             SELECT p.product_id, COUNT(*) AS purchase_count
             FROM   shopping_cart_events         AS e
             JOIN   shopping_cart_page_hierarchy AS p 
                    ON e.page_id = p.page_id
             WHERE  e.event_type = 3
               AND  e.page_id   NOT IN (1,2,12,13)
             GROUP BY p.product_id)               AS pr
             ON p.product_id = pr.product_id
) AS t
ORDER BY left_in_cart DESC
LIMIT 20;
```

