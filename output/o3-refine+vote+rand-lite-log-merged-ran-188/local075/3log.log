Query:
--Description: ⑧  FINAL – rebuild the summary table (views, adds, purchases, left-in-cart)
--             but FIX the purchases CTE: do not exclude any page_id values because
--             purchase events are recorded on checkout pages that were previously
--             filtered out.  Instead, just require a valid product_id.  Views and
--             adds keep their original page filters.
WITH
views AS (                      -- page views for real product pages only
    SELECT p."product_id", COUNT(*) AS "page_views"
    FROM   "shopping_cart_events"         AS e
    JOIN   "shopping_cart_page_hierarchy" AS p
           ON e."page_id" = p."page_id"
    WHERE  e."event_type" = 1
       AND e."page_id" NOT IN (1,2,12,13)
    GROUP BY p."product_id"
),
adds AS (                       -- add-to-cart actions for real product pages only
    SELECT p."product_id", COUNT(*) AS "added_to_cart"
    FROM   "shopping_cart_events"         AS e
    JOIN   "shopping_cart_page_hierarchy" AS p
           ON e."page_id" = p."page_id"
    WHERE  e."event_type" = 2
       AND e."page_id" NOT IN (1,2,12,13)
    GROUP BY p."product_id"
),
purchases AS (                  -- PURCHASE events: keep ALL pages, but insist on a product_id
    SELECT p."product_id", COUNT(*) AS "purchases"
    FROM   "shopping_cart_events"         AS e
    JOIN   "shopping_cart_page_hierarchy" AS p
           ON e."page_id" = p."page_id"
    WHERE  e."event_type" = 3
      AND  p."product_id" IS NOT NULL
    GROUP BY p."product_id"
)
SELECT  pid."product_id",
        COALESCE(v."page_views",0)            AS "page_views",
        COALESCE(a."added_to_cart",0)         AS "added_to_cart",
        COALESCE(a."added_to_cart",0) -
        COALESCE(pr."purchases",0)            AS "left_in_cart_without_purchase",
        COALESCE(pr."purchases",0)            AS "purchases"
FROM   (
        SELECT "product_id" FROM views
        UNION
        SELECT "product_id" FROM adds
        UNION
        SELECT "product_id" FROM purchases
       )                     AS pid
LEFT JOIN views      v  ON pid."product_id" = v."product_id"
LEFT JOIN adds       a  ON pid."product_id" = a."product_id"
LEFT JOIN purchases  pr ON pid."product_id" = pr."product_id"
ORDER BY pid."product_id"
LIMIT 20
Answer:
product_id,page_views,added_to_cart,left_in_cart_without_purchase,purchases
