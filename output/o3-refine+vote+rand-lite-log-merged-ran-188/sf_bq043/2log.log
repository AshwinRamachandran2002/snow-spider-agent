       MAX( CASE WHEN r."gene_name" = 'CDKN1A' THEN r."fpkm_unstranded" END ) AS "CDKN1A_fpkm",
       MAX( CASE WHEN r."gene_name" = 'CCNE1'  THEN r."fpkm_unstranded" END ) AS "CCNE1_fpkm"
FROM   "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R40"  r
JOIN  (SELECT DISTINCT "case_barcode"
       FROM "TCGA"."TCGA_VERSIONED"."SOMATIC_MUTATION_HG19_MC3_2017_02"
       WHERE "project_short_name" = 'TCGA-BLCA'
         AND "Hugo_Symbol"        = 'CDKN2A') m
  ON r."case_barcode" = m."case_barcode"
WHERE  r."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
GROUP BY r."case_barcode"
LIMIT 20;
```

```sql
--Description: 10)  Final combined query – expression (pivoted) plus selected clinical fields for CDKN2A-mutated BLCA cases
SELECT e."case_barcode",
       e."MDM2_fpkm",
       e."TP53_fpkm",
       e."CDKN1A_fpkm",
       e."CCNE1_fpkm",
       c."demo__gender"                 AS "gender",
       c."demo__race"                   AS "race",
       c."demo__ethnicity"              AS "ethnicity",
       c."demo__vital_status"           AS "vital_status",
       c."diag__ajcc_pathologic_stage"  AS "pathologic_stage"
FROM  (
        SELECT r."case_barcode",
               MAX( CASE WHEN r."gene_name" = 'MDM2'   THEN r."fpkm_unstranded" END ) AS "MDM2_fpkm",
               MAX( CASE WHEN r."gene_name" = 'TP53'   THEN r."fpkm_unstranded" END ) AS "TP53_fpkm",
               MAX( CASE WHEN r."gene_name" = 'CDKN1A' THEN r."fpkm_unstranded" END ) AS "CDKN1A_fpkm",
               MAX( CASE WHEN r."gene_name" = 'CCNE1'  THEN r."fpkm_unstranded" END ) AS "CCNE1_fpkm"
        FROM   "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R40"  r
        JOIN  (SELECT DISTINCT "case_barcode"
               FROM "TCGA"."TCGA_VERSIONED"."SOMATIC_MUTATION_HG19_MC3_2017_02"
               WHERE "project_short_name" = 'TCGA-BLCA'
                 AND "Hugo_Symbol"        = 'CDKN2A') m
          ON r."case_barcode" = m."case_barcode"
        WHERE  r."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
        GROUP BY r."case_barcode"
      ) e
LEFT JOIN "TCGA"."TCGA_VERSIONED"."CLINICAL_GDC_R39" c
  ON e."case_barcode" = c."submitter_id"
LIMIT 20;
```
