Query:
--Description: 8)  Combine RNA-Seq expression (hg19 2017-02) with clinical data (Release 39) for CDKN2A-mutated BLCA cases – long format
SELECT r."case_barcode",
       r."sample_barcode",
       r."HGNC_gene_symbol"                 AS "gene",
       r."normalized_count"                 AS "expr_norm_cnt",
       c."demo__gender",
       c."demo__race",
       c."demo__ethnicity",
       c."demo__vital_status",
       c."diag__ajcc_pathologic_stage"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG19_GDC_2017_02"  r
JOIN ( SELECT DISTINCT "case_barcode"
       FROM "TCGA"."TCGA_VERSIONED"."SOMATIC_MUTATION_HG19_MC3_2017_02"
       WHERE "project_short_name" = 'TCGA-BLCA'
         AND "Hugo_Symbol"        = 'CDKN2A'
     ) m
  ON r."case_barcode" = m."case_barcode"
LEFT JOIN "TCGA"."TCGA_VERSIONED"."CLINICAL_GDC_R39"     c
  ON r."case_barcode" = c."submitter_id"
WHERE r."HGNC_gene_symbol" IN ('MDM2','TP53','CDKN1A','CCNE1')
LIMIT 20
Answer:
case_barcode,sample_barcode,gene,expr_norm_cnt,demo__gender,demo__race,demo__ethnicity,demo__vital_status,diag__ajcc_pathologic_stage
TCGA-ZF-A9RD,TCGA-ZF-A9RD-01A,TP53,997.319,female,white,not hispanic or latino,Dead,Stage IV
TCGA-DK-A3X1,TCGA-DK-A3X1-01A,MDM2,1737.0563,female,white,not hispanic or latino,Alive,Stage III
Query:
--Description: 9)  Pivot the four genes into separate expression columns per CDKN2A-mutated BLCA case (hg19 2017-02)
SELECT r."case_barcode",
       MAX(CASE WHEN r."HGNC_gene_symbol" = 'MDM2'   THEN r."normalized_count" END) AS "MDM2_norm",
       MAX(CASE WHEN r."HGNC_gene_symbol" = 'TP53'   THEN r."normalized_count" END) AS "TP53_norm",
       MAX(CASE WHEN r."HGNC_gene_symbol" = 'CDKN1A' THEN r."normalized_count" END) AS "CDKN1A_norm",
       MAX(CASE WHEN r."HGNC_gene_symbol" = 'CCNE1'  THEN r."normalized_count" END) AS "CCNE1_norm"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG19_GDC_2017_02" r
JOIN ( SELECT DISTINCT "case_barcode"
       FROM "TCGA"."TCGA_VERSIONED"."SOMATIC_MUTATION_HG19_MC3_2017_02"
       WHERE "project_short_name" = 'TCGA-BLCA'
         AND "Hugo_Symbol"        = 'CDKN2A'
     ) m
  ON r."case_barcode" = m."case_barcode"
WHERE r."HGNC_gene_symbol" IN ('MDM2','TP53','CDKN1A','CCNE1')
GROUP BY r."case_barcode"
LIMIT 20
Answer:
case_barcode,MDM2_norm,TP53_norm,CDKN1A_norm,CCNE1_norm
TCGA-DK-A3X1,1737.0563,,,
TCGA-ZF-A9RD,,997.319,,
Query:
--Description: 10)  Final combined output – pivoted expression (hg19 2017-02) plus key clinical attributes (R39) for CDKN2A-mutated BLCA cases
SELECT e."case_barcode",
       e."MDM2_norm",
       e."TP53_norm",
       e."CDKN1A_norm",
       e."CCNE1_norm",
       c."demo__gender"                AS "gender",
       c."demo__race"                  AS "race",
       c."demo__ethnicity"             AS "ethnicity",
       c."demo__vital_status"          AS "vital_status",
       c."diag__ajcc_pathologic_stage" AS "pathologic_stage"
FROM (
        SELECT r."case_barcode",
               MAX(CASE WHEN r."HGNC_gene_symbol" = 'MDM2'   THEN r."normalized_count" END) AS "MDM2_norm",
               MAX(CASE WHEN r."HGNC_gene_symbol" = 'TP53'   THEN r."normalized_count" END) AS "TP53_norm",
               MAX(CASE WHEN r."HGNC_gene_symbol" = 'CDKN1A' THEN r."normalized_count" END) AS "CDKN1A_norm",
               MAX(CASE WHEN r."HGNC_gene_symbol" = 'CCNE1'  THEN r."normalized_count" END) AS "CCNE1_norm"
        FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG19_GDC_2017_02" r
        JOIN ( SELECT DISTINCT "case_barcode"
               FROM "TCGA"."TCGA_VERSIONED"."SOMATIC_MUTATION_HG19_MC3_2017_02"
               WHERE "project_short_name" = 'TCGA-BLCA'
                 AND "Hugo_Symbol"        = 'CDKN2A'
             ) m
          ON r."case_barcode" = m."case_barcode"
        WHERE r."HGNC_gene_symbol" IN ('MDM2','TP53','CDKN1A','CCNE1')
        GROUP BY r."case_barcode"
     ) e
LEFT JOIN "TCGA"."TCGA_VERSIONED"."CLINICAL_GDC_R39" c
  ON e."case_barcode" = c."submitter_id"
LIMIT 20
Answer:
case_barcode,MDM2_norm,TP53_norm,CDKN1A_norm,CCNE1_norm,gender,race,ethnicity,vital_status,pathologic_stage
