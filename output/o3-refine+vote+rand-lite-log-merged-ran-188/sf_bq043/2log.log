[{'project_submitter_id': 'CPTAC-TCGA', 'vital_status': None, 'primary_diagnosis': None, 'age_at_diagnosis': nan, 'tumor_stage': None}, {'project_submitter_id': 'CPTAC-TCGA', 'vital_status': 'Alive', 'primary_diagnosis': 'Infiltrating duct carcinoma, NOS', 'age_at_diagnosis': 24242.0, 'tumor_stage': 'Stage I'}, {'project_submitter_id': 'CPTAC-TCGA', 'vital_status': 'Alive', 'primary_diagnosis': 'Adenocarcinoma, NOS', 'age_at_diagnosis': 25752.0, 'tumor_stage': 'Stage I'}, {'project_submitter_id': 'CPTAC-TCGA', 'vital_status': 'Alive', 'primary_diagnosis': 'Adenocarcinoma, NOS', 'age_at_diagnosis': 26967.0, 'tumor_stage': 'Stage I'}, {'project_submitter_id': 'CPTAC-TCGA', 'vital_status': 'Alive', 'primary_diagnosis': 'Adenocarcinoma, NOS', 'age_at_diagnosis': 23986.0, 'tumor_stage': 'Stage I'}]

