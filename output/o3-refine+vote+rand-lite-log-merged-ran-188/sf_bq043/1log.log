TCGA-BLCA,TCGA-DK-A2I4,CDKN2AIPNL,Nonsense_Mutation,SNP
Query:
--Description: 2) Retrieve the list of BLCA patient barcodes that have a CDKN2A mutation
SELECT DISTINCT 
       "case_barcode"
FROM   TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG19_MC3_2017_02"
WHERE  "project_short_name" = 'TCGA-BLCA'
  AND  "Hugo_Symbol" ILIKE '%CDKN2A%'
LIMIT 20;
