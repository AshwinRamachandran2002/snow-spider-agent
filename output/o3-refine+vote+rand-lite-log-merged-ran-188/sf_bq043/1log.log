```sql
--Description: 8) Full view: combine clinical info with gene expression for CDKN2A-mutant BLCA cases
SELECT exp."case_barcode",
       exp."sample_barcode",
       exp."gene_name",
       exp."FPKM",
       cl."gender",
       cl."race",
       cl."ethnicity",
       cl."vital_status",
       cl."year_of_dx",
       cl."pathologic_stage"
FROM (
      SELECT "case_barcode",
             "sample_barcode",
             "gene_name",
             "fpkm_unstranded" AS "FPKM"
      FROM   TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"
      WHERE  "project_short_name" = 'TCGA-BLCA'
        AND  "gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
     ) exp
JOIN (
      SELECT DISTINCT
             "submitter_id"                 AS "case_barcode",
             "demo__gender"                 AS "gender",
             "demo__race"                   AS "race",
             "demo__ethnicity"              AS "ethnicity",
             "demo__vital_status"           AS "vital_status",
             "diag__year_of_diagnosis"      AS "year_of_dx",
             "diag__ajcc_pathologic_stage"  AS "pathologic_stage"
      FROM   TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"
      WHERE  "proj__project_id" = 'TCGA-BLCA'
     ) cl
  ON exp."case_barcode" = cl."case_barcode"
JOIN (
      SELECT DISTINCT "case_barcode"
      FROM   TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG19_MC3_2017_02"
      WHERE  "project_short_name"='TCGA-BLCA'
        AND  "Hugo_Symbol" ILIKE '%CDKN2A%'
     ) mut
  ON exp."case_barcode" = mut."case_barcode"
LIMIT 20;
```

```sql
--Description: 9) Pivot-like summary: show each CDKN2A-mutant BLCA case with FPKM for the four genes (one row per case)
SELECT *
FROM (
      SELECT exp."case_barcode",
             exp."gene_name",
             exp."fpkm_unstranded" AS "FPKM"
      FROM   TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39" exp
      JOIN  (SELECT DISTINCT "case_barcode"
             FROM TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG19_MC3_2017_02"
             WHERE "project_short_name"='TCGA-BLCA'
               AND "Hugo_Symbol" ILIKE '%CDKN2A%') mut
             ON exp."case_barcode" = mut."case_barcode"
      WHERE  exp."project_short_name"='TCGA-BLCA'
        AND  exp."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
     ) src
PIVOT(
      MAX("FPKM") FOR "gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
) pv
LIMIT 20;
```

```sql
