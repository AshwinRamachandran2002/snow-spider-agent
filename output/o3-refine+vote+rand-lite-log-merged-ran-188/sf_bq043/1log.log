--Description: 8) Combine gene expression (Release-28) and clinical data (Release-39) for CDKN2A-mutant TCGA-BLCA cases;
--use the correct expression columns “HTSeq__FPKM” and “HTSeq__FPKM_UQ”.
SELECT  exp."case_barcode",
        exp."sample_barcode",
        exp."gene_name",
        exp."HTSeq__FPKM"      AS "FPKM",
        exp."HTSeq__FPKM_UQ"   AS "FPKM_UQ",
        clin."demo__gender"                AS "gender",
        clin."demo__race"                  AS "race",
        clin."demo__ethnicity"             AS "ethnicity",
        clin."demo__vital_status"          AS "vital_status",
        clin."diag__year_of_diagnosis"     AS "year_of_dx",
        clin."diag__ajcc_pathologic_stage" AS "pathologic_stage"
FROM  (
        SELECT "case_barcode",
               "sample_barcode",
               "gene_name",
               "HTSeq__FPKM",
               "HTSeq__FPKM_UQ"
        FROM   TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R28"
        WHERE  "project_short_name" = 'TCGA-BLCA'
          AND  "gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
      ) exp
JOIN (
        SELECT DISTINCT
               "submitter_id"                AS "case_barcode",
               "demo__gender",
               "demo__race",
               "demo__ethnicity",
               "demo__vital_status",
               "diag__year_of_diagnosis",
               "diag__ajcc_pathologic_stage"
        FROM   TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"
        WHERE  "proj__project_id" = 'TCGA-BLCA'
     ) clin
  ON exp."case_barcode" = clin."case_barcode"
JOIN (
        SELECT DISTINCT "case_barcode"
        FROM   TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG19_MC3_2017_02"
        WHERE  "project_short_name" = 'TCGA-BLCA'
          AND  "Hugo_Symbol" ILIKE '%CDKN2A%'
     ) mut
  ON exp."case_barcode" = mut."case_barcode"
LIMIT 20;
