```sql
-- Description: For every month Feb-2020 .. Dec-2020, count the distinct cohort users who placed an order again
WITH jan20_cohort AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id", MIN("created_at") AS "first_ts"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
        GROUP  BY "user_id"
    )
    WHERE  "first_ts" BETWEEN 1577836800000000 AND 1580515199000000
)
SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') AS "yyyy_mm",
       COUNT(DISTINCT oi."user_id")                                  AS "returning_users"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
JOIN   jan20_cohort c
       ON oi."user_id" = c."user_id"
WHERE  oi."created_at" BETWEEN 1580515200000000        -- 2020-02-01
                          AND 1609459199000000        -- 2020-12-31 23:59:59
GROUP  BY "yyyy_mm"
ORDER  BY "yyyy_mm"
LIMIT 20;
```

```sql
-- Description: Calculate the proportion of the cohort that returned each month (Feb-Dec 2020)
WITH jan20_cohort AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id", MIN("created_at") AS "first_ts"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
        GROUP  BY "user_id"
    )
    WHERE  "first_ts" BETWEEN 1577836800000000 AND 1580515199000000
), monthly_return AS (
    SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') AS "yyyy_mm",
           COUNT(DISTINCT oi."user_id")                                  AS "returning_users"
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
    JOIN   jan20_cohort c
           ON oi."user_id" = c."user_id"
    WHERE  oi."created_at" BETWEEN 1580515200000000 AND 1609459199000000
    GROUP  BY "yyyy_mm"
)
SELECT mr."yyyy_mm",
       mr."returning_users",
       jc.cohort_size,
       (mr."returning_users" * 1.0) / jc.cohort_size AS "return_rate"
FROM   monthly_return mr
CROSS  JOIN (SELECT COUNT(*) AS cohort_size FROM jan20_cohort) jc
ORDER  BY mr."yyyy_mm"
LIMIT 20;
```

```sql
-- Description: Produce a pivot-style view showing each cohort user and the first month they returned (if any) in 2020
WITH jan20_cohort AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id", MIN("created_at") AS "first_ts"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
        GROUP  BY "user_id"
    )
    WHERE  "first_ts" BETWEEN 1577836800000000 AND 1580515199000000
)
SELECT c."user_id",
       MIN(TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM')) AS "first_return_month"
FROM   jan20_cohort c
LEFT  JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
       ON  c."user_id" = oi."user_id"
       AND oi."created_at" BETWEEN 1580515200000000 AND 1609459199000000
GROUP  BY c."user_id"
LIMIT 20;
```

```sql
-- Description: Inspect order statuses for cohort users in Feb-2020 to ensure we only consider completed purchases
WITH jan20_cohort AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id", MIN("created_at") AS "first_ts"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
        GROUP  BY "user_id"
    )
    WHERE  "first_ts" BETWEEN 1577836800000000 AND 1580515199000000
)
SELECT DISTINCT oi."status"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
JOIN   jan20_cohort c
       ON oi."user_id" = c."user_id"
WHERE  oi."created_at" BETWEEN 1580515200000000        -- 2020-02-01
                          AND 1583020799000000        -- 2020-02-29 23:59:59
LIMIT 20;
```

```sql
-- Description: Cross-check the same retention logic but using the ORDERS table instead of ORDER_ITEMS
WITH jan20_cohort AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id", MIN("created_at") AS "first_ts"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE  "status" = 'Complete'
        GROUP  BY "user_id"
    )
    WHERE  "first_ts" BETWEEN 1577836800000000 AND 1580515199000000
)
SELECT TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000), 'YYYY-MM') AS "yyyy_mm",
       COUNT(DISTINCT o."user_id")                                  AS "returning_users"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
JOIN   jan20_cohort c
       ON o."user_id" = c."user_id"
WHERE  o."created_at" BETWEEN 1580515200000000 AND 1609459199000000
  AND  o."status" = 'Complete'
GROUP  BY "yyyy_mm"
ORDER  BY "yyyy_mm"
LIMIT 20;
