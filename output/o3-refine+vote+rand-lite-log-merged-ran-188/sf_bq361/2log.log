```sql
--Description: 9)  Monthly view – how many of the cohort came back in each month (Feb-Dec 2020)  
WITH jan20 AS (
      SELECT DISTINCT "user_id"
      FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" j
      WHERE  "created_at" BETWEEN 1577836800000000 AND 1580515199999999
      QUALIFY "created_at" = (SELECT MIN("created_at")
                              FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" z
                              WHERE  z."user_id" = j."user_id")
)
SELECT 
       DATE_TRUNC('month', TO_TIMESTAMP_LTZ(o."created_at"/1000000))  AS "order_month",
       COUNT(DISTINCT o."user_id")                                    AS "returning_users"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   jan20 USING ("user_id")
WHERE  o."created_at" >= 1580515200000000
  AND  o."created_at" <  1609459200000000
GROUP  BY 1
ORDER  BY 1
LIMIT 20;
