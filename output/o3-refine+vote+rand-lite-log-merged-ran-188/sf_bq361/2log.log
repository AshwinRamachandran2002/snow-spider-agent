```sql
--Description / Thinking process:
-- Goal: For the cohort whose very FIRST purchase happened in January-2020,
--       calculate, for every later month in 2020 (Feb-Dec), the proportion
--       of those cohort users who made another purchase in that month.
--
-- Steps inside the query
-- 1) first_orders   : one row per user with their first-ever order timestamp.
-- 2) cohort_jan2020 : keep only those users whose first order fell in
--                     2020-01-01 ≤ ts < 2020-02-01  (microseconds epoch).
-- 3) monthly_sales  : all later orders by those cohort users during
--                     2020-02-01 ≤ ts < 2021-01-01, grouped by month,
--                     counting DISTINCT users returning.
-- 4) Final SELECT   : for each month, show returning_users, cohort_size,
--                     and returning_users / cohort_size as proportion.

WITH first_orders AS (
    SELECT
        "user_id",
        MIN("created_at") AS "first_order_ts"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
),
cohort_jan2020 AS (
    SELECT "user_id"
    FROM   first_orders
    WHERE  "first_order_ts" >= 1577836800000000       -- 2020-01-01
      AND  "first_order_ts" <  1580515200000000       -- 2020-02-01
),
monthly_sales AS (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP_LTZ(o."created_at"/1000000)) AS "order_month",
        COUNT(DISTINCT o."user_id")                                   AS "returning_users"
    FROM  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
    JOIN  cohort_jan2020 c
          ON o."user_id" = c."user_id"
    WHERE o."created_at" >= 1580515200000000        -- 2020-02-01
      AND o."created_at" <  1609459200000000        -- 2021-01-01
    GROUP BY 1
)
SELECT
    m."order_month",
    m."returning_users",
    (SELECT COUNT(*) FROM cohort_jan2020) AS "cohort_size",
    ROUND(m."returning_users"::FLOAT
          / NULLIF((SELECT COUNT(*) FROM cohort_jan2020),0), 4) AS "return_rate"
FROM   monthly_sales m
ORDER  BY m."order_month";
```
