Query:
--Description: 6) Show every later order (Feb-Dec 2020) placed by users in the January-2020 cohort
WITH first_orders AS (
    SELECT "user_id",
           MIN("created_at") AS "first_order_ts"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP  BY "user_id"
), cohort_jan2020 AS (
    SELECT "user_id"
    FROM   first_orders
    WHERE  "first_order_ts" >= 1577836800000000        -- 2020-01-01
      AND  "first_order_ts" <  1580515200000000        -- 2020-02-01
)
SELECT   o.*
FROM     THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN     cohort_jan2020 c
       ON o."user_id" = c."user_id"
WHERE    o."created_at" >= 1580515200000000            -- 2020-02-01
  AND    o."created_at" <  1609459200000000            -- 2021-01-01
LIMIT 20
