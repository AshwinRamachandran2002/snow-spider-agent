Query:
--Description: 7) Count distinct cohort users who placed at least one more order in Feb-Dec 2020
WITH first_orders AS (
    SELECT "user_id",
           MIN("created_at") AS "first_order_ts"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP  BY "user_id"
), cohort_jan2020 AS (
    SELECT "user_id"
    FROM   first_orders
    WHERE  "first_order_ts" >= 1577836800000000
      AND  "first_order_ts" <  1580515200000000
)
SELECT COUNT(DISTINCT o."user_id") AS "returning_users_Feb_to_Dec_2020"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   cohort_jan2020 c
     ON o."user_id" = c."user_id"
WHERE  o."created_at" >= 1580515200000000
  AND  o."created_at" <  1609459200000000
