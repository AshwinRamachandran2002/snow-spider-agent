--Description:  One-shot query that calculates the proportion of Jan-2020 cohort users who returned in each remaining month of 2020 (retention table).  
WITH jan20_cohort AS (
    SELECT DISTINCT "user_id"
    FROM (
            SELECT 
                "user_id",
                MIN( TO_DATE( TO_TIMESTAMP_NTZ("created_at" / 1000000) ) ) AS "first_purchase_date"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
            GROUP BY "user_id"
         )
    WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
), cohort_size AS (
    SELECT COUNT(*) AS "total_users" FROM jan20_cohort
)
SELECT 
    TO_CHAR( TO_DATE( TO_TIMESTAMP_NTZ(o."created_at" / 1000000) ), 'YYYY-MM' )  AS "order_month",
    COUNT(DISTINCT o."user_id")                                                 AS "active_users",
    s."total_users",
    ROUND( COUNT(DISTINCT o."user_id") / s."total_users", 4 )                   AS "retention_rate"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN jan20_cohort c
  ON o."user_id" = c."user_id"
CROSS JOIN cohort_size s
WHERE TO_DATE( TO_TIMESTAMP_NTZ(o."created_at" / 1000000) )
      BETWEEN '2020-02-01' AND '2020-12-31'
GROUP BY "order_month", s."total_users"
ORDER BY "order_month"
LIMIT 20;
