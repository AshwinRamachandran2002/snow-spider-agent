```sql
--Description:  For the Jan-2020 cohort, show how many of them placed an order in each later month of 2020.  
WITH jan20_cohort AS (
    SELECT DISTINCT "user_id"
    FROM (
            SELECT 
                "user_id",
                MIN( TO_DATE( TO_TIMESTAMP_NTZ("created_at" / 1000000) ) ) AS "first_purchase_date"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
            GROUP BY "user_id"
         )
    WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
)
SELECT 
    TO_CHAR( TO_DATE( TO_TIMESTAMP_NTZ(o."created_at" / 1000000) ), 'YYYY-MM' ) AS "order_month",
    COUNT( DISTINCT o."user_id")                                           AS "active_users"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN jan20_cohort c
  ON o."user_id" = c."user_id"
WHERE TO_DATE( TO_TIMESTAMP_NTZ(o."created_at" / 1000000) )
      BETWEEN '2020-02-01' AND '2020-12-31'
GROUP BY "order_month"
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description:  Retrieve both the cohort size and the monthly active-user counts so a retention rate can be computed.  
WITH jan20_cohort AS (
    SELECT DISTINCT "user_id"
    FROM (
            SELECT 
                "user_id",
                MIN( TO_DATE( TO_TIMESTAMP_NTZ("created_at" / 1000000) ) ) AS "first_purchase_date"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
            GROUP BY "user_id"
         )
    WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
), cohort_size AS (
    SELECT COUNT(*) AS "total_users" FROM jan20_cohort
)
SELECT 
    TO_CHAR( TO_DATE( TO_TIMESTAMP_NTZ(o."created_at" / 1000000) ), 'YYYY-MM' ) AS "order_month",
    COUNT( DISTINCT o."user_id")                                               AS "active_users",
    s."total_users",
    ROUND( COUNT(DISTINCT o."user_id") / s."total_users", 4 )                  AS "retention_rate"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN jan20_cohort c
  ON o."user_id" = c."user_id"
CROSS JOIN cohort_size s        -- brings in total cohort size
WHERE TO_DATE( TO_TIMESTAMP_NTZ(o."created_at" / 1000000) )
      BETWEEN '2020-02-01' AND '2020-12-31'
GROUP BY "order_month", s."total_users"
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description:  Inspect a sample of the Jan-2020 cohort users and their demographic data.  
SELECT 
    u."id"          AS "user_id",
    u."first_name",
    u."last_name",
    u."gender",
    u."age",
    u."country"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS u
JOIN (
        SELECT DISTINCT "user_id"
        FROM (
                SELECT 
                    "user_id",
                    MIN( TO_DATE( TO_TIMESTAMP_NTZ("created_at" / 1000000) ) ) AS "first_purchase_date"
                FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
                GROUP BY "user_id"
             )
        WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
     ) c
  ON u."id" = c."user_id"
LIMIT 20;
```

```sql
--Description:  Look at all 2020 orders for a few Jan-2020 cohort users to validate behavior.  
SELECT 
    o."order_id",
    o."user_id",
    TO_DATE( TO_TIMESTAMP_NTZ(o."created_at" / 1000000) )  AS "order_date",
    o."status",
    o."num_of_item"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
WHERE o."user_id" IN (
        SELECT "user_id" 
        FROM (
                SELECT DISTINCT "user_id"
                FROM (
                        SELECT 
                            "user_id",
                            MIN( TO_DATE( TO_TIMESTAMP_NTZ("created_at" / 1000000) ) ) AS "first_purchase_date"
                        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
                        GROUP BY "user_id"
                     )
                WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
                LIMIT 5                      -- small sample
             )
     )
ORDER BY o."user_id", o."created_at"
LIMIT 20;
```

```sql
--Description:  Bridge orders to order-items for the Jan-2020 cohort to confirm purchase linkage.  
SELECT 
    oi."order_id",
    oi."user_id",
    oi."product_id",
    oi."status",
    TO_DATE( TO_TIMESTAMP_NTZ(oi."created_at" / 1000000) ) AS "item_order_date",
    oi."sale_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
WHERE oi."user_id" IN (
        SELECT DISTINCT "user_id"
        FROM (
                SELECT 
                    "user_id",
                    MIN( TO_DATE( TO_TIMESTAMP_NTZ("created_at" / 1000000) ) ) AS "first_date"
                FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
                GROUP BY "user_id"
             )
        WHERE "first_date" BETWEEN '2020-01-01' AND '2020-01-31'
     )
LIMIT 20;
```

```sql
--Description:  One-shot query that calculates the proportion of Jan-2020 cohort users who returned in each remaining month of 2020 (retention table).  
WITH jan20_cohort AS (
    SELECT DISTINCT "user_id"
    FROM (
            SELECT 
                "user_id",
                MIN( TO_DATE( TO_TIMESTAMP_NTZ("created_at" / 1000000) ) ) AS "first_purchase_date"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
            GROUP BY "user_id"
         )
    WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
), cohort_size AS (
    SELECT COUNT(*) AS "total_users" FROM jan20_cohort
)
SELECT 
    TO_CHAR( TO_DATE( TO_TIMESTAMP_NTZ(o."created_at" / 1000000) ), 'YYYY-MM' )  AS "order_month",
    COUNT(DISTINCT o."user_id")                                                 AS "active_users",
    s."total_users",
    ROUND( COUNT(DISTINCT o."user_id") / s."total_users", 4 )                   AS "retention_rate"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN jan20_cohort c
  ON o."user_id" = c."user_id"
CROSS JOIN cohort_size s
WHERE TO_DATE( TO_TIMESTAMP_NTZ(o."created_at" / 1000000) )
      BETWEEN '2020-02-01' AND '2020-12-31'
GROUP BY "order_month", s."total_users"
ORDER BY "order_month"
LIMIT 20;
```
