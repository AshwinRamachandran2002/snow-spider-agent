Query:
--Description: For each 2020 month after January, compute the proportion of the cohort that returned.
WITH jan20_cohort AS (
  SELECT  "user_id"
  FROM    (
           SELECT "user_id",
                  MIN(TO_TIMESTAMP_NTZ("created_at"/1000000)) AS "first_purchase_ts"
           FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
           GROUP BY "user_id"
          )
  WHERE   "first_purchase_ts" BETWEEN '2020-01-01' AND '2020-01-31 23:59:59'
),
cohort_size AS (
  SELECT COUNT(DISTINCT "user_id") AS "total_users" FROM jan20_cohort
),
orders_2020 AS (
  SELECT  o."user_id",
          TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000),'YYYY-MM') AS "order_month"
  FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  WHERE   TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000),'YYYY') = '2020'
    AND   TO_TIMESTAMP_NTZ(o."created_at"/1000000) > '2020-01-31 23:59:59'
)
SELECT  o."order_month",
        COUNT(DISTINCT o."user_id")      AS "returning_users",
        cs."total_users",
        COUNT(DISTINCT o."user_id") / cs."total_users" AS "proportion_returned"
FROM    orders_2020 o
JOIN    jan20_cohort c
   ON   o."user_id" = c."user_id"
CROSS JOIN cohort_size cs
GROUP BY o."order_month", cs."total_users"
ORDER BY o."order_month"
LIMIT 20;
