LIMIT 20;
```

```sql
--Description: Show the distinct year-month buckets in which orders were created (helps confirm 2020 data exists).
SELECT  DISTINCT 
        TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1000000),'YYYY-MM') AS "order_month"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
ORDER BY 1
LIMIT 20;
```

```sql
--Description: For every shopper, find their first-ever purchase timestamp (using the minimum order created_at).
SELECT  "user_id",
        MIN(TO_TIMESTAMP_NTZ("created_at"/1000000)) AS "first_purchase_ts"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
GROUP BY "user_id"
LIMIT 20;
```

```sql
--Description: Isolate the cohort whose very first purchase happened during January 2020.
WITH first_buy AS (
  SELECT  "user_id",
          MIN(TO_TIMESTAMP_NTZ("created_at"/1000000)) AS "first_purchase_ts"
  FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
)
SELECT  *
FROM    first_buy
WHERE   "first_purchase_ts" BETWEEN '2020-01-01' AND '2020-01-31 23:59:59'
LIMIT 20;
```

```sql
--Description: Count how many unique customers belong to the January 2020 first-purchase cohort.
WITH first_buy AS (
  SELECT  "user_id",
          MIN(TO_TIMESTAMP_NTZ("created_at"/1000000)) AS "first_purchase_ts"
  FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
)
SELECT  COUNT(DISTINCT "user_id") AS "jan2020_new_users"
FROM    first_buy
WHERE   "first_purchase_ts" BETWEEN '2020-01-01' AND '2020-01-31 23:59:59'
LIMIT 20;
```

```sql
--Description: Retrieve every order (after January 2020) placed in 2020 by users from that cohort.
WITH jan20_cohort AS (
  SELECT  "user_id"
  FROM    (
           SELECT "user_id",
                  MIN(TO_TIMESTAMP_NTZ("created_at"/1000000)) AS "first_purchase_ts"
           FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
           GROUP BY "user_id"
          )
  WHERE   "first_purchase_ts" BETWEEN '2020-01-01' AND '2020-01-31 23:59:59'
)
SELECT  DISTINCT 
        o."user_id",
        TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000),'YYYY-MM') AS "order_month"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN    jan20_cohort c
   ON   o."user_id" = c."user_id"
WHERE   TO_TIMESTAMP_NTZ(o."created_at"/1000000) >  '2020-01-31 23:59:59'
  AND   TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000),'YYYY') = '2020'
LIMIT 20;
```

```sql
--Description: Count how many distinct cohort users placed an order in each subsequent 2020 month.
WITH jan20_cohort AS (
  SELECT  "user_id"
  FROM    (
           SELECT "user_id",
                  MIN(TO_TIMESTAMP_NTZ("created_at"/1000000)) AS "first_purchase_ts"
           FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
           GROUP BY "user_id"
          )
  WHERE   "first_purchase_ts" BETWEEN '2020-01-01' AND '2020-01-31 23:59:59'
),
orders_2020 AS (
  SELECT  o."user_id",
          TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000),'YYYY-MM') AS "order_month"
  FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  WHERE   TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000),'YYYY') = '2020'
)
SELECT  o."order_month",
        COUNT(DISTINCT o."user_id") AS "returning_users"
FROM    orders_2020 o
JOIN    jan20_cohort c
   ON   o."user_id" = c."user_id"
WHERE   o."order_month" > '2020-01'      -- exclude the cohort month itself
GROUP BY o."order_month"
ORDER BY o."order_month"
LIMIT 20;
```

```sql
--Description: For each 2020 month after January, compute the proportion of the cohort that returned.
WITH jan20_cohort AS (
  SELECT  "user_id"
  FROM    (
           SELECT "user_id",
                  MIN(TO_TIMESTAMP_NTZ("created_at"/1000000)) AS "first_purchase_ts"
           FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
           GROUP BY "user_id"
          )
  WHERE   "first_purchase_ts" BETWEEN '2020-01-01' AND '2020-01-31 23:59:59'
),
cohort_size AS (
  SELECT COUNT(DISTINCT "user_id") AS "total_users" FROM jan20_cohort
),
orders_2020 AS (
  SELECT  o."user_id",
          TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000),'YYYY-MM') AS "order_month"
  FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  WHERE   TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000),'YYYY') = '2020'
    AND   TO_TIMESTAMP_NTZ(o."created_at"/1000000) > '2020-01-31 23:59:59'
)
SELECT  o."order_month",
        COUNT(DISTINCT o."user_id")      AS "returning_users",
        cs."total_users",
        COUNT(DISTINCT o."user_id") / cs."total_users" AS "proportion_returned"
FROM    orders_2020 o
JOIN    jan20_cohort c
   ON   o."user_id" = c."user_id"
CROSS JOIN cohort_size cs
GROUP BY o."order_month", cs."total_users"
ORDER BY o."order_month"
LIMIT 20;
```

