Query:
--Description: Count how many unique customers belong to the January 2020 first-purchase cohort.
WITH first_buy AS (
  SELECT  "user_id",
          MIN(TO_TIMESTAMP_NTZ("created_at"/1000000)) AS "first_purchase_ts"
  FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
)
SELECT  COUNT(DISTINCT "user_id") AS "jan2020_new_users"
FROM    first_buy
WHERE   "first_purchase_ts" BETWEEN '2020-01-01' AND '2020-01-31 23:59:59'
LIMIT 20;
