Query:
--Description: Count how many distinct cohort users placed an order in each subsequent 2020 month.
WITH jan20_cohort AS (
  SELECT  "user_id"
  FROM    (
           SELECT "user_id",
                  MIN(TO_TIMESTAMP_NTZ("created_at"/1000000)) AS "first_purchase_ts"
           FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
           GROUP BY "user_id"
          )
  WHERE   "first_purchase_ts" BETWEEN '2020-01-01' AND '2020-01-31 23:59:59'
),
orders_2020 AS (
  SELECT  o."user_id",
          TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000),'YYYY-MM') AS "order_month"
  FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  WHERE   TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000),'YYYY') = '2020'
)
SELECT  o."order_month",
        COUNT(DISTINCT o."user_id") AS "returning_users"
FROM    orders_2020 o
JOIN    jan20_cohort c
   ON   o."user_id" = c."user_id"
WHERE   o."order_month" > '2020-01'      -- exclude the cohort month itself
GROUP BY o."order_month"
ORDER BY o."order_month"
LIMIT 20;
