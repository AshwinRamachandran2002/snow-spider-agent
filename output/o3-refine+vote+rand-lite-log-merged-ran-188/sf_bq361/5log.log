Query:
--Description: View demographic snapshot (age, gender, country) of the January 2020 cohort users  
SELECT 
  u."id"          AS "user_id",
  u."age",
  u."gender",
  u."country",
  u."state",
  u."created_at"  AS "user_created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u
JOIN (
  SELECT "user_id"
  FROM (
    SELECT "user_id", MIN("created_at") AS "first_order_ts"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  ) s
  WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515199000000
) cohort
ON u."id" = cohort."user_id"
LIMIT 20;
