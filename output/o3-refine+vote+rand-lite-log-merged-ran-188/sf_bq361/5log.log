Query:
--Description: Bring total cohort size alongside monthly returning‐user counts to compute proportions  
SELECT 
  m."order_month",
  m."active_users",
  c."cohort_size",
  m."active_users" / c."cohort_size" AS "returning_prop"
FROM (
  SELECT 
    DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at"/1e6)) AS "order_month",
    COUNT(DISTINCT o."user_id")                              AS "active_users"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
  JOIN (
    SELECT "user_id"
    FROM (
      SELECT "user_id", MIN("created_at") AS "first_order_ts"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
      GROUP BY "user_id"
    ) s
    WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515199000000
  ) cohort
  ON o."user_id" = cohort."user_id"
  WHERE o."created_at" BETWEEN 1577836800000000 AND 1609459199000000
  GROUP BY 1
) m
CROSS JOIN (
  SELECT COUNT(*) AS "cohort_size"
  FROM (
    SELECT "user_id"
    FROM (
      SELECT "user_id", MIN("created_at") AS "first_order_ts"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
      GROUP BY "user_id"
    ) s
    WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515199000000
  )
) c
ORDER BY 1
LIMIT 20;
