```sql
--Description: Sample any “ORDERS” records whose “created_at” timestamp falls inside January 2020  
SELECT 
  "order_id",
  "user_id",
  "status",
  "created_at",
  "shipped_at",
  "delivered_at",
  "returned_at",
  "num_of_item"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "created_at" BETWEEN 1577836800000000 AND 1580515199000000   -- 01-Jan-2020 00:00:00  → 31-Jan-2020 23:59:59 (µs)
LIMIT 20;
```

```sql
--Description: Distinct set of users who placed at least one order in January 2020  
SELECT DISTINCT 
  "user_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "created_at" BETWEEN 1577836800000000 AND 1580515199000000
LIMIT 20;
```

```sql
--Description: For every user, pull their first‐ever order date (earliest “created_at”)  
SELECT 
  "user_id",
  MIN("created_at") AS "first_order_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
GROUP BY "user_id"
ORDER BY "first_order_ts"
LIMIT 20;
```

```sql
--Description: Identify the January 2020 cohort – users whose first purchase fell in January 2020  
SELECT 
  "user_id",
  "first_order_ts"
FROM (
  SELECT 
    "user_id",
    MIN("created_at") AS "first_order_ts"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
) t
WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515199000000
LIMIT 20;
```

```sql
--Description: Monthly count of orders throughout 2020 for users in the January 2020 cohort  
SELECT 
  DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at"/1e6)) AS "order_month",
  COUNT(*)                                            AS "order_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"    o
JOIN (
  SELECT 
    "user_id"
  FROM (
    SELECT "user_id", MIN("created_at") AS "first_order_ts"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  ) s
  WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515199000000
) cohort
ON o."user_id" = cohort."user_id"
WHERE o."created_at" BETWEEN 1577836800000000 AND 1609459199000000   -- full year 2020
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Distinct count of cohort users who placed ≥1 order in each month of 2020  
SELECT 
  DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at"/1e6)) AS "order_month",
  COUNT(DISTINCT o."user_id")                              AS "active_users"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
JOIN (
  SELECT "user_id"
  FROM (
    SELECT "user_id", MIN("created_at") AS "first_order_ts"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  ) s
  WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515199000000
) cohort
ON o."user_id" = cohort."user_id"
WHERE o."created_at" BETWEEN 1577836800000000 AND 1609459199000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Bring total cohort size alongside monthly returning‐user counts to compute proportions  
SELECT 
  m."order_month",
  m."active_users",
  c."cohort_size",
  m."active_users" / c."cohort_size" AS "returning_prop"
FROM (
  SELECT 
    DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at"/1e6)) AS "order_month",
    COUNT(DISTINCT o."user_id")                              AS "active_users"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"          o
  JOIN (
    SELECT "user_id"
    FROM (
      SELECT "user_id", MIN("created_at") AS "first_order_ts"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
      GROUP BY "user_id"
    ) s
    WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515199000000
  ) cohort
  ON o."user_id" = cohort."user_id"
  WHERE o."created_at" BETWEEN 1577836800000000 AND 1609459199000000
  GROUP BY 1
) m
CROSS JOIN (
  SELECT COUNT(*) AS "cohort_size"
  FROM (
    SELECT "user_id"
    FROM (
      SELECT "user_id", MIN("created_at") AS "first_order_ts"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
      GROUP BY "user_id"
    ) s
    WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515199000000
  )
) c
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Inspect “ORDER_ITEMS” linked to January 2020 cohort to ensure item‐level status coverage  
SELECT 
  oi."order_id",
  oi."product_id",
  oi."status",
  oi."sale_price",
  oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN (
  SELECT "order_id"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  WHERE "created_at" BETWEEN 1577836800000000 AND 1580515199000000
) jan_orders
ON oi."order_id" = jan_orders."order_id"
LIMIT 20;
```

```sql
--Description: Check if any cohort orders were later returned (non-NULL “returned_at”)  
SELECT 
  "order_id",
  "user_id",
  "status",
  "created_at",
  "returned_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "returned_at" IS NOT NULL
  AND "user_id" IN (
        SELECT "user_id"
        FROM (
          SELECT "user_id", MIN("created_at") AS "first_order_ts"
          FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
          GROUP BY "user_id"
        ) s
        WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515199000000
      )
LIMIT 20;
```

```sql
--Description: View demographic snapshot (age, gender, country) of the January 2020 cohort users  
SELECT 
  u."id"          AS "user_id",
  u."age",
  u."gender",
  u."country",
  u."state",
  u."created_at"  AS "user_created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u
JOIN (
  SELECT "user_id"
  FROM (
    SELECT "user_id", MIN("created_at") AS "first_order_ts"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  ) s
  WHERE "first_order_ts" BETWEEN 1577836800000000 AND 1580515199000000
) cohort
ON u."id" = cohort."user_id"
LIMIT 20;
```
