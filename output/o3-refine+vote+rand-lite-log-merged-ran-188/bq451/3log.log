```sql
-- 4. Description: Show how long the genotype array is for male/female
SELECT  c.`call_set_name`,
        ARRAY_LENGTH(c.`genotype`) AS gt_len,
        c.`genotype`
FROM    `spider2-public-data.1000_genomes.variants` v,
        UNNEST(v.`call`) c
WHERE   v.`reference_name` = 'X'
  AND NOT (v.`start` BETWEEN 59999      AND 2699519
           OR v.`start` BETWEEN 154931042 AND 155260559 )
LIMIT 20;
```

```sql
-- 5. Description: Classify each genotype row into hom-ref / hom-alt / het
--    (for a small sample)
SELECT  c.`call_set_name`,
        c.`genotype`,
        CASE
          WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) a)=1
               AND (SELECT ANY_VALUE(a)  FROM UNNEST(c.genotype) a)=0
          THEN 'hom_ref'
          WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) a)=1
               AND (SELECT ANY_VALUE(a)  FROM UNNEST(c.genotype) a) > 0
          THEN 'hom_alt'
          WHEN (SELECT MAX(a) FROM UNNEST(c.genotype) a) > 0
          THEN 'het'
          ELSE 'uncallable'
        END AS gt_class
FROM    `spider2-public-data.1000_genomes.variants` v,
        UNNEST(v.`call`) c
WHERE   v.`reference_name` = 'X'
  AND NOT (v.`start` BETWEEN 59999      AND 2699519
           OR v.`start` BETWEEN 154931042 AND 155260559 )
  AND ARRAY_LENGTH(c.genotype) > 0
LIMIT 20;
```

```sql
-- 6. Description: Count the three genotype categories for a handful of
--    samples (quick check)
SELECT  c.`call_set_name` AS sample_id,
        SUM(gt_class='hom_ref') AS hom_ref,
        SUM(gt_class='hom_alt') AS hom_alt,
        SUM(gt_class='het')     AS het
FROM (
  SELECT  c.`call_set_name`,
          CASE
            WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) a)=1
                 AND (SELECT ANY_VALUE(a)  FROM UNNEST(c.genotype) a)=0
            THEN 'hom_ref'
            WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) a)=1
                 AND (SELECT ANY_VALUE(a)  FROM UNNEST(c.genotype) a) > 0
            THEN 'hom_alt'
            WHEN (SELECT MAX(a) FROM UNNEST(c.genotype) a) > 0
            THEN 'het'
            ELSE 'uncallable'
          END AS gt_class
  FROM    `spider2-public-data.1000_genomes.variants` v,
          UNNEST(v.`call`) c
  WHERE   v.`reference_name` = 'X'
    AND NOT (v.`start` BETWEEN 59999      AND 2699519
             OR v.`start` BETWEEN 154931042 AND 155260559 )
    AND ARRAY_LENGTH(c.genotype) > 0
) GROUP BY sample_id
LIMIT 20;
```

```sql
-- 7. Description: Produce the final requested statistics for every sample
SELECT
  sample_id,
  callable_sites,
  hom_ref,
  hom_alt,
  het,
  snv_sites,
  ROUND(100 * het      / snv_sites, 2) AS pct_het_among_snv,
  ROUND(100 * hom_alt  / snv_sites, 2) AS pct_hom_alt_among_snv
FROM (
  SELECT
    c.`call_set_name`                           AS sample_id,
    COUNT(*)                                    AS callable_sites,
    SUM(hom_ref)                                AS hom_ref,
    SUM(hom_alt)                                AS hom_alt,
    SUM(het)                                    AS het,
    SUM(hom_alt) + SUM(het)                     AS snv_sites
  FROM (
    SELECT
      c.`call_set_name`,
      -- Boolean flags for each genotype class
      CASE
        WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) a)=1
             AND (SELECT ANY_VALUE(a)  FROM UNNEST(c.genotype) a)=0
        THEN 1 ELSE 0 END AS hom_ref,
      CASE
        WHEN (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) a)=1
             AND (SELECT ANY_VALUE(a)  FROM UNNEST(c.genotype) a) > 0
        THEN 1 ELSE 0 END AS hom_alt,
      CASE
        WHEN (SELECT MAX(a) FROM UNNEST(c.genotype) a) > 0
             AND (SELECT COUNT(DISTINCT a) FROM UNNEST(c.genotype) a) > 1
          OR (ARRAY_LENGTH(c.genotype)=1 AND (SELECT MAX(a) FROM UNNEST(c.genotype) a)>0)
        THEN 1 ELSE 0 END AS het
    FROM   `spider2-public-data.1000_genomes.variants` v,
           UNNEST(v.`call`) c
    WHERE  v.`reference_name` = 'X'
      AND NOT (v.`start` BETWEEN 59999      AND 2699519
               OR v.`start` BETWEEN 154931042 AND 155260559 )
      AND ARRAY_LENGTH(c.genotype) > 0          -- Only genotype-defined calls
  )
  GROUP BY sample_id
)
ORDER BY pct_het_among_snv DESC, sample_id;
```
