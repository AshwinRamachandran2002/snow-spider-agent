  AND ARRAY_LENGTH(alternate_bases) = 1
  AND LENGTH(alternate_bases[OFFSET(0)]) = 1
LIMIT 20;
```

```sql
-- 4. Quickly count how many genotype arrays are empty or non-empty
SELECT
  ARRAY_LENGTH(c.genotype)                   AS alleles_in_array,
  COUNT(*)                                   AS rows
FROM `spider2-public-data.1000_genomes.variants`,
     UNNEST(call) AS c
WHERE reference_name = 'X'
  AND start NOT BETWEEN  59999      AND 2699519
  AND start NOT BETWEEN 154931042   AND 155260559
  AND LENGTH(reference_bases) = 1
  AND ARRAY_LENGTH(alternate_bases) = 1
  AND LENGTH(alternate_bases[OFFSET(0)]) = 1
GROUP BY alleles_in_array
ORDER BY alleles_in_array;
```

```sql
-- 5. Classify a handful of genotype calls into the three categories
SELECT
  c.call_set_name                                            AS sample,
  c.genotype                                                 AS geno,
  CASE
    WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT g FROM UNNEST(c.genotype) g)) = 1
         AND (SELECT DISTINCT g FROM UNNEST(c.genotype) g)[OFFSET(0)] = 0
      THEN 'homo_ref'
    WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT g FROM UNNEST(c.genotype) g)) = 1
         AND (SELECT DISTINCT g FROM UNNEST(c.genotype) g)[OFFSET(0)]  > 0
      THEN 'homo_alt'
    ELSE 'hetero'
  END                                                        AS class
FROM `spider2-public-data.1000_genomes.variants`,
     UNNEST(call) AS c
WHERE reference_name = 'X'
  AND start NOT BETWEEN  59999      AND 2699519
  AND start NOT BETWEEN 154931042   AND 155260559
  AND LENGTH(reference_bases) = 1
  AND ARRAY_LENGTH(alternate_bases) = 1
  AND LENGTH(alternate_bases[OFFSET(0)]) = 1
  AND ARRAY_LENGTH(c.genotype) > 0
LIMIT 20;
```

```sql
-- 6. Aggregate counts of each genotype class for a few samples
SELECT
  sample,
  SUM(class = 'homo_ref')  AS homo_ref_cnt,
  SUM(class = 'homo_alt')  AS homo_alt_cnt,
  SUM(class = 'hetero')    AS hetero_cnt
FROM (
  SELECT
    c.call_set_name AS sample,
    CASE
      WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT g FROM UNNEST(c.genotype) g)) = 1
           AND (SELECT DISTINCT g FROM UNNEST(c.genotype) g)[OFFSET(0)] = 0
        THEN 'homo_ref'
      WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT g FROM UNNEST(c.genotype) g)) = 1
           AND (SELECT DISTINCT g FROM UNNEST(c.genotype) g)[OFFSET(0)]  > 0
        THEN 'homo_alt'
      ELSE 'hetero'
    END AS class
  FROM `spider2-public-data.1000_genomes.variants`,
       UNNEST(call) AS c
  WHERE reference_name = 'X'
    AND start NOT BETWEEN  59999      AND 2699519
    AND start NOT BETWEEN 154931042   AND 155260559
    AND LENGTH(reference_bases) = 1
    AND ARRAY_LENGTH(alternate_bases) = 1
    AND LENGTH(alternate_bases[OFFSET(0)]) = 1
    AND ARRAY_LENGTH(c.genotype) > 0
)
GROUP BY sample
LIMIT 20;
```

```sql
-- 7. Add totals, number of callable sites, SNVs and percentages
SELECT
  sample,
  homo_ref_cnt,
  homo_alt_cnt,
  hetero_cnt,
  (homo_ref_cnt + homo_alt_cnt + hetero_cnt)              AS callable_sites,
  (homo_alt_cnt + hetero_cnt)                             AS snv_cnt,
  SAFE_DIVIDE(hetero_cnt , (homo_alt_cnt + hetero_cnt)) * 100 AS pct_het_in_snvs,
  SAFE_DIVIDE(homo_alt_cnt, (homo_alt_cnt + hetero_cnt)) * 100 AS pct_hom_alt_in_snvs
FROM (
  -- re-use query #6 but without LIMIT
  SELECT
    sample,
    SUM(class = 'homo_ref')  AS homo_ref_cnt,
    SUM(class = 'homo_alt')  AS homo_alt_cnt,
    SUM(class = 'hetero')    AS hetero_cnt
  FROM (
    SELECT
      c.call_set_name AS sample,
      CASE
        WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT g FROM UNNEST(c.genotype) g)) = 1
             AND (SELECT DISTINCT g FROM UNNEST(c.genotype) g)[OFFSET(0)] = 0
          THEN 'homo_ref'
        WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT g FROM UNNEST(c.genotype) g)) = 1
             AND (SELECT DISTINCT g FROM UNNEST(c.genotype) g)[OFFSET(0)]  > 0
          THEN 'homo_alt'
        ELSE 'hetero'
      END AS class
    FROM `spider2-public-data.1000_genomes.variants`,
         UNNEST(call) AS c
    WHERE reference_name = 'X'
      AND start NOT BETWEEN  59999      AND 2699519
      AND start NOT BETWEEN 154931042   AND 155260559
      AND LENGTH(reference_bases) = 1
      AND ARRAY_LENGTH(alternate_bases) = 1
      AND LENGTH(alternate_bases[OFFSET(0)]) = 1
      AND ARRAY_LENGTH(c.genotype) > 0
  )
  GROUP BY sample
)
LIMIT 20;
```

```sql
-- 8. Join the above counts with sample-level meta-data (optional exploration)
SELECT
  s.Sample                            AS sample_id,
  s.Gender,
  agg.callable_sites,
  agg.snv_cnt,
  agg.pct_het_in_snvs
FROM (
  -- query #7 without LIMIT
  SELECT
    sample,
    (homo_ref_cnt + homo_alt_cnt + hetero_cnt)              AS callable_sites,
    (homo_alt_cnt + hetero_cnt)                             AS snv_cnt,
    SAFE_DIVIDE(hetero_cnt , (homo_alt_cnt + hetero_cnt)) * 100 AS pct_het_in_snvs
  FROM (
    -- inner aggregation (same as #7)
    SELECT
      sample,
      SUM(class = 'homo_ref')  AS homo_ref_cnt,
      SUM(class = 'homo_alt')  AS homo_alt_cnt,
      SUM(class = 'hetero')    AS hetero_cnt
    FROM (
      SELECT
        c.call_set_name AS sample,
        CASE
          WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT g FROM UNNEST(c.genotype) g)) = 1
               AND (SELECT DISTINCT g FROM UNNEST(c.genotype) g)[OFFSET(0)] = 0
            THEN 'homo_ref'
          WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT g FROM UNNEST(c.genotype) g)) = 1
               AND (SELECT DISTINCT g FROM UNNEST(c.genotype) g)[OFFSET(0)]  > 0
            THEN 'homo_alt'
          ELSE 'hetero'
        END AS class
      FROM `spider2-public-data.1000_genomes.variants`,
           UNNEST(call) AS c
      WHERE reference_name = 'X'
        AND start NOT BETWEEN  59999      AND 2699519
        AND start NOT BETWEEN 154931042   AND 155260559
        AND LENGTH(reference_bases) = 1
        AND ARRAY_LENGTH(alternate_bases) = 1
        AND LENGTH(alternate_bases[OFFSET(0)]) = 1
        AND ARRAY_LENGTH(c.genotype) > 0
    )
    GROUP BY sample
  )
) AS agg
JOIN `spider2-public-data.1000_genomes.sample_info`   AS s
ON agg.sample = s.Sample
LIMIT 20;
```

```sql
-- 9. FINAL ANSWER:  full computation with ordering required
SELECT
  sample                                                  AS sample_id,
  callable_sites,
  homo_ref_cnt,
  homo_alt_cnt,
  hetero_cnt,
  snv_cnt,
  ROUND(pct_het_in_snvs,      2) AS pct_hetero_snvs,
  ROUND(pct_hom_alt_in_snvs,  2) AS pct_hom_alt_snvs
FROM (
  SELECT
    sample,
    SUM(class = 'homo_ref')                    AS homo_ref_cnt,
    SUM(class = 'homo_alt')                    AS homo_alt_cnt,
    SUM(class = 'hetero')                      AS hetero_cnt,
    COUNT(*)                                   AS callable_sites,
    SUM(class IN ('homo_alt','hetero'))        AS snv_cnt,
    SAFE_DIVIDE(SUM(class = 'hetero'),
                SUM(class IN ('homo_alt','hetero'))) * 100  AS pct_het_in_snvs,
    SAFE_DIVIDE(SUM(class = 'homo_alt'),
                SUM(class IN ('homo_alt','hetero'))) * 100  AS pct_hom_alt_in_snvs
  FROM (
    SELECT
      c.call_set_name AS sample,
      CASE
        WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT g FROM UNNEST(c.genotype) g)) = 1
             AND (SELECT DISTINCT g FROM UNNEST(c.genotype) g)[OFFSET(0)] = 0
          THEN 'homo_ref'
        WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT g FROM UNNEST(c.genotype) g)) = 1
             AND (SELECT DISTINCT g FROM UNNEST(c.genotype) g)[OFFSET(0)]  > 0
          THEN 'homo_alt'
        ELSE 'hetero'
      END AS class
    FROM `spider2-public-data.1000_genomes.variants`,
         UNNEST(call) AS c
    WHERE reference_name = 'X'
      AND start NOT BETWEEN  59999      AND 2699519
      AND start NOT BETWEEN 154931042   AND 155260559
      -- keep only SNPs
      AND LENGTH(reference_bases) = 1
      AND ARRAY_LENGTH(alternate_bases) = 1
      AND LENGTH(alternate_bases[OFFSET(0)]) = 1
      AND ARRAY_LENGTH(c.genotype) > 0            -- genotype present
  )
  GROUP BY sample
)
ORDER BY pct_hetero_snvs DESC, sample_id;
```

These nine queries move from simple inspection of the data to the complete solution that returns, for every sample, the required counts and percentages, ordered by the percentage of heterozygous genotype calls among all single-nucleotide variants.
