```sql
--Description: Build the full answer in one step on the available table
--`spider2-public-data.1000_genomes.variants`.
--1) Keep chromosome-X records but discard both pseudo-autosomal regions (PAR1, PAR2).
--2) Retain true SNPs only: single-base reference, exactly one single-base alternate.
--3) Ignore calls where the genotype array is empty (non-callable).
--4) For every remaining call, classify the genotype:
--      homo_ref  – both alleles present and all are 0,
--      homo_alt  – both alleles present, identical, and >0,
--      hetero    – anything else (different alleles or includes −1 for missing) with ≥1 allele >0.
--5) Aggregate counts per sample:
--      callable_sites  = homo_ref + homo_alt + hetero
--      snv_cnt         = homo_alt + hetero
--      pct_hetero_snvs = hetero / snv_cnt * 100
--      pct_hom_alt_snvs= homo_alt / snv_cnt * 100
--6) Order by pct_hetero_snvs descending, then sample id (alphabetical).

WITH classified AS (
  SELECT
    c.call_set_name AS sample,
    CASE
      WHEN ARRAY_LENGTH(c.genotype) = 0 THEN NULL                         -- uncallable
      -- deduplicate allele values in this genotype
      WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT g FROM UNNEST(c.genotype) g)) = 1
           AND (SELECT DISTINCT g FROM UNNEST(c.genotype) g)[OFFSET(0)] = 0
        THEN 'homo_ref'
      WHEN ARRAY_LENGTH(ARRAY(SELECT DISTINCT g FROM UNNEST(c.genotype) g)) = 1
           AND (SELECT DISTINCT g FROM UNNEST(c.genotype) g)[OFFSET(0)]  > 0
        THEN 'homo_alt'
      ELSE 'hetero'
    END AS class
  FROM `spider2-public-data.1000_genomes.variants`,
       UNNEST(call) AS c
  WHERE reference_name = 'X'
    AND start NOT BETWEEN  59999      AND  2699519        -- exclude PAR1
    AND start NOT BETWEEN 154931042   AND 155260559       -- exclude PAR2
    AND LENGTH(reference_bases) = 1                       -- SNP: 1-bp ref
    AND ARRAY_LENGTH(alternate_bases) = 1                 -- exactly one alt allele
    AND LENGTH(alternate_bases[OFFSET(0)]) = 1            -- SNP: 1-bp alt
    AND ARRAY_LENGTH(c.genotype) > 0                      -- callable only
)

SELECT
  sample                                                    AS sample_id,
  COUNT(*)                                                  AS callable_sites,
  SUM(class = 'homo_ref')                                   AS homo_ref_cnt,
  SUM(class = 'homo_alt')                                   AS homo_alt_cnt,
  SUM(class = 'hetero')                                     AS hetero_cnt,
  SUM(class IN ('homo_alt','hetero'))                       AS snv_cnt,
  ROUND(100 * SAFE_DIVIDE(SUM(class = 'hetero'),
                          NULLIF(SUM(class IN ('homo_alt','hetero')),0)), 2)
      AS pct_hetero_snvs,
  ROUND(100 * SAFE_DIVIDE(SUM(class = 'homo_alt'),
                          NULLIF(SUM(class IN ('homo_alt','hetero')),0)), 2)
      AS pct_hom_alt_snvs
FROM classified
GROUP BY sample
ORDER BY pct_hetero_snvs DESC, sample_id;
```
