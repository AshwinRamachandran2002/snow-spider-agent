```sql
--Description: List a few sample IDs together with their raw genotype arrays
--for filtered chromosome X SNPs.
SELECT
  c.call_set_name  AS sample_id,
  c.genotype       AS genotype_array
FROM
  `spider2-public-data.1000_genomes.variants`,
  UNNEST(call) AS c
WHERE
  reference_name = 'X'
  AND NOT (start BETWEEN 59999 AND 2699519)
  AND NOT (start BETWEEN 154931042 AND 155260559)
  AND LENGTH(reference_bases) = 1
  AND ARRAY_LENGTH(alternate_bases) = 1
  AND LENGTH(alternate_bases[ORDINAL(1)]) = 1
  AND ARRAY_LENGTH(c.genotype) >= 1
LIMIT 20;
```

```sql
--Description: Classify each genotype call (hom-ref, hom-alt, het) using the
--rules given in the prompt.
SELECT
  c.call_set_name AS sample_id,
  c.genotype      AS g,
  CASE
     WHEN (SELECT COUNTIF(x = 0) FROM UNNEST(c.genotype) AS x) = ARRAY_LENGTH(c.genotype)
          THEN 'HOM_REF'
     WHEN (SELECT COUNT(DISTINCT x) FROM UNNEST(c.genotype) AS x WHERE x > 0) = 1
          AND (SELECT COUNTIF(x > 0)   FROM UNNEST(c.genotype) AS x) = ARRAY_LENGTH(c.genotype)
          THEN 'HOM_ALT'
     ELSE 'HET'
  END AS genotype_type
FROM
  `spider2-public-data.1000_genomes.variants`,
  UNNEST(call) AS c
WHERE
  reference_name = 'X'
  AND NOT (start BETWEEN 59999 AND 2699519)
  AND NOT (start BETWEEN 154931042 AND 155260559)
  AND LENGTH(reference_bases) = 1
  AND ARRAY_LENGTH(alternate_bases) = 1
  AND LENGTH(alternate_bases[ORDINAL(1)]) = 1
  AND ARRAY_LENGTH(c.genotype) >= 1
LIMIT 20;
```

```sql
--Description: Aggregate counts of each genotype category per sample.
SELECT
  sample_id,
  COUNTIF(genotype_type = 'HOM_REF') AS hom_ref_ct,
  COUNTIF(genotype_type = 'HOM_ALT') AS hom_alt_ct,
  COUNTIF(genotype_type = 'HET')     AS het_ct
FROM (
  SELECT
    c.call_set_name AS sample_id,
    CASE
       WHEN (SELECT COUNTIF(x = 0) FROM UNNEST(c.genotype) AS x) = ARRAY_LENGTH(c.genotype)
            THEN 'HOM_REF'
       WHEN (SELECT COUNT(DISTINCT x) FROM UNNEST(c.genotype) AS x WHERE x > 0) = 1
            AND (SELECT COUNTIF(x > 0)   FROM UNNEST(c.genotype) AS x) = ARRAY_LENGTH(c.genotype)
            THEN 'HOM_ALT'
       ELSE 'HET'
    END AS genotype_type
  FROM
    `spider2-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  WHERE
    reference_name = 'X'
    AND NOT (start BETWEEN 59999 AND 2699519)
    AND NOT (start BETWEEN 154931042 AND 155260559)
    AND LENGTH(reference_bases) = 1
    AND ARRAY_LENGTH(alternate_bases) = 1
    AND LENGTH(alternate_bases[ORDINAL(1)]) = 1
    AND ARRAY_LENGTH(c.genotype) >= 1
)
GROUP BY sample_id
LIMIT 20;
```

```sql
--Description: Extend the aggregation to include total callable sites, total SNVs,
--and heterozygous / homozygous-alt percentages among SNVs.
SELECT
  sample_id,
  hom_ref_ct,
  hom_alt_ct,
  het_ct,
  hom_ref_ct + hom_alt_ct + het_ct AS callable_sites,
  hom_alt_ct + het_ct             AS total_snvs,
  ROUND(100 * het_ct      / NULLIF(hom_alt_ct + het_ct, 0), 2) AS pct_het_among_snvs,
  ROUND(100 * hom_alt_ct  / NULLIF(hom_alt_ct + het_ct, 0), 2) AS pct_hom_alt_among_snvs
FROM (
  SELECT
    sample_id,
    COUNTIF(genotype_type = 'HOM_REF') AS hom_ref_ct,
    COUNTIF(genotype_type = 'HOM_ALT') AS hom_alt_ct,
    COUNTIF(genotype_type = 'HET')     AS het_ct
  FROM (
    SELECT
      c.call_set_name AS sample_id,
      CASE
         WHEN (SELECT COUNTIF(x = 0) FROM UNNEST(c.genotype) AS x) = ARRAY_LENGTH(c.genotype)
              THEN 'HOM_REF'
         WHEN (SELECT COUNT(DISTINCT x) FROM UNNEST(c.genotype) AS x WHERE x > 0) = 1
              AND (SELECT COUNTIF(x > 0)   FROM UNNEST(c.genotype) AS x) = ARRAY_LENGTH(c.genotype)
              THEN 'HOM_ALT'
         ELSE 'HET'
      END AS genotype_type
    FROM
      `spider2-public-data.1000_genomes.variants`,
      UNNEST(call) AS c
    WHERE
      reference_name = 'X'
      AND NOT (start BETWEEN 59999 AND 2699519)
      AND NOT (start BETWEEN 154931042 AND 155260559)
      AND LENGTH(reference_bases) = 1
      AND ARRAY_LENGTH(alternate_bases) = 1
      AND LENGTH(alternate_bases[ORDINAL(1)]) = 1
      AND ARRAY_LENGTH(c.genotype) >= 1
  )
  GROUP BY sample_id
)
LIMIT 20;
```

```sql
--Description: Final answer – order samples by percentage of heterozygous genotype
--calls among SNVs (descending), then by sample ID.
SELECT
  sample_id,
  callable_sites,
  hom_ref_ct,
  hom_alt_ct,
  het_ct,
  total_snvs,
  pct_het_among_snvs,
  pct_hom_alt_among_snvs
FROM (
  SELECT
    sample_id,
    hom_ref_ct,
    hom_alt_ct,
    het_ct,
    hom_ref_ct + hom_alt_ct + het_ct AS callable_sites,
    hom_alt_ct + het_ct             AS total_snvs,
    ROUND(100 * het_ct     / NULLIF(hom_alt_ct + het_ct, 0), 2) AS pct_het_among_snvs,
    ROUND(100 * hom_alt_ct / NULLIF(hom_alt_ct + het_ct, 0), 2) AS pct_hom_alt_among_snvs
  FROM (
    SELECT
      sample_id,
      COUNTIF(genotype_type = 'HOM_REF') AS hom_ref_ct,
      COUNTIF(genotype_type = 'HOM_ALT') AS hom_alt_ct,
      COUNTIF(genotype_type = 'HET')     AS het_ct
    FROM (
      SELECT
        c.call_set_name AS sample_id,
        CASE
           WHEN (SELECT COUNTIF(x = 0) FROM UNNEST(c.genotype) AS x) = ARRAY_LENGTH(c.genotype)
                THEN 'HOM_REF'
           WHEN (SELECT COUNT(DISTINCT x) FROM UNNEST(c.genotype) AS x WHERE x > 0) = 1
                AND (SELECT COUNTIF(x > 0)   FROM UNNEST(c.genotype) AS x) = ARRAY_LENGTH(c.genotype)
                THEN 'HOM_ALT'
           ELSE 'HET'
        END AS genotype_type
      FROM
        `spider2-public-data.1000_genomes.variants`,
        UNNEST(call) AS c
      WHERE
        reference_name = 'X'
        AND NOT (start BETWEEN 59999 AND 2699519)
        AND NOT (start BETWEEN 154931042 AND 155260559)
        AND LENGTH(reference_bases) = 1
        AND ARRAY_LENGTH(alternate_bases) = 1
        AND LENGTH(alternate_bases[ORDINAL(1)]) = 1
        AND ARRAY_LENGTH(c.genotype) >= 1
    )
    GROUP BY sample_id
  )
)
ORDER BY
  pct_het_among_snvs DESC,
  sample_id
LIMIT 20;
```
