```sql
/*  Distribution of common (AF ≥ 0.05) autosomal variants within each
    1000 Genomes super‑population                                            */

WITH
/* ───────── 1. samples and their super‑population ───────── */
sample_pop AS (
  SELECT
    Sample            AS sample_id,
    Super_Population  AS super_pop
  FROM `bigquery-public-data.1000_genomes.sample_info`
  WHERE Super_Population IS NOT NULL
),

/* ───────── 2. population sizes ───────── */
pop_size AS (
  SELECT
    super_pop,
    COUNT(DISTINCT sample_id) AS population_size
  FROM sample_pop
  GROUP BY super_pop
),

/* ───────── 3. variants carried by each sample that has ≥1 alt allele ───────── */
variant_sample AS (
  SELECT
    sp.super_pop,
    CONCAT(
      v.reference_name, ':', CAST(v.start AS STRING), ':',
      v.reference_bases, ':', ARRAY_TO_STRING(v.alternate_bases, ',')
    )                           AS variant_id,
    c.call_set_name             AS sample_id
  FROM `bigquery-public-data.1000_genomes.variants` v
  CROSS JOIN UNNEST(v.call) AS c
  JOIN sample_pop sp
    ON sp.sample_id = c.call_set_name                 -- keep only 1000 G samples
  WHERE v.reference_name NOT IN ('X','Y','MT')        -- autosomes only
    AND IFNULL(v.AF, 0) >= 0.05                       -- common variants
    AND EXISTS (
          SELECT 1 FROM UNNEST(c.genotype) g          -- sample must carry alt
          WHERE g > 0
        )
),

/* ───────── 4. number of samples with alt allele for each variant/pop ───────── */
variant_counts AS (
  SELECT
    super_pop,
    variant_id,
    COUNT(DISTINCT sample_id) AS num_samples_with_alt
  FROM variant_sample
  GROUP BY super_pop, variant_id
)

/* ───────── 5. final distribution ───────── */
SELECT
  vc.super_pop,
  ps.population_size,
  TRUE                           AS is_common_variant,  -- filter guarantees this
  vc.num_samples_with_alt,
  COUNT(*)                       AS variant_count
FROM variant_counts vc
JOIN pop_size ps USING (super_pop)
GROUP BY
  vc.super_pop,
  ps.population_size,
  is_common_variant,
  vc.num_samples_with_alt
ORDER BY
  vc.super_pop,
  vc.num_samples_with_alt;
