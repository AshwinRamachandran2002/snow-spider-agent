```sql
/*  Distribution of common (AF ≥ 0.05) autosomal variants within each
    1000 Genomes super‑population.

    For every super‑population the query returns
      • population_size            – # samples in that super‑population
      • is_common_variant          – always TRUE (filter already enforces AF ≥ 0.05)
      • num_samples_with_alt       – # samples in that population carrying ≥1 alt allele
      • variant_count              – how many distinct variants are shared
                                      by exactly num_samples_with_alt samples
*/

WITH
/* ─────────────── 1. samples and their super‑population ─────────────── */
sample_pop AS (
  SELECT
    Sample                      AS sample_id,
    Super_Population            AS super_pop
  FROM `spider2-public-data.1000_genomes.sample_info`
  WHERE Super_Population IS NOT NULL
),

/* ─────────────── 2. population sizes ─────────────── */
pop_size AS (
  SELECT
    super_pop,
    COUNT(DISTINCT sample_id)   AS population_size
  FROM sample_pop
  GROUP BY super_pop
),

/* ─────────────── 3. variants carried by each sample (alt allele present) ─────────────── */
variant_sample AS (
  SELECT
    sp.super_pop,
    CONCAT(v.reference_name,':',CAST(v.start AS STRING),':',
           v.reference_bases,':',ARRAY_TO_STRING(v.alternate_bases,',')) AS variant_id,
    c.call_set_name                                                 AS sample_id
  FROM `spider2-public-data.1000_genomes.variants` v
  /* keep only autosomal, common variants                               */
  WHERE v.reference_name NOT IN ('X','Y','MT')
    AND IFNULL(v.AF,0) >= 0.05
  /* explode calls and keep only samples carrying ≥1 alt allele         */
  CROSS JOIN UNNEST(v.call) AS c
  JOIN sample_pop           AS sp  ON sp.sample_id = c.call_set_name
  WHERE EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g > 0)
),

/* ─────────────── 4. number of samples with alt allele for each variant & population ─────────────── */
variant_counts AS (
  SELECT
    super_pop,
    variant_id,
    COUNT(DISTINCT sample_id)  AS num_samples_with_alt
  FROM variant_sample
  GROUP BY super_pop, variant_id
)

/* ─────────────── 5. final distribution ─────────────── */
SELECT
  vc.super_pop,
  ps.population_size,
  TRUE                       AS is_common_variant,      -- filter guarantees this
  vc.num_samples_with_alt,
  COUNT(*)                   AS variant_count
FROM variant_counts vc
JOIN pop_size      ps USING (super_pop)
GROUP BY
  vc.super_pop,
  ps.population_size,
  is_common_variant,
  vc.num_samples_with_alt
ORDER BY
  vc.super_pop,
  vc.num_samples_with_alt;
```
