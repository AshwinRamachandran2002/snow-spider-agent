/*  Histogram of common (allele‑frequency ≥ 0.05) autosomal variants
    for every 1000 Genomes super‑population.  For each super‑population
    we report how many variants are shared by exactly N samples.        */

WITH pop_size AS (       -- 1. size of every super‑population
  SELECT
    Super_Population                  AS super_pop,
    COUNT(*)                          AS pop_size
  FROM `spider2-public-data.1000_genomes.sample_info`
  WHERE Super_Population IS NOT NULL
  GROUP BY Super_Population
),

carriers AS (            -- 2. per (variant, super‑pop) → #carrying samples
  SELECT
    CONCAT_WS(
      ':',
      v.reference_name,
      CAST(v.start            AS STRING),
      v.reference_bases,
      ARRAY_TO_STRING(v.alternate_bases, '|')
    )                                   AS variant_id,          -- unique key
    si.Super_Population                 AS super_pop,
    COUNT(DISTINCT c.call_set_name)     AS carrier_samples
  FROM `spider2-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.call) AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS si
    ON si.Sample = c.call_set_name
  WHERE v.reference_name NOT IN ('X','Y','MT')                  -- autosomes
        AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g > 0) -- ALT
  GROUP BY variant_id, si.Super_Population
),

common_variants AS (     -- 3. keep only common ones (AF ≥ 0.05)
  SELECT
    c.super_pop,
    p.pop_size,
    c.variant_id,
    c.carrier_samples
  FROM carriers c
  JOIN pop_size p USING (super_pop)
  WHERE SAFE_DIVIDE(c.carrier_samples, p.pop_size) >= 0.05
)

-- 4. histogram of “shared‑by‑N‑samples” counts
SELECT
  super_pop                             AS super_population,
  pop_size,
  TRUE                                  AS is_common_variant,     -- by filter
  carrier_samples                       AS samples_sharing_variant,
  COUNT(*)                              AS variants_count
FROM common_variants
GROUP BY super_pop, pop_size, carrier_samples
ORDER BY super_pop, samples_sharing_variant;
```
