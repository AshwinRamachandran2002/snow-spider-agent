```sql
/*  Histogram of common (allele‑frequency ≥ 0.05) autosomal variants
    in every 1000 Genomes super‑population. The result tells, for each
    super‑population, how many variants are shared by exactly N samples. */

WITH pop_size AS (   -- size of each super‑population
  SELECT
    super_population        AS super_pop,
    COUNT(*)                AS pop_size
  FROM `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`
  WHERE super_population IS NOT NULL
  GROUP BY super_pop
),

carriers AS (        -- (# samples with ≥1 ALT allele) per variant & super‑pop
  SELECT
    CONCAT(
      v.reference_name, ':', CAST(v.start AS STRING), ':',
      v.reference_bases, '>', ARRAY_TO_STRING(v.alternate_bases, '|')
    )                           AS variant_id,
    si.super_population         AS super_pop,
    COUNT(DISTINCT c.call_set_name) AS carrier_samples
  FROM `bigquery-public-data.human_genome_variants.1000_genomes_variants` AS v
  JOIN UNNEST(v.call) AS c
  JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS si
    ON si.sample = c.call_set_name
  WHERE v.reference_name NOT IN ('X','Y','MT')        -- autosomes only
    AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g > 0)
  GROUP BY variant_id, super_pop
),

common_variants AS ( -- keep only common variants (AF ≥ 0.05)
  SELECT
    c.super_pop,
    p.pop_size,
    c.variant_id,
    c.carrier_samples
  FROM carriers c
  JOIN pop_size p USING (super_pop)
  WHERE SAFE_DIVIDE(c.carrier_samples, p.pop_size) >= 0.05
)

-- Histogram: variants shared by N samples inside each super‑population
SELECT
  super_pop                      AS super_population,
  pop_size,
  TRUE                           AS is_common_variant,
  carrier_samples                AS samples_sharing_variant,
  COUNT(*)                       AS variants_count
FROM common_variants
GROUP BY super_pop, pop_size, carrier_samples
ORDER BY super_pop, carrier_samples;
```
