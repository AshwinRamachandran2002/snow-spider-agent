```sql
-- Common autosomal variants (allele‑frequency ≥ 0.05) –
-- how many variants are shared by a given number of samples
-- in each 1000 Genomes super‑population.

WITH
/* 1.  Population size for every super population              */
pop_size AS (
  SELECT
    Super_Population                       AS super_pop,
    COUNT(*)                               AS pop_size
  FROM `spider2-public-data.1000_genomes.sample_info`
  WHERE Super_Population IS NOT NULL
  GROUP BY Super_Population
),

/* 2.  For every variant + super‑population, count the samples
       that carry (have ≥1 non‑reference allele) the variant.  */
carriers AS (
  SELECT
    /* build a unique, hashable identifier for the variant     */
    CONCAT(
      v.reference_name, ':', CAST(v.start AS STRING), ':',
      v.reference_bases, '>', ARRAY_TO_STRING(v.alternate_bases, '|')
    )                                       AS variant_id,
    si.Super_Population                     AS super_pop,
    COUNT(DISTINCT c.call_set_name)         AS carrier_samples
  FROM `spider2-public-data.1000_genomes.variants`  AS v
  JOIN UNNEST(v.call)                        AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS si
    ON si.Sample = c.call_set_name
  WHERE v.reference_name NOT IN ('X', 'Y', 'MT')      -- autosomes only
        -- sample must carry at least one ALT allele
        AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g > 0)
  GROUP BY variant_id, si.Super_Population
),

/* 3.  Add population size, compute allele frequency,
       keep only “common” variants (AF ≥ 0.05).                */
common_variants AS (
  SELECT
    c.super_pop,
    p.pop_size,
    c.variant_id,
    c.carrier_samples,
    SAFE_DIVIDE(c.carrier_samples , p.pop_size) AS allele_freq
  FROM carriers c
  JOIN pop_size p
    ON p.super_pop = c.super_pop
  WHERE SAFE_DIVIDE(c.carrier_samples , p.pop_size) >= 0.05        -- common
)

/* 4.  Build the histogram: for every super population, tell
       how many variants are shared by exactly N samples.      */
SELECT
  super_pop                          AS super_population,
  pop_size,
  TRUE                               AS is_common_variant,          -- all retained rows are common
  carrier_samples                    AS samples_sharing_variant,
  COUNT(*)                           AS variants_count
FROM common_variants
GROUP BY super_pop, pop_size, carrier_samples
ORDER BY super_pop, samples_sharing_variant;
```
