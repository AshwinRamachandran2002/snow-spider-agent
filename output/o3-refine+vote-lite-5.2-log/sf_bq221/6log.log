/*------------------------------------------------------------
  1.  Get first CPC code, derive level‑5 CPC group symbol,
      and extract filing year (YYYY) for every publication
      that has a valid filing date and non‑empty application
      number.
------------------------------------------------------------*/
WITH base AS (
    SELECT
        /* first CPC code in the array                                      */
        ( "cpc"[0]:"code" )::STRING                                         AS "FIRST_CPC_CODE",

        /* build level‑5 (main‑group) CPC symbol, e.g. G06F17/00            */
        IFF(
            POSITION('/' IN ( "cpc"[0]:"code" )::STRING ) > 0,
            CONCAT( SPLIT_PART( ( "cpc"[0]:"code" )::STRING , '/', 1 ), '/00' ),
            ( "cpc"[0]:"code" )::STRING
        )                                                                   AS "CPC_GROUP_CODE",

        /* filing year: 19970115 → 1997                                      */
        FLOOR( "filing_date" / 10000 )                                      AS "FILING_YEAR"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "filing_date"      IS NOT NULL
      AND "application_number" IS NOT NULL
      AND "application_number" <> ''
      AND "cpc"[0] IS NOT NULL
),

/*------------------------------------------------------------
  2.  Count yearly filings for each level‑5 CPC group.
------------------------------------------------------------*/
year_counts AS (
    SELECT
        "CPC_GROUP_CODE",
        "FILING_YEAR",
        COUNT(*)            AS "YEAR_COUNT"
    FROM base
    GROUP BY
        "CPC_GROUP_CODE",
        "FILING_YEAR"
),

/*------------------------------------------------------------
  3.  Add row numbers (chronological order) inside each group,
      required for the recursive EMA calculation.
------------------------------------------------------------*/
ordered_counts AS (
    SELECT
        "CPC_GROUP_CODE",
        "FILING_YEAR",
        "YEAR_COUNT",
        ROW_NUMBER() OVER (
            PARTITION BY "CPC_GROUP_CODE"
            ORDER BY      "FILING_YEAR"
        )                             AS rn
    FROM year_counts
),

/*------------------------------------------------------------
  4.  Recursive EMA (α = 0.2).
      EMA₁ = YEAR_COUNT₁
      EMAₜ = 0.2·YEAR_COUNTₜ + 0.8·EMA₍ₜ₋₁₎
------------------------------------------------------------*/
RECURSIVE ema AS (
    /* seed: first year per CPC group */
    SELECT
        oc."CPC_GROUP_CODE",
        oc."FILING_YEAR",
        oc."YEAR_COUNT",
        CAST(oc."YEAR_COUNT" AS DOUBLE)        AS "EMA_VALUE",
        oc.rn
    FROM ordered_counts oc
    WHERE oc.rn = 1

    UNION ALL

    /* recursive step */
    SELECT
        oc."CPC_GROUP_CODE",
        oc."FILING_YEAR",
        oc."YEAR_COUNT",
        0.2 * oc."YEAR_COUNT" + 0.8 * ema."EMA_VALUE"  AS "EMA_VALUE",
        oc.rn
    FROM ema
    JOIN ordered_counts oc
      ON  oc."CPC_GROUP_CODE" = ema."CPC_GROUP_CODE"
     AND oc.rn              = ema.rn + 1
),

/*------------------------------------------------------------
  5.  For each CPC group keep the year with the highest EMA.
------------------------------------------------------------*/
best_year_per_group AS (
    SELECT
        e."CPC_GROUP_CODE",
        e."FILING_YEAR"     AS "BEST_YEAR",
        e."EMA_VALUE",
        ROW_NUMBER() OVER (
            PARTITION BY e."CPC_GROUP_CODE"
            ORDER BY e."EMA_VALUE" DESC NULLS LAST,   /* highest EMA first  */
                     e."FILING_YEAR"                  /* tie‑breaker: earliest */
        )                                            AS rn_best
    FROM ema e
)

SELECT
    b."CPC_GROUP_CODE"                                             AS "CPC_SYMBOL_L5",
    d."titleFull"                                                  AS "CPC_FULL_TITLE",
    b."BEST_YEAR",
    b."EMA_VALUE"                                                  AS "MAX_EMA"
FROM best_year_per_group b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."CPC_GROUP_CODE"
      AND d."level"  = 5            -- only level‑5 CPC technology areas
WHERE b.rn_best = 1
ORDER BY
    "MAX_EMA"      DESC NULLS LAST,
    "CPC_SYMBOL_L5";
```
