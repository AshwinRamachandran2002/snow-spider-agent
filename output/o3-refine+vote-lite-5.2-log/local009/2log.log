```sql
WITH coords AS (                                   -- longitude / latitude for every airport
    SELECT
        airport_code,
        CAST(SUBSTR(coordinates, 2, INSTR(coordinates, ',') - 2) AS REAL)  AS lon,
        CAST(SUBSTR(coordinates,
                    INSTR(coordinates, ',') + 1,
                    INSTR(coordinates, ')') - INSTR(coordinates, ',') - 1) AS REAL) AS lat,
        city
    FROM airports_data
),
abakan AS (                                        -- Abakan airport(s)
    SELECT airport_code, lon, lat
    FROM coords
    WHERE LOWER(city) LIKE '%abakan%'
),
flights_abakan AS (                               -- all flights where Abakan is either departure or arrival
    SELECT
        CASE                                         -- airport on the other side of the route
            WHEN f.departure_airport = a.airport_code THEN f.arrival_airport
            ELSE f.departure_airport
        END  AS other_airport,
        a.airport_code                              AS abk_code
    FROM flights f
    JOIN abakan a
      ON f.departure_airport = a.airport_code
      OR f.arrival_airport   = a.airport_code
),
route_dist AS (                                   -- distance (km) of every distinct route involving Abakan
    SELECT DISTINCT
        fa.abk_code,
        fa.other_airport,
        2 * 6371 * ASIN(                           -- Haversine formula (Earth radius ≈ 6371 km)
            SQRT(
                SIN( ((o.lat - ab.lat) * 3.141592653589793 / 180.0) / 2 ) *
                SIN( ((o.lat - ab.lat) * 3.141592653589793 / 180.0) / 2 ) +
                COS( ab.lat * 3.141592653589793 / 180.0 ) *
                COS( o.lat  * 3.141592653589793 / 180.0 ) *
                SIN( ((o.lon - ab.lon) * 3.141592653589793 / 180.0) / 2 ) *
                SIN( ((o.lon - ab.lon) * 3.141592653589793 / 180.0) / 2 )
            )
        ) AS distance_km
    FROM flights_abakan fa
    JOIN coords ab ON ab.airport_code = fa.abk_code
    JOIN coords o  ON o.airport_code  = fa.other_airport
)

SELECT MAX(distance_km) AS longest_route_km        -- longest Abakan‑related route (in km)
FROM route_dist;
```
