```sql
WITH abakan_airports AS (
    /* all airports located in the city of Abakan */
    SELECT airport_code
    FROM airports_data
    WHERE lower(json_extract(city,'$.en')) = 'abakan'
       OR lower(json_extract(airport_name,'$.en')) LIKE '%abakan%'
),
routes AS (
    /* every distinct route that starts or ends in Abakan */
    SELECT DISTINCT departure_airport,
           arrival_airport
    FROM flights
    WHERE departure_airport IN (SELECT airport_code FROM abakan_airports)
       OR arrival_airport   IN (SELECT airport_code FROM abakan_airports)
),
coords AS (
    /* coordinates of both ends of each route */
    SELECT r.departure_airport,
           r.arrival_airport,
           d.coordinates AS dep_coord,
           a.coordinates AS arr_coord
    FROM routes r
    JOIN airports_data d ON d.airport_code = r.departure_airport
    JOIN airports_data a ON a.airport_code = r.arrival_airport
),
parsed AS (
    /* convert “(lon,lat)” text to numeric lon/lat (in degrees) */
    SELECT 
        departure_airport,
        arrival_airport,
        CAST(REPLACE(SUBSTR(dep_coord, 2, INSTR(dep_coord, ',') - 2), ')', '') AS REAL) AS dep_lon,
        CAST(REPLACE(SUBSTR(dep_coord, INSTR(dep_coord, ',') + 1,
                            LENGTH(dep_coord) - INSTR(dep_coord, ',') - 1), ')', '') AS REAL) AS dep_lat,
        CAST(REPLACE(SUBSTR(arr_coord, 2, INSTR(arr_coord, ',') - 2), ')', '') AS REAL) AS arr_lon,
        CAST(REPLACE(SUBSTR(arr_coord, INSTR(arr_coord, ',') + 1,
                            LENGTH(arr_coord) - INSTR(arr_coord, ',') - 1), ')', '') AS REAL) AS arr_lat
    FROM coords
),
diffs AS (
    /* basic differences and average latitude */
    SELECT 
        departure_airport,
        arrival_airport,
        (dep_lat - arr_lat) AS dlat,
        (dep_lon - arr_lon) AS dlon,
        ((dep_lat + arr_lat) / 2.0) AS lat_avg
    FROM parsed
),
rad AS (
    /* average latitude in radians and its powers for cos‑approximation */
    SELECT
        departure_airport,
        arrival_airport,
        dlat,
        dlon,
        (lat_avg * 3.141592653589793 / 180.0)          AS t,   /* t = lat_avg_rad */
        (lat_avg * 3.141592653589793 / 180.0) * 
        (lat_avg * 3.141592653589793 / 180.0)          AS t2   /* t² */
    FROM diffs
),
series AS (
    /* build t⁴, t⁶, t⁸ from t² to approximate cos(t) */
    SELECT
        departure_airport,
        arrival_airport,
        dlat,
        dlon,
        t2                                       AS r2,
        t2 * t2                                  AS r4,
        t2 * t2 * t2                             AS r6,
        (t2 * t2) * (t2 * t2)                    AS r8
    FROM rad
),
cosine AS (
    /* 8th‑order Maclaurin series for cos(lat_avg_rad) */
    SELECT
        departure_airport,
        arrival_airport,
        dlat,
        dlon,
        1 - r2/2.0 + r4/24.0 - r6/720.0 + r8/40320.0 AS cos_lat_avg
    FROM series
),
distances AS (
    /* simple equirectangular approximation:  
       d ≈ 111.195 * √(Δφ² + (Δλ·cosφ̄)²)  */
    SELECT
        111.195 * sqrt( dlat*dlat + (dlon * cos_lat_avg)*(dlon * cos_lat_avg) ) AS distance_km
    FROM cosine
)
SELECT MAX(distance_km) AS longest_route_distance_km
FROM distances;
