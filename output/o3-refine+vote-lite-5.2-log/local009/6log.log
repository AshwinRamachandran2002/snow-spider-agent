```sql
WITH abakan_airports AS (
    SELECT airport_code
    FROM airports_data
    WHERE lower(json_extract(city,'$.en')) = 'abakan'
       OR lower(json_extract(airport_name,'$.en')) LIKE '%abakan%'
),
routes AS (
    /* every distinct origin‑destination pair that involves Abakan */
    SELECT DISTINCT f.departure_airport,
           f.arrival_airport
    FROM flights AS f
    WHERE f.departure_airport IN (SELECT airport_code FROM abakan_airports)
       OR f.arrival_airport   IN (SELECT airport_code FROM abakan_airports)
),
coords AS (
    /* get the coordinates of both airports */
    SELECT r.departure_airport,
           r.arrival_airport,
           d.coordinates AS dep_coord,
           a.coordinates AS arr_coord
    FROM routes r
    JOIN airports_data d ON d.airport_code = r.departure_airport
    JOIN airports_data a ON a.airport_code = r.arrival_airport
),
parsed AS (
    /* split the “(lon,lat)” text into numeric longitude/latitude */
    SELECT *,
           CAST(SUBSTR(dep_coord, 2, INSTR(dep_coord, ',') - 2) AS REAL)  AS dep_lon,
           CAST(SUBSTR(dep_coord,
                       INSTR(dep_coord, ',') + 1,
                       LENGTH(dep_coord) - INSTR(dep_coord, ',') - 1) AS REAL) AS dep_lat,
           CAST(SUBSTR(arr_coord, 2, INSTR(arr_coord, ',') - 2) AS REAL)  AS arr_lon,
           CAST(SUBSTR(arr_coord,
                       INSTR(arr_coord, ',') + 1,
                       LENGTH(arr_coord) - INSTR(arr_coord, ',') - 1) AS REAL) AS arr_lat
    FROM coords
),
distances AS (
    /* great‑circle distance (Haversine) in kilometres */
    SELECT departure_airport,
           arrival_airport,
           6371 *
           acos(
               cos(dep_lat * pi() / 180.0) * cos(arr_lat * pi() / 180.0) *
               cos((arr_lon - dep_lon) * pi() / 180.0) +
               sin(dep_lat * pi() / 180.0) * sin(arr_lat * pi() / 180.0)
           ) AS distance_km
    FROM parsed
)
SELECT MAX(distance_km) AS longest_route_distance_km
FROM distances;
