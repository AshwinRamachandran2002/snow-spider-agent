```sql
WITH
/* --------------  Batting part -------------- */
batsman_runs AS (          /* runs & balls for every player in every match */
    SELECT  b.striker                        AS player_id,
            b.match_id,
            SUM(bs.runs_scored)              AS runs_scored,
            COUNT(*)                         AS balls_faced
    FROM   ball_by_ball   AS b
    JOIN   batsman_scored AS bs
           ON  bs.match_id   = b.match_id
           AND bs.over_id    = b.over_id
           AND bs.ball_id    = b.ball_id
           AND bs.innings_no = b.innings_no
    GROUP  BY b.striker, b.match_id
),
batsman_agg AS (           /* career‑level batting figures */
    SELECT  player_id,
            SUM(runs_scored)                                             AS total_runs,
            SUM(balls_faced)                                             AS total_balls,
            MAX(runs_scored)                                             AS highest_score,
            SUM(CASE WHEN runs_scored >= 30  THEN 1 ELSE 0 END)          AS matches_30_plus,
            SUM(CASE WHEN runs_scored >= 50  THEN 1 ELSE 0 END)          AS matches_50_plus,
            SUM(CASE WHEN runs_scored >= 100 THEN 1 ELSE 0 END)          AS matches_100_plus
    FROM    batsman_runs
    GROUP  BY player_id
),
player_matches AS (        /* matches appeared */
    SELECT  player_id,
            COUNT(DISTINCT match_id) AS matches_played
    FROM    player_match
    GROUP  BY player_id
),
dismissals AS (            /* times out */
    SELECT  player_out AS player_id,
            COUNT(*)    AS dismissals
    FROM    wicket_taken
    GROUP  BY player_out
),

/* --------------  Bowling part -------------- */
bowling_per_match AS (     /* bowling figures per match (extras ignored) */
    SELECT  b.bowler                       AS player_id,
            b.match_id,
            SUM(bs.runs_scored)            AS runs_conceded,
            COUNT(*)                       AS balls_bowled,
            SUM(CASE WHEN wt.player_out IS NOT NULL THEN 1 ELSE 0 END) AS wickets
    FROM   ball_by_ball   AS b
    JOIN   batsman_scored AS bs
           ON  bs.match_id   = b.match_id
           AND bs.over_id    = b.over_id
           AND bs.ball_id    = b.ball_id
           AND bs.innings_no = b.innings_no
    LEFT  JOIN wicket_taken  AS wt
           ON  wt.match_id   = b.match_id
           AND wt.over_id    = b.over_id
           AND wt.ball_id    = b.ball_id
           AND wt.innings_no = b.innings_no
    GROUP  BY b.bowler, b.match_id
),
bowling_agg AS (           /* career‑level bowling figures */
    SELECT  player_id,
            SUM(wickets)        AS total_wickets,
            SUM(runs_conceded)  AS total_runs_conceded,
            SUM(balls_bowled)   AS total_balls_bowled
    FROM    bowling_per_match
    GROUP  BY player_id
),
best_bowling_rank AS (     /* pick best spell: most wkts, then least runs */
    SELECT  player_id,
            wickets,
            runs_conceded,
            ROW_NUMBER() OVER (PARTITION BY player_id
                               ORDER BY wickets DESC, runs_conceded ASC) AS rn
    FROM    bowling_per_match
),
best_bowling AS (
    SELECT  player_id,
            printf('%d-%d', wickets, runs_conceded) AS best_bowling
    FROM    best_bowling_rank
    WHERE   rn = 1
),

/* --------------  Most frequent role -------------- */
role_cnt_base AS (
    SELECT  player_id, role, COUNT(*) AS cnt
    FROM    player_match
    GROUP  BY player_id, role
),
role_cnt_rank AS (
    SELECT  player_id,
            role,
            ROW_NUMBER() OVER (PARTITION BY player_id
                               ORDER BY cnt DESC, role) AS rn
    FROM    role_cnt_base
),
most_role AS (
    SELECT  player_id, role AS most_freq_role
    FROM    role_cnt_rank
    WHERE   rn = 1
)

/* --------------  Final output -------------- */
SELECT  p.player_id,
        p.player_name,
        COALESCE(most_role.most_freq_role, '')                          AS most_freq_role,
        p.batting_hand,
        p.bowling_skill,

        /* batting summary */
        COALESCE(batsman_agg.total_runs, 0)                             AS total_runs,
        COALESCE(player_matches.matches_played, 0)                      AS matches_played,
        COALESCE(dismissals.dismissals, 0)                              AS dismissals,
        CASE WHEN COALESCE(dismissals.dismissals, 0) > 0
             THEN ROUND(1.0 * batsman_agg.total_runs /
                        dismissals.dismissals, 4)
             ELSE NULL END                                              AS batting_average,
        COALESCE(batsman_agg.highest_score, 0)                          AS highest_score,
        COALESCE(batsman_agg.matches_30_plus, 0)                        AS matches_30_plus,
        COALESCE(batsman_agg.matches_50_plus, 0)                        AS matches_50_plus,
        COALESCE(batsman_agg.matches_100_plus, 0)                       AS matches_100_plus,
        COALESCE(batsman_agg.total_balls, 0)                            AS total_balls_faced,
        CASE WHEN COALESCE(batsman_agg.total_balls, 0) > 0
             THEN ROUND(100.0 * batsman_agg.total_runs /
                        batsman_agg.total_balls, 4)
             ELSE NULL END                                              AS strike_rate,

        /* bowling summary */
        COALESCE(bowling_agg.total_wickets, 0)                          AS total_wickets,
        CASE WHEN COALESCE(bowling_agg.total_balls_bowled, 0) > 0
             THEN ROUND(6.0 * bowling_agg.total_runs_conceded /
                        bowling_agg.total_balls_bowled, 4)
             ELSE NULL END                                              AS economy_rate,
        COALESCE(best_bowling.best_bowling, '')                         AS best_bowling
FROM    player              AS p
LEFT JOIN batsman_agg       ON batsman_agg.player_id      = p.player_id
LEFT JOIN player_matches    ON player_matches.player_id   = p.player_id
LEFT JOIN dismissals        ON dismissals.player_id       = p.player_id
LEFT JOIN bowling_agg       ON bowling_agg.player_id      = p.player_id
LEFT JOIN best_bowling      ON best_bowling.player_id     = p.player_id
LEFT JOIN most_role         ON most_role.player_id        = p.player_id
ORDER BY p.player_id;
```
