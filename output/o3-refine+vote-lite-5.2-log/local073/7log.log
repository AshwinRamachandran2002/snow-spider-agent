```sql
WITH
/* -----------------------------------------------------------
1.  Basic order details and the required pizza name/id
----------------------------------------------------------- */
base_orders AS (
    SELECT
        o.order_id,
        o.customer_id,
        o.order_time,
        /* ensure Meatlovers = 1, every thing else = 2 */
        CASE WHEN pn.pizza_name = 'Meatlovers' THEN 1 ELSE 2 END AS pizza_id,
        pn.pizza_name
    FROM pizza_clean_customer_orders   AS o
    JOIN pizza_names                   AS pn
          ON pn.pizza_id = o.pizza_id
),
/* -----------------------------------------------------------
2.  Split the recipe‐topping list into one row per topping
----------------------------------------------------------- */
recipe_toppings AS (
    WITH RECURSIVE splitter(order_id, topping_id, rest) AS (
        /* seed rows */
        SELECT
            bo.order_id,
            CAST(
                TRIM( SUBSTR(pr.toppings, 1, INSTR(pr.toppings||',', ',')-1) )
            )      AS topping_id,
            SUBSTR(pr.toppings||',', INSTR(pr.toppings||',', ',')+1) AS rest
        FROM base_orders       AS bo
        JOIN pizza_recipes     AS pr
              ON pr.pizza_id = bo.pizza_id

        UNION ALL

        /* recursive part – continue splitting until nothing left */
        SELECT
            order_id,
            CAST( TRIM( SUBSTR(rest, 1, INSTR(rest, ',')-1) ) )        AS topping_id,
            SUBSTR(rest, INSTR(rest, ',')+1)                           AS rest
        FROM splitter
        WHERE rest <> ''
    )
    SELECT order_id,
           topping_id,
           1 AS cnt               /* every recipe topping appears once */
    FROM splitter
),
/* -----------------------------------------------------------
3.  Extras and exclusions supplied by the customer
----------------------------------------------------------- */
extra_toppings AS (
    SELECT
        order_id,
        extras        AS topping_id,
        extras_count  AS cnt
    FROM pizza_get_extras
),
exclusion_toppings AS (
    SELECT
        order_id,
        exclusions AS topping_id
    FROM pizza_get_exclusions
),
/* -----------------------------------------------------------
4.  Remove exclusions from the recipe list, then combine with extras
----------------------------------------------------------- */
recipe_after_exclusions AS (
    SELECT rt.order_id,
           rt.topping_id,
           rt.cnt
    FROM recipe_toppings        AS rt
    LEFT JOIN exclusion_toppings ex
           ON  ex.order_id   = rt.order_id
           AND ex.topping_id = rt.topping_id
    WHERE ex.topping_id IS NULL               /* keep only non‑excluded */
),
all_toppings AS (
    SELECT order_id, topping_id, SUM(cnt) AS total_cnt
    FROM (
        SELECT * FROM recipe_after_exclusions
        UNION ALL
        SELECT * FROM extra_toppings
    )
    GROUP BY order_id, topping_id
),
/* -----------------------------------------------------------
5.  Convert counts into the required ingredient text
----------------------------------------------------------- */
ingredient_strings AS (
    SELECT
        at.order_id,
        pt.topping_name,
        CASE
            WHEN at.total_cnt > 1 THEN '2x ' || pt.topping_name
            ELSE                    pt.topping_name
        END AS ingredient_text
    FROM all_toppings  AS at
    JOIN pizza_toppings AS pt
          ON pt.topping_id = at.topping_id
),
/* -----------------------------------------------------------
6.  Alphabetically concatenate ingredients per order
----------------------------------------------------------- */
ingredients_per_order AS (
    SELECT
        order_id,
        GROUP_CONCAT(ingredient_text, ', ') AS ingredients_list
    FROM (
        SELECT order_id, ingredient_text
        FROM ingredient_strings
        ORDER BY order_id, topping_name        /* guarantees alpha order */
    )
    GROUP BY order_id
),
/* -----------------------------------------------------------
7.  Assemble the final required output
----------------------------------------------------------- */
final_output AS (
    SELECT
        ROW_NUMBER() OVER (ORDER BY bo.order_id)            AS row_id,
        bo.order_id,
        bo.customer_id,
        bo.pizza_name,
        bo.pizza_name || ': ' || ipo.ingredients_list       AS final_ingredients
    FROM base_orders          AS bo
    JOIN ingredients_per_order AS ipo
          ON ipo.order_id = bo.order_id
)
SELECT
    row_id,
    order_id,
    customer_id,
    pizza_name,
    final_ingredients
FROM final_output
ORDER BY row_id;
```
