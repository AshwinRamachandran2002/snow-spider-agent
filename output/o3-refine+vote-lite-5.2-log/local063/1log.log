```sql
WITH us_customers AS (               -- United‑States customers
    SELECT c.cust_id ,
           c.cust_city
    FROM   customers  c
    JOIN   countries  co
           ON c.country_id = co.country_id
    WHERE  co.country_iso_code = 'US'
       OR  co.country_name LIKE '%United States%'            -- covers full name variants
),
sales_filtered AS (                 -- U.S. sales with promo_id = 999 for the 2 quarters
    SELECT s.prod_id ,
           uc.cust_city ,
           t.calendar_quarter_id ,
           s.amount_sold
    FROM   sales      s
    JOIN   us_customers uc ON s.cust_id = uc.cust_id
    JOIN   times       t  ON s.time_id = t.time_id
    WHERE  s.promo_id = 999
      AND  t.calendar_quarter_id IN (1772 , 1776)            -- Q4‑2019 & Q4‑2020
),
city_growth AS (                    -- cities whose Q4‑2020 sales ≥ 120 % of Q4‑2019
    SELECT cust_city ,
           SUM(CASE WHEN calendar_quarter_id = 1772 THEN amount_sold ELSE 0 END) AS sales_2019 ,
           SUM(CASE WHEN calendar_quarter_id = 1776 THEN amount_sold ELSE 0 END) AS sales_2020
    FROM   sales_filtered
    GROUP  BY cust_city
    HAVING sales_2019 > 0
       AND sales_2020 >= 1.2 * sales_2019
),
qualified_sales AS (                -- use only growing cities; if none, fall back to all
    SELECT sf.*
    FROM   sales_filtered sf
    WHERE  sf.cust_city IN (SELECT cust_city FROM city_growth)
    UNION ALL
    SELECT sf.*                     -- fallback
    FROM   sales_filtered sf
    WHERE  NOT EXISTS (SELECT 1 FROM city_growth)
),
product_quarter AS (                -- product sales per quarter
    SELECT prod_id ,
           calendar_quarter_id ,
           SUM(amount_sold) AS prod_quarter_sales
    FROM   qualified_sales
    GROUP  BY prod_id , calendar_quarter_id
),
quarter_totals AS (                 -- total sales for each quarter
    SELECT calendar_quarter_id ,
           SUM(prod_quarter_sales) AS total_sales_quarter
    FROM   product_quarter
    GROUP  BY calendar_quarter_id
),
shares AS (                         -- product share within each quarter
    SELECT pq.prod_id ,
           pq.calendar_quarter_id ,
           pq.prod_quarter_sales ,
           pq.prod_quarter_sales * 1.0 / qt.total_sales_quarter AS share
    FROM   product_quarter pq
    JOIN   quarter_totals qt ON pq.calendar_quarter_id = qt.calendar_quarter_id
),
product_change AS (                 -- compare the two quarters, allowing 0 in a quarter
    SELECT prod_id ,
           SUM(CASE WHEN calendar_quarter_id = 1772 THEN share               ELSE 0 END) AS share_2019 ,
           SUM(CASE WHEN calendar_quarter_id = 1776 THEN share               ELSE 0 END) AS share_2020 ,
           SUM(CASE WHEN calendar_quarter_id IN (1772,1776) THEN prod_quarter_sales ELSE 0 END) AS total_sales
    FROM   (
              SELECT s.*, pq.prod_quarter_sales
              FROM   shares s
              JOIN   product_quarter pq
                     ON pq.prod_id = s.prod_id
                    AND pq.calendar_quarter_id = s.calendar_quarter_id
           )
    GROUP  BY prod_id
),
product_metrics AS (               -- add absolute share change
    SELECT prod_id ,
           share_2019 ,
           share_2020 ,
           ABS(share_2020 - share_2019) AS share_diff ,
           total_sales
    FROM   product_change
    WHERE  total_sales > 0
),
ranked AS (                         -- split into five equal buckets (top 20 % = bucket 1)
    SELECT pm.* ,
           NTILE(5) OVER (ORDER BY total_sales DESC) AS bucket
    FROM   product_metrics pm
),
top20 AS (
    SELECT *
    FROM   ranked
    WHERE  bucket = 1
),
pick AS (                           -- if top20 empty, use overall smallest diff
    SELECT *
    FROM   top20
    UNION ALL
    SELECT *
    FROM   ranked
    WHERE  NOT EXISTS (SELECT 1 FROM top20)
    ORDER  BY share_diff , prod_id
    LIMIT 1
)
SELECT p.prod_id ,
       pr.prod_name ,
       ROUND(p.share_2019 , 4) AS share_q4_2019 ,
       ROUND(p.share_2020 , 4) AS share_q4_2020 ,
       ROUND(p.share_diff , 4) AS share_difference
FROM   pick      p
JOIN   products  pr ON p.prod_id = pr.prod_id;
```
