2025-05-02 07:47:05 - Thread-3458 (execute) - INFO - [Try to run SQL in self-refine]
```sql
WITH us_customers AS (          -- U.S. customers
    SELECT c.cust_id ,
           c.cust_city
    FROM   customers  c
    JOIN   countries  co
           ON c.country_id = co.country_id
    WHERE  co.country_name = 'United States'
),
sales_us AS (                   -- sales in the U.S. with promo_id = 999
    SELECT s.prod_id ,
           s.cust_id ,
           s.time_id ,
           s.amount_sold
    FROM   sales s
    WHERE  s.promo_id = 999
),
sales_quarter AS (              -- keep only Q4‑2019 & Q4‑2020
    SELECT su.prod_id ,
           uc.cust_city ,
           t.calendar_quarter_id ,
           su.amount_sold
    FROM   sales_us su
    JOIN   us_customers uc  ON su.cust_id = uc.cust_id
    JOIN   times        t   ON su.time_id  = t.time_id
    WHERE  t.calendar_quarter_id IN (1772 , 1776)      -- 1772 = Q4‑2019 , 1776 = Q4‑2020
),
city_sales AS (                 -- cities whose sales ↑ ≥ 20 %
    SELECT cust_city ,
           SUM(CASE WHEN calendar_quarter_id = 1772 THEN amount_sold ELSE 0 END) AS sales_2019 ,
           SUM(CASE WHEN calendar_quarter_id = 1776 THEN amount_sold ELSE 0 END) AS sales_2020
    FROM   sales_quarter
    GROUP  BY cust_city
    HAVING sales_2019 > 0
       AND sales_2020 >= 1.2 * sales_2019
),
qualified_sales AS (            -- sales only in those qualifying cities
    SELECT sq.*
    FROM   sales_quarter sq
    JOIN   city_sales   cs ON sq.cust_city = cs.cust_city
),
product_quarter_sales AS (      -- product sales per quarter
    SELECT prod_id ,
           calendar_quarter_id ,
           SUM(amount_sold) AS prod_quarter_sales
    FROM   qualified_sales
    GROUP  BY prod_id , calendar_quarter_id
),
quarter_totals AS (             -- total sales per quarter
    SELECT calendar_quarter_id ,
           SUM(amount_sold) AS total_sales_quarter
    FROM   qualified_sales
    GROUP  BY calendar_quarter_id
),
product_shares AS (             -- product share of quarter total
    SELECT pqs.prod_id ,
           pqs.calendar_quarter_id ,
           pqs.prod_quarter_sales ,
           pqs.prod_quarter_sales * 1.0 / qt.total_sales_quarter AS share
    FROM   product_quarter_sales pqs
    JOIN   quarter_totals       qt ON pqs.calendar_quarter_id = qt.calendar_quarter_id
),
product_change AS (             -- share change between the two quarters
    SELECT ps19.prod_id ,
           ps19.share AS share_2019 ,
           ps20.share AS share_2020 ,
           ABS(ps20.share - ps19.share) AS share_diff ,
           (ps19.prod_quarter_sales + ps20.prod_quarter_sales) AS total_sales
    FROM   product_shares ps19
    JOIN   product_shares ps20
           ON  ps19.prod_id            = ps20.prod_id
           AND ps19.calendar_quarter_id = 1772          -- Q4‑2019
           AND ps20.calendar_quarter_id = 1776          -- Q4‑2020
),
ranked_products AS (            -- divide products into 5 equal buckets
    SELECT pc.* ,
           NTILE(5) OVER (ORDER BY total_sales DESC) AS bucket
    FROM   product_change pc
),
top_products AS (               -- top 20 % (bucket = 1)
    SELECT *
    FROM   ranked_products
    WHERE  bucket = 1
)
SELECT tp.prod_id,
       p.prod_name,
       ROUND(tp.share_2019 , 4) AS share_q4_2019,
       ROUND(tp.share_2020 , 4) AS share_q4_2020,
       ROUND(tp.share_diff , 4) AS share_difference
FROM   top_products tp
JOIN   products      p ON tp.prod_id = p.prod_id
ORDER  BY tp.share_difference ASC,
          tp.prod_id
LIMIT 1;
```
