2025-05-02 07:47:38 - Thread-3459 (execute) - INFO - [Try to run SQL in self-refine]
```sql
WITH qualifying_cities AS (
    /* Cities in the U.S.A. whose promo‑999 sales rose ≥20 % from 2019 Q4 to 2020 Q4 */
    SELECT   c.cust_city
    FROM     sales      s
    JOIN     customers  c  ON c.cust_id   = s.cust_id
    JOIN     countries  co ON co.country_id = c.country_id
    JOIN     times      t  ON t.time_id   = s.time_id
    WHERE    s.promo_id = 999
      AND    co.country_name LIKE 'United States%'
      AND    t.calendar_quarter_id IN (1772,1776)              -- 1772 = 2019 Q4, 1776 = 2020 Q4
    GROUP BY c.cust_city
    HAVING   SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold ELSE 0 END) > 0
       AND   ( SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold ELSE 0 END) -
               SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold ELSE 0 END) ) * 1.0
             / SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold ELSE 0 END) >= 0.20
),
product_quarter_sales AS (
    /* Sales by product and quarter, restricted to the qualifying cities */
    SELECT   s.prod_id,
             t.calendar_quarter_id,
             SUM(s.amount_sold)    AS amt
    FROM     sales      s
    JOIN     customers  c  ON c.cust_id    = s.cust_id
    JOIN     countries  co ON co.country_id = c.country_id
    JOIN     times      t  ON t.time_id    = s.time_id
    WHERE    s.promo_id = 999
      AND    co.country_name LIKE 'United States%'
      AND    t.calendar_quarter_id IN (1772,1776)
      AND    c.cust_city IN (SELECT cust_city FROM qualifying_cities)
    GROUP BY s.prod_id, t.calendar_quarter_id
),
total_quarter_amt AS (
    /* Total sales (all products) in each quarter */
    SELECT calendar_quarter_id,
           SUM(amt) AS total_amt
    FROM   product_quarter_sales
    GROUP BY calendar_quarter_id
),
product_pivot AS (
    /* Put each product’s two‑quarter amounts on one row */
    SELECT  prod_id,
            SUM(CASE WHEN calendar_quarter_id = 1772 THEN amt ELSE 0 END) AS amt_2019_q4,
            SUM(CASE WHEN calendar_quarter_id = 1776 THEN amt ELSE 0 END) AS amt_2020_q4
    FROM    product_quarter_sales
    GROUP BY prod_id
),
product_share AS (
    /* Compute each product’s share of quarter total and its change */
    SELECT  pp.prod_id,
            pp.amt_2019_q4,
            pp.amt_2020_q4,
            pp.amt_2019_q4 * 1.0 /
            (SELECT total_amt FROM total_quarter_amt WHERE calendar_quarter_id = 1772) AS share_2019,
            pp.amt_2020_q4 * 1.0 /
            (SELECT total_amt FROM total_quarter_amt WHERE calendar_quarter_id = 1776) AS share_2020,
            (pp.amt_2019_q4 + pp.amt_2020_q4)                                  AS total_two_qtrs
    FROM    product_pivot pp
),
ranked_products AS (
    /* Rank products by total sales and keep the top 20 % (NTILE(5)=1) */
    SELECT  *,
            NTILE(5) OVER (ORDER BY total_two_qtrs DESC) AS tile
    FROM    product_share
),
top_20_percent AS (
    SELECT *,
           ABS(share_2020 - share_2019) AS share_change
    FROM   ranked_products
    WHERE  tile = 1                         -- top 20 %
),
min_change AS (
    SELECT MIN(share_change) AS min_change FROM top_20_percent
)
SELECT  tp.prod_id,
        pr.prod_name,
        ROUND(tp.share_change,4) AS share_change
FROM    top_20_percent tp
JOIN    min_change    mc ON tp.share_change = mc.min_change
JOIN    products      pr ON pr.prod_id     = tp.prod_id;
```
