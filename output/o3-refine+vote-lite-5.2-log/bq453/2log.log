```sql
/*  Variant statistics on chr17 : 41 196 311‑41 277 499               */
/*  – reference/alternate alleles                                    */
/*  – distinct alternate bases (comma‑separated if multi‑allelic)    */
/*  – variant type (VT column)                                       */
/*  – χ² score from Hardy‑Weinberg equilibrium                       */
/*  – total genotypes, observed & expected genotype counts           */
/*  – allele frequency from genotypes and the 1KG AF field           */

WITH filtered_variants AS (
  SELECT
    reference_name,
    start,
    end,
    reference_bases,
    alternate_bases,
    VT AS variant_type,
    AF AS allele_freq_1kg,
    call
  FROM `spider2-public-data.1000_genomes.variants`
  WHERE
    reference_name = '17'
    AND start BETWEEN 41196311 AND 41277499
    -- keep biallelic variants so that allele codes 0/1 map to ref/alt
    AND ARRAY_LENGTH(alternate_bases) = 1
),

expanded AS (
  SELECT
    reference_name,
    start,
    end,
    reference_bases,
    ARRAY_TO_STRING(alternate_bases, ',') AS alternate_bases,
    variant_type,
    allele_freq_1kg,
    c.genotype
  FROM filtered_variants
  CROSS JOIN UNNEST(call) AS c
  WHERE
    -- diploid, non‑missing genotypes only
    ARRAY_LENGTH(c.genotype) = 2
    AND c.genotype[OFFSET(0)] != -1
    AND c.genotype[OFFSET(1)] != -1
),

aggregated AS (
  SELECT
    reference_name,
    start,
    end,
    reference_bases,
    alternate_bases,
    variant_type,
    allele_freq_1kg,
    COUNT(*)                                                  AS total_genotypes,
    COUNTIF(genotype[OFFSET(0)] = 0 AND genotype[OFFSET(1)] = 0)                      AS obs_hom_ref,
    COUNTIF( (genotype[OFFSET(0)] = 0 AND genotype[OFFSET(1)] = 1)
          OR (genotype[OFFSET(0)] = 1 AND genotype[OFFSET(1)] = 0) )                  AS obs_het,
    COUNTIF(genotype[OFFSET(0)] = 1 AND genotype[OFFSET(1)] = 1)                      AS obs_hom_alt
  FROM expanded
  GROUP BY
    reference_name, start, end, reference_bases, alternate_bases, variant_type, allele_freq_1kg
),

stats AS (
  SELECT
    *,
    -- allele frequency of the alternate allele from genotypes
    (2 * obs_hom_alt + obs_het) / (2 * total_genotypes)                               AS allele_frequency,
    POW(1 - ( (2 * obs_hom_alt + obs_het) / (2 * total_genotypes) ), 2)
        * total_genotypes                                                             AS exp_hom_ref,
    2 * ( (2 * obs_hom_alt + obs_het) / (2 * total_genotypes) )
        * (1 - ( (2 * obs_hom_alt + obs_het) / (2 * total_genotypes) ))
        * total_genotypes                                                             AS exp_het,
    POW( ( (2 * obs_hom_alt + obs_het) / (2 * total_genotypes) ), 2)
        * total_genotypes                                                             AS exp_hom_alt
  FROM aggregated
),

final AS (
  SELECT
    reference_name,
    start,
    end,
    reference_bases,
    alternate_bases,
    variant_type,
    ROUND(
        (POW(obs_hom_ref - exp_hom_ref, 2) / NULLIF(exp_hom_ref, 0))
      + (POW(obs_het     - exp_het    , 2) / NULLIF(exp_het    , 0))
      + (POW(obs_hom_alt - exp_hom_alt, 2) / NULLIF(exp_hom_alt, 0))
    , 4)                                                                              AS chi_squared,
    total_genotypes,
    obs_hom_ref,
    obs_het,
    obs_hom_alt,
    ROUND(exp_hom_ref , 4)                                                            AS exp_hom_ref,
    ROUND(exp_het     , 4)                                                            AS exp_het,
    ROUND(exp_hom_alt , 4)                                                            AS exp_hom_alt,
    ROUND(allele_frequency, 4)                                                        AS allele_frequency,
    allele_freq_1kg                                                                   AS allele_freq_1kg
  FROM stats
)

SELECT *
FROM final
ORDER BY start;
```
