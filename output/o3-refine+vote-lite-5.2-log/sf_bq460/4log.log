('yourselves'),('youve')
),

/* -------------------------------------------------
   2.  tokenise each article body & remove stop‑words
--------------------------------------------------*/
article_words AS (   
    SELECT  
        n."id"                                              AS id,
        LOWER(f.value::STRING)                              AS word
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN( INPUT => SPLIT(
                                REGEXP_REPLACE(LOWER(n."body"),'[^a-z0-9]+',' '),
                                ' ')) f
    WHERE f.value IS NOT NULL
      AND f.value <> ''
      AND NOT EXISTS (SELECT 1 FROM stopwords s WHERE s.word = LOWER(f.value::STRING))
),

/* -------------------------------------------------
   3.  attach frequency & GloVe vector for each word
--------------------------------------------------*/
word_details AS (
    SELECT  
        aw.id,
        gv."vector"              AS vector_var,
        wf."frequency"           AS freq
    FROM article_words aw
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
         ON gv."word" = aw.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON wf."word" = aw.word
),

/* -------------------------------------------------
   4.  weight vectors and expand into dimensions
--------------------------------------------------*/
article_dims AS (
    SELECT  
        wd.id,
        vec.seq                                  AS dim,
        (vec.value::FLOAT) / POWER(wd.freq,0.4)  AS weighted_val
    FROM word_details wd,
         LATERAL FLATTEN( INPUT => wd.vector_var ) vec
),

/* -------------------------------------------------
   5.  aggregate weighted vectors per article
--------------------------------------------------*/
article_vector AS (
    SELECT  
        id,
        dim,
        SUM( weighted_val )      AS dim_val
    FROM article_dims
    GROUP BY id, dim
),

/* -------------------------------------------------
   6.  compute vector norm for each article
--------------------------------------------------*/
article_norm AS (
    SELECT 
        id,
        SQRT( SUM( dim_val * dim_val ) )  AS norm
    FROM article_vector
    GROUP BY id
),

/* -------------------------------------------------
   7.  normalise each article vector to unit length
--------------------------------------------------*/
article_vector_norm AS (    
    SELECT  
        v.id,
        v.dim,
        v.dim_val / n.norm       AS norm_val
    FROM article_vector v
    JOIN article_norm  n ON n.id = v.id
    WHERE n.norm > 0
),

/* -------------------------------------------------
   8.  pick normalised vector for the target article
--------------------------------------------------*/
target_vector AS (
    SELECT  
        dim,
        norm_val                 AS tgt_val
    FROM article_vector_norm
    WHERE id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),

/* -------------------------------------------------
