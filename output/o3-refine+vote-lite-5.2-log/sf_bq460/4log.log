--------------------------------------------------*/
cosine_scores AS (
    SELECT  
        avn.id,
        SUM( avn.norm_val * tv.tgt_val )  AS cosine_sim
    FROM article_vector_norm avn
    JOIN target_vector      tv ON tv.dim = avn.dim
    GROUP BY avn.id
)

/* -------------------------------------------------
   10.  return top‑10 most similar articles (exclude self)
--------------------------------------------------*/
SELECT  
    cs.id,
    n."date",
    n."title",
    cs.cosine_sim          AS similarity
FROM cosine_scores cs
JOIN WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
     ON n."id" = cs.id
WHERE cs.id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
ORDER BY cs.cosine_sim DESC NULLS LAST, cs.id
LIMIT 10;
