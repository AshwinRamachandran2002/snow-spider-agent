2025-05-02 06:01:50 - Thread-468 (execute) - INFO - [Try to run SQL in self-refine]
```sql
WITH downloads AS (           -- total download count per package
    SELECT
        "project"                        AS "name",
        COUNT(*)                         AS "download_cnt"
    FROM PYPI.PYPI.FILE_DOWNLOADS
    GROUP BY "project"
),
latest_meta AS (             -- keep only most‑recent version of every package
    SELECT  *
    FROM   (
        SELECT
            dm.*,
            ROW_NUMBER() OVER (PARTITION BY dm."name"
                               ORDER BY dm."upload_time" DESC) AS rn
        FROM PYPI.PYPI.DISTRIBUTION_METADATA dm
    )
    WHERE rn = 1
),
github_urls AS (             -- extract & clean GitHub URLs
    SELECT
        lm."name",
        COALESCE(d."download_cnt",0)     AS "download_cnt",
        REGEXP_REPLACE(
            LOWER(f.value::string),
            '^https?://github\\.com/([^/]+/[^/#?]+)(/.*)?$',
            'https://github.com/\\1'
        )                                AS "github_url"
    FROM latest_meta  lm
    LEFT JOIN downloads d
           ON lm."name" = d."name"
    , LATERAL FLATTEN(
          INPUT => CASE
                      WHEN TYPEOF(lm."project_urls") IN ('ARRAY','OBJECT')
                           THEN lm."project_urls"
                      ELSE NULL
                   END
      ) f
    WHERE LOWER(f.value::string) LIKE 'http%github.com/%'
),
per_package AS (             -- one cleaned URL per package
    SELECT
        "name",
        MAX("download_cnt")            AS "download_cnt",
        MIN("github_url")              AS "github_url"   -- deterministic pick
    FROM github_urls
    GROUP BY "name"
)
SELECT
    "github_url"
FROM per_package
ORDER BY "download_cnt" DESC NULLS LAST, "name"
LIMIT 3;
```
