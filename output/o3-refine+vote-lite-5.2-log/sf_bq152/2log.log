/*---------------------------------------------------------------------------
 Copy‑number‑variation landscape per cytoband in TCGA‑BRCA (GDC release 23)
---------------------------------------------------------------------------*/
WITH
/* ---------- reference cytobands (hg38) ---------------------------------- */
cytoband AS (
    SELECT
        REGEXP_REPLACE("chrom", '^chr', '')             AS "chr",
        "chromStart"                                    AS "band_start",
        "chromEnd"                                      AS "band_end",
        "name"                                          AS "band_name"
    FROM GENOME_REFERENCE.CYTOBAND_HG38                 -- public reference
),
/* ---------- BRCA copy‑number segments ----------------------------------- */
seg AS (
    SELECT
        "case_barcode",
        REGEXP_REPLACE("chromosome", '^chr', '')        AS "chr",
        "start_pos",
        "end_pos",
        "segment_mean"
    FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.COPY_NUMBER_SEGMENT_MASKED_R14
    WHERE "project_short_name" = 'TCGA-BRCA'
),
/* ---------- list of distinct BRCA cases -------------------------------- */
cases AS (
    SELECT DISTINCT "case_barcode" FROM seg
),
/* ---------- segment ↔ cytoband overlap --------------------------------- */
ovl AS (
    SELECT
        s."case_barcode",
        c."band_name",
        c."band_start",
        c."band_end",
        LEAST(s."end_pos",  c."band_end")
          - GREATEST(s."start_pos", c."band_start") + 1     AS "ov_len",
        2 * POW(2 , s."segment_mean")                       AS "abs_cn"
    FROM seg s
    JOIN cytoband c
      ON c."chr" = s."chr"
     AND s."end_pos"   >= c."band_start"
     AND s."start_pos" <= c."band_end"
),
/* ---------- length‑weighted CN per cytoband & case ---------------------- */
band_case AS (
    SELECT
        "case_barcode",
        "band_name",
        "band_start",
        "band_end",
        ROUND( SUM(abs_cn * ov_len) / SUM(ov_len) )         AS "rounded_cn"
    FROM ovl
    GROUP BY "case_barcode","band_name","band_start","band_end"
),
/* ---------- ensure every case has every band (missing ⇒ diploid (2)) ---- */
all_pairs AS (
    SELECT
        cb."band_name",
        cb."band_start",
        cb."band_end",
        cs."case_barcode",
        COALESCE(bc."rounded_cn", 2)                        AS "rounded_cn"
    FROM cytoband cb
    CROSS JOIN cases cs
    LEFT JOIN band_case bc
      ON bc."band_name"    = cb."band_name"
     AND bc."case_barcode" = cs."case_barcode"
),
/* ---------- classify rounded CN ---------------------------------------- */
typed AS (
    SELECT
        "band_name",
        "band_start",
        "band_end",
        CASE
            WHEN rounded_cn = 0 THEN 'HOMO_DEL'
            WHEN rounded_cn = 1 THEN 'HET_DEL'
            WHEN rounded_cn = 2 THEN 'DIPLOID'
            WHEN rounded_cn = 3 THEN 'GAIN'
            ELSE                    'AMPLIFICATION'
        END AS "cnv_type"
    FROM all_pairs
),
tot AS ( SELECT COUNT(*) AS "n_cases" FROM cases )
/* ---------- frequency of CNV classes per cytoband ----------------------- */
SELECT
    t."band_name"                              AS "CYTOBAND",
    t."band_start"                             AS "START_POS",
    t."band_end"                               AS "END_POS",
    ROUND( 100.0 * SUM( IFF(cnv_type='HOMO_DEL'      ,1,0) ) / n_cases , 2) AS "HOMO_DEL_%",
    ROUND( 100.0 * SUM( IFF(cnv_type='HET_DEL'       ,1,0) ) / n_cases , 2) AS "HET_DEL_%",
    ROUND( 100.0 * SUM( IFF(cnv_type='DIPLOID'       ,1,0) ) / n_cases , 2) AS "DIPLOID_%",
    ROUND( 100.0 * SUM( IFF(cnv_type='GAIN'          ,1,0) ) / n_cases , 2) AS "GAIN_%",
    ROUND( 100.0 * SUM( IFF(cnv_type='AMPLIFICATION' ,1,0) ) / n_cases , 2) AS "AMPLIFICATION_%"
FROM typed t
CROSS JOIN tot
GROUP BY t."band_name", t."band_start", t."band_end", n_cases
ORDER BY
    CASE
        WHEN REGEXP_SUBSTR("CYTOBAND", '^[0-9]+') IS NOT NULL
            THEN TO_NUMBER(REGEXP_SUBSTR("CYTOBAND",'^[0-9]+'))
        WHEN REGEXP_SUBSTR("CYTOBAND", '^X') IS NOT NULL THEN 23
        WHEN REGEXP_SUBSTR("CYTOBAND", '^Y') IS NOT NULL THEN 24
        ELSE 25
    END,
    "START_POS";
