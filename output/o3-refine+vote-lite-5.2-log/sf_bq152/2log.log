```sql
/* --------------------------------------------------------------------------
   Copy‑number variation landscape per cytoband in TCGA‑BRCA (GDC release 23)
   --------------------------------------------------------------------------
   1)  COPY_NUMBER_SEGMENT_MASKED_R14  – segment‑level CN (log2((CN/2)))
   2)  GENOME_REFERENCE.CYTOBAND_HG38  – chromosomal cytoband co‑ordinates
   --------------------------------------------------------------------------
   For every BRCA case:
       • overlap every segment with every cytoband on the same chromosome
       • turn segment_mean into absolute CN (  CN = 2*2^segment_mean  )
       • length‑weight the CNs inside the cytoband and round to nearest int
       • classify the rounded value → 0/1/2/3/>3  (see CASE below)
   Finally, for every cytoband, report the % of cases in each CNV class.
---------------------------------------------------------------------------*/
WITH
/* ---- reference cytobands ------------------------------------------------ */
cytoband AS (
  SELECT
      REPLACE("chrom",'chr','')                 AS "chr",
      "chromStart"                              AS "band_start",
      "chromEnd"                                AS "band_end",
      "name"                                    AS "band_name"
  FROM TCGA_HG38_DATA_V0.GENOME_REFERENCE.CYTOBAND_HG38
),
/* ---- BRCA copy‑number segments ----------------------------------------- */
seg AS (
  SELECT
      "case_barcode",
      "chromosome"                              AS "chr",
      "start_pos",
      "end_pos",
      "segment_mean"
  FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.COPY_NUMBER_SEGMENT_MASKED_R14
  WHERE "project_short_name" = 'TCGA-BRCA'
),
/* ---- list of all BRCA cases -------------------------------------------- */
cases AS (
  SELECT DISTINCT "case_barcode" FROM seg
),
/* ---- segment ↔ cytoband overlaps  -------------------------------------- */
overlap AS (
  SELECT
      s."case_barcode",
      c."band_name",
      c."band_start",
      c."band_end",
      /* overlapping length (bp) */
      LEAST(s."end_pos" , c."band_end")   - 
      GREATEST(s."start_pos", c."band_start") + 1         AS ov_len,
      /* absolute copy number for that segment */
      2 * POW(2 , s."segment_mean")                       AS abs_cn
  FROM seg  s
  JOIN cytoband  c
    ON c."chr" = s."chr"
   AND s."end_pos"   >= c."band_start"
   AND s."start_pos" <= c."band_end"
),
/* ---- length‑weighted mean CN per cytoband & case ----------------------- */
band_case_cn AS (
  SELECT
      o."case_barcode",
      o."band_name",
      o."band_start",
      o."band_end",
      ROUND( SUM(o.abs_cn * o.ov_len) / SUM(o.ov_len) )   AS rounded_cn
  FROM overlap o
  GROUP BY o."case_barcode", o."band_name", o."band_start", o."band_end"
),
/* ---- make sure every case has every cytoband (missing ⇒ diploid (2)) --- */
all_case_band AS (
  SELECT
      cb."band_name",
      cb."band_start",
      cb."band_end",
      cs."case_barcode",
      COALESCE(bc.rounded_cn , 2)              AS rounded_cn
  FROM cytoband cb
  CROSS JOIN cases cs
  LEFT JOIN band_case_cn bc
    ON  bc."band_name"    = cb."band_name"
    AND bc."case_barcode" = cs."case_barcode"
),
/* ---- classify rounded CN into CNV types -------------------------------- */
typed AS (
  SELECT
      "band_name",
      "band_start",
      "band_end",
      CASE
        WHEN rounded_cn = 0            THEN 'Homozygous Deletion'
        WHEN rounded_cn = 1            THEN 'Heterozygous Deletion'
        WHEN rounded_cn = 2            THEN 'Diploid'
        WHEN rounded_cn = 3            THEN 'Gain'
        WHEN rounded_cn  > 3           THEN 'Amplification'
      END                               AS cnv_type
  FROM all_case_band
),
tot AS ( SELECT COUNT(*) AS total_cases FROM cases )
/* ---- frequency of each CNV class per cytoband -------------------------- */
SELECT
    t."band_name"                            AS "CYTOBAND",
    t."band_start"                           AS "START_POS",
    t."band_end"                             AS "END_POS",
    ROUND( 100.0 * SUM( IFF(cnv_type='Homozygous Deletion',1,0) ) / tot.total_cases , 2)  AS "HOMO_DEL_%",
    ROUND( 100.0 * SUM( IFF(cnv_type='Heterozygous Deletion',1,0) ) / tot.total_cases , 2)  AS "HET_DEL_%",
    ROUND( 100.0 * SUM( IFF(cnv_type='Diploid',1,0)              ) / tot.total_cases , 2)  AS "DIPLOID_%",
    ROUND( 100.0 * SUM( IFF(cnv_type='Gain',1,0)                 ) / tot.total_cases , 2)  AS "GAIN_%",
    ROUND( 100.0 * SUM( IFF(cnv_type='Amplification',1,0)        ) / tot.total_cases , 2)  AS "AMPLIFICATION_%"
FROM typed  t
CROSS JOIN tot
GROUP BY t."band_name", t."band_start", t."band_end", tot.total_cases
ORDER BY TO_NUMBER(REGEXP_SUBSTR("CYTOBAND", '^[0-9XY]+')), "START_POS";
