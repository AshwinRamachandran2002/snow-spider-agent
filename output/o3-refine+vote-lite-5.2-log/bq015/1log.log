```sql
/* Top 10 Stack Overflow tags that appear in questions
   mentioned inside Hacker News comments from 2014‑01‑01 onward */
WITH hn_refs AS (
  -- 1. Pull every Stack Overflow question reference from HN comments
  SELECT
    id            AS hn_comment_id,
    time,
    -- each element in the array is the numeric Question Id matched
    REGEXP_EXTRACT_ALL(
      LOWER(text),                       -- make matching case‑insensitive
      r'https?://stackoverflow\.com/(?:questions|q)/(\d+)'  -- capture the Id
    ) AS question_ids
  FROM `fh-bigquery.hackernews.comments`
  WHERE time >= UNIX_SECONDS(TIMESTAMP('2014-01-01'))  -- only comments from 2014+
),
mentions AS (
  -- 2. One row per individual mention of a question
  SELECT
    CAST(id_str AS INT64) AS question_id
  FROM hn_refs, UNNEST(question_ids) AS id_str
),
q_with_tags AS (
  -- 3. Join each mentioned question to its tag string in the SO dataset
  SELECT
    m.question_id,
    pq.tags
  FROM mentions AS m
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS pq
  ON m.question_id = pq.id
  WHERE pq.tags IS NOT NULL
)
-- 4. Split the tag string, count, rank
SELECT
  tag,
  COUNT(*) AS mention_count
FROM q_with_tags, UNNEST(SPLIT(tags, '|')) AS tag
GROUP BY tag
ORDER BY mention_count DESC, tag
LIMIT 10;
```
