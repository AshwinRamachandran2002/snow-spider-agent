```sql
-- Top 10 Stack Overflow tags most often referenced in Hacker News comments (2014‑present)
WITH comment_question_mentions AS (
  -- Extract every Stack Overflow question id mentioned in each HN comment
  SELECT
    CAST(id_str AS INT64) AS question_id
  FROM `fh-bigquery.hackernews.comments`,
       UNNEST(
         REGEXP_EXTRACT_ALL(
           text,
           r'https?://(?:www\.)?stackoverflow\.com/questions/([0-9]+)'
         )
       ) AS id_str
  WHERE time >= 1388534400          -- from 2014‑01‑01 UTC onward
),

question_mention_counts AS (
  -- How many times each distinct question was linked
  SELECT
    question_id,
    COUNT(*) AS mention_cnt
  FROM comment_question_mentions
  GROUP BY question_id
),

so_questions_with_counts AS (
  -- Bring in the Stack Overflow tags for those questions
  SELECT
    q.id        AS question_id,
    q.tags      AS tag_string,      -- tags are pipe‑delimited
    qc.mention_cnt
  FROM `bigquery-public-data.stackoverflow.posts_questions` AS q
  JOIN question_mention_counts      AS qc
    ON qc.question_id = q.id
),

tag_mentions AS (
  -- Split the tag string and tally mentions per individual tag
  SELECT
    tag,
    SUM(mention_cnt) AS total_mentions
  FROM so_questions_with_counts,
       UNNEST(SPLIT(tag_string, '|')) AS tag
  GROUP BY tag
)

SELECT
  tag,
  total_mentions
FROM tag_mentions
ORDER BY total_mentions DESC, tag
LIMIT 10;
```
