    JOIN   query_unit   q USING (dim)
    GROUP BY a."id", a."date", a."title"
)

SELECT  "id",
        "date",
        "title",
        cosine_sim AS similarity
FROM    article_query_dot
ORDER BY similarity DESC NULLS LAST, "id"
LIMIT 10;
```
