/* -------------------------------------------------------------
   Helper JavaScript UDFs for basic vector algebra
--------------------------------------------------------------*/
CREATE OR REPLACE TEMPORARY FUNCTION VECTOR_SCALE(vec ARRAY, weight DOUBLE)
RETURNS ARRAY
LANGUAGE JAVASCRIPT
AS
$$
  return vec.map(v => v * weight);
$$;

CREATE OR REPLACE TEMPORARY FUNCTION VECTOR_SUM(arr ARRAY)
RETURNS ARRAY
LANGUAGE JAVASCRIPT
AS
$$
  if (arr.length === 0) return null;
  let sum = arr[0].slice();
  for (let i = 1; i < arr.length; i++){
      for (let j = 0; j < sum.length; j++){
          sum[j] += arr[i][j];
      }
  }
  return sum;
$$;

CREATE OR REPLACE TEMPORARY FUNCTION VECTOR_NORM(vec ARRAY)
RETURNS DOUBLE
LANGUAGE JAVASCRIPT
AS
$$
  return Math.sqrt(vec.reduce((a,v) => a + v*v, 0));
$$;

CREATE OR REPLACE TEMPORARY FUNCTION VECTOR_DIVIDE(vec ARRAY, denom DOUBLE)
RETURNS ARRAY
LANGUAGE JAVASCRIPT
AS
$$
  return vec.map(v => v / denom);
$$;

CREATE OR REPLACE TEMPORARY FUNCTION DOT(vec1 ARRAY, vec2 ARRAY)
RETURNS DOUBLE
LANGUAGE JAVASCRIPT
AS
$$
  let s = 0;
  for (let i = 0; i < vec1.length; i++){
      s += vec1[i] * vec2[i];
  }
  return s;
$$;

/* -------------------------------------------------------------
   Build article‑level vectors
--------------------------------------------------------------*/
WITH stopwords AS (
  SELECT * FROM VALUES
    ('a'),('an'),('the'),('of'),('and'),('or'),('but'),('is'),('are'),
    ('in'),('on'),('for'),('to'),('with'),('by'),('at'),('from'),
    ('as'),('that'),('this'),('these'),('those')
) AS s(word),

articles_tokens AS (
  SELECT
    n."id",
    n."date",
    n."title",
    SPLIT_REGEXP(LOWER(n."body"), '[^a-z]+') AS tokens
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
),

articles_words AS (
  SELECT
    at."id",
    at."date",
    at."title",
    tk.value::string                             AS token
  FROM articles_tokens at,
       LATERAL FLATTEN(input => at.tokens) tk
  WHERE tk.value IS NOT NULL
        AND tk.value <> ''
),

articles_filtered AS (
  SELECT *
  FROM articles_words aw
  LEFT JOIN stopwords s
    ON aw.token = s.word
  WHERE s.word IS NULL
),

articles_vectors AS (
  SELECT
    af."id",
    af."date",
    af."title",
    g."vector"::array                            AS vec,
    wf."frequency"                               AS freq
  FROM articles_filtered af
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  g
       ON g."word" = af.token
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
       ON wf."word" = af.token
),

articles_weighted AS (
  SELECT
    "id",
    "date",
    "title",
    VECTOR_SCALE(vec, 1/POWER(freq, 0.4))        AS wvec
  FROM articles_vectors
),

article_summed AS (
  SELECT
    "id",
    "date",
    "title",
    VECTOR_SUM(ARRAY_AGG(wvec))                  AS vec_sum
  FROM articles_weighted
  GROUP BY "id", "date", "title"
),

article_norm AS (
  SELECT
    "id",
    "date",
    "title",
    VECTOR_DIVIDE(vec_sum, VECTOR_NORM(vec_sum)) AS vec_norm
  FROM article_summed
  WHERE vec_sum IS NOT NULL
)

/* -------------------------------------------------------------
   Build the (weighted & normalised) query vector
--------------------------------------------------------------*/
, query_tokens AS (
  SELECT SPLIT_REGEXP(
           LOWER('Epigenetics and cerebral organoids: promising directions in autism spectrum disorders'),
           '[^a-z]+') AS tokens
), query_words AS (
  SELECT tk.value::string AS token
  FROM query_tokens qt,
       LATERAL FLATTEN(input => qt.tokens) tk
  WHERE tk.value IS NOT NULL
        AND tk.value <> ''
), query_filtered AS (
  SELECT qw.token
  FROM query_words qw
  LEFT JOIN stopwords s
    ON qw.token = s.word
  WHERE s.word IS NULL
), query_vectors AS (
  SELECT
    g."vector"::array                  AS vec,
    wf."frequency"                     AS freq
  FROM query_filtered qf
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  g
       ON g."word" = qf.token
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
       ON wf."word" = qf.token
), query_weighted AS (
  SELECT VECTOR_SCALE(vec, 1/POWER(freq, 0.4))   AS wvec
  FROM query_vectors
), query_sum AS (
  SELECT VECTOR_SUM(ARRAY_AGG(wvec))             AS vec_sum
  FROM query_weighted
), query_norm AS (
  SELECT VECTOR_DIVIDE(vec_sum, VECTOR_NORM(vec_sum)) AS vec_norm
  FROM query_sum
)

/* -------------------------------------------------------------
   Cosine similarity & final ranking
--------------------------------------------------------------*/
SELECT
  a."id",
  a."date",
  a."title",
  DOT(a.vec_norm, q.vec_norm)                    AS similarity
FROM article_norm a,
     query_norm  q
ORDER BY similarity DESC NULLS LAST, a."id"
LIMIT 10;
```
