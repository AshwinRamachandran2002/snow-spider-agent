```sql
WITH airports AS (
    SELECT
        airport_code,
        json_extract(city,'$.en')                      AS city,
        CAST(substr(coordinates,2,
             instr(coordinates,',')-2) AS REAL)       AS lon,
        CAST(substr(coordinates,
             instr(coordinates,',')+1,
             length(coordinates)-instr(coordinates,',')-1) AS REAL) AS lat
    FROM airports_data
),
routes AS (                       -- every distinct airport‑to‑airport route
    SELECT DISTINCT
        departure_airport,
        arrival_airport
    FROM flights
),
routes_coords AS (                -- add co‑ordinates & cities
    SELECT
        r.departure_airport,
        r.arrival_airport,
        da.city  AS dep_city,
        aa.city  AS arr_city,
        da.lat   AS dep_lat,
        da.lon   AS dep_lon,
        aa.lat   AS arr_lat,
        aa.lon   AS arr_lon
    FROM routes r
    JOIN airports da ON da.airport_code = r.departure_airport
    JOIN airports aa ON aa.airport_code = r.arrival_airport
    WHERE da.city IS NOT NULL
      AND aa.city IS NOT NULL
),
city_pairs AS (                   -- unordered city pairs with distance for each route
    SELECT
        CASE WHEN dep_city < arr_city THEN dep_city ELSE arr_city END AS city1,
        CASE WHEN dep_city < arr_city THEN arr_city ELSE dep_city END AS city2,
        6371 * acos(                 -- great‑circle distance (km)
              sin(dep_lat*0.017453292519943) * sin(arr_lat*0.017453292519943) +
              cos(dep_lat*0.017453292519943) * cos(arr_lat*0.017453292519943) *
              cos((arr_lon-dep_lon)*0.017453292519943)
        ) AS distance
    FROM routes_coords
    WHERE dep_city <> arr_city
),
avg_city_distance AS (            -- average distance per city pair
    SELECT city1, city2, AVG(distance) AS avg_distance
    FROM city_pairs
    GROUP BY city1, city2
),
bucketed AS (                     -- put each pair into a distance bucket
    SELECT
        city1,
        city2,
        CASE
            WHEN avg_distance < 1000 THEN '0'
            WHEN avg_distance < 2000 THEN '1000'
            WHEN avg_distance < 3000 THEN '2000'
            WHEN avg_distance < 4000 THEN '3000'
            WHEN avg_distance < 5000 THEN '4000'
            WHEN avg_distance < 6000 THEN '5000'
            ELSE '6000+'
        END AS bucket
    FROM avg_city_distance
),
bucket_counts AS (                -- how many pairs per bucket
    SELECT bucket, COUNT(*) AS pair_count
    FROM bucketed
    GROUP BY bucket
)
SELECT MIN(pair_count) AS fewest_pairs    -- number of pairs in the sparsest bucket
FROM bucket_counts;
```
