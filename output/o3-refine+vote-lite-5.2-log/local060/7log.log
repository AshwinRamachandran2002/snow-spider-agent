2025-05-02 07:47:20 - Thread-3456 (execute) - INFO - [Try to run SQL in self-refine]
```sql
WITH relevant_cities AS (
    /* cities in the U‑S whose Q4 2020 sales (no promo) are ≥ 120 % of Q4 2019 */
    SELECT
        cu.cust_city                                                       AS city,
        SUM(CASE WHEN ti.calendar_year = 2019 THEN sa.amount_sold END)     AS sales_2019,
        SUM(CASE WHEN ti.calendar_year = 2020 THEN sa.amount_sold END)     AS sales_2020
    FROM   sales      sa
    JOIN   customers  cu ON sa.cust_id  = cu.cust_id
    JOIN   countries  co ON cu.country_id = co.country_id
    JOIN   times      ti ON sa.time_id  = ti.time_id
    WHERE  co.country_name           = 'United States'
      AND  ti.calendar_quarter_number = 4
      AND  ti.calendar_year          IN (2019, 2020)
      AND  sa.promo_id               = 0              -- “no promotion”
    GROUP  BY cu.cust_city
    HAVING sales_2019 > 0
       AND sales_2020 >= 1.20 * sales_2019
),
city_year_totals AS (
    /* total sales for the kept cities (used for market‑share denominators) */
    SELECT
        ti.calendar_year AS yr,
        SUM(sa.amount_sold) AS total_sales
    FROM   sales      sa
    JOIN   customers  cu ON sa.cust_id  = cu.cust_id
    JOIN   countries  co ON cu.country_id = co.country_id
    JOIN   times      ti ON sa.time_id  = ti.time_id
    WHERE  co.country_name           = 'United States'
      AND  ti.calendar_quarter_number = 4
      AND  ti.calendar_year          IN (2019, 2020)
      AND  sa.promo_id               = 0
      AND  cu.cust_city IN (SELECT city FROM relevant_cities)
    GROUP  BY ti.calendar_year
),
product_qtr_sales AS (
    /* sales per product in the qualifying cities and quarters */
    SELECT
        sa.prod_id,
        ti.calendar_year AS yr,
        SUM(sa.amount_sold) AS prod_sales
    FROM   sales      sa
    JOIN   customers  cu ON sa.cust_id  = cu.cust_id
    JOIN   countries  co ON cu.country_id = co.country_id
    JOIN   times      ti ON sa.time_id  = ti.time_id
    WHERE  co.country_name           = 'United States'
      AND  ti.calendar_quarter_number = 4
      AND  ti.calendar_year          IN (2019, 2020)
      AND  sa.promo_id               = 0
      AND  cu.cust_city IN (SELECT city FROM relevant_cities)
    GROUP  BY sa.prod_id, ti.calendar_year
),
ranked_products AS (
    /* rank products by combined Q4‑19 + Q4‑20 sales, split into 5 equal buckets */
    SELECT
        prod_id,
        SUM(prod_sales)                                AS total_sales,
        NTILE(5) OVER (ORDER BY SUM(prod_sales) DESC)  AS bucket
    FROM product_qtr_sales
    GROUP BY prod_id
),
top_products AS (
    /* keep the top 20 % (bucket = 1) */
    SELECT prod_id
    FROM   ranked_products
    WHERE  bucket = 1
),
product_share AS (
    /* sales of each top product by year */
    SELECT
        pq.prod_id,
        SUM(CASE WHEN pq.yr = 2019 THEN pq.prod_sales END) AS sales_2019,
        SUM(CASE WHEN pq.yr = 2020 THEN pq.prod_sales END) AS sales_2020
    FROM   product_qtr_sales pq
    WHERE  pq.prod_id IN (SELECT prod_id FROM top_products)
    GROUP  BY pq.prod_id
),
totals AS (
    /* bring yearly totals onto one row for easy division */
    SELECT
        MAX(CASE WHEN yr = 2019 THEN total_sales END) AS tot_2019,
        MAX(CASE WHEN yr = 2020 THEN total_sales END) AS tot_2020
    FROM city_year_totals
)
SELECT
    ps.prod_id,
    pr.prod_name,
    ROUND(ps.sales_2019 / t.tot_2019, 4) AS share_2019,
    ROUND(ps.sales_2020 / t.tot_2020, 4) AS share_2020,
    ROUND(ps.sales_2020 / t.tot_2020 - ps.sales_2019 / t.tot_2019, 4) AS share_change
FROM   product_share ps
CROSS  JOIN totals t
LEFT  JOIN products pr ON pr.prod_id = ps.prod_id
ORDER BY share_change DESC, ps.prod_id;
```
