WITH no_promo_sales AS (
    /* keep only rows that do not match any promotion ( “no promotion” ) */
    SELECT  sa.*
    FROM    sales sa
    LEFT    JOIN promotions p
                 ON sa.promo_id = p.promo_id
    WHERE   p.promo_id IS NULL
),
relevant_cities AS (
    /* U‑S cities whose Q4‑20 sales are at least 20 % higher than Q4‑19 */
    SELECT
        cu.cust_city                                                          AS city,
        SUM(CASE WHEN ti.calendar_year = 2019 THEN nps.amount_sold END) AS sales_2019,
        SUM(CASE WHEN ti.calendar_year = 2020 THEN nps.amount_sold END) AS sales_2020
    FROM   no_promo_sales nps
    JOIN   customers      cu ON nps.cust_id  = cu.cust_id
    JOIN   countries      co ON cu.country_id = co.country_id
    JOIN   times          ti ON nps.time_id  = ti.time_id
    WHERE  co.country_name LIKE 'United States%'      -- United States only
      AND  ti.calendar_quarter_number = 4             -- Q4
      AND  ti.calendar_year IN (2019, 2020)
    GROUP  BY cu.cust_city
    HAVING sales_2019 > 0
       AND sales_2020 >= 1.20 * sales_2019
),
city_year_totals AS (
