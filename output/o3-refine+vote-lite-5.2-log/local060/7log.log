           ON sa.promo_id = p.promo_id
    /* a row is “no‑promo” when either (a) it has no matching promo record,
       or (b) its promo is explicitly classified as “No Promotion”            */
    WHERE  p.promo_id IS NULL
       OR  p.promo_category = 'No Promotion'
),
q4_dates AS (                          /* all dates in Q4‑2019 or Q4‑2020      */
    SELECT time_id,
           calendar_year
    FROM   times
    WHERE  calendar_year IN (2019, 2020)
      AND  calendar_quarter_number = 4
),
us_customers AS (                      /* customers located in the U‑S         */
    SELECT cu.cust_id,
           cu.cust_city
    FROM   customers cu
    JOIN   countries co ON cu.country_id = co.country_id
    WHERE  co.country_iso_code = 'US'
       OR  co.country_name      LIKE 'United States%'
),
city_year_sales AS (                   /* Q4 sales per city & year (no‑promo)  */
    SELECT uc.cust_city                    AS city,
           q4.calendar_year                AS yr,
           SUM(nps.amount_sold)            AS amt
    FROM   no_promo_sales nps
    JOIN   q4_dates     q4 ON nps.time_id = q4.time_id
    JOIN   us_customers uc ON nps.cust_id = uc.cust_id
    GROUP  BY uc.cust_city, q4.calendar_year
),
relevant_cities AS (                    /* cities whose sales grew ≥ 20 %       */
    SELECT s19.city
    FROM   city_year_sales s19
    JOIN   city_year_sales s20
           ON s20.city = s19.city
          AND s20.yr   = 2020
    WHERE  s19.yr   = 2019
      AND  s19.amt  > 0                       -- avoid divide‑by‑zero cases
      AND  s20.amt  >= 1.20 * s19.amt
),
city_totals AS (                        /* total Q4 sales in the kept cities    */
    SELECT q4.calendar_year              AS yr,
           SUM(nps.amount_sold)          AS tot_amt
    FROM   no_promo_sales nps
    JOIN   q4_dates     q4 ON nps.time_id = q4.time_id
    JOIN   us_customers uc ON nps.cust_id = uc.cust_id
    WHERE  uc.cust_city IN (SELECT city FROM relevant_cities)
    GROUP  BY q4.calendar_year
),
product_sales AS (                      /* Q4 sales per product & year          */
    SELECT nps.prod_id,
           q4.calendar_year              AS yr,
           SUM(nps.amount_sold)          AS amt
    FROM   no_promo_sales nps
    JOIN   q4_dates     q4 ON nps.time_id = q4.time_id
    JOIN   us_customers uc ON nps.cust_id = uc.cust_id
    WHERE  uc.cust_city IN (SELECT city FROM relevant_cities)
    GROUP  BY nps.prod_id, q4.calendar_year
),
product_ranking AS (                    /* rank by combined Q4‑19 + Q4‑20 sales */
    SELECT prod_id,
           SUM(amt)                                     AS total_amt,
           ROW_NUMBER() OVER (ORDER BY SUM(amt) DESC)    AS rn,
           COUNT(*)    OVER ()                          AS cnt
    FROM   product_sales
    GROUP  BY prod_id
),
top_products AS (                       /* top 20 % ≈ first 0.20 * cnt rows     */
    SELECT prod_id
    FROM   product_ranking
    WHERE  rn <= cnt * 0.20
),
top_product_sales AS (                  /* yearly amounts for each top product  */
    SELECT
        ps.prod_id,
        SUM(CASE WHEN ps.yr = 2019 THEN ps.amt END) AS amt_2019,
        SUM(CASE WHEN ps.yr = 2020 THEN ps.amt END) AS amt_2020
    FROM   product_sales ps
    WHERE  ps.prod_id IN (SELECT prod_id FROM top_products)
    GROUP  BY ps.prod_id
),
year_denoms AS (                        /* denominators (city totals) on 1 row  */
    SELECT
        MAX(CASE WHEN yr = 2019 THEN tot_amt END) AS tot_2019,
        MAX(CASE WHEN yr = 2020 THEN tot_amt END) AS tot_2020
    FROM   city_totals
)
SELECT
    tps.prod_id,
    pr.prod_name,
    ROUND(1.0 * tps.amt_2019 / yd.tot_2019, 4)  AS share_2019,
    ROUND(1.0 * tps.amt_2020 / yd.tot_2020, 4)  AS share_2020,
    ROUND(1.0 * tps.amt_2020 / yd.tot_2020
        - 1.0 * tps.amt_2019 / yd.tot_2019, 4)  AS share_change
FROM   top_product_sales  tps
CROSS  JOIN year_denoms  yd
LEFT   JOIN products      pr  ON pr.prod_id = tps.prod_id
ORDER  BY share_change DESC,
          tps.prod_id;
```
