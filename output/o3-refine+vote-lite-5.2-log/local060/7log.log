    JOIN   city_sales c20
           ON c20.city = c19.city
          AND c20.yr   = 2020
    WHERE  c19.yr      = 2019
      AND  c20.sales   >= 1.20 * c19.sales
),
city_year_totals AS (             /* total Q4 sales in the kept cities        */
    SELECT tq.calendar_year AS yr,
           SUM(nps.amount_sold) AS total_sales
    FROM   no_promo_sales nps
    JOIN   times_q4     tq ON nps.time_id = tq.time_id
    JOIN   us_customers uc ON nps.cust_id = uc.cust_id
    WHERE  uc.cust_city IN (SELECT city FROM relevant_cities)
    GROUP  BY tq.calendar_year
),
product_qtr_sales AS (            /* Q4 sales per product & year in cities    */
    SELECT nps.prod_id,
