    FROM city_year_totals
)
SELECT
    ps.prod_id,
    pr.prod_name,
    ROUND(1.0 * ps.sales_2019 / t.tot_2019, 4) AS share_2019,
    ROUND(1.0 * ps.sales_2020 / t.tot_2020, 4) AS share_2020,
    ROUND(1.0 * ps.share_2020 - ps.share_2019, 4)        AS share_change
FROM (
