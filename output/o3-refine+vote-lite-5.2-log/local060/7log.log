    GROUP  BY nps.prod_id, tq.calendar_year
),
ranked_products AS (              /* rank products by combined Q4 sales       */
    SELECT prod_id,
           SUM(prod_sales)                           AS total_sales,
           ROW_NUMBER() OVER (ORDER BY SUM(prod_sales) DESC) AS rn,
           COUNT(*)    OVER ()                      AS cnt
    FROM   product_qtr_sales
    GROUP  BY prod_id
),
top_products AS (                 /* top 20 % products                        */
