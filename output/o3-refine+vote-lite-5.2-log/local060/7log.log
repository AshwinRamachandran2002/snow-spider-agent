),
city_sales AS (                   /* Q4 sales per city & year (no promo)      */
    SELECT uc.cust_city          AS city,
           tq.calendar_year      AS yr,
           SUM(nps.amount_sold)  AS sales
    FROM   no_promo_sales nps
    JOIN   times_q4     tq ON nps.time_id = tq.time_id
    JOIN   us_customers uc ON nps.cust_id = uc.cust_id
    GROUP  BY uc.cust_city, tq.calendar_year
),
relevant_cities AS (              /* cities with ≥20 % Q4 sales growth        */
    SELECT c19.city
