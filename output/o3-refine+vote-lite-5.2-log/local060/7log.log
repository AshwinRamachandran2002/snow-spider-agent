WITH no_promo_sales AS (          /* sales rows that have no matching promo */
    SELECT  sa.*
    FROM    sales sa
    LEFT    JOIN promotions p
               ON sa.promo_id = p.promo_id
    WHERE   p.promo_id IS NULL
),
times_q4 AS (                     /* Q4 2019 & 2020 dates                     */
    SELECT time_id, calendar_year
    FROM   times
    WHERE  calendar_year IN (2019, 2020)
      AND  calendar_quarter_number = 4
),
us_customers AS (                 /* customers located in the U‑S             */
    SELECT cu.cust_id,
