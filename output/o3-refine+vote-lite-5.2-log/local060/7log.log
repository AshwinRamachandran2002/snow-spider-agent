           1.0 * ps.sales_2019 / t.tot_2019 AS share_2019,
           1.0 * ps.sales_2020 / t.tot_2020 AS share_2020
    FROM   product_share ps CROSS JOIN totals t
) ps
CROSS JOIN totals t
LEFT  JOIN products pr ON pr.prod_id = ps.prod_id
ORDER BY share_change DESC, ps.prod_id;
