/* ---------------------------------------------------------------------------
   Define a temporary JavaScript UDF that converts an Ethereum‑style hex
   address to its equivalent TRON (Base58 / TronLink) address
---------------------------------------------------------------------------*/
CREATE OR REPLACE TEMPORARY FUNCTION "hexToTron"(hex_addr STRING)
RETURNS STRING
LANGUAGE JAVASCRIPT
AS
$$
function encode58(buffer) {
    const ALPHABET = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
    const BASE     = BigInt(58);
    let num        = BigInt('0x' + buffer.toString('hex'));
    let encoded    = '';

    while (num > 0n) {
        const rem = num % BASE;
        encoded   = ALPHABET[Number(rem)] + encoded;
        num       = num / BASE;
    }
    /* handle leading zero‑bytes */
    for (let i = 0; i < buffer.length && buffer[i] === 0; i++) {
        encoded = '1' + encoded;
    }
    return encoded;
}

function sha256(buf) {
    return require('crypto')
           .createHash('sha256')
           .update(buf)
           .digest();
}

hex_addr = (hex_addr || '').startsWith('0x') ? hex_addr.slice(2) : (hex_addr || '');
if (hex_addr.length !== 40) return null;          // expect 20‑byte address

/* prepend 0x41 for TRON main‑net */
const addrBytes   = Buffer.from('41' + hex_addr, 'hex');
const checksum    = sha256(sha256(addrBytes)).slice(0, 4);   // double‑SHA‑256, first 4 bytes
const tronBuffer  = Buffer.concat([addrBytes, checksum]);

return encode58(tronBuffer);
$$
;

/* ---------------------------------------------------------------------------
   Retrieve the three largest USDT transfers and show addresses in TronLink format
---------------------------------------------------------------------------*/
WITH usdt_transfers AS (
    SELECT
        "BLOCK_NUMBER",
        PARSE_JSON("ARGS")[0]::STRING                         AS FROM_HEX,
        PARSE_JSON("ARGS")[1]::STRING                         AS TO_HEX,
        (PARSE_JSON("ARGS")[2]::NUMBER / 1000000)             AS TRANSFER_AMOUNT
    FROM
        "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE
        LOWER("ADDRESS")       = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'   -- USDT contract
        AND LOWER("EVENT_HASH") = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef' -- Transfer event
)
SELECT
    "BLOCK_NUMBER",
    "hexToTron"(FROM_HEX) AS "SOURCE_ADDRESS_TRONLINK",
    "hexToTron"(TO_HEX)   AS "DESTINATION_ADDRESS_TRONLINK",
    TRANSFER_AMOUNT       AS "USDT_AMOUNT"
FROM
    usdt_transfers
ORDER BY
    TRANSFER_AMOUNT DESC NULLS LAST,
    "BLOCK_NUMBER"  DESC
LIMIT 3;
```
