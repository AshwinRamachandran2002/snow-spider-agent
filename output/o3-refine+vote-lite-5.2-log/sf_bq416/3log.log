BEGIN
  /* ── 1. Create a temporary JS UDF to convert 0x‑hex addresses to TronLink ── */
  CREATE OR REPLACE TEMPORARY FUNCTION HEX_TO_TRON(hex_addr STRING)
    RETURNS STRING
    LANGUAGE JAVASCRIPT
  AS
  $$
    function sha256(bytes) {
      const crypto = require('crypto');
      return Uint8Array.from(
        crypto.createHash('sha256').update(Buffer.from(bytes)).digest()
      );
    }
    function encode58(bytes) {
      const ALPHABET = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
      let digits = [0];
      for (let i = 0; i < bytes.length; i++) {
        let carry = bytes[i];
        for (let j = 0; j < digits.length; j++) {
          carry += digits[j] << 8;
          digits[j] = carry % 58;
          carry = (carry / 58) | 0;
        }
        while (carry) {
          digits.push(carry % 58);
          carry = (carry / 58) | 0;
        }
      }
      for (let k = 0; k < bytes.length && bytes[k] === 0; k++) {
        digits.push(0);
      }
      return digits.reverse().map(d => ALPHABET[d]).join('');
    }
    if (!hex_addr) return null;
    const clean = hex_addr.replace(/^0x/i, '').toLowerCase();
    if (clean.length !== 40) return null;                 // must be 20 bytes
    const addr = new Uint8Array(21);                      // 1‑byte prefix + 20
    addr[0] = 0x41;                                       // TRON main‑net prefix
    for (let i = 0; i < 20; i++) {
      addr[i + 1] = parseInt(clean.substr(i * 2, 2), 16);
    }
    const check = sha256(sha256(addr)).slice(0, 4);       // double‑SHA256
    const full  = new Uint8Array(addr.length + 4);
    full.set(addr);
    full.set(check, addr.length);
    return encode58(full);
  $$;

  /* ── 2. Extract and rank the largest USDT transfer logs on TRON ──────────── */
  RETURN
  WITH raw_logs AS (
    SELECT
        "block_number"              AS BLOCK_NUMBER,
        "topics"                    AS TOPICS,
        "data"                      AS DATA_HEX
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE  LOWER("address") = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'          -- USDT TRON
       AND TOPICS[0]::STRING = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'  -- Transfer
  ),
  parsed AS (
    SELECT
        BLOCK_NUMBER,
        CONCAT('0x', RIGHT(TOPICS[1]::STRING, 40)) AS FROM_ADDRESS,
        CONCAT('0x', RIGHT(TOPICS[2]::STRING, 40)) AS TO_ADDRESS_RAW,
        TO_NUMBER(SUBSTR(DATA_HEX, 3), 16)         AS RAW_VALUE
    FROM raw_logs
  )
  SELECT
      BLOCK_NUMBER,
      FROM_ADDRESS                               AS SOURCE_ADDRESS,
      HEX_TO_TRON(TO_ADDRESS_RAW)                AS DESTINATION_ADDRESS_TRON,
      TO_DECIMAL(RAW_VALUE / 1000000, 38, 4)     AS USDT_AMOUNT
  FROM parsed
  ORDER BY USDT_AMOUNT DESC NULLS LAST, BLOCK_NUMBER DESC
  LIMIT 3;
END;
