/* ──────────────────────────────────────────────────────────────────────────────
   1.  Create (or replace) a temporary JavaScript UDF that converts a 20‑byte
       hex‑encoded address (prefixed with 0x) into a TRON Base58 (TronLink)
       address.
   2.  Query the decoded Transfer events of the USDT contract on TRON,
       convert the destination address, scale the raw value by 1,000,000
       (USDT has 6 decimals), and return the three largest transfers.
   ─────────────────────────────────────────────────────────────────────────── */
CREATE OR REPLACE TEMPORARY FUNCTION HEX_TO_TRON(hex_addr STRING)
  RETURNS STRING
  LANGUAGE JAVASCRIPT
  AS
$$
  // ── helpers ───────────────────────────────────────────────────────────────
  function sha256(bytes) {
    const crypto = require('crypto');
    return Uint8Array.from(
      crypto.createHash('sha256').update(Buffer.from(bytes)).digest()
    );
  }
  function encode58(bytes) {
    const ALPHABET = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
    let digits = [0];
    for (let i = 0; i < bytes.length; i++) {
      let carry = bytes[i];
      for (let j = 0; j < digits.length; j++) {
        carry += digits[j] << 8;
        digits[j] = carry % 58;
        carry = (carry / 58) | 0;
      }
      while (carry) {
        digits.push(carry % 58);
        carry = (carry / 58) | 0;
      }
    }
    // handle leading zeros
    for (let k = 0; k < bytes.length && bytes[k] === 0; k++) {
      digits.push(0);
    }
    return digits.reverse().map(d => ALPHABET[d]).join('');
  }
  // ── main ──────────────────────────────────────────────────────────────────
  if (!hex_addr) return null;
  const clean = hex_addr.replace(/^0x/i, '').toLowerCase();
  if (clean.length !== 40) return null;               // must be 20 bytes
  const addr = new Uint8Array(21);                    // 1‑byte prefix + 20
  addr[0] = 0x41;                                     // TRON main‑net prefix
  for (let i = 0; i < 20; i++) {
    addr[i + 1] = parseInt(clean.substr(i * 2, 2), 16);
  }
  const check = sha256(sha256(addr)).slice(0, 4);     // double‑SHA256 checksum
  const full  = new Uint8Array(addr.length + 4);
  full.set(addr);
  full.set(check, addr.length);
  return encode58(full);
$$;

WITH usdt_transfers AS (
  SELECT
      "BLOCK_NUMBER",
      PARSE_JSON("ARGS")[0]::STRING  AS "FROM_ADDRESS",
      PARSE_JSON("ARGS")[1]::STRING  AS "TO_ADDRESS_RAW",
      PARSE_JSON("ARGS")[2]::NUMBER  AS "RAW_VALUE"
  FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
  WHERE  LOWER("ADDRESS")   = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'  -- USDT
     AND "EVENT_HASH"       = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'  -- Transfer
)
SELECT
    "BLOCK_NUMBER",
    "FROM_ADDRESS"                                                   AS "SOURCE_ADDRESS",
    HEX_TO_TRON("TO_ADDRESS_RAW")                                    AS "DESTINATION_ADDRESS_TRON",
    TO_DECIMAL("RAW_VALUE" / 1_000_000, 38, 4)                       AS "USDT_AMOUNT"
FROM usdt_transfers
ORDER BY "USDT_AMOUNT" DESC NULLS LAST, "BLOCK_NUMBER" DESC
LIMIT 3;
```
