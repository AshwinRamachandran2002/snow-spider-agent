```sql
WITH pop_21plus AS (
  -- 1. 2010 population aged 21+ for every ZIP code
  SELECT
    zipcode,
    SUM(population) AS population_21plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE gender IS NULL                             -- total (not male / female split)
    AND minimum_age IS NOT NULL                    -- ignore aggregates
    AND (
          minimum_age >= 21                        -- ranges that start at/after 21
       OR (minimum_age <= 21 AND maximum_age >= 21) -- ranges that straddle age‑21
    )
  GROUP BY zipcode
),
sales_2022 AS (
  -- 2. 2022 Bourbon sales in Dubuque County
  SELECT
    SAFE_CAST(SUBSTR(zip_code, 1, 5) AS STRING) AS zipcode,
    date,
    sale_dollars
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM date) = 2022
    AND UPPER(category_name) LIKE '%BOURBON%'      -- any bourbon‑whiskey category
    AND UPPER(county) = 'DUBUQUE'                  -- Dubuque County only
),
zip_ranking AS (
  -- 3. Rank ZIP codes by total 2022 Bourbon sales
  SELECT
    zipcode,
    SUM(sale_dollars) AS total_sales,
    RANK() OVER (ORDER BY SUM(sale_dollars) DESC) AS sales_rank
  FROM sales_2022
  GROUP BY zipcode
),
third_zip AS (
  -- 4. ZIP code with the 3rd‑highest 2022 Bourbon sales
  SELECT zipcode
  FROM zip_ranking
  WHERE sales_rank = 3
)
-- 5. Monthly per‑capita Bourbon sales for that ZIP code
SELECT
  FORMAT_DATE('%Y-%m', DATE_TRUNC(s.date, MONTH))              AS year_month,
  SUM(s.sale_dollars) / p.population_21plus                    AS per_capita_bourbon_sales
FROM sales_2022 AS s
JOIN third_zip      AS z ON s.zipcode = z.zipcode
JOIN pop_21plus     AS p ON s.zipcode = p.zipcode
GROUP BY year_month, p.population_21plus
ORDER BY year_month;
```
