-- Monthly per‑capita (age 21+) Bourbon‑whiskey sales in 2022
-- for the ZIP code with the 3rd‑highest Bourbon sales in Dubuque County
WITH adult_population AS (
  /* 21‑and‑older population from the 2010 Census */
  SELECT
    LPAD(zipcode, 5, '0')                        AS zipcode,
    SUM(population)                              AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE gender IS NULL                 -- total (male + female)
    AND minimum_age IS NOT NULL
    AND minimum_age >= 21              -- age 21+
  GROUP BY 1
),
dubuque_bourbon_2022 AS (
  /* 2022 Iowa liquor sales ‑‑ Bourbon only, Dubuque County */
  SELECT
    LPAD(REGEXP_EXTRACT(zip_code, r'^\d+'), 5, '0')          AS zipcode,
    `date`,
    COALESCE(sale_dollars, 0)                                AS sale_dollars
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE TRIM(UPPER(county)) = 'DUBUQUE'
    AND `date` BETWEEN '2022-01-01' AND '2022-12-31'
    AND LOWER(category_name) LIKE '%bourbon%'                -- Bourbon whiskies
),
ranked_zips AS (
  /* Total 2022 Bourbon sales per ZIP, ranked */
  SELECT
    zipcode,
    SUM(sale_dollars) AS total_sales,
    ROW_NUMBER() OVER (ORDER BY SUM(sale_dollars) DESC) AS rn
  FROM dubuque_bourbon_2022
  GROUP BY 1
),
target_zip AS (
  /* ZIP code that ranks 3rd */
  SELECT zipcode
  FROM ranked_zips
  WHERE rn = 3
),
monthly_sales AS (
  /* Monthly Bourbon sales for that ZIP */
  SELECT
    FORMAT_DATE('%Y-%m', `date`) AS month,
    SUM(sale_dollars)           AS total_sales,
    zipcode
  FROM dubuque_bourbon_2022
  WHERE zipcode IN (SELECT zipcode FROM target_zip)
  GROUP BY month, zipcode
)
SELECT
  ms.month,
  ms.total_sales / ap.pop_21_plus AS per_capita_bourbon_sales
FROM monthly_sales AS ms
JOIN adult_population AS ap
  ON ms.zipcode = ap.zipcode
ORDER BY ms.month;
