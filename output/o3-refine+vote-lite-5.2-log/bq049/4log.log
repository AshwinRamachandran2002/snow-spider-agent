  WHERE gender IS NULL                 -- total pop.
    AND minimum_age IS NOT NULL
    AND minimum_age >= 21              -- age 21+
  GROUP BY 1
),
dubuque_bourbon_2022 AS (             -- 2022 Bourbon sales, Dubuque Co.
  SELECT
