```sql
-- Monthly per–capita Bourbon‐whiskey sales (2022) in Dubuque County
-- for the ZIP code that ranks 3rd in total Bourbon sales that year.
WITH adult_population AS (
  -- 21‑and‑older population per ZIP (2010 Census)
  SELECT
    LPAD(zipcode, 5, '0')                       AS zipcode,
    SUM(population)                            AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE gender IS NULL              -- total (male + female)
    AND minimum_age IS NOT NULL
    AND minimum_age >= 21           -- 21 and older only
  GROUP BY zipcode
),
dubuque_bourbon_2022 AS (
  -- 2022 liquor sales in Dubuque County, Bourbon only
  SELECT
    LPAD(CAST(REGEXP_EXTRACT(zip_code, r'^\d+') AS INT64), 5, '0') AS zipcode,
    `date`,
    COALESCE(sale_dollars,0) AS sale_dollars
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE UPPER(county) = 'DUBUQUE'
    AND `date` BETWEEN '2022-01-01' AND '2022-12-31'
    AND LOWER(category_name) LIKE '%bourbon%'    -- Bourbon whiskey
),
zip_ranking AS (
  -- Rank ZIP codes by total 2022 Bourbon sales
  SELECT
    zipcode,
    SUM(sale_dollars) AS total_sales,
    ROW_NUMBER() OVER (ORDER BY SUM(sale_dollars) DESC) AS sales_rank
  FROM dubuque_bourbon_2022
  GROUP BY zipcode
),
target_zip AS (
  -- The ZIP code that ranks 3rd
  SELECT zipcode
  FROM zip_ranking
  WHERE sales_rank = 3
),
monthly_sales AS (
  -- Aggregate monthly sales for that ZIP
  SELECT
    FORMAT_DATE('%Y-%m', `date`) AS month,
    SUM(sale_dollars)           AS total_sales,
    zipcode
  FROM dubuque_bourbon_2022
  WHERE zipcode IN (SELECT zipcode FROM target_zip)
  GROUP BY month, zipcode
)
SELECT
  ms.month,
  ms.total_sales / ap.pop_21_plus AS per_capita_bourbon_sales
FROM monthly_sales AS ms
JOIN adult_population AS ap
  ON ms.zipcode = ap.zipcode
ORDER BY ms.month;
```
