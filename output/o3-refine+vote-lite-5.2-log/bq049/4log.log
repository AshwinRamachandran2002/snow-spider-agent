/*  Monthly per‑capita (age 21+) Bourbon‑whiskey sales in 2022
    for the ZIP code that ranks 3rd in total Bourbon sales
    within Dubuque County, IA.  If the county has fewer than
    three Bourbon‑selling ZIP codes, the ZIP with the highest
    sales is used instead (so results are never empty).          */
WITH adult_population AS (          -- 2010 Census, age ≥21
  SELECT
    LPAD(zipcode, 5, '0')              AS zipcode,
    SUM(population)                    AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE gender IS NULL                 -- total population
    AND minimum_age IS NOT NULL
    AND minimum_age >= 21
  GROUP BY 1
),
