```sql
-- Monthly per–capita Bourbon‑whiskey sales in 2022 for the
-- Dubuque‑County ZIP code that ranks 3rd in total Bourbon sales
WITH bourbon_sales_2022 AS (            -- 1. 2022 Bourbon sales, Dubuque County only
    SELECT
        SUBSTR(CAST(zip_code AS STRING),1,5)      AS zip5,
        date,
        sale_dollars
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE EXTRACT(YEAR  FROM date) = 2022
      AND LOWER(category_name) LIKE '%bourbon%'   -- “Bourbon” whiskies
      AND UPPER(county) = 'DUBUQUE'               -- Dubuque County
),
ranked_zips AS (                      -- 2.  Rank ZIPs by total Bourbon sales
    SELECT
        zip5,
        SUM(sale_dollars)                                         AS total_sales,
        DENSE_RANK() OVER (ORDER BY SUM(sale_dollars) DESC)       AS sales_rank
    FROM bourbon_sales_2022
    GROUP BY zip5
),
third_zip AS (                       -- 3.  The ZIP that ranks 3rd
    SELECT zip5
    FROM ranked_zips
    WHERE sales_rank = 3
    LIMIT 1          -- in case of ties, pick one deterministically
),
monthly_sales AS (                   -- 4.  Monthly sales for that ZIP
    SELECT
        bs.zip5,
        FORMAT_DATE('%Y-%m', bs.date)                  AS month,
        SUM(bs.sale_dollars)                           AS total_sales
    FROM bourbon_sales_2022 AS bs
    JOIN third_zip USING (zip5)
    GROUP BY bs.zip5, month
),
population_21_plus AS (              -- 5.  2010 population aged 21+ for every ZIP
    SELECT
        LPAD(zipcode,5,'0')                              AS zip5,
        SUM(population)                                  AS pop_21_plus
    FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
    WHERE gender IS NULL           -- total population (not male/female subtotals)
      AND minimum_age >= 21        -- population age 21 and over
    GROUP BY zip5
)
-- 6.  Per‑capita monthly sales
SELECT
    ms.month,
    ROUND(ms.total_sales / pop.pop_21_plus, 4)  AS per_capita_bourbon_sales_dollars
FROM monthly_sales             AS ms
JOIN population_21_plus        AS pop USING (zip5)
ORDER BY ms.month;
```
