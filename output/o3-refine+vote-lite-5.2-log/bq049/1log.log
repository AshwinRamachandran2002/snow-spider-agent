```sql
/*  Monthly per‑capita Bourbon‑whiskey sales in 2022 for Dubuque‑County
    using the ZIP code that places 3rd in total Bourbon sales (or the
    lowest‑ranking ZIP if fewer than three exist).                         */

WITH bourbon_sales_2022 AS (          -- 1.  All 2022 Bourbon sales in Dubuque Co.
  SELECT
    LPAD(SUBSTR(CAST(zip_code AS STRING), 1, 5), 5, '0') AS zip5,
    date,
    sale_dollars
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'          -- Bourbon‑whisky categories
    AND TRIM(UPPER(county)) = 'DUBUQUE'                -- Dubuque County
),

ranked_zips AS (                     -- 2.  Rank ZIPs by total Bourbon sales
  SELECT
    zip5,
    SUM(sale_dollars) AS total_sales
  FROM bourbon_sales_2022
  GROUP BY zip5
),

third_zip AS (                       -- 3.  ZIP that ranks 3rd (or last if <3 ZIPs)
  SELECT zip5
  FROM (
    SELECT
      zip5,
      total_sales,
      ROW_NUMBER() OVER (ORDER BY total_sales DESC) AS rn,
      COUNT(*)  OVER ()                              AS cnt
    FROM ranked_zips
  )
  WHERE (cnt >= 3 AND rn = 3) OR (cnt < 3 AND rn = cnt)
  LIMIT 1
),

monthly_sales AS (                   -- 4.  Monthly sales for that ZIP
  SELECT
    FORMAT_DATE('%Y-%m', date) AS month,
    SUM(sale_dollars)        AS total_sales,
    zip5
  FROM bourbon_sales_2022
  WHERE zip5 IN (SELECT zip5 FROM third_zip)
  GROUP BY month, zip5
),

population_21_plus AS (              -- 5.  2010 population aged 21+ by ZIP
  SELECT
    LPAD(zipcode, 5, '0') AS zip5,
    SUM(population)        AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE gender IS NULL                -- total (not male/female split)
    AND minimum_age >= 21             -- 21 years and older
  GROUP BY zip5
)

-- 6.  Per‑capita monthly sales
SELECT
  ms.month,
  ROUND(ms.total_sales / pop.pop_21_plus, 4) AS per_capita_bourbon_sales_dollars
FROM monthly_sales          AS ms
JOIN population_21_plus     AS pop USING (zip5)
ORDER BY ms.month;
