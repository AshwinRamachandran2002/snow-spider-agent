      group that appears on German patents granted in Dec‑2016
-----------------------------------------------------------------*/
WITH
de_dec2016 AS (                       -- 1  DE patents granted in Dec‑2016
    SELECT  "publication_number",
            "filing_date",            --  YYYYMMDD   (NUMBER)
            "cpc"
    FROM    PATENTS.PATENTS.PUBLICATIONS
    WHERE   "country_code" = 'DE'
      AND   "grant_date"  BETWEEN 20161201 AND 20161231
      AND   "cpc"         IS NOT NULL
      AND   "filing_date" IS NOT NULL
),
cpc_expanded AS (                     -- 2  explode CPC array
    SELECT  d."publication_number",
            d."filing_date",
            SPLIT_PART(f.value:"code", '/', 1) AS "cpc_prefix"
    FROM    de_dec2016 d,
            LATERAL FLATTEN(INPUT => d."cpc") f
    WHERE   f.value:"code" IS NOT NULL
),
groups AS (                           -- 3  collapse to level‑4 groups
    SELECT DISTINCT
            "publication_number",
            CONCAT("cpc_prefix", '/00')               AS "group_symbol",
            FLOOR("filing_date" / 10000)              AS "filing_year"   -- YYYY
    FROM    cpc_expanded
    WHERE   "filing_year" IS NOT NULL
),
yearly_counts AS (                    -- 4  yearly filings per group
    SELECT  "group_symbol",
            "filing_year",
            COUNT(DISTINCT "publication_number") AS "filings"
    FROM    groups
    GROUP BY "group_symbol", "filing_year"
),
years_span AS (                       -- 5a all years 1900‑2016 per group
    SELECT  g."group_symbol",
            1900 + seq4() AS "year"
    FROM   (SELECT DISTINCT "group_symbol" FROM yearly_counts) g,
           TABLE(GENERATOR(ROWCOUNT => 117))            -- 1900‑2016 inclusive
    WHERE  1900 + seq4() <= 2016
),
filled_counts AS (                    -- 5b zero‑fill missing years
    SELECT  y."group_symbol",
            y."year",
            COALESCE(c."filings", 0) AS "filings"
    FROM    years_span y
            LEFT JOIN yearly_counts c
              ON  c."group_symbol" = y."group_symbol"
              AND c."filing_year"  = y."year"
),
ranked AS (                           -- helper: chronological index
    SELECT  "group_symbol",
            "year",
            "filings",
            ROW_NUMBER() OVER (PARTITION BY "group_symbol"
                               ORDER BY "year") AS rn
    FROM    filled_counts
),
/* 6  --------  recursive EMA  ----------------------------------------- */
WITH RECURSIVE
ema_calc ("group_symbol","year","filings","ema","rn") AS (
    -- seed (first year = 1900)
    SELECT  r."group_symbol",
            r."year",
            r."filings",
            CAST(r."filings" AS FLOAT)  AS "ema",
            r."rn"
    FROM    ranked r
    WHERE   r."rn" = 1
    UNION ALL
    SELECT  r."group_symbol",
            r."year",
            r."filings",
            (0.1 * r."filings") + (0.9 * e."ema") AS "ema",
            r."rn"
    FROM    ranked   r
            JOIN ema_calc e
              ON  r."group_symbol" = e."group_symbol"
              AND r."rn"           = e."rn" + 1
),
/* 7  --------  best EMA year per group -------------------------------- */
best_year AS (
    SELECT
        "group_symbol",
        FIRST_VALUE("year") OVER (PARTITION BY "group_symbol"
                                  ORDER BY "ema" DESC, "year" ASC) AS "best_year"
    FROM    ema_calc
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "group_symbol"
                               ORDER BY "ema" DESC, "year" ASC) = 1
),
