```sql
/*  ------------------------------------------------------------
    1)   German patents whose grant date falls in December 2016
    2)   explode every CPC code that is given for those patents
    3)   collapse every CPC code to its level‑4 “group” 
         (everything left of “/”, then add “/00”)
    4)   count yearly patent‑filings per CPC group
    5)   build a complete year‑series (1900‑2016) per group
         and fill missing years with 0 filings
    6)   recursively compute the exponential moving average
         EMA  = 0.1·x  + 0.9·EMA (previous)
    7)   for every CPC group pick the year that maximises EMA
    8)   add the full CPC title taken from CPC_DEFINITION (level = 4)
-----------------------------------------------------------------*/
WITH

de_dec2016 AS (   -- 1
    SELECT  "publication_number",
            "filing_date",
            "cpc"
    FROM    PATENTS.PATENTS.PUBLICATIONS
    WHERE   "country_code" = 'DE'
      AND   "grant_date" BETWEEN 20161201 AND 20161231
      AND   "cpc" IS NOT NULL
      AND   "filing_date" IS NOT NULL
),

cpc_expanded AS (   -- 2
    SELECT  d."publication_number",
            d."filing_date",
            SPLIT_PART(f.value:"code", '/', 1)          AS "cpc_prefix"
    FROM    de_dec2016 d,
            LATERAL FLATTEN( INPUT => d."cpc") f
    WHERE   f.value:"code" IS NOT NULL
),

groups AS (         -- 3
    SELECT DISTINCT
            "publication_number",
            CONCAT("cpc_prefix", '/00')                  AS "group_symbol",
            TO_NUMBER(LEFT(TO_CHAR("filing_date"),4))    AS "filing_year"
    FROM    cpc_expanded
    WHERE   "filing_year" IS NOT NULL
),

yearly_counts AS (  -- 4
    SELECT  "group_symbol",
            "filing_year",
            COUNT(DISTINCT "publication_number") AS "filings"
    FROM    groups
    GROUP BY "group_symbol", "filing_year"
),

years_span AS (     -- 5  create every year 1900‑2016 for every group
    SELECT  g."group_symbol",
            y."yr"   AS "year"
    FROM   (SELECT DISTINCT "group_symbol" FROM yearly_counts) g
           JOIN LATERAL (
                SELECT seq4() + 1900 AS yr
                FROM   TABLE(GENERATOR(ROWCOUNT => 200))
                WHERE  seq4() + 1900 <= 2016
           ) y  ON TRUE
),

filled_counts AS (  -- 5  (cont.)  zero‑fill missing years
    SELECT  y."group_symbol",
            y."year",
            COALESCE(c."filings",0) AS "filings"
    FROM    years_span      y
            LEFT JOIN yearly_counts c
              ON  c."group_symbol" = y."group_symbol"
              AND c."filing_year"  = y."year"
),

ranked AS (         -- helper: chronological row numbers
    SELECT  "group_symbol",
            "year",
            "filings",
            ROW_NUMBER() OVER (PARTITION BY "group_symbol"
                               ORDER BY "year") AS rn
    FROM    filled_counts
),

/* 6  ---  recursive EMA ------------------------------------------------ */
RECURSIVE ema_calc AS (
      -- base: earliest year per group
      SELECT  r."group_symbol",
              r."year",
              r."filings",
              CAST(r."filings" AS FLOAT)      AS "ema",
              r.rn
      FROM    ranked r
      WHERE   r.rn = 1

      UNION ALL

      SELECT  r."group_symbol",
              r."year",
              r."filings",
              (0.1 * r."filings") + (0.9 * e."ema")   AS "ema",
              r.rn
      FROM    ranked     r
              JOIN ema_calc e
                ON  r."group_symbol" = e."group_symbol"
                AND r.rn            = e.rn + 1
),

best_year AS (      -- 7  pick the year with the highest EMA
    SELECT  "group_symbol",
            -- earliest year in case of a tie
            FIRST_VALUE("year")  OVER (PARTITION BY "group_symbol"
                                       ORDER BY "ema" DESC, "year" ASC) AS "best_year"
    FROM    ema_calc
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "group_symbol"
                               ORDER BY "ema" DESC, "year" ASC) = 1
),

titles AS (         -- 8
    SELECT  "symbol"      AS "group_symbol",
            "titleFull"   AS "full_title"
    FROM    PATENTS.PATENTS.CPC_DEFINITION
    WHERE   "level" = 4
)

SELECT  b."group_symbol"   AS "cpc_group",
        t."full_title",
        b."best_year"
FROM    best_year b
        LEFT JOIN titles t
          ON t."group_symbol" = b."group_symbol"
ORDER BY b."cpc_group";
```
