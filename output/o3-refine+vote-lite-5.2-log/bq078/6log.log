```sql
WITH impc_associations AS (
  SELECT
    targetId,
    score
  FROM `bigquery-public-data.open_targets_platform.associationByDatasourceDirect`
  WHERE
    diseaseId = 'EFO_0000676'
    AND LOWER(datasourceId) = 'impc'
),
max_score AS (
  SELECT MAX(score) AS top_score
  FROM impc_associations
)
SELECT DISTINCT
  t.approvedSymbol
FROM impc_associations a
JOIN max_score m
  ON a.score = m.top_score
JOIN `bigquery-public-data.open_targets_platform.targets` t
  ON a.targetId = t.id
ORDER BY
  t.approvedSymbol;
```
