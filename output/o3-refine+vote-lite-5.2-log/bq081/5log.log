Table full name: bigquery-public-data.san_francisco_transit_muni.stop_monitoring
Column name: time_recorded Type: TIMESTAMP Description: The timestamp of the real-time update from the particular vehicle.
Column name: stop_id Type: STRING Description: Unique reference for the stop being monitored. Maps to stop_id in the stops table
Column name: stop_name Type: STRING Description: Full text name of the stop being monitored. Maps to stop_name in the stops table
Column name: route_id Type: STRING Description: Unique reference for the route on which the vehicle is traveling. Maps to route_id in the routes table
Column name: direction Type: STRING Description: Indicates the direction of travel for a trip. The following values are valid: - O: Outbound travel - I: Inbound travel  This field is not used in routing, but instead provides a way to separate trips by direction
Column name: trip_date Type: DATE Description: The service date for the trip the vehicle is serving.
Column name: trip_id Type: STRING Description: Unique reference for the trip that the vehicle is traveling. Maps to trip_id in the trips table
Column name: route_long_name Type: STRING Description: Contains the full name of a route. This name is generally more descriptive than the name from route_short_name and often includes the route's destination or stop. Maps to route_long_name in routes table
Column name: vehicle_location_lat Type: FLOAT64 Description: The latitude of the vehicle's location at the time when time_recorded indicates
Column name: vehicle_location_lon Type: FLOAT64 Description: The longitude of the vehicle's location at the time when time_recorded indicates
Column name: vehicle_location Type: GEOGRAPHY Description: The geographic representation of the vehicle's location at the time indicated in the time_recorded column
Column name: vehicle_id Type: STRING Description: The unique identifier of the vehicle to be monitored.
Column name: vehicle_at_stop Type: BOOL Description: Determines if the vehicle is at the monitored stop during the time_recorded. TRUE if vehicle is at the stop
Column name: aimed_arrival_time Type: TIMESTAMP Description: Vehicle's expected arrival time
Column name: aimed_departure_time Type: TIMESTAMP Description: Vehicle's expected departure time
Sample rows:
[{'time_recorded': '2021-09-15 14:28:08+00:00', 'stop_id': '10390', 'stop_name': '19th Avenue & Holloway St', 'route_id': '28', 'direction': 'IB', 'trip_date': '2021-09-15', 'trip_id': '10276997', 'route_long_name': '19TH AVENUE', 'vehicle_location_lat': 37.716011, 'vehicle_location_lon': -122.472198, 'vehicle_location': 'POINT(-122.472198 37.716011)', 'vehicle_id': '8746', 'vehicle_at_stop': None, 'aimed_arrival_time': '2021-09-15 14:26:00+00:00', 'aimed_departure_time': '2021-09-15 14:26:00+00:00'}, {'time_recorded': '2021-09-15 14:47:59+00:00', 'stop_id': '10390', 'stop_name': '19th Avenue & Holloway St', 'route_id': '28', 'direction': 'IB', 'trip_date': '2021-09-15', 'trip_id': '10276999', 'route_long_name': '19TH AVENUE', 'vehicle_location_lat': 37.7156334, 'vehicle_location_lon': -122.471992, 'vehicle_location': 'POINT(-122.471992 37.7156334)', 'vehicle_id': '8753', 'vehicle_at_stop': None, 'aimed_arrival_time': '2021-09-15 14:50:00+00:00', 'aimed_departure_time': '2021-09-15 14:50:00+00:00'}, {'time_recorded': '2021-09-15 15:00:55+00:00', 'stop_id': '10390', 'stop_name': '19th Avenue & Holloway St', 'route_id': '28', 'direction': 'IB', 'trip_date': '2021-09-15', 'trip_id': '10277000', 'route_long_name': '19TH AVENUE', 'vehicle_location_lat': 37.7160988, 'vehicle_location_lon': -122.472221, 'vehicle_location': 'POINT(-122.472221 37.7160988)', 'vehicle_id': '8772', 'vehicle_at_stop': None, 'aimed_arrival_time': '2021-09-15 15:03:00+00:00', 'aimed_departure_time': '2021-09-15 15:03:00+00:00'}, {'time_recorded': '2021-09-15 14:35:57+00:00', 'stop_id': '10390', 'stop_name': '19th Avenue & Holloway St', 'route_id': '28', 'direction': 'IB', 'trip_date': '2021-09-15', 'trip_id': '10276998', 'route_long_name': '19TH AVENUE', 'vehicle_location_lat': 37.7137833, 'vehicle_location_lon': -122.471703, 'vehicle_location': 'POINT(-122.471703 37.7137833)', 'vehicle_id': '8778', 'vehicle_at_stop': None, 'aimed_arrival_time': '2021-09-15 14:38:00+00:00', 'aimed_departure_time': '2021-09-15 14:38:00+00:00'}, {'time_recorded': '2021-09-15 19:20:00+00:00', 'stop_id': '10390', 'stop_name': '19th Avenue & Holloway St', 'route_id': '28', 'direction': 'IB', 'trip_date': '2021-09-15', 'trip_id': '10277295', 'route_long_name': '19TH AVENUE', 'vehicle_location_lat': 37.7145004, 'vehicle_location_lon': -122.47155, 'vehicle_location': 'POINT(-122.47155 37.7145004)', 'vehicle_id': '8778', 'vehicle_at_stop': None, 'aimed_arrival_time': '2021-09-15 19:22:00+00:00', 'aimed_departure_time': '2021-09-15 19:22:00+00:00'}]

