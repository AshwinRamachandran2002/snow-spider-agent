```sql
WITH year_causes AS (          -- link every collision to its calendar year
    SELECT ci.db_year,
           c.primary_collision_factor AS cause
    FROM   collisions  c
    JOIN   case_ids    ci ON ci.case_id = c.case_id
    WHERE  c.primary_collision_factor IS NOT NULL
),

cause_counts AS (              -- count how often each cause occurs per year
    SELECT db_year,
           cause,
           COUNT(*)                          AS cnt,
           ROW_NUMBER() OVER (PARTITION BY db_year
                              ORDER BY COUNT(*) DESC, cause) AS rn
    FROM   year_causes
    GROUP  BY db_year, cause
),

top2 AS (                      -- keep only the two most frequent causes each year
    SELECT db_year, cause, cnt
    FROM   cause_counts
    WHERE  rn <= 2
),

top2_concat AS (               -- turn those two causes into an ordered “signature”
    SELECT db_year,
           GROUP_CONCAT(cause, ' | ') AS top2_signature
    FROM  (
        SELECT db_year, cause
        FROM   top2
        ORDER  BY db_year, cnt DESC, cause        -- ensure deterministic order
    )
    GROUP BY db_year
),

signature_usage AS (           -- how many different years share the same pair?
    SELECT top2_signature, COUNT(*) AS yrs_with_signature
    FROM   top2_concat
    GROUP  BY top2_signature
)

SELECT tc.db_year              -- final answer: years whose top‑2 pair is unique
FROM   top2_concat tc
JOIN   signature_usage su
       ON  su.top2_signature = tc.top2_signature
WHERE  su.yrs_with_signature = 1
ORDER  BY tc.db_year;
```
