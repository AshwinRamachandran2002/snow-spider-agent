```sql
WITH target_year AS (
    SELECT FLOOR("filing_date" / 10000) AS "filing_year"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE."PUBLICATIONS"
    WHERE "publication_number" = 'US-9741766-B2'
),

similar_list AS (
    SELECT
        sim.value:"publication_number"::STRING        AS "publication_number",
        sim.index                                      AS "rank"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE."ABS_AND_EMB",
         LATERAL FLATTEN(input => "similar") sim
    WHERE "publication_number" = 'US-9741766-B2'
),

similar_with_year AS (
    SELECT
        sl."publication_number",
        sl."rank",
        FLOOR(pub."filing_date" / 10000)              AS "filing_year"
    FROM similar_list sl
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE."PUBLICATIONS" pub
      ON pub."publication_number" = sl."publication_number"
)

SELECT DISTINCT
       swy."publication_number"
FROM   similar_with_year swy
JOIN   target_year ty
  ON   swy."filing_year" = ty."filing_year"
ORDER BY swy."rank"
LIMIT 5;
```
