```sql
WITH long_side_trades AS (
  SELECT
    t.OrderID,
    o.strategy,
    t.StrikePrice,
    t.LastPx,
    t.Quantity
  FROM `bigquery-public-data.cymbal_investments.trade_capture_report` AS t
  JOIN `bigquery-public-data.cymbal_investments.orders`               AS o
    ON t.OrderID = o.order_id
  -- keep only long‐side trades
  WHERE EXISTS (
      SELECT 1
      FROM UNNEST(t.Sides) s
      WHERE s.Side = 'LONG'
  )
  -- keep only the two strategies of interest
  AND o.strategy IN ('feeling_lucky', 'momentum')
),
avg_intrinsic AS (
  SELECT
    strategy,
    AVG( (StrikePrice - LastPx) * Quantity ) AS avg_intrinsic_value
  FROM long_side_trades
  GROUP BY strategy
)
SELECT
  AVG(CASE WHEN strategy = 'feeling_lucky' THEN avg_intrinsic_value END)
  -
  AVG(CASE WHEN strategy = 'momentum'      THEN avg_intrinsic_value END)
    AS intrinsic_value_difference
FROM avg_intrinsic;
```
