    "GNOMAD"."GNOMAD"."V2_1_1_EXOMES__CHR17" t,
    LATERAL FLATTEN(INPUT => t."alternate_bases") ab,
    LATERAL FLATTEN(INPUT => SPLIT(ab.value:"CSQ"::STRING, ',')) csq_entry
ORDER BY
    CAST(SPLIT_PART(csq_entry.value, '|', 15) AS INTEGER) ASC
LIMIT 1;
```
