Query:
--Description: Count the number of drivers who improved their position from the grid (lap 0) to the first race lap (lap 1) for race_id = 1, using lap_positions data only.
SELECT COUNT(*) AS "start_overtakes"
FROM (
    SELECT lp0."driver_id"
    FROM "lap_positions" AS lp0
    JOIN "lap_positions" AS lp1
         ON lp1."race_id"   = lp0."race_id"
        AND lp1."driver_id" = lp0."driver_id"
        AND lp1."lap"       = 1
    WHERE lp0."race_id" = 1
      AND lp0."lap"     = 0
      AND lp1."position" < lp0."position"
)
Answer:
start_overtakes
11
Query:
--Description: Count how many pit‑stop events happened in laps 1–5 for the first race in the dataset that actually has pit‑stops recorded in that window.
SELECT COUNT(*) AS "pit_stop_events"
FROM "pit_stops"
WHERE "lap" BETWEEN 1 AND 5
  AND "race_id" = (
        SELECT "race_id"
        FROM "pit_stops"
        WHERE "lap" BETWEEN 1 AND 5
        LIMIT 1
  )
Answer:
pit_stop_events
2
Query:
--Description: Count retirements that took place within the first five laps for the earliest race that contains such an occurrence.
SELECT COUNT(*) AS "retirements_first_5_laps"
FROM "retirements"
WHERE "lap" <= 5
  AND "race_id" = (
        SELECT "race_id"
        FROM "retirements"
        WHERE "lap" <= 5
        LIMIT 1
  )
