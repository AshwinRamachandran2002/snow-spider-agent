Query:
--Description: Count on‑track overtakes (position improvements from one lap to the next) in laps 1‑5 for the first race that has both lap_positions and pit_stops data, excluding laps where the driver pitted.
WITH chosen_race AS (
    SELECT ps."race_id"
    FROM "pit_stops" ps
    JOIN "lap_positions" lp USING ("race_id")
    WHERE ps."lap" BETWEEN 1 AND 5
    LIMIT 1
),
pos AS (
    SELECT lp."driver_id", lp."lap", lp."position"
    FROM "lap_positions" lp, chosen_race cr
    WHERE lp."race_id" = cr."race_id"
      AND lp."lap" BETWEEN 1 AND 5
),
deltas AS (
    SELECT p1."driver_id",
           p1."lap",
           p0."position" AS prev_pos,
           p1."position" AS curr_pos,
           (p0."position" - p1."position") AS diff
    FROM pos p1
    JOIN pos p0
      ON p0."driver_id" = p1."driver_id"
     AND p0."lap"       = p1."lap" - 1
)
SELECT COUNT(*) AS "standard_on_track_passes"
FROM deltas, chosen_race cr
WHERE diff > 0
  AND "driver_id" NOT IN (
        SELECT DISTINCT ps."driver_id"
        FROM "pit_stops" ps
        WHERE ps."race_id" = cr."race_id"
          AND ps."lap" BETWEEN 1 AND 5
  )
Answer:
standard_on_track_passes
5
Query:
--Description: Show every lap‑by‑lap position change for laps 1‑5 in race_id = 1, useful for manual verification.
SELECT lp1."driver_id",
       lp1."lap",
       lp0."position" AS "previous_position",
       lp1."position" AS "current_position"
FROM "lap_positions" AS lp1
JOIN "lap_positions" AS lp0
  ON lp0."race_id"   = lp1."race_id"
 AND lp0."driver_id" = lp1."driver_id"
 AND lp0."lap"       = lp1."lap" - 1
WHERE lp1."race_id" = 1
