```sql
-- 1) What races actually have lap–by–lap position data?
SELECT DISTINCT "race_id"
FROM "lap_positions"
LIMIT 20;
```

```sql
-- 2) Inspect the starting grid (lap = 0) and the first five race laps
--    for one sample event – here we pick race_id = 1.
SELECT *
FROM "lap_positions"
WHERE "race_id" = 1
  AND "lap" BETWEEN 0 AND 5
ORDER BY "driver_id", "lap"
LIMIT 20;
```

```sql
-- 3) See who pitted in the opening five laps of that race.
SELECT *
FROM "pit_stops"
WHERE "race_id" = 1
  AND "lap" <= 5
ORDER BY "driver_id", "lap"
LIMIT 20;
```

```sql
-- 4) Check whether any driver retired inside the first five laps.
SELECT *
FROM "retirements"
WHERE "race_id" = 1
  AND "lap" <= 5
LIMIT 20;
```

```sql
-- 5) Count start‑related position changes:
--    drivers whose position improved from the grid (lap 0) to lap 1.
SELECT COUNT(*) AS "start_overtakes"
FROM (
    SELECT lp0."driver_id"
    FROM "lap_positions" AS lp0
    JOIN "lap_positions" AS lp1
         ON lp1."race_id" = lp0."race_id"
        AND lp1."driver_id" = lp0."driver_id"
        AND lp1."lap" = 1
    WHERE lp0."race_id" = 1
      AND lp0."lap" = 0
      AND lp1."position" < lp0."position"      -- improvement
);
```

```sql
-- 6) Count pit‑stop related position losses/gains in laps 1‑5.
--    A simple proxy is the number of pit stops themselves.
SELECT COUNT(*) AS "pit_stop_events"
FROM "pit_stops"
WHERE "race_id" = 1
  AND "lap" BETWEEN 1 AND 5;
```

```sql
-- 7) Count retirements that happened in the first five laps.
SELECT COUNT(*) AS "retirements_first_5_laps"
FROM "retirements"
WHERE "race_id" = 1
  AND "lap" <= 5;
```

```sql
-- 8) Count on‑track position changes (overtakes) between laps 1‑5
--    that are NOT triggered by pit stops or retirements.
WITH pos AS (
  SELECT "driver_id", "lap", "position"
  FROM "lap_positions"
  WHERE "race_id" = 1
    AND "lap" BETWEEN 1 AND 5
),
deltas AS (
  SELECT p1."driver_id",
         p1."lap",
         p0."position" AS prev_pos,
         p1."position" AS curr_pos,
         (p0."position" - p1."position") AS diff
  FROM pos p1
  JOIN pos p0
       ON p0."driver_id" = p1."driver_id"
      AND p0."lap"     = p1."lap" - 1
)
SELECT COUNT(*) AS "standard_on_track_passes"
FROM deltas
WHERE diff > 0                     -- position improved
  AND "driver_id" NOT IN (         -- exclude laps with pit stops
        SELECT DISTINCT "driver_id"
        FROM "pit_stops"
        WHERE "race_id" = 1
          AND "lap" BETWEEN 1 AND 5
  );
```

```sql
-- 9) List every lap‑by‑lap position change for laps 1‑5
--    (useful for manual cross‑checks).
SELECT lp1."driver_id", lp1."lap",
       lp0."position" AS "previous_position",
       lp1."position" AS "current_position"
FROM "lap_positions" AS lp1
JOIN "lap_positions" AS lp0
     ON lp0."race_id"  = lp1."race_id"
    AND lp0."driver_id"= lp1."driver_id"
    AND lp0."lap"      = lp1."lap" - 1
WHERE lp1."race_id" = 1
  AND lp1."lap" BETWEEN 1 AND 5
ORDER BY lp1."lap", lp1."position"
LIMIT 20;
```

```sql
-- 10) Translate driver_ids to driver names for clearer reading.
SELECT lp."driver_id", d."full_name"
FROM "lap_positions" AS lp
JOIN "drivers_ext"   AS d USING ("driver_id")
WHERE lp."race_id" = 1
  AND lp."lap" = 1
LIMIT 20;
```
