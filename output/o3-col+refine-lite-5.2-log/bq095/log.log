```sql
--Description: We must retrieve drugs that have COMPLETED clinical trials for pancreatic endocrine 
--             carcinoma (disease ID EFO_0007416).  The relevant information lives in the table 
--             `knownDrugsAggregated` within the US‑hosted Open Targets project 
--             `open-targets-prod-us`.  Steps:
--               1.  Filter rows where diseaseId = 'EFO_0007416' and status equals 'Completed'
--                   (case‑insensitive).
--               2.  UNNEST the `urls.list` array so each embedded URL is available as a row.
--               3.  Keep only URLs whose niceName is 'ClinicalTrials' to capture direct links to
--                   the registered study records.
--               4.  Return the drug’s preferred name (`prefName`), its approved target gene symbol
--                   (`approvedSymbol`), and each ClinicalTrials.gov URL.
SELECT
  k.prefName        AS drug_name,
  k.approvedSymbol  AS target_symbol,
  u.element.url     AS clinical_trial_url
FROM `open-targets-prod-us.platform.knownDrugsAggregated` AS k
JOIN UNNEST(k.urls.list) AS u
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
  AND LOWER(u.element.niceName) = 'clinicaltrials'
ORDER BY drug_name, target_symbol, clinical_trial_url;
```
