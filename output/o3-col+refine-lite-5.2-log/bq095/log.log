Below are a series of up‑to‑ten exploratory BigQuery SQL statements – from simple “look‑ups” to a final consolidated query – that identify drugs which have COMPLETED clinical trials for pancreatic endocrine carcinoma (disease ID = EFO_0007416).  
Each query is annotated to explain its purpose.  

```sql
-- 1.  Confirm the disease name for EFO_0007416
SELECT id, name, description
FROM `open-targets-prod.platform.diseases`
WHERE id = 'EFO_0007416'
LIMIT 20;
```

```sql
-- 2.  Inspect any drug–target records linked to EFO_0007416 in the clinical‑trial table
SELECT DISTINCT drugId, targetId, phase, status
FROM `open-targets-prod.platform.knownDrugsAggregated`
WHERE diseaseId = 'EFO_0007416'
LIMIT 20;
```

```sql
-- 3.  Retrieve only the trials whose STATUS is 'Completed'
SELECT DISTINCT drugId, targetId, phase, status
FROM `open-targets-prod.platform.knownDrugsAggregated`
WHERE diseaseId = 'EFO_0007416'
  AND LOWER(status) = 'completed'
LIMIT 20;
```

```sql
-- 4.  Add drug and target names that already exist in this table
SELECT DISTINCT drugId,
       prefName           AS drug_name,
       targetId,
       approvedSymbol     AS target_symbol,
       phase,
       status
FROM `open-targets-prod.platform.knownDrugsAggregated`
WHERE diseaseId = 'EFO_0007416'
  AND LOWER(status) = 'completed'
LIMIT 20;
```

```sql
-- 5.  Unnest the URLs to view the linked clinical‑trial records
SELECT DISTINCT k.drugId,
       k.prefName                  AS drug_name,
       k.approvedSymbol            AS target_symbol,
       u.element.niceName          AS nice_name,
       u.element.url               AS url
FROM  `open-targets-prod.platform.knownDrugsAggregated` AS k
LEFT JOIN UNNEST(k.urls.list) AS u
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
LIMIT 20;
```

```sql
-- 6.  Filter to keep only “ClinicalTrials” links
SELECT DISTINCT k.drugId,
       k.prefName              AS drug_name,
       k.approvedSymbol        AS target_symbol,
       u.element.url           AS clinical_trial_url
FROM  `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN UNNEST(k.urls.list) AS u
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
  AND LOWER(u.element.niceName) = 'clinicaltrials'
LIMIT 20;
```

```sql
-- 7.  Count how many COMPLETED clinical‑trial links each drug has
SELECT k.prefName                    AS drug_name,
       COUNT(DISTINCT u.element.url) AS n_completed_trials
FROM  `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN UNNEST(k.urls.list) AS u
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
  AND LOWER(u.element.niceName) = 'clinicaltrials'
GROUP BY drug_name
ORDER BY n_completed_trials DESC
LIMIT 20;
```

```sql
-- 8.  Join to the molecule table to pull extra molecular details (optional inspection)
SELECT DISTINCT k.prefName             AS drug_name,
       m.name                          AS molecule_name,
       m.drugType,
       m.isApproved,
       k.approvedSymbol                AS target_symbol
FROM  `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN  `open-targets-prod.platform.molecule`            AS m
  ON  k.drugId = m.id
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
LIMIT 20;
```

```sql
-- 9.  (Final) Produce the required list: drug name, target approved symbol, and all
--     ClinicalTrials.gov URLs for COMPLETED trials in pancreatic endocrine carcinoma
SELECT DISTINCT
       k.prefName               AS drug_name,
       k.approvedSymbol         AS target_symbol,
       u.element.url            AS clinical_trial_url
FROM  `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN UNNEST(k.urls.list) AS u
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
  AND LOWER(u.element.niceName) = 'clinicaltrials'
ORDER BY drug_name, target_symbol
LIMIT 100;
```

```sql
--10.  Same as 9 but grouped so each drug appears once with an ARRAY of URLs
SELECT
       k.prefName               AS drug_name,
       k.approvedSymbol         AS target_symbol,
       ARRAY_AGG(DISTINCT u.element.url) AS clinical_trial_urls
FROM  `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN UNNEST(k.urls.list) AS u
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
  AND LOWER(u.element.niceName) = 'clinicaltrials'
GROUP BY drug_name, target_symbol
ORDER BY drug_name
LIMIT 100;
```
