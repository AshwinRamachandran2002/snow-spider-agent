```sql
--Description: 8) Create an intermediate table (CTE) with first quick‑play date and the target “+14 days” boundary.
WITH cohort AS (
  SELECT user_pseudo_id,
         event_name        AS quickplay_type,
         MIN(DATETIME(TIMESTAMP_MICROS(event_timestamp))) AS first_dt
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  event_date BETWEEN '20180702' AND '20180716'
    AND  LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, quickplay_type
)
SELECT *,
       DATETIME_ADD(first_dt, INTERVAL 14 DAY)    AS plus14_dt
FROM   cohort
LIMIT 20;
```

```sql
--Description: 9) Flag users that produced ANY event of the same quick‑play type exactly 14 days (+/‑1 day) after their first one.
WITH cohort AS (
  SELECT user_pseudo_id,
         event_name            AS quickplay_type,
         MIN(TIMESTAMP_MICROS(event_timestamp)) AS first_ts
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  event_date BETWEEN '20180702' AND '20180716'
    AND  LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, quickplay_type
), later AS (
  SELECT  e.user_pseudo_id,
          e.event_name  AS quickplay_type,
          TIMESTAMP_MICROS(e.event_timestamp)        AS ts
  FROM    `firebase-public-project.analytics_153293282.events_*` e
  WHERE   LOWER(e.event_name) LIKE '%quickplay%'
)
SELECT  c.quickplay_type,
        COUNT(DISTINCT c.user_pseudo_id)                                 AS cohort_size,
        COUNT(DISTINCT CASE
                WHEN l.ts BETWEEN TIMESTAMP_ADD(c.first_ts, INTERVAL 13 DAY)
                              AND TIMESTAMP_ADD(c.first_ts, INTERVAL 15 DAY)
                THEN c.user_pseudo_id
             END)                                                       AS retained_users
FROM    cohort AS c
LEFT JOIN later  AS l
       ON l.user_pseudo_id  = c.user_pseudo_id
      AND l.quickplay_type  = c.quickplay_type
GROUP BY c.quickplay_type
LIMIT 20;
```

```sql
--Description: 10) FINAL – Retention rate two weeks after first quick‑play event, by quick‑play type.
WITH cohort AS (
  SELECT user_pseudo_id,
         event_name                          AS quickplay_type,
         MIN(TIMESTAMP_MICROS(event_timestamp)) AS first_ts
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  event_date BETWEEN '20180702' AND '20180716'
    AND  event_name = 'session_start'            -- users who really opened a session
), qp_first AS (
  SELECT  e.user_pseudo_id,
          e.event_name      AS quickplay_type,
          MIN(TIMESTAMP_MICROS(e.event_timestamp)) AS first_qp_ts
  FROM    `firebase-public-project.analytics_153293282.events_*` e
  JOIN    cohort           c  USING(user_pseudo_id)
  WHERE   LOWER(e.event_name) LIKE '%quickplay%'
  GROUP BY e.user_pseudo_id, quickplay_type
), qp_later AS (
  SELECT  e.user_pseudo_id,
          e.event_name      AS quickplay_type,
          TIMESTAMP_MICROS(e.event_timestamp)    AS ts
  FROM    `firebase-public-project.analytics_153293282.events_*` e
  WHERE   LOWER(e.event_name) LIKE '%quickplay%'
)
SELECT  q.quickplay_type,
        COUNT(DISTINCT q.user_pseudo_id)                                   AS cohort_size,
        COUNT(DISTINCT CASE
              WHEN l.ts BETWEEN TIMESTAMP_ADD(q.first_qp_ts, INTERVAL 13 DAY)
                                AND TIMESTAMP_ADD(q.first_qp_ts, INTERVAL 15 DAY)
              THEN q.user_pseudo_id END)                                   AS retained_users,
        ROUND( 100 * COUNT(DISTINCT CASE
              WHEN l.ts BETWEEN TIMESTAMP_ADD(q.first_qp_ts, INTERVAL 13 DAY)
                                AND TIMESTAMP_ADD(q.first_qp_ts, INTERVAL 15 DAY)
              THEN q.user_pseudo_id END)
              / COUNT(DISTINCT q.user_pseudo_id) , 2)                      AS retention_pct
FROM    qp_first  q
LEFT JOIN qp_later l
       ON l.user_pseudo_id = q.user_pseudo_id
      AND l.quickplay_type = q.quickplay_type
GROUP BY q.quickplay_type
ORDER BY retention_pct DESC
LIMIT 20;
```
