--Description: 9) Flag users that produced ANY event of the same quick‑play type exactly 14 days (+/‑1 day) after their first one.
WITH cohort AS (
  SELECT user_pseudo_id,
         event_name            AS quickplay_type,
         MIN(TIMESTAMP_MICROS(event_timestamp)) AS first_ts
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  event_date BETWEEN '20180702' AND '20180716'
    AND  LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, quickplay_type
), later AS (
  SELECT  e.user_pseudo_id,
          e.event_name  AS quickplay_type,
          TIMESTAMP_MICROS(e.event_timestamp)        AS ts
  FROM    `firebase-public-project.analytics_153293282.events_*` e
  WHERE   LOWER(e.event_name) LIKE '%quickplay%'
)
SELECT  c.quickplay_type,
        COUNT(DISTINCT c.user_pseudo_id)                                 AS cohort_size,
        COUNT(DISTINCT CASE
                WHEN l.ts BETWEEN TIMESTAMP_ADD(c.first_ts, INTERVAL 13 DAY)
                              AND TIMESTAMP_ADD(c.first_ts, INTERVAL 15 DAY)
                THEN c.user_pseudo_id
             END)                                                       AS retained_users
FROM    cohort AS c
LEFT JOIN later  AS l
       ON l.user_pseudo_id  = c.user_pseudo_id
      AND l.quickplay_type  = c.quickplay_type
GROUP BY c.quickplay_type
LIMIT 20;
