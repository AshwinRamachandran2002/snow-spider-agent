-- THINKING PROCESS ───────────────────────────────────────────────────────────
-- 1.  session_users : users who fired at least one session_start between
--                     2018‑07‑02 and 2018‑07‑16 → they form the cohort universe.
-- 2.  qp_first      : for every cohort user and every quick‑play event type
--                     (name contains “quickplay”) find the earliest timestamp.
--                     This is “day‑0” per user‑per‑type.
-- 3.  qp_later      : all quick‑play events (any date) so we can check
--                     whether a user repeats the same event on day 13‑15.
-- 4.  Final SELECT  : per quick‑play type
--       • cohort_size    = # users with a first event
--       • retained_users = # of those users who repeated the same event
--                          within +13 to +15 days
--       • retention_pct  = retained / cohort_size  (percentage)
-- BigQuery’s wildcard `events_*` reads all daily shards; LOWER() + LIKE finds
-- every quick‑play variant (start, complete, fail, etc.).
WITH session_users AS (        -- step‑1
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_date BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
qp_first AS (                  -- step‑2
  SELECT
    e.user_pseudo_id,
    e.event_name                              AS quickplay_type,
    MIN(TIMESTAMP_MICROS(e.event_timestamp))  AS first_qp_ts
  FROM `firebase-public-project.analytics_153293282.events_*` e
  JOIN session_users USING (user_pseudo_id)
  WHERE LOWER(e.event_name) LIKE '%quickplay%'
  GROUP BY e.user_pseudo_id, quickplay_type
),
qp_later AS (                  -- step‑3
  SELECT
    user_pseudo_id,
    event_name      AS quickplay_type,
    TIMESTAMP_MICROS(event_timestamp) AS ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE LOWER(event_name) LIKE '%quickplay%'
)
SELECT                           -- step‑4
  q.quickplay_type,
  COUNT(DISTINCT q.user_pseudo_id)                                         AS cohort_size,
  COUNT(DISTINCT CASE
         WHEN l.ts BETWEEN TIMESTAMP_ADD(q.first_qp_ts, INTERVAL 13 DAY)
                      AND TIMESTAMP_ADD(q.first_qp_ts, INTERVAL 15 DAY)
         THEN q.user_pseudo_id END)                                        AS retained_users,
  ROUND(
    100 * COUNT(DISTINCT CASE
            WHEN l.ts BETWEEN TIMESTAMP_ADD(q.first_qp_ts, INTERVAL 13 DAY)
                         AND TIMESTAMP_ADD(q.first_qp_ts, INTERVAL 15 DAY)
            THEN q.user_pseudo_id END)
    / COUNT(DISTINCT q.user_pseudo_id), 2)                                 AS retention_pct
FROM qp_first q
LEFT JOIN qp_later l
       ON l.user_pseudo_id = q.user_pseudo_id
      AND l.quickplay_type = q.quickplay_type
GROUP BY q.quickplay_type
ORDER BY retention_pct DESC;
