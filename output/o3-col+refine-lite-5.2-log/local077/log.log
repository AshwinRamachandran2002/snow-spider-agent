Below are 7 exploratory‑to‑final SQLs (all return ≤ 20 rows) that step through the requested analysis.

```sql
-- 1️⃣  Distinct months we need (Sep‑2018 ⟶ Aug‑2019)
SELECT DISTINCT "month_year"
FROM "interest_metrics"
WHERE (("_year"=2018 AND "_month">=9) OR ("_year"=2019 AND "_month"<=8))
ORDER BY "_year", "_month"
LIMIT 20;
```

```sql
-- 2️⃣  Look‑up table for interests (names that go with the IDs)
SELECT DISTINCT "id",
       "interest_name"
FROM "interest_map"
ORDER BY "id"
LIMIT 20;
```

```sql
-- 3️⃣  Example – average composition / index_value for SEP‑2018 (top 20 interests)
SELECT "month_year",
       "interest_id",
       AVG("composition"/NULLIF("index_value",0)) AS "avg_comp_ratio"
FROM "interest_metrics"
WHERE "_year" = 2018 AND "_month" = 9
GROUP BY "month_year","interest_id"
ORDER BY "avg_comp_ratio" DESC
LIMIT 20;
```

```sql
-- 4️⃣  For the whole period: one row per month = interest with highest avg ratio
WITH per_interest AS (               -- monthly ratios
     SELECT ("_year"*100+_month)      AS yr_mo,
            "month_year",
            "interest_id",
            AVG("composition"/NULLIF("index_value",0)) AS avg_comp_ratio
     FROM   "interest_metrics"
     WHERE  (("_year"=2018 AND "_month">=9) OR ("_year"=2019 AND "_month"<=8))
     GROUP  BY yr_mo,"month_year","interest_id"
),
ranked AS (                           -- pick the max per month
     SELECT *,
            ROW_NUMBER() OVER (PARTITION BY yr_mo
                               ORDER BY avg_comp_ratio DESC) AS rn
     FROM   per_interest
)
SELECT yr_mo,
       month_year,
       interest_id,
       avg_comp_ratio               -- max for that month
FROM   ranked
WHERE  rn = 1
ORDER  BY yr_mo
LIMIT 20;
```

```sql
-- 5️⃣  Same rows as #4, adding the readable interest name
WITH per_interest AS (
     SELECT ("_year"*100+_month) AS yr_mo,
            "month_year",
            "interest_id",
            AVG("composition"/NULLIF("index_value",0)) AS avg_comp_ratio
     FROM   "interest_metrics"
     WHERE  (("_year"=2018 AND "_month">=9) OR ("_year"=2019 AND "_month"<=8))
     GROUP  BY yr_mo,"month_year","interest_id"
),
ranked AS (
     SELECT *,
            ROW_NUMBER() OVER (PARTITION BY yr_mo ORDER BY avg_comp_ratio DESC) AS rn
     FROM   per_interest
)
SELECT r.yr_mo,
       r.month_year,
       i."interest_name",
       r.avg_comp_ratio
FROM   ranked AS r
JOIN   "interest_map" AS i
       ON i."id" = r."interest_id"
WHERE  r.rn = 1
ORDER  BY r.yr_mo
LIMIT 20;
```

```sql
-- 6️⃣  Add the 3‑month rolling average of each monthly maximum
WITH per_interest AS (
     SELECT ("_year"*100+_month) AS yr_mo,
            "month_year",
            "interest_id",
            AVG("composition"/NULLIF("index_value",0)) AS avg_comp_ratio
     FROM   "interest_metrics"
     WHERE  (("_year"=2018 AND "_month">=9) OR ("_year"=2019 AND "_month"<=8))
     GROUP  BY yr_mo,"month_year","interest_id"
),
monthly_max AS (
     SELECT *,
            ROW_NUMBER() OVER (PARTITION BY yr_mo ORDER BY avg_comp_ratio DESC) AS rn
     FROM   per_interest
),
max_only AS (
     SELECT yr_mo,
            month_year,
            interest_id,
            avg_comp_ratio
     FROM   monthly_max
     WHERE  rn = 1
)
SELECT m.month_year,
       im."interest_name",
       ROUND(m.avg_comp_ratio,4)                                         AS max_index_composition,
       ROUND(AVG(m.avg_comp_ratio) OVER (ORDER BY m.yr_mo
                           ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4) AS rolling_avg_3_month
FROM   max_only AS m
JOIN   "interest_map" AS im
       ON im."id" = m."interest_id"
ORDER  BY m.yr_mo
LIMIT 20;
```

```sql
-- 7️⃣  FINAL  – include previous‑month & two‑month‑ago leaders and their values
WITH per_interest AS (
     SELECT ("_year"*100+_month) AS yr_mo,
            "month_year",
            "interest_id",
            AVG("composition"/NULLIF("index_value",0)) AS avg_comp_ratio
     FROM   "interest_metrics"
     WHERE  (("_year"=2018 AND "_month">=9) OR ("_year"=2019 AND "_month"<=8))
     GROUP  BY yr_mo,"month_year","interest_id"
),
monthly_max AS (
     SELECT *,
            ROW_NUMBER() OVER (PARTITION BY yr_mo ORDER BY avg_comp_ratio DESC) AS rn
     FROM   per_interest
),
max_only AS (
     SELECT yr_mo,
            month_year,
            interest_id,
            avg_comp_ratio
     FROM   monthly_max
     WHERE  rn = 1
)
SELECT m.month_year                       AS "date",
       im."interest_name"                 AS "interest_name",
       ROUND(m.avg_comp_ratio,4)          AS "max_index_composition",
       ROUND(AVG(m.avg_comp_ratio) OVER (ORDER BY m.yr_mo
                           ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4) AS "rolling_avg_3_month",
       LAG(im."interest_name",1) OVER (ORDER BY m.yr_mo)                AS "prev_month_interest",
       ROUND(LAG(m.avg_comp_ratio,1) OVER (ORDER BY m.yr_mo),4)          AS "prev_month_max_comp",
       LAG(im."interest_name",2) OVER (ORDER BY m.yr_mo)                AS "two_months_ago_interest",
       ROUND(LAG(m.avg_comp_ratio,2) OVER (ORDER BY m.yr_mo),4)          AS "two_months_ago_max_comp"
FROM   max_only AS m
JOIN   "interest_map" AS im
       ON im."id" = m."interest_id"
ORDER  BY m.yr_mo
LIMIT 20;
```

These queries progress from inspecting the raw period, through calculating per‑interest ratios, isolating each month’s top interest, adding rolling averages, and finally presenting the full report with previous‑month comparisons.
