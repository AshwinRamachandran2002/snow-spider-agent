Query:
--Description: Sum the species‑level changes inside each fall‑color group to see the overall change per color.
WITH living_1995 AS (
  SELECT spc_latin, COUNT(*) AS living_1995
  FROM `bigquery-public-data.new_york.tree_census_1995`
  WHERE UPPER(status) <> 'DEAD'
  GROUP BY spc_latin
),
living_2015 AS (
  SELECT spc_latin, COUNT(*) AS living_2015
  FROM `bigquery-public-data.new_york.tree_census_2015`
  WHERE UPPER(status) <> 'DEAD'
  GROUP BY spc_latin
),
fall_lookup AS (
  SELECT UPPER(species_scientific_name) AS spc_latin,
         fall_color
  FROM `bigquery-public-data.new_york.tree_species`
),
species_change AS (
  SELECT
    COALESCE(l95.spc_latin, l15.spc_latin)                     AS spc_latin,
    IFNULL(l95.living_1995,0)                                  AS living_1995,
    IFNULL(l15.living_2015,0)                                  AS living_2015,
    IFNULL(l15.living_2015,0) - IFNULL(l95.living_1995,0)      AS change_95_to_15
  FROM living_1995 AS l95
  FULL JOIN living_2015 AS l15
         ON l95.spc_latin = l15.spc_latin
)
SELECT
  fl.fall_color,
  SUM(sc.change_95_to_15) AS total_change_95_to_15
FROM species_change AS sc
LEFT JOIN fall_lookup AS fl
       ON fl.spc_latin = sc.spc_latin
GROUP BY fl.fall_color
ORDER BY total_change_95_to_15 DESC
LIMIT 20
