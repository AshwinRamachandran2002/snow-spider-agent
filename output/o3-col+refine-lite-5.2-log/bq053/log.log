```

```sql
-- 2. Preview a few 2015 census trees
SELECT recordid, borough, status, spc_latin, diameter
FROM `bigquery-public-data.new_york.tree_census_2015`
LIMIT 20;
```

```sql
-- 3. What status values appear in 1995?  (We need to know the word that means “dead”.)
SELECT DISTINCT status
FROM `bigquery-public-data.new_york.tree_census_1995`
LIMIT 20;
```

```sql
-- 4. What status values appear in 2015?
SELECT DISTINCT status
FROM `bigquery-public-data.new_york.tree_census_2015`
LIMIT 20;
```

```sql
-- 5. Count 1995 trees *not* marked as “Dead”, by species (Latin name)
SELECT spc_latin,
       COUNT(*) AS living_1995
FROM `bigquery-public-data.new_york.tree_census_1995`
WHERE UPPER(status) <> 'DEAD'
GROUP BY spc_latin
ORDER BY living_1995 DESC
LIMIT 20;
```

```sql
-- 6. Count 2015 trees whose status is “Alive” (or not “Dead”), by species
SELECT spc_latin,
       COUNT(*) AS living_2015
FROM `bigquery-public-data.new_york.tree_census_2015`
WHERE UPPER(status) = 'ALIVE'            -- if an “ALIVE” flag exists
   OR UPPER(status) <> 'DEAD'            -- otherwise still exclude “DEAD”
GROUP BY spc_latin
ORDER BY living_2015 DESC
LIMIT 20;
```

```sql
-- 7. Bring in the fall color for each Latin name from the tree_species table
SELECT UPPER(ts.species_scientific_name) AS spc_latin,
       ts.fall_color
FROM `bigquery-public-data.new_york.tree_species` AS ts
LIMIT 20;
```

```sql
-- 8. Combine (5) and (6) with the fall‑color lookup to see the per‑species change
SELECT   COALESCE(l95.spc_latin, l15.spc_latin)                   AS spc_latin,
         fs.fall_color,
         IFNULL(l95.living_1995,0)                                AS living_1995,
         IFNULL(l15.living_2015,0)                                AS living_2015,
         IFNULL(l15.living_2015,0) - IFNULL(l95.living_1995,0)    AS change_95_to_15
FROM  (
        -- living 1995 per species
        SELECT spc_latin, COUNT(*) AS living_1995
        FROM `bigquery-public-data.new_york.tree_census_1995`
        WHERE UPPER(status) <> 'DEAD'
        GROUP BY spc_latin
      ) AS l95
FULL JOIN (
        -- living 2015 per species
        SELECT spc_latin, COUNT(*) AS living_2015
        FROM `bigquery-public-data.new_york.tree_census_2015`
        WHERE UPPER(status) = 'ALIVE'
           OR UPPER(status) <> 'DEAD'
        GROUP BY spc_latin
      ) AS l15
ON l95.spc_latin = l15.spc_latin
LEFT JOIN (
        -- fall‑color lookup
        SELECT UPPER(species_scientific_name) AS spc_latin,
               fall_color
        FROM `bigquery-public-data.new_york.tree_species`
      ) AS fs
ON fs.spc_latin = COALESCE(l95.spc_latin, l15.spc_latin)
LIMIT 20;
```

```sql
-- 9. Sum the species‑level changes inside each fall color group
SELECT   fs.fall_color,
         SUM(change_95_to_15) AS total_change_95_to_15
FROM (
      -- the per‑species change calculated in (8)
      SELECT   COALESCE(l95.spc_latin, l15.spc_latin) AS spc_latin,
               IFNULL(l95.living_1995,0)  AS living_1995,
               IFNULL(l15.living_2015,0)  AS living_2015,
               IFNULL(l15.living_2015,0) - IFNULL(l95.living_1995,0) AS change_95_to_15
      FROM (
            SELECT spc_latin, COUNT(*) AS living_1995
            FROM `bigquery-public-data.new_york.tree_census_1995`
            WHERE UPPER(status) <> 'DEAD'
            GROUP BY spc_latin
           ) AS l95
      FULL JOIN (
            SELECT spc_latin, COUNT(*) AS living_2015
            FROM `bigquery-public-data.new_york.tree_census_2015`
            WHERE UPPER(status) = 'ALIVE'
               OR UPPER(status) <> 'DEAD'
            GROUP BY spc_latin
           ) AS l15
      ON l95.spc_latin = l15.spc_latin
      LEFT JOIN (
            SELECT UPPER(species_scientific_name) AS spc_latin,
                   fall_color
            FROM `bigquery-public-data.new_york.tree_species`
           ) AS fs
      ON fs.spc_latin = COALESCE(l95.spc_latin, l15.spc_latin)
     ) AS species_change
GROUP BY fs.fall_color
ORDER BY total_change_95_to_15 DESC
LIMIT 20;
```

```sql
-- 10. Final concise query that returns ONLY the fall‑color totals requested
SELECT   fall_color,
         SUM(change_95_to_15) AS total_change_95_to_15
FROM (
      SELECT  COALESCE(l95.spc_latin, l15.spc_latin) AS latin,
              fs.fall_color,
              IFNULL(l15.c15,0) - IFNULL(l95.c95,0)  AS change_95_to_15
      FROM  (
            SELECT spc_latin, COUNT(*) AS c95
            FROM `bigquery-public-data.new_york.tree_census_1995`
            WHERE UPPER(status) <> 'DEAD'
            GROUP BY spc_latin
           ) AS l95
      FULL JOIN (
            SELECT spc_latin, COUNT(*) AS c15
            FROM `bigquery-public-data.new_york.tree_census_2015`
            WHERE UPPER(status) = 'ALIVE'
               OR UPPER(status) <> 'DEAD'
            GROUP BY spc_latin
           ) AS l15
      ON l95.spc_latin = l15.spc_latin
      LEFT JOIN (
            SELECT UPPER(species_scientific_name) AS latin,
                   fall_color
            FROM `bigquery-public-data.new_york.tree_species`
           ) AS fs
      ON fs.latin = COALESCE(l95.spc_latin, l15.spc_latin)
     )
GROUP BY fall_color
ORDER BY total_change_95_to_15 DESC;
```

These ten progressively more‑complex queries:

1‑2: quick peeks at the two census tables  
3‑4: find the status keywords we must filter on  
5‑6: count living trees for each species in each year  
7: bring in each species’ fall color  
8: join counts and colors to compute per‑species change  
9: roll those changes up by fall color (with sample limit)  
10: the final answer query that produces the required totals.
