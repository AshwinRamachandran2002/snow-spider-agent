Query:
-- 6) Annual totals: spend, quantity and average purchase price (USD/BTC) by region
WITH txn_pricing AS (
    SELECT bm."region",
           CAST(substr(bt."txn_date", 7, 4) AS INTEGER) AS "calendar_year",
           (bt."quantity" * bp."price")                 AS "spend",
           bt."quantity"                                AS "qty"
    FROM   "bitcoin_transactions" AS bt
    JOIN   "bitcoin_members"      AS bm  ON bt."member_id" = bm."member_id"
    JOIN   "bitcoin_prices"       AS bp  ON bp."ticker" = bt."ticker"
                                         AND bp."market_date" = bt."txn_date"
    WHERE  bt."ticker"   = 'BTC'
      AND  bt."txn_type" = 'BUY'
)
SELECT   "region",
         "calendar_year",
         SUM("spend")     AS "total_dollar_spent",
         SUM("qty")       AS "total_btc_bought",
         SUM("spend")*1.0 / SUM("qty") AS "avg_price_usd_per_btc"
FROM     txn_pricing
GROUP BY "region", "calendar_year"
ORDER BY "region", "calendar_year"
LIMIT 20;
