```

```sql
-- 5) Attach daily BTC market prices to individual purchase transactions
SELECT bt."txn_id",
       bm."region",
       bt."txn_date",
       bp."price",
       bt."quantity",
       (bt."quantity" * bp."price") AS "spend_usd"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm  ON bt."member_id" = bm."member_id"
JOIN   "bitcoin_prices"       AS bp  ON bp."ticker" = bt."ticker"
                                     AND bp."market_date" = bt."txn_date"
WHERE  bt."ticker"    = 'BTC'
  AND  bt."txn_type"  = 'BUY'
LIMIT 20;
```

```sql
-- 6) Annual totals: spend, quantity and average purchase price (USD/BTC) by region
WITH txn_pricing AS (
    SELECT bm."region",
           CAST(substr(bt."txn_date", 7, 4) AS INTEGER) AS "calendar_year",
           (bt."quantity" * bp."price")                 AS "spend",
           bt."quantity"                                AS "qty"
    FROM   "bitcoin_transactions" AS bt
    JOIN   "bitcoin_members"      AS bm  ON bt."member_id" = bm."member_id"
    JOIN   "bitcoin_prices"       AS bp  ON bp."ticker" = bt."ticker"
                                         AND bp."market_date" = bt."txn_date"
    WHERE  bt."ticker"   = 'BTC'
      AND  bt."txn_type" = 'BUY'
)
SELECT   "region",
         "calendar_year",
         SUM("spend")     AS "total_dollar_spent",
         SUM("qty")       AS "total_btc_bought",
         SUM("spend")*1.0 / SUM("qty") AS "avg_price_usd_per_btc"
FROM     txn_pricing
GROUP BY "region", "calendar_year"
ORDER BY "region", "calendar_year"
LIMIT 20;
```

```sql
-- 7) Exclude the first purchase‑year for each region and keep subsequent years
WITH region_year_stats AS (
    SELECT   "region",
             "calendar_year",
             SUM("spend") AS "spend",
             SUM("qty")   AS "qty",
             SUM("spend")*1.0 / SUM("qty") AS "avg_price"
    FROM   (
        SELECT bm."region",
               CAST(substr(bt."txn_date", 7, 4) AS INTEGER) AS "calendar_year",
               (bt."quantity" * bp."price") AS "spend",
               bt."quantity"                AS "qty"
        FROM   "bitcoin_transactions" AS bt
        JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
        JOIN   "bitcoin_prices"       AS bp ON bp."ticker" = bt."ticker"
                                           AND bp."market_date" = bt."txn_date"
        WHERE  bt."ticker"   = 'BTC'
          AND  bt."txn_type" = 'BUY'
    )
    GROUP BY "region", "calendar_year"
),
region_first_year AS (
    SELECT "region", MIN("calendar_year") AS "first_year"
    FROM   region_year_stats
    GROUP BY "region"
)
SELECT rys.*
FROM   region_year_stats AS rys
JOIN   region_first_year AS rfy
       ON rys."region" = rfy."region"
WHERE  rys."calendar_year" > rfy."first_year"
ORDER BY rys."region", rys."calendar_year"
LIMIT 20;
```

```sql
-- 8) Rank regions by annual average purchase price and compute YoY % change
WITH region_year_stats AS (
    SELECT   "region",
             "calendar_year",
             SUM("spend") AS "spend",
             SUM("qty")   AS "qty",
             SUM("spend")*1.0 / SUM("qty") AS "avg_price"
    FROM   (
        SELECT bm."region",
               CAST(substr(bt."txn_date", 7, 4) AS INTEGER) AS "calendar_year",
               (bt."quantity" * bp."price") AS "spend",
               bt."quantity"                AS "qty"
        FROM   "bitcoin_transactions" AS bt
        JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
        JOIN   "bitcoin_prices"       AS bp ON bp."ticker" = bt."ticker"
                                           AND bp."market_date" = bt."txn_date"
        WHERE  bt."ticker"   = 'BTC'
          AND  bt."txn_type" = 'BUY'
    )
    GROUP BY "region", "calendar_year"
),
exclude_first_year AS (
    SELECT rys.*
    FROM   region_year_stats AS rys
    JOIN (
        SELECT "region", MIN("calendar_year") AS "first_year"
        FROM   region_year_stats
        GROUP BY "region"
    ) AS rf
    ON rys."region" = rf."region"
    WHERE rys."calendar_year" > rf."first_year"
),
ranked AS (
    SELECT *,
           RANK() OVER (PARTITION BY "calendar_year"
                        ORDER BY "avg_price" DESC) AS "price_rank",
           LAG("avg_price") OVER (PARTITION BY "region"
                                  ORDER BY "calendar_year") AS "prev_avg_price"
    FROM   exclude_first_year
)
SELECT "region",
       "calendar_year",
       ROUND("avg_price", 2)              AS "avg_price_usd_per_btc",
       "price_rank",
       ROUND(
           (("avg_price" - "prev_avg_price") * 100.0) / "prev_avg_price",
           2
       )                                   AS "pct_change_vs_prev_year"
FROM   ranked
ORDER BY "calendar_year", "price_rank"
LIMIT 20;
```

These eight queries progressively explore the relevant tables, join them to build spend and quantity metrics, remove the first year per region, and finally rank regions annually while calculating their year‑over‑year percentage change in the average purchase price of Bitcoin.
