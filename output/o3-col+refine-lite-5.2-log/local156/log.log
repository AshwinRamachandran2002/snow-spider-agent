    "calendar_year",
    ROUND("avg_price", 4)                                           AS "avg_price_usd_per_btc",
    "price_rank",
    ROUND((("avg_price" - "prev_avg_price") * 100.0) /
          "prev_avg_price", 4)                                      AS "pct_change_vs_prev_year"
FROM   rank_and_change
