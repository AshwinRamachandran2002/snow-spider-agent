```sql
-- 2. Description: Take a quick look at the different product categories sold
SELECT DISTINCT product_category_name
FROM olist_products
LIMIT 20;
```

```sql
-- 3. Description: Preview how a single order line (item) connects to its category
SELECT oi.order_id,
       oi.product_id,
       pr.product_category_name
FROM   olist_order_items AS oi
JOIN   olist_products     AS pr ON pr.product_id = oi.product_id
LIMIT 20;
```

```sql
-- 4. Description: Show payments together with the category(‑ies) that belong to
-- the same order (one row per order–category–payment record)
SELECT oc.order_id,
       oc.product_category_name,
       pay.payment_type
FROM  ( SELECT DISTINCT oi.order_id,
                       pr.product_category_name
        FROM   olist_order_items  AS oi
        JOIN   olist_products     AS pr ON pr.product_id = oi.product_id
      )                    AS oc
JOIN   olist_order_payments AS pay ON pay.order_id = oc.order_id
LIMIT 20;
```

```sql
-- 5. Description: Count how many payment rows each payment method generates
-- inside each product category
SELECT product_category_name,
       payment_type,
       COUNT(*) AS num_payments
FROM  ( SELECT DISTINCT oi.order_id,
                       pr.product_category_name
        FROM   olist_order_items AS oi
        JOIN   olist_products    AS pr ON pr.product_id = oi.product_id
      )            AS oc
JOIN   olist_order_payments AS pay ON pay.order_id = oc.order_id
GROUP  BY product_category_name, payment_type
LIMIT 20;
```

```sql
-- 6. Description: For every category, rank payment methods by their popularity
WITH payments_per_cat AS (
    SELECT product_category_name,
           payment_type,
           COUNT(*) AS num_payments
    FROM  ( SELECT DISTINCT oi.order_id,
                           pr.product_category_name
            FROM   olist_order_items AS oi
            JOIN   olist_products    AS pr ON pr.product_id = oi.product_id
          )            AS oc
    JOIN   olist_order_payments AS pay ON pay.order_id = oc.order_id
    GROUP  BY product_category_name, payment_type
)
SELECT product_category_name,
       payment_type,
       num_payments,
       ROW_NUMBER() OVER (PARTITION BY product_category_name
                          ORDER BY num_payments DESC, payment_type) AS rn
FROM   payments_per_cat
LIMIT 20;
```

```sql
-- 7. Description: Isolate, per category, only the “most‑preferred” payment method
WITH payments_per_cat AS (
    SELECT product_category_name,
           payment_type,
           COUNT(*) AS num_payments
    FROM  ( SELECT DISTINCT oi.order_id,
                           pr.product_category_name
            FROM   olist_order_items AS oi
            JOIN   olist_products    AS pr ON pr.product_id = oi.product_id
          )            AS oc
    JOIN   olist_order_payments AS pay ON pay.order_id = oc.order_id
    GROUP  BY product_category_name, payment_type
), ranked AS (
    SELECT product_category_name,
           payment_type,
           num_payments,
           ROW_NUMBER() OVER (PARTITION BY product_category_name
                              ORDER BY num_payments DESC, payment_type) AS rn
    FROM   payments_per_cat
)
SELECT product_category_name,
       payment_type,
       num_payments        -- total number of payments of the preferred method
FROM   ranked
WHERE  rn = 1
LIMIT 20;
```

```sql
-- 8. Description: Finally compute the average (across all categories) of those
-- “total number of payments by the preferred method”
WITH order_categories AS (
    SELECT DISTINCT oi.order_id,
                    pr.product_category_name
    FROM   olist_order_items AS oi
    JOIN   olist_products    AS pr ON pr.product_id = oi.product_id
),
payments_per_cat AS (
    SELECT oc.product_category_name,
           pay.payment_type,
           COUNT(*) AS num_payments
    FROM   order_categories  AS oc
    JOIN   olist_order_payments AS pay ON pay.order_id = oc.order_id
    GROUP  BY oc.product_category_name, pay.payment_type
),
preferred AS (
    SELECT product_category_name,
           num_payments
    FROM (
        SELECT product_category_name,
               num_payments,
               ROW_NUMBER() OVER (PARTITION BY product_category_name
                                  ORDER BY num_payments DESC, payment_type) AS rn
        FROM   payments_per_cat
    ) WHERE rn = 1
)
SELECT AVG(num_payments) AS avg_num_payments_of_preferred_method
FROM   preferred
LIMIT 20;
```
