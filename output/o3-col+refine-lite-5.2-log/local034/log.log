-- 6. Description: For every category, rank payment methods by their popularity
WITH payments_per_cat AS (
    SELECT product_category_name,
           payment_type,
           COUNT(*) AS num_payments
    FROM  ( SELECT DISTINCT oi.order_id,
                           pr.product_category_name
            FROM   olist_order_items AS oi
            JOIN   olist_products    AS pr ON pr.product_id = oi.product_id
          )            AS oc
    JOIN   olist_order_payments AS pay ON pay.order_id = oc.order_id
    GROUP  BY product_category_name, payment_type
)
SELECT product_category_name,
       payment_type,
       num_payments,
       ROW_NUMBER() OVER (PARTITION BY product_category_name
                          ORDER BY num_payments DESC, payment_type) AS rn
FROM   payments_per_cat
LIMIT 20;
