FROM (
      SELECT "id",
             REGEXP_SUBSTR("content", 'import \\([^)]+\\)', 1, 1, 'e') AS "import_block"
      FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
      WHERE "content" ILIKE '%import (%'
) t
WHERE "import_block" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Split each captured block on new‑lines so every individual import line becomes one row.
SELECT t."id",
       TRIM(l.value) AS "import_line"
FROM (
      SELECT "id",
             REGEXP_SUBSTR("content", 'import \\([^)]+\\)', 1, 1, 'e') AS "import_block"
      FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
      WHERE "content" ILIKE '%import (%'
) t,
LATERAL SPLIT_TO_TABLE(REGEXP_REPLACE(t."import_block", '^import \\(|\\)$', ''), '\n') l
LIMIT 20;
```

```sql
--Description: Keep only lines that actually contain a quoted package path (quick heuristic with “"”).
SELECT *
FROM (
      SELECT t."id",
             TRIM(l.value) AS "import_line"
      FROM (
            SELECT "id",
                   REGEXP_SUBSTR("content", 'import \\([^)]+\\)', 1, 1, 'e') AS "import_block"
            FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
            WHERE "content" ILIKE '%import (%'
      ) t,
      LATERAL SPLIT_TO_TABLE(REGEXP_REPLACE(t."import_block", '^import \\(|\\)$', ''), '\n') l
) s
WHERE "import_line" ILIKE '%"%'
LIMIT 20;
```

```sql
--Description: Extract the raw package name that sits inside double quotes on each line.
SELECT DISTINCT
       REGEXP_SUBSTR(TRIM("import_line"), '"([^"]+)"', 1, 1, 'e', 1) AS "package"
FROM (
      SELECT t."id",
             TRIM(l.value) AS "import_line"
      FROM (
            SELECT "id",
                   REGEXP_SUBSTR("content", 'import \\([^)]+\\)', 1, 1, 'e') AS "import_block"
            FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
            WHERE "content" ILIKE '%import (%'
      ) t,
      LATERAL SPLIT_TO_TABLE(REGEXP_REPLACE(t."import_block", '^import \\(|\\)$', ''), '\n') l
) s
WHERE "import_line" ILIKE '%"%'
      AND REGEXP_SUBSTR(TRIM("import_line"), '"([^"]+)"', 1, 1, 'e', 1) IS NOT NULL
LIMIT 20;
```

```sql
--Description: Produce one row per extracted package (nulls removed) to prepare for counting.
SELECT
       REGEXP_SUBSTR(TRIM("import_line"), '"([^"]+)"', 1, 1, 'e', 1) AS "package"
FROM (
      SELECT t."id",
             TRIM(l.value) AS "import_line"
      FROM (
            SELECT "id",
                   REGEXP_SUBSTR("content", 'import \\([^)]+\\)', 1, 1, 'e') AS "import_block"
            FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
            WHERE "content" ILIKE '%import (%'
      ) t,
      LATERAL SPLIT_TO_TABLE(REGEXP_REPLACE(t."import_block", '^import \\(|\\)$', ''), '\n') l
) s
WHERE "package" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Count how many times each package appears over all files; order by most‑used.
SELECT "package",
       COUNT(*) AS "usage_count"
FROM (
      SELECT
             REGEXP_SUBSTR(TRIM("import_line"), '"([^"]+)"', 1, 1, 'e', 1) AS "package"
      FROM (
            SELECT t."id",
                   TRIM(l.value) AS "import_line"
            FROM (
                  SELECT "id",
                         REGEXP_SUBSTR("content", 'import \\([^)]+\\)', 1, 1, 'e') AS "import_block"
                  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
                  WHERE "content" ILIKE '%import (%'
            ) t,
            LATERAL SPLIT_TO_TABLE(REGEXP_REPLACE(t."import_block", '^import \\(|\\)$', ''), '\n') l
      ) s
      WHERE "import_line" ILIKE '%"%'
) p
WHERE "package" IS NOT NULL
GROUP BY "package"
ORDER BY "usage_count" DESC
LIMIT 20;
```

```sql
--Description: Final result – the top‑10 most frequently imported packages (quotation marks already removed).
WITH imports AS (
     SELECT REGEXP_SUBSTR("content", 'import \\([^)]+\\)', 1, 1, 'e') AS "import_block"
     FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
     WHERE "content" ILIKE '%import (%'
),
lines AS (
     SELECT TRIM(l.value) AS "import_line"
     FROM imports,
     LATERAL SPLIT_TO_TABLE(REGEXP_REPLACE("import_block", '^import \\(|\\)$', ''), '\n') l
),
pkgs AS (
     SELECT REGEXP_SUBSTR("import_line", '"([^"]+)"', 1, 1, 'e', 1) AS "package"
     FROM lines
     WHERE "import_line" ILIKE '%"%'
)
SELECT "package",
       COUNT(*) AS "usage_count"
FROM pkgs
WHERE "package" IS NOT NULL
GROUP BY "package"
ORDER BY "usage_count" DESC
LIMIT 10;
```
