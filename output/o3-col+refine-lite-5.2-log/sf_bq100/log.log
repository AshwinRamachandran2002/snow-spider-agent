       "sample_path",
       LEFT("content", 500) AS "content_snippet"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE "content" ILIKE '%import (%'
LIMIT 20;
```

```sql
--Description: Extract the first multi‑line import block (everything between “import (” and its matching “)”) from those files.
