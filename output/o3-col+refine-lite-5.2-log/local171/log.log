```sql
--Description: Check which states appear for male legislators (to confirm that “LA” is present).
SELECT DISTINCT lt.state
FROM legislators_terms AS lt
JOIN legislators       AS l
  ON l.id_bioguide = lt.id_bioguide
WHERE l.gender = 'M'
LIMIT 20;
```

```sql
--Description: List the male legislators from Louisiana with their bioguide IDs and names.
SELECT DISTINCT l.id_bioguide,
       l.full_name
FROM legislators         AS l
JOIN legislators_terms   AS lt
  ON l.id_bioguide = lt.id_bioguide
WHERE l.gender = 'M'
  AND lt.state = 'LA'
LIMIT 20;
```

```sql
--Description: Show every term (start / end) for those Louisiana male legislators.
SELECT lt.id_bioguide,
       lt.term_number,
       lt.term_start,
       lt.term_end,
       lt.party
FROM legislators_terms AS lt
WHERE lt.id_bioguide IN (
        SELECT l.id_bioguide
        FROM legislators       AS l
        JOIN legislators_terms AS lt2
          ON l.id_bioguide = lt2.id_bioguide
        WHERE l.gender = 'M'
          AND lt2.state = 'LA')
ORDER BY lt.id_bioguide,
         lt.term_start
LIMIT 20;
```

```sql
--Description: Retrieve the first‐term (earliest) year for every Louisiana male legislator.
SELECT lt.id_bioguide,
       MIN(lt.term_start)             AS first_term_start,
       CAST(substr(MIN(lt.term_start),1,4) AS INTEGER) AS first_term_year
FROM legislators_terms AS lt
JOIN legislators       AS l
  ON l.id_bioguide = lt.id_bioguide
WHERE l.gender = 'M'
  AND lt.state = 'LA'
GROUP BY lt.id_bioguide
LIMIT 20;
```

```sql
--Description: Produce every “elapsed‑year” anniversary date (Dec‑31) that is >30 & <50 yrs after first term, per legislator.
WITH first AS (
    SELECT lt.id_bioguide,
           CAST(substr(MIN(lt.term_start),1,4) AS INTEGER) AS first_year
    FROM legislators_terms AS lt
    JOIN legislators       AS l
      ON l.id_bioguide = lt.id_bioguide
    WHERE l.gender = 'M'
      AND lt.state = 'LA'
    GROUP BY lt.id_bioguide
),
years AS (
    SELECT id_bioguide,
           first_year,
           31 AS yrs_elapsed
    FROM first
    UNION ALL
    SELECT id_bioguide,
           first_year,
           yrs_elapsed + 1
    FROM years
    WHERE yrs_elapsed + 1 < 50
)
SELECT *
FROM years
LIMIT 20;
```

```sql
--Description: Attach a concrete date (YYYY‑12‑31) for each generated yrs_elapsed row.
WITH first AS (
    SELECT lt.id_bioguide,
           CAST(substr(MIN(lt.term_start),1,4) AS INTEGER) AS first_year
    FROM legislators_terms AS lt
    JOIN legislators       AS l
      ON l.id_bioguide = lt.id_bioguide
    WHERE l.gender = 'M'
      AND lt.state = 'LA'
    GROUP BY lt.id_bioguide
),
years AS (
    SELECT id_bioguide,
           first_year,
           31 AS yrs_elapsed
    FROM first
    UNION ALL
    SELECT id_bioguide,
           first_year,
           yrs_elapsed + 1
    FROM years
    WHERE yrs_elapsed + 1 < 50
)
SELECT id_bioguide,
       yrs_elapsed,
       (first_year + yrs_elapsed) || '-12-31' AS check_date
FROM years
LIMIT 20;
```

```sql
--Description: Determine whether each legislator was actively serving on the generated Dec‑31 dates.
WITH first AS (
    SELECT lt.id_bioguide,
           CAST(substr(MIN(lt.term_start),1,4) AS INTEGER) AS first_year
    FROM legislators_terms AS lt
    JOIN legislators       AS l
      ON l.id_bioguide = lt.id_bioguide
    WHERE l.gender = 'M'
      AND lt.state = 'LA'
    GROUP BY lt.id_bioguide
),
years AS (
    SELECT id_bioguide,
           first_year,
           31 AS yrs_elapsed
    FROM first
    UNION ALL
    SELECT id_bioguide,
           first_year,
           yrs_elapsed + 1
    FROM years
    WHERE yrs_elapsed + 1 < 50
),
dates AS (
    SELECT id_bioguide,
           yrs_elapsed,
           (first_year + yrs_elapsed) || '-12-31' AS check_date
    FROM years
)
SELECT d.id_bioguide,
       d.yrs_elapsed,
       d.check_date
FROM dates         AS d
JOIN legislators_terms AS lt
  ON lt.id_bioguide = d.id_bioguide
WHERE lt.term_start <= d.check_date
  AND lt.term_end   >= d.check_date
LIMIT 20;
```

```sql
--Description: Count distinct legislators active on each elapsed‐year bucket (>30 & <50 years since first term).
WITH first AS (
    SELECT lt.id_bioguide,
           CAST(substr(MIN(lt.term_start),1,4) AS INTEGER) AS first_year
    FROM legislators_terms AS lt
    JOIN legislators       AS l
      ON l.id_bioguide = lt.id_bioguide
    WHERE l.gender = 'M'
      AND lt.state = 'LA'
    GROUP BY lt.id_bioguide
),
years AS (
    SELECT id_bioguide,
           first_year,
           31 AS yrs_elapsed
    FROM first
    UNION ALL
    SELECT id_bioguide,
           first_year,
           yrs_elapsed + 1
    FROM years
    WHERE yrs_elapsed + 1 < 50
),
dates AS (
    SELECT id_bioguide,
           yrs_elapsed,
           (first_year + yrs_elapsed) || '-12-31' AS check_date
    FROM years
),
active AS (
    SELECT DISTINCT d.id_bioguide,
           d.yrs_elapsed
    FROM dates             AS d
    JOIN legislators_terms AS lt
      ON lt.id_bioguide = d.id_bioguide
     AND lt.term_start <= d.check_date
     AND lt.term_end   >= d.check_date
)
SELECT yrs_elapsed                           AS years_since_first_term,
       COUNT(DISTINCT id_bioguide)           AS active_legislators
FROM active
GROUP BY yrs_elapsed
ORDER BY yrs_elapsed
LIMIT 20;
```

