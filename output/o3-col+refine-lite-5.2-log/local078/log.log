Query:
--Description: For every category, find its peak (maximum) composition and show the 10 highest peaks
SELECT mp."interest_name",
       MAX(im."composition") AS "max_composition"
FROM "interest_metrics" AS im
JOIN "interest_map"      AS mp
  ON im."interest_id" = mp."id"
GROUP BY mp."interest_name"
ORDER BY "max_composition" DESC
LIMIT 10;
