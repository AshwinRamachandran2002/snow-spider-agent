```sql
--Description: 
-- Thinking process:
-- 1. For every interest_id, calculate its peak (maximum) composition across all months (mx CTE).
-- 2. Join mx back to interest_metrics to capture the exact month‑year of each peak (detail CTE).
-- 3. Join to interest_map for readable interest names.
-- 4. From detail, pull the 10 highest peaks and the 10 lowest peaks, then UNION ALL
--    so the final result includes the top‑10 and bottom‑10 categories together.
WITH mx AS (
    SELECT
        "interest_id",
        MAX("composition") AS max_composition
    FROM "interest_metrics"
    GROUP BY "interest_id"
),
detail AS (
    SELECT
        im."month_year",
        im."interest_id",
        mx.max_composition
    FROM "interest_metrics" AS im
    JOIN mx
      ON mx."interest_id"     = im."interest_id"
     AND mx.max_composition    = im."composition"
)
SELECT *
FROM (
        SELECT
            d."month_year"      AS "time(MM-YYYY)",
            mp."interest_name",
            d.max_composition   AS "composition_value"
        FROM detail AS d
        JOIN "interest_map" AS mp
          ON mp."id" = d."interest_id"
        ORDER BY d.max_composition DESC
        LIMIT 10
     )
UNION ALL
SELECT *
FROM (
        SELECT
            d."month_year"      AS "time(MM-YYYY)",
            mp."interest_name",
            d.max_composition   AS "composition_value"
        FROM detail AS d
        JOIN "interest_map" AS mp
          ON mp."id" = d."interest_id"
        ORDER BY d.max_composition ASC
        LIMIT 10
     );
```
