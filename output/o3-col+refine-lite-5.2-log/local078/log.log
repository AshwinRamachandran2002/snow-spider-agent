```sql
--Description: Retrieve a quick look at distinct interest IDs available in the metrics table
SELECT DISTINCT "interest_id"
FROM "interest_metrics"
LIMIT 20;
```

```sql
--Description: Check the master list of interest categories and their names
SELECT "id", "interest_name"
FROM "interest_map"
LIMIT 20;
```

```sql
--Description: Preview some monthly records side‑by‑side with their interest names
SELECT im."month_year",
       im."interest_id",
       mp."interest_name",
       im."composition"
FROM "interest_metrics" AS im
JOIN "interest_map"    AS mp
  ON im."interest_id" = mp."id"
LIMIT 20;
```

```sql
--Description: For every category, find its peak (maximum) composition and show the 10 highest peaks
SELECT mp."interest_name",
       MAX(im."composition") AS "max_composition"
FROM "interest_metrics" AS im
JOIN "interest_map"      AS mp
  ON im."interest_id" = mp."id"
GROUP BY mp."interest_name"
ORDER BY "max_composition" DESC
LIMIT 10;
```

```sql
--Description: Same calculation, but list the 10 categories with the lowest peak composition
SELECT mp."interest_name",
       MAX(im."composition") AS "max_composition"
FROM "interest_metrics" AS im
JOIN "interest_map"      AS mp
  ON im."interest_id" = mp."id"
GROUP BY mp."interest_name"
ORDER BY "max_composition" ASC
LIMIT 10;
```

```sql
--Description: Capture the exact month‑year at which each category hit its highest composition (top 10)
SELECT sub."month_year",
       mp."interest_name",
       sub."max_composition"
FROM (
        SELECT "interest_id",
               MAX("composition") AS "max_composition"
        FROM "interest_metrics"
        GROUP BY "interest_id"
     ) AS mx
JOIN "interest_metrics" AS sub
  ON sub."interest_id" = mx."interest_id"
 AND sub."composition"  = mx."max_composition"
JOIN "interest_map"     AS mp
  ON mp."id" = sub."interest_id"
ORDER BY sub."max_composition" DESC
LIMIT 10;
```

```sql
--Description: Capture the exact month‑year at which each category hit its highest composition (bottom 10)
SELECT sub."month_year",
       mp."interest_name",
       sub."max_composition"
FROM (
        SELECT "interest_id",
               MAX("composition") AS "max_composition"
        FROM "interest_metrics"
        GROUP BY "interest_id"
     ) AS mx
JOIN "interest_metrics" AS sub
  ON sub."interest_id" = mx."interest_id"
 AND sub."composition"  = mx."max_composition"
JOIN "interest_map"     AS mp
  ON mp."id" = sub."interest_id"
ORDER BY sub."max_composition" ASC
LIMIT 10;
```

```sql
--Description: Combine the top 10 and bottom 10 peak‑composition categories into one final result set
SELECT *
FROM (
        SELECT sub."month_year"      AS "time(MM-YYYY)",
               mp."interest_name",
               sub."max_composition" AS "composition_value"
        FROM (
                SELECT "interest_id",
                       MAX("composition") AS "max_composition"
                FROM "interest_metrics"
                GROUP BY "interest_id"
             ) AS mx
        JOIN "interest_metrics" AS sub
          ON sub."interest_id" = mx."interest_id"
         AND sub."composition"  = mx."max_composition"
        JOIN "interest_map"     AS mp
          ON mp."id" = sub."interest_id"
        ORDER BY sub."max_composition" DESC
        LIMIT 10
     )
UNION ALL
SELECT *
FROM (
        SELECT sub."month_year"      AS "time(MM-YYYY)",
               mp."interest_name",
               sub."max_composition" AS "composition_value"
        FROM (
                SELECT "interest_id",
                       MAX("composition") AS "max_composition"
                FROM "interest_metrics"
                GROUP BY "interest_id"
             ) AS mx
        JOIN "interest_metrics" AS sub
          ON sub."interest_id" = mx."interest_id"
         AND sub."composition"  = mx."max_composition"
        JOIN "interest_map"     AS mp
          ON mp."id" = sub."interest_id"
        ORDER BY sub."max_composition" ASC
        LIMIT 10
     );
```
