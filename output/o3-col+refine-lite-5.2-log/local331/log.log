```sql
-- 4. Retrieve time‑ordered page views for one sample session
SELECT session,
       stamp,
       path
FROM activity_log
WHERE session = '989004ea'            -- (example session)
  AND action = 'view'
ORDER BY stamp 
LIMIT 20;
```

```sql
-- 5. For every view record, attach the two immediately previous paths (within the same session)
SELECT session,
       stamp,
       path                              AS current_path,
       LAG(path,1) OVER (PARTITION BY session ORDER BY stamp) AS prev1_path,
       LAG(path,2) OVER (PARTITION BY session ORDER BY stamp) AS prev2_path
FROM activity_log
WHERE action = 'view'
LIMIT 20;
```

```sql
-- 6. Keep only rows whose two previous paths are both '/detail' pages
SELECT session,
       stamp,
       path AS third_path
FROM (
        SELECT session,
               stamp,
               path,
               LAG(path,1) OVER (PARTITION BY session ORDER BY stamp) AS prev1_path,
               LAG(path,2) OVER (PARTITION BY session ORDER BY stamp) AS prev2_path
        FROM activity_log
        WHERE action = 'view'
     )
WHERE prev1_path LIKE '%/detail%' 
  AND prev2_path LIKE '%/detail%'
LIMIT 20;
```

```sql
-- 7. Count how many times every distinct third‑page visit follows two consecutive '/detail' views
SELECT third_path,
       COUNT(*) AS freq
FROM (
        SELECT session,
               path AS third_path
        FROM (
                SELECT session,
                       stamp,
                       path,
                       LAG(path,1) OVER (PARTITION BY session ORDER BY stamp) AS prev1_path,
                       LAG(path,2) OVER (PARTITION BY session ORDER BY stamp) AS prev2_path
                FROM activity_log
                WHERE action = 'view'
             )
        WHERE prev1_path LIKE '%/detail%' 
          AND prev2_path LIKE '%/detail%'
     )
GROUP BY third_path
ORDER BY freq DESC;
```

```sql
-- 8. Final answer: the three most frequent third‑page visits and their counts
SELECT third_path,
       COUNT(*) AS freq
FROM (
        SELECT session,
               path AS third_path
        FROM (
                SELECT session,
                       stamp,
                       path,
                       LAG(path,1) OVER (PARTITION BY session ORDER BY stamp) AS prev1_path,
                       LAG(path,2) OVER (PARTITION BY session ORDER BY stamp) AS prev2_path
                FROM activity_log
                WHERE action = 'view'
             )
        WHERE prev1_path LIKE '%/detail%' 
          AND prev2_path LIKE '%/detail%'
     )
GROUP BY third_path
ORDER BY freq DESC
LIMIT 3;
```
