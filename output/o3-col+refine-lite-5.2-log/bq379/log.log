```sql
--Description: 
--Find the HGNC‑approved gene symbol whose overall‑direct association score with psoriasis
--is closest to the mean overall‑direct score for psoriasis.
--Steps (embedded as CTEs):
-- 1. Get the ontology ID for the disease name “psoriasis”.
-- 2. Calculate the mean overall‑direct association score for that disease.
-- 3. Select the target whose score is nearest to that mean.
-- 4. Translate the target ID into its approved gene symbol and return the result.
WITH
  -- Step‑1: psoriasis ontology identifier
  psoriasis AS (
    SELECT id
    FROM   `region-us`.`open-targets-prod`.`platform`.`diseases`
    WHERE  LOWER(name) = 'psoriasis'
    LIMIT  1
  ),

  -- Step‑2: mean overall‑direct score for psoriasis
  mean_tbl AS (
    SELECT AVG(score) AS mean_score
    FROM   `region-us`.`open-targets-prod`.`platform`.`associationByOverallDirect`
    WHERE  diseaseId = (SELECT id FROM psoriasis)
  ),

  -- Step‑3: target whose score is closest to the mean
  closest AS (
    SELECT
      targetId,
      score,
      ABS(score - (SELECT mean_score FROM mean_tbl)) AS diff_to_mean
    FROM   `region-us`.`open-targets-prod`.`platform`.`associationByOverallDirect`
    WHERE  diseaseId = (SELECT id FROM psoriasis)
    ORDER BY diff_to_mean
    LIMIT  1
  )

-- Step‑4: final output – approved gene symbol, its score, and the mean score
SELECT
  t.approvedSymbol              AS target_approved_symbol,
  c.score                       AS target_score,
  m.mean_score                  AS mean_psoriasis_score
FROM      closest c
JOIN      `region-us`.`open-targets-prod`.`platform`.`targets` t
       ON t.id = c.targetId
CROSS JOIN mean_tbl m;
```
