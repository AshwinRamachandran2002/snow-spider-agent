```sql
--Description: 
--Find the HGNC‑approved gene symbol whose overall‑direct association score for psoriasis
--is nearest to the mean overall‑direct score for psoriasis.
WITH
  -- 1. Retrieve the ontology ID for the disease name exactly matching “psoriasis”.
  disease AS (
    SELECT id
    FROM   `region-us`.`open-targets-prod`.`platform`.`diseases`
    WHERE  LOWER(name) = 'psoriasis'
    LIMIT  1
  ),

  -- 2. Calculate the mean overall‑direct association score for psoriasis.
  mean_score AS (
    SELECT AVG(score) AS ms
    FROM   `region-us`.`open-targets-prod`.`platform`.`associationByOverallDirect`
    WHERE  diseaseId = (SELECT id FROM disease)
  ),

  -- 3. Pick the target whose score is closest to that mean.
  ranked_targets AS (
    SELECT
      targetId,
      score,
      ABS(score - (SELECT ms FROM mean_score)) AS diff
    FROM   `region-us`.`open-targets-prod`.`platform`.`associationByOverallDirect`
    WHERE  diseaseId = (SELECT id FROM disease)
    ORDER BY diff
    LIMIT  1
  )

-- 4. Return the approved gene symbol together with its score and the mean score.
SELECT
  t.approvedSymbol     AS target_approved_symbol,
  r.score              AS target_score,
  m.ms                 AS mean_psoriasis_score
FROM ranked_targets r
JOIN `region-us`.`open-targets-prod`.`platform`.`targets` t
  ON t.id = r.targetId
CROSS JOIN mean_score m;
```
