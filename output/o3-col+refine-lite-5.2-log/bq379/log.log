WHERE `diseaseId` = 'EFO_0000676';
```

```sql
--Description: 6) 20 targets whose overall‑direct scores are closest to the mean (direct)
WITH mean_tbl AS (
  SELECT AVG(`score`) AS mean_score
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE `diseaseId` = 'EFO_0000676'
)
SELECT `targetId`,
       `score`,
       ABS(`score` - mean_tbl.mean_score) AS diff_to_mean
FROM `open-targets-prod.platform.associationByOverallDirect`, mean_tbl
WHERE `diseaseId` = 'EFO_0000676'
ORDER BY diff_to_mean
LIMIT 20;
```

```sql
--Description: 7) Target whose overall‑direct score is *closest* to the mean (direct)
WITH mean_tbl AS (
  SELECT AVG(`score`) AS mean_score
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE `diseaseId` = 'EFO_0000676'
)
SELECT `targetId`,
       `score`
FROM `open-targets-prod.platform.associationByOverallDirect`, mean_tbl
WHERE `diseaseId` = 'EFO_0000676'
ORDER BY ABS(`score` - mean_tbl.mean_score)
LIMIT 1;
```

```sql
--Description: 8) Get the approved symbol of that closest‑to‑mean target (direct)
WITH mean_tbl AS (
  SELECT AVG(`score`) AS mean_score
  FROM `open-targets-prod.platform.associationByOverallDirect`
  WHERE `diseaseId` = 'EFO_0000676'
), closest AS (
  SELECT `targetId`, `score`
  FROM `open-targets-prod.platform.associationByOverallDirect`, mean_tbl
  WHERE `diseaseId` = 'EFO_0000676'
  ORDER BY ABS(`score` - mean_tbl.mean_score)
  LIMIT 1
)
SELECT t.`approvedSymbol`, c.`score`
FROM closest c
JOIN `open-targets-prod.platform.targets` t
  ON t.`id` = c.`targetId`;
```

