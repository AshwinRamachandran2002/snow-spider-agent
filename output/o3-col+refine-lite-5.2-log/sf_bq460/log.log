Query:
--Description: 6) Join the token list of the target article with WORD_FREQUENCIES to get each token’s corpus frequency
WITH tokens AS (
  SELECT TRIM(tok.value)::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z]+', ' '),
                   ' ')
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    AND tok.value <> ''
)
SELECT 
  t."word",
  wf."frequency"
FROM tokens t
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON wf."word" = t."word"
LIMIT 20
Answer:
word,frequency
table,5532
table,5532
supplementary,1514
supplementary,1514
supplementary,1514
1,151474
1,151474
information,10431
Query:
--Description: 8) Demonstrate weighting the first element of each token’s GloVe vector by 1 / frequency^0.4 for the target article
WITH tokens AS (
  SELECT DISTINCT TRIM(tok.value)::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z]+', ' '),
                   ' ')
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    AND tok.value <> ''
)
SELECT
  t."word",
  gv."vector"[0]::FLOAT                               AS "vec_0_original",
  wf."frequency",
  gv."vector"[0]::FLOAT / POWER(wf."frequency", 0.4)  AS "vec_0_weighted"
FROM tokens t
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON gv."word" = t."word"
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON wf."word" = t."word"
LIMIT 20
