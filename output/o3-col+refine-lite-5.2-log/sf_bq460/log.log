```sql
--Description: 9) Count distinct tokens in the target article that do NOT have a GloVe vector
WITH tokens AS (
  SELECT DISTINCT TRIM(tok.value)::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z]+', ' '),
                   ' ')
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    AND tok.value <> ''
)
SELECT 
  COUNT(*) AS "missing_vector_count"
FROM tokens t
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
       ON gv."word" = t."word"
WHERE gv."word" IS NULL;
```

```sql
--Description: 10) Tokenise ALL Nature articles, explode every body into tokens and list the 20 most frequent tokens overall
WITH tokens AS (
  SELECT TRIM(tok.value)::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z]+', ' '),
                   ' ')
       ) tok
  WHERE tok.value <> ''
)
SELECT 
  "word",
  COUNT(*) AS "article_occurrences"
FROM tokens
GROUP BY "word"
ORDER BY "article_occurrences" DESC
LIMIT 20;
```
