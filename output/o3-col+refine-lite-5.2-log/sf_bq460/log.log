--Description: 8) Demonstrate weighting the first element of each token’s GloVe vector by 1 / frequency^0.4 for the target article
WITH tokens AS (
  SELECT DISTINCT TRIM(tok.value)::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z]+', ' '),
