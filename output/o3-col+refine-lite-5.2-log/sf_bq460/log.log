```sql
--Description: 6) Join the token list of the target article with WORD_FREQUENCIES to get each token’s corpus frequency
WITH tokens AS (
  SELECT TRIM(tok.value)::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z]+', ' '),
                   ' ')
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    AND tok.value <> ''
)
SELECT 
  t."word",
  wf."frequency"
FROM tokens t
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON wf."word" = t."word"
LIMIT 20;
```

```sql
--Description: 7) Fetch each token’s GloVe vector (first coordinate shown) together with its frequency
WITH tokens AS (
  SELECT TRIM(tok.value)::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z]+', ' '),
                   ' ')
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    AND tok.value <> ''
)
SELECT 
  t."word",
  gv."vector":0::FLOAT AS "vec_first_val",
  wf."frequency"
FROM tokens t
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON gv."word" = t."word"
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON wf."word" = t."word"
LIMIT 20;
```

```sql
--Description: 8) Demonstrate weighting the first element of each token’s vector by 1 / frequency^0.4
WITH tokens AS (
  SELECT TRIM(tok.value)::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z]+', ' '),
                   ' ')
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    AND tok.value <> ''
)
SELECT 
  t."word",
  gv."vector":0::FLOAT                             AS "vec_0_original",
  wf."frequency",
  (gv."vector":0::FLOAT / POWER(wf."frequency", 0.4)) AS "vec_0_weighted"
FROM tokens t
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON gv."word" = t."word"
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON wf."word" = t."word"
LIMIT 20;
```

```sql
--Description: 9) Count how many tokens in the target article are missing a GloVe vector
WITH tokens AS (
  SELECT TRIM(tok.value)::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z]+', ' '),
                   ' ')
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    AND tok.value <> ''
)
SELECT 
  COUNT(*) AS "missing_vector_count"
FROM tokens t
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON gv."word" = t."word"
WHERE gv."word" IS NULL;
```

```sql
--Description: 10) Tokenise ALL Nature articles, explode, and list the 20 most frequent tokens overall
WITH tokens AS (
  SELECT TRIM(tok.value)::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z]+', ' '),
                   ' ')
       ) tok
  WHERE tok.value <> ''
)
SELECT 
  "word",
  COUNT(*) AS "article_occurrences"
FROM tokens
GROUP BY "word"
ORDER BY "article_occurrences" DESC
LIMIT 20;
```
