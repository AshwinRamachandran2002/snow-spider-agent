```sql
--Description: Extract every distinct token from the target article, join to its corpus
--frequency and pull the first coordinate (index 0) of its GloVe vector.  The VARIANT
--array in "vector" is accessed with bracket notation [0].  Show 20 sample rows.
WITH tokens AS (
  SELECT DISTINCT TRIM(tok.value)::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z]+', ' '),
                   ' ')
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    AND tok.value <> ''
)
SELECT
  t."word",
  gv."vector"[0]::FLOAT AS "vec_first_val",
  wf."frequency"
FROM tokens t
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
       ON gv."word" = t."word"
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
       ON wf."word" = t."word"
LIMIT 20;
```
