  LEFT("body", 300) AS "body_first_300_chars"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "id" ILIKE '%8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373%'
LIMIT 20;
```

```sql
--Description: 4) Tokenise the body text of the target article (stop‑words removed)
SELECT 
  "id",
  `spider2-public-data`.word_vectors_us.tokenise_no_stop("body")     AS "tokens_no_stop"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT 20;
```

```sql
--Description: 5) Explode those tokens into one word per row (for the target article only)
SELECT 
  n."id",
  tok.value::STRING                                                   AS "word"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE      n,
     LATERAL FLATTEN(
         INPUT => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")
     ) tok
WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT 20;
```

```sql
--Description: 6) Join the exploded token list of the target article with word_frequencies to obtain each token’s corpus frequency
SELECT 
  t."word",
  wf."frequency"
FROM (
  SELECT tok.value::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
) t
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON wf."word" = t."word"
LIMIT 20;
```

```sql
--Description: 7) Add a join to glove_vectors to fetch each token’s pre‑trained vector (showing first element of the vector)
SELECT 
  t."word",
  gv."vector":0::FLOAT   AS "vec_first_val",
  wf."frequency"
FROM (
  SELECT tok.value::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
) t
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON gv."word" = t."word"
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON wf."word" = t."word"
LIMIT 20;
```

```sql
--Description: 8) Demonstrate weighting the glove vector by dividing by the 0.4‑th power of word frequency (first element only)
SELECT 
  t."word",
  gv."vector":0::FLOAT                                       AS "vec_0_original",
  wf."frequency",
  (gv."vector":0::FLOAT / POWER(wf."frequency", 0.4))        AS "vec_0_weighted"
FROM (
  SELECT tok.value::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
) t
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON gv."word" = t."word"
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON wf."word" = t."word"
LIMIT 20;
```

```sql
--Description: 9) Count how many tokens in the target article have missing vectors (no match in glove_vectors)
SELECT 
  COUNT(*) AS "missing_vector_count"
FROM (
  SELECT tok.value::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
) t
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON gv."word" = t."word"
WHERE gv."word" IS NULL
LIMIT 20;
```

```sql
--Description: 10) (Broader) Tokenise ALL Nature articles, explode, and list the 20 most frequent tokens overall
WITH tokens AS (
  SELECT tok.value::STRING AS "word"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")
       ) tok
)
SELECT 
  "word",
  COUNT(*) AS "article_occurrences"
FROM tokens
GROUP BY "word"
ORDER BY "article_occurrences" DESC
LIMIT 20;
```
