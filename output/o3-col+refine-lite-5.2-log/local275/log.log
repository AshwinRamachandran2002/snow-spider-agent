Query:
--Description: For every product/month, compute a 13‑month centred moving average (6 months before & 6 after)  
WITH ts AS (
  SELECT product_id,
         mth,
         qty,
         AVG(qty) OVER (
             PARTITION BY product_id
             ORDER BY mth
             ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
         ) AS cma_13
  FROM monthly_sales
)
SELECT *
FROM ts
ORDER BY product_id, mth
LIMIT 20;
