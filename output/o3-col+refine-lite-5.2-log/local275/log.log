```sql
--Description: For every product/month, compute a 13‑month centred moving average (6 months before & 6 after)  
WITH ts AS (
  SELECT product_id,
         mth,
         qty,
         AVG(qty) OVER (
             PARTITION BY product_id
             ORDER BY mth
             ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
         ) AS cma_13
  FROM monthly_sales
)
SELECT *
FROM ts
ORDER BY product_id, mth
LIMIT 20;
```

```sql
--Description: Calculate the seasonality‑adjusted ratio (qty ÷ centred moving average) for 2017 (sample)  
WITH ts AS (
  SELECT product_id,
         mth,
         qty,
         AVG(qty) OVER (
             PARTITION BY product_id
             ORDER BY mth
             ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
         ) AS cma_13
  FROM monthly_sales
),
ratios AS (
  SELECT product_id,
         mth,
         qty,
         cma_13,
         CASE WHEN cma_13 IS NOT NULL AND cma_13 <> 0
              THEN qty * 1.0 / cma_13
         END AS ratio
  FROM ts
)
SELECT *
FROM ratios
WHERE mth BETWEEN '2017-01-01' AND '2017-12-31'
ORDER BY product_id, mth
LIMIT 20;
```

```sql
--Description: Identify products whose ratio stayed above 2 for every month in 2017  
WITH ts AS (
  SELECT product_id,
         mth,
         qty,
         AVG(qty) OVER (
             PARTITION BY product_id
             ORDER BY mth
             ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
         ) AS cma_13
  FROM monthly_sales
),
ratios AS (
  SELECT product_id,
         mth,
         qty,
         cma_13,
         qty * 1.0 / cma_13 AS ratio
  FROM ts
  WHERE mth BETWEEN '2017-01-01' AND '2017-12-31'
),
flags AS (
  SELECT product_id,
         MIN(ratio)  AS min_ratio_2017,
         COUNT(*)    AS months_2017
  FROM ratios
  GROUP BY product_id
)
SELECT product_id
FROM flags
WHERE min_ratio_2017 > 2
  AND months_2017 = 12
ORDER BY product_id;
```

```sql
--Description: Final list with product names whose 2017 ratio > 2 every month  
WITH ts AS (
  SELECT product_id,
         mth,
         qty,
         AVG(qty) OVER (
             PARTITION BY product_id
             ORDER BY mth
             ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
         ) AS cma_13
  FROM monthly_sales
),
ratios AS (
  SELECT product_id,
         mth,
         qty,
         cma_13,
         qty * 1.0 / cma_13 AS ratio
  FROM ts
  WHERE mth BETWEEN '2017-01-01' AND '2017-12-31'
),
flags AS (
  SELECT product_id,
         MIN(ratio)  AS min_ratio_2017,
         COUNT(*)    AS months_2017
  FROM ratios
  GROUP BY product_id
),
good_products AS (
  SELECT product_id
  FROM flags
  WHERE min_ratio_2017 > 2
    AND months_2017 = 12
)
SELECT gp.product_id,
       p.name
FROM good_products AS gp
JOIN products AS p
  ON p.id = gp.product_id
ORDER BY gp.product_id;
```
