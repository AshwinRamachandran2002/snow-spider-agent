--Description:  Revised “final list” query – compute each product’s 13‑month centred moving average, derive the 2017 seasonality‑adjusted ratios, 
--              summarise how many months of 2017 data exist and the minimum ratio reached, then return the products whose lowest 2017 ratio is still > 2
WITH ts AS (                                   -- monthly qty + 13‑month centred moving average
    SELECT  product_id,
            mth,
            qty,
            AVG(qty) OVER (
                PARTITION BY product_id
                ORDER BY mth
                ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
            ) AS cma
    FROM    monthly_sales
),
ratios AS (                                    -- seasonality‑adjusted ratio for 2017 months
    SELECT  product_id,
            mth,
            qty,
            cma,
            CASE WHEN cma>0 THEN qty*1.0/cma END AS ratio
    FROM    ts
    WHERE   mth BETWEEN '2017-01-01' AND '2017-12-31'
),
flags AS (                                     -- summary per product
    SELECT  product_id,
            COUNT(*)                AS months_2017,
            MIN(ratio)              AS min_ratio_2017
    FROM    ratios
    GROUP BY product_id
)
SELECT  f.product_id,
        p.name,
        f.months_2017,
        ROUND(f.min_ratio_2017,3) AS min_ratio_2017
FROM    flags AS f
JOIN    products AS p
