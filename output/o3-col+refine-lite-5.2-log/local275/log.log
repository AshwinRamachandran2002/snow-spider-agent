```sql
--Description:  For each product compute its seasonality‑adjusted ratio (qty ÷ 13‑month centred moving average) for every 2017 month, then report
--              1) how many 2017 months had data, and 2) the minimum of those ratios.  
--              This lets us see whether any product actually maintained a ratio strictly above 2 for the whole year
--              (if such a product exists its min_ratio_2017 would exceed 2 and months_2017 would be 12).
WITH ts AS (                                    -- original series plus 13‑month CMA
    SELECT  product_id,
            mth,
            qty,
            AVG(qty) OVER (
                PARTITION BY product_id
                ORDER BY mth
                ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
            ) AS cma
    FROM    monthly_sales
),
ratios AS (                                     -- seasonality‑adjusted ratio for 2017
    SELECT  product_id,
            mth,
            qty,
            cma,
            CASE WHEN cma>0 THEN qty*1.0/cma END AS ratio
    FROM    ts
    WHERE   mth BETWEEN '2017-01-01' AND '2017-12-31'
),
agg AS (                                        -- summary per product
    SELECT  product_id,
            COUNT(*)                AS months_2017,
            MIN(ratio)              AS min_ratio_2017
    FROM    ratios
    GROUP BY product_id
)
SELECT  a.product_id,
        p.name,
        a.months_2017,
        ROUND(a.min_ratio_2017,3) AS min_ratio_2017
FROM    agg AS a
JOIN    products AS p
  ON    p.id = a.product_id
ORDER BY a.min_ratio_2017 DESC;
```
