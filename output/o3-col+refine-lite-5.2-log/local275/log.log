Query:
--Description: Calculate the seasonality‑adjusted ratio (qty ÷ centred moving average) for 2017 (sample)  
WITH ts AS (
  SELECT product_id,
         mth,
         qty,
         AVG(qty) OVER (
             PARTITION BY product_id
             ORDER BY mth
             ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
         ) AS cma_13
  FROM monthly_sales
),
ratios AS (
  SELECT product_id,
         mth,
         qty,
         cma_13,
         CASE WHEN cma_13 IS NOT NULL AND cma_13 <> 0
              THEN qty * 1.0 / cma_13
         END AS ratio
  FROM ts
)
SELECT *
FROM ratios
WHERE mth BETWEEN '2017-01-01' AND '2017-12-31'
ORDER BY product_id, mth
LIMIT 20;
