```sql
WITH ts AS (          -- 1. 13‑month centred moving average
    SELECT  product_id,
            mth,
            qty,
            AVG(qty) OVER (PARTITION BY product_id
                           ORDER BY mth
                           ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING) AS cma_13
    FROM    monthly_sales
),
ratios AS (            -- 2. seasonality‑adjusted ratio
    SELECT  product_id,
            mth,
            qty,
            cma_13,
            qty * 1.0 / cma_13 AS ratio
    FROM    ts
    WHERE   cma_13 IS NOT NULL
      AND   cma_13 <> 0
),
r2017 AS (             -- 3. keep only the year 2017
    SELECT *
    FROM   ratios
    WHERE  mth BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT  p.id   AS product_id,
        p.name
FROM    products AS p
JOIN   (SELECT product_id
        FROM   r2017
        GROUP  BY product_id
        HAVING COUNT(*) = 12            -- all 12 months present
           AND MIN(ratio)  > 2          -- every month above 2
       ) AS ok
  ON   ok.product_id = p.id
ORDER BY p.id;
```
