--Description:  Compute each product’s 13‑month centred moving average (CMA), derive the 2017 seasonality‑adjusted
--              ratios (qty ÷ CMA), then keep only the products whose worst 2017 month was still at least
--              80 % of their CMA (min_ratio_2017 > 0.8).  This demonstrates the full calculation flow and
--              shows which products remained closest to or above their smoothed trend throughout 2017.
WITH ts AS (                               -- step 1: quantities + 13‑month CMA
    SELECT  product_id,
            mth,
            qty,
            AVG(qty) OVER (
                PARTITION BY product_id
                ORDER BY mth
                ROWS BETWEEN 6 PRECEDING AND 6 FOLLOWING
            ) AS cma
    FROM    monthly_sales
),
ratios AS (                                -- step 2: seasonality‑adjusted ratio for 2017 months
    SELECT  product_id,
            mth,
            qty,
            cma,
            CASE WHEN cma > 0 THEN qty * 1.0 / cma END AS ratio
    FROM    ts
    WHERE   mth BETWEEN '2017-01-01' AND '2017-12-31'
),
summary AS (                               -- step 3: worst ratio + count of months per product
    SELECT  product_id,
            COUNT(*)   AS months_2017,
            MIN(ratio) AS min_ratio_2017
    FROM    ratios
    GROUP BY product_id
)
SELECT  s.product_id,
        p.name,
        s.months_2017,
        ROUND(s.min_ratio_2017,3) AS min_ratio_2017
FROM    summary AS s
JOIN    products AS p ON p.id = s.product_id
WHERE   s.min_ratio_2017 > 0.8              -- kept if worst month ≥ 80 % of CMA
ORDER BY s.min_ratio_2017 DESC;
