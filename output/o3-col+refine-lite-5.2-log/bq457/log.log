--Description: 1)  Inspect which of the known Feature‑Toggle project names
--               actually appear in repository manifests / lockfiles.
SELECT DISTINCT `dependency_project_name`
FROM   `bigquery-public-data.libraries_io.repository_dependencies`
WHERE  LOWER(`dependency_project_name`) IN (
          'unleash-client', 'unleash-client-go', 'unleash-client-node',
          'unleash', 'launchdarkly', 'ldclient-js', 'ldclient-node',
