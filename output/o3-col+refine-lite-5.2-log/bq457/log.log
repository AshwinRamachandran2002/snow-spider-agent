```sql
--Description: 5) Join repository_dependencies with projects to obtain the
--               canonical library “artifact name”, platform and languages
--               of the feature‑toggle project being referenced.
SELECT  rd.`repository_name_with_owner`,
        rd.`host_type`,
        rd.`dependency_project_name`  AS artifact_name,
        p.`name`                      AS library_name,
        p.`platform`,
        p.`language`
FROM    `bigquery-public-data.libraries_io.repository_dependencies` AS rd
JOIN    `bigquery-public-data.libraries_io.projects`               AS p
  ON    p.`id` = rd.`dependency_project_id`
WHERE   LOWER(rd.`dependency_project_name`) IN (
            'unleash-client', 'unleash', 'launchdarkly',
            'ldclient-js', 'ldclient-node', 'ldclient-py',
            'ldclient-rb', 'togglz-core', 'ff4j-core',
            'flipit', 'flipper', 'flopflip', 'ember-feature-flags',
            'feature-toggles'
        )
LIMIT 20;
```

```sql
--Description: 6) Bring everything together: repository details PLUS the
--               attributes of the feature‑toggle library it depends on.
SELECT  r.`name_with_owner`,
        r.`host_type`,
        r.`size` * 1024                        AS size_bytes,
        r.`language`                           AS repo_language,
        r.`fork_source_name_with_owner`,
        r.`updated_timestamp`,
        p.`name`                               AS library_name,
        rd.`dependency_project_name`           AS artifact_name,
        p.`language`                           AS library_languages
FROM    `bigquery-public-data.libraries_io.repository_dependencies` AS rd
JOIN    `bigquery-public-data.libraries_io.repositories`           AS r
          ON r.`id` = rd.`repository_id`
JOIN    `bigquery-public-data.libraries_io.projects`               AS p
          ON p.`id` = rd.`dependency_project_id`
WHERE   LOWER(rd.`dependency_project_name`) IN (
            'unleash-client', 'unleash-client-go', 'unleash-client-node',
            'unleash', 'launchdarkly', 'ldclient-js', 'ldclient-node',
            'ldclient-py', 'ldclient-rb', 'togglz-core', 'ff4j-core',
            'nfeature', 'featuretoggle', 'featureswitcher', 'toggle',
            'flipit', 'flipper', 'flopflip', 'ember-feature-flags',
            'feature-toggles', 'gutter', 'django-waffle', 'gargoyle',
            'feature_ramp', 'bandiera-client'
        )
LIMIT 20;
```

```sql
--Description: 7) Verify that the dependency kinds include “runtime” or
