WHERE   t.`repository_name_with_owner` IN (
            SELECT DISTINCT `repository_name_with_owner`
            FROM   `bigquery-public-data.libraries_io.repository_dependencies`
            WHERE  LOWER(`dependency_project_name`) IN ('togglz-core','ff4j-core')
        )
GROUP  BY t.`repository_name_with_owner`
LIMIT 20;
```

```sql
--Description: 9) Explore which programming languages dominate among
--               repositories that consume any feature‑toggle library.
SELECT  r.`language`, COUNT(*) AS repo_count
FROM    `bigquery-public-data.libraries_io.repositories` r
WHERE   r.`name_with_owner` IN (
            SELECT DISTINCT `repository_name_with_owner`
            FROM `bigquery-public-data.libraries_io.repository_dependencies`
            WHERE LOWER(`dependency_project_name`) IN (
                'unleash-client', 'launchdarkly', 'flipit', 'flipper',
                'ff4j-core', 'togglz-core', 'gutter', 'django-waffle'
            )
        )
GROUP BY r.`language`
ORDER BY repo_count DESC
LIMIT 20;
```

