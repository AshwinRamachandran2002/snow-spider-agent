Query:
--Description: 5) Join repository_dependencies with projects to obtain the
--               canonical library “artifact name”, platform and languages
--               of the feature‑toggle project being referenced.
SELECT  rd.`repository_name_with_owner`,
        rd.`host_type`,
        rd.`dependency_project_name`  AS artifact_name,
        p.`name`                      AS library_name,
        p.`platform`,
        p.`language`
FROM    `bigquery-public-data.libraries_io.repository_dependencies` AS rd
JOIN    `bigquery-public-data.libraries_io.projects`               AS p
  ON    p.`id` = rd.`dependency_project_id`
WHERE   LOWER(rd.`dependency_project_name`) IN (
            'unleash-client', 'unleash', 'launchdarkly',
            'ldclient-js', 'ldclient-node', 'ldclient-py',
            'ldclient-rb', 'togglz-core', 'ff4j-core',
            'flipit', 'flipper', 'flopflip', 'ember-feature-flags',
            'feature-toggles'
        )
LIMIT 20;
Answer:
repository_name_with_owner,host_type,artifact_name,library_name,platform,language
orel91/launch-darkly-react-native,GitHub,LaunchDarkly,LaunchDarkly,CocoaPods,Objective-C
deconet/gitlabhq,GitHub,flipper,flipper,Rubygems,Ruby
comike011/liodemo,GitHub,flipper,flipper,Rubygems,Ruby
Query:
--Description: 7)  Verify that dependencies named *flipit*, *flipper* or
--                *flopflip* are marked as “runtime”, “compile” or
--                “production” in manifests.  Pattern‑matching with LIKE
--                (case‑insensitive) captures variations such as
--                “flipper-plugin”.  DISTINCT removes duplicates.
SELECT DISTINCT
       rd.repository_name_with_owner,
       rd.dependency_project_name,
       rd.dependency_kind
FROM   `bigquery-public-data.libraries_io.repository_dependencies` rd
WHERE ( LOWER(rd.dependency_project_name) LIKE '%flipit%'
     OR LOWER(rd.dependency_project_name) LIKE '%flipper%'
     OR LOWER(rd.dependency_project_name) LIKE '%flopflip%' )
  AND  LOWER(rd.dependency_kind) IN ('runtime', 'compile', 'production')
LIMIT 20
Answer:
repository_name_with_owner,dependency_project_name,dependency_kind
deconet/gitlabhq,flipper,runtime
ZinoxHD/Zinox.bot.co,imgflipper,runtime
camacho/flopflip,@flopflip/react,runtime
Superont/remade,imgflipper,runtime
AmitJoki/WikiEduDashboard,gulp-css-flipper,runtime
Query:
--Description: 10)  Produce a comprehensive list of repositories together
--                 with the feature‑toggle library they reference.
--                 Improvements vs. the previous version:
--                 • JOIN to `repositories` (r) on the textual key
--                   `name_with_owner` only (dropping `host_type`) so we
--                   still bring in metadata when host_type differs or the
--                   repository record is partially missing.
--                 • COALESCE the `host_type` column to fall back on the
--                   value from `repository_dependencies` when the repo
--                   record is absent.
--                 • LIKE filters capture LaunchDarkly, any ldclient*,
--                   Flipper, FeatureToggle(s), and Django‑Waffle variants.
--                 • Size converted from KB to bytes; DISTINCT removes
--                   duplicates.  LIMIT 20 yields a concise sample.
SELECT DISTINCT
       r.name_with_owner,
       COALESCE(r.host_type, rd.host_type)            AS host_type,
       r.size * 1024                                  AS size_bytes,
       r.language                                     AS repo_language,
       r.fork_source_name_with_owner,
       r.updated_timestamp,
       p.name                                         AS library_name,
       rd.dependency_project_name                     AS artifact_name,
       p.language                                     AS library_languages
FROM   `bigquery-public-data.libraries_io.repository_dependencies` rd
LEFT  JOIN `bigquery-public-data.libraries_io.repositories`        r
       ON  r.name_with_owner = rd.repository_name_with_owner
LEFT  JOIN `bigquery-public-data.libraries_io.projects`            p
       ON  p.id = rd.dependency_project_id
WHERE  LOWER(rd.dependency_project_name) LIKE '%launchdarkly%'
   OR  LOWER(rd.dependency_project_name) LIKE '%ldclient%'
   OR  LOWER(rd.dependency_project_name) LIKE '%flipper%'
   OR  LOWER(rd.dependency_project_name) LIKE '%featuretoggle%'
   OR  LOWER(rd.dependency_project_name) LIKE '%feature-toggles%'
   OR  LOWER(rd.dependency_project_name) LIKE '%django-waffle%'
LIMIT 20
Answer:
name_with_owner,host_type,size_bytes,repo_language,fork_source_name_with_owner,updated_timestamp,library_name,artifact_name,library_languages
,GitHub,,,,,flipper-redis,flipper-redis,Ruby
