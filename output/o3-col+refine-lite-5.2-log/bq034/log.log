```sql
--Description: Quick glance at the stations catalogue (location, name, state)
SELECT
  `id`,
  `name`,
  `latitude`,
  `longitude`,
  `state`
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
LIMIT 20;
```

```sql
--Description: See a few distinct US/CA state‑codes that appear in the stations file
SELECT DISTINCT
  `state`
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE `state` IS NOT NULL
ORDER BY `state`
LIMIT 20;
```

```sql
--Description: First 20 weather‑stations whose state flag is Illinois (IL)
SELECT
  `id`,
  `name`,
  `latitude`,
  `longitude`
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE `state` = 'IL'
LIMIT 20;
```

```sql
--Description: Stations inside a loose bounding‑box around Chicago (lat 41–42.5 N, lon −88.5 to −87 W)
SELECT
  `id`,
  `name`,
  `latitude`,
  `longitude`
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE `latitude` BETWEEN 41.0 AND 42.5
  AND `longitude` BETWEEN -88.5 AND -87.0
LIMIT 20;
```

```sql
--Description: Compute straight‑line distance (km) from Chicago centre for Illinois stations
SELECT
  `id`,
  `name`,
  `latitude`,
  `longitude`,
  ROUND(
    ST_DISTANCE(
      ST_GEOGPOINT(`longitude`, `latitude`),          -- station
      ST_GEOGPOINT(-87.6847, 41.8319)                 -- Chicago centre
    ) / 1000, 2) AS `distance_km`
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE `state` = 'IL'
ORDER BY `distance_km`
LIMIT 20;
```

```sql
--Description: Same distance calculation, but start with the Chicago bounding‑box filter
SELECT
  `id`,
  `name`,
  ROUND(
    ST_DISTANCE(
      ST_GEOGPOINT(`longitude`, `latitude`),
      ST_GEOGPOINT(-87.6847, 41.8319)
    ) / 1000, 2) AS `distance_km`
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE `latitude` BETWEEN 41.0 AND 42.5
  AND `longitude` BETWEEN -88.5 AND -87.0
ORDER BY `distance_km`
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – stations ≤ 50 km (≈ 50 000 m) from Chicago, ordered by proximity
SELECT
  `id`,
  `name`,
  ROUND(
    ST_DISTANCE(
      ST_GEOGPOINT(`longitude`, `latitude`),
      ST_GEOGPOINT(-87.6847, 41.8319)
    ) / 1000, 2) AS `distance_km`
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE ST_DISTANCE(
        ST_GEOGPOINT(`longitude`, `latitude`),
        ST_GEOGPOINT(-87.6847, 41.8319)
      ) <= 50000          -- 50 km in metres
ORDER BY `distance_km`
LIMIT 20;
```

```sql
--Description: How many stations in total fall within the 50 km radius?
SELECT
  COUNT(*) AS `station_count`
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE ST_DISTANCE(
        ST_GEOGPOINT(`longitude`, `latitude`),
        ST_GEOGPOINT(-87.6847, 41.8319)
      ) <= 50000;
```
