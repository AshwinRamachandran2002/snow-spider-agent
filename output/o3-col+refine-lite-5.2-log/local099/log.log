--Description:  (6) For every actor, determine the largest number of films made with any
--              director other than Yash Chopra; TRIM fixes whitespace in actor‑PID.
WITH other_dir_cnt AS (
        SELECT TRIM(c."PID") AS actor_pid,
               d."PID"       AS director_pid,
               COUNT(*)      AS collab_cnt
        FROM   "M_Cast"     AS c
        JOIN   "M_Director" AS d ON d."MID" = c."MID"
        WHERE  d."PID" <> 'nm0007181'                      -- exclude Yash Chopra
        GROUP BY TRIM(c."PID"), d."PID"
)
SELECT actor_pid                AS "Actor_PID",
       MAX(collab_cnt)          AS "max_other_cnt"
FROM   other_dir_cnt
GROUP BY actor_pid
LIMIT 20
