```sql
-- 1. Find Yash Chopra’s person‑id (PID)
SELECT DISTINCT "PID", TRIM("Name") AS "Name"
FROM "Person"
WHERE TRIM("Name") LIKE '%Yash Chopra%'
LIMIT 20;
```

```sql
-- 2. List (a sample of) movies directed by Yash Chopra
SELECT DISTINCT d."MID", m."title", m."year"
FROM "M_Director" AS d
JOIN "Movie"      AS m ON m."MID" = d."MID"
WHERE d."PID" IN (SELECT "PID" FROM "Person" WHERE TRIM("Name") LIKE '%Yash Chopra%')
LIMIT 20;
```

```sql
-- 3. Actors who appeared in those Yash Chopra movies
SELECT DISTINCT c."PID" AS "Actor_PID", TRIM(p."Name") AS "Actor_Name"
FROM "M_Cast"    AS c
JOIN "M_Director" AS d ON d."MID" = c."MID"
JOIN "Person"     AS p ON p."PID" = c."PID"
WHERE d."PID" IN (SELECT "PID" FROM "Person" WHERE TRIM("Name") LIKE '%Yash Chopra%')
LIMIT 20;
```

```sql
-- 4. Count of Yash Chopra‑directed films for every actor
SELECT c."PID"                    AS "Actor_PID",
       COUNT(*)                   AS "yash_cnt"
FROM   "M_Cast"    AS c
JOIN   "M_Director" AS d ON d."MID" = c."MID"
WHERE  d."PID" IN (SELECT "PID" FROM "Person" WHERE TRIM("Name") LIKE '%Yash Chopra%')
GROUP BY c."PID"
LIMIT 20;
```

```sql
-- 5. Actor‑to‑every‑director collaboration counts (sample rows)
SELECT c."PID"                    AS "Actor_PID",
       d."PID"                    AS "Director_PID",
       COUNT(*)                   AS "collab_cnt"
FROM   "M_Cast"    AS c
JOIN   "M_Director" AS d ON d."MID" = c."MID"
GROUP BY c."PID", d."PID"
LIMIT 20;
```

```sql
-- 6. For each actor, biggest collaboration count with directors OTHER than Yash Chopra
WITH yash AS (SELECT "PID" FROM "Person" WHERE TRIM("Name") LIKE '%Yash Chopra%')
SELECT ad."Actor_PID",
       MAX(ad."collab_cnt") AS "max_other_cnt"
FROM (
        SELECT c."PID" AS "Actor_PID",
               d."PID" AS "Director_PID",
               COUNT(*) AS "collab_cnt"
        FROM   "M_Cast"    AS c
        JOIN   "M_Director" AS d ON d."MID" = c."MID"
        GROUP BY c."PID", d."PID"
     ) AS ad,
     yash
WHERE ad."Director_PID" <> (SELECT "PID" FROM yash)
GROUP BY ad."Actor_PID"
LIMIT 20;
```

```sql
-- 7. Put the two pieces together: actors with MORE Yash films than with any other single director
WITH yash_pid AS (SELECT "PID" FROM "Person" WHERE TRIM("Name") LIKE '%Yash Chopra%'),

     yash_cnt AS (
         SELECT c."PID" AS "Actor_PID",
                COUNT(*) AS "yash_movies"
         FROM   "M_Cast"    AS c
         JOIN   "M_Director" AS d ON d."MID" = c."MID"
         WHERE  d."PID" = (SELECT "PID" FROM yash_pid)
         GROUP BY c."PID"
     ),

     other_max AS (
         SELECT ad."Actor_PID",
                MAX(ad."collab_cnt") AS "max_other_movies"
         FROM (
                 SELECT c."PID" AS "Actor_PID",
                        d."PID" AS "Director_PID",
                        COUNT(*) AS "collab_cnt"
                 FROM   "M_Cast"    AS c
                 JOIN   "M_Director" AS d ON d."MID" = c."MID"
                 GROUP BY c."PID", d."PID"
              ) AS ad
         WHERE ad."Director_PID" <> (SELECT "PID" FROM yash_pid)
         GROUP BY ad."Actor_PID"
     )

SELECT COUNT(*) AS "actors_preferring_Yash"
FROM   yash_cnt  AS y
LEFT JOIN other_max AS o ON o."Actor_PID" = y."Actor_PID"
WHERE  y."yash_movies" > IFNULL(o."max_other_movies", 0);
```

```sql
-- 8. (Optional) Show the actual list of those actors
SELECT TRIM(p."Name") AS "Actor_Name",
       y."yash_movies",
       IFNULL(o."max_other_movies", 0) AS "best_other"
FROM   yash_cnt  AS y
LEFT JOIN other_max AS o ON o."Actor_PID" = y."Actor_PID"
JOIN  "Person"   AS p ON p."PID" = y."Actor_PID"
WHERE  y."yash_movies" > IFNULL(o."max_other_movies", 0)
LIMIT 20;
```
