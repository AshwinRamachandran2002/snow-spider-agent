--Description:  Count actors whose collaboration count with Yash Chopra (PID = 'nm0007181')
--              is strictly greater than their collaboration count with every other
--              individual director.  We:
--              1) build yash_cnt  : films per actor with Yash Chopra
--              2) build other_max : highest film‑count an actor has with any *other* director
--                 (using TRIM to neutralise leading blanks in M_Cast.PID)
--              3) compare the two and return the number of actors where
--                 yash_cnt > other_max (NULL other_max treated as 0)
WITH yash_cnt AS (
        SELECT TRIM(c."PID") AS actor_pid,
               COUNT(*)      AS yash_movies
        FROM   "M_Cast"     c
        JOIN   "M_Director" d ON d."MID" = c."MID"
        WHERE  d."PID" = 'nm0007181'                         -- Yash Chopra
        GROUP BY TRIM(c."PID")
),
other_max AS (
        SELECT actor_pid,
               MAX(collab_cnt) AS max_other
        FROM (
                SELECT TRIM(c."PID") AS actor_pid,
                       d."PID"       AS other_dir,
                       COUNT(*)      AS collab_cnt
                FROM   "M_Cast"     c
                JOIN   "M_Director" d ON d."MID" = c."MID"
                WHERE  d."PID" <> 'nm0007181'
                GROUP BY TRIM(c."PID"), d."PID"
        )
        GROUP BY actor_pid
)
SELECT COUNT(*) AS actors_preferring_yash
FROM   yash_cnt y
LEFT JOIN other_max o ON o.actor_pid = y.actor_pid
WHERE  y.yash_movies > COALESCE(o.max_other, 0);
