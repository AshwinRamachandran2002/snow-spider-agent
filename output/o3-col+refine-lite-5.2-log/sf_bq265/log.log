Query:
-- Description: Aggregate total order value and order count per user for 2019
WITH order_vals AS (
    SELECT 
        o."order_id",
        o."user_id",
        o."num_of_item" * MAX(oi."sale_price") AS "order_value"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"      o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
         ON oi."order_id" = o."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
    GROUP BY o."order_id", o."user_id", o."num_of_item"
)
SELECT 
    "user_id",
    SUM("order_value")  AS "total_value",
    COUNT(*)            AS "total_orders"
FROM order_vals
GROUP BY "user_id"
LIMIT 20;
