LIMIT 20;
```

```sql
-- Description: Show a sample of order‑items that belong to 2019 orders
SELECT 
    DISTINCT oi."id"           AS "order_item_id",
    oi."order_id",
    oi."sale_price",
    oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
     ON o."order_id" = oi."order_id"
WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
LIMIT 20;
```

```sql
-- Description: Calculate a rough “order value” for each 2019 order
--              (num_of_item from ORDERS × max(sale_price) in ORDER_ITEMS)
SELECT 
    o."order_id",
    o."user_id",
    o."num_of_item" * MAX(oi."sale_price") AS "order_value"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"      o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
     ON oi."order_id" = o."order_id"
WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
GROUP BY o."order_id", o."user_id", o."num_of_item"
LIMIT 20;
```

```sql
-- Description: Aggregate total order value and order count per user for 2019
WITH order_vals AS (
    SELECT 
        o."order_id",
        o."user_id",
        o."num_of_item" * MAX(oi."sale_price") AS "order_value"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"      o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
         ON oi."order_id" = o."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
    GROUP BY o."order_id", o."user_id", o."num_of_item"
)
SELECT 
    "user_id",
    SUM("order_value")  AS "total_value",
    COUNT(*)            AS "total_orders"
FROM order_vals
GROUP BY "user_id"
LIMIT 20;
```

```sql
-- Description: Compute each user’s 2019 average order value
WITH order_vals AS (
    SELECT 
        o."order_id",
        o."user_id",
        o."num_of_item" * MAX(oi."sale_price") AS "order_value"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"      o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
         ON oi."order_id" = o."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
    GROUP BY o."order_id", o."user_id", o."num_of_item"
)
SELECT 
    "user_id",
    AVG("order_value") AS "avg_order_value"
FROM order_vals
GROUP BY "user_id"
LIMIT 20;
```

```sql
-- Description: Combine registration‑year 2019 users with their 2019 average order value
WITH reg19 AS (
    SELECT "id", "email"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
    WHERE "created_at" BETWEEN 1546300800000000 AND 1577836800000000
), order_vals AS (
    SELECT 
        o."order_id",
        o."user_id",
        o."num_of_item" * MAX(oi."sale_price") AS "order_value"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"      o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
         ON oi."order_id" = o."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
    GROUP BY o."order_id", o."user_id", o."num_of_item"
), user_avgs AS (
    SELECT 
        "user_id",
        AVG("order_value") AS "avg_order_value"
    FROM order_vals
    GROUP BY "user_id"
)
SELECT 
    r."email",
    u."avg_order_value"
FROM user_avgs               u
JOIN reg19                   r  ON r."id" = u."user_id"
LIMIT 20;
```

```sql
-- Description: Rank the 2019‑registered purchasers by their average order value
WITH reg19 AS (
    SELECT "id", "email"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
    WHERE "created_at" BETWEEN 1546300800000000 AND 1577836800000000
), order_vals AS (
    SELECT 
        o."order_id",
        o."user_id",
        o."num_of_item" * MAX(oi."sale_price") AS "order_value"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"      o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
         ON oi."order_id" = o."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
    GROUP BY o."order_id", o."user_id", o."num_of_item"
), user_avgs AS (
    SELECT 
        "user_id",
        AVG("order_value") AS "avg_order_value"
    FROM order_vals
    GROUP BY "user_id"
)
SELECT 
    r."email"
FROM user_avgs               u
JOIN reg19                   r  ON r."id" = u."user_id"
ORDER BY u."avg_order_value" DESC
LIMIT 20;
```

```sql
-- Description: Final query – top‑10 emails of 2019 registrants with highest 2019 average order value
WITH reg19 AS (
    SELECT "id", "email"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
    WHERE "created_at" BETWEEN 1546300800000000 AND 1577836800000000
), order_vals AS (
    SELECT 
        o."order_id",
        o."user_id",
        o."num_of_item" * MAX(oi."sale_price") AS "order_value"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"      o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
         ON oi."order_id" = o."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
    GROUP BY o."order_id", o."user_id", o."num_of_item"
), user_avgs AS (
    SELECT 
        "user_id",
        AVG("order_value") AS "avg_order_value"
    FROM order_vals
    GROUP BY "user_id"
)
SELECT DISTINCT
    r."email"
FROM user_avgs               u
JOIN reg19                   r  ON r."id" = u."user_id"
ORDER BY u."avg_order_value" DESC
LIMIT 10;
```
