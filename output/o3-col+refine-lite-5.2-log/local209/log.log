Query:
--Description: Count how many of those orders are recorded as DELIVERED in deliveries.
SELECT COUNT(*) AS "delivered_orders"
FROM   "orders"     AS o
JOIN   "deliveries" AS d
       ON d."delivery_order_id" = o."delivery_order_id"
WHERE  o."store_id" = (
        SELECT "store_id"
        FROM   "orders"
        GROUP  BY "store_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 1)
  AND  d."delivery_status" = 'DELIVERED';
