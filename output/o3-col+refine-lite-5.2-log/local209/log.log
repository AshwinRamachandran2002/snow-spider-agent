```sql
--Description: Check some store IDs and names that exist.
SELECT DISTINCT "store_id", "store_name"
FROM "stores"
LIMIT 20;
```

```sql
--Description: Glimpse at store IDs appearing in the orders table.
SELECT DISTINCT "store_id"
FROM "orders"
LIMIT 20;
```

```sql
--Description: Count how many orders each store has and list the busiest 20.
SELECT "store_id",
       COUNT(*) AS "total_orders"
FROM "orders"
GROUP BY "store_id"
ORDER BY "total_orders" DESC
LIMIT 20;
```

```sql
--Description: Add the store name to those top‑20 order counts.
SELECT o."store_id",
       s."store_name",
       COUNT(*) AS "total_orders"
FROM   "orders"  AS o
JOIN   "stores"  AS s ON s."store_id" = o."store_id"
GROUP  BY o."store_id"
ORDER  BY "total_orders" DESC
LIMIT 20;
```

```sql
--Description: Show a sample of order IDs that belong to the most‑ordered‑from store.
SELECT "order_id"
FROM   "orders"
WHERE  "store_id" = (
        SELECT "store_id"
        FROM   "orders"
        GROUP  BY "store_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 1)
LIMIT 20;
```

```sql
--Description: Count how many of those orders are recorded as DELIVERED in deliveries.
SELECT COUNT(*) AS "delivered_orders"
FROM   "orders"     AS o
JOIN   "deliveries" AS d
       ON d."delivery_order_id" = o."delivery_order_id"
WHERE  o."store_id" = (
        SELECT "store_id"
        FROM   "orders"
        GROUP  BY "store_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 1)
  AND  d."delivery_status" = 'DELIVERED';
```

```sql
--Description: Count total orders for that same busiest store.
SELECT COUNT(*) AS "total_orders"
FROM   "orders"
WHERE  "store_id" = (
        SELECT "store_id"
        FROM   "orders"
        GROUP  BY "store_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 1);
```

```sql
--Description: Get, in one step, the busiest store’s ID, name, delivered count, total count, and the ratio.
SELECT st."store_name",
       sub."total_orders",
       sub."delivered_orders",
       sub."delivered_orders" * 1.0 / sub."total_orders" AS "delivered_ratio"
FROM (
        SELECT o."store_id",
               COUNT(*)                                         AS "total_orders",
               SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 ELSE 0 END) AS "delivered_orders"
        FROM   "orders"     AS o
        LEFT  JOIN "deliveries" AS d
               ON d."delivery_order_id" = o."delivery_order_id"
        GROUP  BY o."store_id"
        ORDER  BY "total_orders" DESC
        LIMIT 1
     ) AS sub
JOIN "stores" AS st
     ON st."store_id" = sub."store_id";
```

```sql
--Description: (Optional) See the delivered ratio of the 10 busiest stores for comparison.
SELECT st."store_name",
       sub."total_orders",
       sub."delivered_orders",
       sub."delivered_orders" * 1.0 / sub."total_orders" AS "delivered_ratio"
FROM (
        SELECT o."store_id",
               COUNT(*)                                         AS "total_orders",
               SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 ELSE 0 END) AS "delivered_orders"
        FROM   "orders"     AS o
        LEFT  JOIN "deliveries" AS d
               ON d."delivery_order_id" = o."delivery_order_id"
        GROUP  BY o."store_id"
        ORDER  BY "total_orders" DESC
        LIMIT 10
     ) AS sub
JOIN "stores" AS st
     ON st."store_id" = sub."store_id";
```

```sql
--Description: (Optional) Show every order of the busiest store alongside its delivery status to audit the numbers.
SELECT o."order_id",
       d."delivery_status"
FROM   "orders"     AS o
LEFT  JOIN "deliveries" AS d
       ON d."delivery_order_id" = o."delivery_order_id"
WHERE  o."store_id" = (
        SELECT "store_id"
        FROM   "orders"
        GROUP  BY "store_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 1)
LIMIT 20;
```
