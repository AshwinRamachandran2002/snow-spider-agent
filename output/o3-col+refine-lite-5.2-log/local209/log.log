Query:
--Description: Add the store name to those top‑20 order counts.
SELECT o."store_id",
       s."store_name",
       COUNT(*) AS "total_orders"
FROM   "orders"  AS o
JOIN   "stores"  AS s ON s."store_id" = o."store_id"
GROUP  BY o."store_id"
ORDER  BY "total_orders" DESC
LIMIT 20;
