Query:
-- 4) Check how to compute rental hours (return‑date – rental‑date)
SELECT DISTINCT re."rental_id",
       ROUND( (julianday(re."return_date") - julianday(re."rental_date")) * 24 , 2) 
       AS "rental_hours"
FROM   "rental" AS re
WHERE  re."return_date" IS NOT NULL
LIMIT 20;
