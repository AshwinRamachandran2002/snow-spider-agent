Query:
-- 1) Identify city IDs whose names start with 'A' or contain a hyphen
SELECT DISTINCT "city_id",
       "city"
FROM   "city"
WHERE  "city" LIKE 'A%'
   OR  "city" LIKE '%-%'
LIMIT 20;
