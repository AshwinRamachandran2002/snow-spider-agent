```sql
-- 1) Identify city IDs whose names start with 'A' or contain a hyphen
SELECT DISTINCT "city_id",
       "city"
FROM   "city"
WHERE  "city" LIKE 'A%'
   OR  "city" LIKE '%-%'
LIMIT 20;
```

```sql
-- 2) Customers that live in those cities
SELECT DISTINCT cu."customer_id",
       ci."city"
FROM   "customer"  AS cu
JOIN   "address"   AS ad ON cu."address_id" = ad."address_id"
JOIN   "city"      AS ci ON ad."city_id"   = ci."city_id"
WHERE  ci."city" LIKE 'A%'
   OR  ci."city" LIKE '%-%'
LIMIT 20;
```

```sql
-- 3) Rentals (with dates) made by those customers
SELECT DISTINCT re."rental_id",
       re."customer_id",
       re."rental_date",
       re."return_date"
FROM   "rental"  AS re
WHERE  re."customer_id" IN (
       SELECT cu."customer_id"
       FROM   "customer"  AS cu
       JOIN   "address"   AS ad ON cu."address_id" = ad."address_id"
       JOIN   "city"      AS ci ON ad."city_id"   = ci."city_id"
       WHERE  ci."city" LIKE 'A%'
          OR  ci."city" LIKE '%-%')
LIMIT 20;
```

```sql
-- 4) Check how to compute rental hours (return‑date – rental‑date)
SELECT DISTINCT re."rental_id",
       ROUND( (julianday(re."return_date") - julianday(re."rental_date")) * 24 , 2) 
       AS "rental_hours"
FROM   "rental" AS re
WHERE  re."return_date" IS NOT NULL
LIMIT 20;
```

```sql
-- 5) Link each rental to its film through inventory
SELECT DISTINCT re."rental_id",
       inv."film_id"
FROM   "rental"    AS re
JOIN   "inventory" AS inv ON re."inventory_id" = inv."inventory_id"
LIMIT 20;
```

```sql
-- 6) See how films map to categories
SELECT DISTINCT fc."film_id",
       ca."category_id",
       ca."name"  AS "category_name"
FROM   "film_category" AS fc
JOIN   "category"      AS ca ON fc."category_id" = ca."category_id"
LIMIT 20;
```

```sql
-- 7) Bring everything together (still limited) to check the join works
SELECT DISTINCT ca."name"                         AS "category_name",
       ROUND( (julianday(re."return_date") - julianday(re."rental_date")) * 24 , 2)
       AS "rental_hours"
FROM   "rental"       AS re
JOIN   "customer"     AS cu  ON re."customer_id"   = cu."customer_id"
JOIN   "address"      AS ad  ON cu."address_id"    = ad."address_id"
JOIN   "city"         AS ci  ON ad."city_id"       = ci."city_id"
JOIN   "inventory"    AS inv ON re."inventory_id"  = inv."inventory_id"
JOIN   "film_category"AS fc  ON inv."film_id"      = fc."film_id"
JOIN   "category"     AS ca  ON fc."category_id"   = ca."category_id"
WHERE  (ci."city" LIKE 'A%' OR ci."city" LIKE '%-%')
  AND  re."return_date" IS NOT NULL
LIMIT 20;
```

```sql
-- 8) Aggregate total rental hours per category for the target cities
SELECT ca."name"                                          AS "category_name",
       SUM( (julianday(re."return_date") - julianday(re."rental_date")) * 24 ) 
           AS "total_rental_hours"
FROM   "rental"        AS re
JOIN   "customer"      AS cu  ON re."customer_id"   = cu."customer_id"
JOIN   "address"       AS ad  ON cu."address_id"    = ad."address_id"
JOIN   "city"          AS ci  ON ad."city_id"       = ci."city_id"
JOIN   "inventory"     AS inv ON re."inventory_id"  = inv."inventory_id"
JOIN   "film_category" AS fc  ON inv."film_id"      = fc."film_id"
JOIN   "category"      AS ca  ON fc."category_id"   = ca."category_id"
WHERE  (ci."city" LIKE 'A%' OR ci."city" LIKE '%-%')
  AND  re."return_date" IS NOT NULL
GROUP  BY ca."name"
ORDER  BY "total_rental_hours" DESC
LIMIT 20;
```

```sql
-- 9) Final answer: the single film category with the highest total rental hours
SELECT ca."name"                                          AS "category_with_highest_rental_hours"
FROM   "rental"        AS re
JOIN   "customer"      AS cu  ON re."customer_id"   = cu."customer_id"
JOIN   "address"       AS ad  ON cu."address_id"    = ad."address_id"
JOIN   "city"          AS ci  ON ad."city_id"       = ci."city_id"
JOIN   "inventory"     AS inv ON re."inventory_id"  = inv."inventory_id"
JOIN   "film_category" AS fc  ON inv."film_id"      = fc."film_id"
JOIN   "category"      AS ca  ON fc."category_id"   = ca."category_id"
WHERE  (ci."city" LIKE 'A%' OR ci."city" LIKE '%-%')
  AND  re."return_date" IS NOT NULL
GROUP  BY ca."name"
ORDER  BY SUM( (julianday(re."return_date") - julianday(re."rental_date")) * 24 ) DESC
LIMIT 1;
```

