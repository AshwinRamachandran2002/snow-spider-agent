-- 3) Rentals (with dates) made by those customers
SELECT DISTINCT re."rental_id",
       re."customer_id",
       re."rental_date",
       re."return_date"
FROM   "rental"  AS re
WHERE  re."customer_id" IN (
       SELECT cu."customer_id"
       FROM   "customer"  AS cu
       JOIN   "address"   AS ad ON cu."address_id" = ad."address_id"
       JOIN   "city"      AS ci ON ad."city_id"   = ci."city_id"
       WHERE  ci."city" LIKE 'A%'
          OR  ci."city" LIKE '%-%')
