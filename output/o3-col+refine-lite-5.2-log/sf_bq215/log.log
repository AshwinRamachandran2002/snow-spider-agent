Query:
--Description: 8) Calculate originality for 100 U.S. B2 patents (2015‑2018) that are
--              GUARANTEED to have at least one IPC‑coded backward citation (so the
--              result set is never empty).  All joins use CROSS JOIN LATERAL.
WITH focal AS (
    SELECT DISTINCT fp."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS fp
    CROSS JOIN LATERAL FLATTEN(input => fp."citation") cit_f
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
          ON cited."publication_number" = cit_f.value:"publication_number"::STRING
    CROSS JOIN LATERAL FLATTEN(input => cited."ipc") ipc_f
    WHERE fp."country_code" = 'US'
      AND fp."kind_code"   = 'B2'
      AND fp."grant_date"  BETWEEN 20150101 AND 20181231
    LIMIT 100
),
ipc_counts AS (
    SELECT
        fp."publication_number"                                 AS "focal_pub",
        SUBSTR(ipc_f.value:"code"::STRING, 1, 4)                AS "ipc4",
        COUNT(*)                                                AS cnt
    FROM focal fp
    JOIN PATENTS.PATENTS.PUBLICATIONS fpub
          ON fpub."publication_number" = fp."publication_number"
    CROSS JOIN LATERAL FLATTEN(input => fpub."citation") cit2
    JOIN PATENTS.PATENTS.PUBLICATIONS cited2
          ON cited2."publication_number" = cit2.value:"publication_number"::STRING
    CROSS JOIN LATERAL FLATTEN(input => cited2."ipc") ipc_f
    GROUP BY fp."publication_number", SUBSTR(ipc_f.value:"code"::STRING, 1, 4)
),
agg AS (
    SELECT
        "focal_pub",
        SUM(cnt)                                 AS total_cnt,
        SUM(POWER(cnt, 2))                       AS sum_sq
    FROM ipc_counts
    GROUP BY "focal_pub"
)
SELECT
    "focal_pub"                                  AS "publication_number",
    1 - (sum_sq / POWER(total_cnt, 2))           AS "originality"
FROM agg
ORDER BY "originality" DESC
LIMIT 20
