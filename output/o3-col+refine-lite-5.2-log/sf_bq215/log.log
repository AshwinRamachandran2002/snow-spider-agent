```sql
--Description: 
-- Find the U.S. patent (kind‑code “B2”, granted 2015‑2018) with the highest
-- Trajtenberg originality score.  
-- Steps in one query:  
--   1) cited_pairs ‑‑ explode each focal patent’s “citation” array to list every
--      cited publication.  
--   2) ipc_counts  ‑‑ join each cited publication to its “ipc” array, count how
--      often each distinct 4‑digit IPC appears in the backward citations of
--      every focal patent.  
--   3) originality_calc ‑‑ aggregate total counts and squared counts per focal
--      patent.  
--   4) final SELECT ‑‑ compute originality = 1 − Σcnt² / (Σcnt)², order
--      descending, return the single highest‑scoring patent.  
WITH cited_pairs AS (
    SELECT
        fp."publication_number"                                  AS focal_pub,
        cit_f.value:"publication_number"::STRING                 AS cited_pub
    FROM PATENTS.PATENTS.PUBLICATIONS fp
    CROSS JOIN LATERAL FLATTEN(input => fp."citation") cit_f
    WHERE fp."country_code" = 'US'
      AND fp."kind_code"   = 'B2'
      AND fp."grant_date"  BETWEEN 20150101 AND 20181231
      AND cit_f.value:"publication_number" IS NOT NULL
),
ipc_counts AS (
    SELECT
        cp.focal_pub,
        SUBSTR(ipc_f.value:"code"::STRING, 1, 4)                 AS ipc4,
        COUNT(*)                                                 AS cnt
    FROM cited_pairs cp
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
          ON cited."publication_number" = cp.cited_pub
    CROSS JOIN LATERAL FLATTEN(input => cited."ipc") ipc_f
    GROUP BY cp.focal_pub, SUBSTR(ipc_f.value:"code"::STRING, 1, 4)
),
originality_calc AS (
    SELECT
        focal_pub,
        SUM(cnt)                                 AS total_cnt,
        SUM(POWER(cnt, 2))                       AS sum_sq
    FROM ipc_counts
    GROUP BY focal_pub
)
SELECT
    focal_pub                                     AS "publication_number",
    1 - (sum_sq / POWER(total_cnt, 2))            AS "originality"
FROM originality_calc
ORDER BY "originality" DESC
LIMIT 1;
```
