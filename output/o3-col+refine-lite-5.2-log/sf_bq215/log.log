```sql
--Description: 5) Combine one focal patent with all its cited patents and list their 4‑digit IPCs.
WITH focal AS (
    SELECT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'US'
      AND "kind_code"='B2'
      AND "grant_date" BETWEEN 20150101 AND 20181231
    LIMIT 1
)
SELECT 
    fp."publication_number"                                          AS "focal_pub",
    cp."publication_number"                                          AS "cited_pub",
    SUBSTR(i.value:"code"::STRING,1,4)                               AS "cited_ipc4"
FROM focal fp
JOIN PATENTS.PATENTS.PUBLICATIONS fpub
  ON fp."publication_number" = fpub."publication_number"
JOIN LATERAL FLATTEN(input => fpub."citation") c
  ON TRUE
JOIN PATENTS.PATENTS.PUBLICATIONS cp
  ON cp."publication_number" = c.value:"publication_number"::STRING
JOIN LATERAL FLATTEN(input => cp."ipc") i
  ON TRUE
LIMIT 20;
```

```sql
--Description: 6) Count occurrences of each distinct 4‑digit IPC in the backward citations of a sample patent.
WITH focal AS (
    SELECT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'US'
      AND "kind_code"='B2'
      AND "grant_date" BETWEEN 20150101 AND 20181231
    LIMIT 1
)
SELECT 
    SUBSTR(i.value:"code"::STRING,1,4)                               AS "ipc4",
    COUNT(*)                                                         AS "occurrences"
FROM focal fp
JOIN PATENTS.PATENTS.PUBLICATIONS fpub
  ON fp."publication_number" = fpub."publication_number"
JOIN LATERAL FLATTEN(input => fpub."citation") c
  ON TRUE
JOIN PATENTS.PATENTS.PUBLICATIONS cp
  ON cp."publication_number" = c.value:"publication_number"::STRING
JOIN LATERAL FLATTEN(input => cp."ipc") i
  ON TRUE
GROUP BY "ipc4"
LIMIT 20;
```

```sql
--Description: 7) Compute the originality score for that single sample patent.
WITH focal AS (
    SELECT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'US'
      AND "kind_code"='B2'
      AND "grant_date" BETWEEN 20150101 AND 20181231
    LIMIT 1
),
ipc_counts AS (
    SELECT 
        fp."publication_number"                                      AS "focal_pub",
        SUBSTR(i.value:"code"::STRING,1,4)                           AS "ipc4",
        COUNT(*)                                                     AS "cnt"
    FROM focal fp
    JOIN PATENTS.PATENTS.PUBLICATIONS fpub
      ON fp."publication_number" = fpub."publication_number"
    JOIN LATERAL FLATTEN(input => fpub."citation") c
      ON TRUE
    JOIN PATENTS.PATENTS.PUBLICATIONS cp
      ON cp."publication_number" = c.value:"publication_number"::STRING
    JOIN LATERAL FLATTEN(input => cp."ipc") i
      ON TRUE
    GROUP BY fp."publication_number", "ipc4"
),
agg AS (
    SELECT
        "focal_pub",
        SUM("cnt")                                       AS total_cnt,
        SUM(POWER("cnt",2))                              AS sum_sq
    FROM ipc_counts
    GROUP BY "focal_pub"
)
SELECT
    "focal_pub",
    1 - ("sum_sq" / POWER("total_cnt",2))               AS "originality"
FROM agg
LIMIT 20;
```

