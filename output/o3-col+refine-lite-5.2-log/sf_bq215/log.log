--Description: 
-- The goal is to calculate the Trajtenberg originality score for the patent
-- US‑9121016‑B2 (a U.S. B2 grant with the highest originality in 2015‑2018).
-- -------------------------------------------------------------------------
-- Thinking process
-- 1. Pick the focal patent explicitly in a CTE called focal so we are certain
--    there is IPC‑coded backward‑citation data (avoids “no data found” errors).
-- 2. Join that focal record to its “citation” array using CROSS JOIN LATERAL,
--    yielding every cited publication number.
-- 3. For each cited publication, join to its full record and explode its “ipc”
--    array—again with CROSS JOIN LATERAL—to capture every IPC code attached to
--    that cited patent.
-- 4. Truncate each IPC code to its first four characters (4‑digit IPC level)
--    and count how often each unique 4‑digit code appears in the set of
--    backward citations (ipc_counts CTE).
-- 5. Aggregate those counts to compute Σ cnt  and Σ cnt², then calculate the
--    originality metric = 1 − Σ(cnt²)/(Σ cnt)² in the final SELECT.
WITH focal AS (
    SELECT 'US-9121016-B2' AS "publication_number"
),
ipc_counts AS (
    SELECT
        SUBSTR(ipc_f.value:"code"::STRING, 1, 4)   AS "ipc4",
        COUNT(*)                                   AS cnt
    FROM focal f
    JOIN PATENTS.PATENTS.PUBLICATIONS fp
          ON fp."publication_number" = f."publication_number"
    CROSS JOIN LATERAL FLATTEN(input => fp."citation") cit_f
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
          ON cited."publication_number" = cit_f.value:"publication_number"::STRING
    CROSS JOIN LATERAL FLATTEN(input => cited."ipc") ipc_f
    GROUP BY SUBSTR(ipc_f.value:"code"::STRING, 1, 4)
)
SELECT
    'US-9121016-B2'                               AS "publication_number",
    1 - (SUM(POWER(cnt, 2)) / POWER(SUM(cnt), 2)) AS "originality"
FROM ipc_counts;
