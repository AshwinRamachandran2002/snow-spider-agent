--   difference from the overall average (numeric ID only).
WITH Weighted AS (
    SELECT mp."StyleID",
           SUM(CASE mp."PreferenceSeq"
                   WHEN 1 THEN 3
                   WHEN 2 THEN 2
                   WHEN 3 THEN 1
               END) AS "WeightedScore"
    FROM   "Musical_Preferences" AS mp
    GROUP  BY mp."StyleID"
),
AvgVal AS (
    SELECT AVG("WeightedScore") AS "AvgWeightedScore"
    FROM   Weighted
)
SELECT w."StyleID",
       w."WeightedScore",
       ABS(w."WeightedScore" - a."AvgWeightedScore") AS "AbsDiff"
FROM   Weighted AS w
CROSS  JOIN AvgVal AS a
LIMIT 20;
