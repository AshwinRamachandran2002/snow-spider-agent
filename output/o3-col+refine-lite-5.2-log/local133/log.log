Query:
--7️⃣ Description: Final report – include the style names, weighted scores,
--   and absolute differences from the average, ordered by largest gap.
WITH Weighted AS (
    SELECT mp."StyleID",
           SUM(CASE mp."PreferenceSeq"
                   WHEN 1 THEN 3
                   WHEN 2 THEN 2
                   WHEN 3 THEN 1
               END) AS "WeightedScore"
    FROM   "Musical_Preferences" AS mp
    GROUP  BY mp."StyleID"
),
AvgVal AS (
    SELECT AVG("WeightedScore") AS "AvgWeightedScore"
    FROM   Weighted
)
SELECT ms."StyleName",
       w."WeightedScore",
       ABS(w."WeightedScore" - a."AvgWeightedScore") AS "AbsDiff"
FROM   Weighted AS w
JOIN   "Musical_Styles" AS ms ON w."StyleID" = ms."StyleID"
CROSS  JOIN AvgVal AS a
ORDER  BY "AbsDiff" DESC
LIMIT 20;
