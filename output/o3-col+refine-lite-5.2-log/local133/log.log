```sql
--1️⃣ Description: Show every musical style that has at least one ranking from any customer.
SELECT DISTINCT "StyleID"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
--2️⃣ Description: Pair the ranked style IDs with their readable names.
SELECT DISTINCT mp."StyleID",
                ms."StyleName"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms
       ON mp."StyleID" = ms."StyleID"
LIMIT 20;
```

```sql
--3️⃣ Description: Count how many 1st‑, 2nd‑, and 3rd‑place votes each musical style received.
SELECT mp."StyleID",
       mp."PreferenceSeq",
       COUNT(*) AS "RankCount"
FROM   "Musical_Preferences" AS mp
GROUP  BY mp."StyleID", mp."PreferenceSeq"
LIMIT 20;
```

```sql
--4️⃣ Description: Compute the weighted score for every style  
--   (3 pts for 1st, 2 pts for 2nd, 1 pt for 3rd).
SELECT mp."StyleID",
       SUM(CASE mp."PreferenceSeq"
               WHEN 1 THEN 3
               WHEN 2 THEN 2
               WHEN 3 THEN 1
               ELSE 0
           END) AS "WeightedScore"
FROM   "Musical_Preferences" AS mp
GROUP  BY mp."StyleID"
LIMIT 20;
```

```sql
--5️⃣ Description: Find the average weighted score across all styles that received votes.
WITH Weighted AS (
    SELECT mp."StyleID",
           SUM(CASE mp."PreferenceSeq"
                   WHEN 1 THEN 3
                   WHEN 2 THEN 2
                   WHEN 3 THEN 1
               END) AS "WeightedScore"
    FROM   "Musical_Preferences" AS mp
    GROUP  BY mp."StyleID"
)
SELECT AVG("WeightedScore") AS "AvgWeightedScore"
FROM   Weighted;
```

```sql
--6️⃣ Description: For each style, show its weighted score and its absolute
--   difference from the overall average (numeric ID only).
WITH Weighted AS (
    SELECT mp."StyleID",
           SUM(CASE mp."PreferenceSeq"
                   WHEN 1 THEN 3
                   WHEN 2 THEN 2
                   WHEN 3 THEN 1
               END) AS "WeightedScore"
    FROM   "Musical_Preferences" AS mp
    GROUP  BY mp."StyleID"
),
AvgVal AS (
    SELECT AVG("WeightedScore") AS "AvgWeightedScore"
    FROM   Weighted
)
SELECT w."StyleID",
       w."WeightedScore",
       ABS(w."WeightedScore" - a."AvgWeightedScore") AS "AbsDiff"
FROM   Weighted AS w
CROSS  JOIN AvgVal AS a
LIMIT 20;
```

```sql
--7️⃣ Description: Final report – include the style names, weighted scores,
--   and absolute differences from the average, ordered by largest gap.
WITH Weighted AS (
    SELECT mp."StyleID",
           SUM(CASE mp."PreferenceSeq"
                   WHEN 1 THEN 3
                   WHEN 2 THEN 2
                   WHEN 3 THEN 1
               END) AS "WeightedScore"
    FROM   "Musical_Preferences" AS mp
    GROUP  BY mp."StyleID"
),
AvgVal AS (
    SELECT AVG("WeightedScore") AS "AvgWeightedScore"
    FROM   Weighted
)
SELECT ms."StyleName",
       w."WeightedScore",
       ABS(w."WeightedScore" - a."AvgWeightedScore") AS "AbsDiff"
FROM   Weighted AS w
JOIN   "Musical_Styles" AS ms ON w."StyleID" = ms."StyleID"
CROSS  JOIN AvgVal AS a
ORDER  BY "AbsDiff" DESC
LIMIT 20;
```
