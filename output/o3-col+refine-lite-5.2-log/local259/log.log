    JOIN   "wicket_taken" w USING ("match_id","over_id","ball_id")
    GROUP  BY b."bowler"),

runs_conceded AS (
    SELECT b."bowler" AS "player_id",
           COUNT(*)                       AS balls_bowled,
           SUM(COALESCE(bs."runs_scored",0)) AS runs_conceded
    FROM   "ball_by_ball" b
    LEFT   JOIN "batsman_scored" bs USING ("match_id","over_id","ball_id")
    GROUP  BY b."bowler"),

bowler_match AS (
    SELECT b."bowler" AS "player_id",
           b."match_id",
           COUNT(w."player_out")                       AS wkts_in_match,
           SUM(COALESCE(bs."runs_scored",0))           AS runs_in_match
    FROM   "ball_by_ball" b
    LEFT   JOIN "wicket_taken"   w  USING ("match_id","over_id","ball_id")
    LEFT   JOIN "batsman_scored" bs USING ("match_id","over_id","ball_id")
    GROUP  BY b."bowler",b."match_id"),

best_wkt AS (
    SELECT "player_id",
           MAX(wkts_in_match) AS max_wkts
    FROM   bowler_match
    GROUP  BY "player_id"),

best_figures AS (
    SELECT bm."player_id",
           CAST(bw.max_wkts AS TEXT) || '-' ||
           CAST(MIN(bm.runs_in_match) AS TEXT) AS best_bowling
    FROM   bowler_match bm
    JOIN   best_wkt     bw
           ON bm."player_id" = bw."player_id"
          AND bm.wkts_in_match = bw.max_wkts
    GROUP  BY bm."player_id")

SELECT p."player_id",
       p."player_name",
       mr."primary_role",
       p."batting_hand",
       p."bowling_skill",
       COALESCE(rt.total_runs,0)                              AS total_runs,
       COALESCE(mp.matches_played,0)                          AS matches_played,
       COALESCE(d.times_out,0)                                AS dismissals,
       CASE WHEN COALESCE(d.times_out,0) > 0
            THEN ROUND(1.0*rt.total_runs/d.times_out,2) END   AS batting_avg,
       sb.highest_score,
       sb.match_30p,
       sb.match_50p,
       sb.match_100p,
       COALESCE(bf.balls_faced,0)                             AS balls_faced,
       CASE WHEN COALESCE(bf.balls_faced,0) > 0
            THEN ROUND(100.0*rt.total_runs/bf.balls_faced,2) END AS strike_rate,
       COALESCE(wt.total_wkts,0)                              AS total_wickets,
       CASE WHEN rc.balls_bowled>0
            THEN ROUND(1.0*rc.runs_conceded/(rc.balls_bowled/6.0),2) END  AS economy_rate,
       bf2.best_bowling
FROM   "player"            p
LEFT   JOIN most_role      mr  ON p."player_id" = mr."player_id"
LEFT   JOIN runs_total     rt  ON p."player_id" = rt."player_id"
LEFT   JOIN matches_played mp  ON p."player_id" = mp."player_id"
LEFT   JOIN dismissals     d   ON p."player_id" = d."player_id"
LEFT   JOIN score_buckets  sb  ON p."player_id" = sb."player_id"
LEFT   JOIN balls_faced    bf  ON p."player_id" = bf."player_id"
LEFT   JOIN wickets_taken  wt  ON p."player_id" = wt."player_id"
LEFT   JOIN runs_conceded  rc  ON p."player_id" = rc."player_id"
LEFT   JOIN best_figures   bf2 ON p."player_id" = bf2."player_id"
LIMIT  20;
