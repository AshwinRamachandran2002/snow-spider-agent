WITH
role_freq AS (
    SELECT "player_id",
           "role",
           COUNT(*)                                          AS cnt,
           ROW_NUMBER() OVER (PARTITION BY "player_id"
                              ORDER BY COUNT(*) DESC, "role") AS rn
    FROM   "player_match"
    GROUP  BY "player_id","role"),
most_role  AS (SELECT "player_id","role" AS "primary_role"
               FROM   role_freq
               WHERE  rn = 1),

runs_total AS (
    SELECT "striker" AS "player_id",
           SUM("runs_scored") AS total_runs
    FROM   "batsman_scored"
    GROUP  BY "striker"),

balls_faced AS (
    SELECT "striker" AS "player_id",
           COUNT(*)   AS balls_faced
    FROM   "ball_by_ball"
    GROUP  BY "striker"),

dismissals AS (
    SELECT "player_out" AS "player_id",
           COUNT(*)     AS times_out
    FROM   "wicket_taken"
    GROUP  BY "player_out"),

runs_match AS (
    SELECT "striker"           AS "player_id",
           "match_id",
           SUM("runs_scored")  AS runs_in_match
    FROM   "batsman_scored"
    GROUP  BY "striker","match_id"),

score_buckets AS (
    SELECT "player_id",
           MAX(runs_in_match)                                             AS highest_score,
           SUM(CASE WHEN runs_in_match >= 30  THEN 1 ELSE 0 END)          AS match_30p,
           SUM(CASE WHEN runs_in_match >= 50  THEN 1 ELSE 0 END)          AS match_50p,
           SUM(CASE WHEN runs_in_match >= 100 THEN 1 ELSE 0 END)          AS match_100p
    FROM   runs_match
    GROUP  BY "player_id"),

matches_played AS (
    SELECT "player_id",
           COUNT(DISTINCT "match_id") AS matches_played
    FROM   "player_match"
    GROUP  BY "player_id"),

wickets_taken AS (
    SELECT b."bowler" AS "player_id",
           COUNT(*)   AS total_wkts
    FROM   "ball_by_ball" b
    JOIN   "wicket_taken" w USING ("match_id","over_id","ball_id")
    GROUP  BY b."bowler"),

runs_conceded AS (
    SELECT b."bowler" AS "player_id",
           COUNT(*)                       AS balls_bowled,
           SUM(COALESCE(bs."runs_scored",0)) AS runs_conceded
    FROM   "ball_by_ball" b
    LEFT   JOIN "batsman_scored" bs USING ("match_id","over_id","ball_id")
    GROUP  BY b."bowler"),

bowler_match AS (
    SELECT b."bowler" AS "player_id",
           b."match_id",
           COUNT(w."player_out")                       AS wkts_in_match,
           SUM(COALESCE(bs."runs_scored",0))           AS runs_in_match
    FROM   "ball_by_ball" b
    LEFT   JOIN "wicket_taken"   w  USING ("match_id","over_id","ball_id")
    LEFT   JOIN "batsman_scored" bs USING ("match_id","over_id","ball_id")
    GROUP  BY b."bowler",b."match_id"),

best_wkt AS (
    SELECT "player_id",
           MAX(wkts_in_match) AS max_wkts
    FROM   bowler_match
    GROUP  BY "player_id"),

best_figures AS (
    SELECT bm."player_id",
           CAST(bw.max_wkts AS TEXT) || '-' ||
           CAST(MIN(bm.runs_in_match) AS TEXT) AS best_bowling
    FROM   bowler_match bm
    JOIN   best_wkt     bw
           ON bm."player_id" = bw."player_id"
          AND bm.wkts_in_match = bw.max_wkts
    GROUP  BY bm."player_id")

SELECT p."player_id",
       p."player_name",
       mr."primary_role",
       p."batting_hand",
       p."bowling_skill",
       COALESCE(rt.total_runs,0)                              AS total_runs,
       COALESCE(mp.matches_played,0)                          AS matches_played,
       COALESCE(d.times_out,0)                                AS dismissals,
       CASE WHEN COALESCE(d.times_out,0) > 0
            THEN ROUND(1.0*rt.total_runs/d.times_out,2) END   AS batting_avg,
       sb.highest_score,
       sb.match_30p,
       sb.match_50p,
       sb.match_100p,
       COALESCE(bf.balls_faced,0)                             AS balls_faced,
       CASE WHEN COALESCE(bf.balls_faced,0) > 0
            THEN ROUND(100.0*rt.total_runs/bf.balls_faced,2) END AS strike_rate,
       COALESCE(wt.total_wkts,0)                              AS total_wickets,
       CASE WHEN rc.balls_bowled>0
            THEN ROUND(1.0*rc.runs_conceded/(rc.balls_bowled/6.0),2) END  AS economy_rate,
       bf2.best_bowling
FROM   "player"            p
LEFT   JOIN most_role      mr  ON p."player_id" = mr."player_id"
LEFT   JOIN runs_total     rt  ON p."player_id" = rt."player_id"
LEFT   JOIN matches_played mp  ON p."player_id" = mp."player_id"
