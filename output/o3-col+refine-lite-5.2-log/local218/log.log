Query:
--Description: 8) Show the 20 clubs with the largest “best‑season” goal totals  
SELECT t."team_long_name",
       hg."max_goals"
FROM (
        SELECT "team_api_id",
               MAX("total_goals") AS "max_goals"
        FROM (
                SELECT "team_api_id",
                       "season",
                       SUM("goals") AS "total_goals"
                FROM (
                        SELECT "home_team_api_id" AS "team_api_id",
                               "season",
                               "home_team_goal" AS "goals"
                        FROM "Match"
                        UNION ALL
                        SELECT "away_team_api_id",
                               "season",
                               "away_team_goal"
                        FROM "Match"
                     ) AS m
                GROUP BY "team_api_id",
                         "season"
             )
        GROUP BY "team_api_id"
     ) AS hg
JOIN "Team" AS t
  ON t."team_api_id" = hg."team_api_id"
ORDER BY hg."max_goals" DESC
LIMIT 20;
