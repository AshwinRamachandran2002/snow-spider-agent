Query:
--Description: 6) Attach readable club names to the season‑goal tallies  
SELECT t."team_long_name",
       g."season",
       g."total_goals"
FROM (
        SELECT "team_api_id",
               "season",
               SUM("goals") AS "total_goals"
        FROM (
                SELECT "home_team_api_id" AS "team_api_id",
                       "season",
                       "home_team_goal" AS "goals"
                FROM "Match"
                UNION ALL
                SELECT "away_team_api_id",
                       "season",
                       "away_team_goal"
                FROM "Match"
             ) AS m
        GROUP BY "team_api_id",
                 "season"
     ) AS g
JOIN "Team" AS t
  ON t."team_api_id" = g."team_api_id"
LIMIT 20;
