```sql
--Description: 1) See which seasons exist in the Match table  
SELECT DISTINCT "season"
FROM "Match"
LIMIT 20;
```

```sql
--Description: 2) Look at a handful of matches with home/away goals and the two teams involved  
SELECT "id",
       "season",
       "home_team_api_id",
       "home_team_goal",
       "away_team_api_id",
       "away_team_goal"
FROM "Match"
LIMIT 20;
```

```sql
--Description: 3) Total home‑side goals for every team in every season  
SELECT "home_team_api_id" AS "team_api_id",
       "season",
       SUM("home_team_goal") AS "home_goals"
FROM "Match"
GROUP BY "home_team_api_id",
         "season"
LIMIT 20;
```

```sql
--Description: 4) Total away‑side goals for every team in every season  
SELECT "away_team_api_id" AS "team_api_id",
       "season",
       SUM("away_team_goal") AS "away_goals"
FROM "Match"
GROUP BY "away_team_api_id",
         "season"
LIMIT 20;
```

```sql
--Description: 5) Combine home + away to get overall season‑goal tallies per team  
SELECT "team_api_id",
       "season",
       SUM("goals") AS "total_goals"
FROM (
        SELECT "home_team_api_id" AS "team_api_id",
               "season",
               "home_team_goal" AS "goals"
        FROM "Match"
        UNION ALL
        SELECT "away_team_api_id",
               "season",
               "away_team_goal"
        FROM "Match"
     ) AS m
GROUP BY "team_api_id",
         "season"
LIMIT 20;
```

```sql
--Description: 6) Attach readable club names to the season‑goal tallies  
SELECT t."team_long_name",
       g."season",
       g."total_goals"
FROM (
        SELECT "team_api_id",
               "season",
               SUM("goals") AS "total_goals"
        FROM (
                SELECT "home_team_api_id" AS "team_api_id",
                       "season",
                       "home_team_goal" AS "goals"
                FROM "Match"
                UNION ALL
                SELECT "away_team_api_id",
                       "season",
                       "away_team_goal"
                FROM "Match"
             ) AS m
        GROUP BY "team_api_id",
                 "season"
     ) AS g
JOIN "Team" AS t
  ON t."team_api_id" = g."team_api_id"
LIMIT 20;
```

```sql
--Description: 7) For every club, keep only the season in which it scored the most goals  
SELECT "team_api_id",
       MAX("total_goals") AS "max_goals"
FROM (
        SELECT "team_api_id",
               "season",
               SUM("goals") AS "total_goals"
        FROM (
                SELECT "home_team_api_id" AS "team_api_id",
                       "season",
                       "home_team_goal" AS "goals"
                FROM "Match"
                UNION ALL
                SELECT "away_team_api_id",
                       "season",
                       "away_team_goal"
                FROM "Match"
             ) AS m
        GROUP BY "team_api_id",
                 "season"
     )
GROUP BY "team_api_id"
LIMIT 20;
```

```sql
--Description: 8) Show the 20 clubs with the largest “best‑season” goal totals  
SELECT t."team_long_name",
       hg."max_goals"
FROM (
        SELECT "team_api_id",
               MAX("total_goals") AS "max_goals"
        FROM (
                SELECT "team_api_id",
                       "season",
                       SUM("goals") AS "total_goals"
                FROM (
                        SELECT "home_team_api_id" AS "team_api_id",
                               "season",
                               "home_team_goal" AS "goals"
                        FROM "Match"
                        UNION ALL
                        SELECT "away_team_api_id",
                               "season",
                               "away_team_goal"
                        FROM "Match"
                     ) AS m
                GROUP BY "team_api_id",
                         "season"
             )
        GROUP BY "team_api_id"
     ) AS hg
JOIN "Team" AS t
  ON t."team_api_id" = hg."team_api_id"
ORDER BY hg."max_goals" DESC
LIMIT 20;
```

```sql
--Description: 9) Compute the median of those “best‑season” goal totals across all teams  
WITH max_per_team AS (
     SELECT "team_api_id",
            MAX("total_goals") AS "max_goals"
     FROM (
             SELECT "team_api_id",
                    "season",
                    SUM("goals") AS "total_goals"
             FROM (
                     SELECT "home_team_api_id" AS "team_api_id",
                            "season",
                            "home_team_goal" AS "goals"
                     FROM "Match"
                     UNION ALL
                     SELECT "away_team_api_id",
                            "season",
                            "away_team_goal"
                     FROM "Match"
                  ) AS m
             GROUP BY "team_api_id",
                      "season"
          )
     GROUP BY "team_api_id"
),
ordered AS (
     SELECT "max_goals",
            ROW_NUMBER() OVER (ORDER BY "max_goals")            AS rn,
            COUNT(*)    OVER ()                                  AS cnt
     FROM max_per_team
)
SELECT AVG("max_goals") AS "median_max_goals"
FROM   ordered
WHERE  rn IN ( (cnt + 1) / 2, (cnt + 2) / 2 )
LIMIT 20;
```
