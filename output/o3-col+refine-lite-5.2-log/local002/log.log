```sql
-- 1)  Identify the Portuguese product‐category that translates to “toys”
SELECT DISTINCT
       t.product_category_name,
       t.product_category_name_english
FROM   product_category_name_translation AS t
WHERE  t.product_category_name_english LIKE '%toy%'
LIMIT 20;
```

```sql
-- 2)  List a few products that belong to that “toys” category
SELECT DISTINCT
       p.product_id,
       p.product_category_name
FROM   products                AS p
JOIN   product_category_name_translation AS t
       ON t.product_category_name = p.product_category_name
WHERE  t.product_category_name_english = 'toys'
LIMIT 20;
```

```sql
-- 3)  Pull some order–item lines that contain those toy products
SELECT DISTINCT
       oi.order_id,
       oi.product_id,
       oi.order_item_id,
       oi.price
FROM   order_items            AS oi
JOIN   products               AS p
       ON p.product_id = oi.product_id
JOIN   product_category_name_translation AS t
       ON t.product_category_name = p.product_category_name
WHERE  t.product_category_name_english = 'toys'
LIMIT 20;
```

```sql
-- 4)  Attach the purchase date to each toy order–item line
SELECT DISTINCT
       date(o.order_purchase_timestamp) AS order_date,
       oi.order_id,
       oi.product_id
FROM   order_items   AS oi
JOIN   orders        AS o  ON o.order_id = oi.order_id
JOIN   products      AS p  ON p.product_id = oi.product_id
JOIN   product_category_name_translation AS t
       ON t.product_category_name = p.product_category_name
WHERE  t.product_category_name_english = 'toys'
  AND  date(o.order_purchase_timestamp) BETWEEN '2017-01-01' AND '2018-08-29'
LIMIT 20;
```

```sql
-- 5)  Aggregate daily toy‑unit sales for the learning window (01‑Jan‑2017 … 29‑Aug‑2018)
--     One row per calendar day
SELECT DISTINCT
       order_date,
       COUNT(*) AS toy_units_sold
FROM (
        SELECT
               date(o.order_purchase_timestamp) AS order_date
        FROM   order_items   AS oi
        JOIN   orders        AS o  ON o.order_id = oi.order_id
        JOIN   products      AS p  ON p.product_id = oi.product_id
        JOIN   product_category_name_translation AS t
               ON t.product_category_name = p.product_category_name
        WHERE  t.product_category_name_english = 'toys'
          AND  date(o.order_purchase_timestamp) BETWEEN '2017-01-01' AND '2018-08-29'
     )
GROUP BY order_date
LIMIT 20;
```

```sql
-- 6)  Pre‑compute regression ingredients (n, Σx, Σy, Σx², Σxy)
--     We encode each calendar day as the # of days since 2017‑01‑01 (x)
WITH daily AS (
       SELECT
              CAST(julianday(order_date) - julianday('2017-01-01') AS INTEGER) AS x,
              toy_units_sold                                               AS y
       FROM (
              SELECT
                     order_date,
                     COUNT(*) AS toy_units_sold
              FROM (
                       SELECT
                              date(o.order_purchase_timestamp) AS order_date
                       FROM   order_items   AS oi
                       JOIN   orders        AS o  ON o.order_id = oi.order_id
                       JOIN   products      AS p  ON p.product_id = oi.product_id
                       JOIN   product_category_name_translation AS t
                              ON t.product_category_name = p.product_category_name
                       WHERE  t.product_category_name_english = 'toys'
                         AND  date(o.order_purchase_timestamp) BETWEEN '2017-01-01' AND '2018-08-29'
                    )
              GROUP BY order_date
       )
)
SELECT DISTINCT
       COUNT(*)                      AS n,
       SUM(x)                        AS sum_x,
       SUM(y)                        AS sum_y,
       SUM(x*x)                      AS sum_x2,
       SUM(x*y)                      AS sum_xy
FROM   daily
LIMIT 20;
```

```sql
-- 7)  Solve for the regression coefficients (slope, intercept)
WITH stats AS (
       SELECT
              COUNT(*)                   AS n,
              SUM(x)                     AS sum_x,
              SUM(y)                     AS sum_y,
              SUM(x*x)                   AS sum_x2,
              SUM(x*y)                   AS sum_xy
       FROM (
              SELECT
                     CAST(julianday(order_date) - julianday('2017-01-01') AS INTEGER) AS x,
                     toy_units_sold                                               AS y
              FROM (
                     SELECT
                            date(o.order_purchase_timestamp) AS order_date,
                            COUNT(*)                         AS toy_units_sold
                     FROM   order_items   AS oi
                     JOIN   orders        AS o  ON o.order_id = oi.order_id
                     JOIN   products      AS p  ON p.product_id = oi.product_id
                     JOIN   product_category_name_translation AS t
                            ON t.product_category_name = p.product_category_name
                     WHERE  t.product_category_name_english = 'toys'
                       AND  date(o.order_purchase_timestamp) BETWEEN '2017-01-01' AND '2018-08-29'
                     GROUP BY order_date
              )
       )
)
SELECT DISTINCT
       ( (stats.n*stats.sum_xy - stats.sum_x*stats.sum_y)*1.0 /
         (stats.n*stats.sum_x2 - stats.sum_x*stats.sum_x) )               AS slope,
       ( stats.sum_y - (
           ( (stats.n*stats.sum_xy - stats.sum_x*stats.sum_y)*1.0 /
             (stats.n*stats.sum_x2 - stats.sum_x*stats.sum_x) )
         )*stats.sum_x )*1.0 / stats.n                                    AS intercept
FROM   stats
LIMIT 20;
```

```sql
-- 8)  Produce the regression‑predicted toy sales for the 10‑day window
--     3‑Dec‑2018 … 10‑Dec‑2018  (needed for symmetric 5‑day averages)
WITH coeff AS (    -- regression coefficients
       SELECT
              ( (n*sum_xy - sum_x*sum_y)*1.0 /
                (n*sum_x2 - sum_x*sum_x) )                 AS slope,
              ( sum_y - (
                  ( (n*sum_xy - sum_x*sum_y)*1.0 /
                    (n*sum_x2 - sum_x*sum_x) )*sum_x )
              )*1.0/n                                      AS intercept
       FROM (
              SELECT
                     COUNT(*) AS n,
                     SUM(x)   AS sum_x,
                     SUM(y)   AS sum_y,
                     SUM(x*x) AS sum_x2,
                     SUM(x*y) AS sum_xy
              FROM (
                     SELECT
                            CAST(julianday(order_date) - julianday('2017-01-01') AS INTEGER) AS x,
                            toy_units_sold                                               AS y
                     FROM (
                            SELECT
                                   date(o.order_purchase_timestamp) AS order_date,
                                   COUNT(*)                         AS toy_units_sold
                            FROM   order_items   AS oi
                            JOIN   orders        AS o  ON o.order_id = oi.order_id
                            JOIN   products      AS p  ON p.product_id = oi.product_id
                            JOIN   product_category_name_translation AS t
                                   ON t.product_category_name = p.product_category_name
                            WHERE  t.product_category_name_english = 'toys'
                              AND  date(o.order_purchase_timestamp) BETWEEN '2017-01-01' AND '2018-08-29'
                            GROUP BY order_date
                     )
              )
       )
),
forecast AS (      -- calendar days we want predictions for
       SELECT date('2018-12-03','+'||i||' day') AS d
       FROM   (SELECT 0 AS i UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL
               SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL
               SELECT 6 UNION ALL SELECT 7)
),
pred AS (          -- predicted ŷ for each of those dates
       SELECT
              f.d                                               AS forecast_date,
              ( CAST(julianday(f.d) - julianday('2017-01-01') AS INTEGER) ) AS x,
              c.slope * ( CAST(julianday(f.d) - julianday('2017-01-01') AS INTEGER) )
              + c.intercept                                     AS y_hat
       FROM   forecast AS f
       CROSS JOIN coeff  AS c
)
SELECT DISTINCT * FROM pred
LIMIT 20;
```

```sql
-- 9)  Compute the centred 5‑day (symmetric) moving average for 5‑Dec‑2018 … 8‑Dec‑2018
WITH pred AS (           -- same CTE from step‑8
       SELECT
              f.d                                               AS forecast_date,
              ( CAST(julianday(f.d) - julianday('2017-01-01') AS INTEGER) ) AS x,
              c.slope * ( CAST(julianday(f.d) - julianday('2017-01-01') AS INTEGER) )
              + c.intercept                                     AS y_hat
       FROM  (SELECT date('2018-12-03','+'||i||' day') AS d
              FROM   (SELECT 0 AS i UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL
                      SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL
                      SELECT 6 UNION ALL SELECT 7)
             ) AS f
       CROSS JOIN (
              SELECT
                     ( (n*sum_xy - sum_x*sum_y)*1.0 /
                       (n*sum_x2 - sum_x*sum_x) )              AS slope,
                     ( sum_y - (
                         ( (n*sum_xy - sum_x*sum_y)*1.0 /
                           (n*sum_x2 - sum_x*sum_x) )*sum_x )
                     )*1.0/n                                   AS intercept
              FROM (
                     SELECT
                            COUNT(*) AS n,
                            SUM(x)   AS sum_x,
                            SUM(y)   AS sum_y,
                            SUM(x*x) AS sum_x2,
                            SUM(x*y) AS sum_xy
                     FROM (
                            SELECT
                                   CAST(julianday(order_date) - julianday('2017-01-01') AS INTEGER) AS x,
                                   toy_units_sold                                               AS y
                            FROM (
                                   SELECT
                                          date(o.order_purchase_timestamp) AS order_date,
                                          COUNT(*)                         AS toy_units_sold
                                   FROM   order_items   AS oi
                                   JOIN   orders        AS o  ON o.order_id = oi.order_id
                                   JOIN   products      AS p  ON p.product_id = oi.product_id
                                   JOIN   product_category_name_translation AS t
                                          ON t.product_category_name = p.product_category_name
                                   WHERE  t.product_category_name_english = 'toys'
                                     AND  date(o.order_purchase_timestamp) BETWEEN '2017-01-01' AND '2018-08-29'
                                   GROUP BY order_date
                            )
                     )
              )
       ) AS c
),
five_day_ma AS (
       SELECT
              p1.forecast_date                    AS center_day,
              AVG(p2.y_hat)                       AS ma5
       FROM   pred AS p1
       JOIN   pred AS p2
              ON julianday(p2.forecast_date)
               BETWEEN julianday(p1.forecast_date,'-2 days')
                   AND julianday(p1.forecast_date,'+2 days')
       GROUP BY p1.forecast_date
)
SELECT DISTINCT
       center_day,
       ma5
FROM   five_day_ma
WHERE  center_day BETWEEN '2018-12-05' AND '2018-12-08'
LIMIT 20;
```

```sql
-- 10)  Sum of the four centred 5‑day moving averages (5‑Dec‑2018 … 8‑Dec‑2018)
WITH five_day_ma AS (        -- identical to CTE in step‑9
       SELECT
              p1.forecast_date                    AS center_day,
              AVG(p2.y_hat)                       AS ma5
       FROM (
              SELECT
                     f.d                                               AS forecast_date,
                     ( CAST(julianday(f.d) - julianday('2017-01-01') AS INTEGER) ) AS x,
                     c.slope * ( CAST(julianday(f.d) - julianday('2017-01-01') AS INTEGER) )
                     + c.intercept                                     AS y_hat
              FROM  (SELECT date('2018-12-03','+'||i||' day') AS d
                     FROM   (SELECT 0 AS i UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL
                             SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL
                             SELECT 6 UNION ALL SELECT 7)
                    ) AS f
              CROSS JOIN (
                     SELECT
                            ( (n*sum_xy - sum_x*sum_y)*1.0 /
                              (n*sum_x2 - sum_x*sum_x) )     AS slope,
                            ( sum_y - (
                                ( (n*sum_xy - sum_x*sum_y)*1.0 /
                                  (n*sum_x2 - sum_x*sum_x) )*sum_x )
                            )*1.0/n                          AS intercept
                     FROM (
                            SELECT
                                   COUNT(*) AS n,
                                   SUM(x)   AS sum_x,
                                   SUM(y)   AS sum_y,
                                   SUM(x*x) AS sum_x2,
                                   SUM(x*y) AS sum_xy
                            FROM (
                                   SELECT
                                          CAST(julianday(order_date) - julianday('2017-01-01') AS INTEGER) AS x,
                                          toy_units_sold                                               AS y
                                   FROM (
                                          SELECT
                                                 date(o.order_purchase_timestamp) AS order_date,
                                                 COUNT(*)                         AS toy_units_sold
                                          FROM   order_items   AS oi
                                          JOIN   orders        AS o  ON o.order_id = oi.order_id
                                          JOIN   products      AS p  ON p.product_id = oi.product_id
                                          JOIN   product_category_name_translation AS t
                                                 ON t.product_category_name = p.product_category_name
                                          WHERE  t.product_category_name_english = 'toys'
                                            AND  date(o.order_purchase_timestamp) BETWEEN '2017-01-01' AND '2018-08-29'
                                          GROUP BY order_date
                                   )
                            )
                     )
              ) AS c
       ) AS p1
       JOIN (
              SELECT
                     f.d                                               AS forecast_date,
                     c.slope * ( CAST(julianday(f.d) - julianday('2017-01-01') AS INTEGER) )
                     + c.intercept                                     AS y_hat
              FROM  (SELECT date('2018-12-03','+'||i||' day') AS d
                     FROM   (SELECT 0 AS i UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL
                             SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL
                             SELECT 6 UNION ALL SELECT 7)
                    ) AS f
              CROSS JOIN (
                     SELECT
                            ( (n*sum_xy - sum_x*sum_y)*1.0 /
                              (n*sum_x2 - sum_x*sum_x) )     AS slope,
                            ( sum_y - (
                                ( (n*sum_xy - sum_x*sum_y)*1.0 /
                                  (n*sum_x2 - sum_x*sum_x) )*sum_x )
                            )*1.0/n                          AS intercept
                     FROM (
                            SELECT
                                   COUNT(*) AS n,
                                   SUM(x)   AS sum_x,
                                   SUM(y)   AS sum_y,
                                   SUM(x*x) AS sum_x2,
                                   SUM(x*y) AS sum_xy
                            FROM (
                                   SELECT
                                          CAST(julianday(order_date) - julianday('2017-01-01') AS INTEGER) AS x,
                                          toy_units_sold                                               AS y
                                   FROM (
                                          SELECT
                                                 date(o.order_purchase_timestamp) AS order_date,
                                                 COUNT(*)                         AS toy_units_sold
                                          FROM   order_items   AS oi
                                          JOIN   orders        AS o  ON o.order_id = oi.order_id
                                          JOIN   products      AS p  ON p.product_id = oi.product_id
                                          JOIN   product_category_name_translation AS t
                                                 ON t.product_category_name = p.product_category_name
                                          WHERE  t.product_category_name_english = 'toys'
                                            AND  date(o.order_purchase_timestamp) BETWEEN '2017-01-01' AND '2018-08-29'
                                          GROUP BY order_date
                                   )
                            )
                     )
              ) AS c
       ) AS p2
              ON julianday(p2.forecast_date)
               BETWEEN julianday(p1.forecast_date,'-2 days')
                   AND julianday(p1.forecast_date,'+2 days')
       GROUP BY p1.forecast_date
)
SELECT DISTINCT
       SUM(ma5) AS sum_of_4_moving_averages
FROM   five_day_ma
WHERE  center_day BETWEEN '2018-12-05' AND '2018-12-08'
LIMIT 20;
```

These ten progressively richer `SELECT` statements

1. pinpoint the “toys” category,  
2. list the corresponding products,  
3‑4. tie those products to orders and dates,  
5. build a day‑level sales time‑series,  
6‑7. derive simple‑linear‑regression coefficients,  
8. forecast daily toy sales for early December 2018,  
9. compute the centred 5‑day moving averages for 5‑Dec through 8‑Dec 2018, and  
10. return the requested grand total of those four 5‑day moving averages.
