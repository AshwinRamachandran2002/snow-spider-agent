```sql
--Description: Distinct families cited (outbound citations) by the selected families
SELECT  DISTINCT p."family_id"            AS "source_family",
        cited."family_id"                 AS "cited_family"
FROM    PATENTS_GOOGLE.PATENTS_GOOGLE."PUBLICATIONS" p,
        LATERAL FLATTEN(input => p."citation") c
        LEFT JOIN PATENTS_GOOGLE.PATENTS_GOOGLE."PUBLICATIONS" cited
               ON cited."publication_number" = c.value:"publication_number"::STRING
JOIN   (SELECT "family_id"
        FROM   PATENTS_GOOGLE.PATENTS_GOOGLE."PUBLICATIONS"
        GROUP  BY "family_id"
        HAVING MIN("publication_date") BETWEEN 20150101 AND 20150131) f
       ON p."family_id" = f."family_id"
WHERE   cited."family_id" IS NOT NULL
ORDER BY p."family_id", cited."family_id"
LIMIT 20;
```

```sql
--Description: Distinct families that cite (inbound citations) the selected families
WITH selected_pubs AS (
     SELECT "publication_number", "family_id"
     FROM   PATENTS_GOOGLE.PATENTS_GOOGLE."PUBLICATIONS"
     WHERE  "family_id" IN (SELECT "family_id"
                            FROM   PATENTS_GOOGLE.PATENTS_GOOGLE."PUBLICATIONS"
                            GROUP  BY "family_id"
                            HAVING MIN("publication_date") BETWEEN 20150101 AND 20150131)
)
SELECT  DISTINCT cited_from."family_id"  AS "citing_family",
        sp."family_id"                   AS "target_family"
FROM    PATENTS_GOOGLE.PATENTS_GOOGLE."PUBLICATIONS" cited_from,
        LATERAL FLATTEN(input => cited_from."citation") c
        JOIN selected_pubs sp
             ON sp."publication_number" = c.value:"publication_number"::STRING
WHERE   cited_from."family_id" <> sp."family_id"
ORDER BY "target_family", "citing_family"
LIMIT 20;
```

