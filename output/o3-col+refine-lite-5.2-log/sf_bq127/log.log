Query:
--Description: Extract distinct IPC codes for families whose earliest publication occurred in January 2015
WITH jan15_families AS (
    SELECT   "family_id"
    FROM     PATENTS_GOOGLE.PATENTS_GOOGLE."PUBLICATIONS"
    GROUP BY "family_id"
    HAVING   MIN("publication_date") BETWEEN 20150101 AND 20150131
)
SELECT DISTINCT
       p."family_id",
       i.value:"code"::STRING AS "ipc_code"
FROM   PATENTS_GOOGLE.PATENTS_GOOGLE."PUBLICATIONS" p
JOIN   jan15_families jf
       ON p."family_id" = jf."family_id"
CROSS JOIN LATERAL FLATTEN(input => p."ipc") i
ORDER BY p."family_id", "ipc_code"
LIMIT 20
