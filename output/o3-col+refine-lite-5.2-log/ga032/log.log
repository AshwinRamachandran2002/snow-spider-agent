```sql
--Description: 7) Classify each row as PDP, PLP, or keep the original title.
WITH base AS (
  SELECT event_timestamp,
         (SELECT value.string_value
          FROM UNNEST(event_params) AS p
          WHERE p.key = 'page_title')    AS page_title,
         (SELECT value.string_value
          FROM UNNEST(event_params) AS p
          WHERE p.key = 'page_location') AS page_location
  FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE user_pseudo_id = '1362228.4966015575'
    AND event_name = 'page_view'
)
SELECT event_timestamp,
       page_location,
       page_title,
       CASE
         WHEN page_location IS NULL THEN page_title
         WHEN REGEXP_CONTAINS(page_location,
              r'^https?://[^/]+/[^/]+/[^/]+/[^/]+/.+\+.+' )
              AND REGEXP_CONTAINS(page_location,
              r'Accessories|Apparel|Brands|Campus\+Collection|Drinkware|Electronics|Google\+Redesign|Lifestyle|Nest|New\+2015\+Logo|Notebooks\+Journals|Office|Shop\+by\+Brand|Small\+Goods|Stationery|Wearables')
           THEN 'PDP'
         WHEN REGEXP_CONTAINS(page_location,
              r'^https?://[^/]+/[^/]+/[^/]+/[^/]+/[^/]+$')
              AND NOT REGEXP_CONTAINS(REGEXP_EXTRACT(page_location, r'[^/]+$'), r'\+')
              AND REGEXP_CONTAINS(page_location,
              r'Accessories|Apparel|Brands|Campus\+Collection|Drinkware|Electronics|Google\+Redesign|Lifestyle|Nest|New\+2015\+Logo|Notebooks\+Journals|Office|Shop\+by\+Brand|Small\+Goods|Stationery|Wearables')
           THEN 'PLP'
         ELSE page_title
       END AS node
FROM base
ORDER BY event_timestamp
LIMIT 20;
```

```sql
--Description: 8) Remove consecutive duplicates so repeated identical nodes collapse.
WITH classify AS (
  SELECT event_timestamp,
         CASE
           WHEN page_location IS NULL THEN page_title
           WHEN REGEXP_CONTAINS(page_location,
                r'^https?://[^/]+/[^/]+/[^/]+/[^/]+/.+\+.+' )
                AND REGEXP_CONTAINS(page_location,
                r'Accessories|Apparel|Brands|Campus\+Collection|Drinkware|Electronics|Google\+Redesign|Lifestyle|Nest|New\+2015\+Logo|Notebooks\+Journals|Office|Shop\+by\+Brand|Small\+Goods|Stationery|Wearables')
             THEN 'PDP'
           WHEN REGEXP_CONTAINS(page_location,
                r'^https?://[^/]+/[^/]+/[^/]+/[^/]+/[^/]+$')
                AND NOT REGEXP_CONTAINS(REGEXP_EXTRACT(page_location, r'[^/]+$'), r'\+')
                AND REGEXP_CONTAINS(page_location,
                r'Accessories|Apparel|Brands|Campus\+Collection|Drinkware|Electronics|Google\+Redesign|Lifestyle|Nest|New\+2015\+Logo|Notebooks\+Journals|Office|Shop\+by\+Brand|Small\+Goods|Stationery|Wearables')
             THEN 'PLP'
           ELSE page_title
         END AS node
  FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`,
        UNNEST(event_params) AS p
  WHERE user_pseudo_id = '1362228.4966015575'
    AND event_name = 'page_view'
    AND p.key = 'page_location'   -- anchors one copy per row
)
SELECT event_timestamp,
       node,
       LAG(node) OVER (ORDER BY event_timestamp) AS prev_node
FROM classify
ORDER BY event_timestamp
LIMIT 20;
```

```sql
--Description: 9) Keep only rows where node ≠ previous node (adjacent de‑dup), then list in order.
WITH classify AS (
  SELECT event_timestamp,
         CASE
           WHEN page_location IS NULL THEN page_title
           WHEN REGEXP_CONTAINS(page_location,
                r'^https?://[^/]+/[^/]+/[^/]+/[^/]+/.+\+.+' )
                AND REGEXP_CONTAINS(page_location,
                r'Accessories|Apparel|Brands|Campus\+Collection|Drinkware|Electronics|Google\+Redesign|Lifestyle|Nest|New\+2015\+Logo|Notebooks\+Journals|Office|Shop\+by\+Brand|Small\+Goods|Stationery|Wearables')
             THEN 'PDP'
           WHEN REGEXP_CONTAINS(page_location,
                r'^https?://[^/]+/[^/]+/[^/]+/[^/]+/[^/]+$')
                AND NOT REGEXP_CONTAINS(REGEXP_EXTRACT(page_location, r'[^/]+$'), r'\+')
                AND REGEXP_CONTAINS(page_location,
                r'Accessories|Apparel|Brands|Campus\+Collection|Drinkware|Electronics|Google\+Redesign|Lifestyle|Nest|New\+2015\+Logo|Notebooks\+Journals|Office|Shop\+by\+Brand|Small\+Goods|Stationery|Wearables')
             THEN 'PLP'
           ELSE page_title
         END AS node,
         event_timestamp
  FROM  (
        SELECT event_timestamp,
               ( SELECT value.string_value
                 FROM UNNEST(event_params) AS p
                 WHERE p.key = 'page_title')    AS page_title,
               ( SELECT value.string_value
                 FROM UNNEST(event_params) AS p
                 WHERE p.key = 'page_location') AS page_location
        FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
        WHERE user_pseudo_id = '1362228.4966015575'
          AND event_name = 'page_view'
  )
),
dedup AS (
