--Description: Complete thought process in one statement.
-- ① Pull every page_view hit for the required user/date and extract page_title & page_location (CTE base).
-- ② Classify each hit as PDP / PLP / fallback‑title according to the refined URL rules (CTE class).
-- ③ Remove consecutive duplicates with LAG so we keep only real transitions (CTE dedup).
-- ④ Preserve chronological order and concatenate the nodes with “ >> ” to give the final navigation flow (CTE list + final SELECT).

WITH base AS (                                                         -- step ①
  SELECT
    event_timestamp,
    (SELECT value.string_value
       FROM UNNEST(event_params) AS p
       WHERE p.key = 'page_title')     AS page_title,
    (SELECT value.string_value
       FROM UNNEST(event_params) AS p
       WHERE p.key = 'page_location')  AS page_location
  FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE user_pseudo_id = '1362228.4966015575'
    AND event_name      = 'page_view'
),
class AS (                                                             -- step ②
  SELECT
    event_timestamp,
    CASE
      WHEN page_location IS NULL THEN page_title                                   -- no URL
      WHEN REGEXP_CONTAINS(page_location,                                          -- PDP pattern
             r'^https?://[^/]+/[^/]+/[^/]+/[^/]+/.+\+.+' )
           AND REGEXP_CONTAINS(page_location,
             r'Accessories|Apparel|Brands|Campus\+Collection|Drinkware|Electronics|Google\+Redesign|Lifestyle|Nest|New\+2015\+Logo|Notebooks\+Journals|Office|Shop\+by\+Brand|Small\+Goods|Stationery|Wearables')
           THEN 'PDP'
      WHEN REGEXP_CONTAINS(page_location,                                          -- PLP pattern
             r'^https?://[^/]+/[^/]+/[^/]+/[^/]+/[^/]+$')
           AND NOT REGEXP_CONTAINS(REGEXP_EXTRACT(page_location, r'[^/]+$'), r'\+')
           AND REGEXP_CONTAINS(page_location,
             r'Accessories|Apparel|Brands|Campus\+Collection|Drinkware|Electronics|Google\+Redesign|Lifestyle|Nest|New\+2015\+Logo|Notebooks\+Journals|Office|Shop\+by\+Brand|Small\+Goods|Stationery|Wearables')
           THEN 'PLP'
      ELSE page_title                                                             -- everything else
    END AS node
  FROM base
),
dedup AS (                                                            -- step ③
  SELECT
    event_timestamp,
    node,
    LAG(node) OVER (ORDER BY event_timestamp) AS prev_node
  FROM class
),
list AS (                                                             -- step ④
  SELECT node
  FROM dedup
  WHERE node IS DISTINCT FROM prev_node
  ORDER BY event_timestamp
)
SELECT STRING_AGG(node, ' >> ') AS navigation_flow
FROM   list;
