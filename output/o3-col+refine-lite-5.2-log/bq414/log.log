```sql
--Description / Thinking process:
-- We need the object_id, title, and metadata_date (formatted) for items that:
--   1) belong to the “The Libraries” department                 → objects table filter
--   2) have “book” somewhere in their title (case‑insensitive)  → LOWER(title) LIKE '%book%'
--   3) possess at least one crop‑hint whose confidence > 0.5    → vision_api_data + UNNEST + confidence filter
--   4) show only the highest‑confidence hint per object         → ROW_NUMBER() analytic + QUALIFY
-- Steps implemented below:
--   • Join objects (o) with vision_api_data (v) on object_id.
--   • CROSS JOIN UNNEST to break out each cropHints element (h).
--   • WHERE handles department and title filters.
--   • QUALIFY keeps the top‑confidence row per object and ensures that confidence > 0.5.
--   • FORMAT_DATE converts metadata_date (TIMESTAMP) to 'YYYY‑MM‑DD'.
SELECT
  o.object_id,
  o.title,
  FORMAT_DATE('%F', DATE(o.metadata_date)) AS metadata_date
FROM `bigquery-public-data.the_met.objects`        AS o
JOIN `bigquery-public-data.the_met.vision_api_data` AS v
  ON o.object_id = v.object_id
CROSS JOIN UNNEST(v.cropHintsAnnotation.cropHints) AS h
WHERE o.department = 'The Libraries'
  AND LOWER(o.title) LIKE '%book%'
QUALIFY
  ROW_NUMBER() OVER (PARTITION BY o.object_id ORDER BY h.confidence DESC) = 1
  AND h.confidence > 0.5;
```
