Query:
--Description: 
-- Same goal as the original “order by highest crop confidence first” query,  
-- but ensure we return only the single highest‑confidence hint per object  
-- (fixing potential duplication and making QUALIFY syntactically correct).  
-- Steps:  
--   1. Join objects (o) with vision data (v) on object_id.  
--   2. UNNEST cropHints to obtain each confidence value (h).  
--   3. Filter to “The Libraries” department and titles containing “book”.  
--   4. Use ROW_NUMBER() to rank hints by confidence per object.  
--   5. QUALIFY keeps the top‑ranked hint where confidence > 0.5.  
--   6. Order the surviving rows by confidence descending.  
SELECT
  o.object_id,
  o.title,
  FORMAT_DATE('%F', DATE(o.metadata_date)) AS metadata_date,
  h.confidence
FROM `bigquery-public-data.the_met.objects`        AS o
JOIN `bigquery-public-data.the_met.vision_api_data` AS v
  ON o.object_id = v.object_id
CROSS JOIN UNNEST(v.cropHintsAnnotation.cropHints) AS h
WHERE o.department = 'The Libraries'
  AND LOWER(o.title) LIKE '%book%'
QUALIFY
  ROW_NUMBER() OVER (PARTITION BY o.object_id ORDER BY h.confidence DESC) = 1
  AND h.confidence > 0.5
ORDER BY h.confidence DESC
LIMIT 20
