```sql
-- 3) “Loop” trips (start and end at the same station)
-- Description:  See a sample of loop trips that might become group rides.
SELECT 
  starttime,
  start_station_id,
  end_station_id
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE start_station_id = end_station_id
LIMIT 20;
```

```sql
-- 4) Bucket loop trips into 2‑minute windows
-- Description:  Create a 2‑minute bucket id and count how many trips fall in each.  
WITH loops AS (
  SELECT *, 
         FLOOR(UNIX_SECONDS(starttime)/120) AS bucket_id
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE start_station_id = end_station_id
)
SELECT 
  start_station_id,
  bucket_id,
  COUNT(*) AS trips_in_bucket
FROM loops
GROUP BY start_station_id, bucket_id
HAVING trips_in_bucket >= 2        -- potential group ride bucket
LIMIT 20;
```

```sql
-- 5) Every trip that belongs to one of those “group‑ride” buckets
-- Description: Join back so we flag the individual rows that qualify.
WITH loops AS (
  SELECT *, FLOOR(UNIX_SECONDS(starttime)/120) AS bucket_id
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE start_station_id = end_station_id
), grp_buckets AS (
  SELECT start_station_id, bucket_id
  FROM loops
  GROUP BY start_station_id, bucket_id
  HAVING COUNT(*) >= 2
)
SELECT l.starttime, l.start_station_id
FROM loops AS l 
JOIN grp_buckets AS g
  ON l.start_station_id = g.start_station_id
 AND l.bucket_id      = g.bucket_id
LIMIT 20;
```

```sql
-- 6) Group‑ride trip counts per station
-- Description: Aggregate the qualifying trips found above.
WITH loops AS (
  SELECT *, FLOOR(UNIX_SECONDS(starttime)/120) AS bucket_id
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE start_station_id = end_station_id
), grp_buckets AS (
  SELECT start_station_id, bucket_id
  FROM loops
  GROUP BY start_station_id, bucket_id
  HAVING COUNT(*) >= 2
)
SELECT 
  l.start_station_id         AS station_id,
  COUNT(*)                   AS group_trip_count
FROM loops AS l
JOIN grp_buckets AS g
  ON l.start_station_id = g.start_station_id
 AND l.bucket_id      = g.bucket_id
GROUP BY station_id
LIMIT 20;
```

```sql
-- 7) Total trips ending at each station
-- Description: Needed for the denominator of our proportion.
SELECT 
  end_station_id AS station_id,
  COUNT(*)       AS total_end_trips
FROM `bigquery-public-data.new_york.citibike_trips`
WHERE end_station_id IS NOT NULL
GROUP BY station_id
LIMIT 20;
```

```sql
-- 8) Top 10 stations by proportion of group rides
-- Description:  Final answer – ties everything together and attaches the human‑readable station name.
WITH loops AS (
  SELECT *, FLOOR(UNIX_SECONDS(starttime)/120) AS bucket_id
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE start_station_id = end_station_id
),
grp_buckets AS (
  SELECT start_station_id, bucket_id
  FROM loops
  GROUP BY start_station_id, bucket_id
  HAVING COUNT(*) >= 2                       -- at least 2 riders within 2‑minute window
),
group_ride_trips AS (
  SELECT l.*
  FROM loops AS l
  JOIN grp_buckets AS g
    ON l.start_station_id = g.start_station_id
   AND l.bucket_id        = g.bucket_id
),
group_counts AS (
  SELECT start_station_id AS station_id,
         COUNT(*)         AS group_trip_count
  FROM group_ride_trips
  GROUP BY station_id
),
end_counts AS (
  SELECT end_station_id   AS station_id,
         COUNT(*)         AS total_end_trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE end_station_id IS NOT NULL
  GROUP BY station_id
),
proportions AS (
  SELECT 
    e.station_id,
    IFNULL(g.group_trip_count, 0)      AS group_trip_count,
    e.total_end_trips,
    IFNULL(g.group_trip_count, 0) / e.total_end_trips AS proportion
  FROM end_counts e
  LEFT JOIN group_counts g USING (station_id)
)
SELECT 
  p.station_id,
  s.name  AS station_name,
  p.group_trip_count,
  p.total_end_trips,
  p.proportion
FROM proportions AS p
LEFT JOIN `bigquery-public-data.new_york.citibike_stations` AS s
       ON p.station_id = CAST(s.station_id AS INT64)
ORDER BY p.proportion DESC
LIMIT 10;
```

