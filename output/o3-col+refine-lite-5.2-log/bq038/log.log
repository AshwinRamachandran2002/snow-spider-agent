Query:
-- 4) Bucket loop trips into 2‑minute windows
-- Description:  Create a 2‑minute bucket id and count how many trips fall in each.  
WITH loops AS (
  SELECT *, 
         FLOOR(UNIX_SECONDS(starttime)/120) AS bucket_id
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE start_station_id = end_station_id
)
SELECT 
  start_station_id,
  bucket_id,
  COUNT(*) AS trips_in_bucket
FROM loops
GROUP BY start_station_id, bucket_id
HAVING trips_in_bucket >= 2        -- potential group ride bucket
LIMIT 20;
