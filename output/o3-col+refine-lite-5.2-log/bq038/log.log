```sql
--Description:
-- THINKING PROCESS (inline):  
-- ① Identify “loop” trips (start_station_id = end_station_id).  
-- ② Put each loop trip in a 2‑minute bucket:  FLOOR(UNIX_SECONDS(starttime)/120).  
-- ③ A bucket is a “group‑ride window” if ≥2 loop trips share that bucket & station.  
-- ④ Every trip inside such a bucket is a “group‑ride trip”.  
-- ⑤ Count group‑ride trips per station  →  numerator.  
-- ⑥ Count ALL trips that END at each station (even non‑loop) →  denominator.  
-- ⑦ proportion = numerator / denominator.  
-- ⑧ Join to citibike_stations for a human‑readable name (using SAFE_CAST to avoid
--    failures when the stations lookup has non‑numeric IDs).  
-- ⑨ Sort by proportion DESC and return the top 10.  

WITH loops AS (                                   -- ① & ②
  SELECT
    *,
    FLOOR(UNIX_SECONDS(starttime) / 120) AS bucket_id
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE start_station_id = end_station_id
),
grp_buckets AS (                                  -- ③
  SELECT
    start_station_id,
    bucket_id
  FROM loops
  GROUP BY start_station_id, bucket_id
  HAVING COUNT(*) >= 2
),
group_ride_trips AS (                              -- ④
  SELECT l.*
  FROM loops           AS l
  JOIN grp_buckets     AS g
    ON l.start_station_id = g.start_station_id
   AND l.bucket_id        = g.bucket_id
),
group_counts AS (                                  -- ⑤
  SELECT
    start_station_id AS station_id,
    COUNT(*)         AS group_trip_count
  FROM group_ride_trips
  GROUP BY station_id
),
end_counts AS (                                    -- ⑥
  SELECT
    end_station_id   AS station_id,
    COUNT(*)         AS total_end_trips
  FROM `bigquery-public-data.new_york.citibike_trips`
  WHERE end_station_id IS NOT NULL
  GROUP BY station_id
),
proportions AS (                                   -- ⑦
  SELECT
    e.station_id,
    COALESCE(g.group_trip_count, 0)                         AS group_trip_count,
    e.total_end_trips,
    COALESCE(g.group_trip_count, 0) / e.total_end_trips     AS proportion
  FROM end_counts AS e
  LEFT JOIN group_counts AS g USING (station_id)
)
SELECT                                            -- ⑧ & ⑨
  p.station_id,
  s.name                     AS station_name,
  p.group_trip_count,
  p.total_end_trips,
  p.proportion
FROM proportions AS p
LEFT JOIN (
  SELECT
    SAFE_CAST(station_id AS INT64) AS station_id_num,
    name
  FROM `bigquery-public-data.new_york.citibike_stations`
) AS s
  ON p.station_id = s.station_id_num
ORDER BY p.proportion DESC
LIMIT 10;
