-- 9)  Build a combined RFM segment label and count customers per segment
WITH seg AS (
     /* reuse the segmentation logic from query #8 */
     WITH delivered   AS (
          SELECT  "customer_id", 
                  date("order_purchase_timestamp") AS "pdate",
                  "order_id"
          FROM    "orders"
          WHERE   "order_status" = 'delivered'),
     last_date AS (SELECT MAX("pdate") AS max_ts FROM delivered),
     rfm AS (
          SELECT  d."customer_id",
                  ROUND(julianday( (SELECT max_ts FROM last_date)) - julianday(MAX(d."pdate")),0) AS R,
                  COUNT(*)                                                                    AS F,
                  SUM(oi."price" + oi."freight_value")                                        AS M
          FROM   delivered d
          JOIN   "order_items" oi ON oi."order_id" = d."order_id"
          GROUP  BY d."customer_id")
     SELECT  "customer_id",
             CASE WHEN R<=30  THEN 'R1' WHEN R<=90 THEN 'R2' ELSE 'R3' END ||
             CASE WHEN F>=5   THEN 'F1' WHEN F>=2 THEN 'F2' ELSE 'F3' END ||
             CASE WHEN (M/F)>=150 THEN 'M1' WHEN (M/F)>=50 THEN 'M2' ELSE 'M3' END AS "RFM_seg",
             M, F
     FROM    rfm)
SELECT  "RFM_seg",
        COUNT(*) AS "n_customers"
FROM    seg
GROUP BY "RFM_seg"
ORDER BY "n_customers" DESC
LIMIT 20;
