Query:
-- 7)  Attach R, F and M raw measures to every customer
WITH delivered   AS (
     SELECT  "customer_id", 
             date("order_purchase_timestamp") AS "pdate",
             "order_id"
     FROM    "orders"
     WHERE   "order_status" = 'delivered'),
last_date AS (
     SELECT MAX("pdate") AS max_ts FROM delivered),
monetary  AS (
     SELECT  d."customer_id",
             COUNT(*)                       AS F,
             SUM(oi."price" + oi."freight_value") AS M,
             MAX(d."pdate")                 AS last_purchase
     FROM    delivered d
     JOIN    "order_items" oi ON oi."order_id" = d."order_id"
     GROUP BY d."customer_id")
SELECT  m."customer_id",
        ROUND(julianday( (SELECT max_ts FROM last_date)) - 
              julianday(m."last_purchase"),0)       AS R,
        m.F,
        ROUND(m.M,2)                                 AS M
FROM    monetary m
LIMIT 20;
