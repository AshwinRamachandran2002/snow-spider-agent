Query:
-- 6)  Compute Recency (days since last delivered purchase) for each customer
WITH last_date AS (
     SELECT MAX(date("order_purchase_timestamp")) AS max_ts
     FROM   "orders"
     WHERE  "order_status" = 'delivered')
SELECT  o."customer_id",
        ROUND(julianday( (SELECT max_ts FROM last_date) ) - 
              julianday( MAX(date(o."order_purchase_timestamp")) ),0) AS "recency_days"
FROM    "orders" AS o
WHERE   o."order_status" = 'delivered'
GROUP BY o."customer_id"
LIMIT 20;
