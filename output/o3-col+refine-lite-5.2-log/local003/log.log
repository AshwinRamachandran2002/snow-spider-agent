```sql
-- 4)  Compute the monetary value of each delivered order
SELECT  oi."order_id",
        ROUND(SUM(oi."price" + oi."freight_value"),2) AS "order_value"
FROM    "order_items"  AS oi
JOIN    "orders"       AS o  ON o."order_id" = oi."order_id"
WHERE   o."order_status" = 'delivered'
GROUP BY oi."order_id"
LIMIT 20;
```

```sql
-- 5)  Aggregate delivered orders per customer: #orders and total spend
SELECT  o."customer_id",
        COUNT(*)                                     AS "orders_qty",
        ROUND(SUM(oi."price" + oi."freight_value"),2) AS "total_spend"
FROM    "orders"       AS o
JOIN    "order_items"  AS oi ON oi."order_id" = o."order_id"
WHERE   o."order_status" = 'delivered'
GROUP BY o."customer_id"
LIMIT 20;
```

```sql
-- 6)  Compute Recency (days since last delivered purchase) for each customer
WITH last_date AS (
     SELECT MAX(date("order_purchase_timestamp")) AS max_ts
     FROM   "orders"
     WHERE  "order_status" = 'delivered')
SELECT  o."customer_id",
        ROUND(julianday( (SELECT max_ts FROM last_date) ) - 
              julianday( MAX(date(o."order_purchase_timestamp")) ),0) AS "recency_days"
FROM    "orders" AS o
WHERE   o."order_status" = 'delivered'
GROUP BY o."customer_id"
LIMIT 20;
```

```sql
-- 7)  Attach R, F and M raw measures to every customer
WITH delivered   AS (
     SELECT  "customer_id", 
             date("order_purchase_timestamp") AS "pdate",
             "order_id"
     FROM    "orders"
     WHERE   "order_status" = 'delivered'),
last_date AS (
     SELECT MAX("pdate") AS max_ts FROM delivered),
monetary  AS (
     SELECT  d."customer_id",
             COUNT(*)                       AS F,
             SUM(oi."price" + oi."freight_value") AS M,
             MAX(d."pdate")                 AS last_purchase
     FROM    delivered d
     JOIN    "order_items" oi ON oi."order_id" = d."order_id"
     GROUP BY d."customer_id")
SELECT  m."customer_id",
        ROUND(julianday( (SELECT max_ts FROM last_date)) - 
              julianday(m."last_purchase"),0)       AS R,
        m.F,
        ROUND(m.M,2)                                 AS M
FROM    monetary m
LIMIT 20;
```

```sql
-- 8)  Categorise each customer into simple 3‑level buckets for R, F and M
WITH rfm AS (
     /* --- build raw R,F,M exactly as in query #7 --- */
     WITH delivered   AS (
          SELECT  "customer_id", 
                  date("order_purchase_timestamp") AS "pdate",
                  "order_id"
          FROM    "orders"
          WHERE   "order_status" = 'delivered'),
     last_date AS (SELECT MAX("pdate") AS max_ts FROM delivered),
     base AS (
          SELECT  d."customer_id",
                  COUNT(*)                       AS F,
                  SUM(oi."price" + oi."freight_value") AS M,
                  MAX(d."pdate")                 AS last_purchase
          FROM    delivered d
          JOIN    "order_items" oi ON oi."order_id" = d."order_id"
          GROUP BY d."customer_id")
     SELECT  b."customer_id",
             ROUND(julianday( (SELECT max_ts FROM last_date)) - 
                   julianday(b."last_purchase"),0) AS R,
             b.F,
             b.M
     FROM    base b)
SELECT  rfm."customer_id",
        /* --- Recency segment --- */
        CASE 
             WHEN rfm.R <= 30  THEN 'R1_<=30d'
             WHEN rfm.R <= 90  THEN 'R2_31‑90d'
             ELSE                   'R3_>90d'
        END                                   AS "R_seg",
        /* --- Frequency segment --- */
        CASE 
             WHEN rfm.F >= 5  THEN 'F1_>=5'
             WHEN rfm.F >= 2  THEN 'F2_2‑4'
             ELSE                  'F3_1'
        END                                   AS "F_seg",
        /* --- Monetary segment --- */
        CASE 
             WHEN (rfm.M/rfm.F) >= 150 THEN 'M1_>=150'
             WHEN (rfm.M/rfm.F) >= 50  THEN 'M2_50‑149'
             ELSE                            'M3_<50'
        END                                   AS "M_seg"
FROM   rfm
LIMIT 20;
```

```sql
-- 9)  Build a combined RFM segment label and count customers per segment
WITH seg AS (
     /* reuse the segmentation logic from query #8 */
     WITH delivered   AS (
          SELECT  "customer_id", 
                  date("order_purchase_timestamp") AS "pdate",
                  "order_id"
          FROM    "orders"
          WHERE   "order_status" = 'delivered'),
     last_date AS (SELECT MAX("pdate") AS max_ts FROM delivered),
     rfm AS (
          SELECT  d."customer_id",
                  ROUND(julianday( (SELECT max_ts FROM last_date)) - julianday(MAX(d."pdate")),0) AS R,
                  COUNT(*)                                                                    AS F,
                  SUM(oi."price" + oi."freight_value")                                        AS M
          FROM   delivered d
          JOIN   "order_items" oi ON oi."order_id" = d."order_id"
          GROUP  BY d."customer_id")
     SELECT  "customer_id",
             CASE WHEN R<=30  THEN 'R1' WHEN R<=90 THEN 'R2' ELSE 'R3' END ||
             CASE WHEN F>=5   THEN 'F1' WHEN F>=2 THEN 'F2' ELSE 'F3' END ||
             CASE WHEN (M/F)>=150 THEN 'M1' WHEN (M/F)>=50 THEN 'M2' ELSE 'M3' END AS "RFM_seg",
             M, F
     FROM    rfm)
SELECT  "RFM_seg",
        COUNT(*) AS "n_customers"
FROM    seg
GROUP BY "RFM_seg"
ORDER BY "n_customers" DESC
LIMIT 20;
```

```sql
-- 10)  FINAL – average sales per order inside each RFM segment
WITH delivered   AS (
     SELECT  o."customer_id", 
             date(o."order_purchase_timestamp") AS "pdate",
             o."order_id"
     FROM    "orders" o
     WHERE   o."order_status" = 'delivered'),
last_date AS (SELECT MAX("pdate") AS max_ts FROM delivered),
rfm_base AS (
     SELECT  d."customer_id",
             ROUND(julianday( (SELECT max_ts FROM last_date)) - julianday(MAX(d."pdate")),0) AS R,
             COUNT(*)                                                                    AS F,
             SUM(oi."price" + oi."freight_value")                                        AS M
     FROM   delivered d
     JOIN   "order_items" oi ON oi."order_id" = d."order_id"
     GROUP  BY d."customer_id"),
rfm_seg  AS (
     SELECT  "customer_id",
             CASE WHEN R<=30  THEN 'R1' WHEN R<=90 THEN 'R2' ELSE 'R3' END ||
             CASE WHEN F>=5   THEN 'F1' WHEN F>=2 THEN 'F2' ELSE 'F3' END ||
             CASE WHEN (M/F)>=150 THEN 'M1' WHEN (M/F)>=50 THEN 'M2' ELSE 'M3' END AS "RFM_seg",
             M, F
     FROM    rfm_base)
SELECT  "RFM_seg",
        ROUND( SUM(M) / SUM(F) ,2) AS "avg_sales_per_order"
FROM    rfm_seg
GROUP BY "RFM_seg"
ORDER BY "avg_sales_per_order" DESC
LIMIT 20;
```

Explanation of Recency & RFM segmentation (used above)
• Recency (R) = days between a customer’s most‑recent delivered purchase and the latest delivered purchase found in the dataset.  
• Frequency (F) = number of delivered orders made by the customer.  
• Monetary (M) = total BRL spent by the customer on delivered orders (price + freight).  

Segment buckets adopted:
• R:  ≤30 days (“R1”), 31‑90 days (“R2”),  >90 days (“R3”)  
• F:  ≥5 orders (“F1”), 2‑4 orders (“F2”), 1 order (“F3”)  
• M (average ticket = M/F): ≥150 BRL (“M1”), 50‑149 BRL (“M2”), <50 BRL (“M3”)  

The last query provides, for each combined RFM segment, the average sales per order (Total Spend ÷ Total Orders) so differences across segments can be analysed.
