  AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
LIMIT 20;
```

```sql
-- Description: 2) Extract the first Stack Overflow question‑id that appears in each
--               matching comment, just to make sure the regexp works.
SELECT
  id,
  REGEXP_EXTRACT(LOWER(text), r'stackoverflow\.com/questions/([0-9]+)') AS question_id,
  text
FROM `fh-bigquery.hackernews.full_partition_extra`
WHERE type = 'comment'
  AND time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
  AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
LIMIT 20;
```

```sql
-- Description: 3) Count how often every individual Stack Overflow question is
--               mentioned inside HN comments (2014+).
SELECT
  question_id,
  COUNT(*) AS mention_cnt
FROM (
  SELECT REGEXP_EXTRACT(LOWER(text), r'stackoverflow\.com/questions/([0-9]+)') AS question_id
  FROM `fh-bigquery.hackernews.full_partition_extra`
  WHERE type = 'comment'
    AND time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
)
GROUP BY question_id
ORDER BY mention_cnt DESC
LIMIT 20;
```

```sql
-- Description: 4) Inspect the “tags” field for the same set of comments to see
--               what it looks like when Stack Overflow links are present.
SELECT
  id,
  REGEXP_EXTRACT(LOWER(text), r'stackoverflow\.com/questions/([0-9]+)') AS question_id,
  tags
FROM `fh-bigquery.hackernews.full_partition_extra`
WHERE type = 'comment'
  AND time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
  AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  AND tags IS NOT NULL
LIMIT 20;
```

```sql
-- Description: 5) Show only those rows where the tags string is non‑empty and
--               demonstrate the “|” delimiter that separates individual tags.
SELECT
  tags
FROM `fh-bigquery.hackernews.full_partition_extra`
WHERE type = 'comment'
  AND time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
  AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  AND tags IS NOT NULL
  AND LENGTH(tags) > 0
LIMIT 20;
```

```sql
-- Description: 6) Split the pipe‑delimited tag string into individual tag
--               elements for one comment, confirming that the split works.
SELECT
  id,
  REGEXP_EXTRACT(LOWER(text), r'stackoverflow\.com/questions/([0-9]+)') AS question_id,
  tag
FROM `fh-bigquery.hackernews.full_partition_extra`,
UNNEST(SPLIT(tags, '|')) AS tag
WHERE type = 'comment'
  AND time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
  AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
  AND tags IS NOT NULL
LIMIT 20;
```

```sql
-- Description: 7) For every Stack Overflow question‑id, collect ONE canonical
--               tag string (ANY_VALUE) so we can later link mentions to tags.
WITH comment_data AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text), r'stackoverflow\.com/questions/([0-9]+)')
      AS question_id,
    tags
  FROM `fh-bigquery.hackernews.full_partition_extra`
  WHERE type = 'comment'
    AND time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
    AND tags IS NOT NULL
)
SELECT
  question_id,
  ANY_VALUE(tags) AS tag_string_sample
FROM comment_data
GROUP BY question_id
LIMIT 20;
```

```sql
-- Description: 8) Determine how many Hacker News comments reference each
--               Stack Overflow question (2014+).  This CTE will feed the final
--               tag‑level roll‑up.
WITH mentions AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text), r'stackoverflow\.com/questions/([0-9]+)') AS question_id
  FROM `fh-bigquery.hackernews.full_partition_extra`
  WHERE type = 'comment'
    AND time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
)
SELECT
  question_id,
  COUNT(*) AS mention_cnt
FROM mentions
GROUP BY question_id
ORDER BY mention_cnt DESC
LIMIT 20;
```

```sql
-- Description: 9) Join the per‑question mention counts with their tag strings,
--               explode the “|”‑delimited tags, and aggregate the total number
--               of mentions attributed to each tag.
WITH comment_data AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text), r'stackoverflow\.com/questions/([0-9]+)') AS qid,
    tags
  FROM `fh-bigquery.hackernews.full_partition_extra`
  WHERE type = 'comment'
    AND time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
    AND tags IS NOT NULL
),
question_counts AS (
  SELECT
    qid AS question_id,
    COUNT(*) AS mention_cnt
  FROM comment_data
  GROUP BY question_id
),
question_tags AS (
  SELECT
    qid AS question_id,
    ANY_VALUE(tags) AS tag_string
  FROM comment_data
  GROUP BY question_id
)
SELECT
  tag,
  SUM(mention_cnt) AS total_mentions
FROM question_counts qc
JOIN question_tags qt
  USING (question_id),
UNNEST(SPLIT(qt.tag_string, '|')) AS tag
GROUP BY tag
ORDER BY total_mentions DESC
LIMIT 20;
```

```sql
-- Description: 10) Final answer — the Top‑10 Stack Overflow tags most frequently
--                referenced (weighted by the number of Hacker News comments that
--                linked to each underlying question) for the 2014‑present period.
WITH comment_data AS (
  SELECT
    REGEXP_EXTRACT(LOWER(text), r'stackoverflow\.com/questions/([0-9]+)') AS qid,
    tags
  FROM `fh-bigquery.hackernews.full_partition_extra`
  WHERE type = 'comment'
    AND time >= UNIX_SECONDS(TIMESTAMP '2014-01-01')
    AND LOWER(text) LIKE '%stackoverflow.com/questions/%'
    AND tags IS NOT NULL
),
question_counts AS (
  SELECT
    qid AS question_id,
    COUNT(*) AS mention_cnt
  FROM comment_data
  GROUP BY question_id
),
question_tags AS (
  SELECT
    qid AS question_id,
    ANY_VALUE(tags) AS tag_string
  FROM comment_data
  GROUP BY question_id
),
tag_rollup AS (
  SELECT
    tag,
    SUM(mention_cnt) AS total_mentions
  FROM question_counts qc
  JOIN question_tags qt USING (question_id),
  UNNEST(SPLIT(qt.tag_string, '|')) AS tag
  GROUP BY tag
)
SELECT
  tag,
  total_mentions
FROM tag_rollup
ORDER BY total_mentions DESC
LIMIT 20;   -- top 10 tags will appear within these 20 rows
```

