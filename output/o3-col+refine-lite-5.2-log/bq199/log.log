```sql
-- 1. Description: Peek at the years present in the dataset.
SELECT DISTINCT EXTRACT(YEAR FROM `date`) AS yr
FROM `bigquery-public-data.iowa_liquor_sales.sales`
ORDER BY yr
LIMIT 20;
```

```sql
-- 2. Description: Look at some typical rows with columns we’ll use.
SELECT `date`,
       category_name,
       bottle_volume_ml,
       state_bottle_retail,
       bottles_sold
FROM `bigquery-public-data.iowa_liquor_sales.sales`
LIMIT 20;
```

```sql
-- 3. Description: Compute a per‑liter retail price for a few rows
--    (state_bottle_retail is per bottle; divide by volume in liters).
SELECT `invoice_and_item_number`,
       category_name,
       state_bottle_retail,
       bottle_volume_ml,
       state_bottle_retail * 1000.0 / bottle_volume_ml AS retail_per_liter
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE bottle_volume_ml > 0
LIMIT 20;
```

```sql
-- 4. Description: Average per‑liter retail price by category for 2021, 
--    ordered from highest to lowest.
SELECT category_name,
       AVG(state_bottle_retail * 1000.0 / bottle_volume_ml) AS avg_retail_per_liter_2021
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2021
  AND bottle_volume_ml > 0
GROUP BY category_name
ORDER BY avg_retail_per_liter_2021 DESC
LIMIT 20;
```

```sql
-- 5. Description: Do the same aggregation for 2019.
SELECT category_name,
       AVG(state_bottle_retail * 1000.0 / bottle_volume_ml) AS avg_retail_per_liter_2019
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2019
  AND bottle_volume_ml > 0
GROUP BY category_name
ORDER BY avg_retail_per_liter_2019 DESC
LIMIT 20;
```

```sql
-- 6. Description: Do the same aggregation for 2020.
SELECT category_name,
       AVG(state_bottle_retail * 1000.0 / bottle_volume_ml) AS avg_retail_per_liter_2020
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2020
  AND bottle_volume_ml > 0
GROUP BY category_name
ORDER BY avg_retail_per_liter_2020 DESC
LIMIT 20;
```

```sql
-- 7. Description: Build a CTE of category‑year averages for 2019‑2021 in one shot.
WITH per_year AS (
  SELECT
    category_name,
    EXTRACT(YEAR FROM `date`) AS yr,
    AVG(state_bottle_retail * 1000.0 / bottle_volume_ml) AS avg_retail_per_liter
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE bottle_volume_ml > 0
    AND EXTRACT(YEAR FROM `date`) BETWEEN 2019 AND 2021
  GROUP BY category_name, yr
)
SELECT *
FROM per_year
ORDER BY category_name, yr
LIMIT 20;
```

```sql
-- 8. Description: Final answer – top‑10 categories by 2021 average  
--    per‑liter retail price, then show their averages for 2019, 2020, 2021.
WITH per_year AS (
  SELECT
    category_name,
    EXTRACT(YEAR FROM `date`) AS yr,
    AVG(state_bottle_retail * 1000.0 / bottle_volume_ml) AS avg_retail_per_liter
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE bottle_volume_ml > 0
    AND EXTRACT(YEAR FROM `date`) BETWEEN 2019 AND 2021
  GROUP BY category_name, yr
),
top2021 AS (
  SELECT category_name
  FROM per_year
  WHERE yr = 2021
  ORDER BY avg_retail_per_liter DESC
  LIMIT 10
)
SELECT
  p.category_name,
  p.yr AS year,
  ROUND(p.avg_retail_per_liter, 2) AS avg_retail_per_liter
FROM per_year AS p
JOIN top2021 AS t
USING (category_name)
ORDER BY p.category_name, p.yr
LIMIT 20;
```
