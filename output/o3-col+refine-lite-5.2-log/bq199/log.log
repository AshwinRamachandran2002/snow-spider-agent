-- 7. Description: Build a CTE of category‑year averages for 2019‑2021 in one shot.
WITH per_year AS (
  SELECT
    category_name,
    EXTRACT(YEAR FROM `date`) AS yr,
    AVG(state_bottle_retail * 1000.0 / bottle_volume_ml) AS avg_retail_per_liter
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE bottle_volume_ml > 0
    AND EXTRACT(YEAR FROM `date`) BETWEEN 2019 AND 2021
  GROUP BY category_name, yr
)
SELECT *
FROM per_year
ORDER BY category_name, yr
LIMIT 20;
