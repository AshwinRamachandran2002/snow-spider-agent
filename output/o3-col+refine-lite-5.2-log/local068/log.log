-- Description: 3)  Count cities inserted per YEAR‑MONTH (only Apr, May, Jun)
--               so we know the monthly totals that will later feed growth
--               calculations.
SELECT
       substr("insert_date", 1, 4)       AS "year",
       substr("insert_date", 6, 2)       AS "month",
       COUNT(*)                          AS "monthly_total"
FROM   "cities"
WHERE  substr("insert_date", 6, 2) IN ('04','05','06')
  AND  substr("insert_date", 1, 4) BETWEEN '2021' AND '2023'
GROUP  BY "year","month"
ORDER  BY "year","month"
LIMIT  20;
