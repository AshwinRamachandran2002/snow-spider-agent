FROM   "cities"
WHERE  substr("insert_date", 6, 2) = '05'
  AND  substr("insert_date", 1, 4) BETWEEN '2021' AND '2023'
GROUP  BY "year"
ORDER  BY "year"
LIMIT  20;
```

```sql
-- Description: 6)  Zoom in on JUNE only – yearly totals 2021‑2023.
SELECT
       substr("insert_date", 1, 4) AS "year",
       COUNT(*)                    AS "june_total"
FROM   "cities"
WHERE  substr("insert_date", 6, 2) = '06'
  AND  substr("insert_date", 1, 4) BETWEEN '2021' AND '2023'
GROUP  BY "year"
ORDER  BY "year"
LIMIT  20;
```

```sql
-- Description: 7)  Produce both the monthly total and its cumulative running
--               total across the years (window SUM) for Apr‑Jun.
SELECT
       substr("insert_date", 1, 4)                      AS "year",
       substr("insert_date", 6, 2)                      AS "month",
       COUNT(*)                                         AS "monthly_total",
       SUM(COUNT(*)) OVER (PARTITION BY substr("insert_date", 6, 2)
                           ORDER BY substr("insert_date", 1, 4)) 
                                                         AS "running_total"
FROM   "cities"
WHERE  substr("insert_date", 6, 2) IN ('04','05','06')
  AND  substr("insert_date", 1, 4) BETWEEN '2021' AND '2023'
GROUP  BY "year","month"
ORDER  BY "month","year"
LIMIT  20;
```

```sql
-- Description: 8)  Full analytic query that also computes the year‑over‑year
--               growth rates for both monthly_total and running_total, but
--               still shows 2021‑2023 so we can later filter out 2021.
SELECT
       "year",
       CASE "month"
           WHEN '04' THEN 'April'
           WHEN '05' THEN 'May'
           WHEN '06' THEN 'June'
       END                                           AS "month_name",
       "monthly_total",
       "running_total",
       ROUND(100.0 * ("monthly_total" - LAG("monthly_total")
                      OVER (PARTITION BY "month" ORDER BY "year"))
             / NULLIF(LAG("monthly_total")
                      OVER (PARTITION BY "month" ORDER BY "year"),0), 2)
                                                    AS "YoY_monthly_growth_pct",
       ROUND(100.0 * ("running_total" - LAG("running_total")
                      OVER (PARTITION BY "month" ORDER BY "year"))
             / NULLIF(LAG("running_total")
                      OVER (PARTITION BY "month" ORDER BY "year"),0), 2)
                                                    AS "YoY_running_growth_pct"
FROM (
       SELECT
              substr("insert_date", 1, 4)       AS "year",
              substr("insert_date", 6, 2)       AS "month",
              COUNT(*)                          AS "monthly_total",
              SUM(COUNT(*)) OVER (PARTITION BY substr("insert_date", 6, 2)
                                  ORDER BY substr("insert_date", 1, 4))
                                               AS "running_total"
       FROM   "cities"
       WHERE  substr("insert_date", 6, 2) IN ('04','05','06')
         AND  substr("insert_date", 1, 4) BETWEEN '2021' AND '2023'
       GROUP  BY "year","month"
)
ORDER BY "month","year"
LIMIT  20;
```
