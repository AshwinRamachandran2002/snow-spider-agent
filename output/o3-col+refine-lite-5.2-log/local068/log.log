Query:
-- Description: 7)  Produce both the monthly total and its cumulative running
--               total across the years (window SUM) for Apr‑Jun.
SELECT
       substr("insert_date", 1, 4)                      AS "year",
       substr("insert_date", 6, 2)                      AS "month",
       COUNT(*)                                         AS "monthly_total",
       SUM(COUNT(*)) OVER (PARTITION BY substr("insert_date", 6, 2)
                           ORDER BY substr("insert_date", 1, 4)) 
                                                         AS "running_total"
FROM   "cities"
WHERE  substr("insert_date", 6, 2) IN ('04','05','06')
  AND  substr("insert_date", 1, 4) BETWEEN '2021' AND '2023'
GROUP  BY "year","month"
ORDER  BY "month","year"
LIMIT  20;
Answer:
