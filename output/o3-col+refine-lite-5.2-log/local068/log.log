WITH monthly AS (        -- 1. cities added each Apr/May/Jun by year
    SELECT
        substr("insert_date",1,4) AS "year",
        substr("insert_date",6,2) AS "month",
        COUNT(*)                  AS "monthly_total"
    FROM   "cities"
    WHERE  substr("insert_date",6,2) IN ('04','05','06')
      AND  substr("insert_date",1,4) BETWEEN '2021' AND '2023'
    GROUP  BY "year","month"
),
running AS (             -- 2. cumulative total for that month across years
    SELECT
        "year",
        "month",
        "monthly_total",
        SUM("monthly_total") OVER (PARTITION BY "month"
                                   ORDER BY "year")      AS "running_total"
    FROM   monthly
),
growth AS (              -- 3. year‑over‑year growth calculations
    SELECT
        "year",
        "month",
        "monthly_total",
        "running_total",
        ROUND(
            100.0 * ("monthly_total" - LAG("monthly_total")
                     OVER (PARTITION BY "month" ORDER BY "year"))
            / NULLIF(LAG("monthly_total")
                     OVER (PARTITION BY "month" ORDER BY "year"),0), 2
        ) AS "yoy_monthly_growth_pct",
        ROUND(
            100.0 * ("running_total" - LAG("running_total")
                     OVER (PARTITION BY "month" ORDER BY "year"))
            / NULLIF(LAG("running_total")
                     OVER (PARTITION BY "month" ORDER BY "year"),0), 2
        ) AS "yoy_running_growth_pct"
    FROM   running
)
SELECT
    "year",
    CASE "month"
        WHEN '04' THEN 'April'
        WHEN '05' THEN 'May'
        WHEN '06' THEN 'June'
    END                                        AS "month_name",
    "monthly_total",
    "running_total",
    "yoy_monthly_growth_pct",
    "yoy_running_growth_pct"
FROM   growth
WHERE  "year" IN ('2022','2023')               -- 4. final output only 2022‑2023
ORDER  BY "month","year";
