```sql
-- Description: 1)  Get a quick look at the distinct years that appear in the
--               “insert_date” column of cities (limit 20 just for inspection).
SELECT DISTINCT 
       substr("insert_date", 1, 4)  AS "year"
FROM   "cities"
WHERE  "insert_date" IS NOT NULL
LIMIT  20;
```

```sql
-- Description: 2)  Retrieve a sample of distinct raw “insert_date” values
--               that fall in April‑June of any year (2021‑2023 timeframe).
SELECT DISTINCT
       "insert_date"
FROM   "cities"
WHERE  substr("insert_date", 6, 2) IN ('04','05','06')
  AND  substr("insert_date", 1, 4) BETWEEN '2021' AND '2023'
LIMIT  20;
```

```sql
-- Description: 3)  Count cities inserted per YEAR‑MONTH (only Apr, May, Jun)
--               so we know the monthly totals that will later feed growth
--               calculations.
SELECT
       substr("insert_date", 1, 4)       AS "year",
       substr("insert_date", 6, 2)       AS "month",
       COUNT(*)                          AS "monthly_total"
FROM   "cities"
WHERE  substr("insert_date", 6, 2) IN ('04','05','06')
  AND  substr("insert_date", 1, 4) BETWEEN '2021' AND '2023'
GROUP  BY "year","month"
ORDER  BY "year","month"
LIMIT  20;
```

```sql
-- Description: 4)  Zoom in on APRIL only – yearly totals 2021‑2023.
SELECT
       substr("insert_date", 1, 4) AS "year",
       COUNT(*)                    AS "april_total"
FROM   "cities"
WHERE  substr("insert_date", 6, 2) = '04'
  AND  substr("insert_date", 1, 4) BETWEEN '2021' AND '2023'
GROUP  BY "year"
ORDER  BY "year"
LIMIT  20;
```

```sql
-- Description: 5)  Zoom in on MAY only – yearly totals 2021‑2023.
SELECT
       substr("insert_date", 1, 4) AS "year",
