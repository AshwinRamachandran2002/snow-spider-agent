```sql
--Description: Retrieve a sample of distinct Ethereum addresses that initiated transactions before 01‑Jan‑2017
SELECT DISTINCT "from_address" AS "address"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
WHERE "block_timestamp" < 1483228800000000
LIMIT 20;
```

```sql
--Description: Inspect representative traces (excluding delegatecall / callcode / staticcall) that occurred before 01‑Jan‑2017
SELECT "from_address",
       "to_address",
       "value",
       "call_type",
       "trace_type",
       "status",
       "block_timestamp"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "block_timestamp" < 1483228800000000
  AND ("call_type" IS NULL OR "call_type" NOT IN ('delegatecall','callcode','staticcall'))
LIMIT 20;
```

```sql
--Description: View early mining‑reward traces to understand reward distribution pre‑2017
SELECT "to_address"   AS "miner",
       "value",
       "reward_type",
       "block_timestamp"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "trace_type" = 'reward'
  AND "block_timestamp" < 1483228800000000
LIMIT 20;
```

```sql
--Description: Sample ERC‑20 token transfers that happened before 01‑Jan‑2017
SELECT "token_address",
       "from_address",
       "to_address",
       "value",
       "block_timestamp"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
WHERE "block_timestamp" < 1483228800000000
LIMIT 20;
```

```sql
--Description: Examine contracts created prior to 2017 with a preview of their bytecode
SELECT "address",
       LEFT("bytecode",60) AS "bytecode_preview",
       "block_number",
       "block_timestamp"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.CONTRACTS
WHERE "block_timestamp" < 1483228800000000
LIMIT 20;
```

```sql
--Description: List failed transactions (receipt_status = 0) occurring before 01‑Jan‑2017
SELECT "hash",
       "from_address",
       "to_address",
       "gas",
       "receipt_gas_used",
       "receipt_status",
       "block_timestamp"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
WHERE "block_timestamp" < 1483228800000000
  AND "receipt_status" = 0
LIMIT 20;
```

```sql
--Description: Pull sample blocks earlier than 2017 with basic activity metrics
SELECT "number",
       "hash",
       "miner",
       "timestamp",
       "transaction_count"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.BLOCKS
WHERE "timestamp" < 1483228800000000
ORDER BY "timestamp" DESC
LIMIT 20;
```

```sql
--Description: Compute average and standard deviation of gas used in incoming 'call' traces per recipient address (pre‑2017)
SELECT "to_address"                       AS "address",
       AVG("gas_used")                    AS "avg_gas_used",
       STDDEV_SAMP("gas_used")            AS "std_gas_used",
       COUNT(*)                           AS "trace_count"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "trace_type" = 'call'
  AND "block_timestamp" < 1483228800000000
GROUP BY "to_address"
LIMIT 20;
```

```sql
--Description: Count how many contracts each address created before 2017
SELECT "from_address"                     AS "creator_address",
       COUNT(*)                           AS "contract_create_count"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE "trace_type" = 'create'
  AND "block_timestamp" < 1483228800000000
GROUP BY "from_address"
LIMIT 20;
```

```sql
--Description: Summarise incoming and outgoing token‑transfer counts per address (sample of 20 addresses, pre‑2017)
SELECT "address",
       SUM(CASE WHEN "direction" = 'in'  THEN 1 ELSE 0 END) AS "token_in_tnx",
       SUM(CASE WHEN "direction" = 'out' THEN 1 ELSE 0 END) AS "token_out_tnx"
FROM (
    SELECT "to_address"   AS "address", 'in'  AS "direction"
    FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
    WHERE  "block_timestamp" < 1483228800000000
    UNION ALL
    SELECT "from_address" AS "address", 'out' AS "direction"
    FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
    WHERE  "block_timestamp" < 1483228800000000
) t
GROUP BY "address"
LIMIT 20;
```
