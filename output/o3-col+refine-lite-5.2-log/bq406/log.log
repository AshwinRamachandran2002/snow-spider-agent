```sql
--Description: Put 2014 & 2024 rows side‑by‑side so the raw numbers for the two years are in one record
SELECT
  'overall'                                         AS workforce,
  t14.report_year                                   AS year_2014,
  t24.report_year                                   AS year_2024,
  t14.race_asian            AS asian_2014,          t24.race_asian            AS asian_2024,
  t14.race_black            AS black_2014,          t24.race_black            AS black_2024,
  t14.race_hispanic_latinx  AS latinx_2014,         t24.race_hispanic_latinx  AS latinx_2024,
  t14.race_native_american  AS native_2014,         t24.race_native_american  AS native_2024,
  t14.race_white            AS white_2014,          t24.race_white            AS white_2024,
  t14.gender_us_women       AS us_women_2014,       t24.gender_us_women       AS us_women_2024,
  t14.gender_us_men         AS us_men_2014,         t24.gender_us_men         AS us_men_2024,
  t14.gender_global_women   AS g_women_2014,        t24.gender_global_women   AS g_women_2024,
  t14.gender_global_men     AS g_men_2014,          t24.gender_global_men     AS g_men_2024
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation` t14
JOIN `bigquery-public-data.google_dei.dar_non_intersectional_representation` t24
  ON t14.workforce = t24.workforce
WHERE t14.workforce = 'overall'
  AND t14.report_year = 2014
  AND t24.report_year = 2024;
