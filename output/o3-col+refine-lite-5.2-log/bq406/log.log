```sql
--Description: Calculate the 2014‑to‑2024 growth rate for every demographic in one step
WITH yr AS (
  SELECT
    report_year,
    race_asian            AS asian,
    race_black            AS black,
    race_hispanic_latinx  AS latinx,
    race_native_american  AS native,
    race_white            AS white,
    gender_us_women       AS us_women,
    gender_us_men         AS us_men,
    gender_global_women   AS g_women,
    gender_global_men     AS g_men
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
    AND report_year IN (2014, 2024)
)
SELECT
  2014 AS base_year,
  2024 AS latest_year,
  ROUND(100 * (MAX(IF(report_year=2024, asian, NULL))  - MAX(IF(report_year=2014, asian, NULL)) )  / MAX(IF(report_year=2014, asian, NULL)), 2)  AS asian_growth_pct,
  ROUND(100 * (MAX(IF(report_year=2024, black, NULL))  - MAX(IF(report_year=2014, black, NULL)) )  / MAX(IF(report_year=2014, black, NULL)), 2)  AS black_growth_pct,
  ROUND(100 * (MAX(IF(report_year=2024, latinx, NULL)) - MAX(IF(report_year=2014, latinx, NULL)) ) / MAX(IF(report_year=2014, latinx, NULL)), 2) AS latinx_growth_pct,
  ROUND(100 * (MAX(IF(report_year=2024, native, NULL)) - MAX(IF(report_year=2014, native, NULL)) ) / MAX(IF(report_year=2014, native, NULL)), 2) AS native_growth_pct,
  ROUND(100 * (MAX(IF(report_year=2024, white, NULL))  - MAX(IF(report_year=2014, white, NULL)) )  / MAX(IF(report_year=2014, white, NULL)), 2)  AS white_growth_pct,
  ROUND(100 * (MAX(IF(report_year=2024, us_women, NULL)) - MAX(IF(report_year=2014, us_women, NULL)) ) / MAX(IF(report_year=2014, us_women, NULL)), 2) AS us_women_growth_pct,
  ROUND(100 * (MAX(IF(report_year=2024, us_men, NULL))   - MAX(IF(report_year=2014, us_men, NULL)) )   / MAX(IF(report_year=2014, us_men, NULL)), 2) AS us_men_growth_pct,
  ROUND(100 * (MAX(IF(report_year=2024, g_women, NULL))  - MAX(IF(report_year=2014, g_women, NULL)) )  / MAX(IF(report_year=2014, g_women, NULL)), 2) AS global_women_growth_pct,
  ROUND(100 * (MAX(IF(report_year=2024, g_men, NULL))    - MAX(IF(report_year=2014, g_men, NULL)) )    / MAX(IF(report_year=2014, g_men, NULL)), 2) AS global_men_growth_pct
FROM yr;
```

```sql
--Description: Same growth‑rate logic as above but shown long‑form (one row per demographic) for easier charting
WITH yr AS (
  SELECT
    report_year,
    race_asian            AS asian,
    race_black            AS black,
    race_hispanic_latinx  AS latinx,
    race_native_american  AS native,
    race_white            AS white,
    gender_us_women       AS us_women,
    gender_us_men         AS us_men,
    gender_global_women   AS g_women,
    gender_global_men     AS g_men
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
    AND report_year IN (2014, 2024)
),
pivot AS (
  SELECT 'asian'  AS metric,  MAX(IF(report_year=2014, asian, NULL))  AS v2014,  MAX(IF(report_year=2024, asian, NULL))  AS v2024 FROM yr UNION ALL
  SELECT 'black',             MAX(IF(report_year=2014, black, NULL)),             MAX(IF(report_year=2024, black, NULL))  FROM yr UNION ALL
  SELECT 'latinx',            MAX(IF(report_year=2014, latinx, NULL)),            MAX(IF(report_year=2024, latinx, NULL)) FROM yr UNION ALL
  SELECT 'native',            MAX(IF(report_year=2014, native, NULL)),            MAX(IF(report_year=2024, native, NULL)) FROM yr UNION ALL
  SELECT 'white',             MAX(IF(report_year=2014, white, NULL)),             MAX(IF(report_year=2024, white, NULL))  FROM yr UNION ALL
  SELECT 'us_women',          MAX(IF(report_year=2014, us_women, NULL)),          MAX(IF(report_year=2024, us_women, NULL)) FROM yr UNION ALL
  SELECT 'us_men',            MAX(IF(report_year=2014, us_men, NULL)),            MAX(IF(report_year=2024, us_men, NULL))   FROM yr UNION ALL
  SELECT 'global_women',      MAX(IF(report_year=2014, g_women, NULL)),           MAX(IF(report_year=2024, g_women, NULL))  FROM yr UNION ALL
  SELECT 'global_men',        MAX(IF(report_year=2014, g_men, NULL)),             MAX(IF(report_year=2024, g_men, NULL))    FROM yr
)
SELECT
  metric,
  v2014,
  v2024,
  ROUND(100 * (v2024 - v2014) / v2014, 2) AS growth_pct_14_24
FROM pivot
ORDER BY metric
LIMIT 20;
```

