```sql
--Description: Find the latest year that exists for the overall workforce, grab the 2014 row
--             and that latest‑year row, then calculate growth rates (%) from 2014 to latest.
WITH
  latest_year AS (
    SELECT MAX(report_year) AS yr
    FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
    WHERE workforce = 'overall'
  ),
  base AS (
    SELECT *
    FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
    WHERE workforce = 'overall' AND report_year = 2014
  ),
  latest AS (
    SELECT *
    FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
    WHERE workforce = 'overall'
      AND report_year = (SELECT yr FROM latest_year)
  )
SELECT
  2014                           AS base_year,
  (SELECT yr FROM latest_year)    AS latest_year,
  ROUND(100 * (latest.race_asian            - base.race_asian           ) / base.race_asian          , 2) AS asian_growth_pct,
  ROUND(100 * (latest.race_black            - base.race_black           ) / base.race_black          , 2) AS black_growth_pct,
  ROUND(100 * (latest.race_hispanic_latinx  - base.race_hispanic_latinx ) / base.race_hispanic_latinx, 2) AS latinx_growth_pct,
  ROUND(100 * (latest.race_native_american  - base.race_native_american ) / base.race_native_american, 2) AS native_growth_pct,
  ROUND(100 * (latest.race_white            - base.race_white           ) / base.race_white          , 2) AS white_growth_pct,
  ROUND(100 * (latest.gender_us_women       - base.gender_us_women      ) / base.gender_us_women     , 2) AS us_women_growth_pct,
  ROUND(100 * (latest.gender_us_men         - base.gender_us_men        ) / base.gender_us_men       , 2) AS us_men_growth_pct,
  ROUND(100 * (latest.gender_global_women   - base.gender_global_women  ) / base.gender_global_women , 2) AS global_women_growth_pct,
  ROUND(100 * (latest.gender_global_men     - base.gender_global_men    ) / base.gender_global_men   , 2) AS global_men_growth_pct
FROM base CROSS JOIN latest;
```
