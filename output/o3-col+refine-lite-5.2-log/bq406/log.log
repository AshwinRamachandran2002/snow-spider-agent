```sql
--Description:  The goal is to compare overall‑workforce demographics in the baseline
--              year (2014) with those in the most‑recent year that actually exists in
--              the table.  Steps:
--              1) latest_year CTE finds MAX(report_year) for workforce='overall'.
--              2) row_2014 CTE retrieves the single row for 2014.
--              3) row_latest CTE retrieves the single row for the year returned by
--                 latest_year.
--              4) CROSS JOIN the two one‑row CTEs to put 2014 and latest values
--                 side‑by‑side in one record.
WITH latest_year AS (
  SELECT MAX(report_year) AS latest_year
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
),
row_2014 AS (
  SELECT *
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
    AND report_year = 2014
),
row_latest AS (
  SELECT *
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
    AND report_year = (SELECT latest_year FROM latest_year)
)
SELECT
  'overall'                               AS workforce,
  row_2014.report_year                    AS year_2014,
  row_latest.report_year                  AS latest_year,
  row_2014.race_asian           AS asian_2014,   row_latest.race_asian           AS asian_latest,
  row_2014.race_black           AS black_2014,   row_latest.race_black           AS black_latest,
  row_2014.race_hispanic_latinx AS latinx_2014,  row_latest.race_hispanic_latinx AS latinx_latest,
  row_2014.race_native_american AS native_2014,  row_latest.race_native_american AS native_latest,
  row_2014.race_white           AS white_2014,   row_latest.race_white           AS white_latest,
  row_2014.gender_us_women      AS us_women_2014,row_latest.gender_us_women      AS us_women_latest,
  row_2014.gender_us_men        AS us_men_2014,  row_latest.gender_us_men        AS us_men_latest,
  row_2014.gender_global_women  AS g_women_2014, row_latest.gender_global_women  AS g_women_latest,
  row_2014.gender_global_men    AS g_men_2014,   row_latest.gender_global_men    AS g_men_latest
FROM row_2014
CROSS JOIN row_latest;
