```sql
--Description: Calculate the 2014‑to‑latest‑year growth rate for every demographic in one step
WITH yrs AS (
  SELECT
    report_year,
    race_asian            AS asian,
    race_black            AS black,
    race_hispanic_latinx  AS latinx,
    race_native_american  AS native,
    race_white            AS white,
    gender_us_women       AS us_women,
    gender_us_men         AS us_men,
    gender_global_women   AS g_women,
    gender_global_men     AS g_men
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
),
y14 AS (SELECT * FROM yrs WHERE report_year = 2014),
yL  AS (
  SELECT *
  FROM yrs
  WHERE report_year = (SELECT MAX(report_year) FROM yrs)
)
SELECT
  2014                                                  AS base_year,
  yL.report_year                                        AS latest_year,
  ROUND(100 * (yL.asian   - y14.asian)   / y14.asian  , 2) AS asian_growth_pct,
  ROUND(100 * (yL.black   - y14.black)   / y14.black  , 2) AS black_growth_pct,
  ROUND(100 * (yL.latinx  - y14.latinx)  / y14.latinx , 2) AS latinx_growth_pct,
  ROUND(100 * (yL.native  - y14.native)  / y14.native , 2) AS native_growth_pct,
  ROUND(100 * (yL.white   - y14.white)   / y14.white  , 2) AS white_growth_pct,
  ROUND(100 * (yL.us_women - y14.us_women) / y14.us_women, 2) AS us_women_growth_pct,
  ROUND(100 * (yL.us_men   - y14.us_men)   / y14.us_men  , 2) AS us_men_growth_pct,
  ROUND(100 * (yL.g_women  - y14.g_women)  / y14.g_women , 2) AS global_women_growth_pct,
  ROUND(100 * (yL.g_men    - y14.g_men)    / y14.g_men   , 2) AS global_men_growth_pct
FROM y14
CROSS JOIN yL;
```

```sql
--Description: Long‑form growth table (one row per metric) using the latest year dynamically
WITH yrs AS (
  SELECT
    report_year,
    race_asian            AS asian,
    race_black            AS black,
    race_hispanic_latinx  AS latinx,
    race_native_american  AS native,
    race_white            AS white,
    gender_us_women       AS us_women,
    gender_us_men         AS us_men,
    gender_global_women   AS g_women,
    gender_global_men     AS g_men
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
),
y14 AS (SELECT * FROM yrs WHERE report_year = 2014),
yL  AS (SELECT * FROM yrs WHERE report_year = (SELECT MAX(report_year) FROM yrs)),
pivot AS (
  SELECT 'asian'         AS metric, y14.asian   AS v2014, yL.asian   AS vLatest UNION ALL
  SELECT 'black',                     y14.black,           yL.black              UNION ALL
  SELECT 'latinx',                    y14.latinx,          yL.latinx             UNION ALL
  SELECT 'native',                    y14.native,          yL.native             UNION ALL
  SELECT 'white',                     y14.white,           yL.white              UNION ALL
  SELECT 'us_women',                  y14.us_women,        yL.us_women           UNION ALL
  SELECT 'us_men',                    y14.us_men,          yL.us_men             UNION ALL
  SELECT 'global_women',              y14.g_women,         yL.g_women            UNION ALL
  SELECT 'global_men',                y14.g_men,           yL.g_men
)
SELECT
  metric,
  v2014,
  vLatest,
  ROUND(100 * (vLatest - v2014) / v2014, 2) AS growth_pct_14_to_latest
FROM pivot
ORDER BY metric
LIMIT 20;
```

