```sql
--Description: Review all June week‑starts for 2019 (same purpose as above)
SELECT DISTINCT "week_number",
       "week_date"
FROM   "cleaned_weekly_sales"
WHERE  "calendar_year" = 2019
  AND  "month_number"  = 6
ORDER BY "week_number"
LIMIT 20;
```

```sql
--Description: Review all June week‑starts for 2020 (same purpose as above)
SELECT DISTINCT "week_number",
       "week_date"
FROM   "cleaned_weekly_sales"
WHERE  "calendar_year" = 2020
  AND  "month_number"  = 6
ORDER BY "week_number"
LIMIT 20;
```

```sql
--Description: Total sales for the 4 weeks leading up to 15‑Jun (weeks 20‑23) for each year
SELECT  "calendar_year",
        SUM("sales") AS "pre_jun15_sales"
FROM    "cleaned_weekly_sales"
WHERE   "week_number" BETWEEN 20 AND 23   -- 4 weeks before 15‑Jun
GROUP BY "calendar_year"
ORDER BY "calendar_year"
LIMIT 20;
```

```sql
--Description: Total sales for the 4 weeks following 15‑Jun (weeks 24‑27) for each year
SELECT  "calendar_year",
        SUM("sales") AS "post_jun15_sales"
FROM    "cleaned_weekly_sales"
WHERE   "week_number" BETWEEN 24 AND 27   -- 4 weeks after 15‑Jun
GROUP BY "calendar_year"
ORDER BY "calendar_year"
LIMIT 20;
```

```sql
--Description: Combine the two aggregates to calculate percentage change for each year
SELECT pre."calendar_year",
       pre."pre_jun15_sales",
       post."post_jun15_sales",
       ROUND(100.0 * (post."post_jun15_sales" - pre."pre_jun15_sales")
                    / pre."pre_jun15_sales", 2) AS "pct_change_after_jun15"
FROM   (
        SELECT "calendar_year",
               SUM("sales") AS "pre_jun15_sales"
        FROM   "cleaned_weekly_sales"
        WHERE  "week_number" BETWEEN 20 AND 23
        GROUP  BY "calendar_year"
       ) AS pre
JOIN   (
        SELECT "calendar_year",
               SUM("sales") AS "post_jun15_sales"
        FROM   "cleaned_weekly_sales"
        WHERE  "week_number" BETWEEN 24 AND 27
        GROUP  BY "calendar_year"
       ) AS post
       ON pre."calendar_year" = post."calendar_year"
ORDER BY pre."calendar_year"
LIMIT 20;
```

```sql
--Description: Break‑down of pre‑ vs post‑Jun‑15 sales per platform to see if any channel drove the change (optional deeper dive)
SELECT  pre.platform,
        pre.calendar_year,
        pre.pre_sales,
        post.post_sales,
        ROUND(100.0 * (post.post_sales - pre.pre_sales) / pre.pre_sales, 2) AS pct_change
FROM   (
        SELECT "platform",
               "calendar_year",
               SUM("sales") AS pre_sales
        FROM   "cleaned_weekly_sales"
        WHERE  "week_number" BETWEEN 20 AND 23
        GROUP  BY "platform", "calendar_year"
       ) AS pre
JOIN   (
        SELECT "platform",
               "calendar_year",
               SUM("sales") AS post_sales
        FROM   "cleaned_weekly_sales"
        WHERE  "week_number" BETWEEN 24 AND 27
        GROUP  BY "platform", "calendar_year"
       ) AS post
       ON pre.platform = post.platform
      AND pre.calendar_year = post.calendar_year
ORDER BY pre.calendar_year, pct_change DESC
LIMIT 20;
```

```sql
--Description: Same percentage‑change view by customer_type for a different analytical angle
SELECT  pre.customer_type,
        pre.calendar_year,
        ROUND(100.0 * (post.post_sales - pre.pre_sales) / pre.pre_sales, 2) AS pct_change
FROM   (
        SELECT "customer_type",
               "calendar_year",
               SUM("sales") AS pre_sales
        FROM   "cleaned_weekly_sales"
        WHERE  "week_number" BETWEEN 20 AND 23
        GROUP  BY "customer_type", "calendar_year"
       ) AS pre
JOIN   (
        SELECT "customer_type",
               "calendar_year",
               SUM("sales") AS post_sales
        FROM   "cleaned_weekly_sales"
        WHERE  "week_number" BETWEEN 24 AND 27
        GROUP  BY "customer_type", "calendar_year"
       ) AS post
       ON pre.customer_type = post.customer_type
      AND pre.calendar_year = post.calendar_year
ORDER BY pre.calendar_year, pct_change DESC
LIMIT 20;
```

