Query:
--Description: Break‑down of pre‑ vs post‑Jun‑15 sales per platform to see if any channel drove the change (optional deeper dive)
SELECT  pre.platform,
        pre.calendar_year,
        pre.pre_sales,
        post.post_sales,
        ROUND(100.0 * (post.post_sales - pre.pre_sales) / pre.pre_sales, 2) AS pct_change
FROM   (
        SELECT "platform",
               "calendar_year",
               SUM("sales") AS pre_sales
        FROM   "cleaned_weekly_sales"
        WHERE  "week_number" BETWEEN 20 AND 23
        GROUP  BY "platform", "calendar_year"
       ) AS pre
JOIN   (
        SELECT "platform",
               "calendar_year",
               SUM("sales") AS post_sales
        FROM   "cleaned_weekly_sales"
        WHERE  "week_number" BETWEEN 24 AND 27
        GROUP  BY "platform", "calendar_year"
       ) AS post
       ON pre.platform = post.platform
      AND pre.calendar_year = post.calendar_year
ORDER BY pre.calendar_year, pct_change DESC
LIMIT 20;
