Query:
--Description: Combine the two aggregates to calculate percentage change for each year
SELECT pre."calendar_year",
       pre."pre_jun15_sales",
       post."post_jun15_sales",
       ROUND(100.0 * (post."post_jun15_sales" - pre."pre_jun15_sales")
                    / pre."pre_jun15_sales", 2) AS "pct_change_after_jun15"
FROM   (
        SELECT "calendar_year",
               SUM("sales") AS "pre_jun15_sales"
        FROM   "cleaned_weekly_sales"
        WHERE  "week_number" BETWEEN 20 AND 23
        GROUP  BY "calendar_year"
       ) AS pre
JOIN   (
        SELECT "calendar_year",
               SUM("sales") AS "post_jun15_sales"
        FROM   "cleaned_weekly_sales"
        WHERE  "week_number" BETWEEN 24 AND 27
        GROUP  BY "calendar_year"
       ) AS post
       ON pre."calendar_year" = post."calendar_year"
ORDER BY pre."calendar_year"
LIMIT 20;
Answer:
calendar_year,pre_jun15_sales,post_jun15_sales,pct_change_after_jun15
