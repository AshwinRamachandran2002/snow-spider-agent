2025-05-02 04:25:31 - ThreadPoolExecutor-0_5 - INFO - [Exploration]
Below is a sequence of nine exploratory → analytic queries (all limited to 20 rows) that steadily build the logic needed to answer:  

“Who is the pitcher with the highest non‑zero pitch speed for every team (regular‑season **and** post‑season combined) after verifying that the pitcher really appeared in that game for that team?”

```sql
-- 1. Preview a few regular‑season pitch events that actually have a pitch speed
SELECT gameId,
       pitcherId,
       pitcherFirstName, pitcherLastName,
       pitchSpeed,
       homeTeamId, awayTeamId
FROM   `bigquery-public-data.baseball.games_wide`
WHERE  pitchSpeed > 0
LIMIT  20;
```

```sql
-- 2. Preview a few post‑season rows to confirm the same columns exist
SELECT gameId,
       pitcherId,
       pitcherFirstName, pitcherLastName,
       pitchSpeed,
       homeTeamId, awayTeamId
FROM   `bigquery-public-data.baseball.games_post_wide`
WHERE  pitchSpeed > 0
LIMIT  20;
```

```sql
-- 3. Check what a full set of fielder columns looks like
SELECT gameId,
       pitcherId,
       ARRAY<STRING>[
          homeFielder1, homeFielder2, homeFielder3, homeFielder4, homeFielder5, homeFielder6,
          homeFielder7, homeFielder8, homeFielder9, homeFielder10, homeFielder11, homeFielder12
       ]                AS home_fielders,
       ARRAY<STRING>[
          awayFielder1, awayFielder2, awayFielder3, awayFielder4, awayFielder5, awayFielder6,
          awayFielder7, awayFielder8, awayFielder9, awayFielder10, awayFielder11, awayFielder12
       ]                AS away_fielders
FROM   `bigquery-public-data.baseball.games_wide`
WHERE  pitchSpeed > 0
LIMIT  20;
```

```sql
-- 4. For any single row, derive the team​Id the pitcher belongs to in that game
SELECT gameId,
       pitcherId,
       CASE
         WHEN pitcherId IN (
                homeFielder1, homeFielder2, homeFielder3, homeFielder4, homeFielder5, homeFielder6,
                homeFielder7, homeFielder8, homeFielder9, homeFielder10, homeFielder11, homeFielder12
              )
              THEN homeTeamId
         WHEN pitcherId IN (
                awayFielder1, awayFielder2, awayFielder3, awayFielder4, awayFielder5, awayFielder6,
                awayFielder7, awayFielder8, awayFielder9, awayFielder10, awayFielder11, awayFielder12
              )
              THEN awayTeamId
       END                                              AS teamId_derived,
       pitchSpeed
FROM   `bigquery-public-data.baseball.games_wide`
WHERE  pitchSpeed > 0
LIMIT  20;
```

```sql
-- 5. Keep only rows where the pitcher is positively matched to either team
SELECT *
FROM (
  SELECT gameId,
         pitcherId,
         CASE
           WHEN pitcherId IN (
                  homeFielder1, homeFielder2, homeFielder3, homeFielder4, homeFielder5, homeFielder6,
                  homeFielder7, homeFielder8, homeFielder9, homeFielder10, homeFielder11, homeFielder12
                ) THEN homeTeamId
           WHEN pitcherId IN (
                  awayFielder1, awayFielder2, awayFielder3, awayFielder4, awayFielder5, awayFielder6,
                  awayFielder7, awayFielder8, awayFielder9, awayFielder10, awayFielder11, awayFielder12
                ) THEN awayTeamId
         END AS teamId_checked,
         pitchSpeed
  FROM   `bigquery-public-data.baseball.games_wide`
  WHERE  pitchSpeed > 0
)
WHERE teamId_checked IS NOT NULL
LIMIT 20;
```

```sql
-- 6. Compute the max non‑zero pitch speed *per pitcher per team* (regular season only)
SELECT teamId_checked        AS teamId,
       pitcherId,
       MAX(pitchSpeed)       AS max_pitch_speed
FROM (
  SELECT *,
         CASE
           WHEN pitcherId IN (
                  homeFielder1, homeFielder2, homeFielder3, homeFielder4, homeFielder5, homeFielder6,
                  homeFielder7, homeFielder8, homeFielder9, homeFielder10, homeFielder11, homeFielder12
                ) THEN homeTeamId
           WHEN pitcherId IN (
                  awayFielder1, awayFielder2, awayFielder3, awayFielder4, awayFielder5, awayFielder6,
                  awayFielder7, awayFielder8, awayFielder9, awayFielder10, awayFielder11, awayFielder12
                ) THEN awayTeamId
         END AS teamId_checked
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE pitchSpeed > 0
)
GROUP BY teamId, pitcherId
LIMIT 20;
```

```sql
-- 7. Repeat the same aggregation for post‑season only
SELECT teamId_checked AS teamId,
       pitcherId,
       MAX(pitchSpeed) AS max_pitch_speed
FROM (
  SELECT *,
         CASE
           WHEN pitcherId IN (
                  homeFielder1, homeFielder2, homeFielder3, homeFielder4, homeFielder5, homeFielder6,
                  homeFielder7, homeFielder8, homeFielder9, homeFielder10, homeFielder11, homeFielder12
                ) THEN homeTeamId
           WHEN pitcherId IN (
                  awayFielder1, awayFielder2, awayFielder3, awayFielder4, awayFielder5, awayFielder6,
                  awayFielder7, awayFielder8, awayFielder9, awayFielder10, awayFielder11, awayFielder12
                ) THEN awayTeamId
         END AS teamId_checked
  FROM `bigquery-public-data.baseball.games_post_wide`
  WHERE pitchSpeed > 0
)
GROUP BY teamId, pitcherId
LIMIT 20;
```

```sql
-- 8. Combine regular + post‑season, then choose the single fastest pitcher for every team
WITH unioned AS (
  SELECT teamId, pitcherId, max_pitch_speed FROM (
        -- regular
        SELECT teamId_checked AS teamId, pitcherId, MAX(pitchSpeed) AS max_pitch_speed
        FROM (
          SELECT *,
                 CASE
                   WHEN pitcherId IN (
                          homeFielder1, homeFielder2, homeFielder3, homeFielder4, homeFielder5, homeFielder6,
                          homeFielder7, homeFielder8, homeFielder9, homeFielder10, homeFielder11, homeFielder12
                        ) THEN homeTeamId
                   WHEN pitcherId IN (
                          awayFielder1, awayFielder2, awayFielder3, awayFielder4, awayFielder5, awayFielder6,
                          awayFielder7, awayFielder8, awayFielder9, awayFielder10, awayFielder11, awayFielder12
                        ) THEN awayTeamId
                 END AS teamId_checked
          FROM `bigquery-public-data.baseball.games_wide`
          WHERE pitchSpeed > 0
        )
        GROUP BY teamId, pitcherId
    UNION ALL
        -- post‑season
        SELECT teamId_checked AS teamId, pitcherId, MAX(pitchSpeed) AS max_pitch_speed
        FROM (
          SELECT *,
                 CASE
                   WHEN pitcherId IN (
                          homeFielder1, homeFielder2, homeFielder3, homeFielder4, homeFielder5, homeFielder6,
                          homeFielder7, homeFielder8, homeFielder9, homeFielder10, homeFielder11, homeFielder12
                        ) THEN homeTeamId
                   WHEN pitcherId IN (
                          awayFielder1, awayFielder2, awayFielder3, awayFielder4, awayFielder5, awayFielder6,
                          awayFielder7, awayFielder8, awayFielder9, awayFielder10, awayFielder11, awayFielder12
                        ) THEN awayTeamId
                 END AS teamId_checked
          FROM `bigquery-public-data.baseball.games_post_wide`
          WHERE pitchSpeed > 0
        )
        GROUP BY teamId, pitcherId
  )
)
SELECT teamId,
       ANY_VALUE(pitcherId)        AS pitcherId,
       MAX(max_pitch_speed)        AS team_max_pitch
FROM   unioned
GROUP  BY teamId
LIMIT 20;
```

```sql
-- 9. FINAL ANSWER: attach the pitcher’s full name & show the fastest valid pitch for every club
WITH unioned AS (
  SELECT teamId, pitcherId, max_pitch_speed FROM (
        -- regular
        SELECT teamId_checked AS teamId, pitcherId, MAX(pitchSpeed) AS max_pitch_speed
        FROM (
          SELECT *,
                 CASE
                   WHEN pitcherId IN (
                          homeFielder1, homeFielder2, homeFielder3, homeFielder4, homeFielder5, homeFielder6,
                          homeFielder7, homeFielder8, homeFielder9, homeFielder10, homeFielder11, homeFielder12
                        ) THEN homeTeamId
                   WHEN pitcherId IN (
                          awayFielder1, awayFielder2, awayFielder3, awayFielder4, awayFielder5, awayFielder6,
                          awayFielder7, awayFielder8, awayFielder9, awayFielder10, awayFielder11, awayFielder12
                        ) THEN awayTeamId
                 END AS teamId_checked
          FROM `bigquery-public-data.baseball.games_wide`
          WHERE pitchSpeed > 0
        )
        GROUP BY teamId, pitcherId
    UNION ALL
        -- post‑season
        SELECT teamId_checked AS teamId, pitcherId, MAX(pitchSpeed) AS max_pitch_speed
        FROM (
          SELECT *,
                 CASE
                   WHEN pitcherId IN (
                          homeFielder1, homeFielder2, homeFielder3, homeFielder4, homeFielder5, homeFielder6,
                          homeFielder7, homeFielder8, homeFielder9, homeFielder10, homeFielder11, homeFielder12
                        ) THEN homeTeamId
                   WHEN pitcherId IN (
                          awayFielder1, awayFielder2, awayFielder3, awayFielder4, awayFielder5, awayFielder6,
                          awayFielder7, awayFielder8, awayFielder9, awayFielder10, awayFielder11, awayFielder12
                        ) THEN awayTeamId
                 END AS teamId_checked
          FROM `bigquery-public-data.baseball.games_post_wide`
          WHERE pitchSpeed > 0
        )
        GROUP BY teamId, pitcherId
  )
),
ranked AS (
  SELECT teamId,
         pitcherId,
         max_pitch_speed,
         RANK() OVER (PARTITION BY teamId ORDER BY max_pitch_speed DESC) AS rnk
  FROM   unioned
)
SELECT r.teamId,
       -- grab the first non‑null team name we see for that id
       ANY_VALUE(CASE WHEN g.homeTeamId = r.teamId THEN g.homeTeamName
                      WHEN g.awayTeamId = r.teamId THEN g.awayTeamName
                 END)                                 AS teamName,
       r.pitcherId,
       ANY_VALUE(g.pitcherFirstName) || ' ' ||
       ANY_VALUE(g.pitcherLastName)                  AS pitcherFullName,
       r.max_pitch_speed                             AS fastest_valid_pitch
FROM   ranked AS r
JOIN   `bigquery-public-data.baseball.games_wide` AS g
       ON g.pitcherId = r.pitcherId
WHERE  r.rnk = 1
GROUP  BY r.teamId, r.pitcherId, r.max_pitch_speed
ORDER BY fastest_valid_pitch DESC
LIMIT 20;
```

Each successive query refines the logic from simple inspection to the complete answer, making sure every pitch we keep is (1) non‑zero speed and (2) thrown by a pitcher actually listed for the appropriate team in that game.
