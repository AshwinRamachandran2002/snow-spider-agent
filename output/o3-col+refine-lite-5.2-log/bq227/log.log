```sql
--Description / Thinking process:
--We need, for every year, the percentage share of the five minor‑crime
--categories that were the most frequent in 2008.
--To achieve this:
-- 1. top5     : Pick the five highest‑volume minor categories for 2008.
-- 2. yr_tot   : Get total crime counts (all categories) for each year.
-- 3. yr_top   : Aggregate yearly crime counts for just those five categories.
-- 4. pct      : Turn the category counts into % of the yearly total, rounded.
-- 5. Output   : One row per year, joining the five “category: xx.xx%” strings.
WITH top5 AS (                               -- step 1
  SELECT minor_category
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE year = 2008
  GROUP BY minor_category
  ORDER BY SUM(value) DESC
  LIMIT 5
),
yr_tot AS (                                  -- step 2
  SELECT year,
         SUM(value) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
yr_top AS (                                  -- step 3
  SELECT c.year,
         c.minor_category,
         SUM(c.value) AS cat_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
  JOIN top5 USING (minor_category)
  GROUP BY c.year, c.minor_category
),
pct AS (                                     -- step 4
  SELECT
    y.year,
    y.minor_category,
    ROUND(100 * y.cat_crimes / t.total_crimes, 2) AS pct_share
  FROM yr_top AS y
  JOIN yr_tot AS t USING (year)
)
SELECT                                        -- step 5 (final output)
  year,
  STRING_AGG(
      FORMAT('%s: %.2f%%', minor_category, pct_share),
      ', '
      ORDER BY pct_share DESC, minor_category
  ) AS top5_category_shares
FROM pct
GROUP BY year
ORDER BY year;
```
