  ORDER BY SUM(value) DESC
  LIMIT 5
),
yearly_totals AS (
  SELECT year, SUM(value) AS total_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  GROUP BY year
),
yearly_top5 AS (
  SELECT c.year,
         c.minor_category,
         SUM(c.value) AS cat_crimes
  FROM `bigquery-public-data.london_crime.crime_by_lsoa` AS c
  JOIN top5 USING (minor_category)
  GROUP BY c.year, c.minor_category
),
pct AS (
  SELECT
    y.year,
    y.minor_category,
    ROUND(100 * y.cat_crimes / t.total_crimes, 2) AS pct_share
  FROM yearly_top5 AS y
  JOIN yearly_totals AS t USING (year)
)
SELECT
  year,
  STRING_AGG(FORMAT('%s: %.2f%%', minor_category, pct_share)
