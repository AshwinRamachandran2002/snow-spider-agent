871388660341234241,2017-06-20,2017-06-21
6988456629622921225,2016-12-15,2016-12-16
3550517741801560701,2017-02-18,2017-07-13
Query:
-- 7. Same logic as above but return ONLY the qualifying visitor IDs
SELECT
  v.fullVisitorId
FROM (
  SELECT
    fullVisitorId,
    MIN(PARSE_DATE('%Y%m%d', date)) AS first_visit_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY fullVisitorId
) AS v
JOIN (
  SELECT
    fullVisitorId,
    MIN(PARSE_DATE('%Y%m%d', date)) AS first_mobile_txn_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE totals.transactions IS NOT NULL
    AND totals.transactions > 0
    AND device.deviceCategory = 'mobile'
  GROUP BY fullVisitorId
) AS t
ON v.fullVisitorId = t.fullVisitorId
WHERE t.first_mobile_txn_date > v.first_visit_date
LIMIT 20;
