-- 2. Sessions that contain at least one ecommerce transaction
SELECT DISTINCT
  fullVisitorId,
  date,
  device.deviceCategory,
  totals.transactions
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE totals.transactions IS NOT NULL AND totals.transactions > 0
LIMIT 20;
