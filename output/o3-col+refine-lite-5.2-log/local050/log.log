```sql
-- 4) Sample France‑only sales rows in 2019 (after joining to customers, countries, times)
SELECT s."prod_id",
       s."cust_id",
       s."time_id",
       s."amount_sold"
FROM   "sales"      AS s
JOIN   "customers"  AS cu ON cu."cust_id" = s."cust_id"
JOIN   "countries"  AS co ON co."country_id" = cu."country_id"
JOIN   "times"      AS t  ON t."time_id"    = s."time_id"
WHERE  co."country_name"  = 'France'
  AND  t."calendar_year"  = 2019
LIMIT 20;
```

```sql
-- 5) Monthly sales totals for France in 2019 (promo_total_id = 1 & channel_total_id = 1)
SELECT t."calendar_month_number"  AS month,
       SUM(s."amount_sold")       AS total_sales_2019
FROM   "sales"       AS s
JOIN   "customers"   AS cu ON cu."cust_id"    = s."cust_id"
JOIN   "countries"   AS co ON co."country_id" = cu."country_id"
JOIN   "promotions"  AS p  ON p."promo_id"    = s."promo_id"  AND p."promo_total_id"  = 1
JOIN   "channels"    AS ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
JOIN   "times"       AS t  ON t."time_id"     = s."time_id"
WHERE  co."country_name" = 'France'
  AND  t."calendar_year" = 2019
GROUP  BY t."calendar_month_number"
ORDER  BY month
LIMIT 20;
```

```sql
-- 6) Monthly sales totals for France in 2020 (same filters)
SELECT t."calendar_month_number"  AS month,
       SUM(s."amount_sold")       AS total_sales_2020
FROM   "sales"       AS s
JOIN   "customers"   AS cu ON cu."cust_id"    = s."cust_id"
JOIN   "countries"   AS co ON co."country_id" = cu."country_id"
JOIN   "promotions"  AS p  ON p."promo_id"    = s."promo_id"  AND p."promo_total_id"  = 1
JOIN   "channels"    AS ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
JOIN   "times"       AS t  ON t."time_id"     = s."time_id"
WHERE  co."country_name" = 'France'
  AND  t."calendar_year" = 2020
GROUP  BY t."calendar_month_number"
ORDER  BY month
LIMIT 20;
```

```sql
-- 7) Put 2019 & 2020 side‑by‑side to see growth factors
WITH sales19 AS (
  SELECT t."calendar_month_number" AS month,
         SUM(s."amount_sold")      AS total_2019
  FROM   "sales" AS s
  JOIN   "customers"  cu ON cu."cust_id"    = s."cust_id"
  JOIN   "countries"  co ON co."country_id" = cu."country_id"
  JOIN   "promotions" p  ON p."promo_id"    = s."promo_id"  AND p."promo_total_id"  = 1
  JOIN   "channels"   ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
  JOIN   "times"      t  ON t."time_id"     = s."time_id"
  WHERE  co."country_name" = 'France' AND t."calendar_year" = 2019
  GROUP  BY month
),
sales20 AS (
  SELECT t."calendar_month_number" AS month,
         SUM(s."amount_sold")      AS total_2020
  FROM   "sales" AS s
  JOIN   "customers"  cu ON cu."cust_id"    = s."cust_id"
  JOIN   "countries"  co ON co."country_id" = cu."country_id"
  JOIN   "promotions" p  ON p."promo_id"    = s."promo_id"  AND p."promo_total_id"  = 1
  JOIN   "channels"   ch ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
  JOIN   "times"      t  ON t."time_id"     = s."time_id"
  WHERE  co."country_name" = 'France' AND t."calendar_year" = 2020
  GROUP  BY month
)
SELECT s20.month,
       s19.total_2019,
       s20.total_2020,
       ROUND( CAST(s20.total_2020 AS REAL) / s19.total_2019, 4 ) AS growth_factor
FROM   sales20 s20
JOIN   sales19 s19 USING (month)
ORDER  BY s20.month
LIMIT 20;
```

```sql
-- 8) Project 2021 monthly totals (apply 2019→2020 growth) and convert to USD
WITH sales19 AS (SELECT t."calendar_month_number" AS month,
                        SUM(s."amount_sold")  AS tot19
                 FROM "sales" s
                 JOIN "customers" cu  ON cu."cust_id" = s."cust_id"
                 JOIN "countries" co  ON co."country_id" = cu."country_id"
                 JOIN "promotions" p  ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
                 JOIN "channels" ch   ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
                 JOIN "times"    t    ON t."time_id" = s."time_id"
                 WHERE co."country_name" = 'France' AND t."calendar_year" = 2019
                 GROUP BY month),
     sales20 AS (SELECT t."calendar_month_number" AS month,
                        SUM(s."amount_sold")  AS tot20
                 FROM "sales" s
                 JOIN "customers" cu  ON cu."cust_id" = s."cust_id"
                 JOIN "countries" co  ON co."country_id" = cu."country_id"
                 JOIN "promotions" p  ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
                 JOIN "channels" ch   ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
                 JOIN "times"    t    ON t."time_id" = s."time_id"
                 WHERE co."country_name" = 'France' AND t."calendar_year" = 2020
                 GROUP BY month),
     proj21 AS (
       SELECT s20.month,
              /* projected 2021 total = 2020 * (2020 / 2019) */
              (s20.tot20 * 1.0 * s20.tot20 / s19.tot19) AS proj_tot21
       FROM   sales20 s20
       JOIN   sales19 s19 USING (month)
     ),
     cur AS (
       SELECT c."month",
              c."to_us"
       FROM   "currency" c
       WHERE  c."country" = 'France'
         AND  c."year"    = 2021
     ),
     days AS (
       SELECT t."calendar_month_number" AS month,
              MAX(t."days_in_cal_month") AS days_in_month
       FROM   "times" t
       WHERE  t."calendar_year" = 2021
       GROUP  BY month
     )
SELECT p21.month,
       ROUND(p21.proj_tot21 * cur.to_us, 2)          AS proj_total_usd,
       days.days_in_month
FROM   proj21  p21
JOIN   cur     ON cur.month  = p21.month
JOIN   days    ON days.month = p21.month
ORDER  BY p21.month
LIMIT 20;
```

```sql
-- 9) Compute average projected DAILY sales in USD for each 2021 month
WITH proj AS (
  /* the same CTE block from step 8, shortened here for readability */
  WITH sales19 AS (SELECT t."calendar_month_number" AS month,
                          SUM(s."amount_sold")  AS tot19
                   FROM "sales" s
                   JOIN "customers" cu  ON cu."cust_id" = s."cust_id"
                   JOIN "countries" co  ON co."country_id" = cu."country_id"
                   JOIN "promotions" p  ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
                   JOIN "channels" ch   ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
                   JOIN "times"    t    ON t."time_id" = s."time_id"
                   WHERE co."country_name" = 'France' AND t."calendar_year" = 2019
                   GROUP BY month),
       sales20 AS (SELECT t."calendar_month_number" AS month,
                          SUM(s."amount_sold")  AS tot20
                   FROM "sales" s
                   JOIN "customers" cu  ON cu."cust_id" = s."cust_id"
                   JOIN "countries" co  ON co."country_id" = cu."country_id"
                   JOIN "promotions" p  ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
                   JOIN "channels" ch   ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
                   JOIN "times"    t    ON t."time_id" = s."time_id"
                   WHERE co."country_name" = 'France' AND t."calendar_year" = 2020
                   GROUP BY month),
       proj21 AS (
         SELECT s20.month,
                (s20.tot20 * 1.0 * s20.tot20 / s19.tot19) AS proj_tot21
         FROM   sales20 s20
         JOIN   sales19 s19 USING (month)
       ),
       cur AS (
         SELECT c."month",
                c."to_us"
         FROM   "currency" c
         WHERE  c."country" = 'France'
           AND  c."year"    = 2021
       ),
       days AS (
         SELECT t."calendar_month_number" AS month,
                MAX(t."days_in_cal_month") AS days_in_month
         FROM   "times" t
         WHERE  t."calendar_year" = 2021
         GROUP  BY month
       )
  SELECT p21.month,
         (p21.proj_tot21 * cur.to_us) / days.days_in_month AS avg_daily_usd
  FROM   proj21  p21
  JOIN   cur     ON cur.month  = p21.month
  JOIN   days    ON days.month = p21.month
)
SELECT *
FROM   proj
ORDER  BY month
LIMIT 20;
```

```sql
-- 10) Median of those 12 monthly averages (final answer)
WITH proj AS (
  /* same block as in step 9 */
  WITH sales19 AS (SELECT t."calendar_month_number" AS month,
                          SUM(s."amount_sold")  AS tot19
                   FROM "sales" s
                   JOIN "customers" cu  ON cu."cust_id" = s."cust_id"
                   JOIN "countries" co  ON co."country_id" = cu."country_id"
                   JOIN "promotions" p  ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
                   JOIN "channels" ch   ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
                   JOIN "times"    t    ON t."time_id" = s."time_id"
                   WHERE co."country_name" = 'France' AND t."calendar_year" = 2019
                   GROUP BY month),
       sales20 AS (SELECT t."calendar_month_number" AS month,
                          SUM(s."amount_sold")  AS tot20
                   FROM "sales" s
                   JOIN "customers" cu  ON cu."cust_id" = s."cust_id"
                   JOIN "countries" co  ON co."country_id" = cu."country_id"
                   JOIN "promotions" p  ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
                   JOIN "channels" ch   ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
                   JOIN "times"    t    ON t."time_id" = s."time_id"
                   WHERE co."country_name" = 'France' AND t."calendar_year" = 2020
                   GROUP BY month),
       proj21 AS (
         SELECT s20.month,
                (s20.tot20 * 1.0 * s20.tot20 / s19.tot19) AS proj_tot21
         FROM   sales20 s20
         JOIN   sales19 s19 USING (month)
       ),
       cur AS (
         SELECT c."month",
                c."to_us"
         FROM   "currency" c
         WHERE  c."country" = 'France'
           AND  c."year"    = 2021
       ),
       days AS (
         SELECT t."calendar_month_number" AS month,
                MAX(t."days_in_cal_month") AS days_in_month
         FROM   "times" t
         WHERE  t."calendar_year" = 2021
         GROUP  BY month
       )
  SELECT p21.month,
         (p21.proj_tot21 * cur.to_us) / days.days_in_month AS avg_daily_usd
  FROM   proj21  p21
  JOIN   cur     ON cur.month  = p21.month
  JOIN   days    ON days.month = p21.month
),
ordered AS (
  SELECT avg_daily_usd,
         ROW_NUMBER() OVER (ORDER BY avg_daily_usd) AS rn,
         COUNT(*)  OVER ()                          AS cnt
  FROM   proj
)
SELECT AVG(avg_daily_usd) AS median_avg_daily_sales_usd_2021
FROM   ordered
WHERE  rn IN ( (cnt + 1)/2, (cnt + 2)/2 )  -- picks the middle value(s)
LIMIT 20;
```
