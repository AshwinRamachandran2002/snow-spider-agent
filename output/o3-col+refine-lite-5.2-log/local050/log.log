-- 9) Compute average projected DAILY sales in USD for each 2021 month
WITH proj AS (
  /* the same CTE block from step 8, shortened here for readability */
  WITH sales19 AS (SELECT t."calendar_month_number" AS month,
                          SUM(s."amount_sold")  AS tot19
                   FROM "sales" s
                   JOIN "customers" cu  ON cu."cust_id" = s."cust_id"
                   JOIN "countries" co  ON co."country_id" = cu."country_id"
                   JOIN "promotions" p  ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
                   JOIN "channels" ch   ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
                   JOIN "times"    t    ON t."time_id" = s."time_id"
                   WHERE co."country_name" = 'France' AND t."calendar_year" = 2019
                   GROUP BY month),
       sales20 AS (SELECT t."calendar_month_number" AS month,
                          SUM(s."amount_sold")  AS tot20
                   FROM "sales" s
                   JOIN "customers" cu  ON cu."cust_id" = s."cust_id"
                   JOIN "countries" co  ON co."country_id" = cu."country_id"
                   JOIN "promotions" p  ON p."promo_id" = s."promo_id" AND p."promo_total_id" = 1
                   JOIN "channels" ch   ON ch."channel_id" = s."channel_id" AND ch."channel_total_id" = 1
                   JOIN "times"    t    ON t."time_id" = s."time_id"
                   WHERE co."country_name" = 'France' AND t."calendar_year" = 2020
                   GROUP BY month),
       proj21 AS (
         SELECT s20.month,
                (s20.tot20 * 1.0 * s20.tot20 / s19.tot19) AS proj_tot21
         FROM   sales20 s20
         JOIN   sales19 s19 USING (month)
       ),
       cur AS (
         SELECT c."month",
                c."to_us"
         FROM   "currency" c
         WHERE  c."country" = 'France'
           AND  c."year"    = 2021
       ),
       days AS (
         SELECT t."calendar_month_number" AS month,
                MAX(t."days_in_cal_month") AS days_in_month
         FROM   "times" t
         WHERE  t."calendar_year" = 2021
         GROUP  BY month
       )
  SELECT p21.month,
         (p21.proj_tot21 * cur.to_us) / days.days_in_month AS avg_daily_usd
  FROM   proj21  p21
  JOIN   cur     ON cur.month  = p21.month
  JOIN   days    ON days.month = p21.month
)
SELECT *
FROM   proj
ORDER  BY month
LIMIT 20;
