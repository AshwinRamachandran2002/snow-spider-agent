FROM Movie
LIMIT 20;
```

```sql
--Description: List the distinct release years that occur in the data
SELECT DISTINCT CAST(year AS INTEGER) AS release_year
FROM Movie
ORDER BY release_year
LIMIT 20;
```

```sql
--Description: See how many films were released in each individual year (top 20 rows)
SELECT CAST(year AS INTEGER) AS release_year,
       COUNT(*)                AS films_in_year
FROM Movie
GROUP BY release_year
ORDER BY films_in_year DESC, release_year
LIMIT 20;
```

```sql
--Description: Example – count movies released in the ten‑year window that starts in 2010
SELECT 2010                           AS start_year,
       COUNT(*)                       AS films_in_window
FROM Movie
WHERE CAST(year AS INTEGER) BETWEEN 2010 AND 2019;
```

```sql
--Description: Find the ten‑year period (inclusive) that contains the largest number of films
SELECT y.start_year,
       COUNT(*) AS films_in_window
FROM (
        SELECT DISTINCT CAST(year AS INTEGER) AS start_year
        FROM Movie
     ) AS y
JOIN Movie AS m
     ON CAST(m.year AS INTEGER) BETWEEN y.start_year AND y.start_year + 9
GROUP BY y.start_year
ORDER BY films_in_window DESC, y.start_year
LIMIT 1;
```
