```sql
--Description: Show the distinct “refresh_date” values in September‑2024 to understand what dates exist.
SELECT DISTINCT "refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "refresh_date" BETWEEN '2024-09-01' AND '2024-09-30'
ORDER BY "refresh_date"
LIMIT 20;
```

```sql
--Description: List the rows in the desired two‑week window using the “week” column.
SELECT "week",
       "term",
       "rank",
       "refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
ORDER BY "week"
LIMIT 20;
```

```sql
--Description: Keep only weekday (Mon–Fri) rows in the same window.
SELECT "week",
       "term",
       "rank",
       "refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DAYOFWEEK("week") BETWEEN 1 AND 5   -- 1=Mon … 5=Fri in Snowflake
ORDER BY "week"
LIMIT 20;
```

```sql
--Description: Inspect the top‑three ranked terms (ranks 1,2,3) for those weekdays.
SELECT "week",
       "term",
       "rank",
       "refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DAYOFWEEK("week") BETWEEN 1 AND 5
  AND "rank" IN (1,2,3)
ORDER BY "week", "rank"
LIMIT 20;
```

```sql
--Description: Count how many top‑three rows exist for each “refresh_date”.
SELECT "refresh_date",
       COUNT(*) AS "rows_in_top3"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DAYOFWEEK("week") BETWEEN 1 AND 5
  AND "rank" IN (1,2,3)
GROUP BY "refresh_date"
ORDER BY "refresh_date" DESC
LIMIT 20;
```

```sql
--Description: Retrieve distinct combinations of refresh_date and week for the target rows.
SELECT DISTINCT "refresh_date",
       "week"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DAYOFWEEK("week") BETWEEN 1 AND 5
  AND "rank" IN (1,2,3)
ORDER BY "refresh_date" DESC, "week"
LIMIT 20;
```

```sql
--Description: Pivot the three ranks into separate columns (one record per refresh_date & week).
SELECT "refresh_date",
       "week",
       MAX(CASE WHEN "rank" = 1 THEN "term" END) AS "rank_1_term",
       MAX(CASE WHEN "rank" = 2 THEN "term" END) AS "rank_2_term",
       MAX(CASE WHEN "rank" = 3 THEN "term" END) AS "rank_3_term"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DAYOFWEEK("week") BETWEEN 1 AND 5
  AND "rank" IN (1,2,3)
GROUP BY "refresh_date", "week"
ORDER BY "refresh_date" DESC, "week"
LIMIT 20;
```

```sql
--Description: Aggregate by refresh_date only, concatenating the terms found in ranks 1‑3.
SELECT "refresh_date",
       LISTAGG("term", ', ') WITHIN GROUP (ORDER BY "rank") AS "top3_terms_concat"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DAYOFWEEK("week") BETWEEN 1 AND 5
  AND "rank" IN (1,2,3)
GROUP BY "refresh_date"
ORDER BY "refresh_date" DESC
LIMIT 20;
```

```sql
--Description: FINAL – return the requested top‑three Google Trends search terms (ranks 1,2,3) for each weekday between 1‑Sep‑2024 and 14‑Sep‑2024, grouped by refresh_date and ordered descending.
SELECT "refresh_date",
       "week",
       "rank",
       "term"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DAYOFWEEK("week") BETWEEN 1 AND 5         -- Monday through Friday
  AND "rank" IN (1,2,3)                         -- top three ranks
ORDER BY "refresh_date" DESC, "week", "rank"
LIMIT 20;
```
