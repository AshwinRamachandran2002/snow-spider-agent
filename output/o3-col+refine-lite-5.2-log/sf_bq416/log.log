Query:
--Description: 7) Rank all decoded Transfer events by size (largest first) to discover
--             the biggest transfers, converting the raw value with TRY_TO_DOUBLE and
--             dividing by 1 000 000 to avoid overflow issues.
SELECT
       "BLOCK_NUMBER",
       PARSE_JSON("ARGS")[0]::STRING                                   AS "from_hex",
       PARSE_JSON("ARGS")[1]::STRING                                   AS "to_hex",
       (TRY_TO_DOUBLE(PARSE_JSON("ARGS")[2]::STRING) / 1000000)        AS "amount_usdt"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
ORDER BY "amount_usdt" DESC
LIMIT 20
