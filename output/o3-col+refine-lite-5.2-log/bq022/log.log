Query:
-- Description: 6) Tag every valid trip with a 6‑quantile bucket (NTILE)
WITH filtered AS (
  SELECT
    ROUND(trip_seconds / 60.0) AS trip_minutes,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 1 AND 3600
)
SELECT
  trip_minutes,
  fare,
  NTILE(6) OVER (ORDER BY trip_minutes) AS duration_quantile
FROM filtered
LIMIT 20;
