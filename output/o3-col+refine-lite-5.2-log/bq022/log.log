```sql
-- Description: 1) Peek at some raw taxi–trip records
SELECT 
  `unique_key`,
  `trip_start_timestamp`,
  `trip_seconds`,
  `fare`,
  `trip_total`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
-- Description: 2) Display trip length converted to minutes (rounded) together with fare
SELECT
  `unique_key`,
  ROUND(trip_seconds / 60.0) AS trip_minutes,
  `fare`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
-- Description: 3) Keep only trips that last from 0‑60 minutes (1–3 600 sec)  
SELECT
  `unique_key`,
  ROUND(trip_seconds / 60.0) AS trip_minutes,
  `fare`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 1 AND 3600   -- 0 < t ≤ 60 min
LIMIT 20;
```

```sql
-- Description: 4) Inspect distribution of rounded minutes in the 0‑60 range
SELECT
  ROUND(trip_seconds / 60.0) AS trip_minutes,
  COUNT(*) AS trips
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 1 AND 3600
GROUP BY trip_minutes
ORDER BY trip_minutes
LIMIT 20;
```

```sql
-- Description: 5) Show distinct minute‑values that will feed the quantile split
SELECT DISTINCT
  ROUND(trip_seconds / 60.0) AS trip_minutes
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 1 AND 3600
ORDER BY trip_minutes
LIMIT 20;
```

```sql
-- Description: 6) Tag every valid trip with a 6‑quantile bucket (NTILE)
WITH filtered AS (
  SELECT
    ROUND(trip_seconds / 60.0) AS trip_minutes,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 1 AND 3600
)
SELECT
  trip_minutes,
  fare,
  NTILE(6) OVER (ORDER BY trip_minutes) AS duration_quantile
FROM filtered
LIMIT 20;
```

```sql
-- Description: 7) Check min / max minutes inside each quantile bucket
WITH filtered AS (
  SELECT
    ROUND(trip_seconds / 60.0) AS trip_minutes
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 1 AND 3600
),
ranked AS (
  SELECT
    trip_minutes,
    NTILE(6) OVER (ORDER BY trip_minutes) AS duration_quantile
  FROM filtered
)
SELECT
  duration_quantile,
  MIN(trip_minutes) AS min_mins,
  MAX(trip_minutes) AS max_mins
FROM ranked
GROUP BY duration_quantile
ORDER BY duration_quantile
LIMIT 20;
```

```sql
-- Description: 8) Final answer – for each of the six equal‑frequency groups
--                report min / max trip minutes (rounded), # trips, and avg fare
WITH filtered AS (
  SELECT
    ROUND(trip_seconds / 60.0) AS trip_minutes,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 1 AND 3600            -- 0‑60 minute trips only
),
ranked AS (
  SELECT
    *,
    NTILE(6) OVER (ORDER BY trip_minutes) AS duration_quantile
  FROM filtered
)
SELECT
  duration_quantile                       AS quantile_group,
  MIN(trip_minutes)                       AS min_trip_minutes,
  MAX(trip_minutes)                       AS max_trip_minutes,
  COUNT(*)                                AS total_trips,
  AVG(fare)                               AS average_fare
FROM ranked
GROUP BY duration_quantile
ORDER BY quantile_group
LIMIT 20;        -- returns the 6 rows we need
```
