```sql
-- 4. Description: Link a driver‑standing row to its constructor via the matching “results” row
SELECT DISTINCT
       ds."race_id",
       ds."driver_id",
       r."constructor_id",
       ds."points"  AS "driver_pts_at_this_race"
FROM   "driver_standings" AS ds
JOIN   "results"          AS r
       ON r."race_id"  = ds."race_id"
      AND r."driver_id" = ds."driver_id"
LIMIT  20;
```

```sql
-- 5. Description: Identify the last (final) race of every season
SELECT DISTINCT
       r1."year",
       r1."race_id" AS "final_race_id"
FROM   "races" AS r1
JOIN  (
        SELECT "year", MAX("round") AS "max_round"
        FROM   "races"
        GROUP  BY "year"
      ) AS m
      ON  m."year"      = r1."year"
     AND m."max_round"  = r1."round"
LIMIT  20;
```

```sql
-- 6. Description: For every (year, constructor) pair, grab the **best** driver’s points at the final race
WITH final_races AS (
      SELECT r1."year", r1."race_id"
      FROM   "races" AS r1
      JOIN  (SELECT "year", MAX("round") AS "max_round"
             FROM   "races"
             GROUP  BY "year") AS m
             ON m."year"     = r1."year"
            AND m."max_round"= r1."round")
SELECT DISTINCT
       fr."year",
       res."constructor_id",
       MAX(ds."points") AS "best_driver_points"
FROM   final_races      AS fr
JOIN   "driver_standings" AS ds  ON ds."race_id" = fr."race_id"
JOIN   "results"           AS res ON res."race_id" = ds."race_id"
                                 AND res."driver_id" = ds."driver_id"
GROUP  BY fr."year", res."constructor_id"
LIMIT  20;
```

```sql
-- 7. Description: For every (year, constructor) pair, pull team (constructor) points at the final race
WITH final_races AS (
      SELECT r1."year", r1."race_id"
      FROM   "races" AS r1
      JOIN  (SELECT "year", MAX("round") AS "max_round"
             FROM   "races"
             GROUP  BY "year") AS m
             ON m."year"      = r1."year"
            AND m."max_round" = r1."round")
SELECT DISTINCT
       fr."year",
       cs."constructor_id",
       cs."points" AS "team_points"
FROM   final_races          AS fr
JOIN   "constructor_standings" AS cs
       ON cs."race_id" = fr."race_id"
LIMIT  20;
```

```sql
-- 8. Description: Combine (best‑driver points + team points) for every constructor‑season
WITH final_races AS (
      SELECT r1."year", r1."race_id"
      FROM   "races" AS r1
      JOIN  (SELECT "year", MAX("round") AS "max_round"
             FROM   "races"
             GROUP  BY "year") AS m
             ON m."year"      = r1."year"
            AND m."max_round" = r1."round"
),
driver_best AS (
      SELECT fr."year",
             res."constructor_id",
             MAX(ds."points") AS "best_driver_points"
      FROM   final_races      AS fr
      JOIN   "driver_standings" AS ds  ON ds."race_id" = fr."race_id"
      JOIN   "results"           AS res ON res."race_id"  = ds."race_id"
                                       AND res."driver_id" = ds."driver_id"
      GROUP  BY fr."year", res."constructor_id"
),
team_pts AS (
      SELECT fr."year",
             cs."constructor_id",
             cs."points" AS "team_points"
      FROM   final_races             AS fr
      JOIN   "constructor_standings" AS cs
             ON cs."race_id" = fr."race_id"
)
SELECT DISTINCT
       db."year",
       db."constructor_id",
       db."best_driver_points" + tp."team_points" AS "combined_points"
FROM   driver_best AS db
JOIN   team_pts    AS tp
       ON tp."year" = db."year"
      AND tp."constructor_id" = db."constructor_id"
LIMIT  20;
```

```sql
-- 9. Description: Retrieve the TOP‑3 constructor‑seasons by combined (best‑driver + team) points
WITH final_races AS (
      SELECT r1."year", r1."race_id"
      FROM   "races" AS r1
      JOIN  (SELECT "year", MAX("round") AS "max_round"
             FROM   "races"
             GROUP  BY "year") AS m
             ON m."year"      = r1."year"
            AND m."max_round" = r1."round"
),
driver_best AS (
      SELECT fr."year",
             res."constructor_id",
             MAX(ds."points") AS "best_driver_points"
      FROM   final_races      AS fr
      JOIN   "driver_standings" AS ds  ON ds."race_id" = fr."race_id"
      JOIN   "results"           AS res ON res."race_id"  = ds."race_id"
                                       AND res."driver_id" = ds."driver_id"
      GROUP  BY fr."year", res."constructor_id"
),
team_pts AS (
      SELECT fr."year",
             cs."constructor_id",
             cs."points" AS "team_points"
      FROM   final_races             AS fr
      JOIN   "constructor_standings" AS cs
             ON cs."race_id" = fr."race_id"
),
combined AS (
      SELECT db."year",
             db."constructor_id",
             db."best_driver_points" + tp."team_points" AS "combined_points"
      FROM   driver_best AS db
      JOIN   team_pts    AS tp
             ON tp."year" = db."year"
            AND tp."constructor_id" = db."constructor_id"
)
SELECT DISTINCT
       c."name"            AS "constructor_name",
       comb."year",
       comb."combined_points"
FROM   combined      AS comb
JOIN   "constructors" AS c
       ON c."constructor_id" = comb."constructor_id"
ORDER  BY comb."combined_points" DESC
LIMIT  3;
```
