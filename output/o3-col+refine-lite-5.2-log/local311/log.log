      JOIN   "driver_standings" AS ds  ON ds."race_id" = fr."race_id"
      JOIN   "results"           AS res ON res."race_id"  = ds."race_id"
                                       AND res."driver_id" = ds."driver_id"
      GROUP  BY fr."year", res."constructor_id"
),
team_pts AS (
      SELECT fr."year",
             cs."constructor_id",
             cs."points" AS "team_points"
      FROM   final_races             AS fr
      JOIN   "constructor_standings" AS cs
             ON cs."race_id" = fr."race_id"
),
combined AS (
      SELECT db."year",
             db."constructor_id",
             db."best_driver_points" + tp."team_points" AS "combined_points"
      FROM   driver_best AS db
      JOIN   team_pts    AS tp
             ON tp."year" = db."year"
            AND tp."constructor_id" = db."constructor_id"
)
SELECT DISTINCT
       c."name"            AS "constructor_name",
       comb."year",
       comb."combined_points"
FROM   combined      AS comb
JOIN   "constructors" AS c
       ON c."constructor_id" = comb."constructor_id"
ORDER  BY comb."combined_points" DESC
LIMIT  3;
