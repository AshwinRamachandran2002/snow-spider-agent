```sql
-- Description: 1) Look at the different industries we have
SELECT DISTINCT "industry"
FROM "companies_industries"
LIMIT 20;
```

```sql
-- Description: 2) Inspect a few funding‐round valuations (to see which are ≥ $1 B i.e. unicorns)
SELECT "company_id",
       "valuation",
       "funding"
FROM "companies_funding"
ORDER BY "valuation" DESC
LIMIT 20;
```

```sql
-- Description: 3) Show 20 companies that (a) have a valuation ≥ $1 B and (b) have an industry tag
SELECT fi."company_id",
       fi."valuation",
       ind."industry"
FROM   "companies_funding"  AS fi
JOIN   "companies_industries" AS ind
       ON fi."company_id" = ind."company_id"
WHERE  fi."valuation" >= 1000000000
LIMIT 20;
```

```sql
-- Description: 4) Count unicorns by industry (all years) – to see which industry is “top”
SELECT ind."industry",
       COUNT(*) AS "unicorn_cnt"
FROM   "companies_funding"  AS fi
JOIN   "companies_industries" AS ind
       ON fi."company_id" = ind."company_id"
WHERE  fi."valuation" >= 1000000000
GROUP  BY ind."industry"
ORDER  BY "unicorn_cnt" DESC
LIMIT 20;
```

```sql
-- Description: 5) Attach joining dates, keep only 2019‑2021 window
SELECT d."company_id",
       substr(d."date_joined",1,4) AS "year_joined",
       ind."industry",
       fi."valuation"
FROM   "companies_dates"       AS d
JOIN   "companies_funding"     AS fi
       ON d."company_id" = fi."company_id"
JOIN   "companies_industries"  AS ind
       ON d."company_id" = ind."company_id"
WHERE  fi."valuation" >= 1000000000
  AND  substr(d."date_joined",1,4) BETWEEN '2019' AND '2021'
LIMIT 20;
```

```sql
-- Description: 6) Count unicorns per industry only for 2019‑2021 window
SELECT ind."industry",
       COUNT(*) AS "unicorns_2019_2021"
FROM   "companies_dates"      AS d
JOIN   "companies_funding"    AS fi
       ON d."company_id" = fi."company_id"
JOIN   "companies_industries" AS ind
       ON d."company_id" = ind."company_id"
WHERE  fi."valuation" >= 1000000000
  AND  substr(d."date_joined",1,4) BETWEEN '2019' AND '2021'
GROUP  BY ind."industry"
ORDER  BY "unicorns_2019_2021" DESC
LIMIT 20;
```

```sql
-- Description: 7) Suppose the top industry is ‘Fintech’ (check previous result), 
--   count new unicorns per year for that industry
SELECT substr(d."date_joined",1,4) AS "yr",
       COUNT(*)                    AS "fintech_unicorns"
FROM   "companies_dates"      AS d
JOIN   "companies_funding"    AS fi
       ON d."company_id" = fi."company_id"
JOIN   "companies_industries" AS ind
       ON d."company_id" = ind."company_id"
WHERE  fi."valuation" >= 1000000000
  AND  ind."industry" = 'Fintech'
  AND  substr(d."date_joined",1,4) BETWEEN '2019' AND '2021'
GROUP  BY "yr"
ORDER  BY "yr"
LIMIT 20;
```

```sql
-- Description: 8) Compute the average number of new Fintech unicorns per year (2019‑2021)
SELECT avg(cnt) AS "avg_fintech_unicorns_per_year_2019_2021"
FROM (
     SELECT substr(d."date_joined",1,4) AS yr,
            COUNT(*) AS cnt
     FROM   "companies_dates"      AS d
     JOIN   "companies_funding"    AS fi
            ON d."company_id" = fi."company_id"
     JOIN   "companies_industries" AS ind
            ON d."company_id" = ind."company_id"
     WHERE  fi."valuation" >= 1000000000
       AND  ind."industry" = 'Fintech'
       AND  substr(d."date_joined",1,4) BETWEEN '2019' AND '2021'
     GROUP  BY yr
);
```

```sql
-- Description: 9) If a quick confirmation of final answer is desired
SELECT 'Average new unicorns (Fintech, 2019‑2021)' AS description,
       ROUND(avg(cnt),2) AS avg_per_year
FROM (
     SELECT substr(d."date_joined",1,4) AS yr,
            COUNT(*) AS cnt
     FROM   "companies_dates"      AS d
     JOIN   "companies_funding"    AS fi
            ON d."company_id" = fi."company_id"
     JOIN   "companies_industries" AS ind
            ON d."company_id" = ind."company_id"
     WHERE  fi."valuation" >= 1000000000
       AND  ind."industry" = 'Fintech'
       AND  substr(d."date_joined",1,4) BETWEEN '2019' AND '2021'
     GROUP  BY yr
);
```

```sql
-- Description: 10) (Optional) Show counts for every industry side‑by‑side to verify the top one
SELECT substr(d."date_joined",1,4) AS "yr",
       ind."industry",
       COUNT(*) AS "unicorns"
FROM   "companies_dates"      AS d
JOIN   "companies_funding"    AS fi
       ON d."company_id" = fi."company_id"
JOIN   "companies_industries" AS ind
       ON d."company_id" = ind."company_id"
WHERE  fi."valuation" >= 1000000000
  AND  substr(d."date_joined",1,4) BETWEEN '2019' AND '2021'
GROUP  BY "yr", ind."industry"
ORDER  BY ind."industry", "yr"
LIMIT 20;
```

These 10 progressively build up from exploring the data to identifying the top industry (Fintech, in this example) and finally computing the average number of new unicorns per year (2019–2021) for that top industry.
