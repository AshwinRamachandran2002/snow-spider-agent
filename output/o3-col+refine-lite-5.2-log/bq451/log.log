Query:
--Description: 10) OPTIONAL – join the per‑sample chr X summary (query 9 without its LIMIT)
--              to sample metadata to include super‑population information.  The CTE
--              “agg” reproduces query 9 (without LIMIT); the final SELECT joins it
--              to `sample_info` and shows 20 rows.
WITH classified AS (
  SELECT
    c.call_set_name AS sample_id,
    CASE
      WHEN c.genotype[OFFSET(0)] = 0
           AND c.genotype[SAFE_OFFSET(1)] IS NOT NULL
           AND c.genotype[SAFE_OFFSET(1)] = 0                      THEN 'hom_ref'
      WHEN c.genotype[OFFSET(0)] > 0
           AND c.genotype[SAFE_OFFSET(1)] IS NOT NULL
           AND c.genotype[OFFSET(0)] = c.genotype[SAFE_OFFSET(1)]  THEN 'hom_alt'
      ELSE                                                           'het'
    END AS class
  FROM   `genomics-public-data.1000_genomes.variants` AS v
  JOIN   UNNEST(v.call) AS c
  WHERE  v.reference_name = 'X'
    AND  ARRAY_LENGTH(c.genotype) >= 1
    AND  NOT ( (v.start BETWEEN  59999     AND  2699519)     -- exclude PAR‑1
            OR (v.start BETWEEN 154931042  AND 155260559) )  -- exclude PAR‑2 / XTR
    AND  ARRAY_LENGTH(v.alternate_bases) = 1
    AND  LENGTH(v.reference_bases)       = 1
    AND  LENGTH(v.alternate_bases[OFFSET(0)]) = 1
),
agg AS (
  SELECT
    sample_id,
    COUNT(*)                                AS callable_sites,
    SUM(IF(class = 'hom_ref', 1, 0))        AS hom_ref_cnt,
    SUM(IF(class = 'hom_alt', 1, 0))        AS hom_alt_cnt,
    SUM(IF(class = 'het',      1, 0))       AS het_cnt,
    SUM(IF(class IN ('hom_alt','het'), 1, 0)) AS snv_cnt
  FROM classified
  GROUP BY sample_id
)
SELECT
  a.sample_id,
  si.Super_Population,
  a.callable_sites,
  a.hom_ref_cnt,
  a.hom_alt_cnt,
  a.het_cnt,
  a.snv_cnt,
  ROUND(100 * a.het_cnt     / NULLIF(a.snv_cnt, 0), 2) AS pct_het_among_snvs,
  ROUND(100 * a.hom_alt_cnt / NULLIF(a.snv_cnt, 0), 2) AS pct_hom_alt_among_snvs
FROM agg AS a
LEFT JOIN `genomics-public-data.1000_genomes.sample_info` AS si
  ON a.sample_id = si.Sample
ORDER BY pct_het_among_snvs DESC, a.sample_id
LIMIT 20
