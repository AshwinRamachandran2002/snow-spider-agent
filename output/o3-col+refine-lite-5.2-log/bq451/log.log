FROM   `spider2-public-data.1000_genomes.variants`
WHERE  `reference_name` = 'X'
  AND  ARRAY_LENGTH(`alternate_bases`) = 1
  AND  LENGTH(`reference_bases`)      = 1
  AND  LENGTH(`alternate_bases`[OFFSET(0)]) = 1
LIMIT 20;
```

```sql
--Description: 6) Unnest a few genotype calls on chr X SNVs (callable region only)  
SELECT v.`start`,
       c.`call_set_name`  AS sample,
       c.`genotype`
FROM   `spider2-public-data.1000_genomes.variants`  AS v
JOIN   UNNEST(v.`call`)                            AS c
WHERE  v.`reference_name` = 'X'
  AND  ARRAY_LENGTH(c.`genotype`) >= 1                 -- callable sites
  AND  NOT( (v.`start` BETWEEN 59999     AND 2699519)
        OR (v.`start` BETWEEN 154931042 AND 155260559) )
  AND  ARRAY_LENGTH(v.`alternate_bases`) = 1           -- SNV only
  AND  LENGTH(v.`reference_bases`)      = 1
  AND  LENGTH(v.`alternate_bases`[OFFSET(0)]) = 1
LIMIT 20;
```

```sql
--Description: 7) Classify a few genotype calls (homo‑ref / homo‑alt / het)  
SELECT c.`call_set_name` AS sample,
       c.`genotype`,
       CASE
         WHEN c.`genotype`[OFFSET(0)] = 0
          AND SAFE_OFFSET(c.`genotype`,1) IS NOT NULL
          AND c.`genotype`[OFFSET(1)]   = 0                       THEN 'hom_ref'
         WHEN c.`genotype`[OFFSET(0)] > 0
          AND c.`genotype`[OFFSET(0)]   = SAFE_OFFSET(c.`genotype`,1)
          AND SAFE_OFFSET(c.`genotype`,1) IS NOT NULL             THEN 'hom_alt'
         ELSE                                                         'het'
       END AS class
FROM   `spider2-public-data.1000_genomes.variants` AS v
JOIN   UNNEST(v.`call`)                            AS c
WHERE  v.`reference_name` = 'X'
  AND  ARRAY_LENGTH(c.`genotype`) >= 1
  AND  NOT( (v.`start` BETWEEN 59999     AND 2699519)
        OR (v.`start` BETWEEN 154931042 AND 155260559) )
  AND  ARRAY_LENGTH(v.`alternate_bases`) = 1
  AND  LENGTH(v.`reference_bases`)      = 1
  AND  LENGTH(v.`alternate_bases`[OFFSET(0)]) = 1
LIMIT 20;
```

```sql
--Description: 8) Quick per‑sample aggregation on a small slice (first 1 Mbp)  
SELECT c.`call_set_name`                    AS sample_id,
       COUNT(*)                             AS callable_sites,
       SUM( IF(class = 'hom_ref',1,0) )    AS hom_ref_cnt,
       SUM( IF(class = 'hom_alt',1,0) )    AS hom_alt_cnt,
       SUM( IF(class = 'het'    ,1,0) )    AS het_cnt
FROM (
  SELECT v.`start`,
         c.`call_set_name`,
         c.`genotype`,
         CASE
           WHEN c.`genotype`[OFFSET(0)] = 0
            AND SAFE_OFFSET(c.`genotype`,1) IS NOT NULL
            AND c.`genotype`[OFFSET(1)] = 0                THEN 'hom_ref'
           WHEN c.`genotype`[OFFSET(0)] > 0
            AND c.`genotype`[OFFSET(0)]   = SAFE_OFFSET(c.`genotype`,1)
            AND SAFE_OFFSET(c.`genotype`,1) IS NOT NULL    THEN 'hom_alt'
           ELSE                                                'het'
         END AS class
  FROM   `spider2-public-data.1000_genomes.variants` AS v
  JOIN   UNNEST(v.`call`)                            AS c
  WHERE  v.`reference_name` = 'X'
    AND  v.`start` < 1000000                          -- small slice
    AND  ARRAY_LENGTH(c.`genotype`) >= 1
    AND  NOT( (v.`start` BETWEEN 59999 AND 2699519)
          OR  (v.`start` BETWEEN 154931042 AND 155260559) )
    AND  ARRAY_LENGTH(v.`alternate_bases`) = 1
    AND  LENGTH(v.`reference_bases`)      = 1
    AND  LENGTH(v.`alternate_bases`[OFFSET(0)]) = 1
) t
GROUP BY sample_id
LIMIT 20;
```

```sql
--Description: 9) FINAL ANSWER – counts & percentages for every sample on chr X  
SELECT
  sample_id,
  callable_sites,
  hom_ref_cnt,
  hom_alt_cnt,
  het_cnt,
  (hom_alt_cnt + het_cnt)                               AS snv_cnt,
  ROUND( (het_cnt      / NULLIF(hom_alt_cnt + het_cnt,0)) * 100, 2) AS pct_het_among_snvs,
  ROUND( (hom_alt_cnt  / NULLIF(hom_alt_cnt + het_cnt,0)) * 100, 2) AS pct_hom_alt_among_snvs
FROM (
  SELECT
    c.`call_set_name` AS sample_id,
    COUNT(*)                                   AS callable_sites,
    SUM( IF(class = 'hom_ref',1,0) )           AS hom_ref_cnt,
    SUM( IF(class = 'hom_alt',1,0) )           AS hom_alt_cnt,
    SUM( IF(class = 'het'    ,1,0) )           AS het_cnt
  FROM (
    SELECT
      v.`start`,
      c.`call_set_name`,
      CASE
        WHEN c.`genotype`[OFFSET(0)] = 0
         AND SAFE_OFFSET(c.`genotype`,1) IS NOT NULL
         AND c.`genotype`[OFFSET(1)]   = 0                 THEN 'hom_ref'
        WHEN c.`genotype`[OFFSET(0)] > 0
         AND c.`genotype`[OFFSET(0)]   = SAFE_OFFSET(c.`genotype`,1)
         AND SAFE_OFFSET(c.`genotype`,1) IS NOT NULL       THEN 'hom_alt'
        ELSE                                                  'het'
      END AS class
    FROM   `spider2-public-data.1000_genomes.variants` AS v
    JOIN   UNNEST(v.`call`)                            AS c
    WHERE  v.`reference_name` = 'X'
      AND  ARRAY_LENGTH(c.`genotype`) >= 1
      AND  NOT( (v.`start` BETWEEN 59999     AND 2699519)
            OR  (v.`start` BETWEEN 154931042 AND 155260559) )
      AND  ARRAY_LENGTH(v.`alternate_bases`) = 1
      AND  LENGTH(v.`reference_bases`)      = 1
      AND  LENGTH(v.`alternate_bases`[OFFSET(0)]) = 1
  )  AS sub
  GROUP BY sample_id
)
ORDER BY pct_het_among_snvs DESC, sample_id
LIMIT 20;
```

```sql
--Description: 10) OPTIONAL – join the summary with sample meta‑data  
SELECT s.sample_id,
       si.`Super_Population`,
       s.callable_sites,
       s.hom_ref_cnt,
       s.hom_alt_cnt,
       s.het_cnt,
       s.snv_cnt,
       s.pct_het_among_snvs,
       s.pct_hom_alt_among_snvs
FROM (
  /* paste the FINAL query (9) here without LIMIT for the sub‑query */ ) AS s
LEFT JOIN `spider2-public-data.1000_genomes.sample_info` AS si
ON  s.sample_id = si.`Sample`
ORDER BY s.pct_het_among_snvs DESC, s.sample_id
LIMIT 20;
```

The ninth query produces the requested per‑sample counts and percentages for callable X‑chromosome SNVs (outside the excluded regions), ordered by the heterozygous percentage among SNVs.
