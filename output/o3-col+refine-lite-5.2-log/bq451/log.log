```sql
--Description:  Build the result in two steps.  
--  1) CTE “classified” – for every genotype call on chromosome X, keep only true
--     single‑nucleotide variants (1‑bp ref + alt) that lie outside the two
--     pseudo‑autosomal / X‑transposed regions.  Each call is labelled as:
--          • hom_ref  – both alleles = 0  
--          • hom_alt  – both alleles identical and > 0  
--          • het      – everything else (includes single‑allele calls, e.g. males)  
--     SAFE_OFFSET is used inside the bracket accessor to avoid out‑of‑bounds errors.
--  2) CTE “agg” – aggregate those labels per sample, counting callable sites and
--     the three genotype categories.
--  The final SELECT adds total SNV counts (hom_alt + het) and derives percentage
--  metrics, then orders samples by heterozygous percentage (descending) and
--  sample ID.  LIMIT 20 shows a preview.
WITH classified AS (
  SELECT
    c.call_set_name AS sample_id,
    CASE
      WHEN c.genotype[OFFSET(0)] = 0
           AND c.genotype[SAFE_OFFSET(1)] IS NOT NULL
           AND c.genotype[SAFE_OFFSET(1)] = 0                      THEN 'hom_ref'
      WHEN c.genotype[OFFSET(0)] > 0
           AND c.genotype[SAFE_OFFSET(1)] IS NOT NULL
           AND c.genotype[OFFSET(0)] = c.genotype[SAFE_OFFSET(1)]  THEN 'hom_alt'
      ELSE                                                           'het'
    END AS class
  FROM   `genomics-public-data.1000_genomes.variants` AS v
  JOIN   UNNEST(v.call) AS c
  WHERE  v.reference_name = 'X'
    AND  ARRAY_LENGTH(c.genotype) >= 1                       -- callable
    AND  NOT ( (v.start BETWEEN  59999     AND  2699519)     -- exclude PAR‑1
            OR (v.start BETWEEN 154931042  AND 155260559) )  -- exclude PAR‑2 / XTR
    AND  ARRAY_LENGTH(v.alternate_bases) = 1                 -- SNV only
    AND  LENGTH(v.reference_bases)       = 1
    AND  LENGTH(v.alternate_bases[OFFSET(0)]) = 1
),
agg AS (
  SELECT
    sample_id,
    COUNT(*)                                AS callable_sites,
    SUM(IF(class = 'hom_ref', 1, 0))        AS hom_ref_cnt,
    SUM(IF(class = 'hom_alt', 1, 0))        AS hom_alt_cnt,
    SUM(IF(class = 'het',      1, 0))       AS het_cnt
  FROM classified
  GROUP BY sample_id
)
SELECT
  sample_id,
  callable_sites,
  hom_ref_cnt,
  hom_alt_cnt,
  het_cnt,
  hom_alt_cnt + het_cnt                                       AS snv_cnt,
  ROUND(100 * het_cnt     / NULLIF(hom_alt_cnt + het_cnt, 0), 2) AS pct_het_among_snvs,
  ROUND(100 * hom_alt_cnt / NULLIF(hom_alt_cnt + het_cnt, 0), 2) AS pct_hom_alt_among_snvs
FROM agg
ORDER BY pct_het_among_snvs DESC, sample_id
LIMIT 20;
