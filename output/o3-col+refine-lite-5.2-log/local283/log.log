Query:
--Description: Identify (ties allowed) the team(s) with the maximum points for every league & season.
WITH match_points AS (
       SELECT "season",
              "league_id",
              "home_team_api_id" AS team_api_id,
              CASE
                   WHEN "home_team_goal" > "away_team_goal" THEN 3
                   WHEN "home_team_goal" = "away_team_goal" THEN 1
                   ELSE 0
              END AS pts
       FROM   "Match"
       UNION ALL
       SELECT "season",
              "league_id",
              "away_team_api_id",
              CASE
                   WHEN "away_team_goal" > "home_team_goal" THEN 3
                   WHEN "away_team_goal" = "home_team_goal" THEN 1
                   ELSE 0
              END
       FROM   "Match"
), team_points AS (
       SELECT "season",
              "league_id",
              "team_api_id",
              SUM(pts) AS total_points
       FROM   match_points
       GROUP  BY "season", "league_id", "team_api_id"
), max_points AS (
       SELECT "season",
              "league_id",
              MAX(total_points) AS max_pts
       FROM   team_points
       GROUP  BY "season", "league_id"
)
SELECT tp.*
FROM   team_points AS tp
JOIN   max_points AS mp
       ON tp."season"     = mp."season"
      AND tp."league_id"  = mp."league_id"
      AND tp.total_points = mp.max_pts
LIMIT 20;
