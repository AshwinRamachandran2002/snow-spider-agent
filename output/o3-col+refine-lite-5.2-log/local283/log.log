Query:
--Description: Final query – return each season’s champion team, its league, country, and total points.
WITH match_points AS (
       SELECT "season",
              "league_id",
              "home_team_api_id" AS team_api_id,
              CASE
                   WHEN "home_team_goal" > "away_team_goal" THEN 3
                   WHEN "home_team_goal" = "away_team_goal" THEN 1
                   ELSE 0
              END AS pts
       FROM   "Match"
       UNION ALL
       SELECT "season",
              "league_id",
              "away_team_api_id",
              CASE
                   WHEN "away_team_goal" > "home_team_goal" THEN 3
                   WHEN "away_team_goal" = "home_team_goal" THEN 1
                   ELSE 0
              END
       FROM   "Match"
), team_points AS (
       SELECT "season",
              "league_id",
              "team_api_id",
              SUM(pts) AS total_points
       FROM   match_points
       GROUP  BY "season", "league_id", "team_api_id"
), champions AS (
       SELECT tp.*
       FROM   team_points AS tp
       JOIN  (SELECT "season",
                     "league_id",
                     MAX(total_points) AS max_pts
              FROM   team_points
              GROUP  BY "season", "league_id") AS mx
              ON tp."season"     = mx."season"
             AND tp."league_id"  = mx."league_id"
             AND tp.total_points = mx.max_pts
)
SELECT ch."season",
       c."name"        AS country,
       l."name"        AS league,
       t."team_long_name" AS champion_team,
       ch.total_points
FROM   champions AS ch
JOIN   "League"  AS l ON ch."league_id"  = l."id"
JOIN   "Country" AS c ON l."country_id" = c."id"
JOIN   "Team"    AS t ON ch."team_api_id" = t."team_api_id"
ORDER  BY ch."season", country, league
LIMIT 20;
Answer:
season,country,league,champion_team,total_points
