2025-05-02 04:41:07 - ThreadPoolExecutor-0_29 - INFO - [Exploration]
```sql
-- 1. List all the distinct customer countries
SELECT DISTINCT "Country"
FROM "customers"
LIMIT 20;
```

```sql
-- 2. Count of customers per country, highest first
SELECT "Country",
       COUNT(*) AS "num_customers"
FROM   "customers"
GROUP  BY "Country"
ORDER  BY "num_customers" DESC
LIMIT 20;
```

```sql
-- 3. Countries where the number of customers is greater than 4
SELECT "Country"
FROM   "customers"
GROUP  BY "Country"
HAVING COUNT(*) > 4
LIMIT 20;
```

```sql
-- 4. Invoices joined to customers in order to see totals together with their countries
SELECT i."InvoiceId",
       i."Total",
       c."Country"
FROM   "invoices"  AS i
JOIN   "customers" AS c
       ON i."CustomerId" = c."CustomerId"
LIMIT 20;
```

```sql
-- 5. Total sales (sum of invoice totals) for every country
SELECT c."Country",
       SUM(i."Total") AS "total_sales"
FROM   "customers" AS c
JOIN   "invoices"  AS i
       ON c."CustomerId" = i."CustomerId"
GROUP  BY c."Country"
ORDER  BY "total_sales" DESC
LIMIT 20;
```

```sql
-- 6. Same as query 5, but keep only the countries that have more than 4 customers
SELECT c."Country",
       SUM(i."Total") AS "total_sales"
FROM   "customers" AS c
JOIN   "invoices"  AS i
       ON c."CustomerId" = i."CustomerId"
GROUP  BY c."Country"
HAVING COUNT(DISTINCT c."CustomerId") > 4
ORDER  BY "total_sales" DESC
LIMIT 20;
```

```sql
-- 7. Rank those country‑level sales from smallest to largest
WITH country_sales AS (
  SELECT c."Country",
         SUM(i."Total") AS "total_sales"
  FROM   "customers" AS c
  JOIN   "invoices"  AS i
         ON c."CustomerId" = i."CustomerId"
  GROUP  BY c."Country"
  HAVING COUNT(DISTINCT c."CustomerId") > 4
)
SELECT "Country",
       "total_sales",
       ROW_NUMBER() OVER (ORDER BY "total_sales") AS "rn"
FROM   country_sales
ORDER  BY "total_sales"
LIMIT 20;
```

```sql
-- 8. Final answer – the median total sales among countries having >4 customers
WITH country_sales AS (
  SELECT c."Country",
         SUM(i."Total") AS "total_sales"
  FROM   "customers" AS c
  JOIN   "invoices"  AS i
         ON c."CustomerId" = i."CustomerId"
  GROUP  BY c."Country"
  HAVING COUNT(DISTINCT c."CustomerId") > 4
),
ordered_sales AS (
  SELECT "total_sales",
         ROW_NUMBER() OVER (ORDER BY "total_sales")          AS "rn",
         COUNT(*)     OVER ()                                AS "cnt"
  FROM   country_sales
)
SELECT AVG("total_sales") AS "median_total_sales"
FROM   ordered_sales
WHERE  "rn" IN ( (cnt + 1) / 2,      -- middle row for odd count
                 (cnt + 2) / 2 );    -- upper-middle row for even count
```

The last query returns the median value of total sales made in those countries that have more than four customers.
