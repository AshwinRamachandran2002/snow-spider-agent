Query:
-- 6. Fetch, for every customer, the rating of the film in their FIRST payment
WITH first_pay AS (
    SELECT p.*,
           ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY payment_date) AS rn
    FROM payment AS p
)
SELECT fp.customer_id,
       f.rating,
       f.title,
       fp.payment_date
FROM first_pay AS fp
JOIN rental    AS r ON r.rental_id = fp.rental_id
JOIN inventory AS i ON i.inventory_id = r.inventory_id
JOIN film      AS f ON f.film_id = i.film_id
WHERE fp.rn = 1
LIMIT 20;
