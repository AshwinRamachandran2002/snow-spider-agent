Query:
-- 8. Build per‑customer metrics: rating of first film, total $ spent, and subsequent rentals
WITH first_payment AS (
    SELECT customer_id,
           MIN(payment_date) AS first_payment_date
    FROM payment
    GROUP BY customer_id
),
first_film AS (
    SELECT fp.customer_id,
           f.rating
    FROM first_payment AS fp
    JOIN payment   AS p ON p.customer_id = fp.customer_id
                       AND p.payment_date = fp.first_payment_date
    JOIN rental    AS r ON r.rental_id = p.rental_id
    JOIN inventory AS i ON i.inventory_id = r.inventory_id
    JOIN film      AS f ON f.film_id = i.film_id
),
cust_totals AS (
    SELECT p.customer_id,
           SUM(p.amount) AS total_amount_spent,
           COUNT(DISTINCT r.rental_id) AS total_rentals
    FROM payment AS p
    JOIN rental  AS r ON r.rental_id = p.rental_id
    GROUP BY p.customer_id
)
SELECT ft.customer_id,
       ft.rating                     AS first_rating,
       ct.total_amount_spent,
       (ct.total_rentals - 1)        AS subsequent_rentals
FROM first_film AS ft
JOIN cust_totals AS ct ON ct.customer_id = ft.customer_id
LIMIT 20;
