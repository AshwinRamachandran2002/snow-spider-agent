```sql
-- 1. Explore the possible ratings a film can have
SELECT DISTINCT rating
FROM film
LIMIT 20;
```

```sql
-- 2. Look at how a payment is connected to a rental
SELECT p.payment_id,
       p.customer_id,
       p.amount,
       p.payment_date,
       r.rental_date,
       r.inventory_id
FROM payment AS p
JOIN rental  AS r ON r.rental_id = p.rental_id
LIMIT 20;
```

```sql
-- 3. Inspect the payment history of a single customer (customer_id = 1)  
SELECT p.payment_id,
       p.amount,
       p.payment_date
FROM payment AS p
WHERE p.customer_id = 1
ORDER BY p.payment_date
LIMIT 20;
```

```sql
-- 4. Earliest payment date per customer (i.e., first‐ever payment)  
SELECT customer_id,
       MIN(payment_date) AS first_payment_date
FROM payment
GROUP BY customer_id
LIMIT 20;
```

```sql
-- 5. Walk the whole chain payment ➜ rental ➜ inventory ➜ film to see the rating attached to each payment
SELECT p.payment_id,
       p.customer_id,
       p.payment_date,
       f.film_id,
       f.rating,
       f.title
FROM payment   AS p
JOIN rental    AS r ON r.rental_id   = p.rental_id
JOIN inventory AS i ON i.inventory_id = r.inventory_id
JOIN film      AS f ON f.film_id     = i.film_id
LIMIT 20;
```

```sql
-- 6. Fetch, for every customer, the rating of the film in their FIRST payment
WITH first_pay AS (
    SELECT p.*,
           ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY payment_date) AS rn
    FROM payment AS p
)
SELECT fp.customer_id,
       f.rating,
       f.title,
       fp.payment_date
FROM first_pay AS fp
JOIN rental    AS r ON r.rental_id = fp.rental_id
JOIN inventory AS i ON i.inventory_id = r.inventory_id
JOIN film      AS f ON f.film_id = i.film_id
WHERE fp.rn = 1
LIMIT 20;
```

```sql
-- 7. Total number of rentals each customer has ever made
SELECT customer_id,
       COUNT(*) AS total_rentals
FROM rental
GROUP BY customer_id
LIMIT 20;
```

```sql
-- 8. Build per‑customer metrics: rating of first film, total $ spent, and subsequent rentals
WITH first_payment AS (
    SELECT customer_id,
           MIN(payment_date) AS first_payment_date
    FROM payment
    GROUP BY customer_id
),
first_film AS (
    SELECT fp.customer_id,
           f.rating
    FROM first_payment AS fp
    JOIN payment   AS p ON p.customer_id = fp.customer_id
                       AND p.payment_date = fp.first_payment_date
    JOIN rental    AS r ON r.rental_id = p.rental_id
    JOIN inventory AS i ON i.inventory_id = r.inventory_id
    JOIN film      AS f ON f.film_id = i.film_id
),
cust_totals AS (
    SELECT p.customer_id,
           SUM(p.amount) AS total_amount_spent,
           COUNT(DISTINCT r.rental_id) AS total_rentals
    FROM payment AS p
    JOIN rental  AS r ON r.rental_id = p.rental_id
    GROUP BY p.customer_id
)
SELECT ft.customer_id,
       ft.rating                     AS first_rating,
       ct.total_amount_spent,
       (ct.total_rentals - 1)        AS subsequent_rentals
FROM first_film AS ft
JOIN cust_totals AS ct ON ct.customer_id = ft.customer_id
LIMIT 20;
```

```sql
-- 9. Average metrics per rating of the first rented film
WITH first_payment AS (
    SELECT customer_id,
           MIN(payment_date) AS first_payment_date
    FROM payment
    GROUP BY customer_id
),
first_film AS (
    SELECT fp.customer_id,
           f.rating
    FROM first_payment AS fp
    JOIN payment   AS p ON p.customer_id = fp.customer_id
                       AND p.payment_date = fp.first_payment_date
    JOIN rental    AS r ON r.rental_id = p.rental_id
    JOIN inventory AS i ON i.inventory_id = r.inventory_id
    JOIN film      AS f ON f.film_id = i.film_id
),
cust_totals AS (
    SELECT p.customer_id,
           SUM(p.amount) AS total_amount_spent,
           COUNT(DISTINCT r.rental_id) AS total_rentals
    FROM payment AS p
    JOIN rental  AS r ON r.rental_id = p.rental_id
    GROUP BY p.customer_id
),
cust_metrics AS (
    SELECT ft.customer_id,
           ft.rating AS first_rating,
           ct.total_amount_spent,
           (ct.total_rentals - 1) AS subsequent_rentals
    FROM first_film AS ft
    JOIN cust_totals AS ct ON ct.customer_id = ft.customer_id
)
SELECT first_rating          AS rating,
       AVG(total_amount_spent)  AS avg_total_amount_spent,
       AVG(subsequent_rentals)  AS avg_subsequent_rentals
FROM cust_metrics
GROUP BY first_rating
LIMIT 20;
```

```sql
-- 10. Same as #9 but without LIMIT – final answer for every rating category
WITH first_payment AS (
    SELECT customer_id,
           MIN(payment_date) AS first_payment_date
    FROM payment
    GROUP BY customer_id
),
first_film AS (
    SELECT fp.customer_id,
           f.rating
    FROM first_payment AS fp
    JOIN payment   AS p ON p.customer_id = fp.customer_id
                       AND p.payment_date = fp.first_payment_date
    JOIN rental    AS r ON r.rental_id = p.rental_id
    JOIN inventory AS i ON i.inventory_id = r.inventory_id
    JOIN film      AS f ON f.film_id = i.film_id
),
cust_totals AS (
    SELECT p.customer_id,
           SUM(p.amount) AS total_amount_spent,
           COUNT(DISTINCT r.rental_id) AS total_rentals
    FROM payment AS p
    JOIN rental  AS r ON r.rental_id = p.rental_id
    GROUP BY p.customer_id
),
cust_metrics AS (
    SELECT ft.customer_id,
           ft.rating AS first_rating,
           ct.total_amount_spent,
           (ct.total_rentals - 1) AS subsequent_rentals
    FROM first_film AS ft
    JOIN cust_totals AS ct ON ct.customer_id = ft.customer_id
)
SELECT first_rating          AS rating,
       AVG(total_amount_spent)  AS avg_total_amount_spent,
       AVG(subsequent_rentals)  AS avg_subsequent_rentals
FROM cust_metrics
GROUP BY first_rating;
```
