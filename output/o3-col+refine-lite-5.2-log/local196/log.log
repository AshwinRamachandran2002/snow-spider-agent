-- 5. Walk the whole chain payment ➜ rental ➜ inventory ➜ film to see the rating attached to each payment
SELECT p.payment_id,
       p.customer_id,
       p.payment_date,
       f.film_id,
       f.rating,
       f.title
FROM payment   AS p
JOIN rental    AS r ON r.rental_id   = p.rental_id
JOIN inventory AS i ON i.inventory_id = r.inventory_id
JOIN film      AS f ON f.film_id     = i.film_id
LIMIT 20;
