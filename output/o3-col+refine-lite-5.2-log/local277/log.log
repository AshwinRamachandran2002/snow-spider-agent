```sql
-- 6. Regression parameters (slope & intercept) for 4160 using seasonality window 7‑30
WITH seq AS (
  SELECT ROW_NUMBER() OVER (ORDER BY mth) AS t, qty
  FROM monthly_sales
  WHERE product_id = 4160
    AND mth >= '2016-01-01'
  ORDER BY mth
  LIMIT 36
), season AS (
  SELECT * FROM seq WHERE t BETWEEN 7 AND 30
), agg AS (
  SELECT COUNT(*)               AS n,
         SUM(t*qty)             AS sum_xy,
         SUM(t)                 AS sum_x,
         SUM(qty)               AS sum_y,
         SUM(t*t)               AS sum_x2
  FROM season
)
SELECT
  ( (n*sum_xy - sum_x*sum_y) / (n*sum_x2 - sum_x*sum_x) )                               AS slope,
  ( sum_y - ( (n*sum_xy - sum_x*sum_y) / (n*sum_x2 - sum_x*sum_x) )*sum_x ) / n         AS intercept
FROM agg;
```

