```sql
-- Description: Combine high‑rated movies with their genres to see what a joined row looks like.
SELECT g."movie_id",
       g."genre"
FROM   "genre"   AS g
JOIN   "ratings" AS r ON r."movie_id" = g."movie_id"
WHERE  r."avg_rating" > 8
LIMIT 20;
```

```sql
-- Description: Count how many >8‑rated movies fall into each genre.
SELECT g."genre",
       COUNT(*) AS "high_rated_movies"
FROM   "genre"   AS g
JOIN   "ratings" AS r ON r."movie_id" = g."movie_id"
WHERE  r."avg_rating" > 8
GROUP  BY g."genre"
ORDER  BY "high_rated_movies" DESC
LIMIT 20;
```

```sql
-- Description: Retrieve the TOP 3 genres that contain the most >8‑rated movies.
SELECT g."genre",
       COUNT(*) AS "high_rated_movies"
FROM   "genre"   AS g
JOIN   "ratings" AS r ON r."movie_id" = g."movie_id"
WHERE  r."avg_rating" > 8
GROUP  BY g."genre"
ORDER  BY "high_rated_movies" DESC
LIMIT 3;
```

```sql
-- Description: Preview which directors (by name_id) are attached to high‑rated movies.
SELECT DISTINCT dm."movie_id",
                dm."name_id"
FROM   "director_mapping" AS dm
JOIN   "ratings"          AS r  ON r."movie_id" = dm."movie_id"
WHERE  r."avg_rating" > 8
LIMIT 20;
```

```sql
-- Description: Count each director’s high‑rated (>8) films but only inside the TOP‑3 genres identified above.
SELECT dm."name_id",
       n."name",
       COUNT(*) AS "high_rated_movies_in_top_genres"
FROM   "director_mapping" AS dm
JOIN   "ratings"          AS r  ON r."movie_id" = dm."movie_id"
JOIN   "genre"            AS g  ON g."movie_id" = dm."movie_id"
JOIN   "names"            AS n  ON n."id"       = dm."name_id"
WHERE  r."avg_rating" > 8
  AND  g."genre" IN (
         SELECT g2."genre"
         FROM   "genre"   AS g2
         JOIN   "ratings" AS r2 ON r2."movie_id" = g2."movie_id"
         WHERE  r2."avg_rating" > 8
         GROUP  BY g2."genre"
         ORDER  BY COUNT(*) DESC
         LIMIT 3
       )
GROUP  BY dm."name_id"
ORDER  BY "high_rated_movies_in_top_genres" DESC
LIMIT 20;
```

```sql
-- Description: FINAL ANSWER ⟶ Top 4 directors who have directed the most >8‑rated movies inside the TOP‑3 genres.
SELECT dm."name_id",
       n."name",
       COUNT(*) AS "movie_count"
FROM   "director_mapping" AS dm
JOIN   "ratings"          AS r  ON r."movie_id" = dm."movie_id"
JOIN   "genre"            AS g  ON g."movie_id" = dm."movie_id"
JOIN   "names"            AS n  ON n."id"       = dm."name_id"
WHERE  r."avg_rating" > 8
  AND  g."genre" IN (
         SELECT g2."genre"
         FROM   "genre"   AS g2
         JOIN   "ratings" AS r2 ON r2."movie_id" = g2."movie_id"
         WHERE  r2."avg_rating" > 8
         GROUP  BY g2."genre"
         ORDER  BY COUNT(*) DESC
         LIMIT 3
       )
GROUP  BY dm."name_id"
ORDER  BY "movie_count" DESC
LIMIT 4;
```
