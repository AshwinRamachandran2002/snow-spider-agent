--Description: 6) Tag every item as ‘Below 1 SD’, ‘Within 1 SD’, or ‘Above 1 SD’ without using SQRT()
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                                     AS avg_loss,
        AVG(("loss_rate_%")*("loss_rate_%")) -
        AVG("loss_rate_%")*AVG("loss_rate_%")                  AS var_loss        -- variance
    FROM "veg_loss_rate_df"
)
SELECT
    v."item_code",
    v."item_name",
    v."loss_rate_%",
    CASE
        WHEN ((v."loss_rate_%" - avg_loss) * (v."loss_rate_%" - avg_loss)) > var_loss
             AND v."loss_rate_%" < avg_loss  THEN 'Below 1 SD'
        WHEN ((v."loss_rate_%" - avg_loss) * (v."loss_rate_%" - avg_loss)) > var_loss
             AND v."loss_rate_%" > avg_loss  THEN 'Above 1 SD'
        ELSE                                      'Within 1 SD'
    END AS range_flag
FROM "veg_loss_rate_df" AS v, stats
LIMIT 20
