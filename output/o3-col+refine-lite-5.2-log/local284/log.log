```sql
-- 5. Description: Derive the population standard‑deviation of the loss‑rate  
SELECT
       SQRT( AVG( ("loss_rate_%") * ("loss_rate_%") ) -      -- E[X²]
             AVG("loss_rate_%") * AVG("loss_rate_%") )       -- (E[X])²
       AS std_dev_loss_rate
FROM "veg_loss_rate_df";
```

```sql
-- 6. Description: Tag every item as Below, Above, or Within one std‑dev of the mean  
WITH stats AS (  
     SELECT  
            AVG("loss_rate_%") AS avg_loss,  
            SQRT( AVG( ("loss_rate_%")*("loss_rate_%") ) -  
                  AVG("loss_rate_%")*AVG("loss_rate_%") ) AS sd  
     FROM "veg_loss_rate_df"  
)  
SELECT  
       v."item_code",  
       v."item_name",  
       v."loss_rate_%",  
       CASE  
            WHEN v."loss_rate_%" <  (avg_loss - sd) THEN 'Below 1 SD'  
            WHEN v."loss_rate_%" >  (avg_loss + sd) THEN 'Above 1 SD'  
            ELSE                                   'Within 1 SD'  
       END AS range_flag  
FROM "veg_loss_rate_df" AS v, stats  
LIMIT 20;
```

```sql
-- 7. Description: Count how many items fall into each of the three bands  
WITH stats AS (  
     SELECT  
            AVG("loss_rate_%") AS avg_loss,  
            SQRT( AVG( ("loss_rate_%")*("loss_rate_%") ) -  
                  AVG("loss_rate_%")*AVG("loss_rate_%") ) AS sd  
     FROM "veg_loss_rate_df"  
), banded AS (  
     SELECT  
            CASE  
                 WHEN v."loss_rate_%" <  (avg_loss - sd) THEN 'Below 1 SD'  
                 WHEN v."loss_rate_%" >  (avg_loss + sd) THEN 'Above 1 SD'  
                 ELSE                                   'Within 1 SD'  
            END AS range_flag  
     FROM "veg_loss_rate_df"  v, stats  
)  
SELECT range_flag, COUNT(*) AS item_count  
FROM banded  
GROUP BY range_flag;
```

```sql
-- 8. Description: Join loss‑rate information to its commodity category for richer reporting  
SELECT  
       v."item_name",  
       c."category_name",  
       v."loss_rate_%"  
FROM "veg_loss_rate_df"  AS v  
JOIN "veg_cat"           AS c  
     ON v."item_code" = c."item_code"  
LIMIT 20;
```

```sql
-- 9. Description: Aggregate average loss‑rate by vegetable category  
SELECT  
       c."category_name",  
       AVG(v."loss_rate_%") AS avg_loss_rate  
FROM "veg_loss_rate_df"  v  
JOIN "veg_cat"           c  
     ON v."item_code" = c."item_code"  
GROUP BY c."category_name"  
ORDER BY avg_loss_rate DESC  
LIMIT 20;
```

```sql
-- 10. Description (final answer): Produce the requested summary in one shot –  
--        average loss‑rate and counts of items below, above, and within ±1 SD  
WITH stats AS (  
     SELECT  
            AVG("loss_rate_%") AS avg_loss,  
            SQRT( AVG( ("loss_rate_%")*("loss_rate_%") ) -  
                  AVG("loss_rate_%")*AVG("loss_rate_%") ) AS sd  
     FROM "veg_loss_rate_df"  
), banded AS (  
     SELECT  
            CASE  
                 WHEN v."loss_rate_%" <  (avg_loss - sd) THEN 'Below 1 SD'  
                 WHEN v."loss_rate_%" >  (avg_loss + sd) THEN 'Above 1 SD'  
                 ELSE                                   'Within 1 SD'  
            END AS range_flag  
     FROM "veg_loss_rate_df" v, stats  
)  
SELECT  
       (SELECT avg_loss FROM stats)                        AS average_loss_rate,  
       SUM(CASE WHEN range_flag = 'Below 1 SD'  THEN 1 END) AS items_below_1sd,  
       SUM(CASE WHEN range_flag = 'Within 1 SD' THEN 1 END) AS items_within_1sd,  
       SUM(CASE WHEN range_flag = 'Above 1 SD'  THEN 1 END) AS items_above_1sd  
FROM banded;
```
