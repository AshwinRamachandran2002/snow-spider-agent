```sql
--Description:  One‐shot query that
--   1) derives the global mean (avg_loss) and variance (var_loss) of item loss‑rates (stats CTE).
--      We stay in “squared space” because this SQLite build has no SQRT(); 
--      (x − μ)² > variance is equivalent to |x − μ| > σ (one standard deviation). 
--   2) labels each item (banded CTE):
--        • ‘Below 1 SD’  if its loss‑rate is more than 1 σ below the mean,
--        • ‘Above 1 SD’  if more than 1 σ above,
--        • otherwise     ‘Within 1 SD’.
--   3) aggregates those flags and returns the requested summary:
--        average loss‑rate, plus counts of items below, within, and above one standard deviation.
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                                     AS avg_loss,
        AVG(("loss_rate_%")*("loss_rate_%")) -
        AVG("loss_rate_%")*AVG("loss_rate_%")                  AS var_loss   -- variance = E[X²] − (E[X])²
    FROM "veg_loss_rate_df"
),
banded AS (
    SELECT
        CASE
            WHEN (("loss_rate_%" - avg_loss) * ("loss_rate_%" - avg_loss)) > var_loss
                 AND "loss_rate_%" < avg_loss  THEN 'Below 1 SD'
            WHEN (("loss_rate_%" - avg_loss) * ("loss_rate_%" - avg_loss)) > var_loss
                 AND "loss_rate_%" > avg_loss  THEN 'Above 1 SD'
            ELSE                                       'Within 1 SD'
        END AS range_flag
    FROM "veg_loss_rate_df", stats
)
SELECT
    (SELECT avg_loss FROM stats)                                AS average_loss_rate,
    SUM(CASE WHEN range_flag = 'Below 1 SD'  THEN 1 ELSE 0 END) AS items_below_1sd,
    SUM(CASE WHEN range_flag = 'Within 1 SD' THEN 1 ELSE 0 END) AS items_within_1sd,
    SUM(CASE WHEN range_flag = 'Above 1 SD'  THEN 1 ELSE 0 END) AS items_above_1sd
FROM banded;
```
