--Description: 10) Final summary – overall average loss‑rate plus counts of items below, within, and above one standard deviation (using variance comparison instead of SQRT)
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                                     AS avg_loss,
        AVG(("loss_rate_%")*("loss_rate_%")) -
        AVG("loss_rate_%")*AVG("loss_rate_%")                  AS var_loss
    FROM "veg_loss_rate_df"
),
banded AS (
    SELECT
        CASE
            WHEN ((v."loss_rate_%" - avg_loss) * (v."loss_rate_%" - avg_loss)) > var_loss
                 AND v."loss_rate_%" < avg_loss  THEN 'Below 1 SD'
            WHEN ((v."loss_rate_%" - avg_loss) * (v."loss_rate_%" - avg_loss)) > var_loss
                 AND v."loss_rate_%" > avg_loss  THEN 'Above 1 SD'
            ELSE                                      'Within 1 SD'
        END AS range_flag
    FROM "veg_loss_rate_df" v, stats
)
SELECT
    (SELECT avg_loss FROM stats)                                 AS average_loss_rate,
    SUM(CASE WHEN range_flag = 'Below 1 SD'  THEN 1 ELSE 0 END)  AS items_below_1sd,
    SUM(CASE WHEN range_flag = 'Within 1 SD' THEN 1 ELSE 0 END)  AS items_within_1sd,
    SUM(CASE WHEN range_flag = 'Above 1 SD'  THEN 1 ELSE 0 END)  AS items_above_1sd
FROM banded
