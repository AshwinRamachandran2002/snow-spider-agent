```sql
--Description: 1)  Look up every category whose description contains the word “English”.
SELECT DISTINCT "CategoryID", "CategoryDescription"
FROM "Categories"
WHERE "CategoryDescription" LIKE '%English%'
LIMIT 20;
```

```sql
--Description: 2)  Verify the exact CategoryID that represents English (usually “ENG”).
SELECT DISTINCT "CategoryID"
FROM "Categories"
WHERE "CategoryDescription" = 'English'
LIMIT 20;
```

```sql
--Description: 3)  List all subjects that belong to the English category.
SELECT DISTINCT "SubjectID", "SubjectCode", "SubjectName"
FROM "Subjects"
WHERE "CategoryID" = 'ENG'
LIMIT 20;
```

```sql
--Description: 4)  Show the classes that teach those English subjects.
SELECT DISTINCT c."ClassID", c."SubjectID"
FROM "Classes" AS c
WHERE c."SubjectID" IN (SELECT "SubjectID" FROM "Subjects" WHERE "CategoryID" = 'ENG')
LIMIT 20;
```

```sql
--Description: 5)  Pull every student who completed an English class together with the grade earned.
SELECT DISTINCT ss."StudentID", ss."ClassID", ss."Grade"
FROM "Student_Schedules" AS ss
JOIN "Classes"        AS cl ON cl."ClassID" = ss."ClassID"
JOIN "Subjects"       AS s  ON s."SubjectID" = cl."SubjectID"
WHERE ss."ClassStatus" = 2                      -- completed
  AND s."CategoryID"   = 'ENG'
LIMIT 20;
```

```sql
--Description: 6)  Attach each student’s last name to those completions.
SELECT DISTINCT st."StudLastName", ss."Grade"
FROM "Student_Schedules" AS ss
JOIN "Classes"          AS cl ON cl."ClassID"   = ss."ClassID"
JOIN "Subjects"         AS s  ON s."SubjectID"  = cl."SubjectID"
JOIN "Students"         AS st ON st."StudentID" = ss."StudentID"
WHERE ss."ClassStatus"  = 2     -- completed
  AND s."CategoryID"    = 'ENG'
LIMIT 20;
```

```sql
--Description: 7)  Count how many distinct students completed at least one English course.
SELECT COUNT(DISTINCT st."StudLastName") AS "Total_English_Students"
FROM "Student_Schedules" AS ss
JOIN "Classes"          AS cl ON cl."ClassID"   = ss."ClassID"
JOIN "Subjects"         AS s  ON s."SubjectID"  = cl."SubjectID"
JOIN "Students"         AS st ON st."StudentID" = ss."StudentID"
WHERE ss."ClassStatus"  = 2
  AND s."CategoryID"    = 'ENG';
```

```sql
--Description: 8)  Rank students by their grades (best to worst) and split them into five equal‑sized groups (quintiles).
SELECT
    st."StudLastName",
    ss."Grade",
    NTILE(5) OVER (ORDER BY ss."Grade" DESC) AS "QuintileNum"
FROM "Student_Schedules" AS ss
JOIN "Classes"          AS cl ON cl."ClassID"   = ss."ClassID"
JOIN "Subjects"         AS s  ON s."SubjectID"  = cl."SubjectID"
JOIN "Students"         AS st ON st."StudentID" = ss."StudentID"
WHERE ss."ClassStatus"  = 2
  AND s."CategoryID"    = 'ENG'
ORDER BY ss."Grade" DESC
LIMIT 20;
```

```sql
--Description: 9)  Translate those quintile numbers into readable labels (First … Fifth).
SELECT
    "StudLastName",
    CASE "QuintileNum"
         WHEN 1 THEN 'First'
         WHEN 2 THEN 'Second'
         WHEN 3 THEN 'Third'
         WHEN 4 THEN 'Fourth'
         WHEN 5 THEN 'Fifth'
    END AS "Quintile"
FROM (
    SELECT
        st."StudLastName",
        NTILE(5) OVER (ORDER BY ss."Grade" DESC) AS "QuintileNum"
    FROM "Student_Schedules" AS ss
    JOIN "Classes"          AS cl ON cl."ClassID"   = ss."ClassID"
    JOIN "Subjects"         AS s  ON s."SubjectID"  = cl."SubjectID"
    JOIN "Students"         AS st ON st."StudentID" = ss."StudentID"
    WHERE ss."ClassStatus"  = 2
      AND s."CategoryID"    = 'ENG'
) AS ranked
ORDER BY
    CASE "Quintile"
         WHEN 'First'  THEN 1
         WHEN 'Second' THEN 2
         WHEN 'Third'  THEN 3
         WHEN 'Fourth' THEN 4
         WHEN 'Fifth'  THEN 5
    END
LIMIT 20;
```

```sql
--Description: 10)  Final answer – unique student last names with their quintile labels, ordered from highest to lowest performance.
SELECT DISTINCT "StudLastName", "Quintile"
FROM (
    SELECT
        st."StudLastName",
        NTILE(5) OVER (ORDER BY ss."Grade" DESC) AS "Q"
    FROM "Student_Schedules" AS ss
    JOIN "Classes"          AS cl ON cl."ClassID"   = ss."ClassID"
    JOIN "Subjects"         AS s  ON s."SubjectID"  = cl."SubjectID"
    JOIN "Students"         AS st ON st."StudentID" = ss."StudentID"
    WHERE ss."ClassStatus"  = 2
      AND s."CategoryID"    = 'ENG'
) AS t
CROSS JOIN (
    SELECT 1 AS n UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5
) AS helper
WHERE helper.n = t."Q"
ORDER BY t."Q" ASC
LIMIT 20;
```
