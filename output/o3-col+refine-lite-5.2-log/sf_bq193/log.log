Query:
-- Description: 7) For every repository that has at least one README.md in SAMPLE_FILES,
--              list the languages recorded in the LANGUAGES table (one row per language).
SELECT
    f."repo_name",
    l."language"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES  AS f
JOIN GITHUB_REPOS.GITHUB_REPOS.LANGUAGES    AS l
      ON l."repo_name" = f."repo_name"
WHERE f."path" ILIKE '%README.md'
LIMIT 20
