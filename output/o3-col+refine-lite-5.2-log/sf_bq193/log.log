Query:
-- Description: 6) Count how many times each unique, cleaned README line (non‑blank, non‑comment)
--              appears across all repositories.
SELECT
    TRIM(l.value::STRING)                          AS "clean_line",
    COUNT(*)                                       AS "line_freq"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS c,
     LATERAL FLATTEN(input => SPLIT(c."content", '\n')) AS l
WHERE c."sample_path" ILIKE '%README.md'
  AND TRIM(l.value::STRING) <> ''
  AND TRIM(l.value::STRING) NOT ILIKE '#%'
  AND TRIM(l.value::STRING) NOT ILIKE '//%'
GROUP BY TRIM(l.value::STRING)
ORDER BY "line_freq" DESC
LIMIT 20
