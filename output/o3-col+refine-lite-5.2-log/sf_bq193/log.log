```sql
-- Description: 1) Show a few README‑related rows in SAMPLE_FILES to confirm paths, ids and repo names
SELECT 
  "repo_name",
  "id",
  "path"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES
WHERE "path" ILIKE '%README.md'
LIMIT 20;
```

```sql
-- Description: 2) Bring in the raw README text by joining SAMPLE_FILES → SAMPLE_CONTENTS on the object id
SELECT 
  f."repo_name",
  f."path",
  c."content"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES  AS f
JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS c
  ON c."id" = f."id"
WHERE f."path" ILIKE '%README.md'
LIMIT 20;
```

```sql
-- Description: 3) Split README text into single lines and return one row per line for a single repo (inspect)
SELECT 
  c."sample_repo_name"  AS "repo_name",
  TRIM(line.value::STRING) AS "line_text"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS c,
     LATERAL FLATTEN(input => SPLIT(c."content", '\n')) line
WHERE c."sample_path" ILIKE '%README.md'
  AND c."sample_repo_name" = 'torvalds/linux'   -- example repo; adjust if absent
LIMIT 20;
```

```sql
-- Description: 4) Check what potential comment lines look like (‘#’ markdown vs ‘//’) after trimming
SELECT DISTINCT
  SUBSTR(TRIM(line.value::STRING), 1, 50) AS "first_50_chars"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS c,
     LATERAL FLATTEN(input => SPLIT(c."content", '\n')) line
WHERE c."sample_path" ILIKE '%README.md'
LIMIT 20;
```

```sql
-- Description: 5) Filter to non‑empty, non‑comment lines for a handful of README files
SELECT 
  c."sample_repo_name"  AS "repo",
  TRIM(line.value::STRING) AS "clean_line"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS c,
     LATERAL FLATTEN(input => SPLIT(c."content", '\n')) line
WHERE c."sample_path" ILIKE '%README.md'
  AND TRIM(line.value::STRING) <> ''
  AND TRIM(line.value::STRING) NOT ILIKE '#%'
  AND TRIM(line.value::STRING) NOT ILIKE '//%'
LIMIT 20;
```

```sql
-- Description: 6) Count how often each unique cleaned line appears across all README files
SELECT 
  TRIM(line.value::STRING)                         AS "clean_line",
  COUNT(*)                                         AS "line_freq"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS c,
     LATERAL FLATTEN(input => SPLIT(c."content", '\n')) line
WHERE c."sample_path" ILIKE '%README.md'
  AND TRIM(line.value::STRING) <> ''
  AND TRIM(line.value::STRING) NOT ILIKE '#%'
  AND TRIM(line.value::STRING) NOT ILIKE '//%'
GROUP BY TRIM(line.value::STRING)
ORDER BY "line_freq" DESC
LIMIT 20;
```

```sql
-- Description: 7) Attach programming‑language list for every repository using LANGUAGES table (one README line sample)
SELECT 
  f."repo_name",
  l."language"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES  AS f
JOIN GITHUB_REPOS.GITHUB_REPOS.LANGUAGES    AS l
   ON l."repo_name" = f."repo_name"
WHERE f."path" ILIKE '%README.md'
LIMIT 20;
```

```sql
-- Description: 8) Build a comma‑separated language list per repo (for later aggregation with lines)
SELECT 
  "repo_name",
  ARRAY_TO_STRING(ARRAY_AGG(DISTINCT l."language" ORDER BY l."language"), ',') AS "language_list"
FROM GITHUB_REPOS.GITHUB_REPOS.LANGUAGES AS l
GROUP BY "repo_name"
LIMIT 20;
```

```sql
-- Description: 9) Combine everything: cleaned README lines, frequency, and aggregated language lists
SELECT 
  lines."clean_line",
  COUNT(*)                              AS "freq",
  ARRAY_TO_STRING(
      ARRAY_AGG(DISTINCT lang."language" ORDER BY lang."language"), 
      ','
  )                                     AS "languages"
FROM (
    SELECT 
      f."repo_name",
      TRIM(line.value::STRING) AS "clean_line"
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES AS f
    JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS c
         ON c."id" = f."id"
    ,   LATERAL FLATTEN(input => SPLIT(c."content", '\n')) line
    WHERE f."path" ILIKE '%README.md'
      AND TRIM(line.value::STRING) <> ''
      AND TRIM(line.value::STRING) NOT ILIKE '#%'
      AND TRIM(line.value::STRING) NOT ILIKE '//%'
) AS lines
JOIN GITHUB_REPOS.GITHUB_REPOS.LANGUAGES AS lang
  ON lang."repo_name" = lines."repo_name"
GROUP BY lines."clean_line"
ORDER BY "freq" DESC
LIMIT 20;
```
