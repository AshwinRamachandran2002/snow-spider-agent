```sql
-- Description: Aggregate the set of languages recorded for each repository.
--              We cast the VARIANT “language” column to STRING, remove duplicates
--              with DISTINCT, sort alphabetically in the WITHIN GROUP clause, and
--              concatenate the result with LISTAGG to produce a single comma‑separated
--              “language_list” for every repo.
SELECT
    "repo_name",
    LISTAGG(DISTINCT "language"::STRING, ',') WITHIN GROUP (ORDER BY "language"::STRING) 
        AS "language_list"
FROM GITHUB_REPOS.GITHUB_REPOS.LANGUAGES
GROUP BY "repo_name"
LIMIT 20;
```
