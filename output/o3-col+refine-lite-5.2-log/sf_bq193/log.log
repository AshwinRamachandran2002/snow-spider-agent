```sql
-- Description: Produce each unique, cleaned README line, its frequency across all repositories,
--              and a comma‑separated, alphabetically sorted list of programming languages
--              used by those repositories.  LISTAGG … WITHIN GROUP replaces ARRAY_TO_STRING
--              so the query is compatible with Snowflake SQL.
SELECT
    lines."clean_line",
    COUNT(*) AS "freq",
    LISTAGG(DISTINCT lang."language"::STRING, ',') 
        WITHIN GROUP (ORDER BY lang."language"::STRING) AS "languages"
FROM (
    SELECT
        f."repo_name",
        TRIM(l.value::STRING) AS "clean_line"
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES AS f
    JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS c
          ON c."id" = f."id"
    ,   LATERAL FLATTEN(input => SPLIT(c."content", '\n')) AS l
    WHERE f."path" ILIKE '%README.md'
      AND TRIM(l.value::STRING) <> ''
      AND TRIM(l.value::STRING) NOT ILIKE '#%'
      AND TRIM(l.value::STRING) NOT ILIKE '//%'
) AS lines
JOIN GITHUB_REPOS.GITHUB_REPOS.LANGUAGES AS lang
  ON lang."repo_name" = lines."repo_name"
GROUP BY lines."clean_line"
ORDER BY "freq" DESC
LIMIT 20;
```
