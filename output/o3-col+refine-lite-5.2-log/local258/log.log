Query:
-- 8) Derive each bowler’s economy rate using runs & balls from queries 5 and 6  
SELECT rc."bowler",
       ROUND(1.0 * rc."runs_conceded" / (bb."balls_bowled" / 6.0), 2) AS "economy"
FROM   ( SELECT bb."bowler",
                SUM(bs."runs_scored") AS "runs_conceded"
         FROM   "ball_by_ball"  AS bb
         JOIN   "batsman_scored" AS bs
                ON  bb."match_id"   = bs."match_id"
                AND bb."over_id"    = bs."over_id"
                AND bb."ball_id"    = bs."ball_id"
                AND bb."innings_no" = bs."innings_no"
         GROUP  BY bb."bowler")  AS rc
JOIN   ( SELECT "bowler",
                COUNT(*) AS "balls_bowled"
         FROM   "ball_by_ball"
         GROUP  BY "bowler")      AS bb
       ON rc."bowler" = bb."bowler"
LIMIT 20;
