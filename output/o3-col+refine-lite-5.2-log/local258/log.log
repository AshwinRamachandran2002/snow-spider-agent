```sql
-- 3) Look at runs scored off the bat on a few deliveries (needed for runs‑conceded)  
SELECT bb."match_id",
       bb."innings_no",
       bb."over_id",
       bb."ball_id",
       bb."bowler",
       bs."runs_scored"
FROM   "ball_by_ball"  AS bb
JOIN   "batsman_scored" AS bs
       ON  bb."match_id"   = bs."match_id"
       AND bb."over_id"    = bs."over_id"
       AND bb."ball_id"    = bs."ball_id"
       AND bb."innings_no" = bs."innings_no"
LIMIT 20;
```

```sql
-- 4) Check all kinds of extras so we can later exclude wides & no‑balls  
SELECT DISTINCT "extra_type"
FROM   "extra_runs"
LIMIT 20;
```

```sql
-- 5) Compute total runs conceded (off the bat only) by every bowler  
SELECT bb."bowler",
       SUM(bs."runs_scored") AS "runs_conceded"
FROM   "ball_by_ball"  AS bb
JOIN   "batsman_scored" AS bs
       ON  bb."match_id"   = bs."match_id"
       AND bb."over_id"    = bs."over_id"
       AND bb."ball_id"    = bs."ball_id"
       AND bb."innings_no" = bs."innings_no"
GROUP  BY bb."bowler"
LIMIT 20;
```

```sql
-- 6) Count the number of legal balls bowled by each bowler  
SELECT "bowler",
       COUNT(*) AS "balls_bowled"
FROM   "ball_by_ball"
GROUP  BY "bowler"
LIMIT 20;
```

```sql
-- 7) Count only those wickets actually credited to the bowler (exclude run‑outs, etc.)  
SELECT bb."bowler",
       COUNT(*) AS "wkts"
FROM   "wicket_taken"  AS wt
JOIN   "ball_by_ball"  AS bb
       ON  wt."match_id"   = bb."match_id"
       AND wt."over_id"    = bb."over_id"
       AND wt."ball_id"    = bb."ball_id"
       AND wt."innings_no" = bb."innings_no"
WHERE  wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
GROUP  BY bb."bowler"
LIMIT 20;
```

```sql
-- 8) Derive each bowler’s economy rate using runs & balls from queries 5 and 6  
SELECT rc."bowler",
       ROUND(1.0 * rc."runs_conceded" / (bb."balls_bowled" / 6.0), 2) AS "economy"
FROM   ( SELECT bb."bowler",
                SUM(bs."runs_scored") AS "runs_conceded"
         FROM   "ball_by_ball"  AS bb
         JOIN   "batsman_scored" AS bs
                ON  bb."match_id"   = bs."match_id"
                AND bb."over_id"    = bs."over_id"
                AND bb."ball_id"    = bs."ball_id"
                AND bb."innings_no" = bs."innings_no"
         GROUP  BY bb."bowler")  AS rc
JOIN   ( SELECT "bowler",
                COUNT(*) AS "balls_bowled"
         FROM   "ball_by_ball"
         GROUP  BY "bowler")      AS bb
       ON rc."bowler" = bb."bowler"
LIMIT 20;
```

```sql
-- 9) Find each bowler’s best match figures (wickets & runs in a single match)  
SELECT perf."bowler",
       perf."match_id",
       perf."wkts",
       perf."runs_conceded",
       perf."wkts" || '-' || perf."runs_conceded" AS "best_figures"
FROM   ( SELECT bb."bowler",
                bb."match_id",
                COUNT(wt."player_out")                  AS "wkts",
                SUM(bs."runs_scored")                   AS "runs_conceded"
         FROM   "ball_by_ball"  AS bb
         JOIN   "batsman_scored" AS bs
                ON  bb."match_id"   = bs."match_id"
                AND bb."over_id"    = bs."over_id"
                AND bb."ball_id"    = bs."ball_id"
                AND bb."innings_no" = bs."innings_no"
         LEFT JOIN "wicket_taken" AS wt
                ON  wt."match_id"   = bb."match_id"
                AND wt."over_id"    = bb."over_id"
                AND wt."ball_id"    = bb."ball_id"
                AND wt."innings_no" = bb."innings_no"
                AND wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
         GROUP  BY bb."bowler", bb."match_id") AS perf
ORDER  BY perf."wkts" DESC, perf."runs_conceded"
LIMIT 20;
```

```sql
-- 10) Final: combine wickets, economy, strike rate & best bowling, show top 20 bowlers  
WITH runs AS (
     SELECT bb."bowler",
            SUM(bs."runs_scored") AS "runs_conceded"
     FROM   "ball_by_ball"  AS bb
     JOIN   "batsman_scored" AS bs
            ON  bb."match_id"   = bs."match_id"
            AND bb."over_id"    = bs."over_id"
            AND bb."ball_id"    = bs."ball_id"
            AND bb."innings_no" = bs."innings_no"
     GROUP  BY bb."bowler"
), balls AS (
     SELECT "bowler",
            COUNT(*) AS "balls_bowled"
     FROM   "ball_by_ball"
     GROUP  BY "bowler"
), wkts AS (
     SELECT bb."bowler",
            COUNT(*) AS "wickets"
     FROM   "wicket_taken"  AS wt
     JOIN   "ball_by_ball"  AS bb
            ON  wt."match_id"   = bb."match_id"
            AND wt."over_id"    = bb."over_id"
            AND wt."ball_id"    = bb."ball_id"
            AND wt."innings_no" = bb."innings_no"
     WHERE  wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
     GROUP  BY bb."bowler"
), best AS (
     SELECT bowler,
            MAX(wkts)                      AS "best_wkts",
            MIN(runs_conceded)             AS "best_runs"  -- tie‑breaker on equal wkts
     FROM (
          SELECT bb."bowler",
                 bb."match_id",
                 COUNT(wt."player_out")         AS wkts,
                 SUM(bs."runs_scored")          AS runs_conceded
          FROM   "ball_by_ball"  AS bb
          JOIN   "batsman_scored" AS bs
                 ON  bb."match_id"   = bs."match_id"
                 AND bb."over_id"    = bs."over_id"
                 AND bb."ball_id"    = bs."ball_id"
                 AND bb."innings_no" = bs."innings_no"
          LEFT JOIN "wicket_taken" AS wt
                 ON  wt."match_id"   = bb."match_id"
                 AND wt."over_id"    = bb."over_id"
                 AND wt."ball_id"    = bb."ball_id"
                 AND wt."innings_no" = bb."innings_no"
                 AND wt."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
          GROUP  BY bb."bowler", bb."match_id"
     )
     GROUP BY bowler
)
SELECT p."player_name",
       wkts."wickets",
       ROUND(1.0 * runs."runs_conceded" / (balls."balls_bowled" / 6.0), 2) AS "economy",
       ROUND(1.0 * balls."balls_bowled" / wkts."wickets", 2)              AS "strike_rate",
       best."best_wkts" || '-' || best."best_runs"                        AS "best_figures"
FROM   wkts
JOIN   runs  ON runs."bowler"  = wkts."bowler"
JOIN   balls ON balls."bowler" = wkts."bowler"
JOIN   best  ON best."bowler"  = wkts."bowler"
JOIN   "player" AS p
       ON p."player_id" = wkts."bowler"
ORDER  BY wkts."wickets" DESC
LIMIT 20;
```
