Query:
-- Description: Calculate the pair‑wise Pearson correlations of monthly % shares between every qualifying category pair
WITH pct AS (
  SELECT
    DATE_TRUNC('month', "date")                   AS "sales_month",
    "category_name",
    SUM("volume_sold_liters") /
    SUM(SUM("volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('month', "date")) 
                                               AS "pct_of_month"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
  WHERE "date" >= '2022-01-01'
  GROUP BY 1, 2
), qual AS (
  SELECT "category_name"
  FROM pct
  GROUP BY 1
  HAVING COUNT(*) >= 24 AND AVG("pct_of_month") >= 0.01
), base AS (
  SELECT *
  FROM pct
  WHERE "category_name" IN (SELECT "category_name" FROM qual)
)
SELECT
  a."category_name"   AS "cat_a",
  b."category_name"   AS "cat_b",
  CORR(a."pct_of_month", b."pct_of_month") AS "pearson_corr"
FROM base a
JOIN base b
  ON a."sales_month" = b."sales_month"
     AND a."category_name" < b."category_name"
GROUP BY a."category_name", b."category_name"
ORDER BY "pearson_corr" ASC
LIMIT 20;
