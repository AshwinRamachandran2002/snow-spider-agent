LIMIT 20;
```

```sql
-- Description: Join the two previous aggregates to calculate each category’s monthly % share
WITH cat AS (
  SELECT
    DATE_TRUNC('month', "date")       AS "sales_month",
    "category_name",
    SUM("volume_sold_liters")         AS "liters_sold"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
  WHERE "date" >= '2022-01-01'
  GROUP BY 1, 2
), tot AS (
  SELECT
    DATE_TRUNC('month', "date")       AS "sales_month",
    SUM("volume_sold_liters")         AS "total_liters"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
  WHERE "date" >= '2022-01-01'
  GROUP BY 1
)
SELECT
  c."sales_month",
  c."category_name",
  c."liters_sold",
  t."total_liters",
  c."liters_sold" / t."total_liters"  AS "pct_of_month"
FROM cat c
JOIN tot t
  ON c."sales_month" = t."sales_month"
ORDER BY c."sales_month", c."category_name"
LIMIT 20;
```

```sql
-- Description: For every category, count the number of months (since 2022‑01‑01) and its average % share
WITH pct AS (
  SELECT
    DATE_TRUNC('month', "date")                   AS "sales_month",
    "category_name",
    SUM("volume_sold_liters") /
    SUM(SUM("volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('month', "date")) 
                                               AS "pct_of_month"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
  WHERE "date" >= '2022-01-01'
  GROUP BY 1, 2
)
SELECT
  "category_name",
  COUNT(*)                       AS "months_present",
  AVG("pct_of_month")            AS "avg_pct_share"
FROM pct
GROUP BY 1
HAVING COUNT(*) >= 24            -- at least 24 months
   AND AVG("pct_of_month") >= 0.01   -- at least 1% average share
ORDER BY "avg_pct_share" DESC
LIMIT 20;
```

```sql
-- Description: Produce a pivot‑style table: one column per qualifying category, rows = months, values = % share
WITH pct AS (
  SELECT
    DATE_TRUNC('month', "date")                   AS "sales_month",
    "category_name",
    SUM("volume_sold_liters") /
    SUM(SUM("volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('month', "date")) 
                                               AS "pct_of_month"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
  WHERE "date" >= '2022-01-01'
  GROUP BY 1, 2
), qual AS (
  SELECT "category_name"
  FROM pct
  GROUP BY 1
  HAVING COUNT(*) >= 24 AND AVG("pct_of_month") >= 0.01
)
SELECT *
FROM pct
WHERE "category_name" IN (SELECT "category_name" FROM qual)
LIMIT 20;
```

```sql
-- Description: Calculate the pair‑wise Pearson correlations of monthly % shares between every qualifying category pair
WITH pct AS (
  SELECT
    DATE_TRUNC('month', "date")                   AS "sales_month",
    "category_name",
    SUM("volume_sold_liters") /
    SUM(SUM("volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('month', "date")) 
                                               AS "pct_of_month"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
  WHERE "date" >= '2022-01-01'
  GROUP BY 1, 2
), qual AS (
  SELECT "category_name"
  FROM pct
  GROUP BY 1
  HAVING COUNT(*) >= 24 AND AVG("pct_of_month") >= 0.01
), base AS (
  SELECT *
  FROM pct
  WHERE "category_name" IN (SELECT "category_name" FROM qual)
)
SELECT
  a."category_name"   AS "cat_a",
  b."category_name"   AS "cat_b",
  CORR(a."pct_of_month", b."pct_of_month") AS "pearson_corr"
FROM base a
JOIN base b
  ON a."sales_month" = b."sales_month"
     AND a."category_name" < b."category_name"
GROUP BY a."category_name", b."category_name"
ORDER BY "pearson_corr" ASC
LIMIT 20;
```

```sql
-- Description: Final query – return the two qualifying categories with the single lowest Pearson correlation
WITH pct AS (
  SELECT
    DATE_TRUNC('month', "date")                   AS "sales_month",
    "category_name",
    SUM("volume_sold_liters") /
    SUM(SUM("volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('month', "date")) 
                                               AS "pct_of_month"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
  WHERE "date" >= '2022-01-01'
  GROUP BY 1, 2
), qual AS (
  SELECT "category_name"
  FROM pct
  GROUP BY 1
  HAVING COUNT(*) >= 24 AND AVG("pct_of_month") >= 0.01
), base AS (
  SELECT *
  FROM pct
  WHERE "category_name" IN (SELECT "category_name" FROM qual)
)
SELECT
  a."category_name"   AS "category_one",
  b."category_name"   AS "category_two",
  CORR(a."pct_of_month", b."pct_of_month") AS "pearson_corr"
FROM base a
JOIN base b
  ON a."sales_month" = b."sales_month"
     AND a."category_name" < b."category_name"
GROUP BY a."category_name", b."category_name"
ORDER BY "pearson_corr" ASC
LIMIT 1;
```
