Query:
-- Description: For every category, count the number of months (since 2022‑01‑01) and its average % share
WITH pct AS (
  SELECT
    DATE_TRUNC('month', "date")                   AS "sales_month",
    "category_name",
    SUM("volume_sold_liters") /
    SUM(SUM("volume_sold_liters")) OVER (PARTITION BY DATE_TRUNC('month', "date")) 
                                               AS "pct_of_month"
  FROM IOWA_LIQUOR_SALES.IOWA_LIQUOR_SALES.SALES
  WHERE "date" >= '2022-01-01'
  GROUP BY 1, 2
)
SELECT
  "category_name",
  COUNT(*)                       AS "months_present",
  AVG("pct_of_month")            AS "avg_pct_share"
FROM pct
GROUP BY 1
HAVING COUNT(*) >= 24            -- at least 24 months
   AND AVG("pct_of_month") >= 0.01   -- at least 1% average share
ORDER BY "avg_pct_share" DESC
LIMIT 20;
