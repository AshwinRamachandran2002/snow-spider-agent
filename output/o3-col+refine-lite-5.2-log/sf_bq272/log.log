```sql
--Description: Look at some order‑item rows whose item status is neither cancelled nor returned
SELECT "id"            AS "order_item_id",
       "order_id",
       "product_id",
       "status",
       "sale_price",
       "created_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
WHERE  "status" NOT ILIKE '%Cancelled%'
  AND  "status" NOT ILIKE '%Returned%'
LIMIT 20;
```

```sql
--Description: Join Orders and Order Items to verify orders/items that are NOT cancelled/returned
SELECT oi."id"          AS "order_item_id",
       oi."order_id",
       o."status"       AS "order_status",
       oi."status"      AS "item_status",
       oi."sale_price"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
       ON oi."order_id" = o."order_id"
WHERE  o."status" NOT IN ('Cancelled','Returned')
  AND  oi."status" NOT IN ('Cancelled','Returned')
LIMIT 20;
```

```sql
--Description: Bring in product names for a quick sanity check
SELECT oi."product_id",
       p."name"     AS "product_name",
       oi."sale_price"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
LIMIT 20;
```

```sql
--Description: Join Order Items with Inventory Items to see the unit cost alongside sale price
SELECT oi."id"            AS "order_item_id",
       oi."sale_price",
       ii."cost",
       (oi."sale_price" - ii."cost") AS "profit_per_item"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii
       ON oi."inventory_item_id" = ii."id"
LIMIT 20;
```

```sql
--Description: Calculate profit for each eligible order item (item & order both not cancelled/returned)
SELECT oi."id"          AS "order_item_id",
       oi."product_id",
       (oi."sale_price" - ii."cost") AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii
       ON oi."inventory_item_id" = ii."id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"          o
       ON oi."order_id" = o."order_id"
WHERE  o."status"  NOT IN ('Cancelled','Returned')
  AND  oi."status" NOT IN ('Cancelled','Returned')
LIMIT 20;
```

```sql
--Description: Aggregate monthly profit per product (Jan‑2019 through Aug‑2022) and pull top‑3 per month
WITH cte AS (
    SELECT
        TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at" / 1000000),'YYYY-MM')            AS "month",
        oi."product_id",
        SUM(oi."sale_price")                                                      AS "total_sales",
        SUM(ii."cost")                                                            AS "total_cost",
        SUM(oi."sale_price") - SUM(ii."cost")                                     AS "profit"
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     oi
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii
           ON oi."inventory_item_id" = ii."id"
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"          o
           ON oi."order_id" = o."order_id"
    WHERE  o."status"  NOT IN ('Cancelled','Returned')
      AND  oi."status" NOT IN ('Cancelled','Returned')
      AND  TO_DATE(TO_TIMESTAMP_NTZ(oi."created_at" / 1000000)) BETWEEN '2019-01-01' AND '2022-08-31'
    GROUP BY 1,2
), ranked AS (
    SELECT
        cte.*,
        RANK() OVER (PARTITION BY cte."month" ORDER BY cte."profit" DESC) AS "rk"
    FROM   cte
)
SELECT
       r."month",
       r."product_id",
       r."profit"
FROM   ranked r
WHERE  r."rk" <= 3
ORDER BY r."month", r."rk"
LIMIT 20;
```

