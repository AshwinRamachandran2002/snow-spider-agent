    COUNT(DISTINCT user_pseudo_id) AS users_retained
  FROM buckets
  GROUP BY week_no
),
cohort_size AS (             -- total size of the cohort
  SELECT COUNT(*) AS size FROM cohort
)
SELECT
  cs.size AS cohort_size,
  SAFE_DIVIDE(MAX(IF(r.week_no = 1, r.users_retained, NULL)), cs.size) AS week1_rate,
