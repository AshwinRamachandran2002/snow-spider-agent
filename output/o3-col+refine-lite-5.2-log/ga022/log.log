-- during 1‑7 Sep 2018 in Asia/Shanghai time
WITH base AS (
  SELECT
    user_pseudo_id,
    event_name,
    DATE(TIMESTAMP_MICROS(event_timestamp), 'Asia/Shanghai') AS event_date_sh
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'          -- September 2018 only
),
/* Cohort: users whose very first “first_open” occurred 1‑7 Sep 2018 (Shanghai) */
cohort AS (
  SELECT
    user_pseudo_id,
    MIN(event_date_sh) AS cohort_date
  FROM base
  WHERE event_name = 'first_open'
    AND event_date_sh BETWEEN DATE '2018-09-01' AND DATE '2018-09-07'
  GROUP BY user_pseudo_id
),
/* All events these cohort users generated during September (Shanghai) */
timeline AS (
  SELECT
    b.user_pseudo_id,
    DATE_DIFF(b.event_date_sh, c.cohort_date, DAY) AS day_diff
  FROM base AS b
  JOIN cohort AS c USING (user_pseudo_id)
  WHERE b.event_date_sh BETWEEN DATE '2018-09-01' AND DATE '2018-09-30'
),
/* Place every user into the first week bucket where they appear */
buckets AS (
  SELECT DISTINCT
    user_pseudo_id,
    CASE
      WHEN day_diff BETWEEN  7 AND 13 THEN 1      -- Week 1  (days 7‑13)
      WHEN day_diff BETWEEN 14 AND 20 THEN 2      -- Week 2  (days 14‑20)
      WHEN day_diff BETWEEN 21 AND 27 THEN 3      -- Week 3  (days 21‑27)
    END AS week_no
