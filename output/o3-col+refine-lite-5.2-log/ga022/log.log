```sql
--Description: 10) Final weekly retention table for the 1‑7 Sep 2018 cohort
WITH cohort AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS cohort_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'first_open'
    AND event_date BETWEEN '20180901' AND '20180907'
  GROUP BY user_pseudo_id
), timeline AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    DATE_DIFF(PARSE_DATE('%Y%m%d', e.event_date), c.cohort_date, DAY) AS day_diff
  FROM `firebase-public-project.analytics_153293282.events_*` e
  JOIN cohort c USING (user_pseudo_id)
  WHERE e.event_date BETWEEN '20180901' AND '20180927'
), buckets AS (
  SELECT
    user_pseudo_id,
    CASE
      WHEN day_diff BETWEEN  0 AND  6 THEN 0
      WHEN day_diff BETWEEN  7 AND 13 THEN 1
      WHEN day_diff BETWEEN 14 AND 20 THEN 2
      WHEN day_diff BETWEEN 21 AND 27 THEN 3
    END AS week_no
  FROM timeline
  WHERE day_diff BETWEEN 0 AND 27
), users_by_week AS (
  SELECT
    week_no,
    COUNT(DISTINCT user_pseudo_id) AS users
  FROM buckets
  GROUP BY week_no
)
SELECT
  (SELECT users FROM users_by_week WHERE week_no = 0)                                          AS cohort_size,
  1.0                                                                                         AS week0_rate,
  SAFE_DIVIDE((SELECT users FROM users_by_week WHERE week_no = 1),
              (SELECT users FROM users_by_week WHERE week_no = 0))                            AS week1_rate,
  SAFE_DIVIDE((SELECT users FROM users_by_week WHERE week_no = 2),
              (SELECT users FROM users_by_week WHERE week_no = 0))                            AS week2_rate,
  SAFE_DIVIDE((SELECT users FROM users_by_week WHERE week_no = 3),
              (SELECT users FROM users_by_week WHERE week_no = 0))                            AS week3_rate
LIMIT 20;
```
