Query:
-- 7. Description:  Count how many *retained* legislators each state‑gender pair
--                  has at every interval.
WITH first AS (
     SELECT l."id_bioguide",
            l."gender",
            MIN(lt."term_start") AS first_start
     FROM   "legislators"       AS l
     JOIN   "legislators_terms" AS lt
            USING ("id_bioguide")
     GROUP  BY l."id_bioguide"
),
years(d) AS (VALUES (0),(2),(4),(6),(8),(10)),
targets AS (
     SELECT f."id_bioguide",
            f."gender",
            y.d,
            date(substr(f.first_start,1,4)||'-12-31',
                 '+'||y.d||' years')         AS target_date
     FROM   first AS f
     CROSS  JOIN years AS y
),
retained AS (
     SELECT t."id_bioguide",
            t."gender",
            t.d,
            lt."state"
     FROM   targets AS t
     JOIN   "legislators_terms" AS lt
            ON lt."id_bioguide" = t."id_bioguide"
           AND lt."term_start"  <= t.target_date
           AND lt."term_end"    >= t.target_date
)
SELECT r."state",
       r."gender",
       r.d                         AS "yrs_after_start",
       COUNT(DISTINCT r."id_bioguide") AS retained_n
FROM   retained AS r
GROUP  BY r."state", r."gender", r.d
LIMIT 20;
