```

```sql
-- 3. Description:  Join a few legislators with the first rows of their service records to see the
--                  fields we will need (gender, state, term dates).
SELECT l."id_bioguide",
       l."gender",
       lt."state",
       lt."term_start",
       lt."term_end"
FROM   "legislators"        AS l
JOIN   "legislators_terms"  AS lt
       ON lt."id_bioguide" = l."id_bioguide"
LIMIT 20;
```

```sql
-- 4. Description:  Find each legislator’s very first term‑start date
--                  (this becomes the anchor year “0” for retention).
SELECT l."id_bioguide",
       l."gender",
       MIN(lt."term_start") AS "first_term_start"
FROM   "legislators"        AS l
JOIN   "legislators_terms"  AS lt
       USING ("id_bioguide")
GROUP  BY l."id_bioguide"
LIMIT 20;
```

```sql
-- 5. Description:  Create the six anniversary dates (0,2,4,6,8,10 yrs) for every legislator.
WITH first AS (
     SELECT l."id_bioguide",
            l."gender",
            MIN(lt."term_start") AS first_start
     FROM   "legislators"        AS l
     JOIN   "legislators_terms"  AS lt
            USING ("id_bioguide")
     GROUP  BY l."id_bioguide"
),
years(d) AS (VALUES (0),(2),(4),(6),(8),(10))
SELECT f."id_bioguide",
       f."gender",
       y.d                       AS "years_after_start",
       date(substr(f.first_start,1,4) || '-12-31',
            '+' || y.d || ' years') AS target_date
FROM   first AS f
CROSS  JOIN years AS y
LIMIT 20;
```

```sql
-- 6. Description:  Mark the legislators who are actually serving on each
--                  anniversary date (i.e., “retained”).
WITH first AS (
     SELECT l."id_bioguide",
            l."gender",
            MIN(lt."term_start") AS first_start
     FROM   "legislators"       AS l
     JOIN   "legislators_terms" AS lt
            USING ("id_bioguide")
     GROUP  BY l."id_bioguide"
),
years(d) AS (VALUES (0),(2),(4),(6),(8),(10)),
targets AS (
     SELECT f."id_bioguide",
            f."gender",
            y.d,
            date(substr(f.first_start,1,4)||'-12-31',
                 '+'||y.d||' years')         AS target_date
     FROM   first AS f
     CROSS  JOIN years AS y
)
SELECT  t."id_bioguide",
        t."gender",
        t.d                       AS "yrs_after_start",
        lt."state"
FROM    targets AS t
JOIN    "legislators_terms" AS lt
        ON lt."id_bioguide" = t."id_bioguide"
       AND lt."term_start"  <= t.target_date
       AND lt."term_end"    >= t.target_date
LIMIT 20;
```

```sql
-- 7. Description:  Count how many *retained* legislators each state‑gender pair
--                  has at every interval.
WITH first AS (
     SELECT l."id_bioguide",
            l."gender",
            MIN(lt."term_start") AS first_start
     FROM   "legislators"       AS l
     JOIN   "legislators_terms" AS lt
            USING ("id_bioguide")
     GROUP  BY l."id_bioguide"
),
years(d) AS (VALUES (0),(2),(4),(6),(8),(10)),
targets AS (
     SELECT f."id_bioguide",
            f."gender",
            y.d,
            date(substr(f.first_start,1,4)||'-12-31',
                 '+'||y.d||' years')         AS target_date
     FROM   first AS f
     CROSS  JOIN years AS y
),
retained AS (
     SELECT t."id_bioguide",
            t."gender",
            t.d,
            lt."state"
     FROM   targets AS t
     JOIN   "legislators_terms" AS lt
            ON lt."id_bioguide" = t."id_bioguide"
           AND lt."term_start"  <= t.target_date
           AND lt."term_end"    >= t.target_date
)
SELECT r."state",
       r."gender",
       r.d                         AS "yrs_after_start",
       COUNT(DISTINCT r."id_bioguide") AS retained_n
FROM   retained AS r
GROUP  BY r."state", r."gender", r.d
LIMIT 20;
```

```sql
-- 8. Description:  Pick state/gender pairs that still have ≥1 legislator
--                  (i.e., non‑zero retained) at *all* six checkpoints.
WITH first AS (
     SELECT l."id_bioguide",
            l."gender",
            MIN(lt."term_start") AS first_start
     FROM   "legislators"       AS l
     JOIN   "legislators_terms" AS lt
            USING ("id_bioguide")
     GROUP  BY l."id_bioguide"
),
years(d) AS (VALUES (0),(2),(4),(6),(8),(10)),
targets AS (
     SELECT f."id_bioguide",
            f."gender",
            y.d,
            date(substr(f.first_start,1,4)||'-12-31',
                 '+'||y.d||' years')         AS target_date
     FROM   first AS f
     CROSS  JOIN years AS y
),
retained AS (
     SELECT t."id_bioguide",
            t."gender",
            t.d,
            lt."state"
     FROM   targets AS t
     JOIN   "legislators_terms" AS lt
            ON lt."id_bioguide" = t."id_bioguide"
           AND lt."term_start"  <= t.target_date
           AND lt."term_end"    >= t.target_date
),
good_gender_state AS (
     SELECT "state",
            "gender"
     FROM   retained
     GROUP  BY "state", "gender"
     HAVING COUNT(DISTINCT d) = 6      -- all six anniversaries present
)
SELECT DISTINCT "state"
FROM   good_gender_state
GROUP  BY "state"
HAVING COUNT(DISTINCT "gender") = 2    -- both Male & Female cohorts qualify
LIMIT 20;
```

```sql
-- 9. Description:  FINAL ANSWER – every state abbreviation whose
--                  male *and* female cohorts each keep a non‑zero
--                  retention rate at 0,2,4,6,8,10 years.
WITH first AS (
     SELECT l."id_bioguide",
            l."gender",
            MIN(lt."term_start") AS first_start
     FROM   "legislators"       AS l
     JOIN   "legislators_terms" AS lt
            USING ("id_bioguide")
     GROUP  BY l."id_bioguide"
),
years(d) AS (VALUES (0),(2),(4),(6),(8),(10)),
targets AS (
     SELECT f."id_bioguide",
            f."gender",
            y.d,
            date(substr(f.first_start,1,4)||'-12-31',
                 '+'||y.d||' years')         AS target_date
     FROM   first AS f
     CROSS  JOIN years AS y
),
retained AS (
     SELECT t."id_bioguide",
            t."gender",
            t.d,
            lt."state"
     FROM   targets AS t
     JOIN   "legislators_terms" AS lt
            ON lt."id_bioguide" = t."id_bioguide"
           AND lt."term_start"  <= t.target_date
           AND lt."term_end"    >= t.target_date
),
good_gender_state AS (
     SELECT "state",
            "gender"
     FROM   retained
     GROUP  BY "state", "gender"
     HAVING COUNT(DISTINCT d) = 6      -- non‑zero at all six checkpoints
)
SELECT DISTINCT "state"
FROM   good_gender_state
GROUP  BY "state"
HAVING COUNT(DISTINCT "gender") = 2;   -- need both gender cohorts
```
