     FROM   targets AS t
     JOIN   "legislators_terms" AS lt
            ON lt."id_bioguide" = t."id_bioguide"
           AND lt."term_start"  <= t.target_date
           AND lt."term_end"    >= t.target_date
),
good_gender_state AS (
     SELECT "state",
            "gender"
     FROM   retained
     GROUP  BY "state", "gender"
     HAVING COUNT(DISTINCT d) = 6      -- all six anniversaries present
)
SELECT DISTINCT "state"
FROM   good_gender_state
GROUP  BY "state"
HAVING COUNT(DISTINCT "gender") = 2    -- both Male & Female cohorts qualify
LIMIT 20;
