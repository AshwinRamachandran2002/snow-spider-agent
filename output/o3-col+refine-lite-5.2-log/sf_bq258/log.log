WHERE  oi."status" ILIKE '%Complete%'
  AND  oi."delivered_at" < 1640995200000000
LIMIT 20;
```

```sql
--Description: Join ORDER_ITEMS with PRODUCTS to see category, cost and retail information for completed lines  
SELECT oi."id",
       oi."order_id",
       p."category",
       p."cost",
       p."retail_price",
       oi."sale_price"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
       ON oi."product_id" = p."id"
WHERE  oi."status" ILIKE '%Complete%'
LIMIT 20;
```

```sql
--Description: Aggregate monthly revenue & order counts by product category (deliveries before 2022)  
SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000)) AS "month",
       p."category",
       SUM(oi."sale_price")                      AS "total_revenue",
       COUNT(DISTINCT oi."order_id")             AS "total_orders"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
       ON oi."product_id" = p."id"
WHERE  oi."status" ILIKE '%Complete%'
  AND  oi."delivered_at" < 1640995200000000
GROUP  BY "month", p."category"
ORDER  BY "month", p."category"
LIMIT 20;
```

```sql
--Description: Monthly sum of product cost for the same completed order‑items  
SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000)) AS "month",
       p."category",
       SUM(p."cost")                                AS "total_cost"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
       ON oi."product_id" = p."id"
WHERE  oi."status" ILIKE '%Complete%'
  AND  oi."delivered_at" < 1640995200000000
GROUP  BY "month", p."category"
ORDER  BY "month", p."category"
LIMIT 20;
```

```sql
--Description: Combine monthly revenue and cost to calculate profit by category  
SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000)) AS "month",
       p."category",
       SUM(oi."sale_price")                         AS "revenue",
       SUM(p."cost")                                AS "cost",
       SUM(oi."sale_price") - SUM(p."cost")         AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
       ON oi."product_id" = p."id"
WHERE  oi."status" ILIKE '%Complete%'
  AND  oi."delivered_at" < 1640995200000000
GROUP  BY "month", p."category"
ORDER  BY "month", p."category"
LIMIT 20;
```

```sql
--Description: Add profit‑to‑cost ratio to the monthly profit view  
SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000))        AS "month",
       p."category",
       SUM(oi."sale_price")                             AS "revenue",
       SUM(p."cost")                                    AS "cost",
       (SUM(oi."sale_price") - SUM(p."cost")) /
       NULLIF(SUM(p."cost"),0)                          AS "profit_to_cost_ratio"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
       ON oi."product_id" = p."id"
WHERE  oi."status" ILIKE '%Complete%'
  AND  oi."delivered_at" < 1640995200000000
GROUP  BY "month", p."category"
ORDER  BY "month"
LIMIT 20;
```

```sql
--Description: Compute month‑over‑month revenue growth for each category using a window function  
SELECT mc.*,
       LAG("revenue") OVER (PARTITION BY "category" ORDER BY "month")                       AS "prev_month_revenue",
       CASE WHEN LAG("revenue") OVER (PARTITION BY "category" ORDER BY "month") = 0
            THEN NULL
            ELSE ("revenue" - LAG("revenue") OVER (PARTITION BY "category" ORDER BY "month"))
                 / LAG("revenue") OVER (PARTITION BY "category" ORDER BY "month")
       END                                                                                  AS "mom_revenue_growth"
FROM (
       SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000))  AS "month",
              p."category",
              SUM(oi."sale_price")                                             AS "revenue"
       FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
       JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
              ON oi."product_id" = p."id"
       WHERE  oi."status" ILIKE '%Complete%'
         AND  oi."delivered_at" < 1640995200000000
       GROUP  BY "month", p."category"
) mc
ORDER BY "category", "month"
LIMIT 20;
```

```sql
--Description: One consolidated monthly report per category: revenue, orders, cost, profit, ratios, and MoM growth for both revenue & orders  
SELECT final.*
FROM (
      SELECT base.*,
             LAG("total_revenue") OVER (PARTITION BY "category" ORDER BY "month")           AS "prev_revenue",
             LAG("total_orders")  OVER (PARTITION BY "category" ORDER BY "month")           AS "prev_orders",
             CASE WHEN LAG("total_revenue") OVER (PARTITION BY "category" ORDER BY "month") = 0
                  THEN NULL
                  ELSE ("total_revenue" - LAG("total_revenue") OVER (PARTITION BY "category" ORDER BY "month"))
                       / LAG("total_revenue") OVER (PARTITION BY "category" ORDER BY "month")
             END                                                                            AS "mom_revenue_growth",
             CASE WHEN LAG("total_orders") OVER (PARTITION BY "category" ORDER BY "month") = 0
                  THEN NULL
                  ELSE ("total_orders" - LAG("total_orders") OVER (PARTITION BY "category" ORDER BY "month"))
                       / LAG("total_orders") OVER (PARTITION BY "category" ORDER BY "month")
             END                                                                            AS "mom_orders_growth",
             ("total_revenue" - "total_cost")                                               AS "profit",
             ("total_revenue" - "total_cost") / NULLIF("total_cost",0)                      AS "profit_to_cost_ratio"
      FROM (
            SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000)) AS "month",
                   p."category",
                   SUM(oi."sale_price")                                            AS "total_revenue",
                   COUNT(DISTINCT oi."order_id")                                   AS "total_orders",
                   SUM(p."cost")                                                   AS "total_cost"
            FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
            JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
                   ON oi."product_id" = p."id"
            WHERE  oi."status" = 'Complete'
              AND  oi."delivered_at" < 1640995200000000
            GROUP  BY "month", p."category"
      ) base
) final
ORDER BY "category", "month"
LIMIT 20;
```
