```sql
--Description: Helper CTE that lists every actor (PID) paired with every
--             distinct movie year (converted to INTEGER) in which they appeared,
--             then previews the first 20 rows.
WITH actor_years AS (
  SELECT c."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS c
  JOIN   "Movie"  AS m
    ON   c."MID" = m."MID"
  GROUP  BY c."PID", yr
)
SELECT *
FROM   actor_years
LIMIT 20;
```

```sql
--Description: Using the actor_years CTE, compute the next chronological
--             year for each actor with LEAD(), derive the size of the gap,
--             and show the first 20 non‑NULL gap rows.
WITH actor_years AS (
  SELECT c."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS c
  JOIN   "Movie"  AS m
    ON   c."MID" = m."MID"
  GROUP  BY c."PID", yr
),
gaps AS (
  SELECT PID,
         yr,
         LEAD(yr) OVER (PARTITION BY PID ORDER BY yr) AS next_yr,
         LEAD(yr) OVER (PARTITION BY PID ORDER BY yr) - yr AS gap
  FROM   actor_years
)
SELECT *
FROM   gaps
WHERE  gap IS NOT NULL
LIMIT 20;
```

```sql
--Description: Identify all actors who experience at least one inactivity
--             gap of 4 years or more between consecutive movies, and list
--             the first 20 such actor IDs.
WITH actor_years AS (
  SELECT c."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS c
  JOIN   "Movie"  AS m
    ON   c."MID" = m."MID"
  GROUP  BY c."PID", yr
),
gaps AS (
  SELECT PID,
         LEAD(yr) OVER (PARTITION BY PID ORDER BY yr) - yr AS gap
  FROM   actor_years
)
SELECT DISTINCT PID
FROM   gaps
WHERE  gap > 3
LIMIT 20;
```

```sql
--Description: Final answer – count the actors who NEVER have a gap of
--             4 or more consecutive years without a movie appearance.
WITH actor_years AS (
  SELECT c."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS c
  JOIN   "Movie"  AS m
    ON   c."MID" = m."MID"
  GROUP  BY c."PID", yr
),
gaps AS (
  SELECT PID,
         LEAD(yr) OVER (PARTITION BY PID ORDER BY yr) - yr AS gap
  FROM   actor_years
),
actors_with_long_gap AS (
  SELECT DISTINCT PID
  FROM   gaps
  WHERE  gap > 3
),
actors_no_long_gap AS (
  SELECT DISTINCT PID
  FROM   actor_years
  EXCEPT
  SELECT PID
  FROM   actors_with_long_gap
)
SELECT COUNT(*) AS actors_without_4year_gap
FROM   actors_no_long_gap;
```
