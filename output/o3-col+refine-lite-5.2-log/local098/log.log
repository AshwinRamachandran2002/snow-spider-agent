Query:
--Description: Final answer – count the actors who NEVER have a gap of
--             4 or more consecutive years without a movie appearance.
WITH actor_years AS (
  SELECT c."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS c
  JOIN   "Movie"  AS m
    ON   c."MID" = m."MID"
  GROUP  BY c."PID", yr
),
gaps AS (
  SELECT PID,
         LEAD(yr) OVER (PARTITION BY PID ORDER BY yr) - yr AS gap
  FROM   actor_years
),
actors_with_long_gap AS (
  SELECT DISTINCT PID
  FROM   gaps
  WHERE  gap > 3
),
actors_no_long_gap AS (
  SELECT DISTINCT PID
  FROM   actor_years
  EXCEPT
  SELECT PID
  FROM   actors_with_long_gap
)
SELECT COUNT(*) AS actors_without_4year_gap
FROM   actors_no_long_gap
