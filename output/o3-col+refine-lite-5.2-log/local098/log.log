Query:
--Description: Using the actor_years CTE, compute the next chronological
--             year for each actor with LEAD(), derive the size of the gap,
--             and show the first 20 non‑NULL gap rows.
WITH actor_years AS (
  SELECT c."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS c
  JOIN   "Movie"  AS m
    ON   c."MID" = m."MID"
  GROUP  BY c."PID", yr
),
gaps AS (
  SELECT PID,
         yr,
         LEAD(yr) OVER (PARTITION BY PID ORDER BY yr) AS next_yr,
         LEAD(yr) OVER (PARTITION BY PID ORDER BY yr) - yr AS gap
  FROM   actor_years
)
SELECT *
FROM   gaps
WHERE  gap IS NOT NULL
LIMIT 20
