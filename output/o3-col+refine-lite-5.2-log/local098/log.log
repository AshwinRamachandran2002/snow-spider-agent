```sql
-- 1. Inspect a few records from M_Cast to see how movie‑person links look.
SELECT *
FROM "M_Cast"
LIMIT 20;
```

```sql
-- 2. Inspect corresponding movie years for those cast links.
SELECT c."PID",
       c."MID",
       m."year"
FROM   "M_Cast" AS c
JOIN   "Movie"  AS m
  ON   c."MID" = m."MID"
LIMIT 20;
```

```sql
-- 3. Look at one actor’s full, de‑duplicated list of active years.
SELECT c."PID",
       GROUP_CONCAT(DISTINCT m."year", ', ') AS active_years
FROM   "M_Cast" AS c
JOIN   "Movie"  AS m
  ON   c."MID" = m."MID"
WHERE  c."PID" = (SELECT "PID" FROM "M_Cast" LIMIT 1)   -- pick any actor
GROUP  BY c."PID";
```

```sql
-- 4. Build a helper CTE: every actor with every distinct year (as INTEGER).
WITH actor_years AS (
  SELECT c."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS c
  JOIN   "Movie"  AS m
    ON   c."MID" = m."MID"
  GROUP  BY c."PID", yr
)
SELECT *
FROM   actor_years
LIMIT 20;
```

```sql
-- 5. For each actor, show successive year gaps using LEAD().
WITH actor_years AS (
  SELECT c."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS c
  JOIN   "Movie"  AS m
    ON   c."MID" = m."MID"
  GROUP  BY c."PID", yr
),
gaps AS (
  SELECT PID,
         yr,
         LEAD(yr) OVER (PARTITION BY PID ORDER BY yr) AS next_yr,
         LEAD(yr) OVER (PARTITION BY PID ORDER BY yr) - yr AS gap
  FROM   actor_years
)
SELECT *
FROM   gaps
WHERE  gap IS NOT NULL
LIMIT 20;
```

```sql
-- 6. Identify actors that have at least one gap of 4+ years.
WITH actor_years AS (
  SELECT c."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS c
  JOIN   "Movie"  AS m
    ON   c."MID" = m."MID"
  GROUP  BY c."PID", yr
),
gaps AS (
  SELECT PID,
         LEAD(yr) OVER (PARTITION BY PID ORDER BY yr) - yr AS gap
  FROM   actor_years
)
SELECT DISTINCT PID
FROM   gaps
WHERE  gap > 3
LIMIT 20;
```

```sql
-- 7. Final answer: count actors that NEVER have a 4‑year (or more) inactivity span.
WITH actor_years AS (
  SELECT c."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS c
  JOIN   "Movie"  AS m
    ON   c."MID" = m."MID"
  GROUP  BY c."PID", yr
),
gaps AS (
  SELECT PID,
         LEAD(yr) OVER (PARTITION BY PID ORDER BY yr) - yr AS gap
  FROM   actor_years
),
actors_with_long_gap AS (
  SELECT DISTINCT PID
  FROM   gaps
  WHERE  gap > 3
),
actors_no_long_gap AS (
  SELECT DISTINCT PID
  FROM   actor_years
  EXCEPT
  SELECT PID
  FROM   actors_with_long_gap
)
SELECT COUNT(*) AS actors_without_4year_gap
FROM   actors_no_long_gap;
```
