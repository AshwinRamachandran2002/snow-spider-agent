--Description: Helper CTE that lists every actor (PID) paired with every
--             distinct movie year (converted to INTEGER) in which they appeared,
--             then previews the first 20 rows.
WITH actor_years AS (
  SELECT c."PID",
         CAST(m."year" AS INTEGER) AS yr
  FROM   "M_Cast" AS c
  JOIN   "Movie"  AS m
    ON   c."MID" = m."MID"
  GROUP  BY c."PID", yr
)
SELECT *
FROM   actor_years
LIMIT 20
