```sql
--Description: To understand one sample actor’s activity timeline, we
-- 1) pick the first PID that appears in M_Cast,
-- 2) join all that actor’s cast records to Movie in order to fetch the
--    release year of each film,
-- 3) use GROUP_CONCAT(DISTINCT ...) so every different year appears only once,
-- 4) group by PID so we return a single row showing the list of active years.
SELECT c."PID",
       GROUP_CONCAT(DISTINCT m."year") AS active_years
FROM   "M_Cast" AS c
JOIN   "Movie"  AS m
  ON   c."MID" = m."MID"
WHERE  c."PID" = (SELECT "PID" FROM "M_Cast" LIMIT 1)
GROUP  BY c."PID";
