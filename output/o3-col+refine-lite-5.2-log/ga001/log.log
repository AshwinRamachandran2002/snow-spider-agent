--Description: 8) Final answer – the single product (other than the tee) with the
--              highest total quantity purchased in the same December‑2020
--              transactions.
SELECT item.item_name        AS product_purchased_with_tee,
       SUM(item.quantity)    AS total_quantity_alongside_tee
FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
     ,UNNEST(items) AS item
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND ecommerce.transaction_id IN (
        SELECT DISTINCT ecommerce.transaction_id
        FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
             ,UNNEST(items) AS i
        WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
          AND LOWER(i.item_name) = 'google navy speckled tee'
          AND event_name = 'purchase'
      )
  AND LOWER(item.item_name) <> 'google navy speckled tee'
  AND event_name = 'purchase'
GROUP BY item.item_name
ORDER BY total_quantity_alongside_tee DESC
LIMIT 20
