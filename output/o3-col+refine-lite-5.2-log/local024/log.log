```sql
--Description: 1) List all different countries represented in the database (peek at country values)
SELECT DISTINCT country_name
FROM player
LIMIT 20;
```

```sql
--Description: 2) Show a sample of players together with their country of origin
SELECT DISTINCT player_id, player_name, country_name
FROM player
LIMIT 20;
```

```sql
--Description: 3) Look at a handful of matches so we know some match_ids exist
SELECT DISTINCT match_id, match_date, season_id
FROM match
LIMIT 20;
```

```sql
--Description: 4) Inspect a few rows in batsman_scored (runs scored off each ball)
SELECT DISTINCT match_id, over_id, ball_id, runs_scored, innings_no
FROM batsman_scored
LIMIT 20;
```

```sql
--Description: 5) Join ball‑by‑ball with batsman_scored to see who (striker) scored those runs
SELECT DISTINCT bs.match_id,
       bbb.striker        AS player_id,
       bs.runs_scored
FROM   batsman_scored AS bs
JOIN   ball_by_ball   AS bbb
       ON bs.match_id  = bbb.match_id
      AND bs.over_id   = bbb.over_id
      AND bs.ball_id   = bbb.ball_id
      AND bs.innings_no= bbb.innings_no
LIMIT 20;
```

```sql
--Description: 6) Aggregate to get total runs a player scored in each match (sample 20 rows)
SELECT DISTINCT player_id,
       match_id,
       SUM(runs_scored) AS runs_in_match
FROM (
        SELECT bs.match_id,
               bbb.striker        AS player_id,
               bs.runs_scored
        FROM   batsman_scored AS bs
        JOIN   ball_by_ball   AS bbb
               ON bs.match_id  = bbb.match_id
              AND bs.over_id   = bbb.over_id
              AND bs.ball_id   = bbb.ball_id
              AND bs.innings_no= bbb.innings_no
     )
GROUP BY player_id, match_id
LIMIT 20;
```

```sql
--Description: 7) Count how many matches each player batted in (sample 20)
SELECT DISTINCT player_id,
       COUNT(DISTINCT match_id) AS matches_played
FROM   player_match
GROUP BY player_id
LIMIT 20;
```

```sql
--Description: 8) Compute every player’s average runs per match (sample 20 rows)
WITH runs_per_match AS (
        SELECT bbb.striker AS player_id,
               bbb.match_id,
               SUM(bs.runs_scored) AS runs_in_match
        FROM   batsman_scored AS bs
        JOIN   ball_by_ball   AS bbb
               ON bs.match_id  = bbb.match_id
              AND bs.over_id   = bbb.over_id
              AND bs.ball_id   = bbb.ball_id
              AND bs.innings_no= bbb.innings_no
        GROUP BY bbb.striker, bbb.match_id
), matches_ct AS (
        SELECT player_id,
               COUNT(DISTINCT match_id) AS matches_played
        FROM   runs_per_match
        GROUP BY player_id
), runs_ct AS (
        SELECT player_id,
               SUM(runs_in_match)       AS total_runs
        FROM   runs_per_match
        GROUP BY player_id
)
SELECT DISTINCT r.player_id,
       ROUND(1.0 * r.total_runs / m.matches_played, 2) AS avg_runs_per_match
FROM   runs_ct     AS r
JOIN   matches_ct  AS m  USING (player_id)
LIMIT 20;
```

```sql
--Description: 9) Average those player‑level batting averages by country (sample 20)
WITH player_avg AS (
        /* use query 8’s result without LIMIT */
        WITH runs_per_match AS (
                SELECT bbb.striker AS player_id,
                       bbb.match_id,
                       SUM(bs.runs_scored) AS runs_in_match
                FROM   batsman_scored AS bs
                JOIN   ball_by_ball   AS bbb
                       ON bs.match_id  = bbb.match_id
                      AND bs.over_id   = bbb.over_id
                      AND bs.ball_id   = bbb.ball_id
                      AND bs.innings_no= bbb.innings_no
                GROUP BY bbb.striker, bbb.match_id
        ), matches_ct AS (
                SELECT player_id,
                       COUNT(DISTINCT match_id) AS matches_played
                FROM   runs_per_match
                GROUP BY player_id
        ), runs_ct AS (
                SELECT player_id,
                       SUM(runs_in_match)       AS total_runs
                FROM   runs_per_match
                GROUP BY player_id
        )
        SELECT r.player_id,
               1.0 * r.total_runs / m.matches_played AS avg_runs_per_match
        FROM   runs_ct     AS r
        JOIN   matches_ct  AS m  USING (player_id)
)
SELECT DISTINCT pl.country_name,
       ROUND(AVG(pa.avg_runs_per_match),2) AS country_batting_average
FROM   player_avg AS pa
JOIN   player     AS pl
       ON pa.player_id = pl.player_id
GROUP BY pl.country_name
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – Top 5 countries with the highest mean of their players’ average runs per match
WITH player_avg AS (
        /* Same CTE as in query 9 (without LIMIT) */
        WITH runs_per_match AS (
                SELECT bbb.striker AS player_id,
                       bbb.match_id,
                       SUM(bs.runs_scored) AS runs_in_match
                FROM   batsman_scored AS bs
                JOIN   ball_by_ball   AS bbb
                       ON bs.match_id  = bbb.match_id
                      AND bs.over_id   = bbb.over_id
                      AND bs.ball_id   = bbb.ball_id
                      AND bs.innings_no= bbb.innings_no
                GROUP BY bbb.striker, bbb.match_id
        ), matches_ct AS (
                SELECT player_id,
                       COUNT(DISTINCT match_id) AS matches_played
                FROM   runs_per_match
                GROUP BY player_id
        ), runs_ct AS (
                SELECT player_id,
                       SUM(runs_in_match)       AS total_runs
                FROM   runs_per_match
                GROUP BY player_id
        )
        SELECT r.player_id,
               1.0 * r.total_runs / m.matches_played AS avg_runs_per_match
        FROM   runs_ct     AS r
        JOIN   matches_ct  AS m  USING (player_id)
)
SELECT pl.country_name                          AS country,
       ROUND(AVG(pa.avg_runs_per_match), 2)     AS country_batting_average
FROM   player_avg  AS pa
JOIN   player      AS pl
       ON pa.player_id = pl.player_id
GROUP BY pl.country_name
ORDER BY country_batting_average DESC
LIMIT 5;
```
