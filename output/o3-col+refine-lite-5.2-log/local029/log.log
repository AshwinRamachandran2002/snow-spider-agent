```sql
--1. Inspect the customers table: customer_id vs. customer_unique_id, city, state
SELECT DISTINCT 
       "customer_id",
       "customer_unique_id",
       "customer_city",
       "customer_state"
FROM   "olist_customers"
LIMIT 20;
```

```sql
--2. Look at orders that have already been delivered
SELECT DISTINCT 
       "order_id",
       "customer_id",
       "order_status",
       "order_purchase_timestamp"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
LIMIT 20;
```

```sql
--3. Join orders ↔ customers to view delivered orders together with customer_unique_id
SELECT DISTINCT
       o."order_id",
       c."customer_unique_id",
       c."customer_city",
       c."customer_state"
FROM   "olist_orders"  AS o
JOIN   "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
LIMIT 20;
```

```sql
--4. Count delivered orders per customer_unique_id
SELECT
       c."customer_unique_id",
       COUNT(*) AS delivered_order_cnt
FROM   "olist_orders"  AS o
JOIN   "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY delivered_order_cnt DESC
LIMIT 20;
```

```sql
--5. Examine raw payment rows for a few delivered orders
SELECT DISTINCT 
       p."order_id",
       p."payment_sequential",
       p."payment_type",
       p."payment_value"
FROM   "olist_order_payments" AS p
JOIN   "olist_orders" AS o
       ON p."order_id" = o."order_id"
WHERE  o."order_status" = 'delivered'
LIMIT 20;
```

```sql
--6. Compute total payment_value per order (only delivered)
SELECT
       p."order_id",
       SUM(p."payment_value") AS total_payment
FROM   "olist_order_payments" AS p
JOIN   "olist_orders" AS o
       ON p."order_id" = o."order_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY p."order_id"
LIMIT 20;
```

```sql
--7. Average total payment per customer_unique_id (delivered orders only)
SELECT
       c."customer_unique_id",
       AVG(op.total_payment) AS avg_payment_value
FROM   (
           SELECT p."order_id",
                  SUM(p."payment_value") AS total_payment
           FROM   "olist_order_payments" AS p
           GROUP  BY p."order_id"
       ) AS op
JOIN   "olist_orders"    AS o  ON o."order_id" = op."order_id"
JOIN   "olist_customers" AS c  ON c."customer_id" = o."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
LIMIT 20;
```

```sql
--8. Final answer: top 3 customer_unique_id by number of delivered orders with their
--                 average payment value, city, and state
SELECT
       top3."customer_unique_id",
       top3.delivered_order_cnt,
       ROUND(avgpay.avg_payment_value, 2) AS avg_payment_value,
       cust."customer_city",
       cust."customer_state"
FROM  (
         SELECT
                c."customer_unique_id",
                COUNT(*) AS delivered_order_cnt
         FROM   "olist_orders"  AS o
         JOIN   "olist_customers" AS c
                ON o."customer_id" = c."customer_id"
         WHERE  o."order_status" = 'delivered'
         GROUP  BY c."customer_unique_id"
         ORDER  BY delivered_order_cnt DESC
         LIMIT 3
       ) AS top3
JOIN (
       SELECT
              c."customer_unique_id",
              AVG(op.total_payment) AS avg_payment_value
       FROM   (
                 SELECT p."order_id",
                        SUM(p."payment_value") AS total_payment
                 FROM   "olist_order_payments" AS p
                 GROUP  BY p."order_id"
              ) AS op
       JOIN   "olist_orders"    AS o  ON o."order_id" = op."order_id"
       JOIN   "olist_customers" AS c  ON c."customer_id" = o."customer_id"
       WHERE  o."order_status" = 'delivered'
       GROUP  BY c."customer_unique_id"
     ) AS avgpay
     ON top3."customer_unique_id" = avgpay."customer_unique_id"
JOIN "olist_customers" AS cust
     ON cust."customer_unique_id" = top3."customer_unique_id"
LIMIT 20;
```
