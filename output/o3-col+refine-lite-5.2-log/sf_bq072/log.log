Query:
--Description: Aggregate total deaths (ages 12–18) for ICD‑10 codes whose descriptions include “vehicle”.
SELECT 
       dr."Age"                           AS "Age",
       COUNT(DISTINCT dr."Id")            AS "Total_Vehicle_Deaths"
FROM   DEATH.DEATH.DEATHRECORDS          dr
JOIN   DEATH.DEATH.ENTITYAXISCONDITIONS  eac
       ON dr."Id" = eac."DeathRecordId"
JOIN   DEATH.DEATH.ICD10CODE             ic
       ON eac."Icd10Code" = ic."Code"
WHERE  dr."Age" BETWEEN 12 AND 18
  AND  ic."Description" ILIKE '%vehicle%'
GROUP  BY dr."Age"
ORDER  BY dr."Age"
LIMIT 20;
