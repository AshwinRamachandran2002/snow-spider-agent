```sql
--Description: Peek at death‑record rows for ages 12–18 and their corresponding race descriptions (useful to verify race codes for “Black”).
SELECT 
       dr."Id",
       dr."Age",
       dr."Race",
       r."Description" AS "Race_Description"
FROM   DEATH.DEATH.DEATHRECORDS dr
LEFT JOIN DEATH.DEATH.RACE r
       ON dr."Race" = r."Code"
WHERE  dr."Age" BETWEEN 12 AND 18
LIMIT 20;
```

```sql
--Description: Sample the linkage between deaths (ages 12–18) and ICD‑10 “vehicle” codes through the EntityAxisConditions table.
SELECT 
       dr."Id"                 AS "DeathRecordId",
       dr."Age",
       eac."Icd10Code"
FROM   DEATH.DEATH.DEATHRECORDS         dr
JOIN   DEATH.DEATH.ENTITYAXISCONDITIONS eac
       ON dr."Id" = eac."DeathRecordId"
JOIN   DEATH.DEATH.ICD10CODE            ic
       ON eac."Icd10Code" = ic."Code"
WHERE  dr."Age" BETWEEN 12 AND 18
  AND  ic."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
--Description: Sample the linkage between deaths (ages 12–18) and ICD‑10 “firearm” codes through the EntityAxisConditions table.
SELECT 
       dr."Id"                 AS "DeathRecordId",
       dr."Age",
       eac."Icd10Code"
FROM   DEATH.DEATH.DEATHRECORDS         dr
JOIN   DEATH.DEATH.ENTITYAXISCONDITIONS eac
       ON dr."Id" = eac."DeathRecordId"
JOIN   DEATH.DEATH.ICD10CODE            ic
       ON eac."Icd10Code" = ic."Code"
WHERE  dr."Age" BETWEEN 12 AND 18
  AND  ic."Description" ILIKE '%firearm%'
LIMIT 20;
```

```sql
--Description: Aggregate total deaths (ages 12–18) for ICD‑10 codes whose descriptions include “vehicle”.
SELECT 
       dr."Age"                           AS "Age",
       COUNT(DISTINCT dr."Id")            AS "Total_Vehicle_Deaths"
FROM   DEATH.DEATH.DEATHRECORDS          dr
JOIN   DEATH.DEATH.ENTITYAXISCONDITIONS  eac
       ON dr."Id" = eac."DeathRecordId"
JOIN   DEATH.DEATH.ICD10CODE             ic
       ON eac."Icd10Code" = ic."Code"
WHERE  dr."Age" BETWEEN 12 AND 18
  AND  ic."Description" ILIKE '%vehicle%'
GROUP  BY dr."Age"
ORDER  BY dr."Age"
LIMIT 20;
```

```sql
--Description: Aggregate deaths among individuals identified as Black (ages 12–18) for ICD‑10 codes whose descriptions include “vehicle”.
SELECT 
       dr."Age"                           AS "Age",
       COUNT(DISTINCT dr."Id")            AS "Black_Vehicle_Deaths"
FROM   DEATH.DEATH.DEATHRECORDS          dr
JOIN   DEATH.DEATH.ENTITYAXISCONDITIONS  eac
       ON dr."Id" = eac."DeathRecordId"
JOIN   DEATH.DEATH.ICD10CODE             ic
       ON eac."Icd10Code" = ic."Code"
JOIN   DEATH.DEATH.RACE                  r
       ON dr."Race" = r."Code"
WHERE  dr."Age" BETWEEN 12 AND 18
  AND  ic."Description" ILIKE '%vehicle%'
  AND  r."Description" ILIKE '%black%'
GROUP  BY dr."Age"
ORDER  BY dr."Age"
LIMIT 20;
```

