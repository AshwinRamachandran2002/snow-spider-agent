```sql
--Description: Show a sample of citing publications that reference (cite) any patent assigned to DENSO CORP.
WITH denso_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "assignee_harmonized"::STRING ILIKE '%DENSO%'
)
SELECT DISTINCT
    p."publication_number"  AS "citing_publication",
    f.value:"publication_number"::STRING AS "cited_publication"
FROM
    PATENTS.PATENTS.PUBLICATIONS p,
    LATERAL FLATTEN(input => p."citation") f
WHERE
    f.value:"publication_number"::STRING IN (SELECT "publication_number" FROM denso_pubs)
LIMIT 20;
```

```sql
--Description: Retrieve the assignee of each citing publication that cites a DENSO patent, so we can later exclude DENSO itself.
WITH denso_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "assignee_harmonized"::STRING ILIKE '%DENSO%'
)
SELECT
    p."publication_number" AS "citing_publication",
    p."assignee_harmonized",
    p."application_kind"
FROM
    PATENTS.PATENTS.PUBLICATIONS p,
    LATERAL FLATTEN(input => p."citation") f
WHERE
    f.value:"publication_number"::STRING IN (SELECT "publication_number" FROM denso_pubs)
LIMIT 20;
```

```sql
--Description: Sample citing publications whose assignee is NOT DENSO CORP (so we comply with the exclusion requirement).
WITH denso_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "assignee_harmonized"::STRING ILIKE '%DENSO%'
)
SELECT
    p."publication_number" AS "citing_publication",
    p."assignee_harmonized"
FROM
    PATENTS.PATENTS.PUBLICATIONS p,
