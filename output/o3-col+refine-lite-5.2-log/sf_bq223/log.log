--Description: Extract the PRIMARY (first==true) CPC code for each citing publication (still excluding DENSO assignees).
WITH denso_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "assignee_harmonized"::STRING ILIKE '%DENSO%'
),
citing_pubs AS (
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") cit
    WHERE cit.value:"publication_number"::STRING IN (SELECT "publication_number" FROM denso_pubs)
      AND p."assignee_harmonized"::STRING NOT ILIKE '%DENSO%'
)
SELECT
    cp."publication_number",
    cpc_flat.value:"code"::STRING   AS "cpc_code",
    cpc_flat.value:"first"::BOOLEAN AS "is_first"
FROM
    PATENTS.PATENTS.PUBLICATIONS cp,
    LATERAL FLATTEN(input => cp."cpc") cpc_flat
WHERE
    cp."publication_number" IN (SELECT "publication_number" FROM citing_pubs)
    AND cpc_flat.value:"first"::BOOLEAN = TRUE
LIMIT 20;
