```sql
--Description: Extract the PRIMARY (first==true) CPC code for each citing publication (still excluding DENSO assignees).
WITH denso_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "assignee_harmonized"::STRING ILIKE '%DENSO%'
),
citing_pubs AS (
    SELECT DISTINCT p."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") cit
    WHERE cit.value:"publication_number"::STRING IN (SELECT "publication_number" FROM denso_pubs)
      AND p."assignee_harmonized"::STRING NOT ILIKE '%DENSO%'
)
SELECT
    cp."publication_number",
    cpc_flat.value:"code"::STRING   AS "cpc_code",
    cpc_flat.value:"first"::BOOLEAN AS "is_first"
FROM
    PATENTS.PATENTS.PUBLICATIONS cp,
    LATERAL FLATTEN(input => cp."cpc") cpc_flat
WHERE
    cp."publication_number" IN (SELECT "publication_number" FROM citing_pubs)
    AND cpc_flat.value:"first"::BOOLEAN = TRUE
LIMIT 20;
```

```sql
--Description: Map a sample of CPC symbols to their full titles using the CPC_DEFINITION reference table.
WITH sample_cpc AS (
    SELECT DISTINCT
        cpc_flat.value:"code"::STRING AS "cpc_code"
    FROM
        PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc") cpc_flat
    WHERE
        cpc_flat.value:"first"::BOOLEAN = TRUE
    LIMIT 100
)
SELECT
    sc."cpc_code",
    cd."titleFull"
FROM
    sample_cpc  sc
    LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
           ON cd."symbol" = sc."cpc_code"
LIMIT 20;
```

```sql
--Description: Final aggregation – count of citations of DENSO patents by (non‑DENSO) citing assignee and by the full title of the primary CPC subclass.  Only citing patents with a non‑null filing_date are kept.
WITH denso_pubs AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "assignee_harmonized"::STRING ILIKE '%DENSO%'
),
citing_details AS (
    SELECT
        p."publication_number"              AS "citing_pub",
        p."assignee_harmonized"::STRING     AS "citing_assignee",
        p."filing_date",
        cpc.value:"code"::STRING            AS "cpc_primary"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") cit,
         LATERAL FLATTEN(input => p."cpc")     cpc
    WHERE cit.value:"publication_number"::STRING IN (SELECT "publication_number" FROM denso_pubs)
      AND p."assignee_harmonized"::STRING NOT ILIKE '%DENSO%'
      AND cpc.value:"first"::BOOLEAN = TRUE
      AND p."filing_date" IS NOT NULL
)
SELECT
    cd."titleFull"                 AS "cpc_title",
    citing_details."citing_assignee",
    COUNT(*)                       AS "citation_count"
FROM citing_details
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
       ON cd."symbol" = citing_details."cpc_primary"
GROUP BY
    citing_details."citing_assignee",
    cd."titleFull"
ORDER BY
    "citation_count" DESC
LIMIT 20;
```
