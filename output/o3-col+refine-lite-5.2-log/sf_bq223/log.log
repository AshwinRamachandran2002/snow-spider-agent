Query:
--Description: Map a sample of CPC symbols to their full titles using the CPC_DEFINITION reference table.
WITH sample_cpc AS (
    SELECT DISTINCT
        cpc_flat.value:"code"::STRING AS "cpc_code"
    FROM
        PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc") cpc_flat
    WHERE
        cpc_flat.value:"first"::BOOLEAN = TRUE
    LIMIT 100
)
SELECT
    sc."cpc_code",
    cd."titleFull"
FROM
    sample_cpc  sc
    LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION cd
           ON cd."symbol" = sc."cpc_code"
LIMIT 20;
