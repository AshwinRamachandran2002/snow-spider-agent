--Description:
-- Build the answer in one shot using layered CTEs.
-- • season_runs  : total runs for every (season, batsman).
-- • bat_rank     : add position (pos) inside each season using ROW_NUMBER().
-- • top_bats     : keep only the first three ranks per season.
-- • season_wkts  : wickets for every (season, bowler) ignoring ‘run out’, ‘retired hurt’, ‘hit wicket’.
-- • bowl_rank    : rank bowlers per season, add pos.
-- • top_bowl     : keep only the first three ranks per season.
-- Finally pair batsman‑pos with bowler‑pos inside each season and list the required columns.
WITH season_runs AS (
    SELECT m.season_id,
           b.striker               AS player_id,
           SUM(s.runs_scored)      AS total_runs
    FROM   ball_by_ball AS b
    JOIN   batsman_scored AS s
           ON b.match_id = s.match_id
          AND b.over_id  = s.over_id
          AND b.ball_id  = s.ball_id
    JOIN   match AS m
           ON m.match_id = b.match_id
    GROUP  BY m.season_id, b.striker
),
bat_rank AS (
    SELECT season_id,
           player_id,
           total_runs,
           ROW_NUMBER() OVER (PARTITION BY season_id
                              ORDER BY total_runs DESC, player_id) AS pos
    FROM   season_runs
),
top_bats AS (
    SELECT br.season_id,
           p.player_name         AS top_batsman,
           br.total_runs,
           br.pos
    FROM   bat_rank br
    JOIN   player p
           ON p.player_id = br.player_id
    WHERE  br.pos <= 3
),
season_wkts AS (
    SELECT m.season_id,
           b.bowler              AS player_id,
           COUNT(*)              AS wickets
    FROM   wicket_taken AS w
    JOIN   ball_by_ball AS b
           ON w.match_id = b.match_id
          AND w.over_id  = b.over_id
          AND w.ball_id  = b.ball_id
    JOIN   match AS m
           ON m.match_id = w.match_id
    WHERE  w.kind_out NOT IN ('run out', 'retired hurt', 'hit wicket')
    GROUP  BY m.season_id, b.bowler
),
bowl_rank AS (
    SELECT season_id,
           player_id,
           wickets,
           ROW_NUMBER() OVER (PARTITION BY season_id
                              ORDER BY wickets DESC, player_id) AS pos
    FROM   season_wkts
),
top_bowl AS (
    SELECT br.season_id,
           p.player_name         AS top_bowler,
           br.wickets,
           br.pos
    FROM   bowl_rank br
    JOIN   player p
           ON p.player_id = br.player_id
    WHERE  br.pos <= 3
)
SELECT tb.season_id,
       tb.top_batsman,
       tb.total_runs,
       tl.top_bowler,
       tl.wickets
FROM   top_bats tb
JOIN   top_bowl tl
  ON   tb.season_id = tl.season_id
 AND   tb.pos       = tl.pos
ORDER  BY tb.season_id, tb.pos;
