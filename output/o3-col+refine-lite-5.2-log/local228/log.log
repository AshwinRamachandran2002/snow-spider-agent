```sql
-- 3.  Inspect how runs are stored –– one season, one match, first few deliveries
SELECT b."match_id",
       m."season_id",
       b."over_id",
       b."ball_id",
       s."runs_scored",
       b."striker"
FROM   "ball_by_ball" AS b
JOIN   "batsman_scored" AS s
       ON b."match_id" = s."match_id"
      AND b."over_id"  = s."over_id"
      AND b."ball_id"  = s."ball_id"
JOIN   "match" AS m
       ON m."match_id" = b."match_id"
WHERE  m."season_id" = 1
LIMIT 20;
```

```sql
-- 4.  Aggregate total runs by batsman for one sample season to verify numbers
SELECT m."season_id",
       b."striker"        AS "batsman_id",
       SUM(s."runs_scored") AS "total_runs"
FROM   "ball_by_ball"  AS b
JOIN   "batsman_scored" AS s
       ON b."match_id" = s."match_id"
      AND b."over_id"  = s."over_id"
      AND b."ball_id"  = s."ball_id"
JOIN   "match" AS m
       ON m."match_id" = b."match_id"
WHERE  m."season_id" = 1
GROUP  BY m."season_id", b."striker"
ORDER  BY "total_runs" DESC, "batsman_id"
LIMIT 20;
```

```sql
-- 5.  Look at wicket types to confirm which values appear
SELECT DISTINCT "kind_out"
FROM "wicket_taken"
ORDER BY "kind_out"
LIMIT 20;
```

```sql
-- 6.  Sample count of wickets (excluding run‑out, hit‑wicket, retired‑hurt) for one season
SELECT m."season_id",
       b."bowler",
       COUNT(*) AS "wickets"
FROM   "wicket_taken"  AS w
JOIN   "ball_by_ball"  AS b
       ON w."match_id" = b."match_id"
      AND w."over_id"  = b."over_id"
      AND w."ball_id"  = b."ball_id"
JOIN   "match" AS m
       ON m."match_id" = w."match_id"
WHERE  m."season_id" = 1
  AND  w."kind_out" NOT IN ('run out','retired hurt','hit wicket')
GROUP  BY m."season_id", b."bowler"
ORDER  BY "wickets" DESC, b."bowler"
LIMIT 20;
```

```sql
-- 7.  Top three batsmen for every season with tie‑break on smaller player_id
WITH season_runs AS (
  SELECT m."season_id",
         b."striker"            AS "player_id",
         SUM(s."runs_scored")   AS "total_runs"
  FROM   "ball_by_ball"  AS b
  JOIN   "batsman_scored" AS s
         ON b."match_id" = s."match_id"
        AND b."over_id"  = s."over_id"
        AND b."ball_id"  = s."ball_id"
  JOIN   "match" AS m
         ON m."match_id" = b."match_id"
  GROUP  BY m."season_id", b."striker"
), ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "season_id"
                            ORDER BY "total_runs" DESC, "player_id") AS rn
  FROM season_runs
)
SELECT "season_id", "player_id", "total_runs"
FROM   ranked
WHERE  rn <= 3
ORDER  BY "season_id", rn
LIMIT 20;
```

```sql
-- 8.  Top three bowlers for every season with tie‑break on smaller player_id
WITH season_wkts AS (
  SELECT m."season_id",
         b."bowler"             AS "player_id",
         COUNT(*)               AS "wickets"
  FROM   "wicket_taken" AS w
  JOIN   "ball_by_ball" AS b
         ON w."match_id" = b."match_id"
        AND w."over_id"  = b."over_id"
        AND w."ball_id"  = b."ball_id"
  JOIN   "match" AS m
         ON m."match_id" = w."match_id"
  WHERE  w."kind_out" NOT IN ('run out','retired hurt','hit wicket')
  GROUP  BY m."season_id", b."bowler"
), ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "season_id"
                            ORDER BY "wickets" DESC, "player_id") AS rn
  FROM season_wkts
)
SELECT "season_id", "player_id", "wickets"
FROM   ranked
WHERE  rn <= 3
ORDER  BY "season_id", rn
LIMIT 20;
```

```sql
-- 9.  Combine top‑3 batsmen & bowlers for each season in matched positions
WITH bats AS (
  SELECT m."season_id",
         p."player_name",
         r."total_runs",
         ROW_NUMBER() OVER (PARTITION BY m."season_id"
                            ORDER BY r."total_runs" DESC, r."player_id") AS pos
  FROM ( /* reuse CTE 7 */
        SELECT m."season_id",
               b."striker"          AS "player_id",
               SUM(s."runs_scored") AS "total_runs"
        FROM   "ball_by_ball"  AS b
        JOIN   "batsman_scored" AS s
               ON b."match_id" = s."match_id"
              AND b."over_id"  = s."over_id"
              AND b."ball_id"  = s."ball_id"
        JOIN   "match" AS m
               ON m."match_id" = b."match_id"
        GROUP  BY m."season_id", b."striker"
       ) AS r
  JOIN "player" AS p ON p."player_id" = r."player_id"
), bowl AS (
  SELECT m."season_id",
         p."player_name",
         r."wickets",
         ROW_NUMBER() OVER (PARTITION BY m."season_id"
                            ORDER BY r."wickets" DESC, r."player_id") AS pos
  FROM ( /* reuse CTE 8 */
        SELECT m."season_id",
               b."bowler"      AS "player_id",
               COUNT(*)        AS "wickets"
        FROM   "wicket_taken" AS w
        JOIN   "ball_by_ball" AS b
               ON w."match_id" = b."match_id"
              AND w."over_id"  = b."over_id"
              AND w."ball_id"  = b."ball_id"
        JOIN   "match" AS m
               ON m."match_id" = w."match_id"
        WHERE  w."kind_out" NOT IN ('run out','retired hurt','hit wicket')
        GROUP  BY m."season_id", b."bowler"
       ) AS r
  JOIN "player" AS p ON p."player_id" = r."player_id"
)
SELECT bats."season_id",
       bats."player_name"   AS "top_batsman",
       bats."total_runs",
       bowl."player_name"   AS "top_bowler",
       bowl."wickets"
FROM   bats
JOIN   bowl
  ON   bats."season_id" = bowl."season_id"
 AND   bats."pos"       = bowl."pos"
WHERE  bats."pos" <= 3
ORDER  BY bats."season_id", bats."pos"
LIMIT 20;
```

```sql
--10.  Same as #9 but include team names for extra context (optional exploration)
WITH bats AS (
  /* identical to #9 through pos calculation */
  SELECT r."season_id",
         p."player_name",
         r."total_runs",
         ROW_NUMBER() OVER (PARTITION BY r."season_id"
                            ORDER BY r."total_runs" DESC, r."player_id") AS pos
  FROM (
        SELECT m."season_id",
               b."striker"          AS "player_id",
               SUM(s."runs_scored") AS "total_runs"
        FROM   "ball_by_ball"  AS b
        JOIN   "batsman_scored" AS s
               ON b."match_id" = s."match_id"
              AND b."over_id"  = s."over_id"
              AND b."ball_id"  = s."ball_id"
        JOIN   "match" AS m
               ON m."match_id" = b."match_id"
        GROUP  BY m."season_id", b."striker"
       ) AS r
  JOIN "player" AS p ON p."player_id" = r."player_id"
), bowl AS (
  /* identical to #9 through pos calculation */
  SELECT r."season_id",
         p."player_name",
         r."wickets",
         ROW_NUMBER() OVER (PARTITION BY r."season_id"
                            ORDER BY r."wickets" DESC, r."player_id") AS pos
  FROM (
        SELECT m."season_id",
               b."bowler"      AS "player_id",
               COUNT(*)        AS "wickets"
        FROM   "wicket_taken" AS w
        JOIN   "ball_by_ball" AS b
               ON w."match_id" = b."match_id"
              AND w."over_id"  = b."over_id"
              AND w."ball_id"  = b."ball_id"
        JOIN   "match" AS m
               ON m."match_id" = w."match_id"
        WHERE  w."kind_out" NOT IN ('run out','retired hurt','hit wicket')
        GROUP  BY m."season_id", b."bowler"
       ) AS r
  JOIN "player" AS p ON p."player_id" = r."player_id"
)
SELECT bats."season_id",
       bats."player_name" AS "top_batsman",
       bats."total_runs",
       bowl."player_name" AS "top_bowler",
       bowl."wickets"
FROM   bats
JOIN   bowl
  ON   bats."season_id" = bowl."season_id"
 AND   bats."pos"       = bowl."pos"
WHERE  bats."pos" <= 3
ORDER  BY bats."season_id", bats."pos"
LIMIT 20;
```
