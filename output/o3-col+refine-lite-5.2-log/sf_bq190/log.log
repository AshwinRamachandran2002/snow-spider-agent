```sql
--Description: For each gender, get the minimum and maximum age among users
-- who signed up in the requested time window
SELECT "gender",
       MIN("age") AS "min_age",
       MAX("age") AS "max_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363200000000
GROUP BY "gender"
LIMIT 20;
```

```sql
--Description: Identify every user that is the *youngest* (has the min age) for each gender
WITH age_bounds AS (
    SELECT "gender", MIN("age") AS "min_age"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
    WHERE "created_at" BETWEEN 1546300800000000 AND 1651363200000000
    GROUP BY "gender"
)
SELECT u."gender",
       u."age",
       COUNT(*) AS "users_with_min_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
JOIN age_bounds b
  ON u."gender" = b."gender" 
 AND u."age"    = b."min_age"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363200000000
GROUP BY u."gender", u."age"
LIMIT 20;
```

```sql
--Description: Identify every user that is the *oldest* (has the max age) for each gender
WITH age_bounds AS (
    SELECT "gender", MAX("age") AS "max_age"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
    WHERE "created_at" BETWEEN 1546300800000000 AND 1651363200000000
    GROUP BY "gender"
)
SELECT u."gender",
       u."age",
       COUNT(*) AS "users_with_max_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
JOIN age_bounds b
  ON u."gender" = b."gender" 
 AND u."age"    = b."max_age"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363200000000
GROUP BY u."gender", u."age"
LIMIT 20;
```

```sql
--Description: Combine youngest and oldest counts per gender in one result set
WITH bounds AS (
    SELECT "gender",
           MIN("age") AS "min_age",
           MAX("age") AS "max_age"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
    WHERE "created_at" BETWEEN 1546300800000000 AND 1651363200000000
    GROUP BY "gender"
),
extremes AS (
    SELECT u."gender",
           CASE WHEN u."age" = b."min_age" THEN 'youngest' ELSE 'oldest' END AS "age_group",
           COUNT(*) AS "user_count"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
    JOIN bounds b
      ON u."gender" = b."gender"
     AND (u."age" = b."min_age" OR u."age" = b."max_age")
    WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363200000000
    GROUP BY u."gender",
             CASE WHEN u."age" = b."min_age" THEN 'youngest' ELSE 'oldest' END
)
SELECT *
FROM extremes
ORDER BY "gender", "age_group"
LIMIT 20;
```

```sql
--Description: Inspect users who are at either the minimum or maximum age
-- (for manual validation / spot‑checking)
WITH bounds AS (
    SELECT "gender",
           MIN("age") AS "min_age",
           MAX("age") AS "max_age"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
    WHERE "created_at" BETWEEN 1546300800000000 AND 1651363200000000
    GROUP BY "gender"
)
SELECT u.*
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
JOIN bounds b
  ON u."gender" = b."gender"
 WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363200000000
   AND (u."age" = b."min_age" OR u."age" = b."max_age")
LIMIT 20;
```
