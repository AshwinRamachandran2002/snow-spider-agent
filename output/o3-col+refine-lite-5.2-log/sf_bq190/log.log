Query:
--Description: Identify every user that is the *youngest* (has the min age) for each gender
WITH age_bounds AS (
    SELECT "gender", MIN("age") AS "min_age"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
    WHERE "created_at" BETWEEN 1546300800000000 AND 1651363200000000
    GROUP BY "gender"
)
SELECT u."gender",
       u."age",
       COUNT(*) AS "users_with_min_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
JOIN age_bounds b
  ON u."gender" = b."gender" 
 AND u."age"    = b."min_age"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363200000000
GROUP BY u."gender", u."age"
LIMIT 20;
