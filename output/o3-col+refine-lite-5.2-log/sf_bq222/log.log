```sql
--Description:  Determine, for every CPC CLASS (level‑4 code = one section letter + two digits),
--the filing year in which German patents show the highest exponential moving average
--of filings (EMA with α = 0.1).  Steps performed inside this single query:
--  1)  Extract each publication’s CPC class and filing year.
--  2)  Aggregate to yearly filing counts per class.
--  3)  Apply Snowflake’s EXPONENTIAL_MOVING_AVERAGE(count , 0.1) window function
--      to compute a running EMA across years (partitioned by class, ordered by year).
--  4)  Rank years within each class by EMA (descending) and keep the top‑ranked row.
--  5)  Join to CPC_DEFINITION (level = 4) to fetch the full class title.
--  6)  Return up to 20 rows.

WITH de_yearly AS (            -- Step 1
    SELECT
        REGEXP_SUBSTR(
            SPLIT_PART(f.value::VARIANT:"code"::STRING, '/', 1),  -- remove subgroup part
            '^[A-Z][0-9]{2}'                                      -- keep letter + 2 digits
        )                               AS "cpc_class",
        FLOOR(p."filing_date" / 10000)  AS "filing_year",
        1                                AS "filing_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."filing_date" IS NOT NULL
      AND p."cpc" IS NOT NULL
),
agg AS (                       -- Step 2
    SELECT
        "cpc_class",
        "filing_year",
        COUNT(*) AS "yr_count"
    FROM de_yearly
    GROUP BY 1, 2
),
ema_calc AS (                  -- Step 3
    SELECT
        a."cpc_class",
        a."filing_year",
        a."yr_count",
        EXPONENTIAL_MOVING_AVERAGE(a."yr_count", 0.1) OVER (
            PARTITION BY a."cpc_class"
            ORDER BY a."filing_year"
        ) AS "ema_count"
    FROM agg a
),
best_year AS (                 -- Step 4
    SELECT
        e.*,
        RANK() OVER (PARTITION BY e."cpc_class" ORDER BY e."ema_count" DESC) AS "rnk"
    FROM ema_calc e
)
SELECT                          -- Steps 5 & 6
    b."cpc_class"                       AS "cpc_level4",
    d."titleFull"                       AS "technology_full_title",
    b."filing_year"                     AS "best_year",
    b."ema_count"                       AS "max_ema"
FROM best_year b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON b."cpc_class" = d."symbol" AND d."level" = 4
WHERE b."rnk" = 1
LIMIT 20;
