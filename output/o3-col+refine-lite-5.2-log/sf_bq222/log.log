```sql
--Description: 8)  Yearly filing counts per CPC group (level‑4) for ALL German patents
WITH de_pub AS (
  SELECT 
    p."publication_number",
    SPLIT_PART(f.value::VARIANT:"code"::STRING, '/', 1) AS "cpc_group",
    FLOOR(p."filing_date"/10000)                       AS "filing_year"
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc") f
  WHERE p."country_code" = 'DE'
        AND p."filing_date" IS NOT NULL
)
SELECT 
  "cpc_group",
  "filing_year",
  COUNT(*) AS "filing_count"
FROM de_pub
GROUP BY 1,2
ORDER BY 1,2
LIMIT 20;
```

```sql
--Description: 9)  Exponential Moving Average (α = 0.1) of yearly filing counts for each CPC group
WITH de_yearly AS (
  SELECT 
    p."cpc_group",
    p."filing_year",
    SUM(p."filing_count") AS "yr_count"
  FROM (
      SELECT 
        SPLIT_PART(f.value::VARIANT:"code"::STRING, '/', 1) AS "cpc_group",
        FLOOR(pu."filing_date"/10000)                       AS "filing_year",
        1                                                   AS "filing_count"
      FROM PATENTS.PATENTS.PUBLICATIONS pu,
           LATERAL FLATTEN(input => pu."cpc") f
      WHERE pu."country_code" = 'DE'
            AND pu."filing_date" IS NOT NULL
  ) p
  GROUP BY 1,2
),
ema AS (
  SELECT
    d."cpc_group",
    d."filing_year",
    d."yr_count",
    EXPONENTIAL_MOVING_AVERAGE(d."yr_count") OVER(
        PARTITION BY d."cpc_group"
        ORDER BY d."filing_year"
        ALPHA => 0.1
    ) AS "ema_count"
  FROM de_yearly d
)
SELECT * 
FROM ema
LIMIT 20;
```

```sql
--Description: 10)  For each CPC level‑4 technology area, return the year with the highest EMA, together with its full title
WITH de_yearly AS (
  SELECT 
    SPLIT_PART(f.value::VARIANT:"code"::STRING, '/', 1) AS "cpc_group",
    FLOOR(pu."filing_date"/10000)                       AS "filing_year",
    1                                                   AS "filing_count"
  FROM PATENTS.PATENTS.PUBLICATIONS pu,
       LATERAL FLATTEN(input => pu."cpc") f
  WHERE pu."country_code" = 'DE'
        AND pu."filing_date" IS NOT NULL
),
agg AS (
  SELECT 
    "cpc_group",
    "filing_year",
    COUNT(*) AS "yr_count"
  FROM de_yearly
  GROUP BY 1,2
),
ema AS (
  SELECT
    a."cpc_group",
    a."filing_year",
    a."yr_count",
    EXPONENTIAL_MOVING_AVERAGE(a."yr_count") OVER(
        PARTITION BY a."cpc_group"
        ORDER BY a."filing_year"
        ALPHA => 0.1
    ) AS "ema_count"
  FROM agg a
),
ranked AS (
  SELECT
    e.*,
    RANK() OVER (PARTITION BY e."cpc_group" ORDER BY e."ema_count" DESC) AS rnk
  FROM ema e
)
SELECT 
  r."cpc_group",
  d."titleFull"  AS "technology_full_title",
  r."filing_year" AS "best_year",
  r."ema_count"   AS "max_ema"
FROM ranked r
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON r."cpc_group" = d."symbol" AND d."level" = 4
WHERE r.rnk = 1
LIMIT 20;
```
