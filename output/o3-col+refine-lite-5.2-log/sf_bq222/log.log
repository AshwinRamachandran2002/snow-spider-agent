```sql
--Description:  Build the exponential moving average (EMA, α = 0.1) of yearly German
--patent‑filing counts for every CPC CLASS (level‑4 = one letter + two digits) using a
--recursive CTE.  Because Snowflake in this environment does not support EMA/EXPONENTIAL_
--MOVING_AVERAGE as a window function, we calculate it manually.
--
--Steps (all inside this single query):
-- 1)  Flatten each publication’s CPC list, keep the class (regex ^[A‑Z][0‑9]{2}),
--     and derive its filing year.
-- 2)  Aggregate to yearly counts per class.
-- 3)  Give each row a sequential number per class (ORDER BY year) so the recursion
--     can progress in chronological order.
-- 4)  Recursive CTE “ema_calc”:
--       • Base case (rn = 1)  : ema = yr_count
--       • Recursive step      : ema = 0.1*yr_count + 0.9*prev_ema
-- 5)  Return the class, year, raw yearly count, and EMA; limit to 20 rows.

WITH de_yearly AS (                       -- 1) raw rows -> (class, year, 1)
    SELECT
        REGEXP_SUBSTR(
            SPLIT_PART(f.value::VARIANT:"code"::STRING, '/', 1),
            '^[A-Z][0-9]{2}'                       -- class, e.g. H03
        )                              AS cpc_class,
        FLOOR(p."filing_date" / 10000) AS filing_year,
        1                               AS filing_count
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."filing_date"  IS NOT NULL
      AND p."cpc"          IS NOT NULL
),
agg AS (                                 -- 2) yearly totals per class
    SELECT
        cpc_class,
        filing_year,
        COUNT(*) AS yr_count
    FROM de_yearly
    GROUP BY 1, 2
),
sorted AS (                              -- 3) chronological numbering
    SELECT
        a.*,
        ROW_NUMBER() OVER (
            PARTITION BY a.cpc_class
            ORDER BY a.filing_year
        ) AS rn
    FROM agg a
),
RECURSIVE ema_calc (cpc_class, filing_year, yr_count, ema_count, rn) AS (   -- 4)
    -- seed row (first year of each class)
    SELECT
        s.cpc_class,
        s.filing_year,
        s.yr_count,
        CAST(s.yr_count AS DOUBLE) AS ema_count,   -- ema₁ = yr_count₁
        s.rn
    FROM sorted s
    WHERE s.rn = 1

    UNION ALL

    -- recursive step for subsequent years
    SELECT
        s.cpc_class,
        s.filing_year,
        s.yr_count,
        0.1 * s.yr_count + 0.9 * e.ema_count AS ema_count,
        s.rn
    FROM ema_calc e
    JOIN sorted  s
      ON s.cpc_class = e.cpc_class
     AND s.rn       = e.rn + 1
)
SELECT                                       -- 5) output
    cpc_class,
    filing_year,
    yr_count,
    ema_count
FROM ema_calc
ORDER BY cpc_class, filing_year
LIMIT 20;
```
