--Description: 5)  CPC group (take text before “/”) and how often it appears among December 2016 German grants
SELECT 
  SPLIT_PART(f.value::VARIANT:"code"::STRING, '/', 1) AS "cpc_group",
  COUNT(*) AS "grant_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc") f
