Query:
--Description: 8)  Yearly filing counts per CPC CLASS (level‑4: one letter + two digits) for all German patents
WITH de_pub AS (
    SELECT 
        p."publication_number",
        REGEXP_SUBSTR(                                   -- extract class code (e.g. “H03”)
            SPLIT_PART(f.value::VARIANT:"code"::STRING, '/', 1),
            '^[A-Z][0-9]{2}'
        )                               AS "cpc_class",
        FLOOR(p."filing_date" / 10000)  AS "filing_year"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."filing_date" IS NOT NULL
      AND p."cpc" IS NOT NULL
)
SELECT
    "cpc_class",
    "filing_year",
    COUNT(*) AS "filing_count"
FROM de_pub
GROUP BY 1, 2
ORDER BY 1, 2
LIMIT 20
