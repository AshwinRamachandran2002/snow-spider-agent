--Description:  Re‑compute yearly filing totals for every CPC CLASS (letter+2‑digits) in German
--patent data and apply Snowflake’s EMA window function (EMA(value, 0.1)) to obtain the
--exponential moving average with smoothing factor α = 0.1.  The query is self‑contained:
--   1) Flatten each publication’s CPC list, extract the class, derive filing year.
--   2) Aggregate to yearly counts (yr_count) per class.
--   3) Use EMA(yr_count, 0.1) OVER (PARTITION BY class ORDER BY year) to compute the EMA.
--   4) Return the first 20 rows for inspection.

WITH de_yearly AS (  -- step 1
    SELECT
        REGEXP_SUBSTR(
            SPLIT_PART(f.value::VARIANT:"code"::STRING, '/', 1),  -- drop subgroup
            '^[A-Z][0-9]{2}'                                     -- keep class (e.g., H03)
        )                              AS "cpc_class",
        FLOOR(p."filing_date" / 10000) AS "filing_year",
        1                               AS "filing_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."filing_date" IS NOT NULL
      AND p."cpc" IS NOT NULL
),
agg AS (           -- step 2
    SELECT
        "cpc_class",
        "filing_year",
        COUNT(*) AS "yr_count"
    FROM de_yearly
    GROUP BY 1, 2
)
SELECT             -- steps 3 & 4
    a."cpc_class",
    a."filing_year",
    a."yr_count",
    EMA(a."yr_count", 0.1) OVER (
        PARTITION BY a."cpc_class"
        ORDER BY a."filing_year"
    ) AS "ema_count"
FROM agg a
LIMIT 20;
```
