--Description: 9)  Exponential Moving Average (α = 0.1) of yearly filing counts for each CPC CLASS
WITH de_yearly AS (
    SELECT
        REGEXP_SUBSTR(
            SPLIT_PART(f.value::VARIANT:"code"::STRING, '/', 1),
            '^[A-Z][0-9]{2}'
        )                               AS "cpc_class",
        FLOOR(p."filing_date" / 10000)  AS "filing_year",
        1                                AS "filing_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND p."filing_date" IS NOT NULL
      AND p."cpc" IS NOT NULL
), agg AS (
    SELECT
        "cpc_class",
        "filing_year",
        COUNT(*) AS "yr_count"
    FROM de_yearly
