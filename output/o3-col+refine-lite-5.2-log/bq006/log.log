Query:
--Description:  (6)  Show the two days with the highest Z‑scores so we can pick
--              out which date ranks second.
WITH daily AS (
  SELECT DATE(`timestamp`) AS incident_date,
         COUNT(*)          AS cnt
  FROM   `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE  LOWER(`descript`) LIKE '%public%intox%'
  GROUP  BY incident_date
),
stats AS (
  SELECT AVG(cnt)        AS mean_cnt,
         STDDEV_POP(cnt) AS sd_cnt
  FROM   daily
)
SELECT d.incident_date,
       d.cnt,
       ROUND((d.cnt - s.mean_cnt) / s.sd_cnt, 2) AS zscore
FROM   daily AS d
CROSS  JOIN stats AS s
ORDER  BY zscore DESC
LIMIT 2
Answer:
incident_date,cnt,zscore
2016-02-07,20,4.59
2016-01-01,17,3.59
Query:
--Description:  (7)  Return only the date with the second‑highest Z‑score for
--              public‑intoxication incidents in 2016.
WITH daily AS (
  SELECT DATE(`timestamp`) AS incident_date,
         COUNT(*)          AS cnt
  FROM   `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE  LOWER(`descript`) LIKE '%public%intox%'
  GROUP  BY incident_date
),
stats AS (
  SELECT AVG(cnt)        AS mean_cnt,
         STDDEV_POP(cnt) AS sd_cnt
  FROM   daily
),
ranked AS (
  SELECT incident_date,
         cnt,
         (cnt - mean_cnt)/sd_cnt AS zscore,
         ROW_NUMBER() OVER (ORDER BY (cnt - mean_cnt)/sd_cnt DESC) AS rnk
  FROM   daily, stats
)
SELECT incident_date
FROM   ranked
WHERE  rnk = 2
