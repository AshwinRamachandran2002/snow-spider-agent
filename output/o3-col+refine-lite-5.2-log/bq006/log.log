```sql
-- 2.  All 2016 “PUBLIC INTOXICATION” rows (checking both columns)
SELECT `timestamp`, `primary_type`, `description`
FROM   `bigquery-public-data.austin_crime.crime`
WHERE  `year` = 2016
  AND (UPPER(`primary_type`)    = 'PUBLIC INTOXICATION'
       OR  UPPER(`description`) = 'PUBLIC INTOXICATION')
LIMIT 20;
```

```sql
-- 3.  How many such incidents happened each day in 2016?
SELECT DATE(`timestamp`) AS incident_date,
       COUNT(*)          AS cnt
FROM   `bigquery-public-data.austin_crime.crime`
WHERE  `year` = 2016
  AND (UPPER(`primary_type`)    = 'PUBLIC INTOXICATION'
       OR  UPPER(`description`) = 'PUBLIC INTOXICATION')
GROUP  BY incident_date
ORDER  BY incident_date
LIMIT 20;
```

```sql
-- 4.  Compute mean & standard‑deviation of the daily counts
WITH daily AS (
  SELECT DATE(`timestamp`) AS incident_date,
         COUNT(*)          AS cnt
  FROM   `bigquery-public-data.austin_crime.crime`
  WHERE  `year` = 2016
    AND (UPPER(`primary_type`)    = 'PUBLIC INTOXICATION'
         OR  UPPER(`description`) = 'PUBLIC INTOXICATION')
  GROUP  BY incident_date
)
SELECT AVG(cnt) AS mean_cnt,
       STDDEV_POP(cnt) AS sd_cnt
FROM   daily;
```

```sql
-- 5.  Add the Z‑score for every day
WITH daily AS (
  SELECT DATE(`timestamp`) AS incident_date,
         COUNT(*)          AS cnt
  FROM   `bigquery-public-data.austin_crime.crime`
  WHERE  `year` = 2016
    AND (UPPER(`primary_type`)    = 'PUBLIC INTOXICATION'
         OR  UPPER(`description`) = 'PUBLIC INTOXICATION')
  GROUP  BY incident_date
),
stats AS (
  SELECT AVG(cnt)        AS mean_cnt,
         STDDEV_POP(cnt) AS sd_cnt
  FROM   daily
)
SELECT d.incident_date,
       d.cnt,
       (d.cnt - s.mean_cnt) / s.sd_cnt AS zscore
FROM   daily AS d
CROSS  JOIN stats AS s
ORDER  BY zscore DESC
LIMIT 20;
```

```sql
-- 6.  Display only the two highest Z‑score days to see which one is 2nd
WITH daily AS (
  SELECT DATE(`timestamp`) AS incident_date,
         COUNT(*)          AS cnt
  FROM   `bigquery-public-data.austin_crime.crime`
  WHERE  `year` = 2016
    AND (UPPER(`primary_type`)    = 'PUBLIC INTOXICATION'
         OR  UPPER(`description`) = 'PUBLIC INTOXICATION')
  GROUP  BY incident_date
),
stats AS (
  SELECT AVG(cnt)        AS mean_cnt,
         STDDEV_POP(cnt) AS sd_cnt
  FROM   daily
)
SELECT d.incident_date,
       d.cnt,
       ROUND((d.cnt - s.mean_cnt) / s.sd_cnt,2) AS zscore
FROM   daily AS d
CROSS  JOIN stats AS s
ORDER  BY zscore DESC
LIMIT 2;
```

```sql
-- 7.  Pull only the second‑highest Z‑score date
WITH daily AS (
  SELECT DATE(`timestamp`) AS incident_date,
         COUNT(*)          AS cnt
  FROM   `bigquery-public-data.austin_crime.crime`
  WHERE  `year` = 2016
    AND (UPPER(`primary_type`)    = 'PUBLIC INTOXICATION'
         OR  UPPER(`description`) = 'PUBLIC INTOXICATION')
  GROUP  BY incident_date
),
stats AS (
  SELECT AVG(cnt)        AS mean_cnt,
         STDDEV_POP(cnt) AS sd_cnt
  FROM   daily
),
ranked AS (
  SELECT incident_date,
         cnt,
         (cnt - mean_cnt)/sd_cnt AS zscore,
         ROW_NUMBER() OVER (ORDER BY (cnt - mean_cnt)/sd_cnt DESC) AS rnk
  FROM   daily, stats
)
SELECT incident_date
FROM   ranked
WHERE  rnk = 2;
```

