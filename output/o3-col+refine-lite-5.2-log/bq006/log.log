Query:
--Description:  (4)  Compute the mean and population standard deviation of the
--              daily public‑intoxication incident counts in 2016.
WITH daily AS (
  SELECT DATE(`timestamp`) AS incident_date,
         COUNT(*)          AS cnt
  FROM   `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE  LOWER(`descript`) LIKE '%public%intox%'
  GROUP  BY incident_date
)
SELECT AVG(cnt)        AS mean_cnt,
       STDDEV_POP(cnt) AS sd_cnt
FROM   daily
Answer:
mean_cnt,sd_cnt
6.214912280701755,3.0047252977788745
Query:
--Description:  (5)  Attach a Z‑score to every 2016 day based on its
--              public‑intoxication count.
WITH daily AS (
  SELECT DATE(`timestamp`) AS incident_date,
         COUNT(*)          AS cnt
  FROM   `bigquery-public-data.austin_incidents.incidents_2016`
  WHERE  LOWER(`descript`) LIKE '%public%intox%'
  GROUP  BY incident_date
),
stats AS (
  SELECT AVG(cnt)        AS mean_cnt,
         STDDEV_POP(cnt) AS sd_cnt
  FROM   daily
)
SELECT d.incident_date,
       d.cnt,
       (d.cnt - s.mean_cnt) / s.sd_cnt AS zscore
FROM   daily AS d
CROSS  JOIN stats AS s
ORDER  BY zscore DESC
LIMIT 20
Answer:
