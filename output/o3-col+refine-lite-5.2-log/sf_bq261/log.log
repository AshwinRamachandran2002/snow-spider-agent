```sql
--Description: Quick look at the basic columns available in ORDER_ITEMS
SELECT 
    "id",
    "order_id",
    "product_id",
    "sale_price",
    "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: Preview PRODUCT table to see product‑level cost and name information
SELECT 
    "id"      AS "product_id",
    "name"    AS "product_name",
    "cost",
    "retail_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
LIMIT 20;
```

```sql
--Description: Join ORDER_ITEMS with PRODUCTS to calculate profit for a handful of rows
SELECT 
    oi."id"                         AS "order_item_id",
    oi."product_id",
    p."name"                        AS "product_name",
    oi."sale_price",
    p."cost",
    (oi."sale_price" - p."cost")    AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
  ON oi."product_id" = p."id"
LIMIT 20;
```

```sql
--Description: Create month buckets from ORDER_ITEMS timestamps to verify the time logic
SELECT
    DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "month",
    COUNT(*)                                                   AS "order_item_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Aggregate total cost & profit per product per month (sample output)
SELECT
    DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))      AS "month",
    oi."product_id",
    SUM(p."cost")                                                   AS "total_cost",
    SUM(oi."sale_price" - p."cost")                                 AS "total_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
  ON oi."product_id" = p."id"
GROUP BY 1, 2
ORDER BY 1, 4 DESC
LIMIT 20;
```

```sql
--Description: Rank products within each month by total profit to locate the top seller
SELECT
    sub."month",
    sub."product_id",
    sub."total_cost",
    sub."total_profit",
    RANK() OVER (PARTITION BY sub."month" ORDER BY sub."total_profit" DESC) AS "rnk"
FROM (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))  AS "month",
        oi."product_id",
        SUM(p."cost")                                               AS "total_cost",
        SUM(oi."sale_price" - p."cost")                             AS "total_profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
      ON oi."product_id" = p."id"
    GROUP BY 1, 2
) sub
ORDER BY sub."month", sub."total_profit" DESC
LIMIT 20;
```

```sql
--Description: Filter to months strictly before January 2024 and pick only the top‑ranked product per month
SELECT
    t."month",
    t."product_id",
    t."total_cost",
    t."total_profit"
FROM (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))  AS "month",
        oi."product_id",
        SUM(p."cost")                                               AS "total_cost",
        SUM(oi."sale_price" - p."cost")                             AS "total_profit",
        RANK() OVER (PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))
                     ORDER BY SUM(oi."sale_price" - p."cost") DESC) AS "rnk"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
      ON oi."product_id" = p."id"
    WHERE DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) < '2024-01-01'
    GROUP BY 1, 2
) t
WHERE t."rnk" = 1
ORDER BY t."month"
LIMIT 20;
```

```sql
--Description: Add readable product name for the top‑profit product per month (final compilation query)
SELECT
    t."month",
    p."name"           AS "product_name",
    t."total_cost",
    t."total_profit"
FROM (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))  AS "month",
        oi."product_id",
        SUM(p."cost")                                               AS "total_cost",
        SUM(oi."sale_price" - p."cost")                             AS "total_profit",
        RANK() OVER (PARTITION BY DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))
                     ORDER BY SUM(oi."sale_price" - p."cost") DESC) AS "rnk"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
      ON oi."product_id" = p."id"
    WHERE DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) < '2024-01-01'
    GROUP BY 1, 2
) t
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
  ON t."product_id" = p."id"
WHERE t."rnk" = 1
ORDER BY t."month"
LIMIT 20;
```
