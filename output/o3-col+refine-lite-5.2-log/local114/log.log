```sql
--Description: 1) See the list of regions we have
SELECT DISTINCT "id", "name"
FROM "web_region"
LIMIT 20;
```

```sql
--Description: 2) Look at a few sales reps together with the region they belong to
SELECT DISTINCT sr."id"      AS sales_rep_id,
                sr."name"    AS sales_rep_name,
                r."name"     AS region_name
FROM   "web_sales_reps" AS sr
JOIN   "web_region"     AS r  ON sr."region_id" = r."id"
LIMIT 20;
```

```sql
--Description: 3) Inspect some customer accounts and the sales rep that owns them
SELECT DISTINCT a."id"         AS account_id,
                a."name"       AS account_name,
                sr."name"      AS sales_rep_name,
                r."name"       AS region_name
FROM   "web_accounts"   AS a
JOIN   "web_sales_reps" AS sr ON a."sales_rep_id" = sr."id"
JOIN   "web_region"     AS r  ON sr."region_id"  = r."id"
LIMIT 20;
```

```sql
--Description: 4) Peek at a few web orders with their USD amount
SELECT DISTINCT "id"        AS order_id,
                "account_id",
                "occurred_at",
                "total_amt_usd"
FROM   "web_orders"
LIMIT 20;
```

```sql
--Description: 5) Total number of orders and sales in USD for every region
SELECT r."name"              AS region_name,
       COUNT(o."id")         AS num_orders,
       SUM(o."total_amt_usd") AS total_sales_usd
FROM   "web_orders"     AS o
JOIN   "web_accounts"   AS a  ON o."account_id"  = a."id"
JOIN   "web_sales_reps" AS sr ON a."sales_rep_id" = sr."id"
JOIN   "web_region"     AS r  ON sr."region_id"   = r."id"
GROUP  BY r."name"
LIMIT 20;
```

```sql
--Description: 6) Sales (USD) generated by every sales rep broken down by region
SELECT r."name"                     AS region_name,
       sr."name"                    AS sales_rep_name,
       SUM(o."total_amt_usd")       AS rep_total_sales_usd
FROM   "web_sales_reps" AS sr
JOIN   "web_region"     AS r  ON sr."region_id" = r."id"
JOIN   "web_accounts"   AS a  ON a."sales_rep_id" = sr."id"
JOIN   "web_orders"     AS o  ON o."account_id"   = a."id"
GROUP  BY r."name", sr."name"
LIMIT 20;
```

```sql
--Description: 7) For every region, find the maximum sales amount achieved by any rep
SELECT region_name,
       MAX(rep_total_sales_usd) AS max_rep_sales_usd
FROM (
      SELECT r."name" AS region_name,
             sr."name" AS sales_rep_name,
             SUM(o."total_amt_usd") AS rep_total_sales_usd
      FROM   "web_sales_reps" AS sr
      JOIN   "web_region"     AS r  ON sr."region_id" = r."id"
      JOIN   "web_accounts"   AS a  ON a."sales_rep_id" = sr."id"
      JOIN   "web_orders"     AS o  ON o."account_id"   = a."id"
      GROUP  BY r."name", sr."name"
)
GROUP BY region_name
LIMIT 20;
```

```sql
--Description: 8) List the reps who meet or tie that maximum in each region
SELECT x.region_name,
       x.sales_rep_name,
       x.rep_total_sales_usd
FROM (
      SELECT r."name" AS region_name,
             sr."name" AS sales_rep_name,
             SUM(o."total_amt_usd") AS rep_total_sales_usd
      FROM   "web_sales_reps" AS sr
      JOIN   "web_region"     AS r  ON sr."region_id" = r."id"
      JOIN   "web_accounts"   AS a  ON a."sales_rep_id" = sr."id"
      JOIN   "web_orders"     AS o  ON o."account_id"   = a."id"
      GROUP  BY r."name", sr."name"
) AS x
JOIN (
      SELECT region_name,
             MAX(rep_total_sales_usd) AS max_rep_sales_usd
      FROM (
            SELECT r."name" AS region_name,
                   sr."name" AS sales_rep_name,
                   SUM(o."total_amt_usd") AS rep_total_sales_usd
            FROM   "web_sales_reps" AS sr
            JOIN   "web_region"     AS r  ON sr."region_id" = r."id"
            JOIN   "web_accounts"   AS a  ON a."sales_rep_id" = sr."id"
            JOIN   "web_orders"     AS o  ON o."account_id"   = a."id"
            GROUP  BY r."name", sr."name"
      )
      GROUP BY region_name
) AS y
  ON x.region_name = y.region_name
 AND x.rep_total_sales_usd = y.max_rep_sales_usd
LIMIT 20;
```

```sql
--Description: 9) Region‑level aggregates (orders & sales) to be reused later
SELECT r."id"                  AS region_id,
       r."name"                AS region_name,
       COUNT(o."id")           AS num_orders,
       SUM(o."total_amt_usd")  AS region_total_sales_usd
FROM   "web_region"     AS r
JOIN   "web_sales_reps" AS sr ON sr."region_id" = r."id"
JOIN   "web_accounts"   AS a  ON a."sales_rep_id" = sr."id"
JOIN   "web_orders"     AS o  ON o."account_id"   = a."id"
GROUP  BY r."id", r."name"
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – complete web‑sales report per region with
--                number of orders, total region sales, and *all* top reps (ties kept)
SELECT rg.region_name,
       rg.num_orders,
       rg.region_total_sales_usd,
       tr.sales_rep_name      AS top_sales_rep_name,
       tr.rep_total_sales_usd AS top_sales_rep_sales_usd
FROM (
      -- region‑level totals
      SELECT r."id"   AS region_id,
             r."name" AS region_name,
             COUNT(o."id")          AS num_orders,
             SUM(o."total_amt_usd") AS region_total_sales_usd
      FROM   "web_region"     AS r
      JOIN   "web_sales_reps" AS sr ON sr."region_id" = r."id"
      JOIN   "web_accounts"   AS a  ON a."sales_rep_id" = sr."id"
      JOIN   "web_orders"     AS o  ON o."account_id"   = a."id"
      GROUP  BY r."id", r."name"
) AS rg
JOIN (
      /* reps that hit the max sales inside their region */
      SELECT *
      FROM (
            SELECT r."id"     AS region_id,
                   r."name"   AS region_name,
                   sr."name"  AS sales_rep_name,
                   SUM(o."total_amt_usd") AS rep_total_sales_usd
            FROM   "web_sales_reps" AS sr
            JOIN   "web_region"     AS r  ON sr."region_id" = r."id"
            JOIN   "web_accounts"   AS a  ON a."sales_rep_id" = sr."id"
            JOIN   "web_orders"     AS o  ON o."account_id"   = a."id"
            GROUP  BY r."id", r."name", sr."name"
      ) AS rep
      JOIN (
            SELECT region_id,
                   MAX(rep_total_sales_usd) AS max_rep_sales_usd
            FROM (
                  SELECT r."id" AS region_id,
                         SUM(o."total_amt_usd") AS rep_total_sales_usd
                  FROM   "web_sales_reps" AS sr
                  JOIN   "web_region"     AS r  ON sr."region_id" = r."id"
                  JOIN   "web_accounts"   AS a  ON a."sales_rep_id" = sr."id"
                  JOIN   "web_orders"     AS o  ON o."account_id"   = a."id"
                  GROUP  BY r."id", sr."id"
            )
            GROUP BY region_id
      ) AS mx
        ON rep.region_id = mx.region_id
       AND rep.rep_total_sales_usd = mx.max_rep_sales_usd
) AS tr
  ON rg.region_id = tr.region_id
ORDER BY rg.region_name, tr.sales_rep_name;
```
