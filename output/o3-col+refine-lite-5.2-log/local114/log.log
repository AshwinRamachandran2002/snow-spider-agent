Query:
--Description: 7) For every region, find the maximum sales amount achieved by any rep
SELECT region_name,
       MAX(rep_total_sales_usd) AS max_rep_sales_usd
FROM (
      SELECT r."name" AS region_name,
             sr."name" AS sales_rep_name,
             SUM(o."total_amt_usd") AS rep_total_sales_usd
      FROM   "web_sales_reps" AS sr
      JOIN   "web_region"     AS r  ON sr."region_id" = r."id"
      JOIN   "web_accounts"   AS a  ON a."sales_rep_id" = sr."id"
      JOIN   "web_orders"     AS o  ON o."account_id"   = a."id"
      GROUP  BY r."name", sr."name"
)
GROUP BY region_name
LIMIT 20;
