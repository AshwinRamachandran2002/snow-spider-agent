Query:
--Description: 10) FINAL ANSWER – complete web‑sales report per region with
--                number of orders, total region sales, and *all* top reps (ties kept)
SELECT rg.region_name,
       rg.num_orders,
       rg.region_total_sales_usd,
       tr.sales_rep_name      AS top_sales_rep_name,
       tr.rep_total_sales_usd AS top_sales_rep_sales_usd
FROM (
      -- region‑level totals
      SELECT r."id"   AS region_id,
             r."name" AS region_name,
             COUNT(o."id")          AS num_orders,
             SUM(o."total_amt_usd") AS region_total_sales_usd
      FROM   "web_region"     AS r
      JOIN   "web_sales_reps" AS sr ON sr."region_id" = r."id"
      JOIN   "web_accounts"   AS a  ON a."sales_rep_id" = sr."id"
      JOIN   "web_orders"     AS o  ON o."account_id"   = a."id"
      GROUP  BY r."id", r."name"
) AS rg
JOIN (
      /* reps that hit the max sales inside their region */
      SELECT *
      FROM (
            SELECT r."id"     AS region_id,
                   r."name"   AS region_name,
                   sr."name"  AS sales_rep_name,
                   SUM(o."total_amt_usd") AS rep_total_sales_usd
            FROM   "web_sales_reps" AS sr
            JOIN   "web_region"     AS r  ON sr."region_id" = r."id"
            JOIN   "web_accounts"   AS a  ON a."sales_rep_id" = sr."id"
            JOIN   "web_orders"     AS o  ON o."account_id"   = a."id"
            GROUP  BY r."id", r."name", sr."name"
      ) AS rep
      JOIN (
            SELECT region_id,
                   MAX(rep_total_sales_usd) AS max_rep_sales_usd
            FROM (
                  SELECT r."id" AS region_id,
                         SUM(o."total_amt_usd") AS rep_total_sales_usd
                  FROM   "web_sales_reps" AS sr
                  JOIN   "web_region"     AS r  ON sr."region_id" = r."id"
                  JOIN   "web_accounts"   AS a  ON a."sales_rep_id" = sr."id"
                  JOIN   "web_orders"     AS o  ON o."account_id"   = a."id"
                  GROUP  BY r."id", sr."id"
            )
            GROUP BY region_id
      ) AS mx
        ON rep.region_id = mx.region_id
       AND rep.rep_total_sales_usd = mx.max_rep_sales_usd
) AS tr
  ON rg.region_id = tr.region_id
ORDER BY rg.region_name, tr.sales_rep_name;
