```sql
--Description: Pull the raw monthly counts for the year 2023 (all 12 months).
SELECT  
  EXTRACT(MONTH FROM TO_TIMESTAMP_LTZ("block_timestamp" / 1000000))  AS "month",
  COUNT(*)                                                          AS "monthly_txn_cnt"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS"
WHERE EXTRACT(YEAR FROM TO_TIMESTAMP_LTZ("block_timestamp" / 1000000)) = 2023
GROUP BY "month"
ORDER BY "monthly_txn_cnt" DESC
LIMIT 20;
```

```sql
--Description: Show the exact number of seconds in each month of 2023 (non‑leap) for later TPS division.
SELECT  
  seq4() + 1                                                         AS "month",
  CASE 
      WHEN seq4() + 1 IN (1,3,5,7,8,10,12) THEN 31*24*60*60   -- 31‑day months
      WHEN seq4() + 1 = 2                      THEN 28*24*60*60   -- Feb 2023 (non‑leap)
      ELSE 30*24*60*60                             -- remaining 30‑day months
  END                                                                AS "sec_in_month"
FROM TABLE(GENERATOR(ROWCOUNT => 12))
LIMIT 20;
```

```sql
--Description: Combine monthly counts with seconds‑per‑month to compute transactions‑per‑second for each month in 2023.
WITH monthly_cnt AS (  
  SELECT  
    EXTRACT(MONTH FROM TO_TIMESTAMP_LTZ("block_timestamp" / 1000000))  AS "month",
    COUNT(*)                                                          AS "monthly_txn_cnt"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS"
  WHERE EXTRACT(YEAR FROM TO_TIMESTAMP_LTZ("block_timestamp" / 1000000)) = 2023
  GROUP BY "month"
),
sec_lookup AS (
  SELECT  
    seq4() + 1                                                         AS "month",
    CASE 
        WHEN seq4() + 1 IN (1,3,5,7,8,10,12) THEN 31*24*60*60
        WHEN seq4() + 1 = 2                      THEN 28*24*60*60
        ELSE 30*24*60*60
    END                                                                AS "sec_in_month"
  FROM TABLE(GENERATOR(ROWCOUNT => 12))
)
SELECT  
  2023                                            AS "year",
  m."month",
  m."monthly_txn_cnt",
  ROUND(m."monthly_txn_cnt" / s."sec_in_month", 4) AS "txn_per_sec"
FROM monthly_cnt m
JOIN sec_lookup s ON m."month" = s."month"
ORDER BY m."monthly_txn_cnt" DESC
LIMIT 20;
```

