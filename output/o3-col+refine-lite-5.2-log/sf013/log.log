```sql
--Description: Side‑by‑side comparison of total lengths for both QUADKEY segments
SELECT
  COALESCE(a."CLASS", r."CLASS")        AS "CLASS",
  COALESCE(a."SUBCLASS", r."SUBCLASS")  AS "SUBCLASS",
  a."AMSTERDAM_LENGTH_M",
  r."ROTTERDAM_LENGTH_M"
FROM (
  SELECT "CLASS", "SUBCLASS", SUM(TRY_TO_DOUBLE("LENGTH_M")) AS "AMSTERDAM_LENGTH_M"
  FROM NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_ROAD
  WHERE "QUADKEY" LIKE '12020210%'
  GROUP BY "CLASS", "SUBCLASS"
) a
FULL OUTER JOIN (
  SELECT "CLASS", "SUBCLASS", SUM(TRY_TO_DOUBLE("LENGTH_M")) AS "ROTTERDAM_LENGTH_M"
  FROM NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_ROAD
  WHERE "QUADKEY" LIKE '12020211%'
  GROUP BY "CLASS", "SUBCLASS"
) r
ON a."CLASS" = r."CLASS" AND a."SUBCLASS" = r."SUBCLASS"
LIMIT 20;
```

```sql
--Description: Aggregate total length by class only (Amst. vs Rott.) for quick overview
SELECT
  "CLASS",
  SUM(TRY_TO_DOUBLE(CASE WHEN "QUADKEY" LIKE '12020210%' THEN "LENGTH_M" END)) AS "AMSTERDAM_LEN_M",
  SUM(TRY_TO_DOUBLE(CASE WHEN "QUADKEY" LIKE '12020211%' THEN "LENGTH_M" END)) AS "ROTTERDAM_LEN_M"
FROM NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_ROAD
WHERE "QUADKEY" LIKE '12020210%' OR "QUADKEY" LIKE '12020211%'
GROUP BY "CLASS"
LIMIT 20;
```

```sql
--Description: Inspect administrative objects whose names hint at Amsterdam or Rotterdam
SELECT 
  "ID",
  "ADMIN_LEVEL",
  "NAMES"
FROM NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_ADMINISTRATIVE
WHERE "NAMES" ILIKE '%amsterdam%' OR "NAMES" ILIKE '%rotterdam%'
LIMIT 20;
```

```sql
--Description: Quick check of road counts in each QUADKEY segment to gauge coverage
SELECT 
  LEFT("QUADKEY", 8) AS "QUADKEY_PREFIX",
  COUNT(*)           AS "ROAD_SEGMENT_COUNT"
FROM NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_ROAD
WHERE "QUADKEY" IN ('12020210', '12020211')
   OR "QUADKEY" LIKE '12020210%' 
   OR "QUADKEY" LIKE '12020211%'
GROUP BY LEFT("QUADKEY", 8)
LIMIT 20;
```
