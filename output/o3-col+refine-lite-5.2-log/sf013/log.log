```sql
--Description: Aggregate total length (meters) of each class/sub‑class for QUADKEY '12020211'
SELECT 
  "CLASS",
  "SUBCLASS",
  SUM(TRY_TO_DOUBLE("LENGTH_M")) AS "ROTTERDAM_LENGTH_M"
