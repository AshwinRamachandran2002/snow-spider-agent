Below are 10 exploratory‑to‑final BigQuery SQL snippets that progressively build the requested analysis for “common” (AF ≥ 0.05) autosomal variants, ending in a distribution of how many variants are shared by a specific number of samples within each super‑population.  
Every query shows at most 20 rows.

```sql
-- 1. Preview a few autosomal variants and their overall allele frequency
SELECT reference_name, start, AF
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name NOT IN ('X','Y','MT')
LIMIT 20;
```

```sql
-- 2. Autosomal variants whose overall allele frequency is ≥ 0.05
SELECT reference_name, start, AF
FROM `spider2-public-data.1000_genomes.variants`
WHERE reference_name NOT IN ('X','Y','MT')
  AND AF >= 0.05
LIMIT 20;
```

```sql
-- 3. Look inside the “call” ARRAY to list sample names & genotypes
SELECT reference_name, start, c.call_set_name AS sample, c.genotype
FROM `spider2-public-data.1000_genomes.variants`, UNNEST(call) AS c
WHERE reference_name = '1'
LIMIT 20;
```

```sql
-- 4. Only samples that actually carry ≥1 alternate allele (non‑reference)
SELECT reference_name, start, c.call_set_name AS sample
FROM `spider2-public-data.1000_genomes.variants`, UNNEST(call) AS c
WHERE reference_name = '1'
  AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g != 0)
LIMIT 20;
```

```sql
-- 5. Join carriers to their super‑population
SELECT c.call_set_name AS sample, si.Super_Population
FROM `spider2-public-data.1000_genomes.variants`, UNNEST(call) AS c
JOIN `spider2-public-data.1000_genomes.sample_info`  si
  ON si.Sample = c.call_set_name
WHERE reference_name = '1'
  AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g != 0)
LIMIT 20;
```

```sql
-- 6. For AFR only: carriers per (autosomal, common) variant
SELECT reference_name, start,
       COUNT(DISTINCT c.call_set_name) AS afr_carriers
FROM `spider2-public-data.1000_genomes.variants`, UNNEST(call) AS c
JOIN `spider2-public-data.1000_genomes.sample_info` si
  ON si.Sample = c.call_set_name
WHERE reference_name NOT IN ('X','Y','MT')
  AND AF >= 0.05
  AND si.Super_Population = 'AFR'
  AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g != 0)
GROUP BY reference_name, start
LIMIT 20;
```

```sql
-- 7. Distribution: how many AFR variants are shared by exactly N samples
SELECT afr_carriers AS num_samples, COUNT(*) AS variant_count
FROM (
  SELECT reference_name, start,
         COUNT(DISTINCT c.call_set_name) AS afr_carriers
  FROM `spider2-public-data.1000_genomes.variants`, UNNEST(call) AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` si
    ON si.Sample = c.call_set_name
  WHERE reference_name NOT IN ('X','Y','MT')
    AND AF >= 0.05
    AND si.Super_Population = 'AFR'
    AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g != 0)
  GROUP BY reference_name, start
)
GROUP BY num_samples
ORDER BY num_samples
LIMIT 20;
```

```sql
-- 8. Population size for every super‑population
SELECT Super_Population, COUNT(*) AS pop_size
FROM `spider2-public-data.1000_genomes.sample_info`
GROUP BY Super_Population
ORDER BY Super_Population
LIMIT 20;
```

```sql
-- 9. Variant‑by‑variant carrier count inside each super‑population
SELECT v.reference_name, v.start, sp.Super_Population,
       COUNT(DISTINCT c.call_set_name) AS carriers_per_variant
FROM `spider2-public-data.1000_genomes.variants` v, UNNEST(v.call) AS c
JOIN `spider2-public-data.1000_genomes.sample_info` sp
  ON sp.Sample = c.call_set_name
WHERE v.reference_name NOT IN ('X','Y','MT')
  AND v.AF >= 0.05
  AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g WHERE g != 0)
GROUP BY v.reference_name, v.start, sp.Super_Population
LIMIT 20;
```

```sql
-- 10. FINAL:  For each super‑population, report
--      * total population size
--      * number of samples carrying the variant (num_samples)
--      * how many variants are shared by exactly that many samples
SELECT dist.Super_Population,
       pop.pop_size,
       dist.num_samples,
       dist.variant_count
FROM (
  SELECT sp.Super_Population,
         carriers_per_variant AS num_samples,
         COUNT(*)             AS variant_count
  FROM (
    SELECT v.reference_name, v.start, sp.Super_Population,
           COUNT(DISTINCT c.call_set_name) AS carriers_per_variant
    FROM `spider2-public-data.1000_genomes.variants` v, UNNEST(v.call) AS c
    JOIN `spider2-public-data.1000_genomes.sample_info` sp
      ON sp.Sample = c.call_set_name
    WHERE v.reference_name NOT IN ('X','Y','MT')      -- autosomes only
      AND v.AF >= 0.05                                -- common variants
      AND EXISTS (SELECT 1 FROM UNNEST(c.genotype) g  -- alt‑allele carriers
                  WHERE g != 0)
    GROUP BY v.reference_name, v.start, sp.Super_Population
  )
  GROUP BY sp.Super_Population, num_samples
)  dist
JOIN (
  SELECT Super_Population, COUNT(*) AS pop_size
  FROM `spider2-public-data.1000_genomes.sample_info`
  GROUP BY Super_Population
) pop
ON dist.Super_Population = pop.Super_Population
ORDER BY dist.Super_Population, num_samples
LIMIT 20;
```

These queries move from simple inspection to a complete summary answering:  
“Within each super‑population, how many common autosomal variants are shared by exactly N samples, along with the population’s overall sample size.”
