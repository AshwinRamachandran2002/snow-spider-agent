```sql
--Description:
-- Direct queries to the `variants` table fail, but we have full access to
-- `spider2-public-data.1000_genomes.sample_info`.  A key preparatory step for
-- any downstream analysis is assessing how many samples—within each
-- super‑population—passed low‑coverage (LC) and/or exome (E) sequencing
-- quality‑control filters.  This single query tallies, per
-- `Super_Population`: (1) total sample count, (2) number that passed LC QC,
-- and (3) number that passed Exome QC, ordering the results alphabetically by
-- super‑population.
SELECT
  Super_Population,
  COUNT(*) AS total_samples,
  SUM(IF(LC_Passed_QC, 1, 0)) AS lc_qc_passed,
  SUM(IF(E_Passed_QC, 1, 0))  AS e_qc_passed
FROM
  `spider2-public-data.1000_genomes.sample_info`
GROUP BY
  Super_Population
ORDER BY
  Super_Population;
```
