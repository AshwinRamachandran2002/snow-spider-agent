```sql
--Description:
-- We cannot read the private spider2 copy (403) and the US‑region public tables
-- do not hold the 1000 Genomes Phase‑3 variants.  The dataset is publicly
-- available in the EU multi‑region project
-- `bigquery-public-data.human_genome_variants`, so we must add the `region-eu`
-- prefix to avoid the “not found in location US” error.  The query below
-- previews 20 common (allele_frequency ≥ 0.05) autosomal variants, i.e.,
-- variants on chromosomes other than X, Y, or MT.  It returns the chromosome
-- (`reference_name`), genomic start position (`start_position`), and overall
-- allele frequency (`allele_frequency`).
SELECT
  reference_name,
  start_position AS start,
  allele_frequency AS AF
FROM
  `region-eu.bigquery-public-data.human_genome_variants.1000_genomes_variants`
WHERE
  reference_name NOT IN ('X','Y','MT')
  AND allele_frequency >= 0.05
LIMIT
  20;
```
