Query:
--Description:  Full, syntactically‑complete version of the query that was previously truncated.  
--              It finds, for every match, the partnership that scored the highest total runs  
--              (bat‑runs + extras) and then orders the two players as player1 / player2 based on  
--              their individual bat‑runs (tie‑breaker = higher player_id).  
--              Output columns: match_id, player1_id, player1_runs, player2_id, player2_runs, partnership_runs.  
WITH ball AS (                               -- every delivery with bat + extra runs
    SELECT b.match_id,
           b.striker,
           b.non_striker,
           COALESCE(s.runs_scored,0) AS bat_runs,
           COALESCE(e.extra_runs,0)  AS ext_runs
    FROM   ball_by_ball AS b
    LEFT  JOIN batsman_scored AS s USING (match_id,over_id,ball_id)
    LEFT  JOIN extra_runs    AS e USING (match_id,over_id,ball_id)
),
tagged AS (                                  -- tag each row with unordered partner IDs
    SELECT *,
           CASE WHEN striker > non_striker THEN striker ELSE non_striker END AS p_high,
           CASE WHEN striker > non_striker THEN non_striker ELSE striker END AS p_low
    FROM   ball
),
partner_totals AS (                          -- totals & individual bat‑runs per partnership
    SELECT match_id,
           p_high,
           p_low,
           SUM(bat_runs + ext_runs)                             AS partnership_runs,
           SUM(CASE WHEN striker = p_high THEN bat_runs ELSE 0 END) AS runs_high,
           SUM(CASE WHEN striker = p_low  THEN bat_runs ELSE 0 END) AS runs_low
    FROM   tagged
    GROUP  BY match_id, p_high, p_low
),
max_partners AS (                            -- retain only partnerships reaching the match maximum
    SELECT pt.*,
           MAX(pt.partnership_runs) OVER (PARTITION BY pt.match_id) AS max_in_match
    FROM   partner_totals AS pt
    WHERE  pt.partnership_runs > 0          -- ignore 0‑run pairs
),
final AS (                                   -- apply player ordering rule
    SELECT match_id,
           CASE WHEN runs_high > runs_low THEN p_high
                WHEN runs_high < runs_low THEN p_low
                ELSE p_high                       -- equal runs → higher ID first
           END AS player1_id,
           CASE WHEN runs_high > runs_low THEN runs_high
                WHEN runs_high < runs_low THEN runs_low
                ELSE runs_high
           END AS player1_runs,
           CASE WHEN runs_high > runs_low THEN p_low
                WHEN runs_high < runs_low THEN p_high
                ELSE p_low
           END AS player2_id,
           CASE WHEN runs_high > runs_low THEN runs_low
                WHEN runs_high < runs_low THEN runs_high
                ELSE runs_low
           END AS player2_runs,
           partnership_runs
    FROM   max_partners
    WHERE  partnership_runs = max_in_match
)
SELECT *
FROM   final
ORDER  BY match_id
LIMIT 20
