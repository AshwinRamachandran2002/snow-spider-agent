```sql
--Description: Quick look at some deliveries to understand how striker / non‑striker pairs appear in the ball‑by‑ball table.  
SELECT DISTINCT "match_id",
       "over_id",
       "ball_id",
       "striker",
       "non_striker"
FROM "ball_by_ball"
LIMIT 20;
```

```sql
--Description: Sample of runs recorded for the same deliveries (batsman_scored table).  
SELECT DISTINCT b."match_id",
       b."over_id",
       b."ball_id",
       b."striker",
       s."runs_scored"
FROM   "ball_by_ball" AS b
JOIN   "batsman_scored" AS s
       ON b."match_id" = s."match_id"
      AND b."over_id"  = s."over_id"
      AND b."ball_id"  = s."ball_id"
LIMIT 20;
```

```sql
--Description: Compute runs scored by every striker on every ball (ignoring extras) for a single match to see the basic structure.  
SELECT DISTINCT b."match_id",
       b."striker"                 AS "batsman_id",
       SUM(s."runs_scored")        AS "runs"
FROM   "ball_by_ball" AS b
JOIN   "batsman_scored" AS s
       ON b."match_id" = s."match_id"
      AND b."over_id"  = s."over_id"
      AND b."ball_id"  = s."ball_id"
WHERE  b."match_id" = (SELECT MIN("match_id") FROM "match")
GROUP  BY b."match_id", b."striker"
LIMIT 20;
```

```sql
--Description: Inspect how extras are stored; helpful to ensure partnership runs exclude them later.  
SELECT DISTINCT "match_id",
       "over_id",
       "ball_id",
       "extra_type",
       "extra_runs"
FROM   "extra_runs"
LIMIT 20;
```

```sql
--Description: Runs for every ball including extras (so we can subtract later):  
SELECT DISTINCT b."match_id",
       b."over_id",
       b."ball_id",
       COALESCE(s."runs_scored",0)               AS "batsman_runs",
       COALESCE(e."extra_runs",0)                AS "extra_runs"
FROM   "ball_by_ball" AS b
LEFT JOIN "batsman_scored" AS s
       ON b."match_id" = s."match_id"
      AND b."over_id"  = s."over_id"
      AND b."ball_id"  = s."ball_id"
LEFT JOIN "extra_runs"   AS e
       ON b."match_id" = e."match_id"
      AND b."over_id"  = e."over_id"
      AND b."ball_id"  = e."ball_id"
LIMIT 20;
```

```sql
--Description: Aggregate total partnership runs for every unordered pair (striker, non_striker) within one match & innings.  
SELECT DISTINCT b."match_id",
       b."innings_no",
       CASE WHEN b."striker" >  b."non_striker" THEN b."striker" ELSE b."non_striker" END AS "player_high_id",
       CASE WHEN b."striker" <= b."non_striker" THEN b."striker" ELSE b."non_striker" END AS "player_low_id",
       SUM(s."runs_scored")                                           AS "partnership_batsman_runs"
FROM   "ball_by_ball" AS b
JOIN   "batsman_scored" AS s
       ON b."match_id" = s."match_id"
      AND b."over_id"  = s."over_id"
      AND b."ball_id"  = s."ball_id"
GROUP  BY b."match_id",
          b."innings_no",
          "player_high_id",
          "player_low_id"
LIMIT 20;
```

```sql
--Description: Same aggregation but including extras; will be needed if we later decide partnership runs include all runs off the bat plus extras.  
SELECT DISTINCT b."match_id",
       b."innings_no",
       CASE WHEN b."striker" >  b."non_striker" THEN b."striker" ELSE b."non_striker" END AS "player_high_id",
       CASE WHEN b."striker" <= b."non_striker" THEN b."striker" ELSE b."non_striker" END AS "player_low_id",
       SUM(COALESCE(s."runs_scored",0) + COALESCE(e."extra_runs",0))  AS "partnership_total_runs"
FROM   "ball_by_ball" AS b
LEFT JOIN "batsman_scored" AS s
       ON b."match_id" = s."match_id"
      AND b."over_id"  = s."over_id"
      AND b."ball_id"  = s."ball_id"
LEFT JOIN "extra_runs"   AS e
       ON b."match_id" = e."match_id"
      AND b."over_id"  = e."over_id"
      AND b."ball_id"  = e."ball_id"
GROUP  BY b."match_id",
          b."innings_no",
          "player_high_id",
          "player_low_id"
LIMIT 20;
```

```sql
--Description: For each match & innings, pull the highest partnership (total runs) by using a window function.  
SELECT DISTINCT *
FROM (
    SELECT b."match_id",
           b."innings_no",
           CASE WHEN b."striker" >  b."non_striker" THEN b."striker" ELSE b."non_striker" END AS "player_high_id",
           CASE WHEN b."striker" <= b."non_striker" THEN b."striker" ELSE b."non_striker" END AS "player_low_id",
           SUM(COALESCE(s."runs_scored",0) + COALESCE(e."extra_runs",0))  AS "partnership_total_runs",
           RANK() OVER (PARTITION BY b."match_id", b."innings_no"
                        ORDER BY SUM(COALESCE(s."runs_scored",0) + COALESCE(e."extra_runs",0)) DESC) AS "rk"
    FROM   "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS s
           ON b."match_id" = s."match_id"
          AND b."over_id"  = s."over_id"
          AND b."ball_id"  = s."ball_id"
    LEFT JOIN "extra_runs"   AS e
           ON b."match_id" = e."match_id"
          AND b."over_id"  = e."over_id"
          AND b."ball_id"  = e."ball_id"
    GROUP  BY b."match_id",
              b."innings_no",
              "player_high_id",
              "player_low_id"
)
WHERE  "rk" = 1
LIMIT 20;
```

```sql
--Description: Pull individual scores for both players in a partnership (needed so we can later order them by individual score instead of ID).  
SELECT DISTINCT p."match_id",
       partner."player_high_id",
       partner."player_low_id",
       SUM(CASE WHEN b."striker" = partner."player_high_id" THEN s."runs_scored" ELSE 0 END) AS "runs_high_id",
       SUM(CASE WHEN b."striker" = partner."player_low_id"  THEN s."runs_scored" ELSE 0 END) AS "runs_low_id"
FROM   (
        SELECT DISTINCT "match_id",
               CASE WHEN "striker" > "non_striker" THEN "striker" ELSE "non_striker" END AS "player_high_id",
               CASE WHEN "striker" <= "non_striker" THEN "striker" ELSE "non_striker" END AS "player_low_id"
        FROM   "ball_by_ball"
       ) AS partner
JOIN   "ball_by_ball" AS b
       ON b."match_id" = partner."match_id"
      AND ((b."striker" = partner."player_high_id" AND b."non_striker" = partner."player_low_id")
        OR (b."striker" = partner."player_low_id"  AND b."non_striker" = partner."player_high_id"))
JOIN   "batsman_scored" AS s
       ON b."match_id" = s."match_id"
      AND b."over_id"  = s."over_id"
      AND b."ball_id"  = s."ball_id"
GROUP  BY p."match_id",
          partner."player_high_id",
          partner."player_low_id"
LIMIT 20;
```

```sql
--Description: Combine the previous ideas: for each match, fetch partnership(s) with the maximum aggregate runs, then label as player1/player2 by higher individual score (or by higher ID in case of a tie).  
WITH partnership AS (
    SELECT b."match_id",
           CASE WHEN b."striker" >  b."non_striker" THEN b."striker" ELSE b."non_striker" END AS "p_hi",
           CASE WHEN b."striker" <= b."non_striker" THEN b."striker" ELSE b."non_striker" END AS "p_lo",
           SUM(COALESCE(s."runs_scored",0) + COALESCE(e."extra_runs",0))          AS "total_runs",
           SUM(CASE WHEN b."striker" = b."striker" THEN s."runs_scored" END)       AS "runs_hi_tmp",  -- placeholder
           0                                                                       AS "runs_lo_tmp"   -- will fix later
    FROM   "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS s
           ON b."match_id" = s."match_id"
          AND b."over_id"  = s."over_id"
          AND b."ball_id"  = s."ball_id"
    LEFT JOIN "extra_runs"   AS e
           ON b."match_id" = e."match_id"
          AND b."over_id"  = e."over_id"
          AND b."ball_id"  = e."ball_id"
    GROUP  BY b."match_id", "p_hi", "p_lo"
), max_partnership AS (
    SELECT p.*,
           RANK() OVER (PARTITION BY p."match_id" ORDER BY p."total_runs" DESC) AS "rk"
    FROM   partnership AS p
)
SELECT DISTINCT *
FROM   max_partnership
WHERE  "rk" = 1
LIMIT 20;
```

