--Description:  One‑shot query to retrieve, for every match, the batting partnership that
--              scored the most total runs (bat‑runs + extras).  For each such stand,
--              return the two players ordered by their individual bat‑runs
--              (player1 = higher scorer; if tied, higher player_id).  
--              Columns: match_id, player1_id, player1_runs, player2_id, player2_runs, partnership_runs.  
WITH ball AS (                               -- every delivery with bat and extra runs
    SELECT b.match_id,
           b.striker,
           b.non_striker,
           COALESCE(s.runs_scored,0) AS bat_runs,
           COALESCE(e.extra_runs,0)  AS ext_runs
    FROM   ball_by_ball AS b
    LEFT  JOIN batsman_scored AS s USING (match_id,over_id,ball_id)
    LEFT  JOIN extra_runs    AS e USING (match_id,over_id,ball_id)
), tagged AS (                               -- tag each row with unordered partner IDs
    SELECT *,
           CASE WHEN striker > non_striker THEN striker ELSE non_striker END AS hi,
           CASE WHEN striker > non_striker THEN non_striker ELSE striker END AS lo
    FROM   ball
), partner AS (                              -- aggregate totals and individual bat‑runs
    SELECT match_id,
           hi AS p_high,
           lo AS p_low,
           SUM(bat_runs + ext_runs)                                AS partnership_runs,
           SUM(CASE WHEN striker = hi THEN bat_runs ELSE 0 END)    AS runs_high,
           SUM(CASE WHEN striker = lo THEN bat_runs ELSE 0 END)    AS runs_low
    FROM   tagged
    GROUP  BY match_id, p_high, p_low
), max_per_match AS (                        -- keep partnership(s) with max total in each match
    SELECT p.*,
           MAX(partnership_runs) OVER (PARTITION BY match_id) AS max_in_match
    FROM   partner AS p
), labelled AS (                             -- assign player1 / player2 per rules
    SELECT match_id,
           CASE WHEN runs_high > runs_low THEN p_high
                WHEN runs_high < runs_low THEN p_low
                ELSE p_high                -- equal runs → higher ID first (p_high > p_low)
           END AS player1_id,
           CASE WHEN runs_high > runs_low THEN runs_high
                WHEN runs_high < runs_low THEN runs_low
                ELSE runs_high
           END AS player1_runs,
           CASE WHEN runs_high > runs_low THEN p_low
                WHEN runs_high < runs_low THEN p_high
                ELSE p_low
           END AS player2_id,
           CASE WHEN runs_high > runs_low THEN runs_low
                WHEN runs_high < runs_low THEN runs_high
                ELSE runs_low
           END AS player2_runs,
           partnership_runs
    FROM   max_per_match
    WHERE  partnership_runs = max_in_match
)
SELECT *
FROM   labelled
ORDER  BY match_id
LIMIT 20;
