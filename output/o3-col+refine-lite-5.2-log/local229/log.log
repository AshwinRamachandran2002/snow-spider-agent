```sql
--Description:  For every match, find the partnership(s) that produced the highest total runs  
--              (batsman runs + extras).  Then, within each of those partnerships, label the two
--              players as player1 / player2:  
--                 • player1 = the partner who scored more off the bat;  
--                 • if both scored the same, the higher player_id becomes player1.  
--              Output: match_id, player1_id, player1_runs, player2_id, player2_runs, partnership_runs.  
WITH ball AS (                             -- all deliveries with runs
    SELECT b.match_id,
           b.striker,
           b.non_striker,
           COALESCE(s.runs_scored,0) AS bat_runs,
           COALESCE(e.extra_runs,0)  AS ext_runs
    FROM   ball_by_ball  AS b
    LEFT  JOIN batsman_scored AS s USING (match_id,over_id,ball_id)
    LEFT  JOIN extra_runs    AS e USING (match_id,over_id,ball_id)
), partner_pairs AS (                      -- every unordered batting pair per match
    SELECT DISTINCT match_id,
           CASE WHEN striker > non_striker THEN striker ELSE non_striker END AS p_high,
           CASE WHEN striker > non_striker THEN non_striker ELSE striker END AS p_low
    FROM   ball
), partner_totals AS (                     -- partnership totals + individual scores
    SELECT p.match_id,
           p.p_high,
           p.p_low,
           SUM(b.bat_runs + b.ext_runs)                                    AS partnership_runs,
           SUM(CASE WHEN b.striker = p.p_high THEN b.bat_runs ELSE 0 END)  AS runs_high,
           SUM(CASE WHEN b.striker = p.p_low  THEN b.bat_runs ELSE 0 END)  AS runs_low
    FROM   partner_pairs AS p
    JOIN   ball          AS b
           ON b.match_id = p.match_id
          AND ( (b.striker     = p.p_high AND b.non_striker = p.p_low)
             OR (b.striker     = p.p_low  AND b.non_striker = p.p_high) )
    GROUP  BY p.match_id, p.p_high, p.p_low
), max_partners AS (                       -- keep only max‑run partnerships per match (ties possible)
    SELECT pt.*,
           MAX(pt.partnership_runs) OVER (PARTITION BY pt.match_id) AS max_run_in_match
    FROM   partner_totals AS pt
), final AS (                              -- apply player1 / player2 ordering rule
    SELECT match_id,
           CASE 
             WHEN runs_high > runs_low THEN p_high
             WHEN runs_high < runs_low THEN p_low
             ELSE p_high             -- equal runs → higher ID (p_high) first
           END AS player1_id,
           CASE 
             WHEN runs_high > runs_low THEN runs_high
             WHEN runs_high < runs_low THEN runs_low
             ELSE runs_high
           END AS player1_runs,
           CASE 
             WHEN runs_high > runs_low THEN p_low
             WHEN runs_high < runs_low THEN p_high
             ELSE p_low
           END AS player2_id,
           CASE 
             WHEN runs_high > runs_low THEN runs_low
             WHEN runs_high < runs_low THEN runs_high
             ELSE runs_low
           END AS player2_runs,
           partnership_runs
    FROM   max_partners
    WHERE  partnership_runs = max_run_in_match
)
SELECT *
FROM   final
ORDER  BY match_id
LIMIT 20;
