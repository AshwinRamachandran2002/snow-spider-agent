```sql
--Description: Corrected version of the earlier “combine” query.  
--It finds, for every match, the partnership(s) that scored the most total runs (bat + extras),  
--computes each partner’s individual bat runs, then labels them as player1 / player2:  
--  • player1 = the one with the higher individual score;  
--  • if equal, the higher player_id is player1.  
--Output: match_id, player1_id, player1_runs, player2_id, player2_runs, partnership_runs.  
WITH ball AS (                            -- each delivery with bat‑runs & extras
    SELECT b.match_id,
           b.striker,
           b.non_striker,
           COALESCE(s.runs_scored,0) AS bat_runs,
           COALESCE(e.extra_runs,0)  AS ext_runs
    FROM   ball_by_ball  AS b
    LEFT  JOIN batsman_scored AS s USING (match_id,over_id,ball_id)
    LEFT  JOIN extra_runs    AS e USING (match_id,over_id,ball_id)
), partner_totals AS (                    -- totals & individual scores per unordered pair
    SELECT  b.match_id,
            CASE WHEN b.striker >  b.non_striker THEN b.striker ELSE b.non_striker END AS p_high,
            CASE WHEN b.striker <= b.non_striker THEN b.striker ELSE b.non_striker END AS p_low,
            SUM(b.bat_runs + b.ext_runs)                                   AS partnership_runs,
            SUM(CASE WHEN b.striker = (CASE WHEN b.striker > b.non_striker THEN b.striker ELSE b.non_striker END)
                     THEN b.bat_runs ELSE 0 END)                           AS runs_high,
            SUM(CASE WHEN b.striker = (CASE WHEN b.striker <= b.non_striker THEN b.striker ELSE b.non_striker END)
                     THEN b.bat_runs ELSE 0 END)                           AS runs_low
    FROM    ball AS b
    GROUP  BY b.match_id, p_high, p_low
), max_partners AS (                     -- keep partnership(s) with max runs in each match
    SELECT pt.*,
           MAX(pt.partnership_runs) OVER (PARTITION BY pt.match_id) AS max_in_match
    FROM   partner_totals AS pt
    WHERE  pt.partnership_runs > 0          -- safeguard; ignore 0‑run pairs
), final AS (                              -- apply player1 / player2 rule
    SELECT match_id,
           CASE WHEN runs_high > runs_low THEN p_high
                WHEN runs_high < runs_low THEN p_low
                ELSE p_high                   -- equal runs → higher ID (p_high) first
           END AS player1_id,
           CASE WHEN runs_high > runs_low THEN runs_high
                WHEN runs_high < runs_low THEN runs_low
                ELSE runs_high
           END AS player1_runs,
           CASE WHEN runs_high > runs_low THEN p_low
                WHEN runs_high < runs_low THEN p_high
                ELSE p_low
           END AS player2_id,
           CASE WHEN runs_high > runs_low THEN runs_low
                WHEN runs_high < runs_low THEN runs_high
                ELSE runs_low
           END AS player2_runs,
           partnership_runs
    FROM   max_partners
    WHERE  partnership_runs = max_in_match      -- only the highest partnership(s)
)
SELECT *
FROM   final
ORDER  BY match_id
LIMIT 20;
