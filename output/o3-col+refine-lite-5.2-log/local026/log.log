```sql
--Description: Inspect a few bowler‑ids that appear in the ball‑by‑ball log
SELECT DISTINCT b."bowler"
FROM "ball_by_ball" AS b
LIMIT 20;
```

```sql
--Description: Take a look at how many runs batsmen scored on a few balls
SELECT bs."match_id", bs."over_id", bs."ball_id", bs."runs_scored"
FROM "batsman_scored" AS bs
LIMIT 20;
```

```sql
--Description: Inspect the different types of extras recorded and their values
SELECT er."match_id", er."over_id", er."ball_id", er."extra_type", er."extra_runs"
FROM "extra_runs"  AS er
LIMIT 20;
```

```sql
--Description: Combine one ball’s information to see total runs (batsman + extras)
SELECT b."match_id",
       b."over_id",
       b."ball_id",
       COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0)  AS total_runs
FROM   "ball_by_ball"  AS b
LEFT JOIN "batsman_scored" AS bs
       ON bs."match_id" = b."match_id"
      AND bs."over_id"  = b."over_id"
      AND bs."ball_id"  = b."ball_id"
LEFT JOIN "extra_runs"   AS er
       ON er."match_id" = b."match_id"
      AND er."over_id"  = b."over_id"
      AND er."ball_id"  = b."ball_id"
LIMIT 20;
```

```sql
--Description: Runs conceded per over by every bowler in a sample of matches
SELECT b."match_id",
       b."bowler",
       b."over_id",
       SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS runs_in_over
FROM   "ball_by_ball"    AS b
LEFT  JOIN "batsman_scored" AS bs
       ON (bs."match_id",bs."over_id",bs."ball_id") =
          (b."match_id",b."over_id",b."ball_id")
LEFT  JOIN "extra_runs"     AS er
       ON (er."match_id",er."over_id",er."ball_id") =
          (b."match_id",b."over_id",b."ball_id")
GROUP BY b."match_id", b."bowler", b."over_id"
LIMIT 20;
```

```sql
--Description: Determine, for every match, the maximum runs conceded in any single over
WITH over_runs AS (
   SELECT b."match_id",
          b."bowler",
          b."over_id",
          SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS runs_in_over
   FROM   "ball_by_ball" AS b
   LEFT JOIN "batsman_scored" AS bs
          ON (bs."match_id",bs."over_id",bs."ball_id") =
             (b."match_id",b."over_id",b."ball_id")
   LEFT JOIN "extra_runs" AS er
          ON (er."match_id",er."over_id",er."ball_id") =
             (b."match_id",b."over_id",b."ball_id")
   GROUP BY b."match_id", b."bowler", b."over_id"
)
SELECT  o."match_id",
        MAX(o."runs_in_over") AS match_max_runs
FROM    over_runs AS o
GROUP BY o."match_id"
LIMIT 20;
```

```sql
--Description: List every over that actually reached its match’s maximum‑run value
WITH over_runs AS (
    SELECT b."match_id",
           b."bowler",
           b."over_id",
           SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS runs_in_over
    FROM   "ball_by_ball" AS b
    LEFT  JOIN "batsman_scored" AS bs
           ON (bs."match_id",bs."over_id",bs."ball_id") =
              (b."match_id",b."over_id",b."ball_id")
    LEFT  JOIN "extra_runs" AS er
           ON (er."match_id",er."over_id",er."ball_id") =
              (b."match_id",b."over_id",b."ball_id")
    GROUP BY b."match_id", b."bowler", b."over_id"
), match_max AS (
    SELECT "match_id", MAX("runs_in_over") AS match_max_runs
    FROM   over_runs
    GROUP  BY "match_id"
)
SELECT o."match_id",
       o."bowler",
       o."over_id",
       o."runs_in_over"
FROM   over_runs AS o
JOIN   match_max AS m
       ON m."match_id" = o."match_id"
      AND m."match_max_runs" = o."runs_in_over"
LIMIT 20;
```

```sql
--Description: Rank those maximum‑run overs across all matches and pick the top three
WITH over_runs AS (
    SELECT b."match_id",
           b."bowler",
           b."over_id",
           SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS runs_in_over
    FROM   "ball_by_ball" AS b
    LEFT  JOIN "batsman_scored" AS bs
           ON (bs."match_id",bs."over_id",bs."ball_id") =
              (b."match_id",b."over_id",b."ball_id")
    LEFT  JOIN "extra_runs" AS er
           ON (er."match_id",er."over_id",er."ball_id") =
              (b."match_id",b."over_id",b."ball_id")
    GROUP BY b."match_id", b."bowler", b."over_id"
), match_max AS (
    SELECT "match_id", MAX("runs_in_over") AS match_max_runs
    FROM   over_runs
    GROUP  BY "match_id"
), only_max_overs AS (
    SELECT o."match_id",
           o."bowler",
           o."over_id",
           o."runs_in_over"
    FROM   over_runs AS o
    JOIN   match_max AS m
           ON  o."match_id"      = m."match_id"
          AND o."runs_in_over"   = m."match_max_runs"
)
SELECT *
FROM   only_max_overs
ORDER  BY "runs_in_over" DESC
LIMIT 20;
```

```sql
--Description: Attach bowler names to those overs for readability
WITH over_runs AS (
    SELECT b."match_id",
           b."bowler",
           b."over_id",
           SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS runs_in_over
    FROM   "ball_by_ball" AS b
    LEFT  JOIN "batsman_scored" AS bs
           ON (bs."match_id",bs."over_id",bs."ball_id") =
              (b."match_id",b."over_id",b."ball_id")
    LEFT  JOIN "extra_runs" AS er
           ON (er."match_id",er."over_id",er."ball_id") =
              (b."match_id",b."over_id",b."ball_id")
    GROUP BY b."match_id", b."bowler", b."over_id"
), match_max AS (
    SELECT "match_id", MAX("runs_in_over") AS match_max_runs
    FROM   over_runs
    GROUP  BY "match_id"
), only_max_overs AS (
    SELECT o."match_id",
           o."bowler",
           o."over_id",
           o."runs_in_over"
    FROM   over_runs AS o
    JOIN   match_max AS m
           ON  o."match_id"      = m."match_id"
          AND o."runs_in_over"   = m."match_max_runs"
)
SELECT p."player_name",
       mo."bowler",
       mo."match_id",
       mo."runs_in_over"
FROM   only_max_overs AS mo
JOIN   "player"      AS p
       ON p."player_id" = mo."bowler"
ORDER  BY mo."runs_in_over" DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – the three bowlers who conceded the highest runs
--             in an over that was the costliest one of its match
WITH over_runs AS (
    SELECT b."match_id",
           b."bowler",
           b."over_id",
           SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS runs_in_over
    FROM   "ball_by_ball" AS b
    LEFT  JOIN "batsman_scored" AS bs
           ON (bs."match_id",bs."over_id",bs."ball_id") =
              (b."match_id",b."over_id",b."ball_id")
    LEFT  JOIN "extra_runs" AS er
           ON (er."match_id",er."over_id",er."ball_id") =
              (b."match_id",b."over_id",b."ball_id")
    GROUP BY b."match_id", b."bowler", b."over_id"
), match_max AS (
    SELECT "match_id", MAX("runs_in_over") AS match_max_runs
    FROM   over_runs
    GROUP  BY "match_id"
), only_max_overs AS (
    SELECT o."match_id",
           o."bowler",
           o."over_id",
           o."runs_in_over"
    FROM   over_runs AS o
    JOIN   match_max AS m
           ON  o."match_id"      = m."match_id"
          AND o."runs_in_over"   = m."match_max_runs"
)
SELECT p."player_name"   AS bowler_name,
       t1."name"         AS bowling_team,
       om."match_id",
       om."runs_in_over"
FROM   only_max_overs AS om
JOIN   "player"   AS p   ON p."player_id" = om."bowler"
LEFT   JOIN "ball_by_ball" AS bb
       ON bb."match_id" = om."match_id"
      AND bb."over_id"  = om."over_id"
      AND bb."bowler"   = om."bowler"
LEFT   JOIN "team"   AS t1 ON t1."team_id" = bb."team_bowling"
GROUP  BY om."match_id", om."bowler"            -- GROUP needed because of LEFT JOIN above
ORDER BY om."runs_in_over" DESC
LIMIT 3;
```
