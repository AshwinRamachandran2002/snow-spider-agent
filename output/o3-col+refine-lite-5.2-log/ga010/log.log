```sql
-- 8) Description: Apply a (simplified) GA4‑style default channel‑grouping logic
--                 to every December 2020 session, then tally how many sessions
--                 belong to each channel.
SELECT
  CASE
    WHEN source = '(direct)' AND medium IN ('(not set)', '(none)', '')    THEN 'Direct'
    WHEN LOWER(medium) = 'referral'                                       THEN 'Referral'
    WHEN LOWER(medium) = 'organic'                                        THEN 'Organic Search'
    WHEN REGEXP_CONTAINS(LOWER(medium), r'(cpc|ppc|paid)')                THEN 'Paid Search'
    WHEN LOWER(medium) IN ('social','social-network','social-media','sm') THEN 'Organic Social'
    ELSE 'Unassigned'
  END                                    AS channel,
  COUNT(DISTINCT CONCAT(user_pseudo_id,'-',(SELECT value.int_value
                                            FROM UNNEST(event_params)
                                            WHERE key = 'ga_session_id'
                                            LIMIT 1))) AS sessions
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND event_name = 'session_start'
GROUP BY channel
ORDER BY sessions DESC
LIMIT 20;
```

```sql
-- 9) Description: Rank those channels by number of sessions so we can isolate
--                 the 4th‑largest one (ROW_NUMBER over the DESC ordering).
SELECT
  channel,
  sessions,
  ROW_NUMBER() OVER (ORDER BY sessions DESC) AS rank_position
FROM (
  SELECT
    CASE
      WHEN source = '(direct)' AND medium IN ('(not set)', '(none)', '')    THEN 'Direct'
      WHEN LOWER(medium) = 'referral'                                       THEN 'Referral'
      WHEN LOWER(medium) = 'organic'                                        THEN 'Organic Search'
      WHEN REGEXP_CONTAINS(LOWER(medium), r'(cpc|ppc|paid)')                THEN 'Paid Search'
      WHEN LOWER(medium) IN ('social','social-network','social-media','sm') THEN 'Organic Social'
      ELSE 'Unassigned'
    END                                    AS channel,
    COUNT(DISTINCT CONCAT(user_pseudo_id,'-',(SELECT value.int_value
                                              FROM UNNEST(event_params)
                                              WHERE key = 'ga_session_id'
                                              LIMIT 1))) AS sessions
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND event_name = 'session_start'
  GROUP BY channel
)
ORDER BY rank_position
LIMIT 20;
```

```sql
-- 10) Description: Finally, return ONLY the channel that has the 4th‑highest
--                  number of sessions for December 2020 (plus its session count).
SELECT
  channel,
  sessions
FROM (
  SELECT
    channel,
    sessions,
    ROW_NUMBER() OVER (ORDER BY sessions DESC) AS rank_position
  FROM (
    SELECT
      CASE
        WHEN source = '(direct)' AND medium IN ('(not set)', '(none)', '')    THEN 'Direct'
        WHEN LOWER(medium) = 'referral'                                       THEN 'Referral'
        WHEN LOWER(medium) = 'organic'                                        THEN 'Organic Search'
        WHEN REGEXP_CONTAINS(LOWER(medium), r'(cpc|ppc|paid)')                THEN 'Paid Search'
        WHEN LOWER(medium) IN ('social','social-network','social-media','sm') THEN 'Organic Social'
        ELSE 'Unassigned'
      END                                    AS channel,
      COUNT(DISTINCT CONCAT(user_pseudo_id,'-',(SELECT value.int_value
                                                FROM UNNEST(event_params)
                                                WHERE key = 'ga_session_id'
                                                LIMIT 1))) AS sessions
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
      AND event_name = 'session_start'
    GROUP BY channel
  )
)
WHERE rank_position = 4
LIMIT 20;
```
