--Description: 9) For each legislator/year pair above, check whether they still held any office on or after that anniversary date (i.e., term_end ≥ anniversary_date).  
SELECT DISTINCT h."id_bioguide",
       h.years_after_start,
       CASE WHEN EXISTS (SELECT 1
                         FROM   "legislators_terms" AS lt
                         WHERE  lt."id_bioguide" = h."id_bioguide"
                           AND  lt."term_start" <= h.anniversary_date
                           AND  lt."term_end"   >= h.anniversary_date)
            THEN 1 ELSE 0 END AS retained
FROM  (/* sub‑query from #8 */ 
      SELECT c."id_bioguide",
             (CAST(substr(c.first_term_start,1,4) AS INTEGER) + n.years) || substr(c.first_term_start,5) AS anniversary_date,
             n.years AS years_after_start
      FROM  (SELECT lt2."id_bioguide",
                    MIN(lt2."term_start") AS first_term_start
             FROM   "legislators_terms" AS lt2
             GROUP  BY lt2."id_bioguide"
             HAVING first_term_start BETWEEN '1917-01-01' AND '1999-12-31') AS c
      JOIN  (SELECT 0 AS years UNION SELECT 1 UNION SELECT 2 UNION SELECT 3 UNION
             SELECT 4 UNION SELECT 5 UNION SELECT 6 UNION SELECT 7 UNION SELECT 8 UNION
             SELECT 9 UNION SELECT 10 UNION SELECT 11 UNION SELECT 12 UNION SELECT 13 UNION
             SELECT 14 UNION SELECT 15 UNION SELECT 16 UNION SELECT 17 UNION SELECT 18 UNION
             SELECT 19) AS n) AS h
LIMIT 20;
