```sql
--Description: 1) Look at a few distinct combinations of legislator id, term start and end dates.  
SELECT DISTINCT "id_bioguide",
       "term_start",
       "term_end",
       "term_type"
FROM   "legislators_terms"
LIMIT 20;
```

```sql
--Description: 2) For every legislator, find the date of the very first term_start that appears in the table.  
SELECT DISTINCT lt."id_bioguide",
       MIN(lt."term_start") AS first_term_start
FROM   "legislators_terms" AS lt
GROUP  BY lt."id_bioguide"
LIMIT 20;
```

```sql
--Description: 3) Restrict the cohort to those whose very first term_start was between 1917‑01‑01 and 1999‑12‑31.  
SELECT DISTINCT base."id_bioguide",
       base.first_term_start
FROM  (SELECT lt."id_bioguide",
              MIN(lt."term_start") AS first_term_start
       FROM   "legislators_terms" AS lt
       GROUP  BY lt."id_bioguide") AS base
WHERE  base.first_term_start BETWEEN '1917-01-01' AND '1999-12-31'
LIMIT 20;
```

```sql
--Description: 4) Count how many legislators are in that 1917‑1999 first‑term cohort.  
SELECT COUNT(*) AS cohort_size
FROM  (SELECT lt."id_bioguide",
              MIN(lt."term_start") AS first_term_start
       FROM   "legislators_terms" AS lt
       GROUP  BY lt."id_bioguide") AS base
WHERE  base.first_term_start BETWEEN '1917-01-01' AND '1999-12-31';
```

```sql
--Description: 5) For one sample legislator (replace 'B000944' with any id returned above), list all of their term_start and term_end pairs to understand tenure patterns.  
SELECT DISTINCT "term_number",
       "term_start",
       "term_end"
FROM   "legislators_terms"
WHERE  "id_bioguide" = 'B000944'
ORDER  BY "term_number"
LIMIT 20;
```

```sql
--Description: 6) For the 1917‑1999 cohort, join back to all of their terms so we can look at a timeline of service.  
SELECT DISTINCT c."id_bioguide",
       c.first_term_start,
       lt."term_start",
       lt."term_end"
FROM  (SELECT lt2."id_bioguide",
              MIN(lt2."term_start") AS first_term_start
       FROM   "legislators_terms" AS lt2
       GROUP  BY lt2."id_bioguide"
       HAVING first_term_start BETWEEN '1917-01-01' AND '1999-12-31') AS c
JOIN   "legislators_terms" AS lt
       ON lt."id_bioguide" = c."id_bioguide"
LIMIT 20;
```

```sql
--Description: 7) Show the distinct year numbers (YYYY) that appear in term_start; useful for looping 0‑19 years later.  
SELECT DISTINCT substr("term_start",1,4) AS start_year
FROM   "legislators_terms"
ORDER  BY start_year
LIMIT 20;
```

```sql
--Description: 8) Build a helper list of the first 20 anniversary dates (0‑19) for each legislator in the cohort.  
SELECT DISTINCT c."id_bioguide",
       c.first_term_start,
       (CAST(substr(c.first_term_start,1,4) AS INTEGER) + n.years) || substr(c.first_term_start,5) AS anniversary_date,
       n.years AS years_after_start
FROM  (SELECT lt2."id_bioguide",
              MIN(lt2."term_start") AS first_term_start
       FROM   "legislators_terms" AS lt2
       GROUP  BY lt2."id_bioguide"
       HAVING first_term_start BETWEEN '1917-01-01' AND '1999-12-31') AS c
JOIN  (SELECT 0 AS years UNION SELECT 1 UNION SELECT 2 UNION SELECT 3 UNION
       SELECT 4 UNION SELECT 5 UNION SELECT 6 UNION SELECT 7 UNION SELECT 8 UNION
       SELECT 9 UNION SELECT 10 UNION SELECT 11 UNION SELECT 12 UNION SELECT 13 UNION
       SELECT 14 UNION SELECT 15 UNION SELECT 16 UNION SELECT 17 UNION SELECT 18 UNION
       SELECT 19) AS n
LIMIT 20;
```

```sql
--Description: 9) For each legislator/year pair above, check whether they still held any office on or after that anniversary date (i.e., term_end ≥ anniversary_date).  
SELECT DISTINCT h."id_bioguide",
       h.years_after_start,
       CASE WHEN EXISTS (SELECT 1
                         FROM   "legislators_terms" AS lt
                         WHERE  lt."id_bioguide" = h."id_bioguide"
                           AND  lt."term_start" <= h.anniversary_date
                           AND  lt."term_end"   >= h.anniversary_date)
            THEN 1 ELSE 0 END AS retained
FROM  (/* sub‑query from #8 */ 
      SELECT c."id_bioguide",
             (CAST(substr(c.first_term_start,1,4) AS INTEGER) + n.years) || substr(c.first_term_start,5) AS anniversary_date,
             n.years AS years_after_start
      FROM  (SELECT lt2."id_bioguide",
                    MIN(lt2."term_start") AS first_term_start
             FROM   "legislators_terms" AS lt2
             GROUP  BY lt2."id_bioguide"
             HAVING first_term_start BETWEEN '1917-01-01' AND '1999-12-31') AS c
      JOIN  (SELECT 0 AS years UNION SELECT 1 UNION SELECT 2 UNION SELECT 3 UNION
             SELECT 4 UNION SELECT 5 UNION SELECT 6 UNION SELECT 7 UNION SELECT 8 UNION
             SELECT 9 UNION SELECT 10 UNION SELECT 11 UNION SELECT 12 UNION SELECT 13 UNION
             SELECT 14 UNION SELECT 15 UNION SELECT 16 UNION SELECT 17 UNION SELECT 18 UNION
             SELECT 19) AS n) AS h
LIMIT 20;
```

```sql
--Description: 10) Aggregate the above to get the annual retention rate (proportion retained) for years 0‑19; shows all 20 rows in sequence.  
SELECT r.years_after_start,
       ROUND(AVG(r.retained),3) AS retention_rate
FROM  (/* sub‑query from #9 that returns retained = 0/1 per legislator/year */ 
      SELECT h."id_bioguide",
             h.years_after_start,
             CASE WHEN EXISTS (SELECT 1
                               FROM   "legislators_terms" AS lt
                               WHERE  lt."id_bioguide" = h."id_bioguide"
                                 AND  lt."term_start" <= h.anniversary_date
                                 AND  lt."term_end"   >= h.anniversary_date)
                  THEN 1 ELSE 0 END AS retained
      FROM  (/* sub‑query from #8 */ 
            SELECT c."id_bioguide",
                   (CAST(substr(c.first_term_start,1,4) AS INTEGER) + n.years) || substr(c.first_term_start,5) AS anniversary_date,
                   n.years AS years_after_start
            FROM  (SELECT lt2."id_bioguide",
                          MIN(lt2."term_start") AS first_term_start
                   FROM   "legislators_terms" AS lt2
                   GROUP  BY lt2."id_bioguide"
                   HAVING first_term_start BETWEEN '1917-01-01' AND '1999-12-31') AS c
            JOIN  (SELECT 0 AS years UNION SELECT 1 UNION SELECT 2 UNION SELECT 3 UNION
                   SELECT 4 UNION SELECT 5 UNION SELECT 6 UNION SELECT 7 UNION SELECT 8 UNION
                   SELECT 9 UNION SELECT 10 UNION SELECT 11 UNION SELECT 12 UNION SELECT 13 UNION
                   SELECT 14 UNION SELECT 15 UNION SELECT 16 UNION SELECT 17 UNION SELECT 18 UNION
                   SELECT 19) AS n) AS h) AS r
GROUP BY r.years_after_start
ORDER BY r.years_after_start
LIMIT 20;
```
