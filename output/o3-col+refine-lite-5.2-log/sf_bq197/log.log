```sql
--Description:  Determine each month’s best‑selling product (highest unit volume, revenue as tiebreaker) 
--for all months prior to July 2024.  
--Steps inside CTEs:  
--1) monthly_sales – aggregate “Complete” order items that have a non‑null product brand.  
--2) ranked_monthly – rank those products inside every month by units_sold then revenue.  
--3) final SELECT – keep rank = 1 rows, add product details, round revenue, and output required columns.
WITH monthly_sales AS (
    SELECT  DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) AS "order_month",
            p."id"                                                      AS "product_id",
            COUNT(*)                                                    AS "units_sold",
            SUM(oi."sale_price")                                        AS "revenue"
    FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
            ON oi."product_id" = p."id"
    WHERE   oi."status" = 'Complete'
      AND   p."brand" IS NOT NULL
      AND   DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) < DATE '2024-07-01'
    GROUP BY 1, 2
),
ranked_monthly AS (
    SELECT  ms.*,
            ROW_NUMBER() OVER (PARTITION BY ms."order_month"
                               ORDER BY ms."units_sold" DESC, ms."revenue" DESC) AS rn
    FROM    monthly_sales ms
)
SELECT  rm."order_month"                          AS "month",
        pr."name"                                 AS "product_name",
        pr."brand",
        pr."category",
        rm."units_sold"                           AS "total_sales",
        ROUND(rm."revenue", 2)                    AS "rounded_total_revenue",
        'Complete'                                AS "order_status"
FROM    ranked_monthly rm
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" pr
        ON rm."product_id" = pr."id"
WHERE   rm.rn = 1
ORDER BY rm."order_month";
```
