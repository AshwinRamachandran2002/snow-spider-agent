```sql
--Description: Check which innings numbers exist so the join condition can include it.
SELECT DISTINCT innings_no
FROM ball_by_ball
LIMIT 20;
```

```sql
--Description: Join ball_by_ball with batsman_scored to get (match, striker, runs_scored) for every ball.
SELECT DISTINCT bb.match_id,
       bb.striker,
       bs.runs_scored
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs
  ON bb.match_id   = bs.match_id
 AND bb.over_id    = bs.over_id
 AND bb.ball_id    = bs.ball_id
 AND bb.innings_no = bs.innings_no
LIMIT 20;
```

```sql
--Description: Aggregate total runs by every striker in every match.
SELECT DISTINCT bb.match_id,
       bb.striker                      AS player_id,
       SUM(bs.runs_scored)             AS total_runs
FROM ball_by_ball AS bb
JOIN batsman_scored AS bs
  ON bb.match_id   = bs.match_id
 AND bb.over_id    = bs.over_id
 AND bb.ball_id    = bs.ball_id
 AND bb.innings_no = bs.innings_no
GROUP BY bb.match_id,
         bb.striker
LIMIT 20;
```

```sql
--Description: Show only those (striker, match) tuples where the striker scored more than 50.
SELECT DISTINCT *
FROM (
      SELECT bb.match_id,
             bb.striker AS player_id,
             SUM(bs.runs_scored) AS total_runs
      FROM ball_by_ball AS bb
      JOIN batsman_scored AS bs
        ON bb.match_id   = bs.match_id
       AND bb.over_id    = bs.over_id
       AND bb.ball_id    = bs.ball_id
       AND bb.innings_no = bs.innings_no
      GROUP BY bb.match_id,
               bb.striker
) AS t
WHERE total_runs > 50
LIMIT 20;
```

```sql
--Description: Compute the required average of all such 50‑plus scores.
SELECT AVG(total_runs) AS average_runs_of_50_plus
FROM (
      SELECT bb.match_id,
             bb.striker AS player_id,
             SUM(bs.runs_scored) AS total_runs
      FROM ball_by_ball AS bb
      JOIN batsman_scored AS bs
        ON bb.match_id   = bs.match_id
       AND bb.over_id    = bs.over_id
       AND bb.ball_id    = bs.ball_id
       AND bb.innings_no = bs.innings_no
      GROUP BY bb.match_id,
               bb.striker
      HAVING SUM(bs.runs_scored) > 50
); 
```
