--Description: Compute each player’s average runs per match for season 5.
SELECT tr."player_id",
       tr."total_runs" * 1.0 / mp."matches_played" AS "avg_runs"
FROM (
    SELECT agg."player_id",
           SUM(agg."runs_in_match") AS "total_runs"
    FROM (
        SELECT bbb."striker"         AS "player_id",
               SUM(bs."runs_scored") AS "runs_in_match"
