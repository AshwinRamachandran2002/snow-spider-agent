```sql
--Description: Display a few matches that belong to season 5.
SELECT DISTINCT "match_id",
       "team_1",
       "team_2"
FROM "match"
WHERE "season_id" = 5
LIMIT 20;
```

```sql
--Description: See which players appeared in some season 5 matches.
SELECT DISTINCT pm."match_id",
       pm."player_id",
       pm."team_id"
FROM "player_match" AS pm
JOIN "match"       AS m  ON m."match_id" = pm."match_id"
WHERE m."season_id" = 5
LIMIT 20;
```

```sql
--Description: Look at batting‑run records (batsman_scored) for season 5.
SELECT DISTINCT bs."match_id",
       bs."over_id",
       bs."ball_id",
       bs."runs_scored",
       bs."innings_no"
FROM "batsman_scored" AS bs
JOIN "match"          AS m  ON m."match_id" = bs."match_id"
WHERE m."season_id" = 5
LIMIT 20;
```

```sql
--Description: Join ball‑by‑ball with batsman_scored to fetch striker IDs and runs in season 5.
SELECT DISTINCT bbb."match_id",
       bbb."striker",          -- player who faced the ball
       bs."runs_scored"
FROM "ball_by_ball"  AS bbb
JOIN "batsman_scored" AS bs
  ON bs."match_id"  = bbb."match_id"
 AND bs."over_id"   = bbb."over_id"
 AND bs."ball_id"   = bbb."ball_id"
 AND bs."innings_no"= bbb."innings_no"
JOIN "match"         AS m   ON m."match_id" = bbb."match_id"
WHERE m."season_id" = 5
LIMIT 20;
```

```sql
--Description: Total runs made by every player in each individual match of season 5.
SELECT bbb."match_id",
       bbb."striker"               AS "player_id",
       SUM(bs."runs_scored")       AS "runs_in_match"
FROM "ball_by_ball"  AS bbb
JOIN "batsman_scored" AS bs
  ON bs."match_id"  = bbb."match_id"
 AND bs."over_id"   = bbb."over_id"
 AND bs."ball_id"   = bbb."ball_id"
 AND bs."innings_no"= bbb."innings_no"
JOIN "match"         AS m   ON m."match_id" = bbb."match_id"
WHERE m."season_id" = 5
GROUP BY bbb."match_id", bbb."striker"
LIMIT 20;
```

```sql
--Description: Number of season 5 matches each player took part in.
SELECT pm."player_id",
       COUNT(DISTINCT pm."match_id") AS "matches_played"
FROM "player_match" AS pm
JOIN "match"        AS m ON m."match_id" = pm."match_id"
WHERE m."season_id" = 5
GROUP BY pm."player_id"
LIMIT 20;
```

```sql
--Description: Aggregate total runs for every player across all season 5 matches.
SELECT agg."player_id",
       SUM(agg."runs_in_match") AS "total_runs"
FROM (
    SELECT bbb."striker"         AS "player_id",
           SUM(bs."runs_scored") AS "runs_in_match"
    FROM "ball_by_ball"  AS bbb
    JOIN "batsman_scored" AS bs
      ON bs."match_id"  = bbb."match_id"
     AND bs."over_id"   = bbb."over_id"
     AND bs."ball_id"   = bbb."ball_id"
     AND bs."innings_no"= bbb."innings_no"
    JOIN "match"         AS m   ON m."match_id" = bbb."match_id"
    WHERE m."season_id" = 5
    GROUP BY bbb."match_id", bbb."striker"
) AS agg
GROUP BY agg."player_id"
LIMIT 20;
```

```sql
--Description: Compute each player’s average runs per match for season 5.
SELECT tr."player_id",
       tr."total_runs" * 1.0 / mp."matches_played" AS "avg_runs"
FROM (
    SELECT agg."player_id",
           SUM(agg."runs_in_match") AS "total_runs"
    FROM (
        SELECT bbb."striker"         AS "player_id",
               SUM(bs."runs_scored") AS "runs_in_match"
        FROM "ball_by_ball"  AS bbb
        JOIN "batsman_scored" AS bs
          ON bs."match_id"  = bbb."match_id"
         AND bs."over_id"   = bbb."over_id"
         AND bs."ball_id"   = bbb."ball_id"
         AND bs."innings_no"= bbb."innings_no"
        JOIN "match"         AS m   ON m."match_id" = bbb."match_id"
        WHERE m."season_id" = 5
        GROUP BY bbb."match_id", bbb."striker"
    ) AS agg
    GROUP BY agg."player_id"
) AS tr
JOIN (
    SELECT pm."player_id",
           COUNT(DISTINCT pm."match_id") AS "matches_played"
    FROM "player_match" AS pm
    JOIN "match"        AS m ON m."match_id" = pm."match_id"
    WHERE m."season_id" = 5
    GROUP BY pm."player_id"
) AS mp ON tr."player_id" = mp."player_id"
LIMIT 20;
```

```sql
--Description: Final answer – top 5 players with the highest average runs per match in season 5.
SELECT p."player_name",
       ROUND(avg_tbl."avg_runs", 2) AS "batting_average"
FROM (
    SELECT tr."player_id",
           tr."total_runs" * 1.0 / mp."matches_played" AS "avg_runs"
    FROM (
        SELECT agg."player_id",
               SUM(agg."runs_in_match") AS "total_runs"
        FROM (
            SELECT bbb."striker"         AS "player_id",
                   SUM(bs."runs_scored") AS "runs_in_match"
            FROM "ball_by_ball"  AS bbb
            JOIN "batsman_scored" AS bs
              ON bs."match_id"  = bbb."match_id"
             AND bs."over_id"   = bbb."over_id"
             AND bs."ball_id"   = bbb."ball_id"
             AND bs."innings_no"= bbb."innings_no"
            JOIN "match"         AS m   ON m."match_id" = bbb."match_id"
            WHERE m."season_id" = 5
            GROUP BY bbb."match_id", bbb."striker"
        ) AS agg
        GROUP BY agg."player_id"
    ) AS tr
    JOIN (
        SELECT pm."player_id",
               COUNT(DISTINCT pm."match_id") AS "matches_played"
        FROM "player_match" AS pm
        JOIN "match"        AS m ON m."match_id" = pm."match_id"
        WHERE m."season_id" = 5
        GROUP BY pm."player_id"
    ) AS mp ON tr."player_id" = mp."player_id"
) AS avg_tbl
JOIN "player" AS p ON p."player_id" = avg_tbl."player_id"
ORDER BY avg_tbl."avg_runs" DESC
LIMIT 5;
```
