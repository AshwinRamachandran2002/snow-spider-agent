```sql
--Description:  Fix the earlier “misuse of window function” problem by performing the
--              calculations in consecutive CTE layers instead of nesting window
--              functions.  The steps (thinking process) are written inline:
--   1) daily_running  – cumulative running balance for customer 429.
--   2) rolling_30     – 30‑day rolling average of that running balance, clipping
--                       any negative average to 0.
--   3) month_max      – maximum 30‑day average balance within each calendar month.
WITH daily_running AS (          -- Step‑1: running balance day‑by‑day
    SELECT
        ct."customer_id",
        date(ct."txn_date") AS txn_day,
        SUM( CASE WHEN ct."txn_type" = 'deposit'
                  THEN  ct."txn_amount"
                  ELSE -ct."txn_amount" END )  
            OVER ( PARTITION BY ct."customer_id"
                   ORDER BY      date(ct."txn_date")
                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW ) AS running_balance
    FROM   "customer_transactions" AS ct
    WHERE  ct."customer_id" = 429                        -- sample customer
),
rolling_30 AS (             -- Step‑2: 30‑day rolling average, negatives clipped to 0
    SELECT
        dr."customer_id",
        dr.txn_day,
        CASE 
            WHEN AVG(dr.running_balance)
                 OVER ( PARTITION BY dr."customer_id"
                        ORDER BY      dr.txn_day
                        ROWS BETWEEN 29 PRECEDING AND CURRENT ROW ) < 0
            THEN 0
            ELSE AVG(dr.running_balance)
                 OVER ( PARTITION BY dr."customer_id"
                        ORDER BY      dr.txn_day
                        ROWS BETWEEN 29 PRECEDING AND CURRENT ROW )
        END AS rolling_30d_avg_bal
    FROM   daily_running AS dr
),
month_max AS (             -- Step‑3: pick the monthly maximum of that 30‑day average
    SELECT
        strftime('%Y-%m', txn_day) AS year_month,
        MAX(rolling_30d_avg_bal)   AS max_30d_avg_bal
    FROM   rolling_30
    GROUP  BY year_month
)
SELECT *                   -- final output
FROM   month_max
ORDER  BY year_month
LIMIT 20;
```
