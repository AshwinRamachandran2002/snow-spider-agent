```sql
--Description:  Sum the monthly maxima across all customers, excluding each
--              customer’s baseline (first) month.
WITH first_month AS (
    SELECT
        "customer_id",
        MIN( strftime('%Y-%m', "txn_date") ) AS first_month
    FROM   "customer_transactions"
    GROUP  BY "customer_id"
),
daily_amounts AS (
    SELECT "customer_id",
           date("txn_date") AS txn_day,
           SUM( CASE WHEN "txn_type"='deposit'
                     THEN  "txn_amount"
                     ELSE - "txn_amount" END ) AS net_amount
    FROM   "customer_transactions"
    GROUP  BY "customer_id", txn_day
),
daily_running AS (
    SELECT da."customer_id",
           da.txn_day,
           SUM(da.net_amount) OVER (
               PARTITION BY da."customer_id"
               ORDER BY      da.txn_day
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
           ) AS running_balance
    FROM   daily_amounts AS da
),
rolling_30 AS (
    SELECT dr."customer_id",
           dr.txn_day,
           CASE WHEN AVG(dr.running_balance) OVER (
                        PARTITION BY dr."customer_id"
                        ORDER BY      dr.txn_day
                        ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                   ) < 0
                THEN 0
                ELSE AVG(dr.running_balance) OVER (
                        PARTITION BY dr."customer_id"
                        ORDER BY      dr.txn_day
                        ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
                   )
           END AS rolling_30d_avg_bal
    FROM   daily_running AS dr
),
month_max AS (
    SELECT r."customer_id",
           strftime('%Y-%m', r.txn_day) AS year_month,
           MAX(r.rolling_30d_avg_bal)   AS max_30d_avg_bal
    FROM   rolling_30 AS r
    GROUP  BY r."customer_id", year_month
),
exclude_baseline AS (
    SELECT m.*
    FROM   month_max AS m
    JOIN   first_month AS f
      ON   m."customer_id" = f."customer_id"
    WHERE  m.year_month <> f.first_month
)
SELECT
    year_month,
    SUM(max_30d_avg_bal) AS sum_of_monthly_max_30d_avgs
FROM   exclude_baseline
GROUP  BY year_month
ORDER  BY year_month
LIMIT 20;
