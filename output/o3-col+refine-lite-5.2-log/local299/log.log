```sql
--Description: Sum those monthly maxima across all customers, skipping each customer’s baseline month
WITH first_month AS (
        SELECT  "customer_id",
                MIN(strftime('%Y-%m', "txn_date")) AS "first_month"
        FROM    "customer_transactions"
        GROUP BY "customer_id"
),
daily_running AS (
        SELECT  ct."customer_id",
                ct."txn_date",
                SUM(CASE WHEN ct."txn_type"='deposit'
                         THEN  ct."txn_amount"
                         ELSE -ct."txn_amount" END)
                    OVER (PARTITION BY ct."customer_id"
                          ORDER BY      ct."txn_date"
                          ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
        FROM    "customer_transactions" AS ct
),
rolling_30 AS (
        SELECT  dr."customer_id",
                dr."txn_date",
                CASE WHEN AVG(dr."running_balance")
                         OVER (PARTITION BY dr."customer_id"
                               ORDER BY      dr."txn_date"
                               RANGE BETWEEN 29 PRECEDING AND CURRENT ROW) < 0
                     THEN 0
                     ELSE AVG(dr."running_balance")
                         OVER (PARTITION BY dr."customer_id"
                               ORDER BY      dr."txn_date"
                               RANGE BETWEEN 29 PRECEDING AND CURRENT ROW)
                END AS "rolling_30d_avg_bal"
        FROM    daily_running AS dr
),
month_max AS (
        SELECT  r."customer_id",
                strftime('%Y-%m', r."txn_date") AS "year_month",
                MAX(r."rolling_30d_avg_bal")     AS "max_30d_avg_bal"
        FROM    rolling_30 AS r
        GROUP BY r."customer_id",
                 "year_month"
),
exclude_baseline AS (
        SELECT  m.*
        FROM    month_max AS m
        JOIN    first_month AS f
          ON    m."customer_id" = f."customer_id"
        WHERE   m."year_month" <> f."first_month"
)
SELECT  "year_month",
        SUM("max_30d_avg_bal") AS "sum_of_monthly_max_30d_avgs"
FROM    exclude_baseline
GROUP BY "year_month"
ORDER BY "year_month"
LIMIT 20;
```

```sql
--Description: OPTIONAL – tie the final numbers back to customer regions to add business context
SELECT  e."year_month",
        cr."region_name",
        SUM(e."max_30d_avg_bal") AS "regional_monthly_total"
FROM   (
        /* reuse the exclude_baseline CTE from the previous query */
        WITH first_month AS (
                SELECT  "customer_id",
                        MIN(strftime('%Y-%m', "txn_date")) AS "first_month"
                FROM    "customer_transactions"
                GROUP BY "customer_id"
        ),
        daily_running AS (
                SELECT  ct."customer_id",
                        ct."txn_date",
                        SUM(CASE WHEN ct."txn_type"='deposit'
                                 THEN  ct."txn_amount"
                                 ELSE -ct."txn_amount" END)
                        OVER (PARTITION BY ct."customer_id"
                              ORDER BY      ct."txn_date"
                              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
                FROM    "customer_transactions" AS ct
        ),
        rolling_30 AS (
                SELECT  dr."customer_id",
                        dr."txn_date",
                        CASE WHEN AVG(dr."running_balance")
                                 OVER (PARTITION BY dr."customer_id"
                                       ORDER BY      dr."txn_date"
                                       RANGE BETWEEN 29 PRECEDING AND CURRENT ROW) < 0
                             THEN 0
                             ELSE AVG(dr."running_balance")
                                 OVER (PARTITION BY dr."customer_id"
                                       ORDER BY      dr."txn_date"
                                       RANGE BETWEEN 29 PRECEDING AND CURRENT ROW)
                        END AS "rolling_30d_avg_bal"
                FROM    daily_running AS dr
        ),
        month_max AS (
                SELECT  r."customer_id",
                        strftime('%Y-%m', r."txn_date") AS "year_month",
                        MAX(r."rolling_30d_avg_bal")     AS "max_30d_avg_bal"
                FROM    rolling_30 AS r
                GROUP BY r."customer_id", "year_month"
        ),
        exclude_baseline AS (
                SELECT  m.*
                FROM    month_max AS m
                JOIN    first_month AS f
                  ON    m."customer_id" = f."customer_id"
                WHERE   m."year_month" <> f."first_month"
        )
        SELECT * FROM exclude_baseline
     ) AS e
JOIN       "customer_nodes"   AS cn ON e."customer_id" = cn."customer_id"
JOIN       "customer_regions" AS cr ON cn."region_id"  = cr."region_id"
GROUP BY    e."year_month",
            cr."region_name"
ORDER BY    e."year_month",
            cr."region_name"
LIMIT 20;
```
