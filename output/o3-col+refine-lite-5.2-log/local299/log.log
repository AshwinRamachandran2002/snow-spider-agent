```sql
--Description: Still for the same customer, calculate the 30‑day rolling average balance (negatives clipped to zero)
SELECT  r.*,
        CASE WHEN AVG(r."running_balance")
                 OVER (PARTITION BY r."customer_id"
                       ORDER BY      r."txn_date"
                       RANGE BETWEEN 29 PRECEDING AND CURRENT ROW) < 0
             THEN 0
             ELSE AVG(r."running_balance")
                 OVER (PARTITION BY r."customer_id"
                       ORDER BY      r."txn_date"
                       RANGE BETWEEN 29 PRECEDING AND CURRENT ROW)
        END AS "rolling_30d_avg_bal"
FROM   (
        SELECT  ct."customer_id",
                ct."txn_date",
                SUM(CASE WHEN ct."txn_type"='deposit' 
                         THEN  ct."txn_amount"
                         ELSE -ct."txn_amount" END)
                    OVER (PARTITION BY ct."customer_id"
                          ORDER BY      ct."txn_date"
                          ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
        FROM    "customer_transactions" AS ct
        WHERE   ct."customer_id" = 429
      ) AS r
ORDER BY r."txn_date"
LIMIT 20;
```

