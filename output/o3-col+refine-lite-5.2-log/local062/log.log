LIMIT 20;
```

```sql
--Description: 4) Join sales with costs for the same rows in December‑2021 (LIMIT 20).  
SELECT s.prod_id,
       s.cust_id,
       s.time_id,
       s.quantity_sold,
       c.unit_price,
       c.unit_cost
FROM sales  AS s
JOIN costs  AS c
  ON c.prod_id  = s.prod_id
 AND c.time_id  = s.time_id
 AND c.channel_id = s.channel_id
 AND c.promo_id   = s.promo_id
WHERE s.cust_id IN (SELECT cust_id
                    FROM customers
                    WHERE country_id IN (SELECT country_id
                                         FROM countries
                                         WHERE country_name = 'Italy'))
  AND s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: 5) Compute the profit for every individual sale (LIMIT 20).  
SELECT s.cust_id,
       s.time_id,
       (s.quantity_sold * (c.unit_price - c.unit_cost)) AS profit
FROM sales  AS s
JOIN costs  AS c
  ON c.prod_id  = s.prod_id
 AND c.time_id  = s.time_id
 AND c.channel_id = s.channel_id
 AND c.promo_id   = s.promo_id
WHERE s.cust_id IN (SELECT cust_id
                    FROM customers
                    WHERE country_id IN (SELECT country_id
                                         FROM countries
                                         WHERE country_name = 'Italy'))
  AND s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: 6) Aggregate those profits into a December‑2021 total for every Italian customer (LIMIT 20).  
SELECT s.cust_id,
       SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
FROM sales  AS s
JOIN costs  AS c
  ON c.prod_id  = s.prod_id
 AND c.time_id  = s.time_id
 AND c.channel_id = s.channel_id
 AND c.promo_id   = s.promo_id
WHERE s.cust_id IN (SELECT cust_id
                    FROM customers
                    WHERE country_id IN (SELECT country_id
                                         FROM countries
                                         WHERE country_name = 'Italy'))
  AND s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
GROUP BY s.cust_id
LIMIT 20;
```

```sql
--Description: 7) Discover the overall minimum and maximum monthly profit among all Italian customers.  
WITH customer_profit AS (
    SELECT s.cust_id,
           SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
    FROM sales  AS s
    JOIN costs  AS c
      ON c.prod_id  = s.prod_id
     AND c.time_id  = s.time_id
     AND c.channel_id = s.channel_id
     AND c.promo_id   = s.promo_id
    WHERE s.cust_id IN (SELECT cust_id
                        FROM customers
                        WHERE country_id IN (SELECT country_id
                                             FROM countries
                                             WHERE country_name = 'Italy'))
      AND s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
    GROUP BY s.cust_id
)
SELECT MIN(total_profit) AS min_profit,
       MAX(total_profit) AS max_profit
FROM customer_profit;
```

```sql
--Description: 8) Assign every customer to a bucket (1‑10) using equal‑width intervals (LIMIT 20).  
WITH customer_profit AS (
    SELECT s.cust_id,
           SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
    FROM sales  AS s
    JOIN costs  AS c
      ON c.prod_id  = s.prod_id
     AND c.time_id  = s.time_id
     AND c.channel_id = s.channel_id
     AND c.promo_id   = s.promo_id
    WHERE s.cust_id IN (SELECT cust_id
                        FROM customers
                        WHERE country_id IN (SELECT country_id
                                             FROM countries
                                             WHERE country_name = 'Italy'))
      AND s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
    GROUP BY s.cust_id
),
bounds AS (
    SELECT MIN(total_profit) AS min_p,
           MAX(total_profit) AS max_p
    FROM customer_profit
),
bucketed AS (
    SELECT cp.cust_id,
           cp.total_profit,
           1 + CAST(((cp.total_profit - b.min_p) * 10.0) /
                    (CASE WHEN (b.max_p - b.min_p) = 0
                          THEN 1
                          ELSE (b.max_p - b.min_p)
                     END) AS INTEGER) AS bucket
    FROM customer_profit AS cp,
         bounds           AS b
)
SELECT *
FROM bucketed
LIMIT 20;
```

```sql
--Description: 9) Summarise each bucket – number of customers and the profit span inside it.  
WITH customer_profit AS (
    SELECT s.cust_id,
           SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
    FROM sales  AS s
    JOIN costs  AS c
      ON c.prod_id  = s.prod_id
     AND c.time_id  = s.time_id
     AND c.channel_id = s.channel_id
     AND c.promo_id   = s.promo_id
    WHERE s.cust_id IN (SELECT cust_id
                        FROM customers
                        WHERE country_id IN (SELECT country_id
                                             FROM countries
                                             WHERE country_name = 'Italy'))
      AND s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
    GROUP BY s.cust_id
),
bounds AS (
    SELECT MIN(total_profit) AS min_p,
           MAX(total_profit) AS max_p
    FROM customer_profit
),
bucketed AS (
    SELECT cp.cust_id,
           cp.total_profit,
           1 + CAST(((cp.total_profit - b.min_p) * 10.0) /
                    (CASE WHEN (b.max_p - b.min_p) = 0
                          THEN 1
                          ELSE (b.max_p - b.min_p)
                     END) AS INTEGER) AS bucket
    FROM customer_profit AS cp,
         bounds           AS b
)
SELECT bucket,
       COUNT(*)             AS customers_in_bucket,
       MIN(total_profit)    AS bucket_min_profit,
       MAX(total_profit)    AS bucket_max_profit
FROM bucketed
GROUP BY bucket
ORDER BY bucket;
```

```sql
--Description: 10) Final answer – same as #9 but with clearer column names.  
WITH customer_profit AS (
    SELECT s.cust_id,
           SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
    FROM sales  AS s
    JOIN costs  AS c
      ON c.prod_id  = s.prod_id
     AND c.time_id  = s.time_id
     AND c.channel_id = s.channel_id
     AND c.promo_id   = s.promo_id
    WHERE s.cust_id IN (SELECT cust_id
                        FROM customers
                        WHERE country_id IN (SELECT country_id
                                             FROM countries
                                             WHERE country_name = 'Italy'))
      AND s.time_id BETWEEN '2021-12-01' AND '2021-12-31'
    GROUP BY s.cust_id
),
bounds AS (
    SELECT MIN(total_profit) AS min_p,
           MAX(total_profit) AS max_p
    FROM customer_profit
),
bucketed AS (
    SELECT cp.cust_id,
           cp.total_profit,
           1 + CAST(((cp.total_profit - b.min_p) * 10.0) /
                    (CASE WHEN (b.max_p - b.min_p) = 0
                          THEN 1
                          ELSE (b.max_p - b.min_p)
                     END) AS INTEGER) AS bucket
    FROM customer_profit AS cp,
         bounds           AS b
)
SELECT bucket                         AS profit_bucket,
       COUNT(*)                       AS number_of_customers,
       MIN(total_profit)              AS min_total_profit,
       MAX(total_profit)              AS max_total_profit
FROM bucketed
GROUP BY bucket
ORDER BY bucket;
```
