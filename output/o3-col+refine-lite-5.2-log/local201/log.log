Query:
--Description: List words (4‑5 chars, start with ‘r’) that have at least one
--anagram; include the size of their anagram group.  Limited to 20 words.
WITH RECURSIVE
  letters(word, idx, ch) AS (
        SELECT words, 1, substr(words,1,1)
        FROM word_list
     UNION ALL
        SELECT word,
               idx+1,
               substr(word, idx+1, 1)
        FROM letters
        WHERE idx+1 <= length(word)
  ),
  ordered_letters AS (
        SELECT word, ch
        FROM letters
        ORDER BY word, ch
  ),
  signatures AS (
        SELECT word,
               group_concat(ch,'') AS signature
        FROM ordered_letters
        GROUP BY word
  ),
  anagram_groups AS (                                   -- signatures with >1 word
        SELECT signature, COUNT(*) AS total_words
        FROM signatures
        GROUP BY signature
        HAVING total_words > 1
  )
SELECT s.word,
       ag.total_words AS anagrams
FROM   signatures AS s
JOIN   anagram_groups AS ag  ON s.signature = ag.signature
WHERE  length(s.word) BETWEEN 4 AND 5
  AND  s.word GLOB 'r*'
LIMIT 20
