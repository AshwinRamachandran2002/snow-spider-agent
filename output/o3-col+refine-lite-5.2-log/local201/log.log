Query:
--Description: Final answer – the first 10 alphabetically ordered words that
--(a) start with ‘r’, (b) are 4‑5 letters long, and (c) have at least one
--anagram in the list; report the anagram‑group size.
WITH RECURSIVE
  letters(word, idx, ch) AS (
        SELECT words, 1, substr(words,1,1)
        FROM word_list
     UNION ALL
        SELECT word,
               idx+1,
               substr(word, idx+1, 1)
        FROM letters
        WHERE idx+1 <= length(word)
  ),
  ordered_letters AS (
        SELECT word, ch
        FROM letters
        ORDER BY word, ch
  ),
  signatures AS (
        SELECT word,
               group_concat(ch,'') AS signature,
               length(word) AS len
        FROM ordered_letters
        GROUP BY word
  ),
  sig_counts AS (
        SELECT signature, len, COUNT(*) AS anagram_count
        FROM signatures
        GROUP BY signature, len
        HAVING anagram_count > 1
  )
SELECT s.word,
       sc.anagram_count
FROM   signatures AS s
JOIN   sig_counts  AS sc
       ON s.signature = sc.signature
      AND s.len       = sc.len
WHERE  s.len BETWEEN 4 AND 5
  AND  s.word GLOB 'r*'
ORDER BY s.word
LIMIT 10
