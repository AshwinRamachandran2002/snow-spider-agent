Query:
--Description: Show every letter‑sorted “signature” that belongs to more than
--one distinct word (i.e. has real anagrams) together with its anagram‑count;
--limited to 20 rows for inspection.
WITH RECURSIVE
  letters(word, idx, ch) AS (                           -- explode words
        SELECT words, 1, substr(words,1,1)
        FROM word_list
     UNION ALL
        SELECT word,
               idx+1,
               substr(word, idx+1, 1)
        FROM letters
        WHERE idx+1 <= length(word)
  ),
  ordered_letters AS (                                  -- alphabetise letters
        SELECT word, ch
        FROM letters
        ORDER BY word, ch
  ),
  signatures AS (                                       -- build signature
        SELECT word,
               group_concat(ch,'') AS signature
        FROM ordered_letters
        GROUP BY word
  )
SELECT signature,
       COUNT(*) AS cnt_anagrams
FROM signatures
GROUP BY signature
HAVING cnt_anagrams > 1
LIMIT 20
