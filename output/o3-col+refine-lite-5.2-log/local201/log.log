Below are a sequence of exploratory SQL statements – from simple inspection to the final solution – that together identify the first ten (alphabetically) 4‑ to 5‑letter words beginning with “r” which possess at least one anagram of the same length.  For every such word we also return the total number of anagrams (including the word itself).

```sql
-- 1. Quick peek at the raw word list
SELECT DISTINCT "words"
FROM "word_list"
LIMIT 20;
```

```sql
-- 2. Words whose length is 4–5 characters and that start with lower‑case 'r'
SELECT DISTINCT "words"
FROM "word_list"
WHERE length("words") BETWEEN 4 AND 5
  AND "words" GLOB 'r*'
LIMIT 20;
```

```sql
-- 3. Break every word into one row per letter (recursive CTE)
WITH RECURSIVE letters(word, pos, ch, len) AS (
  SELECT w."words", 1,
         substr(w."words",1,1),
         length(w."words")
  FROM "word_list" AS w
  UNION ALL
  SELECT word,
         pos+1,
         substr(word,pos+1,1),
         len
  FROM letters
  WHERE pos+1 <= len
)
SELECT *
FROM letters
LIMIT 20;
```

```sql
-- 4. For every word, build a “signature” = its letters sorted alphabetically
WITH RECURSIVE letters(word, ch) AS (
  SELECT w."words", substr(w."words",1,1)
  FROM "word_list" AS w
  UNION ALL
  SELECT word,
         substr(word, length(ch)+1, 1)
  FROM letters
  WHERE length(ch) < length(word)
),
signatures AS (
  SELECT word,
         group_concat(ch, '' ORDER BY ch) AS signature   -- canonical form
  FROM letters
  GROUP BY word
)
SELECT *
FROM signatures
LIMIT 20;
```

```sql
-- 5. Keep only signatures that occur more than once (=> anagrams exist)
WITH RECURSIVE letters(word, ch) AS (
  SELECT w."words", substr(w."words",1,1)
  FROM "word_list" AS w
  UNION ALL
  SELECT word,
         substr(word, length(ch)+1, 1)
  FROM letters
  WHERE length(ch) < length(word)
),
signatures AS (
  SELECT word,
         group_concat(ch, '' ORDER BY ch) AS signature
  FROM letters
  GROUP BY word
)
SELECT signature, COUNT(*) AS cnt_anagrams
FROM signatures
GROUP BY signature
HAVING cnt_anagrams > 1
LIMIT 20;
```

```sql
-- 6. Join words to the qualifying signatures, restrict to r**** (4–5 chars)
WITH RECURSIVE letters(word, ch) AS (
  SELECT w."words", substr(w."words",1,1)
  FROM "word_list" AS w
  UNION ALL
  SELECT word,
         substr(word, length(ch)+1, 1)
  FROM letters
  WHERE length(ch) < length(word)
),
signatures AS (
  SELECT word,
         group_concat(ch, '' ORDER BY ch) AS signature
  FROM letters
  GROUP BY word
),
anagram_groups AS (
  SELECT signature, COUNT(*) AS total_words
  FROM signatures
  GROUP BY signature
  HAVING total_words > 1
)
SELECT s.word, ag.total_words AS anagrams
FROM signatures AS s
JOIN anagram_groups AS ag
     ON s.signature = ag.signature
WHERE length(s.word) BETWEEN 4 AND 5
  AND s.word GLOB 'r*'
LIMIT 20;
```

```sql
-- 7. Final answer: first 10 alphabetically with the anagram count
WITH RECURSIVE letters(word, ch) AS (
  SELECT w."words", substr(w."words",1,1)
  FROM "word_list" AS w
  UNION ALL
  SELECT word,
         substr(word, length(ch)+1, 1)
  FROM letters
  WHERE length(ch) < length(word)
),
signatures AS (
  SELECT word,
         group_concat(ch, '' ORDER BY ch) AS signature
  FROM letters
  GROUP BY word
),
anagram_groups AS (
  SELECT signature, COUNT(*) AS total_words
  FROM signatures
  GROUP BY signature
  HAVING total_words > 1
)
SELECT s.word,
       ag.total_words AS anagram_count          -- includes the word itself
FROM signatures AS s
JOIN anagram_groups AS ag
     ON s.signature = ag.signature
WHERE length(s.word) BETWEEN 4 AND 5
  AND s.word GLOB 'r*'
ORDER BY s.word
LIMIT 10;
```

The last query returns the desired list of up to ten qualifying words, each accompanied by how many anagrams (of identical length and letter‑multiset) exist for that word in the `word_list` table.
