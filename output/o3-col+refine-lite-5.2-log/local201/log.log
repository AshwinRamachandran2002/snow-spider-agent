-- 3. Break every word into one row per letter (recursive CTE)
WITH RECURSIVE letters(word, pos, ch, len) AS (
  SELECT w."words", 1,
         substr(w."words",1,1),
         length(w."words")
  FROM "word_list" AS w
  UNION ALL
  SELECT word,
         pos+1,
         substr(word,pos+1,1),
         len
  FROM letters
  WHERE pos+1 <= len
)
SELECT *
FROM letters
LIMIT 20;
