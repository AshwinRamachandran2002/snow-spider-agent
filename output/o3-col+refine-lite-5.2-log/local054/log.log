```sql
-- 2) Description: view some invoice items together with the artist that each track belongs to
SELECT ii."InvoiceLineId",
       ii."UnitPrice",
       ii."Quantity",
       t."TrackId",
       al."AlbumId",
       ar."ArtistId",
       ar."Name"
FROM   "invoice_items" AS ii
       JOIN "tracks"  AS t  ON ii."TrackId" = t."TrackId"
       JOIN "albums"  AS al ON t."AlbumId"  = al."AlbumId"
       JOIN "artists" AS ar ON al."ArtistId" = ar."ArtistId"
LIMIT  20;
```

```sql
-- 3) Description: aggregate total revenue per artist
SELECT ar."ArtistId",
       ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Revenue"
FROM   "invoice_items" AS ii
       JOIN "tracks"  AS t  ON ii."TrackId" = t."TrackId"
       JOIN "albums"  AS al ON t."AlbumId"  = al."AlbumId"
       JOIN "artists" AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId",
          ar."Name"
ORDER  BY "Revenue" DESC
LIMIT  20;
```

```sql
-- 4) Description: find the single best‑selling artist (highest revenue)
SELECT ar."ArtistId",
       ar."Name"
FROM  (SELECT ar."ArtistId",
              ar."Name",
              SUM(ii."UnitPrice" * ii."Quantity") AS "Revenue"
       FROM   "invoice_items" AS ii
              JOIN "tracks"  AS t  ON ii."TrackId" = t."TrackId"
              JOIN "albums"  AS al ON t."AlbumId"  = al."AlbumId"
              JOIN "artists" AS ar ON al."ArtistId" = ar."ArtistId"
       GROUP  BY ar."ArtistId",
                 ar."Name"
       ORDER  BY "Revenue" DESC
       LIMIT  1);
```

```sql
-- 5) Description: compute how much every customer spent on tracks by the best‑selling artist
SELECT c."CustomerId",
       c."FirstName",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Spend"
FROM   "customers" AS c
       JOIN "invoices"      AS inv ON c."CustomerId" = inv."CustomerId"
       JOIN "invoice_items" AS ii  ON inv."InvoiceId" = ii."InvoiceId"
       JOIN "tracks"        AS t   ON ii."TrackId"   = t."TrackId"
       JOIN "albums"        AS al  ON t."AlbumId"    = al."AlbumId"
       JOIN "artists"       AS ar  ON al."ArtistId"  = ar."ArtistId"
WHERE  ar."ArtistId" = (
       SELECT ar2."ArtistId"
       FROM  (SELECT ar2."ArtistId",
                     SUM(ii2."UnitPrice" * ii2."Quantity") AS "Revenue"
              FROM   "invoice_items" AS ii2
                     JOIN "tracks"  AS t2  ON ii2."TrackId" = t2."TrackId"
                     JOIN "albums"  AS al2 ON t2."AlbumId"  = al2."AlbumId"
                     JOIN "artists" AS ar2 ON al2."ArtistId" = ar2."ArtistId"
              GROUP  BY ar2."ArtistId"
              ORDER  BY "Revenue" DESC
              LIMIT  1)
)
GROUP  BY c."CustomerId",
          c."FirstName"
LIMIT  20;
```

```sql
-- 6) Description: keep only those customers whose spending on that artist is less than $1
SELECT c."FirstName",
       ROUND(SUM(ii."UnitPrice" * ii."Quantity"), 2) AS "AmountSpent"
FROM   "customers" AS c
       JOIN "invoices"      AS inv ON c."CustomerId" = inv."CustomerId"
       JOIN "invoice_items" AS ii  ON inv."InvoiceId" = ii."InvoiceId"
       JOIN "tracks"        AS t   ON ii."TrackId"   = t."TrackId"
       JOIN "albums"        AS al  ON t."AlbumId"    = al."AlbumId"
       JOIN "artists"       AS ar  ON al."ArtistId"  = ar."ArtistId"
WHERE  ar."ArtistId" = (
       SELECT ar2."ArtistId"
       FROM  (SELECT ar2."ArtistId",
                     SUM(ii2."UnitPrice" * ii2."Quantity") AS "Revenue"
              FROM   "invoice_items" AS ii2
                     JOIN "tracks"  AS t2  ON ii2."TrackId" = t2."TrackId"
                     JOIN "albums"  AS al2 ON t2."AlbumId"  = al2."AlbumId"
                     JOIN "artists" AS ar2 ON al2."ArtistId" = ar2."ArtistId"
              GROUP  BY ar2."ArtistId"
              ORDER  BY "Revenue" DESC
              LIMIT  1)
)
GROUP  BY c."CustomerId",
          c."FirstName"
HAVING SUM(ii."UnitPrice" * ii."Quantity") < 1
ORDER  BY "AmountSpent" DESC
LIMIT  20;
```

