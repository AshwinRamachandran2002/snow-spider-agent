--Description / Thinking process:
-- 1) Begin with "invoice_items" to access every sold track and its price × quantity (revenue).
-- 2) JOIN "tracks"  → to know which album each track belongs to.
-- 3) JOIN "albums"  → to identify the artist who released that album.
-- 4) JOIN "artists" → to fetch the artist’s name.
-- 5) GROUP BY artist so we can add up total revenue per artist.
-- 6) ORDER BY the summed revenue in descending order so the top row is the best‑selling artist.
-- 7) LIMIT 1 returns exactly that top artist (the single best‑selling one).
SELECT ar."ArtistId",
       ar."Name",
       SUM(ii."UnitPrice" * ii."Quantity") AS "Revenue"
FROM   "invoice_items" AS ii
       JOIN "tracks"  AS t  ON ii."TrackId" = t."TrackId"
       JOIN "albums"  AS al ON t."AlbumId"  = al."AlbumId"
       JOIN "artists" AS ar ON al."ArtistId" = ar."ArtistId"
GROUP  BY ar."ArtistId",
          ar."Name"
ORDER  BY "Revenue" DESC
LIMIT  1;
