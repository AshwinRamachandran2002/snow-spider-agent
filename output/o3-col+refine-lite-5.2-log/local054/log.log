              JOIN "artists" AS ar2 ON al2."ArtistId" = ar2."ArtistId"
       GROUP  BY ar2."ArtistId"
       ORDER  BY SUM(ii2."UnitPrice" * ii2."Quantity") DESC
       LIMIT  1)
GROUP  BY c."CustomerId",
          c."FirstName"
HAVING SUM(ii."UnitPrice" * ii."Quantity") < 1
ORDER  BY "AmountSpent" DESC
LIMIT  20;
