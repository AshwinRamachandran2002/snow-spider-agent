-- 2. How many points did every driver score in each season?  
--   (sum over all races in the season)
SELECT ra."year",
       r."driver_id",
       SUM(r."points") AS driver_pts
FROM   "results" AS r
JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
WHERE  ra."year" >= 2001
GROUP  BY ra."year", r."driver_id"
ORDER  BY ra."year", driver_pts
LIMIT 20;
