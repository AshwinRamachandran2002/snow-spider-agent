```sql
-- 1. Preview race–result rows (since 2001) to see main columns we will need
SELECT DISTINCT r."race_id", ra."year", r."driver_id", r."constructor_id", r."points"
FROM "results" AS r
JOIN "races"   AS ra ON ra."race_id" = r."race_id"
WHERE ra."year" >= 2001
LIMIT 20;
```

```sql
-- 2. How many points did every driver score in each season?  
--   (sum over all races in the season)
SELECT ra."year",
       r."driver_id",
       SUM(r."points") AS driver_pts
FROM   "results" AS r
JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
WHERE  ra."year" >= 2001
GROUP  BY ra."year", r."driver_id"
ORDER  BY ra."year", driver_pts
LIMIT 20;
```

```sql
-- 3. For every season, find the fewest points among point‑scoring drivers (> 0).
WITH driver_tot AS (
  SELECT ra."year",
         r."driver_id",
         SUM(r."points") AS driver_pts
  FROM   "results" AS r
  JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
  WHERE  ra."year" >= 2001
  GROUP  BY ra."year", r."driver_id"
  HAVING driver_pts > 0
)
SELECT d."year",
       MIN(d."driver_pts") AS min_pts_in_season
FROM   driver_tot AS d
GROUP  BY d."year"
ORDER  BY d."year"
LIMIT 20;
```

```sql
-- 4. List the drivers that had the seasonal minimum in each year (since 2001).
WITH driver_tot AS (
  SELECT ra."year",
         r."driver_id",
         SUM(r."points") AS driver_pts
  FROM   "results" AS r
  JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
  WHERE  ra."year" >= 2001
  GROUP  BY ra."year", r."driver_id"
  HAVING driver_pts > 0
),
min_pts AS (
  SELECT d."year", MIN(d."driver_pts") AS min_pts_in_season
  FROM   driver_tot AS d
  GROUP  BY d."year"
)
SELECT dt."year",
       dt."driver_id",
       dt."driver_pts"
FROM   driver_tot AS dt
JOIN   min_pts   AS mp ON mp."year" = dt."year"
                      AND mp."min_pts_in_season" = dt."driver_pts"
ORDER  BY dt."year"
LIMIT 20;
```

```sql
-- 5. Associate each (year, driver) pair above with the constructor
--    for which that driver scored the majority of his points that season.
WITH driver_const_pts AS (
  SELECT ra."year",
         r."driver_id",
         r."constructor_id",
         SUM(r."points") AS pts_for_team
  FROM   "results" AS r
  JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
  WHERE  ra."year" >= 2001
  GROUP  BY ra."year", r."driver_id", r."constructor_id"
),
primary_team AS (       -- pick constructor with max points for that driver/season
  SELECT dcp."year",
         dcp."driver_id",
         dcp."constructor_id"
  FROM   driver_const_pts AS dcp
  WHERE  dcp."pts_for_team" = (
      SELECT MAX(pts_for_team)
      FROM   driver_const_pts AS x
      WHERE  x."year"       = dcp."year"
      AND    x."driver_id"  = dcp."driver_id")
),
driver_tot AS (
  SELECT ra."year",
         r."driver_id",
         SUM(r."points") AS driver_pts
  FROM   "results" AS r
  JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
  WHERE  ra."year" >= 2001
  GROUP  BY ra."year", r."driver_id"
  HAVING driver_pts > 0
),
min_pts AS (
  SELECT d."year", MIN(d."driver_pts") AS min_pts_in_season
  FROM   driver_tot AS d
  GROUP  BY d."year"
)
SELECT pt."year",
       pt."constructor_id",
       dt."driver_id",
       dt."driver_pts"
FROM   driver_tot   AS dt
JOIN   min_pts      AS mp ON mp."year" = dt."year"
                         AND mp."min_pts_in_season" = dt."driver_pts"
JOIN   primary_team AS pt ON pt."year" = dt."year"
                         AND pt."driver_id" = dt."driver_id"
ORDER  BY pt."year"
LIMIT 20;
```

```sql
-- 6. Get constructor names for readability
SELECT c."constructor_id", c."name"
FROM   "constructors" AS c
WHERE  c."constructor_id" IN (
  SELECT DISTINCT "constructor_id"
  FROM   "results"
)
ORDER BY c."constructor_id"
LIMIT 20;
```

```sql
-- 7. Count how many seasons each constructor appears in the
--    "fewest points" list produced in step 5.
WITH fewest_team AS (
  /* query from step 5 without the final ORDER/LIMIT */
  WITH driver_const_pts AS (
    SELECT ra."year", r."driver_id", r."constructor_id",
           SUM(r."points") AS pts_for_team
    FROM   "results" AS r
    JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
    WHERE  ra."year" >= 2001
    GROUP  BY ra."year", r."driver_id", r."constructor_id"
  ),
  primary_team AS (
    SELECT dcp."year", dcp."driver_id", dcp."constructor_id"
    FROM   driver_const_pts AS dcp
    WHERE  dcp."pts_for_team" = (
      SELECT MAX(pts_for_team)
      FROM   driver_const_pts AS x
      WHERE  x."year"      = dcp."year"
      AND    x."driver_id" = dcp."driver_id")
  ),
  driver_tot AS (
    SELECT ra."year", r."driver_id",
           SUM(r."points") AS driver_pts
    FROM   "results" AS r
    JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
    WHERE  ra."year" >= 2001
    GROUP  BY ra."year", r."driver_id"
    HAVING driver_pts > 0
  ),
  min_pts AS (
    SELECT d."year", MIN(d."driver_pts") AS min_pts_in_season
    FROM   driver_tot AS d
    GROUP  BY d."year"
  )
  SELECT pt."year", pt."constructor_id"
  FROM   driver_tot   AS dt
  JOIN   min_pts      AS mp ON mp."year" = dt."year"
                           AND mp."min_pts_in_season" = dt."driver_pts"
  JOIN   primary_team AS pt ON pt."year" = dt."year"
                           AND pt."driver_id" = dt."driver_id"
)
SELECT ft."constructor_id",
       c."name",
       COUNT(DISTINCT ft."year") AS seasons_with_fewest_pts_driver
FROM   fewest_team AS ft
JOIN   "constructors" AS c ON c."constructor_id" = ft."constructor_id"
GROUP  BY ft."constructor_id", c."name"
ORDER  BY seasons_with_fewest_pts_driver DESC
LIMIT 20;
```

```sql
-- 8. Finally, return the top‑5 constructors who most often
--    owned the driver with the fewest points in a season (since 2001).
WITH fewest_team AS (
  /* same CTE block as in query 7 */
  WITH driver_const_pts AS (
    SELECT ra."year", r."driver_id", r."constructor_id",
           SUM(r."points") AS pts_for_team
    FROM   "results" AS r
    JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
    WHERE  ra."year" >= 2001
    GROUP  BY ra."year", r."driver_id", r."constructor_id"
  ),
  primary_team AS (
    SELECT dcp."year", dcp."driver_id", dcp."constructor_id"
    FROM   driver_const_pts AS dcp
    WHERE  dcp."pts_for_team" = (
      SELECT MAX(pts_for_team)
      FROM   driver_const_pts AS x
      WHERE  x."year"      = dcp."year"
      AND    x."driver_id" = dcp."driver_id")
  ),
  driver_tot AS (
    SELECT ra."year", r."driver_id",
           SUM(r."points") AS driver_pts
    FROM   "results" AS r
    JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
    WHERE  ra."year" >= 2001
    GROUP  BY ra."year", r."driver_id"
    HAVING driver_pts > 0
  ),
  min_pts AS (
    SELECT d."year", MIN(d."driver_pts") AS min_pts_in_season
    FROM   driver_tot AS d
    GROUP  BY d."year"
  )
  SELECT pt."year", pt."constructor_id"
  FROM   driver_tot   AS dt
  JOIN   min_pts      AS mp ON mp."year" = dt."year"
                           AND mp."min_pts_in_season" = dt."driver_pts"
  JOIN   primary_team AS pt ON pt."year" = dt."year"
                           AND pt."driver_id" = dt."driver_id"
)
SELECT c."name"                AS constructor,
       COUNT(DISTINCT ft."year") AS seasons_with_least_pts_driver
FROM   fewest_team AS ft
JOIN   "constructors" AS c ON c."constructor_id" = ft."constructor_id"
GROUP  BY c."name"
ORDER  BY seasons_with_least_pts_driver DESC,
         constructor
LIMIT 5;
```

