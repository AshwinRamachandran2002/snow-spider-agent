Query:
-- 3. For every season, find the fewest points among point‑scoring drivers (> 0).
WITH driver_tot AS (
  SELECT ra."year",
         r."driver_id",
         SUM(r."points") AS driver_pts
  FROM   "results" AS r
  JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
  WHERE  ra."year" >= 2001
  GROUP  BY ra."year", r."driver_id"
  HAVING driver_pts > 0
)
SELECT d."year",
       MIN(d."driver_pts") AS min_pts_in_season
FROM   driver_tot AS d
GROUP  BY d."year"
ORDER  BY d."year"
LIMIT 20;
