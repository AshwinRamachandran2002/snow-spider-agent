Query:
-- 5. Associate each (year, driver) pair above with the constructor
--    for which that driver scored the majority of his points that season.
WITH driver_const_pts AS (
  SELECT ra."year",
         r."driver_id",
         r."constructor_id",
         SUM(r."points") AS pts_for_team
  FROM   "results" AS r
  JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
  WHERE  ra."year" >= 2001
  GROUP  BY ra."year", r."driver_id", r."constructor_id"
),
primary_team AS (       -- pick constructor with max points for that driver/season
  SELECT dcp."year",
         dcp."driver_id",
         dcp."constructor_id"
  FROM   driver_const_pts AS dcp
  WHERE  dcp."pts_for_team" = (
      SELECT MAX(pts_for_team)
      FROM   driver_const_pts AS x
      WHERE  x."year"       = dcp."year"
      AND    x."driver_id"  = dcp."driver_id")
),
driver_tot AS (
  SELECT ra."year",
         r."driver_id",
         SUM(r."points") AS driver_pts
  FROM   "results" AS r
  JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
  WHERE  ra."year" >= 2001
  GROUP  BY ra."year", r."driver_id"
  HAVING driver_pts > 0
),
min_pts AS (
  SELECT d."year", MIN(d."driver_pts") AS min_pts_in_season
  FROM   driver_tot AS d
  GROUP  BY d."year"
)
SELECT pt."year",
       pt."constructor_id",
       dt."driver_id",
       dt."driver_pts"
FROM   driver_tot   AS dt
JOIN   min_pts      AS mp ON mp."year" = dt."year"
                         AND mp."min_pts_in_season" = dt."driver_pts"
JOIN   primary_team AS pt ON pt."year" = dt."year"
                         AND pt."driver_id" = dt."driver_id"
ORDER  BY pt."year"
LIMIT 20;
