Query:
-- 8. Finally, return the top‑5 constructors who most often
--    owned the driver with the fewest points in a season (since 2001).
WITH fewest_team AS (
  /* same CTE block as in query 7 */
  WITH driver_const_pts AS (
    SELECT ra."year", r."driver_id", r."constructor_id",
           SUM(r."points") AS pts_for_team
    FROM   "results" AS r
    JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
    WHERE  ra."year" >= 2001
    GROUP  BY ra."year", r."driver_id", r."constructor_id"
  ),
  primary_team AS (
    SELECT dcp."year", dcp."driver_id", dcp."constructor_id"
    FROM   driver_const_pts AS dcp
    WHERE  dcp."pts_for_team" = (
      SELECT MAX(pts_for_team)
      FROM   driver_const_pts AS x
      WHERE  x."year"      = dcp."year"
      AND    x."driver_id" = dcp."driver_id")
  ),
  driver_tot AS (
    SELECT ra."year", r."driver_id",
           SUM(r."points") AS driver_pts
    FROM   "results" AS r
    JOIN   "races"   AS ra ON ra."race_id" = r."race_id"
    WHERE  ra."year" >= 2001
    GROUP  BY ra."year", r."driver_id"
    HAVING driver_pts > 0
  ),
  min_pts AS (
    SELECT d."year", MIN(d."driver_pts") AS min_pts_in_season
    FROM   driver_tot AS d
    GROUP  BY d."year"
  )
  SELECT pt."year", pt."constructor_id"
  FROM   driver_tot   AS dt
  JOIN   min_pts      AS mp ON mp."year" = dt."year"
                           AND mp."min_pts_in_season" = dt."driver_pts"
  JOIN   primary_team AS pt ON pt."year" = dt."year"
                           AND pt."driver_id" = dt."driver_id"
)
SELECT c."name"                AS constructor,
       COUNT(DISTINCT ft."year") AS seasons_with_least_pts_driver
FROM   fewest_team AS ft
JOIN   "constructors" AS c ON c."constructor_id" = ft."constructor_id"
GROUP  BY c."name"
ORDER  BY seasons_with_least_pts_driver DESC,
         constructor
LIMIT 5;
