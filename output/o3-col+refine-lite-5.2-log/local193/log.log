```sql
--Description: For each customer, locate the exact timestamp of their very first purchase.
SELECT DISTINCT p."customer_id",
                MIN(p."payment_date") AS "first_payment_date"
FROM "payment" AS p
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--Description: Calculate every customer’s total lifetime value (sum of all payments).
SELECT DISTINCT p."customer_id",
                SUM(p."amount") AS "total_ltv"
FROM "payment" AS p
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--Description: Compute each customer’s LTV that accrued within the first 7 × 24 hours after their initial purchase.
SELECT DISTINCT p."customer_id",
                SUM(CASE
                      WHEN p."payment_date"
                           <= datetime(fp."first_payment_date", '+7 days')
                      THEN p."amount"
                    END) AS "ltv_7d"
FROM "payment" AS p
JOIN (
        SELECT "customer_id",
               MIN("payment_date") AS "first_payment_date"
        FROM "payment"
        GROUP BY "customer_id"
     ) AS fp
     ON fp."customer_id" = p."customer_id"
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--Description: Compute each customer’s LTV that accrued within the first 30 × 24 hours after their initial purchase.
SELECT DISTINCT p."customer_id",
                SUM(CASE
                      WHEN p."payment_date"
                           <= datetime(fp."first_payment_date", '+30 days')
                      THEN p."amount"
                    END) AS "ltv_30d"
FROM "payment" AS p
JOIN (
        SELECT "customer_id",
               MIN("payment_date") AS "first_payment_date"
        FROM "payment"
        GROUP BY "customer_id"
     ) AS fp
     ON fp."customer_id" = p."customer_id"
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--Description: Assemble per‑customer percentages of LTV captured in the first 7 and 30 days, excluding anyone whose lifetime sales equal zero.
WITH first_purchase AS (
       SELECT "customer_id",
              MIN("payment_date") AS "first_payment_date"
       FROM "payment"
       GROUP BY "customer_id"
),
ltv_window AS (
       SELECT p."customer_id",
              SUM(p."amount")                                                         AS "total_ltv",
              SUM(CASE WHEN p."payment_date" <= datetime(fp."first_payment_date", '+7 days')
                       THEN p."amount" END)                                           AS "ltv_7d",
              SUM(CASE WHEN p."payment_date" <= datetime(fp."first_payment_date", '+30 days')
                       THEN p."amount" END)                                           AS "ltv_30d"
       FROM  "payment" AS p
       JOIN  first_purchase  AS fp
             ON fp."customer_id" = p."customer_id"
       GROUP BY p."customer_id"
),
pct_table AS (
       SELECT "customer_id",
              "total_ltv",
              100.0 * "ltv_7d"  / "total_ltv"                                         AS "pct_7d",
              100.0 * "ltv_30d" / "total_ltv"                                         AS "pct_30d"
       FROM   ltv_window
       WHERE  "total_ltv" > 0
)
SELECT DISTINCT * 
FROM pct_table
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – average percentage of LTV earned in the first 7 & 30 days and the average total LTV (customers with zero sales are excluded).
WITH first_purchase AS (
       SELECT "customer_id",
              MIN("payment_date") AS "first_payment_date"
       FROM "payment"
       GROUP BY "customer_id"
),
ltv_window AS (
       SELECT p."customer_id",
              SUM(p."amount")                                                         AS "total_ltv",
              SUM(CASE WHEN p."payment_date" <= datetime(fp."first_payment_date", '+7 days')
                       THEN p."amount" END)                                           AS "ltv_7d",
              SUM(CASE WHEN p."payment_date" <= datetime(fp."first_payment_date", '+30 days')
                       THEN p."amount" END)                                           AS "ltv_30d"
       FROM  "payment" AS p
       JOIN  first_purchase  AS fp
             ON fp."customer_id" = p."customer_id"
       GROUP BY p."customer_id"
),
pct_table AS (
       SELECT "customer_id",
              "total_ltv",
              100.0 * "ltv_7d"  / "total_ltv"                                         AS "pct_7d",
              100.0 * "ltv_30d" / "total_ltv"                                         AS "pct_30d"
       FROM   ltv_window
       WHERE  "total_ltv" > 0
)
SELECT AVG("pct_7d")   AS "avg_pct_first_7_days",
       AVG("pct_30d")  AS "avg_pct_first_30_days",
       AVG("total_ltv") AS "avg_total_lifetime_sales"
FROM pct_table
LIMIT 20;   -- only one row will be returned
```
