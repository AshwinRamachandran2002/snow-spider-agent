Query:
-- 8) For every match, pull the single over that had the MOST total runs,
--    along with the bowler who delivered it
WITH over_totals AS (
        SELECT "match_id",
               "innings_no",
               "over_id",
               SUM("run_component") AS "total_runs"
        FROM (
                SELECT "match_id", "innings_no", "over_id", SUM("runs_scored") AS "run_component"
                FROM "batsman_scored"
                GROUP BY "match_id", "innings_no", "over_id"
                UNION ALL
                SELECT "match_id", "innings_no", "over_id", SUM("extra_runs")
                FROM "extra_runs"
                GROUP BY "match_id", "innings_no", "over_id"
        )
        GROUP BY "match_id", "innings_no", "over_id"
), max_per_match AS (
        SELECT "match_id",
               MAX("total_runs") AS "max_runs"
        FROM over_totals
        GROUP BY "match_id"
)
SELECT m."match_id",
       o."innings_no",
       o."over_id",
       m."max_runs"   AS "highest_over_runs",
       (SELECT "bowler"
        FROM "ball_by_ball" AS bb
        WHERE bb."match_id"   = o."match_id"
          AND bb."innings_no" = o."innings_no"
          AND bb."over_id"    = o."over_id"
        LIMIT 1)              AS "bowler_id"
FROM max_per_match AS m
JOIN over_totals  AS o
  ON o."match_id"  = m."match_id"
 AND o."total_runs" = m."max_runs"
-- If several overs tie for the same max, keep the FIRST one found
GROUP BY m."match_id"
LIMIT 20;
