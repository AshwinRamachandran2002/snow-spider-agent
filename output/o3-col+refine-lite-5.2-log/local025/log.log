WITH over_totals AS (
        SELECT "match_id",
               "innings_no",
               "over_id",
               SUM("run_component") AS "total_runs"
        FROM (
                SELECT "match_id", "innings_no", "over_id", SUM("runs_scored") AS "run_component"
                FROM "batsman_scored"
                GROUP BY "match_id", "innings_no", "over_id"
                UNION ALL
                SELECT "match_id", "innings_no", "over_id", SUM("extra_runs")
                FROM "extra_runs"
                GROUP BY "match_id", "innings_no", "over_id"
        )
        GROUP BY "match_id", "innings_no", "over_id"
), max_per_match AS (
        SELECT "match_id",
               MAX("total_runs") AS "max_runs"
        FROM over_totals
        GROUP BY "match_id"
)
SELECT AVG("max_runs") AS "average_highest_over_runs"
FROM max_per_match;
