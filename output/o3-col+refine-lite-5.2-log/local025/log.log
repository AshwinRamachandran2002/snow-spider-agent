```sql
-- 1) Quick look at a few matches that exist in the data
SELECT DISTINCT "match_id", "team_1", "team_2", "match_date"
FROM "match"
LIMIT 20;
```

```sql
-- 2) Inspect a handful of rows from batsman_scored (runs off the bat)
SELECT DISTINCT "match_id", "innings_no", "over_id", "ball_id", "runs_scored"
FROM "batsman_scored"
LIMIT 20;
```

```sql
-- 3) Inspect a handful of rows from extra_runs (wides, no‑balls, leg‑byes etc.)
SELECT DISTINCT "match_id", "innings_no", "over_id", "ball_id", "extra_type", "extra_runs"
FROM "extra_runs"
LIMIT 20;
```

```sql
-- 4) Aggregate ONLY the batsman runs per over (match + innings + over)
SELECT "match_id",
       "innings_no",
       "over_id",
       SUM("runs_scored") AS "batsman_runs"
FROM "batsman_scored"
GROUP BY "match_id", "innings_no", "over_id"
LIMIT 20;
```

```sql
-- 5) Aggregate ONLY the extra runs per over (match + innings + over)
SELECT "match_id",
       "innings_no",
       "over_id",
       SUM("extra_runs") AS "extra_runs"
FROM "extra_runs"
GROUP BY "match_id", "innings_no", "over_id"
LIMIT 20;
```

```sql
-- 6) Combine batsman + extra runs to get TOTAL runs in every over
SELECT "match_id",
       "innings_no",
       "over_id",
       SUM("run_component") AS "total_runs"
FROM (
        SELECT "match_id", "innings_no", "over_id", SUM("runs_scored") AS "run_component"
        FROM "batsman_scored"
        GROUP BY "match_id", "innings_no", "over_id"
        UNION ALL
        SELECT "match_id", "innings_no", "over_id", SUM("extra_runs")  AS "run_component"
        FROM "extra_runs"
        GROUP BY "match_id", "innings_no", "over_id"
     )
GROUP BY "match_id", "innings_no", "over_id"
LIMIT 20;
```

```sql
-- 7) Add the bowler who delivered the over (take first record for that over)
WITH over_totals AS (
        SELECT "match_id",
               "innings_no",
               "over_id",
               SUM("run_component") AS "total_runs"
        FROM (
                SELECT "match_id", "innings_no", "over_id", SUM("runs_scored") AS "run_component"
                FROM "batsman_scored"
                GROUP BY "match_id", "innings_no", "over_id"
                UNION ALL
                SELECT "match_id", "innings_no", "over_id", SUM("extra_runs")
                FROM "extra_runs"
                GROUP BY "match_id", "innings_no", "over_id"
        )
        GROUP BY "match_id", "innings_no", "over_id"
)
SELECT o."match_id",
       o."innings_no",
       o."over_id",
       o."total_runs",
       (SELECT "bowler"
        FROM "ball_by_ball" AS bb
        WHERE bb."match_id"   = o."match_id"
          AND bb."innings_no" = o."innings_no"
          AND bb."over_id"    = o."over_id"
        LIMIT 1) AS "bowler_id"
FROM over_totals AS o
LIMIT 20;
```

```sql
-- 8) For every match, pull the single over that had the MOST total runs,
--    along with the bowler who delivered it
WITH over_totals AS (
        SELECT "match_id",
               "innings_no",
               "over_id",
               SUM("run_component") AS "total_runs"
        FROM (
                SELECT "match_id", "innings_no", "over_id", SUM("runs_scored") AS "run_component"
                FROM "batsman_scored"
                GROUP BY "match_id", "innings_no", "over_id"
                UNION ALL
                SELECT "match_id", "innings_no", "over_id", SUM("extra_runs")
                FROM "extra_runs"
                GROUP BY "match_id", "innings_no", "over_id"
        )
        GROUP BY "match_id", "innings_no", "over_id"
), max_per_match AS (
        SELECT "match_id",
               MAX("total_runs") AS "max_runs"
        FROM over_totals
        GROUP BY "match_id"
)
SELECT m."match_id",
       o."innings_no",
       o."over_id",
       m."max_runs"   AS "highest_over_runs",
       (SELECT "bowler"
        FROM "ball_by_ball" AS bb
        WHERE bb."match_id"   = o."match_id"
          AND bb."innings_no" = o."innings_no"
          AND bb."over_id"    = o."over_id"
        LIMIT 1)              AS "bowler_id"
FROM max_per_match AS m
JOIN over_totals  AS o
  ON o."match_id"  = m."match_id"
 AND o."total_runs" = m."max_runs"
-- If several overs tie for the same max, keep the FIRST one found
GROUP BY m."match_id"
LIMIT 20;
```

```sql
-- 9) Finally, calculate the average of those “highest‑run overs” across ALL matches
WITH over_totals AS (
        SELECT "match_id",
               "innings_no",
               "over_id",
               SUM("run_component") AS "total_runs"
        FROM (
                SELECT "match_id", "innings_no", "over_id", SUM("runs_scored") AS "run_component"
                FROM "batsman_scored"
                GROUP BY "match_id", "innings_no", "over_id"
                UNION ALL
                SELECT "match_id", "innings_no", "over_id", SUM("extra_runs")
                FROM "extra_runs"
                GROUP BY "match_id", "innings_no", "over_id"
        )
        GROUP BY "match_id", "innings_no", "over_id"
), max_per_match AS (
        SELECT "match_id",
               MAX("total_runs") AS "max_runs"
        FROM over_totals
        GROUP BY "match_id"
)
SELECT AVG("max_runs") AS "average_highest_over_runs"
FROM max_per_match;
```
