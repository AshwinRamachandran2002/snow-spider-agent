```sql
--Description: Compute purchase‑revenue per (user, session) across Nov 2020  
SELECT `user_pseudo_id`,
       ep.`value`.int_value                          AS `ga_session_id`,
       SUM(`ecommerce`.`purchase_revenue_in_usd`)    AS `session_revenue_usd`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
     UNNEST(`event_params`) AS ep
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND `event_name` = 'purchase'
  AND ep.`key` = 'ga_session_id'
  AND `ecommerce`.`purchase_revenue_in_usd` IS NOT NULL
GROUP BY `user_pseudo_id`, `ga_session_id`
LIMIT 20;
```

```sql
--Description: Find users who have more than one purchase session in Nov 2020  
WITH session_revenue AS (
  SELECT `user_pseudo_id`,
         ep.`value`.int_value                       AS `ga_session_id`
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(`event_params`) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND `event_name` = 'purchase'
    AND ep.`key` = 'ga_session_id'
    AND `ecommerce`.`purchase_revenue_in_usd` IS NOT NULL
  GROUP BY `user_pseudo_id`, `ga_session_id`
)
SELECT `user_pseudo_id`,
       COUNT(*) AS `purchase_sessions`
FROM session_revenue
GROUP BY `user_pseudo_id`
HAVING `purchase_sessions` > 1
LIMIT 20;
```

```sql
--Description: FINAL – average purchase‑revenue‑per‑session for users having   
--             >1 purchase sessions (Nov 1–30 2020)  
WITH session_revenue AS (
  SELECT `user_pseudo_id`,
         ep.`value`.int_value                       AS `ga_session_id`,
         SUM(`ecommerce`.`purchase_revenue_in_usd`) AS `session_revenue_usd`
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(`event_params`) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND `event_name` = 'purchase'
    AND ep.`key` = 'ga_session_id'
    AND `ecommerce`.`purchase_revenue_in_usd` IS NOT NULL
  GROUP BY `user_pseudo_id`, `ga_session_id`
),
multi_purchase_users AS (
  SELECT `user_pseudo_id`
  FROM session_revenue
  GROUP BY `user_pseudo_id`
  HAVING COUNT(*) > 1
)
SELECT sr.`user_pseudo_id`,
       AVG(sr.`session_revenue_usd`) AS `avg_purchase_revenue_per_session_usd`
FROM session_revenue sr
JOIN multi_purchase_users mu
  ON sr.`user_pseudo_id` = mu.`user_pseudo_id`
GROUP BY sr.`user_pseudo_id`
LIMIT 20;
```
