Query:
--Description: 7) Count page views per cleaned path for 1‑Dec‑2020.  
SELECT  clean_path,
        COUNT(*) AS page_views
FROM  (
        SELECT  REGEXP_REPLACE(
                  REGEXP_EXTRACT(
                    (SELECT p.value.string_value
                     FROM   UNNEST(event_params) AS p
                     WHERE  p.key = 'page_location'
                     LIMIT 1),
                    r'https?://shop\.googlemerchandisestore\.com([^?#]*)'),
                  r'/{2,}','/') AS clean_path
        FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
        WHERE  event_name = 'page_view'
      )
WHERE  clean_path IS NOT NULL
GROUP BY clean_path
ORDER BY page_views DESC
LIMIT 20
