```

```sql
-- 5. Extract just the path after the domain for those URLs (still one day)
SELECT  REGEXP_EXTRACT(page_location,
                       r'https?://shop\.googlemerchandisestore\.com([^?#]*)') AS raw_path
FROM   (
        SELECT (SELECT v.string_value
                FROM   UNNEST(event_params) AS p
                WHERE  p.key='page_location' LIMIT 1) AS page_location
        FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
        WHERE  event_name = 'page_view'
      )
WHERE  page_location LIKE 'https://shop.googlemerchandisestore.com%'
LIMIT 20;
```

```sql
-- 6. Clean the paths by collapsing any double (or more) slashes into one
SELECT  REGEXP_REPLACE(raw_path, r'/{2,}', '/') AS clean_path
FROM  (
        SELECT REGEXP_EXTRACT(page_location,
                              r'https?://shop\.googlemerchandisestore\.com([^?#]*)') AS raw_path
        FROM (
              SELECT (SELECT v.string_value
                      FROM   UNNEST(event_params) AS p
                      WHERE  p.key='page_location' LIMIT 1) AS page_location
              FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
              WHERE  event_name = 'page_view'
             )
        WHERE  page_location LIKE 'https://shop.googlemerchandisestore.com%'
      )
LIMIT 20;
```

```sql
-- 7. Count page views per cleaned path on 1‑Dec‑2020
SELECT  clean_path,
        COUNT(*) AS page_views
FROM  (
        SELECT  REGEXP_REPLACE(
                  REGEXP_EXTRACT(page_location,
                                 r'https?://shop\.googlemerchandisestore\.com([^?#]*)'),
                  r'/{2,}','/') AS clean_path
        FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
        WHERE  event_name = 'page_view'
               AND (SELECT v.string_value
                    FROM   UNNEST(event_params) AS p
                    WHERE  p.key='page_location' LIMIT 1)
                   LIKE 'https://shop.googlemerchandisestore.com%'
      )
GROUP BY clean_path
ORDER BY page_views DESC
LIMIT 20;
```

```sql
-- 8. Extend the counting to ALL December‑2020 tables
SELECT  clean_path,
        COUNT(*) AS page_views
FROM  (
        SELECT  REGEXP_REPLACE(
                  REGEXP_EXTRACT(
                    (SELECT v.string_value
                     FROM   UNNEST(event_params) AS p
                     WHERE  p.key='page_location' LIMIT 1),
                    r'https?://shop\.googlemerchandisestore\.com([^?#]*)'),
                  r'/{2,}','/')                                                   AS clean_path
        FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
        WHERE  event_name = 'page_view'
      )
WHERE  clean_path IS NOT NULL
GROUP BY clean_path
ORDER BY page_views DESC
LIMIT 20;
```

```sql
-- 9. Rank the December‑2020 pages by total page views
WITH dec_paths AS (
  SELECT  REGEXP_REPLACE(
            REGEXP_EXTRACT(
              (SELECT v.string_value
               FROM   UNNEST(event_params) AS p
               WHERE  p.key='page_location' LIMIT 1),
              r'https?://shop\.googlemerchandisestore\.com([^?#]*)'),
            r'/{2,}','/')                                      AS clean_path
  FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE   event_name = 'page_view'
)
SELECT  clean_path,
        COUNT(*)                                  AS page_views,
        DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS rnk
FROM    dec_paths
WHERE   clean_path IS NOT NULL
GROUP BY clean_path
ORDER BY rnk, page_views DESC
LIMIT 10;
```

```sql
-- 10. FINAL ANSWER: the page with the SECOND‑highest total page views in Dec‑2020
WITH dec_paths AS (
  SELECT  REGEXP_REPLACE(
            REGEXP_EXTRACT(
              (SELECT v.string_value
               FROM   UNNEST(event_params) AS p
               WHERE  p.key='page_location' LIMIT 1),
              r'https?://shop\.googlemerchandisestore\.com([^?#]*)'),
            r'/{2,}','/')                                      AS clean_path
  FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`
  WHERE   event_name = 'page_view'
)
, agg AS (
  SELECT  clean_path,
          COUNT(*) AS page_views,
          DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS rnk
  FROM    dec_paths
  WHERE   clean_path IS NOT NULL
  GROUP BY clean_path
)
SELECT  clean_path   AS second_most_viewed_page,
        page_views   AS total_page_views
FROM    agg
WHERE   rnk = 2;
```
