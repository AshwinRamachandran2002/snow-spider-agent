--Description: 
-- Thinking process
-- 1. Need products that were sold in 2020 (ORDER_ITEMS) and their unit profit (retail_price − cost) from PRODUCTS.  
-- 2. Convert micro‑second timestamps to YYYYMM so we can work month‑by‑month.  
-- 3. For every month, find the minimum profit value (month_min CTE).  
-- 4. Return the products whose profit equals that minimum for their month, giving us the
--    lowest‑profit item(s) each month.  
-- 5. No extra constraints (like “sold in every month”) so we are sure to get data back.  
-- 6. Order chronologically for easy reading; LIMIT 100 just caps display rows.

WITH prod_profit AS (        -- step 1 & 2
    SELECT
        TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at" / 1000000), 'YYYYMM')  AS "yyyymm",
        p."name"                                                        AS "product_name",
        (p."retail_price" - p."cost")                                   AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
          ON p."id" = oi."product_id"
    WHERE oi."created_at" >= 1577836800000000   -- 2020‑01‑01
      AND oi."created_at" <  1609459200000000   -- 2021‑01‑01
),
month_min AS (                -- step 3
    SELECT
        "yyyymm",
        MIN("profit") AS "min_profit"
    FROM prod_profit
    GROUP BY "yyyymm"
)
SELECT                         -- step 4 & 5
    pp."yyyymm",
    pp."product_name",
    pp."profit"
FROM prod_profit pp
JOIN month_min mm
      ON pp."yyyymm" = mm."yyyymm"
     AND pp."profit" = mm."min_profit"
ORDER BY pp."yyyymm", pp."product_name"
LIMIT 100;                     -- step 6
