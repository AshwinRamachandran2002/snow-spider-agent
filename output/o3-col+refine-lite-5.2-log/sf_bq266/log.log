```sql
--Description:   
-- Goal: For every month in 2020, list the product name(s) that (a) registered at least one sale
--       in *every* month of 2020 and (b) had the lowest profit (retail_price – cost) among
--       that all‑year cohort for the specific month.  
-- Strategy:  
-- 1. prod_profit   – Join ORDER_ITEMS (only 2020 records) with PRODUCTS.  
--                    Compute profit and extract YYYYMM for bucketing.  
-- 2. all_year      – Retain only those products that appear in all 12 distinct YYYYMM buckets.  
-- 3. month_min     – Among the all‑year products, get the minimum profit per month.  
-- 4. Final SELECT  – Return rows where a product’s profit equals the minimum for its month,  
--                    ordered chronologically.  
-- Notes: Times are stored in micro‑seconds since epoch, hence division by 1,000,000 before
--        TO_TIMESTAMP_LTZ.  LIMIT 100 just caps the result set display.

WITH prod_profit AS (
    SELECT
        TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at" / 1000000), 'YYYYMM')  AS "yyyymm",
        p."name"                                                        AS "product_name",
        (p."retail_price" - p."cost")                                   AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
          ON p."id" = oi."product_id"
    WHERE oi."created_at" >= 1577836800000000   -- 2020‑01‑01 00:00:00 µs
      AND oi."created_at" <  1609459200000000   -- 2021‑01‑01 00:00:00 µs
), all_year AS (
    SELECT
        "product_name"
    FROM prod_profit
    GROUP BY "product_name"
    HAVING COUNT(DISTINCT "yyyymm") = 12          -- sold in every month of 2020
), month_min AS (
    SELECT
        pp."yyyymm",
        MIN(pp."profit") AS "min_profit"
    FROM prod_profit pp
    JOIN all_year ay ON pp."product_name" = ay."product_name"
    GROUP BY pp."yyyymm"
)
SELECT
    pp."yyyymm",
    pp."product_name",
    pp."profit"
FROM prod_profit pp
JOIN all_year  ay ON pp."product_name" = ay."product_name"
JOIN month_min mm ON pp."yyyymm" = mm."yyyymm"
                  AND pp."profit" = mm."min_profit"
ORDER BY pp."yyyymm", pp."product_name"
LIMIT 100;
```
