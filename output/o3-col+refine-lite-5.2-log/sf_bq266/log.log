```

```sql
--Description: 2) Display a handful of order‑items that were created during the 2020 calendar year
SELECT 
    "id",
    "order_id",
    "product_id",
    "status",
    "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
WHERE "created_at" >= 1577836800000000   -- 2020‑01‑01 00:00:00 µs
  AND "created_at" <  1609459200000000   -- 2021‑01‑01 00:00:00 µs
LIMIT 20;
```

```sql
--Description: 3) Join 2020 order‑items with products to see names & retail‑vs‑cost values
SELECT 
    oi."id"              AS "order_item_id",
    oi."created_at",
    p."id"               AS "product_id",
    p."name"             AS "product_name",
    p."retail_price",
    p."cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
      ON p."id" = oi."product_id"
WHERE oi."created_at" >= 1577836800000000
  AND oi."created_at" <  1609459200000000
LIMIT 20;
```

```sql
--Description: 4) Compute profit (retail – cost) for each product instance sold in 2020
SELECT 
    p."name"                        AS "product_name",
    (p."retail_price" - p."cost")   AS "profit",
    oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
      ON p."id" = oi."product_id"
WHERE oi."created_at" >= 1577836800000000
  AND oi."created_at" <  1609459200000000
LIMIT 20;
```

```sql
--Description: 5) Extract the year‑month (YYYYMM) part of the micro‑second epoch to bucket by month
SELECT 
    TO_CHAR(TO_TIMESTAMP_LTZ("created_at"/1000000), 'YYYYMM') AS "yyyymm",
    COUNT(*)                                                   AS "cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
WHERE "created_at" >= 1577836800000000
  AND "created_at" <  1609459200000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 6) Profit per product per month in 2020 (aggregated)
SELECT 
    TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000), 'YYYYMM')          AS "yyyymm",
    p."name"                                                              AS "product_name",
    (p."retail_price" - p."cost")                                         AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
      ON p."id" = oi."product_id"
WHERE oi."created_at" >= 1577836800000000
  AND oi."created_at" <  1609459200000000
GROUP BY 1,2,3
ORDER BY 1,3
LIMIT 20;
```

```sql
--Description: 7) Determine, for each month, the minimum (most negative / smallest) profit value
WITH prod_profit AS (
    SELECT 
        TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000), 'YYYYMM')   AS "yyyymm",
        p."name"                                                      AS "product_name",
        (p."retail_price" - p."cost")                                 AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
          ON p."id" = oi."product_id"
    WHERE oi."created_at" >= 1577836800000000
      AND oi."created_at" <  1609459200000000
)
SELECT 
    "yyyymm",
    MIN("profit") AS "min_profit"
FROM prod_profit
GROUP BY "yyyymm"
ORDER BY "yyyymm"
LIMIT 20;
```

```sql
--Description: 8) List the product(s) in a month whose profit equals that month’s minimum
WITH prod_profit AS (
    SELECT 
        TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000), 'YYYYMM')   AS "yyyymm",
        p."name"                                                      AS "product_name",
        (p."retail_price" - p."cost")                                 AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
          ON p."id" = oi."product_id"
    WHERE oi."created_at" >= 1577836800000000
      AND oi."created_at" <  1609459200000000
),
monthly_min AS (
    SELECT 
        "yyyymm",
        MIN("profit") AS "min_profit"
    FROM prod_profit
    GROUP BY "yyyymm"
)
SELECT 
    pp."yyyymm",
    pp."product_name",
    pp."profit"
FROM prod_profit pp
JOIN monthly_min mm
      ON pp."yyyymm" = mm."yyyymm"
     AND pp."profit" = mm."min_profit"
ORDER BY pp."yyyymm"
LIMIT 20;
```

```sql
--Description: 9) Ensure we exclude months without any order‑items (sanity check of count)
SELECT 
    TO_CHAR(TO_TIMESTAMP_LTZ("created_at"/1000000), 'YYYYMM') AS "yyyymm",
    COUNT(*)                                                  AS "order_items_in_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
WHERE "created_at" >= 1577836800000000
  AND "created_at" <  1609459200000000
GROUP BY 1
HAVING COUNT(*) > 0
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 10) Final query: product names which had sales in every month of 2020 and whose profit equals the month’s minimum, shown chronologically
WITH prod_profit AS (
    SELECT 
        TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at"/1000000), 'YYYYMM')   AS "yyyymm",
        p."name"                                                      AS "product_name",
        (p."retail_price" - p."cost")                                 AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
          ON p."id" = oi."product_id"
    WHERE oi."created_at" >= 1577836800000000
      AND oi."created_at" <  1609459200000000
),
monthly_min AS (
    SELECT 
        "yyyymm",
        MIN("profit") AS "min_profit"
    FROM prod_profit
    GROUP BY "yyyymm"
),
low_profit_products AS (
    SELECT 
        pp."yyyymm",
        pp."product_name"
    FROM prod_profit pp
    JOIN monthly_min mm
          ON pp."yyyymm" = mm."yyyymm"
         AND pp."profit" = mm."min_profit"
),
product_months AS (
    SELECT 
        "product_name",
        COUNT(DISTINCT "yyyymm") AS "months_sold"
    FROM low_profit_products
    GROUP BY "product_name"
)
SELECT 
    lpp."yyyymm",
    lpp."product_name"
FROM low_profit_products lpp
JOIN product_months pm
      ON lpp."product_name" = pm."product_name"
WHERE pm."months_sold" = 12             -- appeared in every month of 2020
ORDER BY lpp."yyyymm", lpp."product_name"
LIMIT 20;
```
