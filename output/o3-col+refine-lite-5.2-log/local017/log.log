ORDER  BY "total_crashes" DESC
LIMIT 20;
```

```sql
-- 4. How many crashes does each cause have in every single year?  
SELECT ci."db_year",
       c."pcf_violation_category",
       COUNT(*) AS "yearly_crashes"
FROM   "collisions" AS c
JOIN   "case_ids"  AS ci  USING ("case_id")
GROUP  BY ci."db_year", c."pcf_violation_category"
ORDER  BY ci."db_year", "yearly_crashes" DESC
LIMIT 20;
```

```sql
-- 5. Rank the causes inside each year (1 = most common, 2 = 2nd most, …)  
SELECT ci."db_year",
       c."pcf_violation_category",
       COUNT(*)                                 AS "yearly_crashes",
       DENSE_RANK() OVER (PARTITION BY ci."db_year"
                          ORDER BY COUNT(*) DESC) AS "rk"
FROM   "collisions" AS c
JOIN   "case_ids"  AS ci  USING ("case_id")
GROUP  BY ci."db_year", c."pcf_violation_category"
ORDER  BY ci."db_year", "rk"
LIMIT 20;
```

```sql
-- 6. Pull only the TOP‑2 causes for every year (rk <= 2)  
WITH ranked AS (
     SELECT ci."db_year"      AS "yr",
            c."pcf_violation_category" AS "cause",
            DENSE_RANK() OVER (PARTITION BY ci."db_year"
                               ORDER BY COUNT(*) DESC) AS "rk"
     FROM   "collisions" AS c
     JOIN   "case_ids"  AS ci  USING ("case_id")
     GROUP  BY ci."db_year", c."pcf_violation_category")
SELECT *
FROM   ranked
WHERE  "rk" <= 2
LIMIT 20;
```

```sql
-- 7. First find the TWO causes that are most common ACROSS ALL YEARS  
WITH overall AS (
     SELECT c."pcf_violation_category",
            COUNT(*) AS cnt
     FROM   "collisions" AS c
     JOIN   "case_ids"  AS ci  USING ("case_id")
     GROUP  BY c."pcf_violation_category"
     ORDER  BY cnt DESC
     LIMIT 2)
SELECT *
FROM   overall;
```

```sql
-- 8. Compare each year’s TOP‑2 against the overall TOP‑2  
WITH overall AS (
     SELECT c."pcf_violation_category"
     FROM   "collisions" AS c
     JOIN   "case_ids"  AS ci  USING ("case_id")
     GROUP  BY c."pcf_violation_category"
     ORDER  BY COUNT(*) DESC
     LIMIT 2
), per_year AS (
     SELECT ci."db_year"                 AS yr,
            c."pcf_violation_category"   AS cause,
            DENSE_RANK() OVER (PARTITION BY ci."db_year"
                               ORDER BY COUNT(*) DESC) AS rk
     FROM   "collisions" AS c
     JOIN   "case_ids"  AS ci  USING ("case_id")
     GROUP  BY ci."db_year", c."pcf_violation_category"
)
SELECT DISTINCT yr
FROM   per_year
WHERE  rk <= 2
  AND  cause NOT IN (SELECT "pcf_violation_category" FROM overall)
ORDER  BY yr;
```

```sql
-- 9. Final answer: the year(s) whose TOP‑2 accident causes differ
--    from the two causes that dominate in the remaining years.  
WITH overall AS (
     SELECT c."pcf_violation_category"
     FROM   "collisions" AS c
     JOIN   "case_ids"  AS ci  USING ("case_id")
     GROUP  BY c."pcf_violation_category"
     ORDER  BY COUNT(*) DESC
     LIMIT 2
), per_year AS (
     SELECT ci."db_year"                 AS yr,
            c."pcf_violation_category"   AS cause,
            DENSE_RANK() OVER (PARTITION BY ci."db_year"
                               ORDER BY COUNT(*) DESC) AS rk
     FROM   "collisions" AS c
     JOIN   "case_ids"  AS ci  USING ("case_id")
     GROUP  BY ci."db_year", c."pcf_violation_category"
), bad_years AS (
     SELECT DISTINCT yr
     FROM   per_year
     WHERE  rk <= 2
       AND  cause NOT IN (SELECT "pcf_violation_category" FROM overall)
)
SELECT yr AS "year_with_different_top2_causes"
FROM   bad_years
ORDER  BY yr;
```
