Query:
--Description:
-- Find the two “pcf_violation_category” values that have the highest total
-- number of collisions across the entire data set (all years combined).
WITH overall AS (
    SELECT
        c."pcf_violation_category",
        COUNT(*) AS cnt
    FROM   "case_ids"  AS ci
    JOIN   "collisions" AS c  USING ("case_id")
    GROUP  BY c."pcf_violation_category"
    ORDER  BY cnt DESC
    LIMIT 2
)
SELECT *
FROM   overall
