    FROM   ranked
    WHERE  rk <= 2
)
SELECT yr AS "year_with_different_top2_causes"
FROM   per_year_top2
GROUP  BY yr
HAVING SUM(CASE WHEN cause IN (SELECT cause FROM overall) THEN 1 ELSE 0 END) < 2
ORDER  BY yr;
