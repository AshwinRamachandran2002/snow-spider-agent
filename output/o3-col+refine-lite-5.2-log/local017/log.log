Query:
--Description:
-- List every year in which at least one of that year’s Top‑2 causes is NOT
-- contained in the overall global Top‑2 list computed above.
WITH overall AS (
    SELECT c."pcf_violation_category"
    FROM   "case_ids"  AS ci
    JOIN   "collisions" AS c  USING ("case_id")
    GROUP  BY c."pcf_violation_category"
    ORDER  BY COUNT(*) DESC
    LIMIT 2
),
per_year AS (
    SELECT
        ci."db_year"               AS yr,
        c."pcf_violation_category" AS cause,
        DENSE_RANK() OVER (PARTITION BY ci."db_year"
                           ORDER BY COUNT(*) DESC) AS rk
    FROM   "case_ids"  AS ci
    JOIN   "collisions" AS c  USING ("case_id")
    GROUP  BY ci."db_year", c."pcf_violation_category"
)
SELECT DISTINCT yr
FROM   per_year
WHERE  rk <= 2
  AND  cause NOT IN (SELECT "pcf_violation_category" FROM overall)
ORDER  BY yr
