Query:
--Description:
-- Retrieve only the Top‑2 ranked causes (rk ≤ 2) for every year, using
-- the ranking logic defined above.  (Shows up to 100 rows.)
WITH ranked AS (
    SELECT
        ci."db_year"                AS yr,
        c."pcf_violation_category"  AS cause,
        DENSE_RANK() OVER (PARTITION BY ci."db_year"
                           ORDER BY COUNT(*) DESC) AS rk
    FROM   "case_ids"  AS ci
    JOIN   "collisions" AS c  USING ("case_id")
    GROUP  BY ci."db_year", c."pcf_violation_category"
)
SELECT *
FROM   ranked
WHERE  rk <= 2
ORDER  BY yr, rk
LIMIT 100
