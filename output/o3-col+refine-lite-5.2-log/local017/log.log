```sql
--Description:
-- Goal: find the year(s) whose TWO most common “primary‑collision‑factor”
--       (pcf_violation_category) differ from the pair that dominates across
--       all other years combined.
-- Steps inside a single statement:
--   1. overall  – pick the global Top‑2 causes (by total crash count).
--   2. ranked   – inside every year rank each cause by crash count
--                 (DENSE_RANK so ties share a rank).
--   3. per_year_top2 – keep only rank ≤ 2 for each year (that year’s Top‑2).
--   4. Final SELECT – for each year count how many of its Top‑2 causes fall
--      inside the global Top‑2 list.  If that count < 2, at least one of the
--      year’s Top‑2 causes is different ⇒ that year satisfies the question.
WITH overall AS (
    SELECT c."pcf_violation_category" AS cause
    FROM   "collisions" AS c
    JOIN   "case_ids"  AS ci USING ("case_id")
    GROUP  BY cause
    ORDER  BY COUNT(*) DESC
    LIMIT 2
),
ranked AS (
    SELECT
        ci."db_year"                      AS yr,
        c."pcf_violation_category"        AS cause,
        DENSE_RANK() OVER (
            PARTITION BY ci."db_year"
            ORDER BY COUNT(*) DESC
        )                                 AS rk
    FROM   "collisions" AS c
    JOIN   "case_ids"  AS ci USING ("case_id")
    GROUP  BY ci."db_year", c."pcf_violation_category"
),
per_year_top2 AS (
    SELECT yr, cause
    FROM   ranked
    WHERE  rk <= 2
)
SELECT yr AS "year_with_different_top2_causes"
FROM   per_year_top2
GROUP  BY yr
HAVING SUM(
           CASE
               WHEN cause IN (SELECT cause FROM overall) THEN 1
               ELSE 0
           END
       ) < 2          -- fewer than two matches with global Top‑2
ORDER  BY yr;
```
