Query:
--Description:
-- Rank every “pcf_violation_category” within each year by collision count,
-- so rank = 1 is most common, rank = 2 second‑most, etc.  (Capped at 100 rows.)
SELECT
    ci."db_year",
    c."pcf_violation_category",
    COUNT(*) AS "yearly_crashes",
    DENSE_RANK() OVER (PARTITION BY ci."db_year"
                       ORDER BY COUNT(*) DESC) AS "rk"
FROM   "case_ids"  AS ci
JOIN   "collisions" AS c  USING ("case_id")
GROUP  BY ci."db_year", c."pcf_violation_category"
ORDER  BY ci."db_year", "rk"
LIMIT 100
