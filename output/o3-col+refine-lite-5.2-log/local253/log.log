```sql
-- 3) Description: Display a few raw salary strings so we know what needs cleaning
SELECT DISTINCT "Salary"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 4) Description: Clean one salary sample to numeric by stripping ₹, commas and “/yr”
SELECT "CompanyName",
       "Location",
       CAST(
            REPLACE(
                REPLACE(
                    REPLACE(
                        REPLACE("Salary",'₹','')      -- remove rupee sign
                    , '/yr','')                      -- remove /yr
                , ',','')                            -- remove commas
            , '/','')                                -- (extra) remove stray slash
       AS REAL) AS "salary_num"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 5) Description: Compute the nationwide (all‑locations) average salary
SELECT AVG(
         CAST(
              REPLACE(
                  REPLACE(
                      REPLACE(
                          REPLACE("Salary",'₹','')
                      , '/yr','')
                  , ',','')
              , '/','')
         AS REAL)
       ) AS "avg_salary_country"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 6) Description: Average salary per company in each of the four cities of interest
SELECT "Location",
       "CompanyName",
       AVG(
           CAST(
                REPLACE(
                    REPLACE(
                        REPLACE(
                            REPLACE("Salary",'₹','')
                        , '/yr','')
                    , ',','')
                , '/','')
            AS REAL)
       ) AS "avg_salary_loc"
FROM "SalaryDataset"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location","CompanyName"
LIMIT 20;
```

```sql
-- 7) Description: Rank companies inside each city by their average salary
SELECT  s."Location",
        s."CompanyName",
        s."avg_salary_loc",
        ROW_NUMBER() OVER (PARTITION BY s."Location"
                           ORDER BY s."avg_salary_loc" DESC) AS "rn"
FROM (
      SELECT "Location",
             "CompanyName",
             AVG(
                 CAST(
                      REPLACE(
                          REPLACE(
                              REPLACE(
                                  REPLACE("Salary",'₹','')
                              , '/yr','')
                          , ',','')
                      , '/','')
                 AS REAL)
             ) AS "avg_salary_loc"
      FROM "SalaryDataset"
      WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
      GROUP BY "Location","CompanyName"
) AS s
LIMIT 20;
```

```sql
-- 8) Description: Keep only the Top‑5 companies in each of the four cities
SELECT  t."Location",
        t."CompanyName",
        t."avg_salary_loc"
FROM (
      SELECT  s."Location",
              s."CompanyName",
              s."avg_salary_loc",
              ROW_NUMBER() OVER (PARTITION BY s."Location"
                                 ORDER BY s."avg_salary_loc" DESC) AS "rn"
      FROM (
            SELECT "Location",
                   "CompanyName",
                   AVG(
                       CAST(
                            REPLACE(
                                REPLACE(
                                    REPLACE(
                                        REPLACE("Salary",'₹','')
                                    , '/yr','')
                                , ',','')
                            , '/','')
                       AS REAL)
                   ) AS "avg_salary_loc"
            FROM "SalaryDataset"
            WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
            GROUP BY "Location","CompanyName"
           ) AS s
     ) AS t
WHERE t."rn" <= 5
LIMIT 20;
```

```sql
-- 9) Description: Final answer – Top‑5 companies by city with their city average
--                  salary and the nationwide average salary for comparison
WITH cleaned AS (
     SELECT "CompanyName",
            "Location",
            CAST(
                 REPLACE(
                     REPLACE(
                         REPLACE(
                             REPLACE("Salary",'₹','')
                         , '/yr','')
                     , ',','')
                 , '/','')
            AS REAL) AS sal_num
     FROM "SalaryDataset"
),
loc_avg AS (
     SELECT "Location",
            "CompanyName",
            AVG(sal_num) AS avg_salary_loc
     FROM cleaned
     WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
     GROUP BY "Location","CompanyName"
),
ranked AS (
     SELECT *,
            ROW_NUMBER() OVER (PARTITION BY "Location"
                               ORDER BY avg_salary_loc DESC) AS rn
     FROM loc_avg
),
top5 AS (
     SELECT *
     FROM ranked
     WHERE rn <= 5
),
national AS (
     SELECT AVG(sal_num) AS avg_salary_country
     FROM cleaned
)
SELECT t."Location",
       t."CompanyName",
       ROUND(t.avg_salary_loc,2)   AS "Average Salary in State",
       ROUND(n.avg_salary_country,2) AS "Average Salary in Country"
FROM top5 AS t
CROSS JOIN national AS n
ORDER BY t."Location",
         t.avg_salary_loc DESC
LIMIT 20;
```
