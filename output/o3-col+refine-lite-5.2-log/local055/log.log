```sql
--Description: Take a quick look at how sales information (Invoice/Track) connects back to each Artist.
SELECT DISTINCT ii."InvoiceId",
                ii."UnitPrice",
                ii."Quantity",
                t."TrackId",
                t."AlbumId",
                al."ArtistId",
                ar."Name"     AS "ArtistName"
FROM   "invoice_items"    AS ii
JOIN   "tracks"           AS t  ON t."TrackId"  = ii."TrackId"
JOIN   "albums"           AS al ON al."AlbumId" = t."AlbumId"
JOIN   "artists"          AS ar ON ar."ArtistId" = al."ArtistId"
LIMIT 20;
```

```sql
--Description: Compute the overall revenue (UnitPrice * Quantity) for every artist.
SELECT ar."ArtistId",
       ar."Name"                            AS "Artist",
       ROUND(SUM(ii."UnitPrice"*ii."Quantity"),2) AS "TotalSales"
FROM   "invoice_items"    AS ii
JOIN   "tracks"           AS t  ON t."TrackId"  = ii."TrackId"
JOIN   "albums"           AS al ON al."AlbumId" = t."AlbumId"
JOIN   "artists"          AS ar ON ar."ArtistId" = al."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "TotalSales" DESC, ar."Name"
LIMIT 20;
```

```sql
--Description: Pull out the single top‑selling artist (highest revenue, alphabetical tiebreaker).
SELECT ar."ArtistId",
       ar."Name"   AS "TopArtist",
       ROUND(SUM(ii."UnitPrice"*ii."Quantity"),2) AS "TopArtistSales"
FROM   "invoice_items"    AS ii
JOIN   "tracks"           AS t  ON t."TrackId"  = ii."TrackId"
JOIN   "albums"           AS al ON al."AlbumId" = t."AlbumId"
JOIN   "artists"          AS ar ON ar."ArtistId" = al."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "TopArtistSales" DESC, ar."Name"
LIMIT 1;
```

```sql
--Description: Pull out the single lowest‑selling artist (lowest revenue, alphabetical tiebreaker).  
SELECT ar."ArtistId",
       ar."Name"   AS "BottomArtist",
       ROUND(SUM(ii."UnitPrice"*ii."Quantity"),2) AS "BottomArtistSales"
FROM   "invoice_items"    AS ii
JOIN   "tracks"           AS t  ON t."TrackId"  = ii."TrackId"
JOIN   "albums"           AS al ON al."AlbumId" = t."AlbumId"
JOIN   "artists"          AS ar ON ar."ArtistId" = al."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "BottomArtistSales" ASC, ar."Name"
LIMIT 1;
```

```sql
--Description: Show how much every customer spent on the TOP artist.
WITH top_artist AS (
  SELECT ar."ArtistId"
  FROM   "invoice_items" AS ii
  JOIN   "tracks"        AS t  ON t."TrackId"  = ii."TrackId"
  JOIN   "albums"        AS al ON al."AlbumId" = t."AlbumId"
  JOIN   "artists"       AS ar ON ar."ArtistId" = al."ArtistId"
  GROUP  BY ar."ArtistId", ar."Name"
  ORDER  BY SUM(ii."UnitPrice"*ii."Quantity") DESC, ar."Name"
  LIMIT 1
)
SELECT c."CustomerId",
       c."FirstName"||' '||c."LastName"        AS "Customer",
       ROUND(SUM(ii."UnitPrice"*ii."Quantity"),2) AS "SpentOnTopArtist"
FROM   top_artist        AS ta
JOIN   "tracks"          AS t  ON t."AlbumId" IN (SELECT "AlbumId" FROM "albums" WHERE "ArtistId" = ta."ArtistId")
JOIN   "invoice_items"   AS ii ON ii."TrackId" = t."TrackId"
JOIN   "invoices"        AS inv ON inv."InvoiceId" = ii."InvoiceId"
JOIN   "customers"       AS c   ON c."CustomerId"  = inv."CustomerId"
GROUP  BY c."CustomerId"
LIMIT 20;
```

```sql
--Description: Show how much every customer spent on the BOTTOM artist.
WITH bottom_artist AS (
  SELECT ar."ArtistId"
  FROM   "invoice_items" AS ii
  JOIN   "tracks"        AS t  ON t."TrackId"  = ii."TrackId"
  JOIN   "albums"        AS al ON al."AlbumId" = t."AlbumId"
  JOIN   "artists"       AS ar ON ar."ArtistId" = al."ArtistId"
  GROUP  BY ar."ArtistId", ar."Name"
  ORDER  BY SUM(ii."UnitPrice"*ii."Quantity") ASC, ar."Name"
  LIMIT 1
)
SELECT c."CustomerId",
       c."FirstName"||' '||c."LastName"            AS "Customer",
       ROUND(SUM(ii."UnitPrice"*ii."Quantity"),2)  AS "SpentOnBottomArtist"
FROM   bottom_artist    AS ba
JOIN   "tracks"         AS t  ON t."AlbumId" IN (SELECT "AlbumId" FROM "albums" WHERE "ArtistId" = ba."ArtistId")
JOIN   "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
JOIN   "invoices"       AS inv ON inv."InvoiceId" = ii."InvoiceId"
JOIN   "customers"      AS c   ON c."CustomerId"  = inv."CustomerId"
GROUP  BY c."CustomerId"
LIMIT 20;
```

```sql
--Description: Calculate the average amount spent by customers who bought the TOP artist.
WITH top_artist AS (
  SELECT ar."ArtistId"
  FROM   "invoice_items" AS ii
  JOIN   "tracks"        AS t  ON t."TrackId"  = ii."TrackId"
  JOIN   "albums"        AS al ON al."AlbumId" = t."AlbumId"
  JOIN   "artists"       AS ar ON ar."ArtistId" = al."ArtistId"
  GROUP  BY ar."ArtistId", ar."Name"
  ORDER  BY SUM(ii."UnitPrice"*ii."Quantity") DESC, ar."Name"
  LIMIT 1
),
cust_spend AS (
  SELECT inv."CustomerId",
         SUM(ii."UnitPrice"*ii."Quantity") AS "Spent"
  FROM   top_artist       AS ta
  JOIN   "tracks"         AS t  ON t."AlbumId" IN (SELECT "AlbumId" FROM "albums" WHERE "ArtistId" = ta."ArtistId")
  JOIN   "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
  JOIN   "invoices"       AS inv ON inv."InvoiceId" = ii."InvoiceId"
  GROUP  BY inv."CustomerId"
)
SELECT ROUND(AVG("Spent"),2) AS "AvgSpentOnTopArtist"
FROM   cust_spend;
```

```sql
--Description: Calculate the average amount spent by customers who bought the BOTTOM artist.
WITH bottom_artist AS (
  SELECT ar."ArtistId"
  FROM   "invoice_items" AS ii
  JOIN   "tracks"        AS t  ON t."TrackId"  = ii."TrackId"
  JOIN   "albums"        AS al ON al."AlbumId" = t."AlbumId"
  JOIN   "artists"       AS ar ON ar."ArtistId" = al."ArtistId"
  GROUP  BY ar."ArtistId", ar."Name"
  ORDER  BY SUM(ii."UnitPrice"*ii."Quantity") ASC, ar."Name"
  LIMIT 1
),
cust_spend AS (
  SELECT inv."CustomerId",
         SUM(ii."UnitPrice"*ii."Quantity") AS "Spent"
  FROM   bottom_artist    AS ba
  JOIN   "tracks"         AS t  ON t."AlbumId" IN (SELECT "AlbumId" FROM "albums" WHERE "ArtistId" = ba."ArtistId")
  JOIN   "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
  JOIN   "invoices"       AS inv ON inv."InvoiceId" = ii."InvoiceId"
  GROUP  BY inv."CustomerId"
)
SELECT ROUND(AVG("Spent"),2) AS "AvgSpentOnBottomArtist"
FROM   cust_spend;
```

```sql
--Description: Return the absolute difference between the two average spendings.
WITH
top_avg AS (
  SELECT ROUND(AVG("Spent"),2) AS "avg_top"
  FROM (
    SELECT inv."CustomerId",
           SUM(ii."UnitPrice"*ii."Quantity") AS "Spent"
    FROM "invoice_items" AS ii
    JOIN "tracks"        AS t  ON t."TrackId"  = ii."TrackId"
    JOIN "albums"        AS al ON al."AlbumId" = t."AlbumId"
    JOIN "artists"       AS ar ON ar."ArtistId" = al."ArtistId"
    JOIN "invoices"      AS inv ON inv."InvoiceId" = ii."InvoiceId"
    WHERE ar."ArtistId" = (
        SELECT ar2."ArtistId"
        FROM   "invoice_items" AS ii2
        JOIN   "tracks"        AS t2  ON t2."TrackId"  = ii2."TrackId"
        JOIN   "albums"        AS al2 ON al2."AlbumId" = t2."AlbumId"
        JOIN   "artists"       AS ar2 ON ar2."ArtistId" = al2."ArtistId"
        GROUP  BY ar2."ArtistId", ar2."Name"
        ORDER  BY SUM(ii2."UnitPrice"*ii2."Quantity") DESC, ar2."Name"
        LIMIT 1)
    GROUP BY inv."CustomerId"
  )
),
bottom_avg AS (
  SELECT ROUND(AVG("Spent"),2) AS "avg_bottom"
  FROM (
    SELECT inv."CustomerId",
           SUM(ii."UnitPrice"*ii."Quantity") AS "Spent"
    FROM "invoice_items" AS ii
    JOIN "tracks"        AS t  ON t."TrackId"  = ii."TrackId"
    JOIN "albums"        AS al ON al."AlbumId" = t."AlbumId"
    JOIN "artists"       AS ar ON ar."ArtistId" = al."ArtistId"
    JOIN "invoices"      AS inv ON inv."InvoiceId" = ii."InvoiceId"
    WHERE ar."ArtistId" = (
        SELECT ar2."ArtistId"
        FROM   "invoice_items" AS ii2
        JOIN   "tracks"        AS t2  ON t2."TrackId"  = ii2."TrackId"
        JOIN   "albums"        AS al2 ON al2."AlbumId" = t2."AlbumId"
        JOIN   "artists"       AS ar2 ON ar2."ArtistId" = al2."ArtistId"
        GROUP  BY ar2."ArtistId", ar2."Name"
        ORDER  BY SUM(ii2."UnitPrice"*ii2."Quantity") ASC, ar2."Name"
        LIMIT 1)
    GROUP BY inv."CustomerId"
  )
)
SELECT ABS(top_avg."avg_top" - bottom_avg."avg_bottom") AS "AvgSpendDifference"
FROM   top_avg, bottom_avg;
```

