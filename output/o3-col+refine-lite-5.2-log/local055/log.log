        JOIN   "albums"        AS al2 ON al2."AlbumId" = t2."AlbumId"
        JOIN   "artists"       AS ar2 ON ar2."ArtistId" = al2."ArtistId"
        GROUP  BY ar2."ArtistId", ar2."Name"
        ORDER  BY SUM(ii2."UnitPrice"*ii2."Quantity") ASC, ar2."Name"
        LIMIT 1)
    GROUP BY inv."CustomerId"
  )
)
SELECT ABS(top_avg."avg_top" - bottom_avg."avg_bottom") AS "AvgSpendDifference"
