  FROM   bottom_artist    AS ba
  JOIN   "tracks"         AS t  ON t."AlbumId" IN (SELECT "AlbumId" FROM "albums" WHERE "ArtistId" = ba."ArtistId")
  JOIN   "invoice_items"  AS ii ON ii."TrackId" = t."TrackId"
  JOIN   "invoices"       AS inv ON inv."InvoiceId" = ii."InvoiceId"
  GROUP  BY inv."CustomerId"
)
SELECT ROUND(AVG("Spent"),2) AS "AvgSpentOnBottomArtist"
