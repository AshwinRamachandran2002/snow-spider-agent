Query:
--Description: Show how much every customer spent on the TOP artist.
WITH top_artist AS (
  SELECT ar."ArtistId"
  FROM   "invoice_items" AS ii
  JOIN   "tracks"        AS t  ON t."TrackId"  = ii."TrackId"
  JOIN   "albums"        AS al ON al."AlbumId" = t."AlbumId"
  JOIN   "artists"       AS ar ON ar."ArtistId" = al."ArtistId"
  GROUP  BY ar."ArtistId", ar."Name"
  ORDER  BY SUM(ii."UnitPrice"*ii."Quantity") DESC, ar."Name"
  LIMIT 1
)
SELECT c."CustomerId",
       c."FirstName"||' '||c."LastName"        AS "Customer",
       ROUND(SUM(ii."UnitPrice"*ii."Quantity"),2) AS "SpentOnTopArtist"
FROM   top_artist        AS ta
JOIN   "tracks"          AS t  ON t."AlbumId" IN (SELECT "AlbumId" FROM "albums" WHERE "ArtistId" = ta."ArtistId")
JOIN   "invoice_items"   AS ii ON ii."TrackId" = t."TrackId"
JOIN   "invoices"        AS inv ON inv."InvoiceId" = ii."InvoiceId"
JOIN   "customers"       AS c   ON c."CustomerId"  = inv."CustomerId"
GROUP  BY c."CustomerId"
LIMIT 20;
