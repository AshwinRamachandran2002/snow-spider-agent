Query:
--Description: Pull out the single top‑selling artist (highest revenue, alphabetical tiebreaker).
SELECT ar."ArtistId",
       ar."Name"   AS "TopArtist",
       ROUND(SUM(ii."UnitPrice"*ii."Quantity"),2) AS "TopArtistSales"
FROM   "invoice_items"    AS ii
JOIN   "tracks"           AS t  ON t."TrackId"  = ii."TrackId"
JOIN   "albums"           AS al ON al."AlbumId" = t."AlbumId"
JOIN   "artists"          AS ar ON ar."ArtistId" = al."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "TopArtistSales" DESC, ar."Name"
LIMIT 1;
Answer:
ArtistId,TopArtist,TopArtistSales
90,Iron Maiden,138.6
Query:
--Description: Pull out the single lowest‑selling artist (lowest revenue, alphabetical tiebreaker).  
SELECT ar."ArtistId",
       ar."Name"   AS "BottomArtist",
       ROUND(SUM(ii."UnitPrice"*ii."Quantity"),2) AS "BottomArtistSales"
FROM   "invoice_items"    AS ii
JOIN   "tracks"           AS t  ON t."TrackId"  = ii."TrackId"
JOIN   "albums"           AS al ON al."AlbumId" = t."AlbumId"
JOIN   "artists"          AS ar ON ar."ArtistId" = al."ArtistId"
GROUP  BY ar."ArtistId", ar."Name"
ORDER  BY "BottomArtistSales" ASC, ar."Name"
LIMIT 1;
