```sql
-- 1. Preview state‑level cumulative case counts from 1 Mar 2020 – 31 May 2020
SELECT
  date,
  state_name,
  confirmed_cases
FROM `bigquery-public-data.covid19_nyt.us_states`
WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
LIMIT 20;
```

```sql
-- 2. Calculate daily new cases for every state in the same period
SELECT
  date,
  state_name,
  confirmed_cases
       - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS new_cases
FROM `bigquery-public-data.covid19_nyt.us_states`
WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
LIMIT 20;
```

```sql
-- 3. Pick the five states with the largest daily increases for each day
WITH state_daily AS (
  SELECT
    date,
    state_name,
    confirmed_cases
         - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT *
FROM (
  SELECT
    date,
    state_name,
    new_cases,
    ROW_NUMBER() OVER (PARTITION BY date ORDER BY new_cases DESC) AS rn
  FROM state_daily
)
WHERE rn <= 5
LIMIT 20;
```

```sql
-- 4. Count how many times each state falls into the daily Top‑5 list
WITH daily_top5 AS (
  SELECT
    date,
    state_name
  FROM (
    SELECT
      date,
      state_name,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY
         confirmed_cases - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) DESC) AS rn
    FROM `bigquery-public-data.covid19_nyt.us_states`
    WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
  )
  WHERE rn <= 5
)
SELECT
  state_name,
  COUNT(*) AS top5_count
FROM daily_top5
GROUP BY state_name
ORDER BY top5_count DESC
LIMIT 20;
```

```sql
-- 5. Give every state an overall rank by Top‑5 appearances
WITH freq AS (
  SELECT
    state_name,
    COUNT(*) AS top5_count
  FROM (
    SELECT
      date,
      state_name,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY
         confirmed_cases - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) DESC) AS rn
    FROM `bigquery-public-data.covid19_nyt.us_states`
    WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
  )
  WHERE rn <= 5
  GROUP BY state_name
)
SELECT
  state_name,
  top5_count,
  ROW_NUMBER() OVER (ORDER BY top5_count DESC) AS overall_rank
FROM freq
ORDER BY overall_rank
LIMIT 20;
```

```sql
-- 6. Identify the state that ranks fourth overall
