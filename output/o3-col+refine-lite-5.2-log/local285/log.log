```sql
-- 7. Description: Calculate the average, max, min wholesale price and the price range for each category & year
SELECT
       SUBSTR(vw."whsle_date",1,4)                    AS "year",
       vc."category_name",
       ROUND(AVG(vw."whsle_px_rmb-kg"),2)             AS "avg_whsle_px",
       ROUND(MAX(vw."whsle_px_rmb-kg"),2)             AS "max_whsle_px",
       ROUND(MIN(vw."whsle_px_rmb-kg"),2)             AS "min_whsle_px",
       ROUND(MAX(vw."whsle_px_rmb-kg") -
             MIN(vw."whsle_px_rmb-kg"),2)             AS "whsle_px_diff"
FROM   "veg_whsle_df" AS vw
JOIN   "veg_cat"      AS vc  ON vw."item_code" = vc."item_code"
WHERE  SUBSTR(vw."whsle_date",1,4) BETWEEN '2020' AND '2023'
GROUP  BY "year", vc."category_name"
LIMIT 20;
```

```sql
-- 8. Description: Compute total wholesale value (cost) per category & year
SELECT
       SUBSTR(vw."whsle_date",1,4)                                AS "year",
       vc."category_name",
       ROUND(SUM(vw."whsle_px_rmb-kg" * vt."qty_sold(kg)"),2)     AS "total_wholesale_rmb"
FROM   "veg_whsle_df" AS vw
JOIN   "veg_txn_df"   AS vt  ON vw."item_code" = vt."item_code"
                               AND SUBSTR(vw."whsle_date",1,10) = SUBSTR(vt."txn_date",1,10)
JOIN   "veg_cat"      AS vc  ON vw."item_code" = vc."item_code"
WHERE  SUBSTR(vw."whsle_date",1,4) BETWEEN '2020' AND '2023'
GROUP  BY "year", vc."category_name"
LIMIT 20;
```

```sql
-- 9. Description: Calculate average loss rate (%) and the monetary value of that loss for each category & year
SELECT
       SUBSTR(vw."whsle_date",1,4)                                            AS "year",
       vc."category_name",
       ROUND(AVG(vl."loss_rate_%"),2)                                         AS "avg_loss_rate_pct",
       ROUND(SUM(vt."unit_selling_px_rmb/kg" * vt."qty_sold(kg)" *
                 vl."loss_rate_%"/100),2)                                     AS "total_loss_rmb"
FROM   "veg_whsle_df"   AS vw
JOIN   "veg_txn_df"     AS vt  ON vw."item_code" = vt."item_code"
                                 AND SUBSTR(vw."whsle_date",1,10) = SUBSTR(vt."txn_date",1,10)
JOIN   "veg_loss_rate_df" AS vl ON vw."item_code" = vl."item_code"
JOIN   "veg_cat"         AS vc  ON vw."item_code" = vc."item_code"
WHERE  SUBSTR(vw."whsle_date",1,4) BETWEEN '2020' AND '2023'
GROUP  BY "year", vc."category_name"
LIMIT 20;
```

```sql
--10. Description: Final comprehensive financial‑performance view (avg/max/min/diff wholesale, totals, avg loss, profit)
SELECT
       SUBSTR(vw."whsle_date",1,4)                                          AS "year",
       vc."category_name",
       -- basic wholesale statistics
       ROUND(AVG(vw."whsle_px_rmb-kg"),2)                                   AS "avg_whsle_px",
       ROUND(MAX(vw."whsle_px_rmb-kg"),2)                                   AS "max_whsle_px",
       ROUND(MIN(vw."whsle_px_rmb-kg"),2)                                   AS "min_whsle_px",
       ROUND(MAX(vw."whsle_px_rmb-kg") - MIN(vw."whsle_px_rmb-kg"),2)       AS "whsle_px_diff",
       -- totals (cost & revenue)
       ROUND(SUM(vw."whsle_px_rmb-kg" * vt."qty_sold(kg)"),2)               AS "total_wholesale_rmb",
       ROUND(SUM(vt."unit_selling_px_rmb/kg" * vt."qty_sold(kg)"),2)        AS "total_selling_rmb",
       -- loss information
       ROUND(AVG(vl."loss_rate_%"),2)                                       AS "avg_loss_rate_pct",
       ROUND(SUM(vt."unit_selling_px_rmb/kg" * vt."qty_sold(kg)" *
                 vl."loss_rate_%"/100),2)                                   AS "total_loss_rmb",
       -- profit = selling – wholesale – loss
       ROUND(SUM(vt."unit_selling_px_rmb/kg" * vt."qty_sold(kg)") -
             SUM(vw."whsle_px_rmb-kg" * vt."qty_sold(kg)") -
             SUM(vt."unit_selling_px_rmb/kg" * vt."qty_sold(kg)" *
                 vl."loss_rate_%"/100),2)                                   AS "profit_rmb"
FROM   "veg_whsle_df"    AS vw
JOIN   "veg_txn_df"      AS vt  ON vw."item_code" = vt."item_code"
                                  AND SUBSTR(vw."whsle_date",1,10) = SUBSTR(vt."txn_date",1,10)
JOIN   "veg_loss_rate_df" AS vl ON vw."item_code" = vl."item_code"
JOIN   "veg_cat"          AS vc ON vw."item_code" = vc."item_code"
WHERE  SUBSTR(vw."whsle_date",1,4) BETWEEN '2020' AND '2023'
GROUP  BY "year", vc."category_name"
LIMIT 20;
```
