       ROUND(MAX(vw."whsle_px_rmb-kg"),2)             AS "max_whsle_px",
       ROUND(MIN(vw."whsle_px_rmb-kg"),2)             AS "min_whsle_px",
       ROUND(MAX(vw."whsle_px_rmb-kg") -
             MIN(vw."whsle_px_rmb-kg"),2)             AS "whsle_px_diff"
FROM   "veg_whsle_df" AS vw
