Query:
--Description: Compute the month‑over‑month payment difference for every one of the ten highest‑paying customers
--and list the twenty largest changes (positive or negative).  Same CTE pattern as before:
-- 1) top10   – find top spenders, 2) monthly – monthly totals, 3) diffs – LAG to get difference.
WITH top10 AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
),
monthly AS (
    SELECT
        p.customer_id,
        strftime('%Y-%m', p.payment_date) AS yr_mo,
        SUM(p.amount) AS monthly_total
    FROM payment AS p
    JOIN top10 USING (customer_id)
    GROUP BY p.customer_id, yr_mo
),
diffs AS (
    SELECT
        customer_id,
        yr_mo,
        monthly_total
          - LAG(monthly_total) OVER (PARTITION BY customer_id ORDER BY yr_mo) AS diff
    FROM monthly
)
SELECT
    customer_id,
    yr_mo,
    ROUND(diff, 2) AS diff
FROM diffs
WHERE diff IS NOT NULL
ORDER BY ABS(diff) DESC
LIMIT 20
