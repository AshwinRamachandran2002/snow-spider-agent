-- Description: 3) Get monthly payment totals for ONLY the previously found top‑10 customers.
WITH top10 AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
)
SELECT
    p.customer_id,
    strftime('%Y-%m', p.payment_date) AS yr_mo,
    ROUND(SUM(p.amount),2)           AS monthly_total
FROM payment AS p
JOIN top10  USING (customer_id)
GROUP BY p.customer_id, yr_mo
ORDER BY p.customer_id, yr_mo
LIMIT 20;
