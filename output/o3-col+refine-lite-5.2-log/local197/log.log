```sql
-- Description / Thinking process:
-- 1) top10  : Determine which ten customers have paid the most in total so we restrict our search space.
-- 2) monthly: For those ten, aggregate each customer’s payments by calendar month (format YYYY‑MM).
-- 3) diffs  : Within every customer’s timeline, use LAG to compare each month’s total to the immediately
--             preceding month; keep the difference (positive or negative).
-- 4) FINAL  : Order by the absolute value of that difference to find the single largest jump (up or down)
--             and present the customer, the month in which it occurred, and the size of the change rounded
--             to two decimals.
WITH top10 AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
),
monthly AS (
    SELECT
        p.customer_id,
        strftime('%Y-%m', p.payment_date) AS yr_mo,
        SUM(p.amount) AS monthly_total
    FROM payment AS p
    JOIN top10 USING (customer_id)
    GROUP BY p.customer_id, yr_mo
),
diffs AS (
    SELECT
        customer_id,
        yr_mo,
        monthly_total
            - LAG(monthly_total) OVER (PARTITION BY customer_id ORDER BY yr_mo) AS diff
    FROM monthly
)
SELECT
    customer_id,
    yr_mo           AS month_of_max_change,
    ROUND(diff, 2)  AS max_month_over_month_difference
FROM diffs
WHERE diff IS NOT NULL
ORDER BY ABS(diff) DESC
LIMIT 1;
```
