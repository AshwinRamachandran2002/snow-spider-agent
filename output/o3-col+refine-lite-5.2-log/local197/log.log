```sql
-- Description: 1) Identify the ten customers who have paid the most in total.
SELECT 
    p.customer_id,
    ROUND(SUM(p.amount),2) AS total_paid
FROM payment AS p
GROUP BY p.customer_id
ORDER BY total_paid DESC
LIMIT 10;
```

```sql
-- Description: 2) Look at one customer’s raw payment dates to verify the timestamp format (year‑month‑day …).
SELECT DISTINCT 
    p.customer_id,
    p.payment_date
FROM payment AS p
WHERE p.customer_id = 1            -- change to any id from the first query
ORDER BY p.payment_date
LIMIT 20;
```

```sql
-- Description: 3) Get monthly payment totals for ONLY the previously found top‑10 customers.
WITH top10 AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
)
SELECT
    p.customer_id,
    strftime('%Y-%m', p.payment_date) AS yr_mo,
    ROUND(SUM(p.amount),2)           AS monthly_total
FROM payment AS p
JOIN top10  USING (customer_id)
GROUP BY p.customer_id, yr_mo
ORDER BY p.customer_id, yr_mo
LIMIT 20;
```

```sql
-- Description: 4) For one sample customer, display the month‑over‑month differences.
WITH top10 AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
),
monthly AS (
    SELECT
        p.customer_id,
        strftime('%Y-%m', p.payment_date) AS yr_mo,
        ROUND(SUM(p.amount),2)            AS monthly_total
    FROM payment AS p
    JOIN top10 USING (customer_id)
    GROUP BY p.customer_id, yr_mo
)
SELECT
    customer_id,
    yr_mo,
    monthly_total,
    LAG(monthly_total) OVER (PARTITION BY customer_id ORDER BY yr_mo)       AS prev_month_total,
    ROUND(monthly_total - LAG(monthly_total) OVER (PARTITION BY customer_id ORDER BY yr_mo),2) AS diff
FROM monthly
WHERE customer_id = 1                        -- pick any top‑10 id
ORDER BY yr_mo
LIMIT 20;
```

```sql
-- Description: 5) Compute month‑over‑month differences for every top‑10 customer, keeping the absolute value of the change.
WITH top10 AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
),
monthly AS (
    SELECT
        p.customer_id,
        strftime('%Y-%m', p.payment_date) AS yr_mo,
        ROUND(SUM(p.amount),2)            AS monthly_total
    FROM payment AS p
    JOIN top10 USING (customer_id)
    GROUP BY p.customer_id, yr_mo
),
mo_mo AS (
    SELECT
        customer_id,
        yr_mo,
        ROUND(monthly_total - LAG(monthly_total) OVER (PARTITION BY customer_id ORDER BY yr_mo),2) AS diff
    FROM monthly
)
SELECT *
FROM mo_mo
WHERE diff IS NOT NULL
ORDER BY ABS(diff) DESC
LIMIT 20;
```

```sql
-- Description: 6) Final answer – which customer, which month, and what is the largest month‑over‑month difference (rounded to 2 decimals)?
WITH top10 AS (
    SELECT customer_id
    FROM payment
    GROUP BY customer_id
    ORDER BY SUM(amount) DESC
    LIMIT 10
),
monthly AS (
    SELECT
        p.customer_id,
        strftime('%Y-%m', p.payment_date) AS yr_mo,
        ROUND(SUM(p.amount),2)            AS monthly_total
    FROM payment AS p
    JOIN top10 USING (customer_id)
    GROUP BY p.customer_id, yr_mo
),
mo_mo AS (
    SELECT
        customer_id,
        yr_mo,
        ROUND(monthly_total - LAG(monthly_total) OVER (PARTITION BY customer_id ORDER BY yr_mo),2) AS diff
    FROM monthly
)
SELECT 
    customer_id,
    yr_mo      AS month_with_max_change,
    ROUND(diff,2) AS max_month_over_month_difference
FROM mo_mo
WHERE ABS(diff) = (
    SELECT MAX(ABS(diff)) FROM mo_mo
);
```
