```sql
--Description: Inspect a handful of orders placed during calendar‑year 2021
SELECT 
    "order_id",
    "user_id",
    "status",
    "created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE "created_at" >= 1609459200000000   -- 2021‑01‑01 00:00:00
  AND "created_at" <  1640995200000000   -- 2022‑01‑01 00:00:00
LIMIT 20;
```

```sql
--Description: See users who registered in 2021 together with their country & timestamp
SELECT
    "id"            AS "user_id",
    "country",
    "created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE "created_at" >= 1609459200000000   -- 2021‑01‑01
  AND "created_at" <  1640995200000000   -- 2022‑01‑01
LIMIT 20;
```

```sql
--Description: Cross‑check that 2021 orders were made by 2021‑registered users
SELECT
    o."order_id",
    o."user_id",
    u."country",
    o."created_at"  AS "order_ts",
    u."created_at"  AS "user_signup_ts"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"  o
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"   u
      ON o."user_id" = u."id"
WHERE o."created_at" >= 1609459200000000
  AND o."created_at" <  1640995200000000
  AND u."created_at" >= 1609459200000000
  AND u."created_at" <  1640995200000000
LIMIT 20;
```

```sql
--Description: Glimpse inventory items first stocked (created) in 2021
SELECT
    "id"               AS "inventory_item_id",
    "product_id",
    "product_distribution_center_id",
    "created_at",
    "cost"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"
WHERE "created_at" >= 1609459200000000
  AND "created_at" <  1640995200000000
LIMIT 20;
```

```sql
--Description: Pair 2021 inventory items with their product’s department & category  
SELECT
    ii."id"               AS "inventory_item_id",
    p."department",
    p."category",
    p."retail_price",
    ii."cost"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"  ii
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"         p
      ON ii."product_id" = p."id"
WHERE ii."created_at" >= 1609459200000000
  AND ii."created_at" <  1640995200000000
LIMIT 20;
```

```sql
--Description: Look at order items that reference those inventory items
SELECT
    oi."id"                 AS "order_item_id",
    oi."order_id",
    oi."inventory_item_id",
    oi."sale_price",
    oi."created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii
      ON oi."inventory_item_id" = ii."id"
WHERE ii."created_at" >= 1609459200000000
  AND ii."created_at" <  1640995200000000
LIMIT 20;
```

```sql
--Description: Tie order items back to the parent orders (2021 only)
SELECT
    oi."order_id",
    o."created_at"        AS "order_ts",
    oi."inventory_item_id",
    oi."sale_price"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
      ON oi."order_id" = o."order_id"
WHERE o."created_at" >= 1609459200000000
  AND o."created_at" <  1640995200000000
LIMIT 20;
```

```sql
--Description: Full 2021 chain: order items ↔ orders ↔ users ↔ inventory items ↔ products  
SELECT
    oi."order_id",
    oi."user_id",
    u."country",
    p."department",
    p."category",
    o."created_at"            AS "order_ts",
    p."retail_price",
    ii."cost"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o   ON oi."order_id"  = o."order_id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u   ON oi."user_id"   = u."id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii ON oi."inventory_item_id" = ii."id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p   ON ii."product_id" = p."id"
WHERE o."created_at"  >= 1609459200000000
  AND o."created_at"  <  1640995200000000
  AND u."created_at"  >= 1609459200000000
  AND u."created_at"  <  1640995200000000
  AND ii."created_at" >= 1609459200000000
  AND ii."created_at" <  1640995200000000
LIMIT 20;
```

```sql
--Description: Preliminary monthly roll‑up – counts & profit by month, country, department, category
SELECT
    TO_VARCHAR(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at" / 1000000)))  AS "order_month",
    u."country",
    p."department",
    p."category",
    COUNT(DISTINCT o."order_id")                          AS "orders",
    COUNT(DISTINCT u."id")                                AS "unique_purchasers",
    SUM(p."retail_price" - ii."cost")                     AS "profit"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o   ON oi."order_id"  = o."order_id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u   ON oi."user_id"   = u."id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii ON oi."inventory_item_id" = ii."id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p   ON ii."product_id" = p."id"
WHERE o."created_at"  >= 1609459200000000
  AND o."created_at"  <  1640995200000000
  AND u."created_at"  >= 1609459200000000
  AND u."created_at"  <  1640995200000000
  AND ii."created_at" >= 1609459200000000
  AND ii."created_at" <  1640995200000000
GROUP BY 1,2,3,4
LIMIT 20;
```

```sql
--Description: Final check – top 20 rows of the fully‑specified 2021 monthly report, ordered for readability
SELECT
    TO_VARCHAR(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at" / 1000000)))  AS "order_month",
    u."country",
    p."department",
    p."category",
    COUNT(DISTINCT o."order_id")                          AS "orders",
    COUNT(DISTINCT u."id")                                AS "unique_purchasers",
    SUM(p."retail_price" - ii."cost")                     AS "profit"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o   ON oi."order_id"  = o."order_id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u   ON oi."user_id"   = u."id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii ON oi."inventory_item_id" = ii."id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p   ON ii."product_id" = p."id"
WHERE o."created_at"  >= 1609459200000000
  AND o."created_at"  <  1640995200000000
  AND u."created_at"  >= 1609459200000000
  AND u."created_at"  <  1640995200000000
  AND ii."created_at" >= 1609459200000000
  AND ii."created_at" <  1640995200000000
GROUP BY 1,2,3,4
ORDER BY "order_month", "country", "department", "category"
LIMIT 20;
```
