```sql
-- 1.  What belts have “NXT” in their name?
SELECT DISTINCT id, name
FROM Belts
WHERE name LIKE '%NXT%'
LIMIT 20;
```

```sql
-- 2.  All matches where one of those “NXT” belts was on the line (show a few columns).
SELECT id, card_id, winner_id, loser_id, duration, title_id, title_change
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
LIMIT 20;
```

```sql
-- 3.  Same set but only the matches in which the title did NOT change.
SELECT id, card_id, winner_id, loser_id, duration
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
LIMIT 20;
```

```sql
-- 4.  Keep the previous filter and discard rows that have an empty duration string.
SELECT id, winner_id, loser_id, duration
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
  AND duration <> ''
LIMIT 20;
```

```sql
-- 5.  Order those matches by duration (shortest first) so we can pick the top one.
SELECT id, winner_id, loser_id, duration
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
  AND duration <> ''
ORDER BY duration
LIMIT 20;
```

```sql
-- 6.  Convert the “mm:ss” duration into seconds and order numerically, then grab only the very shortest match.
SELECT id,
       winner_id,
       loser_id,
       duration,
       (CAST(substr(duration,1,2) AS INTEGER)*60 + CAST(substr(duration,4,2) AS INTEGER)) AS secs
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
  AND duration GLOB '[0-9][0-9]:[0-9][0-9]'
ORDER BY secs
LIMIT 1;
```

```sql
-- 7.  Join the result of the previous query to Wrestlers to get both wrestler names.
SELECT w1.name AS winner,
       w2.name AS loser,
       m.duration
FROM Matches AS m
JOIN Wrestlers AS w1 ON w1.id = CAST(m.winner_id AS INTEGER)
JOIN Wrestlers AS w2 ON w2.id = CAST(m.loser_id  AS INTEGER)
WHERE m.id = (
      SELECT id
      FROM Matches
      WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
        AND title_change = 0
        AND duration GLOB '[0-9][0-9]:[0-9][0-9]'
      ORDER BY (CAST(substr(duration,1,2) AS INTEGER)*60 + CAST(substr(duration,4,2) AS INTEGER))
      LIMIT 1
);
```

```sql
-- 8.  Show only the two names (final answer).
SELECT w1.name AS wrestler_1,
       w2.name AS wrestler_2
FROM Matches AS m
JOIN Wrestlers AS w1 ON w1.id = CAST(m.winner_id AS INTEGER)
JOIN Wrestlers AS w2 ON w2.id = CAST(m.loser_id  AS INTEGER)
WHERE m.id = (
      SELECT id
      FROM Matches
      WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
        AND title_change = 0
        AND duration GLOB '[0-9][0-9]:[0-9][0-9]'
      ORDER BY (CAST(substr(duration,1,2) AS INTEGER)*60 + CAST(substr(duration,4,2) AS INTEGER))
      LIMIT 1
);
```

```sql
-- 9.  (Optional sanity‑check) Verify that there is just one such shortest match.
SELECT COUNT(*) AS how_many_rows
FROM (
      SELECT duration
      FROM Matches
      WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
        AND title_change = 0
        AND duration GLOB '[0-9][0-9]:[0-9][0-9]'
      ORDER BY (CAST(substr(duration,1,2) AS INTEGER)*60 + CAST(substr(duration,4,2) AS INTEGER))
      LIMIT 1
);
```

```sql
-- 10.  Everything tied together: duration (in seconds) + two names for that single record.
SELECT (CAST(substr(m.duration,1,2) AS INTEGER)*60 + CAST(substr(m.duration,4,2) AS INTEGER)) AS seconds,
       w1.name AS wrestler_1,
       w2.name AS wrestler_2
FROM Matches AS m
JOIN Wrestlers AS w1 ON w1.id = CAST(m.winner_id AS INTEGER)
JOIN Wrestlers AS w2 ON w2.id = CAST(m.loser_id  AS INTEGER)
