-- 5.  Order those matches by duration (shortest first) so we can pick the top one.
SELECT id, winner_id, loser_id, duration
FROM Matches
WHERE title_id IN (SELECT id FROM Belts WHERE name LIKE '%NXT%')
  AND title_change = 0
  AND duration <> ''
ORDER BY duration
LIMIT 20;
