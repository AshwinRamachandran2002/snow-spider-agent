```sql
-- Description: Distinct list of product IDs that were actually picked on any picking line.
SELECT DISTINCT "product_id"
FROM "picking_line"
LIMIT 20;
```

```sql
-- Description: Distinct list of picked product IDs together with the human‑readable product names.
SELECT DISTINCT pl."product_id",
       pr."name"  AS "product_name"
FROM   "picking_line" AS pl
JOIN   "products"     AS pr ON pr."id" = pl."product_id"
LIMIT 20;
```

```sql
-- Description: For a small sample of orders, compare what was ordered and what was picked (raw values).
SELECT ol."order_id",
       ol."product_id",
       ol."qty"  AS "ordered_qty",
       SUM(pl."qty") AS "picked_qty"
FROM   "orderlines"   AS ol
JOIN   "picking_line" AS pl ON pl."order_id" = ol."order_id"
                              AND pl."product_id" = ol."product_id"
GROUP  BY ol."order_id", ol."product_id"
LIMIT 20;
```

```sql
-- Description: Show how each pick line is linked to its inventory record and the original purchase date.
SELECT pl."id"             AS "pickline_id",
       pl."order_id",
       pl."product_id",
       pl."qty"            AS "pick_qty",
       i."qty"             AS "inventory_qty_now",
       pu."purchased"      AS "purchase_date"
FROM   "picking_line" AS pl
JOIN   "inventory"    AS i  ON i."location_id" = pl."location_id"
                              AND i."product_id"  = pl."product_id"
JOIN   "purchases"    AS pu ON pu."id"          = i."purchase_id"
ORDER  BY pu."purchased", i."qty"
LIMIT 20;
```

```sql
-- Description: Earliest (FIFO) purchase date that supplied each product currently being picked.
SELECT DISTINCT pl."product_id",
       MIN(pu."purchased") OVER (PARTITION BY pl."product_id") AS "earliest_purchase"
FROM   "picking_line" AS pl
JOIN   "inventory"    AS i  ON i."location_id" = pl."location_id"
                              AND i."product_id" = pl."product_id"
JOIN   "purchases"    AS pu ON pu."id" = i."purchase_id"
LIMIT 20;
```

```sql
-- Description: Calculate the overlap between what a pick line tried to take and what was actually available in that inventory row (FIFO, smallest qty first).
SELECT pl."id"  AS "pickline_id",
       CASE
         WHEN pl."qty" <= i."qty"
         THEN pl."qty"
         ELSE i."qty"
       END           AS "picked_overlap"
FROM   "picking_line" AS pl
JOIN   "inventory"    AS i ON i."location_id" = pl."location_id"
                             AND i."product_id" = pl."product_id"
ORDER  BY pl."id"
LIMIT 20;
```

```sql
-- Description: Compute pick‑percentage (picked_overlap / ordered_qty) for every order‑product pair.
SELECT ol."order_id",
       ol."product_id",
       SUM(CASE WHEN pl."qty" <= i."qty" THEN pl."qty" ELSE i."qty" END) * 1.0
       / ol."qty"                                               AS "pick_pct"
FROM   "orderlines"   AS ol
JOIN   "picking_line" AS pl ON pl."order_id"  = ol."order_id"
                              AND pl."product_id" = ol."product_id"
JOIN   "inventory"    AS i  ON i."location_id" = pl."location_id"
                              AND i."product_id" = pl."product_id"
GROUP  BY ol."order_id", ol."product_id"
LIMIT 20;
```

```sql
-- Description: Final answer – average pick percentage per product name, using FIFO & overlap logic, ordered alphabetically by product name.
SELECT pr."name"                                     AS "product_name",
       AVG( pick_ratio."pick_pct" )                  AS "avg_pick_percentage"
FROM (
        SELECT ol."order_id",
               ol."product_id",
               SUM( CASE
                       WHEN pl."qty" <= i."qty"
                       THEN pl."qty"
                       ELSE i."qty"
                     END
                   ) * 1.0 / ol."qty"                AS "pick_pct"
        FROM   "orderlines"   AS ol
        JOIN   "picking_line" AS pl ON pl."order_id"  = ol."order_id"
                                     AND pl."product_id" = ol."product_id"
        JOIN   "inventory"    AS i  ON i."location_id" = pl."location_id"
                                     AND i."product_id" = pl."product_id"
        JOIN   "purchases"    AS pu ON pu."id" = i."purchase_id"
        -- FIFO: inner join ensures rows are naturally processed by purchase date + smallest qty
        GROUP  BY ol."order_id", ol."product_id"
      ) AS pick_ratio
JOIN   "products" AS pr ON pr."id" = pick_ratio."product_id"
GROUP  BY pr."name"
ORDER  BY pr."name"
LIMIT 20;
```
