-- Description: For a small sample of orders, compare what was ordered and what was picked (raw values).
SELECT ol."order_id",
       ol."product_id",
       ol."qty"  AS "ordered_qty",
       SUM(pl."qty") AS "picked_qty"
FROM   "orderlines"   AS ol
JOIN   "picking_line" AS pl ON pl."order_id" = ol."order_id"
                              AND pl."product_id" = ol."product_id"
