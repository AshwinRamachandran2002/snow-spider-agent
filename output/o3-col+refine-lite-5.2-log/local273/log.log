```sql
-- Description: Final answer – average pick percentage per product name, using FIFO & overlap logic, ordered alphabetically by product name.
SELECT pr.name                    AS product_name,
       AVG(pick_ratio.pick_pct)   AS avg_pick_percentage
FROM (
        SELECT ol.order_id,
               ol.product_id,
               SUM( CASE
                       WHEN pl.qty <= i.qty THEN pl.qty ELSE i.qty
                     END ) * 1.0 / ol.qty AS pick_pct
        FROM   orderlines   AS ol
        JOIN   picking_line AS pl ON pl.order_id   = ol.order_id
                                   AND pl.product_id = ol.product_id
        JOIN   inventory    AS i  ON i.location_id = pl.location_id
                                   AND i.product_id = pl.product_id
