--Description: Show the net running balance for one example customer (id = 429)
WITH ordered_txns AS (
    SELECT "txn_date",
           CASE 
               WHEN "txn_type" = 'deposit'  THEN  1 * "txn_amount"
               WHEN "txn_type" = 'withdraw' THEN -1 * "txn_amount"
               ELSE 0
           END AS "signed_amt"
    FROM   "customer_transactions"
    WHERE  "customer_id" = 429
    ORDER  BY "txn_date"
)
SELECT "txn_date",
       SUM("signed_amt") OVER (ORDER BY "txn_date") AS "running_balance"
FROM   ordered_txns
LIMIT 20;
