```sql
--Description: Show the net running balance for one example customer (id = 429)
WITH ordered_txns AS (
    SELECT "txn_date",
           CASE 
               WHEN "txn_type" = 'deposit'  THEN  1 * "txn_amount"
               WHEN "txn_type" = 'withdraw' THEN -1 * "txn_amount"
               ELSE 0
           END AS "signed_amt"
    FROM   "customer_transactions"
    WHERE  "customer_id" = 429
    ORDER  BY "txn_date"
)
SELECT "txn_date",
       SUM("signed_amt") OVER (ORDER BY "txn_date") AS "running_balance"
FROM   ordered_txns
LIMIT 20;
```

```sql
--Description: Produce a date spine (all dates) for one customer (id = 429) between their min‑max dates
WITH RECURSIVE dates AS (
    SELECT MIN("txn_date") AS d,
           MAX("txn_date") AS max_d
    FROM   "customer_transactions"
    WHERE  "customer_id" = 429
    UNION ALL
    SELECT date(d, '+1 day'),
           max_d
    FROM   dates
    WHERE  d < max_d
)
SELECT d AS "calendar_date"
FROM   dates
LIMIT 20;
```

```sql
--Description: Combine the date spine with daily balances, carrying forward the last balance (customer 429)
WITH RECURSIVE dates AS (
    SELECT MIN("txn_date") AS d,
           MAX("txn_date") AS max_d
    FROM   "customer_transactions"
    WHERE  "customer_id" = 429
    UNION ALL
    SELECT date(d, '+1 day'),
           max_d
    FROM   dates
    WHERE  d < max_d
),
signed_txns AS (
    SELECT "txn_date",
           CASE 
               WHEN "txn_type" = 'deposit'  THEN  "txn_amount"
               WHEN "txn_type" = 'withdraw' THEN -1 * "txn_amount"
               ELSE 0
           END AS "signed_amt"
    FROM   "customer_transactions"
    WHERE  "customer_id" = 429
),
daily_sums AS (
    SELECT "txn_date",
           SUM("signed_amt") AS "net_change"
    FROM   signed_txns
    GROUP  BY "txn_date"
),
balances AS (
    SELECT d,
           COALESCE(net_change, 0) AS net_change,
           SUM(COALESCE(net_change, 0)) OVER (ORDER BY d) AS running_bal
    FROM   dates
    LEFT   JOIN daily_sums ON d = daily_sums."txn_date"
)
SELECT d AS "calendar_date",
       CASE WHEN running_bal < 0 THEN 0 ELSE running_bal END AS "daily_balance_capped"
FROM   balances
LIMIT 20;
```

```sql
--Description: For every customer & day, compute non‑negative daily balance (capped at zero)
WITH signed AS (
    SELECT "customer_id",
           "txn_date",
           CASE 
               WHEN "txn_type" = 'deposit'  THEN  "txn_amount"
               WHEN "txn_type" = 'withdraw' THEN -1 * "txn_amount"
               ELSE 0
           END AS "signed_amt"
    FROM   "customer_transactions"
),
daily   AS (
    SELECT "customer_id",
           "txn_date",
           SUM("signed_amt") AS "net_change"
    FROM   signed
    GROUP  BY "customer_id","txn_date"
),
-- build a full calendar per customer
date_span AS (
    SELECT c."customer_id",
           MIN(c."txn_date") AS start_d,
           MAX(c."txn_date") AS end_d
    FROM   "customer_transactions" c
    GROUP  BY c."customer_id"
),
cal AS (
    SELECT customer_id,
           start_d AS d,
           end_d
    FROM   date_span
    UNION ALL
    SELECT customer_id,
           date(d,'+1 day'),
           end_d
    FROM   cal
    WHERE  d < end_d
),
joined AS (
    SELECT cal.customer_id,
           cal.d AS calendar_date,
           COALESCE(daily.net_change,0) AS net_change
    FROM   cal
    LEFT   JOIN daily
    ON     cal.customer_id = daily."customer_id"
       AND cal.d          = daily."txn_date"
),
running AS (
    SELECT customer_id,
           calendar_date,
           SUM(net_change) OVER (PARTITION BY customer_id ORDER BY calendar_date) AS bal
    FROM   joined
)
SELECT customer_id,
       calendar_date,
       CASE WHEN bal < 0 THEN 0 ELSE bal END AS daily_balance
FROM   running
LIMIT 20;
```

```sql
--Description: For each customer & month, find the maximum daily balance in that month
WITH per_day AS (
    /* reuse running daily balance logic from previous CTE */
    WITH signed AS (
        SELECT "customer_id",
               "txn_date",
               CASE 
                   WHEN "txn_type" = 'deposit'  THEN  "txn_amount"
                   WHEN "txn_type" = 'withdraw' THEN -1 * "txn_amount"
                   ELSE 0
               END AS "signed_amt"
        FROM   "customer_transactions"
    ),
    daily   AS (
        SELECT "customer_id",
               "txn_date",
               SUM("signed_amt") AS "net_change"
        FROM   signed
        GROUP  BY "customer_id","txn_date"
    ),
    date_span AS (
        SELECT "customer_id",
               MIN("txn_date") AS start_d,
               MAX("txn_date") AS end_d
        FROM   "customer_transactions"
        GROUP  BY "customer_id"
    ),
    cal AS (
        SELECT customer_id,
               start_d AS d,
               end_d
        FROM   date_span
        UNION ALL
        SELECT customer_id,
               date(d,'+1 day'),
               end_d
        FROM   cal
        WHERE  d < end_d
    ),
    joined AS (
        SELECT cal.customer_id,
               cal.d AS calendar_date,
               COALESCE(daily.net_change,0) AS net_change
        FROM   cal
        LEFT   JOIN daily
        ON     cal.customer_id = daily."customer_id"
           AND cal.d          = daily."txn_date"
    ),
    running AS (
        SELECT customer_id,
               calendar_date,
               SUM(net_change) OVER (PARTITION BY customer_id ORDER BY calendar_date) AS bal
        FROM   joined
    )
    SELECT customer_id,
           calendar_date,
           CASE WHEN bal < 0 THEN 0 ELSE bal END AS daily_balance
    FROM   running
)
SELECT customer_id,
       substr(calendar_date,1,7) AS month,
       MAX(daily_balance)        AS max_daily_bal_in_month
FROM   per_day
GROUP  BY customer_id, month
ORDER  BY month, customer_id
LIMIT 20;
```

```sql
--Description: Sum each month’s customer‑level maximum balances to get the overall monthly total
WITH per_day AS (
    /* same daily balance CTE as above */
    WITH signed AS (
        SELECT "customer_id",
               "txn_date",
               CASE 
                   WHEN "txn_type" = 'deposit'  THEN  "txn_amount"
                   WHEN "txn_type" = 'withdraw' THEN -1 * "txn_amount"
                   ELSE 0
               END AS "signed_amt"
        FROM   "customer_transactions"
    ),
    daily   AS (
        SELECT "customer_id",
               "txn_date",
               SUM("signed_amt") AS "net_change"
        FROM   signed
        GROUP  BY "customer_id","txn_date"
    ),
    date_span AS (
        SELECT "customer_id",
               MIN("txn_date") AS start_d,
               MAX("txn_date") AS end_d
        FROM   "customer_transactions"
        GROUP  BY "customer_id"
    ),
    cal AS (
        SELECT customer_id,
               start_d AS d,
               end_d
        FROM   date_span
        UNION ALL
        SELECT customer_id,
               date(d,'+1 day'),
               end_d
        FROM   cal
        WHERE  d < end_d
    ),
    joined AS (
        SELECT cal.customer_id,
               cal.d AS calendar_date,
               COALESCE(daily.net_change,0) AS net_change
        FROM   cal
        LEFT   JOIN daily
        ON     cal.customer_id = daily."customer_id"
           AND cal.d          = daily."txn_date"
    ),
    running AS (
        SELECT customer_id,
               calendar_date,
               SUM(net_change) OVER (PARTITION BY customer_id ORDER BY calendar_date) AS bal
        FROM   joined
    )
    SELECT customer_id,
           calendar_date,
           CASE WHEN bal < 0 THEN 0 ELSE bal END AS daily_balance
    FROM   running
),
cust_month_max AS (
    SELECT customer_id,
           substr(calendar_date,1,7) AS month,
           MAX(daily_balance)        AS max_daily_bal
    FROM   per_day
    GROUP  BY customer_id, month
)
SELECT month,
       SUM(max_daily_bal) AS monthly_total_max_balance
FROM   cust_month_max
GROUP  BY month
ORDER  BY month
LIMIT 20;
```
