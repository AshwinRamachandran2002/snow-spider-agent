--Description: For each customer & month, find the maximum daily balance in that month
WITH per_day AS (
    /* reuse running daily balance logic from previous CTE */
    WITH signed AS (
        SELECT "customer_id",
               "txn_date",
               CASE 
                   WHEN "txn_type" = 'deposit'  THEN  "txn_amount"
                   WHEN "txn_type" = 'withdraw' THEN -1 * "txn_amount"
                   ELSE 0
               END AS "signed_amt"
        FROM   "customer_transactions"
    ),
    daily   AS (
        SELECT "customer_id",
               "txn_date",
               SUM("signed_amt") AS "net_change"
        FROM   signed
        GROUP  BY "customer_id","txn_date"
    ),
    date_span AS (
        SELECT "customer_id",
               MIN("txn_date") AS start_d,
               MAX("txn_date") AS end_d
        FROM   "customer_transactions"
        GROUP  BY "customer_id"
    ),
    cal AS (
        SELECT customer_id,
               start_d AS d,
               end_d
        FROM   date_span
        UNION ALL
        SELECT customer_id,
               date(d,'+1 day'),
               end_d
        FROM   cal
        WHERE  d < end_d
    ),
    joined AS (
        SELECT cal.customer_id,
               cal.d AS calendar_date,
               COALESCE(daily.net_change,0) AS net_change
        FROM   cal
        LEFT   JOIN daily
        ON     cal.customer_id = daily."customer_id"
           AND cal.d          = daily."txn_date"
    ),
    running AS (
        SELECT customer_id,
               calendar_date,
               SUM(net_change) OVER (PARTITION BY customer_id ORDER BY calendar_date) AS bal
        FROM   joined
    )
    SELECT customer_id,
           calendar_date,
           CASE WHEN bal < 0 THEN 0 ELSE bal END AS daily_balance
    FROM   running
)
SELECT customer_id,
       substr(calendar_date,1,7) AS month,
       MAX(daily_balance)        AS max_daily_bal_in_month
FROM   per_day
GROUP  BY customer_id, month
ORDER  BY month, customer_id
LIMIT 20;
