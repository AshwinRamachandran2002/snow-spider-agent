```

```sql
--Description: 2) Return 20 sample patent publications whose country code is Canada (“CA”)  
SELECT "publication_number",
       "publication_date",
       "kind_code",
       "application_kind",
       "family_id"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
LIMIT 20;
```

```sql
--Description: 3) Inspect the raw “inventor” JSON/ARRAY for a handful of Canadian patent publications  
SELECT "publication_number",
       "inventor"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
  AND "inventor" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4) Flatten the “inventor” array for a sample set of Canadian publications to see each inventor name separately  
SELECT t."publication_number",
       inv.value::STRING AS "inventor_name"
FROM PATENTS.PATENTS.PUBLICATIONS  t,
     LATERAL FLATTEN(input => t."inventor") inv
WHERE t."country_code" = 'CA'
LIMIT 20;
```

```sql
--Description: 5) Count the number of inventors on each Canadian patent publication (sample of 20)  
SELECT t."publication_number",
       COUNT(inv.value) AS "inventor_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."inventor") inv
WHERE t."country_code" = 'CA'
GROUP BY t."publication_number"
ORDER BY "inventor_cnt" DESC
LIMIT 20;
```

```sql
--Description: 6) Compute the average number of inventors per Canadian patent publication for each publication year (1960‑2020 range)  
SELECT TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) AS "pub_year",
       AVG(inv_cnt)  AS "avg_inventors",
       COUNT(*)      AS "pub_cnt"
FROM (
      SELECT t."publication_number",
             COUNT(inv.value) AS inv_cnt,
             t."publication_date"
      FROM PATENTS.PATENTS.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."inventor") inv
      WHERE t."country_code" = 'CA'
      GROUP BY t."publication_number", t."publication_date"
) q
WHERE "pub_year" BETWEEN 1960 AND 2020
GROUP BY "pub_year"
ORDER BY "pub_year"
LIMIT 20;
```

```sql
--Description: 7) Bucket Canadian patent publications into 5‑year intervals between 1960‑1964, 1965‑1969, … 2015‑2019.  
SELECT CASE
         WHEN TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 1960 AND 1964 THEN '1960‑1964'
         WHEN TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 1965 AND 1969 THEN '1965‑1969'
         WHEN TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 1970 AND 1974 THEN '1970‑1974'
         WHEN TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 1975 AND 1979 THEN '1975‑1979'
         WHEN TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 1980 AND 1984 THEN '1980‑1984'
         WHEN TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 1985 AND 1989 THEN '1985‑1989'
         WHEN TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 1990 AND 1994 THEN '1990‑1994'
         WHEN TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 1995 AND 1999 THEN '1995‑1999'
         WHEN TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 2000 AND 2004 THEN '2000‑2004'
         WHEN TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 2005 AND 2009 THEN '2005‑2009'
         WHEN TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 2010 AND 2014 THEN '2010‑2014'
         WHEN TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 2015 AND 2019 THEN '2015‑2019'
         WHEN TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 2020 AND 2020 THEN '2020‑2020'
       END AS "five_year_period",
       COUNT(*) AS "pub_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CA'
  AND TO_NUMBER(LEFT(CAST("publication_date" AS TEXT),4)) BETWEEN 1960 AND 2020
GROUP BY "five_year_period"
ORDER BY "five_year_period"
LIMIT 20;
```

```sql
--Description: 8) Build a sub‑query to keep only Canadian publications that have ≥1 inventor, then aggregate inventor counts by 5‑year periods  
WITH ca_inv AS (
  SELECT t."publication_number",
         COUNT(inv.value) AS inv_cnt,
         TO_NUMBER(LEFT(CAST(t."publication_date" AS TEXT),4)) AS pub_year
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."inventor") inv
  WHERE t."country_code" = 'CA'
  GROUP BY t."publication_number", t."publication_date"
  HAVING inv_cnt > 0
)
SELECT CASE
         WHEN pub_year BETWEEN 1960 AND 1964 THEN '1960‑1964'
         WHEN pub_year BETWEEN 1965 AND 1969 THEN '1965‑1969'
         WHEN pub_year BETWEEN 1970 AND 1974 THEN '1970‑1974'
         WHEN pub_year BETWEEN 1975 AND 1979 THEN '1975‑1979'
         WHEN pub_year BETWEEN 1980 AND 1984 THEN '1980‑1984'
         WHEN pub_year BETWEEN 1985 AND 1989 THEN '1985‑1989'
         WHEN pub_year BETWEEN 1990 AND 1994 THEN '1990‑1994'
         WHEN pub_year BETWEEN 1995 AND 1999 THEN '1995‑1999'
         WHEN pub_year BETWEEN 2000 AND 2004 THEN '2000‑2004'
         WHEN pub_year BETWEEN 2005 AND 2009 THEN '2005‑2009'
         WHEN pub_year BETWEEN 2010 AND 2014 THEN '2010‑2014'
         WHEN pub_year BETWEEN 2015 AND 2019 THEN '2015‑2019'
         WHEN pub_year BETWEEN 2020 AND 2020 THEN '2020‑2020'
       END AS "five_year_period",
       AVG(inv_cnt) AS "avg_inventors",
       COUNT(*)    AS "pub_cnt"
FROM ca_inv
GROUP BY "five_year_period"
ORDER BY "five_year_period"
LIMIT 20;
```

```sql
--Description: 9) Quick check of 1960‑1964 bucket only – average inventors and publication count for Canada  
WITH ca_inv AS (
  SELECT t."publication_number",
         COUNT(inv.value) AS inv_cnt,
         TO_NUMBER(LEFT(CAST(t."publication_date" AS TEXT),4)) AS pub_year
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."inventor") inv
  WHERE t."country_code" = 'CA'
  GROUP BY t."publication_number", t."publication_date"
  HAVING inv_cnt > 0
)
SELECT AVG(inv_cnt) AS "avg_inventors_1960_64",
       COUNT(*)     AS "pub_cnt_1960_64"
FROM ca_inv
WHERE pub_year BETWEEN 1960 AND 1964;
```

```sql
--Description: 10) Final comprehensive query – average inventors and total publication count for each 5‑year period (1960‑2020) for Canadian patents with ≥1 inventor  
WITH ca_inv AS (
  SELECT t."publication_number",
         COUNT(inv.value) AS inv_cnt,
         TO_NUMBER(LEFT(CAST(t."publication_date" AS TEXT),4)) AS pub_year
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."inventor") inv
  WHERE t."country_code" = 'CA'
  GROUP BY t."publication_number", t."publication_date"
  HAVING inv_cnt > 0
)
SELECT CASE
         WHEN pub_year BETWEEN 1960 AND 1964 THEN '1960‑1964'
         WHEN pub_year BETWEEN 1965 AND 1969 THEN '1965‑1969'
         WHEN pub_year BETWEEN 1970 AND 1974 THEN '1970‑1974'
         WHEN pub_year BETWEEN 1975 AND 1979 THEN '1975‑1979'
         WHEN pub_year BETWEEN 1980 AND 1984 THEN '1980‑1984'
         WHEN pub_year BETWEEN 1985 AND 1989 THEN '1985‑1989'
         WHEN pub_year BETWEEN 1990 AND 1994 THEN '1990‑1994'
         WHEN pub_year BETWEEN 1995 AND 1999 THEN '1995‑1999'
         WHEN pub_year BETWEEN 2000 AND 2004 THEN '2000‑2004'
         WHEN pub_year BETWEEN 2005 AND 2009 THEN '2005‑2009'
         WHEN pub_year BETWEEN 2010 AND 2014 THEN '2010‑2014'
         WHEN pub_year BETWEEN 2015 AND 2019 THEN '2015‑2019'
         WHEN pub_year BETWEEN 2020 AND 2020 THEN '2020‑2020'
       END AS "five_year_period",
       AVG(inv_cnt) AS "avg_inventors",
       COUNT(*)    AS "pub_cnt"
FROM ca_inv
GROUP BY "five_year_period"
ORDER BY "five_year_period";
```

