Query:
--Description: 9) Quick check of 1960‑1964 bucket only – average inventors and publication count for Canada  
WITH ca_inv AS (
  SELECT t."publication_number",
         COUNT(inv.value) AS inv_cnt,
         TO_NUMBER(LEFT(CAST(t."publication_date" AS TEXT),4)) AS pub_year
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."inventor") inv
  WHERE t."country_code" = 'CA'
  GROUP BY t."publication_number", t."publication_date"
  HAVING inv_cnt > 0
)
SELECT AVG(inv_cnt) AS "avg_inventors_1960_64",
       COUNT(*)     AS "pub_cnt_1960_64"
FROM ca_inv
WHERE pub_year BETWEEN 1960 AND 1964;
