```

```sql
-- 8️⃣  Total sales for each attribute value in the ❷ 12‑weeks AFTER 15‑Jun‑2020
WITH weeks_after AS (
    SELECT *
    FROM cleaned_weekly_sales
    WHERE week_date BETWEEN date('2020-06-15', '+7 days')   -- 2020‑06‑22
                      AND date('2020-06-15', '+84 days')    -- 2020‑09‑07
)
SELECT region      AS attribute_value,
       SUM(sales)  AS after_sales
FROM weeks_after
GROUP BY region
LIMIT 20;
```

```sql
-- 9️⃣  Percentage‑change for every attribute value (example shown for REGION)
WITH weeks_before AS (
    SELECT *
    FROM cleaned_weekly_sales
    WHERE week_date BETWEEN date('2020-06-15', '-84 days')
                      AND '2020-06-15'
), weeks_after AS (
    SELECT *
    FROM cleaned_weekly_sales
    WHERE week_date BETWEEN date('2020-06-15', '+7 days')
                      AND date('2020-06-15', '+84 days')
), before_tot AS (
    SELECT region, SUM(sales) AS before_sales
    FROM weeks_before
    GROUP BY region
), after_tot AS (
    SELECT region, SUM(sales) AS after_sales
    FROM weeks_after
    GROUP BY region
)
SELECT a.region                                    AS region,
       ROUND(100.0*(a.after_sales-b.before_sales)
/ b.before_sales,2)                                AS pct_change
FROM before_tot b
JOIN after_tot  a USING(region)
ORDER BY pct_change
LIMIT 20;
```

```sql
-- 🔟  FINAL: average % change for each ATTRIBUTE TYPE
WITH period_def AS (
     SELECT *,
            CASE
               WHEN week_date BETWEEN date('2020-06-15', '-84 days')
                                AND '2020-06-15'                THEN 'before'
               WHEN week_date BETWEEN date('2020-06-15', '+7 days')
                                AND date('2020-06-15', '+84 days') THEN 'after'
            END AS period_flag
     FROM cleaned_weekly_sales
     WHERE week_date BETWEEN date('2020-06-15', '-84 days')
                         AND date('2020-06-15', '+84 days')
), totals AS (
     /* region, platform, age_band, demographic, customer_type
        are all unpivoted into the same union so we can treat
        every “attribute type” in one go                                */
     SELECT 'region'        AS attribute_type, region        AS attribute_value, period_flag, SUM(sales) AS sales
     FROM period_def GROUP BY region,        period_flag
     UNION ALL
     SELECT 'platform',       platform,        period_flag, SUM(sales) FROM period_def GROUP BY platform,     period_flag
     UNION ALL
     SELECT 'age_band',       age_band,        period_flag, SUM(sales) FROM period_def GROUP BY age_band,     period_flag
     UNION ALL
     SELECT 'demographic',    demographic,     period_flag, SUM(sales) FROM period_def GROUP BY demographic,  period_flag
     UNION ALL
     SELECT 'customer_type',  customer_type,   period_flag, SUM(sales) FROM period_def GROUP BY customer_type,period_flag
), pivot AS (
     /* put before/after on the same row */
     SELECT attribute_type,
            attribute_value,
            SUM(CASE WHEN period_flag='before' THEN sales END) AS before_sales,
            SUM(CASE WHEN period_flag='after'  THEN sales END) AS after_sales
     FROM totals
     GROUP BY attribute_type, attribute_value
), pct AS (
     SELECT attribute_type,
            attribute_value,
            ROUND(100.0*(after_sales-before_sales)/before_sales,2) AS pct_change
     FROM pivot
     WHERE before_sales>0
), avg_pct AS (
     SELECT attribute_type,
            ROUND(AVG(pct_change),2) AS avg_pct_change
     FROM pct
     GROUP BY attribute_type
)
SELECT *
FROM avg_pct
ORDER BY avg_pct_change;   -- most negative at top
```

Running the final query (`avg_pct`) produces something similar to:

