```sql
--Description / Thinking process:
-- Goal: list the 20 greatest “jumps” (largest squared distance) between consecutive rows when the
--       geolocation table is ordered by state → city → zip_prefix → latitude → longitude.
-- Why sub‑query?  SQLite does not allow a window function (LAG) result to be used directly in a
--       WHERE clause on the same query block, so we calculate everything first, then filter.
-- Steps:
--   1. In the sub‑query:
--        • Use LAG to fetch the previous row’s state, city, latitude, longitude in the mandated order.
--        • Compute distance_sq = (Δlat)² + (Δlng)².
--   2. In the outer query:
--        • Keep only rows that actually have a predecessor (prev_lat IS NOT NULL).
--        • Order by distance_sq descending.
--        • Return the top 20 rows showing current and previous location information.
SELECT
       sub."geolocation_state",
       sub."geolocation_city",
       sub."geolocation_lat",
       sub."geolocation_lng",
       sub."prev_state",
       sub."prev_city",
       sub."prev_lat",
       sub."prev_lng",
       sub."distance_sq"
FROM (
        SELECT
               "geolocation_state",
               "geolocation_city",
               "geolocation_lat",
               "geolocation_lng",
               LAG("geolocation_state") OVER w AS "prev_state",
               LAG("geolocation_city")  OVER w AS "prev_city",
               LAG("geolocation_lat")   OVER w AS "prev_lat",
               LAG("geolocation_lng")   OVER w AS "prev_lng",
               ( ("geolocation_lat" - LAG("geolocation_lat") OVER w) *
                 ("geolocation_lat" - LAG("geolocation_lat") OVER w) +
                 ("geolocation_lng" - LAG("geolocation_lng") OVER w) *
                 ("geolocation_lng" - LAG("geolocation_lng") OVER w) ) AS "distance_sq"
        FROM   "olist_geolocation"
        WINDOW w AS (
               ORDER BY "geolocation_state",
                        "geolocation_city",
                        "geolocation_zip_code_prefix",
                        "geolocation_lat",
                        "geolocation_lng")
) AS sub
WHERE sub."prev_lat" IS NOT NULL
ORDER BY sub."distance_sq" DESC
LIMIT 20;
