```sql
--Description / Thought‑process:
-- Goal: find the two consecutive rows (in the mandated ordering of state, city, zip, lat, lng)
-- whose geographic coordinates differ the most.  Because SQLite here lacks SQRT or trigonometric
-- functions, ranking by squared‑distance (Δlat² + Δlng²) is sufficient—the largest squared
-- distance corresponds to the largest actual distance.  We:
--   1) use the window function LAG to pull the previous row’s latitude & longitude,
--   2) compute the squared distance between the current row and that previous row,
--   3) order all rows by this distance in descending order,
--   4) return the top row, which carries both the “previous” (city_A/state_A) and
--      the “current” (city_B/state_B) cities that form the widest gap.
SELECT
       LAG("geolocation_city")  OVER w AS "city_A",
       LAG("geolocation_state") OVER w AS "state_A",
       "geolocation_city"            AS "city_B",
       "geolocation_state"           AS "state_B",
       ( ("geolocation_lat" - LAG("geolocation_lat") OVER w) *
         ("geolocation_lat" - LAG("geolocation_lat") OVER w) +
         ("geolocation_lng" - LAG("geolocation_lng") OVER w) *
         ("geolocation_lng" - LAG("geolocation_lng") OVER w) ) AS "distance_sq"
FROM   "olist_geolocation"
WINDOW w AS (
       ORDER BY "geolocation_state",
                "geolocation_city",
                "geolocation_zip_code_prefix",
                "geolocation_lat",
                "geolocation_lng")
WHERE  LAG("geolocation_lat") OVER w IS NOT NULL          -- exclude first row (no predecessor)
ORDER  BY "distance_sq" DESC
LIMIT 1;
```
