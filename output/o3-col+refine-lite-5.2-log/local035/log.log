```sql
--Description / Thinking process:
-- We must find, in the ordering (state → city → zip_prefix → lat → lng), the pair of consecutive
-- rows that are geographically farthest apart.  SQLite here lacks SQRT, but ranking by the
-- squared distance (Δlat² + Δlng²) suffices because it preserves order.  The plan:
--   1. Use a window (LAG) to fetch the previous row’s city, state, lat, lng.
--   2. Compute distance_sq = (lat - prev_lat)² + (lng - prev_lng)².
--   3. Discard the first row (no predecessor).
--   4. Return the single row with the greatest distance_sq, exposing both cities/states.
SELECT
       LAG(geolocation_city)  OVER w AS city_A,
       LAG(geolocation_state) OVER w AS state_A,
       geolocation_city            AS city_B,
       geolocation_state           AS state_B,
       ( (geolocation_lat - LAG(geolocation_lat) OVER w) *
         (geolocation_lat - LAG(geolocation_lat) OVER w) +
         (geolocation_lng - LAG(geolocation_lng) OVER w) *
         (geolocation_lng - LAG(geolocation_lng) OVER w) ) AS distance_sq
FROM   olist_geolocation
WINDOW w AS (
       ORDER BY geolocation_state,
                geolocation_city,
                geolocation_zip_code_prefix,
                geolocation_lat,
                geolocation_lng)
WHERE  LAG(geolocation_city) OVER w IS NOT NULL
ORDER  BY distance_sq DESC
LIMIT 1;
```
