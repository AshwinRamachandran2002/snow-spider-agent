```sql
--Description / Thinking process:
-- • First, sort the table by (state → city → zip_prefix → latitude → longitude) exactly as required.  
-- • Inside a sub‑query, use LAG() to fetch the previous row’s city, state, latitude and longitude.  
-- • Compute the squared distance = (Δlat)² + (Δlng)² between each row and its predecessor.  
-- • In the outer query, keep only rows whose predecessor exists (prev_lat IS NOT NULL) and
--   order by the squared distance descending to get the greatest jump.  
-- • Return that single pair of consecutive cities/states together with the distance_sq value.
SELECT
        t.prev_state AS state_A,
        t.prev_city  AS city_A,
        t.geolocation_state AS state_B,
        t.geolocation_city  AS city_B,
        t.distance_sq
FROM (
        SELECT
               geolocation_state,
               geolocation_city,
               geolocation_lat,
               geolocation_lng,
               LAG(geolocation_state) OVER w AS prev_state,
               LAG(geolocation_city)  OVER w AS prev_city,
               LAG(geolocation_lat)   OVER w AS prev_lat,
               LAG(geolocation_lng)   OVER w AS prev_lng,
               ( (geolocation_lat - LAG(geolocation_lat) OVER w) *
                 (geolocation_lat - LAG(geolocation_lat) OVER w) +
                 (geolocation_lng - LAG(geolocation_lng) OVER w) *
                 (geolocation_lng - LAG(geolocation_lng) OVER w) ) AS distance_sq
        FROM   olist_geolocation
        WINDOW w AS (
               ORDER BY geolocation_state,
                        geolocation_city,
                        geolocation_zip_code_prefix,
                        geolocation_lat,
                        geolocation_lng
        )
) AS t
WHERE t.prev_lat IS NOT NULL          -- exclude the very first ordered row
ORDER BY t.distance_sq DESC
LIMIT 1;
