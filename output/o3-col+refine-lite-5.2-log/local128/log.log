```sql
--Description: See a sample of game results that were actually WON with a handicap score ≤ 190
SELECT "MatchID",
       "GameNumber",
       "BowlerID",
       "HandiCapScore",
       "WonGame"
FROM   "Bowler_Scores"
WHERE  "WonGame" = 1
  AND  "HandiCapScore" <= 190
LIMIT 20;
```

```sql
--Description: Join game results to tournaments to see where (at which location) each winning game occurred
SELECT bs."BowlerID",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyLocation"
FROM   "Bowler_Scores"  AS bs
JOIN   "Tourney_Matches" AS tm ON bs."MatchID"  = tm."MatchID"
JOIN   "Tournaments"     AS t  ON tm."TourneyID" = t."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes',
                               'Totem Lanes',
                               'Bolero Lanes')
LIMIT 20;
```

```sql
--Description: Identify bowlers who have at least one qualifying (win, ≤190) game at Thunderbird Lanes
SELECT DISTINCT bs."BowlerID"
FROM   "Bowler_Scores"  AS bs
JOIN   "Tourney_Matches" AS tm ON bs."MatchID"  = tm."MatchID"
JOIN   "Tournaments"     AS t  ON tm."TourneyID" = t."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" = 'Thunderbird Lanes'
LIMIT 20;
```

```sql
--Description: Determine bowlers who have qualifying wins at *all three* venues
SELECT DISTINCT bs."BowlerID"
FROM   "Bowler_Scores"  AS bs
JOIN   "Tourney_Matches" AS tm ON bs."MatchID"  = tm."MatchID"
JOIN   "Tournaments"     AS t  ON tm."TourneyID" = t."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes',
                               'Totem Lanes',
                               'Bolero Lanes')
GROUP  BY bs."BowlerID"
HAVING COUNT(DISTINCT t."TourneyLocation") = 3
LIMIT 20;
```

```sql
--Description: FINAL – list every specific game where those bowlers won with ≤190 at the three venues
SELECT bs."BowlerID",
       b."BowlerFirstName",
       b."BowlerLastName",
       bs."MatchID",
       bs."GameNumber",
       bs."HandiCapScore",
       t."TourneyDate",
       t."TourneyLocation"
FROM   "Bowler_Scores"  AS bs
JOIN   "Bowlers"         AS b  ON bs."BowlerID"   = b."BowlerID"
JOIN   "Tourney_Matches" AS tm ON bs."MatchID"    = tm."MatchID"
JOIN   "Tournaments"     AS t  ON tm."TourneyID"  = t."TourneyID"
WHERE  bs."WonGame" = 1
  AND  bs."HandiCapScore" <= 190
  AND  t."TourneyLocation" IN ('Thunderbird Lanes',
                               'Totem Lanes',
                               'Bolero Lanes')
  AND  bs."BowlerID" IN (    -- bowlers who qualified at all three venues
        SELECT q."BowlerID"
        FROM (
              SELECT bs2."BowlerID",
                     COUNT(DISTINCT t2."TourneyLocation") AS loc_cnt
              FROM   "Bowler_Scores"  AS bs2
              JOIN   "Tourney_Matches" AS tm2 ON bs2."MatchID"  = tm2."MatchID"
              JOIN   "Tournaments"     AS t2  ON tm2."TourneyID" = t2."TourneyID"
              WHERE  bs2."WonGame" = 1
                AND  bs2."HandiCapScore" <= 190
                AND  t2."TourneyLocation" IN ('Thunderbird Lanes',
                                              'Totem Lanes',
                                              'Bolero Lanes')
              GROUP  BY bs2."BowlerID"
             ) AS q
        WHERE q.loc_cnt = 3
      )
ORDER BY bs."BowlerID",
         t."TourneyDate",
         bs."GameNumber"
LIMIT 20;
```

