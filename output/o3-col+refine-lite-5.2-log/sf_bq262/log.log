```sql
--Description: Monthly June‑Dec 2019 roll‑up of orders, revenue, and profit per category  
SELECT
  TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM')  AS "month",
  p."category",
  COUNT(*)                                AS "total_orders",
  SUM(oi."sale_price")                    AS "total_revenue",
  SUM(oi."sale_price" - p."cost")         AS "total_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
     ON p."id" = oi."product_id"
WHERE TO_TIMESTAMP_NTZ(oi."created_at"/1000000) BETWEEN '2019-06-01' AND '2019-12-31'
GROUP BY 1,2
ORDER BY 1,2
LIMIT 20;
```

```sql
--Description: Same aggregation as above but add previous‑month values via window for MoM calculation  
SELECT
  "month",
  "category",
  "total_orders",
  LAG("total_orders")  OVER (PARTITION BY "category" ORDER BY "month") AS "prev_orders",
  "total_revenue",
  LAG("total_revenue") OVER (PARTITION BY "category" ORDER BY "month") AS "prev_revenue",
  "total_profit",
  LAG("total_profit")  OVER (PARTITION BY "category" ORDER BY "month") AS "prev_profit"
FROM (
  SELECT
    TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM')  AS "month",
    p."category",
    COUNT(*)                                AS "total_orders",
    SUM(oi."sale_price")                    AS "total_revenue",
    SUM(oi."sale_price" - p."cost")         AS "total_profit"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
       ON p."id" = oi."product_id"
  WHERE TO_TIMESTAMP_NTZ(oi."created_at"/1000000) BETWEEN '2019-06-01' AND '2019-12-31'
  GROUP BY 1,2
) t
ORDER BY "month","category"
LIMIT 20;
```

```sql
--Description: Compute MoM growth rates (relative change) and omit the baseline month (June)  
SELECT
  "month",
  "category",
  "total_orders",
  ROUND(("total_orders" - "prev_orders") / NULLIF("prev_orders",0), 4)  AS "orders_growth",
  "total_revenue",
  ROUND(("total_revenue" - "prev_revenue") / NULLIF("prev_revenue",0),4) AS "revenue_growth",
  "total_profit",
  ROUND(("total_profit" - "prev_profit") / NULLIF("prev_profit",0),4)    AS "profit_growth"
FROM (
  /* re‑use windowed sub‑query from previous step */
  SELECT
    "month","category","total_orders","prev_orders",
    "total_revenue","prev_revenue",
    "total_profit","prev_profit"
  FROM ( /* same subquery as in Step‑7 */ 
    SELECT
      TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM') AS "month",
      p."category",
      COUNT(*)                        AS "total_orders",
      SUM(oi."sale_price")            AS "total_revenue",
      SUM(oi."sale_price" - p."cost") AS "total_profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
         ON p."id" = oi."product_id"
    WHERE TO_TIMESTAMP_NTZ(oi."created_at"/1000000) BETWEEN '2019-06-01' AND '2019-12-31'
    GROUP BY 1,2
  ) s
  WINDOW w AS (PARTITION BY "category" ORDER BY "month")
  SELECT
    s.*,
    LAG("total_orders")  OVER w AS "prev_orders",
    LAG("total_revenue") OVER w AS "prev_revenue",
    LAG("total_profit")  OVER w AS "prev_profit"
) x
WHERE "month" <> '2019-06'
ORDER BY "month","category"
LIMIT 20;
```

```sql
--Description: Final formatted report (July‑Dec) sorted ascending by month & category  
SELECT
  "month",
  "category",
  "total_orders",
  "orders_growth",
  "total_revenue",
  "revenue_growth",
  "total_profit",
  "profit_growth"
FROM /* Step‑8 query result */ (
  SELECT
    "month",
    "category",
    "total_orders",
    ROUND(("total_orders" - "prev_orders") / NULLIF("prev_orders",0), 4)  AS "orders_growth",
    "total_revenue",
    ROUND(("total_revenue" - "prev_revenue") / NULLIF("prev_revenue",0),4) AS "revenue_growth",
    "total_profit",
    ROUND(("total_profit" - "prev_profit") / NULLIF("prev_profit",0),4)    AS "profit_growth"
  FROM (
    SELECT
      "month","category","total_orders","prev_orders",
      "total_revenue","prev_revenue",
      "total_profit","prev_profit"
    FROM (
      SELECT
        TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM') AS "month",
        p."category",
        COUNT(*)                        AS "total_orders",
        SUM(oi."sale_price")            AS "total_revenue",
        SUM(oi."sale_price" - p."cost") AS "total_profit"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
           ON p."id" = oi."product_id"
      WHERE TO_TIMESTAMP_NTZ(oi."created_at"/1000000) BETWEEN '2019-06-01' AND '2019-12-31'
      GROUP BY 1,2
    ) base
    WINDOW w AS (PARTITION BY "category" ORDER BY "month")
    SELECT
      base.*,
      LAG("total_orders")  OVER w AS "prev_orders",
      LAG("total_revenue") OVER w AS "prev_revenue",
      LAG("total_profit")  OVER w AS "prev_profit"
  )
  WHERE "month" <> '2019-06'
)
ORDER BY "month", "category"
LIMIT 20;
```

