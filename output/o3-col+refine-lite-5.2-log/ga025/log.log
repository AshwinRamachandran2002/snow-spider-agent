  SELECT  `user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', `event_date`)) AS first_open_date
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
    AND   `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
)
SELECT *
FROM   first_open
LIMIT 20;
```

```sql
-- Description: 6) Join the September first‑open users with uninstall events that
-- happened within 7 days of their first open.  
WITH first_open AS (
  SELECT  `user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', `event_date`)) AS first_open_date
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
    AND   `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
), uninstalls AS (
  SELECT  `user_pseudo_id`,
          PARSE_DATE('%Y%m%d', `event_date`) AS uninstall_date
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
    AND   `event_name` = 'app_remove'
)
SELECT  f.`user_pseudo_id`,
        f.first_open_date,
        u.uninstall_date,
        DATE_DIFF(u.uninstall_date, f.first_open_date, DAY) AS days_to_uninstall
FROM    first_open f
JOIN    uninstalls u
ON      f.`user_pseudo_id` = u.`user_pseudo_id`
WHERE   DATE_DIFF(u.uninstall_date, f.first_open_date, DAY) BETWEEN 0 AND 7
LIMIT 20;
```

```sql
-- Description: 7) Identify which of those quick‑uninstall users also generated a crash.  
WITH first_open AS (
  SELECT  `user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', `event_date`)) AS first_open_date
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
    AND   `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
), uninstalls AS (
  SELECT  `user_pseudo_id`,
          PARSE_DATE('%Y%m%d', `event_date`) AS uninstall_date
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
    AND   `event_name` = 'app_remove'
), crashes AS (
  SELECT DISTINCT `user_pseudo_id`
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
    AND  `event_name` = 'app_exception'
)
SELECT  q.`user_pseudo_id`,
        q.first_open_date,
        q.uninstall_date,
        c.`user_pseudo_id` IS NOT NULL AS experienced_crash
FROM  (
  SELECT  f.`user_pseudo_id`,
          f.first_open_date,
          u.uninstall_date
  FROM    first_open f
  JOIN    uninstalls u
  ON      f.`user_pseudo_id` = u.`user_pseudo_id`
  WHERE   DATE_DIFF(u.uninstall_date, f.first_open_date, DAY) BETWEEN 0 AND 7
) q
LEFT JOIN crashes c
ON  q.`user_pseudo_id` = c.`user_pseudo_id`
LIMIT 20;
```

```sql
-- Description: 8) Final answer – percentage of September‑2018 first‑open users who
-- uninstalled within 7 days and experienced at least one crash before uninstall.  
WITH first_open AS (
  SELECT  `user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', `event_date`)) AS first_open_date
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
    AND   `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
), uninstalls AS (
  SELECT  `user_pseudo_id`,
          PARSE_DATE('%Y%m%d', `event_date`) AS uninstall_date
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
    AND   `event_name` = 'app_remove'
), crashes AS (
  SELECT DISTINCT `user_pseudo_id`
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
    AND  `event_name` = 'app_exception'
)
SELECT
  COUNT(DISTINCT q.`user_pseudo_id`)                               AS total_uninstalls_within_7d,
  COUNT(DISTINCT CASE WHEN c.`user_pseudo_id` IS NOT NULL
                      THEN q.`user_pseudo_id` END)                AS uninstalls_with_crash,
  SAFE_DIVIDE(
    COUNT(DISTINCT CASE WHEN c.`user_pseudo_id` IS NOT NULL
                        THEN q.`user_pseudo_id` END),
    COUNT(DISTINCT q.`user_pseudo_id`)
  ) * 100                                                          AS pct_with_crash
FROM (
  SELECT  f.`user_pseudo_id`,
          f.first_open_date,
          u.uninstall_date
  FROM    first_open f
  JOIN    uninstalls u
  ON      f.`user_pseudo_id` = u.`user_pseudo_id`
  WHERE   DATE_DIFF(u.uninstall_date, f.first_open_date, DAY) BETWEEN 0 AND 7
) q
LEFT JOIN crashes c
ON  q.`user_pseudo_id` = c.`user_pseudo_id`
LIMIT 20;
```

