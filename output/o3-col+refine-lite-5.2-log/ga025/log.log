  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
    AND   `event_name` = 'app_remove'
), crashes AS (
  SELECT DISTINCT `user_pseudo_id`
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
    AND  `event_name` = 'app_exception'
)
SELECT
  COUNT(DISTINCT q.`user_pseudo_id`)                               AS total_uninstalls_within_7d,
  COUNT(DISTINCT CASE WHEN c.`user_pseudo_id` IS NOT NULL
                      THEN q.`user_pseudo_id` END)                AS uninstalls_with_crash,
  SAFE_DIVIDE(
    COUNT(DISTINCT CASE WHEN c.`user_pseudo_id` IS NOT NULL
                        THEN q.`user_pseudo_id` END),
    COUNT(DISTINCT q.`user_pseudo_id`)
  ) * 100                                                          AS pct_with_crash
FROM (
  SELECT  f.`user_pseudo_id`,
          f.first_open_date,
          u.uninstall_date
  FROM    first_open f
  JOIN    uninstalls u
  ON      f.`user_pseudo_id` = u.`user_pseudo_id`
  WHERE   DATE_DIFF(u.uninstall_date, f.first_open_date, DAY) BETWEEN 0 AND 7
) q
LEFT JOIN crashes c
ON  q.`user_pseudo_id` = c.`user_pseudo_id`
LIMIT 20;
