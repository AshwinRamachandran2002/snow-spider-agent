```sql
-- Description: Count of all trees whose boroname is Bronx
SELECT COUNT(*) AS "bronx_total_trees"
FROM   "trees"
WHERE  "boroname" = 'Bronx';
```

```sql
-- Description: Count of Bronx trees whose health is 'Good'
SELECT COUNT(*) AS "bronx_good_health_trees"
FROM   "trees"
WHERE  "boroname" = 'Bronx'
  AND  "health"   = 'Good';
```

```sql
-- Description: Compute the percentage of Bronx trees that have Good health using two sub‑queries
SELECT 
  (SELECT COUNT(*) 
   FROM "trees" 
   WHERE "boroname" = 'Bronx' 
     AND "health" = 'Good') * 100.0
  /
  (SELECT COUNT(*) 
   FROM "trees" 
   WHERE "boroname" = 'Bronx')                           AS "pct_bronx_good_health";
```

```sql
-- Description: Same calculation wrapped inside one CTE (final answer query)
WITH bronx AS (
     SELECT *
     FROM   "trees"
     WHERE  "boroname" = 'Bronx'
)
SELECT 
       ROUND(100.0 * SUM(CASE WHEN "health" = 'Good' THEN 1 ELSE 0 END)
                     / COUNT(*), 2)                AS "percentage_good_health_bronx"
FROM   bronx;
```
