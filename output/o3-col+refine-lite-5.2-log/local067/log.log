--Description: 6) Aggregate December 2021 profit per Italian customer.  
SELECT DISTINCT s.cust_id,
       SUM(s.amount_sold - (coalesce(cst.unit_cost,0) * s.quantity_sold)) AS customer_profit
FROM   sales AS s
JOIN   customers AS cu ON cu.cust_id = s.cust_id
JOIN   times     AS t  ON t.time_id  = s.time_id
LEFT  JOIN costs  AS cst
       ON  cst.prod_id   = s.prod_id
       AND cst.time_id   = s.time_id
       AND cst.channel_id= s.channel_id
       AND cst.promo_id  = s.promo_id
WHERE  cu.country_id            = 52770
  AND  t.calendar_month_number  = 12
  AND  t.calendar_year          = 2021
GROUP BY s.cust_id
LIMIT 20;
