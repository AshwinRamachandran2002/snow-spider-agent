```sql
-- 2) Inspect the main safety‑equipment field for motorcycle parties
SELECT DISTINCT "party_safety_equipment_1"
FROM "parties"
WHERE "statewide_vehicle_type" LIKE '%motor%'
  AND "party_safety_equipment_1" LIKE '%helmet%'
LIMIT 20;
```

```sql
-- 3) Inspect the secondary safety‑equipment field for motorcycle parties
SELECT DISTINCT "party_safety_equipment_2"
FROM "parties"
WHERE "statewide_vehicle_type" LIKE '%motor%'
  AND "party_safety_equipment_2" LIKE '%helmet%'
LIMIT 20;
```

```sql
-- 4) Sample motorcycle parties that WERE wearing helmets
SELECT *
FROM "parties"
WHERE "statewide_vehicle_type" LIKE '%motor%'
  AND (("party_safety_equipment_1" LIKE '%helmet%'  AND "party_safety_equipment_1" NOT LIKE '%not%')
       OR ("party_safety_equipment_2" LIKE '%helmet%' AND "party_safety_equipment_2" NOT LIKE '%not%'))
LIMIT 20;
```

```sql
-- 5) Sample motorcycle parties that were NOT wearing helmets
SELECT *
FROM "parties"
WHERE "statewide_vehicle_type" LIKE '%motor%'
  AND ( "party_safety_equipment_1" LIKE '%helmet not used%' 
        OR "party_safety_equipment_2" LIKE '%helmet not used%' )
LIMIT 20;
```

```sql
-- 6) Count of COLLISIONS that involved at least one helmeted motorcyclist
SELECT COUNT(DISTINCT c."case_id") AS "helmeted_collision_cnt"
FROM "collisions"  AS c
JOIN "parties"     AS p ON c."case_id" = p."case_id"
WHERE p."statewide_vehicle_type" LIKE '%motor%'
  AND ( (p."party_safety_equipment_1" LIKE '%helmet%'  AND p."party_safety_equipment_1" NOT LIKE '%not%')
        OR (p."party_safety_equipment_2" LIKE '%helmet%' AND p."party_safety_equipment_2" NOT LIKE '%not%') );
```

```sql
-- 7) Count of COLLISIONS that involved at least one UN‑helmeted motorcyclist
SELECT COUNT(DISTINCT c."case_id") AS "no_helmet_collision_cnt"
FROM "collisions"  AS c
JOIN "parties"     AS p ON c."case_id" = p."case_id"
WHERE p."statewide_vehicle_type" LIKE '%motor%'
  AND ( p."party_safety_equipment_1" LIKE '%helmet not used%'
        OR p."party_safety_equipment_2" LIKE '%helmet not used%' );
```

```sql
-- 8) Total motorcyclist fatalities in the helmeted‑collision group
SELECT SUM(c."motorcyclist_killed_count") AS "helmeted_deaths"
FROM "collisions"  AS c
WHERE c."case_id" IN (
      SELECT DISTINCT p."case_id"
      FROM "parties" p
      WHERE p."statewide_vehicle_type" LIKE '%motor%'
        AND ( (p."party_safety_equipment_1" LIKE '%helmet%'  AND p."party_safety_equipment_1" NOT LIKE '%not%')
              OR (p."party_safety_equipment_2" LIKE '%helmet%' AND p."party_safety_equipment_2" NOT LIKE '%not%') )
);
```

```sql
-- 9) Total motorcyclist fatalities in the UN‑helmeted‑collision group
SELECT SUM(c."motorcyclist_killed_count") AS "no_helmet_deaths"
FROM "collisions"  AS c
WHERE c."case_id" IN (
      SELECT DISTINCT p."case_id"
      FROM "parties" p
      WHERE p."statewide_vehicle_type" LIKE '%motor%'
        AND ( p."party_safety_equipment_1" LIKE '%helmet not used%'
              OR p."party_safety_equipment_2" LIKE '%helmet not used%' )
);
```

```sql
-- 10) Final calculation – fatality rate (%) for each group
WITH
helmeted AS (
    SELECT DISTINCT c."case_id"
    FROM "collisions" c
    JOIN "parties"  p ON c."case_id" = p."case_id"
    WHERE p."statewide_vehicle_type" LIKE '%motor%'
      AND ( (p."party_safety_equipment_1" LIKE '%helmet%'  AND p."party_safety_equipment_1" NOT LIKE '%not%')
            OR (p."party_safety_equipment_2" LIKE '%helmet%' AND p."party_safety_equipment_2" NOT LIKE '%not%') )
),
no_helmet AS (
    SELECT DISTINCT c."case_id"
    FROM "collisions" c
    JOIN "parties"  p ON c."case_id" = p."case_id"
    WHERE p."statewide_vehicle_type" LIKE '%motor%'
      AND ( p."party_safety_equipment_1" LIKE '%helmet not used%'
            OR p."party_safety_equipment_2" LIKE '%helmet not used%' )
),
stats AS (
    SELECT 'helmet worn'  AS group_type,
           SUM(c."motorcyclist_killed_count") AS deaths,
           COUNT(*)                               AS collisions
    FROM "collisions" c
    WHERE c."case_id" IN (SELECT "case_id" FROM helmeted)
    UNION ALL
    SELECT 'helmet not worn',
           SUM(c."motorcyclist_killed_count"),
           COUNT(*)
    FROM "collisions" c
    WHERE c."case_id" IN (SELECT "case_id" FROM no_helmet)
)
SELECT group_type,
       deaths,
       collisions,
       ROUND(100.0*deaths/collisions, 2) AS fatality_rate_percent
FROM stats;
```
