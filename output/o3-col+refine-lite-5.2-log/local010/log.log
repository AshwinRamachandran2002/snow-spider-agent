```sql
-- 1. Look at a few airports together with the English city name and their coordinates
SELECT 
    a.airport_code,
    json_extract(a.city,'$.en')   AS city_en,
    a.coordinates
FROM airports_data AS a
LIMIT 20;
```

```sql
-- 2. Show every airport that ever appears in the flights table
SELECT DISTINCT f.departure_airport AS airport_code
FROM flights AS f
UNION
SELECT DISTINCT f.arrival_airport
FROM flights AS f
LIMIT 20;
```

```sql
-- 3. Bring city names into the flights table (still directional)
SELECT 
    f.flight_id,
    json_extract(ad.city,'$.en')  AS dep_city,
    json_extract(aa.city,'$.en')  AS arr_city
FROM flights AS f
JOIN airports_data AS ad ON ad.airport_code = f.departure_airport
JOIN airports_data AS aa ON aa.airport_code = f.arrival_airport
LIMIT 20;
```

```sql
-- 4. Prepare longitude / latitude (in degrees) for every airport used in flights
SELECT 
    a.airport_code,
    CAST(substr(a.coordinates, 2, instr(a.coordinates, ',')-2)  AS REAL) AS lon,
    CAST(substr(a.coordinates, instr(a.coordinates, ',')+1, 
                length(a.coordinates)-instr(a.coordinates, ',')-1) AS REAL) AS lat
FROM airports_data AS a
WHERE a.airport_code IN (SELECT departure_airport FROM flights
                         UNION
                         SELECT arrival_airport   FROM flights)
LIMIT 20;
```

```sql
-- 5. Put coordinates and city names together (helper CTE)
WITH coords AS (
    SELECT 
        airport_code,
        json_extract(city,'$.en')  AS city,
        CAST(substr(coordinates, 2, instr(coordinates, ',')-2)  AS REAL) AS lon,
        CAST(substr(coordinates, instr(coordinates, ',')+1, 
                    length(coordinates)-instr(coordinates, ',')-1)       AS REAL) AS lat
    FROM airports_data
)
SELECT * FROM coords LIMIT 20;
```

```sql
-- 6. Distances (Haversine) for every *airport* pair that really has flights
WITH coords AS (
    SELECT 
        airport_code,
        json_extract(city,'$.en')  AS city,
        CAST(substr(coordinates, 2, instr(coordinates, ',')-2)  AS REAL) AS lon,
        CAST(substr(coordinates, instr(coordinates, ',')+1, 
                    length(coordinates)-instr(coordinates, ',')-1)       AS REAL) AS lat
    FROM airports_data
),
legs AS (
    SELECT DISTINCT 
        f.departure_airport AS dep_ap,
        f.arrival_airport   AS arr_ap
    FROM flights AS f
),
d AS (
    SELECT 
        l.dep_ap,
        l.arr_ap,
        6371*2*asin(
            sqrt(
                power(sin( (c2.lat-c1.lat) *3.141592653589793/180/2),2) +
                cos(c1.lat*3.141592653589793/180) *
                cos(c2.lat*3.141592653589793/180) *
                power(sin( (c2.lon-c1.lon)*3.141592653589793/180/2),2)
            )
        ) AS distance_km,
        c1.city AS dep_city,
        c2.city AS arr_city
    FROM legs  AS l
    JOIN coords AS c1 ON c1.airport_code = l.dep_ap
    JOIN coords AS c2 ON c2.airport_code = l.arr_ap
)
SELECT * FROM d LIMIT 20;
```

```sql
-- 7. Collapse to *city* pairs (unordered) and average distance of all routes between them
WITH coords AS (
    SELECT 
        airport_code,
        json_extract(city,'$.en')  AS city,
        CAST(substr(coordinates, 2, instr(coordinates, ',')-2)  AS REAL) AS lon,
        CAST(substr(coordinates, instr(coordinates, ',')+1, 
                    length(coordinates)-instr(coordinates, ',')-1)       AS REAL) AS lat
    FROM airports_data
),
legs AS (
    SELECT DISTINCT 
        f.departure_airport AS dep_ap,
        f.arrival_airport   AS arr_ap
    FROM flights AS f
),
d AS (
    SELECT 
        l.dep_ap,
        l.arr_ap,
        6371*2*asin(
            sqrt(
                power(sin( (c2.lat-c1.lat) *3.141592653589793/180/2),2) +
                cos(c1.lat*3.141592653589793/180) *
                cos(c2.lat*3.141592653589793/180) *
                power(sin( (c2.lon-c1.lon)*3.141592653589793/180/2),2)
            )
        ) AS distance_km,
        c1.city AS dep_city,
        c2.city AS arr_city
    FROM legs  AS l
    JOIN coords AS c1 ON c1.airport_code = l.dep_ap
    JOIN coords AS c2 ON c2.airport_code = l.arr_ap
),
city_pairs AS (
    SELECT
        CASE WHEN dep_city < arr_city THEN dep_city ELSE arr_city END AS city_a,
        CASE WHEN dep_city < arr_city THEN arr_city ELSE dep_city END AS city_b,
        AVG(distance_km) AS avg_distance
    FROM d
    GROUP BY city_a, city_b
)
SELECT * FROM city_pairs LIMIT 20;
```

```sql
-- 8. Bucket every city pair into distance ranges
WITH city_pairs AS ( /* see query 7 */ )
SELECT 
    CASE
        WHEN avg_distance < 1000 THEN '0‑999'
        WHEN avg_distance < 2000 THEN '1000‑1999'
        WHEN avg_distance < 3000 THEN '2000‑2999'
        WHEN avg_distance < 4000 THEN '3000‑3999'
        WHEN avg_distance < 5000 THEN '4000‑4999'
        WHEN avg_distance < 6000 THEN '5000‑5999'
        ELSE '6000+'
    END AS range,
    COUNT(*) AS pair_cnt
FROM city_pairs
GROUP BY range
ORDER BY range;
```

```sql
-- 9. How many city pairs are in the *smallest* bucket?
WITH city_pairs AS ( /* see query 7 */ ),
bucketed AS (
    SELECT 
        CASE
            WHEN avg_distance < 1000 THEN '0‑999'
            WHEN avg_distance < 2000 THEN '1000‑1999'
            WHEN avg_distance < 3000 THEN '2000‑2999'
            WHEN avg_distance < 4000 THEN '3000‑3999'
            WHEN avg_distance < 5000 THEN '4000‑4999'
            WHEN avg_distance < 6000 THEN '5000‑5999'
            ELSE '6000+'
        END AS range,
        COUNT(*) AS pair_cnt
    FROM city_pairs
    GROUP BY range
)
SELECT MIN(pair_cnt) AS fewest_pairs_in_a_range
FROM bucketed;
```

Running the final query (`fewest_pairs_in_a_range`) on the sample database gives:

fewest_pairs_in_a_range  
