```sql
--Description:  Compute the great‑circle distance for every distinct (departure, arrival)
--              airport pair that appears in the flights table using only the math
--              functions known to exist in this SQLite build:  sin( ), cos( ), asin( ),
--              log( ) and exp( ).  The ordinary Haversine formula
--                   d = 2·R·asin( √h )
--              needs a square‑root; we obtain it with  exp(0.5*log(h))  because
--              neither sqrt( ) nor power( ) is available.  R (Earth radius) = 6 371 km.
--              CTEs
--                • coords – airport_code, English city, longitude, latitude.
--                • legs   – every distinct flight leg (directional) taken from flights.
--                • dist   – distance_km plus the two city names for each leg.
--              The query returns the first 20 calculated rows.
WITH coords AS (
    SELECT
        airport_code,
        json_extract(city,'$.en')                                   AS city,
        CAST(substr(coordinates, 2, instr(coordinates, ',')-2)  AS REAL) AS lon,
        CAST(substr(coordinates, instr(coordinates, ',')+1,
                    length(coordinates)-instr(coordinates, ',')-1) AS REAL) AS lat
    FROM airports_data
),
legs AS (
    SELECT DISTINCT
        departure_airport AS dep_ap,
        arrival_airport   AS arr_ap
    FROM flights
),
dist AS (
    SELECT
        l.dep_ap,
        l.arr_ap,
        6371 * 2 * asin(
            exp( 0.5 * log(                         -- √h  via  exp(½·log(h))
                (sin( ((c2.lat - c1.lat) * 0.017453292519943) / 2 )) *
                (sin( ((c2.lat - c1.lat) * 0.017453292519943) / 2 )) +
                cos( c1.lat * 0.017453292519943 ) *
                cos( c2.lat * 0.017453292519943 ) *
                (sin( ((c2.lon - c1.lon) * 0.017453292519943) / 2 )) *
                (sin( ((c2.lon - c1.lon) * 0.017453292519943) / 2 ))
            ))
        )                                                        AS distance_km,
        c1.city                                                  AS dep_city,
        c2.city                                                  AS arr_city
    FROM legs   AS l
    JOIN coords AS c1 ON c1.airport_code = l.dep_ap
    JOIN coords AS c2 ON c2.airport_code = l.arr_ap
)
SELECT *
FROM dist
LIMIT 20;
```
