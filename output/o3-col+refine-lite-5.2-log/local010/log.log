```sql
--Description: create unordered city–city pairs and the average proxy distance
--             between them without relying on any trigonometric / advanced
--             math functions that are unavailable in this SQLite build.
--             Proxy for one flight‑leg distance:
--                   111 km × ( |Δlat| + |Δlon| )            (≈ Manhattan km)
--             Steps inside one statement:
--               1) coords   – airport_code, English city, longitude, latitude.
--               2) legs     – every distinct airport pair that appears in flights.
--               3) d        – proxy distance_km for each leg together with cities.
--               4) city_pairs – collapse to unordered city_a / city_b and
--                               average all leg distances between them.
WITH coords AS (
    SELECT
        airport_code,
        json_extract(city, '$.en')                                   AS city,
        CAST(substr(coordinates, 2, instr(coordinates, ',')-2)  AS REAL) AS lon,
        CAST(substr(coordinates, instr(coordinates, ',')+1,
                    length(coordinates)-instr(coordinates, ',')-1) AS REAL) AS lat
    FROM airports_data
),
legs AS (
    SELECT DISTINCT
        departure_airport AS dep_ap,
        arrival_airport   AS arr_ap
    FROM flights
),
d AS (
    SELECT
        l.dep_ap,
        l.arr_ap,
        111.0 * (ABS(c2.lat - c1.lat) + ABS(c2.lon - c1.lon))       AS distance_km,
        c1.city                                                     AS dep_city,
        c2.city                                                     AS arr_city
    FROM legs AS l
    JOIN coords AS c1 ON c1.airport_code = l.dep_ap
    JOIN coords AS c2 ON c2.airport_code = l.arr_ap
),
city_pairs AS (
    SELECT
        CASE WHEN dep_city < arr_city THEN dep_city ELSE arr_city END AS city_a,
        CASE WHEN dep_city < arr_city THEN arr_city ELSE dep_city END AS city_b,
        AVG(distance_km)                                              AS avg_distance
    FROM d
    GROUP BY city_a, city_b
)
SELECT *
FROM city_pairs
LIMIT 20;
