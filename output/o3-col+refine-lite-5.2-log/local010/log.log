Query:
--Description: Determine how many city‑pairs fall into the *least populated* distance
--             range (using the same proxy distance and buckets as above).  The query
--             rebuilds “city_pairs”, buckets them, counts pairs per bucket, and then
--             returns the minimum bucket size.
WITH coords AS (
    SELECT
        airport_code,
        json_extract(city,'$.en')                                   AS city,
        CAST(substr(coordinates, 2, instr(coordinates, ',')-2)  AS REAL) AS lon,
        CAST(substr(coordinates, instr(coordinates, ',')+1,
                    length(coordinates)-instr(coordinates, ',')-1) AS REAL) AS lat
    FROM airports_data
),
legs AS (
    SELECT DISTINCT
        departure_airport AS dep_ap,
        arrival_airport   AS arr_ap
    FROM flights
),
d AS (
    SELECT
        111.0 * (ABS(c2.lat - c1.lat) + ABS(c2.lon - c1.lon))       AS distance_km,
        CASE WHEN c1.city < c2.city THEN c1.city ELSE c2.city END   AS city_a,
        CASE WHEN c1.city < c2.city THEN c2.city ELSE c1.city END   AS city_b
    FROM legs
    JOIN coords AS c1 ON c1.airport_code = dep_ap
    JOIN coords AS c2 ON c2.airport_code = arr_ap
),
city_pairs AS (
    SELECT city_a, city_b, AVG(distance_km) AS avg_distance
    FROM d
    GROUP BY city_a, city_b
),
bucketed AS (
    SELECT
        CASE
            WHEN avg_distance < 1000 THEN '0‑999'
            WHEN avg_distance < 2000 THEN '1000‑1999'
            WHEN avg_distance < 3000 THEN '2000‑2999'
            WHEN avg_distance < 4000 THEN '3000‑3999'
            WHEN avg_distance < 5000 THEN '4000‑4999'
            WHEN avg_distance < 6000 THEN '5000‑5999'
            ELSE '6000+'
        END AS range,
        COUNT(*) AS pair_cnt
    FROM city_pairs
    GROUP BY range
)
SELECT MIN(pair_cnt) AS fewest_pairs_in_a_range
FROM bucketed
