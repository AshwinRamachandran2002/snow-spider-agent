--Description: “sqrt()” is unavailable, so the Haversine form that needs it is replaced
--             by the cosine law for great‑circle distance, which uses acos() instead:
--                 d = R · acos( sin φ1 · sin φ2 + cos φ1 · cos φ2 · cos(Δλ) ).
--             All angles are first converted from degrees to radians (deg·π/180).
--             The query builds three CTEs:
--               1) coords – longitude / latitude + English city for every airport;
--               2) legs   – every distinct departure / arrival airport pair in flights;
--               3) dist   – distance (km) for each leg, now free of sqrt().
--             Finally it returns the first 20 computed legs with their two cities
--             and the distance.
WITH coords AS (
    SELECT
        airport_code,
        json_extract(city,'$.en')                                   AS city,
        CAST(substr(coordinates, 2, instr(coordinates, ',')-2)  AS REAL) AS lon_deg,
        CAST(substr(coordinates, instr(coordinates, ',')+1,
                    length(coordinates)-instr(coordinates, ',')-1) AS REAL) AS lat_deg
    FROM airports_data
),
legs AS (
    SELECT DISTINCT
        f.departure_airport AS dep_ap,
        f.arrival_airport   AS arr_ap
    FROM flights AS f
),
dist AS (
    SELECT
        l.dep_ap,
        l.arr_ap,
        6371 * acos(                                        -- Earth‑radius · acos(…)
              sin( c1.lat_deg * 0.017453292519943 ) *
              sin( c2.lat_deg * 0.017453292519943 ) +
              cos( c1.lat_deg * 0.017453292519943 ) *
              cos( c2.lat_deg * 0.017453292519943 ) *
              cos( (c1.lon_deg - c2.lon_deg) * 0.017453292519943 )
        )                           AS distance_km,
        c1.city                     AS dep_city,
        c2.city                     AS arr_city
    FROM legs AS l
    JOIN coords AS c1 ON c1.airport_code = l.dep_ap
    JOIN coords AS c2 ON c2.airport_code = l.arr_ap
)
SELECT *
FROM dist
LIMIT 20;
