```sql
--Description: The database lacks the sqrt() function (and acos()), but power() as well as
--             sin(), cos() and asin() are available.  Therefore we keep the Haversine
--             formula for great‑circle distance and replace √h with power(h,0.5).                                  
--             • coords – extracts each airport’s English city, longitude and latitude.  
--             • legs   – every distinct directional airport pair appearing in flights.  
--             • dist   – applies   d = 2·R·asin( power(h,0.5) )   where                    
--                   h = sin²(Δφ/2) + cos φ1 · cos φ2 · sin²(Δλ/2)                           
--               (R = 6 371 km, degrees→radians factor = π/180).                            
--             The query returns the first 20 legs together with the two cities and the
--             calculated distance in kilometres.                                          
WITH coords AS (
    SELECT
        airport_code,
        json_extract(city,'$.en')                                   AS city,
        CAST(substr(coordinates, 2, instr(coordinates, ',')-2)  AS REAL) AS lon,
        CAST(substr(coordinates, instr(coordinates, ',')+1,
                    length(coordinates)-instr(coordinates, ',')-1) AS REAL) AS lat
    FROM airports_data
),
legs AS (
    SELECT DISTINCT
        f.departure_airport AS dep_ap,
        f.arrival_airport   AS arr_ap
    FROM flights AS f
),
dist AS (
    SELECT
        l.dep_ap,
        l.arr_ap,
        6371 * 2 * asin(
            power(
                power( sin( ((c2.lat - c1.lat) * 0.017453292519943) / 2 ), 2 ) +
                cos( c1.lat * 0.017453292519943 ) *
                cos( c2.lat * 0.017453292519943 ) *
                power( sin( ((c2.lon - c1.lon) * 0.017453292519943) / 2 ), 2 ),
            0.5 )
        )                                                        AS distance_km,
        c1.city                                                  AS dep_city,
        c2.city                                                  AS arr_city
    FROM legs AS l
    JOIN coords AS c1 ON c1.airport_code = l.dep_ap
    JOIN coords AS c2 ON c2.airport_code = l.arr_ap
)
SELECT *
FROM dist
LIMIT 20;
