```sql
--Description: Build unordered city‑to‑city pairs together with the average
--             great‑circle distance of all flight legs between them, while
--             avoiding the unavailable sqrt(), power() and acos() functions.
--             The cosine law is used:
--                   d = R · arccos( sinφ1·sinφ2 + cosφ1·cosφ2·cosΔλ )
--             and arccos(x) is expressed as  π/2 − asin(x) (asin exists).
--             Steps inside one statement:
--               1) coords   – airport_code, English city, longitude & latitude (deg)
--               2) legs     – every distinct departure/arrival airport pair in flights
--               3) d        – distance_km for each leg with   R = 6 371 km
--               4) city_pairs – collapse legs to unordered city pairs and take
--                               the average distance.  Return first 20 rows.
WITH coords AS (
    SELECT
        airport_code,
        json_extract(city,'$.en')                                   AS city,
        CAST(substr(coordinates, 2, instr(coordinates, ',')-2)  AS REAL) AS lon_deg,
        CAST(substr(coordinates, instr(coordinates, ',')+1,
                    length(coordinates)-instr(coordinates, ',')-1) AS REAL) AS lat_deg
    FROM airports_data
),
legs AS (
    SELECT DISTINCT
        departure_airport AS dep_ap,
        arrival_airport   AS arr_ap
    FROM flights
),
d AS (
    SELECT
        l.dep_ap,
        l.arr_ap,
        /* convert to radians once */
        6371 * (
            3.141592653589793/2 - asin(
                /* clamp numerical noise into [-1,1] */
                CASE
                  WHEN c_val >  1 THEN  1
                  WHEN c_val < -1 THEN -1
                  ELSE c_val
                END
            )
        ) AS distance_km,
        c1.city AS dep_city,
        c2.city AS arr_city
    FROM legs   AS l
    JOIN coords AS c1 ON c1.airport_code = l.dep_ap
    JOIN coords AS c2 ON c2.airport_code = l.arr_ap
    /* cosine‑law inner term */
    CROSS JOIN (
        SELECT
            sin(c1.lat_deg*0.017453292519943) * sin(c2.lat_deg*0.017453292519943) +
            cos(c1.lat_deg*0.017453292519943) * cos(c2.lat_deg*0.017453292519943) *
            cos((c1.lon_deg - c2.lon_deg)*0.017453292519943) AS c_val
    )
),
city_pairs AS (
    SELECT
        CASE WHEN dep_city < arr_city THEN dep_city ELSE arr_city END AS city_a,
        CASE WHEN dep_city < arr_city THEN arr_city ELSE dep_city END AS city_b,
        AVG(distance_km) AS avg_distance
    FROM d
    GROUP BY city_a, city_b
)
SELECT *
FROM city_pairs
LIMIT 20;
