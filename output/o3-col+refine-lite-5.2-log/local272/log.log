--Description: Verify that stock in Warehouse 1 is sufficient for every ordered product (order qty versus on‑hand qty)
SELECT o."product_id",
       SUM(o."qty") AS "needed",
       SUM(i."qty") AS "on_hand_warehouse1"
FROM "orderlines" AS o
LEFT JOIN "inventory"  AS i
       ON i."product_id" = o."product_id"
      AND i."location_id" IN (SELECT "id" FROM "locations" WHERE "warehouse" = 1)
WHERE o."order_id" = 423
GROUP BY o."product_id"
LIMIT 20;
