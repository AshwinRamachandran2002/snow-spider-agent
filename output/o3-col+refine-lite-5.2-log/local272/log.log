--Description: Cross‑check that the sum of “pick_qty” equals exactly the ordered amount for each product
SELECT "product_id",
       SUM("pick_qty") AS "picked_total",
       MIN("total_order_qty") AS "ordered_total"
FROM (
        /*‑‑ the previous query re‑used as a sub‑query to summarise picks ‑‑*/
        SELECT s."product_id",
               CASE
                 WHEN s."cum_qty" - s."available_qty" >= o."total_order_qty" THEN 0
                 WHEN s."cum_qty"  >  o."total_order_qty" THEN o."total_order_qty" - (s."cum_qty" - s."available_qty")
                 ELSE s."available_qty"
               END AS "pick_qty",
               o."total_order_qty"
        FROM (
                SELECT i."product_id",
                       i."id",
                       i."qty" AS "available_qty",
                       SUM(i."qty") OVER (PARTITION BY i."product_id"
                                          ORDER BY p."purchased", i."qty") AS "cum_qty"
                FROM   "inventory"  AS i
                JOIN   "purchases"  AS p ON p."id"  = i."purchase_id"
                JOIN   "locations"  AS l ON l."id"  = i."location_id"
                WHERE  l."warehouse" = 1
                  AND  i."product_id" IN (SELECT DISTINCT "product_id"
                                          FROM "orderlines"
                                          WHERE "order_id" = 423)
             ) AS s
        JOIN (
                SELECT "product_id",
                       SUM("qty") AS "total_order_qty"
                FROM   "orderlines"
                WHERE  "order_id" = 423
                GROUP BY "product_id"
             ) AS o
          ON o."product_id" = s."product_id"
     )
GROUP BY "product_id"
LIMIT 20;
