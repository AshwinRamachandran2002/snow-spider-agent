GROUP BY i."product_id"
LIMIT 20;
```

```sql
--Description: Drill into the exact inventory lines for the products in Order 423 that sit in Warehouse 1 only
SELECT i."id"          AS "inventory_id",
       i."product_id",
       i."qty"         AS "location_qty",
       l."aisle",
       l."position"
FROM   "inventory"     AS i
JOIN   "locations"     AS l ON l."id" = i."location_id"
JOIN   "orderlines"    AS o ON o."product_id" = i."product_id"
WHERE  o."order_id" = 423
  AND  l."warehouse" = 1
ORDER BY i."product_id", i."purchase_id"
LIMIT 20;
```

```sql
--Description: Add the purchase date for each inventory line (needed to pick earliest lots first)
SELECT i."id"          AS "inventory_id",
       i."product_id",
       i."qty",
       p."purchased"   AS "purchased_date",
       l."aisle",
       l."position"
FROM   "inventory"     AS i
JOIN   "purchases"     AS p ON p."id"  = i."purchase_id"
JOIN   "locations"     AS l ON l."id"  = i."location_id"
JOIN   "orderlines"    AS o ON o."product_id" = i."product_id"
WHERE  o."order_id" = 423
  AND  l."warehouse" = 1
ORDER BY i."product_id", p."purchased", i."qty"
LIMIT 20;
```

```sql
--Description: For each product in the order, list inventory lines in the exact picking priority:
--             1) earliest purchase date, 2) then lowest quantity
SELECT i."product_id",
       i."id"          AS "inventory_id",
       p."purchased",
       i."qty",
       l."aisle",
       l."position"
FROM   "inventory"     AS i
JOIN   "purchases"     AS p ON p."id"  = i."purchase_id"
JOIN   "locations"     AS l ON l."id"  = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT DISTINCT "product_id"
                          FROM "orderlines"
                          WHERE "order_id" = 423)
ORDER BY i."product_id",
         p."purchased",
         i."qty"
LIMIT 20;
```

```sql
--Description: Running total – preview how many items will be picked from each line if we keep drawing until the order quantity is met
-- (uses window functions to accumulate picked quantity in the priority order)
SELECT i."product_id",
       i."id"          AS "inventory_id",
       p."purchased",
       i."qty"         AS "available_qty",
       SUM(i."qty") OVER (PARTITION BY i."product_id"
                          ORDER BY p."purchased", i."qty") AS "cum_qty",
       l."aisle",
       l."position"
FROM   "inventory"     AS i
JOIN   "purchases"     AS p ON p."id" = i."purchase_id"
JOIN   "locations"     AS l ON l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT DISTINCT "product_id"
                          FROM "orderlines"
                          WHERE "order_id" = 423)
ORDER BY i."product_id", p."purchased", i."qty"
LIMIT 20;
```

```sql
--Description: Verify that stock in Warehouse 1 is sufficient for every ordered product (order qty versus on‑hand qty)
SELECT o."product_id",
       SUM(o."qty") AS "needed",
       SUM(i."qty") AS "on_hand_warehouse1"
FROM "orderlines" AS o
LEFT JOIN "inventory"  AS i
       ON i."product_id" = o."product_id"
      AND i."location_id" IN (SELECT "id" FROM "locations" WHERE "warehouse" = 1)
WHERE o."order_id" = 423
GROUP BY o."product_id"
LIMIT 20;
```

```sql
--Description: (Optional) present the exact pick suggestion per inventory line once cumulative quantity exceeds requirement
--             – the CASE limits picked units so that we never exceed the order requirement
SELECT s."product_id",
       s."inventory_id",
       s."aisle",
       s."position",
       CASE
         WHEN s."cum_qty" - s."available_qty" >= o."total_order_qty" THEN 0
         WHEN s."cum_qty"  >  o."total_order_qty" THEN o."total_order_qty" - (s."cum_qty" - s."available_qty")
         ELSE s."available_qty"
       END AS "pick_qty"
FROM (
        SELECT i."product_id",
               i."id"          AS "inventory_id",
               i."qty"         AS "available_qty",
               SUM(i."qty") OVER (PARTITION BY i."product_id"
                                  ORDER BY p."purchased", i."qty") AS "cum_qty",
               l."aisle",
               l."position"
        FROM   "inventory"  AS i
        JOIN   "purchases"  AS p ON p."id"  = i."purchase_id"
        JOIN   "locations"  AS l ON l."id"  = i."location_id"
        WHERE  l."warehouse" = 1
          AND  i."product_id" IN (SELECT DISTINCT "product_id"
                                  FROM "orderlines"
                                  WHERE "order_id" = 423)
     )  AS s
JOIN (
        SELECT "product_id",
               SUM("qty") AS "total_order_qty"
        FROM   "orderlines"
        WHERE  "order_id" = 423
        GROUP BY "product_id"
     )  AS o
  ON o."product_id" = s."product_id"
ORDER BY s."product_id", s."cum_qty"
LIMIT 20;
```

```sql
--Description: Cross‑check that the sum of “pick_qty” equals exactly the ordered amount for each product
SELECT "product_id",
       SUM("pick_qty") AS "picked_total",
       MIN("total_order_qty") AS "ordered_total"
FROM (
        /*‑‑ the previous query re‑used as a sub‑query to summarise picks ‑‑*/
        SELECT s."product_id",
               CASE
                 WHEN s."cum_qty" - s."available_qty" >= o."total_order_qty" THEN 0
                 WHEN s."cum_qty"  >  o."total_order_qty" THEN o."total_order_qty" - (s."cum_qty" - s."available_qty")
                 ELSE s."available_qty"
               END AS "pick_qty",
               o."total_order_qty"
        FROM (
                SELECT i."product_id",
                       i."id",
                       i."qty" AS "available_qty",
                       SUM(i."qty") OVER (PARTITION BY i."product_id"
                                          ORDER BY p."purchased", i."qty") AS "cum_qty"
                FROM   "inventory"  AS i
                JOIN   "purchases"  AS p ON p."id"  = i."purchase_id"
                JOIN   "locations"  AS l ON l."id"  = i."location_id"
                WHERE  l."warehouse" = 1
                  AND  i."product_id" IN (SELECT DISTINCT "product_id"
                                          FROM "orderlines"
                                          WHERE "order_id" = 423)
             ) AS s
        JOIN (
                SELECT "product_id",
                       SUM("qty") AS "total_order_qty"
                FROM   "orderlines"
                WHERE  "order_id" = 423
                GROUP BY "product_id"
             ) AS o
          ON o."product_id" = s."product_id"
     )
GROUP BY "product_id"
LIMIT 20;
```
