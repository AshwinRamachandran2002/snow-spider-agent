Query:
--Description: (Optional) present the exact pick suggestion per inventory line once cumulative quantity exceeds requirement
--             – the CASE limits picked units so that we never exceed the order requirement
SELECT s."product_id",
       s."inventory_id",
       s."aisle",
       s."position",
       CASE
         WHEN s."cum_qty" - s."available_qty" >= o."total_order_qty" THEN 0
         WHEN s."cum_qty"  >  o."total_order_qty" THEN o."total_order_qty" - (s."cum_qty" - s."available_qty")
         ELSE s."available_qty"
       END AS "pick_qty"
FROM (
        SELECT i."product_id",
               i."id"          AS "inventory_id",
               i."qty"         AS "available_qty",
               SUM(i."qty") OVER (PARTITION BY i."product_id"
                                  ORDER BY p."purchased", i."qty") AS "cum_qty",
               l."aisle",
               l."position"
        FROM   "inventory"  AS i
        JOIN   "purchases"  AS p ON p."id"  = i."purchase_id"
        JOIN   "locations"  AS l ON l."id"  = i."location_id"
        WHERE  l."warehouse" = 1
          AND  i."product_id" IN (SELECT DISTINCT "product_id"
                                  FROM "orderlines"
                                  WHERE "order_id" = 423)
     )  AS s
JOIN (
        SELECT "product_id",
               SUM("qty") AS "total_order_qty"
        FROM   "orderlines"
        WHERE  "order_id" = 423
        GROUP BY "product_id"
     )  AS o
  ON o."product_id" = s."product_id"
ORDER BY s."product_id", s."cum_qty"
LIMIT 20;
Answer:
product_id,inventory_id,aisle,position,pick_qty
