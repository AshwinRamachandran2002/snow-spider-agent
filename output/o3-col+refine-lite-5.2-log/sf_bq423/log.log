  AND "advertiser_verification_status" = 'VERIFIED'
  AND "topic" ILIKE '%Health%'
LIMIT 20;
```

```sql
--Description: 6) Inspect the audience‑selection object to confirm every method is USED
SELECT  c."creative_id",
        c."audience_selection_approach_info"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS  c
WHERE   c."ad_format_type" = 'IMAGE'
  AND   c."advertiser_location" = 'CY'
  AND   c."advertiser_verification_status" = 'VERIFIED'
  AND   c."topic" ILIKE '%Health%'
LIMIT 20;
```

```sql
--Description: 7) Flatten region_stats to see if any of those ads were served in Croatia (HR)
SELECT  c."creative_id",
        r.value:"region_code"::STRING            AS "region_code",
        r.value:"first_shown"::STRING            AS "first_shown",
        r.value:"last_shown"::STRING             AS "last_shown",
        r.value:"times_shown_availability_date"  AS "times_shown_availability_date"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS c,
        LATERAL FLATTEN( INPUT => PARSE_JSON(c."region_stats") ) r
WHERE   c."ad_format_type" = 'IMAGE'
  AND   c."advertiser_location" = 'CY'
  AND   c."advertiser_verification_status" = 'VERIFIED'
  AND   c."topic" ILIKE '%Health%'
  AND   r.value:"region_code"::STRING = 'HR'
LIMIT 20;
```

```sql
--Description: 8) Among those Croatia‑served ads, keep only the rows where 
--              times_shown data is already available (times_shown_availability_date IS NULL)
SELECT  c."creative_id",
        r.value:"region_code"::STRING                   AS "region_code",
        r.value:"times_shown_availability_date"        AS "tsa_date"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS c,
        LATERAL FLATTEN( INPUT => PARSE_JSON(c."region_stats") ) r
WHERE   c."ad_format_type" = 'IMAGE'
  AND   c."advertiser_location" = 'CY'
  AND   c."advertiser_verification_status" = 'VERIFIED'
  AND   c."topic" ILIKE '%Health%'
  AND   r.value:"region_code"::STRING = 'HR'
  AND   r.value:"times_shown_availability_date" IS NULL
LIMIT 20;
```

```sql
--Description: 9) Impose the first‑shown and last‑shown date window
SELECT  c."creative_id",
        r.value:"region_code"::STRING AS "region_code",
        r.value:"first_shown"::STRING AS "first_shown",
        r.value:"last_shown"::STRING  AS "last_shown"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS c,
        LATERAL FLATTEN( INPUT => PARSE_JSON(c."region_stats") ) r
WHERE   c."ad_format_type" = 'IMAGE'
  AND   c."advertiser_location" = 'CY'
  AND   c."advertiser_verification_status" = 'VERIFIED'
  AND   c."topic" ILIKE '%Health%'
  AND   r.value:"region_code"::STRING = 'HR'
  AND   r.value:"times_shown_availability_date" IS NULL
  AND   r.value:"first_shown"::STRING  > '2023-01-01'
  AND   r.value:"last_shown"::STRING   < '2024-01-01'
LIMIT 20;
```

```sql
--Description: 10) Final answer query – extract the creative’s Ads Transparency Center URL
--               for the single ad with the highest upper bound of times shown
SELECT  c."creative_page_url"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS c,
        LATERAL FLATTEN( INPUT => PARSE_JSON(c."region_stats") ) r
WHERE   c."ad_format_type" = 'IMAGE'
  AND   c."advertiser_location" = 'CY'
  AND   c."advertiser_verification_status" = 'VERIFIED'
  AND   c."topic" ILIKE '%Health%'
  AND   r.value:"region_code"::STRING = 'HR'
  AND   r.value:"times_shown_availability_date" IS NULL
  AND   r.value:"first_shown"::STRING  > '2023-01-01'
  AND   r.value:"last_shown"::STRING   < '2024-01-01'
  AND   c."audience_selection_approach_info" ILIKE '%CRITERIA_INCLUDED%'        -- contextual
  AND   c."audience_selection_approach_info" ILIKE '%customer_lists":"CRITERIA_INCLUDED%' 
  AND   c."audience_selection_approach_info" ILIKE '%demographic_info":"CRITERIA_INCLUDED%' 
  AND   c."audience_selection_approach_info" ILIKE '%geo_location":"CRITERIA_INCLUDED%'    
  AND   c."audience_selection_approach_info" ILIKE '%topics_of_interest":"CRITERIA_INCLUDED%'
ORDER BY r.value:"times_shown_upper_bound"::NUMBER DESC
LIMIT 1;
```
