```sql
-- Description: 1. Check what years exist in the Orders table.
SELECT DISTINCT strftime('%Y', orderdate) AS order_year
FROM orders
ORDER BY order_year;
```

```sql
-- Description: 2. Preview the first 20 orders placed in 1998 (confirm data & columns we need).
SELECT orderid,
       customerid,
       employeeid,
       orderdate
FROM orders
WHERE strftime('%Y', orderdate) = '1998'
LIMIT 20;
```

```sql
-- Description: 3. Look at a few lines from Order_Details to understand unitprice, quantity & discount. 
SELECT *
FROM order_details
LIMIT 20;
```

```sql
-- Description: 4. Join 1998 Orders with Order_Details to see the “extended price” (unitprice*quantity, no discount) per line.
SELECT od.orderid,
       o.customerid,
       od.productid,
       od.unitprice,
       od.quantity,
       (od.unitprice * od.quantity) AS line_amount
FROM orders AS o
JOIN order_details AS od ON o.orderid = od.orderid
WHERE strftime('%Y', o.orderdate) = '1998'
LIMIT 20;
```

```sql
-- Description: 5. Aggregate the above join to get total spent per order (1998 only).
SELECT o.orderid,
       o.customerid,
       SUM(od.unitprice * od.quantity) AS order_total
FROM orders AS o
JOIN order_details AS od ON o.orderid = od.orderid
WHERE strftime('%Y', o.orderdate) = '1998'
GROUP BY o.orderid, o.customerid
LIMIT 20;
```

```sql
-- Description: 6. Aggregate further to get total spent per customer in 1998.
SELECT o.customerid,
       SUM(od.unitprice * od.quantity) AS customer_1998_total
FROM orders AS o
JOIN order_details AS od ON o.orderid = od.orderid
WHERE strftime('%Y', o.orderdate) = '1998'
GROUP BY o.customerid
LIMIT 20;
```

```sql
-- Description: 7. Inspect the customer‑group‑threshold table that defines the spending groups.
SELECT *
FROM customergroupthreshold
ORDER BY rangebottom;
```

```sql
-- Description: 8. Put customers into spending groups according to the thresholds (1998 totals).
SELECT ctot.customerid,
       ctot.customer_1998_total,
       cgt.groupname
FROM (
    SELECT o.customerid,
           SUM(od.unitprice * od.quantity) AS customer_1998_total
    FROM orders AS o
    JOIN order_details AS od ON o.orderid = od.orderid
    WHERE strftime('%Y', o.orderdate) = '1998'
    GROUP BY o.customerid
) AS ctot
JOIN customergroupthreshold AS cgt
  ON ctot.customer_1998_total >= cgt.rangebottom
 AND ctot.customer_1998_total <= cgt.rangetop
LIMIT 20;
```

```sql
-- Description: 9. Count how many customers fall into each spending group (1998).
SELECT cgt.groupname,
       COUNT(*) AS customers_in_group
FROM (
    SELECT o.customerid,
           SUM(od.unitprice * od.quantity) AS customer_1998_total
    FROM orders AS o
    JOIN order_details AS od ON o.orderid = od.orderid
    WHERE strftime('%Y', o.orderdate) = '1998'
    GROUP BY o.customerid
) AS ctot
JOIN customergroupthreshold AS cgt
  ON ctot.customer_1998_total BETWEEN cgt.rangebottom AND cgt.rangetop
GROUP BY cgt.groupname;
```

```sql
-- Description: 10. Final query: number & percentage of 1998 customers per spending group.
WITH customer_totals AS (
    SELECT o.customerid,
           SUM(od.unitprice * od.quantity) AS customer_1998_total
    FROM orders AS o
    JOIN order_details AS od ON o.orderid = od.orderid
    WHERE strftime('%Y', o.orderdate) = '1998'
    GROUP BY o.customerid
),
grouped AS (
    SELECT ct.customerid,
           cgt.groupname
    FROM customer_totals AS ct
    JOIN customergroupthreshold AS cgt
      ON ct.customer_1998_total BETWEEN cgt.rangebottom AND cgt.rangetop
)
SELECT g.groupname,
       COUNT(*) AS customers_in_group,
       ROUND(100.0 * COUNT(*) / (SELECT COUNT(*) FROM customer_totals), 2) AS pct_of_1998_customers
FROM grouped AS g
GROUP BY g.groupname
ORDER BY customers_in_group DESC;
```
