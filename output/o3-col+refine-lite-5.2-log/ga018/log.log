Query:
--Description: 5) Quick sanity check – how many PLP and PDP views exist?
WITH classified AS (
  SELECT
    CASE
      WHEN REGEXP_CONTAINS(LOWER((SELECT ep.value.string_value
                                   FROM UNNEST(event_params) ep
                                   WHERE ep.key='page_location')),
                           r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
           AND REGEXP_CONTAINS(LOWER((SELECT ep.value.string_value
                                   FROM UNNEST(event_params) ep
                                   WHERE ep.key='page_location')),
                           r'/[^/]*\+[^/]*$')                       THEN 'PDP'
      WHEN REGEXP_CONTAINS(LOWER((SELECT ep.value.string_value
                                   FROM UNNEST(event_params) ep
                                   WHERE ep.key='page_location')),
                           r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
           AND NOT REGEXP_CONTAINS(LOWER((SELECT ep.value.string_value
                                   FROM UNNEST(event_params) ep
                                   WHERE ep.key='page_location')),
                           r'/[^/]*\+[^/]*$')                       THEN 'PLP'
      ELSE 'Other'
    END AS page_type
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
)
SELECT page_type, COUNT(*) AS views
FROM classified
GROUP BY page_type
LIMIT 20;   -- only 3 rows expected: PLP / PDP / Other
