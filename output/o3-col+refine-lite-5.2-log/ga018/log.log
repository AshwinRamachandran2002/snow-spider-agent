```

```sql
--Description: 2) Extract the page_location URL from event_params.
SELECT
  event_timestamp,
  (SELECT ep.value.string_value
     FROM UNNEST(event_params) AS ep
    WHERE ep.key = 'page_location') AS page_location
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE event_name = 'page_view'
LIMIT 20;
```

```sql
--Description: 3) Add the session‑level id (ga_session_id) so we can keep
--all events inside the same session.
SELECT
  user_pseudo_id,
  (SELECT ep.value.int_value
     FROM UNNEST(event_params) AS ep
    WHERE ep.key = 'ga_session_id') AS session_id,
  event_timestamp,
  (SELECT ep.value.string_value
     FROM UNNEST(event_params) AS ep
    WHERE ep.key = 'page_location') AS url
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE event_name = 'page_view'
LIMIT 20;
```

```sql
--Description: 4) Classify every page_view as PLP / PDP / Other
--            (rule set taken from the spec).
WITH base AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value FROM UNNEST(event_params) ep
      WHERE ep.key = 'ga_session_id') AS session_id,
    event_timestamp,
    LOWER((SELECT ep.value.string_value FROM UNNEST(event_params) ep
      WHERE ep.key = 'page_location')) AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
)
SELECT
  user_pseudo_id,
  session_id,
  event_timestamp,
  url,
  CASE
    WHEN REGEXP_CONTAINS(url,
          r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
         AND REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$')                THEN 'PDP'
    WHEN REGEXP_CONTAINS(url,
          r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
         AND NOT REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$')            THEN 'PLP'
    ELSE 'Other'
  END AS page_type
FROM base
LIMIT 20;
```

```sql
--Description: 5) Quick sanity check – how many PLP and PDP views exist?
WITH classified AS (
  SELECT
    CASE
      WHEN REGEXP_CONTAINS(LOWER((SELECT ep.value.string_value
                                   FROM UNNEST(event_params) ep
                                   WHERE ep.key='page_location')),
                           r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
           AND REGEXP_CONTAINS(LOWER((SELECT ep.value.string_value
                                   FROM UNNEST(event_params) ep
                                   WHERE ep.key='page_location')),
                           r'/[^/]*\+[^/]*$')                       THEN 'PDP'
      WHEN REGEXP_CONTAINS(LOWER((SELECT ep.value.string_value
                                   FROM UNNEST(event_params) ep
                                   WHERE ep.key='page_location')),
                           r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
           AND NOT REGEXP_CONTAINS(LOWER((SELECT ep.value.string_value
                                   FROM UNNEST(event_params) ep
                                   WHERE ep.key='page_location')),
                           r'/[^/]*\+[^/]*$')                       THEN 'PLP'
      ELSE 'Other'
    END AS page_type
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
)
SELECT page_type, COUNT(*) AS views
FROM classified
GROUP BY page_type
LIMIT 20;   -- only 3 rows expected: PLP / PDP / Other
```

```sql
--Description: 6) List PLP view events that have a *later* PDP view
--               within the same (user, session).
WITH pageviews AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
       FROM UNNEST(event_params) ep
      WHERE ep.key = 'ga_session_id') AS session_id,
    event_timestamp,
    LOWER((SELECT ep.value.string_value
             FROM UNNEST(event_params) ep
            WHERE ep.key = 'page_location')) AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
),
classified AS (
  SELECT *,
    CASE
      WHEN REGEXP_CONTAINS(url,
            r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
           AND REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$')  THEN 'PDP'
      WHEN REGEXP_CONTAINS(url,
            r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
           AND NOT REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$')  THEN 'PLP'
      ELSE 'Other'
    END AS page_type
  FROM pageviews
),
plp AS (SELECT * FROM classified WHERE page_type = 'PLP'),
pdp AS (SELECT * FROM classified WHERE page_type = 'PDP')
SELECT
  plp.user_pseudo_id,
  plp.session_id,
  plp.event_timestamp AS plp_ts,
  plp.url       AS plp_url,
  pdp.event_timestamp AS next_pdp_ts,
  pdp.url       AS next_pdp_url
FROM plp
JOIN pdp
  ON plp.user_pseudo_id = pdp.user_pseudo_id
 AND plp.session_id    = pdp.session_id
 AND pdp.event_timestamp > plp.event_timestamp
LIMIT 20;
```

```sql
--Description: 7) How many total PLP view events and how many of them
--               eventually led to a PDP in‑session?
WITH pageviews AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
       FROM UNNEST(event_params) ep
      WHERE ep.key = 'ga_session_id') AS session_id,
    event_timestamp,
    LOWER((SELECT ep.value.string_value
             FROM UNNEST(event_params) ep
            WHERE ep.key = 'page_location')) AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
),
classified AS (
  SELECT *,
    CASE
      WHEN REGEXP_CONTAINS(url,
            r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
           AND REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$')  THEN 'PDP'
      WHEN REGEXP_CONTAINS(url,
            r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
           AND NOT REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$')  THEN 'PLP'
      ELSE 'Other'
    END AS page_type
  FROM pageviews
),
plp AS (SELECT * FROM classified WHERE page_type = 'PLP'),
pdp AS (SELECT * FROM classified WHERE page_type = 'PDP'),
plp_to_pdp AS (
  SELECT DISTINCT
         plp.user_pseudo_id,
         plp.session_id,
         plp.event_timestamp   -- distinct PLP events that had ANY later PDP
  FROM plp
  JOIN pdp
    ON plp.user_pseudo_id = pdp.user_pseudo_id
   AND plp.session_id    = pdp.session_id
   AND pdp.event_timestamp > plp.event_timestamp
)
SELECT
  (SELECT COUNT(*) FROM plp)          AS total_plp_views,
  (SELECT COUNT(*) FROM plp_to_pdp)   AS plp_leading_to_pdp
LIMIT 20;
```

```sql
--Description: 8) Final answer – include the % of PLP views that transition
--               to a PDP inside the same session on 2021‑01‑02.
WITH pageviews AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
       FROM UNNEST(event_params) ep
      WHERE ep.key = 'ga_session_id') AS session_id,
    event_timestamp,
    LOWER((SELECT ep.value.string_value
             FROM UNNEST(event_params) ep
            WHERE ep.key = 'page_location')) AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
),
classified AS (
  SELECT *,
    CASE
      WHEN REGEXP_CONTAINS(url,
            r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
         AND REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$')  THEN 'PDP'
      WHEN REGEXP_CONTAINS(url,
            r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
         AND NOT REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$')  THEN 'PLP'
      ELSE 'Other'
    END AS page_type
  FROM pageviews
),
plp AS (SELECT * FROM classified WHERE page_type = 'PLP'),
pdp AS (SELECT * FROM classified WHERE page_type = 'PDP'),
plp_to_pdp AS (
  SELECT DISTINCT
         plp.user_pseudo_id,
         plp.session_id,
         plp.event_timestamp
  FROM plp
  JOIN pdp
    ON plp.user_pseudo_id = pdp.user_pseudo_id
   AND plp.session_id    = pdp.session_id
   AND pdp.event_timestamp > plp.event_timestamp
)
SELECT
  COUNT(*)                                    AS total_plp_views,
  (SELECT COUNT(*) FROM plp_to_pdp)           AS plp_with_pdp_afterwards,
  ROUND(100 * (SELECT COUNT(*) FROM plp_to_pdp) / COUNT(*), 2)
                                              AS pct_plp_to_pdp
FROM plp
LIMIT 20;
```

Running the final query will yield:

• total_plp_views – all PLP page_view events on 2021‑01‑02  
• plp_with_pdp_afterwards – those PLP views that were followed by at least one PDP view in the same session  
• pct_plp_to_pdp – the percentage transition rate (PLP → PDP).
