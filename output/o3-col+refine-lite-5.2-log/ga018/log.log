           AND NOT REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$')  THEN 'PLP'
      ELSE 'Other'
    END AS page_type
  FROM pageviews
),
plp AS (SELECT * FROM classified WHERE page_type = 'PLP'),
pdp AS (SELECT * FROM classified WHERE page_type = 'PDP'),
plp_to_pdp AS (
  SELECT DISTINCT
         plp.user_pseudo_id,
         plp.session_id,
         plp.event_timestamp   -- distinct PLP events that had ANY later PDP
  FROM plp
  JOIN pdp
    ON plp.user_pseudo_id = pdp.user_pseudo_id
   AND plp.session_id    = pdp.session_id
   AND pdp.event_timestamp > plp.event_timestamp
)
SELECT
  (SELECT COUNT(*) FROM plp)          AS total_plp_views,
  (SELECT COUNT(*) FROM plp_to_pdp)   AS plp_leading_to_pdp
LIMIT 20;
