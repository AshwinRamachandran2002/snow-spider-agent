Query:
--Description: 6) List PLP view events that have a *later* PDP view
--               within the same (user, session).
WITH pageviews AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
       FROM UNNEST(event_params) ep
      WHERE ep.key = 'ga_session_id') AS session_id,
    event_timestamp,
    LOWER((SELECT ep.value.string_value
             FROM UNNEST(event_params) ep
            WHERE ep.key = 'page_location')) AS url
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_name = 'page_view'
),
classified AS (
  SELECT *,
    CASE
      WHEN REGEXP_CONTAINS(url,
            r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
           AND REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$')  THEN 'PDP'
      WHEN REGEXP_CONTAINS(url,
            r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
           AND NOT REGEXP_CONTAINS(url, r'/[^/]*\+[^/]*$')  THEN 'PLP'
      ELSE 'Other'
    END AS page_type
  FROM pageviews
),
plp AS (SELECT * FROM classified WHERE page_type = 'PLP'),
pdp AS (SELECT * FROM classified WHERE page_type = 'PDP')
SELECT
  plp.user_pseudo_id,
  plp.session_id,
  plp.event_timestamp AS plp_ts,
  plp.url       AS plp_url,
  pdp.event_timestamp AS next_pdp_ts,
  pdp.url       AS next_pdp_url
FROM plp
JOIN pdp
  ON plp.user_pseudo_id = pdp.user_pseudo_id
 AND plp.session_id    = pdp.session_id
 AND pdp.event_timestamp > plp.event_timestamp
LIMIT 20;
