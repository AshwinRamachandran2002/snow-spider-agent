LIMIT 20;
```

```sql
-- 9. Compare Stack vs. traditional counts side by side
SELECT
       SUM(CASE WHEN LOWER("L1_model") LIKE '%stack%' THEN 1 END) AS stack_total,
       SUM(CASE WHEN LOWER("L1_model") NOT LIKE '%stack%' THEN 1 END) AS traditional_total
FROM "model";
```

```sql
-- 10. Return the winning category and its total occurrences
SELECT
       CASE
           WHEN SUM(CASE WHEN LOWER("L1_model") LIKE '%stack%' THEN 1 END)
                >=
                SUM(CASE WHEN LOWER("L1_model") NOT LIKE '%stack%' THEN 1 END)
           THEN 'Stack'
           ELSE 'Traditional'
       END                                                     AS most_frequent_category,
       MAX(SUM(CASE WHEN LOWER("L1_model") LIKE '%stack%' THEN 1 END),
           SUM(CASE WHEN LOWER("L1_model") NOT LIKE '%stack%' THEN 1 END)) AS total_occurrences
FROM "model";
```
