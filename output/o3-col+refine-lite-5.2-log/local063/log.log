-- 10) Return only the single product that satisfies all conditions
--     (smallest percentage‑point change)  
WITH growing_cities AS ( /* same definition as in query 9 */ 
      SELECT a.cust_city
      FROM   (SELECT cu.cust_city, SUM(s.amount_sold) AS amt_2019
              FROM   sales s
              JOIN   customers cu ON cu.cust_id = s.cust_id
              JOIN   countries co ON co.country_id = cu.country_id
              JOIN   times     t  ON t.time_id     = s.time_id
              WHERE  co.country_name LIKE '%United%'
                AND  s.promo_id = 999
                AND  t.calendar_quarter_id = 1772
              GROUP  BY cu.cust_city) a
      JOIN   (SELECT cu.cust_city, SUM(s.amount_sold) AS amt_2020
              FROM   sales s
              JOIN   customers cu ON cu.cust_id = s.cust_id
              JOIN   countries co ON co.country_id = cu.country_id
              JOIN   times     t  ON t.time_id     = s.time_id
              WHERE  co.country_name LIKE '%United%'
                AND  s.promo_id = 999
                AND  t.calendar_quarter_id = 1776
              GROUP  BY cu.cust_city) b
             ON a.cust_city = b.cust_city
      WHERE  b.amt_2020 >= 1.2 * a.amt_2019 ),
prod_tot AS ( /* total sales per product */ 
      SELECT s.prod_id,
             SUM(s.amount_sold) AS total_sales
      FROM   sales      s
      JOIN   customers  cu ON cu.cust_id = s.cust_id
      JOIN   countries  co ON co.country_id = cu.country_id
      JOIN   times      t  ON t.time_id     = s.time_id
      WHERE  co.country_name LIKE '%United%'
        AND  s.promo_id = 999
        AND  t.calendar_quarter_id IN (1772,1776)
        AND  cu.cust_city IN (SELECT cust_city FROM growing_cities)
      GROUP  BY s.prod_id),
ranked AS (
      SELECT prod_id,
             total_sales,
             ROW_NUMBER() OVER (ORDER BY total_sales DESC) AS rn,
             COUNT(*)    OVER ()                           AS cnt
      FROM   prod_tot),
top20 AS (
      SELECT prod_id
      FROM   ranked
      WHERE  rn <= CEIL(cnt * 0.2) ),
totals AS (
      SELECT t.calendar_quarter_id  AS qtr,
             SUM(s.amount_sold)     AS qtr_total
      FROM   sales      s
      JOIN   customers  cu ON cu.cust_id = s.cust_id
      JOIN   countries  co ON co.country_id = cu.country_id
      JOIN   times      t  ON t.time_id     = s.time_id
      WHERE  co.country_name LIKE '%United%'
        AND  s.promo_id = 999
        AND  t.calendar_quarter_id IN (1772,1776)
        AND  cu.cust_city IN (SELECT cust_city FROM growing_cities)
      GROUP  BY t.calendar_quarter_id)
SELECT pr.prod_id,
       pr.prod_name,
       ROUND(
          ABS(
              (100.0 * SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END)
/                         (SELECT qtr_total FROM totals WHERE qtr = 1776))
              -
              (100.0 * SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END)
/                         (SELECT qtr_total FROM totals WHERE qtr = 1772))
          ), 2
       ) AS pct_point_change
FROM   sales      s
JOIN   customers  cu ON cu.cust_id = s.cust_id
JOIN   countries  co ON co.country_id = cu.country_id
JOIN   times      t  ON t.time_id     = s.time_id
JOIN   products   pr ON pr.prod_id    = s.prod_id
JOIN   top20      tp ON tp.prod_id    = s.prod_id
WHERE  co.country_name LIKE '%United%'
  AND  s.promo_id = 999
  AND  t.calendar_quarter_id IN (1772,1776)
  AND  cu.cust_city IN (SELECT cust_city FROM growing_cities)
GROUP  BY pr.prod_id, pr.prod_name
ORDER  BY pct_point_change ASC
LIMIT 1;
