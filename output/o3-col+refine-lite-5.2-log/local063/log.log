       SUM(s.amount_sold) AS total_2019_q4
FROM   sales      AS s
JOIN   customers  AS cu ON cu.cust_id = s.cust_id
JOIN   countries  AS co ON co.country_id = cu.country_id
JOIN   times      AS t  ON t.time_id     = s.time_id
WHERE  co.country_name LIKE '%United%'
  AND  s.promo_id           = 999
  AND  t.calendar_quarter_id = 1772      -- Q4‑2019
GROUP  BY cu.cust_city
ORDER  BY total_2019_q4 DESC
LIMIT 20;
