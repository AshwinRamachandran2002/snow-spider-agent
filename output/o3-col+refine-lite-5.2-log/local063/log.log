```sql
-- 1) Find the exact name(s) used for the United States and their country_id  
SELECT DISTINCT country_id, country_name
FROM countries
WHERE country_name LIKE '%United%'
LIMIT 20;
```

```sql
-- 2) Look at a few U‑S customers to see city names we will later group by  
SELECT c.cust_id,
       c.cust_city,
       co.country_name
FROM   customers AS c
JOIN   countries AS co USING (country_id)
WHERE  co.country_name LIKE '%United%'
LIMIT 20;
```

```sql
-- 3) Verify the two calendar_quarter_id values that represent
--    Q4‑2019 and Q4‑2020 in the time dimension  
SELECT DISTINCT calendar_quarter_id,
       calendar_quarter_desc,
       calendar_year,
       calendar_quarter_number
FROM   times
WHERE  calendar_quarter_id IN (1772,1776)
LIMIT 20;
```

```sql
-- 4) Sales (promo‑id = 999) by U‑S city in Q4‑2019  
SELECT cu.cust_city,
       SUM(s.amount_sold) AS total_2019_q4
FROM   sales      AS s
JOIN   customers  AS cu ON cu.cust_id = s.cust_id
JOIN   countries  AS co ON co.country_id = cu.country_id
JOIN   times      AS t  ON t.time_id     = s.time_id
WHERE  co.country_name LIKE '%United%'
  AND  s.promo_id           = 999
  AND  t.calendar_quarter_id = 1772      -- Q4‑2019
GROUP  BY cu.cust_city
ORDER  BY total_2019_q4 DESC
LIMIT 20;
```

```sql
-- 5) Sales (promo‑id = 999) by U‑S city in Q4‑2020  
SELECT cu.cust_city,
       SUM(s.amount_sold) AS total_2020_q4
FROM   sales      AS s
JOIN   customers  AS cu ON cu.cust_id = s.cust_id
JOIN   countries  AS co ON co.country_id = cu.country_id
JOIN   times      AS t  ON t.time_id     = s.time_id
WHERE  co.country_name LIKE '%United%'
  AND  s.promo_id           = 999
  AND  t.calendar_quarter_id = 1776      -- Q4‑2020
GROUP  BY cu.cust_city
ORDER  BY total_2020_q4 DESC
LIMIT 20;
```

```sql
-- 6) Cities whose promo‑999 sales grew by at least 20 % from Q4‑2019 to Q4‑2020  
WITH q4_2019 AS (
      SELECT cu.cust_city,
             SUM(s.amount_sold) AS amt_2019
      FROM   sales s
      JOIN   customers cu ON cu.cust_id = s.cust_id
      JOIN   countries co ON co.country_id = cu.country_id
      JOIN   times     t  ON t.time_id     = s.time_id
      WHERE  co.country_name LIKE '%United%'
        AND  s.promo_id = 999
        AND  t.calendar_quarter_id = 1772
      GROUP  BY cu.cust_city),
     q4_2020 AS (
      SELECT cu.cust_city,
             SUM(s.amount_sold) AS amt_2020
      FROM   sales s
      JOIN   customers cu ON cu.cust_id = s.cust_id
      JOIN   countries co ON co.country_id = cu.country_id
      JOIN   times     t  ON t.time_id     = s.time_id
      WHERE  co.country_name LIKE '%United%'
        AND  s.promo_id = 999
        AND  t.calendar_quarter_id = 1776
      GROUP  BY cu.cust_city)
SELECT a.cust_city
FROM   q4_2019 a
JOIN   q4_2020 b USING (cust_city)
WHERE  b.amt_2020 >= 1.2 * a.amt_2019
LIMIT 20;
```

```sql
-- 7) Total promo‑999 sales (both quarters) per product **in the growing cities**  
WITH growing_cities AS (  -- result of query 6
      SELECT a.cust_city
      FROM   (SELECT cu.cust_city,
                     SUM(s.amount_sold) AS amt_2019
              FROM   sales s
              JOIN   customers cu ON cu.cust_id = s.cust_id
              JOIN   countries co ON co.country_id = cu.country_id
              JOIN   times     t  ON t.time_id     = s.time_id
              WHERE  co.country_name LIKE '%United%'
                AND  s.promo_id = 999
                AND  t.calendar_quarter_id = 1772
              GROUP  BY cu.cust_city) a
      JOIN   (SELECT cu.cust_city,
                     SUM(s.amount_sold) AS amt_2020
              FROM   sales s
              JOIN   customers cu ON cu.cust_id = s.cust_id
              JOIN   countries co ON co.country_id = cu.country_id
              JOIN   times     t  ON t.time_id     = s.time_id
              WHERE  co.country_name LIKE '%United%'
                AND  s.promo_id = 999
                AND  t.calendar_quarter_id = 1776
              GROUP  BY cu.cust_city) b
             ON a.cust_city = b.cust_city
      WHERE  b.amt_2020 >= 1.2 * a.amt_2019 ),
prod_tot AS (
      SELECT s.prod_id,
             SUM(s.amount_sold) AS total_sales
      FROM   sales      s
      JOIN   customers  cu ON cu.cust_id = s.cust_id
      JOIN   countries  co ON co.country_id = cu.country_id
      JOIN   times      t  ON t.time_id     = s.time_id
      WHERE  co.country_name LIKE '%United%'
        AND  s.promo_id = 999
        AND  t.calendar_quarter_id IN (1772,1776)
        AND  cu.cust_city IN (SELECT cust_city FROM growing_cities)
      GROUP  BY s.prod_id)
SELECT *
FROM   prod_tot
ORDER  BY total_sales DESC
LIMIT 20;
```

```sql
-- 8) How many distinct products fall in scope (will be used to define the top‑20 %)  
WITH growing_cities AS ( /* same CTE as query 7 */ 
      SELECT a.cust_city
      FROM   (SELECT cu.cust_city, SUM(s.amount_sold) AS amt_2019
              FROM   sales s
              JOIN   customers cu ON cu.cust_id = s.cust_id
              JOIN   countries co ON co.country_id = cu.country_id
              JOIN   times     t  ON t.time_id     = s.time_id
              WHERE  co.country_name LIKE '%United%'
                AND  s.promo_id = 999
                AND  t.calendar_quarter_id = 1772
              GROUP  BY cu.cust_city) a
      JOIN   (SELECT cu.cust_city, SUM(s.amount_sold) AS amt_2020
              FROM   sales s
              JOIN   customers cu ON cu.cust_id = s.cust_id
              JOIN   countries co ON co.country_id = cu.country_id
              JOIN   times     t  ON t.time_id     = s.time_id
              WHERE  co.country_name LIKE '%United%'
                AND  s.promo_id = 999
                AND  t.calendar_quarter_id = 1776
              GROUP  BY cu.cust_city) b
             ON a.cust_city = b.cust_city
      WHERE  b.amt_2020 >= 1.2 * a.amt_2019 )
SELECT COUNT(DISTINCT s.prod_id) AS product_cnt
FROM   sales      s
JOIN   customers  cu ON cu.cust_id = s.cust_id
JOIN   countries  co ON co.country_id = cu.country_id
JOIN   times      t  ON t.time_id     = s.time_id
WHERE  co.country_name LIKE '%United%'
  AND  s.promo_id = 999
  AND  t.calendar_quarter_id IN (1772,1776)
  AND  cu.cust_city IN (SELECT cust_city FROM growing_cities);
```

```sql
-- 9) Compute each product’s share of total sales in the two quarters
--    (in the growing cities) and the %‑point change  
WITH growing_cities AS ( /* same as above */ 
      SELECT a.cust_city
      FROM   (SELECT cu.cust_city, SUM(s.amount_sold) AS amt_2019
              FROM   sales s
              JOIN   customers cu ON cu.cust_id = s.cust_id
              JOIN   countries co ON co.country_id = cu.country_id
              JOIN   times     t  ON t.time_id     = s.time_id
              WHERE  co.country_name LIKE '%United%'
                AND  s.promo_id = 999
                AND  t.calendar_quarter_id = 1772
              GROUP  BY cu.cust_city) a
      JOIN   (SELECT cu.cust_city, SUM(s.amount_sold) AS amt_2020
              FROM   sales s
              JOIN   customers cu ON cu.cust_id = s.cust_id
              JOIN   countries co ON co.country_id = cu.country_id
              JOIN   times     t  ON t.time_id     = s.time_id
              WHERE  co.country_name LIKE '%United%'
                AND  s.promo_id = 999
                AND  t.calendar_quarter_id = 1776
              GROUP  BY cu.cust_city) b
             ON a.cust_city = b.cust_city
      WHERE  b.amt_2020 >= 1.2 * a.amt_2019 ),
prod_tot AS (   -- total sales per product (both quarters) in scope
      SELECT s.prod_id,
             SUM(s.amount_sold) AS total_sales
      FROM   sales      s
      JOIN   customers  cu ON cu.cust_id = s.cust_id
      JOIN   countries  co ON co.country_id = cu.country_id
      JOIN   times      t  ON t.time_id     = s.time_id
      WHERE  co.country_name LIKE '%United%'
        AND  s.promo_id = 999
        AND  t.calendar_quarter_id IN (1772,1776)
        AND  cu.cust_city IN (SELECT cust_city FROM growing_cities)
      GROUP  BY s.prod_id),
ranked AS (      -- rank products by total sales to get top 20 %
      SELECT prod_id,
             total_sales,
             ROW_NUMBER() OVER (ORDER BY total_sales DESC) AS rn,
             COUNT(*)    OVER ()                           AS cnt
      FROM   prod_tot),
top20 AS (       -- the 20 % best‑selling products
      SELECT prod_id
      FROM   ranked
      WHERE  rn <= CEIL(cnt * 0.2) ),
totals AS (      -- denominator totals for each quarter
      SELECT t.calendar_quarter_id  AS qtr,
             SUM(s.amount_sold)     AS qtr_total
      FROM   sales      s
      JOIN   customers  cu ON cu.cust_id = s.cust_id
      JOIN   countries  co ON co.country_id = cu.country_id
      JOIN   times      t  ON t.time_id     = s.time_id
      WHERE  co.country_name LIKE '%United%'
        AND  s.promo_id = 999
        AND  t.calendar_quarter_id IN (1772,1776)
        AND  cu.cust_city IN (SELECT cust_city FROM growing_cities)
      GROUP  BY t.calendar_quarter_id)
SELECT p.prod_id,
       pr.prod_name,
       ROUND(100.0 * SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END)
/              (SELECT qtr_total FROM totals WHERE qtr = 1772), 2) AS share_2019_q4,
       ROUND(100.0 * SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END)
/              (SELECT qtr_total FROM totals WHERE qtr = 1776), 2) AS share_2020_q4,
       ROUND(
           ABS(
             (100.0 * SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END)
/                       (SELECT qtr_total FROM totals WHERE qtr = 1776))
             -
             (100.0 * SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END)
/                       (SELECT qtr_total FROM totals WHERE qtr = 1772))
           ), 2) AS pct_point_change
FROM   sales      s
JOIN   customers  cu ON cu.cust_id = s.cust_id
JOIN   countries  co ON co.country_id = cu.country_id
JOIN   times      t  ON t.time_id     = s.time_id
JOIN   products   pr ON pr.prod_id    = s.prod_id
JOIN   top20      p  ON p.prod_id     = s.prod_id
WHERE  co.country_name LIKE '%United%'
  AND  s.promo_id = 999
  AND  t.calendar_quarter_id IN (1772,1776)
  AND  cu.cust_city IN (SELECT cust_city FROM growing_cities)
GROUP  BY p.prod_id, pr.prod_name
ORDER  BY pct_point_change ASC
LIMIT 20;
```

