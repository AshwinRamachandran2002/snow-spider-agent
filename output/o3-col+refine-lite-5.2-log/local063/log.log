Query:
-- 6) Cities whose promo‑999 sales grew by at least 20 % from Q4‑2019 to Q4‑2020  
WITH q4_2019 AS (
      SELECT cu.cust_city,
             SUM(s.amount_sold) AS amt_2019
      FROM   sales s
      JOIN   customers cu ON cu.cust_id = s.cust_id
      JOIN   countries co ON co.country_id = cu.country_id
      JOIN   times     t  ON t.time_id     = s.time_id
      WHERE  co.country_name LIKE '%United%'
        AND  s.promo_id = 999
        AND  t.calendar_quarter_id = 1772
      GROUP  BY cu.cust_city),
     q4_2020 AS (
      SELECT cu.cust_city,
             SUM(s.amount_sold) AS amt_2020
      FROM   sales s
      JOIN   customers cu ON cu.cust_id = s.cust_id
      JOIN   countries co ON co.country_id = cu.country_id
      JOIN   times     t  ON t.time_id     = s.time_id
      WHERE  co.country_name LIKE '%United%'
        AND  s.promo_id = 999
        AND  t.calendar_quarter_id = 1776
      GROUP  BY cu.cust_city)
SELECT a.cust_city
FROM   q4_2019 a
JOIN   q4_2020 b USING (cust_city)
WHERE  b.amt_2020 >= 1.2 * a.amt_2019
LIMIT 20;
