```sql
-- Description: Get, for every problem/version/step, the maximum test score among non‑“Stack” models.
SELECT ms."name",
       ms."version",
       ms."step",
       MAX(ms."test_score") AS max_nonstack_test
FROM "model_score" AS ms
WHERE LOWER(ms."model") NOT LIKE '%stack%'
GROUP BY ms."name", ms."version", ms."step"
LIMIT 20;
```

```sql
-- Description: Fetch the test score of the “Stack” model for each problem/version/step.
SELECT ms."name",
       ms."version",
       ms."step",
       ms."test_score" AS stack_test
FROM "model_score" AS ms
WHERE LOWER(ms."model") LIKE '%stack%'
LIMIT 20;
```

```sql
-- Description: Combine the previous two queries to identify tuples where the Stack model beats every non‑Stack model.
SELECT ns."name",
       ns."version",
       ns."step"
FROM (
    SELECT "name","version","step", MAX("test_score") AS max_nonstack_test
    FROM "model_score"
    WHERE LOWER("model") NOT LIKE '%stack%'
    GROUP BY "name","version","step"
) AS ns
JOIN (
    SELECT "name","version","step","test_score" AS stack_test
    FROM "model_score"
    WHERE LOWER("model") LIKE '%stack%'
) AS st
ON ns."name"   = st."name"
AND ns."version" = st."version"
AND ns."step"    = st."step"
WHERE st.stack_test > ns.max_nonstack_test
LIMIT 20;
```

```sql
-- Description: Count, for each problem, how many (version,step) pairs satisfy the Stack‑beats‑all‑others condition obtained above.
WITH stack_better AS (
    SELECT ns."name",
           ns."version",
           ns."step"
    FROM (
        SELECT "name","version","step", MAX("test_score") AS max_nonstack_test
        FROM "model_score"
        WHERE LOWER("model") NOT LIKE '%stack%'
        GROUP BY "name","version","step"
    ) AS ns
    JOIN (
        SELECT "name","version","step","test_score" AS stack_test
        FROM "model_score"
        WHERE LOWER("model") LIKE '%stack%'
    ) AS st
    ON ns."name"   = st."name"
    AND ns."version" = st."version"
    AND ns."step"    = st."step"
    WHERE st.stack_test > ns.max_nonstack_test
)
SELECT "name",
       COUNT(*) AS nb_stack_better_steps
FROM stack_better
GROUP BY "name"
LIMIT 20;
```

```sql
-- Description: Count how many total times each problem appears in the solution table.
SELECT "name",
       COUNT(*) AS nb_solution_rows
FROM "solution"
GROUP BY "name"
LIMIT 20;
```

```sql
-- Description: List problems where the number of Stack‑better steps exceeds the total occurrences in solution.
WITH stack_better AS (
    SELECT ns."name",
           ns."version",
           ns."step"
    FROM (
        SELECT "name","version","step", MAX("test_score") AS max_nonstack_test
        FROM "model_score"
        WHERE LOWER("model") NOT LIKE '%stack%'
        GROUP BY "name","version","step"
    ) AS ns
    JOIN (
        SELECT "name","version","step","test_score" AS stack_test
        FROM "model_score"
        WHERE LOWER("model") LIKE '%stack%'
    ) AS st
    ON ns."name"   = st."name"
    AND ns."version" = st."version"
    AND ns."step"    = st."step"
    WHERE st.stack_test > ns.max_nonstack_test
),
stack_better_count AS (
    SELECT "name",
           COUNT(*) AS nb_stack_better
    FROM stack_better
    GROUP BY "name"
),
solution_count AS (
    SELECT "name",
           COUNT(*) AS nb_solution
    FROM "solution"
    GROUP BY "name"
)
SELECT sbc."name"
FROM stack_better_count AS sbc
JOIN solution_count  AS sc
ON sbc."name" = sc."name"
WHERE sbc.nb_stack_better > sc.nb_solution
LIMIT 20;
```

```sql
-- Description: Show full details (problem, version, step, scores) for rows fulfilling final condition (checking up to step 3).
WITH stack_better AS (
    SELECT st."name",
           st."version",
           st."step",
           st.stack_test,
           ns.max_nonstack_test
    FROM (
        SELECT "name","version","step","test_score" AS stack_test
        FROM "model_score"
        WHERE LOWER("model") LIKE '%stack%'
          AND "step" IN (1,2,3)
    ) AS st
    JOIN (
        SELECT "name","version","step", MAX("test_score") AS max_nonstack_test
        FROM "model_score"
        WHERE LOWER("model") NOT LIKE '%stack%'
          AND "step" IN (1,2,3)
        GROUP BY "name","version","step"
    ) AS ns
    ON st."name"   = ns."name"
    AND st."version" = ns."version"
    AND st."step"    = ns."step"
    WHERE st.stack_test > ns.max_nonstack_test
),
problem_check AS (
    SELECT "name"
    FROM "solution"
)
SELECT sb.*
FROM stack_better AS sb
JOIN problem_check pc ON sb."name" = pc."name"
LIMIT 20;
```
