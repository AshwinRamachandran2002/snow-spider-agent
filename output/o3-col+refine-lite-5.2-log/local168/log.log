Query:
--Description: Compute the overall average annual salary for remote Data‑Analyst postings that list at least one of the TOP‑3 most frequent skills.
WITH remote_da AS (
    SELECT "job_id", "salary_year_avg"
    FROM "job_postings_fact"
    WHERE "job_title_short" = 'Data Analyst'
      AND "job_work_from_home" = 1
      AND "salary_year_avg" IS NOT NULL
),
top3 AS (
    SELECT sjd."skill_id"
    FROM "skills_job_dim" AS sjd
    JOIN remote_da
      ON remote_da."job_id" = sjd."job_id"
    GROUP BY sjd."skill_id"
    ORDER BY COUNT(*) DESC
    LIMIT 3
),
qualified_jobs AS (
    SELECT DISTINCT sjd."job_id"
    FROM "skills_job_dim" AS sjd
    JOIN top3
      ON top3."skill_id" = sjd."skill_id"
)
SELECT AVG(rd."salary_year_avg") AS "overall_avg_salary_top3_skills"
FROM remote_da AS rd
JOIN qualified_jobs AS qj
  ON rd."job_id" = qj."job_id"
