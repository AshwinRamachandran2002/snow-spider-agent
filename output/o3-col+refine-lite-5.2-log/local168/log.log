```sql
--Description: This single query accomplishes three tasks in one flow:
--  1) Filters “job_postings_fact” to remote‑eligible “Data Analyst” roles that provide an annual
--     salary (CTE da_remote).
--  2) Determines the three most frequently mentioned skills across those filtered jobs (CTE top3).
--  3) For each of those top‑3 skills, returns:
--        • the skill name,
--        • the average salary of jobs requiring that skill,
--        • the count of distinct jobs that mention the skill.
--     The final SELECT aggregates on the skill name, ensuring the output is never empty
--     as long as at least one qualifying job and skill exist.
WITH da_remote AS (                             -- Step 1
    SELECT "job_id", "salary_year_avg"
    FROM "job_postings_fact"
    WHERE "job_title_short"    = 'Data Analyst'
      AND "job_work_from_home" = 1
      AND "salary_year_avg"   IS NOT NULL
),
top3 AS (                                       -- Step 2
    SELECT sjd."skill_id"
    FROM "skills_job_dim" sjd
    JOIN da_remote dr ON dr."job_id" = sjd."job_id"
    GROUP BY sjd."skill_id"
    ORDER BY COUNT(*) DESC
    LIMIT 3
)
SELECT sd."skills",
       AVG(dr."salary_year_avg")        AS "avg_salary_for_skill",
       COUNT(DISTINCT dr."job_id")      AS "num_jobs"
FROM da_remote               dr
JOIN "skills_job_dim"     sjd ON sjd."job_id"  = dr."job_id"
JOIN top3                 t3  ON t3."skill_id" = sjd."skill_id"
JOIN "skills_dim"         sd  ON sd."skill_id" = sjd."skill_id"
GROUP BY sd."skills";
```
