```sql
--Description: Filter “job_postings_fact” to remote‑only “Data Analyst” roles that include an annual
--             salary, join to “skills_job_dim” to see every skill each job lists, aggregate to
--             produce the average salary and distinct‑job count per skill, then return the three
--             skills that appear in the largest number of those jobs (i.e., the most in‑demand
--             skills for this subset of postings).  A LEFT JOIN to “skills_dim” converts skill_id
--             to a readable name; COALESCE guards against any missing names.
WITH da_remote AS (                              -- eligible job postings
    SELECT "job_id", "salary_year_avg"
    FROM "job_postings_fact"
    WHERE "job_title_short"    = 'Data Analyst'
      AND "job_work_from_home" = 1
      AND "salary_year_avg"   IS NOT NULL
),
skill_salary AS (                                -- salary + job count for each skill
    SELECT sjd."skill_id",
           AVG(dr."salary_year_avg")        AS avg_salary,
           COUNT(DISTINCT dr."job_id")      AS job_count
    FROM da_remote dr
    JOIN "skills_job_dim" sjd
      ON sjd."job_id" = dr."job_id"
    GROUP BY sjd."skill_id"
)
SELECT COALESCE(sd."skills", 'unknown') AS skill_name,
       ss.avg_salary,
       ss.job_count
FROM skill_salary ss
LEFT JOIN "skills_dim" sd
       ON sd."skill_id" = ss."skill_id"
ORDER BY ss.job_count DESC
LIMIT 3;
```
