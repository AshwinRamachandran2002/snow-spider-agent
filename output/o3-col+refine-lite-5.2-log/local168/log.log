```sql
-- 1) Inspect job postings classified as “Data Analyst” to understand columns we need
SELECT DISTINCT "job_id", "job_title_short", "job_work_from_home", 
       "salary_year_avg"
FROM "job_postings_fact"
WHERE "job_title_short" = 'Data Analyst'
LIMIT 20;
```

```sql
-- 2) Keep only remote (“job_work_from_home” = 1) Data‑Analyst postings that have a non‑NULL annual salary
SELECT DISTINCT "job_id", "salary_year_avg"
FROM "job_postings_fact"
WHERE "job_title_short" = 'Data Analyst'
  AND "job_work_from_home" = 1
  AND "salary_year_avg" IS NOT NULL
LIMIT 20;
```

```sql
-- 3) Find every skill attached to those filtered postings
SELECT DISTINCT sjd."job_id", sjd."skill_id"
FROM "skills_job_dim" AS sjd
JOIN (
      SELECT "job_id"
      FROM "job_postings_fact"
      WHERE "job_title_short" = 'Data Analyst'
        AND "job_work_from_home" = 1
        AND "salary_year_avg" IS NOT NULL
     ) AS f
  ON sjd."job_id" = f."job_id"
LIMIT 20;
```

```sql
-- 4) Translate the “skill_id” values into human‑readable skill names
SELECT DISTINCT sd."skill_id", sd."skills", sd."type"
FROM "skills_dim" AS sd
JOIN (
      SELECT DISTINCT sjd."skill_id"
      FROM "skills_job_dim" AS sjd
      JOIN (
            SELECT "job_id"
            FROM "job_postings_fact"
            WHERE "job_title_short" = 'Data Analyst'
              AND "job_work_from_home" = 1
              AND "salary_year_avg" IS NOT NULL
           ) AS f
        ON sjd."job_id" = f."job_id"
     ) AS t
  ON sd."skill_id" = t."skill_id"
LIMIT 20;
```

```sql
-- 5) Count how often each skill appears in those postings
SELECT sd."skill_id",
       sd."skills",
       COUNT(*) AS "frequency"
FROM "skills_job_dim" AS sjd
JOIN (
      SELECT "job_id"
      FROM "job_postings_fact"
      WHERE "job_title_short" = 'Data Analyst'
        AND "job_work_from_home" = 1
        AND "salary_year_avg" IS NOT NULL
     ) AS f
  ON sjd."job_id" = f."job_id"
JOIN "skills_dim" AS sd
  ON sd."skill_id" = sjd."skill_id"
GROUP BY sd."skill_id", sd."skills"
ORDER BY "frequency" DESC
LIMIT 20;
```

```sql
-- 6) Retrieve the TOP‑3 most frequent skills for these remote Data‑Analyst roles
WITH ranked AS (
  SELECT sd."skill_id",
         sd."skills",
         COUNT(*) AS "freq",
         ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rnk
  FROM "skills_job_dim" AS sjd
  JOIN (
        SELECT "job_id"
        FROM "job_postings_fact"
        WHERE "job_title_short" = 'Data Analyst'
          AND "job_work_from_home" = 1
          AND "salary_year_avg" IS NOT NULL
       ) AS f
    ON sjd."job_id" = f."job_id"
  JOIN "skills_dim" AS sd
    ON sd."skill_id" = sjd."skill_id"
  GROUP BY sd."skill_id", sd."skills"
)
SELECT "skill_id", "skills", "freq"
FROM ranked
WHERE rnk <= 3;
```

```sql
-- 7) List every job‑id that includes at least one of those TOP‑3 skills
WITH top3 AS (
  SELECT "skill_id"
  FROM (
        SELECT sjd."skill_id",
               COUNT(*) AS freq
        FROM "skills_job_dim" AS sjd
        JOIN (
              SELECT "job_id"
              FROM "job_postings_fact"
              WHERE "job_title_short" = 'Data Analyst'
                AND "job_work_from_home" = 1
                AND "salary_year_avg" IS NOT NULL
             ) AS f
          ON sjd."job_id" = f."job_id"
        GROUP BY sjd."skill_id"
        ORDER BY freq DESC
        LIMIT 3
       )
)
SELECT DISTINCT sjd."job_id"
FROM "skills_job_dim" AS sjd
JOIN top3
  ON top3."skill_id" = sjd."skill_id"
LIMIT 20;
```

```sql
-- 8) Compute the OVERALL AVERAGE annual salary of those postings requiring any of the TOP‑3 skills
WITH remote_da AS (
    SELECT "job_id", "salary_year_avg"
    FROM "job_postings_fact"
    WHERE "job_title_short" = 'Data Analyst'
      AND "job_work_from_home" = 1
      AND "salary_year_avg" IS NOT NULL
),
top3 AS (
    SELECT "skill_id"
    FROM (
          SELECT sjd."skill_id",
                 COUNT(*) AS freq
          FROM "skills_job_dim" AS sjd
          JOIN remote_da
            ON remote_da."job_id" = sjd."job_id"
          GROUP BY sjd."skill_id"
          ORDER BY freq DESC
          LIMIT 3
         )
),
qualified_jobs AS (
    SELECT DISTINCT sjd."job_id"
    FROM "skills_job_dim" AS sjd
    JOIN top3
      ON top3."skill_id" = sjd."skill_id"
)
SELECT AVG(rd."salary_year_avg") AS "overall_avg_salary_top3_skills"
FROM remote_da AS rd
JOIN qualified_jobs AS qj
  ON rd."job_id" = qj."job_id";
```

```sql
-- 9) (Optional diagnostic) Show each top‑3 skill alongside the average salary of jobs that require it
WITH remote_da AS (
    SELECT "job_id", "salary_year_avg"
    FROM "job_postings_fact"
    WHERE "job_title_short" = 'Data Analyst'
      AND "job_work_from_home" = 1
      AND "salary_year_avg" IS NOT NULL
),
skill_freq AS (
    SELECT sjd."skill_id",
           COUNT(*) AS freq
    FROM "skills_job_dim" AS sjd
    JOIN remote_da
      ON remote_da."job_id" = sjd."job_id"
    GROUP BY sjd."skill_id"
    ORDER BY freq DESC
    LIMIT 3
)
SELECT sd."skills",
       AVG(rd."salary_year_avg") AS "avg_salary_for_skill",
       COUNT(*) AS "num_jobs"
FROM "skills_job_dim" AS sjd
JOIN skill_freq AS sf
  ON sjd."skill_id" = sf."skill_id"
JOIN "skills_dim" AS sd
  ON sd."skill_id" = sjd."skill_id"
JOIN remote_da AS rd
  ON rd."job_id" = sjd."job_id"
GROUP BY sd."skills";
```

```sql
-- 10) Final answer already produced in Query #8 (“overall_avg_salary_top3_skills”)
SELECT 'Use Query #8 for the required overall average salary.' AS note;
```
