Query:
--Description: 6) Combine the previous two pieces to flag whether each user is a purchaser (1) or not (0) for 1‑Dec‑2020 and show their page‑view count.
WITH pageviews AS (
  SELECT `user_pseudo_id`,
         COUNT(*) AS pageviews
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
  WHERE `event_name` = 'page_view'
  GROUP BY `user_pseudo_id`
),
purchasers AS (
  SELECT DISTINCT `user_pseudo_id`
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
  WHERE `event_name` = 'purchase'
)
SELECT pv.`user_pseudo_id`,
       pv.pageviews,
       IF(p.`user_pseudo_id` IS NULL, 0, 1) AS is_purchaser
FROM pageviews pv
LEFT JOIN purchasers p
USING (`user_pseudo_id`)
LIMIT 20;
