Query:
--Description: 9) Average page‑views per user, split by purchaser vs. non‑purchaser for December‑2020.
WITH pageviews AS (
  SELECT `user_pseudo_id`,
         COUNT(*) AS pageviews
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND `event_name` = 'page_view'
  GROUP BY `user_pseudo_id`
),
purchasers AS (
  SELECT DISTINCT `user_pseudo_id`
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND `event_name` = 'purchase'
)
SELECT IF(p.`user_pseudo_id` IS NULL, 0, 1) AS is_purchaser,
       AVG(pv.pageviews)                 AS avg_pageviews
FROM pageviews pv
LEFT JOIN purchasers p
USING (`user_pseudo_id`)
GROUP BY is_purchaser
LIMIT 20;
Answer:
is_purchaser,avg_pageviews
0,3.727810592925642
1,49.09316455696202
Query:
--Description: 10) Finally, get the *difference* in average page‑views: purchasers minus non‑purchasers for December‑2020.
WITH avgs AS (
  SELECT IF(p.`user_pseudo_id` IS NULL, 0, 1) AS is_purchaser,
         AVG(pv.pageviews)                 AS avg_pageviews
  FROM (
    SELECT `user_pseudo_id`,
           COUNT(*) AS pageviews
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
      AND `event_name` = 'page_view'
    GROUP BY `user_pseudo_id`
  ) pv
  LEFT JOIN (
    SELECT DISTINCT `user_pseudo_id`
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
      AND `event_name` = 'purchase'
  ) p
  USING (`user_pseudo_id`)
  GROUP BY is_purchaser
