Query:
-- 10. Description: Return, for each league, the single team with the fewest wins
-- (ties broken by the lowest team_api_id), together with readable names.
SELECT l.name          AS league_name,
       tm.team_long_name AS team_name,
       lw.wins
FROM (
        SELECT   league_id,
                 team_id,
                 wins,
                 ROW_NUMBER() OVER (PARTITION BY league_id
                                    ORDER BY wins ASC, team_id ASC) AS rn
        FROM (
                SELECT m.league_id,
                       winner_team_id AS team_id,
                       COUNT(*)       AS wins
                FROM (
                        SELECT league_id,
                               CASE
                                    WHEN home_team_goal > away_team_goal THEN home_team_api_id
                                    WHEN away_team_goal > home_team_goal THEN away_team_api_id
                               END AS winner_team_id
                        FROM "Match"
                        WHERE home_team_goal <> away_team_goal
                     ) AS m
                WHERE winner_team_id IS NOT NULL
                GROUP BY m.league_id, winner_team_id
             )
     ) AS lw
JOIN League AS l   ON l.id          = lw.league_id
JOIN Team   AS tm  ON tm.team_api_id = lw.team_id
WHERE lw.rn = 1
LIMIT 20;
Answer:
