```sql
-- 1. Description: Inspect a few matches to see the goal‑columns and the team/league identifiers.
SELECT id,
       league_id,
       season,
       home_team_api_id,
       away_team_api_id,
       home_team_goal,
       away_team_goal
FROM "Match"
LIMIT 20;
```

```sql
-- 2. Description: Look at the team catalogue and their readable long names.
SELECT id,
       team_api_id,
       team_long_name
FROM Team
LIMIT 20;
```

```sql
-- 3. Description: Show the list of leagues that appear in the data set.
SELECT id,
       name
FROM League
LIMIT 20;
```

```sql
-- 4. Description: Count home‑side wins per team (sample of 20 rows).
SELECT home_team_api_id  AS team_id,
       COUNT(*)          AS home_wins
FROM "Match"
WHERE home_team_goal > away_team_goal
GROUP BY home_team_api_id
LIMIT 20;
```

```sql
-- 5. Description: Count away‑side wins per team (sample of 20 rows).
SELECT away_team_api_id  AS team_id,
       COUNT(*)          AS away_wins
FROM "Match"
WHERE away_team_goal > home_team_goal
GROUP BY away_team_api_id
LIMIT 20;
```

```sql
-- 6. Description: Combine home & away victories to obtain total wins per team (sample).
SELECT team_id,
       SUM(win_flag) AS total_wins
FROM (
        SELECT home_team_api_id AS team_id, 1 AS win_flag
        FROM "Match"
        WHERE home_team_goal > away_team_goal
     UNION ALL
        SELECT away_team_api_id, 1
        FROM "Match"
        WHERE away_team_goal > home_team_goal
     )
GROUP BY team_id
LIMIT 20;
```

```sql
-- 7. Description: Make sure every registered team (even with zero wins) is kept.
SELECT t.team_api_id,
       COALESCE(w.total_wins, 0) AS total_wins
FROM Team AS t
LEFT JOIN (
        SELECT team_id,
               SUM(win_flag) AS total_wins
        FROM (
                SELECT home_team_api_id AS team_id, 1 AS win_flag
                FROM "Match"
                WHERE home_team_goal > away_team_goal
             UNION ALL
                SELECT away_team_api_id, 1
                FROM "Match"
                WHERE away_team_goal > home_team_goal
             )
        GROUP BY team_id
     ) AS w
ON t.team_api_id = w.team_id
LIMIT 20;
```

```sql
-- 8. Description: Compute total wins per (league, team) combination.
SELECT m.league_id,
       winner_team_id AS team_id,
       COUNT(*)       AS wins
FROM (
        SELECT league_id,
               CASE
                    WHEN home_team_goal > away_team_goal THEN home_team_api_id
                    WHEN away_team_goal > home_team_goal THEN away_team_api_id
               END AS winner_team_id
        FROM "Match"
        WHERE home_team_goal <> away_team_goal
     ) AS m
WHERE winner_team_id IS NOT NULL
GROUP BY m.league_id, winner_team_id
LIMIT 20;
```

```sql
-- 9. Description: For every league, find the minimum number of wins achieved by any team.
SELECT league_id,
       MIN(wins) AS fewest_wins
FROM (
        SELECT m.league_id,
               winner_team_id AS team_id,
               COUNT(*)       AS wins
        FROM (
                SELECT league_id,
                       CASE
                            WHEN home_team_goal > away_team_goal THEN home_team_api_id
                            WHEN away_team_goal > home_team_goal THEN away_team_api_id
                       END AS winner_team_id
                FROM "Match"
                WHERE home_team_goal <> away_team_goal
             ) AS m
        WHERE winner_team_id IS NOT NULL
        GROUP BY m.league_id, winner_team_id
     )
GROUP BY league_id
LIMIT 20;
```

```sql
-- 10. Description: Return, for each league, the single team with the fewest wins
-- (ties broken by the lowest team_api_id), together with readable names.
SELECT l.name          AS league_name,
       tm.team_long_name AS team_name,
       lw.wins
FROM (
        SELECT   league_id,
                 team_id,
                 wins,
                 ROW_NUMBER() OVER (PARTITION BY league_id
                                    ORDER BY wins ASC, team_id ASC) AS rn
        FROM (
                SELECT m.league_id,
                       winner_team_id AS team_id,
                       COUNT(*)       AS wins
                FROM (
                        SELECT league_id,
                               CASE
                                    WHEN home_team_goal > away_team_goal THEN home_team_api_id
                                    WHEN away_team_goal > home_team_goal THEN away_team_api_id
                               END AS winner_team_id
                        FROM "Match"
                        WHERE home_team_goal <> away_team_goal
                     ) AS m
                WHERE winner_team_id IS NOT NULL
                GROUP BY m.league_id, winner_team_id
             )
     ) AS lw
JOIN League AS l   ON l.id          = lw.league_id
JOIN Team   AS tm  ON tm.team_api_id = lw.team_id
WHERE lw.rn = 1
LIMIT 20;
```
