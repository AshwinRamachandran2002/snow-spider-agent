-- 7. Description: Make sure every registered team (even with zero wins) is kept.
SELECT t.team_api_id,
       COALESCE(w.total_wins, 0) AS total_wins
FROM Team AS t
LEFT JOIN (
        SELECT team_id,
               SUM(win_flag) AS total_wins
        FROM (
                SELECT home_team_api_id AS team_id, 1 AS win_flag
                FROM "Match"
                WHERE home_team_goal > away_team_goal
             UNION ALL
                SELECT away_team_api_id, 1
                FROM "Match"
                WHERE away_team_goal > home_team_goal
             )
        GROUP BY team_id
     ) AS w
ON t.team_api_id = w.team_id
LIMIT 20;
