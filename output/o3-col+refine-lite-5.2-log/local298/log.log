Query:
--Description: Work out the net movement (deposits – withdrawals) per customer per month
SELECT customer_id,
       strftime('%Y-%m', txn_date) AS txn_month,
       SUM(
           CASE 
             WHEN txn_type = 'deposit'   THEN txn_amount   -- positive
             ELSE                       -txn_amount        -- negative
           END
       ) AS net_amount
FROM customer_transactions
GROUP BY customer_id, txn_month
ORDER BY customer_id, txn_month
LIMIT 20;
