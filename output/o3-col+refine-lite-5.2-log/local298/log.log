```sql
--Description: Inspect a handful of raw customer transactions
SELECT customer_id,
       txn_date,
       txn_type,
       txn_amount
FROM customer_transactions
LIMIT 20;
```

```sql
--Description: See every transaction type that exists
SELECT DISTINCT txn_type
FROM customer_transactions
LIMIT 20;
```

```sql
--Description: List every month for which we have at least one transaction
SELECT DISTINCT strftime('%Y-%m', txn_date)  AS txn_month
FROM customer_transactions
ORDER BY txn_month
LIMIT 20;
```

```sql
--Description: Work out the net movement (deposits – withdrawals) per customer per month
SELECT customer_id,
       strftime('%Y-%m', txn_date) AS txn_month,
       SUM(
           CASE 
             WHEN txn_type = 'deposit'   THEN txn_amount   -- positive
             ELSE                       -txn_amount        -- negative
           END
       ) AS net_amount
FROM customer_transactions
GROUP BY customer_id, txn_month
ORDER BY customer_id, txn_month
LIMIT 20;
```

```sql
--Description: Build a running month‑end balance for every customer
SELECT customer_id,
       txn_month,
       SUM(net_amount) OVER (
           PARTITION BY customer_id
           ORDER BY      txn_month
       ) AS balance_to_date
FROM (
    SELECT customer_id,
           strftime('%Y-%m', txn_date) AS txn_month,
           SUM(
               CASE 
                 WHEN txn_type = 'deposit' THEN txn_amount
                 ELSE                     -txn_amount
               END
           ) AS net_amount
    FROM customer_transactions
    GROUP BY customer_id, txn_month
) AS m
ORDER BY customer_id, txn_month
LIMIT 20;
```

```sql
--Description: Collapse the customer balances into a single total balance for every month‑end
SELECT txn_month,
       SUM(balance_to_date) AS total_balance
FROM (
    SELECT customer_id,
           txn_month,
           SUM(net_amount) OVER (
               PARTITION BY customer_id
               ORDER BY      txn_month
           ) AS balance_to_date
    FROM (
        SELECT customer_id,
               strftime('%Y-%m', txn_date) AS txn_month,
               SUM(
                   CASE 
                     WHEN txn_type = 'deposit' THEN txn_amount
                     ELSE                     -txn_amount
                   END
               ) AS net_amount
        FROM customer_transactions
        GROUP BY customer_id, txn_month
    )
)
GROUP BY txn_month
ORDER BY txn_month
LIMIT 20;
```

```sql
--Description: For every month, attach the total balance that existed at the END of the PREVIOUS month
SELECT DATE(txn_month || '-01')                                         AS month_start,
       LAG(total_balance) OVER (ORDER BY txn_month)                     AS prev_month_total_balance
FROM (
    SELECT txn_month,
           SUM(balance_to_date) AS total_balance
    FROM (
        SELECT customer_id,
               txn_month,
               SUM(net_amount) OVER (
                   PARTITION BY customer_id
                   ORDER BY      txn_month
               ) AS balance_to_date
        FROM (
            SELECT customer_id,
                   strftime('%Y-%m', txn_date) AS txn_month,
                   SUM(
                       CASE 
                         WHEN txn_type = 'deposit' THEN txn_amount
                         ELSE                     -txn_amount
                       END
                   ) AS net_amount
            FROM customer_transactions
            GROUP BY customer_id, txn_month
        )
    )
    GROUP BY txn_month
)
ORDER BY month_start
LIMIT 20;
```

```sql
--Description: Final answer – previous‑month balances (negatives turned to 0) with the first month removed
SELECT month_start,
       CASE 
         WHEN prev_month_total_balance < 0 THEN 0
         ELSE prev_month_total_balance
       END AS prev_month_total_balance
FROM (
    SELECT DATE(txn_month || '-01')                             AS month_start,
           LAG(total_balance) OVER (ORDER BY txn_month)         AS prev_month_total_balance
    FROM (
        SELECT txn_month,
               SUM(balance_to_date) AS total_balance
        FROM (
            SELECT customer_id,
                   txn_month,
                   SUM(net_amount) OVER (
                       PARTITION BY customer_id
                       ORDER BY      txn_month
                   ) AS balance_to_date
            FROM (
                SELECT customer_id,
                       strftime('%Y-%m', txn_date) AS txn_month,
                       SUM(
                           CASE 
                             WHEN txn_type = 'deposit' THEN txn_amount
                             ELSE                     -txn_amount
                           END
                       ) AS net_amount
                FROM customer_transactions
                GROUP BY customer_id, txn_month
            )
        )
        GROUP BY txn_month
    )
)
WHERE prev_month_total_balance IS NOT NULL          -- drop first month
ORDER BY month_start
LIMIT 20;
```
