```sql
--Description: 7) Aggregate total surface area and building count for Amsterdam; group by class & subclass.  
SELECT
    b."CLASS",
    b."SUBCLASS",
    COUNT(*)                               AS "AMSTERDAM_BUILDING_COUNT",
    SUM( TRY_CAST(b."SURFACE_AREA_SQ_M" AS DOUBLE) ) AS "AMSTERDAM_TOTAL_SURFACE_SQ_M"
FROM NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b
WHERE b."CONTAINS_ADDRESSES" ILIKE '%"addr:city":"Amsterdam"%'
GROUP BY b."CLASS", b."SUBCLASS"
ORDER BY b."CLASS", b."SUBCLASS"
LIMIT 20;
```

```sql
--Description: 8) Aggregate total surface area and building count for Rotterdam; group by class & subclass.  
SELECT
    b."CLASS",
    b."SUBCLASS",
    COUNT(*)                               AS "ROTTERDAM_BUILDING_COUNT",
    SUM( TRY_CAST(b."SURFACE_AREA_SQ_M" AS DOUBLE) ) AS "ROTTERDAM_TOTAL_SURFACE_SQ_M"
FROM NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b
WHERE b."CONTAINS_ADDRESSES" ILIKE '%"addr:city":"Rotterdam"%'
GROUP BY b."CLASS", b."SUBCLASS"
ORDER BY b."CLASS", b."SUBCLASS"
LIMIT 20;
```

```sql
--Description: 9) Combine the two previous aggregates side‑by‑side using a full outer join on class & subclass.  
WITH ams AS (
    SELECT
        b."CLASS",
        b."SUBCLASS",
        COUNT(*) AS "AMS_CNT",
        SUM( TRY_CAST(b."SURFACE_AREA_SQ_M" AS DOUBLE) ) AS "AMS_AREA"
    FROM NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b
    WHERE b."CONTAINS_ADDRESSES" ILIKE '%"addr:city":"Amsterdam"%'
    GROUP BY b."CLASS", b."SUBCLASS"
),
rot AS (
    SELECT
        b."CLASS",
        b."SUBCLASS",
        COUNT(*) AS "RTM_CNT",
        SUM( TRY_CAST(b."SURFACE_AREA_SQ_M" AS DOUBLE) ) AS "RTM_AREA"
    FROM NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b
    WHERE b."CONTAINS_ADDRESSES" ILIKE '%"addr:city":"Rotterdam"%'
    GROUP BY b."CLASS", b."SUBCLASS"
)
SELECT
    COALESCE(ams."CLASS", rot."CLASS")     AS "CLASS",
    COALESCE(ams."SUBCLASS", rot."SUBCLASS") AS "SUBCLASS",
    ams."AMS_CNT",
    ams."AMS_AREA",
    rot."RTM_CNT",
    rot."RTM_AREA"
FROM ams
FULL JOIN rot
      ON ams."CLASS" = rot."CLASS"
     AND ams."SUBCLASS" = rot."SUBCLASS"
ORDER BY 1,2
LIMIT 20;
```

```sql
--Description: 10) (Optional) The same combined report without LIMIT for full export; this produces the comprehensive side‑by‑side comparison required by the business.  
WITH ams AS (
    SELECT
        b."CLASS",
        b."SUBCLASS",
        COUNT(*) AS "AMS_CNT",
        SUM( TRY_CAST(b."SURFACE_AREA_SQ_M" AS DOUBLE) ) AS "AMS_AREA"
    FROM NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b
    WHERE b."CONTAINS_ADDRESSES" ILIKE '%"addr:city":"Amsterdam"%'
    GROUP BY b."CLASS", b."SUBCLASS"
),
rot AS (
    SELECT
        b."CLASS",
        b."SUBCLASS",
        COUNT(*) AS "RTM_CNT",
        SUM( TRY_CAST(b."SURFACE_AREA_SQ_M" AS DOUBLE) ) AS "RTM_AREA"
    FROM NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b
    WHERE b."CONTAINS_ADDRESSES" ILIKE '%"addr:city":"Rotterdam"%'
    GROUP BY b."CLASS", b."SUBCLASS"
)
SELECT
    COALESCE(ams."CLASS", rot."CLASS")       AS "CLASS",
    COALESCE(ams."SUBCLASS", rot."SUBCLASS") AS "SUBCLASS",
    NVL(ams."AMS_CNT", 0)                    AS "AMSTERDAM_BUILDING_COUNT",
    NVL(ams."AMS_AREA", 0)                   AS "AMSTERDAM_TOTAL_SURFACE_SQ_M",
    NVL(rot."RTM_CNT", 0)                    AS "ROTTERDAM_BUILDING_COUNT",
    NVL(rot."RTM_AREA", 0)                   AS "ROTTERDAM_TOTAL_SURFACE_SQ_M"
FROM ams
FULL JOIN rot
      ON ams."CLASS" = rot."CLASS"
     AND ams."SUBCLASS" = rot."SUBCLASS"
ORDER BY 1,2;
```
