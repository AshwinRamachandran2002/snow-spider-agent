    FROM NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b
    WHERE b."CONTAINS_ADDRESSES" ILIKE '%"addr:city":"Rotterdam"%'
    GROUP BY b."CLASS", b."SUBCLASS"
)
SELECT
    COALESCE(ams."CLASS", rot."CLASS")       AS "CLASS",
    COALESCE(ams."SUBCLASS", rot."SUBCLASS") AS "SUBCLASS",
    NVL(ams."AMS_CNT", 0)                    AS "AMSTERDAM_BUILDING_COUNT",
    NVL(ams."AMS_AREA", 0)                   AS "AMSTERDAM_TOTAL_SURFACE_SQ_M",
    NVL(rot."RTM_CNT", 0)                    AS "ROTTERDAM_BUILDING_COUNT",
    NVL(rot."RTM_AREA", 0)                   AS "ROTTERDAM_TOTAL_SURFACE_SQ_M"
FROM ams
FULL JOIN rot
      ON ams."CLASS" = rot."CLASS"
     AND ams."SUBCLASS" = rot."SUBCLASS"
ORDER BY 1,2;
