--Description: 7) Aggregate total surface area and building count for Amsterdam; group by class & subclass.  
SELECT
    b."CLASS",
    b."SUBCLASS",
    COUNT(*)                               AS "AMSTERDAM_BUILDING_COUNT",
    SUM( TRY_CAST(b."SURFACE_AREA_SQ_M" AS DOUBLE) ) AS "AMSTERDAM_TOTAL_SURFACE_SQ_M"
FROM NETHERLANDS_OPEN_MAP_DATA.NETHERLANDS.V_BUILDING b
WHERE b."CONTAINS_ADDRESSES" ILIKE '%"addr:city":"Amsterdam"%'
GROUP BY b."CLASS", b."SUBCLASS"
ORDER BY b."CLASS", b."SUBCLASS"
LIMIT 20;
