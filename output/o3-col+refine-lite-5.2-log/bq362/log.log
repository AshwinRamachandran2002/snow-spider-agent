```sql
--Description: 5) For a single company, calculate the month‑to‑month change in trip counts
WITH month_ct AS (
  SELECT
    EXTRACT(MONTH FROM `trip_start_timestamp`) AS month,
    COUNT(*) AS trips
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE EXTRACT(YEAR FROM `trip_start_timestamp`) = 2018
    AND `company` = 'Flash Cab'
  GROUP BY month
)
SELECT
  month,
  trips,
  LAG(trips) OVER (ORDER BY month) AS prev_trips,
  trips - LAG(trips) OVER (ORDER BY month) AS diff
FROM month_ct
ORDER BY month
LIMIT 20;
```

```sql
--Description: 6) Compute month‑to‑month differences for every company
WITH month_ct AS (
  SELECT
    `company`,
    EXTRACT(MONTH FROM `trip_start_timestamp`) AS month,
    COUNT(*) AS trips
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE EXTRACT(YEAR FROM `trip_start_timestamp`) = 2018
    AND `company` IS NOT NULL
  GROUP BY company, month
)
SELECT
  `company`,
  month,
  trips,
  LAG(trips) OVER (PARTITION BY company ORDER BY month) AS prev_trips,
  trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff
FROM month_ct
ORDER BY company, month
LIMIT 20;
```

```sql
--Description: 7) Show the largest positive month‑to‑month jump per company
WITH month_ct AS (
  SELECT
    `company`,
    EXTRACT(MONTH FROM `trip_start_timestamp`) AS month,
    COUNT(*) AS trips
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE EXTRACT(YEAR FROM `trip_start_timestamp`) = 2018
    AND `company` IS NOT NULL
  GROUP BY company, month
),
diffs AS (
  SELECT
    company,
    month,
    trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff
  FROM month_ct
)
SELECT
  company,
  MAX(diff) AS max_monthly_increase
FROM diffs
WHERE diff IS NOT NULL
GROUP BY company
ORDER BY max_monthly_increase DESC
LIMIT 20;
```

