Query:
--Description:  #8  Assign each event to the Monday of its week and calculate
--              weeks_since_cohort for every cohort user/event pair.
WITH cohort AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(MIN(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_monday
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180601' AND '20181002'
  GROUP BY user_pseudo_id
  HAVING cohort_monday = DATE '2018-07-02'
),
events AS (
  SELECT
    e.user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)) AS event_monday
  FROM `firebase-public-project.analytics_153293282.events_*` AS e
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND e.user_pseudo_id IN (SELECT user_pseudo_id FROM cohort)
)
SELECT
  user_pseudo_id,
  event_monday,
  (DATE_DIFF(event_monday, DATE '2018-07-02', DAY) / 7) AS weeks_since_cohort
FROM events
LIMIT 20
