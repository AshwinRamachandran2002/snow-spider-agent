Below is a short sequence (1 ➜ 10) of progressively more complex BigQuery queries that explore the raw GA4 tables and finish with a 7‑day‑bucket retention table for the cohort that first started a session in the Monday‑based week that begins 2018‑07‑02.  
All queries only reference the public GA4 dataset  
`firebase-public-project.analytics_153293282.events_*`.

```sql
-- 1. Description:  List the distinct event_date values that exist in July‑2018
SELECT DISTINCT event_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180701' AND '20180731'
ORDER BY event_date
LIMIT 20;
```

```sql
-- 2. Description:  Peek at “session_start” events around 2‑Jul‑2018
SELECT event_date,
       event_name,
       user_pseudo_id,
       event_timestamp
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180704'
  AND event_name = 'session_start'
LIMIT 20;
```

```sql
-- 3. Description:  Show how to turn any calendar day into its Monday‑of‑week
SELECT event_date,
       DATE_TRUNC(DATE(event_date), WEEK(MONDAY)) AS monday_of_week
FROM `firebase-public-project.analytics_153293282.events_20180703`
LIMIT 20;
```

```sql
-- 4. Description:  For every user, find the first calendar day they ever fired
--                  a "session_start" event (needed for cohort selection)
WITH first_session AS (
  SELECT
    user_pseudo_id,
    MIN(DATE(event_date)) AS first_session_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180601' AND '20181002'
  GROUP BY user_pseudo_id
)
SELECT *
FROM first_session
LIMIT 20;
```

```sql
-- 5. Description:  Restrict to users whose FIRST session fell in the week that
--                  starts Monday 2018‑07‑02 (our “Week‑0” cohort)
WITH first_session AS (
  SELECT
    user_pseudo_id,
    MIN(DATE(event_date)) AS first_session_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180601' AND '20181002'
  GROUP BY user_pseudo_id
)
SELECT user_pseudo_id,
       first_session_date
FROM first_session
WHERE DATE_TRUNC(first_session_date, WEEK(MONDAY)) = DATE '2018-07-02'
LIMIT 20;
```

```sql
-- 6. Description:  Count how many brand‑new users are in Week‑0
WITH cohort AS (
  SELECT
    user_pseudo_id
  FROM (
    SELECT
      user_pseudo_id,
      MIN(DATE(event_date)) AS first_session_date
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE event_name = 'session_start'
      AND _TABLE_SUFFIX BETWEEN '20180601' AND '20181002'
    GROUP BY user_pseudo_id
  )
  WHERE DATE_TRUNC(first_session_date, WEEK(MONDAY)) = DATE '2018-07-02'
)
SELECT COUNT(DISTINCT user_pseudo_id) AS new_users_week0
FROM cohort;
```

```sql
-- 7. Description:  Pull every event generated by those cohort users up to
--                  (and including) 2018‑10‑02
WITH cohort AS (
  SELECT user_pseudo_id
  FROM (
    SELECT user_pseudo_id,
           MIN(DATE(event_date)) AS first_session_date
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE event_name = 'session_start'
      AND _TABLE_SUFFIX BETWEEN '20180601' AND '20181002'
    GROUP BY user_pseudo_id
  )
  WHERE DATE_TRUNC(first_session_date, WEEK(MONDAY)) = DATE '2018-07-02'
)
SELECT
  event_date,
  user_pseudo_id,
  event_name
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
  AND user_pseudo_id IN (SELECT user_pseudo_id FROM cohort)
LIMIT 20;
```

```sql
-- 8. Description:  Assign every event into a “weeks_since_cohort” bucket
WITH cohort AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(MIN(DATE(event_date)), WEEK(MONDAY)) AS cohort_monday
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180601' AND '20181002'
  GROUP BY user_pseudo_id
  HAVING cohort_monday = DATE '2018-07-02'
),
events AS (
  SELECT
    e.user_pseudo_id,
    DATE_TRUNC(DATE(e.event_date), WEEK(MONDAY)) AS event_monday
  FROM `firebase-public-project.analytics_153293282.events_*` AS e
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND e.user_pseudo_id IN (SELECT user_pseudo_id FROM cohort)
)
SELECT
  user_pseudo_id,
  event_monday,
  (DATE_DIFF(event_monday, DATE '2018-07-02', DAY) / 7) AS weeks_since_cohort
FROM events
LIMIT 20;
```

```sql
-- 9. Description:  Retained users grouped by week‑number (un‑distinct to show duplicates)
WITH cohort AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(MIN(DATE(event_date)), WEEK(MONDAY)) AS cohort_monday
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180601' AND '20181002'
  GROUP BY user_pseudo_id
  HAVING cohort_monday = DATE '2018-07-02'
),
retention AS (
  SELECT
    DISTINCT e.user_pseudo_id,
    (DATE_DIFF(DATE_TRUNC(DATE(e.event_date), WEEK(MONDAY)),
               DATE '2018-07-02', DAY) / 7) AS weeks_since_cohort
  FROM `firebase-public-project.analytics_153293282.events_*` AS e
  JOIN cohort c
    ON e.user_pseudo_id = c.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND DATE_DIFF(DATE_TRUNC(DATE(e.event_date), WEEK(MONDAY)),
                  DATE '2018-07-02', DAY) / 7 BETWEEN 0 AND 4
)
SELECT weeks_since_cohort AS week_number,
       COUNT(DISTINCT user_pseudo_id) AS retained_users
FROM retention
GROUP BY week_number
ORDER BY week_number
LIMIT 20;
```

```sql
-- 10. Description:  FINAL ANSWER – Week‑0 size and Week‑1…4 retention counts
WITH first_session AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(MIN(DATE(event_date)), WEEK(MONDAY)) AS cohort_monday
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180601' AND '20181002'
  GROUP BY user_pseudo_id
  HAVING cohort_monday = DATE '2018-07-02'
),
retention AS (
  SELECT
    DISTINCT fs.user_pseudo_id,
    (DATE_DIFF(DATE_TRUNC(DATE(e.event_date), WEEK(MONDAY)),
               fs.cohort_monday, DAY) / 7) AS weeks_since_cohort
  FROM first_session fs
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = fs.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND DATE_DIFF(DATE_TRUNC(DATE(e.event_date), WEEK(MONDAY)),
                  fs.cohort_monday, DAY) / 7 BETWEEN 0 AND 4
)
SELECT
  0 AS week_number,
  COUNT(DISTINCT user_pseudo_id) AS users
FROM first_session
UNION ALL
SELECT
  weeks_since_cohort AS week_number,
  COUNT(DISTINCT user_pseudo_id) AS users
FROM retention
WHERE weeks_since_cohort BETWEEN 1 AND 4
GROUP BY weeks_since_cohort
ORDER BY week_number;
```

The tenth query outputs exactly what was asked:

Week 0 = total new users (cohort size)  
Week 1‑4 = number of those same users that generated at least one event in each subsequent Monday‑based week, using data only up through 2018‑10‑02.
