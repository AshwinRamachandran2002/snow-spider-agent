```sql
--Description: Calculate the tax‑rate (tax / revenue) for every purchase event.
SELECT
  `ecommerce`.transaction_id,
  SAFE_DIVIDE(`ecommerce`.tax_value_in_usd,
              `ecommerce`.purchase_revenue_in_usd) AS tax_rate
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`
WHERE `event_name` = 'purchase'
  AND `ecommerce`.purchase_revenue_in_usd     IS NOT NULL
  AND `ecommerce`.tax_value_in_usd            IS NOT NULL
LIMIT 20;
```

```sql
--Description: Aggregate by item_category, find the average/overall tax‑rate, order high→low.
WITH purchase_items AS (
  SELECT
    i.item_category                                    AS item_category,
    `ecommerce`.purchase_revenue_in_usd                AS rev_usd,
    `ecommerce`.tax_value_in_usd                       AS tax_usd
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`,
       UNNEST(`items`) AS i
  WHERE `event_name` = 'purchase'
    AND `ecommerce`.purchase_revenue_in_usd IS NOT NULL
    AND `ecommerce`.tax_value_in_usd        IS NOT NULL
)
SELECT
  item_category,
  SUM(tax_usd)                       AS total_tax_usd,
  SUM(rev_usd)                       AS total_rev_usd,
  SAFE_DIVIDE(SUM(tax_usd), SUM(rev_usd)) AS tax_rate
FROM purchase_items
GROUP BY item_category
ORDER BY tax_rate DESC
LIMIT 20;
```

```sql
--Description: Grab transaction‑level details for purchases whose item_category
--             equals the highest‑tax‑rate category discovered above.
WITH ranked_cat AS (
  /* calculate tax‑rate per category and pick the top one */
  WITH purchase_items AS (
    SELECT
      i.item_category                         AS item_category,
      `ecommerce`.purchase_revenue_in_usd     AS rev_usd,
      `ecommerce`.tax_value_in_usd            AS tax_usd
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`,
         UNNEST(`items`) AS i
    WHERE `event_name` = 'purchase'
      AND `ecommerce`.purchase_revenue_in_usd IS NOT NULL
      AND `ecommerce`.tax_value_in_usd        IS NOT NULL
  )
  SELECT item_category
  FROM (
    SELECT
      item_category,
      SAFE_DIVIDE(SUM(tax_usd), SUM(rev_usd)) AS tax_rate,
      ROW_NUMBER() OVER (ORDER BY SAFE_DIVIDE(SUM(tax_usd), SUM(rev_usd)) DESC) AS rn
    FROM purchase_items
    GROUP BY item_category
  )
  WHERE rn = 1
)
SELECT
  e.transaction_id,
  e.total_item_quantity,
  e.purchase_revenue_in_usd,
  e.purchase_revenue
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`   AS ev
CROSS JOIN UNNEST(ev.items)                                                   AS i
JOIN ranked_cat                                                               AS rc
  ON i.item_category = rc.item_category
LEFT JOIN UNNEST([ev.ecommerce])                                              AS e         -- make struct alias easier
WHERE ev.event_name = 'purchase'
LIMIT 20;
```
