```sql
--Description: Count patent filings per CPC code and year (only when application_number is non‑empty)
SELECT  CAST(p."filing_date"/10000 AS INT)           AS "year",
        f.value::VARIANT:"code"::STRING              AS "cpc_code",
        COUNT(*)                                     AS "patent_filings"
FROM PATENTS.PATENTS.PUBLICATIONS  p,
     LATERAL FLATTEN(input => p."cpc") f
WHERE p."filing_date" IS NOT NULL
  AND p."application_number" <> ''
GROUP BY "year", "cpc_code"
LIMIT 20;
```

```sql
--Description: Preview moving‑average style values (here a simple 10‑year window average as a stub) per CPC code and year
SELECT  "year",
        "cpc_code",
        "patent_filings",
        AVG("patent_filings") OVER (PARTITION BY "cpc_code"
                                    ORDER BY "year"
                                    ROWS BETWEEN 9 PRECEDING AND CURRENT ROW) AS "ma_stub"
FROM (
    SELECT  CAST(p."filing_date"/10000 AS INT)          AS "year",
            f.value::VARIANT:"code"::STRING             AS "cpc_code",
            COUNT(*)                                    AS "patent_filings"
    FROM PATENTS.PATENTS.PUBLICATIONS  p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."filing_date" IS NOT NULL
      AND p."application_number" <> ''
    GROUP BY "year", "cpc_code"
) t
LIMIT 20;
```

```sql
--Description: Illustrative calculation of an exponential moving average with smoothing factor 0.2 (EMA_0_2) by CPC and year
SELECT *
FROM (
    SELECT  "cpc_code",
            "year",
            "patent_filings",
            /* Weighted EMA using 0.2 smoothing */
            SUM("patent_filings"
                * POWER(1-0.2, ROW_NUMBER() OVER (PARTITION BY "cpc_code" ORDER BY "year" DESC) - 1))
            OVER (PARTITION BY "cpc_code" ORDER BY "year")
              /
            SUM(POWER(1-0.2, ROW_NUMBER() OVER (PARTITION BY "cpc_code" ORDER BY "year" DESC) - 1))
            OVER (PARTITION BY "cpc_code" ORDER BY "year")                  AS "ema_0_2"
    FROM (
        SELECT  f.value::VARIANT:"code"::STRING            AS "cpc_code",
                CAST(p."filing_date"/10000 AS INT)        AS "year",
                COUNT(*)                                  AS "patent_filings"
        FROM PATENTS.PATENTS.PUBLICATIONS  p,
             LATERAL FLATTEN(input => p."cpc") f
        WHERE p."filing_date" IS NOT NULL
          AND p."application_number" <> ''
        GROUP BY "cpc_code", "year"
    ) s
) final
LIMIT 20;
```
