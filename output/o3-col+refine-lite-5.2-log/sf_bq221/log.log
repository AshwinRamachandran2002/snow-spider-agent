```sql
--Description: Illustrative exponential moving average (EMA, α = 0.2) of patent filings by first‑CPC code and year
WITH filings AS (
    SELECT  
           f_first.value:"code"::STRING                                AS "cpc_code",
           CAST(p."filing_date"/10000 AS INT)                          AS "year",
           COUNT(*)                                                    AS "patent_filings"
    FROM PATENTS.PATENTS.PUBLICATIONS  p
         , LATERAL (
             SELECT value
             FROM TABLE(FLATTEN(input => p."cpc"))
             ORDER BY index
             LIMIT 1
           ) f_first
    WHERE p."filing_date" IS NOT NULL
      AND COALESCE(p."application_number", '') <> ''
    GROUP BY "cpc_code", "year"
)
SELECT  
       "cpc_code",
       "year",
       "patent_filings",
       /* Exponential Moving Average with α = 0.2 */
       SUM("patent_filings" * POWER(1-0.2, seq-1)) 
         OVER (PARTITION BY "cpc_code" ORDER BY "year")
       /
       SUM(POWER(1-0.2, seq-1))
         OVER (PARTITION BY "cpc_code" ORDER BY "year")              AS "ema_0_2"
FROM (
    SELECT  
           f.*,
           ROW_NUMBER() OVER (PARTITION BY f."cpc_code" ORDER BY f."year" DESC) AS seq
    FROM filings f
) ordered
LIMIT 20;
```
