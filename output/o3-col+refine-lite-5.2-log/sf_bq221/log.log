Successfully corrected. SQL:
--Description: Compute an Exponential Moving Average (α = 0.2) of annual patent‑filing counts
--             for each FIRST‑listed CPC code.  Steps:
--               1. pub_first_cpc  – For every publication, FLATTEN the "cpc" array and keep only the
--                  first element (smallest index) via ROW_NUMBER()+QUALIFY.  We retain filing year.
--               2. filings_by_year – Aggregate to counts of publications per (year, cpc_code).
--               3. ordered – Assign a descending‑year row number (rn) inside each CPC group so the
--                  most‑recent year gets rn = 1 (weight 1), the prior year rn = 2 (weight 0.8), etc.
--               4. Final SELECT – For each row, calculate the EMA with α = 0.2 using windowed
--                  weighted sums ( POWER(0.8, rn‑1) ).  LIMIT 20 shows a sample.
WITH pub_first_cpc AS (
    SELECT
           p."publication_number",
           CAST(p."filing_date" / 10000 AS INT)        AS "year",
           f.value:"code"::STRING                      AS "cpc_code"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."filing_date" IS NOT NULL
      AND COALESCE(p."application_number", '') <> ''
    QUALIFY ROW_NUMBER() OVER (PARTITION BY p."publication_number" ORDER BY f.index) = 1
),
filings_by_year AS (
    SELECT
           "cpc_code",
           "year",
           COUNT(*)                                   AS "patent_filings"
    FROM pub_first_cpc
    GROUP BY "cpc_code", "year"
),
ordered AS (
    SELECT
           "cpc_code",
           "year",
           "patent_filings",
           ROW_NUMBER() OVER (PARTITION BY "cpc_code" ORDER BY "year" DESC) AS rn
    FROM filings_by_year
)
SELECT
       "cpc_code",
       "year",
       "patent_filings",
       /* Exponential Moving Average, α = 0.2  (weight = 0.8^(rn-1)) */
       SUM("patent_filings" * POWER(0.8, rn - 1))
         OVER (PARTITION BY "cpc_code" ORDER BY "year" DESC
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
       /
       SUM(POWER(0.8, rn - 1))
         OVER (PARTITION BY "cpc_code" ORDER BY "year" DESC
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)      AS "ema_0_2"
FROM ordered
LIMIT 20;
