Query:
--Description: 8. Show both averages side‑by‑side and the difference (feeling‑lucky minus momentum).  
SELECT
  AVG(IF(LOWER(`TargetCompID`) LIKE '%luck%', `LastPx`-`StrikePrice`, NULL)) AS avg_intrinsic_value_feeling_lucky,
  AVG(IF(LOWER(`TargetCompID`) LIKE '%momo%', `LastPx`-`StrikePrice`, NULL)) AS avg_intrinsic_value_momentum,
  AVG(IF(LOWER(`TargetCompID`) LIKE '%luck%', `LastPx`-`StrikePrice`, NULL))
    - AVG(IF(LOWER(`TargetCompID`) LIKE '%momo%', `LastPx`-`StrikePrice`, NULL)) AS difference
FROM  `bigquery-public-data.cymbal_investments.trade_capture_report`
WHERE EXISTS (SELECT 1 FROM UNNEST(`Sides`) s WHERE s.Side='LONG')
LIMIT 20;
Answer:
avg_intrinsic_value_feeling_lucky,avg_intrinsic_value_momentum,difference
-0.0064617460303709184,0.01660770374277693,-0.02306944977314785
Query:
--Description: 9. Grouped presentation: one row per strategy with its average intrinsic value (LONG side only).  
SELECT CASE
         WHEN LOWER(`TargetCompID`) LIKE '%luck%' THEN 'feeling-lucky'
         WHEN LOWER(`TargetCompID`) LIKE '%momo%' THEN 'momentum'
       END                           AS strategy,
       AVG(`LastPx`-`StrikePrice`)   AS avg_intrinsic_value
FROM   `bigquery-public-data.cymbal_investments.trade_capture_report`
WHERE  EXISTS (SELECT 1 FROM UNNEST(`Sides`) s WHERE s.Side='LONG')
  AND  (LOWER(`TargetCompID`) LIKE '%luck%' OR LOWER(`TargetCompID`) LIKE '%momo%')
GROUP BY strategy
LIMIT 20;
Answer:
strategy,avg_intrinsic_value
momentum,0.016607703742776935
feeling-lucky,-0.006461746030370917
Query:
--Description: 10. Final single‑number answer: how much higher the average intrinsic value is for feeling‑lucky over momentum (LONG side).  
SELECT
  (SELECT AVG(`LastPx`-`StrikePrice`)
   FROM   `bigquery-public-data.cymbal_investments.trade_capture_report`
   WHERE  EXISTS (SELECT 1 FROM UNNEST(`Sides`) s WHERE s.Side='LONG')
     AND  LOWER(`TargetCompID`) LIKE '%luck%')
  -
  (SELECT AVG(`LastPx`-`StrikePrice`)
   FROM   `bigquery-public-data.cymbal_investments.trade_capture_report`
   WHERE  EXISTS (SELECT 1 FROM UNNEST(`Sides`) s WHERE s.Side='LONG')
     AND  LOWER(`TargetCompID`) LIKE '%momo%')
  AS avg_intrinsic_value_difference
LIMIT 20;
Answer:
avg_intrinsic_value_difference
-0.02306944977314785
