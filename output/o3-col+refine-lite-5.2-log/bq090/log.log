```sql
--Description: 2. Zoom‑in on any TargetCompID that looks like the momentum strategy (token “momo”).  
SELECT DISTINCT `TargetCompID`
FROM   `bigquery-public-data.cymbal_investments.trade_capture_report`
WHERE  LOWER(`TargetCompID`) LIKE '%momo%'
LIMIT 20;
```

```sql
--Description: 3. Zoom‑in on any TargetCompID that looks like the feeling‑lucky strategy (token “luck”).  
SELECT DISTINCT `TargetCompID`
FROM   `bigquery-public-data.cymbal_investments.trade_capture_report`
WHERE  LOWER(`TargetCompID`) LIKE '%luck%'
LIMIT 20;
```

```sql
--Description: 4. Inspect a few LONG‑side trades that belong to the feeling‑lucky strategy and calculate their intrinsic value (LastPx‑StrikePrice).  
SELECT  `SendingTime`,
        `TargetCompID`,
        `SenderCompID`,
        `Symbol`,
        `Quantity`,
        `StrikePrice`,
        `LastPx`,
        (`LastPx`-`StrikePrice`) AS intrinsic_value
FROM    `bigquery-public-data.cymbal_investments.trade_capture_report`
WHERE   LOWER(`TargetCompID`) LIKE '%luck%'
  AND   EXISTS (SELECT 1 FROM UNNEST(`Sides`) s WHERE s.Side='LONG')
LIMIT 20;
```

```sql
--Description: 5. Inspect a few LONG‑side trades that belong to the momentum strategy and calculate their intrinsic value.  
SELECT  `SendingTime`,
        `TargetCompID`,
        `SenderCompID`,
        `Symbol`,
        `Quantity`,
        `StrikePrice`,
        `LastPx`,
        (`LastPx`-`StrikePrice`) AS intrinsic_value
FROM    `bigquery-public-data.cymbal_investments.trade_capture_report`
WHERE   LOWER(`TargetCompID`) LIKE '%momo%'
  AND   EXISTS (SELECT 1 FROM UNNEST(`Sides`) s WHERE s.Side='LONG')
LIMIT 20;
```

```sql
--Description: 6. Compute the average intrinsic value for LONG‑side momentum trades.  
SELECT  AVG(`LastPx`-`StrikePrice`) AS avg_intrinsic_value_momentum
FROM    `bigquery-public-data.cymbal_investments.trade_capture_report`
WHERE   LOWER(`TargetCompID`) LIKE '%momo%'
  AND   EXISTS (SELECT 1 FROM UNNEST(`Sides`) s WHERE s.Side='LONG')
LIMIT 20;
```

```sql
--Description: 7. Compute the average intrinsic value for LONG‑side feeling‑lucky trades.  
SELECT  AVG(`LastPx`-`StrikePrice`) AS avg_intrinsic_value_feeling_lucky
FROM    `bigquery-public-data.cymbal_investments.trade_capture_report`
WHERE   LOWER(`TargetCompID`) LIKE '%luck%'
  AND   EXISTS (SELECT 1 FROM UNNEST(`Sides`) s WHERE s.Side='LONG')
LIMIT 20;
```

```sql
--Description: 8. Show both averages side‑by‑side and the difference (feeling‑lucky minus momentum).  
SELECT
  AVG(IF(LOWER(`TargetCompID`) LIKE '%luck%', `LastPx`-`StrikePrice`, NULL)) AS avg_intrinsic_value_feeling_lucky,
  AVG(IF(LOWER(`TargetCompID`) LIKE '%momo%', `LastPx`-`StrikePrice`, NULL)) AS avg_intrinsic_value_momentum,
  AVG(IF(LOWER(`TargetCompID`) LIKE '%luck%', `LastPx`-`StrikePrice`, NULL))
    - AVG(IF(LOWER(`TargetCompID`) LIKE '%momo%', `LastPx`-`StrikePrice`, NULL)) AS difference
FROM  `bigquery-public-data.cymbal_investments.trade_capture_report`
WHERE EXISTS (SELECT 1 FROM UNNEST(`Sides`) s WHERE s.Side='LONG')
LIMIT 20;
```

```sql
--Description: 9. Grouped presentation: one row per strategy with its average intrinsic value (LONG side only).  
SELECT CASE
         WHEN LOWER(`TargetCompID`) LIKE '%luck%' THEN 'feeling-lucky'
         WHEN LOWER(`TargetCompID`) LIKE '%momo%' THEN 'momentum'
       END                           AS strategy,
       AVG(`LastPx`-`StrikePrice`)   AS avg_intrinsic_value
FROM   `bigquery-public-data.cymbal_investments.trade_capture_report`
WHERE  EXISTS (SELECT 1 FROM UNNEST(`Sides`) s WHERE s.Side='LONG')
  AND  (LOWER(`TargetCompID`) LIKE '%luck%' OR LOWER(`TargetCompID`) LIKE '%momo%')
GROUP BY strategy
LIMIT 20;
```

```sql
--Description: 10. Final single‑number answer: how much higher the average intrinsic value is for feeling‑lucky over momentum (LONG side).  
SELECT
  (SELECT AVG(`LastPx`-`StrikePrice`)
   FROM   `bigquery-public-data.cymbal_investments.trade_capture_report`
   WHERE  EXISTS (SELECT 1 FROM UNNEST(`Sides`) s WHERE s.Side='LONG')
     AND  LOWER(`TargetCompID`) LIKE '%luck%')
  -
  (SELECT AVG(`LastPx`-`StrikePrice`)
   FROM   `bigquery-public-data.cymbal_investments.trade_capture_report`
   WHERE  EXISTS (SELECT 1 FROM UNNEST(`Sides`) s WHERE s.Side='LONG')
     AND  LOWER(`TargetCompID`) LIKE '%momo%')
  AS avg_intrinsic_value_difference
LIMIT 20;
```
