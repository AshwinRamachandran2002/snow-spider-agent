```sql
--Description: Report the average month‑end balances for the months with the MOST
--             and FEWEST positive‑balance customers, plus the difference between them
WITH month_balances AS (                       -- net balance per customer & month
    SELECT  customer_id,
            substr(txn_date,1,7) AS month_yyyy_mm,
            SUM(CASE
                    WHEN txn_type = 'deposit'    THEN  txn_amount
                    WHEN txn_type = 'withdrawal' THEN -txn_amount
                    ELSE 0
                END) AS balance
    FROM    customer_transactions
    WHERE   txn_date LIKE '2020-%'
    GROUP   BY customer_id, month_yyyy_mm
),
positive_counts AS (                           -- # customers >0 by month
    SELECT  month_yyyy_mm,
            COUNT(*) AS positive_customer_cnt
    FROM    month_balances
    WHERE   balance > 0
    GROUP   BY month_yyyy_mm
),
max_min AS (                                   -- identify target months
    SELECT  (SELECT month_yyyy_mm
             FROM   positive_counts
             ORDER  BY positive_customer_cnt DESC, month_yyyy_mm
             LIMIT 1) AS max_month,
            (SELECT month_yyyy_mm
             FROM   positive_counts
             ORDER  BY positive_customer_cnt ASC, month_yyyy_mm
             LIMIT 1) AS min_month
),
averages AS (                                  -- average balance for each target month
    SELECT  (SELECT AVG(balance)
             FROM   month_balances
             WHERE  month_yyyy_mm = (SELECT max_month FROM max_min)) AS avg_max,
            (SELECT AVG(balance)
             FROM   month_balances
             WHERE  month_yyyy_mm = (SELECT min_month FROM max_min)) AS avg_min
)
SELECT  (SELECT max_month FROM max_min) AS month_most_positive,
        (SELECT min_month FROM max_min) AS month_least_positive,
        avg_max,
        avg_min,
        avg_max - avg_min AS difference_between_avgs
FROM    averages
LIMIT 20;
