```sql
--Description: End‑to‑end solution in one query.  
-- 1) Build net balance (deposit ‑ withdrawal) for each customer per 2020 month.  
-- 2) Count, per month, how many customers ended with a positive balance.  
-- 3) Identify the month with the MOST such customers (max_month) and the month with the LEAST (min_month).  
-- 4) Compute the average month‑end balance across all customers for each of those two months.  
-- 5) Return the months, their averages and the difference.
WITH month_balances AS (          -- step‑1
    SELECT customer_id,
           substr(txn_date,1,7) AS month_yyyy_mm,         -- e.g. 2020-04
           SUM(CASE
                   WHEN txn_type='deposit'    THEN  txn_amount
                   WHEN txn_type='withdrawal' THEN -txn_amount
                   ELSE 0
               END) AS balance
    FROM   customer_transactions
    WHERE  txn_date LIKE '2020-%'
    GROUP  BY customer_id, month_yyyy_mm
),
positive_counts AS (             -- step‑2
    SELECT month_yyyy_mm,
           COUNT(*) AS positive_customer_cnt
    FROM   month_balances
    WHERE  balance > 0
    GROUP  BY month_yyyy_mm
),
max_min AS (                      -- step‑3
    SELECT (SELECT month_yyyy_mm
            FROM   positive_counts
            ORDER  BY positive_customer_cnt DESC, month_yyyy_mm
            LIMIT 1) AS max_month,
           (SELECT month_yyyy_mm
            FROM   positive_counts
            ORDER  BY positive_customer_cnt ASC, month_yyyy_mm
            LIMIT 1) AS min_month
),
avg_vals AS (                     -- step‑4
    SELECT (SELECT AVG(balance)
            FROM   month_balances
            WHERE  month_yyyy_mm = (SELECT max_month FROM max_min)) AS avg_max,
           (SELECT AVG(balance)
            FROM   month_balances
            WHERE  month_yyyy_mm = (SELECT min_month FROM max_min)) AS avg_min
)
-- step‑5
SELECT (SELECT max_month FROM max_min) AS month_with_most_positive_customers,
       (SELECT min_month FROM max_min) AS month_with_least_positive_customers,
       avg_max  AS average_balance_most_positive,
       avg_min  AS average_balance_least_positive,
       avg_max - avg_min AS difference_between_averages
FROM   avg_vals;
```
