```sql
--Description: Report the difference between the two average balances
WITH
max_month AS (
    SELECT "month_yyyy_mm"
    FROM (
            SELECT "month_yyyy_mm",
                   COUNT(*) AS "positive_customer_cnt"
            FROM (
                    SELECT "customer_id",
                           substr("txn_date",1,7) AS "month_yyyy_mm",
                           SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                                    WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                               END) AS "balance"
                    FROM  "customer_transactions"
                    WHERE "txn_date" LIKE '2020-%'
                    GROUP BY "customer_id","month_yyyy_mm"
                 )
            WHERE "balance" > 0
            GROUP BY "month_yyyy_mm"
            ORDER BY "positive_customer_cnt" DESC
            LIMIT 1
     )
),
min_month AS (
    SELECT "month_yyyy_mm"
    FROM (
            SELECT "month_yyyy_mm",
                   COUNT(*) AS "positive_customer_cnt"
            FROM (
                    SELECT "customer_id",
                           substr("txn_date",1,7) AS "month_yyyy_mm",
                           SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                                    WHEN "txn_type"='withdrawal' THEN - "txn_amount"
                               END) AS "balance"
                    FROM  "customer_transactions"
                    WHERE "txn_date" LIKE '2020-%'
                    GROUP BY "customer_id","month_yyyy_mm"
                 )
            WHERE "balance" > 0
            GROUP BY "month_yyyy_mm"
            ORDER BY "positive_customer_cnt" ASC
            LIMIT 1
     )
),
balances AS (
    SELECT "customer_id",
           substr("txn_date",1,7) AS "month_yyyy_mm",
           SUM(CASE WHEN "txn_type"='deposit'    THEN  "txn_amount"
                    WHEN "txn_type"='withdrawal' THEN - "txn_amount"
               END) AS "balance"
    FROM  "customer_transactions"
    WHERE "txn_date" LIKE '2020-%'
    GROUP BY "customer_id","month_yyyy_mm"
),
avg_vals AS (
    SELECT (SELECT AVG("balance") FROM balances WHERE "month_yyyy_mm" = (SELECT "month_yyyy_mm" FROM max_month)) AS "avg_max",
           (SELECT AVG("balance") FROM balances WHERE "month_yyyy_mm" = (SELECT "month_yyyy_mm" FROM min_month)) AS "avg_min"
)
SELECT DISTINCT
       "avg_max",
       "avg_min",
       ("avg_max" - "avg_min") AS "difference_between_avgs"
FROM   avg_vals
LIMIT 20;
```
