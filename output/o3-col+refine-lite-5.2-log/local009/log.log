```sql
-- Description / thinking process:
-- • Need the single longest flight (in km) where Abakan (airport code “ABA”) is either origin or destination.
-- • abakan  : locate Abakan’s airport_code by JSON search.
-- • coords  : convert every airport’s "(lon,lat)" POINT text into numeric lon / lat.
-- • routes  : bring both endpoints’ coordinates for flights whose departure OR arrival airport is Abakan.
-- • distances: apply the Haversine formula without ACOS(), using SIN, COS, SQRT, ATAN2.
-- • Final    : return the maximum distance (rounded to 1 dec km).
WITH abakan AS (
    SELECT airport_code
    FROM airports_data
    WHERE LOWER(json_extract(airport_name, '$.en')) LIKE '%abakan%'
       OR LOWER(json_extract(city,        '$.en')) LIKE '%abakan%'
),
coords AS (
    SELECT airport_code,
           CAST(SUBSTR(coordinates, 2,
                       INSTR(coordinates, ',') - 2) AS REAL) AS lon,
           CAST(SUBSTR(coordinates,
                       INSTR(coordinates, ',') + 1,
                       INSTR(coordinates, ')') - INSTR(coordinates, ',') - 1) AS REAL) AS lat
    FROM airports_data
),
routes AS (
    SELECT f.flight_id,
           dp.lon AS lon1, dp.lat AS lat1,
           ar.lon AS lon2, ar.lat AS lat2
    FROM flights AS f
    JOIN coords AS dp ON dp.airport_code = f.departure_airport
    JOIN coords AS ar ON ar.airport_code = f.arrival_airport
    WHERE f.departure_airport IN (SELECT airport_code FROM abakan)
       OR f.arrival_airport   IN (SELECT airport_code FROM abakan)
),
distances AS (
    SELECT flight_id,
           2 * 6371 * ATAN2(
               SQRT(
                   POWER(SIN((lat2 - lat1) * 0.00872664625997165), 2) +
                   COS(lat1 * 0.0174532925199433) *
                   COS(lat2 * 0.0174532925199433) *
                   POWER(SIN((lon2 - lon1) * 0.00872664625997165), 2)
               ),
               SQRT(
                   1 -
                   (
                     POWER(SIN((lat2 - lat1) * 0.00872664625997165), 2) +
                     COS(lat1 * 0.0174532925199433) *
                     COS(lat2 * 0.0174532925199433) *
                     POWER(SIN((lon2 - lon1) * 0.00872664625997165), 2)
                   )
               )
           ) AS distance_km
    FROM routes
)
SELECT ROUND(MAX(distance_km), 1) AS longest_route_km
FROM distances;
