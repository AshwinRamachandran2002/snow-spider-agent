Query:
--Description: bring the coordinates of both departure and arrival airports for every flight that involves Abakan
WITH abakan AS (
    SELECT airport_code
    FROM airports_data
    WHERE LOWER(json_extract(airport_name, '$.en')) LIKE '%abakan%'
       OR LOWER(json_extract(city,        '$.en')) LIKE '%abakan%'
),
coords AS (
    SELECT airport_code,
           CAST(SUBSTR(coordinates, 2,
                       INSTR(coordinates, ',') - 2) AS REAL) AS lon,
           CAST(SUBSTR(
                     coordinates,
                     INSTR(coordinates, ',') + 1,
                     INSTR(coordinates, ')') - INSTR(coordinates, ',') - 1
                ) AS REAL) AS lat
    FROM airports_data
)
SELECT f.flight_id,
       dp.airport_code AS dep_code,
       dp.lon          AS dep_lon,
       dp.lat          AS dep_lat,
       ar.airport_code AS arr_code,
       ar.lon          AS arr_lon,
       ar.lat          AS arr_lat
FROM flights AS f
JOIN coords AS dp ON dp.airport_code = f.departure_airport
JOIN coords AS ar ON ar.airport_code = f.arrival_airport
WHERE f.departure_airport IN (SELECT airport_code FROM abakan)
   OR f.arrival_airport   IN (SELECT airport_code FROM abakan)
LIMIT 20
