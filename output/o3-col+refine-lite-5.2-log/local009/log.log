```sql
-- Description: compute the great‑circle distance (in km) for every flight that involves Abakan
WITH abakan AS (
    SELECT airport_code
    FROM airports_data
    WHERE airport_name ->> 'en' ILIKE '%abakan%'
       OR city         ->> 'en' ILIKE '%abakan%'
),
routes AS (
    SELECT f.flight_id,
           f.departure_airport,
           f.arrival_airport
    FROM flights AS f
    WHERE f.departure_airport IN (SELECT airport_code FROM abakan)
       OR f.arrival_airport   IN (SELECT airport_code FROM abakan)
),
coords AS (
    SELECT r.*,
           dp.coordinates AS dep_pt,
           ar.coordinates AS arr_pt
    FROM routes AS r
    JOIN airports_data AS dp ON dp.airport_code = r.departure_airport
    JOIN airports_data AS ar ON ar.airport_code = r.arrival_airport
)
SELECT r.flight_id,
       ROUND( 6371 * ACOS(
                 SIN( RADIANS( r.dep_pt[1] ) ) * SIN( RADIANS( r.arr_pt[1] ) ) +
                 COS( RADIANS( r.dep_pt[1] ) ) * COS( RADIANS( r.arr_pt[1] ) ) *
                 COS( RADIANS( r.arr_pt[0] - r.dep_pt[0] ) )
             ) , 1) AS distance_km
FROM coords AS r
LIMIT 20;
```

```sql
-- Description: retrieve the single longest Abakan‑involving route (distance in km)
WITH abakan AS (
    SELECT airport_code
    FROM airports_data
    WHERE airport_name ->> 'en' ILIKE '%abakan%'
       OR city         ->> 'en' ILIKE '%abakan%'
),
routes AS (
    SELECT f.flight_id,
           f.departure_airport,
           f.arrival_airport
    FROM flights AS f
    WHERE f.departure_airport IN (SELECT airport_code FROM abakan)
       OR f.arrival_airport   IN (SELECT airport_code FROM abakan)
),
coords AS (
    SELECT r.*,
           dp.coordinates AS dep_pt,
           ar.coordinates AS arr_pt
    FROM routes AS r
    JOIN airports_data AS dp ON dp.airport_code = r.departure_airport
    JOIN airports_data AS ar ON ar.airport_code = r.arrival_airport
),
distances AS (
    SELECT r.flight_id,
           ROUND( 6371 * ACOS(
                     SIN( RADIANS( r.dep_pt[1] ) ) * SIN( RADIANS( r.arr_pt[1] ) ) +
                     COS( RADIANS( r.dep_pt[1] ) ) * COS( RADIANS( r.arr_pt[1] ) ) *
                     COS( RADIANS( r.arr_pt[0] - r.dep_pt[0] ) )
                 ) , 1) AS distance_km
    FROM coords AS r
)
SELECT MAX(distance_km) AS longest_route_km
FROM distances;
```

