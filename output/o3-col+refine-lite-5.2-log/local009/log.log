Query:
--Description: look at the geographic coordinates of the Abakan airport
SELECT airport_code,
       coordinates                               AS point_lon_lat,
       CAST(SUBSTR(coordinates, 2,
                   INSTR(coordinates, ',') - 2) AS REAL) AS longitude,
       CAST(SUBSTR(
                 coordinates,
                 INSTR(coordinates, ',') + 1,
                 INSTR(coordinates, ')') - INSTR(coordinates, ',') - 1
            ) AS REAL)                              AS latitude
FROM airports_data
WHERE LOWER(json_extract(airport_name, '$.en')) LIKE '%abakan%'
   OR LOWER(json_extract(city,        '$.en')) LIKE '%abakan%'
LIMIT 20
