```sql
-- 1. Look at all city‑insert dates that fall in June 2022
SELECT DISTINCT "insert_date"
FROM "cities"
WHERE "insert_date" LIKE '2022-06%'
ORDER BY "insert_date"
LIMIT 20;
```

```sql
-- 2. See which cities and countries have those June 2022 insert dates
SELECT "city_name",
       "country_code_2",
       "insert_date"
FROM   "cities"
WHERE  "insert_date" LIKE '2022-06%'
ORDER  BY "country_code_2",
          "insert_date"
LIMIT 20;
```

```sql
-- 3. Count how many days in June 2022 each country has at least one city inserted
SELECT "country_code_2",
       COUNT(DISTINCT "insert_date")      AS "days_with_insert"
FROM   "cities"
WHERE  "insert_date" LIKE '2022-06%'
GROUP  BY "country_code_2"
ORDER  BY "days_with_insert" DESC
LIMIT 20;
```

```sql
-- 4. For every record in June 2022, compute the gap (in days) to the previous insert for that country
SELECT "country_code_2",
       "insert_date",
       julianday("insert_date")
       - julianday( LAG("insert_date")
                    OVER (PARTITION BY "country_code_2"
                          ORDER BY      "insert_date") ) AS "diff_days"
FROM   "cities"
WHERE  "insert_date" LIKE '2022-06%'
ORDER  BY "country_code_2",
          "insert_date"
LIMIT 20;
```

```sql
-- 5. Mark the start of every new streak of consecutive days (diff_days <> 1 starts a new group)
SELECT "country_code_2",
       "insert_date",
       SUM( CASE WHEN "diff_days" IS NULL OR "diff_days" <> 1
                 THEN 1 ELSE 0 END )
       OVER (PARTITION BY "country_code_2"
             ORDER BY      "insert_date")                AS "streak_group"
FROM  (
        SELECT "country_code_2",
               "insert_date",
               julianday("insert_date")
               - julianday( LAG("insert_date")
                            OVER (PARTITION BY "country_code_2"
                                  ORDER BY      "insert_date") ) AS "diff_days"
        FROM   "cities"
        WHERE  "insert_date" LIKE '2022-06%'
      )
ORDER  BY "country_code_2",
          "insert_date"
LIMIT 20;
```

```sql
-- 6. Turn those groups into streak lengths
SELECT "country_code_2",
       "streak_group",
       COUNT(*) AS "streak_length"
FROM  (
        SELECT "country_code_2",
               "insert_date",
               SUM( CASE WHEN "diff_days" IS NULL OR "diff_days" <> 1
                         THEN 1 ELSE 0 END )
               OVER (PARTITION BY "country_code_2"
                     ORDER BY      "insert_date")        AS "streak_group"
        FROM  (
                SELECT "country_code_2",
                       "insert_date",
                       julianday("insert_date")
                       - julianday( LAG("insert_date")
                                    OVER (PARTITION BY "country_code_2"
                                          ORDER BY      "insert_date") ) AS "diff_days"
                FROM   "cities"
                WHERE  "insert_date" LIKE '2022-06%'
              )
      )
GROUP BY "country_code_2",
         "streak_group"
ORDER  BY "streak_length" DESC
LIMIT 20;
```

```sql
-- 7. Pick the longest streak each country achieved in June 2022
SELECT "country_code_2",
       MAX("streak_length") AS "max_streak"
FROM (
        SELECT "country_code_2",
               "streak_group",
               COUNT(*) AS "streak_length"
        FROM (
                SELECT "country_code_2",
                       "insert_date",
                       SUM( CASE WHEN "diff_days" IS NULL OR "diff_days" <> 1
                                 THEN 1 ELSE 0 END )
                       OVER (PARTITION BY "country_code_2"
                             ORDER BY      "insert_date") AS "streak_group"
                FROM (
                        SELECT "country_code_2",
                               "insert_date",
                               julianday("insert_date")
                               - julianday( LAG("insert_date")
                                            OVER (PARTITION BY "country_code_2"
                                                  ORDER BY      "insert_date") ) AS "diff_days"
                        FROM   "cities"
                        WHERE  "insert_date" LIKE '2022-06%'
                     )
             )
        GROUP BY "country_code_2",
                 "streak_group"
     )
GROUP BY "country_code_2"
ORDER  BY "max_streak" DESC
LIMIT 20;
```

```sql
-- 8. Determine what the overall longest streak length is
SELECT MAX("max_streak") AS "longest_streak_overall"
FROM (
        SELECT "country_code_2",
               MAX("streak_length") AS "max_streak"
        FROM (
                SELECT "country_code_2",
                       "streak_group",
                       COUNT(*) AS "streak_length"
                FROM (
                        SELECT "country_code_2",
                               "insert_date",
                               SUM( CASE WHEN "diff_days" IS NULL OR "diff_days" <> 1
                                         THEN 1 ELSE 0 END )
                               OVER (PARTITION BY "country_code_2"
                                     ORDER BY      "insert_date") AS "streak_group"
                        FROM (
                                SELECT "country_code_2",
                                       "insert_date",
                                       julianday("insert_date")
                                       - julianday( LAG("insert_date")
                                                    OVER (PARTITION BY "country_code_2"
                                                          ORDER BY      "insert_date") ) AS "diff_days"
                                FROM   "cities"
                                WHERE  "insert_date" LIKE '2022-06%'
                             )
                     )
                GROUP BY "country_code_2",
                         "streak_group"
             )
        GROUP BY "country_code_2"
     );
```

