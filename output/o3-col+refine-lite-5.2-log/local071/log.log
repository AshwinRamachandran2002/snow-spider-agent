-- 8. Determine what the overall longest streak length is
SELECT MAX("max_streak") AS "longest_streak_overall"
FROM (
        SELECT "country_code_2",
               MAX("streak_length") AS "max_streak"
        FROM (
                SELECT "country_code_2",
