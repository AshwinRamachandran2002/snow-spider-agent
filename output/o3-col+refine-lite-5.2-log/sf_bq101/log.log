```sql
--Description / Thinking process:
-- Return the 10 most frequently imported Java packages (non‑static) without using
-- regular‑expressions.
-- 1) Select only files whose path ends with “.java”.
-- 2) Split each file’s text into individual lines with SPLIT + LATERAL FLATTEN.
-- 3) Keep lines that start with “import ” but NOT “import static ” (string pattern tests).
-- 4) Clean those lines to a fully‑qualified class reference (FQCN):
--      • SPLIT_PART(line,';',1)  → discard anything after the first semicolon.
--      • SUBSTR(result,8)       → remove the leading “import ” (7 chars + space).
--      • TRIM()                 → strip remaining spaces.
-- 5) Derive the PACKAGE portion by cutting everything after the final dot.
--    If no dot exists, discard the row.
-- 6) Aggregate counts per package and return the Top‑10 by frequency.
WITH fqcn_lines AS (
    SELECT
        TRIM(
            SUBSTR(                                   -- remove leading 'import '
                SPLIT_PART(TRIM(f.value::STRING), ';', 1),
                8
            )
        ) AS fqcn
    FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS" c,
           LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) f
    WHERE  c."sample_path" ILIKE '%.java'              -- Step 1
      AND  TRIM(f.value::STRING) ILIKE 'import %'      -- Step 3
      AND  TRIM(f.value::STRING) NOT ILIKE 'import static %'
),
packages AS (
    SELECT
        CASE
            WHEN POSITION('.' IN fqcn) > 0
            THEN LEFT(fqcn, LENGTH(fqcn) - POSITION('.' IN REVERSE(fqcn)))
            ELSE NULL
        END AS package_name
    FROM fqcn_lines
)
SELECT
    package_name,
    COUNT(*) AS import_count
FROM packages
WHERE package_name IS NOT NULL AND package_name <> ''
GROUP BY package_name
ORDER BY import_count DESC
LIMIT 10;
```
