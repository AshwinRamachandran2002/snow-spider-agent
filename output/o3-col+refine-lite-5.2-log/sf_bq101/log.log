```sql
--Description / Thinking process:
-- Objective: list the 10 most frequently imported Java packages (non‑static imports only).
--  1) Restrict to files ending with “.java”.
--  2) Split each file’s content into individual lines (SPLIT + LATERAL FLATTEN).
--  3) Keep lines that BEGIN with “import ” (after optional whitespace) but EXCLUDE
--     those that begin with “import static ” (we only want regular imports).
--  4) Clean each retained line:
--       a) Remove the leading “import ” keyword.
--       b) Remove any trailing semicolon.
--       c) TRIM whitespace, leaving a fully‑qualified reference (e.g. java.util.List).
--  5) Convert that reference to just its PACKAGE portion by removing the text
--     after the final dot (→ java.util).
--  6) Group by package name, count occurrences, order by count, and return the top 10.

WITH imports AS (
    SELECT
        REGEXP_REPLACE(                                   -- Step 5: drop final ".ClassName"
            TRIM(
                REGEXP_REPLACE(                           -- Step 4b: remove trailing ';'
                    REGEXP_REPLACE(                       -- Step 4a: drop leading 'import '
                        TRIM(f.value::STRING),
                        '^\\s*import\\s+',
                        ''
                    ),
                    ';\\s*$',
                    ''
                )
            ),
            '\\.[^\\.]+$',
            ''
        ) AS package_name
    FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"  c,
           LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) f
    WHERE  c."sample_path" ILIKE '%.java'                         -- Step 1
      AND  REGEXP_LIKE(TRIM(f.value::STRING), '^\\s*import\\s+')  -- Step 3 (starts with import)
      AND  NOT REGEXP_LIKE(TRIM(f.value::STRING), '^\\s*import\\s+static\\b') -- exclude static
)
SELECT
    package_name,
    COUNT(*) AS import_count
FROM imports
WHERE package_name IS NOT NULL AND package_name <> ''
GROUP BY package_name
ORDER BY import_count DESC
LIMIT 10;
```
