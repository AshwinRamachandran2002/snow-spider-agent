```sql
--Description / Thinking process:
-- Goal: Return the 10 Java packages that appear most often in regular (non‑static) import
--       statements across all *.java files in SAMPLE_CONTENTS.
-- Steps implemented below:
--  1) For every Java file, SPLIT its "content" on new‑lines and FLATTEN the result so each row
--     represents a single source line.
--  2) Keep only those lines that begin with “import ” but NOT with “import static ”, because we
--     want ordinary package/class imports.
--  3) Clean each kept line by:
--        a) removing the leading keyword “import ”,
--        b) removing any trailing semicolon,
--        c) trimming whitespace.
--     The result is a fully‑qualified class reference such as “java.util.List”.
--  4) Convert that reference to just the PACKAGE portion by trimming off the text after the
--     final dot ( → “java.util” ).
--  5) GROUP BY the package name, COUNT occurrences, ORDER by that count descending,
--     and LIMIT to the top 10.

WITH imports AS (
    SELECT
        REGEXP_REPLACE(                               -- (3b) drop trailing ';'
            REGEXP_REPLACE(TRIM(f.value::STRING),     -- (3a) drop leading 'import '
                '^import\\s+', ''),
            ';\\s*$', ''
        ) AS full_import
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS c,
         LATERAL FLATTEN(input => SPLIT(c."content", '\n')) f
    WHERE c."sample_path" ILIKE '%.java'                              -- only Java files
      AND REGEXP_LIKE(TRIM(f.value::STRING), '^import\\s+')           -- lines that start with import
      AND NOT REGEXP_LIKE(TRIM(f.value::STRING), '^import\\s+static\\b')  -- exclude static imports
)
SELECT
    REGEXP_REPLACE(full_import, '\\.[^\\.]+$', '') AS package_name,   -- (4) keep package only
    COUNT(*) AS import_count                                          -- (5) frequency
FROM imports
GROUP BY package_name
ORDER BY import_count DESC
LIMIT 10;
```
