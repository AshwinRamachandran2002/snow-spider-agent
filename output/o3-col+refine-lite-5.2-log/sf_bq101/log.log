```sql
--Description / Thinking process:
-- Goal: return the 10 most frequently imported Java packages (excluding static imports)
--        using a simple, resilient approach.
-- Steps
--   1) Work only with rows whose path ends with “.java”.
--   2) Split each file’s content into individual lines via SPLIT + LATERAL FLATTEN.
--   3) Keep lines that start with “import ” (ILIKE 'import %') and exclude
--      those that start with “import static ”.
--   4) Clean each line without fragile regex:
--        • SPLIT_PART(line,';',1)  → drop anything after the first semicolon.
--        • SUBSTR(line,8)         → remove the first 7 characters (“import ”).
--        • TRIM()                 → clear residual white‑space.
--   5) Convert the fully‑qualified reference to a PACKAGE by chopping off the last “.token”.
--      The package is everything before the final dot; if no dot exists, discard.
--   6) Aggregate counts per package, order by frequency, and return TOP‑10.

WITH cleaned AS (
    SELECT
        CASE
            WHEN POSITION('.' IN fqcn) > 0
            THEN LEFT(fqcn, LENGTH(fqcn) - POSITION('.' IN REVERSE(fqcn)))
            ELSE NULL
        END AS package_name
    FROM (
        SELECT
            -- Step 4: clean line to fully‑qualified class name (fqcn)
            TRIM(
                 SUBSTR(                                    -- remove leading 'import '
                     SPLIT_PART(TRIM(f.value::STRING), ';', 1), 8)
            ) AS fqcn
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS" c,
               LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) f
        WHERE  c."sample_path" ILIKE '%.java'             -- Step 1
          AND  TRIM(f.value::STRING) ILIKE 'import %'     -- Step 3: begins with import
          AND  TRIM(f.value::STRING) NOT ILIKE 'import static %'
    )
)
SELECT
    package_name,
    COUNT(*) AS import_count
FROM cleaned
WHERE package_name IS NOT NULL AND package_name <> ''
GROUP BY package_name
ORDER BY import_count DESC
LIMIT 10;
