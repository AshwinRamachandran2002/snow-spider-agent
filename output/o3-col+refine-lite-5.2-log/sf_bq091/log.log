```sql
--Description / Thinking process:
-- Corrected query to return the single year with the highest A61‑category filing count
-- for the assignee that, overall, files the most A61 applications.
-- 1) CTE “top_assignee” identifies that assignee (highest total A61 filings).
-- 2) Sub‑query counts that assignee’s A61 filings per year and keeps the peak year.
-- 3) Outer SELECT returns the year; LIMIT 20 is harmless but keeps the required format.
WITH top_assignee AS (
    SELECT 
        ah.value:"name"::STRING AS assignee_name,
        COUNT(*)                AS application_count
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")                 c,
         LATERAL FLATTEN(input => p."assignee_harmonized") ah
    WHERE c.value:"code"::STRING ILIKE 'A61%'
    GROUP BY ah.value:"name"::STRING
    ORDER BY application_count DESC
    LIMIT 1
)
SELECT s."filing_year"
FROM (
    SELECT  
        FLOOR(p."filing_date" / 10000) AS "filing_year",
        COUNT(*)                       AS application_count
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")                 c,
         LATERAL FLATTEN(input => p."assignee_harmonized") ah,
         top_assignee ta
    WHERE c.value:"code"::STRING ILIKE 'A61%'
      AND ah.value:"name"::STRING = ta.assignee_name
    GROUP BY FLOOR(p."filing_date" / 10000)
    ORDER BY application_count DESC
    LIMIT 1
) s
LIMIT 20;
