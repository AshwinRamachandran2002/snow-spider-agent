```sql
--Description / Thinking process:
-- Goal: find the calendar year in which the assignee that files the MOST “A61”‑category
--       applications (medical technology) made its largest number of such filings.
-- Steps embedded in one query:
--   1) CTE “top_assignee” counts A61 filings per assignee and keeps only the highest‑count one.
--   2) Main query filters publications to:
--        • CPC codes starting with ‘A61’
--        • assignee_harmonized names equal to the single value from “top_assignee”
--      It then converts numeric filing_date (YYYYMMDD) to a year with FLOOR(filing_date/10000),
--      counts filings per year, orders by that count, and shows the 20 most active years
--      (the first row is the peak year we need).
WITH top_assignee AS (
    SELECT 
        ah.value:"name"::STRING AS assignee_name,
        COUNT(*)                AS application_count
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc")                 c,
         LATERAL FLATTEN(input => p."assignee_harmonized") ah
    WHERE c.value:"code"::STRING ILIKE 'A61%'       -- keep only medical‑tech CPCs
    GROUP BY ah.value:"name"::STRING
    ORDER BY application_count DESC
    LIMIT 1                                          -- the assignee with most A61 filings
)
SELECT
    FLOOR(p."filing_date"/10000) AS "filing_year",
    COUNT(*)                     AS "application_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc")                 c,
     LATERAL FLATTEN(input => p."assignee_harmonized") ah,
     top_assignee ta
WHERE c.value:"code"::STRING ILIKE 'A61%'             -- still in the A61 domain
  AND ah.value:"name"::STRING = ta.assignee_name      -- restrict to the single top assignee
GROUP BY FLOOR(p."filing_date"/10000)
ORDER BY "application_count" DESC
LIMIT 20;
```
