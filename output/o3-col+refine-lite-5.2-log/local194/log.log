-- Description: (Optional) Aggregate to compute each actor’s average of their top‑three film shares  
SELECT DISTINCT
       t3."actor_id",
       t3."actor_name",
       AVG(t3."revenue_per_actor") AS "avg_revenue_top3"
FROM   (
        SELECT  sub.*,
                ROW_NUMBER() OVER (
                    PARTITION BY sub."actor_id"
                    ORDER BY     sub."total_revenue" DESC
                ) AS "film_rank"
        FROM   (
                SELECT  a."actor_id",
                        a."first_name" || ' ' || a."last_name" AS "actor_name",
                        fr."film_id",
                        fr."title",
                        fr."total_revenue",
                        fr."total_revenue" * 1.0 / fr."actor_count" AS "revenue_per_actor"
                FROM    "actor"      AS a
                JOIN    "film_actor" AS fa  ON a."actor_id" = fa."actor_id"
                JOIN   (
                        SELECT  f."film_id",
                                f."title",
                                SUM(p."amount")                AS "total_revenue",
                                COUNT(DISTINCT fa2."actor_id") AS "actor_count"
                        FROM    "payment"    AS p
                        JOIN    "rental"     AS r  USING ("rental_id")
                        JOIN    "inventory"  AS i  USING ("inventory_id")
                        JOIN    "film"       AS f  USING ("film_id")
                        JOIN    "film_actor" AS fa2 USING ("film_id")
                        GROUP   BY f."film_id"
                       ) AS fr
                       ON fr."film_id" = fa."film_id"
               ) AS sub
       ) AS t3
WHERE  t3."film_rank" <= 3
GROUP  BY t3."actor_id"
LIMIT  20;
