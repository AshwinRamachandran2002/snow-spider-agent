```sql
-- Description: Inspect which films earned revenue and their gross amounts  
SELECT DISTINCT
       f."film_id",
       f."title",
       SUM(p."amount") AS "total_revenue"
FROM   "payment"  AS p
JOIN   "rental"   AS r USING ("rental_id")
JOIN   "inventory" AS i USING ("inventory_id")
JOIN   "film"      AS f USING ("film_id")
GROUP  BY f."film_id"
ORDER  BY "total_revenue" DESC
LIMIT  20;
```

```sql
-- Description: See how actors map to films (many‑to‑many)  
SELECT DISTINCT
       fa."actor_id",
       fa."film_id",
       f."title"
FROM   "film_actor" AS fa
JOIN   "film"       AS f  USING ("film_id")
LIMIT  20;
```

```sql
-- Description: Compute total revenue per film together with number of actors in each film  
SELECT DISTINCT
       fr."film_id",
       fr."title",
       fr."total_revenue",
       fr."actor_count"
FROM   (
        SELECT  f."film_id",
                f."title",
                SUM(p."amount")                       AS "total_revenue",
                COUNT(DISTINCT fa."actor_id")         AS "actor_count"
        FROM    "payment"    AS p
        JOIN    "rental"     AS r  USING ("rental_id")
        JOIN    "inventory"  AS i  USING ("inventory_id")
        JOIN    "film"       AS f  USING ("film_id")
        JOIN    "film_actor" AS fa USING ("film_id")
        GROUP   BY f."film_id"
       ) AS fr
ORDER  BY fr."total_revenue" DESC
LIMIT  20;
```

```sql
-- Description: Revenue per film that belongs to each individual actor  
SELECT DISTINCT
       a."actor_id",
       a."first_name" || ' ' || a."last_name"        AS "actor_name",
       fr."film_id",
       fr."title",
       fr."total_revenue",
       fr."total_revenue" * 1.0 / fr."actor_count"   AS "revenue_per_actor"
FROM   "actor"      AS a
JOIN   "film_actor" AS fa  ON a."actor_id" = fa."actor_id"
JOIN   (
        SELECT  f."film_id",
                f."title",
                SUM(p."amount")               AS "total_revenue",
                COUNT(DISTINCT fa2."actor_id") AS "actor_count"
        FROM    "payment"    AS p
        JOIN    "rental"     AS r  USING ("rental_id")
        JOIN    "inventory"  AS i  USING ("inventory_id")
        JOIN    "film"       AS f  USING ("film_id")
        JOIN    "film_actor" AS fa2 USING ("film_id")
        GROUP   BY f."film_id"
       ) AS fr
       ON fr."film_id" = fa."film_id"
LIMIT  20;
```

```sql
-- Description: Rank films for every actor by total revenue (window function)  
SELECT DISTINCT
       sub."actor_id",
       sub."actor_name",
       sub."film_id",
       sub."title",
       sub."revenue_per_actor",
       ROW_NUMBER() OVER (
           PARTITION BY sub."actor_id"
           ORDER BY     sub."total_revenue" DESC
       ) AS "film_rank"
FROM   (
        SELECT  a."actor_id",
                a."first_name" || ' ' || a."last_name" AS "actor_name",
                fr."film_id",
                fr."title",
                fr."total_revenue",
                fr."total_revenue" * 1.0 / fr."actor_count" AS "revenue_per_actor"
        FROM    "actor"      AS a
        JOIN    "film_actor" AS fa  ON a."actor_id" = fa."actor_id"
        JOIN   (
                SELECT  f."film_id",
                        f."title",
                        SUM(p."amount")                 AS "total_revenue",
                        COUNT(DISTINCT fa2."actor_id")  AS "actor_count"
                FROM    "payment"    AS p
                JOIN    "rental"     AS r  USING ("rental_id")
                JOIN    "inventory"  AS i  USING ("inventory_id")
                JOIN    "film"       AS f  USING ("film_id")
                JOIN    "film_actor" AS fa2 USING ("film_id")
                GROUP   BY f."film_id"
               ) AS fr
               ON fr."film_id" = fa."film_id"
       ) AS sub
LIMIT  20;
```

```sql
-- Description: Keep only the top‑3 revenue‐generating films for every actor  
SELECT DISTINCT
       final."actor_id",
       final."actor_name",
       final."film_id",
       final."title",
       final."revenue_per_actor"
FROM   (
        SELECT  sub.*,
                ROW_NUMBER() OVER (
                    PARTITION BY sub."actor_id"
                    ORDER BY     sub."total_revenue" DESC
                ) AS "film_rank"
        FROM   (
                SELECT  a."actor_id",
                        a."first_name" || ' ' || a."last_name" AS "actor_name",
                        fr."film_id",
                        fr."title",
                        fr."total_revenue",
                        fr."total_revenue" * 1.0 / fr."actor_count" AS "revenue_per_actor"
                FROM    "actor"      AS a
                JOIN    "film_actor" AS fa  ON a."actor_id" = fa."actor_id"
                JOIN   (
                        SELECT  f."film_id",
                                f."title",
                                SUM(p."amount")                AS "total_revenue",
                                COUNT(DISTINCT fa2."actor_id") AS "actor_count"
                        FROM    "payment"    AS p
                        JOIN    "rental"     AS r  USING ("rental_id")
                        JOIN    "inventory"  AS i  USING ("inventory_id")
                        JOIN    "film"       AS f  USING ("film_id")
                        JOIN    "film_actor" AS fa2 USING ("film_id")
                        GROUP   BY f."film_id"
                       ) AS fr
                       ON fr."film_id" = fa."film_id"
               ) AS sub
       ) AS final
WHERE  final."film_rank" <= 3
ORDER  BY final."actor_id",
          final."film_rank"
LIMIT  20;
```

```sql
-- Description: (Optional) Aggregate to compute each actor’s average of their top‑three film shares  
SELECT DISTINCT
       t3."actor_id",
       t3."actor_name",
       AVG(t3."revenue_per_actor") AS "avg_revenue_top3"
FROM   (
        SELECT  sub.*,
                ROW_NUMBER() OVER (
                    PARTITION BY sub."actor_id"
                    ORDER BY     sub."total_revenue" DESC
                ) AS "film_rank"
        FROM   (
                SELECT  a."actor_id",
                        a."first_name" || ' ' || a."last_name" AS "actor_name",
                        fr."film_id",
                        fr."title",
                        fr."total_revenue",
                        fr."total_revenue" * 1.0 / fr."actor_count" AS "revenue_per_actor"
                FROM    "actor"      AS a
                JOIN    "film_actor" AS fa  ON a."actor_id" = fa."actor_id"
                JOIN   (
                        SELECT  f."film_id",
                                f."title",
                                SUM(p."amount")                AS "total_revenue",
                                COUNT(DISTINCT fa2."actor_id") AS "actor_count"
                        FROM    "payment"    AS p
                        JOIN    "rental"     AS r  USING ("rental_id")
                        JOIN    "inventory"  AS i  USING ("inventory_id")
                        JOIN    "film"       AS f  USING ("film_id")
                        JOIN    "film_actor" AS fa2 USING ("film_id")
                        GROUP   BY f."film_id"
                       ) AS fr
                       ON fr."film_id" = fa."film_id"
               ) AS sub
       ) AS t3
WHERE  t3."film_rank" <= 3
GROUP  BY t3."actor_id"
LIMIT  20;
```

These queries progress from simple inspection to the final extraction of “top‑three revenue‑generating films for each actor” together with each actor’s revenue share, and finally compute the actor’s average share across the three films.
