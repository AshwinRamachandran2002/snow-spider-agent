```

```sql
--Description: Combine ORDER_ITEMS with PRODUCTS to retrieve only “Sleep & Lounge” sales in 2023
SELECT 
  oi."order_id",
  oi."product_id",
  p."name"              AS "product_name",
  p."category",
  p."cost",
  oi."sale_price",
  oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
  ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND oi."status" = 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000 AND 1703980799000000
LIMIT 20;
```

```sql
--Description: Bring in ORDERS table to double‑check “Complete” status at order level
SELECT 
  o."order_id",
  o."status"          AS "order_status",
  oi."status"         AS "item_status",
  o."created_at",
  oi."sale_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  ON o."order_id" = oi."order_id"
WHERE o."status" = 'Complete'
  AND o."created_at" BETWEEN 1672531200000000 AND 1703980799000000
LIMIT 20;
```

```sql
--Description: Verify cost taken from INVENTORY_ITEMS when possible (cross‑check one product)
SELECT
  ii."product_id",
  ii."cost" AS "inventory_cost",
  ii."product_distribution_center_id",
  ii."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
WHERE ii."product_id" IN (
      SELECT DISTINCT p."id" 
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
      WHERE p."category" ILIKE '%Sleep%Lounge%')
LIMIT 20;
```

```sql
--Description: Check how many unique orders for “Sleep & Lounge” completed in 2023
SELECT 
  COUNT(DISTINCT oi."order_id") AS "num_complete_orders_sleep_lounge_2023"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
  ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND oi."status" = 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000 AND 1703980799000000;
```

```sql
--Description: Calculate monthly aggregates (preview) for “Sleep & Lounge” in 2023
SELECT 
  TO_CHAR(TO_TIMESTAMP(oi."created_at"/1e6), 'YYYY-MM') AS "month",
  SUM(oi."sale_price")                                  AS "total_sales",
  SUM(p."cost")                                         AS "total_cost",
  COUNT(DISTINCT oi."order_id")                         AS "complete_orders"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
  ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND oi."status" = 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000 AND 1703980799000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Add profit and profit‑to‑cost ratio calculation (extended preview)
SELECT 
  TO_CHAR(TO_TIMESTAMP(oi."created_at"/1e6), 'YYYY-MM')          AS "month",
  SUM(oi."sale_price")                                           AS "total_sales",
  SUM(p."cost")                                                  AS "total_cost",
  SUM(oi."sale_price") - SUM(p."cost")                           AS "total_profit",
  CASE WHEN SUM(p."cost") = 0 THEN NULL
       ELSE (SUM(oi."sale_price") - SUM(p."cost"))/SUM(p."cost")
  END                                                            AS "profit_to_cost_ratio"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
  ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND oi."status" = 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000 AND 1703980799000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Quick validation of total profit vs cost using one month (e.g., January 2023)
SELECT 
  oi."order_id",
  oi."sale_price",
  p."cost",
  (oi."sale_price" - p."cost") AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
  ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND oi."status" = 'Complete'
  AND TO_CHAR(TO_TIMESTAMP(oi."created_at"/1e6), 'YYYY-MM') = '2023-01'
LIMIT 20;
```
