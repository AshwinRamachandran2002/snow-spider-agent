```sql
--Description: Combine all four downstream‑gene expressions for each bladder case
--             (pivot-style view, still limiting to 20 rows)
SELECT   expr."case_barcode",
         MAX(CASE WHEN expr."gene_name" = 'MDM2'  THEN expr."HTSeq__FPKM" END) AS "MDM2_FPKM",
         MAX(CASE WHEN expr."gene_name" = 'TP53'  THEN expr."HTSeq__FPKM" END) AS "TP53_FPKM",
         MAX(CASE WHEN expr."gene_name" = 'CDKN1A' THEN expr."HTSeq__FPKM" END) AS "CDKN1A_FPKM",
         MAX(CASE WHEN expr."gene_name" = 'CCNE1'  THEN expr."HTSeq__FPKM" END) AS "CCNE1_FPKM"
FROM     TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39" expr
WHERE    expr."project_short_name" = 'TCGA-BLCA'
  AND    expr."gene_name" ILIKE ANY (ARRAY['%MDM2%','%TP53%','%CDKN1A%','%CCNE1%'])
  AND    expr."case_barcode" IN (
           SELECT DISTINCT "case_barcode"
           FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"
           WHERE  "project_short_name" = 'TCGA-BLCA'
             AND  "Hugo_Symbol" ILIKE '%CDKN2A%'
         )
GROUP BY expr."case_barcode"
LIMIT 20;
```

```sql
--Description: Final joined view that shows mutation class, gender, vital status,
--             days_to_death and the four gene‑expression values together
SELECT  m."case_barcode",
        m."Variant_Classification",
        m."Variant_Type",
        c."demo__gender"        AS "gender",
        c."demo__vital_status"  AS "vital_status",
        c."demo__days_to_death" AS "days_to_death",
        e."MDM2_FPKM",
        e."TP53_FPKM",
        e."CDKN1A_FPKM",
        e."CCNE1_FPKM"
FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39" m
JOIN   TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                       c
  ON   c."submitter_id" = m."case_barcode"
JOIN  (
        SELECT   expr."case_barcode",
                 MAX(CASE WHEN expr."gene_name" = 'MDM2'  THEN expr."HTSeq__FPKM" END) AS "MDM2_FPKM",
                 MAX(CASE WHEN expr."gene_name" = 'TP53'  THEN expr."HTSeq__FPKM" END) AS "TP53_FPKM",
                 MAX(CASE WHEN expr."gene_name" = 'CDKN1A' THEN expr."HTSeq__FPKM" END) AS "CDKN1A_FPKM",
                 MAX(CASE WHEN expr."gene_name" = 'CCNE1'  THEN expr."HTSeq__FPKM" END) AS "CCNE1_FPKM"
        FROM     TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39" expr
        WHERE    expr."project_short_name" = 'TCGA-BLCA'
          AND    expr."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
        GROUP BY expr."case_barcode"
      ) e
  ON  e."case_barcode" = m."case_barcode"
WHERE  m."project_short_name" = 'TCGA-BLCA'
  AND  m."Hugo_Symbol" = 'CDKN2A'
LIMIT 20;
```
