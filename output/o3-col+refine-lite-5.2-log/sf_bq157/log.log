```sql
--Description: 7) Create two patient cohorts: WITH and WITHOUT PASS‑filtered TP53 mutation.  
WITH tp53_mut  AS (  
  SELECT DISTINCT "ParticipantBarcode"  
  FROM PANCANCER_ATLAS_1.PANCANCER_ATLAS_FILTERED."MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE"  
  WHERE "Study" = 'LGG'  
    AND "Hugo_Symbol" = 'TP53'  
    AND "FILTER" = 'PASS'  
),  
expr AS (  
  SELECT  
    "ParticipantBarcode",  
    AVG(LOG10("normalized_count" + 1)) AS "avg_log10_expr"  
  FROM PANCANCER_ATLAS_1.PANCANCER_ATLAS_FILTERED."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED"  
  WHERE "Study" = 'LGG'  
    AND "Symbol" = 'DRG2'  
  GROUP BY "ParticipantBarcode"  
)  
SELECT  
  e."ParticipantBarcode",  
  CASE WHEN t."ParticipantBarcode" IS NOT NULL THEN 'YES' ELSE 'NO' END AS "TP53_mut",  
  e."avg_log10_expr"  
FROM expr  e  
LEFT JOIN tp53_mut t  
  ON e."ParticipantBarcode" = t."ParticipantBarcode"  
LIMIT 20;
```

```sql
--Description: 8) Aggregate counts, sums and squared‑sums of DRG2 expression in the two cohorts (needed for Welch’s T).  
WITH cohorts AS ( …same sub‑query from #7… )  
SELECT  
  "TP53_mut",  
  COUNT(*)                                            AS "N",  
  SUM("avg_log10_expr")                              AS "S",  
  SUM(POWER("avg_log10_expr",2))                     AS "Q"  
FROM cohorts  
GROUP BY "TP53_mut"  
LIMIT 20;
```

```sql
--Description: 9) Compute means, variances and finally the Welch T‑score comparing the two groups.  
WITH cohorts AS ( …same sub‑query from #7… ),  
stats AS (  
  SELECT  
    "TP53_mut",  
    COUNT(*)                              AS "N",  
    SUM("avg_log10_expr")                AS "S",  
    SUM(POWER("avg_log10_expr",2))       AS "Q"  
  FROM cohorts  
  GROUP BY "TP53_mut"  
),  
pivot AS (  
  SELECT  
    MAX(CASE WHEN "TP53_mut"='YES' THEN "N" END) AS "Ny",  
    MAX(CASE WHEN "TP53_mut"='NO'  THEN "N" END) AS "Nn",  
    MAX(CASE WHEN "TP53_mut"='YES' THEN "S" END) AS "Sy",  
    MAX(CASE WHEN "TP53_mut"='NO'  THEN "S" END) AS "Sn",  
    MAX(CASE WHEN "TP53_mut"='YES' THEN "Q" END) AS "Qy",  
    MAX(CASE WHEN "TP53_mut"='NO'  THEN "Q" END) AS "Qn"  
  FROM stats  
)  
SELECT  
  "Ny",  
  "Nn",  
  ("Sy"/"Ny")                                    AS "avg_y",  
  ("Sn"/"Nn")                                    AS "avg_n",  
  (("Qy" - POWER("Sy",2)/"Ny")/("Ny"-1))        AS "var_y",  
  (("Qn" - POWER("Sn",2)/"Nn")/("Nn"-1))        AS "var_n",  
  (("Sy"/"Ny") - ("Sn"/"Nn")) /  
  SQRT( (("Qy" - POWER("Sy",2)/"Ny") / (("Ny"-1)*"Ny"))  
       +(("Qn" - POWER("Sn",2)/"Nn") / (("Nn"-1)*"Nn")) )  AS "T_score"  
FROM pivot  
LIMIT 20;
```

```sql
--Description: 10) (Optional) Return the final Welch T‑score only.  
WITH cohorts AS ( …same sub‑query from #7… ),  
stats AS ( …same block from #9… ),  
pivot AS ( …same block from #9… )  
SELECT  
  (("Sy"/"Ny") - ("Sn"/"Nn")) /  
  SQRT( (("Qy" - POWER("Sy",2)/"Ny") / (("Ny"-1)*"Ny"))  
       +(("Qn" - POWER("Sn",2)/"Nn") / (("Nn"-1)*"Nn")) )  AS "Welch_T_score"  
FROM pivot  
LIMIT 20;
```
