```sql
--Description: 1) Peek at a few Chinese (CN) patent publications to understand the main identifiers.  
SELECT 
    "publication_number",
    "application_number",
    "family_id",
    "grant_date",
    "publication_date",
    "kind_code",
    "application_kind"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
LIMIT 20;
```

```sql
--Description: 2) Check some CN publications that already have a grant date recorded ( > 0 ).  
SELECT 
    "publication_number",
    "application_number",
    "family_id",
    "grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
  AND "grant_date" > 0
LIMIT 20;
```

```sql
--Description: 3) Focus on CN grants between 2010‑01‑01 and 2023‑12‑31 to confirm date format and volumes.  
SELECT 
    "publication_number",
    "application_number",
    "family_id",
    "grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
  AND "grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```

```sql
--Description: 4) For the same 2010‑2023 CN‑granted set, examine how many distinct applications exist per family.  
SELECT 
    "family_id",
    COUNT(DISTINCT "application_number") AS "distinct_apps_in_family"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
  AND "grant_date" BETWEEN 20100101 AND 20231231
GROUP BY "family_id"
LIMIT 20;
```

```sql
--Description: 5) List families (within the 2010‑2023 CN grant window) that have MORE than one distinct application.  
SELECT 
    "family_id",
    COUNT(DISTINCT "application_number") AS "distinct_apps_in_family"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'CN'
  AND "grant_date" BETWEEN 20100101 AND 20231231
GROUP BY "family_id"
HAVING COUNT(DISTINCT "application_number") > 1
LIMIT 20;
```

```sql
--Description: 6) Retrieve the individual CN‑granted publications (2010‑2023) that belong to those multi‑application families.  
WITH multi_app_families AS (
    SELECT 
        "family_id"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'CN'
      AND "grant_date" BETWEEN 20100101 AND 20231231
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
)
SELECT 
    p."publication_number",
    p."application_number",
    p."family_id",
    p."grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN multi_app_families f
  ON p."family_id" = f."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```

```sql
--Description: 7) Count how many CN‑granted publications (2010‑2023) fall into those multi‑application families.  
WITH multi_app_families AS (
    SELECT 
        "family_id"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'CN'
      AND "grant_date" BETWEEN 20100101 AND 20231231
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
)
SELECT 
    COUNT(*) AS "num_CN_grants_in_multi_app_families"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN multi_app_families f
  ON p."family_id" = f."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```

```sql
--Description: 8) If you also wish to see the breakdown by year of grant for those counted patents.  
WITH multi_app_families AS (
    SELECT 
        "family_id"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'CN'
      AND "grant_date" BETWEEN 20100101 AND 20231231
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
)
SELECT 
    FLOOR("grant_date"/10000) AS "grant_year",
    COUNT(*) AS "cn_grants_multi_app_fam"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN multi_app_families f
  ON p."family_id" = f."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
GROUP BY FLOOR("grant_date"/10000)
ORDER BY "grant_year"
LIMIT 20;
```

```sql
--Description: 9) Quickly verify the maximum and minimum grant years captured in the result set.  
WITH multi_app_families AS (
    SELECT 
        "family_id"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'CN'
      AND "grant_date" BETWEEN 20100101 AND 20231231
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
)
SELECT 
    MIN(FLOOR("grant_date"/10000)) AS "earliest_year",
    MAX(FLOOR("grant_date"/10000)) AS "latest_year"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN multi_app_families f
  ON p."family_id" = f."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```

```sql
--Description: 10) (Final) Provide the distinct count of CN families (2010‑2023 grants) that have >1 applications, alongside the total publication count inside those families.  
WITH multi_app_families AS (
    SELECT 
        "family_id",
        COUNT(DISTINCT "application_number") AS "distinct_apps_in_family"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'CN'
      AND "grant_date" BETWEEN 20100101 AND 20231231
    GROUP BY "family_id"
    HAVING COUNT(DISTINCT "application_number") > 1
)
SELECT 
    COUNT(DISTINCT f."family_id") AS "num_CN_families_with_multi_apps",
    COUNT(p."publication_number")  AS "num_CN_grants_in_those_families"
FROM PATENTS.PATENTS.PUBLICATIONS p
JOIN multi_app_families f
  ON p."family_id" = f."family_id"
WHERE p."country_code" = 'CN'
  AND p."grant_date" BETWEEN 20100101 AND 20231231
LIMIT 20;
```
