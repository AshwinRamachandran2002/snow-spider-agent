```sql
--Description: 5) For users who have BOTH events, show how many days elapsed until uninstall
WITH installs AS (
  SELECT user_pseudo_id, MIN(event_timestamp) AS install_ts
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
), removes AS (
  SELECT user_pseudo_id, MIN(event_timestamp) AS uninstall_ts
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
)
SELECT i.user_pseudo_id,
       TIMESTAMP_MICROS(install_ts)   AS install_time,
       TIMESTAMP_MICROS(uninstall_ts) AS uninstall_time,
       ROUND((uninstall_ts - install_ts)/1e6/3600/24,2) AS days_to_uninstall
FROM installs i
JOIN removes  r USING (user_pseudo_id)
LIMIT 20;
```

```sql
--Description: 6) Classify every installer as
--   a) uninstall_within_7_days, b) uninstall_after_7_days, c) never_uninstalled
WITH installs AS (
  SELECT user_pseudo_id, MIN(event_timestamp) AS install_ts
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
), removes AS (
  SELECT user_pseudo_id, MIN(event_timestamp) AS uninstall_ts
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
)
SELECT i.user_pseudo_id,
       CASE
         WHEN r.uninstall_ts IS NULL                                   THEN 'never_uninstalled'
         WHEN (r.uninstall_ts - i.install_ts) > 7*24*3600*1e6          THEN 'uninstall_after_7_days'
         ELSE                                                              'uninstall_within_7_days'
       END AS uninstall_flag
FROM installs i
LEFT JOIN removes r USING (user_pseudo_id)
LIMIT 20;
```

```sql
--Description: 7) Count how many users fall in each of those three buckets
WITH installs AS (
  SELECT user_pseudo_id, MIN(event_timestamp) AS install_ts
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
), removes AS (
  SELECT user_pseudo_id, MIN(event_timestamp) AS uninstall_ts
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
), flags AS (
  SELECT i.user_pseudo_id,
         CASE
           WHEN r.uninstall_ts IS NULL                                   THEN 'never_uninstalled'
           WHEN (r.uninstall_ts - i.install_ts) > 7*24*3600*1e6          THEN 'uninstall_after_7_days'
           ELSE                                                              'uninstall_within_7_days'
         END AS uninstall_flag
  FROM installs i
  LEFT JOIN removes r USING (user_pseudo_id)
)
SELECT uninstall_flag, COUNT(*) AS users
FROM flags
GROUP BY uninstall_flag
LIMIT 20;
```

```sql
--Description: 8) Compute the percentage of Aug–Sep installers who EITHER
--   (a) never uninstalled OR (b) uninstalled only after 7+ days
WITH installs AS (
  SELECT user_pseudo_id, MIN(event_timestamp) AS install_ts
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
), removes AS (
  SELECT user_pseudo_id, MIN(event_timestamp) AS uninstall_ts
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
), cohorts AS (
  SELECT i.user_pseudo_id,
         CASE
           WHEN r.uninstall_ts IS NULL                                   THEN 'retain_7_plus'
           WHEN (r.uninstall_ts - i.install_ts) > 7*24*3600*1e6          THEN 'retain_7_plus'
           ELSE                                                              'uninstall_within_7_days'
         END AS cohort
  FROM installs i
  LEFT JOIN removes r USING (user_pseudo_id)
)
SELECT
  COUNTIF(cohort = 'retain_7_plus') / COUNT(*) AS pct_users_retained_7_days_plus
FROM cohorts
LIMIT 20;
```

These eight progressively more sophisticated queries let you inspect relevant columns, identify installation and un‑installation events, classify users, and finally return the percentage of Aug–Sep 2018 installers who either never uninstalled or kept the app for at least seven days.
