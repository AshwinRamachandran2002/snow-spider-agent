```sql
--Description:  Assemble the final ingredient list for each pizza order.
--              Steps:
--              1) Expand each pizza’s recipe into individual toppings.
--              2) Create a base list of orders (remapping pizza_id so Meatlovers = 1, others = 2).
--              3) Add standard toppings (qty = 1).
--              4) Add customer “extras” (may introduce duplicates) and capture their row_id.
--              5) Record customer “exclusions” (to be removed) and capture their row_id.
--              6) Combine standard + extras and sum quantities.
--              7) Remove excluded toppings.
--              8) Translate topping_id → topping_name, prefix with ‘2x’ when qty > 1.
--              9) Alphabetically sort toppings per order, then concatenate with GROUP_CONCAT.
--             10) Return one row per pizza order, grouped by (row_id, order_id,
--                 pizza_name, order_time) and ordered by row_id.
WITH recipe_toppings AS (
    SELECT
        pr.pizza_id,
        CAST(j.value AS INTEGER) AS topping_id
    FROM  pizza_recipes AS pr,
          json_each('[' || pr.toppings || ']') AS j
),
order_base AS (
    SELECT
        pco.order_id,
        pco.customer_id,
        pn.pizza_name,
        CASE WHEN pn.pizza_name = 'Meatlovers' THEN 1 ELSE 2 END AS pizza_id,
        pco.order_time
    FROM pizza_customer_orders AS pco
    JOIN pizza_names           AS pn ON pn.pizza_id = pco.pizza_id
),
standard AS (                       -- standard toppings (qty = 1)
    SELECT ob.order_id, rt.topping_id, 1 AS qty
    FROM   order_base      AS ob
    JOIN   recipe_toppings AS rt ON rt.pizza_id = ob.pizza_id
),
extras AS (                         -- customer extras
    SELECT ge.order_id,
           ge.extras        AS topping_id,
           ge.extras_count  AS qty,
           ge.row_id        AS row_id
    FROM   pizza_get_extras AS ge
),
exclusions AS (                     -- customer exclusions
    SELECT gx.order_id,
           gx.exclusions    AS topping_id,
           gx.row_id        AS row_id
    FROM   pizza_get_exclusions AS gx
),
combined AS (                       -- standard + extras, summed
    SELECT order_id, topping_id, SUM(qty) AS qty
    FROM (
          SELECT * FROM standard
          UNION ALL
          SELECT order_id, topping_id, qty FROM extras
    )
    GROUP BY order_id, topping_id
),
after_exclusions AS (               -- drop excluded toppings entirely
    SELECT c.*
    FROM   combined  AS c
    LEFT  JOIN exclusions AS e
           ON e.order_id  = c.order_id
          AND e.topping_id = c.topping_id
    WHERE  e.topping_id IS NULL
),
topping_names AS (                  -- translate to names + ‘2x’ if duplicated
    SELECT
        ae.order_id,
        CASE WHEN ae.qty > 1
             THEN '2x' || pt.topping_name
             ELSE        pt.topping_name
        END AS ingredient
    FROM after_exclusions AS ae
    JOIN pizza_toppings   AS pt ON pt.topping_id = ae.topping_id
),
ingredients_sorted AS (             -- alphabetical list per order
    SELECT order_id, ingredient
    FROM   topping_names
    ORDER  BY order_id, ingredient
),
final_string AS (                   -- comma‑separated ingredient string
    SELECT
        order_id,
        GROUP_CONCAT(ingredient, ', ') AS ing_list
    FROM   ingredients_sorted
    GROUP  BY order_id
)
SELECT
    COALESCE(ex.row_id, exn.row_id)               AS row_id,
    ob.order_id,
    ob.customer_id,
    ob.pizza_name,
    ob.pizza_name || ': ' || fs.ing_list          AS final_set_of_ingredients
FROM order_base AS ob
LEFT JOIN extras     AS ex  ON ex.order_id  = ob.order_id
LEFT JOIN exclusions AS exn ON exn.order_id = ob.order_id
JOIN final_string    AS fs  ON fs.order_id  = ob.order_id
GROUP BY
    row_id,
    ob.order_id,
    ob.customer_id,
    ob.pizza_name,
    ob.order_time
ORDER BY row_id ASC;
