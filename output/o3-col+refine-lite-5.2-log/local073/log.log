```sql
-- 8. Put standards, extras and exclusions together
WITH recipe_toppings AS (        -- one row per standard topping
  SELECT
    pr."pizza_id",
    CAST(j.value AS INTEGER)     AS "topping_id"
  FROM "pizza_recipes" AS pr,
       json_each('[' || pr."toppings" || ']') AS j
),
order_base AS (                  -- every ordered pizza with its name
  SELECT
    pco."order_id",
    pco."customer_id",
    pn."pizza_name",
    CASE WHEN pn."pizza_name" = 'Meatlovers' THEN 1 ELSE 2 END AS "pizza_id"
  FROM "pizza_customer_orders" AS pco
  JOIN "pizza_names"           AS pn
    ON pn."pizza_id" = pco."pizza_id"
),
standard AS (                    -- standard toppings (qty = 1)
  SELECT
    ob."order_id",
    rt."topping_id",
    1 AS qty
  FROM order_base      AS ob
  JOIN recipe_toppings AS rt
    ON rt."pizza_id" = ob."pizza_id"
),
extras AS (                      -- extras may add duplicates
  SELECT
    ge."order_id",
    ge."extras"        AS "topping_id",
    ge."extras_count"  AS qty
  FROM "pizza_get_extras" AS ge
),
exclusions AS (                  -- toppings to remove completely
  SELECT
    gx."order_id",
    gx."exclusions"    AS "topping_id"
  FROM "pizza_get_exclusions" AS gx
),
combined AS (                    -- total quantity per topping per order
  SELECT "order_id","topping_id", SUM(qty) AS qty
  FROM (
        SELECT * FROM standard
        UNION ALL
        SELECT * FROM extras
  )
  GROUP BY "order_id","topping_id"
),
after_exclusions AS (            -- discard anything present in exclusions
  SELECT c.*
  FROM combined  AS c
  LEFT JOIN exclusions AS e
    ON e."order_id" = c."order_id"
   AND e."topping_id" = c."topping_id"
  WHERE e."topping_id" IS NULL
)
SELECT *
FROM after_exclusions
LIMIT 20;
```

```sql
-- 9. FINAL ANSWER — one row per pizza order with the finished ingredient list
WITH recipe_toppings AS (
  SELECT
    pr."pizza_id",
    CAST(j.value AS INTEGER) AS "topping_id"
  FROM "pizza_recipes" AS pr,
       json_each('[' || pr."toppings" || ']') AS j
),
order_base AS (
  SELECT
    pco."order_id",
    pco."customer_id",
    pn."pizza_name",
    CASE WHEN pn."pizza_name" = 'Meatlovers' THEN 1 ELSE 2 END AS "pizza_id",
    pco."order_time"
  FROM "pizza_customer_orders" AS pco
  JOIN "pizza_names"           AS pn
    ON pn."pizza_id" = pco."pizza_id"
),
standard AS (
  SELECT ob."order_id", rt."topping_id", 1 AS qty
  FROM order_base AS ob
  JOIN recipe_toppings AS rt
    ON rt."pizza_id" = ob."pizza_id"
),
extras AS (
  SELECT ge."order_id", ge."extras" AS "topping_id", ge."extras_count" AS qty
  FROM "pizza_get_extras" AS ge
),
exclusions AS (
  SELECT gx."order_id", gx."exclusions" AS "topping_id"
  FROM "pizza_get_exclusions" AS gx
),
combined AS (
  SELECT "order_id","topping_id", SUM(qty) AS qty
  FROM (
        SELECT * FROM standard
        UNION ALL
        SELECT * FROM extras
  )
  GROUP BY "order_id","topping_id"
),
after_exclusions AS (
  SELECT c.*
  FROM combined AS c
  LEFT JOIN exclusions AS e
    ON e."order_id" = c."order_id"
   AND e."topping_id" = c."topping_id"
  WHERE e."topping_id" IS NULL
),
topping_names AS (
  SELECT
    ae."order_id",
    CASE WHEN ae.qty > 1
         THEN '2x' || pt."topping_name"
         ELSE        pt."topping_name"
    END AS ingredient
  FROM after_exclusions AS ae
  JOIN "pizza_toppings" AS pt
    ON pt."topping_id" = ae."topping_id"
),
ingredients_sorted AS (                    -- alphabetical inside each order
  SELECT
    "order_id",
    ingredient
  FROM topping_names
  ORDER BY "order_id", ingredient
),
final_string AS (
  SELECT
    "order_id",
    GROUP_CONCAT(ingredient, ', ') AS ing_list
  FROM ingredients_sorted
  GROUP BY "order_id"
)
SELECT
  COALESCE(ge."row_id", gx."row_id")              AS "row_id",
  ob."order_id",
  ob."customer_id",
  ob."pizza_name",
  ob."pizza_name" || ': ' || fs."ing_list"        AS "final_set_of_ingredients"
FROM order_base          AS ob
LEFT JOIN "pizza_get_extras"      AS ge ON ge."order_id" = ob."order_id"
LEFT JOIN "pizza_get_exclusions"  AS gx ON gx."order_id" = ob."order_id"
JOIN final_string       AS fs ON fs."order_id" = ob."order_id"
GROUP BY "row_id", ob."order_id", ob."pizza_name", ob."order_time"
ORDER BY "row_id" ASC
LIMIT 20;
```
