--Description:  End‑to‑end query that:
--  1. Explodes each pizza’s recipe so every topping is a row.
--  2. Builds a base list of all pizzas ordered, remapping pizza_id
--     (Meatlovers = 1, all others = 2).
--  3. Adds the standard recipe toppings (qty = 1).
--  4. Adds any customer “extras” (which may duplicate toppings) and
--     records a single extras row_id per order (MIN(row_id)).
--  5. Records any customer “exclusions” and one exclusions row_id per
--     order (MIN(row_id)).
--  6. Sums standard + extras quantities, then removes excluded toppings.
--  7. Converts topping_id → topping_name, prefixes with ‘2x’ when a
--     topping appears twice.
--  8. Alphabetically sorts toppings inside each order and joins them
--     with GROUP_CONCAT.
--  9. Outputs one line per pizza order, containing:
--       • a row_id (from extras if present, else from exclusions),
--       • order_id, customer_id, pizza_name,
--       • “pizza_name: ingredient list”.
WITH
recipe_toppings AS (                      /* step 1 */
  SELECT pr.pizza_id,
         CAST(j.value AS INTEGER) AS topping_id
  FROM  pizza_recipes AS pr,
        json_each('[' || pr.toppings || ']') AS j
),
order_base AS (                           /* step 2 */
  SELECT pco.order_id,
         pco.customer_id,
         pn.pizza_name,
         CASE WHEN pn.pizza_name = 'Meatlovers' THEN 1 ELSE 2 END AS pizza_id,
         pco.order_time
  FROM  pizza_customer_orders AS pco
  JOIN  pizza_names            AS pn ON pn.pizza_id = pco.pizza_id
),
standard AS (                             /* step 3 */
  SELECT ob.order_id, rt.topping_id, 1 AS qty
  FROM   order_base      AS ob
  JOIN   recipe_toppings AS rt ON rt.pizza_id = ob.pizza_id
),
extras AS (                               /* step 4 (quantities) */
  SELECT ge.order_id,
         ge.extras       AS topping_id,
         ge.extras_count AS qty
  FROM   pizza_get_extras AS ge
),
extra_row AS (                            /* step 4 (row_id) */
  SELECT order_id, MIN(row_id) AS row_id
  FROM   pizza_get_extras
  GROUP  BY order_id
),
exclusions AS (                           /* step 5 (quantities) */
  SELECT gx.order_id,
         gx.exclusions AS topping_id
  FROM   pizza_get_exclusions AS gx
),
excl_row AS (                             /* step 5 (row_id) */
  SELECT order_id, MIN(row_id) AS row_id
  FROM   pizza_get_exclusions
  GROUP  BY order_id
),
combined AS (                             /* step 6 (sum std + extras) */
  SELECT order_id, topping_id, SUM(qty) AS qty
  FROM (
        SELECT * FROM standard
        UNION ALL
        SELECT * FROM extras
  )
  GROUP BY order_id, topping_id
),
after_exclusions AS (                     /* step 6 (remove exclusions) */
  SELECT c.*
  FROM   combined  AS c
  LEFT   JOIN exclusions AS e
         ON e.order_id  = c.order_id
        AND e.topping_id = c.topping_id
  WHERE  e.topping_id IS NULL
),
named AS (                                /* step 7 */
  SELECT ae.order_id,
         CASE WHEN ae.qty > 1
              THEN '2x' || pt.topping_name
              ELSE        pt.topping_name
         END AS ingredient
  FROM   after_exclusions AS ae
  JOIN   pizza_toppings   AS pt ON pt.topping_id = ae.topping_id
),
sorted AS (                               /* step 8 */
  SELECT order_id, ingredient
  FROM   named
  ORDER  BY order_id, ingredient
),
final_string AS (                         /* step 8 cont’d */
  SELECT order_id,
         GROUP_CONCAT(ingredient, ', ') AS ing_list
  FROM   sorted
  GROUP  BY order_id
)
SELECT
  COALESCE(er.row_id, xr.row_id)                        AS final_row_id,
  ob.order_id,
  ob.customer_id,
  ob.pizza_name,
  ob.pizza_name || ': ' || fs.ing_list                  AS final_set_of_ingredients
FROM  order_base   AS ob
LEFT  JOIN extra_row AS er ON er.order_id = ob.order_id
LEFT  JOIN excl_row  AS xr ON xr.order_id = ob.order_id
JOIN  final_string   AS fs ON fs.order_id = ob.order_id
GROUP BY
  COALESCE(er.row_id, xr.row_id),   /* row_id expression, not its alias */
  ob.order_id,
  ob.customer_id,
  ob.pizza_name,
  ob.order_time
ORDER BY final_row_id;
