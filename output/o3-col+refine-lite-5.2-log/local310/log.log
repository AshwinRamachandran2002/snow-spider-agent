```sql
-- 1. Preview a few rows from the `results` table
SELECT *
FROM   results
LIMIT 20;
```

```sql
-- 2. List the seasons (years) present in `results`
SELECT DISTINCT r.year
FROM   results      AS res
JOIN   races        AS r  ON r.race_id = res.race_id
LIMIT 20;
```

```sql
-- 3. Total points scored by each driver in a season
SELECT r.year,
       res.driver_id,
       SUM(res.points) AS driver_points
FROM   results AS res
JOIN   races   AS r ON r.race_id = res.race_id
GROUP  BY r.year, res.driver_id
ORDER  BY r.year, driver_points DESC
LIMIT 20;
```

```sql
-- 4. Highest‑scoring driver (and their total) per season
SELECT year,
       MAX(driver_points) AS top_driver_points
FROM  (
        SELECT r.year,
               res.driver_id,
               SUM(res.points) AS driver_points
        FROM   results AS res
        JOIN   races   AS r ON r.race_id = res.race_id
        GROUP  BY r.year, res.driver_id
      )
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
-- 5. Total points scored by each constructor in a season
SELECT r.year,
       res.constructor_id,
       SUM(res.points) AS constructor_points
FROM   results AS res
JOIN   races   AS r ON r.race_id = res.race_id
GROUP  BY r.year, res.constructor_id
ORDER  BY r.year, constructor_points DESC
LIMIT 20;
```

```sql
-- 6. Highest‑scoring constructor (and their total) per season
SELECT year,
       MAX(constructor_points) AS top_constructor_points
FROM (
        SELECT r.year,
               res.constructor_id,
               SUM(res.points) AS constructor_points
        FROM   results AS res
        JOIN   races   AS r ON r.race_id = res.race_id
        GROUP  BY r.year, res.constructor_id
     )
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
-- 7. Combine the two previous sub‑queries, add the points together,
--    and return the three years with the smallest sums
WITH top_driver AS (
        SELECT year,
               MAX(driver_points) AS top_driver_points
        FROM (
                SELECT r.year,
                       res.driver_id,
                       SUM(res.points) AS driver_points
                FROM   results AS res
                JOIN   races   AS r ON r.race_id = res.race_id
                GROUP  BY r.year, res.driver_id
             )
        GROUP BY year
),
top_constructor AS (
        SELECT year,
               MAX(constructor_points) AS top_constructor_points
        FROM (
                SELECT r.year,
                       res.constructor_id,
                       SUM(res.points) AS constructor_points
                FROM   results AS res
                JOIN   races   AS r ON r.race_id = res.race_id
                GROUP  BY r.year, res.constructor_id
             )
        GROUP BY year
)
SELECT d.year,
       d.top_driver_points + c.top_constructor_points AS combined_points
FROM   top_driver      AS d
JOIN   top_constructor AS c USING (year)
ORDER  BY combined_points ASC
LIMIT 3;
```
