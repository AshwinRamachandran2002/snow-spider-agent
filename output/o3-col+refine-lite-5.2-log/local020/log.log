Query:
--Description: Combine bat‑runs and extra‑runs to get total runs conceded by each bowler  
SELECT r1."bowler",
       (r1.runs_off_bat + COALESCE(r2.extra_runs,0)) AS total_runs_conceded
FROM  ( SELECT b."bowler",
               SUM(bs."runs_scored") AS runs_off_bat
        FROM   "ball_by_ball"  AS b
        LEFT  JOIN "batsman_scored" AS bs
               ON  b."match_id"   = bs."match_id"
               AND b."over_id"    = bs."over_id"
               AND b."ball_id"    = bs."ball_id"
               AND b."innings_no" = bs."innings_no"
        GROUP BY b."bowler"
      ) AS r1
LEFT JOIN
      ( SELECT b."bowler",
               SUM(er."extra_runs") AS extra_runs
        FROM   "ball_by_ball" AS b
        LEFT  JOIN "extra_runs"   AS er
               ON  b."match_id"   = er."match_id"
               AND b."over_id"    = er."over_id"
               AND b."ball_id"    = er."ball_id"
               AND b."innings_no" = er."innings_no"
        GROUP BY b."bowler"
      ) AS r2
ON  r1."bowler" = r2."bowler"
LIMIT 20;
