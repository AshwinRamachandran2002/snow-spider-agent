2025-05-02 04:40:08 - ThreadPoolExecutor-0_6 - INFO - [Exploration]
```sql
--Description: Check a handful of different bowlers’ ids that appear in the ball‑by‑ball table  
SELECT DISTINCT "bowler"
FROM "ball_by_ball"
LIMIT 20;
```

```sql
--Description: Map those bowler‑ids to player names  
SELECT DISTINCT b."bowler",
       p."player_name"
FROM   "ball_by_ball"  AS b
JOIN   "player"        AS p
       ON p."player_id" = b."bowler"
LIMIT 20;
```

```sql
--Description: Runs off the bat conceded by each bowler  
SELECT b."bowler",
       SUM(bs."runs_scored") AS runs_off_bat
FROM   "ball_by_ball"  AS b
JOIN   "batsman_scored" AS bs
       ON  b."match_id"   = bs."match_id"
       AND b."over_id"    = bs."over_id"
       AND b."ball_id"    = bs."ball_id"
       AND b."innings_no" = bs."innings_no"
GROUP  BY b."bowler"
LIMIT 20;
```

```sql
--Description: Extra runs (wides, no‑balls, byes, …) conceded by each bowler  
SELECT b."bowler",
       SUM(er."extra_runs") AS extra_runs
FROM   "ball_by_ball" AS b
JOIN   "extra_runs"   AS er
       ON  b."match_id"   = er."match_id"
       AND b."over_id"    = er."over_id"
       AND b."ball_id"    = er."ball_id"
       AND b."innings_no" = er."innings_no"
GROUP  BY b."bowler"
LIMIT 20;
```

```sql
--Description: Number of wickets credited to each bowler (ignore run‑outs)  
SELECT b."bowler",
       COUNT(*) AS wickets
FROM   "ball_by_ball" AS b
JOIN   "wicket_taken" AS w
       ON  b."match_id"   = w."match_id"
       AND b."over_id"    = w."over_id"
       AND b."ball_id"    = w."ball_id"
       AND b."innings_no" = w."innings_no"
WHERE  w."kind_out" NOT IN ('run out')
GROUP  BY b."bowler"
LIMIT 20;
```

```sql
--Description: Combine bat‑runs and extra‑runs to get total runs conceded by each bowler  
SELECT r1."bowler",
       (r1.runs_off_bat + COALESCE(r2.extra_runs,0)) AS total_runs_conceded
FROM  ( SELECT b."bowler",
               SUM(bs."runs_scored") AS runs_off_bat
        FROM   "ball_by_ball"  AS b
        LEFT  JOIN "batsman_scored" AS bs
               ON  b."match_id"   = bs."match_id"
               AND b."over_id"    = bs."over_id"
               AND b."ball_id"    = bs."ball_id"
               AND b."innings_no" = bs."innings_no"
        GROUP BY b."bowler"
      ) AS r1
LEFT JOIN
      ( SELECT b."bowler",
               SUM(er."extra_runs") AS extra_runs
        FROM   "ball_by_ball" AS b
        LEFT  JOIN "extra_runs"   AS er
               ON  b."match_id"   = er."match_id"
               AND b."over_id"    = er."over_id"
               AND b."ball_id"    = er."ball_id"
               AND b."innings_no" = er."innings_no"
        GROUP BY b."bowler"
      ) AS r2
ON  r1."bowler" = r2."bowler"
LIMIT 20;
```

```sql
--Description: Bring together runs conceded and wickets to compute each bowler’s bowling average  
SELECT tr."bowler",
       tr.total_runs_conceded,
       wks.wickets,
       ROUND( CAST(tr.total_runs_conceded AS FLOAT) / wks.wickets , 2 ) AS bowling_avg
FROM (   /* total runs conceded */    
        SELECT b."bowler",
               SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS total_runs_conceded
        FROM   "ball_by_ball" AS b
        LEFT  JOIN "batsman_scored" AS bs
               ON  b."match_id"   = bs."match_id"
               AND b."over_id"    = bs."over_id"
               AND b."ball_id"    = bs."ball_id"
               AND b."innings_no" = bs."innings_no"
        LEFT  JOIN "extra_runs" AS er
               ON  b."match_id"   = er."match_id"
               AND b."over_id"    = er."over_id"
               AND b."ball_id"    = er."ball_id"
               AND b."innings_no" = er."innings_no"
        GROUP BY b."bowler"
     )  AS tr
JOIN (   /* wickets taken (no run‑outs) */    
        SELECT b."bowler",
               COUNT(*) AS wickets
        FROM   "ball_by_ball" AS b
        JOIN   "wicket_taken" AS w
               ON  b."match_id"   = w."match_id"
               AND b."over_id"    = w."over_id"
               AND b."ball_id"    = w."ball_id"
               AND b."innings_no" = w."innings_no"
        WHERE  w."kind_out" NOT IN ('run out')
        GROUP  BY b."bowler"
     )  AS wks
     ON tr."bowler" = wks."bowler"
WHERE wks.wickets > 0
LIMIT 20;
```

```sql
--Description: FINAL ANSWER → bowler with the lowest bowling average (runs per wicket)  
SELECT p."player_name",
       ROUND( CAST(tr.total_runs_conceded AS FLOAT) / wks.wickets , 2 ) AS bowling_average
FROM (   /* total runs conceded by each bowler */    
        SELECT b."bowler",
               SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS total_runs_conceded
        FROM   "ball_by_ball" AS b
        LEFT  JOIN "batsman_scored" AS bs
               ON  b."match_id"   = bs."match_id"
               AND b."over_id"    = bs."over_id"
               AND b."ball_id"    = bs."ball_id"
               AND b."innings_no" = bs."innings_no"
        LEFT  JOIN "extra_runs" AS er
               ON  b."match_id"   = er."match_id"
               AND b."over_id"    = er."over_id"
               AND b."ball_id"    = er."ball_id"
               AND b."innings_no" = er."innings_no"
        GROUP  BY b."bowler"
     )  AS tr
JOIN (   /* wickets credited to each bowler (excluding run‑outs) */    
        SELECT b."bowler",
               COUNT(*) AS wickets
        FROM   "ball_by_ball" AS b
        JOIN   "wicket_taken" AS w
               ON  b."match_id"   = w."match_id"
               AND b."over_id"    = w."over_id"
               AND b."ball_id"    = w."ball_id"
               AND b."innings_no" = w."innings_no"
        WHERE  w."kind_out" NOT IN ('run out')
        GROUP  BY b."bowler"
     )  AS wks
       ON tr."bowler" = wks."bowler"
JOIN "player" AS p
       ON p."player_id" = tr."bowler"
WHERE wks.wickets > 0
ORDER BY bowling_average ASC
LIMIT 1;
```
