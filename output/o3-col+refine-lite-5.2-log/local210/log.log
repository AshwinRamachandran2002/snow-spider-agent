       h."hub_name",
       COUNT(*) AS "finished_orders_feb"
FROM   "orders"  o
JOIN   "stores"  s ON s."store_id" = o."store_id"
JOIN   "hubs"    h ON h."hub_id"  = s."hub_id"
WHERE  o."order_status"       = 'FINISHED'
  AND  o."order_created_month" = 2
  AND  o."order_created_year"  = 2021
GROUP  BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
-- Description: 4) Count finished orders per hub in March.
SELECT h."hub_id",
       h."hub_name",
       COUNT(*) AS "finished_orders_mar"
FROM   "orders"  o
JOIN   "stores"  s ON s."store_id" = o."store_id"
JOIN   "hubs"    h ON h."hub_id"  = s."hub_id"
WHERE  o."order_status"       = 'FINISHED'
  AND  o."order_created_month" = 3
  AND  o."order_created_year"  = 2021
GROUP  BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
-- Description: 5) Put the February and March counts together in one CTE
-- so that we can compute the percentage change hub‑by‑hub.
WITH feb AS (
    SELECT h."hub_id",
           COUNT(*) AS cnt_feb
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    JOIN   "hubs"   h ON h."hub_id"   = s."hub_id"
    WHERE  o."order_status"       = 'FINISHED'
      AND  o."order_created_month" = 2
      AND  o."order_created_year"  = 2021
    GROUP BY h."hub_id"
), mar AS (
    SELECT h."hub_id",
           COUNT(*) AS cnt_mar
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    JOIN   "hubs"   h ON h."hub_id"   = s."hub_id"
    WHERE  o."order_status"       = 'FINISHED'
      AND  o."order_created_month" = 3
      AND  o."order_created_year"  = 2021
    GROUP BY h."hub_id"
)
SELECT h."hub_id",
       h."hub_name",
       feb.cnt_feb,
       mar.cnt_mar,
       ROUND( (mar.cnt_mar - feb.cnt_feb) * 100.0 / feb.cnt_feb , 2)  AS pct_change
FROM   feb
JOIN   mar ON mar."hub_id" = feb."hub_id"
JOIN   "hubs" h ON h."hub_id" = feb."hub_id"
LIMIT 20;
```

```sql
-- Description: 6) Finally, list only the hubs whose March finished‑order
-- volume grew by more than 20 % compared with February.
WITH feb AS (
    SELECT h."hub_id",
           COUNT(*) AS cnt_feb
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    JOIN   "hubs"   h ON h."hub_id"   = s."hub_id"
    WHERE  o."order_status"       = 'FINISHED'
      AND  o."order_created_month" = 2
      AND  o."order_created_year"  = 2021
    GROUP BY h."hub_id"
), mar AS (
    SELECT h."hub_id",
           COUNT(*) AS cnt_mar
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    JOIN   "hubs"   h ON h."hub_id"   = s."hub_id"
    WHERE  o."order_status"       = 'FINISHED'
      AND  o."order_created_month" = 3
      AND  o."order_created_year"  = 2021
    GROUP BY h."hub_id"
)
SELECT DISTINCT
       h."hub_id",
       h."hub_name"
FROM   feb
JOIN   mar ON mar."hub_id" = feb."hub_id"
JOIN   "hubs" h ON h."hub_id" = feb."hub_id"
WHERE  (mar.cnt_mar - feb.cnt_feb) * 100.0 / feb.cnt_feb > 20
LIMIT 20;
```

```sql
-- Description: 7) If desired, include the exact percentage increase for those hubs.
WITH feb AS (
    SELECT h."hub_id",
           COUNT(*) AS cnt_feb
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    JOIN   "hubs"   h ON h."hub_id"   = s."hub_id"
    WHERE  o."order_status"       = 'FINISHED'
      AND  o."order_created_month" = 2
      AND  o."order_created_year"  = 2021
    GROUP BY h."hub_id"
), mar AS (
    SELECT h."hub_id",
           COUNT(*) AS cnt_mar
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    JOIN   "hubs"   h ON h."hub_id"   = s."hub_id"
    WHERE  o."order_status"       = 'FINISHED'
      AND  o."order_created_month" = 3
      AND  o."order_created_year"  = 2021
    GROUP BY h."hub_id"
)
SELECT h."hub_id",
       h."hub_name",
       feb.cnt_feb AS "Feb_finished_orders",
       mar.cnt_mar AS "Mar_finished_orders",
       ROUND( (mar.cnt_mar - feb.cnt_feb) * 100.0 / feb.cnt_feb , 2)  AS "percent_increase"
FROM   feb
JOIN   mar ON mar."hub_id" = feb."hub_id"
JOIN   "hubs" h ON h."hub_id" = feb."hub_id"
WHERE  (mar.cnt_mar - feb.cnt_feb) * 100.0 / feb.cnt_feb > 20
ORDER  BY percent_increase DESC
LIMIT 20;
```

```sql
-- Description: 8) Double‑check any hub that appeared only in March (zero orders in Feb).
-- These are ignored in percentage calculation above; we list them separately.
WITH feb AS (
    SELECT h."hub_id",
           COUNT(*) AS cnt_feb
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    JOIN   "hubs"   h ON h."hub_id"   = s."hub_id"
    WHERE  o."order_status"       = 'FINISHED'
      AND  o."order_created_month" = 2
      AND  o."order_created_year"  = 2021
    GROUP BY h."hub_id"
), mar AS (
    SELECT h."hub_id",
           COUNT(*) AS cnt_mar
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    JOIN   "hubs"   h ON h."hub_id"   = s."hub_id"
    WHERE  o."order_status"       = 'FINISHED'
      AND  o."order_created_month" = 3
      AND  o."order_created_year"  = 2021
    GROUP BY h."hub_id"
)
SELECT DISTINCT
       h."hub_id",
       h."hub_name",
       COALESCE(feb.cnt_feb,0) AS cnt_feb,
       mar.cnt_mar             AS cnt_mar
FROM   mar
LEFT JOIN feb ON feb."hub_id" = mar."hub_id"
JOIN   "hubs" h ON h."hub_id" = mar."hub_id"
WHERE  feb.cnt_feb IS NULL   -- no finished orders in Feb
LIMIT 20;
```

```sql
-- Description: 9) In case we want to examine the raw daily trend for one
-- specific hub before concluding, here is a sample for hub_id = 2.
SELECT   o."order_created_day",
         o."order_created_month",
         COUNT(*) AS finished_orders
FROM     "orders" o
JOIN     "stores" s ON s."store_id" = o."store_id"
WHERE    s."hub_id"     = 2
  AND    o."order_status" = 'FINISHED'
  AND    o."order_created_month" IN (2,3)
  AND    o."order_created_year"  = 2021
GROUP BY o."order_created_day", o."order_created_month"
ORDER BY o."order_created_month", o."order_created_day"
LIMIT 20;
```

```sql
-- Description: 10) Summarize the percentage change across ALL hubs
-- (useful to see overall performance, not strictly required).
WITH feb AS (
    SELECT COUNT(*) AS cnt_feb
    FROM   "orders"
    WHERE  "order_status"       = 'FINISHED'
      AND  "order_created_month" = 2
      AND  "order_created_year"  = 2021
), mar AS (
    SELECT COUNT(*) AS cnt_mar
    FROM   "orders"
    WHERE  "order_status"       = 'FINISHED'
      AND  "order_created_month" = 3
      AND  "order_created_year"  = 2021
)
SELECT cnt_feb,
       cnt_mar,
       ROUND( (cnt_mar - cnt_feb)*100.0 / cnt_feb , 2) AS overall_percent_change
FROM   feb, mar
LIMIT 20;
```
