Query:
-- Description: Safely compute the overall percentage change in FINISHED orders
-- from February 2021 to March 2021 across all hubs, guarding against division‑by‑zero.
WITH feb AS (
    SELECT COUNT(*) AS cnt_feb
    FROM   "orders"
    WHERE  "order_status"        = 'FINISHED'
      AND  "order_created_year"  = 2021
      AND  "order_created_month" = 2
), mar AS (
    SELECT COUNT(*) AS cnt_mar
    FROM   "orders"
    WHERE  "order_status"        = 'FINISHED'
      AND  "order_created_year"  = 2021
      AND  "order_created_month" = 3
)
SELECT cnt_feb,
       cnt_mar,
       CASE 
           WHEN cnt_feb = 0 THEN NULL      -- avoid divide‑by‑zero
           ELSE ROUND( (cnt_mar - cnt_feb) * 100.0 / cnt_feb , 2)
       END AS overall_percent_change
FROM   feb, mar
LIMIT 20
