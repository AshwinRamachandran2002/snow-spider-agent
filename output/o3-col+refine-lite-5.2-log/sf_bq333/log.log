Query:
--Description: Derive average session duration for each browser
WITH sessions AS (
    SELECT "browser",
           "session_id",
           (MAX("created_at") - MIN("created_at"))/1000000 AS "session_dur_secs"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "browser","session_id"
)
SELECT "browser",
       AVG("session_dur_secs") AS "avg_session_dur_secs"
FROM sessions
GROUP BY "browser"
ORDER BY "avg_session_dur_secs"
LIMIT 20;
