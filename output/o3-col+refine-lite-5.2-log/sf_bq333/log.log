```sql
--Description: Preview the key columns needed for session‑based analysis
SELECT "session_id",
       "browser",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
LIMIT 20;
```

```sql
--Description: List all distinct browsers recorded in the EVENTS table
SELECT DISTINCT "browser"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
LIMIT 20;
```

```sql
--Description: Count total sessions captured for each browser
SELECT "browser",
       COUNT(DISTINCT "session_id") AS "session_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
GROUP BY "browser"
ORDER BY "session_cnt" DESC
LIMIT 20;
```

```sql
--Description: Inspect a handful of complete event timelines within one browser to understand created_at values
SELECT "browser",
       "session_id",
       MIN("created_at") AS "first_event",
       MAX("created_at") AS "last_event",
       (MAX("created_at") - MIN("created_at"))/1000000 AS "session_dur_secs"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
WHERE "browser" = 'Chrome'
GROUP BY "browser","session_id"
LIMIT 20;
```

```sql
--Description: Compute session duration (secs) for every browser/session pair
SELECT "browser",
       "session_id",
       (MAX("created_at") - MIN("created_at"))/1000000 AS "session_dur_secs"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
GROUP BY "browser","session_id"
LIMIT 20;
```

```sql
--Description: Derive average session duration for each browser
WITH sessions AS (
    SELECT "browser",
           "session_id",
           (MAX("created_at") - MIN("created_at"))/1000000 AS "session_dur_secs"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "browser","session_id"
)
SELECT "browser",
       AVG("session_dur_secs") AS "avg_session_dur_secs"
FROM sessions
GROUP BY "browser"
ORDER BY "avg_session_dur_secs"
LIMIT 20;
```

```sql
--Description: Filter to browsers with >10 sessions and order by shortest average duration
WITH sessions AS (
    SELECT "browser",
           "session_id",
           (MAX("created_at") - MIN("created_at"))/1000000 AS "session_dur_secs"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "browser","session_id"
)
SELECT "browser",
       AVG("session_dur_secs") AS "avg_session_dur_secs",
       COUNT(*)                AS "total_sessions"
FROM sessions
GROUP BY "browser"
HAVING COUNT(*) > 10
ORDER BY "avg_session_dur_secs"
LIMIT 20;
```

```sql
--Description: Return the three browsers with the shortest average session duration (only those with >10 sessions)
WITH sessions AS (
    SELECT "browser",
           "session_id",
           (MAX("created_at") - MIN("created_at"))/1000000 AS "session_dur_secs"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "browser","session_id"
),
browser_avg AS (
    SELECT "browser",
           AVG("session_dur_secs") AS "avg_session_dur_secs",
           COUNT(*)               AS "total_sessions"
    FROM sessions
    GROUP BY "browser"
    HAVING COUNT(*) > 10
)
SELECT "browser",
       "avg_session_dur_secs"
FROM browser_avg
ORDER BY "avg_session_dur_secs"
LIMIT 3;
```
