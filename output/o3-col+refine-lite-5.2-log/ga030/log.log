Query:
--Description: 8)  Aggregate the cohort sizes and the number retained in week 4
SELECT
  cohort_monday,
  COUNT(1)                                    AS users_in_cohort,
  SUM(retained_wk4)                           AS users_retained_wk4,
  SAFE_DIVIDE( SUM(retained_wk4), COUNT(1) )  AS retention_rate_wk4
FROM (
  -- step‑7 result without the LIMIT
  SELECT DISTINCT
    base.`user_pseudo_id`,
    base.cohort_monday,
    IF( MIN(CASE WHEN week_index = 3 THEN 1 ELSE 0 END) = 1 , 1 , 0) AS retained_wk4
  FROM (
      SELECT
        b.`user_pseudo_id`,
        b.cohort_monday,
        FLOOR( DATE_DIFF( PARSE_DATE('%Y%m%d', e.`event_date`)
                        , b.first_session_date
                        , DAY) / 7 )  AS week_index
      FROM (
          SELECT
            `user_pseudo_id`,
            MIN( PARSE_DATE('%Y%m%d', `event_date`) ) AS first_session_date,
            DATE_TRUNC( MIN( PARSE_DATE('%Y%m%d', `event_date`) )
                       , WEEK(MONDAY) )                AS cohort_monday
          FROM  `firebase-public-project.analytics_153293282.events_*`
          WHERE `event_name` = 'session_start'
            AND PARSE_DATE('%Y%m%d', `event_date`) >= DATE '2018-07-02'
          GROUP BY `user_pseudo_id`
      ) AS b
      JOIN `firebase-public-project.analytics_153293282.events_*`  AS e
      ON  e.`user_pseudo_id` = b.`user_pseudo_id`
      WHERE e.`event_name` = 'session_start'
  ) AS base
  GROUP BY base.`user_pseudo_id`, base.cohort_monday
)
GROUP BY cohort_monday
ORDER BY retention_rate_wk4 DESC
LIMIT 20;
