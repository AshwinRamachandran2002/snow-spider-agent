WHERE `event_name` = 'session_start'
LIMIT 20;
```

```sql
--Description: 3)  Pull distinct user‑date pairs for every session_start across *all* days
SELECT DISTINCT
  PARSE_DATE('%Y%m%d', `event_date`)     AS session_date,
  `user_pseudo_id`
FROM  `firebase-public-project.analytics_153293282.events_*`
WHERE `event_name` = 'session_start'
  AND PARSE_DATE('%Y%m%d', `event_date`) >= DATE '2018-07-02'     -- start of analysis window
LIMIT 20;
```

```sql
--Description: 4)  For each user, find the first day they ever fired a session_start
SELECT
  `user_pseudo_id`,
  MIN( PARSE_DATE('%Y%m%d', `event_date`) ) AS first_session_date
FROM  `firebase-public-project.analytics_153293282.events_*`
WHERE `event_name` = 'session_start'
  AND PARSE_DATE('%Y%m%d', `event_date`) >= DATE '2018-07-02'
GROUP BY `user_pseudo_id`
LIMIT 20;
```

```sql
--Description: 5)  Turn the first_session_date into a “cohort week” whose label is the
--                Monday of that week
SELECT
  `user_pseudo_id`,
  DATE_TRUNC(first_session_date , WEEK(MONDAY)) AS cohort_monday
FROM (
  SELECT
    `user_pseudo_id`,
    MIN( PARSE_DATE('%Y%m%d', `event_date`) ) AS first_session_date
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE `event_name` = 'session_start'
    AND PARSE_DATE('%Y%m%d', `event_date`) >= DATE '2018-07-02'
  GROUP BY `user_pseudo_id`
)
LIMIT 20;
```

```sql
--Description: 6)  Combine cohort information with *all* later sessions so that we can see
--                what week‑index every subsequent session falls into
SELECT
  base.`user_pseudo_id`,
  base.cohort_monday,
  PARSE_DATE('%Y%m%d', e.`event_date`)              AS session_date,
  FLOOR( DATE_DIFF( PARSE_DATE('%Y%m%d', e.`event_date`)
                  , base.first_session_date
                  , DAY) / 7 )                      AS week_index
FROM (
    SELECT
      `user_pseudo_id`,
      MIN( PARSE_DATE('%Y%m%d', `event_date`) ) AS first_session_date,
      DATE_TRUNC( MIN( PARSE_DATE('%Y%m%d', `event_date`) )
                 , WEEK(MONDAY) )                AS cohort_monday
    FROM  `firebase-public-project.analytics_153293282.events_*`
    WHERE `event_name` = 'session_start'
      AND PARSE_DATE('%Y%m%d', `event_date`) >= DATE '2018-07-02'
    GROUP BY `user_pseudo_id`
) AS base
JOIN `firebase-public-project.analytics_153293282.events_*`  AS e
ON  e.`user_pseudo_id` = base.`user_pseudo_id`
WHERE e.`event_name` = 'session_start'
LIMIT 20;
```

```sql
--Description: 7)  Flag whether each user had *any* session in week_index = 3
SELECT DISTINCT
  base.`user_pseudo_id`,
  base.cohort_monday,
  IF( MIN(CASE WHEN week_index = 3 THEN 1 ELSE 0 END) = 1 , 1 , 0) AS retained_wk4
FROM (
  -- re‑using the derived table from step‑6
  SELECT
    b.`user_pseudo_id`,
    b.cohort_monday,
    FLOOR( DATE_DIFF( PARSE_DATE('%Y%m%d', e.`event_date`)
                    , b.first_session_date
                    , DAY) / 7 )  AS week_index
  FROM (
      SELECT
        `user_pseudo_id`,
        MIN( PARSE_DATE('%Y%m%d', `event_date`) ) AS first_session_date,
        DATE_TRUNC( MIN( PARSE_DATE('%Y%m%d', `event_date`) )
                   , WEEK(MONDAY) )                AS cohort_monday
      FROM  `firebase-public-project.analytics_153293282.events_*`
      WHERE `event_name` = 'session_start'
        AND PARSE_DATE('%Y%m%d', `event_date`) >= DATE '2018-07-02'
      GROUP BY `user_pseudo_id`
  ) AS b
  JOIN `firebase-public-project.analytics_153293282.events_*`  AS e
  ON  e.`user_pseudo_id` = b.`user_pseudo_id`
  WHERE e.`event_name` = 'session_start'
) AS base
GROUP BY base.`user_pseudo_id`, base.cohort_monday
LIMIT 20;
```

```sql
--Description: 8)  Aggregate the cohort sizes and the number retained in week 4
SELECT
  cohort_monday,
  COUNT(1)                                    AS users_in_cohort,
  SUM(retained_wk4)                           AS users_retained_wk4,
  SAFE_DIVIDE( SUM(retained_wk4), COUNT(1) )  AS retention_rate_wk4
FROM (
  -- step‑7 result without the LIMIT
  SELECT DISTINCT
    base.`user_pseudo_id`,
    base.cohort_monday,
    IF( MIN(CASE WHEN week_index = 3 THEN 1 ELSE 0 END) = 1 , 1 , 0) AS retained_wk4
  FROM (
      SELECT
        b.`user_pseudo_id`,
        b.cohort_monday,
        FLOOR( DATE_DIFF( PARSE_DATE('%Y%m%d', e.`event_date`)
                        , b.first_session_date
                        , DAY) / 7 )  AS week_index
      FROM (
          SELECT
            `user_pseudo_id`,
            MIN( PARSE_DATE('%Y%m%d', `event_date`) ) AS first_session_date,
            DATE_TRUNC( MIN( PARSE_DATE('%Y%m%d', `event_date`) )
                       , WEEK(MONDAY) )                AS cohort_monday
          FROM  `firebase-public-project.analytics_153293282.events_*`
          WHERE `event_name` = 'session_start'
            AND PARSE_DATE('%Y%m%d', `event_date`) >= DATE '2018-07-02'
          GROUP BY `user_pseudo_id`
      ) AS b
      JOIN `firebase-public-project.analytics_153293282.events_*`  AS e
      ON  e.`user_pseudo_id` = b.`user_pseudo_id`
      WHERE e.`event_name` = 'session_start'
  ) AS base
  GROUP BY base.`user_pseudo_id`, base.cohort_monday
)
GROUP BY cohort_monday
ORDER BY retention_rate_wk4 DESC
LIMIT 20;
```

```sql
--Description: 9)  From the aggregated table, pick the cohort Monday with the highest
--                week‑4 retention (ties broken by earlier date)
SELECT
  cohort_monday
FROM (
  SELECT
    cohort_monday,
    SAFE_DIVIDE( SUM(retained_wk4), COUNT(1) ) AS retention_rate_wk4
  FROM (
      -- identical derivation as step‑8 (omitted for brevity)
  )
  GROUP BY cohort_monday
)
ORDER BY retention_rate_wk4 DESC, cohort_monday ASC
LIMIT 20;
```

```sql
--Description: 10) FINAL – return the winning cohort Monday in the requested format “YYYY‑MM‑DD”
SELECT
  FORMAT_DATE('%Y-%m-%d', cohort_monday) AS best_cohort_monday
FROM (
  SELECT
    cohort_monday,
    SAFE_DIVIDE( SUM(retained_wk4), COUNT(1) ) AS retention_rate_wk4
  FROM (
      -- identical derivation as above (omitted for brevity)
  )
  GROUP BY cohort_monday
  ORDER BY retention_rate_wk4 DESC, cohort_monday ASC
  LIMIT 1
)
LIMIT 20;
```
