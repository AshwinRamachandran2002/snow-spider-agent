```sql
--Description / thinking process:
-- Goal:  Return the Monday‑date label (YYYY‑MM‑DD) for the cohort (users grouped by 
--        the Monday of the week containing their very first `session_start`) that 
--        exhibits the highest “week‑4” retention.
-- Retention definition:  a user is counted as retained if they have at least one
--        `session_start` whose week_index = 3
--        ( 0 = first week, 1 = second, 2 = third, 3 = fourth → days 22‑28 ).
-- Steps (CTEs):
--   1. first_sessions  – find each user’s first session and its cohort Monday.
--   2. all_sessions    – attach every later session for those users and compute
--                        week_index = FLOOR(DATE_DIFF(curr_date, first_date)/7).
--   3. user_retention  – flag whether the user was active in week_index 3.
--   4. cohort_stats    – aggregate counts + retention rate per cohort.
--   5. final SELECT    – choose the cohort with the max retention rate
--                        (earlier cohort wins if tied) and format it.

WITH first_sessions AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', event_date))                                             AS first_session_date,
    DATE_TRUNC(MIN(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_monday
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d', event_date) >= DATE '2018-07-02'   -- analysis window
  GROUP BY user_pseudo_id
),
all_sessions AS (
  SELECT
    fs.user_pseudo_id,
    fs.cohort_monday,
    FLOOR(
      DATE_DIFF(PARSE_DATE('%Y%m%d', e.event_date), fs.first_session_date, DAY) / 7
    ) AS week_index
  FROM first_sessions AS fs
  JOIN `firebase-public-project.analytics_153293282.events_*` AS e
    ON e.user_pseudo_id = fs.user_pseudo_id
  WHERE e.event_name = 'session_start'
),
user_retention AS (
  SELECT
    user_pseudo_id,
    cohort_monday,
    IF(MAX(CASE WHEN week_index = 3 THEN 1 ELSE 0 END) = 1, 1, 0) AS retained_wk4
  FROM all_sessions
  GROUP BY user_pseudo_id, cohort_monday
),
cohort_stats AS (
  SELECT
    cohort_monday,
    COUNT(*)                                  AS users_in_cohort,
    SUM(retained_wk4)                         AS users_retained_wk4,
    SAFE_DIVIDE(SUM(retained_wk4), COUNT(*))  AS retention_rate_wk4
  FROM user_retention
  GROUP BY cohort_monday
)
SELECT
  FORMAT_DATE('%Y-%m-%d', cohort_monday) AS best_cohort_monday
FROM cohort_stats
ORDER BY retention_rate_wk4 DESC, cohort_monday ASC
LIMIT 1;
