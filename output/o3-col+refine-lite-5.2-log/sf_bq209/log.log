```sql
--Description: Count forward citations (distinct citing apps) for 2010‑granted patents
WITH target AS (
    SELECT "publication_number",
           "application_number",
           "filing_date"
    FROM   PATENTS.PATENTS.PUBLICATIONS
    WHERE  "grant_date" BETWEEN 20100101 AND 20101231
      AND  "application_kind" = 'A'          -- utility patents
),
cit AS (
    SELECT  p."application_number"                         AS "citing_app",
            p."filing_date"                                AS "citing_filing",
            f.value:"publication_number"::STRING           AS "cited_pub"
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."citation") f
    WHERE   p."citation" IS NOT NULL
      AND   p."citation" <> '[]'
      AND   f.value:"publication_number" IS NOT NULL
)
SELECT  t."publication_number",
        COUNT(DISTINCT cit."citing_app") AS "forward_citation_cnt"
FROM    target t
LEFT JOIN cit
       ON cit."cited_pub" = t."publication_number"
      AND TO_DATE(TO_VARCHAR(cit."citing_filing"),'YYYYMMDD')
          <= DATEADD(year,10,TO_DATE(TO_VARCHAR(t."filing_date"),'YYYYMMDD'))
GROUP BY t."publication_number"
LIMIT 20;
```

```sql
--Description: Identify 2010‑granted patents that have exactly ONE forward citation within 10 years
WITH target AS (
    SELECT "publication_number",
           "application_number",
           "filing_date"
    FROM   PATENTS.PATENTS.PUBLICATIONS
    WHERE  "grant_date" BETWEEN 20100101 AND 20101231
      AND  "application_kind" = 'A'
),
cit AS (
    SELECT  p."application_number"                         AS "citing_app",
            p."filing_date"                                AS "citing_filing",
            f.value:"publication_number"::STRING           AS "cited_pub"
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."citation") f
    WHERE   p."citation" IS NOT NULL
      AND   p."citation" <> '[]'
      AND   f.value:"publication_number" IS NOT NULL
),
agg AS (
    SELECT  t."publication_number",
            COUNT(DISTINCT cit."citing_app") AS "fwd_cnt"
    FROM    target t
    LEFT JOIN cit
           ON cit."cited_pub" = t."publication_number"
          AND TO_DATE(TO_VARCHAR(cit."citing_filing"),'YYYYMMDD')
              <= DATEADD(year,10,TO_DATE(TO_VARCHAR(t."filing_date"),'YYYYMMDD'))
    GROUP BY t."publication_number"
)
SELECT *
FROM   agg
WHERE  "fwd_cnt" = 1
LIMIT 20;
```

```sql
--Description: Final count of 2010‑granted utility patents with exactly one forward citation
WITH target AS (
    SELECT "publication_number",
           "application_number",
           "filing_date"
    FROM   PATENTS.PATENTS.PUBLICATIONS
    WHERE  "grant_date" BETWEEN 20100101 AND 20101231
      AND  "application_kind" = 'A'
),
cit AS (
    SELECT  p."application_number"                         AS "citing_app",
            p."filing_date"                                AS "citing_filing",
            f.value:"publication_number"::STRING           AS "cited_pub"
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."citation") f
    WHERE   p."citation" IS NOT NULL
      AND   p."citation" <> '[]'
      AND   f.value:"publication_number" IS NOT NULL
),
agg AS (
    SELECT  t."publication_number",
            COUNT(DISTINCT cit."citing_app") AS "fwd_cnt"
    FROM    target t
    LEFT JOIN cit
           ON cit."cited_pub" = t."publication_number"
          AND TO_DATE(TO_VARCHAR(cit."citing_filing"),'YYYYMMDD')
              <= DATEADD(year,10,TO_DATE(TO_VARCHAR(t."filing_date"),'YYYYMMDD'))
    GROUP BY t."publication_number"
)
SELECT COUNT(*)
FROM   agg
WHERE  "fwd_cnt" = 1;
```

```sql
--Description: List patents (with one forward citation) together with that sole citing application number
WITH target AS (
    SELECT "publication_number",
           "application_number",
           "filing_date"
    FROM   PATENTS.PATENTS.PUBLICATIONS
    WHERE  "grant_date" BETWEEN 20100101 AND 20101231
      AND  "application_kind" = 'A'
),
cit AS (
    SELECT  p."application_number"                         AS "citing_app",
            p."filing_date"                                AS "citing_filing",
            f.value:"publication_number"::STRING           AS "cited_pub"
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."citation") f
    WHERE   p."citation" IS NOT NULL
      AND   p."citation" <> '[]'
      AND   f.value:"publication_number" IS NOT NULL
),
agg AS (
    SELECT  t."publication_number",
            MIN(cit."citing_app")          AS "only_citing_app",
            COUNT(DISTINCT cit."citing_app") AS "fwd_cnt"
    FROM    target t
    LEFT JOIN cit
           ON cit."cited_pub" = t."publication_number"
          AND TO_DATE(TO_VARCHAR(cit."citing_filing"),'YYYYMMDD')
              <= DATEADD(year,10,TO_DATE(TO_VARCHAR(t."filing_date"),'YYYYMMDD'))
    GROUP BY t."publication_number"
    HAVING  "fwd_cnt" = 1
)
SELECT *
FROM   agg
LIMIT 20;
```

