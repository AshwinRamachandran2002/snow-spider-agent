```sql
--Description: Discover the most recent snapshot timestamp recorded for PACKAGEVERSIONS
SELECT 
  MAX("SnapshotAt") AS "LatestSnapshot_PV"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS";
```

```sql
--Description: For each (NPM) package, keep only the latest released version (highest Ordinal)  
--             using the most‑recent PACKAGEVERSIONS snapshot
WITH latest_snapshot AS (
  SELECT MAX("SnapshotAt") AS "snap"
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
)
SELECT
  pv."Name",
  pv."Version",
  pv."VersionInfo":"Ordinal"::NUMBER AS "Ordinal"
FROM (
  SELECT *,
         ROW_NUMBER() OVER (
           PARTITION BY "Name"
           ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC
         ) AS rn
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pv,
       latest_snapshot s
  WHERE pv."System" = 'NPM'
    AND pv."SnapshotAt" = s."snap"
    AND pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE
) pv
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Look at how PACKAGEVERSIONTOPROJECT ties NPM package versions to GitHub repos
SELECT 
  "System",
  "Name",
  "Version",
  "ProjectName",
  "RelationType"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"
WHERE "System" = 'NPM'
  AND "ProjectType" = 'GITHUB'
LIMIT 20;
```

```sql
--Description: Identify the most‑recent snapshot for PACKAGEVERSIONTOPROJECT
SELECT MAX("SnapshotAt") AS "LatestSnapshot_PVTP"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT";
```

```sql
--Description: Connect the latest released NPM package versions to their GitHub projects
WITH latest_release AS (
  SELECT *
  FROM (
    SELECT pv.*,
           ROW_NUMBER() OVER (
             PARTITION BY "Name"
             ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC
           ) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pv
    WHERE pv."System" = 'NPM'
      AND pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE
  )
  WHERE rn = 1
),
pvtp AS (
  SELECT *
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"
  WHERE "System" = 'NPM'
    AND "ProjectType" = 'GITHUB'
)
SELECT 
  lr."Name"          AS "Package",
  lr."Version"       AS "LatestReleaseVersion",
  pvtp."ProjectName" AS "GitHubRepo"
FROM latest_release lr
JOIN pvtp
  ON lr."Name" = pvtp."Name"
  AND lr."Version" = pvtp."Version"
LIMIT 20;
```

```sql
--Description: Bring in the GitHub star counts for each connected repository
WITH latest_release AS (
  SELECT *
  FROM (
    SELECT pv.*,
           ROW_NUMBER() OVER (
             PARTITION BY "Name"
             ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC
           ) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pv
    WHERE pv."System" = 'NPM'
      AND pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE
  )
  WHERE rn = 1
),
pvtp AS (
  SELECT *
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"
  WHERE "System" = 'NPM'
    AND "ProjectType" = 'GITHUB'
),
proj AS (
  SELECT *
  FROM (
    SELECT *,
           ROW_NUMBER() OVER (
             PARTITION BY "Name"
             ORDER BY "SnapshotAt" DESC
           ) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"
    WHERE "Type" = 'GITHUB'
  )
  WHERE rn = 1
)
SELECT 
  lr."Name"          AS "Package",
  lr."Version"       AS "LatestReleaseVersion",
  proj."StarsCount"
FROM latest_release lr
JOIN pvtp
  ON lr."Name" = pvtp."Name"
  AND lr."Version" = pvtp."Version"
JOIN proj
  ON pvtp."ProjectName" = proj."Name"
ORDER BY proj."StarsCount" DESC
LIMIT 20;
```

