Query:
--Description: Bring in the GitHub star counts for each connected repository
WITH latest_release AS (
  SELECT *
  FROM (
    SELECT pv.*,
           ROW_NUMBER() OVER (
             PARTITION BY "Name"
             ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC
           ) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pv
    WHERE pv."System" = 'NPM'
      AND pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE
  )
  WHERE rn = 1
),
pvtp AS (
  SELECT *
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"
  WHERE "System" = 'NPM'
    AND "ProjectType" = 'GITHUB'
),
proj AS (
  SELECT *
  FROM (
    SELECT *,
           ROW_NUMBER() OVER (
             PARTITION BY "Name"
             ORDER BY "SnapshotAt" DESC
           ) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"
    WHERE "Type" = 'GITHUB'
  )
  WHERE rn = 1
)
SELECT 
  lr."Name"          AS "Package",
  lr."Version"       AS "LatestReleaseVersion",
  proj."StarsCount"
FROM latest_release lr
JOIN pvtp
  ON lr."Name" = pvtp."Name"
  AND lr."Version" = pvtp."Version"
JOIN proj
  ON pvtp."ProjectName" = proj."Name"
ORDER BY proj."StarsCount" DESC
LIMIT 20;
