```sql
--Description: 1) Look at staff IDs and the stores they work in.
SELECT DISTINCT "staff_id", "store_id"
FROM "staff"
LIMIT 20;
```

```sql
--Description: 2) Inspect a few rental rows to see the staff who created them and the rental date‑time.
SELECT "rental_id", "staff_id", "rental_date"
FROM "rental"
LIMIT 20;
```

```sql
--Description: 3) Join rental → staff to attach each rental to its store.
SELECT r."rental_id",
       r."rental_date",
       s."store_id"
FROM   "rental" AS r
JOIN   "staff"  AS s
  ON   r."staff_id" = s."staff_id"
LIMIT 20;
```

```sql
--Description: 4) Extract year and month for every rental after the join.
SELECT s."store_id",
       strftime('%Y', r."rental_date") AS "year",
       strftime('%m', r."rental_date") AS "month"
FROM   "rental" AS r
JOIN   "staff"  AS s
  ON   r."staff_id" = s."staff_id"
LIMIT 20;
```

```sql
--Description: 5) Aggregate rentals by store‑year‑month to get monthly totals.
SELECT s."store_id",
       strftime('%Y', r."rental_date") AS "year",
       strftime('%m', r."rental_date") AS "month",
       COUNT(*) AS "total_rentals"
FROM   "rental" AS r
JOIN   "staff"  AS s
  ON   r."staff_id" = s."staff_id"
GROUP  BY s."store_id",
          strftime('%Y', r."rental_date"),
          strftime('%m', r."rental_date")
LIMIT 20;
```

```sql
--Description: 6) Rank those store‑year‑month groups inside each store by total rentals (highest first).
SELECT *,
       RANK() OVER (PARTITION BY "store_id"
                    ORDER BY "total_rentals" DESC) AS "rank_in_store"
FROM (
    SELECT s."store_id",
           strftime('%Y', r."rental_date") AS "year",
           strftime('%m', r."rental_date") AS "month",
           COUNT(*) AS "total_rentals"
    FROM   "rental" AS r
    JOIN   "staff"  AS s
      ON   r."staff_id" = s."staff_id"
    GROUP  BY s."store_id",
              strftime('%Y', r."rental_date"),
              strftime('%m', r."rental_date")
) AS t
LIMIT 20;
```

```sql
--Description: 7) Filter to keep only the top‑ranked month(s) for each store (ties are kept).
SELECT "store_id", "year", "month", "total_rentals"
FROM (
    SELECT *,
           RANK() OVER (PARTITION BY "store_id"
                        ORDER BY "total_rentals" DESC) AS "rk"
    FROM (
        SELECT s."store_id",
               strftime('%Y', r."rental_date") AS "year",
               strftime('%m', r."rental_date") AS "month",
               COUNT(*) AS "total_rentals"
        FROM   "rental" AS r
        JOIN   "staff"  AS s
          ON   r."staff_id" = s."staff_id"
        GROUP  BY s."store_id",
                  strftime('%Y', r."rental_date"),
                  strftime('%m', r."rental_date")
    )
)
WHERE "rk" = 1
LIMIT 20;
```

```sql
--Description: 8) Same logic but add ORDER BY for readability (still limited).
SELECT "store_id", "year", "month", "total_rentals"
FROM (
    SELECT *,
           RANK() OVER (PARTITION BY "store_id"
                        ORDER BY "total_rentals" DESC) AS "rk"
    FROM (
        SELECT s."store_id",
               strftime('%Y', r."rental_date") AS "year",
               strftime('%m', r."rental_date") AS "month",
               COUNT(*) AS "total_rentals"
        FROM   "rental" AS r
        JOIN   "staff"  AS s
          ON   r."staff_id" = s."staff_id"
        GROUP  BY s."store_id",
                  strftime('%Y', r."rental_date"),
                  strftime('%m', r."rental_date")
    )
)
WHERE "rk" = 1
ORDER BY "store_id"
LIMIT 20;
```

```sql
--Description: 9) Final answer – no LIMIT – lists each store’s year & month with the highest number of rentals created by its staff.
SELECT "store_id",
       "year",
       "month",
       "total_rentals"
FROM (
    SELECT s."store_id",
           strftime('%Y', r."rental_date") AS "year",
           strftime('%m', r."rental_date") AS "month",
           COUNT(*) AS "total_rentals",
           RANK() OVER (PARTITION BY s."store_id"
                        ORDER BY COUNT(*) DESC) AS "rk"
    FROM   "rental" AS r
    JOIN   "staff"  AS s
      ON   r."staff_id" = s."staff_id"
    GROUP  BY s."store_id",
              strftime('%Y', r."rental_date"),
              strftime('%m', r."rental_date")
)
WHERE "rk" = 1
ORDER BY "store_id";
```

```sql
--Description: 10) If you also wanted the month name (optional):
SELECT "store_id",
       "year",
       strftime('%m', r."rental_date") AS "month_num",
       strftime('%Y-%m', r."rental_date") AS "year_month",
       COUNT(*) AS "total_rentals"
FROM   "rental" AS r
JOIN   "staff"  AS s
  ON   r."staff_id" = s."staff_id"
GROUP  BY s."store_id", strftime('%Y', r."rental_date"), strftime('%m', r."rental_date")
HAVING COUNT(*) = (
       SELECT MAX(cnt)
       FROM (
           SELECT COUNT(*) AS cnt
           FROM   "rental" AS r2
           JOIN   "staff"  AS s2
             ON   r2."staff_id" = s2."staff_id"
           WHERE  s2."store_id" = s."store_id"
           GROUP  BY strftime('%Y', r2."rental_date"), strftime('%m', r2."rental_date")
       )
)
ORDER BY "store_id";
```
