```sql
-- 2) Preview some Chinese city rows so we know what they look like
SELECT "city_id",
       "city_name",
       "insert_date",
       "population"
FROM   "cities"
WHERE  "country_code_2" = 'cn'
LIMIT 20;
```

```sql
-- 3) Check which calendar years are present for Chinese cities
SELECT DISTINCT strftime('%Y', "insert_date")  AS "year_yyyy"
FROM   "cities"
WHERE  "country_code_2" = 'cn'
ORDER BY "year_yyyy"
LIMIT 20;
```

```sql
-- 4) Fetch all 2021 Chinese city records (ordered by date) to eyeball continuity
SELECT "city_name",
       "insert_date"
FROM   "cities"
WHERE  "country_code_2" = 'cn'
  AND  "insert_date" LIKE '2021-%'
ORDER BY "insert_date"
LIMIT 20;
```

```sql
-- 5) Narrow down to July‑2021 only
SELECT "city_name",
       "insert_date"
FROM   "cities"
WHERE  "country_code_2" = 'cn'
  AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
ORDER BY "insert_date"
LIMIT 20;
```

```sql
-- 6) Count how many Chinese records exist for each July‑2021 date
SELECT "insert_date",
       COUNT(*) AS "city_row_cnt"
FROM   "cities"
WHERE  "country_code_2" = 'cn'
  AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
GROUP BY "insert_date"
ORDER BY "insert_date"
LIMIT 20;
```

```sql
-- 7) Show all DISTINCT July‑2021 dates for CN together with the previous date  
SELECT  "insert_date",
        LAG("insert_date") OVER (ORDER BY "insert_date") AS "prev_date"
FROM   ( SELECT DISTINCT "insert_date"
         FROM   "cities"
         WHERE  "country_code_2" = 'cn'
           AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31' )
ORDER BY "insert_date"
LIMIT 20;
```

```sql
-- 8) Attach a running sequence number so we can derive streak group keys
SELECT "insert_date",
       ROW_NUMBER() OVER (ORDER BY "insert_date") AS "rn"
FROM  ( SELECT DISTINCT "insert_date"
        FROM   "cities"
        WHERE  "country_code_2" = 'cn'
          AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31' )
ORDER BY "insert_date"
LIMIT 20;
```

```sql
-- 9) Combine step‑7 & step‑8 to view date differences (one day vs gaps)
SELECT  c."insert_date",
        LAG(c."insert_date") OVER (ORDER BY c."insert_date")               AS "prev_date",
        JULIANDAY(c."insert_date") - JULIANDAY(LAG(c."insert_date") OVER (ORDER BY c."insert_date")) AS "day_gap",
        ROW_NUMBER() OVER (ORDER BY c."insert_date")                       AS "rn"
FROM   ( SELECT DISTINCT "insert_date"
         FROM   "cities"
         WHERE  "country_code_2" = 'cn'
           AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31' ) c
ORDER BY c."insert_date"
LIMIT 20;
```

```sql
-- 10) (Skeleton) Once streak groups are known, pick one city row per date
--     (Capitalise city name: upper(first letter) + lower(rest))
SELECT  DATE("insert_date")                       AS "date",
        UPPER(SUBSTR("city_name",1,1))
        || LOWER(SUBSTR("city_name",2))           AS "city_name"
FROM    "cities"
WHERE   "country_code_2" = 'cn'
  AND   "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
  -- AND streak_filter_here
ORDER BY "date";
```

These 10 queries let us:
1. Verify the presence of China (“cn”).
2. Inspect Chinese city records.
3. Confirm 2021 data.
4–7. Retrieve & analyze the July‑2021 date sequence.
8–9. Work out consecutive‑date streaks.
10. Sketch the final pull (one record per date, city name properly capitalized) once we identify the specific shortest and longest streak IDs.
