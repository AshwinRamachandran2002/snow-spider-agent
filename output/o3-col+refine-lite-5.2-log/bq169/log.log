```sql
-- 6. Bring back the chromosomal details for each of the three regions
WITH hits AS (
      SELECT RefNo, CaseNo, InvNo, Clone
      FROM (
            SELECT RefNo, CaseNo, InvNo, Clone
            FROM   `mitelman-db.prod.CytoConverted`
            WHERE  ChrOrd = 13 AND Type = 'Loss'
              AND  Start <= 48303751 AND End >= 48481890
           ) AS a
      JOIN (
            SELECT RefNo, CaseNo, InvNo, Clone
            FROM   `mitelman-db.prod.CytoConverted`
            WHERE  ChrOrd = 17 AND Type = 'Loss'
              AND  Start <=  7668421 AND End >=  7687490
           ) AS b
      USING (RefNo, CaseNo, InvNo, Clone)
      JOIN (
            SELECT RefNo, CaseNo, InvNo, Clone
            FROM   `mitelman-db.prod.CytoConverted`
            WHERE  ChrOrd = 11 AND Type = 'Gain'
              AND  Start <= 108223067 AND End >= 108369102
           ) AS c
      USING (RefNo, CaseNo, InvNo, Clone)
)
SELECT h.RefNo,
       h.CaseNo,
       h.InvNo,
       h.Clone,
       cv13.ChrOrd  AS ChrOrd_13,
       cv13.Start   AS Start_13,
       cv13.End     AS End_13,
       cv17.ChrOrd  AS ChrOrd_17,
       cv17.Start   AS Start_17,
       cv17.End     AS End_17,
       cv11.ChrOrd  AS ChrOrd_11,
       cv11.Start   AS Start_11,
       cv11.End     AS End_11
FROM   hits AS h
JOIN   `mitelman-db.prod.CytoConverted` AS cv13
       ON  h.RefNo = cv13.RefNo AND h.CaseNo = cv13.CaseNo
       AND h.InvNo = cv13.InvNo AND h.Clone = cv13.Clone
       AND cv13.ChrOrd = 13 AND cv13.Type = 'Loss'
       AND cv13.Start <= 48303751 AND cv13.End >= 48481890
JOIN   `mitelman-db.prod.CytoConverted` AS cv17
       ON  h.RefNo = cv17.RefNo AND h.CaseNo = cv17.CaseNo
       AND h.InvNo = cv17.InvNo AND h.Clone = cv17.Clone
       AND cv17.ChrOrd = 17 AND cv17.Type = 'Loss'
       AND cv17.Start <=  7668421 AND cv17.End >=  7687490
JOIN   `mitelman-db.prod.CytoConverted` AS cv11
       ON  h.RefNo = cv11.RefNo AND h.CaseNo = cv11.CaseNo
       AND h.InvNo = cv11.InvNo AND h.Clone = cv11.Clone
       AND cv11.ChrOrd = 11 AND cv11.Type = 'Gain'
       AND cv11.Start <= 108223067 AND cv11.End >= 108369102
LIMIT 20;
```

```sql
-- 7. Attach the corresponding karyotype description from KaryClone
WITH regions AS (
      -- previous query without LIMIT
      SELECT h.RefNo,
             h.CaseNo,
             h.InvNo,
             h.Clone,
             cv13.ChrOrd  AS ChrOrd_13,
             cv13.Start   AS Start_13,
             cv13.End     AS End_13,
             cv17.ChrOrd  AS ChrOrd_17,
             cv17.Start   AS Start_17,
             cv17.End     AS End_17,
             cv11.ChrOrd  AS ChrOrd_11,
             cv11.Start   AS Start_11,
             cv11.End     AS End_11
      FROM (
            SELECT RefNo, CaseNo, InvNo, Clone
            FROM (
                  SELECT RefNo, CaseNo, InvNo, Clone
                  FROM   `mitelman-db.prod.CytoConverted`
                  WHERE  ChrOrd = 13 AND Type = 'Loss'
                    AND  Start <= 48303751 AND End >= 48481890
                 ) AS a
            JOIN (
                  SELECT RefNo, CaseNo, InvNo, Clone
                  FROM   `mitelman-db.prod.CytoConverted`
                  WHERE  ChrOrd = 17 AND Type = 'Loss'
                    AND  Start <=  7668421 AND End >=  7687490
                 ) AS b
            USING (RefNo, CaseNo, InvNo, Clone)
            JOIN (
                  SELECT RefNo, CaseNo, InvNo, Clone
                  FROM   `mitelman-db.prod.CytoConverted`
                  WHERE  ChrOrd = 11 AND Type = 'Gain'
                    AND  Start <= 108223067 AND End >= 108369102
                 ) AS c
            USING (RefNo, CaseNo, InvNo, Clone)
           ) AS h
      JOIN   `mitelman-db.prod.CytoConverted` AS cv13
             ON  h.RefNo=cv13.RefNo AND h.CaseNo=cv13.CaseNo
             AND h.InvNo=cv13.InvNo AND h.Clone=cv13.Clone
             AND cv13.ChrOrd=13 AND cv13.Type='Loss'
             AND cv13.Start<=48303751 AND cv13.End>=48481890
      JOIN   `mitelman-db.prod.CytoConverted` AS cv17
             ON  h.RefNo=cv17.RefNo AND h.CaseNo=cv17.CaseNo
             AND h.InvNo=cv17.InvNo AND h.Clone=cv17.Clone
             AND cv17.ChrOrd=17 AND cv17.Type='Loss'
             AND cv17.Start<=7668421 AND cv17.End>=7687490
      JOIN   `mitelman-db.prod.CytoConverted` AS cv11
             ON  h.RefNo=cv11.RefNo AND h.CaseNo=cv11.CaseNo
             AND h.InvNo=cv11.InvNo AND h.Clone=cv11.Clone
             AND cv11.ChrOrd=11 AND cv11.Type='Gain'
             AND cv11.Start<=108223067 AND cv11.End>=108369102
)
SELECT DISTINCT r.RefNo,
       r.CaseNo,
       r.InvNo,
       r.Clone          AS CloneNo,
       r.ChrOrd_13, r.Start_13, r.End_13,
       r.ChrOrd_17, r.Start_17, r.End_17,
       r.ChrOrd_11, r.Start_11, r.End_11,
       kc.CloneShort    AS KaryShort
FROM   regions AS r
LEFT JOIN `mitelman-db.prod.KaryClone` AS kc
       ON  r.RefNo  = kc.RefNo
       AND r.CaseNo = kc.CaseNo
       AND r.InvNo  = kc.InvNo
       AND r.Clone  = kc.CloneNo
LIMIT 20;
```

