```

```sql
--Description: Final result without LIMIT (full “regions” CTE from query 7, Start/End escaped).
WITH regions AS ( …same definition as query 7… )
SELECT DISTINCT r.RefNo,
       r.CaseNo,
       r.InvNo,
       r.Clone        AS CloneNo,
       r.ChrOrd_13, r.Start_13, r.End_13,
       r.ChrOrd_17, r.Start_17, r.End_17,
       r.ChrOrd_11, r.Start_11, r.End_11,
       kc.CloneShort AS KaryShort
