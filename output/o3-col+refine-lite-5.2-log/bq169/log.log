--Description:  Goal is to list every clone that meets three positional events:
--              • chr13 Loss covering 48,303,751–48,481,890
--              • chr17 Loss covering 7,668,421–7,687,490
--              • chr11 Gain covering 108,223,067–108,369,102
--  Thinking process (in‑line):
--  1. In CytoConverted the same clone can have many segments; create three
--     filtered sub‑queries (loss13, loss17, gain11) using ChrOrd, Type, and
--     coordinate overlap (Start ≤ regionStart AND End ≥ regionEnd), escaping
--     the reserved words `Start` and `End`.
--  2. Intersect those three sub‑queries on (RefNo, CaseNo, InvNo, Clone).  This
--     ensures the *same* clone exhibits all three alterations.
--  3. Join back to the sub‑queries to retrieve the exact coordinate rows for
--     each chromosome; collect them in CTE “regions”.
--  4. LEFT JOIN to KaryClone to obtain the karyotype description (CloneShort).
--  5. SELECT DISTINCT to avoid duplicates; return unlimited rows (no LIMIT).
WITH
loss13 AS (
  SELECT RefNo, CaseNo, InvNo, Clone, ChrOrd, `Start`, `End`
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 13 AND Type = 'Loss'
    AND  `Start` <= 48303751 AND `End` >= 48481890
),
loss17 AS (
  SELECT RefNo, CaseNo, InvNo, Clone, ChrOrd, `Start`, `End`
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 17 AND Type = 'Loss'
    AND  `Start` <= 7668421 AND `End` >= 7687490
),
gain11 AS (
  SELECT RefNo, CaseNo, InvNo, Clone, ChrOrd, `Start`, `End`
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 11 AND Type = 'Gain'
    AND  `Start` <= 108223067 AND `End` >= 108369102
),
hits AS (
  SELECT l13.RefNo, l13.CaseNo, l13.InvNo, l13.Clone
  FROM   loss13 l13
  JOIN   loss17 USING (RefNo, CaseNo, InvNo, Clone)
  JOIN   gain11 USING (RefNo, CaseNo, InvNo, Clone)
),
regions AS (
  SELECT h.RefNo, h.CaseNo, h.InvNo, h.Clone,
         cv13.ChrOrd AS ChrOrd_13, cv13.`Start` AS Start_13, cv13.`End` AS End_13,
