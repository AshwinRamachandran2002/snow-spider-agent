       ON r.RefNo=kc.RefNo AND r.CaseNo=kc.CaseNo
      AND r.InvNo=kc.InvNo AND r.Clone=kc.CloneNo;
```

```sql
--Description: Sanity check – every qualifying clone must have exactly three matching rows (escape Start/End).
SELECT RefNo, CaseNo, InvNo, Clone,
       COUNT(*) AS qualifying_rows
FROM   `mitelman-db.prod.CytoConverted`
WHERE ( (ChrOrd = 13 AND Type='Loss' AND `Start`<=48303751 AND `End`>=48481890)
     OR (ChrOrd = 17 AND Type='Loss' AND `Start`<=7668421  AND `End`>=7687490)
     OR (ChrOrd = 11 AND Type='Gain' AND `Start`<=108223067 AND `End`>=108369102) )
GROUP BY RefNo, CaseNo, InvNo, Clone
HAVING COUNT(*) = 3
LIMIT 20;
```

```sql
