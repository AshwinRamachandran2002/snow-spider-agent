  JOIN   loss13 cv13 ON  h.RefNo=cv13.RefNo AND h.CaseNo=cv13.CaseNo
                     AND h.InvNo=cv13.InvNo AND h.Clone=cv13.Clone
  JOIN   loss17 cv17 ON  h.RefNo=cv17.RefNo AND h.CaseNo=cv17.CaseNo
