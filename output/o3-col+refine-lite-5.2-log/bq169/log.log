```sql
--Description: Identify clones that simultaneously (i) lose chr13 48 303 751‑48 481 890,
--             (ii) lose chr17 7 668 421‑7 687 490, and (iii) gain chr11 108 223 067‑108 369 102.
-- Steps inside one query:
--   1. Three filtered sub‑sets from CytoConverted for each genomic event.
--   2. Intersect the three sub‑sets on (RefNo, CaseNo, InvNo, Clone) to get qualifying clones.
--   3. Join back to obtain region coordinates for all three events.
--   4. Attach karyotype short description from KaryClone.
WITH
loss13 AS (
  SELECT RefNo, CaseNo, InvNo, Clone, ChrOrd, `Start`, `End`
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 13 AND Type = 'Loss'
    AND  `Start` <= 48303751 AND `End` >= 48481890
),
loss17 AS (
  SELECT RefNo, CaseNo, InvNo, Clone, ChrOrd, `Start`, `End`
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 17 AND Type = 'Loss'
    AND  `Start` <= 7668421 AND `End` >= 7687490
),
gain11 AS (
  SELECT RefNo, CaseNo, InvNo, Clone, ChrOrd, `Start`, `End`
  FROM   `mitelman-db.prod.CytoConverted`
  WHERE  ChrOrd = 11 AND Type = 'Gain'
    AND  `Start` <= 108223067 AND `End` >= 108369102
),
hits AS (
  SELECT l13.RefNo, l13.CaseNo, l13.InvNo, l13.Clone
  FROM   loss13 l13
  JOIN   loss17 USING (RefNo, CaseNo, InvNo, Clone)
  JOIN   gain11 USING (RefNo, CaseNo, InvNo, Clone)
)
SELECT h.RefNo,
       h.CaseNo,
       h.InvNo,
       h.Clone                 AS CloneNo,
       l13.ChrOrd              AS ChrOrd_13,
       l13.`Start`             AS Start_13,
       l13.`End`               AS End_13,
       l17.ChrOrd              AS ChrOrd_17,
       l17.`Start`             AS Start_17,
       l17.`End`               AS End_17,
       g11.ChrOrd              AS ChrOrd_11,
       g11.`Start`             AS Start_11,
       g11.`End`               AS End_11,
       kc.CloneShort           AS KaryShort
FROM   hits h
JOIN   loss13 l13 ON h.RefNo = l13.RefNo AND h.CaseNo = l13.CaseNo AND h.InvNo = l13.InvNo AND h.Clone = l13.Clone
JOIN   loss17 l17 ON h.RefNo = l17.RefNo AND h.CaseNo = l17.CaseNo AND h.InvNo = l17.InvNo AND h.Clone = l17.Clone
JOIN   gain11 g11 ON h.RefNo = g11.RefNo AND h.CaseNo = g11.CaseNo AND h.InvNo = g11.InvNo AND h.Clone = g11.Clone
LEFT  JOIN `mitelman-db.prod.KaryClone` kc
       ON h.RefNo  = kc.RefNo
      AND h.CaseNo = kc.CaseNo
      AND h.InvNo  = kc.InvNo
      AND h.Clone  = kc.CloneNo;
