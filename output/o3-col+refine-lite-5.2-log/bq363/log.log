                SELECT ROUND(trip_seconds/60.0,0) AS rounded_min
                     , fare
                FROM   `bigquery-public-data.chicago_taxi_trips.taxi_trips`
                WHERE  trip_seconds BETWEEN 60 AND 3000   -- keep 1‑50 minute trips
              )
      )
GROUP BY decile
ORDER BY MIN(rounded_min);
