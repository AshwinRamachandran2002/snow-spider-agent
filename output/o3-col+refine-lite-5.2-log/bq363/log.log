Query:
--Description: 9.  FINAL ANSWER – total trips and average fare (to two decimals) for
--              each equal‑sized duration quantile.  Time range values are cast to
--              INT64 for safe use with FORMAT, and the result is sorted
--              chronologically by the lower bound of each bucket.
SELECT
  FORMAT('%02dm to %02dm',
         CAST(MIN(rounded_min) AS INT64),
         CAST(MAX(rounded_min) AS INT64))      AS time_range,
  COUNT(*)                                     AS total_trips,
  FORMAT('%.2f', AVG(fare))                    AS average_fare
FROM (
  SELECT
    NTILE(10) OVER (ORDER BY rounded_min) AS decile,
    rounded_min,
    fare
  FROM (
    SELECT
      ROUND(trip_seconds / 60.0, 0) AS rounded_min,
      fare
    FROM
      `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE
      trip_seconds BETWEEN 60 AND 3000   -- keep 1–50‑minute trips
  )
)
GROUP BY
  decile
ORDER BY
  CAST(MIN(rounded_min) AS INT64)
