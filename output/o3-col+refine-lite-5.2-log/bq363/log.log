--             Finally, results are ordered chronologically by the lower bound
--             of the duration range.
SELECT
  FORMAT('%02dm to %02dm',
         MIN(rounded_min),
         MAX(rounded_min))                 AS time_range,
  COUNT(*)                                 AS total_trips,
  FORMAT('%.2f', AVG(fare))               AS average_fare
FROM (
  SELECT
