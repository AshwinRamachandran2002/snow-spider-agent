--Description: 8.  Create min / max minute and formatted range for each NTILE bucket
--              (preview – limited to first 20 rows).  MIN/MAX minute values are
--              cast to INT64 before passing to FORMAT to avoid type‑mismatch errors.
SELECT
  decile,
  FORMAT('%02dm to %02dm',
         CAST(MIN(rounded_min) AS INT64),
         CAST(MAX(rounded_min) AS INT64))      AS time_range,
  COUNT(*)                                     AS trips,
  ROUND(AVG(fare), 2)                          AS avg_fare
FROM (
  SELECT
    NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0, 0)) AS decile,
    ROUND(trip_seconds / 60.0, 0)                           AS rounded_min,
    fare
  FROM
    `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE
    trip_seconds BETWEEN 60 AND 3000
)
GROUP BY
  decile
ORDER BY
  decile
LIMIT 20
