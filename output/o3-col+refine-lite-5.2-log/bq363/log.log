```sql
--Description: We need trip‑duration deciles and, for each decile, the total
--             number of trips plus the average fare, along with a readable
--             “XXm to XXm” range.  Because NTILE is an analytic function that
--             can’t be used directly in GROUP BY, we:
--               1.  Convert every trip lasting 1–50 minutes (60‑3000 s) to
--                   rounded whole‑minute values (rounded_min).
--               2.  Apply NTILE(10) over those rounded minutes to assign each
--                   trip to one of ten equal‑sized duration buckets.
--               3.  Aggregate by the bucket (decile) to compute:
--                     • MIN & MAX rounded_min  → range bounds,
--                     • COUNT(*)               → total trips,
--                     • AVG(fare)              → mean fare.
--               4.  Cast the bounds to INT64 so FORMAT can build a zero‑padded
--                   string “XXm to XXm”.  Finally, order chronologically by the
--                   lower‑bound minute.
SELECT
  FORMAT('%02dm to %02dm',
         CAST(MIN(rounded_min) AS INT64),
         CAST(MAX(rounded_min) AS INT64))     AS time_range,
  COUNT(*)                                     AS total_trips,
  FORMAT('%.2f', AVG(fare))                    AS average_fare
FROM (
  SELECT
    NTILE(10) OVER (ORDER BY rounded_min) AS decile,
    rounded_min,
    fare
  FROM (
    SELECT
      ROUND(trip_seconds / 60.0, 0) AS rounded_min,
      fare
    FROM
      `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE
      trip_seconds BETWEEN 60 AND 3000         -- keep 1‑50 minute trips
  )
)
GROUP BY
  decile
ORDER BY
  CAST(MIN(rounded_min) AS INT64);
```
