```sql
--Description:
-- THINKING PROCESS INSIDE THIS ONE QUERY
-- A.  Build the list of cohort start Mondays: 2018‑07‑09 … 2018‑09‑17 (inclusive).
-- B.  “Cohort users” = users whose VERY FIRST session_start happens within the
--     Monday‑to‑Sunday window that begins on each Monday.
--     • event_name = 'session_start'
--     • event_date (STRING 'YYYYMMDD') converted to DATE must be within that week
--     • event_date must equal the formatted user_first_touch_timestamp (so first visit)
--     Wild‑card table filter (_TABLE_SUFFIX) is also limited to the same week to
--     minimise scanned data.
-- C.  “Week‑2 returners” = those cohort users having another session_start
--     14‑20 days after the cohort Monday (inclusive).  Again we narrow
--     _TABLE_SUFFIX to that 14‑20‑day span for efficiency.
-- D.  Aggregate per cohort:
--     cohort_size (#unique users), week2_active (#unique users returned),
--     week2_retention_rate = week2_active / cohort_size (SAFE_DIVIDE avoids ÷0).
WITH
/* A ─── Mondays list ────────────────────────────────────────────────────────── */
mondays AS (
  SELECT DATE '2018-07-09' + INTERVAL wk WEEK AS cohort_date
  FROM   UNNEST(GENERATE_ARRAY(0, 10)) AS wk      -- 0‑10 → 11 Mondays
),
/* B ─── Users whose first session is in that Monday‑Sunday window ──────────── */
cohort_users AS (
  SELECT m.cohort_date,
         e.user_pseudo_id
  FROM   mondays AS m
  JOIN   `firebase-public-project.analytics_153293282.events_*` AS e
  ON     TRUE                                    -- reduced by WHERE clauses below
  WHERE  e.event_name = 'session_start'
    AND  PARSE_DATE('%Y%m%d', e.event_date)
           BETWEEN m.cohort_date
               AND m.cohort_date + INTERVAL 6 DAY   -- Monday‑Sunday
    AND  e.event_date = FORMAT_DATE(                -- ensure first‑ever session
           '%Y%m%d',
           DATE(TIMESTAMP_MICROS(e.user_first_touch_timestamp))
         )
    AND  _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', m.cohort_date)
                          AND FORMAT_DATE('%Y%m%d', m.cohort_date + INTERVAL 6 DAY)
  GROUP BY m.cohort_date, e.user_pseudo_id        -- DISTINCT list of cohort users
),
/* C ─── Among those users, who comes back in days 14‑20? ───────────────────── */
week2_returners AS (
  SELECT cu.cohort_date,
         cu.user_pseudo_id
  FROM   cohort_users AS cu
  JOIN   `firebase-public-project.analytics_153293282.events_*` AS e
       ON cu.user_pseudo_id = e.user_pseudo_id
  WHERE  e.event_name = 'session_start'
    AND  PARSE_DATE('%Y%m%d', e.event_date)
           BETWEEN cu.cohort_date + INTERVAL 14 DAY
               AND cu.cohort_date + INTERVAL 20 DAY
    AND  _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', cu.cohort_date + INTERVAL 14 DAY)
                          AND FORMAT_DATE('%Y%m%d', cu.cohort_date + INTERVAL 20 DAY)
  GROUP BY cu.cohort_date, cu.user_pseudo_id
)
/* D ─── Final summarisation ────────────────────────────────────────────────── */
SELECT FORMAT_DATE('%Y-%m-%d', c.cohort_date)                AS cohort_week,
       COUNT(DISTINCT c.user_pseudo_id)                      AS cohort_size,
       COUNT(DISTINCT w.user_pseudo_id)                      AS week2_active,
       SAFE_DIVIDE(COUNT(DISTINCT w.user_pseudo_id),
                   COUNT(DISTINCT c.user_pseudo_id))         AS week2_retention_rate
FROM   cohort_users AS c
LEFT JOIN week2_returners AS w
       ON c.cohort_date = w.cohort_date
GROUP  BY cohort_week, c.cohort_date
ORDER  BY c.cohort_date;
```
