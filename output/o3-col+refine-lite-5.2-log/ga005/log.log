Query:
--Description: 9) Inspect the 2018‑08‑13 cohort and label users who did / did not return in Week‑2.
WITH c AS (                                                       -- cohort users (Mon‑Sun 13‑Aug‑18 week)
  SELECT DISTINCT user_pseudo_id
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  event_name = 'session_start'
    AND  PARSE_DATE('%Y%m%d', event_date)                        -- event in 13‑Aug‑18 … 19‑Aug‑18
           BETWEEN DATE '2018-08-13' AND DATE '2018-08-19'
    AND  event_date = FORMAT_DATE(                               -- first‑ever touch that same day
           '%Y%m%d',
           DATE(TIMESTAMP_MICROS(user_first_touch_timestamp))
         )
    AND  _TABLE_SUFFIX BETWEEN '20180813' AND '20180819'         -- limit scanned partitions
),
w2 AS (                                                           -- same users returning 14‑20 days later
  SELECT DISTINCT user_pseudo_id
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  event_name = 'session_start'
    AND  PARSE_DATE('%Y%m%d', event_date)
           BETWEEN DATE '2018-08-27' AND DATE '2018-09-02'
    AND  _TABLE_SUFFIX BETWEEN '20180827' AND '20180902'
)
SELECT user_pseudo_id,
       IF(user_pseudo_id IN (SELECT user_pseudo_id FROM w2),
          'returned_week2',
          'no_return') AS status
FROM   c
LIMIT  20
