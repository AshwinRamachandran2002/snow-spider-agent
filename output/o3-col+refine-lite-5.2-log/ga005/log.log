```sql
--Description: 8) FINAL ANSWER – Weekly cohorts (Mon‑start) & Week‑2 retention
--            for cohorts 2018‑07‑09 … 2018‑09‑17.
WITH mondays AS (
  SELECT DATE '2018-07-09' + INTERVAL wk WEEK AS cohort_date
  FROM   UNNEST(GENERATE_ARRAY(0, 10)) AS wk          -- 11 cohorts
), cohort_users AS (
  -- all new users of each Monday‑to‑Sunday week
  SELECT m.cohort_date,
         e.user_pseudo_id
  FROM   mondays AS m
  JOIN   `firebase-public-project.analytics_153293282.events_*` AS e
  ON     TRUE
  WHERE  e.event_name = 'session_start'
    AND  DATE(e.event_date, 'UTC') 
          BETWEEN m.cohort_date                     -- Monday
          AND     m.cohort_date + INTERVAL 6 DAY   -- Sunday
    AND  e.event_date = FORMAT_DATE('%Y%m%d',
           DATE(TIMESTAMP_MICROS(e.user_first_touch_timestamp)))
    AND  _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d',m.cohort_date)
                            AND FORMAT_DATE('%Y%m%d',m.cohort_date+INTERVAL 6 DAY)
  GROUP  BY m.cohort_date, e.user_pseudo_id
), week2_return AS (
  -- those users having another session_start in days 14‑20
  SELECT cu.cohort_date,
         cu.user_pseudo_id
  FROM   cohort_users AS cu
  JOIN   `firebase-public-project.analytics_153293282.events_*` AS e
  ON     cu.user_pseudo_id = e.user_pseudo_id
  WHERE  e.event_name = 'session_start'
    AND  DATE(e.event_date, 'UTC')
         BETWEEN cu.cohort_date + INTERVAL 14 DAY
                 AND cu.cohort_date + INTERVAL 20 DAY
    AND  _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d',cu.cohort_date+INTERVAL 14 DAY)
                            AND FORMAT_DATE('%Y%m%d',cu.cohort_date+INTERVAL 20 DAY)
  GROUP  BY cu.cohort_date, cu.user_pseudo_id
)
SELECT  FORMAT_DATE('%Y-%m-%d', c.cohort_date)              AS cohort_week,
        COUNT(DISTINCT c.user_pseudo_id)                    AS cohort_size,
        COUNT(DISTINCT w.user_pseudo_id)                    AS week2_active,
        SAFE_DIVIDE(COUNT(DISTINCT w.user_pseudo_id),
                    COUNT(DISTINCT c.user_pseudo_id))       AS week2_retention_rate
FROM    cohort_users AS c
LEFT JOIN week2_return AS w
       ON c.cohort_date = w.cohort_date
GROUP   BY cohort_week, c.cohort_date
ORDER   BY c.cohort_date
LIMIT   20;
```

