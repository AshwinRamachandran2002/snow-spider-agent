FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
       ON oi."product_id" = p."id"
GROUP  BY p."category"
ORDER  BY "total_purchased_items" DESC
LIMIT  20;
```

```sql
--Description: Inspect all different kinds of events captured in the EVENTS table
SELECT DISTINCT 
       "event_type"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
LIMIT  20;
```

```sql
--Description: Look at sample events whose URI seems to point to a product page
SELECT "session_id",
       "created_at",
       "event_type",
       "uri"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
WHERE  "uri" ILIKE '%product%'
LIMIT  20;
```

```sql
--Description: Pick one session and show every event inside that session ordered by timestamp
SELECT "session_id",
       "sequence_number",
       "created_at",
       "uri",
       "event_type"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
WHERE  "session_id" = (
        SELECT "session_id"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
        WHERE  "uri" ILIKE '%product%'
        LIMIT  1
       )
ORDER  BY "created_at"
LIMIT  20;
```

```sql
--Description: Calculate the time difference between consecutive events inside each session 
--             (this is the basis for page‑view dwell time)
SELECT "session_id",
       "created_at",
       "uri",
       "event_type",
       LAG("created_at")  OVER (PARTITION BY "session_id" ORDER BY "created_at") AS "prev_event_ts",
       ("created_at" - LAG("created_at") OVER (PARTITION BY "session_id" ORDER BY "created_at")) AS "time_diff_microsec"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
WHERE  "uri" ILIKE '%product%'
LIMIT  20;
```

```sql
--Description: Derive dwell‑time in minutes for each product‑page view event
SELECT "session_id",
       "uri",
       ("created_at" - LAG("created_at") OVER (PARTITION BY "session_id" ORDER BY "created_at")) / 60000000.0 
           AS "minutes_on_page"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
WHERE  "uri" ILIKE '%product%'
LIMIT  20;
```

```sql
--Description: Identify the single category with the highest overall purchase quantity
SELECT p."category"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
    ON oi."product_id" = p."id"
GROUP  BY p."category"
ORDER  BY COUNT(*) DESC
LIMIT  1;
```

```sql
--Description: Compute the average minutes spent on each product‑page visit for the top‑selling category
WITH top_cat AS (
    SELECT p."category"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
          ON oi."product_id" = p."id"
    GROUP  BY p."category"
    ORDER  BY COUNT(*) DESC
    LIMIT  1
),
product_pages AS (
    SELECT e."session_id",
           e."created_at",
           e."uri",
           LAG(e."created_at") OVER (PARTITION BY e."session_id" ORDER BY e."created_at") AS "prev_ts"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS" e
    WHERE  e."uri" ILIKE '%product%'
),
dwell AS (
    SELECT pp.*,
           (pp."created_at" - pp."prev_ts") / 60000000.0 AS "minutes_on_page"
    FROM   product_pages pp
    WHERE  pp."prev_ts" IS NOT NULL
),
tie_back_to_product AS (
    SELECT d."minutes_on_page",
           p."category"
    FROM   dwell d
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
         ON d."uri" ILIKE '%' || p."sku" || '%'   -- fuzzy tie‑back via SKU in the URL
)
SELECT AVG("minutes_on_page") AS "avg_minutes_on_page"
FROM   tie_back_to_product
WHERE  "category" = (SELECT "category" FROM top_cat)
LIMIT  20;
```
