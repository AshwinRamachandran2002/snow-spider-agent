Query:
--Description: Compute the average minutes spent on each product‑page visit for the top‑selling category
WITH top_cat AS (
    SELECT p."category"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
          ON oi."product_id" = p."id"
    GROUP  BY p."category"
    ORDER  BY COUNT(*) DESC
    LIMIT  1
),
product_pages AS (
    SELECT e."session_id",
           e."created_at",
           e."uri",
           LAG(e."created_at") OVER (PARTITION BY e."session_id" ORDER BY e."created_at") AS "prev_ts"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS" e
    WHERE  e."uri" ILIKE '%product%'
),
dwell AS (
    SELECT pp.*,
           (pp."created_at" - pp."prev_ts") / 60000000.0 AS "minutes_on_page"
    FROM   product_pages pp
    WHERE  pp."prev_ts" IS NOT NULL
),
tie_back_to_product AS (
    SELECT d."minutes_on_page",
           p."category"
    FROM   dwell d
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
         ON d."uri" ILIKE '%' || p."sku" || '%'   -- fuzzy tie‑back via SKU in the URL
)
SELECT AVG("minutes_on_page") AS "avg_minutes_on_page"
FROM   tie_back_to_product
WHERE  "category" = (SELECT "category" FROM top_cat)
LIMIT  20;
