```sql
--Description: Preview a few rows from the director‑movie relation.
SELECT *
FROM director_mapping
LIMIT 20;
```

```sql
--Description: Retrieve distinct director IDs together with their names.
SELECT DISTINCT dm.name_id, n.name
FROM director_mapping AS dm
JOIN names AS n ON n.id = dm.name_id
LIMIT 20;
```

```sql
--Description: Count how many movies each director has in the data set.
SELECT dm.name_id,
       COUNT(DISTINCT dm.movie_id) AS movie_cnt
FROM director_mapping AS dm
GROUP BY dm.name_id
ORDER BY movie_cnt DESC
LIMIT 20;
```

```sql
--Description: Show the top 20 directors by movie count together with their names.
SELECT n.id            AS director_id,
       n.name,
       COUNT(DISTINCT dm.movie_id) AS movie_cnt
FROM director_mapping AS dm
JOIN names AS n ON n.id = dm.name_id
GROUP BY n.id, n.name
ORDER BY movie_cnt DESC
LIMIT 20;
```

```sql
--Description: Combine directors with their movies and ratings to inspect how data lines up.
SELECT dm.name_id,
       m.id      AS movie_id,
       m.duration,
       r.avg_rating,
       r.total_votes
FROM director_mapping AS dm
JOIN movies  AS m ON m.id = dm.movie_id
JOIN ratings AS r ON r.movie_id = m.id
LIMIT 20;
```

```sql
--Description: Aggregate movie duration and rating statistics for every director (rounded where requested).
SELECT dm.name_id                                               AS director_id,
       n.name,
       COUNT(DISTINCT dm.movie_id)                              AS movie_cnt,
       ROUND(AVG(m.duration))                                   AS avg_duration,
       ROUND(AVG(r.avg_rating), 2)                              AS avg_rating,
       SUM(r.total_votes)                                       AS total_votes,
       MIN(r.avg_rating)                                        AS min_rating,
       MAX(r.avg_rating)                                        AS max_rating,
       SUM(m.duration)                                          AS total_duration
FROM director_mapping AS dm
JOIN movies  AS m ON m.id = dm.movie_id
JOIN ratings AS r ON r.movie_id = m.id
JOIN names   AS n ON n.id = dm.name_id
GROUP BY dm.name_id, n.name
LIMIT 20;
```

```sql
--Description: Final answer – top 9 directors sorted by movie count (desc) then total movie duration (desc).
SELECT dm.name_id                                               AS director_id,
       n.name,
       COUNT(DISTINCT dm.movie_id)                              AS movie_cnt,
       ROUND(AVG(m.duration))                                   AS avg_duration,
       ROUND(AVG(r.avg_rating), 2)                              AS avg_rating,
       SUM(r.total_votes)                                       AS total_votes,
       MIN(r.avg_rating)                                        AS min_rating,
       MAX(r.avg_rating)                                        AS max_rating,
       SUM(m.duration)                                          AS total_duration
FROM director_mapping AS dm
JOIN movies  AS m ON m.id = dm.movie_id
JOIN ratings AS r ON r.movie_id = m.id
JOIN names   AS n ON n.id = dm.name_id
GROUP BY dm.name_id, n.name
ORDER BY movie_cnt DESC,
         total_duration DESC
LIMIT 9;
```
