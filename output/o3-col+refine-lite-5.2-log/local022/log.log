```sql
--Description: ❶ Inspect a few striker‑ids and the associated player names that appear in ball_by_ball
SELECT DISTINCT b."striker" AS player_id ,
       p."player_name"
FROM   "ball_by_ball" AS b
JOIN   "player"       AS p ON p."player_id" = b."striker"
LIMIT 20;
```

```sql
--Description: ❷ Combine every delivery with the runs scored by the striker on that very ball
SELECT b."match_id",
       b."over_id",
       b."ball_id",
       p."player_name",
       s."runs_scored"
FROM   "ball_by_ball"   AS b
JOIN   "batsman_scored" AS s
       ON  s."match_id"   = b."match_id"
       AND s."over_id"    = b."over_id"
       AND s."ball_id"    = b."ball_id"
       AND s."innings_no" = b."innings_no"
JOIN   "player"         AS p ON p."player_id" = b."striker"
LIMIT 20;
```

```sql
--Description: ❸ Compute total runs each striker scores in a match
SELECT b."match_id",
       b."striker"              AS player_id,
       SUM(s."runs_scored")     AS total_runs
FROM   "ball_by_ball"   AS b
JOIN   "batsman_scored" AS s
       ON  s."match_id"   = b."match_id"
       AND s."over_id"    = b."over_id"
       AND s."ball_id"    = b."ball_id"
       AND s."innings_no" = b."innings_no"
GROUP  BY b."match_id", b."striker"
LIMIT 20;
```

```sql
--Description: ❹ Restrict the above result to innings of 100+ runs (centuries)
SELECT t."match_id",
       t."player_id",
       t."total_runs"
FROM  (
        SELECT b."match_id",
               b."striker"          AS player_id,
               SUM(s."runs_scored") AS total_runs
        FROM   "ball_by_ball"   AS b
        JOIN   "batsman_scored" AS s
               ON  s."match_id"   = b."match_id"
               AND s."over_id"    = b."over_id"
               AND s."ball_id"    = b."ball_id"
               AND s."innings_no" = b."innings_no"
        GROUP BY b."match_id", b."striker"
      ) AS t
WHERE  t."total_runs" >= 100
LIMIT 20;
```

```sql
--Description: ❺ Attach the batting team to every 100+ effort
SELECT t."match_id",
       t."player_id",
       b."team_batting"  AS team_id,
       t."total_runs"
FROM (
       SELECT b."match_id",
              b."striker"          AS player_id,
              SUM(s."runs_scored") AS total_runs
       FROM   "ball_by_ball"   AS b
       JOIN   "batsman_scored" AS s
              ON  s."match_id"   = b."match_id"
              AND s."over_id"    = b."over_id"
              AND s."ball_id"    = b."ball_id"
              AND s."innings_no" = b."innings_no"
       GROUP BY b."match_id", b."striker"
     ) AS t
JOIN "ball_by_ball" AS b            -- one row is enough to fetch team_batting
     ON b."match_id" = t."match_id"
    AND b."striker"  = t."player_id"
WHERE t."total_runs" >= 100
LIMIT 20;
```

```sql
--Description: ❻ Add the winner of each match to see which side finally prevailed
SELECT c."match_id",
       c."player_id",
       c."team_id"      AS batting_team,
       m."match_winner" AS winner_team,
       c."total_runs"
FROM (
       SELECT b."match_id",
              b."striker"          AS player_id,
              b."team_batting"     AS team_id,
              SUM(s."runs_scored") AS total_runs
       FROM   "ball_by_ball"   AS b
       JOIN   "batsman_scored" AS s
              ON  s."match_id"   = b."match_id"
              AND s."over_id"    = b."over_id"
              AND s."ball_id"    = b."ball_id"
              AND s."innings_no" = b."innings_no"
       GROUP BY b."match_id", b."striker", b."team_batting"
     ) AS c
JOIN "match" AS m ON m."match_id" = c."match_id"
WHERE c."total_runs" >= 100
LIMIT 20;
```

```sql
--Description: ❼ Isolate centurions whose team was *not* the winner (i.e., they lost)
SELECT c."match_id",
       c."player_id",
       c."team_id"     AS losing_team,
       c."total_runs"
FROM (
       SELECT b."match_id",
              b."striker"          AS player_id,
              b."team_batting"     AS team_id,
              SUM(s."runs_scored") AS total_runs
       FROM   "ball_by_ball"   AS b
       JOIN   "batsman_scored" AS s
              ON  s."match_id"   = b."match_id"
              AND s."over_id"    = b."over_id"
              AND s."ball_id"    = b."ball_id"
              AND s."innings_no" = b."innings_no"
       GROUP BY b."match_id", b."striker", b."team_batting"
     ) AS c
JOIN "match" AS m ON m."match_id" = c."match_id"
WHERE c."total_runs"   >= 100
  AND m."match_winner" IS NOT NULL
  AND c."team_id"      <> m."match_winner"
LIMIT 20;
```

```sql
--Description: ❽ Attach player names to the above losing‑team centuries
SELECT t."match_id",
       p."player_name",
       t."total_runs"
FROM (
       SELECT c."match_id",
              c."player_id",
              c."total_runs"
       FROM (
              SELECT b."match_id",
                     b."striker"          AS player_id,
                     b."team_batting"     AS team_id,
                     SUM(s."runs_scored") AS total_runs
              FROM   "ball_by_ball"   AS b
              JOIN   "batsman_scored" AS s
                     ON  s."match_id"   = b."match_id"
                     AND s."over_id"    = b."over_id"
                     AND s."ball_id"    = b."ball_id"
                     AND s."innings_no" = b."innings_no"
              GROUP BY b."match_id", b."striker", b."team_batting"
            ) AS c
       JOIN "match" AS m ON m."match_id" = c."match_id"
       WHERE c."total_runs"   >= 100
         AND m."match_winner" IS NOT NULL
         AND c."team_id"      <> m."match_winner"
     ) AS t
JOIN "player" AS p ON p."player_id" = t."player_id"
LIMIT 20;
```

```sql
--Description: ❾ Retrieve the DISTINCT names of players who scored ≥100 in a match their team went on to lose
SELECT DISTINCT p."player_name"
FROM (
       SELECT b."match_id",
              b."striker"          AS player_id,
              b."team_batting"     AS team_id,
              SUM(s."runs_scored") AS total_runs
       FROM   "ball_by_ball"   AS b
       JOIN   "batsman_scored" AS s
              ON  s."match_id"   = b."match_id"
              AND s."over_id"    = b."over_id"
              AND s."ball_id"    = b."ball_id"
              AND s."innings_no" = b."innings_no"
       GROUP BY b."match_id", b."striker", b."team_batting"
       HAVING SUM(s."runs_scored") >= 100
     ) AS c
JOIN "match" AS m ON m."match_id" = c."match_id"
JOIN "player" AS p ON p."player_id" = c."player_id"
WHERE m."match_winner" IS NOT NULL
  AND c."team_id"      <> m."match_winner"
LIMIT 20;
```

