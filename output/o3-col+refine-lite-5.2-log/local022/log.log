--Description: ❻ Add the winner of each match to see which side finally prevailed
SELECT c."match_id",
       c."player_id",
       c."team_id"      AS batting_team,
       m."match_winner" AS winner_team,
       c."total_runs"
FROM (
       SELECT b."match_id",
              b."striker"          AS player_id,
              b."team_batting"     AS team_id,
              SUM(s."runs_scored") AS total_runs
       FROM   "ball_by_ball"   AS b
       JOIN   "batsman_scored" AS s
              ON  s."match_id"   = b."match_id"
              AND s."over_id"    = b."over_id"
              AND s."ball_id"    = b."ball_id"
              AND s."innings_no" = b."innings_no"
       GROUP BY b."match_id", b."striker", b."team_batting"
     ) AS c
JOIN "match" AS m ON m."match_id" = c."match_id"
WHERE c."total_runs" >= 100
LIMIT 20;
