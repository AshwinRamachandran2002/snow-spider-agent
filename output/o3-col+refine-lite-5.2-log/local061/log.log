```sql
-- 6. Description: Sample sales rows in 2019 for French customers, valid channels & promos
SELECT s.*, t.calendar_year, t.calendar_month_number
FROM   sales      AS s
JOIN   customers  AS c  ON s.cust_id  = c.cust_id
JOIN   countries  AS co ON c.country_id = co.country_id
JOIN   promotions AS p  ON s.promo_id = p.promo_id
JOIN   channels   AS ch ON s.channel_id = ch.channel_id
JOIN   times      AS t  ON s.time_id   = t.time_id
WHERE  co.country_name = 'France'
  AND  p.promo_total_id = 1
  AND  ch.channel_total_id = 1
  AND  t.calendar_year = 2019
LIMIT 20;
```

```sql
-- 7. Description: Sample sales rows in 2020 with the same French / promo / channel filters
SELECT s.*, t.calendar_year, t.calendar_month_number
FROM   sales      AS s
JOIN   customers  AS c  ON s.cust_id  = c.cust_id
JOIN   countries  AS co ON c.country_id = co.country_id
JOIN   promotions AS p  ON s.promo_id = p.promo_id
JOIN   channels   AS ch ON s.channel_id = ch.channel_id
JOIN   times      AS t  ON s.time_id   = t.time_id
WHERE  co.country_name = 'France'
  AND  p.promo_total_id = 1
  AND  ch.channel_total_id = 1
  AND  t.calendar_year = 2020
LIMIT 20;
```

```sql
-- 8. Description: Aggregate 2019 monthly sales per product for France (promo_total_id=1, channel_total_id=1)
SELECT s.prod_id,
       t.calendar_month_number AS month,
       SUM(s.amount_sold)      AS sales_2019
FROM   sales      AS s
JOIN   customers  AS c  ON s.cust_id     = c.cust_id
JOIN   countries  AS co ON c.country_id  = co.country_id
JOIN   promotions AS p  ON s.promo_id    = p.promo_id
JOIN   channels   AS ch ON s.channel_id  = ch.channel_id
JOIN   times      AS t  ON s.time_id     = t.time_id
WHERE  co.country_name = 'France'
  AND  p.promo_total_id = 1
  AND  ch.channel_total_id = 1
  AND  t.calendar_year = 2019
GROUP BY s.prod_id, t.calendar_month_number
LIMIT 20;
```

```sql
-- 9. Description: Aggregate 2020 monthly sales per product for the same filters
SELECT s.prod_id,
       t.calendar_month_number AS month,
       SUM(s.amount_sold)      AS sales_2020
FROM   sales      AS s
JOIN   customers  AS c  ON s.cust_id     = c.cust_id
JOIN   countries  AS co ON c.country_id  = co.country_id
JOIN   promotions AS p  ON s.promo_id    = p.promo_id
JOIN   channels   AS ch ON s.channel_id  = ch.channel_id
JOIN   times      AS t  ON s.time_id     = t.time_id
WHERE  co.country_name = 'France'
  AND  p.promo_total_id = 1
  AND  ch.channel_total_id = 1
  AND  t.calendar_year = 2020
GROUP BY s.prod_id, t.calendar_month_number
LIMIT 20;
```

```sql
-- 10. Description:  Final query – project 2021 sales, convert to USD, and take the monthly average
WITH fr_2019 AS (
    SELECT s.prod_id,
           t.calendar_month_number AS month,
           SUM(s.amount_sold)      AS sales_2019
    FROM   sales s
    JOIN   customers  c  ON s.cust_id = c.cust_id
    JOIN   countries  co ON c.country_id = co.country_id
    JOIN   promotions p  ON s.promo_id = p.promo_id
    JOIN   channels   ch ON s.channel_id = ch.channel_id
    JOIN   times      t  ON s.time_id = t.time_id
    WHERE  co.country_name = 'France'
      AND  p.promo_total_id = 1
      AND  ch.channel_total_id = 1
      AND  t.calendar_year = 2019
    GROUP BY s.prod_id, t.calendar_month_number
),
fr_2020 AS (
    SELECT s.prod_id,
           t.calendar_month_number AS month,
           SUM(s.amount_sold)      AS sales_2020
    FROM   sales s
    JOIN   customers  c  ON s.cust_id = c.cust_id
    JOIN   countries  co ON c.country_id = co.country_id
    JOIN   promotions p  ON s.promo_id = p.promo_id
    JOIN   channels   ch ON s.channel_id = ch.channel_id
    JOIN   times      t  ON s.time_id = t.time_id
    WHERE  co.country_name = 'France'
      AND  p.promo_total_id = 1
      AND  ch.channel_total_id = 1
      AND  t.calendar_year = 2020
    GROUP BY s.prod_id, t.calendar_month_number
),
growth AS (
    SELECT a.prod_id,
           a.month,
           a.sales_2019,
           b.sales_2020,
           CASE 
               WHEN a.sales_2019 > 0 
               THEN (b.sales_2020 - a.sales_2019)*1.0 / a.sales_2019
               ELSE NULL
           END AS growth_rate
    FROM fr_2019 a
    JOIN fr_2020 b
      ON a.prod_id = b.prod_id
     AND a.month   = b.month
),
proj_2021 AS (
    SELECT prod_id,
           month,
           sales_2020 * (1 + growth_rate) AS projected_sales_2021   -- apply 19→20 growth to 2020
    FROM   growth
    WHERE  growth_rate IS NOT NULL
),
usd_rate AS (
    SELECT month,
           MAX(to_us) AS to_us                      -- one row per month for France 2021
    FROM   currency
    WHERE  country = 'France'
      AND  year    = 2021
    GROUP BY month
)
SELECT u.month,
       ROUND(AVG(p.projected_sales_2021 * u.to_us), 2) AS avg_projected_sales_usd
FROM   proj_2021 p
JOIN   usd_rate  u ON p.month = u.month
GROUP BY u.month
ORDER BY u.month;
```
