        month,
        MAX(to_us) AS to_us               -- one row per month for France‑2021
    FROM currency
    WHERE country = 'France'
      AND year    = 2021
    GROUP BY month
)
SELECT
    u.month,
    ROUND(AVG(p.projected_sales_2021 * u.to_us), 2) AS avg_projected_sales_usd
FROM proj_2021 AS p
JOIN usd_rate  AS u ON p.month = u.month
GROUP BY u.month
ORDER BY u.month;
