       pv."Name",
       pv."Version",
       f.value::STRING AS "License"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
     LATERAL FLATTEN(INPUT => PARSE_JSON(pv."Licenses")) f
LIMIT 20;
```

```sql
--Description: Count how many times every license appears per system (top‑20 rows).
SELECT pv."System",
       f.value::STRING AS "License",
       COUNT(*)        AS "PkgCount"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
     LATERAL FLATTEN(INPUT => PARSE_JSON(pv."Licenses")) f
GROUP BY pv."System", f.value
ORDER BY pv."System", "PkgCount" DESC
LIMIT 20;
```

```sql
--Description: Retrieve the most frequent license within each system using ROW_NUMBER().
SELECT "System",
       "License",
       "PkgCount"
FROM (
    SELECT pv."System",
           f.value::STRING AS "License",
           COUNT(*)        AS "PkgCount",
           ROW_NUMBER() OVER (PARTITION BY pv."System" ORDER BY COUNT(*) DESC) AS rn
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
         LATERAL FLATTEN(INPUT => PARSE_JSON(pv."Licenses")) f
    GROUP BY pv."System", f.value
)
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Show the packages (sample) that use the most frequent license for the NPM system found above.
WITH top_license AS (
    SELECT f.value::STRING AS "TopLicense"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
         LATERAL FLATTEN(INPUT => PARSE_JSON(pv."Licenses")) f
    WHERE pv."System" = 'NPM'
    GROUP BY f.value
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT pv."Name",
       pv."Version",
       pv."Licenses"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
     top_license tl
WHERE pv."System" = 'NPM'
  AND ARRAY_CONTAINS(PARSE_JSON(pv."Licenses"), tl."TopLicense")
LIMIT 20;
```

```sql
--Description: Count packages whose “Licenses” field is empty or null for quality assessment.
SELECT "System",
       COUNT(*) AS "PackagesWithoutLicense"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE "Licenses" IS NULL
   OR PARSE_JSON("Licenses") = '[]'
GROUP BY "System"
LIMIT 20;
```

```sql
--Description: List the five most common licenses across ALL systems.
SELECT "License",
       COUNT(*) AS "PkgCount"
FROM (
    SELECT f.value::STRING AS "License"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
         LATERAL FLATTEN(INPUT => PARSE_JSON(pv."Licenses")) f
)
GROUP BY "License"
ORDER BY "PkgCount" DESC
LIMIT 20;
```

```sql
--Description: Provide the most frequent license per system together with its share (%) of that system’s packages.
WITH licenses AS (
    SELECT pv."System",
           f.value::STRING AS "License"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
         LATERAL FLATTEN(INPUT => PARSE_JSON(pv."Licenses")) f
),
counts AS (
    SELECT "System",
           "License",
           COUNT(*) AS "PkgCount",
           ROW_NUMBER() OVER (PARTITION BY "System" ORDER BY COUNT(*) DESC) AS rn
    FROM licenses
    GROUP BY "System", "License"
),
totals AS (
    SELECT "System",
           COUNT(*) AS "TotalPkgs"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
    GROUP BY "System"
)
SELECT c."System",
       c."License" AS "MostFrequentLicense",
       c."PkgCount",
       ROUND(c."PkgCount" * 100.0 / t."TotalPkgs", 2) AS "Percentage"
FROM counts c
JOIN totals t USING ("System")
WHERE c.rn = 1
LIMIT 20;
```

```sql
--Description: Same as previous but ordered by system name to serve as the final summary query.
WITH licenses AS (
    SELECT pv."System",
           f.value::STRING AS "License"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
         LATERAL FLATTEN(INPUT => PARSE_JSON(pv."Licenses")) f
),
counts AS (
    SELECT "System",
           "License",
           COUNT(*) AS "PkgCount",
           ROW_NUMBER() OVER (PARTITION BY "System" ORDER BY COUNT(*) DESC) AS rn
    FROM licenses
    GROUP BY "System", "License"
)
SELECT "System",
       "License" AS "MostFrequentLicense",
       "PkgCount"
FROM counts
WHERE rn = 1
ORDER BY "System"
LIMIT 20;
```

