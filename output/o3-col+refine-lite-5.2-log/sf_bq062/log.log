Query:
--Description: Flatten the “Licenses” array for each package to look at individual license strings.
SELECT pv."System",
       pv."Name",
       pv."Version",
       f.value::STRING AS "License"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
     LATERAL FLATTEN(INPUT => PARSE_JSON(pv."Licenses")) f
LIMIT 20;
