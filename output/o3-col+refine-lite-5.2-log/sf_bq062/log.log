```sql
--Description: List the most common license strings across all systems (top 20 by frequency).
SELECT
    "License",
    COUNT(*) AS "PkgCount"
FROM (
    SELECT
        f.value::STRING AS "License"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
         LATERAL FLATTEN(INPUT => PARSE_JSON(pv."Licenses")) f
)
GROUP BY "License"
ORDER BY "PkgCount" DESC
