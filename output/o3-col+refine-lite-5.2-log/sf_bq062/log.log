```sql
--Description: Show each system’s single most‑frequent license and its share of that system’s packages.
WITH licenses AS (
    SELECT
        pv."System",
        f.value::STRING AS "License"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
         LATERAL FLATTEN(INPUT => PARSE_JSON(pv."Licenses")) f
),
counts AS (
    SELECT
        "System",
        "License",
        COUNT(*) AS "PkgCount",
        ROW_NUMBER() OVER (PARTITION BY "System" ORDER BY COUNT(*) DESC) AS rn
    FROM licenses
    GROUP BY "System", "License"
),
totals AS (
    SELECT
        "System",
        COUNT(*) AS "TotalPkgs"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
    GROUP BY "System"
)
SELECT
    c."System",
    c."License" AS "MostFrequentLicense",
    c."PkgCount",
    ROUND(c."PkgCount" * 100.0 / t."TotalPkgs", 2) AS "Percentage"
FROM counts c
JOIN totals t USING ("System")
WHERE c.rn = 1
LIMIT 20;
```

```sql
--Description: Summarise the most‑frequent license per system (ordered by system name).
WITH licenses AS (
    SELECT
        pv."System",
        f.value::STRING AS "License"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv,
         LATERAL FLATTEN(INPUT => PARSE_JSON(pv."Licenses")) f
),
counts AS (
    SELECT
        "System",
        "License",
        COUNT(*) AS "PkgCount",
        ROW_NUMBER() OVER (PARTITION BY "System" ORDER BY COUNT(*) DESC) AS rn
    FROM licenses
    GROUP BY "System", "License"
)
SELECT
    "System",
    "License" AS "MostFrequentLicense",
    "PkgCount"
FROM counts
WHERE rn = 1
ORDER BY "System"
LIMIT 20;
