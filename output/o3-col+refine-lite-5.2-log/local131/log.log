-- 9) Description: Count how many times each style is chosen as the 3rd preference.
SELECT   ms."StyleName",
         COUNT(*) AS "third_pref_cnt"
FROM     "Musical_Preferences" AS mp
         JOIN "Musical_Styles" AS ms
           ON ms."StyleID" = mp."StyleID"
