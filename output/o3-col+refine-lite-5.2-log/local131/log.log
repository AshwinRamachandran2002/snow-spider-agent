```sql
-- 3) Description: See the distinct ranking positions that actually occur.  
SELECT DISTINCT "PreferenceSeq"
FROM   "Musical_Preferences"
LIMIT 20;
```

```sql
-- 4) Description: Find which style IDs appear in the preference table.
SELECT DISTINCT "StyleID"
FROM   "Musical_Preferences"
LIMIT 20;
```

```sql
-- 5) Description: Simple count of preferences by ranking position (1st, 2nd, 3rd …).  
SELECT   "PreferenceSeq",
         COUNT(*) AS "cnt"
FROM     "Musical_Preferences"
GROUP BY "PreferenceSeq"
LIMIT 20;
```

```sql
-- 6) Description: Join style names to preferences to put words to the numbers.
SELECT DISTINCT mp."StyleID",
                ms."StyleName",
                mp."PreferenceSeq"
FROM   "Musical_Preferences" AS mp
       JOIN "Musical_Styles" AS ms
         ON mp."StyleID" = ms."StyleID"
LIMIT 20;
```

```sql
-- 7) Description: Count how many times each style is chosen as the 1st preference.
SELECT   ms."StyleName",
         COUNT(*) AS "first_pref_cnt"
FROM     "Musical_Preferences" AS mp
         JOIN "Musical_Styles" AS ms
           ON ms."StyleID" = mp."StyleID"
WHERE    mp."PreferenceSeq" = 1
GROUP BY ms."StyleName"
LIMIT 20;
```

```sql
-- 8) Description: Count how many times each style is chosen as the 2nd preference.
SELECT   ms."StyleName",
         COUNT(*) AS "second_pref_cnt"
FROM     "Musical_Preferences" AS mp
         JOIN "Musical_Styles" AS ms
           ON ms."StyleID" = mp."StyleID"
WHERE    mp."PreferenceSeq" = 2
GROUP BY ms."StyleName"
LIMIT 20;
```

```sql
-- 9) Description: Count how many times each style is chosen as the 3rd preference.
SELECT   ms."StyleName",
         COUNT(*) AS "third_pref_cnt"
FROM     "Musical_Preferences" AS mp
         JOIN "Musical_Styles" AS ms
           ON ms."StyleID" = mp."StyleID"
WHERE    mp."PreferenceSeq" = 3
GROUP BY ms."StyleName"
LIMIT 20;
```

```sql
-- 10) Description: FINAL – one row per style, showing how often it was listed
--     as a 1st, 2nd, or 3rd preference (0 when never used in that slot).
SELECT   ms."StyleName",
         SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "first_pref_cnt",
         SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "second_pref_cnt",
         SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "third_pref_cnt"
FROM     "Musical_Styles"      AS ms
         LEFT JOIN "Musical_Preferences" AS mp
                ON ms."StyleID" = mp."StyleID"
GROUP BY ms."StyleName"
LIMIT 20;
```
