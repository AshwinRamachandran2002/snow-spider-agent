--Description: 5) Count how many patents share the same “most‑frequent” IPC4
WITH most_ipc4 AS (
    SELECT
        p."publication_number",
        SUBSTR(ipc_flat.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*) AS cnt,
        ROW_NUMBER() OVER (PARTITION BY p."publication_number"
                           ORDER BY COUNT(*) DESC, MIN(SUBSTR(ipc_flat.value:"code"::STRING, 1, 4))) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS AS p,
         LATERAL FLATTEN(input => p."ipc") AS ipc_flat
    WHERE p."country_code" = 'US'
      AND p."kind_code" = 'B2'
      AND p."application_kind" = 'A'
      AND p."publication_date" BETWEEN 20220601 AND 20220930
    GROUP BY p."publication_number", SUBSTR(ipc_flat.value:"code"::STRING, 1, 4)
)
SELECT
    "ipc4",
    COUNT(*) AS "n_patents"
FROM most_ipc4
WHERE rn = 1
GROUP BY "ipc4"
ORDER BY "n_patents" DESC
LIMIT 20;
