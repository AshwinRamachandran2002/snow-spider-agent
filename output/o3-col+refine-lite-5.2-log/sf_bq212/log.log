    GROUP BY p."publication_number", SUBSTR(ipc_flat.value:"code"::STRING, 1, 4)
), popular_ipc4 AS (
    SELECT "ipc4"
    FROM most_ipc4
    WHERE rn = 1
    GROUP BY "ipc4"
    HAVING COUNT(*) >= 10
)
SELECT
    m."publication_number",
    m."ipc4"
