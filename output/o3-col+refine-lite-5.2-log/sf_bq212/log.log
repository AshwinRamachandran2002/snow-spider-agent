```sql
--Description: 1) Preview U.S. utility patents (kind_code ‘B2’) granted between 2022‑06‑01 and 2022‑09‑30
SELECT 
    "publication_number",
    "publication_date",
    "kind_code",
    "application_kind",
    "ipc"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'US'
  AND "kind_code" = 'B2'
  AND "application_kind" = 'A'
  AND "publication_date" BETWEEN 20220601 AND 20220930
LIMIT 20;
```

```sql
--Description: 2) Flatten IPC array for the same subset to view individual IPC codes
SELECT
    p."publication_number",
    ipc_flat.value:"code"::STRING AS "ipc_code",
    ipc_flat.value:"first"::BOOLEAN AS "is_main"
FROM PATENTS.PATENTS.PUBLICATIONS AS p,
     LATERAL FLATTEN(input => p."ipc") AS ipc_flat
WHERE p."country_code" = 'US'
  AND p."kind_code" = 'B2'
  AND p."application_kind" = 'A'
  AND p."publication_date" BETWEEN 20220601 AND 20220930
LIMIT 20;
```

```sql
--Description: 3) Derive 4‑digit IPC (IPC4) and count its occurrences per patent
SELECT
    p."publication_number",
    SUBSTR(ipc_flat.value:"code"::STRING, 1, 4) AS "ipc4",
    COUNT(*) AS "ipc4_cnt_per_patent"
FROM PATENTS.PATENTS.PUBLICATIONS AS p,
     LATERAL FLATTEN(input => p."ipc") AS ipc_flat
WHERE p."country_code" = 'US'
  AND p."kind_code" = 'B2'
  AND p."application_kind" = 'A'
  AND p."publication_date" BETWEEN 20220601 AND 20220930
GROUP BY p."publication_number", "ipc4"
ORDER BY p."publication_number", "ipc4_cnt_per_patent" DESC
LIMIT 20;
```

```sql
--Description: 4) Identify the most frequent IPC4 for each patent using ROW_NUMBER windowing
SELECT
    sub."publication_number",
    sub."ipc4",
    sub."ipc4_cnt_per_patent"
FROM (
    SELECT
        p."publication_number",
        SUBSTR(ipc_flat.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*) AS "ipc4_cnt_per_patent",
        ROW_NUMBER() OVER (PARTITION BY p."publication_number"
                           ORDER BY COUNT(*) DESC, MIN(SUBSTR(ipc_flat.value:"code"::STRING, 1, 4))) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS AS p,
         LATERAL FLATTEN(input => p."ipc") AS ipc_flat
    WHERE p."country_code" = 'US'
      AND p."kind_code" = 'B2'
      AND p."application_kind" = 'A'
      AND p."publication_date" BETWEEN 20220601 AND 20220930
    GROUP BY p."publication_number", SUBSTR(ipc_flat.value:"code"::STRING, 1, 4)
) sub
WHERE sub.rn = 1
LIMIT 20;
```

```sql
--Description: 5) Count how many patents share the same “most‑frequent” IPC4
WITH most_ipc4 AS (
    SELECT
        p."publication_number",
        SUBSTR(ipc_flat.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*) AS cnt,
        ROW_NUMBER() OVER (PARTITION BY p."publication_number"
                           ORDER BY COUNT(*) DESC, MIN(SUBSTR(ipc_flat.value:"code"::STRING, 1, 4))) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS AS p,
         LATERAL FLATTEN(input => p."ipc") AS ipc_flat
    WHERE p."country_code" = 'US'
      AND p."kind_code" = 'B2'
      AND p."application_kind" = 'A'
      AND p."publication_date" BETWEEN 20220601 AND 20220930
    GROUP BY p."publication_number", SUBSTR(ipc_flat.value:"code"::STRING, 1, 4)
)
SELECT
    "ipc4",
    COUNT(*) AS "n_patents"
FROM most_ipc4
WHERE rn = 1
GROUP BY "ipc4"
ORDER BY "n_patents" DESC
LIMIT 20;
```

```sql
--Description: 6) Retrieve IPC4 codes that appear as the dominant IPC4 in ≥10 patents
WITH most_ipc4 AS (
    SELECT
        p."publication_number",
        SUBSTR(ipc_flat.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*) AS cnt,
        ROW_NUMBER() OVER (PARTITION BY p."publication_number"
                           ORDER BY COUNT(*) DESC, MIN(SUBSTR(ipc_flat.value:"code"::STRING, 1, 4))) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS AS p,
         LATERAL FLATTEN(input => p."ipc") AS ipc_flat
    WHERE p."country_code" = 'US'
      AND p."kind_code" = 'B2'
      AND p."application_kind" = 'A'
      AND p."publication_date" BETWEEN 20220601 AND 20220930
    GROUP BY p."publication_number", SUBSTR(ipc_flat.value:"code"::STRING, 1, 4)
)
SELECT
    "ipc4",
    COUNT(*) AS "n_patents"
FROM most_ipc4
WHERE rn = 1
GROUP BY "ipc4"
HAVING COUNT(*) >= 10
ORDER BY "n_patents" DESC
LIMIT 20;
```

```sql
--Description: 7) List publication numbers whose dominant IPC4 belongs to the ≥10‑patent group
WITH most_ipc4 AS (
    SELECT
        p."publication_number",
        SUBSTR(ipc_flat.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*) AS cnt,
        ROW_NUMBER() OVER (PARTITION BY p."publication_number"
                           ORDER BY COUNT(*) DESC, MIN(SUBSTR(ipc_flat.value:"code"::STRING, 1, 4))) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS AS p,
         LATERAL FLATTEN(input => p."ipc") AS ipc_flat
    WHERE p."country_code" = 'US'
      AND p."kind_code" = 'B2'
      AND p."application_kind" = 'A'
      AND p."publication_date" BETWEEN 20220601 AND 20220930
    GROUP BY p."publication_number", SUBSTR(ipc_flat.value:"code"::STRING, 1, 4)
), popular_ipc4 AS (
    SELECT "ipc4"
    FROM most_ipc4
    WHERE rn = 1
    GROUP BY "ipc4"
    HAVING COUNT(*) >= 10
)
SELECT
    m."publication_number",
    m."ipc4"
FROM most_ipc4 AS m
JOIN popular_ipc4 AS pop
  ON m."ipc4" = pop."ipc4"
WHERE m.rn = 1
ORDER BY m."ipc4", m."publication_number"
LIMIT 20;
```

