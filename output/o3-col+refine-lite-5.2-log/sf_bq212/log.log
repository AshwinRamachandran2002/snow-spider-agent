--Description / Thinking process:
--Purpose: Quality‑check how many U.S. B2 patents (Jun‑Sep 2022) appear in the final list whose dominant IPC4
--         occurs in at least 10 patents.  
--Steps  
--1. most_ipc4 CTE: For every patent, unnest its IPC codes, truncate to 4‑digit root, count occurrences,  
--   and keep only the row(s) with the highest count via ROW_NUMBER = 1.  
--2. popular_ipc4 CTE: Among those dominant IPC4 codes, keep only the ones that appear for ≥10 different patents.  
--3. Final SELECT: Count distinct publication numbers where their dominant IPC4 belongs to that popular set.  
--   LIMIT 20 just displays the count (one row); can be removed if unnecessary.  All equality joins remain valid
--   because both sides store the same 4‑character IPC4 strings, so no LIKE is required here.
WITH most_ipc4 AS (
    SELECT
        p."publication_number",
        SUBSTR(ipc_flat.value:"code"::STRING, 1, 4) AS "ipc4",
        COUNT(*) AS cnt,
        ROW_NUMBER() OVER (PARTITION BY p."publication_number"
                           ORDER BY COUNT(*) DESC, MIN(SUBSTR(ipc_flat.value:"code"::STRING, 1, 4))) AS rn
    FROM PATENTS.PATENTS.PUBLICATIONS AS p,
         LATERAL FLATTEN(input => p."ipc") AS ipc_flat
    WHERE p."country_code" = 'US'
      AND p."kind_code" = 'B2'
      AND p."application_kind" = 'A'
      AND p."publication_date" BETWEEN 20220601 AND 20220930
    GROUP BY p."publication_number", SUBSTR(ipc_flat.value:"code"::STRING, 1, 4)
), popular_ipc4 AS (
    SELECT "ipc4"
    FROM most_ipc4
    WHERE rn = 1
    GROUP BY "ipc4"
    HAVING COUNT(*) >= 10
)
SELECT COUNT(DISTINCT m."publication_number") AS "n_patents_final"
FROM most_ipc4 AS m
JOIN popular_ipc4 AS pop
  ON m."ipc4" = pop."ipc4"
WHERE m.rn = 1
LIMIT 20;
