--Description: Aggregate counts of each overtake type across ALL races with
--             pit‑stop data – no hard‑coded race_id was used, so no change needed.
SELECT agg."overtake_type",
       COUNT(*) AS "num_occurrences"
FROM (
      SELECT e."race_id",
             e."lap",
             CASE
                  WHEN ps_in."driver_id"  IS NOT NULL THEN 'Leader entered pits'
                  WHEN ps_out."driver_id" IS NOT NULL THEN 'Follower exited pits'
                  WHEN rt."driver_id"     IS NOT NULL THEN 'Leader retirement'
                  WHEN e."lap" = 1                      THEN 'Race start shuffle'
                  ELSE 'On‑track overtake'
             END AS "overtake_type"
      FROM (
            SELECT lp_now."race_id",
                   lp_now."lap",
                   lp_now."driver_id",
                   lp_now_ahead."driver_id" AS "leader"
            FROM   "lap_positions" lp_now
            JOIN   "races_ext" re
                   ON re."race_id" = lp_now."race_id"
                  AND re."is_pit_data_available" = 1
            JOIN   "lap_positions" lp_now_ahead
                   ON lp_now_ahead."race_id"  = lp_now."race_id"
                  AND lp_now_ahead."lap"      = lp_now."lap"
                  AND lp_now_ahead."position" = lp_now."position" - 1
            LEFT  JOIN "lap_positions" lp_prev
                   ON lp_prev."race_id"  = lp_now."race_id"
                  AND lp_prev."lap"      = lp_now."lap" - 1
                  AND lp_prev."driver_id"     = lp_now."driver_id"
            WHERE  lp_prev."position" IS NULL
               OR  lp_prev."position" - 1 <> lp_now."position"
           ) e
      LEFT JOIN "pit_stops" ps_in
             ON ps_in."race_id"  = e."race_id"
            AND ps_in."driver_id" = e."leader"
            AND ps_in."lap"       = e."lap"
      LEFT JOIN "pit_stops" ps_out
             ON ps_out."race_id"  = e."race_id"
            AND ps_out."driver_id" = e."driver_id"
            AND ps_out."lap"      = e."lap" - 1
      LEFT JOIN "retirements" rt
             ON rt."race_id"      = e."race_id"
            AND rt."driver_id"    = e."leader"
            AND rt."lap"          = e."lap"
     ) agg
GROUP BY agg."overtake_type"
LIMIT 20
