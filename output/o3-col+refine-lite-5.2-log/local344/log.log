Query:
--Description: Show examples where a driver was NOT behind on the previous lap
--             but IS directly behind another car now, using the first race present
--             in lap_positions.
SELECT lp_now."race_id",
       lp_now."lap",
       lp_now."driver_id"        AS "follower",
       lp_now."position"         AS "follower_pos",
       lp_now_ahead."driver_id"  AS "leader",
       lp_prev."position"        AS "prev_pos_follower"
FROM   "lap_positions" lp_now
JOIN   "lap_positions" lp_now_ahead
       ON lp_now_ahead."race_id"  = lp_now."race_id"
      AND lp_now_ahead."lap"      = lp_now."lap"
      AND lp_now_ahead."position" = lp_now."position" - 1
LEFT  JOIN "lap_positions" lp_prev
       ON lp_prev."race_id"  = lp_now."race_id"
      AND lp_prev."lap"      = lp_now."lap" - 1
      AND lp_prev."driver_id"     = lp_now."driver_id"
WHERE  lp_now."race_id" = (SELECT MIN("race_id") FROM "lap_positions")
  AND (lp_prev."position" IS NULL
       OR lp_prev."position" - 1 <> lp_now."position")
ORDER  BY lp_now."lap", lp_now."position"
LIMIT  20
