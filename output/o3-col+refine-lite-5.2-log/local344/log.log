Query:
--Description: Identify, for every driver and lap, the driver that was directly
--             ahead on track for the very first race that has lap‑by‑lap data,
--             determined dynamically.
SELECT lp_now."race_id",
       lp_now."lap",
       lp_now."driver_id"  AS "driver",
       lp_now."position",
       lp_prev."driver_id" AS "prev_lap_driver_ahead"
FROM   "lap_positions" lp_now
LEFT  JOIN "lap_positions" lp_prev
       ON lp_prev."race_id"  = lp_now."race_id"
      AND lp_prev."lap"      = lp_now."lap" - 1
      AND lp_prev."position" = lp_now."position" - 1
WHERE  lp_now."race_id" = (SELECT MIN("race_id") FROM "lap_positions")
ORDER  BY lp_now."lap", lp_now."position"
LIMIT  20
