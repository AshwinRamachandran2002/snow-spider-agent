```sql
-- 6. Identify, for every driver and lap, the driver that was directly ahead on track
SELECT lp_now."race_id",
       lp_now."lap",
       lp_now."driver_id"          AS "driver",
       lp_now."position",
       lp_prev."driver_id"         AS "prev_lap_driver_ahead"
FROM   "lap_positions" lp_now
LEFT JOIN "lap_positions" lp_prev
       ON lp_prev."race_id" = lp_now."race_id"
      AND lp_prev."lap"     = lp_now."lap" - 1
      AND lp_prev."position" = lp_now."position" - 1        -- driver that was ahead
WHERE  lp_now."race_id" = 1
ORDER BY lp_now."lap", lp_now."position"
LIMIT 20;
```

```sql
-- 7. Sample rows where a driver was NOT behind on lap‑1 but IS directly behind someone on lap N
SELECT lp_now."race_id",
       lp_now."lap",
       lp_now."driver_id"                    AS "follower",
       lp_now."position"                     AS "follower_pos",
       lp_now_ahead."driver_id"              AS "leader",
       lp_prev."position"                    AS "prev_pos_follower"
FROM   "lap_positions" lp_now
JOIN   "lap_positions" lp_now_ahead          -- driver ahead on same lap
       ON lp_now_ahead."race_id" = lp_now."race_id"
      AND lp_now_ahead."lap"     = lp_now."lap"
      AND lp_now_ahead."position" = lp_now."position" - 1
LEFT  JOIN "lap_positions" lp_prev           -- follower’s position on previous lap
       ON lp_prev."race_id" = lp_now."race_id"
      AND lp_prev."lap"     = lp_now."lap" - 1
      AND lp_prev."driver_id" = lp_now."driver_id"
WHERE  lp_now."race_id" = 1
  AND (lp_prev."position" IS NULL            -- not behind because didn’t exist
       OR lp_prev."position" - 1 <> lp_now."position") -- wasn’t directly behind
ORDER BY lp_now."lap", lp_now."position"
LIMIT 20;
```

```sql
-- 8. Classify each “newly‑behind” event into overtake types
--    (simplified illustration for one race; classification logic abbreviated)
SELECT e."race_id",
       e."lap",
       e."follower",
       e."leader",
       CASE
            WHEN ps_in."driver_id" IS NOT NULL                 THEN 'Leader entered pits'
            WHEN ps_out."driver_id" IS NOT NULL                THEN 'Follower exited pits'
            WHEN rt."driver_id" IS NOT NULL                    THEN 'Leader retirement'
            WHEN e."lap" = 1                                   THEN 'Race start shuffle'
            ELSE 'On‑track overtake'
       END AS "overtake_type"
FROM (
      -- event set from query 7 (materialised here for clarity)
      SELECT lp_now."race_id",
             lp_now."lap",
             lp_now."driver_id"          AS "follower",
             lp_now_ahead."driver_id"    AS "leader"
      FROM   "lap_positions" lp_now
      JOIN   "lap_positions" lp_now_ahead
             ON lp_now_ahead."race_id" = lp_now."race_id"
            AND lp_now_ahead."lap"     = lp_now."lap"
            AND lp_now_ahead."position" = lp_now."position" - 1
      LEFT  JOIN "lap_positions" lp_prev
             ON lp_prev."race_id" = lp_now."race_id"
            AND lp_prev."lap"     = lp_now."lap" - 1
            AND lp_prev."driver_id" = lp_now."driver_id"
      WHERE  lp_now."race_id" = 1
        AND (lp_prev."position" IS NULL
             OR lp_prev."position" - 1 <> lp_now."position")
     ) e
LEFT JOIN "pit_stops" ps_in                  -- leader in‑lap pit entry
       ON ps_in."race_id" = e."race_id"
      AND ps_in."driver_id" = e."leader"
      AND ps_in."lap"       = e."lap"
LEFT JOIN "pit_stops" ps_out                 -- follower out‑lap pit exit
       ON ps_out."race_id" = e."race_id"
      AND ps_out."driver_id" = e."follower"
      AND ps_out."lap"      = e."lap" - 1
LEFT JOIN "retirements" rt                   -- leader retires this lap
       ON rt."race_id" = e."race_id"
      AND rt."driver_id" = e."leader"
      AND rt."lap"       = e."lap"
LIMIT 20;
```

```sql
-- 9. Aggregate counts of each overtake type across ALL races with pit data
SELECT agg."overtake_type",
       COUNT(*) AS "num_occurrences"
FROM (
      -- Same logic as query 8 but over every eligible race (sub‑query compressed)
      SELECT e."race_id",
             e."lap",
             CASE
                  WHEN ps_in."driver_id" IS NOT NULL THEN 'Leader entered pits'
                  WHEN ps_out."driver_id" IS NOT NULL THEN 'Follower exited pits'
                  WHEN rt."driver_id" IS NOT NULL THEN 'Leader retirement'
                  WHEN e."lap" = 1 THEN 'Race start shuffle'
                  ELSE 'On‑track overtake'
             END AS "overtake_type"
      FROM  (
            -- find “newly‑behind” situations
            SELECT lp_now."race_id",
                   lp_now."lap",
                   lp_now."driver_id",
                   lp_now_ahead."driver_id" AS "leader"
            FROM   "lap_positions" lp_now
            JOIN   "races_ext" re                        -- only races with pit data
                   ON re."race_id" = lp_now."race_id"
                  AND re."is_pit_data_available" = 1
            JOIN   "lap_positions" lp_now_ahead
                   ON lp_now_ahead."race_id" = lp_now."race_id"
                  AND lp_now_ahead."lap"     = lp_now."lap"
                  AND lp_now_ahead."position" = lp_now."position" - 1
            LEFT  JOIN "lap_positions" lp_prev
                   ON lp_prev."race_id" = lp_now."race_id"
                  AND lp_prev."lap"     = lp_now."lap" - 1
                  AND lp_prev."driver_id" = lp_now."driver_id"
            WHERE  (lp_prev."position" IS NULL
                   OR lp_prev."position" - 1 <> lp_now."position")
           ) e
      LEFT JOIN "pit_stops" ps_in
             ON ps_in."race_id" = e."race_id"
            AND ps_in."driver_id" = e."leader"
            AND ps_in."lap"       = e."lap"
      LEFT JOIN "pit_stops" ps_out
             ON ps_out."race_id" = e."race_id"
            AND ps_out."driver_id" = e."driver_id"
            AND ps_out."lap"      = e."lap" - 1
      LEFT JOIN "retirements" rt
             ON rt."race_id" = e."race_id"
            AND rt."driver_id" = e."leader"
            AND rt."lap"       = e."lap"
     ) agg
GROUP BY agg."overtake_type"
LIMIT 20;
```

