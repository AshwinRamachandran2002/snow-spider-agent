Query:
--Description: “Retirement events” sample query – instead of hard‑coding race_id = 1
--             (which may have no retirements), use the earliest race that actually
--             appears in the retirements table.
SELECT DISTINCT r."race_id",
                r."driver_id",
                r."lap",
                r."status_id",
                s."status"
FROM   "retirements" r
LEFT JOIN "status" s
       ON s."status_id" = r."status_id"
WHERE  r."race_id" = (SELECT MIN("race_id") FROM "retirements")
ORDER  BY r."lap"
LIMIT  20
