-- 8. Combine the two previous CTEs to keep driver‑seasons where
--    the first and last constructors match AND at least two races were entered
WITH driver_year AS (
    SELECT r.driver_id,
           ra.year,
           MIN(ra.round) AS first_round,
           MAX(ra.round) AS last_round,
           COUNT(DISTINCT ra.round) AS race_cnt
    FROM results AS r
    JOIN races   AS ra ON ra.race_id = r.race_id
    WHERE ra.year BETWEEN 1950 AND 1959
    GROUP BY r.driver_id, ra.year
    HAVING race_cnt >= 2               -- took part in at least two rounds
), first_constr AS (
    SELECT dy.driver_id,
           dy.year,
           r.constructor_id AS first_constructor
    FROM driver_year AS dy
    JOIN races   AS ra ON ra.year  = dy.year  AND ra.round = dy.first_round
    JOIN results AS r  ON r.race_id = ra.race_id AND r.driver_id = dy.driver_id
), last_constr AS (
    SELECT dy.driver_id,
           dy.year,
           r.constructor_id AS last_constructor
    FROM driver_year AS dy
    JOIN races   AS ra ON ra.year  = dy.year  AND ra.round = dy.last_round
    JOIN results AS r  ON r.race_id = ra.race_id AND r.driver_id = dy.driver_id
)
SELECT fc.driver_id,
       fc.year,
       fc.first_constructor          -- equals last_constructor by filter below
FROM first_constr AS fc
JOIN last_constr  AS lc
  ON lc.driver_id = fc.driver_id AND lc.year = fc.year
WHERE fc.first_constructor = lc.last_constructor
LIMIT 20;
