```sql
-- 1. Years in the 1950‑1959 range that exist in the dataset
SELECT DISTINCT year
FROM races
WHERE year BETWEEN 1950 AND 1959
ORDER BY year
LIMIT 20;
```

```sql
-- 2. Drivers who have at least one race result in the 1950s
SELECT DISTINCT d.driver_id,
       d.forename || ' ' || d.surname AS driver_name
FROM drivers AS d
JOIN results  AS r ON r.driver_id = d.driver_id
JOIN races    AS ra ON ra.race_id = r.race_id
WHERE ra.year BETWEEN 1950 AND 1959
LIMIT 20;
```

```sql
-- 3. Sample results from the 1950 season (driver, round, constructor)
SELECT ra.year,
       ra.round,
       r.driver_id,
       d.forename || ' ' || d.surname AS driver_name,
       r.constructor_id
FROM results  AS r
JOIN races    AS ra ON ra.race_id = r.race_id
JOIN drivers  AS d  ON d.driver_id = r.driver_id
WHERE ra.year = 1950
ORDER BY r.driver_id, ra.round
LIMIT 20;
```

```sql
-- 4. All 1950‑1959 race participations for one sample driver
SELECT ra.year,
       ra.round,
       r.constructor_id
FROM results AS r
JOIN races   AS ra ON ra.race_id = r.race_id
WHERE r.driver_id = (
        SELECT driver_id
        FROM results
        JOIN races ON races.race_id = results.race_id
        WHERE races.year BETWEEN 1950 AND 1959
        LIMIT 1
      )
ORDER BY ra.year, ra.round
LIMIT 20;
```

```sql
-- 5. For every driver‑season in the 1950s, find their first and last rounds
WITH driver_year AS (
    SELECT r.driver_id,
           ra.year,
           MIN(ra.round) AS first_round,
           MAX(ra.round) AS last_round,
           COUNT(DISTINCT ra.round) AS race_count
    FROM results AS r
    JOIN races   AS ra ON ra.race_id = r.race_id
    WHERE ra.year BETWEEN 1950 AND 1959
    GROUP BY r.driver_id, ra.year
)
SELECT *
FROM driver_year
LIMIT 20;
```

```sql
-- 6. Constructor used in the first race of each driver‑season
WITH driver_year AS (
    SELECT r.driver_id,
           ra.year,
           MIN(ra.round) AS first_round
    FROM results AS r
    JOIN races   AS ra ON ra.race_id = r.race_id
    WHERE ra.year BETWEEN 1950 AND 1959
    GROUP BY r.driver_id, ra.year
)
SELECT dy.driver_id,
       dy.year,
       r.constructor_id AS first_constructor
FROM driver_year AS dy
JOIN races   AS ra ON ra.year  = dy.year  AND ra.round = dy.first_round
JOIN results AS r  ON r.race_id = ra.race_id AND r.driver_id = dy.driver_id
LIMIT 20;
```

```sql
-- 7. Constructor used in the last race of each driver‑season
WITH driver_year AS (
    SELECT r.driver_id,
           ra.year,
           MAX(ra.round) AS last_round
    FROM results AS r
    JOIN races   AS ra ON ra.race_id = r.race_id
    WHERE ra.year BETWEEN 1950 AND 1959
    GROUP BY r.driver_id, ra.year
)
SELECT dy.driver_id,
       dy.year,
       r.constructor_id AS last_constructor
FROM driver_year AS dy
JOIN races   AS ra ON ra.year  = dy.year  AND ra.round = dy.last_round
JOIN results AS r  ON r.race_id = ra.race_id AND r.driver_id = dy.driver_id
LIMIT 20;
```

```sql
-- 8. Combine the two previous CTEs to keep driver‑seasons where
--    the first and last constructors match AND at least two races were entered
WITH driver_year AS (
    SELECT r.driver_id,
           ra.year,
           MIN(ra.round) AS first_round,
           MAX(ra.round) AS last_round,
           COUNT(DISTINCT ra.round) AS race_cnt
    FROM results AS r
    JOIN races   AS ra ON ra.race_id = r.race_id
    WHERE ra.year BETWEEN 1950 AND 1959
    GROUP BY r.driver_id, ra.year
    HAVING race_cnt >= 2               -- took part in at least two rounds
), first_constr AS (
    SELECT dy.driver_id,
           dy.year,
           r.constructor_id AS first_constructor
    FROM driver_year AS dy
    JOIN races   AS ra ON ra.year  = dy.year  AND ra.round = dy.first_round
    JOIN results AS r  ON r.race_id = ra.race_id AND r.driver_id = dy.driver_id
), last_constr AS (
    SELECT dy.driver_id,
           dy.year,
           r.constructor_id AS last_constructor
    FROM driver_year AS dy
    JOIN races   AS ra ON ra.year  = dy.year  AND ra.round = dy.last_round
    JOIN results AS r  ON r.race_id = ra.race_id AND r.driver_id = dy.driver_id
)
SELECT fc.driver_id,
       fc.year,
       fc.first_constructor          -- equals last_constructor by filter below
FROM first_constr AS fc
JOIN last_constr  AS lc
  ON lc.driver_id = fc.driver_id AND lc.year = fc.year
WHERE fc.first_constructor = lc.last_constructor
LIMIT 20;
```

```sql
-- 9. Final answer: list the driver names that satisfy every condition
WITH driver_year AS (
    SELECT r.driver_id,
           ra.year,
           MIN(ra.round) AS first_round,
           MAX(ra.round) AS last_round,
           COUNT(DISTINCT ra.round) AS race_cnt
    FROM results AS r
    JOIN races   AS ra ON ra.race_id = r.race_id
    WHERE ra.year BETWEEN 1950 AND 1959
    GROUP BY r.driver_id, ra.year
    HAVING race_cnt >= 2
), first_constr AS (
    SELECT dy.driver_id,
           dy.year,
           r.constructor_id AS first_constructor
    FROM driver_year AS dy
    JOIN races   AS ra ON ra.year  = dy.year  AND ra.round = dy.first_round
    JOIN results AS r  ON r.race_id = ra.race_id AND r.driver_id = dy.driver_id
), last_constr AS (
    SELECT dy.driver_id,
           dy.year,
           r.constructor_id AS last_constructor
    FROM driver_year AS dy
    JOIN races   AS ra ON ra.year  = dy.year  AND ra.round = dy.last_round
    JOIN results AS r  ON r.race_id = ra.race_id AND r.driver_id = dy.driver_id
), same_team AS (
    SELECT fc.driver_id, fc.year
    FROM first_constr AS fc
    JOIN last_constr  AS lc
      ON lc.driver_id = fc.driver_id AND lc.year = fc.year
    WHERE fc.first_constructor = lc.last_constructor
)
SELECT DISTINCT d.forename || ' ' || d.surname AS driver_name,
       st.year
FROM same_team AS st
JOIN drivers   AS d ON d.driver_id = st.driver_id
ORDER BY st.year, driver_name
LIMIT 20;
```
