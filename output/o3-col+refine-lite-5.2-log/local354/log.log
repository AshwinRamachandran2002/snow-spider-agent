Query:
-- 2. Drivers who have at least one race result in the 1950s
SELECT DISTINCT d.driver_id,
       d.forename || ' ' || d.surname AS driver_name
FROM drivers AS d
JOIN results  AS r ON r.driver_id = d.driver_id
JOIN races    AS ra ON ra.race_id = r.race_id
WHERE ra.year BETWEEN 1950 AND 1959
LIMIT 20;
