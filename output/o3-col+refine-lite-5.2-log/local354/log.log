Query:
-- 4. All 1950‑1959 race participations for one sample driver
SELECT ra.year,
       ra.round,
       r.constructor_id
FROM results AS r
JOIN races   AS ra ON ra.race_id = r.race_id
WHERE r.driver_id = (
        SELECT driver_id
        FROM results
        JOIN races ON races.race_id = results.race_id
        WHERE races.year BETWEEN 1950 AND 1959
        LIMIT 1
      )
ORDER BY ra.year, ra.round
LIMIT 20;
