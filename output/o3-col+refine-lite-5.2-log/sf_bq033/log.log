Query:
--Description: Show only English abstracts for U.S. publications filed between 2008‑01‑01 and 2022‑12‑31 (date held as YYYYMMDD number).
SELECT 
  t."publication_number",
  t."publication_date",
  f.value:"text"::STRING AS "abs_text"
FROM PATENTS.PATENTS.PUBLICATIONS t,
