```sql
--Description: Inspect a random sample of U.S. publications to understand the publication‐date format and verify the “country_code” value.
SELECT 
  "publication_number",
  "country_code",
  "publication_date",
  "abstract_localized"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'US'
LIMIT 20;
```

```sql
--Description: Flatten the JSON array in “abstract_localized” to view the structure (language & text fields).
SELECT 
  t."publication_number",
  f.value:"language"::STRING  AS "lang",
  f.value:"text"::STRING      AS "abs_text"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."abstract_localized") f
WHERE t."country_code" = 'US'
LIMIT 20;
```

```sql
--Description: Show only English abstracts for U.S. publications filed between 2008‑01‑01 and 2022‑12‑31 (date held as YYYYMMDD number).
SELECT 
  t."publication_number",
  t."publication_date",
  f.value:"text"::STRING AS "abs_text"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."abstract_localized") f
WHERE t."country_code" = 'US'
  AND f.value:"language"::STRING = 'en'
  AND t."publication_date" BETWEEN 20080101 AND 20221231
LIMIT 20;
```

```sql
--Description: Fuzzy‑match abstracts that include the phrase “internet of things” (case‑insensitive, allowing % wildcards).
SELECT 
  t."publication_number",
  t."publication_date",
  SUBSTR(TO_VARCHAR(t."publication_date"), 1, 6) AS "yyyymm",
  f.value:"text"::STRING AS "abs_text"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."abstract_localized") f
WHERE t."country_code" = 'US'
  AND f.value:"language"::STRING = 'en'
  AND t."publication_date" BETWEEN 20080101 AND 20221231
  AND f.value:"text"::STRING ILIKE '%internet%of%things%'
LIMIT 20;
```

```sql
--Description: Get the distinct simple‑family IDs for U.S. IoT publications in the 2008‑2022 window.
SELECT DISTINCT 
  t."family_id"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."abstract_localized") f
WHERE t."country_code" = 'US'
  AND f.value:"language"::STRING = 'en'
  AND t."publication_date" BETWEEN 20080101 AND 20221231
  AND f.value:"text"::STRING ILIKE '%internet%of%things%'
LIMIT 20;
```

```sql
--Description: Aggregate the count of U.S. IoT publications by year‑month (YYYYMM) for 2008‑2022.
SELECT 
  SUBSTR(TO_VARCHAR(t."publication_date"), 1, 6) AS "yyyymm",
  COUNT(*) AS "us_iot_pub_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."abstract_localized") f
WHERE t."country_code" = 'US'
  AND f.value:"language"::STRING = 'en'
  AND t."publication_date" BETWEEN 20080101 AND 20221231
  AND f.value:"text"::STRING ILIKE '%internet%of%things%'
GROUP BY "yyyymm"
ORDER BY "yyyymm"
LIMIT 20;
```

```sql
--Description: Produce a monthly series (including months with zero filings) by LEFT‑joining the IoT counts onto a calendar table built on‑the‑fly.
WITH iot_months AS (
  SELECT 
    SUBSTR(TO_VARCHAR(t."publication_date"), 1, 6) AS "yyyymm",
    COUNT(*) AS "iot_cnt"
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."abstract_localized") f
  WHERE t."country_code" = 'US'
    AND f.value:"language"::STRING = 'en'
    AND t."publication_date" BETWEEN 20080101 AND 20221231
    AND f.value:"text"::STRING ILIKE '%internet%of%things%'
  GROUP BY "yyyymm"
)
SELECT 
  cal."yyyymm",
  COALESCE(i."iot_cnt", 0) AS "us_iot_publications"
FROM (
  -- calendar of 2008‑01 through 2022‑12 (180 rows)
  SELECT TO_CHAR(ADD_MONTHS('2008-01-01'::DATE, seq4()), 'YYYYMM') AS "yyyymm"
  FROM TABLE(GENERATOR(ROWCOUNT => 180))
) cal
LEFT JOIN iot_months i
       ON cal."yyyymm" = i."yyyymm"
ORDER BY cal."yyyymm"
LIMIT 20;
```

```sql
--Description: Verify that there are no duplicate publication numbers inside the IoT selection.
SELECT 
  t."publication_number",
  COUNT(*) AS "dup_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."abstract_localized") f
WHERE t."country_code" = 'US'
  AND f.value:"language"::STRING = 'en'
  AND t."publication_date" BETWEEN 20080101 AND 20221231
  AND f.value:"text"::STRING ILIKE '%internet%of%things%'
GROUP BY t."publication_number"
HAVING COUNT(*) > 1
LIMIT 20;
```

```sql
--Description: Examine the distribution of kind‑codes among U.S. IoT publications (e.g., A1 vs B1 vs B2).
