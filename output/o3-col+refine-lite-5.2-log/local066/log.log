```sql
--Description: Preview pizza recipes and their comma‑separated topping lists
SELECT *
FROM pizza_recipes
LIMIT 20;
```

```sql
--Description: Show all available toppings (id ↔︎ name)
SELECT *
FROM pizza_toppings
LIMIT 20;
```

```sql
--Description: List runner‑side orders that were actually delivered (no cancellation)
SELECT *
FROM pizza_clean_runner_orders
WHERE cancellation IS NULL
LIMIT 20;
```

```sql
--Description: See the matching customer orders for the delivered runs
SELECT cco.*
FROM pizza_clean_customer_orders AS cco
JOIN pizza_clean_runner_orders AS cro
  ON cco.order_id = cro.order_id
WHERE cro.cancellation IS NULL
LIMIT 20;
```

```sql
--Description: Inspect any extra toppings that were added to delivered orders
SELECT ge.*
FROM pizza_get_extras AS ge
JOIN pizza_clean_runner_orders AS cro
  ON ge.order_id = cro.order_id
WHERE cro.cancellation IS NULL
LIMIT 20;
```

```sql
--Description: Inspect toppings that customers excluded from their delivered orders
SELECT gx.*
FROM pizza_get_exclusions AS gx
JOIN pizza_clean_runner_orders AS cro
  ON gx.order_id = cro.order_id
WHERE cro.cancellation IS NULL
LIMIT 20;
```

```sql
--Description: Break every delivered pizza’s recipe into individual base toppings (1 per topping)
SELECT
    cco.order_id,
    CAST(json_extract(j.value, '$') AS INTEGER) AS topping_id,
    1 AS qty
FROM pizza_clean_customer_orders AS cco
JOIN pizza_clean_runner_orders AS cro
  ON cco.order_id = cro.order_id
JOIN pizza_recipes AS pr
  ON cco.pizza_id = pr.pizza_id,
     json_each('[' || pr.toppings || ']') AS j
WHERE cro.cancellation IS NULL
LIMIT 20;
```

```sql
--Description: Produce the extra toppings (positive quantities) for each delivered order
SELECT
    ge.order_id,
    ge.extras        AS topping_id,
    ge.extras_count  AS qty
FROM pizza_get_extras AS ge
JOIN pizza_clean_runner_orders AS cro
  ON ge.order_id = cro.order_id
WHERE cro.cancellation IS NULL
LIMIT 20;
```

```sql
--Description: Produce the excluded toppings (negative quantities) for each delivered order
SELECT
    gx.order_id,
    gx.exclusions        AS topping_id,
    -gx.total_exclusions AS qty
FROM pizza_get_exclusions AS gx
JOIN pizza_clean_runner_orders AS cro
  ON gx.order_id = cro.order_id
WHERE cro.cancellation IS NULL
LIMIT 20;
```

```sql
--Description: Final aggregation – total quantity of every ingredient used in delivered pizzas
SELECT
    pt.topping_name,
    SUM(t.qty) AS total_quantity
FROM (
        /* base toppings */
        SELECT
            cco.order_id,
            CAST(json_extract(j.value, '$') AS INTEGER) AS topping_id,
            1 AS qty
        FROM pizza_clean_customer_orders AS cco
        JOIN pizza_clean_runner_orders AS cro
          ON cco.order_id = cro.order_id
        JOIN pizza_recipes AS pr
          ON cco.pizza_id = pr.pizza_id,
             json_each('[' || pr.toppings || ']') AS j
        WHERE cro.cancellation IS NULL

        UNION ALL

        /* extras (add) */
        SELECT
            ge.order_id,
            ge.extras       AS topping_id,
            ge.extras_count AS qty
        FROM pizza_get_extras AS ge
        JOIN pizza_clean_runner_orders AS cro
          ON ge.order_id = cro.order_id
        WHERE cro.cancellation IS NULL

        UNION ALL

        /* exclusions (subtract) */
        SELECT
            gx.order_id,
            gx.exclusions        AS topping_id,
            -gx.total_exclusions AS qty
        FROM pizza_get_exclusions AS gx
        JOIN pizza_clean_runner_orders AS cro
          ON gx.order_id = cro.order_id
        WHERE cro.cancellation IS NULL
) AS t
JOIN pizza_toppings AS pt
  ON t.topping_id = pt.topping_id
GROUP BY pt.topping_name
ORDER BY pt.topping_name
LIMIT 20;
```
