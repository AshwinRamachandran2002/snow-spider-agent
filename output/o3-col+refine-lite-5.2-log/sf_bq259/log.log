```sql
--Description: Glimpse at “complete” orders (interpreted as successful purchases) up to 2022, converting the micro‑seconds field into a timestamp for sanity checking.
SELECT "order_id",
       "user_id",
       TO_TIMESTAMP("created_at"/1000000)      AS "created_ts",
       DATE_TRUNC('month', TO_TIMESTAMP("created_at"/1000000)) AS "order_month",
       "num_of_item"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE "status" = 'Complete'
  AND TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
LIMIT 20;
```

```sql
--Description: Review the different status values stored for individual line items inside an order.
SELECT DISTINCT "status"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: Sample join between ORDERS and ORDER_ITEMS to confirm status alignment and basic date fields.
SELECT oi."id"           AS "order_item_id",
       o."order_id",
       o."user_id",
       o."status"        AS "order_status",
       oi."status"       AS "item_status",
       TO_TIMESTAMP(o."created_at"/1000000) AS "order_created_ts"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
       ON o."order_id" = oi."order_id"
WHERE  o."status" = 'Complete'
  AND  TO_TIMESTAMP(o."created_at"/1000000) < '2023-01-01'
LIMIT 20;
```

```sql
--Description: For each shopper, capture the month of their very first completed purchase up to 2022.
WITH first_purchase AS (
    SELECT "user_id",
           MIN(DATE_TRUNC('month',
               TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_month"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "status" = 'Complete'
      AND TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
    GROUP BY "user_id"
)
SELECT *
FROM first_purchase
LIMIT 20;
```

```sql
--Description: Lay out every purchase a user made together with the month‑offset from their cohort (0,1,2,3…).
WITH first_purchase AS (
    SELECT "user_id",
           MIN(DATE_TRUNC('month',
               TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_month"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "status" = 'Complete'
      AND TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
    GROUP BY "user_id"
)
SELECT fp."user_id",
       fp."first_purchase_month",
       DATE_TRUNC('month',
           TO_TIMESTAMP(o."created_at"/1000000))        AS "order_month",
       DATEDIFF('month', fp."first_purchase_month",
                          DATE_TRUNC('month',
                          TO_TIMESTAMP(o."created_at"/1000000))) AS "month_offset"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
JOIN   first_purchase fp
       ON fp."user_id" = o."user_id"
WHERE  o."status" = 'Complete'
  AND  TO_TIMESTAMP(o."created_at"/1000000) < '2023-01-01'
  AND  DATEDIFF('month', fp."first_purchase_month",
                DATE_TRUNC('month',
                TO_TIMESTAMP(o."created_at"/1000000))) BETWEEN 0 AND 3
LIMIT 20;
```

```sql
--Description: Count how many unique shoppers from any cohort appear in each of the first four relative months (0‑3).
WITH first_purchase AS (
    SELECT "user_id",
           MIN(DATE_TRUNC('month',
               TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_month"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "status" = 'Complete'
      AND TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
    GROUP BY "user_id"
),
activity AS (
    SELECT fp."user_id",
           DATEDIFF('month', fp."first_purchase_month",
                            DATE_TRUNC('month',
                            TO_TIMESTAMP(o."created_at"/1000000))) AS "month_offset"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
    JOIN first_purchase fp
      ON fp."user_id" = o."user_id"
    WHERE o."status" = 'Complete'
      AND TO_TIMESTAMP(o."created_at"/1000000) < '2023-01-01'
      AND DATEDIFF('month', fp."first_purchase_month",
                   DATE_TRUNC('month',
                   TO_TIMESTAMP(o."created_at"/1000000))) BETWEEN 0 AND 3
    GROUP BY fp."user_id", "month_offset"
)
SELECT "month_offset",
       COUNT(DISTINCT "user_id") AS "users_in_month"
FROM activity
GROUP BY "month_offset"
ORDER BY "month_offset"
LIMIT 20;
```

```sql
--Description: Final cohort‑retention style query – overall percentage of shoppers active in months 0‑3 relative to their first purchase (up to 2022).
WITH first_purchase AS (
    SELECT "user_id",
           MIN(DATE_TRUNC('month',
               TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_month"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "status" = 'Complete'
      AND TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
    GROUP BY "user_id"
),
activity AS (
    SELECT fp."user_id",
           DATEDIFF('month', fp."first_purchase_month",
                            DATE_TRUNC('month',
                            TO_TIMESTAMP(o."created_at"/1000000))) AS "month_offset"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
    JOIN first_purchase fp
      ON fp."user_id" = o."user_id"
    WHERE o."status" = 'Complete'
      AND TO_TIMESTAMP(o."created_at"/1000000) < '2023-01-01'
      AND DATEDIFF('month', fp."first_purchase_month",
                   DATE_TRUNC('month',
                   TO_TIMESTAMP(o."created_at"/1000000))) BETWEEN 0 AND 3
    GROUP BY fp."user_id", "month_offset"
),
totals AS (
    SELECT COUNT(DISTINCT "user_id") AS "total_users"
    FROM first_purchase
)
SELECT a."month_offset",
       ROUND(100 * COUNT(DISTINCT a."user_id") / t."total_users", 2) AS "pct_users"
FROM activity a
CROSS JOIN totals t
GROUP BY a."month_offset", t."total_users"
ORDER BY a."month_offset"
LIMIT 20;
```
