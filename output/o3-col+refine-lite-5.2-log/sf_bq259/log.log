Query:
--Description: Lay out every purchase a user made together with the month‑offset from their cohort (0,1,2,3…).
WITH first_purchase AS (
    SELECT "user_id",
           MIN(DATE_TRUNC('month',
               TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_month"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "status" = 'Complete'
      AND TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
    GROUP BY "user_id"
)
SELECT fp."user_id",
       fp."first_purchase_month",
       DATE_TRUNC('month',
           TO_TIMESTAMP(o."created_at"/1000000))        AS "order_month",
       DATEDIFF('month', fp."first_purchase_month",
                          DATE_TRUNC('month',
                          TO_TIMESTAMP(o."created_at"/1000000))) AS "month_offset"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
JOIN   first_purchase fp
       ON fp."user_id" = o."user_id"
WHERE  o."status" = 'Complete'
  AND  TO_TIMESTAMP(o."created_at"/1000000) < '2023-01-01'
  AND  DATEDIFF('month', fp."first_purchase_month",
                DATE_TRUNC('month',
                TO_TIMESTAMP(o."created_at"/1000000))) BETWEEN 0 AND 3
LIMIT 20;
