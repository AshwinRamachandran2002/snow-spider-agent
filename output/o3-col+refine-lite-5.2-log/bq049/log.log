```sql
--Description: 8)  FINAL – Per‑capita (21+) monthly bourbon sales for that ZIP in 2022  
WITH third_zip AS (
  SELECT zip5
  FROM (
    SELECT
      LPAD(REGEXP_EXTRACT(`zip_code`, r'^\d+'), 5, '0')               AS zip5,
      RANK() OVER (ORDER BY SUM(`sale_dollars`) DESC)                AS sales_rank
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE `county` = 'DUBUQUE'
      AND EXTRACT(YEAR FROM `date`) = 2022
      AND LOWER(`category_name`) LIKE '%bourbon%'
    GROUP BY zip5
  )
  WHERE sales_rank = 3
),
pop_21_plus AS (
  SELECT
    SUM(`population`) AS pop_21
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE `gender` IS NULL
    AND `minimum_age` >= 21
    AND LPAD(REGEXP_EXTRACT(`zipcode`, r'^\d+'), 5, '0') = (SELECT zip5 FROM third_zip)
),
monthly_sales AS (
  SELECT
    EXTRACT(MONTH FROM `date`) AS month,
    SUM(`sale_dollars`)        AS monthly_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE `county` = 'DUBUQUE'
    AND EXTRACT(YEAR FROM `date`) = 2022
    AND LOWER(`category_name`) LIKE '%bourbon%'
    AND LPAD(REGEXP_EXTRACT(`zip_code`, r'^\d+'), 5, '0') = (SELECT zip5 FROM third_zip)
  GROUP BY month
)
SELECT
  month,
  monthly_sales,
  monthly_sales / pop_21 AS per_capita_sales
FROM monthly_sales, pop_21_plus
ORDER BY month
LIMIT 20;
```
