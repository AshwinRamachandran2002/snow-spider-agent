```sql
--Description: Recreate “2022 Bourbon‑sales totals by ZIP in Dubuque County”
--             while guarding against data‑format issues that previously caused
--             empty results.  Strategy inside the query:
--   • REGEXP_EXTRACT(`zip_code`, r'^\d{1,5}') pulls the leading 1‑to‑5 digits
--     (drops any trailing “.0”).  LPAD pads to exactly five characters.
--   • Keep the desired filters: county = 'DUBUQUE', sales year = 2022, and any
--     liquor category whose name contains “bourbon”.
--   • Aggregate total sales dollars by the cleaned five‑digit ZIP and list the
--     top 20 ZIPs for verification.
SELECT
  LPAD(REGEXP_EXTRACT(`zip_code`, r'^\d{1,5}'), 5, '0') AS zip5,
  SUM(`sale_dollars`)                                   AS total_sales
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE `county` = 'DUBUQUE'
  AND EXTRACT(YEAR FROM `date`) = 2022
  AND LOWER(`category_name`) LIKE '%bourbon%'
GROUP BY zip5
ORDER BY total_sales DESC
LIMIT 20;
```
