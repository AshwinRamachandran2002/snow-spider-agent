```sql
--Description: End‑to‑end solution in a single query with inline reasoning.
--             Goal:  Per‑capita (age 21+) monthly Bourbon‐whiskey sales in 2022
--                    for the Dubuque‑County ZIP code that ranks 3rd in total
--                    Bourbon sales.  Steps, each inside a CTE:
--   1. bourbon_sales_2022 – pull only 2022 Dubuque rows whose category contains
--        “bourbon”; clean `zip_code` by keeping leading digits and padding to 5.
--   2. zip_rank           – aggregate those rows by ZIP, rank by total sales.
--   3. third_zip          – isolate the ZIP whose rank is 3.
--   4. pop_21_plus        – total 21+ population (gender‑total rows) per ZIP from
--        Census 2010; same ZIP‑cleaning logic.
--   5. monthly_sales      – monthly aggregation of Bourbon sales for that 3rd ZIP.
--   6. Final SELECT       – join monthly sales to population and compute
--        per‑capita dollar sales.
WITH bourbon_sales_2022 AS (
  SELECT
    DATE_TRUNC(`date`, MONTH)                         AS month,          -- normalize to month‑start
    LPAD(REGEXP_EXTRACT(`zip_code`, r'^\d+'), 5, '0') AS zip5,           -- clean ZIP
    `sale_dollars`
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE `county` = 'DUBUQUE'
    AND EXTRACT(YEAR FROM `date`) = 2022
    AND LOWER(`category_name`) LIKE '%bourbon%'                          -- any Bourbon category
),
zip_rank AS (
  SELECT
    zip5,
    SUM(sale_dollars)                       AS total_sales,
    RANK() OVER (ORDER BY SUM(sale_dollars) DESC) AS sales_rank
  FROM bourbon_sales_2022
  GROUP BY zip5
),
third_zip AS (
  SELECT zip5
  FROM zip_rank
  WHERE sales_rank = 3
),
pop_21_plus AS (
  SELECT
    LPAD(REGEXP_EXTRACT(`zipcode`, r'^\d+'), 5, '0') AS zip5,
    SUM(`population`)                               AS pop_21
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE `gender` IS NULL            -- total population rows
    AND `minimum_age` >= 21         -- age 21+
  GROUP BY zip5
),
monthly_sales AS (
  SELECT
    (SELECT zip5 FROM third_zip) AS zip5,
    month,
    SUM(sale_dollars)            AS monthly_sales
  FROM bourbon_sales_2022
  WHERE zip5 = (SELECT zip5 FROM third_zip)
  GROUP BY month
)
SELECT
  FORMAT_DATE('%Y-%m', month)            AS month,
  monthly_sales,
  monthly_sales / pop.pop_21             AS per_capita_sales
FROM monthly_sales  ms
JOIN pop_21_plus   pop
  ON ms.zip5 = pop.zip5
ORDER BY month;
```
