--Description: Single end‑to‑end query that
--  • identifies the Dubuque‑County ZIP code ranking 3rd in total 2022
--    Bourbon‑category liquor sales;
--  • gets that ZIP’s age‑21‑and‑older population from the 2010 Census
--    (summing male + female rows where minimum_age ≥ 21);
--  • aggregates monthly 2022 Bourbon sales dollars for that ZIP; and
--  • computes per‑capita sales by dividing each month’s dollars by the
--    21+ population.  ZIP codes are cleaned with REGEXP_EXTRACT and LPAD
--    to remove trailing “.0” and force five digits, avoiding cast errors.
WITH third_zip AS (          -- find 3rd‑highest‑sales ZIP
  SELECT zip5
  FROM (
    SELECT
      LPAD(REGEXP_EXTRACT(zip_code, r'^\d+'), 5, '0')          AS zip5,
      RANK() OVER (ORDER BY SUM(sale_dollars) DESC)            AS sales_rank
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE county = 'DUBUQUE'
      AND EXTRACT(YEAR FROM date) = 2022
      AND LOWER(category_name) LIKE '%bourbon%'
    GROUP BY zip5
  )
  WHERE sales_rank = 3
),
pop_21_plus AS (             -- age‑21+ population for that ZIP
  SELECT SUM(population) AS pop_21
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE minimum_age >= 21
    AND LPAD(REGEXP_EXTRACT(zipcode, r'^\d+'), 5, '0') = (SELECT zip5 FROM third_zip)
),
monthly_sales AS (           -- 2022 monthly Bourbon dollars for that ZIP
  SELECT
    EXTRACT(MONTH FROM date) AS month_num,
    SUM(sale_dollars)        AS monthly_dollars
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
    AND LPAD(REGEXP_EXTRACT(zip_code, r'^\d+'), 5, '0') = (SELECT zip5 FROM third_zip)
  GROUP BY month_num
)
SELECT
  ms.month_num                        AS month,
  ms.monthly_dollars                  AS monthly_sales,
  ms.monthly_dollars / p.pop_21       AS per_capita_sales
FROM monthly_sales AS ms
CROSS JOIN pop_21_plus AS p
