```sql
--Description: 6)  Bring together the 3rd‑ranked ZIP and its 21+ population  
SELECT
  r.zip5,
  pop.pop_21_plus
FROM (
  -- rank Dubuque ZIPs by 2022 Bourbon sales
  SELECT
    LPAD(REGEXP_EXTRACT(`zip_code`, r'^\d+'), 5, '0') AS zip5,
    RANK() OVER (ORDER BY SUM(`sale_dollars`) DESC)   AS sales_rank
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE `county` = 'DUBUQUE'
    AND EXTRACT(YEAR FROM `date`) = 2022
    AND LOWER(`category_name`) LIKE '%bourbon%'
  GROUP BY zip5
) AS r
JOIN (
  -- age‑21‑plus population per ZIP (sum male + female rows; no gender filter)
  SELECT
    LPAD(REGEXP_EXTRACT(`zipcode`, r'^\d+'), 5, '0') AS zip5,
    SUM(`population`)                               AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE `minimum_age` >= 21
  GROUP BY zip5
) AS pop
ON r.zip5 = pop.zip5
WHERE r.sales_rank = 3
LIMIT 20;
