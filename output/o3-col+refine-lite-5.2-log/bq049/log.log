```sql
--Description: 8)  FINAL – Per‑capita (21+) monthly bourbon sales for that ZIP in 2022  
SELECT ms.`month`,
       ms.`monthly_sales`,
       ms.`monthly_sales` / pop.`pop_21_plus`  AS `per_capita_sales`
FROM  (
        SELECT EXTRACT(MONTH FROM `date`) AS `month`,
               SUM(`sale_dollars`)        AS `monthly_sales`
        FROM   `bigquery-public-data.iowa_liquor_sales.sales`
        WHERE  `county`             = 'DUBUQUE'
          AND  EXTRACT(YEAR FROM `date`) = 2022
          AND  LOWER(`category_name`) LIKE '%bourbon%'
          AND  LPAD(CAST(CAST(`zip_code` AS INT64) AS STRING),5,'0') = (
                  SELECT `zip5`
                  FROM (
                          SELECT LPAD(CAST(CAST(`zip_code` AS INT64) AS STRING),5,'0') AS `zip5`,
                                 RANK() OVER(ORDER BY SUM(`sale_dollars`) DESC)        AS `sales_rank`
                          FROM   `bigquery-public-data.iowa_liquor_sales.sales`
                          WHERE  `county`             = 'DUBUQUE'
                            AND  EXTRACT(YEAR FROM `date`) = 2022
                            AND  LOWER(`category_name`) LIKE '%bourbon%'
                          GROUP  BY `zip5`
                       )
                  WHERE `sales_rank` = 3
               )
        GROUP  BY `month`
      )  AS ms
CROSS JOIN (
        SELECT SUM(`population`) AS `pop_21_plus`
        FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
        WHERE  `gender` IS NULL
          AND  `minimum_age` >= 21
          AND  `zipcode` = (
                  SELECT `zip5`
                  FROM (
                          SELECT LPAD(CAST(CAST(`zip_code` AS INT64) AS STRING),5,'0') AS `zip5`,
                                 RANK() OVER(ORDER BY SUM(`sale_dollars`) DESC)        AS `sales_rank`
                          FROM   `bigquery-public-data.iowa_liquor_sales.sales`
                          WHERE  `county`             = 'DUBUQUE'
                            AND  EXTRACT(YEAR FROM `date`) = 2022
                            AND  LOWER(`category_name`) LIKE '%bourbon%'
                          GROUP  BY `zip5`
                       )
                  WHERE `sales_rank` = 3
               )
      ) AS pop
ORDER BY ms.`month`
LIMIT 20;
```

The last query returns one row per month (Jan – Dec 2022) showing  
• total bourbon‑whiskey sales dollars in that month (for the 3rd‑ranked Dubuque‑County ZIP)  
• the per‑capita dollar amount, using only the population aged 21 and older.
