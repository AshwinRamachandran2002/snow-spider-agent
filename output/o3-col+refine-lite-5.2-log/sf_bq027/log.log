--    with outer => TRUE so patents that have no citation array still join
--    once (f.value = NULL), ensuring they remain in the result.
-- 3. Use a CASE inside COUNT: emit 1 only when the flattened object's
--    "category" ILIKE '%SEA%'; NULLs are ignored by COUNT, so the result
--    becomes 0 when no SEA citations exist.
-- 4. GROUP BY publication_number; LIMIT 20 for a quick preview.
SELECT
    p."publication_number",
    COUNT(
        CASE
            WHEN f.value::VARIANT:"category"::STRING ILIKE '%SEA%' THEN 1
        END
    ) AS "sea_cit_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS AS p
CROSS JOIN LATERAL FLATTEN(
        input  => p."citation",
        outer  => TRUE
     ) AS f
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
GROUP BY p."publication_number"
LIMIT 20;
