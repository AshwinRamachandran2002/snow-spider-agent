Query:
--Description: 7) Distinct citation categories present in 2010‑2018 publications
SELECT DISTINCT
  f.value::VARIANT:"category"::STRING AS "citation_category"
FROM PATENTS.PATENTS.PUBLICATIONS AS t
CROSS JOIN LATERAL FLATTEN(
        input => t."citation"
