Query:
--Description: 9) Year‑by‑year total count of SEA backward citations for grants 2010‑2018
SELECT 
  SUBSTR(TO_CHAR(t."grant_date"), 1, 4) AS "grant_year",
  COUNT(*)                               AS "total_sea_citations"
FROM PATENTS.PATENTS.PUBLICATIONS AS t
CROSS JOIN LATERAL FLATTEN(
        input => t."citation"
     ) AS f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value::VARIANT:"category"::STRING ILIKE '%SEA%'
GROUP BY SUBSTR(TO_CHAR(t."grant_date"), 1, 4)
ORDER BY "grant_year"
LIMIT 20
