```sql
--Description: Goal → for every patent granted between 2010‑2018, count how many
--backward citations fall in the SEA category, showing 0 when none exist.
--Approach:
-- 1. Limit PUBLICATIONS to grant_date 20100101‑20181231.
-- 2. Use LEFT JOIN LATERAL FLATTEN with OUTER => TRUE so patents with an
--    empty / NULL "citation" array still appear once (f.value = NULL).
-- 3. Inside COUNT use a CASE that returns 1 only when the flattened object’s
--    "category" contains 'SEA'.  NULLs are ignored, giving a 0 total when
--    no SEA citations are present.
-- 4. GROUP BY publication_number; LIMIT 20 just for preview.
SELECT
    p."publication_number",
    COUNT(
        CASE
            WHEN f.value::VARIANT:"category"::STRING ILIKE '%SEA%' THEN 1
        END
    ) AS "sea_cit_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS AS p
LEFT JOIN LATERAL FLATTEN(
        input => p."citation",
        outer => TRUE
     ) AS f ON TRUE
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
GROUP BY p."publication_number"
LIMIT 20;
```
