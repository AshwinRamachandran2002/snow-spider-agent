Query:
--Description: 4) Peek only those backward citations that belong to the SEA category
SELECT 
  t."publication_number"          AS "pub_nr",
  f.value::VARIANT:"publication_number"::STRING AS "cited_pub_nr",
  f.value::VARIANT:"category"::STRING           AS "cit_cat"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value::VARIANT:"category"::STRING ILIKE '%SEA%'
LIMIT 20;
