```sql
--Description: 1) Quick look at patents granted between 2010‑2018 that have at least one citation entry
SELECT 
  "publication_number",
  "grant_date",
  "citation"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "grant_date" BETWEEN 20100101 AND 20181231
  AND ARRAY_SIZE("citation") > 0
LIMIT 20;
```

```sql
--Description: 2) Inspect the structure of a single “citation” array element
SELECT 
  "publication_number",
  f.value AS "one_citation_record"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND ARRAY_SIZE(t."citation") > 0
LIMIT 20;
```

```sql
--Description: 3) Check what keys are stored inside each citation object (e.g., category, pub_nr, etc.)
SELECT 
  DISTINCT f.value::VARIANT:"category"::STRING          AS "cit_cat",
  f.value::VARIANT:"publication_number"::STRING        AS "cited_pub_nr"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND ARRAY_SIZE(t."citation") > 0
LIMIT 20;
```

```sql
--Description: 4) Peek only those backward citations that belong to the SEA category
SELECT 
  t."publication_number"          AS "pub_nr",
  f.value::VARIANT:"publication_number"::STRING AS "cited_pub_nr",
  f.value::VARIANT:"category"::STRING           AS "cit_cat"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value::VARIANT:"category"::STRING ILIKE '%SEA%'
LIMIT 20;
```

```sql
--Description: 5) Count how many SEA backward citations each publication has (top 20 randomly)
SELECT 
  t."publication_number",
  COUNT(*) AS "sea_backward_cit_count"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value::VARIANT:"category"::STRING ILIKE '%SEA%'
GROUP BY t."publication_number"
LIMIT 20;
```

```sql
--Description: 6) Same as #5 but show a few with zero SEA citations for comparison
SELECT 
  "publication_number",
  COALESCE( (
      SELECT COUNT(*) 
      FROM LATERAL FLATTEN(input => p."citation") f 
      WHERE f.value::VARIANT:"category"::STRING ILIKE '%SEA%'
  ), 0 ) AS "sea_cit_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS p
WHERE p."grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: 7) Get distinct citation categories in 2010‑2018 to verify ‘SEA’ presence
SELECT DISTINCT
  f.value::VARIANT:"category"::STRING AS "citation_category"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
LIMIT 20;
```

```sql
--Description: 8) Verify whether citation direction field exists (sometimes named “type” or “direction”)
SELECT DISTINCT
  f.value::VARIANT:"direction"::STRING AS "cit_direction",
  f.value::VARIANT:"category"::STRING  AS "cit_category"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value::VARIANT:"category"::STRING ILIKE '%SEA%'
LIMIT 20;
```

```sql
--Description: 9) Aggregate SEA backward‑citation counts per grant year (2010‑2018)
SELECT 
  SUBSTR(TO_CHAR("grant_date"), 1, 4) AS "grant_year",
  COUNT(*)                            AS "total_sea_citations"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value::VARIANT:"category"::STRING ILIKE '%SEA%'
GROUP BY SUBSTR(TO_CHAR("grant_date"), 1, 4)
ORDER BY "grant_year"
LIMIT 20;
```

```sql
--Description: 10) Final form — list every publication (2010‑2018) with its SEA backward‑citation count (this is the core for answering the task)
SELECT 
  t."publication_number",
  COUNT(*) AS "sea_backward_citation_count"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20181231
  AND f.value::VARIANT:"category"::STRING ILIKE '%SEA%'
GROUP BY t."publication_number"
ORDER BY "sea_backward_citation_count" DESC
LIMIT 20;
```
