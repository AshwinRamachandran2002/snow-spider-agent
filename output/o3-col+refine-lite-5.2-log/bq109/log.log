```sql
--Description: Join with studies table to see the reported GWAS trait
SELECT c.left_study,
       s.trait_reported,
       c.coloc_log2_h4_h3
FROM `open-targets-genetics.genetics.variant_disease_coloc` AS c
JOIN `open-targets-genetics.genetics.studies`              AS s
  ON c.left_study = s.study_id
WHERE c.left_chrom = '1'
  AND c.left_pos  = 55029009
  AND c.left_ref  = 'C'
  AND c.left_alt  = 'T'
  AND c.right_gene_id = 'ENSG00000169174'
  AND c.coloc_h4 > 0.8
  AND c.coloc_h3 < 0.02
  AND c.right_bio_feature = 'IPSC'
  AND LOWER(s.trait_reported) LIKE '%lesterol levels%'
LIMIT 20;
```

```sql
--Description: Compute average, population variance, and max‑min range of log2(h4/h3)
SELECT
  AVG(c.coloc_log2_h4_h3)                         AS avg_log2_h4_h3,
  VAR_POP(c.coloc_log2_h4_h3)                     AS var_log2_h4_h3,
  MAX(c.coloc_log2_h4_h3) - MIN(c.coloc_log2_h4_h3) AS range_log2_h4_h3
FROM `open-targets-genetics.genetics.variant_disease_coloc` AS c
JOIN `open-targets-genetics.genetics.studies`              AS s
  ON c.left_study = s.study_id
WHERE c.left_chrom = '1'
  AND c.left_pos  = 55029009
  AND c.left_ref  = 'C'
  AND c.left_alt  = 'T'
  AND c.right_gene_id = 'ENSG00000169174'
  AND c.coloc_h4 > 0.8
  AND c.coloc_h3 < 0.02
  AND c.right_bio_feature = 'IPSC'
  AND LOWER(s.trait_reported) LIKE '%lesterol levels%';
```

```sql
--Description: Identify the right‑hand study (QTL source) with the maximum log2(h4/h3)
SELECT
  c.right_study          AS qtl_source,
  c.coloc_log2_h4_h3
FROM `open-targets-genetics.genetics.variant_disease_coloc` AS c
JOIN `open-targets-genetics.genetics.studies`              AS s
  ON c.left_study = s.study_id
WHERE c.left_chrom = '1'
  AND c.left_pos  = 55029009
  AND c.left_ref  = 'C'
  AND c.left_alt  = 'T'
  AND c.right_gene_id = 'ENSG00000169174'
  AND c.coloc_h4 > 0.8
  AND c.coloc_h3 < 0.02
  AND c.right_bio_feature = 'IPSC'
  AND LOWER(s.trait_reported) LIKE '%lesterol levels%'
ORDER BY c.coloc_log2_h4_h3 DESC
LIMIT 1;
```
