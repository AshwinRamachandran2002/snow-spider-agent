  AND left_pos  = 55029009
  AND left_ref  = 'C'
  AND left_alt  = 'T'
  AND right_gene_id = 'ENSG00000169174'
  AND coloc_h4 > 0.8
  AND coloc_h3 < 0.02
LIMIT 20;
