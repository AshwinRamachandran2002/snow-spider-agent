Query:
--Description: 4.  Count how many PAGE‑VIEW events each product received (filtered page_id)  
SELECT h."page_name",
       COUNT(*) AS "views"
FROM   "shopping_cart_events"  e
JOIN   "shopping_cart_page_hierarchy" h
       ON e."page_id" = h."page_id"
WHERE  e."event_type" = 1             -- Page View
  AND  e."page_id"   NOT IN (1,2,12,13)
GROUP  BY h."page_name"
ORDER  BY views DESC
LIMIT 20;
