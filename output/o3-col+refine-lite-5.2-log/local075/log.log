Query:
--Description: 5.  Count how many ADD‑TO‑CART events each product received  
SELECT h."page_name",
       COUNT(*) AS "add_to_cart"
FROM   "shopping_cart_events"  e
JOIN   "shopping_cart_page_hierarchy" h
       ON e."page_id" = h."page_id"
WHERE  e."event_type" = 2             -- Add to Cart
  AND  e."page_id"   NOT IN (1,2,12,13)
GROUP  BY h."page_name"
ORDER  BY add_to_cart DESC
