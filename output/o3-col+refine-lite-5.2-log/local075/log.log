GROUP  BY h."page_name"
ORDER  BY views DESC
LIMIT 20;
```

```sql
--Description: 5.  Count how many ADD‑TO‑CART events each product received  
SELECT h."page_name",
       COUNT(*) AS "add_to_cart"
FROM   "shopping_cart_events"  e
JOIN   "shopping_cart_page_hierarchy" h
       ON e."page_id" = h."page_id"
WHERE  e."event_type" = 2             -- Add to Cart
  AND  e."page_id"   NOT IN (1,2,12,13)
GROUP  BY h."page_name"
ORDER  BY add_to_cart DESC
LIMIT 20;
```

```sql
--Description: 6.  Count how many PURCHASE events each product recorded  
SELECT h."page_name",
       COUNT(*) AS "purchases"
FROM   "shopping_cart_events"  e
JOIN   "shopping_cart_page_hierarchy" h
       ON e."page_id" = h."page_id"
WHERE  e."event_type" = 3             -- Purchase
  AND  e."page_id"   NOT IN (1,2,12,13)
GROUP  BY h."page_name"
ORDER  BY purchases DESC
LIMIT 20;
```

```sql
--Description: 7.  Provide one consolidated table with views, add‑to‑cart, and purchases for every product  
SELECT h."page_name",
       SUM(CASE WHEN e."event_type" = 1 THEN 1 ELSE 0 END) AS "views",
       SUM(CASE WHEN e."event_type" = 2 THEN 1 ELSE 0 END) AS "add_to_cart",
       SUM(CASE WHEN e."event_type" = 3 THEN 1 ELSE 0 END) AS "purchases"
FROM   "shopping_cart_events"  e
JOIN   "shopping_cart_page_hierarchy" h
       ON e."page_id" = h."page_id"
WHERE  e."page_id" NOT IN (1,2,12,13)
GROUP  BY h."page_name"
LIMIT 20;
```

```sql
--Description: 8.  Add a column for items that were left in the cart without purchase  
SELECT h."page_name",
       SUM(CASE WHEN e."event_type" = 1 THEN 1 ELSE 0 END) AS "views",
       SUM(CASE WHEN e."event_type" = 2 THEN 1 ELSE 0 END) AS "add_to_cart",
       SUM(CASE WHEN e."event_type" = 3 THEN 1 ELSE 0 END) AS "purchases",
       SUM(CASE WHEN e."event_type" = 2 THEN 1 ELSE 0 END) -
       SUM(CASE WHEN e."event_type" = 3 THEN 1 ELSE 0 END) AS "abandoned_cart"
FROM   "shopping_cart_events"  e
JOIN   "shopping_cart_page_hierarchy" h
       ON e."page_id" = h."page_id"
WHERE  e."page_id" NOT IN (1,2,12,13)
GROUP  BY h."page_name"
LIMIT 20;
