Query:
--Description: Compute average payment per order and customer lifespan (days / 7) for each customer
SELECT cstats."customer_id",
       cstats."n_orders",
       ROUND(cstats."total_paid" * 1.0 / cstats."n_orders", 2)      AS "avg_payment_per_order",
       CASE
           WHEN ((julianday(cstats."last_purchase") -
                  julianday(cstats."first_purchase")) / 7.0) < 1
           THEN 1.0
           ELSE ROUND((julianday(cstats."last_purchase") -
                       julianday(cstats."first_purchase")) / 7.0, 2)
       END                                                          AS "customer_lifespan_weeks"
FROM  (
        SELECT o."customer_id",
               COUNT(DISTINCT o."order_id")                       AS "n_orders",
               SUM(op."payment_value")                            AS "total_paid",
               MIN(o."order_purchase_timestamp")                  AS "first_purchase",
               MAX(o."order_purchase_timestamp")                  AS "last_purchase"
        FROM   "orders" o
        JOIN   "order_payments" op
               ON op."order_id" = o."order_id"
        GROUP  BY o."customer_id"
      ) AS cstats
LIMIT 20;
Answer:
