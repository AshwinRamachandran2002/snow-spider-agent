```sql
--Description: Peek at different order statuses available in the data
SELECT DISTINCT "order_status"
FROM "orders"
LIMIT 20;
```

```sql
--Description: Inspect how many payment records exist per order (should usually be 1)
SELECT "order_id",
       COUNT(*) AS "payment_records"
FROM "order_payments"
GROUP BY "order_id"
LIMIT 20;
```

```sql
--Description: Review the total amount actually paid for a sample of orders
SELECT op."order_id",
       SUM(op."payment_value") AS "total_payment_value"
FROM "order_payments" op
GROUP BY op."order_id"
LIMIT 20;
```

```sql
--Description: Join orders with their total‑payment values to see the monetary size of each purchase
SELECT o."order_id",
       o."customer_id",
       SUM(op."payment_value") AS "total_payment_value",
       o."order_purchase_timestamp"
FROM "orders"  o
JOIN "order_payments" op
  ON op."order_id" = o."order_id"
GROUP BY o."order_id"
LIMIT 20;
```

```sql
--Description: Aggregate number of orders and total paid amount for every customer
SELECT o."customer_id",
       COUNT(DISTINCT o."order_id")                       AS "n_orders",
       SUM(op."payment_value")                            AS "total_paid"
FROM   "orders" o
JOIN   "order_payments" op
       ON op."order_id" = o."order_id"
GROUP  BY o."customer_id"
LIMIT 20;
```

```sql
--Description: Check earliest and latest purchase dates for a group of customers
SELECT o."customer_id",
       MIN(o."order_purchase_timestamp") AS "first_purchase",
       MAX(o."order_purchase_timestamp") AS "last_purchase"
FROM   "orders" o
GROUP  BY o."customer_id"
LIMIT 20;
```

```sql
--Description: Combine monetary and temporal info per customer: orders, total paid, earliest & latest dates
SELECT o."customer_id",
       COUNT(DISTINCT o."order_id")                       AS "n_orders",
       SUM(op."payment_value")                            AS "total_paid",
       MIN(o."order_purchase_timestamp")                  AS "first_purchase",
       MAX(o."order_purchase_timestamp")                  AS "last_purchase"
FROM   "orders" o
JOIN   "order_payments" op
       ON op."order_id" = o."order_id"
GROUP  BY o."customer_id"
LIMIT 20;
```

```sql
--Description: Compute average payment per order and customer lifespan (days / 7) for each customer
SELECT cstats."customer_id",
       cstats."n_orders",
       ROUND(cstats."total_paid" * 1.0 / cstats."n_orders", 2)      AS "avg_payment_per_order",
       CASE
           WHEN ((julianday(cstats."last_purchase") -
                  julianday(cstats."first_purchase")) / 7.0) < 1
           THEN 1.0
           ELSE ROUND((julianday(cstats."last_purchase") -
                       julianday(cstats."first_purchase")) / 7.0, 2)
       END                                                          AS "customer_lifespan_weeks"
FROM  (
        SELECT o."customer_id",
               COUNT(DISTINCT o."order_id")                       AS "n_orders",
               SUM(op."payment_value")                            AS "total_paid",
               MIN(o."order_purchase_timestamp")                  AS "first_purchase",
               MAX(o."order_purchase_timestamp")                  AS "last_purchase"
        FROM   "orders" o
        JOIN   "order_payments" op
               ON op."order_id" = o."order_id"
        GROUP  BY o."customer_id"
      ) AS cstats
LIMIT 20;
```

```sql
--Description: Final answer – return the 3 customers with the highest average payment per order,
--             together with their number of orders and lifespan in weeks (minimum 1.0)
SELECT cstats."customer_id",
       cstats."n_orders"                                          AS "number_of_orders",
       ROUND(cstats."total_paid" * 1.0 / cstats."n_orders", 2)    AS "avg_payment_per_order",
       CASE
           WHEN ((julianday(cstats."last_purchase") -
                  julianday(cstats."first_purchase")) / 7.0) < 1
           THEN 1.0
           ELSE ROUND((julianday(cstats."last_purchase") -
                       julianday(cstats."first_purchase")) / 7.0, 2)
       END                                                        AS "customer_lifespan_weeks"
FROM  (
        SELECT o."customer_id",
               COUNT(DISTINCT o."order_id")      AS "n_orders",
               SUM(op."payment_value")           AS "total_paid",
               MIN(o."order_purchase_timestamp") AS "first_purchase",
               MAX(o."order_purchase_timestamp") AS "last_purchase"
        FROM   "orders" o
        JOIN   "order_payments" op
               ON op."order_id" = o."order_id"
        GROUP  BY o."customer_id"
      ) AS cstats
ORDER BY "avg_payment_per_order" DESC
LIMIT 3;
```
