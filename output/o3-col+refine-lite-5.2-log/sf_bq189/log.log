```sql
--Description:  End‑to‑end solution in one statement.
-- 1) monthly_orders       – distinct completed‑order counts per category per month
-- 2) order_growth         – month‑over‑month % change of those counts
-- 3) avg_order_growth     – average of those % changes for every category
-- 4) top_category         – category with the highest average order‑growth rate
-- 5) monthly_revenue_top  – monthly revenue (sum sale_price) for that top category
-- 6) revenue_growth       – month‑over‑month % change of that revenue
-- 7) final SELECT         – returns the top category plus its average order‑ and revenue‑growth rates
WITH monthly_orders AS (
    SELECT
        p."category"                                            AS "CATEGORY",
        TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1000000),'YYYY-MM') AS "ORDER_MONTH",
        COUNT(DISTINCT oi."order_id")                           AS "ORDERS_IN_MONTH"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
      ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
    GROUP BY
        p."category",
        TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1000000),'YYYY-MM')
), order_growth AS (
    SELECT
        "CATEGORY",
        ("ORDERS_IN_MONTH" 
         - LAG("ORDERS_IN_MONTH") OVER (PARTITION BY "CATEGORY" ORDER BY "ORDER_MONTH"))
         / NULLIF(LAG("ORDERS_IN_MONTH") OVER (PARTITION BY "CATEGORY" ORDER BY "ORDER_MONTH"),0)
         AS "PCT_CHANGE"
    FROM monthly_orders
), avg_order_growth AS (
    SELECT
        "CATEGORY",
        AVG("PCT_CHANGE") AS "AVG_ORDER_GROWTH"
    FROM order_growth
    WHERE "PCT_CHANGE" IS NOT NULL
    GROUP BY "CATEGORY"
), top_category AS (
    SELECT
        "CATEGORY",
        "AVG_ORDER_GROWTH"
    FROM   avg_order_growth
    ORDER  BY "AVG_ORDER_GROWTH" DESC
    LIMIT 1
), monthly_revenue_top AS (
    SELECT
        TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1000000),'YYYY-MM') AS "REV_MONTH",
        SUM(oi."sale_price")                                       AS "REV_IN_MONTH"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
      ON   oi."product_id" = p."id"
    WHERE  oi."status" = 'Complete'
      AND  p."category" = (SELECT "CATEGORY" FROM top_category)
    GROUP  BY TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1000000),'YYYY-MM')
), revenue_growth AS (
    SELECT
        ("REV_IN_MONTH" 
         - LAG("REV_IN_MONTH") OVER (ORDER BY "REV_MONTH"))
         / NULLIF(LAG("REV_IN_MONTH") OVER (ORDER BY "REV_MONTH"),0)
         AS "REV_PCT_CHANGE"
    FROM monthly_revenue_top
)
SELECT
    (SELECT "CATEGORY" FROM top_category)                       AS "TOP_CATEGORY",
    ROUND((SELECT "AVG_ORDER_GROWTH" FROM top_category),4)      AS "AVG_MONTHLY_ORDER_GROWTH_RATE",
    ROUND(AVG("REV_PCT_CHANGE"),4)                              AS "AVG_MONTHLY_REVENUE_GROWTH_RATE"
FROM revenue_growth
WHERE "REV_PCT_CHANGE" IS NOT NULL;
