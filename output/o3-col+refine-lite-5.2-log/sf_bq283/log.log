```sql
--Description / Thinking process:
-- We need the stations that are currently “active” and whose number of STARTING trips places them
-- in the TOP‑15 ranks (ties included).  To build this in a single query:
-- 1)  In subquery r we join TRIPS to STATIONS, filter to active stations, group by start_station_id,
--     calculate total_start_trips and avg_duration, and assign ranks with RANK() over trip counts
--     (DESC so rank 1 is highest).  
-- 2)  In subquery o we simply count how many trips begin at ANY active station so we can compute
--     the percent share for every top station.  
-- 3)  The outer SELECT keeps rows whose rank ≤ 15, derives the percentage, and orders neatly.

SELECT
       r."start_station_id"                                                      AS "station_id",
       r."total_start_trips",
       ROUND(r."total_start_trips" * 100.0 / o."overall_active_start_trips", 2)  AS "percent_of_active_trips",
       r."avg_duration",
       r."station_rank"
FROM (
        SELECT
               t."start_station_id",
               COUNT(*)                                 AS "total_start_trips",
               AVG(t."duration_minutes")                AS "avg_duration",
               RANK() OVER (ORDER BY COUNT(*) DESC)     AS "station_rank"
        FROM  AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS     t
        JOIN  AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS  s
              ON t."start_station_id" = s."station_id"
        WHERE s."status" ILIKE '%active%'
        GROUP BY t."start_station_id"
     ) r
CROSS JOIN (
        SELECT COUNT(*) AS "overall_active_start_trips"
        FROM  AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_TRIPS     t
        JOIN  AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS  s
              ON t."start_station_id" = s."station_id"
        WHERE s."status" ILIKE '%active%'
     ) o
WHERE r."station_rank" <= 15          -- keep only top‑15 ranks (ties included)
ORDER BY r."station_rank", r."start_station_id";
```
