```sql
--Description: Preview raw logs to understand available columns and data shape.
SELECT 
  "block_number",
  "transaction_hash",
  "log_index",
  "address",
  "topics",
  "data"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
LIMIT 20;
```

```sql
--Description: Inspect a handful of decoded events to see JSON structure inside the "ARGS" column.
SELECT 
  "BLOCK_NUMBER",
  "EVENT_SIGNATURE",
  "ARGS",
  "TOPICS",
  "ADDRESS"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
LIMIT 20;
```

```sql
--Description: List distinct event signatures that appear in the decoded‑events table.
SELECT DISTINCT 
  "EVENT_SIGNATURE"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
LIMIT 20;
```

```sql
--Description: Count how often each event signature occurs to spot the most frequent events.
SELECT 
  "EVENT_SIGNATURE",
  COUNT(*) AS "event_count"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
GROUP BY "EVENT_SIGNATURE"
ORDER BY "event_count" DESC
LIMIT 20;
```

```sql
--Description: Look specifically at “Transfer” events and pull the raw JSON array from "ARGS" for inspection.
SELECT 
  "BLOCK_NUMBER",
  "TRANSACTION_HASH",
  "ARGS"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
LIMIT 20;
```

```sql
--Description: Parse the JSON array inside "ARGS" for Transfer events to expose from‑/to‑/amount fields.
SELECT 
  "BLOCK_NUMBER",
  "TRANSACTION_HASH",
  PARSE_JSON("ARGS")[0]::STRING  AS "from_address",
  PARSE_JSON("ARGS")[1]::STRING  AS "to_address",
  PARSE_JSON("ARGS")[2]::STRING  AS "amount"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
LIMIT 20;
```

```sql
--Description: Aggregate counts of how many times each sender ("from_address") appears in Transfer events since 1‑Jan‑2023.
SELECT 
  PARSE_JSON("ARGS")[0]::STRING AS "from_address",
  COUNT(*)                     AS "transfer_events"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672531200     -- 1‑Jan‑2023 (seconds)
GROUP BY "from_address"
ORDER BY "transfer_events" DESC
LIMIT 20;
```

```sql
--Description: Show only those Transfer events whose “to_address” is not the zero‑address.
SELECT 
  PARSE_JSON("ARGS")[0]::STRING AS "from_address",
  PARSE_JSON("ARGS")[1]::STRING AS "to_address",
  "BLOCK_NUMBER",
  "TRANSACTION_HASH"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
LIMIT 20;
```

```sql
--Description: Count how many unique transactions each sender address initiated (non‑null “to_address”) since 1‑Jan‑2023.
SELECT 
  PARSE_JSON("ARGS")[0]::STRING  AS "from_address",
  COUNT(DISTINCT "TRANSACTION_HASH") AS "unique_txns"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
  AND "BLOCK_TIMESTAMP" >= 1672531200
GROUP BY "from_address"
ORDER BY "unique_txns" DESC
LIMIT 20;
```

```sql
--Description: Bring everything together – filter for blocks after 2023‑01‑01, non‑zero “to_address”, and rank senders by total occurrences.
SELECT 
  CONCAT('https://cronoscan.com/address/', LOWER(PARSE_JSON("ARGS")[0]::STRING)) AS "sender_url",
  COUNT(*) AS "total_occurrences"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
  AND "BLOCK_TIMESTAMP" >= 1672531200
GROUP BY "sender_url"
ORDER BY "total_occurrences" DESC
LIMIT 20;
```
