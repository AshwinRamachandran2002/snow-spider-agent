```

```sql
-- 2. Verify the language_id that corresponds to “English”
SELECT DISTINCT language_id, name
FROM language
WHERE name = 'English'
LIMIT 20;
```

```sql
-- 3. List films that are in English, rated G or PG, released 2000‑2010, and 120 min or less
SELECT DISTINCT film_id,
       title,
       release_year,
       rating,
       length
FROM film
WHERE language_id = 1                -- English
  AND rating IN ('G','PG')
  AND CAST(release_year AS INTEGER) BETWEEN 2000 AND 2010
  AND length <= 120
LIMIT 20;
```

```sql
-- 4. Show films that belong to the “Children” category
SELECT DISTINCT f.film_id,
       f.title
FROM film AS f
JOIN film_category AS fc
  ON f.film_id = fc.film_id
WHERE fc.category_id = 3              -- Children
LIMIT 20;
```

```sql
-- 5. Combine all conditions to get the target list of films
SELECT DISTINCT f.film_id,
       f.title
FROM film AS f
JOIN film_category AS fc
  ON f.film_id = fc.film_id
WHERE fc.category_id = 3              -- Children
  AND f.language_id = 1               -- English
  AND f.rating IN ('G','PG')
  AND CAST(f.release_year AS INTEGER) BETWEEN 2000 AND 2010
  AND f.length <= 120
LIMIT 20;
```

```sql
-- 6. Retrieve the actors who appear in those target films
SELECT DISTINCT fa.actor_id
FROM film_actor AS fa
WHERE fa.film_id IN (
    SELECT f.film_id
    FROM film AS f
    JOIN film_category AS fc
      ON f.film_id = fc.film_id
    WHERE fc.category_id = 3
      AND f.language_id = 1
      AND f.rating IN ('G','PG')
      AND CAST(f.release_year AS INTEGER) BETWEEN 2000 AND 2010
      AND f.length <= 120
)
LIMIT 20;
```

```sql
-- 7. Count how many target films each actor has appeared in
SELECT a.actor_id,
       a.first_name || ' ' || a.last_name AS full_name,
       COUNT(*) AS film_count
FROM actor AS a
JOIN film_actor AS fa
  ON a.actor_id = fa.actor_id
JOIN film AS f
  ON f.film_id = fa.film_id
JOIN film_category AS fc
  ON f.film_id = fc.film_id
WHERE fc.category_id = 3
  AND f.language_id = 1
  AND f.rating IN ('G','PG')
  AND CAST(f.release_year AS INTEGER) BETWEEN 2000 AND 2010
  AND f.length <= 120
GROUP BY a.actor_id
ORDER BY film_count DESC, full_name
LIMIT 20;
```

```sql
-- 8. Final answer: actor with the highest count of qualifying films
SELECT a.first_name || ' ' || a.last_name AS full_name
FROM actor AS a
JOIN film_actor AS fa
  ON a.actor_id = fa.actor_id
JOIN film AS f
  ON f.film_id = fa.film_id
JOIN film_category AS fc
  ON f.film_id = fc.film_id
WHERE fc.category_id = 3
  AND f.language_id = 1
  AND f.rating IN ('G','PG')
  AND CAST(f.release_year AS INTEGER) BETWEEN 2000 AND 2010
  AND f.length <= 120
GROUP BY a.actor_id
ORDER BY COUNT(*) DESC, full_name
LIMIT 1;
```
