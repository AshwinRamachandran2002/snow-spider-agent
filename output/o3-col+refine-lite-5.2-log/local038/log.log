Query:
-- 6. Retrieve the actors who appear in those target films
SELECT DISTINCT fa.actor_id
FROM film_actor AS fa
WHERE fa.film_id IN (
    SELECT f.film_id
    FROM film AS f
    JOIN film_category AS fc
      ON f.film_id = fc.film_id
    WHERE fc.category_id = 3
      AND f.language_id = 1
      AND f.rating IN ('G','PG')
      AND CAST(f.release_year AS INTEGER) BETWEEN 2000 AND 2010
      AND f.length <= 120
)
LIMIT 20;
