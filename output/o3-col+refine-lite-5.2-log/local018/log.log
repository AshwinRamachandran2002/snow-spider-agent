```sql
-- Description: Put 2011 and 2021 side‑by‑side for the most common 2021 category
WITH totals AS (
      SELECT 2021 AS yr, COUNT(*) AS tot
      FROM collisions c
      JOIN case_ids y ON c.case_id = y.case_id
      WHERE y.db_year = 2021
      UNION ALL
      SELECT 2011, COUNT(*)
      FROM collisions c
      JOIN case_ids y ON c.case_id = y.case_id
      WHERE y.db_year = 2011
),
top21 AS (
      SELECT c.pcf_violation_category, COUNT(*) AS cnt21
      FROM   collisions c
      JOIN   case_ids  y ON c.case_id = y.case_id
      WHERE  y.db_year = 2021
      GROUP BY c.pcf_violation_category
      ORDER BY cnt21 DESC
      LIMIT 1
),
cat11 AS (
      SELECT c.pcf_violation_category, COUNT(*) AS cnt11
      FROM   collisions c
      JOIN   case_ids  y ON c.case_id = y.case_id
      WHERE  y.db_year = 2011
        AND c.pcf_violation_category = (SELECT pcf_violation_category FROM top21)
)
SELECT t21.pcf_violation_category                      AS category,
       ROUND(100.0*cnt21/tot21.tot,2)                  AS share_2021_pct,
       ROUND(100.0*cnt11/tot11.tot,2)                  AS share_2011_pct,
       ROUND(100.0*cnt11/tot11.tot
            -100.0*cnt21/tot21.tot,2)                  AS pct_point_decrease
FROM   top21  t21
CROSS  JOIN totals tot21      ON tot21.yr = 2021
CROSS  JOIN cat11  c11
CROSS  JOIN totals tot11      ON tot11.yr = 2011
LIMIT 20;
```

