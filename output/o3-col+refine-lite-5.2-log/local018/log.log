```sql
--Description (thinking process):
-- Goal: For the PCF‑violation category that is most frequent in 2021, find its share
--       of total collisions in 2021 and in 2011, then compute how many percentage
--       points that share fell (share_2011 − share_2021).
-- Approach:
-- 1. Extract year from collisions.collision_date (format 'YYYY‑MM‑DD'); use only 2011 & 2021.
-- 2. Determine the top 2021 category (highest count).
-- 3. Count collisions for that category in each year, along with total collisions per year.
-- 4. Compute shares (%) and the percentage‑point decrease.
WITH yr_data AS (                 -- all 2011 & 2021 rows with their PCF category
    SELECT substr(collision_date,1,4) AS yr,
           pcf_violation_category     AS cat
    FROM   collisions
    WHERE  yr IN ('2011','2021')
),
top21 AS (                         -- most common category in 2021
    SELECT cat,
           COUNT(*) AS cnt21
    FROM   yr_data
    WHERE  yr = '2021'
    GROUP  BY cat
    ORDER  BY cnt21 DESC
    LIMIT 1
),
totals AS (                        -- total collisions per year
    SELECT yr, COUNT(*) AS tot
    FROM   yr_data
    GROUP  BY yr
),
counts AS (                        -- counts for the top category in both years
    SELECT 
        (SELECT cat  FROM top21)                       AS category,
        (SELECT cnt21 FROM top21)                      AS cnt_2021,
        (SELECT COUNT(*) FROM yr_data 
         WHERE yr='2011' AND cat=(SELECT cat FROM top21)) AS cnt_2011,
        (SELECT tot FROM totals WHERE yr='2021')       AS tot_2021,
        (SELECT tot FROM totals WHERE yr='2011')       AS tot_2011
)
SELECT category,
       ROUND(100.0*cnt_2021/tot_2021,2) AS share_2021_pct,
       ROUND(100.0*cnt_2011/tot_2011,2) AS share_2011_pct,
       ROUND(100.0*cnt_2011/tot_2011 - 100.0*cnt_2021/tot_2021,2) AS pct_point_decrease
FROM   counts;
