```sql
-- Description: See how many collisions we have for each PCF violation category in 2021
SELECT c.pcf_violation_category,
       COUNT(*) AS collisions_2021
FROM   collisions AS c
JOIN   case_ids  AS y
       ON c.case_id = y.case_id
WHERE  y.db_year = 2021
GROUP  BY c.pcf_violation_category
ORDER  BY collisions_2021 DESC
LIMIT 20;
```

