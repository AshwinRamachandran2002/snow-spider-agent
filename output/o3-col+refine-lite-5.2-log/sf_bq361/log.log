```sql
-- 1. Inspect a chronological slice of orders to confirm the micro‑second time‑stamp pattern
SELECT 
    "order_id",
    "user_id",
    TO_TIMESTAMP_NTZ("created_at"/1000000)   AS "created_at_ts",
    "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
ORDER BY "created_at_ts"
LIMIT 20;
```

```sql
-- 2. Derive each shopper’s very first order date
SELECT  
    "user_id",
    MIN("created_at")                                              AS "first_order_ts_micro",
    TO_TIMESTAMP_NTZ(MIN("created_at")/1000000)                    AS "first_order_date"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
GROUP BY "user_id"
LIMIT 20;
```

```sql
-- 3. Pull users whose FIRST purchase fell inside January 2020
SELECT DISTINCT
    u."user_id",
    TO_TIMESTAMP_NTZ(u."first_order_ts_micro"/1000000) AS "first_order_date"
FROM (
        SELECT "user_id", MIN("created_at") AS "first_order_ts_micro"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
        GROUP BY "user_id"
     ) u
WHERE  TO_DATE(TO_TIMESTAMP_NTZ(u."first_order_ts_micro"/1000000))
       BETWEEN '2020-01-01' AND '2020-01-31'
LIMIT 20;
```

```sql
-- 4. How many users are in that January 2020 cohort?
SELECT 
    COUNT(*) AS "jan_2020_new_users"
FROM (
        SELECT "user_id", MIN("created_at") AS "first_order_ts_micro"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
        GROUP BY "user_id"
     ) u
WHERE TO_DATE(TO_TIMESTAMP_NTZ(u."first_order_ts_micro"/1000000))
      BETWEEN '2020-01-01' AND '2020-01-31';
```

```sql
-- 5. List every subsequent‑2020 order placed by the January cohort
SELECT 
    o."user_id",
    TO_TIMESTAMP_NTZ(o."created_at"/1000000) AS "order_date",
    o."order_id",
    o."status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS  o
JOIN (
        SELECT "user_id", MIN("created_at") AS "first_order_ts_micro"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
        GROUP BY "user_id"
        HAVING TO_DATE(TO_TIMESTAMP_NTZ(MIN("created_at")/1000000))
               BETWEEN '2020-01-01' AND '2020-01-31'
     ) jan
     ON o."user_id" = jan."user_id"
WHERE TO_DATE(TO_TIMESTAMP_NTZ(o."created_at"/1000000)) >  '2020-01-31'
  AND TO_DATE(TO_TIMESTAMP_NTZ(o."created_at"/1000000)) <= '2020-12-31'
LIMIT 20;
```

```sql
-- 6. Distinct months (YYYY‑MM) in which those users returned during 2020
SELECT DISTINCT
    TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000),'YYYY-MM') AS "order_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS  o
JOIN (
        SELECT "user_id", MIN("created_at") AS "first_order_ts_micro"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
        GROUP BY "user_id"
        HAVING TO_DATE(TO_TIMESTAMP_NTZ(MIN("created_at")/1000000))
               BETWEEN '2020-01-01' AND '2020-01-31'
     ) jan
  ON o."user_id" = jan."user_id"
WHERE TO_DATE(TO_TIMESTAMP_NTZ(o."created_at"/1000000)) >  '2020-01-31'
  AND TO_DATE(TO_TIMESTAMP_NTZ(o."created_at"/1000000)) <= '2020-12-31'
ORDER BY "order_month"
LIMIT 20;
```

```sql
-- 7. Count how many of those January shoppers placed ≥1 more order in 2020
SELECT 
    COUNT(DISTINCT o."user_id") AS "returning_users_2020"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS  o
JOIN (
        SELECT "user_id", MIN("created_at") AS "first_order_ts_micro"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
        GROUP BY "user_id"
        HAVING TO_DATE(TO_TIMESTAMP_NTZ(MIN("created_at")/1000000))
               BETWEEN '2020-01-01' AND '2020-01-31'
     ) jan
  ON o."user_id" = jan."user_id"
WHERE TO_DATE(TO_TIMESTAMP_NTZ(o."created_at"/1000000)) >  '2020-01-31'
  AND TO_DATE(TO_TIMESTAMP_NTZ(o."created_at"/1000000)) <= '2020-12-31';
```

```sql
-- 8. Compute the 2020 retention proportion: returning / cohort size
SELECT 
    ROUND(b."returning_users_2020" / a."jan_2020_new_users", 4) AS "retention_rate_2020"
FROM (
        SELECT COUNT(*) AS "jan_2020_new_users"
        FROM (
                SELECT "user_id", MIN("created_at") AS "first_order_ts_micro"
                FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
                GROUP BY "user_id"
                HAVING TO_DATE(TO_TIMESTAMP_NTZ(MIN("created_at")/1000000))
                       BETWEEN '2020-01-01' AND '2020-01-31'
             )
     ) a
CROSS JOIN (
        SELECT COUNT(DISTINCT o."user_id") AS "returning_users_2020"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS  o
        JOIN (
                SELECT "user_id", MIN("created_at") AS "first_order_ts_micro"
                FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
                GROUP BY "user_id"
                HAVING TO_DATE(TO_TIMESTAMP_NTZ(MIN("created_at")/1000000))
                       BETWEEN '2020-01-01' AND '2020-01-31'
             ) jan
          ON o."user_id" = jan."user_id"
        WHERE TO_DATE(TO_TIMESTAMP_NTZ(o."created_at"/1000000)) >  '2020-01-31'
          AND TO_DATE(TO_TIMESTAMP_NTZ(o."created_at"/1000000)) <= '2020-12-31'
     ) b;
```

```sql
-- 9. Month‑by‑month returning‑user counts inside the cohort during 2020
SELECT 
    TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000),'YYYY-MM') AS "order_month",
    COUNT(DISTINCT o."user_id")                                 AS "num_returning_users"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS  o
JOIN (
        SELECT "user_id", MIN("created_at") AS "first_order_ts_micro"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
        GROUP BY "user_id"
        HAVING TO_DATE(TO_TIMESTAMP_NTZ(MIN("created_at")/1000000))
               BETWEEN '2020-01-01' AND '2020-01-31'
     ) jan
  ON o."user_id" = jan."user_id"
WHERE TO_DATE(TO_TIMESTAMP_NTZ(o."created_at"/1000000)) >  '2020-01-31'
  AND TO_DATE(TO_TIMESTAMP_NTZ(o."created_at"/1000000)) <= '2020-12-31'
GROUP BY "order_month"
ORDER BY "order_month"
LIMIT 20;
```

```sql
-- 10. Example users in the January cohort who never returned afterwards in 2020
SELECT  
    jan."user_id",
    TO_TIMESTAMP_NTZ(jan."first_order_ts_micro"/1000000) AS "first_order_date"
FROM (
        SELECT "user_id", MIN("created_at") AS "first_order_ts_micro"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
        GROUP BY "user_id"
        HAVING TO_DATE(TO_TIMESTAMP_NTZ(MIN("created_at")/1000000))
               BETWEEN '2020-01-01' AND '2020-01-31'
     ) jan
LEFT JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
       ON jan."user_id" = o."user_id"
      AND TO_DATE(TO_TIMESTAMP_NTZ(o."created_at"/1000000)) >  '2020-01-31'
      AND TO_DATE(TO_TIMESTAMP_NTZ(o."created_at"/1000000)) <= '2020-12-31'
WHERE o."order_id" IS NULL
LIMIT 20;
