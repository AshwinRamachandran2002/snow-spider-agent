```sql
--Description: 1) What kinds of events were logged on 15‑Sep‑2018?
SELECT DISTINCT `event_name`
FROM `firebase-public-project.analytics_153293282.events_20180915`
LIMIT 20;
```

```sql
--Description: 2) Look at a few raw rows of the quick‑play completion event.
SELECT `event_timestamp`, `event_params`
FROM `firebase-public-project.analytics_153293282.events_20180915`
WHERE `event_name` = 'level_complete_quickplay'
LIMIT 20;
```

```sql
--Description: 3) Inspect the different keys that appear inside `event_params`
--                for the quick‑play completion event.
SELECT DISTINCT p.key
FROM `firebase-public-project.analytics_153293282.events_20180915`,
UNNEST(`event_params`) AS p
WHERE `event_name` = 'level_complete_quickplay'
LIMIT 20;
```

```sql
--Description: 4) Get a sample of the “board” parameter values.
SELECT p.value.string_value  AS board_type
FROM `firebase-public-project.analytics_153293282.events_20180915`,
UNNEST(`event_params`) AS p
WHERE `event_name` = 'level_complete_quickplay'
  AND p.key = 'board'
LIMIT 20;
```

```sql
--Description: 5) Get a sample of the numeric “value” (score) parameter.
SELECT p.value.int_value  AS score
FROM `firebase-public-project.analytics_153293282.events_20180915`,
UNNEST(`event_params`) AS p
WHERE `event_name` = 'level_complete_quickplay'
  AND p.key = 'value'
LIMIT 20;
```

```sql
--Description: 6) Extract board type and score for every quick‑play completion
--                on the day (one row = one completion).
SELECT
  MAX(CASE WHEN p.key = 'board'  THEN p.value.string_value END) AS board_type,
  MAX(CASE WHEN p.key = 'value'  THEN p.value.int_value END)   AS score
FROM `firebase-public-project.analytics_153293282.events_20180915` AS t,
UNNEST(t.event_params) AS p
WHERE t.event_name = 'level_complete_quickplay'
GROUP BY t.event_timestamp, t.user_pseudo_id
LIMIT 20;
```

```sql
--Description: 7) Compute the average score achieved on each board type
--                for quick‑play completions on 15‑Sep‑2018.
SELECT
  board_type,
  AVG(score) AS avg_score
FROM (
  SELECT
    MAX(CASE WHEN p.key = 'board'  THEN p.value.string_value END) AS board_type,
    MAX(CASE WHEN p.key = 'value'  THEN p.value.int_value END)   AS score
  FROM `firebase-public-project.analytics_153293282.events_20180915` AS t,
  UNNEST(t.event_params) AS p
  WHERE t.event_name = 'level_complete_quickplay'
  GROUP BY t.event_timestamp, t.user_pseudo_id
)
GROUP BY board_type
ORDER BY avg_score DESC;
```
