```sql
-- Description: Peek at a handful of raw rows to understand the columns we are working with
SELECT *
FROM `bigquery-public-data.iowa_liquor_sales.sales`
LIMIT 20;
```

```sql
-- Description:  Show the distinct years for which we have data (   EXTRACT(YEAR FROM date)   )
SELECT DISTINCT EXTRACT(YEAR FROM `date`) AS sales_year
FROM `bigquery-public-data.iowa_liquor_sales.sales`
ORDER BY sales_year
LIMIT 20;
```

```sql
-- Description:  Get 20 different liquor items (descriptions) that appear in the table
SELECT DISTINCT `item_description`
FROM `bigquery-public-data.iowa_liquor_sales.sales`
LIMIT 20;
```

```sql
-- Description:  Aggregate total sales dollars by calendar year (all items combined)
SELECT
  EXTRACT(YEAR FROM `date`) AS sales_year,
  SUM(`sale_dollars`)             AS total_sales_dollars
FROM `bigquery-public-data.iowa_liquor_sales.sales`
GROUP BY sales_year
ORDER BY sales_year
LIMIT 20;
```

```sql
-- Description:  Example – yearly sales trend for one popular item to be sure the logic works
SELECT
  `item_description`,
  EXTRACT(YEAR FROM `date`) AS sales_year,
  SUM(`sale_dollars`)       AS item_sales_dollars
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE LOWER(`item_description`) LIKE '%titos handmade vodka%'
GROUP BY item_description, sales_year
ORDER BY sales_year
LIMIT 20;
```

```sql
-- Description:  Produce per‑item, per‑year revenue so we can later pivot 2022 vs 2023
SELECT
  `item_description`,
  EXTRACT(YEAR FROM `date`) AS sales_year,
  SUM(`sale_dollars`)       AS item_sales_dollars
FROM `bigquery-public-data.iowa_liquor_sales.sales`
GROUP BY item_description, sales_year
ORDER BY item_description
LIMIT 20;
```

```sql
-- Description:  Pivot 2022 & 2023 sales for each item (first 20 rows just to validate)
WITH yearly AS (
  SELECT
    `item_description`,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(`sale_dollars`)       AS sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_description, yr
)
SELECT
  item_description,
  SUM(CASE WHEN yr = 2022 THEN sales END) AS sales_2022,
  SUM(CASE WHEN yr = 2023 THEN sales END) AS sales_2023
FROM yearly
GROUP BY item_description
ORDER BY item_description
LIMIT 20;
```

```sql
-- Description:  FINAL ANSWER – Top‑5 items with the highest year‑over‑year growth %
WITH yearly AS (
  SELECT
    `item_description`,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(`sale_dollars`)       AS sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_description, yr
),
pivot AS (
  SELECT
    item_description,
    SUM(CASE WHEN yr = 2022 THEN sales END) AS sales_2022,
    SUM(CASE WHEN yr = 2023 THEN sales END) AS sales_2023
  FROM yearly
  GROUP BY item_description
),
growth AS (
  SELECT
    item_description,
    sales_2022,
    sales_2023,
    SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) AS yoy_growth_pct
  FROM pivot
  WHERE sales_2022 > 0            -- need a baseline to compute growth
        AND sales_2023 IS NOT NULL
)
SELECT
  item_description,
  sales_2022,
  sales_2023,
  yoy_growth_pct
FROM growth
ORDER BY yoy_growth_pct DESC
LIMIT 5;
```
