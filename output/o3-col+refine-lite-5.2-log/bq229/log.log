  COUNT(DISTINCT im.original_url) AS cat_url_count
FROM `bigquery-public-data.open_images.annotations_bbox` AS ab
JOIN `bigquery-public-data.open_images.images`            AS im
USING (image_id)
WHERE ab.label_name = '/m/01yrx'
  AND ab.confidence = 1
LIMIT 20;
```

```sql
--Description: Sample image URLs that have NO Cat annotation at all (“other” group).
SELECT DISTINCT
  im.original_url
FROM `bigquery-public-data.open_images.images` AS im
LEFT JOIN (
  SELECT DISTINCT image_id
  FROM `bigquery-public-data.open_images.annotations_bbox`
  WHERE label_name = '/m/01yrx'
    AND confidence = 1
) AS cat
USING (image_id)
WHERE cat.image_id IS NULL
LIMIT 20;
```

```sql
