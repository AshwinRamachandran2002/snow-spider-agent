```

```sql
--Description: 5) For every (name, version, step) keep the highest test score among non‑Stack models.
SELECT "name",
       "version",
       "step",
       MAX("test_score") AS "max_non_stack"
FROM "model_score"
WHERE "model" NOT LIKE '%Stack%'
GROUP BY "name", "version", "step"
LIMIT 20;
```

```sql
--Description: 6) Get the test score of the Stack model for each (name, version, step).
SELECT "name",
       "version",
       "step",
       "test_score" AS "stack_test_score"
FROM "model_score"
WHERE "model" LIKE '%Stack%'
LIMIT 20;
```

```sql
--Description: 7) Decide if the Stack model is ‘strong’ (> best non‑Stack) or ‘soft’ (= best non‑Stack).
WITH non_stack AS (
    SELECT "name","version","step", MAX("test_score") AS "max_non_stack"
    FROM "model_score"
    WHERE "model" NOT LIKE '%Stack%'
    GROUP BY "name","version","step"
),
stack AS (
    SELECT "name","version","step","test_score" AS "stack_test_score"
    FROM "model_score"
    WHERE "model" LIKE '%Stack%'
)
SELECT s."name",
       s."version",
       s."step",
       CASE
           WHEN s."stack_test_score"  > n."max_non_stack" THEN 'strong'
           WHEN s."stack_test_score" == n."max_non_stack" THEN 'soft'
       END AS "status"
FROM stack s
JOIN non_stack n
  ON n."name" = s."name"
 AND n."version" = s."version"
 AND n."step" = s."step"
LIMIT 20;
```

```sql
--Description: 8) Attach the L1_model declared for every step to the ‘strong / soft’ status.
WITH non_stack AS (
    SELECT "name","version","step", MAX("test_score") AS "max_non_stack"
    FROM "model_score"
    WHERE "model" NOT LIKE '%Stack%'
    GROUP BY "name","version","step"
),
stack AS (
    SELECT "name","version","step","test_score" AS "stack_test_score"
    FROM "model_score"
    WHERE "model" LIKE '%Stack%'
),
status AS (
    SELECT s."name", s."version", s."step",
           CASE
               WHEN s."stack_test_score"  > n."max_non_stack" THEN 'strong'
               WHEN s."stack_test_score" == n."max_non_stack" THEN 'soft'
           END AS "status"
    FROM stack s
    JOIN non_stack n
      ON n."name" = s."name"
     AND n."version" = s."version"
     AND n."step" = s."step"
)
SELECT st."name",
       st."version",
       st."step",
       m."L1_model",
       st."status"
FROM status st
JOIN "model" m
  ON m."name"    = st."name"
 AND m."version" = st."version"
 AND m."step"    = st."step"
LIMIT 20;
```

```sql
--Description: 9) Count how many times each L1_model is tagged ‘strong’ or ‘soft’.
WITH non_stack AS (
    SELECT "name","version","step", MAX("test_score") AS "max_non_stack"
    FROM "model_score"
    WHERE "model" NOT LIKE '%Stack%'
    GROUP BY "name","version","step"
),
stack AS (
    SELECT "name","version","step","test_score" AS "stack_test_score"
    FROM "model_score"
    WHERE "model" LIKE '%Stack%'
),
status AS (
    SELECT s."name", s."version", s."step",
           CASE
               WHEN s."stack_test_score"  > n."max_non_stack" THEN 'strong'
               WHEN s."stack_test_score" == n."max_non_stack" THEN 'soft'
           END AS "status"
    FROM stack s
    JOIN non_stack n
      ON n."name" = s."name"
     AND n."version" = s."version"
     AND n."step" = s."step"
),
l1 AS (
    SELECT st."status", m."L1_model"
    FROM status st
    JOIN "model" m
      ON m."name"    = st."name"
     AND m."version" = st."version"
     AND m."step"    = st."step"
)
SELECT "L1_model",
       "status",
       COUNT(*) AS "cnt"
FROM l1
GROUP BY "L1_model", "status"
LIMIT 20;
```

```sql
--Description: 10) Final answer – the most frequent L1_model for each status and the number of occurrences.
WITH non_stack AS (
    SELECT "name","version","step", MAX("test_score") AS "max_non_stack"
    FROM "model_score"
    WHERE "model" NOT LIKE '%Stack%'
    GROUP BY "name","version","step"
),
stack AS (
    SELECT "name","version","step","test_score" AS "stack_test_score"
    FROM "model_score"
    WHERE "model" LIKE '%Stack%'
),
status AS (
    SELECT s."name", s."version", s."step",
           CASE
               WHEN s."stack_test_score"  > n."max_non_stack" THEN 'strong'
               WHEN s."stack_test_score" == n."max_non_stack" THEN 'soft'
           END AS "status"
    FROM stack s
    JOIN non_stack n
      ON n."name" = s."name"
     AND n."version" = s."version"
     AND n."step" = s."step"
),
l1 AS (
    SELECT st."status", m."L1_model"
    FROM status st
    JOIN "model" m
      ON m."name"    = st."name"
     AND m."version" = st."version"
     AND m."step"    = st."step"
),
cnts AS (
    SELECT "L1_model", "status", COUNT(*) AS cnt
    FROM l1
    GROUP BY "L1_model", "status"
)
SELECT c."status",
       c."L1_model",
       c."cnt"
FROM cnts c
JOIN (
      SELECT "status", MAX(cnt) AS max_cnt
      FROM cnts
      GROUP BY "status"
     ) mx
  ON mx."status" = c."status"
 AND mx.max_cnt  = c."cnt"
LIMIT 20;
```
