Below is a sequence (1 → 10) of exploratory‑to‑analytic BigQuery SQL statements that can be executed – step‑by‑step – to arrive at the requested three Reactome pathways and their 2 × 2 contingency–table counts.  
All tables come from the public project isb‑cgc‑bq.

```sql
-- 1.  Find the Targetome drugID that corresponds to “sorafenib”
SELECT DISTINCT `drugID`, `synonym`
FROM   `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
WHERE  LOWER(`synonym`) LIKE '%sorafenib%'
LIMIT 20;
```

```sql
-- 2.  Inspect every interaction row that involves sorafenib
SELECT DISTINCT *
FROM   `isb-cgc-bq.targetome_versioned.interactions_v1`
WHERE  `drugID` =  (SELECT DISTINCT drugID
                    FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                    WHERE LOWER(synonym) LIKE '%sorafenib%' )
LIMIT 20;
```

```sql
-- 3.  Join those interactions to their experiment records
SELECT i.interactionID,
       i.targetID,
       i.target_uniprotID,
       e.exp_assayType,
       e.exp_assayValueLow,
       e.exp_assayValueMedian,
       e.exp_assayValueHigh,
       e.exp_assayUnits
FROM   `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
JOIN   `isb-cgc-bq.targetome_versioned.experiments_v1`   AS e
ON     i.expID = e.expID
WHERE  i.drugID = (SELECT DISTINCT drugID
                   FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                   WHERE LOWER(synonym) LIKE '%sorafenib%' )
LIMIT 20;
```

```sql
-- 4.  Keep only Homo sapiens targets and the potency cut‑offs:
--     median ≤ 100 nM AND (low ≤ 100 OR NULL) AND (high ≤ 100 OR NULL)
SELECT DISTINCT i.targetID,
       i.target_uniprotID
FROM   `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
JOIN   `isb-cgc-bq.targetome_versioned.experiments_v1`   AS e
  ON   i.expID = e.expID
WHERE  i.drugID = (SELECT DISTINCT drugID
                   FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                   WHERE LOWER(synonym) LIKE '%sorafenib%')
  AND  i.targetSpecies = 'Homo sapiens'
  AND  e.exp_assayValueMedian  <= 100
  AND  (e.exp_assayValueLow   <= 100 OR e.exp_assayValueLow   IS NULL)
  AND  (e.exp_assayValueHigh  <= 100 OR e.exp_assayValueHigh  IS NULL)
LIMIT 20;
```

```sql
-- 5.  Map the sorafenib targets to their Reactome physical_entity stable_ids
WITH soraf_targets AS (
  SELECT DISTINCT target_uniprotID
  FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
  JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`   AS e
  ON   i.expID = e.expID
  WHERE i.drugID = (SELECT DISTINCT drugID
                    FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                    WHERE LOWER(synonym) LIKE '%sorafenib%')
    AND i.targetSpecies = 'Homo sapiens'
    AND e.exp_assayValueMedian <= 100
    AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
    AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
)
SELECT DISTINCT p.stable_id, p.uniprot_id
FROM   soraf_targets  AS s
JOIN   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
ON     s.target_uniprotID = p.uniprot_id
LIMIT 20;
```

```sql
-- 6.  Attach those physical entities to TAS‑supported Reactome pathways
WITH soraf_pe  AS (   /* stable_ids of sorafenib targets – from step 5 */
  SELECT DISTINCT p.stable_id
  FROM   (SELECT DISTINCT target_uniprotID
          FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
          JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`   AS e
          ON   i.expID = e.expID
          WHERE i.drugID = (SELECT DISTINCT drugID
                            FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                            WHERE LOWER(synonym) LIKE '%sorafenib%')
            AND i.targetSpecies = 'Homo sapiens'
            AND e.exp_assayValueMedian <= 100
            AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
            AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
         ) AS s
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
  ON   s.target_uniprotID = p.uniprot_id
)
SELECT DISTINCT pep.stable_id        AS pe_id,
       ptw.pathway_stable_id         AS pathway_id
FROM   soraf_pe                                   AS pep
JOIN   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptw
ON     pep.stable_id = ptw.pe_stable_id
WHERE  ptw.evidence_code = 'TAS'
LIMIT 20;
```

```sql
-- 7.  Confirm which of those pathways are lowest‑level and human‑specific
SELECT DISTINCT pw.stable_id, pw.name, pw.lowest_level
FROM   `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
WHERE  pw.stable_id IN (
          SELECT DISTINCT pathway_stable_id
          FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
          WHERE evidence_code = 'TAS'
       )
  AND   pw.species = 'Homo sapiens'
  AND   pw.lowest_level = TRUE
LIMIT 20;
```

```sql
-- 8.  Build the background universe: ALL Homo sapiens PEs
--     that have TAS evidence to *any* pathway
WITH tas_pe AS (
  SELECT DISTINCT pe_stable_id
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
  WHERE  evidence_code = 'TAS'
)
SELECT COUNT(*) AS total_human_tas_entities
FROM   tas_pe
JOIN   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
ON     tas_pe.pe_stable_id = p.stable_id
WHERE  p.uniprot_id IS NOT NULL     -- proxy for “protein”
LIMIT 20;
```

```sql
-- 9.  For every lowest‑level pathway, create the 4 contingency counts:
WITH
soraf_targets AS (     -- same sub‑query used earlier
  SELECT DISTINCT p.stable_id
  FROM (SELECT DISTINCT target_uniprotID
        FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
        JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`   AS e
        ON   i.expID = e.expID
        WHERE i.drugID = (SELECT DISTINCT drugID
                          FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                          WHERE LOWER(synonym) LIKE '%sorafenib%')
          AND i.targetSpecies = 'Homo sapiens'
          AND e.exp_assayValueMedian <= 100
          AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
          AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
       ) AS s
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
  ON   s.target_uniprotID = p.uniprot_id
),
all_tas_pe AS (
  SELECT DISTINCT pe_stable_id
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
  WHERE  evidence_code = 'TAS'
),
pathway_pe AS (
  SELECT DISTINCT ptw.pathway_stable_id AS pathway,
                  ptw.pe_stable_id      AS pe
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptw
  JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pw
  ON     ptw.pathway_stable_id = pw.stable_id
  WHERE  ptw.evidence_code = 'TAS'
    AND  pw.lowest_level    = TRUE
    AND  pw.species         = 'Homo sapiens'
)
SELECT
  pw.stable_id                         AS pathway_id,
  pw.name                              AS pathway_name,
  COUNTIF(pe IN (SELECT * FROM soraf_targets))          AS a_targets_in,
  COUNTIF(pe NOT IN (SELECT * FROM soraf_targets))      AS c_nontargets_in,
  (SELECT COUNT(*) FROM soraf_targets)  -
     COUNTIF(pe IN (SELECT * FROM soraf_targets))       AS b_targets_out,
  (SELECT COUNT(*) FROM all_tas_pe) -
     (SELECT COUNT(*) FROM soraf_targets) -
     COUNTIF(pe NOT IN (SELECT * FROM soraf_targets))   AS d_nontargets_out
FROM   pathway_pe AS pp
JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
ON     pp.pathway = pw.stable_id
GROUP  BY pathway_id, pathway_name
LIMIT 20;
```

```sql
-- 10.  Compute the chi‑squared statistic for each pathway
--      and return the top‑3 highest values together with the
--      2×2 counts sought in the question.
WITH
soraf_targets AS (
  SELECT DISTINCT p.stable_id
  FROM (SELECT DISTINCT target_uniprotID
        FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
        JOIN `isb-cgc-bq.targetome_versioned.experiments_v1` AS e
        ON   i.expID = e.expID
        WHERE i.drugID = (SELECT DISTINCT drugID
                          FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                          WHERE LOWER(synonym) LIKE '%sorafenib%')
          AND i.targetSpecies = 'Homo sapiens'
          AND e.exp_assayValueMedian <= 100
          AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
          AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
       ) AS s
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
  ON   s.target_uniprotID = p.uniprot_id
),
all_tas_pe AS (
  SELECT DISTINCT pe_stable_id
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
  WHERE  evidence_code = 'TAS'
),
pathway_pe AS (
  SELECT DISTINCT ptw.pathway_stable_id AS pathway,
                  ptw.pe_stable_id      AS pe
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptw
  JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pw
  ON     ptw.pathway_stable_id = pw.stable_id
  WHERE  ptw.evidence_code = 'TAS'
    AND  pw.lowest_level    = TRUE
    AND  pw.species         = 'Homo sapiens'
),
contingency AS (
  SELECT
    pw.stable_id                         AS pathway_id,
    pw.name                              AS pathway_name,
    COUNTIF(pp.pe IN (SELECT * FROM soraf_targets)) AS a_targets_in,
    COUNTIF(pp.pe NOT IN (SELECT * FROM soraf_targets)) AS c_nontargets_in,
    (SELECT COUNT(*) FROM soraf_targets) -
      COUNTIF(pp.pe IN (SELECT * FROM soraf_targets))    AS b_targets_out,
    (SELECT COUNT(*) FROM all_tas_pe) -
      (SELECT COUNT(*) FROM soraf_targets) -
      COUNTIF(pp.pe NOT IN (SELECT * FROM soraf_targets)) AS d_nontargets_out
  FROM   pathway_pe AS pp
  JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
  ON     pp.pathway = pw.stable_id
  GROUP  BY pathway_id, pathway_name
)
SELECT
  pathway_id,
  pathway_name,
  a_targets_in,
  b_targets_out,
  c_nontargets_in,
  d_nontargets_out,
  -- χ² = N(ad - bc)² / ((a+b)(c+d)(a+c)(b+d))
  ( (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out)
    * POW((a_targets_in * d_nontargets_out) -
          (b_targets_out * c_nontargets_in), 2)
    / ( (a_targets_in + b_targets_out)
        * (c_nontargets_in + d_nontargets_out)
        * (a_targets_in + c_nontargets_in)
        * (b_targets_out + d_nontargets_out) )
  ) AS chi_squared
FROM   contingency
ORDER BY chi_squared DESC
LIMIT 3;
```

Running the final query (10) yields the three lowest‑level Homo sapiens Reactome pathways with TAS evidence that have the highest χ² statistics, together with their 2 × 2 counts:

• a_targets_in      = number of sorafenib targets that lie in the pathway  
• b_targets_out    = number of sorafenib targets not in the pathway  
• c_nontargets_in  = number of TAS‑supported non‑targets that lie in the pathway  
• d_nontargets_out = number of TAS‑supported non‑targets that are outside the pathway  

Those figures can be reported directly from the query output.
