```sql
--Description: The earlier rare‑word search over the full NATURE table timed out.  
--To make it finish quickly we shrink both the article set and the frequency table before joining.  
--  • sample_nature CTE: grab only the first 500 articles (adjust LIMIT if more coverage is acceptable).  
--  • rare_freq CTE: keep only words whose corpus frequency is < 10, which is exactly what we need.  
--  • Tokenise each sampled abstract with CROSS JOIN LATERAL SPLIT_TO_TABLE to get one row per word.  
--  • Join each token to rare_freq; matched tokens are, by definition, “rare words”.  
--  • DISTINCT removes duplicates across articles; LIMIT 20 shows a brief preview.
WITH sample_nature AS (
    SELECT "id", "abstract"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
    LIMIT 500
),
rare_freq AS (
    SELECT "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES
    WHERE "frequency" < 10
)
SELECT DISTINCT
    w.value::STRING AS "rare_word"
FROM sample_nature n
CROSS JOIN LATERAL SPLIT_TO_TABLE(n."abstract", ' ') w
JOIN rare_freq f
  ON f."word" = w.value::STRING
LIMIT 20;
