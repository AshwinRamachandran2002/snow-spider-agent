     LATERAL SPLIT_TO_TABLE( n."abstract", ' ' )        w
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS       g
  ON g."word" = w.value::STRING
GROUP BY n."id"
LIMIT 20;
```
