     LATERAL SPLIT_TO_TABLE( n."body", ' ' )            w
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
       ON f."word" = w.value::STRING
LIMIT 20;
```

```sql
--Description: 9) Identify low‑frequency words (< 10) that appear in article abstracts (use DISTINCT tokens).
SELECT DISTINCT
  w.value::STRING AS "rare_word"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE              n,
     LATERAL SPLIT_TO_TABLE( n."abstract", ' ' )        w
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES    f
  ON f."word" = w.value::STRING
WHERE f."frequency" < 10
LIMIT 20;
