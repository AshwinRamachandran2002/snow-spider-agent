```sql
--Description: 7) Break every article title into tokens, then join each token to its GloVe vector (if present).
SELECT 
  n."id",
  w.value::STRING      AS "title_word",
  g."vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE          n,
     LATERAL SPLIT_TO_TABLE( n."title", ' ' )        w
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
       ON g."word" = w.value::STRING
LIMIT 20;
```

```sql
