```sql
--Description:  Efficiently list words whose corpus frequency is < 10 that actually occur in Nature
--abstracts, without timing‑out.
--  • CTE rare_words: fetch the small set of <10‑frequency words from WORD_FREQUENCIES.
--  • For each Nature row we CROSS JOIN LATERAL an inner query that
--        – splits that single abstract into tokens (TABLE(SPLIT_TO_TABLE)),
--        – immediately INNER‑JOINs those tokens to rare_words,
--      so only rare matches leave the sub‑query.  This prevents materialising all tokens for the full table.
--  • DISTINCT removes duplicates across articles; LIMIT 20 shows a quick sample.
WITH rare_words AS (
    SELECT "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES
    WHERE "frequency" < 10
)
SELECT DISTINCT
       r.token AS "rare_word"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
CROSS JOIN LATERAL (
    SELECT t.value::STRING AS token
    FROM TABLE(SPLIT_TO_TABLE(n."abstract", ' ')) t
    JOIN rare_words rw
      ON rw."word" = t.value::STRING
) r
LIMIT 20;
```
