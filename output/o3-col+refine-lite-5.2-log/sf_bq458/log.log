```sql
--Description: Speed‑safe query to list rare words (frequency < 10) that occur in article abstracts.
--Strategy
--  • rare_words  : pre‑filter WORD_FREQUENCIES to words with frequency < 10 (tiny set).
--  • sample_papers: take only the first 500 Nature rows to keep tokenisation quick (change LIMIT if desired).
--  • Tokenise each abstract with CROSS JOIN LATERAL SPLIT_TO_TABLE.
--  • INNER JOIN tokens to rare_words → rows are rare words found in those abstracts.
--  • DISTINCT removes duplicates; LIMIT 20 keeps the preview short.
WITH rare_words AS (
    SELECT "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES
    WHERE "frequency" < 10
),
sample_papers AS (
    SELECT "id", "abstract"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
    LIMIT 500
)
SELECT DISTINCT
       w.value::STRING AS "rare_word"
FROM sample_papers p
CROSS JOIN LATERAL SPLIT_TO_TABLE(p."abstract", ' ') w
JOIN rare_words r
  ON r."word" = w.value::STRING
LIMIT 20;
```
