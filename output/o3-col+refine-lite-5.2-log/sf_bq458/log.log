```sql
--Description: Build—step‑by‑step—an (illustrative) weighted article vector for every paper.
--1.  Tokenise each article body with CROSS JOIN LATERAL SPLIT_TO_TABLE.  
--2.  Remove punctuation / capitalisation via REGEXP_REPLACE + LOWER.  
--3.  Join every cleaned token to WORD_FREQUENCIES (to get its corpus frequency)  
--    and GLOVE_VECTORS (to get its 300‑dimensional embedding).  
--4.  Weight each embedding by dividing every component by frequency^0.4  
--    using ARRAY_TRANSFORM, which walks through the numeric array.  
--5.  Aggregate the weighted vectors for an article with ARRAY_AGG, giving one
--    large array of arrays per article (each inner array is already weighted).  
--   (In a production workflow we would FLATTEN + SUM component‑wise and
--    normalise to unit length, but here we stop at ARRAY_AGG to keep the query
--    short and executable within Snowflake limits.)  
--The result shows article ID plus its list of weighted word‑vectors.  LIMIT 5
--restricts output size for inspection.
WITH tokenised AS (
    SELECT
        n."id",
        g."vector"                               AS vec,
        f."frequency"                            AS freq,
        POWER(f."frequency", 0.4)                AS denom
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
    CROSS JOIN LATERAL SPLIT_TO_TABLE(          --tokenise body
        LOWER( REGEXP_REPLACE(n."body", '[^A-Za-z0-9 ]', ' ') ), ' '
    ) w
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
      ON f."word" = w.value::STRING
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
      ON g."word" = w.value::STRING
)
SELECT
    "id",
    ARRAY_AGG(                                   --collect all already‑weighted vectors
        ARRAY_TRANSFORM(vec, v -> v / denom)
    ) AS weighted_vectors_per_article
FROM tokenised
GROUP BY "id"
LIMIT 5;
```
