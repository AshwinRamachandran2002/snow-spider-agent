```sql
-- Highest precipitation, lowest TMIN and highest TMAX
-- in the last 15 days (Dec‑17‒Dec‑31) of each year 2013‑2016
-- for station USW00094846.  Raw tenths units → mm / °C by ÷ 10.
WITH base AS (
  SELECT
    CAST(_TABLE_SUFFIX AS INT64)      AS year,
    date,
    element,
    value
  FROM `bigquery-public-data.ghcn_d.ghcnd_201*`
  WHERE _TABLE_SUFFIX IN ('2013','2014','2015','2016')
    AND id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND qflag IS NULL               -- validated records only
    AND value IS NOT NULL
    AND date BETWEEN DATE(CAST(_TABLE_SUFFIX AS INT64),12,17)
                  AND DATE(CAST(_TABLE_SUFFIX AS INT64),12,31)
)
SELECT
  year,
  MAX(CASE WHEN element = 'PRCP' THEN value END)/10.0 AS max_precip_mm,
  MIN(CASE WHEN element = 'TMIN' THEN value END)/10.0 AS min_temp_c,
  MAX(CASE WHEN element = 'TMAX' THEN value END)/10.0 AS max_temp_c
FROM base
GROUP BY year
ORDER BY year;
