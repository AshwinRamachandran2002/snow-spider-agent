```sql
--Description: (thinking process embedded)
-- 1. Objective → For station USW00094846, find during the last 15 calendar
--    days (Dec‑17–Dec‑31) of each year 2013‑2016:
--        • highest precipitation (mm)
--        • lowest minimum temperature (°C)
--        • highest maximum temperature (°C)
-- 2. Raw GHCND “value” fields are in tenths of units
--        PRCP: 0.1 mm   |   TMIN/TMAX: 0.1 °C
--    so we divide by 10 at the end.
-- 3. We must use only validated records → qflag IS NULL.
-- 4. Yearly tables have different column counts; to UNION ALL them we
--    project the same 8 columns from each (id, date, element, value, mflag,
--    qflag, sflag, time).
-- 5. After stacking the four years we filter by station, elements, quality
--    flag, and the 15‑day window; then aggregate to get the extremes and
--    convert units.
WITH stacked AS (
  SELECT id, date, element, value, mflag, qflag, sflag, time
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  UNION ALL
  SELECT id, date, element, value, mflag, qflag, sflag, time
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  UNION ALL
  SELECT id, date, element, value, mflag, qflag, sflag, time
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  UNION ALL
  SELECT id, date, element, value, mflag, qflag, sflag, time
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
),
filtered AS (
  SELECT id, date, element, value
  FROM stacked
  WHERE id = 'USW00094846'
    AND element IN ('PRCP','TMIN','TMAX')
    AND qflag IS NULL                     -- validated data only
    AND date BETWEEN DATE(EXTRACT(YEAR FROM date),12,17)
                  AND DATE(EXTRACT(YEAR FROM date),12,31)   -- last 15 days
)
SELECT
  EXTRACT(YEAR FROM date)                                   AS year,
  MAX(CASE WHEN element = 'PRCP' THEN value END)/10.0 AS max_precip_mm,
  MIN(CASE WHEN element = 'TMIN' THEN value END)/10.0 AS min_temp_c,
  MAX(CASE WHEN element = 'TMAX' THEN value END)/10.0 AS max_temp_c
FROM filtered
GROUP BY year
ORDER BY year;
```
