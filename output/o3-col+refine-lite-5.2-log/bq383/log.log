--Description: Combine raw extremes (PRCP, TMIN, TMAX) per year in one query.
--             After stacking the yearly tables (8 identical columns) and
--             filtering to validated rows for Dec‑17–Dec‑31, aggregate to get
--             max PRCP, min TMIN, and max TMAX (all still in raw tenths).
WITH base AS (
  SELECT id, date, element, value
  FROM (
    SELECT id, date, element, value, mflag, qflag, sflag, time
    FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
    UNION ALL
    SELECT id, date, element, value, mflag, qflag, sflag, time
    FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
    UNION ALL
    SELECT id, date, element, value, mflag, qflag, sflag, time
    FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
    UNION ALL
    SELECT id, date, element, value, mflag, qflag, sflag, time
    FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  )
  WHERE id = 'USW00094846'
    AND qflag IS NULL
    AND date BETWEEN DATE(EXTRACT(YEAR FROM date),12,17)
                  AND DATE(EXTRACT(YEAR FROM date),12,31)
)
SELECT
  EXTRACT(YEAR FROM date)                              AS yr,
  MAX(CASE WHEN element='PRCP' THEN value END) AS max_prcp_raw,
  MIN(CASE WHEN element='TMIN' THEN value END) AS min_tmin_raw,
  MAX(CASE WHEN element='TMAX' THEN value END) AS max_tmax_raw
FROM base
GROUP BY yr
ORDER BY yr
LIMIT 20
