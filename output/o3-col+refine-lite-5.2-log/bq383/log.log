```sql
-- 9. Combine PRCP, TMIN, TMAX extremes (still raw units) per year
WITH base AS (
  SELECT id, date, element, value
  FROM (
    SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
    UNION ALL
    SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
    UNION ALL
    SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
    UNION ALL
    SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
  )
  WHERE id = 'USW00094846'
    AND qflag IS NULL
    AND date >= DATE_SUB(DATE(EXTRACT(YEAR FROM date),12,31), INTERVAL 14 DAY)
)
SELECT
  EXTRACT(YEAR FROM date)                                       AS yr,
  MAX(CASE WHEN element='PRCP' THEN value END)                  AS max_prcp_raw,
  MIN(CASE WHEN element='TMIN' THEN value END)                  AS min_tmin_raw,
  MAX(CASE WHEN element='TMAX' THEN value END)                  AS max_tmax_raw
FROM base
GROUP BY yr
ORDER BY yr
LIMIT 20;
```

```sql
-- 10. Final answer: extremes converted to mm / °C for 2013‑2016
SELECT
  yr                                   AS year,
  max_prcp_raw / 10.0  AS max_precip_mm,
  min_tmin_raw / 10.0  AS min_temp_c,
  max_tmax_raw / 10.0  AS max_temp_c
FROM (
  WITH base AS (
    SELECT id, date, element, value
    FROM (
      SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
      UNION ALL
      SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
      UNION ALL
      SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
      UNION ALL
      SELECT * FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
    )
    WHERE id = 'USW00094846'
      AND qflag IS NULL                 -- only validated data
      AND date >= DATE_SUB(DATE(EXTRACT(YEAR FROM date),12,31), INTERVAL 14 DAY) -- last 15 days of the year
      AND element IN ('PRCP','TMIN','TMAX')
  )
  SELECT
    EXTRACT(YEAR FROM date)                                   AS yr,
    MAX(CASE WHEN element='PRCP' THEN value END)              AS max_prcp_raw,
    MIN(CASE WHEN element='TMIN' THEN value END)              AS min_tmin_raw,
    MAX(CASE WHEN element='TMAX' THEN value END)              AS max_tmax_raw
  FROM base
  GROUP BY yr
)
ORDER BY year;
```
