Query:
--Description: Minimum daily TMIN (raw tenths °C) during the last 15 days of
--             each year 2013‑2016 for station USW00094846.  Uses identical
--             8‑column projections from every yearly table so UNION ALL works,
--             keeps validated records (qflag IS NULL), filters Dec‑17–Dec‑31,
--             then returns the yearly minimum.
SELECT
  EXTRACT(YEAR FROM date) AS yr,
  MIN(value)              AS min_tmin_raw
FROM (
  SELECT id, date, element, value, mflag, qflag, sflag, time
  FROM `bigquery-public-data.ghcn_d.ghcnd_2013`
  UNION ALL
  SELECT id, date, element, value, mflag, qflag, sflag, time
  FROM `bigquery-public-data.ghcn_d.ghcnd_2014`
  UNION ALL
  SELECT id, date, element, value, mflag, qflag, sflag, time
  FROM `bigquery-public-data.ghcn_d.ghcnd_2015`
  UNION ALL
  SELECT id, date, element, value, mflag, qflag, sflag, time
  FROM `bigquery-public-data.ghcn_d.ghcnd_2016`
)
WHERE id       = 'USW00094846'
  AND element  = 'TMIN'
  AND qflag   IS NULL
  AND date BETWEEN DATE(EXTRACT(YEAR FROM date),12,17)
                AND DATE(EXTRACT(YEAR FROM date),12,31)
GROUP BY yr
ORDER BY yr
LIMIT 20
