```sql
-- Description: Show the first and last activity month for 20 sample users.
SELECT `by`,
       MIN(DATE_TRUNC(DATE(`timestamp`), MONTH)) AS first_month,
       MAX(DATE_TRUNC(DATE(`timestamp`), MONTH)) AS last_month
FROM `bigquery-public-data.hacker_news.full`
WHERE `by` IS NOT NULL
  AND `timestamp` < '2024-09-10'
GROUP BY `by`
ORDER BY last_month DESC
LIMIT 20;
```

```sql
-- Description: For one sample user (`pg`), list every month in which they were active.
SELECT DATE_TRUNC(DATE(`timestamp`), MONTH) AS month_actived,
       COUNT(*) AS posts_in_month
FROM `bigquery-public-data.hacker_news.full`
WHERE `by` = 'pg'
  AND `timestamp` < '2024-09-10'
GROUP BY month_actived
ORDER BY month_actived
LIMIT 20;
```

```sql
-- Description: Build a table of monthly activity (one row per user‑month).
SELECT `by`,
       DATE_TRUNC(DATE(`timestamp`), MONTH) AS activity_month,
       COUNT(*) AS monthly_posts
FROM `bigquery-public-data.hacker_news.full`
WHERE `by` IS NOT NULL
  AND `timestamp` < '2024-09-10'
GROUP BY `by`, activity_month
ORDER BY `by`, activity_month
LIMIT 20;
```

```sql
-- Description: Add the user’s very first active month and compute the month index (0 = first month).
SELECT `by`,
       activity_month,
       TIMESTAMP_DIFF(activity_month, first_month, MONTH) AS month_number
FROM (
    SELECT `by`,
           DATE_TRUNC(DATE(`timestamp`), MONTH) AS activity_month,
           MIN(DATE_TRUNC(DATE(`timestamp`), MONTH)) OVER (PARTITION BY `by`) AS first_month
    FROM `bigquery-public-data.hacker_news.full`
    WHERE `by` IS NOT NULL
      AND `timestamp` < '2024-09-10'
)
GROUP BY `by`, activity_month, first_month
ORDER BY `by`, month_number
LIMIT 20;
```

```sql
-- Description: For every user, compute span length (# months between first & last) 
-- and how many of those months actually have activity.
SELECT `by`,
       MIN(activity_month) AS first_month,
       MAX(activity_month) AS last_month,
       TIMESTAMP_DIFF(MAX(activity_month), MIN(activity_month), MONTH) + 1 AS span_months,
       COUNT(*) AS active_months
FROM (
    SELECT `by`,
           DATE_TRUNC(DATE(`timestamp`), MONTH) AS activity_month
    FROM `bigquery-public-data.hacker_news.full`
    WHERE `by` IS NOT NULL
      AND `timestamp` < '2024-09-10'
    GROUP BY `by`, activity_month
)
GROUP BY `by`
ORDER BY span_months DESC
LIMIT 20;
```

```sql
-- Description: Keep only users that missed at least one month inside their activity span
-- (i.e., active_months < span_months).
SELECT `by`,
       span_months,
       active_months
FROM (
    SELECT `by`,
           TIMESTAMP_DIFF(MAX(activity_month), MIN(activity_month), MONTH) + 1 AS span_months,
           COUNT(*) AS active_months
    FROM (
        SELECT `by`,
               DATE_TRUNC(DATE(`timestamp`), MONTH) AS activity_month
        FROM `bigquery-public-data.hacker_news.full`
        WHERE `by` IS NOT NULL
          AND `timestamp` < '2024-09-10'
        GROUP BY `by`, activity_month
    )
    GROUP BY `by`
)
WHERE active_months < span_months
ORDER BY span_months DESC
LIMIT 20;
```

```sql
-- Description: FINAL ANSWER.  Return the user that has the largest month index (span)   
-- while having at least one internal inactive month, and give that highest month number.
SELECT `by`          AS user_id,
       span_months   AS month_number
FROM (
    SELECT `by`,
           TIMESTAMP_DIFF(MAX(activity_month), MIN(activity_month), MONTH) + 1 AS span_months,
           COUNT(*) AS active_months
    FROM (
        SELECT `by`,
               DATE_TRUNC(DATE(`timestamp`), MONTH) AS activity_month
        FROM `bigquery-public-data.hacker_news.full`
        WHERE `by` IS NOT NULL
          AND `timestamp` < '2024-09-10'
        GROUP BY `by`, activity_month
    )
    GROUP BY `by`
    HAVING active_months < span_months               -- missed at least one month
)
ORDER BY span_months DESC
LIMIT 1;
```
