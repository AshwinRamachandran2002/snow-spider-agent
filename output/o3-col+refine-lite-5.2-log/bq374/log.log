--Description: 10) Full‑period query (2016‑08‑01 → 2017‑04‑30) returning the
--count of qualified users and the percentage relative to all new users.
--STRUCT fields are aliased into flat columns to avoid reference errors.
WITH period_sessions AS (
  SELECT
    fullVisitorId,
    visitNumber,
    totals.timeOnSite  AS timeOnSite,
    totals.transactions AS transactions,
    totals.newVisits   AS newVisits,
    PARSE_DATE('%Y%m%d', date) AS session_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
),
first_long AS (
  SELECT DISTINCT fullVisitorId
  FROM period_sessions
  WHERE newVisits = 1
    AND visitNumber = 1
    AND timeOnSite > 300
),
later_txn AS (
  SELECT DISTINCT fullVisitorId
  FROM period_sessions
  WHERE transactions IS NOT NULL
    AND transactions > 0
    AND visitNumber > 1
),
both AS (
  SELECT fullVisitorId FROM first_long
  INTERSECT DISTINCT
  SELECT fullVisitorId FROM later_txn
)
SELECT
  COUNT(*) AS users_long_first_and_buy_later,
  (SELECT COUNT(DISTINCT fullVisitorId)
     FROM period_sessions
     WHERE newVisits = 1) AS total_new_users,
  SAFE_DIVIDE(
    COUNT(*),
    (SELECT COUNT(DISTINCT fullVisitorId)
       FROM period_sessions
       WHERE newVisits = 1)
  ) AS pct_users
LIMIT 20;
