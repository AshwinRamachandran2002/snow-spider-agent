--   that occur *after* the first visit (visitNumber > 1).  
WITH all_sessions AS (
  SELECT fullVisitorId, visitNumber, totals.timeOnSite, totals.transactions,
         totals.newVisits, date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20160801`
  UNION ALL
  SELECT fullVisitorId, visitNumber, totals.timeOnSite, totals.transactions,
