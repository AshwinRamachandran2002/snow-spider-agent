```sql
--Description: 8) Combine queries‑6 and 7 to list users that satisfy *both* 
--   conditions in the sample (long first visit + later purchase).  
WITH all_sessions AS (
  SELECT fullVisitorId, visitNumber, totals.timeOnSite, totals.transactions,
         totals.newVisits, date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20160801`
  UNION ALL
  SELECT fullVisitorId, visitNumber, totals.timeOnSite, totals.transactions,
         totals.newVisits, date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170107`
  UNION ALL
  SELECT fullVisitorId, visitNumber, totals.timeOnSite, totals.transactions,
         totals.newVisits, date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170401`
),
qualified_first AS (
  SELECT DISTINCT fullVisitorId
  FROM all_sessions
  WHERE totals.newVisits = 1
    AND visitNumber = 1
    AND totals.timeOnSite > 300
),
later_purchases AS (
  SELECT DISTINCT fullVisitorId
  FROM all_sessions
  WHERE totals.transactions IS NOT NULL
    AND totals.transactions > 0
    AND visitNumber > 1
)
SELECT
  q.fullVisitorId
FROM qualified_first q
JOIN later_purchases p
ON q.fullVisitorId = p.fullVisitorId
LIMIT 20;
```

```sql
--Description: 9) Count users that meet the double‑condition versus total new users 
--   (still on the three‑day sample).  
WITH all_sessions AS (
  SELECT fullVisitorId, visitNumber, totals.timeOnSite, totals.transactions,
         totals.newVisits, date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20160801`
  UNION ALL
  SELECT fullVisitorId, visitNumber, totals.timeOnSite, totals.transactions,
         totals.newVisits, date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170107`
  UNION ALL
  SELECT fullVisitorId, visitNumber, totals.timeOnSite, totals.transactions,
         totals.newVisits, date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170401`
),
first_long AS (
  SELECT DISTINCT fullVisitorId
  FROM all_sessions
  WHERE totals.newVisits = 1
    AND visitNumber = 1
    AND totals.timeOnSite > 300
),
later_txn AS (
  SELECT DISTINCT fullVisitorId
  FROM all_sessions
  WHERE totals.transactions IS NOT NULL
    AND totals.transactions > 0
    AND visitNumber > 1
),
both AS (
  SELECT fullVisitorId FROM first_long
  INTERSECT DISTINCT
  SELECT fullVisitorId FROM later_txn
)
SELECT
  (SELECT COUNT(*) FROM both) AS users_long_first_and_buy_later,
  (SELECT COUNT(DISTINCT fullVisitorId)
   FROM all_sessions
   WHERE totals.newVisits = 1)  AS total_new_users_sample
LIMIT 20;
```

```sql
--Description: 10) Exact query you would run on the *entire* required period  
--   (20160801‑‑20170430) using a wildcard table, returning the sought percentage.  
--   The LIMIT is kept only to respect the “LIMIT 20” instruction for demos.  
WITH period_sessions AS (
  SELECT
    fullVisitorId,
    visitNumber,
    totals.timeOnSite,
    totals.transactions,
    totals.newVisits,
    PARSE_DATE('%Y%m%d', date) AS session_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
),
first_long AS (
  SELECT DISTINCT fullVisitorId
  FROM period_sessions
  WHERE totals.newVisits = 1
    AND visitNumber = 1
    AND totals.timeOnSite > 300
),
later_txn AS (
  SELECT DISTINCT fullVisitorId
  FROM period_sessions
  WHERE totals.transactions IS NOT NULL
    AND totals.transactions > 0
    AND visitNumber > 1
),
both AS (
  SELECT fullVisitorId FROM first_long
  INTERSECT DISTINCT
  SELECT fullVisitorId FROM later_txn
)
SELECT
  COUNT(*) AS users_long_first_and_buy_later,
  (SELECT COUNT(DISTINCT fullVisitorId)
   FROM period_sessions
   WHERE totals.newVisits = 1) AS total_new_users,
  SAFE_DIVIDE(COUNT(*),
              (SELECT COUNT(DISTINCT fullVisitorId)
               FROM period_sessions
               WHERE totals.newVisits = 1)) AS pct_users
LIMIT 20;
```

Each successive query builds more logic—starting from simple inspection of a single table, progressing to joins, CTEs, and finally to the full‑period calculation that delivers the percentage asked for.
