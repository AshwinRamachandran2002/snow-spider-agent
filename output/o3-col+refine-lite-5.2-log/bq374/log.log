```sql
--Description: Full‑period calculation (2016‑08‑01 → 2017‑04‑30).  
--Steps within this single query:  
--1) period_sessions – read every daily table via wildcard and flatten the needed
--   STRUCT fields (timeOnSite, transactions, newVisits).  
--2) first_long     – visitor IDs whose *first* session (visitNumber = 1, newVisits = 1)  
--   lasted > 5 minutes (timeOnSite > 300 s).  
--3) later_txn      – visitor IDs with any later session (visitNumber > 1) where
--   at least one transaction occurred (transactions > 0).  
--4) both           – intersection of the two lists (users satisfying both
--   conditions).  
--5) totals         – total count of new users in the period.  
--6) Final SELECT   – count qualified users, total new users, and percentage.
--   COUNT(*) is taken FROM the CTE `both`, then CROSS JOIN with `totals`
--   to avoid “COUNT(*) without FROM” errors.  LIMIT 20 just shows a snippet.

WITH period_sessions AS (
  SELECT
    fullVisitorId,
    visitNumber,
    totals.timeOnSite   AS timeOnSite,
    totals.transactions AS transactions,
    totals.newVisits    AS newVisits
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
),
first_long AS (
  SELECT DISTINCT fullVisitorId
