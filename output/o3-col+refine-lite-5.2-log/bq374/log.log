--Description: 4) Check whether the same visitor ids of query‑2 ever appear with 
--   a purchase later in the same day table (quick sanity test).  
SELECT DISTINCT
  later.fullVisitorId,
  later.visitNumber,
  later.totals.transactions AS txns_later,
  earlier.totals.timeOnSite AS first_visit_seconds
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20160801` AS earlier
JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_20160801` AS later
  ON earlier.fullVisitorId = later.fullVisitorId
WHERE earlier.totals.newVisits = 1
  AND earlier.visitNumber = 1
  AND earlier.totals.timeOnSite > 300      -- stayed > 5 min
  AND later.visitNumber  > 1               -- later visit
  AND later.totals.transactions IS NOT NULL
LIMIT 20;
