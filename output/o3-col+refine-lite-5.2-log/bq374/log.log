Query:
--Description: 9) Count (on the three‑day sample) how many new users had a
--long first visit and then purchased, versus the total new users.
WITH all_sessions AS (
  SELECT
    fullVisitorId,
    visitNumber,
    totals.timeOnSite  AS timeOnSite,
    totals.transactions AS transactions,
    totals.newVisits   AS newVisits,
    date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20160801`
  UNION ALL
  SELECT
    fullVisitorId, visitNumber,
    totals.timeOnSite,
    totals.transactions,
    totals.newVisits,
    date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170107`
  UNION ALL
  SELECT
    fullVisitorId, visitNumber,
    totals.timeOnSite,
    totals.transactions,
    totals.newVisits,
    date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170401`
),
first_long AS (
  SELECT DISTINCT fullVisitorId
  FROM all_sessions
  WHERE newVisits = 1
    AND visitNumber = 1
    AND timeOnSite > 300
),
later_txn AS (
  SELECT DISTINCT fullVisitorId
  FROM all_sessions
  WHERE transactions IS NOT NULL
    AND transactions > 0
    AND visitNumber > 1
),
both AS (
  SELECT fullVisitorId FROM first_long
  INTERSECT DISTINCT
  SELECT fullVisitorId FROM later_txn
)
SELECT
  (SELECT COUNT(*) FROM both) AS users_long_first_and_buy_later,
  (SELECT COUNT(DISTINCT fullVisitorId)
     FROM all_sessions
     WHERE newVisits = 1)     AS total_new_users_sample
LIMIT 20
Answer:
users_long_first_and_buy_later,total_new_users_sample
