  SELECT fullVisitorId, visitNumber, totals.timeOnSite, totals.transactions,
         totals.newVisits, date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170401`
)
SELECT DISTINCT
  fullVisitorId,
  visitNumber,
  totals.transactions AS txn_count,
  date AS purchase_date
FROM all_sessions
WHERE totals.transactions IS NOT NULL
  AND totals.transactions > 0
