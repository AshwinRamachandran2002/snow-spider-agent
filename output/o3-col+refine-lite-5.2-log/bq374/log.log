Query:
--Description: 8) Combine long‑first‑visit users with later‑purchase users
--to list visitors that satisfy both conditions on the three‑day sample.
WITH all_sessions AS (
  SELECT
    fullVisitorId,
    visitNumber,
    totals.timeOnSite  AS timeOnSite,
    totals.transactions AS transactions,
    totals.newVisits   AS newVisits,
    date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20160801`
  UNION ALL
  SELECT
    fullVisitorId, visitNumber,
    totals.timeOnSite,
    totals.transactions,
    totals.newVisits,
    date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170107`
  UNION ALL
  SELECT
    fullVisitorId, visitNumber,
    totals.timeOnSite,
    totals.transactions,
    totals.newVisits,
    date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170401`
),
qualified_first AS (
  SELECT DISTINCT fullVisitorId
  FROM all_sessions
  WHERE newVisits = 1
    AND visitNumber = 1
    AND timeOnSite > 300
),
later_purchases AS (
  SELECT DISTINCT fullVisitorId
  FROM all_sessions
  WHERE transactions IS NOT NULL
    AND transactions > 0
    AND visitNumber > 1
)
SELECT
  q.fullVisitorId
FROM qualified_first q
JOIN later_purchases p
ON q.fullVisitorId = p.fullVisitorId
LIMIT 20
