Query:
--Description: 7) Find purchase‑sessions (transactions ≥ 1) that happen after the
--first visit, on the three‑day sample.  We expose STRUCT fields as simple columns
--inside the `all_sessions` CTE and then reference those column names.
WITH all_sessions AS (
  SELECT
    fullVisitorId,
    visitNumber,
    totals.timeOnSite  AS timeOnSite,
    totals.transactions AS transactions,
    totals.newVisits   AS newVisits,
    date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20160801`
  UNION ALL
  SELECT
    fullVisitorId, visitNumber,
    totals.timeOnSite,
    totals.transactions,
    totals.newVisits,
    date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170107`
  UNION ALL
  SELECT
    fullVisitorId, visitNumber,
    totals.timeOnSite,
    totals.transactions,
    totals.newVisits,
    date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170401`
)
SELECT DISTINCT
  fullVisitorId,
  visitNumber,
  transactions AS txn_count,
  date         AS purchase_date
FROM all_sessions
WHERE transactions IS NOT NULL
  AND transactions > 0
  AND visitNumber > 1
LIMIT 20
