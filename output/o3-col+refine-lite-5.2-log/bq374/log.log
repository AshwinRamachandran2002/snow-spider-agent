Query:
--Description: 5) Put three representative daily tables (Aug‑2016, Jan‑2017, Apr‑2017) 
--   together to create an “all_sessions” sample set inside a CTE.  
WITH all_sessions AS (
  SELECT fullVisitorId, visitNumber, totals.timeOnSite, totals.transactions,
         totals.newVisits, date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20160801`
  UNION ALL
  SELECT fullVisitorId, visitNumber, totals.timeOnSite, totals.transactions,
         totals.newVisits, date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170107`
  UNION ALL
  SELECT fullVisitorId, visitNumber, totals.timeOnSite, totals.transactions,
         totals.newVisits, date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170401`
)
SELECT * FROM all_sessions
LIMIT 20;
