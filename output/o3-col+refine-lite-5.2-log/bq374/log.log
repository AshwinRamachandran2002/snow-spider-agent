```sql
--Description (thinking process inside):
-- 1. We want the very first session of each user that is a NEW visit (newVisits = 1)
--    and lasted more than 5 min (timeOnSite > 300).
-- 2. The earlier error happened because, once the rows are in a CTE, we can
--    no longer use totals.timeOnSite notation unless we alias it first.
-- 3. Therefore, when constructing the CTE `all_sessions`, we split the needed
--    STRUCT fields into plain columns (timeOnSite, transactions, newVisits).
-- 4. We UNION three sample day‑tables (Aug‑2016, Jan‑2017, Apr‑2017) to keep the
--    example short, but the pattern scales to all required days.
-- 5. The outer query simply filters on those plain columns and returns distinct
--    users whose first visit satisfies the conditions; LIMIT 20 just inspects.

WITH all_sessions AS (
  -- Day 1: 2016‑08‑01
  SELECT
    fullVisitorId,
    visitNumber,
    totals.timeOnSite  AS timeOnSite,
    totals.transactions AS transactions,
    totals.newVisits   AS newVisits,
    date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20160801`
  UNION ALL
  -- Day 2: 2017‑01‑07
  SELECT
    fullVisitorId,
    visitNumber,
    totals.timeOnSite,
    totals.transactions,
    totals.newVisits,
    date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170107`
  UNION ALL
  -- Day 3: 2017‑04‑01
  SELECT
    fullVisitorId,
    visitNumber,
    totals.timeOnSite,
    totals.transactions,
    totals.newVisits,
    date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170401`
)

SELECT DISTINCT
  fullVisitorId,
  date AS first_visit_date,
  timeOnSite AS first_visit_seconds
FROM all_sessions
WHERE newVisits = 1           -- brand‑new users
  AND visitNumber = 1         -- ensure it's their first session
  AND timeOnSite > 300        -- >5 minutes on site
LIMIT 20;
```
