```sql
--Description:  One‑shot query that answers the business question for the
--entire period 1‑Aug‑2016 → 30‑Apr‑2017.  
--Logic embedded step‑by‑step:  
-- 1. period_sessions  – read every daily ga_sessions_* table via wildcard; expose
--    needed STRUCT members (timeOnSite, transactions, newVisits) as flat columns.  
-- 2. first_long       – visitorIds whose *first* session (visitNumber = 1 AND
--    newVisits = 1) lasted > 300 s.  
-- 3. later_txn        – visitorIds that recorded ≥1 transaction in any later
--    session (visitNumber > 1 AND transactions > 0).  
-- 4. both             – intersection of the two lists (users meeting both conditions).  
-- 5. totals           – total count of new users in the period (denominator).  
-- 6. Final SELECT     – count qualified users, total new users, derive the
--    percentage with SAFE_DIVIDE; CROSS JOIN with totals keeps everything in
--    a single row and avoids aggregation‑scope errors.  LIMIT 20 simply previews
--    the summary row.

WITH period_sessions AS (
  SELECT
    fullVisitorId,
    visitNumber,
    totals.timeOnSite   AS timeOnSite,
    totals.transactions AS transactions,
    totals.newVisits    AS newVisits
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
),
first_long AS (
  SELECT DISTINCT fullVisitorId
  FROM period_sessions
  WHERE newVisits = 1
    AND visitNumber = 1
    AND timeOnSite > 300       -- >5 min on first visit
),
later_txn AS (
  SELECT DISTINCT fullVisitorId
  FROM period_sessions
  WHERE transactions IS NOT NULL
    AND transactions > 0       -- purchase made
    AND visitNumber > 1        -- on a subsequent visit
),
both AS (
  SELECT fullVisitorId FROM first_long
  INTERSECT DISTINCT
  SELECT fullVisitorId FROM later_txn
),
totals AS (
  SELECT COUNT(DISTINCT fullVisitorId) AS total_new_users
  FROM period_sessions
  WHERE newVisits = 1
)

SELECT
  COUNT(*)                                   AS users_long_first_and_buy_later,
  totals.total_new_users                     AS total_new_users,
  SAFE_DIVIDE(COUNT(*), totals.total_new_users) AS pct_users
FROM both
CROSS JOIN totals
LIMIT 20;
