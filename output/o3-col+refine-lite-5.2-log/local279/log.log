--Description: 10) Outline calculation of ending inventory per product / month in 2019 (unchanged logic, but shown here for completeness)
WITH
start AS (
    SELECT i."product_id",
           SUM(i."qty") AS start_qty
    FROM   "inventory"  i
    JOIN   "purchases"  p ON p."id" = i."purchase_id"
    WHERE  DATE(p."purchased") <= '2018-12-31'
    GROUP  BY i."product_id"
),
moves AS (
    SELECT SUBSTR(o."ordered",1,7) || '-01' AS mth,
           ol."product_id",
           -SUM(ol."qty") AS delta
    FROM   "orderlines" ol
    JOIN   "orders"     o ON o."id" = ol."order_id"
    WHERE  DATE(o."ordered") BETWEEN '2019-01-01' AND '2019-12-31'
    GROUP  BY ol."product_id", mth
),
months AS (SELECT DISTINCT mth FROM moves),
base AS (
    SELECT s."product_id", m.mth
    FROM   start s
    CROSS  JOIN months m
),
calc AS (
    SELECT b."product_id",
           b."mth",
           COALESCE(s.start_qty,0)
           + SUM(COALESCE(m.delta,0)) OVER (
                 PARTITION BY b."product_id"
                 ORDER BY b."mth"
                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
             ) AS end_qty
    FROM   base  b
    LEFT   JOIN start s  ON s."product_id" = b."product_id"
    LEFT   JOIN moves m  ON m."product_id" = b."product_id"
                        AND m."mth"        = b."mth"
)
