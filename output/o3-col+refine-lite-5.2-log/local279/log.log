```sql
--Description: 1) Look up all products that have minimum‑stock settings defined
SELECT DISTINCT "product_id", "qty_minimum", "qty_purchase"
FROM "product_minimums"
LIMIT 20;
```

```sql
--Description: 2) Inspect current on‑hand inventory per product (all locations summed)
SELECT "product_id", SUM("qty") AS "in_stock_now"
FROM "inventory"
GROUP BY "product_id"
ORDER BY "in_stock_now" DESC
LIMIT 20;
```

```sql
--Description: 3) Check how much of that inventory was supplied by purchases made on or before 2018‑12‑31  
--(this will serve as the December‑2018 starting position)
SELECT i."product_id",
       SUM(i."qty") AS "dec_2018_stock"
FROM   "inventory"            AS i
JOIN   "purchases"            AS p  ON p."id" = i."purchase_id"
WHERE  DATE(p."purchased") <= '2018-12-31'
GROUP  BY i."product_id"
LIMIT 20;
```

```sql
--Description: 4) Get the quantity shipped out (sold) per product per month in 2019
SELECT ol."product_id",
       SUBSTR(o."ordered",1,7) || '-01' AS "mth",   -- normalise to first‑of‑month
       SUM(ol."qty") AS "qty_sold"
FROM   "orderlines"           AS ol
JOIN   "orders"               AS o  ON o."id" = ol."order_id"
WHERE  DATE(o."ordered") BETWEEN '2019-01-01' AND '2019-12-31'
GROUP  BY ol."product_id", "mth"
ORDER  BY ol."product_id", "mth"
LIMIT 20;
```

```sql
--Description: 5) List the standard replenishment lot (qty_purchase) we have to buy when the min‑level is breached
SELECT DISTINCT "product_id", "qty_purchase"
FROM   "product_minimums"
LIMIT 20;
```

```sql
--Description: 6) Verify that purchase records exist during 2019 (will be useful when applying restocks)
SELECT "product_id",
       DATE("purchased")      AS "day",
       "qty"
FROM   "purchases"
WHERE  "purchased" BETWEEN '2019-01-01' AND '2019-12-31'
ORDER  BY "product_id", "purchased"
LIMIT 20;
```

```sql
--Description: 7) Show monthly sales history that may already be stored in monthly_sales (to cross‑check with step 4)
SELECT "product_id", "mth", "qty"
FROM   "monthly_sales"
WHERE  "mth" LIKE '2019-%'
ORDER  BY "product_id", "mth"
LIMIT 20;
```

```sql
--Description: 8) Collect every product we will have to track (either has minimums or is currently in stock)
SELECT DISTINCT "product_id"
FROM (
      SELECT "product_id" FROM "product_minimums"
      UNION
      SELECT "product_id" FROM "inventory"
     )
LIMIT 20;
```

```sql
--Description: 9) For one sample product (e.g. 6520) list all 2019 stock‑movements in chronological order  
--(positive = restock via purchase, negative = shipment)
SELECT "event_date",
       "product_id",
       SUM("delta") AS "qty_change"
FROM (
      -- outgoing sales
      SELECT DATE(o."ordered")      AS "event_date",
             ol."product_id",
             -ol."qty"              AS "delta"
      FROM   "orderlines"  ol
      JOIN   "orders"      o ON o."id" = ol."order_id"
      WHERE  ol."product_id" = 6520
        AND  o."ordered" BETWEEN '2019-01-01' AND '2019-12-31'
      UNION ALL
      -- incoming purchases
      SELECT DATE(p."purchased")    AS "event_date",
             p."product_id",
             p."qty"                AS "delta"
      FROM   "purchases" p
      WHERE  p."product_id" = 6520
        AND  p."purchased" BETWEEN '2019-01-01' AND '2019-12-31'
     )
GROUP  BY "event_date", "product_id"
ORDER  BY "event_date"
LIMIT 20;
```

```sql
--Description: 10) Finally, list for each product / month in 2019 the calculated ending inventory   
--(start with Dec‑2018 stock, add deltas from step 9).  
--This is an outline query – it provides the result set whose “ending – minimum” gap will be evaluated.
WITH
start AS (
    SELECT i."product_id",
           SUM(i."qty") AS start_qty
    FROM   "inventory"  i
    JOIN   "purchases"  p ON p."id" = i."purchase_id"
    WHERE  DATE(p."purchased") <= '2018-12-31'
    GROUP  BY i."product_id"
),
moves AS (
    SELECT SUBSTR(o."ordered",1,7) || '-01' AS mth,
           ol."product_id",
           -SUM(ol."qty")                    AS delta
    FROM   "orderlines" ol
    JOIN   "orders"     o ON o."id" = ol."order_id"
    WHERE  DATE(o."ordered") BETWEEN '2019-01-01' AND '2019-12-31'
    GROUP  BY ol."product_id", mth
),
months AS (SELECT DISTINCT mth FROM moves),
base   AS (
    SELECT s."product_id", m.mth
    FROM   start s
    CROSS  JOIN months m
),
calc AS (
    SELECT b."product_id",
           b."mth",
           COALESCE(s.start_qty,0)
           + SUM(COALESCE(m.delta,0)) OVER (
                 PARTITION BY b."product_id"
                 ORDER BY b."mth"
                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
             ) AS end_qty
    FROM   base  b
    LEFT   JOIN start s  ON s."product_id" = b."product_id"
    LEFT   JOIN moves m  ON m."product_id" = b."product_id"
                        AND m."mth"        = b."mth"
)
SELECT c."product_id",
       c."mth",
       ABS(c."end_qty" - pm."qty_minimum") AS "abs_gap"
FROM   calc            c
JOIN   "product_minimums" pm ON pm."product_id" = c."product_id"
ORDER  BY c."product_id", "abs_gap"
LIMIT 20;
```
