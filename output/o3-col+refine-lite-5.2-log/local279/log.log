Query:
--Description: 9) For one sample product (e.g. 6520) list all 2019 stock‑movements in chronological order  
--(positive = restock via purchase, negative = shipment)
SELECT "event_date",
       "product_id",
       SUM("delta") AS "qty_change"
FROM (
      -- outgoing sales
      SELECT DATE(o."ordered")      AS "event_date",
             ol."product_id",
             -ol."qty"              AS "delta"
      FROM   "orderlines"  ol
      JOIN   "orders"      o ON o."id" = ol."order_id"
      WHERE  ol."product_id" = 6520
        AND  o."ordered" BETWEEN '2019-01-01' AND '2019-12-31'
      UNION ALL
      -- incoming purchases (keep 2019 filter; if none exist we will still see sales)
      SELECT DATE(p."purchased")    AS "event_date",
             p."product_id",
             p."qty"                AS "delta"
      FROM   "purchases" p
      WHERE  p."product_id" = 6520
        AND  p."purchased" BETWEEN '2019-01-01' AND '2019-12-31'
     )
GROUP  BY "event_date", "product_id"
ORDER  BY "event_date"
LIMIT 20
