```sql
--Description: Map the Portuguese product categories to their English translation
SELECT DISTINCT p."product_category_name",
                t."product_category_name_english"
FROM   "products"                       AS p
JOIN   "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
LIMIT 20;
```

```sql
--Description: Identify sellers that have sold more than 100 items (quantity criterion for the report)
SELECT   oi."seller_id",
         COUNT(*) AS "qty_items_sold"
FROM     "order_items" AS oi
GROUP BY oi."seller_id"
HAVING   COUNT(*) > 100
ORDER BY "qty_items_sold" DESC
LIMIT 20;
```

```sql
--Description: For the same high‑volume sellers, calculate total sales value and average item price
SELECT   oi."seller_id",
         SUM(oi."price")               AS "total_sales_value",
         AVG(oi."price")               AS "avg_item_price",
         COUNT(*)                      AS "qty_items_sold"
FROM     "order_items" AS oi
GROUP BY oi."seller_id"
HAVING   COUNT(*) > 100
ORDER BY "total_sales_value" DESC
LIMIT 20;
```

```sql
--Description: Compute average review score for high‑volume sellers
SELECT   oi."seller_id",
         AVG(rv."review_score")        AS "avg_review_score",
         COUNT(rv."review_id")         AS "num_reviews"
FROM     "order_items" AS oi
JOIN     "order_reviews" AS rv
       ON oi."order_id" = rv."order_id"
GROUP BY oi."seller_id"
HAVING   COUNT(*) > 100
ORDER BY "avg_review_score" DESC
LIMIT 20;
```

```sql
--Description: Measure average packing time (order -> shipping) for each high‑volume seller
SELECT   oi."seller_id",
         AVG(julianday(oi."shipping_limit_date") 
           - julianday(o."order_purchase_timestamp")) AS "avg_packing_days",
         COUNT(*) AS "qty_items_sold"
FROM     "order_items" AS oi
JOIN     "orders"      AS o
       ON oi."order_id" = o."order_id"
GROUP BY oi."seller_id"
HAVING   COUNT(*) > 100
ORDER BY "avg_packing_days"
LIMIT 20;
```

```sql
--Description: Determine which product categories (English) generate the highest sales volume
SELECT   t."product_category_name_english",
         COUNT(*)                           AS "qty_items_sold"
FROM     "order_items" AS oi
JOIN     "products"                        AS p
       ON oi."product_id" = p."product_id"
JOIN     "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
GROUP BY t."product_category_name_english"
ORDER BY "qty_items_sold" DESC
LIMIT 20;
```

```sql
--Description: Bring everything together—full performance snapshot per high‑volume seller
SELECT   s."seller_id",
         s."seller_city",
         s."seller_state",
         sales."qty_items_sold",
         sales."total_sales_value",
         sales."avg_item_price",
         revs."avg_review_score",
         pack."avg_packing_days"
FROM     (
           -- sales sub‑query
           SELECT   oi."seller_id",
                    COUNT(*)           AS "qty_items_sold",
                    SUM(oi."price")    AS "total_sales_value",
                    AVG(oi."price")    AS "avg_item_price"
           FROM     "order_items" AS oi
           GROUP BY oi."seller_id"
           HAVING   COUNT(*) > 100
         ) AS sales
JOIN     "sellers" AS s     ON s."seller_id" = sales."seller_id"
LEFT JOIN (
           -- reviews sub‑query
           SELECT   oi."seller_id",
                    AVG(rv."review_score") AS "avg_review_score"
           FROM     "order_items" AS oi
           JOIN     "order_reviews" AS rv
                  ON oi."order_id" = rv."order_id"
           GROUP BY oi."seller_id"
         ) AS revs  ON revs."seller_id" = sales."seller_id"
LEFT JOIN (
           -- packing time sub‑query
           SELECT   oi."seller_id",
                    AVG(julianday(oi."shipping_limit_date") 
                      - julianday(o."order_purchase_timestamp")) AS "avg_packing_days"
           FROM     "order_items" AS oi
           JOIN     "orders"      AS o
                  ON oi."order_id" = o."order_id"
           GROUP BY oi."seller_id"
         ) AS pack  ON pack."seller_id" = sales."seller_id"
ORDER BY sales."total_sales_value" DESC
LIMIT 20;
```
