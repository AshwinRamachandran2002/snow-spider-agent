```sql
/* ============================================================
   1) Seller‑level performance report
   2) Top product categories (English) by quantity sold
   ============================================================ */

WITH sales AS (           /* total & average price, only sellers >100 items */
    SELECT   oi."seller_id",
             COUNT(*)                     AS "qty_items_sold",
             SUM(oi."price")              AS "total_sales_value",
             AVG(oi."price")              AS "avg_item_price"
    FROM     "order_items" AS oi
    GROUP BY oi."seller_id"
    HAVING   COUNT(*) > 100
),
reviews AS (              /* average review score per seller                */
    SELECT   oi."seller_id",
             AVG(rv."review_score")       AS "avg_review_score"
    FROM     "order_items"   AS oi
    JOIN     "order_reviews" AS rv
           ON oi."order_id" = rv."order_id"
    GROUP BY oi."seller_id"
),
packing AS (              /* average time (days) from purchase to ship      */
    SELECT   oi."seller_id",
             AVG(julianday(oi."shipping_limit_date")
                 - julianday(o."order_purchase_timestamp")) AS "avg_packing_days"
    FROM     "order_items" AS oi
    JOIN     "orders"      AS o
           ON oi."order_id" = o."order_id"
    GROUP BY oi."seller_id"
),
seller_report AS (        /* consolidate everything                          */
    SELECT   s."seller_id",
             s."seller_city",
             s."seller_state",
             sl."qty_items_sold",
             ROUND(sl."total_sales_value", 4) AS "total_sales_value",
             ROUND(sl."avg_item_price",   4) AS "avg_item_price",
             ROUND(rv."avg_review_score", 4) AS "avg_review_score",
             ROUND(pk."avg_packing_days", 4) AS "avg_packing_days"
    FROM     sales  AS sl
    JOIN     "sellers" AS s ON s."seller_id" = sl."seller_id"
    LEFT JOIN reviews AS rv ON rv."seller_id" = sl."seller_id"
    LEFT JOIN packing AS pk ON pk."seller_id" = sl."seller_id"
)

/* ------------------------------------------------------------
   Result set 1: Performance metrics for sellers (>100 items)
   ------------------------------------------------------------ */
SELECT *
FROM   seller_report
ORDER BY "total_sales_value" DESC, "seller_id"
;

/* ------------------------------------------------------------
   Result set 2: Product categories (English) with highest sales
   ------------------------------------------------------------ */
SELECT   t."product_category_name_english",
         COUNT(*) AS "qty_items_sold"
FROM     "order_items" AS oi
JOIN     "products"    AS p ON oi."product_id" = p."product_id"
JOIN     "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
GROUP BY t."product_category_name_english"
ORDER BY "qty_items_sold" DESC, t."product_category_name_english"
LIMIT 10;
```
