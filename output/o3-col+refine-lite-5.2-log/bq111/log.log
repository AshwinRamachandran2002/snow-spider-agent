```sql
--Description:  Single, self‑contained query that (i) derives chromosome‑level copy‑number
--              frequencies for Mitelman breast‑carcinoma cases (morph 3111 / topo 0401),
--              (ii) derives the same frequencies for TCGA‑BRCA samples using the public
--              table `Copy_Number_Segment_Masked`, and (iii) computes, for every
--              aberration type appearing in BOTH datasets, the Pearson correlation
--              coefficient and its p‑value—reporting only those aberration types that
--              have data for at least five chromosomes.
WITH
/* ====================== 1.  Mitelman breast‑cancer cohort ====================== */
mit_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
mit_total AS (SELECT COUNT(*) AS n_cases FROM mit_cases),            -- 764 cases
mit_freq AS (
  SELECT
    cc.ChrOrd                                        AS chr_ord,
    cc.Type                                          AS aberr_type,   -- Gain / Loss
    COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo)) / mit_total.n_cases
                                                   AS mit_pct
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN mit_cases mc
    ON cc.RefNo = mc.RefNo AND cc.CaseNo = mc.CaseNo
  CROSS JOIN mit_total
  WHERE cc.Type IN ('Gain','Loss')                                   -- Mitelman CNV types
  GROUP BY chr_ord, aberr_type, mit_total.n_cases
),
/* ====================== 2.  TCGA‑BRCA masked segments ========================== */
tcga_seg AS (
  SELECT
    SampleBarcode,
    CAST(Chromosome AS INT64) AS chr_ord,
    CASE
      WHEN SegmentMean >=  0.90 THEN 'Amp'
      WHEN SegmentMean >=  0.15 THEN 'Gain'
      WHEN SegmentMean <= -0.90 THEN 'Del'
      WHEN SegmentMean <= -0.15 THEN 'Loss'
    END AS aberr_type
  FROM `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Segment_Masked`
  WHERE Project = 'TCGA-BRCA'
),
tcga_total AS (SELECT COUNT(DISTINCT SampleBarcode) AS n_samples FROM tcga_seg),
tcga_freq AS (
  SELECT
    chr_ord,
    aberr_type,
    COUNT(DISTINCT SampleBarcode) / tcga_total.n_samples AS tcga_pct
  FROM tcga_seg, tcga_total
  WHERE aberr_type IS NOT NULL
  GROUP BY chr_ord, aberr_type, tcga_total.n_samples
),
/* ====================== 3.  Join & calculate correlations ===================== */
joined AS (
  SELECT
    m.chr_ord,
    m.aberr_type,
    m.mit_pct,
    t.tcga_pct
  FROM mit_freq m
  JOIN tcga_freq t
    USING (chr_ord, aberr_type)
)
SELECT
  aberr_type,
  CORR(mit_pct, tcga_pct)                                  AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`
      (ARRAY_AGG(STRUCT(mit_pct AS x, tcga_pct AS y)))     AS p_value,
  COUNT(*)                                                 AS matched_chr
FROM joined
GROUP BY aberr_type
HAVING matched_chr >= 5
ORDER BY aberr_type;
```
