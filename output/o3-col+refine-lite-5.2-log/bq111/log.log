--Description: 8) Pearson correlation for GAINS – Mitelman breast carcinoma (morph 3111 / topo 0401)
--              vs TCGA‑BRCA (project_short_name = 'TCGA-BRCA').  Uses the correct TCGA
--              table `Copy_Number_Segment_Masked`, the numeric column `segment_mean`,
--              and converts chromosome strings to integers with SAFE_CAST.
WITH
mit_gain AS (
  SELECT
    cc.ChrOrd                                       AS chr_ord,
    COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo)) / 764.0 AS mit_pct
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN `mitelman-db.prod.Cytogen` cg
    ON cc.RefNo = cg.RefNo AND cc.CaseNo = cg.CaseNo
  WHERE cg.Morph = '3111' AND cg.Topo = '0401'   -- breast carcinoma
    AND cc.Type = 'Gain'
  GROUP BY chr_ord
),
tcga_total AS (
  SELECT COUNT(DISTINCT sample_barcode) AS n_samples
  FROM `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Segment_Masked`
  WHERE project_short_name = 'TCGA-BRCA'
),
tcga_gain AS (
  SELECT
    SAFE_CAST(REGEXP_REPLACE(chromosome, r'[^0-9]', '') AS INT64) AS chr_ord,
    COUNT(DISTINCT sample_barcode) / tcga_total.n_samples          AS tcga_pct
  FROM `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Segment_Masked`, tcga_total
  WHERE project_short_name = 'TCGA-BRCA'
