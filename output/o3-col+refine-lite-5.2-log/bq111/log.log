```sql
--Description: 10) Final – one shot: correlations for all 4 aberration types,
--                 keep only those with ≥5 matching chromosomes
WITH
mit AS (
  SELECT cc.`ChrOrd` AS chr_ord,
         cc.`Type`   AS aberr_type,
         COUNT(DISTINCT CONCAT(cc.`RefNo`,'-',cc.`CaseNo`)) AS mit_cases
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN `mitelman-db.prod.Cytogen` cg
    ON cc.`RefNo`=cg.`RefNo` AND cc.`CaseNo`=cg.`CaseNo`
  WHERE cg.`Morph`='3111' AND cg.`Topo`='0401'
    AND cc.`Type` IN ('Amp','Gain','Loss','Del')
  GROUP BY chr_ord, aberr_type
),
mit_total AS (
  SELECT COUNT(DISTINCT CONCAT(`RefNo`,'-',`CaseNo`)) AS n FROM `mitelman-db.prod.Cytogen`
  WHERE `Morph`='3111' AND `Topo`='0401'
),
mit_freq AS (
  SELECT chr_ord, aberr_type, mit_cases / mit_total.n AS mit_freq
  FROM mit, mit_total
),
tcga AS (
  SELECT CAST(`chromosome` AS INT64) AS chr_ord,
         CASE WHEN alteration IN ('AMP','GA')   THEN 'Amp'
              WHEN alteration IN ('GAIN','G')   THEN 'Gain'
              WHEN alteration IN ('LOSS','L')   THEN 'Loss'
              WHEN alteration IN ('DEL','D')    THEN 'Del'
         END AS aberr_type,
         COUNT(DISTINCT sample_barcode) AS tcga_cases
  FROM `isb-cgc.TCGA_CopyNumber.cytoband_thresholded`
  WHERE cancer_type = 'BRCA'
  GROUP BY chr_ord, aberr_type
),
tcga_total AS (
  SELECT COUNT(DISTINCT sample_barcode) AS n
  FROM `isb-cgc.TCGA_CopyNumber.cytoband_thresholded`
  WHERE cancer_type = 'BRCA'
),
tcga_freq AS (
  SELECT chr_ord, aberr_type, tcga_cases / tcga_total.n AS tcga_freq
  FROM tcga, tcga_total
),
joined AS (
  SELECT m.chr_ord, m.aberr_type, m.mit_freq, t.tcga_freq
  FROM mit_freq m JOIN tcga_freq t
  USING (chr_ord, aberr_type)
)
SELECT
  aberr_type,
  CORR(mit_freq, tcga_freq)                                         AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(
      ARRAY_AGG(STRUCT(mit_freq AS x, tcga_freq AS y)))             AS p_value,
  COUNT(*)                                                          AS matched_chr
FROM joined
GROUP BY aberr_type
HAVING matched_chr >= 5
ORDER BY aberr_type;
```

The last query returns, for each aberration type (Amp, Gain, Loss, Del), the Pearson correlation coefficient (`pearson_r`) and its p‑value, using only chromosomes present in both data sets and ensuring that at least five chromosomes contribute to every reported correlation.
