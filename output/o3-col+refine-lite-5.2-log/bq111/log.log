```sql
--Description: 6) Build the TCGA copy‑number frequency table for breast‑cancer (TCGA‑BRCA)
--              using the public masked‑segment file.  SegmentMean thresholds are applied to
--              classify segments into Amp, Gain, Loss, Del.  Both `Start` and `End` are
--              wrapped in back‑ticks to avoid keyword conflicts.
WITH tcga_brca AS (
    SELECT
        SampleBarcode,
        CAST(Chromosome AS INT64)               AS chr_ord,
        CASE
            WHEN SegmentMean >=  0.90 THEN 'Amp'
            WHEN SegmentMean >=  0.15 THEN 'Gain'
            WHEN SegmentMean <= -0.90 THEN 'Del'
            WHEN SegmentMean <= -0.15 THEN 'Loss'
        END                                      AS aberr_type
    FROM `isb-cgc.TCGA_hg38_data_v0.CopyNumberSegment`
    WHERE Project = 'TCGA-BRCA'
),
tcga_counts AS (
    SELECT
        chr_ord,
        aberr_type,
        COUNT(DISTINCT SampleBarcode)           AS samples_with_abn
    FROM tcga_brca
    WHERE aberr_type IS NOT NULL               -- ignore Neutral segments
    GROUP BY chr_ord, aberr_type
),
tot AS (
    SELECT COUNT(DISTINCT SampleBarcode) AS n_samples
    FROM `isb-cgc.TCGA_hg38_data_v0.CopyNumberSegment`
    WHERE Project = 'TCGA-BRCA'
)
SELECT
    tcga_counts.*,
    ROUND(100.0 * samples_with_abn / tot.n_samples, 2) AS tcga_freq_pct
FROM tcga_counts CROSS JOIN tot
ORDER BY aberr_type, chr_ord
LIMIT 20;
```

```sql
--Description: 7) Join Mitelman and TCGA frequency tables (updated to use the segment table above);
--              shows Mitelman % vs TCGA % for chromosomes where both have data.
WITH mit_freq AS (
    -- Mitelman frequencies from query 4 (unchanged logic but without LIMIT)
    SELECT
        cc.ChrOrd  AS chr_ord,
        cc.Type    AS aberr_type,
        COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo))    / 764.0   AS mit_pct   -- 764 cases pre‑computed
    FROM `mitelman-db.prod.CytoConverted` cc
    JOIN `mitelman-db.prod.Cytogen` cg
      ON cc.RefNo = cg.RefNo AND cc.CaseNo = cg.CaseNo
    WHERE cg.Morph='3111' AND cg.Topo='0401'
      AND cc.Type IN ('Gain','Loss')                      -- only CNV categories present in Mitelman
    GROUP BY chr_ord, aberr_type
),
tcga_freq AS (      -- derived from query 6, without LIMIT
    SELECT
        chr_ord,
        aberr_type,
        samples_with_abn / tot_sample                     AS tcga_pct
    FROM (
        SELECT
            chr_ord,
            aberr_type,
            COUNT(DISTINCT SampleBarcode) AS samples_with_abn
        FROM (
            SELECT
                SampleBarcode,
                CAST(Chromosome AS INT64) AS chr_ord,
                CASE
                    WHEN SegmentMean >=  0.90 THEN 'Amp'
                    WHEN SegmentMean >=  0.15 THEN 'Gain'
                    WHEN SegmentMean <= -0.90 THEN 'Del'
                    WHEN SegmentMean <= -0.15 THEN 'Loss'
                END AS aberr_type
            FROM `isb-cgc.TCGA_hg38_data_v0.CopyNumberSegment`
            WHERE Project='TCGA-BRCA'
        )
        WHERE aberr_type IS NOT NULL
        GROUP BY chr_ord, aberr_type
    ),
    (SELECT COUNT(DISTINCT SampleBarcode) AS tot_sample
     FROM `isb-cgc.TCGA_hg38_data_v0.CopyNumberSegment`
     WHERE Project='TCGA-BRCA')
)
SELECT
    m.chr_ord,
    m.aberr_type,
    ROUND(m.mit_pct*100,2)  AS mit_pct,
    ROUND(t.tcga_pct*100,2) AS tcga_pct
FROM mit_freq m
JOIN tcga_freq t
  USING (chr_ord, aberr_type)
ORDER BY aberr_type, chr_ord
LIMIT 20;
