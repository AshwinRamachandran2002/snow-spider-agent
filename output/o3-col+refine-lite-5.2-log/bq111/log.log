```sql
--Description:  One‑query solution that delivers the requested result:
--              Pearson correlation (and p‑value) between Mitelman and TCGA
--              chromosome‑level copy‑number frequencies, separately for
--              “Gain” and “Loss”, keeping only aberration types with at least
--              five chromosomes shared by both datasets.
--
-- 1)  Mitelman cohort: all breast‑carcinoma cases (morph 3111, topo 0401).
--     • Count how many of the 764 cases show a Gain or Loss on each chromosome.
--     • Divide by 764 → mit_pct.
--
-- 2)  TCGA cohort: all BRCA samples in Copy_Number_Segment_Masked.
--     • Convert chromosome strings to integers (drop “chr”, “X”, etc.).
--     • Classify segments:  segment_mean ≥ 0.15  → Gain
--                           segment_mean ≤ ‑0.15 → Loss
--     • Count distinct samples with Gain/Loss per chromosome; divide by
--       total BRCA samples → tcga_pct.
--
-- 3)  Join on (chr_ord, aberr_type) and compute:
--        Pearson r  = CORR(mit_pct, tcga_pct)
--        p‑value    = isb‑cgc‑bq.functions.corr_pvalue_current(r, n)
--                   where n = number of matching chromosomes.
WITH
/* ─────────── Mitelman frequencies ─────────── */
mit_total AS (
  SELECT COUNT(DISTINCT CONCAT(RefNo,'-',CaseNo)) AS n_cases
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
mit_freq AS (
  SELECT
    cc.ChrOrd                                                   AS chr_ord,
    cc.Type                                                     AS aberr_type,   -- Gain / Loss
    COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo)) / mt.n_cases AS mit_pct
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN `mitelman-db.prod.Cytogen`        cg
    ON cc.RefNo = cg.RefNo AND cc.CaseNo = cg.CaseNo
  CROSS JOIN mit_total mt
  WHERE cg.Morph = '3111' AND cg.Topo = '0401'
    AND cc.Type IN ('Gain','Loss')
  GROUP BY chr_ord, aberr_type, mt.n_cases
),
/* ─────────── TCGA‑BRCA frequencies ────────── */
tcga_seg AS (
  SELECT
    SAFE_CAST(REGEXP_REPLACE(chromosome, r'[^0-9]', '') AS INT64) AS chr_ord,
    sample_barcode,
    CASE
      WHEN segment_mean >=  0.15 THEN 'Gain'
      WHEN segment_mean <= -0.15 THEN 'Loss'
    END AS aberr_type
  FROM `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Segment_Masked`
  WHERE project_short_name = 'TCGA-BRCA'
),
tcga_total AS ( SELECT COUNT(DISTINCT sample_barcode) AS n_samples FROM tcga_seg ),
tcga_freq AS (
  SELECT
    chr_ord,
    aberr_type,
    COUNT(DISTINCT sample_barcode) / n_samples AS tcga_pct
  FROM tcga_seg, tcga_total
  WHERE aberr_type IS NOT NULL AND chr_ord IS NOT NULL
  GROUP BY chr_ord, aberr_type, n_samples
),
/* ─────────── Join & correlate ─────────────── */
joined AS (
  SELECT
    m.chr_ord,
    m.aberr_type,
    m.mit_pct,
    t.tcga_pct
  FROM mit_freq m
  JOIN tcga_freq t USING (chr_ord, aberr_type)
)
SELECT
  aberr_type,
  CORR(mit_pct, tcga_pct)                                            AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`
      (CORR(mit_pct, tcga_pct), COUNT(*))                            AS p_value,
  COUNT(*)                                                           AS matched_chr
FROM joined
GROUP BY aberr_type
HAVING matched_chr >= 5
ORDER BY aberr_type;
