```sql
--Description: 10) One‑shot correlation table for Amp, Gain, Loss, Del – ensures ≥5 chromosomes
WITH
-- Mitelman frequencies ------------------------------------------------------
mit_raw AS (
    SELECT
        ChrOrd                                 AS chr_ord,
        Type                                   AS aberr_type,
        COUNT(DISTINCT CONCAT(RefNo,'-',CaseNo)) AS mit_cases
    FROM `mitelman-db.prod.CytoConverted`       cc
    JOIN `mitelman-db.prod.Cytogen`             cg
      ON cc.RefNo = cg.RefNo AND cc.CaseNo = cg.CaseNo
    WHERE cg.Morph='3111' AND cg.Topo='0401'
      AND cc.Type IN ('Gain','Loss')   -- Mitelman has only Gain/Loss for CNV
    GROUP BY chr_ord, aberr_type
), mit_total AS (SELECT 764 AS n_cases),          -- from earlier count
mit_freq AS (
    SELECT
        chr_ord,
        aberr_type,
        mit_cases / mit_total.n_cases AS mit_pct
    FROM mit_raw, mit_total
),
-- TCGA frequencies ----------------------------------------------------------
tcga_seg AS (
    SELECT
        SampleBarcode,
        CAST(Chromosome AS INT64) AS chr_ord,
        CASE
            WHEN SegmentMean >=  0.90 THEN 'Amp'
            WHEN SegmentMean >=  0.15 THEN 'Gain'
            WHEN SegmentMean <= -0.90 THEN 'Del'
            WHEN SegmentMean <= -0.15 THEN 'Loss'
        END AS aberr_type
    FROM `isb-cgc.TCGA_hg38_data_v0.CopyNumberSegment`
    WHERE Project='TCGA-BRCA'
),
tcga_raw AS (
    SELECT
        chr_ord,
        aberr_type,
        COUNT(DISTINCT SampleBarcode) AS tcga_cases
    FROM tcga_seg
    WHERE aberr_type IS NOT NULL
    GROUP BY chr_ord, aberr_type
), tcga_total AS (
    SELECT COUNT(DISTINCT SampleBarcode) AS n_samples
    FROM `isb-cgc.TCGA_hg38_data_v0.CopyNumberSegment`
    WHERE Project='TCGA-BRCA'
), tcga_freq AS (
    SELECT
        chr_ord,
        aberr_type,
        tcga_cases / n_samples AS tcga_pct
    FROM tcga_raw, tcga_total
),
-- Join and correlate --------------------------------------------------------
joined AS (
    SELECT
        m.chr_ord,
        m.aberr_type,
        m.mit_pct,
        t.tcga_pct
    FROM mit_freq m
    JOIN tcga_freq t
      USING (chr_ord, aberr_type)
)
SELECT
    aberr_type,
    CORR(mit_pct, tcga_pct)                                  AS pearson_r,
    `isb-cgc-bq.functions.corr_pvalue_current`(
        ARRAY_AGG(STRUCT(mit_pct AS x, tcga_pct AS y)))      AS p_value,
    COUNT(*)                                                 AS matched_chr
FROM joined
GROUP BY aberr_type
HAVING matched_chr >= 5
ORDER BY aberr_type;
```
