```sql
--Description: 8) Pearson correlation between Mitelman and TCGA chromosome‑level GAIN
--              frequencies (uses updated TCGA segment table).
WITH joined AS (
    SELECT
        m.chr_ord,
        (COUNT(DISTINCT CONCAT(m.RefNo,'-',m.CaseNo)) / 764.0)         AS mit_pct,
        (COUNT(DISTINCT s.SampleBarcode) / tcga_total.n)               AS tcga_pct
    FROM `mitelman-db.prod.CytoConverted` m
    JOIN `mitelman-db.prod.Cytogen` c
      ON m.RefNo = c.RefNo AND m.CaseNo = c.CaseNo
    JOIN (
        SELECT
            SampleBarcode,
            CAST(Chromosome AS INT64) AS chr_ord
        FROM `isb-cgc.TCGA_hg38_data_v0.CopyNumberSegment`
        WHERE Project='TCGA-BRCA' AND SegmentMean >= 0.15
    ) s
      ON m.ChrOrd = s.chr_ord
    CROSS JOIN (SELECT COUNT(DISTINCT SampleBarcode) AS n FROM `isb-cgc.TCGA_hg38_data_v0.CopyNumberSegment` WHERE Project='TCGA-BRCA') tcga_total
    WHERE c.Morph='3111' AND c.Topo='0401' AND m.Type='Gain'
    GROUP BY m.chr_ord, tcga_total.n
)
SELECT
    CORR(mit_pct, tcga_pct)                                  AS pearson_r,
    `isb-cgc-bq.functions.corr_pvalue_current`(
        ARRAY_AGG(STRUCT(mit_pct AS x, tcga_pct AS y)))      AS p_value,
    COUNT(*)                                                 AS matched_chr
FROM joined
HAVING matched_chr >= 5;
```

