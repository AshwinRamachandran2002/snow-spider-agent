```sql
--Description: 10) One‑shot table – correlations for Gain and Loss (the two CNV types
--               present in Mitelman).  Reports aberration_type, Pearson r, p‑value,
--               and number of matching chromosomes (≥5 required).
WITH
/* Mitelman frequencies ---------------------------------------------------- */
mit_raw AS (
  SELECT
    cc.ChrOrd                 AS chr_ord,
    cc.Type                   AS aberr_type,  -- Gain / Loss
    COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo)) AS mit_cases
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN `mitelman-db.prod.Cytogen` cg
    ON cc.RefNo = cg.RefNo AND cc.CaseNo = cg.CaseNo
  WHERE cg.Morph='3111' AND cg.Topo='0401'
    AND cc.Type IN ('Gain','Loss')
  GROUP BY chr_ord, aberr_type
), mit_total AS (
  SELECT 764 AS n_cases
), mit_freq AS (
  SELECT
    chr_ord,
    aberr_type,
    mit_cases / n_cases AS mit_pct
  FROM mit_raw, mit_total
),
/* TCGA frequencies -------------------------------------------------------- */
tcga_seg AS (
  SELECT
    SAFE_CAST(REGEXP_REPLACE(chromosome, r'[^0-9]', '') AS INT64) AS chr_ord,
    sample_barcode,
    CASE
      WHEN segment_mean >=  0.15 THEN 'Gain'
      WHEN segment_mean <= -0.15 THEN 'Loss'
    END AS aberr_type
  FROM `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Segment_Masked`
  WHERE project_short_name = 'TCGA-BRCA'
),
tcga_total AS ( SELECT COUNT(DISTINCT sample_barcode) AS n_samples FROM tcga_seg ),
tcga_raw AS (
  SELECT
    chr_ord,
    aberr_type,
    COUNT(DISTINCT sample_barcode) AS tcga_cases
  FROM tcga_seg
  WHERE aberr_type IS NOT NULL
  GROUP BY chr_ord, aberr_type
), tcga_freq AS (
  SELECT
    chr_ord,
    aberr_type,
    tcga_cases / n_samples AS tcga_pct
  FROM tcga_raw, tcga_total
),
/* Join & correlate -------------------------------------------------------- */
joined AS (
  SELECT
    m.chr_ord,
    m.aberr_type,
    m.mit_pct,
    t.tcga_pct
  FROM mit_freq m
  JOIN tcga_freq t USING (chr_ord, aberr_type)
)
SELECT
  aberr_type,
  CORR(mit_pct, tcga_pct)                                 AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`
      (ARRAY_AGG(STRUCT(mit_pct AS x, tcga_pct AS y)))    AS p_value,
  COUNT(*)                                                AS matched_chr
FROM joined
GROUP BY aberr_type
HAVING matched_chr >= 5
ORDER BY aberr_type;
```
