Below is an example walk‑through – from simple exploration to the final correlation – expressed as at most 10 different BigQuery SQL queries.  
Replace the project/dataset names that begin with `isb-cgc` by the exact TCGA copy–number tables available in your environment (left as placeholders here).  
Every query is limited to 20 rows (except the last one that produces the final correlation table).

```sql
--Description: 1) Inspect a few CYTOGEN rows to verify the (morph, topo) codes we need
SELECT `RefNo`, `CaseNo`, `Morph`, `Topo`, `SpecMorph`
FROM `mitelman-db.prod.Cytogen`
WHERE `Morph` = '3111' AND `Topo` = '0401'
LIMIT 20;
```

```sql
--Description: 2) Count how many unique Mitelman cases (RefNo–CaseNo) match morph 3111 / topo 0401
SELECT COUNT(DISTINCT CONCAT(`RefNo`,'-',`CaseNo`)) AS mitelman_total_cases
FROM `mitelman-db.prod.Cytogen`
WHERE `Morph` = '3111' AND `Topo` = '0401';
```

```sql
--Description: 3) See which copy‑number “Type” values exist in CytoConverted for those cases
SELECT DISTINCT `Type`
FROM `mitelman-db.prod.CytoConverted` AS cc
JOIN `mitelman-db.prod.Cytogen` AS cg
  ON cc.`RefNo` = cg.`RefNo` AND cc.`CaseNo` = cg.`CaseNo`
WHERE cg.`Morph` = '3111' AND cg.`Topo` = '0401'
LIMIT 20;
```

```sql
--Description: 4) Build the Mitelman frequency table (per chromosome & aberration type)
WITH mit_cases AS (
  SELECT DISTINCT `RefNo`, `CaseNo`
  FROM `mitelman-db.prod.Cytogen`
  WHERE `Morph` = '3111' AND `Topo` = '0401'
),
mit_counts AS (
  SELECT cc.`ChrOrd`              AS chr_ord,
         cc.`Type`                AS aberr_type,
         COUNT(DISTINCT CONCAT(cc.`RefNo`,'-',cc.`CaseNo`)) AS cases_with_abn
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN mit_cases mc
    ON cc.`RefNo` = mc.`RefNo` AND cc.`CaseNo` = mc.`CaseNo`
  GROUP BY chr_ord, aberr_type
),
tot AS (
  SELECT COUNT(*) AS n_cases FROM mit_cases
)
SELECT mc.*, ROUND(100.0*cases_with_abn/tot.n_cases,2) AS mit_freq_pct
FROM mit_counts mc CROSS JOIN tot
ORDER BY aberr_type, chr_ord
LIMIT 20;
```

```sql
--Description: 5) Peek at TCGA cytoband‑level copy‑number data (placeholder table name shown)
SELECT `sample_barcode`,
       `chromosome`   AS chr_ord,
       `alteration`   AS aberr_type      -- e.g. AMP/Gain/Loss/Del/Neutral
FROM `isb-cgc.TCGA_CopyNumber.cytoband_thresholded`
LIMIT 20;
```

```sql
--Description: 6) Build the TCGA frequency table (Breast cancer = BRCA)
WITH tcga_brca AS (
  SELECT *
  FROM `isb-cgc.TCGA_CopyNumber.cytoband_thresholded`
  WHERE cancer_type = 'BRCA'                  -- adjust if column name differs
),
tcga_counts AS (
  SELECT CAST(`chromosome` AS INT64)        AS chr_ord,
         CASE
           WHEN `alteration` IN ('AMP','GA')    THEN 'Amp'
           WHEN `alteration` IN ('GAIN','G')    THEN 'Gain'
           WHEN `alteration` IN ('LOSS','L')    THEN 'Loss'
           WHEN `alteration` IN ('DEL','D')     THEN 'Del'
         END                                   AS aberr_type,
         COUNT(DISTINCT `sample_barcode`)      AS samples_with_abn
  FROM tcga_brca
  GROUP BY chr_ord, aberr_type
),
tot AS ( SELECT COUNT(DISTINCT sample_barcode) AS n_samples FROM tcga_brca )
SELECT tc.*, ROUND(100.0*samples_with_abn/tot.n_samples,2) AS tcga_freq_pct
FROM tcga_counts tc CROSS JOIN tot
ORDER BY aberr_type, chr_ord
LIMIT 20;
```

```sql
--Description: 7) Join Mitelman and TCGA frequency tables (only rows present in both)
WITH mit_freq AS (  -- from query 4, without the LIMIT
  SELECT chr_ord, aberr_type, ROUND(100.0*cases_with_abn/total_cases,4) AS mit_pct
  FROM (
    SELECT cc.`ChrOrd` AS chr_ord,
           cc.`Type`   AS aberr_type,
           COUNT(DISTINCT CONCAT(cc.`RefNo`,'-',cc.`CaseNo`)) AS cases_with_abn
    FROM `mitelman-db.prod.CytoConverted` cc
    JOIN (
      SELECT DISTINCT `RefNo`, `CaseNo`
      FROM `mitelman-db.prod.Cytogen`
      WHERE `Morph`='3111' AND `Topo`='0401'
    ) AS s
      ON cc.`RefNo`=s.`RefNo` AND cc.`CaseNo`=s.`CaseNo`
    GROUP BY chr_ord, aberr_type
  ), (SELECT COUNT(DISTINCT CONCAT(`RefNo`,'-',`CaseNo`)) AS total_cases
      FROM `mitelman-db.prod.Cytogen`
      WHERE `Morph`='3111' AND `Topo`='0401')
),
tcga_freq AS (      -- from query 6, without the LIMIT
  SELECT chr_ord, aberr_type, ROUND(100.0*samples_with_abn/total_samples,4) AS tcga_pct
  FROM (
    SELECT CAST(`chromosome` AS INT64) AS chr_ord,
           CASE WHEN `alteration` IN ('AMP','GA')   THEN 'Amp'
                WHEN `alteration` IN ('GAIN','G')   THEN 'Gain'
                WHEN `alteration` IN ('LOSS','L')   THEN 'Loss'
                WHEN `alteration` IN ('DEL','D')    THEN 'Del'
           END AS aberr_type,
           COUNT(DISTINCT sample_barcode) AS samples_with_abn
    FROM `isb-cgc.TCGA_CopyNumber.cytoband_thresholded`
    WHERE cancer_type='BRCA'
    GROUP BY chr_ord, aberr_type
  ), (SELECT COUNT(DISTINCT sample_barcode) AS total_samples
      FROM `isb-cgc.TCGA_CopyNumber.cytoband_thresholded`
      WHERE cancer_type='BRCA')
)
SELECT m.chr_ord, m.aberr_type, m.mit_pct, t.tcga_pct
FROM mit_freq m
JOIN tcga_freq t
  USING (chr_ord, aberr_type)
ORDER BY aberr_type, chr_ord
LIMIT 20;
```

```sql
--Description: 8) Compute Pearson correlation & p‑value for GAINs across chromosomes
WITH joined AS (   -- query 7 without LIMIT but WHERE aberr_type = 'Gain'
  SELECT m.chr_ord, m.mit_pct, t.tcga_pct
  FROM (
    -- Mitelman Gain freq
    SELECT cc.`ChrOrd` AS chr_ord,
           ROUND(100.0*COUNT(DISTINCT CONCAT(cc.`RefNo`,'-',cc.`CaseNo`))
                 / (SELECT COUNT(DISTINCT CONCAT(`RefNo`,'-',`CaseNo`))
                    FROM `mitelman-db.prod.Cytogen`
                    WHERE `Morph`='3111' AND `Topo`='0401'),4) AS mit_pct
    FROM `mitelman-db.prod.CytoConverted` cc
    JOIN `mitelman-db.prod.Cytogen` cg
      ON cc.`RefNo`=cg.`RefNo` AND cc.`CaseNo`=cg.`CaseNo`
    WHERE cg.`Morph`='3111' AND cg.`Topo`='0401' AND cc.`Type`='Gain'
    GROUP BY chr_ord
  ) m
  JOIN (
    -- TCGA Gain freq
    SELECT CAST(`chromosome` AS INT64) AS chr_ord,
           ROUND(100.0*COUNT(DISTINCT sample_barcode)
                 / (SELECT COUNT(DISTINCT sample_barcode)
                    FROM `isb-cgc.TCGA_CopyNumber.cytoband_thresholded`
                    WHERE cancer_type='BRCA'),4) AS tcga_pct
    FROM `isb-cgc.TCGA_CopyNumber.cytoband_thresholded`
    WHERE cancer_type='BRCA'
      AND `alteration` IN ('GAIN','G')
    GROUP BY chr_ord
  ) t USING (chr_ord)
)
SELECT
  CORR(mit_pct, tcga_pct)                                AS pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(
      ARRAY_AGG(STRUCT(mit_pct AS x, tcga_pct AS y)))    AS p_value,
  COUNT(*)                                               AS matched_chr
FROM joined
HAVING matched_chr >= 5;
```

