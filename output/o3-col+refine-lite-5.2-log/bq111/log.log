```sql
--Description:  Correlate chromosome‑level “Gain” frequencies between Mitelman
--              breast‑carcinoma cases (morph 3111 / topo 0401) and TCGA‑BRCA
--              copy‑number data.  
--              • Mitelman: % of 3111/0401 cases (764 total) having a Gain per chromosome  
--              • TCGA:   % of BRCA samples whose masked segment_mean ≥ 0.15 per chromosome  
--              • Join on numeric chromosome (chr_ord) after stripping non‑digits  
--              • Compute Pearson r with BigQuery’s CORR, then two‑tailed p‑value via
--                ISB‑CGC UDF corr_pvalue_current(r FLOAT64, n INT64).  Result displayed
--                only if at least five chromosomes are compared.
WITH
/* 1. Mitelman breast‑cancer cases ----------------------------------------- */
mit_cases AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111' AND Topo = '0401'
),
mit_gain AS (
  SELECT
    cc.ChrOrd AS chr_ord,
    COUNT(DISTINCT CONCAT(cc.RefNo,'-',cc.CaseNo))
      / (SELECT COUNT(*) FROM mit_cases)       AS mit_pct
  FROM `mitelman-db.prod.CytoConverted` cc
  JOIN mit_cases mc
    ON cc.RefNo = mc.RefNo AND cc.CaseNo = mc.CaseNo
  WHERE cc.Type = 'Gain'
  GROUP BY chr_ord
),
/* 2. TCGA‑BRCA samples ----------------------------------------------------- */
tcga_total AS (
  SELECT COUNT(DISTINCT sample_barcode) AS n_samples
  FROM `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Segment_Masked`
  WHERE project_short_name = 'TCGA-BRCA'
),
tcga_gain AS (
  SELECT
    SAFE_CAST(REGEXP_REPLACE(chromosome, r'[^0-9]', '') AS INT64) AS chr_ord,
    COUNT(DISTINCT sample_barcode) / tcga_total.n_samples          AS tcga_pct
  FROM `isb-cgc.TCGA_hg38_data_v0.Copy_Number_Segment_Masked`, tcga_total
  WHERE project_short_name = 'TCGA-BRCA'
    AND segment_mean >= 0.15
  GROUP BY chr_ord, tcga_total.n_samples
  HAVING chr_ord IS NOT NULL
),
/* 3. Join datasets -------------------------------------------------------- */
joined AS (
  SELECT m.chr_ord, m.mit_pct, t.tcga_pct
  FROM mit_gain m
  JOIN tcga_gain t USING (chr_ord)
),
/* 4. Pearson correlation & p‑value --------------------------------------- */
stats AS (
  SELECT
    CORR(mit_pct, tcga_pct) AS pearson_r,
    COUNT(*)               AS matched_chr
  FROM joined
)
SELECT
  pearson_r,
  `isb-cgc-bq.functions.corr_pvalue_current`(pearson_r, matched_chr) AS p_value,
  matched_chr
FROM stats
WHERE matched_chr >= 5;
