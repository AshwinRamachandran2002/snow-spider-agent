```sql
--Description: 1) Preview a few delivered orders together with their items and seller information
SELECT DISTINCT oi.order_id,
       o.order_status,
       oi.seller_id,
       oi.price,
       oi.freight_value
FROM   olist_order_items AS oi
JOIN   olist_orders      AS o  ON o.order_id = oi.order_id
WHERE  o.order_status = 'delivered'
LIMIT 20;
```

```sql
--Description: 2) Count the number of distinct customer_unique_id served by every seller (all delivered orders)
SELECT   oi.seller_id,
         COUNT(DISTINCT c.customer_unique_id) AS distinct_customers
FROM     olist_order_items  AS oi
JOIN     olist_orders       AS o   ON o.order_id = oi.order_id  AND o.order_status = 'delivered'
JOIN     olist_customers    AS c   ON c.customer_id = o.customer_id
GROUP BY oi.seller_id
LIMIT 20;
```

```sql
--Description: 3) Show the (tentative) top‑20 sellers by number of distinct customers (delivered orders only)
SELECT   oi.seller_id,
         COUNT(DISTINCT c.customer_unique_id) AS distinct_customers
FROM     olist_order_items  AS oi
JOIN     olist_orders       AS o   ON o.order_id = oi.order_id  AND o.order_status = 'delivered'
JOIN     olist_customers    AS c   ON c.customer_id = o.customer_id
GROUP BY oi.seller_id
ORDER BY distinct_customers DESC
LIMIT 20;
```

```sql
--Description: 4) Preview “profit” (price − freight_value) for a handful of delivered order items
SELECT DISTINCT oi.order_id,
       oi.seller_id,
       (oi.price - oi.freight_value) AS profit_per_item
FROM   olist_order_items AS oi
JOIN   olist_orders      AS o ON o.order_id = oi.order_id
WHERE  o.order_status = 'delivered'
LIMIT 20;
```

```sql
--Description: 5) Aggregate total profit per seller across all delivered order items
SELECT   oi.seller_id,
         SUM(oi.price - oi.freight_value) AS total_profit
FROM     olist_order_items AS oi
JOIN     olist_orders      AS o ON o.order_id = oi.order_id  AND o.order_status = 'delivered'
GROUP BY oi.seller_id
LIMIT 20;
```

```sql
--Description: 6) Show the (tentative) top‑20 sellers by total profit (delivered orders only)
SELECT   oi.seller_id,
         SUM(oi.price - oi.freight_value) AS total_profit
FROM     olist_order_items AS oi
JOIN     olist_orders      AS o ON o.order_id = oi.order_id  AND o.order_status = 'delivered'
