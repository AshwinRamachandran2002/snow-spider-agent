```sql
--Description: 9) Count the number of 5‑star reviews each seller has received on delivered orders
SELECT   oi.seller_id,
         COUNT(*) AS five_star_reviews
FROM     olist_order_items   AS oi
JOIN     olist_orders        AS o  ON o.order_id = oi.order_id        AND o.order_status = 'delivered'
JOIN     olist_order_reviews AS r  ON r.order_id = oi.order_id        AND r.review_score = 5
GROUP BY oi.seller_id
LIMIT 20;
