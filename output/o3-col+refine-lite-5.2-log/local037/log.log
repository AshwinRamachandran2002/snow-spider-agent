```sql
--Description: Show the different kinds of payment methods customers can use.
SELECT DISTINCT "payment_type"
FROM "olist_order_payments"
LIMIT 20;
```

```sql
--Description: Look at the different product categories together with their English names.
SELECT DISTINCT p."product_category_name",
                t."product_category_name_english"
FROM "olist_products"            AS p
LEFT JOIN "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
LIMIT 20;
```

```sql
--Description: Preview how orders, their items, the products’ categories and the payments link together.
SELECT DISTINCT oi."order_id",
                p."product_category_name",
                pay."payment_type",
                pay."payment_value"
FROM   "olist_order_items"   AS oi
JOIN   "olist_products"      AS p   ON p."product_id"  = oi."product_id"
JOIN   "olist_order_payments" AS pay ON pay."order_id"  = oi."order_id"
LIMIT 20;
```

```sql
--Description: Count how many payments each payment type has overall.
SELECT pay."payment_type",
       COUNT(*) AS "n_payments"
FROM   "olist_order_payments" AS pay
GROUP  BY pay."payment_type"
ORDER  BY "n_payments" DESC
LIMIT 20;
```

```sql
--Description: For every product category, count how many payments (all payment types combined) it received.
SELECT cat."product_category_name",
       COUNT(*) AS "total_payments"
FROM  (SELECT DISTINCT oi."order_id",      -- one row per order‑category
                      p."product_category_name"
       FROM   "olist_order_items" AS oi
       JOIN   "olist_products"    AS p ON p."product_id" = oi."product_id") AS cat
JOIN  "olist_order_payments" AS pay
      ON pay."order_id" = cat."order_id"
GROUP BY cat."product_category_name"
ORDER BY "total_payments" DESC
LIMIT 20;
```

```sql
--Description: Break the previous number down by payment type as well (payments per category & type).
SELECT cat."product_category_name",
       pay."payment_type",
       COUNT(*) AS "payments"
FROM  (SELECT DISTINCT oi."order_id",
                      p."product_category_name"
       FROM   "olist_order_items" AS oi
       JOIN   "olist_products"    AS p ON p."product_id" = oi."product_id") AS cat
JOIN  "olist_order_payments" AS pay
      ON pay."order_id" = cat."order_id"
GROUP BY cat."product_category_name", pay."payment_type"
ORDER BY payments DESC
LIMIT 20;
```

```sql
--Description: For each category, keep only its most‑used payment type and how many times it was used.
SELECT *
FROM (
        SELECT cat."product_category_name",
               pay."payment_type",
               COUNT(*)                        AS "payments",
               ROW_NUMBER() OVER (PARTITION BY cat."product_category_name"
                                  ORDER BY COUNT(*) DESC) AS rn
        FROM  (SELECT DISTINCT oi."order_id",
                              p."product_category_name"
               FROM   "olist_order_items" AS oi
               JOIN   "olist_products"    AS p ON p."product_id" = oi."product_id") AS cat
        JOIN  "olist_order_payments" AS pay
              ON pay."order_id" = cat."order_id"
        GROUP BY cat."product_category_name", pay."payment_type"
) 
WHERE rn = 1
ORDER BY "payments" DESC
LIMIT 20;
```

```sql
--Description: Rank all categories by the size of their dominant payment type.
SELECT res."product_category_name",
       res."payment_type",
       res."payments",
       DENSE_RANK() OVER (ORDER BY res."payments" DESC) AS category_rank
FROM (
        SELECT cat."product_category_name",
               pay."payment_type",
               COUNT(*)                        AS "payments",
               ROW_NUMBER() OVER (PARTITION BY cat."product_category_name"
                                  ORDER BY COUNT(*) DESC) AS rn
        FROM  (SELECT DISTINCT oi."order_id",
                              p."product_category_name"
               FROM   "olist_order_items" AS oi
               JOIN   "olist_products"    AS p ON p."product_id" = oi."product_id") AS cat
        JOIN  "olist_order_payments" AS pay
              ON pay."order_id" = cat."order_id"
        GROUP BY cat."product_category_name", pay."payment_type"
) AS res
WHERE res.rn = 1
ORDER BY res."payments" DESC
LIMIT 20;
```

```sql
--Description: Show the three categories whose dominant payment type has the largest number of payments.
SELECT res."product_category_name",
       res."payment_type"        AS "most_used_payment_type",
       res."payments"            AS "payments_in_that_type"
FROM (
        SELECT cat."product_category_name",
               pay."payment_type",
               COUNT(*)                        AS "payments",
               ROW_NUMBER() OVER (PARTITION BY cat."product_category_name"
                                  ORDER BY COUNT(*) DESC) AS rn
        FROM  (SELECT DISTINCT oi."order_id",
                              p."product_category_name"
               FROM   "olist_order_items" AS oi
               JOIN   "olist_products"    AS p ON p."product_id" = oi."product_id") AS cat
        JOIN  "olist_order_payments" AS pay
              ON pay."order_id" = cat."order_id"
        GROUP BY cat."product_category_name", pay."payment_type"
) AS res
WHERE res.rn = 1
ORDER BY res."payments" DESC
LIMIT 3;
```

```sql
--Description: Translate those three categories to English while keeping the figures.
SELECT tr."product_category_name_english" AS "category_english",
       fin."most_used_payment_type",
       fin."payments_in_that_type"
FROM (
        SELECT res."product_category_name",
               res."payment_type" AS "most_used_payment_type",
               res."payments"     AS "payments_in_that_type"
        FROM (
                SELECT cat."product_category_name",
                       pay."payment_type",
                       COUNT(*) AS "payments",
                       ROW_NUMBER() OVER (PARTITION BY cat."product_category_name"
                                          ORDER BY COUNT(*) DESC) AS rn
                FROM  (SELECT DISTINCT oi."order_id",
                                      p."product_category_name"
                       FROM   "olist_order_items" AS oi
                       JOIN   "olist_products"    AS p
                             ON p."product_id" = oi."product_id") AS cat
                JOIN  "olist_order_payments" AS pay
                      ON pay."order_id" = cat."order_id"
                GROUP BY cat."product_category_name", pay."payment_type"
        ) AS res
        WHERE res.rn = 1
        ORDER BY res."payments" DESC
        LIMIT 3
) AS fin
LEFT JOIN "product_category_name_translation" AS tr
       ON fin."product_category_name" = tr."product_category_name"
LIMIT 20;
```
