```sql
--Description: Preview a sample of teams with their API identifiers and long names
SELECT DISTINCT "team_api_id", "team_long_name"
FROM "Team"
LIMIT 20;
```

```sql
--Description: Inspect basic match information (teams and final score) to understand where wins are recorded
SELECT "match_api_id",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM "Match"
LIMIT 20;
```

```sql
--Description: Count how many HOME matches each team won
SELECT "home_team_api_id" AS "team_api_id",
       COUNT(*)           AS "home_wins"
FROM   "Match"
WHERE  "home_team_goal" > "away_team_goal"
GROUP BY "home_team_api_id"
LIMIT 20;
```

```sql
--Description: Count how many AWAY matches each team won
SELECT "away_team_api_id" AS "team_api_id",
       COUNT(*)           AS "away_wins"
FROM   "Match"
WHERE  "away_team_goal" > "home_team_goal"
GROUP BY "away_team_api_id"
LIMIT 20;
```

```sql
--Description: Combine all wins (home + away) into one list, 1 row per win
SELECT "team_api_id",
       1 AS "wins"
FROM   "Match"
WHERE  "home_team_goal" > "away_team_goal"

UNION ALL

SELECT "team_api_id",
       1 AS "wins"
FROM  (
        SELECT "away_team_api_id" AS "team_api_id",
               "away_team_goal",
               "home_team_goal"
        FROM   "Match"
      )
WHERE  "away_team_goal" > "home_team_goal"
LIMIT 20;
```

```sql
--Description: Aggregate the list above to get total wins for every team
SELECT "team_api_id",
       SUM("wins") AS "total_wins"
FROM (
        SELECT "home_team_api_id" AS "team_api_id", 1 AS "wins"
        FROM   "Match"
        WHERE  "home_team_goal" > "away_team_goal"

        UNION ALL

        SELECT "away_team_api_id" AS "team_api_id", 1 AS "wins"
        FROM   "Match"
        WHERE  "away_team_goal" > "home_team_goal"
     )
GROUP BY "team_api_id"
LIMIT 20;
```

```sql
--Description: Attach team names to their total win counts
SELECT  w."team_api_id",
        t."team_long_name",
        w."total_wins"
FROM   (
          SELECT "team_api_id",
                 SUM("wins") AS "total_wins"
          FROM (
                  SELECT "home_team_api_id" AS "team_api_id", 1 AS "wins"
                  FROM   "Match"
                  WHERE  "home_team_goal" > "away_team_goal"

                  UNION ALL

                  SELECT "away_team_api_id" AS "team_api_id", 1 AS "wins"
                  FROM   "Match"
                  WHERE  "away_team_goal" > "home_team_goal"
               )
          GROUP BY "team_api_id"
       ) AS w
JOIN   "Team" t
       ON t."team_api_id" = w."team_api_id"
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – Top‑10 teams across all leagues with the most total wins
SELECT  t."team_long_name"      AS "team",
        w."total_wins"          AS "wins"
FROM   (
          SELECT "team_api_id",
                 SUM("wins") AS "total_wins"
          FROM (
                  SELECT "home_team_api_id" AS "team_api_id", 1 AS "wins"
                  FROM   "Match"
                  WHERE  "home_team_goal" > "away_team_goal"

                  UNION ALL

                  SELECT "away_team_api_id" AS "team_api_id", 1 AS "wins"
                  FROM   "Match"
                  WHERE  "away_team_goal" > "home_team_goal"
               )
          GROUP BY "team_api_id"
       ) AS w
JOIN   "Team" t
       ON t."team_api_id" = w."team_api_id"
ORDER BY w."total_wins" DESC
LIMIT 10;
```
