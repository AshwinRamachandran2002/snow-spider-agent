```sql
-- Description: Inspect a few NPM rows in DEPENDENCIES to understand the “Dependency” object layout.
SELECT  "Name",
        "Version",
        "Dependency":"Name"::STRING      AS "DepName",
        "Dependency":"Version"::STRING   AS "DepVersion",
        "Dependency":"System"::STRING    AS "DepSystem"
FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES"
WHERE   "System" = 'NPM'
LIMIT 20;
```

```sql
-- Description: Take a look at NPM PACKAGEVERSIONS and the JSON stored in “VersionInfo”.
SELECT  "Name",
        "Version",
        "VersionInfo"
FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
WHERE   "System" = 'NPM'
LIMIT 20;
```

```sql
-- Description: Extract “IsRelease” and “Ordinal” fields from the VersionInfo JSON for NPM packages.
SELECT  "Name",
        "Version",
        "VersionInfo":"IsRelease"::BOOLEAN    AS "IsRelease",
        "VersionInfo":"Ordinal"::NUMBER       AS "Ordinal"
FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
WHERE   "System" = 'NPM'
LIMIT 20;
```

```sql
-- Description: Identify the highest‑ordinal release version for each NPM package.
WITH npm_releases AS (
    SELECT  "Name",
            "Version",
            "VersionInfo":"Ordinal"::NUMBER   AS "Ordinal",
            ROW_NUMBER() OVER (PARTITION BY "Name"
                               ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC) AS rn
    FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
    WHERE   "System" = 'NPM'
      AND   "VersionInfo":"IsRelease"::BOOLEAN = TRUE
)
SELECT  "Name",
        "Version",
        "Ordinal"
FROM    npm_releases
WHERE   rn = 1
LIMIT 20;
```

```sql
-- Description: Join the highest‑release NPM versions to their direct dependencies.
WITH top_releases AS (
    SELECT  "Name",
            "Version"
    FROM (
        SELECT  "Name",
                "Version",
                ROW_NUMBER() OVER (PARTITION BY "Name"
                                   ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC) AS rn
        FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
        WHERE   "System" = 'NPM'
          AND   "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    )
    WHERE rn = 1
)
SELECT  d."Name"                         AS "PkgName",
        d."Version"                      AS "PkgVersion",
        d."Dependency":"Name"::STRING    AS "DepName",
        d."Dependency":"Version"::STRING AS "DepVersion"
FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES"  d
JOIN    top_releases tr
          ON  tr."Name"    = d."Name"
          AND tr."Version" = d."Version"
LIMIT 20;
```

```sql
-- Description: Count how many times each (dependency name, dependency version) pair appears.
WITH top_releases AS (
    SELECT  "Name",
            "Version"
    FROM (
        SELECT  "Name",
                "Version",
                ROW_NUMBER() OVER (PARTITION BY "Name"
                                   ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC) AS rn
        FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
        WHERE   "System" = 'NPM'
          AND   "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    )
    WHERE rn = 1
),
top_dependencies AS (
    SELECT  d."Dependency":"Name"::STRING    AS "DepName",
            d."Dependency":"Version"::STRING AS "DepVersion"
    FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES"  d
    JOIN    top_releases tr
          ON tr."Name"    = d."Name"
         AND tr."Version" = d."Version"
    WHERE   d."System" = 'NPM'
)
SELECT  "DepName",
        "DepVersion",
        COUNT(*)        AS "Appearances"
FROM    top_dependencies
GROUP BY "DepName", "DepVersion"
LIMIT 20;
```

```sql
-- Description: Show the most frequent dependency among highest‑release NPM packages (top 1).
WITH top_releases AS (
    SELECT  "Name",
            "Version"
    FROM (
        SELECT  "Name",
                "Version",
                ROW_NUMBER() OVER (PARTITION BY "Name"
                                   ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC) AS rn
        FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
        WHERE   "System" = 'NPM'
          AND   "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    )
    WHERE rn = 1
),
top_dependencies AS (
    SELECT  d."Dependency":"Name"::STRING    AS "DepName",
            d."Dependency":"Version"::STRING AS "DepVersion"
    FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES"  d
    JOIN    top_releases tr
          ON tr."Name"    = d."Name"
         AND tr."Version" = d."Version"
    WHERE   d."System" = 'NPM'
)
SELECT  "DepName",
        "DepVersion",
        COUNT(*)        AS "Appearances"
FROM    top_dependencies
GROUP BY "DepName", "DepVersion"
ORDER BY "Appearances" DESC
LIMIT 1;
```

```sql
-- Description: Display the top 10 most frequent dependencies to give broader context.
WITH top_releases AS (
    SELECT  "Name",
            "Version"
    FROM (
        SELECT  "Name",
                "Version",
                ROW_NUMBER() OVER (PARTITION BY "Name"
                                   ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC) AS rn
        FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
        WHERE   "System" = 'NPM'
          AND   "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    )
    WHERE rn = 1
),
top_dependencies AS (
    SELECT  d."Dependency":"Name"::STRING    AS "DepName",
            d."Dependency":"Version"::STRING AS "DepVersion"
    FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES"  d
    JOIN    top_releases tr
          ON tr."Name"    = d."Name"
         AND tr."Version" = d."Version"
    WHERE   d."System" = 'NPM'
)
SELECT  "DepName",
        "DepVersion",
        COUNT(*)        AS "Appearances"
FROM    top_dependencies
GROUP BY "DepName", "DepVersion"
ORDER BY "Appearances" DESC
LIMIT 10;
```

```sql
-- Description: For a specific popular dependency (replace %chalk% with desired), find some highest‑release packages depending on it.
WITH top_releases AS (
    SELECT  "Name",
            "Version"
    FROM (
        SELECT  "Name",
                "Version",
                ROW_NUMBER() OVER (PARTITION BY "Name"
                                   ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC) AS rn
        FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
        WHERE   "System" = 'NPM'
          AND   "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    )
    WHERE rn = 1
)
SELECT  tr."Name"                   AS "PkgName",
        tr."Version"                AS "PkgVersion"
FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES"  d
JOIN    top_releases tr
      ON tr."Name"    = d."Name"
     AND tr."Version" = d."Version"
WHERE   d."System" = 'NPM'
  AND   d."Dependency":"Name"::STRING ILIKE '%chalk%'
LIMIT 20;
