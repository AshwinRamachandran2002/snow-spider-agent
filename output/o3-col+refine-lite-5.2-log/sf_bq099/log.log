```sql
--Description: 
-- We need, in one query, to show how many A01B3‑class patent applications each of the TOP‑3 assignees
-- (ranked by total distinct applications) filed in their own “peak year”, broken down by country code.  
-- Logic inside CTEs:
--   1) top3 ‑ find the three assignee names with the most distinct applications that carry a CPC code
--      starting “A01B3%”.  
--   2) peak_year ‑ for every assignee in top3, compute application counts per filing‑year and keep the
--      year with the highest count (rn = 1).  
--   3) final SELECT ‑ restrict PUBLICATIONS to those same assignees *and* the peak years just found,
--      then group by assignee, year, country_code to obtain the application count.  
-- Snowflake rule: expressions listed in SELECT but not aggregated must re‑appear verbatim in GROUP BY;
-- therefore we group by the raw expressions (not their aliases).

WITH top3 AS (                              -- step‑1: biggest three assignees
      SELECT  a.value::VARIANT:"name"::STRING AS assignee_name
      FROM    PATENTS.PATENTS.PUBLICATIONS p,
              LATERAL FLATTEN(input => p."cpc") c,
              LATERAL FLATTEN(input => p."assignee_harmonized") a
      WHERE   c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
      GROUP BY a.value::VARIANT:"name"::STRING
      ORDER BY COUNT(DISTINCT p."application_number") DESC
      LIMIT 3
),  
peak_year AS (                              -- step‑2: each assignee’s year with most filings
      SELECT  a.value::VARIANT:"name"::STRING AS assignee_name,
              (p."filing_date"/10000)::INT    AS yr,
              ROW_NUMBER() OVER (PARTITION BY a.value::VARIANT:"name"::STRING
                                 ORDER BY COUNT(DISTINCT p."application_number") DESC) AS rn
      FROM    PATENTS.PATENTS.PUBLICATIONS p,
              LATERAL FLATTEN(input => p."cpc") c,
              LATERAL FLATTEN(input => p."assignee_harmonized") a
      WHERE   c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
        AND   a.value::VARIANT:"name"::STRING IN (SELECT assignee_name FROM top3)
      GROUP BY a.value::VARIANT:"name"::STRING,
               (p."filing_date"/10000)::INT
)  
SELECT  a.value::VARIANT:"name"::STRING          AS "assignee_name",
        (p."filing_date"/10000)::INT            AS "year",
        a.value::VARIANT:"country_code"::STRING AS "country_code",
        COUNT(DISTINCT p."application_number")  AS "application_count"
FROM    PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc")            c,
        LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE   c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
  AND   a.value::VARIANT:"name"::STRING IN (SELECT assignee_name FROM top3)
  AND   (p."filing_date"/10000)::INT IN (SELECT yr FROM peak_year WHERE rn = 1)
GROUP BY a.value::VARIANT:"name"::STRING,
         (p."filing_date"/10000)::INT,
         a.value::VARIANT:"country_code"::STRING
ORDER BY "application_count" DESC
LIMIT 20;
