```sql
--Description: Count distinct applications for every assignee that has at least one “A01B3” application.  
SELECT a.value::VARIANT:"name"::STRING                AS "assignee_name",
       COUNT(DISTINCT p."application_number")        AS "application_count"
FROM PATENTS.PATENTS.PUBLICATIONS  p,
     LATERAL FLATTEN(input => p."cpc")            c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
GROUP BY "assignee_name"
ORDER BY "application_count" DESC
LIMIT 20;
```

```sql
--Description: List only the TOP‑3 assignees by total “A01B3” application count.  
SELECT a.value::VARIANT:"name"::STRING                AS "assignee_name",
       COUNT(DISTINCT p."application_number")        AS "total_apps"
FROM PATENTS.PATENTS.PUBLICATIONS  p,
     LATERAL FLATTEN(input => p."cpc")            c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
GROUP BY "assignee_name"
ORDER BY "total_apps" DESC
LIMIT 3;
```

```sql
--Description: For each of the TOP‑3 assignees, show the yearly application counts.  
SELECT a.value::VARIANT:"name"::STRING                AS "assignee_name",
       (p."filing_date"/10000)::INT                  AS "year",
       COUNT(DISTINCT p."application_number")        AS "applications_in_year"
FROM PATENTS.PATENTS.PUBLICATIONS  p,
     LATERAL FLATTEN(input => p."cpc")            c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
  AND a.value::VARIANT:"name"::STRING IN (   -- keeps only the TOP‑3 found above
        SELECT t."assignee_name"
        FROM (
              SELECT a2.value::VARIANT:"name"::STRING AS "assignee_name",
                     COUNT(DISTINCT p2."application_number") AS cnt
              FROM PATENTS.PATENTS.PUBLICATIONS p2,
                   LATERAL FLATTEN(input => p2."cpc") c2,
                   LATERAL FLATTEN(input => p2."assignee_harmonized") a2
              WHERE c2.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
              GROUP BY a2.value::VARIANT:"name"::STRING
              ORDER BY cnt DESC
              LIMIT 3
             ) t )
GROUP BY "assignee_name", "year"
ORDER BY "assignee_name", "applications_in_year" DESC
LIMIT 20;
```

```sql
--Description: Pick, for each TOP‑3 assignee, the single year with the most applications.  
SELECT *
FROM (
      SELECT a.value::VARIANT:"name"::STRING                AS "assignee_name",
             (p."filing_date"/10000)::INT                  AS "year",
             COUNT(DISTINCT p."application_number")        AS "applications_in_year",
             ROW_NUMBER() OVER (PARTITION BY a.value::VARIANT:"name"::STRING
                                 ORDER BY COUNT(DISTINCT p."application_number") DESC) AS rn
      FROM PATENTS.PATENTS.PUBLICATIONS  p,
           LATERAL FLATTEN(input => p."cpc")            c,
           LATERAL FLATTEN(input => p."assignee_harmonized") a
      WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
        AND a.value::VARIANT:"name"::STRING IN (   -- only TOP‑3 assignees
              SELECT t."assignee_name"
              FROM (
                    SELECT a2.value::VARIANT:"name"::STRING AS "assignee_name",
                           COUNT(DISTINCT p2."application_number") AS cnt
                    FROM PATENTS.PATENTS.PUBLICATIONS p2,
                         LATERAL FLATTEN(input => p2."cpc") c2,
                         LATERAL FLATTEN(input => p2."assignee_harmonized") a2
                    WHERE c2.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
                    GROUP BY a2.value::VARIANT:"name"::STRING
                    ORDER BY cnt DESC
                    LIMIT 3
                   ) t )
      GROUP BY "assignee_name","year"
     ) x
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Within those peak years, count applications by country code for every TOP‑3 assignee.  
SELECT a.value::VARIANT:"name"::STRING      AS "assignee_name",
       (p."filing_date"/10000)::INT        AS "year",
       a.value::VARIANT:"country_code"::STRING AS "country_code",
       COUNT(DISTINCT p."application_number") AS "apps"
FROM PATENTS.PATENTS.PUBLICATIONS  p,
     LATERAL FLATTEN(input => p."cpc")            c,
     LATERAL FLATTEN(input => p."assignee_harmonized") a
WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
  AND (p."filing_date"/10000)::INT IN (   -- the peak years discovered above
        SELECT "year"
        FROM (
              /* same sub‑query structure as previous step */
              SELECT a3.value::VARIANT:"name"::STRING AS "assignee_name",
                     (p3."filing_date"/10000)::INT   AS "year",
                     COUNT(DISTINCT p3."application_number") AS cnt,
                     ROW_NUMBER() OVER (PARTITION BY a3.value::VARIANT:"name"::STRING
                                         ORDER BY COUNT(DISTINCT p3."application_number") DESC) AS rn
              FROM PATENTS.PATENTS.PUBLICATIONS p3,
                   LATERAL FLATTEN(input => p3."cpc") c3,
                   LATERAL FLATTEN(input => p3."assignee_harmonized") a3
              WHERE c3.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
              GROUP BY a3.value::VARIANT:"name"::STRING,(p3."filing_date"/10000)::INT
             ) z
        WHERE rn = 1 )
GROUP BY "assignee_name","year","country_code"
ORDER BY "apps" DESC
LIMIT 20;
```

```sql
--Description: Choose, per assignee‑year combination above, the country code with the most applications.  
SELECT *
FROM (
      SELECT "assignee_name",
             "year",
             "country_code",
             "apps",
             ROW_NUMBER() OVER (PARTITION BY "assignee_name","year"
                                ORDER BY "apps" DESC) AS rn
      FROM (
            /* re‑using the query that counts apps by country code in peak year */
            SELECT a.value::VARIANT:"name"::STRING      AS "assignee_name",
                   (p."filing_date"/10000)::INT        AS "year",
                   a.value::VARIANT:"country_code"::STRING AS "country_code",
                   COUNT(DISTINCT p."application_number") AS "apps"
            FROM PATENTS.PATENTS.PUBLICATIONS  p,
                 LATERAL FLATTEN(input => p."cpc")            c,
                 LATERAL FLATTEN(input => p."assignee_harmonized") a
            WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
            GROUP BY "assignee_name","year","country_code"
           ) q
     ) r
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Final one‑shot query to assemble: assignee, total apps, peak year, apps in peak year, and top country code in that year (TOP‑3 assignees only).  
SELECT final."assignee_name",
       final."total_applications",
       final."top_year",
       final."applications_in_top_year",
       final."top_country_code"
FROM (
      /* build the pieces inside CTE‑style sub‑queries */
      WITH top3 AS (
           SELECT a.value::VARIANT:"name"::STRING AS "assignee_name",
                  COUNT(DISTINCT p."application_number") AS "total_applications"
           FROM PATENTS.PATENTS.PUBLICATIONS p,
                LATERAL FLATTEN(input => p."cpc") c,
                LATERAL FLATTEN(input => p."assignee_harmonized") a
           WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
           GROUP BY a.value::VARIANT:"name"::STRING
           ORDER BY "total_applications" DESC
           LIMIT 3
      ),
      peak_year AS (
           SELECT a.value::VARIANT:"name"::STRING AS "assignee_name",
                  (p."filing_date"/10000)::INT   AS "year",
                  COUNT(DISTINCT p."application_number") AS "apps_in_year",
                  ROW_NUMBER() OVER (PARTITION BY a.value::VARIANT:"name"::STRING
                                     ORDER BY COUNT(DISTINCT p."application_number") DESC) AS rn
           FROM PATENTS.PATENTS.PUBLICATIONS p,
                LATERAL FLATTEN(input => p."cpc") c,
                LATERAL FLATTEN(input => p."assignee_harmonized") a
           WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
             AND a.value::VARIANT:"name"::STRING IN (SELECT "assignee_name" FROM top3)
           GROUP BY a.value::VARIANT:"name"::STRING,(p."filing_date"/10000)::INT
      ),
      peak_country AS (
           SELECT a.value::VARIANT:"name"::STRING      AS "assignee_name",
                  (p."filing_date"/10000)::INT        AS "year",
                  a.value::VARIANT:"country_code"::STRING AS "country_code",
                  COUNT(DISTINCT p."application_number") AS "apps",
                  ROW_NUMBER() OVER (PARTITION BY a.value::VARIANT:"name"::STRING,
                                                      (p."filing_date"/10000)::INT
                                     ORDER BY COUNT(DISTINCT p."application_number") DESC) AS rn
           FROM PATENTS.PATENTS.PUBLICATIONS p,
                LATERAL FLATTEN(input => p."cpc") c,
                LATERAL FLATTEN(input => p."assignee_harmonized") a
           WHERE c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
             AND a.value::VARIANT:"name"::STRING IN (SELECT "assignee_name" FROM top3)
           GROUP BY a.value::VARIANT:"name"::STRING,(p."filing_date"/10000)::INT,
                    a.value::VARIANT:"country_code"::STRING
      )
      SELECT t3."assignee_name",
             t3."total_applications",
             py."year"                         AS "top_year",
             py."apps_in_year"                 AS "applications_in_top_year",
             pc."country_code"                 AS "top_country_code"
      FROM top3 t3
      JOIN peak_year    py ON py."assignee_name" = t3."assignee_name" AND py.rn = 1
      JOIN peak_country pc ON pc."assignee_name" = t3."assignee_name"
                          AND pc."year" = py."year"
                          AND pc.rn = 1
     ) final
LIMIT 20;
```
