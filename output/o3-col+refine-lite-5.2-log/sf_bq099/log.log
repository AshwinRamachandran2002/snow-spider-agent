```sql
--Description: 
-- Return, for each (assignee, filing‑year) that involves at least one patent application whose
-- CPC symbol starts with “A01B3”, the single country_code that accounts for the highest number of
-- distinct applications.  Steps implemented inside the same statement:
--   1) apps_by_country CTE: aggregate PATENTS.PATENTS.PUBLICATIONS by assignee_name, filing year
--      (derived from YYYYMMDD filing_date /10000), and assignee country_code, counting distinct
--      application_number values.  Only rows whose CPC list contains a code beginning “A01B3%” are
--      considered (checked by flattening the cpc array and filtering with ILIKE).
--   2) In the outer SELECT, rank rows by apps within each assignee_name‑year partition
--      (ROW_NUMBER ordered by desc apps).  Keep only rank 1, i.e., the country with the most apps.
--   3) Show the columns plus the app count; limit output to 20 rows for inspection.
WITH apps_by_country AS (
    SELECT  a.value::VARIANT:"name"::STRING          AS assignee_name,
            (p."filing_date"/10000)::INT            AS year,
            a.value::VARIANT:"country_code"::STRING AS country_code,
            COUNT(DISTINCT p."application_number")  AS apps
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."cpc")            c,
            LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE   c.value::VARIANT:"code"::STRING ILIKE 'A01B3%'
    GROUP BY
            a.value::VARIANT:"name"::STRING,
            (p."filing_date"/10000)::INT,
            a.value::VARIANT:"country_code"::STRING
)
SELECT  assignee_name,
        year,
        country_code,
        apps
FROM (
        SELECT  assignee_name,
                year,
                country_code,
                apps,
                ROW_NUMBER() OVER (PARTITION BY assignee_name, year
                                   ORDER BY apps DESC) AS rn
        FROM    apps_by_country
     ) ranked
WHERE rn = 1
LIMIT 20;
```
