```sql
-- Description: Look at customers’ first two musical preferences
SELECT DISTINCT 
       mp."CustomerID",
       mp."PreferenceSeq",
       mp."StyleID"
FROM   "Musical_Preferences" AS mp
WHERE  mp."PreferenceSeq" IN (1,2)
ORDER  BY mp."CustomerID", mp."PreferenceSeq"
LIMIT 20;
```

```sql
-- Description: Count how many style preferences each customer has (we only want those with ≤ 3)
SELECT DISTINCT 
       mp."CustomerID",
       COUNT(*) AS "PrefCount"
FROM   "Musical_Preferences" AS mp
GROUP  BY mp."CustomerID"
HAVING COUNT(*) <= 3
LIMIT 20;
```

```sql
-- Description: List customers that have BOTH a 1st and 2nd preference and no more than 3 total
SELECT DISTINCT
       mp."CustomerID",
       MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) AS "Pref1",
       MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) AS "Pref2"
FROM   "Musical_Preferences" AS mp
GROUP  BY mp."CustomerID"
HAVING COUNT(*) <= 3
       AND MAX(CASE WHEN mp."PreferenceSeq" = 1 THEN mp."StyleID" END) IS NOT NULL
       AND MAX(CASE WHEN mp."PreferenceSeq" = 2 THEN mp."StyleID" END) IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Examine entertainer style strengths (showing the strength rank and style id)
SELECT DISTINCT
       es."EntertainerID",
       es."StyleStrength",
       es."StyleID"
FROM   "Entertainer_Styles" AS es
ORDER  BY es."EntertainerID", es."StyleStrength"
LIMIT 20;
```

```sql
-- Description: Count styles for each entertainer (we later need those with ≤ 3)
SELECT DISTINCT
       es."EntertainerID",
       COUNT(*) AS "StyleCount"
FROM   "Entertainer_Styles" AS es
GROUP  BY es."EntertainerID"
HAVING COUNT(*) <= 3
LIMIT 20;
```

```sql
-- Description: List entertainers that have BOTH a 1st and 2nd strength and no more than 3 total
SELECT DISTINCT
       es."EntertainerID",
       MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) AS "Style1",
       MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) AS "Style2"
FROM   "Entertainer_Styles" AS es
GROUP  BY es."EntertainerID"
HAVING COUNT(*) <= 3
       AND MAX(CASE WHEN es."StyleStrength" = 1 THEN es."StyleID" END) IS NOT NULL
       AND MAX(CASE WHEN es."StyleStrength" = 2 THEN es."StyleID" END) IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Pair customers & entertainers when first two styles match in the SAME order
SELECT DISTINCT
       e."EntStageName",
       c."CustLastName"
FROM  (SELECT CustomerID,
              MAX(CASE WHEN PreferenceSeq = 1 THEN StyleID END) AS Pref1,
              MAX(CASE WHEN PreferenceSeq = 2 THEN StyleID END) AS Pref2
       FROM   "Musical_Preferences"
       GROUP  BY CustomerID
       HAVING COUNT(*) <= 3)  AS cu
JOIN  "Customers"      AS c  ON c."CustomerID" = cu."CustomerID"
JOIN (SELECT EntertainerID,
              MAX(CASE WHEN StyleStrength = 1 THEN StyleID END) AS Style1,
              MAX(CASE WHEN StyleStrength = 2 THEN StyleID END) AS Style2
       FROM   "Entertainer_Styles"
       GROUP  BY EntertainerID
       HAVING COUNT(*) <= 3)  AS en ON en."Style1" = cu."Pref1"
                                    AND en."Style2" = cu."Pref2"
JOIN  "Entertainers"   AS e  ON e."EntertainerID" = en."EntertainerID"
LIMIT 20;
```

```sql
-- Description: FINAL ANSWER – same‑order OR reverse‑order match between first two customer
--              preferences and first two entertainer strengths, limited to customers & entertainers
--              having no more than 3 total styles.  Only the stage‑name and customer last‑name
--              are returned.
SELECT DISTINCT
       e."EntStageName",
       c."CustLastName"
FROM  (SELECT CustomerID,
              MAX(CASE WHEN PreferenceSeq = 1 THEN StyleID END) AS Pref1,
              MAX(CASE WHEN PreferenceSeq = 2 THEN StyleID END) AS Pref2
       FROM   "Musical_Preferences"
       GROUP  BY CustomerID
       HAVING COUNT(*) <= 3
              AND Pref1 IS NOT NULL
              AND Pref2 IS NOT NULL)  AS cu
JOIN  "Customers"      AS c  ON c."CustomerID" = cu."CustomerID"
JOIN (SELECT EntertainerID,
              MAX(CASE WHEN StyleStrength = 1 THEN StyleID END) AS Style1,
              MAX(CASE WHEN StyleStrength = 2 THEN StyleID END) AS Style2
       FROM   "Entertainer_Styles"
       GROUP  BY EntertainerID
       HAVING COUNT(*) <= 3
              AND Style1 IS NOT NULL
              AND Style2 IS NOT NULL)  AS en
        ON (en."Style1" = cu."Pref1" AND en."Style2" = cu."Pref2")   -- same order
        OR (en."Style1" = cu."Pref2" AND en."Style2" = cu."Pref1")   -- reverse order
JOIN  "Entertainers"   AS e  ON e."EntertainerID" = en."EntertainerID"
LIMIT 20;
```
