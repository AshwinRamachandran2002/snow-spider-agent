--   2) driver_champs – from driver_standings at that last round, keep the row where
--                      position = 1 (world‑champion driver).
--   3) constructor_champs – from constructor_standings at that last round, keep the
--                      row where position = 1 (constructors’ champion).
--   4) Produce the final list joining to drivers_ext / constructors_ext for readable
--                      names, ordered by season.
WITH final_rounds AS (
    SELECT "year", MAX("round") AS max_round
    FROM   "races"
    GROUP  BY "year"
),
driver_champs AS (
    SELECT r."year",
           ds."driver_id",
           ds."points" AS driver_points
    FROM   final_rounds fr
    JOIN   "races"            r  ON r."year" = fr."year"
                                AND r."round" = fr."max_round"
    JOIN   "driver_standings" ds ON ds."race_id" = r."race_id"
    WHERE  ds."position" = 1                      -- champion driver
),
constructor_champs AS (
