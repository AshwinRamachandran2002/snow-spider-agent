```sql
--Description: 3) Determine the last (max) round number of each season  
SELECT r."year",
       MAX(r."round") AS "max_round"
FROM   "races" AS r
GROUP  BY r."year"
ORDER  BY r."year"
LIMIT 20;
```

```sql
--Description: 4) Pull driver‑standings rows that belong to the final round of each year  
WITH final_rounds AS (
      SELECT r."year", MAX(r."round") AS max_round
      FROM   "races" r
      GROUP  BY r."year"
)
SELECT r."year",
       d."full_name",
       ds."points"
FROM   "driver_standings" ds
JOIN   "races"            r  ON r."race_id"   = ds."race_id"
JOIN   final_rounds       fr ON fr."year"     = r."year"
                             AND fr."max_round" = r."round"
JOIN   "drivers_ext"      d  ON d."driver_id" = ds."driver_id"
ORDER  BY r."year", ds."points" DESC
LIMIT 20;
```

```sql
--Description: 5) For every season, find the driver who scored the most points  
WITH final_rounds AS (
      SELECT "year", MAX("round") AS max_round
      FROM   "races"
      GROUP  BY "year"
),
final_driver_pts AS (
      SELECT r."year",
             ds."driver_id",
             ds."points"
      FROM   "driver_standings" ds
      JOIN   "races"            r  ON r."race_id" = ds."race_id"
      JOIN   final_rounds       fr ON fr."year"   = r."year"
                                   AND fr."max_round" = r."round"
)
SELECT fdp."year",
       d."full_name",
       fdp."points"
FROM   (
         SELECT *,
                RANK() OVER (PARTITION BY "year" ORDER BY "points" DESC) AS rk
         FROM   final_driver_pts
       ) fdp
JOIN   "drivers_ext" d ON d."driver_id" = fdp."driver_id"
WHERE  fdp.rk = 1
ORDER  BY fdp."year"
LIMIT 20;
```

```sql
--Description: 6) Sample of constructor‑standings joined to race year & constructor name  
SELECT cs."race_id",
       r."year",
       c."name",
       cs."points",
       cs."position"
FROM   "constructor_standings" AS cs
JOIN   "races"                 AS r ON r."race_id"      = cs."race_id"
JOIN   "constructors_ext"      AS c ON c."constructor_id" = cs."constructor_id"
ORDER  BY r."year", cs."points" DESC
LIMIT 20;
```

```sql
--Description: 7) For every season, find the constructor who scored the most points  
WITH final_rounds AS (
      SELECT "year", MAX("round") AS max_round
      FROM   "races"
      GROUP  BY "year"
),
final_cons_pts AS (
      SELECT r."year",
             cs."constructor_id",
             cs."points"
      FROM   "constructor_standings" cs
      JOIN   "races"                 r  ON r."race_id" = cs."race_id"
      JOIN   final_rounds            fr ON fr."year"   = r."year"
                                        AND fr."max_round" = r."round"
)
SELECT fcp."year",
       c."name"          AS "constructor_name",
       fcp."points"
FROM   (
         SELECT *,
                RANK() OVER (PARTITION BY "year" ORDER BY "points" DESC) AS rk
         FROM   final_cons_pts
       ) fcp
JOIN   "constructors_ext" c ON c."constructor_id" = fcp."constructor_id"
WHERE  fcp.rk = 1
ORDER  BY fcp."year"
LIMIT 20;
```

```sql
--Description: 8) Combine the two champions (driver & constructor) for each season  
WITH final_rounds AS (
      SELECT "year", MAX("round") AS max_round
      FROM   "races"
      GROUP  BY "year"
),
final_driver_pts AS (
      SELECT r."year",
             ds."driver_id",
             ds."points"
      FROM   "driver_standings" ds
      JOIN   "races"            r  ON r."race_id" = ds."race_id"
      JOIN   final_rounds       fr ON fr."year"   = r."year"
                                   AND fr."max_round" = r."round"
),
driver_champs AS (
      SELECT "year", "driver_id", "points"
      FROM (
            SELECT *,
                   RANK() OVER (PARTITION BY "year" ORDER BY "points" DESC) AS rk
            FROM   final_driver_pts
          )
      WHERE rk = 1
),
final_cons_pts AS (
      SELECT r."year",
             cs."constructor_id",
             cs."points"
      FROM   "constructor_standings" cs
      JOIN   "races"                 r  ON r."race_id" = cs."race_id"
      JOIN   final_rounds            fr ON fr."year"   = r."year"
                                        AND fr."max_round" = r."round"
),
constructor_champs AS (
      SELECT "year", "constructor_id", "points"
      FROM (
            SELECT *,
                   RANK() OVER (PARTITION BY "year" ORDER BY "points" DESC) AS rk
            FROM   final_cons_pts
          )
      WHERE rk = 1
)
SELECT dcc."year",
       drv."full_name"              AS "top_driver",
       dcc."points"                 AS "driver_pts",
       cons."name"                  AS "top_constructor",
       ccc."points"                 AS "constructor_pts"
FROM   driver_champs       dcc
JOIN   constructor_champs  ccc ON ccc."year" = dcc."year"
JOIN   "drivers_ext"       drv ON drv."driver_id"      = dcc."driver_id"
JOIN   "constructors_ext"  cons ON cons."constructor_id" = ccc."constructor_id"
ORDER  BY dcc."year"
LIMIT 20;
```

```sql
--Description: 9) (Optional) Check seasons where the same constructor & driver double‑scored most points  
SELECT sub."year",
       sub."top_driver",
       sub."top_constructor"
FROM (
     /* reuse query 8 as a sub‑query */
     WITH final_rounds AS (
           SELECT "year", MAX("round") AS max_round
           FROM   "races"
           GROUP  BY "year"
     ),
     final_driver_pts AS (
           SELECT r."year",
                  ds."driver_id",
                  ds."points"
           FROM   "driver_standings" ds
           JOIN   "races"            r  ON r."race_id" = ds."race_id"
           JOIN   final_rounds       fr ON fr."year"   = r."year"
                                        AND fr."max_round" = r."round"
     ),
     driver_champs AS (
           SELECT "year", "driver_id", "points"
           FROM (
                 SELECT *,
                        RANK() OVER (PARTITION BY "year" ORDER BY "points" DESC) AS rk
                 FROM   final_driver_pts
               )
           WHERE rk = 1
     ),
     final_cons_pts AS (
           SELECT r."year",
                  cs."constructor_id",
                  cs."points"
           FROM   "constructor_standings" cs
           JOIN   "races"                 r  ON r."race_id" = cs."race_id"
           JOIN   final_rounds            fr ON fr."year"   = r."year"
                                             AND fr."max_round" = r."round"
     ),
     constructor_champs AS (
           SELECT "year", "constructor_id", "points"
           FROM (
                 SELECT *,
                        RANK() OVER (PARTITION BY "year" ORDER BY "points" DESC) AS rk
                 FROM   final_cons_pts
               )
           WHERE rk = 1
     )
     SELECT dcc."year",
            drv."full_name" AS "top_driver",
            cons."name"     AS "top_constructor"
     FROM   driver_champs      dcc
     JOIN   constructor_champs ccc  ON ccc."year" = dcc."year"
     JOIN   "drivers_ext"      drv  ON drv."driver_id"      = dcc."driver_id"
     JOIN   "constructors_ext" cons ON cons."constructor_id" = ccc."constructor_id"
) sub
WHERE sub."top_driver" LIKE sub."top_constructor"  -- simplistic equality check
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – list for every season the driver (full name) and constructor with the most points  
WITH final_rounds AS (
      SELECT "year", MAX("round") AS max_round
      FROM   "races"
      GROUP  BY "year"
),
-- driver side
final_driver_pts AS (
      SELECT r."year",
             ds."driver_id",
             ds."points"
      FROM   "driver_standings" ds
      JOIN   "races"            r  ON r."race_id" = ds."race_id"
      JOIN   final_rounds       fr ON fr."year"   = r."year"
                                   AND fr."max_round" = r."round"
),
driver_champs AS (
      SELECT "year", "driver_id", "points"
      FROM (
            SELECT *,
                   RANK() OVER (PARTITION BY "year" ORDER BY "points" DESC) AS rk
            FROM   final_driver_pts
          )
      WHERE rk = 1
),
-- constructor side
final_cons_pts AS (
      SELECT r."year",
             cs."constructor_id",
             cs."points"
      FROM   "constructor_standings" cs
      JOIN   "races"                 r  ON r."race_id" = cs."race_id"
      JOIN   final_rounds            fr ON fr."year"   = r."year"
                                        AND fr."max_round" = r."round"
),
constructor_champs AS (
      SELECT "year", "constructor_id", "points"
      FROM (
            SELECT *,
                   RANK() OVER (PARTITION BY "year" ORDER BY "points" DESC) AS rk
            FROM   final_cons_pts
          )
      WHERE rk = 1
)
SELECT dcc."year",
       drv."full_name"              AS "top_driver",
       dcc."points"                 AS "driver_points",
       cons."name"                  AS "top_constructor",
       ccc."points"                 AS "constructor_points"
FROM   driver_champs       dcc
JOIN   constructor_champs  ccc ON ccc."year" = dcc."year"
JOIN   "drivers_ext"       drv ON drv."driver_id"      = dcc."driver_id"
JOIN   "constructors_ext"  cons ON cons."constructor_id" = ccc."constructor_id"
ORDER  BY dcc."year"
LIMIT 20;
```
