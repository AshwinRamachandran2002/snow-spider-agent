--Description:
-- FINAL ANSWER – for every season, return the World‑Champion driver (full name) and
-- the Constructors’ Champion, together with their final‑season point totals.
-- Strategy (all inside one WITH clause structure):
--   1) final_rounds        – last round for each season.
--   2) driver_champs       – at that round, driver_standings.position = 1.
--   3) constructor_champs  – at that round, constructor_standings.position = 1.
--   4) Join to drivers_ext / constructors_ext for readable names and list the results.
WITH final_rounds AS (
     SELECT "year", MAX("round") AS max_round
     FROM   "races"
     GROUP  BY "year"
),
driver_champs AS (
     SELECT r."year",
            ds."driver_id",
            ds."points" AS driver_points
     FROM   final_rounds fr
     JOIN   "races"            r  ON r."year" = fr."year"
                                 AND r."round" = fr."max_round"
     JOIN   "driver_standings" ds ON ds."race_id" = r."race_id"
     WHERE  ds."position" = 1          -- champion driver at season end
),
constructor_champs AS (
     SELECT r."year",
            cs."constructor_id",
            cs."points" AS constructor_points
     FROM   final_rounds fr
     JOIN   "races"                 r  ON r."year" = fr."year"
                                      AND r."round" = fr."max_round"
