```sql
--Description / Thinking process:
-- Goal: find the year whose first day *after January* with >10 sightings
--       of Sterna paradisaea north of 40 °N is the earliest among all years.
-- Steps inside a single query:
--   1. CTE rich_days
--        • Filter to the species, latitude >40, month >1.
--        • Aggregate by calendar DATE; keep only dates with COUNT(*) >10.
--        • Also keep the year (yr) for later grouping.
--   2. CTE first_day_per_year
--        • For every yr, take MIN(obs_date) from rich_days — the first
--          “rich” (>10) observation day in that year.
--   3. Final SELECT
--        • Order those first_rich_day values and take LIMIT 1 to obtain
--          the year that achieved this threshold the earliest on the calendar.

WITH rich_days AS (
  SELECT
    DATE(eventdate)               AS obs_date,
    EXTRACT(YEAR FROM eventdate)  AS yr
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(species) = 'sterna paradisaea'  -- target species
    AND decimallatitude > 40                 -- north of 40 °N
    AND month > 1                            -- after January
  GROUP BY obs_date, yr
  HAVING COUNT(*) > 10                       -- more than 10 sightings that day
),
first_day_per_year AS (
  SELECT
    yr,
    MIN(obs_date) AS first_rich_day          -- earliest rich day in the year
  FROM rich_days
  GROUP BY yr
)
SELECT
  yr  AS year_with_earliest_rich_day,
  first_rich_day
FROM first_day_per_year
ORDER BY first_rich_day
LIMIT 1;
```
