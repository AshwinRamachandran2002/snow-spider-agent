```sql
--Description: 8) (Optional exploration) Show the daily count curve for the winning year to make sure it makes sense.
WITH filtered AS (
  SELECT
    DATE(`eventdate`)             AS obs_date,
    EXTRACT(YEAR FROM `eventdate`) AS yr
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(`species`) = 'sterna paradisaea'
    AND `decimallatitude` > 40
    AND `month` > 1
),
winner AS (
  SELECT
    (SELECT yr
     FROM (
       SELECT yr, MIN(obs_date) AS fd
       FROM filtered
       GROUP BY yr
       HAVING COUNTIF(obs_date) > 10
     ) ORDER BY fd LIMIT 1) AS win_year
)
SELECT
  f.obs_date,
  COUNT(*) AS cnt
FROM filtered AS f, winner AS w
WHERE f.yr = w.win_year
GROUP BY f.obs_date
ORDER BY f.obs_date
LIMIT 20;
```

```sql
--Description: 9) Display distinct `issue` flags for the winner‑year’s early‑season records (>10) to inspect data quality.
WITH rich_days AS (
  SELECT
    DATE(`eventdate`) AS obs_date,
    EXTRACT(YEAR  FROM `eventdate`) AS yr
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(`species`) = 'sterna paradisaea'
    AND `decimallatitude` > 40
    AND `month` > 1
  GROUP BY obs_date
  HAVING COUNT(*) > 10
),
winner_year AS (
  SELECT yr
  FROM rich_days
  GROUP BY yr
  HAVING MIN(obs_date) = (SELECT MIN(obs_date) FROM rich_days)
  LIMIT 1
)
SELECT DISTINCT
  JSON_EXTRACT_SCALAR(i, '$.array_element') AS issue_tag
FROM `bigquery-public-data.gbif.occurrences`, winner_year
CROSS JOIN UNNEST(`issue`.array) AS i
WHERE LOWER(`species`) = 'sterna paradisaea'
  AND `decimallatitude` > 40
  AND `month` > 1
  AND EXTRACT(YEAR FROM `eventdate`) = winner_year.yr
LIMIT 20;
```

