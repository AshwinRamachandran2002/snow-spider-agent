ORDER BY obs_cnt DESC, obs_date
LIMIT 20;
```

```sql
--Description: 5) Keep only the calendar days on which the number of sightings exceeded 10.
SELECT
  DATE(`eventdate`) AS obs_date,
  COUNT(*)          AS obs_cnt
FROM `bigquery-public-data.gbif.occurrences`
WHERE LOWER(`species`) = 'sterna paradisaea'
  AND `decimallatitude` > 40
  AND `month` > 1
GROUP BY obs_date
HAVING obs_cnt > 10
ORDER BY obs_date
LIMIT 20;
```

```sql
--Description: 6) For every individual year, find the very first day (after January) that has >10 sightings.
WITH rich_days AS (
  SELECT
    DATE(`eventdate`) AS obs_date,
    EXTRACT(YEAR FROM `eventdate`) AS yr
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(`species`) = 'sterna paradisaea'
    AND `decimallatitude` > 40
    AND `month` > 1
  GROUP BY obs_date
  HAVING COUNT(*) > 10
)
SELECT
  yr,
  MIN(obs_date) AS first_rich_day
FROM rich_days
GROUP BY yr
ORDER BY first_rich_day
LIMIT 20;
```

```sql
--Description: 7) Identify the year whose “first_rich_day” is the earliest among all years.
WITH rich_days AS (
  SELECT
    DATE(`eventdate`) AS obs_date,
    EXTRACT(YEAR FROM `eventdate`) AS yr
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(`species`) = 'sterna paradisaea'
    AND `decimallatitude` > 40
    AND `month` > 1
  GROUP BY obs_date
  HAVING COUNT(*) > 10
),
first_day_per_year AS (
  SELECT
    yr,
    MIN(obs_date) AS first_rich_day
  FROM rich_days
  GROUP BY yr
)
SELECT
  yr  AS year_with_earliest_rich_day,
  first_rich_day
FROM first_day_per_year
ORDER BY first_rich_day
LIMIT 1;
