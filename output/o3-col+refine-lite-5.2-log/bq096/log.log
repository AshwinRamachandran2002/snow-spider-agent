--Description: 10) Retrieve every occurrence row that belongs to the earliest
--               “rich” (>10‑sighting) day of the winner‑year.  The query
--               mirrors the logic used earlier, adds the missing month > 1
--               filter on the final SELECT, and keeps types aligned by
--               comparing DATE(eventdate) with the DATE stored in target_day.

WITH rich_days AS (                     -- 1) every >10‑sighting day
  SELECT
    DATE(eventdate)               AS obs_date,
    EXTRACT(YEAR FROM eventdate)  AS yr
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(species) = 'sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1
  GROUP BY obs_date, yr
  HAVING COUNT(*) > 10
),
target_day AS (                         -- 2) the single earliest such day
  SELECT
    yr,
    MIN(obs_date) AS first_rich_day
  FROM rich_days
  GROUP BY yr
  ORDER BY first_rich_day
  LIMIT 1
)
SELECT *
FROM `bigquery-public-data.gbif.occurrences` AS o
JOIN target_day t
  ON DATE(o.eventdate) = t.first_rich_day
WHERE LOWER(o.species) = 'sterna paradisaea'
  AND o.decimallatitude > 40
  AND o.month > 1
LIMIT 20;
