```sql
--Description / Thinking process:
-- We need the distinct GBIF “issue” flags for all records of the Arctic Tern
-- (Sterna paradisaea) that belong to the “winner‑year” — the year whose
-- first post‑January day (north of 40 °N) with >10 sightings is earliest
-- among all years in the database.
--
-- Steps wrapped in one query:
-- 1. rich_days:
--      • Filter occurrences to our species, latitude > 40, month > 1.
--      • Group by calendar DATE & YEAR; keep only days with COUNT(*) > 10.
-- 2. winner_year:
--      • For each year find its earliest rich day; sort and pick the
--        year whose earliest date is the absolute earliest overall.
-- 3. Final SELECT:
--      • From all occurrences, restrict to winner_year and the same filters.
--      • UNNEST the issue.array (ARRAY<STRUCT<array_element STRING>>).
--      • Return DISTINCT issue tags (i.array_element).

WITH rich_days AS (
  SELECT
    DATE(eventdate)               AS obs_date,
    EXTRACT(YEAR FROM eventdate)  AS yr
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(species) = 'sterna paradisaea'
    AND decimallatitude > 40        -- north of 40 °N
    AND month > 1                   -- after January
  GROUP BY obs_date, yr
  HAVING COUNT(*) > 10              -- rich day (>10 sightings)
),
winner_year AS (
  SELECT yr
  FROM (
    SELECT yr, MIN(obs_date) AS first_rich_day
    FROM rich_days
    GROUP BY yr
  )
  ORDER BY first_rich_day           -- earliest rich day wins
  LIMIT 1
)
SELECT DISTINCT
  i.array_element AS issue_tag       -- direct field access, no JSON fn needed
FROM `bigquery-public-data.gbif.occurrences` AS o
JOIN winner_year
  ON EXTRACT(YEAR FROM o.eventdate) = winner_year.yr
CROSS JOIN UNNEST(o.issue.array) AS i
WHERE LOWER(o.species) = 'sterna paradisaea'
  AND o.decimallatitude > 40
  AND o.month > 1;
```
