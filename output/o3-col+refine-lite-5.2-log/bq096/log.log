```sql
--Description: 8) Plot the daily count curve (north of 40 °N, after Jan) for the winning year.
WITH rich_days AS (                   -- build rich‑day list first
  SELECT
    DATE(eventdate)              AS obs_date,
    EXTRACT(YEAR FROM eventdate) AS yr
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(species) = 'sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1
  GROUP BY obs_date, yr
  HAVING COUNT(*) > 10
),
winner_year AS (                      -- year whose 1st rich day is earliest
  SELECT yr
  FROM (
    SELECT yr, MIN(obs_date) AS first_rich_day
    FROM rich_days
    GROUP BY yr
  )
  ORDER BY first_rich_day
  LIMIT 1
),
daily_counts AS (                     -- counts per day for that year
  SELECT
    DATE(eventdate)              AS obs_date,
    COUNT(*)                     AS cnt
  FROM `bigquery-public-data.gbif.occurrences`, winner_year
  WHERE LOWER(species) = 'sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1
    AND EXTRACT(YEAR FROM eventdate) = winner_year.yr
  GROUP BY obs_date
)
SELECT *
FROM daily_counts
ORDER BY obs_date
LIMIT 20;
```

```sql
--Description: 9) List distinct GBIF “issue” flags for records in the winner‑year’s early‑season (>10) rich‑day window.
WITH rich_days AS (                   -- identify rich days
  SELECT
    DATE(eventdate)              AS obs_date,
    EXTRACT(YEAR FROM eventdate) AS yr
  FROM `bigquery-public-data.gbif.occurrences`
  WHERE LOWER(species) = 'sterna paradisaea'
    AND decimallatitude > 40
    AND month > 1
  GROUP BY obs_date, yr
  HAVING COUNT(*) > 10
),
winner_year AS (                      -- pick the winning year
  SELECT yr
  FROM (
    SELECT yr, MIN(obs_date) AS first_rich_day
    FROM rich_days
    GROUP BY yr
  )
  ORDER BY first_rich_day
  LIMIT 1
)
SELECT DISTINCT
  JSON_EXTRACT_SCALAR(i, '$.array_element') AS issue_tag
FROM `bigquery-public-data.gbif.occurrences`  AS o
JOIN winner_year                              ON EXTRACT(YEAR FROM o.eventdate) = winner_year.yr
CROSS JOIN UNNEST(o.issue.array) AS i
WHERE LOWER(o.species) = 'sterna paradisaea'
  AND o.decimallatitude > 40
  AND o.month > 1;
