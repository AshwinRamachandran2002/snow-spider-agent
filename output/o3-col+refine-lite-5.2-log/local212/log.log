```sql
--Description: 1) Look at the universe of drivers that appear in the deliveries table.
SELECT DISTINCT "driver_id"
FROM "deliveries"
LIMIT 20;
```

```sql
--Description: 2) Inspect a few deliveries together with the driver who performed them.
SELECT "delivery_id",
       "driver_id",
       "delivery_status"
FROM   "deliveries"
LIMIT 20;
```

```sql
--Description: 3) Join deliveries to orders to reach the delivery‑timestamp that lives in the orders table.
SELECT d."driver_id",
       d."delivery_order_id",
       o."order_moment_delivered"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON d."delivery_order_id" = o."order_id"
LIMIT 20;
```

```sql
--Description: 4) Extract only the date part (everything before the first blank) of the delivered‑timestamp.  
--              This gives one row per delivery with its calendar day.
SELECT d."driver_id",
       substr(o."order_moment_delivered", 1, instr(o."order_moment_delivered", ' ') - 1) AS "delivery_date"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON d."delivery_order_id" = o."order_id"
WHERE  o."order_moment_delivered" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 5) Count how many deliveries each driver completed on each calendar day.
SELECT d."driver_id",
       substr(o."order_moment_delivered", 1, instr(o."order_moment_delivered", ' ') - 1) AS "delivery_date",
       COUNT(*) AS "daily_deliveries"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON d."delivery_order_id" = o."order_id"
WHERE  o."order_moment_delivered" IS NOT NULL
GROUP  BY d."driver_id",
          "delivery_date"
LIMIT 20;
```

```sql
--Description: 6) Take the previous daily counts and compute each driver’s average deliveries per day.
SELECT sub."driver_id",
       AVG(sub."daily_deliveries") AS "avg_daily_deliveries"
FROM  (
        SELECT d."driver_id",
               substr(o."order_moment_delivered", 1, instr(o."order_moment_delivered", ' ') - 1) AS "delivery_date",
               COUNT(*) AS "daily_deliveries"
        FROM   "deliveries" AS d
        JOIN   "orders"     AS o
               ON d."delivery_order_id" = o."order_id"
        WHERE  o."order_moment_delivered" IS NOT NULL
        GROUP  BY d."driver_id",
                  "delivery_date"
      ) AS sub
GROUP BY sub."driver_id"
LIMIT 20;
```

```sql
--Description: 7) Retrieve the five drivers with the highest average number of daily deliveries.
SELECT sub."driver_id",
       AVG(sub."daily_deliveries") AS "avg_daily_deliveries"
FROM  (
        SELECT d."driver_id",
               substr(o."order_moment_delivered", 1, instr(o."order_moment_delivered", ' ') - 1) AS "delivery_date",
               COUNT(*) AS "daily_deliveries"
        FROM   "deliveries" AS d
        JOIN   "orders"     AS o
               ON d."delivery_order_id" = o."order_id"
        WHERE  o."order_moment_delivered" IS NOT NULL
        GROUP  BY d."driver_id",
                  "delivery_date"
      ) AS sub
GROUP BY sub."driver_id"
ORDER BY "avg_daily_deliveries" DESC
LIMIT 5;
```
