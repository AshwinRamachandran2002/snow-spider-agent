```sql
--Description: “Sanity‑check” query rewritten to avoid tuple‑comparison incompatibility and
--DISTINCT/ORDER‑BY issues.  It shows each top package’s cleaned GitHub URL alongside its total
--download count (first 20 rows, highest‑to‑lowest downloads).

WITH last_upload AS (                                   -- newest upload_time per package
    SELECT  "name",
            MAX("upload_time") AS "latest_upload_time"
    FROM    "PYPI"."PYPI"."DISTRIBUTION_METADATA"
    GROUP BY "name"
),
latest_meta AS (                                        -- explode project_urls & clean GitHub links
    SELECT  d."name",
            REGEXP_REPLACE(
                LOWER(f.value::STRING),
                '/(issues|pull|blob|tree).*',
                ''
            ) AS "github_url"
    FROM    "PYPI"."PYPI"."DISTRIBUTION_METADATA" d
    JOIN    last_upload lu
           ON d."name" = lu."name"
          AND d."upload_time" = lu."latest_upload_time"
    ,      LATERAL FLATTEN(input => d."project_urls") f
    WHERE   f.value::STRING ILIKE '%github%'
),
downloads AS (                                          -- total download counts per project
    SELECT  "project" AS "name",
            COUNT(*)  AS "download_cnt"
    FROM    "PYPI"."PYPI"."FILE_DOWNLOADS"
    GROUP BY "project"
)
SELECT  lm."github_url",
        d."download_cnt"
FROM    latest_meta lm
JOIN    downloads  d
      ON lm."name" = d."name"
WHERE   lm."github_url" IS NOT NULL
ORDER BY d."download_cnt" DESC          -- highest download counts first
LIMIT 20;
```
