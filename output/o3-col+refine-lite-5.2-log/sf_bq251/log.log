--Description: Derive the cleaned GitHub repository URLs for the three most‑downloaded PyPI packages.
--Steps (thought process):
-- 1. latest_meta: pick the newest metadata row per package, explode project_urls, keep only GitHub links,
--    and strip off “issues”, “pull”, “blob”, “tree”, etc. to obtain the root repository URL.
-- 2. downloads: count every FILE_DOWNLOADS row to get total download frequency per package.
-- 3. Join the two CTEs on package name, rank by download count, and return the top‑3 URLs.
WITH latest_meta AS (
    SELECT  d."name",
            REGEXP_REPLACE(
                LOWER(f.value::STRING),
                '/(issues|pull|blob|tree).*',
                ''
            ) AS "github_url"
    FROM    "PYPI"."PYPI"."DISTRIBUTION_METADATA" d,
            LATERAL FLATTEN(input => d."project_urls") f
    WHERE   f.value::STRING ILIKE '%github%'
      AND   (d."name", d."upload_time") IN (
               SELECT "name", MAX("upload_time")
               FROM   "PYPI"."PYPI"."DISTRIBUTION_METADATA"
               GROUP BY "name"
             )
),
downloads AS (
    SELECT  "project" AS "name",
            COUNT(*)  AS "download_cnt"
    FROM    "PYPI"."PYPI"."FILE_DOWNLOADS"
    GROUP BY "project"
)
SELECT DISTINCT lm."github_url"
FROM   latest_meta lm
JOIN   downloads  d
  ON   lm."name" = d."name"
WHERE  lm."github_url" IS NOT NULL
QUALIFY ROW_NUMBER() OVER (ORDER BY d."download_cnt" DESC) <= 3;
