Query:
--Description: Combine latest‑version metadata (with cleaned GitHub URLs) and download counts  
WITH latest_meta AS (  
  SELECT d."name",  
         d."version",  
         REGEXP_REPLACE(LOWER(f.value::STRING),  
                        '/(issues|pull|blob|tree).*',  
                        '') AS "github_url"  
  FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA" d,  
       LATERAL FLATTEN(input => d."project_urls") f  
  WHERE f.value::STRING ILIKE '%github%'  
    AND (d."name", d."upload_time") IN (  
         SELECT "name", MAX("upload_time")  
         FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"  
         GROUP BY "name")  
),  
downloads AS (  
  SELECT "project" AS "name",  
         COUNT(*)  AS "download_cnt"  
  FROM "PYPI"."PYPI"."FILE_DOWNLOADS"  
  GROUP BY "project"  
)  
SELECT lm."github_url"  
FROM latest_meta lm  
JOIN downloads d  
  ON lm."name" = d."name"  
WHERE lm."github_url" IS NOT NULL  
ORDER BY d."download_cnt" DESC  
LIMIT 20;
