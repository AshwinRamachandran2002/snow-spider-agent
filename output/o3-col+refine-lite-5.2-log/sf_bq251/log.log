Query:
--Description: For every package, get the most‑recent upload_time row (latest version)  
WITH latest AS (  
  SELECT "name",  
         MAX("upload_time") AS "latest_upload_time"  
  FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"  
  GROUP BY "name"  
)  
SELECT d.*  
FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA" d  
JOIN latest l  
  ON d."name" = l."name"  
 AND d."upload_time" = l."latest_upload_time"  
LIMIT 20;
