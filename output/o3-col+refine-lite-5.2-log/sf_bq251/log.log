WHERE f.value::STRING ILIKE '%github%'  
LIMIT 20;
```

```sql
--Description: Clean GitHub URLs by stripping “issues”, “pull”, “blob”, “tree”, etc., keeping only repo root  
SELECT DISTINCT  
       REGEXP_REPLACE(LOWER(f.value::STRING),  
                      '/(issues|pull|blob|tree).*',  
                      '')       AS "clean_github_url"  
FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA" m,  
     LATERAL FLATTEN(input => m."project_urls") f  
WHERE f.value::STRING ILIKE '%github%'  
LIMIT 20;
```

```sql
--Description: For every package, get the most‑recent upload_time row (latest version)  
WITH latest AS (  
  SELECT "name",  
         MAX("upload_time") AS "latest_upload_time"  
  FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"  
  GROUP BY "name"  
)  
SELECT d.*  
FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA" d  
JOIN latest l  
  ON d."name" = l."name"  
 AND d."upload_time" = l."latest_upload_time"  
LIMIT 20;
```

```sql
--Description: Aggregate FILE_DOWNLOADS to get total download counts per project  
SELECT "project"                      AS "name",  
       COUNT(*)                       AS "download_cnt"  
FROM "PYPI"."PYPI"."FILE_DOWNLOADS"  
GROUP BY "project"  
ORDER BY "download_cnt" DESC  
LIMIT 20;
```

```sql
--Description: Combine latest‑version metadata (with cleaned GitHub URLs) and download counts  
WITH latest_meta AS (  
  SELECT d."name",  
         d."version",  
         REGEXP_REPLACE(LOWER(f.value::STRING),  
                        '/(issues|pull|blob|tree).*',  
                        '') AS "github_url"  
  FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA" d,  
       LATERAL FLATTEN(input => d."project_urls") f  
  WHERE f.value::STRING ILIKE '%github%'  
    AND (d."name", d."upload_time") IN (  
         SELECT "name", MAX("upload_time")  
         FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"  
         GROUP BY "name")  
),  
downloads AS (  
  SELECT "project" AS "name",  
         COUNT(*)  AS "download_cnt"  
  FROM "PYPI"."PYPI"."FILE_DOWNLOADS"  
  GROUP BY "project"  
)  
SELECT lm."github_url"  
FROM latest_meta lm  
JOIN downloads d  
  ON lm."name" = d."name"  
WHERE lm."github_url" IS NOT NULL  
ORDER BY d."download_cnt" DESC  
LIMIT 20;
```

```sql
--Description: Retrieve the cleaned GitHub repository URLs for the top‑3 most downloaded packages  
WITH latest_meta AS (  
  SELECT d."name",  
         REGEXP_REPLACE(LOWER(f.value::STRING),  
                        '/(issues|pull|blob|tree).*',  
                        '') AS "github_url"  
  FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA" d,  
       LATERAL FLATTEN(input => d."project_urls") f  
  WHERE f.value::STRING ILIKE '%github%'  
    AND (d."name", d."upload_time") IN (  
         SELECT "name", MAX("upload_time")  
         FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA"  
         GROUP BY "name")  
),  
downloads AS (  
  SELECT "project" AS "name",  
         COUNT(*)  AS "download_cnt"  
  FROM "PYPI"."PYPI"."FILE_DOWNLOADS"  
  GROUP BY "project"  
)  
SELECT DISTINCT lm."github_url"  
FROM latest_meta lm  
JOIN downloads d  
  ON lm."name" = d."name"  
ORDER BY d."download_cnt" DESC  
LIMIT 3;
```

