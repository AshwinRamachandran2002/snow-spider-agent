Query:
--Description: Clean GitHub URLs by stripping “issues”, “pull”, “blob”, “tree”, etc., keeping only repo root  
SELECT DISTINCT  
       REGEXP_REPLACE(LOWER(f.value::STRING),  
                      '/(issues|pull|blob|tree).*',  
                      '')       AS "clean_github_url"  
FROM "PYPI"."PYPI"."DISTRIBUTION_METADATA" m,  
     LATERAL FLATTEN(input => m."project_urls") f  
WHERE f.value::STRING ILIKE '%github%'  
LIMIT 20;
