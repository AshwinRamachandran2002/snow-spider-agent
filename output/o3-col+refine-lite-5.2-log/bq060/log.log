FROM `bigquery-public-data.census_bureau_international.country_names_area`
WHERE `country_area` > 500;
```

```sql
--Description: Combine 2017 migration data with area and keep only countries >500 km².
SELECT m.`country_code`,
       m.`country_name`,
       m.`net_migration`,
       a.`country_area`
FROM `bigquery-public-data.census_bureau_international.birth_death_growth_rates` AS m
JOIN `bigquery-public-data.census_bureau_international.country_names_area` AS a
  ON m.`country_code` = a.`country_code`
WHERE m.`year` = 2017
  AND a.`country_area` > 500
ORDER BY m.`net_migration` DESC
LIMIT 20;
```

```sql
--Description: Show the bottom of the list (most negative migration rates) for sanity‑check.
SELECT m.`country_code`,
       m.`country_name`,
       m.`net_migration`
FROM `bigquery-public-data.census_bureau_international.birth_death_growth_rates` AS m
JOIN `bigquery-public-data.census_bureau_international.country_names_area` AS a
  ON m.`country_code` = a.`country_code`
WHERE m.`year` = 2017
  AND a.`country_area` > 500
ORDER BY m.`net_migration` ASC
LIMIT 20;
```

```sql
--Description: Count how many qualifying countries have positive vs. negative migration in 2017.
SELECT
  SUM(CASE WHEN m.`net_migration` >= 0 THEN 1 ELSE 0 END) AS positive_or_zero,
  SUM(CASE WHEN m.`net_migration`  < 0 THEN 1 ELSE 0 END) AS negative
FROM `bigquery-public-data.census_bureau_international.birth_death_growth_rates` AS m
JOIN `bigquery-public-data.census_bureau_international.country_names_area` AS a
  ON m.`country_code` = a.`country_code`
WHERE m.`year` = 2017
  AND a.`country_area` > 500;
```

```sql
--Description: (Optional) Distinct top‑10 just to double‑check duplicates don’t exist.
SELECT DISTINCT m.`country_name`,
       m.`net_migration`
FROM `bigquery-public-data.census_bureau_international.birth_death_growth_rates` AS m
JOIN `bigquery-public-data.census_bureau_international.country_names_area` AS a
  ON m.`country_code` = a.`country_code`
WHERE m.`year` = 2017
  AND a.`country_area` > 500
ORDER BY m.`net_migration` DESC
LIMIT 10;
```

```sql
--Description: FINAL ANSWER – top 3 countries with the highest net migration in 2017, area > 500 km².
SELECT m.`country_name`,
       m.`net_migration` AS migration_rate_per_1000_pop
FROM `bigquery-public-data.census_bureau_international.birth_death_growth_rates` AS m
JOIN `bigquery-public-data.census_bureau_international.country_names_area`         AS a
  ON m.`country_code` = a.`country_code`
WHERE m.`year` = 2017
  AND a.`country_area` > 500
ORDER BY m.`net_migration` DESC
LIMIT 3;
```
