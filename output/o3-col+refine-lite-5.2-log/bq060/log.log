Query:
--Description: Count how many qualifying countries have positive vs. negative migration in 2017.
SELECT
  SUM(CASE WHEN m.`net_migration` >= 0 THEN 1 ELSE 0 END) AS positive_or_zero,
  SUM(CASE WHEN m.`net_migration`  < 0 THEN 1 ELSE 0 END) AS negative
FROM `bigquery-public-data.census_bureau_international.birth_death_growth_rates` AS m
JOIN `bigquery-public-data.census_bureau_international.country_names_area` AS a
  ON m.`country_code` = a.`country_code`
WHERE m.`year` = 2017
  AND a.`country_area` > 500;
Answer:
positive_or_zero,negative
