```sql
-- 1) Preview all rows whose “insert_date” falls in January‑2022
SELECT *
FROM cities
WHERE insert_date BETWEEN '2022-01-01' AND '2022-01-31'
LIMIT 20;
```

```sql
-- 2) Count how many different January‑2022 insert‑days each country has
SELECT country_code_2,
       COUNT(DISTINCT insert_date) AS jan22_days
FROM cities
WHERE insert_date BETWEEN '2022-01-01' AND '2022-01-31'
GROUP BY country_code_2
ORDER BY jan22_days DESC
LIMIT 20;
```

```sql
-- 3) Join to countries table – find the country that has exactly 9 different
--    January‑2022 insert‑days (there is only one such country)
SELECT cty.country_code_2,
       cnt.country_name,
       COUNT(DISTINCT cty.insert_date) AS jan22_days
FROM cities            AS cty
JOIN cities_countries  AS cnt
     ON LOWER(cnt.country_code_2)=LOWER(cty.country_code_2)
WHERE cty.insert_date BETWEEN '2022-01-01' AND '2022-01-31'
GROUP BY cty.country_code_2, cnt.country_name
HAVING jan22_days = 9;
```

```sql
-- 4) List those nine January‑2022 dates for the target country
SELECT DISTINCT c.insert_date
FROM cities AS c
JOIN ( SELECT country_code_2
       FROM cities
       WHERE insert_date BETWEEN '2022-01-01' AND '2022-01-31'
       GROUP BY country_code_2
       HAVING COUNT(DISTINCT insert_date)=9 ) AS t          -- the target country
  ON c.country_code_2 = t.country_code_2
WHERE c.insert_date BETWEEN '2022-01-01' AND '2022-01-31'
ORDER BY c.insert_date;
```

```sql
-- 5) Build the ordered list of those nine dates and tag consecutive‑day groups
WITH target_country AS (
     SELECT country_code_2
     FROM cities
     WHERE insert_date BETWEEN '2022-01-01' AND '2022-01-31'
     GROUP BY country_code_2
     HAVING COUNT(DISTINCT insert_date)=9
),
dates_list AS (
     SELECT DISTINCT insert_date
     FROM cities
     WHERE country_code_2 = (SELECT country_code_2 FROM target_country)
       AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
),
ordered AS (
     SELECT insert_date,
            ROW_NUMBER() OVER (ORDER BY insert_date)               AS rn,
            julianday(insert_date)                                 AS jd
     FROM dates_list
),
grps AS (  -- same (rn‑jd) ==> same consecutive block
     SELECT insert_date,
            rn - jd AS grp
     FROM ordered
)
SELECT grp,
       MIN(insert_date) AS start_date,
       MAX(insert_date) AS end_date,
       COUNT(*)         AS consec_days
FROM grps
GROUP BY grp
ORDER BY consec_days DESC
LIMIT 5;
```

```sql
-- 6) Isolate the single longest consecutive‑days block for January‑2022
WITH target_country AS (
     SELECT country_code_2
     FROM cities
     WHERE insert_date BETWEEN '2022-01-01' AND '2022-01-31'
     GROUP BY country_code_2
     HAVING COUNT(DISTINCT insert_date)=9
),
dates_list AS (
     SELECT DISTINCT insert_date
     FROM cities
     WHERE country_code_2 = (SELECT country_code_2 FROM target_country)
       AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
),
ordered AS (
     SELECT insert_date,
            ROW_NUMBER() OVER (ORDER BY insert_date)  AS rn,
            julianday(insert_date)                    AS jd
     FROM dates_list
),
grps AS (
     SELECT insert_date,
            rn - jd AS grp
     FROM ordered
),
seq_info AS (
     SELECT grp,
            MIN(insert_date) AS start_date,
            MAX(insert_date) AS end_date,
            COUNT(*)         AS consec_days
     FROM grps
     GROUP BY grp
     ORDER BY consec_days DESC
     LIMIT 1
)
SELECT *
FROM seq_info;   -- ← shows the required start_date, end_date and length
```

```sql
-- 7) Display every city row inside that longest consecutive period
WITH target_country AS (
     SELECT country_code_2
     FROM cities
     WHERE insert_date BETWEEN '2022-01-01' AND '2022-01-31'
     GROUP BY country_code_2
     HAVING COUNT(DISTINCT insert_date)=9
),
seq_info AS (      -- copy previous CTE for start/end of the longest run
     WITH dates_list AS (
          SELECT DISTINCT insert_date
          FROM cities
          WHERE country_code_2 = (SELECT country_code_2 FROM target_country)
            AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
     ),
     ordered AS (
          SELECT insert_date,
                 ROW_NUMBER() OVER (ORDER BY insert_date)  AS rn,
                 julianday(insert_date)                    AS jd
          FROM dates_list
     ),
     grps AS (
          SELECT insert_date,
                 rn - jd AS grp
          FROM ordered
     )
     SELECT grp,
            MIN(insert_date) AS start_date,
            MAX(insert_date) AS end_date
     FROM grps
     GROUP BY grp
     ORDER BY COUNT(*) DESC
     LIMIT 1
)
SELECT c.*
FROM cities AS c
JOIN target_country tc ON tc.country_code_2 = c.country_code_2
JOIN seq_info s        ON c.insert_date BETWEEN s.start_date AND s.end_date
ORDER BY c.insert_date, c.city_name
LIMIT 20;
```

```sql
-- 8) Calculate the proportion of rows that are the capital city within that period
WITH target_country AS (
     SELECT country_code_2
     FROM cities
     WHERE insert_date BETWEEN '2022-01-01' AND '2022-01-31'
     GROUP BY country_code_2
     HAVING COUNT(DISTINCT insert_date)=9
),
seq_info AS (      -- same CTE that finds longest consecutive run
     WITH dates_list AS (
          SELECT DISTINCT insert_date
          FROM cities
          WHERE country_code_2 = (SELECT country_code_2 FROM target_country)
            AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
     ),
     ordered AS (
          SELECT insert_date,
                 ROW_NUMBER() OVER (ORDER BY insert_date)  AS rn,
                 julianday(insert_date)                    AS jd
          FROM dates_list
     ),
     grps AS (
          SELECT insert_date,
                 rn - jd AS grp
          FROM ordered
     )
     SELECT grp,
            MIN(insert_date) AS start_date,
            MAX(insert_date) AS end_date
     FROM grps
     GROUP BY grp
     ORDER BY COUNT(*) DESC
     LIMIT 1
),
entries AS (
     SELECT *
     FROM cities AS c
     JOIN target_country tc ON tc.country_code_2 = c.country_code_2
     JOIN seq_info s        ON c.insert_date BETWEEN s.start_date AND s.end_date
)
SELECT ROUND(
       (SELECT COUNT(*) FROM entries WHERE capital = 1) * 1.0 /
       (SELECT COUNT(*) FROM entries), 3
) AS proportion_capital;
```

```sql
-- 9) List the distinct capital city/cities involved in that consecutive period
WITH entries AS (
     -- (Reuse the ‘entries’ CTE from the previous query)
     WITH target_country AS (
          SELECT country_code_2
          FROM cities
          WHERE insert_date BETWEEN '2022-01-01' AND '2022-01-31'
          GROUP BY country_code_2
          HAVING COUNT(DISTINCT insert_date)=9
     ),
     seq_info AS (
          WITH dates_list AS (
               SELECT DISTINCT insert_date
               FROM cities
               WHERE country_code_2 = (SELECT country_code_2 FROM target_country)
                 AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
          ),
          ordered AS (
               SELECT insert_date,
                      ROW_NUMBER() OVER (ORDER BY insert_date)  AS rn,
                      julianday(insert_date)                    AS jd
               FROM dates_list
          ),
          grps AS (
               SELECT insert_date,
                      rn - jd AS grp
               FROM ordered
          )
          SELECT grp,
                 MIN(insert_date) AS start_date,
                 MAX(insert_date) AS end_date
          FROM grps
          GROUP BY grp
          ORDER BY COUNT(*) DESC
          LIMIT 1
     )
     SELECT *
     FROM cities AS c
     JOIN target_country tc ON tc.country_code_2 = c.country_code_2
     JOIN seq_info s        ON c.insert_date BETWEEN s.start_date AND s.end_date
)
SELECT DISTINCT city_name
FROM entries
WHERE capital = 1;
```

```sql
-- 10) Final concise answer: country, longest consecutive‑days span,
--     number of rows in that span, and the capital‑city proportion
WITH target_country AS (
     SELECT country_code_2
     FROM cities
     WHERE insert_date BETWEEN '2022-01-01' AND '2022-01-31'
     GROUP BY country_code_2
     HAVING COUNT(DISTINCT insert_date)=9
),
country_name AS (
     SELECT country_code_2, country_name
     FROM cities_countries
     WHERE LOWER(country_code_2)=LOWER((SELECT country_code_2 FROM target_country))
),
seq_info AS (
     WITH dates_list AS (
          SELECT DISTINCT insert_date
          FROM cities
          WHERE country_code_2 = (SELECT country_code_2 FROM target_country)
            AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
     ),
     ordered AS (
          SELECT insert_date,
                 ROW_NUMBER() OVER (ORDER BY insert_date)  AS rn,
                 julianday(insert_date)                    AS jd
          FROM dates_list
     ),
     grps AS (
          SELECT insert_date,
                 rn - jd AS grp
          FROM ordered
     )
     SELECT grp,
            MIN(insert_date) AS start_date,
            MAX(insert_date) AS end_date,
            COUNT(*)         AS consec_days
     FROM grps
     GROUP BY grp
     ORDER BY consec_days DESC
     LIMIT 1
),
entries AS (
     SELECT *
     FROM cities AS c
     JOIN target_country tc ON tc.country_code_2 = c.country_code_2
     JOIN seq_info s        ON c.insert_date BETWEEN s.start_date AND s.end_date
)
SELECT cn.country_name                        AS country,
       s.start_date || ' → ' || s.end_date    AS longest_consecutive_span,
       s.consec_days                          AS days_in_span,
       ROUND((SELECT COUNT(*) FROM entries WHERE capital=1)*1.0/
             (SELECT COUNT(*) FROM entries),3) AS capital_city_proportion
FROM seq_info s
CROSS JOIN country_name cn;
```
