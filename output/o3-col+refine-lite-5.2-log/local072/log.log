-- 7) Display every city row inside that longest consecutive period
WITH target_country AS (
     SELECT country_code_2
     FROM cities
     WHERE insert_date BETWEEN '2022-01-01' AND '2022-01-31'
     GROUP BY country_code_2
     HAVING COUNT(DISTINCT insert_date)=9
),
seq_info AS (      -- copy previous CTE for start/end of the longest run
     WITH dates_list AS (
          SELECT DISTINCT insert_date
          FROM cities
          WHERE country_code_2 = (SELECT country_code_2 FROM target_country)
            AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
     ),
     ordered AS (
          SELECT insert_date,
                 ROW_NUMBER() OVER (ORDER BY insert_date)  AS rn,
                 julianday(insert_date)                    AS jd
          FROM dates_list
     ),
     grps AS (
          SELECT insert_date,
                 rn - jd AS grp
          FROM ordered
     )
     SELECT grp,
            MIN(insert_date) AS start_date,
            MAX(insert_date) AS end_date
     FROM grps
     GROUP BY grp
     ORDER BY COUNT(*) DESC
     LIMIT 1
)
SELECT c.*
FROM cities AS c
JOIN target_country tc ON tc.country_code_2 = c.country_code_2
JOIN seq_info s        ON c.insert_date BETWEEN s.start_date AND s.end_date
ORDER BY c.insert_date, c.city_name
LIMIT 20;
