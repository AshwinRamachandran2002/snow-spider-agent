-- 3) Join to countries table – find the country that has exactly 9 different
--    January‑2022 insert‑days (there is only one such country)
SELECT cty.country_code_2,
       cnt.country_name,
       COUNT(DISTINCT cty.insert_date) AS jan22_days
FROM cities            AS cty
JOIN cities_countries  AS cnt
     ON LOWER(cnt.country_code_2)=LOWER(cty.country_code_2)
WHERE cty.insert_date BETWEEN '2022-01-01' AND '2022-01-31'
GROUP BY cty.country_code_2, cnt.country_name
HAVING jan22_days = 9;
