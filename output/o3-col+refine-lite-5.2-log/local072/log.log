-- 6) Isolate the single longest consecutive‑days block for January‑2022
WITH target_country AS (
     SELECT country_code_2
     FROM cities
     WHERE insert_date BETWEEN '2022-01-01' AND '2022-01-31'
     GROUP BY country_code_2
     HAVING COUNT(DISTINCT insert_date)=9
),
dates_list AS (
     SELECT DISTINCT insert_date
     FROM cities
     WHERE country_code_2 = (SELECT country_code_2 FROM target_country)
       AND insert_date BETWEEN '2022-01-01' AND '2022-01-31'
),
ordered AS (
     SELECT insert_date,
            ROW_NUMBER() OVER (ORDER BY insert_date)  AS rn,
            julianday(insert_date)                    AS jd
     FROM dates_list
),
grps AS (
     SELECT insert_date,
            rn - jd AS grp
     FROM ordered
),
seq_info AS (
     SELECT grp,
            MIN(insert_date) AS start_date,
            MAX(insert_date) AS end_date,
            COUNT(*)         AS consec_days
     FROM grps
     GROUP BY grp
     ORDER BY consec_days DESC
     LIMIT 1
)
SELECT *
FROM seq_info;   -- ← shows the required start_date, end_date and length
