WHERE
  reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
--Description: 4)  Count how many genotype calls exist for every variant
--                (useful to make sure sample coverage is high enough).
SELECT
  reference_name,
  start,
  end,
  ARRAY_LENGTH(call) AS n_calls
FROM
  `spider2-public-data.1000_genomes.variants`
WHERE
  reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
--Description: 5)  Flatten the `call` array to look at one row per individual / call
--                and keep only the genotype array for inspection.
SELECT
  reference_name,
  start,
  end,
  c.call_set_name,
  c.genotype
FROM
  `spider2-public-data.1000_genomes.variants`,
  UNNEST(call) AS c
WHERE
  reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
--Description: 6)  Classify each flattened genotype into hom‑ref, het, hom‑alt
--                and tabulate raw observed counts for every variant.
WITH flat AS (
  SELECT
    reference_name,
    start,
    end,
    ARRAY_LENGTH(c.genotype) AS ploidy,
    -- missing if any allele == -1
    CASE
      WHEN -1 IN UNNEST(c.genotype) THEN 'missing'
      WHEN ARRAY_LENGTH(c.genotype)=2
           AND c.genotype[OFFSET(0)] = 0
           AND c.genotype[OFFSET(1)] = 0 THEN 'hom_ref'
      WHEN ARRAY_LENGTH(c.genotype)=2
           AND c.genotype[OFFSET(0)] = 1
           AND c.genotype[OFFSET(1)] = 1 THEN 'hom_alt'
      WHEN ARRAY_LENGTH(c.genotype)=2
           AND c.genotype[OFFSET(0)] IN (0,1)
           AND c.genotype[OFFSET(1)] IN (0,1)
           AND c.genotype[OFFSET(0)] != c.genotype[OFFSET(1)] THEN 'het'
      ELSE 'other'
    END AS gt_class
  FROM
    `spider2-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  WHERE
    reference_name = '17'
    AND start BETWEEN 41196311 AND 41277499
)
SELECT
  reference_name,
  start,
  end,
  COUNTIF(gt_class='hom_ref') AS obs_hom_ref,
  COUNTIF(gt_class='het')     AS obs_het,
  COUNTIF(gt_class='hom_alt') AS obs_hom_alt,
  COUNTIF(gt_class='missing') AS missing,
  COUNT(*)                    AS total_genotypes
FROM flat
GROUP BY reference_name, start, end
LIMIT 20;
```

```sql
--Description: 7)  Compute allele counts & sample allele frequency for every variant
--                from the flattened calls.  Treat missing genotypes as zero‑depth.
WITH flat AS (
  SELECT
    reference_name,
    start,
    end,
    c.genotype
  FROM
    `spider2-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  WHERE
    reference_name = '17'
    AND start BETWEEN 41196311 AND 41277499
    AND -1 NOT IN UNNEST(c.genotype)          -- drop missing
), alleles AS (
  SELECT
    reference_name,
    start,
    end,
    SUM(IF(allele = 1,1,0)) AS alt_allele_count,
    SUM(IF(allele = 0,1,0)) AS ref_allele_count
  FROM flat, UNNEST(genotype) AS allele
  GROUP BY reference_name, start, end
)
SELECT *,
       alt_allele_count / (alt_allele_count + ref_allele_count) AS sample_AF
FROM alleles
LIMIT 20;
```

```sql
--Description: 8)  Combine observed genotype counts with allele counts,
--                derive Hardy‑Weinberg expected counts and χ² statistic.
WITH flat AS (
  SELECT
    reference_name, start, end,
    CASE
      WHEN -1 IN UNNEST(c.genotype) THEN NULL           -- treat missing separately
      WHEN c.genotype[OFFSET(0)] = 0 AND c.genotype[OFFSET(1)] = 0 THEN 'hom_ref'
      WHEN c.genotype[OFFSET(0)] = 1 AND c.genotype[OFFSET(1)] = 1 THEN 'hom_alt'
      WHEN c.genotype[OFFSET(0)] IN (0,1) AND c.genotype[OFFSET(1)] IN (0,1) THEN 'het'
      ELSE NULL
    END AS gt_class
  FROM
    `spider2-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  WHERE
    reference_name = '17'
    AND start BETWEEN 41196311 AND 41277499
), obs AS (
  SELECT
    reference_name, start, end,
    COUNTIF(gt_class='hom_ref') AS n_rr,
    COUNTIF(gt_class='het')     AS n_ra,
    COUNTIF(gt_class='hom_alt') AS n_aa,
    COUNTIF(gt_class IS NULL)   AS n_missing
  FROM flat
  GROUP BY reference_name, start, end
), alleles AS (
  SELECT
    reference_name, start, end,
    2*n_rr + n_ra             AS n_ref_alleles,
    2*n_aa + n_ra             AS n_alt_alleles,
    2*(n_rr + n_ra + n_aa)    AS n_total_alleles
  FROM obs
), hw AS (
  SELECT
    o.*,
    a.n_ref_alleles,
    a.n_alt_alleles,
    a.n_total_alleles,
    a.n_alt_alleles / a.n_total_alleles            AS p,
    a.n_ref_alleles / a.n_total_alleles            AS q,
    (a.n_total_alleles / 2) * POW(p,2)             AS exp_aa,
    (a.n_total_alleles / 2) * 2*p*q                AS exp_ra,
    (a.n_total_alleles / 2) * POW(q,2)             AS exp_rr
  FROM obs o
  JOIN alleles a USING(reference_name,start,end)
)
SELECT
  reference_name, start, end,
  n_rr, n_ra, n_aa,
  exp_rr, exp_ra, exp_aa,
  2*(n_rr + n_ra + n_aa) AS n_genotypes,
  SAFE_DIVIDE( POW(n_rr-exp_rr,2), exp_rr )
  + SAFE_DIVIDE( POW(n_ra-exp_ra,2), exp_ra )
  + SAFE_DIVIDE( POW(n_aa-exp_aa,2), exp_aa )     AS chi_squared
FROM hw
LIMIT 20;
```

```sql
--Description: 9)  Final “all‑in‑one” query that outputs exactly the columns
--                requested for every variant in the chr17 interval.
WITH flat AS (
  SELECT
    reference_name, start, end,
    c.genotype
  FROM
    `spider2-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  WHERE
    reference_name = '17'
    AND start BETWEEN 41196311 AND 41277499
    AND -1 NOT IN UNNEST(c.genotype)
), gt AS (
  SELECT
    reference_name, start, end,
    CASE
      WHEN genotype[OFFSET(0)] = 0 AND genotype[OFFSET(1)] = 0 THEN 'hom_ref'
      WHEN genotype[OFFSET(0)] = 1 AND genotype[OFFSET(1)] = 1 THEN 'hom_alt'
      ELSE 'het'
    END AS gt_class
  FROM flat
), obs AS (
  SELECT
    reference_name, start, end,
    COUNTIF(gt_class='hom_ref') AS n_rr,
    COUNTIF(gt_class='het')     AS n_ra,
    COUNTIF(gt_class='hom_alt') AS n_aa
  FROM gt
  GROUP BY reference_name, start, end
), alleles AS (
  SELECT
    reference_name, start, end,
    2*n_rr + n_ra             AS n_ref_alleles,
    2*n_aa + n_ra             AS n_alt_alleles,
    2*(n_rr + n_ra + n_aa)    AS n_total_alleles
  FROM obs
), hw AS (
  SELECT
    o.*,
    a.n_ref_alleles,
    a.n_alt_alleles,
    a.n_total_alleles,
    a.n_alt_alleles / a.n_total_alleles            AS p,
    a.n_ref_alleles / a.n_total_alleles            AS q,
    (a.n_total_alleles / 2) * POW(p,2)             AS exp_aa,
    (a.n_total_alleles / 2) * 2*p*q                AS exp_ra,
    (a.n_total_alleles / 2) * POW(q,2)             AS exp_rr
  FROM obs o
  JOIN alleles a USING(reference_name,start,end)
)
SELECT
  v.reference_name,
  v.start,
  v.end,
  v.reference_bases,
  ARRAY_DISTINCT(v.alternate_bases)                 AS alternate_bases,
  v.VT                                              AS variant_type,
  v.HWE                                             AS hwe_score_vcf,
  hw.chi_squared                                    AS chi_squared_calculated,
  a.n_total_alleles / 2                             AS total_genotypes,
  hw.n_rr AS obs_hom_ref, hw.n_ra AS obs_het, hw.n_aa AS obs_hom_alt,
  hw.exp_rr AS exp_hom_ref, hw.exp_ra AS exp_het, hw.exp_aa AS exp_hom_alt,
  a.n_ref_alleles, a.n_alt_alleles,
  a.n_alt_alleles / a.n_total_alleles               AS sample_AF,
  v.AF                                              AS af_1kg
FROM
  `spider2-public-data.1000_genomes.variants` AS v
LEFT JOIN hw USING(reference_name,start,end)
LEFT JOIN alleles a USING(reference_name,start,end)
WHERE
  reference_name = '17'
  AND start BETWEEN 41196311 AND 41277499
LIMIT 20;
```

