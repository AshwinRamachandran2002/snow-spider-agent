```

```sql
--Description: Preview lap‑by‑lap position records for race_id = 1 to see how positions evolve.
SELECT "race_id",
       "driver_id",
       "lap",
       "position",
       "lap_type"
FROM   "lap_positions"
WHERE  "race_id" = 1
ORDER  BY "driver_id", "lap"
LIMIT 20;
```

```sql
--Description: Show the first 10 lap‑position entries for driver_id = 1 in race 1 to observe
--             position changes for a single driver.
SELECT "lap",
       "position",
       "lap_type"
FROM   "lap_positions"
WHERE  "race_id" = 1
  AND  "driver_id" = 1
ORDER  BY "lap"
LIMIT 20;
```

```sql
--Description: Identify the different kinds of pit‑related lap_type values recorded in lap_positions.
SELECT DISTINCT "lap_type"
FROM   "lap_positions"
WHERE  "lap_type" LIKE 'Pit%'
LIMIT 20;
```

```sql
--Description: List pit‑stop information (lap numbers, durations, etc.) for race_id = 1 so we can
--             later exclude these laps when counting on‑track overtakes.
SELECT "race_id",
       "driver_id",
       "stop",
       "lap",
       "time",
       "duration"
FROM   "pit_stops"
WHERE  "race_id" = 1
LIMIT 20;
```

```sql
--Description: Count how many pit stops each driver made in race 1 to gauge pit‑stop frequency.
SELECT "driver_id",
       COUNT(*) AS "pit_count"
FROM   "pit_stops"
WHERE  "race_id" = 1
GROUP  BY "driver_id"
LIMIT 20;
```

```sql
--Description: Display sample retirement records (lap of retirement, reason, etc.) that must be
--             filtered out when analysing overtakes.
SELECT "race_id",
       "driver_id",
       "lap",
       "status_id",
       "retirement_type"
FROM   "retirements"
LIMIT 20;
```

```sql
--Description: Show mapping of status_id to textual description to interpret retirement causes.
SELECT "status_id",
       "status"
FROM   "status"
LIMIT 20;
```

```sql
--Description: Compare each driver’s starting grid position with their position at the end of lap 1
--             (race 1) to quantify start‑phase movements that should be excluded.
SELECT r."driver_id",
       r."grid" AS "grid_position",
       lp."position" AS "lap1_position"
FROM   "results"       AS r
JOIN   "lap_positions" AS lp
       ON lp."race_id"  = r."race_id"
      AND lp."driver_id"= r."driver_id"
      AND lp."lap"      = 1
      AND lp."lap_type" = 'Race'
WHERE  r."race_id" = 1
LIMIT 20;
```

```sql
--Description: Fetch driver_id together with full name for later presentation of the final list.
SELECT "driver_id",
       "forename" || ' ' || "surname" AS "full_name"
FROM   "drivers"
LIMIT 20;
```
