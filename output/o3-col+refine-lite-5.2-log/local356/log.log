Query:
--Description: Compare each driver’s starting grid position with their position at the end of lap 1
--             (race 1) to quantify start‑phase movements that should be excluded.
SELECT r."driver_id",
       r."grid"      AS "grid_position",
       lp."position" AS "lap1_position"
FROM   "results"       AS r
JOIN   "lap_positions" AS lp
       ON lp."race_id"   = r."race_id"
      AND lp."driver_id" = r."driver_id"
      AND lp."lap"       = 1
      AND lp."lap_type"  = 'Race'
WHERE  r."race_id" = 1
LIMIT 20
