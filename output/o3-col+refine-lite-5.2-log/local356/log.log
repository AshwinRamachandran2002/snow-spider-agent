--Description: The previous query counted pit stops only for race_id = 1 (which has no pit data).
--             Remove the race filter and count pit stops for every race/driver combination,
--             limiting the output to the first 20 rows.
SELECT "race_id",
       "driver_id",
       COUNT(*) AS "pit_count"
FROM   "pit_stops"
GROUP  BY "race_id", "driver_id"
LIMIT 20
