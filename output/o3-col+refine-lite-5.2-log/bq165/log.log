```sql
--Description: 5) Retrieve a sample of CytoConverter rows that belong to either
--             breast‑cancer (Morph = 3111) or adenocarcinoma (Topo = 0401)
--             by joining Cytogen → CytoConverted on (RefNo, CaseNo, InvNo).
SELECT cc.*
FROM   `mitelman-db.prod.CytoConverted` AS cc
JOIN   `mitelman-db.prod.Cytogen`       AS cg
  ON   cc.`RefNo`  = cg.`RefNo`
 AND   cc.`CaseNo` = cg.`CaseNo`
 AND   cc.`InvNo`  = cg.`InvNo`
WHERE  cg.`Morph` = '3111'
   OR  cg.`Topo`  = '0401'
LIMIT  20;
```

```sql
--Description: 6) Look at cytogenetic band boundaries (hg38) that will be used
--             to convert the segment start/end into band‑level events.
SELECT *
FROM   `mitelman-db.prod.CytoBands_hg38`
ORDER  BY `chromosome`, `hg38_start`
LIMIT  20;
```

```sql
--Description: 7) Demonstrate how one segment is mapped onto its corresponding band(s)
--             by doing a simple overlap between a single CytoConverter row and the
--             cytoband table (for Chromosome 17 example, adjust as needed).
SELECT cc.`RefNo`, cc.`CaseNo`, cc.`InvNo`, cc.`Clone`,
       cc.`Chr`, cc.`Start`, cc.`End`, cb.`cytoband_name`
FROM   `mitelman-db.prod.CytoConverted` AS cc
JOIN   `mitelman-db.prod.CytoBands_hg38` AS cb
  ON   cb.`chromosome` = cc.`Chr`
 AND   cb.`hg38_start` < cc.`End`
 AND   cb.`hg38_stop`  > cc.`Start`
WHERE  cc.`Chr` = 'chr17'
LIMIT  20;
```

```sql
--Description: 8) Count distinct “samples” (RefNo‑CaseNo‑InvNo‑Clone) that belong to the
--             cohort (breast cancer OR adenocarcinoma).  Needed for frequency %.
SELECT COUNT(DISTINCT CONCAT(cg.`RefNo`,':',cg.`CaseNo`,':',cg.`InvNo`,':',cc.`Clone`)) AS total_samples
FROM   `mitelman-db.prod.CytoConverted` AS cc
JOIN   `mitelman-db.prod.Cytogen`       AS cg
  ON   cc.`RefNo`  = cg.`RefNo`
 AND   cc.`CaseNo` = cg.`CaseNo`
 AND   cc.`InvNo`  = cg.`InvNo`
WHERE  cg.`Morph` = '3111'
   OR  cg.`Topo`  = '0401';
```

```sql
--Description: 9) Aggregate the alterations for the cohort by cytoband and by alteration
--             category (Amp = >1 extra copy, Gain = +1, Loss = –1, HomDel = –2)
--             and compute raw counts; frequencies will be added next.
SELECT cb.`chromosome`,
       cb.`cytoband_name`,
       cc.`Type`,
       COUNT(DISTINCT CONCAT(cg.`RefNo`,':',cg.`CaseNo`,':',cg.`InvNo`,':',cc.`Clone`)) AS n_samples
FROM   `mitelman-db.prod.CytoBands_hg38` AS cb
JOIN   `mitelman-db.prod.CytoConverted`  AS cc
  ON   cb.`chromosome` = cc.`Chr`
 AND   cb.`hg38_start` < cc.`End`
 AND   cb.`hg38_stop`  > cc.`Start`
JOIN   `mitelman-db.prod.Cytogen`        AS cg
  ON   cc.`RefNo`  = cg.`RefNo`
 AND   cc.`CaseNo` = cg.`CaseNo`
 AND   cc.`InvNo`  = cg.`InvNo`
WHERE  (cg.`Morph` = '3111' OR cg.`Topo` = '0401')
  AND  cc.`Type` IN ('Amp', 'Gain', 'Loss', 'HomDel')
GROUP  BY cb.`chromosome`, cb.`cytoband_name`, cc.`Type`
ORDER  BY cb.`chromosome`, cb.`hg38_start`
LIMIT  20;
```

```sql
--Description: 10) Final query (abridged to 20 rows) that produces the requested
--              per‑band counts & percentages for each alteration class and is
--              sorted by chromosome ordinal and band coordinates.
WITH cohort AS (
  SELECT DISTINCT CONCAT(cg.`RefNo`,':',cg.`CaseNo`,':',cg.`InvNo`,':',cc.`Clone`) AS sample_id,
         cc.`Chr`, cc.`Start`, cc.`End`, cc.`Type`
  FROM   `mitelman-db.prod.CytoConverted` AS cc
  JOIN   `mitelman-db.prod.Cytogen`       AS cg
    ON   cc.`RefNo`  = cg.`RefNo`
   AND   cc.`CaseNo` = cg.`CaseNo`
   AND   cc.`InvNo`  = cg.`InvNo`
  WHERE  cg.`Morph` = '3111'
     OR  cg.`Topo`  = '0401'
)
, total AS (
  SELECT COUNT(DISTINCT sample_id) AS total_n FROM cohort
)
SELECT cb.`chromosome`,
       cb.`cytoband_name`,
       COUNT(DISTINCT IF(c.`Type` = 'Amp'   , c.sample_id, NULL)) AS n_amp,
       COUNT(DISTINCT IF(c.`Type` = 'Gain'  , c.sample_id, NULL)) AS n_gain,
       COUNT(DISTINCT IF(c.`Type` = 'Loss'  , c.sample_id, NULL)) AS n_loss,
       COUNT(DISTINCT IF(c.`Type` = 'HomDel', c.sample_id, NULL)) AS n_homdel,
       ROUND(100 * COUNT(DISTINCT IF(c.`Type` = 'Amp'   , c.sample_id, NULL))/t.total_n, 2) AS freq_amp_pct,
       ROUND(100 * COUNT(DISTINCT IF(c.`Type` = 'Gain'  , c.sample_id, NULL))/t.total_n, 2) AS freq_gain_pct,
       ROUND(100 * COUNT(DISTINCT IF(c.`Type` = 'Loss'  , c.sample_id, NULL))/t.total_n, 2) AS freq_loss_pct,
       ROUND(100 * COUNT(DISTINCT IF(c.`Type` = 'HomDel', c.sample_id, NULL))/t.total_n, 2) AS freq_homdel_pct
FROM   `mitelman-db.prod.CytoBands_hg38` AS cb
LEFT JOIN cohort AS c
  ON  cb.`chromosome` = c.`Chr`
  AND cb.`hg38_start` < c.`End`
  AND cb.`hg38_stop`  > c.`Start`
CROSS JOIN total AS t
GROUP BY cb.`chromosome`, cb.`cytoband_name`, cb.`hg38_start`, cb.`hg38_stop`, t.total_n
ORDER BY SPLIT(cb.`chromosome`,'chr')[SAFE_OFFSET(1)], cb.`hg38_start`
LIMIT 20;
```
