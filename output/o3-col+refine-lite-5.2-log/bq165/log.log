```sql
--Description: Aggregate the breast‑cancer (Morph = '3111') and adenocarcinoma
--             (Topo = '0401') cohort by cytogenetic band to obtain, for each band
--             and for each alteration class present in CytoConverter (‘Gain’,
--             ‘Loss’), the number of distinct samples that harbor the alteration.
--             Cytogen lacks InvNo, therefore it is joined to CytoConverted on the
--             keys it shares (RefNo, CaseNo).  A unique sample identifier is
--             constructed with RefNo, CaseNo, InvNo, and Clone so that each clone
--             counts only once.  Band start/stop are included in the GROUP BY so
--             that we can sort on genomic coordinates without SQL errors.
SELECT
  cb.chromosome,
  cb.cytoband_name,
  cb.hg38_start,
  cb.hg38_stop,
  cc.Type,
  COUNT(DISTINCT CONCAT(cg.RefNo, ':', cg.CaseNo, ':', cc.InvNo, ':', cc.Clone)) AS n_samples
FROM   `mitelman-db.prod.CytoBands_hg38` AS cb
JOIN   `mitelman-db.prod.CytoConverted`  AS cc
       ON cb.chromosome = cc.Chr
      AND cb.hg38_start < cc.End
      AND cb.hg38_stop  > cc.Start
JOIN   `mitelman-db.prod.Cytogen`        AS cg
       ON cc.RefNo  = cg.RefNo
      AND cc.CaseNo = cg.CaseNo
WHERE  (cg.Morph = '3111' OR cg.Topo = '0401')
  AND  cc.Type IN ('Gain', 'Loss')                 -- alteration classes present
GROUP BY
  cb.chromosome,
  cb.cytoband_name,
  cb.hg38_start,
  cb.hg38_stop,
  cc.Type
ORDER BY
  CASE
    WHEN REGEXP_EXTRACT(cb.chromosome, r'chr(\d+)') IS NOT NULL
         THEN CAST(REGEXP_EXTRACT(cb.chromosome, r'chr(\d+)') AS INT64)
    WHEN cb.chromosome = 'chrX' THEN 23
    WHEN cb.chromosome = 'chrY' THEN 24
    ELSE 25
  END,
  cb.hg38_start
LIMIT 20;
