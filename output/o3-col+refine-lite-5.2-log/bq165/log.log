Query:
--Description: 8) Count distinct “samples” (RefNo‑CaseNo‑InvNo‑Clone) that belong to the
--             cohort (breast cancer OR adenocarcinoma).  Cytogen has no InvNo column,
--             so the join is done on (RefNo, CaseNo) only and the sample identifier
--             is built with cc.InvNo.
SELECT COUNT(DISTINCT CONCAT(cg.`RefNo`,':',cg.`CaseNo`,':',cc.`InvNo`,':',cc.`Clone`)) AS total_samples
FROM   `mitelman-db.prod.CytoConverted` AS cc
JOIN   `mitelman-db.prod.Cytogen`       AS cg
  ON   cc.`RefNo`  = cg.`RefNo`
 AND   cc.`CaseNo` = cg.`CaseNo`
WHERE  cg.`Morph` = '3111'
   OR  cg.`Topo`  = '0401'
Answer:
total_samples
4580
Query:
--Description: 10) Produce, for each cytogenetic band, the counts and percentages
--               of breast‑cancer (Morph = '3111') or adenocarcinoma (Topo = '0401')
--               samples that carry each alteration class recorded by CytoConverter.
--               Cytogen lacks InvNo, so it is joined to CytoConverted on (RefNo,
--               CaseNo) only; the unique sample identifier therefore contains
--               RefNo : CaseNo : InvNo : Clone.  Band start/stop are included in
--               SELECT / GROUP BY so we can order by genomic coordinates without
--               SQL errors.
WITH cohort AS (
  SELECT DISTINCT
         CONCAT(cg.RefNo, ':', cg.CaseNo, ':', cc.InvNo, ':', cc.Clone) AS sample_id,
         cc.Chr,
         cc.Start,
         cc.End,
         cc.Type
  FROM   `mitelman-db.prod.CytoConverted` AS cc
  JOIN   `mitelman-db.prod.Cytogen`       AS cg
    ON   cc.RefNo  = cg.RefNo
   AND   cc.CaseNo = cg.CaseNo
  WHERE  cg.Morph = '3111'      -- breast carcinoma
     OR  cg.Topo  = '0401'      -- adenocarcinoma
),
total AS (
  SELECT COUNT(DISTINCT sample_id) AS total_n FROM cohort
)
SELECT
  cb.chromosome,
  cb.cytoband_name,
  cb.hg38_start,
  cb.hg38_stop,
  -- raw counts per alteration class
  COUNT(DISTINCT IF(c.Type = 'Amp'   , c.sample_id, NULL)) AS n_amp,
  COUNT(DISTINCT IF(c.Type = 'Gain'  , c.sample_id, NULL)) AS n_gain,
  COUNT(DISTINCT IF(c.Type = 'Loss'  , c.sample_id, NULL)) AS n_loss,
  COUNT(DISTINCT IF(c.Type = 'HomDel', c.sample_id, NULL)) AS n_homdel,
  -- frequencies (% of all cohort samples)
  ROUND(100 * COUNT(DISTINCT IF(c.Type = 'Amp'   , c.sample_id, NULL)) / t.total_n, 2) AS freq_amp_pct,
  ROUND(100 * COUNT(DISTINCT IF(c.Type = 'Gain'  , c.sample_id, NULL)) / t.total_n, 2) AS freq_gain_pct,
  ROUND(100 * COUNT(DISTINCT IF(c.Type = 'Loss'  , c.sample_id, NULL)) / t.total_n, 2) AS freq_loss_pct,
  ROUND(100 * COUNT(DISTINCT IF(c.Type = 'HomDel', c.sample_id, NULL)) / t.total_n, 2) AS freq_homdel_pct
FROM   `mitelman-db.prod.CytoBands_hg38` AS cb
LEFT  JOIN cohort AS c
       ON cb.chromosome = c.Chr
      AND cb.hg38_start < c.End
      AND cb.hg38_stop  > c.Start
CROSS JOIN total AS t
GROUP BY
  cb.chromosome,
  cb.cytoband_name,
  cb.hg38_start,
  cb.hg38_stop,
  t.total_n
ORDER BY
  CASE
    WHEN REGEXP_EXTRACT(cb.chromosome, r'chr(\d+)') IS NOT NULL
         THEN CAST(REGEXP_EXTRACT(cb.chromosome, r'chr(\d+)') AS INT64)
    WHEN cb.chromosome = 'chrX' THEN 23
    WHEN cb.chromosome = 'chrY' THEN 24
    ELSE 25
  END,
  cb.hg38_start
LIMIT 20
Answer:
chromosome,cytoband_name,hg38_start,hg38_stop,n_amp,n_gain,n_loss,n_homdel,freq_amp_pct,freq_gain_pct,freq_loss_pct,freq_homdel_pct
