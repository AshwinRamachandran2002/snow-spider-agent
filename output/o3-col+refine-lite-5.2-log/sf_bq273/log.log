```sql
--Description: Look at a sample of Facebook‑sourced users (their user_id is needed for joins later)
SELECT *
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "traffic_source" ILIKE '%facebook%'
LIMIT 20;
```

```sql
--Description: Pull a few ORDERS that belong to Facebook‑sourced users and were created between Aug‑2022 and Nov‑2023
SELECT o.*
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"      AS o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"       AS u
  ON o."user_id" = u."id"
WHERE u."traffic_source" ILIKE '%facebook%'
  AND o."created_at" BETWEEN 1659312000000000 /*2022‑08‑01*/ 
                        AND 1701388799000000 /*2023‑11‑30*/
LIMIT 20;
```

```sql
--Description: Inspect a few ORDER_ITEMS that correspond to those Facebook orders (so we can see prices and product_id)
SELECT oi.*
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  AS oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       AS o
  ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        AS u
  ON oi."user_id" = u."id"
WHERE u."traffic_source" ILIKE '%facebook%'
  AND o."created_at" BETWEEN 1659312000000000 
                        AND 1701388799000000
  AND oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: Join ORDER_ITEMS to PRODUCTS to calculate a per‑item gross profit (sale_price – cost) sample
SELECT 
    oi."order_id",
    oi."product_id",
    oi."sale_price",
    p."cost",
    (oi."sale_price" - p."cost") AS "profit_per_item"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  AS oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     AS p
  ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: Aggregate profit at the ORDER level for Facebook‑sourced, completed, in‑window orders
SELECT 
    oi."order_id",
    SUM(oi."sale_price" - p."cost") AS "order_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  AS oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     AS p
  ON oi."product_id" = p."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       AS o
  ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        AS u
  ON oi."user_id" = u."id"
WHERE u."traffic_source" ILIKE '%facebook%'
  AND o."status" = 'Complete'
  AND o."created_at" BETWEEN 1659312000000000 
                        AND 1701388799000000
GROUP BY oi."order_id"
LIMIT 20;
```

```sql
--Description: Roll the profit up to delivery month (using ORDER_ITEMS.delivered_at) for the same Facebook cohort
SELECT
    DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."delivered_at"/1000000)) AS "delivery_month",
    SUM(oi."sale_price" - p."cost")                                  AS "monthly_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  AS oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     AS p
  ON oi."product_id" = p."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       AS o
  ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        AS u
  ON oi."user_id" = u."id"
WHERE u."traffic_source" ILIKE '%facebook%'
  AND o."status" = 'Complete'
  AND o."created_at" BETWEEN 1659312000000000 
                        AND 1701388799000000
  AND oi."delivered_at" IS NOT NULL
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Compute month‑over‑month profit deltas and rank the biggest jumps
WITH monthly AS (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."delivered_at"/1000000)) AS "delivery_month",
        SUM(oi."sale_price" - p."cost")                                  AS "monthly_profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  AS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     AS p
      ON oi."product_id" = p."id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       AS o
      ON oi."order_id" = o."order_id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        AS u
      ON oi."user_id" = u."id"
    WHERE u."traffic_source" ILIKE '%facebook%'
      AND o."status" = 'Complete'
      AND o."created_at" BETWEEN 1659312000000000 
                            AND 1701388799000000
      AND oi."delivered_at" IS NOT NULL
    GROUP BY 1
)
SELECT
    "delivery_month",
    "monthly_profit",
    ("monthly_profit" - LAG("monthly_profit") OVER (ORDER BY "delivery_month")) AS "mom_profit_increase"
FROM monthly
QUALIFY "mom_profit_increase" IS NOT NULL
ORDER BY "mom_profit_increase" DESC
LIMIT 20;
```

```sql
--Description: Pick the top‑5 months (Aug‑2022 to Nov‑2023 window) that had the largest month‑over‑month profit increases
WITH monthly AS (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."delivered_at"/1000000)) AS "delivery_month",
        SUM(oi."sale_price" - p."cost")                                  AS "monthly_profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  AS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     AS p
      ON oi."product_id" = p."id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       AS o
      ON oi."order_id" = o."order_id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        AS u
      ON oi."user_id" = u."id"
    WHERE u."traffic_source" ILIKE '%facebook%'
      AND o."status" = 'Complete'
      AND o."created_at" BETWEEN 1659312000000000 
                            AND 1701388799000000
      AND oi."delivered_at" IS NOT NULL
    GROUP BY 1
)
SELECT
    "delivery_month",
    "monthly_profit",
    ("monthly_profit" - LAG("monthly_profit") OVER (ORDER BY "delivery_month")) AS "profit_delta_vs_prior_month"
FROM monthly
QUALIFY "profit_delta_vs_prior_month" IS NOT NULL
ORDER BY "profit_delta_vs_prior_month" DESC
LIMIT 5;
```
