Query:
--10. Description:  Add age‑group text to the comparison for readability.
WITH discharge_codes AS (
    SELECT "Code"
    FROM   DEATH.DEATH.ICD10CODE
    WHERE  "Description" ILIKE '%discharge%'
      AND  NOT ("Description" ILIKE '%urethral discharge%'
            OR  "Description" ILIKE '%discharge of firework%'
            OR  "Description" ILIKE '%legal intervention involving firearm discharge%')
),
vehicle_codes AS (
    SELECT "Code"
    FROM   DEATH.DEATH.ICD10CODE
    WHERE  "Description" ILIKE '%vehicle%'
),
discharge_deaths AS (
    SELECT d."AgeRecode27", COUNT(*) AS cnt
    FROM   DEATH.DEATH.DEATHRECORDS d
    JOIN   discharge_codes dc ON d."Icd10Code" = dc."Code"
    WHERE  d."RaceRecode3" = 1
    GROUP  BY d."AgeRecode27"
),
vehicle_deaths AS (
    SELECT d."AgeRecode27", COUNT(*) AS cnt
    FROM   DEATH.DEATH.DEATHRECORDS d
    JOIN   vehicle_codes vc ON d."Icd10Code" = vc."Code"
    WHERE  d."RaceRecode3" = 1
    GROUP  BY d."AgeRecode27"
)
SELECT  COALESCE(dd."AgeRecode27", vd."AgeRecode27")                      AS "AgeRecode27",
        ag."Description"                                                 AS "Age_group",
        dd.cnt                                                           AS "discharge_deaths",
        vd.cnt                                                           AS "vehicle_deaths",
        (dd.cnt - vd.cnt)                                                AS "difference"
FROM    discharge_deaths dd
FULL JOIN vehicle_deaths vd
        ON dd."AgeRecode27" = vd."AgeRecode27"
LEFT  JOIN DEATH.DEATH.AGERECODE27 ag
        ON ag."Code" = COALESCE(dd."AgeRecode27", vd."AgeRecode27")
