```sql
--Description / thinking process:
-- • Objective: retrieve distinct VEP gene symbols for variants on chr1
--   between positions 55,039,447 and 55,064,852 (gnomAD v3 genomes).
-- • Table: bigquery-public-data.gnomAD.v3_genomes__chr1.
-- • Data nesting:
--     - Row → variant.
--     - t.alternate_bases (ARRAY) → alias ab.
--     - ab.vep (ARRAY) → alias v, contains SYMBOL.
-- • Approach:
--     1. UNNEST alternate_bases.
--     2. UNNEST vep inside each allele.
--     3. Filter by start_position interval.
--     4. Exclude NULL symbols.
--     5. DISTINCT for unique genes, LIMIT 20 for sample view.
SELECT DISTINCT v.SYMBOL
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` AS t
JOIN UNNEST(t.alternate_bases) AS ab
JOIN UNNEST(ab.vep)            AS v
WHERE t.start_position BETWEEN 55039447 AND 55064852
  AND v.SYMBOL IS NOT NULL
LIMIT 20;
```
