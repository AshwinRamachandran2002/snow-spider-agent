```sql
-- 1) Quick look at variants in the target region (chromosome‑1, gnomAD v3 genomes)
SELECT
  reference_name,
  start_position,
  end_position,
  reference_bases,
  alternate_bases
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 2) Unnest the alternate_bases array to see alleles, AC and AF values
SELECT
  start_position,
  ab.alt,
  ab.AC,
  ab.AF
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` AS t,
UNNEST(t.alternate_bases) AS ab
WHERE start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 3) Inspect Variant Effect Predictor (VEP) symbols observed in this interval
SELECT DISTINCT
  v.SYMBOL
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` AS t,
UNNEST(t.vep) AS v
WHERE t.start_position BETWEEN 55039447 AND 55064852
  AND v.SYMBOL IS NOT NULL
LIMIT 20;
```

```sql
-- 4) Number of variants (rows) in the interval
SELECT COUNT(*) AS num_variants
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 5) Total allele count (Σ AC over all alternate alleles)
SELECT SUM(ab.AC) AS total_AC
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` AS t,
UNNEST(t.alternate_bases) AS ab
WHERE start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 6) Total number of alleles observed (Σ AN across variants)
SELECT SUM(AN) AS total_AN
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 7) Variant type distribution inside the region
SELECT
  variant_type,
  COUNT(*) AS ct
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE start_position BETWEEN 55039447 AND 55064852
GROUP BY variant_type
ORDER BY ct DESC
LIMIT 20;
```

```sql
-- 8) List of distinct gene symbols as a single aggregated array
SELECT ARRAY_AGG(DISTINCT v.SYMBOL IGNORE NULLS) AS gene_symbols
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` AS t,
UNNEST(t.vep) AS v
WHERE t.start_position BETWEEN 55039447 AND 55064852
LIMIT 20;
```

```sql
-- 9) Everything together – variants, Σ AC, Σ AN, distinct genes, mutation density
WITH region_stats AS (
  SELECT
    COUNT(*) AS num_variants,
    SUM(AN) AS total_AN
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
  WHERE start_position BETWEEN 55039447 AND 55064852
),
allele_stats AS (
  SELECT
    SUM(ab.AC) AS total_AC
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` AS t,
  UNNEST(t.alternate_bases) AS ab
  WHERE t.start_position BETWEEN 55039447 AND 55064852
),
gene_stats AS (
  SELECT ARRAY_AGG(DISTINCT v.SYMBOL IGNORE NULLS) AS genes
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` AS t,
  UNNEST(t.vep) AS v
  WHERE t.start_position BETWEEN 55039447 AND 55064852
)
SELECT
  region_stats.num_variants,
  allele_stats.total_AC,
  region_stats.total_AN,
  gene_stats.genes AS distinct_gene_symbols,
  25406.0 / region_stats.num_variants AS bp_per_variant -- region length / #variants
FROM region_stats, allele_stats, gene_stats
LIMIT 20;
```

```sql
-- 10) (Optional debug) Show start_position, AC, AN for first few variants
SELECT
  start_position,
  (SELECT SUM(ab.AC) FROM UNNEST(alternate_bases) AS ab) AS sum_AC,
  AN
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE start_position BETWEEN 55039447 AND 55064852
ORDER BY start_position
LIMIT 20;
```
