Query:
--Description: 7) Distribution of variant types (e.g., snv, indel) within the region
SELECT
  variant_type,
  COUNT(*) AS ct
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
WHERE start_position BETWEEN 55039447 AND 55064852
GROUP BY variant_type
ORDER BY ct DESC
LIMIT 20
