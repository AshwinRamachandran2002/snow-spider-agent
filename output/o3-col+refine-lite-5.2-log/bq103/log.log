Query:
--Description: 8) Aggregate all DISTINCT VEP gene symbols observed in the interval into an array
SELECT ARRAY_AGG(DISTINCT v.SYMBOL IGNORE NULLS) AS gene_symbols
FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` AS t
JOIN UNNEST(t.alternate_bases) AS ab
JOIN UNNEST(ab.vep)            AS v
WHERE t.start_position BETWEEN 55039447 AND 55064852
LIMIT 20
Answer:
gene_symbols
"['PCSK9', 'USP24']"
Query:
--Description: 9) Single query that returns: number of variants, Σ AC, Σ AN, distinct genes, and bp‑per‑variant density
WITH region_stats AS (
  SELECT
    COUNT(*) AS num_variants,
    SUM(AN)  AS total_AN
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1`
  WHERE start_position BETWEEN 55039447 AND 55064852
),
allele_stats AS (
  SELECT
    SUM(ab.AC) AS total_AC
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` AS t
  JOIN UNNEST(t.alternate_bases) AS ab
  WHERE t.start_position BETWEEN 55039447 AND 55064852
),
gene_stats AS (
  SELECT ARRAY_AGG(DISTINCT v.SYMBOL IGNORE NULLS) AS genes
  FROM `bigquery-public-data.gnomAD.v3_genomes__chr1` AS t
  JOIN UNNEST(t.alternate_bases) AS ab
  JOIN UNNEST(ab.vep)            AS v
  WHERE t.start_position BETWEEN 55039447 AND 55064852
)
SELECT
  region_stats.num_variants,
  allele_stats.total_AC,
  region_stats.total_AN,
  gene_stats.genes  AS distinct_gene_symbols,
  25406.0 / region_stats.num_variants AS bp_per_variant
FROM region_stats, allele_stats, gene_stats
LIMIT 20
Answer:
num_variants,total_AC,total_AN,distinct_gene_symbols,bp_per_variant
5604,7917038,790936430,"['USP24', 'PCSK9']",4.533547466095646
