  FROM `genomics-public-data.1000_genomes.sample_info`
)
SELECT
  v.start,
  v.end,
  SUM(IF(sg.is_eas = 1 AND g > 0, 1, 0)) AS eas_alt,
  SUM(IF(sg.is_eas = 1 AND g = 0, 1, 0)) AS eas_ref,
  SUM(IF(sg.is_eas = 0 AND g > 0, 1, 0)) AS oth_alt,
  SUM(IF(sg.is_eas = 0 AND g = 0, 1, 0)) AS oth_ref
FROM `genomics-public-data.1000_genomes.variants` AS v
JOIN UNNEST(v.call)     AS c
JOIN sample_groups      AS sg ON sg.sample_id = c.call_set_name
