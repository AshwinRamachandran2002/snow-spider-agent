Query:
--Description: 6) Build allele counts (alt / ref) for every chromosome‑12 variant (preview 20 rows);
--              counts are obtained by expanding every genotype allele (g) and summing separately
--              for EAS cases and non‑EAS controls.
WITH sample_groups AS (
  SELECT
    Sample AS sample_id,
    CASE WHEN Super_Population = 'EAS' THEN 1 ELSE 0 END AS is_eas
  FROM `genomics-public-data.1000_genomes.sample_info`
)
SELECT
  v.start,
  v.end,
  SUM(IF(sg.is_eas = 1 AND g > 0, 1, 0)) AS eas_alt,
  SUM(IF(sg.is_eas = 1 AND g = 0, 1, 0)) AS eas_ref,
  SUM(IF(sg.is_eas = 0 AND g > 0, 1, 0)) AS oth_alt,
  SUM(IF(sg.is_eas = 0 AND g = 0, 1, 0)) AS oth_ref
FROM `genomics-public-data.1000_genomes.variants` AS v
JOIN UNNEST(v.call)     AS c
JOIN sample_groups      AS sg ON sg.sample_id = c.call_set_name
JOIN UNNEST(c.genotype) AS g
WHERE v.reference_name = '12'
GROUP BY v.start, v.end
LIMIT 20
