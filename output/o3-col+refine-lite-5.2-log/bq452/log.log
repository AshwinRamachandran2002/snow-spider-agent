```sql
-- 5.  For a SINGLE variant (picked arbitrarily) show how to obtain the number
--     of reference vs alternate alleles in EAS and in the other populations
SELECT
  v.start , v.end ,
  SUM( CASE WHEN s.is_eas=1 THEN alt ELSE 0 END ) AS eas_alt ,
  SUM( CASE WHEN s.is_eas=1 THEN ref ELSE 0 END ) AS eas_ref ,
  SUM( CASE WHEN s.is_eas=0 THEN alt ELSE 0 END ) AS oth_alt ,
  SUM( CASE WHEN s.is_eas=0 THEN ref ELSE 0 END ) AS oth_ref
FROM  `spider2-public-data.1000_genomes.variants` AS v
JOIN  UNNEST(v.call) AS c
JOIN (
        SELECT `Sample`, CASE WHEN `Super_Population`='EAS' THEN 1 ELSE 0 END AS is_eas
        FROM   `spider2-public-data.1000_genomes.sample_info`
     ) AS s
     ON  s.`Sample` = c.call_set_name
CROSS JOIN (
        SELECT
          COUNTIF(g>0) AS alt ,        -- alt alleles in that call
          COUNTIF(g=0) AS ref          -- ref alleles in that call
        FROM UNNEST(c.genotype) AS g
     )
WHERE v.reference_name = '12'
  AND v.start = 11200000            -- >>> replace by some concrete start seen above
GROUP BY v.start , v.end
LIMIT 20 ;
```

```sql
-- 6.  Build an allele‑count table for EVERY variant on chr 12
WITH sample_groups AS (
  SELECT `Sample` AS sample_id ,
         CASE WHEN `Super_Population`='EAS' THEN 1 ELSE 0 END AS is_eas
  FROM   `spider2-public-data.1000_genomes.sample_info`
)
SELECT
  v.start , v.end ,
  SUM( CASE WHEN sg.is_eas=1 THEN alt ELSE 0 END ) AS eas_alt ,
  SUM( CASE WHEN sg.is_eas=1 THEN ref ELSE 0 END ) AS eas_ref ,
  SUM( CASE WHEN sg.is_eas=0 THEN alt ELSE 0 END ) AS oth_alt ,
  SUM( CASE WHEN sg.is_eas=0 THEN ref ELSE 0 END ) AS oth_ref
FROM  `spider2-public-data.1000_genomes.variants` AS v
JOIN  UNNEST(v.call) AS c
JOIN  sample_groups AS sg
      ON sg.sample_id = c.call_set_name
CROSS JOIN (
  SELECT COUNTIF(g>0) AS alt , COUNTIF(g=0) AS ref
  FROM UNNEST(c.genotype) AS g
) cnt
WHERE v.reference_name = '12'
GROUP BY v.start , v.end
LIMIT 20 ;
```

```sql
-- 7.  Add χ² with Yates’s correction, and keep only variants whose expected
--     counts (all four cells) are at least 5.  Show highest χ² values
WITH allele_counts AS (
  SELECT
    v.start , v.end ,
    SUM( CASE WHEN sg.is_eas=1 THEN alt ELSE 0 END ) AS a ,   -- EAS alt
    SUM( CASE WHEN sg.is_eas=1 THEN ref ELSE 0 END ) AS b ,   -- EAS ref
    SUM( CASE WHEN sg.is_eas=0 THEN alt ELSE 0 END ) AS c ,   -- OTH alt
    SUM( CASE WHEN sg.is_eas=0 THEN ref ELSE 0 END ) AS d     -- OTH ref
  FROM `spider2-public-data.1000_genomes.variants`  AS v
  JOIN UNNEST(v.call) AS ccall
  JOIN (
        SELECT `Sample` AS sample_id ,
               CASE WHEN `Super_Population`='EAS' THEN 1 ELSE 0 END AS is_eas
        FROM   `spider2-public-data.1000_genomes.sample_info`
       ) AS sg
       ON  sg.sample_id = ccall.call_set_name
  CROSS JOIN (
        SELECT COUNTIF(g>0) AS alt , COUNTIF(g=0) AS ref
        FROM UNNEST(ccall.genotype) AS g
  ) cnt
  WHERE v.reference_name = '12'
  GROUP BY v.start , v.end
)
SELECT
  start , end ,
  a , b , c , d ,
  -- Yates‑corrected χ² for 2×2
  ( ( (ABS(a*d - b*c) - 0.5* (a+b+c+d) )*(ABS(a*d - b*c) - 0.5*(a+b+c+d)) )
    * (a+b+c+d)
  ) / NULLIF( (a+b)*(c+d)*(a+c)*(b+d) , 0 )  AS chi_sq
FROM allele_counts
WHERE
  -- expected counts ≥ 5
  (a+b)*(a+c)/(a+b+c+d) >=5
  AND (c+d)*(a+c)/(a+b+c+d) >=5
  AND (a+b)*(b+d)/(a+b+c+d) >=5
  AND (c+d)*(b+d)/(a+b+c+d) >=5
ORDER BY chi_sq DESC
LIMIT 20 ;
```

```sql
-- 8.  Keep only those variants whose χ² ≥ 29.71679 and list the required
--     fields (start, end, chi‑square) – still ordered by decreasing χ²
WITH allele_counts AS (
  SELECT
    v.start , v.end ,
    SUM( CASE WHEN sg.is_eas=1 THEN alt ELSE 0 END ) AS a ,
    SUM( CASE WHEN sg.is_eas=1 THEN ref ELSE 0 END ) AS b ,
    SUM( CASE WHEN sg.is_eas=0 THEN alt ELSE 0 END ) AS c ,
    SUM( CASE WHEN sg.is_eas=0 THEN ref ELSE 0 END ) AS d
  FROM `spider2-public-data.1000_genomes.variants`  AS v
  JOIN UNNEST(v.call) AS ccall
  JOIN (
        SELECT `Sample` AS sample_id ,
               CASE WHEN `Super_Population`='EAS' THEN 1 ELSE 0 END AS is_eas
        FROM   `spider2-public-data.1000_genomes.sample_info`
       ) AS sg
       ON  sg.sample_id = ccall.call_set_name
  CROSS JOIN (
        SELECT COUNTIF(g>0) AS alt , COUNTIF(g=0) AS ref
        FROM UNNEST(ccall.genotype) AS g
  ) cnt
  WHERE v.reference_name = '12'
  GROUP BY v.start , v.end
), chisq AS (
  SELECT
    start , end ,
    ( ( (ABS(a*d - b*c) - 0.5* (a+b+c+d) )*(ABS(a*d - b*c) - 0.5*(a+b+c+d)) )
      * (a+b+c+d)
    ) / NULLIF( (a+b)*(c+d)*(a+c)*(b+d) , 0 )  AS chi_sq ,
    a , b , c , d ,
    (a+b+c+d) AS N
  FROM allele_counts
  WHERE
    -- expected counts ≥ 5
    (a+b)*(a+c)/(a+b+c+d) >=5
    AND (c+d)*(a+c)/(a+b+c+d) >=5
    AND (a+b)*(b+d)/(a+b+c+d) >=5
    AND (c+d)*(b+d)/(a+b+c+d) >=5
)
SELECT start , end , chi_sq
FROM   chisq
WHERE  chi_sq >= 29.71679
ORDER  BY chi_sq DESC ;
```

