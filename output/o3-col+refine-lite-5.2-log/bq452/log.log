```sql
--Description: Compute Yates‑corrected χ² for every variant on chromosome 12.
--1)  Build a helper list of samples labelled as EAS (cases) or not (controls).
--2)  Expand every genotype allele to count reference (g = 0) and alternate (g > 0)
--    alleles in the two groups, aliasing the end coordinate as end_pos to avoid the
--    reserved word END.
--3)  Apply Yates’s continuity‑corrected χ² formula and retain only variants whose
--    expected counts in all four cells are ≥ 5.  Show the 20 variants with the
--    highest χ² scores.
WITH sample_groups AS (
  SELECT
    Sample AS sample_id,
    CASE WHEN Super_Population = 'EAS' THEN 1 ELSE 0 END AS is_eas
  FROM `genomics-public-data.1000_genomes.sample_info`
),
allele_counts AS (
  SELECT
    v.start AS start_pos,
    v.end   AS end_pos,
    SUM(IF(sg.is_eas = 1 AND g > 0, 1, 0)) AS a,  -- EAS alt
    SUM(IF(sg.is_eas = 1 AND g = 0, 1, 0)) AS b,  -- EAS ref
    SUM(IF(sg.is_eas = 0 AND g > 0, 1, 0)) AS c,  -- OTH alt
    SUM(IF(sg.is_eas = 0 AND g = 0, 1, 0)) AS d   -- OTH ref
  FROM `genomics-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.call)         AS ccall
  JOIN sample_groups          AS sg ON sg.sample_id = ccall.call_set_name
  JOIN UNNEST(ccall.genotype) AS g
  WHERE v.reference_name = '12'
  GROUP BY start_pos, end_pos
)
SELECT
  start_pos,
  end_pos,
  a, b, c, d,
  (POWER(ABS(a*d - b*c) - 0.5, 2) * (a+b+c+d)) /
  NULLIF((a+b)*(c+d)*(a+c)*(b+d), 0) AS chi_sq
FROM allele_counts
WHERE
  (a+b)*(a+c)/(a+b+c+d) >= 5 AND
  (c+d)*(a+c)/(a+b+c+d) >= 5 AND
  (a+b)*(b+d)/(a+b+c+d) >= 5 AND
  (c+d)*(b+d)/(a+b+c+d) >= 5
ORDER BY chi_sq DESC
LIMIT 20;
