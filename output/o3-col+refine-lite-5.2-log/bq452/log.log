    SUM(CASE WHEN sg.is_eas = 1 THEN cnt.alt ELSE 0 END) AS a,
    SUM(CASE WHEN sg.is_eas = 1 THEN cnt.ref ELSE 0 END) AS b,
    SUM(CASE WHEN sg.is_eas = 0 THEN cnt.alt ELSE 0 END) AS c,
    SUM(CASE WHEN sg.is_eas = 0 THEN cnt.ref ELSE 0 END) AS d
  FROM `genomics-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.call) AS ccall
  JOIN (
        SELECT Sample, CASE WHEN Super_Population = 'EAS' THEN 1 ELSE 0 END AS is_eas
        FROM `genomics-public-data.1000_genomes.sample_info`
       ) AS sg
    ON sg.Sample = ccall.call_set_name
  CROSS JOIN (
        SELECT COUNTIF(g > 0) AS alt, COUNTIF(g = 0) AS ref
        FROM UNNEST(ccall.genotype) AS g
  ) AS cnt
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.end
), chisq AS (
  SELECT
    start, end,
    (POWER(ABS(a*d - b*c) - 0.5*(a+b+c+d), 2) * (a+b+c+d)) /
    NULLIF((a+b)*(c+d)*(a+c)*(b+d), 0) AS chi_sq
  FROM allele_counts
