--Description: 5) Example: compute ref/alt allele counts for one chosen variant on chr 12
WITH sample_groups AS (
  SELECT Sample, CASE WHEN Super_Population = 'EAS' THEN 1 ELSE 0 END AS is_eas
  FROM `genomics-public-data.1000_genomes.sample_info`
)
SELECT
  v.start, v.end,
  SUM(CASE WHEN sg.is_eas = 1 THEN cnt.alt ELSE 0 END) AS eas_alt,
  SUM(CASE WHEN sg.is_eas = 1 THEN cnt.ref ELSE 0 END) AS eas_ref,
  SUM(CASE WHEN sg.is_eas = 0 THEN cnt.alt ELSE 0 END) AS oth_alt,
  SUM(CASE WHEN sg.is_eas = 0 THEN cnt.ref ELSE 0 END) AS oth_ref
FROM `genomics-public-data.1000_genomes.variants` AS v
JOIN UNNEST(v.call) AS c
JOIN sample_groups AS sg ON sg.Sample = c.call_set_name
CROSS JOIN (
  SELECT
    COUNTIF(g > 0) AS alt,
    COUNTIF(g = 0) AS ref
  FROM UNNEST(c.genotype) AS g
) AS cnt
WHERE v.reference_name = '12'
  AND v.start = 11200000          -- replace with an actual start if desired
GROUP BY v.start, v.end
LIMIT 20;
