--Description: Count total number of movies released in each year (last 4 chars of Movie.year).
SELECT 
    SUBSTR("year", -4) AS "year",
    COUNT(*)           AS "total_movies"
FROM "Movie"
GROUP BY SUBSTR("year", -4)
ORDER BY "year"
LIMIT 20
