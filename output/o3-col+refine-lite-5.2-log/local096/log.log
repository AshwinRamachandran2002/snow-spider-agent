           GROUP BY mc."MID"
           HAVING SUM(CASE WHEN TRIM(p."Gender") = 'Female' THEN 0 ELSE 1 END) = 0
     )
     GROUP BY SUBSTR(m."year", -4)) AS exc_fem
  ON yr_tot."year" = exc_fem."year"
ORDER BY yr_tot."year"
LIMIT 20;
