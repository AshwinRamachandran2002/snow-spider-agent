--Description: Final report—per year, show total movies and the percentage that had exclusively female casts (join uses TRIMmed PIDs).
SELECT 
    yr_tot."year",
    yr_tot."total_movies",
    ROUND(100.0 * IFNULL(exc_fem."exclusive_female", 0) / yr_tot."total_movies", 2) AS "percent_exclusively_female"
FROM
    (SELECT SUBSTR("year", -4) AS "year", COUNT(*) AS "total_movies"
     FROM "Movie"
     GROUP BY SUBSTR("year", -4)) AS yr_tot
LEFT JOIN
    (SELECT SUBSTR(m."year", -4) AS "year", COUNT(*) AS "exclusive_female"
     FROM "Movie" AS m
     WHERE m."MID" IN (
           SELECT mc."MID"
           FROM "M_Cast" AS mc
           JOIN "Person" AS p
             ON TRIM(mc."PID") = p."PID"
           GROUP BY mc."MID"
           HAVING SUM(CASE WHEN TRIM(p."Gender") = 'Female' THEN 0 ELSE 1 END) = 0
     )
     GROUP BY SUBSTR(m."year", -4)) AS exc_fem
  ON yr_tot."year" = exc_fem."year"
ORDER BY yr_tot."year"
LIMIT 20
