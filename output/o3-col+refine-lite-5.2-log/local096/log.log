--Description: Retrieve the movies whose casts are exclusively female (no male or unknown‑gender actors), using TRIM on "M_Cast"."PID" for a correct join.
SELECT DISTINCT mc."MID"
FROM "M_Cast" AS mc
JOIN "Person" AS p
  ON TRIM(mc."PID") = p."PID"
GROUP BY mc."MID"
HAVING SUM(CASE WHEN TRIM(p."Gender") = 'Female' THEN 0 ELSE 1 END) = 0
LIMIT 20
