    mc."MID",
    SUM(CASE WHEN TRIM(p."Gender") = 'Female' THEN 1 ELSE 0 END)               AS "female_cnt",
    SUM(CASE WHEN TRIM(p."Gender") = 'Female' THEN 0 ELSE 1 END)               AS "non_female_cnt"
FROM "M_Cast" AS mc
JOIN "Person" AS p
  ON TRIM(mc."PID") = p."PID"
GROUP BY mc."MID"
LIMIT 20
