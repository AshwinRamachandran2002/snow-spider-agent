```sql
-- 1️⃣ Description: Peek at some movies to confirm the “year” format we will later extract from.
SELECT "MID", "title", "year"
FROM "Movie"
LIMIT 20;
```

```sql
-- 2️⃣ Description: Inspect a few people to see how the gender values are stored.
SELECT "PID", "Name", "Gender"
FROM "Person"
LIMIT 20;
```

```sql
-- 3️⃣ Description: Join cast → person to view genders attached to actors in a handful of movies.
SELECT "M_Cast"."MID", "M_Cast"."PID", TRIM("Person"."Gender") AS "Gender"
FROM "M_Cast"
JOIN "Person" ON "M_Cast"."PID" = "Person"."PID"
LIMIT 20;
```

```sql
-- 4️⃣ Description: For each movie, count how many cast members are female vs. non‑female.
SELECT 
    "M_Cast"."MID",
    SUM(CASE WHEN TRIM("Person"."Gender") = 'Female' THEN 1 ELSE 0 END)  AS "female_cnt",
    SUM(CASE WHEN TRIM("Person"."Gender") <> 'Female' THEN 1 ELSE 0 END) AS "non_female_cnt"
FROM "M_Cast"
JOIN "Person" ON "M_Cast"."PID" = "Person"."PID"
GROUP BY "M_Cast"."MID"
LIMIT 20;
```

```sql
-- 5️⃣ Description: List movies whose casts are exclusively female (zero non‑female actors).
SELECT DISTINCT "M_Cast"."MID"
FROM "M_Cast"
JOIN "Person" ON "M_Cast"."PID" = "Person"."PID"
GROUP BY "M_Cast"."MID"
HAVING SUM(CASE WHEN TRIM("Person"."Gender") <> 'Female' THEN 1 ELSE 0 END) = 0
LIMIT 20;
```

```sql
-- 6️⃣ Description: Per year, count all movies (total movies that year).
SELECT SUBSTR("year", -4) AS "year", COUNT(*) AS "total_movies"
FROM "Movie"
GROUP BY SUBSTR("year", -4)
ORDER BY "year"
LIMIT 20;
```

```sql
-- 7️⃣ Description: Final answer – for each year, show total movies and the percentage that had exclusively female actors.
SELECT 
    t."year",
    t."total_movies",
    ROUND(100.0 * f."exclusive_female" / t."total_movies", 2) AS "percent_exclusively_female"
FROM
    (SELECT SUBSTR("year", -4) AS "year", COUNT(*) AS "total_movies"
     FROM "Movie"
     GROUP BY SUBSTR("year", -4)) AS t
LEFT JOIN
    (SELECT SUBSTR("Movie"."year", -4) AS "year", COUNT(*) AS "exclusive_female"
     FROM "Movie"
     WHERE "MID" IN (
           SELECT "M_Cast"."MID"
           FROM "M_Cast"
           JOIN "Person"
             ON "M_Cast"."PID" = "Person"."PID"
           GROUP BY "M_Cast"."MID"
           HAVING SUM(CASE WHEN TRIM("Person"."Gender") <> 'Female' THEN 1 ELSE 0 END) = 0
     )
     GROUP BY SUBSTR("Movie"."year", -4)) AS f
  ON t."year" = f."year"
ORDER BY t."year"
LIMIT 20;
```
