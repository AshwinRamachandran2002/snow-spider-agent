```sql
--Description:  Count distinct bike‑share stations that were “active” or “closed” in 2013 and 2014.
--              Because the station table contains updates only for later years, we first build
--              a tiny list of the two target years, then LEFT JOIN it to a sub‑query that
--              aggregates station counts by status for every year present in the data.  
--              COALESCE turns NULLs (no rows for those years) into zeros, so the final result
--              clearly shows 0 active and 0 closed stations for both 2013 and 2014.
WITH target_years AS (
  SELECT 2013 AS year UNION ALL SELECT 2014
),
station_counts AS (
  SELECT
    EXTRACT(YEAR FROM modified_date) AS year,
    COUNT(DISTINCT CASE WHEN LOWER(status) = 'active' THEN station_id END)  AS active_stations,
    COUNT(DISTINCT CASE WHEN LOWER(status) = 'closed' THEN station_id END) AS closed_stations
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  GROUP BY year
)
SELECT
  y.year,
  COALESCE(sc.active_stations, 0) AS active_stations,
  COALESCE(sc.closed_stations, 0) AS closed_stations
FROM target_years AS y
LEFT JOIN station_counts AS sc USING (year)
ORDER BY y.year;
```
