```sql
--Description: 5)  Count distinct stations by status for the year 2013
SELECT `status`,
       COUNT(DISTINCT `station_id`) AS station_count_2013
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM `modified_date`) = 2013
  AND LOWER(`status`) IN ('active','closed')
GROUP BY `status`
LIMIT 20;
```

```sql
--Description: 6)  Count distinct stations by status for the year 2014
SELECT `status`,
       COUNT(DISTINCT `station_id`) AS station_count_2014
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM `modified_date`) = 2014
  AND LOWER(`status`) IN ('active','closed')
GROUP BY `status`
LIMIT 20;
```

```sql
--Description: 7)  Produce one table of year‑by‑status counts for both 2013 and 2014
SELECT EXTRACT(YEAR FROM `modified_date`) AS year,
       `status`,
       COUNT(DISTINCT `station_id`) AS station_count
FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
WHERE EXTRACT(YEAR FROM `modified_date`) IN (2013, 2014)
  AND LOWER(`status`) IN ('active','closed')
GROUP BY year, `status`
ORDER BY year, `status`
LIMIT 20;
```

```sql
--Description: 8)  Final summary → active vs. closed station counts for each year
SELECT year,
       SUM(CASE WHEN LOWER(`status`) = 'active' THEN station_count END) AS active_stations,
       SUM(CASE WHEN LOWER(`status`) = 'closed' THEN station_count END) AS closed_stations
FROM (
  SELECT EXTRACT(YEAR FROM `modified_date`) AS year,
         `status`,
         COUNT(DISTINCT `station_id`) AS station_count
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  WHERE EXTRACT(YEAR FROM `modified_date`) IN (2013, 2014)
    AND LOWER(`status`) IN ('active','closed')
  GROUP BY year, `status`
)
GROUP BY year
ORDER BY year
LIMIT 20;
```
