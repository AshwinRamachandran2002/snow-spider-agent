Query:
--Description: 7)  Year‑by‑status counts for 2013 & 2014, explicitly showing zeros
WITH years AS (SELECT 2013 AS year UNION ALL SELECT 2014),
statuses AS (SELECT 'active' AS status UNION ALL SELECT 'closed'),
year_status AS (
  SELECT y.year, s.status FROM years y CROSS JOIN statuses s
),
counts AS (
  SELECT EXTRACT(YEAR FROM modified_date) AS year,
         LOWER(status) AS status,
         COUNT(DISTINCT station_id) AS station_count
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  GROUP BY year, status
)
SELECT ys.year,
       ys.status,
       COALESCE(c.station_count, 0) AS station_count
FROM year_status AS ys
LEFT JOIN counts AS c
  ON ys.year = c.year AND ys.status = c.status
ORDER BY ys.year, ys.status
LIMIT 20
Answer:
year,status,station_count
2013,active,0
2013,closed,0
2014,active,0
2014,closed,0
Query:
--Description: 8)  Final summary → active vs. closed station counts for 2013 & 2014 (zeros)
WITH target_years AS (SELECT 2013 AS year UNION ALL SELECT 2014),
station_counts AS (
  SELECT
    EXTRACT(YEAR FROM modified_date) AS year,
    COUNT(DISTINCT CASE WHEN LOWER(status) = 'active' THEN station_id END)  AS active_stations,
    COUNT(DISTINCT CASE WHEN LOWER(status) = 'closed' THEN station_id END) AS closed_stations
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  GROUP BY year
)
SELECT
  y.year,
  COALESCE(sc.active_stations, 0) AS active_stations,
  COALESCE(sc.closed_stations, 0) AS closed_stations
FROM target_years AS y
LEFT JOIN station_counts AS sc USING (year)
ORDER BY y.year
Answer:
year,active_stations,closed_stations
2013,0,0
2014,0,0
