Query:
--Description: 5)  Distinct stations by status for year 2013 (returns 0s because no 2013 data)
WITH statuses AS (
  SELECT 'active' AS status UNION ALL SELECT 'closed'
),
counts AS (
  SELECT LOWER(status) AS status,
         COUNT(DISTINCT station_id) AS station_count
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_stations`
  WHERE EXTRACT(YEAR FROM modified_date) = 2013
  GROUP BY LOWER(status)
)
SELECT s.status,
       COALESCE(c.station_count, 0) AS station_count_2013
FROM statuses AS s
LEFT JOIN counts AS c USING (status)
Answer:
status,station_count_2013
active,0
closed,0
