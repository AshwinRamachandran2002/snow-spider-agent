```sql
-- Description: See how many times each actor’s films were rented; sort to find the most‑rented actors  
SELECT fa."actor_id",
       a."first_name",
       a."last_name",
       COUNT(*) AS "rental_count"
FROM "film_actor"  AS fa
JOIN "actor"       AS a ON a."actor_id"  = fa."actor_id"
JOIN "inventory"   AS i ON i."film_id"   = fa."film_id"
JOIN "rental"      AS r ON r."inventory_id" = i."inventory_id"
GROUP BY fa."actor_id"
ORDER BY "rental_count" DESC
LIMIT 20;
```

```sql
-- Description: Grab only the TOP‑5 actors (most rentals) – shows their IDs  
SELECT fa."actor_id"
FROM "film_actor"  AS fa
JOIN "inventory"   AS i ON i."film_id"   = fa."film_id"
JOIN "rental"      AS r ON r."inventory_id" = i."inventory_id"
GROUP BY fa."actor_id"
ORDER BY COUNT(*) DESC
LIMIT 5;
```

```sql
-- Description: List customers (first 20) who rented a film featuring one of those TOP‑5 actors  
SELECT DISTINCT r."customer_id"
FROM   "rental"      AS r
JOIN   "inventory"   AS i  ON i."inventory_id" = r."inventory_id"
JOIN   "film_actor"  AS fa ON fa."film_id"     = i."film_id"
WHERE  fa."actor_id" IN (                         -- TOP‑5 subquery
       SELECT fa2."actor_id"
       FROM   "film_actor"  AS fa2
       JOIN   "inventory"   AS i2 ON i2."film_id" = fa2."film_id"
       JOIN   "rental"      AS r2 ON r2."inventory_id" = i2."inventory_id"
       GROUP BY fa2."actor_id"
       ORDER BY COUNT(*) DESC
       LIMIT 5 )
LIMIT 20;
```

```sql
-- Description: Count DISTINCT customers who have rented at least one TOP‑5‑actor film  
SELECT COUNT(DISTINCT r."customer_id") AS "customers_top5"
FROM   "rental"      AS r
JOIN   "inventory"   AS i  ON i."inventory_id" = r."inventory_id"
JOIN   "film_actor"  AS fa ON fa."film_id"     = i."film_id"
WHERE  fa."actor_id" IN (
       SELECT fa2."actor_id"
       FROM   "film_actor"  AS fa2
       JOIN   "inventory"   AS i2 ON i2."film_id" = fa2."film_id"
       JOIN   "rental"      AS r2 ON r2."inventory_id" = i2."inventory_id"
       GROUP BY fa2."actor_id"
       ORDER BY COUNT(*) DESC
       LIMIT 5 );
```

```sql
-- Description: Total number of DISTINCT customers in the database  
SELECT COUNT(DISTINCT "customer_id") AS "total_customers"
FROM "customer";
```

```sql
-- Description: Calculate the percentage of customers who rented a TOP‑5‑actor film  
SELECT ROUND(100.0 * (
        SELECT COUNT(DISTINCT r."customer_id")
        FROM   "rental"      AS r
        JOIN   "inventory"   AS i  ON i."inventory_id" = r."inventory_id"
        JOIN   "film_actor"  AS fa ON fa."film_id"     = i."film_id"
        WHERE  fa."actor_id" IN (  -- TOP‑5 subquery
               SELECT fa2."actor_id"
               FROM   "film_actor"  AS fa2
               JOIN   "inventory"   AS i2 ON i2."film_id" = fa2."film_id"
               JOIN   "rental"      AS r2 ON r2."inventory_id" = i2."inventory_id"
               GROUP BY fa2."actor_id"
               ORDER BY COUNT(*) DESC
               LIMIT 5 ) ) / 
        (SELECT COUNT(DISTINCT "customer_id") FROM "customer")
      , 2) AS "percentage_customers_top5";
```

