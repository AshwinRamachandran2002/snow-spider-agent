WHERE  fa."actor_id" IN (
       SELECT fa2."actor_id"
       FROM   "film_actor"  AS fa2
       JOIN   "inventory"   AS i2 ON i2."film_id" = fa2."film_id"
       JOIN   "rental"      AS r2 ON r2."inventory_id" = i2."inventory_id"
       GROUP BY fa2."actor_id"
       ORDER BY COUNT(*) DESC
       LIMIT 5 )
LIMIT 20;
```

```sql
-- Description: FINAL answer – show the percentage + counts in one row  
SELECT
    (SELECT COUNT(DISTINCT r."customer_id")
     FROM   "rental"      AS r
     JOIN   "inventory"   AS i  ON i."inventory_id" = r."inventory_id"
     JOIN   "film_actor"  AS fa ON fa."film_id"     = i."film_id"
     WHERE  fa."actor_id" IN (
            SELECT fa2."actor_id"
            FROM   "film_actor"  AS fa2
            JOIN   "inventory"   AS i2 ON i2."film_id" = fa2."film_id"
            JOIN   "rental"      AS r2 ON r2."inventory_id" = i2."inventory_id"
            GROUP BY fa2."actor_id"
            ORDER BY COUNT(*) DESC
            LIMIT 5 )
    ) AS "customers_top5",
    (SELECT COUNT(DISTINCT "customer_id") FROM "customer") AS "total_customers",
    ROUND(100.0 * 
          (SELECT COUNT(DISTINCT r."customer_id")
           FROM   "rental"      AS r
           JOIN   "inventory"   AS i  ON i."inventory_id" = r."inventory_id"
           JOIN   "film_actor"  AS fa ON fa."film_id"     = i."film_id"
           WHERE  fa."actor_id" IN (
                  SELECT fa2."actor_id"
                  FROM   "film_actor"  AS fa2
                  JOIN   "inventory"   AS i2 ON i2."film_id" = fa2."film_id"
                  JOIN   "rental"      AS r2 ON r2."inventory_id" = i2."inventory_id"
                  GROUP BY fa2."actor_id"
                  ORDER BY COUNT(*) DESC
                  LIMIT 5 )
          )
          / (SELECT COUNT(DISTINCT "customer_id") FROM "customer"), 2
    ) AS "percentage_top5_customers";
```
