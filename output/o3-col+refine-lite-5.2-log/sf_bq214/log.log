```sql
--Description: Pull the citing publication_numbers for a handful of focal
--             patents (still US‑B2, 2010‑2014).
SELECT 
    focal."publication_number"          AS "focal_pub",
    citing.value:"publication_number"::STRING  AS "citing_pub"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB focal,
     LATERAL FLATTEN( INPUT => focal."cited_by" ) citing
WHERE focal."publication_number" ILIKE 'US%-%B2'
LIMIT 20;
```

```sql
--Description: Add filing_date of citing patents so we can compute time‑gaps.
SELECT 
    focal."publication_number"                         AS "focal_pub",
    focal_p."filing_date"                              AS "focal_filing",
    citing.value:"publication_number"::STRING          AS "citing_pub",
    citing_p."filing_date"                             AS "citing_filing"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB focal
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS focal_p
  ON focal_p."publication_number" = focal."publication_number"
     AND focal_p."country_code" = 'US'
     AND focal_p."kind_code"    = 'B2'
     AND focal_p."grant_date"  BETWEEN 20100101 AND 20141231
,    LATERAL FLATTEN( INPUT => focal."cited_by" ) citing
LEFT JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS citing_p
       ON citing_p."publication_number" = citing.value:"publication_number"::STRING
LIMIT 20;
```

```sql
--Description: Count how many forward citations occur ≤31 days (≈1 month)
--             after the focal patent’s filing_date.  Raw counts only.
SELECT 
    focal_p."publication_number",
    COUNT(*) AS "forward_cites_within_31d"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB focal
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS focal_p
  ON focal_p."publication_number" = focal."publication_number"
     AND focal_p."country_code" = 'US'
     AND focal_p."kind_code"    = 'B2'
     AND focal_p."grant_date"  BETWEEN 20100101 AND 20141231
,    LATERAL FLATTEN( INPUT => focal."cited_by" ) citing
LEFT JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS citing_p
       ON citing_p."publication_number" = citing.value:"publication_number"::STRING
WHERE citing_p."filing_date" BETWEEN focal_p."filing_date" AND focal_p."filing_date" + 31
GROUP BY focal_p."publication_number"
ORDER BY "forward_cites_within_31d" DESC
LIMIT 20;
```

```sql
--Description: Fetch the embedding vector of the single most‑cited patent
--             (according to previous query) for later similarity work.
SELECT 
    a."publication_number",
    a."embedding_v1",
    p."filing_date"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
  ON p."publication_number" = a."publication_number"
WHERE a."publication_number" = '<TOP_PUB_NUMBER>'   -- replace manually from prior step
LIMIT 20;
```

```sql
--Description: Retrieve embeddings for all other patents filed in the same
--             calendar year as the focal patent (any kind_code).
SELECT 
    a."publication_number",
    a."embedding_v1"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
  ON a."publication_number" = p."publication_number"
WHERE TO_CHAR(p."filing_date",'YYYY') = '<FOCAL_YEAR>'   -- substitute year
  AND p."country_code" = 'US'
LIMIT 20;
```

```sql
--Description: Illustrative similarity query: compute dot‑product between
--             focal vector and its peers from the same year, order by
--             highest similarity.  (Assumes both vectors are arrays of equal length.)
WITH focal AS (
    SELECT a."embedding_v1" AS "vec"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
    WHERE  a."publication_number" = '<TOP_PUB_NUMBER>'   -- substitute
)
SELECT 
    peer."publication_number",
    -- simple dot product via FLATTEN on both vectors
    SUM(f.value::FLOAT * p.value::FLOAT) AS "dot_product"
FROM focal,
     LATERAL FLATTEN( INPUT => focal."vec" ) f,
     PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB peer,
     LATERAL FLATTEN( INPUT => peer."embedding_v1" ) p
WHERE f.index = p.index     -- align vector positions
  AND peer."publication_number" <> '<TOP_PUB_NUMBER>'
  AND peer."publication_number" IN (   -- restrict to same filing year
        SELECT a2."publication_number"
        FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p2
        JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB   a2
          ON a2."publication_number" = p2."publication_number"
        WHERE TO_CHAR(p2."filing_date",'YYYY') = '<FOCAL_YEAR>' )
GROUP BY peer."publication_number"
ORDER BY "dot_product" DESC
LIMIT 20;
```
