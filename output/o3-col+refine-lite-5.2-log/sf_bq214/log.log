```sql
--Description: Count forward citations that occur within 31 days of the focal patent’s filing date.
SELECT 
    focal_p."publication_number",
    COUNT(*) AS "forward_cites_within_31d"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB focal
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS focal_p
  ON focal_p."publication_number" = focal."publication_number"
     AND focal_p."country_code" = 'US'
     AND focal_p."kind_code"    = 'B2'
     AND focal_p."grant_date"  BETWEEN 20100101 AND 20141231
,    LATERAL FLATTEN( INPUT => focal."cited_by" ) citing
LEFT JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS citing_p
       ON citing_p."publication_number" = citing.value:"publication_number"::STRING
WHERE TO_DATE(citing_p."filing_date"::STRING,'YYYYMMDD') BETWEEN 
      TO_DATE(focal_p."filing_date"::STRING,'YYYYMMDD')
  AND DATEADD(day,31,TO_DATE(focal_p."filing_date"::STRING,'YYYYMMDD'))
GROUP BY focal_p."publication_number"
ORDER BY "forward_cites_within_31d" DESC
LIMIT 20;
