```sql
--Description / Thinking process:
-- Aim: obtain the list of distinct filing years for U.S. utility patents (kind_code = 'B2')
--      that were granted between 2010‑2014.
-- Challenges & steps:
--   • "filing_date" is stored as an 8‑digit NUMBER in YYYYMMDD format, so
--     we cannot directly apply TO_CHAR(number,'YYYY').
--   • Solution: cast the number to STRING, convert to DATE with TO_DATE(...,'YYYYMMDD'),
--     then extract the year using TO_CHAR(date,'YYYY').
--   • Use DISTINCT to ensure unique years, and LIMIT to cap the preview at 20 rows.
SELECT DISTINCT
       TO_CHAR(
           TO_DATE(p."filing_date"::STRING, 'YYYYMMDD'),   -- step: numeric → string → date
           'YYYY'                                         -- step: extract four‑digit year
       ) AS "filing_year"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
WHERE p."country_code"     = 'US'
  AND p."kind_code"        = 'B2'
  AND p."application_kind" = 'A'
  AND p."grant_date" BETWEEN 20100101 AND 20141231
LIMIT 20;
```
