--Description / Thinking process:
-- Goal: find patents filed in the same calendar year as US‑7877798‑B2 and measure
--       textual similarity to that focal patent via dot‑product of embeddings.
-- Key issues & fixes
--   • filing_date quality: some rows have 0 or invalid dates → use TRY_TO_DATE()
--     so they become NULL and are excluded.
--   • Need focal year (fy) derived safely from focal’s filing_date.
--   • Compute dot‑product by aligning vector indices with FLATTEN; only patents
--     whose filing year = fy and that differ from the focal patent are compared.
WITH focal_year AS (      -- obtain safe 4‑digit filing year of focal patent
    SELECT TO_CHAR(
             TRY_TO_DATE(p."filing_date"::STRING,'YYYYMMDD'),
             'YYYY'
           ) AS "fy"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    WHERE p."publication_number" = 'US-7877798-B2'
),
focal AS (                -- fetch focal embedding vector
    SELECT a."embedding_v1" AS "vec"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
    WHERE  a."publication_number" = 'US-7877798-B2'
)
SELECT
    peer."publication_number",
    SUM(f.value::FLOAT * p.value::FLOAT) AS "dot_product"
