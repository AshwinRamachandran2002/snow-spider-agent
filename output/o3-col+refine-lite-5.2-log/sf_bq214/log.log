```sql
--Description: Compute dot‑product similarity between focal patent and other U.S. patents
--             from the same filing year, ordering by highest similarity.
WITH focal AS (
    SELECT a."embedding_v1" AS "vec"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
    WHERE  a."publication_number" = '<TOP_PUB_NUMBER>'   -- substitute
)
SELECT 
    peer."publication_number",
    SUM(f.value::FLOAT * p.value::FLOAT) AS "dot_product"
FROM focal,
     LATERAL FLATTEN(INPUT => focal."vec")      f,
     PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB  peer,
     LATERAL FLATTEN(INPUT => peer."embedding_v1") p
WHERE f.index = p.index
  AND peer."publication_number" <> '<TOP_PUB_NUMBER>'
  AND peer."publication_number" IN (
        SELECT a2."publication_number"
        FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p2
        JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a2
          ON a2."publication_number" = p2."publication_number"
        WHERE TO_CHAR(TO_DATE(p2."filing_date"::STRING,'YYYYMMDD'),'YYYY') = '<FOCAL_YEAR>'
          AND p2."country_code" = 'US'
   )
GROUP BY peer."publication_number"
ORDER BY "dot_product" DESC
LIMIT 20;
```
