             TRY_TO_DATE(p0."filing_date"::STRING,'YYYYMMDD'),
             'YYYY'
           ) AS "fy"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p0
    WHERE p0."publication_number" = 'US-7877798-B2'
),
focal AS (                 -- focal embedding vector
    SELECT a0."embedding_v1" AS "vec"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a0
    WHERE  a0."publication_number" = 'US-7877798-B2'
)
SELECT
    peer."publication_number",
    SUM(f.value::FLOAT * p.value::FLOAT) AS "dot_product"
FROM focal
CROSS JOIN LATERAL FLATTEN( INPUT => focal."vec" ) f            -- expand focal vector
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB  peer            -- candidate embeddings
CROSS JOIN LATERAL FLATTEN( INPUT => peer."embedding_v1" ) p    -- expand peer vector
     ON f.index = p.index                                       -- align indices
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS pub             -- peer metadata
     ON pub."publication_number" = peer."publication_number"
JOIN focal_year fy                                              -- match filing year
     ON TO_CHAR(
            TRY_TO_DATE(pub."filing_date"::STRING,'YYYYMMDD'),
            'YYYY'
        ) = fy."fy"
WHERE peer."publication_number" <> 'US-7877798-B2'              -- exclude focal
  AND pub."country_code" = 'US'
  AND TRY_TO_DATE(pub."filing_date"::STRING,'YYYYMMDD') IS NOT NULL
GROUP BY peer."publication_number"
ORDER BY "dot_product" DESC
LIMIT 20;
