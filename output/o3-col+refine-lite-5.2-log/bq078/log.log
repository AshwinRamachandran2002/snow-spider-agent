```sql
--Description: 2) Look only at associations for the disease `EFO_0000676` coming from IMPC.
SELECT *
FROM `bigquery-public-data.open_targets_platform.associationByDatasourceDirect`
WHERE `diseaseId` = 'EFO_0000676'
  AND LOWER(`datasourceId`) = 'impc'
LIMIT 20;
```

```sql
--Description: 3) List the distinct target genes linked to disease `EFO_0000676` by IMPC.
SELECT DISTINCT `targetId`
FROM `bigquery-public-data.open_targets_platform.associationByDatasourceDirect`
WHERE `diseaseId` = 'EFO_0000676'
  AND LOWER(`datasourceId`) = 'impc'
LIMIT 20;
```

```sql
--Description: 4) Show the same associations ordered by their score to see which is highest.
SELECT `targetId`, `score`
FROM `bigquery-public-data.open_targets_platform.associationByDatasourceDirect`
WHERE `diseaseId` = 'EFO_0000676'
  AND LOWER(`datasourceId`) = 'impc'
ORDER BY `score` DESC
LIMIT 20;
```

```sql
--Description: 5) Retrieve the maximal IMPC score for this disease.
SELECT MAX(`score`) AS max_score
FROM `bigquery-public-data.open_targets_platform.associationByDatasourceDirect`
WHERE `diseaseId` = 'EFO_0000676'
  AND LOWER(`datasourceId`) = 'impc';
```

```sql
--Description: 6) Join the targets table to add each gene’s approved symbol and show top‑scoring rows.
SELECT a.`targetId`,
       t.`approvedSymbol`,
       a.`score`
FROM `bigquery-public-data.open_targets_platform.associationByDatasourceDirect` AS a
LEFT JOIN `bigquery-public-data.open_targets_platform.targets`              AS t
       ON a.`targetId` = t.`id`
WHERE a.`diseaseId` = 'EFO_0000676'
  AND LOWER(a.`datasourceId`) = 'impc'
ORDER BY a.`score` DESC
LIMIT 20;
```

```sql
--Description: 7) Return only the gene(s) whose score equals the maximum value found above.
WITH ranked AS (
  SELECT a.`targetId`,
         t.`approvedSymbol`,
         a.`score`,
         RANK() OVER (ORDER BY a.`score` DESC) AS rnk
  FROM `bigquery-public-data.open_targets_platform.associationByDatasourceDirect` AS a
  LEFT JOIN `bigquery-public-data.open_targets_platform.targets`              AS t
         ON a.`targetId` = t.`id`
  WHERE a.`diseaseId` = 'EFO_0000676'
    AND LOWER(a.`datasourceId`) = 'impc'
)
SELECT `approvedSymbol`
FROM ranked
WHERE rnk = 1;
```

```sql
--Description: 8) Same as query 7 but using MAX() instead of window functions.
SELECT DISTINCT t.`approvedSymbol`
FROM `bigquery-public-data.open_targets_platform.associationByDatasourceDirect` AS a
JOIN `bigquery-public-data.open_targets_platform.targets` AS t
  ON a.`targetId` = t.`id`
WHERE a.`diseaseId`   = 'EFO_0000676'
  AND LOWER(a.`datasourceId`) = 'impc'
  AND a.`score` = (
        SELECT MAX(`score`) 
        FROM `bigquery-public-data.open_targets_platform.associationByDatasourceDirect`
        WHERE `diseaseId`   = 'EFO_0000676'
          AND LOWER(`datasourceId`) = 'impc'
      );
```

These queries explore the relevant tables and culminate in retrieving the approved symbol(s) of the target gene(s) that achieve the highest overall IMPC score for disease `EFO_0000676`.
