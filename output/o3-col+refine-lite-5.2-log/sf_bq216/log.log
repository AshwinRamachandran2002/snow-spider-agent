--Description: 8)  Final query ‑ rank ALL 2016 patents by similarity to US‑9741766‑B2 and return the top‑5
WITH base AS (                                   -- focal patent vector
    SELECT f.index AS idx,
           f.value::FLOAT AS v_base
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB  b,
           LATERAL FLATTEN(input => b."embedding_v1") f
    WHERE  b."publication_number" = 'US-9741766-B2'
),
same_year AS (                                   -- every other 2016 patent with an embedding
    SELECT e."publication_number",
           e."embedding_v1"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB  e
    JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
           ON e."publication_number" = p."publication_number"
    WHERE  FLOOR(p."filing_date" / 10000) = 2016
      AND  e."publication_number" <> 'US-9741766-B2'
)
SELECT s."publication_number",
       SUM(b.v_base * sf.value::FLOAT) AS similarity_score
FROM   same_year s,
       LATERAL FLATTEN(input => s."embedding_v1") sf      -- explode candidate vector
JOIN   base b
     ON b.idx = sf.index                                  -- element‑wise product
GROUP  BY s."publication_number"
ORDER  BY similarity_score DESC
LIMIT 5
