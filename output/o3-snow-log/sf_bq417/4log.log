       ROUND(SUM(a."instance_size") / 1000000, 2)                                AS "series_size_mb"
FROM IDC.IDC_V17.DICOM_METADATA m
JOIN IDC.IDC_V17.DICOM_ALL    a
  ON m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE m."StudyDate" > '2014-09-01'
GROUP BY m."PatientID",
         m."PatientSex",
         m."PatientAge",
         m."StudyInstanceUID",
         m."StudyDate",
         m."SeriesInstanceUID",
         m."SeriesDate",
         m."SeriesDescription",
         m."Modality",
         m."Manufacturer",
         m."ManufacturerModelName"
LIMIT 20
