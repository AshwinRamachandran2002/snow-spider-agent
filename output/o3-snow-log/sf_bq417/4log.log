Query:
--Description: 8) Compute the total size (MB) for every series associated with studies that occurred
--strictly after 2014-09-01 (no body-part constraint).  
SELECT
       m."SeriesInstanceUID",
       ROUND(SUM(a."instance_size") / 1000000, 2) AS "series_size_mb"
FROM IDC.IDC_V17.DICOM_METADATA m
JOIN IDC.IDC_V17.DICOM_ALL    a
  ON m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE m."StudyDate" > '2014-09-01'
GROUP BY m."SeriesInstanceUID"
LIMIT 20
