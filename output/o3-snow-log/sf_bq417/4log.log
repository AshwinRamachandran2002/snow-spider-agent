Query:
--Description: 9) Build a convenient S3 wildcard URL (bucket-level) for each series whose
--studies are after 2014-09-01, enabling quick bulk-download checks.  
SELECT DISTINCT
       CONCAT('s3://idc-open-data/', SPLIT_PART("aws_url", '/', 4), '/*') AS "series_aws_url"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "SeriesInstanceUID" IN (
      SELECT "SeriesInstanceUID"
      FROM IDC.IDC_V17.DICOM_METADATA
      WHERE "StudyDate" > '2014-09-01')
LIMIT 20
