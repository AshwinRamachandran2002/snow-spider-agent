--Description: 10) Consolidated view: patient & study identifiers, series-level metadata,
--an S3 wildcard URL, and total series size (MB) for all studies performed after 2014-09-01.  
SELECT DISTINCT
       m."PatientID",
       m."PatientSex",
       m."PatientAge",
       m."StudyInstanceUID",
       m."StudyDate",
       m."SeriesInstanceUID",
       m."SeriesDate",
       m."SeriesDescription",
       m."Modality",
       m."Manufacturer",
       m."ManufacturerModelName",
