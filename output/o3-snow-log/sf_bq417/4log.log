```sql
SELECT
       m."PatientID",
       m."PatientSex",
       m."PatientAge",
       m."StudyInstanceUID",
       m."StudyDate",
       m."SeriesInstanceUID",
       m."SeriesDate",
       m."SeriesDescription",
       m."Modality",
       m."Manufacturer",
       m."ManufacturerModelName",
       m."BodyPartExamined",
       /* bucket-level S3 location for this series */
       CONCAT('s3://idc-open-data/', SPLIT_PART(MIN(a."aws_url"), '/', 4), '/*')  AS "series_aws_url",
       /* total size of all instances in the series (MB, 2-dp) */
       ROUND(SUM(a."instance_size") / 1000000 , 2)                                 AS "series_size_mb"
FROM   IDC.IDC_V17.DICOM_METADATA m
JOIN   IDC.IDC_V17.DICOM_ALL      a
       ON m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  m."PatientSex" = 'M'                                                    -- male patients
  AND  TO_NUMBER(REGEXP_SUBSTR(m."PatientAge", '^[0-9]+')) = 18                -- exactly 18-year-olds
  AND  UPPER(m."BodyPartExamined") = 'MEDIASTINUM'                             -- required body part
  AND  m."StudyDate" > '2014-09-01'                                            -- study date filter
GROUP BY
       m."PatientID",
       m."PatientSex",
       m."PatientAge",
       m."StudyInstanceUID",
       m."StudyDate",
       m."SeriesInstanceUID",
       m."SeriesDate",
       m."SeriesDescription",
       m."Modality",
       m."Manufacturer",
       m."ManufacturerModelName",
       m."BodyPartExamined"
ORDER BY m."StudyDate" NULLS LAST;
```
