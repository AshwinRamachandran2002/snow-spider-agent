Query:
--Description: 8. Aggregate total instance_size per series (still within the cohort) and convert to MB  
SELECT "SeriesInstanceUID",
       ROUND(SUM("instance_size")/1000000, 2) AS "series_size_mb"
FROM "IDC"."IDC_V17"."DICOM_ALL"
WHERE "PatientAge" ILIKE '018%'
  AND "PatientSex" = 'M'
  AND "BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND "StudyDate" > '2014-09-01'
GROUP BY "SeriesInstanceUID"
ORDER BY "series_size_mb" DESC
LIMIT 20;
