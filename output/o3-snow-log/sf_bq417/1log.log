```sql
--Description: 10. Final comprehensive query assembling patient, study, series, storage location, and total size (in MB) for the required cohort  
SELECT  a."PatientID",
        a."PatientSex",
        a."PatientAge",
        a."StudyInstanceUID",
        a."StudyDate",
        a."SeriesInstanceUID",
        a."SeriesDescription",
        a."Modality",
        a."Manufacturer",
        a."ManufacturerModelName",
        ANY_VALUE(a."aws_url")        AS "series_aws_url_example",
        ROUND(SUM(a."instance_size")/1000000, 2) AS "series_size_mb"
FROM    "IDC"."IDC_V17"."DICOM_ALL" a
WHERE   a."PatientAge" ILIKE '018%'
  AND   a."PatientSex" = 'M'
  AND   a."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND   a."StudyDate" > '2014-09-01'
GROUP BY a."PatientID", a."PatientSex", a."PatientAge",
         a."StudyInstanceUID", a."StudyDate", a."SeriesInstanceUID",
         a."SeriesDescription", a."Modality",
         a."Manufacturer", a."ManufacturerModelName"
LIMIT 20;
```
