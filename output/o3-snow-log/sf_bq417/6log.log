```sql
/*  Identification, study & series details, storage location and total size (MB)
    for male patients who are exactly 18 years old, BodyPartExamined = 'MEDIASTINUM',
    and StudyDate  > 2014-09-01                                          */

WITH filtered_meta AS (
    SELECT
        "PatientID",
        "PatientSex",
        "PatientAge",
        "BodyPartExamined",
        "StudyDate",
        "SeriesDate",
        "SeriesDescription",
        "Modality",
        "Manufacturer",
        "ManufacturerModelName",
        "StudyInstanceUID",
        "SeriesInstanceUID"
    FROM "IDC"."IDC_V17"."DICOM_METADATA"
    WHERE  "PatientSex"        = 'M'
       AND TRY_TO_NUMBER(SUBSTR("PatientAge",1,3)) = 18        -- exactly 18 years old
       AND "BodyPartExamined"  = 'MEDIASTINUM'
       AND "StudyDate"         > '2014-09-01'
)

SELECT
    fm."PatientID",
    fm."PatientSex",
    fm."PatientAge",
    fm."StudyInstanceUID",
    fm."SeriesInstanceUID",
    fm."StudyDate",
    fm."SeriesDate",
    fm."SeriesDescription",
    fm."Modality",
    fm."Manufacturer",
    fm."ManufacturerModelName",

    /* series-level AWS location:  s3://idc-open-data/<bucket>/<SeriesInstanceUID>/* */
    's3://idc-open-data/' ||
       REGEXP_SUBSTR(da."aws_url",
                     's3://idc-open-data/([^/]+)/',      -- capture bucket
                      1, 1, 'e', 1) ||
       '/' || fm."SeriesInstanceUID" || '/*'
       AS "series_aws_url",

    /* total size of the series in MB, rounded to two decimals */
    ROUND(SUM(da."instance_size") / 1000000, 2)  AS "series_size_mb"

FROM        filtered_meta                 fm
JOIN        "IDC"."IDC_V17"."DICOM_ALL"   da
       ON   da."SeriesInstanceUID" = fm."SeriesInstanceUID"

GROUP BY
    fm."PatientID",
    fm."PatientSex",
    fm."PatientAge",
    fm."StudyInstanceUID",
    fm."SeriesInstanceUID",
    fm."StudyDate",
    fm."SeriesDate",
    fm."SeriesDescription",
    fm."Modality",
    fm."Manufacturer",
    fm."ManufacturerModelName",
    REGEXP_SUBSTR(da."aws_url",
                  's3://idc-open-data/([^/]+)/', 1, 1, 'e', 1)

ORDER BY fm."StudyDate" NULLS LAST,
         fm."SeriesInstanceUID";
```
