```sql
/*  Series-level details for male patients who are exactly 18 years old,
    BodyPartExamined contains ‘MEDIASTINUM’ (case–insensitive),
    and StudyDate is after 2014-09-01                                      */

WITH filtered_meta AS (
    SELECT
        "PatientID",
        TRIM(UPPER("PatientSex"))        AS "PatientSex",
        "PatientAge",
        TRIM(UPPER("BodyPartExamined"))  AS "BodyPartExamined",
        "StudyDate",
        "SeriesDate",
        "SeriesDescription",
        "Modality",
        "Manufacturer",
        "ManufacturerModelName",
        "StudyInstanceUID",
        "SeriesInstanceUID"
    FROM "IDC"."IDC_V17"."DICOM_METADATA"
    WHERE TRIM(UPPER("PatientSex")) = 'M'
      AND TRY_TO_NUMBER(REGEXP_SUBSTR("PatientAge", '\\d+')) = 18
      AND UPPER("BodyPartExamined") LIKE '%MEDIASTINUM%'
      AND "StudyDate" > '2014-09-01'
)

SELECT
    fm."PatientID",
    fm."PatientSex",
    fm."PatientAge",
    fm."StudyInstanceUID",
    fm."SeriesInstanceUID",
    fm."StudyDate",
    fm."SeriesDate",
    fm."SeriesDescription",
    fm."Modality",
    fm."Manufacturer",
    fm."ManufacturerModelName",

    /* Construct series-level S3 path; may be NULL if no instances in DICOM_ALL */
    CONCAT(
        's3://idc-open-data/',
        REGEXP_SUBSTR(MIN(da."aws_url"), 's3://idc-open-data/([^/]+)/', 1, 1, 'e', 1),
        '/',
        fm."SeriesInstanceUID",
        '/*'
    )                                         AS "series_aws_url",

    ROUND(COALESCE(SUM(da."instance_size"),0) / 1000000, 2)
                                              AS "series_size_mb"
FROM        filtered_meta                    fm
LEFT JOIN   "IDC"."IDC_V17"."DICOM_ALL"      da
       ON   da."SeriesInstanceUID" = fm."SeriesInstanceUID"
GROUP BY
    fm."PatientID",
    fm."PatientSex",
    fm."PatientAge",
    fm."StudyInstanceUID",
    fm."SeriesInstanceUID",
    fm."StudyDate",
    fm."SeriesDate",
    fm."SeriesDescription",
    fm."Modality",
    fm."Manufacturer",
    fm."ManufacturerModelName"
ORDER BY fm."StudyDate" NULLS LAST,
         fm."SeriesInstanceUID";
```
