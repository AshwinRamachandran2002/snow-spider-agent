```sql
--Description: List studies for patients whose age string starts with ‘018’ (exactly 18-year-old) and sex marked as male
SELECT DISTINCT 
       "PatientID",
       "PatientAge",
       "PatientSex",
       "StudyInstanceUID",
       "StudyDate"
FROM "IDC"."IDC_V17"."DICOM_METADATA"
WHERE "PatientAge" ILIKE '018%'            -- exactly 18 years old
  AND "PatientSex" = 'M'
LIMIT 20;
```

```sql
--Description: Narrow the previous result to those cases where BodyPartExamined contains ‘MEDIASTINUM’ (any casing / spelling)
SELECT DISTINCT 
       "PatientID",
       "BodyPartExamined",
       "StudyInstanceUID",
       "SeriesInstanceUID"
FROM "IDC"."IDC_V17"."DICOM_METADATA"
WHERE "PatientAge" ILIKE '018%'
  AND "PatientSex" = 'M'
  AND "BodyPartExamined" ILIKE '%MEDIASTINUM%'
LIMIT 20;
```

```sql
--Description: Add the study-date constraint (strictly after 2014-09-01)
SELECT DISTINCT 
       "PatientID",
       "StudyDate",
       "SeriesInstanceUID",
       "BodyPartExamined"
FROM "IDC"."IDC_V17"."DICOM_METADATA"
WHERE "PatientAge" ILIKE '018%'
  AND "PatientSex" = 'M'
  AND "BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND "StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description: Look at matching rows in the DICOM_ALL table (instance level) for the filtered SeriesInstanceUID values
SELECT DISTINCT 
       da."SeriesInstanceUID",
       da."aws_url",
       da."instance_size",
       da."InstanceNumber"
FROM "IDC"."IDC_V17"."DICOM_ALL"           da
JOIN "IDC"."IDC_V17"."DICOM_METADATA"      dm
     ON da."SeriesInstanceUID" = dm."SeriesInstanceUID"
WHERE dm."PatientAge"       ILIKE '018%'
  AND dm."PatientSex"       = 'M'
  AND dm."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND dm."StudyDate"        > '2014-09-01'
LIMIT 20;
```

```sql
--Description: Check how many instances (slices / frames) are stored per series for the cohort of interest
SELECT 
       da."SeriesInstanceUID",
       COUNT(*)  AS "instance_cnt"
FROM "IDC"."IDC_V17"."DICOM_ALL"           da
JOIN "IDC"."IDC_V17"."DICOM_METADATA"      dm
     ON da."SeriesInstanceUID" = dm."SeriesInstanceUID"
WHERE dm."PatientAge"       ILIKE '018%'
  AND dm."PatientSex"       = 'M'
  AND dm."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND dm."StudyDate"        > '2014-09-01'
GROUP BY da."SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: Preview partial aggregation – compute total byte size per series and convert to MB (divide by 1 000 000 & round)
SELECT 
       da."SeriesInstanceUID",
       ROUND(SUM(da."instance_size") / 1000000, 2) AS "series_size_mb"
FROM "IDC"."IDC_V17"."DICOM_ALL"           da
JOIN "IDC"."IDC_V17"."DICOM_METADATA"      dm
     ON da."SeriesInstanceUID" = dm."SeriesInstanceUID"
WHERE dm."PatientAge"       ILIKE '018%'
  AND dm."PatientSex"       = 'M'
  AND dm."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND dm."StudyDate"        > '2014-09-01'
GROUP BY da."SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: Final query – identification, study & series context, AWS storage path, and total size in MB for each qualifying series
SELECT 
       dm."PatientID"                                   AS "patient_id",
       dm."PatientAge"                                  AS "patient_age",
       dm."PatientSex"                                  AS "patient_sex",
       dm."StudyInstanceUID"                            AS "study_uid",
       dm."StudyDate"                                   AS "study_date",
       dm."SeriesInstanceUID"                           AS "series_uid",
       dm."SeriesDescription"                           AS "series_description",
       dm."Modality"                                    AS "modality",
       dm."Manufacturer"                                AS "manufacturer",
       dm."ManufacturerModelName"                       AS "manufacturer_model",
       da."aws_url"                                     AS "any_instance_aws_url",
       ROUND(SUM(da."instance_size") / 1000000, 2)      AS "series_size_mb"
FROM "IDC"."IDC_V17"."DICOM_METADATA" dm
JOIN "IDC"."IDC_V17"."DICOM_ALL"      da
     ON da."SeriesInstanceUID" = dm."SeriesInstanceUID"
WHERE dm."PatientAge"       ILIKE '018%'               -- exactly 18 years old
  AND dm."PatientSex"       = 'M'                      -- male patients
  AND dm."BodyPartExamined" ILIKE '%MEDIASTINUM%'      -- correct body part
  AND dm."StudyDate"        > '2014-09-01'             -- study strictly after 1 Sep 2014
GROUP BY 
       dm."PatientID",
       dm."PatientAge",
       dm."PatientSex",
       dm."StudyInstanceUID",
       dm."StudyDate",
       dm."SeriesInstanceUID",
       dm."SeriesDescription",
       dm."Modality",
       dm."Manufacturer",
       dm."ManufacturerModelName",
       da."aws_url"
LIMIT 20;
```
