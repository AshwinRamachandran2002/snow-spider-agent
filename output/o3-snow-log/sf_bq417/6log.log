        "Modality",
        "Manufacturer",
        "ManufacturerModelName",
        "StudyInstanceUID",
        "SeriesInstanceUID"
    FROM "IDC"."IDC_V17"."DICOM_METADATA"
    WHERE TRIM(UPPER("PatientSex")) = 'M'
      AND TRY_TO_NUMBER(REGEXP_SUBSTR("PatientAge", '\\d+')) = 18
      AND TRIM(UPPER("BodyPartExamined")) = 'MEDIASTINUM'
      AND "StudyDate" > '2014-09-01'
)

SELECT
