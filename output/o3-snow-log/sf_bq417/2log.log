       ROUND(SUM(a."instance_size") / 1000000.0, 2) AS "series_size_mb",
       REGEXP_REPLACE(SPLIT_PART(a."aws_url", '/', 1), '^s3://', 's3://')
            || '/' || m."SeriesInstanceUID" || '/*' AS "series_aws_url"
FROM   "IDC"."IDC_V17"."DICOM_METADATA" m
JOIN   "IDC"."IDC_V17"."DICOM_ALL"      a
  ON   m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  m."PatientSex" = 'M'
GROUP  BY
       m."PatientID",
       m."PatientSex",
       m."PatientAge",
       m."StudyInstanceUID",
       m."StudyDate",
       m."SeriesInstanceUID",
       m."SeriesDescription",
       m."SeriesDate",
       m."Modality",
       m."Manufacturer",
       m."ManufacturerModelName",
       REGEXP_REPLACE(SPLIT_PART(a."aws_url", '/', 1), '^s3://', 's3://')
            || '/' || m."SeriesInstanceUID" || '/*'
LIMIT 20;
