```sql
--Description: 7) Examine corresponding rows in DICOM_ALL for those same SeriesInstanceUIDs
SELECT DISTINCT
       a."SeriesInstanceUID",
       a."aws_url",
       a."instance_size",
       a."Modality",
       a."BodyPartExamined"
FROM   "IDC"."IDC_V17"."DICOM_ALL"      a
JOIN   "IDC"."IDC_V17"."DICOM_METADATA" m
  ON   a."SeriesInstanceUID" = m."SeriesInstanceUID"
WHERE  m."PatientSex"             = 'M'
  AND  SUBSTR(m."PatientAge",1,3) = '018'
  AND  m."BodyPartExamined"       ILIKE '%MEDIASTINUM%'
  AND  m."StudyDate"              > '2014-09-01'
LIMIT 20;
```

```sql
--Description: 8) Aggregate the total instance_size (bytes) for each qualifying series
SELECT
       a."SeriesInstanceUID",
       SUM(a."instance_size") AS "total_bytes"
FROM   "IDC"."IDC_V17"."DICOM_ALL"      a
JOIN   "IDC"."IDC_V17"."DICOM_METADATA" m
  ON   a."SeriesInstanceUID" = m."SeriesInstanceUID"
WHERE  m."PatientSex"             = 'M'
  AND  SUBSTR(m."PatientAge",1,3) = '018'
  AND  m."BodyPartExamined"       ILIKE '%MEDIASTINUM%'
  AND  m."StudyDate"              > '2014-09-01'
GROUP  BY a."SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 9) Convert the byte totals from query 8 to megabytes (rounded) for each series
SELECT
       "SeriesInstanceUID",
       ROUND("total_bytes" / 1000000.0, 2) AS "series_size_mb"
FROM (
      SELECT
             a."SeriesInstanceUID",
             SUM(a."instance_size") AS "total_bytes"
      FROM   "IDC"."IDC_V17"."DICOM_ALL"      a
      JOIN   "IDC"."IDC_V17"."DICOM_METADATA" m
        ON   a."SeriesInstanceUID" = m."SeriesInstanceUID"
      WHERE  m."PatientSex"             = 'M'
        AND  SUBSTR(m."PatientAge",1,3) = '018'
        AND  m."BodyPartExamined"       ILIKE '%MEDIASTINUM%'
        AND  m."StudyDate"              > '2014-09-01'
      GROUP  BY a."SeriesInstanceUID"
     )
LIMIT 20;
```

```sql
--Description: 10) Retrieve all required identification, study, series and storage details—including size in MB—for the target cohort
SELECT
       m."PatientID",
       m."PatientSex",
       m."PatientAge",
       m."StudyInstanceUID",
       m."StudyDate",
       m."SeriesInstanceUID",
       m."SeriesDescription",
       m."SeriesDate",
       m."Modality",
       m."Manufacturer",
       m."ManufacturerModelName",
       ROUND(SUM(a."instance_size") / 1000000.0, 2) AS "series_size_mb",
       REGEXP_REPLACE(SPLIT_PART(a."aws_url", '/', 1), '^s3://', 's3://') 
            || '/' || m."SeriesInstanceUID" || '/*'             AS "series_aws_url"
FROM   "IDC"."IDC_V17"."DICOM_METADATA" m
JOIN   "IDC"."IDC_V17"."DICOM_ALL"      a
  ON   m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  m."PatientSex"             = 'M'
  AND  SUBSTR(m."PatientAge",1,3) = '018'
  AND  m."BodyPartExamined"       ILIKE '%MEDIASTINUM%'
  AND  m."StudyDate"              > '2014-09-01'
GROUP  BY
       m."PatientID",
       m."PatientSex",
       m."PatientAge",
       m."StudyInstanceUID",
       m."StudyDate",
       m."SeriesInstanceUID",
       m."SeriesDescription",
       m."SeriesDate",
       m."Modality",
       m."Manufacturer",
       m."ManufacturerModelName",
       REGEXP_REPLACE(SPLIT_PART(a."aws_url", '/', 1), '^s3://', 's3://') 
            || '/' || m."SeriesInstanceUID" || '/*'
LIMIT 20;
```
