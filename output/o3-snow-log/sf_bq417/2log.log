WITH series_totals AS (
    SELECT
           m."SeriesInstanceUID",
           SUM(a."instance_size")               AS total_bytes,
           MIN(a."aws_url")                     AS sample_url
    FROM   "IDC"."IDC_V17"."DICOM_METADATA" m
    JOIN   "IDC"."IDC_V17"."DICOM_ALL"      a
      ON   m."SeriesInstanceUID" = a."SeriesInstanceUID"
    WHERE  m."PatientSex" = 'M'
      AND  TO_NUMBER(REGEXP_SUBSTR(m."PatientAge", '[0-9]+')) = 18
      AND  UPPER(TRIM(m."BodyPartExamined")) = 'MEDIASTINUM'
      AND  m."StudyDate" > '2014-09-01'
    GROUP  BY m."SeriesInstanceUID"
)

SELECT DISTINCT
       m."PatientID",
       m."PatientSex",
       m."PatientAge",
       m."StudyInstanceUID",
       m."StudyDate",
       m."SeriesInstanceUID",
       m."SeriesDescription",
       m."SeriesDate",
