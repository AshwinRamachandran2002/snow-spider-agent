  ON   m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  m."PatientSex" = 'M'
GROUP  BY
       m."PatientID",
       m."PatientSex",
       m."PatientAge",
       m."StudyInstanceUID",
       m."StudyDate",
       m."SeriesInstanceUID",
