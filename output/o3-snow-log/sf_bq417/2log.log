            || '/' || m."SeriesInstanceUID" || '/*'                                      AS "series_aws_url"
FROM   series_totals                               t
JOIN   "IDC"."IDC_V17"."DICOM_METADATA"            m
  ON   m."SeriesInstanceUID" = t."SeriesInstanceUID"
ORDER  BY m."PatientID";
