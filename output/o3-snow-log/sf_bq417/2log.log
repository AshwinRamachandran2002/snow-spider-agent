WITH filtered AS (
    SELECT
           m."SeriesInstanceUID",
           m."PatientID",
           m."PatientSex",
           m."PatientAge",
           m."StudyInstanceUID",
           m."StudyDate",
           m."SeriesDescription",
           m."SeriesDate",
           m."Modality",
           m."Manufacturer",
           m."ManufacturerModelName",
           a."aws_url",
           a."instance_size"
    FROM   "IDC"."IDC_V17"."DICOM_METADATA" m
    JOIN   "IDC"."IDC_V17"."DICOM_ALL"      a
      ON   m."SeriesInstanceUID" = a."SeriesInstanceUID"
    WHERE  TRIM(m."PatientSex") = 'M'
      AND  TO_NUMBER(REGEXP_REPLACE(m."PatientAge", '[^0-9]', '')) = 18
      AND  TRIM(m."BodyPartExamined") = 'MEDIASTINUM'
      AND  m."StudyDate" > '2014-09-01'
)

SELECT
       MAX("PatientID")                  AS "PatientID",
       MAX("PatientSex")                 AS "PatientSex",
       MAX("PatientAge")                 AS "PatientAge",
       MAX("StudyInstanceUID")           AS "StudyInstanceUID",
       MAX("StudyDate")                  AS "StudyDate",
       "SeriesInstanceUID",
       MAX("SeriesDescription")          AS "SeriesDescription",
       MAX("SeriesDate")                 AS "SeriesDate",
       MAX("Modality")                   AS "Modality",
       MAX("Manufacturer")               AS "Manufacturer",
       MAX("ManufacturerModelName")      AS "ManufacturerModelName",
       ROUND(SUM("instance_size") / 1000000.0, 4)              AS "series_size_mb",
       REGEXP_REPLACE(
           SPLIT_PART(MAX("aws_url"), '/', 1),
           '^s3://',
           's3://'
       ) || '/' || "SeriesInstanceUID" || '/*'                 AS "series_aws_url"
FROM   filtered
GROUP  BY "SeriesInstanceUID"
ORDER  BY "PatientID";
