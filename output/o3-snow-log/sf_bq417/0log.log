Query:
--Description: Join metadata with instance-level table for CHEST series and compute total series size in MB (exploratory, no sex/age/date filters yet).
SELECT
  m."SeriesInstanceUID",
  ROUND(SUM(a."instance_size") / 1000000.0, 2) AS "series_size_mb"
FROM IDC.IDC_V17.DICOM_METADATA m
JOIN IDC.IDC_V17.DICOM_ALL     a
  ON m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE m."BodyPartExamined" = 'CHEST'
GROUP BY m."SeriesInstanceUID"
LIMIT 20
