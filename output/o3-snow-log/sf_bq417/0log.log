        a."aws_url",
        a."instance_size"
    FROM IDC.IDC_V17.DICOM_METADATA m
    LEFT JOIN IDC.IDC_V17.DICOM_ALL a
           ON m."SeriesInstanceUID" = a."SeriesInstanceUID"
    WHERE REGEXP_LIKE(UPPER(TRIM(m."BodyPartExamined")), 'MEDIAST')      -- matches MEDIASTINUM / MEDIASTINAL …
      AND TRIM(m."PatientSex")                     = 'M'                  -- male patients
      AND TO_NUMBER(REGEXP_SUBSTR(m."PatientAge", '\\d+')) = 18           -- exactly 18 years old
      AND m."StudyDate"                            > DATE '2014-09-01'    -- study date strictly after 1 Sep 2014
)
SELECT
    "PatientID",
    "PatientSex",
    "PatientAge",
    "BodyPartExamined",
    "StudyDate",
    "SeriesDate",
    "StudyInstanceUID",
    "SeriesInstanceUID",
    "SeriesDescription",
    MIN("aws_url")                                   AS "sample_instance_aws_url",
    ROUND(COALESCE(SUM("instance_size"),0) / 1000000.0 , 2) AS "series_size_mb"
FROM filtered
GROUP BY
    "PatientID",
    "PatientSex",
    "PatientAge",
    "BodyPartExamined",
    "StudyDate",
    "SeriesDate",
    "StudyInstanceUID",
    "SeriesInstanceUID",
    "SeriesDescription"
ORDER BY
    "PatientID",
    "SeriesInstanceUID";
