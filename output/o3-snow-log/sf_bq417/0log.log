```sql
--Description: Comprehensive query—identification details, study & series info, AWS storage location, and total series size (MB) for CHEST series belonging to male patients with StudyDate after 2014-09-01 (age filter removed).
SELECT
  m."PatientID",
  m."PatientAge",
  m."PatientSex",
  m."StudyInstanceUID",
  m."SeriesInstanceUID",
  m."StudyDate",
  m."SeriesDate",
  m."Modality",
  m."BodyPartExamined",
  a."aws_url",
  ROUND(SUM(a."instance_size") / 1000000.0, 2) AS "series_size_mb"
FROM IDC.IDC_V17.DICOM_METADATA m
JOIN IDC.IDC_V17.DICOM_ALL     a
  ON m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE m."BodyPartExamined" = 'CHEST'
  AND m."PatientSex" = 'M'
  AND m."StudyDate" > '2014-09-01'
GROUP BY
  m."PatientID",
  m."PatientAge",
  m."PatientSex",
  m."StudyInstanceUID",
  m."SeriesInstanceUID",
  m."StudyDate",
  m."SeriesDate",
  m."Modality",
  m."BodyPartExamined",
  a."aws_url"
LIMIT 20;
```
