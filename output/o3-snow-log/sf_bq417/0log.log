```sql
-- Description: Join metadata with instance-level table for MEDIASTINUM and tally instance sizes per series (no age/sex/date filters yet)
SELECT 
  m."SeriesInstanceUID",
  SUM(a."instance_size") / 1000000.0 AS "series_size_mb"
