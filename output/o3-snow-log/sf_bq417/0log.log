      AND m."PatientSex"                   = 'M'                    -- male patients
      AND TO_NUMBER(REGEXP_SUBSTR(m."PatientAge", '\\d+')) = 18     -- exactly 18 years old
      AND m."StudyDate"                    > DATE '2014-09-01'      -- study date after 1 Sep 2014
)
SELECT
