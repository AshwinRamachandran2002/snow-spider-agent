```sql
/*  Series–level report for male patients who are exactly 18 years old,
    BodyPartExamined = 'MEDIASTINUM', and StudyDate > 2014-09-01            */

WITH candidate_series AS (      -- 1.  Filter series in the metadata table
    SELECT  dm."PatientID",
            dm."PatientSex",
            dm."PatientAge",
            dm."StudyDate",
            dm."StudyInstanceUID",
            dm."SeriesInstanceUID",
            dm."SeriesDescription",
            dm."Modality",
            dm."Manufacturer",
            dm."ManufacturerModelName"
    FROM    "IDC"."IDC_V17"."DICOM_METADATA"  dm
    WHERE   dm."PatientSex" = 'M'                                   -- male
      AND   TRY_TO_NUMBER(REPLACE(dm."PatientAge",'Y','')) = 18     -- exactly 18 Y
      AND   UPPER(dm."BodyPartExamined") = 'MEDIASTINUM'            -- body part
      AND   dm."StudyDate" > '2014-09-01'                           -- date filter
)

SELECT  cs."PatientID",
        cs."PatientSex",
        cs."PatientAge",
        cs."StudyDate",
        cs."StudyInstanceUID",
        cs."SeriesInstanceUID",
        cs."SeriesDescription",
        cs."Modality",
        cs."Manufacturer",
        cs."ManufacturerModelName",
        ROUND(SUM(da."instance_size")/1000000,2)    AS "series_size_mb",   -- total size
        MIN(da."aws_url")                           AS "series_aws_url"   -- sample storage URL
FROM        candidate_series                 cs
JOIN        "IDC"."IDC_V17"."DICOM_ALL"      da
       ON   cs."SeriesInstanceUID" = da."SeriesInstanceUID"
GROUP BY    cs."PatientID",
            cs."PatientSex",
            cs."PatientAge",
            cs."StudyDate",
            cs."StudyInstanceUID",
            cs."SeriesInstanceUID",
            cs."SeriesDescription",
            cs."Modality",
            cs."Manufacturer",
            cs."ManufacturerModelName"
ORDER BY    cs."PatientID", cs."SeriesInstanceUID";
```
