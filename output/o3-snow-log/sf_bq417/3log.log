WHERE "PatientSex" = 'M'
  AND (SUBSTR("PatientAge",1,3) = '018' OR SUBSTR("PatientAge",1,2) = '18')
  AND "BodyPartExamined" = 'MEDIASTINUM'
  AND "StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description:  Inspect instance-level storage information for those series
SELECT da."SeriesInstanceUID",
       da."aws_url",
       da."instance_size"
FROM "IDC"."IDC_V17"."DICOM_ALL" da
WHERE da."SeriesInstanceUID" IN (
      SELECT DISTINCT "SeriesInstanceUID"
      FROM "IDC"."IDC_V17"."DICOM_METADATA"
      WHERE "PatientSex" = 'M'
        AND (SUBSTR("PatientAge",1,3) = '018' OR SUBSTR("PatientAge",1,2) = '18')
        AND "BodyPartExamined" = 'MEDIASTINUM'
        AND "StudyDate" > '2014-09-01')
LIMIT 20;
```

```sql
--Description:  Join metadata with instance details to see patient-, study-, and storage-level information together
SELECT dm."PatientID",
       dm."PatientSex",
       dm."PatientAge",
       dm."StudyDate",
       dm."SeriesDescription",
       dm."SeriesInstanceUID",
       da."aws_url",
       da."instance_size"
FROM "IDC"."IDC_V17"."DICOM_METADATA" dm
JOIN "IDC"."IDC_V17"."DICOM_ALL"     da
  ON dm."SeriesInstanceUID" = da."SeriesInstanceUID"
WHERE dm."PatientSex" = 'M'
  AND (SUBSTR(dm."PatientAge",1,3) = '018' OR SUBSTR(dm."PatientAge",1,2) = '18')
  AND dm."BodyPartExamined" = 'MEDIASTINUM'
  AND dm."StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description:  Compute the total byte size per series for the target cohort
SELECT da."SeriesInstanceUID",
       SUM(da."instance_size") AS "total_size_bytes"
FROM "IDC"."IDC_V17"."DICOM_ALL" da
WHERE da."SeriesInstanceUID" IN (
      SELECT DISTINCT "SeriesInstanceUID"
      FROM "IDC"."IDC_V17"."DICOM_METADATA"
      WHERE "PatientSex" = 'M'
        AND (SUBSTR("PatientAge",1,3) = '018' OR SUBSTR("PatientAge",1,2) = '18')
        AND "BodyPartExamined" = 'MEDIASTINUM'
        AND "StudyDate" > '2014-09-01')
GROUP BY da."SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description:  Convert the total byte size to megabytes (rounded to two decimals)
SELECT "SeriesInstanceUID",
       ROUND("total_size_bytes"/1000000,2) AS "series_size_mb"
FROM (
      SELECT da."SeriesInstanceUID",
             SUM(da."instance_size") AS "total_size_bytes"
      FROM "IDC"."IDC_V17"."DICOM_ALL" da
      WHERE da."SeriesInstanceUID" IN (
            SELECT DISTINCT "SeriesInstanceUID"
            FROM "IDC"."IDC_V17"."DICOM_METADATA"
            WHERE "PatientSex" = 'M'
              AND (SUBSTR("PatientAge",1,3) = '018' OR SUBSTR("PatientAge",1,2) = '18')
              AND "BodyPartExamined" = 'MEDIASTINUM'
              AND "StudyDate" > '2014-09-01')
      GROUP BY da."SeriesInstanceUID")
LIMIT 20;
```

```sql
--Description:  Produce a series-level report with patient, study, equipment, and total size (in MB)
SELECT dm."PatientID",
       dm."PatientSex",
       dm."PatientAge",
       dm."StudyDate",
       dm."StudyInstanceUID",
       dm."SeriesInstanceUID",
       dm."SeriesDescription",
       dm."Modality",
       dm."Manufacturer",
       dm."ManufacturerModelName",
       ROUND(SUM(da."instance_size")/1000000,2) AS "series_size_mb"
FROM "IDC"."IDC_V17"."DICOM_METADATA" dm
JOIN "IDC"."IDC_V17"."DICOM_ALL"     da
  ON dm."SeriesInstanceUID" = da."SeriesInstanceUID"
WHERE dm."PatientSex" = 'M'
  AND (SUBSTR(dm."PatientAge",1,3) = '018' OR SUBSTR(dm."PatientAge",1,2) = '18')
  AND dm."BodyPartExamined" = 'MEDIASTINUM'
  AND dm."StudyDate" > '2014-09-01'
GROUP BY dm."PatientID",
         dm."PatientSex",
         dm."PatientAge",
         dm."StudyDate",
         dm."StudyInstanceUID",
         dm."SeriesInstanceUID",
         dm."SeriesDescription",
         dm."Modality",
         dm."Manufacturer",
         dm."ManufacturerModelName"
LIMIT 20;
```

