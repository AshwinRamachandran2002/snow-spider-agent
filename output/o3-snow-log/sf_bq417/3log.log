/*  Series-level report for male patients who are exactly 18 years old,
    BodyPartExamined = ‘MEDIASTINUM’, and StudyDate > 2014-09-01            */

WITH candidate_series AS (
    SELECT  dm."PatientID",
            dm."PatientSex",
            dm."PatientAge",
            dm."StudyDate",
            dm."StudyInstanceUID",
            dm."SeriesInstanceUID",
            dm."SeriesDescription",
            dm."Modality",
            dm."Manufacturer",
            dm."ManufacturerModelName"
    FROM    "IDC"."IDC_V17"."DICOM_METADATA" dm
    WHERE   dm."PatientSex" = 'M'
      AND   TRY_TO_NUMBER( REGEXP_REPLACE(dm."PatientAge", '[^0-9]', '') ) = 18
      AND   UPPER(COALESCE(dm."BodyPartExamined", '')) = 'MEDIASTINUM'
      AND   dm."StudyDate" > '2014-09-01'
)

