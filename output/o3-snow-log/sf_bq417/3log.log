      GROUP BY dm."PatientID",
               dm."PatientSex",
               dm."PatientAge",
               dm."StudyDate",
               dm."StudyInstanceUID",
               dm."SeriesInstanceUID",
               dm."SeriesDescription",
               dm."Modality",
