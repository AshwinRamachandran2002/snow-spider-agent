```sql
--Description: Pull metadata rows that already meet ALL core filters  
--              (male, exactly 18 Y, mediastinum, study after 2014-09-01)
SELECT *
FROM IDC.IDC_V17.DICOM_METADATA m
WHERE m."PatientSex" = 'M'
