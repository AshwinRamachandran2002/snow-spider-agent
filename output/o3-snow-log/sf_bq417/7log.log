  AND m."StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description: Join the matching metadata rows to DICOM_ALL  
--              to obtain storage location and instance-level details
SELECT a."aws_url",
       a."instance_size",
       a."SeriesInstanceUID",
       a."PatientID",
       a."InstanceNumber"
FROM IDC.IDC_V17.DICOM_ALL            a
JOIN IDC.IDC_V17.DICOM_METADATA       m
  ON a."SeriesInstanceUID" = m."SeriesInstanceUID"
WHERE m."PatientSex" = 'M'
  AND m."PatientAge" = '018Y'
  AND m."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND m."StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description: Aggregate instance sizes to compute total size (MB) per Series
SELECT a."SeriesInstanceUID",
       ROUND(SUM(a."instance_size") / 1000000, 2) AS "series_size_MB",
       COUNT(*)                              AS "instance_count"
FROM IDC.IDC_V17.DICOM_ALL            a
JOIN IDC.IDC_V17.DICOM_METADATA       m
  ON a."SeriesInstanceUID" = m."SeriesInstanceUID"
WHERE m."PatientSex" = 'M'
  AND m."PatientAge" = '018Y'
  AND m."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND m."StudyDate" > '2014-09-01'
GROUP BY a."SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: Final query – identification, study & series info, storage location,
--             and total series size (MB) for male patients exactly 18 Y,
--             mediastinum exams, study date > 2014-09-01
SELECT m."PatientID",
       m."PatientSex",
       m."PatientAge",
       m."StudyInstanceUID",
       m."StudyDate",
       m."SeriesInstanceUID",
       m."SeriesDescription",
       m."Modality",
       m."Manufacturer",
       m."ManufacturerModelName",
       a."aws_url",
       ROUND(SUM(a."instance_size") / 1000000, 2) AS "series_size_MB"
FROM IDC.IDC_V17.DICOM_METADATA       m
JOIN IDC.IDC_V17.DICOM_ALL            a
  ON a."SeriesInstanceUID" = m."SeriesInstanceUID"
WHERE m."PatientSex" = 'M'
  AND m."PatientAge" = '018Y'
  AND m."BodyPartExamined" ILIKE '%MEDIASTINUM%'
  AND m."StudyDate" > '2014-09-01'
GROUP BY m."PatientID",
         m."PatientSex",
         m."PatientAge",
         m."StudyInstanceUID",
         m."StudyDate",
         m."SeriesInstanceUID",
         m."SeriesDescription",
         m."Modality",
         m."Manufacturer",
         m."ManufacturerModelName",
         a."aws_url"
LIMIT 20;
```
