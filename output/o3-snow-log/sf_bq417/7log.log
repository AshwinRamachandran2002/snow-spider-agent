```sql
/*  Identification details, study & series information, storage location
    and total size (MB) for male, exactly-18-year-old patients whose
    mediastinum studies were performed after 2014-09-01                */

WITH series_filtered AS (
    SELECT
        a."PatientID",
        m."StudyInstanceUID",
        a."SeriesInstanceUID",
        a."StudyDate",
        a."SeriesDate",
        a."Modality",
        a."SeriesDescription",
        a."Manufacturer",
        a."ManufacturerModelName",
        a."instance_size",
        /* extract bucket name appearing right after 's3://'            */
        REGEXP_SUBSTR(a."aws_url", 's3://([^/]+)/', 1, 1, 'e', 1)      AS bucket
    FROM  IDC.IDC_V17.DICOM_ALL       a
    JOIN  IDC.IDC_V17.DICOM_METADATA  m
          ON a."SeriesInstanceUID" = m."SeriesInstanceUID"
    WHERE a."PatientSex"   = 'M'
      AND TRY_TO_NUMBER( REGEXP_SUBSTR(a."PatientAge", '([0-9]+)') ) = 18   -- exactly 18 years
      AND a."BodyPartExamined" = 'MEDIASTINUM'
      AND a."StudyDate"  > '2014-09-01'
)

SELECT
    "PatientID",
    "StudyInstanceUID",
    "SeriesInstanceUID",
    "StudyDate",
    "SeriesDate",
    "Modality",
    "SeriesDescription",
    "Manufacturer",
    "ManufacturerModelName",
    /* construct series–level AWS location                             */
    's3://' || bucket || '/' || "SeriesInstanceUID" || '/*'  AS "Series_AWS_URL",
    ROUND( SUM("instance_size") / 1000000 , 2)               AS "Series_Size_MB"
FROM series_filtered
GROUP BY
      "PatientID",
      "StudyInstanceUID",
      "SeriesInstanceUID",
      "StudyDate",
      "SeriesDate",
      "Modality",
      "SeriesDescription",
      "Manufacturer",
      "ManufacturerModelName",
      bucket
ORDER BY "Series_Size_MB" DESC NULLS LAST;
```
