        COALESCE(a."PatientID",           m."PatientID")            AS "PatientID",
        COALESCE(a."PatientSex",          m."PatientSex")           AS "PatientSex",
        COALESCE(a."PatientAge",          m."PatientAge")           AS "PatientAge",
        COALESCE(a."BodyPartExamined",    m."BodyPartExamined")     AS "BodyPartExamined",
        a."StudyDate",
        m."StudyInstanceUID",
        a."SeriesInstanceUID",
        a."SeriesDate",
        a."Modality",
        a."SeriesDescription",
        a."Manufacturer",
        a."ManufacturerModelName",
        a."instance_size",
        a."aws_url"
    FROM IDC.IDC_V17.DICOM_ALL      a
