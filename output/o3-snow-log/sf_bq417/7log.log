```sql
/*  Study- and series-level details for male patients who are
    exactly 18 years old, whose BodyPartExamined is “MEDIASTINUM”
    and whose StudyDate is after 2014-09-01.  Includes a series-level
    AWS S3 path and the total series size in MB.                       */

/* --- 1.  Identify all series that meet the clinical criteria ------- */
WITH eligible_series AS (          -- from the metadata table only
    SELECT
        "PatientID",
        "StudyInstanceUID",
        "SeriesInstanceUID",
        "StudyDate",
        "SeriesDate",
        "BodyPartExamined"
    FROM  IDC.IDC_V17.DICOM_METADATA
    WHERE TRIM("PatientSex") = 'M'
      AND TRY_TO_NUMBER( REGEXP_SUBSTR("PatientAge", '([0-9]+)') ) = 18   -- exactly 18 Y
      AND TRIM(UPPER("BodyPartExamined")) = 'MEDIASTINUM'
      AND "StudyDate" > '2014-09-01'
),

/* --- 2.  Aggregate per-series technical details & total size ------- */
series_details AS (
    SELECT
        "SeriesInstanceUID",
        MAX("Modality")                  AS "Modality",
        MAX("SeriesDescription")         AS "SeriesDescription",
        MAX("Manufacturer")              AS "Manufacturer",
        MAX("ManufacturerModelName")     AS "ManufacturerModelName",
        REGEXP_SUBSTR( MIN("aws_url"), 's3://([^/]+)/', 1, 1, 'e', 1 ) AS bucket,
        SUM("instance_size")             AS total_bytes
    FROM IDC.IDC_V17.DICOM_ALL
    GROUP BY "SeriesInstanceUID"
)

/* --- 3.  Combine both sets and present required output ------------- */
SELECT
    e."PatientID",
    e."StudyInstanceUID",
    e."SeriesInstanceUID",
    e."StudyDate",
    e."SeriesDate",
    d."Modality",
    d."SeriesDescription",
    d."Manufacturer",
    d."ManufacturerModelName",
    's3://' || d.bucket || '/' || e."SeriesInstanceUID" || '/*'  AS "Series_AWS_URL",
    ROUND( d.total_bytes / 1000000 , 2 )                         AS "Series_Size_MB"
FROM   eligible_series  e
JOIN   series_details   d
       ON e."SeriesInstanceUID" = d."SeriesInstanceUID"
ORDER BY "Series_Size_MB" DESC NULLS LAST;
```
