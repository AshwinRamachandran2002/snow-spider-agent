```sql
--Description: 1)  Inspect how “BodyPartExamined” is recorded and verify the different notations that
--              may correspond to “MEDIASTINUM”.
SELECT DISTINCT 
       "BodyPartExamined"
FROM   IDC.IDC_V17.DICOM_METADATA
WHERE  "BodyPartExamined" ILIKE '%MEDIAST%'
LIMIT 20;
```

```sql
--Description: 2)  Check which patient-age strings correspond to an 18-year-old
--              (note the leading zeroes in the DICOM convention, e.g. 018Y).
SELECT DISTINCT 
       "PatientAge"
FROM   IDC.IDC_V17.DICOM_METADATA
WHERE  "PatientAge" ILIKE '018%'
LIMIT 20;
```

```sql
--Description: 3)  Preview male patients whose age string starts with “018”
--              and whose body-part field contains mediastinum-related words.
SELECT DISTINCT 
       "PatientID",
       "PatientSex",
       "PatientAge",
       "BodyPartExamined"
FROM   IDC.IDC_V17.DICOM_METADATA
WHERE  "PatientSex" = 'M'
  AND  SUBSTR("PatientAge",1,3) = '018'
  AND  "BodyPartExamined" ILIKE '%MEDIAST%'
LIMIT 20;
```

```sql
--Description: 4)  Narrow the previous subset to those studies performed strictly
--              after 1 September 2014.
SELECT DISTINCT
       "PatientID",
       "StudyInstanceUID",
       "StudyDate",
       "PatientAge",
       "BodyPartExamined"
FROM   IDC.IDC_V17.DICOM_METADATA
WHERE  "PatientSex" = 'M'
  AND  SUBSTR("PatientAge",1,3) = '018'
  AND  "BodyPartExamined" = 'MEDIASTINUM'
  AND  "StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description: 5)  Retrieve series-level information (adding the Series UID and
--              description) for the same cohort, still within DICOM_METADATA.
SELECT DISTINCT
       "PatientID",
       "StudyInstanceUID",
       "SeriesInstanceUID",
       "SeriesDescription",
       "StudyDate",
       "SeriesDate"
FROM   IDC.IDC_V17.DICOM_METADATA
WHERE  "PatientSex" = 'M'
  AND  SUBSTR("PatientAge",1,3) = '018'
  AND  "BodyPartExamined" = 'MEDIASTINUM'
  AND  "StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description: 6)  Join the metadata just selected with IDC_V17.DICOM_ALL to
--              obtain storage locations (aws_url) and individual instance sizes.
SELECT DISTINCT
       m."PatientID",
       m."StudyInstanceUID",
       m."SeriesInstanceUID",
       a."aws_url",
       a."instance_size"
FROM   IDC.IDC_V17.DICOM_METADATA m
JOIN   IDC.IDC_V17.DICOM_ALL     a
  ON   m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  m."PatientSex" = 'M'
  AND  SUBSTR(m."PatientAge",1,3) = '018'
  AND  m."BodyPartExamined" = 'MEDIASTINUM'
  AND  m."StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description: 7)  Aggregate the previous join to compute total series size
--              in bytes for each SeriesInstanceUID.
SELECT
       m."SeriesInstanceUID",
       SUM(a."instance_size")               AS "total_size_bytes"
FROM   IDC.IDC_V17.DICOM_METADATA m
JOIN   IDC.IDC_V17.DICOM_ALL     a
  ON   m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  m."PatientSex" = 'M'
  AND  SUBSTR(m."PatientAge",1,3) = '018'
  AND  m."BodyPartExamined" = 'MEDIASTINUM'
  AND  m."StudyDate" > '2014-09-01'
GROUP BY m."SeriesInstanceUID"
LIMIT 20;
```

```sql
--Description: 8)  Convert the aggregated series-level byte size into megabytes
--              (rounded to two decimals) for readability.
SELECT
       "SeriesInstanceUID",
       ROUND("total_size_bytes" / 1000000, 2) AS "series_size_MB"
FROM ( 
       SELECT
              m."SeriesInstanceUID",
              SUM(a."instance_size") AS "total_size_bytes"
       FROM   IDC.IDC_V17.DICOM_METADATA m
       JOIN   IDC.IDC_V17.DICOM_ALL     a
         ON   m."SeriesInstanceUID" = a."SeriesInstanceUID"
       WHERE  m."PatientSex" = 'M'
         AND  SUBSTR(m."PatientAge",1,3) = '018'
         AND  m."BodyPartExamined" = 'MEDIASTINUM'
         AND  m."StudyDate" > '2014-09-01'
       GROUP BY m."SeriesInstanceUID"
     )
LIMIT 20;
```

```sql
--Description: 9)  Display study-level context (adding StudyDescription and
--              Manufacturer fields) for the filtered male, 18-year-old cohort.
SELECT DISTINCT
       m."PatientID",
       m."PatientAge",
       m."PatientSex",
       m."StudyInstanceUID",
       a."StudyDescription",
       m."StudyDate",
       m."Manufacturer",
       m."SeriesInstanceUID",
       m."SeriesDescription"
FROM   IDC.IDC_V17.DICOM_METADATA m
JOIN   IDC.IDC_V17.DICOM_ALL     a
  ON   m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  m."PatientSex" = 'M'
  AND  SUBSTR(m."PatientAge",1,3) = '018'
  AND  m."BodyPartExamined" = 'MEDIASTINUM'
  AND  m."StudyDate" > '2014-09-01'
LIMIT 20;
```

```sql
--Description: 10)  Produce a consolidated view that contains the requested
--              identification details, study & series metadata, one exemplar
--              storage location, and the calculated total series size in MB.
SELECT
       m."PatientID",
       m."PatientSex",
       m."PatientAge",
       m."StudyInstanceUID",
       m."StudyDate",
       m."SeriesInstanceUID",
       m."SeriesDescription",
       m."BodyPartExamined",
       ANY_VALUE(a."aws_url")                      AS "series_aws_url",
       ROUND(SUM(a."instance_size") / 1000000, 2)  AS "series_size_MB"
FROM   IDC.IDC_V17.DICOM_METADATA m
JOIN   IDC.IDC_V17.DICOM_ALL     a
  ON   m."SeriesInstanceUID" = a."SeriesInstanceUID"
WHERE  m."PatientSex" = 'M'
  AND  SUBSTR(m."PatientAge",1,3) = '018'
  AND  m."BodyPartExamined" = 'MEDIASTINUM'
  AND  m."StudyDate" > '2014-09-01'
GROUP BY
       m."PatientID",
       m."PatientSex",
       m."PatientAge",
       m."StudyInstanceUID",
       m."StudyDate",
       m."SeriesInstanceUID",
       m."SeriesDescription",
       m."BodyPartExamined"
LIMIT 20;
```
