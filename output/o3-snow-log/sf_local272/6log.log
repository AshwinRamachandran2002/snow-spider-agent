  ON   p."id" = ol."product_id"
WHERE  ol."order_id" = 423
LIMIT 20;
```

```sql
--Description: Show the inventory on hand (all locations) for the products on order 423.
SELECT i."product_id",
       i."location_id",
       i."qty",
       i."purchase_id"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
WHERE  i."product_id" IN (SELECT DISTINCT ol."product_id"
                          FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES" ol
                          WHERE ol."order_id" = 423)
LIMIT 20;
```

```sql
--Description: Restrict the above inventory to warehouse 1 and add aisle / position info.
SELECT i."product_id",
       l."warehouse",
       l."aisle",
       l."position",
       i."location_id",
       i."qty",
       i."purchase_id"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
JOIN   "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS" l
  ON   l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT DISTINCT "product_id"
                          FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
                          WHERE "order_id" = 423)
ORDER BY i."product_id", l."aisle", l."position"
LIMIT 20;
```

```sql
--Description: Retrieve the purchase date for each inventory row (needed to prioritise earlier purchases).
SELECT i."id"          AS "inventory_id",
       i."product_id",
       i."qty",
       pur."purchased" AS "purchased_date",
       i."location_id"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  i
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES" pur
  ON   pur."id" = i."purchase_id"
WHERE  i."product_id" IN (SELECT DISTINCT "product_id"
                          FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
                          WHERE "order_id" = 423)
ORDER BY i."product_id", pur."purchased"
LIMIT 20;
```

```sql
--Description: Aggregate inventory quantities per product in warehouse 1 (quick stock overview).
SELECT l."warehouse",
       i."product_id",
       SUM(i."qty") AS "total_qty_warehouse_1"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
JOIN   "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS" l
  ON   l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT DISTINCT "product_id"
                          FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
                          WHERE "order_id" = 423)
GROUP BY l."warehouse", i."product_id"
LIMIT 20;
```

```sql
--Description: Show smallest inventory lots first (to pick “smaller quantities” earlier).
SELECT i."product_id",
       i."location_id",
       i."qty",
       pur."purchased"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  i
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES" pur
  ON   pur."id" = i."purchase_id"
JOIN   "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS" l
  ON   l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (SELECT DISTINCT "product_id"
                          FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
                          WHERE "order_id" = 423)
ORDER BY i."product_id", pur."purchased", i."qty"
LIMIT 20;
```

