```sql
--Description: Bring in the product name for each order‐line of order 423.
SELECT ol."order_id",
       ol."product_id",
       p."name"          AS "product_name",
       ol."qty"
FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"  ol
