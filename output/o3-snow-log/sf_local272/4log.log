       ON l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (
        SELECT DISTINCT "product_id"
        FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
        WHERE "order_id" = 423
      )
GROUP BY i."product_id"
LIMIT 20;
```

```sql
--Description: Detailed list, sorted so we can later assign pick-quantities: earliest purchase & smallest qty first
SELECT i."product_id",
       i."id"                AS "inv_id",
       pu."purchased",
       i."qty"               AS "inv_qty",
       l."aisle",
       l."position"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"   i
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"   pu
       ON pu."id" = i."purchase_id"
JOIN   "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS"   l
       ON l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN (
        SELECT DISTINCT "product_id"
        FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
        WHERE "order_id" = 423
      )
ORDER BY i."product_id",
         pu."purchased",         -- oldest first
         i."qty"                 -- smallest lots first
LIMIT 20;
```

```sql
--Description: (Complex) Combine order-quantities and inventory in one view to verify coverage product by product
SELECT ord."product_id",
       ord."qty_ordered",
       inv."qty_available_wh1"
FROM  (
        SELECT "product_id",
               SUM("qty") AS "qty_ordered"
        FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
        WHERE  "order_id" = 423
        GROUP  BY "product_id"
      ) ord
LEFT JOIN (
        SELECT  i."product_id",
                SUM(i."qty") AS "qty_available_wh1"
        FROM    "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
        JOIN    "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS" l
                ON l."id" = i."location_id"
        WHERE   l."warehouse" = 1
        GROUP   BY i."product_id"
      ) inv
ON inv."product_id" = ord."product_id"
LIMIT 20;
```
