```sql
--Description: 3) All inventory records that concern the products on order 423
SELECT inv.*
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" inv
JOIN   (SELECT DISTINCT "product_id"
        FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
        WHERE  "order_id" = 423) o
        ON o."product_id" = inv."product_id"
LIMIT 20;
```

```sql
--Description: 4) Inventory (warehouse-1 only) enriched with aisle/position
SELECT inv."id"               AS "inv_id",
       inv."product_id",
       inv."qty",
       loc."warehouse",
       loc."aisle",
       loc."position",
       inv."location_id"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" inv
JOIN   "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS" loc
       ON loc."id" = inv."location_id"
WHERE  loc."warehouse" = 1
  AND  inv."product_id" IN (SELECT DISTINCT "product_id"
                            FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
                            WHERE "order_id" = 423)
LIMIT 20;
```

```sql
--Description: 5) Add purchase date to each inventory record (for FIFO picking)
SELECT inv."id"           AS "inv_id",
       inv."product_id",
       prc."purchased",
       inv."qty",
       loc."aisle",
       loc."position",
       inv."location_id"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" inv
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES" prc
       ON prc."id" = inv."purchase_id"
JOIN   "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS" loc
       ON loc."id" = inv."location_id"
WHERE  loc."warehouse" = 1
  AND  inv."product_id" IN (SELECT DISTINCT "product_id"
                            FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
                            WHERE "order_id" = 423)
ORDER  BY inv."product_id", prc."purchased", inv."qty"
LIMIT 20;
```

```sql
--Description: 6) How much inventory per product is available in warehouse-1
SELECT inv."product_id",
       SUM(inv."qty")  AS "wh1_qty"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" inv
JOIN   "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS" loc
       ON loc."id" = inv."location_id"
WHERE  loc."warehouse" = 1
  AND  inv."product_id" IN (SELECT DISTINCT "product_id"
                            FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
                            WHERE "order_id" = 423)
GROUP  BY inv."product_id"
LIMIT 20;
```

```sql
--Description: 7) What is actually needed for order 423 (cumulative per product)
SELECT "product_id",
       SUM("qty") AS "qty_needed"
FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
WHERE  "order_id" = 423
GROUP  BY "product_id"
LIMIT 20;
```

```sql
--Description: 8) Candidate pick-lines – allocate qty from each location (FIFO, smallest lots first)
SELECT
       ol."order_id",
       ol."product_id",
       ol."qty"                               AS "orderline_qty",
       inv."id"                               AS "inv_id",
       prc."purchased",
       inv."qty"                              AS "location_qty",
       loc."aisle",
       loc."position",
       -- running sum within each product to allocate exact qty
       LEAST(inv."qty",
             GREATEST(ol."qty" - 
                      COALESCE(SUM(inv."qty") OVER (PARTITION BY ol."id"
                           ORDER BY prc."purchased", inv."qty"
                           ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING),0),0)
            )                                 AS "pick_qty"
FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES" ol
JOIN   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  inv
       ON inv."product_id" = ol."product_id"
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"  prc
       ON prc."id" = inv."purchase_id"
JOIN   "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS" loc
       ON loc."id" = inv."location_id"
WHERE  ol."order_id" = 423
  AND  loc."warehouse" = 1
QUALIFY "pick_qty" > 0
ORDER  BY ol."order_id",
          ol."id",               -- keeps original order-line sequence
          prc."purchased",
          inv."qty"
LIMIT 20;
```

```sql
--Description: 9) Final pick-list for order 423 (aggregate by product/location after allocation)
WITH allocated AS (
    SELECT
           ol."id"              AS "orderline_id",
           ol."order_id",
           ol."product_id",
           loc."aisle",
           loc."position",
           LEAST(inv."qty",
                 GREATEST(ol."qty" - 
                          COALESCE(SUM(inv."qty") OVER (PARTITION BY ol."id"
                               ORDER BY prc."purchased", inv."qty"
                               ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING),0),0)
                )               AS "pick_qty"
    FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES" ol
    JOIN   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  inv
           ON inv."product_id" = ol."product_id"
    JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"  prc
           ON prc."id" = inv."purchase_id"
    JOIN   "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS"  loc
           ON loc."id" = inv."location_id"
    WHERE  ol."order_id" = 423
      AND  loc."warehouse" = 1
    QUALIFY "pick_qty" > 0
)
SELECT  "order_id",
        "product_id",
        "aisle",
        "position",
        SUM("pick_qty") AS "qty_to_pick"
FROM    allocated
GROUP   BY "order_id","product_id","aisle","position"
ORDER   BY "product_id","aisle","position"
LIMIT 20;
```

```sql
--Description: 10) Sanity-check – picked quantity per product equals what was ordered
WITH picked AS (
    /* use previous CTE for allocated pick-qty */
    SELECT  ol."product_id",
            LEAST(inv."qty",
                  GREATEST(ol."qty" - 
                           COALESCE(SUM(inv."qty") OVER (PARTITION BY ol."id"
                                ORDER BY prc."purchased", inv."qty"
                                ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING),0),0)
                 )               AS "pick_qty"
    FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES" ol
    JOIN   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  inv
           ON inv."product_id" = ol."product_id"
    JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"  prc
           ON prc."id" = inv."purchase_id"
    JOIN   "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS"  loc
           ON loc."id" = inv."location_id"
    WHERE  ol."order_id" = 423
      AND  loc."warehouse" = 1
    QUALIFY "pick_qty" > 0
)
SELECT  p."product_id",
        SUM(p."pick_qty") AS "picked_qty",
        o."qty_needed"
FROM    picked          p
JOIN    (SELECT "product_id",
               SUM("qty") AS "qty_needed"
        FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
        WHERE  "order_id" = 423
        GROUP  BY "product_id") o
        ON o."product_id" = p."product_id"
GROUP  BY p."product_id", o."qty_needed"
LIMIT 20;
```

Each query gradually builds the information needed to calculate a compliant pick-plan for order 423, ending with a final list of (product ID, aisle, position, quantity) that satisfies the order while observing FIFO and inventory constraints in warehouse 1.
