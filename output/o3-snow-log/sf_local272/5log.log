```sql
--Description: 2) Same order-lines, but with product names for a quick overview
SELECT ol."order_id",
       ol."product_id",
       p."name"           AS "product_name",
       ol."qty",
       ol."id"            AS "orderline_id"
FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"      ol
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PRODUCTS"        p
       ON p."id" = ol."product_id"
WHERE  ol."order_id" = 423
