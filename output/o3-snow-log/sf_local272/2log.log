```sql
--Description: 3)  Find all inventory (still in stock) for those products that is physically stored in WAREHOUSE = 1  
SELECT i."id"          AS "inventory_id",
       i."product_id",
       i."qty",
       i."location_id"
FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY" i
JOIN   ORACLE_SQL.ORACLE_SQL."LOCATIONS" l
  ON   l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN ( SELECT "product_id"
                           FROM   ORACLE_SQL.ORACLE_SQL."ORDERLINES"
                           WHERE  "order_id" = 423 )
LIMIT 20;
```

```sql
--Description: 4)  Add purchase-date information so we can later prioritise “oldest first” (FIFO)  
SELECT i."id"          AS "inventory_id",
       i."product_id",
       i."qty",
       i."location_id",
       pu."purchased"
FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"  pu
  ON   pu."id" = i."purchase_id"
JOIN   ORACLE_SQL.ORACLE_SQL."LOCATIONS"  l
  ON   l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN ( SELECT "product_id"
                           FROM   ORACLE_SQL.ORACLE_SQL."ORDERLINES"
                           WHERE  "order_id" = 423 )
ORDER  BY i."product_id",
          pu."purchased"   -- oldest first
LIMIT 20;
```

```sql
--Description: 5)  Aggregate the on-hand quantity per product *per location* (still ordered by oldest purchase first)  
SELECT i."product_id",
       i."location_id",
       SUM(i."qty") AS "onhand_qty",
       MIN(pu."purchased") AS "first_purchase_date"
FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"  pu
  ON   pu."id" = i."purchase_id"
JOIN   ORACLE_SQL.ORACLE_SQL."LOCATIONS"  l
  ON   l."id" = i."location_id"
WHERE  l."warehouse" = 1
  AND  i."product_id" IN ( SELECT "product_id"
                           FROM   ORACLE_SQL.ORACLE_SQL."ORDERLINES"
                           WHERE  "order_id" = 423 )
GROUP  BY i."product_id", i."location_id"
ORDER  BY i."product_id",
          MIN(pu."purchased")
LIMIT 20;
```

```sql
--Description: 6)  Attach aisle/position to each location so pickers know where to go  
SELECT inv."product_id",
       loc."aisle",
       loc."position",
       inv."qty",
       pu."purchased"
FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY"  inv
JOIN   ORACLE_SQL.ORACLE_SQL."LOCATIONS"  loc
  ON   loc."id" = inv."location_id"
JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"  pu
  ON   pu."id"  = inv."purchase_id"
WHERE  loc."warehouse" = 1
  AND  inv."product_id" IN ( SELECT "product_id"
                             FROM   ORACLE_SQL.ORACLE_SQL."ORDERLINES"
                             WHERE  "order_id" = 423 )
ORDER  BY inv."product_id",
          pu."purchased",
          inv."qty"         -- smaller lots first
LIMIT 20;
```

```sql
--Description: 7)  Calculate a running total (window) so we know exactly how much to pick from each location until the ordered quantity is reached  
WITH order_need AS (
        SELECT "product_id",
               SUM("qty") AS "ordered_qty"
        FROM   ORACLE_SQL.ORACLE_SQL."ORDERLINES"
        WHERE  "order_id" = 423
        GROUP  BY "product_id" )
SELECT i."product_id",
       loc."aisle",
       loc."position",
       i."qty"                         AS "location_qty",
       pu."purchased",
       SUM(i."qty") OVER (PARTITION BY i."product_id"
                          ORDER BY pu."purchased", i."qty") AS "cumu_qty"
FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"  pu
  ON   pu."id" = i."purchase_id"
JOIN   ORACLE_SQL.ORACLE_SQL."LOCATIONS"  loc
  ON   loc."id" = i."location_id"
JOIN   order_need  o
  ON   o."product_id" = i."product_id"
WHERE  loc."warehouse" = 1
ORDER  BY i."product_id",
          pu."purchased",
          i."qty"
LIMIT 20;
```

```sql
--Description: 8)  From the previous CTE, keep only the rows that are needed to satisfy the order (cumulative before or reaching the required qty); work out the exact pick quantity for the last row via LEAST()  
WITH order_need AS (
        SELECT "product_id",
               SUM("qty") AS "ordered_qty"
        FROM   ORACLE_SQL.ORACLE_SQL."ORDERLINES"
        WHERE  "order_id" = 423
        GROUP  BY "product_id" ),
inventory_q AS (
        SELECT i."product_id",
               loc."aisle",
               loc."position",
               i."qty"                         AS "location_qty",
               pu."purchased",
               SUM(i."qty") OVER (PARTITION BY i."product_id"
                                  ORDER BY pu."purchased", i."qty") AS "cumu_qty",
               o."ordered_qty"
        FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
        JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"  pu
          ON   pu."id" = i."purchase_id"
        JOIN   ORACLE_SQL.ORACLE_SQL."LOCATIONS"  loc
          ON   loc."id" = i."location_id"
        JOIN   order_need  o
          ON   o."product_id" = i."product_id"
        WHERE  loc."warehouse" = 1 )
SELECT "product_id",
       "aisle",
       "position",
       CASE
            WHEN "cumu_qty" - "location_qty" < "ordered_qty"  --this row is partly or fully needed
            THEN LEAST("location_qty", "ordered_qty" - ("cumu_qty" - "location_qty"))
            ELSE 0
       END  AS "pick_qty"
FROM   inventory_q
WHERE  "cumu_qty" - "location_qty" < "ordered_qty"   -- keep only needed rows
ORDER  BY "product_id",
          "purchased",
          "location_qty"
LIMIT 20;
```

```sql
--Description: 9)  For easy reading, join the product names to the final calculated pick list  
WITH order_need AS (
        SELECT "product_id",
               SUM("qty") AS "ordered_qty"
        FROM   ORACLE_SQL.ORACLE_SQL."ORDERLINES"
        WHERE  "order_id" = 423
        GROUP  BY "product_id" ),
inventory_q AS (
        SELECT i."product_id",
               loc."aisle",
               loc."position",
               i."qty"                         AS "location_qty",
               pu."purchased",
               SUM(i."qty") OVER (PARTITION BY i."product_id"
                                  ORDER BY pu."purchased", i."qty") AS "cumu_qty",
               o."ordered_qty"
        FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
        JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"  pu
          ON   pu."id" = i."purchase_id"
        JOIN   ORACLE_SQL.ORACLE_SQL."LOCATIONS"  loc
          ON   loc."id" = i."location_id"
        JOIN   order_need  o
          ON   o."product_id" = i."product_id"
        WHERE  loc."warehouse" = 1 ),
picklist AS (
        SELECT "product_id",
               "aisle",
               "position",
               CASE
                    WHEN "cumu_qty" - "location_qty" < "ordered_qty"
                    THEN LEAST("location_qty", "ordered_qty" - ("cumu_qty" - "location_qty"))
                    ELSE 0
               END  AS "pick_qty"
        FROM   inventory_q
        WHERE  "cumu_qty" - "location_qty" < "ordered_qty" )
SELECT pl."product_id",
       p."name"               AS "product_name",
       pl."aisle",
       pl."position",
       pl."pick_qty"
FROM   picklist              pl
JOIN   ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
  ON   p."id" = pl."product_id"
ORDER  BY pl."product_id",
          pl."aisle",
          pl."position"
LIMIT 20;
```

```sql
--Description: 10)  (Optional)  Check that the computed pick quantities exactly match the ordered quantities – should return zero rows  
WITH final_pick AS (
        /* copy query 9’s picklist CTE here (omitted for brevity) */
),
ordered AS (
        SELECT "product_id",
               SUM("qty") AS "ordered_qty"
        FROM   ORACLE_SQL.ORACLE_SQL."ORDERLINES"
        WHERE  "order_id" = 423
        GROUP  BY "product_id" )
SELECT o."product_id",
       o."ordered_qty" - COALESCE(SUM(f."pick_qty"),0) AS "difference"
FROM   ordered o
LEFT  JOIN final_pick f
  ON   f."product_id" = o."product_id"
GROUP BY o."product_id",
         o."ordered_qty"
HAVING o."ordered_qty" - COALESCE(SUM(f."pick_qty"),0) <> 0
LIMIT 20;
```
