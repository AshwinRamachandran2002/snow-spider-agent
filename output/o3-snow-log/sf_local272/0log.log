```sql
--Description: Same inventory but enriched with aisle / position and restricted to warehouse = 1
SELECT 
    i."id"            AS "inventory_id",
    i."product_id",
    l."aisle",
    l."position",
    i."qty"
FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
JOIN "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS" l
  ON l."id" = i."location_id"
JOIN "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES" ol
  ON i."product_id" = ol."product_id"
WHERE ol."order_id" = 423
  AND l."warehouse" = 1
ORDER BY i."product_id", l."aisle", l."position"
LIMIT 20;
```

```sql
--Description: Combine inventory with purchase date so that we can prioritise by oldest stock
SELECT 
    i."id"            AS "inventory_id",
    i."product_id",
    pu."purchased"    AS "purchase_date",
    i."qty",
    i."location_id"
FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  i
JOIN "ORACLE_SQL"."ORACLE_SQL"."PURCHASES" pu
      ON pu."id" = i."purchase_id"
JOIN "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES" ol
      ON i."product_id" = ol."product_id"
WHERE ol."order_id" = 423
ORDER BY i."product_id", pu."purchased"
LIMIT 20;
```

```sql
--Description: Aggregate quantity on each (product, location) pair within warehouse 1 for products in order 423
SELECT 
    i."product_id",
    l."aisle",
    l."position",
    SUM(i."qty") AS "location_qty"
FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
JOIN "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS" l
      ON l."id" = i."location_id"
JOIN "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES" ol
      ON i."product_id" = ol."product_id"
WHERE ol."order_id" = 423
  AND l."warehouse" = 1
GROUP BY i."product_id", l."aisle", l."position"
ORDER BY i."product_id", "location_qty"
LIMIT 20;
```

```sql
--Description: Required quantity per product for order 423 (to be balanced against inventory)
SELECT 
    ol."product_id",
    SUM(ol."qty") AS "ordered_qty"
FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES" ol
WHERE ol."order_id" = 423
GROUP BY ol."product_id"
ORDER BY ol."product_id"
LIMIT 20;
```

```sql
--Description: Detailed inventory rows ordered by oldest purchase date and smallest qty – the sequence we will pick from
SELECT
    i."product_id",
    pu."purchased"      AS "purchase_date",
    l."aisle",
    l."position",
    i."qty",
    ROW_NUMBER() OVER (PARTITION BY i."product_id" 
                       ORDER BY pu."purchased" ASC, i."qty" ASC)  AS "pick_priority"
FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
JOIN "ORACLE_SQL"."ORACLE_SQL"."PURCHASES" pu
      ON pu."id" = i."purchase_id"
JOIN "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS" l
      ON l."id"  = i."location_id"
JOIN "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES" ol
      ON i."product_id" = ol."product_id"
WHERE ol."order_id" = 423
  AND l."warehouse" = 1
ORDER BY i."product_id", "pick_priority"
LIMIT 20;
```

```sql
--Description: Cumulate inventory quantities in the prioritised order so we can compare with ordered quantities
SELECT
    x."product_id",
    x."aisle",
    x."position",
    x."qty",
    x."purchase_date",
    SUM(x."qty") OVER (PARTITION BY x."product_id" 
                       ORDER BY x."pick_priority") AS "cumulative_qty"
FROM (
    SELECT
        i."product_id",
        pu."purchased"      AS "purchase_date",
        l."aisle",
        l."position",
        i."qty",
        ROW_NUMBER() OVER (PARTITION BY i."product_id" 
                           ORDER BY pu."purchased" ASC, i."qty" ASC) AS "pick_priority"
    FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
    JOIN "ORACLE_SQL"."ORACLE_SQL"."PURCHASES" pu
          ON pu."id" = i."purchase_id"
    JOIN "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS" l
          ON l."id"  = i."location_id"
    JOIN "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES" ol
          ON i."product_id" = ol."product_id"
    WHERE ol."order_id" = 423
      AND l."warehouse" = 1
) x
ORDER BY x."product_id", x."pick_priority"
LIMIT 20;
```
