```sql
--Description: Show on-hand inventory for the products in order 423 that are stored
--             in warehouse 1 (via the LOCATIONS table).
SELECT
  i."id"              AS "inv_id",
  i."product_id",
  i."qty"             AS "on_hand_qty",
  i."location_id",
  l."warehouse",
  l."aisle",
  l."position"
FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  i
JOIN "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS"  l
      ON l."id" = i."location_id"
WHERE i."product_id" IN ( SELECT DISTINCT "product_id"
                          FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
                          WHERE "order_id" = 423 )
  AND l."warehouse" = 1
LIMIT 20;
```

```sql
--Description: Aggregate the available inventory in warehouse 1 per product that
--             appears in order 423.
SELECT
  i."product_id",
  SUM(i."qty") AS "total_on_hand_qty"
FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  i
JOIN "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS"  l 
      ON l."id" = i."location_id"
WHERE i."product_id" IN ( SELECT DISTINCT "product_id"
                          FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
                          WHERE "order_id" = 423 )
  AND l."warehouse" = 1
GROUP BY i."product_id"
LIMIT 20;
```

```sql
--Description: Bring in purchase information so we can apply the “earliest
--             purchased first” picking rule.  
SELECT
  i."product_id",
  i."qty"           AS "on_hand_qty",
  pu."purchased"    AS "purchase_date",
  i."location_id"
FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  i
JOIN "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"  pu
      ON pu."id" = i."purchase_id"
WHERE i."product_id" IN ( SELECT DISTINCT "product_id"
                          FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
                          WHERE "order_id" = 423 )
ORDER BY i."product_id",
         pu."purchased",
         i."qty"
LIMIT 20;
```

```sql
--Description: Examine the detailed location (aisle/position) list for a single
--             product in order 423 (replace 4040 with any product_id you need).
SELECT
  i."product_id",
  i."qty",
  l."aisle",
  l."position",
  l."warehouse"
FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  i
JOIN "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS"  l
      ON l."id" = i."location_id"
WHERE i."product_id" = 4040
  AND l."warehouse" = 1
ORDER BY l."aisle", l."position"
LIMIT 20;
```

```sql
--Description: Compare the total ordered quantities vs. total on-hand quantities
--             per product for order 423 to ensure stock is sufficient.
SELECT
  q."product_id",
  q."ordered_qty",
  COALESCE(s."total_on_hand_qty",0) AS "total_on_hand_qty"
FROM (
    SELECT "product_id",
           SUM("qty") AS "ordered_qty"
    FROM "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
    WHERE "order_id" = 423
    GROUP BY "product_id"
) q
LEFT JOIN (
    SELECT i."product_id",
           SUM(i."qty") AS "total_on_hand_qty"
    FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
    JOIN "ORACLE_SQL"."ORACLE_SQL"."LOCATIONS" l
          ON l."id" = i."location_id"
    WHERE l."warehouse" = 1
    GROUP BY i."product_id"
) s ON s."product_id" = q."product_id"
LIMIT 20;
```

```sql
