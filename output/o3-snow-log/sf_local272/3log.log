```sql
--Description: Attach purchase-date information so we can prioritise older stock
SELECT
    inv."product_id",
    inv."location_id",
    pur."purchased",
    inv."qty"
FROM ORACLE_SQL.ORACLE_SQL.INVENTORY  inv
