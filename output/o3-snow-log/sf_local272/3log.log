      ON pur."id" = inv."purchase_id"
JOIN ORACLE_SQL.ORACLE_SQL.ORDERLINES ol
      ON ol."product_id" = inv."product_id"
WHERE ol."order_id" = 423
ORDER BY inv."product_id", pur."purchased" ASC, inv."qty" ASC
LIMIT 20;
