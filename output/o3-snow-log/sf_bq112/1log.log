```sql
-- Description:  Compute CPI percentage growth from 1998 to 2017 using the
-- annual-average rows (PERIOD = 'M13') for the U.S. city-average and “All items”.
WITH cpi AS (
    SELECT year, value
    FROM   BLS.BLS.C_CPI_U
    WHERE  period    = 'M13'
      AND  area_code = '0'
      AND  item_code = 'SA0'
      AND  year IN (1998, 2017)
)
SELECT  MIN(CASE WHEN year = 1998 THEN value END) AS cpi_1998,
        MIN(CASE WHEN year = 2017 THEN value END) AS cpi_2017,
        ROUND( (MAX(CASE WHEN year = 2017 THEN value END) /
                MIN(CASE WHEN year = 1998 THEN value END) - 1) * 100 , 2) 
        AS pct_growth_cpi
FROM    cpi;
