```sql
-- Description:  Compute CPI percentage growth 1998-2017  
WITH cpi AS (
    SELECT "year", "value"
    FROM   "BLS"."BLS"."C_CPI_U"
    WHERE  "period" = 'M13'
      AND  "area_code" = '0'
      AND  "item_code" = 'SA0'
      AND  "year" IN (1998, 2017)
)
SELECT  MIN(CASE WHEN "year" = 1998 THEN "value" END) AS "cpi_1998",
        MIN(CASE WHEN "year" = 2017 THEN "value" END) AS "cpi_2017",
        ROUND( (MAX(CASE WHEN "year" = 2017 THEN "value" END)
               /MIN(CASE WHEN "year" = 1998 THEN "value" END) - 1)*100 , 2)
                                                        AS "pct_growth_cpi"
FROM    cpi;
```

```sql
-- Description:  Combine wage-growth and CPI-growth results for side-by-side comparison  
WITH wage AS (
    SELECT  ROUND( (w17."avg_wkly_wage_10_total_all_industries"
                   /w98."avg_wkly_wage_10_total_all_industries" - 1)*100 , 2) 
                    AS "pct_growth_wage"
    FROM   "BLS"."BLS_QCEW"."_1998_Q4" w98
    JOIN   "BLS"."BLS_QCEW"."_2017_Q4" w17
           ON w98."area_fips" = w17."area_fips"
    WHERE  w98."area_fips" = '42003'
), cpi AS (
    SELECT  ROUND( (c17."value"/c98."value" - 1)*100 , 2) AS "pct_growth_cpi"
    FROM   "BLS"."BLS"."C_CPI_U" c98
    JOIN   "BLS"."BLS"."C_CPI_U" c17
           ON c98."area_code" = c17."area_code"
          AND c98."item_code" = c17."item_code"
    WHERE  c98."year" = 1998 AND c98."period" = 'M13'
      AND  c17."year" = 2017 AND c17."period" = 'M13'
      AND  c98."area_code" = '0' AND c98."item_code" = 'SA0'
)
SELECT  'Allegheny County, PA (All industries wages) vs. U.S. CPI (All items)' AS "comparison",
        wage."pct_growth_wage",
        cpi."pct_growth_cpi";
```

