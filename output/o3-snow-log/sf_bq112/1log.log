```sql
-- Description:  Compare percentage growth in Allegheny County wages (QCEW weekly
-- wage, total industries) with the growth in the U.S.-city-average CPI-U (December
-- “M12” value, item SA0) from 1998 to 2017.  The CTE “wage” computes wage growth,
-- while CTE “cpi” computes CPI growth; the final SELECT joins the two results.
WITH wage AS (
    SELECT
        ROUND(
            (w17."avg_wkly_wage_10_total_all_industries" /
             w98."avg_wkly_wage_10_total_all_industries" - 1) * 100
        , 2) AS pct_growth_wage
    FROM   "BLS"."BLS_QCEW"."_1998_Q4"  w98
    JOIN   "BLS"."BLS_QCEW"."_2017_Q4"  w17
           ON w98."area_fips" = w17."area_fips"
    WHERE  w98."area_fips" = '42003'   -- Allegheny County
), cpi AS (
    SELECT
        ROUND(
            (c17."value" / c98."value" - 1) * 100
        , 2) AS pct_growth_cpi
    FROM   "BLS"."BLS"."C_CPI_U" c98
    JOIN   "BLS"."BLS"."C_CPI_U" c17
           ON c98."area_code" = c17."area_code"
          AND c98."item_code" = c17."item_code"
    WHERE  c98."year" = 1998  AND c98."period" = 'M12'
      AND  c17."year" = 2017  AND c17."period" = 'M12'
      AND  c98."area_code" = '0'       -- U.S. city average
      AND  c98."item_code" = 'SA0'     -- All items
)
SELECT
    'Allegheny County wages vs. U.S. CPI (1998–2017)' AS comparison,
    wage.pct_growth_wage,
    cpi.pct_growth_cpi
FROM wage
CROSS JOIN cpi;
