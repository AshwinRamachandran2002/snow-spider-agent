Query:
-- Description:  Compute percentage wage growth 1998-2017 directly in SQL  
SELECT  'Allegheny County'                                AS "area",
        1998                                              AS "base_year",
        2017                                              AS "latest_year",
        w98."avg_wkly_wage_10_total_all_industries"       AS "wage_1998",
        w17."avg_wkly_wage_10_total_all_industries"       AS "wage_2017",
        ROUND( (w17."avg_wkly_wage_10_total_all_industries"
               /w98."avg_wkly_wage_10_total_all_industries" - 1)*100 , 2) 
                                                          AS "pct_growth_wage"
FROM   "BLS"."BLS_QCEW"."_1998_Q4"  w98
JOIN   "BLS"."BLS_QCEW"."_2017_Q4"  w17
       ON w98."area_fips" = w17."area_fips"
WHERE  w98."area_fips" = '42003';
Answer:
