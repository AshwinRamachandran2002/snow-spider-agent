```sql
-- Description: 8) Convert the confirmed-case text values to numeric and compute cases per 100,000 people
WITH pop AS (
  SELECT "country_name", SUM("value") AS "population_2020"
  FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
  WHERE "indicator_name" = 'Population, total'
    AND "year" = 2020
    AND "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
  GROUP BY "country_name"
)
SELECT c."country_or_region",
       TO_NUMBER(c."_4_20_20")                            AS "confirmed_4_20_20",
       p."population_2020",
       (TO_NUMBER(c."_4_20_20") / p."population_2020") * 100000
         AS "cases_per_100k"
FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES c
JOIN pop p
  ON p."country_name" = c."country_or_region"
LIMIT 20;
```

