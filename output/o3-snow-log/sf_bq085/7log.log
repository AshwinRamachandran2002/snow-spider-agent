```sql
--Description: Combine confirmed cases and population in a single view (initial exploration)
SELECT 
  c."country_or_region"                           AS "country",
  CAST(c."_4_20_20" AS NUMBER)                    AS "confirmed_2020_04_20",
  p."population_2020_total"
FROM (
  SELECT 
    "country_name",
    SUM("value") AS "population_2020_total"
  FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
  WHERE "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
    AND "year" = 2020
    AND "indicator_name" ILIKE '%population, total%'
  GROUP BY "country_name"
) p
JOIN COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES c
  ON p."country_name" = c."country_or_region"
WHERE c."country_or_region" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
LIMIT 20;
```

```sql
--Description: Calculate cases per 100,000 population for verification (full computation)
SELECT 
  t."country",
  t."confirmed_2020_04_20",
  t."population_2020_total",
  (t."confirmed_2020_04_20" / t."population_2020_total") * 100000 AS "cases_per_100k"
FROM (
  SELECT 
    c."country_or_region"                           AS "country",
    CAST(c."_4_20_20" AS NUMBER)                    AS "confirmed_2020_04_20",
    p."population_2020_total"
  FROM (
    SELECT 
      "country_name",
      SUM("value") AS "population_2020_total"
    FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
    WHERE "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
      AND "year" = 2020
      AND "indicator_name" ILIKE '%population, total%'
    GROUP BY "country_name"
  ) p
  JOIN COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES c
    ON p."country_name" = c."country_or_region"
) t
LIMIT 20;
```

