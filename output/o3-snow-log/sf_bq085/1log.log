```sql
--Description: Discover population-related indicators in the World Bank table
SELECT DISTINCT "indicator_name"
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
WHERE "indicator_name" ILIKE '%population, total%'
LIMIT 20;
```

```sql
--Description: Pull 2020 total-population figures for the seven countries
SELECT "country_name",
       "value"                           AS "population_2020"
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
WHERE "indicator_name" = 'Population, total'
  AND "year"         = 2020
  AND "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
LIMIT 20;
```

```sql
--Description: Sum 2020 population values for each of the seven countries
SELECT "country_name",
       SUM("value")                      AS "population_2020"
FROM   COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
WHERE  "indicator_name" = 'Population, total'
  AND  "year"           = 2020
  AND  "country_name"  IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
GROUP BY "country_name"
LIMIT 20;
```

```sql
--Description: Join confirmed cases (as of 20 Apr 2020) with 2020 population counts
WITH cases AS (
      SELECT "country_or_region"                       AS "country",
             "_4_20_20"::NUMBER                        AS "cases"
      FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES
      WHERE "country_or_region" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
), pop AS (
      SELECT "country_name"                            AS "country",
             SUM("value")                              AS "population_2020"
      FROM   COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
      WHERE  "indicator_name" = 'Population, total'
        AND  "year"           = 2020
        AND  "country_name"  IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
      GROUP BY "country_name"
)
SELECT c."country",
       c."cases",
       p."population_2020"
FROM   cases c
JOIN   pop   p ON c."country" = p."country"
LIMIT 20;
```

```sql
--Description: Calculate confirmed cases per 100,000 inhabitants for each country
WITH cases AS (
      SELECT "country_or_region"                       AS "country",
             "_4_20_20"::NUMBER                        AS "cases"
      FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES
      WHERE "country_or_region" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
), pop AS (
      SELECT "country_name"                            AS "country",
             SUM("value")                              AS "population_2020"
      FROM   COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
      WHERE  "indicator_name" = 'Population, total'
        AND  "year"           = 2020
        AND  "country_name"  IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
      GROUP BY "country_name"
)
SELECT c."country",
       c."cases",
       p."population_2020",
       (c."cases" / p."population_2020") * 100000      AS "cases_per_100k"
FROM   cases c
JOIN   pop   p ON c."country" = p."country"
LIMIT 20;
```

```sql
--Description: Same calculation as above, ordered by descending incidence per 100 k
WITH cases AS (
      SELECT "country_or_region"                       AS "country",
             "_4_20_20"::NUMBER                        AS "cases"
      FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES
      WHERE "country_or_region" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
), pop AS (
      SELECT "country_name"                            AS "country",
             SUM("value")                              AS "population_2020"
      FROM   COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
      WHERE  "indicator_name" = 'Population, total'
        AND  "year"           = 2020
        AND  "country_name"  IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
      GROUP BY "country_name"
)
SELECT c."country",
       c."cases",
       p."population_2020",
       ROUND((c."cases" / p."population_2020") * 100000, 2) AS "cases_per_100k"
FROM   cases c
JOIN   pop   p ON c."country" = p."country"
ORDER BY "cases_per_100k" DESC
LIMIT 20;
```

