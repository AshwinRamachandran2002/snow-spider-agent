--Description / Thinking process:
-- We need, for seven countries, the total confirmed COVID-19 cases on 20-Apr-2020
--   and cases per 100 000 population (2020).
-- 1) Table COVID19_JHU_CSSE.CONFIRMED_CASES has column "_4_20_20".
--    Countries are spread across multiple province/state rows, so SUM that column
--    (after casting to NUMBER) per country.
-- 2) Table WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION holds yearly
--    'Population, total'.  There can be multiple rows per country (e.g. aggregates),
--    so SUM the 2020 values per country for the population.
-- 3) Join the two CTE results on the common country name.
-- 4) Compute (cases / population) * 100 000, ROUND for readability.
-- 5) Return one row per requested country.
WITH cases AS (
    SELECT "country_or_region"                AS "country",
           SUM("_4_20_20"::NUMBER)           AS "cases"
    FROM   COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES
    WHERE  "country_or_region" IN ('United States','France','China','Italy','Spain','Germany','Iran')
    GROUP BY "country_or_region"
), pop AS (
    SELECT "country_name"                     AS "country",
           SUM("value")                       AS "population_2020"
    FROM   COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
    WHERE  "indicator_name" = 'Population, total'
      AND  "year"           = 2020
      AND  "country_name"   IN ('United States','France','China','Italy','Spain','Germany','Iran')
    GROUP BY "country_name"
)
SELECT c."country",
       c."cases",
       p."population_2020",
       ROUND((c."cases" / p."population_2020") * 100000, 2) AS "cases_per_100k"
FROM   cases c
JOIN   pop   p ON c."country" = p."country"
ORDER BY c."country";
