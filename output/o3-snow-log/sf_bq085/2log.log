```sql
--Description: 7) Convert April-20 case counts to numeric form for our seven countries only
SELECT 
       "country_or_region",
       "_4_20_20"::NUMBER AS "cases_4_20_2020"
FROM   COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES
WHERE  "country_or_region" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
LIMIT 20;
```

```sql
--Description: 8) Build a temporary population CTE and join with confirmed-case counts
WITH pop AS (
    SELECT 
           "country_name",
           SUM("value") AS "population_2020"
    FROM   COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
    WHERE  "indicator_name" ILIKE '%Population, total%'
      AND  "year" = 2020
      AND  "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran, Islamic Rep.')
    GROUP BY "country_name"
)
SELECT 
       c."country_or_region",
       c."_4_20_20"::NUMBER              AS "cases_4_20_2020",
       p."population_2020"
FROM   COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES  c
JOIN   pop                                                        p
  ON   c."country_or_region" ILIKE '%' || SPLIT_PART(p."country_name", ',', 1) || '%'
WHERE  c."country_or_region" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
LIMIT 20;
```

```sql
--Description: 9) Extend the prior join to calculate cases per 100,000 people
WITH pop AS (
    SELECT 
           "country_name",
           SUM("value") AS "population_2020"
    FROM   COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
    WHERE  "indicator_name" ILIKE '%Population, total%'
      AND  "year" = 2020
      AND  "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran, Islamic Rep.')
    GROUP BY "country_name"
)
SELECT 
       c."country_or_region",
       c."_4_20_20"::NUMBER                          AS "cases_4_20_2020",
       p."population_2020",
       (c."_4_20_20"::NUMBER / p."population_2020") * 100000 AS "cases_per_100k"
FROM   COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES c
JOIN   pop p
  ON   c."country_or_region" ILIKE '%' || SPLIT_PART(p."country_name", ',', 1) || '%'
WHERE  c."country_or_region" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
LIMIT 20;
```

```sql
--Description: 10) Final tidy query returning the requested metrics for the exact seven nations
WITH pop AS (
    SELECT 
           DECODE("country_name",
                  'Iran, Islamic Rep.', 'Iran',
                  'United States',      'United States',
                  'China',              'China',
                  'France',             'France',
                  'Italy',              'Italy',
                  'Spain',              'Spain',
                  'Germany',            'Germany')        AS "country_key",
           SUM("value") AS "population_2020"
    FROM   COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
    WHERE  "indicator_name" ILIKE '%Population, total%'
      AND  "year" = 2020
      AND  "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran, Islamic Rep.')
    GROUP BY "country_key"
)
SELECT 
       c."country_or_region"                           AS "country",
       c."_4_20_20"::NUMBER                            AS "confirmed_cases_4_20_2020",
       p."population_2020",
       ROUND( (c."_4_20_20"::NUMBER / p."population_2020") * 100000 , 2) AS "cases_per_100k"
FROM   COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES c
JOIN   pop p
  ON   c."country_or_region" = p."country_key"
WHERE  c."country_or_region" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
LIMIT 20;
```
