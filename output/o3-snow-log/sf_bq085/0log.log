JOIN   COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION p
       ON ( (s."country_region" = p."country_name")
            OR (s."country_region" = 'US' AND p."country_name" = 'United States') )
WHERE  s."date" = '2020-04-20'
  AND  p."year" = 2020
  AND  p."indicator_name" ILIKE '%Population%total%'
