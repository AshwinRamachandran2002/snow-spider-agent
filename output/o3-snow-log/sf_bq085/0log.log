```sql
--Description: Preview 20 rows from the JHU confirmed–cases wide table to understand basic structure and the “_4_20_20” column.
SELECT "country_or_region",
       "_4_20_20"
FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES
LIMIT 20;
```

```sql
--Description: Pull April-20-2020 confirmed-case figures for the seven target countries from the wide table.
SELECT "country_or_region",
       "_4_20_20"
FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES
WHERE "country_or_region" IN ('US', 'United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
LIMIT 20;
```

```sql
--Description: Take a quick look at the long-format SUMMARY table to see how dates and counts are stored.
SELECT "country_region",
       "date",
       "confirmed"
FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.SUMMARY
LIMIT 20;
```

```sql
--Description: Aggregate total confirmed counts on 2020-04-20 for each of the seven countries using the SUMMARY table.
SELECT "country_region",
       SUM("confirmed") AS total_confirmed
FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.SUMMARY
WHERE "date" = '2020-04-20'
  AND "country_region" IN ('US', 'United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
GROUP BY "country_region"
LIMIT 20;
```

```sql
--Description: Identify the exact World-Bank indicator(s) that hold total-population data.
SELECT DISTINCT "indicator_name"
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
WHERE "indicator_name" ILIKE '%Population%total%'
LIMIT 20;
```

```sql
--Description: Retrieve 2020 total-population values for the seven countries.
SELECT "country_name",
       "indicator_name",
       "value"            AS population_2020
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
WHERE "year" = 2020
  AND "indicator_name" ILIKE '%Population%total%'
  AND "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
LIMIT 20;
```

```sql
--Description: Combine wide confirmed-case numbers with 2020 populations to compute cases per 100,000 people.
SELECT c."country_or_region",
       c."_4_20_20"::NUMBER                AS confirmed_cases_2020_04_20,
       p."value"                           AS population_2020,
       (c."_4_20_20"::NUMBER / p."value") * 100000 AS cases_per_100k
FROM   COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES               c
JOIN   COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION p
       ON ( (c."country_or_region" = p."country_name")
            OR (c."country_or_region" = 'US' AND p."country_name" = 'United States') )
WHERE  p."year" = 2020
  AND  p."indicator_name" ILIKE '%Population%total%'
  AND  c."country_or_region" IN ('US', 'United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
LIMIT 20;
```

```sql
--Description: Cross-check the per-100k calculation using the SUMMARY table aggregated totals.
SELECT s."country_region",
       SUM(s."confirmed")                             AS total_confirmed,
       p."value"                                      AS population_2020,
       (SUM(s."confirmed") / p."value") * 100000      AS cases_per_100k
FROM   COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.SUMMARY s
JOIN   COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION p
       ON ( (s."country_region" = p."country_name")
            OR (s."country_region" = 'US' AND p."country_name" = 'United States') )
WHERE  s."date" = '2020-04-20'
  AND  p."year" = 2020
  AND  p."indicator_name" ILIKE '%Population%total%'
  AND  s."country_region" IN ('US', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
GROUP BY s."country_region",
         p."value"
LIMIT 20;
```

```sql
--Description: Show the 20 most populous countries in 2020 to contextualize population figures.
SELECT "country_name",
       "value" AS population_2020
FROM   COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
WHERE  "year" = 2020
  AND  "indicator_name" ILIKE '%Population%total%'
ORDER BY "value" DESC
LIMIT 20;
```

```sql
--Description: Check whether any country has multiple “total population” entries for 2020 (useful for deciding if we need to SUM).
SELECT "country_name",
       COUNT(*) AS entries_2020
FROM   COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
WHERE  "year" = 2020
  AND  "indicator_name" ILIKE '%Population%total%'
GROUP BY "country_name"
HAVING COUNT(*) > 1
LIMIT 20;
```
