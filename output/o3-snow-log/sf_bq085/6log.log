```sql
-- Description: Inspect the distinct World-Bank indicator names containing the word “Population”  
SELECT DISTINCT "indicator_name"
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
WHERE "indicator_name" ILIKE '%population%'
LIMIT 20;
```

```sql
-- Description: Display the 2020 “Population, total” entries for the seven target countries (raw view)
SELECT "country_name",
       "year",
       "value" AS "population"
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
WHERE "indicator_name" = 'Population, total'
  AND "year" = 2020
  AND "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
LIMIT 20;
```

```sql
-- Description: Aggregate population in 2020 for each of the seven countries (sum in case of multiple sub-rows)
SELECT "country_name",
       SUM("value") AS "population_2020"
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
WHERE "indicator_name" = 'Population, total'
  AND "year" = 2020
  AND "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
GROUP BY "country_name"
LIMIT 20;
```

```sql
-- Description: Prepare a cases CTE with numerical conversion, then show results (checks only)
WITH cte_cases AS (
    SELECT "country_or_region"    AS "country",
           "_4_20_20"::INTEGER    AS "cases_2020_04_20"
    FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES
    WHERE "country_or_region" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
)
SELECT *
FROM cte_cases
LIMIT 20;
```

```sql
-- Description: Join the confirmed cases with the 2020 population totals and calculate cases per 100,000  
WITH cte_cases AS (
    SELECT "country_or_region"    AS "country",
           "_4_20_20"::INTEGER    AS "cases_2020_04_20"
    FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES
    WHERE "country_or_region" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
),
cte_pop AS (
    SELECT "country_name"         AS "country",
           SUM("value")           AS "population_2020"
    FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
    WHERE "indicator_name" = 'Population, total'
      AND "year" = 2020
      AND "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
    GROUP BY "country_name"
)
SELECT c."country",
       c."cases_2020_04_20",
       p."population_2020",
       ROUND( (c."cases_2020_04_20" * 100000.0) / NULLIF(p."population_2020",0), 2 ) AS "cases_per_100k"
FROM cte_cases c
JOIN cte_pop  p
  ON c."country" = p."country"
LIMIT 20;
```

```sql
-- Description: The final ranked list, highest to lowest cases per 100,000 population (presentation order)
WITH cte_cases AS (
    SELECT "country_or_region"    AS "country",
           "_4_20_20"::INTEGER    AS "cases_2020_04_20"
    FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES
    WHERE "country_or_region" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
),
cte_pop AS (
    SELECT "country_name"         AS "country",
           SUM("value")           AS "population_2020"
    FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
    WHERE "indicator_name" = 'Population, total'
      AND "year" = 2020
      AND "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
    GROUP BY "country_name"
)
SELECT c."country",
       c."cases_2020_04_20",
       p."population_2020",
       ROUND( (c."cases_2020_04_20" * 100000.0) / NULLIF(p."population_2020",0), 2 ) AS "cases_per_100k"
FROM cte_cases c
JOIN cte_pop  p
  ON c."country" = p."country"
ORDER BY "cases_per_100k" DESC
LIMIT 20;
```

