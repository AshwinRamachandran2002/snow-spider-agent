Query:
--Description: Join confirmed cases (as of 20-Apr-2020) with aggregated 2020 population to produce cases per 100,000 people
SELECT
    pop."country_name"                                                          AS "country",
    CAST(cc."_4_20_20" AS NUMBER)                                               AS "confirmed_cases_2020_04_20",
    pop."population_2020_sum",
    (CAST(cc."_4_20_20" AS NUMBER) / pop."population_2020_sum") * 100000        AS "cases_per_100k"
FROM (
        SELECT
            h."country_name",
            SUM(h."value") AS "population_2020_sum"
        FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION h
        WHERE h."indicator_name" = 'Population, total'
          AND h."year" = 2020
          AND h."country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
        GROUP BY h."country_name"
     ) pop
JOIN COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES cc
  ON cc."country_or_region" = pop."country_name"
LIMIT 20;
