```sql
--Description: Quick look at COVID-19 confirmed cases on 20-Apr-2020 for the seven requested countries
SELECT
    c."country_or_region",
    c."_4_20_20"
FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES c
WHERE c."country_or_region" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
LIMIT 20;
```

```sql
--Description: Inspect a few rows of the JHU “SUMMARY” table for the United States around early-April-2022 (sanity check of structure)
SELECT
    s."country_region",
    s."date",
    s."confirmed"
FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.SUMMARY s
WHERE s."country_region" = 'US'
LIMIT 20;
```

```sql
--Description: Find the different World-Bank health-population indicators that include the word “population” (to locate the total-population series)
SELECT DISTINCT
    h."indicator_name"
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION h
WHERE h."indicator_name" ILIKE '%population%'
LIMIT 20;
```

```sql
--Description: Retrieve 2020 “Population, total” values for the seven countries of interest
SELECT
    h."country_name",
    h."value" AS "population_2020"
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION h
WHERE h."indicator_name" = 'Population, total'
  AND h."year" = 2020
  AND h."country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
LIMIT 20;
```

```sql
--Description: Verify whether more than one 2020 total-population record exists per country (for aggregation logic)
SELECT
    h."country_name",
    COUNT(*) AS "rows_2020_population_total"
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION h
WHERE h."indicator_name" = 'Population, total'
  AND h."year" = 2020
  AND h."country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
GROUP BY h."country_name"
LIMIT 20;
```

```sql
--Description: Build an aggregated sub-query that sums all 2020 population entries for each of the seven countries
SELECT
    h."country_name",
    SUM(h."value") AS "population_2020_sum"
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION h
WHERE h."indicator_name" = 'Population, total'
  AND h."year" = 2020
  AND h."country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
GROUP BY h."country_name"
LIMIT 20;
```

```sql
--Description: Join confirmed cases (as of 20-Apr-2020) with aggregated 2020 population to produce cases per 100,000 people
SELECT
    pop."country_name"                                                          AS "country",
    CAST(cc."_4_20_20" AS NUMBER)                                               AS "confirmed_cases_2020_04_20",
    pop."population_2020_sum",
    (CAST(cc."_4_20_20" AS NUMBER) / pop."population_2020_sum") * 100000        AS "cases_per_100k"
FROM (
        SELECT
            h."country_name",
            SUM(h."value") AS "population_2020_sum"
        FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION h
        WHERE h."indicator_name" = 'Population, total'
          AND h."year" = 2020
          AND h."country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
        GROUP BY h."country_name"
     ) pop
JOIN COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES cc
  ON cc."country_or_region" = pop."country_name"
LIMIT 20;
```

```sql
--Description: Same join as above, but ordered by cases per 100,000 (highest to lowest) for quick comparison
SELECT
    pop."country_name"                                                          AS "country",
    CAST(cc."_4_20_20" AS NUMBER)                                               AS "confirmed_cases_2020_04_20",
    pop."population_2020_sum",
    (CAST(cc."_4_20_20" AS NUMBER) / pop."population_2020_sum") * 100000        AS "cases_per_100k"
FROM (
        SELECT
            h."country_name",
            SUM(h."value") AS "population_2020_sum"
        FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION h
        WHERE h."indicator_name" = 'Population, total'
          AND h."year" = 2020
          AND h."country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
        GROUP BY h."country_name"
     ) pop
JOIN COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES cc
  ON cc."country_or_region" = pop."country_name"
ORDER BY "cases_per_100k" DESC
LIMIT 20;
```

```sql
--Description: Provide a concise projection (country, confirmed, cases/100k) rounded for reporting convenience
SELECT
    pop."country_name"                                                          AS "country",
    CAST(cc."_4_20_20" AS NUMBER)                                               AS "confirmed_cases_2020_04_20",
    ROUND((CAST(cc."_4_20_20" AS NUMBER) / pop."population_2020_sum") * 100000, 2) AS "cases_per_100k"
FROM (
        SELECT
            h."country_name",
            SUM(h."value") AS "population_2020_sum"
        FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION h
        WHERE h."indicator_name" = 'Population, total'
          AND h."year" = 2020
          AND h."country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
        GROUP BY h."country_name"
     ) pop
JOIN COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES cc
  ON cc."country_or_region" = pop."country_name"
ORDER BY pop."country_name"
LIMIT 20;
```

```sql
--Description: (Optional) Verify that population sums equal single record values (defensive step before relying on SUM)
SELECT
    a."country_name",
    a."population_2020_sum",
    b."value" AS "population_2020_single_record"
FROM (
      SELECT
          h."country_name",
          SUM(h."value") AS "population_2020_sum"
      FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION h
      WHERE h."indicator_name" = 'Population, total'
        AND h."year" = 2020
        AND h."country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
      GROUP BY h."country_name"
     ) a
LEFT JOIN COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION b
       ON b."country_name" = a."country_name"
      AND b."indicator_name" = 'Population, total'
      AND b."year" = 2020
LIMIT 20;
```
