```sql
--Description: 10) Final summary – confirmed cases on 20-Apr-2020, 2020 population, and cases per 100 K  
--              (handles “US” vs “United States”, matches other six countries by full name)
WITH cases AS (      -- pull the 20-Apr-2020 confirmed-case totals
    SELECT "country_or_region",
           TRY_CAST("_4_20_20" AS NUMBER) AS confirmed_20_apr_2020
    FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES
    WHERE REGEXP_LIKE("country_or_region",
                      '^US$|United\\s*States|France|China|Italy|Spain|Germany|Iran',
                      'i')
),
pop AS (             -- obtain 2020 total-population figures
    SELECT "country_name",
           SUM("value") AS population_2020
    FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
    WHERE "indicator_name" = 'Population, total'
      AND "year" = 2020
      AND REGEXP_LIKE("country_name",
                      'United\\s*States|France|China|Italy|Spain|Germany|Iran',
                      'i')
    GROUP BY "country_name"
)
SELECT
       CASE
           WHEN c."country_or_region" = 'US' THEN 'United States'
           ELSE c."country_or_region"
       END                                               AS country,
       c.confirmed_20_apr_2020,
       p.population_2020,
       ROUND( (c.confirmed_20_apr_2020 / p.population_2020) * 100000 , 2) AS cases_per_100k
FROM cases c
JOIN pop  p
  ON   (c."country_or_region" = 'US'          AND p."country_name" = 'United States')
   OR  (c."country_or_region" ILIKE p."country_name")
ORDER BY cases_per_100k DESC
LIMIT 20;
```
