LIMIT 20;
```

```sql
--Description: 4) Pull 2020 total-population figures for the seven countries
SELECT "country_name",
       "value"           AS "population_2020"
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
WHERE "indicator_name" = 'Population, total'
  AND "year"           = 2020
  AND "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
LIMIT 20;
```

```sql
--Description: 5) Check whether any country has multiple 2020 population rows (should normally be one)
SELECT "country_name",
       COUNT(*) AS "rows_2020_pop"
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
WHERE "indicator_name" = 'Population, total'
  AND "year"           = 2020
  AND "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
GROUP BY "country_name"
LIMIT 20;
```

```sql
--Description: 6) Sum 2020 total-population figures (handles the unlikely case of >1 row per country)
SELECT "country_name",
       SUM("value") AS "population_2020"
FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
WHERE "indicator_name" = 'Population, total'
  AND "year"           = 2020
  AND "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
GROUP BY "country_name"
LIMIT 20;
```

```sql
--Description: 7) Prepare a CTE that bundles per-country confirmed cases and 2020 population
WITH cases AS (
    SELECT "country_or_region",
           TRY_CAST("_4_20_20" AS NUMBER) AS "confirmed_20_apr_2020"
    FROM COVID19_JHU_WORLD_BANK.COVID19_JHU_CSSE.CONFIRMED_CASES
    WHERE "country_or_region" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
),
pop AS (
    SELECT "country_name",
           SUM("value") AS "population_2020"
    FROM COVID19_JHU_WORLD_BANK.WORLD_BANK_HEALTH_POPULATION.HEALTH_NUTRITION_POPULATION
    WHERE "indicator_name" = 'Population, total'
      AND "year"           = 2020
      AND "country_name" IN ('United States', 'France', 'China', 'Italy', 'Spain', 'Germany', 'Iran')
    GROUP BY "country_name"
)
SELECT c."country_or_region"  AS "country",
       c."confirmed_20_apr_2020",
       p."population_2020",
       ROUND( (c."confirmed_20_apr_2020" / p."population_2020") * 100000 , 2) AS "cases_per_100k"
FROM cases c
JOIN pop   p
  ON c."country_or_region" = p."country_name"
LIMIT 20;
```

