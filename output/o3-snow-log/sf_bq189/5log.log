--Description: 8)  Re-write the “average MoM order-growth” query with safer column aliases
WITH monthly AS (           -- monthly distinct-order counts
    SELECT
        p."category"                                               AS category,
        DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at" / 1e6)) AS month_start,
        COUNT(DISTINCT oi."order_id")                              AS completed_orders
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
          ON p."id" = oi."product_id"
    WHERE oi."status" = 'Complete'
    GROUP BY 1, 2
), growth AS (                -- MoM % growth for every category
    SELECT
        category,
        (completed_orders
         - LAG(completed_orders) OVER (PARTITION BY category ORDER BY month_start))
        / NULLIF(LAG(completed_orders) OVER (PARTITION BY category ORDER BY month_start), 0)
          AS pct_growth_orders
    FROM monthly
)
SELECT
    category,
    AVG(pct_growth_orders) AS avg_mom_order_growth
FROM growth
GROUP BY category
ORDER BY avg_mom_order_growth DESC
LIMIT 20
