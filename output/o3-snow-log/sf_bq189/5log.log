--Description: 5) Join completed order lines to their product information (category shown) to make sure the join keys behave as expected
SELECT oi."order_id",
       oi."product_id",
       p."category",
       oi."sale_price",
       oi."created_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
