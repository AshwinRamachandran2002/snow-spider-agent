--Description: 10) Using the same category, calculate monthly % revenue growth and its overall average  
WITH monthly_rev AS (
    SELECT  DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)) AS "month",
            SUM(oi."sale_price")                                       AS revenue
    FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
            ON p."id" = oi."product_id"
