            revenue,
            (revenue - LAG(revenue) OVER (ORDER BY month))
            /
            NULLIF(LAG(revenue) OVER (ORDER BY month),0)           AS pct_growth_revenue
    FROM    monthly_rev
)
SELECT  AVG(pct_growth_revenue) AS avg_mom_revenue_growth
FROM    rev_change
LIMIT 20;
