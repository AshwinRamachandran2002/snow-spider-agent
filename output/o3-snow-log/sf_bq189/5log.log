```sql
--Description: 7) For every category/month, compute the MoM % change in completed-order count
WITH monthly AS (
    SELECT p."category",
           DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)) AS "month",
           COUNT(DISTINCT oi."order_id")                              AS "completed_orders"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
           ON p."id" = oi."product_id"
    WHERE  oi."status" = 'Complete'
    GROUP  BY p."category",
              DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6))
)
SELECT  category,
        month,
        completed_orders,
        LAG(completed_orders) OVER (PARTITION BY category ORDER BY month)                AS prev_month_orders,
        (completed_orders - LAG(completed_orders) OVER (PARTITION BY category ORDER BY month))
        /
        NULLIF(LAG(completed_orders) OVER (PARTITION BY category ORDER BY month),0)      AS pct_growth_orders
FROM    monthly
ORDER BY category, month
LIMIT 20;
```

```sql
--Description: 8) Average the monthly order-growth rates per category and rank them
WITH monthly AS (
    SELECT p."category",
           DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)) AS "month",
           COUNT(DISTINCT oi."order_id")                              AS "completed_orders"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
           ON p."id" = oi."product_id"
    WHERE  oi."status" = 'Complete'
    GROUP  BY p."category",
              DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6))
), growth AS (
    SELECT category,
           (completed_orders - LAG(completed_orders) OVER (PARTITION BY category ORDER BY month))
           /
           NULLIF(LAG(completed_orders) OVER (PARTITION BY category ORDER BY month),0) AS pct_growth_orders
    FROM   monthly
)
SELECT category,
       AVG(pct_growth_orders) AS avg_mom_order_growth
FROM   growth
GROUP  BY category
ORDER  BY avg_mom_order_growth DESC
LIMIT 20;
```

