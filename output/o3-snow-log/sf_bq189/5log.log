```sql
--Description: 
-- End-to-end solution in ONE query:
--   1) Build monthly series of DISTINCT completed-order counts and revenue per product category.
--   2) Derive month-over-month (MoM) % growth for orders, then average it per category.
--   3) Pick the single category with the highest average MoM order-growth rate.
--   4) For that category only, compute MoM % growth in monthly revenue and take the average.
--   5) Output the winner, its avg order-growth %, and its avg revenue-growth %.
WITH monthly AS (   -- counts & revenue per (category, month)
    SELECT
        p."category"                                            AS category,
        DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at" / 1e6)) AS month_start,
        COUNT(DISTINCT oi."order_id")                           AS order_cnt,
        SUM(oi."sale_price")                                    AS revenue
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
          ON p."id" = oi."product_id"
    WHERE oi."status" = 'Complete'
    GROUP BY 1,2
), order_growth AS (         -- MoM % order growth for every category
    SELECT
        category,
        (order_cnt - LAG(order_cnt) OVER (PARTITION BY category ORDER BY month_start))
        / NULLIF(LAG(order_cnt) OVER (PARTITION BY category ORDER BY month_start),0) AS pct_order_growth
    FROM monthly
), avg_order_growth AS (     -- average MoM order growth per category
    SELECT
        category,
        AVG(pct_order_growth) AS avg_mom_order_growth
    FROM order_growth
    GROUP BY category
), top_category AS (         -- pick the category with the highest avg MoM order growth
    SELECT category, avg_mom_order_growth
    FROM   avg_order_growth
    QUALIFY ROW_NUMBER() OVER (ORDER BY avg_mom_order_growth DESC) = 1
), rev_growth AS (           -- MoM % revenue growth for the top category
    SELECT
        m.category,
        (m.revenue - LAG(m.revenue) OVER (PARTITION BY m.category ORDER BY m.month_start))
        / NULLIF(LAG(m.revenue) OVER (PARTITION BY m.category ORDER BY m.month_start),0) AS pct_rev_growth
    FROM monthly              m
    JOIN top_category         t  USING (category)
), avg_rev_growth AS (       -- average MoM revenue growth for that category
    SELECT
        category,
        AVG(pct_rev_growth) AS avg_mom_revenue_growth
    FROM rev_growth
    GROUP BY category
)
SELECT
    t.category                                AS highest_growth_category,
    t.avg_mom_order_growth,
    r.avg_mom_revenue_growth
FROM top_category t
JOIN avg_rev_growth r USING (category);
```
