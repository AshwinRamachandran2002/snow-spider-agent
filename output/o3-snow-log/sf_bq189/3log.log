Query:
--6. For each category, calculate the month-over-month % change in unique orders (first 20 rows shown)
WITH monthly_orders AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) AS "month",
           p."category",
           COUNT(DISTINCT oi."order_id") AS "unique_orders"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
         ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
    GROUP BY 1, 2
)
SELECT "month",
       "category",
       "unique_orders",
       LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "month")            AS "prev_month_orders",
       CASE 
           WHEN LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "month") = 0 THEN NULL
           ELSE ROUND(
               ("unique_orders" - LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "month"))
               / NULLIF(LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "month"), 0)
               * 100, 
           2)
       END                                                                             AS "pct_growth"
FROM monthly_orders
ORDER BY "category", "month"
LIMIT 20;
