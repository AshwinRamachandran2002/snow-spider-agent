),
growths AS (                ------------------------------------------------ Step 3
    SELECT
        "category",
        /* percentage change in orders */
        CASE 
            WHEN "prev_orders" IS NULL OR "prev_orders" = 0 THEN NULL
            ELSE ("orders" - "prev_orders") / "prev_orders" * 100 
        END AS "order_growth_pct",
        /* percentage change in revenue */
        CASE 
            WHEN "prev_revenue" IS NULL OR "prev_revenue" = 0 THEN NULL
            ELSE ("revenue" - "prev_revenue") / "prev_revenue" * 100 
        END AS "revenue_growth_pct"
    FROM with_lag
),
best_cat AS (              ------------------------------------------------ Step 4
    SELECT
        "category",
        AVG("order_growth_pct") AS "avg_order_growth_pct"
    FROM growths
    GROUP BY "category"
    ORDER BY "avg_order_growth_pct" DESC
    LIMIT 1
)
--------------------------- Final step: combine best category with its avg revenue growth
SELECT
    bc."category",
    bc."avg_order_growth_pct",
    ( SELECT AVG("revenue_growth_pct")
        FROM growths
        WHERE "category" = bc."category" ) AS "avg_revenue_growth_pct"
FROM best_cat bc;
