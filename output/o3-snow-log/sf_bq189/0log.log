```sql
--Description: One-query solution (thinking process embedded in comments). 
-- Task recap: 
--   1) Working only with completed order-items, calculate each category’s average
--      month-to-month % growth in distinct orders. 
--   2) Identify the category with the highest average growth. 
--   3) For that winning category, compute the average month-to-month % revenue growth. 
-- Strategy (inside a single WITH cascade):
--   • monthly_stats  – produce per-category, per-YYYY-MM order counts & revenue.  
--   • with_lag       – acquire previous-month values via LAG window fn.  
--   • growths        – derive % growth for both metrics.  
--   • best_cat       – pick category with the max avg order-growth %.  
--   • final SELECT   – report the winner along with its avg order- and revenue-growth %.  
WITH monthly_stats AS (      ------------------------------------------------ Step 1
    SELECT
        p."category"                                                    AS "category",
        TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at" / 1000000), 'YYYY-MM') AS "yr_mo",
        COUNT(DISTINCT oi."order_id")                                   AS "orders",
        SUM(oi."sale_price")                                            AS "revenue"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
          ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
    GROUP BY p."category", "yr_mo"
),
with_lag AS (               ------------------------------------------------ Step 2
    SELECT
        "category",
        "yr_mo",
        "orders",
        "revenue",
        LAG("orders")  OVER (PARTITION BY "category" ORDER BY "yr_mo") AS "prev_orders",
        LAG("revenue") OVER (PARTITION BY "category" ORDER BY "yr_mo") AS "prev_revenue"
    FROM monthly_stats
),
growths AS (                ------------------------------------------------ Step 3
    SELECT
        "category",
        /* percentage change in orders */
        CASE 
            WHEN "prev_orders" IS NULL OR "prev_orders" = 0 THEN NULL
            ELSE ("orders" - "prev_orders") / "prev_orders" * 100 
        END AS "order_growth_pct",
        /* percentage change in revenue */
        CASE 
            WHEN "prev_revenue" IS NULL OR "prev_revenue" = 0 THEN NULL
            ELSE ("revenue" - "prev_revenue") / "prev_revenue" * 100 
        END AS "revenue_growth_pct"
    FROM with_lag
),
best_cat AS (              ------------------------------------------------ Step 4
    SELECT
        "category",
        AVG("order_growth_pct") AS "avg_order_growth_pct"
    FROM growths
    GROUP BY "category"
    ORDER BY "avg_order_growth_pct" DESC
    LIMIT 1
)
--------------------------- Final step: combine best category with its avg revenue growth
SELECT
    bc."category",
    bc."avg_order_growth_pct",
    ( SELECT AVG("revenue_growth_pct")
        FROM growths
        WHERE "category" = bc."category" ) AS "avg_revenue_growth_pct"
FROM best_cat bc;
```
