```sql
--Description: 10) Compute the monthly percentage growth in unique orders for every product category, then average it (show 20 rows)  
WITH monthly_orders AS (
    SELECT p."category",
           TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000), 'YYYY-MM') AS "yr_mo",
           COUNT(DISTINCT oi."order_id")                                 AS "uniq_orders"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p
         ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
    GROUP BY p."category", "yr_mo"
), with_lag AS (
    SELECT category,
           yr_mo,
           uniq_orders,
           LAG(uniq_orders) OVER (PARTITION BY category ORDER BY yr_mo) AS prev_orders
    FROM monthly_orders
)
SELECT category,
       AVG(
           CASE 
               WHEN prev_orders IS NULL OR prev_orders = 0 THEN NULL
               ELSE (uniq_orders - prev_orders) / prev_orders * 100
           END
       ) AS avg_monthly_order_growth_pct
FROM with_lag
GROUP BY category
ORDER BY avg_monthly_order_growth_pct DESC
LIMIT 20;
```

These 10 exploratory queries progressively reveal the information required to calculate (1) the average monthly percentage growth in distinct orders per product category and (2) the corresponding revenue growth for the category with the highest order-growth rate.
