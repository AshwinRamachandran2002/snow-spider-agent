```sql
--Description: Compute monthly distinct completed orders by product category
SELECT p."category"                                              AS "product_category",
       TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at" / 1000000), 'YYYY-MM') AS "year_month",
       COUNT(DISTINCT oi."order_id")                              AS "monthly_unique_orders"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
  ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
GROUP BY p."category",
         TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at" / 1000000), 'YYYY-MM')
ORDER BY p."category", "year_month"
LIMIT 20;
```

```sql
--Description: For each category, calculate monthly % growth in unique orders
WITH monthly_orders AS (
  SELECT p."category" AS "product_category",
         TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at" / 1000000), 'YYYY-MM') AS "year_month",
         COUNT(DISTINCT oi."order_id") AS "unique_orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
    ON oi."product_id" = p."id"
  WHERE oi."status" = 'Complete'
  GROUP BY p."category",
           TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at" / 1000000), 'YYYY-MM')
)
SELECT "product_category",
       "year_month",
       "unique_orders",
       LAG("unique_orders") OVER (PARTITION BY "product_category" ORDER BY "year_month") AS "previous_month_orders",
       ROUND(
         100.0 * ("unique_orders" - LAG("unique_orders") OVER (PARTITION BY "product_category" ORDER BY "year_month"))
         / NULLIF(LAG("unique_orders") OVER (PARTITION BY "product_category" ORDER BY "year_month"), 0), 2
       ) AS "pct_growth_orders"
FROM monthly_orders
ORDER BY "product_category", "year_month"
LIMIT 20;
```

```sql
--Description: Average monthly order growth rate per category to find the leader
WITH monthly_orders AS (
  SELECT p."category" AS "product_category",
         TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at" / 1000000), 'YYYY-MM') AS "year_month",
         COUNT(DISTINCT oi."order_id") AS "unique_orders"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
    ON oi."product_id" = p."id"
  WHERE oi."status" = 'Complete'
  GROUP BY p."category",
           TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at" / 1000000), 'YYYY-MM')
), growth AS (
  SELECT "product_category",
         ("unique_orders" - LAG("unique_orders") OVER (PARTITION BY "product_category" ORDER BY "year_month"))
         / NULLIF(LAG("unique_orders") OVER (PARTITION BY "product_category" ORDER BY "year_month"), 0) * 100 AS "pct_growth_orders"
  FROM monthly_orders
)
SELECT "product_category",
       ROUND(AVG("pct_growth_orders"), 2) AS "avg_monthly_order_growth_pct"
FROM growth
WHERE "pct_growth_orders" IS NOT NULL
GROUP BY "product_category"
ORDER BY "avg_monthly_order_growth_pct" DESC
LIMIT 20;
```

```sql
--Description: For the category with the highest order-growth (replace 'Accessories' once identified), compute average monthly revenue growth
WITH completed_items AS (
  SELECT oi."order_id",
         p."category" AS "product_category",
         oi."sale_price",
         TO_CHAR(TO_TIMESTAMP_LTZ(oi."created_at" / 1000000), 'YYYY-MM') AS "year_month"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
  JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
    ON oi."product_id" = p."id"
  WHERE oi."status" = 'Complete'
    AND p."category" = 'Accessories'         -- change if another category wins
), monthly_rev AS (
  SELECT "year_month",
         SUM("sale_price") AS "monthly_revenue"
  FROM completed_items
  GROUP BY "year_month"
), rev_growth AS (
  SELECT "year_month",
         "monthly_revenue",
         ("monthly_revenue" - LAG("monthly_revenue") OVER (ORDER BY "year_month"))
         / NULLIF(LAG("monthly_revenue") OVER (ORDER BY "year_month"), 0) * 100 AS "pct_growth_revenue"
  FROM monthly_rev
)
SELECT ROUND(AVG("pct_growth_revenue"), 2) AS "avg_monthly_revenue_growth_pct"
FROM rev_growth
WHERE "pct_growth_revenue" IS NOT NULL
LIMIT 20;
```
