--Description: 
-- Show the month-by-month revenue trend for the single product category that
-- has the highest average month-to-month order-growth rate.
-- (Fixed to avoid using an aggregate inside a window function.)
WITH monthly_orders AS (                       -- step-1: unique orders per category & month
    SELECT p."category",
           DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000))  AS "order_month",
           COUNT(DISTINCT oi."order_id")                                     AS "unique_orders"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
         ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
    GROUP BY p."category",
             DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000))
), order_growth AS (                         -- step-2: % growth in unique orders
    SELECT mo."category",
           mo."order_month",
           mo."unique_orders",
           (mo."unique_orders" - LAG(mo."unique_orders") OVER (PARTITION BY mo."category" ORDER BY mo."order_month"))
           / NULLIF(LAG(mo."unique_orders") OVER (PARTITION BY mo."category" ORDER BY mo."order_month"), 0)
           AS "pct_growth_orders"
    FROM monthly_orders mo
), best_category AS (                        -- step-3: category with highest avg order-growth
    SELECT "category"
    FROM (
        SELECT "category",
               AVG("pct_growth_orders") AS "avg_order_growth"
        FROM order_growth
        WHERE "pct_growth_orders" IS NOT NULL
        GROUP BY "category"
        ORDER BY "avg_order_growth" DESC
        LIMIT 1
    )
), monthly_rev AS (                          -- step-4: revenue per category & month
    SELECT p."category",
           DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000)) AS "order_month",
           SUM(oi."sale_price")                                            AS "revenue"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
         ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
    GROUP BY p."category",
             DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000))
)                                         -- step-5: output the trend for that best category
SELECT mr."order_month",
       mr."revenue"
FROM   monthly_rev    mr
JOIN   best_category  bc  ON mr."category" = bc."category"
ORDER  BY mr."order_month"
LIMIT 20;
