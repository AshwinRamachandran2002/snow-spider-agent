```sql
--Description: 5) Join ORDER_ITEMS (only Complete) with PRODUCTS to see category information together.
SELECT oi."order_id",
       oi."product_id",
       p."category",
       oi."created_at",
       oi."sale_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS  p
     ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: 6) Convert the micro-second epoch to month granularity and count distinct orders per category per month.
SELECT p."category",
       DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000)) AS "order_month",
       COUNT(DISTINCT oi."order_id") AS "unique_orders"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS  p
     ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
GROUP BY p."category",
         DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000))
ORDER BY p."category",
         "order_month"
LIMIT 20;
```

```sql
--Description: 7) For each category, calculate the month-to-month % growth in unique orders.
WITH monthly_orders AS (
    SELECT p."category",
           DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000)) AS "order_month",
           COUNT(DISTINCT oi."order_id") AS "unique_orders"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS  p
         ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
    GROUP BY p."category",
             DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000))
)
SELECT mo."category",
       mo."order_month",
       mo."unique_orders",
       LAG(mo."unique_orders") OVER (PARTITION BY mo."category"
                                     ORDER BY mo."order_month") AS "prev_month_orders",
       CASE
           WHEN LAG(mo."unique_orders") OVER (PARTITION BY mo."category" ORDER BY mo."order_month") IS NULL
           THEN NULL
           ELSE (mo."unique_orders" - LAG(mo."unique_orders") OVER (PARTITION BY mo."category" ORDER BY mo."order_month"))
                / NULLIF(LAG(mo."unique_orders") OVER (PARTITION BY mo."category" ORDER BY mo."order_month"), 0)
       END AS "pct_growth_orders"
FROM monthly_orders mo
ORDER BY mo."category",
         mo."order_month"
LIMIT 20;
```

```sql
--Description: 8) Average the monthly % growth in unique orders for each product category.
WITH monthly_orders AS (
    SELECT p."category",
           DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000)) AS "order_month",
           COUNT(DISTINCT oi."order_id") AS "unique_orders"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS  p
         ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
    GROUP BY p."category",
             DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000))
), growth AS (
    SELECT mo."category",
           (mo."unique_orders" - LAG(mo."unique_orders") OVER (PARTITION BY mo."category" ORDER BY mo."order_month"))
           / NULLIF(LAG(mo."unique_orders") OVER (PARTITION BY mo."category" ORDER BY mo."order_month"), 0)
           AS "pct_growth_orders"
    FROM monthly_orders mo
)
SELECT "category",
       AVG("pct_growth_orders") AS "avg_monthly_order_growth"
FROM growth
WHERE "pct_growth_orders" IS NOT NULL
GROUP BY "category"
ORDER BY "avg_monthly_order_growth" DESC
LIMIT 20;
```

```sql
--Description: 9) For the category with the highest avg order-growth, compute month-to-month % revenue growth.
WITH complete_items AS (
    SELECT oi."order_id",
           oi."product_id",
           oi."sale_price",
           TO_TIMESTAMP_LTZ(oi."created_at" / 1000000)                 AS "order_ts"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    WHERE oi."status" = 'Complete'
), joined AS (
    SELECT ci."order_id",
           ci."sale_price",
           DATE_TRUNC('month', ci."order_ts")                           AS "order_month",
           p."category"
    FROM complete_items ci
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
         ON ci."product_id" = p."id"
), monthly_rev AS (
    SELECT "category",
           "order_month",
           SUM("sale_price") AS "revenue"
    FROM joined
    GROUP BY "category", "order_month"
), best_cat AS (
    SELECT "category"
    FROM (
        SELECT "category",
               AVG( ( "revenue" - LAG("revenue") OVER (PARTITION BY "category" ORDER BY "order_month") )
                    / NULLIF(LAG("revenue") OVER (PARTITION BY "category" ORDER BY "order_month"), 0) ) 
               AS "avg_rev_growth"
        FROM monthly_rev
        GROUP BY "category"
    )
    ORDER BY "avg_rev_growth" DESC
    LIMIT 1
), revenue_growth AS (
    SELECT mr."category",
           mr."order_month",
           mr."revenue",
           LAG(mr."revenue") OVER (PARTITION BY mr."category" ORDER BY mr."order_month") AS "prev_revenue",
           (mr."revenue" - LAG(mr."revenue") OVER (PARTITION BY mr."category" ORDER BY mr."order_month"))
           / NULLIF(LAG(mr."revenue") OVER (PARTITION BY mr."category" ORDER BY mr."order_month"), 0)
           AS "pct_rev_growth"
    FROM monthly_rev mr
    JOIN best_cat bc
         ON mr."category" = bc."category"
)
SELECT "category",
       AVG("pct_rev_growth") AS "avg_monthly_revenue_growth"
FROM revenue_growth
WHERE "pct_rev_growth" IS NOT NULL
GROUP BY "category"
LIMIT 20;
```

```sql
--Description: 10) Display the month-by-month revenue trend for that top-growing category (sanity check).
WITH best_category AS (
    /* From query #8 or #9 you will know the category name – here we capture it dynamically */
    SELECT "category"
    FROM (
        SELECT "category",
               AVG("pct_growth_orders") AS "avg_growth"
        FROM (
            SELECT p."category",
                   DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000)) AS "order_month",
                   COUNT(DISTINCT oi."order_id")                                   AS "unique_orders",
                   (COUNT(DISTINCT oi."order_id") - 
                       LAG(COUNT(DISTINCT oi."order_id")) 
                       OVER (PARTITION BY p."category" ORDER BY DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000))))
                   / NULLIF(LAG(COUNT(DISTINCT oi."order_id")) 
                       OVER (PARTITION BY p."category" ORDER BY DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000))), 0)
                   AS "pct_growth_orders"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
            JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
                 ON oi."product_id" = p."id"
            WHERE oi."status" = 'Complete'
            GROUP BY p."category",
                     DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000))
        ) 
        WHERE "pct_growth_orders" IS NOT NULL
        GROUP BY "category"
        ORDER BY "avg_growth" DESC
        LIMIT 1
    )
)
SELECT mr."order_month",
       mr."revenue"
FROM (
    SELECT p."category",
           DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000)) AS "order_month",
           SUM(oi."sale_price")                                             AS "revenue"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS  p
         ON oi."product_id" = p."id"
    WHERE oi."status" = 'Complete'
    GROUP BY p."category",
             DATE_TRUNC('month', TO_TIMESTAMP_LTZ(oi."created_at" / 1000000))
) mr
JOIN best_category bc
     ON mr."category" = bc."category"
ORDER BY mr."order_month"
LIMIT 20;
```
