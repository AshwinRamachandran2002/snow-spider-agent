```sql
--Description: Look at a few “Complete” order-items to understand their time-stamp and price information.
SELECT "id",
       "order_id",
       "user_id",
       "product_id",
       "sale_price",
       "created_at",
       "shipped_at",
       "delivered_at",
       "status"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
WHERE "status" = 'Complete'
LIMIT 20;
```

```sql
--Description: Join order-items to products to pull the product “category” for each completed order-item.
SELECT oi."id",
       oi."order_id",
       oi."created_at",
       p."category"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
     ON oi."product_id" = p."id"
WHERE oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: Get the monthly distinct-order count for a single sample category (“Accessories” here).
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))  AS "order_month",
       COUNT(DISTINCT oi."order_id")                              AS "unique_orders"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  oi."status" = 'Complete'
  AND  p."category" = 'Accessories'
GROUP  BY 1
ORDER  BY 1
LIMIT 20;
```

```sql
--Description: Produce the monthly distinct-order count for every product category.
SELECT p."category",
       DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))  AS "order_month",
       COUNT(DISTINCT oi."order_id")                              AS "unique_orders"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  oi."status" = 'Complete'
GROUP  BY p."category", "order_month"
ORDER  BY p."category", "order_month"
LIMIT 20;
```

```sql
--Description: For every category, calculate month-over-month % growth in unique-order counts.
SELECT  category_stats."category",
        category_stats."order_month",
        category_stats."unique_orders",
        100.0 * (category_stats."unique_orders" 
                 - LAG(category_stats."unique_orders")
                   OVER (PARTITION BY category_stats."category" ORDER BY category_stats."order_month"))
        / NULLIF(LAG(category_stats."unique_orders") 
                   OVER (PARTITION BY category_stats."category" ORDER BY category_stats."order_month"),0) 
        AS "pct_growth_orders"
FROM   (
        SELECT p."category",
               DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))  AS "order_month",
               COUNT(DISTINCT oi."order_id")                              AS "unique_orders"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
        JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
               ON oi."product_id" = p."id"
        WHERE  oi."status" = 'Complete'
        GROUP  BY p."category", "order_month"
       ) AS category_stats
ORDER  BY category_stats."category", category_stats."order_month"
LIMIT 20;
```

```sql
--Description: Compute the average of those monthly % growth rates (ignoring NULLs) for each category.
SELECT "category",
       AVG("pct_growth_orders")  AS "avg_monthly_order_growth_pct"
FROM (
        SELECT  category_stats."category",
                100.0 * (category_stats."unique_orders" 
                         - LAG(category_stats."unique_orders")
                           OVER (PARTITION BY category_stats."category" ORDER BY category_stats."order_month"))
                / NULLIF(LAG(category_stats."unique_orders") 
                           OVER (PARTITION BY category_stats."category" ORDER BY category_stats."order_month"),0) 
                AS "pct_growth_orders"
        FROM (
                SELECT p."category",
                       DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))  AS "order_month",
                       COUNT(DISTINCT oi."order_id")                              AS "unique_orders"
                FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
                JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
                       ON oi."product_id" = p."id"
                WHERE  oi."status" = 'Complete'
                GROUP  BY p."category", "order_month"
             ) category_stats
      ) growths
GROUP BY "category"
ORDER BY "avg_monthly_order_growth_pct" DESC
LIMIT 20;
```

```sql
--Description: Identify (and display) the single category with the highest average monthly order-growth rate.
SELECT *
FROM (
        SELECT "category",
               AVG("pct_growth_orders") AS "avg_monthly_order_growth_pct"
        FROM (
                SELECT  category_stats."category",
                        100.0 * (category_stats."unique_orders" 
                                 - LAG(category_stats."unique_orders")
                                   OVER (PARTITION BY category_stats."category" ORDER BY category_stats."order_month"))
                        / NULLIF(LAG(category_stats."unique_orders") 
                                   OVER (PARTITION BY category_stats."category" ORDER BY category_stats."order_month"),0) 
                        AS "pct_growth_orders"
                FROM (
                        SELECT p."category",
                               DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))  AS "order_month",
                               COUNT(DISTINCT oi."order_id")                              AS "unique_orders"
                        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
                        JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
                               ON oi."product_id" = p."id"
                        WHERE  oi."status" = 'Complete'
                        GROUP  BY p."category", "order_month"
                     ) category_stats
             ) growths
        GROUP BY "category"
     ) ranked
ORDER BY "avg_monthly_order_growth_pct" DESC
LIMIT 1;
```

```sql
--Description: For the top-growth category (replace <TOP_CATEGORY> by the actual value), compute its monthly revenue.
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000))  AS "order_month",
       SUM(oi."sale_price")                                       AS "monthly_revenue"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  oi."status" = 'Complete'
  AND  p."category" = '<TOP_CATEGORY>'          -- <- substitute with category from previous query
GROUP  BY "order_month"
ORDER  BY "order_month"
LIMIT 20;
```

```sql
--Description: Calculate month-over-month % growth in revenue for the top category and its overall average.
SELECT AVG("pct_growth_revenue") AS "avg_monthly_revenue_growth_pct"
FROM (
        SELECT rev."order_month",
               rev."monthly_revenue",
               100.0 * (rev."monthly_revenue" 
                        - LAG(rev."monthly_revenue")
                          OVER (ORDER BY rev."order_month"))
               / NULLIF(LAG(rev."monthly_revenue") 
                          OVER (ORDER BY rev."order_month"),0)    AS "pct_growth_revenue"
        FROM (
                SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
                       SUM(oi."sale_price")                                      AS "monthly_revenue"
                FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
                JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
                       ON oi."product_id" = p."id"
                WHERE  oi."status" = 'Complete'
                  AND  p."category" = '<TOP_CATEGORY>'       -- <- use the same category
                GROUP  BY "order_month"
             ) rev
      ) growths;
```

