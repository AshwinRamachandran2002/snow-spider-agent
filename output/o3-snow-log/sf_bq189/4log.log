--Description / Thinking process:
-- Replace the <TOP_CATEGORY> placeholder with the identified top-growth category “Clothing Sets”.
-- 1) Build an inner query (rev) to obtain monthly revenue (SUM of sale_price) for completed orders in that category.
-- 2) In the outer query, calculate the month-over-month percentage change in revenue (pct_growth_revenue) using LAG.
-- 3) Finally, take the overall average of these monthly growth rates.
SELECT AVG("pct_growth_revenue") AS "avg_monthly_revenue_growth_pct"
FROM (
        SELECT  rev."order_month",
                rev."monthly_revenue",
                100.0 * (rev."monthly_revenue"
                         - LAG(rev."monthly_revenue") OVER (ORDER BY rev."order_month"))
                      / NULLIF(LAG(rev."monthly_revenue") OVER (ORDER BY rev."order_month"), 0)
                      AS "pct_growth_revenue"
        FROM (
                SELECT  DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) AS "order_month",
                        SUM(oi."sale_price")                                         AS "monthly_revenue"
                FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
                JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
                        ON oi."product_id" = p."id"
                WHERE   oi."status"   = 'Complete'
                  AND   p."category"  = 'Clothing Sets'   -- substituted top category
                GROUP BY "order_month"
             ) rev
     ) growths
