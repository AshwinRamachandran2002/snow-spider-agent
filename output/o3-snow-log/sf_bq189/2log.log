--Description: Compute the average monthly revenue-growth rate for the highest-growth
--             category (“Clothing Sets”), avoiding the placeholder and ensuring
--             the ORDER_MONTH column is present in each step.
WITH monthly_revenue AS (               -- monthly revenue for Clothing Sets
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000)) AS "order_month",
        SUM(oi."sale_price")                                         AS "revenue"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
          ON p."id" = oi."product_id"
    WHERE p."category" = 'Clothing Sets'
    GROUP BY 1
),
ordered AS (                           -- bring previous-month revenue
    SELECT
        "order_month",
        "revenue",
        LAG("revenue") OVER (ORDER BY "order_month") AS "prev_revenue"
    FROM monthly_revenue
),
pct AS (                               -- % revenue growth month-to-month
    SELECT
        CASE WHEN "prev_revenue" > 0 THEN
             ("revenue" - "prev_revenue") / "prev_revenue" * 100
        END AS "pct_growth_revenue"
    FROM ordered
)
SELECT
    AVG("pct_growth_revenue") AS "avg_monthly_revenue_growth_pct"
FROM pct
