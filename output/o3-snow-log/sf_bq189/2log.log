```sql
--Description: Show the distribution of months present in ORDER_ITEMS (micro-seconds ➜ month).
SELECT DISTINCT
    DATE_TRUNC('month', TO_TIMESTAMP("created_at" / 1000000))            AS "order_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: Join ORDER_ITEMS (only ‘Complete’) with PRODUCTS, aggregating unique orders per month & category.
SELECT
    DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))         AS "order_month",
    p."category",
    COUNT(DISTINCT oi."order_id")                                        AS "unique_orders"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS         p
  ON p."id" = oi."product_id"
WHERE oi."status" = 'Complete'
GROUP BY 1, 2
ORDER BY 1, 2
LIMIT 20;
```

```sql
--Description: Compute month-to-month percentage growth in unique orders for every product category.
WITH monthly_orders AS (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))     AS "order_month",
        p."category",
        COUNT(DISTINCT oi."order_id")                                    AS "unique_orders"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS    p
      ON p."id" = oi."product_id"
    WHERE oi."status" = 'Complete'
    GROUP BY 1, 2
),
ordered AS (
    SELECT
        "category",
        "order_month",
        "unique_orders",
        LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month") AS "prev_orders"
    FROM monthly_orders
)
SELECT
    "category",
    "order_month",
    "unique_orders",
    "prev_orders",
    CASE WHEN "prev_orders" > 0 THEN 
        ("unique_orders" - "prev_orders") / "prev_orders" * 100
    END                                                               AS "pct_growth_orders"
FROM ordered
ORDER BY "category", "order_month"
LIMIT 20;
```

```sql
--Description: Average the monthly unique-order growth rates for each category.
WITH monthly_orders AS (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))     AS "order_month",
        p."category",
        COUNT(DISTINCT oi."order_id")                                    AS "unique_orders"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS    p
      ON p."id" = oi."product_id"
    WHERE oi."status" = 'Complete'
    GROUP BY 1, 2
),
ordered AS (
    SELECT
        "category",
        "order_month",
        "unique_orders",
        LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month") AS "prev_orders"
    FROM monthly_orders
),
pct AS (
    SELECT
        "category",
        CASE WHEN "prev_orders" > 0 THEN 
            ("unique_orders" - "prev_orders") / "prev_orders" * 100
        END AS "pct_growth_orders"
    FROM ordered
)
SELECT
    "category",
    AVG("pct_growth_orders") AS "avg_monthly_order_growth_pct"
FROM pct
GROUP BY "category"
ORDER BY "avg_monthly_order_growth_pct" DESC
LIMIT 20;
```

```sql
--Description: Identify the single product category with the highest average monthly order-growth rate.
WITH monthly_orders AS (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))     AS "order_month",
        p."category",
        COUNT(DISTINCT oi."order_id")                                    AS "unique_orders"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS    p
      ON p."id" = oi."product_id"
    WHERE oi."status" = 'Complete'
    GROUP BY 1, 2
),
ordered AS (
    SELECT
        "category",
        "order_month",
        "unique_orders",
        LAG("unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month") AS "prev_orders"
    FROM monthly_orders
),
pct AS (
    SELECT
        "category",
        CASE WHEN "prev_orders" > 0 THEN 
            ("unique_orders" - "prev_orders") / "prev_orders" * 100
        END AS "pct_growth_orders"
    FROM ordered
),
avg_growth AS (
    SELECT
        "category",
        AVG("pct_growth_orders") AS "avg_monthly_order_growth_pct"
    FROM pct
    GROUP BY "category"
)
SELECT 
    "category"
FROM avg_growth
ORDER BY "avg_monthly_order_growth_pct" DESC
LIMIT 1;
```

```sql
--Description: For the top-growing category (replace %%TOP_CAT%% with result), compute monthly revenue & its growth.
WITH monthly_revenue AS (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))     AS "order_month",
        p."category",
        SUM(oi."sale_price")                                             AS "revenue"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS    p
      ON p."id" = oi."product_id"
    WHERE oi."status" = 'Complete'
      AND p."category" = '%%TOP_CAT%%'          -- replace with real category from previous query
    GROUP BY 1, 2
),
ordered AS (
    SELECT
        "order_month",
        "revenue",
        LAG("revenue") OVER (ORDER BY "order_month") AS "prev_revenue"
    FROM monthly_revenue
)
SELECT
    "order_month",
    "revenue",
    "prev_revenue",
    CASE WHEN "prev_revenue" > 0 THEN 
        ("revenue" - "prev_revenue") / "prev_revenue" * 100
    END AS "pct_growth_revenue"
FROM ordered
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: Compute the average monthly revenue growth rate for the top-growing category.
WITH monthly_revenue AS (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1000000))     AS "order_month",
        p."category",
        SUM(oi."sale_price")                                             AS "revenue"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS    p
      ON p."id" = oi."product_id"
    WHERE oi."status" = 'Complete'
      AND p."category" = '%%TOP_CAT%%'           -- replace with real category
    GROUP BY 1, 2
),
ordered AS (
    SELECT
        "revenue",
        LAG("revenue") OVER (ORDER BY "order_month") AS "prev_revenue"
    FROM monthly_revenue
),
pct AS (
    SELECT
        CASE WHEN "prev_revenue" > 0 THEN 
            ("revenue" - "prev_revenue") / "prev_revenue" * 100
        END AS "pct_growth_revenue"
    FROM ordered
)
SELECT
    AVG("pct_growth_revenue") AS "avg_monthly_revenue_growth_pct"
FROM pct;
```
