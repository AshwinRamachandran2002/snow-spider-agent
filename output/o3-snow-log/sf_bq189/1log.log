```sql
--Description: 1) Look at the different values stored in the "status" column of order-level data  
SELECT DISTINCT "status"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: 2) Show a few example rows for only those order items whose status is ‘Complete’  
SELECT *
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
WHERE "status" = 'Complete'
LIMIT 20;
```

```sql
--Description: 3) Join completed order items to product information in order to see category, price, and other useful columns  
SELECT oi."order_id",
       oi."product_id",
       p."category",
       p."department",
       oi."sale_price",
       oi."created_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: 4) Convert the micro-second epoch in "created_at" to a calendar month (YYYY-MM) for every completed order item  
SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6), 'YYYY-MM')         AS "order_month",
       oi."order_id",
       p."category",
       oi."sale_price"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: 5) For each product category and month, count the DISTINCT orders that were completed  
SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6), 'YYYY-MM') AS "order_month",
       p."category",
       COUNT(DISTINCT oi."order_id")                             AS "num_unique_orders"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  oi."status" = 'Complete'
GROUP  BY 1, 2
ORDER  BY 2, 1
LIMIT 20;
```

```sql
--Description: 6) Add month-over-month % growth in unique orders for every category using the LAG window function  
SELECT "category",
       "order_month",
       "num_unique_orders",
       ROUND(100.0 * ("num_unique_orders" - LAG("num_unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month")) 
                    / NULLIF(LAG("num_unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month"),0), 2) 
              AS "pct_order_growth"
FROM (
        SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6), 'YYYY-MM') AS "order_month",
               p."category",
               COUNT(DISTINCT oi."order_id")                             AS "num_unique_orders"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
        JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
               ON oi."product_id" = p."id"
        WHERE  oi."status" = 'Complete'
        GROUP  BY 1, 2
     ) t
ORDER BY "category", "order_month"
LIMIT 20;
```

```sql
--Description: 7) Compute the AVERAGE of those monthly % growth values for every product category  
SELECT "category",
       AVG("pct_order_growth") AS "avg_mo_pct_order_growth"
FROM (
        SELECT "category",
               "order_month",
               ROUND(100.0 * ("num_unique_orders" - LAG("num_unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month")) 
                            / NULLIF(LAG("num_unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month"),0), 2) 
                     AS "pct_order_growth"
        FROM (
                SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6), 'YYYY-MM') AS "order_month",
                       p."category",
                       COUNT(DISTINCT oi."order_id")                             AS "num_unique_orders"
                FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
                JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
                       ON oi."product_id" = p."id"
                WHERE  oi."status" = 'Complete'
                GROUP  BY 1, 2
             )
     )
GROUP BY "category"
ORDER BY "avg_mo_pct_order_growth" DESC
LIMIT 20;
```

```sql
--Description: 8) Identify the single category that has the highest average monthly unique-order growth rate  
SELECT "category"
FROM (
        SELECT "category",
               AVG("pct_order_growth") AS "avg_mo_pct_order_growth"
        FROM (
                SELECT "category",
                       "order_month",
                       ROUND(100.0 * ("num_unique_orders" - LAG("num_unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month")) 
                                    / NULLIF(LAG("num_unique_orders") OVER (PARTITION BY "category" ORDER BY "order_month"),0), 2) 
                             AS "pct_order_growth"
                FROM (
                        SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6), 'YYYY-MM') AS "order_month",
                               p."category",
                               COUNT(DISTINCT oi."order_id")                             AS "num_unique_orders"
                        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
                        JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
                               ON oi."product_id" = p."id"
                        WHERE  oi."status" = 'Complete'
                        GROUP  BY 1, 2
                     )
         )
        GROUP BY "category"
        ORDER BY "avg_mo_pct_order_growth" DESC
        LIMIT 1
     )
LIMIT 20;
```

```sql
--Description: 9) Using that top-performing category (replace <TOP_CATEGORY> with the value returned above), compute total monthly revenue  
SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6), 'YYYY-MM') AS "order_month",
       SUM(oi."sale_price")                                      AS "monthly_revenue"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  oi."status" = 'Complete'
  AND  p."category" = '<TOP_CATEGORY>'
GROUP  BY 1
ORDER  BY 1
LIMIT 20;
```

```sql
--Description: 10) Calculate month-over-month % revenue change for that category and then average those values to get the category’s average monthly revenue growth rate  
SELECT AVG("pct_revenue_growth") AS "avg_mo_pct_revenue_growth"
FROM (
        SELECT "order_month",
               "monthly_revenue",
               ROUND(100.0 * ("monthly_revenue" - LAG("monthly_revenue") OVER (ORDER BY "order_month")) 
                            / NULLIF(LAG("monthly_revenue") OVER (ORDER BY "order_month"),0), 2) 
                     AS "pct_revenue_growth"
        FROM (
                SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6), 'YYYY-MM') AS "order_month",
                       SUM(oi."sale_price")                                      AS "monthly_revenue"
                FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
                JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
                       ON oi."product_id" = p."id"
                WHERE  oi."status" = 'Complete'
                  AND  p."category" = '<TOP_CATEGORY>'
                GROUP  BY 1
             )
     )
LIMIT 20;
```
