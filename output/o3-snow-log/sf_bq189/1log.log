```sql
--Description:  One-stop query that (a) isolates completed orders for the best-performing category (“Clothing Sets”),
--              (b) aggregates them by calendar month to obtain both DISTINCT-order counts and revenue,
--              (c) calculates month-over-month % changes for each metric with window functions, and
--              (d) returns the average of those monthly percentage changes.
WITH monthly AS (                               -- step-1: monthly order count & revenue
    SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1e6),'YYYY-MM') AS "month",
           COUNT(DISTINCT oi."order_id")                            AS "orders",
           SUM(oi."sale_price")                                    AS "revenue"
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
           ON oi."product_id" = p."id"
    WHERE  oi."status"  = 'Complete'
      AND  p."category" = 'Clothing Sets'
    GROUP  BY 1
),
growth AS (                                   -- step-2: MoM % growth for orders & revenue
    SELECT "month",
           100 * ("orders"  - LAG("orders")  OVER (ORDER BY "month"))
                 / NULLIF(LAG("orders")  OVER (ORDER BY "month"),0)  AS "order_growth_pct",
           100 * ("revenue" - LAG("revenue") OVER (ORDER BY "month"))
                 / NULLIF(LAG("revenue") OVER (ORDER BY "month"),0)  AS "revenue_growth_pct"
    FROM   monthly
)
SELECT AVG("order_growth_pct")   AS "avg_mo_order_growth_pct",
       AVG("revenue_growth_pct") AS "avg_mo_revenue_growth_pct"
FROM   growth
WHERE  "order_growth_pct"  IS NOT NULL         -- exclude the first month which has no prior month to compare
  AND  "revenue_growth_pct" IS NOT NULL;
```
