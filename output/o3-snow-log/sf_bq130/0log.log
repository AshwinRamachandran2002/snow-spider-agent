```sql
--Description: 1) Peek at state-level COVID numbers to confirm date coverage around spring-2020  
SELECT "date",
       "state_name",
       "confirmed_cases",
       "deaths"
FROM "COVID19_NYT"."COVID19_NYT"."US_STATES"
WHERE "date" BETWEEN '2020-03-01' AND '2020-03-10'
ORDER BY "date" ASC, "state_name"
LIMIT 20;
```

```sql
--Description: 2) Calculate daily NEW cases for every state using LAG()  
SELECT "date",
       "state_name",
       "confirmed_cases",
       "confirmed_cases"
       - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") 
         AS "new_cases"
FROM "COVID19_NYT"."COVID19_NYT"."US_STATES"
WHERE "date" BETWEEN '2020-03-01' AND '2020-03-10'
ORDER BY "date", "state_name"
LIMIT 20;
```

```sql
--Description: 3) Restrict to the analysis window (March-May 2020) and keep only rows with positive new cases  
SELECT "date",
       "state_name",
       "new_cases"
FROM (
      SELECT "date",
             "state_name",
             "confirmed_cases"
             - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date")
               AS "new_cases"
      FROM "COVID19_NYT"."COVID19_NYT"."US_STATES"
      WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
     )
WHERE "new_cases" IS NOT NULL        -- first day per state will be NULL
ORDER BY "date", "state_name"
LIMIT 20;
```

```sql
--Description: 4) For every day in the window, rank states by NEW cases and keep the daily Top-5  
SELECT *
FROM (
      SELECT "date",
             "state_name",
             "new_cases",
             ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) AS "rk"
      FROM (
            SELECT "date",
                   "state_name",
                   "confirmed_cases"
                   - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") 
                     AS "new_cases"
            FROM "COVID19_NYT"."COVID19_NYT"."US_STATES"
            WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
           )
      WHERE "new_cases" IS NOT NULL
     )
WHERE "rk" <= 5
ORDER BY "date", "rk"
LIMIT 20;
```

```sql
--Description: 5) Count how often each state appears in those daily Top-5 lists  
SELECT "state_name",
       COUNT(*) AS "top5_appearances"
FROM (
      SELECT "date",
             "state_name",
             ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) AS "rk"
      FROM (
            SELECT "date",
                   "state_name",
                   "confirmed_cases"
                   - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") 
                     AS "new_cases"
            FROM "COVID19_NYT"."COVID19_NYT"."US_STATES"
            WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
           )
      WHERE "new_cases" IS NOT NULL
     )
WHERE "rk" <= 5
GROUP BY "state_name"
ORDER BY "top5_appearances" DESC, "state_name"
LIMIT 20;
```

```sql
--Description: 6) Identify the state that ranks 4th in overall Top-5 appearances (break ties alphabetically)  
SELECT "state_name",
       "top5_appearances"
FROM (
      SELECT "state_name",
             COUNT(*) AS "top5_appearances",
             ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC, "state_name") AS "overall_rank"
      FROM (
            SELECT "date",
                   "state_name",
                   ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) AS "rk"
            FROM (
                  SELECT "date",
                         "state_name",
                         "confirmed_cases"
                         - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") 
                           AS "new_cases"
                  FROM "COVID19_NYT"."COVID19_NYT"."US_STATES"
                  WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
                 )
            WHERE "new_cases" IS NOT NULL
           )
      WHERE "rk" <= 5
      GROUP BY "state_name"
     )
WHERE "overall_rank" = 4
LIMIT 20;
```

