       "county",
       "confirmed_cases",
       "confirmed_cases"
       - LAG("confirmed_cases") OVER (PARTITION BY "county" ORDER BY "date")
         AS "new_cases"
FROM "COVID19_NYT"."COVID19_NYT"."US_COUNTIES"
WHERE "state_name" = '<4th_state_name>'
  AND "date" BETWEEN '2020-03-01' AND '2020-05-31'
ORDER BY "date", "county"
LIMIT 20;
```

```sql
--Description: 9) Pick the daily county Top-5 NEW cases within the state  
