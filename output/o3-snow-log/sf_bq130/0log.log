--Description: 6) Identify the state that ranks 4th in overall Top-5 appearances (break ties alphabetically)  
SELECT "state_name",
       "top5_appearances"
FROM (
      SELECT "state_name",
             COUNT(*) AS "top5_appearances",
             ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC, "state_name") AS "overall_rank"
      FROM (
            SELECT "date",
                   "state_name",
                   ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) AS "rk"
            FROM (
                  SELECT "date",
                         "state_name",
                         "confirmed_cases"
                         - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") 
                           AS "new_cases"
                  FROM "COVID19_NYT"."COVID19_NYT"."US_STATES"
                  WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
                 )
            WHERE "new_cases" IS NOT NULL
           )
      WHERE "rk" <= 5
      GROUP BY "state_name"
     )
WHERE "overall_rank" = 4
LIMIT 20;
