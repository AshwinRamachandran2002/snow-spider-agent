--Description: Retrieve the state that places 4th in total Top-5 appearances during Mar–May 2020
WITH state_daily AS (
    SELECT
        "date",
        "state_name",
        "confirmed_cases"
          - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS "new_cases"
