--Description: Count how many times each state shows up in the daily Top-5 list of new cases (Mar–May 2020)
WITH state_daily AS (                         -- 1) pre-compute daily new cases
    SELECT
        "date",
        "state_name",
        "confirmed_cases"
          - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS "new_cases"
    FROM COVID19_NYT.COVID19_NYT."US_STATES"
    WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
), daily_ranks AS (                           -- 2) rank states by those new-case counts each day
    SELECT
        "date",
        "state_name",
        RANK() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) AS "state_rank"
    FROM state_daily
    WHERE "new_cases" IS NOT NULL
)
SELECT                                        -- 3) tally appearances in the Top-5
    "state_name",
    COUNT(*) AS "top5_occurrences"
FROM daily_ranks
WHERE "state_rank" <= 5
GROUP BY "state_name"
ORDER BY "top5_occurrences" DESC
LIMIT 20
