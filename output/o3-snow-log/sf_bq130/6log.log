--Description:  For Illinois (the 4-th overall state), rank counties each day by their
--              increase in confirmed COVID-19 cases during 1 Mar – 31 May 2020 and list
--              only the Top-5 counties per date.
WITH county_new AS (                         -- Step 1: compute daily new cases per county
    SELECT
        "date",
        "county",
        "state_name",
        "confirmed_cases"
          - LAG("confirmed_cases") OVER (PARTITION BY "state_name","county" ORDER BY "date") 
          AS "new_cases"
    FROM COVID19_NYT.COVID19_NYT."US_COUNTIES"
    WHERE "state_name" = 'Illinois'
      AND "date" BETWEEN '2020-03-01' AND '2020-05-31'
), ranked AS (                               -- Step 2: rank counties by new cases for each date
    SELECT
        "date",
        "county",
        "new_cases",
        RANK() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) AS "county_rank"
    FROM county_new
    WHERE "new_cases" IS NOT NULL            -- exclude first report per county
)
SELECT
    "date",
    "county",
    "new_cases",
    "county_rank"
FROM ranked
WHERE "county_rank" <= 5                     -- keep daily Top-5 counties
ORDER BY "date", "county_rank"
LIMIT 20
