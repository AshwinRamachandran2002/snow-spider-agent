```sql
--Description: Compute daily new cases for each state (difference from previous day)  
SELECT
  "date",
  "state_name",
  "confirmed_cases"                                                   AS "cum_cases",
  "confirmed_cases" - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date")  
    AS "new_cases"
FROM COVID19_NYT.COVID19_NYT."US_STATES"
WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
ORDER BY "date", "state_name"
LIMIT 20;
```

```sql
--Description: Keep only rows in which daily new cases were calculated successfully (non-null)  
SELECT
  *
FROM (
  SELECT
    "date",
    "state_name",
    "confirmed_cases",
    LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS "prev_cases"
  FROM COVID19_NYT.COVID19_NYT."US_STATES"
  WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
) t
WHERE "prev_cases" IS NOT NULL
ORDER BY "date", "state_name"
LIMIT 20;
```

```sql
--Description: For each date, rank states by daily new cases (1 = largest increase)  
SELECT
  "date",
  "state_name",
  ("confirmed_cases" - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date")) AS "new_cases",
  RANK() OVER (PARTITION BY "date" ORDER BY ("confirmed_cases" - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date")) DESC) AS "state_rank"
FROM COVID19_NYT.COVID19_NYT."US_STATES"
WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
QUALIFY "state_rank" <= 5
ORDER BY "date", "state_rank"
LIMIT 20;
```

```sql
--Description: Frequency with which each state appears in the daily Top-5 list  
WITH daily_ranks AS (
  SELECT
    "date",
    "state_name",
    RANK() OVER (PARTITION BY "date" ORDER BY ("confirmed_cases" - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date")) DESC) AS "state_rank"
  FROM COVID19_NYT.COVID19_NYT."US_STATES"
  WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT
  "state_name",
  COUNT(*) AS "top5_occurrences"
FROM daily_ranks
WHERE "state_rank" <= 5
GROUP BY "state_name"
ORDER BY "top5_occurrences" DESC
LIMIT 20;
```

```sql
--Description: Identify the state that ranks fourth overall in Top-5 frequency  
WITH daily_ranks AS (
  SELECT
    "date",
    "state_name",
    RANK() OVER (PARTITION BY "date" ORDER BY ("confirmed_cases" - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date")) DESC) AS "state_rank"
  FROM COVID19_NYT.COVID19_NYT."US_STATES"
  WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
), tally AS (
  SELECT
    "state_name",
    COUNT(*) AS "top5_occurrences"
  FROM daily_ranks
  WHERE "state_rank" <= 5
  GROUP BY "state_name"
  ORDER BY "top5_occurrences" DESC
)
SELECT 
  "state_name",
  "top5_occurrences"
FROM tally
ORDER BY "top5_occurrences" DESC
OFFSET 3 ROWS            -- zero-based offset: 0,1,2,3 → 4th place
FETCH NEXT 1 ROWS ONLY
LIMIT 20;
```

