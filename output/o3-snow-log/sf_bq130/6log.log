```sql
--Description: Goal is to identify, for every day between 01-Mar-2020 and 31-May-2020, the five states
--             with the largest increases in cumulative COVID-19 cases.  Because Snowflake forbids
--             nesting window functions (e.g., using RANK on an expression that itself contains LAG),
--             we accomplish the task in two logical steps:
--               1)  In CTE state_daily, compute each state's “new_cases” as the day-over-day difference
--                   in cumulative confirmed cases (confirmed_cases – LAG(confirmed_cases)).
--               2)  In the outer query, apply RANK() (partitioned by date) to those pre-computed
--                   new_cases values and retain only the Top-5 states per date (state_rank ≤ 5).
--             Finally, we exclude rows where new_cases is NULL (the first date per state) and show
--             the results ordered by date and rank, limiting to 20 rows just for inspection.
WITH state_daily AS (
    SELECT
        "date",
        "state_name",
        "confirmed_cases"
          - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS "new_cases"
    FROM COVID19_NYT.COVID19_NYT."US_STATES"
    WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT
    "date",
    "state_name",
    "new_cases",
    RANK() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) AS "state_rank"
FROM state_daily
WHERE "new_cases" IS NOT NULL
QUALIFY "state_rank" <= 5
ORDER BY "date", "state_rank"
LIMIT 20;
```
