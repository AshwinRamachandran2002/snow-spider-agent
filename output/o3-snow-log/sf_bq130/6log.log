```sql
--Description:  Determine which Illinois counties most frequently landed in the daily Top-5
--              for biggest increases in confirmed COVID-19 cases between 1 Mar 2020 and
--              31 May 2020.  Because Snowflake disallows nesting a RANK window on an
--              expression that itself contains LAG, the query proceeds in two stages:
--                1)  county_daily  – compute each county’s day-over-day new_cases with LAG.
--                2)  ranked        – rank counties by those new_cases for every date.
--              The final SELECT tallies how many times each county appears in the Top-5
--              (county_rank ≤ 5) and orders the list by that frequency.
WITH county_daily AS (                       -- Step 1: daily new cases per county
    SELECT
        "date",
        "county",
        "state_name",
        "confirmed_cases"
          - LAG("confirmed_cases") OVER (PARTITION BY "state_name","county" ORDER BY "date")
          AS "new_cases"
    FROM COVID19_NYT.COVID19_NYT."US_COUNTIES"
    WHERE "state_name" = 'Illinois'
      AND "date" BETWEEN '2020-03-01' AND '2020-05-31'
), ranked AS (                               -- Step 2: rank counties by new cases each day
    SELECT
        "date",
        "county",
        "new_cases",
        RANK() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) AS "county_rank"
    FROM county_daily
    WHERE "new_cases" IS NOT NULL            -- exclude first record per county
)
SELECT                                        -- Final: frequency of Top-5 appearances
    "county",
    COUNT(*) AS "top5_occurrences"
FROM ranked
WHERE "county_rank" <= 5
GROUP BY "county"
ORDER BY "top5_occurrences" DESC
LIMIT 20;
```
