--Description: Calculate daily new confirmed cases for every state between March-May 2020
WITH s AS (
    SELECT "state_name",
           "date",
           "confirmed_cases",
           LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS prev_cases
    FROM COVID19_NYT.COVID19_NYT.US_STATES
