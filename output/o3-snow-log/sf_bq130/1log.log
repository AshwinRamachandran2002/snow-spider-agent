```sql
--Description: Count how many times each state appears in the top-5 daily new-case list from March-May 2020
WITH daily AS (
    SELECT "state_name",
           "date",
           ("confirmed_cases" - COALESCE(LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date"),0)) AS new_cases
    FROM COVID19_NYT.COVID19_NYT.US_STATES
    WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
), ranked AS (
    SELECT "date",
           "state_name",
           new_cases,
           ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY new_cases DESC) AS rn
    FROM daily
)
SELECT "state_name",
       COUNT(*) AS top5_count
FROM ranked
WHERE rn <= 5
GROUP BY "state_name"
ORDER BY top5_count DESC
LIMIT 20;
```

