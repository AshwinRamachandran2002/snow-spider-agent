```sql
--Description: Calculate daily new confirmed cases for every state between March-May 2020
WITH s AS (
    SELECT "state_name",
           "date",
           "confirmed_cases",
           LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS prev_cases
    FROM COVID19_NYT.COVID19_NYT.US_STATES
    WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT "state_name",
       "date",
       ("confirmed_cases" - COALESCE(prev_cases, 0)) AS "new_cases"
FROM s
ORDER BY "date", "new_cases" DESC
LIMIT 20;
```

```sql
--Description: For one illustrative date (2020-03-31), list the five states with the largest daily increases
