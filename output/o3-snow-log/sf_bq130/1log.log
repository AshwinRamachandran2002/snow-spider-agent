```sql
--Description: Find the state that ranks 4th in total appearances in the daily top-five
--             biggest increases (new confirmed cases) from 1 Mar 2020-31 May 2020,
--             then, for that state, determine the five counties that most often
--             appear in their own daily top-five county increases during the
--             same period.
--  ▸ state_daily   : day-over-day new-case counts for every state.
--  ▸ state_ranked  : rank states per date by those counts (rn ≤ 5 keeps top-five).
--  ▸ state_freq    : how many times each state is in a daily top-five list.
--  ▸ fourth_state  : the single state whose frequency rank is 4.
--  ▸ county_daily  : day-over-day new-case counts for counties, filtered to that state.
--  ▸ county_ranked : rank counties (within the chosen state) per date by new cases.
--  ▸ county_freq   : how many times each county is in a daily top-five list.
--  ▸ Final SELECT  : show the 4th-ranked state and its five most frequent counties.
WITH state_daily AS (
    SELECT  "state_name",
            "date",
            ("confirmed_cases"
             - COALESCE(LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date"), 0)
            ) AS new_cases
    FROM COVID19_NYT.COVID19_NYT.US_STATES
    WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
), state_ranked AS (
    SELECT  "date",
            "state_name",
            new_cases,
            ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY new_cases DESC) AS rn
    FROM state_daily
), state_freq AS (
    SELECT  "state_name",
            COUNT(*) AS top5_count,
            DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS freq_rank
    FROM state_ranked
    WHERE rn <= 5
    GROUP BY "state_name"
), fourth_state AS (
    SELECT "state_name"
    FROM state_freq
    WHERE freq_rank = 4           -- 4th-highest frequency
), county_daily AS (
    SELECT  "county",
            "state_name",
            "date",
            ("confirmed_cases"
             - COALESCE(LAG("confirmed_cases") OVER (PARTITION BY "county" ORDER BY "date"), 0)
            ) AS new_cases
    FROM COVID19_NYT.COVID19_NYT.US_COUNTIES
    WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
      AND "state_name" IN (SELECT "state_name" FROM fourth_state)
), county_ranked AS (
    SELECT  "date",
            "county",
            new_cases,
            ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY new_cases DESC) AS rn
    FROM county_daily
), county_freq AS (
    SELECT  "county",
            COUNT(*) AS top5_count
    FROM county_ranked
    WHERE rn <= 5
    GROUP BY "county"
)
SELECT  (SELECT "state_name" FROM fourth_state)      AS fourth_ranked_state,
        "county",
        top5_count                                   AS county_top5_frequency
FROM county_freq
ORDER BY top5_count DESC, "county"
LIMIT 5;
```
