```sql
--Description: For each date in the study window, rank states by daily new
--             cases and keep the top 5.
SELECT   "date",
         "state_name",
         "new_cases"
FROM    (
         SELECT  "date",
                 "state_name",
                 "confirmed_cases"
                 - LAG("confirmed_cases")
                   OVER (PARTITION BY "state_name" ORDER BY "date") 
                                                        AS "new_cases",
                 ROW_NUMBER() OVER (PARTITION BY "date"
                                    ORDER BY 
                                    ("confirmed_cases"
                                     - LAG("confirmed_cases")
                                       OVER (PARTITION BY "state_name"
                                             ORDER BY "date")) DESC) AS "rnk"
