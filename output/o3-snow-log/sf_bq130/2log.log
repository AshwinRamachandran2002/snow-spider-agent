```sql
--Description / Thinking process:
-- Goal: List, for 1 Mar 2020 – 31 May 2020, the five states with the
--       largest DAILY increases in confirmed COVID-19 cases (“new_cases”).
-- Steps:
--   1.  In a subquery (alias calc) calculate new_cases for every state/date
--       via LAG; this must be in its own layer because Snowflake forbids
--       nesting window functions.
--   2.  Filter out NULL new_cases produced on a state’s first record.
--   3.  In the outer layer (alias ranked) rank states within each day by
--       their new_cases using ROW_NUMBER (partition by date). 
--   4.  Keep rows whose rank ≤ 5, giving the daily Top-5 states.
--   5.  ORDER results by date then rank and LIMIT 20 just to preview.
SELECT *
FROM (
        SELECT  "date",
                "state_name",
                "new_cases",
                ROW_NUMBER() OVER (PARTITION BY "date"
                                   ORDER BY "new_cases" DESC) AS "rnk"
        FROM (
                SELECT  "date",
                        "state_name",
                        "confirmed_cases"
                      - LAG("confirmed_cases") OVER (PARTITION BY "state_name"
                                                     ORDER BY "date") AS "new_cases"
                FROM    "COVID19_NYT"."COVID19_NYT"."US_STATES"
                WHERE   "date" BETWEEN '2020-03-01' AND '2020-05-31'
        ) calc
        WHERE "new_cases" IS NOT NULL
) ranked
WHERE "rnk" <= 5
ORDER BY "date", "rnk"
LIMIT 20;
```
