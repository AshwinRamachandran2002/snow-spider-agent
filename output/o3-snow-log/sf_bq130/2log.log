--Description:  Count how many times each Illinois county appears in the DAILY
--              Top-5 list for new COVID-19 cases between 1 Mar 2020 and
--              31 May 2020.  The steps replicate the earlier pattern but
--              replace the bind variable with the literal state name
--              “Illinois” and isolate window operations in separate layers. 
WITH county_top5 AS (          -- build the daily Top-5 list for counties
     SELECT "date",
            "county"
     FROM (
            /* compute daily new cases for each county (cannot nest windows) */
            SELECT  "date",
                    "county",
                    "confirmed_cases"
