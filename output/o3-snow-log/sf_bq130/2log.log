Query:
--Description: Count how many times each state appears in the DAILY Top-5
--             (by new cases) during 1 Mar – 31 May 2020.
WITH daily_top5 AS (
     /* Step-1: calculate daily new cases for every state */
     SELECT "date",
            "state_name",
            "new_cases"
     FROM  (
             SELECT "date",
                    "state_name",
                    "confirmed_cases"
                  - LAG("confirmed_cases") OVER (PARTITION BY "state_name"
                                                   ORDER BY "date") AS "new_cases"
             FROM   "COVID19_NYT"."COVID19_NYT"."US_STATES"
             WHERE  "date" BETWEEN '2020-03-01' AND '2020-05-31'
           ) calc
     WHERE  "new_cases" IS NOT NULL
     /* Step-2: rank states per day and keep Top-5 */
     QUALIFY ROW_NUMBER() OVER (PARTITION BY "date"
                                ORDER BY "new_cases" DESC) <= 5
)
SELECT  "state_name",
        COUNT(*) AS "top5_hits"
FROM    daily_top5
GROUP BY "state_name"
ORDER BY "top5_hits" DESC
LIMIT   20
