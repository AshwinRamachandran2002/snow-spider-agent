```sql
--Description:  Determine which Illinois counties most frequently appeared in the
--              DAILY Top-5 for new COVID-19 cases between 1 Mar 2020 and 31 May 2020.
--
-- ①  Inner subquery “calc”
--      • Restrict rows to Illinois in the target date range.
--      • Compute daily new-case counts per county via LAG; this must be done
--        in its own layer because Snowflake cannot nest window functions.
-- ②  Middle subquery “ranked”
--      • Remove NULL new_cases (the first record for each county).
--      • Rank counties within each date by new_cases (ROW_NUMBER partitioned
--        by date).  Keep only rank ≤ 5 — the daily Top-5 counties.
-- ③  Outer query
--      • Count how many times each county appears in those daily Top-5 lists.
--      • Order descending to reveal the five most frequent counties.
SELECT  "county",
        COUNT(*) AS "top5_hits"
FROM  (
        SELECT  "date",
                "county",
                ROW_NUMBER() OVER (PARTITION BY "date"
                                   ORDER BY "new_cases" DESC) AS "rnk"
        FROM (
                SELECT  "date",
                        "county",
                        "confirmed_cases"
                      - LAG("confirmed_cases") OVER (PARTITION BY "county_fips_code"
                                                     ORDER BY "date") AS "new_cases"
                FROM    "COVID19_NYT"."COVID19_NYT"."US_COUNTIES"
                WHERE   "state_name" = 'Illinois'
                  AND   "date" BETWEEN '2020-03-01' AND '2020-05-31'
             ) calc
        WHERE "new_cases" IS NOT NULL
      ) ranked
WHERE  "rnk" <= 5
GROUP BY "county"
ORDER BY "top5_hits" DESC
LIMIT 5;
```
