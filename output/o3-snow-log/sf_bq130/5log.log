```sql
--Description: In a single chain of CTEs, we
-- ① calculate daily NEW cases for each state (daily_state);
-- ② rank states each day by those NEW cases and keep rank (ranked_state);
-- ③ tally how often each state appears in the national TOP-5 list (tally);
-- ④ select the state that ranks 4-th overall by that tally (target_state);
-- ⑤ for every county in that state, compute its daily NEW cases (county_daily);
-- The final SELECT returns sample rows (limit 20) of county-level NEW cases.
WITH daily_state AS (                         -- state-level new cases
    SELECT
        "date",
        "state_name",
        COALESCE("confirmed_cases" 
                 - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date"), 0) AS new_cases
    FROM COVID19_NYT.COVID19_NYT."US_STATES"
    WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
),
ranked_state AS (                             -- top-5 states each day
    SELECT
        "date",
        "state_name",
        ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY new_cases DESC) AS rn
    FROM daily_state
),
tally AS (                                    -- appearances count
    SELECT
        "state_name",
        COUNT(*) AS hits
    FROM ranked_state
    WHERE rn <= 5
    GROUP BY "state_name"
),
target_state AS (                             -- 4-th most frequent state
    SELECT "state_name"
    FROM (
        SELECT
            "state_name",
            hits,
            ROW_NUMBER() OVER (ORDER BY hits DESC) AS pos
        FROM tally
    )
    WHERE pos = 4
),
county_daily AS (                             -- county-level new cases in that state
    SELECT
        c."date",
        c."county",
        c."confirmed_cases",
        LAG(c."confirmed_cases") OVER (PARTITION BY c."county_fips_code" ORDER BY c."date") AS prev_cases
    FROM COVID19_NYT.COVID19_NYT."US_COUNTIES" c
    JOIN target_state t ON c."state_name" = t."state_name"
    WHERE c."date" BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT
    "date",
    "county",
    COALESCE("confirmed_cases" - prev_cases, 0) AS "new_cases"
FROM county_daily
ORDER BY "date", "county"
LIMIT 20;
```
