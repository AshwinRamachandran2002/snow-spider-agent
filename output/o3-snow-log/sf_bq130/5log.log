```sql
--Description: 6) Identify the state that ranks 4th overall (one row expected)  
WITH daily AS (
  SELECT
    "date",
    "state_name",
    COALESCE("confirmed_cases" - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date"),0) AS new_cases
  FROM COVID19_NYT.COVID19_NYT."US_STATES"
  WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
), ranked AS (
