Query:
--Description: 8) For the state that ranks 4-th in total TOP-5 appearances (Mar–May 2020), list its TOP-5 counties
--               by NEW cases each day (sample output, limit 20) – rewritten to avoid nested window functions
WITH daily_state AS (                          -- state-level NEW cases
    SELECT
        "date",
        "state_name",
        COALESCE("confirmed_cases" 
                 - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date"), 0) AS new_cases
    FROM COVID19_NYT.COVID19_NYT."US_STATES"
    WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
), ranked_state AS (                           -- rank states each day
    SELECT
        "date",
        "state_name",
        ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY new_cases DESC) AS rn
    FROM daily_state
), tally AS (                                  -- count appearances in daily TOP-5
    SELECT
        "state_name",
        COUNT(*) AS hits
    FROM ranked_state
    WHERE rn <= 5
    GROUP BY "state_name"
), target_state AS (                           -- pick 4-th most-frequent state
    SELECT "state_name"
    FROM (
        SELECT
            "state_name",
            hits,
            ROW_NUMBER() OVER (ORDER BY hits DESC) AS pos
        FROM tally
    )
    WHERE pos = 4
), county_new AS (                             -- county-level NEW cases in that state
    SELECT
        c."date",
        c."county",
        COALESCE(c."confirmed_cases" 
                 - LAG(c."confirmed_cases") OVER (PARTITION BY c."county_fips_code" ORDER BY c."date"), 0) AS new_cases
    FROM COVID19_NYT.COVID19_NYT."US_COUNTIES" c
    JOIN target_state t ON c."state_name" = t."state_name"
    WHERE c."date" BETWEEN '2020-03-01' AND '2020-05-31'
), ranked_cnty AS (                            -- rank counties each day
    SELECT
        "date",
        "county",
        new_cases,
        ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY new_cases DESC) AS rn
    FROM county_new
)
SELECT
    "date",
    "county",
    new_cases
FROM ranked_cnty
WHERE rn <= 5
ORDER BY "date", rn
LIMIT 20
