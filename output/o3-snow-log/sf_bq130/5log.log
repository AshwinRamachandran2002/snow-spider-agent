--Description: 2) Derive daily NEW case counts for every state in March-May 2020  
WITH s AS (
  SELECT
    "date",
    "state_name",
    "confirmed_cases",
    LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS prev_cases
  FROM COVID19_NYT.COVID19_NYT."US_STATES"
  WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT
  "date",
  "state_name",
  COALESCE("confirmed_cases" - prev_cases, 0) AS "new_cases"
FROM s
ORDER BY "date", "state_name"
LIMIT 20;
