```sql
--Description: 7) Compute daily NEW cases for every county inside the 4th-ranked state  
WITH target_state AS (               -- grab the 4th-place state
  SELECT "state_name"
  FROM (
    SELECT
      "state_name",
      COUNT(*) AS hits,
      ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS pos
    FROM (
      SELECT
        "date",
        "state_name",
        ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY
          "confirmed_cases" - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") DESC) AS rn
      FROM COVID19_NYT.COVID19_NYT."US_STATES"
      WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
    ) WHERE rn <= 5
    GROUP BY "state_name"
  ) WHERE pos = 4                 -- 4th overall
), county_daily AS (
  SELECT
    c."date",
    c."county",
    c."state_name",
    c."confirmed_cases",
    LAG(c."confirmed_cases") OVER (PARTITION BY c."county_fips_code" ORDER BY c."date") AS prev_cases
  FROM COVID19_NYT.COVID19_NYT."US_COUNTIES" c
  JOIN target_state t
    ON c."state_name" = t."state_name"
  WHERE c."date" BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT
  "date",
  "county",
  ("confirmed_cases" - COALESCE(prev_cases,0)) AS "new_cases"
FROM county_daily
ORDER BY "date", "county"
LIMIT 20;
```

```sql
--Description: 8) For that state, pull the TOP-5 counties by NEW cases each day  
WITH t_state AS (
  SELECT "state_name"
  FROM (
    SELECT
      "state_name",
      COUNT(*) AS hits,
      ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS pos
    FROM (
      SELECT
        "date",
        "state_name",
        ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY
          "confirmed_cases" - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") DESC) AS rn
      FROM COVID19_NYT.COVID19_NYT."US_STATES"
      WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
    ) WHERE rn <= 5
    GROUP BY "state_name"
  ) WHERE pos = 4
), c_new AS (
  SELECT
    c."date",
    c."county",
    c."county_fips_code",
    c."state_name",
    COALESCE(c."confirmed_cases" - LAG(c."confirmed_cases") OVER (PARTITION BY c."county_fips_code" ORDER BY c."date"),0) AS new_cases
  FROM COVID19_NYT.COVID19_NYT."US_COUNTIES" c
  JOIN t_state t ON c."state_name" = t."state_name"
  WHERE c."date" BETWEEN '2020-03-01' AND '2020-05-31'
), ranked AS (
  SELECT
    "date",
    "county",
    new_cases,
    ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY new_cases DESC) AS rn
  FROM c_new
)
SELECT
  "date",
  "county",
  new_cases
FROM ranked
WHERE rn <= 5
ORDER BY "date", rn
LIMIT 20;
```

