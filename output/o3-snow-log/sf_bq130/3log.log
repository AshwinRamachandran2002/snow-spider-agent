--Description: 6) Retrieve the single state that ranks 4th in overall appearances (ties broken alphabetically)
WITH state_rank AS (
    /* re-use logic from query 5 */
    WITH daily AS (
        SELECT "date",
               "state_name",
               "confirmed_cases"
               - LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS "new_cases"
        FROM "COVID19_NYT"."COVID19_NYT"."US_STATES"
        WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
    ),
    ranked AS (
        SELECT "date",
               "state_name",
               "new_cases",
               ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) AS rn
        FROM daily
    ),
    daily_top5 AS (
        SELECT "state_name"
        FROM ranked
        WHERE rn <= 5
    )
    SELECT "state_name",
           COUNT(*) AS "appearances_in_top5",
           DENSE_RANK() OVER (ORDER BY COUNT(*) DESC, MIN("state_name") ASC) AS overall_rank
    FROM daily_top5
    GROUP BY "state_name"
)
SELECT "state_name"
FROM state_rank
WHERE overall_rank = 4
LIMIT 20;
