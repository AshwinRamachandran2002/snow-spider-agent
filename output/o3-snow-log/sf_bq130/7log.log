--Description: 2) Derive daily NEW case counts (cumulative minus previous-day value)  
--              – here only rows for ‘New York’ are shown as a sample
WITH s AS (
  SELECT "date",
         "state_name",
         "confirmed_cases",
         LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS prev_cases
  FROM   "COVID19_NYT"."COVID19_NYT"."US_STATES"
