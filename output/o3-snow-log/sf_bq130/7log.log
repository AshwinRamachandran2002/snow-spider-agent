```sql
--Description: 1) View cumulative state–level case counts for the first five days of March 2020
SELECT "date",
       "state_name",
       "confirmed_cases"
FROM   "COVID19_NYT"."COVID19_NYT"."US_STATES"
WHERE  "date" BETWEEN '2020-03-01' AND '2020-03-05'
ORDER  BY "state_name",
          "date"
LIMIT  20;
```

```sql
--Description: 2) Derive daily NEW case counts (cumulative minus previous-day value)  
--              – here only rows for ‘New York’ are shown as a sample
WITH s AS (
  SELECT "date",
         "state_name",
         "confirmed_cases",
         LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS prev_cases
  FROM   "COVID19_NYT"."COVID19_NYT"."US_STATES"
  WHERE  "date" BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT "date",
       "state_name",
       COALESCE("confirmed_cases" - prev_cases, 0) AS "new_cases"
FROM   s
WHERE  "state_name" = 'New York'
ORDER  BY "date"
LIMIT  20;
```

```sql
--Description: 3) For 15-Apr-2020, list the TOP-5 states by greatest daily NEW cases
WITH s AS (
  SELECT "date",
         "state_name",
         "confirmed_cases",
         LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS prev_cases
  FROM   "COVID19_NYT"."COVID19_NYT"."US_STATES"
)
SELECT "state_name",
       ("confirmed_cases" - prev_cases) AS "new_cases"
FROM   s
WHERE  "date" = '2020-04-15'
ORDER  BY "new_cases" DESC
LIMIT  5;
```

```sql
--Description: 4) Count how many times EACH state appears in a daily TOP-5 list  
--               (Mar-01 – May-31 2020) and show the overall ranking
WITH s AS (
  SELECT "date",
         "state_name",
         "confirmed_cases",
         LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS prev_cases
  FROM   "COVID19_NYT"."COVID19_NYT"."US_STATES"
  WHERE  "date" BETWEEN '2020-03-01' AND '2020-05-31'
), ranked AS (
  SELECT "date",
         "state_name",
         COALESCE("confirmed_cases" - prev_cases, 0) AS new_cases,
         ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY COALESCE("confirmed_cases" - prev_cases,0) DESC) AS rnk
  FROM   s
)
SELECT "state_name",
       COUNT(*) AS top5_count
FROM   ranked
WHERE  rnk <= 5
GROUP  BY "state_name"
ORDER  BY top5_count DESC
LIMIT  20;
```

```sql
--Description: 5) Identify the STATE that ranks FOURTH in the above frequency table
WITH freq AS (
  /* same CTE as query 4, collapsed for brevity */
  SELECT "state_name",
         COUNT(*) AS top5_count
  FROM (
        WITH s AS (
          SELECT "date",
                 "state_name",
                 "confirmed_cases",
                 LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS prev_cases
          FROM   "COVID19_NYT"."COVID19_NYT"."US_STATES"
          WHERE  "date" BETWEEN '2020-03-01' AND '2020-05-31'
        )
        SELECT "date",
               "state_name",
               ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY COALESCE("confirmed_cases" - prev_cases,0) DESC) AS rnk
        FROM   s
       ) sub
  WHERE  rnk <= 5
  GROUP  BY "state_name"
)
SELECT "state_name",
       top5_count
FROM   (
        SELECT "state_name",
               top5_count,
               ROW_NUMBER() OVER (ORDER BY top5_count DESC) AS overall_rank
        FROM   freq
       ) f
WHERE  overall_rank = 4
LIMIT  20;
```

