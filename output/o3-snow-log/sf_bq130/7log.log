--Description: 5) Identify the STATE that ranks FOURTH in the above frequency table
WITH freq AS (
  /* same CTE as query 4, collapsed for brevity */
  SELECT "state_name",
         COUNT(*) AS top5_count
  FROM (
        WITH s AS (
          SELECT "date",
                 "state_name",
                 "confirmed_cases",
                 LAG("confirmed_cases") OVER (PARTITION BY "state_name" ORDER BY "date") AS prev_cases
          FROM   "COVID19_NYT"."COVID19_NYT"."US_STATES"
          WHERE  "date" BETWEEN '2020-03-01' AND '2020-05-31'
        )
        SELECT "date",
               "state_name",
               ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY COALESCE("confirmed_cases" - prev_cases,0) DESC) AS rnk
        FROM   s
       ) sub
  WHERE  rnk <= 5
  GROUP  BY "state_name"
)
SELECT "state_name",
       top5_count
FROM   (
        SELECT "state_name",
               top5_count,
               ROW_NUMBER() OVER (ORDER BY top5_count DESC) AS overall_rank
        FROM   freq
       ) f
WHERE  overall_rank = 4
LIMIT  20;
