```sql
--Description:
-- For Illinois (the 4th-ranked state by daily top-five new-case appearances),
-- find the five counties that most often land in the DAILY top-five biggest jumps
-- in new COVID-19 cases between 1 Mar 2020 and 31 May 2020.
-- Steps:
--   1) county_daily  – compute each county’s NEW daily cases with LAG().
--   2) daily_top5    – keep the five counties with highest new cases per day.
--   3) Final select  – count each county’s appearances and list the top five.
WITH county_daily AS (
    SELECT  c."date",
            c."county_fips_code",
            c."county",
            c."confirmed_cases"
              - LAG(c."confirmed_cases") OVER (PARTITION BY c."county_fips_code" ORDER BY c."date")
              AS "new_cases_cnty"
    FROM COVID19_NYT.COVID19_NYT.US_COUNTIES c
    WHERE c."state_name" = 'Illinois'
      AND c."date" BETWEEN '2020-03-01' AND '2020-05-31'
), daily_top5 AS (
    SELECT  "date",
            "county",
            ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY "new_cases_cnty" DESC NULLS LAST) AS rn
    FROM county_daily
)
SELECT  "county",
        COUNT(*) AS "top5_hits"
FROM daily_top5
WHERE rn <= 5
GROUP BY "county"
ORDER BY "top5_hits" DESC,
         "county"
LIMIT 5;
