```sql
-- 2. Description: Show raw cumulative case counts for all states during the first week of March 2020.  
SELECT "date",
       "state_name",
       "confirmed_cases"
FROM COVID19_NYT.COVID19_NYT.US_STATES
WHERE "date" BETWEEN '2020-03-01' AND '2020-03-07'
ORDER BY "date", "state_name"
LIMIT 20;
```

```sql
-- 3. Description: Compute daily new cases for one sample state (Alabama) during March 2020.  
SELECT  "date",
        "state_name",
        "confirmed_cases"                                                  AS "cum_cases",
        "confirmed_cases" - LAG("confirmed_cases") OVER (ORDER BY "date")  AS "new_cases"
FROM COVID19_NYT.COVID19_NYT.US_STATES
WHERE "state_name" = 'Alabama'
  AND "date" BETWEEN '2020-03-01' AND '2020-03-31'
ORDER BY "date"
LIMIT 20;
```

```sql
-- 4. Description: Produce daily new-case counts for every state from March 1 to May 31 2020.  
SELECT  "date",
        "state_name",
        "confirmed_cases" - LAG("confirmed_cases") 
            OVER (PARTITION BY "state_name" ORDER BY "date") AS "new_cases"
FROM COVID19_NYT.COVID19_NYT.US_STATES
WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
ORDER BY "date", "state_name"
LIMIT 20;
```

```sql
-- 5. Description: Isolate the five states with the largest daily increases on each day in the period.  
WITH d AS (
    SELECT  "date",
            "state_name",
            "confirmed_cases" - LAG("confirmed_cases") 
                OVER (PARTITION BY "state_name" ORDER BY "date") AS "new_cases"
    FROM COVID19_NYT.COVID19_NYT.US_STATES
    WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
)
SELECT  "date",
        "state_name",
        "new_cases"
FROM d
QUALIFY ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) <= 5
ORDER BY "date", "new_cases" DESC
LIMIT 20;
```

```sql
-- 6. Description: Count how many times each state appeared in a daily top-five list.  
WITH top5 AS (
    SELECT  "date",
            "state_name"
    FROM (
        SELECT  "date",
                "state_name",
                "confirmed_cases" - LAG("confirmed_cases")
                    OVER (PARTITION BY "state_name" ORDER BY "date") AS "new_cases"
        FROM COVID19_NYT.COVID19_NYT.US_STATES
        WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
    )
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) <= 5
)
SELECT  "state_name",
        COUNT(*) AS "top5_hits"
FROM top5
GROUP BY "state_name"
ORDER BY "top5_hits" DESC
LIMIT 20;
```

```sql
-- 7. Description: Rank states by their total appearances in daily top fives (highest to lowest).  
WITH top5 AS (
    SELECT  "date",
            "state_name"
    FROM (
        SELECT  "date",
                "state_name",
                "confirmed_cases" - LAG("confirmed_cases")
                    OVER (PARTITION BY "state_name" ORDER BY "date") AS "new_cases"
        FROM COVID19_NYT.COVID19_NYT.US_STATES
        WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
    )
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) <= 5
),
r AS (
    SELECT  "state_name",
            COUNT(*)                           AS "top5_hits",
            DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS "rank_overall"
    FROM top5
    GROUP BY "state_name"
)
SELECT *
FROM r
ORDER BY "rank_overall", "state_name"
LIMIT 20;
```

```sql
-- 8. Description: Identify the single state that sits at overall rank 4.  
WITH top5 AS (
    SELECT  "date",
            "state_name"
