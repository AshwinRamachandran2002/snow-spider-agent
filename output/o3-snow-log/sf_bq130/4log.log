                "state_name",
                "confirmed_cases" - LAG("confirmed_cases")
                    OVER (PARTITION BY "state_name" ORDER BY "date") AS "new_cases"
        FROM COVID19_NYT.COVID19_NYT.US_STATES
        WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
    )
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) <= 5
),
r AS (
    SELECT  "state_name",
            COUNT(*)                           AS "top5_hits",
            DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS "rank_overall"
    FROM top5
    GROUP BY "state_name"
)
SELECT  "state_name"
FROM r
WHERE "rank_overall" = 4
LIMIT 20;
```

```sql
-- 9. Description: For the state discovered above (replace <STATE> as needed),  
--     compute daily new-case counts for each of its counties in the study period.  
SELECT  c."date",
        c."state_name",
        c."county",
        c."confirmed_cases" - LAG(c."confirmed_cases")
            OVER (PARTITION BY c."county_fips_code" ORDER BY c."date") AS "new_cases_cnty"
FROM COVID19_NYT.COVID19_NYT.US_COUNTIES c
WHERE c."state_name" = '<STATE>'                     -- ← replace with actual state from query 8
  AND c."date" BETWEEN '2020-03-01' AND '2020-05-31'
ORDER BY c."date", c."new_cases_cnty" DESC
LIMIT 20;
```

```sql
-- 10. Description: Find that state’s top five counties ranked by how often they appear
--      in the daily county-level top fives for new cases.  
WITH county_daily AS (
    SELECT  c."date",
            c."county_fips_code",
            c."county",
            c."confirmed_cases" - LAG(c."confirmed_cases")
                OVER (PARTITION BY c."county_fips_code" ORDER BY c."date") AS "new_cases_cnty"
    FROM COVID19_NYT.COVID19_NYT.US_COUNTIES c
    WHERE c."state_name" = '<STATE>'                 -- ← replace with actual state from query 8
      AND c."date" BETWEEN '2020-03-01' AND '2020-05-31'
),
daily_top5 AS (
    SELECT  "date",
            "county",
            ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY "new_cases_cnty" DESC) AS rn
    FROM county_daily
)
SELECT  "county",
        COUNT(*) AS "top5_hits"
FROM daily_top5
WHERE rn <= 5
GROUP BY "county"
ORDER BY "top5_hits" DESC
LIMIT 20;
```
