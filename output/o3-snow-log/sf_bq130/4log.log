    SELECT  "date",
            "state_name"
    FROM (
        SELECT  "date",
                "state_name",
                "confirmed_cases" - LAG("confirmed_cases")
                    OVER (PARTITION BY "state_name" ORDER BY "date") AS "new_cases"
        FROM COVID19_NYT.COVID19_NYT.US_STATES
        WHERE "date" BETWEEN '2020-03-01' AND '2020-05-31'
    )
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "date" ORDER BY "new_cases" DESC) <= 5
)
SELECT  "state_name",
        COUNT(*) AS "top5_hits"
FROM top5
GROUP BY "state_name"
ORDER BY "top5_hits" DESC
