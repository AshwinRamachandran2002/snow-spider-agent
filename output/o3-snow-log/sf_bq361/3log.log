Query:
--Description: Combine cohort size with monthly returning counts to get proportions
WITH jan20 AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_ts"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
        GROUP  BY "user_id"
    )
    WHERE TO_TIMESTAMP("first_purchase_ts"/1000000) >= '2020-01-01'
      AND TO_TIMESTAMP("first_purchase_ts"/1000000) <  '2020-02-01'
),
cohort_size AS (
    SELECT COUNT(*) AS "n_users" FROM jan20
),
monthly_returns AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) AS "order_month",
           COUNT(DISTINCT o."user_id")                              AS "returning_users"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
    JOIN   jan20 j
      ON   o."user_id" = j."user_id"
    WHERE  TO_TIMESTAMP(o."created_at"/1000000) >= '2020-02-01'
      AND  TO_TIMESTAMP(o."created_at"/1000000) <  '2021-01-01'
    GROUP  BY 1
)
SELECT m."order_month",
       m."returning_users",
       (m."returning_users" / c."n_users")::FLOAT AS "proportion_returned"
FROM   monthly_returns m
CROSS  JOIN cohort_size c
ORDER  BY m."order_month"
LIMIT 20;
