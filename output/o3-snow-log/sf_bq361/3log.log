Query:
--Description: Isolate the cohort whose very first purchase occurred in January-2020
WITH firsts AS (
    SELECT "user_id",
           MIN("created_at") AS "first_purchase_ts"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP  BY "user_id"
)
SELECT "user_id",
       "first_purchase_ts",
       TO_TIMESTAMP("first_purchase_ts"/1000000) AS "first_purchase_dt"
FROM   firsts
WHERE  TO_TIMESTAMP("first_purchase_ts"/1000000) >= '2020-01-01'
  AND  TO_TIMESTAMP("first_purchase_ts"/1000000) <  '2020-02-01'
LIMIT 20;
