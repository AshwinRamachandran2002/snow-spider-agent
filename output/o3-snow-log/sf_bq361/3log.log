```sql
--Description: Orders placed later in 2020 by January-2020 cohort users
WITH jan20 AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_ts"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
        GROUP  BY "user_id"
    )
    WHERE TO_TIMESTAMP("first_purchase_ts"/1000000) >= '2020-01-01'
      AND TO_TIMESTAMP("first_purchase_ts"/1000000) <  '2020-02-01'
)
SELECT o."order_id",
       o."user_id",
       TO_TIMESTAMP(o."created_at"/1000000) AS "order_dt"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   jan20 j
  ON   o."user_id" = j."user_id"
WHERE  TO_TIMESTAMP(o."created_at"/1000000) >= '2020-02-01'
  AND  TO_TIMESTAMP(o."created_at"/1000000) <  '2021-01-01'
LIMIT 20;
```

```sql
--Description: Month-by-month count of cohort users who ordered again in 2020
WITH jan20 AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_ts"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
        GROUP  BY "user_id"
    )
    WHERE TO_TIMESTAMP("first_purchase_ts"/1000000) >= '2020-01-01'
      AND TO_TIMESTAMP("first_purchase_ts"/1000000) <  '2020-02-01'
)
SELECT DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) AS "order_month",
       COUNT(DISTINCT o."user_id")                              AS "returning_users"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   jan20 j
  ON   o."user_id" = j."user_id"
WHERE  TO_TIMESTAMP(o."created_at"/1000000) >= '2020-02-01'
  AND  TO_TIMESTAMP(o."created_at"/1000000) <  '2021-01-01'
GROUP  BY 1
ORDER  BY 1
LIMIT 20;
```

```sql
--Description: Combine cohort size with monthly returning counts to get proportions
WITH jan20 AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_ts"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
        GROUP  BY "user_id"
    )
    WHERE TO_TIMESTAMP("first_purchase_ts"/1000000) >= '2020-01-01'
      AND TO_TIMESTAMP("first_purchase_ts"/1000000) <  '2020-02-01'
),
cohort_size AS (
    SELECT COUNT(*) AS "n_users" FROM jan20
),
monthly_returns AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) AS "order_month",
           COUNT(DISTINCT o."user_id")                              AS "returning_users"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
    JOIN   jan20 j
      ON   o."user_id" = j."user_id"
    WHERE  TO_TIMESTAMP(o."created_at"/1000000) >= '2020-02-01'
      AND  TO_TIMESTAMP(o."created_at"/1000000) <  '2021-01-01'
    GROUP  BY 1
)
SELECT m."order_month",
       m."returning_users",
       (m."returning_users" / c."n_users")::FLOAT AS "proportion_returned"
FROM   monthly_returns m
CROSS  JOIN cohort_size c
ORDER  BY m."order_month"
LIMIT 20;
```

```sql
--Description: Inspect order status values for cohort users to be sure cancellations/refunds can be excluded if desired
WITH jan20 AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_ts"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
        GROUP  BY "user_id"
    )
    WHERE TO_TIMESTAMP("first_purchase_ts"/1000000) >= '2020-01-01'
      AND TO_TIMESTAMP("first_purchase_ts"/1000000) <  '2020-02-01'
)
SELECT DISTINCT o."status"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   jan20 j
  ON   o."user_id" = j."user_id"
WHERE  TO_TIMESTAMP(o."created_at"/1000000) >= '2020-02-01'
  AND  TO_TIMESTAMP(o."created_at"/1000000) <  '2021-01-01'
LIMIT 20;
```

```sql
--Description: If you prefer using ORDER_ITEMS (item-level granularity) instead of ORDERS
WITH jan20 AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_ts"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
        GROUP  BY "user_id"
    )
    WHERE TO_TIMESTAMP("first_purchase_ts"/1000000) >= '2020-01-01'
      AND TO_TIMESTAMP("first_purchase_ts"/1000000) <  '2020-02-01'
),
cohort_size AS (SELECT COUNT(*) AS "n_users" FROM jan20)
SELECT DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at"/1000000)) AS "order_month",
       COUNT(DISTINCT oi."user_id")                              AS "returning_users",
       (COUNT(DISTINCT oi."user_id") / c."n_users")::FLOAT        AS "proportion_returned"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
JOIN   jan20 j
  ON   oi."user_id" = j."user_id"
JOIN   cohort_size c
WHERE  TO_TIMESTAMP(oi."created_at"/1000000) >= '2020-02-01'
  AND  TO_TIMESTAMP(oi."created_at"/1000000) <  '2021-01-01'
GROUP  BY 1, c."n_users"
ORDER  BY 1
LIMIT 20;
```

```sql
--Description: Quick check of cohort definitions by pulling a few random cohort users and their first two purchase dates
WITH ranked_orders AS (
    SELECT "user_id",
           TO_TIMESTAMP("created_at"/1000000) AS "order_dt",
           ROW_NUMBER() OVER (PARTITION BY "user_id" ORDER BY "created_at") AS "rn"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
)
SELECT "user_id",
       MIN(CASE WHEN "rn" = 1 THEN "order_dt" END) AS "first_purchase",
       MIN(CASE WHEN "rn" = 2 THEN "order_dt" END) AS "second_purchase"
FROM   ranked_orders
WHERE  "user_id" IN (
       SELECT "user_id"
       FROM   (
           SELECT "user_id",
                  MIN("created_at") AS "first_purchase_ts"
           FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
           GROUP  BY "user_id"
       )
       WHERE  TO_TIMESTAMP("first_purchase_ts"/1000000) >= '2020-01-01'
         AND  TO_TIMESTAMP("first_purchase_ts"/1000000) <  '2020-02-01'
       ORDER  BY RANDOM()
       LIMIT 20
)
GROUP  BY "user_id"
LIMIT 20;
```
