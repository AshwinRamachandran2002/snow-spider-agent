Query:
--Description: Combine returning-user counts with the cohort size to compute the monthly return proportion for February-December 2020.  
WITH jan_cohort AS (
  SELECT DISTINCT "user_id"
  FROM (
    SELECT "user_id",
           TO_CHAR(MIN(TO_TIMESTAMP("created_at"/1000000)),'YYYY-MM') AS "first_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  ) s
  WHERE s."first_month" = '2020-01'
),
cohort_size AS (
  SELECT COUNT(*) AS "size" FROM jan_cohort
),
monthly_returns AS (
  SELECT 
    TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM') AS "month_2020",
    COUNT(DISTINCT o."user_id")                             AS "returning_users"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  JOIN jan_cohort j ON j."user_id" = o."user_id"
  WHERE TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY') = '2020'
    AND TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM') > '2020-01'
  GROUP BY 1
)
SELECT 
  m."month_2020",
  m."returning_users",
  c."size"                     AS "cohort_size",
  ROUND(m."returning_users"::FLOAT / c."size",4) AS "return_prop"
FROM monthly_returns m
CROSS JOIN cohort_size c
ORDER BY m."month_2020"
LIMIT 20;
