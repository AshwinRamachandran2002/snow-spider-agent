--Description: Get the total size of the January-2020 cohort so we can compute proportions.  
SELECT 
  COUNT(*) AS "jan2020_cohort_size"
FROM (
  SELECT DISTINCT "user_id"
  FROM (
    SELECT "user_id",
           TO_CHAR(MIN(TO_TIMESTAMP("created_at"/1000000)),'YYYY-MM') AS "first_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  ) s
  WHERE s."first_month" = '2020-01'
) x
LIMIT 20;
