```sql
--Description: Inspect raw order records around 2020 and check how the micro-second epoch looks once converted to a readable time stamp.  
SELECT 
  "order_id",
  "user_id",
  TO_TIMESTAMP("created_at"/1000000)          AS "order_ts",
  TO_CHAR(TO_TIMESTAMP("created_at"/1000000),'YYYY-MM') AS "order_month",
  "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE TO_CHAR(TO_TIMESTAMP("created_at"/1000000),'YYYY') = '2020'
LIMIT 20;
```

```sql
--Description: Get every user’s first-ever purchase (order) time stamp.  
SELECT 
  "user_id",
  MIN(TO_TIMESTAMP("created_at"/1000000))     AS "first_purchase_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
GROUP BY "user_id"
LIMIT 20;
```

```sql
--Description: Convert the first purchase time stamp to a “YYYY-MM” string so we can isolate the January-2020 cohort.  
SELECT 
  "user_id",
  TO_CHAR(MIN(TO_TIMESTAMP("created_at"/1000000)),'YYYY-MM') AS "first_purchase_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
GROUP BY "user_id"
LIMIT 20;
```

```sql
--Description: Pull the user_ids whose first purchase month is January-2020 (the cohort of interest).  
SELECT DISTINCT
  "user_id"
FROM (
  SELECT 
    "user_id",
    TO_CHAR(MIN(TO_TIMESTAMP("created_at"/1000000)),'YYYY-MM') AS "first_month"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
) t
WHERE "first_month" = '2020-01'
LIMIT 20;
```

```sql
--Description: Show all later 2020 orders placed by the January-2020 cohort users (exclude the January orders themselves).  
SELECT 
  o."order_id",
  o."user_id",
  TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM') AS "later_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
JOIN (
  SELECT DISTINCT "user_id"
  FROM (
    SELECT "user_id",
           TO_CHAR(MIN(TO_TIMESTAMP("created_at"/1000000)),'YYYY-MM') AS "first_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  ) s
  WHERE s."first_month" = '2020-01'
) cohort
  ON cohort."user_id" = o."user_id"
WHERE TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY') = '2020'
  AND TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM') > '2020-01'
LIMIT 20;
```

```sql
--Description: Distinct months (February-December 2020) in which at least one cohort user returned.  
SELECT DISTINCT
  TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM') AS "month_2020"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN (
  SELECT DISTINCT "user_id"
  FROM (
    SELECT "user_id",
           TO_CHAR(MIN(TO_TIMESTAMP("created_at"/1000000)),'YYYY-MM') AS "first_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  ) s
  WHERE s."first_month" = '2020-01'
) cohort
  ON cohort."user_id" = o."user_id"
WHERE TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM') > '2020-01'
  AND TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY') = '2020'
ORDER BY "month_2020"
LIMIT 20;
```

```sql
--Description: Count the number of distinct January-2020 cohort users who made at least one order in each later month of 2020.  
SELECT 
  TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM')          AS "month_2020",
  COUNT(DISTINCT o."user_id")                                      AS "returning_users"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN (
  SELECT DISTINCT "user_id"
  FROM (
    SELECT "user_id",
           TO_CHAR(MIN(TO_TIMESTAMP("created_at"/1000000)),'YYYY-MM') AS "first_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  ) s
  WHERE s."first_month" = '2020-01'
) cohort
  ON cohort."user_id" = o."user_id"
WHERE TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY') = '2020'
  AND TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM') > '2020-01'
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Get the total size of the January-2020 cohort so we can compute proportions.  
SELECT 
  COUNT(*) AS "jan2020_cohort_size"
FROM (
  SELECT DISTINCT "user_id"
  FROM (
    SELECT "user_id",
           TO_CHAR(MIN(TO_TIMESTAMP("created_at"/1000000)),'YYYY-MM') AS "first_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  ) s
  WHERE s."first_month" = '2020-01'
) x
LIMIT 20;
```

```sql
--Description: Combine returning-user counts with the cohort size to compute the monthly return proportion for February-December 2020.  
WITH jan_cohort AS (
  SELECT DISTINCT "user_id"
  FROM (
    SELECT "user_id",
           TO_CHAR(MIN(TO_TIMESTAMP("created_at"/1000000)),'YYYY-MM') AS "first_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  ) s
  WHERE s."first_month" = '2020-01'
),
cohort_size AS (
  SELECT COUNT(*) AS "size" FROM jan_cohort
),
monthly_returns AS (
  SELECT 
    TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM') AS "month_2020",
    COUNT(DISTINCT o."user_id")                             AS "returning_users"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  JOIN jan_cohort j ON j."user_id" = o."user_id"
  WHERE TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY') = '2020'
    AND TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM') > '2020-01'
  GROUP BY 1
)
SELECT 
  m."month_2020",
  m."returning_users",
  c."size"                     AS "cohort_size",
  ROUND(m."returning_users"::FLOAT / c."size",4) AS "return_prop"
FROM monthly_returns m
CROSS JOIN cohort_size c
ORDER BY m."month_2020"
LIMIT 20;
```

```sql
--Description: (Optional deep-dive) Show which specific users from the cohort returned in any later month, to allow manual verification.  
SELECT DISTINCT 
  o."user_id",
  TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM') AS "return_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN (
  SELECT DISTINCT "user_id"
  FROM (
    SELECT "user_id",
           TO_CHAR(MIN(TO_TIMESTAMP("created_at"/1000000)),'YYYY-MM') AS "first_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  ) s
  WHERE s."first_month" = '2020-01'
) cohort
  ON cohort."user_id" = o."user_id"
WHERE TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY') = '2020'
  AND TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM') > '2020-01'
ORDER BY o."user_id", "return_month"
LIMIT 20;
```
