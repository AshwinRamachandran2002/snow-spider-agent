--Description: Distinct months (February-December 2020) in which at least one cohort user returned.  
SELECT DISTINCT
  TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM') AS "month_2020"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN (
  SELECT DISTINCT "user_id"
  FROM (
    SELECT "user_id",
           TO_CHAR(MIN(TO_TIMESTAMP("created_at"/1000000)),'YYYY-MM') AS "first_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  ) s
  WHERE s."first_month" = '2020-01'
) cohort
  ON cohort."user_id" = o."user_id"
WHERE TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY-MM') > '2020-01'
  AND TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000),'YYYY') = '2020'
ORDER BY "month_2020"
LIMIT 20;
