Query:
--Description: For each month Feb-2020 … Dec-2020, count DISTINCT cohort users who placed an order.
SELECT
    DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at"/1000000)) AS "order_month",
    COUNT(DISTINCT o."user_id")                                   AS "returning_users"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN (
    SELECT "user_id"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" ILIKE '%Complete%'
    GROUP BY "user_id"
    HAVING MIN("created_at") BETWEEN 1577836800000000 AND 1580515199000000
) j
  ON o."user_id" = j."user_id"
WHERE o."created_at" > 1580515199000000
  AND o."created_at" < 1609459200000000
  AND o."status" ILIKE '%Complete%'
GROUP BY 1
ORDER BY 1
LIMIT 20;
