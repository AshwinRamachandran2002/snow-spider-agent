SELECT
    "user_id",
    MIN("created_at") AS "first_purchase_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
WHERE "status" ILIKE '%Complete%'
GROUP BY "user_id"
HAVING MIN("created_at") BETWEEN 1577836800000000  -- 2020-01-01
                             AND 1580515199000000  -- 2020-01-31
LIMIT 20;
```

```sql
--Description: Count total cohort size (all users with first purchase in Jan-2020).
SELECT 
    COUNT(*) AS "jan2020_cohort_size"
FROM (
    SELECT "user_id"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" ILIKE '%Complete%'
    GROUP BY "user_id"
    HAVING MIN("created_at") BETWEEN 1577836800000000 AND 1580515199000000
);
```

```sql
--Description: List subsequent 2020 orders made by those Jan-2020-first-purchase users (limit 20).
SELECT 
    o."order_id",
    o."user_id",
    o."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN (
    SELECT "user_id"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" ILIKE '%Complete%'
    GROUP BY "user_id"
    HAVING MIN("created_at") BETWEEN 1577836800000000 AND 1580515199000000
) j
  ON o."user_id" = j."user_id"
WHERE o."created_at" > 1580515199000000                           -- after Jan-2020
  AND o."created_at" < 1609459200000000                           -- before 2021-01-01
  AND o."status" ILIKE '%Complete%'
LIMIT 20;
```

```sql
--Description: For each month Feb-2020 … Dec-2020, count DISTINCT cohort users who placed an order.
SELECT
    DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at"/1000000)) AS "order_month",
    COUNT(DISTINCT o."user_id")                                   AS "returning_users"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN (
    SELECT "user_id"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" ILIKE '%Complete%'
    GROUP BY "user_id"
    HAVING MIN("created_at") BETWEEN 1577836800000000 AND 1580515199000000
) j
  ON o."user_id" = j."user_id"
WHERE o."created_at" > 1580515199000000
  AND o."created_at" < 1609459200000000
  AND o."status" ILIKE '%Complete%'
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Produce a month-by-month proportion (returning / cohort) in 2020 for the Jan-2020 cohort.
SELECT
    DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at"/1000000))    AS "order_month",
    COUNT(DISTINCT o."user_id")                                     AS "returning_users",
    (SELECT COUNT(*) FROM (
        SELECT "user_id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
        GROUP BY "user_id"
        HAVING MIN("created_at") BETWEEN 1577836800000000 AND 1580515199000000
     )
    )                                                               AS "cohort_size",
    COUNT(DISTINCT o."user_id") * 1.0 /
    (SELECT COUNT(*) FROM (
        SELECT "user_id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
        GROUP BY "user_id"
        HAVING MIN("created_at") BETWEEN 1577836800000000 AND 1580515199000000
     )
    )                                                               AS "proportion_returned"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN (
    SELECT "user_id"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    GROUP BY "user_id"
    HAVING MIN("created_at") BETWEEN 1577836800000000 AND 1580515199000000
) j
  ON o."user_id" = j."user_id"
WHERE o."created_at" > 1580515199000000
  AND o."created_at" < 1609459200000000
  AND o."status" ILIKE '%Complete%'
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Quick sanity check – list any orders by those cohort users in 2021 to make sure they are excluded from 2020 analysis (limit 20 rows expected to be blank or >2020 range).
SELECT 
    o."order_id", 
    o."user_id", 
    o."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN (
    SELECT "user_id"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    GROUP BY "user_id"
    HAVING MIN("created_at") BETWEEN 1577836800000000 AND 1580515199000000
) j
  ON o."user_id" = j."user_id"
WHERE o."created_at" >= 1609459200000000     -- 2021-01-01 onwards
LIMIT 20;
```

```sql
--Description: Tie back to USERS table – display 20 random profiles from the Jan-2020 cohort for validation.
SELECT 
    u."id"          AS "user_id",
    u."first_name",
    u."last_name",
    u."gender",
