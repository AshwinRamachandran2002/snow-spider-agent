Query:
--Description: Calculate the proportion of January-2020 cohort users who returned later in 2020.
SELECT 
    r."returning_users",
    c."cohort_size",
    r."returning_users" * 1.0 / NULLIF(c."cohort_size",0) AS "return_rate_2020"
FROM (
        SELECT COUNT(DISTINCT o."user_id") AS "returning_users"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"  o
        JOIN (
                SELECT "user_id",
                       MIN("created_at") AS "first_purchase_2020"
                FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
                WHERE "created_at" BETWEEN 1577836800000000 AND 1609459199000000
                GROUP BY "user_id"
             ) c1
          ON o."user_id" = c1."user_id"
        WHERE c1."first_purchase_2020" BETWEEN 1577836800000000 AND 1580515199000000
          AND o."created_at" >  1580515199000000
          AND o."created_at" <= 1609459199000000
     ) r,
     (
        SELECT COUNT(DISTINCT "user_id") AS "cohort_size"
        FROM (
                SELECT "user_id",
                       MIN("created_at") AS "first_purchase_2020"
                FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
                WHERE "created_at" BETWEEN 1577836800000000 AND 1609459199000000
                GROUP BY "user_id"
             ) c2
        WHERE "first_purchase_2020" BETWEEN 1577836800000000 AND 1580515199000000
     ) c;
