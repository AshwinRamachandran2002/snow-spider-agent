--Description: Show calendar-month counts of repeat purchases (Feb-Dec 2020) for the January 2020 cohort to inspect return cadence.
SELECT TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM') AS "purchase_month",
       COUNT(DISTINCT o."user_id")                      AS "distinct_users"
