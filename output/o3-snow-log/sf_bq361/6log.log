```sql
--Description: Peek at some orders created in January 2020 to confirm the timestamp range that will be used for the cohort.
SELECT "order_id",
       "user_id",
       "status",
       "created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE "created_at" BETWEEN 1577836800000000  /* 2020-01-01 00:00:00 */
                       AND 1580515199000000  /* 2020-01-31 23:59:59 */
LIMIT 20;
```

```sql
--Description: For every user, get the date (micro-seconds epoch) of the FIRST order placed in calendar-year 2020.
SELECT "user_id",
       MIN("created_at") AS "first_purchase_2020"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE "created_at" BETWEEN 1577836800000000      /* 2020-01-01 */
                       AND 1609459199000000      /* 2020-12-31 */
GROUP BY "user_id"
LIMIT 20;
```

```sql
--Description: Keep only the users whose first purchase in 2020 fell inside January 2020 (the cohort of interest).
SELECT "user_id",
       "first_purchase_2020"
FROM (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_2020"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "created_at" BETWEEN 1577836800000000 AND 1609459199000000
        GROUP BY "user_id"
     ) t
WHERE "first_purchase_2020" BETWEEN 1577836800000000 AND 1580515199000000
LIMIT 20;
```

```sql
--Description: Count the total number of users in the January 2020 first-purchase cohort.
SELECT COUNT(DISTINCT "user_id") AS "cohort_size"
FROM (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_2020"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "created_at" BETWEEN 1577836800000000 AND 1609459199000000
        GROUP BY "user_id"
     ) c
WHERE "first_purchase_2020" BETWEEN 1577836800000000 AND 1580515199000000;
```

```sql
--Description: Show a few orders occurring AFTER January 2020 that belong to the cohort users (to verify “return” behaviour).
SELECT o."order_id",
       o."user_id",
       o."created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"  o
JOIN (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_2020"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "created_at" BETWEEN 1577836800000000 AND 1609459199000000
        GROUP BY "user_id"
     ) c
  ON o."user_id" = c."user_id"
WHERE c."first_purchase_2020" BETWEEN 1577836800000000 AND 1580515199000000
  AND o."created_at" >  1580515199000000          /* after Jan-31-2020 */
  AND o."created_at" <= 1609459199000000          /* still in 2020     */
LIMIT 20;
```

```sql
--Description: Count DISTINCT cohort users who placed at least one MORE order between February 1 and December 31 2020.
SELECT COUNT(DISTINCT o."user_id") AS "returning_users"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"  o
JOIN (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_2020"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "created_at" BETWEEN 1577836800000000 AND 1609459199000000
        GROUP BY "user_id"
     ) c
  ON o."user_id" = c."user_id"
WHERE c."first_purchase_2020" BETWEEN 1577836800000000 AND 1580515199000000
  AND o."created_at" >  1580515199000000
  AND o."created_at" <= 1609459199000000;
```

```sql
--Description: Calculate the proportion of January-2020 cohort users who returned later in 2020.
SELECT 
    r."returning_users",
    c."cohort_size",
    r."returning_users" * 1.0 / NULLIF(c."cohort_size",0) AS "return_rate_2020"
FROM (
        SELECT COUNT(DISTINCT o."user_id") AS "returning_users"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"  o
        JOIN (
                SELECT "user_id",
                       MIN("created_at") AS "first_purchase_2020"
                FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
                WHERE "created_at" BETWEEN 1577836800000000 AND 1609459199000000
                GROUP BY "user_id"
             ) c1
          ON o."user_id" = c1."user_id"
        WHERE c1."first_purchase_2020" BETWEEN 1577836800000000 AND 1580515199000000
          AND o."created_at" >  1580515199000000
          AND o."created_at" <= 1609459199000000
     ) r,
     (
        SELECT COUNT(DISTINCT "user_id") AS "cohort_size"
        FROM (
                SELECT "user_id",
                       MIN("created_at") AS "first_purchase_2020"
                FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
                WHERE "created_at" BETWEEN 1577836800000000 AND 1609459199000000
                GROUP BY "user_id"
             ) c2
        WHERE "first_purchase_2020" BETWEEN 1577836800000000 AND 1580515199000000
     ) c;
```

```sql
--Description: Display 20 cohort users together with a flag indicating whether they returned later in 2020 (1=yes, 0=no).
SELECT c."user_id",
       CASE WHEN r."user_id" IS NOT NULL THEN 1 ELSE 0 END AS "returned_in_2020"
FROM (
        SELECT DISTINCT "user_id"
        FROM (
                SELECT "user_id",
                       MIN("created_at") AS "first_purchase_2020"
                FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
                WHERE "created_at" BETWEEN 1577836800000000 AND 1609459199000000
                GROUP BY "user_id"
             ) x
        WHERE "first_purchase_2020" BETWEEN 1577836800000000 AND 1580515199000000
     ) c
LEFT JOIN (
            SELECT DISTINCT o."user_id"
            FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"  o
            JOIN (
                    SELECT "user_id",
                           MIN("created_at") AS "first_purchase_2020"
                    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
                    WHERE "created_at" BETWEEN 1577836800000000 AND 1609459199000000
                    GROUP BY "user_id"
                 ) y
              ON o."user_id" = y."user_id"
            WHERE y."first_purchase_2020" BETWEEN 1577836800000000 AND 1580515199000000
              AND o."created_at" > 1580515199000000
              AND o."created_at" <= 1609459199000000
          ) r
       ON c."user_id" = r."user_id"
LIMIT 20;
```

```sql
--Description: Show calendar-month counts of repeat purchases (Feb-Dec 2020) for the January 2020 cohort to inspect return cadence.
SELECT TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM') AS "purchase_month",
       COUNT(DISTINCT o."user_id")                      AS "distinct_users"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"  o
JOIN (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_2020"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "created_at" BETWEEN 1577836800000000 AND 1609459199000000
        GROUP BY "user_id"
     ) c
  ON o."user_id" = c."user_id"
WHERE c."first_purchase_2020" BETWEEN 1577836800000000 AND 1580515199000000
  AND o."created_at" >  1580515199000000
  AND o."created_at" <= 1609459199000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: (Optional deeper-dive) Pull a small sample of cohort users together with ALL their orders in 2020 to manually inspect behaviour.
SELECT o."user_id",
       o."order_id",
       o."status",
       o."created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
JOIN (
        SELECT DISTINCT "user_id"
        FROM (
                SELECT "user_id",
                       MIN("created_at") AS "first_purchase_2020"
                FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
                WHERE "created_at" BETWEEN 1577836800000000 AND 1609459199000000
                GROUP BY "user_id"
             )
        WHERE "first_purchase_2020" BETWEEN 1577836800000000 AND 1580515199000000
        LIMIT 20
     ) samp
  ON o."user_id" = samp."user_id"
WHERE o."created_at" BETWEEN 1577836800000000 AND 1609459199000000
ORDER BY o."user_id", o."created_at"
LIMIT 20;
```
