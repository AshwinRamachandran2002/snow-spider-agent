--Description: Inspect order-item level details for cohort users to verify returning behaviour
SELECT oi."id"              AS "order_item_id",
       oi."order_id",
       oi."user_id",
       oi."product_id",
       oi."status",
       oi."created_at",
       oi."sale_price"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
JOIN  (
