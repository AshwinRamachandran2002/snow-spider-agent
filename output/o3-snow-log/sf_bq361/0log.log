```

```sql
--Description: Isolate the January 2020 cohort (users whose 1st order fell in Jan-2020)
WITH firsts AS (
    SELECT "user_id",
           MIN("created_at") AS "first_purchase_ts"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP  BY "user_id"
)
SELECT *
FROM   firsts
WHERE  "first_purchase_ts" BETWEEN 1577836800000000 AND 1580515200000000  -- Jan-2020
LIMIT  20;
```

```sql
--Description: Count how many users belong to the January 2020 cohort
WITH firsts AS (
    SELECT "user_id",
           MIN("created_at") AS "first_purchase_ts"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP  BY "user_id"
)
SELECT COUNT(*) AS "jan_2020_cohort_size"
FROM   firsts
WHERE  "first_purchase_ts" BETWEEN 1577836800000000 AND 1580515200000000;
```

```sql
--Description: Fetch every 2020 order (after the 1st one) placed by January 2020 cohort members
WITH jan20_cohort AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_ts"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
        GROUP  BY "user_id"
    )
    WHERE "first_purchase_ts" BETWEEN 1577836800000000 AND 1580515200000000
)
SELECT o."order_id",
       o."user_id",
       o."created_at",
       o."status"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"  o
JOIN   jan20_cohort                               c  ON o."user_id" = c."user_id"
WHERE  o."created_at" >  1580515200000000         -- after 2020-02-01
  AND  o."created_at" <  1609459200000000         -- before 2021-01-01
LIMIT  20;
```

```sql
--Description: Translate micro-second stamp to calendar month for 2020 orders (cohort only)  
SELECT o."user_id",
       TO_CHAR(TO_TIMESTAMP_LTZ(o."created_at"/1000000), 'YYYY-MM') AS "order_month"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN (
      SELECT "user_id",
             MIN("created_at") AS "first_purchase_ts"
      FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
      GROUP  BY "user_id"
      HAVING MIN("created_at") BETWEEN 1577836800000000 AND 1580515200000000
     ) f
     ON o."user_id" = f."user_id"
WHERE  o."created_at" BETWEEN 1577836800000000 AND 1609459200000000  -- Year 2020
LIMIT  20;
```

```sql
--Description: Count how many cohort users placed at least one additional order in each month of 2020
WITH jan20_cohort AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_ts"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
        GROUP  BY "user_id"
    )
    WHERE  "first_purchase_ts" BETWEEN 1577836800000000 AND 1580515200000000
),
orders_2020 AS (
    SELECT o."user_id",
           TO_CHAR(TO_TIMESTAMP_LTZ(o."created_at"/1000000),'YYYY-MM') AS "order_month"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
    JOIN   jan20_cohort c ON o."user_id" = c."user_id"
    WHERE  o."created_at" BETWEEN 1577836800000000 AND 1609459200000000
)
SELECT "order_month",
       COUNT(DISTINCT "user_id") AS "returning_users"
FROM   orders_2020
GROUP  BY "order_month"
ORDER  BY "order_month"
LIMIT  20;
```

```sql
--Description: Derive the proportion of returning users (vs. total cohort) by 2020 month
WITH jan20_cohort AS (
    SELECT "user_id"
    FROM   (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_ts"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
        GROUP  BY "user_id"
    )
    WHERE  "first_purchase_ts" BETWEEN 1577836800000000 AND 1580515200000000
),
orders_2020 AS (
    SELECT o."user_id",
           TO_CHAR(TO_TIMESTAMP_LTZ(o."created_at"/1000000),'YYYY-MM') AS "order_month"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
    JOIN   jan20_cohort c ON o."user_id" = c."user_id"
    WHERE  o."created_at" BETWEEN 1577836800000000 AND 1609459200000000
      AND  o."created_at"   > 1580515200000000          -- exclude the first-month order itself
)
SELECT "order_month",
       COUNT(DISTINCT "user_id")            AS "returning_users",
       (SELECT COUNT(*) FROM jan20_cohort)  AS "cohort_size",
       COUNT(DISTINCT "user_id") /
       (SELECT COUNT(*) FROM jan20_cohort)::FLOAT AS "returning_prop"
FROM   orders_2020
GROUP  BY "order_month"
ORDER  BY "order_month"
LIMIT  20;
```

```sql
--Description: Display a few sample USERS belonging to the January 2020 cohort
SELECT u."id",
       u."first_name",
       u."last_name",
       u."email",
       u."created_at"       AS "user_created_ts"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
JOIN  (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_ts"
        FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
        GROUP  BY "user_id"
        HAVING MIN("created_at") BETWEEN 1577836800000000 AND 1580515200000000
      )  c
      ON u."id" = c."user_id"
LIMIT  20;
```

