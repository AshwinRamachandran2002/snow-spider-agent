```sql
--Description: See each shopper’s very first purchase time-stamp (micro-seconds since epoch)
SELECT "user_id",
       MIN("created_at")  AS "first_purchase_ts"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
GROUP  BY "user_id"
