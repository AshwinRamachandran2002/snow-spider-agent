--Description: 6) Count the total number of users in the January 2020 cohort
WITH firsts AS (
  SELECT "user_id",
         MIN(TO_CHAR(TO_TIMESTAMP("created_at"/1000000), 'YYYY-MM')) AS "first_month"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
