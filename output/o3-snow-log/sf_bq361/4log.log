```sql
--Description: 7) Among the January 2020 cohort, list who returned (any order) Feb-Dec 2020
WITH cohort AS (
  SELECT "user_id"
  FROM (
    SELECT "user_id",
           MIN(TO_CHAR(TO_TIMESTAMP("created_at"/1000000), 'YYYY-MM')) AS "first_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  )
  WHERE "first_month" = '2020-01'
)
SELECT DISTINCT o."user_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN cohort c ON o."user_id" = c."user_id"
WHERE TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM') BETWEEN '2020-02' AND '2020-12'
LIMIT 20;
```

```sql
--Description: 8) Count how many cohort users returned (Feb-Dec 2020)
WITH cohort AS (
  SELECT "user_id"
  FROM (
    SELECT "user_id",
           MIN(TO_CHAR(TO_TIMESTAMP("created_at"/1000000), 'YYYY-MM')) AS "first_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  )
  WHERE "first_month" = '2020-01'
),
returned AS (
  SELECT DISTINCT o."user_id"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  JOIN cohort c ON o."user_id" = c."user_id"
  WHERE TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM') BETWEEN '2020-02' AND '2020-12'
)
SELECT COUNT(*) AS "returned_users"
FROM returned;
```

```sql
--Description: 9) Compute the retention proportion for the January 2020 cohort
WITH firsts AS (
  SELECT "user_id",
         MIN(TO_CHAR(TO_TIMESTAMP("created_at"/1000000), 'YYYY-MM')) AS "first_month"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
  GROUP BY "user_id"
),
cohort AS (
  SELECT "user_id" FROM firsts WHERE "first_month" = '2020-01'
),
returned AS (
  SELECT DISTINCT o."user_id"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
  JOIN cohort c ON o."user_id" = c."user_id"
  WHERE TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM') BETWEEN '2020-02' AND '2020-12'
)
SELECT COUNT(r."user_id") / NULLIF(COUNT(c."user_id"),0)::FLOAT AS "retention_proportion"
FROM cohort c
LEFT JOIN returned r ON c."user_id" = r."user_id";
```

```sql
--Description: 10) Show month-by-month retention counts for the January 2020 cohort (Feb-Dec)
WITH cohort AS (
  SELECT "user_id"
  FROM (
    SELECT "user_id",
           MIN(TO_CHAR(TO_TIMESTAMP("created_at"/1000000), 'YYYY-MM')) AS "first_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    GROUP BY "user_id"
  )
  WHERE "first_month" = '2020-01'
)
SELECT TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM') AS "return_month",
       COUNT(DISTINCT o."user_id") AS "users_returned"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN cohort c ON o."user_id" = c."user_id"
WHERE TO_CHAR(TO_TIMESTAMP(o."created_at"/1000000), 'YYYY-MM') BETWEEN '2020-02' AND '2020-12'
GROUP BY "return_month"
ORDER BY "return_month"
LIMIT 20;
```
