-- 5. Count the total size of that January-2020 cohort
SELECT COUNT(DISTINCT "user_id") AS "cohort_size"
FROM (
      SELECT "user_id",
             MIN(TO_DATE(TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_date"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
      WHERE "status" ILIKE '%Complete%'
      GROUP BY "user_id"
     ) c
WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
LIMIT 20;
