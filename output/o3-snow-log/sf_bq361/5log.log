Query:
-- 6. All 2020 purchases made by users in that cohort (month granularity)
SELECT DATE_TRUNC('month', TO_DATE(TO_TIMESTAMP(oi."created_at"/1000000))) AS "order_month",
       oi."user_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN (
      SELECT "user_id"
      FROM (
            SELECT "user_id",
                   MIN(TO_DATE(TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_date"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
            WHERE "status" ILIKE '%Complete%'
            GROUP BY "user_id"
           )
      WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
     ) cohort
  ON cohort."user_id" = oi."user_id"
WHERE TO_DATE(TO_TIMESTAMP(oi."created_at"/1000000)) BETWEEN '2020-02-01' AND '2020-12-31'   -- months AFTER the first one
  AND oi."status" ILIKE '%Complete%'
LIMIT 20;
