LIMIT 20;
```

```sql
-- 5. Count the total size of that January-2020 cohort
SELECT COUNT(DISTINCT "user_id") AS "cohort_size"
FROM (
      SELECT "user_id",
             MIN(TO_DATE(TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_date"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
      WHERE "status" ILIKE '%Complete%'
      GROUP BY "user_id"
     ) c
WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
LIMIT 20;
```

```sql
-- 6. All 2020 purchases made by users in that cohort (month granularity)
SELECT DATE_TRUNC('month', TO_DATE(TO_TIMESTAMP(oi."created_at"/1000000))) AS "order_month",
       oi."user_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN (
      SELECT "user_id"
      FROM (
            SELECT "user_id",
                   MIN(TO_DATE(TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_date"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
            WHERE "status" ILIKE '%Complete%'
            GROUP BY "user_id"
           )
      WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
     ) cohort
  ON cohort."user_id" = oi."user_id"
WHERE TO_DATE(TO_TIMESTAMP(oi."created_at"/1000000)) BETWEEN '2020-02-01' AND '2020-12-31'   -- months AFTER the first one
  AND oi."status" ILIKE '%Complete%'
LIMIT 20;
```

```sql
-- 7. Distinct cohort users who purchased in each subsequent month of 2020
SELECT DATE_TRUNC('month', TO_DATE(TO_TIMESTAMP(oi."created_at"/1000000))) AS "order_month",
       COUNT(DISTINCT oi."user_id")                                     AS "returning_users"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN (
      SELECT "user_id"
      FROM (
            SELECT "user_id",
                   MIN(TO_DATE(TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_date"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
            WHERE "status" ILIKE '%Complete%'
            GROUP BY "user_id"
           )
      WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
     ) cohort
  ON cohort."user_id" = oi."user_id"
WHERE TO_DATE(TO_TIMESTAMP(oi."created_at"/1000000)) BETWEEN '2020-02-01' AND '2020-12-31'
  AND oi."status" ILIKE '%Complete%'
GROUP BY DATE_TRUNC('month', TO_DATE(TO_TIMESTAMP(oi."created_at"/1000000)))
ORDER BY "order_month"
LIMIT 20;
```

```sql
-- 8. Combine cohort size with each month’s return count to calculate retention %
SELECT r."order_month",
       r."returning_users",
       c."cohort_size",
       ROUND(r."returning_users" / c."cohort_size" * 100, 2) AS "retention_pct"
FROM (
      SELECT COUNT(DISTINCT "user_id") AS "cohort_size"
      FROM (
            SELECT "user_id",
                   MIN(TO_DATE(TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_date"
            FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
            WHERE "status" ILIKE '%Complete%'
            GROUP BY "user_id"
           ) x
      WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
     ) c
CROSS JOIN (
      SELECT DATE_TRUNC('month', TO_DATE(TO_TIMESTAMP(oi."created_at"/1000000))) AS "order_month",
             COUNT(DISTINCT oi."user_id")                                      AS "returning_users"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
      JOIN (
            SELECT "user_id"
            FROM (
                  SELECT "user_id",
                         MIN(TO_DATE(TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_date"
                  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
                  WHERE "status" ILIKE '%Complete%'
                  GROUP BY "user_id"
                 )
            WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
           ) cohort
        ON cohort."user_id" = oi."user_id"
      WHERE TO_DATE(TO_TIMESTAMP(oi."created_at"/1000000)) BETWEEN '2020-02-01' AND '2020-12-31'
        AND oi."status" ILIKE '%Complete%'
      GROUP BY DATE_TRUNC('month', TO_DATE(TO_TIMESTAMP(oi."created_at"/1000000)))
     ) r
ORDER BY r."order_month"
LIMIT 20;
```

```sql
-- 9. Pivoted (wide-format) retention matrix: one row for the Jan-2020 cohort
SELECT *
FROM (
      SELECT 1 AS "cohort_id",       -- single cohort tag
             TO_CHAR(DATE_TRUNC('month', TO_DATE(TO_TIMESTAMP(oi."created_at"/1000000))), 'YYYY-MM') AS "period",
             COUNT(DISTINCT oi."user_id")                                                           AS "returning"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
      JOIN (
            SELECT "user_id"
            FROM (
                  SELECT "user_id",
                         MIN(TO_DATE(TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_date"
                  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
                  WHERE "status" ILIKE '%Complete%'
                  GROUP BY "user_id"
                 )
            WHERE "first_purchase_date" BETWEEN '2020-01-01' AND '2020-01-31'
           ) cohort
        ON cohort."user_id" = oi."user_id"
      WHERE TO_DATE(TO_TIMESTAMP(oi."created_at"/1000000)) BETWEEN '2020-01-01' AND '2020-12-31'
        AND oi."status" ILIKE '%Complete%'
      GROUP BY TO_CHAR(DATE_TRUNC('month', TO_DATE(TO_TIMESTAMP(oi."created_at"/1000000))), 'YYYY-MM')
     )
PIVOT( MAX("returning") FOR "period" IN ('2020-01', '2020-02', '2020-03', '2020-04',
                                         '2020-05', '2020-06', '2020-07', '2020-08',
                                         '2020-09', '2020-10', '2020-11', '2020-12') )
LIMIT 20;
```
