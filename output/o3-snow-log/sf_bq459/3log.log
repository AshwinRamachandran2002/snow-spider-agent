WITH
/* ------------------------  STOP-WORDS  ------------------------ */
stopwords(word) AS (
  SELECT column1
  FROM VALUES
 ('a'),('an'),('the'),('and'),('or'),('but'),('if'),('while'),('with'),
 ('without'),('of'),('at'),('by'),('for'),('to'),('in'),('on'),('is'),
 ('are'),('was'),('were'),('be'),('been'),('being'),('this'),('that'),
 ('these'),('those'),('as'),('from'),('it'),('its'),('into'),('about'),
 ('after'),('before'),('between'),('among'),('so'),('than'),('too'),
 ('very'),('can'),('cannot'),('will'),('would'),('should'),('could'),
 ('may'),('might'),('must'),('do'),('does'),('did'),('done'),('such'),
 ('no'),('not'),('nor'),('only'),('own'),('same')
),

/* ======================  QUERY VECTOR  ======================== */
query_tokens AS (          -- tokenize & drop stop-words
  SELECT LOWER(TRIM(tok.value)) AS token
  FROM LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(
                     'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                     '[^A-Za-z]+',' '
                   ), ' ')
       ) tok
  WHERE token <> ''
    AND token NOT IN (SELECT word FROM stopwords)
),
query_elem AS (            -- weighted vector elements (per dimension)
  SELECT fl.index                    AS idx,
         SUM(fl.value * POWER(wf."frequency", -0.4)) AS val
  FROM query_tokens qt
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv ON gv."word" = qt.token
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf ON wf."word" = qt.token,
       LATERAL FLATTEN(INPUT => gv."vector") fl
  GROUP BY idx
),
query_vec AS (             -- aggregated vector as ARRAY
  SELECT ARRAY_AGG(val ORDER BY idx) AS q_vec
  FROM   query_elem
),
query_norm AS (            -- vector norm
  SELECT SQRT(SUM(POWER(f.value,2))) AS q_norm
  FROM   query_vec,
         LATERAL FLATTEN(INPUT => q_vec) f
),

/* =====================  ARTICLE VECTORS  ====================== */
article_elem AS (          -- weighted element-wise values for every article
  SELECT n."id",
         n."date",
         n."title",
         fl.index                                           AS idx,
         SUM(fl.value * POWER(wf."frequency", -0.4))        AS val
  FROM  WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
        LATERAL SPLIT_TO_TABLE(
                 REGEXP_REPLACE(LOWER(n."body"), '[^A-Za-z]+',' '),
                 ' '
               ) st         -- token table
        LEFT JOIN stopwords sw                 ON LOWER(TRIM(st.value)) = sw.word
        JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
             ON gv."word" = LOWER(TRIM(st.value))
        JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
             ON wf."word" = gv."word",
        LATERAL FLATTEN(INPUT => gv."vector") fl
  WHERE st.value <> ''
    AND sw.word IS NULL
  GROUP BY n."id", n."date", n."title", idx
),
article_vec AS (           -- vector per article (as ARRAY)
  SELECT id, date, title,
         ARRAY_AGG(val ORDER BY idx) AS a_vec
  FROM   article_elem
  GROUP  BY id, date, title
),
article_norm AS (          -- norm per article
  SELECT id, date, title, a_vec,
         SQRT(SUM(POWER(f.value,2))) AS a_norm
  FROM   article_vec,
