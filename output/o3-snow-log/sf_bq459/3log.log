/* ---------------------------------------------------------------
   1)  VECTOR-UTILITY JAVASCRIPT UDFS
   -------------------------------------------------------------*/
CREATE OR REPLACE FUNCTION WORD_VECTORS_US.WORD_VECTORS_US.WEIGHT_VECTOR
          (vec  VARIANT , w FLOAT)
RETURNS ARRAY
LANGUAGE JAVASCRIPT
AS
$$
return vec.map(v => v * w);
$$;

CREATE OR REPLACE FUNCTION WORD_VECTORS_US.WORD_VECTORS_US.VECTOR_ADD
          (a ARRAY , b ARRAY)
RETURNS ARRAY
LANGUAGE JAVASCRIPT
AS
$$
if (a===null)        return b;
if (b===null)        return a;
for (let i=0;i<a.length;i++){ a[i] += b[i]; }
return a;
$$;

CREATE OR REPLACE FUNCTION WORD_VECTORS_US.WORD_VECTORS_US.VECTOR_ARRAY_SUM
          (arr ARRAY)
RETURNS ARRAY
LANGUAGE JAVASCRIPT
AS
$$
let sum = null;
for (let k=0;k<arr.length;k++){
   sum = VECTOR_ADD(sum , arr[k]);
}
return sum;
$$;

CREATE OR REPLACE FUNCTION WORD_VECTORS_US.WORD_VECTORS_US.VECTOR_NORM
          (vec ARRAY)
RETURNS FLOAT
LANGUAGE JAVASCRIPT
AS
$$
let s = 0;
for (let i=0;i<vec.length;i++){ s += vec[i]*vec[i]; }
return Math.sqrt(s);
$$;

CREATE OR REPLACE FUNCTION WORD_VECTORS_US.WORD_VECTORS_US.VECTOR_NORMALIZE
          (vec ARRAY)
RETURNS ARRAY
LANGUAGE JAVASCRIPT
AS
$$
let n = VECTOR_NORM(vec);
if (n===0) return vec;
return vec.map(v => v / n);
$$;

CREATE OR REPLACE FUNCTION WORD_VECTORS_US.WORD_VECTORS_US.DOT
          (a ARRAY , b ARRAY)
RETURNS FLOAT
LANGUAGE JAVASCRIPT
AS
$$
let s = 0;
for (let i=0;i<a.length;i++){ s += a[i]*b[i]; }
return s;
$$;


/* ---------------------------------------------------------------
   2)  FIND TOP-10 MOST SIMILAR ARTICLES
   -------------------------------------------------------------*/
WITH

/* simple stop-word list ------------------------------------------------*/
stopwords(word) AS (
  SELECT column1 FROM VALUES
 ('a'),('an'),('the'),('and'),('or'),('but'),('if'),('while'),('with'),
 ('without'),('of'),('at'),('by'),('for'),('to'),('in'),('on'),('is'),
 ('are'),('was'),('were'),('be'),('been'),('being'),('this'),('that'),
 ('these'),('those'),('as'),('from'),('it'),('its'),('into'),('about'),
 ('after'),('before'),('between'),('among'),('so'),('than'),('too'),
 ('very'),('can'),('cannot'),('will'),('would'),('should'),('could'),
 ('may'),('might'),('must'),('do'),('does'),('did'),('done'),('such'),
 ('no'),('not'),('nor'),('only'),('own'),('same')
),

/* -----------------------  QUERY VECTOR  -------------------------------*/
query_tokens AS (
  SELECT LOWER(TRIM(tok.value)) AS token
  FROM LATERAL FLATTEN(
           INPUT => SPLIT(
                     REGEXP_REPLACE(
                       'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                       '[^A-Za-z]+', ' '
                     ), ' ')
       ) tok
  WHERE token <> ''
    AND token NOT IN (SELECT word FROM stopwords)
),
query_weighted AS (
  SELECT WORD_VECTORS_US.WORD_VECTORS_US.WEIGHT_VECTOR(g."vector",
         POWER(f."frequency", -0.4)) AS wvec
  FROM query_tokens qt
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  g ON g."word" = qt.token
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f ON f."word" = qt.token
),
query_sum AS (
  SELECT WORD_VECTORS_US.WORD_VECTORS_US.VECTOR_ARRAY_SUM(ARRAY_AGG(wvec)) AS vec
  FROM   query_weighted
),
query_unit AS (
  SELECT WORD_VECTORS_US.WORD_VECTORS_US.VECTOR_NORMALIZE(vec) AS q_vec
  FROM   query_sum
),

/* ----------------------  ARTICLE VECTORS  -----------------------------*/
article_tokens AS (
  SELECT n."id",
         n."date",
         n."title",
         LOWER(TRIM(tok.value)) AS token
  FROM  WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
        LATERAL FLATTEN(
            INPUT => SPLIT(
                     REGEXP_REPLACE(LOWER(n."body"), '[^A-Za-z]+', ' '), ' ')
        ) tok
  WHERE token <> ''
    AND token NOT IN (SELECT word FROM stopwords)
),
article_weighted AS (
  SELECT at."id",
         at."date",
         at."title",
         WORD_VECTORS_US.WORD_VECTORS_US.WEIGHT_VECTOR(g."vector",
              POWER(f."frequency", -0.4)) AS wvec
  FROM article_tokens at
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  g ON g."word" = at.token
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f ON f."word" = at.token
),
article_sum AS (
  SELECT "id",
         "date",
         "title",
         WORD_VECTORS_US.WORD_VECTORS_US.VECTOR_ARRAY_SUM(ARRAY_AGG(wvec)) AS vec
  FROM   article_weighted
  GROUP  BY "id","date","title"
),
article_unit AS (
  SELECT id,
         date,
         title,
         WORD_VECTORS_US.WORD_VECTORS_US.VECTOR_NORMALIZE(vec) AS a_vec
  FROM   article_sum
),

/* ---------------------  COSINE SIMILARITY  ----------------------------*/
similarity AS (
  SELECT au.id,
         au.date,
         au.title,
         WORD_VECTORS_US.WORD_VECTORS_US.DOT(au.a_vec, qu.q_vec) AS cosine_similarity
  FROM   article_unit au
  CROSS  JOIN query_unit qu
)

/* --------------------------  RESULT  ----------------------------------*/
SELECT   id,
         date,
         title,
         cosine_similarity
FROM     similarity
ORDER BY cosine_similarity DESC NULLS LAST
LIMIT    10;
```
