 ('a'),('an'),('the'),('and'),('or'),('but'),('if'),('while'),('with'),
 ('without'),('of'),('at'),('by'),('for'),('to'),('in'),('on'),('is'),
 ('are'),('was'),('were'),('be'),('been'),('being'),('this'),('that'),
 ('these'),('those'),('as'),('from'),('it'),('its'),('into'),('about'),
 ('after'),('before'),('between'),('among'),('so'),('than'),('too'),
 ('very'),('can'),('cannot'),('will'),('would'),('should'),('could'),
 ('may'),('might'),('must'),('do'),('does'),('did'),('done'),('such'),
 ('no'),('not'),('nor'),('only'),('own'),('same')
),

/* ====================  QUERY ELEMENTS  ==================== */
query_tokens AS (
  SELECT LOWER(TRIM(tok.value::string)) AS token
  FROM LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(
                     'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                     '[^A-Za-z]+', ' '
                   ), ' ')
       ) tok
  WHERE token <> ''
    AND token NOT IN (SELECT word FROM stopwords)
),
query_elem AS (
  SELECT f.index AS idx,
         SUM(f.value::float * POWER(wf."frequency", -0.4)) AS val
  FROM   query_tokens qt
  JOIN   WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
         ON gv."word" = qt.token,
         LATERAL FLATTEN(INPUT => gv."vector") f
  JOIN   WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON wf."word" = gv."word"
  GROUP  BY f.index
),
query_norm AS (
  SELECT SQRT(SUM(val*val)) AS q_norm
  FROM   query_elem
),

/* ===================  ARTICLE ELEMENTS  =================== */
article_tokens AS (
  SELECT n."id",
         n."date",
         n."title",
         LOWER(TRIM(tok.value::string)) AS token
  FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
           INPUT => SPLIT(
                     REGEXP_REPLACE(LOWER(n."body"), '[^A-Za-z]+', ' '),
                     ' ')
         ) tok
  WHERE token <> ''
    AND token NOT IN (SELECT word FROM stopwords)
),
article_elem AS (
  SELECT at.id,
         at.date,
         at.title,
         f.index AS idx,
         SUM(f.value::float * POWER(wf."frequency", -0.4)) AS val
  FROM   article_tokens at
  JOIN   WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
         ON gv."word" = at.token,
         LATERAL FLATTEN(INPUT => gv."vector") f
  JOIN   WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON wf."word" = gv."word"
  GROUP  BY at.id, at.date, at.title, f.index
),
article_norm AS (
  SELECT id,
         date,
         title,
         SQRT(SUM(val*val)) AS a_norm
  FROM   article_elem
  GROUP  BY id, date, title
),

/* ====================  DOT PRODUCTS  ===================== */
dot_prod AS (
  SELECT ae.id,
         SUM(ae.val * qe.val) AS dot_val
  FROM   article_elem ae
  JOIN   query_elem   qe USING (idx)
  GROUP  BY ae.id
)

/* =====================  FINAL RESULT  ===================== */
SELECT  an.id,
        an.date,
        an.title,
        (dp.dot_val / (an.a_norm * qn.q_norm)) AS cosine_similarity
FROM    dot_prod     dp
JOIN    article_norm an ON an.id = dp.id,
        query_norm   qn
WHERE   an.a_norm > 0
ORDER BY cosine_similarity DESC NULLS LAST
LIMIT   10;
```
