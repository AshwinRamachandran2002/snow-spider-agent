article_tokens AS (
  SELECT
    n.id,
    n.date,
    n.title,
    LOWER(TRIM(f.value::string)) AS token
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   LOWER(
                     REGEXP_REPLACE(n.body, '[^a-z0-9 ]', ' ')
                   ),
                   ' '
                 )
       ) f
  WHERE token <> ''
    AND token NOT IN (SELECT word FROM stopwords)
),

/* ----------- attach vectors & weights for each token ----------- */
article_components AS (
  SELECT
    at.id,
    at.date,
    at.title,
    g.vector                                           AS vec,
    1 / POWER(w.frequency, 0.4)                        AS wt
  FROM article_tokens at
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES w
       ON w.word = at.token
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
       ON g.word = at.token
),

/* ----------- build a single embedding per article ----------- */
article_embeds AS (
  SELECT
    id,
    date,
    title,
    VECTOR_NORMALIZE(
      VECTOR_ADD_AGG(
        VECTOR_SCALE(vec, wt)
      )
    ) AS art_vec
  FROM article_components
  GROUP BY id, date, title
),

/* ----------- cosine similarity with the query ----------- */
similarities AS (
  SELECT
    a.id,
    a.date,
    a.title,
    VECTOR_DOT_PRODUCT(a.art_vec, q.q_vec) AS cosine_similarity
  FROM article_embeds a
  CROSS JOIN query_embed q
)

/* ----------- top-10 most similar articles ----------- */
SELECT
  id,
  date,
  title,
  cosine_similarity
FROM similarities
ORDER BY cosine_similarity DESC NULLS LAST
LIMIT 10;
