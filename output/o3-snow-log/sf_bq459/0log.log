    1 / POWER(w.frequency, 0.4)                            AS wt
  FROM query_tokens qt
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES w
       ON w.word = qt.token
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
       ON g.word = qt.token
),

/* ----------- aggregate & normalise query embedding ----------- */
query_embed AS (
  SELECT VECTOR_NORMALIZE(
           VECTOR_ADD_AGG(
             VECTOR_SCALE(vec, wt)
           )
         ) AS q_vec
  FROM query_components
),

