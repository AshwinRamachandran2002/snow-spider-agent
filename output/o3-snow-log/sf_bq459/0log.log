```sql
/* ---------------------------------------------------------
   Top-10 Nature articles most similar to the query
   “Epigenetics and cerebral organoids: promising directions
    in autism spectrum disorders” – cosine similarity is
   computed after building frequency-weighted GloVe vectors
--------------------------------------------------------- */
WITH

/* ---------------- stop-word list ---------------- */
stopwords AS (
  SELECT column1 AS word
  FROM VALUES
    ('a'),('an'),('and'),('are'),('as'),('at'),('be'),('because'),('been'),
    ('before'),('between'),('but'),('by'),('during'),('for'),('from'),
    ('in'),('into'),('is'),('it'),('its'),('of'),('on'),('or'),('over'),
    ('so'),('such'),('than'),('that'),('the'),('their'),('then'),('there'),
    ('these'),('those'),('this'),('to'),('under'),('was'),('were'),('with'),
    ('without')
),

/* ------------ 1)  QUERY EMBEDDING ---------------- */
query_tokens AS (        /* tokenise, lowercase, drop stops           */
  SELECT LOWER(TRIM(f.value::string)) AS token
  FROM LATERAL FLATTEN(
         INPUT => SPLIT(
                   LOWER(
                     REGEXP_REPLACE(
                       'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                       '[^a-z0-9 ]', ' '
                     )
                   ),
                   ' '
                 )
       ) f
  WHERE token <> ''
    AND token NOT IN (SELECT word FROM stopwords)
),
query_vectors AS (       /* attach vectors & frequency weights        */
  SELECT
    g."vector"                          AS vec,
    1 / POWER(w."frequency", 0.4)       AS wt
  FROM query_tokens qt
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES w
       ON w."word" = qt.token
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
       ON g."word" = qt.token
),
query_dim_vals AS (      /* weight & explode to (dim , value) rows    */
  SELECT
    f.index                         AS dim,
    (f.value::FLOAT) * wt           AS val
  FROM query_vectors qv,
       LATERAL FLATTEN(INPUT => qv.vec) f
),
query_dim_sum AS (       /* sum contributions per dimension           */
  SELECT dim, SUM(val) AS val
  FROM query_dim_vals
  GROUP BY dim
),
query_norm AS (          /* L2-norm                                    */
  SELECT SQRT(SUM(val*val)) AS norm
  FROM query_dim_sum
),
query_dim_norm AS (      /* normalised query vector                   */
  SELECT qds.dim,
         qds.val / qn.norm AS val
  FROM query_dim_sum qds, query_norm qn
),

/* ------------ 2)  ARTICLE EMBEDDINGS ------------- */
article_tokens AS (      /* tokenise every article body                */
  SELECT
    n.id,
    n.date,
    n.title,
    LOWER(TRIM(f.value::string)) AS token
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   LOWER(
                     REGEXP_REPLACE(n.body, '[^a-z0-9 ]', ' ')
                   ),
                   ' '
                 )
       ) f
  WHERE token <> ''
    AND token NOT IN (SELECT word FROM stopwords)
),
article_vectors AS (     /* attach vectors & weights                   */
  SELECT
    at.id,
    at.date,
    at.title,
    g."vector"                       AS vec,
    1 / POWER(w."frequency", 0.4)    AS wt
  FROM article_tokens at
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES w
       ON w."word" = at.token
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
       ON g."word" = at.token
),
article_dim_vals AS (    /* weighted (dim , value) rows per article    */
  SELECT
    av.id,
    av.date,
    av.title,
    f.index                        AS dim,
    (f.value::FLOAT) * av.wt       AS val
  FROM article_vectors av,
       LATERAL FLATTEN(INPUT => av.vec) f
),
article_dim_sum AS (     /* sum per article & dimension                */
  SELECT
    id,
    date,
    title,
    dim,
    SUM(val) AS val
  FROM article_dim_vals
  GROUP BY id, date, title, dim
),
article_norms AS (       /* article vector norms                       */
  SELECT
    id,
    SQRT(SUM(val*val)) AS norm
  FROM article_dim_sum
  GROUP BY id
),
article_dim_norm AS (    /* normalised article vectors                 */
  SELECT
    ads.id,
    ads.date,
    ads.title,
    ads.dim,
    ads.val / an.norm   AS val
  FROM article_dim_sum ads
  JOIN article_norms   an USING (id)
  WHERE an.norm > 0
),

/* ------------ 3)  COSINE SIMILARITIES ------------ */
similarities AS (
  SELECT
    adn.id,
    adn.date,
    adn.title,
    SUM(adn.val * qdn.val) AS cosine_similarity
  FROM article_dim_norm  adn
  JOIN query_dim_norm    qdn
       ON adn.dim = qdn.dim
  GROUP BY adn.id, adn.date, adn.title
)

/* ------------ 4)  TOP-10 RESULTS ----------------- */
SELECT
  id,
  date,
  title,
  cosine_similarity
FROM similarities
ORDER BY cosine_similarity DESC NULLS LAST
LIMIT 10;
```
