WITH 

/* ---------------  stop-word list -------------- */
stopwords(word) AS (
  SELECT column1 FROM VALUES
  ('a'),('an'),('and'),('are'),('as'),('at'),('be'),('because'),('been'),
  ('before'),('between'),('but'),('by'),('during'),('for'),('from'),
  ('in'),('into'),('is'),('it'),('its'),('of'),('on'),('or'),('over'),
  ('so'),('such'),('than'),('that'),('the'),('their'),('then'),('there'),
  ('these'),('those'),('this'),('to'),('under'),('was'),('were'),('with'),
  ('without')
),

/* ---------------  build weighted-sum vector for the query -------------- */
query_tokens AS (
  SELECT LOWER(TRIM(tok)) AS word
  FROM TABLE(
         FLATTEN(
           input => REGEXP_SPLIT_TO_ARRAY(
                      LOWER(
                        REGEXP_REPLACE(
                          'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                          '[^a-z0-9 ]',        -- keep only letters / digits / blanks
                          ' '
                        )
                      ),
                      ' +'
                    )
         )
       ) AS f(tok)
  WHERE word <> '' AND word NOT IN (SELECT word FROM stopwords)
),
query_components AS (
  SELECT 
    g.vector                               AS vec,
    1 / POWER(w.frequency, 0.4)            AS wt
  FROM query_tokens t
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES w USING (word)
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS      g USING (word)
),
query_embed AS (
  /* VECTOR_SCALE, VECTOR_ADD_AGG and VECTOR_NORMALIZE are Snowflake
     vector helper routines introduced for VARIANT-array embeddings   */
  SELECT VECTOR_NORMALIZE(
           VECTOR_ADD_AGG(
             VECTOR_SCALE(vec , wt)
           )
         ) AS q_vec
  FROM query_components
),

/* ---------------  explode every Nature body into token rows -------------- */
article_tokens AS (
  SELECT 
    n.id,
    n.date,
    n.title,
    LOWER(TRIM(f.value::string)) AS word
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         input => REGEXP_SPLIT_TO_ARRAY(
                    LOWER(REGEXP_REPLACE(n.body, '[^a-z0-9 ]', ' ')),
                    ' +'
                  )
       ) f
  WHERE word <> '' AND word NOT IN (SELECT word FROM stopwords)
),

/* ---------------  fetch GloVe vectors, apply frequency weighting -------------- */
article_components AS (
  SELECT
    at.id,
    at.date,
    at.title,
    g.vector                            AS vec,
    1 / POWER(w.frequency, 0.4)         AS wt
  FROM article_tokens at
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES w USING (word)
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS      g USING (word)
),

/* ---------------  sum & normalise to one vector per article -------------- */
article_embeds AS (
  SELECT
    id,
    date,
    title,
    VECTOR_NORMALIZE(
      VECTOR_ADD_AGG(
        VECTOR_SCALE(vec , wt)
      )
    ) AS art_vec
  FROM article_components
  GROUP BY id, date, title
),

/* ---------------  cosine similarity against the query -------------- */
similarities AS (
  SELECT 
    a.id,
    a.date,
    a.title,
    VECTOR_DOT_PRODUCT(a.art_vec, q.q_vec) AS cosine_similarity
  FROM article_embeds a
  CROSS JOIN query_embed q
)

/* ---------------  final top-10 list -------------- */
SELECT 
  id,
  date,
  title,
  cosine_similarity
FROM similarities
ORDER BY cosine_similarity DESC NULLS LAST
LIMIT 10;
