WITH
/* ---------- stop-word list ---------- */
stopwords(word) AS (
    SELECT column1 FROM VALUES
        ('a'),('an'),('and'),('are'),('as'),('at'),('be'),('by'),('for'),
        ('from'),('in'),('is'),('it'),('of'),('on'),('or'),('that'),
        ('the'),('this'),('to'),('was'),('were'),('with')
),

/* ---------- prepare query vector ---------- */
query_phrase AS (
    SELECT 'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders' AS q
),
query_tokens AS (       -- tokenise, lowercase, remove punctuation & stop-words
    SELECT LOWER(TRIM(tok.value::STRING)) AS token
    FROM query_phrase,
         LATERAL FLATTEN(
                  INPUT => SPLIT(
                               REGEXP_REPLACE(LOWER(q), '[^a-z0-9 ]', ' '),
                               ' ')
              ) tok
    WHERE tok.value::STRING <> ''
      AND LOWER(TRIM(tok.value::STRING)) NOT IN (SELECT word FROM stopwords)
),
query_vec AS (          -- weight, sum (avg), then normalise
    SELECT VECTOR_NORMALIZE(
               VECTOR_AVG(
                   VECTOR_SCALE(
                       TO_VECTOR(gv."vector"),
                       1 / POWER(wf."frequency", 0.4)
                   )
               )
           ) AS vec
    FROM query_tokens qt
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS      gv ON gv."word" = qt.token
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES   wf ON wf."word" = qt.token
),

/* ---------- build article token-level weighted vectors ---------- */
article_token_vectors AS (
    SELECT
        n."id",
        n."date",
        n."title",
        VECTOR_SCALE(
            TO_VECTOR(gv."vector"),
            1 / POWER(wf."frequency", 0.4)
        ) AS scaled_vec
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
    ,    LATERAL FLATTEN(
              INPUT => SPLIT(
                           REGEXP_REPLACE(LOWER(n."body"), '[^a-z0-9 ]', ' '),
                           ' ')
         ) tok
    LEFT JOIN stopwords s
           ON LOWER(TRIM(tok.value::STRING)) = s.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    gv
           ON gv."word" = LOWER(TRIM(tok.value::STRING))
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
           ON wf."word" = LOWER(TRIM(tok.value::STRING))
    WHERE tok.value::STRING <> ''
      AND s.word IS NULL               -- drop stop-words
),

/* ---------- aggregate to one normalised vector per article ---------- */
article_vectors AS (
    SELECT
        "id",
        MAX("date")  AS "date",
        MAX("title") AS "title",
        VECTOR_NORMALIZE( VECTOR_AVG(scaled_vec) ) AS vec
    FROM article_token_vectors
    GROUP BY "id"
),

/* ---------- cosine similarity (dot product of two unit vectors) ---------- */
similarities AS (
    SELECT
        a."id",
        a."date",
        a."title",
        VECTOR_DOT_PRODUCT(a.vec, (SELECT vec FROM query_vec)) AS similarity
    FROM article_vectors a
)

/* ---------- top 10 most relevant articles ---------- */
SELECT
    "id",
    "date",
    "title",
    similarity
FROM similarities
ORDER BY similarity DESC NULLS LAST
LIMIT 10;
```
