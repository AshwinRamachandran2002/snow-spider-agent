```sql
--Description: Preview a few Nature records to understand the basic data layout and key columns.
SELECT "id", "date", "title", "body"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
LIMIT 20;
```

```sql
--Description: Check which publication years are present in the Nature table.  
SELECT DISTINCT YEAR("date") AS "year"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: Quickly find Nature articles whose titles mention autism (case-insensitive wildcard search).  
SELECT "id", "date", "title"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "title" ILIKE '%autism%'
LIMIT 20;
```

```sql
--Description: Look for articles that mention “organoid” somewhere in the body text.  
SELECT "id", "date", "title"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "body" ILIKE '%organoid%'
LIMIT 20;
```

```sql
--Description: Retrieve the pre-trained GloVe vector for the word “epigenetics”.  
SELECT "word", "vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS
WHERE "word" = 'epigenetics'
LIMIT 20;
```

```sql
--Description: Get the corpus frequency of the word “epigenetics” from WORD_FREQUENCIES.  
SELECT "word", "frequency"
FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES
WHERE "word" = 'epigenetics'
LIMIT 20;
```

```sql
--Description: Inspect a handful of distinct author strings to see formatting.  
SELECT DISTINCT "authors"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
LIMIT 20;
```

```sql
--Description: Sample some of the most common words in WORD_FREQUENCIES (highest frequency values).  
SELECT "word", "frequency"
FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES
ORDER BY "frequency" DESC
LIMIT 20;
```

```sql
--Description: For a small set of biomedical keywords, check if both GloVe vectors and frequencies exist (inner join).  
SELECT wf."word", wf."frequency", gv."vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON wf."word" = gv."word"
WHERE wf."word" IN ('autism', 'epigenetics', 'organoids', 'cerebral')
LIMIT 20;
```

```sql
--Description: Count how many Nature articles actually have a non-null body (needed for vector construction).  
SELECT COUNT(*) AS "articles_with_body"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "body" IS NOT NULL;
```
