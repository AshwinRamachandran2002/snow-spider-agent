/*─────────────────────────────────────────────────────────────────────────
   Top-10 Nature articles most similar to the query
   “Epigenetics and cerebral organoids: promising directions in autism
   spectrum disorders”, using frequency-re-weighted GloVe embeddings.
   –––  Implementation focuses on speed by:
        •  counting repeated tokens before vector look-up
        •  joining to GloVe / frequency tables only once per (article,token)
─────────────────────────────────────────────────────────────────────────*/
WITH
/*-------------------------------------------------  stop-words  --------*/
stopwords AS (
    SELECT column1 AS word
    FROM ( VALUES
        ('the'),('a'),('an'),('and'),('or'),('in'),('of'),('to'),
        ('is'),('are'),('was'),('were'),('be'),('been'),('this'),
        ('that'),('these'),('those'),('for'),('on'),('with'),('as'),
        ('by'),('at'),('from'),('which'),('also'),('it'),('its'),
        ('can'),('may'),('not'),('but'),('we'),('our'),('they'),
        ('their'),('than'),('other'),('such'),('have'),('has'),
        ('had'),('more'),('most'),('some'),('into'),('using'),('use')
    ) v(column1)
),

/*======================   1)  query vector   ===========================*/
query_tokens AS (
    SELECT LOWER(value)::STRING AS token
    FROM TABLE(
        SPLIT_TO_TABLE(
            REGEXP_REPLACE(
                LOWER('Epigenetics and cerebral organoids: promising directions in autism spectrum disorders'),
                '[^a-z ]',' '
            ),
            ' '
        )
    )
    WHERE token <> ''
      AND token NOT IN (SELECT word FROM stopwords)
),

query_token_counts AS (
    SELECT token, COUNT(*) AS tok_cnt
    FROM   query_tokens
    GROUP BY token
),

query_vecs AS (
    SELECT  PARSE_JSON(gv."vector") AS vec_arr,
            wf."frequency"::FLOAT   AS corpus_freq,
            qtc.tok_cnt::FLOAT      AS tok_cnt
    FROM   query_token_counts qtc
    JOIN   WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS     gv
           ON gv."word" = qtc.token
    JOIN   WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  wf
           ON wf."word" = qtc.token
),

query_components AS (
    SELECT  f.index AS idx,
            SUM( f.value::FLOAT *
                 (qv.tok_cnt * POWER(qv.corpus_freq, -0.4)) ) AS val
    FROM   query_vecs qv,
           LATERAL FLATTEN(INPUT => qv.vec_arr) f
    GROUP BY f.index
),

query_norm AS (
    SELECT SQRT(SUM(val*val)) AS q_norm FROM query_components
),

/*======================  2)  article vectors  =========================*/
article_tokens AS (
    SELECT  n."id",
            n."date",
            n."title",
            LOWER(value)::STRING AS token
    FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
           LATERAL SPLIT_TO_TABLE(
               REGEXP_REPLACE(LOWER(n."body"), '[^a-z ]',' '), ' '
           )
    WHERE value IS NOT NULL
),

article_token_counts AS (
    SELECT  id, date, title, token, COUNT(*) AS tok_cnt
    FROM    article_tokens
    WHERE   token <> ''
      AND   token NOT IN (SELECT word FROM stopwords)
    GROUP BY id, date, title, token
),

article_vecs AS (
    SELECT  atc.id,
            atc.date,
            atc.title,
            PARSE_JSON(gv."vector") AS vec_arr,
            wf."frequency"::FLOAT   AS corpus_freq,
            atc.tok_cnt::FLOAT      AS tok_cnt
    FROM    article_token_counts atc
    JOIN    WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    gv
             ON gv."word" = atc.token
    JOIN    WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
             ON wf."word" = atc.token
),

article_components AS (
    SELECT  av.id,
            av.date,
            av.title,
            f.index AS idx,
            SUM( f.value::FLOAT *
                 (av.tok_cnt * POWER(av.corpus_freq, -0.4)) ) AS val
    FROM   article_vecs av,
           LATERAL FLATTEN(INPUT => av.vec_arr) f
    GROUP BY av.id, av.date, av.title, f.index
),

article_norms AS (
    SELECT id, SQRT(SUM(val*val)) AS d_norm
    FROM   article_components
    GROUP BY id
),

/*================= 3)  dot-product & cosine similarity  ===============*/
dot_products AS (
    SELECT  ac.id,
            ac.date,
            ac.title,
            SUM(ac.val * qc.val) AS dot_val
    FROM   article_components ac
    JOIN   query_components   qc  ON qc.idx = ac.idx
    GROUP BY ac.id, ac.date, ac.title
),

similarities AS (
    SELECT  dp.id,
            dp.date,
            dp.title,
            dp.dot_val / (an.d_norm * qn.q_norm) AS cosine_sim
    FROM    dot_products dp
    JOIN    article_norms an  ON an.id = dp.id
    CROSS   JOIN query_norm qn
    WHERE   an.d_norm > 0
)

/*======================== 4)  final result  ===========================*/
SELECT  id,
        date,
        title,
        cosine_sim
FROM    similarities
ORDER BY cosine_sim DESC NULLS LAST
LIMIT 10;
