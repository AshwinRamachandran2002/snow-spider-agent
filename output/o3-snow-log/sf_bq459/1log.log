WITH
/* ----------------------------  stop-words  ---------------------------- */
stopwords AS (
    SELECT column1 AS word
    FROM ( VALUES
        ('the'),('a'),('an'),('and'),('or'),('in'),('of'),('to'),
        ('is'),('are'),('was'),('were'),('be'),('been'),('this'),
        ('that'),('these'),('those'),('for'),('on'),('with'),('as'),
        ('by'),('at'),('from'),('which'),('also'),('it'),('its'),
        ('can'),('may'),('not'),('but'),('we'),('our'),('they'),
        ('their'),('than'),('other'),('such'),('have'),('has'),
        ('had'),('more'),('most'),('some'),('into'),('using'),('use')
    ) v(column1)
),

/* ------------------- 1)   prepare the query vector ------------------- */
query_tokens AS (      -- tokenise + stop-word removal
    SELECT token
    FROM (
        SELECT LOWER(value)::STRING AS token
        FROM TABLE(
            SPLIT_TO_TABLE(
                REGEXP_REPLACE(
                    LOWER('Epigenetics and cerebral organoids: promising directions in autism spectrum disorders'),
                    '[^a-z ]',' '
                ),
                ' '
            )
        )
    )
    WHERE token <> ''
      AND token NOT IN (SELECT word FROM stopwords)
),

query_vecs AS (        -- fetch GloVe vectors & frequencies
    SELECT PARSE_JSON(gv."vector")  AS vec_arr,
           wf."frequency"::FLOAT    AS freq
    FROM  query_tokens qt
    JOIN  WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS      gv
           ON gv."word" = qt.token
    JOIN  WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES   wf
           ON wf."word" = qt.token
),

query_components AS (  -- Σ weighted vectors (per dimension)
    SELECT  f.index AS idx,
            SUM(f.value::FLOAT * POWER(qv.freq, -0.4)) AS val
    FROM    query_vecs qv,
            LATERAL FLATTEN(input => qv.vec_arr) f
    GROUP BY f.index
),

query_norm AS (        -- ‖q‖
    SELECT SQRT(SUM(val*val)) AS q_norm
    FROM   query_components
),

/* ---------------- 2)   prepare vectors for all articles -------------- */
article_tokens AS (    -- tokenise each article body
    SELECT  n."id",
            n."date",
            n."title",
            LOWER(value)::STRING AS token
    FROM    WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
            LATERAL SPLIT_TO_TABLE(
                     REGEXP_REPLACE(LOWER(n."body"), '[^a-z ]',' '),
                     ' '
                   )
),

article_tokens_filtered AS (
    SELECT *
    FROM   article_tokens
    WHERE  token <> ''
      AND  token NOT IN (SELECT word FROM stopwords)
),

article_vecs AS (      -- bring in vectors & frequencies
    SELECT  at."id",
            at."date",
            at."title",
            PARSE_JSON(gv."vector") AS vec_arr,
            wf."frequency"::FLOAT   AS freq
    FROM    article_tokens_filtered at
    JOIN    WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    gv
             ON gv."word" = at.token
    JOIN    WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
             ON wf."word" = at.token
),

article_components AS ( -- Σ weighted vectors per article & dimension
    SELECT  av."id",
            av."date",
            av."title",
            f.index AS idx,
            SUM(f.value::FLOAT * POWER(av.freq, -0.4)) AS val
    FROM    article_vecs av,
            LATERAL FLATTEN(input => av.vec_arr) f
    GROUP BY av."id", av."date", av."title", f.index
),

article_norms AS (     -- ‖d‖ per article
    SELECT  "id",
            SQRT(SUM(val*val)) AS d_norm
    FROM    article_components
    GROUP BY "id"
),

/* ------------------- 3)   dot products & cosine --------------------- */
dot_products AS (
    SELECT  ac."id",
            ac."date",
            ac."title",
            SUM(ac.val * qc.val) AS dot_val
    FROM    article_components ac
    JOIN    query_components   qc ON qc.idx = ac.idx
    GROUP BY ac."id", ac."date", ac."title"
),

similarities AS (
    SELECT  dp."id",
            dp."date",
            dp."title",
            dp.dot_val / (an.d_norm * qn.q_norm) AS cosine_sim
    FROM    dot_products dp
    JOIN    article_norms an ON an."id" = dp."id"
    CROSS  JOIN query_norm  qn
    WHERE   an.d_norm > 0
)

/* ------------------- 4)   top-10 most similar ----------------------- */
SELECT  "id",
        "date",
        "title",
        cosine_sim
FROM    similarities
ORDER BY cosine_sim DESC NULLS LAST
LIMIT 10;
