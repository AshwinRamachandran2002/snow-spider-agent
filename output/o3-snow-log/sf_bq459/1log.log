WITH
/* ------------------------------------------------------------------
   very small stop-word list – extend if desired
-------------------------------------------------------------------*/
stopwords(word) AS (
    VALUES  ('the'),('a'),('an'),('and'),('or'),('in'),('of'),('to'),
            ('is'),('are'),('was'),('were'),('be'),('been'),('this'),
            ('that'),('these'),('those'),('for'),('on'),('with'),('as'),
            ('by'),('at'),('from'),('which'),('also'),('it'),('its'),
            ('can'),('may'),('not'),('but'),('we'),('our'),('they'),
            ('their'),('than'),('other'),('such'),('have'),('has'),
            ('had'),('more'),('most'),('some'),('into'),('using'),('use')
),

/* ------------------------------------------------------------------
   1)   TOKENISE THE QUERY, DROP STOP-WORDS, GET WORD-VECTORS & FREQ
-------------------------------------------------------------------*/
query_tokens AS (
    SELECT  LOWER(tok.VALUE)::STRING          AS token
    FROM    TABLE(
               SPLIT_TO_TABLE(
                   REGEXP_REPLACE(
                       LOWER(
'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders'
                       ),
                       '[^a-z ]',' '
                   ),
                   ' '
               )
            ) tok
    WHERE   token <> ''
      AND  NOT EXISTS (SELECT 1 FROM stopwords s WHERE s.word = token)
),

query_vecs AS (
    SELECT  PARSE_JSON(gv."vector")           AS vec_arr,
            wf."frequency"                    AS freq
    FROM    query_tokens qt
    JOIN    WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
                 ON gv."word" = qt.token
    JOIN    WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
                 ON wf."word" = qt.token
),

query_components AS (      -- weighted, summed per dimension
    SELECT  f."index"                              AS idx,
            SUM( (f.VALUE::FLOAT)
                 * POWER(qv.freq, -0.4) )          AS val
    FROM    query_vecs        qv,
            LATERAL FLATTEN(INPUT => qv.vec_arr) f
    GROUP BY idx
),

query_norm AS (            -- ||q||
    SELECT SQRT(SUM(val*val)) AS q_norm
    FROM   query_components
),

/* ------------------------------------------------------------------
   2)   TOKENISE EVERY NATURE ARTICLE BODY (NO STOP-WORDS)
-------------------------------------------------------------------*/
article_tokens AS (
    SELECT  n."id",
            n."date",
            n."title",
            LOWER(tok.VALUE)::STRING           AS token
    FROM    WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
            LATERAL SPLIT_TO_TABLE(
                       REGEXP_REPLACE(LOWER(n."body"), '[^a-z ]',' '),
                       ' '
                   ) tok
    WHERE   token <> ''
      AND  NOT EXISTS (SELECT 1 FROM stopwords s WHERE s.word = token)
),

article_word_vecs AS (
    SELECT  at."id",
            at."date",
            at."title",
            PARSE_JSON(gv."vector")            AS vec_arr,
            wf."frequency"                     AS freq
    FROM    article_tokens at
    JOIN    WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
                 ON gv."word" = at.token
    JOIN    WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
                 ON wf."word" = at.token
),

article_components AS (    -- weighted, summed per dimension per article
    SELECT  awv."id",
            awv."date",
            awv."title",
            f."index"                          AS idx,
            SUM( (f.VALUE::FLOAT)
                 * POWER(awv.freq, -0.4) )     AS val
    FROM    article_word_vecs awv,
            LATERAL FLATTEN(INPUT => awv.vec_arr) f
    GROUP BY awv."id", awv."date", awv."title", idx
),

article_norms AS (         -- ||d||
    SELECT  "id",
            SQRT(SUM(val*val)) AS d_norm
    FROM    article_components
    GROUP BY "id"
),

/* ------------------------------------------------------------------
   3)   DOT-PRODUCT  Σ (d_i  ·  q_i)
-------------------------------------------------------------------*/
dot_products AS (
    SELECT  ac."id",
            ac."date",
            ac."title",
            SUM( ac.val * qc.val )             AS dot_val
    FROM    article_components ac
    JOIN    query_components   qc   ON qc.idx = ac.idx
    GROUP BY ac."id", ac."date", ac."title"
),

/* ------------------------------------------------------------------
   4)   COSINE SIMILARITY
-------------------------------------------------------------------*/
similarities AS (
    SELECT  dp."id",
            dp."date",
            dp."title",
            dp.dot_val / (an.d_norm * qn.q_norm)   AS cosine_sim
    FROM    dot_products  dp
    JOIN    article_norms an  ON an."id" = dp."id"
    CROSS JOIN query_norm qn
    WHERE   an.d_norm > 0
)

/* ------------------------------------------------------------------
   5)   RETURN TOP-10 ARTICLES
-------------------------------------------------------------------*/
SELECT  "id",
        "date",
        "title",
        cosine_sim
FROM    similarities
ORDER BY cosine_sim DESC NULLS LAST
LIMIT 10;
