WHERE gv."word" IN ('epigenetics','cerebral','organoids','promising','directions','autism','spectrum','disorders');
```

```sql
--Description: Find a few candidate Nature articles that already mention “autism” in the title  
SELECT "id",
       "date",
       "title"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE LOWER("title") ILIKE '%autism%'
LIMIT 20;
```

```sql
--Description: Tokenise the body of one article (choose the first result above) to see individual words  
SELECT n."id",
       tok.value::STRING  AS "token"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE AS n,
     LATERAL SPLIT_TO_TABLE(
              REGEXP_REPLACE(LOWER(n."body"),'[^a-z ]',' '), ' '
            ) AS tok
WHERE n."id" = (SELECT "id"
                FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
                WHERE LOWER("title") ILIKE '%autism%'
                LIMIT 1)
LIMIT 20;
```

```sql
--Description: For those tokens, join to GloVe to preview how many tokens are vectorised  
SELECT tok.value::STRING        AS "token",
       gv."vector"
