    ('nor'),('not'),('only'),('own'),('same'),('so'),('than'),
    ('too'),('very'),('can'),('will'),('just'),('is'),('are'),
    ('was'),('were'),('be'),('been'),('being'),('it'),('its'),
    ('that'),('this'),('these'),('those')
),

/* ---------------------------------------------------------- */
