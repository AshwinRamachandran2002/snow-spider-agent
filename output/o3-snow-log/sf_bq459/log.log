```sql
/* -----------------------------------------------------------
   1)  Build a minimal stop-word list
----------------------------------------------------------- */
WITH stopwords(word) AS (
  SELECT column1
  FROM VALUES
    ('a'),('an'),('and'),('are'),('as'),('at'),('be'),('but'),('by'),
    ('for'),('if'),('in'),('into'),('is'),('it'),('no'),('not'),
    ('of'),('on'),('or'),('such'),('that'),('the'),('their'),('then'),
    ('there'),('these'),('they'),('this'),('to'),('was'),('will'),
    ('with'),('we'),('our'),('you'),('your'),('were'),('has'),('have'),
    ('had'),('which')
),

/* -----------------------------------------------------------
   2)  TOKENISE, WEIGHT AND NORMALISE THE QUERY
----------------------------------------------------------- */
query_tokens AS (
  SELECT LOWER(REGEXP_REPLACE(value,'[^a-z]+','')) AS token
  FROM TABLE(
        SPLIT_TO_TABLE(
            'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
            ' '))
  WHERE token <> ''
),  
query_filtered AS (
  SELECT qt.token
  FROM query_tokens qt
  LEFT JOIN stopwords s ON qt.token = s.word
  WHERE s.word IS NULL
),  
query_vectors AS (
  SELECT
      gv.word,
      gv.vector,
      wf.frequency,
      1 / POWER(wf.frequency,0.4)        AS weight
  FROM query_filtered            q
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    gv ON gv.word = q.token
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf ON wf.word = q.token
),  
query_weighted AS (
  -- explode every GloVe vector into <dimension , value*weight>
  SELECT
      f.index                                                    AS dim,
      (f.value::FLOAT * qv.weight)                               AS weighted_value
  FROM query_vectors qv ,
       LATERAL FLATTEN(INPUT => qv.vector) f
),  
query_sum AS (
  SELECT dim , SUM(weighted_value) AS comp_sum
  FROM query_weighted
  GROUP BY dim
),  
query_norm AS (                  --   ||q||
  SELECT SQRT(SUM(comp_sum*comp_sum)) AS norm
  FROM   query_sum
),  
query_unit AS (                  --   q / ||q||
  SELECT dim , comp_sum / qn.norm AS component_unit
  FROM   query_sum , query_norm qn
),

/* -----------------------------------------------------------
   3)  TOKENISE EVERY ARTICLE, WEIGHT & NORMALISE AS ABOVE
----------------------------------------------------------- */
article_tokens AS (
  SELECT
      n."id",
      n."date",
      n."title",
      LOWER(REGEXP_REPLACE(tok.value,'[^a-z]+','')) AS token
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n ,
       LATERAL SPLIT_TO_TABLE(n."body",' ') tok
  WHERE tok.value <> ''
),
article_filtered AS (
  SELECT at.*
  FROM   article_tokens at
  LEFT   JOIN stopwords s ON at.token = s.word
  WHERE  s.word IS NULL
),
article_vectors AS (
  SELECT
      af."id",
      af."date",
      af."title",
      gv.vector,
      wf.frequency,
      1 / POWER(wf.frequency,0.4)                    AS weight
  FROM article_filtered                              af
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv ON gv.word = af.token
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf ON wf.word = af.token
),
article_weighted AS (
  SELECT
      av."id",
      av."date",
      av."title",
      f.index                                         AS dim,
      (f.value::FLOAT * av.weight)                    AS weighted_value
  FROM article_vectors av ,
       LATERAL FLATTEN(INPUT => av.vector) f
),
article_sum AS (
  SELECT
      "id",
      "date",
      "title",
      dim,
      SUM(weighted_value)                             AS comp_sum
  FROM article_weighted
  GROUP BY "id","date","title",dim
),
article_norm AS (         --   ||d_i||
  SELECT "id",
         SQRT(SUM(comp_sum*comp_sum))                 AS norm
  FROM   article_sum
  GROUP BY "id"
),
article_unit AS (         --   d_i / ||d_i||
  SELECT
      a."id",
      a."date",
      a."title",
      a.dim,
      a.comp_sum / an.norm                            AS component_unit
  FROM   article_sum a
  JOIN   article_norm an ON an."id" = a."id"
),

/* -----------------------------------------------------------
   4)  COSINE SIMILARITY  =  dot( q̂ , d̂ )
----------------------------------------------------------- */
cosine AS (
  SELECT
      au."id",
      au."date",
      au."title",
      SUM(au.component_unit * qu.component_unit)      AS similarity
  FROM   article_unit  au
  JOIN   query_unit    qu  ON qu.dim = au.dim
  GROUP  BY au."id", au."date", au."title"
)

/* -----------------------------------------------------------
   5)  TOP-10 MOST SIMILAR ARTICLES
----------------------------------------------------------- */
SELECT
    "id",
    "date",
    "title",
    similarity
FROM   cosine
ORDER  BY similarity DESC NULLS LAST
LIMIT 10;
