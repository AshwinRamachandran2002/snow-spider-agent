WITH
-- ------------------------------------------------------------------
-- 1) A very small stop-word list (can be extended as desired)
-- ------------------------------------------------------------------
stopwords(word) AS (
    SELECT column1 FROM VALUES
    ('a'),('an'),('the'),('and'),('or'),('for'),('to'),('of'),('in'),
    ('on'),('with'),('is'),('are'),('was'),('were'),('be'),('been'),
    ('being'),('by'),('at'),('from'),('as'),('that'),('this'),('these'),
    ('those'),('it'),('its'),('we'),('our'),('you'),('your'),('they'),
    ('their'),('them'),('he'),('she'),('him'),('her'),('his'),('hers'),
    ('i'),('me'),('my'),('mine')
),
-- ------------------------------------------------------------------
-- 2) Tokenise every article body, strip punctuation, lower-case,
--    remove stop-words, keep non-empty tokens
-- ------------------------------------------------------------------
article_tokens AS (
    SELECT
        n."id",
        n."date",
        n."title",
        TRIM(tok.VALUE::string)        AS token
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                         LOWER(
                             REGEXP_REPLACE(n."body", '[^a-z0-9 ]', ' ')
                         ),
                         ' '
                     )
         ) tok
    WHERE tok.VALUE IS NOT NULL
      AND TRIM(tok.VALUE::string) <> ''
      AND TRIM(tok.VALUE::string) NOT IN (SELECT word FROM stopwords)
),
-- ------------------------------------------------------------------
-- 3) Attach GloVe vector, word frequency and weight = freq^-0.4
-- ------------------------------------------------------------------
token_info AS (
    SELECT
        at."id",
        at."date",
        at."title",
        gv."vector"                         AS vector,
        wf."frequency"                      AS freq,
        1 / POWER(wf."frequency", 0.4)      AS weight
    FROM article_tokens  at
    INNER JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS      gv
               ON gv."word" = at.token
    INNER JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES   wf
               ON wf."word" = at.token
),
-- ------------------------------------------------------------------
-- 4) Multiply each vector element by its weight and sum per dimension
-- ------------------------------------------------------------------
article_dim_sums AS (
    SELECT
        ti."id",
        ti."date",
        ti."title",
        vec.index                         AS dim,
        SUM(vec.value * ti.weight)        AS dim_val
    FROM token_info ti,
         LATERAL FLATTEN(INPUT => ti.vector) vec
    GROUP BY ti."id", ti."date", ti."title", vec.index
),
-- ------------------------------------------------------------------
-- 5) Compute L2 norm per article, then normalise to unit vector
-- ------------------------------------------------------------------
article_norms AS (
    SELECT
        "id",
        SQRT(SUM(dim_val * dim_val)) AS norm
    FROM article_dim_sums
    GROUP BY "id"
),
article_unit AS (
    SELECT
        ads."id",
        ads."date",
        ads."title",
        ads.dim,
        ads.dim_val / an.norm            AS value          -- unit-length
    FROM article_dim_sums ads
    JOIN article_norms  an  ON an."id" = ads."id"
),
-- ------------------------------------------------------------------
-- 6) Build the weighted, unit-length vector for the query sentence
-- ------------------------------------------------------------------
query_tokens AS (
    SELECT
        TRIM(tok.VALUE::string) AS token
    FROM (SELECT
            LOWER(
              REGEXP_REPLACE(
                'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                '[^a-z0-9 ]',
                ' '
              )
            ) AS qtxt) q,
         LATERAL FLATTEN(INPUT => SPLIT(q.qtxt,' ')) tok
    WHERE tok.VALUE IS NOT NULL
      AND TRIM(tok.VALUE::string) <> ''
      AND TRIM(tok.VALUE::string) NOT IN (SELECT word FROM stopwords)
),
query_info AS (
    SELECT
        gv."vector"                       AS vector,
        1/POWER(wf."frequency",0.4)       AS weight
    FROM query_tokens qt
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS     gv
         ON gv."word" = qt.token
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  wf
         ON wf."word" = qt.token
),
query_dim_sums AS (
    SELECT
        vec.index        AS dim,
        SUM(vec.value * qi.weight)  AS dim_val
    FROM query_info qi,
         LATERAL FLATTEN(INPUT => qi.vector) vec
    GROUP BY vec.index
),
query_norm AS (
    SELECT SQRT(SUM(dim_val*dim_val)) AS norm FROM query_dim_sums
),
query_unit AS (
    SELECT
        qds.dim,
        qds.dim_val / qn.norm        AS value
    FROM query_dim_sums qds, query_norm qn
),
-- ------------------------------------------------------------------
-- 7) Cosine similarity = dot product of two unit vectors
-- ------------------------------------------------------------------
cosine_sim AS (
    SELECT
        au."id",
        au."date",
        au."title",
        SUM(au.value * qu.value)     AS similarity
    FROM article_unit au
    JOIN query_unit  qu
      ON au.dim = qu.dim
    GROUP BY au."id", au."date", au."title"
)
-- ------------------------------------------------------------------
-- 8) Return the 10 most similar articles
-- ------------------------------------------------------------------
SELECT
    "id",
    "date",
    "title",
    similarity
FROM cosine_sim
ORDER BY similarity DESC NULLS LAST
LIMIT 10;
```
