/* ------------------------------------------------------------------
   Top-10 Nature articles most similar to the query
   “Epigenetics and cerebral organoids: promising directions in
    autism spectrum disorders”                       (cosine metric)
-------------------------------------------------------------------*/
WITH
/* -------- simple stop-word list ---------------------------------*/
stopwords(word) AS (
    SELECT column1 FROM VALUES
        ('the'),('and'),('a'),('an'),('of'),('to'),('in'),('is'),
        ('it'),('that'),('for'),('on'),('with'),('as'),('by'),
        ('this'),('are'),('at'),('or'),('be'),('from'),('was'),
        ('were'),('which'),('but'),('not'),('have'),('has'),('had'),
        ('into'),('such'),('its'),('their'),('them'),('they'),
        ('these'),('those'),('than'),('then'),('about')
),

/* ----------- build QUERY unit vector ----------------------------*/
query_words AS (
    SELECT  LOWER(TRIM(w.value))        AS word
    FROM    ( SELECT REGEXP_REPLACE(
                        LOWER(
  'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders'
                        ),
                        '[^a-z0-9 ]', ' '
                      ) AS phrase ) q,
            LATERAL SPLIT_TO_TABLE(q.phrase,' ') w
    WHERE   TRIM(w.value) <> ''
      AND   LOWER(w.value) NOT IN (SELECT word FROM stopwords)
),
query_dim_sums AS (
    SELECT  gv.seq                                                  AS seq,
            SUM( gv.value::FLOAT / POWER(f.frequency,0.4) )         AS val
    FROM   query_words qw
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
             ON f.word = qw.word
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  g
             ON g.word = qw.word,
           LATERAL FLATTEN( INPUT => g.vector ) gv
    GROUP  BY gv.seq
),
query_len AS (
    SELECT SQRT( SUM( val*val ) ) AS len FROM query_dim_sums
),
query_unit AS (
    SELECT seq,
           val / (SELECT len FROM query_len) AS val
    FROM   query_dim_sums
),

/* -------------- tokenise every Nature article -------------------*/
article_tokens AS (
    SELECT  n."id",
            n."date",
            n."title",
            LOWER(TRIM(w.value))                         AS word
    FROM    WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
            LATERAL SPLIT_TO_TABLE(
                       REGEXP_REPLACE( LOWER(n."body"), '[^a-z0-9 ]',' ')
                       ,' '
                   ) w
    WHERE   TRIM(w.value) <> ''
      AND   LOWER(w.value) NOT IN (SELECT word FROM stopwords)
),

/* -------------- weighted vector sum per article -----------------*/
article_dim_sums AS (
    SELECT  at.id,
            at.date,
            at.title,
            gv.seq                                             AS seq,
            SUM( gv.value::FLOAT / POWER(f.frequency,0.4) )    AS val
    FROM   article_tokens at
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
             ON f.word = at.word
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  g
             ON g.word = at.word,
           LATERAL FLATTEN( INPUT => g.vector ) gv
    GROUP  BY at.id, at.date, at.title, gv.seq
),

/* -------------- article vector lengths --------------------------*/
article_len AS (
    SELECT  id,
            SQRT( SUM( val*val ) )         AS len
    FROM    article_dim_sums
    GROUP  BY id
),

/* -------------- unit vector for each article --------------------*/
article_unit AS (
    SELECT  ads.id,
            ads.date,
            ads.title,
            ads.seq,
            ads.val / al.len               AS val
    FROM    article_dim_sums ads
            JOIN article_len al
              ON al.id = ads.id
    WHERE   al.len > 0
),

/* -------------- cosine similarity -------------------------------*/
article_similarity AS (
    SELECT  au.id,
            au.date,
            au.title,
            SUM( au.val * qu.val )          AS cosine_similarity
    FROM    article_unit au
            JOIN query_unit qu
              ON qu.seq = au.seq
    GROUP  BY au.id, au.date, au.title
)

/* -------------- top-10 results ----------------------------------*/
SELECT  id,
        date,
        title,
        cosine_similarity
FROM    article_similarity
ORDER BY cosine_similarity DESC NULLS LAST
LIMIT 10;
```
