),
query_len AS (
    SELECT SQRT(SUM(val*val)) AS len FROM query_dim_sums
),
query_unit AS (
    SELECT seq,
           val / (SELECT len FROM query_len) AS val
    FROM   query_dim_sums
),

/* ------------------- candidate articles -----------------------*/
candidates AS (
    SELECT "id","date","title","body"
    FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE
    WHERE  "body" ILIKE '%epigenet%'
        OR "body" ILIKE '%organoid%'
        OR "body" ILIKE '%cerebral%'
        OR "body" ILIKE '%autism%'
        OR "body" ILIKE '%spectrum%'
),

/* ---------------- tokenise candidate articles -----------------*/
article_word_counts AS (
    SELECT c."id"    AS id,
           c."date"  AS date,
           c."title" AS title,
           LOWER(TRIM(tok.value)) AS word,
           COUNT(*)               AS cnt
    FROM   candidates c,
           LATERAL SPLIT_TO_TABLE(
               REGEXP_REPLACE(LOWER(c."body"), '[^a-z0-9 ]',' ')
               ,' '
           ) tok
    WHERE  TRIM(tok.value) <> ''
      AND  LOWER(tok.value) NOT IN (SELECT word FROM stopwords)
    GROUP  BY c."id", c."date", c."title", LOWER(TRIM(tok.value))
),

/* ------------- weighted vector sums for each article ----------*/
article_dim_sums AS (
    SELECT awc.id,
           awc.date,
           awc.title,
           gv.seq,
           SUM( awc.cnt * gv.value::FLOAT
                / POWER(freq."frequency",0.4) ) AS val
    FROM   article_word_counts awc
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES freq
             ON freq."word" = awc.word
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS glove
             ON glove."word" = awc.word,
           LATERAL FLATTEN(INPUT => glove."vector") gv
    GROUP  BY awc.id, awc.date, awc.title, gv.seq
),

/* ---------------- compute article vector lengths --------------*/
article_len AS (
    SELECT id,
           SQRT(SUM(val*val)) AS len
    FROM   article_dim_sums
    GROUP  BY id
),

/* --------------------- unit vectors per article ---------------*/
article_unit AS (
    SELECT ads.id,
           ads.date,
           ads.title,
           ads.seq,
           ads.val / al.len AS val
    FROM   article_dim_sums ads
           JOIN article_len al ON al.id = ads.id
    WHERE  al.len > 0
),

/* -------------------- cosine similarity -----------------------*/
article_similarity AS (
    SELECT au.id,
           au.date,
           au.title,
           SUM( au.val * qu.val ) AS cosine_similarity
    FROM   article_unit au
           JOIN query_unit qu ON qu.seq = au.seq
    GROUP  BY au.id, au.date, au.title
)

/* ----------------------- final top-10 -------------------------*/
SELECT id,
       date,
       title,
       cosine_similarity
FROM   article_similarity
ORDER  BY cosine_similarity DESC NULLS LAST
LIMIT 10;
