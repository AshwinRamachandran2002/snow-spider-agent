```sql
-- 1) Pick, within every study–gene combination, the variant that has the
--    minimum p-value.
-- 2) From those best variants, keep only the single most‐significant
--    variant per gene across all studies.
-- 3) Rank by p-value and return the 10 genes with the strongest evidence.

WITH per_study_gene AS (
    SELECT
        "study_id",
        "gene_id",
        "tag_chrom",
        "tag_pos",
        "pval",
        ROW_NUMBER() OVER (
            PARTITION BY "study_id", "gene_id"
            ORDER BY "pval" ASC
        ) AS rn_study_gene
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
),
best_per_gene AS (
    SELECT
        "study_id",
        "gene_id",
        "tag_chrom",
        "tag_pos",
        "pval",
        ROW_NUMBER() OVER (
            PARTITION BY "gene_id"
            ORDER BY "pval" ASC
        ) AS rn_gene
    FROM per_study_gene
    WHERE rn_study_gene = 1          -- best variant for each study–gene pair
)
SELECT
    "gene_id",
    "study_id",
    "tag_chrom",
    "tag_pos",
    "pval"
FROM best_per_gene
WHERE rn_gene = 1                    -- single best variant per gene overall
ORDER BY "pval" ASC
LIMIT 10;
```
