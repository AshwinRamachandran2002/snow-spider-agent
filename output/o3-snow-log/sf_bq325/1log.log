--Description & Thinking process:
-- Goal: For each (study_id, gene_id) pair, keep only the variant with the
--       smallest p-value.  The prior ROW_NUMBER approach sorted the whole
--       table and timed out.  Instead we use Snowflake’s MIN_BY function,
--       which, during aggregation, yields the column value associated with
--       the minimum (or maximum) of another column.
-- Strategy:
--   1. Filter rows where "pval" is NOT NULL.
--   2. GROUP BY study and gene.
--   3. Compute
--        • MIN("pval")                       → the lowest p-value itself
--        • MIN_BY("tag_chrom", "pval")       → chromosome of that min-p variant
--        • MIN_BY("tag_pos",  "pval")        → position   of that variant
--   4. LIMIT 20 just to preview the result quickly.
SELECT
    "study_id",
    "gene_id",
    MIN_BY("tag_chrom", "pval") AS "tag_chrom",
    MIN_BY("tag_pos",  "pval") AS "tag_pos",
    MIN("pval")                AS "pval"
FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
WHERE "pval" IS NOT NULL
GROUP BY "study_id", "gene_id"
LIMIT 20;
