/*  Find the ten genes with the strongest overall evidence
    -------------------------------------------------------
    1.  For every (study_id, gene_id) pair, locate the lowest p-value.
    2.  Keep the corresponding variant(s) that achieve that minimum.
    3.  From those, pick the single most-significant variant per gene.
    4.  Return the ten genes with the smallest p-values overall.
*/

WITH min_p_per_study_gene AS (          -- step 1
    SELECT
        "study_id",
        "gene_id",
        MIN("pval") AS "min_pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
    GROUP BY
        "study_id",
        "gene_id"
),

best_variant_per_study_gene AS (        -- step 2
    SELECT
        dvg."study_id",
        dvg."gene_id",
        dvg."tag_chrom",
        dvg."tag_pos",
        dvg."pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE" dvg
    INNER JOIN min_p_per_study_gene mp
           ON dvg."study_id" = mp."study_id"
          AND dvg."gene_id"  = mp."gene_id"
          AND dvg."pval"     = mp."min_pval"
),

best_per_gene AS (                      -- step 3
    SELECT
        bv.*,
        ROW_NUMBER() OVER (
            PARTITION BY bv."gene_id"
            ORDER BY bv."pval" ASC
        ) AS rn_gene
    FROM best_variant_per_study_gene bv
)

SELECT                                  -- step 4
    "gene_id",
    "study_id",
    "tag_chrom",
    "tag_pos",
    "pval"
FROM best_per_gene
WHERE rn_gene = 1
ORDER BY "pval" ASC
LIMIT 10;
```
