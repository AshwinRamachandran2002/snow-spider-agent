```sql
--Description & Thinking process:
-- Goal: inspect the distribution of p-values in DISEASE_VARIANT_GENE.
-- 1. We need a base-10 logarithm of each p-value → Snowflake lacks LOG10(), but LOG(b, x) returns log-base-b.  So use LOG(10, "pval").
-- 2. Bucket those logs into integer bins: ROUND(LOG(10, "pval")).  A bin of –8 means p ≈ 10⁻⁸, –9 means p ≈ 10⁻⁹, etc.
-- 3. For every bin, count how many variants fall there.
-- 4. Order bins ascending (from least to most significant) and show first 20 for a quick view.
SELECT
    ROUND(LOG(10, "pval")) AS "log10_bin",
    COUNT(*)               AS "n_variants"
FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
WHERE "pval" IS NOT NULL
GROUP BY ROUND(LOG(10, "pval"))
ORDER BY "log10_bin"
LIMIT 20;
