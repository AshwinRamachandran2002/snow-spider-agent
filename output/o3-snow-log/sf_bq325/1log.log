```sql
--Description & Thinking process:
-- We need, for every (study_id, gene_id), the variant with the smallest p-value.
-- Snowflake’s aggregate MIN_BY(value, order_by) returns the value associated with
-- the minimum of another column, letting us avoid a costly self-join or window.
--  • MIN("pval") gives the minimum p-value per pair.
--  • MIN_BY("tag_chrom", "pval") returns the chromosome of that minimum p-value.
--  • MIN_BY("tag_pos",  "pval") returns its position.
-- This single GROUP BY therefore yields one record per study–gene pair.
-- We LIMIT 20 rows just to sample the result quickly.
SELECT
    "study_id",
    "gene_id",
    MIN_BY("tag_chrom", "pval") AS "tag_chrom",
    MIN_BY("tag_pos",  "pval") AS "tag_pos",
    MIN("pval")                 AS "pval"
FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
WHERE "pval" IS NOT NULL
GROUP BY "study_id", "gene_id"
LIMIT 20;
```
