--Description & Thinking process:
-- Objective: deliver the 10 genes whose best (lowest-p) variant, taken within each study,
-- has the smallest p-value overall.
-- Steps executed in a single aggregation scan:
--   1. GROUP BY ("study_id", "gene_id") so each pair collapses to its single most
--      significant variant.
--   2. Use MIN("pval") to obtain that minimum p-value.
--   3. Use MIN_BY("tag_chrom", "pval") and MIN_BY("tag_pos", "pval") to capture
--      the chromosome and position of the same lowest-p variant.
--   4. After this GROUP BY result is formed, ORDER BY the minimum p-value and pick
--      the top 10 entries.
SELECT
    "gene_id",
    "study_id",
    MIN_BY("tag_chrom", "pval") AS "tag_chrom",
    MIN_BY("tag_pos",  "pval") AS "tag_pos",
    MIN("pval")                AS "pval"
FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
WHERE "pval" IS NOT NULL
GROUP BY "study_id", "gene_id"
ORDER BY "pval"
LIMIT 10;
```
