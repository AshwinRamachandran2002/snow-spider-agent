/*  Top-10 genes with the strongest evidence (smallest p-values)
    ------------------------------------------------------------
    1)  Within every (study_id, gene_id) partition keep the single
        variant with the minimal p-value         →  rn1 = 1
    2)  From those “best per study” variants keep, for each gene,
        the overall most-significant one         →  rn2 = 1
    3)  Return the ten smallest p-values.
*/

WITH best_per_study_gene AS (           -- step 1
    SELECT
        "gene_id",
        "study_id",
        "tag_chrom",
        "tag_pos",
        "pval",
        ROW_NUMBER() OVER (
            PARTITION BY "study_id", "gene_id"
            ORDER BY "pval" ASC
        ) AS rn1
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS."DISEASE_VARIANT_GENE"
    WHERE "pval" IS NOT NULL
    QUALIFY rn1 = 1                     -- keep only the minimum-p variant
),

best_per_gene AS (                      -- step 2
    SELECT
        *,
        ROW_NUMBER() OVER (
            PARTITION BY "gene_id"
            ORDER BY "pval" ASC
        ) AS rn2
    FROM best_per_study_gene
    QUALIFY rn2 = 1                     -- keep overall best per gene
)

SELECT                                  -- step 3
    "gene_id",
    "study_id",
    "tag_chrom",
    "tag_pos",
    "pval"
FROM best_per_gene
ORDER BY "pval" ASC
LIMIT 10;
