/*--------------------------------------------------------------------
  Pearson correlation (two-tailed p-value) between chromosome-level
  copy-number aberration frequencies obtained from Mitelman segments
  (CYTOCONVERTED) and Mitelman recurrent-numerical summaries
  (RECURRENTNUMDATA) for breast-cancer cases
       – morphology 3111, topography 0401.
  (RECURRENTNUMDATA is used here as the external comparison set.)
--------------------------------------------------------------------*/
WITH
/*--------------------------------------------------
  1)  Segment-based counts per chromosome (Gain / Loss)
      from CYTOCONVERTED  frequencies.
--------------------------------------------------*/
seg_cnt AS (                              
    SELECT
        REPLACE(LOWER(c."Chr"), 'chr', '')                AS chrom_num,  -- e.g. '1','2',…,'x'
        CASE WHEN c."Type" = 'Gain' THEN 'Gain' ELSE 'Loss' END
                                                          AS aberr_type,
        COUNT(*)                                          AS seg_count
    FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  c
    JOIN   "MITELMAN"."PROD"."CYTOGEN"        g
           ON c."RefNo" = g."RefNo"
    WHERE  g."Morph" = '3111'
      AND  g."Topo"  = '0401'
    GROUP  BY chrom_num, aberr_type
),
seg_freq AS (
    SELECT
        chrom_num,
        aberr_type,
        seg_count / SUM(seg_count) OVER (PARTITION BY aberr_type)   AS mitelman_freq
    FROM seg_cnt
),
/*--------------------------------------------------
  2)  Recurrent-numerical aberration counts per chromosome
      (same cohort)  frequencies.
--------------------------------------------------*/
rec_cnt AS (
    SELECT
        LOWER("Chromosome")                                AS chrom_num,
        CASE WHEN "Abnormality" LIKE '+%' THEN 'Gain'
             ELSE                                           'Loss'
        END                                                AS aberr_type,
        TRY_TO_NUMBER("TotalCases")                        AS case_count
    FROM   "MITELMAN"."PROD"."RECURRENTNUMDATA"
    WHERE  "Morph" = '3111'
      AND  "Topo"  = '0401'
),
rec_freq AS (
    SELECT
        chrom_num,
        aberr_type,
        case_count / SUM(case_count) OVER (PARTITION BY aberr_type) AS recnum_freq
    FROM rec_cnt
),
/*--------------------------------------------------
  3)  Join the two frequency tables on chromosome + type.
--------------------------------------------------*/
joined AS (
    SELECT
        s.aberr_type,
        s.mitelman_freq,
        r.recnum_freq
    FROM seg_freq s
    JOIN rec_freq r
      ON s.chrom_num  = r.chrom_num
     AND s.aberr_type = r.aberr_type
),
/*--------------------------------------------------
  4)  Correlation (Pearson r) & sample size per aberration type.
--------------------------------------------------*/
corr_stats AS (
    SELECT
        aberr_type,
        CORR(mitelman_freq, recnum_freq)   AS r,
        COUNT(*)                           AS n
    FROM   joined
    GROUP  BY aberr_type
    HAVING COUNT(*) >= 5                  -- at least 5 chromosomes
)
/*--------------------------------------------------
  5)  Final report with two-tailed p-values.
--------------------------------------------------*/
SELECT
    aberr_type                      AS "aberration_type",
    ROUND(r, 4)                     AS "pearson_r",
    ROUND(
        TDIST( ABS(r) * SQRT(n - 2) / NULLIF(SQRT(1 - POWER(r, 2)), 0),
               n - 2,
               2 ), 4)              AS "p_value"
FROM   corr_stats
ORDER  BY aberr_type;
```
