        TRY_TO_NUMBER("TotalCases")                               AS case_count
    FROM   "MITELMAN"."PROD"."RECURRENTNUMDATA"
    WHERE  "Morph" = '3111'
      AND  "Topo"  = '0401'
),
rec_freq AS (
    SELECT
        chrom_num,
        aberr_type,
        case_count
        / SUM(case_count) OVER (PARTITION BY aberr_type)          AS recnum_freq
    FROM rec_cnt
),
/*--------------------------------------------------
  3)  Join frequency tables on chromosome & type.
--------------------------------------------------*/
joined AS (
    SELECT
        s.aberr_type,
        s.mitelman_freq,
        r.recnum_freq
    FROM   seg_freq s
    JOIN   rec_freq r
      ON s.chrom_num  = r.chrom_num
     AND s.aberr_type = r.aberr_type
),
/*--------------------------------------------------
  4)  Pearson r  and sample size  n  per aberration type.
--------------------------------------------------*/
corr_stats AS (
    SELECT
        aberr_type,
        CORR(mitelman_freq, recnum_freq)             AS r,
        COUNT(*)                                     AS n
    FROM   joined
    GROUP  BY aberr_type
    HAVING COUNT(*) >= 5
