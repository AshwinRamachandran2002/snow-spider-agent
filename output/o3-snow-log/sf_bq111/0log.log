--------------------------------------------------*/
rec_cnt AS (
    SELECT
        LOWER("Chromosome")                                       AS chrom_num,
        CASE WHEN "Abnormality" LIKE '+%' THEN 'Gain' ELSE 'Loss' END AS aberr_type,
        TRY_TO_NUMBER("TotalCases")                               AS case_count
    FROM   "MITELMAN"."PROD"."RECURRENTNUMDATA"
    WHERE  "Morph" = '3111'
      AND  "Topo"  = '0401'
),
rec_freq AS (
    SELECT
        chrom_num,
        aberr_type,
        case_count
        / SUM(case_count) OVER (PARTITION BY aberr_type)          AS recnum_freq
    FROM rec_cnt
),
/*--------------------------------------------------
  3)  Join frequency tables on chromosome & type.
--------------------------------------------------*/
joined AS (
    SELECT
        s.aberr_type,
        s.mitelman_freq,
        r.recnum_freq
    FROM   seg_freq s
    JOIN   rec_freq r
      ON s.chrom_num  = r.chrom_num
