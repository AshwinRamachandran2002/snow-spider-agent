```sql
--Description: 1) Inspect CYTOGEN rows that correspond to breast-carcinoma cases 
--              (morphology = 3111, topology = 0401).  Useful for collecting the 
--              set of RefNo / CaseNo keys that define the cohort of interest.
SELECT DISTINCT 
       "RefNo",
       "CaseNo",
       "InvNo",
       "Sex",
       "Age",
       "Country"
FROM   "MITELMAN"."PROD"."CYTOGEN"
WHERE  "Morph" = '3111' 
  AND  "Topo"  = '0401'
LIMIT  20;
```

```sql
--Description: 2) Check how many chromosome-level gain/loss segments (Type column)
--              are present in CYTOCONVERTED for the selected CYTOGEN RefNo values.
SELECT c."RefNo",
       c."CaseNo",
       c."InvNo",
       c."Clone"  AS "CloneNo",
       COUNT(*)   AS "SegCount"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"      c
JOIN   "MITELMAN"."PROD"."CYTOGEN"            g
  ON   c."RefNo" = g."RefNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
GROUP  BY 1,2,3,4
LIMIT  20;
```

```sql
--Description: 3) Preview the actual gain/loss segment coordinates that will be
--              tallied for correlation (showing chromosome, start-end, and type).
SELECT c."RefNo",
       c."CaseNo",
       c."Chr"        AS "Chromosome",
       c."ChrOrd",
       c."Start",
       c."End",
       c."Type"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"      c
JOIN   "MITELMAN"."PROD"."CYTOGEN"            g
  ON   c."RefNo" = g."RefNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
LIMIT  20;
```

```sql
--Description: 4) Aggregate CYTOCONVERTED by chromosome and aberration type
--              (Gain / Loss) for the breast-cancer cohort so the resulting
--              counts can later be converted to frequencies.
SELECT c."ChrOrd",
       c."Chr"          AS "Chromosome",
       c."Type",
       COUNT(*)         AS "AberrationCount"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"      c
JOIN   "MITELMAN"."PROD"."CYTOGEN"            g
  ON   c."RefNo" = g."RefNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
GROUP  BY 1,2,3
ORDER  BY 1,3
LIMIT  20;
```

```sql
--Description: 5) Look at RECURRENTNUMDATA entries that already summarise
--              chromosome-number gains/losses for the same morph/topo codes.
SELECT "Chromosome",
       "ChrOrder",
       "Abnormality",
       "TotalCases"
FROM   "MITELMAN"."PROD"."RECURRENTNUMDATA"
WHERE  "Morph" = '3111'
  AND  "Topo"  = '0401'
LIMIT  20;
```

```sql
--Description: 6) Retrieve cytoband genomic coordinates (hg38) that will be
--              needed to bin Mitelman and TCGA segments in a comparable way.
SELECT "chromosome"      AS "Chromosome",
       "cytoband_name"   AS "Cytoband",
       "hg38_start",
       "hg38_stop"
FROM   "MITELMAN"."PROD"."CYTOBANDS_HG38"
WHERE  "chromosome" ILIKE 'chr1%'
LIMIT  20;
```

```sql
--Description: 7) Examine KARYCLONE records for the cohort to verify clone counts
--              and investigate potential filters (e.g., sole vs non-sole clones).
SELECT k."RefNo",
       k."CaseNo",
       k."InvNo",
       k."CloneNo",
       k."CloneShort",
       k."Sole"
FROM   "MITELMAN"."PROD"."KARYCLONE"          k
JOIN   "MITELMAN"."PROD"."CYTOGEN"            g
  ON   k."RefNo" = g."RefNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
LIMIT  20;
```

```sql
--Description: 8) Inspect potential warnings generated during CytoConverter
--              processing for the cohort – useful for quality control.
SELECT l."RefNo",
       l."CaseNo",
       l."InvNo",
       l."Clone",
       l."Type"     AS "LogType",
       l."Message"
FROM   "MITELMAN"."PROD"."CYTOCONVERTEDLOG"   l
JOIN   "MITELMAN"."PROD"."CYTOGEN"            g
  ON   l."RefNo" = g."RefNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
LIMIT  20;
```

```sql
--Description: 9) Cross-check that breakpoints (if any) exist for this cohort,
--              which might allow subclass analyses (balanced vs unbalanced).
SELECT b."RefNo",
       b."CaseNo",
       b."InvNo",
       b."CloneNo",
       b."OrderNo",
       b."Breakpoint"
FROM   "MITELMAN"."PROD"."KARYBREAK"          b
JOIN   "MITELMAN"."PROD"."CYTOGEN"            g
  ON   b."RefNo" = g."RefNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
LIMIT  20;
```

```sql
--Description: 10) Examine MOLCLINABNORM for additional aberration annotations 
