```sql
/*--------------------------------------------------------------------
  Pearson correlation (and two–tailed p-value) between chromosome-level
  copy-number aberration frequencies observed in the Mitelman data set
  (breast-cancer cases :  MORPH = 3111 , TOPO = 0401) and those already
  computed from TCGA BRCA samples.

  Four aberration categories are considered:
        – Amplification   (high-level gain)
        – Gain            (low-level gain)
        – Loss            (low-level loss)
        – Deletion        (high-level loss)

  Only categories for which at least five chromosomes have matching
  Mitelman-vs-TCGA measurements are reported.
--------------------------------------------------------------------*/
WITH
/*--------------------------------------------------
  1. Mitelman – gain / loss counts per chromosome.
--------------------------------------------------*/
mitelman_raw AS (                              
    SELECT
        c."Chr"                                              AS "chromosome",
        CASE WHEN c."Type" = 'Gain' THEN 'Gain' ELSE 'Loss' END
                                                             AS "aberration_type",
        COUNT(*)                                             AS "cnt"
    FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  c
    JOIN   "MITELMAN"."PROD"."CYTOGEN"        g
      ON   c."RefNo" = g."RefNo"
    WHERE  g."Morph" = '3111'
      AND  g."Topo"  = '0401'
    GROUP  BY
           c."Chr",
           CASE WHEN c."Type" = 'Gain' THEN 'Gain' ELSE 'Loss' END
),
/*--------------------------------------------------
  2. Convert Mitelman counts to frequencies (per
     aberration category) so the scale matches TCGA.
--------------------------------------------------*/
mitelman_freq AS (
    SELECT
        "chromosome",
        "aberration_type",
        "cnt" / SUM("cnt") OVER (PARTITION BY "aberration_type")    AS "mitelman_freq"
    FROM   mitelman_raw
),
/*--------------------------------------------------
  3. TCGA BRCA chromosome-level frequencies.
     (Table is assumed to be pre-computed from TCGA
      copy-number calls; one row per chromosome and
      aberration category.)
--------------------------------------------------*/
tcga_raw AS (
    SELECT
        "chromosome",                -- e.g. 'chr1'
        "aberration_type",           -- 'Amplification','Gain','Loss','Deletion'
        "frequency"                  AS "tcga_freq"
    FROM   "TCGA"."PUBLIC"."BRCA_CNV_CHR_FREQUENCY"
),
/*--------------------------------------------------
  4. Normalise TCGA category names (upper/lower case)
     and keep only the four categories of interest.
--------------------------------------------------*/
tcga_freq AS (
    SELECT
        LOWER("chromosome")                          AS "chromosome",
        CASE
            WHEN LOWER("aberration_type") LIKE 'amp%' THEN 'Amplification'
            WHEN LOWER("aberration_type") =  'gain'   THEN 'Gain'
            WHEN LOWER("aberration_type") LIKE 'del%' THEN 'Deletion'
            ELSE 'Loss'
        END                                          AS "aberration_type",
        "tcga_freq"
    FROM tcga_raw
    WHERE LOWER("aberration_type") IN
          ('amplification','gain','loss','deletion')
),
/*--------------------------------------------------
  5. Join Mitelman & TCGA frequencies on chromosome
     and compatible aberration categories.
--------------------------------------------------*/
joined AS (
    SELECT
        m."chromosome",
        m."aberration_type",
        m."mitelman_freq",
        t."tcga_freq"
    FROM   mitelman_freq m
    JOIN   tcga_freq     t
      ON   LOWER(m."chromosome") = t."chromosome"
     AND (
            /* ‘Gain’ rows in Mitelman match TCGA
               ‘Gain’  or ‘Amplification’.          */
            (m."aberration_type" = 'Gain'
             AND t."aberration_type" IN ('Gain','Amplification'))
          OR
            /* ‘Loss’ rows in Mitelman match TCGA
               ‘Loss’ or ‘Deletion’.               */
            (m."aberration_type" = 'Loss'
             AND t."aberration_type" IN ('Loss','Deletion'))
         )
),
/*--------------------------------------------------
  6. Compute Pearson r  and sample size  n
     for every aberration category.
--------------------------------------------------*/
corr_per_type AS (
    SELECT
        /* Map the final category label --------------------------------*/
        CASE
            WHEN j."aberration_type" = 'Gain'
                 AND t_ab."aberration_type" = 'Amplification' THEN 'Amplification'
            WHEN j."aberration_type" = 'Gain'                 THEN 'Gain'
            WHEN j."aberration_type" = 'Loss'
                 AND t_ab."aberration_type" = 'Deletion'      THEN 'Deletion'
            ELSE                                                    'Loss'
        END                                    AS "aberration_type",
        CORR(j."mitelman_freq", j."tcga_freq") AS "r",
        COUNT(*)                               AS "n"
    FROM   joined               j
    JOIN   tcga_freq            t_ab   /* to expose TCGA category */
           ON  LOWER(j."chromosome")   = t_ab."chromosome"
          AND j."aberration_type"      = t_ab."aberration_type"
    GROUP  BY 1
    HAVING COUNT(*) >= 5
)
/*--------------------------------------------------
  7. Final select – report r  and two-tailed pvalue.
--------------------------------------------------*/
SELECT
    "aberration_type",
    ROUND("r", 4)                                        AS "pearson_r",
    ROUND(
        TDIST( ABS("r") * SQRT("n" - 2)
                   / NULLIF( SQRT(1 - POWER("r",2)), 0 ),
              "n" - 2,
              2 ), 4)                                    AS "p_value"
FROM   corr_per_type
ORDER  BY "aberration_type";
```
