```sql
--Description: 1) Show the distinct morphology / topography codes present in the clinical table
SELECT DISTINCT 
       "Morph",
       "Topo"
FROM   MITELMAN.PROD.CYTOGEN
LIMIT 20;
```

```sql
--Description: 2) Retrieve 20 breast-cancer (morph = 3111, topo = 0401) cases together with reference numbers
SELECT DISTINCT
       c."RefNo",
       c."CaseNo",
       c."InvNo",
       g."Morph",
       g."Topo"
FROM   MITELMAN.PROD.CYTOGEN      g
JOIN   MITELMAN.PROD.CYTOCONVERTED c
       ON  c."RefNo"  = g."RefNo"
       AND c."CaseNo" = g."CaseNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
LIMIT 20;
```

```sql
--Description: 3) Inspect the different copy-number “Type” values registered in CYTOCONVERTED
SELECT DISTINCT
       c."Type"
FROM   MITELMAN.PROD.CYTOCONVERTED c
LIMIT 20;
```

```sql
--Description: 4) Sample of gains for breast-cancer cases, showing genomic span and chromosome order
SELECT
       c."RefNo",
       c."CaseNo",
       c."Chr",
       c."ChrOrd",
       c."Start",
       c."End",
       c."Type"
FROM   MITELMAN.PROD.CYTOCONVERTED c
JOIN   MITELMAN.PROD.CYTOGEN       g
       ON  g."RefNo"  = c."RefNo"
       AND g."CaseNo" = c."CaseNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
  AND  c."Type"  ILIKE '%gain%'
LIMIT 20;
```

```sql
--Description: 5) Sample of losses for the same cohort
SELECT
       c."RefNo",
       c."CaseNo",
       c."Chr",
       c."ChrOrd",
       c."Start",
       c."End",
       c."Type"
FROM   MITELMAN.PROD.CYTOCONVERTED c
JOIN   MITELMAN.PROD.CYTOGEN       g
       ON  g."RefNo"  = c."RefNo"
       AND g."CaseNo" = c."CaseNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
  AND  c."Type"  ILIKE '%loss%'
LIMIT 20;
```

```sql
--Description: 6) Look for amplifications and high-level deletions (“Deletion”, “Amplification” keywords)
SELECT
       c."RefNo",
       c."CaseNo",
       c."Chr",
       c."Type"
FROM   MITELMAN.PROD.CYTOCONVERTED c
JOIN   MITELMAN.PROD.CYTOGEN       g
       ON  g."RefNo"  = c."RefNo"
       AND g."CaseNo" = c."CaseNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
  AND (c."Type" ILIKE '%amp%' OR c."Type" ILIKE '%del%')
LIMIT 20;
```

```sql
--Description: 7) Count number of breast-cancer gain events per chromosome
SELECT
       c."Chr",
       COUNT(*) AS "gain_count"
FROM   MITELMAN.PROD.CYTOCONVERTED c
JOIN   MITELMAN.PROD.CYTOGEN       g
       ON  g."RefNo"  = c."RefNo"
       AND g."CaseNo" = c."CaseNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
  AND  c."Type"  ILIKE '%gain%'
GROUP  BY c."Chr"
LIMIT 20;
```

```sql
--Description: 8) Count number of breast-cancer loss events per chromosome
SELECT
       c."Chr",
       COUNT(*) AS "loss_count"
FROM   MITELMAN.PROD.CYTOCONVERTED c
JOIN   MITELMAN.PROD.CYTOGEN       g
       ON  g."RefNo"  = c."RefNo"
       AND g."CaseNo" = c."CaseNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
  AND  c."Type"  ILIKE '%loss%'
GROUP  BY c."Chr"
LIMIT 20;
```

```sql
--Description: 9) Combine CYTOCONVERTED with CYTOBANDS_HG38 to map each event to its cytoband (gain events shown)
SELECT
       c."RefNo",
       c."CaseNo",
       c."Chr",
       b."cytoband_name",
       c."Start",
       c."End"
FROM   MITELMAN.PROD.CYTOCONVERTED c
JOIN   MITELMAN.PROD.CYTOGEN       g
       ON  g."RefNo"  = c."RefNo"
       AND g."CaseNo" = c."CaseNo"
JOIN   MITELMAN.PROD.CYTOBANDS_HG38 b
       ON  b."chromosome" = c."Chr"
       AND b."hg38_start" <= c."Start"
       AND b."hg38_stop"  >= c."End"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
  AND  c."Type"  ILIKE '%gain%'
LIMIT 20;
```

```sql
--Description: 10) For eventual correlation work, create a per-chromosome summary of all aberration categories
SELECT
       c."Chr",
       SUM(CASE WHEN c."Type" ILIKE '%amp%'  THEN 1 ELSE 0 END) AS "amplicon_events",
       SUM(CASE WHEN c."Type" ILIKE '%gain%' THEN 1 ELSE 0 END) AS "gain_events",
       SUM(CASE WHEN c."Type" ILIKE '%loss%' THEN 1 ELSE 0 END) AS "loss_events",
       SUM(CASE WHEN c."Type" ILIKE '%del%'  THEN 1 ELSE 0 END) AS "deletion_events"
FROM   MITELMAN.PROD.CYTOCONVERTED c
JOIN   MITELMAN.PROD.CYTOGEN       g
       ON  g."RefNo"  = c."RefNo"
       AND g."CaseNo" = c."CaseNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
GROUP  BY c."Chr"
LIMIT 20;
```
