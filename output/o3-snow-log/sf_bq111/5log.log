```sql
/*--------------------------------------------------------------
  Pearson correlation (and p-value) between Mitelman breast‐cancer
  (morph = 3111, topo = 0401) copy-number frequencies per chromosome
  and the corresponding TCGA frequencies, for each aberration type
  (Amplification, Gain, Loss, Deletion).  Only aberrations with
  ≥ 5 matching chromosomes are reported.
----------------------------------------------------------------*/
WITH
/* 1) Breast-cancer (BRCA) Mitelman cases */
bc_cases AS (
    SELECT DISTINCT
           "RefNo",
           "CaseNo"
    FROM   MITELMAN.PROD.CYTOGEN
    WHERE  "Morph" = '3111'
      AND  "Topo"  = '0401'
),
/* total number of cases in this cohort */
total_cases AS (
    SELECT COUNT(*) AS total_cases
    FROM   bc_cases
),
/* 2) Copy-number events (gain / loss) observed in those cases  */
mit_events AS (
    SELECT DISTINCT
           c."Chr"               AS Chr,
           g."RefNo",
           g."CaseNo",
           c."Type"              -- 'Gain' or 'Loss'
    FROM   MITELMAN.PROD.CYTOCONVERTED c
    JOIN   MITELMAN.PROD.CYTOGEN       g
           ON  g."RefNo"  = c."RefNo"
           AND g."CaseNo" = c."CaseNo"
    WHERE  g."Morph" = '3111'
      AND  g."Topo"  = '0401'
),
/* 3) For every chromosome, how many cases show a Gain or Loss? */
mit_chr_counts AS (
    SELECT
           Chr,
           COUNT( DISTINCT CASE WHEN "Type" = 'Gain'
                                THEN CONCAT("RefNo"::STRING,':',"CaseNo") END ) AS gain_cases,
           COUNT( DISTINCT CASE WHEN "Type" = 'Loss'
                                THEN CONCAT("RefNo"::STRING,':',"CaseNo") END ) AS loss_cases
    FROM   mit_events
    GROUP  BY Chr
),
/* 4) Convert counts into per-chromosome frequencies  */
mit_chr_freq AS (
    SELECT
           mc.Chr,
           mc.gain_cases / tc.total_cases::FLOAT  AS mit_freq_gain,
           mc.loss_cases / tc.total_cases::FLOAT  AS mit_freq_loss
    FROM   mit_chr_counts mc
    CROSS  JOIN total_cases tc
),

/*--------------------------------------------------------------
   TCGA copy-number frequencies (GISTIC output by cytoband)
   ‑- assumes presence of table TCGA.PUBLIC.CNV_CYTOBAND_FREQUENCY
   with columns:
        chromosome, total, freq_amp, freq_gain,
        freq_homodel, freq_heterodel, freq_normal
--------------------------------------------------------------*/
tcga_band AS (
    SELECT
           "chromosome"              AS Chr,
           "total"                   AS tot,
           "freq_amp"                AS freq_amp,
           "freq_gain"               AS freq_gain,
           "freq_homodel"            AS freq_homodel,
           "freq_heterodel"          AS freq_heterodel
    FROM   TCGA.PUBLIC.CNV_CYTOBAND_FREQUENCY
),
/* aggregate cytoband data up to whole-chromosome level
   (weighted by number of samples contributing to each band)   */
tcga_chr_freq AS (
    SELECT
           Chr,
           SUM(tot * freq_amp         ) / SUM(tot)  AS tcga_freq_amp,
           SUM(tot * freq_gain        ) / SUM(tot)  AS tcga_freq_gain,
           SUM(tot * freq_homodel     ) / SUM(tot)  AS tcga_freq_homodel,
           SUM(tot * freq_heterodel   ) / SUM(tot)  AS tcga_freq_heterodel,
           /* overall deletion frequency  */
           SUM(tot * (freq_homodel + freq_heterodel)) / SUM(tot) AS tcga_freq_del
    FROM   tcga_band
    GROUP  BY Chr
),

/*--------------------------------------------------------------
   5) Combine Mitelman and TCGA per-chromosome frequencies
--------------------------------------------------------------*/
combined AS (
    SELECT
           m.Chr,
           m.mit_freq_gain,
           m.mit_freq_loss,
           t.tcga_freq_amp,
           t.tcga_freq_gain,
           t.tcga_freq_homodel,
           t.tcga_freq_heterodel,
           t.tcga_freq_del
    FROM   mit_chr_freq m
    JOIN   tcga_chr_freq t
           ON  t.Chr = m.Chr
),

/*--------------------------------------------------------------
   6) Correlation coefficient (r), sample size (n) per aberration
--------------------------------------------------------------*/
corr_stats AS
(
    /* Amplifications (Mitelman gains  vs  TCGA amplifications) */
    SELECT 'Amplification'                          AS aberration_type,
           CORR(mit_freq_gain, tcga_freq_amp)       AS r,
           COUNT(*)                                 AS n
    FROM   combined
    WHERE  mit_freq_gain IS NOT NULL
      AND  tcga_freq_amp IS NOT NULL

    UNION ALL

    /* Low-level Gains */
    SELECT 'Gain',
           CORR(mit_freq_gain, tcga_freq_gain),
           COUNT(*)
    FROM   combined
    WHERE  mit_freq_gain IS NOT NULL
      AND  tcga_freq_gain IS NOT NULL

    UNION ALL

    /* Losses  (vs heterozygous deletions) */
    SELECT 'Loss',
           CORR(mit_freq_loss, tcga_freq_heterodel),
           COUNT(*)
    FROM   combined
    WHERE  mit_freq_loss IS NOT NULL
      AND  tcga_freq_heterodel IS NOT NULL

    UNION ALL

    /* Deletions  (homo + hetero) */
    SELECT 'Deletion',
           CORR(mit_freq_loss, tcga_freq_del),
           COUNT(*)
    FROM   combined
    WHERE  mit_freq_loss IS NOT NULL
      AND  tcga_freq_del IS NOT NULL
),

/*--------------------------------------------------------------
   7) Calculate two-tailed p-value for each correlation
      t = r * sqrt((n-2)/(1-r^2))
      p = P(|T| > |t|)  with df = n-2
--------------------------------------------------------------*/
final AS (
    SELECT
           aberration_type,
           r                           AS correlation_coefficient,
           /* Two-tailed p-value using Student-t distribution */
           T_DIST_2T(
               ABS(r * SQRT( (n - 2)::FLOAT / NULLIF(1 - r*r,0) )),
               n - 2
           )                           AS p_value
    FROM   corr_stats
    WHERE  n >= 5         -- ensure at least five matching chromosomes
)

SELECT *
FROM   final
ORDER  BY aberration_type;
```
