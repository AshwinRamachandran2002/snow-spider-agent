/*--------------------------------------------------------------
  Pearson correlations (and p-values) between Mitelman breast-cancer
  (morph = 3111, topo = 0401) chromosome-level copy-number frequencies
  and TCGA-BRCA chromosome-level frequencies for four aberration types
  (Amplification, Gain, Loss, Deletion).  Only aberration types having
  at least five chromosomes in common are returned.
----------------------------------------------------------------*/
WITH
/*────────────────────────────────────────────────────────────────
  1)  Mitelman breast-cancer cases
  ────────────────────────────────────────────────────────────────*/
bc_cases AS (
    SELECT DISTINCT "RefNo", "CaseNo"
    FROM   MITELMAN.PROD.CYTOGEN
    WHERE  "Morph" = '3111'            -- breast carcinoma
      AND  "Topo"  = '0401'            -- topography code
),
total_cases AS (                       -- # Mitelman BRCA cases
    SELECT COUNT(*) AS total_cases
    FROM   bc_cases
),

/* Mitelman copy-number events (Gain | Loss)                         */
mit_events AS (
    SELECT DISTINCT
           c."Chr"                                  AS chr,
           g."RefNo",
           g."CaseNo",
           c."Type"                                 AS event_type     -- Gain | Loss
    FROM   MITELMAN.PROD.CYTOCONVERTED c
    JOIN   MITELMAN.PROD.CYTOGEN       g
           ON g."RefNo"  = c."RefNo"
          AND g."CaseNo" = c."CaseNo"
    WHERE  g."Morph" = '3111'
      AND  g."Topo"  = '0401'
),

/* Per-chromosome counts of Gain / Loss in Mitelman                  */
mit_chr_counts AS (
    SELECT
           chr,
           COUNT(DISTINCT CASE WHEN event_type = 'Gain'
                                THEN CONCAT(TO_VARCHAR("RefNo"),':',"CaseNo") END) AS gain_cases,
           COUNT(DISTINCT CASE WHEN event_type = 'Loss'
                                THEN CONCAT(TO_VARCHAR("RefNo"),':',"CaseNo") END) AS loss_cases
    FROM   mit_events
    GROUP  BY chr
),

/* Convert Mitelman counts to frequencies                            */
mit_chr_freq AS (
    SELECT
           mcc.chr,
           mcc.gain_cases::FLOAT / tc.total_cases   AS mit_freq_gain,
           mcc.loss_cases::FLOAT / tc.total_cases   AS mit_freq_loss
    FROM   mit_chr_counts mcc
    CROSS  JOIN total_cases tc
),

/*────────────────────────────────────────────────────────────────
  2)  TCGA GISTIC2 thresholded CNV calls (BRCA cohort)
      ─ select worst call (max abs value) per sample × chromosome
  ────────────────────────────────────────────────────────────────*/
tcga_chr_call AS (
    SELECT
           CHROMOSOME                                AS chr,
           SAMPLE_BARCODE                            AS sample_id,
           COPY_NUMBER::INT                          AS call_value,
           ROW_NUMBER() OVER (
               PARTITION BY CHROMOSOME, SAMPLE_BARCODE
               ORDER BY ABS(COPY_NUMBER::INT) DESC,
                        COPY_NUMBER::INT        DESC
           )                                         AS rn
    FROM   TCGA.PUBLIC.CNV_GISTIC2_THRESHOLD_BY_CYTOBAND
    WHERE  PROJECT_SHORT_NAME = 'BRCA'
    QUALIFY rn = 1                                   -- keep worst call only
),

/* Chromosome-level event frequencies across BRCA samples            */
tcga_chr_freq AS (
    SELECT
           chr,
           AVG(CASE WHEN call_value =  2 THEN 1 ELSE 0 END)            AS tcga_freq_amp,
           AVG(CASE WHEN call_value =  1 THEN 1 ELSE 0 END)            AS tcga_freq_gain,
           AVG(CASE WHEN call_value = -2 THEN 1 ELSE 0 END)            AS tcga_freq_homodel,
           AVG(CASE WHEN call_value = -1 THEN 1 ELSE 0 END)            AS tcga_freq_heterodel,
           AVG(CASE WHEN call_value IN (-2,-1) THEN 1 ELSE 0 END)      AS tcga_freq_del
    FROM   tcga_chr_call
    GROUP  BY chr
),

/*────────────────────────────────────────────────────────────────
  3)  Merge Mitelman & TCGA chromosome-level frequencies
  ────────────────────────────────────────────────────────────────*/
combined AS (
    SELECT
           m.chr,
           m.mit_freq_gain,
           m.mit_freq_loss,
           t.tcga_freq_amp,
           t.tcga_freq_gain,
           t.tcga_freq_homodel,
           t.tcga_freq_heterodel,
           t.tcga_freq_del
    FROM   mit_chr_freq m
    JOIN   tcga_chr_freq t  ON t.chr = m.chr
),

/*────────────────────────────────────────────────────────────────
  4)  Pearson correlation (r) & sample size (n) per aberration type
  ────────────────────────────────────────────────────────────────*/
corr_stats AS (
    SELECT 'Amplification'                        AS aberration_type,
           CORR(mit_freq_gain, tcga_freq_amp)     AS r,
           COUNT(*)                               AS n
    FROM   combined

    UNION ALL
    SELECT 'Gain',
           CORR(mit_freq_gain, tcga_freq_gain),
           COUNT(*)
    FROM   combined

    UNION ALL
    SELECT 'Loss',
           CORR(mit_freq_loss, tcga_freq_heterodel),
           COUNT(*)
    FROM   combined

    UNION ALL
    SELECT 'Deletion',
           CORR(mit_freq_loss, tcga_freq_del),
           COUNT(*)
    FROM   combined
),

/*────────────────────────────────────────────────────────────────
  5)  Two-tailed p-value for each correlation
  ────────────────────────────────────────────────────────────────*/
final AS (
    SELECT
           aberration_type,
           r                                            AS correlation_coefficient,
           T_DIST_2T(                                   -- Student-t two-tailed
               ABS( r * SQRT( (n - 2) / NULLIF(1 - r*r, 0) ) ),
               n - 2
           )                                            AS p_value
    FROM   corr_stats
    WHERE  n >= 5                                       -- ensure ≥ 5 chromosomes
)

SELECT *
FROM   final
ORDER  BY aberration_type;
