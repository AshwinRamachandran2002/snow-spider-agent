--Description: 10) Per-chromosome summary of copy-number events (only ‘Gain’ and ‘Loss’ categories exist in CYTOCONVERTED)
SELECT
       c."Chr",
       SUM(CASE WHEN c."Type" = 'Gain' THEN 1 ELSE 0 END) AS "gain_events",
       SUM(CASE WHEN c."Type" = 'Loss' THEN 1 ELSE 0 END) AS "loss_events"
FROM   MITELMAN.PROD.CYTOCONVERTED c
JOIN   MITELMAN.PROD.CYTOGEN       g
       ON  g."RefNo"  = c."RefNo"
       AND g."CaseNo" = c."CaseNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
GROUP  BY c."Chr"
LIMIT 20
