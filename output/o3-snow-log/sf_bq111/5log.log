--Description: 9) Map each GAIN event (breast cancer cases) to its corresponding cytoband
SELECT
       c."RefNo",
       c."CaseNo",
       c."Chr",
       b."cytoband_name",
       c."Start",
       c."End"
FROM   MITELMAN.PROD.CYTOCONVERTED c
JOIN   MITELMAN.PROD.CYTOGEN       g
       ON  g."RefNo"  = c."RefNo"
       AND g."CaseNo" = c."CaseNo"
JOIN   MITELMAN.PROD.CYTOBANDS_HG38 b
       ON  b."chromosome" = c."Chr"
       AND b."hg38_start" <= c."Start"
       AND b."hg38_stop"  >= c."End"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
  AND  c."Type"  = 'Gain'
