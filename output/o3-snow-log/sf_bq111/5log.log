FROM   MITELMAN.PROD.CYTOCONVERTED c
JOIN   MITELMAN.PROD.CYTOGEN       g
       ON  g."RefNo"  = c."RefNo"
       AND g."CaseNo" = c."CaseNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
  AND  c."Type"  = 'Gain'
GROUP  BY c."Chr"
LIMIT 20;
```

```sql
--Description: 8) Count number of breast-cancer LOSS events per chromosome (use exact ‘Loss’ value)
SELECT
       c."Chr",
       COUNT(*) AS "loss_count"
FROM   MITELMAN.PROD.CYTOCONVERTED c
JOIN   MITELMAN.PROD.CYTOGEN       g
       ON  g."RefNo"  = c."RefNo"
       AND g."CaseNo" = c."CaseNo"
WHERE  g."Morph" = '3111'
  AND  g."Topo"  = '0401'
