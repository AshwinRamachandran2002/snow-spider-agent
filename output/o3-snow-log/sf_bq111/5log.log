----------------------------------------------------------------*/
WITH
/* 1) Breast-cancer Mitelman cases */
bc_cases AS (
    SELECT DISTINCT
           "RefNo",
           "CaseNo"
    FROM   MITELMAN.PROD.CYTOGEN
    WHERE  "Morph" = '3111'
      AND  "Topo"  = '0401'
),
/* 2) Total number of Mitelman breast-cancer cases                        */
total_cases AS (
    SELECT COUNT(*) AS total_cases
    FROM   bc_cases
),
/* 3) Copy-number events (‘Gain’ | ‘Loss’) for those cases                */
mit_events AS (
    SELECT DISTINCT
           c."Chr"        AS chr,
           g."RefNo",
           g."CaseNo",
           c."Type"       AS event_type          /* Gain | Loss */
    FROM   MITELMAN.PROD.CYTOCONVERTED c
    JOIN   MITELMAN.PROD.CYTOGEN       g
           ON  g."RefNo"  = c."RefNo"
           AND g."CaseNo" = c."CaseNo"
    WHERE  g."Morph" = '3111'
      AND  g."Topo"  = '0401'
),
/* 4) Per-chromosome counts of Gain and Loss events                       */
mit_chr_counts AS (
    SELECT
           chr,
           COUNT( DISTINCT CASE WHEN event_type = 'Gain'
                                 THEN CONCAT( TO_VARCHAR("RefNo"), ':', "CaseNo") END ) AS gain_cases,
           COUNT( DISTINCT CASE WHEN event_type = 'Loss'
                                 THEN CONCAT( TO_VARCHAR("RefNo"), ':', "CaseNo") END ) AS loss_cases
    FROM   mit_events
    GROUP  BY chr
),
/* 5) Convert counts to frequencies (cases with event ÷ total cases)      */
mit_chr_freq AS (
    SELECT
           mcc.chr,
           (mcc.gain_cases::FLOAT / tc.total_cases)  AS mit_freq_gain,
           (mcc.loss_cases::FLOAT / tc.total_cases)  AS mit_freq_loss
    FROM   mit_chr_counts mcc
    CROSS  JOIN total_cases tc
),

/* -----------------------------------------------------------------------
   6) TCGA copy-number frequencies by cytoband (GISTIC results)  
      (assumes table  "TCGA"."PUBLIC"."CNV_CYTOBAND_FREQUENCY"  exists
       with columns: chromosome, total, freq_amp, freq_gain,
                     freq_homodel, freq_heterodel, freq_normal)
----------------------------------------------------------------------- */
tcga_band AS (
    SELECT
           "chromosome"      AS chr,
           "total"           AS tot,
           "freq_amp"        AS freq_amp,        /* high-level amp  */
           "freq_gain"       AS freq_gain,       /* low-level gain  */
           "freq_homodel"    AS freq_homodel,    /* homo-del        */
           "freq_heterodel"  AS freq_heterodel   /* hetero-del      */
    FROM   "TCGA"."PUBLIC"."CNV_CYTOBAND_FREQUENCY"
),
/* 7) Aggregate cytoband data to whole-chromosome weighted means          */
tcga_chr_freq AS (
    SELECT
           chr,
           SUM(tot * freq_amp       ) / SUM(tot)  AS tcga_freq_amp,
           SUM(tot * freq_gain      ) / SUM(tot)  AS tcga_freq_gain,
           SUM(tot * freq_homodel   ) / SUM(tot)  AS tcga_freq_homodel,
           SUM(tot * freq_heterodel ) / SUM(tot)  AS tcga_freq_heterodel,
           /* overall deletion freq (homo + hetero) */
           SUM(tot * (freq_homodel + freq_heterodel)) / SUM(tot) AS tcga_freq_del
    FROM   tcga_band
    GROUP  BY chr
),

/* 8) Join Mitelman and TCGA chromosome-level frequencies                 */
combined AS (
    SELECT
           m.chr,
           m.mit_freq_gain,
           m.mit_freq_loss,
           t.tcga_freq_amp,
           t.tcga_freq_gain,
           t.tcga_freq_homodel,
           t.tcga_freq_heterodel,
           t.tcga_freq_del
    FROM   mit_chr_freq m
    JOIN   tcga_chr_freq t
           ON t.chr = m.chr
),

/* 9) Compute Pearson correlation (r) and sample size (n) per aberration  */
corr_stats AS (
    /* Amplifications: Mitelman gains vs TCGA high-level amps */
    SELECT 'Amplification'                         AS aberration_type,
           CORR(mit_freq_gain, tcga_freq_amp)      AS r,
           COUNT(*)                                AS n
    FROM   combined
    WHERE  mit_freq_gain IS NOT NULL
      AND  tcga_freq_amp IS NOT NULL

    UNION ALL

    /* Gains: Mitelman gains vs TCGA low-level gains */
    SELECT 'Gain',
           CORR(mit_freq_gain, tcga_freq_gain),
           COUNT(*)
    FROM   combined
    WHERE  mit_freq_gain IS NOT NULL
      AND  tcga_freq_gain IS NOT NULL

    UNION ALL

    /* Losses: Mitelman losses vs TCGA heterozygous deletions */
    SELECT 'Loss',
           CORR(mit_freq_loss, tcga_freq_heterodel),
           COUNT(*)
    FROM   combined
    WHERE  mit_freq_loss IS NOT NULL
      AND  tcga_freq_heterodel IS NOT NULL

    UNION ALL

    /* Deletions: Mitelman losses vs TCGA total deletions (homo+hetero) */
    SELECT 'Deletion',
           CORR(mit_freq_loss, tcga_freq_del),
           COUNT(*)
    FROM   combined
    WHERE  mit_freq_loss IS NOT NULL
      AND  tcga_freq_del IS NOT NULL
),

/* 10) Convert r & n to two-tailed p-values                               */
final AS (
    SELECT
           aberration_type,
           r                                         AS correlation_coefficient,
           /* two-tailed p-value using Excel-style T_DIST_2T function */
           T_DIST_2T(
               ABS( r * SQRT( (n - 2)::FLOAT / NULLIF(1 - r*r, 0) ) ),
               n - 2
           )                                         AS p_value
    FROM   corr_stats
    WHERE  n >= 5
)

SELECT *
FROM   final
ORDER  BY aberration_type;
