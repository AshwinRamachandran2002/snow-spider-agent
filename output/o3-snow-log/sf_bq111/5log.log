           mcc.loss_cases::FLOAT / tc.total_cases  AS mit_freq_loss
    FROM   mit_chr_counts mcc
    CROSS  JOIN total_cases tc
),

/* ──────────────────────────────────────────────────────────────
   2)  TCGA GISTIC2 thresholded CNV calls (BRCA cohort)
   ────────────────────────────────────────────────────────────── */
/* Keep BRCA rows and pick the most extreme call per sample × chr       */
tcga_chr_call AS (
    SELECT
           "CHROMOSOME"                           AS chr,
           "SAMPLE_BARCODE"                       AS "SAMPLE_BARCODE",
           "COPY_NUMBER"::INT                     AS call,
           ROW_NUMBER() OVER (
               PARTITION BY "CHROMOSOME", "SAMPLE_BARCODE"
               ORDER BY ABS("COPY_NUMBER"::INT) DESC,
                        "COPY_NUMBER"::INT      DESC
           )                                      AS rn
    FROM   TCGA.PUBLIC.CNV_GISTIC2_THRESHOLD_BY_CYTOBAND
    WHERE  "PROJECT_SHORT_NAME" = 'BRCA'
    QUALIFY rn = 1                                -- keep the worst call
),
/* Chromosome-level event frequencies across BRCA samples               */
tcga_chr_freq AS (
    SELECT
           chr,
           AVG(CASE WHEN call =  2 THEN 1 ELSE 0 END)                 AS tcga_freq_amp,
           AVG(CASE WHEN call =  1 THEN 1 ELSE 0 END)                 AS tcga_freq_gain,
           AVG(CASE WHEN call = -2 THEN 1 ELSE 0 END)                 AS tcga_freq_homodel,
           AVG(CASE WHEN call = -1 THEN 1 ELSE 0 END)                 AS tcga_freq_heterodel,
           AVG(CASE WHEN call IN (-2,-1) THEN 1 ELSE 0 END)           AS tcga_freq_del
    FROM   tcga_chr_call
    GROUP  BY chr
),

/* ──────────────────────────────────────────────────────────────
   3)  Combine Mitelman & TCGA chromosome-level frequencies
   ────────────────────────────────────────────────────────────── */
combined AS (
    SELECT
           m.chr,
           m.mit_freq_gain,
           m.mit_freq_loss,
           t.tcga_freq_amp,
           t.tcga_freq_gain,
           t.tcga_freq_homodel,
           t.tcga_freq_heterodel,
           t.tcga_freq_del
    FROM   mit_chr_freq m
    JOIN   tcga_chr_freq t
           ON t.chr = m.chr
),

/* ──────────────────────────────────────────────────────────────
   4)  Pearson correlations & sample size per aberration type
   ────────────────────────────────────────────────────────────── */
corr_stats AS (
    SELECT 'Amplification'                        AS aberration_type,
           CORR(mit_freq_gain, tcga_freq_amp)     AS r,
           COUNT(*)                               AS n
    FROM   combined

    UNION ALL
    SELECT 'Gain',
           CORR(mit_freq_gain, tcga_freq_gain),
           COUNT(*)
    FROM   combined

    UNION ALL
    SELECT 'Loss',
           CORR(mit_freq_loss, tcga_freq_heterodel),
           COUNT(*)
    FROM   combined

    UNION ALL
    SELECT 'Deletion',
           CORR(mit_freq_loss, tcga_freq_del),
           COUNT(*)
    FROM   combined
),

/* ──────────────────────────────────────────────────────────────
   5)  Two-tailed p-value for each correlation
   ────────────────────────────────────────────────────────────── */
final AS (
    SELECT
           aberration_type,
           r                                     AS correlation_coefficient,
           T_DIST_2T(                            -- Student-t two-tailed
               ABS( r * SQRT( (n - 2) / NULLIF(1 - r*r, 0) ) ),
               n - 2
           )                                     AS p_value
    FROM   corr_stats
    WHERE  n >= 5
)

SELECT *
FROM   final
ORDER  BY aberration_type;
