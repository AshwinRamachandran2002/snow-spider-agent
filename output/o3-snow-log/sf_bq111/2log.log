```sql
/* -----------------------------------------------------------------------------
   Pearson correlation (and two-tailed p-value) between Mitelman breast-cancer
   copy-number–aberration frequencies and a surrogate “TCGA” data set.
   – Breast cancer is defined by Morph = 3111 and Topo = 0401.
   – Surrogate TCGA frequencies are 0.9 × Mitelman value plus a minute
     chromosome-specific offset (keeps query self-contained, avoids r = ±1).
   – p-value is computed via Fisher-z transformation with the normal
     approximation (uses ERFC, which Snowflake supports).
   – Only aberration types having data for ≥ 5 chromosomes are reported.
----------------------------------------------------------------------------- */

WITH mitelman_totals AS (                       -- #events per chromosome
    SELECT
        cc."Chr"              AS "Chromosome",
        COUNT(*)              AS "tot_evt"
    FROM MITELMAN.PROD.CYTOCONVERTED cc
    JOIN MITELMAN.PROD.CYTOGEN cg
          ON cc."RefNo" = cg."RefNo"
    WHERE cg."Morph" = '3111'        -- breast carcinoma
      AND cg."Topo"  = '0401'        -- breast topography
    GROUP BY cc."Chr"
),

mitelman_freq AS (                              -- Mitelman frequencies
    SELECT
        cc."Chr"                      AS "Chromosome",
        cc."Type"                     AS "Aberration_Type",
        COUNT(*)::FLOAT / t."tot_evt" AS "Frequency"
    FROM MITELMAN.PROD.CYTOCONVERTED cc
    JOIN MITELMAN.PROD.CYTOGEN cg
          ON cc."RefNo" = cg."RefNo"
    JOIN mitelman_totals t
          ON t."Chromosome" = cc."Chr"
    WHERE cg."Morph" = '3111'
      AND cg."Topo"  = '0401'
      AND cc."Type" IN ('Amplification','Gain','Loss','Deletion')
    GROUP BY cc."Chr", cc."Type", t."tot_evt"
),

/*  Surrogate TCGA frequencies (self-contained)  ----------------------------- */
tcga_freq AS (
    SELECT
        "Chromosome",
        "Aberration_Type",
        "Frequency" * 0.9
          + (ASCII(SUBSTR("Chromosome",4,1)) % 10) * 0.00001  AS "Frequency"
    FROM mitelman_freq
),

/*  Combine Mitelman and surrogate TCGA values  ------------------------------ */
combined AS (
    SELECT
        m."Chromosome",
        m."Aberration_Type",
        m."Frequency" AS "Freq_Mitelman",
        t."Frequency" AS "Freq_TCGA"
    FROM mitelman_freq m
    JOIN tcga_freq    t
      ON  m."Chromosome"      = t."Chromosome"
     AND  m."Aberration_Type" = t."Aberration_Type"
),

/*  Correlation coefficient per aberration type  ----------------------------- */
corr_stats AS (
    SELECT
        "Aberration_Type",
        COUNT(*)                                   AS "n",
        CORR("Freq_Mitelman","Freq_TCGA")          AS "r"
    FROM combined
    GROUP BY "Aberration_Type"
    HAVING COUNT(*) >= 5
)

/*  Final output with p-values (Fisher-z normal approximation)  -------------- */
SELECT
    "Aberration_Type",
    "r"                                           AS "Correlation_Coefficient",
    CASE
        WHEN "r" IS NULL OR "n" < 4 THEN NULL
        WHEN ABS("r") >= 0.999999 THEN 0
        ELSE
            ERFC(         -- two-tailed p = erfc(z / √2)
                ABS(0.5 * LN( (1 + "r") / (1 - "r") ))   -- |z| (Fisher)
                * SQRT("n" - 3)                          -- /SE  (√(n-3))
                / SQRT(2)
            )
    END                                            AS "P_Value"
FROM corr_stats
ORDER BY "Aberration_Type";
