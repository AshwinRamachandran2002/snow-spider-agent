```sql
/*  ---------------------------------------------------------------------------
    Pearson correlation (and p-value) between Mitelman and TCGA copy-number
    aberration frequencies – calculated per aberration type (Amplification,
    Gain, Loss, Deletion) across all chromosomes.  Only aberration types with
    ≥ 5 chromosome-level data points are reported.
    ------------------------------------------------------------------------- */

WITH mitelman_totals AS (      -- total #events per chromosome (breast cancer)
    SELECT
        cc."Chr"                         AS "Chromosome",
        COUNT(*)                         AS "tot_evt"
    FROM MITELMAN.PROD.CYTOCONVERTED cc
    JOIN MITELMAN.PROD.CYTOGEN cg
          ON cc."RefNo" = cg."RefNo"
    WHERE cg."Morph" = '3111'            -- breast carcinoma
      AND cg."Topo"  = '0401'            -- breast topography
    GROUP BY cc."Chr"
),

mitelman_freq AS (             -- Mitelman frequency per chromosome & type
    SELECT
        cc."Chr"                       AS "Chromosome",
        cc."Type"                      AS "Aberration_Type",
        COUNT(*)::FLOAT / t."tot_evt"  AS "Frequency"
    FROM MITELMAN.PROD.CYTOCONVERTED cc
    JOIN MITELMAN.PROD.CYTOGEN cg
          ON cc."RefNo" = cg."RefNo"
    JOIN mitelman_totals t
          ON t."Chromosome" = cc."Chr"
    WHERE cg."Morph" = '3111'
      AND cg."Topo"  = '0401'
      AND cc."Type" IN ('Amplification','Gain','Loss','Deletion')
    GROUP BY cc."Chr", cc."Type", t."tot_evt"
),

/*  TCGA cytoband-level CNV frequencies have been pre-computed in the public
    table TCGA.PUBLIC.CNV_BAND_FREQ (one row per cytoband).  Convert them to
    the same long format: chromosome × aberration type.                         */
tcga_freq AS (
      /* Amplifications ------------------------------------------------------ */
      SELECT "chromosome"                 AS "Chromosome",
             'Amplification'              AS "Aberration_Type",
             AVG("freq_amp")              AS "Frequency"
        FROM TCGA.PUBLIC.CNV_BAND_FREQ
       GROUP BY "chromosome"
      UNION ALL
      /* Low-level gains ------------------------------------------------------ */
      SELECT "chromosome",
             'Gain',
             AVG("freq_gain")
        FROM TCGA.PUBLIC.CNV_BAND_FREQ
       GROUP BY "chromosome"
      UNION ALL
      /* Loss  = hetero- plus homozygous deletions --------------------------- */
      SELECT "chromosome",
             'Loss',
             AVG("freq_homodel" + "freq_heterodel")
        FROM TCGA.PUBLIC.CNV_BAND_FREQ
       GROUP BY "chromosome"
      UNION ALL
      /* Homozygous deletions ------------------------------------------------- */
      SELECT "chromosome",
             'Deletion',
             AVG("freq_homodel")
        FROM TCGA.PUBLIC.CNV_BAND_FREQ
       GROUP BY "chromosome"
),

/*  Bring both data sets together -------------------------------------------- */
combined AS (
    SELECT
        m."Chromosome",
        m."Aberration_Type",
        m."Frequency"  AS "Freq_Mitelman",
        t."Frequency"  AS "Freq_TCGA"
    FROM mitelman_freq m
    JOIN tcga_freq    t
      ON  m."Chromosome"      = t."Chromosome"
     AND  m."Aberration_Type" = t."Aberration_Type"
),

/*  Correlation coefficients per aberration type ----------------------------- */
corr_stats AS (
    SELECT
        "Aberration_Type",
        COUNT(*)                                 AS "n",
        CORR("Freq_Mitelman","Freq_TCGA")        AS "r"
    FROM combined
    GROUP BY "Aberration_Type"
    HAVING COUNT(*) >= 5                        -- require ≥5 chromosomes
),

/*  Convert r to two-tailed p-value using the t-distribution ------------------ */
final AS (
    SELECT
        "Aberration_Type",
        "r"                                AS "Correlation_Coefficient",
        /* t-statistic */
        ABS("r") * SQRT( ("n" - 2) / (1 - POWER("r",2)) )      AS "t_stat",
        /* p-value: 2*(1 – I_{ν/(ν+t²)}(ν/2 , 0.5) )  where ν = n-2           */
        2 * ( 1 - BETA_INC( 
                    ("n" - 2)::FLOAT / ( ("n" - 2) + POWER(ABS("r") * 
                                    SQRT( ("n" - 2) / (1 - POWER("r",2)) ), 2) ),
                    ("n" - 2) / 2.0,
                    0.5
                  )
            )                                AS "P_Value"
    FROM corr_stats
)

SELECT
    "Aberration_Type",
    "Correlation_Coefficient",
    "P_Value"
FROM final
ORDER BY "Aberration_Type";
```
