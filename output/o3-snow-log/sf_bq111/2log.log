```sql
--Description: Attach numeric chromosome order (from RECURRENTNUMDATA) to
--             per-chromosome “Gain” counts for breast-cancer cases
--             (Morph = 3111, Topo = 0401).
--  • CTE rn  : one row per chromosome with its minimal "ChrOrder".
--  • CTE freq: total rows and “Gain” rows per chromosome in the target cohort.
--  • Join on chromosome after stripping the ‘chr’ prefix (e.g. ‘chr14’ → ‘14’).
--  • Display chromosome, order, total rows, and gain counts.
WITH rn AS (               -- lookup for chromosome → numeric order
  SELECT "Chromosome",
         MIN("ChrOrder") AS "ChrOrder"
  FROM   "MITELMAN"."PROD"."RECURRENTNUMDATA"
  GROUP  BY "Chromosome"
),
freq AS (                  -- counts for Morph 3111 / Topo 0401
  SELECT cc."Chr",
         COUNT(*)                                       AS "tot_rows",
         SUM(CASE WHEN cc."Type" = 'Gain' THEN 1 END)   AS "gain_rows"
  FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cc
  JOIN   "MITELMAN"."PROD"."CYTOGEN"        cg
    ON   cc."RefNo" = cg."RefNo"
  WHERE  cg."Morph" = '3111'
    AND  cg."Topo"  = '0401'
  GROUP  BY cc."Chr"
)
SELECT f."Chr",
       rn."ChrOrder",
       f."tot_rows",
       f."gain_rows"
FROM   freq f
JOIN   rn
  ON   rn."Chromosome" = SUBSTR(f."Chr", 4)  -- remove 'chr' prefix
ORDER  BY rn."ChrOrder"
LIMIT 20;
```
