```sql
--Description: Retrieve 20 breast-cancer (Morph = 3111, Topo = 0401) clones with their aberration types.  
SELECT cc."RefNo",
       cc."CaseNo",
       cc."Clone",
       cc."Chr",
       cc."Type",
