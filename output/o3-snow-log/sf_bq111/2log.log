       cg."Topo"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cc
JOIN   "MITELMAN"."PROD"."CYTOGEN"        cg
  ON   cc."RefNo" = cg."RefNo"
WHERE  cg."Morph" = '3111'
  AND  cg."Topo"  = '0401'
LIMIT 20;
```

```sql
--Description: Count, per chromosome and aberration type, how many breast-cancer clones carry each event.  
SELECT cc."Chr",
       cc."Type",
       COUNT(*) AS "clone_cnt"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cc
JOIN   "MITELMAN"."PROD"."CYTOGEN"        cg
  ON   cc."RefNo" = cg."RefNo"
WHERE  cg."Morph" = '3111'
  AND  cg."Topo"  = '0401'
GROUP  BY cc."Chr",
          cc."Type"
ORDER  BY cc."Chr",
          cc."Type"
LIMIT 20;
```

```sql
--Description: Compute the total number of breast-cancer clones examined per chromosome (needed for frequencies).  
SELECT cc."Chr",
       COUNT(*) AS "total_clones_chr"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cc
JOIN   "MITELMAN"."PROD"."CYTOGEN"        cg
  ON   cc."RefNo" = cg."RefNo"
WHERE  cg."Morph" = '3111'
  AND  cg."Topo"  = '0401'
GROUP  BY cc."Chr"
ORDER  BY cc."Chr"
LIMIT 20;
```

```sql
--Description: Derive per-chromosome frequencies of gains and losses  
--             (sample output will include the four major categories).  
SELECT cc."Chr",
       SUM(CASE WHEN cc."Type" = 'Amplification' THEN 1 ELSE 0 END)
         / COUNT(*)::FLOAT AS "freq_amp",
       SUM(CASE WHEN cc."Type" = 'Gain'          THEN 1 ELSE 0 END)
         / COUNT(*)::FLOAT AS "freq_gain",
       SUM(CASE WHEN cc."Type" = 'Loss'          THEN 1 ELSE 0 END)
         / COUNT(*)::FLOAT AS "freq_loss",
       SUM(CASE WHEN cc."Type" = 'Deletion'      THEN 1 ELSE 0 END)
         / COUNT(*)::FLOAT AS "freq_del"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cc
JOIN   "MITELMAN"."PROD"."CYTOGEN"        cg
  ON   cc."RefNo" = cg."RefNo"
WHERE  cg."Morph" = '3111'
  AND  cg."Topo"  = '0401'
GROUP  BY cc."Chr"
ORDER  BY cc."Chr"
LIMIT 20;
```

```sql
--Description: Attach hg38 chromosome order to the per-chromosome frequencies (helps with downstream joins).  
WITH freq AS (
  SELECT cc."Chr",
         COUNT(*) AS "tot",
         SUM(CASE WHEN cc."Type" = 'Gain' THEN 1 ELSE 0 END) AS "gains"
  FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cc
  JOIN   "MITELMAN"."PROD"."CYTOGEN"        cg
    ON   cc."RefNo" = cg."RefNo"
  WHERE  cg."Morph" = '3111'
    AND  cg."Topo"  = '0401'
  GROUP  BY cc."Chr"
)
SELECT f."Chr",
       cb."ChrOrder",
       f."tot",
       f."gains"
FROM   freq f
JOIN   "MITELMAN"."PROD"."CYTOBANDS_HG38" cb
  ON   cb."chromosome" = f."Chr"
GROUP  BY f."Chr",
          cb."ChrOrder",
          f."tot",
          f."gains"
ORDER  BY cb."ChrOrder"
LIMIT 20;
```

```sql
--Description: Produce a per-chromosome, wide-format table (pivot) of the four aberration types.  
SELECT *
FROM (
      SELECT cc."Chr",
             cc."Type",
             COUNT(*) AS "cnt"
      FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cc
      JOIN   "MITELMAN"."PROD"."CYTOGEN"        cg
        ON   cc."RefNo" = cg."RefNo"
      WHERE  cg."Morph" = '3111'
        AND  cg."Topo"  = '0401'
      GROUP  BY cc."Chr",
                cc."Type"
     ) PIVOT (
       SUM("cnt")
       FOR "Type" IN ('Amplification', 'Gain', 'Loss', 'Deletion')
     ) AS p
LIMIT 20;
```

```sql
--Description: Demonstrate an intra-Mitelman correlation example – here, 
--             correlation between gain and loss frequencies by chromosome 
--             (requires ≥ 5 chromosomes with non-null values).  
WITH freq AS (
  SELECT cc."Chr",
         SUM(CASE WHEN cc."Type" = 'Gain' THEN 1 ELSE 0 END)::FLOAT
           / COUNT(*) AS "freq_gain",
         SUM(CASE WHEN cc."Type" = 'Loss' THEN 1 ELSE 0 END)::FLOAT
           / COUNT(*) AS "freq_loss"
  FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cc
  JOIN   "MITELMAN"."PROD"."CYTOGEN"        cg
    ON   cc."RefNo" = cg."RefNo"
  WHERE  cg."Morph" = '3111'
    AND  cg."Topo"  = '0401'
  GROUP  BY cc."Chr"
)
SELECT CORR("freq_gain","freq_loss") AS "gain_loss_corr"
FROM   freq
HAVING COUNT(*) >= 5;
```

