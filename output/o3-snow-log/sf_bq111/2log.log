--Description: Produce a per-chromosome wide-format (“pivot”) table of the four aberration
--             types for breast-cancer cases (Morph = 3111, Topo = 0401).  Uses Snowflake
--             PIVOT; columns for aberration types that are absent will be returned as NULL.
SELECT *
FROM (
       SELECT cc."Chr",
              cc."Type",
              COUNT(*) AS "cnt"
       FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cc
       JOIN   "MITELMAN"."PROD"."CYTOGEN"        cg
         ON   cc."RefNo" = cg."RefNo"
       WHERE  cg."Morph" = '3111'
         AND  cg."Topo"  = '0401'
       GROUP  BY cc."Chr",
                 cc."Type"
     )
PIVOT (
       SUM("cnt") FOR "Type"
       IN ('Amplification', 'Gain', 'Loss', 'Deletion')
     ) AS "pvt"
LIMIT 20
