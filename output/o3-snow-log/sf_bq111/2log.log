--Description:
--  Task: display a non-redundant list of recurrent numerical copy-number abnormalities
--        observed in breast-cancer cases within the Mitelman database.
--
--  Reasoning:
--    1. Narrow the RECURRENTNUMDATA table to rows whose morphology code is ‘3111’
--       (breast carcinoma) and topography code is ‘0401’ (breast tissue).
--    2. The table’s schema does NOT include “RefNo”; the identifying columns are
--       “Chromosome”, “Abnormality”, “Morph”, “Topo”, etc.  We therefore select the
--       columns that truly exist.
--    3. DISTINCT removes duplicate chromosome/abnormality pairs that might appear
--       multiple times for different Morph/Topo combinations.
--    4. LIMIT 20 is added so the query returns a small preview rather than the
--       entire set, which facilitates interactive validation in Snowflake.
SELECT DISTINCT
       r."Chromosome",
       r."Abnormality",
       r."Morph",
       r."Topo"
FROM   "MITELMAN"."PROD"."RECURRENTNUMDATA" r
WHERE  r."Morph" = '3111'
  AND  r."Topo"  = '0401'
LIMIT 20;
