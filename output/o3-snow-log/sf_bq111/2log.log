--Description: Compute the Pearson correlation between gain and loss frequencies
--             across chromosomes for breast-cancer cases (Morph = 3111, Topo = 0401).
WITH freq AS (
  SELECT cc."Chr",
         SUM(CASE WHEN cc."Type" = 'Gain' THEN 1 ELSE 0 END)::FLOAT / COUNT(*) AS "freq_gain",
         SUM(CASE WHEN cc."Type" = 'Loss' THEN 1 ELSE 0 END)::FLOAT / COUNT(*) AS "freq_loss"
  FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cc
  JOIN   "MITELMAN"."PROD"."CYTOGEN"        cg
    ON   cc."RefNo" = cg."RefNo"
  WHERE  cg."Morph" = '3111'
    AND  cg."Topo"  = '0401'
  GROUP  BY cc."Chr"
)
SELECT CORR("freq_gain", "freq_loss") AS "gain_loss_corr"
FROM   freq
QUALIFY (SELECT COUNT(*) FROM freq) >= 5
