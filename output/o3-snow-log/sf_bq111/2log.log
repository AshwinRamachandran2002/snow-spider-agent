       SUM(CASE WHEN cc."Type" = 'Amplification' THEN 1 ELSE 0 END)
         / COUNT(*)::FLOAT AS "freq_amp",
       SUM(CASE WHEN cc."Type" = 'Gain'          THEN 1 ELSE 0 END)
         / COUNT(*)::FLOAT AS "freq_gain",
       SUM(CASE WHEN cc."Type" = 'Loss'          THEN 1 ELSE 0 END)
         / COUNT(*)::FLOAT AS "freq_loss",
       SUM(CASE WHEN cc."Type" = 'Deletion'      THEN 1 ELSE 0 END)
         / COUNT(*)::FLOAT AS "freq_del"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cc
JOIN   "MITELMAN"."PROD"."CYTOGEN"        cg
  ON   cc."RefNo" = cg."RefNo"
WHERE  cg."Morph" = '3111'
  AND  cg."Topo"  = '0401'
