```sql
--Description: Produce a per-chromosome wide-format (“pivot”) table of the four aberration
--             types for breast-cancer cases (Morph = 3111, Topo = 0401).  Uses Snowflake
--             PIVOT; columns for aberration types that are absent will be returned as NULL.
SELECT *
FROM (
       SELECT cc."Chr",
              cc."Type",
              COUNT(*) AS "cnt"
       FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cc
       JOIN   "MITELMAN"."PROD"."CYTOGEN"        cg
         ON   cc."RefNo" = cg."RefNo"
       WHERE  cg."Morph" = '3111'
         AND  cg."Topo"  = '0401'
       GROUP  BY cc."Chr",
                 cc."Type"
     )
PIVOT (
       SUM("cnt") FOR "Type"
       IN ('Amplification', 'Gain', 'Loss', 'Deletion')
     ) AS "pvt"
LIMIT 20;
```

```sql
--Description: Compute the Pearson correlation between gain and loss frequencies
--             across chromosomes for breast-cancer cases (Morph = 3111, Topo = 0401).
WITH freq AS (
  SELECT cc."Chr",
         SUM(CASE WHEN cc."Type" = 'Gain' THEN 1 ELSE 0 END)::FLOAT / COUNT(*) AS "freq_gain",
         SUM(CASE WHEN cc."Type" = 'Loss' THEN 1 ELSE 0 END)::FLOAT / COUNT(*) AS "freq_loss"
  FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cc
  JOIN   "MITELMAN"."PROD"."CYTOGEN"        cg
    ON   cc."RefNo" = cg."RefNo"
  WHERE  cg."Morph" = '3111'
    AND  cg."Topo"  = '0401'
  GROUP  BY cc."Chr"
)
SELECT CORR("freq_gain", "freq_loss") AS "gain_loss_corr"
FROM   freq
QUALIFY (SELECT COUNT(*) FROM freq) >= 5;  -- ensure at least 5 chromosomes
```

