                            ("n" - 2) / 2.0,
                            0.5 ) )
        END                                         AS "P_Value"
    FROM corr_stats
)

SELECT
    "Aberration_Type",
    "Correlation_Coefficient",
    "P_Value"
FROM final
ORDER BY "Aberration_Type";
