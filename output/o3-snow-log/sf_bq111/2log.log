```sql
--Description:
--  Compute the Pearson correlation between chromosome-level gain- and loss-frequencies
--  in breast-cancer cases (Morph = 3111, Topo = 0401), returning the value only if
--  at least five chromosomes contribute to the calculation.
--
--  • freq CTE:  for every chromosome, calculate
--        freq_gain = (# Gain rows) / total rows
--        freq_loss = (# Loss rows) / total rows
--  • subquery :  apply Snowflake’s CORR() on these two columns and count how many
--                chromosomes were available (chr_cnt).
--  • outer SELECT: emit the correlation when chr_cnt ≥ 5.
WITH freq AS (
  SELECT
      cc."Chr",
      SUM(CASE WHEN cc."Type" = 'Gain' THEN 1 END)::FLOAT / COUNT(*) AS "freq_gain",
      SUM(CASE WHEN cc."Type" = 'Loss' THEN 1 END)::FLOAT / COUNT(*) AS "freq_loss"
  FROM "MITELMAN"."PROD"."CYTOCONVERTED" cc
  JOIN "MITELMAN"."PROD"."CYTOGEN"       cg
    ON cc."RefNo" = cg."RefNo"
  WHERE cg."Morph" = '3111'
    AND cg."Topo"  = '0401'
  GROUP BY cc."Chr"
)
SELECT sub."gain_loss_corr"
FROM (
  SELECT
      CORR("freq_gain", "freq_loss") AS "gain_loss_corr",
      COUNT(*)                       AS "chr_cnt"
  FROM freq
) sub
WHERE sub."chr_cnt" >= 5;
```
