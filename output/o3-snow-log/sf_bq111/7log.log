Sample rows:
[{'RefNo': 14318, 'CaseNo': '6', 'InvNo': 3, 'KaryLength': 256, 'KaryShort': '46,XY,der(8)t(8;9)(p22;p24)t(8;22)(q24;q11),der(9)t(8;9)(p21;p24)x2,der(21)t(1;21)(q21;p11),der(22)t(8;22)(q24;q11)/46,XY,der(8)t(8;9)(p22;p24)t(8;22)(q24;q11),der(9)t(8;9)(p21;p24)x2,der(21)t(1;21)(q21;p11),der(22)t(8;22)(q24;q11),der(16)t(16;22)(q24;q11', 'KaryLong': '46,XY,der(8)t(8;9)(p22;p24)t(8;22)(q24;q11),der(9)t(8;9)(p21;p24)x2,der(21)t(1;21)(q21;p11),der(22)t(8;22)(q24;q11)/46,XY,der(8)t(8;9)(p22;p24)t(8;22)(q24;q11),der(9)t(8;9)(p21;p24)x2,der(21)t(1;21)(q21;p11),der(22)t(8;22)(q24;q11),der(16)t(16;22)(q24;q11)', 'Message': 'Has been altered', 'Reason': ' ', 'CytoConvInput': '46,XY,der(8)t(8;9)(p22;p24)t(8;22)(q24;q11),der(9)t(8;9)(p21;p24)x2,der(21)t(1;21)(q21;p11),der(22)t(8;22)(q24;q11)/46,XY,der(8)t(8;9)(p22;p24)t(8;22)(q24;q11),der(9)t(8;9)(p21;p24)x2,der(21)t(1;21)(q21;p11),der(22)t(8;22)(q24;q11),der(16)t(16;22)(q24;q11)'}, {'RefNo': 11275, 'CaseNo': '1', 'InvNo': 1, 'KaryLength': 0, 'KaryShort': ' ', 'KaryLong': ' ', 'Message': 'Original', 'Reason': ' ', 'CytoConvInput': ' '}, {'RefNo': 7355, 'CaseNo': '1', 'InvNo': 1, 'KaryLength': 0, 'KaryShort': ' ', 'KaryLong': ' ', 'Message': 'Original', 'Reason': ' ', 'CytoConvInput': ' '}, {'RefNo': 12035, 'CaseNo': '7', 'InvNo': 1, 'KaryLength': 0, 'KaryShort': ' ', 'KaryLong': ' ', 'Message': 'Original', 'Reason': ' ', 'CytoConvInput': ' '}, {'RefNo': 1625, 'CaseNo': '90', 'InvNo': 1, 'KaryLength': 0, 'KaryShort': ' ', 'KaryLong': ' ', 'Message': 'Original', 'Reason': ' ', 'CytoConvInput': ' '}]

