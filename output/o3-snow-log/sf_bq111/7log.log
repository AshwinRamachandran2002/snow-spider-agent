        "CYTOBAND_NAME"              AS cytoband_name,
        "FREQ_AMP"                   AS freq_amp,
        "FREQ_GAIN"                  AS freq_gain,
        "FREQ_HOMODEL"               AS freq_homodel,
        "FREQ_HETERODEL"             AS freq_heterodel
    FROM   TCGA.PUBLIC.BRCA_CNV_CYTOBAND_FREQUENCY
),

tcga_unpivot AS (                 -- convert wide table to long format
    SELECT chromosome, cytoband_name, 'Amp'  AS aberr_type, freq_amp  AS tcga_freq
    FROM   tcga_src
    UNION ALL
    SELECT chromosome, cytoband_name, 'Gain', freq_gain                       FROM tcga_src
    UNION ALL
    SELECT chromosome, cytoband_name, 'Loss', (freq_homodel + freq_heterodel) FROM tcga_src
    UNION ALL
    SELECT chromosome, cytoband_name, 'Del',  freq_homodel                    FROM tcga_src
),

joined AS (                       -- Mitelman + TCGA matched rows
    SELECT
        m.chromosome,
        m.cytoband_name,
        m.aberr_type,
        m.mitelman_freq,
        t.tcga_freq
    FROM   mitelman_freq m
           INNER JOIN tcga_unpivot t
                ON  m.chromosome    = t.chromosome
               AND m.cytoband_name = t.cytoband_name
               AND m.aberr_type    = t.aberr_type
),

corr_per_chr AS (                 -- Pearson correlation per chromosome/type
    SELECT
        chromosome,
        aberr_type,
        COUNT(*)                               AS n_bands,
        CORR(mitelman_freq, tcga_freq)         AS pearson_r
    FROM   joined
    GROUP BY chromosome, aberr_type
)

SELECT
    chromosome,
    aberr_type                            AS "ABERRATION_TYPE",
    pearson_r                             AS "PEARSON_R",
    -- two-tailed p-value for correlation
    T_DIST(
        ABS(
            pearson_r * SQRT( (n_bands - 2)
                              / NULLIF(1 - POWER(pearson_r, 2), 0) )
        ),
        n_bands - 2,
        2
    )                                     AS "P_VALUE"
FROM   corr_per_chr
WHERE  n_bands >= 5                       -- ensure ≥5 matched cytobands
ORDER  BY aberr_type, chromosome;
