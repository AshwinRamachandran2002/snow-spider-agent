FROM MITELMAN.PROD.KARYBREAK
WHERE ("RefNo", "CaseNo") IN (
      SELECT DISTINCT "RefNo", "CaseNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401')
LIMIT 20;
```

