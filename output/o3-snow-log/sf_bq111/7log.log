FROM MITELMAN.PROD.CYTOGEN
WHERE "Morph" = '3111'
  AND "Topo"  = '0401'
LIMIT 20;
```

```sql
-- Description:  Retrieve Mitelman karyotype investigations matching the filtered breast-carcinoma cohort. 
SELECT "RefNo", "CaseNo", "InvNo", "Tissue", "Clones", "KaryShort"
FROM MITELMAN.PROD.CYTOGENINV
WHERE ("RefNo", "CaseNo") IN (
      SELECT DISTINCT "RefNo", "CaseNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401')
LIMIT 20;
```

```sql
