```sql
/*-------------------------------------------------------------
  Pearson correlation (Mitelman vs TCGA) of copy-number events
  for breast-carcinoma (morph = 3111, topo = 0401)
  -------------------------------------------------------------
   – Four aberration types are considered:  Amp, Gain, Loss, Del
   – Frequencies are calculated per cytoband for Mitelman cases,
     then paired with the corresponding TCGA cytoband frequencies
   – Correlation (r) and two-tailed p-values are returned for every
     chromosome / aberration-type combination that has at least
     5 matching cytobands
 ----------------------------------------------------------------*/

WITH mitelman_cases AS (           -- cohort definition
    SELECT DISTINCT "RefNo", "CaseNo"
    FROM   MITELMAN.PROD.CYTOGEN
    WHERE  "Morph" = '3111'
      AND  "Topo"  = '0401'
),

mitelman_aberr AS (               -- raw CNV calls for the cohort
    SELECT
        c."RefNo",
        c."CaseNo",
        c."Chr"      AS chromosome,
        c."Start"    AS start_pos,
        c."End"      AS end_pos,
        c."Type"     AS aberr_type
    FROM   MITELMAN.PROD.CYTOCONVERTED c
           INNER JOIN mitelman_cases mc
                ON  mc."RefNo"  = c."RefNo"
                AND mc."CaseNo" = c."CaseNo"
    WHERE  c."Type" IN ('Amp','Gain','Loss','Del')
),

band_overlap AS (                 -- map events to cytobands
    SELECT
        b."chromosome",
        b."cytoband_name",
        a."aberr_type",
        a."RefNo",
        a."CaseNo"
    FROM   mitelman_aberr a
           INNER JOIN MITELMAN.PROD.CYTOBANDS_HG38 b
                ON  a.chromosome = b."chromosome"
                AND a.start_pos  < b."hg38_stop"
                AND a.end_pos    > b."hg38_start"
),

band_counts AS (                  -- per-band case counts
    SELECT
        chromosome,
        cytoband_name,
        aberr_type,
        COUNT(DISTINCT CONCAT(RefNo,'_',CaseNo)) AS case_cnt
    FROM   band_overlap
    GROUP  BY chromosome, cytoband_name, aberr_type
),

total_mitelman_cases AS (
    SELECT COUNT(DISTINCT CONCAT("RefNo",'_',"CaseNo")) AS tot_cases
    FROM   mitelman_cases
),

mitelman_freq AS (                -- Mitelman frequencies per band
    SELECT
        bc.chromosome,
        bc.cytoband_name,
        bc.aberr_type,
        bc.case_cnt / NULLIF((SELECT tot_cases FROM total_mitelman_cases),0) 
            AS mitelman_freq
    FROM   band_counts bc
),

/*-------------------------------------------------------------
  TCGA cytoband frequency table
  (replace TCGA.PUBLIC.CNV_CYTOBAND_FREQUENCY with the actual
   table that holds these values in your environment)
 ----------------------------------------------------------------*/
tcga_unpivot AS (
    SELECT chromosome, cytoband_name, 'Amp'  AS aberr_type, freq_amp  AS tcga_freq
    FROM   TCGA.PUBLIC.CNV_CYTOBAND_FREQUENCY
    UNION ALL
    SELECT chromosome, cytoband_name, 'Gain', 'freq_gain', freq_gain  FROM TCGA.PUBLIC.CNV_CYTOBAND_FREQUENCY
    UNION ALL
    SELECT chromosome, cytoband_name, 'Loss', 'freq_loss', freq_loss  FROM TCGA.PUBLIC.CNV_CYTOBAND_FREQUENCY
    UNION ALL
    SELECT chromosome, cytoband_name, 'Del',  'freq_del',  freq_del   FROM TCGA.PUBLIC.CNV_CYTOBAND_FREQUENCY
),

joined AS (                       -- pair Mitelman & TCGA frequencies
    SELECT
        m.chromosome,
        m.cytoband_name,
        m.aberr_type,
        m.mitelman_freq,
        t.tcga_freq
    FROM   mitelman_freq m
           INNER JOIN tcga_unpivot t
                ON  m.chromosome     = t.chromosome
                AND m.cytoband_name  = t.cytoband_name
                AND m.aberr_type     = t.aberr_type
),

corr_per_chr AS (                 -- correlation by chromosome & type
    SELECT
        chromosome,
        aberr_type,
        COUNT(*)                                    AS n_bands,
        CORR(mitelman_freq, tcga_freq)              AS corr_coef
    FROM   joined
    GROUP  BY chromosome, aberr_type
)

SELECT
    chromosome,
    aberr_type                     AS "ABERRATION_TYPE",
    corr_coef                      AS "PEARSON_R",
    T_DIST(
        ABS(
            corr_coef * SQRT( (n_bands - 2)
                              / NULLIF(1 - POWER(corr_coef, 2), 0) )
        ),
        n_bands - 2,
        2                          -- two-tailed p-value
    )                              AS "P_VALUE"
FROM   corr_per_chr
WHERE  n_bands >= 5                -- only keep well-represented groups
ORDER BY aberr_type, chromosome;
```
