```sql
/*=====================================================================
  Pearson correlation, by chromosome, between Mitelman copy-number
  aberration (CNA) frequencies for breast cancer (Morph = 3111,
  Topo = 0401) and TCGA-BRCA CNA frequencies.

  Aberration types compared
    • Amplification   : Mitelman “Gain”   vs TCGA Amplification (seg_mean ≥ 0.9)
    • Gain            : Mitelman “Gain”   vs TCGA Gain          (0.1 ≤ seg_mean < 0.9)
    • HomoDeletion    : Mitelman “Loss”   vs TCGA HomoDel       (seg_mean ≤ –0.9)
    • HeteroDeletion  : Mitelman “Loss”   vs TCGA HeteroDel     (–0.9 < seg_mean ≤ –0.1)

  Requirements
    • Use only records with ≥ 5 matching cytobands when producing
      chromosome–level correlations.
    • Two-tailed p-values are derived from Fisher’s z-transform.
======================================================================*/
WITH ------------------------------------------------------------------
/*----------  1.  Mitelman cohort definition  ------------------------*/
bc_cases AS (    /* breast-cancer cases: Morph 3111 / Topo 0401 */
    SELECT DISTINCT "RefNo", "CaseNo"
    FROM   MITELMAN.PROD.CYTOGEN
    WHERE  "Morph" = '3111'
      AND  "Topo"  = '0401'
),
total_mitel_cases AS (
    SELECT COUNT(*) AS n_mitel_cases FROM bc_cases
),
/*----------  2.  Mitelman CNV events & mapping to cytobands  --------*/
mitel_events AS (
    SELECT c."RefNo",
           c."CaseNo",
           c."Chr"         AS chromosome,     /* e.g. chr14 */
           c."Type"        AS cnv_type,       /* Gain / Loss */
           c."Start",
           c."End"
    FROM   MITELMAN.PROD.CYTOCONVERTED c
    JOIN   bc_cases            b
      ON   b."RefNo"  = c."RefNo"
     AND   b."CaseNo" = c."CaseNo"
    WHERE  c."Type" IN ('Gain','Loss')
),
mitel_band_counts AS (
    SELECT  m.chromosome,
            b."cytoband_name",
            m.cnv_type,                                   /* Gain / Loss */
            COUNT(DISTINCT CONCAT(m."RefNo",'-',m."CaseNo")) AS case_cnt
    FROM    mitel_events              m
    JOIN    MITELMAN.PROD.CYTOBANDS_HG38 b
      ON    b."chromosome"  = m.chromosome
     AND    m."Start"       <= b."hg38_stop"
     AND    m."End"         >= b."hg38_start"
    GROUP BY m.chromosome, b."cytoband_name", m.cnv_type
),
mitel_band_freq AS (
    SELECT  mb.chromosome,
            mb."cytoband_name",
            mb.cnv_type,
            mb.case_cnt / NULLIF(t.n_mitel_cases,0)::FLOAT AS mitel_freq   /* 0–1 */
    FROM   mitel_band_counts mb
    CROSS  JOIN total_mitel_cases t
),
/*----------  3.  TCGA-BRCA sample set & CNA calls -------------------*/
tcga_samples AS (           /* distinct BRCA samples in TCGA */
    SELECT DISTINCT SAMPLE_BARCODE
    FROM   TCGA.PUBLIC.COPY_NUMBER_SEGMENT
    WHERE  PROJECT_SHORT_NAME = 'TCGA-BRCA'
),
total_tcga_samples AS (
    SELECT COUNT(*) AS n_tcga_samples FROM tcga_samples
),
tcga_segments AS (          /* classify segments by CNA category */
    SELECT
        s.SAMPLE_BARCODE           AS sample,
        CONCAT('chr', s.CHROMOSOME) AS chromosome,        /* ensure 'chr1' */
        s.START_POSITION           AS seg_start,
        s.END_POSITION             AS seg_end,
        CASE
            WHEN s.SEGMENT_MEAN >=  0.9  THEN 'Amp'         /* high-level gain */
            WHEN s.SEGMENT_MEAN >=  0.1  THEN 'Gain'        /* low-level gain  */
            WHEN s.SEGMENT_MEAN <= -0.9  THEN 'HomoDel'     /* deep deletion   */
            WHEN s.SEGMENT_MEAN <= -0.1  THEN 'HeteroDel'   /* shallow delete  */
        END                            AS tcga_cnv_type
    FROM   TCGA.PUBLIC.COPY_NUMBER_SEGMENT s
    JOIN   tcga_samples t
      ON   t.SAMPLE_BARCODE = s.SAMPLE_BARCODE
    WHERE  s.SEGMENT_MEAN NOT BETWEEN -0.1 AND 0.1          /* ignore neutral */
),
tcga_band_counts AS (       /* unique sample counts per band/type */
    SELECT  ts.chromosome,
            b."cytoband_name",
            ts.tcga_cnv_type,
            COUNT(DISTINCT ts.sample) AS sample_cnt
    FROM    tcga_segments          ts
    JOIN    MITELMAN.PROD.CYTOBANDS_HG38 b
      ON    b."chromosome"  = ts.chromosome
     AND    ts.seg_start    <= b."hg38_stop"
     AND    ts.seg_end      >= b."hg38_start"
    GROUP BY ts.chromosome, b."cytoband_name", ts.tcga_cnv_type
),
tcga_band_freq AS (         /* convert to frequencies (0–1) */
    SELECT  tb.chromosome,
            tb."cytoband_name",
            tb.tcga_cnv_type,
            tb.sample_cnt / NULLIF(t.n_tcga_samples,0)::FLOAT  AS tcga_freq
    FROM   tcga_band_counts tb
    CROSS  JOIN total_tcga_samples t
),
/*----------  4.  Combine Mitelman & TCGA frequencies ---------------*/
combined AS (
    SELECT
        cband.chromosome,
        cband."cytoband_name",
        COALESCE(m.mitel_freq, 0)  AS mitel_gain,
        COALESCE(l.mitel_freq, 0)  AS mitel_loss,
        COALESCE(a.tcga_freq , 0)  AS tcga_amp,
        COALESCE(g.tcga_freq , 0)  AS tcga_gain,
        COALESCE(h.tcga_freq , 0)  AS tcga_homodel,
        COALESCE(d.tcga_freq , 0)  AS tcga_heterodel
    FROM (                           /* all cytobands seen in either dataset */
          SELECT DISTINCT chromosome, "cytoband_name"
          FROM   MITELMAN.PROD.CYTOBANDS_HG38
         ) cband
    /* Mitelman Gain & Loss */
    LEFT JOIN mitel_band_freq m
           ON m.chromosome = cband.chromosome
          AND m."cytoband_name" = cband."cytoband_name"
          AND m.cnv_type = 'Gain'
    LEFT JOIN mitel_band_freq l
           ON l.chromosome = cband.chromosome
          AND l."cytoband_name" = cband."cytoband_name"
          AND l.cnv_type = 'Loss'
    /* TCGA categories */
    LEFT JOIN tcga_band_freq a
           ON a.chromosome = cband.chromosome
          AND a."cytoband_name" = cband."cytoband_name"
          AND a.tcga_cnv_type = 'Amp'
    LEFT JOIN tcga_band_freq g
           ON g.chromosome = cband.chromosome
          AND g."cytoband_name" = cband."cytoband_name"
          AND g.tcga_cnv_type = 'Gain'
    LEFT JOIN tcga_band_freq h
           ON h.chromosome = cband.chromosome
          AND h."cytoband_name" = cband."cytoband_name"
          AND h.tcga_cnv_type = 'HomoDel'
    LEFT JOIN tcga_band_freq d
           ON d.chromosome = cband.chromosome
          AND d."cytoband_name" = cband."cytoband_name"
          AND d.tcga_cnv_type = 'HeteroDel'
),
/*----------  5.  Correlation (Pearson) per chromosome/type --------*/
corr_stats AS (
    SELECT
        chromosome,
        'Amplification'      AS aberration_type,
        COUNT(*)             AS n,
        CORR(mitel_gain , tcga_amp)        AS r
    FROM combined
    GROUP BY chromosome

    UNION ALL
    SELECT
        chromosome,
        'Gain',
        COUNT(*),
        CORR(mitel_gain , tcga_gain)
    FROM combined
    GROUP BY chromosome

    UNION ALL
    SELECT
        chromosome,
        'HomoDeletion',
        COUNT(*),
        CORR(mitel_loss , tcga_homodel)
    FROM combined
    GROUP BY chromosome

    UNION ALL
    SELECT
        chromosome,
        'HeteroDeletion',
        COUNT(*),
        CORR(mitel_loss , tcga_heterodel)
    FROM combined
    GROUP BY chromosome
),
/*----------  6.  Add two-tailed p-values (Fisher z) ---------------*/
final AS (
    SELECT
        chromosome               AS "Chromosome",
        aberration_type          AS "Aberration_Type",
        r                        AS "Pearson_r",
        CASE
            WHEN n < 5 OR r IS NULL OR ABS(r) = 1 THEN NULL
            ELSE 1 - ERF( ABS(0.5 * LN((1+r)/(1-r)) * SQRT(n-3)) / SQRT(2) )
        END                     AS "P_value",
        n                        AS "Matched_Bands"
    FROM   corr_stats
    WHERE  n >= 5
)
SELECT *
FROM   final
ORDER BY "Chromosome", "Aberration_Type";
