Query:
--Description: 4) Count Mitelman CytoConverter events for the cohort, grouped by
--              chromosome and CNV type.
SELECT
  c."Chr"  AS "Chromosome",
  c."Type" AS "CNV_Type",
  COUNT(*) AS "Total_Events"
FROM MITELMAN.PROD.CYTOCONVERTED c
JOIN (
      SELECT DISTINCT "RefNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401'
     ) bc
  ON c."RefNo" = bc."RefNo"
GROUP BY c."Chr", c."Type"
ORDER BY c."Chr", c."Type"
LIMIT 20
