    FROM   tcga_band_freq t
    LEFT JOIN mitel_band_freq m
      ON   m.chromosome      = t.chromosome
     AND   m."cytoband_name" = t."cytoband_name"
),
/* ----------  One row per cytoband with all freq columns ------- */
pivoted AS (
    SELECT  chromosome,
            "cytoband_name",
            MAX(CASE WHEN cnv_type = 'Gain'  THEN mitel_freq END) AS mitel_gain,
            MAX(CASE WHEN cnv_type = 'Loss'  THEN mitel_freq END) AS mitel_loss,
            MAX(tcga_amp)        AS tcga_amp,
            MAX(tcga_gain)       AS tcga_gain,
            MAX(tcga_homodel)    AS tcga_homodel,
            MAX(tcga_heterodel)  AS tcga_heterodel
    FROM   combined
    GROUP BY chromosome, "cytoband_name"
),
/* ----------  Correlation per chromosome / aberration type ----- */
corr_stats AS (
    SELECT  chromosome,
            'Amplification'  AS aberration_type,
            COUNT(*)         AS n,
            CORR(mitel_gain , tcga_amp)       AS r
    FROM   pivoted
    GROUP BY chromosome

    UNION ALL

    SELECT  chromosome,
            'Gain',
            COUNT(*),
            CORR(mitel_gain , tcga_gain)
    FROM   pivoted
    GROUP BY chromosome

    UNION ALL

    SELECT  chromosome,
            'HomoDeletion',
            COUNT(*),
            CORR(mitel_loss , tcga_homodel)
    FROM   pivoted
    GROUP BY chromosome

    UNION ALL

    SELECT  chromosome,
            'HeteroDeletion',
            COUNT(*),
            CORR(mitel_loss , tcga_heterodel)
    FROM   pivoted
    GROUP BY chromosome
),
/* ----------  Add two-tailed p-values (Fisher z) --------------- */
final AS (
    SELECT  chromosome                    AS "Chromosome",
            aberration_type              AS "Aberration_Type",
            r                            AS "Pearson_r",
            CASE
                WHEN n < 5 OR r IS NULL OR ABS(r) = 1 THEN NULL
                ELSE 1 - ERF(ABS(0.5 * LN((1+r)/(1-r)) * SQRT(n-3)) / SQRT(2))
            END                         AS "P_value",
            n                            AS "Matched_Bands"
    FROM   corr_stats
    WHERE  n >= 5
)
SELECT *
FROM   final
ORDER BY "Chromosome", "Aberration_Type";
