```sql
--Description: 1) Inspect CYTOGEN cases that match the requested morphology ('3111') 
--              and topography ('0401') codes.
SELECT 
  "RefNo",
  "CaseNo",
  "InvNo",
  "Morph",
  "Topo",
  "Age",
  "Sex"
FROM MITELMAN.PROD.CYTOGEN
WHERE "Morph" = '3111'
  AND "Topo"  = '0401'
LIMIT 20;
```

```sql
--Description: 2) Retrieve the distinct set of reference numbers for the breast-cancer
--              cohort that will later be matched to copy-number data.
SELECT DISTINCT 
  "RefNo"
FROM MITELMAN.PROD.CYTOGEN
WHERE "Morph" = '3111'
  AND "Topo"  = '0401'
LIMIT 20;
```

```sql
--Description: 3) Preview CytoConverter output (gain / loss calls) that belong to the
--              references identified above.
SELECT 
  c."RefNo",
  c."CaseNo",
  c."InvNo",
  c."Clone",
  c."Chr"            AS "Chromosome",
  c."Type"           AS "CNV_Type",
  c."Start",
  c."End"
FROM MITELMAN.PROD.CYTOCONVERTED   c
JOIN (
      SELECT DISTINCT "RefNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401'
     ) bc
  ON c."RefNo" = bc."RefNo"
LIMIT 20;
```

```sql
--Description: 4) Aggregate the Mitelman CytoConverter calls for this cohort,
--              counting how many gains / losses per chromosome.
SELECT 
  c."Chr"                       AS "Chromosome",
  c."Type"                      AS "CNV_Type",
  COUNT(*)                      AS "Total_Events"
FROM MITELMAN.PROD.CYTOCONVERTED c
JOIN (
      SELECT DISTINCT "RefNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401'
     ) bc
  ON c."RefNo" = bc."RefNo"
GROUP BY c."Chr", c."Type"
ORDER BY c."Chr", c."Type"
LIMIT 20;
```

```sql
--Description: 5) Display the cytoband table so that chromosome start/stop
--              boundaries can be matched to CNV coordinates if needed.
SELECT 
  "chromosome",
  "cytoband_name",
  "hg38_start",
  "hg38_stop"
FROM MITELMAN.PROD.CYTOBANDS_HG38
WHERE "chromosome" ILIKE '%chr1%'
LIMIT 20;
```

```sql
--Description: 6) Examine recurrent numeric aberration data that specifically
--              list total-case counts for chromosome-level gains/losses.
SELECT 
  "Chromosome",
  "Abnormality",
  "Morph",
  "Topo",
  "TotalCases"
FROM MITELMAN.PROD.RECURRENTNUMDATA
WHERE "Morph" = '3111'
  AND "Topo"  = '0401'
LIMIT 20;
```

```sql
--Description: 7) Check for possible warnings or conversion issues that were logged
--              for the breast-cancer references (helps explain missing data).
SELECT 
  l."RefNo",
  l."CaseNo",
  l."Clone",
  l."Type",
  l."Message"
FROM MITELMAN.PROD.CYTOCONVERTEDLOG  l
JOIN (
      SELECT DISTINCT "RefNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401'
     ) bc
  ON l."RefNo" = bc."RefNo"
LIMIT 20;
```

```sql
--Description: 8) Inspect the karyotype text (short form) for investigations that
--              belong to the cohort; useful for spot-checking event calls.
SELECT 
  k."RefNo",
  k."CaseNo",
  k."InvNo",
  k."KaryShort",
  k."Tissue"
FROM MITELMAN.PROD.CYTOGENINV k
JOIN (
      SELECT DISTINCT "RefNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401'
     ) bc
  ON k."RefNo" = bc."RefNo"
LIMIT 20;
```

```sql
--Description: 9) List individual “bits” of the parsed karyotype for quick
--              validation of chromosome-level abnormalities.
SELECT 
  b."RefNo",
  b."CaseNo",
  b."CloneNo",
  b."OrderNo",
  b."Bit"
FROM MITELMAN.PROD.KARYBIT  b
JOIN (
      SELECT DISTINCT "RefNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401'
     ) bc
  ON b."RefNo" = bc."RefNo"
LIMIT 20;
```

```sql
--Description: 10) Pull together Mitelman event counts alongside the total number
--               of unique cases in the cohort—one of the preparatory steps before
--               comparing against TCGA frequencies.
SELECT 
  m."Chr"                                     AS "Chromosome",
  m."Type"                                    AS "CNV_Type",
  COUNT(*)                                    AS "Event_Count",
  COUNT(DISTINCT m."CaseNo")                  AS "Unique_Cases"
FROM MITELMAN.PROD.CYTOCONVERTED m
JOIN (
      SELECT DISTINCT "RefNo", "CaseNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401'
     ) bc
  ON m."RefNo"  = bc."RefNo"
  AND m."CaseNo" = bc."CaseNo"
GROUP BY m."Chr", m."Type"
ORDER BY m."Chr", m."Type"
LIMIT 20;
```
