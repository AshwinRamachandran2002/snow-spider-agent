Query:
--Description: 3) Preview CytoConverter gain / loss calls linked to the breast-cancer
--              references selected above.
SELECT
  c."RefNo",
  c."CaseNo",
  c."InvNo",
  c."Clone",
  c."Chr"  AS "Chromosome",
  c."Type" AS "CNV_Type",
  c."Start",
  c."End"
FROM MITELMAN.PROD.CYTOCONVERTED c
JOIN (
      SELECT DISTINCT "RefNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401'
     ) bc
  ON c."RefNo" = bc."RefNo"
LIMIT 20
