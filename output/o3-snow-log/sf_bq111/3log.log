```sql
/*  ------------------------------------------------------------
    Pearson correlation (and p-value) between Mitelman CNV
    frequencies (morph = 3111, topo = 0401) and TCGA CNV
    frequencies, calculated per-chromosome and aberration type.
    ------------------------------------------------------------
      • Aberration types returned:
          – Amplification   :  Mitelman “Gain”   vs TCGA freq_amp
          – Gain            :  Mitelman “Gain”   vs TCGA freq_gain
          – HomoDeletion    :  Mitelman “Loss”   vs TCGA freq_homodel
          – HeteroDeletion  :  Mitelman “Loss”   vs TCGA freq_heterodel
      • Only chromosomes with ≥ 5 matching cytobands are shown.
      • p-values are two-tailed, computed from Fisher z-transform.
---------------------------------------------------------------- */
WITH bc_cases AS (           -- breast-cancer cohort (morph 3111 / topo 0401)
    SELECT DISTINCT "RefNo", "CaseNo"
    FROM   MITELMAN.PROD.CYTOGEN
    WHERE  "Morph" = '3111'
      AND  "Topo"  = '0401'
),
total_cases AS (             -- cohort size
    SELECT COUNT(*) AS total_cases
    FROM   bc_cases
),
mitel_events AS (            -- Mitelman CNV events limited to cohort
    SELECT  c."RefNo",
            c."CaseNo",
            c."Chr"      AS chromosome,          -- e.g. “chr1”
            c."Type"     AS cnv_type,            -- “Gain” / “Loss”
            c."Start",
            c."End"
    FROM    MITELMAN.PROD.CYTOCONVERTED c
    JOIN    bc_cases b
      ON    c."RefNo"  = b."RefNo"
     AND    c."CaseNo" = b."CaseNo"
    WHERE   c."Type" IN ('Gain','Loss')
),
band_overlap AS (            -- map events to cytobands
    SELECT  m.chromosome,
            b."cytoband_name",
            m.cnv_type,
            m."RefNo",
            m."CaseNo"
    FROM    mitel_events  m
    JOIN    MITELMAN.PROD.CYTOBANDS_HG38 b
      ON    b."chromosome" = m.chromosome
     AND    m."Start"      <= b."hg38_stop"
     AND    m."End"        >= b."hg38_start"
),
mitel_band_counts AS (       -- unique-case counts per cytoband & CNV type
    SELECT  chromosome,
            "cytoband_name",
            cnv_type,
            COUNT(DISTINCT CONCAT("RefNo",'-',"CaseNo")) AS case_cnt
    FROM    band_overlap
    GROUP BY chromosome, "cytoband_name", cnv_type
),
mitel_band_freq AS (         -- convert to frequency (0-1 scale)
    SELECT  m.chromosome,
            m."cytoband_name",
            m.cnv_type,
            m.case_cnt / NULLIF(t.total_cases,0)::FLOAT  AS mitel_freq
    FROM    mitel_band_counts m
    CROSS JOIN total_cases    t
),
tcga_band_freq AS (          -- TCGA cytoband-level CNV frequencies
    SELECT  LOWER("chromosome")  AS chromosome,          -- ensure “chr1…”
            "cytoband_name",
            "freq_amp"           AS tcga_amp,
            "freq_gain"          AS tcga_gain,
            "freq_homodel"       AS tcga_homodel,
            "freq_heterodel"     AS tcga_heterodel
    FROM    TCGA.PUBLIC.CNV_CYTOBAND_FREQUENCY
),
combined AS (                -- join Mitelman & TCGA on cytoband
    SELECT  t.chromosome,
            t."cytoband_name",
            COALESCE(m.mitel_freq,0)            AS mitel_freq,
            m.cnv_type,
            t.tcga_amp,
            t.tcga_gain,
            t.tcga_homodel,
            t.tcga_heterodel
    FROM    tcga_band_freq  t
    LEFT JOIN mitel_band_freq m
      ON    m.chromosome       = t.chromosome
     AND    m."cytoband_name"  = t."cytoband_name"
),
pivoted AS (                 -- one row per cytoband with all freq columns
    SELECT  chromosome,
            "cytoband_name",
            MAX(CASE WHEN cnv_type = 'Gain' THEN mitel_freq END)  AS mitel_gain,
            MAX(CASE WHEN cnv_type = 'Loss' THEN mitel_freq END)  AS mitel_loss,
            MAX(tcga_amp)        AS tcga_amp,
            MAX(tcga_gain)       AS tcga_gain,
            MAX(tcga_homodel)    AS tcga_homodel,
            MAX(tcga_heterodel)  AS tcga_heterodel
    FROM    combined
    GROUP BY chromosome, "cytoband_name"
),
corr_stats AS (              -- correlation & sample size per chromosome/type
    SELECT  chromosome,
            'Amplification'  AS aberration_type,
            COUNT(*)         AS n,
            CORR(mitel_gain , tcga_amp)        AS r
    FROM    pivoted
    GROUP BY chromosome

    UNION ALL

    SELECT  chromosome,
            'Gain'           AS aberration_type,
            COUNT(*)         AS n,
            CORR(mitel_gain , tcga_gain)       AS r
    FROM    pivoted
    GROUP BY chromosome

    UNION ALL

    SELECT  chromosome,
            'HomoDeletion'   AS aberration_type,
            COUNT(*)         AS n,
            CORR(mitel_loss , tcga_homodel)    AS r
    FROM    pivoted
    GROUP BY chromosome

    UNION ALL

    SELECT  chromosome,
            'HeteroDeletion' AS aberration_type,
            COUNT(*)         AS n,
            CORR(mitel_loss , tcga_heterodel)  AS r
    FROM    pivoted
    GROUP BY chromosome
),
final AS (                   -- add two-tailed p-value (Fisher z)
    SELECT  chromosome                     AS "Chromosome",
            aberration_type               AS "Aberration_Type",
            r                             AS "Pearson_r",
            /* Fisher z-transform p-value (two-tailed) */
            CASE 
                WHEN n < 5 OR r IS NULL OR ABS(r) = 1 THEN NULL
                ELSE 1 - ERF( ABS( 0.5 * LN( (1+r)/(1-r) ) * SQRT(n-3) ) / SQRT(2) )
            END                          AS "P_value",
            n                             AS "Matched_Bands"
    FROM    corr_stats
    WHERE   n >= 5                        -- require ≥ 5 matched cytobands
)
SELECT *
FROM   final
ORDER BY "Chromosome", "Aberration_Type";
```
