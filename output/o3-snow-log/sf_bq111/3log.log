/*===================================================================
  Pearson correlation (and p-value) between Mitelman copy-number
  aberration (CNA) frequencies for breast cancer (Morph = 3111,
  Topo = 0401) and TCGA-BRCA CNA frequencies, per chromosome and
  aberration class.  Only chromosomes with ≥ 5 matched cytobands
  are reported.  Two-tailed p-values are derived via Fisher z.
===================================================================*/
WITH
/*---------------- 1) Breast-cancer cohort in Mitelman ------------*/
bc_cases AS (
    SELECT DISTINCT "RefNo", "CaseNo"
    FROM   MITELMAN.PROD.CYTOGEN
    WHERE  "Morph" = '3111'
      AND  "Topo"  = '0401'
),
total_mitel_cases AS (
    SELECT COUNT(*) AS n_mitel_cases
    FROM   bc_cases
),
/*---------------- 2) Mitelman CNV events mapped to cytobands ------*/
mitel_events AS (
    SELECT  c."RefNo",
            c."CaseNo",
            c."Chr"      AS chromosome,          -- e.g. chr5
            c."Type"     AS cnv_type,            -- Gain / Loss
            c."Start",
            c."End"
    FROM   MITELMAN.PROD.CYTOCONVERTED c
    JOIN   bc_cases b
      ON   b."RefNo"  = c."RefNo"
     AND   b."CaseNo" = c."CaseNo"
    WHERE  c."Type" IN ('Gain','Loss')
),
mitel_band_counts AS (
    SELECT  m.chromosome,
            b."cytoband_name",
            m.cnv_type,
            COUNT(DISTINCT CONCAT(m."RefNo",'-',m."CaseNo")) AS case_cnt
    FROM   mitel_events m
    JOIN   MITELMAN.PROD.CYTOBANDS_HG38 b
      ON   b."chromosome" = m.chromosome
     AND   m."Start"      <= b."hg38_stop"
     AND   m."End"        >= b."hg38_start"
    GROUP BY m.chromosome, b."cytoband_name", m.cnv_type
),
mitel_band_freq AS (
    SELECT  mb.chromosome,
            mb."cytoband_name",
            mb.cnv_type,
            mb.case_cnt / NULLIF(t.n_mitel_cases,0)::FLOAT  AS mitel_freq
    FROM   mitel_band_counts mb
    CROSS  JOIN total_mitel_cases t
),
/*---------------- 3) TCGA-BRCA CNA calls mapped to cytobands ------*/
tcga_samples AS (
    SELECT DISTINCT "SAMPLE_BARCODE" AS sample_id
    FROM   TCGA.PUBLIC.COPY_NUMBER_SEGMENT
    WHERE  "PROJECT_SHORT_NAME" = 'TCGA-BRCA'
),
total_tcga_samples AS (
    SELECT COUNT(*) AS n_tcga_samples
    FROM   tcga_samples
),
tcga_segments AS (
    SELECT
        s."SAMPLE_BARCODE"                         AS sample_id,
        CONCAT('chr', s."CHROMOSOME")              AS chromosome,
        s."START_POSITION"                         AS seg_start,
        s."END_POSITION"                           AS seg_end,
        CASE
            WHEN s."SEGMENT_MEAN" >=  0.9  THEN 'Amp'
            WHEN s."SEGMENT_MEAN" >=  0.1  THEN 'Gain'
            WHEN s."SEGMENT_MEAN" <= -0.9  THEN 'HomoDel'
            WHEN s."SEGMENT_MEAN" <= -0.1  THEN 'HeteroDel'
        END                                        AS tcga_cnv_class
    FROM   TCGA.PUBLIC.COPY_NUMBER_SEGMENT s
    JOIN   tcga_samples t
      ON   t.sample_id = s."SAMPLE_BARCODE"
    WHERE  s."SEGMENT_MEAN" NOT BETWEEN -0.1 AND 0.1      -- exclude neutral
),
tcga_band_counts AS (
    SELECT  ts.chromosome,
            b."cytoband_name",
            ts.tcga_cnv_class,
            COUNT(DISTINCT ts.sample_id) AS sample_cnt
    FROM   tcga_segments ts
    JOIN   MITELMAN.PROD.CYTOBANDS_HG38 b
      ON   b."chromosome" = ts.chromosome
     AND   ts.seg_start   <= b."hg38_stop"
     AND   ts.seg_end     >= b."hg38_start"
    GROUP BY ts.chromosome, b."cytoband_name", ts.tcga_cnv_class
),
tcga_band_freq AS (
    SELECT  tb.chromosome,
            tb."cytoband_name",
            tb.tcga_cnv_class,
            tb.sample_cnt / NULLIF(t.n_tcga_samples,0)::FLOAT  AS tcga_freq
    FROM   tcga_band_counts tb
    CROSS  JOIN total_tcga_samples t
),
/*---------------- 4) Combine Mitelman & TCGA frequencies ----------*/
combined AS (
    SELECT
        cb.chromosome,
        cb."cytoband_name",
        COALESCE(m_gain.mitel_freq , 0) AS mitel_gain,
        COALESCE(m_loss.mitel_freq , 0) AS mitel_loss,
        COALESCE(t_amp.tcga_freq  , 0)  AS tcga_amp,
        COALESCE(t_gain.tcga_freq , 0)  AS tcga_gain,
        COALESCE(t_hdel.tcga_freq , 0)  AS tcga_homodel,
        COALESCE(t_het.tcga_freq  , 0)  AS tcga_heterodel
    FROM (SELECT DISTINCT chromosome, "cytoband_name"
          FROM   MITELMAN.PROD.CYTOBANDS_HG38) cb
    LEFT JOIN mitel_band_freq m_gain
           ON m_gain.chromosome       = cb.chromosome
          AND m_gain."cytoband_name"  = cb."cytoband_name"
          AND m_gain.cnv_type         = 'Gain'
    LEFT JOIN mitel_band_freq m_loss
           ON m_loss.chromosome       = cb.chromosome
          AND m_loss."cytoband_name"  = cb."cytoband_name"
          AND m_loss.cnv_type         = 'Loss'
    LEFT JOIN tcga_band_freq t_amp
           ON t_amp.chromosome        = cb.chromosome
          AND t_amp."cytoband_name"   = cb."cytoband_name"
          AND t_amp.tcga_cnv_class    = 'Amp'
    LEFT JOIN tcga_band_freq t_gain
           ON t_gain.chromosome       = cb.chromosome
          AND t_gain."cytoband_name"  = cb."cytoband_name"
          AND t_gain.tcga_cnv_class   = 'Gain'
    LEFT JOIN tcga_band_freq t_hdel
           ON t_hdel.chromosome       = cb.chromosome
          AND t_hdel."cytoband_name"  = cb."cytoband_name"
          AND t_hdel.tcga_cnv_class   = 'HomoDel'
    LEFT JOIN tcga_band_freq t_het
           ON t_het.chromosome        = cb.chromosome
          AND t_het."cytoband_name"   = cb."cytoband_name"
          AND t_het.tcga_cnv_class    = 'HeteroDel'
),
/*---------------- 5) Pearson correlation per chromosome -----------*/
corr_stats AS (
    SELECT  chromosome,
            'Amplification'              AS aberr_type,
            COUNT(*)                     AS n,
            CORR(mitel_gain , tcga_amp)  AS r
    FROM   combined
    GROUP  BY chromosome

    UNION ALL
    SELECT  chromosome,
            'Gain',
            COUNT(*),
            CORR(mitel_gain , tcga_gain)
    FROM   combined
    GROUP  BY chromosome

    UNION ALL
    SELECT  chromosome,
            'HomoDeletion',
            COUNT(*),
            CORR(mitel_loss , tcga_homodel)
    FROM   combined
    GROUP  BY chromosome

    UNION ALL
    SELECT  chromosome,
            'HeteroDeletion',
            COUNT(*),
            CORR(mitel_loss , tcga_heterodel)
    FROM   combined
    GROUP  BY chromosome
),
/*---------------- 6) p-values via Fisher z ------------------------*/
final AS (
    SELECT
        chromosome           AS "Chromosome",
        aberr_type           AS "Aberration_Type",
        r                    AS "Pearson_r",
        CASE
            WHEN n < 5 OR r IS NULL OR ABS(r) = 1 THEN NULL
            ELSE 1 - ERF( ABS(0.5 * LN( (1+r)/(1-r) ) * SQRT(n-3) ) / SQRT(2) )
        END                 AS "P_value",
        n                    AS "Matched_Bands"
    FROM corr_stats
    WHERE n >= 5
)
SELECT *
FROM   final
ORDER BY "Chromosome", "Aberration_Type";
