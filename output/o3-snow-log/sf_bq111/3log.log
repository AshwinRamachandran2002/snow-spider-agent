Table full name: MITELMAN.PROD.KODER
Column name: Flagga1 Type: TEXT Description: unknown field -- either blank (443 rows) or '1' (41 rows)
Column name: Kortnamn Type: TEXT Description: the 'short' name corresponding to this code, eg 'Adipo'
Column name: Benamning Type: TEXT Description: the 'long' name corresponding to this code, eg 'Vascular and perivascular tumors (all subtypes)'
Column name: Flagga4 Type: TEXT Description: this field is always blank
Column name: Inregdatum Type: TEXT Description: this field contains a date, eg 'Jul 7 2000 12:00AM' or 'Jan 9 2014 12:00AM'
Column name: GiltigTill Type: TEXT Description: this field contains a date far into the future, eg 'Dec 27 2063 12:00AM'
Column name: KodTyp Type: TEXT Description: this field indicates the type of the code -- there are 7 types: 'MORPH' (morphology), 'GEO' (geography), 'TOP' (topography), 'HER' (heredity), 'TISSUE', 'TREAT' (treatment), and 'RACE'
Column name: Aktiv Type: TEXT Description: whether or not this code is active -- almost always 'J' (yes), but is 'N' once and blank once
Column name: Intern Type: TEXT Description: whether or not this code is internal -- almost always 'J' (yes), but is 'N' once and blank once
Column name: Kod Type: TEXT Description: this field contains the 'code' which can be something like '5230' or '02' or 'O' -- there are 470 unique codes
Column name: Notering Type: TEXT Description: this field is always blank
Column name: Flagga2 Type: TEXT Description: this field is always blank
Column name: Flagga3 Type: TEXT Description: this field is always blank
