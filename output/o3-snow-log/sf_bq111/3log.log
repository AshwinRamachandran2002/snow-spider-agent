--Description: 10) Summarize Mitelman CNV events and unique case counts per chromosome
--               and CNV type for the cohort (preparation for correlation analysis).
SELECT
  m."Chr"  AS "Chromosome",
  m."Type" AS "CNV_Type",
  COUNT(*)                       AS "Event_Count",
  COUNT(DISTINCT m."CaseNo")     AS "Unique_Cases"
FROM MITELMAN.PROD.CYTOCONVERTED m
JOIN (
      SELECT DISTINCT "RefNo", "CaseNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401'
     ) bc
  ON m."RefNo"  = bc."RefNo"
  AND m."CaseNo" = bc."CaseNo"
GROUP BY m."Chr", m."Type"
ORDER BY m."Chr", m."Type"
LIMIT 20
