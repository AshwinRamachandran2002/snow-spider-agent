/*---------------------------------------------------------------
  Pearson correlations (per–chromosome / aberration-type) between
  Mitelman copy-number frequencies (Morph = 3111 , Topo = 0401)
  and TCGA–BRCA copy-number frequencies.

  Aberration types considered
        • “Amp”  (amplification / high–level gain)
        • “Gain” (low–level gain)
        • “Loss” (heterozygous loss)
        • “Del”  (homozygous deletion)

  Only chromosome / type pairs represented by ≥ 5 shared
  cytobands are reported.  P-values are computed from the
  correlation-derived t–statistic using Snowflake’s TDIST().
 ----------------------------------------------------------------*/
WITH
/*-----------------------------------------
  1)  Mitelman – breast-cancer CNV frequency
 -----------------------------------------*/
mitelman AS (
    SELECT
        cb."chromosome"                         AS "Chr",
        cb."cytoband_name"                      AS "Cytoband",
        cc."Type"                               AS "Type",
        COUNT( DISTINCT CONCAT(cc."RefNo",'_',cc."CaseNo") )
                                                AS "mitelman_freq"
    FROM  MITELMAN.PROD.CYTOCONVERTED  cc
    JOIN  MITELMAN.PROD.CYTOGEN        cg
          ON  cc."RefNo"  = cg."RefNo"
          AND cc."CaseNo" = cg."CaseNo"
    JOIN  MITELMAN.PROD.CYTOBANDS_HG38 cb
          ON  cb."chromosome" = cc."Chr"
          AND cc."Start"      < cb."hg38_stop"
          AND cc."End"        > cb."hg38_start"
    WHERE cg."Morph" = '3111'          -- breast carcinoma
      AND cg."Topo"  = '0401'          -- topography code
      AND cc."Type" IN ('Amp','Gain','Loss','Del')
    GROUP BY cb."chromosome", cb."cytoband_name", cc."Type"
),

/*-----------------------------------------
  2)  TCGA – BRCA CNV frequency per cytoband
      (table must already contain frequencies
       expressed as percentages for each type)
 -----------------------------------------*/
tcga AS (
          /*  Amplifications  */
    SELECT  "chromosome"  AS "Chr",
            "cytoband_name" AS "Cytoband",
            'Amp'           AS "Type",
            "freq_amp"      AS "tcga_freq"
    FROM    TCGA.PUBLIC.TCGA_BRCA_CNV_CYTOBAND_FREQ

    UNION ALL
          /*  Low-level gains  */
    SELECT  "chromosome", "cytoband_name", 'Gain', "freq_gain"
    FROM    TCGA.PUBLIC.TCGA_BRCA_CNV_CYTOBAND_FREQ

    UNION ALL
          /*  Heterozygous losses  */
    SELECT  "chromosome", "cytoband_name", 'Loss', "freq_heterodel"
    FROM    TCGA.PUBLIC.TCGA_BRCA_CNV_CYTOBAND_FREQ

    UNION ALL
          /*  Homozygous deletions  */
    SELECT  "chromosome", "cytoband_name", 'Del',  "freq_homodel"
    FROM    TCGA.PUBLIC.TCGA_BRCA_CNV_CYTOBAND_FREQ
),

/*-----------------------------------------
  3)  Join Mitelman & TCGA on Chr / Cytoband / Type
 -----------------------------------------*/
joined AS (
    SELECT
        m."Chr",
        m."Cytoband",
        m."Type",
        m."mitelman_freq",
        t."tcga_freq"
    FROM  mitelman m
    JOIN  tcga     t
          ON  m."Chr"      = t."Chr"
          AND m."Cytoband" = t."Cytoband"
          AND m."Type"     = t."Type"
),

/*-----------------------------------------
  4)  Correlation statistics per Chr / Type
 -----------------------------------------*/
stats AS (
    SELECT
        "Chr",
        "Type",
        CORR( "mitelman_freq", "tcga_freq" )            AS "r",
        COUNT(*)                                        AS "n_pairs"
    FROM   joined
    GROUP  BY "Chr", "Type"
    HAVING COUNT(*) >= 5                               -- ≥ 5 shared bins
)

/*-----------------------------------------
  5)  Final output with two-tailed p-values
 -----------------------------------------*/
SELECT
    "Chr",
    "Type",
    ROUND( "r", 4 )                                 AS "pearson_corr",
    ROUND(
        /*  p-value from t-distribution  */
        CASE
            WHEN ABS("r") = 1 THEN 0.0
            ELSE TDIST(
                     ABS("r") * SQRT( "n_pairs" - 2 )
                     / SQRT( 1 - POWER("r", 2) ),
                     "n_pairs" - 2,
                     2                                -- two-tailed
                 )
        END , 6 )                                   AS "p_value",
    "n_pairs"                                       AS "n_cytobands"
FROM   stats
ORDER BY "Chr", "Type";
```
