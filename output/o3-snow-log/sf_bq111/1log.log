--Description: 7) Combine Gain/Loss/Amp/Del events for breast cancer and show counts per chromosome–type pair
SELECT cc."Chr",
       cc."Type",
       COUNT(*) AS "event_cnt"
FROM MITELMAN.PROD.CYTOCONVERTED cc
JOIN MITELMAN.PROD.CYTOGEN cg
  ON cc."RefNo"  = cg."RefNo"
 AND cc."CaseNo" = cg."CaseNo"
WHERE cg."Morph" = '3111'
  AND cg."Topo"  = '0401'
  AND cc."Type" IN ('Gain','Loss','Amp','Del')
GROUP BY cc."Chr", cc."Type"
ORDER BY cc."Chr", cc."Type"
LIMIT 20
