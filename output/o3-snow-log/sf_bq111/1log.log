--Description: 9) Join CytoConverter breast-cancer events on chr 8 with cytoband definitions to verify positional overlap
SELECT cc."RefNo",
       cc."CaseNo",
       cb."cytoband_name",
       cc."Type",
       cc."Start",
       cc."End"
FROM MITELMAN.PROD.CYTOCONVERTED cc
JOIN MITELMAN.PROD.CYTOGEN cg
  ON cc."RefNo"  = cg."RefNo"
 AND cc."CaseNo" = cg."CaseNo"
JOIN MITELMAN.PROD.CYTOBANDS_HG38 cb
  ON cb."chromosome" = cc."Chr"
 AND cc."Start"      < cb."hg38_stop"
 AND cc."End"        > cb."hg38_start"
WHERE cg."Morph" = '3111'
  AND cg."Topo"  = '0401'
  AND cc."Chr"   = 'chr8'
LIMIT 20
