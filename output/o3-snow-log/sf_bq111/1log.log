```sql
--Description:  We need to confirm that CYTOGEN actually contains breast-cancer cases.
--              Breast cancer in Mitelman DB is encoded as morphology = ‘3111’ and topography = ‘0401’.
--              A quick way to verify this is to count how many rows satisfy BOTH codes and
--              also preview a few distinct values of “SpecMorph” (free-text description).
--              Note: there is no column named “SpecTopo”, so it is omitted.
SELECT 
       COUNT(*)                             AS "n_rows_matching",
       COUNT(DISTINCT cg."CaseNo")          AS "n_unique_cases",
       ARRAY_AGG(DISTINCT cg."SpecMorph")   AS "sample_specmorph_values"
FROM MITELMAN.PROD.CYTOGEN cg
WHERE cg."Morph" = '3111'
  AND cg."Topo"  = '0401';
```
