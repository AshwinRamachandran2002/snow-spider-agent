--Description: 10) Prepare a per-chromosome, per-type frequency table (breast cancer only) requiring at least 5 events
SELECT cc."Chr",
       cc."Type",
       COUNT(DISTINCT CONCAT(cc."RefNo",'_',cc."CaseNo")) AS "n_cases"
FROM MITELMAN.PROD.CYTOCONVERTED cc
JOIN MITELMAN.PROD.CYTOGEN cg
  ON cc."RefNo"  = cg."RefNo"
 AND cc."CaseNo" = cg."CaseNo"
WHERE cg."Morph" = '3111'
  AND cg."Topo"  = '0401'
  AND cc."Type" IN ('Gain','Loss','Amp','Del')
GROUP BY cc."Chr", cc."Type"
HAVING COUNT(*) >= 5
ORDER BY cc."Chr", cc."Type"
LIMIT 20
