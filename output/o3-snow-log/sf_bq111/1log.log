/*----------------------------------------------------------------------
  Pearson correlation (per-chromosome / aberration-type) between
  Mitelman CNV frequencies (Morph = 3111 , Topo = 0401) and the
  corresponding TCGA-BRCA cytoband CNV frequencies.

  Result set is limited to chromosome / aberration-type pairs that
  share at least five cytobands in common.
 ----------------------------------------------------------------------*/
WITH
/*-------------------------------------------------
  1.  Mitelman breast-cancer CNV counts per band
 -------------------------------------------------*/
mitelman AS (
    SELECT
        cb."chromosome"            AS "chr",
        cb."cytoband_name"         AS "band",
        cc."Type"                  AS "type",
        COUNT(DISTINCT CONCAT(cc."RefNo",'_',cc."CaseNo")) 
                                   AS mitelman_freq
    FROM MITELMAN.PROD.CYTOCONVERTED  cc
    JOIN MITELMAN.PROD.CYTOGEN        cg
      ON cc."RefNo" = cg."RefNo"
     AND cc."CaseNo" = cg."CaseNo"
    JOIN MITELMAN.PROD.CYTOBANDS_HG38 cb
      ON cb."chromosome" = cc."Chr"
     AND cc."Start"      < cb."hg38_stop"
     AND cc."End"        > cb."hg38_start"
    WHERE cg."Morph" = '3111'             -- ductal / lobular breast CA
      AND cg."Topo"  = '0401'             -- breast topography code
      AND cc."Type" IN ('Amp','Gain','Loss','Del')
    GROUP BY cb."chromosome", cb."cytoband_name", cc."Type"
),

/*-------------------------------------------------
  2.  TCGA-BRCA CNV frequencies per band & type
      (percentages already pre-calculated)
 -------------------------------------------------*/
tcga AS (
          /* amplifications */
    SELECT "chromosome"  AS "chr",
           "cytoband_name" AS "band",
           'Amp'           AS "type",
           "freq_amp"      AS tcga_freq
    FROM   TCGA.PUBLIC.BRCA_CNV_CYTOBAND_FREQ

    UNION ALL
          /* gains */
    SELECT "chromosome", "cytoband_name", 'Gain', "freq_gain"
    FROM   TCGA.PUBLIC.BRCA_CNV_CYTOBAND_FREQ

    UNION ALL
          /* heterozygous losses */
    SELECT "chromosome", "cytoband_name", 'Loss', "freq_heterodel"
    FROM   TCGA.PUBLIC.BRCA_CNV_CYTOBAND_FREQ

    UNION ALL
          /* homozygous deletions */
    SELECT "chromosome", "cytoband_name", 'Del',  "freq_homodel"
    FROM   TCGA.PUBLIC.BRCA_CNV_CYTOBAND_FREQ
),

/*-------------------------------------------------
  3.  Common Mitelman/TCGA rows
 -------------------------------------------------*/
joined AS (
    SELECT
        m."chr",
        m."band",
        m."type",
        m.mitelman_freq,
        t.tcga_freq
    FROM mitelman m
    JOIN tcga     t
      ON m."chr"  = t."chr"
     AND m."band" = t."band"
     AND m."type" = t."type"
),

/*-------------------------------------------------
  4.  Correlation statistics per chr / type
 -------------------------------------------------*/
stats AS (
    SELECT
        "chr",
        "type",
        CORR(mitelman_freq , tcga_freq)     AS r,
        COUNT(*)                            AS n_pairs
    FROM joined
    GROUP BY "chr", "type"
    HAVING COUNT(*) >= 5
)

/*-------------------------------------------------
  5.  Final result with two-tailed p-value
 -------------------------------------------------*/
SELECT
    "chr"                              AS "Chr",
    "type"                             AS "Type",
    ROUND(r , 4)                       AS pearson_corr,
    ROUND(
        CASE
            WHEN ABS(r) = 1 THEN 0
            ELSE TDIST(
                     ABS(r) * SQRT(n_pairs - 2) / SQRT(1 - r * r),
                     n_pairs - 2,
                     2               -- two-tailed
                 )
        END
    , 6)                               AS p_value,
    n_pairs                            AS n_cytobands
FROM stats
ORDER BY "Chr", "Type";
```
