SELECT DISTINCT "Type"
FROM MITELMAN.PROD.CYTOCONVERTED
ORDER BY "Type"
LIMIT 20;
```

```sql
--Description: 2) Retrieve 20 CytoConverter rows (gain/loss/amp/del) that belong to breast-cancer cases (Morph = 3111, Topo = 0401)
SELECT cc."RefNo",
       cc."CaseNo",
       cc."Chr",
       cc."Type",
       cc."Start",
       cc."End"
FROM MITELMAN.PROD.CYTOCONVERTED    cc
JOIN MITELMAN.PROD.CYTOGEN          cg
  ON  cc."RefNo" = cg."RefNo"
  AND cc."CaseNo" = cg."CaseNo"
WHERE cg."Morph" = '3111'
  AND cg."Topo"  = '0401'
LIMIT 20;
```

```sql
--Description: 3) Confirm that “3111 / 0401” indeed corresponds to breast adenocarcinoma cases present in CYTOGEN
SELECT DISTINCT cg."Morph",
       cg."SpecMorph",
       cg."Topo",
       cg."SpecTopo"       -- may be NULL, shown for completeness
FROM MITELMAN.PROD.CYTOGEN cg
WHERE cg."Morph" = '3111'
  AND cg."Topo"  = '0401'
LIMIT 20;
```

```sql
--Description: 4) Show 20 rows of chromosome-level recurrent numerical data for breast cancer cases
SELECT rn."Chromosome",
       rn."Abnormality",
       rn."TotalCases",
       rn."Morph",
       rn."Topo"
FROM MITELMAN.PROD.RECURRENTNUMDATA rn
WHERE rn."Morph" = '3111'
  AND rn."Topo"  = '0401'
LIMIT 20;
```

```sql
--Description: 5) List the first 20 CytoConverter breast-cancer events aggregated as “Gain”
SELECT cc."Chr",
       COUNT(*) AS "gain_events"
FROM MITELMAN.PROD.CYTOCONVERTED cc
JOIN MITELMAN.PROD.CYTOGEN       cg
  ON  cc."RefNo" = cg."RefNo"
  AND cc."CaseNo" = cg."CaseNo"
WHERE cg."Morph" = '3111'
  AND cg."Topo"  = '0401'
  AND cc."Type"  = 'Gain'
GROUP BY cc."Chr"
ORDER BY cc."Chr"
LIMIT 20;
```

```sql
--Description: 6) Similar aggregation but for “Loss”, again breast cancer only
SELECT cc."Chr",
       COUNT(*) AS "loss_events"
FROM MITELMAN.PROD.CYTOCONVERTED cc
JOIN MITELMAN.PROD.CYTOGEN       cg
  ON  cc."RefNo" = cg."RefNo"
  AND cc."CaseNo" = cg."CaseNo"
WHERE cg."Morph" = '3111'
  AND cg."Topo"  = '0401'
  AND cc."Type"  = 'Loss'
GROUP BY cc."Chr"
ORDER BY cc."Chr"
LIMIT 20;
```

```sql
--Description: 7) Combine four CNA categories (Gain/Loss/Amp/Del) for breast cancer; see how many records each chromosome holds
SELECT cc."Chr",
       cc."Type",
       COUNT(*) AS "event_cnt"
FROM MITELMAN.PROD.CYTOCONVERTED cc
JOIN MITELMAN.PROD.CYTOGEN       cg
  ON  cc."RefNo" = cg."RefNo"
  AND cc."CaseNo" = cg."CaseNo"
WHERE cg."Morph" = '3111'
  AND cg."Topo"  = '0401'
  AND cc."Type" IN ('Gain','Loss','Amp','Del')
GROUP BY cc."Chr", cc."Type"
ORDER BY cc."Chr", cc."Type"
LIMIT 20;
```

```sql
--Description: 8) Preview hg38 cytoband boundaries for chromosome 1 that can later be merged with CytoConverter coordinates
SELECT cb."chromosome",
       cb."cytoband_name",
       cb."hg38_start",
       cb."hg38_stop"
FROM MITELMAN.PROD.CYTOBANDS_HG38 cb
WHERE cb."chromosome" = 'chr1'
ORDER BY cb."hg38_start"
LIMIT 20;
```

```sql
--Description: 9) Bring together CytoConverter events and cytoband definitions for chr 8 (breast cancer) to verify positional joins
SELECT cc."RefNo",
       cc."CaseNo",
       cb."cytoband_name",
       cc."Type",
       cc."Start",
       cc."End"
FROM MITELMAN.PROD.CYTOCONVERTED cc
JOIN MITELMAN.PROD.CYTOGEN       cg
  ON  cc."RefNo" = cg."RefNo"
  AND cc."CaseNo" = cg."CaseNo"
JOIN MITELMAN.PROD.CYTOBANDS_HG38 cb
  ON  cb."chromosome" = cc."Chr"
  AND cc."Start" < cb."hg38_stop"
  AND cc."End"   > cb."hg38_start"
WHERE cg."Morph" = '3111'
  AND cg."Topo"  = '0401'
  AND cc."Chr"   = 'chr8'
LIMIT 20;
```

```sql
--Description: 10) Example of preparing the per-chromosome, per-type frequency table needed for the Pearson correlation (breast cancer only)
SELECT cc."Chr",
       cc."Type",
       COUNT(DISTINCT CONCAT(cc."RefNo",'_',cc."CaseNo")) AS "n_cases"
FROM MITELMAN.PROD.CYTOCONVERTED cc
JOIN MITELMAN.PROD.CYTOGEN       cg
  ON  cc."RefNo" = cg."RefNo"
  AND cc."CaseNo" = cg."CaseNo"
WHERE cg."Morph" = '3111'
  AND cg."Topo"  = '0401'
  AND cc."Type" IN ('Gain','Loss','Amp','Del')
GROUP BY cc."Chr", cc."Type"
HAVING COUNT(*) >= 5          -- ensure ≥5 matching records, prerequisite for correlation
ORDER BY cc."Chr", cc."Type"
LIMIT 20;
```
