    JOIN tcga     t
      ON m."chr"  = t."chr"
     AND m."band" = t."band"
     AND m."type" = t."type"
),

/*---------------------------------------------------------
  4.  Correlation per chromosome / aberration type
---------------------------------------------------------*/
stats AS (
    SELECT
        "chr",
        "type",
        CORR(mitelman_freq , tcga_freq)  AS r,
        COUNT(*)                         AS n_pairs
    FROM joined
    GROUP BY "chr", "type"
    HAVING COUNT(*) >= 5
)

/*---------------------------------------------------------
  5.  Final report with two-tailed p-values
---------------------------------------------------------*/
SELECT
    "chr"                                           AS "Chr",
    "type"                                          AS "Type",
    ROUND(r , 4)                                    AS "pearson_corr",
    ROUND(
