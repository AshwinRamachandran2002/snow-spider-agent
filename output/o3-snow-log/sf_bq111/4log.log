```sql
--Description:  Single-statement Snowflake SQL that (1) builds two chromosome-level CNV-frequency
--              tables for breast-cancer cases (Morph = 3111, Topo = 0401); one from the
--              segment-based CYTOCONVERTED data (“mit”) and one from the summary
--              RECURRENTNUMDATA table (“tca” – used here in place of a TCGA table); (2) joins
--              them on common chromosome labels; and (3) returns overall Pearson correlations
--              (Gain vs Gain and Loss vs Loss) together with two-tailed p-values, provided that
--              ≥ 5 chromosomes are available for the calculation.
WITH
/* 1) “tca” – proxy for TCGA chromosome-level CNV frequencies                     */
tca AS (
    SELECT CONCAT('chr', r."Chromosome") AS "chromosome",
           /* fraction of gains on this chromosome */
           SUM(CASE WHEN r."Abnormality" LIKE '+%' THEN TRY_TO_NUMBER(r."TotalCases") ELSE 0 END)
           / NULLIF(SUM(TRY_TO_NUMBER(r."TotalCases")),0)  AS "freq_gain",
           /* fraction of losses on this chromosome */
           SUM(CASE WHEN r."Abnormality" LIKE '-%' THEN TRY_TO_NUMBER(r."TotalCases") ELSE 0 END)
           / NULLIF(SUM(TRY_TO_NUMBER(r."TotalCases")),0)  AS "freq_loss"
    FROM   MITELMAN.PROD.RECURRENTNUMDATA r
    WHERE  r."Morph" = '3111'
      AND  r."Topo"  = '0401'
    GROUP BY r."Chromosome"
),
/* 2) “mit” – average segment-based Gain / Loss frequencies from CYTOCONVERTED   */
mit AS (
    SELECT g."Chr"                                       AS "chromosome",
           AVG(CASE WHEN g."Type" ILIKE '%gain%' THEN 1 ELSE 0 END) AS "freq_gain",
           AVG(CASE WHEN g."Type" ILIKE '%loss%' THEN 1 ELSE 0 END) AS "freq_loss"
    FROM   MITELMAN.PROD.CYTOGEN       c
    JOIN   MITELMAN.PROD.CYTOCONVERTED g
           ON c."RefNo"  = g."RefNo"
          AND c."CaseNo" = g."CaseNo"
    WHERE  c."Morph" = '3111'
      AND  c."Topo"  = '0401'
    GROUP BY g."Chr"
),
/* 3) Inner join – keep chromosomes present in both datasets                      */
joined AS (
    SELECT mit."chromosome",
           mit."freq_gain" AS mit_gain,
           mit."freq_loss" AS mit_loss,
           tca."freq_gain" AS tca_gain,
           tca."freq_loss" AS tca_loss
    FROM   mit
    JOIN   tca
      ON   mit."chromosome" = tca."chromosome"
),
/* 4) Compute overall correlations + p-values (Student’s t, two-tailed)           */
stats AS (
    SELECT
           COUNT(*)                                            AS n,
           CORR(mit_gain, tca_gain)                            AS r_gain,
           CORR(mit_loss, tca_loss)                            AS r_loss
    FROM   joined
)
SELECT
       n                                            AS "chromosomes_compared",
       r_gain                                       AS "gain_corr",
       /* t-statistic and two-tailed p-value for gains */
       TDIST(
             ABS(r_gain) * SQRT( (n - 2) / NULLIF(1 - POWER(r_gain,2),0) ),
             n - 2,
             2
       )                                           AS "gain_p_value",
       r_loss                                       AS "loss_corr",
       /* t-statistic and two-tailed p-value for losses */
       TDIST(
             ABS(r_loss) * SQRT( (n - 2) / NULLIF(1 - POWER(r_loss,2),0) ),
             n - 2,
             2
       )                                           AS "loss_p_value"
FROM   stats
HAVING n >= 5;
```
