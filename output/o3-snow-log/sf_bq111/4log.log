```sql
/*-------------------------------------------------------------------
   Pearson correlations (two-tailed) between Mitelman-DB and TCGA
   copy-number frequencies – per chromosome and aberration class –
   for breast-cancer cases (Morph = 3111, Topo = 0401).

   TCGA frequencies are taken from the cytoband-level summary table
   TCGA_OMICS.PUBLIC.CNV_CYTOBAND_FREQ, which contains columns:
      CHROMOSOME, CYTOBAND_NAME, FREQ_AMP, FREQ_GAIN,
      FREQ_HOMODEL, FREQ_HETERODEL

   Only chromosomes with at least five matched cytobands are shown.
-------------------------------------------------------------------*/
WITH
/* 1)  Breast-cancer Mitelman (reference–case–investigation)  */
mit_cases AS (
    SELECT DISTINCT
           c."RefNo",
           c."CaseNo",
           g."InvNo"
    FROM   MITELMAN.PROD.CYTOGEN         c
    JOIN   MITELMAN.PROD.CYTOCONVERTED   g
           ON  g."RefNo"  = c."RefNo"
           AND g."CaseNo" = c."CaseNo"
    WHERE  c."Morph" = '3111'      -- breast carcinoma
      AND  c."Topo"  = '0401'      -- breast topography
),
/* 2)  Mitelman CNV calls mapped to cytobands                           */
mit_band_calls AS (
    SELECT
           b."chromosome"                  AS "CHR",
           b."cytoband_name"               AS "CYTOBAND",
           CASE
               WHEN g."Type" ILIKE '%amp%'  THEN 'AMPLIFICATION'
               WHEN g."Type" ILIKE '%gain%' THEN 'GAIN'
               WHEN g."Type" ILIKE '%loss%' THEN 'LOSS'
               WHEN g."Type" ILIKE '%del%'  THEN 'DELETION'
           END                              AS "ABERR_TYPE",
           CONCAT(g."RefNo",':',g."CaseNo",':',g."InvNo") AS "CASE_ID"
    FROM   mit_cases mc
    JOIN   MITELMAN.PROD.CYTOCONVERTED g
           ON  g."RefNo"  = mc."RefNo"
           AND g."CaseNo" = mc."CaseNo"
           AND g."InvNo"  = mc."InvNo"
    JOIN   MITELMAN.PROD.CYTOBANDS_HG38 b          -- band lookup
           ON  b."chromosome" = g."Chr"
           AND b."hg38_start" <  g."End"
           AND b."hg38_stop"  >  g."Start"
    WHERE  g."Type" IS NOT NULL
),
mit_freq AS (                     /* Mitelman cytoband-level frequencies */
    SELECT
           "CHR",
           "CYTOBAND",
           "ABERR_TYPE",
           COUNT(DISTINCT "CASE_ID")  AS "MIT_FREQ"
    FROM   mit_band_calls
    WHERE  "ABERR_TYPE" IN ('AMPLIFICATION','GAIN','LOSS','DELETION')
    GROUP BY "CHR","CYTOBAND","ABERR_TYPE"
),
/* 3)  TCGA BRCA cytoband-level frequencies (pre-computed)               */
tcga_freq AS (
    SELECT  UPPER("CHROMOSOME")  AS "CHR",
            "CYTOBAND_NAME"      AS "CYTOBAND",
            'AMPLIFICATION'      AS "ABERR_TYPE",
            "FREQ_AMP"           AS "TCGA_FREQ"
    FROM    TCGA_OMICS.PUBLIC.CNV_CYTOBAND_FREQ
    WHERE   "TOTAL" IS NOT NULL
    UNION ALL
    SELECT  UPPER("CHROMOSOME"), "CYTOBAND_NAME", 'GAIN',        "FREQ_GAIN"
    FROM    TCGA_OMICS.PUBLIC.CNV_CYTOBAND_FREQ
    UNION ALL
    SELECT  UPPER("CHROMOSOME"), "CYTOBAND_NAME", 'DELETION',    "FREQ_HOMODEL"
    FROM    TCGA_OMICS.PUBLIC.CNV_CYTOBAND_FREQ
    UNION ALL
    SELECT  UPPER("CHROMOSOME"), "CYTOBAND_NAME", 'LOSS',        "FREQ_HETERODEL"
    FROM    TCGA_OMICS.PUBLIC.CNV_CYTOBAND_FREQ
),
/* 4)  Align Mitelman and TCGA                                           */
joined AS (
    SELECT
           m."CHR",
           m."CYTOBAND",
           m."ABERR_TYPE",
           m."MIT_FREQ",
           t."TCGA_FREQ"
    FROM   mit_freq m
    JOIN   tcga_freq t
           ON  t."CHR"        = m."CHR"
           AND t."CYTOBAND"   = m."CYTOBAND"
           AND t."ABERR_TYPE" = m."ABERR_TYPE"
),
/* 5)  Correlation per chromosome / aberration class                     */
corr_stats AS (
    SELECT
           "CHR",
           "ABERR_TYPE",
           COUNT(*)                     AS "N_POINTS",
           CORR("MIT_FREQ","TCGA_FREQ") AS "PEARSON_R"
    FROM   joined
    GROUP BY "CHR","ABERR_TYPE"
    HAVING COUNT(*) >= 5
),
/* 6)  Two-tailed p-value (Fisher z-transform)                           */
corr_with_p AS (
    SELECT
           "CHR",
           "ABERR_TYPE",
           "PEARSON_R",
           "N_POINTS",
           1 - ERF(
                 ABS(0.5 * LN( (1 + "PEARSON_R") / (1 - "PEARSON_R") )
                     * SQRT("N_POINTS" - 3)) / SQRT(2)
           )                               AS "P_VALUE"
    FROM   corr_stats
)
SELECT
       "CHR"                         AS "chromosome",
       "ABERR_TYPE"                  AS "aberration_type",
       ROUND("PEARSON_R", 4)         AS "pearson_r",
       ROUND("P_VALUE",   4)         AS "p_value",
       "N_POINTS"                    AS "n_matching_cytobands"
FROM   corr_with_p
ORDER BY "chromosome","aberration_type";
