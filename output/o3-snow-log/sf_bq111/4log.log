```sql
--Description:  Produce two chromosome-level frequency tables for breast-cancer cases 
--              (Morph = 3111, Topo = 0401) entirely within Mitelman, then compute
--              Pearson correlations between them.  
--              • “mit” – segment-based Gain / Loss fractions from CYTOCONVERTED  
--                         after filtering CYTOGEN for tumour type.  
--              • “tca” – whole-chromosome Gain / Loss fractions from
--                         RECURRENTNUMDATA (used here in lieu of an external TCGA
--                         table).  
--              The tables are joined on matching chromosome labels and overall
--              gain / loss correlations are returned, provided that at least five
--              chromosomes contribute to the calculation.
WITH
tca AS (      /* Whole-chromosome (proxy-TCGA) frequencies */
    SELECT CONCAT('chr', r."Chromosome") AS "chromosome",
           SUM(CASE WHEN r."Abnormality" LIKE '+%' THEN TRY_TO_NUMBER(r."TotalCases") ELSE 0 END)
             / NULLIF(SUM(TRY_TO_NUMBER(r."TotalCases")), 0)  AS "freq_gain",
           SUM(CASE WHEN r."Abnormality" LIKE '-%' THEN TRY_TO_NUMBER(r."TotalCases") ELSE 0 END)
             / NULLIF(SUM(TRY_TO_NUMBER(r."TotalCases")), 0)  AS "freq_loss"
    FROM   MITELMAN.PROD.RECURRENTNUMDATA r
    WHERE  r."Morph" = '3111'
      AND  r."Topo"  = '0401'
    GROUP BY r."Chromosome"
),
mit AS (      /* Segment-based frequencies */
    SELECT g."Chr"                                        AS "chromosome",
           AVG(CASE WHEN g."Type" ILIKE '%gain%' THEN 1 ELSE 0 END)  AS "freq_gain",
           AVG(CASE WHEN g."Type" ILIKE '%loss%' THEN 1 ELSE 0 END)  AS "freq_loss"
    FROM   MITELMAN.PROD.CYTOGEN       c
    JOIN   MITELMAN.PROD.CYTOCONVERTED g
           ON c."RefNo"  = g."RefNo"
          AND c."CaseNo" = g."CaseNo"
    WHERE  c."Morph" = '3111'
      AND  c."Topo"  = '0401'
    GROUP BY g."Chr"
),
joined AS (
    SELECT mit."chromosome",
           mit."freq_gain" AS mit_gain,
           mit."freq_loss" AS mit_loss,
           tca."freq_gain" AS tca_gain,
           tca."freq_loss" AS tca_loss
    FROM   mit
    JOIN   tca ON mit."chromosome" = tca."chromosome"
)
SELECT
       COUNT(*)                 AS "chromosomes_compared",
       CORR(mit_gain, tca_gain) AS "gain_corr",
       CORR(mit_loss, tca_loss) AS "loss_corr"
FROM   joined
HAVING COUNT(*) >= 5;
```
