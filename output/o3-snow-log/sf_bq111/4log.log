```sql
--Description: 1) Look at the different morphology / topography codes available in the clinical table
SELECT DISTINCT 
       "Morph",
       "Topo"
FROM   MITELMAN.PROD.CYTOGEN
LIMIT  20;
```

```sql
--Description: 2) Show 20 clinical rows that match breast-carcinoma morphology (3111) and topography (0401)
SELECT *
FROM   MITELMAN.PROD.CYTOGEN
WHERE  "Morph" = '3111'
  AND  "Topo"  = '0401'
LIMIT  20;
```

```sql
--Description: 3) Check which copy-number call types (Gain / Loss / Amplification / Deletion …) exist
SELECT DISTINCT 
       "Type"
FROM   MITELMAN.PROD.CYTOCONVERTED
LIMIT  20;
```

```sql
--Description: 4) Join clinical cases (3111 / 0401) with their copy-number calls and list a few rows
SELECT c."RefNo",
       c."CaseNo",
       c."InvNo",
       g."Chr",
       g."Type",
       g."Start",
       g."End",
       g."CellsPresent"
FROM   MITELMAN.PROD.CYTOGEN           c
JOIN   MITELMAN.PROD.CYTOCONVERTED     g
  ON   c."RefNo"  = g."RefNo"
 AND   c."CaseNo" = g."CaseNo"
 AND   c."InvNo"  = g."InvNo"
WHERE  c."Morph" = '3111'
  AND  c."Topo"  = '0401'
LIMIT  20;
```

```sql
--Description: 5) Simple frequency table: number of Gains per chromosome for the selected cohort
SELECT g."Chr",
       COUNT(*) AS "gain_count"
FROM   MITELMAN.PROD.CYTOGEN       c
JOIN   MITELMAN.PROD.CYTOCONVERTED g
  ON   c."RefNo"  = g."RefNo"
 AND   c."CaseNo" = g."CaseNo"
 AND   c."InvNo"  = g."InvNo"
WHERE  c."Morph" = '3111'
  AND  c."Topo"  = '0401'
  AND  g."Type"  ILIKE '%gain%'
GROUP BY g."Chr"
ORDER BY "gain_count" DESC
LIMIT  20;
```

```sql
--Description: 6) Same idea but for Loss / Deletion calls
SELECT g."Chr",
       COUNT(*) AS "loss_count"
FROM   MITELMAN.PROD.CYTOGEN       c
JOIN   MITELMAN.PROD.CYTOCONVERTED g
  ON   c."RefNo"  = g."RefNo"
 AND   c."CaseNo" = g."CaseNo"
 AND   c."InvNo"  = g."InvNo"
WHERE  c."Morph" = '3111'
  AND  c."Topo"  = '0401'
  AND  g."Type"  ILIKE '%loss%'
GROUP BY g."Chr"
ORDER BY "loss_count" DESC
LIMIT  20;
```

```sql
--Description: 7) Map each CNV segment to a cytoband and list a sample of annotated rows
SELECT g."RefNo",
       g."CaseNo",
       g."Chr",
       b."cytoband_name",
       b."hg38_start",
       b."hg38_stop",
       g."Start",
       g."End",
       g."Type"
FROM   MITELMAN.PROD.CYTOCONVERTED g
JOIN   MITELMAN.PROD.CYTOBANDS_HG38 b
  ON   b."chromosome"   = g."Chr"
 AND   b."hg38_start" <= g."Start"
 AND   b."hg38_stop"  >= g."End"
LIMIT  20;
```

```sql
--Description: 8) Count how many cases (unique RefNo/CaseNo/InvNo) have any Gain on each chromosome
SELECT g."Chr",
       COUNT(DISTINCT CONCAT(g."RefNo",':',g."CaseNo",':',g."InvNo")) AS "cases_with_gain"
FROM   MITELMAN.PROD.CYTOGEN       c
JOIN   MITELMAN.PROD.CYTOCONVERTED g
  ON   c."RefNo"  = g."RefNo"
 AND   c."CaseNo" = g."CaseNo"
 AND   c."InvNo"  = g."InvNo"
WHERE  c."Morph" = '3111'
  AND  c."Topo"  = '0401'
  AND  g."Type"  ILIKE '%gain%'
GROUP BY g."Chr"
ORDER BY "cases_with_gain" DESC
LIMIT  20;
```

```sql
--Description: 9) Prepare a per-chromosome summary table (gains & losses) for later correlation work
SELECT g."Chr",
       SUM(CASE WHEN g."Type" ILIKE '%gain%' THEN 1 ELSE 0 END) AS "n_gain",
       SUM(CASE WHEN g."Type" ILIKE '%loss%' THEN 1 ELSE 0 END) AS "n_loss"
FROM   MITELMAN.PROD.CYTOGEN       c
JOIN   MITELMAN.PROD.CYTOCONVERTED g
  ON   c."RefNo"  = g."RefNo"
 AND   c."CaseNo" = g."CaseNo"
 AND   c."InvNo"  = g."InvNo"
WHERE  c."Morph" = '3111'
  AND  c."Topo"  = '0401'
GROUP BY g."Chr"
ORDER BY g."Chr"
LIMIT  20;
```

```sql
--Description: 10) Illustrative (truncated) query showing how one might compute correlations once TCGA data are joined; still limited to 20 rows
SELECT tca."Chr"                             AS "chromosome",
       CORR(mit."freq_gain", tca."freq_gain") AS "gain_corr",
       CORR(mit."freq_loss", tca."freq_loss") AS "loss_corr"
FROM   MITELMAN.PROD.SOME_TCGA_CN_FREQ_TABLE tca   -- <-- placeholder for TCGA‐side data
JOIN (
        SELECT g."Chr",
               AVG(CASE WHEN g."Type" ILIKE '%gain%' THEN 1 ELSE 0 END) AS "freq_gain",
               AVG(CASE WHEN g."Type" ILIKE '%loss%' THEN 1 ELSE 0 END) AS "freq_loss"
        FROM   MITELMAN.PROD.CYTOGEN       c
        JOIN   MITELMAN.PROD.CYTOCONVERTED g
          ON   c."RefNo"  = g."RefNo"
         AND   c."CaseNo" = g."CaseNo"
         AND   c."InvNo"  = g."InvNo"
        WHERE  c."Morph" = '3111'
          AND  c."Topo"  = '0401'
        GROUP BY g."Chr"
     ) mit
  ON mit."Chr" = tca."Chr"
GROUP BY tca."Chr"
HAVING COUNT(*) >= 5
LIMIT  20;
```

(Replace `MITELMAN.PROD.SOME_TCGA_CN_FREQ_TABLE` with the actual TCGA frequency table once it is available in your environment.)
