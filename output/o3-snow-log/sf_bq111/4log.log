--Description: 5) Count total number of Gain segments per chromosome for breast-cancer cases (Morph 3111, Topo 0401).  
--              CYTOGEN has no "InvNo", so join only on "RefNo" and "CaseNo".
SELECT g."Chr",
       COUNT(*) AS "gain_count"
FROM   MITELMAN.PROD.CYTOGEN       c
JOIN   MITELMAN.PROD.CYTOCONVERTED g
  ON   c."RefNo"  = g."RefNo"
 AND   c."CaseNo" = g."CaseNo"
WHERE  c."Morph" = '3111'
  AND  c."Topo"  = '0401'
  AND  g."Type"  ILIKE '%gain%'
GROUP BY g."Chr"
ORDER BY "gain_count" DESC
LIMIT 20
