/*-------------------------------------------------------------------
   Pearson correlation (two–tailed) between Mitelman-DB and TCGA
   copy-number frequencies, per chromosome and aberration class,
   for breast-cancer cases (Morph = 3111, Topo = 0401).
   Only chromosomes with ≥ 5 matching cytobands are reported.
-------------------------------------------------------------------*/
WITH
/* 1)  Breast-cancer Mitelman cases                                        */
mit_cases AS (
    SELECT DISTINCT
           c."RefNo",
           c."CaseNo",
           g."InvNo"
    FROM   MITELMAN.PROD.CYTOGEN       c
    JOIN   MITELMAN.PROD.CYTOCONVERTED g
           ON  c."RefNo"  = g."RefNo"
           AND c."CaseNo" = g."CaseNo"
    WHERE  c."Morph" = '3111'                -- breast carcinoma
      AND  c."Topo"  = '0401'                -- breast topography
),
/* 2)  Map Mitelman CNV segments to cytobands                              */
mit_band_calls AS (
    SELECT
           b."chromosome"      AS "Chr",
           b."cytoband_name"   AS "Cytoband",
           CASE
               WHEN g."Type" ILIKE '%amp%'  THEN 'Amplification'
               WHEN g."Type" ILIKE '%gain%' THEN 'Gain'
               WHEN g."Type" ILIKE '%loss%' THEN 'Loss'
               WHEN g."Type" ILIKE '%del%'  THEN 'Deletion'
           END                 AS "Aberr_Type",
           CONCAT(g."RefNo",':',g."CaseNo",':',g."InvNo") AS "Case_Id"
    FROM   mit_cases mc
    JOIN   MITELMAN.PROD.CYTOCONVERTED g
           ON  mc."RefNo"  = g."RefNo"
           AND mc."CaseNo" = g."CaseNo"
           AND mc."InvNo"  = g."InvNo"
    JOIN   MITELMAN.PROD.CYTOBANDS_HG38 b
           ON  b."chromosome" = g."Chr"
           AND b."hg38_start" <  g."End"
           AND b."hg38_stop"  >  g."Start"
    WHERE  g."Type" IS NOT NULL
),
mit_freq AS (               /* Mitelman cytoband-level frequencies       */
    SELECT
           "Chr",
           "Cytoband",
           "Aberr_Type",
           COUNT(DISTINCT "Case_Id") AS "mit_freq"
    FROM   mit_band_calls
    WHERE  "Aberr_Type" IN ('Amplification','Gain','Loss','Deletion')
    GROUP BY "Chr","Cytoband","Aberr_Type"
),
/* 3)  TCGA cytoband-level frequencies (hg38, pre-computed)               */
tcga_freq AS (
    SELECT  t."chromosome"    AS "Chr",
            t."cytoband_name" AS "Cytoband",
            'Amplification'   AS "Aberr_Type",
            t."freq_amp"      AS "tcga_freq"
    FROM    TCGA.PUBLIC."CNV_CYTOBAND_FREQUENCIES" t
    UNION ALL
    SELECT  t."chromosome", t."cytoband_name", 'Gain',        t."freq_gain"
    FROM    TCGA.PUBLIC."CNV_CYTOBAND_FREQUENCIES" t
    UNION ALL
    SELECT  t."chromosome", t."cytoband_name", 'Deletion',    t."freq_homodel"
    FROM    TCGA.PUBLIC."CNV_CYTOBAND_FREQUENCIES" t
    UNION ALL
    SELECT  t."chromosome", t."cytoband_name", 'Loss',        t."freq_heterodel"
    FROM    TCGA.PUBLIC."CNV_CYTOBAND_FREQUENCIES" t
),
/* 4)  Align Mitelman & TCGA records                                       */
joined AS (
    SELECT
           m."Chr",
           m."Cytoband",
           m."Aberr_Type",
           m."mit_freq",
           t."tcga_freq"
    FROM   mit_freq  m
    JOIN   tcga_freq t
           ON  t."Chr"        = m."Chr"
           AND t."Cytoband"   = m."Cytoband"
           AND t."Aberr_Type" = m."Aberr_Type"
),
/* 5)  Per-chromosome correlation statistics                              */
corr_stats AS (
    SELECT
           "Chr",
           "Aberr_Type",
           COUNT(*)                     AS "n_points",
           CORR("mit_freq","tcga_freq") AS "pearson_r"
    FROM   joined
    GROUP BY "Chr","Aberr_Type"
    HAVING COUNT(*) >= 5
),
/* 6)  Two-tailed p-value using Fisher z-transform                        */
corr_with_p AS (
    SELECT
           "Chr",
           "Aberr_Type",
           "pearson_r",
           "n_points",
           1 - ERF( ABS(0.5 * LN((1 + "pearson_r") / (1 - "pearson_r"))
                         * SQRT("n_points" - 3)) / SQRT(2) ) AS "p_value"
    FROM   corr_stats
)
SELECT
       "Chr"            AS "chromosome",
       "Aberr_Type"     AS "aberration_type",
       ROUND("pearson_r", 4) AS "pearson_r",
       ROUND("p_value",   4) AS "p_value",
       "n_points"       AS "n_matching_cytobands"
FROM   corr_with_p
ORDER BY "chromosome","aberration_type";
```
