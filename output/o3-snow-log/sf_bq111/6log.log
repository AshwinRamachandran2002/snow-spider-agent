/*--------------------------------------------------------------
  Pearson correlation (plus two–tailed p-value) between
  Mitelman and TCGA copy-number–aberration (CNA) frequencies
  for breast-cancer samples  (Morph = 3111, Topo = 0401)
----------------------------------------------------------------*/

WITH
/* 1.  Breast-cancer cases in Mitelman ------------------------- */
cases_breast AS (
    SELECT DISTINCT
           "RefNo",
           "CaseNo"
    FROM   MITELMAN.PROD.CYTOGEN
    WHERE  "Morph" = '3111'
      AND  "Topo"  = '0401'
),
total_cases AS (                 -- cohort size
    SELECT COUNT(*) AS total_case_count
    FROM   cases_breast
),

/* 2.  Mitelman – cytoband-level counts & frequencies ---------- */
mit_counts AS (
    SELECT
        c."Chr"                   AS Chromosome,
        b."cytoband_name"         AS Cytoband,
        c."Type"                  AS Aberration_Type,   /* Gain | Loss | Amp | Del */
        COUNT( DISTINCT
               CONCAT( TO_VARCHAR(cb."RefNo"), '-', cb."CaseNo") )  AS Case_Count
    FROM   MITELMAN.PROD.CYTOCONVERTED   c
    JOIN   cases_breast                  cb
           ON c."RefNo"  = cb."RefNo"
          AND c."CaseNo" = cb."CaseNo"
    JOIN   MITELMAN.PROD.CYTOBANDS_HG38  b
           ON b."chromosome"  = c."Chr"
          AND c."Start"       <= b."hg38_stop"
          AND c."End"         >= b."hg38_start"
    GROUP BY
        c."Chr",
        b."cytoband_name",
        c."Type"
),
mit_freq AS (
    SELECT
        m.Chromosome,
        m.Cytoband,
        m.Aberration_Type,
        (m.Case_Count / t.total_case_count) * 100.0  AS Freq_Mitelman
    FROM   mit_counts m
    CROSS  JOIN total_cases t
),

/* 3.  TCGA – cytoband-level frequencies ---------------------- */
/*     (table must contain columns: CHROMOSOME, CYTOBAND_NAME,  */
/*      FREQ_AMP, FREQ_GAIN, FREQ_HOMODEL, FREQ_HETERODEL)      */
tcga_raw AS (
    SELECT
        chromosome      AS Chromosome,
        cytoband_name   AS Cytoband,
        freq_amp,
        freq_gain,
        freq_homodel,
        freq_heterodel
    FROM   "TCGA"."PUBLIC"."CNV_CYTOBAND_FREQ"
),
tcga_prep AS (      /* map to four CNA types used in Mitelman */
    SELECT Chromosome, Cytoband, 'Amp'  AS Aberration_Type, freq_amp       AS Freq_TCGA FROM tcga_raw
    UNION ALL
    SELECT Chromosome, Cytoband, 'Gain' AS Aberration_Type, freq_gain      AS Freq_TCGA FROM tcga_raw
    UNION ALL
    SELECT Chromosome, Cytoband, 'Loss' AS Aberration_Type, freq_heterodel AS Freq_TCGA FROM tcga_raw
    UNION ALL
    SELECT Chromosome, Cytoband, 'Del'  AS Aberration_Type, freq_homodel   AS Freq_TCGA FROM tcga_raw
),

/* 4.  Join Mitelman & TCGA on chromosome + cytoband + CNA type */
joined AS (
    SELECT
        m.Chromosome,
        m.Cytoband,
        m.Aberration_Type,
        m.Freq_Mitelman,
        t.Freq_TCGA
    FROM   mit_freq  m
    JOIN   tcga_prep t
           ON  m.Chromosome      = t.Chromosome
           AND m.Cytoband        = t.Cytoband
           AND m.Aberration_Type = t.Aberration_Type
),

/* 5.  Per-chromosome correlations (≥5 matched cytobands) ------ */
corr_data AS (
    SELECT
        Chromosome,
        Aberration_Type,
        CORR(Freq_Mitelman, Freq_TCGA)  AS Pearson_r,
        COUNT(*)                        AS n_cytobands
    FROM   joined
    GROUP BY
        Chromosome,
        Aberration_Type
    HAVING COUNT(*) >= 5
)

/* 6.  Final output with two-tailed p-values ------------------- */
SELECT
    Chromosome,
    Aberration_Type          AS "CNA_Type",
    ROUND(Pearson_r, 6)      AS "Pearson_r",
    ROUND(
        T_DIST_2T(
            ABS(Pearson_r) *
            SQRT( (n_cytobands - 2) / (1 - POWER(Pearson_r, 2)) ),
            n_cytobands - 2
        ),
        6
    )                        AS "p_value",
    n_cytobands              AS "Matched_Cytobands"
FROM   corr_data
ORDER BY
    Chromosome,
    "CNA_Type";
