--Description: 7) Example mapping of CytoConverter genomic intervals to hg38 cytobands
--              to validate coordinate-to-cytoband join logic.
SELECT
  c."RefNo",
  c."CaseNo",
  c."Chr"           AS "Chromosome",
  c."Start",
  c."End",
  b."cytoband_name"
FROM MITELMAN.PROD.CYTOCONVERTED   c
JOIN MITELMAN.PROD.CYTOBANDS_HG38  b
  ON b."chromosome"  = c."Chr"
 AND c."Start"       <= b."hg38_stop"
 AND c."End"         >= b."hg38_start"
LIMIT 20
