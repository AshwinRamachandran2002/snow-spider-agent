Query:
--Description: 3) Copy-number events (Gain / Loss / Amp / Del) that belong to the
--              breast-cancer cohort, taken from the CytoConverter output table.
SELECT
  c."RefNo",
  c."CaseNo",
  c."InvNo",
  c."Clone"           AS "CloneNo",
  c."Chr"             AS "Chromosome",
  c."Start",
  c."End",
  c."Type"            AS "CNA_Type",
  c."CellsPresent"
FROM MITELMAN.PROD.CYTOCONVERTED  c
JOIN (
        SELECT DISTINCT "RefNo", "CaseNo"
        FROM MITELMAN.PROD.CYTOGEN
        WHERE "Morph" = '3111'
          AND "Topo"  = '0401'
     ) g
  ON c."RefNo" = g."RefNo"
 AND c."CaseNo" = g."CaseNo"
LIMIT 20
