```sql
--Description: 1) Sample of cytogenetics cases that have breast-cancer morphology (3111)
--   and topography (0401).  These cases are the starting point for building the
--   Mitelman copy-number cohort.
SELECT
  "RefNo",
  "CaseNo",
  "InvNo",
  "Sex",
  "Age",
  "Country",
  "Morph",
  "Topo"
FROM MITELMAN.PROD.CYTOGEN
WHERE "Morph" = '3111'
  AND "Topo" = '0401'
LIMIT 20;
```

```sql
--Description: 2) Distinct (RefNo, CaseNo) pairs for the same breast-cancer cohort;
--   these identifiers will later be used to join to the copy-number table.
SELECT DISTINCT
  "RefNo",
  "CaseNo"
FROM MITELMAN.PROD.CYTOGEN
WHERE "Morph" = '3111'
  AND "Topo" = '0401'
LIMIT 20;
```

```sql
--Description: 3) Copy-number events (Gain / Loss / Amp / Del) belonging to the
--   breast-cancer cohort, taken from the CytoConverter output table.
SELECT
  c."RefNo",
  c."CaseNo",
  c."InvNo",
  c."Clone"            AS "CloneNo",
  c."Chr"              AS "Chromosome",
  c."Start",
  c."End",
  c."Type"             AS "CNA_Type",
  c."CellsPresent"
FROM MITELMAN.PROD.CYTOCONVERTED      c
JOIN (
      SELECT DISTINCT "RefNo", "CaseNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401'
     ) g
  ON c."RefNo" = g."RefNo" AND c."CaseNo" = g."CaseNo"
LIMIT 20;
```

```sql
--Description: 4) Quick chromosome-level counts of each CNA type
--   (Gain / Loss / Amp / Del) for the breast-cancer cohort.
SELECT
  c."Chr"                          AS "Chromosome",
  c."Type"                         AS "CNA_Type",
  COUNT(*)                         AS "Event_Count"
FROM MITELMAN.PROD.CYTOCONVERTED   c
JOIN (
      SELECT DISTINCT "RefNo", "CaseNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401'
     ) g
  ON c."RefNo" = g."RefNo" AND c."CaseNo" = g."CaseNo"
GROUP BY c."Chr", c."Type"
ORDER BY c."Chr", c."Type"
LIMIT 20;
```

```sql
--Description: 5) Same counts as above but displayed together with numeric
--   chromosome ordering so it is easy to sort 1–22, X, Y.
SELECT
  c."ChrOrd"                       AS "Chr_Order",
  c."Chr"                          AS "Chromosome",
  c."Type"                         AS "CNA_Type",
  COUNT(*)                         AS "Event_Count"
FROM MITELMAN.PROD.CYTOCONVERTED   c
JOIN (
      SELECT DISTINCT "RefNo", "CaseNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401'
     ) g
  ON c."RefNo" = g."RefNo" AND c."CaseNo" = g."CaseNo"
GROUP BY c."ChrOrd", c."Chr", c."Type"
ORDER BY c."ChrOrd", c."Type"
LIMIT 20;
```

```sql
--Description: 6) Recurrent numerical abnormalities (Mitelman summary table)
--   already filtered for the same morphology / topography.
SELECT
  "Chromosome",
  "Abnormality",
  "TotalCases"
FROM MITELMAN.PROD.RECURRENTNUMDATA
WHERE "Morph" = '3111'
  AND "Topo"  = '0401'
LIMIT 20;
```

```sql
--Description: 7) Example mapping of CytoConverter genomic coordinates
--   to cytobands (hg38).  This confirms the join logic that will later
--   be used for correlation by cytoband.
SELECT
  c."RefNo",
  c."CaseNo",
  c."Chr"                AS "Chromosome",
  c."Start",
  c."End",
  b."cytoband_name"
FROM MITELMAN.PROD.CYTOCONVERTED  c
JOIN MITELMAN.PROD.CYTOBANDS_HG38 b
  ON b."chromosome" = c."Chr"
 AND c."Start" <= b."hg38_stop"
 AND c."End"   >= b."hg38_start"
LIMIT 20;
```

```sql
--Description: 8) Short karyotype strings for clones belonging to the same
--   breast-cancer cohort, useful to compare with CytoConverter output.
SELECT DISTINCT
  k."RefNo",
  k."CaseNo",
  k."InvNo",
  k."CloneNo",
  k."CloneShort"
FROM MITELMAN.PROD.KARYCLONE       k
JOIN (
      SELECT DISTINCT "RefNo", "CaseNo"
      FROM MITELMAN.PROD.CYTOGEN
      WHERE "Morph" = '3111'
        AND "Topo"  = '0401'
     ) g
  ON k."RefNo" = g."RefNo" AND k."CaseNo" = g."CaseNo"
LIMIT 20;
```

```sql
--Description: 9) Global distribution of CNA types in the entire
--   CytoConverter table (no filtering) to understand background frequencies.
SELECT
  "Type"          AS "CNA_Type",
  COUNT(*)        AS "Total_Events"
FROM MITELMAN.PROD.CYTOCONVERTED
GROUP BY "Type"
ORDER BY "Total_Events" DESC
LIMIT 20;
```

```sql
--Description: 10) Quick look at the distinct CNA type strings that exist
--   in the CytoConverter output, just to verify available categories.
SELECT DISTINCT
  "Type" AS "CNA_Type"
FROM MITELMAN.PROD.CYTOCONVERTED
LIMIT 20;
```
