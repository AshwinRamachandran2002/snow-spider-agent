Query:
--Description: 4) Chromosome-level counts of each CNA type (Gain / Loss / Amp / Del)
--              for the breast-cancer cohort.
SELECT
  c."Chr"   AS "Chromosome",
  c."Type"  AS "CNA_Type",
  COUNT(*)  AS "Event_Count"
FROM MITELMAN.PROD.CYTOCONVERTED  c
JOIN (
        SELECT DISTINCT "RefNo", "CaseNo"
        FROM MITELMAN.PROD.CYTOGEN
        WHERE "Morph" = '3111'
          AND "Topo"  = '0401'
     ) g
  ON c."RefNo" = g."RefNo"
 AND c."CaseNo" = g."CaseNo"
GROUP BY c."Chr", c."Type"
ORDER BY c."Chr", c."Type"
LIMIT 20
