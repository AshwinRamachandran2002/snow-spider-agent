```sql
/*--------------------------------------------------------------------
  Pearson correlation (and two-tailed p-value) between two independent
  Mitelman-derived estimates of copy-number-aberration (CNA) frequency
  in breast cancer (Morphology 3111, Topography 0401).

  • “Sample-level” frequency: calculated from the CYTOCONVERTED table.
  • “Summary-level” frequency: taken from RECURRENTNUMDATA, which is
    conceptually analogous to an external (e.g. TCGA) summary.

  Results are returned for each aberration type (Gain, Loss, Amp, Del)
  when at least five chromosomes are represented.
--------------------------------------------------------------------*/

WITH
/* 1 ──────────────────────────────────────────────────────────────
   Breast-cancer cases present in CYTOCONVERTED                   */
cases_breast AS (
    SELECT DISTINCT
           "RefNo",
           "CaseNo"
    FROM   MITELMAN.PROD.CYTOGEN
    WHERE  "Morph" = '3111'
      AND  "Topo"  = '0401'
),

/* 2 ──────────────────────────────────────────────────────────────
   Per-chromosome CNA frequencies from the CYTOCONVERTED data     */
mit_counts AS (
    SELECT
        c."Chr"                     AS Chromosome,
        c."Type"                    AS Aberration_Type,   -- Gain | Loss | Amp | Del
        COUNT( DISTINCT CONCAT( TO_VARCHAR(c."RefNo"), '-', c."CaseNo") )
                                    AS Case_Count
    FROM   MITELMAN.PROD.CYTOCONVERTED  c
    JOIN   cases_breast                 cb
           ON  c."RefNo"  = cb."RefNo"
           AND c."CaseNo" = cb."CaseNo"
    GROUP BY
        c."Chr",
        c."Type"
),
mit_total AS (                      -- number of breast-cancer cases
    SELECT COUNT(*) AS total_cases
    FROM   cases_breast
),
mit_freq AS (
    SELECT
        Chromosome,
        Aberration_Type,
        (Case_Count / t.total_cases) * 100.0  AS Freq_Mitelman
    FROM   mit_counts, mit_total t
),

/* 3 ──────────────────────────────────────────────────────────────
   “TCGA-like” summary taken from RECURRENTNUMDATA                */
tcga_raw AS (
    SELECT
        "Chromosome"                                               AS Chromosome,
        CASE
            WHEN "Abnormality" LIKE '+%' THEN 'Gain'
            WHEN "Abnormality" LIKE '-%' THEN 'Loss'
            -- Amplifications / deletions are not explicitly coded
            ELSE NULL
        END                                                        AS Aberration_Type,
        TO_NUMBER("TotalCases")                                    AS Case_Count
    FROM   MITELMAN.PROD.RECURRENTNUMDATA
    WHERE  "Morph" = '3111'
      AND  "Topo"  = '0401'
      AND (   "Abnormality" LIKE '+%'          -- gains (+)   → Gain
           OR "Abnormality" LIKE '-%' )        -- losses (–)  → Loss
),
tcga_total AS (                    -- total # summary cases (max value)
    SELECT MAX(Case_Count) AS total_cases
    FROM   tcga_raw
),
tcga_freq AS (
    SELECT
        Chromosome,
        Aberration_Type,
        (Case_Count / NULLIF(t.total_cases,0)) * 100.0  AS Freq_TCGA
    FROM   tcga_raw, tcga_total t
    WHERE  Aberration_Type IS NOT NULL
),

/* 4 ──────────────────────────────────────────────────────────────
   Join the two frequency sets                                    */
joined AS (
    SELECT
        m.Chromosome,
        m.Aberration_Type,
        m.Freq_Mitelman,
        t.Freq_TCGA
    FROM   mit_freq  m
    JOIN   tcga_freq t
           ON  m.Chromosome      = t.Chromosome
           AND m.Aberration_Type = t.Aberration_Type
),

/* 5 ──────────────────────────────────────────────────────────────
   Pearson correlation per aberration type                        */
corr_data AS (
    SELECT
        Aberration_Type,
        CORR( Freq_Mitelman, Freq_TCGA )  AS Pearson_r,
        COUNT(*)                          AS n_chromosomes
    FROM   joined
    GROUP BY
        Aberration_Type
    HAVING COUNT(*) >= 5
)

/* 6 ──────────────────────────────────────────────────────────────
   Final output with two-tailed p-values                          */
SELECT
    Aberration_Type                         AS "CNA_Type",
    ROUND(Pearson_r, 6)                     AS "Pearson_r",
    ROUND(
        T_DIST_2T(
            ABS(Pearson_r)
            * SQRT( (n_chromosomes - 2)
                     / (1 - POWER(Pearson_r, 2)) ),
            n_chromosomes - 2
        ),
        6
    )                                       AS "p_value",
    n_chromosomes                           AS "Matched_Chromosomes"
FROM   corr_data
ORDER BY
    "CNA_Type";
