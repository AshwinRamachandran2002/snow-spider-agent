```sql
/* -------------------------------------------------------------
   Final ingredients for every pizza order
   ------------------------------------------------------------- */
WITH orders AS (   /* add an artificial ROW_ID so we can keep the required ordering */
    SELECT
        ROW_NUMBER() OVER (ORDER BY "order_time", "order_id")               AS "row_id",
        "order_id",
        "customer_id",
        /* ensure Meatlovers = 1, everything else = 2                       */
        CASE WHEN "pizza_id" = 1 THEN 1 ELSE 2 END                          AS "pizza_id",
        COALESCE("exclusions",'')                                           AS "exclusions",
        COALESCE("extras",'')                                               AS "extras",
        "order_time"
    FROM MODERN_DATA.MODERN_DATA.PIZZA_CUSTOMER_ORDERS
),

/* ----------------------------------------------------------------
   1. Standard toppings taken from the recipe table
   ---------------------------------------------------------------- */
standard_toppings AS (
    SELECT
        o.row_id,
        TO_NUMBER(TRIM(f.value))        AS topping_id          -- each topping on a separate row
    FROM orders o
    JOIN MODERN_DATA.MODERN_DATA.PIZZA_RECIPES  pr
          ON pr.pizza_id = o.pizza_id
    ,   LATERAL FLATTEN( INPUT => SPLIT(pr.toppings, ',')) f
),

/* ----------------------------------------------------------------
   2. Exclusions provided by the customer
   ---------------------------------------------------------------- */
exclusion_toppings AS (
    SELECT
        o.row_id,
        TO_NUMBER(TRIM(f.value))        AS topping_id
    FROM orders o,
         LATERAL FLATTEN( INPUT => SPLIT(o.exclusions, ',')) f
    WHERE TRIM(o.exclusions) <> ''          -- ignore empty strings
),

/* ----------------------------------------------------------------
   3. Extras requested by the customer (can create duplicates)
   ---------------------------------------------------------------- */
extra_toppings AS (
    SELECT
        o.row_id,
        TO_NUMBER(TRIM(f.value))        AS topping_id
    FROM orders o,
         LATERAL FLATTEN( INPUT => SPLIT(o.extras, ',')) f
    WHERE TRIM(o.extras) <> ''
),

/* ----------------------------------------------------------------
   4. Build the final list of topping-IDs, permitting duplicates
      – keep standard toppings which are NOT excluded
      – add every requested extra topping
   ---------------------------------------------------------------- */
final_topping_rows AS (
      /* kept standard toppings */
      SELECT st.row_id,
             st.topping_id
      FROM   standard_toppings st
      LEFT  JOIN exclusion_toppings ex
             ON  st.row_id     = ex.row_id
             AND st.topping_id = ex.topping_id
      WHERE  ex.topping_id IS NULL

      UNION ALL               -- retain duplicates coming from extras
      /* extras */
      SELECT et.row_id,
             et.topping_id
      FROM   extra_toppings et
),

/* ----------------------------------------------------------------
   5. Count how many times each topping appears per order row
   ---------------------------------------------------------------- */
topping_counts AS (
    SELECT
        row_id,
        topping_id,
        COUNT(*) AS cnt
    FROM final_topping_rows
    GROUP BY row_id, topping_id
),

/* ----------------------------------------------------------------
   6. Translate topping-IDs to names and prefix with ‘2x’ when needed
   ---------------------------------------------------------------- */
named_toppings AS (
    SELECT
        tc.row_id,
        CASE WHEN tc.cnt > 1
             THEN CONCAT(tc.cnt::VARCHAR, 'x', pt.topping_name)
             ELSE pt.topping_name
        END                                         AS ingredient_name,
        pt.topping_name                             AS alpha_sort      -- used for alpha ordering
    FROM topping_counts              tc
    JOIN MODERN_DATA.MODERN_DATA.PIZZA_TOPPINGS pt
          ON pt.topping_id = tc.topping_id
),

/* ----------------------------------------------------------------
   7. Concatenate toppings for each order row in alphabetical order
   ---------------------------------------------------------------- */
ingredients_string AS (
    SELECT
        row_id,
        LISTAGG(ingredient_name, ', ')
              WITHIN GROUP (ORDER BY alpha_sort)    AS ingredients
    FROM named_toppings
    GROUP BY row_id
),

/* ----------------------------------------------------------------
   8. Fetch pizza names and assemble the required final string
   ---------------------------------------------------------------- */
result AS (
    SELECT
        o.row_id,
        o.order_id,
        o.customer_id,
        pn.pizza_name,
        CONCAT(pn.pizza_name, ': ', istring.ingredients) AS final_ingredients
    FROM orders o
    JOIN MODERN_DATA.MODERN_DATA.PIZZA_NAMES pn
          ON pn.pizza_id = o.pizza_id
    JOIN ingredients_string       istring
          ON istring.row_id = o.row_id
)

/* ----------------------------------------------------------------
   9. Return the answer in ascending ROW_ID order
   ---------------------------------------------------------------- */
SELECT
    row_id,
    order_id,
    customer_id,
    pizza_name,
    final_ingredients
FROM result
ORDER BY row_id;
```
