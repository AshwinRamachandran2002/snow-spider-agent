```sql
/*--------------------------------------------------------------
   STEP-1 : one record per pizza in each order – give it a row_id
----------------------------------------------------------------*/
WITH order_rows AS (          -- all customer orders
    SELECT 
        "order_id",
        ROW_NUMBER() OVER (PARTITION BY "order_id" 
                           ORDER BY "pizza_id", "customer_id", "order_time")      AS row_id,
        "customer_id",
        "pizza_id",
        "exclusions",
        "extras"
    FROM MODERN_DATA.MODERN_DATA."PIZZA_CLEAN_CUSTOMER_ORDERS"
),

/*--------------------------------------------------------------
   STEP-2 : exclusions and extras keyed by (order_id , row_id)
----------------------------------------------------------------*/
exclusions AS (
    SELECT 
        "order_id",
        "row_id",
        ARRAY_AGG("exclusions") AS excl_ids
    FROM MODERN_DATA.MODERN_DATA."PIZZA_GET_EXCLUSIONS"
    GROUP BY "order_id","row_id"
),
extras AS (
    SELECT
        "order_id",
        "row_id",
        ARRAY_AGG("extras")     AS extra_ids
    FROM MODERN_DATA.MODERN_DATA."PIZZA_GET_EXTRAS"
    GROUP BY "order_id","row_id"
),

/*--------------------------------------------------------------
   STEP-3 : standard toppings for every pizza_id
----------------------------------------------------------------*/
recipe_expanded AS (
    SELECT 
        pr."pizza_id",
        TO_NUMBER(value) AS topping_id
    FROM MODERN_DATA.MODERN_DATA."PIZZA_RECIPES" pr ,
         LATERAL FLATTEN( input => SPLIT(TRIM(pr."toppings"), ',' ) )
),
standard_toppings AS (
    SELECT 
        "pizza_id",
        ARRAY_AGG(DISTINCT topping_id) AS std_ids
    FROM recipe_expanded
    GROUP BY "pizza_id"
),

/*--------------------------------------------------------------
   STEP-4 : merge standard ‑ excl + extras   (keep duplicates)
----------------------------------------------------------------*/
orders_plus AS (
    SELECT
        o.row_id,
        o."order_id",
        o."customer_id",
        o."pizza_id",
        COALESCE(st.std_ids      , ARRAY_CONSTRUCT()) AS std_ids,
        COALESCE(e.excl_ids      , ARRAY_CONSTRUCT()) AS excl_ids,
        COALESCE(x.extra_ids     , ARRAY_CONSTRUCT()) AS extra_ids
    FROM order_rows o
    LEFT JOIN standard_toppings          st ON st."pizza_id"          = o."pizza_id"
    LEFT JOIN exclusions                 e  ON e."order_id"           = o."order_id"
                                            AND e."row_id"            = o.row_id
    LEFT JOIN extras                     x  ON x."order_id"           = o."order_id"
                                            AND x."row_id"            = o.row_id
),
final_ids AS (        -- remove exclusions then add extras
    SELECT
        row_id,
        "order_id",
        "customer_id",
        "pizza_id",
        ARRAY_CAT( ARRAY_DIFF(std_ids , excl_ids) , extra_ids ) AS all_ids
    FROM orders_plus
),

/*--------------------------------------------------------------
   STEP-5 : turn ids into names  + count duplicates
----------------------------------------------------------------*/
topping_counts AS (
    SELECT
        f.row_id,
        f."order_id",
        f."customer_id",
        f."pizza_id",
        t."topping_name",
        COUNT(*) AS cnt
    FROM final_ids            f ,
         LATERAL FLATTEN( input => f.all_ids ) a
    JOIN MODERN_DATA.MODERN_DATA."PIZZA_TOPPINGS" t
         ON t."topping_id" = a.value
    GROUP BY f.row_id, f."order_id", f."customer_id", f."pizza_id", t."topping_name"
),

/*--------------------------------------------------------------
   STEP-6 : build ordered, prefixed topping strings
----------------------------------------------------------------*/
topping_strings AS (
    SELECT
        row_id,
        "order_id",
        "customer_id",
        "pizza_id",
        ARRAY_AGG(
            CASE WHEN cnt > 1 
                 THEN cnt || 'x ' || "topping_name"
                 ELSE            "topping_name"
            END
            ORDER BY "topping_name"
        ) AS topping_arr
    FROM topping_counts
    GROUP BY row_id, "order_id", "customer_id", "pizza_id"
),

/*--------------------------------------------------------------
   STEP-7 : attach pizza name  (rule: id 1 = Meatlovers, else 2)
----------------------------------------------------------------*/
named AS (
    SELECT
        ts.row_id,
        ts."order_id",
        ts."customer_id",
        pn."pizza_name",
        pn."pizza_name" || ': ' || ARRAY_TO_STRING(topping_arr, ', ')  AS final_ingredients
    FROM topping_strings ts
    JOIN MODERN_DATA.MODERN_DATA."PIZZA_NAMES" pn
         ON pn."pizza_id" = ts."pizza_id"
)

/*--------------------------------------------------------------
   FINAL OUTPUT
----------------------------------------------------------------*/
SELECT
    row_id               AS "row_id",
    "order_id"           AS "order_id",
    "customer_id"        AS "customer_id",
    "pizza_name"         AS "pizza_name",
    final_ingredients    AS "ingredients"
FROM named
ORDER BY row_id;
```
