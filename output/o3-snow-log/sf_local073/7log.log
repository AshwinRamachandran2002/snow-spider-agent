```sql
WITH
/*--------------------------------------------------------------------
1.  Bring every individual pizza order into a single-row “orders” set
    and assign a sequential ROW_ID that will be used for grouping and
    to sort the final answer.
--------------------------------------------------------------------*/
orders AS (
    SELECT
        ROW_NUMBER() OVER (ORDER BY "order_id")                                    AS "row_id",
        "order_id",
        "customer_id",
        "pizza_id",          -- 1 = Meatlovers, 2 = all other pizzas
        "exclusions",        -- comma-separated topping-ids to remove
        "extras",            -- comma-separated topping-ids to add
        "order_time"
    FROM MODERN_DATA.MODERN_DATA.PIZZA_CUSTOMER_ORDERS
),

/*--------------------------------------------------------------------
2.  Expand the standard recipe toppings so that each topping appears
    once per order.
--------------------------------------------------------------------*/
recipe_toppings AS (
    SELECT
        o.row_id,
        TRIM(rt.value)::NUMBER                          AS topping_id,
        1                                               AS qty      -- +1 for every recipe topping
    FROM orders o
    JOIN MODERN_DATA.MODERN_DATA.PIZZA_RECIPES r
          ON r.pizza_id = o.pizza_id
     , LATERAL FLATTEN( INPUT => SPLIT(r.toppings, ',') ) rt
),

/*--------------------------------------------------------------------
3.  Expand any EXTRA toppings – they add one copy of the topping.
--------------------------------------------------------------------*/
extra_toppings AS (
    SELECT
        o.row_id,
        TRIM(et.value)::NUMBER                          AS topping_id,
        1                                               AS qty      -- +1 for every extra topping
    FROM orders o
     , LATERAL FLATTEN( INPUT => SPLIT(NULLIF(o.extras, ''), ',') ) et
    WHERE TRIM(et.value) IS NOT NULL
),

/*--------------------------------------------------------------------
4.  Expand any EXCLUDED toppings – they remove one copy of the topping.
--------------------------------------------------------------------*/
exclusion_toppings AS (
    SELECT
        o.row_id,
        TRIM(xt.value)::NUMBER                          AS topping_id,
       -1                                               AS qty      -- –1 for every excluded topping
    FROM orders o
     , LATERAL FLATTEN( INPUT => SPLIT(NULLIF(o.exclusions, ''), ',') ) xt
    WHERE TRIM(xt.value) IS NOT NULL
),

/*--------------------------------------------------------------------
5.  Combine recipe, extras, and exclusions; then net the quantities.
--------------------------------------------------------------------*/
all_toppings AS (
    SELECT * FROM recipe_toppings
    UNION ALL
    SELECT * FROM extra_toppings
    UNION ALL
    SELECT * FROM exclusion_toppings
),
net_toppings AS (
    SELECT
        row_id,
        topping_id,
        SUM(qty) AS qty
    FROM all_toppings
    GROUP BY row_id, topping_id
    HAVING SUM(qty) > 0                                 -- keep only toppings still present
),

/*--------------------------------------------------------------------
6.  Convert topping-ids to names and apply the “2x”, “3x”, … prefix
    when a topping appears multiple times.
--------------------------------------------------------------------*/
named_toppings AS (
    SELECT
        n.row_id,
        tp.topping_name,
        CASE
            WHEN n.qty > 1
                THEN CONCAT(n.qty::VARCHAR, 'x ', tp.topping_name)
            ELSE tp.topping_name
        END                                             AS topping_label
    FROM net_toppings n
    JOIN MODERN_DATA.MODERN_DATA.PIZZA_TOPPINGS tp
          ON tp.topping_id = n.topping_id
),

/*--------------------------------------------------------------------
7.  Alphabetically order the toppings by their names and collapse them
    into a single comma-separated string for each order.
--------------------------------------------------------------------*/
ingredient_strings AS (
    SELECT
        row_id,
        ARRAY_TO_STRING(
            ARRAY_AGG(topping_label ORDER BY topping_name),
            ', '
        )                                               AS ingredients
    FROM named_toppings
    GROUP BY row_id
)

/*--------------------------------------------------------------------
8.  Assemble the requested final output.
--------------------------------------------------------------------*/
SELECT
    o.row_id,
    o.order_id,
    o.customer_id,
    COALESCE(pn.pizza_name, CASE WHEN o.pizza_id = 1 THEN 'Meatlovers' ELSE 'Other' END)  AS pizza_name,
    CONCAT(
        COALESCE(pn.pizza_name, CASE WHEN o.pizza_id = 1 THEN 'Meatlovers' ELSE 'Other' END),
        ': ',
        COALESCE(ing.ingredients, '')
    )                                                                                     AS final_ingredients
FROM orders o
LEFT JOIN MODERN_DATA.MODERN_DATA.PIZZA_NAMES pn
       ON pn.pizza_id = o.pizza_id
LEFT JOIN ingredient_strings ing
       ON ing.row_id = o.row_id
GROUP BY
    o.row_id,
    o.order_id,
    o.customer_id,
    o.order_time,
    COALESCE(pn.pizza_name, CASE WHEN o.pizza_id = 1 THEN 'Meatlovers' ELSE 'Other' END),
    ing.ingredients
ORDER BY o.row_id;
```
