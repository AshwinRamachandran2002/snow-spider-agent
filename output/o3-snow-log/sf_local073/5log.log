   ingredients alphabetically; duplicates prefixed with ‘2x’.
   -----------------------------------------------------------------*/
WITH /* ------------------- base set of orders ------------------- */
orders AS (
    SELECT DISTINCT
           COALESCE(exc."row_id", ext."row_id", 1)                    AS row_id,
           o."order_id",
           o."customer_id",
           /* assign pizza_id = 1 for Meatlovers, otherwise 2       */
           CASE WHEN pn."pizza_name" = 'Meatlovers' THEN 1 ELSE 2 END AS pizza_id,
           o."order_time"
    FROM   MODERN_DATA.MODERN_DATA.PIZZA_CUSTOMER_ORDERS         o
    LEFT  JOIN MODERN_DATA.MODERN_DATA.PIZZA_NAMES               pn
           ON  pn."pizza_id" = o."pizza_id"
    LEFT  JOIN MODERN_DATA.MODERN_DATA.PIZZA_GET_EXCLUSIONS      exc
           ON  exc."order_id" = o."order_id"
    LEFT  JOIN MODERN_DATA.MODERN_DATA.PIZZA_GET_EXTRAS          ext
           ON  ext."order_id" = o."order_id"
),

/* -------- explode standard (recipe) toppings for each order ---- */
standard_toppings AS (
    SELECT  ord.row_id,
            ord."order_id",
            TRIM(f.value)::NUMBER  AS topping_id
    FROM    orders ord
    JOIN    MODERN_DATA.MODERN_DATA.PIZZA_RECIPES r
              ON r."pizza_id" = ord.pizza_id,
            LATERAL FLATTEN( INPUT => SPLIT(r."toppings", ',')) f
),

/* -------------------- exclusions & extras ---------------------- */
exclusions AS (
    SELECT  "row_id",
            "order_id",
            "exclusions"::NUMBER AS topping_id
    FROM    MODERN_DATA.MODERN_DATA.PIZZA_GET_EXCLUSIONS
),
extras AS (
    SELECT  "row_id",
            "order_id",
            "extras"::NUMBER     AS topping_id
    FROM    MODERN_DATA.MODERN_DATA.PIZZA_GET_EXTRAS
),

/* ------------- remove excluded toppings ----------------------- */
after_exclusions AS (
    SELECT  s.*
    FROM    standard_toppings s
    LEFT    JOIN exclusions x
           ON  x."order_id" = s."order_id"
           AND x."row_id"   = s.row_id
           AND x.topping_id = s.topping_id
    WHERE   x.topping_id IS NULL
),

/* ------------- combine remaining recipe toppings with extras --- */
all_toppings AS (
    SELECT row_id, "order_id", topping_id
    FROM   after_exclusions
    UNION ALL
    SELECT row_id, "order_id", topping_id
    FROM   extras
),

/* ------------- count occurrences of each topping -------------- */
topping_counts AS (
    SELECT  row_id,
            "order_id",
            topping_id,
            COUNT(*) AS qty
    FROM    all_toppings
    GROUP BY row_id, "order_id", topping_id
),

/* ------------- translate IDs to names & add 2x-prefix ---------- */
named_toppings AS (
    SELECT  tc.row_id,
            tc."order_id",
            CASE
                WHEN tc.qty > 1 THEN CONCAT('2x', tp."topping_name")
                ELSE tp."topping_name"
            END AS ingredient_word
    FROM    topping_counts tc
    JOIN    MODERN_DATA.MODERN_DATA.PIZZA_TOPPINGS tp
             ON tp."topping_id" = tc.topping_id
),

/* ------------- alphabetical, comma-separated ingredient list --- */
ingredient_lists AS (
    SELECT  row_id,
            "order_id",
            LISTAGG(ingredient_word, ', ')
              WITHIN GROUP (ORDER BY ingredient_word) AS ingredient_list
    FROM    named_toppings
    GROUP   BY row_id, "order_id"
)

/* --------------------------- final result ---------------------- */
SELECT  o.row_id                                   AS "ROW_ID",
        o."order_id"                               AS "ORDER_ID",
        o."customer_id"                            AS "CUSTOMER_ID",
        pn."pizza_name"                            AS "PIZZA_NAME",
        CONCAT(pn."pizza_name", ': ', il.ingredient_list)
                                                  AS "FINAL_INGREDIENTS"
FROM    orders o
JOIN    ingredient_lists      il
          ON il.row_id    = o.row_id
         AND il."order_id" = o."order_id"
JOIN    MODERN_DATA.MODERN_DATA.PIZZA_NAMES pn
