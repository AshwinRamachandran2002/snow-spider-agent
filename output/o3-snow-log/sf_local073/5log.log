```sql
/* -------------------------------------------------------------
   Build the requested single row per pizza order that contains
   ROW_ID, ORDER_ID, CUSTOMER_ID, PIZZA_NAME and the final list
   of ingredients ( standard – exclusions + extras ).
   ------------------------------------------------------------- */

WITH  /* --- basic set of orders -------------------------------- */
orders AS (
    SELECT  o."order_id",
            o."customer_id",
            o."pizza_id",
            o."order_time",
            ROW_NUMBER() OVER (PARTITION BY o."order_id"
                               ORDER BY o."pizza_id", o."order_time", o."customer_id") AS row_id
    FROM MODERN_DATA.MODERN_DATA.PIZZA_CUSTOMER_ORDERS o
),

/* --- every standard (recipe) topping for every order ---------- */
standard_toppings AS (
    SELECT  ord.row_id,
            ord."order_id",
            TRIM(f.value)::NUMBER                AS topping_id          -- cast to number
    FROM orders ord
    JOIN MODERN_DATA.MODERN_DATA.PIZZA_RECIPES r
          ON r."pizza_id" = ord."pizza_id"
    ,   LATERAL FLATTEN ( INPUT => SPLIT(r."toppings", ',') ) f         -- explode recipe list
),

/* --- exclusions mentioned for an order / row ------------------ */
exclusions AS (
    SELECT  e."row_id",
            e."order_id",
            e."exclusions"::NUMBER               AS topping_id
    FROM MODERN_DATA.MODERN_DATA.PIZZA_GET_EXCLUSIONS e
),

/* --- extras mentioned for an order / row ---------------------- */
extras AS (
    SELECT  e."row_id",
            e."order_id",
            e."extras"::NUMBER                   AS topping_id
    FROM MODERN_DATA.MODERN_DATA.PIZZA_GET_EXTRAS e
),

/* --- keep recipe toppings that are NOT excluded --------------- */
after_exclusions AS (
    SELECT  s.*
    FROM   standard_toppings  s
    LEFT   JOIN exclusions x
           ON  x."order_id" = s."order_id"
           AND x."row_id"   = s.row_id
           AND x.topping_id = s.topping_id
    WHERE  x.topping_id IS NULL                                   -- remove exclusions
),

/* --- put the remaining standard toppings together with extras - */
all_toppings AS (
    SELECT row_id, "order_id", topping_id
    FROM   after_exclusions
    UNION ALL
    SELECT row_id, "order_id", topping_id
    FROM   extras
),

/* --- count how many times every topping finally appears -------- */
topping_counts AS (
    SELECT row_id,
           "order_id",
           topping_id,
           COUNT(*) AS qty
    FROM   all_toppings
    GROUP  BY row_id, "order_id", topping_id
),

/* --- translate topping_id to names, add 2x-prefix when needed -- */
topping_display AS (
    SELECT  tc.row_id,
            tc."order_id",
            CASE WHEN tc.qty > 1
                 THEN CONCAT('2x', tp."topping_name")
                 ELSE tp."topping_name"
            END  AS ingredient_word
    FROM    topping_counts tc
    JOIN    MODERN_DATA.MODERN_DATA.PIZZA_TOPPINGS tp
              ON tp."topping_id" = tc.topping_id
),

/* --- build the comma separated, alphabetically-sorted list ----- */
ingredient_lists AS (
    SELECT  row_id,
            "order_id",
            LISTAGG(ingredient_word, ', ')
               WITHIN GROUP (ORDER BY ingredient_word) AS ingredient_list
    FROM    topping_display
    GROUP   BY row_id, "order_id"
)

/* --- final output --------------------------------------------- */
SELECT  o.row_id                                    AS "ROW_ID",
        o."order_id"                                AS "ORDER_ID",
        o."customer_id"                             AS "CUSTOMER_ID",
        pn."pizza_name"                             AS "PIZZA_NAME",
        CONCAT(pn."pizza_name", ': ', il.ingredient_list)
                                                    AS "FINAL_INGREDIENTS"
FROM    orders o
JOIN    ingredient_lists  il
          ON il.row_id    = o.row_id
         AND il."order_id" = o."order_id"
JOIN    MODERN_DATA.MODERN_DATA.PIZZA_NAMES pn
          ON pn."pizza_id" = o."pizza_id"
ORDER BY o.row_id ASC;
```
