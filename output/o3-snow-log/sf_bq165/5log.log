```sql
--Description:
-- One-step query that (i) selects CytoConverter copy-number segments belonging to breast-cancer
-- (Morph = '3111') or adenocarcinoma (Topo = '0401') cases, (ii) assigns each segment to the
-- cytogenetic band that entirely contains its genomic coordinates, and (iii) reports per-band
-- counts and frequencies (percentage with two decimals) of each copy-number class.
-- Notes
--   • CYTOCONVERTED provides genomic Start/End and “Type” = Gain / Loss.
--   • CYTOGEN supplies Morph / Topo to define the cohort.
--   • CYTOBANDS_HG38 gives band names and genomic limits.
--   • Frequency is calculated within each band: 100 × (class count / all segment counts in band).
WITH cohort AS (   --------------------------------------------------------- 1) restrict to desired cases
    SELECT c."RefNo",
           c."CaseNo",
           c."Chr",
           c."Start",
           c."End",
           c."Type"
    FROM   MITELMAN.PROD.CYTOCONVERTED c
    JOIN   MITELMAN.PROD.CYTOGEN      g
           ON  c."RefNo"  = g."RefNo"
           AND c."CaseNo" = g."CaseNo"
    WHERE  g."Morph" = '3111'       -- breast carcinoma
       OR  g."Topo"  = '0401'       -- adenocarcinoma
), mapped AS (    ----------------------------------------------------------- 2) map to cytobands
    SELECT
        b."chromosome",
        b."cytoband_name",
        b."hg38_start",
        b."hg38_stop",
        c."Type"
    FROM   cohort                        c
    JOIN   MITELMAN.PROD.CYTOBANDS_HG38  b
           ON  b."chromosome" = c."Chr"
           AND c."Start"     >= b."hg38_start"
           AND c."End"       <= b."hg38_stop"
)
SELECT
    "chromosome",
    "cytoband_name",
    "hg38_start",
    "hg38_stop",
    "Type",                                   -- Gain / Loss
    COUNT(*)                                 AS "n_segments",
    ROUND(100.0 * COUNT(*) /
          SUM(COUNT(*)) OVER (PARTITION BY "chromosome", "cytoband_name"), 2)
                                             AS "frequency_pct"
FROM   mapped
GROUP  BY "chromosome",
          "cytoband_name",
          "hg38_start",
          "hg38_stop",
          "Type"
ORDER  BY "chromosome",
          "hg38_start",
          "hg38_stop";
```
