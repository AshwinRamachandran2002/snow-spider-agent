--   • CYTOGEN supplies Morph / Topo to define the cohort.
--   • CYTOBANDS_HG38 gives band names and genomic limits.
--   • Frequency is calculated within each band: 100 × (class count / all segment counts in band).
WITH cohort AS (   --------------------------------------------------------- 1) restrict to desired cases
    SELECT c."RefNo",
           c."CaseNo",
           c."Chr",
           c."Start",
           c."End",
           c."Type"
    FROM   MITELMAN.PROD.CYTOCONVERTED c
