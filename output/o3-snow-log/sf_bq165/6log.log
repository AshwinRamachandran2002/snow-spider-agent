Query:
--Description:  List 20 CytoConverter gain/loss events that belong to
--breast-cancer cases (morphology 3111).  
--Join is on “RefNo” and “CaseNo” only because CYTOGEN lacks “InvNo”.
SELECT  cc."RefNo",
        cc."CaseNo",
        cc."Clone"   AS "CloneNo",
        cc."Chr",
        cc."Start",
        cc."End",
        cc."Type"
FROM    MITELMAN.PROD.CYTOCONVERTED cc
JOIN    MITELMAN.PROD.CYTOGEN      cg
       ON  cc."RefNo"  = cg."RefNo"
       AND cc."CaseNo" = cg."CaseNo"
WHERE   cg."Morph" = '3111'
LIMIT 20
