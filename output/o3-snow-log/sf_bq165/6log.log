--Description:  Map CytoConverter gain/loss events to cytogenetic bands
--using an overlap condition (event intersects band).  Shows 20 sample rows.
SELECT  cc."Chr",
        cb."cytoband_name",
        cb."hg38_start",
        cb."hg38_stop",
        cc."Start" AS "event_start",
        cc."End"   AS "event_end",
        cc."Type"
FROM    MITELMAN.PROD.CYTOCONVERTED  cc
JOIN    MITELMAN.PROD.CYTOBANDS_HG38 cb
       ON  cc."Chr" = cb."chromosome"
       AND cc."Start" <= cb."hg38_stop"
       AND cc."End"   >= cb."hg38_start"
LIMIT 20
