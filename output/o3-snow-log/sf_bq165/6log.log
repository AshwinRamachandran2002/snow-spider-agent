```sql
-- 1. Description:  Show the different alteration “Type” values that CytoConverter
--    has assigned (e.g. Gain, Loss, Amplification, etc.).
SELECT DISTINCT "Type"
FROM MITELMAN.PROD.CYTOCONVERTED
LIMIT 20;
```

```sql
-- 2. Description:  Peek at a handful of CytoConverter records that are classified
--    as amplifications ( >1 extra copy ).
SELECT *
FROM MITELMAN.PROD.CYTOCONVERTED
WHERE "Type" ILIKE '%amp%'          -- fuzzy, catches ‘Amplification’ or similar
LIMIT 20;
```

```sql
-- 3. Description:  Verify that morphology code 3111 corresponds to breast cancer
--    by joining CYTOGEN (holds the code on each case) with KODER  
--    (stores code → description mappings).
SELECT cg."Morph",
       kd."Benamning"     AS "Morphology_Name",
       kd."Kortnamn"      AS "Morphology_Short"
FROM   MITELMAN.PROD.CYTOGEN          cg
JOIN   MITELMAN.PROD.KODER            kd
       ON kd."KodTyp" = 'MORPH'
      AND kd."Kod"    = cg."Morph"
WHERE  cg."Morph" = '3111'
LIMIT 20;
```

```sql
-- 4. Description:  Look at 20 cytogenetic cases that have breast-cancer
--    morphology (3111) together with their reference numbers.
SELECT cg."RefNo",
       cg."CaseNo",
       cg."InvNo",
       cg."Sex",
       cg."Age",
       cg."Series"
FROM   MITELMAN.PROD.CYTOGEN  cg
WHERE  cg."Morph" = '3111'
LIMIT 20;
```

```sql
-- 5. Description:  Show 20 cases whose topography code is 0401  
--    (adenocarcinoma, per task statement) to understand available fields.
SELECT cg."RefNo",
       cg."CaseNo",
       cg."InvNo",
       cg."Morph",
       cg."Topo",
       cg."Series"
FROM   MITELMAN.PROD.CYTOGEN cg
WHERE  cg."Topo" = '0401'
LIMIT 20;
```

```sql
-- 6. Description:  Bring together CytoConverter calls (Gain/Loss/Amp/etc.)
--    with breast-cancer cases (morphology 3111).  This is the core join on RefNo.
SELECT cc."RefNo",
       cc."CaseNo",
       cc."InvNo",
       cc."Chr",
       cc."Start",
       cc."End",
       cc."Type"
FROM   MITELMAN.PROD.CYTOCONVERTED cc
JOIN   MITELMAN.PROD.CYTOGEN       cg
       USING ("RefNo", "CaseNo", "InvNo")
WHERE  cg."Morph" = '3111'
LIMIT 20;
```

```sql
-- 7. Description:  Same type of join but for adenocarcinoma cohort
--    defined by topography 0401.
SELECT cc."RefNo",
       cc."CaseNo",
       cc."InvNo",
       cc."Chr",
       cc."Start",
       cc."End",
       cc."Type"
FROM   MITELMAN.PROD.CYTOCONVERTED cc
JOIN   MITELMAN.PROD.CYTOGEN       cg
       USING ("RefNo", "CaseNo", "InvNo")
WHERE  cg."Topo" = '0401'
LIMIT 20;
```

```sql
-- 8. Description:  Map CytoConverter’s hg38 genomic coordinates to cytogenetic
--    bands so we know exactly which band each gain/loss belongs to.
SELECT cc."Chr",
       cb."cytoband_name",
       cb."hg38_start",
       cb."hg38_stop",
       cc."Start" AS "event_start",
       cc."End"   AS "event_end"
FROM   MITELMAN.PROD.CYTOCONVERTED   cc
JOIN   MITELMAN.PROD.CYTOBANDS_HG38  cb
       ON  cc."Chr"  = cb."chromosome"
       AND cc."Start" >= cb."hg38_start"
       AND cc."End"   <= cb."hg38_stop"
LIMIT 20;
```

```sql
-- 9. Description:  Quick count of each alteration “Type” on every chromosome
--    within the breast-cancer cohort (morphology 3111).  Gives first idea of
--    frequencies before drilling down to band level.
SELECT cc."Chr",
       cc."Type",
       COUNT(*) AS "N_Events"
FROM   MITELMAN.PROD.CYTOCONVERTED cc
JOIN   MITELMAN.PROD.CYTOGEN       cg
       USING ("RefNo", "CaseNo", "InvNo")
WHERE  cg."Morph" = '3111'
GROUP  BY cc."Chr", cc."Type"
ORDER  BY cc."Chr", cc."Type"
LIMIT 20;
```

```sql
--10. Description:  Same chromosome-level summary but for the adenocarcinoma
