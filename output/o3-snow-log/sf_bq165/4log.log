--Description: ❿  FINAL full aggregation – distinct-sample counts and cohort-frequency (%) of
--              Amplifications (>1 copy), Gains (+1), Losses (-1) and Homozygous deletions (-2)
--              per cytoband, sorted by chromosome ordinal then genomic position.
WITH cohort AS (
  SELECT DISTINCT cc."RefNo" || '-' || cc."CaseNo" || '-' || cc."InvNo" AS sid
  FROM   "MITELMAN"."PROD"."CYTOCONVERTED" cc
  JOIN   "MITELMAN"."PROD"."CYTOGEN"       cg
         ON  cc."RefNo" = cg."RefNo"
         AND cc."CaseNo" = cg."CaseNo"
  WHERE  cg."Morph" = '3111'
     OR  cg."Topo"  = '0401'
),
base AS (
  SELECT b."chromosome", b."cytoband_name", b."hg38_start",
         cc."Type",
         cc."RefNo" || '-' || cc."CaseNo" || '-' || cc."InvNo" AS sid
  FROM   "MITELMAN"."PROD"."CYTOCONVERTED"   cc
  JOIN   "MITELMAN"."PROD"."CYTOGEN"         cg
         ON  cc."RefNo" = cg."RefNo"
         AND cc."CaseNo" = cg."CaseNo"
  JOIN   "MITELMAN"."PROD"."CYTOBANDS_HG38"  b
         ON  b."chromosome"  = cc."Chr"
         AND b."hg38_start" <= cc."End"
         AND b."hg38_stop"  >= cc."Start"
  WHERE  cg."Morph" = '3111'
     OR  cg."Topo"  = '0401'
)
SELECT  b."chromosome",
        b."cytoband_name",
        COUNT(DISTINCT CASE WHEN b."Type" = 'Amplification' THEN b.sid END) AS "Amplifications",
        ROUND(100.0 * COUNT(DISTINCT CASE WHEN b."Type" = 'Amplification' THEN b.sid END)
              / (SELECT COUNT(*) FROM cohort), 2) AS "Amplifications_%",

        COUNT(DISTINCT CASE WHEN b."Type" = 'Gain' THEN b.sid END) AS "Gains",
        ROUND(100.0 * COUNT(DISTINCT CASE WHEN b."Type" = 'Gain' THEN b.sid END)
              / (SELECT COUNT(*) FROM cohort), 2) AS "Gains_%",

        COUNT(DISTINCT CASE WHEN b."Type" = 'Loss' THEN b.sid END) AS "Losses",
        ROUND(100.0 * COUNT(DISTINCT CASE WHEN b."Type" = 'Loss' THEN b.sid END)
              / (SELECT COUNT(*) FROM cohort), 2) AS "Losses_%",

        COUNT(DISTINCT CASE WHEN b."Type" IN ('HomLoss','HomozygousDeletion','HomDel') THEN b.sid END) AS "HomDel",
        ROUND(100.0 * COUNT(DISTINCT CASE WHEN b."Type" IN ('HomLoss','HomozygousDeletion','HomDel') THEN b.sid END)
              / (SELECT COUNT(*) FROM cohort), 2) AS "HomDel_%"
FROM  base b
GROUP BY b."chromosome", b."cytoband_name", b."hg38_start"
ORDER BY 
  CASE
        WHEN b."chromosome" = 'chrX' THEN 23
        WHEN b."chromosome" = 'chrY' THEN 24
        ELSE TO_NUMBER(REPLACE(b."chromosome",'chr',''))
  END,
  b."hg38_start"
LIMIT 20;
