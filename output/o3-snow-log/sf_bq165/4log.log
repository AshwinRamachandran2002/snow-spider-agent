Below are up-to-ten exploratory Snowflake queries – from very simple “take a look” statements to a final aggregation – that will let you inspect the necessary columns and then compute the requested numbers / percentages.  
(Adjust LIMIT values if you need to see more rows.)

```sql
--Description: ❶  Inspect which alteration-types already exist in the CytoConverter output.
SELECT DISTINCT "Type"
FROM "MITELMAN"."PROD"."CYTOCONVERTED"
LIMIT 20;
```

```sql
--Description: ❷  Quick look at converted segments that belong to breast-cancer cases (morphology = ‘3111’).
SELECT cc."RefNo", cc."CaseNo", cc."InvNo", cc."Clone",
       cc."Chr", cc."Start", cc."End", cc."Type"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED" cc
JOIN   "MITELMAN"."PROD"."CYTOGEN"       cg
       ON  cc."RefNo" = cg."RefNo"
       AND cc."CaseNo" = cg."CaseNo"
WHERE  cg."Morph" = '3111'
LIMIT 20;
```

```sql
--Description: ❸  Quick look at converted segments that belong to adenocarcinoma cases (topography = ‘0401’).
SELECT cc."RefNo", cc."CaseNo", cc."InvNo", cc."Clone",
       cc."Chr", cc."Start", cc."End", cc."Type"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED" cc
JOIN   "MITELMAN"."PROD"."CYTOGEN"       cg
       ON  cc."RefNo" = cg."RefNo"
       AND cc."CaseNo" = cg."CaseNo"
WHERE  cg."Topo" = '0401'
LIMIT 20;
```

```sql
--Description: ❹  Determine the total size of the study cohort 
--              (unique RefNo-CaseNo-InvNo samples for breast cancer OR adenocarcinoma).
SELECT COUNT(DISTINCT cc."RefNo" || '-' || cc."CaseNo" || '-' || cc."InvNo") AS "n_samples"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED" cc
JOIN   "MITELMAN"."PROD"."CYTOGEN"       cg
       ON  cc."RefNo" = cg."RefNo"
       AND cc."CaseNo" = cg."CaseNo"
WHERE  cg."Morph" = '3111'
   OR  cg."Topo"  = '0401';
```

```sql
--Description: ❺  Make sure chromosomal segments really overlap with hg38 cytobands – breast-cancer example.
SELECT cc."RefNo", cc."CaseNo", cc."Chr",
       b."cytoband_name", b."hg38_start", b."hg38_stop",
       cc."Start", cc."End", cc."Type"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"   cc
JOIN   "MITELMAN"."PROD"."CYTOGEN"         cg
       ON  cc."RefNo" = cg."RefNo"
       AND cc."CaseNo" = cg."CaseNo"
JOIN   "MITELMAN"."PROD"."CYTOBANDS_HG38"  b
       ON  b."chromosome"  = cc."Chr"
       AND b."hg38_start" <= cc."End"
       AND b."hg38_stop"  >= cc."Start"
WHERE  cg."Morph" = '3111'
LIMIT 20;
```

```sql
--Description: ❻  Check whether “Amplification”, “Gain”, “Loss”, etc. really appear in the cohort we study.
SELECT DISTINCT cc."Type"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED" cc
JOIN   "MITELMAN"."PROD"."CYTOGEN"       cg
       ON  cc."RefNo" = cg."RefNo"
       AND cc."CaseNo" = cg."CaseNo"
WHERE  cg."Morph" = '3111'
   OR  cg."Topo"  = '0401'
LIMIT 20;
```

```sql
--Description: ❼  How many unique samples show a given type of alteration (any cytoband)?
SELECT cc."Type",
       COUNT(DISTINCT cc."RefNo" || '-' || cc."CaseNo" || '-' || cc."InvNo") AS "sample_with_type"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED" cc
JOIN   "MITELMAN"."PROD"."CYTOGEN"       cg
       ON  cc."RefNo" = cg."RefNo"
       AND cc."CaseNo" = cg."CaseNo"
WHERE  cg."Morph" = '3111'
   OR  cg."Topo"  = '0401'
GROUP BY cc."Type"
LIMIT 20;
```

```sql
--Description: ❽  Event-level counts per cytoband and alteration type across the combined cohort.
SELECT b."chromosome",
       b."cytoband_name",
       cc."Type",
       COUNT(*) AS "event_count"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"   cc
JOIN   "MITELMAN"."PROD"."CYTOGEN"         cg
       ON  cc."RefNo" = cg."RefNo"
       AND cc."CaseNo" = cg."CaseNo"
JOIN   "MITELMAN"."PROD"."CYTOBANDS_HG38"  b
       ON  b."chromosome"  = cc."Chr"
       AND b."hg38_start" <= cc."End"
       AND b."hg38_stop"  >= cc."Start"
WHERE  cg."Morph" = '3111'
   OR  cg."Topo"  = '0401'
GROUP BY b."chromosome", b."cytoband_name", cc."Type"
ORDER BY b."chromosome", b."cytoband_name"
LIMIT 20;
```

```sql
--Description: ❾  Sample-level counts (distinct samples) per cytoband & alteration type.
SELECT b."chromosome",
       b."cytoband_name",
       cc."Type",
       COUNT(DISTINCT cc."RefNo" || '-' || cc."CaseNo" || '-' || cc."InvNo") AS "n_samples"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"   cc
JOIN   "MITELMAN"."PROD"."CYTOGEN"         cg
       ON  cc."RefNo" = cg."RefNo"
       AND cc."CaseNo" = cg."CaseNo"
JOIN   "MITELMAN"."PROD"."CYTOBANDS_HG38"  b
       ON  b."chromosome"  = cc."Chr"
       AND b."hg38_start" <= cc."End"
       AND b."hg38_stop"  >= cc."Start"
WHERE  cg."Morph" = '3111'
   OR  cg."Topo"  = '0401'
GROUP BY b."chromosome", b."cytoband_name", cc."Type"
ORDER BY b."chromosome", b."cytoband_name"
LIMIT 20;
```

```sql
--Description: ❿  FINAL full aggregation – distinct-sample counts and cohort-frequency (%) of
--              Amplifications (>1 copy), Gains (+1), Losses (-1) and Homozygous deletions (-2)
--              per cytoband, sorted by chromosome ordinal then genomic position.
WITH cohort AS (
  SELECT DISTINCT cc."RefNo" || '-' || cc."CaseNo" || '-' || cc."InvNo" AS sid
  FROM   "MITELMAN"."PROD"."CYTOCONVERTED" cc
  JOIN   "MITELMAN"."PROD"."CYTOGEN"       cg
         ON  cc."RefNo" = cg."RefNo"
         AND cc."CaseNo" = cg."CaseNo"
  WHERE  cg."Morph" = '3111'
     OR  cg."Topo"  = '0401'
),
base AS (
  SELECT b."chromosome", b."cytoband_name", b."hg38_start",
         cc."Type",
         cc."RefNo" || '-' || cc."CaseNo" || '-' || cc."InvNo" AS sid
  FROM   "MITELMAN"."PROD"."CYTOCONVERTED"   cc
  JOIN   "MITELMAN"."PROD"."CYTOGEN"         cg
         ON  cc."RefNo" = cg."RefNo"
         AND cc."CaseNo" = cg."CaseNo"
  JOIN   "MITELMAN"."PROD"."CYTOBANDS_HG38"  b
         ON  b."chromosome"  = cc."Chr"
         AND b."hg38_start" <= cc."End"
         AND b."hg38_stop"  >= cc."Start"
  WHERE  cg."Morph" = '3111'
     OR  cg."Topo"  = '0401'
)
SELECT  b."chromosome",
        b."cytoband_name",
        COUNT(DISTINCT CASE WHEN b."Type" = 'Amplification' THEN b.sid END) AS "Amplifications",
        ROUND(100.0 * COUNT(DISTINCT CASE WHEN b."Type" = 'Amplification' THEN b.sid END)
              / (SELECT COUNT(*) FROM cohort), 2) AS "Amplifications_%",

        COUNT(DISTINCT CASE WHEN b."Type" = 'Gain' THEN b.sid END) AS "Gains",
        ROUND(100.0 * COUNT(DISTINCT CASE WHEN b."Type" = 'Gain' THEN b.sid END)
              / (SELECT COUNT(*) FROM cohort), 2) AS "Gains_%",

        COUNT(DISTINCT CASE WHEN b."Type" = 'Loss' THEN b.sid END) AS "Losses",
        ROUND(100.0 * COUNT(DISTINCT CASE WHEN b."Type" = 'Loss' THEN b.sid END)
              / (SELECT COUNT(*) FROM cohort), 2) AS "Losses_%",

        COUNT(DISTINCT CASE WHEN b."Type" IN ('HomLoss','HomozygousDeletion','HomDel') THEN b.sid END) AS "HomDel",
        ROUND(100.0 * COUNT(DISTINCT CASE WHEN b."Type" IN ('HomLoss','HomozygousDeletion','HomDel') THEN b.sid END)
              / (SELECT COUNT(*) FROM cohort), 2) AS "HomDel_%"
FROM  base b
GROUP BY b."chromosome", b."cytoband_name", b."hg38_start"
ORDER BY 
  CASE
        WHEN b."chromosome" = 'chrX' THEN 23
        WHEN b."chromosome" = 'chrY' THEN 24
        ELSE TO_NUMBER(REPLACE(b."chromosome",'chr',''))
  END,
  b."hg38_start"
LIMIT 20;
```

Run each step to confirm intermediate results; adjust column names inside the `IN ('HomLoss', …)` list if the exact homozygous-deletion tokens you discover in query ❻ differ.
