Query:
--Description: 7) Count clones per cytoband & event class in the cohort
SELECT  b."cytoband_name",
        cv."Type",
        COUNT(DISTINCT CONCAT(cv."RefNo",'-',cv."CaseNo",'-',cv."InvNo",'-',cv."Clone")) AS "N_clones"
FROM    "MITELMAN"."PROD"."CYTOCONVERTED"  cv
JOIN    "MITELMAN"."PROD"."CYTOGEN"        c
        ON  c."RefNo"  = cv."RefNo"
        AND c."CaseNo" = cv."CaseNo"
JOIN    "MITELMAN"."PROD"."CYTOBANDS_HG38" b
        ON  cv."Chr"   = b."chromosome"
        AND cv."Start" <= b."hg38_stop"
        AND cv."End"   >= b."hg38_start"
WHERE   c."Morph" = '3111'
