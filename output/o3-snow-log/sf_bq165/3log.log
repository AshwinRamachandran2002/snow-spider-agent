Some few-shot examples after column exploration may be helpful:
Query:
--Description: 1) Inspect the different copy-number event labels used by CytoConverter
SELECT DISTINCT "Type"
FROM "MITELMAN"."PROD"."CYTOCONVERTED"
LIMIT 20;
Answer:
Type
Gain
Loss
Query:
--Description: 2) Look-up morphology code “3111” in the code dictionary
SELECT "Kod", "Kortnamn", "Benamning"
FROM "MITELMAN"."PROD"."KODER"
WHERE "Kod" = '3111'
LIMIT 20;
Answer:
Kod,Kortnamn,Benamning
3111,CA ad,Adenocarcinoma
Query:
--Description: 3) Look-up topography code “0401” (adenocarcinoma) in the code dictionary
SELECT "Kod", "Kortnamn", "Benamning"
FROM "MITELMAN"."PROD"."KODER"
WHERE "Kod" = '0401'
LIMIT 20;
Answer:
Kod,Kortnamn,Benamning
0401,Breast,Breast
Query:
--Description: 5) Retrieve CytoConverter segments that belong to the filtered clinical cohort
SELECT  c."RefNo",
        c."CaseNo",
        cv."InvNo",
        cv."Clone"   AS "CloneNo",
        cv."Chr",
        cv."Start",
        cv."End",
        cv."Type"
FROM    "MITELMAN"."PROD"."CYTOGEN"       c
JOIN    "MITELMAN"."PROD"."CYTOCONVERTED" cv
        ON  c."RefNo"  = cv."RefNo"
        AND c."CaseNo" = cv."CaseNo"          -- CYTOGEN has no InvNo column
WHERE   c."Morph" = '3111'                    -- adenocarcinoma
    OR  c."Topo"  = '0401'                    -- breast
LIMIT 20
Answer:
RefNo,CaseNo,InvNo,CloneNo,Chr,Start,End,Type
