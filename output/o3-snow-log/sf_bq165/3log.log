--Description: 10) Final summary – counts & frequencies (rounded to 2-dec) of CNA classes per band
WITH cohort_clones AS (
    SELECT DISTINCT CONCAT(cv."RefNo",'-',cv."CaseNo",'-',cv."InvNo",'-',cv."Clone") AS "clone_id"
    FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  cv
    JOIN   "MITELMAN"."PROD"."CYTOGEN"        c
           ON c."RefNo"  = cv."RefNo"
          AND c."CaseNo" = cv."CaseNo"
    WHERE  c."Morph" = '3111'
       OR  c."Topo"  = '0401'
),
band_events AS (
    SELECT  b."chromosome",
            b."cytoband_name",
            b."hg38_start",
            b."hg38_stop",
            cv."Type",
            CONCAT(cv."RefNo",'-',cv."CaseNo",'-',cv."InvNo",'-',cv."Clone") AS "clone_id"
    FROM    "MITELMAN"."PROD"."CYTOCONVERTED"  cv
    JOIN    "MITELMAN"."PROD"."CYTOGEN"        c
            ON c."RefNo"  = cv."RefNo"
           AND c."CaseNo" = cv."CaseNo"
    JOIN    "MITELMAN"."PROD"."CYTOBANDS_HG38" b
            ON cv."Chr"   = b."chromosome"
           AND cv."Start" <= b."hg38_stop"
           AND cv."End"   >= b."hg38_start"
    WHERE   c."Morph" = '3111'
       OR   c."Topo"  = '0401'
)
SELECT  be."chromosome",
        be."cytoband_name",
        be."hg38_start",
        be."hg38_stop",
        be."Type"                                             AS "Event_class",
        COUNT(DISTINCT be."clone_id")                         AS "N_clones",
        ROUND(
              100.0 * COUNT(DISTINCT be."clone_id")
              / (SELECT COUNT(*) FROM cohort_clones)
             , 2
        )                                                     AS "Frequency_%"
FROM    band_events be
GROUP BY be."chromosome",
         be."cytoband_name",
         be."hg38_start",
         be."hg38_stop",
         be."Type"
ORDER BY
       CASE
           WHEN be."chromosome" = 'chrX' THEN 23
           WHEN be."chromosome" = 'chrY' THEN 24
           ELSE TO_NUMBER(REPLACE(be."chromosome",'chr',''))
       END,
       be."hg38_start",
       be."hg38_stop"
LIMIT 100
