--Description: 1) Inspect the different copy-number event labels used by CytoConverter
SELECT DISTINCT "Type"
FROM "MITELMAN"."PROD"."CYTOCONVERTED"
LIMIT 20;
```

```sql
--Description: 2) Look-up morphology code “3111” in the code dictionary
SELECT "Kod", "Kortnamn", "Benamning"
FROM "MITELMAN"."PROD"."KODER"
WHERE "Kod" = '3111'
LIMIT 20;
```

```sql
--Description: 3) Look-up topography code “0401” (adenocarcinoma) in the code dictionary
SELECT "Kod", "Kortnamn", "Benamning"
FROM "MITELMAN"."PROD"."KODER"
WHERE "Kod" = '0401'
LIMIT 20;
```

```sql
--Description: 4) Display clinical breast-cancer or adenocarcinoma cases recorded in CYTOGEN
SELECT "RefNo", "CaseNo", "InvNo", "Morph", "Topo", "Sex", "Age"
FROM "MITELMAN"."PROD"."CYTOGEN"
WHERE "Morph" = '3111'        -- breast carcinoma
   OR "Topo"  = '0401'        -- adenocarcinoma
LIMIT 20;
```

```sql
--Description: 5) Retrieve CytoConverter segments that belong to the above clinical cohort
SELECT c."RefNo", c."CaseNo", c."InvNo",
       cv."Clone"        AS "CloneNo",
       cv."Chr", cv."Start", cv."End", cv."Type"
FROM   "MITELMAN"."PROD"."CYTOGEN"        c
JOIN   "MITELMAN"."PROD"."CYTOCONVERTED"  cv
       ON  c."RefNo"  = cv."RefNo"
       AND c."CaseNo" = cv."CaseNo"
       AND c."InvNo"  = cv."InvNo"
WHERE  c."Morph" = '3111'
    OR c."Topo"  = '0401'
LIMIT 20;
```

```sql
--Description: 6) Map those segments to cytogenetic bands (hg38) – sample overlap check
SELECT cv."Chr",
       b."cytoband_name",
       cv."Type",
       cv."Start", cv."End",
       b."hg38_start", b."hg38_stop"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"   cv
JOIN   "MITELMAN"."PROD"."CYTOBANDS_HG38"  b
       ON  cv."Chr"   = b."chromosome"
       AND cv."Start" <= b."hg38_stop"
       AND cv."End"   >= b."hg38_start"
WHERE  cv."RefNo" IN (
          SELECT "RefNo"
          FROM   "MITELMAN"."PROD"."CYTOGEN"
          WHERE  "Morph" = '3111'
             OR  "Topo"  = '0401'
       )
LIMIT 20;
```

```sql
--Description: 7) Count how many clones in the cohort harbour each copy-number event per band
SELECT b."cytoband_name",
       cv."Type",
       COUNT(DISTINCT CONCAT(cv."RefNo",'-',cv."CaseNo",'-',cv."InvNo",'-',cv."Clone")) AS "N_clones"
FROM   "MITELMAN"."PROD"."CYTOGEN"        c
JOIN   "MITELMAN"."PROD"."CYTOCONVERTED"  cv
       ON  c."RefNo"  = cv."RefNo"
       AND c."CaseNo" = cv."CaseNo"
       AND c."InvNo"  = cv."InvNo"
JOIN   "MITELMAN"."PROD"."CYTOBANDS_HG38" b
       ON  cv."Chr"   = b."chromosome"
       AND cv."Start" <= b."hg38_stop"
       AND cv."End"   >= b."hg38_start"
WHERE  c."Morph" = '3111'
    OR c."Topo"  = '0401'
GROUP  BY b."cytoband_name", cv."Type"
LIMIT 20;
```

```sql
--Description: 8) Determine the total number of unique clones in the breast/adeno cohort (denominator)
SELECT COUNT(*) AS "Total_clones"
FROM  (
        SELECT DISTINCT CONCAT(cv."RefNo",'-',cv."CaseNo",'-',cv."InvNo",'-',cv."Clone") AS "clone_id"
        FROM  "MITELMAN"."PROD"."CYTOGEN"        c
        JOIN  "MITELMAN"."PROD"."CYTOCONVERTED"  cv
              ON c."RefNo" = cv."RefNo"
             AND c."CaseNo" = cv."CaseNo"
             AND c."InvNo"  = cv."InvNo"
        WHERE c."Morph" = '3111'
           OR c."Topo"  = '0401'
      ) q;
```

```sql
--Description: 9) Examine whether “Amp”, “Gain”, “Loss”, “Hdel” labels exist in the data
SELECT DISTINCT "Type"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"
WHERE  "Type" ILIKE '%amp%'
    OR "Type" ILIKE '%gain%'
    OR "Type" ILIKE '%loss%'
    OR "Type" ILIKE '%del%'
LIMIT 20;
```

```sql
--Description: 10) Final summary – number & frequency (rounded to 2 %) of each event class per band, ordered by chromosome & position
WITH cohort_clones AS (
    SELECT DISTINCT CONCAT(cv."RefNo",'-',cv."CaseNo",'-',cv."InvNo",'-',cv."Clone") AS "clone_id"
    FROM   "MITELMAN"."PROD"."CYTOGEN"        c
    JOIN   "MITELMAN"."PROD"."CYTOCONVERTED"  cv
           ON c."RefNo"  = cv."RefNo"
          AND c."CaseNo" = cv."CaseNo"
          AND c."InvNo"  = cv."InvNo"
    WHERE  c."Morph" = '3111'
       OR  c."Topo"  = '0401'
), band_events AS (
    SELECT b."chromosome",
           b."cytoband_name",
           b."hg38_start",
           b."hg38_stop",
           cv."Type",
           CONCAT(cv."RefNo",'-',cv."CaseNo",'-',cv."InvNo",'-',cv."Clone") AS "clone_id"
    FROM   "MITELMAN"."PROD"."CYTOGEN"        c
    JOIN   "MITELMAN"."PROD"."CYTOCONVERTED"  cv
           ON c."RefNo"  = cv."RefNo"
          AND c."CaseNo" = cv."CaseNo"
          AND c."InvNo"  = cv."InvNo"
    JOIN   "MITELMAN"."PROD"."CYTOBANDS_HG38" b
           ON cv."Chr"   = b."chromosome"
          AND cv."Start" <= b."hg38_stop"
          AND cv."End"   >= b."hg38_start"
    WHERE  c."Morph" = '3111'
       OR  c."Topo"  = '0401'
)
SELECT be."chromosome",
       be."cytoband_name",
       be."hg38_start",
       be."hg38_stop",
       be."Type"                        AS "Event_class",
       COUNT(DISTINCT be."clone_id")    AS "N_clones",
       ROUND(100.0 * COUNT(DISTINCT be."clone_id") /
             (SELECT COUNT(*) FROM cohort_clones), 2) AS "Frequency_%"
FROM   band_events be
GROUP  BY be."chromosome", be."cytoband_name",
          be."hg38_start", be."hg38_stop", be."Type"
ORDER BY
       CASE
            WHEN be."chromosome" = 'chrX' THEN 23
            WHEN be."chromosome" = 'chrY' THEN 24
            ELSE TO_NUMBER(REPLACE(be."chromosome",'chr',''))
       END,
       be."hg38_start",
       be."hg38_stop"
LIMIT 100;
```
