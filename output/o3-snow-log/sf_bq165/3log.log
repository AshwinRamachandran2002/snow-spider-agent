Query:
--Description: 6) Map the selected segments to hg38 cytogenetic bands (over-lap check)
SELECT  cv."Chr",
        b."cytoband_name",
        cv."Type",
        cv."Start",
        cv."End",
        b."hg38_start",
        b."hg38_stop"
FROM    "MITELMAN"."PROD"."CYTOCONVERTED"   cv
JOIN    "MITELMAN"."PROD"."CYTOBANDS_HG38"  b
        ON  cv."Chr"   = b."chromosome"
        AND cv."Start" <= b."hg38_stop"
        AND cv."End"   >= b."hg38_start"
WHERE   cv."RefNo" IN (
            SELECT "RefNo"
            FROM   "MITELMAN"."PROD"."CYTOGEN"
            WHERE  "Morph" = '3111'
               OR  "Topo"  = '0401'
        )
  AND   cv."CaseNo" IN (
            SELECT "CaseNo"
            FROM   "MITELMAN"."PROD"."CYTOGEN"
            WHERE  "Morph" = '3111'
               OR  "Topo"  = '0401'
        )
LIMIT 20
Answer:
Chr,cytoband_name,Type,Start,End,hg38_start,hg38_stop
chr14,14p13,Gain,0,50400000,0,3600000
chr14,14p12,Gain,0,50400000,3600000,8000000
chr14,14p11,Gain,0,50400000,8000000,17200000
