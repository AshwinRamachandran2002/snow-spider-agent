[{'RefNo': 401, 'CaseNo': '109', 'InvNo': 1, 'CloneNo': 1, 'OrderNo': 1, 'Abnormality': '??'}, {'RefNo': 737, 'CaseNo': '105', 'InvNo': 1, 'CloneNo': 1, 'OrderNo': 1, 'Abnormality': '??'}, {'RefNo': 737, 'CaseNo': '63', 'InvNo': 1, 'CloneNo': 1, 'OrderNo': 1, 'Abnormality': '??'}, {'RefNo': 737, 'CaseNo': '67', 'InvNo': 1, 'CloneNo': 1, 'OrderNo': 1, 'Abnormality': '??'}, {'RefNo': 737, 'CaseNo': '82', 'InvNo': 1, 'CloneNo': 1, 'OrderNo': 1, 'Abnormality': '??'}]

