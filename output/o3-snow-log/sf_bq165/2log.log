[{'RefNo': 2238, 'CaseNo': '24', 'InvNo': 1, 'Clone': 1, 'Chr': 'chr14', 'ChrOrd': 14, 'Start': 0, 'End': 50400000, 'Type': 'Gain', 'CellsPresent': 'unknown'}, {'RefNo': 15412, 'CaseNo': '4', 'InvNo': 1, 'Clone': 2, 'Chr': 'chr14', 'ChrOrd': 14, 'Start': 0, 'End': 50400000, 'Type': 'Gain', 'CellsPresent': 'unknown'}, {'RefNo': 5382, 'CaseNo': '40', 'InvNo': 1, 'Clone': 1, 'Chr': 'chr14', 'ChrOrd': 14, 'Start': 0, 'End': 50400000, 'Type': 'Gain', 'CellsPresent': 'unknown'}, {'RefNo': 7836, 'CaseNo': '32', 'InvNo': 1, 'Clone': 1, 'Chr': 'chr14', 'ChrOrd': 14, 'Start': 0, 'End': 50400000, 'Type': 'Gain', 'CellsPresent': 'unknown'}, {'RefNo': 15876, 'CaseNo': '22', 'InvNo': 1, 'Clone': 1, 'Chr': 'chr14', 'ChrOrd': 14, 'Start': 0, 'End': 50400000, 'Type': 'Gain', 'CellsPresent': 'unknown'}]

