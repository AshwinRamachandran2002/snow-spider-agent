```sql
--Description: 7) Count, per cytoband, how many breast/adenocarcinoma segments fall in it,
--              grouped by CytoConverter “Type”
SELECT
       b."cytoband_name"                AS "Band",
       t."Type",
       COUNT(*)                         AS "N_Segments"
FROM   MITELMAN.PROD.CYTOCONVERTED t
JOIN   MITELMAN.PROD.CYTOGEN       g
       ON  t."RefNo"  = g."RefNo"
       AND t."CaseNo" = g."CaseNo"
JOIN   MITELMAN.PROD.CYTOBANDS_HG38 b
       ON  t."Chr"   = b."chromosome"
       AND t."Start" <= b."hg38_stop"
       AND t."End"   >= b."hg38_start"
WHERE  g."Morph" = '3111'
   OR  g."Topo"  = '0401'
GROUP  BY b."cytoband_name", t."Type"
LIMIT  20;
```

```sql
--Description: 8) For every cytoband, count the number of unique breast/adenocarcinoma
--              cases that carry each copy-number class (Amplification, Gain, Loss, HomDel)
WITH cohort AS (          -- all relevant cases (no InvNo column here)
    SELECT DISTINCT g."RefNo", g."CaseNo"
    FROM   MITELMAN.PROD.CYTOGEN g
    WHERE  g."Morph" = '3111' OR g."Topo" = '0401'
), mapped AS (
    SELECT DISTINCT
           c."RefNo",
           c."CaseNo",
           c."InvNo",
           c."Type",
           b."cytoband_name"  AS "Band",
           b."chromosome",
           b."hg38_start",
           b."hg38_stop"
    FROM   MITELMAN.PROD.CYTOCONVERTED c
    JOIN   cohort h
           ON  c."RefNo"  = h."RefNo"
           AND c."CaseNo" = h."CaseNo"
    JOIN   MITELMAN.PROD.CYTOBANDS_HG38 b
           ON  c."Chr"   = b."chromosome"
           AND c."Start" <= b."hg38_stop"
           AND c."End"   >= b."hg38_start"
)
SELECT
       mapped."Band",
       mapped."Type",
       COUNT(DISTINCT mapped."RefNo" || '-' || mapped."CaseNo" || '-' || mapped."InvNo") AS "N_Cases"
FROM   mapped
GROUP  BY mapped."Band", mapped."Type"
LIMIT  20;
```

```sql
--Description: 9) Compute total number of breast-cancer plus adenocarcinoma cases
SELECT
       COUNT(DISTINCT g."RefNo" || '-' || g."CaseNo") AS "Total_Cases"
FROM   MITELMAN.PROD.CYTOGEN g
WHERE  g."Morph" = '3111'
   OR  g."Topo"  = '0401';
```

```sql
--Description: 10) Final summary – for every cytoband report N and frequency (%) of
--               Amplifications, Gains, Losses, HomDel among the cohort
WITH cohort AS (
    SELECT DISTINCT g."RefNo", g."CaseNo"
    FROM   MITELMAN.PROD.CYTOGEN g
    WHERE  g."Morph" = '3111' OR g."Topo" = '0401'
), total AS (
    SELECT COUNT(*) AS "TotalCases" FROM cohort
), mapped AS (
    SELECT DISTINCT
           c."RefNo",
           c."CaseNo",
           c."InvNo",
           CASE
               WHEN c."Type" ILIKE '%amplification%' THEN 'Amplification'
               WHEN c."Type" = 'Gain'                THEN 'Gain'
               WHEN c."Type" = 'Loss'                THEN 'Loss'
               WHEN c."Type" ILIKE '%homozygous%'    THEN 'HomDel'
           END                        AS "Class",
           b."cytoband_name"          AS "Band",
           b."chromosome",
           b."hg38_start",
           b."hg38_stop"
    FROM   MITELMAN.PROD.CYTOCONVERTED c
    JOIN   cohort h
           ON  c."RefNo"  = h."RefNo"
           AND c."CaseNo" = h."CaseNo"
    JOIN   MITELMAN.PROD.CYTOBANDS_HG38 b
           ON  c."Chr"   = b."chromosome"
           AND c."Start" <= b."hg38_stop"
           AND c."End"   >= b."hg38_start"
    WHERE  c."Type" IN ('Gain','Loss')
       OR  c."Type" ILIKE '%amplification%'
       OR  c."Type" ILIKE '%homozygous%'
), per_band AS (
    SELECT
           m."Band",
           m."chromosome",
           m."hg38_start",
           m."hg38_stop",
           m."Class",
           COUNT(DISTINCT m."RefNo" || '-' || m."CaseNo" || '-' || m."InvNo") AS "N_Cases"
    FROM   mapped m
    GROUP  BY m."Band", m."chromosome", m."hg38_start", m."hg38_stop", m."Class"
)
SELECT
       p."Band",
       p."chromosome",
       p."hg38_start",
       p."hg38_stop",
       p."Class",
       p."N_Cases",
       TO_CHAR(100.0 * p."N_Cases" / t."TotalCases", 'FM999990.00') || '%' AS "Frequency"
FROM   per_band p
CROSS  JOIN total t
ORDER  BY CAST(SUBSTR(p."chromosome",4) AS NUMBER),  -- strip 'chr' prefix
          p."hg38_start",
          p."hg38_stop",
          p."Class"
LIMIT  20;
```
