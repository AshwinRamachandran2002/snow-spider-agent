--Description: 8) For every cytoband, count the number of unique breast/adenocarcinoma
--              cases that carry each copy-number class (Amplification, Gain, Loss, HomDel)
WITH cohort AS (          -- all relevant cases (no InvNo column here)
    SELECT DISTINCT g."RefNo", g."CaseNo"
    FROM   MITELMAN.PROD.CYTOGEN g
    WHERE  g."Morph" = '3111' OR g."Topo" = '0401'
), mapped AS (
    SELECT DISTINCT
           c."RefNo",
           c."CaseNo",
           c."InvNo",
           c."Type",
           b."cytoband_name"  AS "Band",
           b."chromosome",
           b."hg38_start",
           b."hg38_stop"
    FROM   MITELMAN.PROD.CYTOCONVERTED c
    JOIN   cohort h
           ON  c."RefNo"  = h."RefNo"
           AND c."CaseNo" = h."CaseNo"
    JOIN   MITELMAN.PROD.CYTOBANDS_HG38 b
           ON  c."Chr"   = b."chromosome"
           AND c."Start" <= b."hg38_stop"
           AND c."End"   >= b."hg38_start"
)
SELECT
       mapped."Band",
       mapped."Type",
       COUNT(DISTINCT mapped."RefNo" || '-' || mapped."CaseNo" || '-' || mapped."InvNo") AS "N_Cases"
FROM   mapped
GROUP  BY mapped."Band", mapped."Type"
LIMIT  20
