```sql
-- 7. Description: Count how many breast/adenocarcinoma segments fall in each band,
--    by CytoConverter “Type”  
SELECT  
    b."cytoband_name"          AS "Band",
    COUNT(*)                   AS "N_Segments",
    t."Type"
FROM MITELMAN.PROD.CYTOCONVERTED t
JOIN MITELMAN.PROD.CYTOGEN g
      ON  t."RefNo"  = g."RefNo"
     AND t."CaseNo" = g."CaseNo"
     AND t."InvNo"  = g."InvNo"
JOIN MITELMAN.PROD.CYTOBANDS_HG38 b
      ON  t."Chr"           = b."chromosome"
     AND t."Start" <= b."hg38_stop"
     AND t."End"   >= b."hg38_start"
WHERE g."Morph" = '3111'
   OR g."Topo"  = '0401'
GROUP BY b."cytoband_name", t."Type"
LIMIT 20;
```

```sql
-- 8. Description: Determine per-band copy-number class (Amp >1 copy, Gain =1 extra,
--    Loss =1 lost, HomDel =2 lost) and count number of unique cases that harbour it  
WITH cohort AS (  -- breast cancer OR adenocarcinoma cases
    SELECT DISTINCT g."RefNo", g."CaseNo", g."InvNo"
    FROM MITELMAN.PROD.CYTOGEN g
    WHERE g."Morph" = '3111' OR g."Topo" = '0401'
), mapped AS (
    SELECT DISTINCT
        c."RefNo",
        c."CaseNo",
        c."InvNo",
        c."Type",          -- Gain / Amplification / Loss / HomozygousDeletion
        b."cytoband_name"  AS "Band",
        b."chromosome",
        b."hg38_start",
        b."hg38_stop"
    FROM MITELMAN.PROD.CYTOCONVERTED c
    JOIN cohort h
      ON  c."RefNo" = h."RefNo"
     AND c."CaseNo" = h."CaseNo"
     AND c."InvNo"  = h."InvNo"
    JOIN MITELMAN.PROD.CYTOBANDS_HG38 b
      ON  c."Chr"           = b."chromosome"
     AND c."Start" <= b."hg38_stop"
     AND c."End"   >= b."hg38_start"
)
SELECT 
    mapped."Band",
    mapped."Type",
    COUNT(DISTINCT mapped."RefNo" || '-' || mapped."CaseNo" || '-' || mapped."InvNo") AS "N_Cases"
FROM mapped
GROUP BY mapped."Band", mapped."Type"
LIMIT 20;
```

```sql
-- 9. Description: Calculate total number of breast/adenocarcinoma cases in the cohort  
SELECT 
    COUNT(DISTINCT g."RefNo" || '-' || g."CaseNo" || '-' || g."InvNo") AS "Total_Cases"
FROM MITELMAN.PROD.CYTOGEN g
WHERE g."Morph" = '3111'
   OR g."Topo"  = '0401';
```

```sql
-- 10. Description: Final query – for every cytoband report the number and frequency
--     (percentage, 2 decimals) of Amplifications, Gains, Losses and HomDel
WITH cohort AS (
    SELECT DISTINCT g."RefNo", g."CaseNo", g."InvNo"
    FROM MITELMAN.PROD.CYTOGEN g
    WHERE g."Morph" = '3111' OR g."Topo" = '0401'
), total AS (
    SELECT COUNT(*) AS "TotalCases"
    FROM cohort
), mapped AS (
    SELECT DISTINCT
        c."RefNo",
        c."CaseNo",
        c."InvNo",
        CASE 
            WHEN c."Type" ILIKE '%amplification%' THEN 'Amplification'
            WHEN c."Type" = 'Gain'                 THEN 'Gain'
            WHEN c."Type" = 'Loss'                 THEN 'Loss'
            WHEN c."Type" ILIKE '%homozygous%'     THEN 'HomDel'
        END                                         AS "Class",
        b."cytoband_name"                          AS "Band",
        b."chromosome",
        b."hg38_start",
        b."hg38_stop"
    FROM MITELMAN.PROD.CYTOCONVERTED c
    JOIN cohort h
      ON  c."RefNo" = h."RefNo"
     AND c."CaseNo" = h."CaseNo"
     AND c."InvNo"  = h."InvNo"
    JOIN MITELMAN.PROD.CYTOBANDS_HG38 b
      ON  c."Chr"           = b."chromosome"
     AND c."Start" <= b."hg38_stop"
     AND c."End"   >= b."hg38_start"
    WHERE c."Type" IN ('Gain','Loss') 
       OR c."Type" ILIKE '%amplification%' 
       OR c."Type" ILIKE '%homozygous%'
), per_band AS (
    SELECT
        m."Band",
        m."chromosome",
        m."hg38_start",
        m."hg38_stop",
        m."Class",
        COUNT(DISTINCT m."RefNo" || '-' || m."CaseNo" || '-' || m."InvNo") AS "N_Cases"
    FROM mapped m
    GROUP BY m."Band", m."chromosome", m."hg38_start", m."hg38_stop", m."Class"
)
SELECT 
    p."Band",
    p."chromosome",
    p."hg38_start",
    p."hg38_stop",
    p."Class",
    p."N_Cases",
    TO_CHAR(100.0 * p."N_Cases" / t."TotalCases", 'FM999990.00') || '%' AS "Frequency"
FROM per_band p
CROSS JOIN total t
ORDER BY CAST(SUBSTR(p."chromosome",4) AS NUMBER),  -- removes 'chr' prefix
         p."hg38_start",
         p."hg38_stop",
         p."Class"
LIMIT 20;
```
