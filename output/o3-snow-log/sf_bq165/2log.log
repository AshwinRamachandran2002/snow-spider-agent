Table full name: MITELMAN.PROD.REFERENCE
Column name: Journal Type: TEXT Description: journal name abbreviation, eg 'Cancer Genet Cytogenet'
Column name: AuthorsLength Type: TEXT Description: author string length, up to 2411
Column name: Flag Type: TEXT Description: this field is always blank
Column name: Abbreviation Type: TEXT Description: author abbreviation, eg 'Park et al 2009'
Column name: Year Type: NUMBER Description: publication year, eg '1998'
Column name: Pubmed Type: TEXT Description: PubMed identifier, if available, eg '17334343'
Column name: TitleLength Type: NUMBER Description: length of title, up to 334
Column name: AuthorsLong Type: TEXT Description: blank or complete, long author string
Column name: Text Type: TEXT Description: this field is always blank
Column name: AuthorsShort Type: TEXT Description: short or truncated author string, eg 'Atkin NB, Baker MC'
Column name: TitleLong Type: TEXT Description: blank for shorter titles, otherwise the full title is in this field
Column name: RefNo Type: NUMBER Description: reference number from 10 to 15880
Column name: Volume Type: TEXT Description: journal volume, eg '95:96-101'
Column name: TitleShort Type: TEXT Description: short or truncated title, eg aThe myeloperoxidase gene in acute promyelocytic leukemia'
Sample rows:
[{'RefNo': 32, 'TitleLength': 56, 'TitleShort': 'Identification of isochromosome 17 in myeloid leukaemia.', 'TitleLong': None, 'Volume': '(1):849-850', 'Year': 1972, 'Journal': 'Lancet', 'Text': None, 'Abbreviation': 'Lobb et al 1972', 'AuthorsLength': '29', 'AuthorsShort': 'Lobb DS, Reeves BR, Lawler SD', 'AuthorsLong': None, 'Flag': ' ', 'Pubmed': '4111610'}, {'RefNo': 102, 'TitleLength': 60, 'TitleShort': 'Multiple chromosome aberrations in a lymphosarcomatous tumor', 'TitleLong': None, 'Volume': '70:243-258', 'Year': 1972, 'Journal': 'Hereditas', 'Text': None, 'Abbreviation': 'Fleischmann et al 1972', 'AuthorsLength': '46', 'AuthorsShort': 'Fleischmann T, Hakansson CH, Levan A, Moller T', 'AuthorsLong': None, 'Flag': ' ', 'Pubmed': '4681795'}, {'RefNo': 86, 'TitleLength': 79, 'TitleShort': 'Identity of the abnormal F-group chromosome associated with polycythaemia vera.', 'TitleLong': None, 'Volume': '14:159-161', 'Year': 1972, 'Journal': 'Humangenetik', 'Text': None, 'Abbreviation': 'Reeves et al 1972', 'AuthorsLength': '29', 'AuthorsShort': 'Reeves BR, Lobb DS, Lawler SD', 'AuthorsLong': None, 'Flag': ' ', 'Pubmed': '5026848'}, {'RefNo': 115, 'TitleLength': 159, 'TitleShort': 'Cytological and cytogenetical studies on brain tumors. IV. Identification of the missing G chromosome in human meningiomas as No. 22 by fluorescence technique.', 'TitleLong': None, 'Volume': '14:167-169', 'Year': 1972, 'Journal': 'Humangenetik', 'Text': None, 'Abbreviation': 'Zankl & Zang 1972', 'AuthorsLength': '16', 'AuthorsShort': 'Zankl H, Zang KD', 'AuthorsLong': None, 'Flag': ' ', 'Pubmed': '4112733'}, {'RefNo': 71, 'TitleLength': 99, 'TitleShort': '"A ""Philadelphia-like"" chromosome derived from the Y in a patient with refractory dysplastic anemia."', 'TitleLong': None, 'Volume': '42:799-804', 'Year': 1973, 'Journal': 'Blood', 'Text': None, 'Abbreviation': 'Warburton & Bluming 1973', 'AuthorsLength': '22', 'AuthorsShort': 'Warburton D, Bluming A', 'AuthorsLong': None, 'Flag': ' ', 'Pubmed': '4746103'}]

