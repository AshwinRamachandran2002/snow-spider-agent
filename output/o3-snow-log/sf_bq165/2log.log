```sql
-- 6. Description: Map breast/adenocarcinoma CytoConverter segments to their overlapping
--    cytobands (one row per segment–band overlap) – preview only  
SELECT 
    t."RefNo",
    t."CaseNo",
    t."InvNo",
    t."Chr",
    b."cytoband_name",
    b."hg38_start",
    b."hg38_stop",
    t."Type"
FROM MITELMAN.PROD.CYTOCONVERTED t
JOIN MITELMAN.PROD.CYTOGEN g
      ON  t."RefNo"  = g."RefNo"
     AND t."CaseNo" = g."CaseNo"
     AND t."InvNo"  = g."InvNo"
JOIN MITELMAN.PROD.CYTOBANDS_HG38 b
      ON  t."Chr"           = b."chromosome"
     AND t."Start" <= b."hg38_stop"
     AND t."End"   >= b."hg38_start"
WHERE g."Morph" = '3111'
   OR g."Topo"  = '0401'
LIMIT 20;
