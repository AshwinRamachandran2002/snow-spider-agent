Table full name: MITELMAN.PROD.MOLCLINGENE
Column name: Prefix Type: TEXT Description: prefix string -- either blank or '+' 
Column name: InvNo Type: NUMBER Description: investigation number, usually between 1 and 10
Column name: MolClin Type: TEXT Description: flag indicating either molecular 'M', or clinical 'C'
Column name: Gene Type: TEXT Description: gene symbol(s), eg 'KMT2A' or 'BCR/ABL1'
Column name: OrderNo Type: NUMBER Description: order number, between 1 and 15
Column name: RefNo Type: NUMBER Description: reference number, eg '15563'
Column name: Suffix Type: TEXT Description: suffix string -- either blank or '+'
