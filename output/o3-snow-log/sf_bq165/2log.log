```sql
--Description: 6) Show breast/adenocarcinoma CytoConverter segments and the cytobands
--              they overlap – join CYTOCONVERTED ↔ CYTOGEN on RefNo + CaseNo only
SELECT
       t."RefNo",
       t."CaseNo",
       t."InvNo",
       t."Chr",
