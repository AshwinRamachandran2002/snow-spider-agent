```sql
--Description: The CAST failure occurred when ordering by chromosome because ‘X’ and ‘Y’
--cannot convert to numbers.  Fix the ORDER BY by mapping ‘X’→23, ‘Y’→24, else convert
--the numeric part (“chr” stripped) with TRY_TO_NUMBER.  The query:
--  1. Builds the breast-cancer (Morph 3111) ∪ adenocarcinoma (Topo 0401) cohort.
--  2. Maps every CytoConverter segment in that cohort to overlapping cytobands.
--  3. Re-labels copy-number “Type” into four classes (Amplification, Gain, Loss, HomDel).
--  4. Counts unique cases (RefNo-CaseNo-InvNo) per band & class.
--  5. Computes frequency (%) using the cohort total.
--  6. Sorts by chromosome ordinal then genomic start/stop then class.
WITH cohort AS (                       -- step 1
    SELECT DISTINCT "RefNo", "CaseNo"
    FROM MITELMAN.PROD.CYTOGEN
    WHERE "Morph" = '3111'             -- breast cancer
       OR "Topo"  = '0401'             -- adenocarcinoma
),
total AS (                             -- step 5 denominator
    SELECT COUNT(*) AS "TotalCases" FROM cohort
),
mapped AS (                            -- steps 2 & 3
    SELECT DISTINCT
           c."RefNo",
           c."CaseNo",
           c."InvNo",
           CASE
               WHEN c."Type" ILIKE '%amplification%' THEN 'Amplification'
               WHEN c."Type" = 'Gain'                THEN 'Gain'
               WHEN c."Type" = 'Loss'                THEN 'Loss'
               WHEN c."Type" ILIKE '%homozygous%'    THEN 'HomDel'
           END                         AS "Class",
           b."cytoband_name"           AS "Band",
           b."chromosome",
           b."hg38_start",
           b."hg38_stop"
    FROM MITELMAN.PROD.CYTOCONVERTED   c
    JOIN cohort                         h  ON c."RefNo"  = h."RefNo"
                                           AND c."CaseNo" = h."CaseNo"
    JOIN MITELMAN.PROD.CYTOBANDS_HG38  b  ON c."Chr"     = b."chromosome"
                                           AND c."Start" <= b."hg38_stop"
                                           AND c."End"   >= b."hg38_start"
    WHERE c."Type" IN ('Gain','Loss')        -- keep gains & losses
       OR c."Type" ILIKE '%amplification%'   -- keep amplifications
       OR c."Type" ILIKE '%homozygous%'      -- keep homo-del
),
per_band AS (                          -- step 4
    SELECT
           m."Band",
           m."chromosome",
           m."hg38_start",
           m."hg38_stop",
           m."Class",
           COUNT(DISTINCT m."RefNo" || '-' || m."CaseNo" || '-' || m."InvNo") AS "N_Cases"
    FROM mapped m
    GROUP BY m."Band", m."chromosome", m."hg38_start", m."hg38_stop", m."Class"
)
SELECT
       p."Band",
       p."chromosome",
       p."hg38_start",
       p."hg38_stop",
       p."Class",
       p."N_Cases",
       TO_CHAR(100.0 * p."N_Cases" / t."TotalCases", 'FM999990.00') || '%' AS "Frequency"
FROM per_band p
CROSS JOIN total t
ORDER BY                                   -- step 6
       CASE
           WHEN SUBSTR(p."chromosome",4) = 'X' THEN 23
           WHEN SUBSTR(p."chromosome",4) = 'Y' THEN 24
           ELSE TRY_TO_NUMBER(SUBSTR(p."chromosome",4))
       END,
       p."hg38_start",
       p."hg38_stop",
       p."Class"
LIMIT 20;
```
