JOIN   MITELMAN.PROD.CYTOGEN       g
       ON  t."RefNo"  = g."RefNo"
       AND t."CaseNo" = g."CaseNo"
JOIN   MITELMAN.PROD.CYTOBANDS_HG38 b
       ON  t."Chr"   = b."chromosome"
       AND t."Start" <= b."hg38_stop"
       AND t."End"   >= b."hg38_start"
WHERE  g."Morph" = '3111'
   OR  g."Topo"  = '0401'
