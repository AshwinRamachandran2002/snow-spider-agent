--Description: example join of CytoConverter segments with cytoband table for breast-cancer cases
SELECT 
    c."Chr",
    b."cytoband_name",
    MIN(c."Start") AS "seg_start",
    MAX(c."End")   AS "seg_end",
    COUNT(*)       AS "n_segments"
FROM MITELMAN.PROD.CYTOCONVERTED  c
JOIN MITELMAN.PROD.CYTOGEN        g
  ON c."RefNo"  = g."RefNo"
 AND c."CaseNo" = g."CaseNo"
JOIN MITELMAN.PROD.CYTOBANDS_HG38 b
  ON c."Chr"  = b."chromosome"
 AND c."Start" >= b."hg38_start"
 AND c."End"   <= b."hg38_stop"
WHERE g."Morph" = '3111'
GROUP BY 
    c."Chr",
    b."cytoband_name"
LIMIT 20
