```sql
--Description (thinking process): 
-- 1. Previous error stemmed from converting chromosome labels 'X' or 'Y' to numbers.  
-- 2. Fix: Strip the 'chr' prefix, use TRY_TO_NUMBER; where NULL (i.e., X or Y) map X→23, Y→24.  
-- 3. Cohort definition: include CytoConverter segments whose cases are either (a) breast-cancer morphology 3111 
--    or (b) breast-site adenocarcinoma topology 0401.  
-- 4. Join each segment to the hg38 cytoband it lies wholly within.  
-- 5. Aggregate per band & cohort: count amplifications (“Amp”), single-copy gains (“Gain”), single-copy losses (“Loss”), 
--    and homozygous deletions (“Del”); compute percentages.  
-- 6. Order the result by chromosome ordinal then band start.  Return first 20 rows as preview.
WITH cohort AS (
    SELECT
        CASE
            WHEN g."Morph" = '3111' THEN 'BREAST_3111'
            WHEN g."Topo"  = '0401' THEN 'ADENO_0401'
        END             AS "Cohort",
        c."Chr",
        c."Start",
        c."End",
        c."Type"
    FROM MITELMAN.PROD.CYTOCONVERTED c
    JOIN MITELMAN.PROD.CYTOGEN      g
      ON c."RefNo"  = g."RefNo"
     AND c."CaseNo" = g."CaseNo"
    WHERE g."Morph" = '3111'
       OR g."Topo"  = '0401'
), band_map AS (
    SELECT
        h."chromosome"    AS "Chr",
        h."cytoband_name" AS "Band",
        h."hg38_start",
        h."hg38_stop"
    FROM MITELMAN.PROD.CYTOBANDS_HG38 h
)
SELECT
    bm."Chr",
    bm."Band",
    bm."hg38_start"                     AS "BandStart",
    ch."Cohort",
    COUNT_IF(ch."Type" = 'Amp')  AS "n_amp",
    COUNT_IF(ch."Type" = 'Gain') AS "n_gain",
    COUNT_IF(ch."Type" = 'Loss') AS "n_loss",
    COUNT_IF(ch."Type" = 'Del')  AS "n_homdel",
    ROUND(100.0 * COUNT_IF(ch."Type" = 'Amp')  / COUNT(*), 2) AS "pct_amp",
    ROUND(100.0 * COUNT_IF(ch."Type" = 'Gain') / COUNT(*), 2) AS "pct_gain",
    ROUND(100.0 * COUNT_IF(ch."Type" = 'Loss') / COUNT(*), 2) AS "pct_loss",
    ROUND(100.0 * COUNT_IF(ch."Type" = 'Del')  / COUNT(*), 2) AS "pct_homdel"
FROM cohort ch
JOIN band_map bm
  ON ch."Chr"  = bm."Chr"
 AND ch."Start" >= bm."hg38_start"
 AND ch."End"   <= bm."hg38_stop"
GROUP BY
    bm."Chr",
    bm."Band",
    bm."hg38_start",
    ch."Cohort"
ORDER BY
    COALESCE(
        TRY_TO_NUMBER(REPLACE(bm."Chr", 'chr', '')),
        CASE REPLACE(bm."Chr", 'chr', '')
             WHEN 'X' THEN 23
             WHEN 'Y' THEN 24
        END
    ),
    bm."hg38_start"
LIMIT 20;
```
