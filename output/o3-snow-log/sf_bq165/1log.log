--Description: compute counts & percentages of copy-number classes per cytoband for breast (3111) and adenocarcinoma (0401);
--adds band start coordinate to satisfy ORDER BY after GROUP BY
WITH cohort AS (
    SELECT
        CASE 
            WHEN g."Morph" = '3111' THEN 'BREAST_3111'
            WHEN g."Topo"  = '0401' THEN 'ADENO_0401'
        END                    AS "Cohort",
        c."RefNo",
        c."CaseNo",
        c."InvNo",
        c."Clone",
        c."Chr",
        c."Start",
        c."End",
        c."Type"
    FROM MITELMAN.PROD.CYTOCONVERTED c
    JOIN MITELMAN.PROD.CYTOGEN      g
      ON c."RefNo"  = g."RefNo"
     AND c."CaseNo" = g."CaseNo"
    WHERE g."Morph" = '3111'
       OR g."Topo"  = '0401'
), band_map AS (
    SELECT 
        h."chromosome"    AS "Chr",
        h."cytoband_name" AS "Band",
        h."hg38_start",
        h."hg38_stop"
    FROM MITELMAN.PROD.CYTOBANDS_HG38 h
)
SELECT 
    bm."Chr",
    bm."Band",
    bm."hg38_start"               AS "BandStart",
    ch."Cohort",
    COUNT_IF(ch."Type" = 'Amp')   AS "n_amp",
    COUNT_IF(ch."Type" = 'Gain')  AS "n_gain",
    COUNT_IF(ch."Type" = 'Loss')  AS "n_loss",
    COUNT_IF(ch."Type" = 'Del')   AS "n_homdel",
    ROUND(100.0 * COUNT_IF(ch."Type" = 'Amp')  / COUNT(*), 2) AS "pct_amp",
    ROUND(100.0 * COUNT_IF(ch."Type" = 'Gain') / COUNT(*), 2) AS "pct_gain",
    ROUND(100.0 * COUNT_IF(ch."Type" = 'Loss') / COUNT(*), 2) AS "pct_loss",
    ROUND(100.0 * COUNT_IF(ch."Type" = 'Del')  / COUNT(*), 2) AS "pct_homdel"
FROM cohort   ch
JOIN band_map bm
  ON ch."Chr"  = bm."Chr"
 AND ch."Start" >= bm."hg38_start"
 AND ch."End"   <= bm."hg38_stop"
GROUP BY 
    bm."Chr",
    bm."Band",
    bm."hg38_start",
    ch."Cohort"
ORDER BY 
    TO_NUMBER(REPLACE(bm."Chr", 'chr', '')) NULLS LAST,
    bm."hg38_start" ASC
LIMIT 20
