JOIN MITELMAN.PROD.CYTOBANDS_HG38 b
  ON c."Chr"  = b."chromosome"
 AND c."Start" >= b."hg38_start"
 AND c."End"   <= b."hg38_stop"
WHERE g."Morph" = '3111'
GROUP BY 
    c."Chr",
    b."cytoband_name"
LIMIT 20
