```sql
--Description: 1)  Take a quick look at which morphology codes exist in CYTOGEN and
--              confirm that code “3111” (breast carcinoma) is present.
SELECT DISTINCT "Morph"
FROM "MITELMAN"."PROD"."CYTOGEN"
ORDER BY "Morph"
LIMIT 20;
```

```sql
--Description: 2)  Display 20 breast-cancer cases (Morph = ‘3111’) with the
--              reference number (“RefNo”) and case number (“CaseNo”)
--              that we later need for joining to the CytoConverter output.
SELECT "RefNo",
       "CaseNo",
       "Age",
       "Sex",
       "Country"
FROM   "MITELMAN"."PROD"."CYTOGEN"
WHERE  "Morph" = '3111'
LIMIT 20;
```

```sql
--Description: 3)  Check what the “0401” topography code represents in the
--              master–code table (“KODER”).
SELECT  "Kod"        AS "Code",
        "Benamning"  AS "Long_Name",
        "Kortnamn"   AS "Short_Name",
        "KodTyp"
FROM    "MITELMAN"."PROD"."KODER"
WHERE   "Kod" = '0401'
LIMIT 20;
```

```sql
--Description: 4)  Pull 20 adenocarcinoma samples (Topo = ‘0401’) from CYTOGEN
--              to obtain their “RefNo” / “CaseNo”.
SELECT "RefNo",
       "CaseNo",
       "Morph",
       "Topo",
       "Age",
       "Sex"
FROM   "MITELMAN"."PROD"."CYTOGEN"
WHERE  "Topo" = '0401'
LIMIT 20;
```

```sql
--Description: 5)  Inspect the CytoConverter output (“CYTOCONVERTED”) for
--              those breast-cancer cases collected above.  We retrieve the
--              genomic interval together with the alteration “Type”.
SELECT  c."RefNo",
        c."CaseNo",
        c."InvNo",
        c."Clone"      AS "CloneNo",
        c."Chr"        AS "Chromosome",
        c."Start",
        c."End",
        c."Type"
FROM    "MITELMAN"."PROD"."CYTOCONVERTED"  c
JOIN    "MITELMAN"."PROD"."CYTOGEN"        g
  ON    c."RefNo"  = g."RefNo"
  AND   c."CaseNo" = g."CaseNo"
WHERE   g."Morph" = '3111'                         -- breast cancer
LIMIT   20;
```

```sql
--Description: 6)  Find out which alteration categories (“Type”) are produced
--              by CytoConverter; we expect terms such as Gain, Loss, Amp,
--              HomLoss, etc.
SELECT DISTINCT "Type"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"
ORDER  BY "Type"
LIMIT 20;
```

```sql
--Description: 7)  Join CytoConverter intervals for breast cancer (Morph = 3111)
--              and/or adenocarcinoma (Topo = 0401) to the hg38 cytoband
--              definitions in order to map each interval to the affected band.
SELECT  cv."RefNo",
        cv."CaseNo",
        cv."Chr"               AS "Chromosome",
        bd."cytoband_name"     AS "Band",
        bd."hg38_start",
        bd."hg38_stop",
        cv."Start",
        cv."End",
        cv."Type"
FROM    "MITELMAN"."PROD"."CYTOCONVERTED"  cv
JOIN    "MITELMAN"."PROD"."CYTOGEN"        cg
  ON    cv."RefNo"  = cg."RefNo"
  AND   cv."CaseNo" = cg."CaseNo"
JOIN    "MITELMAN"."PROD"."CYTOBANDS_HG38" bd
  ON    bd."chromosome" = cv."Chr"
  AND   bd."hg38_start" < cv."End"          -- interval overlaps band
  AND   bd."hg38_stop"  > cv."Start"
WHERE   (cg."Morph" = '3111' OR cg."Topo" = '0401')
LIMIT   20;
```

```sql
--Description: 8)  Count how many clones show each alteration category
--              (Amp/Gain/Loss/HomLoss) per cytoband in the selected cohort.
SELECT  bd."cytoband_name"                                   AS "Band",
        cv."Type",
        COUNT(*)                                             AS "N_Clones"
FROM    "MITELMAN"."PROD"."CYTOCONVERTED"  cv
JOIN    "MITELMAN"."PROD"."CYTOGEN"        cg
  ON    cv."RefNo"  = cg."RefNo"
  AND   cv."CaseNo" = cg."CaseNo"
JOIN    "MITELMAN"."PROD"."CYTOBANDS_HG38" bd
  ON    bd."chromosome" = cv."Chr"
  AND   bd."hg38_start" < cv."End"
  AND   bd."hg38_stop"  > cv."Start"
WHERE   (cg."Morph" = '3111' OR cg."Topo" = '0401')
GROUP BY bd."cytoband_name", cv."Type"
ORDER BY bd."cytoband_name", cv."Type"
LIMIT   20;
```

```sql
--Description: 9)  Compute, for each cytoband, the total number of examined
--              clones in the cohort – information needed to transform raw
--              counts into percentages.
SELECT  bd."cytoband_name"               AS "Band",
        COUNT(DISTINCT cv."RefNo"
                      ||':'||cv."CaseNo"
                      ||':'||cv."InvNo"
                      ||':'||cv."Clone")  AS "Total_Clones"
FROM    "MITELMAN"."PROD"."CYTOCONVERTED"  cv
JOIN    "MITELMAN"."PROD"."CYTOGEN"        cg
  ON    cv."RefNo"  = cg."RefNo"
  AND   cv."CaseNo" = cg."CaseNo"
JOIN    "MITELMAN"."PROD"."CYTOBANDS_HG38" bd
  ON    bd."chromosome" = cv."Chr"
  AND   bd."hg38_start" < cv."End"
  AND   bd."hg38_stop"  > cv."Start"
WHERE   (cg."Morph" = '3111' OR cg."Topo" = '0401')
GROUP BY bd."cytoband_name"
ORDER BY bd."cytoband_name"
LIMIT   20;
```

```sql
--Description: 10)  Bring everything together – for each cytoband report the
--               absolute counts and the percentage (two decimals) of
--               amplifications (Amp), single-copy gains (Gain),
--               single-copy losses (Loss) and homozygous deletions (HomLoss).
--               Bands are ordered by chromosome ordinal and genomic start.
SELECT  bd."chromosome",
        bd."hg38_start",
        bd."hg38_stop",
        bd."cytoband_name"                                      AS "Band",
        SUM(CASE WHEN cv."Type" = 'Amp'     THEN 1 ELSE 0 END)  AS "Amp_N",
        SUM(CASE WHEN cv."Type" = 'Gain'    THEN 1 ELSE 0 END)  AS "Gain_N",
        SUM(CASE WHEN cv."Type" = 'Loss'    THEN 1 ELSE 0 END)  AS "Loss_N",
        SUM(CASE WHEN cv."Type" = 'HomLoss' THEN 1 ELSE 0 END)  AS "HomDel_N",
        COUNT(DISTINCT cv."RefNo"
                        ||':'||cv."CaseNo"
                        ||':'||cv."InvNo"
                        ||':'||cv."Clone")                       AS "Total",
        ROUND(100.0 * SUM(CASE WHEN cv."Type" = 'Amp'     THEN 1 ELSE 0 END)
                    / NULLIF(COUNT(DISTINCT cv."RefNo"
                                         ||':'||cv."CaseNo"
                                         ||':'||cv."InvNo"
                                         ||':'||cv."Clone"),0), 2) AS "Amp_%", 
        ROUND(100.0 * SUM(CASE WHEN cv."Type" = 'Gain'    THEN 1 ELSE 0 END)
                    / NULLIF(COUNT(DISTINCT cv."RefNo"
                                         ||':'||cv."CaseNo"
                                         ||':'||cv."InvNo"
                                         ||':'||cv."Clone"),0), 2) AS "Gain_%", 
        ROUND(100.0 * SUM(CASE WHEN cv."Type" = 'Loss'    THEN 1 ELSE 0 END)
                    / NULLIF(COUNT(DISTINCT cv."RefNo"
                                         ||':'||cv."CaseNo"
                                         ||':'||cv."InvNo"
                                         ||':'||cv."Clone"),0), 2) AS "Loss_%", 
        ROUND(100.0 * SUM(CASE WHEN cv."Type" = 'HomLoss' THEN 1 ELSE 0 END)
                    / NULLIF(COUNT(DISTINCT cv."RefNo"
                                         ||':'||cv."CaseNo"
                                         ||':'||cv."InvNo"
                                         ||':'||cv."Clone"),0), 2) AS "HomDel_%"
FROM    "MITELMAN"."PROD"."CYTOCONVERTED"  cv
JOIN    "MITELMAN"."PROD"."CYTOGEN"        cg
  ON    cv."RefNo"  = cg."RefNo"
  AND   cv."CaseNo" = cg."CaseNo"
JOIN    "MITELMAN"."PROD"."CYTOBANDS_HG38" bd
  ON    bd."chromosome" = cv."Chr"
  AND   bd."hg38_start" < cv."End"
  AND   bd."hg38_stop"  > cv."Start"
WHERE   (cg."Morph" = '3111' OR cg."Topo" = '0401')
GROUP BY bd."chromosome", bd."hg38_start", bd."hg38_stop", bd."cytoband_name"
ORDER BY bd."chromosome", bd."hg38_start", bd."hg38_stop"
LIMIT   20;
```
