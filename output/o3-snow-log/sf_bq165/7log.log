Query:
--Description: 5)  Inspect the CytoConverter output (“CYTOCONVERTED”) for
--              those breast-cancer cases collected above.  We retrieve the
--              genomic interval together with the alteration “Type”.
SELECT  c."RefNo",
        c."CaseNo",
        c."InvNo",
        c."Clone"      AS "CloneNo",
        c."Chr"        AS "Chromosome",
        c."Start",
        c."End",
        c."Type"
FROM    "MITELMAN"."PROD"."CYTOCONVERTED"  c
JOIN    "MITELMAN"."PROD"."CYTOGEN"        g
  ON    c."RefNo"  = g."RefNo"
  AND   c."CaseNo" = g."CaseNo"
WHERE   g."Morph" = '3111'                         -- breast cancer
LIMIT   20;
