Query:
--Description: Compute the overall average annual salary for remote Data-Analyst postings
--             that list at least one of the three top skills (“python”, “sharepoint”, “qlik”).
SELECT
    AVG("salary_year_avg") AS "avg_salary_top3skills_remote_data_analyst"
FROM CITY_LEGISLATION.CITY_LEGISLATION."JOB_POSTINGS_FACT"
WHERE "job_id" IN (
        SELECT DISTINCT sj."job_id"
        FROM CITY_LEGISLATION.CITY_LEGISLATION."SKILLS_JOB_DIM" sj
        JOIN CITY_LEGISLATION.CITY_LEGISLATION."SKILLS_DIM"     s
              ON s."skill_id" = sj."skill_id"
        WHERE s."skills" IN ('python', 'sharepoint', 'qlik')
          AND sj."job_id" IN (
                SELECT "job_id"
                FROM CITY_LEGISLATION.CITY_LEGISLATION."JOB_POSTINGS_FACT"
                WHERE "job_title" ILIKE '%data%analyst%'
                  AND "job_work_from_home" = 1
                  AND "salary_year_avg" IS NOT NULL
          )
)
