Query:
--Description: Count how frequently each skill appears in the remote Data-Analyst postings with salary data (to find the top three).
SELECT 
    s."skills",
    COUNT(*) AS "appearance_count"
FROM 
    CITY_LEGISLATION.CITY_LEGISLATION.SKILLS_DIM   AS s
JOIN 
    CITY_LEGISLATION.CITY_LEGISLATION.SKILLS_JOB_DIM AS sj
    ON s."skill_id" = sj."skill_id"
WHERE 
    sj."job_id" IN (
        SELECT "job_id"
        FROM CITY_LEGISLATION.CITY_LEGISLATION.JOB_POSTINGS_FACT
        WHERE "job_title" ILIKE '%data%analyst%' 
              AND "job_work_from_home" = 1
              AND "salary_year_avg" IS NOT NULL
    )
GROUP BY 
    s."skills"
ORDER BY 
    "appearance_count" DESC
LIMIT 20;
Answer:
skills,appearance_count
python,3
sharepoint,1
qlik,1
