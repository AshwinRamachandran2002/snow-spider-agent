```sql
--Description:  
--Goal:  Obtain the overall average annual salary for remote (“work-from-home”) job postings that  
--       (1) contain “Data Analyst” in their title,  
--       (2) report a non-NULL salary_year_avg, and  
--       (3) require at least one of the three most-frequently requested skills in that filtered set (“python”, “sharepoint”, “qlik”).  
--Steps inside the query:  
--  • CTE data_analyst_remote  : select all job_ids + salary that meet title, remote, and non-NULL salary filters.  
--  • CTE jobs_with_top_skills: join those job_ids to SKILLS_JOB_DIM + SKILLS_DIM and keep only rows whose skill name is in the top-3 list.  
--                             DISTINCT eliminates duplicates when a job has multiple qualifying skills.  
--  • Final SELECT             : compute AVG(salary_year_avg) across the remaining postings.  
WITH data_analyst_remote AS (
    SELECT
        "job_id",
        "salary_year_avg"
    FROM CITY_LEGISLATION.CITY_LEGISLATION."JOB_POSTINGS_FACT"
    WHERE
        "job_title" ILIKE '%data%analyst%'          -- fuzzy match for “Data Analyst”
        AND "job_work_from_home" = 1                -- remote postings only
        AND "salary_year_avg" IS NOT NULL           -- salary must be present
),
jobs_with_top_skills AS (
    SELECT DISTINCT
        dar."job_id",
        dar."salary_year_avg"
    FROM data_analyst_remote dar
    JOIN CITY_LEGISLATION.CITY_LEGISLATION."SKILLS_JOB_DIM" sj
          ON dar."job_id" = sj."job_id"
    JOIN CITY_LEGISLATION.CITY_LEGISLATION."SKILLS_DIM" sd
          ON sj."skill_id" = sd."skill_id"
    WHERE
        sd."skills" IN ('python', 'sharepoint', 'qlik')  -- top-3 skills
)
SELECT
    AVG("salary_year_avg") AS "avg_salary_top3skills_remote_data_analyst"
FROM jobs_with_top_skills;
```
