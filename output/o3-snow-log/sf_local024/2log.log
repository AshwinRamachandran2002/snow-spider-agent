```sql
WITH player_runs AS (           -- total runs scored by every player
    SELECT
        bbb."striker"                     AS player_id,
        SUM(bs."runs_scored")             AS total_runs
    FROM IPL.IPL.BALL_BY_BALL   bbb
    JOIN IPL.IPL.BATSMAN_SCORED bs
      ON  bbb."match_id"   = bs."match_id"
      AND bbb."over_id"    = bs."over_id"
      AND bbb."ball_id"    = bs."ball_id"
      AND bbb."innings_no" = bs."innings_no"
    GROUP BY
        bbb."striker"
),
player_matches AS (             -- number of matches each player appeared in
    SELECT
        pm."player_id",
        COUNT(DISTINCT pm."match_id") AS matches_played
    FROM IPL.IPL.PLAYER_MATCH pm
    GROUP BY
        pm."player_id"
),
player_avg AS (                 -- individual average runs per match
    SELECT
        pm."player_id",
        COALESCE(pr.total_runs, 0) / pm.matches_played AS avg_runs_per_match
    FROM player_matches pm
    LEFT JOIN player_runs pr
           ON pm."player_id" = pr.player_id
    WHERE pm.matches_played > 0
)
SELECT
    pl."country_name",
    ROUND(AVG(pa.avg_runs_per_match), 4) AS country_batting_avg
FROM player_avg pa
JOIN IPL.IPL.PLAYER pl
  ON pa.player_id = pl."player_id"
GROUP BY
    pl."country_name"
ORDER BY
    country_batting_avg DESC NULLS LAST
FETCH FIRST 5 ROWS ONLY;
```
