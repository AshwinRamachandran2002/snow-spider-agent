```sql
--Description: ⑩  Bring everything together: for each user, identify the earliest session date, the last session date *or* the first mobile transaction date (whichever comes later), keep only users whose last event is on a mobile / tablet device, and rank by the largest day span.  (This mirrors the final answer query you would refine.)
SELECT  derived."fullVisitorId",
        derived."first_date",
        derived."last_event_date",
        DATEDIFF('day', derived."first_date", derived."last_event_date") AS "days_between"
FROM   (
        SELECT  "fullVisitorId",
                MIN(TO_DATE("date"))                                              AS "first_date",
                MAX(TO_DATE("date"))                                              AS "last_visit_date",
                MIN(CASE WHEN "totals":"transactions" IS NOT NULL 
                          THEN TO_DATE("date") END)                               AS "first_txn_date",
                MAX(
                    COALESCE( MIN(CASE WHEN "totals":"transactions" IS NOT NULL 
                                         THEN TO_DATE("date") END)
                           , MAX(TO_DATE("date")) )
                ) OVER (PARTITION BY "fullVisitorId")                              AS "last_event_date",
                MAX("device":"deviceCategory"::STRING) 
                     KEEP (DENSE_RANK LAST ORDER BY "visitStartTime")              AS "last_device_cat"
        FROM    GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
        GROUP   BY "fullVisitorId"
       ) derived
WHERE   derived."last_device_cat" ILIKE '%mobile%'  -- mobile / tablet
ORDER  BY "days_between" DESC
LIMIT  20;
```
