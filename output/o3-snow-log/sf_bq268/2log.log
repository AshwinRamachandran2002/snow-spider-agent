```sql
--Description: Goal – for each visitor on 2016-08-01, show
--   • first_visit_ts  – earliest visitStartTime
--   • last_visit_ts   – latest  visitStartTime
--   • last_device_cat – device category used in the latest session
--Approach – keep every row, calculate MIN() and MAX() with window functions,
--   then QUALIFY to keep only the row whose visitStartTime is the visitor’s maximum
--   (ROW_NUMBER ordered DESC = 1).  The deviceCategory on that retained row
--   is therefore the device of the last visit.
SELECT
    "fullVisitorId",
    MIN("visitStartTime") OVER (PARTITION BY "fullVisitorId") AS "first_visit_ts",
    MAX("visitStartTime") OVER (PARTITION BY "fullVisitorId") AS "last_visit_ts",
    "device":"deviceCategory"::STRING                         AS "last_device_cat"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
QUALIFY ROW_NUMBER() OVER (PARTITION BY "fullVisitorId" ORDER BY "visitStartTime" DESC) = 1
LIMIT 20;
```
