        TO_DATE(MAX("date"))                           AS "last_date",
        DATEDIFF('day',
                 TO_DATE(MIN("date")),
                 TO_DATE(MAX("date")))                 AS "days_between"
FROM    GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
GROUP   BY "fullVisitorId"
ORDER   BY "days_between" DESC
LIMIT  20;
```

```sql
--Description: ⑦  Same as (⑥) but keep only visitors whose LAST session (by timestamp) is on a mobile or tablet device.
SELECT  outer_q."fullVisitorId",
        outer_q."first_date",
        outer_q."last_date",
        outer_q."days_between"
FROM   (
        SELECT  "fullVisitorId",
                TO_DATE(MIN("date"))                           AS "first_date",
                TO_DATE(MAX("date"))                           AS "last_date",
                DATEDIFF('day',
                         TO_DATE(MIN("date")),
                         TO_DATE(MAX("date")))                 AS "days_between",
                ROW_NUMBER() OVER (PARTITION BY "fullVisitorId"
                                   ORDER BY "visitStartTime" DESC)          AS rn,
                "device":"deviceCategory"::STRING                           AS last_device_cat
        FROM    GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
        GROUP   BY "fullVisitorId",       -- needed for MIN/MAX aggregates
                  "visitStartTime",       -- retained for ROW_NUMBER order
                  "device"                -- needed to pull last_device_cat
       ) outer_q
WHERE   outer_q.rn = 1
  AND  (outer_q.last_device_cat ILIKE '%mobile%' 
        OR outer_q.last_device_cat ILIKE '%tablet%')
ORDER  BY outer_q."days_between" DESC
LIMIT  20;
```

