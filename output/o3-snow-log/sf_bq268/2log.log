```sql
--Description: ⑦  Restrict (⑥) to users whose LAST recorded session is on a mobile or tablet device.
SELECT  "fullVisitorId",
        TO_DATE(MIN("date"))                                       AS "first_date",
        TO_DATE(MAX("date"))                                       AS "last_date",
