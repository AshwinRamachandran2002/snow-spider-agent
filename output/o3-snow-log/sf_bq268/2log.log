Query:
--Description: ⑥  Convert the first and last session dates per visitor into calendar days and show the spread in days.
SELECT  "fullVisitorId",
        TO_DATE(MIN("date"))                           AS "first_date",
        TO_DATE(MAX("date"))                           AS "last_date",
        DATEDIFF('day',
                 TO_DATE(MIN("date")),
                 TO_DATE(MAX("date")))                 AS "days_between"
FROM    GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
GROUP   BY "fullVisitorId"
ORDER   BY "days_between" DESC
LIMIT  20
