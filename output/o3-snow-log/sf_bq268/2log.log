Query:
--Description: ⑩  Combine everything: for each visitor, compute the earliest session date, 
--                the later of (a) last session date OR (b) first-ever transaction date, 
--                keep only those whose last session is on mobile/tablet, 
--                and rank by the widest day span.
WITH staged AS (
    SELECT  "fullVisitorId",
            TO_DATE("date")                                   AS session_date,
            "visitStartTime",
            "device":"deviceCategory"::STRING                AS device_cat,
            IFF("totals":"transactions" IS NOT NULL, 1, 0)   AS has_txn
    FROM    GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
), enriched AS (
    SELECT  "fullVisitorId",
            MIN(session_date)  OVER (PARTITION BY "fullVisitorId")             AS first_date,
            MAX(session_date)  OVER (PARTITION BY "fullVisitorId")             AS last_visit_date,
            MIN(IFF(has_txn=1, session_date, NULL))
                                   OVER (PARTITION BY "fullVisitorId")         AS first_txn_date,
            session_date,
            device_cat,
            ROW_NUMBER() OVER (PARTITION BY "fullVisitorId"
                               ORDER BY "visitStartTime" DESC)                 AS rn
    FROM    staged
)
SELECT  "fullVisitorId",
        first_date,
        GREATEST(last_visit_date, first_txn_date)           AS last_event_date,
        DATEDIFF('day', first_date, 
                 GREATEST(last_visit_date, first_txn_date)) AS days_between
FROM    enriched
WHERE   rn = 1
  AND  (device_cat ILIKE '%mobile%' OR device_cat ILIKE '%tablet%')
ORDER  BY days_between DESC
LIMIT  20
Answer:
