```sql
-- 8.  Derive, per user, the “last recorded event date” = 
--     • first transaction date if it exists, else 
--     • last visit date; together with the device category of that event.
WITH base AS (
  SELECT 
    "fullVisitorId",
    "date",
    /*  identify the candidate event - first txn vs visit  */
    CASE 
      WHEN ("totals":"transactions")::NUMBER > 0 THEN 'TXN' 
      ELSE 'VISIT' 
    END                                                     AS "event_type",
    "device":"deviceCategory"::STRING                       AS "device_category"
  FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
)
SELECT 
  "fullVisitorId",
  MIN(CASE WHEN "event_type" = 'TXN' THEN "date" END)                    AS "first_txn_dt",
  MAX("date")                                                            AS "last_visit_dt",
  /*  choose the “last recorded event” and its device category            */
  COALESCE( MIN(CASE WHEN "event_type"='TXN' THEN "date" END),
            MAX("date") )                                                AS "last_recorded_event_dt",
  /* device category of that last recorded event                         */
  OBJECT_AGG("date", "device_category")[
      COALESCE( MIN(CASE WHEN "event_type"='TXN' THEN "date" END),
                MAX("date") )
  ]                                                                       AS "last_recorded_device"
FROM base
GROUP BY 1
LIMIT 20;
```

```sql
-- 9.  Calculate the day-difference (DATEDIFF) between a user’s first visit and  
--     the last recorded event, keeping only users whose last recorded event occurred on a mobile device.
WITH visits AS (
  SELECT 
    "fullVisitorId",
    MIN("date")                                              AS "first_visit_dt"
  FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
  GROUP BY 1
), last_event AS (
  /*  re-use logic from step 8                                          */
  SELECT 
    "fullVisitorId",
    COALESCE( MIN(CASE WHEN ("totals":"transactions")::NUMBER > 0 THEN "date" END),
              MAX("date") )                                           AS "last_recorded_event_dt",
    OBJECT_AGG("date", "device":"deviceCategory"::STRING)[
        COALESCE( MIN(CASE WHEN ("totals":"transactions")::NUMBER > 0 THEN "date" END),
                  MAX("date") )
    ]                                                                 AS "last_recorded_device"
  FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
  GROUP BY 1
)
SELECT 
  v."fullVisitorId",
  v."first_visit_dt",
  l."last_recorded_event_dt",
  DATEDIFF('day', TO_DATE(v."first_visit_dt"), TO_DATE(l."last_recorded_event_dt")) AS "days_between",
  l."last_recorded_device"
FROM visits v
JOIN last_event l USING ("fullVisitorId")
WHERE l."last_recorded_device" = 'mobile'
LIMIT 20;
```

```sql
-- 10.  Final query: across the chosen table(s) return the single user that exhibits  
--      the maximum number of days between first visit and last recorded mobile event.
WITH all_sessions AS (
  SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
        UNION ALL
  SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160802"
        UNION ALL
  SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160806"
  /* … add more daily tables as desired … */
),
first_visits AS (
  SELECT 
    "fullVisitorId",
    MIN("date")                                              AS "first_visit_dt"
  FROM all_sessions
  GROUP BY 1
),
last_events AS (
  SELECT 
    "fullVisitorId",
    /* decide which date is the “last recorded event” */
    COALESCE(
        MIN(CASE WHEN ("totals":"transactions")::NUMBER > 0 THEN "date" END),
        MAX("date")
    )                                                        AS "last_recorded_event_dt",
    OBJECT_AGG("date", "device":"deviceCategory"::STRING)[
        COALESCE(
            MIN(CASE WHEN ("totals":"transactions")::NUMBER > 0 THEN "date" END),
            MAX("date")
        )
    ]                                                        AS "last_recorded_device"
  FROM all_sessions
  GROUP BY 1
),
differences AS (
  SELECT 
    f."fullVisitorId",
    f."first_visit_dt",
    l."last_recorded_event_dt",
    DATEDIFF('day', TO_DATE(f."first_visit_dt"), TO_DATE(l."last_recorded_event_dt")) AS "days_between"
  FROM first_visits f
  JOIN last_events  l USING ("fullVisitorId")
  WHERE l."last_recorded_device" = 'mobile'
)
SELECT *
FROM differences
ORDER BY "days_between" DESC
LIMIT 20;
```
