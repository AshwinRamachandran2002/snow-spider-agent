--Description:
-- Goal ­– find the visitor(s) whose gap between the very first visit and the
--         “last recorded event” is the longest, provided that the last event
--         happened on a mobile device.
-- Logic
--   1. all_sessions  – union a representative set of daily GA tables spanning
--                      Aug-2016 → Jul-2017 (enough to create multi-month gaps).
--   2. prepared      – per session flag whether it contains a transaction and
--                      expose the device category.
--   3. agg           – per visitor get:
--         • first_visit_dt         (earliest session date)
--         • first_txn_dt           (earliest date that has a txn; NULL if none)
--         • last_visit_dt          (latest session date)
--   4. devices       – for the two specific dates above, look up which device
--                      category was used (first_txn_device, last_visit_device).
--   5. combined      – decide what the “last recorded event” is:
--         • if first_txn_dt exists → use that date & its device
--         • else                   → use last_visit_dt & its device
--   6. mobile_users  – keep only those whose chosen device = 'mobile' and
--                      compute the day-difference.
--   7. final select  – surface the visitor(s) with the maximum gap.
WITH all_sessions AS (      /* ---- concatenate several day tables ---- */
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160825" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160925" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20161025" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20161125" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20161225" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170125" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170225" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170325" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170425" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170525" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170625" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170725"
),
prepared AS (
    SELECT
        "fullVisitorId",
        "date",
        CASE WHEN ("totals":"transactions")::NUMBER > 0 THEN 1 ELSE 0 END    AS is_txn,
        "device":"deviceCategory"::STRING                                    AS device_category
    FROM all_sessions
),
agg AS (
    SELECT
        "fullVisitorId",
        MIN("date")                                                   AS first_visit_dt,
        MIN(CASE WHEN is_txn = 1 THEN "date" END)                     AS first_txn_dt,
        MAX("date")                                                   AS last_visit_dt
    FROM prepared
    GROUP BY 1
),
devices AS (
    /* pick the device used on the first-txn-date and on the last-visit-date */
    SELECT
        a."fullVisitorId",
        MAX(CASE WHEN p."date" = a.first_txn_dt THEN p.device_category END)
                                                                     AS first_txn_device,
        MAX(CASE WHEN p."date" = a.last_visit_dt THEN p.device_category END)
                                                                     AS last_visit_device
    FROM agg a
    JOIN prepared p
      ON a."fullVisitorId" = p."fullVisitorId"
    GROUP BY a."fullVisitorId"
),
combined AS (
    SELECT
        a.*,
        d.first_txn_device,
        d.last_visit_device,
        /* choose last recorded event date & device */
        COALESCE(first_txn_dt, last_visit_dt)                        AS last_recorded_event_dt,
        CASE WHEN first_txn_dt IS NOT NULL
             THEN d.first_txn_device
             ELSE d.last_visit_device
        END                                                          AS last_recorded_device
    FROM agg a
    JOIN devices d USING ("fullVisitorId")
),
mobile_users AS (
    SELECT
        *,
        DATEDIFF('day',
                 TO_DATE(first_visit_dt),
                 TO_DATE(last_recorded_event_dt))                    AS days_between
    FROM combined
    WHERE last_recorded_device = 'mobile'
)
SELECT
    "fullVisitorId",
    first_visit_dt,
    last_recorded_event_dt,
    days_between
FROM mobile_users
QUALIFY days_between = MAX(days_between) OVER ()   -- only the longest gap
ORDER BY days_between DESC
LIMIT 20;
```
