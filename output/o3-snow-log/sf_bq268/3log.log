```sql
--Description:
-- For the sessions of 2016-08-01, build a per-visitor summary that identifies  
--     • the earliest session that contains a transaction (first_txn_dt) and the device used  
--     • the latest session date (last_visit_dt) and the device used  
--     • the “last recorded event”: if a transaction exists use first_txn_dt/device,  
--       otherwise use last_visit_dt/device.  
-- MIN_BY and MAX_BY let us capture the device that corresponds to the chosen date  
-- without resorting to OBJECT_AGG, avoiding the previous error.

WITH base AS (
    SELECT
        "fullVisitorId",
        "date",
        CASE WHEN ("totals":"transactions")::NUMBER > 0 THEN 'TXN' ELSE 'VISIT' END  AS event_type,
        "device":"deviceCategory"::STRING                                             AS device_category
    FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
),
agg AS (
    SELECT
        "fullVisitorId",
        /* earliest transaction date (NULL if none) */
        MIN(CASE WHEN event_type = 'TXN' THEN "date" END)                             AS first_txn_dt,
        /* device used on that earliest transaction */
        MIN_BY(device_category, "date") FILTER (WHERE event_type = 'TXN')             AS first_txn_device,
        /* latest visit date (always exists) */
        MAX("date")                                                                   AS last_visit_dt,
        /* device used on that latest visit */
        MAX_BY(device_category, "date")                                               AS last_visit_device
    FROM base
    GROUP BY 1
)
SELECT
    "fullVisitorId",
    first_txn_dt,
    first_txn_device,
    last_visit_dt,
    last_visit_device,
    /* choose “last recorded event” and its device */
    COALESCE(first_txn_dt, last_visit_dt)                                             AS last_recorded_event_dt,
    CASE WHEN first_txn_dt IS NOT NULL
         THEN first_txn_device
         ELSE last_visit_device
    END                                                                               AS last_recorded_device
FROM agg
LIMIT 20;
