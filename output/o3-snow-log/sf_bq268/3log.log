device_category,session_cnt
desktop,1412
mobile,250
tablet,49
Query:
-- 4.  Inspect the keys that live inside the “totals” field so we know where transactions are stored.
SELECT 
  DISTINCT OBJECT_KEYS("totals")      AS "totals_keys"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801",
     LATERAL FLATTEN(input => OBJECT_KEYS("totals"))   -- exposes every key
LIMIT 20;
