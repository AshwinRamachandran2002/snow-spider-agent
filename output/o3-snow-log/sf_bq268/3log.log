Query:
-- 3.  How many sessions belong to each device category for the chosen day?
SELECT 
  "device":"deviceCategory"::STRING  AS "device_category",
  COUNT(*)                            AS "session_cnt"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
