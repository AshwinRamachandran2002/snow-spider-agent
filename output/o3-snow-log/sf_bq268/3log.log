--Description:
-- Goal:  find the visitor(s) that show the largest number of days
--        between their very first visit and their “last recorded event”
--        (first-transaction date IF they ever purchased, otherwise their
--        last-visit date) where that last recorded event happened on a
--        mobile device.
--
-- Strategy
--   1) all_sessions   – UNION-ALL one representative day from each month
--                       (Aug-2016 → Jul-2017) so we span a full year.
--   2) per_user       – for every visitor compute
--          • first_visit_dt
--          • first_txn_dt  & its device      (MIN / MIN_BY)
--          • last_visit_dt & its device      (MAX / MAX_BY)
--   3) evaluated      – decide last_recorded_event_dt / device
--          • use first_txn_dt / device if it exists,
--          • else last_visit_dt / device.
--        Keep only rows whose chosen device = 'mobile’, calculate the
--        day gap, and surface the visitor(s) with the maximum gap.

WITH all_sessions AS (
      SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801" UNION ALL
      SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160901" UNION ALL
      SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20161001" UNION ALL
      SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20161101" UNION ALL
      SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20161201" UNION ALL
      SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170101" UNION ALL
      SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170201" UNION ALL
      SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170301" UNION ALL
      SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170401" UNION ALL
      SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170501" UNION ALL
      SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170601" UNION ALL
      SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170731"
),
per_user AS (
    SELECT
        "fullVisitorId",

        /* earliest session date */
        MIN("date")                                                           AS first_visit_dt,

        /* earliest session containing a transaction (NULL if none) */
        MIN(CASE WHEN ("totals":"transactions")::NUMBER > 0 THEN "date" END)  AS first_txn_dt,

        /* device on that earliest transaction */
        MIN_BY("device":"deviceCategory"::STRING, "date")
             FILTER (WHERE ("totals":"transactions")::NUMBER > 0)             AS first_txn_device,

        /* latest session date */
        MAX("date")                                                           AS last_visit_dt,

        /* device on the latest session */
        MAX_BY("device":"deviceCategory"::STRING, "date")                     AS last_visit_device
    FROM all_sessions
    GROUP BY 1
),
evaluated AS (
    SELECT
        "fullVisitorId",
        first_visit_dt,
        /* decide last recorded event date */
        COALESCE(first_txn_dt, last_visit_dt)                                 AS last_recorded_event_dt,
        /* corresponding device */
        CASE
            WHEN first_txn_dt IS NOT NULL THEN first_txn_device
            ELSE last_visit_device
        END                                                                   AS last_recorded_device,
        /* days between first visit and last recorded event */
        DATEDIFF(
            'day',
            TO_DATE(first_visit_dt, 'YYYYMMDD'),
            TO_DATE(COALESCE(first_txn_dt, last_visit_dt), 'YYYYMMDD')
        )                                                                     AS days_between
    FROM per_user
    WHERE
        /* keep only those whose last recorded event was on a mobile device */
        (CASE
            WHEN first_txn_dt IS NOT NULL THEN first_txn_device
            ELSE last_visit_device
         END) = 'mobile'
)
SELECT
    "fullVisitorId",
    first_visit_dt,
    last_recorded_event_dt,
    days_between
FROM evaluated
QUALIFY days_between = MAX(days_between) OVER ()   -- longest span
ORDER BY days_between DESC
LIMIT 20;
