--Description:
-- Identify the visitor(s) whose span between the very first visit and the
-- “last recorded event” is the longest, given that the last recorded event
-- ( first transaction if any, otherwise the last visit ) happened on a
-- mobile device.
--
-- Approach
-- 1. all_sessions  – union-all a representative set of daily tables that
--                    cover the available date range (Aug-2016 → Jul-2017).
-- 2. prepared      – per session add:
--        • is_txn          (1 if session contains ≥1 transaction)
--        • device_category (desktop / mobile / tablet …)
-- 3. agg           – per visitor compute
--        • first_visit_dt
--        • first_txn_dt   & device
--        • last_visit_dt  & device
--    MIN_BY / MAX_BY capture the device used on the chosen dates.
-- 4. evaluated     – decide the “last recorded event” (first_txn_dt if it
--                    exists, else last_visit_dt) and its device.
-- 5. mobile_only   – keep only visitors whose chosen device = 'mobile' and
--                    calculate the day gap.
-- 6. Final SELECT  – return the visitor(s) with the maximum gap.
WITH all_sessions AS (             /* ---- concatenate daily tables ---- */
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160901" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20161001" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20161101" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20161201" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170101" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170201" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170301" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170401" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170501" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170601" UNION ALL
    SELECT * FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20170731"
),
prepared AS (
    SELECT
        "fullVisitorId",
        "date",
        CASE WHEN ("totals":"transactions")::NUMBER > 0 THEN 1 ELSE 0 END            AS is_txn,
        "device":"deviceCategory"::STRING                                             AS device_category
    FROM all_sessions
),
agg AS (                       -- per-visitor aggregates
    SELECT
        "fullVisitorId",
        MIN("date")                                                                     AS first_visit_dt,
        MIN(CASE WHEN is_txn = 1 THEN "date" END)                                       AS first_txn_dt,
        MIN_BY(device_category, "date") FILTER (WHERE is_txn = 1)                       AS first_txn_device,
        MAX("date")                                                                     AS last_visit_dt,
        MAX_BY(device_category, "date")                                                 AS last_visit_device
    FROM prepared
    GROUP BY 1
),
evaluated AS (                 -- decide “last recorded event”
    SELECT
        "fullVisitorId",
        first_visit_dt,
        COALESCE(first_txn_dt, last_visit_dt)                                           AS last_recorded_event_dt,
        CASE
            WHEN first_txn_dt IS NOT NULL THEN first_txn_device
            ELSE last_visit_device
        END                                                                             AS last_recorded_device
    FROM agg
),
mobile_only AS (
    SELECT
        *,
        DATEDIFF('day',
                 TO_DATE(first_visit_dt),
                 TO_DATE(last_recorded_event_dt))                                       AS days_between
    FROM evaluated
    WHERE last_recorded_device = 'mobile'
)
SELECT
    "fullVisitorId",
    first_visit_dt,
    last_recorded_event_dt,
    days_between
FROM mobile_only
QUALIFY days_between = MAX(days_between) OVER ()      -- longest gap
ORDER BY days_between DESC
LIMIT 20;
