--Description:
-- Derive, for each visitor in GA360.GOOGLE_ANALYTICS_SAMPLE.GA_SESSIONS_20160801:
--   • first_visit_dt            – earliest session date
--   • first_txn_dt / device     – earliest session that contains ≥1 transaction
--   • last_visit_dt / device    – latest  session date
--   • last_recorded_event_dt    – first_txn_dt if it exists, otherwise last_visit_dt
--   • last_recorded_device      – device category used on that event
--   • days_between              – days between first_visit_dt and last_recorded_event_dt
-- Keep only visitors whose last_recorded_device = 'mobile' and return the 20
-- largest spans.
WITH per_visitor AS (
    SELECT
        "fullVisitorId",
        /* earliest visit */
        MIN("date")                                                                    AS first_visit_dt,
        /* earliest transaction date (NULL if none) */
        MIN(CASE WHEN ("totals":"transactions")::NUMBER > 0 THEN "date" END)           AS first_txn_dt,
        /* device on the earliest transaction */
        MIN_BY("device":"deviceCategory"::STRING, "date")
            FILTER (WHERE ("totals":"transactions")::NUMBER > 0)                       AS first_txn_device,
        /* latest visit */
        MAX("date")                                                                    AS last_visit_dt,
        /* device on the latest visit */
        MAX_BY("device":"deviceCategory"::STRING, "date")                               AS last_visit_device
    FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
    GROUP BY 1
),
evaluated AS (
    SELECT
        "fullVisitorId",
        first_visit_dt,
        /* choose last recorded event date */
        COALESCE(first_txn_dt, last_visit_dt)                                           AS last_recorded_event_dt,
        /* choose device of that event */
        CASE WHEN first_txn_dt IS NOT NULL THEN first_txn_device
             ELSE last_visit_device
        END                                                                             AS last_recorded_device,
        /* compute day difference */
        DATEDIFF(
            'day',
            TO_DATE(first_visit_dt, 'YYYYMMDD'),
            TO_DATE(COALESCE(first_txn_dt, last_visit_dt), 'YYYYMMDD')
        )                                                                               AS days_between
    FROM per_visitor
)
SELECT
    "fullVisitorId",
    first_visit_dt,
    last_recorded_event_dt,
    days_between
FROM evaluated
WHERE last_recorded_device = 'mobile'
ORDER BY days_between DESC
LIMIT 20;
