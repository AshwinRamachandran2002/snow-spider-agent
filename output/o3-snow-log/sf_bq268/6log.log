Query:
--Description: 10)  Put everything together:  
--   a)  keep only users whose “last recorded event” happened on a mobile device  
--   b)  calculate the #days between first visit and that last recorded moment  
SELECT 
       c."fullVisitorId",
       c."first_visit_ts",
       c."last_recorded_ts",
       ROUND( (c."last_recorded_ts" - c."first_visit_ts") / 86400 , 2) AS "days_between"
FROM  (
        /* derive first visit, last visit, first transaction & last_recorded_ts */
        SELECT
               b."fullVisitorId",
               b."first_visit_ts",
               b."last_visit_ts",
               b."first_txn_ts",
               GREATEST(b."last_visit_ts",
                        COALESCE(b."first_txn_ts",0))      AS "last_recorded_ts"
        FROM  (
               SELECT
                      a."fullVisitorId",
                      MIN(a."visitStartTime")                                    AS "first_visit_ts",
                      MAX(a."visitStartTime")                                    AS "last_visit_ts",
                      MIN(CASE WHEN ("totals":"transactions")::NUMBER > 0 
                               THEN a."visitStartTime" END)                      AS "first_txn_ts"
               FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801" a
               GROUP  BY a."fullVisitorId"
              ) b
     ) c
WHERE  EXISTS (  /* ensure last-recorded session is from mobile device */
        SELECT 1
        FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801" s
        WHERE  s."fullVisitorId"     = c."fullVisitorId"
          AND  s."visitStartTime"    = c."last_recorded_ts"
          AND  s."device":"isMobile"::BOOLEAN = TRUE
      )
ORDER BY "days_between" DESC
LIMIT 20;
