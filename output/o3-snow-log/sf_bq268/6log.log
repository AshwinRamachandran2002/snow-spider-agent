```sql
--Description: 1)  Look at the different device categories that exist in one GA table
SELECT DISTINCT 
       "device":"deviceCategory"::STRING   AS "device_category"
FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
LIMIT 20;
```

```sql
--Description: 2)  Check whether the “isMobile” flag is stored for every row
SELECT DISTINCT 
       "device":"isMobile"::BOOLEAN AS "is_mobile_flag"
FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
LIMIT 20;
```

```sql
--Description: 3)  Display a few mobile-device sessions with the visitor id, date and visit start time
SELECT 
       "fullVisitorId",
       "visitId",
       "date",
       "visitStartTime",
       "device":"deviceCategory"::STRING  AS "device_category"
FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
WHERE  "device":"isMobile"::BOOLEAN = TRUE
LIMIT 20;
```

```sql
--Description: 4)  See which columns inside the “totals” object can indicate transactions
SELECT 
       "totals"
FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
WHERE  "totals":"transactions" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 5)  Quickly list users that recorded ≥1 transaction on any session-row
SELECT DISTINCT
       "fullVisitorId"
FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
WHERE  ("totals":"transactions")::NUMBER > 0
LIMIT 20;
```

```sql
--Description: 6)  For a sample user, look at every session ordered by time to understand first vs last visit
SELECT 
       "fullVisitorId",
       "visitStartTime",
       "device":"deviceCategory"::STRING  AS "device_category",
       ("totals":"transactions")::NUMBER AS "transactions"
FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
WHERE  "fullVisitorId" = (   -- pick an arbitrary visitor that appears more than once
       SELECT "fullVisitorId"
       FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
       GROUP  BY 1
       HAVING COUNT(*) > 3
       LIMIT 1)
ORDER BY "visitStartTime"
LIMIT 20;
```

```sql
--Description: 7)  Compute first-visit and last-visit (by timestamp) for every visitor found in one day’s table
SELECT 
       "fullVisitorId",
       MIN("visitStartTime") AS "first_visit_ts",
       MAX("visitStartTime") AS "last_visit_ts"
FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
GROUP  BY "fullVisitorId"
LIMIT 20;
```

```sql
--Description: 8)  Extend previous query by also checking the first session that contains a transaction
SELECT
       a."fullVisitorId",
       MIN(a."visitStartTime")                                    AS "first_visit_ts",
       MAX(a."visitStartTime")                                    AS "last_visit_ts",
       MIN(CASE WHEN ("totals":"transactions")::NUMBER > 0 
                THEN a."visitStartTime" END)                      AS "first_txn_ts"
FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801" a
GROUP  BY a."fullVisitorId"
LIMIT 20;
```

```sql
--Description: 9)  Identify, per user, the “last recorded event” timestamp 
--                (max visit OR first transaction – whichever is later)
SELECT
       b."fullVisitorId",
       b."first_visit_ts",
       b."last_visit_ts",
       b."first_txn_ts",
       GREATEST(b."last_visit_ts",
                COALESCE(b."first_txn_ts",0))      AS "last_recorded_ts"
FROM  (  /* sub-query = #8 */
       SELECT
              a."fullVisitorId",
              MIN(a."visitStartTime")                                    AS "first_visit_ts",
              MAX(a."visitStartTime")                                    AS "last_visit_ts",
              MIN(CASE WHEN ("totals":"transactions")::NUMBER > 0 
                       THEN a."visitStartTime" END)                      AS "first_txn_ts"
       FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801" a
       GROUP  BY a."fullVisitorId"
      ) b
LIMIT 20;
```

```sql
--Description: 10)  Put everything together:  
--   a)  keep only users whose “last recorded event” happened on a mobile device  
--   b)  calculate the #days between first visit and that last recorded moment  
SELECT 
       c."fullVisitorId",
       c."first_visit_ts",
       c."last_recorded_ts",
       ROUND( (c."last_recorded_ts" - c."first_visit_ts") / 86400 , 2) AS "days_between"
FROM  (
        /* derive first visit, last visit, first transaction & last_recorded_ts */
        SELECT
               b."fullVisitorId",
               b."first_visit_ts",
               b."last_visit_ts",
               b."first_txn_ts",
               GREATEST(b."last_visit_ts",
                        COALESCE(b."first_txn_ts",0))      AS "last_recorded_ts"
        FROM  (
               SELECT
                      a."fullVisitorId",
                      MIN(a."visitStartTime")                                    AS "first_visit_ts",
                      MAX(a."visitStartTime")                                    AS "last_visit_ts",
                      MIN(CASE WHEN ("totals":"transactions")::NUMBER > 0 
                               THEN a."visitStartTime" END)                      AS "first_txn_ts"
               FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801" a
               GROUP  BY a."fullVisitorId"
              ) b
     ) c
WHERE  EXISTS (  /* ensure last-recorded session is from mobile device */
        SELECT 1
        FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801" s
        WHERE  s."fullVisitorId"     = c."fullVisitorId"
          AND  s."visitStartTime"    = c."last_recorded_ts"
          AND  s."device":"isMobile"::BOOLEAN = TRUE
      )
ORDER BY "days_between" DESC
LIMIT 20;
```
