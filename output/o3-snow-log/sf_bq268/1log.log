--Description: 10) Prototype of selecting visitors whose last recorded event in 20160801 was on a mobile device, including days between first visit and that last event
WITH per_visit AS (
    SELECT
        "fullVisitorId",
        "date",
        "device":"deviceCategory"::STRING AS "device_category"
    FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
),
last_event AS (
    SELECT
        "fullVisitorId",
        MAX("date") AS "last_date"
    FROM per_visit
    GROUP BY "fullVisitorId"
)
SELECT
    p."fullVisitorId",
    TO_DATE(MIN(p."date"),'YYYYMMDD') AS "first_visit_date",
    TO_DATE(MAX(p."date"),'YYYYMMDD') AS "last_event_date",
    DATEDIFF('day',
             TO_DATE(MIN(p."date"),'YYYYMMDD'),
             TO_DATE(MAX(p."date"),'YYYYMMDD')) AS "days_between",
    MAX(p."device_category") AS "device_at_last_event"
FROM per_visit p
JOIN last_event l
  ON p."fullVisitorId" = l."fullVisitorId"
 AND p."date" = l."last_date"
WHERE p."device_category" ILIKE '%mobile%'
GROUP BY p."fullVisitorId"
LIMIT 20;
