```sql
--Description: 6) First-visit date and last-visit date per visitor inside the 20160801 file
SELECT
    "fullVisitorId",
    MIN("date") AS "first_visit_date",
    MAX("date") AS "last_visit_date"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
GROUP BY "fullVisitorId"
LIMIT 20;
```

```sql
--Description: 7) Get the first transaction date (if any) for every visitor in the 20160801 file
SELECT
    "fullVisitorId",
    MIN("date") AS "first_transaction_date"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
WHERE "totals":"transactions"::NUMBER > 0
GROUP BY "fullVisitorId"
LIMIT 20;
```

```sql
--Description: 8) Combine first-visit date and last-visit date, and flag whether the last visit was mobile
SELECT
    "fullVisitorId",
    MIN("date") AS "first_visit_date",
    MAX("date") AS "last_visit_date",
    MAX(CASE WHEN "date" = (SELECT MAX("date") FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801" s2 
                            WHERE s2."fullVisitorId" = s1."fullVisitorId")
             THEN "device":"deviceCategory"::STRING END) AS "last_visit_device"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801" s1
GROUP BY "fullVisitorId"
LIMIT 20;
```

```sql
--Description: 9) Illustrate how to calculate the number of days between the first visit and the last recorded event (here using only 20160801 data)
SELECT
    "fullVisitorId",
    DATEDIFF('day',
             TO_DATE(MIN("date"),'YYYYMMDD'),
             TO_DATE(MAX("date"),'YYYYMMDD')) AS "days_between_first_and_last_visit"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
GROUP BY "fullVisitorId"
LIMIT 20;
```

```sql
--Description: 10) Prototype of selecting visitors whose last recorded event in 20160801 was on a mobile device, including days between first visit and that last event
WITH per_visit AS (
    SELECT
        "fullVisitorId",
        "date",
        "device":"deviceCategory"::STRING AS "device_category"
    FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
),
last_event AS (
    SELECT
        "fullVisitorId",
        MAX("date") AS "last_date"
    FROM per_visit
    GROUP BY "fullVisitorId"
)
SELECT
    p."fullVisitorId",
    TO_DATE(MIN(p."date"),'YYYYMMDD') AS "first_visit_date",
    TO_DATE(MAX(p."date"),'YYYYMMDD') AS "last_event_date",
    DATEDIFF('day',
             TO_DATE(MIN(p."date"),'YYYYMMDD'),
             TO_DATE(MAX(p."date"),'YYYYMMDD')) AS "days_between",
    MAX(p."device_category") AS "device_at_last_event"
FROM per_visit p
JOIN last_event l
  ON p."fullVisitorId" = l."fullVisitorId"
 AND p."date" = l."last_date"
WHERE p."device_category" ILIKE '%mobile%'
GROUP BY p."fullVisitorId"
LIMIT 20;
```
