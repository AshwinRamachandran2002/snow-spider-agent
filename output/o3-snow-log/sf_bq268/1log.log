LIMIT 20;
```

```sql
--Description: 5) For a single visitor, list all of their visits that are stored in the 20160801 table
SELECT
    "fullVisitorId",
    "visitNumber",
    "visitId",
    "date",
    "device":"deviceCategory"::STRING AS "device_category",
    "totals":"transactions"::NUMBER  AS "transactions"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
WHERE "fullVisitorId" = (
        SELECT DISTINCT "fullVisitorId"
        FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
