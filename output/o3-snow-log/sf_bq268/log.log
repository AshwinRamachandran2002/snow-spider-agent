```sql
--Description: We want the set of visitors whose most recent session (considering sessions
--             on 2016-08-01 and 2016-08-02) occurred on a mobile device.  Approach:
--             • Step-1  UNION BOTH daily tables to create one list of visits that includes
--                        visitor id, the session date, and the device category extracted
--                        from the VARIANT column "device".
--             • Step-2  For each visitor rank the rows by date descending; ROW_NUMBER=1
--                        marks the latest session we have for that visitor in the two-day
--                        slice.
--             • Step-3  Keep only those ROW_NUMBER=1 rows whose device category contains
--                        “mobile”, yielding visitors whose *last* recorded visit used a
--                        mobile device.
--             • Step-4  Return the visitor id and that last-visit date (sample limited to 20).
WITH all_sessions AS (
    SELECT
        "fullVisitorId",
        "date",
        "device"::VARIANT:"deviceCategory"::STRING AS device_cat
    FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
    UNION ALL
    SELECT
        "fullVisitorId",
        "date",
        "device"::VARIANT:"deviceCategory"::STRING AS device_cat
    FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160802"
),
ranked AS (
    SELECT
        "fullVisitorId",
        "date",
        device_cat,
        ROW_NUMBER() OVER (PARTITION BY "fullVisitorId" ORDER BY "date" DESC) AS rn
    FROM all_sessions
)
SELECT
    "fullVisitorId",
    "date" AS last_date
FROM ranked
WHERE rn = 1
  AND device_cat ILIKE '%mobile%'
LIMIT 20;
```
