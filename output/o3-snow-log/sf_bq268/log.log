```sql
--Description: 8) Show the first transaction date for visitors who generated revenue (two-day slice).  
WITH txns AS (
     SELECT "fullVisitorId",
            MIN("date")  AS "first_txn_date"
     FROM  (SELECT "fullVisitorId","date","totals"::VARIANT:"transactions" AS tx
            FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
            UNION ALL
            SELECT "fullVisitorId","date","totals"::VARIANT:"transactions"
            FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160802")
     WHERE tx IS NOT NULL
     GROUP BY "fullVisitorId"
