--Description: 7) Compute the day-gap between a user’s first and last visit (two-day slice).
--             Fix: give the derived UNION table an alias, then build the “visits” CTE.
WITH unioned AS (
    SELECT "fullVisitorId","date"
    FROM  GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
    UNION ALL
    SELECT "fullVisitorId","date"
    FROM  GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160802"
),
visits AS (
    SELECT  "fullVisitorId",
            TO_DATE(MIN("date"),'YYYYMMDD') AS first_d,
            TO_DATE(MAX("date"),'YYYYMMDD') AS last_d
    FROM    unioned
    GROUP BY "fullVisitorId"
)
SELECT *, DATEDIFF('day', first_d, last_d) AS gap_days
FROM   visits
LIMIT 20
