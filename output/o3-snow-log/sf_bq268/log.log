```sql
--Description: 9) Combine first visit, first transaction, and last visit to locate each user’s “last recorded event” date (last visit or first txn), still on the two-day slice.  
WITH base AS (
      SELECT "fullVisitorId",
             TO_DATE("date",'YYYYMMDD')                         AS visit_d,
             "device"::VARIANT:"deviceCategory"::STRING         AS dev_cat,
             "totals"::VARIANT:"transactions"                  AS tx
      FROM  GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
      UNION ALL
      SELECT "fullVisitorId",
             TO_DATE("date",'YYYYMMDD'),
             "device"::VARIANT:"deviceCategory"::STRING,
             "totals"::VARIANT:"transactions"
      FROM  GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160802"
),
firsts AS (
      SELECT "fullVisitorId",
             MIN(visit_d)                               AS first_visit
      FROM   base
      GROUP BY "fullVisitorId"
),
first_tx AS (
      SELECT "fullVisitorId",
             MIN(visit_d)                               AS first_txn
      FROM   base
      WHERE  tx IS NOT NULL
      GROUP BY "fullVisitorId"
),
last_vis AS (
      SELECT "fullVisitorId",
             MAX(visit_d)                               AS last_visit,
             MAX_BY(dev_cat,visit_d)                    AS last_visit_device
      FROM   base
      GROUP BY "fullVisitorId"
)
SELECT f."fullVisitorId",
       f.first_visit,
       COALESCE(t.first_txn,l.last_visit)               AS last_event_date,
       l.last_visit_device
FROM   firsts f
LEFT  JOIN first_tx t  ON f."fullVisitorId"=t."fullVisitorId"
LEFT  JOIN last_vis l  ON f."fullVisitorId"=l."fullVisitorId"
WHERE  l.last_visit_device ILIKE '%mobile%'
LIMIT 20;
```

```sql
--Description: 10) Finally, compute the maximum number of days between first visit and “last recorded event” for users whose last recorded event was on a mobile device (still two-day demo slice).  
WITH base AS (
      SELECT "fullVisitorId",
             TO_DATE("date",'YYYYMMDD')                     AS visit_d,
             "device"::VARIANT:"deviceCategory"::STRING     AS dev_cat,
             "totals"::VARIANT:"transactions"              AS tx
      FROM  GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
      UNION ALL
      SELECT "fullVisitorId",
             TO_DATE("date",'YYYYMMDD'),
             "device"::VARIANT:"deviceCategory"::STRING,
             "totals"::VARIANT:"transactions"
      FROM  GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160802"
),
first_visit AS (
     SELECT "fullVisitorId", MIN(visit_d) AS first_d
     FROM   base
     GROUP BY "fullVisitorId"
),
first_txn AS (
     SELECT "fullVisitorId", MIN(visit_d) AS first_txn_d
     FROM   base
     WHERE  tx IS NOT NULL
     GROUP BY "fullVisitorId"
),
last_visit AS (
     SELECT "fullVisitorId",
            MAX(visit_d)  AS last_d,
            MAX_BY(dev_cat,visit_d) AS last_dev
     FROM   base
     GROUP BY "fullVisitorId"
),
last_event AS (
     SELECT fv."fullVisitorId",
            fv.first_d,
            CASE 
               WHEN ft.first_txn_d IS NULL 
                    OR ft.first_txn_d > lv.last_d THEN lv.last_d
               ELSE ft.first_txn_d
            END                                AS last_event_d,
            lv.last_dev
     FROM   first_visit fv
     LEFT   JOIN first_txn  ft ON fv."fullVisitorId" = ft."fullVisitorId"
     JOIN   last_visit  lv ON fv."fullVisitorId" = lv."fullVisitorId"
     WHERE  lv.last_dev ILIKE '%mobile%'
)
SELECT MAX(DATEDIFF('day',first_d,last_event_d))  AS "max_days_gap"
FROM   last_event
LIMIT 20;
```

The ten progressively richer queries above explore the required fields and logic—from inspecting device categories to calculating the ultimate day-gap—while always returning only a small sample (LIMIT 20) for safe exploration.
