--Description: 8) Show the first transaction date for visitors who generated revenue (two-day slice).
--             Fix: give the UNION sub-query an alias and reference it in the outer SELECT.
WITH unioned AS (
    SELECT "fullVisitorId","date","totals"::VARIANT:"transactions" AS tx
