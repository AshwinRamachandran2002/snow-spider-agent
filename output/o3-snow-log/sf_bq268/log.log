--Description: 9) Combine first visit, first transaction, and last visit to locate each user’s
--             “last recorded event” date (last visit or first txn) when the last visit used mobile.
--             Fix: replace unsupported MAX_BY with ROW_NUMBER logic.
WITH base AS (
    SELECT "fullVisitorId",
           TO_DATE("date",'YYYYMMDD')                         AS visit_d,
           "device"::VARIANT:"deviceCategory"::STRING         AS dev_cat,
           "totals"::VARIANT:"transactions"                  AS tx
    FROM  GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
    UNION ALL
    SELECT "fullVisitorId",
           TO_DATE("date",'YYYYMMDD')                         AS visit_d,
           "device"::VARIANT:"deviceCategory"::STRING         AS dev_cat,
           "totals"::VARIANT:"transactions"                  AS tx
    FROM  GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160802"
),
firsts AS (
    SELECT "fullVisitorId",
           MIN(visit_d) AS first_visit
    FROM   base
    GROUP BY "fullVisitorId"
),
first_tx AS (
    SELECT "fullVisitorId",
           MIN(visit_d) AS first_txn
    FROM   base
    WHERE  tx IS NOT NULL
    GROUP BY "fullVisitorId"
),
last_vis AS (
    SELECT  "fullVisitorId",
            visit_d  AS last_visit,
            dev_cat  AS last_visit_device
    FROM   (
            SELECT *,
                   ROW_NUMBER() OVER (PARTITION BY "fullVisitorId"
                                      ORDER BY visit_d DESC) AS rn
            FROM   base
           ) v
    WHERE  rn = 1
)
SELECT f."fullVisitorId",
       f.first_visit,
       COALESCE(t.first_txn, l.last_visit) AS last_event_date,
       l.last_visit_device
FROM   firsts     f
LEFT   JOIN first_tx t ON f."fullVisitorId" = t."fullVisitorId"
JOIN   last_vis   l ON f."fullVisitorId" = l."fullVisitorId"
WHERE  l.last_visit_device ILIKE '%mobile%'
LIMIT 20
