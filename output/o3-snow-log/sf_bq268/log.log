Query:
--Description: 5) Union two consecutive-day tables to see how a user’s first and last dates vary.  
SELECT "fullVisitorId",
       MIN("date") AS "first_date",
       MAX("date") AS "last_date"
FROM  (       
        SELECT "fullVisitorId","date"
        FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
        UNION ALL
        SELECT "fullVisitorId","date"
        FROM   GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160802"
      ) u
GROUP BY "fullVisitorId"
LIMIT 20;
