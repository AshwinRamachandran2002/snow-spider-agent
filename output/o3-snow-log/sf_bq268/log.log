```sql
--Description: 7) Compute the day-gap between first visit and last visit (two-day sample).  
WITH visits AS (
      SELECT "fullVisitorId",
             TO_DATE(MIN("date"),'YYYYMMDD') AS first_d,
             TO_DATE(MAX("date"),'YYYYMMDD') AS last_d
      FROM  (SELECT "fullVisitorId","date" FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
             UNION ALL
             SELECT "fullVisitorId","date" FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160802")
      GROUP BY "fullVisitorId"
)
SELECT *, DATEDIFF('day',first_d,last_d) AS gap_days
FROM   visits
LIMIT 20;
