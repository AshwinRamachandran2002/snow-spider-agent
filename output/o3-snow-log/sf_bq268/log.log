    JOIN   last_visit  lv ON fv."fullVisitorId" = lv."fullVisitorId"
    WHERE  lv.last_dev ILIKE '%mobile%'
)
SELECT MAX(DATEDIFF('day', first_d, last_event_d)) AS max_days_gap
