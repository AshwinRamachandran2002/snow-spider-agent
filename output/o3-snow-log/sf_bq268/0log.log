```sql
--Description: 1) Quick look at the raw JSON stored in the DEVICE column so we know the keys we can later pick.
SELECT 
    "device"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
LIMIT 20;
```

```sql
--Description: 2) Inspect the most-used keys inside DEVICE and how many distinct values they take.
SELECT DISTINCT 
    "device":"deviceCategory"::STRING         AS "deviceCategory",
    "device":"browser"::STRING                AS "browser",
    "device":"operatingSystem"::STRING        AS "os"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
LIMIT 20;
```

```sql
--Description: 3) Show a few rows that are explicitly tagged as mobile devices (deviceCategory = 'mobile').
SELECT 
    "fullVisitorId",
    "visitId",
    "date",
    "device":"deviceCategory"::STRING  AS "deviceCategory",
    "device":"browser"::STRING         AS "browser",
    "device":"isMobile"::BOOLEAN       AS "isMobileFlag"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
WHERE "device":"deviceCategory"::STRING ILIKE '%mobile%'
LIMIT 20;
```

```sql
--Description: 4) Check the first (MIN) and last (MAX) visit date recorded for a sample of 20 users.
SELECT 
    "fullVisitorId",
    MIN("date") AS "first_date",
    MAX("date") AS "last_date"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
GROUP BY "fullVisitorId"
LIMIT 20;
```

```sql
--Description: 5) Display totals.* fields (still JSON) for sessions that include a transaction (>0).
SELECT 
    "fullVisitorId",
    "visitId",
    "date",
    "totals"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
WHERE "totals":"transactions" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 6) Pull out totalTransactionRevenue and totalHits from the nested TOTALS object for a quick sanity check.
SELECT 
    "fullVisitorId",
    "visitId",
    "date",
    "totals":"totalTransactionRevenue"::NUMBER AS "revenue",
    "totals":"hits"::NUMBER                   AS "hits"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
LIMIT 20;
```

```sql
--Description: 7) Identify, for each user, the first session that actually contains a transaction (first-purchase date).
SELECT 
    "fullVisitorId",
    MIN("date") AS "first_purchase_date"
FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
WHERE "totals":"transactions"::NUMBER > 0
GROUP BY "fullVisitorId"
LIMIT 20;
```

```sql
--Description: 8) For every user, list the session that has the latest DATE value (their “last visit” in this slice).
SELECT
    t."fullVisitorId",
    t."date"                AS "last_visit_date",
    t."device":"deviceCategory"::STRING AS "deviceCategory"
FROM (
    SELECT 
        "fullVisitorId",
        "date",
        ROW_NUMBER() OVER (PARTITION BY "fullVisitorId" ORDER BY "date" DESC) AS rn,
        "device"
    FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
) t
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: 9) Same as #8, but keep only users whose last recorded event was on a mobile device.
SELECT
    t."fullVisitorId",
    t."date"                    AS "last_mobile_event_date",
    t."device":"deviceCategory"::STRING AS "deviceCategory"
FROM (
    SELECT 
        "fullVisitorId",
        "date",
        ROW_NUMBER() OVER (PARTITION BY "fullVisitorId" ORDER BY "date" DESC) AS rn,
        "device"
    FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
) t
WHERE rn = 1
  AND t."device":"deviceCategory"::STRING ILIKE '%mobile%'
LIMIT 20;
```

```sql
--Description: 10) (Complex) Combine first visit, first transaction and last visit; compute the day span
--               between first visit and whichever of the two (“last visit” OR “first transaction”)
--               is later, for users whose last recorded event is on a mobile device.
SELECT
    base."fullVisitorId",
    TO_DATE(base."first_visit", 'YYYYMMDD')                         AS "first_visit_dt",
    TO_DATE(base."first_transaction", 'YYYYMMDD')                   AS "first_txn_dt",
    TO_DATE(base."last_visit", 'YYYYMMDD')                          AS "last_visit_dt",
    GREATEST(
        TO_DATE(base."last_visit",        'YYYYMMDD'),
        TO_DATE(base."first_transaction", 'YYYYMMDD')
    )                                                               AS "last_recorded_event_dt",
    DATEDIFF(
        day, 
        TO_DATE(base."first_visit", 'YYYYMMDD'),
        GREATEST(
            TO_DATE(base."last_visit",        'YYYYMMDD'),
            TO_DATE(base."first_transaction", 'YYYYMMDD')
        )
    )                                                               AS "days_between"
FROM (
    /* ----------- gather first visit, first txn, last visit ----------- */
    SELECT
        "fullVisitorId",
        MIN("date")                                                     AS "first_visit",
        MIN(CASE WHEN "totals":"transactions"::NUMBER > 0 
                 THEN "date" END)                                       AS "first_transaction",
        MAX("date")                                                     AS "last_visit",
        MAX(CASE WHEN "totals":"transactions"::NUMBER > 0 
                 THEN "date" END)                                       AS "last_transaction",
        MAX("device":"deviceCategory"::STRING)                          AS "device_category_on_last_row"  -- rough check
    FROM GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801"
    GROUP BY "fullVisitorId"
) base
/* keep only users whose most-recent session (in this slice) was on mobile */
JOIN GA360.GOOGLE_ANALYTICS_SAMPLE."GA_SESSIONS_20160801" last_sess
  ON last_sess."fullVisitorId" = base."fullVisitorId"
  AND last_sess."date"            = base."last_visit"
WHERE last_sess."device":"deviceCategory"::STRING ILIKE '%mobile%'
LIMIT 20;
```
