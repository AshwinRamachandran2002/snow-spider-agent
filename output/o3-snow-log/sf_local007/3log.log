```sql
WITH player_dates AS (
    SELECT 
        "player_id",
        TO_DATE(NULLIF("debut", ''))       AS debut_dt,
        TO_DATE(NULLIF("final_game", ''))  AS final_dt
    FROM BASEBALL.BASEBALL.PLAYER
),
valid_players AS (                      -- keep only rows with two valid dates and a non-negative span
    SELECT *
    FROM player_dates
    WHERE debut_dt IS NOT NULL
      AND final_dt IS NOT NULL
      AND final_dt >= debut_dt
),
diffs AS (                              -- total months between the two dates
    SELECT 
        "player_id",
        debut_dt,
        final_dt,
        DATEDIFF('month', debut_dt, final_dt) AS total_months
    FROM valid_players
),
components AS (                         -- split into years / months / days components
    SELECT
        "player_id",
        FLOOR(total_months / 12)                             AS years_part,
        MOD(total_months, 12)                                AS months_part,
        ABS( DATEDIFF('day',
               DATEADD('month', total_months, debut_dt),      -- leftover days after removing full months
               final_dt) )                                   AS days_part
    FROM diffs
),
career_span AS (                        -- build the span for each player
    SELECT
        "player_id",
        ROUND(years_part      ::NUMBER, 2)                                       +
        ROUND(months_part / 12.0,          2)                                    +
        ROUND(days_part   / 365.0,          2)          AS span_years
    FROM components
)
SELECT 
    ROUND(AVG(span_years)::FLOAT, 4)   AS average_career_span_years
FROM career_span;
```
