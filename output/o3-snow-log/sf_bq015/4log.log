count': None}, {'id': 5362330, 'title': None, 'body': 'Smart GWT is a GWT-based framework that allows you to not only utilize its comprehensive widget library for your application UI, but also tie these widgets in with your server-side for data management', 'accepted_answer_id': None, 'answer_count': None, 'comment_count': 0, 'community_owned_date': None, 'creation_date': 1300540917987000, 'favorite_count': None, 'last_activity_date': 1300870268977000, 'last_edit_date': 1300870268977000, 'last_editor_display_name': 'user614868', 'last_editor_user_id': None, 'owner_display_name': 'user614868', 'owner_user_id': None, 'parent_id': None, 'post_type_id': 4, 'score': 0, 'tags': None, 'view_count': None}, {'id': 5410996, 'title': None, 'body': 'A class within System.Windows.Automation; represents a UI Automation element in the UI Automation tree, and contains values used as identifiers by UI Automation client applications.', 'accepted_answer_id': None, 'answer_count': None, 'comment_count': 0, 'community_owned_date': None, 'creation_date': 1300910873303000, 'favorite_count': None, 'last_activity_date': 1300910873303000, 'last_edit_date': 1300910873303000, 'last_editor_display_name': 'user1228', 'last_editor_user_id': None, 'owner_display_name': 'user1228', 'owner_user_id': None, 'parent_id': None, 'post_type_id': 4, 'score': 0, 'tags': None, 'view_count': None}]

