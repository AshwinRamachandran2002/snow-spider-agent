```sql
/* Top 10 Stack Overflow tags that appear in questions referenced
   by Hacker News comments made on or after 2014-01-01              */

WITH hn_comments AS (   /* all HN comments (≥2014-01-01) */
    SELECT "text"
    FROM (
          SELECT "text","time" FROM STACKOVERFLOW_PLUS.HACKERNEWS.FULL_201510
          UNION ALL
          SELECT "text","time" FROM STACKOVERFLOW_PLUS.HACKERNEWS.COMMENTSV2
          UNION ALL
          SELECT "text","time" FROM STACKOVERFLOW_PLUS.HACKERNEWS.FULL_PARTITION_EXTRA
          UNION ALL
          SELECT "text","time" FROM STACKOVERFLOW_PLUS.HACKERNEWS.COMMENTS
          UNION ALL
          SELECT "text","time" FROM STACKOVERFLOW_PLUS.HACKERNEWS.COMMENTS_CONVOLUTION
         )
    WHERE "time" >= 1388534400          -- 2014-01-01 00:00:00 UTC
),

nums AS (                           -- helper: 1 … 20
    SELECT SEQ4()+1 AS n
    FROM TABLE(GENERATOR(ROWCOUNT => 20))
),

/* extract every Stack Overflow question-id mentioned in each comment */
extracted AS (
    SELECT
        CAST(
            REGEXP_SUBSTR(
                c."text",
                'stackoverflow\\.com/questions/([0-9]+)',  -- pattern
                1, nums.n, 'e', 1                          -- occurrence n, return 1st capture
            ) AS NUMBER
        )              AS question_id
    FROM hn_comments c
    JOIN nums
      ON REGEXP_SUBSTR(c."text",
                       'stackoverflow\\.com/questions/([0-9]+)',
                       1, nums.n, 'e', 1) IS NOT NULL
),

/* how many times was each question mentioned? */
question_counts AS (
    SELECT question_id,
           COUNT(*) AS mention_count
    FROM extracted
    GROUP BY question_id
),

/* bring in the questions’ tag strings */
question_tags AS (
    SELECT qc.question_id,
           qc.mention_count,
           q."tags"
    FROM question_counts  qc
    JOIN STACKOVERFLOW_PLUS.STACKOVERFLOW.POSTS_QUESTIONS q
      ON q."id" = qc.question_id
    WHERE q."tags" IS NOT NULL
),

/* explode tag strings, accumulate counts weighted by mentions */
tag_counts AS (
    SELECT
        TRIM(tag.VALUE::string)        AS tag,
        SUM(question_tags.mention_count) AS total_mentions
    FROM question_tags,
         LATERAL SPLIT_TO_TABLE(question_tags."tags", '|') tag
    GROUP BY tag
)

/* top 10 tags */
SELECT tag,
       total_mentions
FROM tag_counts
ORDER BY total_mentions DESC NULLS LAST
LIMIT 10;
```
