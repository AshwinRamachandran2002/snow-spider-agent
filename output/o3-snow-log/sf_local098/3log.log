```sql
--Description: Evaluate the largest gap between consecutive credited years for every actor, using
--TRY_TO_NUMBER to ignore malformed “year” values.  We then list the first 20 actors with their
--calculated maximum gap, ordered from biggest to smallest, so you can validate that gaps are
--being computed correctly and that values ≥ 4 indeed appear.
WITH actor_years AS (          -- collect clean (PID, year) pairs
     SELECT DISTINCT
            mc."PID",
            TRY_TO_NUMBER(m."year") AS "year"
     FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
     JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m
            ON mc."MID" = m."MID"
     WHERE  TRY_TO_NUMBER(m."year") IS NOT NULL
), gaps AS (                   -- compute successive-year gaps per actor
     SELECT
            ay."PID",
            ay."year",
            LEAD(ay."year") OVER (PARTITION BY ay."PID" ORDER BY ay."year") AS "next_year"
     FROM   actor_years ay
), max_gap AS (                -- derive each actor’s maximum gap
     SELECT
            g."PID",
            MAX(g."next_year" - g."year") AS "max_gap"
     FROM   gaps g
     WHERE  g."next_year" IS NOT NULL
     GROUP BY g."PID"
)
SELECT
       mg."PID",
       mg."max_gap"
FROM   max_gap mg
ORDER  BY mg."max_gap" DESC
LIMIT 20;
```
