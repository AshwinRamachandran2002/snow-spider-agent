```sql
--Description: 8) Compute maximum gap (in years) for every actor, using TRY_TO_NUMBER for safe year parsing and 
--ignoring the final credit (which has no following year).  Show the first 20 actors with their max_gap.
WITH actor_years AS (          -- step 1: gather clean (PID, year) pairs
     SELECT DISTINCT
            mc."PID",
            TRY_TO_NUMBER(m."year") AS "year"
     FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
     JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m
            ON mc."MID" = m."MID"
     WHERE  TRY_TO_NUMBER(m."year") IS NOT NULL
), gaps AS (                   -- step 2: compute year-to-next-year gaps
     SELECT
            ay."PID",
            ay."year",
            LEAD(ay."year") OVER (PARTITION BY ay."PID" ORDER BY ay."year") AS "next_year"
     FROM   actor_years ay
), gap_values AS (             -- step 3: keep rows where a next_year exists and derive the gap size
     SELECT
            g."PID",
            g."next_year" - g."year" AS "gap"
     FROM   gaps g
     WHERE  g."next_year" IS NOT NULL
), max_gap AS (                -- step 4: pick each actor’s largest gap
     SELECT
            gv."PID",
            MAX(gv."gap") AS "max_gap"
     FROM   gap_values gv
     GROUP BY gv."PID"
)
SELECT *
FROM   max_gap
ORDER  BY "max_gap" DESC
LIMIT 20;
```

