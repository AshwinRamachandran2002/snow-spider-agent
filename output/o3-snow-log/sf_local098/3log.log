```sql
--Description: 8) Compute maximum gap (in years) for every actor.
WITH actor_years AS (
     SELECT DISTINCT mc."PID", CAST(m."year" AS INTEGER) AS "year"
     FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
     JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m
            ON mc."MID" = m."MID"
), gaps AS (
     SELECT ay."PID",
            ay."year",
            LEAD(ay."year") OVER (PARTITION BY ay."PID" ORDER BY ay."year") AS "next_year"
     FROM   actor_years ay
), max_gap AS (
     SELECT g."PID",
            MAX( COALESCE(g."next_year", g."year") - g."year" ) AS "max_gap"
     FROM   gaps g
     GROUP BY g."PID"
)
SELECT * 
FROM   max_gap 
LIMIT 20;
```

```sql
--Description: 9) List actors whose largest gap ≤ 3 years (i.e., no 4-year span without a credit).
WITH actor_years AS (
     SELECT DISTINCT mc."PID", CAST(m."year" AS INTEGER) AS "year"
     FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
     JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m
            ON mc."MID" = m."MID"
), gaps AS (
     SELECT ay."PID",
            ay."year",
            LEAD(ay."year") OVER (PARTITION BY ay."PID" ORDER BY ay."year") AS "next_year"
     FROM   actor_years ay
), max_gap AS (
     SELECT g."PID",
            MAX( COALESCE(g."next_year", g."year") - g."year" ) AS "max_gap"
     FROM   gaps g
     GROUP BY g."PID"
)
SELECT mg."PID"
FROM   max_gap mg
WHERE  mg."max_gap" <= 3
LIMIT 20;
```

```sql
--Description: 10) Final answer – count of actors who never have a gap longer than 3 consecutive years.
WITH actor_years AS (
     SELECT DISTINCT mc."PID", CAST(m."year" AS INTEGER) AS "year"
     FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
     JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m
            ON mc."MID" = m."MID"
     WHERE  m."year" IS NOT NULL
), gaps AS (
     SELECT ay."PID",
            ay."year",
            LEAD(ay."year") OVER (PARTITION BY ay."PID" ORDER BY ay."year") AS "next_year"
     FROM   actor_years ay
), max_gap AS (
     SELECT g."PID",
            MAX( COALESCE(g."next_year", g."year") - g."year" ) AS "max_gap"
     FROM   gaps g
     GROUP BY g."PID"
)
SELECT COUNT(*) AS "actors_no_4yr_gap"
FROM   max_gap
WHERE  "max_gap" <= 3;
```
