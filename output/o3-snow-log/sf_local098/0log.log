Query:
--Description: Combine cast and movie tables to see (actor, film-year) pairs,
--             using SAFE numeric extraction for the year to avoid casting errors.
SELECT mc."PID",
       p."Name",
       m."title",
       TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '[0-9]{4}')) AS "film_year"
FROM DB_IMDB.DB_IMDB."M_CAST"   mc
JOIN DB_IMDB.DB_IMDB."MOVIE"    m ON mc."MID" = m."MID"
LEFT JOIN DB_IMDB.DB_IMDB."PERSON" p ON mc."PID" = p."PID"
ORDER BY mc."PID",
         TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '[0-9]{4}'))
LIMIT 20
