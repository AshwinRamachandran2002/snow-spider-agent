       LISTAGG(DISTINCT m."year", ', ') WITHIN GROUP
           (ORDER BY TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '[0-9]{4}'))) AS "years_active"
FROM DB_IMDB.DB_IMDB."M_CAST" mc
JOIN DB_IMDB.DB_IMDB."MOVIE"  m ON mc."MID" = m."MID"
GROUP BY mc."PID"
LIMIT 20
