FROM DB_IMDB.DB_IMDB."PERSON"
LIMIT 20;
```

```sql
--Description: Verify the distribution of film release years in MOVIE.
SELECT DISTINCT "MID", "title", "year"
FROM DB_IMDB.DB_IMDB."MOVIE"
ORDER BY "year"::INTEGER
LIMIT 20;
```

```sql
--Description: Combine cast and movie tables to see (actor, film-year) pairs.  
SELECT mc."PID",
       p."Name",
       m."title",
       m."year"::INTEGER AS "film_year"
FROM DB_IMDB.DB_IMDB."M_CAST"  mc
JOIN DB_IMDB.DB_IMDB."MOVIE"   m ON mc."MID" = m."MID"
LEFT JOIN DB_IMDB.DB_IMDB."PERSON" p ON mc."PID" = p."PID"
ORDER BY mc."PID", m."year"::INTEGER
LIMIT 20;
```

```sql
--Description: For every actor, get the very first and very last year they appeared in any film.  
SELECT mc."PID",
       MIN(m."year"::INTEGER) AS "first_year",
       MAX(m."year"::INTEGER) AS "last_year"
FROM DB_IMDB.DB_IMDB."M_CAST" mc
JOIN DB_IMDB.DB_IMDB."MOVIE"  m ON mc."MID" = m."MID"
GROUP BY mc."PID"
LIMIT 20;
```

```sql
--Description: Show all distinct years each actor worked, helpful to inspect gaps manually.  
SELECT mc."PID",
       LISTAGG(DISTINCT m."year", ', ') WITHIN GROUP (ORDER BY m."year"::INTEGER) AS "years_active"
FROM DB_IMDB.DB_IMDB."M_CAST" mc
JOIN DB_IMDB.DB_IMDB."MOVIE"  m ON mc."MID" = m."MID"
GROUP BY mc."PID"
LIMIT 20;
```

```sql
--Description: Create row numbers per actor sorted by year to prepare for gap analysis.  
SELECT mc."PID",
       m."year"::INTEGER          AS "film_year",
       ROW_NUMBER() OVER (PARTITION BY mc."PID" ORDER BY m."year"::INTEGER) AS "rn"
FROM DB_IMDB.DB_IMDB."M_CAST" mc
JOIN DB_IMDB.DB_IMDB."MOVIE"  m ON mc."MID" = m."MID"
ORDER BY mc."PID", "film_year"
LIMIT 20;
```

```sql
--Description: Compute the difference between consecutive film years for each actor.  
SELECT sub."PID",
       sub."film_year",
       sub."film_year" - LAG(sub."film_year") OVER (PARTITION BY sub."PID" ORDER BY sub."film_year") AS "year_gap"
FROM (
    SELECT mc."PID",
           m."year"::INTEGER AS "film_year"
    FROM DB_IMDB.DB_IMDB."M_CAST" mc
    JOIN DB_IMDB.DB_IMDB."MOVIE"  m ON mc."MID" = m."MID"
    GROUP BY mc."PID", m."year"   -- ensure one row per (PID,year)
) sub
ORDER BY sub."PID", sub."film_year"
LIMIT 20;
```

```sql
--Description: Flag actors who ever experienced a gap of 4+ years between movies.  
SELECT gap."PID",
       MAX(CASE WHEN gap."year_gap" >= 4 THEN 1 ELSE 0 END) AS "has_4yr_gap"
FROM (
    SELECT mc."PID",
           m."year"::INTEGER AS "film_year",
           m."year"::INTEGER - LAG(m."year"::INTEGER) OVER (PARTITION BY mc."PID" ORDER BY m."year"::INTEGER) AS "year_gap"
    FROM DB_IMDB.DB_IMDB."M_CAST" mc
    JOIN DB_IMDB.DB_IMDB."MOVIE"  m ON mc."MID" = m."MID"
    GROUP BY mc."PID", m."year"
) gap
GROUP BY gap."PID"
LIMIT 20;
```

```sql
--Description: Count actors who NEVER had a 4-year gap anywhere in their careers (final answer style).  
SELECT COUNT(*) AS "actors_no_4yr_gap"
FROM (
    SELECT gap."PID"
    FROM (
        SELECT mc."PID",
               m."year"::INTEGER AS "film_year",
               m."year"::INTEGER - LAG(m."year"::INTEGER) OVER (PARTITION BY mc."PID" ORDER BY m."year"::INTEGER) AS "year_gap"
        FROM DB_IMDB.DB_IMDB."M_CAST" mc
        JOIN DB_IMDB.DB_IMDB."MOVIE"  m ON mc."MID" = m."MID"
        GROUP BY mc."PID", m."year"
    ) gap
    GROUP BY gap."PID"
    HAVING MAX(CASE WHEN gap."year_gap" >= 4 THEN 1 ELSE 0 END) = 0
) t;
```

