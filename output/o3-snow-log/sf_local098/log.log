```sql
--Description: List the actors whose longest gap between consecutive film appearances
--             is 3 years or less (i.e., they never have a 4-year break).
--             1) clean_credits  – extract a valid 4-digit year from MOVIE."year"
--                via REGEXP_SUBSTR and safely convert with TRY_TO_NUMBER.
--             2) gaps           – compute the difference between each credit year
--                and the previous one for every actor using LAG().
--             3) max_gap        – aggregate to each actor’s maximum gap and keep
--                only those where the maximum gap ≤ 3.
--             NOTE: the alias max_gap is created unquoted, so reference it as
--                   mg.max_gap (no double-quotes) to avoid identifier errors.
WITH clean_credits AS (
    SELECT
        mc."PID",
        TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) AS yr
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
    JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m  ON m."MID" = mc."MID"
    WHERE  TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) IS NOT NULL
),
gaps AS (
    SELECT
        "PID",
        yr - LAG(yr) OVER (PARTITION BY "PID" ORDER BY yr) AS gap_years
    FROM clean_credits
),
max_gap AS (
    SELECT
        "PID",
        COALESCE(MAX(gap_years), 0) AS max_gap
    FROM gaps
    GROUP BY "PID"
    HAVING COALESCE(MAX(gap_years), 0) <= 3
)
SELECT
       mg."PID",
       p."Name",
       mg.max_gap
FROM   max_gap mg
LEFT   JOIN "DB_IMDB"."DB_IMDB"."PERSON" p ON p."PID" = mg."PID"
LIMIT 20;
```
