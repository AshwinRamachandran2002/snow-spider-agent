```sql
--Description: Final single-step answer: count how many actors never have a break
--             longer than 3 consecutive years between movie appearances.
--             1) Clean “year” values by extracting a four-digit number and converting
--                it with TRY_TO_NUMBER (avoids errors like ‘I 2009’).
--             2) For every actor, calculate the gap between consecutive appearance
--                years with the LAG window function.
--             3) Aggregate to find each actor’s maximum gap; keep those whose
--                max gap ≤ 3 (i.e., no 4-year span without a credit).
--             4) Finally count those actors.
WITH credits AS (
    SELECT
        mc."PID",
        TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) AS yr
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
    JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m  ON m."MID" = mc."MID"
    WHERE  TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) IS NOT NULL
),
gaps AS (
    SELECT
        c."PID",
        yr,
        yr - LAG(yr) OVER (PARTITION BY c."PID" ORDER BY yr) AS gap
    FROM credits c
),
max_gap AS (
    SELECT
        "PID",
        COALESCE(MAX(gap), 0) AS max_gap
    FROM gaps
    GROUP BY "PID"
    HAVING COALESCE(MAX(gap), 0) <= 3   -- keep actors with no 4-year break
)
SELECT COUNT(*) AS actors_without_4yr_gap
FROM   max_gap;
```
