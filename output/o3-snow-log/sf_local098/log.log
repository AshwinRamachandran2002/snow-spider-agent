```sql
--Description: Determine each performer’s career span by finding the first and last
--             credited movie years.  We (1) join the cast bridge to the movie table
--             to access the release year, (2) cast the text “year” to NUMBER for
--             proper aggregation, and (3) GROUP BY actor (PID) and name to obtain
--             their MIN (earliest) and MAX (latest) appearance years.
SELECT
       mc."PID",
       p."Name",
       MIN(TO_NUMBER(m."year")) AS "first_year",
       MAX(TO_NUMBER(m."year")) AS "last_year"
FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m  ON m."MID" = mc."MID"
LEFT   JOIN "DB_IMDB"."DB_IMDB"."PERSON" p ON p."PID" = mc."PID"
GROUP  BY mc."PID", p."Name"
LIMIT 20;
```
