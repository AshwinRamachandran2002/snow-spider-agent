LEFT  JOIN "DB_IMDB"."DB_IMDB"."PERSON" p ON p."PID" = mc."PID"
LIMIT  20;
```

```sql
--Description: 6) Earliest and latest credited years for every actor/actress (career span)  
SELECT mc."PID",
       p."Name",
       MIN(TO_NUMBER(m."year")) AS "first_year",
       MAX(TO_NUMBER(m."year")) AS "last_year"
FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"  m  ON m."MID" = mc."MID"
LEFT  JOIN "DB_IMDB"."DB_IMDB"."PERSON" p ON p."PID" = mc."PID"
GROUP  BY mc."PID", p."Name"
LIMIT  20;
```

```sql
--Description: 7) For each credit, calculate the gap (in years) from previous credit for that same performer  
SELECT  mc."PID",
        p."Name",
        TO_NUMBER(m."year")                          AS "credit_year",
        LAG(TO_NUMBER(m."year")) 
          OVER (PARTITION BY mc."PID" ORDER BY TO_NUMBER(m."year")) AS "prev_year",
        TO_NUMBER(m."year") 
          - LAG(TO_NUMBER(m."year")) 
          OVER (PARTITION BY mc."PID" ORDER BY TO_NUMBER(m."year")) AS "gap_years"
FROM    "DB_IMDB"."DB_IMDB"."M_CAST" mc
JOIN    "DB_IMDB"."DB_IMDB"."MOVIE"  m  ON m."MID" = mc."MID"
LEFT   JOIN "DB_IMDB"."DB_IMDB"."PERSON" p ON p."PID" = mc."PID"
ORDER  BY mc."PID", "credit_year"
LIMIT   20;
```

```sql
--Description: 8) Derive the maximum gap (in years) between consecutive appearances for every performer  
SELECT  "PID",
        MAX("gap_years") AS "max_gap"
FROM   (
        SELECT  mc."PID",
                TO_NUMBER(m."year") 
                  - LAG(TO_NUMBER(m."year")) 
                  OVER (PARTITION BY mc."PID" ORDER BY TO_NUMBER(m."year")) AS "gap_years"
        FROM    "DB_IMDB"."DB_IMDB"."M_CAST" mc
        JOIN    "DB_IMDB"."DB_IMDB"."MOVIE"  m  ON m."MID" = mc."MID"
       )
GROUP  BY "PID"
LIMIT  20;
```

```sql
--Description: 9) List actors/actresses whose maximum gap is 3 years or fewer (i.e., no 4-year break)  
SELECT  g."PID",
        p."Name",
        g."max_gap"
FROM   (
        SELECT  "PID",
                COALESCE(MAX("gap_years"), 0) AS "max_gap"
        FROM   (
                SELECT  mc."PID",
                        TO_NUMBER(m."year") 
                          - LAG(TO_NUMBER(m."year")) 
                          OVER (PARTITION BY mc."PID" ORDER BY TO_NUMBER(m."year")) AS "gap_years"
                FROM    "DB_IMDB"."DB_IMDB"."M_CAST" mc
                JOIN    "DB_IMDB"."DB_IMDB"."MOVIE"  m  ON m."MID" = mc."MID"
              )
        GROUP BY "PID"
       ) g
JOIN   "DB_IMDB"."DB_IMDB"."PERSON" p ON p."PID" = g."PID"
WHERE  g."max_gap" <= 3
LIMIT  20;
```

```sql
--Description: 10) Final count of such consistently active performers across the whole database  
SELECT  COUNT(*) AS "actors_without_4yr_gap"
FROM   (
        SELECT  "PID",
                COALESCE(MAX("gap_years"), 0) AS "max_gap"
        FROM   (
                SELECT  mc."PID",
                        TO_NUMBER(m."year") 
                          - LAG(TO_NUMBER(m."year")) 
                          OVER (PARTITION BY mc."PID" ORDER BY TO_NUMBER(m."year")) AS "gap_years"
                FROM    "DB_IMDB"."DB_IMDB"."M_CAST" mc
                JOIN    "DB_IMDB"."DB_IMDB"."MOVIE"  m  ON m."MID" = mc."MID"
             )
        GROUP  BY "PID"
        HAVING COALESCE(MAX("gap_years"), 0) <= 3
       )
LIMIT  20;
```
