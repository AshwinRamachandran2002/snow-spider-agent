--Description: 6) Earliest and latest credited years for every actor/actress
--             (uses REGEXP_SUBSTR + TRY_TO_NUMBER to avoid bad “year” formats).
SELECT
       mc."PID",
       p."Name",
       MIN(TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}'))) AS "first_year",
       MAX(TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}'))) AS "last_year"
FROM   "DB_IMDB"."DB_IMDB"."M_CAST"   mc
JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"    m  ON m."MID" = mc."MID"
LEFT   JOIN "DB_IMDB"."DB_IMDB"."PERSON"  p ON p."PID" = mc."PID"
WHERE  TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) IS NOT NULL
GROUP  BY mc."PID", p."Name"
LIMIT 20;
```

```sql
--Description: 7) For each credit, calculate the gap (in years) from the previous credit
--             (safe year extraction + conversion).
WITH clean_credits AS (
    SELECT
        mc."PID",
        p."Name",
        TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) AS yr
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST"   mc
    JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"    m  ON m."MID" = mc."MID"
    LEFT   JOIN "DB_IMDB"."DB_IMDB"."PERSON" p ON p."PID" = mc."PID"
    WHERE  TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) IS NOT NULL
)
SELECT
       "PID",
       "Name",
       yr                               AS "credit_year",
       LAG(yr)  OVER (PARTITION BY "PID" ORDER BY yr)            AS "prev_year",
       yr - LAG(yr) OVER (PARTITION BY "PID" ORDER BY yr)        AS "gap_years"
FROM   clean_credits
ORDER  BY "PID", "credit_year"
LIMIT 20;
```

```sql
--Description: 8) Derive the maximum gap (in years) between consecutive appearances
--             for every performer (safe year handling).
WITH clean_credits AS (
    SELECT
        mc."PID",
        TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) AS yr
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
    JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m ON m."MID" = mc."MID"
    WHERE  TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) IS NOT NULL
),
gaps AS (
    SELECT
        "PID",
        yr - LAG(yr) OVER (PARTITION BY "PID" ORDER BY yr) AS gap_years
    FROM clean_credits
)
SELECT
       "PID",
       COALESCE(MAX(gap_years), 0) AS "max_gap"
FROM   gaps
GROUP  BY "PID"
LIMIT 20;
```

```sql
--Description: 9) List actors/actresses whose maximum gap is 3 years or fewer
--             (i.e., never a 4-year break), with safe year conversion.
WITH clean_credits AS (
    SELECT
        mc."PID",
        TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) AS yr
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
    JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m ON m."MID" = mc."MID"
    WHERE  TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) IS NOT NULL
),
gaps AS (
    SELECT
        "PID",
        yr - LAG(yr) OVER (PARTITION BY "PID" ORDER BY yr) AS gap_years
    FROM clean_credits
),
max_gap AS (
    SELECT
        "PID",
        COALESCE(MAX(gap_years), 0) AS max_gap
    FROM   gaps
