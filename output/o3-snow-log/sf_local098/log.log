Query:
--Description: Final count of actors/actresses whose longest break between consecutive
--             movie credits is three years or less.  Uses safe year extraction and
--             avoids alias-quoting issues seen earlier.
WITH clean_credits AS (                       -- 1) Extract valid 4-digit year per credit
    SELECT
        mc."PID",
        TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) AS yr
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
    JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m  ON m."MID" = mc."MID"
    WHERE  TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) IS NOT NULL
),
gaps AS (                                     -- 2) Year-to-year gaps for each performer
    SELECT
        "PID",
        yr - LAG(yr) OVER (PARTITION BY "PID" ORDER BY yr) AS gap_years
    FROM clean_credits
),
max_gap AS (                                  -- 3) Largest gap per performer (≤ 3 kept)
    SELECT
        "PID",
        COALESCE(MAX(gap_years), 0) AS max_gap
    FROM gaps
    GROUP BY "PID"
    HAVING COALESCE(MAX(gap_years), 0) <= 3
)
SELECT COUNT(*) AS actors_without_4yr_gap     -- 4) Final answer
FROM   max_gap
