```sql
--Description / Thinking Process:
-- Goal: count how many actors (PID) never have a gap ≥ 4 consecutive years
--       without a movie credit, from their first to last appearance.
-- Steps
-- 1. actor_years:  extract a clean 4-digit year for every (actor, movie) credit
--                  using REGEXP_SUBSTR and TRY_TO_NUMBER to avoid errors like ‘I 2009’.
-- 2. gaps:  for each actor, order the years and compute the difference to the
--           previous credit with LAG.  Any difference ≥ 4 indicates a ≥ 4-year gap.
-- 3. actors_with_gap:  collect every actor who has at least one such gap.
-- 4. Final SELECT:  count all distinct actors who are NOT in actors_with_gap,
--                   i.e., whose career never contains a 4-year gap.
WITH actor_years AS (
    SELECT
        mc."PID",
        TRY_TO_NUMBER(REGEXP_SUBSTR(mv."year", '\\d{4}')) AS "year_num"
    FROM DB_IMDB.DB_IMDB."M_CAST" mc
    JOIN DB_IMDB.DB_IMDB."MOVIE"  mv
      ON mc."MID" = mv."MID"
    WHERE TRY_TO_NUMBER(REGEXP_SUBSTR(mv."year", '\\d{4}')) IS NOT NULL
),
gaps AS (
    SELECT
        ay."PID",
        ay."year_num",
        LAG(ay."year_num")
          OVER (PARTITION BY ay."PID" ORDER BY ay."year_num") AS "prev_year"
    FROM actor_years ay
),
actors_with_gap AS (
    SELECT DISTINCT
        g."PID"
    FROM gaps g
    WHERE g."prev_year" IS NOT NULL
      AND (g."year_num" - g."prev_year") >= 4
)
SELECT
    COUNT(DISTINCT ay."PID") AS "actors_without_4yr_gap"
FROM actor_years ay
WHERE ay."PID" NOT IN (SELECT "PID" FROM actors_with_gap);
```
