Query:
--Description: Count how many actors NEVER have a 4-year (or longer) inactive span in their career (trimmed PID + clean year handling).
WITH actor_years AS (
    SELECT
        TRIM(mc."PID")                                   AS "PID",
        TRY_TO_NUMBER(REGEXP_SUBSTR(mv."year", '\\d{4}')) AS "year_num"
    FROM DB_IMDB.DB_IMDB."M_CAST" mc
    JOIN DB_IMDB.DB_IMDB."MOVIE"  mv
      ON mc."MID" = mv."MID"
    WHERE TRY_TO_NUMBER(REGEXP_SUBSTR(mv."year", '\\d{4}')) IS NOT NULL
),
gaps AS (
    SELECT
        ay."PID",
        ay."year_num",
        LAG(ay."year_num") OVER (PARTITION BY ay."PID" ORDER BY ay."year_num") AS "prev_year"
    FROM actor_years ay
),
actors_with_gap AS (
    SELECT DISTINCT "PID"
    FROM gaps
    WHERE "prev_year" IS NOT NULL
      AND ("year_num" - "prev_year") >= 4
)
SELECT
    COUNT(DISTINCT ay."PID") AS "actors_without_4yr_gap"
FROM actor_years ay
WHERE ay."PID" NOT IN (SELECT "PID" FROM actors_with_gap)
