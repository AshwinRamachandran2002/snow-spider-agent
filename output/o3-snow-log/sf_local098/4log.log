```sql
--Description: For every actor, compute the gap (in years) between each movie appearance and the previous one.
SELECT
    sub."PID",
    sub."movie_year",
    sub."prev_year",
    sub."movie_year" - sub."prev_year" AS "gap_years"
FROM (
    SELECT
        mc."PID",
        TO_NUMBER(mv."year") AS "movie_year",
        LAG(TO_NUMBER(mv."year")) 
          OVER (PARTITION BY mc."PID" ORDER BY TO_NUMBER(mv."year")) AS "prev_year"
    FROM DB_IMDB.DB_IMDB.M_CAST  mc
    JOIN DB_IMDB.DB_IMDB.MOVIE mv
      ON mc."MID" = mv."MID"
) sub
ORDER BY sub."PID", sub."movie_year"
LIMIT 20;
```

```sql
--Description: Identify actors that have at least one gap of 4 years or more between consecutive movie appearances.
SELECT DISTINCT
    g."PID"
FROM (
    SELECT
        mc."PID",
        TO_NUMBER(mv."year") AS "movie_year",
        LAG(TO_NUMBER(mv."year")) OVER (PARTITION BY mc."PID" ORDER BY TO_NUMBER(mv."year")) AS "prev_year"
    FROM DB_IMDB.DB_IMDB.M_CAST mc
    JOIN DB_IMDB.DB_IMDB.MOVIE mv
      ON mc."MID" = mv."MID"
) g
WHERE g."prev_year" IS NOT NULL
  AND (g."movie_year" - g."prev_year") >= 4
LIMIT 20;
```

