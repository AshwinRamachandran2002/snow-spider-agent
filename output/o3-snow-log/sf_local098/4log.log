Query:
--Description: For every actor, compute the gap (in years) between each movie appearance and the previous one (trimmed PID + clean year handling).
SELECT
    sub."PID",
    sub."movie_year",
    sub."prev_year",
    sub."movie_year" - sub."prev_year" AS "gap_years"
FROM (
    SELECT
        TRIM(mc."PID")                                   AS "PID",
        TRY_TO_NUMBER(REGEXP_SUBSTR(mv."year", '\\d{4}')) AS "movie_year",
        LAG(TRY_TO_NUMBER(REGEXP_SUBSTR(mv."year", '\\d{4}')))
            OVER (PARTITION BY TRIM(mc."PID")
                  ORDER BY TRY_TO_NUMBER(REGEXP_SUBSTR(mv."year", '\\d{4}'))) AS "prev_year"
    FROM DB_IMDB.DB_IMDB."M_CAST" mc
    JOIN DB_IMDB.DB_IMDB."MOVIE"  mv
      ON mc."MID" = mv."MID"
    WHERE TRY_TO_NUMBER(REGEXP_SUBSTR(mv."year", '\\d{4}')) IS NOT NULL
) sub
ORDER BY sub."PID", sub."movie_year"
LIMIT 20
