Query:
--Description: 7) Identify every actor who experiences at least one gap of four or more consecutive
--              years with no movie credits.  Clean the year field via REGEXP_SUBSTR + TRY_TO_NUMBER
--              and trim PID to remove leading spaces before grouping.
WITH actor_years AS (
    SELECT DISTINCT
           TRIM(mc."PID")                                   AS "PID",
           TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) AS "yy"
    FROM "DB_IMDB"."DB_IMDB"."M_CAST"  mc
    JOIN "DB_IMDB"."DB_IMDB"."MOVIE"   m  ON mc."MID" = m."MID"
    WHERE TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) IS NOT NULL
),
gaps AS (
    SELECT
           ay."PID",
           ay."yy",
           LEAD(ay."yy") OVER (PARTITION BY ay."PID" ORDER BY ay."yy") AS "next_yy"
    FROM   actor_years ay
)
SELECT "PID"
FROM   gaps
WHERE  "next_yy" IS NOT NULL
  AND  ("next_yy" - "yy") >= 4
GROUP  BY "PID"
LIMIT 20
