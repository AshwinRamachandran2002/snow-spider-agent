```sql
--Description: 6) Produce a chronologically ordered list of all distinct active years per actor.
SELECT p."PID",
       ARRAY_AGG( DISTINCT CAST(m."year" AS NUMBER) 
                   ORDER BY CAST(m."year" AS NUMBER) ) AS "years_active"
FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
JOIN   "DB_IMDB"."DB_IMDB"."PERSON"  p  ON mc."PID" = p."PID"
JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m  ON mc."MID" = m."MID"
GROUP  BY p."PID"
LIMIT 20;
```

```sql
--Description: 7) For every actor, calculate the gap between consecutive active years; flag any gap ≥ 4.
WITH actor_years AS (
    SELECT p."PID",
           CAST(m."year" AS NUMBER)                     AS "yy"
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST"   mc
    JOIN   "DB_IMDB"."DB_IMDB"."PERSON"   p  ON mc."PID" = p."PID"
    JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"    m  ON mc."MID" = m."MID"
    GROUP  BY p."PID", CAST(m."year" AS NUMBER)
),
gaps AS (
    SELECT  ay."PID",
            ay."yy",
            LEAD(ay."yy") OVER (PARTITION BY ay."PID" ORDER BY ay."yy") AS "next_yy"
    FROM    actor_years ay
)
SELECT  "PID"
FROM    gaps
WHERE   "next_yy" IS NOT NULL
  AND   ("next_yy" - "yy") >= 4            -- 4-year or more gap
GROUP   BY "PID"
LIMIT 20;
```

```sql
--Description: 8) Count how many unique actors DO HAVE at least one 4-year (or longer) gap.
WITH actor_years AS (
    SELECT p."PID",
           CAST(m."year" AS NUMBER) AS "yy"
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
    JOIN   "DB_IMDB"."DB_IMDB"."PERSON" p ON mc."PID" = p."PID"
    JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"  m ON mc."MID" = m."MID"
    GROUP  BY p."PID", CAST(m."year" AS NUMBER)
),
gaps AS (
    SELECT ay."PID",
           ay."yy",
           LEAD(ay."yy") OVER (PARTITION BY ay."PID" ORDER BY ay."yy") AS "next_yy"
    FROM   actor_years ay
)
SELECT COUNT(DISTINCT "PID") AS "actors_with_4yr_gap"
FROM   gaps
WHERE  "next_yy" IS NOT NULL
  AND  ("next_yy" - "yy") >= 4;
```

```sql
--Description: 9) Total number of actors that have at least one movie credit in the database.
SELECT COUNT(DISTINCT p."PID") AS "total_actors"
FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
JOIN   "DB_IMDB"."DB_IMDB"."PERSON"  p  ON mc."PID" = p."PID";
```

```sql
--Description: 10) Final answer: actors who NEVER have a 4-year gap = total actors minus actors_with_4yr_gap.
WITH actor_years AS (
    SELECT p."PID",
           CAST(m."year" AS NUMBER) AS "yy"
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
    JOIN   "DB_IMDB"."DB_IMDB"."PERSON" p ON mc."PID" = p."PID"
    JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"  m ON mc."MID" = m."MID"
    GROUP  BY p."PID", CAST(m."year" AS NUMBER)
),
gaps AS (
    SELECT ay."PID",
           ay."yy",
           LEAD(ay."yy") OVER (PARTITION BY ay."PID" ORDER BY ay."yy") AS "next_yy"
    FROM   actor_years ay
),
actors_with_gap AS (
    SELECT DISTINCT "PID"
    FROM   gaps
    WHERE  "next_yy" IS NOT NULL
      AND ("next_yy" - "yy") >= 4
),
all_actors AS (
    SELECT DISTINCT p."PID"
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
    JOIN   "DB_IMDB"."DB_IMDB"."PERSON" p ON mc."PID" = p."PID"
)
SELECT COUNT(*) AS "actors_without_4yr_gap"
FROM   all_actors
WHERE  "PID" NOT IN (SELECT "PID" FROM actors_with_gap);
```
