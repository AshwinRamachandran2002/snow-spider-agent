```sql
--Description: List each actor’s first and last active years while neutralising the “non-numeric year” problem.
--  • REGEXP_SUBSTR(m."year", '\\d{4}') extracts the first 4-digit sequence from strings such as
--    'I 2009', '2009/II', etc.
--  • TRY_TO_NUMBER converts that 4-digit text to a NUMBER; rows where it returns NULL are skipped.
--  • TRIM(mc."PID") removes leading spaces so it matches PERSON.PID.
--  • Finally, aggregate MIN / MAX years per actor and show 20 sample rows.
SELECT
       cy."PID",
       p."Name"                          AS "actor_name",
       MIN(cy."yr")                      AS "first_year",
       MAX(cy."yr")                      AS "last_year"
FROM (
     SELECT
            TRIM(mc."PID")                                   AS "PID",
            TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) AS "yr"
     FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
     JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m ON mc."MID" = m."MID"
     WHERE  TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) IS NOT NULL
) cy
JOIN "DB_IMDB"."DB_IMDB"."PERSON" p ON cy."PID" = p."PID"
GROUP BY cy."PID", p."Name"
LIMIT 20;
```
