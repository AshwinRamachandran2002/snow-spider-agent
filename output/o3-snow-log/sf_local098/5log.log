--Description: 10) Final calculation: number of actors who NEVER have a four-year gap anywhere in
--              their career (i.e., total actors minus those with a ≥4-year gap).
WITH actor_years AS (
    SELECT DISTINCT
           TRIM(mc."PID")                                   AS "PID",
           TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) AS "yy"
    FROM "DB_IMDB"."DB_IMDB"."M_CAST"  mc
    JOIN "DB_IMDB"."DB_IMDB"."MOVIE"   m ON mc."MID" = m."MID"
    WHERE TRY_TO_NUMBER(REGEXP_SUBSTR(m."year", '\\d{4}')) IS NOT NULL
),
gaps AS (
    SELECT
           ay."PID",
           ay."yy",
           LEAD(ay."yy") OVER (PARTITION BY ay."PID" ORDER BY ay."yy") AS "next_yy"
    FROM   actor_years ay
),
actors_with_gap AS (
    SELECT DISTINCT "PID"
    FROM   gaps
    WHERE  "next_yy" IS NOT NULL
      AND  ("next_yy" - "yy") >= 4
),
all_actors AS (
    SELECT DISTINCT TRIM(mc."PID") AS "PID"
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
)
SELECT COUNT(*) AS "actors_without_4yr_gap"
FROM   all_actors
WHERE  "PID" NOT IN (SELECT "PID" FROM actors_with_gap)
