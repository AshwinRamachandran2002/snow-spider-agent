```sql
--Description: 7) Produce a year-by-year presence flag (1/0) for one sample actor
SELECT
    yrs."yr",
    CASE WHEN EXISTS (
        SELECT 1
        FROM DB_IMDB.DB_IMDB.M_CAST c
        JOIN DB_IMDB.DB_IMDB.MOVIE  m ON m."MID" = c."MID"
        WHERE c."PID" = 'nm0000949'        -- sample PID
          AND m."year" = yrs."yr"
    ) THEN 1 ELSE 0 END AS "has_film"
FROM (
     SELECT DISTINCT m."year"::INT AS "yr"
     FROM DB_IMDB.DB_IMDB.MOVIE m
) yrs
ORDER BY yrs."yr"
LIMIT 20;
```

```sql
--Description: 8) For each actor, find the longest gap (in years) between consecutive credited movies
SELECT
    p."PID",
    MAX(next_year - curr_year - 1) AS "max_gap"
FROM (
    SELECT
        c."PID",
        m."year"::INT                           AS curr_year,
        LEAD(m."year"::INT) OVER (PARTITION BY c."PID" ORDER BY m."year"::INT) AS next_year
    FROM DB_IMDB.DB_IMDB.M_CAST  c
    JOIN DB_IMDB.DB_IMDB.MOVIE   m ON m."MID" = c."MID"
) t
JOIN DB_IMDB.DB_IMDB.PERSON p ON p."PID" = t."PID"
GROUP BY p."PID"
LIMIT 20;
```

```sql
--Description: 9) Count how many performers never had a gap longer than three years
SELECT 
    COUNT(*) AS "actors_with_no_4yr_gap"
FROM (
    SELECT
        p."PID",
        MAX(next_year - curr_year - 1) AS max_gap
    FROM (
        SELECT
            c."PID",
            m."year"::INT                           AS curr_year,
            LEAD(m."year"::INT) OVER (PARTITION BY c."PID" ORDER BY m."year"::INT) AS next_year
        FROM DB_IMDB.DB_IMDB.M_CAST  c
        JOIN DB_IMDB.DB_IMDB.MOVIE   m ON m."MID" = c."MID"
    ) t
    JOIN DB_IMDB.DB_IMDB.PERSON p ON p."PID" = t."PID"
    GROUP BY p."PID"
    HAVING MAX(next_year - curr_year - 1) <= 3
) q;
```

```sql
--Description: 10) Display the first 20 actor IDs who satisfy the “no gap longer than 3 years” rule
SELECT 
    p."PID"
FROM (
    SELECT
        c."PID",
        MAX(next_year - curr_year - 1) AS max_gap
    FROM (
        SELECT
            c."PID",
            m."year"::INT                           AS curr_year,
            LEAD(m."year"::INT) OVER (PARTITION BY c."PID" ORDER BY m."year"::INT) AS next_year
        FROM DB_IMDB.DB_IMDB.M_CAST  c
        JOIN DB_IMDB.DB_IMDB.MOVIE   m ON m."MID" = c."MID"
    ) t
    GROUP BY c."PID"
    HAVING MAX(next_year - curr_year - 1) <= 3
) g
JOIN DB_IMDB.DB_IMDB.PERSON p ON p."PID" = g."PID"
LIMIT 20;
```
