```sql
--Description: Count how many actors never experience a gap of four or more consecutive years without a movie credit.
--Step-1 (film_years):  collect each actor’s DISTINCT numeric movie-release years (TRIM removes leading blanks in PID, TRY_TO_NUMBER filters bad year strings).
--Step-2 (gap_calc):   for every actor, use LEAD to pair each year with the next credited year and compute their gap.
--Step-3 (gaps):       aggregate to the largest gap per actor; COALESCE sets single-credit actors’ max_gap to 0.
--Final step:          count actors whose max_gap ≤ 3 (i.e., no four-year span without a film).
WITH film_years AS (
    SELECT DISTINCT
           TRIM(c."PID")            AS "PID",
           TRY_TO_NUMBER(m."year")  AS "yr"
    FROM DB_IMDB.DB_IMDB.M_CAST  c
    JOIN DB_IMDB.DB_IMDB.MOVIE   m ON m."MID" = c."MID"
    WHERE TRY_TO_NUMBER(m."year") IS NOT NULL
),
gap_calc AS (
    SELECT
           "PID",
           "yr",
           LEAD("yr") OVER (PARTITION BY "PID" ORDER BY "yr") AS next_yr
    FROM film_years
),
gaps AS (
    SELECT
           "PID",
           COALESCE(MAX(next_yr - "yr" - 1), 0) AS max_gap
    FROM gap_calc
    GROUP BY "PID"
)
