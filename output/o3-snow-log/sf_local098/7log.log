--Description: List the first 20 actor IDs whose longest break between consecutive credited-movie years is ≤ 3 (i.e., no four-year span without a film); uses TRY_TO_NUMBER to clean years and TRIM to clean PIDs.
WITH film_years AS (                       -- actor-year pairs (numeric years only)
    SELECT DISTINCT
           TRIM(c."PID")            AS "PID",
           TRY_TO_NUMBER(m."year")  AS "yr"
    FROM DB_IMDB.DB_IMDB.M_CAST  c
    JOIN DB_IMDB.DB_IMDB.MOVIE   m ON m."MID" = c."MID"
    WHERE TRY_TO_NUMBER(m."year") IS NOT NULL
),
gap_calc AS (                             -- each year with the next credited year
    SELECT
           "PID",
           "yr",
           LEAD("yr") OVER (PARTITION BY "PID" ORDER BY "yr") AS next_yr
    FROM film_years
),
gaps AS (                                 -- actor’s maximum gap
    SELECT
           "PID",
           COALESCE(MAX(next_yr - "yr" - 1), 0) AS max_gap
    FROM gap_calc
    GROUP BY "PID"
    HAVING COALESCE(MAX(next_yr - "yr" - 1), 0) <= 3            -- keep only actors with max_gap ≤ 3
)
SELECT
       "PID"
FROM gaps
LIMIT 20;
