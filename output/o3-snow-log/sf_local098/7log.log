--Description: 8) For each actor, find the longest gap (in years) between consecutive credited movies; 
--uses TRY_TO_NUMBER to discard non-numeric year strings and TRIM() to remove the leading blank that exists in M_CAST."PID".
SELECT
       t."PID",
       MAX(t.next_year - t.curr_year - 1) AS "max_gap"
FROM (
        SELECT
               TRIM(c."PID")                              AS "PID",
               TRY_TO_NUMBER(m."year")                   AS curr_year,
               LEAD(TRY_TO_NUMBER(m."year")) OVER (
                     PARTITION BY TRIM(c."PID")
                     ORDER BY TRY_TO_NUMBER(m."year")
               )                                         AS next_year
        FROM DB_IMDB.DB_IMDB.M_CAST  c
        JOIN DB_IMDB.DB_IMDB.MOVIE   m ON m."MID" = c."MID"
        WHERE TRY_TO_NUMBER(m."year") IS NOT NULL
) t
GROUP BY t."PID"
LIMIT 20
