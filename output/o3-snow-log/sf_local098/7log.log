--Description:  Build a clean numeric list of all distinct release years (TRY_TO_NUMBER filters out non-numeric strings).  
--For every such year, check whether actor ‘nm0000949’ (note the trim because stored PIDs have a leading blank) appears 
--in at least one movie released that year.  Return a 1/0 flag for “has_film”.  LIMIT 20 gives a quick preview.
WITH yrs AS (
    SELECT DISTINCT
           TRY_TO_NUMBER("year") AS "yr"
    FROM DB_IMDB.DB_IMDB.MOVIE
    WHERE TRY_TO_NUMBER("year") IS NOT NULL
)
SELECT
       y."yr",
       CASE
           WHEN EXISTS (
               SELECT 1
               FROM DB_IMDB.DB_IMDB.M_CAST c
               JOIN DB_IMDB.DB_IMDB.MOVIE  m ON m."MID" = c."MID"
               WHERE TRIM(c."PID") = 'nm0000949'
                 AND TRY_TO_NUMBER(m."year") = y."yr"
           ) THEN 1 ELSE 0
       END AS "has_film"
FROM yrs y
ORDER BY y."yr"
LIMIT 20;
