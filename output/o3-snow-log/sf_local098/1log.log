```sql
--Description / Thinking process:
-- Objective:  Count how many actors in the database never experience a span of four
--             consecutive calendar years without at least one movie credit
--             (i.e., every gap between consecutive active years is ≤ 3).
--
-- Steps implemented below:
--   1) actor_years  – For every actor (PID) gather DISTINCT movie years, converted
--      from text to NUMBER.
--   2) actor_gaps   – Within each actor’s ordered timeline compute the difference
--      between the current year and the previous active year using LAG; flag any
--      gap ≥ 4.
--   3) final_count  – For each actor aggregate the flag; keep only those whose
--      maximum flag is 0 (meaning no 4-year gap), and count them.
--
-- The result is a single scalar giving the required number of actors.
WITH actor_years AS (
    SELECT DISTINCT
        mc."PID",
        TRY_TO_NUMBER(m."year") AS "movie_year"
    FROM DB_IMDB.DB_IMDB.M_CAST  mc
    JOIN DB_IMDB.DB_IMDB.MOVIE   m  ON mc."MID" = m."MID"
    WHERE m."year" IS NOT NULL
),
actor_gaps AS (
    SELECT
        ay."PID",
        ay."movie_year",
        ay."movie_year"
          - LAG(ay."movie_year") OVER (PARTITION BY ay."PID" ORDER BY ay."movie_year") 
          AS "gap_from_prev"
    FROM actor_years ay
),
final_count AS (
    SELECT
        "PID"
    FROM actor_gaps
    GROUP BY "PID"
    HAVING MAX(CASE WHEN "gap_from_prev" >= 4 THEN 1 ELSE 0 END) = 0
)
SELECT COUNT(*) AS "actors_no_4year_gap"
FROM final_count;
```
