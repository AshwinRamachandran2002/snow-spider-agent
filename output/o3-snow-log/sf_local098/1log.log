```sql
--Description: 6) Flag every actor/year pair where the gap since previous appearance is ≥ 4 years
SELECT
    yearly."PID",
    MAX(CASE WHEN yearly."gap_from_prev" >= 4 THEN 1 ELSE 0 END) AS "has_4yr_gap"
FROM (
    SELECT
        mc."PID",
        yr."movie_year",
        yr."movie_year" 
         - LAG(yr."movie_year") OVER (PARTITION BY mc."PID" ORDER BY yr."movie_year") AS "gap_from_prev"
    FROM (
        SELECT DISTINCT 
            mc_i."PID",
            TRY_TO_NUMBER(m_i."year") AS "movie_year"
        FROM DB_IMDB.DB_IMDB.M_CAST mc_i
        JOIN DB_IMDB.DB_IMDB.MOVIE  m_i ON mc_i."MID" = m_i."MID"
    ) yr
    JOIN DB_IMDB.DB_IMDB.M_CAST mc ON mc."PID" = yr."PID"
) yearly
GROUP BY yearly."PID"
LIMIT 20;
```

