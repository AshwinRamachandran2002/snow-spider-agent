    SELECT
        ay."PID",
        ay."movie_year",
        ay."movie_year"
          - LAG(ay."movie_year") OVER (PARTITION BY ay."PID" ORDER BY ay."movie_year") AS "gap_from_prev"
    FROM actor_years ay
)
SELECT
    ag."PID",
    MAX(CASE WHEN ag."gap_from_prev" >= 4 THEN 1 ELSE 0 END) AS "has_4yr_gap"
FROM actor_gaps ag
GROUP BY ag."PID"
LIMIT 20
