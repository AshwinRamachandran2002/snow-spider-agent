```sql
--Description: 5) Show, for one sample actor, the ordered list of active years and the gap from the previous appearance
SELECT
    pid_sub."PID",
    pid_sub."movie_year",
    pid_sub."movie_year" - LAG(pid_sub."movie_year") 
        OVER (PARTITION BY pid_sub."PID" ORDER BY pid_sub."movie_year") AS "gap_from_prev"
FROM (
