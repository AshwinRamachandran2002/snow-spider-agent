--Description: 7) List actors who NEVER experience a 4-year (or longer) gap between consecutive active years
WITH actor_years AS (
    SELECT DISTINCT
        mc."PID",
        TRY_TO_NUMBER(m."year") AS "movie_year"
    FROM DB_IMDB.DB_IMDB.M_CAST  mc
    JOIN DB_IMDB.DB_IMDB.MOVIE   m ON mc."MID" = m."MID"
    WHERE m."year" IS NOT NULL
),
actor_gaps AS (
    SELECT
        ay."PID",
        ay."movie_year",
        ay."movie_year"
          - LAG(ay."movie_year") OVER (PARTITION BY ay."PID" ORDER BY ay."movie_year") AS "gap_from_prev"
    FROM actor_years ay
),
continuous_actors AS (           -- keep only actors with NO gap ≥ 4
    SELECT "PID"
    FROM actor_gaps
    GROUP BY "PID"
    HAVING MAX(CASE WHEN "gap_from_prev" >= 4 THEN 1 ELSE 0 END) = 0
)
SELECT
    ca."PID",
    p."Name"
FROM continuous_actors ca
LEFT JOIN DB_IMDB.DB_IMDB.PERSON p ON ca."PID" = p."PID"
LIMIT 20
