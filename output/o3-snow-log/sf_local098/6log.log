```sql
--Description: Find actors who experience at least one gap of four or more consecutive years between film appearances; trim PIDs everywhere so leading spaces do not create duplicates
WITH years_per_actor AS (
     SELECT TRIM(c."PID")               AS "PID",
            TRY_TO_NUMBER(m."year")     AS "yr"
     FROM   "DB_IMDB"."DB_IMDB"."M_CAST" c
     JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"  m
            ON c."MID" = m."MID"
     GROUP  BY TRIM(c."PID"), m."year"
), gaps AS (
     SELECT x."PID",
            MIN(y."yr") - x."yr" AS "gap_years"
     FROM   years_per_actor x
     LEFT  JOIN years_per_actor y
            ON x."PID" = y."PID"
           AND y."yr" > x."yr"
     GROUP BY x."PID", x."yr"
)
SELECT DISTINCT "PID"
FROM   gaps
WHERE  "gap_years" >= 4
LIMIT 20;
