Query:
--Description: Compute gap lengths for actor “nm0000949”, always trimming PID and using fuzzy filter to avoid missing the intended rows
WITH actor_years AS (
     SELECT TRIM(c."PID")               AS "PID",
            TRY_TO_NUMBER(m."year")     AS "yr"
     FROM   "DB_IMDB"."DB_IMDB"."M_CAST" c
     JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"  m
            ON c."MID" = m."MID"
     WHERE  c."PID" ILIKE '%nm0000949%'      -- handle leading space
     GROUP  BY TRIM(c."PID"), m."year"
)
SELECT x."PID",
       x."yr"                        AS "current_year",
       MIN(y."yr")                   AS "next_year",
       MIN(y."yr") - x."yr"          AS "gap_years"
FROM   actor_years x
LEFT JOIN actor_years y
       ON x."PID" = y."PID"
      AND y."yr"  > x."yr"
GROUP BY x."PID", x."yr"
ORDER  BY x."yr"
LIMIT 20
