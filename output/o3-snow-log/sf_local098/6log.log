```sql
--Description: Convert the year column to a number so that gaps can be arithmetically compared
SELECT c."PID",
       TRY_TO_NUMBER(m."year") AS "yr"
FROM   "DB_IMDB"."DB_IMDB"."M_CAST" c
JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"  m
       ON c."MID" = m."MID"
WHERE  c."PID" = 'nm0000949'
ORDER  BY "yr"
LIMIT 20;
```

```sql
--Description: Identify the length of the gap to the next appearance for every actor (sample calculation)
SELECT x."PID",
       x."yr"               AS "current_year",
       MIN(y."yr")          AS "next_year",
       MIN(y."yr") - x."yr" AS "gap_years"
FROM  (SELECT c."PID", TRY_TO_NUMBER(m."year") AS "yr"
       FROM   "DB_IMDB"."DB_IMDB"."M_CAST" c
       JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"  m
              ON c."MID" = m."MID"
       GROUP  BY c."PID", m."year") x
LEFT JOIN
      (SELECT c."PID", TRY_TO_NUMBER(m."year") AS "yr"
       FROM   "DB_IMDB"."DB_IMDB"."M_CAST" c
       JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"  m
              ON c."MID" = m."MID"
       GROUP  BY c."PID", m."year") y
  ON x."PID" = y."PID"
 AND y."yr"  > x."yr"
WHERE x."PID" = 'nm0000949'
GROUP BY x."PID", x."yr"
ORDER BY x."yr"
LIMIT 20;
```

```sql
--Description: Determine actors that *do* experience a gap of 4 years or more somewhere in their career
WITH years_per_actor AS (
      SELECT c."PID",
             TRY_TO_NUMBER(m."year") AS "yr"
      FROM   "DB_IMDB"."DB_IMDB"."M_CAST" c
      JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"  m
             ON c."MID" = m."MID"
      GROUP  BY c."PID", m."year"
), gaps AS (
      SELECT x."PID",
             MIN(y."yr") - x."yr" AS "gap_years"
      FROM   years_per_actor x
      LEFT  JOIN years_per_actor y
             ON x."PID" = y."PID"
            AND y."yr" > x."yr"
      GROUP BY x."PID", x."yr"
)
SELECT DISTINCT "PID"
FROM   gaps
WHERE  "gap_years" >= 4
LIMIT 20;
```

```sql
--Description: Count how many actors never have a gap ≥4 years between appearances (final computation step)
WITH years_per_actor AS (
      SELECT c."PID",
             TRY_TO_NUMBER(m."year") AS "yr"
      FROM   "DB_IMDB"."DB_IMDB"."M_CAST" c
      JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"  m
             ON c."MID" = m."MID"
      GROUP  BY c."PID", m."year"
), gaps AS (
      SELECT x."PID",
             MIN(y."yr") - x."yr" AS "gap_years"
      FROM   years_per_actor x
      LEFT  JOIN years_per_actor y
             ON x."PID" = y."PID"
            AND y."yr" > x."yr"
      GROUP BY x."PID", x."yr"
), actors_with_big_gap AS (
      SELECT DISTINCT "PID"
      FROM   gaps
      WHERE  "gap_years" >= 4
)
SELECT COUNT(DISTINCT c."PID") AS "actors_without_4year_gap"
FROM   "DB_IMDB"."DB_IMDB"."M_CAST" c
WHERE  c."PID" NOT IN (SELECT "PID" FROM actors_with_big_gap);
```

