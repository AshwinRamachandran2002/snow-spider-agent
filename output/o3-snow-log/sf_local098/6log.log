--Description: PIDs in "M_CAST" often contain leading spaces (e.g. ' nm0000949'), which caused the earlier exact-match filter to return no rows.  
--Solution: (1) use TRIM() to remove any surrounding whitespace when selecting and grouping, and  
--(2) filter with ILIKE '%nm0000949%' so the predicate succeeds whether or not the PID is padded.  
--The result shows how many movies the actor with IMDb ID nm0000949 appeared in for each release year, enabling inspection of year-to-year gaps.
SELECT TRIM(c."PID")            AS "PID",
       m."year"                 AS "year",
       COUNT(*)                 AS "num_films_in_year"
FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  c
JOIN   "DB_IMDB"."DB_IMDB"."MOVIE"   m
       ON c."MID" = m."MID"
WHERE  c."PID" ILIKE '%nm0000949%'   -- handle possible leading space
GROUP  BY TRIM(c."PID"), m."year"
ORDER  BY m."year"
LIMIT 20;
```
