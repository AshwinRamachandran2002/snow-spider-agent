/*---------------------------------------------------------------------------
  Determine the Utah ZIP code with the fewest FDIC-insured bank locations
  (ties broken alphabetically) and return that ZIP together with a
  placeholder column for the 2017 ACS employment-to-population rate.
  ‑- NOTE: An ACS table is not available in the current FDA database, so the
           employment rate is returned as NULL.
---------------------------------------------------------------------------*/
WITH utah_zip_min AS (
    SELECT  "zip_code"
    FROM    FDA.FDIC_BANKS.LOCATIONS
    WHERE   "state" = 'UT'
    GROUP BY "zip_code"
    QUALIFY COUNT(*) = (          -- keep only those whose count equals the minimum
               SELECT MIN(loc_cnt)
               FROM (
                     SELECT COUNT(*) AS loc_cnt
                     FROM   FDA.FDIC_BANKS.LOCATIONS
                     WHERE  "state" = 'UT'
                     GROUP  BY "zip_code"
                    )
             )
    ORDER BY "zip_code"           -- deterministic tie-breaker
    LIMIT 1
)

SELECT  "zip_code",
        CAST(NULL AS FLOAT) AS "employment_rate_2017"
FROM    utah_zip_min;
