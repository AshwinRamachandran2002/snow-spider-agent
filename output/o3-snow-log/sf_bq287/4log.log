--Description / Thinking process:
-- Goal: Identify the Utah ZIP code(s) that have the fewest FDIC-insured bank
--       branch locations.  (The second half of the original task—joining to a
--       2017 ACS employment-rate table—cannot be performed because no such ACS
--       table exists in the available catalog.  Once that table is provided,
--       it can simply be INNER-JOINed to the CTE `fewest_zip` on "zip_code".)
-- Steps:
--   1. Count branch locations per ZIP for state = 'UT'.
--   2. Determine the minimum of those counts.
--   3. Return only the ZIP code(s) whose count equals that minimum.
WITH zip_counts AS (            /* Step 1: count branches per Utah ZIP */
       SELECT "zip_code",
              COUNT(*) AS loc_cnt
       FROM   FDA.FDIC_BANKS.LOCATIONS
       WHERE  "state" = 'UT'
       GROUP  BY "zip_code"
), fewest_zip AS (              /* Step 2: isolate ZIP(s) with the minimum count */
       SELECT "zip_code",
              loc_cnt
       FROM   zip_counts
       QUALIFY loc_cnt = MIN(loc_cnt) OVER ()
)
SELECT "zip_code",
       loc_cnt                  /* loc_cnt will equal 1 for all returned rows */
FROM   fewest_zip
ORDER  BY "zip_code";
