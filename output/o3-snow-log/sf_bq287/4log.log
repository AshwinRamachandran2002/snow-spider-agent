```sql
--Description / Thinking process:
-- 1) We must find which Utah ZIP codes (state = 'UT') have the fewest FDIC-insured
--    bank locations.  That requires:
--      a. Counting the number of rows (branches) per ZIP.
--      b. Determining the minimum of those counts.
--      c. Returning only the ZIP code(s) whose count equals that minimum.
-- 2) We use a CTE (zip_counts) to perform (a), then another CTE (fewest) for (b).
-- 3) Finally we join the two CTEs to fulfil (c) and list the result.
WITH zip_counts AS (                -- (a) count branches per ZIP in Utah
       SELECT "zip_code",
              COUNT(*) AS loc_cnt
       FROM   FDA.FDIC_BANKS.LOCATIONS
       WHERE  "state" = 'UT'
       GROUP  BY "zip_code"
), fewest AS (                      -- (b) minimum count across ZIPs
       SELECT MIN(loc_cnt) AS min_cnt
       FROM   zip_counts
)
SELECT z."zip_code",                -- (c) ZIP code(s) that have that minimum
       z.loc_cnt
FROM   zip_counts z
JOIN   fewest f
  ON   z.loc_cnt = f.min_cnt
ORDER  BY z."zip_code";
```
