```sql
--Description: Identify the minimum number of FDIC locations that any Utah ZIP code has.  
SELECT MIN(loc_cnt) AS "fewest_locations"
FROM  (
        SELECT "zip_code",
               COUNT(*) AS loc_cnt
        FROM   FDA.FDIC_BANKS.LOCATIONS
        WHERE  "state" = 'UT'
        GROUP  BY "zip_code"
      ) AS z;
```

```sql
--Description: List Utah ZIP code(s) that have the fewest FDIC-insured bank locations.  
WITH zip_counts AS (
       SELECT "zip_code",
              COUNT(*) AS loc_cnt
       FROM   FDA.FDIC_BANKS.LOCATIONS
       WHERE  "state" = 'UT'
       GROUP  BY "zip_code"
), fewest AS (
       SELECT MIN(loc_cnt) AS min_cnt
       FROM   zip_counts
)
SELECT z."zip_code",
       z."loc_cnt"
FROM   zip_counts z
JOIN   fewest f
  ON   z."loc_cnt" = f.min_cnt
ORDER  BY z."zip_code";
```

```sql
--Description: (If a 2017 ACS employment-rate table were available) retrieve the 2017 ACS
--             employment rate for people 16+ in the Utah ZIP code(s) with the fewest
--             FDIC locations.  Replace `ACS_2017_ZIP_EMPLOYMENT` and column names with
--             the actual ACS table/field names once identified.
WITH fewest_zip AS (
       SELECT z."zip_code"
       FROM (
              SELECT "zip_code",
                     COUNT(*) AS loc_cnt
              FROM   FDA.FDIC_BANKS.LOCATIONS
              WHERE  "state" = 'UT'
              GROUP  BY "zip_code"
            ) z
       QUALIFY loc_cnt = MIN(loc_cnt) OVER ()
)
SELECT a."zip_code",
       a."employment_rate_16_plus"
FROM   ACS.PUBLIC.ACS_2017_ZIP_EMPLOYMENT a
JOIN   fewest_zip f
  ON   a."zip_code" = f."zip_code"
LIMIT 20;
```

