  Among all Utah ZIP codes, find the ZIP with the fewest FDIC-insured bank
  locations and return its 2017 ACS employment-to-population rate
  (population aged 16 +).
---------------------------------------------------------------------------*/
WITH utah_zip_min AS (            -- ZIP code(s) with the fewest FDIC locations in Utah
    SELECT  "zip_code"
    FROM    FDA.FDIC_BANKS.LOCATIONS
    WHERE   "state" = 'UT'
    GROUP BY "zip_code"
    QUALIFY COUNT(*) = (          -- keep only those with the overall minimum count
               SELECT MIN(loc_cnt)
               FROM (
                     SELECT COUNT(*) AS loc_cnt
                     FROM   FDA.FDIC_BANKS.LOCATIONS
                     WHERE  "state" = 'UT'
                     GROUP  BY "zip_code"
                    ) AS sub )
    LIMIT 1                       -- if multiple ZIPs tie, pick one deterministically
),

acs_employment AS (               -- 2017 employment rate for every ZIP
    SELECT  "zip_code",
            ROUND(
                  100 * SUM(CASE WHEN "variable" = 'B23025_004E' THEN "estimate" END)
                  / NULLIF(
                      SUM(CASE WHEN "variable" = 'B23025_001E' THEN "estimate" END)
                     ,0)
                  , 4) AS "employment_rate_2017"
