```sql
/*---------------------------------------------------------------------------
  Among all Utah ZIP codes, find the ZIP with the fewest FDIC-insured bank
  locations and return its 2017 ACS employment-to-population rate
  (population aged 16 +).  The ACS employment rate is calculated as:
      employed_16_plus  /  total_population_16_plus  * 100
---------------------------------------------------------------------------*/
WITH utah_zip_min AS (          -- find the Utah ZIP code with the fewest FDIC locations
    SELECT  "zip_code"
    FROM    FDA.FDIC_BANKS.LOCATIONS
    WHERE   "state" = 'UT'
    GROUP BY "zip_code"
    HAVING  COUNT(*) = (
              SELECT MIN(loc_cnt)
              FROM (
                    SELECT COUNT(*) AS loc_cnt
                    FROM   FDA.FDIC_BANKS.LOCATIONS
                    WHERE  "state" = 'UT'
                    GROUP  BY "zip_code"
                   ) AS z )
    LIMIT 1                      -- in case several ZIP codes tie for the minimum
),

acs_employment AS (             -- compute 2017 employment rate for every ZIP
    SELECT  "zip_code",
            ROUND( 100 * 
                   SUM(CASE WHEN "variable" = 'B23025_004E' THEN "estimate" END)
                 / NULLIF( SUM(CASE WHEN "variable" = 'B23025_001E' THEN "estimate" END) ,0)
                 , 4)  AS "employment_rate_2017"
    FROM    FDA.CENSUS_ACS_5YR.ZIP_B23025      -- ACS 5-yr table B23025 (employment status)
    WHERE   "year" = 2017
      AND   "variable" IN ('B23025_001E',       -- pop 16 +
                           'B23025_004E')       -- employed 16 +
    GROUP BY "zip_code"
)

SELECT  e."zip_code",
        e."employment_rate_2017"
FROM    acs_employment e
JOIN    utah_zip_min  u  ON e."zip_code" = u."zip_code";
```
