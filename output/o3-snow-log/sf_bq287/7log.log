FROM "FDA"."FDIC_BANKS"."LOCATIONS"
WHERE "state" = 'UT'
LIMIT 20;
```

```sql
--Description: Count how many bank locations each Utah ZIP code has
SELECT "zip_code",
       COUNT(*) AS "branch_count"
FROM   "FDA"."FDIC_BANKS"."LOCATIONS"
WHERE  "state" = 'UT'
GROUP  BY "zip_code"
ORDER  BY "branch_count" ASC
LIMIT 20;
```

```sql
--Description: Find the minimum number of bank locations any Utah ZIP code possesses
SELECT MIN("branch_count") AS "min_branch_count"
FROM (
    SELECT "zip_code",
           COUNT(*) AS "branch_count"
    FROM   "FDA"."FDIC_BANKS"."LOCATIONS"
    WHERE  "state" = 'UT'
    GROUP  BY "zip_code"
) t;
```

```sql
--Description: List the Utah ZIP code(s) that have that minimum number of bank locations
WITH counts AS (
    SELECT "zip_code",
           COUNT(*) AS "branch_count"
    FROM   "FDA"."FDIC_BANKS"."LOCATIONS"
    WHERE  "state" = 'UT'
    GROUP  BY "zip_code"
), min_cte AS (
    SELECT MIN("branch_count") AS "min_branch_count"
    FROM   counts
)
SELECT c."zip_code"
FROM   counts c
JOIN   min_cte m
ON     c."branch_count" = m."min_branch_count"
LIMIT 20;
```

