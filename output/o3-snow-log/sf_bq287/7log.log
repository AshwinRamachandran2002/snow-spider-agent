```sql
/*  Step-by-step
    1.  Count how many FDIC-insured bank branches each Utah ZIP code has.
    2.  Isolate the ZIP code(s) that possess the minimum (fewest) branch count.
    3.  Pull the 2017 American Community Survey (ACS 5-year) employment-status
        table (B23025).  Within that table:
           • B23025_001E = total population age 16 +
           • B23025_004E = employed population age 16 +
        The employment-rate percentage =  B23025_004E / B23025_001E * 100
    4.  Return that employment rate for the ZIP code(s) found in step 2.         */
WITH utah_branch_counts AS (
    SELECT  "zip_code",
            COUNT(*) AS branch_count
    FROM    "FDA"."FDIC_BANKS"."LOCATIONS"
    WHERE   "state" = 'UT'
    GROUP BY "zip_code"
),
min_branch_zip AS (
    SELECT  "zip_code"
    FROM    utah_branch_counts
    QUALIFY branch_count = MIN(branch_count) OVER ()      -- fewest locations
)
SELECT  ROUND(
            (acs."B23025_004E" / NULLIF(acs."B23025_001E",0)) * 100,
            4
        )           AS "employment_rate_16_plus_pct_2017"
FROM    "FDA"."CENSUS_ACS_5YR"."B23025_ZCTA"   acs
JOIN    min_branch_zip  z
  ON    acs."zcta" = z."zip_code"
WHERE   acs."year" = 2017;
```
