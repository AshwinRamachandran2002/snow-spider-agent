)
SELECT
    a."zip_code",
    ROUND( (a."employed_16_plus" / NULLIF(a."pop_16_plus",0)) * 100 , 4 ) 
        AS "employment_rate_2017_pct"
FROM acs_zcta   a
JOIN min_ut_zips z
  ON a."zip_code" = z."zip_code"
ORDER BY a."zip_code";
