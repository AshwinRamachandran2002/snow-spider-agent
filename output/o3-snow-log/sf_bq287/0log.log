```sql
/* 1)  Count how many FDIC–insured branch locations exist in every Utah ZIP code
   2)  Find the ZIP code(s) whose branch–count equals the statewide minimum
   3)  For each of those ZIP code(s), pull the 2017 ACS employment-rate (population 16-plus)
       ‑ C23025_001E = total population aged 16+
       ‑ C23025_005E = number employed (civilian) aged 16+
       Employment-rate  =  (C23025_005E / C23025_001E) * 100
*/
WITH ut_branch_counts AS (   -- all UT ZIPs w/ FDIC branch counts
    SELECT 
        "zip_code",
        COUNT(*) AS "branch_count"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
    GROUP BY "zip_code"
), min_ut_zips AS (          -- ZIP(s) having the fewest branches statewide
    SELECT 
        "zip_code"
    FROM ut_branch_counts
    WHERE "branch_count" = (
        SELECT MIN("branch_count") FROM ut_branch_counts
    )
)
SELECT
    acs."zip_code",
    ROUND( (acs."C23025_005E" / NULLIF(acs."C23025_001E",0)) * 100 , 4 ) 
        AS "employment_rate_2017_pct"
FROM FDA.CENSUS_ACS_5YR.C23025_ZCTA_2017  acs   -- 2017 5-yr ACS employment table
JOIN min_ut_zips  z
  ON acs."zip_code" = z."zip_code"
ORDER BY acs."zip_code";
```
