--Description: 7)  Show every individual branch record that lies in a Utah ZIP code having the minimum branch count
WITH zip_min AS (
    SELECT 
      "zip_code"
    FROM (
        SELECT "zip_code",
               COUNT(*) AS "branch_count"
        FROM FDA.FDIC_BANKS.LOCATIONS
        WHERE "state" = 'UT'
        GROUP BY "zip_code"
    ) q
    WHERE "branch_count" = (
        SELECT MIN("branch_count") FROM (
            SELECT COUNT(*) AS "branch_count"
            FROM FDA.FDIC_BANKS.LOCATIONS
            WHERE "state" = 'UT'
            GROUP BY "zip_code"
        )
    )
)
SELECT 
  l."branch_name",
  l."zip_code",
  l."state"
FROM FDA.FDIC_BANKS.LOCATIONS l
JOIN zip_min z
  ON l."zip_code" = z."zip_code"
ORDER BY l."zip_code"
LIMIT 20;
