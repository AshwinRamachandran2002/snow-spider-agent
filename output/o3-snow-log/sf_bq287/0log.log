/*  Employment-rate (ACS 2017) for the Utah ZIP code(s) having the fewest FDIC-insured branches  */
WITH ut_branch_counts AS (          -- branch counts for every Utah ZIP
    SELECT 
        "zip_code",
        COUNT(*) AS "branch_count"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
    GROUP BY "zip_code"
), min_ut_zips AS (                 -- ZIP code(s) with the statewide minimum count
    SELECT 
        "zip_code"
    FROM ut_branch_counts
    WHERE "branch_count" = (
        SELECT MIN("branch_count") FROM ut_branch_counts
    )
), acs_zcta AS (                    -- 2017 ACS employment data at the ZCTA level
    SELECT
        SUBSTR("GEO_ID", 10, 5)         AS "zip_code",          -- pull the 5-digit ZCTA / ZIP
        "C23025_001E"                   AS "pop_16_plus",
        "C23025_005E"                   AS "employed_16_plus"
    FROM CENSUS.ACS_5YR.C23025
