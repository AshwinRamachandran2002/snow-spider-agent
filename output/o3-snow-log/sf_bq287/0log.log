```sql
--Description: 1)  Look‐up the FIPS record for Utah to verify its state abbreviation and FIPS code
SELECT 
  "state_fips_code",
  "state_postal_abbreviation",
  "state_name"
FROM FDA.CENSUS_UTILITY.FIPS_CODES_STATES
WHERE "state_name" = 'Utah'
LIMIT 20;
```

```sql
--Description: 2)  Display every distinct state abbreviation appearing in the FDIC branch LOCATION table
SELECT DISTINCT 
  "state"
FROM FDA.FDIC_BANKS.LOCATIONS
LIMIT 20;
```

```sql
--Description: 3)  Show some sample Utah branch-location rows (state = 'UT')
SELECT 
  "branch_name",
  "zip_code",
  "state"
FROM FDA.FDIC_BANKS.LOCATIONS
WHERE "state" = 'UT'
LIMIT 20;
```

```sql
--Description: 4)  Count how many FDIC-insured branch locations exist in each Utah ZIP code
SELECT 
  "zip_code",
  COUNT(*) AS "branch_count"
FROM FDA.FDIC_BANKS.LOCATIONS
WHERE "state" = 'UT'
GROUP BY "zip_code"
ORDER BY "branch_count" ASC, "zip_code"
LIMIT 20;
```

```sql
--Description: 5)  Retrieve the minimum number of FDIC branch locations found in any Utah ZIP code
SELECT 
  MIN("branch_count") AS "min_branch_count_ut"
FROM (
    SELECT 
      "zip_code",
      COUNT(*) AS "branch_count"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
    GROUP BY "zip_code"
) t
LIMIT 20;
```

```sql
--Description: 6)  List the Utah ZIP code(s) that have that minimum number of FDIC branch locations
WITH zip_counts AS (
    SELECT 
      "zip_code",
      COUNT(*) AS "branch_count"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
    GROUP BY "zip_code"
)
SELECT 
  "zip_code",
  "branch_count"
FROM zip_counts
WHERE "branch_count" = (
    SELECT MIN("branch_count") FROM zip_counts
)
ORDER BY "zip_code"
LIMIT 20;
```

```sql
--Description: 7)  Show every individual branch record that lies in a Utah ZIP code having the minimum branch count
WITH zip_min AS (
    SELECT 
      "zip_code"
    FROM (
        SELECT "zip_code",
               COUNT(*) AS "branch_count"
        FROM FDA.FDIC_BANKS.LOCATIONS
        WHERE "state" = 'UT'
        GROUP BY "zip_code"
    ) q
    WHERE "branch_count" = (
        SELECT MIN("branch_count") FROM (
            SELECT COUNT(*) AS "branch_count"
            FROM FDA.FDIC_BANKS.LOCATIONS
            WHERE "state" = 'UT'
            GROUP BY "zip_code"
        )
    )
)
SELECT 
  l."branch_name",
  l."zip_code",
  l."state"
FROM FDA.FDIC_BANKS.LOCATIONS l
JOIN zip_min z
  ON l."zip_code" = z."zip_code"
ORDER BY l."zip_code"
LIMIT 20;
```

```sql
--Description: 8)  Examine FDIC INSTITUTIONS table rows whose ZIP code is one of the Utah ZIPs with the minimum branch count
WITH min_zips AS (
    SELECT 
      "zip_code"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
    GROUP BY "zip_code"
    HAVING COUNT(*) = (
        SELECT MIN(cnt) 
        FROM (
            SELECT COUNT(*) AS cnt
            FROM FDA.FDIC_BANKS.LOCATIONS
            WHERE "state" = 'UT'
            GROUP BY "zip_code"
        )
    )
)
SELECT 
  i."zip_code",
  i."office_count_domestic",
  i."office_count_foreign",
  i."office_count_us_territories"
FROM FDA.FDIC_BANKS.INSTITUTIONS i
JOIN min_zips z
  ON i."zip_code" = z."zip_code"
LIMIT 20;
```

```sql
--Description: 9)  Compare branch counts for all ZIP codes nationwide (ordered by fewest first) – exploratory
SELECT 
  "zip_code",
  COUNT(*) AS "branch_count"
FROM FDA.FDIC_BANKS.LOCATIONS
GROUP BY "zip_code"
ORDER BY "branch_count" ASC, "zip_code"
LIMIT 20;
```

```sql
--Description: 10)  Join Utah ZIP codes with their state record to show state details alongside branch counts
WITH ut_counts AS (
    SELECT 
      "zip_code",
      COUNT(*) AS "branch_count"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
    GROUP BY "zip_code"
)
SELECT 
  u."zip_code",
  u."branch_count",
  s."state_fips_code",
  s."state_name"
FROM ut_counts u
JOIN FDA.CENSUS_UTILITY.FIPS_CODES_STATES s
  ON s."state_postal_abbreviation" = 'UT'
ORDER BY u."branch_count" ASC, u."zip_code"
LIMIT 20;
```
