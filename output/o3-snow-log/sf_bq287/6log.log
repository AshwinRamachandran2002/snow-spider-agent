/*  1) Find the Utah ZIP code(s) that have the fewest FDIC–insured branch locations
    2) Pull 2017 ACS‐5-year “Employment Status” (table S2301) values for those ZIPs
    3) Calculate the employment-rate for the population aged 16 +  */

WITH least_branch_zip AS (          -- Utah ZIP(s) with the minimum number of branches
    SELECT  "zip_code"
    FROM   (
        SELECT  "zip_code",
                COUNT(*) AS branch_cnt
        FROM   FDA.FDIC_BANKS.LOCATIONS
        WHERE  "state" = 'UT'
        GROUP  BY "zip_code"
    )
    QUALIFY branch_cnt = MIN(branch_cnt) OVER ()
)

SELECT
    a."zip_code",
    ROUND( (a."HC04_EST_VC01" / NULLIF(a."HC01_EST_VC01",0)) * 100 , 4)  AS employment_rate_16plus_2017
FROM   least_branch_zip  z
JOIN   FDA.ACS_5YR_2017.S2301_ZCTA  a   ON a."zip_code" = z."zip_code";
```
