```sql
-- 1. Description:  Look-up Utah’s state postal abbreviation & FIPS code
SELECT 
    "state_name",
    "state_postal_abbreviation",
    "state_fips_code"
FROM FDA.CENSUS_UTILITY.FIPS_CODES_STATES
WHERE "state_name" ILIKE '%Utah%';
```

```sql
-- 2. Description:  Show distinct state abbreviations that appear in FDIC branch “LOCATIONS”
SELECT DISTINCT 
    "state"
FROM FDA.FDIC_BANKS.LOCATIONS
LIMIT 20;
```

```sql
-- 3. Description:  Sample rows for FDIC branch locations physically in Utah
SELECT 
    "branch_name",
    "zip_code",
    "state"
FROM FDA.FDIC_BANKS.LOCATIONS
WHERE "state" = 'UT'
LIMIT 20;
```

```sql
-- 4. Description:  Distinct ZIP codes represented in Utah FDIC branch locations
SELECT DISTINCT 
    "zip_code"
FROM FDA.FDIC_BANKS.LOCATIONS
WHERE "state" = 'UT'
LIMIT 20;
```

```sql
-- 5. Description:  Count of FDIC-insured branch locations per Utah ZIP code
SELECT 
    "zip_code",
    COUNT(*) AS "branch_cnt"
FROM FDA.FDIC_BANKS.LOCATIONS
WHERE "state" = 'UT'
GROUP BY "zip_code"
ORDER BY "branch_cnt" ASC, "zip_code"
LIMIT 20;
```

```sql
-- 6. Description:  Utah ZIP code(s) with the FEWEST FDIC branch locations
WITH zip_branch_counts AS (
    SELECT 
        "zip_code",
        COUNT(*) AS "branch_cnt"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
    GROUP BY "zip_code"
)
SELECT 
    *
FROM zip_branch_counts
WHERE "branch_cnt" = (SELECT MIN("branch_cnt") FROM zip_branch_counts);
```

```sql
-- 7. Description:  Inspect all FDIC branch rows in the ZIP code that has the fewest branches (sub-query from step 6)
SELECT 
    l.*
FROM FDA.FDIC_BANKS.LOCATIONS l
JOIN (
    SELECT 
        "zip_code"
    FROM (
        SELECT 
            "zip_code",
            COUNT(*) AS "branch_cnt"
        FROM FDA.FDIC_BANKS.LOCATIONS
        WHERE "state" = 'UT'
        GROUP BY "zip_code"
    )
    ORDER BY "branch_cnt"
    LIMIT 1
) z
ON l."zip_code" = z."zip_code";
```

```sql
-- 8. Description:  Show FDIC “INSTITUTIONS” rows whose ZIP code matches any Utah branch ZIP
SELECT 
    i."zip_code",
    i."office_count_domestic",
    i."office_count_foreign",
    i."office_count_us_territories"
FROM FDA.FDIC_BANKS.INSTITUTIONS i
WHERE i."zip_code" IN (
    SELECT DISTINCT "zip_code"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
)
LIMIT 20;
```

```sql
-- 9. Description:  Utah ZIP code(s) with fewest branches joined to FDIC “INSTITUTIONS” table (if present)
WITH least_zip AS (
    SELECT 
        "zip_code"
    FROM (
        SELECT 
            "zip_code",
            COUNT(*) AS "branch_cnt"
        FROM FDA.FDIC_BANKS.LOCATIONS
        WHERE "state" = 'UT'
        GROUP BY "zip_code"
    )
    ORDER BY "branch_cnt"
    LIMIT 1
)
SELECT 
    l."branch_name",
    l."zip_code",
    i."office_count_domestic",
    i."office_count_foreign",
    i."office_count_us_territories"
FROM FDA.FDIC_BANKS.LOCATIONS l
LEFT JOIN FDA.FDIC_BANKS.INSTITUTIONS i
      ON l."zip_code" = i."zip_code"
WHERE l."zip_code" IN (SELECT "zip_code" FROM least_zip);
```

```sql
-- 10. Description:  Verify whether multiple ZIP codes tie for the minimum number of FDIC branches in Utah
WITH zip_branch_counts AS (
    SELECT 
        "zip_code",
        COUNT(*) AS "branch_cnt"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
    GROUP BY "zip_code"
)
SELECT 
    "branch_cnt",
    COUNT(*) AS "zip_codes_with_that_cnt"
FROM zip_branch_counts
GROUP BY "branch_cnt"
ORDER BY "branch_cnt"
LIMIT 20;
```
