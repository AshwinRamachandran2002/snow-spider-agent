-- 9. Description:  Utah ZIP code(s) with fewest branches joined to FDIC “INSTITUTIONS” table (if present)
WITH least_zip AS (
    SELECT 
        "zip_code"
    FROM (
        SELECT 
            "zip_code",
            COUNT(*) AS "branch_cnt"
        FROM FDA.FDIC_BANKS.LOCATIONS
        WHERE "state" = 'UT'
        GROUP BY "zip_code"
    )
    ORDER BY "branch_cnt"
    LIMIT 1
)
