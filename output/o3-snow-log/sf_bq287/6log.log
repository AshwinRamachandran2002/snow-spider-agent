/* 1) Identify the Utah ZIP code that has the FEWEST FDIC-insured branch
      locations (if more than one tie, pick the first in alphabetical order).
   2) Look up that ZIP in the 2017 ACS-5-Year S2301 (Employment Status) table
      and return the employment-to-population ratio for people aged 16+.       */

WITH least_branch_zip AS (
    SELECT  "zip_code"
    FROM   (
        SELECT  "zip_code",
                COUNT(*) AS branch_cnt
        FROM   FDA.FDIC_BANKS.LOCATIONS
        WHERE  "state" = 'UT'
        GROUP  BY "zip_code"
    )
    ORDER BY branch_cnt, "zip_code"
    LIMIT 1                              -- pick a single ZIP in case of ties
)

SELECT
    z."zip_code",
    a."HC04_EST_VC01"  AS employment_rate_16plus_2017   -- percent value
FROM   least_branch_zip                 z
JOIN   FDA.ACS5YR_2017.S2301_ZCTA       a        -- 2017 ACS-5-Year ZCTA table
       ON RIGHT(a."GEOID", 5) = z."zip_code";
```
