```sql
--Description: 3)  Take a quick look at a few FDIC branch records that are physically located in Utah.
SELECT *
FROM "FDA"."FDIC_BANKS"."LOCATIONS"
WHERE "state" = 'UT'
LIMIT 20;
```

```sql
--Description: 4)  Count how many FDIC-insured branch locations exist in every Utah ZIP code.
SELECT
       "zip_code",
       COUNT(*) AS "fdic_branch_cnt"
FROM   "FDA"."FDIC_BANKS"."LOCATIONS"
WHERE  "state" = 'UT'
GROUP  BY "zip_code"
ORDER  BY "fdic_branch_cnt" ASC,
          "zip_code"        ASC
LIMIT 20;
```

```sql
--Description: 5)  Isolate the minimum number of FDIC branches found in any Utah ZIP code.
SELECT MIN("fdic_branch_cnt") AS "min_ut_branch_cnt"
FROM (
        SELECT "zip_code", COUNT(*) AS "fdic_branch_cnt"
        FROM   "FDA"."FDIC_BANKS"."LOCATIONS"
        WHERE  "state" = 'UT'
        GROUP  BY "zip_code"
     ) q;
```

```sql
--Description: 6)  List every Utah ZIP code that ties for having the fewest FDIC-insured branches.
WITH ut_counts AS (
     SELECT "zip_code", COUNT(*) AS "fdic_branch_cnt"
     FROM   "FDA"."FDIC_BANKS"."LOCATIONS"
     WHERE  "state" = 'UT'
     GROUP  BY "zip_code"
), min_val AS (
     SELECT MIN("fdic_branch_cnt") AS "m" FROM ut_counts
)
SELECT u.*
FROM   ut_counts u
JOIN   min_val m
       ON u."fdic_branch_cnt" = m."m"
ORDER  BY u."zip_code"
LIMIT 20;
```

```sql
--Description: 7)  Peek at FDIC institution-level records whose headquarters (or branch) ZIP codes
--              fall in Utah, just to understand what the INSTITUTIONS table looks like for UT data.
SELECT *
FROM   "FDA"."FDIC_BANKS"."INSTITUTIONS"
WHERE  "zip_code" ILIKE '84%'   -- Utah ZIPs all start with “84”
LIMIT 20;
```

```sql
--Description: 8)  Count how many distinct FDIC institutions report each Utah ZIP code as their
--              location in the INSTITUTIONS file (complements the branch-level view).
SELECT
       "zip_code",
       COUNT(*) AS "fdic_institution_cnt"
FROM   "FDA"."FDIC_BANKS"."INSTITUTIONS"
WHERE  "zip_code" ILIKE '84%'
GROUP  BY "zip_code"
ORDER  BY "fdic_institution_cnt" ASC
LIMIT 20;
```

```sql
--Description: 9)  Combine branch counts (from LOCATIONS) and institution counts (from
--              INSTITUTIONS) for every Utah ZIP code, which can be useful when deciding
--              which ZIP code truly has the fewest FDIC points of presence.
WITH branch_ct AS (
     SELECT "zip_code", COUNT(*) AS "branch_cnt"
     FROM   "FDA"."FDIC_BANKS"."LOCATIONS"
     WHERE  "state" = 'UT'
     GROUP  BY "zip_code"
), inst_ct AS (
     SELECT "zip_code", COUNT(*) AS "institution_cnt"
     FROM   "FDA"."FDIC_BANKS"."INSTITUTIONS"
     WHERE  "zip_code" ILIKE '84%'
     GROUP  BY "zip_code"
)
SELECT
       COALESCE(b."zip_code", i."zip_code") AS "zip_code",
       b."branch_cnt",
       i."institution_cnt"
FROM   branch_ct b
FULL   JOIN inst_ct i
       ON b."zip_code" = i."zip_code"
ORDER  BY "branch_cnt" NULLS FIRST,
          "zip_code"
LIMIT 20;
```

```sql
--Description: 10)  (Final step placeholder) Having identified the Utah ZIP code(s) with the fewest
--               FDIC branch locations in query #6, we would now join that ZIP list to the 2017
--               American Community Survey employment-rate table (not included in the schemas
--               shown so far) to pull the requested statistic.  The structure below assumes such
--               an ACS table exists as "FDA.CENSUS_UTILITY.ACS_2017_ZCTA", with a column
--               called "employment_rate_16_over".  Replace the table / column names with the
--               actual ones when known.
WITH ut_min_zip AS (
     SELECT u."zip_code"
     FROM (
            SELECT "zip_code", COUNT(*) AS "fdic_branch_cnt"
            FROM   "FDA"."FDIC_BANKS"."LOCATIONS"
            WHERE  "state" = 'UT'
            GROUP  BY "zip_code"
          ) u
     QUALIFY "fdic_branch_cnt" = MIN("fdic_branch_cnt") OVER()
)
SELECT
       a."zip_code",
       a."employment_rate_16_over"
FROM   ut_min_zip z
JOIN   "FDA"."CENSUS_UTILITY"."ACS_2017_ZCTA" a
       ON a."zip_code" = z."zip_code"
LIMIT 20;
```
