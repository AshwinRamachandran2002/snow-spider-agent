       ROUND(
           100.0 * a."employed_16_plus"
           / NULLIF(a."pop_16_plus", 0),
           4
       ) AS "employment_rate_2017_pct"
FROM   ut_min_zip     z
JOIN   acs_employment a
       ON a."zip_code" = z."zip_code"
ORDER  BY z."zip_code";
```
