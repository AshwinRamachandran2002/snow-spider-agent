```sql
--Description:  
--  Find the exact table and column within FDA.CENSUS_UTILITY that hold 2017 ACS
--  employment data.  We scan FDA.INFORMATION_SCHEMA.COLUMNS for tables whose
--  names include both “ACS” and “2017” and whose columns mention “EMPLOY”.
--  The results will tell us which table/column to join with the Utah ZIP code(s)
--  that have the fewest FDIC-insured bank branches.
SELECT DISTINCT
       TABLE_NAME,
       COLUMN_NAME
FROM   FDA.INFORMATION_SCHEMA.COLUMNS
WHERE  TABLE_SCHEMA = 'CENSUS_UTILITY'
  AND  TABLE_NAME   ILIKE '%ACS%2017%'      -- candidate ACS-2017 tables
  AND  COLUMN_NAME  ILIKE '%EMPLOY%'        -- employment-related columns
ORDER BY TABLE_NAME,
         COLUMN_NAME
LIMIT 50;
```
