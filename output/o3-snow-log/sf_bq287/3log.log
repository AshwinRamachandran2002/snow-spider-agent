/*--------------------------------------------------------------
  1)  Identify Utah ZIP code(s) with the fewest FDIC branch
      locations.
  2)  Retrieve 2017 ACS employment-status counts (table B23025)
      for those ZIP codes.
  3)  Report the 2017 employment rate for the population
      aged 16 or older for each qualifying ZIP.
--------------------------------------------------------------*/
WITH ut_branch_counts AS (               -- branch counts for every UT ZIP
    SELECT
        "zip_code",
        COUNT(*) AS "branch_cnt"
    FROM   "FDA"."FDIC_BANKS"."LOCATIONS"
    WHERE  "state" = 'UT'
    GROUP  BY "zip_code"
), ut_min_zip AS (                       -- ZIP code(s) having the minimum
    SELECT  "zip_code"
    FROM    ut_branch_counts
    QUALIFY "branch_cnt" = MIN("branch_cnt") OVER ()
), acs_employment AS (                   -- 2017 ACS employment data
    SELECT
        RIGHT("GEO_ID", 5)  AS "zip_code",      -- keep 5-digit ZCTA
        "B23025_004E"       AS "employed_16_plus",
        "B23025_001E"       AS "pop_16_plus"
    FROM   "CENSUS"."ACS_5YR_2017"."B23025"
)
SELECT
       z."zip_code",
       ROUND(
           100.0 * a."employed_16_plus" / NULLIF(a."pop_16_plus", 0)
           , 4
       ) AS "employment_rate_2017_pct"
FROM   ut_min_zip      z
JOIN   acs_employment  a
       ON a."zip_code" = z."zip_code"
ORDER  BY z."zip_code";
```
