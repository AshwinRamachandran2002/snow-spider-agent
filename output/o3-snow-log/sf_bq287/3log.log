```sql
/*--------------------------------------------------------------
  1)  Find Utah ZIP codes that have the fewest FDIC-insured
      bank-branch locations (LOCATIONS table).
  2)  Pull 2017 ACS table B23025 (Employment Status) at the
      ZIP-code/ZCTA level, and calculate the employment rate
      for the population age 16+.
  3)  Report that rate for every Utah ZIP code that ties for
      the minimum branch count.
--------------------------------------------------------------*/
WITH ut_branch_counts AS (               -- branch counts for every UT ZIP
    SELECT
        "zip_code",
        COUNT(*) AS "branch_cnt"
    FROM   "FDA"."FDIC_BANKS"."LOCATIONS"
    WHERE  "state" = 'UT'
    GROUP  BY "zip_code"
), ut_min_zip AS (                       -- ZIP code(s) with fewest branches
    SELECT  "zip_code"
    FROM    ut_branch_counts
    QUALIFY "branch_cnt" = MIN("branch_cnt") OVER ()
), acs_employment AS (                   -- 2017 ACS employment data by ZIP
    SELECT
        RIGHT("GEO_ID", 5)  AS "zip_code",     -- strip “ZCTA5 ” prefix
        "B23025_004E"       AS "employed_16_plus",
        "B23025_001E"       AS "pop_16_plus"
    FROM   "FDA"."CENSUS_ACS_5YR_2017"."B23025"
)
SELECT
       z."zip_code",
       ROUND(
           100.0 * a."employed_16_plus" / NULLIF(a."pop_16_plus", 0)
           , 4
       ) AS "employment_rate_2017_pct"
FROM   ut_min_zip      z
JOIN   acs_employment  a
       ON a."zip_code" = z."zip_code"
ORDER  BY z."zip_code";
```
