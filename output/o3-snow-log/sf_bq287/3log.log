Query:
--Description: 9)  Combine branch counts (from LOCATIONS) and institution counts (from
--              INSTITUTIONS) for every Utah ZIP code, which can be useful when deciding
--              which ZIP code truly has the fewest FDIC points of presence.
WITH branch_ct AS (
     SELECT "zip_code", COUNT(*) AS "branch_cnt"
     FROM   "FDA"."FDIC_BANKS"."LOCATIONS"
     WHERE  "state" = 'UT'
     GROUP  BY "zip_code"
), inst_ct AS (
     SELECT "zip_code", COUNT(*) AS "institution_cnt"
     FROM   "FDA"."FDIC_BANKS"."INSTITUTIONS"
     WHERE  "zip_code" ILIKE '84%'
     GROUP  BY "zip_code"
)
SELECT
       COALESCE(b."zip_code", i."zip_code") AS "zip_code",
       b."branch_cnt",
       i."institution_cnt"
FROM   branch_ct b
FULL   JOIN inst_ct i
       ON b."zip_code" = i."zip_code"
ORDER  BY "branch_cnt" NULLS FIRST,
          "zip_code"
LIMIT 20;
