Query:
--Description: 9) Number of FDIC-insured institutions headquartered in each of the Utah ZIP codes  
SELECT "zip_code",
       COUNT(*) AS "institution_count"
FROM FDA.FDIC_BANKS.INSTITUTIONS
WHERE "zip_code" IN (
        SELECT DISTINCT "zip_code"
        FROM FDA.FDIC_BANKS.LOCATIONS
        WHERE "state" = 'UT'
     )
GROUP BY "zip_code"
ORDER BY "institution_count" ASC, "zip_code"
LIMIT 20;
