--Description: 10) Join branch locations with institution data for Utah ZIP codes (quick glimpse)  
SELECT l."zip_code",
       l."state",
       l."branch_name",
       i."office_count_domestic"
FROM FDA.FDIC_BANKS.LOCATIONS  AS l
JOIN FDA.FDIC_BANKS.INSTITUTIONS AS i
  ON l."zip_code" = i."zip_code"
WHERE l."state" = 'UT'
LIMIT 20;
