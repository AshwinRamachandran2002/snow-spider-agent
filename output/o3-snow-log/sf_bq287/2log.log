```sql
--Description: 1) Look-up the FIPS information for Utah (postal abbreviation = ‘UT’)
SELECT *
FROM FDA.CENSUS_UTILITY.FIPS_CODES_STATES
WHERE "state_postal_abbreviation" = 'UT'
LIMIT 20;
```

```sql
--Description: 2) See which state abbreviations appear in the FDIC branch locations file  
SELECT DISTINCT "state"
FROM FDA.FDIC_BANKS.LOCATIONS
ORDER BY "state"
LIMIT 20;
```

```sql
--Description: 3) List Utah ZIP codes that have at least one FDIC-insured branch location  
SELECT DISTINCT "zip_code"
FROM FDA.FDIC_BANKS.LOCATIONS
WHERE "state" = 'UT'
LIMIT 20;
```

```sql
--Description: 4) Count how many branch locations each Utah ZIP code has, smallest first  
SELECT "zip_code",
       COUNT(*) AS "branch_count"
FROM FDA.FDIC_BANKS.LOCATIONS
WHERE "state" = 'UT'
GROUP BY "zip_code"
ORDER BY "branch_count" ASC, "zip_code"
LIMIT 20;
```

```sql
--Description: 5) Determine the minimum number of FDIC branch locations found in any Utah ZIP  
SELECT MIN("branch_count") AS "min_branch_count"
FROM (
        SELECT "zip_code",
               COUNT(*) AS "branch_count"
        FROM FDA.FDIC_BANKS.LOCATIONS
        WHERE "state" = 'UT'
        GROUP BY "zip_code"
     );
```

```sql
--Description: 6) Return the Utah ZIP code(s) that have that minimum branch-count value  
SELECT "zip_code"
FROM (
        SELECT "zip_code",
               COUNT(*) AS "branch_count"
        FROM FDA.FDIC_BANKS.LOCATIONS
        WHERE "state" = 'UT'
        GROUP BY "zip_code"
     )
WHERE "branch_count" = (
        SELECT MIN("branch_count")
        FROM (
                SELECT "zip_code",
                       COUNT(*) AS "branch_count"
                FROM FDA.FDIC_BANKS.LOCATIONS
                WHERE "state" = 'UT'
                GROUP BY "zip_code"
             )
     )
LIMIT 20;
```

```sql
--Description: 7) Show the individual branch names found in those lowest-count Utah ZIP codes  
SELECT "branch_name",
       "zip_code"
FROM FDA.FDIC_BANKS.LOCATIONS
WHERE "state" = 'UT'
  AND "zip_code" IN (
        SELECT "zip_code"
        FROM (
                SELECT "zip_code",
                       COUNT(*) AS "branch_count"
                FROM FDA.FDIC_BANKS.LOCATIONS
                WHERE "state" = 'UT'
                GROUP BY "zip_code"
             )
        WHERE "branch_count" = (
                SELECT MIN("branch_count")
                FROM (
                        SELECT "zip_code",
                               COUNT(*) AS "branch_count"
                        FROM FDA.FDIC_BANKS.LOCATIONS
                        WHERE "state" = 'UT'
                        GROUP BY "zip_code"
                     )
        )
     )
LIMIT 20;
```

```sql
--Description: 8) Check whether those Utah ZIP codes also appear in the INSTITUTIONS file  
SELECT DISTINCT "zip_code"
FROM FDA.FDIC_BANKS.INSTITUTIONS
WHERE "zip_code" IN (
        SELECT DISTINCT "zip_code"
        FROM FDA.FDIC_BANKS.LOCATIONS
        WHERE "state" = 'UT'
     )
LIMIT 20;
```

```sql
--Description: 9) Number of FDIC-insured institutions headquartered in each of the Utah ZIP codes  
SELECT "zip_code",
       COUNT(*) AS "institution_count"
FROM FDA.FDIC_BANKS.INSTITUTIONS
WHERE "zip_code" IN (
        SELECT DISTINCT "zip_code"
        FROM FDA.FDIC_BANKS.LOCATIONS
        WHERE "state" = 'UT'
     )
GROUP BY "zip_code"
ORDER BY "institution_count" ASC, "zip_code"
LIMIT 20;
```

```sql
--Description: 10) Join branch locations with institution data for Utah ZIP codes (quick glimpse)  
SELECT l."zip_code",
       l."state",
       l."branch_name",
       i."office_count_domestic"
FROM FDA.FDIC_BANKS.LOCATIONS  AS l
JOIN FDA.FDIC_BANKS.INSTITUTIONS AS i
  ON l."zip_code" = i."zip_code"
WHERE l."state" = 'UT'
LIMIT 20;
```
