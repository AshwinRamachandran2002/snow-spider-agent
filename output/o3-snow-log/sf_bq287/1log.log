```sql
--Description: Goal ─ identify which Utah ZIP code has the fewest FDIC–insured bank branches.  
--Thinking process embedded in CTEs:  
-- 1) “utah_only” filters FDIC branch records to those where state = 'UT'.  
-- 2) “branches_per_zip” counts how many branches each Utah ZIP has.  
-- 3) “fewest_branch_zip” keeps only the ZIP(s) whose branch_count equals the statewide minimum.  
-- The final SELECT lists that ZIP code and its branch_count (if several ZIPs tie for the minimum, the first alphabetically is returned).
WITH utah_only AS (                       -- Utah FDIC branch rows
    SELECT "zip_code"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
), branches_per_zip AS (                  -- count branches per ZIP
    SELECT
        "zip_code",
        COUNT(*) AS "branch_count"
    FROM utah_only
    GROUP BY "zip_code"
), fewest_branch_zip AS (                 -- ZIP(s) with the minimum branch count
    SELECT
        "zip_code",
        "branch_count"
    FROM branches_per_zip
    QUALIFY "branch_count" = MIN("branch_count") OVER ()
)
SELECT
    "zip_code",
    "branch_count"
FROM fewest_branch_zip
ORDER BY "zip_code"
LIMIT 1;                                  -- if multiple ZIPs tie, keep the first alphabetically
```
