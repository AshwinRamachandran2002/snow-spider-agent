```sql
--Description: Combine branch counts and institution HQ counts for Utah ZIP codes
SELECT
    l."zip_code",
    COALESCE(b."branch_count", 0)          AS "branch_count",
    COALESCE(i."institution_hq_count", 0)  AS "institution_hq_count"
FROM (
    SELECT DISTINCT "zip_code"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
) l
LEFT JOIN (
    SELECT "zip_code", COUNT(*) AS "branch_count"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
    GROUP BY "zip_code"
) b  ON l."zip_code" = b."zip_code"
LEFT JOIN (
    SELECT "zip_code", COUNT(*) AS "institution_hq_count"
    FROM FDA.FDIC_BANKS.INSTITUTIONS
    WHERE "zip_code" LIKE '84%'
    GROUP BY "zip_code"
) i  ON l."zip_code" = i."zip_code"
ORDER BY "branch_count" ASC, "institution_hq_count" ASC
LIMIT 20;
```

```sql
--Description: Display full branch details for the Utah ZIP code with the fewest FDIC bank locations
WITH min_zip AS (
    SELECT 
        "zip_code",
        COUNT(*) AS "branch_count"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
    GROUP BY "zip_code"
    ORDER BY "branch_count" ASC
    LIMIT 1
)
SELECT 
    l.*
FROM FDA.FDIC_BANKS.LOCATIONS l
JOIN min_zip z
  ON l."zip_code" = z."zip_code"
ORDER BY l."branch_name"
LIMIT 20;
```

