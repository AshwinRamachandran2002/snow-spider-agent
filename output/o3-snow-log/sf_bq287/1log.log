Query:
--Description: Display full branch details for the Utah ZIP code with the fewest FDIC bank locations
WITH min_zip AS (
    SELECT 
        "zip_code",
        COUNT(*) AS "branch_count"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
    GROUP BY "zip_code"
    ORDER BY "branch_count" ASC
    LIMIT 1
)
SELECT 
    l.*
FROM FDA.FDIC_BANKS.LOCATIONS l
JOIN min_zip z
  ON l."zip_code" = z."zip_code"
ORDER BY l."branch_name"
LIMIT 20;
