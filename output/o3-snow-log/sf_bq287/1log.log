```sql
--Description: Count the number of FDIC-insured bank branch locations in Utah by ZIP code
SELECT
    "zip_code",
    COUNT(*) AS "branch_count"
FROM FDA.FDIC_BANKS.LOCATIONS
WHERE "state" = 'UT'
GROUP BY "zip_code"
ORDER BY "branch_count" ASC
LIMIT 20;
```

```sql
--Description: Return the Utah ZIP code(s) with the fewest FDIC-insured bank branch locations
SELECT
    "zip_code",
    COUNT(*) AS "branch_count"
FROM FDA.FDIC_BANKS.LOCATIONS
WHERE "state" = 'UT'
GROUP BY "zip_code"
QUALIFY "branch_count" = MIN("branch_count") OVER ()
ORDER BY "zip_code"
LIMIT 20;
```

