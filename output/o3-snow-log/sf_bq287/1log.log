```sql
/* 1. Identify the Utah ZIP code that has the fewest FDIC-insured bank branch locations.
   2. Pull its 2017 ACS “Employment Status (B23025)” data.
      B23025_001E = Total population 16 years and over
      B23025_004E = Civilian employed population 16 years and over
   3. Compute the employment-rate percentage. */

WITH utah_min_zip AS (      -- step 1
    SELECT
        "zip_code"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
    GROUP BY "zip_code"
    ORDER BY COUNT(*) ASC          -- fewest branches
    LIMIT 1
),
acs_2017 AS (               -- step 2
    SELECT
        "GEOID"                            AS "zip_code",
        "B23025_004E"                      AS "employed_16_plus",
        "B23025_001E"                      AS "population_16_plus"
    FROM FDA.CENSUS_ACS_2017_5YR.ZCTA
)
SELECT
    a."zip_code",
    ROUND( (a."employed_16_plus" / NULLIF(a."population_16_plus",0)) * 100 , 4)
        AS "employment_rate_16_plus_pct_2017"
FROM utah_min_zip   z
JOIN acs_2017       a
  ON a."zip_code" = z."zip_code";
