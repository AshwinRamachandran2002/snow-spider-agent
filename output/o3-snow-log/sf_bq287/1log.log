acs_2017 AS (            -- Step 2
    SELECT
        "GEOID"        AS "zip_code",
        "B23025_004E"  AS "employed_16_plus",
        "B23025_001E"  AS "population_16_plus"
    FROM FDA.ACS.ZCTA_2017_5YR
)
SELECT
    a."zip_code",
    ROUND(
        (a."employed_16_plus" / NULLIF(a."population_16_plus", 0)) * 100,
        4
    ) AS "employment_rate_16_plus_pct_2017"
FROM utah_min_zip  z
JOIN acs_2017      a
  ON a."zip_code" = z."zip_code";
```
