```sql
--Description: Determine the Utah ZIP code with the fewest FDIC-insured bank branches, then return that ZIP’s 2017 ACS employment rate (population 16 +) in a single query
WITH utah_branch_counts AS (                     -- count branches per Utah ZIP
    SELECT
        "zip_code",
        COUNT(*) AS "branch_count"
    FROM FDA.FDIC_BANKS.LOCATIONS
    WHERE "state" = 'UT'
    GROUP BY "zip_code"
), min_utah_zip AS (                             -- keep the ZIP with the minimum count
    SELECT
        "zip_code"
    FROM utah_branch_counts
    QUALIFY "branch_count" = MIN("branch_count") OVER ()
    LIMIT 1                                      -- in case of ties, keep the first (lowest ZIP)
)
SELECT                                           -- pull the 2017 ACS employment rate for that ZIP
    acs."zip_code",
    acs."employment_rate_16_plus"
FROM FDA.CENSUS.ACS_ZIP_2017 acs                 -- replace with actual ACS table name if different
JOIN min_utah_zip z
  ON acs."zip_code" = z."zip_code"
LIMIT 20;
```
