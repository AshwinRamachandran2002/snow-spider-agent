```sql
--Description / Thinking process:
-- Goal:  Find the 2017 ACS employment-rate (age 16+) for the Utah ZIP code
--        that has the *fewest* FDIC-insured bank branches, choosing the ZIP
--        with the lowest employment rate if several share that minimum.
--
-- Steps inside one query:
--   a) ut_branch_counts  – count branches per Utah ZIP in FDIC_BANKS.LOCATIONS.
--   b) min_zip_cte       – keep only ZIPs whose branch count equals the statewide minimum.
--   c) Join those ZIPs to the 2017 ACS ZIP-level table
--      (assumed name FDA.CENSUS_UTILITY.ACS_2017_ZIP with columns
--       “zip_code” and “employment_rate_16plus”).
--   d) Order by employment rate ascending, then ZIP; LIMIT 1 returns the
--      single ZIP with the lowest employment rate among the few-branch ZIPs.
WITH ut_branch_counts AS (           -- a) branches per Utah ZIP
    SELECT "zip_code",
           COUNT(*) AS branch_cnt
    FROM   FDA.FDIC_BANKS.LOCATIONS
    WHERE  "state" = 'UT'
    GROUP  BY "zip_code"
),
min_zip_cte AS (                     -- b) ZIPs with the minimum branch count
    SELECT "zip_code"
    FROM   ut_branch_counts
    QUALIFY branch_cnt = MIN(branch_cnt) OVER()
)
SELECT acs."zip_code",
       acs."employment_rate_16plus"
FROM   FDA.CENSUS_UTILITY.ACS_2017_ZIP  acs      -- c) 2017 ACS table (update name if different)
JOIN   min_zip_cte                         m
  ON   acs."zip_code" = m."zip_code"
ORDER  BY acs."employment_rate_16plus" ASC,
          acs."zip_code"               ASC
LIMIT  1;                                -- d) ZIP with the lowest employment rate
```
