```sql
--Description / Thinking process:
-- Objective: Produce the set of Utah ZIP codes that contain the *fewest* FDIC-insured
--            bank locations; this output can be joined later to 2017 ACS data to
--            retrieve the employment rate for population 16+.
--
-- Steps we embed in a single SQL:
--   1.  Narrow FDA.FDIC_BANKS.LOCATIONS to Utah rows (state = 'UT').
--   2.  Aggregate by ZIP to count branches         → zip_branch_counts CTE.
--   3.  Find the smallest of those counts          → min_cte.
--   4.  Return only the ZIP(s) whose branch count equals that minimum.
--   5.  Sort results by ZIP for easy inspection.
WITH zip_branch_counts AS (                       -- step 1 & 2
    SELECT "zip_code",
           COUNT(*) AS "branch_cnt"
    FROM   FDA.FDIC_BANKS.LOCATIONS
    WHERE  "state" = 'UT'
    GROUP  BY "zip_code"
),
min_cte AS (                                      -- step 3
    SELECT MIN("branch_cnt") AS "min_cnt"
    FROM   zip_branch_counts
)
SELECT z."zip_code",                              -- step 4
       z."branch_cnt"
FROM   zip_branch_counts z
JOIN   min_cte m
  ON   z."branch_cnt" = m."min_cnt"
ORDER  BY z."zip_code";                           -- step 5
```
