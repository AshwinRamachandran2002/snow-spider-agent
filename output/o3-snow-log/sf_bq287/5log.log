```sql
--Description: 4) Count how many FDIC-insured branch locations there are in each Utah ZIP code
SELECT "zip_code",
       COUNT(*) AS "branch_location_count"
FROM   FDA.FDIC_BANKS.LOCATIONS
WHERE  "state" = 'UT'
GROUP  BY "zip_code"
ORDER  BY "branch_location_count" ASC,
          "zip_code"
LIMIT  20;
```

```sql
--Description: 5) Determine the minimum number of FDIC branch locations found in any Utah ZIP code
SELECT MIN("branch_location_count") AS "min_ut_branch_count"
FROM  ( SELECT "zip_code",
               COUNT(*) AS "branch_location_count"
        FROM   FDA.FDIC_BANKS.LOCATIONS
        WHERE  "state" = 'UT'
        GROUP  BY "zip_code"
      ) AS t;
```

```sql
--Description: 6) List the Utah ZIP code(s) that have that minimum number of FDIC-insured locations
WITH branch_cte AS (
    SELECT "zip_code",
           COUNT(*) AS "branch_location_count"
    FROM   FDA.FDIC_BANKS.LOCATIONS
    WHERE  "state" = 'UT'
    GROUP  BY "zip_code"
),
min_cte AS (
    SELECT MIN("branch_location_count") AS "min_ct"
    FROM   branch_cte
)
SELECT b."zip_code",
       b."branch_location_count"
FROM   branch_cte b,
       min_cte   m
WHERE  b."branch_location_count" = m."min_ct"
ORDER  BY b."zip_code"
LIMIT  20;
```

```sql
--Description: 7) Show the institution headquarters ZIPs in Utah (from the INSTITUTIONS table) for extra context
SELECT DISTINCT "zip_code"
FROM   FDA.FDIC_BANKS.INSTITUTIONS
WHERE  "zip_code" ILIKE '84%'          -- Utah ZIPs typically start with 840-847
LIMIT  20;
```

```sql
--Description: 8) Join LOCATIONS and INSTITUTIONS on ZIP code to see how many different institutions operate in each low-branch Utah ZIP code
WITH ut_min_branches AS (                 -- ZIPs with the fewest FDIC branches in UT
    SELECT "zip_code"
    FROM  (SELECT "zip_code",
                  COUNT(*) AS ct
           FROM   FDA.FDIC_BANKS.LOCATIONS
           WHERE  "state" = 'UT'
           GROUP  BY "zip_code") z
    QUALIFY ct = MIN(ct) OVER()          -- the minimum count
)
SELECT l."zip_code",
       COUNT(DISTINCT i."zip_code") AS "institution_count"
FROM   ut_min_branches  u
JOIN   FDA.FDIC_BANKS.LOCATIONS     l ON l."zip_code" = u."zip_code"
LEFT   JOIN FDA.FDIC_BANKS.INSTITUTIONS i ON i."zip_code" = l."zip_code"
GROUP  BY l."zip_code"
LIMIT  20;
```

