```sql
/* -------------------------------------------------------------
   1)  Count how many FDIC-insured branch locations there are in
       each Utah ZIP code.
   2)  Isolate the ZIP code(s) with the minimum branch count and
       keep the first one (lowest ZIP) in case of a tie.
   3)  Look up that ZIP code’s 2017 ACS employment-to-population
       rate (age 16+).  Table S2301 is the Employment-Status
       summary table in the 2017 5-year ACS release at the ZIP
       Code Tabulation Area (ZCTA) level.
---------------------------------------------------------------- */
WITH ut_branch_cte AS (                       -- step 1
    SELECT  "zip_code",
            COUNT(*) AS branch_ct
    FROM    FDA.FDIC_BANKS.LOCATIONS
    WHERE   "state" = 'UT'
    GROUP BY "zip_code"
),
min_zip_cte AS (                              -- step 2
    SELECT  "zip_code"
    FROM    ut_branch_cte
    QUALIFY branch_ct = MIN(branch_ct) OVER()
    ORDER BY "zip_code"
    LIMIT 1                                   -- pick the first ZIP if there is a tie
)
SELECT  a."zip_code",
        a."employment_rate_pop_16_plus_pct"   AS employment_rate_2017
FROM    FDA.CENSUS_ACS.S2301_ZCTA_2017_5YR a  -- 2017 ACS 5-yr Employment-Status table
JOIN    min_zip_cte z
  ON    a."zip_code" = z."zip_code";
```
