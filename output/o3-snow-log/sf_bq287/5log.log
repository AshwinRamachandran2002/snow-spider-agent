   2)  Find the ZIP code that has the fewest locations (choose the
       lowest ZIP if there is a tie).
   3)  Return that ZIP’s 2017 ACS employment-to-population ratio
       (age 16+), table S2301 (5-year estimates).
------------------------------------------------------------------*/
WITH ut_branch_cte AS (              -- step 1
    SELECT  "zip_code",
            COUNT(*) AS branch_ct
    FROM    FDA.FDIC_BANKS.LOCATIONS
    WHERE   "state" = 'UT'
    GROUP BY "zip_code"
),
min_zip_cte AS (                     -- step 2
    SELECT  "zip_code"
    FROM    ut_branch_cte
    QUALIFY branch_ct = MIN(branch_ct) OVER ()
    ORDER BY "zip_code"
    LIMIT 1                          -- keep first ZIP if ties occur
)
SELECT  a."zip_code",
        a."employment_population_ratio_16_years_and_over_pct"
            AS employment_rate_2017  -- step 3
FROM    FDA.CENSUS.ACS_2017_5YR_S2301_ZCTA  a
JOIN    min_zip_cte z
      ON a."zip_code" = z."zip_code";
