/* -----------------------------------------------------------------
   1)  Count FDIC-insured branch locations in each Utah ZIP code.
   2)  Identify the ZIP that has the fewest branches
       (choose the lowest ZIP when ties occur).
   3)  Return that ZIP’s 2017 ACS employment-to-population ratio
       for people aged 16 or older (table S2301, 5-year estimates).
-----------------------------------------------------------------*/
WITH ut_branch_cte AS (                 -- step 1
    SELECT  "zip_code",
            COUNT(*) AS branch_ct
    FROM    FDA.FDIC_BANKS.LOCATIONS
    WHERE   "state" = 'UT'
    GROUP BY "zip_code"
),       
min_zip_cte AS (                        -- step 2
    SELECT  "zip_code"
    FROM    ut_branch_cte
    QUALIFY branch_ct = MIN(branch_ct) OVER ()
    ORDER BY "zip_code"
    LIMIT 1                             -- keep first ZIP if ties
)
SELECT  acs."zip_code",
        acs."employment_population_ratio_16_years_and_over_pct"
            AS employment_rate_2017     -- step 3
FROM    CENSUS.ACS_ZCTA_2017_5YR_S2301  acs
JOIN    min_zip_cte  z
  ON    acs."zip_code" = z."zip_code";
