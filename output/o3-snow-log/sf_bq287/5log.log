--       table (not present in the current database) to obtain employment-rate
--       statistics.
--
-- Steps combined in one query:
--   1.  Filter FDA.FDIC_BANKS.LOCATIONS to Utah rows (state = 'UT').
--   2.  Count branch locations per ZIP →  ut_branch_counts CTE.
--   3.  Keep only ZIPs whose branch-count equals the statewide minimum
--       (using QUALIFY with a windowed MIN) → ut_min_branch_zips CTE.
--   4.  Return those ZIP codes plus their branch count, sorted by ZIP.
WITH ut_branch_counts AS (                -- step-1 & 2
    SELECT "zip_code",
           COUNT(*) AS branch_cnt
    FROM   FDA.FDIC_BANKS.LOCATIONS
    WHERE  "state" = 'UT'
    GROUP  BY "zip_code"
),
ut_min_branch_zips AS (                   -- step-3
    SELECT "zip_code",
           branch_cnt
    FROM   ut_branch_counts
    QUALIFY branch_cnt = MIN(branch_cnt) OVER()
)
SELECT "zip_code",
       branch_cnt
FROM   ut_min_branch_zips
ORDER  BY "zip_code";                     -- step-4
```
