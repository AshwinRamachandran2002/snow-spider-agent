```sql
--Description: Join COVID data (June 30 2020) with 2018 population to view both values together
SELECT 
    c."country_name",
    c."country_code",
    c."cumulative_confirmed",
    p."year_2018" AS "population_2018"
FROM COVID19_OPEN_WORLD_BANK.COVID19_OPEN_DATA.COVID19_OPEN_DATA  c
JOIN COVID19_OPEN_WORLD_BANK.WORLD_BANK_GLOBAL_POPULATION.POPULATION_BY_COUNTRY p
      ON c."country_code" = p."country_code"
WHERE c."date" = '2020-06-30'
LIMIT 20;
```

```sql
--Description: Calculate the percentage of population confirmed with COVID-19 for each country (sample 20 rows)
SELECT
    c."country_name",
    c."country_code",
    c."cumulative_confirmed",
    p."year_2018" AS "population_2018",
    (c."cumulative_confirmed" / NULLIF(p."year_2018",0)) * 100 AS "percent_confirmed"
FROM COVID19_OPEN_WORLD_BANK.COVID19_OPEN_DATA.COVID19_OPEN_DATA c
JOIN COVID19_OPEN_WORLD_BANK.WORLD_BANK_GLOBAL_POPULATION.POPULATION_BY_COUNTRY p
      ON c."country_code" = p."country_code"
WHERE c."date" = '2020-06-30'
LIMIT 20;
```

```sql
--Description: Rank all countries by highest percentage confirmed (top 20)
SELECT
    c."country_name",
    c."country_code",
    (c."cumulative_confirmed" / NULLIF(p."year_2018",0)) * 100 AS "percent_confirmed"
FROM COVID19_OPEN_WORLD_BANK.COVID19_OPEN_DATA.COVID19_OPEN_DATA c
JOIN COVID19_OPEN_WORLD_BANK.WORLD_BANK_GLOBAL_POPULATION.POPULATION_BY_COUNTRY p
      ON c."country_code" = p."country_code"
WHERE c."date" = '2020-06-30'
ORDER BY "percent_confirmed" DESC
LIMIT 20;
```

