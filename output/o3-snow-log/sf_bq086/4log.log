```sql
--Description:  Find, for every nation, what share of its 2018 population had been cumulatively confirmed with COVID-19 by
--30 June 2020.  Approach:
--  • COVID table → keep only national rows (aggregation_level = 0) on the target date 2020-06-30.
--  • Population table → 2018 population (“year_2018”).
--  • Join on the common 3-letter ISO code: COVID column "iso_3166_1_alpha_3" ↔ population column "country_code".
--  • Compute percentage = confirmed / population * 100.
--  • Exclude countries lacking a 2018 population value.
--  • Order by largest percentage to smallest (no LIMIT so full list is produced).

SELECT
    c."country_name",
    c."iso_3166_1_alpha_3"                         AS "country_code",
    c."cumulative_confirmed",
    p."year_2018"                                  AS "population_2018",
    (c."cumulative_confirmed" / NULLIF(p."year_2018",0)) * 100  AS "percent_confirmed"
FROM COVID19_OPEN_WORLD_BANK.COVID19_OPEN_DATA.COVID19_OPEN_DATA  AS c
JOIN COVID19_OPEN_WORLD_BANK.WORLD_BANK_GLOBAL_POPULATION.POPULATION_BY_COUNTRY  AS p
      ON p."country_code" = c."iso_3166_1_alpha_3"
WHERE c."aggregation_level" = 0
  AND c."date" = '2020-06-30'
  AND p."year_2018" IS NOT NULL
ORDER BY "percent_confirmed" DESC;
```
