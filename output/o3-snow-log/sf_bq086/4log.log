Query:
--Description: Identify countries that report COVID data on 2020-06-30 but lack a 2018 population value, 
--using ISO code for the left join and keeping only national rows.
SELECT
    c."country_name",
    c."iso_3166_1_alpha_3"  AS "country_code"
FROM COVID19_OPEN_WORLD_BANK.COVID19_OPEN_DATA.COVID19_OPEN_DATA AS c
LEFT JOIN COVID19_OPEN_WORLD_BANK.WORLD_BANK_GLOBAL_POPULATION.POPULATION_BY_COUNTRY AS p
       ON p."country_code" = c."iso_3166_1_alpha_3"
WHERE c."aggregation_level" = 0
  AND c."date" = '2020-06-30'
  AND p."year_2018" IS NULL
LIMIT 20
