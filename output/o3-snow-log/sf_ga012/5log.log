--Description: 9) Preliminary tax-rate calculation (tax ÷ revenue) per item category  
SELECT
       it.value:"item_category"::STRING                                                   AS "item_category",
       SUM(CASE WHEN ep.value:"key"::STRING = 'tax'                         THEN ep.value:"value":"double_value"::FLOAT END)  AS "tax_usd",
       SUM(CASE WHEN ep.value:"key"::STRING = 'purchase_revenue_in_usd'     THEN ep.value:"value":"double_value"::FLOAT END)  AS "purchase_rev_usd",
       SUM(CASE WHEN ep.value:"key"::STRING = 'tax'                         THEN ep.value:"value":"double_value"::FLOAT END) /
       NULLIF(SUM(CASE WHEN ep.value:"key"::STRING = 'purchase_revenue_in_usd' THEN ep.value:"value":"double_value"::FLOAT END),0)                                   AS "tax_rate"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" e,
     LATERAL FLATTEN(input => e."EVENT_PARAMS") ep,
     LATERAL FLATTEN(input => e."ITEMS")         it
WHERE e."EVENT_NAME" = 'purchase'
GROUP BY "item_category"
ORDER BY "tax_rate" DESC NULLS LAST
LIMIT 20;
