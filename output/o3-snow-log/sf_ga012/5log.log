Query:
--Description: 10) For the item-category with the highest tax-rate, return transaction-id,  
--                 total item quantities, purchase revenue (usd & original) for each purchase  
WITH top_cat AS (
    SELECT it2.value:"item_category"::STRING AS "item_category"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" e2,
         LATERAL FLATTEN(input => e2."EVENT_PARAMS") ep2,
         LATERAL FLATTEN(input => e2."ITEMS")         it2
    WHERE e2."EVENT_NAME" = 'purchase'
    GROUP BY "item_category"
    ORDER BY
      SUM(CASE WHEN ep2.value:"key"::STRING = 'tax' THEN ep2.value:"value":"double_value"::FLOAT END) /
      NULLIF(SUM(CASE WHEN ep2.value:"key"::STRING = 'purchase_revenue_in_usd' THEN ep2.value:"value":"double_value"::FLOAT END),0) DESC
    LIMIT 1
)

SELECT
       ep_tx.value:"value":"string_value"::STRING                                           AS "transaction_id",
       SUM(it.value:"quantity"::INT)                                                       AS "total_item_quantity",
       MAX(CASE WHEN ep_rev.value:"key"::STRING = 'purchase_revenue_in_usd'
                THEN ep_rev.value:"value":"double_value"::FLOAT END)                       AS "purchase_revenue_usd",
       MAX(CASE WHEN ep_rev2.value:"key"::STRING = 'purchase_revenue'
                THEN ep_rev2.value:"value":"double_value"::FLOAT END)                      AS "purchase_revenue"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" e
     , LATERAL FLATTEN(input => e."ITEMS")         it
     , LATERAL FLATTEN(input => e."EVENT_PARAMS")  ep_tx
     , LATERAL FLATTEN(input => e."EVENT_PARAMS")  ep_rev
     , LATERAL FLATTEN(input => e."EVENT_PARAMS")  ep_rev2
     , top_cat
WHERE e."EVENT_NAME" = 'purchase'
  AND it.value:"item_category"::STRING = top_cat."item_category"
  AND ep_tx.value:"key"::STRING  = 'transaction_id'
GROUP BY "transaction_id"
LIMIT 20;
