       "EVENT_NAME",
       "EVENT_VALUE_IN_USD",
       "ITEMS",
       "ECOMMERCE"
FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20201130"
WHERE "EVENT_NAME" = 'purchase'
LIMIT 20;
```

```sql
-- 3) What does one element of the ITEMS array look like?
SELECT i.value
FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20201130" t,
     LATERAL FLATTEN(input => t."ITEMS") i
LIMIT 20;
```

```sql
-- 4) Pull out the main fields of interest from ITEMS for purchase events
SELECT i.value:"item_category"::STRING           AS "item_category",
       i.value:"quantity"::NUMBER               AS "quantity",
       i.value:"price"::FLOAT                   AS "price",
       i.value:"tax"::FLOAT                     AS "tax",
       t."EVENT_VALUE_IN_USD"                   AS "purchase_revenue_usd"
FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20201130" t,
     LATERAL FLATTEN(input => t."ITEMS") i
WHERE t."EVENT_NAME" = 'purchase'
LIMIT 20;
```

```sql
-- 5) Inspect which keys live inside EVENT_PARAMS for purchase events
SELECT DISTINCT p.value:"key"::STRING AS "event_param_key"
FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20201130" t,
     LATERAL FLATTEN(input => t."EVENT_PARAMS") p
WHERE t."EVENT_NAME" = 'purchase'
LIMIT 20;
```

```sql
-- 6) Extract the ‘value’ parameter (GA4 purchase revenue) alongside the
--    EVENT_VALUE_IN_USD column for comparison
SELECT t."EVENT_TIMESTAMP",
       p.value:"double_value"::FLOAT  AS "param_value",
       t."EVENT_VALUE_IN_USD"
FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20201130" t,
     LATERAL FLATTEN(input => t."EVENT_PARAMS") p
WHERE t."EVENT_NAME" = 'purchase'
  AND p.value:"key"::STRING = 'value'
LIMIT 20;
```

```sql
-- 7) Compute tax-to-revenue ratio per item category for 30-Nov-2020 purchases
SELECT i.value:"item_category"::STRING                     AS "item_category",
       SUM(i.value:"tax"::FLOAT)                           AS "total_tax_usd",
       SUM(t."EVENT_VALUE_IN_USD")                         AS "total_revenue_usd",
       SUM(i.value:"tax"::FLOAT) / SUM(t."EVENT_VALUE_IN_USD") AS "tax_rate"
FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20201130" t,
     LATERAL FLATTEN(input => t."ITEMS") i
WHERE t."EVENT_NAME" = 'purchase'
GROUP BY 1
ORDER BY "tax_rate" DESC
LIMIT 20;
```

```sql
-- 8) Identify the single item category with the highest tax rate
SELECT "item_category"
FROM (
      SELECT i.value:"item_category"::STRING AS "item_category",
             SUM(i.value:"tax"::FLOAT) / SUM(t."EVENT_VALUE_IN_USD") AS "tax_rate"
      FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20201130" t,
           LATERAL FLATTEN(input => t."ITEMS") i
      WHERE t."EVENT_NAME" = 'purchase'
      GROUP BY 1
      ORDER BY "tax_rate" DESC
      LIMIT 1
) s;
```

```sql
-- 9) Pull the transaction-level details (transaction_id lives in ECOMMERCE)
--    for purchase events that belong to that top-tax-rate category
SELECT t."ECOMMERCE":transaction_id::STRING                 AS "transaction_id",
       SUM(i.value:"quantity"::NUMBER)                      AS "total_item_qty",
       t."EVENT_VALUE_IN_USD"                               AS "purchase_revenue_usd",
       p.value:"double_value"::FLOAT                        AS "purchase_revenue_param_usd"
FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20201130" t
     ,LATERAL FLATTEN(input => t."ITEMS") i
     ,LATERAL FLATTEN(input => t."EVENT_PARAMS") p
WHERE t."EVENT_NAME" = 'purchase'
  AND i.value:"item_category"::STRING = (
        /* reuse query 8 but in-lined */
        SELECT item_max."item_category"
        FROM (
              SELECT i2.value:"item_category"::STRING AS "item_category",
                     SUM(i2.value:"tax"::FLOAT) / SUM(t2."EVENT_VALUE_IN_USD") AS "tax_rate"
              FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20201130" t2,
                   LATERAL FLATTEN(input => t2."ITEMS") i2
              WHERE t2."EVENT_NAME" = 'purchase'
              GROUP BY 1
              ORDER BY "tax_rate" DESC
              LIMIT 1
        ) item_max
       )
  AND p.value:"key"::STRING = 'value'
GROUP BY 1,3,4
LIMIT 20;
```

```sql
