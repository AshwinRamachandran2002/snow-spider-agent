-- 3) Flatten EVENT_PARAMS for purchase events to discover every key that is present
SELECT 
  f.value:"key"::STRING                     AS "param_key",
  f.value:"value":"int_value"::NUMBER       AS "int_val",
  f.value:"value":"double_value"::FLOAT     AS "double_val",
  f.value:"value":"string_value"::STRING    AS "string_val"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130"  t,
     LATERAL FLATTEN(input => t."EVENT_PARAMS")              f
WHERE t."EVENT_NAME" = 'purchase'
LIMIT 20;
