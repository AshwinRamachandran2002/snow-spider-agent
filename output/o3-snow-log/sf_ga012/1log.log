Query:
-- 8) Build per-purchase metrics: tax, purchase revenue and overall item quantity
WITH ep AS (                    -- pull tax & revenue from EVENT_PARAMS
  SELECT
    t."EVENT_BUNDLE_SEQUENCE_ID",
    MAX( CASE WHEN f.value:"key"::STRING = 'tax'
              THEN COALESCE(f.value:"value":"double_value",
                            f.value:"value":"int_value") END ) AS "tax_usd",
    MAX( CASE WHEN f.value:"key"::STRING IN ('purchase_revenue','value')
              THEN COALESCE(f.value:"value":"double_value",
                            f.value:"value":"int_value") END ) AS "purchase_revenue_usd"
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130"  t,
       LATERAL FLATTEN(input => t."EVENT_PARAMS")              f
  WHERE t."EVENT_NAME" = 'purchase'
  GROUP BY t."EVENT_BUNDLE_SEQUENCE_ID"
),
it AS (                       -- sum item quantities & keep category per purchase
  SELECT
    t."EVENT_BUNDLE_SEQUENCE_ID",
    i.value:"item_category"::STRING AS "item_category",
    SUM(i.value:"quantity"::NUMBER) AS "total_item_qty"
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130"  t,
       LATERAL FLATTEN(input => t."ITEMS")                     i
  WHERE t."EVENT_NAME" = 'purchase'
  GROUP BY t."EVENT_BUNDLE_SEQUENCE_ID", i.value:"item_category"::STRING
)
SELECT 
  it."item_category",
  ep."tax_usd",
  ep."purchase_revenue_usd",
  it."total_item_qty",
  ep."tax_usd" / NULLIF(ep."purchase_revenue_usd",0) AS "tax_rate"
FROM it
JOIN ep USING ("EVENT_BUNDLE_SEQUENCE_ID")
LIMIT 20;
