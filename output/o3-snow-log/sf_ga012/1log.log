WHERE "EVENT_NAME" = 'purchase'
LIMIT 20;
```

```sql
-- 8) Build per-purchase metrics: tax, purchase revenue and overall item quantity
WITH ep AS (                    -- pull tax & revenue from EVENT_PARAMS
  SELECT
    t."EVENT_BUNDLE_SEQUENCE_ID",
    MAX( CASE WHEN f.value:"key"::STRING = 'tax'
              THEN COALESCE(f.value:"value":"double_value",
                            f.value:"value":"int_value") END ) AS "tax_usd",
    MAX( CASE WHEN f.value:"key"::STRING IN ('purchase_revenue','value')
              THEN COALESCE(f.value:"value":"double_value",
                            f.value:"value":"int_value") END ) AS "purchase_revenue_usd"
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130"  t,
       LATERAL FLATTEN(input => t."EVENT_PARAMS")              f
  WHERE t."EVENT_NAME" = 'purchase'
  GROUP BY t."EVENT_BUNDLE_SEQUENCE_ID"
),
it AS (                       -- sum item quantities & keep category per purchase
  SELECT
    t."EVENT_BUNDLE_SEQUENCE_ID",
    i.value:"item_category"::STRING AS "item_category",
    SUM(i.value:"quantity"::NUMBER) AS "total_item_qty"
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130"  t,
       LATERAL FLATTEN(input => t."ITEMS")                     i
  WHERE t."EVENT_NAME" = 'purchase'
  GROUP BY t."EVENT_BUNDLE_SEQUENCE_ID", i.value:"item_category"::STRING
)
SELECT 
  it."item_category",
  ep."tax_usd",
  ep."purchase_revenue_usd",
  it."total_item_qty",
  ep."tax_usd" / NULLIF(ep."purchase_revenue_usd",0) AS "tax_rate"
FROM it
JOIN ep USING ("EVENT_BUNDLE_SEQUENCE_ID")
LIMIT 20;
```

```sql
-- 9) Aggregate at category-level to compute tax-to-revenue ratio
WITH purchase_metrics AS (  -- same CTE as previous query
  SELECT
    it."item_category",
    SUM(ep."tax_usd")                AS "total_tax",
    SUM(ep."purchase_revenue_usd")   AS "total_revenue"
  FROM (
      SELECT
        t."EVENT_BUNDLE_SEQUENCE_ID",
        MAX( CASE WHEN f.value:"key"::STRING = 'tax'
                  THEN COALESCE(f.value:"value":"double_value",
                                f.value:"value":"int_value") END ) AS "tax_usd",
        MAX( CASE WHEN f.value:"key"::STRING IN ('purchase_revenue','value')
                  THEN COALESCE(f.value:"value":"double_value",
                                f.value:"value":"int_value") END ) AS "purchase_revenue_usd"
      FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
           LATERAL FLATTEN(input => t."EVENT_PARAMS") f
      WHERE t."EVENT_NAME" = 'purchase'
      GROUP BY t."EVENT_BUNDLE_SEQUENCE_ID"
  ) ep
  JOIN (
      SELECT
        t."EVENT_BUNDLE_SEQUENCE_ID",
        i.value:"item_category"::STRING AS "item_category"
      FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
           LATERAL FLATTEN(input => t."ITEMS") i
      WHERE t."EVENT_NAME" = 'purchase'
  ) it
  USING ("EVENT_BUNDLE_SEQUENCE_ID")
  GROUP BY it."item_category"
)
SELECT 
  "item_category",
  "total_tax",
  "total_revenue",
  "total_tax" / NULLIF("total_revenue",0) AS "tax_rate"
FROM purchase_metrics
ORDER BY "tax_rate" DESC
LIMIT 20;
```

```sql
-- 10) Pull transaction-level details ONLY for the item category with the highest tax_rate
WITH top_category AS (       -- first find the top category
  SELECT 
    "item_category"
  FROM (
      -- reuse aggregation logic
      SELECT 
        it."item_category",
        SUM(ep."tax_usd")              AS "total_tax",
        SUM(ep."purchase_revenue_usd") AS "total_revenue"
      FROM (
          SELECT
            t."EVENT_BUNDLE_SEQUENCE_ID",
            MAX(CASE WHEN f.value:"key"::STRING = 'tax'
                     THEN COALESCE(f.value:"value":"double_value",
                                   f.value:"value":"int_value") END) AS "tax_usd",
            MAX(CASE WHEN f.value:"key"::STRING IN ('purchase_revenue','value')
                     THEN COALESCE(f.value:"value":"double_value",
                                   f.value:"value":"int_value") END) AS "purchase_revenue_usd"
          FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
               LATERAL FLATTEN(input => t."EVENT_PARAMS") f
          WHERE t."EVENT_NAME" = 'purchase'
          GROUP BY t."EVENT_BUNDLE_SEQUENCE_ID"
      ) ep
      JOIN (
          SELECT
            t."EVENT_BUNDLE_SEQUENCE_ID",
            i.value:"item_category"::STRING AS "item_category"
          FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
               LATERAL FLATTEN(input => t."ITEMS") i
          WHERE t."EVENT_NAME" = 'purchase'
      ) it
      USING ("EVENT_BUNDLE_SEQUENCE_ID")
      GROUP BY it."item_category"
  )
  ORDER BY "total_tax" / NULLIF("total_revenue",0) DESC
  LIMIT 1
)
SELECT 
  t."ECOMMERCE":"transaction_id"::STRING                                        AS "transaction_id",
  it."item_category",
  SUM(it."item_quantity")                                                      AS "total_item_quantity",
  ep."purchase_revenue_usd",
  ep."tax_usd"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t
JOIN top_category tc
     ON 1=1
JOIN LATERAL (
       SELECT
         i.value:"item_category"::STRING AS "item_category",
         i.value:"quantity"::NUMBER      AS "item_quantity"
       FROM LATERAL FLATTEN(input => t."ITEMS") i
       WHERE i.value:"item_category"::STRING = tc."item_category"
     ) it
     ON TRUE
JOIN LATERAL (
       SELECT
         MAX(CASE WHEN f.value:"key"::STRING = 'tax' 
                  THEN COALESCE(f.value:"value":"double_value",
                                f.value:"value":"int_value") END) AS "tax_usd",
         MAX(CASE WHEN f.value:"key"::STRING IN ('purchase_revenue','value') 
                  THEN COALESCE(f.value:"value":"double_value",
                                f.value:"value":"int_value") END) AS "purchase_revenue_usd"
       FROM LATERAL FLATTEN(input => t."EVENT_PARAMS") f
     ) ep
     ON TRUE
WHERE t."EVENT_NAME" = 'purchase'
GROUP BY 
  t."ECOMMERCE":"transaction_id"::STRING,
  it."item_category",
  ep."purchase_revenue_usd",
  ep."tax_usd"
LIMIT 20;
```
