            THEN COALESCE(f.value:"value":"double_value",
                          f.value:"value":"int_value") END ) AS "tax_usd"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130"  t,
