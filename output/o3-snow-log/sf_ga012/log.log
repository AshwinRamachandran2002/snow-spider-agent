```sql
--Description:  Retrieve, for 30-Nov-2020, every purchase that contains at least one
--              “Electronics Accessories” item and display its transaction_id,
--              total quantity of Electronics-Accessories items in that order,
--              the order-level purchase revenue (“value”) and tax.  We:
--                • flatten ITEMS to filter rows whose item_category = 'Electronics Accessories';
--                • flatten EVENT_PARAMS once, but keep only the keys we need
--                  (transaction_id, value, tax) via an IN-list filter;
--                • use conditional aggregation to pivot those three keys into columns;
--                • group by the event (timestamp + bundle id) so each row = one purchase.
SELECT
       MAX(CASE WHEN ep.value:"key"::STRING = 'transaction_id'
                THEN COALESCE(ep.value:"value":"string_value"::STRING,
                              TO_VARCHAR(ep.value:"value":"int_value"))
           END)                                                        AS "transaction_id",
       SUM(it.value:"quantity"::NUMBER)                                AS "total_item_quantity",
       MAX(CASE WHEN ep.value:"key"::STRING = 'value'
                THEN ep.value:"value":"double_value"::FLOAT
           END)                                                        AS "purchase_revenue_usd",
       MAX(CASE WHEN ep.value:"key"::STRING = 'tax'
                THEN ep.value:"value":"double_value"::FLOAT
           END)                                                        AS "tax_usd"
FROM   GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130"  e
       , LATERAL FLATTEN(
           input => e."EVENT_PARAMS",
           OUTER => FALSE
         ) ep
       , LATERAL FLATTEN(
           input => e."ITEMS",
           OUTER => FALSE
         ) it
WHERE  e."EVENT_NAME" = 'purchase'
  AND  it.value:"item_category"::STRING = 'Electronics Accessories'
  AND  ep.value:"key"::STRING IN ('transaction_id','value','tax')
GROUP  BY
       e."EVENT_TIMESTAMP",
       e."EVENT_BUNDLE_SEQUENCE_ID"
HAVING MAX(CASE WHEN ep.value:"key"::STRING = 'transaction_id'
                THEN 1 END) = 1      -- ensure txn id present
LIMIT 20;
