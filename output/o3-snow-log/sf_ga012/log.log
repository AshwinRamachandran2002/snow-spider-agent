```

```sql
--Description: 7)  Quickly show item_category, quantity and item-level revenue (if any) for a few purchases to understand the ITEM fields.
SELECT
  i.value:"item_category"::STRING        AS "item_category",
  i.value:"quantity"::NUMBER             AS "item_qty",
  i.value:"item_revenue_in_usd"::FLOAT   AS "item_revenue_in_usd"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130",
     LATERAL FLATTEN(input => "ITEMS") i
WHERE "EVENT_NAME" = 'purchase'
LIMIT 20;
```

```sql
--Description: 8)  Aggregate tax and purchase revenue (both in USD) by item category to compute a tax-to-revenue ratio (tax_rate).  
--               This reveals which category has the highest tax_rate.
SELECT
  i.value:"item_category"::STRING                                                                 AS "item_category",
  SUM(ep_tax.value:"value":"double_value"::FLOAT)                                                 AS "total_tax_usd",
  SUM(ep_rev.value:"value":"double_value"::FLOAT)                                                 AS "purchase_revenue_usd",
  SUM(ep_tax.value:"value":"double_value"::FLOAT)
    / NULLIF(SUM(ep_rev.value:"value":"double_value"::FLOAT),0)                                   AS "tax_rate"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
     LATERAL FLATTEN(input => t."ITEMS")             i,
     LATERAL FLATTEN(input => t."EVENT_PARAMS")      ep_tax,
     LATERAL FLATTEN(input => t."EVENT_PARAMS")      ep_rev
WHERE t."EVENT_NAME" = 'purchase'
  AND ep_tax.value:"key"::STRING = 'tax'
  AND ep_rev.value:"key"::STRING IN ('purchase_revenue', 'value', 'value_in_usd')
GROUP BY 1
ORDER BY "tax_rate" DESC
LIMIT 20;
```

```sql
--Description: 9)  List every distinct item_category that occurs on purchase events so we can copy/paste the exact spelling of the top-tax-rate category.
SELECT DISTINCT i.value:"item_category"::STRING AS "item_category"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130",
     LATERAL FLATTEN(input => "ITEMS") i
WHERE "EVENT_NAME" = 'purchase'
LIMIT 20;
```

```sql
--Description: 10)  Pull transaction-level details for the purchases that belong to the category with the highest tax_rate.  
--                  Replace <TOP_CATEGORY> with the category name returned by query 8/9.
SELECT
  tr.value:"value":"string_value"::STRING                                   AS "transaction_id",
  SUM(i.value:"quantity"::NUMBER)                                          AS "total_item_quantity",
  MAX(ep_rev.value:"value":"double_value"::FLOAT)                           AS "purchase_revenue_usd",
  MAX(ep_tax.value:"value":"double_value"::FLOAT)                           AS "tax_usd"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
     LATERAL FLATTEN(input => t."EVENT_PARAMS")      tr,
     LATERAL FLATTEN(input => t."EVENT_PARAMS")      ep_rev,
     LATERAL FLATTEN(input => t."EVENT_PARAMS")      ep_tax,
     LATERAL FLATTEN(input => t."ITEMS")             i
WHERE t."EVENT_NAME" = 'purchase'
  AND tr.value:"key"::STRING        = 'transaction_id'
  AND ep_rev.value:"key"::STRING    IN ('purchase_revenue', 'value', 'value_in_usd')
  AND ep_tax.value:"key"::STRING    = 'tax'
  AND i.value:"item_category"::STRING = '<TOP_CATEGORY>'    -- replace with the actual top category
GROUP BY 1
LIMIT 20;
```
