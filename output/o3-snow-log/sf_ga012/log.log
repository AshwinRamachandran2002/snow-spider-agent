Query:
--Description: 8)  Compute total tax, total purchase value (key = ‘value’), and tax-to-revenue ratio for each item_category in purchase events.
SELECT
       i.value:"item_category"::STRING                                   AS "item_category",
       SUM(ep_tax.value:"value":"double_value"::FLOAT)                   AS "total_tax_usd",
       SUM(ep_val.value:"value":"double_value"::FLOAT)                   AS "purchase_revenue_usd",
       SUM(ep_tax.value:"value":"double_value"::FLOAT)
         / NULLIF( SUM(ep_val.value:"value":"double_value"::FLOAT), 0 )  AS "tax_rate"
FROM   GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130"  e,
       LATERAL FLATTEN(input => e."ITEMS")                i,
       LATERAL FLATTEN(input => e."EVENT_PARAMS")         ep_tax,
       LATERAL FLATTEN(input => e."EVENT_PARAMS")         ep_val
WHERE  e."EVENT_NAME" = 'purchase'
  AND  ep_tax.value:"key"::STRING = 'tax'
  AND  ep_val.value:"key"::STRING = 'value'
GROUP  BY 1
ORDER  BY "tax_rate" DESC
LIMIT 20
