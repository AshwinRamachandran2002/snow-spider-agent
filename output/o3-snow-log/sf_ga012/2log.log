```sql
-- 9) Prototype calculation of tax-rate by item_category for 30-Nov-2020 purchases
SELECT fi.value:"item_category"::STRING                                AS "item_category"
     , SUM( fp_tax.value:"double_value"    ::FLOAT )                  AS "tax_usd"
     , SUM( fp_rev.value:"double_value"    ::FLOAT )                  AS "purchase_revenue_usd"
     , SUM( fp_tax.value:"double_value"    ::FLOAT )
       / NULLIF( SUM( fp_rev.value:"double_value"::FLOAT ), 0 )       AS "tax_rate"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130"       t
     ,LATERAL FLATTEN(input => t."ITEMS")                           fi
     ,LATERAL FLATTEN(input => t."EVENT_PARAMS")                    fp_tax
     ,LATERAL FLATTEN(input => t."EVENT_PARAMS")                    fp_rev
WHERE t."EVENT_NAME" = 'purchase'
  AND fp_tax.value:"key"::STRING ILIKE '%tax%'
  AND fp_rev.value:"key"::STRING ILIKE '%purchase%revenue%usd%'
GROUP BY fi.value:"item_category"::STRING
ORDER BY "tax_rate" DESC
LIMIT 20;
```

```sql
-- 10) Final answer query: pull transaction_id, total_item_quantity, purchase_revenue (raw & usd)
--     for purchase events whose item_category belongs to the highest-tax-rate category
WITH
top_tax_category AS (
    SELECT fi.value:"item_category"::STRING AS item_category
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t
         ,LATERAL FLATTEN(input => t."ITEMS") fi
         ,LATERAL FLATTEN(input => t."EVENT_PARAMS") fp_tax
         ,LATERAL FLATTEN(input => t."EVENT_PARAMS") fp_rev
    WHERE t."EVENT_NAME" = 'purchase'
      AND fp_tax.value:"key"::STRING ILIKE '%tax%'
      AND fp_rev.value:"key"::STRING ILIKE '%purchase%revenue%usd%'
    GROUP BY fi.value:"item_category"::STRING
    ORDER BY
      SUM( fp_tax.value:"double_value"::FLOAT ) /
      NULLIF( SUM( fp_rev.value:"double_value"::FLOAT ), 0 ) DESC
    LIMIT 1
)
SELECT   t."ECOMMERCE":"transaction_id"::STRING                    AS "transaction_id"
       , SUM( fi.value:"quantity"::NUMBER )                        AS "total_item_quantity"
       , fp_rev.value:"double_value"::FLOAT                        AS "purchase_revenue_usd"
       , fp_rev_raw.value:"double_value"::FLOAT                    AS "purchase_revenue_raw"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t
     ,LATERAL FLATTEN(input => t."ITEMS")                         fi
     ,LATERAL FLATTEN(input => t."EVENT_PARAMS")                  fp_rev
     ,LATERAL FLATTEN(input => t."EVENT_PARAMS")                  fp_rev_raw
     ,top_tax_category                                            c
WHERE t."EVENT_NAME" = 'purchase'
  AND fi.value:"item_category"::STRING = c.item_category
  AND fp_rev.value:"key"::STRING      ILIKE '%purchase%revenue%usd%'
  AND fp_rev_raw.value:"key"::STRING  ILIKE '%purchase%revenue%'
GROUP BY t."ECOMMERCE":"transaction_id"::STRING
       , fp_rev.value:"double_value"::FLOAT
       , fp_rev_raw.value:"double_value"::FLOAT
LIMIT 20;
```
