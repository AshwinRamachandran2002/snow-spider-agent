--             purchase_revenue_in_usd from the ECOMMERCE JSON (instead of
--             EVENT_PARAMS) to find the item_category with the highest tax-rate
--             on 30-Nov-2020 purchase events, then lists each purchase in that
--             category with transaction_id, total_item_quantity, purchase
--             revenue (USD) and raw purchase revenue.
WITH item_purchase AS (               -- expand each purchase row into per-item rows
    SELECT
          fi.value:"item_category"::STRING                             AS item_category,
          t."ECOMMERCE":"tax_value_in_usd"        ::FLOAT              AS tax_usd,
          t."ECOMMERCE":"purchase_revenue_in_usd"::FLOAT              AS revenue_usd,
          t."ECOMMERCE":"purchase_revenue"        ::FLOAT              AS purchase_revenue,
          t."ECOMMERCE":"total_item_quantity"     ::NUMBER             AS total_item_quantity,
          t."ECOMMERCE":"transaction_id"          ::STRING             AS transaction_id
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
         LATERAL FLATTEN(input => t."ITEMS") fi
    WHERE t."EVENT_NAME" = 'purchase'
),
top_category AS (                     -- determine which item_category has max tax_rate
    SELECT item_category
    FROM   item_purchase
    GROUP  BY item_category
    ORDER  BY SUM(tax_usd) / NULLIF(SUM(revenue_usd),0) DESC
    LIMIT 1
)
SELECT
       p.transaction_id,
       p.total_item_quantity,
       p.revenue_usd        AS purchase_revenue_in_usd,
       p.purchase_revenue
FROM   item_purchase p
JOIN   top_category  c
       ON p.item_category = c.item_category
LIMIT 20
