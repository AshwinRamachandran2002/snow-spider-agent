     LATERAL FLATTEN(input => t."ITEMS")        i,
     LATERAL FLATTEN(input => t."EVENT_PARAMS") ep,
     top_cat
WHERE t."EVENT_NAME" = 'purchase'
  AND i.value:"item_category"::STRING = top_cat.item_category
