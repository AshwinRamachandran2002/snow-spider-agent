--Description: 7) Calculate total tax, revenue and tax-rate per item_category for 30-Nov-2020 purchases
SELECT  i.value:"item_category"::STRING                 AS "item_category",
        SUM(i.value:"item_tax_in_usd"::FLOAT)           AS "tax_usd",
        SUM(i.value:"item_revenue_in_usd"::FLOAT)       AS "rev_usd",
        CASE
             WHEN SUM(i.value:"item_revenue_in_usd"::FLOAT)=0 THEN NULL
