```

```sql
--Description: 6) Preview purchase ITEM data: item_category, quantity, tax_in_usd, revenue_in_usd
SELECT  t."EVENT_TIMESTAMP",
        i.value:"item_category"::STRING           AS "item_category",
        i.value:"item_quantity"::NUMBER           AS "item_quantity",
        i.value:"item_tax_in_usd"::FLOAT          AS "item_tax_usd",
        i.value:"item_revenue_in_usd"::FLOAT      AS "item_revenue_usd"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
     LATERAL FLATTEN(input => t."ITEMS") i
WHERE t."EVENT_NAME" = 'purchase'
LIMIT 20;
```

```sql
--Description: 7) Compute total tax and purchase revenue (USD) per item_category for 30-Nov-2020
SELECT  i.value:"item_category"::STRING                 AS "item_category",
        SUM(i.value:"item_tax_in_usd"::FLOAT)           AS "tax_usd",
        SUM(i.value:"item_revenue_in_usd"::FLOAT)       AS "rev_usd",
        CASE WHEN SUM(i.value:"item_revenue_in_usd"::FLOAT) = 0 THEN NULL
             ELSE SUM(i.value:"item_tax_in_usd"::FLOAT) /
                  SUM(i.value:"item_revenue_in_usd"::FLOAT)
        END                                             AS "tax_rate"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
     LATERAL FLATTEN(input => t."ITEMS") i
WHERE t."EVENT_NAME" = 'purchase'
GROUP BY 1
ORDER BY "tax_rate" DESC
LIMIT 20;
```

```sql
--Description: 8) Fetch the single item_category that has the highest tax_rate (sub-query)
SELECT  TOP 1 "item_category"
FROM (
       SELECT  i.value:"item_category"::STRING      AS "item_category",
               SUM(i.value:"item_tax_in_usd"::FLOAT) /
               NULLIF(SUM(i.value:"item_revenue_in_usd"::FLOAT),0)  AS "tax_rate"
       FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
            LATERAL FLATTEN(input => t."ITEMS") i
       WHERE t."EVENT_NAME" = 'purchase'
       GROUP BY 1
       ORDER BY "tax_rate" DESC
     )
LIMIT 1;
```

```sql
--Description: 9) For the top-tax-rate category, list each purchase’s transaction_id, total item quantity, purchase tax & revenue in USD
WITH top_cat AS (
    SELECT  TOP 1 i.value:"item_category"::STRING AS "item_category"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
         LATERAL FLATTEN(input => t."ITEMS") i
    WHERE t."EVENT_NAME" = 'purchase'
    GROUP BY 1
    ORDER BY SUM(i.value:"item_tax_in_usd"::FLOAT) / 
             NULLIF(SUM(i.value:"item_revenue_in_usd"::FLOAT),0) DESC
)
SELECT  t."EVENT_TIMESTAMP",
        MAX(CASE WHEN ep."key" = 'transaction_id' THEN ep.value:"string_value" END) AS "transaction_id",
        SUM(i.value:"item_quantity"::NUMBER)                                        AS "total_item_quantity",
        SUM(i.value:"item_tax_in_usd"::FLOAT)                                       AS "purchase_tax_usd",
        SUM(i.value:"item_revenue_in_usd"::FLOAT)                                   AS "purchase_revenue_usd"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
     LATERAL FLATTEN(input => t."ITEMS")          i,
     LATERAL FLATTEN(input => t."EVENT_PARAMS")   ep,
     top_cat
WHERE t."EVENT_NAME" = 'purchase'
  AND i.value:"item_category"::STRING = top_cat."item_category"
GROUP BY t."EVENT_TIMESTAMP"
LIMIT 20;
```

```sql
--Description: 10) Final answer – present the required fields for every purchase of the highest-tax-rate category on 30-Nov-2020
