```sql
--Description / thinking process:
--Objective: For the highest-tax-rate category (identified on 30-Nov-2020), list each purchase with
--its transaction_id, total quantity, tax-USD and revenue-USD.  Steps:
-- 1. Calculate which item_category has the greatest tax/revenue ratio (CTE top_cat).
-- 2. Filter purchase events whose items belong to that category.
-- 3. Flatten ITEMS to sum quantities, tax and revenue; flatten EVENT_PARAMS to extract the
--    transaction_id (ep.key = 'transaction_id', then grab ep.value:"string_value").
-- 4. Group by the transaction_id so each output row represents one purchase.
WITH top_cat AS (
    SELECT  item_category
    FROM (
        SELECT  i.value:"item_category"::STRING AS item_category,
                SUM(i.value:"item_tax_in_usd"::FLOAT) /
                SUM(i.value:"item_revenue_in_usd"::FLOAT) AS tax_rate
        FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
             LATERAL FLATTEN(input => t."ITEMS") i
        WHERE t."EVENT_NAME" = 'purchase'
        GROUP BY 1
        HAVING SUM(i.value:"item_revenue_in_usd"::FLOAT) > 0
        ORDER BY tax_rate DESC
        LIMIT 1
    )
)
SELECT  
        MAX(CASE WHEN ep.key = 'transaction_id'
                 THEN ep.value:"string_value" END)           AS "transaction_id",
        SUM(i.value:"item_quantity"::NUMBER)                 AS "total_quantity",
        SUM(i.value:"item_tax_in_usd"::FLOAT)                AS "tax_usd",
        SUM(i.value:"item_revenue_in_usd"::FLOAT)            AS "purchase_revenue_usd",
        SUM(i.value:"item_tax_in_usd"::FLOAT) / 
        NULLIF(SUM(i.value:"item_revenue_in_usd"::FLOAT),0)  AS "tax_rate"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t
     -- flatten items & params
     , LATERAL FLATTEN(input => t."ITEMS")        i
     , LATERAL FLATTEN(input => t."EVENT_PARAMS") ep
     , top_cat
WHERE t."EVENT_NAME" = 'purchase'
  AND i.value:"item_category"::STRING = top_cat.item_category
GROUP BY ep.value:"string_value"
LIMIT 20;
```
