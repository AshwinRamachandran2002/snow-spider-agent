    ORDER BY SUM(i.value:"item_tax_in_usd"::FLOAT) /
             SUM(i.value:"item_revenue_in_usd"::FLOAT) DESC
    LIMIT 1
)
SELECT  MAX(CASE WHEN ep.key = 'transaction_id'
                 THEN ep.value:"string_value" END)        AS "transaction_id",
        SUM(i.value:"item_quantity"::NUMBER)              AS "total_quantity",
        SUM(i.value:"item_tax_in_usd"::FLOAT) /
