```sql
--Description: Calculate event-level tax rate for every purchase on 2020-11-30,
--             returning timestamp, tax (USD), purchase revenue (USD),
--             transaction-id, item_category, and tax_rate.  Includes
--             both timestamp and EVENT_VALUE_IN_USD in the GROUP BY to keep
--             one row per event.
SELECT  t."EVENT_TIMESTAMP",
        MIN(CASE WHEN f.value:"key"::STRING = 'tax'
                 THEN f.value:"value":"double_value"::FLOAT END)                    AS "tax_usd",
        t."EVENT_VALUE_IN_USD"                                                      AS "purchase_revenue_usd",
        MIN(CASE WHEN f.value:"key"::STRING = 'transaction_id'
                 THEN f.value:"value":"string_value"::STRING END)                   AS "transaction_id",
        MAX(i.value:"item_category"::STRING)                                        AS "item_category",
        MIN(CASE WHEN f.value:"key"::STRING = 'tax'
                 THEN f.value:"value":"double_value"::FLOAT END)
/ NULLIF(t."EVENT_VALUE_IN_USD",0)                                                  AS "tax_rate"
FROM    GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
        LATERAL FLATTEN(input => t."EVENT_PARAMS")            f,
        LATERAL FLATTEN(input => t."ITEMS")                   i
WHERE   t."EVENT_NAME" = 'purchase'
GROUP BY t."EVENT_TIMESTAMP", t."EVENT_VALUE_IN_USD"
LIMIT 20;
```

```sql
--Description: Build an event-level subquery of purchase events (timestamp + revenue
--             used in GROUP BY).  Then aggregate by item_category to get overall
--             tax_rate per category and number of events, ordered by highest rate.
WITH purchase_events AS (
    SELECT  t."EVENT_TIMESTAMP",
            MAX(i.value:"item_category"::STRING)                                   AS "item_category",
            MIN(CASE WHEN f.value:"key"::STRING = 'tax'
                     THEN f.value:"value":"double_value"::FLOAT END)               AS "tax_usd",
            t."EVENT_VALUE_IN_USD"                                                 AS "purchase_revenue_usd"
    FROM    GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
            LATERAL FLATTEN(input => t."EVENT_PARAMS")            f,
            LATERAL FLATTEN(input => t."ITEMS")                   i
    WHERE   t."EVENT_NAME" = 'purchase'
    GROUP BY t."EVENT_TIMESTAMP", t."EVENT_VALUE_IN_USD"
)
SELECT  "item_category",
        SUM("tax_usd") / NULLIF(SUM("purchase_revenue_usd"),0)  AS "tax_rate",
        COUNT(*)                                                AS "num_events"
FROM    purchase_events
GROUP BY "item_category"
ORDER BY "tax_rate" DESC
LIMIT 20;
```

```sql
--Description: Identify the single item_category with the highest overall tax_rate
--             on 2020-11-30.  Uses the same purchase_events CTE (timestamp + revenue
--             in GROUP BY) and selects the top category via ROW_NUMBER / ORDER BY.
WITH purchase_events AS (
    SELECT  t."EVENT_TIMESTAMP",
            MAX(i.value:"item_category"::STRING)                                   AS "item_category",
            MIN(CASE WHEN f.value:"key"::STRING = 'tax'
                     THEN f.value:"value":"double_value"::FLOAT END)               AS "tax_usd",
            t."EVENT_VALUE_IN_USD"                                                 AS "purchase_revenue_usd"
    FROM    GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
            LATERAL FLATTEN(input => t."EVENT_PARAMS")            f,
            LATERAL FLATTEN(input => t."ITEMS")                   i
    WHERE   t."EVENT_NAME" = 'purchase'
    GROUP BY t."EVENT_TIMESTAMP", t."EVENT_VALUE_IN_USD"
)
SELECT  "item_category",
        SUM("tax_usd") / NULLIF(SUM("purchase_revenue_usd"),0)  AS "tax_rate"
FROM    purchase_events
GROUP BY "item_category"
QUALIFY ROW_NUMBER() OVER (ORDER BY SUM("tax_usd")/NULLIF(SUM("purchase_revenue_usd"),0) DESC) = 1;
```

```sql
--Description: For every purchase event gather transaction_id, total quantity of items,
--             purchase revenue in USD, and purchase_revenue parameter (if present).
--             GROUP BY timestamp + revenue to keep one row per event.
SELECT  t."EVENT_TIMESTAMP",
        MIN(CASE WHEN f.value:"key"::STRING = 'transaction_id'
                 THEN f.value:"value":"string_value"::STRING END)                 AS "transaction_id",
        SUM(i.value:"quantity"::NUMBER)                                           AS "total_item_qty",
        t."EVENT_VALUE_IN_USD"                                                    AS "purchase_revenue_usd",
        MIN(CASE WHEN f.value:"key"::STRING = 'purchase_revenue'
                 THEN f.value:"value":"double_value"::FLOAT END)                  AS "purchase_revenue"
FROM    GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
        LATERAL FLATTEN(input => t."EVENT_PARAMS")            f,
        LATERAL FLATTEN(input => t."ITEMS")                   i
WHERE   t."EVENT_NAME" = 'purchase'
GROUP BY t."EVENT_TIMESTAMP", t."EVENT_VALUE_IN_USD"
LIMIT 20;
```

```sql
--Description: Return all purchase events that belong to the item_category with the
--             highest overall tax_rate (determined in ranked_category).  Uses a
--             purchase_events CTE (timestamp + revenue in GROUP BY) to compute
--             event-level metrics, then filters by the top-tax-rate category.
WITH purchase_events AS (
    SELECT  t."EVENT_TIMESTAMP",
            MIN(CASE WHEN f.value:"key"::STRING = 'transaction_id'
                     THEN f.value:"value":"string_value"::STRING END)             AS "transaction_id",
            SUM(i.value:"quantity"::NUMBER)                                       AS "total_item_qty",
            MIN(CASE WHEN f.value:"key"::STRING = 'tax'
                     THEN f.value:"value":"double_value"::FLOAT END)              AS "tax_usd",
            t."EVENT_VALUE_IN_USD"                                                AS "purchase_revenue_usd",
            MIN(CASE WHEN f.value:"key"::STRING = 'purchase_revenue'
                     THEN f.value:"value":"double_value"::FLOAT END)              AS "purchase_revenue",
            MAX(i.value:"item_category"::STRING)                                  AS "item_category"
    FROM    GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
            LATERAL FLATTEN(input => t."EVENT_PARAMS")            f,
            LATERAL FLATTEN(input => t."ITEMS")                   i
    WHERE   t."EVENT_NAME" = 'purchase'
    GROUP BY t."EVENT_TIMESTAMP", t."EVENT_VALUE_IN_USD"
), ranked_category AS (
    SELECT  "item_category"
    FROM    purchase_events
    GROUP BY "item_category"
    ORDER BY SUM("tax_usd") / NULLIF(SUM("purchase_revenue_usd"),0) DESC
    LIMIT 1
)
SELECT  p."transaction_id",
        p."total_item_qty",
        p."purchase_revenue_usd",
        p."purchase_revenue"
FROM    purchase_events  p
