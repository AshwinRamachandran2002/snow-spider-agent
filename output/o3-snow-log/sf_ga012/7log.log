```sql
--10.  Final step – get all purchase events that belong to the highest-tax-rate item_category
WITH purchase_events AS (
    SELECT  t."EVENT_TIMESTAMP"
          , MIN(CASE WHEN f.value:"key"::STRING='transaction_id' THEN f.value:"value":"string_value"::STRING END)
                                                                                                  AS "transaction_id"
          , SUM(i.value:"quantity"::NUMBER)                                                       AS "total_item_qty"
          , MIN(CASE WHEN f.value:"key"::STRING='tax'          THEN f.value:"value":"double_value"::FLOAT END)  AS "tax_usd"
          , t."EVENT_VALUE_IN_USD"                                                                AS "purchase_revenue_usd"
          , MIN(CASE WHEN f.value:"key"::STRING='purchase_revenue' THEN f.value:"value":"double_value"::FLOAT END)
                                                                                                  AS "purchase_revenue"
          , MAX(i.value:"item_category"::STRING)                                                  AS "item_category"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130"  t
         , LATERAL FLATTEN(input => t."EVENT_PARAMS")           f
         , LATERAL FLATTEN(input => t."ITEMS")                  i
    WHERE t."EVENT_NAME" = 'purchase'
    GROUP BY t."EVENT_TIMESTAMP", t."EVENT_VALUE_IN_USD"
), ranked_category AS (
    SELECT  "item_category"
    FROM    purchase_events
    GROUP BY "item_category"
    ORDER BY SUM("tax_usd")/NULLIF(SUM("purchase_revenue_usd"),0) DESC
    LIMIT 1
)
SELECT  p."transaction_id"
      , p."total_item_qty"
      , p."purchase_revenue_usd"
      , p."purchase_revenue"
FROM purchase_events          p
JOIN ranked_category          r   ON p."item_category" = r."item_category"
LIMIT 20;
```
