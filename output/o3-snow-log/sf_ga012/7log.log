--Description: For each individual purchase event on 2020-11-30, pull the transaction-id,
--             total quantity of items, tax amount, purchase revenue in USD, and compute the
--             event-level tax-rate (tax / revenue).  We:
--               • Flatten EVENT_PARAMS to pick up “tax” and “transaction_id”.
--               • Flatten ITEMS to sum “quantity”.
--               • Group by EVENT_TIMESTAMP and EVENT_VALUE_IN_USD so every row = one event.
--             Result lets us later aggregate by item_category to find the highest-tax-rate
--             category.
SELECT  t."EVENT_TIMESTAMP",
        MIN(CASE WHEN f.value:"key"::STRING = 'transaction_id'
                 THEN f.value:"value":"string_value"::STRING END)                AS "transaction_id",
        SUM(i.value:"quantity"::NUMBER)                                          AS "total_item_qty",
        MIN(CASE WHEN f.value:"key"::STRING = 'tax'
                 THEN f.value:"value":"double_value"::FLOAT END)                 AS "tax_usd",
        t."EVENT_VALUE_IN_USD"                                                   AS "purchase_revenue_usd",
        MIN(CASE WHEN f.value:"key"::STRING = 'tax'
                 THEN f.value:"value":"double_value"::FLOAT END)
/ NULLIF(t."EVENT_VALUE_IN_USD", 0)                                              AS "tax_rate"
FROM    GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201130" t,
        LATERAL FLATTEN(input => t."EVENT_PARAMS")            f,
        LATERAL FLATTEN(input => t."ITEMS")                   i
WHERE   t."EVENT_NAME" = 'purchase'
GROUP BY t."EVENT_TIMESTAMP", t."EVENT_VALUE_IN_USD"
LIMIT 20;
