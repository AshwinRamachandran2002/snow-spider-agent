--Description: ⑩ Compute the Home-to-Confirmation conversion rate for 2-Jan-2021 using the updated confirmation
--keyword pattern (URL or title contains “confirm”, “thank”, or “order”).
WITH home AS (
    SELECT DISTINCT
           gses.value:"value":"int_value"::NUMBER AS "ga_session_id"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") gloc,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") gses
    WHERE t."EVENT_NAME" = 'page_view'
      AND gloc.value:"key"::STRING  = 'page_location'
      AND gloc.value:"value":"string_value"::STRING ILIKE '%shop.googlemerchandisestore.com/%'
      AND gses.value:"key"::STRING  = 'ga_session_id'
),
confirm AS (
    SELECT DISTINCT
           gses.value:"value":"int_value"::NUMBER AS "ga_session_id"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") gloc,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") gtitle,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") gses
    WHERE t."EVENT_NAME" = 'page_view'
      AND gses.value:"key"::STRING = 'ga_session_id'
      AND (
            (gloc.value:"key"::STRING  = 'page_location' AND 
             (gloc.value:"value":"string_value"::STRING ILIKE '%confirm%'
              OR gloc.value:"value":"string_value"::STRING ILIKE '%thank%'
              OR gloc.value:"value":"string_value"::STRING ILIKE '%order%'))
         OR (gtitle.value:"key"::STRING = 'page_title'    AND
             (gtitle.value:"value":"string_value"::STRING ILIKE '%confirm%'
              OR gtitle.value:"value":"string_value"::STRING ILIKE '%thank%'
              OR gtitle.value:"value":"string_value"::STRING ILIKE '%order%'))
          )
),
both AS (
    SELECT h."ga_session_id"
    FROM home h
    JOIN confirm c USING ("ga_session_id")
)
SELECT
    (COUNT(DISTINCT b."ga_session_id") * 100.0)
         / NULLIF(COUNT(DISTINCT h."ga_session_id"), 0) AS "conversion_rate_percent"
FROM home h
LEFT JOIN both b USING ("ga_session_id")
LIMIT 20
