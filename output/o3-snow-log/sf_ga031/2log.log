```sql
--Description: ⑨ Count how many unique sessions landed on Home and how many of those also made it to Checkout Confirmation.
WITH home AS (
    SELECT DISTINCT gses.value:"value":"int_value"::NUMBER AS "ga_session_id"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
    LATERAL FLATTEN(input => t."EVENT_PARAMS") gloc,
    LATERAL FLATTEN(input => t."EVENT_PARAMS") gses
    WHERE t."EVENT_NAME" = 'page_view'
      AND gloc.value:"key"::STRING = 'page_location'
      AND gloc.value:"value":"string_value"::STRING ILIKE '%shop.googlemerchandisestore.com/%'
      AND gses.value:"key"::STRING = 'ga_session_id'
), chk AS (
    SELECT DISTINCT gses.value:"value":"int_value"::NUMBER AS "ga_session_id"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
    LATERAL FLATTEN(input => t."EVENT_PARAMS") gloc,
    LATERAL FLATTEN(input => t."EVENT_PARAMS") gses
    WHERE t."EVENT_NAME" = 'page_view'
      AND gloc.value:"key"::STRING = 'page_location'
      AND gloc.value:"value":"string_value"::STRING ILIKE '%/checkout%confirmation%'
      AND gses.value:"key"::STRING = 'ga_session_id'
), both AS (
    SELECT h."ga_session_id"
    FROM home h
    JOIN chk c ON h."ga_session_id" = c."ga_session_id"
)
SELECT 
    (SELECT COUNT(*) FROM home)               AS "home_sessions",
    (SELECT COUNT(*) FROM both)               AS "converting_sessions"
LIMIT 20;
```

```sql
--Description: ⑩ Calculate the Home-to-Checkout-Confirmation conversion rate on 2-Jan-2021 (percentage of sessions).
WITH home AS (
    SELECT DISTINCT gses.value:"value":"int_value"::NUMBER AS "ga_session_id"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
    LATERAL FLATTEN(input => t."EVENT_PARAMS") gloc,
    LATERAL FLATTEN(input => t."EVENT_PARAMS") gses
    WHERE t."EVENT_NAME" = 'page_view'
      AND gloc.value:"key"::STRING = 'page_location'
      AND gloc.value:"value":"string_value"::STRING ILIKE '%shop.googlemerchandisestore.com/%'
      AND gses.value:"key"::STRING = 'ga_session_id'
), chk AS (
    SELECT DISTINCT gses.value:"value":"int_value"::NUMBER AS "ga_session_id"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
    LATERAL FLATTEN(input => t."EVENT_PARAMS") gloc,
    LATERAL FLATTEN(input => t."EVENT_PARAMS") gses
    WHERE t."EVENT_NAME" = 'page_view'
      AND gloc.value:"key"::STRING = 'page_location'
      AND gloc.value:"value":"string_value"::STRING ILIKE '%/checkout%confirmation%'
      AND gses.value:"key"::STRING = 'ga_session_id'
), both AS (
    SELECT h."ga_session_id"
    FROM home h
    JOIN chk c ON h."ga_session_id" = c."ga_session_id"
)
SELECT 
    (COUNT(DISTINCT b."ga_session_id") * 100.0) / NULLIF(COUNT(DISTINCT h."ga_session_id"),0) 
      AS "conversion_rate_percent"
FROM home h
LEFT JOIN both b 
  ON h."ga_session_id" = b."ga_session_id"
LIMIT 20;
```
