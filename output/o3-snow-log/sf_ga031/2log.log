--Description: ⑧ Show those sessions that visited BOTH Home AND Checkout Confirmation on the same day (inner join of the two sets).
WITH home AS (
    SELECT DISTINCT gses.value:"value":"int_value"::NUMBER AS "ga_session_id"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
    LATERAL FLATTEN(input => t."EVENT_PARAMS") gloc,
    LATERAL FLATTEN(input => t."EVENT_PARAMS") gses
    WHERE t."EVENT_NAME" = 'page_view'
      AND gloc.value:"key"::STRING = 'page_location'
      AND gloc.value:"value":"string_value"::STRING ILIKE '%shop.googlemerchandisestore.com/%'
      AND gses.value:"key"::STRING = 'ga_session_id'
), chk AS (
    SELECT DISTINCT gses.value:"value":"int_value"::NUMBER AS "ga_session_id"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
    LATERAL FLATTEN(input => t."EVENT_PARAMS") gloc,
    LATERAL FLATTEN(input => t."EVENT_PARAMS") gses
    WHERE t."EVENT_NAME" = 'page_view'
      AND gloc.value:"key"::STRING = 'page_location'
      AND gloc.value:"value":"string_value"::STRING ILIKE '%/checkout%confirmation%'
      AND gses.value:"key"::STRING = 'ga_session_id'
)
SELECT *
FROM home
JOIN chk USING ("ga_session_id")
LIMIT 20;
