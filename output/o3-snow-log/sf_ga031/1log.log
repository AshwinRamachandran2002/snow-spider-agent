```sql
--Description / Thinking process:
--Compute the 2-Jan-2021 session conversion-rate (Home → checkout-phase) in one efficient pass.
--Key performance idea: instead of fully flattening EVENT_PARAMS and grouping,
--extract the two needed parameters (ga_session_id and page_location) with
--two tiny lateral sub-queries per event row, so we scan each VARIANT array only twice.
--Steps
-- 1. base        : one row per page_view with its session id & URL.
-- 2. home_sessions     : sessions that hit the Home page (root or store.html).
-- 3. checkout_sessions : sessions that hit any checkout-phase URL fragment
--                        (checkout / confirm / basket / yourinfo / thank / order).
-- 4. both_sessions     : intersection of the two sets.
-- 5. Final select returns counts and percentage.
WITH base AS (
    SELECT
        t."USER_PSEUDO_ID",
        /* grab ga_session_id */
        ( SELECT f.value:"int_value"::NUMBER
          FROM   LATERAL FLATTEN(input => t."EVENT_PARAMS") f
          WHERE  f.value:"key"::STRING = 'ga_session_id'
          LIMIT  1 )                                       AS "ga_session_id",
        /* grab page_location */
        ( SELECT f.value:"string_value"::STRING
          FROM   LATERAL FLATTEN(input => t."EVENT_PARAMS") f
          WHERE  f.value:"key"::STRING = 'page_location'
          LIMIT  1 )                                       AS "page_location"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t
    WHERE t."EVENT_NAME" = 'page_view'
),
home_sessions AS (
    SELECT DISTINCT "ga_session_id"
    FROM   base
    WHERE  "page_location" = 'https://shop.googlemerchandisestore.com/'
       OR  "page_location" ILIKE '%/store.html'
),
checkout_sessions AS (
    SELECT DISTINCT "ga_session_id"
    FROM   base
    WHERE  "page_location" ILIKE '%checkout%'
        OR "page_location" ILIKE '%confirm%'
        OR "page_location" ILIKE '%basket%'
        OR "page_location" ILIKE '%yourinfo%'
        OR "page_location" ILIKE '%thank%'
        OR "page_location" ILIKE '%order%'
),
both_sessions AS (
    SELECT h."ga_session_id"
    FROM   home_sessions h
    JOIN   checkout_sessions c
      ON   h."ga_session_id" = c."ga_session_id"
)
SELECT
    (SELECT COUNT(*) FROM home_sessions)               AS "home_session_cnt",
    (SELECT COUNT(*) FROM both_sessions)               AS "converted_session_cnt",
    (SELECT COUNT(*) FROM both_sessions) * 100.0 /
    NULLIF((SELECT COUNT(*) FROM home_sessions), 0)    AS "conversion_rate_pct";
```
