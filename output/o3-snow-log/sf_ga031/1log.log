```sql
--Description / Thinking process:
--Goal:  For 2021-01-02 calculate the conversion-rate of GA4 sessions that
--       viewed the Home page and, during the same session, reached any
--       checkout-phase page (URL contains: checkout, confirm, basket,
--       yourinfo, thank, or order).
--
--Plan
--1. base           : flatten EVENT_PARAMS once per page_view; pull out
--                    ga_session_id and page_location via MAX(CASE …).
--2. session_flags  : aggregate base to the session level, setting two
--                    Booleans with MAX(CASE …):
--                       has_home     – session hit root URL or store.html
--                       has_checkout – session hit any checkout keyword
--3. Final SELECT   : use COUNT_IF to count
--                       • sessions with has_home  (denominator)
--                       • sessions with both flags (numerator)
--                    and compute the percentage.  No scalar subqueries,
--                    so it avoids previous compilation errors.

WITH base AS (
    SELECT
        MAX(CASE WHEN f.value:"key"::STRING = 'ga_session_id'
                 THEN f.value:"value":"int_value"::NUMBER END)   AS ga_session_id,
        MAX(CASE WHEN f.value:"key"::STRING = 'page_location'
                 THEN f.value:"value":"string_value"::STRING END) AS page_location
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE t."EVENT_NAME" = 'page_view'
    GROUP BY t."USER_PSEUDO_ID", t."EVENT_TIMESTAMP"   -- one row per page_view
),
session_flags AS (
    SELECT
        ga_session_id,
        MAX(CASE
              WHEN page_location = 'https://shop.googlemerchandisestore.com/'
                   OR page_location ILIKE '%/store.html'
              THEN 1 ELSE 0 END) = 1                        AS has_home,
        MAX(CASE
              WHEN page_location ILIKE '%checkout%'
                   OR page_location ILIKE '%confirm%'
                   OR page_location ILIKE '%basket%'
                   OR page_location ILIKE '%yourinfo%'
                   OR page_location ILIKE '%thank%'
                   OR page_location ILIKE '%order%'
              THEN 1 ELSE 0 END) = 1                        AS has_checkout
    FROM base
    GROUP BY ga_session_id
)
SELECT
    COUNT_IF(has_home)                           AS home_session_cnt,
    COUNT_IF(has_home AND has_checkout)          AS converted_session_cnt,
    CASE WHEN COUNT_IF(has_home) = 0
         THEN NULL
         ELSE COUNT_IF(has_home AND has_checkout) * 100.0
              / COUNT_IF(has_home)
    END                                          AS conversion_rate_pct
FROM session_flags;
```
