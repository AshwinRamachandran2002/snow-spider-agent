```sql
--Description / Thinking process:
--Compute the 02-Jan-2021 conversion-rate for GA4 sessions that
--(a) viewed the Home page (root URL or “store.html”) and
--(b) in the same session reached any “checkout-phase” URL
--    (keywords: checkout, confirm, basket, yourinfo, thank, order).
--
--Performance / simplicity:
--1. “base”  → flatten EVENT_PARAMS once, pull ga_session_id & page_location via MAX(CASE…).
--2. “session_flags” → roll up to one row per session with two booleans:
--      has_home, has_checkout.
--3. Final SELECT counts sessions with those flags and calculates the %
--   using COUNT_IF (Snowflake aggregate that counts TRUE rows).  No nested
--   scalar subqueries, so we avoid the previous “unsupported subquery” error.

WITH base AS (
    SELECT
        MAX(CASE WHEN f.value:"key"::STRING = 'ga_session_id'
                 THEN f.value:"value":"int_value"::NUMBER END)   AS ga_session_id,
        MAX(CASE WHEN f.value:"key"::STRING = 'page_location'
                 THEN f.value:"value":"string_value"::STRING END) AS page_location
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE t."EVENT_NAME" = 'page_view'
    GROUP BY t."EVENT_TIMESTAMP", t."USER_PSEUDO_ID"   -- one row per page_view
),
session_flags AS (
    SELECT
        ga_session_id,
        BOOLOR(   page_location = 'https://shop.googlemerchandisestore.com/'
               OR page_location ILIKE '%/store.html' )                                       AS has_home,
        BOOLOR(   page_location ILIKE '%checkout%'
               OR page_location ILIKE '%confirm%'
               OR page_location ILIKE '%basket%'
               OR page_location ILIKE '%yourinfo%'
               OR page_location ILIKE '%thank%'
               OR page_location ILIKE '%order%' )                                           AS has_checkout
    FROM base
    GROUP BY ga_session_id
)
SELECT
    COUNT_IF(has_home)                                AS home_session_cnt,
    COUNT_IF(has_home AND has_checkout)               AS converted_session_cnt,
    CASE WHEN COUNT_IF(has_home) = 0
         THEN NULL
         ELSE COUNT_IF(has_home AND has_checkout) * 100.0 / COUNT_IF(has_home)
    END                                               AS conversion_rate_pct
FROM session_flags;
```
