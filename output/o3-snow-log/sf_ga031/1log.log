```sql
--Description: Calculate session-level conversion rate (Home → Checkout Confirm) for 2-Jan-2021.
WITH base AS (
  SELECT 
    t."USER_PSEUDO_ID",
    f_id.value:"value":"int_value"::NUMBER     AS "ga_session_id",
    f_loc.value:"value":"string_value"::STRING AS "page_location"
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
       LATERAL FLATTEN(input => t."EVENT_PARAMS") f_id,
       LATERAL FLATTEN(input => t."EVENT_PARAMS") f_loc
  WHERE t."EVENT_NAME" = 'page_view'
    AND f_id.value:"key"::STRING  = 'ga_session_id'
    AND f_loc.value:"key"::STRING = 'page_location'
)
, home_sessions AS (
  SELECT DISTINCT "ga_session_id"
  FROM base
  WHERE "page_location" ILIKE '%shop.googlemerchandisestore.com/%'
)
, checkout_sessions AS (
  SELECT DISTINCT "ga_session_id"
  FROM base
  WHERE "page_location" ILIKE '%confirm%'
)
, both_sessions AS (
  SELECT h."ga_session_id"
  FROM home_sessions h
  JOIN checkout_sessions c
    ON h."ga_session_id" = c."ga_session_id"
)
SELECT 
  (SELECT COUNT(*) FROM home_sessions)               AS "home_session_cnt",
  (SELECT COUNT(*) FROM both_sessions)               AS "converted_session_cnt",
  (SELECT COUNT(*) FROM both_sessions)*100.0 /
  NULLIF((SELECT COUNT(*) FROM home_sessions),0)     AS "conversion_rate_pct"
LIMIT 20;
```

