```sql
--Description: Sessions that have BOTH Home and Checkout page_views (simple intersection check)
SELECT DISTINCT s_home."ga_session_id"
FROM
  (SELECT DISTINCT f2.value:"int_value"::NUMBER AS "ga_session_id"
   FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t,
        LATERAL FLATTEN(input => t."EVENT_PARAMS") f1,
        LATERAL FLATTEN(input => t."EVENT_PARAMS") f2
   WHERE t."EVENT_NAME" = 'page_view'
     AND f1.value:"key"::STRING = 'page_location'
     AND f1.value:"string_value"::STRING ILIKE '%/shop.googlemerchandisestore.com/%home%'
     AND f2.value:"key"::STRING = 'ga_session_id')      s_home
JOIN
  (SELECT DISTINCT f2.value:"int_value"::NUMBER AS "ga_session_id"
   FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t,
        LATERAL FLATTEN(input => t."EVENT_PARAMS") f1,
        LATERAL FLATTEN(input => t."EVENT_PARAMS") f2
   WHERE t."EVENT_NAME" = 'page_view'
     AND f1.value:"key"::STRING = 'page_location'
     AND f1.value:"string_value"::STRING ILIKE '%checkout%'
     AND f2.value:"key"::STRING = 'ga_session_id')      s_checkout
ON  s_home."ga_session_id" = s_checkout."ga_session_id"
LIMIT 20;
```

