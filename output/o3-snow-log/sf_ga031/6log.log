--Description:  A different way to discover the checkout-confirmation view is to look only at sessions that actually contain a
--“purchase” event on 2021-01-02 and list every page_view (title + URL) seen in those same sessions.
--Whatever page appears consistently in purchase sessions but not elsewhere is a strong candidate for the
--confirmation page.  This query therefore:
--  1. collects all ga_session_id values that have a “purchase” event;
--  2. pulls the distinct page_title and page_location from page_view events that belong to those sessions.
--Inspecting the result will reveal the confirmation-page URL or title to use in the conversion-rate calculation.
SELECT DISTINCT
       pv_title.value:"string_value"::STRING AS "page_title",
       pv_loc.value:"string_value"::STRING   AS "page_location"
FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102"   t_view
     ,LATERAL FLATTEN(input => t_view."EVENT_PARAMS")            pv_sid
     ,LATERAL FLATTEN(input => t_view."EVENT_PARAMS")            pv_title
     ,LATERAL FLATTEN(input => t_view."EVENT_PARAMS")            pv_loc
WHERE t_view."EVENT_NAME" = 'page_view'
  AND pv_sid.value:"key"::STRING   = 'ga_session_id'
  AND pv_title.value:"key"::STRING = 'page_title'
  AND pv_loc.value:"key"::STRING   = 'page_location'
  AND pv_sid.value:"int_value"::NUMBER IN (
        SELECT DISTINCT
               pur_sid.value:"int_value"::NUMBER
        FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102"  t_pur
             ,LATERAL FLATTEN(input => t_pur."EVENT_PARAMS")            pur_sid
        WHERE t_pur."EVENT_NAME" = 'purchase'
          AND pur_sid.value:"key"::STRING = 'ga_session_id'
      )
LIMIT 50;
