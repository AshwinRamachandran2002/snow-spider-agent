```sql
--Description: 8) List distinct sessions (ga_session_id) that had a Home page_view.
SELECT DISTINCT  
       s.value:"value":"int_value"::NUMBER AS "GA_SESSION_ID"
FROM   "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t
       ,LATERAL FLATTEN( input => t."EVENT_PARAMS") p
       ,LATERAL FLATTEN( input => t."EVENT_PARAMS") s
WHERE  t."EVENT_NAME" = 'page_view'
  AND  p.value:"key"::STRING = 'page_title'
  AND  p.value:"value":"string_value"::STRING ILIKE '%home%'
  AND  s.value:"key"::STRING = 'ga_session_id'
LIMIT 20;
```

```sql
--Description: 9) List distinct sessions that had BOTH Home and Checkout-Confirmation page views.
WITH base AS (
  SELECT  
         s.value:"value":"int_value"::NUMBER AS "GA_SESSION_ID",
         p.value:"value":"string_value"::STRING AS "PAGE_TITLE"
  FROM   "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t
         ,LATERAL FLATTEN( input => t."EVENT_PARAMS") p
         ,LATERAL FLATTEN( input => t."EVENT_PARAMS") s
  WHERE  t."EVENT_NAME" = 'page_view'
    AND  p.value:"key"::STRING = 'page_title'
    AND  s.value:"key"::STRING = 'ga_session_id'
)
SELECT DISTINCT "GA_SESSION_ID"
FROM   base
GROUP  BY "GA_SESSION_ID"
HAVING MAX( CASE WHEN "PAGE_TITLE" ILIKE '%home%'                        THEN 1 ELSE 0 END ) = 1
   AND MAX( CASE WHEN "PAGE_TITLE" ILIKE '%checkout%confirmation%' THEN 1 ELSE 0 END ) = 1
LIMIT 20;
```

```sql
--Description: 10) Compute the conversion rate:  (#sessions with Home AND Confirmation) / (#sessions with Home) × 100.
WITH sessions_with_home AS (
  SELECT  
         s.value:"value":"int_value"::NUMBER AS "GA_SESSION_ID"
  FROM   "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t
         ,LATERAL FLATTEN( input => t."EVENT_PARAMS") p
         ,LATERAL FLATTEN( input => t."EVENT_PARAMS") s
  WHERE  t."EVENT_NAME" = 'page_view'
    AND  p.value:"key"::STRING = 'page_title'
    AND  p.value:"value":"string_value"::STRING ILIKE '%home%'
    AND  s.value:"key"::STRING = 'ga_session_id'
  GROUP BY 1
),
sessions_with_home_and_conf AS (
  SELECT  
         s.value:"value":"int_value"::NUMBER AS "GA_SESSION_ID"
  FROM   "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t
         ,LATERAL FLATTEN( input => t."EVENT_PARAMS") p
         ,LATERAL FLATTEN( input => t."EVENT_PARAMS") s
  WHERE  t."EVENT_NAME" = 'page_view'
    AND  p.value:"key"::STRING = 'page_title'
    AND  s.value:"key"::STRING = 'ga_session_id'
  GROUP BY 1
  HAVING MAX( CASE WHEN p.value:"value":"string_value"::STRING ILIKE '%home%'                        THEN 1 ELSE 0 END ) = 1
     AND MAX( CASE WHEN p.value:"value":"string_value"::STRING ILIKE '%checkout%confirmation%' THEN 1 ELSE 0 END ) = 1
)
SELECT 
       ( SELECT COUNT(*) FROM sessions_with_home_and_conf ) * 100.0
       /
       NULLIF( ( SELECT COUNT(*) FROM sessions_with_home ), 0 )  AS "CONVERSION_RATE_PERCENT"
LIMIT 20;
```
