--Description: Final conversion-rate calculation: (Home + Confirmation) ÷ Home, in percent (corrected paths).
WITH home AS (
    SELECT DISTINCT
           f_id.value:"value":"int_value"::NUMBER AS ga_session_id,
           t."USER_PSEUDO_ID"
    FROM   GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
           LATERAL FLATTEN(input => t."EVENT_PARAMS")            f_id,
           LATERAL FLATTEN(input => t."EVENT_PARAMS")            f_title
    WHERE  t."EVENT_NAME" = 'page_view'
      AND  f_id.value:"key"::STRING    = 'ga_session_id'
      AND  f_title.value:"key"::STRING = 'page_title'
      AND  f_title.value:"value":"string_value"::STRING ILIKE '%home%'
), checkout AS (
    SELECT DISTINCT
           f_id.value:"value":"int_value"::NUMBER AS ga_session_id,
           t."USER_PSEUDO_ID"
    FROM   GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
           LATERAL FLATTEN(input => t."EVENT_PARAMS")            f_id,
           LATERAL FLATTEN(input => t."EVENT_PARAMS")            f_title
    WHERE  t."EVENT_NAME" = 'page_view'
      AND  f_id.value:"key"::STRING    = 'ga_session_id'
      AND  f_title.value:"key"::STRING = 'page_title'
      AND  f_title.value:"value":"string_value"::STRING ILIKE '%checkout%confirm%'
), joined AS (
    SELECT home.ga_session_id
    FROM   home
    JOIN   checkout USING (ga_session_id, "USER_PSEUDO_ID")
)
SELECT 
    COUNT(DISTINCT joined.ga_session_id)                       AS "CONVERTING_SESSIONS",
    COUNT(DISTINCT home.ga_session_id)                         AS "HOME_SESSIONS",
    100.0 * COUNT(DISTINCT joined.ga_session_id) 
          / NULLIF(COUNT(DISTINCT home.ga_session_id),0)       AS "CONVERSION_RATE_PCT"
FROM joined
JOIN home USING (ga_session_id)
