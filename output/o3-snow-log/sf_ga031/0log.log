```sql
--Description: 9)  Count user sessions that saw Home, and those that saw BOTH Home & Confirmation  
WITH pages AS (
  SELECT 
         f_loc.value:"value":"string_value"::STRING  AS page_location,
         f_ses.value:"value":"int_value"::NUMBER     AS ga_session_id
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t
       ,LATERAL FLATTEN(INPUT => t."EVENT_PARAMS") f_loc
       ,LATERAL FLATTEN(INPUT => t."EVENT_PARAMS") f_ses
  WHERE t."EVENT_NAME" = 'page_view'
    AND f_loc.value:"key"::STRING = 'page_location'
    AND f_ses.value:"key"::STRING = 'ga_session_id'
), session_flags AS (
  SELECT ga_session_id,
         MAX(CASE WHEN page_location ILIKE '%shop.googlemerchandisestore.com/%' THEN 1 END) AS hit_home,
         MAX(CASE WHEN page_location ILIKE '%confirm%'                        THEN 1 END) AS hit_confirm
  FROM pages
  GROUP BY ga_session_id
)
SELECT 
       COUNT(DISTINCT CASE WHEN hit_home = 1                       THEN ga_session_id END) AS sessions_home,
       COUNT(DISTINCT CASE WHEN hit_home = 1 AND hit_confirm = 1   THEN ga_session_id END) AS sessions_home_and_confirm
FROM session_flags
LIMIT 20;
```

```sql
--Description: 10)  Compute the Home-to-Confirmation conversion rate for 2-Jan-2021  
WITH pages AS (
  SELECT 
         f_loc.value:"value":"string_value"::STRING  AS page_location,
         f_ses.value:"value":"int_value"::NUMBER     AS ga_session_id
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t
       ,LATERAL FLATTEN(INPUT => t."EVENT_PARAMS") f_loc
       ,LATERAL FLATTEN(INPUT => t."EVENT_PARAMS") f_ses
  WHERE t."EVENT_NAME" = 'page_view'
    AND f_loc.value:"key"::STRING = 'page_location'
    AND f_ses.value:"key"::STRING = 'ga_session_id'
), session_flags AS (
  SELECT ga_session_id,
         MAX(CASE WHEN page_location ILIKE '%shop.googlemerchandisestore.com/%' THEN 1 END) AS hit_home,
         MAX(CASE WHEN page_location ILIKE '%confirm%'                        THEN 1 END) AS hit_confirm
  FROM pages
  GROUP BY ga_session_id
), agg AS (
  SELECT 
         COUNT(DISTINCT CASE WHEN hit_home = 1                       THEN ga_session_id END) AS sessions_home,
         COUNT(DISTINCT CASE WHEN hit_home = 1 AND hit_confirm = 1   THEN ga_session_id END) AS sessions_both
  FROM session_flags
)
SELECT 
       sessions_home,
       sessions_both,
       100.0 * sessions_both / NULLIF(sessions_home,0) AS conversion_rate_pct
FROM agg
LIMIT 20;
```
