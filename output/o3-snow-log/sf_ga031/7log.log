--Description: 7) List each session that viewed the Home page
WITH home AS (
  SELECT DISTINCT g.value:"int_value"::NUMBER AS "session_id"
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
       LATERAL FLATTEN(input => t."EVENT_PARAMS") p,
