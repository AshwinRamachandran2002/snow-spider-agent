```sql
--Description: 8) List each session that viewed a Checkout-confirmation page
WITH checkout AS (
  SELECT DISTINCT g.value:"int_value"::NUMBER AS "session_id"
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
       LATERAL FLATTEN(input => t."EVENT_PARAMS") p,
       LATERAL FLATTEN(input => t."EVENT_PARAMS") g
  WHERE t."EVENT_NAME" = 'page_view'
    AND p.value:"key"::STRING = 'page_title'
    AND (p.value:"string_value" ILIKE '%checkout%' OR
         p.value:"string_value" ILIKE '%confirm%')
    AND g.value:"key"::STRING = 'ga_session_id'
)
SELECT * FROM checkout
LIMIT 20;
```

```sql
--Description: 9) Count Home-page sessions vs. sessions with both Home & Checkout
WITH page_views AS (
  SELECT g.value:"int_value"::NUMBER AS "session_id",
         p.value:"string_value"::STRING AS "page_title"
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
       LATERAL FLATTEN(input => t."EVENT_PARAMS") p,
       LATERAL FLATTEN(input => t."EVENT_PARAMS") g
  WHERE t."EVENT_NAME" = 'page_view'
    AND p.value:"key"::STRING = 'page_title'
    AND g.value:"key"::STRING = 'ga_session_id'
), agg AS (
  SELECT "session_id",
         MAX(CASE WHEN "page_title" ILIKE '%home%'      THEN 1 ELSE 0 END) AS "has_home",
         MAX(CASE WHEN "page_title" ILIKE '%checkout%' 
                       OR "page_title" ILIKE '%confirm%' THEN 1 ELSE 0 END) AS "has_checkout"
  FROM page_views
  GROUP BY "session_id"
)
SELECT COUNT_IF("has_home" = 1)           AS "home_sessions",
       COUNT_IF("has_home" = 1 AND "has_checkout" = 1) AS "converted_sessions"
FROM agg
LIMIT 20;
```

```sql
--Description: 10) Compute conversion-rate percentage for 2-Jan-2021 (page_view only)
WITH page_views AS (
  SELECT g.value:"int_value"::NUMBER AS "session_id",
         p.value:"string_value"::STRING AS "page_title"
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
       LATERAL FLATTEN(input => t."EVENT_PARAMS") p,
       LATERAL FLATTEN(input => t."EVENT_PARAMS") g
  WHERE t."EVENT_NAME" = 'page_view'
    AND p.value:"key"::STRING = 'page_title'
    AND g.value:"key"::STRING = 'ga_session_id'
), agg AS (
  SELECT "session_id",
         MAX(CASE WHEN "page_title" ILIKE '%home%'      THEN 1 ELSE 0 END) AS "has_home",
         MAX(CASE WHEN "page_title" ILIKE '%checkout%' 
                       OR "page_title" ILIKE '%confirm%' THEN 1 ELSE 0 END) AS "has_checkout"
  FROM page_views
  GROUP BY "session_id"
), stats AS (
  SELECT COUNT_IF("has_home" = 1)                         AS "home_sessions",
         COUNT_IF("has_home" = 1 AND "has_checkout" = 1)  AS "converted_sessions"
  FROM agg
)
SELECT "home_sessions",
       "converted_sessions",
       ( "converted_sessions"::FLOAT / NULLIF("home_sessions",0) ) * 100 AS "conversion_rate_pct"
FROM stats
LIMIT 20;
```
