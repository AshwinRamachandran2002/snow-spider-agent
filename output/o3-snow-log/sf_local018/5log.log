Query:
--Description: 
-- Show counts and shares for every primary-collision-factor category
-- in 2011 and 2021 using "collision_date" to derive the year.
SELECT
    TO_NUMBER(SUBSTR("collision_date",1,4))              AS yr,
    "pcf_violation_category",
    COUNT(*)                                             AS cnt,
    COUNT(*) * 100.0 /
        SUM(COUNT(*)) OVER (PARTITION BY TO_NUMBER(SUBSTR("collision_date",1,4)))
                                                         AS share_pct
FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS"
WHERE "collision_date" LIKE '2011-%'
   OR "collision_date" LIKE '2021-%'
GROUP BY
    TO_NUMBER(SUBSTR("collision_date",1,4)),
    "pcf_violation_category"
ORDER BY yr, cnt DESC
LIMIT 20
