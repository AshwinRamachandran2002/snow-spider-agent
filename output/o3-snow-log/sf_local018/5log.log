```sql
--Description: Combine 2011 & 2021 shares for the top-2021 category and calculate the percentage-point change.
WITH top_cat AS (
    SELECT c."pcf_violation_category"
    FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS"  c
    JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS"    y
      ON c."case_id" = y."case_id"
    WHERE y."db_year" = 2021
    GROUP BY c."pcf_violation_category"
    ORDER BY COUNT(*) DESC
    LIMIT 1
),
year_shares AS (
    SELECT y."db_year",
           COUNT(*)                                                 AS "cnt",
           COUNT(*) * 100.0 /
           SUM(COUNT(*)) OVER (PARTITION BY y."db_year")            AS "share_pct"
    FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS"  c
    JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS"    y
      ON c."case_id" = y."case_id"
    JOIN top_cat t
      ON c."pcf_violation_category" = t."pcf_violation_category"
    WHERE y."db_year" IN (2011, 2021)
    GROUP BY y."db_year"
)
SELECT MAX(CASE WHEN "db_year" = 2021 THEN "share_pct" END) 
           - MAX(CASE WHEN "db_year" = 2011 THEN "share_pct" END)  AS "share_change_pct_points"
FROM year_shares
LIMIT 20;
```

