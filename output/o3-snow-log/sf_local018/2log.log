--Description: 8)  Get the 2021 percentage share of the most common 2021
--              primary-collision-factor violation category (“speeding”),
--              using only the COLLISIONS table and the year parsed from
--              "collision_date".
SELECT  ROUND( COUNT(*) * 100.0
              / ( SELECT COUNT(*)
                  FROM "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"
                  WHERE SUBSTR("collision_date",1,4) = '2021'
                ), 2) AS "top_cat_pct_2021"
FROM    "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"
WHERE   SUBSTR("collision_date",1,4) = '2021'
  AND   "pcf_violation_category"      = 'speeding';
