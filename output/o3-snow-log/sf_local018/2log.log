--Description: 10)  Display both the raw collision counts and percentage
--              shares for “speeding” in 2011 and 2021, for validation.
WITH base AS (
    SELECT  SUBSTR("collision_date",1,4) AS yr,
            "pcf_violation_category"
    FROM    "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"
    WHERE   SUBSTR("collision_date",1,4) IN ('2011','2021')
)
SELECT  yr AS "year",
        COUNT(*)                                           AS "speeding_collisions",
        ROUND( COUNT(*) * 100.0
               / SUM(COUNT(*)) OVER (PARTITION BY yr), 2)  AS "pct_share"
FROM    base
WHERE   "pcf_violation_category" = 'speeding'
GROUP   BY yr
ORDER   BY yr
