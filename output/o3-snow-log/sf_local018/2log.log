```sql
--Description: 9)  Compare 2021 versus 2011 percentage for the most common 2021 category and compute the decrease in percentage-points.           
WITH cte AS (
    SELECT ci."db_year",
           ROUND( COUNT(*) * 100.0 
                  / SUM(COUNT(*)) OVER (PARTITION BY ci."db_year"), 2) AS "pct_share"
    FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"  ci
    JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" co
           ON ci."case_id" = co."case_id"
    WHERE  ci."db_year" IN (2011, 2021)
      AND  co."pcf_violation_category" = '<TOP_CAT_2021>'
    GROUP  BY ci."db_year"
)
SELECT MAX(CASE WHEN "db_year" = 2021 THEN "pct_share" END) AS "pct_2021",
       MAX(CASE WHEN "db_year" = 2011 THEN "pct_share" END) AS "pct_2011",
       MAX(CASE WHEN "db_year" = 2021 THEN "pct_share" END)
       - MAX(CASE WHEN "db_year" = 2011 THEN "pct_share" END) AS "percentage_point_change"
FROM   cte
LIMIT 20;
```

