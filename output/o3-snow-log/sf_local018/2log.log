--Description: 9)  Compare the percentage share of “speeding” crashes in
--              2021 versus 2011, and compute the difference in
--              percentage-points (2021 – 2011).  Works solely on the
--              COLLISIONS table.
WITH shares AS (
    SELECT  SUBSTR("collision_date",1,4)               AS yr,
            ROUND( COUNT(*) * 100.0
                   / SUM(COUNT(*)) OVER (PARTITION BY SUBSTR("collision_date",1,4)), 2
                 )                                     AS pct_share
    FROM    "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"
    WHERE   SUBSTR("collision_date",1,4) IN ('2011','2021')
      AND   "pcf_violation_category" = 'speeding'
    GROUP   BY SUBSTR("collision_date",1,4)
)
SELECT  MAX(CASE WHEN yr = '2021' THEN pct_share END) AS pct_2021,
        MAX(CASE WHEN yr = '2011' THEN pct_share END) AS pct_2011,
        MAX(CASE WHEN yr = '2021' THEN pct_share END)
        - MAX(CASE WHEN yr = '2011' THEN pct_share END) AS percentage_point_change
FROM    shares
