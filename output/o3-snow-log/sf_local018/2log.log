--Description:  Retrieve the 20 most frequent primary-collision-factor violation categories
--              for crash-year 2011.  Because CASE_IDS holds no 2011 data, we work only with
--              the COLLISIONS table, derive the year from the first four characters of
--              "collision_date", then count and compute each category’s share of all 2011
--              crashes.
WITH c2011 AS (
    SELECT "pcf_violation_category"
    FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"
    WHERE  SUBSTR("collision_date", 1, 4) = '2011'
)
SELECT  "pcf_violation_category",
        COUNT(*)                                        AS "cnt_2011",
        ROUND( COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 2) AS "pct_2011"
FROM    c2011
GROUP   BY "pcf_violation_category"
ORDER   BY "cnt_2011" DESC
LIMIT   20;
