```sql
--Description:  Determine the most common primary-collision-factor violation category in 2021
--              (based on the collision_date year), then calculate that category’s share of
--              all crashes in 2021 and in 2011, and finally return the difference in
--              percentage-points (2021 share ­– 2011 share).  The query works only with the
--              COLLISIONS table, extracting the year as the first four characters of
--              "collision_date" (stored as TEXT), thereby avoiding the missing 2011 entries
--              in CASE_IDS.  One SQL block, fully self-contained.
WITH yr_tagged AS (   -- add year tag
    SELECT SUBSTR("collision_date", 1, 4) AS yr,
           "pcf_violation_category"
    FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"
    WHERE  SUBSTR("collision_date", 1, 4) IN ('2011','2021')
),
top_cat AS (          -- identify 2021’s most frequent category
    SELECT  "pcf_violation_category"
    FROM    yr_tagged
    WHERE   yr = '2021'
    GROUP   BY "pcf_violation_category"
    ORDER   BY COUNT(*) DESC
    LIMIT   1
),
totals AS (           -- total crashes each year
    SELECT yr,
           COUNT(*) AS tot
    FROM   yr_tagged
    GROUP  BY yr
),
cat_counts AS (       -- crashes for the top category each year
    SELECT y.yr,
           COUNT(*) AS cnt
    FROM   yr_tagged y
    JOIN   top_cat   t
           ON y."pcf_violation_category" = t."pcf_violation_category"
    GROUP  BY y.yr
)
SELECT  MAX(CASE WHEN yr = '2021' THEN ROUND(cnt*100.0/tot,2) END) AS pct_2021,
        MAX(CASE WHEN yr = '2011' THEN ROUND(cnt*100.0/tot,2) END) AS pct_2011,
        MAX(CASE WHEN yr = '2021' THEN ROUND(cnt*100.0/tot,2) END)
      - MAX(CASE WHEN yr = '2011' THEN ROUND(cnt*100.0/tot,2) END) AS percentage_point_change
FROM    cat_counts
JOIN    totals USING (yr);
```
