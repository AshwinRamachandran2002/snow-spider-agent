--Description: 7) Compute the share (%) of each PCF-violation category in 2021 (unchanged – 2021 exists in CASE_IDS)
SELECT c."pcf_violation_category",
       COUNT(*)::FLOAT / NULLIF(t."total",0) * 100 AS "share_pct_2021"
