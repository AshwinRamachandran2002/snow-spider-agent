```sql
--Description:  Identify the most frequent primary-collision-factor (PCF) violation category
--in 2021, then calculate that category’s share of all collisions in 2021 and in 2011, and
--finally return the percentage-point difference (2021 share minus 2011 share).  
--Because CASE_IDS has no 2011 records, 2011 collisions are filtered directly by
--“collision_date” beginning with '2011'.  The steps inside CTEs are:
--  top_cat   : name of the top 2021 PCF category.
--  tot_2021  : total collisions in 2021.
--  tot_2011  : total collisions in 2011.
--  cnt_2021  : collisions in 2021 for that top category.
--  cnt_2011  : collisions in 2011 for that top category.
--The final SELECT converts counts to percentages and subtracts to get the change.
WITH top_cat AS (
    SELECT c."pcf_violation_category" AS "cat"
    FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c
    JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"  y
           ON c."case_id" = y."case_id"
    WHERE  y."db_year" = 2021
    GROUP  BY c."pcf_violation_category"
    ORDER  BY COUNT(*) DESC
    LIMIT 1
),
tot_2021 AS (
    SELECT COUNT(*) AS "tot"
    FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c
    JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"  y
           ON c."case_id" = y."case_id"
    WHERE  y."db_year" = 2021
),
tot_2011 AS (
    SELECT COUNT(*) AS "tot"
    FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"
    WHERE  "collision_date" ILIKE '2011%'
),
cnt_2021 AS (
    SELECT COUNT(*) AS "cnt"
    FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c
    JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"  y
           ON c."case_id" = y."case_id"
    JOIN   top_cat tc ON c."pcf_violation_category" = tc."cat"
    WHERE  y."db_year" = 2021
),
cnt_2011 AS (
    SELECT COUNT(*) AS "cnt"
    FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c
    JOIN   top_cat tc ON c."pcf_violation_category" = tc."cat"
    WHERE  c."collision_date" ILIKE '2011%'
)
SELECT
       tc."cat"                                          AS "pcf_violation_category",
       cnt21."cnt"::FLOAT / tot21."tot" * 100            AS "share_2021_pct",
       cnt11."cnt"::FLOAT / tot11."tot" * 100            AS "share_2011_pct",
       (cnt21."cnt"::FLOAT / tot21."tot" * 100) -
       (cnt11."cnt"::FLOAT / tot11."tot" * 100)          AS "pct_point_change_2021_vs_2011"
FROM   top_cat  tc
CROSS JOIN cnt_2021 cnt21
CROSS JOIN tot_2021 tot21
CROSS JOIN cnt_2011 cnt11
CROSS JOIN tot_2011 tot11;
```
