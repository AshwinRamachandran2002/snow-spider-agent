```sql
--Description (thinking process):
--The CASE_IDS mapping table does not include any rows for 2011 (only 2017-2021 were present),
--so joining to that table eliminates all 2011 data.  To retrieve 2011 collisions we must
--instead filter directly on the text column "collision_date" in COLLISIONS.
--The pattern '2011%' matches any date string that begins with 2011- (e.g., '2011-05-17').
--After filtering, we group by the primary-collision-factor violation category
--("pcf_violation_category") and count how many collisions fell into each category.
--Ordering by the count in descending order lets us see the most common PCF categories for 2011.
SELECT
       "pcf_violation_category",
       COUNT(*) AS "cnt_2011"
FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"
WHERE  "collision_date" ILIKE '2011%'     -- keep only collisions from calendar year 2011
GROUP  BY "pcf_violation_category"
ORDER  BY "cnt_2011" DESC
LIMIT 20;
```
