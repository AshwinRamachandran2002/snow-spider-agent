```sql
--Description: 9) Identify the most common 2021 category and get its 2021 and 2011 shares side-by-side
WITH top21 AS (
    SELECT c."pcf_violation_category",
           COUNT(*) AS "cnt_2021"
    FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"  c
    JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"     y
    ON     c."case_id" = y."case_id"
    WHERE  y."db_year" = 2021
    GROUP  BY c."pcf_violation_category"
    ORDER  BY "cnt_2021" DESC
    LIMIT 1
), totals AS (
    SELECT
        (SELECT COUNT(*) FROM "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c1
         JOIN "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS" y1
         ON   c1."case_id" = y1."case_id"
         WHERE y1."db_year" = 2021) AS "tot_2021",
        (SELECT COUNT(*) FROM "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c2
         JOIN "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS" y2
         ON   c2."case_id" = y2."case_id"
         WHERE y2."db_year" = 2011) AS "tot_2011"
)
SELECT top21."pcf_violation_category",
       COUNT(CASE WHEN y."db_year" = 2021 THEN 1 END)::FLOAT / t."tot_2021" * 100 AS "share_2021_pct",
       COUNT(CASE WHEN y."db_year" = 2011 THEN 1 END)::FLOAT / t."tot_2011" * 100 AS "share_2011_pct"
FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"  c
JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"     y
ON     c."case_id" = y."case_id"
JOIN   top21
ON     c."pcf_violation_category" = top21."pcf_violation_category",
      totals t
WHERE  y."db_year" IN (2011, 2021)
GROUP  BY top21."pcf_violation_category", t."tot_2021", t."tot_2011"
LIMIT 20;
```

```sql
--Description: 10) Compute the percentage-point difference between 2021 and 2011 for the top 2021 category
WITH top_category AS (
    SELECT c."pcf_violation_category"
    FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"  c
    JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"     y
    ON     c."case_id" = y."case_id"
    WHERE  y."db_year" = 2021
    GROUP  BY c."pcf_violation_category"
    ORDER  BY COUNT(*) DESC
    LIMIT 1
), year_totals AS (
    SELECT
        2021 AS "yr",
        COUNT(*) AS "total"
    FROM "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"  c
    JOIN "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"     y
    ON   c."case_id" = y."case_id"
    WHERE y."db_year" = 2021
    UNION ALL
    SELECT
        2011 AS "yr",
        COUNT(*) AS "total"
    FROM "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"  c
    JOIN "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"     y
    ON   c."case_id" = y."case_id"
    WHERE y."db_year" = 2011
), counts AS (
    SELECT y."db_year",
           COUNT(*) AS "cat_cnt"
    FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"  c
    JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"     y
    ON     c."case_id" = y."case_id"
    JOIN   top_category tc
    ON     c."pcf_violation_category" = tc."pcf_violation_category"
    WHERE  y."db_year" IN (2011, 2021)
    GROUP  BY y."db_year"
)
SELECT tc."pcf_violation_category",
       (c2021."cat_cnt"::FLOAT / y2021."total" * 100)  AS "share_2021_pct",
       (c2011."cat_cnt"::FLOAT / y2011."total" * 100)  AS "share_2011_pct",
       (c2021."cat_cnt"::FLOAT / y2021."total" * 100) -
       (c2011."cat_cnt"::FLOAT / y2011."total" * 100)  AS "pct_point_change_2021_vs_2011"
FROM   top_category tc
JOIN   counts c2021 ON c2021."db_year" = 2021
JOIN   counts c2011 ON c2011."db_year" = 2011
JOIN   year_totals y2021 ON y2021."yr" = 2021
JOIN   year_totals y2011 ON y2011."yr" = 2011
LIMIT 20;
```
