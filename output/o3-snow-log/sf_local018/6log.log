```sql
--Description: 7) Compute the share (%) of each PCF violation category in 2021
SELECT c."pcf_violation_category",
       COUNT(*)::FLOAT / NULLIF(t."total",0) * 100 AS "share_pct_2021"
FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"  c
JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"     y
ON     c."case_id" = y."case_id",
      (SELECT COUNT(*) AS "total"
       FROM "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"  c1
       JOIN "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"   y1
       ON   c1."case_id" = y1."case_id"
       WHERE y1."db_year" = 2021) t
WHERE  y."db_year" = 2021
GROUP  BY c."pcf_violation_category", t."total"
ORDER  BY "share_pct_2021" DESC
LIMIT 20;
