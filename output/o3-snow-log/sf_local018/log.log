```sql
--Description: Percentage share in 2011 for the violation category that was most common in 2021
WITH top2021 AS (                                                  -- find 2021’s #1 category
     SELECT c."pcf_violation_category"
     FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c
     WHERE  c."collision_date" LIKE '2021%'
     GROUP  BY c."pcf_violation_category"
     ORDER  BY COUNT(*) DESC
     LIMIT 1
)
SELECT t."pcf_violation_category",
       COUNT(*) * 100.0
       / (SELECT COUNT(*)                                         -- divide by all 2011 crashes
          FROM "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"
          WHERE "collision_date" LIKE '2011%') AS "share_pct_2011"
FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c
JOIN   top2021 t
  ON   c."pcf_violation_category" = t."pcf_violation_category"
WHERE  c."collision_date" LIKE '2011%'
GROUP  BY t."pcf_violation_category"
LIMIT 20;
```

```sql
--Description: Compute the percentage-point change between 2011 and 2021 for 2021’s top category
WITH base AS (                                                      -- keep only 2011 & 2021 rows
     SELECT c."pcf_violation_category",
            SUBSTR(c."collision_date",1,4) AS "yr"
     FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c
     WHERE  c."collision_date" LIKE '2011%' OR c."collision_date" LIKE '2021%'
), top2021 AS (                                                     -- 2021 #1 category
     SELECT "pcf_violation_category"
     FROM   base
     WHERE  "yr" = '2021'
     GROUP  BY "pcf_violation_category"
     ORDER  BY COUNT(*) DESC
     LIMIT 1
), cnts AS (                                                        -- counts of that category
     SELECT "yr", COUNT(*) AS cnt
     FROM   base
     WHERE  "pcf_violation_category" IN (SELECT "pcf_violation_category" FROM top2021)
     GROUP  BY "yr"
), totals AS (                                                      -- all-crash totals per year
     SELECT "yr", COUNT(*) AS tot_cnt
     FROM   base
     GROUP  BY "yr"
), pct AS (                                                         -- percentage shares
     SELECT c."yr",
            c.cnt * 100.0 / t.tot_cnt AS share_pct
     FROM   cnts  c
     JOIN   totals t USING ("yr")
)
SELECT MAX(CASE WHEN "yr" = '2021' THEN share_pct END) -
       MAX(CASE WHEN "yr" = '2011' THEN share_pct END) AS "percentage_point_drop"
FROM pct
LIMIT 20;
```

```sql
--Description: Show the #1 2021 violation category plus its 2011 & 2021 shares and the drop
WITH base AS (
     SELECT c."pcf_violation_category",
            SUBSTR(c."collision_date",1,4) AS "yr"
     FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c
     WHERE  c."collision_date" LIKE '2011%' OR c."collision_date" LIKE '2021%'
), top2021 AS (
     SELECT "pcf_violation_category"
     FROM   base
     WHERE  "yr" = '2021'
     GROUP  BY "pcf_violation_category"
     ORDER  BY COUNT(*) DESC
     LIMIT 1
), shares AS (
     SELECT b."yr",
            b."pcf_violation_category",
            COUNT(*)                           AS cnt
     FROM   base b
     JOIN   top2021 t
       ON   b."pcf_violation_category" = t."pcf_violation_category"
     GROUP  BY b."yr", b."pcf_violation_category"
), totals AS (
     SELECT "yr", COUNT(*) AS tot_cnt
     FROM   base
     GROUP  BY "yr"
), pct AS (
     SELECT s."yr",
            s."pcf_violation_category",
            s.cnt * 100.0 / t.tot_cnt AS share_pct
     FROM   shares s
     JOIN   totals t USING ("yr")
)
SELECT "pcf_violation_category",
       MAX(CASE WHEN "yr"='2021' THEN share_pct END) AS "share_2021_pct",
       MAX(CASE WHEN "yr"='2011' THEN share_pct END) AS "share_2011_pct",
       MAX(CASE WHEN "yr"='2021' THEN share_pct END) -
       MAX(CASE WHEN "yr"='2011' THEN share_pct END) AS "percentage_point_drop"
FROM pct
GROUP BY "pcf_violation_category"
LIMIT 20;
