```sql
--Description: Combine 2021 and 2011 shares for the most common 2021 violation category and calculate the percentage-point change.
WITH top2021 AS (
  SELECT c."pcf_violation_category"
  FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c
  JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"    ci
    ON c."case_id" = ci."case_id"
  WHERE  ci."db_year" = 2021
  GROUP BY c."pcf_violation_category"
  ORDER BY COUNT(*) DESC
  LIMIT 1
), shares AS (
  SELECT ci."db_year",
         COUNT(*) * 100.0
         / SUM(COUNT(*)) OVER(PARTITION BY ci."db_year") AS "share_pct"
  FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c
  JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"    ci
         ON c."case_id" = ci."case_id", top2021 t
  WHERE  ci."db_year" IN (2011, 2021)
    AND  c."pcf_violation_category" = t."pcf_violation_category"
  GROUP BY ci."db_year"
)
SELECT MAX(CASE WHEN "db_year"=2021 THEN "share_pct" END) -
       MAX(CASE WHEN "db_year"=2011 THEN "share_pct" END)  AS "percentage_point_drop"
FROM shares
LIMIT 20;
```

```sql
--Description: Display the most-common 2021 violation category together with its 2011 and 2021 shares and the computed drop.
WITH top2021 AS (
  SELECT c."pcf_violation_category"
  FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c
  JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"    ci
    ON c."case_id" = ci."case_id"
  WHERE  ci."db_year" = 2021
  GROUP BY c."pcf_violation_category"
  ORDER BY COUNT(*) DESC
  LIMIT 1
), shares AS (
  SELECT ci."db_year",
         c."pcf_violation_category",
         COUNT(*) * 100.0
         / SUM(COUNT(*)) OVER(PARTITION BY ci."db_year") AS "share_pct"
  FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c
  JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"    ci
         ON c."case_id" = ci."case_id", top2021 t
  WHERE  ci."db_year" IN (2011, 2021)
    AND  c."pcf_violation_category" = t."pcf_violation_category"
  GROUP BY ci."db_year", c."pcf_violation_category"
)
SELECT "pcf_violation_category",
       MAX(CASE WHEN "db_year" = 2021 THEN "share_pct" END) AS "share_2021_pct",
       MAX(CASE WHEN "db_year" = 2011 THEN "share_pct" END) AS "share_2011_pct",
       MAX(CASE WHEN "db_year" = 2021 THEN "share_pct" END)
       - MAX(CASE WHEN "db_year" = 2011 THEN "share_pct" END) AS "percentage_point_drop"
FROM shares
GROUP BY "pcf_violation_category"
LIMIT 20;
