```sql
--Description: Compute 2011 percentage share for the 2021 top-ranked violation category (replace %%TOP_CAT%% with real text from query #2).
WITH top2021 AS (
  SELECT c."pcf_violation_category"
  FROM   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS" c
  JOIN   "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"    ci
    ON c."case_id" = ci."case_id"
  WHERE  ci."db_year" = 2021
  GROUP BY c."pcf_violation_category"
  ORDER BY COUNT(*) DESC
  LIMIT 1
)
SELECT c."pcf_violation_category",
       COUNT(*) * 100.0
       / SUM(COUNT(*)) OVER() AS "share_pct_2011"
FROM "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."COLLISIONS"  c
JOIN "CALIFORNIA_TRAFFIC_COLLISION"."CALIFORNIA_TRAFFIC_COLLISION"."CASE_IDS"     ci
  ON c."case_id" = ci."case_id", top2021 t
WHERE ci."db_year" = 2011
  AND c."pcf_violation_category" = t."pcf_violation_category"
GROUP BY c."pcf_violation_category"
LIMIT 20;
