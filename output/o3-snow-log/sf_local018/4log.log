--Description: 9) Combine results to show 2021’s top PCF category and its share in both 2021 and 2017.  
WITH top21 AS (
     SELECT c."pcf_violation_category"
     FROM   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS  c
     JOIN   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS    y
            ON c."case_id" = y."case_id"
     WHERE  y."db_year" = 2021
     GROUP  BY c."pcf_violation_category"
     ORDER  BY COUNT(*) DESC
     LIMIT 1
)
SELECT t."pcf_violation_category",
       SUM(CASE WHEN y."db_year" = 2021 THEN 1 END)::FLOAT /
       (SELECT COUNT(*) 
        FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c21
        JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS   y21
          ON c21."case_id" = y21."case_id"
        WHERE y21."db_year" = 2021) * 100  AS "share_2021_pct",
       SUM(CASE WHEN y."db_year" = 2017 THEN 1 END)::FLOAT /
       (SELECT COUNT(*) 
        FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c17
        JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS   y17
          ON c17."case_id" = y17."case_id"
        WHERE y17."db_year" = 2017) * 100  AS "share_2017_pct"
FROM   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS  c
JOIN   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS    y
       ON c."case_id" = y."case_id"
JOIN   top21 t
       ON c."pcf_violation_category" = t."pcf_violation_category"
WHERE  y."db_year" IN (2017, 2021)
GROUP  BY t."pcf_violation_category";
```

```sql
--Description: 10) Calculate the percentage-point change for 2021’s most common PCF category between 2017 and 2021.  
WITH top21 AS (
     SELECT c."pcf_violation_category"
     FROM   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS  c
     JOIN   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS    y
            ON c."case_id" = y."case_id"
     WHERE  y."db_year" = 2021
     GROUP  BY c."pcf_violation_category"
     ORDER  BY COUNT(*) DESC
     LIMIT 1
),
totals AS (
     SELECT 
         SUM(CASE WHEN y."db_year" = 2021 THEN 1 END) AS cnt21,
         SUM(CASE WHEN y."db_year" = 2017 THEN 1 END) AS cnt17
     FROM   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c
     JOIN   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS   y
            ON c."case_id" = y."case_id"
     WHERE  y."db_year" IN (2017, 2021)
),
denoms AS (
     SELECT 
         (SELECT COUNT(*) FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c21
          JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS y21
            ON c21."case_id" = y21."case_id"
          WHERE y21."db_year" = 2021) AS total21,
         (SELECT COUNT(*) FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c17
          JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS y17
            ON c17."case_id" = y17."case_id"
          WHERE y17."db_year" = 2017) AS total17
)
SELECT t."pcf_violation_category",
       (cnt21::FLOAT / total21) * 100 AS "share_2021_pct",
       (cnt17::FLOAT / total17) * 100 AS "share_2017_pct",
       ((cnt21::FLOAT / total21) - (cnt17::FLOAT / total17)) * 100 AS "percentage_point_change"
FROM   top21 t, totals, denoms;
```
