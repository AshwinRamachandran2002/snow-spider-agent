Query:
--Description: 9) Show 2021’s most common PCF violation category and its percentage share in both 2021 and 2018.  
WITH top21 AS (  -- find the leading PCF category in 2021
     SELECT c."pcf_violation_category"
     FROM   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS  c
     JOIN   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS    y
            ON c."case_id" = y."case_id"
     WHERE  y."db_year" = 2021
     GROUP  BY c."pcf_violation_category"
     ORDER  BY COUNT(*) DESC
     LIMIT 1
)
SELECT t."pcf_violation_category",
       -- 2021 share
       SUM(CASE WHEN y."db_year" = 2021 THEN 1 END)::FLOAT /
       (SELECT COUNT(*) 
        FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c21
        JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS   y21
              ON c21."case_id" = y21."case_id"
        WHERE y21."db_year" = 2021) * 100  AS "share_2021_pct",
       -- 2018 share
       SUM(CASE WHEN y."db_year" = 2018 THEN 1 END)::FLOAT /
       (SELECT COUNT(*) 
        FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c18
        JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS   y18
              ON c18."case_id" = y18."case_id"
        WHERE y18."db_year" = 2018) * 100  AS "share_2018_pct"
FROM   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS  c
JOIN   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS    y
       ON c."case_id" = y."case_id"
JOIN   top21 t
       ON c."pcf_violation_category" = t."pcf_violation_category"
WHERE  y."db_year" IN (2018, 2021)
GROUP  BY t."pcf_violation_category"
Answer:
pcf_violation_category,share_2021_pct,share_2018_pct
speeding,32.78688524590164,26.25
Query:
--Description: 10) Calculate the percentage-point change for 2021’s most common PCF category between 2018 and 2021.  
WITH top21 AS (  -- leading PCF category in 2021
     SELECT c."pcf_violation_category"
     FROM   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS  c
     JOIN   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS    y
            ON c."case_id" = y."case_id"
     WHERE  y."db_year" = 2021
     GROUP  BY c."pcf_violation_category"
     ORDER  BY COUNT(*) DESC
     LIMIT 1
), totals AS (     -- total crashes each year
     SELECT
        (SELECT COUNT(*) 
         FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c21
         JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS   y21
               ON c21."case_id" = y21."case_id"
         WHERE y21."db_year" = 2021) AS tot_2021,
        (SELECT COUNT(*) 
         FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c18
         JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS   y18
               ON c18."case_id" = y18."case_id"
         WHERE y18."db_year" = 2018) AS tot_2018
)
SELECT t."pcf_violation_category",
       -- percentage in 2021
       SUM(CASE WHEN y."db_year" = 2021 THEN 1 END)::FLOAT / totals.tot_2021 * 100  AS "share_2021_pct",
       -- percentage in 2018
       SUM(CASE WHEN y."db_year" = 2018 THEN 1 END)::FLOAT / totals.tot_2018 * 100  AS "share_2018_pct",
       -- percentage-point difference (2021 minus 2018)
       (SUM(CASE WHEN y."db_year" = 2021 THEN 1 END)::FLOAT / totals.tot_2021 * 100) -
       (SUM(CASE WHEN y."db_year" = 2018 THEN 1 END)::FLOAT / totals.tot_2018 * 100)  AS "percentage_point_change"
FROM   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS  c
JOIN   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS    y
       ON c."case_id" = y."case_id"
JOIN   top21 t
       ON c."pcf_violation_category" = t."pcf_violation_category"
CROSS JOIN totals
WHERE  y."db_year" IN (2018, 2021)
GROUP  BY t."pcf_violation_category", totals.tot_2021, totals.tot_2018
Answer:
pcf_violation_category,share_2021_pct,share_2018_pct,percentage_point_change
speeding,32.78688524590164,26.25,6.536885245901637
