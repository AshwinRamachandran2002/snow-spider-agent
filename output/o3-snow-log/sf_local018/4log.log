```sql
--Description: 9) Combine the previous two results to examine the 2021 top category and its share in both years.  
WITH  top21 AS (
       SELECT c."pcf_violation_category"
       FROM   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS  c
       JOIN   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS    y
              ON c."case_id" = y."case_id"
       WHERE  y."db_year" = 2021
       GROUP  BY c."pcf_violation_category"
       ORDER  BY COUNT(*) DESC
       LIMIT 1
)
SELECT t."pcf_violation_category",
       SUM(CASE WHEN y."db_year" = 2021 THEN 1 END)::FLOAT /
       (SELECT COUNT(*) FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c21
        JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS y21
          ON c21."case_id" = y21."case_id"
        WHERE y21."db_year" = 2021) * 100  AS "share_2021_pct",
       SUM(CASE WHEN y."db_year" = 2011 THEN 1 END)::FLOAT /
       (SELECT COUNT(*) FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c11
        JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS y11
          ON c11."case_id" = y11."case_id"
        WHERE y11."db_year" = 2011) * 100  AS "share_2011_pct"
FROM   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS  c
JOIN   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS    y
       ON c."case_id" = y."case_id"
JOIN   top21 t
       ON c."pcf_violation_category" = t."pcf_violation_category"
WHERE  y."db_year" IN (2011, 2021)
GROUP  BY t."pcf_violation_category";
```

```sql
--Description: 10) Extend the previous query to calculate the percentage-point decrease (positive number means a drop from 2011 to 2021).  
WITH  top21 AS (
       SELECT c."pcf_violation_category"
       FROM   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS  c
       JOIN   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS    y
              ON c."case_id" = y."case_id"
       WHERE  y."db_year" = 2021
       GROUP  BY c."pcf_violation_category"
       ORDER  BY COUNT(*) DESC
       LIMIT 1
)
SELECT t."pcf_violation_category",
       (SUM(CASE WHEN y."db_year" = 2021 THEN 1 END)::FLOAT /
        (SELECT COUNT(*) FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c21
         JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS y21
           ON c21."case_id" = y21."case_id"
         WHERE y21."db_year" = 2021) * 100)                          AS "share_2021_pct",
       (SUM(CASE WHEN y."db_year" = 2011 THEN 1 END)::FLOAT /
        (SELECT COUNT(*) FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c11
         JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS y11
           ON c11."case_id" = y11."case_id"
         WHERE y11."db_year" = 2011) * 100)                          AS "share_2011_pct",
       ( (SUM(CASE WHEN y."db_year" = 2021 THEN 1 END)::FLOAT /
           (SELECT COUNT(*) FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c21
            JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS y21
              ON c21."case_id" = y21."case_id"
            WHERE y21."db_year" = 2021) * 100)
         - 
         (SUM(CASE WHEN y."db_year" = 2011 THEN 1 END)::FLOAT /
           (SELECT COUNT(*) FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS c11
            JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS y11
              ON c11."case_id" = y11."case_id"
            WHERE y11."db_year" = 2011) * 100)
       )                                                             AS "percentage_point_change"
FROM   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.COLLISIONS  c
JOIN   CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION.CASE_IDS    y
       ON c."case_id" = y."case_id"
JOIN   top21 t
       ON c."pcf_violation_category" = t."pcf_violation_category"
WHERE  y."db_year" IN (2011, 2021)
GROUP  BY t."pcf_violation_category";
```
