```sql
--Description: 8) Compute that same category’s share of collisions in 2011.
WITH top2021 AS (
    SELECT c."pcf_violation_category"
    FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS"   c
    JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS" ci
      ON c."case_id" = ci."case_id"
    WHERE ci."db_year" = 2021
    GROUP BY c."pcf_violation_category"
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT c."pcf_violation_category",
       COUNT(*)                                    AS "cnt_2011",
       COUNT(*) * 100.0 / SUM(COUNT(*)) OVER ()   AS "share_pct_2011"
FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS"   c
JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS" ci
  ON c."case_id" = ci."case_id"
JOIN top2021 t
  ON c."pcf_violation_category" = t."pcf_violation_category"
WHERE ci."db_year" = 2011
GROUP BY c."pcf_violation_category";
```

```sql
--Description: 9) Combine 2011 and 2021 information for that category to directly compute the drop in share (percentage-point change).
WITH top2021 AS (
    SELECT c."pcf_violation_category"
    FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS" c
    JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS"   ci
      ON c."case_id" = ci."case_id"
    WHERE ci."db_year" = 2021
    GROUP BY c."pcf_violation_category"
    ORDER BY COUNT(*) DESC
    LIMIT 1
),
stats AS (
    SELECT '2021' AS "yr",
           c."pcf_violation_category",
           COUNT(*) * 100.0 / SUM(COUNT(*)) OVER () AS "share_pct"
    FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS" c
    JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS"   ci
      ON c."case_id" = ci."case_id"
    JOIN top2021 t
      ON c."pcf_violation_category" = t."pcf_violation_category"
    WHERE ci."db_year" = 2021
    GROUP BY c."pcf_violation_category"
    
    UNION ALL
    
    SELECT '2011' AS "yr",
           c."pcf_violation_category",
           COUNT(*) * 100.0 / SUM(COUNT(*)) OVER () AS "share_pct"
    FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS" c
    JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS"   ci
      ON c."case_id" = ci."case_id"
    JOIN top2021 t
      ON c."pcf_violation_category" = t."pcf_violation_category"
    WHERE ci."db_year" = 2011
    GROUP BY c."pcf_violation_category"
)
SELECT MAX(CASE WHEN "yr" = '2021' THEN "share_pct" END) -
       MAX(CASE WHEN "yr" = '2011' THEN "share_pct" END) AS "share_pct_point_change_2021_minus_2011"
FROM stats;
```

```sql
--Description: 10) Sanity-check: list yearly shares (2011–2021) for that same top 2021 PCF violation category to view the trend.
WITH top2021 AS (
    SELECT c."pcf_violation_category"
    FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS" c
    JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS"   ci
      ON c."case_id" = ci."case_id"
    WHERE ci."db_year" = 2021
    GROUP BY c."pcf_violation_category"
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT ci."db_year",
       COUNT(*)                         AS "collisions",
       COUNT(*) * 100.0 /
       SUM(COUNT(*)) OVER (PARTITION BY ci."db_year") AS "share_pct"
FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS" c
JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS"   ci
  ON c."case_id" = ci."case_id"
JOIN top2021 t
  ON c."pcf_violation_category" = t."pcf_violation_category"
WHERE ci."db_year" BETWEEN 2011 AND 2021
GROUP BY ci."db_year"
ORDER BY ci."db_year"
LIMIT 20;
```
