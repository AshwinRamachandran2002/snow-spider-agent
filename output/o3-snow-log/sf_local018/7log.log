      ON c."case_id" = ci."case_id"
    WHERE ci."db_year" = 2021
    GROUP BY c."pcf_violation_category"
    ORDER BY COUNT(*) DESC
    LIMIT 1
),
stats AS (
    -- 2021 share
    SELECT '2021' AS "yr",
           c."pcf_violation_category",
