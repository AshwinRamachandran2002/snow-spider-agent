Query:
--Description: 8) Compute that same (top-2021) category’s share of collisions in 2011.
WITH top2021 AS (
    SELECT c."pcf_violation_category"
    FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS" c
    JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS"   ci
      ON c."case_id" = ci."case_id"
    WHERE ci."db_year" = 2021
    GROUP BY c."pcf_violation_category"
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT c."pcf_violation_category",
       COUNT(*)                                    AS "cnt_2011",
       COUNT(*) * 100.0 / SUM(COUNT(*)) OVER ()   AS "share_pct_2011"
FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS" c
JOIN top2021 t
  ON c."pcf_violation_category" = t."pcf_violation_category"
WHERE c."collision_date" LIKE '2011-%'
GROUP BY c."pcf_violation_category"
Answer:
pcf_violation_category,cnt_2011,share_pct_2011
speeding,1273,100.000000
Query:
--Description: 9) Combine 2011 and 2021 information for that category to compute
--              the percentage-point drop from 2011 to 2021.
WITH top2021 AS (
    SELECT c."pcf_violation_category"
    FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS" c
    JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS"   ci
      ON c."case_id" = ci."case_id"
    WHERE ci."db_year" = 2021
    GROUP BY c."pcf_violation_category"
    ORDER BY COUNT(*) DESC
    LIMIT 1
),
stats AS (
    -- 2021 share
    SELECT '2021' AS "yr",
           c."pcf_violation_category",
           COUNT(*) * 100.0 / SUM(COUNT(*)) OVER () AS "share_pct"
    FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS" c
    JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS"   ci
      ON c."case_id" = ci."case_id"
    JOIN top2021 t
      ON c."pcf_violation_category" = t."pcf_violation_category"
    WHERE ci."db_year" = 2021
    GROUP BY c."pcf_violation_category"
    
    UNION ALL
    
    -- 2011 share
    SELECT '2011' AS "yr",
           c."pcf_violation_category",
           COUNT(*) * 100.0 / SUM(COUNT(*)) OVER () AS "share_pct"
    FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS" c
    JOIN top2021 t
      ON c."pcf_violation_category" = t."pcf_violation_category"
    WHERE c."collision_date" LIKE '2011-%'
    GROUP BY c."pcf_violation_category"
)
SELECT MAX(CASE WHEN "yr" = '2021' THEN "share_pct" END) -
