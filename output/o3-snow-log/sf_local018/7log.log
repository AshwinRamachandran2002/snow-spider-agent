--Description: 10) Trend check: list yearly shares (2011-2021) for that same top-2021
--               PCF violation category using the year extracted from "collision_date".
WITH top2021 AS (
    SELECT c."pcf_violation_category"
    FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS" c
    JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS"   ci
      ON c."case_id" = ci."case_id"
    WHERE ci."db_year" = 2021
    GROUP BY c."pcf_violation_category"
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT SUBSTR(c."collision_date",1,4)        AS "year",
       COUNT(*)                              AS "collisions",
       COUNT(*) * 100.0 /
       SUM(COUNT(*)) OVER (PARTITION BY SUBSTR(c."collision_date",1,4)) AS "share_pct"
FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS" c
JOIN top2021 t
  ON c."pcf_violation_category" = t."pcf_violation_category"
WHERE SUBSTR(c."collision_date",1,4) BETWEEN '2011' AND '2021'
GROUP BY SUBSTR(c."collision_date",1,4)
ORDER BY "year"
LIMIT 20
