Query:
--Description: 7) Identify the single most-common PCF-violation category in 2021
--              together with its share of 2021 collisions (CASE_IDS still works
--              for 2021, so we can keep that join).
SELECT c."pcf_violation_category",
       COUNT(*)                                    AS "cnt_2021",
       COUNT(*) * 100.0 / SUM(COUNT(*)) OVER ()   AS "share_pct_2021"
FROM CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."COLLISIONS"  c
JOIN CALIFORNIA_TRAFFIC_COLLISION.CALIFORNIA_TRAFFIC_COLLISION."CASE_IDS"    ci
  ON c."case_id" = ci."case_id"
WHERE ci."db_year" = 2021
GROUP BY c."pcf_violation_category"
ORDER BY "cnt_2021" DESC
LIMIT 1
