```sql
--Description: 7)  For each session, count how many PLP and PDP views occurred
SELECT  "session_id",
        SUM( CASE WHEN "page_location" ILIKE '%+%'  THEN 1 ELSE 0 END ) AS "pdp_views",
        SUM( CASE WHEN "page_location" NOT ILIKE '%+%' THEN 1 ELSE 0 END ) AS "plp_views"
FROM   (
        SELECT  
               MAX( CASE WHEN f.key = 'ga_session_id'  THEN f.value:"int_value"::NUMBER  END ) AS "session_id",
               MAX( CASE WHEN f.key = 'page_location' THEN f.value:"string_value"::STRING END ) AS "page_location"
        FROM   "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t,
               LATERAL FLATTEN ( input => t."EVENT_PARAMS") f
        WHERE  t."EVENT_NAME" = 'page_view'
        GROUP  BY t."EVENT_TIMESTAMP"
      ) s
GROUP BY "session_id"
LIMIT 20;
```

```sql
--Description: 8)  Aggregate: how many PLP views belong to sessions that ALSO saw a PDP
WITH pages AS (
  SELECT  
         MAX( CASE WHEN f.key = 'ga_session_id'  THEN f.value:"int_value"::NUMBER  END ) AS "session_id",
         MAX( CASE WHEN f.key = 'page_location' THEN f.value:"string_value"::STRING END ) AS "url"
  FROM   "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t,
         LATERAL FLATTEN ( input => t."EVENT_PARAMS") f
  WHERE  t."EVENT_NAME" = 'page_view'
  GROUP  BY t."EVENT_TIMESTAMP"
),
session_flags AS (
  SELECT  "session_id",
          SUM( CASE WHEN "url" ILIKE '%+%' THEN 1 ELSE 0 END ) > 0  AS has_pdp
  FROM    pages
  GROUP   BY "session_id"
)
SELECT  COUNT(*)                                             AS total_plp_views,
        SUM( CASE WHEN sf.has_pdp THEN 1 ELSE 0 END )        AS plp_views_with_pdp_session
FROM    pages p
JOIN    session_flags sf USING ("session_id")
WHERE   p."url" NOT ILIKE '%+%'
LIMIT 20;
```

```sql
--Description: 9)  Show totals plus % of PLP views that occurred in sessions where a PDP was also viewed
WITH pages AS (
  SELECT  
         MAX( CASE WHEN f.key = 'ga_session_id'  THEN f.value:"int_value"::NUMBER  END ) AS "session_id",
         MAX( CASE WHEN f.key = 'page_location' THEN f.value:"string_value"::STRING END ) AS "url"
  FROM   "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t,
         LATERAL FLATTEN ( input => t."EVENT_PARAMS") f
  WHERE  t."EVENT_NAME" = 'page_view'
  GROUP  BY t."EVENT_TIMESTAMP"
),
session_flags AS (
  SELECT  "session_id",
          SUM( CASE WHEN "url" ILIKE '%+%' THEN 1 ELSE 0 END ) > 0  AS has_pdp
  FROM    pages
  GROUP   BY "session_id"
)
SELECT  
        SUM( CASE WHEN p."url" NOT ILIKE '%+%' THEN 1 ELSE 0 END )                                        AS total_plp_views,
        SUM( CASE WHEN p."url" NOT ILIKE '%+%' AND sf.has_pdp THEN 1 ELSE 0 END )                         AS plp_views_with_pdp_session,
        ROUND( 100 * SUM( CASE WHEN p."url" NOT ILIKE '%+%' AND sf.has_pdp THEN 1 ELSE 0 END ) 
                   / NULLIF( SUM( CASE WHEN p."url" NOT ILIKE '%+%' THEN 1 ELSE 0 END ), 0 ), 2 )         AS pct_plp_to_pdp
FROM    pages p
JOIN    session_flags sf USING ("session_id")
LIMIT 20;
```

```sql
--Description: 10)  Final query – condensed version that produces total PLP views, PLP views leading to PDP, and the percentage
WITH page_views AS (
  SELECT  
         MAX( CASE WHEN f.key = 'ga_session_id'  THEN f.value:"int_value"::NUMBER  END ) AS "session_id",
         MAX( CASE WHEN f.key = 'page_location' THEN f.value:"string_value"::STRING END ) AS "url"
  FROM   "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t,
         LATERAL FLATTEN ( input => t."EVENT_PARAMS") f
  WHERE  t."EVENT_NAME" = 'page_view'
  GROUP  BY t."EVENT_TIMESTAMP"
),
sessions AS (
  SELECT  "session_id",
          MAX( CASE WHEN "url" ILIKE '%+%' THEN 1 ELSE 0 END ) AS has_pdp
  FROM    page_views
  GROUP   BY "session_id"
),
plp AS (
  SELECT  pv.*, s.has_pdp
  FROM    page_views  pv
  JOIN    sessions    s  USING ("session_id")
  WHERE   pv."url" NOT ILIKE '%+%'
)
SELECT  COUNT(*)                                                  AS total_plp_views,
        COUNT_IF( has_pdp = 1 )                                   AS plp_views_with_pdp_session,
        ROUND( 100 * COUNT_IF( has_pdp = 1 ) / NULLIF(COUNT(*),0), 2)  AS pct_plp_to_pdp
FROM    plp
LIMIT 20;
```
