```sql
--Description: 10)  Calculate PLP-to-PDP transitions: count PLP views that have a later PDP in the same session and compute the percentage.
SELECT 
       COUNT(DISTINCT plp."plp_event_id")                                     AS "plp_with_subsequent_pdp",
       COUNT(*) OVER ()                                                      AS "total_plp_views",
       (COUNT(DISTINCT plp."plp_event_id") * 100.0) / 
       NULLIF(COUNT(*) OVER (),0)                                            AS "plp_to_pdp_pct"
FROM
(
    -- all PLP views with row_number inside session
    SELECT
           t."ROW_ID"                                            AS "plp_event_id",   -- pseudo unique row id if exists
           t."USER_PSEUDO_ID",
           g.value:"int_value"::NUMBER                           AS "ga_session_id",
           t."EVENT_TIMESTAMP"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") p,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") g
    WHERE t."EVENT_NAME"       = 'page_view'
      AND p.value:"key"::STRING = 'page_location'
      AND g.value:"key"::STRING = 'ga_session_id'
      AND p.value:"string_value"::STRING NOT ILIKE '%+%'
      AND (
             p.value:"string_value"::STRING ILIKE '%Accessories%'         OR
             p.value:"string_value"::STRING ILIKE '%Apparel%'            OR
             p.value:"string_value"::STRING ILIKE '%Brands%'             OR
             p.value:"string_value"::STRING ILIKE '%Campus%Collection%'  OR
             p.value:"string_value"::STRING ILIKE '%Drinkware%'          OR
             p.value:"string_value"::STRING ILIKE '%Electronics%'        OR
             p.value:"string_value"::STRING ILIKE '%Google%Redesign%'    OR
             p.value:"string_value"::STRING ILIKE '%Lifestyle%'          OR
             p.value:"string_value"::STRING ILIKE '%Nest%'               OR
             p.value:"string_value"::STRING ILIKE '%New%2015%Logo%'      OR
             p.value:"string_value"::STRING ILIKE '%Notebooks%Journals%' OR
             p.value:"string_value"::STRING ILIKE '%Office%'             OR
             p.value:"string_value"::STRING ILIKE '%Shop%by%Brand%'      OR
             p.value:"string_value"::STRING ILIKE '%Small%Goods%'        OR
             p.value:"string_value"::STRING ILIKE '%Stationery%'         OR
             p.value:"string_value"::STRING ILIKE '%Wearables%'
          )
) plp
JOIN
(
    -- all PDP views
    SELECT
           t."USER_PSEUDO_ID",
           g.value:"int_value"::NUMBER   AS "ga_session_id",
           t."EVENT_TIMESTAMP"           AS "pdp_time"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") p,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") g
    WHERE t."EVENT_NAME"       = 'page_view'
      AND p.value:"key"::STRING = 'page_location'
      AND g.value:"key"::STRING = 'ga_session_id'
      AND p.value:"string_value"::STRING ILIKE '%+%'
      AND (
             p.value:"string_value"::STRING ILIKE '%Accessories%'         OR
             p.value:"string_value"::STRING ILIKE '%Apparel%'            OR
             p.value:"string_value"::STRING ILIKE '%Brands%'             OR
             p.value:"string_value"::STRING ILIKE '%Campus%Collection%'  OR
             p.value:"string_value"::STRING ILIKE '%Drinkware%'          OR
             p.value:"string_value"::STRING ILIKE '%Electronics%'        OR
             p.value:"string_value"::STRING ILIKE '%Google%Redesign%'    OR
             p.value:"string_value"::STRING ILIKE '%Lifestyle%'          OR
             p.value:"string_value"::STRING ILIKE '%Nest%'               OR
             p.value:"string_value"::STRING ILIKE '%New%2015%Logo%'      OR
             p.value:"string_value"::STRING ILIKE '%Notebooks%Journals%' OR
             p.value:"string_value"::STRING ILIKE '%Office%'             OR
             p.value:"string_value"::STRING ILIKE '%Shop%by%Brand%'      OR
             p.value:"string_value"::STRING ILIKE '%Small%Goods%'        OR
             p.value:"string_value"::STRING ILIKE '%Stationery%'         OR
             p.value:"string_value"::STRING ILIKE '%Wearables%'
          )
) pdp
ON  plp."USER_PSEUDO_ID" = pdp."USER_PSEUDO_ID"
AND plp."ga_session_id"  = pdp."ga_session_id"
AND pdp."pdp_time"       > plp."EVENT_TIMESTAMP"
LIMIT 20;
```

