--Description: 10)  Calculate PLP-to-PDP transitions: number of PLP views that are followed by a PDP in the same session and their percentage of all PLP views (correct JSON paths, use EVENT_TIMESTAMP as unique id). 
WITH plp AS (
    SELECT 
           t."USER_PSEUDO_ID",
           g.value:"value":"int_value"::NUMBER AS "ga_session_id",
           t."EVENT_TIMESTAMP"                 AS "plp_time"
    FROM   GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
           LATERAL FLATTEN(input => t."EVENT_PARAMS") p,
           LATERAL FLATTEN(input => t."EVENT_PARAMS") g
    WHERE  t."EVENT_NAME"              = 'page_view'
      AND  p.value:"key"::STRING       = 'page_location'
      AND  g.value:"key"::STRING       = 'ga_session_id'
      AND  p.value:"value":"string_value"::STRING NOT ILIKE '%+%'
      AND (   p.value:"value":"string_value"::STRING ILIKE '%Accessories%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Apparel%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Brands%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Campus%Collection%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Drinkware%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Electronics%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Google%Redesign%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Lifestyle%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Nest%'
           OR p.value:"value":"string_value"::STRING ILIKE '%New%2015%Logo%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Notebooks%Journals%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Office%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Shop%by%Brand%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Small%Goods%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Stationery%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Wearables%' )
), pdp AS (
    SELECT 
           t."USER_PSEUDO_ID",
           g.value:"value":"int_value"::NUMBER AS "ga_session_id",
           t."EVENT_TIMESTAMP"                 AS "pdp_time"
    FROM   GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
           LATERAL FLATTEN(input => t."EVENT_PARAMS") p,
           LATERAL FLATTEN(input => t."EVENT_PARAMS") g
    WHERE  t."EVENT_NAME"              = 'page_view'
      AND  p.value:"key"::STRING       = 'page_location'
      AND  g.value:"key"::STRING       = 'ga_session_id'
      AND  p.value:"value":"string_value"::STRING ILIKE '%+%'
      AND (   p.value:"value":"string_value"::STRING ILIKE '%Accessories%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Apparel%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Brands%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Campus%Collection%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Drinkware%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Electronics%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Google%Redesign%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Lifestyle%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Nest%'
           OR p.value:"value":"string_value"::STRING ILIKE '%New%2015%Logo%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Notebooks%Journals%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Office%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Shop%by%Brand%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Small%Goods%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Stationery%'
           OR p.value:"value":"string_value"::STRING ILIKE '%Wearables%' )
), transitions AS (
    SELECT DISTINCT plp."USER_PSEUDO_ID", plp."ga_session_id", plp."plp_time"
    FROM   plp
    JOIN   pdp
      ON   plp."USER_PSEUDO_ID" = pdp."USER_PSEUDO_ID"
     AND   plp."ga_session_id"  = pdp."ga_session_id"
     AND   pdp."pdp_time"       > plp."plp_time"
)
SELECT 
       (SELECT COUNT(*) FROM transitions)                      AS "plp_with_subsequent_pdp",
       (SELECT COUNT(*) FROM plp)                              AS "total_plp_views",
       ( (SELECT COUNT(*) FROM transitions) * 100.0) /
         NULLIF((SELECT COUNT(*) FROM plp), 0)                 AS "plp_to_pdp_pct"
LIMIT 20
