```sql
--Description: 8) Count total PLP views per (user, session) on 2-Jan-2021
WITH pages AS (
    SELECT t."USER_PSEUDO_ID",
           ep_sess.value:"int_value"::NUMBER                          AS "ga_session_id",
           ep_loc.value:"string_value"::STRING                        AS "page_location"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_loc,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_sess
    WHERE t."EVENT_NAME" = 'page_view'
      AND ep_loc.value:"key"::STRING  = 'page_location'
      AND ep_sess.value:"key"::STRING = 'ga_session_id'
      -- basic PLP rule (see step 6)
      AND ARRAY_SIZE(SPLIT(ep_loc.value:"string_value"::STRING, '/')) >= 5
      AND POSITION('+', SPLIT_PART(ep_loc.value:"string_value"::STRING, '/', -1)) = 0
)
SELECT COUNT(*) AS "plp_views"
FROM pages
LIMIT 20;
```

```sql
--Description: 9) Identify PLP views that have at least one PDP view later in the same session
WITH pages AS (
    SELECT t."USER_PSEUDO_ID",
           ep_sess.value:"int_value"::NUMBER          AS "ga_session_id",
           ep_loc.value:"string_value"::STRING        AS "page_location",
           t."EVENT_TIMESTAMP"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_loc,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_sess
    WHERE t."EVENT_NAME" = 'page_view'
      AND ep_loc.value:"key"::STRING  = 'page_location'
      AND ep_sess.value:"key"::STRING = 'ga_session_id'
), plp AS (
    SELECT *
    FROM pages
    WHERE ARRAY_SIZE(SPLIT("page_location", '/')) >= 5
      AND POSITION('+', SPLIT_PART("page_location", '/', -1)) = 0
), pdp AS (
    SELECT *
    FROM pages
    WHERE ARRAY_SIZE(SPLIT("page_location", '/')) >= 5
      AND POSITION('+', SPLIT_PART("page_location", '/', -1)) > 0
)
SELECT COUNT(DISTINCT plp."USER_PSEUDO_ID" || '-' || plp."EVENT_TIMESTAMP") AS "plp_with_pdp_later"
FROM plp
JOIN pdp
  ON plp."USER_PSEUDO_ID" = pdp."USER_PSEUDO_ID"
 AND plp."ga_session_id"  = pdp."ga_session_id"
 AND plp."EVENT_TIMESTAMP" < pdp."EVENT_TIMESTAMP"
LIMIT 20;
```

```sql
--Description: 10) Compute final PLP-to-PDP transition percentage for 2-Jan-2021
WITH pages AS (
    SELECT t."USER_PSEUDO_ID",
           ep_sess.value:"int_value"::NUMBER          AS "ga_session_id",
           ep_loc.value:"string_value"::STRING        AS "page_location",
           t."EVENT_TIMESTAMP"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_loc,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_sess
    WHERE t."EVENT_NAME" = 'page_view'
      AND ep_loc.value:"key"::STRING  = 'page_location'
      AND ep_sess.value:"key"::STRING = 'ga_session_id'
), plp AS (
    SELECT *
    FROM pages
    WHERE ARRAY_SIZE(SPLIT("page_location", '/')) >= 5
      AND POSITION('+', SPLIT_PART("page_location", '/', -1)) = 0
), pdp AS (
    SELECT *
    FROM pages
    WHERE ARRAY_SIZE(SPLIT("page_location", '/')) >= 5
      AND POSITION('+', SPLIT_PART("page_location", '/', -1)) > 0
), plp_with_pdp AS (
    SELECT DISTINCT plp."USER_PSEUDO_ID", plp."EVENT_TIMESTAMP"
    FROM plp
    JOIN pdp
      ON plp."USER_PSEUDO_ID" = pdp."USER_PSEUDO_ID"
     AND plp."ga_session_id"  = pdp."ga_session_id"
     AND plp."EVENT_TIMESTAMP" < pdp."EVENT_TIMESTAMP"
), summary AS (
    SELECT (SELECT COUNT(*) FROM plp_with_pdp)                        AS "plp_that_led_to_pdp",
           (SELECT COUNT(*) FROM plp)                                 AS "total_plp",
           (SELECT COUNT(*) FROM plp_with_pdp) * 100.0 / NULLIF((SELECT COUNT(*) FROM plp),0) AS "plp_to_pdp_percentage"
)
SELECT *
FROM summary
LIMIT 20;
```
