                               CASE  
                                   WHEN ARRAY_SIZE( SPLIT( pl2.value:"string_value"::STRING, '/' ) ) >= 5  
                                        AND POSITION( '+', SPLIT_PART( pl2.value:"string_value"::STRING, '/', -1 ) ) > 0  
                                        AND REGEXP_LIKE( pl2.value:"string_value"::STRING, '(Accessories|Apparel|Brands|Campus Collection|Drinkware|Electronics|Google Redesign|Lifestyle|Nest|New 2015 Logo|Notebooks Journals|Office|Shop by Brand|Small Goods|Stationery|Wearables)' )  
                                        THEN 'PDP'  
                                   ELSE 'OTHER'  
                               END AS "page_type"  
                        FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102"  t2,  
