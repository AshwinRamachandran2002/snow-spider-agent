```sql
--Description: 8)  For every session, find the earliest PLP view and check if a PDP view occurs later in the same session.  
SELECT DISTINCT  
       p."ga_session_id"  
FROM ( /* classified page views */  
         SELECT  
                gi.value:"int_value"::NUMBER    AS "ga_session_id",  
                pl.value:"string_value"::STRING AS "page_location",  
                t."EVENT_TIMESTAMP",  
                CASE  
                    WHEN ARRAY_SIZE( SPLIT( pl.value:"string_value"::STRING, '/' ) ) >= 5  
                         AND POSITION( '+', SPLIT_PART( pl.value:"string_value"::STRING, '/', -1 ) ) = 0  
                         AND REGEXP_LIKE( pl.value:"string_value"::STRING, '(Accessories|Apparel|Brands|Campus Collection|Drinkware|Electronics|Google Redesign|Lifestyle|Nest|New 2015 Logo|Notebooks Journals|Office|Shop by Brand|Small Goods|Stationery|Wearables)' )  
                         THEN 'PLP'  
                    WHEN ARRAY_SIZE( SPLIT( pl.value:"string_value"::STRING, '/' ) ) >= 5  
                         AND POSITION( '+', SPLIT_PART( pl.value:"string_value"::STRING, '/', -1 ) ) > 0  
                         AND REGEXP_LIKE( pl.value:"string_value"::STRING, '(Accessories|Apparel|Brands|Campus Collection|Drinkware|Electronics|Google Redesign|Lifestyle|Nest|New 2015 Logo|Notebooks Journals|Office|Shop by Brand|Small Goods|Stationery|Wearables)' )  
                         THEN 'PDP'  
                    ELSE 'OTHER'  
                END AS "page_type"  
         FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102"  t,  
              LATERAL FLATTEN( INPUT => t."EVENT_PARAMS" ) pl,  
              LATERAL FLATTEN( INPUT => t."EVENT_PARAMS" ) gi  
         WHERE t."EVENT_NAME" = 'page_view'  
           AND pl.value:"key"::STRING = 'page_location'  
           AND gi.value:"key"::STRING = 'ga_session_id'  
     ) p  
QUALIFY "page_type" = 'PLP'  
AND EXISTS (  
       SELECT 1  
       FROM ( /* same derived table */  
                SELECT  
                       gi2.value:"int_value"::NUMBER    AS "ga_session_id",  
                       pl2.value:"string_value"::STRING AS "page_location",  
                       t2."EVENT_TIMESTAMP",  
                       CASE  
                           WHEN ARRAY_SIZE( SPLIT( pl2.value:"string_value"::STRING, '/' ) ) >= 5  
                                AND POSITION( '+', SPLIT_PART( pl2.value:"string_value"::STRING, '/', -1 ) ) > 0  
                                AND REGEXP_LIKE( pl2.value:"string_value"::STRING, '(Accessories|Apparel|Brands|Campus Collection|Drinkware|Electronics|Google Redesign|Lifestyle|Nest|New 2015 Logo|Notebooks Journals|Office|Shop by Brand|Small Goods|Stationery|Wearables)' )  
                                THEN 'PDP'  
                           ELSE 'OTHER'  
                       END AS "page_type"  
                FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102"  t2,  
                     LATERAL FLATTEN( INPUT => t2."EVENT_PARAMS" ) pl2,  
                     LATERAL FLATTEN( INPUT => t2."EVENT_PARAMS" ) gi2  
                WHERE t2."EVENT_NAME" = 'page_view'  
                  AND pl2.value:"key"::STRING = 'page_location'  
                  AND gi2.value:"key"::STRING = 'ga_session_id'  
                ) pdp  
       WHERE pdp."ga_session_id" = p."ga_session_id"  
         AND pdp."page_type"  = 'PDP'  
         AND pdp."EVENT_TIMESTAMP" > p."EVENT_TIMESTAMP"  
)  
LIMIT 20;
