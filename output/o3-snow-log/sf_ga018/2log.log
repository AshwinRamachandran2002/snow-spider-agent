```sql
--Description: 6)  Add a simple CASE statement that tags each URL as PLP, PDP, or OTHER using the refined classification rules (first 20 rows shown).  
SELECT  
       s."ga_session_id",  
       s."page_location",  
       CASE  
           WHEN ARRAY_SIZE( SPLIT( s."page_location", '/' ) ) >= 5  
                AND POSITION( '+', SPLIT_PART( s."page_location", '/', -1 ) ) = 0  
                AND REGEXP_LIKE( s."page_location", '(Accessories|Apparel|Brands|Campus Collection|Drinkware|Electronics|Google Redesign|Lifestyle|Nest|New 2015 Logo|Notebooks Journals|Office|Shop by Brand|Small Goods|Stationery|Wearables)' )  
                THEN 'PLP'  
           WHEN ARRAY_SIZE( SPLIT( s."page_location", '/' ) ) >= 5  
                AND POSITION( '+', SPLIT_PART( s."page_location", '/', -1 ) ) > 0  
                AND REGEXP_LIKE( s."page_location", '(Accessories|Apparel|Brands|Campus Collection|Drinkware|Electronics|Google Redesign|Lifestyle|Nest|New 2015 Logo|Notebooks Journals|Office|Shop by Brand|Small Goods|Stationery|Wearables)' )  
                THEN 'PDP'  
           ELSE 'OTHER'  
       END                                             AS "page_type"  
FROM (  
         SELECT  
                gi.value:"int_value"::NUMBER    AS "ga_session_id",  
                pl.value:"string_value"::STRING AS "page_location",  
                t."EVENT_TIMESTAMP"  
         FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102"  t,  
              LATERAL FLATTEN( INPUT => t."EVENT_PARAMS" ) pl,  
              LATERAL FLATTEN( INPUT => t."EVENT_PARAMS" ) gi  
         WHERE t."EVENT_NAME" = 'page_view'  
           AND pl.value:"key"::STRING = 'page_location'  
           AND gi.value:"key"::STRING = 'ga_session_id'  
     ) s  
LIMIT 20;
