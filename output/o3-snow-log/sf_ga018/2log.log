                                THEN 'PLP'  
                           WHEN ARRAY_SIZE( SPLIT( pl.value:"string_value"::STRING, '/' ) ) >= 5  
                                AND POSITION( '+', SPLIT_PART( pl.value:"string_value"::STRING, '/', -1 ) ) > 0  
                                AND REGEXP_LIKE( pl.value:"string_value"::STRING, '(Accessories|Apparel|Brands|Campus Collection|Drinkware|Electronics|Google Redesign|Lifestyle|Nest|New 2015 Logo|Notebooks Journals|Office|Shop by Brand|Small Goods|Stationery|Wearables)' )  
