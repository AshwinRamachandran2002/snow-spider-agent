```sql
--Description: 9)  Count PLP page_views that were in sessions which also had at least one PDP.  
WITH urls AS (
    SELECT ep_pl.value:"int_value"::NUMBER   AS "ga_session_id",
           CASE
                WHEN ep_url.value:"string_value"::STRING ILIKE '%+%' THEN 'PDP'
                WHEN ep_url.value:"string_value"::STRING NOT ILIKE '%+%' AND
                     ( ep_url.value:"string_value"::STRING ILIKE '%Accessories%' OR
                       ep_url.value:"string_value"::STRING ILIKE '%Apparel%'     OR
                       ep_url.value:"string_value"::STRING ILIKE '%Drinkware%'   OR
                       ep_url.value:"string_value"::STRING ILIKE '%Electronics%' OR
                       ep_url.value:"string_value"::STRING ILIKE '%Lifestyle%'   OR
                       ep_url.value:"string_value"::STRING ILIKE '%Google%Redesign%' OR
                       ep_url.value:"string_value"::STRING ILIKE '%Wearables%' )
                     THEN 'PLP'
                ELSE 'OTHER'
           END                                            AS "page_type"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" e ,
         LATERAL FLATTEN(input => e."EVENT_PARAMS")             ep_url ,
         LATERAL FLATTEN(input => e."EVENT_PARAMS")             ep_pl
    WHERE e."EVENT_NAME" = 'page_view'
      AND ep_url.value:"key"::STRING = 'page_location'
      AND ep_pl.value:"key"::STRING  = 'ga_session_id'
), sessions AS (
    SELECT "ga_session_id"
    FROM urls
    GROUP BY "ga_session_id"
    HAVING MAX(CASE WHEN "page_type"='PLP' THEN 1 ELSE 0 END)=1
       AND MAX(CASE WHEN "page_type"='PDP' THEN 1 ELSE 0 END)=1
)
SELECT COUNT(*) AS "PLP_pageviews_that_lead_to_PDP"
FROM urls
WHERE "page_type"='PLP'
  AND "ga_session_id" IN (SELECT "ga_session_id" FROM sessions)
LIMIT 20;
```

```sql
--Description: 10)  Calculate the percentage of PLP views that transitioned to a PDP within the same session.  
WITH urls AS (
    SELECT ep_pl.value:"int_value"::NUMBER   AS "ga_session_id",
           CASE
                WHEN ep_url.value:"string_value"::STRING ILIKE '%+%' THEN 'PDP'
                WHEN ep_url.value:"string_value"::STRING NOT ILIKE '%+%' AND
                     ( ep_url.value:"string_value"::STRING ILIKE '%Accessories%' OR
                       ep_url.value:"string_value"::STRING ILIKE '%Apparel%'     OR
                       ep_url.value:"string_value"::STRING ILIKE '%Drinkware%'   OR
                       ep_url.value:"string_value"::STRING ILIKE '%Electronics%' OR
                       ep_url.value:"string_value"::STRING ILIKE '%Lifestyle%'   OR
                       ep_url.value:"string_value"::STRING ILIKE '%Google%Redesign%' OR
                       ep_url.value:"string_value"::STRING ILIKE '%Wearables%' )
                     THEN 'PLP'
                ELSE 'OTHER'
           END                                            AS "page_type"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" e ,
         LATERAL FLATTEN(input => e."EVENT_PARAMS")             ep_url ,
         LATERAL FLATTEN(input => e."EVENT_PARAMS")             ep_pl
    WHERE e."EVENT_NAME" = 'page_view'
      AND ep_url.value:"key"::STRING = 'page_location'
      AND ep_pl.value:"key"::STRING  = 'ga_session_id'
), sessions AS (
    SELECT "ga_session_id"
    FROM urls
    GROUP BY "ga_session_id"
    HAVING MAX(CASE WHEN "page_type"='PLP' THEN 1 ELSE 0 END)=1
       AND MAX(CASE WHEN "page_type"='PDP' THEN 1 ELSE 0 END)=1
), counts AS (
    SELECT
        (SELECT COUNT(*) FROM urls WHERE "page_type"='PLP')                                        AS total_plp,
        (SELECT COUNT(*) FROM urls WHERE "page_type"='PLP' AND "ga_session_id" IN (SELECT "ga_session_id" FROM sessions))  AS plp_to_pdp
)
SELECT 
       total_plp,
       plp_to_pdp,
       (plp_to_pdp * 100.0) / NULLIF(total_plp,0)  AS "PLP_to_PDP_Percentage"
FROM counts
LIMIT 20;
```
