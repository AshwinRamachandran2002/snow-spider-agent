        ep_loc.value:"value"."string_value" ILIKE '%/Brands/%'       OR
        ep_loc.value:"value"."string_value" ILIKE '%/Drinkware/%'    OR
        ep_loc.value:"value"."string_value" ILIKE '%/Electronics/%'  OR
        ep_loc.value:"value"."string_value" ILIKE '%/Google%Redesign/%' OR
        ep_loc.value:"value"."string_value" ILIKE '%/Lifestyle/%'    OR
        ep_loc.value:"value"."string_value" ILIKE '%/Nest/%'         OR
        ep_loc.value:"value"."string_value" ILIKE '%/Office/%'       OR
        ep_loc.value:"value"."string_value" ILIKE '%/Stationery/%'   OR
        ep_loc.value:"value"."string_value" ILIKE '%/Wearables/%'
      )
  AND ep_loc.value:"value"."string_value" NOT ILIKE '%+%'
LIMIT 20;
```

