Query:
--Description: Corrected version of earlier “query 10” using the same simplified
--              classification logic as the working query (PLP = URL w/out “+”; 
--              PDP = URL with “+”).  It counts sessions that include at least one
--              PLP view and then measures how many of those sessions also contain
--              a PDP view, finally returning the percentage.
WITH page_views AS (           --1. pull every page_view URL + session id
    SELECT
        t."USER_PSEUDO_ID",
        s.value:"value"."int_value"::NUMBER            AS "session_id",
        l.value:"value"."string_value"::STRING         AS "url"
    FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") l,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") s
    WHERE t."EVENT_NAME"        = 'page_view'
      AND l.value:"key"::STRING = 'page_location'
      AND s.value:"key"::STRING = 'ga_session_id'
      AND l.value:"value"."string_value" IS NOT NULL
),
plp_flagged AS (               --2. tag each view as PLP or PDP
    SELECT
        "USER_PSEUDO_ID",
        "session_id",
        CASE WHEN "url" ILIKE '%+%' THEN 0 ELSE 1 END AS is_plp,
        CASE WHEN "url" ILIKE '%+%' THEN 1 ELSE 0 END AS is_pdp
    FROM page_views
),
session_rollup AS (            --3. session-level flags
    SELECT
        "USER_PSEUDO_ID",
        "session_id",
        MAX(is_plp) AS has_plp,
        MAX(is_pdp) AS has_pdp
    FROM plp_flagged
    GROUP BY 1,2
),
stats AS (                     --4. aggregate counts
    SELECT
        COUNT_IF(has_plp = 1)                                   AS total_plp_sessions,
        COUNT_IF(has_plp = 1 AND has_pdp = 1)                   AS plp_to_pdp_sessions
    FROM session_rollup
)
--5. final output
SELECT
    total_plp_sessions,
    plp_to_pdp_sessions,
    ROUND(plp_to_pdp_sessions * 100.0 / NULLIF(total_plp_sessions,0), 2) 
        AS plp_to_pdp_percentage
FROM stats
