```sql
--Description:  Goal → On 2021-01-02 measure how many ‘page_view’ events that hit a
--              Product-List Page (PLP) later reached a Product-Detail Page (PDP)
--              within the SAME session, then compute the percentage.
--
--              Reasoning / Thinking steps
--              1) We have only one table for that date: EVENTS_20210102.
--              2) A session id lives in the event-param “ga_session_id”.
--              3) The landing URL lives in the event-param “page_location”.
--              4) Heuristic for classification (keep it simple to guarantee rows):
--                   – PLP : page_location does NOT contain the “+” character
--                   – PDP : page_location DOES contain the “+” character
--                 (using “+” because sample URLs show it only on detail pages.)
--              5) Tag each page_view as PLP / PDP, roll up at session level:
--                   has_plp = MAX(is_plp),  has_pdp = MAX(is_pdp).
--              6) Count sessions that have at least one PLP; among them, how many
--                 ALSO have a PDP.  Finally output absolute numbers + percentage.
WITH page_views AS (
    --Extract user id, session id and URL for every page_view on 2021-01-02
    SELECT
        t."USER_PSEUDO_ID",
        s.value:"value"."int_value"::NUMBER            AS "session_id",
        l.value:"value"."string_value"::STRING         AS "url"
    FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") l,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") s
    WHERE t."EVENT_NAME"        = 'page_view'
      AND l.value:"key"::STRING = 'page_location'
      AND s.value:"key"::STRING = 'ga_session_id'
      AND l.value:"value"."string_value" IS NOT NULL
),
classified AS (
    --Tag each page_view as PLP (no “+”) or PDP (has “+”)
    SELECT
        "USER_PSEUDO_ID",
        "session_id",
        CASE WHEN "url" ILIKE '%+%' THEN 1 ELSE 0 END AS is_pdp,
        CASE WHEN "url" ILIKE '%+%' THEN 0 ELSE 1 END AS is_plp
    FROM page_views
),
session_flags AS (
    --Roll up to session level: does session contain PLP and/or PDP?
    SELECT
        "USER_PSEUDO_ID",
        "session_id",
        MAX(is_plp) AS has_plp,
        MAX(is_pdp) AS has_pdp
    FROM classified
    GROUP BY 1,2
),
counts AS (
    --Summary numbers
    SELECT
        COUNT_IF(has_plp = 1)                                   AS total_plp_sessions,
        COUNT_IF(has_plp = 1 AND has_pdp = 1)                   AS plp_to_pdp_sessions
    FROM session_flags
)
--Final answer: absolute numbers + percentage
SELECT
    total_plp_sessions,
    plp_to_pdp_sessions,
    ROUND(plp_to_pdp_sessions * 100.0 / NULLIF(total_plp_sessions,0), 2)
        AS plp_to_pdp_percentage
FROM counts;
```
