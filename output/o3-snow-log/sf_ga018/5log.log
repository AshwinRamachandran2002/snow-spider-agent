```sql
--Description: 8) Aggregate PLP page_views by user + session (ga_session_id)
WITH page_views AS (
    SELECT 
           t."USER_PSEUDO_ID",
           ep_ses.value:"value"."int_value"::NUMBER   AS "ga_session_id",
           ep_loc.value:"value"."string_value"::STRING AS "page_location"
    FROM  "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t
          ,LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_loc
          ,LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_ses
    WHERE t."EVENT_NAME" = 'page_view'
      AND ep_loc.value:"key"::STRING = 'page_location'
      AND ep_ses.value:"key"::STRING = 'ga_session_id'
)
SELECT 
       "USER_PSEUDO_ID",
       "ga_session_id",
       COUNT(*) AS "plp_views"
FROM page_views
WHERE "page_location" NOT ILIKE '%+%'  --exclude PDP
  AND (
        "page_location" ILIKE '%/Accessories/%'  OR
        "page_location" ILIKE '%/Apparel/%'      OR
        "page_location" ILIKE '%/Brands/%'       OR
        "page_location" ILIKE '%/Drinkware/%'    OR
        "page_location" ILIKE '%/Electronics/%'  OR
        "page_location" ILIKE '%/Google%Redesign/%' OR
        "page_location" ILIKE '%/Lifestyle/%'    OR
        "page_location" ILIKE '%/Nest/%'         OR
        "page_location" ILIKE '%/Office/%'       OR
        "page_location" ILIKE '%/Stationery/%'   OR
        "page_location" ILIKE '%/Wearables/%'
      )
GROUP BY 1,2
LIMIT 20;
```

```sql
--Description: 9) Identify sessions that contain at least one PLP view AND at least one PDP view
WITH page_views AS (
    SELECT 
           t."USER_PSEUDO_ID",
           ep_ses.value:"value"."int_value"::NUMBER   AS "ga_session_id",
           ep_loc.value:"value"."string_value"::STRING AS "page_location"
    FROM  "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t
          ,LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_loc
          ,LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_ses
    WHERE t."EVENT_NAME" = 'page_view'
      AND ep_loc.value:"key"::STRING = 'page_location'
      AND ep_ses.value:"key"::STRING = 'ga_session_id'
),
flags AS (
    SELECT 
           "USER_PSEUDO_ID",
           "ga_session_id",
           MAX(CASE WHEN "page_location" NOT ILIKE '%+%' 
                     AND (
                          "page_location" ILIKE '%/Accessories/%'  OR
                          "page_location" ILIKE '%/Apparel/%'      OR
                          "page_location" ILIKE '%/Brands/%'       OR
                          "page_location" ILIKE '%/Drinkware/%'    OR
                          "page_location" ILIKE '%/Electronics/%'  OR
                          "page_location" ILIKE '%/Google%Redesign/%' OR
                          "page_location" ILIKE '%/Lifestyle/%'    OR
                          "page_location" ILIKE '%/Nest/%'         OR
                          "page_location" ILIKE '%/Office/%'       OR
                          "page_location" ILIKE '%/Stationery/%'   OR
                          "page_location" ILIKE '%/Wearables/%'
                         )
                THEN 1 END) AS "has_plp",
           MAX(CASE WHEN "page_location" ILIKE '%+%' THEN 1 END)  AS "has_pdp"
    FROM page_views
    GROUP BY 1,2
)
SELECT * 
FROM flags 
WHERE "has_plp" = 1 AND "has_pdp" = 1
LIMIT 20;
```

```sql
--Description: 10) Calculate total PLP views, PLP views that lead to a PDP, and resulting percentage
WITH page_views AS (
    SELECT 
           t."USER_PSEUDO_ID",
           ep_ses.value:"value"."int_value"::NUMBER   AS "ga_session_id",
           ep_loc.value:"value"."string_value"::STRING AS "page_location"
    FROM  "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t
          ,LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_loc
          ,LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_ses
    WHERE t."EVENT_NAME" = 'page_view'
      AND ep_loc.value:"key"::STRING = 'page_location'
      AND ep_ses.value:"key"::STRING = 'ga_session_id'
),
plp_flagged AS (
    SELECT 
           *,
           CASE WHEN "page_location" NOT ILIKE '%+%' 
                     AND (
                          "page_location" ILIKE '%/Accessories/%'  OR
                          "page_location" ILIKE '%/Apparel/%'      OR
                          "page_location" ILIKE '%/Brands/%'       OR
                          "page_location" ILIKE '%/Drinkware/%'    OR
                          "page_location" ILIKE '%/Electronics/%'  OR
                          "page_location" ILIKE '%/Google%Redesign/%' OR
                          "page_location" ILIKE '%/Lifestyle/%'    OR
                          "page_location" ILIKE '%/Nest/%'         OR
                          "page_location" ILIKE '%/Office/%'       OR
                          "page_location" ILIKE '%/Stationery/%'   OR
                          "page_location" ILIKE '%/Wearables/%'
                         ) 
                THEN 1 ELSE 0 END AS "is_plp",
           CASE WHEN "page_location" ILIKE '%+%' THEN 1 ELSE 0 END AS "is_pdp"
    FROM page_views
),
session_rollup AS (
    SELECT 
           "USER_PSEUDO_ID",
           "ga_session_id",
           MAX("is_plp") AS "has_plp",
           MAX("is_pdp") AS "has_pdp"
    FROM plp_flagged
    GROUP BY 1,2
),
stats AS (
    SELECT 
          SUM(CASE WHEN "has_plp" = 1 THEN 1 END)                              AS "total_plp_sessions",
          SUM(CASE WHEN "has_plp" = 1 AND "has_pdp" = 1 THEN 1 END)            AS "plp_to_pdp_sessions"
    FROM session_rollup
)
SELECT 
      "total_plp_sessions",
      "plp_to_pdp_sessions",
      ( "plp_to_pdp_sessions" * 100.0 / NULLIF("total_plp_sessions",0) ) 
      AS "plp_to_pdp_percentage"
FROM stats;
```
