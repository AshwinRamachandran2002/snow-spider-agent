--Description: 8) Aggregate PLP page_views by user + session (ga_session_id)
WITH page_views AS (
    SELECT 
           t."USER_PSEUDO_ID",
           ep_ses.value:"value"."int_value"::NUMBER   AS "ga_session_id",
           ep_loc.value:"value"."string_value"::STRING AS "page_location"
    FROM  "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" t
          ,LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_loc
          ,LATERAL FLATTEN(input => t."EVENT_PARAMS") ep_ses
    WHERE t."EVENT_NAME" = 'page_view'
      AND ep_loc.value:"key"::STRING = 'page_location'
      AND ep_ses.value:"key"::STRING = 'ga_session_id'
)
SELECT 
       "USER_PSEUDO_ID",
       "ga_session_id",
       COUNT(*) AS "plp_views"
FROM page_views
WHERE "page_location" NOT ILIKE '%+%'  --exclude PDP
  AND (
        "page_location" ILIKE '%/Accessories/%'  OR
        "page_location" ILIKE '%/Apparel/%'      OR
        "page_location" ILIKE '%/Brands/%'       OR
        "page_location" ILIKE '%/Drinkware/%'    OR
        "page_location" ILIKE '%/Electronics/%'  OR
        "page_location" ILIKE '%/Google%Redesign/%' OR
        "page_location" ILIKE '%/Lifestyle/%'    OR
        "page_location" ILIKE '%/Nest/%'         OR
        "page_location" ILIKE '%/Office/%'       OR
        "page_location" ILIKE '%/Stationery/%'   OR
        "page_location" ILIKE '%/Wearables/%'
      )
GROUP BY 1,2
LIMIT 20;
