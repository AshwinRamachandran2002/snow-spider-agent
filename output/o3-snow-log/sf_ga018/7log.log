```sql
--Description: 9) Show sessions that contain at least one PLP view followed by a PDP view (ordered by timestamp)
WITH plp AS (
  SELECT 
    gs.value:"value":"int_value"::NUMBER AS "ga_session_id",
    MIN(e."EVENT_TIMESTAMP")             AS "first_plp_ts"
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" e
       ,LATERAL FLATTEN(input => e."EVENT_PARAMS") ep
       ,LATERAL FLATTEN(input => e."EVENT_PARAMS") gs
  WHERE e."EVENT_NAME" = 'page_view'
    AND ep.value:"key"::STRING = 'page_location'
    AND gs.value:"key"::STRING = 'ga_session_id'
    AND (
          ep.value:"value":"string_value"::STRING ILIKE '%Accessories%'  OR
          ep.value:"value":"string_value"::STRING ILIKE '%Apparel%'      OR
          ep.value:"value":"string_value"::STRING ILIKE '%Drinkware%'    OR
          ep.value:"value":"string_value"::STRING ILIKE '%Electronics%'  OR
          ep.value:"value":"string_value"::STRING ILIKE '%Lifestyle%'    OR
          ep.value:"value":"string_value"::STRING ILIKE '%Stationery%'   OR
          ep.value:"value":"string_value"::STRING ILIKE '%Wearables%'    OR
          ep.value:"value":"string_value"::STRING ILIKE '%Google%Redesign%'
        )
    AND ep.value:"value":"string_value"::STRING NOT ILIKE '%+%'
  GROUP BY 1
),
pdp AS (
  SELECT 
    gs.value:"value":"int_value"::NUMBER AS "ga_session_id",
    MIN(e."EVENT_TIMESTAMP")             AS "first_pdp_ts"
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" e
       ,LATERAL FLATTEN(input => e."EVENT_PARAMS") ep
       ,LATERAL FLATTEN(input => e."EVENT_PARAMS") gs
  WHERE e."EVENT_NAME" = 'page_view'
    AND ep.value:"key"::STRING = 'page_location'
    AND gs.value:"key"::STRING = 'ga_session_id'
    AND (
          ep.value:"value":"string_value"::STRING ILIKE '%Accessories%'  OR
          ep.value:"value":"string_value"::STRING ILIKE '%Apparel%'      OR
          ep.value:"value":"string_value"::STRING ILIKE '%Drinkware%'    OR
          ep.value:"value":"string_value"::STRING ILIKE '%Electronics%'  OR
          ep.value:"value":"string_value"::STRING ILIKE '%Lifestyle%'    OR
          ep.value:"value":"string_value"::STRING ILIKE '%Stationery%'   OR
          ep.value:"value":"string_value"::STRING ILIKE '%Wearables%'    OR
          ep.value:"value":"string_value"::STRING ILIKE '%Google%Redesign%'
        )
    AND ep.value:"value":"string_value"::STRING ILIKE '%+%'
  GROUP BY 1
)
SELECT 
  plp."ga_session_id",
  plp."first_plp_ts",
  pdp."first_pdp_ts"
FROM plp
JOIN pdp
  ON plp."ga_session_id" = pdp."ga_session_id"
  AND pdp."first_pdp_ts" > plp."first_plp_ts"
LIMIT 20;
```

```sql
--Description: 10) Calculate counts & percentage of PLP views that eventually led to a PDP within the same session on 2021-01-02
WITH all_plp AS (
  SELECT DISTINCT 
    gs.value:"value":"int_value"::NUMBER AS "ga_session_id"
  FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" e
       ,LATERAL FLATTEN(input => e."EVENT_PARAMS") ep
       ,LATERAL FLATTEN(input => e."EVENT_PARAMS") gs
  WHERE e."EVENT_NAME" = 'page_view'
    AND ep.value:"key"::STRING = 'page_location'
    AND gs.value:"key"::STRING = 'ga_session_id'
    AND (
          ep.value:"value":"string_value"::STRING ILIKE '%Accessories%'  OR
          ep.value:"value":"string_value"::STRING ILIKE '%Apparel%'      OR
          ep.value:"value":"string_value"::STRING ILIKE '%Drinkware%'    OR
          ep.value:"value":"string_value"::STRING ILIKE '%Electronics%'  OR
          ep.value:"value":"string_value"::STRING ILIKE '%Lifestyle%'    OR
          ep.value:"value":"string_value"::STRING ILIKE '%Stationery%'   OR
          ep.value:"value":"string_value"::STRING ILIKE '%Wearables%'    OR
          ep.value:"value":"string_value"::STRING ILIKE '%Google%Redesign%'
        )
    AND ep.value:"value":"string_value"::STRING NOT ILIKE '%+%'
), plp_to_pdp AS (
  SELECT DISTINCT
    plp."ga_session_id"
  FROM /* re-use CTE in query 9 for transitions */
    (
      SELECT 
        gs.value:"value":"int_value"::NUMBER AS "ga_session_id",
        MIN(e."EVENT_TIMESTAMP")             AS "plp_ts"
      FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" e
           ,LATERAL FLATTEN(input => e."EVENT_PARAMS") ep
           ,LATERAL FLATTEN(input => e."EVENT_PARAMS") gs
      WHERE e."EVENT_NAME" = 'page_view'
        AND ep.value:"key"::STRING = 'page_location'
        AND gs.value:"key"::STRING = 'ga_session_id'
        AND (
              ep.value:"value":"string_value"::STRING ILIKE '%Accessories%'  OR
              ep.value:"value":"string_value"::STRING ILIKE '%Apparel%'      OR
              ep.value:"value":"string_value"::STRING ILIKE '%Drinkware%'    OR
              ep.value:"value":"string_value"::STRING ILIKE '%Electronics%'  OR
              ep.value:"value":"string_value"::STRING ILIKE '%Lifestyle%'    OR
              ep.value:"value":"string_value"::STRING ILIKE '%Stationery%'   OR
              ep.value:"value":"string_value"::STRING ILIKE '%Wearables%'    OR
              ep.value:"value":"string_value"::STRING ILIKE '%Google%Redesign%'
            )
        AND ep.value:"value":"string_value"::STRING NOT ILIKE '%+%'
      GROUP BY 1
    ) plp
  JOIN (
      SELECT 
        gs.value:"value":"int_value"::NUMBER AS "ga_session_id",
        MIN(e."EVENT_TIMESTAMP")             AS "pdp_ts"
      FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" e
           ,LATERAL FLATTEN(input => e."EVENT_PARAMS") ep
           ,LATERAL FLATTEN(input => e."EVENT_PARAMS") gs
      WHERE e."EVENT_NAME" = 'page_view'
        AND ep.value:"key"::STRING = 'page_location'
        AND gs.value:"key"::STRING = 'ga_session_id'
        AND (
              ep.value:"value":"string_value"::STRING ILIKE '%Accessories%'  OR
              ep.value:"value":"string_value"::STRING ILIKE '%Apparel%'      OR
              ep.value:"value":"string_value"::STRING ILIKE '%Drinkware%'    OR
              ep.value:"value":"string_value"::STRING ILIKE '%Electronics%'  OR
              ep.value:"value":"string_value"::STRING ILIKE '%Lifestyle%'    OR
              ep.value:"value":"string_value"::STRING ILIKE '%Stationery%'   OR
              ep.value:"value":"string_value"::STRING ILIKE '%Wearables%'    OR
              ep.value:"value":"string_value"::STRING ILIKE '%Google%Redesign%'
            )
        AND ep.value:"value":"string_value"::STRING ILIKE '%+%'
      GROUP BY 1
    ) pdp
    ON plp."ga_session_id" = pdp."ga_session_id"
    AND pdp."pdp_ts" > plp."plp_ts"
)
SELECT 
  COUNT(DISTINCT all_plp."ga_session_id")                     AS "total_sessions_with_PLP",
  COUNT(DISTINCT plp_to_pdp."ga_session_id")                  AS "sessions_with_PLP_then_PDP",
  ROUND(
        COUNT(DISTINCT plp_to_pdp."ga_session_id") * 100.0
        / NULLIF(COUNT(DISTINCT all_plp."ga_session_id"),0)
       ,2)                                                    AS "plp_to_pdp_pct"
FROM all_plp
LEFT JOIN plp_to_pdp 
  ON all_plp."ga_session_id" = plp_to_pdp."ga_session_id"
LIMIT 20;
```

