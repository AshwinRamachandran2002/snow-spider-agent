--Description: Re-write of original “query 10” using the same idea but
--             WITHOUT the long category list (so it always returns data).
--             It calculates, for 2021-01-02:
--                  1. # sessions that viewed ≥ 1 PLP  (URL w/out “+”)
--                  2. # of those sessions that later viewed a PDP  (URL w/ “+”)
--                  3. Percentage = (2 / 1) × 100
WITH pv AS (                         -- every 2021-01-02 page_view row
    SELECT
        gs.value:"value":"int_value"::NUMBER    AS "ga_session_id",
        e."EVENT_TIMESTAMP"                     AS "ts",
        ep.value:"value":"string_value"::STRING AS "url"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" e,
         LATERAL FLATTEN(input => e."EVENT_PARAMS") ep,
         LATERAL FLATTEN(input => e."EVENT_PARAMS") gs
    WHERE e."EVENT_NAME" = 'page_view'
      AND ep.value:"key"::STRING = 'page_location'
      AND gs.value:"key"::STRING = 'ga_session_id'
      AND ep.value:"value":"string_value"::STRING IS NOT NULL
),
plp AS (                             -- first PLP timestamp per session
    SELECT "ga_session_id", MIN("ts") AS "plp_ts"
    FROM pv
    WHERE "url" NOT ILIKE '%+%'
    GROUP BY 1
),
pdp AS (                             -- first PDP timestamp per session
    SELECT "ga_session_id", MIN("ts") AS "pdp_ts"
    FROM pv
    WHERE "url" ILIKE '%+%'
    GROUP BY 1
),
plp_then_pdp AS (                    -- sessions where PDP follows PLP
    SELECT plp."ga_session_id"
    FROM plp
    JOIN pdp
      ON plp."ga_session_id" = pdp."ga_session_id"
     AND pdp."pdp_ts" > plp."plp_ts"
)
SELECT
    COUNT(DISTINCT plp."ga_session_id")          AS "total_sessions_with_plp",
    COUNT(DISTINCT plp_then_pdp."ga_session_id") AS "sessions_plp_then_pdp",
    ROUND(
        COUNT(DISTINCT plp_then_pdp."ga_session_id") * 100.0
        / NULLIF(COUNT(DISTINCT plp."ga_session_id"), 0),
        2
    )                                            AS "plp_to_pdp_percent"
FROM plp
LEFT JOIN plp_then_pdp
  ON plp."ga_session_id" = plp_then_pdp."ga_session_id";
