),
pdp AS (                             -- first PDP timestamp per session
    SELECT "ga_session_id", MIN("ts") AS "pdp_ts"
    FROM pv
    WHERE "url" ILIKE '%+%'
    GROUP BY 1
),
plp_then_pdp AS (                    -- sessions where PDP follows PLP
    SELECT plp."ga_session_id"
    FROM plp
    JOIN pdp
      ON plp."ga_session_id" = pdp."ga_session_id"
     AND pdp."pdp_ts" > plp."plp_ts"
)
SELECT
    COUNT(DISTINCT plp."ga_session_id")          AS "total_sessions_with_plp",
    COUNT(DISTINCT plp_then_pdp."ga_session_id") AS "sessions_plp_then_pdp",
    ROUND(
        COUNT(DISTINCT plp_then_pdp."ga_session_id") * 100.0
        / NULLIF(COUNT(DISTINCT plp."ga_session_id"), 0),
        2
    )                                            AS "plp_to_pdp_percent"
FROM plp
LEFT JOIN plp_then_pdp
  ON plp."ga_session_id" = plp_then_pdp."ga_session_id"
