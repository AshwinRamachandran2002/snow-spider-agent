WITH page_views AS (                 -- pull URL, session and timestamp
    SELECT
        gs.value:"value":"int_value"::NUMBER    AS GA_SESSION_ID,
        e."EVENT_TIMESTAMP"                     AS TS,
        ep.value:"value":"string_value"::STRING AS URL
