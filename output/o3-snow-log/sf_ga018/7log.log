--Description: ONE-SHOT query, including inline thinking, to measure
--             “What % of PLP views on 2021-01-02 were followed by at least one PDP view
--              later in the SAME session?”
-- THINKING STEPS (kept as comments):
--  1. Pull every page_view with session-id, timestamp, and URL  ..............  (pv)
--  2. Mark each individual PLP view  = URL WITHOUT “+”                         (plp_views)
--  3. Mark each PDP view             = URL WITH “+”                            (pdp_views)
--  4. For every PLP view, check whether the SAME session has a PDP view
--     that occurs AFTER that PLP’s timestamp                                    (plp_flagged)
--  5. Aggregate counts of:   a) total PLP views   b) PLP views that “lead” to PDP
--  6. Output the counts and the transition percentage (rounded to 2-decimals)

WITH pv AS (          -- all page_view rows for 2021-01-02
    SELECT
        gs.value:"value":"int_value"::NUMBER    AS "ga_session_id",
        e."EVENT_TIMESTAMP"                     AS "ts",
        ep.value:"value":"string_value"::STRING AS "url"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" e,
         LATERAL FLATTEN(input => e."EVENT_PARAMS") ep,
         LATERAL FLATTEN(input => e."EVENT_PARAMS") gs
    WHERE e."EVENT_NAME" = 'page_view'
      AND ep.value:"key"::STRING = 'page_location'
      AND gs.value:"key"::STRING = 'ga_session_id'
      AND ep.value:"value":"string_value"::STRING IS NOT NULL
),
plp_views AS (        -- each individual PLP view (no “+”)
    SELECT "ga_session_id", "ts" AS "plp_ts"
    FROM pv
    WHERE "url" NOT ILIKE '%+%'
),
pdp_views AS (        -- each individual PDP view (contains “+”)
    SELECT "ga_session_id", "ts" AS "pdp_ts"
    FROM pv
    WHERE "url" ILIKE '%+%'
),
plp_flagged AS (      -- mark PLP views that have a later PDP in same session
    SELECT p.*,
           EXISTS (
               SELECT 1
               FROM pdp_views d
               WHERE d."ga_session_id" = p."ga_session_id"
                 AND d."pdp_ts"        > p."plp_ts"
           ) AS "led_to_pdp"
    FROM plp_views p
)
SELECT
    COUNT(*)                                                AS "total_plp_views",
    COUNT_IF("led_to_pdp")                                  AS "plp_views_leading_to_pdp",
    ROUND(
        COUNT_IF("led_to_pdp") * 100.0 / NULLIF(COUNT(*),0),
        2
    )                                                       AS "plp_to_pdp_percent"
FROM plp_flagged;
```
