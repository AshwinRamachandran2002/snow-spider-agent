```sql
--Description:  Compute, for 2021-01-02, the percentage of Product-Listing-Page (PLP) 
--             views that later transition to a Product-Detail-Page (PDP) view within 
--             the same session, using only page_view events.
--
-- Thinking steps (expressed inline):
--   1.  Extract every page_view row for the day and pivot out the two parameters we need:
--          a) ga_session_id   → session identifier
--          b) page_location   → full URL
--      plus keep EVENT_TIMESTAMP for sequencing.
--   2.  Classify each URL:
--          • is_pdp = URL contains ‘+’       (heuristic for PDP)
--          • is_plp = URL does NOT contain ‘+’
--   3.  For each session, find the first PDP timestamp (if any).
--   4.  A PLP view “leads to” a PDP when it occurs before that first PDP within the
--      same session.
--   5.  Count:
--          • total_plp        = all PLP page_view rows (denominator)
--          • plp_to_pdp       = PLP rows that precede a PDP in-session (numerator)
--   6.  Return both counts and the percentage.
WITH pv AS (  -------------------------------------------------- Step 1
    SELECT
        MAX(CASE WHEN f.value:"key"::STRING = 'ga_session_id'
                 THEN f.value:"value":"int_value"  END)             AS "session_id",
        MAX(CASE WHEN f.value:"key"::STRING = 'page_location'
                 THEN f.value:"value":"string_value" END)           AS "url",
        t."EVENT_TIMESTAMP"                                         AS "ts"
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS")              f
    WHERE t."EVENT_NAME" = 'page_view'
    GROUP BY t."EVENT_TIMESTAMP", t."USER_PSEUDO_ID"
),
classified AS ( ----------------------------------------------- Step 2
    SELECT
        "session_id",
        "url",
        "ts",
        CASE WHEN "url" ILIKE '%+%'  THEN 1 ELSE 0 END  AS "is_pdp",
        CASE WHEN "url" NOT ILIKE '%+%' THEN 1 ELSE 0 END  AS "is_plp"
    FROM pv
),
first_pdp AS (  ------------------------------------------------ Step 3
    SELECT "session_id",
           MIN("ts") AS "first_pdp_ts"
    FROM   classified
    WHERE  "is_pdp" = 1
    GROUP BY "session_id"
),
plp_stats AS (  ------------------------------------------------ Step 4 & 5
    SELECT
        SUM(CASE WHEN c."is_plp" = 1                           THEN 1 ELSE 0 END)              AS total_plp,
        SUM(CASE WHEN c."is_plp" = 1
                  AND fp."first_pdp_ts" IS NOT NULL
                  AND c."ts" < fp."first_pdp_ts"               THEN 1 ELSE 0 END)              AS plp_to_pdp
    FROM   classified c
    LEFT  JOIN first_pdp fp
           ON c."session_id" = fp."session_id"
)
SELECT
       total_plp,
       plp_to_pdp,
       ROUND(100.0 * plp_to_pdp / NULLIF(total_plp,0), 2) AS plp_to_pdp_percent
FROM   plp_stats;
```
