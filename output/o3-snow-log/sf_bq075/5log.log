--Description: 5) List distinct 2021 CPSAAT18 subsector and industry_group values containing either 
--              “Internet publishing” (in subsector) or “systems design” (typically in industry_group).
SELECT DISTINCT
  COALESCE("subsector", 'N/A')      AS "subsector",
  COALESCE("industry_group", 'N/A') AS "industry_group"
FROM GOOGLE_DEI.BLS.CPSAAT18
WHERE "year" = 2021
  AND (
        "subsector"      ILIKE '%internet%publishing%' 
     OR "industry_group" ILIKE '%systems design%'      -- captures Computer systems design and related services
      )
LIMIT 20
Answer:
subsector,industry_group
Internet publishing and broadcasting and web search portals,N/A
"Other information services, except libraries and archives, and internet publishing and broadcasting and web search portals",N/A
Professional and technical services,Computer systems design and related services
Query:
--Description: 6) Pull 2021 tech-sector rows side-by-side: one for Internet publishing & web search portals 
--              (matched on SUBSECTOR) and one for Computer systems design & related services 
--              (matched on INDUSTRY_GROUP containing “systems design”).
SELECT
  COALESCE("subsector", "industry_group")             AS "tech_sector_label",
  "percent_asian",
  "percent_black_or_african_american",
  "percent_hispanic_or_latino",
  "percent_white",
  "percent_women",
  1 - "percent_women"                                AS "percent_men"
FROM GOOGLE_DEI.BLS.CPSAAT18
WHERE "year" = 2021
  AND (
        "subsector"      ILIKE '%internet%publishing%' 
     OR "industry_group" ILIKE '%systems design%'
      )
LIMIT 20
