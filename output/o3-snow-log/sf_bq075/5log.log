--Description: 3) 2021 BLS CPSAAT18 rows for subsector that contains “Internet publishing … web search portals”
SELECT 
  "year",
  "sector",
  "subsector",
  "percent_asian",
  "percent_black_or_african_american",
  "percent_hispanic_or_latino",
  "percent_white",
  "percent_women",
  (1 - "percent_women") AS "percent_men"
FROM GOOGLE_DEI.BLS.CPSAAT18
WHERE "year" = 2021
  AND "subsector" ILIKE '%internet%publishing%'
