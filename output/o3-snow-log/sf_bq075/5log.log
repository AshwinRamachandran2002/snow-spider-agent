--Description:  Retrieve the 2021 CPSAAT18 record for the tech field “Computer systems design and related services”.
--              The phrase usually appears in the INDUSTRY_GROUP column rather than SUBSECTOR, so we look for
--              any 2021 rows whose INDUSTRY_GROUP text contains “systems design”.  Result includes racial and
--              gender (women/men) shares to compare with Google data.
SELECT
  "year",
  "sector",
  COALESCE("subsector", 'N/A')      AS "subsector",
  COALESCE("industry_group", 'N/A') AS "industry_group",
  COALESCE("industry", 'N/A')       AS "industry",
  "percent_asian",
  "percent_black_or_african_american",
  "percent_hispanic_or_latino",
  "percent_white",
  "percent_women",
  1 - "percent_women"               AS "percent_men"
FROM GOOGLE_DEI.BLS.CPSAAT18
WHERE "year" = 2021
  AND "industry_group" ILIKE '%systems design%'
LIMIT 20;
