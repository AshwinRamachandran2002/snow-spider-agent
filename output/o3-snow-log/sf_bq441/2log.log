Query:
--Description: Compute scene- and hospital-arrival delays for each crash
SELECT DISTINCT
       "consecutive_number",
       "hour_of_crash",
       "hour_of_arrival_at_scene",
       "hour_of_ems_arrival_at_hospital",
       CASE WHEN "hour_of_arrival_at_scene" BETWEEN 0 AND 23 
            THEN "hour_of_arrival_at_scene" - "hour_of_crash" 
       END  AS "delay_to_scene",
       CASE WHEN "hour_of_ems_arrival_at_hospital" BETWEEN 0 AND 23 
            THEN "hour_of_ems_arrival_at_hospital" - "hour_of_crash" 
       END  AS "delay_to_hospital"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."ACCIDENT_2015"
LIMIT  20;
