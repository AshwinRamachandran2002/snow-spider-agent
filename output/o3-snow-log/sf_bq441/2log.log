```sql
--Description: Basic crash characteristics in 2015 – view hour, light, weather, and intersection type
SELECT DISTINCT 
       "consecutive_number",
       "hour_of_crash",
       "light_condition",
       "atmospheric_conditions_1",
       "type_of_intersection",
       "county"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."ACCIDENT_2015"
LIMIT  20;
```

```sql
--Description: Compute scene- and hospital-arrival delays for each crash
SELECT DISTINCT
       "consecutive_number",
       "hour_of_crash",
       "hour_of_arrival_at_scene",
       "hour_of_ems_arrival_at_hospital",
       CASE WHEN "hour_of_arrival_at_scene" BETWEEN 0 AND 23 
            THEN "hour_of_arrival_at_scene" - "hour_of_crash" 
       END  AS "delay_to_scene",
       CASE WHEN "hour_of_ems_arrival_at_hospital" BETWEEN 0 AND 23 
            THEN "hour_of_ems_arrival_at_hospital" - "hour_of_crash" 
       END  AS "delay_to_hospital"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."ACCIDENT_2015"
LIMIT  20;
```

```sql
--Description: Occupant information with derived “survived” & “restraint” indicators
SELECT DISTINCT
       "consecutive_number",
       "person_type",
       "injury_severity",
       CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END             AS "survived",
       "restraint_system_helmet_use",
       CASE 
            WHEN "restraint_system_helmet_use" = 0 THEN 0
            WHEN "restraint_system_helmet_use" = 1 THEN 0.33
            WHEN "restraint_system_helmet_use" = 2 THEN 0.67
            WHEN "restraint_system_helmet_use" = 3 THEN 1.0
            ELSE 0.5
       END                                                           AS "restraint",
       "seating_position",
       "age"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."PERSON_2015"
LIMIT  20;
```

```sql
--Description: Persons with reported alcohol or drug involvement
SELECT DISTINCT
       "consecutive_number",
       "person_type",
       "police_reported_alcohol_involvement",
       "police_reported_drug_involvement",
       "injury_severity",
       CASE WHEN "police_reported_alcohol_involvement" ILIKE '%Yes%' THEN 1 ELSE 0 END AS "alcohol",
       CASE WHEN "police_reported_drug_involvement"    ILIKE '%Yes%' THEN 1 ELSE 0 END AS "drugs"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."PERSON_2015"
LIMIT  20;
```

```sql
--Description: Vehicle-level speed, damage, and speeding relationship
SELECT DISTINCT
       "consecutive_number",
       "body_type",
       "travel_speed",
       "extent_of_damage",
       "vehicle_removal",
       "speeding_related",
       CASE WHEN "speeding_related" ILIKE '%Yes%' THEN 1 ELSE 0 END AS "speeding_flag",
       "roadway_surface_condition"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."VEHICLE_2015"
LIMIT  20;
```

```sql
--Description: Crashes where rollover/overturn listed in any vehicle sequence of events
SELECT DISTINCT
       "consecutive_number",
       "sequence_of_events_name",
       "area_of_Impact_associated_with_the_event_name"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."VSOE_2015"
WHERE  "sequence_of_events_name" ILIKE '%Rollover%'
LIMIT  20;
```

```sql
--Description: Vehicle events involving pedestrians
SELECT DISTINCT
       "consecutive_number",
       "state_number",
       "vehicle_number",
       "event_number",
       "sequence_of_events_name",
       "area_of_impact_this_vehicle_name",
       "area_of_impact_other_vehicle_name"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."VEVENT_2015"
WHERE  "sequence_of_events_name" ILIKE '%Pedestrian%'
LIMIT  20;
```

```sql
--Description: Age distribution of pedestrians (person_type = 5) killed or injured
SELECT DISTINCT
       "consecutive_number",
       "age",
       "person_type"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."PBTYPE_2015"
WHERE  "person_type" = 5
LIMIT  20;
```

```sql
--Description: Driver impairment conditions recorded at crashes
SELECT DISTINCT
       "consecutive_number",
       "condition_impairment_at_time_of_crash_driver",
       "condition_impairment_at_time_of_crash_driver_name"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."DRIMPAIR_2015"
LIMIT  20;
```

```sql
--Description: Combine crash & vehicle to view harmful events and collision manners
SELECT DISTINCT
       a."consecutive_number",
       a."first_harmful_event",
       a."manner_of_collision",
       v."most_harmful_event",
       v."extent_of_damage",
       v."body_type"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."ACCIDENT_2015"  a
JOIN   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."VEHICLE_2015"   v
       USING ("consecutive_number")
LIMIT  20;
```
