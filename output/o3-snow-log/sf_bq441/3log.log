```sql
--Description: ① Basic crash-level information in 2015 – county, hour, and lighting.
SELECT DISTINCT 
       "consecutive_number",
       "county",
       "hour_of_crash",
       "light_condition"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2015
LIMIT 20;
```

```sql
--Description: ② Scene & hospital response times (“delay_to_scene” / “delay_to_hospital”).
SELECT DISTINCT
       "consecutive_number",
       "hour_of_crash",
       "hour_of_arrival_at_scene",
       CASE WHEN "hour_of_arrival_at_scene" BETWEEN 0 AND 23
            THEN "hour_of_arrival_at_scene" - "hour_of_crash" END  AS "delay_to_scene",
       "hour_of_ems_arrival_at_hospital",
       CASE WHEN "hour_of_ems_arrival_at_hospital" BETWEEN 0 AND 23
            THEN "hour_of_ems_arrival_at_hospital" - "hour_of_crash" END  AS "delay_to_hospital"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2015
LIMIT 20;
```

```sql
--Description: ③ Person-level survival & restraint quality metrics.
SELECT DISTINCT
       "consecutive_number",
       "person_type",
       "injury_severity",
       CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END                         AS "survived",
       "restraint_system_helmet_use",
       CASE WHEN "restraint_system_helmet_use" = 0 THEN 0
            WHEN "restraint_system_helmet_use" = 1 THEN 0.33
            WHEN "restraint_system_helmet_use" = 2 THEN 0.67
            WHEN "restraint_system_helmet_use" = 3 THEN 1.0
            ELSE 0.5 END                                                         AS "restraint"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
LIMIT 20;
```

```sql
--Description: ④ Vehicle-level speed, rollover and speeding involvement flags.
SELECT DISTINCT
       "consecutive_number",
       "body_type",
       "travel_speed",
       CASE WHEN "speeding_related" ILIKE '%Yes%' THEN 1 ELSE 0 END  AS "speeding_related_flag",
       CASE WHEN "rollover" ILIKE 'No%'       THEN 0 ELSE 1 END      AS "rollover_flag",
       "extent_of_damage",
       "vehicle_removal"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2015
LIMIT 20;
```

```sql
--Description: ⑤ Link crashes to people – show survival by county & crash hour.
SELECT DISTINCT
       a."consecutive_number",
       a."county",
       a."hour_of_crash",
       p."person_type",
       p."injury_severity",
       CASE WHEN p."injury_severity" = 4 THEN 1 ELSE 0 END AS "survived"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2015  a
JOIN   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015    p
USING ("consecutive_number")
LIMIT 20;
```

```sql
--Description: ⑥ Vehicle events that involved pedestrians.
SELECT DISTINCT
       "consecutive_number",
       "sequence_of_events_name",
       "area_of_impact_this_vehicle_name"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEVENT_2015
WHERE  "sequence_of_events_name" ILIKE '%Pedestrian%'
LIMIT 20;
```

```sql
--Description: ⑦ Sequence-of-events records that include rollovers.
SELECT DISTINCT
       "consecutive_number",
       "sequence_of_events_name",
       "area_of_Impact_associated_with_the_event_name"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VSOE_2015
WHERE  "sequence_of_events_name" ILIKE '%Rollover%'
LIMIT 20;
```

```sql
--Description: ⑧ Driver impairment conditions recorded by officers.
SELECT DISTINCT
       "consecutive_number",
       "condition_impairment_at_time_of_crash_driver_name"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.DRIMPAIR_2015
LIMIT 20;
```

```sql
--Description: ⑨ Crashes that had a distraction code and their basic lighting / hour context.
SELECT DISTINCT
       d."consecutive_number",
       a."hour_of_crash",
       a."light_condition"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015  d
LEFT JOIN NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2015 a
USING ("consecutive_number")
LIMIT 20;
```

```sql
--Description: ⑩ Multi-table view of key crash, vehicle, person, and impairment factors.
SELECT DISTINCT
       a."consecutive_number",
       a."hour_of_crash",
       a."light_condition",
       v."travel_speed",
       CASE WHEN v."speeding_related" ILIKE '%Yes%' THEN 1 ELSE 0 END AS "speeding",
       p."injury_severity",
       CASE WHEN p."injury_severity" = 4 THEN 1 ELSE 0 END           AS "survived",
       d."condition_impairment_at_time_of_crash_driver_name"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2015  a
JOIN   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2015   v USING ("consecutive_number")
JOIN   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015    p USING ("consecutive_number")
LEFT JOIN NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.DRIMPAIR_2015 d USING ("consecutive_number")
LIMIT 20;
```
