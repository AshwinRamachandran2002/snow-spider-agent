```sql
--Description: 1) Core crash attributes (where, when, lighting) for 2015 accidents
SELECT DISTINCT
       "consecutive_number",
       "county",
       "hour_of_crash",
       "type_of_intersection",
       "light_condition"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2015
LIMIT 20;
```

```sql
--Description: 2) Calculate EMS response delays to scene and hospital
SELECT
       "consecutive_number",
       "hour_of_crash",
       "hour_of_arrival_at_scene",
       CASE WHEN "hour_of_arrival_at_scene" BETWEEN 0 AND 23
            THEN "hour_of_arrival_at_scene" - "hour_of_crash" END AS "delay_to_scene",
       "hour_of_ems_arrival_at_hospital",
       CASE WHEN "hour_of_ems_arrival_at_hospital" BETWEEN 0 AND 23
            THEN "hour_of_ems_arrival_at_hospital" - "hour_of_crash" END AS "delay_to_hospital"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2015
LIMIT 20;
```

```sql
--Description: 3) Person-level outcomes, restraint use, survival, alcohol & drug flags
SELECT
       "consecutive_number",
       "person_type",
       "injury_severity",
       CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END           AS "survived",
       "restraint_system_helmet_use",
       CASE
            WHEN "restraint_system_helmet_use" = 0 THEN 0
            WHEN "restraint_system_helmet_use" = 1 THEN 0.33
            WHEN "restraint_system_helmet_use" = 2 THEN 0.67
            WHEN "restraint_system_helmet_use" = 3 THEN 1.0
            ELSE 0.5
       END                                                         AS "restraint",
       "air_bag_deployed",
       CASE WHEN "air_bag_deployed" BETWEEN 1 AND 9 THEN 1 ELSE 0 END AS "airbag",
       "police_reported_alcohol_involvement",
       CASE WHEN "police_reported_alcohol_involvement" ILIKE '%Yes%' THEN 1 ELSE 0 END AS "alcohol",
       "police_reported_drug_involvement",
       CASE WHEN "police_reported_drug_involvement"   ILIKE '%Yes%' THEN 1 ELSE 0 END AS "drugs"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
LIMIT 20;
```

```sql
--Description: 4) Vehicle factors – speed, speeding flag, damage extent & rollover
SELECT
       "consecutive_number",
       "travel_speed",
       "speeding_related",
       CASE WHEN "speeding_related" ILIKE '%Yes%' THEN 1 ELSE 0 END AS "speeding_related_flag",
       "extent_of_damage",
       "vehicle_removal",
       "body_type",
       "rollover"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2015
LIMIT 20;
```

```sql
--Description: 5) Rollover / overturn events and associated impact area
SELECT DISTINCT
       "consecutive_number",
       "sequence_of_events_name",
       "area_of_Impact_associated_with_the_event_name"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VSOE_2015
WHERE "sequence_of_events_name" ILIKE '%Rollover%'
LIMIT 20;
```

```sql
--Description: 6) Vehicle events that involved pedestrians or pedalcyclists
SELECT
       "consecutive_number",
       "vehicle_number",
       "sequence_of_events_name",
       "area_of_impact_this_vehicle_name",
       "area_of_impact_other_vehicle_name"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEVENT_2015
WHERE "sequence_of_events_name" ILIKE '%Pedestrian%'
   OR "sequence_of_events_name" ILIKE '%Pedalcyclist%'
LIMIT 20;
```

```sql
--Description: 7) Driver impairment conditions recorded for crashes
SELECT DISTINCT
       "consecutive_number",
       "condition_impairment_at_time_of_crash_driver",
       "condition_impairment_at_time_of_crash_driver_name"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.DRIMPAIR_2015
LIMIT 20;
```

```sql
--Description: 8) Sample of crashes with a distraction entry
SELECT DISTINCT
       "consecutive_number"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015
LIMIT 20;
```

```sql
--Description: 9) Crashes that have safety-equipment information recorded
SELECT DISTINCT
       "consecutive_number"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.SAFETYEQ_2015
LIMIT 20;
```

```sql
--Description: 10) Join person survival with crash setting (intersection, light, weather)
SELECT
       p."consecutive_number",
       a."type_of_intersection",
       a."light_condition",
       a."atmospheric_conditions_1",
       p."injury_severity",
       CASE WHEN p."injury_severity" = 4 THEN 1 ELSE 0 END AS "survived"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015  p
JOIN NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2015 a
  ON p."consecutive_number" = a."consecutive_number"
LIMIT 20;
```
