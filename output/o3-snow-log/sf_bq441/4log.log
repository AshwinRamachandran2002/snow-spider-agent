Query:
--Description: Computed EMS delay (arrival at hospital minus crash hour) when both times are valid  
SELECT
    "consecutive_number",
    "hour_of_crash",
    "hour_of_ems_arrival_at_hospital",
    CASE 
        WHEN "hour_of_crash" BETWEEN 0 AND 23 
         AND "hour_of_ems_arrival_at_hospital" BETWEEN 0 AND 23 
        THEN "hour_of_ems_arrival_at_hospital" - "hour_of_crash"
    END AS "delay_to_hospital"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2015
LIMIT 20;
