Query:
--Description: Derived survival, alcohol, drug, restraint, and air-bag flags for crash participants  
SELECT
    "consecutive_number",
    "injury_severity",
    CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END              AS "survived",
    CASE WHEN "police_reported_alcohol_involvement" ILIKE '%Yes%'  THEN 1 ELSE 0 END AS "alcohol",
    CASE WHEN "police_reported_drug_involvement"   ILIKE '%Yes%'  THEN 1 ELSE 0 END AS "drugs",
    CASE 
        WHEN "restraint_system_helmet_use" = 0 THEN 0
        WHEN "restraint_system_helmet_use" = 1 THEN 0.33
        WHEN "restraint_system_helmet_use" = 2 THEN 0.67
        WHEN "restraint_system_helmet_use" = 3 THEN 1.0
        ELSE 0.5
    END AS "restraint",
    CASE WHEN "air_bag_deployed" BETWEEN 1 AND 9 THEN 1 ELSE 0 END AS "airbag"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
LIMIT 20;
