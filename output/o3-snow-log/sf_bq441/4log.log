```sql
--Description: Basic crash–environment information for 2015 accidents  
SELECT 
    "consecutive_number",
    "county",
    "type_of_intersection",
    "light_condition",
    "atmospheric_conditions_1",
    "hour_of_crash",
    "functional_system"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2015
LIMIT 20;
```

```sql
--Description: Person demographics, role, and injury severities in 2015 crashes  
SELECT  
    "consecutive_number",
    "person_type",
    "age",
    "injury_severity",
    "seating_position"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
LIMIT 20;
```

```sql
--Description: Derived survival, alcohol, drug, restraint, and air-bag flags for crash participants  
SELECT
    "consecutive_number",
    "injury_severity",
    CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END              AS "survived",
    CASE WHEN "police_reported_alcohol_involvement" ILIKE '%Yes%'  THEN 1 ELSE 0 END AS "alcohol",
    CASE WHEN "police_reported_drug_involvement"   ILIKE '%Yes%'  THEN 1 ELSE 0 END AS "drugs",
    CASE 
        WHEN "restraint_system_helmet_use" = 0 THEN 0
        WHEN "restraint_system_helmet_use" = 1 THEN 0.33
        WHEN "restraint_system_helmet_use" = 2 THEN 0.67
        WHEN "restraint_system_helmet_use" = 3 THEN 1.0
        ELSE 0.5
    END AS "restraint",
    CASE WHEN "air_bag_deployed" BETWEEN 1 AND 9 THEN 1 ELSE 0 END AS "airbag"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
LIMIT 20;
```

```sql
--Description: Vehicle characteristics, damage, removal, rollover and speeding indicators  
SELECT
    "consecutive_number",
    "body_type",
    "extent_of_damage",
    "vehicle_removal",
    CASE WHEN "rollover" ILIKE '%No Rollover%' THEN 0 ELSE 1 END           AS "rollover_flag",
    CASE WHEN "speeding_related" ILIKE '%Yes%'     THEN 1 ELSE 0 END       AS "speeding_flag",
    "travel_speed"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2015
LIMIT 20;
```

```sql
--Description: Merged accident & vehicle view – core harmful and collision details  
SELECT
    a."consecutive_number",
    a."first_harmful_event",
    a."manner_of_collision",
    v."most_harmful_event",
    v."extent_of_damage",
    v."body_type"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2015  a
JOIN NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2015   v
  ON a."consecutive_number" = v."consecutive_number"
LIMIT 20;
```

```sql
--Description: Vehicle-event sequences and impact areas for 2015 crashes  
SELECT DISTINCT
    "state_number",
    "consecutive_number",
    "sequence_of_events_name",
    "area_of_impact_this_vehicle_name",
    "area_of_impact_other_vehicle_name"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEVENT_2015
LIMIT 20;
```

```sql
--Description: Single-event sequence details with associated impact area (VSOE)  
SELECT DISTINCT
    "consecutive_number",
    "sequence_of_events_name",
    "area_of_Impact_associated_with_the_event_name"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VSOE_2015
LIMIT 20;
```

```sql
--Description: Driver impairment conditions recorded in 2015 crashes  
SELECT DISTINCT
    "condition_impairment_at_time_of_crash_driver_name"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.DRIMPAIR_2015
LIMIT 20;
```

```sql
--Description: Age profile of pedestrians (person_type = 5) involved in 2015 traffic fatalities  
SELECT
    "consecutive_number",
    "age"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PBTYPE_2015
WHERE "person_type" = 5
LIMIT 20;
```

```sql
--Description: Computed EMS delay (arrival at hospital minus crash hour) when both times are valid  
SELECT
    "consecutive_number",
    "hour_of_crash",
    "hour_of_ems_arrival_at_hospital",
    CASE 
        WHEN "hour_of_crash" BETWEEN 0 AND 23 
         AND "hour_of_ems_arrival_at_hospital" BETWEEN 0 AND 23 
        THEN "hour_of_ems_arrival_at_hospital" - "hour_of_crash"
    END AS "delay_to_hospital"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2015
LIMIT 20;
```
