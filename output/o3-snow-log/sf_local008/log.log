```sql
WITH agg AS (
    SELECT
        "player_id",
        SUM("g")                                              AS total_games,
        SUM(CAST(NULLIF("r",  '') AS NUMBER))                 AS total_runs,
        SUM(CAST(NULLIF("h",  '') AS NUMBER))                 AS total_hits,
        SUM(CAST(NULLIF("hr", '') AS NUMBER))                 AS total_hr
    FROM BASEBALL.BASEBALL.BATTING
    GROUP BY "player_id"
),
max_vals AS (
    SELECT
        MAX(total_games) AS max_games,
        MAX(total_runs)  AS max_runs,
        MAX(total_hits)  AS max_hits,
        MAX(total_hr)    AS max_hr
    FROM agg
),
leaders AS (
    SELECT
        'Games Played'     AS metric,
        p."name_given",
        a.total_games      AS score
    FROM agg a
    JOIN max_vals m
        ON a.total_games = m.max_games
    JOIN BASEBALL.BASEBALL.PLAYER p
        ON p."player_id" = a."player_id"

    UNION ALL

    SELECT
        'Runs'             AS metric,
        p."name_given",
        a.total_runs       AS score
    FROM agg a
    JOIN max_vals m
        ON a.total_runs = m.max_runs
    JOIN BASEBALL.BASEBALL.PLAYER p
        ON p."player_id" = a."player_id"

    UNION ALL

    SELECT
        'Hits'             AS metric,
        p."name_given",
        a.total_hits       AS score
    FROM agg a
    JOIN max_vals m
        ON a.total_hits = m.max_hits
    JOIN BASEBALL.BASEBALL.PLAYER p
        ON p."player_id" = a."player_id"

    UNION ALL

    SELECT
        'Home Runs'        AS metric,
        p."name_given",
        a.total_hr         AS score
    FROM agg a
    JOIN max_vals m
        ON a.total_hr = m.max_hr
    JOIN BASEBALL.BASEBALL.PLAYER p
        ON p."player_id" = a."player_id"
)

SELECT metric,
       "name_given",
       score
FROM   leaders
ORDER  BY metric;
```
