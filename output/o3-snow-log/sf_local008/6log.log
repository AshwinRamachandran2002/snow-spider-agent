```sql
WITH "career" AS (
    /* 1.  Aggregate every player’s lifetime totals */
    SELECT
        "player_id",
        SUM("g")                               AS total_g,
        SUM(TRY_TO_NUMBER("r"))                AS total_r,
        SUM(TRY_TO_NUMBER("h"))                AS total_h,
        SUM(TRY_TO_NUMBER("hr"))               AS total_hr
    FROM BASEBALL.BASEBALL.BATTING
    GROUP BY "player_id"
),
"max_vals" AS (
    /* 2.  Identify the record (maximum) for each statistic */
    SELECT
        MAX(total_g)  AS max_g,
        MAX(total_r)  AS max_r,
        MAX(total_h)  AS max_h,
        MAX(total_hr) AS max_hr
    FROM "career"
),
"top_players" AS (
    /* 3.  Pick all players who match each record value (ties included) */
    SELECT c."player_id", 'Games Played' AS metric, c.total_g  AS value FROM "career" c, "max_vals" m WHERE c.total_g  = m.max_g
    UNION ALL
    SELECT c."player_id", 'Runs'        AS metric, c.total_r  AS value FROM "career" c, "max_vals" m WHERE c.total_r  = m.max_r
    UNION ALL
    SELECT c."player_id", 'Hits'        AS metric, c.total_h  AS value FROM "career" c, "max_vals" m WHERE c.total_h  = m.max_h
    UNION ALL
    SELECT c."player_id", 'Home Runs'   AS metric, c.total_hr AS value FROM "career" c, "max_vals" m WHERE c.total_hr = m.max_hr
)
SELECT
    p."name_given",
    t.metric,
    t.value
FROM "top_players" t
JOIN BASEBALL.BASEBALL.PLAYER p
  ON p."player_id" = t."player_id"
ORDER BY
    CASE
        WHEN t.metric = 'Games Played' THEN 1
        WHEN t.metric = 'Runs'        THEN 2
        WHEN t.metric = 'Hits'        THEN 3
        WHEN t.metric = 'Home Runs'   THEN 4
    END,
    p."name_given";
```
