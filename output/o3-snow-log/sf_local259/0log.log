/* 4. Career-level batting aggregates  */
/*-------------------------------------*/
batting_agg AS (
    SELECT  player_id,
            SUM(runs_scored)            AS total_runs,
            COUNT(*)                    AS total_balls
    FROM    batting_per_ball
    GROUP BY player_id
),

