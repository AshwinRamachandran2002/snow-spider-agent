-- 2) Join to PRODUCTS (alias p) on product_id so we can display the product name.
-- 3) Order the result by pu.product_id and pu.purchased (earliest first) to get
--    the chronological “first-in-first-out” sequence for each product.
-- 4) Use unquoted identifiers (product_id, purchased, id, etc.) so Snowflake
--    treats them case-insensitively and avoids the previous identifier error.
-- 5) LIMIT 20 keeps the output short for verification.
SELECT
       pu.product_id,
       p.name          AS product_name,
       pu.purchased,
       pu.qty,
       pu.id           AS purchase_id,
       pu.brewery_id
FROM ORACLE_SQL.ORACLE_SQL.PURCHASES pu
JOIN ORACLE_SQL.ORACLE_SQL.PRODUCTS  p
  ON p.id = pu.product_id
ORDER BY
       pu.product_id,
       pu.purchased
LIMIT 20;
