       pu.product_id      AS product_id,
       p.name             AS product_name,
       pu.purchased,
       pu.qty,
       pu.id              AS purchase_id,
       pu.brewery_id
FROM ORACLE_SQL.ORACLE_SQL.PURCHASES pu
JOIN ORACLE_SQL.ORACLE_SQL.PRODUCTS  p
  ON p.id = pu.product_id
ORDER BY
       pu.product_id,
       pu.purchased
LIMIT 20;
