```sql
--Description: We need a concise list (max 20 rows) of products that actually occur in day-to-day warehouse activity.
--Thinking process:
-- 1. Start from PRODUCTS so we can return each product’s id and name.
-- 2. Use three EXISTS predicates (one for INVENTORY, one for PICKING_LINE, one for PURCHASES)
--    to check whether that product_id appears in any of those tables.
--    • EXISTS is preferable to joins here because it avoids row multiplication
--      and sidesteps case-sensitivity issues on the joined tables.
-- 3. Only products satisfying at least one EXISTS condition are kept.
-- 4. LIMIT 20 provides a small sample of the result set.
SELECT
       p."id"   AS product_id,
       p."name" AS product_name
FROM ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
WHERE EXISTS (SELECT 1
              FROM ORACLE_SQL.ORACLE_SQL."INVENTORY" i
              WHERE i."product_id" = p."id")
   OR EXISTS (SELECT 1
              FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
              WHERE pl."product_id" = p."id")
   OR EXISTS (SELECT 1
              FROM ORACLE_SQL.ORACLE_SQL."PURCHASES" pu
              WHERE pu."product_id" = p."id")
LIMIT 20;
```
