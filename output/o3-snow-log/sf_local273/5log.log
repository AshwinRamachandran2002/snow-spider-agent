```sql
--Description: 2) Earliest-to-latest view of purchases for the same 20-product sample (FIFO candidate stock)
SELECT pu."product_id",
       p."name"            AS "product_name",
       pu."purchased",
       pu."qty",
       pu."id"             AS "purchase_id",
       pu."brewery_id"
FROM ORACLE_SQL.ORACLE_SQL."PURCHASES" pu
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"  p  ON p."id" = pu."product_id"
ORDER BY pu."product_id",
         pu."purchased"
LIMIT 20;
```

```sql
--Description: 3) Current on-hand inventory quantities and related purchase date for each product/location
SELECT i."id"              AS "inventory_id",
       i."product_id",
       p."name"            AS "product_name",
       i."qty"             AS "inv_qty",
       pu."purchased"      AS "purchase_date",
       i."location_id"
FROM ORACLE_SQL.ORACLE_SQL."INVENTORY" i
JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" pu ON pu."id" = i."purchase_id"
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"  p  ON p."id" = i."product_id"
ORDER BY i."product_id",
         pu."purchased",
         i."qty"
LIMIT 20;
```

```sql
--Description: 4) Lines that have actually been picked (what the warehouse removed) ordered by order and product
SELECT pl."picklist_id",
       pl."order_id",
       pl."product_id",
       p."name"            AS "product_name",
       pl."qty"            AS "picked_qty",
       pl."location_id",
       pl."line_no"
FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"     p ON p."id" = pl."product_id"
ORDER BY pl."order_id",
         pl."line_no"
LIMIT 20;
```

```sql
--Description: 5) Aggregate how much has been purchased vs still in inventory (un-picked) per product
SELECT i."product_id",
       p."name"                                                 AS "product_name",
       SUM(pu."qty")                                            AS "total_purchased",
       SUM(i."qty")                                             AS "current_inv_qty"
FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" pu ON pu."id" = i."purchase_id"
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"  p  ON p."id" = i."product_id"
GROUP BY i."product_id", p."name"
LIMIT 20;
```

```sql
--Description: 6) Calculate how much has been picked in total per product so far
SELECT pl."product_id",
       p."name"                           AS "product_name",
       SUM(pl."qty")                      AS "total_picked_qty"
FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"     p ON p."id" = pl."product_id"
GROUP BY pl."product_id", p."name"
LIMIT 20;
```

```sql
--Description: 7) Combine aggregates to get a raw pick-rate (picked ÷ purchased) per product (ignoring FIFO for now)
WITH purchased AS (
    SELECT pu."product_id", SUM(pu."qty") AS "purchased_qty"
    FROM ORACLE_SQL.ORACLE_SQL."PURCHASES" pu
    GROUP BY pu."product_id"
),
picked AS (
    SELECT pl."product_id", SUM(pl."qty") AS "picked_qty"
    FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
    GROUP BY pl."product_id"
)
SELECT pr."product_id",
       p."name"                          AS "product_name",
       pr."purchased_qty",
       pk."picked_qty",
       ROUND(pk."picked_qty"/NULLIF(pr."purchased_qty",0)*100,2) AS "pick_pct"
FROM purchased pr
LEFT JOIN picked pk ON pk."product_id" = pr."product_id"
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p ON p."id" = pr."product_id"
ORDER BY "pick_pct" DESC
LIMIT 20;
```

```sql
--Description: 8) FIFO window – rank each inventory record inside a product by purchase date & quantity (earliest / smallest first)
SELECT i."id"                AS "inventory_id",
       i."product_id",
       p."name"              AS "product_name",
       pu."purchased",
       i."qty",
       ROW_NUMBER() OVER (PARTITION BY i."product_id" 
                          ORDER BY pu."purchased", i."qty")     AS "fifo_rank"
FROM ORACLE_SQL.ORACLE_SQL."INVENTORY" i
JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" pu ON pu."id" = i."purchase_id"
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"  p  ON p."id" = i."product_id"
ORDER BY i."product_id", "fifo_rank"
LIMIT 20;
```

```sql
--Description: 9) FIFO consumption – for every product take cumulative picked qty vs cumulative inventory ordered by FIFO
WITH fifo_inv AS (
    SELECT i."id"                        AS "inventory_id",
           i."product_id",
           pu."purchased",
           i."qty"                       AS "inv_qty",
           SUM(i."qty") OVER (PARTITION BY i."product_id" 
                              ORDER BY pu."purchased", i."qty"
                              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)    AS "cum_inv_qty"
    FROM ORACLE_SQL.ORACLE_SQL."INVENTORY" i
    JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" pu ON pu."id" = i."purchase_id"
),
picked AS (
    SELECT pl."product_id",
           SUM(pl."qty")                 AS "picked_qty"
    FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
    GROUP BY pl."product_id"
)
SELECT f."product_id",
       p."name"                         AS "product_name",
       f."cum_inv_qty",
       pk."picked_qty"
FROM fifo_inv f
JOIN picked   pk ON pk."product_id" = f."product_id"
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p ON p."id" = f."product_id"
ORDER BY f."product_id", f."cum_inv_qty"
LIMIT 20;
```

```sql
--Description: 10) Final step candidate – compute average FIFO-aware pick-percentage per product name (only 20 shown)
WITH inv AS (
    SELECT i."product_id",
           pu."purchased",
           i."qty"
    FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
    JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" pu ON pu."id" = i."purchase_id"
), 
fifo AS (
    SELECT "product_id",
           "purchased",
           "qty",
           ROW_NUMBER() OVER (PARTITION BY "product_id" 
                              ORDER BY "purchased", "qty") AS "fifo_rank"
    FROM inv
), 
picked AS (
    SELECT pl."product_id",
           SUM(pl."qty") AS "picked_qty"
    FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
    GROUP BY pl."product_id"
)
SELECT f."product_id",
       p."name"                                         AS "product_name",
       pk."picked_qty",
       SUM(f."qty")                                     AS "total_fifo_qty",
       ROUND(pk."picked_qty"/NULLIF(SUM(f."qty"),0)*100,2)  AS "fifo_pick_pct"
FROM fifo                f
JOIN picked              pk ON pk."product_id" = f."product_id"
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p ON p."id" = f."product_id"
GROUP BY f."product_id", p."name", pk."picked_qty"
ORDER BY p."name"
LIMIT 20;
```
