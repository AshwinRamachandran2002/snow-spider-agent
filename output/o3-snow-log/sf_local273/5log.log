```sql
--Description: 1) Show the list of all products that appear in either INVENTORY, PICKING_LINE or PURCHASES (first 20 rows)
SELECT DISTINCT p."id" AS "product_id",
       p."name" AS "product_name"
FROM ORACLE_SQL.ORACLE_SQL."PRODUCTS"      p
LEFT JOIN ORACLE_SQL.ORACLE_SQL."INVENTORY"     i ON i."product_id" = p."id"
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PICKING_LINE"  pl ON pl."product_id" = p."id"
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"     pu ON pu."product_id" = p."id"
WHERE i."id" IS NOT NULL 
   OR pl."picklist_id" IS NOT NULL 
   OR pu."id" IS NOT NULL
LIMIT 20;
