```sql
--Description: The last error arose because quoted lower-case identifiers (e.g., i."id") are case-sensitive in Snowflake and do not match the upper-case metadata.  Removing the quotes (or quoting with exact upper-case) resolves the problem.  Here we join INVENTORY with PURCHASES (via PURCHASE_ID) and return key details, ordered by the purchase date and inventory quantity so FIFO logic can later be applied.
SELECT
       i.ID           AS INVENTORY_ID,
       i.PRODUCT_ID,
       i.LOCATION_ID,
       i.QTY          AS INV_QTY,
       p.PURCHASED    AS PURCHASE_DATE,
       p.BREWERY_ID
FROM   ORACLE_SQL.ORACLE_SQL.INVENTORY  i
JOIN   ORACLE_SQL.ORACLE_SQL.PURCHASES  p
       ON p.ID = i.PURCHASE_ID
ORDER  BY p.PURCHASED,
          i.QTY
LIMIT 20;
