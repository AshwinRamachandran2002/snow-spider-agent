```sql
--Description: Inspect a handful of inventory rows (what is on-hand and where).
SELECT *
FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"
LIMIT 20;
```

```sql
--Description: Add the purchase date to each inventory record so FIFO purchasing order can later be applied.
SELECT  i."id"          AS "inventory_id",
        i."product_id",
        i."location_id",
        i."qty"         AS "inv_qty",
        p."purchased"   AS "purchase_date",
        p."brewery_id"
FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"  p
  ON p."id" = i."purchase_id"
ORDER BY p."purchased", i."qty"
LIMIT 20;
```

```sql
--Description: Inspect pick-lines (what has actually been picked for customer orders).
SELECT *
FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
LIMIT 20;
```

```sql
--Description: Connect each pick-line with a readable product name for clarity.
SELECT  pl."picklist_id",
        pl."order_id",
        pr."name"       AS "product_name",
        pl."product_id",
        pl."qty"        AS "picked_qty"
FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"     pr
  ON pr."id" = pl."product_id"
ORDER BY pl."picklist_id", pl."line_no"
LIMIT 20;
```

```sql
--Description: Aggregate available inventory (FIFO source) versus total picked quantity by product.
SELECT  pr."name"                     AS "product_name",
        SUM(i."qty")                  AS "total_inv_qty",
        SUM(pl."qty")                 AS "total_picked_qty"
FROM ORACLE_SQL.ORACLE_SQL."PRODUCTS"       pr
LEFT JOIN ORACLE_SQL.ORACLE_SQL."INVENTORY" i  ON i."product_id" = pr."id"
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl ON pl."product_id" = pr."id"
GROUP BY pr."name"
ORDER BY pr."name"
LIMIT 20;
```

```sql
--Description: For each product, list every inventory location sorted by the earliest purchase date (true FIFO queue).
SELECT  pr."name"       AS "product_name",
        p."purchased"   AS "purchase_date",
        i."location_id",
        i."qty"         AS "inv_qty"
FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"  p  ON p."id" = i."purchase_id"
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"   pr ON pr."id" = i."product_id"
ORDER BY pr."name", p."purchased", i."qty"
LIMIT 20;
```

```sql
--Description: Determine, per product, which single inventory lot would be consumed first (earliest date & smallest qty).
SELECT  x."product_id",
        MIN(x."purchase_date")         AS "earliest_date",
        MIN(x."inv_qty") KEEP (WHERE x."purchase_date" = MIN(x."purchase_date")) AS "min_qty_at_earliest"
FROM (
        SELECT  i."product_id",
                p."purchased" AS "purchase_date",
                i."qty"       AS "inv_qty"
        FROM ORACLE_SQL.ORACLE_SQL."INVENTORY" i
        JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" p ON p."id" = i."purchase_id"
     ) x
GROUP BY x."product_id"
LIMIT 20;
```

```sql
--Description: Compute, by product and purchase lot, how much of the pick quantity overlaps with that lot (capped FIFO).
SELECT  pr."name"            AS "product_name",
        p."purchased"        AS "purchase_date",
        i."qty"              AS "inv_qty",
        SUM(pl."qty")        AS "picked_qty",
        LEAST(SUM(pl."qty"), i."qty") AS "overlap_qty"
FROM ORACLE_SQL.ORACLE_SQL."INVENTORY" i
JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" p  ON p."id" = i."purchase_id"
JOIN ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl ON pl."product_id" = i."product_id"
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" pr     ON pr."id" = i."product_id"
GROUP BY pr."name", p."purchased", i."qty"
ORDER BY pr."name", p."purchased"
LIMIT 20;
```

```sql
--Description: Roll up the overlap quantities to derive a preliminary pick percentage per product.
SELECT  "product_name",
        SUM("overlap_qty")          AS "fifo_picked",
        SUM("inv_qty")              AS "total_inv_qty",
        ROUND(100 * SUM("overlap_qty") / NULLIF(SUM("inv_qty"),0), 2) AS "pick_pct"
FROM (
        /* reuse the overlap computation from the previous step */
        SELECT  pr."name" AS "product_name",
                i."qty"   AS "inv_qty",
                LEAST(SUM(pl."qty"), i."qty") AS "overlap_qty"
        FROM ORACLE_SQL.ORACLE_SQL."INVENTORY" i
        JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" p  ON p."id" = i."purchase_id"
        JOIN ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl ON pl."product_id" = i."product_id"
        JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" pr     ON pr."id" = i."product_id"
        GROUP BY pr."name", i."qty"
     )
GROUP BY "product_name"
ORDER BY "product_name"
LIMIT 20;
```

```sql
--Description: (Final assembly) show the average FIFO pick percentage for every product name, sorted alphabetically.
SELECT  "product_name",
        AVG("pick_pct") AS "avg_pick_pct"
FROM   (
          /* collapse to one percentage per pick & inventory interaction first */
          SELECT  pr."name" AS "product_name",
                  ROUND(100 * LEAST(SUM(pl."qty"), i."qty") / NULLIF(i."qty",0), 2) AS "pick_pct"
          FROM ORACLE_SQL.ORACLE_SQL."INVENTORY" i
          JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" p  ON p."id" = i."purchase_id"
          JOIN ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl ON pl."product_id" = i."product_id"
          JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" pr     ON pr."id" = i."product_id"
          GROUP BY pr."name", i."qty"
       )
GROUP BY "product_name"
ORDER BY "product_name"
LIMIT 20;
```
