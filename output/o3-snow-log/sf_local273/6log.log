/* ---------------------------------------------------------------
   Average pick-percentage per product – FIFO inventory allocation
-----------------------------------------------------------------*/
WITH picking_lines AS (                       -- required quantity
    SELECT  pl."picklist_id",
            pl."line_no",
            pl."product_id",
            pl."qty"  AS required_qty
    FROM    ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
),
inventory_lots AS (                           -- inventory lots + purchase date
    SELECT  i.id            AS inv_id,        -- unquoted: stored as upper-case ID
            i.product_id,
            i.qty           AS lot_qty,
            COALESCE( TO_DATE(p.purchased),
                      TO_DATE('9999-12-31') ) AS purchase_date
    FROM    ORACLE_SQL.ORACLE_SQL.INVENTORY  i
    LEFT JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES p
           ON p.id = i.purchase_id
),
lot_allocation AS (                           -- FIFO allocation of lots to lines
    SELECT  pl."picklist_id",
            pl."line_no",
            pl."product_id",
            pl.required_qty,
            il.inv_id,
            il.lot_qty,
            il.purchase_date,
            /* cumulative qty BEFORE this lot */
            SUM(il.lot_qty)
              OVER (PARTITION BY pl."picklist_id", pl."line_no"
                    ORDER BY il.purchase_date, il.lot_qty
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
            - il.lot_qty                      AS cum_prior
    FROM   picking_lines pl
    JOIN   inventory_lots il
           ON il.product_id = pl."product_id"
),
picked_per_lot AS (                           -- qty really picked from each lot
    SELECT  *,
            CASE
                WHEN cum_prior >= required_qty
                     THEN 0
                ELSE LEAST(lot_qty , required_qty - cum_prior)
            END AS picked_from_lot
    FROM    lot_allocation
    WHERE   cum_prior < required_qty          -- ignore surplus lots
),
picked_per_line AS (                          -- total picked per picking-line
    SELECT  "picklist_id",
            "line_no",
            "product_id",
            required_qty,
            SUM(picked_from_lot) AS picked_qty
    FROM    picked_per_lot
    GROUP BY "picklist_id","line_no","product_id", required_qty
),
avg_pct_per_product AS (                      -- average % per product
    SELECT  "product_id",
            AVG(picked_qty / NULLIF(required_qty,0)) AS avg_pick_pct
    FROM    picked_per_line
    GROUP BY "product_id"
)
SELECT  pr."name"                    AS product_name,
        ROUND(avg_pick_pct * 100, 2) AS average_pick_percentage
FROM    avg_pct_per_product pp
JOIN    ORACLE_SQL.ORACLE_SQL."PRODUCTS" pr
