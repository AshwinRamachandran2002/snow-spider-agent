/* ---------------------------------------------------------------
   Average pick-percentage per product (FIFO allocation)
-----------------------------------------------------------------*/
WITH picking_lines AS (          -- required qty per picking line
    SELECT  PL.PICKLIST_ID,
            PL.LINE_NO,
            PL.PRODUCT_ID,
            PL.QTY AS REQUIRED_QTY
    FROM    ORACLE_SQL.ORACLE_SQL.PICKING_LINE PL
),
inventory_lots AS (              -- inventory lots with purchase date
    SELECT  I.ID            AS INV_ID,
            I.PRODUCT_ID,
            I.QTY           AS LOT_QTY,
            COALESCE(TO_DATE(P.PURCHASED), TO_DATE('9999-12-31')) AS PURCHASE_DATE
    FROM    ORACLE_SQL.ORACLE_SQL.INVENTORY  I
    LEFT JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES P
           ON P.ID = I.PURCHASE_ID
),
lot_allocation AS (              -- allocate lots to lines, FIFO
    SELECT  PL.PICKLIST_ID,
            PL.LINE_NO,
            PL.PRODUCT_ID,
            PL.REQUIRED_QTY,
            IL.INV_ID,
            IL.LOT_QTY,
            IL.PURCHASE_DATE,
            /* cumulative qty BEFORE this lot */
            SUM(IL.LOT_QTY)
              OVER (PARTITION BY PL.PICKLIST_ID, PL.LINE_NO
                    ORDER BY IL.PURCHASE_DATE, IL.LOT_QTY
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) - IL.LOT_QTY
              AS CUM_PRIOR
    FROM   picking_lines PL
    JOIN   inventory_lots IL
           ON IL.PRODUCT_ID = PL.PRODUCT_ID
),
picked_per_lot AS (              -- actual qty taken from each lot
    SELECT  *,
            CASE
                WHEN CUM_PRIOR >= REQUIRED_QTY THEN 0
                ELSE LEAST(LOT_QTY, REQUIRED_QTY - CUM_PRIOR)
            END AS PICKED_FROM_LOT
    FROM    lot_allocation
    WHERE   CUM_PRIOR < REQUIRED_QTY          -- ignore surplus lots
),
picked_per_line AS (             -- total picked per line
    SELECT  PICKLIST_ID,
            LINE_NO,
            PRODUCT_ID,
            REQUIRED_QTY,
            SUM(PICKED_FROM_LOT) AS PICKED_QTY
    FROM    picked_per_lot
    GROUP BY PICKLIST_ID, LINE_NO, PRODUCT_ID, REQUIRED_QTY
),
avg_pct_per_product AS (         -- average pick-percentage per product
    SELECT  PRODUCT_ID,
            AVG(PICKED_QTY / NULLIF(REQUIRED_QTY,0)) AS AVG_PICK_PCT
    FROM    picked_per_line
    GROUP BY PRODUCT_ID
)
SELECT  PR.NAME                                AS PRODUCT_NAME,
        ROUND(AVG_PICK_PCT * 100, 2)           AS AVERAGE_PICK_PERCENTAGE
FROM    avg_pct_per_product PP
JOIN    ORACLE_SQL.ORACLE_SQL.PRODUCTS PR
       ON PR.ID = PP.PRODUCT_ID
ORDER BY PRODUCT_NAME;
