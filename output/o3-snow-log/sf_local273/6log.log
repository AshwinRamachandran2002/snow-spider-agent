```sql
/* ---------------------------------------------------------------
   Average pick-percentage per product
   ---------------------------------------------------------------
   • FIFO logic ⇒ inventory lots are consumed in the sequence
     they were bought (earliest purchase_date first).  
     When two lots share the same date the one with the
     smallest quantity is taken first (tiebreaker).

   • For every picking-line we keep adding inventory lots until
     the requested quantity is satisfied; the actually “picked”
     quantity coming from every lot is therefore:

          picked_from_this_lot =
                LEAST(lot_qty ,
                     GREATEST(req_qty – cum_lot_qty_prior , 0))

   • The pick-percentage for a line is  picked_qty / req_qty .
     The query finally returns the average of those percentages
     per product name (ordered alphabetically).
-----------------------------------------------------------------*/
WITH picking_lines AS (          -- required quantities
    SELECT  pl."picklist_id",
            pl."line_no",
            pl."product_id",
            pl."qty"                   AS required_qty
    FROM    ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
),
inventory_lots AS (             -- inventory lots with purchase date
    SELECT  i."id"                AS inv_id,
            i."product_id",
            i."qty"               AS lot_qty,
            COALESCE(p."purchased",'9999-12-31') :: DATE  AS purchase_date
    FROM    ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
    LEFT JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" p
           ON p."id" = i."purchase_id"
),
lot_allocation AS (
    /* cartesian join per product – order lots FIFO */
    SELECT  pl.*,
            il.inv_id,
            il.lot_qty,
            il.purchase_date,
            SUM(il.lot_qty)
              OVER (PARTITION BY pl."picklist_id", pl."line_no"
                    ORDER BY il.purchase_date , il.lot_qty
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
                         - il.lot_qty                      AS cum_prior,
            SUM(il.lot_qty)
              OVER (PARTITION BY pl."picklist_id", pl."line_no"
                    ORDER BY il.purchase_date , il.lot_qty
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
                         AS cum_thru
    FROM   picking_lines  pl
    JOIN   inventory_lots il
           ON il."product_id" = pl."product_id"
),
picked_per_lot AS (
    /* lot is used only while cumulative picked < required */
    SELECT  *,
            CASE
               WHEN cum_prior >= required_qty   THEN 0                -- already covered
               ELSE LEAST(lot_qty , required_qty - cum_prior)         -- part or all of lot
            END                                   AS picked_from_lot
    FROM    lot_allocation
    WHERE   cum_prior < required_qty             -- ignore surplus lots
),
picked_per_line AS (            -- total actually picked on each line
    SELECT  "picklist_id",
            "line_no",
            "product_id",
            required_qty,
            SUM(picked_from_lot)  AS picked_qty
    FROM    picked_per_lot
    GROUP BY  "picklist_id","line_no","product_id", required_qty
),
avg_pct_per_product AS (
    SELECT  product_id,
            AVG(picked_qty / NULLIF(required_qty,0))  AS avg_pick_pct
    FROM    picked_per_line
    GROUP BY product_id
)
SELECT  pr."name"                         AS product_name,
        ROUND( 100 * avg_pick_pct , 2)    AS average_pick_percentage   -- % with two decimals
FROM    avg_pct_per_product pp
JOIN    ORACLE_SQL.ORACLE_SQL."PRODUCTS" pr
       ON pr."id" = pp.product_id
ORDER BY product_name;
```
