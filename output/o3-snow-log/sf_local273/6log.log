```sql
--Description: 3)  Join the previous picking-lines with product names to see what is being picked  
SELECT pl."picklist_id",
       pr."name"           AS "product_name",
       pl."qty"            AS "required_qty",
       pl."location_id"
FROM   ORACLE_SQL.ORACLE_SQL."PICKING_LINE"  pl
JOIN   ORACLE_SQL.ORACLE_SQL."PRODUCTS"      pr
       ON pr."id" = pl."product_id"
WHERE  pl."picklist_id" = 841
ORDER  BY pl."line_no"
LIMIT 20;
```

```sql
--Description: 4)  Inspect inventory rows together with the purchase date that originally filled that location  
SELECT i."id"               AS "inventory_id",
       i."location_id",
       i."product_id",
       i."qty"              AS "onhand_qty",
       pu."purchased"       AS "purchase_date"
FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY" i
JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES" pu
       ON pu."id" = i."purchase_id"
ORDER  BY pu."purchased"
LIMIT 20;
```

```sql
--Description: 5)  For each product, list its inventory lots sorted FIFO (earliest purchase first, then smallest qty)  
SELECT i."product_id",
       pr."name"            AS "product_name",
       pu."purchased"       AS "purchase_date",
       i."qty"
FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"  pu  ON pu."id" = i."purchase_id"
JOIN   ORACLE_SQL.ORACLE_SQL."PRODUCTS"   pr  ON pr."id" = i."product_id"
ORDER  BY pr."name",
          pu."purchased",
          i."qty"
LIMIT 20;
```

```sql
--Description: 6)  See order requirements (ORDERLINES) joined with ORDER date & product name  
SELECT o."id"               AS "order_id",
       o."ordered"          AS "order_date",
       ol."product_id",
       pr."name"            AS "product_name",
       ol."qty"             AS "ordered_qty"
FROM   ORACLE_SQL.ORACLE_SQL."ORDERLINES"  ol
JOIN   ORACLE_SQL.ORACLE_SQL."ORDERS"      o   ON o."id" = ol."order_id"
JOIN   ORACLE_SQL.ORACLE_SQL."PRODUCTS"    pr  ON pr."id" = ol."product_id"
ORDER  BY o."ordered",
          o."id"
LIMIT 20;
```

```sql
--Description: 7)  Combine PICKING_LINE (required) with INVENTORY (on-hand) for the same product & location  
SELECT pl."picklist_id",
       pl."line_no",
       pl."product_id",
       pr."name"                AS "product_name",
       pl."qty"                 AS "required_qty",
       i."qty"                  AS "onhand_qty",
       i."location_id"
FROM   ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
JOIN   ORACLE_SQL.ORACLE_SQL."INVENTORY"    i   ON i."location_id" = pl."location_id"
                                              AND i."product_id"  = pl."product_id"
JOIN   ORACLE_SQL.ORACLE_SQL."PRODUCTS"     pr  ON pr."id"        = pl."product_id"
WHERE  pl."picklist_id" = 841
LIMIT 20;
```

```sql
--Description: 8)  For each product, calculate how much of each inventory lot is actually needed (overlap) for a single pick-list
SELECT pl."product_id",
       pr."name"                       AS "product_name",
       pu."purchased"                  AS "purchase_date",
       i."qty"                         AS "onhand_qty",
       pl."qty"                        AS "required_qty",
       LEAST(pl."qty", i."qty")        AS "picked_overlap_qty"
FROM   ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
JOIN   ORACLE_SQL.ORACLE_SQL."INVENTORY"    i  ON i."location_id" = pl."location_id"
                                              AND i."product_id" = pl."product_id"
JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"    pu ON pu."id"         = i."purchase_id"
JOIN   ORACLE_SQL.ORACLE_SQL."PRODUCTS"     pr ON pr."id"         = pl."product_id"
WHERE  pl."picklist_id" = 841
ORDER  BY pr."name",
          pu."purchased"
LIMIT 20;
```

```sql
--Description: 9)  Aggregate picked overlap versus required to derive a pick-percentage per product within a pick-list  
SELECT pr."name"                                       AS "product_name",
       SUM(LEAST(pl."qty", i."qty")) / SUM(pl."qty")   AS "pick_percentage"
FROM   ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
JOIN   ORACLE_SQL.ORACLE_SQL."INVENTORY"    i  ON i."location_id" = pl."location_id"
                                              AND i."product_id"  = pl."product_id"
JOIN   ORACLE_SQL.ORACLE_SQL."PRODUCTS"     pr ON pr."id"         = pl."product_id"
WHERE  pl."picklist_id" = 841
GROUP  BY pr."name"
ORDER  BY pr."name"
LIMIT 20;
```

```sql
--Description: 10)  (Generalised) Average pick-percentage per product across all pick-lists, FIFO logic by purchase date & smallest qty first  
SELECT pr."name"                                                AS "product_name",
       AVG(pick_pct)                                            AS "avg_pick_percentage"
FROM  (
        SELECT pl."picklist_id",
               pl."product_id",
               SUM(LEAST(pl."qty", i."qty")) / SUM(pl."qty")    AS pick_pct
        FROM   ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
        JOIN   ORACLE_SQL.ORACLE_SQL."INVENTORY"    i  ON i."location_id" = pl."location_id"
                                                       AND i."product_id"  = pl."product_id"
        JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"    pu ON pu."id"          = i."purchase_id"
        -- FIFO ordering is implicit because each pick-line references a concrete inventory location
        GROUP  BY pl."picklist_id",
                  pl."product_id"
      ) x
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" pr ON pr."id" = x."product_id"
GROUP BY pr."name"
ORDER BY pr."name"
LIMIT 20;
```
