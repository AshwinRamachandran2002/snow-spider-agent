```sql
-- 1) What do we actually have on stock?  
--    Show the first 20 inventory rows (one row per purchase location/lot).
SELECT 
    "id",
    "location_id",
    "product_id",
    "purchase_id",
    "qty"
FROM ORACLE_SQL.ORACLE_SQL.INVENTORY
LIMIT 20;
```

```sql
-- 2) See the purchase information that created that stock  
--    (qty, purchase-date and brewery that delivered the lot).
SELECT 
    p."id"            AS "purchase_id",
    p."product_id",
    p."purchased",
    p."qty",
    p."brewery_id",
    p."cost"
FROM ORACLE_SQL.ORACLE_SQL.PURCHASES p
ORDER BY p."purchased"
LIMIT 20;
```

```sql
-- 3) Match inventory lots with their purchase rows  
--    (now we can combine lot-date & available quantity).
SELECT 
    i."id"            AS "inv_id",
    i."product_id",
    pu."purchased"    AS "purchase_date",
    i."qty"           AS "qty_available"
FROM ORACLE_SQL.ORACLE_SQL.INVENTORY  i
JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES  pu
      ON pu."id" = i."purchase_id"
ORDER BY pu."purchased", i."qty"
LIMIT 20;
```

```sql
-- 4) Which products are currently being picked?  
--    Distinct product list from the PICKING_LINE table.
SELECT DISTINCT 
    "product_id"
FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE
LIMIT 20;
```

```sql
-- 5) Add the human readable product names to the picking lines  
--    and show the requested pick quantities.
SELECT 
    pl."picklist_id",
    pr."name"             AS "product_name",
    pl."product_id",
    pl."qty"              AS "qty_to_pick"
FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE  pl
JOIN ORACLE_SQL.ORACLE_SQL.PRODUCTS      pr
      ON pr."id" = pl."product_id"
ORDER BY pl."picklist_id", pr."name"
LIMIT 20;
```

```sql
-- 6) FIFO lot ranking per product  
--    (1 = oldest purchase / smallest qty when dates tie).
SELECT 
    inv."id"                         AS "inv_id",
    inv."product_id",
    pu."purchased",
    inv."qty",
    ROW_NUMBER() OVER (
        PARTITION BY inv."product_id"
        ORDER BY pu."purchased", inv."qty"
    )                                AS "fifo_rank"
FROM ORACLE_SQL.ORACLE_SQL.INVENTORY  inv
JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES  pu
      ON pu."id" = inv."purchase_id"
ORDER BY inv."product_id", "fifo_rank"
LIMIT 20;
```

```sql
-- 7) Cumulate the available quantity in FIFO order – lets us see  
--    how far each lot will cover outstanding pick quantities.
SELECT
    x."product_id",
    x."inv_id",
    x."purchased",
    x."qty",
    SUM(x."qty") OVER (
        PARTITION BY x."product_id"
        ORDER BY x."fifo_rank"
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    )                                 AS "cum_qty_available"
FROM (
    SELECT 
        inv."id"                AS "inv_id",
        inv."product_id",
        pu."purchased",
        inv."qty",
        ROW_NUMBER() OVER (
            PARTITION BY inv."product_id"
            ORDER BY pu."purchased", inv."qty"
        )                       AS "fifo_rank"
    FROM ORACLE_SQL.ORACLE_SQL.INVENTORY  inv
    JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES  pu
          ON pu."id" = inv."purchase_id"
) x
ORDER BY x."product_id", x."fifo_rank"
LIMIT 20;
```

```sql
-- 8) Align (pick-line) demand with FIFO lots – we keep only the  
--    overlapping quantity between required and available (the true pick).
SELECT
    pl."picklist_id",
    pr."name"                    AS "product_name",
    pl."product_id",
    pl."qty"                     AS "qty_to_pick",
    inv."id"                     AS "inv_id",
    inv."qty"                    AS "qty_available",
    LEAST(pl."qty", inv."qty")   AS "qty_picked_overlap"
FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE  pl
JOIN ORACLE_SQL.ORACLE_SQL.INVENTORY     inv
      ON inv."product_id" = pl."product_id"
JOIN ORACLE_SQL.ORACLE_SQL.PRODUCTS      pr
      ON pr."id" = pl."product_id"
JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES     pu
      ON pu."id" = inv."purchase_id"
QUALIFY ROW_NUMBER() OVER (
            PARTITION BY pl."picklist_id", pl."product_id"
            ORDER BY pu."purchased", inv."qty"
       ) = 1   -- take FIFO lot first
LIMIT 20;
```

```sql
-- 9) Compute the pick percentage per pick-line (= overlap/need).
SELECT
    pr."name"                         AS "product_name",
    pl."picklist_id",
    pl."qty"                          AS "qty_to_pick",
    inv."qty"                         AS "qty_available",
    LEAST(pl."qty", inv."qty") 
      / NULLIF(pl."qty", 0)           AS "pick_pct"
FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE  pl
JOIN ORACLE_SQL.ORACLE_SQL.INVENTORY     inv
      ON inv."product_id" = pl."product_id"
JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES     pu
      ON pu."id" = inv."purchase_id"
JOIN ORACLE_SQL.ORACLE_SQL.PRODUCTS      pr
      ON pr."id" = pl."product_id"
QUALIFY ROW_NUMBER() OVER (
            PARTITION BY pl."picklist_id", pl."product_id"
            ORDER BY pu."purchased", inv."qty"
       ) = 1
LIMIT 20;
```

```sql
-- 10) FINAL – average pick percentage per product name  
--     (FIFO, overlap logic applied) ordered alphabetically.
SELECT
    pr."name"                                          AS "product_name",
    AVG(
        LEAST(pl."qty", inv."qty") / NULLIF(pl."qty", 0)
    )                                                  AS "avg_pick_pct"
FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE  pl
JOIN ORACLE_SQL.ORACLE_SQL.INVENTORY     inv
      ON inv."product_id" = pl."product_id"
JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES     pu
      ON pu."id" = inv."purchase_id"
JOIN ORACLE_SQL.ORACLE_SQL.PRODUCTS      pr
      ON pr."id" = pl."product_id"
QUALIFY ROW_NUMBER() OVER (
            PARTITION BY pl."picklist_id", pl."product_id"
            ORDER BY pu."purchased", inv."qty"
       ) = 1
GROUP BY pr."name"
ORDER BY pr."name"
LIMIT 20;
```
