```sql
--Description: 1)  Identify all products that have ever been ordered
SELECT DISTINCT 
       "product_id"
FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
LIMIT 20;
```

```sql
--Description: 2)  Show those ordered products with their names for easy reading
SELECT DISTINCT 
       ol."product_id",
       p."name"      AS "product_name"
FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"  ol
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PRODUCTS"    p
       ON p."id" = ol."product_id"
LIMIT 20;
```

```sql
--Description: 3)  Inspect current inventory lots together with the purchase date (needed for FIFO)
SELECT 
       i."id"          AS "inventory_id",
       i."product_id",
       i."location_id",
       i."qty"         AS "inv_qty",
       pu."purchased"  AS "purchase_date"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  i
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"  pu
       ON pu."id" = i."purchase_id"
ORDER  BY i."product_id", pu."purchased"
LIMIT 20;
```

```sql
--Description: 4)  Look at what has been picked for shipment (per line/location)
SELECT 
       pl."order_id",
       pl."product_id",
       pl."location_id",
       pl."qty" AS "picked_qty"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
ORDER  BY pl."order_id", pl."product_id"
LIMIT 20;
```

```sql
--Description: 5)  Combine picking-lines with their matching inventory lots to see which purchase they came from
SELECT 
       pl."order_id",
       pl."product_id",
       pl."location_id",
       pl."qty"            AS "picked_qty",
       i."qty"             AS "inv_qty",
       pu."purchased"      AS "purchase_date"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
JOIN   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"    i
       ON i."location_id" = pl."location_id"
      AND i."product_id"  = pl."product_id"
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"    pu
       ON pu."id" = i."purchase_id"
ORDER  BY pl."product_id", pu."purchased"
LIMIT 20;
```

```sql
--Description: 6)  Apply FIFO: keep only the earliest-dated, smallest-quantity lot per order×product
WITH inv_pick AS (
    SELECT  pl."order_id",
            pl."product_id",
            pl."qty"          AS "picked_qty",
            i."qty"           AS "inv_qty",
            pu."purchased",
            ROW_NUMBER() OVER (
                  PARTITION BY pl."order_id", pl."product_id"
                  ORDER BY     pu."purchased", i."qty"
            )                 AS rn
    FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
    JOIN   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"    i
           ON i."location_id" = pl."location_id"
          AND i."product_id"  = pl."product_id"
    JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"    pu
           ON pu."id" = i."purchase_id"
)
SELECT *
FROM   inv_pick
WHERE  rn = 1          -- FIFO lot selected
LIMIT 20;
```

```sql
--Description: 7)  For each order×product find the total quantity that was actually ordered
SELECT 
       "order_id",
       "product_id",
       SUM("qty") AS "required_qty"
FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
GROUP  BY "order_id", "product_id"
LIMIT 20;
```

```sql
--Description: 8)  Calculate the overlapping quantity (picked vs. inventory) for every order×product
WITH fifo_pick AS (
    SELECT  pl."order_id",
            pl."product_id",
            LEAST(pl."picked_qty", pl."inv_qty") AS "overlap_qty"
    FROM   (
            -- reuse CTE from step 6
            WITH inv_pick AS (
                SELECT  pl."order_id",
                        pl."product_id",
                        pl."qty"          AS "picked_qty",
                        i."qty"           AS "inv_qty",
                        pu."purchased",
                        ROW_NUMBER() OVER (
                              PARTITION BY pl."order_id", pl."product_id"
                              ORDER BY     pu."purchased", i."qty"
                        )                 AS rn
                FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
                JOIN   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"    i
                       ON i."location_id" = pl."location_id"
                      AND i."product_id"  = pl."product_id"
                JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"    pu
                       ON pu."id" = i."purchase_id"
            )
            SELECT *
            FROM   inv_pick
            WHERE  rn = 1
          ) pl
)
SELECT *
FROM   fifo_pick
LIMIT 20;
```

```sql
--Description: 9)  Merge required vs. picked-overlap to compute the pick-percentage per order×product
WITH req AS (
    SELECT "order_id", "product_id", SUM("qty") AS "required_qty"
    FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
    GROUP  BY "order_id", "product_id"
),
pick AS (
    SELECT  fp."order_id",
            fp."product_id",
            fp."overlap_qty"
    FROM   (
            -- inner CTE identical to step 8 to keep script self-contained
            WITH inv_pick AS (
                SELECT  pl."order_id",
                        pl."product_id",
                        pl."qty"          AS "picked_qty",
                        i."qty"           AS "inv_qty",
                        pu."purchased",
                        ROW_NUMBER() OVER (
                              PARTITION BY pl."order_id", pl."product_id"
                              ORDER BY     pu."purchased", i."qty"
                        )                 AS rn
                FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
                JOIN   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"    i
                       ON i."location_id" = pl."location_id"
                      AND i."product_id"  = pl."product_id"
                JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"    pu
                       ON pu."id" = i."purchase_id"
            )
            SELECT  ip."order_id",
                    ip."product_id",
                    LEAST(ip."picked_qty", ip."inv_qty") AS "overlap_qty"
            FROM    inv_pick ip
            WHERE   ip.rn = 1
          ) fp
)
SELECT 
       r."order_id",
       r."product_id",
       100.0 * p."overlap_qty" / r."required_qty" AS "pick_percent"
FROM   req r
JOIN   pick p
       ON p."order_id"   = r."order_id"
      AND p."product_id" = r."product_id"
LIMIT 20;
```

```sql
--Description: 10)  Final answer – average FIFO pick-percentage per product name, ordered alphabetically
WITH req AS (
    SELECT "order_id", "product_id", SUM("qty") AS "required_qty"
    FROM   "ORACLE_SQL"."ORACLE_SQL"."ORDERLINES"
    GROUP  BY "order_id", "product_id"
),
fifo_pick AS (
    WITH inv_pick AS (
        SELECT  pl."order_id",
                pl."product_id",
                pl."qty"          AS "picked_qty",
                i."qty"           AS "inv_qty",
                pu."purchased",
                ROW_NUMBER() OVER (
                      PARTITION BY pl."order_id", pl."product_id"
                      ORDER BY     pu."purchased", i."qty"
                )                 AS rn
        FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
        JOIN   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"    i
               ON i."location_id" = pl."location_id"
              AND i."product_id"  = pl."product_id"
        JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"    pu
               ON pu."id" = i."purchase_id"
    )
    SELECT  ip."order_id",
            ip."product_id",
            LEAST(ip."picked_qty", ip."inv_qty") AS "overlap_qty"
    FROM    inv_pick ip
    WHERE   ip.rn = 1
),
order_pct AS (
    SELECT r."product_id",
           100.0 * fp."overlap_qty" / r."required_qty" AS "pick_percent"
    FROM   req      r
    JOIN   fifo_pick fp
           ON fp."order_id"   = r."order_id"
          AND fp."product_id" = r."product_id"
)
SELECT  pr."name"                                    AS "product_name",
        AVG(op."pick_percent")                       AS "avg_pick_percent"
FROM    order_pct          op
JOIN    "ORACLE_SQL"."ORACLE_SQL"."PRODUCTS" pr
        ON pr."id" = op."product_id"
GROUP   BY pr."name"
ORDER   BY pr."name"
LIMIT 20;
```
