```sql
--Description: 1) Inspect current on-hand inventory records
SELECT *
FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"
LIMIT 20;
```

```sql
--Description: 2) View the purchase documents that created the inventory (will be used for FIFO date)
SELECT *
FROM "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"
ORDER BY "purchased"
LIMIT 20;
```

```sql
--Description: 3) Combine inventory with its originating purchase to add purchase date & brewery
SELECT i."id"              AS "inv_id",
       i."product_id",
       i."qty"              AS "inv_qty",
       p."purchased"        AS "purchase_date",
       p."brewery_id"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  i
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"  p
       ON i."purchase_id" = p."id"
ORDER BY p."purchased", i."qty"
LIMIT 20;
```

```sql
--Description: 4) Inspect the lines that were physically picked for customer orders
SELECT *
FROM "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE"
LIMIT 20;
```

```sql
--Description: 5) Add order information (order date / customer) to each pick line
SELECT pl."picklist_id",
       pl."order_id",
       o."ordered"      AS "order_date",
       o."customer_id",
       pl."product_id",
       pl."qty"         AS "picked_qty"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
JOIN   "ORACLE_SQL"."ORACLE_SQL"."ORDERS"       o
       ON pl."order_id" = o."id"
ORDER BY o."ordered"
LIMIT 20;
```

```sql
--Description: 6) Look at how much was picked versus what was in FIFO-sorted inventory (overlap only)
SELECT pl."product_id",
       pl."qty"                  AS "picked_qty",
       p."purchased"             AS "fifo_purchase_date",
       i."qty"                   AS "inv_qty_at_location"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
JOIN   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"    i
       ON pl."product_id" = i."product_id"
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"    p
       ON i."purchase_id" = p."id"
ORDER BY pl."product_id", p."purchased", i."qty"
LIMIT 20;
```

```sql
--Description: 7) Aggregate total quantity picked per product
SELECT pl."product_id",
       SUM(pl."qty") AS "total_picked_qty"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
GROUP  BY pl."product_id"
LIMIT 20;
```

```sql
--Description: 8) Aggregate current total inventory per product
SELECT i."product_id",
       SUM(i."qty") AS "total_inv_qty"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
GROUP  BY i."product_id"
LIMIT 20;
```

```sql
--Description: 9) Derive pick-percentage per product (picked ÷ [picked+inventory])
SELECT a."product_id",
       ROUND(100 * a."total_picked_qty" / NULLIF((a."total_picked_qty" + b."total_inv_qty"),0),2) AS "pick_pct"
FROM  (SELECT pl."product_id", SUM(pl."qty") AS "total_picked_qty"
       FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
       GROUP  BY pl."product_id")  a
JOIN  (SELECT i."product_id", SUM(i."qty") AS "total_inv_qty"
       FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
       GROUP  BY i."product_id")    b
       ON a."product_id" = b."product_id"
ORDER BY "pick_pct" DESC
LIMIT 20;
```

```sql
--Description: 10) Produce the final average pick percentage report by readable product name
SELECT pr."name"                               AS "product_name",
       AVG(x."pick_pct")                       AS "avg_pick_pct"
FROM  (
        SELECT a."product_id",
               100 * a."total_picked_qty" /
               NULLIF((a."total_picked_qty" + b."total_inv_qty"),0) AS "pick_pct"
        FROM  (SELECT pl."product_id", SUM(pl."qty") AS "total_picked_qty"
               FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
               GROUP  BY pl."product_id")  a
        JOIN  (SELECT i."product_id", SUM(i."qty") AS "total_inv_qty"
               FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
               GROUP  BY i."product_id")  b
               ON a."product_id" = b."product_id"
      ) x
JOIN "ORACLE_SQL"."ORACLE_SQL"."PRODUCTS" pr
     ON x."product_id" = pr."id"
GROUP BY pr."name"
ORDER BY pr."name"
LIMIT 20;
```
