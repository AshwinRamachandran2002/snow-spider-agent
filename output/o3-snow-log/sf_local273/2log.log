```sql
/* -----------------------------------------------------------
   Average pick–percentage per product (FIFO-based allocation)
   -----------------------------------------------------------
   1) Build an ordered (FIFO) inventory list per product
      – earliest purchase date first
      – for identical dates the smallest available qty first.
   2) Gather total quantity that has been picked for the product.
   3) For every inventory row work out how much of that row
      is actually consumed by the picks (over-lap logic):
           picked_from_row =
              least(inv_qty ,
                   greatest(total_picked - cum_inv_before , 0) )
   4) Row-level pick-percentage = picked_from_row / inv_qty.
   5) Return the average of these row percentages per product
      and order by product name.
----------------------------------------------------------------*/
WITH inv AS (   -- FIFO list of inventory locations
    SELECT  i."id"               AS inventory_id,
            i."product_id",
            pr."name"            AS product_name,
            i."qty"              AS inv_qty,
            p."purchased"::DATE  AS purchase_date,
            /* running total before the current row                */
            SUM(i."qty") OVER (
                PARTITION BY i."product_id"
                ORDER BY p."purchased", i."qty"
                ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
            )                    AS cum_inv_before
    FROM    ORACLE_SQL.ORACLE_SQL.INVENTORY  i
    JOIN    ORACLE_SQL.ORACLE_SQL.PURCHASES  p
           ON p."id" = i."purchase_id"
    JOIN    ORACLE_SQL.ORACLE_SQL.PRODUCTS   pr
           ON pr."id" = i."product_id"
),
picked AS (     -- how much has been picked for every product
    SELECT  "product_id",
            SUM("qty") AS total_picked_qty
    FROM    ORACLE_SQL.ORACLE_SQL.PICKING_LINE
    GROUP BY "product_id"
),
inv_alloc AS (  -- allocate picks to FIFO inventory rows
    SELECT  inv.inventory_id,
            inv.product_id,
            inv.product_name,
            inv.inv_qty,
            inv.cum_inv_before,
            COALESCE(p.total_picked_qty,0)              AS total_picked_qty,
            /* overlap between what is left to pick
               and what the row can supply                */
            LEAST(
                inv.inv_qty,
                GREATEST(COALESCE(p.total_picked_qty,0) - inv.cum_inv_before, 0)
            )                                           AS picked_from_row
    FROM    inv
    LEFT JOIN picked p
           ON p.product_id = inv.product_id
),
row_pct AS (    -- row-level pick percentage
    SELECT  product_id,
            product_name,
            CASE
               WHEN inv_qty = 0 THEN NULL
               ELSE 100 * picked_from_row / inv_qty
            END AS row_pick_pct
    FROM    inv_alloc
)
SELECT  product_name,
        ROUND(AVG(row_pick_pct), 2) AS avg_pick_pct
FROM    row_pct
GROUP BY product_name
ORDER BY product_name;
```
