```sql
--Description: Produce the average pick-percentage by product name.  
-- 1)  Aggregate how much was picked per product from PICKING_LINE.  
-- 2)  LEFT JOIN to INVENTORY (which is currently empty) and use COALESCE so missing stock = 0.  
-- 3)  Calculate the pick-percentage for each product.  
-- 4)  Join to PRODUCTS to get the readable product name and average (here it will equal the single value).  
-- Note: use un-quoted NAME and ID in PRODUCTS to avoid the earlier case-sensitive error.
SELECT  pr.NAME                                           AS PRODUCT_NAME,
        AVG(x.PICK_PCT)                                   AS AVG_PICK_PCT
FROM   (
         SELECT a.PRODUCT_ID,
                100 * a.TOTAL_PICKED_QTY /
                NULLIF(a.TOTAL_PICKED_QTY + COALESCE(b.TOTAL_INV_QTY,0),0) AS PICK_PCT
         FROM  ( SELECT pl."product_id"        AS PRODUCT_ID,
                        SUM(pl."qty")          AS TOTAL_PICKED_QTY
                 FROM   ORACLE_SQL.ORACLE_SQL.PICKING_LINE pl
                 GROUP  BY pl."product_id"
               ) a
         LEFT JOIN
               ( SELECT i."PRODUCTID"          AS PRODUCT_ID,
                        SUM(i."QUANTITY")      AS TOTAL_INV_QTY
                 FROM   ORACLE_SQL.ORACLE_SQL.INVENTORY i
                 GROUP  BY i."PRODUCTID"
               ) b
           ON a.PRODUCT_ID = b.PRODUCT_ID
       ) x
JOIN   ORACLE_SQL.ORACLE_SQL.PRODUCTS pr
  ON   x.PRODUCT_ID = pr.ID
GROUP BY pr.NAME
ORDER BY pr.NAME
LIMIT 20;
```
