/* -----------------------------------------------------------
   Average pick-percentage per product (FIFO-based allocation)
-------------------------------------------------------------*/
WITH inv AS (   -- FIFO list of inventory locations
    SELECT  i."ID"                AS INVENTORY_ID,
            i."PRODUCT_ID",
            pr."NAME"             AS PRODUCT_NAME,
            i."QTY"               AS INV_QTY,
            TO_DATE(p."PURCHASED") AS PURCHASE_DATE,
            /* running total quantity BEFORE current row          */
            SUM(i."QTY") OVER (
                PARTITION BY i."PRODUCT_ID"
                ORDER BY TO_DATE(p."PURCHASED"), i."QTY"
                ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
            )                     AS CUM_INV_BEFORE
    FROM    ORACLE_SQL.ORACLE_SQL.INVENTORY  i
    JOIN    ORACLE_SQL.ORACLE_SQL.PURCHASES  p
           ON p."ID" = i."PURCHASE_ID"
    JOIN    ORACLE_SQL.ORACLE_SQL.PRODUCTS   pr
           ON pr."ID" = i."PRODUCT_ID"
),
picked AS (     -- total quantity already picked per product
    SELECT  "PRODUCT_ID",
            SUM("QTY") AS TOTAL_PICKED_QTY
    FROM    ORACLE_SQL.ORACLE_SQL.PICKING_LINE
    GROUP BY "PRODUCT_ID"
),
inv_alloc AS (  -- allocate picks to FIFO inventory rows
    SELECT  inv.INVENTORY_ID,
            inv.PRODUCT_ID,
            inv.PRODUCT_NAME,
            inv.INV_QTY,
            inv.CUM_INV_BEFORE,
            COALESCE(p.TOTAL_PICKED_QTY, 0)             AS TOTAL_PICKED_QTY,
            /* overlap = amount picked from this inventory row     */
            LEAST(
                inv.INV_QTY,
                GREATEST(COALESCE(p.TOTAL_PICKED_QTY,0) - inv.CUM_INV_BEFORE, 0)
            )                                            AS PICKED_FROM_ROW
    FROM    inv
    LEFT JOIN picked p
           ON p.PRODUCT_ID = inv.PRODUCT_ID
),
row_pct AS (    -- row-level pick percentage
    SELECT  PRODUCT_ID,
            PRODUCT_NAME,
            CASE
               WHEN INV_QTY = 0 THEN NULL
               ELSE 100 * PICKED_FROM_ROW / INV_QTY
            END AS ROW_PICK_PCT
    FROM    inv_alloc
)
SELECT  PRODUCT_NAME,
        ROUND(AVG(ROW_PICK_PCT), 2) AS AVG_PICK_PCT
FROM    row_pct
GROUP BY PRODUCT_NAME
ORDER BY PRODUCT_NAME;
