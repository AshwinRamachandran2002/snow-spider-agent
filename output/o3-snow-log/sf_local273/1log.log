```sql
-- 5) Build FIFO-ordered inventory lots with cumulative range for every product
WITH inv AS (
  SELECT
    i."id"                    AS "inv_id",
    i."product_id",
    i."qty"                   AS "inv_qty",
    TO_DATE(p."purchased")    AS "purchase_date",
    SUM(i."qty") OVER (PARTITION BY i."product_id"
                       ORDER BY TO_DATE(p."purchased"), i."id")               AS "inv_cum_end"
  FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
  JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"  p
    ON i."purchase_id" = p."id"
)
SELECT
  "inv_id",
  "product_id",
  "inv_qty",
  "purchase_date",
  ("inv_cum_end" - "inv_qty") AS "inv_cum_start",
  "inv_cum_end"
FROM inv
ORDER BY "product_id", "purchase_date"
LIMIT 20;
```

```sql
-- 6) Build FIFO-ordered picking requirements with cumulative range
WITH req AS (
  SELECT
    pl."picklist_id",
    pl."line_no",
    pl."product_id",
    pl."qty"                                                 AS "pick_qty",
    TO_TIMESTAMP(l."created")                                AS "pick_time",
    SUM(pl."qty") OVER (PARTITION BY pl."product_id"
                        ORDER BY TO_TIMESTAMP(l."created"), pl."line_no")      AS "pick_cum_end"
  FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"  pl
  JOIN ORACLE_SQL.ORACLE_SQL."PICKING_LIST"  l
    ON pl."picklist_id" = l."id"
)
SELECT
  "picklist_id",
  "line_no",
  "product_id",
  "pick_qty",
  "pick_time",
  ("pick_cum_end" - "pick_qty") AS "pick_cum_start",
  "pick_cum_end"
FROM req
ORDER BY "product_id", "pick_time"
LIMIT 20;
```

```sql
-- 7) Match requirement-ranges to inventory-ranges (FIFO overlap)
WITH inv AS (
  SELECT
    i."id"                  AS "inv_id",
    i."product_id",
    i."qty"                 AS "inv_qty",
    TO_DATE(p."purchased")  AS "purchase_date",
    SUM(i."qty") OVER (PARTITION BY i."product_id"
                       ORDER BY TO_DATE(p."purchased"), i."id")               AS "inv_cum_end"
  FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
  JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"  p
    ON i."purchase_id" = p."id"
), inv_r AS (
  SELECT
    "inv_id",
    "product_id",
    "inv_qty",
    ("inv_cum_end" - "inv_qty")                           AS "inv_cum_start",
    "inv_cum_end"
  FROM inv
), req AS (
  SELECT
    pl."picklist_id",
    pl."line_no",
    pl."product_id",
    pl."qty"                                               AS "pick_qty",
    TO_TIMESTAMP(l."created")                              AS "pick_time",
    SUM(pl."qty") OVER (PARTITION BY pl."product_id"
                        ORDER BY TO_TIMESTAMP(l."created"), pl."line_no")     AS "pick_cum_end"
  FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"  pl
  JOIN ORACLE_SQL.ORACLE_SQL."PICKING_LIST"  l
    ON pl."picklist_id" = l."id"
), req_r AS (
  SELECT
    "picklist_id",
    "line_no",
    "product_id",
    "pick_qty",
    ("pick_cum_end" - "pick_qty")                         AS "pick_cum_start",
    "pick_cum_end"
  FROM req
)
SELECT
  r."product_id",
  r."picklist_id",
  r."line_no",
  i."inv_id",
  GREATEST(0,
           LEAST(i."inv_cum_end", r."pick_cum_end") -
           GREATEST(i."inv_cum_start", r."pick_cum_start"))               AS "picked_qty_overlap",
  i."inv_qty"
FROM req_r  r
JOIN inv_r  i
  ON r."product_id" = i."product_id"
     AND i."inv_cum_start" < r."pick_cum_end"
     AND r."pick_cum_start" < i."inv_cum_end"
ORDER BY r."product_id", r."picklist_id", r."line_no", i."inv_cum_start"
LIMIT 20;
```

```sql
-- 8) Calculate per-lot pick-percentage (= picked / lot-qty)
WITH overlap AS (
  /* previous CTE from step-7 */
  WITH inv AS (
    SELECT
      i."id"                  AS "inv_id",
      i."product_id",
      i."qty"                 AS "inv_qty",
      TO_DATE(p."purchased")  AS "purchase_date",
      SUM(i."qty") OVER (PARTITION BY i."product_id"
                         ORDER BY TO_DATE(p."purchased"), i."id")             AS "inv_cum_end"
    FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
    JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"  p
      ON i."purchase_id" = p."id"
  ), inv_r AS (
    SELECT
      "inv_id",
      "product_id",
      "inv_qty",
      ("inv_cum_end" - "inv_qty")                         AS "inv_cum_start",
      "inv_cum_end"
    FROM inv
  ), req AS (
    SELECT
      pl."picklist_id",
      pl."line_no",
      pl."product_id",
      pl."qty"                                             AS "pick_qty",
      TO_TIMESTAMP(l."created")                            AS "pick_time",
      SUM(pl."qty") OVER (PARTITION BY pl."product_id"
                          ORDER BY TO_TIMESTAMP(l."created"), pl."line_no")   AS "pick_cum_end"
    FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"  pl
    JOIN ORACLE_SQL.ORACLE_SQL."PICKING_LIST"  l
      ON pl."picklist_id" = l."id"
  ), req_r AS (
    SELECT
      "picklist_id",
      "line_no",
      "product_id",
      "pick_qty",
      ("pick_cum_end" - "pick_qty")                       AS "pick_cum_start",
      "pick_cum_end"
    FROM req
  )
  SELECT
    r."product_id",
    i."inv_id",
    GREATEST(0,
             LEAST(i."inv_cum_end", r."pick_cum_end") -
             GREATEST(i."inv_cum_start", r."pick_cum_start"))         AS "picked_qty",
    i."inv_qty"
  FROM req_r  r
  JOIN inv_r  i
    ON r."product_id" = i."product_id"
       AND i."inv_cum_start" < r."pick_cum_end"
       AND r."pick_cum_start" < i."inv_cum_end"
)
SELECT
  "product_id",
  "inv_id",
  "picked_qty",
  "inv_qty",
  CASE WHEN "inv_qty" = 0 THEN 0 ELSE "picked_qty" / "inv_qty" END  AS "pick_pct"
FROM overlap
ORDER BY "product_id", "inv_id"
LIMIT 20;
```

```sql
-- 9) Average pick-percentage per product-name (final result)
WITH overlap AS (
  /* identical CTE from step-8 (producing pick_pct for every inv-lot) */
  WITH inv AS (
    SELECT
      i."id"                  AS "inv_id",
      i."product_id",
      i."qty"                 AS "inv_qty",
      TO_DATE(p."purchased")  AS "purchase_date",
      SUM(i."qty") OVER (PARTITION BY i."product_id"
                         ORDER BY TO_DATE(p."purchased"), i."id")             AS "inv_cum_end"
    FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
    JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"  p
      ON i."purchase_id" = p."id"
  ), inv_r AS (
    SELECT
      "inv_id",
      "product_id",
      "inv_qty",
      ("inv_cum_end" - "inv_qty")                       AS "inv_cum_start",
      "inv_cum_end"
    FROM inv
  ), req AS (
    SELECT
      pl."picklist_id",
      pl."line_no",
      pl."product_id",
      pl."qty"                                           AS "pick_qty",
      TO_TIMESTAMP(l."created")                          AS "pick_time",
      SUM(pl."qty") OVER (PARTITION BY pl."product_id"
                          ORDER BY TO_TIMESTAMP(l."created"), pl."line_no")   AS "pick_cum_end"
    FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"  pl
    JOIN ORACLE_SQL.ORACLE_SQL."PICKING_LIST"  l
      ON pl."picklist_id" = l."id"
  ), req_r AS (
    SELECT
      "picklist_id",
      "line_no",
      "product_id",
      "pick_qty",
      ("pick_cum_end" - "pick_qty")                     AS "pick_cum_start",
      "pick_cum_end"
    FROM req
  )
  SELECT
    r."product_id",
    i."inv_id",
    GREATEST(0,
             LEAST(i."inv_cum_end", r."pick_cum_end") -
             GREATEST(i."inv_cum_start", r."pick_cum_start"))         AS "picked_qty",
    i."inv_qty",
    CASE WHEN i."inv_qty" = 0 THEN 0
         ELSE GREATEST(0,
                       LEAST(i."inv_cum_end", r."pick_cum_end") -
                       GREATEST(i."inv_cum_start", r."pick_cum_start"))
              / i."inv_qty"
    END                                                               AS "pick_pct"
  FROM req_r  r
  JOIN inv_r  i
    ON r."product_id" = i."product_id"
       AND i."inv_cum_start" < r."pick_cum_end"
       AND r."pick_cum_start" < i."inv_cum_end"
)
SELECT
  pr."name"                                      AS "product_name",
  AVG(o."pick_pct")                              AS "avg_pick_percentage"
FROM overlap                o
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"  pr
  ON o."product_id" = pr."id"
GROUP BY pr."name"
ORDER BY pr."name"
LIMIT 20;
```
