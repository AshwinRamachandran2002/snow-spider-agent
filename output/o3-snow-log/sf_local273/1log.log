--Description:  Create FIFO-ordered inventory lots and expose each lot’s cumulative
--              start/end range per product.  Use the actual case-sensitive column
--              names ("ID", "PRODUCT_ID", etc.) so the query compiles.
WITH inv AS (
    SELECT
        i."ID"                               AS "INV_ID",
        i."PRODUCT_ID",
        i."QTY"                              AS "INV_QTY",
        TO_DATE(p."PURCHASED")               AS "PURCHASE_DATE",
        SUM(i."QTY") OVER (
            PARTITION BY i."PRODUCT_ID"
            ORDER BY TO_DATE(p."PURCHASED"), i."ID"
        )                                    AS "INV_CUM_END"
    FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
    JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"  p
      ON i."PURCHASE_ID" = p."ID"
)
SELECT
    "INV_ID",
    "PRODUCT_ID",
    "INV_QTY",
    "PURCHASE_DATE",
    ("INV_CUM_END" - "INV_QTY") AS "INV_CUM_START",
    "INV_CUM_END"
FROM inv
ORDER BY "PRODUCT_ID", "PURCHASE_DATE"
LIMIT 20;
