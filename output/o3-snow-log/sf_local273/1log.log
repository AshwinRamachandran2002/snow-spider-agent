req AS (                               /* 2. Required qty per order/product */
    SELECT
        order_id,
        product_id,
        SUM(qty) AS req_qty
    FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE
    GROUP BY order_id, product_id
),
alloc AS (                             /* 3. Apply FIFO inventory to needs  */
    SELECT
        r.order_id,
        r.product_id,
        r.req_qty,
        inv.inv_id,
        inv.inv_qty,
        inv.purchased,
        SUM(inv.inv_qty) OVER (
            PARTITION BY r.order_id, r.product_id
            ORDER BY inv.purchased, inv.inv_qty
            ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
        ) AS prev_cum_qty
    FROM req r
    JOIN inv
      ON inv.product_id = r.product_id
),
alloc2 AS (                            /* 4. Picked amount from each row    */
    SELECT
        order_id,
        product_id,
        req_qty,
        inv_id,
        inv_qty,
        purchased,
        COALESCE(prev_cum_qty,0) AS prev_cum_qty,
        CASE
            WHEN req_qty - COALESCE(prev_cum_qty,0) <= 0      THEN 0
            WHEN req_qty - COALESCE(prev_cum_qty,0) >= inv_qty THEN inv_qty
            ELSE  req_qty - COALESCE(prev_cum_qty,0)
        END AS picked_qty
    FROM alloc
),
order_pick AS (                        /* 5. Pick-percentage per order      */
    SELECT
        order_id,
        product_id,
        req_qty,
        SUM(picked_qty) AS picked_total,
        CASE
            WHEN req_qty = 0 THEN 0
            ELSE SUM(picked_qty) / req_qty
        END AS pick_pct
    FROM alloc2
    GROUP BY order_id, product_id, req_qty
),
prod_avg AS (                          /* 6. Average per product            */
    SELECT
        pr.name        AS product_name,
        AVG(pick_pct)  AS avg_pick_pct
    FROM order_pick op
    JOIN ORACLE_SQL.ORACLE_SQL.PRODUCTS pr
      ON pr.id = op.product_id
    GROUP BY pr.name
)
SELECT
    product_name,
    ROUND(avg_pick_pct * 100, 2) AS avg_pick_percentage
FROM prod_avg
ORDER BY product_name;
