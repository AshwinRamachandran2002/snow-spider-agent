```sql
--Description:  (Thinking process embedded in steps)
--  1) Create FIFO-ordered inventory lots (inv) with cumulative range so each lot
--     occupies [inv_cum_start , inv_cum_end) on a running timeline per product.
--  2) Create FIFO-ordered picking requirements (req) with cumulative range
--     [pick_cum_start , pick_cum_end) on the same timeline per product.
--  3) Join the two timelines where their ranges overlap; the length of the
--     overlap is the quantity actually taken from that inventory lot.
--  4) Convert that quantity to a pick-percentage for the lot
--     (picked_qty / lot_qty).
--  5) Finally average those percentages per product name.
WITH inv AS (
    SELECT
        i."ID"                                 AS "INV_ID",
        i."PRODUCT_ID",
        i."QTY"                                AS "INV_QTY",
        TO_DATE(p."PURCHASED")                 AS "PURCHASE_DATE",
        SUM(i."QTY") OVER (
            PARTITION BY i."PRODUCT_ID"
            ORDER BY TO_DATE(p."PURCHASED"), i."ID"
        )                                      AS "INV_CUM_END"
    FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
    JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"  p
      ON i."PURCHASE_ID" = p."ID"
), inv_r AS (
    SELECT
        "INV_ID",
        "PRODUCT_ID",
        "INV_QTY",
        ("INV_CUM_END" - "INV_QTY")            AS "INV_CUM_START",
        "INV_CUM_END"
    FROM inv
), req AS (
    SELECT
        pl."PICKLIST_ID",
        pl."LINE_NO",
        pl."PRODUCT_ID",
        pl."QTY"                               AS "PICK_QTY",
        TO_TIMESTAMP(l."CREATED")              AS "PICK_TIME",
        SUM(pl."QTY") OVER (
            PARTITION BY pl."PRODUCT_ID"
            ORDER BY TO_TIMESTAMP(l."CREATED"), pl."LINE_NO"
        )                                      AS "PICK_CUM_END"
    FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
    JOIN ORACLE_SQL.ORACLE_SQL."PICKING_LIST" l
      ON pl."PICKLIST_ID" = l."ID"
), req_r AS (
    SELECT
        "PICKLIST_ID",
        "LINE_NO",
        "PRODUCT_ID",
        "PICK_QTY",
        ("PICK_CUM_END" - "PICK_QTY")          AS "PICK_CUM_START",
        "PICK_CUM_END"
    FROM req
), overlap AS (
    SELECT
        r."PRODUCT_ID",
        i."INV_ID",
        GREATEST(
            0,
            LEAST(i."INV_CUM_END",  r."PICK_CUM_END")
          - GREATEST(i."INV_CUM_START", r."PICK_CUM_START")
        )                                       AS "PICKED_QTY",
        i."INV_QTY"
    FROM req_r r
    JOIN inv_r i
      ON i."PRODUCT_ID" = r."PRODUCT_ID"
     AND i."INV_CUM_START" < r."PICK_CUM_END"
     AND r."PICK_CUM_START" < i."INV_CUM_END"
), lot_pct AS (
    SELECT
        "PRODUCT_ID",
        CASE WHEN "INV_QTY" = 0 THEN 0
             ELSE "PICKED_QTY" / "INV_QTY" END AS "PICK_PCT"
    FROM overlap
)
SELECT
    pr."NAME"                     AS "PRODUCT_NAME",
    AVG(lp."PICK_PCT")            AS "AVG_PICK_PERCENTAGE"
FROM lot_pct lp
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" pr
  ON lp."PRODUCT_ID" = pr."ID"
GROUP BY pr."NAME"
ORDER BY pr."NAME";
```
