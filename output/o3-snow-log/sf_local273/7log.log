         "line_no"
LIMIT 20;
```

```sql
--Description: ⑤  Compare what was ordered versus what was picked for the same order / product.  
SELECT o."order_id",
       o."product_id",
       o."qty"              AS "ordered_qty",
       l."qty"              AS "picked_qty"
FROM ORACLE_SQL.ORACLE_SQL."ORDERLINES"    o
JOIN ORACLE_SQL.ORACLE_SQL."PICKING_LINE"  l
  ON l."order_id"   = o."order_id"
 AND l."product_id" = o."product_id"
ORDER BY o."order_id",
         o."product_id"
LIMIT 20;
```

```sql
--Description: ⑥  Calculate pick-percentage by order line (picked ÷ ordered).  
SELECT o."order_id",
       o."product_id",
       ROUND( l."qty" / NULLIF(o."qty",0), 4 ) AS "pick_pct"
FROM ORACLE_SQL.ORACLE_SQL."ORDERLINES"    o
JOIN ORACLE_SQL.ORACLE_SQL."PICKING_LINE"  l
  ON l."order_id"   = o."order_id"
 AND l."product_id" = o."product_id"
WHERE o."qty" > 0
LIMIT 20;
```

```sql
--Description: ⑦  Build the FIFO sequence for ONE product (change 6520 if needed) to validate the overlap logic.  
WITH inv AS (
  SELECT i."id",
         p."purchased",
         i."qty",
         ROW_NUMBER() OVER (ORDER BY p."purchased", i."qty") AS "seq"
  FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
  JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"  p
    ON p."id" = i."purchase_id"
  WHERE i."product_id" = 6520
)
SELECT *
FROM inv
ORDER BY "seq"
LIMIT 20;
```

```sql
--Description: ⑧  Allocate every pick-line quantity across inventory lots FIFO-style and show the resulting overlap.  
WITH inv AS (
  SELECT i."id"                        AS "inv_id",
         i."product_id",
         p."purchased",
         i."qty"                       AS "inv_qty",
         ROW_NUMBER() OVER (PARTITION BY i."product_id"
                            ORDER BY p."purchased", i."qty") AS "inv_seq"
  FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
  JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"  p
    ON p."id" = i."purchase_id"
),
pl AS (
  SELECT "id"  AS "pl_id",
         "product_id",
         "qty" AS "pick_qty"
  FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
),
alloc AS (
  SELECT pl."pl_id",
         pl."product_id",
         pl."pick_qty",
         inv."inv_id",
         inv."purchased",
         inv."inv_qty",
         GREATEST(
           LEAST(
             inv."inv_qty",
             pl."pick_qty"
               - COALESCE(
                   SUM(inv."inv_qty") OVER (
                     PARTITION BY pl."pl_id"
                     ORDER BY inv."inv_seq"
                     ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
                   ), 0)
           ), 0
         )                             AS "overlap_qty"
  FROM pl
  JOIN inv
    ON inv."product_id" = pl."product_id"
)
SELECT *
FROM alloc
WHERE "overlap_qty" > 0
ORDER BY "pl_id",
         "inv_seq"
LIMIT 20;
```

```sql
--Description: ⑨  From the allocation above, derive the pick-percentage for every pick-line (picked / requested).  
WITH alloc AS ( /* Use query ⑧ up to the SELECT in the CTE */ )
SELECT "product_id",
       "pl_id",
       SUM("overlap_qty")     AS "picked",
       MAX("pick_qty")        AS "requested",
       ROUND( SUM("overlap_qty") / NULLIF( MAX("pick_qty"),0 ), 4 ) AS "pick_pct"
FROM alloc
GROUP BY "product_id",
         "pl_id"
ORDER BY "product_id",
         "pl_id"
LIMIT 20;
```

```sql
--Description: ⑩  FINAL QUERY – compute the average FIFO pick-percentage for every product name.  
WITH "INV" AS (
  SELECT i."id"                     AS "inventory_id",
         i."product_id",
         p."purchased",
         i."qty"                    AS "inv_qty",
         ROW_NUMBER() OVER (PARTITION BY i."product_id"
                            ORDER BY p."purchased", i."qty") AS "inv_seq"
  FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
  JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"  p
    ON p."id" = i."purchase_id"
),
"PL" AS (
  SELECT "id"          AS "pickline_id",
         "product_id",
         "qty"         AS "pick_qty"
  FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
),
"ALLOC" AS (
  SELECT pl."product_id",
         pl."pickline_id",
         pl."pick_qty",
         inv."inventory_id",
         inv."purchased",
         inv."inv_qty",
         GREATEST(
           LEAST(
             inv."inv_qty",
             pl."pick_qty"
               - COALESCE(
                   SUM(inv."inv_qty") OVER (
                     PARTITION BY pl."pickline_id"
                     ORDER BY inv."inv_seq"
                     ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
                   ), 0)
           ), 0
         ) AS "overlap_qty"
  FROM "PL"  pl
  JOIN "INV" inv
    ON inv."product_id" = pl."product_id"
),
"PCT" AS (
  SELECT "product_id",
         CASE WHEN "pick_qty" > 0
              THEN SUM("overlap_qty") / MAX("pick_qty")
         END AS "pick_pct"
  FROM "ALLOC"
  GROUP BY "product_id", "pickline_id", "pick_qty"
)
SELECT pr."name"                         AS "product_name",
       ROUND( AVG("pick_pct"), 4 )       AS "avg_pick_percentage"
FROM "PCT"  pct
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" pr
  ON pr."id" = pct."product_id"
GROUP BY pr."name"
ORDER BY pr."name";
```
