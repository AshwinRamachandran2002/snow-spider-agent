```sql
--Description: ④  Examine the picking lines (what has to be picked for every order / line).  
SELECT "picklist_id",
       "line_no",
       "order_id",
       "product_id",
       "qty"
FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
