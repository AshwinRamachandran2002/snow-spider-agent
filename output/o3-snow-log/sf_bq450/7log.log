```sql
--Description: Sample of contract creation traces (trace_type = 'create') to identify creator addresses & bytecode size hints.  
SELECT
  "from_address"     AS "creator",
  "to_address"       AS "new_contract_address",
  BYTE_LENGTH("output") AS "bytecode_size",
  "block_timestamp"
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRACES"
WHERE "block_timestamp" < 1483228800000000
  AND "trace_type" = 'create'
LIMIT 20;
```

```sql
--Description: Fetch bytecode length for contracts that were created before 2017 (from CONTRACTS table).  
SELECT
  "address"                         AS "contract_address",
  BYTE_LENGTH("bytecode")           AS "bytecode_size",
  "block_number",
  "block_timestamp"
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."CONTRACTS"
WHERE "block_timestamp" < 1483228800000000
LIMIT 20;
```

```sql
--Description: Combine incoming vs. outgoing trace counts & counterparties for a quick sanity-check on aggregation logic.  
SELECT
  a."address",
  SUM(CASE WHEN a."dir" = 'in'  THEN 1 ELSE 0 END) AS "in_trace_count",
  SUM(CASE WHEN a."dir" = 'out' THEN 1 ELSE 0 END) AS "out_trace_count",
  COUNT(DISTINCT CASE WHEN a."dir" = 'in'  THEN a."counterparty" END) AS "in_addr_count",
  COUNT(DISTINCT CASE WHEN a."dir" = 'out' THEN a."counterparty" END) AS "out_addr_count"
FROM (
  SELECT "to_address"   AS "address", 'in'  AS "dir", "from_address" AS "counterparty"
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRACES"
  WHERE "block_timestamp" < 1483228800000000
    AND "trace_type" = 'call'
    AND "status" = 1
  UNION ALL
  SELECT "from_address" AS "address", 'out' AS "dir", "to_address"   AS "counterparty"
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRACES"
  WHERE "block_timestamp" < 1483228800000000
    AND "trace_type" = 'call'
    AND "status" = 1
) a
GROUP BY a."address"
LIMIT 20;
```
