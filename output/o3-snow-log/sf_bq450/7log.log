```sql
--Description: Find the temporal coverage of the TRANSACTIONS table—return the earliest and latest
--             block timestamps plus the total row count.  This confirms why a strict “before-2017”
--             filter produced no rows and shows the real lower bound for subsequent analyses.
SELECT
  MIN("block_timestamp") AS "earliest_block_ts",
  MAX("block_timestamp") AS "latest_block_ts",
  COUNT(*)               AS "total_txn_rows"
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRANSACTIONS";
```
