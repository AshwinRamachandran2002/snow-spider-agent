  COUNT(*)         AS "out_txn",
  SUM("value")     AS "total_out_value_wei",
  AVG("receipt_gas_used") AS "avg_gas_used"
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TRANSACTIONS"
