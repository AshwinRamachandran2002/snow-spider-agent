```sql
--Description: Peek at ERC-20 token transfer logs prior to 2017 to see token, sender, receiver and value fields.  
SELECT
  "block_timestamp",
  "token_address",
  "from_address",
  "to_address",
  "value",
  "transaction_hash"
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
WHERE "block_timestamp" < 1483228800000000
LIMIT 20;
```

```sql
--Description: Count incoming & outgoing ERC-20 token transfers for the first 20 addresses (pre-2017).  
SELECT
  "address_side"          AS "direction",
  "addr"                  AS "address",
  COUNT(*)                AS "token_txn_cnt"
FROM (
  SELECT "to_address"  AS "addr", 'in'  AS "address_side"
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
  WHERE "block_timestamp" < 1483228800000000
  UNION ALL
  SELECT "from_address" AS "addr", 'out' AS "address_side"
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
  WHERE "block_timestamp" < 1483228800000000
) t
GROUP BY "address_side", "addr"
LIMIT 20;
```

```sql
