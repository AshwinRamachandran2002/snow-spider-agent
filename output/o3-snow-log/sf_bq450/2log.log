```sql
--Description: Sample 20 distinct “from” and “to” addresses that appear in transactions
--             prior to 1-Jan-2017 (block_timestamp is stored in micro-seconds).
SELECT DISTINCT
       "from_address",
       "to_address",
       "block_timestamp",
       "value"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
WHERE  "block_timestamp" < 1483228800000000          -- 01-Jan-2017 00:00:00 UTC
LIMIT  20;
```

```sql
--Description: Inspect 20 traces (excluding delegatecall / callcode / staticcall)
--             prior to 2017 to understand call directions and gas usage.
SELECT
       "from_address",
       "to_address",
       "trace_type",
       "call_type",
       "value",
       "gas",
       "gas_used",
       "status",
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE  "block_timestamp" < 1483228800000000
  AND  ( "call_type" IS NULL
         OR "call_type" NOT IN ('delegatecall','callcode','staticcall') )
LIMIT  20;
```

```sql
--Description: Look at reward-type traces (mining & uncle rewards) before 2017.
SELECT
       "to_address"      AS "beneficiary",
       "value"           AS "reward_wei",
       "reward_type",
       "block_number",
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRACES
WHERE  "trace_type" = 'reward'
  AND  "block_timestamp" < 1483228800000000
LIMIT  20;
```

```sql
--Description: Show token transfers executed before 2017 to identify early
--             ERC-20 activity (addresses, token contracts, values).
SELECT
       "from_address",
       "to_address",
       "token_address",
       "value",
       "transaction_hash",
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS
WHERE  "block_timestamp" < 1483228800000000
LIMIT  20;
```

```sql
--Description: Examine contracts that were created before 2017, together with
--             their bytecode length (potential proxy for contract complexity).
SELECT
       "address"                         AS "contract_address",
       LENGTH("bytecode")                AS "bytecode_size",
       "block_number",
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.CONTRACTS
WHERE  "block_timestamp" < 1483228800000000
LIMIT  20;
```

```sql
--Description: Retrieve failed transactions (receipt_status = 0) before 2017 to
--             analyse failure patterns and associated gas usage.
SELECT
       "hash",
       "from_address",
       "to_address",
       "gas",
       "receipt_gas_used",
       "receipt_status",
       "block_timestamp"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
WHERE  "block_timestamp" < 1483228800000000
  AND  "receipt_status" = 0
LIMIT  20;
```

```sql
--Description: Quick view of hourly distribution – pull the UNIX epoch seconds
--             (micro-seconds ÷ 1 000 000) to facilitate later hour extraction.
SELECT
       "hash",
       ("block_timestamp" / 1000000)    AS "epoch_seconds"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TRANSACTIONS
WHERE  "block_timestamp" < 1483228800000000
LIMIT  20;
```

```sql
