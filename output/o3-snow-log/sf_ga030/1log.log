/*-------------------------------------------------
  2.  First time each user ever started a session
--------------------------------------------------*/
"FIRST_SESSIONS" AS (
  SELECT 
        "user_pseudo_id",
        MIN("event_date") AS "first_session_date"
  FROM "ALL_SESSIONS"
  GROUP BY "user_pseudo_id"
),

/*-------------------------------------------------
  3.  Assign Monday-based cohort (week 0)  
      Limit cohorts to those whose 4-week window is 
      fully covered by our data (≤ 3-Sep-2018).
--------------------------------------------------*/
"COHORTED_USERS" AS (
  SELECT
        "user_pseudo_id",
        DATEADD('day',1,DATE_TRUNC('week',"first_session_date")) AS "cohort_monday"
  FROM  "FIRST_SESSIONS"
  WHERE "first_session_date" >= '2018-07-02'
    AND DATEADD('day',1,DATE_TRUNC('week',"first_session_date")) <= '2018-09-03'
),

/*-------------------------------------------------
  4.  4-week retention calculation
--------------------------------------------------*/
"RETENTION" AS (
  SELECT
        cu."cohort_monday",
        COUNT(DISTINCT cu."user_pseudo_id")                                         AS "cohort_size",
        COUNT(DISTINCT CASE 
              WHEN s."event_date" BETWEEN DATEADD('day',21,cu."cohort_monday")
                                   AND     DATEADD('day',27,cu."cohort_monday")
              THEN cu."user_pseudo_id" END)                                         AS "retained_week4"
  FROM        "COHORTED_USERS" cu
  LEFT JOIN   "ALL_SESSIONS"   s
         ON   s."user_pseudo_id" = cu."user_pseudo_id"
  GROUP BY    cu."cohort_monday"
)

/*-------------------------------------------------
  5.  Return the cohort (Monday date) with the
      highest week-4 retention
--------------------------------------------------*/
SELECT TO_CHAR("cohort_monday",'YYYY-MM-DD') AS "YYYY-MM-DD"
FROM   "RETENTION"
ORDER  BY ( "retained_week4"::FLOAT / NULLIF("cohort_size",0) ) DESC NULLS LAST
LIMIT  1;
