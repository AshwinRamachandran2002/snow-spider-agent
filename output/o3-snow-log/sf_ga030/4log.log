), 

first_sessions AS (
    SELECT uid , MIN(evt_dt) AS first_session_date
      FROM union_events
     WHERE event_name = 'session_start'
       AND evt_dt >= '2018-07-02'
     GROUP BY uid
),

cohorts AS (
    SELECT uid ,
           DATE_TRUNC('week' , first_session_date) AS cohort_monday
      FROM first_sessions
),

retained AS (
    SELECT DISTINCT c.uid , c.cohort_monday
      FROM cohorts c
      JOIN union_events e
        ON e.uid = c.uid
       AND e.evt_dt BETWEEN DATEADD('day',21,c.cohort_monday)
                        AND DATEADD('day',27,c.cohort_monday)
),

cohort_totals AS (
    SELECT cohort_monday , COUNT(DISTINCT uid) AS total_users
      FROM cohorts
     GROUP BY cohort_monday
),

cohort_retained AS (
    SELECT cohort_monday , COUNT(DISTINCT uid) AS retained_users
      FROM retained
     GROUP BY cohort_monday
),

rates AS (
    SELECT t.cohort_monday ,
           r.retained_users ,
           t.total_users ,
           r.retained_users * 1.0 / t.total_users AS retention_rate
      FROM cohort_totals t
      LEFT JOIN cohort_retained r
        ON t.cohort_monday = r.cohort_monday
)

SELECT TO_CHAR(cohort_monday,'YYYY-MM-DD') AS "cohort_monday_with_highest_4th_week_retention"
  FROM rates
 ORDER BY retention_rate DESC NULLS LAST , cohort_monday
 LIMIT 1;
```
