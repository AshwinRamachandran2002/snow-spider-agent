```sql
SELECT
    TO_CHAR(
        TO_DATE("year" || '-' || LPAD("mo", 2, '0') || '-' || LPAD("da", 2, '0'), 'YYYY-MM-DD'),
        'YYYY-MM-DD'
    ) AS "date"
FROM
    NOAA_GSOD.NOAA_GSOD.GSOD2009
WHERE
    "stn" = '723758'
    AND "year" = '2009'
    AND "mo" = '10'
    AND "temp" <> 9999.9
ORDER BY
    "temp" DESC NULLS LAST
LIMIT 3;
```
