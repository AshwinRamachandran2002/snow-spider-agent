/* -----------------------------------------------------------------
   CT series quality report fulfilling geometry & metadata rules
   ----------------------------------------------------------------- */
WITH base AS (   -- 1. pre-filtered CT instances
    SELECT
        A."SeriesInstanceUID",
        A."SeriesNumber",
        A."StudyInstanceUID",
        A."PatientID",
        A."SOPInstanceUID",
        A."ImageOrientationPatient",   -- VARIANT
        A."ImagePositionPatient",      -- VARIANT
        A."PixelSpacing",
        A."Rows",
        A."Columns",
        A."SliceThickness",
        A."Exposure",
        A."instance_size",
        A."TransferSyntaxUID",
        P."ImageType"
    FROM IDC.IDC_V17."DICOM_ALL"  A
    LEFT JOIN IDC.IDC_V17."DICOM_PIVOT" P
           ON A."SOPInstanceUID" = P."SOPInstanceUID"
    WHERE A."Modality"          = 'CT'                -- keep CT only
      AND A."collection_name"  <> 'NLST'              -- exclude NLST
      AND A."TransferSyntaxUID" NOT IN                -- skip JPEG compressed
          ('1.2.840.10008.1.2.4.70',
           '1.2.840.10008.1.2.4.51')
      AND (P."ImageType" IS NULL OR                   -- skip localizers
           P."ImageType" NOT ILIKE '%LOCALIZER%')
),

inst AS (        -- 2. per-instance derived values
    SELECT
        b.*,
        /* orientation components (row = R, column = C) */
        TRY_TO_NUMBER(b."ImageOrientationPatient"[0]) AS R1,
        TRY_TO_NUMBER(b."ImageOrientationPatient"[1]) AS R2,
        TRY_TO_NUMBER(b."ImageOrientationPatient"[3]) AS C1,
        TRY_TO_NUMBER(b."ImageOrientationPatient"[4]) AS C2,
        /* z-coordinate of image position */
        TRY_TO_NUMBER(b."ImagePositionPatient"[2])    AS Z_POS,
        /* |dot( cross(R,C) , [0,0,1] )|  == | R1*C2 – R2*C1 | */
        ABS(
              TRY_TO_NUMBER(b."ImageOrientationPatient"[0])
            * TRY_TO_NUMBER(b."ImageOrientationPatient"[4])
            - TRY_TO_NUMBER(b."ImageOrientationPatient"[1])
            * TRY_TO_NUMBER(b."ImageOrientationPatient"[3])
        )                                             AS DOT,
        /* stringified attributes for equality checks */
        TO_VARCHAR(b."ImageOrientationPatient")       AS ORIENT_STR,
        TO_VARCHAR(b."PixelSpacing")                  AS PX_STR,
        TO_VARCHAR(b."ImagePositionPatient")          AS POS_STR,
        TO_VARCHAR(b."ImagePositionPatient"[0])       AS POS_X,
        TO_VARCHAR(b."ImagePositionPatient"[1])       AS POS_Y,
        TRY_TO_NUMBER(NULLIF(b."Exposure",       '')) AS EXP_FLT,
        TRY_TO_NUMBER(NULLIF(b."SliceThickness", '')) AS THICK_FLT
    FROM base b
),

inst_with_dz AS (   -- 3. inter-slice spacing Δz
    SELECT
        i.*,
        ABS( i.Z_POS
           - LAG(i.Z_POS) OVER (PARTITION BY i."SeriesInstanceUID"
                                ORDER BY i.Z_POS) )  AS DZ
    FROM inst i
),

series_metrics AS ( -- 4. aggregate & geometry validation
    SELECT
        "SeriesInstanceUID",
        MAX("SeriesNumber")                   AS "SeriesNumber",
        MAX("StudyInstanceUID")               AS "StudyInstanceUID",
        MAX("PatientID")                      AS "PatientID",
        COUNT(*)                              AS num_instances,
        COUNT(DISTINCT POS_STR)               AS distinct_positions,
        COUNT(DISTINCT ORIENT_STR)            AS distinct_orient,
        COUNT(DISTINCT PX_STR)                AS distinct_px,
        COUNT(DISTINCT POS_X)                 AS distinct_pos_x,
        COUNT(DISTINCT POS_Y)                 AS distinct_pos_y,
        COUNT(DISTINCT "Rows")                AS distinct_rows,
        COUNT(DISTINCT "Columns")             AS distinct_cols,
        MIN(DOT)                              AS min_dot,
        MAX(DOT)                              AS max_dot,
        COUNT(DISTINCT THICK_FLT)             AS distinct_thickness,
        MIN(DZ)                               AS min_dz,
        MAX(DZ)                               AS max_dz,
        SUM(instance_size)                    AS total_bytes,
        COUNT(DISTINCT EXP_FLT)               AS distinct_exposure,
        MIN(EXP_FLT)                          AS min_exposure,
        MAX(EXP_FLT)                          AS max_exposure
    FROM inst_with_dz
    GROUP BY "SeriesInstanceUID"
    HAVING
          num_instances    = distinct_positions   -- equal SOP & position counts
      AND distinct_orient  = 1                    -- single orientation
      AND distinct_px      = 1                    -- identical pixel spacing
      AND min_dot         >= 0.99                -- near-unity dot product
      AND distinct_pos_x   = 1                    -- constant X origin
      AND distinct_pos_y   = 1                    -- constant Y origin
      AND distinct_rows    = 1                    -- identical rows
      AND distinct_cols    = 1                    -- identical cols
)

-- 5. final report ------------------------------------------------------------
SELECT
    "SeriesInstanceUID"                               AS series_uid,                     -- 1
    "SeriesNumber"                                    AS series_number,                  -- 2
    "StudyInstanceUID"                                AS study_uid,                      -- 3
    "PatientID"                                       AS patient_id,                     -- 4
    max_dot                                           AS max_dot_product,                -- 5
    num_instances                                     AS sop_instance_count,             -- 6
    distinct_thickness                                AS distinct_slice_thickness_cnt,   -- 7
    max_dz                                            AS max_slice_interval,             -- 8
    min_dz                                            AS min_slice_interval,             -- 8
    (max_dz - min_dz)                                 AS slice_interval_tolerance,       -- 9
    distinct_exposure                                 AS distinct_exposure_cnt,          -- 10
    max_exposure                                      AS max_exposure,                   -- 11
    min_exposure                                      AS min_exposure,                   -- 11
    (max_exposure - min_exposure)                     AS exposure_range,                 -- 12
    ROUND(total_bytes / POWER(1024, 2), 4)            AS series_size_mib                 -- 13
FROM series_metrics
ORDER BY
    slice_interval_tolerance DESC NULLS LAST,
    exposure_range           DESC NULLS LAST,
    series_uid               DESC NULLS LAST;
