```sql
--Description: Preview the distribution of small‐molecule “heavy_atoms” values (10-20) 
--             to see how many compounds fall in the required size window.
SELECT DISTINCT
       "heavy_atoms"::INTEGER       AS "heavy_atoms",
       COUNT(*) OVER (PARTITION BY "heavy_atoms") AS "molecule_count"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"
WHERE  "heavy_atoms" IS NOT NULL
  AND  "heavy_atoms"::INTEGER BETWEEN 10 AND 20
LIMIT 20;
