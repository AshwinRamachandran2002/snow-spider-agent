```sql
--Description (thinking process):
-- Goal: create a deterministic UUID for the pair of activity IDs (10927303, 10947337)
--        using Snowflake-native functions only.
-- Steps
--   1. “pair” CTE: store the two IDs.
--   2. “json_src” CTE: manually assemble a minimal JSON string
--        {"A":"10927303","B":"10947337"}  — order & casing fixed for stability.
--   3. “digest” CTE: apply MD5() → 32-char lowercase hex (Snowflake’s default).
--   4. Final SELECT: slice that 32-char hex into the canonical UUID
--        8-4-4-4-12 pattern via SUBSTR + CONCAT.
WITH pair AS (
    SELECT '10927303'::STRING AS act_a,
           '10947337'::STRING AS act_b
),
json_src AS (
    SELECT CONCAT('{"A":"', act_a, '","B":"', act_b, '"}') AS json_txt
    FROM   pair
),
digest AS (
    SELECT LOWER(MD5(json_txt)) AS hex32           -- 32-char MD5 hex
    FROM   json_src
)
SELECT CONCAT(
         SUBSTR(hex32,  1,  8), '-', 
         SUBSTR(hex32,  9,  4), '-', 
         SUBSTR(hex32, 13,  4), '-', 
         SUBSTR(hex32, 17,  4), '-', 
         SUBSTR(hex32, 21) )      AS "mmp_delta_uuid"
FROM   digest;
