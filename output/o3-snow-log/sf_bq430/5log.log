Query:
--Description: List assays / standard types that have fewer than 5 qualifying 
--             small-molecule measurements (helps meet the “<5 activities” rule).
WITH qual AS (
  SELECT a."assay_id",
         a."standard_type",
         a."molregno"
  FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"       a
  JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
         ON a."molregno" = cp."molregno"
  WHERE  cp."heavy_atoms"::INTEGER BETWEEN 10 AND 15
    AND  a."pchembl_value"::FLOAT > 10
    AND  a."standard_value" IS NOT NULL
)
SELECT "assay_id",
       "standard_type",
       COUNT(DISTINCT "molregno") AS "molecule_cnt"
FROM   qual
GROUP  BY "assay_id","standard_type"
HAVING COUNT(DISTINCT "molregno") < 5
LIMIT 20;
