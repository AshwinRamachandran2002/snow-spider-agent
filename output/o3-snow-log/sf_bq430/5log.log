```sql
--Description: Retrieve activities (table ACTIVITIES_27) for compounds that have
--             10-15 heavy atoms, non-null standard values and pChEMBL > 10.
SELECT a."activity_id",
       a."assay_id",
       a."molregno",
       a."standard_type",
       a."standard_relation",
       a."standard_value",
       a."pchembl_value",
       cp."heavy_atoms"::INTEGER AS "heavy_atoms"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"       a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
       ON a."molregno" = cp."molregno"
WHERE  cp."heavy_atoms" IS NOT NULL
  AND  cp."heavy_atoms"::INTEGER BETWEEN 10 AND 15
  AND  a."pchembl_value" IS NOT NULL
  AND  a."pchembl_value"::FLOAT > 10
  AND  a."standard_value" IS NOT NULL
LIMIT 20;
```

```sql
--Description: List assays / standard types that have fewer than 5 qualifying 
--             small-molecule measurements (helps meet the “<5 activities” rule).
WITH qual AS (
  SELECT a."assay_id",
         a."standard_type",
         a."molregno"
  FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"       a
  JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
         ON a."molregno" = cp."molregno"
  WHERE  cp."heavy_atoms"::INTEGER BETWEEN 10 AND 15
    AND  a."pchembl_value"::FLOAT > 10
    AND  a."standard_value" IS NOT NULL
)
SELECT "assay_id",
       "standard_type",
       COUNT(DISTINCT "molregno") AS "molecule_cnt"
FROM   qual
GROUP  BY "assay_id","standard_type"
HAVING COUNT(DISTINCT "molregno") < 5
LIMIT 20;
```

```sql
--Description: Show activities that have fewer than 2 duplicate entries per 
--             molecule-assay combination (using the “potential_duplicate” flag).
SELECT a."activity_id",
       a."assay_id",
       a."molregno",
       a."standard_value",
       a."standard_relation",
       a."standard_type",
       a."pchembl_value",
       a."potential_duplicate"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a
WHERE  a."activity_id" IN (
          SELECT "activity_id"
          FROM (
              SELECT a2."activity_id",
                     COUNT(*) OVER (PARTITION BY a2."assay_id", a2."molregno") AS dup_cnt
              FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a2
          ) q
          WHERE dup_cnt < 2
      )
LIMIT 20;
```

```sql
--Description: Attach canonical SMILES to qualifying activities to obtain the 
--             structure information needed for UUID generation later.
SELECT a."activity_id",
       cs."canonical_smiles",
       cp."heavy_atoms"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"        a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  cs
       ON a."molregno" = cs."molregno"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp
       ON a."molregno" = cp."molregno"
WHERE  cp."heavy_atoms"::INTEGER BETWEEN 10 AND 15
  AND  a."pchembl_value"::FLOAT > 10
LIMIT 20;
```

```sql
--Description: Build all distinct molecule pairs in one small assay example 
--             (assay 826080, standard_type = 'Ki') that satisfy the rules.
WITH base AS (
  SELECT a."activity_id",
         a."assay_id",
         a."molregno",
         a."standard_value"::FLOAT AS "sv",
         a."standard_relation",
         cp."heavy_atoms"::INTEGER AS "ha",
         cs."canonical_smiles"
  FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"        a
  JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp
         ON a."molregno" = cp."molregno"
  JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  cs
         ON a."molregno" = cs."molregno"
  WHERE  cp."heavy_atoms" BETWEEN 10 AND 15
    AND  a."pchembl_value"::FLOAT > 10
    AND  a."standard_value" IS NOT NULL
    AND  a."standard_type" = 'Ki'
    AND  a."assay_id" = '826080'
)
SELECT b1."activity_id" AS "activity_a",
       b2."activity_id" AS "activity_b",
       b1."sv"          AS "value_a",
       b2."sv"          AS "value_b",
       GREATEST(b1."ha", b2."ha") AS "max_heavy_atoms"
FROM   base b1
JOIN   base b2
       ON b1."activity_id" < b2."activity_id"
LIMIT 20;
```

```sql
--Description: Classify the change direction (‘increase’, ‘decrease’, ‘no-change’) 
--             for each pair in the same assay and standard_type.
WITH base AS (
  SELECT a."activity_id",
         a."assay_id",
         a."standard_relation",
         a."standard_value"::FLOAT AS sv
  FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a
  WHERE  a."assay_id" = '826080'
    AND  a."standard_type" = 'Ki'
    AND  a."standard_value" IS NOT NULL
)
SELECT b1."activity_id" AS "activity_a",
       b2."activity_id" AS "activity_b",
       CASE
         WHEN b1."sv" > b2."sv" THEN 'decrease'
         WHEN b1."sv" < b2."sv" THEN 'increase'
         ELSE 'no-change'
       END AS "change_class"
FROM   base b1
JOIN   base b2
       ON b1."activity_id" < b2."activity_id"
LIMIT 20;
```

```sql
--Description: Generate a deterministic UUID (mmp_delta_uuid) for a sample pair 
--             by MD5 hashing the JSON string of their activity IDs.
WITH pairs AS (
  SELECT '10927303' AS act_a, '10947337' AS act_b
)
SELECT CONCAT_WS('-', 
                SUBSTR(hex_md5,1,8),
                SUBSTR(hex_md5,9,4),
                SUBSTR(hex_md5,13,4),
                SUBSTR(hex_md5,17,4),
                SUBSTR(hex_md5,21)
       ) AS "mmp_delta_uuid"
FROM (
  SELECT TO_HEX(MD5(TO_JSON_STRING(OBJECT_CONSTRUCT('A',act_a,'B',act_b)))) AS hex_md5
  FROM pairs
);
```

```sql
--Description: Show the highest document ID among the eligible activities in the 
--             chosen assay (stand-in for the “latest publication” concept).
WITH base AS (
  SELECT a."activity_id",
         a."doc_id"::INTEGER AS doc_id
  FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a
  WHERE  a."assay_id" = '826080'
    AND  a."standard_type" = 'Ki'
    AND  a."standard_value" IS NOT NULL
)
SELECT MAX(doc_id) AS "latest_doc_id"
FROM   base;
```

```sql
--Description: Final consolidated query (example subset) returning all requested 
--             fields for qualifying activity pairs, including UUID generation.
WITH base AS (
  SELECT a."activity_id",
         a."assay_id",
         a."standard_value"::FLOAT AS sv,
         a."standard_relation",
         a."doc_id"::INTEGER AS doc_id,
         cp."heavy_atoms"::INTEGER AS ha,
         cs."canonical_smiles"
  FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"        a
  JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp
         ON a."molregno" = cp."molregno"
  JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  cs
         ON a."molregno" = cs."molregno"
  WHERE  cp."heavy_atoms" BETWEEN 10 AND 15
    AND  a."pchembl_value"::FLOAT > 10
    AND  a."standard_value" IS NOT NULL
    AND  a."standard_type" = 'Ki'
    AND  a."assay_id" = '826080'
)
SELECT b1."activity_id"          AS "activity_a",
       b2."activity_id"          AS "activity_b",
       b1."canonical_smiles"     AS "smiles_a",
       b2."canonical_smiles"     AS "smiles_b",
       GREATEST(b1.ha, b2.ha)    AS "max_heavy_atoms",
       CASE WHEN b1.sv > b2.sv THEN 'decrease'
            WHEN b1.sv < b2.sv THEN 'increase'
            ELSE 'no-change'
       END                       AS "change_class",
       GREATEST(b1.doc_id, b2.doc_id) AS "highest_doc_id",
       TO_HEX(MD5(TO_JSON_STRING(OBJECT_CONSTRUCT('A', b1."activity_id", 'B', b2."activity_id")))) AS "mmp_delta_uuid"
FROM   base b1
JOIN   base b2
       ON b1."activity_id" < b2."activity_id"
LIMIT 20;
```
