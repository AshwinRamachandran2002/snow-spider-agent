```sql
/* ---------------------------------------------------------------
   Task :  Build every unordered pair of DIFFERENT molecules that
           were measured in the same ASSAY + STANDARD_TYPE and
           satisfy all of the following on EACH single activity:

           • 10–15 heavy atoms
           • pChEMBL > 10
           • non-NULL standard_value, relation ‘=’
           • < 2 duplicate rows for the same (assay,molregno)
           • the chosen assay contains < 5 such qualifying rows

           For every qualifying pair return
           – activity_id_A , activity_id_B
           – assay_id , standard_type
           – change_class  (increase / decrease / no-change)
           – max_heavy_atoms  (max of both partners)
           – latest_publication_date  (see doc-date algorithm)
           – highest_doc_id           (max of both partners)
           – uuid_from_activities     (MD5 of JSON[actA,actB])
           – uuid_from_smiles         (MD5 of JSON[smilesA,smilesB])
 ---------------------------------------------------------------- */
WITH eligible AS (   ------------------------------------------------
    SELECT
        a."activity_id",
        a."assay_id",
        a."standard_type",
        a."standard_value"::FLOAT                        AS sv,
        a."standard_relation",
        a."pchembl_value"::FLOAT                         AS pchembl,
        a."molregno",
        a."doc_id"::INTEGER                              AS doc_id,
        cs."canonical_smiles",
        TO_NUMBER(cp."heavy_atoms")                      AS heavy_atoms_int,
        COUNT(*) OVER (PARTITION BY a."assay_id",a."molregno")      AS dup_cnt,
        COUNT(*) OVER (PARTITION BY a."assay_id",a."standard_type") AS assay_cnt
    FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"        a
    JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp
           ON a."molregno" = cp."molregno"
    JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  cs
           ON a."molregno" = cs."molregno"
    WHERE  cp."heavy_atoms" IS NOT NULL
      AND  TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
      AND  a."standard_value" IS NOT NULL
      AND  a."standard_relation" = '='
      AND  a."pchembl_value" IS NOT NULL
      AND  a."pchembl_value" > 10
),                                  -------------------------------
filtered AS (
    SELECT *
    FROM   eligible
    WHERE  dup_cnt  < 2        --  “fewer than 2 duplicate activities”
      AND  assay_cnt < 5       --  “fewer than 5 activities in that assay”
),
/* ----------  compute synthetic publication date for every doc_id --------- */
docs_ranked AS (
    SELECT
        d."doc_id",
        COALESCE(d."journal",'UNKNOWN')                            AS journal,
        COALESCE(d."year",1970)                                    AS yr,
        TO_NUMBER(NULLIF(d."first_page",''))                       AS first_pg,
        /* percent-rank inside (journal,year) ordered by first_page */
        PERCENT_RANK() OVER (PARTITION BY COALESCE(d."journal",'UNKNOWN'),
                                          COALESCE(d."year",1970)
                             ORDER BY TO_NUMBER(NULLIF(d."first_page",''))) AS pr
    FROM   "EBI_CHEMBL"."EBI_CHEMBL"."DOCS" d
),
doc_dates AS (
    SELECT
        doc_id,
        yr,
        /* month : floor(pr*11)+1 , day : (floor(pr*308)%28)+1 */
        COALESCE(FLOOR(pr*11)+1,1)                                   AS pub_month,
        COALESCE(MOD(FLOOR(pr*308),28)+1,1)                          AS pub_day,
        DATE_FROM_PARTS(yr,
                        COALESCE(FLOOR(pr*11)+1,1),
                        COALESCE(MOD(FLOOR(pr*308),28)+1,1))         AS pub_date
    FROM   docs_ranked
)
/* ---------------------------  make unordered pairs  ----------------------- */
SELECT
       f1."activity_id"                               AS activity_a,
       f2."activity_id"                               AS activity_b,
       f1."assay_id",
       f1."standard_type",
       /* change-class ----------------------------------------------------- */
       CASE
           WHEN f1.sv > f2.sv THEN 'decrease'
           WHEN f1.sv < f2.sv THEN 'increase'
           ELSE                         'no-change'
       END                                            AS change_class,
       /* max heavy atoms in the pair -------------------------------------- */
       GREATEST(f1.heavy_atoms_int , f2.heavy_atoms_int) AS max_heavy_atoms,
       /* latest publication date ------------------------------------------ */
       GREATEST(dd1.pub_date , dd2.pub_date)           AS latest_publication_date,
       /* highest doc_id in the pair --------------------------------------- */
       GREATEST(f1.doc_id , f2.doc_id)                 AS highest_doc_id,
       /* UUIDs ------------------------------------------------------------- */
       MD5( TO_JSON( ARRAY_CONSTRUCT(f1."activity_id", f2."activity_id") ) )
                                                     AS uuid_from_activities,
       MD5( TO_JSON( ARRAY_CONSTRUCT(f1."canonical_smiles",
                                     f2."canonical_smiles") ) )
                                                     AS uuid_from_smiles
FROM   filtered f1
JOIN   filtered f2
       ON  f1."assay_id"      = f2."assay_id"
       AND f1."standard_type" = f2."standard_type"
       AND f1."activity_id"  < f2."activity_id"      -- enforces unordered pair
       AND f1."molregno"     <> f2."molregno"        -- ensure different molecules
JOIN   doc_dates dd1  ON dd1.doc_id = f1.doc_id
JOIN   doc_dates dd2  ON dd2.doc_id = f2.doc_id;
```
