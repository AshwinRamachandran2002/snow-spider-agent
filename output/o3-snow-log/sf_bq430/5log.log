Query:
--Description: Retrieve activities (table ACTIVITIES_27) for compounds that have
--             10-15 heavy atoms, non-null standard values and pChEMBL > 10.
SELECT a."activity_id",
       a."assay_id",
       a."molregno",
       a."standard_type",
       a."standard_relation",
       a."standard_value",
       a."pchembl_value",
       cp."heavy_atoms"::INTEGER AS "heavy_atoms"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"       a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
       ON a."molregno" = cp."molregno"
WHERE  cp."heavy_atoms" IS NOT NULL
  AND  cp."heavy_atoms"::INTEGER BETWEEN 10 AND 15
  AND  a."pchembl_value" IS NOT NULL
  AND  a."pchembl_value"::FLOAT > 10
  AND  a."standard_value" IS NOT NULL
LIMIT 20;
