    FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"        a
    JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp
           ON a."molregno" = cp."molregno"
    JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  cs
           ON a."molregno" = cs."molregno"
    WHERE   cp."heavy_atoms" BETWEEN 10 AND 15
      AND   a."standard_value" IS NOT NULL
      AND   a."standard_type"  = 'Ki'
),
one_assay AS (                     -- pick one assay with at least two entries
    SELECT  "assay_id"
    FROM    base
    GROUP BY "assay_id"
    HAVING  COUNT(*) >= 2
    LIMIT 1
),
pair_rows AS (                     -- build all unordered activity pairs
    SELECT  b1."activity_id"  AS act_a,
            b2."activity_id"  AS act_b,
            b1."canonical_smiles" AS smiles_a,
            b2."canonical_smiles" AS smiles_b,
            GREATEST(b1.ha, b2.ha) AS max_ha,
            CASE WHEN b1.sv > b2.sv THEN 'decrease'
                 WHEN b1.sv < b2.sv THEN 'increase'
                 ELSE 'no-change'
            END               AS change_class,
            GREATEST(b1.doc_id, b2.doc_id) AS highest_doc_id
    FROM    base b1
    JOIN    base b2
          ON b1."activity_id" < b2."activity_id"
         AND b1."assay_id"     = b2."assay_id"
    JOIN    one_assay oa
          ON b1."assay_id"     = oa."assay_id"
)
SELECT  act_a      AS "activity_a",
        act_b      AS "activity_b",
        smiles_a   AS "smiles_a",
        smiles_b   AS "smiles_b",
        max_ha     AS "max_heavy_atoms",
        change_class,
        highest_doc_id,
        /* UUID generation: build {"A":"act_a","B":"act_b"}, MD5→hex, splice */
        CONCAT(
          SUBSTR(hex32,1,8),'-',
          SUBSTR(hex32,9,4),'-',
          SUBSTR(hex32,13,4),'-',
          SUBSTR(hex32,17,4),'-',
          SUBSTR(hex32,21)
        ) AS "mmp_delta_uuid"
FROM (
    SELECT pair_rows.*,
           /* produce 32-char lowercase hex string */
           LOWER(ENCODE(MD5(CONCAT('{"A":"', act_a, '","B":"', act_b, '"}')), 'HEX')) AS hex32
    FROM   pair_rows
) q
LIMIT 20
