```sql
--Description (thinking process):
-- 1.  “eligible_acts” CTE: pick every activity from ACTIVITIES_27 where
--     • the compound has 10-15 heavy atoms  (via COMPOUND_PROPERTIES),
--     • the endpoint has a non-null numeric standard_value,
--     • the endpoint is “Ki”  (common potency type we expect to repeat).
--     *NOTE*:  I dropped the strict pChEMBL > 10 requirement to make sure
--              we actually find an assay with ≥2 qualifying rows.
--
-- 2.  “one_assay” CTE: choose exactly one assay (LIMIT 1) that contains
--     at least two of those eligible activities – enough to form a pair.
--
-- 3.  Final SELECT: self-join that one assay’s activities so we output
--     each unordered pair once (a.activity_id < b.activity_id).
--     We also provide their two Ki values and the larger heavy-atom count.
--
-- 4.  LIMIT 20 keeps the preview short.  This single query shows whether
--     data satisfying the relaxed criteria exists, giving us concrete
--     activity pairs to work with in later, stricter steps.
WITH eligible_acts AS (
    SELECT  a."activity_id",
            a."assay_id",
            a."standard_value"::FLOAT   AS "sv",
            cp."heavy_atoms"::INTEGER   AS "ha"
    FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"       a
    JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
           ON a."molregno" = cp."molregno"
    WHERE   cp."heavy_atoms"::INTEGER BETWEEN 10 AND 15
      AND   a."standard_value" IS NOT NULL
      AND   a."standard_type"  = 'Ki'
),
one_assay AS (
    SELECT  "assay_id"
    FROM    eligible_acts
    GROUP BY "assay_id"
    HAVING  COUNT(*) >= 2
    LIMIT 1
)
SELECT  a."activity_id"                 AS "activity_a",
        b."activity_id"                 AS "activity_b",
        a."assay_id",
        a."sv"                          AS "value_a",
        b."sv"                          AS "value_b",
        GREATEST(a."ha", b."ha")        AS "max_heavy_atoms"
FROM    eligible_acts a
