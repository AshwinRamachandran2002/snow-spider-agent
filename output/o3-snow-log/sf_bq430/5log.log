--Description (thinking process):
-- Objective: create every unordered pair of DIFFERENT molecules that were measured
--             in the SAME assay / standard_type and satisfy *all* task filters:
--   • compound size 10-15 heavy atoms
--   • pChEMBL value > 10
--   • non-null standard_value
--   • potential_duplicate = 0   (≈ “fewer than 2 duplicate activities”)
--   • the chosen assay / standard_type combination contains < 5 such activities
--
-- Steps
-- 1) eligible   – select single activities that meet the heavy-atom, pChEMBL,
--                 standard_value and duplicate flag criteria (from ACTIVITIES_27).
-- 2) small_sets – keep only (assay_id, standard_type) that appear < 5 times in
--                 the eligible set; this enforces the “< 5 activities” rule.
-- 3) base       – eligible rows that belong to those small assay/type sets.
-- 4) pair_rows  – build all unordered activity pairs within each assay/type
--                 (activity_id_A < activity_id_B), compute:
--                   • max_heavy_atoms
--                   • change_class (increase / decrease / no-change)
--                   • highest_doc_id  (latest publication proxy)
-- 5) Final SELECT adds a deterministic UUID for each pair:
--        md5(  {"A":"<act_a>","B":"<act_b>"}  )  → 32-char hex
--        then splice into UUID format 8-4-4-4-12.
-- LIMIT 20 just previews a subset.

WITH eligible AS (
    SELECT  a."activity_id",
            a."assay_id",
            a."standard_type",
            a."molregno",
            a."standard_value"::FLOAT   AS sv,
            a."pchembl_value"::FLOAT    AS pchembl,
            a."doc_id"::INTEGER         AS doc_id,
            cp."heavy_atoms"::INTEGER   AS ha,
            cs."canonical_smiles"
    FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"        a
    JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp
           ON a."molregno" = cp."molregno"
    JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  cs
           ON a."molregno" = cs."molregno"
    WHERE   cp."heavy_atoms" BETWEEN 10 AND 15
      AND   a."standard_value" IS NOT NULL
      AND   a."pchembl_value"::FLOAT > 10
      AND   COALESCE(a."potential_duplicate",'0') = '0'
),
small_sets AS (      -- assay/standard_type combos with <5 eligible rows
    SELECT  "assay_id",
            "standard_type"
    FROM    eligible
    GROUP BY "assay_id","standard_type"
    HAVING  COUNT(*) < 5
),
base AS (
    SELECT e.*
    FROM   eligible e
    JOIN   small_sets s
      ON   e."assay_id"     = s."assay_id"
     AND   e."standard_type"= s."standard_type"
),
pair_rows AS (       -- unordered pairs inside each (assay,standard_type)
    SELECT  b1."activity_id"      AS act_a,
            b2."activity_id"      AS act_b,
            b1."canonical_smiles" AS smiles_a,
            b2."canonical_smiles" AS smiles_b,
            GREATEST(b1.ha, b2.ha)            AS max_heavy_atoms,
            CASE
                 WHEN b1.sv > b2.sv THEN 'decrease'
                 WHEN b1.sv < b2.sv THEN 'increase'
                 ELSE 'no-change'
            END                               AS change_class,
            GREATEST(b1.doc_id, b2.doc_id)    AS highest_doc_id
    FROM   base b1
    JOIN   base b2
      ON   b1."activity_id" < b2."activity_id"
     AND   b1."assay_id"      = b2."assay_id"
     AND   b1."standard_type" = b2."standard_type"
)
SELECT  act_a              AS "activity_a",
        act_b              AS "activity_b",
        smiles_a           AS "smiles_a",
        smiles_b           AS "smiles_b",
        max_heavy_atoms    AS "max_heavy_atoms",
        change_class,
        highest_doc_id,
        /* build deterministic UUID from MD5 hex of {"A":act_a,"B":act_b} */
        CONCAT(
           SUBSTR(hex32,1,8),'-',
           SUBSTR(hex32,9,4),'-',
           SUBSTR(hex32,13,4),'-',
           SUBSTR(hex32,17,4),'-',
           SUBSTR(hex32,21) )      AS "mmp_delta_uuid"
FROM (
    SELECT pair_rows.*,
           LOWER(MD5(CONCAT('{"A":"', act_a, '","B":"', act_b, '"}'))) AS hex32
    FROM   pair_rows
) q
LIMIT 20;
```
