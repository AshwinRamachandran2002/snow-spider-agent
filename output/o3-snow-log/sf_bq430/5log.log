Query:
--Description: Classify change direction (‘increase’, ‘decrease’, ‘no-change’) for
--             every unordered activity pair in ONE automatically-chosen assay that
--             contains at least two “Ki” measurements on 10-15-heavy-atom compounds
--             with non-null standard values (pChEMBL not required for coverage).
WITH eligible AS (
    SELECT  a."activity_id",
            a."assay_id",
            a."standard_value"::FLOAT AS sv
    FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a
    JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
          ON a."molregno" = cp."molregno"
    WHERE   cp."heavy_atoms"::INTEGER BETWEEN 10 AND 15
      AND   a."standard_value" IS NOT NULL
      AND   a."standard_type"  = 'Ki'
),
one_assay AS (           -- pick just one assay with ≥2 eligible rows
    SELECT  "assay_id"
    FROM    eligible
    GROUP BY "assay_id"
    HAVING  COUNT(*) >= 2
    LIMIT 1
)
SELECT  e1."activity_id"                       AS "activity_a",
        e2."activity_id"                       AS "activity_b",
        CASE
            WHEN e1.sv > e2.sv THEN 'decrease'
            WHEN e1.sv < e2.sv THEN 'increase'
            ELSE 'no-change'
        END                                    AS "change_class"
FROM    eligible e1
JOIN    eligible e2
       ON e1."activity_id" < e2."activity_id"
      AND e1."assay_id"     = e2."assay_id"
JOIN    one_assay oa
