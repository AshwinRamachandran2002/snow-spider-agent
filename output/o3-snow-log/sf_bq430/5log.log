              TO_JSON_STRING(
                 OBJECT_CONSTRUCT('A', b1."activity_id",
                                  'B', b2."activity_id")
              )
            )
        )                                      AS "mmp_delta_uuid"
FROM    base b1
JOIN    base b2
       ON b1."activity_id" < b2."activity_id"
      AND b1."assay_id"    = b2."assay_id"
JOIN    one_assay oa
       ON b1."assay_id"    = oa."assay_id"
LIMIT 20;
