--Description: Consolidated query – builds all unordered activity pairs from the
--             chosen assay, supplies canonical smiles, max heavy-atom count,
--             change classification and a pair UUID for each row.
WITH base AS (
    SELECT  a."activity_id",
            a."assay_id",
            a."standard_value"::FLOAT AS sv,
            a."doc_id"::INTEGER       AS doc_id,
            cp."heavy_atoms"::INTEGER AS ha,
            cs."canonical_smiles"
    FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"        a
    JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp
           ON a."molregno" = cp."molregno"
    JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  cs
           ON a."molregno" = cs."molregno"
    WHERE   cp."heavy_atoms" BETWEEN 10 AND 15
      AND   a."standard_value" IS NOT NULL
      AND   a."standard_type"  = 'Ki'
),
one_assay AS (
    SELECT  "assay_id"
    FROM    base
    GROUP BY "assay_id"
    HAVING  COUNT(*) >= 2
    LIMIT 1
)
SELECT  b1."activity_id"                       AS "activity_a",
        b2."activity_id"                       AS "activity_b",
        b1."canonical_smiles"                  AS "smiles_a",
        b2."canonical_smiles"                  AS "smiles_b",
        GREATEST(b1.ha, b2.ha)                 AS "max_heavy_atoms",
        CASE WHEN b1.sv > b2.sv THEN 'decrease'
             WHEN b1.sv < b2.sv THEN 'increase'
             ELSE 'no-change'
        END                                    AS "change_class",
        GREATEST(b1.doc_id, b2.doc_id)         AS "highest_doc_id",
        TO_HEX(
