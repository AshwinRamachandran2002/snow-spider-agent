--Description: Return the highest document ID among all eligible “Ki” measurements
--             (10–15 heavy atoms, non-null standard_value) inside one assay that
--             has at least two such rows.  No JSON/HEX functions are used here.
WITH eligible AS (
    SELECT  a."activity_id",
            a."assay_id",
            a."doc_id"::INTEGER AS doc_id
    FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"        a
    JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp
           ON a."molregno" = cp."molregno"
    WHERE   cp."heavy_atoms"::INTEGER BETWEEN 10 AND 15
      AND   a."standard_value" IS NOT NULL
      AND   a."standard_type"  = 'Ki'
),
one_assay AS (                       -- choose a single assay with ≥2 rows
    SELECT  "assay_id"
    FROM    eligible
    GROUP BY "assay_id"
    HAVING  COUNT(*) >= 2
    LIMIT 1
)
SELECT MAX(doc_id) AS "latest_doc_id"
FROM   eligible
JOIN   one_assay oa
     ON eligible."assay_id" = oa."assay_id"
