Query:
--Description: Show activities that have fewer than 2 duplicate entries per 
--             molecule-assay combination (using the “potential_duplicate” flag).
SELECT a."activity_id",
       a."assay_id",
       a."molregno",
       a."standard_value",
       a."standard_relation",
       a."standard_type",
       a."pchembl_value",
       a."potential_duplicate"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a
WHERE  a."activity_id" IN (
          SELECT "activity_id"
          FROM (
              SELECT a2."activity_id",
                     COUNT(*) OVER (PARTITION BY a2."assay_id", a2."molregno") AS dup_cnt
              FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a2
          ) q
          WHERE dup_cnt < 2
      )
LIMIT 20;
