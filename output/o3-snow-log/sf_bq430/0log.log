Some few-shot examples after column exploration may be helpful:
Query:
--Description: Inspect very potent (pChEMBL > 10) activity rows together with
--heavy atom count (10–15) from the historical “ACTIVITIES_27” table.
SELECT  a."activity_id",
        a."assay_id",
        a."molregno",
        a."standard_type",
        a."standard_value",
        a."pchembl_value",
        TO_NUMBER(cp."heavy_atoms") AS "heavy_atoms"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"      a
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
           ON a."molregno" = cp."molregno"
WHERE   TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
  AND   a."pchembl_value" > 10
LIMIT 20;
