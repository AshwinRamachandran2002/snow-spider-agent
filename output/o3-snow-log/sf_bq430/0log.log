```sql
--Description: Inspect very potent (pChEMBL > 10) activity rows together with
--heavy atom count (10–15) from the historical “ACTIVITIES_27” table.
SELECT  a."activity_id",
        a."assay_id",
        a."molregno",
        a."standard_type",
        a."standard_value",
        a."pchembl_value",
        TO_NUMBER(cp."heavy_atoms") AS "heavy_atoms"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"      a
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
           ON a."molregno" = cp."molregno"
WHERE   TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
  AND   a."pchembl_value" > 10
LIMIT 20;
```

```sql
--Description: Same exploration on the most recent, fully–numeric table
--“ACTIVITIES_30”, again keeping only compounds with 10–15 heavy atoms.
SELECT  a."activity_id",
        a."assay_id",
        a."molregno",
        a."standard_type",
        a."standard_value",
        a."pchembl_value",
        TO_NUMBER(cp."heavy_atoms") AS "heavy_atoms"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"      a
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
           ON a."molregno" = cp."molregno"
WHERE   TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
  AND   a."pchembl_value" > 10
LIMIT 20;
```

```sql
--Description: Preview canonical SMILES for the same subset to prepare later
--UUID generation (joining with COMPOUND_STRUCTURES).
SELECT  a."activity_id",
        cs."canonical_smiles",
        cs."standard_inchi_key",
        TO_NUMBER(cp."heavy_atoms") AS "heavy_atoms",
        a."pchembl_value"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"        a
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  cs
           ON a."molregno" = cs."molregno"
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp
           ON a."molregno" = cp."molregno"
WHERE   TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
  AND   a."pchembl_value" > 10
LIMIT 20;
```

```sql
--Description: Check how many activities each (assay_id, standard_type) pair
--contains when restricted to heavy-atom window (10–15) – helps to ensure
--“fewer than 5 activities in that assay”.
SELECT  a."assay_id",
        a."standard_type",
        COUNT(*) AS "activity_count"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"      a
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
           ON a."molregno" = cp."molregno"
WHERE   TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
GROUP BY a."assay_id", a."standard_type"
HAVING  COUNT(*) < 5
LIMIT 20;
```

```sql
--Description: Verify that every selected row has fewer than two duplicates
--(potential_duplicate column) in its assay/standard_type context.
WITH filtered AS (
    SELECT a."activity_id",
           a."assay_id",
           a."standard_type",
           a."potential_duplicate"
    FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a
)
SELECT  "assay_id",
        "standard_type",
        SUM(CASE WHEN "potential_duplicate" = 1 THEN 1 ELSE 0 END) AS "dup_cnt"
FROM    filtered
GROUP BY "assay_id", "standard_type"
HAVING  SUM(CASE WHEN "potential_duplicate" = 1 THEN 1 ELSE 0 END) < 2
LIMIT 20;
```

```sql
--Description: Quickly list rows with non-null STANDARD_VALUE together with
--their RELATION to prepare change-classification (‘=’, ‘<’, ‘>’, etc.).
SELECT  "activity_id",
        "assay_id",
        "relation",
        "standard_relation",
        "standard_value",
        "standard_type"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"
WHERE   "standard_value" IS NOT NULL
  AND   "pchembl_value" > 10
LIMIT 20;
```

```sql
--Description: Collect per-document metadata needed later (doc_id and first
--page) from one of the activity tables so we can transform it into the
--synthetic publication date outside SQL.
SELECT DISTINCT
        a."doc_id",
        a."assay_id",
        a."activity_id"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
           ON a."molregno" = cp."molregno"
WHERE   TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
  AND   a."pchembl_value" > 10
LIMIT 20;
```

```sql
--Description: Look into ACTIVITY_PROPERTIES to see if concentration
--information exists for potent activity rows (same activity_id filtering).
SELECT  ap."activity_id",
        ap."standard_type",
        ap."standard_value",
        ap."standard_relation"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITY_PROPERTIES"
       ap
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a
           ON ap."activity_id" = TO_CHAR(a."activity_id")
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
           ON a."molregno" = cp."molregno"
WHERE   TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
  AND   a."pchembl_value" > 10
LIMIT 20;
```

```sql
--Description: Preview any heavy-atom counts (10–15) inside the main
--COMPOUND_PROPERTIES table to make sure values exist for smaller molecules.
SELECT  DISTINCT
        "heavy_atoms"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"
WHERE   TO_NUMBER("heavy_atoms") BETWEEN 10 AND 15
LIMIT 20;
```

```sql
--Description: As a final complex check, select two different molecules from
--the same assay & standard_type satisfying all high-potency / heavy-atom
--criteria, ready for pairwise comparison (no change classification handled
--later).
SELECT  a1."activity_id"  AS "act_id_1",
        a1."molregno"     AS "mol_1",
        a1."standard_value" AS "std_val_1",
        a1."standard_relation" AS "rel_1",
        a2."activity_id"  AS "act_id_2",
        a2."molregno"     AS "mol_2",
        a2."standard_value" AS "std_val_2",
        a2."standard_relation" AS "rel_2",
        a1."assay_id",
        a1."standard_type",
        GREATEST(TO_NUMBER(cp1."heavy_atoms"), TO_NUMBER(cp2."heavy_atoms")) AS "max_heavy_atoms"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"       a1
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"       a2
           ON a1."assay_id" = a2."assay_id"
          AND a1."standard_type" = a2."standard_type"
          AND a1."molregno" <> a2."molregno"
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp1
           ON a1."molregno" = cp1."molregno"
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp2
           ON a2."molregno" = cp2."molregno"
WHERE   TO_NUMBER(cp1."heavy_atoms") BETWEEN 10 AND 15
  AND   TO_NUMBER(cp2."heavy_atoms") BETWEEN 10 AND 15
  AND   a1."pchembl_value" > 10
  AND   a2."pchembl_value" > 10
  AND   a1."potential_duplicate" < 2
  AND   a2."potential_duplicate" < 2
QUALIFY ROW_NUMBER() OVER (PARTITION BY a1."assay_id", a1."molregno", a2."molregno") = 1
LIMIT 20;
```
