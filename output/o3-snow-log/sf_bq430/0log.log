```sql
--Description: 
-- THINKING PROCESS -----------------------------------------------------------
-- We need candidate PAIRS of activities that satisfy all task constraints: 
--   1. Both activities measured in the SAME assay_id AND SAME standard_type. 
--   2. Each activity corresponds to a DIFFERENT molecule (molregno) whose 
--      heavy-atom count is between 10-15 (via COMPOUND_PROPERTIES). 
--   3. Both activities are very potent (pChEMBL > 10), have a non-null 
--      STANDARD_VALUE and fewer than two duplicates (POTENTIAL_DUPLICATE < 2). 
--   4. Return one row per unordered pair → enforce a1.molregno < a2.molregno. 
--   5. Window function ROW_NUMBER needs an ORDER BY in Snowflake, so we order 
--      by the first activity_id; QUALIFY keeps only the first record of each 
--      pair. 
--   6. Output fields later required for change-classification & UUID creation: 
--      activity_ids, standard_values, relations, assay_id, standard_type, and 
--      the maximum heavy-atom count across the pair. 
-- ---------------------------------------------------------------------------

SELECT  a1."activity_id"                      AS "act_id_1",
        a1."molregno"                         AS "mol_1",
        a1."standard_value"                   AS "std_val_1",
        a1."standard_relation"                AS "rel_1",
        a2."activity_id"                      AS "act_id_2",
        a2."molregno"                         AS "mol_2",
        a2."standard_value"                   AS "std_val_2",
        a2."standard_relation"                AS "rel_2",
        a1."assay_id",
        a1."standard_type",
        GREATEST(TO_NUMBER(cp1."heavy_atoms"),
                 TO_NUMBER(cp2."heavy_atoms")) AS "max_heavy_atoms"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"        a1
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"        a2
           ON  a1."assay_id"      = a2."assay_id"
           AND a1."standard_type" = a2."standard_type"
           AND a1."molregno"      <> a2."molregno"
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp1
           ON a1."molregno" = cp1."molregno"
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp2
           ON a2."molregno" = cp2."molregno"
WHERE   TO_NUMBER(cp1."heavy_atoms") BETWEEN 10 AND 15
  AND   TO_NUMBER(cp2."heavy_atoms") BETWEEN 10 AND 15
  AND   a1."pchembl_value" > 10
  AND   a2."pchembl_value" > 10
  AND   a1."standard_value" IS NOT NULL
  AND   a2."standard_value" IS NOT NULL
  AND   a1."potential_duplicate" < 2
  AND   a2."potential_duplicate" < 2
  AND   a1."molregno" < a2."molregno"          -- keep one orientation only
QUALIFY ROW_NUMBER() OVER (
            PARTITION BY a1."assay_id",
                         a1."standard_type",
                         a1."molregno",
                         a2."molregno"
            ORDER BY     a1."activity_id"
        ) = 1
LIMIT 20;
