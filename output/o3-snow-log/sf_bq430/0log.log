--Description: Check how many activities each (assay_id, standard_type) pair
--contains when restricted to heavy-atom window (10–15) – helps to ensure
--“fewer than 5 activities in that assay”.
SELECT  a."assay_id",
        a."standard_type",
        COUNT(*) AS "activity_count"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"      a
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
           ON a."molregno" = cp."molregno"
WHERE   TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
GROUP BY a."assay_id", a."standard_type"
HAVING  COUNT(*) < 5
LIMIT 20;
