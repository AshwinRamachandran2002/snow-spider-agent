Query:
--Description: Verify that every selected row has fewer than two duplicates
--(potential_duplicate column) in its assay/standard_type context.
WITH filtered AS (
    SELECT a."activity_id",
           a."assay_id",
           a."standard_type",
           a."potential_duplicate"
    FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a
)
SELECT  "assay_id",
        "standard_type",
        SUM(CASE WHEN "potential_duplicate" = 1 THEN 1 ELSE 0 END) AS "dup_cnt"
FROM    filtered
GROUP BY "assay_id", "standard_type"
HAVING  SUM(CASE WHEN "potential_duplicate" = 1 THEN 1 ELSE 0 END) < 2
LIMIT 20;
