    JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a1 ON a1."activity_id" = p."act_id_A"
    JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a2 ON a2."activity_id" = p."act_id_B"
)
SELECT  c."act_id_A",
        c."act_id_B",
        GREATEST( TO_NUMBER(cp1."heavy_atoms"), TO_NUMBER(cp2."heavy_atoms") ) AS "max_heavy_atoms",
        GREATEST(c."doc_id_A", c."doc_id_B")                                   AS "highest_doc_id",
        '1970-01-01'                                                           AS "latest_pub_date",
        MD5( OBJECT_CONSTRUCT('A', c."act_id_A", 'B', c."act_id_B")::STRING )  AS "mmp_delta_uuid",
        MD5( OBJECT_CONSTRUCT('A', cs1."canonical_smiles",
                             'B', cs2."canonical_smiles")::STRING )           AS "mmp_smiles_uuid",
        c."std_change"
FROM    classified c
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"     cp1 ON cp1."molregno" = c."molregno_A"
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"     cp2 ON cp2."molregno" = c."molregno_B"
