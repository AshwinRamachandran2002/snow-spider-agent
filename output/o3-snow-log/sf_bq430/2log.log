```sql
--Description: 3) Find raw activity rows whose calculated potency is exceptionally high (pChEMBL > 10)
SELECT "activity_id",
       "assay_id",
       "molregno",
       "standard_type",
       "standard_value",
       "pchembl_value"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"
WHERE  "pchembl_value" > 10
LIMIT  20;
```

```sql
--Description: 4) Join the high-potency activities to compounds having 10-15 heavy atoms
SELECT a."activity_id",
       a."assay_id",
       a."molregno",
       a."standard_type",
       a."standard_value",
       a."standard_relation",
       a."pchembl_value",
       CAST(cp."heavy_atoms" AS INTEGER) AS "heavy_atoms"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"  a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
       ON a."molregno" = cp."molregno"
WHERE  a."pchembl_value" > 10
  AND  cp."heavy_atoms" IS NOT NULL
  AND  TRY_TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
LIMIT  20;
```

```sql
--Description: 5) Count how many qualifying activities occur per assay and standard_type
SELECT a."assay_id",
       a."standard_type",
       COUNT(*) AS "qualifying_acts"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"  a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
       ON a."molregno" = cp."molregno"
WHERE  a."pchembl_value" > 10
  AND  TRY_TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
GROUP  BY a."assay_id", a."standard_type"
HAVING COUNT(*) < 5
LIMIT  20;
```

```sql
--Description: 6) List the individual activity rows for those sparse assays (<5 qualifying rows, no more than 1 duplicate)
SELECT a."activity_id",
       a."assay_id",
       a."molregno",
       a."standard_type",
       a."standard_value",
       a."standard_relation",
       a."potential_duplicate",
       a."pchembl_value"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"  a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
       ON a."molregno" = cp."molregno"
WHERE  a."pchembl_value" > 10
  AND  TRY_TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
  AND  a."potential_duplicate" < 2
  AND  a."assay_id" IN (
        SELECT "assay_id"
        FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"  aa
        JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cc
               ON aa."molregno" = cc."molregno"
        WHERE  aa."pchembl_value" > 10
          AND  TRY_TO_NUMBER(cc."heavy_atoms") BETWEEN 10 AND 15
        GROUP  BY aa."assay_id"
        HAVING COUNT(*) < 5 )
LIMIT  20;
```

```sql
--Description: 7) Bring in canonical SMILES for those activity rows (needed later for UUID generation)
SELECT a."activity_id",
       a."assay_id",
       a."molregno",
       cs."canonical_smiles"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"          a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES_30" cs
       ON a."molregno" = cs."molregno"
WHERE  a."activity_id" IN ( '###-PUT-SOME-ID-LIST-FROM-QUERY-6-###' )
LIMIT  20;
```

```sql
--Description: 8) Self-join qualifying activities inside the same assay & standard_type to form all unique molecule pairs
SELECT  LEAST(act1."activity_id", act2."activity_id") AS "act_id_A",
        GREATEST(act1."activity_id", act2."activity_id") AS "act_id_B",
        act1."assay_id",
        act1."standard_type"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"  act1
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"  act2
          ON  act1."assay_id"      = act2."assay_id"
          AND act1."standard_type" = act2."standard_type"
          AND act1."activity_id"  < act2."activity_id"
WHERE  act1."activity_id" IN ( '###-ID-LIST-FROM-QUERY-6###' )
  AND  act2."activity_id" IN ( '###-ID-LIST-FROM-QUERY-6###' )
LIMIT  20;
```

```sql
--Description: 9) Compare the two standard values to classify the change (increase / decrease / no-change)
SELECT p."act_id_A",
       p."act_id_B",
       a1."standard_value" AS "value_A",
       a1."standard_relation" AS "rel_A",
       a2."standard_value" AS "value_B",
       a2."standard_relation" AS "rel_B",
       CASE
         WHEN TRY_TO_NUMBER(a1."standard_value")  > TRY_TO_NUMBER(a2."standard_value") THEN 'decrease'
         WHEN TRY_TO_NUMBER(a1."standard_value")  < TRY_TO_NUMBER(a2."standard_value") THEN 'increase'
         ELSE 'no-change'
       END AS "std_change"
FROM   ( /* pair list from query 8 */
        SELECT * FROM VALUES
        ('111','222','888','IC50')  --dummy row, replace with real results
        ) p("act_id_A","act_id_B","assay_id","standard_type")
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a1 ON a1."activity_id" = p."act_id_A"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a2 ON a2."activity_id" = p."act_id_B"
LIMIT  20;
```

```sql
--Description: 10) Bring together heavy-atom max, latest publication date (synthetic), highest doc_id, plus JSON-based UUIDs
SELECT p."act_id_A",
       p."act_id_B",
       GREATEST(TRY_TO_NUMBER(cp1."heavy_atoms"), TRY_TO_NUMBER(cp2."heavy_atoms")) AS "max_heavy_atoms",
       GREATEST(a1."doc_id", a2."doc_id")                                            AS "highest_doc_id",
       /* publication date construction sketch (needs docs table not present in snippet) */
       '1970-01-01' AS "latest_pub_date",
       /* UUIDs from MD5 hashes of activity IDs & SMILES */
       TO_HEX(MD5(TO_JSON_STRING(OBJECT_CONSTRUCT('A',p."act_id_A",'B',p."act_id_B"))))          AS "mmp_delta_uuid",
       TO_HEX(MD5(TO_JSON_STRING(OBJECT_CONSTRUCT('A',cs1."canonical_smiles",'B',cs2."canonical_smiles")))) AS "mmp_smiles_uuid",
       pc."std_change"
FROM   ( /* pair list from query 8 */ SELECT * FROM VALUES
        ('111','222','888','IC50') ) p("act_id_A","act_id_B","assay_id","standard_type")
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"        a1  ON a1."activity_id" = p."act_id_A"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"        a2  ON a2."activity_id" = p."act_id_B"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp1 ON cp1."molregno"    = a1."molregno"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp2 ON cp2."molregno"    = a2."molregno"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES_30" cs1 ON cs1."molregno" = a1."molregno"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES_30" cs2 ON cs2."molregno" = a2."molregno"
JOIN   ( /* change classification from query 9 */ 
        SELECT '111' AS "act_id_A",'222' AS "act_id_B",'decrease' AS "std_change") pc
        ON pc."act_id_A" = p."act_id_A" AND pc."act_id_B" = p."act_id_B"
LIMIT  20;
```
