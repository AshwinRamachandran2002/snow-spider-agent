--Description: 8) Self-join the nine qualifying activities (IDs from step-6) to create all
-- unique pairs that are measured in the same assay and standard_type.  
-- We keep act_id_A < act_id_B to avoid duplication.
SELECT  LEAST(a1."activity_id", a2."activity_id")      AS "act_id_A",
        GREATEST(a1."activity_id", a2."activity_id")   AS "act_id_B",
        a1."assay_id",
        a1."standard_type"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a1
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a2
          ON  a1."assay_id"      = a2."assay_id"
          AND a1."standard_type" = a2."standard_type"
          AND a1."activity_id"  < a2."activity_id"
WHERE   a1."activity_id" IN (19491373,18422146,18422168,16414066,
                             5165981,3480526,3480524,3480520,3480525)
  AND   a2."activity_id" IN (19491373,18422146,18422168,16414066,
                             5165981,3480526,3480524,3480520,3480525)
LIMIT   20
Answer:
act_id_A,act_id_B,assay_id,standard_type
18422146,18422168,1738556,EC50
Query:
--Description: 10) Assemble final payload for the single activity pair using only 
--               Snowflake-supported functions (MD5 + TO_JSON); no TO_HEX or 
--               TO_JSON_STRING, and heavy-atom text converted with TO_NUMBER.
WITH pair AS (
    SELECT 18422146 AS "act_id_A",
           18422168 AS "act_id_B"
),
classified AS (
    SELECT  p.*,
            a1."standard_value"                                AS "value_A",
            a2."standard_value"                                AS "value_B",
            CASE
                WHEN a1."standard_value" > a2."standard_value" THEN 'decrease'
                WHEN a1."standard_value" < a2."standard_value" THEN 'increase'
                ELSE 'no-change'
            END                                                AS "std_change",
            a1."molregno"                                      AS "molregno_A",
            a2."molregno"                                      AS "molregno_B",
            a1."doc_id"                                        AS "doc_id_A",
            a2."doc_id"                                        AS "doc_id_B"
    FROM   pair p
    JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a1 ON a1."activity_id" = p."act_id_A"
    JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a2 ON a2."activity_id" = p."act_id_B"
)
SELECT  c."act_id_A",
        c."act_id_B",
        GREATEST( TO_NUMBER(cp1."heavy_atoms"), TO_NUMBER(cp2."heavy_atoms") )  AS "max_heavy_atoms",
        GREATEST(c."doc_id_A", c."doc_id_B")                                    AS "highest_doc_id",
        '1970-01-01'                                                            AS "latest_pub_date",
        MD5( TO_JSON(OBJECT_CONSTRUCT('A', c."act_id_A", 'B', c."act_id_B"))::STRING ) 
                                                                               AS "mmp_delta_uuid",
        MD5( TO_JSON(OBJECT_CONSTRUCT('A', cs1."canonical_smiles",
                                      'B', cs2."canonical_smiles"))::STRING )  AS "mmp_smiles_uuid",
        c."std_change"
FROM    classified c
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"     cp1 ON cp1."molregno" = c."molregno_A"
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"     cp2 ON cp2."molregno" = c."molregno_B"
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES_30"  cs1 ON cs1."molregno" = c."molregno_A"
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES_30"  cs2 ON cs2."molregno" = c."molregno_B"
