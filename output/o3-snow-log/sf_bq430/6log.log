Query:
--Description: 7) Self-join within the same (assay, standard_type) to preview pairs of *different* molecules.
SELECT a1."activity_id"       AS "activity_id_1",
       a2."activity_id"       AS "activity_id_2",
       a1."assay_id",
       a1."standard_type",
       a1."standard_value"    AS "value_1",
       a2."standard_value"    AS "value_2",
       a1."molregno"          AS "molregno_1",
       a2."molregno"          AS "molregno_2"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a1
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a2
       ON a1."assay_id"      = a2."assay_id"
      AND a1."standard_type" = a2."standard_type"
      AND a1."molregno"      <> a2."molregno"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" p1
       ON a1."molregno" = p1."molregno"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" p2
       ON a2."molregno" = p2."molregno"
WHERE  TRY_TO_NUMBER(p1."heavy_atoms") BETWEEN 10 AND 15
  AND  TRY_TO_NUMBER(p2."heavy_atoms") BETWEEN 10 AND 15
  AND  a1."pchembl_value" > 10
  AND  a2."pchembl_value" > 10
LIMIT  20;
