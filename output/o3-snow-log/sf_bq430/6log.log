```sql
--Description: 1) Inspect compounds that have 10-15 heavy atoms and retrieve their SMILES.
SELECT p."molregno",
       p."heavy_atoms",
       s."canonical_smiles"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  p
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  s
       ON p."molregno" = s."molregno"
WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
LIMIT  20;
```

```sql
--Description: 2) Look at activities with pChEMBL >10 that involve those small (10-15 heavy atoms) compounds.
SELECT a."activity_id",
       a."assay_id",
       a."molregno",
       a."standard_type",
       a."standard_value",
       a."standard_relation",
       a."pchembl_value"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"         a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"   p
       ON a."molregno" = p."molregno"
WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
  AND  a."pchembl_value" > 10
LIMIT  20;
```

```sql
--Description: 3) Find (assay, standard_type) combinations that already satisfy heavy-atom and pChEMBL filters.
SELECT DISTINCT a."assay_id",
       a."standard_type"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"       a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" p
       ON a."molregno" = p."molregno"
WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
  AND  a."pchembl_value" > 10
LIMIT  20;
```

```sql
--Description: 4) For the filtered set, count how many activities each (assay, standard_type) has
--              (needed to identify assays with <5 activities).
SELECT a."assay_id",
       a."standard_type",
       COUNT(*) AS "activity_count"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"       a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" p
       ON a."molregno" = p."molregno"
WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
  AND  a."pchembl_value" > 10
GROUP  BY a."assay_id", a."standard_type"
HAVING COUNT(*) < 5
LIMIT  20;
```

```sql
--Description: 5) Examine potential duplicate flags for those activities
--              (we want <2 duplicates in an assay later).
SELECT a."activity_id",
       a."assay_id",
       a."standard_type",
       a."potential_duplicate"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" p
       ON a."molregno" = p."molregno"
WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
  AND  a."pchembl_value" > 10
  AND  a."potential_duplicate" = 1
LIMIT  20;
```

```sql
--Description: 6) Preview standard values & relations needed for “increase / decrease / no-change” categorisation.
SELECT a."activity_id",
       a."assay_id",
       a."molregno",
       a."standard_relation",
       a."standard_value"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" p
       ON a."molregno" = p."molregno"
WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
  AND  a."pchembl_value" > 10
  AND  a."standard_value" IS NOT NULL
LIMIT  20;
```

```sql
--Description: 7) Self-join within the same (assay, standard_type) to preview pairs of *different* molecules.
SELECT a1."activity_id"       AS "activity_id_1",
       a2."activity_id"       AS "activity_id_2",
       a1."assay_id",
       a1."standard_type",
       a1."standard_value"    AS "value_1",
       a2."standard_value"    AS "value_2",
       a1."molregno"          AS "molregno_1",
       a2."molregno"          AS "molregno_2"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a1
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a2
       ON a1."assay_id"      = a2."assay_id"
      AND a1."standard_type" = a2."standard_type"
      AND a1."molregno"      <> a2."molregno"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" p1
       ON a1."molregno" = p1."molregno"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" p2
       ON a2."molregno" = p2."molregno"
WHERE  TRY_TO_NUMBER(p1."heavy_atoms") BETWEEN 10 AND 15
  AND  TRY_TO_NUMBER(p2."heavy_atoms") BETWEEN 10 AND 15
  AND  a1."pchembl_value" > 10
  AND  a2."pchembl_value" > 10
LIMIT  20;
```

```sql
--Description: 8) Bring in canonical SMILES for UUID generation preview.
SELECT a."activity_id",
       s."canonical_smiles",
       a."molregno"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"       a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES" s
       ON a."molregno" = s."molregno"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" p
       ON a."molregno" = p."molregno"
WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
  AND  a."pchembl_value" > 10
LIMIT  20;
```

```sql
--Description: 9) Quick look at other activity tables (e.g. ACTIVITIES_29) to broaden search if needed.
SELECT a."activity_id",
       a."assay_id",
       a."molregno",
       a."standard_type",
       a."standard_value",
       a."pchembl_value"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_29"       a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" p
       ON a."molregno" = p."molregno"
WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
  AND  a."pchembl_value"::FLOAT > 10
LIMIT  20;
```

```sql
--Description: 10) Inspect heavy atom distribution in COMPOUND_PROPERTIES_29 for sanity checks.
SELECT TRY_TO_NUMBER("heavy_atoms") AS "heavy_atoms",
       COUNT(*)                     AS "compound_count"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES_29"
GROUP  BY TRY_TO_NUMBER("heavy_atoms")
ORDER  BY "heavy_atoms"
LIMIT  20;
```
