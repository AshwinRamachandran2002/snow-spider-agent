```sql
--Description: Quick look at activities that already have a calculated pChEMBL
--             value; restrict to clearly numeric, non–null values > 10.0.  
SELECT 
  a."activity_id",
  a."assay_id",
  a."molregno",
  a."standard_type",
  a."standard_relation",
  a."standard_value",
  a."pchembl_value"
FROM "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a
WHERE a."pchembl_value" IS NOT NULL
  AND a."pchembl_value" > 10
LIMIT 20;
```

```sql
--Description: Join the high-pChEMBL activities found above to compound
--             properties to inspect heavy-atom counts.
SELECT 
  a."activity_id",
  a."molregno",
  cp."heavy_atoms",
  a."pchembl_value"
FROM "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"  a
JOIN "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES_29" cp
      ON cp."molregno" = a."molregno"
WHERE a."pchembl_value" > 10
  AND cp."heavy_atoms" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Same join as above, but focus on molecules whose heavy-atom
--             count (stored as text) is between 10 and 15.
SELECT 
  a."activity_id",
  a."assay_id",
  a."molregno",
  cp."heavy_atoms",
  a."pchembl_value"
FROM "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"  a
JOIN "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES_29" cp
      ON cp."molregno" = a."molregno"
WHERE a."pchembl_value" > 10
  AND TRY_CAST(cp."heavy_atoms" AS INTEGER) BETWEEN 10 AND 15
LIMIT 20;
```

```sql
--Description: Count how many activity records exist per assay & standard_type
--             for the 10–15 heavy-atom, high-pChEMBL set (helps to find assays
--             with < 5 measurements).
SELECT 
  a."assay_id",
  a."standard_type",
  COUNT(*) AS "n_act_in_assay"
FROM "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"  a
JOIN "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES_29" cp
      ON cp."molregno" = a."molregno"
WHERE a."pchembl_value" > 10
  AND TRY_CAST(cp."heavy_atoms" AS INTEGER) BETWEEN 10 AND 15
GROUP BY a."assay_id", a."standard_type"
HAVING COUNT(*) < 5
LIMIT 20;
```

```sql
--Description: Among those same candidate activities, see how many are marked
--             as duplicates (potential_duplicate = 1) within each assay.
SELECT 
  a."assay_id",
  SUM(CASE WHEN a."potential_duplicate" = 1 THEN 1 ELSE 0 END)
        AS "n_duplicates",
  COUNT(*) AS "total_records"
FROM "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a
JOIN "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES_29" cp
      ON cp."molregno" = a."molregno"
WHERE a."pchembl_value" > 10
  AND TRY_CAST(cp."heavy_atoms" AS INTEGER) BETWEEN 10 AND 15
GROUP BY a."assay_id"
LIMIT 20;
```

