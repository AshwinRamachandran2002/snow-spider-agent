/* ---------------------------------------------------------------
   Build MMP-style pairs that fulfil all stated constraints
   --------------------------------------------------------------- */
WITH
/* 1.  All activities that already satisfy the heavy-atom, value and
       pChEMBL filters                                            */
filtered AS (
    SELECT
        a."activity_id",
        a."assay_id",
        a."standard_type",
        a."standard_relation",
        TRY_TO_DOUBLE(a."standard_value")   AS standard_value,
        a."pchembl_value",
        a."molregno",
        a."doc_id",
        a."potential_duplicate",
        TRY_CAST(cp."heavy_atoms" AS INTEGER) AS heavy_atoms
    FROM  "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"               a
    JOIN  "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES_29"      cp
              ON cp."molregno" = a."molregno"
    WHERE a."pchembl_value"        > 10
      AND a."standard_value"       IS NOT NULL
      AND a."standard_relation"    =  '='
      AND TRY_CAST(cp."heavy_atoms" AS INTEGER) BETWEEN 10 AND 15
),
/* 2.  How many rows (and duplicates) exist per assay & type?      */
assay_stats AS (
    SELECT
        "assay_id",
        "standard_type",
        COUNT(*)                                             AS n_act,
        SUM(CASE WHEN "potential_duplicate" = 1
                 THEN 1 ELSE 0 END)                         AS n_dup
    FROM  "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"
    GROUP BY "assay_id","standard_type"
),
/* 3.  Keep only activities that belong to “small” assays
       (< 5 rows and < 2 duplicates overall)                  */
qualified AS (
    SELECT f.*
    FROM   filtered  f
    JOIN   assay_stats s
           ON  s."assay_id"      = f."assay_id"
           AND s."standard_type" = f."standard_type"
    WHERE  s.n_act < 5
      AND  s.n_dup < 2
),
/* 4.  Form every unordered pair of DIFFERENT molecules within
       the same assay & type                                   */
pairs AS (
    SELECT
        q1."activity_id"               AS activity_id_1,
        q2."activity_id"               AS activity_id_2,
        q1."molregno"                  AS molregno_1,
        q2."molregno"                  AS molregno_2,
        q1."assay_id",
        q1."standard_type",
        q1.standard_value              AS standard_value_1,
        q2.standard_value              AS standard_value_2,
        q1.heavy_atoms                 AS ha1,
        q2.heavy_atoms                 AS ha2,
        q1."doc_id"                    AS doc_id_1,
        q2."doc_id"                    AS doc_id_2
    FROM   qualified q1
    JOIN   qualified q2
           ON  q1."assay_id"      = q2."assay_id"
           AND q1."standard_type" = q2."standard_type"
           AND q1."molregno"      <> q2."molregno"
           AND q1."activity_id"   <  q2."activity_id"   -- avoid duplicates
),
/* 5.  Rank documents inside each (journal,year) group so that we
       can synthesise a publication date                        */
docs_ranked AS (
    SELECT
        d."doc_id",
        COALESCE(d."journal",'UNKNOWN')        AS journal,
        COALESCE(d."year",1970)                AS yr,
        TRY_TO_NUMBER(d."first_page")          AS fp_num,
        ROW_NUMBER() OVER (
             PARTITION BY COALESCE(d."journal",'UNKNOWN'),
                          COALESCE(d."year",1970)
             ORDER BY TRY_TO_NUMBER(d."first_page") NULLS LAST
        )                                      AS rn,
        COUNT(*)  OVER (
             PARTITION BY COALESCE(d."journal",'UNKNOWN'),
                          COALESCE(d."year",1970)
        )                                      AS tot
    FROM  "EBI_CHEMBL"."EBI_CHEMBL"."DOCS_29" d
),
doc_calendar AS (
    SELECT
        "doc_id",
        yr                                                     AS year,
        1 + FLOOR( CASE WHEN tot = 1
                        THEN 0
                        ELSE (rn - 1)::FLOAT / (tot - 1) END * 11 )     AS month,
        1 + MOD( FLOOR( CASE WHEN tot = 1
                              THEN 0
                              ELSE (rn - 1)::FLOAT / (tot - 1) END * 308 )
                 , 28)                                         AS day
    FROM docs_ranked
),
doc_dates AS (
    SELECT
        "doc_id",
        TO_CHAR( TO_DATE(year || '-' || month || '-' || day),
                 'YYYY-MM-DD')                                 AS pub_date
    FROM doc_calendar
),
/* 6.  Attach publication dates to both documents in the pair     */
pairs_dated AS (
    SELECT
        p.*,
        COALESCE(d1.pub_date,'1970-01-01')   AS pub_date_1,
        COALESCE(d2.pub_date,'1970-01-01')   AS pub_date_2
    FROM  pairs p
    LEFT JOIN doc_dates d1  ON d1."doc_id" = p.doc_id_1
    LEFT JOIN doc_dates d2  ON d2."doc_id" = p.doc_id_2
),
/* 7.  Final classification & simple field derivations            */
pair_final AS (
    SELECT
        *,
        CASE
            WHEN standard_value_1 > standard_value_2 THEN 'decrease'
            WHEN standard_value_1 < standard_value_2 THEN 'increase'
            ELSE 'no-change'
        END                                                   AS change_class,
        GREATEST(ha1,ha2)                                     AS max_heavy_atoms,
        CASE WHEN TO_DATE(pub_date_1) > TO_DATE(pub_date_2)
             THEN pub_date_1 ELSE pub_date_2 END              AS latest_publication_date,
        GREATEST(doc_id_1,doc_id_2)                           AS latest_doc_id
    FROM pairs_dated
),
/* 8.  Bring in canonical SMILES so we can generate the second
       UUID (based on structures)                               */
smiles AS (
    SELECT "molregno","canonical_smiles"
    FROM   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES_30"
)
/* 9.  Emit requested result columns                              */
SELECT
    pf.activity_id_1,
    pf.activity_id_2,
    pf.assay_id,
    pf.standard_type,
    pf.standard_value_1,
    pf.standard_value_2,
    pf.change_class,
    pf.max_heavy_atoms,
    pf.latest_publication_date,
    pf.latest_doc_id,
    /* UUID based on pair of activity IDs */
    LOWER( TO_HEX( MD5(
        TO_JSON_STRING( OBJECT_CONSTRUCT('A',pf.activity_id_1,
                                         'B',pf.activity_id_2) )
    ) ) )                                        AS mmp_uuid_activity,
    /* UUID based on pair of canonical SMILES  */
    LOWER( TO_HEX( MD5(
        TO_JSON_STRING( OBJECT_CONSTRUCT(
               'A', s1."canonical_smiles",
               'B', s2."canonical_smiles") )
    ) ) )                                        AS mmp_uuid_smiles
FROM   pair_final               pf
JOIN   smiles  s1 ON s1."molregno" = pf.molregno_1
JOIN   smiles  s2 ON s2."molregno" = pf.molregno_2;
```
