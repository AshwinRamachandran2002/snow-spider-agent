WITH
/* 1.  Activity rows that already meet heavy-atom, value, pChEMBL rules */
filtered AS (
    SELECT
        a."activity_id",
        a."assay_id",
        a."standard_type",
        a."standard_relation",
        TRY_TO_NUMBER(a."standard_value")                      AS standard_value,
        a."pchembl_value",
        a."molregno",
        a."doc_id",
        a."potential_duplicate",
        TRY_TO_NUMBER(cp."heavy_atoms")                        AS heavy_atoms
    FROM  "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"  a
    JOIN  "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES_29" cp
          ON cp."molregno" = a."molregno"
