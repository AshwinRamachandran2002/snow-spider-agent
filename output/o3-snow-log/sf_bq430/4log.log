```sql
--Description: Pull canonical SMILES for the small-atom, high-pChEMBL molecules
--             (needed later for UUID creation).
SELECT DISTINCT
  cs."canonical_smiles",
  cs."molregno"
FROM "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES_30" cs
JOIN "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES_29" cp
      ON cp."molregno" = cs."molregno"
WHERE TRY_CAST(cp."heavy_atoms" AS INTEGER) BETWEEN 10 AND 15
LIMIT 20;
```

```sql
--Description: Example of pairing two different molecules measured in the same
--             assay & standard_type to preview their standard values. 
--             (Self-join on assay_id, standard_type with different molregno).
SELECT 
  a1."activity_id"          AS "act_id_1",
  a2."activity_id"          AS "act_id_2",
  a1."assay_id",
  a1."standard_type",
  a1."standard_relation"    AS "rel_1",
  a1."standard_value"       AS "val_1",
  a2."standard_relation"    AS "rel_2",
  a2."standard_value"       AS "val_2"
FROM "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a1
JOIN "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30" a2
      ON a1."assay_id" = a2."assay_id"
     AND a1."standard_type" = a2."standard_type"
     AND a1."molregno" <> a2."molregno"
WHERE a1."pchembl_value" > 10
  AND a2."pchembl_value" > 10
  AND TRY_CAST((SELECT cp1."heavy_atoms"
                FROM "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES_29" cp1
                WHERE cp1."molregno" = a1."molregno") AS INTEGER) BETWEEN 10 AND 15
  AND TRY_CAST((SELECT cp2."heavy_atoms"
                FROM "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES_29" cp2
                WHERE cp2."molregno" = a2."molregno") AS INTEGER) BETWEEN 10 AND 15
LIMIT 20;
```

