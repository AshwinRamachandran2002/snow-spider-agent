pairs_dated AS (
    SELECT
        p.*,
        COALESCE(d1.pub_date,'1970-01-01')   AS pub_date_1,
        COALESCE(d2.pub_date,'1970-01-01')   AS pub_date_2
    FROM pairs p
    LEFT JOIN doc_dates d1  ON d1."doc_id" = p.doc_id_1
    LEFT JOIN doc_dates d2  ON d2."doc_id" = p.doc_id_2
),
/* 7.  Classification & helper fields                                */
pair_final AS (
    SELECT
        p.*,
        CASE
            WHEN standard_value_1 > standard_value_2 THEN 'decrease'
            WHEN standard_value_1 < standard_value_2 THEN 'increase'
            ELSE 'no-change'
        END                                  AS change_class,
        GREATEST(ha1,ha2)                    AS max_heavy_atoms,
        CASE WHEN TO_DATE(pub_date_1) > TO_DATE(pub_date_2)
             THEN pub_date_1 ELSE pub_date_2 END
                                            AS latest_publication_date,
        GREATEST(doc_id_1,doc_id_2)          AS latest_doc_id
    FROM pairs_dated p
),
/* 8.  Canonical SMILES for UUID generation                          */
smiles AS (
    SELECT "molregno","canonical_smiles"
    FROM   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES_30"
)
/* 9.  Final result                                                  */
SELECT
    pf."activity_id_1",
    pf."activity_id_2",
    pf."assay_id",
    pf."standard_type",
    pf.standard_value_1,
    pf.standard_value_2,
    pf.change_class,
    pf.max_heavy_atoms,
    pf.latest_publication_date,
    pf.latest_doc_id,
    /* UUID from activity IDs */
    LOWER(
        TO_HEX(
            MD5(
                TO_JSON_STRING(
                    OBJECT_CONSTRUCT('A',pf."activity_id_1",
                                     'B',pf."activity_id_2")
                )
            )
        )
    ) AS mmp_uuid_activity,
    /* UUID from canonical SMILES */
    LOWER(
        TO_HEX(
            MD5(
                TO_JSON_STRING(
                    OBJECT_CONSTRUCT(
                        'A', s1."canonical_smiles",
                        'B', s2."canonical_smiles"
                    )
                )
            )
        )
    ) AS mmp_uuid_smiles
FROM pair_final pf
JOIN smiles s1  ON s1."molregno" = pf.molregno_1
JOIN smiles s2  ON s2."molregno" = pf.molregno_2;
