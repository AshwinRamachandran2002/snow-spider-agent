```sql
--Description:
-- Thinking process (explained inside this single comment block):
--  • Step-1  :  Filter ACTIVITIES_30 to keep rows that satisfy basic rules:
--               pChEMBL > 10, non-null standard_value, potential_duplicate < 2.
--  • Step-2  :  Join to COMPOUND_PROPERTIES_29 to enforce 10-15 heavy atoms.
--  • Step-3  :  Add a window-count to ensure each (assay_id, standard_type)
--               combination has < 5 total qualifying rows.
--  • Step-4  :  Self-join this trimmed set to create DISTINCT pairs of
--               DIFFERENT molecules tested in the SAME assay & standard_type.
--  • Step-5  :  Join to COMPOUND_STRUCTURES_30 twice to pick up canonical
--               SMILES for both molecules (needed later for UUID work).
--  • Step-6  :  Compute helper fields:
--                 – max_heavy_atoms      : larger of the two counts
--                 – highest_doc_id       : GREATEST of the two document IDs
--                 – change_class         : classify ↑/↓/no-change using numeric
--                                           comparison of standard_values
--                 – mmp_delta_uuid       : MD5 of JSON-like text built from the
--                                           two activity IDs (order-independent
--                                           via LEAST/GREATEST).
--  • LIMIT 20 :  show a small sample; downstream code can remove the LIMIT.
WITH base AS (
    SELECT
        a."activity_id",
        a."assay_id",
        a."molregno",
        a."doc_id",
        a."standard_type",
        a."standard_relation",
        a."standard_value",
        a."pchembl_value",
        TRY_CAST(cp."heavy_atoms" AS INTEGER) AS heavy_atoms_int,
        COALESCE(TRY_CAST(a."potential_duplicate" AS INTEGER),0) AS dup_flag
    FROM "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_30"            a
    JOIN "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES_29"   cp
          ON cp."molregno" = a."molregno"
    WHERE a."pchembl_value"  > 10
      AND TRY_CAST(cp."heavy_atoms" AS INTEGER) BETWEEN 10 AND 15
      AND a."standard_value" IS NOT NULL
      AND COALESCE(TRY_CAST(a."potential_duplicate" AS INTEGER),0) < 2
), counted AS (
    SELECT
        b.*,
        COUNT(*) OVER (PARTITION BY b."assay_id", b."standard_type") AS n_in_assay
    FROM base b
), pairs AS (
    SELECT
        x."activity_id"                       AS act_id_1,
        y."activity_id"                       AS act_id_2,
        x."assay_id",
        x."standard_type",
        x."standard_relation"                 AS rel_1,
        y."standard_relation"                 AS rel_2,
        x."standard_value"                    AS val_1,
        y."standard_value"                    AS val_2,
        x.heavy_atoms_int                     AS ha_1,
        y.heavy_atoms_int                     AS ha_2,
        GREATEST(x.heavy_atoms_int, y.heavy_atoms_int)      AS max_heavy_atoms,
        GREATEST(x."doc_id", y."doc_id")                     AS highest_doc_id,
        CASE
            WHEN TRY_CAST(x."standard_value" AS FLOAT) > TRY_CAST(y."standard_value" AS FLOAT) THEN 'decrease'
            WHEN TRY_CAST(x."standard_value" AS FLOAT) < TRY_CAST(y."standard_value" AS FLOAT) THEN 'increase'
            ELSE 'no-change'
        END                                                AS change_class,
        -- order-independent concatenation for UUID seed
        LEAST(x."activity_id", y."activity_id") || '-' || GREATEST(x."activity_id", y."activity_id") AS pair_key
    FROM counted x
    JOIN counted y
          ON x."assay_id"      = y."assay_id"
         AND x."standard_type" = y."standard_type"
         AND x."molregno"     <> y."molregno"
         AND x.n_in_assay < 5      -- enforce <5 rows rule
         AND y.n_in_assay < 5
), uuid_enriched AS (
    SELECT
        p.*,
        TO_HEX(MD5(p.pair_key)) AS mmp_delta_uuid
    FROM pairs p
)
SELECT 
    ue."act_id_1",
    ue."act_id_2",
    ue."assay_id",
    ue."standard_type",
    ue."rel_1",
    ue."val_1",
    ue."rel_2",
    ue."val_2",
    ue."max_heavy_atoms",
    ue."highest_doc_id",
    ue."change_class",
    ue."mmp_delta_uuid"
FROM uuid_enriched ue
LIMIT 20;
```
