-- Description:
-- One self-contained Snowflake query that:
--   1) selects activities on molecules with 10–15 heavy atoms,
--      pChEMBL > 10, non-null standard values (table: ACTIVITIES_27).
--   2) keeps only (assay_id, standard_type) groups having <5 such
--      activities and <2 duplicates.
--   3) forms every ordered pair of DIFFERENT molecules tested in the
--      same assay & type.
--   4) classifies the change in standard values (increase / decrease /
--      no-change).
--   5) reports max heavy-atom count and highest doc_id in each pair.
--   6) builds two UUID-style hashes via  MD5 → HEX_ENCODE  of JSON
--      strings (Snowflake functions: OBJECT_CONSTRUCT, TO_JSON).
WITH qual AS (                             /* step-1: single qualifying activities */
    SELECT  a."activity_id",
            a."assay_id",
            a."molregno",
            a."doc_id",
            a."standard_type",
            a."standard_value"::FLOAT          AS "std_val",
            a."standard_relation"              AS "rel",
            TRY_TO_NUMBER(p."heavy_atoms")     AS "heavy_atoms",
            s."canonical_smiles",
            a."potential_duplicate"
    FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"        a
    JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  p  ON a."molregno" = p."molregno"
    JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  s  ON a."molregno" = s."molregno"
    WHERE   TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
      AND   TRY_TO_NUMBER(a."pchembl_value")  > 10
      AND   a."standard_value" IS NOT NULL
),
small_sets AS (                             /* step-2: restrict to small assay/type groups */
    SELECT "assay_id", "standard_type"
    FROM   qual
    GROUP  BY "assay_id", "standard_type"
    HAVING COUNT(*) < 5
       AND SUM(CASE WHEN "potential_duplicate" = '1' THEN 1 ELSE 0 END) < 2
),
filtered AS (                               /* step-3: activities that pass size / duplicate filters */
    SELECT q.*
    FROM   qual q
    JOIN   small_sets s
      ON   q."assay_id"      = s."assay_id"
     AND   q."standard_type" = s."standard_type"
),
pairs AS (                                  /* step-4: ordered pairs of DIFFERENT molecules */
    SELECT f1."activity_id"                      AS "act_id_1",
           f2."activity_id"                      AS "act_id_2",
           f1."assay_id",
           f1."standard_type",
           f1."std_val"                          AS "val_1",
           f1."rel"                              AS "rel_1",
           f1."canonical_smiles"                 AS "smiles_1",
           f2."std_val"                          AS "val_2",
           f2."rel"                              AS "rel_2",
           f2."canonical_smiles"                 AS "smiles_2",
           GREATEST(f1."heavy_atoms",f2."heavy_atoms") AS "max_heavy_atoms",
           GREATEST(f1."doc_id",f2."doc_id")           AS "max_doc_id"
    FROM   filtered f1
    JOIN   filtered f2
           ON  f1."assay_id"       = f2."assay_id"
           AND f1."standard_type"  = f2."standard_type"
           AND f1."activity_id"   < f2."activity_id"
),
classed AS (                                /* step-5: classify change */
    SELECT *,
           CASE
               WHEN "rel_1" = '=' AND "rel_2" = '=' AND "val_1" = "val_2"
                    THEN 'no-change'
               WHEN "val_1" > "val_2"  THEN 'decrease'
               WHEN "val_1" < "val_2"  THEN 'increase'
               ELSE 'no-change'
           END AS "std_change"
    FROM   pairs
)
SELECT  "act_id_1",
        "act_id_2",
        "assay_id",
        "standard_type",
        "max_heavy_atoms",
        "max_doc_id",
        "std_change",
        /* UUID derived from activity IDs */
        HEX_ENCODE(
            MD5(
                TO_JSON(
                    OBJECT_CONSTRUCT('A', "act_id_1", 'B', "act_id_2")
                )::STRING
            )
        ) AS "mmp_delta_uuid",
        /* UUID derived from canonical SMILES */
        HEX_ENCODE(
            MD5(
                TO_JSON(
                    OBJECT_CONSTRUCT('A', "smiles_1", 'B', "smiles_2")
                )::STRING
            )
        ) AS "smiles_pair_uuid"
FROM    classed
LIMIT   20;
