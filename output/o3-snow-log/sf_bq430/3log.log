Below is an example exploration path expressed in ≤ 10 Snowflake SQL statements (each limited to 20 rows) that grows from very simple column peeks to a final-stage query that already fulfils almost every requirement stated in the task.  
Every identifier is wrapped in double–quotes, every query is preceded by a short description comment, and only the tables listed in the catalogue are used.

```sql
-- Description: Quick look at compounds that have 10–15 heavy atoms
SELECT "molregno",
       "heavy_atoms"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"
WHERE  TRY_TO_NUMBER("heavy_atoms") BETWEEN 10 AND 15
LIMIT  20;
```

```sql
-- Description: Join heavy-atom filtered compounds with their canonical SMILES
SELECT p."molregno",
       p."heavy_atoms",
       s."canonical_smiles"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  p
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES" s
       ON p."molregno" = s."molregno"
WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
LIMIT  20;
```

```sql
-- Description: Have a peek at very potent activities (pChEMBL > 10) in one activity slice
SELECT "activity_id",
       "assay_id",
       "molregno",
       "standard_type",
       "standard_value",
       "pchembl_value",
       "potential_duplicate"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"
WHERE  TRY_TO_NUMBER("pchembl_value") > 10
LIMIT  20;
```

```sql
-- Description: Combine potent activities with 10–15 heavy-atom compounds
SELECT a."activity_id",
       a."assay_id",
       a."molregno",
       a."standard_type",
       a."standard_value",
       a."standard_relation",
       a."pchembl_value",
       p."heavy_atoms"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"         a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  p
       ON a."molregno" = p."molregno"
WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
  AND  TRY_TO_NUMBER(a."pchembl_value") > 10
  AND  a."standard_value" IS NOT NULL
LIMIT  20;
```

```sql
-- Description: Count how many qualifying activities each (assay_id, standard_type) has
SELECT a."assay_id",
       a."standard_type",
       COUNT(*) AS "n_activities"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"         a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  p
       ON a."molregno" = p."molregno"
WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
  AND  TRY_TO_NUMBER(a."pchembl_value") > 10
  AND  a."standard_value" IS NOT NULL
GROUP  BY a."assay_id", a."standard_type"
HAVING COUNT(*) < 5
LIMIT  20;
```

```sql
-- Description: Check duplicate counts in the same context (potential_duplicate = 1)
SELECT a."assay_id",
       a."standard_type",
       SUM(CASE WHEN a."potential_duplicate" = '1' THEN 1 ELSE 0 END) AS "dup_cnt"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"         a
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  p
       ON a."molregno" = p."molregno"
WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
  AND  TRY_TO_NUMBER(a."pchembl_value") > 10
GROUP  BY a."assay_id", a."standard_type"
HAVING SUM(CASE WHEN a."potential_duplicate" = '1' THEN 1 ELSE 0 END) < 2
LIMIT  20;
```

```sql
-- Description: Produce the set of qualifying activities ready for pairing
WITH qual AS (
  SELECT a."activity_id",
         a."assay_id",
         a."molregno",
         a."doc_id",
         a."standard_type",
         a."standard_value"::FLOAT          AS "std_val",
         a."standard_relation"              AS "rel",
         TRY_TO_NUMBER(a."pchembl_value")   AS "pchembl",
         TRY_TO_NUMBER(p."heavy_atoms")     AS "heavy_atoms"
  FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"         a
  JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  p
         ON a."molregno" = p."molregno"
  WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
    AND  TRY_TO_NUMBER(a."pchembl_value") > 10
    AND  a."standard_value" IS NOT NULL
    AND  a."standard_relation" IN ('=', '<', '>', '<=', '>=')
)
SELECT *
FROM   qual
LIMIT  20;
```

```sql
-- Description: Create all pairs of DIFFERENT molecules within the same assay & type, still respecting activity-count rules
WITH qual AS (
  SELECT a."activity_id",
         a."assay_id",
         a."molregno",
         a."doc_id",
         a."standard_type",
         a."standard_value"::FLOAT  AS "std_val",
         a."standard_relation"      AS "rel",
         TRY_TO_NUMBER(p."heavy_atoms") AS "heavy_atoms"
  FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"         a
  JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  p
         ON a."molregno" = p."molregno"
  WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
    AND  TRY_TO_NUMBER(a."pchembl_value") > 10
    AND  a."standard_value" IS NOT NULL
),
small_sets AS (
  SELECT "assay_id", "standard_type"
  FROM   qual
  GROUP  BY "assay_id", "standard_type"
  HAVING COUNT(*) < 5
),
filtered AS (
  SELECT q.*
  FROM   qual q
  JOIN   small_sets s
    ON  q."assay_id"     = s."assay_id"
   AND  q."standard_type"= s."standard_type"
)
SELECT f1."activity_id"  AS "act_id_1",
       f2."activity_id"  AS "act_id_2",
       f1."assay_id",
       f1."standard_type",
       f1."std_val"      AS "val_1",
       f1."rel"          AS "rel_1",
       f2."std_val"      AS "val_2",
       f2."rel"          AS "rel_2",
       GREATEST(f1."heavy_atoms",f2."heavy_atoms") AS "max_heavy_atoms",
       GREATEST(f1."doc_id",f2."doc_id")           AS "max_doc_id"
FROM   filtered f1
JOIN   filtered f2
       ON  f1."assay_id"      = f2."assay_id"
       AND f1."standard_type" = f2."standard_type"
       AND f1."activity_id"  < f2."activity_id"
LIMIT  20;
```

```sql
-- Description: Add change-classification ('increase','decrease','no-change') to each pair
WITH qual AS (
  SELECT a."activity_id",
         a."assay_id",
         a."molregno",
         a."doc_id",
         a."standard_type",
         a."standard_value"::FLOAT  AS "std_val",
         a."standard_relation"      AS "rel",
         TRY_TO_NUMBER(p."heavy_atoms") AS "heavy_atoms"
  FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"         a
  JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  p
         ON a."molregno" = p."molregno"
  WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
    AND  TRY_TO_NUMBER(a."pchembl_value") > 10
    AND  a."standard_value" IS NOT NULL
),
small_sets AS (
  SELECT "assay_id", "standard_type"
  FROM   qual
  GROUP  BY "assay_id", "standard_type"
  HAVING COUNT(*) < 5
),
filtered AS (
  SELECT q.*
  FROM   qual q
  JOIN   small_sets s
    ON  q."assay_id"      = s."assay_id"
   AND  q."standard_type" = s."standard_type"
),
pairs AS (
  SELECT f1."activity_id"  AS "act_id_1",
         f2."activity_id"  AS "act_id_2",
         f1."assay_id",
         f1."standard_type",
         f1."std_val"      AS "val_1",
         f1."rel"          AS "rel_1",
         f2."std_val"      AS "val_2",
         f2."rel"          AS "rel_2",
         GREATEST(f1."heavy_atoms",f2."heavy_atoms") AS "max_heavy_atoms",
         GREATEST(f1."doc_id",f2."doc_id")           AS "max_doc_id"
  FROM   filtered f1
  JOIN   filtered f2
         ON  f1."assay_id"      = f2."assay_id"
         AND f1."standard_type" = f2."standard_type"
         AND f1."activity_id"  < f2."activity_id"
)
SELECT *,
       CASE
         WHEN "rel_1" = '=' AND "rel_2" = '=' AND "val_1" = "val_2"
              THEN 'no-change'
         WHEN "val_1" > "val_2" THEN 'decrease'
         WHEN "val_1" < "val_2" THEN 'increase'
         ELSE 'no-change'
       END AS "std_change"
FROM   pairs
LIMIT  20;
```

```sql
-- Description: Final-stage query – everything above plus UUIDs made from MD5 hashes of JSON strings
WITH qual AS (
  SELECT a."activity_id",
         a."assay_id",
         a."molregno",
         a."doc_id",
         a."standard_type",
         a."standard_value"::FLOAT  AS "std_val",
         a."standard_relation"      AS "rel",
         TRY_TO_NUMBER(p."heavy_atoms") AS "heavy_atoms",
         s."canonical_smiles"
  FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"         a
  JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  p
         ON a."molregno" = p."molregno"
  JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  s
         ON a."molregno" = s."molregno"
  WHERE  TRY_TO_NUMBER(p."heavy_atoms") BETWEEN 10 AND 15
    AND  TRY_TO_NUMBER(a."pchembl_value") > 10
    AND  a."standard_value" IS NOT NULL
),
small_sets AS (
  SELECT "assay_id", "standard_type"
  FROM   qual
  GROUP  BY "assay_id", "standard_type"
  HAVING COUNT(*) < 5
),
filtered AS (
  SELECT q.*
  FROM   qual q
  JOIN   small_sets s
    ON  q."assay_id"      = s."assay_id"
   AND  q."standard_type" = s."standard_type"
),
pairs AS (
  SELECT f1."activity_id"  AS "act_id_1",
         f2."activity_id"  AS "act_id_2",
         f1."assay_id",
         f1."standard_type",
         f1."std_val"      AS "val_1",
         f1."rel"          AS "rel_1",
         f1."canonical_smiles" AS "smiles_1",
         f2."std_val"      AS "val_2",
         f2."rel"          AS "rel_2",
         f2."canonical_smiles" AS "smiles_2",
         GREATEST(f1."heavy_atoms",f2."heavy_atoms") AS "max_heavy_atoms",
         GREATEST(f1."doc_id",f2."doc_id")           AS "max_doc_id"
  FROM   filtered f1
  JOIN   filtered f2
         ON  f1."assay_id"      = f2."assay_id"
         AND f1."standard_type" = f2."standard_type"
         AND f1."activity_id"  < f2."activity_id"
),
classed AS (
  SELECT *,
         CASE
           WHEN "rel_1" = '=' AND "rel_2" = '=' AND "val_1" = "val_2"
                THEN 'no-change'
           WHEN "val_1" > "val_2" THEN 'decrease'
           WHEN "val_1" < "val_2" THEN 'increase'
           ELSE 'no-change'
         END AS "std_change"
  FROM   pairs
)
SELECT "act_id_1",
       "act_id_2",
       "assay_id",
       "standard_type",
       "max_heavy_atoms",
       "max_doc_id",
       "std_change",
       TO_HEX(MD5(TO_JSON_STRING(OBJECT_CONSTRUCT('A',"act_id_1",'B',"act_id_2")))) AS "mmp_delta_uuid",
       TO_HEX(MD5(TO_JSON_STRING(OBJECT_CONSTRUCT('A',"smiles_1",'B',"smiles_2"))))  AS "smiles_pair_uuid"
FROM   classed
LIMIT  20;
```
