     AND   q."standard_type" = s."standard_type"
),
pairs AS (                                  /* step-4: ordered pairs of DIFFERENT molecules */
    SELECT f1."activity_id"                      AS "act_id_1",
           f2."activity_id"                      AS "act_id_2",
           f1."assay_id",
           f1."standard_type",
           f1."std_val"                          AS "val_1",
           f1."rel"                              AS "rel_1",
           f1."canonical_smiles"                 AS "smiles_1",
           f2."std_val"                          AS "val_2",
           f2."rel"                              AS "rel_2",
           f2."canonical_smiles"                 AS "smiles_2",
           GREATEST(f1."heavy_atoms",f2."heavy_atoms") AS "max_heavy_atoms",
           GREATEST(f1."doc_id",f2."doc_id")           AS "max_doc_id"
    FROM   filtered f1
    JOIN   filtered f2
           ON  f1."assay_id"       = f2."assay_id"
           AND f1."standard_type"  = f2."standard_type"
           AND f1."activity_id"   < f2."activity_id"
),
classed AS (                                /* step-5: classify change */
    SELECT *,
           CASE
               WHEN "rel_1" = '=' AND "rel_2" = '=' AND "val_1" = "val_2"
                    THEN 'no-change'
               WHEN "val_1" > "val_2"  THEN 'decrease'
               WHEN "val_1" < "val_2"  THEN 'increase'
               ELSE 'no-change'
           END AS "std_change"
    FROM   pairs
)
SELECT  "act_id_1",
        "act_id_2",
        "assay_id",
        "standard_type",
        "max_heavy_atoms",
        "max_doc_id",
        "std_change",
        /* UUID derived from activity IDs */
        HEX_ENCODE(
            MD5(
                TO_JSON(
                    OBJECT_CONSTRUCT('A', "act_id_1", 'B', "act_id_2")
                )::STRING
            )
        ) AS "mmp_delta_uuid",
        /* UUID derived from canonical SMILES */
        HEX_ENCODE(
            MD5(
                TO_JSON(
                    OBJECT_CONSTRUCT('A', "smiles_1", 'B', "smiles_2")
                )::STRING
            )
        ) AS "smiles_pair_uuid"
FROM    classed
LIMIT   20;
