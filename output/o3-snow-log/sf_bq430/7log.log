```sql
--Description: 1) Quick look at the distribution of heavy–atom counts that are already
--normalised in the partitioned compound-properties table we will join later.
SELECT 
  cp."heavy_atoms"
FROM 
  EBI_CHEMBL.EBI_CHEMBL."COMPOUND_PROPERTIES_29" cp
LIMIT 20;
```

```sql
--Description: 2) Inspect activities whose pChEMBL values are reported (non-null) and
--that look large (>10).  This tells us which assays / standard_types might qualify.
SELECT 
  a."activity_id",
  a."assay_id",
  a."standard_type",
  a."standard_relation",
  a."standard_value",
  a."pchembl_value",
  a."molregno"
FROM 
  EBI_CHEMBL.EBI_CHEMBL."ACTIVITIES_29" a
WHERE 
  a."pchembl_value" IS NOT NULL
  AND TRY_TO_NUMBER(a."pchembl_value") > 10
LIMIT 20;
```

```sql
--Description: 3) Join the same activity rows to compound-properties to pick up heavy
--atom counts, so we can later filter to the 10–15 atom window.
SELECT 
  a."activity_id",
  a."assay_id",
  a."standard_type",
  a."standard_value",
  cp."heavy_atoms",
  a."molregno"
FROM 
  EBI_CHEMBL.EBI_CHEMBL."ACTIVITIES_29"        a
JOIN 
  EBI_CHEMBL.EBI_CHEMBL."COMPOUND_PROPERTIES_29" cp
    ON a."molregno" = cp."molregno"
WHERE 
  cp."heavy_atoms" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4) Bring in canonical SMILES so we can later build the MD5-based UUIDs
--required by the task specification.
SELECT 
  a."activity_id",
  cs."canonical_smiles"
FROM 
  EBI_CHEMBL.EBI_CHEMBL."ACTIVITIES_29"      a
JOIN 
  EBI_CHEMBL.EBI_CHEMBL."COMPOUND_STRUCTURES_33" cs
    ON a."molregno" = cs."molregno"
LIMIT 20;
```

```sql
--Description: 5) Count how many qualifying activity rows exist per assay & standard
--type after restricting to 10–15 heavy atoms and non-null standard values.
SELECT 
  a."assay_id",
  a."standard_type",
  COUNT(*) AS "n_activities"
FROM 
  EBI_CHEMBL.EBI_CHEMBL."ACTIVITIES_29"        a
JOIN 
  EBI_CHEMBL.EBI_CHEMBL."COMPOUND_PROPERTIES_29" cp
    ON a."molregno" = cp."molregno"
WHERE 
  TRY_TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
  AND a."standard_value" IS NOT NULL
GROUP BY 
  a."assay_id", a."standard_type"
HAVING 
  COUNT(*) < 5
LIMIT 20;
```

```sql
--Description: 6) Check for duplicate-flagged rows inside the same assay so that we can
--later keep only assays with <2 duplicate activities.
SELECT 
  a."assay_id",
  SUM(CASE WHEN a."potential_duplicate" = '1' THEN 1 ELSE 0 END) AS "dup_cnt"
FROM 
  EBI_CHEMBL.EBI_CHEMBL."ACTIVITIES_29" a
GROUP BY 
  a."assay_id"
HAVING 
  SUM(CASE WHEN a."potential_duplicate" = '1' THEN 1 ELSE 0 END) < 2
LIMIT 20;
```

```sql
--Description: 7) Produce all pairs of *different* molecules tested in exactly the same
--assay & standard_type that satisfy the heavy-atom and pChEMBL filters.  No change
--classification yet – this is to verify that such pairs actually exist.
SELECT DISTINCT
  a1."activity_id"        AS "activity_id_1",
  a2."activity_id"        AS "activity_id_2",
  a1."assay_id",
  a1."standard_type",
  a1."standard_value"     AS "std_val_1",
  a2."standard_value"     AS "std_val_2"
FROM 
  EBI_CHEMBL.EBI_CHEMBL."ACTIVITIES_29"        a1
JOIN 
  EBI_CHEMBL.EBI_CHEMBL."ACTIVITIES_29"        a2
    ON a1."assay_id"      = a2."assay_id"
   AND a1."standard_type" = a2."standard_type"
   AND a1."molregno"     <> a2."molregno"
JOIN 
  EBI_CHEMBL.EBI_CHEMBL."COMPOUND_PROPERTIES_29" cp1
    ON a1."molregno" = cp1."molregno"
JOIN 
  EBI_CHEMBL.EBI_CHEMBL."COMPOUND_PROPERTIES_29" cp2
    ON a2."molregno" = cp2."molregno"
WHERE 
  TRY_TO_NUMBER(cp1."heavy_atoms") BETWEEN 10 AND 15
  AND TRY_TO_NUMBER(cp2."heavy_atoms") BETWEEN 10 AND 15
  AND TRY_TO_NUMBER(a1."pchembl_value") > 10
  AND TRY_TO_NUMBER(a2."pchembl_value") > 10
LIMIT 20;
```

```sql
--Description: 8) Grab the highest (latest) document ID per assay among rows that pass
--all basic filters; this will later let us take “latest publication” for each pair.
SELECT 
  a."assay_id",
  MAX(TRY_TO_NUMBER(a."doc_id")) AS "max_doc_id"
FROM 
  EBI_CHEMBL.EBI_CHEMBL."ACTIVITIES_29"        a
JOIN 
  EBI_CHEMBL.EBI_CHEMBL."COMPOUND_PROPERTIES_29" cp
    ON a."molregno" = cp."molregno"
WHERE 
  TRY_TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
  AND TRY_TO_NUMBER(a."pchembl_value") > 10
GROUP BY 
  a."assay_id"
LIMIT 20;
```

```sql
--Description: 9) Explore the text relations (‘=’, ‘<’, ‘>’, etc.) so we can reliably
--classify increases vs decreases in the final step.
SELECT DISTINCT 
  a."standard_relation"
FROM 
  EBI_CHEMBL.EBI_CHEMBL."ACTIVITIES_29" a
WHERE 
  a."standard_relation" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 10) Prototype the MD5-based UUID creation exactly as the task demands
--using two *literal* activity IDs; we’ll later plug in real IDs & SMILES in place.
SELECT 
  TO_HEX(
    MD5(
      TO_JSON_STRING(
        OBJECT_CONSTRUCT('A', '12345678', 'B', '87654321')
      )
    )
  ) AS "mmp_delta_uuid_example";
```

