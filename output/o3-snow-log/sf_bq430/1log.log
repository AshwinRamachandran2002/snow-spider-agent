--Description: 7) Self-join the result of step-6 inside the same (assay, standard_type) to
--              enumerate every pair of *different* molecules (A,B).  Here we already attach
--              their standard values so that we can later label the pair as ‘increase /
--              decrease / no-change’.
SELECT  a1."activity_id"  AS "act_id_1",
        a2."activity_id"  AS "act_id_2",
        a1."assay_id",
        a1."standard_type",
        a1."standard_value" AS "value_1",
        a1."standard_relation" AS "rel_1",
        a2."standard_value" AS "value_2",
        a2."standard_relation" AS "rel_2"
FROM   (
        SELECT  *
        FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a
        WHERE   a."activity_id" IN ( /* reuse filter logic from step-6 */ 
                                     SELECT "activity_id"
                                     FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"
                                     WHERE  TRY_TO_NUMBER("pchembl_value") > 10 )
       )  a1
JOIN   (
        SELECT  *
        FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a
        WHERE   a."activity_id" IN ( /* same filter */ 
                                     SELECT "activity_id"
                                     FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"
                                     WHERE  TRY_TO_NUMBER("pchembl_value") > 10 )
       )  a2
  ON   a1."assay_id" = a2."assay_id"
 AND   a1."standard_type" = a2."standard_type"
 AND   a1."activity_id"  < a2."activity_id"
LIMIT  20;
