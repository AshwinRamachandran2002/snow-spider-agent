--Description: 6) Bring back all qualifying activities for *only* those assays discovered in
--              step-5 (fewer than five qualifying rows).  We also suppress cases where
--              the potential_duplicate flag is ≥2.
SELECT  a."activity_id",
        a."assay_id",
        a."molregno",
        a."standard_type",
        a."standard_value",
        a."standard_relation",
        a."pchembl_value",
        a."potential_duplicate"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"         a
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"   cp
      ON a."molregno" = cp."molregno"
WHERE   TRY_TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
  AND   a."pchembl_value" IS NOT NULL
  AND   TRY_TO_NUMBER(a."pchembl_value") > 10
  AND   TRY_TO_NUMBER(a."potential_duplicate") < 2
  AND   (a."assay_id", a."standard_type") IN
        (SELECT  a2."assay_id", a2."standard_type"
         FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a2
         JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp2
           ON    a2."molregno" = cp2."molregno"
         WHERE   TRY_TO_NUMBER(cp2."heavy_atoms") BETWEEN 10 AND 15
           AND   a2."pchembl_value" IS NOT NULL
           AND   TRY_TO_NUMBER(a2."pchembl_value") > 10
         GROUP BY a2."assay_id", a2."standard_type"
         HAVING  COUNT(DISTINCT a2."activity_id") < 5)
LIMIT   20;
