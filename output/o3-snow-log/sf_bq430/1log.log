Query:
--Description: 2) See a few concrete molecules whose heavy-atom counts are between 10 and 15.
--              We bring back the canonical SMILES, so later we can generate UUIDs that
--              combine activity_id and canonical_smiles.
SELECT   cs."molregno",
         cp."heavy_atoms",
         cs."canonical_smiles"
FROM     "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  cs
