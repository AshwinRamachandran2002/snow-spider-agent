Query:
--Description: 10) Assemble everything in one shot: heavy-atoms, pChEMBL, standard values,
--               potential_duplicate <2, assay having <5 eligible rows, and produce the ‘max
--               heavy atom’ + ‘highest doc_id’ per pair.  This select is a concise template
--               for the final result set (still capped at 20 rows here for exploration).
SELECT  p."act_id_1",
        p."act_id_2",
        GREATEST(h1, h2)              AS "max_heavy_atoms",
        GREATEST(d1, d2)              AS "highest_doc_id",
        v1,
        v2,
        r1,
        r2
FROM  (
        SELECT  a1."activity_id" AS "act_id_1",
                a2."activity_id" AS "act_id_2",
                TRY_TO_NUMBER(cp1."heavy_atoms") AS h1,
                TRY_TO_NUMBER(cp2."heavy_atoms") AS h2,
                TRY_TO_NUMBER(a1."pchembl_value") AS pc1,
                TRY_TO_NUMBER(a2."pchembl_value") AS pc2,
                TRY_CAST(a1."standard_value" AS FLOAT) AS v1,
                TRY_CAST(a2."standard_value" AS FLOAT) AS v2,
                a1."standard_relation" AS r1,
                a2."standard_relation" AS r2,
                TRY_TO_NUMBER(a1."doc_id") AS d1,
                TRY_TO_NUMBER(a2."doc_id") AS d2
        FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a1
        JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a2
          ON    a1."assay_id"      = a2."assay_id"
         AND    a1."standard_type" = a2."standard_type"
         AND    a1."activity_id"  < a2."activity_id"
        JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp1 ON a1."molregno" = cp1."molregno"
        JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp2 ON a2."molregno" = cp2."molregno"
        WHERE  TRY_TO_NUMBER(cp1."heavy_atoms") BETWEEN 10 AND 15
          AND  TRY_TO_NUMBER(cp2."heavy_atoms") BETWEEN 10 AND 15
          AND  TRY_TO_NUMBER(a1."pchembl_value") > 10
          AND  TRY_TO_NUMBER(a2."pchembl_value") > 10
          AND  TRY_TO_NUMBER(a1."potential_duplicate") < 2
          AND  TRY_TO_NUMBER(a2."potential_duplicate") < 2
          AND  (a1."assay_id", a1."standard_type") IN
               (SELECT  a."assay_id", a."standard_type"
                FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a
                JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
                   ON   a."molregno" = cp."molregno"
                WHERE   TRY_TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
                  AND   TRY_TO_NUMBER(a."pchembl_value") > 10
                GROUP BY a."assay_id", a."standard_type"
                HAVING  COUNT(DISTINCT a."activity_id") < 5)
     ) p
LIMIT 20;
