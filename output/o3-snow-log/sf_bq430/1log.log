```sql
--Description: 1) Inspect the range of heavy-atom counts that are already stored in the master
--              compound properties table.  This gives a feeling for how many compounds fall
--              into the 10-15 heavy-atom window that we will need later on.
SELECT DISTINCT
       "heavy_atoms"
FROM   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"
WHERE  "heavy_atoms" IS NOT NULL
LIMIT  20;
```

```sql
--Description: 2) See a few concrete molecules whose heavy-atom counts are between 10 and 15.
--              We bring back the canonical SMILES, so later we can generate UUIDs that
--              combine activity_id and canonical_smiles.
SELECT   cs."molregno",
         cp."heavy_atoms",
         cs."canonical_smiles"
FROM     "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  cs
JOIN     "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp
       ON cs."molregno" = cp."molregno"
WHERE    TRY_TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
LIMIT    20;
```

```sql
--Description: 3) Peek at activity rows (version 27) that already have a non-null pChEMBL value
--              higher than 10.0 – these are the measurements we eventually want in pairs.
SELECT  a."activity_id",
        a."assay_id",
        a."molregno",
        a."standard_type",
        a."standard_value",
        a."pchembl_value"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"  a
WHERE   a."pchembl_value" IS NOT NULL
  AND   TRY_TO_NUMBER(a."pchembl_value") > 10
LIMIT   20;
```

```sql
--Description: 4) Combine activities_27 with compound_properties so that every qualifying
--              activity now carries its heavy-atom count (10-15) together with pChEMBL>10.
SELECT  a."activity_id",
        a."assay_id",
        a."standard_type",
        cp."heavy_atoms",
        a."pchembl_value"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"         a
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"   cp
      ON a."molregno" = cp."molregno"
WHERE   TRY_TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
  AND   a."pchembl_value" IS NOT NULL
  AND   TRY_TO_NUMBER(a."pchembl_value") > 10
LIMIT   20;
```

```sql
--Description: 5) For each (assay, standard_type) pair, count how many DISTINCT activities meet
--              the heavy-atom and pChEMBL filters.  We will later keep only those assays that
--              have <5 such activities, as required by the task.
SELECT  a."assay_id",
        a."standard_type",
        COUNT(DISTINCT a."activity_id") AS "n_eligible_acts"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"         a
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"   cp
      ON a."molregno" = cp."molregno"
WHERE   TRY_TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
  AND   a."pchembl_value" IS NOT NULL
  AND   TRY_TO_NUMBER(a."pchembl_value") > 10
GROUP BY a."assay_id", a."standard_type"
HAVING  COUNT(DISTINCT a."activity_id") < 5
LIMIT   20;
```

```sql
--Description: 6) Bring back all qualifying activities for *only* those assays discovered in
--              step-5 (fewer than five qualifying rows).  We also suppress cases where
--              the potential_duplicate flag is ≥2.
SELECT  a."activity_id",
        a."assay_id",
        a."molregno",
        a."standard_type",
        a."standard_value",
        a."standard_relation",
        a."pchembl_value",
        a."potential_duplicate"
FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"         a
JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"   cp
      ON a."molregno" = cp."molregno"
WHERE   TRY_TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
  AND   a."pchembl_value" IS NOT NULL
  AND   TRY_TO_NUMBER(a."pchembl_value") > 10
  AND   TRY_TO_NUMBER(a."potential_duplicate") < 2
  AND   (a."assay_id", a."standard_type") IN
        (SELECT  a2."assay_id", a2."standard_type"
         FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a2
         JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp2
           ON    a2."molregno" = cp2."molregno"
         WHERE   TRY_TO_NUMBER(cp2."heavy_atoms") BETWEEN 10 AND 15
           AND   a2."pchembl_value" IS NOT NULL
           AND   TRY_TO_NUMBER(a2."pchembl_value") > 10
         GROUP BY a2."assay_id", a2."standard_type"
         HAVING  COUNT(DISTINCT a2."activity_id") < 5)
LIMIT   20;
```

```sql
--Description: 7) Self-join the result of step-6 inside the same (assay, standard_type) to
--              enumerate every pair of *different* molecules (A,B).  Here we already attach
--              their standard values so that we can later label the pair as ‘increase /
--              decrease / no-change’.
SELECT  a1."activity_id"  AS "act_id_1",
        a2."activity_id"  AS "act_id_2",
        a1."assay_id",
        a1."standard_type",
        a1."standard_value" AS "value_1",
        a1."standard_relation" AS "rel_1",
        a2."standard_value" AS "value_2",
        a2."standard_relation" AS "rel_2"
FROM   (
        SELECT  *
        FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a
        WHERE   a."activity_id" IN ( /* reuse filter logic from step-6 */ 
                                     SELECT "activity_id"
                                     FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"
                                     WHERE  TRY_TO_NUMBER("pchembl_value") > 10 )
       )  a1
JOIN   (
        SELECT  *
        FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a
        WHERE   a."activity_id" IN ( /* same filter */ 
                                     SELECT "activity_id"
                                     FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27"
                                     WHERE  TRY_TO_NUMBER("pchembl_value") > 10 )
       )  a2
  ON   a1."assay_id" = a2."assay_id"
 AND   a1."standard_type" = a2."standard_type"
 AND   a1."activity_id"  < a2."activity_id"
LIMIT  20;
```

```sql
--Description: 8) Attach heavy-atom counts & canonical SMILES to each side of the activity pair
--              so that we can later produce the required UUIDs.
SELECT  p."act_id_1",
        p."act_id_2",
        cs1."canonical_smiles" AS "smiles_1",
        cs2."canonical_smiles" AS "smiles_2",
        TRY_TO_NUMBER(cp1."heavy_atoms") AS "heavy_atoms_1",
        TRY_TO_NUMBER(cp2."heavy_atoms") AS "heavy_atoms_2"
FROM   (
        /* pair list created in step-7 */
        SELECT  a1."activity_id" AS "act_id_1",
                a2."activity_id" AS "act_id_2",
                a1."molregno"    AS "mol_1",
                a2."molregno"    AS "mol_2"
        FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a1
        JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a2
          ON    a1."assay_id" = a2."assay_id"
         AND    a1."standard_type" = a2."standard_type"
         AND    a1."activity_id"  < a2."activity_id"
       ) p
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp1  ON p."mol_1" = cp1."molregno"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES"  cp2  ON p."mol_2" = cp2."molregno"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  cs1  ON p."mol_1" = cs1."molregno"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_STRUCTURES"  cs2  ON p."mol_2" = cs2."molregno"
WHERE  TRY_TO_NUMBER(cp1."heavy_atoms") BETWEEN 10 AND 15
  AND  TRY_TO_NUMBER(cp2."heavy_atoms") BETWEEN 10 AND 15
LIMIT  20;
```

```sql
--Description: 9) Fetch document-level information (doc_id) for each activity in the pair.
--              We will later transform doc_id into publication date using the external
--              ranking recipe provided.
SELECT  p."act_id_1",
        p."act_id_2",
        a1."doc_id" AS "doc_id_1",
        a2."doc_id" AS "doc_id_2"
FROM   (
        SELECT  /* reuse pair definition */ 
                a."activity_id" AS "act_id_1",
                b."activity_id" AS "act_id_2"
        FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_29" a
        JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_29" b
          ON    a."assay_id" = b."assay_id"
         AND    a."standard_type" = b."standard_type"
         AND    a."activity_id" < b."activity_id"
       )  p
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_29" a1 ON p."act_id_1" = a1."activity_id"
JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_29" a2 ON p."act_id_2" = a2."activity_id"
LIMIT  20;
```

```sql
--Description: 10) Assemble everything in one shot: heavy-atoms, pChEMBL, standard values,
--               potential_duplicate <2, assay having <5 eligible rows, and produce the ‘max
--               heavy atom’ + ‘highest doc_id’ per pair.  This select is a concise template
--               for the final result set (still capped at 20 rows here for exploration).
SELECT  p."act_id_1",
        p."act_id_2",
        GREATEST(h1, h2)              AS "max_heavy_atoms",
        GREATEST(d1, d2)              AS "highest_doc_id",
        v1,
        v2,
        r1,
        r2
FROM  (
        SELECT  a1."activity_id" AS "act_id_1",
                a2."activity_id" AS "act_id_2",
                TRY_TO_NUMBER(cp1."heavy_atoms") AS h1,
                TRY_TO_NUMBER(cp2."heavy_atoms") AS h2,
                TRY_TO_NUMBER(a1."pchembl_value") AS pc1,
                TRY_TO_NUMBER(a2."pchembl_value") AS pc2,
                TRY_CAST(a1."standard_value" AS FLOAT) AS v1,
                TRY_CAST(a2."standard_value" AS FLOAT) AS v2,
                a1."standard_relation" AS r1,
                a2."standard_relation" AS r2,
                TRY_TO_NUMBER(a1."doc_id") AS d1,
                TRY_TO_NUMBER(a2."doc_id") AS d2
        FROM   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a1
        JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a2
          ON    a1."assay_id"      = a2."assay_id"
         AND    a1."standard_type" = a2."standard_type"
         AND    a1."activity_id"  < a2."activity_id"
        JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp1 ON a1."molregno" = cp1."molregno"
        JOIN   "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp2 ON a2."molregno" = cp2."molregno"
        WHERE  TRY_TO_NUMBER(cp1."heavy_atoms") BETWEEN 10 AND 15
          AND  TRY_TO_NUMBER(cp2."heavy_atoms") BETWEEN 10 AND 15
          AND  TRY_TO_NUMBER(a1."pchembl_value") > 10
          AND  TRY_TO_NUMBER(a2."pchembl_value") > 10
          AND  TRY_TO_NUMBER(a1."potential_duplicate") < 2
          AND  TRY_TO_NUMBER(a2."potential_duplicate") < 2
          AND  (a1."assay_id", a1."standard_type") IN
               (SELECT  a."assay_id", a."standard_type"
                FROM    "EBI_CHEMBL"."EBI_CHEMBL"."ACTIVITIES_27" a
                JOIN    "EBI_CHEMBL"."EBI_CHEMBL"."COMPOUND_PROPERTIES" cp
                   ON   a."molregno" = cp."molregno"
                WHERE   TRY_TO_NUMBER(cp."heavy_atoms") BETWEEN 10 AND 15
                  AND   TRY_TO_NUMBER(a."pchembl_value") > 10
                GROUP BY a."assay_id", a."standard_type"
                HAVING  COUNT(DISTINCT a."activity_id") < 5)
     ) p
LIMIT 20;
```

