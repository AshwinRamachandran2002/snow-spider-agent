{'EBI_CHEMBL': {'EBI_CHEMBL': ['ACTIVITY_PROPERTIES', 'ACTIVITY_PROPERTIES_29', 'ACTIVITY_PROPERTIES_30', 'COMPOUND_STRUCTURES_30', 'COMPOUND_STRUCTURES', 'ACTIVITIES_27', 'ACTIVITY_SUPP_28', 'ACTIVITIES_28', 'ACTIVITY_SUPP_27', 'ACTIVITIES_29', 'ACTIVITIES_26', 'ASSAY_PARAMETERS_30', 'COMPOUND_PROPERTIES', 'ACTIVITIES', 'ACTIVITIES_23', 'ACTIVITIES_25', 'ACTIVITIES_30', 'ACTIVITIES_33', 'ACTIVITY_PROPERTIES_33', 'ACTIVITIES_24', 'ACTIVITY_SUPP_24', 'ACTIVITY_SUPP_29', 'COMPOUND_STRUCTURES_26', 'COMPOUND_STRUCTURES_33', 'COMPOUND_PROPERTIES_29']}}

