        TO_HEX( MD5( TO_JSON_STRING(
                 OBJECT_CONSTRUCT('A',act_id_1,'B',act_id_2) ) ) )            AS pair_uuid ,
        TO_HEX( MD5( TO_JSON_STRING(
                 OBJECT_CONSTRUCT('activity_id',act_id_1,'smiles',smiles_1) ) ) ) AS uuid_1 ,
        TO_HEX( MD5( TO_JSON_STRING(
