LIMIT 20;
```

```sql
--Description: View 2018 records of every Wisconsin county in the natality table
SELECT *
FROM SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%WI%'
LIMIT 20;
```

```sql
--Description: Retrieve only the prenatal-weeks column for Wisconsin counties in 2018
SELECT "County_of_Residence",
       "Ave_Number_of_Prenatal_Wks"
FROM SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%WI%'
LIMIT 20;
```

```sql
--Description: Aggregate to confirm the number of Wisconsin-county rows available for 2018
SELECT COUNT(*) AS "row_cnt_2018_WI"
FROM SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%WI%';
```

```sql
--Description: Check whether Wisconsin counties are also present in the “by-mother-race” table
SELECT DISTINCT "County_of_Residence"
FROM SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY_BY_MOTHER_RACE
WHERE "County_of_Residence" ILIKE '%WI%'
LIMIT 20;
```

```sql
--Description: Show 2018 prenatal-weeks values from the “by-mother-race” table for Wisconsin counties
SELECT "County_of_Residence",
       "Ave_Number_of_Prenatal_Wks"
FROM SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY_BY_MOTHER_RACE
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%WI%'
LIMIT 20;
```

```sql
--Description: Compute the average prenatal weeks (across all races) per Wisconsin county in 2018
SELECT "County_of_Residence",
       AVG("Ave_Number_of_Prenatal_Wks") AS "avg_prenatal_wks_2018"
FROM SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY_BY_MOTHER_RACE
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%WI%'
GROUP BY "County_of_Residence"
LIMIT 20;
```

```sql
--Description: For comparison, compute the average prenatal weeks for the same counties using the overall table
SELECT "County_of_Residence",
       AVG("Ave_Number_of_Prenatal_Wks") AS "avg_prenatal_wks_2018"
FROM SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%WI%'
GROUP BY "County_of_Residence"
LIMIT 20;
```

```sql
--Description: List Wisconsin counties that appear in BOTH natality tables for 2018
SELECT DISTINCT c."County_of_Residence"
FROM SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY c
JOIN SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY_BY_MOTHER_RACE r
  ON c."County_of_Residence" = r."County_of_Residence"
WHERE c."Year" = '2018-01-01'
  AND r."Year" = '2018-01-01'
  AND c."County_of_Residence" ILIKE '%WI%'
LIMIT 20;
```

```sql
--Description: (Final step) retrieve the average prenatal weeks in 2018 for Wisconsin counties,
--keeping the structure ready for an eventual join to a 2017 commute-time table (not present here)
SELECT c."County_of_Residence",
       c."Ave_Number_of_Prenatal_Wks" AS "prenatal_wks_2018"
FROM SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY c
WHERE c."Year" = '2018-01-01'
  AND c."County_of_Residence" ILIKE '%WI%'
LIMIT 20;
```
