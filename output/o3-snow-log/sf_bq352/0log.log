```sql
/*  Average prenatal-weeks in 2018 (CDC WONDER natality) for Wisconsin counties
    where, according to the 2017 ACS commuting file, more than 5 percent of
    employed residents had a 45–59-minute trip to work.                         */

SELECT
    n."County_of_Residence",
    n."Ave_Number_of_Prenatal_Wks"   AS "Ave_Number_of_Prenatal_Wks_2018"
FROM  SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY              AS n
JOIN  SDOH.SDOH_CENSUS_ACS.COUNTY_COMMUTING_TO_WORK              AS c
      ON n."County_of_Residence" = c."County_of_Residence"
WHERE n."Year" = '2018-01-01'              -- natality year
  AND c."Year" = '2017-01-01'              -- commuting year
  AND n."County_of_Residence" ILIKE '% WI' -- Wisconsin counties
  AND c."Pct_Commute_45_59_Min" > 5        -- > 5 % with 45-59-min commute
ORDER BY n."County_of_Residence" NULLS LAST;
```
