/*  1)  Identify Wisconsin counties where more than 5 % of workers had 45-59-minute
        commutes in 2017 (American Community Survey data)                       */
WITH wi_long_commute_2017 AS (
    SELECT
        "County_FIPS",                             -- five–digit county FIPS code
        "Percent_Commute_45_59_Minutes"
    FROM "SDOH"."SDOH_CENSUS_ACS"."COUNTY_COMMUTE"
    WHERE "Year" = 2017
      AND "Percent_Commute_45_59_Minutes" > 5      -- > 5 % threshold
),

/*  2)  Pull 2018 average prenatal-weeks values for Wisconsin counties            */
wi_prenatal_2018 AS (
    SELECT
        "County_of_Residence_FIPS"  AS "County_FIPS",
        "County_of_Residence",
        "Ave_Number_of_Prenatal_Wks"
    FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"
    WHERE "Year" = '2018-01-01'
      AND "County_of_Residence" LIKE '%, WI'       -- Wisconsin counties only
)

/*  3)  Return prenatal-weeks values for the counties that satisfy the commute
        criterion                                                                  */
SELECT
    p."County_of_Residence",
    p."Ave_Number_of_Prenatal_Wks"
FROM wi_prenatal_2018 p
JOIN wi_long_commute_2017 c
  ON p."County_FIPS" = c."County_FIPS"
ORDER BY p."County_of_Residence" NULLS LAST;
```
