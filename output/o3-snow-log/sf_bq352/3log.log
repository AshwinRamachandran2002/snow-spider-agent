```sql
--Description: Inspect which reporting years are available in the county-level natality table
SELECT DISTINCT "Year"
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"
ORDER BY "Year"
LIMIT 20;
```

```sql
--Description: Look at a small sample of Wisconsin rows in the 2018 county natality file
SELECT *
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```

```sql
--Description: Retrieve the average number of prenatal weeks in 2018 for each Wisconsin county
SELECT "County_of_Residence",
       "Ave_Number_of_Prenatal_Wks"
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```

```sql
--Description: Aggregate the 2018 Wisconsin data, in case counties appear more than once
SELECT "County_of_Residence",
       AVG("Ave_Number_of_Prenatal_Wks") AS "Avg_Prenatal_Wks_2018"
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%, WI'
GROUP BY "County_of_Residence"
ORDER BY "Avg_Prenatal_Wks_2018" DESC
LIMIT 20;
```

```sql
--Description: See all county names that end with the Wisconsin postal code in the race-stratified file
SELECT DISTINCT "County_of_Residence"
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY_BY_MOTHER_RACE"
WHERE "County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```

```sql
--Description: Quickly inspect 2017 Wisconsin data in the race-stratified table
SELECT *
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY_BY_MOTHER_RACE"
WHERE "Year" = '2017-01-01'
  AND "County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```

```sql
--Description: Compare 2017 vs 2018 average prenatal weeks for Wisconsin counties in the main table
SELECT "County_of_Residence",
       "Year",
       "Ave_Number_of_Prenatal_Wks"
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"
WHERE "Year" IN ('2017-01-01','2018-01-01')
  AND "County_of_Residence" ILIKE '%, WI'
ORDER BY "County_of_Residence", "Year"
LIMIT 20;
```

```sql
--Description: Join the two natality tables to see if values differ for Wisconsin in 2018
SELECT a."County_of_Residence",
       a."Ave_Number_of_Prenatal_Wks" AS "Avg_Wks_Main",
       b."Ave_Number_of_Prenatal_Wks" AS "Avg_Wks_Race"
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"                AS a
JOIN "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY_BY_MOTHER_RACE" AS b
  ON a."County_of_Residence" = b."County_of_Residence"
  AND a."Year" = b."Year"
WHERE a."Year" = '2018-01-01'
  AND a."County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```

```sql
--Description: Pull 2018 data for Wisconsin counties that had *any* 2017 record (helps with time-based filtering later)
SELECT DISTINCT a."County_of_Residence",
       a."Ave_Number_of_Prenatal_Wks"
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY" AS a
WHERE a."Year" = '2018-01-01'
  AND a."County_of_Residence" IN (
        SELECT DISTINCT "County_of_Residence"
        FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"
        WHERE "Year" = '2017-01-01'
          AND "County_of_Residence" ILIKE '%, WI')
LIMIT 20;
```

```sql
--Description: List 2018 prenatal weeks along with a running rank for Wisconsin counties
SELECT "County_of_Residence",
       "Ave_Number_of_Prenatal_Wks",
       RANK() OVER (ORDER BY "Ave_Number_of_Prenatal_Wks" DESC) AS "Rank_by_Prenatal_Wks"
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```
