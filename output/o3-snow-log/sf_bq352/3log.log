Query:
--Description: Join the two natality tables to see if values differ for Wisconsin in 2018
SELECT a."County_of_Residence",
       a."Ave_Number_of_Prenatal_Wks" AS "Avg_Wks_Main",
       b."Ave_Number_of_Prenatal_Wks" AS "Avg_Wks_Race"
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"                AS a
JOIN "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY_BY_MOTHER_RACE" AS b
  ON a."County_of_Residence" = b."County_of_Residence"
  AND a."Year" = b."Year"
WHERE a."Year" = '2018-01-01'
  AND a."County_of_Residence" ILIKE '%, WI'
LIMIT 20;
