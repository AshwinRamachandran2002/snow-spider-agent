```sql
/* 1.  Get 2017 commute information from the ACS table that contains travel–time‐to‐work
      detail (B08303).  Keep Wisconsin counties only (state FIPS 55).                   */
WITH commute AS (
    SELECT
        "GEOID"                      AS "County_FIPS",          -- county-level FIPS
        "Estimate_Total"             AS "Workers_Total",        -- total workers
        "Estimate_45_to_59_minutes"  AS "Workers_45_59"         -- workers commuting 45-59 min
    FROM "SDOH"."SDOH_US_CENSUS_ACS"."ACS_5YR_B08303"
    WHERE "Year" = 2017
      AND "GEOID" LIKE '55%'                                   -- Wisconsin counties
),

/* 2.  Calculate the percentage of workers whose commute is 45-59 minutes.              */
commute_pct AS (
    SELECT
        "County_FIPS",
        ( "Workers_45_59" / NULLIF("Workers_Total",0) ) * 100  AS "Pct_45_59"
    FROM commute
),

/* 3.  Pull 2018 average prenatal-weeks data for Wisconsin counties.                    */
prenatal_2018 AS (
    SELECT
        "County_of_Residence",
        "County_of_Residence_FIPS",
        "Ave_Number_of_Prenatal_Wks"
    FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"
    WHERE "Year" = '2018-01-01'
      AND "County_of_Residence" ILIKE '%, WI'
)

/* 4.  Join the two datasets and retain counties where >5 % of workers had 45–59-min
      commutes in 2017, then list the 2018 average prenatal weeks.                      */
SELECT
    p."County_of_Residence",
    p."Ave_Number_of_Prenatal_Wks"
FROM prenatal_2018  AS p
JOIN commute_pct    AS c
  ON p."County_of_Residence_FIPS" = c."County_FIPS"
WHERE c."Pct_45_59" > 5
ORDER BY p."Ave_Number_of_Prenatal_Wks" DESC NULLS LAST;
```
