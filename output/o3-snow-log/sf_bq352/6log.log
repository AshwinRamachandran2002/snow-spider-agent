```sql
WITH commute_filter AS (
    /* Counties where > 5 % of workers had a 45–59-minute commute in 2017 */
    SELECT 
        "NAME"                        AS "County_of_Residence",
        "PERCENT__TRAVEL_TIME_TO_WORK__45_TO_59_MINUTES" AS "Pct_45_59"
    FROM "SDOH"."SDOH_CENSUS_ACS"."COUNTY_COMMUTE"
    WHERE "YEAR" = 2017
      AND "NAME" ILIKE '%, WI'
      AND "PERCENT__TRAVEL_TIME_TO_WORK__45_TO_59_MINUTES" > 5
)

SELECT
    n."County_of_Residence",
    n."Ave_Number_of_Prenatal_Wks"
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY" n
JOIN commute_filter c
  ON n."County_of_Residence" = c."County_of_Residence"
WHERE n."Year" = '2018-01-01'
ORDER BY n."County_of_Residence";
```
