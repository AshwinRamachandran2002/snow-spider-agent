--Description: Compare 2017 vs 2018 average prenatal weeks for Wisconsin counties in a single result to check trends
SELECT "County_of_Residence",
       MAX(CASE WHEN "Year" = '2017-01-01' THEN "Ave_Number_of_Prenatal_Wks" END) AS "Avg_Prenatal_Weeks_2017",
       MAX(CASE WHEN "Year" = '2018-01-01' THEN "Ave_Number_of_Prenatal_Wks" END) AS "Avg_Prenatal_Weeks_2018"
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"
WHERE "Year" IN ('2017-01-01','2018-01-01')
  AND "County_of_Residence" ILIKE '%, WI'
GROUP BY "County_of_Residence"
ORDER BY "County_of_Residence"
LIMIT 20;
