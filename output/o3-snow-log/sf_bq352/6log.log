```sql
--Description: Get all distinct county-of-residence names (to see how Wisconsin counties are written)
SELECT DISTINCT "County_of_Residence"
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Pull 2018 natality information for counties whose name string ends with ‘, WI’
SELECT "Year",
       "County_of_Residence",
       "Ave_Number_of_Prenatal_Wks"
FROM "SDOH"."SDOH_CDC_WONDER_NATALITY"."COUNTY_NATALITY"
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```

