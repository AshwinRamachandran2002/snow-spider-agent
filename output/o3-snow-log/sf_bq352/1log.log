```sql
--Description: Show a quick view of 2018 natality records and the average number of prenatal weeks for Wisconsin counties (pattern “%, WI”) in the general COUNTY_NATALITY table
SELECT 
  "Year",
  "County_of_Residence",
  "Ave_Number_of_Prenatal_Wks"
FROM SDOH.SDOH_CDC_WONDER_NATALITY."COUNTY_NATALITY"
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```

```sql
--Description: List distinct Wisconsin counties that appear in the 2018 COUNTY_NATALITY table
SELECT DISTINCT
  "County_of_Residence"
FROM SDOH.SDOH_CDC_WONDER_NATALITY."COUNTY_NATALITY"
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```

```sql
--Description: Retrieve the same information (2018 Wisconsin counties) from the race-specific table COUNTY_NATALITY_BY_MOTHER_RACE to compare coverage
SELECT 
  "Year",
  "County_of_Residence",
  "Ave_Number_of_Prenatal_Wks"
FROM SDOH.SDOH_CDC_WONDER_NATALITY."COUNTY_NATALITY_BY_MOTHER_RACE"
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```

```sql
--Description: Show average prenatal weeks in 2017 for Wisconsin counties to help identify any counties whose 2017 data may later be filtered by commute information
SELECT 
  "County_of_Residence",
  AVG("Ave_Number_of_Prenatal_Wks") AS "Avg_Prenatal_Wks_2017"
FROM SDOH.SDOH_CDC_WONDER_NATALITY."COUNTY_NATALITY"
WHERE "Year" = '2017-01-01'
  AND "County_of_Residence" ILIKE '%, WI'
GROUP BY "County_of_Residence"
LIMIT 20;
```

```sql
--Description: Compare 2017 vs 2018 average prenatal weeks for the same Wisconsin counties using a self-join on COUNTY_NATALITY
SELECT 
  y2017."County_of_Residence",
  y2017."Ave_Number_of_Prenatal_Wks" AS "Prenatal_Wks_2017",
  y2018."Ave_Number_of_Prenatal_Wks" AS "Prenatal_Wks_2018"
FROM SDOH.SDOH_CDC_WONDER_NATALITY."COUNTY_NATALITY" y2017
JOIN SDOH.SDOH_CDC_WONDER_NATALITY."COUNTY_NATALITY" y2018
  ON y2017."County_of_Residence" = y2018."County_of_Residence"
WHERE y2017."Year" = '2017-01-01'
  AND y2018."Year" = '2018-01-01'
  AND y2017."County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```

```sql
--Description: Provide the overall distribution of average prenatal weeks for Wisconsin counties (all years) to gauge typical values
SELECT 
  "Year",
  "Ave_Number_of_Prenatal_Wks"
FROM SDOH.SDOH_CDC_WONDER_NATALITY."COUNTY_NATALITY"
WHERE "County_of_Residence" ILIKE '%, WI'
ORDER BY "Year" DESC, "Ave_Number_of_Prenatal_Wks" DESC
LIMIT 20;
```

```sql
--Description: Extract the distinct state abbreviations in the COUNTY_NATALITY table to double-check state suffix formats
SELECT DISTINCT
  SPLIT_PART("County_of_Residence", ',', 2) AS "State_Suffix"
FROM SDOH.SDOH_CDC_WONDER_NATALITY."COUNTY_NATALITY"
LIMIT 20;
```

```sql
--Description: Identify Wisconsin counties with any natality data in 2017 or 2018 within the race-specific table
SELECT DISTINCT
  "County_of_Residence",
  TO_CHAR("Year", 'YYYY') AS "Year"
FROM SDOH.SDOH_CDC_WONDER_NATALITY."COUNTY_NATALITY_BY_MOTHER_RACE"
WHERE "Year" IN ('2017-01-01', '2018-01-01')
  AND "County_of_Residence" ILIKE '%, WI'
ORDER BY "County_of_Residence", "Year"
LIMIT 20;
```

```sql
--Description: Aggregate 2018 average prenatal weeks for each Wisconsin county (general table) – this is the target metric once commute-based filtering is available
SELECT 
  "County_of_Residence",
  AVG("Ave_Number_of_Prenatal_Wks") AS "Avg_Prenatal_Wks_2018"
FROM SDOH.SDOH_CDC_WONDER_NATALITY."COUNTY_NATALITY"
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%, WI'
GROUP BY "County_of_Residence"
ORDER BY "Avg_Prenatal_Wks_2018" DESC
LIMIT 20;
```

```sql
--Description: Return 2018 average prenatal weeks for Wisconsin counties but only for those appearing more than once (helps spot duplicate county-year entries)
SELECT 
  "County_of_Residence",
  AVG("Ave_Number_of_Prenatal_Wks") AS "Avg_Prenatal_Wks_2018",
  COUNT(*) AS "Record_Count"
FROM SDOH.SDOH_CDC_WONDER_NATALITY."COUNTY_NATALITY"
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%, WI'
GROUP BY "County_of_Residence"
HAVING COUNT(*) > 1
LIMIT 20;
```
