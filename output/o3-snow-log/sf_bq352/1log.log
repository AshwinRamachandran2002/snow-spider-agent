2025-05-07 05:49:59 - Thread-242 (execute) - INFO - [Try to run SQL in self-refine]
```sql
WITH wi_commute AS (
    /* Wisconsin counties where >5% of workers commute 45–59 minutes (2017) */
    SELECT
        "County"            -- county name, e.g. “Brown County, WI”
    FROM SDOH.SDOH_CENSUS_ACS_5YEAR."COMMUTE_BY_TRAVEL_TIME"
    WHERE "Year" = 2017
      AND "Pct_Workers_45_59_Min_Commute" > 5
      AND "County" ILIKE '%, WI'
),
wi_prenatal_2018 AS (
    /* Average number of prenatal weeks for Wisconsin counties (2018) */
    SELECT
        "County_of_Residence"  AS "County",
        AVG("Ave_Number_of_Prenatal_Wks") AS "Avg_Prenatal_Wks_2018"
    FROM SDOH.SDOH_CDC_WONDER_NATALITY."COUNTY_NATALITY"
    WHERE "Year" = '2018-01-01'
      AND "County_of_Residence" ILIKE '%, WI'
    GROUP BY "County_of_Residence"
)
SELECT
    p."County",
    p."Avg_Prenatal_Wks_2018"
FROM wi_prenatal_2018 p
JOIN wi_commute     c ON p."County" = c."County"
ORDER BY p."Avg_Prenatal_Wks_2018" DESC NULLS LAST;
```
