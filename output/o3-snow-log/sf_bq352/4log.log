```sql
/*  Step-by-step logic
    1.  From the ACS “travel-time to work” table pull Wisconsin counties whose
        2017 share of workers commuting 45-59 minutes exceeds 5 %.
        ‑  B08303_015E  = number of workers with 45–59-minute commutes
        ‑  B08303_001E  = total workers who commute
    2.  Grab 2018 average-prenatal-weeks figures for Wisconsin counties from
        CDC WONDER COUNTY_NATALITY.
    3.  Join the two lists on the county name and return the prenatal-weeks
        metric for the qualifying counties.
*/
WITH commute AS (   /* counties with >5 % 45-59-minute commuters in 2017 */
    SELECT
        "Year",
        TRIM(SPLIT_PART("Geographic_Area_Name", ',', 1))            AS county_name,      -- e.g. “Brown County”
        ("B08303_015E" / NULLIF("B08303_001E",0)) * 100             AS pct_45_59
    FROM   SDOH.SDOH_CENSUS_ACS_5YEAR.B08303_TRAVEL_TIME_TO_WORK
    WHERE  "Year"  = 2017
      AND  "State" = 'WI'                                           -- Wisconsin only
      AND  ("B08303_015E" / NULLIF("B08303_001E",0)) * 100 > 5      -- threshold >5 %
),
wi_prenatal_2018 AS (      /* 2018 prenatal-weeks for Wisconsin counties */
    SELECT
        "County_of_Residence",
        TRIM(SPLIT_PART("County_of_Residence", ',', 1)) AS county_name,
        "Ave_Number_of_Prenatal_Wks"
    FROM SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY
    WHERE "Year" = '2018-01-01'
      AND "County_of_Residence" ILIKE '%, WI'                       -- Wisconsin counties
)
SELECT
    p."County_of_Residence",
    p."Ave_Number_of_Prenatal_Wks"
FROM   wi_prenatal_2018  p
JOIN   commute           c  ON p.county_name = c.county_name
ORDER BY p."Ave_Number_of_Prenatal_Wks" DESC NULLS LAST;
```
