```sql
WITH commute_filtered AS (
    /* Counties in Wisconsin where >5% of workers had 45–59-minute commutes in 2017 */
    SELECT 
        "County_Name"       AS "County_of_Residence",
        "Pct_Commute_45_59" AS "pct_commute_45_59"
    FROM SDOH.SDOH_ACS_5YEAR.COUNTY_COMMUTING_CHARACTERISTICS
    WHERE "Year" = 2017
      AND "Pct_Commute_45_59" > 5          -- more than 5 %
      AND "County_Name" LIKE '%, WI'       -- only Wisconsin counties
)
SELECT
    n."County_of_Residence",
    ROUND(n."Ave_Number_of_Prenatal_Wks", 4) AS "Ave_Number_of_Prenatal_Wks_2018"
FROM SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY n
JOIN commute_filtered c
  ON n."County_of_Residence" = c."County_of_Residence"
WHERE n."Year" = '2018-01-01'               -- natality data for 2018
ORDER BY n."Ave_Number_of_Prenatal_Wks" DESC NULLS LAST;
```
