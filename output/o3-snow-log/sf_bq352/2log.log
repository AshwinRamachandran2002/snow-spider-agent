  ON n."County_of_Residence" = c."County_of_Residence"
WHERE n."Year" = '2018-01-01'
  AND c."Year" = '2017-01-01'
  AND c."Pct_Commute_45_59_Min" > 5
  AND n."County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```

