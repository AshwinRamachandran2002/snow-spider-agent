  AND "County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```

```sql
--Description: 7) Compute county-level averages across all maternal race groups for 2018 in Wisconsin
SELECT "County_of_Residence",
       AVG("Ave_Number_of_Prenatal_Wks")     AS "avg_prenatal_wks_by_race_2018"
FROM SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY_BY_MOTHER_RACE
WHERE "Year" = '2018-01-01'
  AND "County_of_Residence" ILIKE '%, WI'
GROUP BY "County_of_Residence"
LIMIT 20;
```

```sql
--Description: 8) Compare the two tables for 2018 Wisconsin counties by joining on county name
SELECT g."County_of_Residence",
       g."Ave_Number_of_Prenatal_Wks"                  AS "general_prenatal_wks",
       r."avg_prenatal_wks_by_race_2018"               AS "race_avg_prenatal_wks"
FROM  SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY                g
JOIN (
      SELECT "County_of_Residence",
             AVG("Ave_Number_of_Prenatal_Wks") AS "avg_prenatal_wks_by_race_2018"
      FROM   SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY_BY_MOTHER_RACE
      WHERE  "Year" = '2018-01-01'
        AND  "County_of_Residence" ILIKE '%, WI'
      GROUP BY "County_of_Residence"
     ) r
  ON g."County_of_Residence" = r."County_of_Residence"
WHERE g."Year" = '2018-01-01'
  AND g."County_of_Residence" ILIKE '%, WI'
LIMIT 20;
```

```sql
--Description: 9) (Template) If a commuting-characteristics data set becomes available, join it to filter
SELECT n."County_of_Residence",
       n."Ave_Number_of_Prenatal_Wks"
FROM SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY                        n
