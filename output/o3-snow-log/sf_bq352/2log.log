```sql
/*  Average number of prenatal weeks in 2018 for Wisconsin counties
    where >5 % of the employed population had 45-59-minute commutes in 2017  */

WITH wi_commute_2017 AS (
    SELECT
        "County_name"                 AS "County_of_Residence"
    FROM  SDOH.SDOH_CENSUS_ACS.COUNTY_COMMUTING_CHARACTERISTICS
    WHERE "Year" = 2017
      AND "County_name" ILIKE '%, WI'                 -- Wisconsin counties
      AND "Pct_Commute_45_59_Min" > 5                 -- > 5 % commuting 45-59 min
)

SELECT
    n."County_of_Residence",
    n."Ave_Number_of_Prenatal_Wks"  AS "avg_prenatal_wks_2018"
FROM  SDOH.SDOH_CDC_WONDER_NATALITY.COUNTY_NATALITY  n
JOIN  wi_commute_2017                               c
  ON  n."County_of_Residence" = c."County_of_Residence"
WHERE n."Year" = '2018-01-01'
ORDER BY n."County_of_Residence" NULLS LAST;
```
