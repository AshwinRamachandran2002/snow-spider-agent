```sql
--Description: Pull the all-ages mid-year population for Aruba in 2020 (from 1-row summary table)  
SELECT "midyear_population"
FROM "CENSUS_BUREAU_INTERNATIONAL"."CENSUS_BUREAU_INTERNATIONAL"."MIDYEAR_POPULATION"
WHERE "country_code" = 'AA'
  AND "year" = 2020
LIMIT 20;
```

```sql
--Description: Join the two tables for Aruba, showing the percentage of population under 20 in 2020  
WITH u20 AS (
    SELECT "country_code",
           SUM("midyear_population") AS "pop_under20"
    FROM "CENSUS_BUREAU_INTERNATIONAL"."CENSUS_BUREAU_INTERNATIONAL"."MIDYEAR_POPULATION_5YR_AGE_SEX"
    WHERE "year" = 2020
      AND "total_flag" = 'A'
      AND "starting_age" < 20
    GROUP BY "country_code"
)
SELECT m."country_name",
       u."pop_under20",
       m."midyear_population"      AS "total_pop",
       (u."pop_under20" / m."midyear_population") * 100 AS "pct_under20"
FROM   u20 u
JOIN   "CENSUS_BUREAU_INTERNATIONAL"."CENSUS_BUREAU_INTERNATIONAL"."MIDYEAR_POPULATION" m
       ON m."country_code" = u."country_code"
WHERE  m."year" = 2020
LIMIT 20;
```

```sql
--Description: Produce the final answer – Top-10 countries in 2020 by % of population under 20  
WITH under20 AS (
    SELECT "country_code",
           SUM("midyear_population") AS "pop_under20"
    FROM "CENSUS_BUREAU_INTERNATIONAL"."CENSUS_BUREAU_INTERNATIONAL"."MIDYEAR_POPULATION_5YR_AGE_SEX"
    WHERE "year" = 2020
      AND "total_flag" = 'A'          -- individual 5-year age groups
      AND "starting_age" < 20         -- ages 0-19
    GROUP BY "country_code"
),
totpop AS (
    SELECT "country_code",
           "country_name",
           "midyear_population" AS "total_pop"
    FROM "CENSUS_BUREAU_INTERNATIONAL"."CENSUS_BUREAU_INTERNATIONAL"."MIDYEAR_POPULATION"
    WHERE "year" = 2020
)
SELECT t."country_name",
       u."pop_under20",
       t."total_pop",
       ROUND((u."pop_under20" / t."total_pop") * 100, 2) AS "pct_under20"
FROM   under20 u
JOIN   totpop  t
       ON t."country_code" = u."country_code"
ORDER BY "pct_under20" DESC
LIMIT 10;
```
