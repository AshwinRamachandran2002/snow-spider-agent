WITH under20 AS (
    SELECT   "country_code",
             "country_name",
             SUM("population") AS "pop_under20"
    FROM CENSUS_BUREAU_INTERNATIONAL.CENSUS_BUREAU_INTERNATIONAL."MIDYEAR_POPULATION_AGESPECIFIC"
    WHERE "year" = 2020
      AND "age" < 20
    GROUP BY "country_code", "country_name"
)
SELECT  u."country_code",
        u."country_name",
        u."pop_under20",
        m."midyear_population",
        (u."pop_under20" / m."midyear_population") * 100 AS "percent_under20"
FROM       under20 u
INNER JOIN CENSUS_BUREAU_INTERNATIONAL.CENSUS_BUREAU_INTERNATIONAL."MIDYEAR_POPULATION" m
        ON u."country_code" = m."country_code"
       AND m."year" = 2020
