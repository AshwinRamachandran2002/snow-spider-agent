```sql
--Description: 3)  Count wickets per bowler, excluding dismissals not credited to the bowler (e.g. run out, retired hurt)  
SELECT wb."bowler",
       COUNT(*) AS "wickets"
FROM   IPL.IPL.WICKET_TAKEN wt
JOIN   IPL.IPL.BALL_BY_BALL wb
  ON   wb."match_id"   = wt."match_id"
 AND   wb."over_id"    = wt."over_id"
 AND   wb."ball_id"    = wt."ball_id"
 AND   wb."innings_no" = wt."innings_no"
WHERE  wt."kind_out" NOT ILIKE '%run%out%'      -- fuzzy filter to exclude run-outs
GROUP  BY wb."bowler"
ORDER BY "wickets" DESC
LIMIT 20;
```

```sql
--Description: 4)  View runs-off-the-bat delivered on every ball (BATSMAN_SCORED) along with the bowler who bowled that ball  
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."bowler",
       bs."runs_scored"
FROM   IPL.IPL.BALL_BY_BALL bb
JOIN   IPL.IPL.BATSMAN_SCORED bs
  ON   bs."match_id"   = bb."match_id"
 AND   bs."over_id"    = bb."over_id"
 AND   bs."ball_id"    = bb."ball_id"
 AND   bs."innings_no" = bb."innings_no"
LIMIT 20;
```

```sql
--Description: 5)  Aggregate total “runs off the bat” conceded by each bowler (ignoring all extras)  
SELECT bb."bowler",
       SUM(bs."runs_scored") AS "runs_off_bat"
FROM   IPL.IPL.BALL_BY_BALL bb
JOIN   IPL.IPL.BATSMAN_SCORED bs
  ON   bs."match_id"   = bb."match_id"
 AND   bs."over_id"    = bb."over_id"
 AND   bs."ball_id"    = bb."ball_id"
 AND   bs."innings_no" = bb."innings_no"
GROUP  BY bb."bowler"
ORDER  BY "runs_off_bat" DESC
LIMIT 20;
```

```sql
--Description: 6)  Calculate the number of legal balls delivered by each bowler  
SELECT "bowler",
       COUNT(*) AS "balls_bowled"
FROM   IPL.IPL.BALL_BY_BALL
GROUP  BY "bowler"
ORDER  BY "balls_bowled" DESC
LIMIT 20;
```

```sql
--Description: 7)  Combine wickets, runs conceded and balls bowled per bowler to derive Economy & Strike Rate  
WITH wickets AS (
     SELECT wb."bowler",
            COUNT(*) AS "wkts"
     FROM   IPL.IPL.WICKET_TAKEN wt
     JOIN   IPL.IPL.BALL_BY_BALL wb
       ON   wb."match_id"   = wt."match_id"
      AND   wb."over_id"    = wt."over_id"
      AND   wb."ball_id"    = wt."ball_id"
      AND   wb."innings_no" = wt."innings_no"
     WHERE  wt."kind_out" NOT ILIKE '%run%out%'
     GROUP  BY wb."bowler"
), runs AS (
     SELECT bb."bowler",
            SUM(bs."runs_scored") AS "runs"
     FROM   IPL.IPL.BALL_BY_BALL bb
     JOIN   IPL.IPL.BATSMAN_SCORED bs
       ON   bs."match_id"   = bb."match_id"
      AND   bs."over_id"    = bb."over_id"
      AND   bs."ball_id"    = bb."ball_id"
      AND   bs."innings_no" = bb."innings_no"
     GROUP  BY bb."bowler"
), balls AS (
     SELECT "bowler",
            COUNT(*) AS "balls"
     FROM   IPL.IPL.BALL_BY_BALL
     GROUP  BY "bowler"
)
SELECT b."bowler",
       r."runs",
       ba."balls",
       w."wkts",
       ROUND( (r."runs" / (ba."balls" / 6.0) ), 2) AS "economy_rate",
       ROUND( (ba."balls"::FLOAT / NULLIF(w."wkts",0)), 2) AS "strike_rate"
FROM   balls ba
JOIN   runs  r ON r."bowler" = ba."bowler"
LEFT  JOIN wickets w ON w."bowler" = ba."bowler"
ORDER  BY w."wkts" DESC NULLS LAST
LIMIT 20;
```

```sql
--Description: 8)  Find each bowler’s best (most wickets) performance in a single match (also capture runs conceded in that match)  
WITH ball_runs AS (
     SELECT bb."match_id",
            bb."bowler",
            SUM(bs."runs_scored") AS "runs_in_match"
     FROM   IPL.IPL.BALL_BY_BALL bb
     JOIN   IPL.IPL.BATSMAN_SCORED bs
       ON   bs."match_id"   = bb."match_id"
      AND   bs."over_id"    = bb."over_id"
      AND   bs."ball_id"    = bb."ball_id"
      AND   bs."innings_no" = bb."innings_no"
     GROUP  BY bb."match_id", bb."bowler"
), match_wkts AS (
     SELECT wb."match_id",
            wb."bowler",
            COUNT(*) AS "wkts_in_match"
     FROM   IPL.IPL.WICKET_TAKEN wt
     JOIN   IPL.IPL.BALL_BY_BALL wb
       ON   wb."match_id"   = wt."match_id"
      AND   wb."over_id"    = wt."over_id"
      AND   wb."ball_id"    = wt."ball_id"
      AND   wb."innings_no" = wt."innings_no"
     WHERE  wt."kind_out" NOT ILIKE '%run%out%'
     GROUP  BY wb."match_id", wb."bowler"
)
SELECT mw."bowler",
       mw."match_id",
       mw."wkts_in_match",
       br."runs_in_match",
       CONCAT(mw."wkts_in_match", '-', br."runs_in_match") AS "best_figures"
FROM   match_wkts mw
JOIN   ball_runs  br
  ON   br."match_id" = mw."match_id"
 AND   br."bowler"   = mw."bowler"
ORDER  BY mw."wkts_in_match" DESC, br."runs_in_match"
LIMIT 20;
```

```sql
--Description: 9)  Combine everything into one summary row per bowler, adding player name for readability  
WITH wickets AS (
     SELECT wb."bowler",
            COUNT(*) AS "wkts"
     FROM   IPL.IPL.WICKET_TAKEN wt
     JOIN   IPL.IPL.BALL_BY_BALL wb
       ON   wb."match_id"   = wt."match_id"
      AND   wb."over_id"    = wt."over_id"
      AND   wb."ball_id"    = wt."ball_id"
      AND   wb."innings_no" = wt."innings_no"
     WHERE  wt."kind_out" NOT ILIKE '%run%out%'
     GROUP  BY wb."bowler"
), runs AS (
     SELECT bb."bowler",
            SUM(bs."runs_scored") AS "runs"
     FROM   IPL.IPL.BALL_BY_BALL bb
     JOIN   IPL.IPL.BATSMAN_SCORED bs
       ON   bs."match_id"   = bb."match_id"
      AND   bs."over_id"    = bb."over_id"
      AND   bs."ball_id"    = bb."ball_id"
      AND   bs."innings_no" = bb."innings_no"
     GROUP  BY bb."bowler"
), balls AS (
     SELECT "bowler",
            COUNT(*) AS "balls"
     FROM   IPL.IPL.BALL_BY_BALL
     GROUP  BY "bowler"
), best AS (
     SELECT INNERQ."bowler",
            MIN_by(best_figures, order_key) AS "best_figure"   -- helper trick to get first on ordering
     FROM  (
          SELECT mw."bowler",
                 CONCAT(mw."wkts_in_match", '-', br."runs_in_match") AS best_figures,
                 ROW_NUMBER() OVER (PARTITION BY mw."bowler"
                                    ORDER BY mw."wkts_in_match" DESC,
                                             br."runs_in_match") AS order_key
          FROM (
               SELECT wb."bowler",
                      wb."match_id",
                      COUNT(*) AS "wkts_in_match"
               FROM   IPL.IPL.WICKET_TAKEN wt
               JOIN   IPL.IPL.BALL_BY_BALL wb
                 ON   wb."match_id"   = wt."match_id"
                AND   wb."over_id"    = wt."over_id"
                AND   wb."ball_id"    = wt."ball_id"
                AND   wb."innings_no" = wt."innings_no"
               WHERE  wt."kind_out" NOT ILIKE '%run%out%'
               GROUP  BY wb."bowler", wb."match_id"
          ) mw
          JOIN (
               SELECT bb."bowler",
                      bb."match_id",
                      SUM(bs."runs_scored") AS "runs_in_match"
               FROM   IPL.IPL.BALL_BY_BALL bb
               JOIN   IPL.IPL.BATSMAN_SCORED bs
                 ON   bs."match_id"   = bb."match_id"
                AND   bs."over_id"    = bb."over_id"
                AND   bs."ball_id"    = bb."ball_id"
                AND   bs."innings_no" = bb."innings_no"
               GROUP  BY bb."bowler", bb."match_id"
          ) br
            ON br."bowler" = mw."bowler"
           AND br."match_id" = mw."match_id"
     ) INNERQ
     WHERE order_key = 1
     GROUP BY INNERQ."bowler"
)
SELECT p."player_name",
       w."wkts"                         AS "total_wickets",
       ROUND( (r."runs" / (b."balls" / 6.0) ), 2) AS "economy_rate",
       ROUND( (b."balls"::FLOAT / NULLIF(w."wkts",0)), 2) AS "strike_rate",
       bst."best_figure"
FROM   balls   b
JOIN   runs    r   ON r."bowler" = b."bowler"
JOIN   wickets w   ON w."bowler" = b."bowler"
JOIN   best    bst ON bst."bowler"= b."bowler"
JOIN   IPL.IPL.PLAYER p ON p."player_id" = b."bowler"
ORDER  BY w."wkts" DESC
LIMIT 20;
```

