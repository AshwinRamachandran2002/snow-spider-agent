--Description:  Build the complete bowling-summary in one step.  
--THINKING PROCESS (embedded in comments):  
-- 1)  We need three fundamentals per bowler → balls bowled, total runs conceded off the bat, wickets credited.  
-- 2)  “wickets” CTE joins WICKET_TAKEN to BALL_BY_BALL so we know the bowler for every dismissal,  
--    excluding dismissals that are NOT credited to a bowler (any text containing “run out”).  
-- 3)  “runs”   CTE joins BALL_BY_BALL to BATSMAN_SCORED to sum only runs hit from the bat  
--    (extras such as wides/no-balls are ignored because they live in EXTRA_RUNS).  
-- 4)  “balls”  CTE simply counts how many (legal) deliveries each bowler bowled.  
-- 5)  In the final SELECT we combine the three CTEs (balls → ba, runs → r, wickets → w).  
-- 6)  Economy = runs ÷ overs, where overs = balls / 6.  
-- 7)  Strike  = balls ÷ wickets; NULLIF + COALESCE used to avoid division-by-zero & keep bowlers with 0 wickets.  
-- 8)  Sort by most wickets and show top 20 rows.  
WITH wickets AS (
    SELECT bb."bowler",
           COUNT(*) AS "wkts"
    FROM   IPL.IPL.WICKET_TAKEN wt
    JOIN   IPL.IPL.BALL_BY_BALL bb
      ON   bb."match_id"   = wt."match_id"
     AND   bb."over_id"    = wt."over_id"
     AND   bb."ball_id"    = wt."ball_id"
     AND   bb."innings_no" = wt."innings_no"
    WHERE  wt."kind_out" NOT ILIKE '%run%out%'
    GROUP  BY bb."bowler"
),
runs AS (
    SELECT bb."bowler",
           SUM(bs."runs_scored") AS "runs"
    FROM   IPL.IPL.BALL_BY_BALL bb
    JOIN   IPL.IPL.BATSMAN_SCORED bs
      ON   bs."match_id"   = bb."match_id"
     AND   bs."over_id"    = bb."over_id"
     AND   bs."ball_id"    = bb."ball_id"
     AND   bs."innings_no" = bb."innings_no"
    GROUP  BY bb."bowler"
),
balls AS (
    SELECT "bowler",
           COUNT(*) AS "balls"
    FROM   IPL.IPL.BALL_BY_BALL
    GROUP  BY "bowler"
)
SELECT ba."bowler",
       r."runs",
       ba."balls",
       COALESCE(w."wkts",0)                               AS "wkts",
       ROUND( r."runs" / (ba."balls" / 6.0), 2)           AS "economy_rate",
       ROUND( ba."balls"::FLOAT / NULLIF(w."wkts",0), 2)  AS "strike_rate"
FROM   balls   ba
JOIN   runs    r  ON r."bowler" = ba."bowler"
LEFT  JOIN wickets w ON w."bowler" = ba."bowler"
ORDER  BY COALESCE(w."wkts",0) DESC
LIMIT 20;
