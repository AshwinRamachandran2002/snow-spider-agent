--Description: 10)  Display the same comprehensive list as query #9 but limited to the 20 highest wicket-takers (wrapper query)
WITH summary AS (                                  -- reuse the logic from query #9
     WITH wickets AS (
          SELECT bb."bowler", COUNT(*) AS "wkts"
          FROM   IPL.IPL.WICKET_TAKEN wt
          JOIN   IPL.IPL.BALL_BY_BALL bb
            ON   bb."match_id"   = wt."match_id"
           AND   bb."over_id"    = wt."over_id"
           AND   bb."ball_id"    = wt."ball_id"
           AND   bb."innings_no" = wt."innings_no"
          WHERE  wt."kind_out" NOT ILIKE '%run%out%'
          GROUP  BY bb."bowler"
     ), runs AS (
          SELECT bb."bowler", SUM(bs."runs_scored") AS "runs"
          FROM   IPL.IPL.BALL_BY_BALL   bb
          JOIN   IPL.IPL.BATSMAN_SCORED bs
            ON   bs."match_id"   = bb."match_id"
           AND   bs."over_id"    = bb."over_id"
           AND   bs."ball_id"    = bb."ball_id"
           AND   bs."innings_no" = bb."innings_no"
          GROUP  BY bb."bowler"
     ), balls AS (
          SELECT "bowler", COUNT(*) AS "balls"
          FROM   IPL.IPL.BALL_BY_BALL
          GROUP  BY "bowler"
     ), best AS (
          WITH ball_runs AS (
               SELECT bb."match_id", bb."bowler",
                      SUM(bs."runs_scored") AS "runs_in_match"
               FROM   IPL.IPL.BALL_BY_BALL bb
               JOIN   IPL.IPL.BATSMAN_SCORED bs
                 ON   bs."match_id"   = bb."match_id"
                AND   bs."over_id"    = bb."over_id"
                AND   bs."ball_id"    = bb."ball_id"
                AND   bs."innings_no" = bb."innings_no"
               GROUP  BY bb."match_id", bb."bowler"
          ), match_wkts AS (
               SELECT bb."match_id", bb."bowler",
                      COUNT(*) AS "wkts_in_match"
               FROM   IPL.IPL.WICKET_TAKEN wt
               JOIN   IPL.IPL.BALL_BY_BALL bb
                 ON   bb."match_id"   = wt."match_id"
                AND   bb."over_id"    = wt."over_id"
                AND   bb."ball_id"    = wt."ball_id"
                AND   bb."innings_no" = wt."innings_no"
               WHERE  wt."kind_out" NOT ILIKE '%run%out%'
               GROUP  BY bb."match_id", bb."bowler"
          )
          SELECT mw."bowler",
                 CONCAT(mw."wkts_in_match", '-', br."runs_in_match") AS "best_figure"
          FROM   match_wkts mw
          JOIN   ball_runs  br
            ON   br."match_id" = mw."match_id"
           AND   br."bowler"   = mw."bowler"
          QUALIFY ROW_NUMBER() OVER (PARTITION BY mw."bowler"
                                     ORDER BY mw."wkts_in_match" DESC,
                                              br."runs_in_match") = 1
     )
     SELECT  p."player_name",
             w."wkts"                                           AS "total_wickets",
             ROUND( r."runs" / (b."balls" / 6.0), 2)            AS "economy_rate",
             ROUND( b."balls"::FLOAT / NULLIF(w."wkts",0), 2)   AS "strike_rate",
             bst."best_figure"
     FROM   balls   b
     JOIN   runs    r   ON r."bowler" = b."bowler"
     JOIN   wickets w   ON w."bowler" = b."bowler"
     JOIN   best    bst ON bst."bowler"= b."bowler"
     JOIN   IPL.IPL.PLAYER p ON p."player_id" = b."bowler"
)
SELECT *
FROM   summary
ORDER  BY "total_wickets" DESC
LIMIT 20;
