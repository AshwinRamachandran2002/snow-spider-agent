--Description: 8)  For every bowler determine the single match in which he took the most wickets (ignoring “run-out” etc.) and show that match’s wickets-runs figure
WITH ball_runs AS (                               -- total runs off the bat each bowler conceded in each match
     SELECT bb."match_id",
            bb."bowler",
            SUM(bs."runs_scored") AS "runs_in_match"
     FROM   IPL.IPL.BALL_BY_BALL   bb
     JOIN   IPL.IPL.BATSMAN_SCORED bs
       ON   bs."match_id"   = bb."match_id"
      AND   bs."over_id"    = bb."over_id"
      AND   bs."ball_id"    = bb."ball_id"
      AND   bs."innings_no" = bb."innings_no"
     GROUP  BY bb."match_id", bb."bowler"
), match_wkts AS (                               -- wickets credited to each bowler in each match
     SELECT bb."match_id",
            bb."bowler",
            COUNT(*) AS "wkts_in_match"
     FROM   IPL.IPL.WICKET_TAKEN wt
     JOIN   IPL.IPL.BALL_BY_BALL bb
       ON   bb."match_id"   = wt."match_id"
      AND   bb."over_id"    = wt."over_id"
      AND   bb."ball_id"    = wt."ball_id"
      AND   bb."innings_no" = wt."innings_no"
     WHERE  wt."kind_out" NOT ILIKE '%run%out%'
     GROUP  BY bb."match_id", bb."bowler"
), joined AS (                                  -- combine wickets & runs, pick best row per bowler
     SELECT mw."bowler",
            mw."match_id",
            mw."wkts_in_match",
            br."runs_in_match",
            ROW_NUMBER() OVER (PARTITION BY mw."bowler"
                               ORDER BY mw."wkts_in_match" DESC,
                                        br."runs_in_match") AS rn
     FROM   match_wkts mw
     JOIN   ball_runs  br
       ON   br."match_id" = mw."match_id"
      AND   br."bowler"   = mw."bowler"
)
SELECT  "bowler",
        "match_id",
        "wkts_in_match",
        "runs_in_match",
        CONCAT("wkts_in_match", '-', "runs_in_match") AS "best_figures"
FROM    joined
WHERE   rn = 1
ORDER BY "wkts_in_match" DESC, "runs_in_match"
LIMIT 20
