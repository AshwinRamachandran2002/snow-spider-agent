Query:
--Description: 10)  Final comprehensive view: for each bowler show total wickets,
--                economy rate, strike rate, and best bowling figures, along with
--                the player’s name.  Limited to 20 rows for inspection.
SELECT 
       p."player_name"                                    AS "bowler_name",
       agg."bowler",
       agg."total_wkts",
       ROUND( (agg."runs_off_bat" / (agg."legal_balls"/6.0) ), 2)  AS "economy",
       ROUND( (agg."legal_balls" / NULLIF(agg."total_wkts",0) ),2) AS "strike_rate",
       bb."best_figures"
FROM (
      /* wickets & basic aggregates */
      SELECT 
             wq."bowler",
             wq."total_wkts",
             rq."legal_balls",
             rq."runs_off_bat"
      FROM   ( /* wickets per bowler */ 
               SELECT 
                      b."bowler",
                      COUNT(*) AS "total_wkts"
               FROM   IPL.IPL.WICKET_TAKEN w
               JOIN   IPL.IPL.BALL_BY_BALL b
                 ON   w."match_id"  = b."match_id"
                AND   w."innings_no"= b."innings_no"
                AND   w."over_id"   = b."over_id"
                AND   w."ball_id"   = b."ball_id"
               WHERE  w."kind_out" NOT IN ('run out','retired hurt',
                                           'retired','obstructing the field')
               GROUP  BY b."bowler"
             ) wq
      JOIN  ( /* balls & runs per bowler (legal only) */
              SELECT 
                     b."bowler",
                     COUNT(*)   AS "legal_balls",
                     SUM(s."runs_scored") AS "runs_off_bat"
              FROM   IPL.IPL.BALL_BY_BALL b
              JOIN   IPL.IPL.BATSMAN_SCORED s
                ON   b."match_id"  = s."match_id"
               AND   b."innings_no"= s."innings_no"
               AND   b."over_id"   = s."over_id"
               AND   b."ball_id"   = s."ball_id"
              LEFT  JOIN IPL.IPL.EXTRA_RUNS e
                ON   b."match_id"  = e."match_id"
               AND   b."innings_no"= e."innings_no"
               AND   b."over_id"   = e."over_id"
               AND   b."ball_id"   = e."ball_id"
              WHERE  (e."extra_type" IS NULL OR e."extra_type" NOT IN ('wides','noballs'))
              GROUP  BY b."bowler"
             ) rq
        ON wq."bowler" = rq."bowler"
     ) agg
JOIN  ( /* best bowling figures from previous query (9) */ 
       SELECT * FROM ( /* same sub-query as #9 but without LIMIT */ 
                       SELECT 
                              t."bowler",
                              t."best_figures",
                              ROW_NUMBER() OVER (PARTITION BY t."bowler" ORDER BY 1) AS rnk
                       FROM (
                             /* reuse inner logic of #9 here */
                             SELECT 
                                    b."bowler",
                                    TO_CHAR(COUNT(DISTINCT CASE WHEN w."kind_out" NOT IN 
                                                                  ('run out','retired hurt',
                                                                   'retired','obstructing the field')
                                                               THEN w."ball_id" END))
                                    ||'-'||TO_CHAR(SUM(s."runs_scored")) AS "best_figures"
                             FROM   IPL.IPL.BALL_BY_BALL  b
                             LEFT  JOIN IPL.IPL.WICKET_TAKEN w
                               ON   b."match_id"  = w."match_id"
                              AND   b."innings_no"= w."innings_no"
                              AND   b."over_id"   = w."over_id"
                              AND   b."ball_id"   = w."ball_id"
                             JOIN   IPL.IPL.BATSMAN_SCORED s
                               ON   b."match_id"  = s."match_id"
                              AND   b."innings_no"= s."innings_no"
                              AND   b."over_id"   = s."over_id"
                              AND   b."ball_id"   = s."ball_id"
                             LEFT  JOIN IPL.IPL.EXTRA_RUNS e
                               ON   b."match_id"  = e."match_id"
                              AND   b."innings_no"= e."innings_no"
                              AND   b."over_id"   = e."over_id"
                              AND   b."ball_id"   = e."ball_id"
                             WHERE  (e."extra_type" IS NULL OR e."extra_type" NOT IN ('wides','noballs'))
                             GROUP  BY b."bowler", b."match_id"
                             QUALIFY ROW_NUMBER() OVER (PARTITION BY b."bowler"
                                                        ORDER BY 
                                                        COUNT(DISTINCT CASE WHEN w."kind_out" 
                                                                             NOT IN ('run out',
                                                                                     'retired hurt',
                                                                                     'retired',
                                                                                     'obstructing the field')
                                                                           THEN w."ball_id" END) DESC,
                                                        SUM(s."runs_scored")) = 1
                       ) t
                      ) sub WHERE rnk = 1
     ) bb
  ON  agg."bowler" = bb."bowler"
JOIN IPL.IPL.PLAYER p
  ON p."player_id" = agg."bowler"
ORDER BY agg."total_wkts" DESC
LIMIT 20;
