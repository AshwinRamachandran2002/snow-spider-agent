```sql
--Description: 1)  Look at every recorded mode of dismissal to identify which ones
--               are NOT credited to the bowler (e.g. run-out, retired hurt, etc.).
SELECT DISTINCT 
       "kind_out"
FROM   IPL.IPL.WICKET_TAKEN
LIMIT  20;
```

```sql
--Description: 2)  Display a sample of deliveries with the bowler id, so we know 
--               where the bowler information resides for every ball.
SELECT 
       "match_id",
       "innings_no",
       "over_id",
       "ball_id",
       "bowler",
       "team_bowling"
FROM   IPL.IPL.BALL_BY_BALL
LIMIT  20;
```

```sql
--Description: 3)  Inspect runs scored off the bat (ignoring extras) on the same
--               deliveries by joining BATSMAN_SCORED with BALL_BY_BALL.
SELECT 
       b."match_id",
       b."innings_no",
       b."over_id",
       b."ball_id",
       b."bowler",
       s."runs_scored"
FROM   IPL.IPL.BALL_BY_BALL  b
JOIN   IPL.IPL.BATSMAN_SCORED s
  ON   b."match_id"  = s."match_id"
 AND   b."innings_no"= s."innings_no"
 AND   b."over_id"   = s."over_id"
 AND   b."ball_id"   = s."ball_id"
LIMIT  20;
```

```sql
--Description: 4)  Check the different kinds of extras to later exclude wides and
--               no-balls from the runs & balls calculation.
SELECT DISTINCT 
       "extra_type"
FROM   IPL.IPL.EXTRA_RUNS
LIMIT  20;
```

```sql
--Description: 5)  Sample of deliveries that produced wides or no-balls so we can
--               later filter them out when counting legal balls bowled.
SELECT 
       e."match_id",
       e."innings_no",
       e."over_id",
       e."ball_id",
       e."extra_type",
       e."extra_runs"
FROM   IPL.IPL.EXTRA_RUNS e
WHERE  e."extra_type" ILIKE '%wide%' 
   OR  e."extra_type" ILIKE '%noball%'
LIMIT  20;
```

```sql
--Description: 6)  Join WICKET_TAKEN with BALL_BY_BALL to obtain the bowler who
--               actually got each dismissal (excluding run-outs & others).
SELECT 
       w."match_id",
       w."innings_no",
       w."over_id",
       w."ball_id",
       b."bowler",
       w."kind_out",
       w."player_out"
FROM   IPL.IPL.WICKET_TAKEN w
JOIN   IPL.IPL.BALL_BY_BALL b
  ON   w."match_id"  = b."match_id"
 AND   w."innings_no"= b."innings_no"
 AND   w."over_id"   = b."over_id"
 AND   w."ball_id"   = b."ball_id"
WHERE  w."kind_out" NOT ILIKE '%run out%'   -- still exploratory, see kinds first
LIMIT  20;
```

```sql
--Description: 7)  Aggregate: total wickets credited to each bowler (excluding
--               run-outs, retired hurt, obstructing the field, etc.).
SELECT 
       b."bowler",
       COUNT(*) AS "total_wkts"
FROM   IPL.IPL.WICKET_TAKEN w
JOIN   IPL.IPL.BALL_BY_BALL b
  ON   w."match_id"  = b."match_id"
 AND   w."innings_no"= b."innings_no"
 AND   w."over_id"   = b."over_id"
 AND   w."ball_id"   = b."ball_id"
WHERE  w."kind_out" NOT IN ('run out','retired hurt','retired','obstructing the field')
GROUP  BY b."bowler"
ORDER  BY "total_wkts" DESC
LIMIT  20;
```

```sql
--Description: 8)  Aggregate: total legal balls bowled and runs conceded off the
--               bat for every bowler (ignoring wides & no-balls in both counts).
SELECT 
       b."bowler",
       COUNT(*)                                    AS "legal_balls",
       SUM(s."runs_scored")                        AS "runs_off_bat"
FROM   IPL.IPL.BALL_BY_BALL  b
JOIN   IPL.IPL.BATSMAN_SCORED s
  ON   b."match_id"  = s."match_id"
 AND   b."innings_no"= s."innings_no"
 AND   b."over_id"   = s."over_id"
 AND   b."ball_id"   = s."ball_id"
LEFT  JOIN IPL.IPL.EXTRA_RUNS e                   -- identify wides/noballs
  ON   b."match_id"  = e."match_id"
 AND   b."innings_no"= e."innings_no"
 AND   b."over_id"   = e."over_id"
 AND   b."ball_id"   = e."ball_id"
WHERE  (e."extra_type" IS NULL                     -- keep only legal deliveries
        OR e."extra_type" NOT IN ('wides','noballs'))
GROUP  BY b."bowler"
ORDER  BY "runs_off_bat" DESC
LIMIT  20;
```

```sql
--Description: 9)  Best bowling in a single match for each bowler: wickets & runs
--               conceded (only off the bat, ignoring wides/noballs).
SELECT
       t."bowler",
       t."match_id",
       t."wkts_in_match",
       t."runs_in_match",
       TO_CHAR(t."wkts_in_match")||'-'||TO_CHAR(t."runs_in_match") AS "best_figures"
FROM (
      SELECT 
             b."bowler",
             b."match_id",
             COUNT(DISTINCT CASE WHEN w."kind_out" NOT IN ('run out','retired hurt',
                                                          'retired','obstructing the field')
                                 THEN w."ball_id" END)          AS "wkts_in_match",
             SUM(s."runs_scored")                                AS "runs_in_match",
             ROW_NUMBER() OVER (PARTITION BY b."bowler" 
                                ORDER BY COUNT(DISTINCT CASE WHEN w."kind_out" NOT IN 
                                                               ('run out','retired hurt',
                                                                'retired','obstructing the field')
                                                          THEN w."ball_id" END) DESC,
                                         SUM(s."runs_scored"))   AS rn
      FROM   IPL.IPL.BALL_BY_BALL  b
      LEFT  JOIN IPL.IPL.WICKET_TAKEN w
        ON   b."match_id"  = w."match_id"
       AND   b."innings_no"= w."innings_no"
       AND   b."over_id"   = w."over_id"
       AND   b."ball_id"   = w."ball_id"
      JOIN   IPL.IPL.BATSMAN_SCORED s
        ON   b."match_id"  = s."match_id"
       AND   b."innings_no"= s."innings_no"
       AND   b."over_id"   = s."over_id"
       AND   b."ball_id"   = s."ball_id"
      LEFT  JOIN IPL.IPL.EXTRA_RUNS e
        ON   b."match_id"  = e."match_id"
       AND   b."innings_no"= e."innings_no"
       AND   b."over_id"   = e."over_id"
       AND   b."ball_id"   = e."ball_id"
      WHERE  (e."extra_type" IS NULL OR e."extra_type" NOT IN ('wides','noballs'))
      GROUP  BY b."bowler", b."match_id"
) t
WHERE  t.rn = 1
LIMIT 20;
```

```sql
--Description: 10)  Final comprehensive view: for each bowler show total wickets,
--                economy rate, strike rate, and best bowling figures, along with
--                the player’s name.  Limited to 20 rows for inspection.
SELECT 
       p."player_name"                                    AS "bowler_name",
       agg."bowler",
       agg."total_wkts",
       ROUND( (agg."runs_off_bat" / (agg."legal_balls"/6.0) ), 2)  AS "economy",
       ROUND( (agg."legal_balls" / NULLIF(agg."total_wkts",0) ),2) AS "strike_rate",
       bb."best_figures"
FROM (
      /* wickets & basic aggregates */
      SELECT 
             wq."bowler",
             wq."total_wkts",
             rq."legal_balls",
             rq."runs_off_bat"
      FROM   ( /* wickets per bowler */ 
               SELECT 
                      b."bowler",
                      COUNT(*) AS "total_wkts"
               FROM   IPL.IPL.WICKET_TAKEN w
               JOIN   IPL.IPL.BALL_BY_BALL b
                 ON   w."match_id"  = b."match_id"
                AND   w."innings_no"= b."innings_no"
                AND   w."over_id"   = b."over_id"
                AND   w."ball_id"   = b."ball_id"
               WHERE  w."kind_out" NOT IN ('run out','retired hurt',
                                           'retired','obstructing the field')
               GROUP  BY b."bowler"
             ) wq
      JOIN  ( /* balls & runs per bowler (legal only) */
              SELECT 
                     b."bowler",
                     COUNT(*)   AS "legal_balls",
                     SUM(s."runs_scored") AS "runs_off_bat"
              FROM   IPL.IPL.BALL_BY_BALL b
              JOIN   IPL.IPL.BATSMAN_SCORED s
                ON   b."match_id"  = s."match_id"
               AND   b."innings_no"= s."innings_no"
               AND   b."over_id"   = s."over_id"
               AND   b."ball_id"   = s."ball_id"
              LEFT  JOIN IPL.IPL.EXTRA_RUNS e
                ON   b."match_id"  = e."match_id"
               AND   b."innings_no"= e."innings_no"
               AND   b."over_id"   = e."over_id"
               AND   b."ball_id"   = e."ball_id"
              WHERE  (e."extra_type" IS NULL OR e."extra_type" NOT IN ('wides','noballs'))
              GROUP  BY b."bowler"
             ) rq
        ON wq."bowler" = rq."bowler"
     ) agg
JOIN  ( /* best bowling figures from previous query (9) */ 
       SELECT * FROM ( /* same sub-query as #9 but without LIMIT */ 
                       SELECT 
                              t."bowler",
                              t."best_figures",
                              ROW_NUMBER() OVER (PARTITION BY t."bowler" ORDER BY 1) AS rnk
                       FROM (
                             /* reuse inner logic of #9 here */
                             SELECT 
                                    b."bowler",
                                    TO_CHAR(COUNT(DISTINCT CASE WHEN w."kind_out" NOT IN 
                                                                  ('run out','retired hurt',
                                                                   'retired','obstructing the field')
                                                               THEN w."ball_id" END))
                                    ||'-'||TO_CHAR(SUM(s."runs_scored")) AS "best_figures"
                             FROM   IPL.IPL.BALL_BY_BALL  b
                             LEFT  JOIN IPL.IPL.WICKET_TAKEN w
                               ON   b."match_id"  = w."match_id"
                              AND   b."innings_no"= w."innings_no"
                              AND   b."over_id"   = w."over_id"
                              AND   b."ball_id"   = w."ball_id"
                             JOIN   IPL.IPL.BATSMAN_SCORED s
                               ON   b."match_id"  = s."match_id"
                              AND   b."innings_no"= s."innings_no"
                              AND   b."over_id"   = s."over_id"
                              AND   b."ball_id"   = s."ball_id"
                             LEFT  JOIN IPL.IPL.EXTRA_RUNS e
                               ON   b."match_id"  = e."match_id"
                              AND   b."innings_no"= e."innings_no"
                              AND   b."over_id"   = e."over_id"
                              AND   b."ball_id"   = e."ball_id"
                             WHERE  (e."extra_type" IS NULL OR e."extra_type" NOT IN ('wides','noballs'))
                             GROUP  BY b."bowler", b."match_id"
                             QUALIFY ROW_NUMBER() OVER (PARTITION BY b."bowler"
                                                        ORDER BY 
                                                        COUNT(DISTINCT CASE WHEN w."kind_out" 
                                                                             NOT IN ('run out',
                                                                                     'retired hurt',
                                                                                     'retired',
                                                                                     'obstructing the field')
                                                                           THEN w."ball_id" END) DESC,
                                                        SUM(s."runs_scored")) = 1
                       ) t
                      ) sub WHERE rnk = 1
     ) bb
  ON  agg."bowler" = bb."bowler"
JOIN IPL.IPL.PLAYER p
  ON p."player_id" = agg."bowler"
ORDER BY agg."total_wkts" DESC
LIMIT 20;
```
