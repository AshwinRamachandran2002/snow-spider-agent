```sql
--Description: List every kind of dismissal recorded in WICKET_TAKEN to see which ones
--should be excluded (e.g., run-outs) from the bowler-credited wicket tally.  
SELECT DISTINCT "kind_out"
FROM IPL.IPL.WICKET_TAKEN
ORDER BY "kind_out"
LIMIT 20;
```

```sql
--Description: Combine WICKET_TAKEN with BALL_BY_BALL to view which bowler delivered
--the wicket-taking ball.  Helpful to confirm join keys (match, innings, over, ball).  
SELECT wb."match_id",
       wb."innings_no",
       wb."over_id",
       wb."ball_id",
       bb."bowler",
       wb."player_out",
       wb."kind_out"
FROM IPL.IPL.WICKET_TAKEN wb
JOIN IPL.IPL.BALL_BY_BALL bb
  ON  wb."match_id"  = bb."match_id"
 AND wb."innings_no" = bb."innings_no"
 AND wb."over_id"    = bb."over_id"
 AND wb."ball_id"    = bb."ball_id"
LIMIT 20;
```

```sql
--Description: Inspect runs scored off the bat on the same delivery by joining
--BATSMAN_SCORED with BALL_BY_BALL (no extras).  
SELECT bs."match_id",
       bs."innings_no",
       bs."over_id",
       bs."ball_id",
       bb."bowler",
       bs."runs_scored"
FROM IPL.IPL.BATSMAN_SCORED bs
JOIN IPL.IPL.BALL_BY_BALL bb
  ON  bs."match_id"  = bb."match_id"
 AND bs."innings_no" = bb."innings_no"
 AND bs."over_id"    = bb."over_id"
 AND bs."ball_id"    = bb."ball_id"
LIMIT 20;
```

```sql
--Description: Quick look at extra runs (wides, no-balls, leg-byes, etc.) so they can be
--excluded from bowler economy calculations.  
SELECT DISTINCT "extra_type",
       "extra_runs"
FROM IPL.IPL.EXTRA_RUNS
ORDER BY "extra_type"
LIMIT 20;
```

```sql
--Description: Retrieve a sample of unique bowler IDs with their names from the PLAYER
--table to make the results human-readable.  
SELECT DISTINCT p."player_id",
       p."player_name"
FROM IPL.IPL.BALL_BY_BALL bb
JOIN IPL.IPL.PLAYER      p
  ON bb."bowler" = p."player_id"
LIMIT 20;
```

```sql
--Description: Compute (sample of) total balls delivered and runs conceded by each
--bowler in a given match – foundation for economy-rate and strike-rate metrics.  
SELECT bb."match_id",
       bb."bowler",
       COUNT(*)                         AS "balls_bowled",
       SUM(bs."runs_scored")            AS "runs_off_bat"
FROM IPL.IPL.BALL_BY_BALL  bb
LEFT JOIN IPL.IPL.BATSMAN_SCORED bs
  ON  bb."match_id"  = bs."match_id"
 AND bb."innings_no" = bs."innings_no"
 AND bb."over_id"    = bs."over_id"
 AND bb."ball_id"    = bs."ball_id"
GROUP BY bb."match_id", bb."bowler"
ORDER BY bb."match_id", bb."bowler"
LIMIT 20;
```

```sql
--Description: Count bowler-credited wickets (excluding run-outs/stumpings/etc.) per
--bowler in each match.  Adjust the NOT IN set after viewing query #1 results.  
SELECT b."match_id",
       bb."bowler",
       COUNT(*) AS "wickets"
FROM IPL.IPL.WICKET_TAKEN   b
JOIN IPL.IPL.BALL_BY_BALL  bb
  ON  b."match_id"  = bb."match_id"
 AND b."innings_no" = bb."innings_no"
 AND b."over_id"    = bb."over_id"
 AND b."ball_id"    = bb."ball_id"
WHERE b."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
GROUP BY b."match_id", bb."bowler"
ORDER BY "wickets" DESC
LIMIT 20;
```

```sql
--Description: Aggregate career-level runs conceded and overs bowled to preview the
--economy rate calculation for each bowler.  
SELECT bb."bowler",
       SUM(bs."runs_scored")                    AS "runs_off_bat",
       COUNT(*)                                 AS "balls_bowled",
       ROUND( (SUM(bs."runs_scored") * 6.0) / NULLIF(COUNT(*),0), 2 ) AS "economy_rate"
FROM IPL.IPL.BALL_BY_BALL bb
LEFT JOIN IPL.IPL.BATSMAN_SCORED bs
  ON  bb."match_id"  = bs."match_id"
 AND bb."innings_no" = bs."innings_no"
 AND bb."over_id"    = bs."over_id"
 AND bb."ball_id"    = bs."ball_id"
GROUP BY bb."bowler"
ORDER BY "economy_rate"
LIMIT 20;
```

```sql
--Description: Combine balls bowled and wicket counts to preview strike-rate
--(balls per wicket) for each bowler career-wide.  
WITH wk AS (
  SELECT bb."bowler",
         COUNT(*) AS "wickets"
  FROM IPL.IPL.WICKET_TAKEN  b
  JOIN IPL.IPL.BALL_BY_BALL bb
    ON  b."match_id"  = bb."match_id"
   AND b."innings_no" = bb."innings_no"
   AND b."over_id"    = bb."over_id"
   AND b."ball_id"    = bb."ball_id"
  WHERE b."kind_out" NOT IN ('run out', 'retired hurt', 'obstructing the field')
  GROUP BY bb."bowler"
)
SELECT bb."bowler",
       COUNT(*)                                   AS "balls_bowled",
       wk."wickets",
       ROUND( COUNT(*) / NULLIF(wk."wickets",0), 2 ) AS "strike_rate"
FROM IPL.IPL.BALL_BY_BALL bb
JOIN wk
  ON bb."bowler" = wk."bowler"
GROUP BY bb."bowler", wk."wickets"
ORDER BY "strike_rate"
LIMIT 20;
```

```sql
--Description: Identify each bowler’s best match figures (most wickets, then fewest
--runs) presented as “wickets-runs”.  
WITH per_match AS (
  SELECT bb."bowler",
         bb."match_id",
         COUNT(*)                                       AS "balls",
         SUM(bs."runs_scored")                          AS "runs_off_bat",
         SUM( CASE WHEN wt."kind_out" NOT IN ('run out','retired hurt','obstructing the field')
                   THEN 1 ELSE 0 END )                  AS "wickets"
  FROM IPL.IPL.BALL_BY_BALL bb
  LEFT JOIN IPL.IPL.BATSMAN_SCORED bs
       ON bs."match_id"  = bb."match_id"
      AND bs."innings_no"= bb."innings_no"
      AND bs."over_id"   = bb."over_id"
      AND bs."ball_id"   = bb."ball_id"
  LEFT JOIN IPL.IPL.WICKET_TAKEN wt
       ON wt."match_id"  = bb."match_id"
      AND wt."innings_no"= bb."innings_no"
      AND wt."over_id"   = bb."over_id"
      AND wt."ball_id"   = bb."ball_id"
  GROUP BY bb."bowler", bb."match_id"
), ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "bowler"
                                ORDER BY "wickets" DESC,
                                         "runs_off_bat" ASC) AS rnk
  FROM per_match
)
SELECT "bowler",
       "match_id",
       "wickets"||'-'||"runs_off_bat" AS "best_figures"
FROM ranked
WHERE rnk = 1
ORDER BY "wickets" DESC, "runs_off_bat"
LIMIT 20;
```
