```sql
--Description: ① Check the different kinds of dismissals recorded so we can later exclude non-bowler wickets such as run-outs.
SELECT DISTINCT "kind_out"
FROM IPL.IPL."WICKET_TAKEN"
LIMIT 20;
```

```sql
--Description: ② See how a wicket record links to the bowler who delivered the ball (join on match/innings/over/ball).
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."bowler",
       wt."player_out",
       wt."kind_out"
FROM IPL.IPL."BALL_BY_BALL"   bb
JOIN IPL.IPL."WICKET_TAKEN"   wt
  ON  bb."match_id"  = wt."match_id"
  AND bb."innings_no"= wt."innings_no"
  AND bb."over_id"   = wt."over_id"
  AND bb."ball_id"   = wt."ball_id"
LIMIT 20;
```

```sql
--Description: ③ Inspect runs scored off the bat on each delivery together with the bowler who conceded them.
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."bowler",
       bs."runs_scored"
FROM IPL.IPL."BALL_BY_BALL"   bb
JOIN IPL.IPL."BATSMAN_SCORED" bs
  ON  bb."match_id"  = bs."match_id"
  AND bb."innings_no"= bs."innings_no"
  AND bb."over_id"   = bs."over_id"
  AND bb."ball_id"   = bs."ball_id"
LIMIT 20;
```

```sql
--Description: ④ List the different extra-run categories so we can ignore wides/no-balls when calculating economy.
SELECT DISTINCT "extra_type"
FROM IPL.IPL."EXTRA_RUNS"
LIMIT 20;
```

```sql
--Description: ⑤ Look at extra runs conceded on each ball alongside the bowler who delivered it.
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."bowler",
       er."extra_type",
       er."extra_runs"
FROM IPL.IPL."BALL_BY_BALL" bb
JOIN IPL.IPL."EXTRA_RUNS"   er
  ON  bb."match_id"  = er."match_id"
  AND bb."innings_no"= er."innings_no"
  AND bb."over_id"   = er."over_id"
  AND bb."ball_id"   = er."ball_id"
LIMIT 20;
```

```sql
--Description: ⑥ Get an idea of total balls bowled by each bowler (sample top 20 by volume).
SELECT bb."bowler",
       COUNT(*) AS "balls_bowled"
FROM IPL.IPL."BALL_BY_BALL" bb
GROUP BY bb."bowler"
ORDER BY "balls_bowled" DESC
LIMIT 20;
```

```sql
--Description: ⑦ Calculate wickets per bowler, excluding dismissals not credited to the bowler (run-out, retired hurt, etc.).
SELECT bb."bowler",
       SUM(CASE
             WHEN wt."player_out" IS NOT NULL
              AND wt."kind_out" NOT IN ('run out','retired hurt','obstructing the field')
             THEN 1 ELSE 0 END) AS "wickets"
FROM IPL.IPL."BALL_BY_BALL"  bb
LEFT JOIN IPL.IPL."WICKET_TAKEN" wt
       ON  bb."match_id"  = wt."match_id"
       AND bb."innings_no"= wt."innings_no"
       AND bb."over_id"   = wt."over_id"
       AND bb."ball_id"   = wt."ball_id"
GROUP BY bb."bowler"
LIMIT 20;
```

```sql
--Description: ⑧ Sum runs conceded off the bat (ignore extras) by each bowler in every match.
SELECT bb."bowler",
       bb."match_id",
       SUM(bs."runs_scored") AS "runs_conceded_off_bat"
FROM IPL.IPL."BALL_BY_BALL"   bb
JOIN IPL.IPL."BATSMAN_SCORED" bs
  ON  bb."match_id"  = bs."match_id"
  AND bb."innings_no"= bs."innings_no"
  AND bb."over_id"   = bs."over_id"
  AND bb."ball_id"   = bs."ball_id"
GROUP BY bb."bowler", bb."match_id"
LIMIT 20;
```

```sql
--Description: ⑨ Derive, for every bowler-match pair, wickets (credited) and runs conceded; useful for “best bowling” figures.
SELECT bb."bowler",
       bb."match_id",
       SUM(CASE
             WHEN wt."player_out" IS NOT NULL
              AND wt."kind_out" NOT IN ('run out','retired hurt','obstructing the field')
             THEN 1 ELSE 0 END) AS "wickets_in_match",
       SUM(bs."runs_scored") AS "runs_in_match"
FROM IPL.IPL."BALL_BY_BALL"   bb
LEFT JOIN IPL.IPL."WICKET_TAKEN" wt
       ON  bb."match_id"  = wt."match_id"
       AND bb."innings_no"= wt."innings_no"
       AND bb."over_id"   = wt."over_id"
       AND bb."ball_id"   = wt."ball_id"
JOIN IPL.IPL."BATSMAN_SCORED"   bs
       ON  bb."match_id"  = bs."match_id"
       AND bb."innings_no"= bs."innings_no"
       AND bb."over_id"   = bs."over_id"
       AND bb."ball_id"   = bs."ball_id"
GROUP BY bb."bowler", bb."match_id"
ORDER BY "wickets_in_match" DESC, "runs_in_match"
LIMIT 20;
```

```sql
--Description: ⑩ Bring everything together: player name with total balls, wickets, runs conceded and sample economy/strike calculations.
SELECT p."player_name",
       stats."balls_bowled",
       stats."total_wickets",
       stats."runs_conceded_off_bat",
       ROUND(stats."runs_conceded_off_bat" / (stats."balls_bowled" / 6), 2)  AS "economy_rate",
       ROUND(CASE WHEN stats."total_wickets" = 0 THEN NULL
                  ELSE stats."balls_bowled" / stats."total_wickets" END, 2)   AS "strike_rate"
FROM (
        SELECT bb."bowler"                             AS "player_id",
               COUNT(*)                                AS "balls_bowled",
               SUM(bs."runs_scored")                   AS "runs_conceded_off_bat",
               SUM(CASE
                     WHEN wt."player_out" IS NOT NULL
                      AND wt."kind_out" NOT IN ('run out','retired hurt','obstructing the field')
                     THEN 1 ELSE 0 END)               AS "total_wickets"
        FROM IPL.IPL."BALL_BY_BALL"   bb
        LEFT JOIN IPL.IPL."WICKET_TAKEN" wt
               ON  bb."match_id"  = wt."match_id"
               AND bb."innings_no"= wt."innings_no"
               AND bb."over_id"   = wt."over_id"
               AND bb."ball_id"   = wt."ball_id"
        JOIN IPL.IPL."BATSMAN_SCORED" bs
               ON  bb."match_id"  = bs."match_id"
               AND bb."innings_no"= bs."innings_no"
               AND bb."over_id"   = bs."over_id"
               AND bb."ball_id"   = bs."ball_id"
        GROUP BY bb."bowler"
     ) stats
JOIN IPL.IPL."PLAYER" p
  ON p."player_id" = stats."player_id"
ORDER BY stats."total_wickets" DESC
LIMIT 20;
```
