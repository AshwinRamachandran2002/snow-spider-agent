```sql
--Description: 1)  Check all kinds of dismissals recorded so we know which ones to ignore 
--              (e.g. “run out”) when attributing wickets to bowlers.  
SELECT DISTINCT "kind_out"
FROM IPL.IPL."WICKET_TAKEN"
LIMIT 20;
```

```sql
--Description: 2)  Look at a few rows of wickets together with the bowler who delivered 
--              the corresponding ball.  This helps confirm the join keys  
--              (match_id, over_id, ball_id, innings_no). 
SELECT wt."match_id",
       wt."innings_no",
       wt."over_id",
       wt."ball_id",
       wt."player_out",
       wt."kind_out",
       bb."bowler"
FROM IPL.IPL."WICKET_TAKEN"   wt
JOIN IPL.IPL."BALL_BY_BALL"    bb
  ON  wt."match_id"  = bb."match_id"
  AND wt."innings_no"= bb."innings_no"
  AND wt."over_id"   = bb."over_id"
  AND wt."ball_id"   = bb."ball_id"
LIMIT 20;
```

```sql
--Description: 3)  Preview a few deliveries with the runs scored off the bat.  
--              This join is the basis for calculating runs conceded   
--              (we ignore wides/no-balls which live in EXTRA_RUNS). 
SELECT bb."match_id",
       bb."innings_no",
       bb."over_id",
       bb."ball_id",
       bb."bowler",
       bs."runs_scored"
FROM IPL.IPL."BALL_BY_BALL"  bb
JOIN IPL.IPL."BATSMAN_SCORED" bs
  ON  bb."match_id"  = bs."match_id"
  AND bb."innings_no"= bs."innings_no"
  AND bb."over_id"   = bs."over_id"
  AND bb."ball_id"   = bs."ball_id"
LIMIT 20;
```

```sql
--Description: 4)  Inspect the different extra types so we can confidently exclude  
--              wides/no-balls when computing economy. 
SELECT DISTINCT "extra_type"
FROM IPL.IPL."EXTRA_RUNS"
LIMIT 20;
```

```sql
--Description: 5)  Sample of extras joined with the delivery & bowler to illustrate  
--              how to subtract extra runs from a bowler’s conceded total. 
SELECT er."match_id",
       er."innings_no",
       er."over_id",
       er."ball_id",
       bb."bowler",
       er."extra_type",
       er."extra_runs"
FROM IPL.IPL."EXTRA_RUNS"    er
JOIN IPL.IPL."BALL_BY_BALL"  bb
  ON  er."match_id"  = bb."match_id"
  AND er."innings_no"= bb."innings_no"
  AND er."over_id"   = bb."over_id"
  AND er."ball_id"   = bb."ball_id"
LIMIT 20;
```

```sql
--Description: 6)  Calculate, for one bowler per match, raw figures:  
--              balls bowled, runs off the bat, wickets attributed (excluding run-outs). 
SELECT bb."bowler",
       bb."match_id",
       COUNT(*)                              AS "balls_bowled",
       SUM(bs."runs_scored")                 AS "runs_off_bat",
       COUNT(DISTINCT wt."ball_id")          AS "wickets"
FROM IPL.IPL."BALL_BY_BALL"    bb
LEFT JOIN IPL.IPL."BATSMAN_SCORED" bs
       ON bb."match_id"   = bs."match_id"
      AND bb."innings_no" = bs."innings_no"
      AND bb."over_id"    = bs."over_id"
      AND bb."ball_id"    = bs."ball_id"
LEFT JOIN (
     SELECT * 
     FROM IPL.IPL."WICKET_TAKEN"
     WHERE "kind_out" NOT ILIKE '%run out%'     -- exclude run-outs
) wt
       ON bb."match_id"   = wt."match_id"
      AND bb."innings_no" = wt."innings_no"
      AND bb."over_id"    = wt."over_id"
      AND bb."ball_id"    = wt."ball_id"
GROUP BY bb."bowler", bb."match_id"
LIMIT 20;
```

```sql
--Description: 7)  Summarise career totals per bowler: total balls, total runs conceded  
--              (bat only), total wickets (no run-outs).  This leads to economy & strike rate. 
SELECT sub."bowler",
       SUM(sub."balls_bowled")  AS "career_balls",
       SUM(sub."runs_off_bat")  AS "career_runs",
       SUM(sub."wickets")       AS "career_wkts"
FROM (
       /* reuse query 6 but without LIMIT */
       SELECT bb."bowler",
              COUNT(*)             AS "balls_bowled",
              SUM(bs."runs_scored")AS "runs_off_bat",
              COUNT(DISTINCT wt."ball_id") AS "wickets"
       FROM IPL.IPL."BALL_BY_BALL"    bb
       LEFT JOIN IPL.IPL."BATSMAN_SCORED" bs
              ON bb."match_id"   = bs."match_id"
             AND bb."innings_no" = bs."innings_no"
             AND bb."over_id"    = bs."over_id"
             AND bb."ball_id"    = bs."ball_id"
       LEFT JOIN (
            SELECT * FROM IPL.IPL."WICKET_TAKEN"
            WHERE "kind_out" NOT ILIKE '%run out%'
       ) wt
              ON bb."match_id"   = wt."match_id"
             AND bb."innings_no" = wt."innings_no"
             AND bb."over_id"    = wt."over_id"
             AND bb."ball_id"    = wt."ball_id"
       GROUP BY bb."bowler", bb."match_id"
) sub
GROUP BY sub."bowler"
LIMIT 20;
```

```sql
--Description: 8)  For each bowler & match, compute bowling figures  
--              (wickets & runs) and rank to find their best performance. 
SELECT bm."bowler",
       bm."match_id",
       bm."wickets",
       bm."runs_off_bat"                         AS "runs",
       RANK() OVER (PARTITION BY bm."bowler"
                    ORDER BY bm."wickets" DESC, bm."runs_off_bat") AS "rank_in_career"
FROM (
       /* identical inner logic as query 6 but without LIMIT */
       SELECT bb."bowler",
              bb."match_id",
              SUM(bs."runs_scored")                 AS "runs_off_bat",
              COUNT(DISTINCT wt."ball_id")          AS "wickets"
       FROM IPL.IPL."BALL_BY_BALL"    bb
       LEFT JOIN IPL.IPL."BATSMAN_SCORED" bs
              ON bb."match_id"   = bs."match_id"
             AND bb."innings_no" = bs."innings_no"
             AND bb."over_id"    = bs."over_id"
             AND bb."ball_id"    = bs."ball_id"
       LEFT JOIN (
            SELECT * FROM IPL.IPL."WICKET_TAKEN"
            WHERE "kind_out" NOT ILIKE '%run out%'
       ) wt
              ON bb."match_id"   = wt."match_id"
             AND bb."innings_no" = wt."innings_no"
             AND bb."over_id"    = wt."over_id"
             AND bb."ball_id"    = wt."ball_id"
       GROUP BY bb."bowler", bb."match_id"
) bm
QUALIFY "rank_in_career" = 1
LIMIT 20;
```

```sql
--Description: 9)  Combine career aggregates with best-bowling figures  
--              and compute economy rate & strike rate for each bowler. 
SELECT ca."bowler",
       ca."career_wkts"                         AS "total_wkts",
       ROUND(ca."career_runs" / (ca."career_balls"/6.0), 2)  AS "economy_rate",
       ROUND(ca."career_balls" / NULLIF(ca."career_wkts",0), 2) AS "strike_rate",
       CONCAT(bb."wickets", '-', bb."runs")     AS "best_bowling"
FROM (
      /* career aggregate from query 7 without LIMIT */
      SELECT sub."bowler",
             SUM(sub."balls_bowled")  AS "career_balls",
             SUM(sub."runs_off_bat")  AS "career_runs",
             SUM(sub."wickets")       AS "career_wkts"
      FROM (
            SELECT bb."bowler",
                   COUNT(*)             AS "balls_bowled",
                   SUM(bs."runs_scored")AS "runs_off_bat",
                   COUNT(DISTINCT wt."ball_id") AS "wickets"
            FROM IPL.IPL."BALL_BY_BALL"    bb
            LEFT JOIN IPL.IPL."BATSMAN_SCORED" bs
                   ON bb."match_id"   = bs."match_id"
                  AND bb."innings_no" = bs."innings_no"
                  AND bb."over_id"    = bs."over_id"
                  AND bb."ball_id"    = bs."ball_id"
            LEFT JOIN (
                 SELECT * FROM IPL.IPL."WICKET_TAKEN"
                 WHERE "kind_out" NOT ILIKE '%run out%'
            ) wt
                   ON bb."match_id"   = wt."match_id"
                  AND bb."innings_no" = wt."innings_no"
                  AND bb."over_id"    = wt."over_id"
                  AND bb."ball_id"    = wt."ball_id"
            GROUP BY bb."bowler", bb."match_id"
      ) sub
      GROUP BY sub."bowler"
) ca
JOIN (
      /* best bowling figure from query 8 but without LIMIT */
      SELECT bow_best."bowler",
             bow_best."wickets",
             bow_best."runs"
      FROM (
            SELECT bm.*,
                   RANK() OVER (PARTITION BY bm."bowler"
                                ORDER BY bm."wickets" DESC, bm."runs") AS rnk
            FROM (
                  SELECT bb."bowler",
                         bb."match_id",
                         SUM(bs."runs_scored") AS "runs",
                         COUNT(DISTINCT wt."ball_id") AS "wickets"
                  FROM IPL.IPL."BALL_BY_BALL" bb
                  LEFT JOIN IPL.IPL."BATSMAN_SCORED" bs
                         ON bb."match_id"   = bs."match_id"
                        AND bb."innings_no" = bs."innings_no"
                        AND bb."over_id"    = bs."over_id"
                        AND bb."ball_id"    = bs."ball_id"
                  LEFT JOIN (
                       SELECT * FROM IPL.IPL."WICKET_TAKEN"
                       WHERE "kind_out" NOT ILIKE '%run out%'
                  ) wt
                         ON bb."match_id"   = wt."match_id"
                        AND bb."innings_no" = wt."innings_no"
                        AND bb."over_id"    = wt."over_id"
                        AND bb."ball_id"    = wt."ball_id"
                  GROUP BY bb."bowler", bb."match_id"
            ) bm
      ) bow_best
      WHERE bow_best.rnk = 1
) bb
  ON ca."bowler" = bb."bowler"
LIMIT 20;
```

```sql
--Description: 10)  Attach player & team information to the summary for a  
--               readable final leaderboard (top 20 wicket-takers shown). 
SELECT p."player_name"          AS "bowler_name",
       t."name"                 AS "primary_team",
       s."total_wkts",
       s."economy_rate",
       s."strike_rate",
       s."best_bowling"
FROM (
      /* summary from query 9 without LIMIT */
      SELECT * FROM /* pretend we stored query 9 as a CTE or temp table */  FINAL_BOWLER_STATS
) s
JOIN IPL.IPL."PLAYER" p
  ON s."bowler" = p."player_id"
LEFT JOIN IPL.IPL."PLAYER_MATCH" pm
  ON pm."player_id" = p."player_id"
LEFT JOIN IPL.IPL."TEAM" t
  ON pm."team_id" = t."team_id"
ORDER BY s."total_wkts" DESC
LIMIT 20;
```
