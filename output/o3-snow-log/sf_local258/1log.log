--Description:  Build a complete bowler-leaderboard in one query.
--  • match_figs   – per-match numbers (balls, runs-off-bat, valid wickets).
--  • career       – career aggregates for economy & strike rate.
--  • best_match   – each bowler’s best single match (max wickets, then fewest runs).
--  • primary_team – pick one representative team per bowler.
--  • Final        – attach PLAYER / TEAM names, calculate metrics, show top-20 wicket-takers.
WITH match_figs AS (
    SELECT  bb."bowler"                            AS bowler_id,
            bb."match_id",
            COUNT(*)                               AS balls_bowled,
            COALESCE(SUM(bs."runs_scored"),0)      AS runs_off_bat,
            COUNT(DISTINCT wt."ball_id")           AS wickets
    FROM   IPL.IPL."BALL_BY_BALL" bb
    LEFT  JOIN IPL.IPL."BATSMAN_SCORED" bs
           ON  bb."match_id"   = bs."match_id"
           AND bb."innings_no" = bs."innings_no"
           AND bb."over_id"    = bs."over_id"
           AND bb."ball_id"    = bs."ball_id"
    LEFT  JOIN (
        SELECT * FROM IPL.IPL."WICKET_TAKEN"
        WHERE "kind_out" NOT ILIKE '%run out%'
    ) wt
           ON  wt."match_id"   = bb."match_id"
           AND wt."innings_no" = bb."innings_no"
           AND wt."over_id"    = bb."over_id"
           AND wt."ball_id"    = bb."ball_id"
    GROUP BY bb."bowler", bb."match_id"
),
career AS (
    SELECT  bowler_id,
            SUM(balls_bowled)  AS career_balls,
            SUM(runs_off_bat)  AS career_runs,
            SUM(wickets)       AS career_wkts
    FROM   match_figs
    GROUP BY bowler_id
),
best_match AS (
    SELECT  bowler_id,
            wickets,
            runs_off_bat
    FROM (
        SELECT  bowler_id,
                wickets,
                runs_off_bat,
                RANK() OVER (PARTITION BY bowler_id
                             ORDER BY wickets DESC, runs_off_bat) AS rnk
        FROM   match_figs
    )
    WHERE rnk = 1
),
primary_team AS (
    SELECT  "player_id",
            MIN("team_id") AS team_id            -- pick smallest team_id as label
    FROM    IPL.IPL."PLAYER_MATCH"
    GROUP BY "player_id"
)
SELECT  pl."player_name"                                   AS "bowler_name",
        tm."name"                                          AS "primary_team",
        cr.career_wkts                                     AS "total_wkts",
        ROUND(cr.career_runs / (cr.career_balls/6.0), 2)   AS "economy_rate",
        ROUND(cr.career_balls / NULLIF(cr.career_wkts,0),2)AS "strike_rate",
        CONCAT(bm.wickets, '-', bm.runs_off_bat)           AS "best_bowling"
FROM    career        cr
JOIN    best_match    bm ON cr.bowler_id = bm.bowler_id
JOIN    IPL.IPL."PLAYER" pl ON cr.bowler_id = pl."player_id"
LEFT    JOIN primary_team pt ON pt."player_id" = pl."player_id"
LEFT    JOIN IPL.IPL."TEAM"  tm ON tm."team_id" = pt.team_id
ORDER BY "total_wkts" DESC
LIMIT 20;
```
