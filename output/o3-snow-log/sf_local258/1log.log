```sql
--Description:  End-to-end query to obtain each bowler’s career wickets, economy-rate, strike-rate
--              and best single-match bowling (wickets-runs).  Logic flow:
--   • match_figs:  join BALL_BY_BALL + BATSMAN_SCORED + WICKET_TAKEN (excluding run-outs)
--                  to compute balls, runs-off-bat, wickets for every bowler-match.
--   • career:      aggregate match_figs to bowler-career totals.
--   • best_match:  rank each bowler’s matches by (wickets DESC, runs ASC) to pick the best.
--   • primary_team: pick one representative team per bowler for display.
--   • Final SELECT: attach PLAYER and TEAM names; compute economy = runs / (balls/6),
--                   strike = balls / wickets, best_bowling = ‘wickets-runs’.
WITH match_figs AS (
    SELECT  bb."bowler",
            bb."match_id",
            COUNT(*)                                   AS balls_bowled,
            COALESCE(SUM(bs."runs_scored"),0)          AS runs_off_bat,
            COUNT(DISTINCT wt."ball_id")               AS wickets
    FROM   IPL.IPL."BALL_BY_BALL" bb
    LEFT  JOIN IPL.IPL."BATSMAN_SCORED" bs
           ON  bb."match_id"   = bs."match_id"
           AND bb."innings_no" = bs."innings_no"
           AND bb."over_id"    = bs."over_id"
           AND bb."ball_id"    = bs."ball_id"
    LEFT  JOIN (
        SELECT * FROM IPL.IPL."WICKET_TAKEN"
        WHERE "kind_out" NOT ILIKE '%run out%'
    ) wt
           ON  wt."match_id"   = bb."match_id"
           AND wt."innings_no" = bb."innings_no"
           AND wt."over_id"    = bb."over_id"
           AND wt."ball_id"    = bb."ball_id"
    GROUP BY bb."bowler", bb."match_id"
),
career AS (
    SELECT  bowler,
            SUM(balls_bowled)  AS career_balls,
            SUM(runs_off_bat)  AS career_runs,
            SUM(wickets)       AS career_wkts
    FROM   match_figs
    GROUP BY bowler
),
best_match AS (
    SELECT  bowler,
            wickets,
            runs_off_bat
    FROM (
        SELECT  bowler,
                wickets,
                runs_off_bat,
                RANK() OVER (PARTITION BY bowler
                             ORDER BY wickets DESC, runs_off_bat) AS rnk
        FROM   match_figs
    )
    WHERE rnk = 1
),
primary_team AS (
    SELECT  "player_id",
            MIN("team_id") AS team_id     -- arbitrarily pick the first team
    FROM    IPL.IPL."PLAYER_MATCH"
    GROUP BY "player_id"
)
SELECT  pl."player_name"                               AS "bowler_name",
        tm."name"                                      AS "primary_team",
        cr.career_wkts                                 AS "total_wkts",
        ROUND(cr.career_runs/(cr.career_balls/6.0),2)  AS "economy_rate",
        ROUND(cr.career_balls / NULLIF(cr.career_wkts,0),2) AS "strike_rate",
        CONCAT(bm.wickets,'-',bm.runs_off_bat)         AS "best_bowling"
FROM    career          cr
JOIN    best_match      bm ON cr.bowler = bm.bowler
JOIN    IPL.IPL."PLAYER" pl ON cr.bowler = pl."player_id"
LEFT    JOIN primary_team pt ON pt."player_id" = pl."player_id"
LEFT    JOIN IPL.IPL."TEAM"  tm ON tm."team_id" = pt.team_id
ORDER BY "total_wkts" DESC
LIMIT 20;
```
