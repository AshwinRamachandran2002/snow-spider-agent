--Description: Find each bowler’s best bowling in a single match (most wickets and corresponding runs conceded), formatted as “wickets-runs”.
WITH bowl_runs AS (
    SELECT bb."bowler",
           bb."match_id",
           SUM(bs."runs_scored") AS "runs_off_bat"
    FROM IPL.IPL.BALL_BY_BALL bb
    LEFT JOIN IPL.IPL.BATSMAN_SCORED bs
      ON bs."match_id"   = bb."match_id"
      AND bs."innings_no"= bb."innings_no"
      AND bs."over_id"   = bb."over_id"
      AND bs."ball_id"   = bb."ball_id"
    GROUP BY bb."bowler", bb."match_id"
),
bowl_wkts AS (
    SELECT b."bowler",
           w."match_id",
           COUNT(*) AS "wkts"
    FROM IPL.IPL.WICKET_TAKEN w
    JOIN IPL.IPL.BALL_BY_BALL b
      ON b."match_id"   = w."match_id"
      AND b."innings_no"= w."innings_no"
      AND b."over_id"   = w."over_id"
      AND b."ball_id"   = w."ball_id"
    WHERE w."kind_out" NOT ILIKE '%run%out%'
    GROUP BY b."bowler", w."match_id"
),
combined AS (
    SELECT w."bowler",
           w."match_id",
           w."wkts",
           r."runs_off_bat",
           TO_CHAR(w."wkts")||'-'||TO_CHAR(r."runs_off_bat") AS "best_figures"
    FROM bowl_wkts w
    JOIN bowl_runs r
      ON r."bowler" = w."bowler"
     AND r."match_id" = w."match_id"
)
SELECT c."bowler",
       c."match_id",
       c."best_figures"
FROM (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "bowler" ORDER BY "wkts" DESC, "runs_off_bat") AS rn
    FROM combined
) c
WHERE c.rn = 1
ORDER BY c."wkts" DESC
LIMIT 20;
