Query:
--Description: Derive economy rate for each bowler (runs_off_bat ÷ overs_bowled).
WITH balls AS (
    SELECT "bowler",
           COUNT(*) AS "balls_bowled"
    FROM IPL.IPL.BALL_BY_BALL
    GROUP BY "bowler"
),
runs AS (
    SELECT bb."bowler",
           SUM(bs."runs_scored") AS "runs_off_bat"
    FROM IPL.IPL.BALL_BY_BALL bb
    LEFT JOIN IPL.IPL.BATSMAN_SCORED bs
      ON  bs."match_id"   = bb."match_id"
      AND bs."innings_no" = bb."innings_no"
      AND bs."over_id"    = bb."over_id"
      AND bs."ball_id"    = bb."ball_id"
    GROUP BY bb."bowler"
)
SELECT r."bowler",
       r."runs_off_bat",
       b."balls_bowled",
       (r."runs_off_bat" / NULLIF(b."balls_bowled",0)) * 6 AS "economy_rate"
FROM runs r
JOIN balls b
  ON b."bowler" = r."bowler"
ORDER BY "economy_rate"
LIMIT 20;
