```sql
--Description: Show all types of dismissals recorded in the WICKET_TAKEN table (helps to decide which ones to exclude, e.g. “run out”).
SELECT DISTINCT "kind_out"
FROM IPL.IPL.WICKET_TAKEN
LIMIT 20;
```

```sql
--Description: Look at a sample of wickets together with the bowler who delivered the ball (joining BALL_BY_BALL on match / over / ball / innings).
SELECT w."match_id",
       w."over_id",
       w."ball_id",
       b."bowler",
       w."player_out",
       w."kind_out"
FROM IPL.IPL.WICKET_TAKEN  w
JOIN IPL.IPL.BALL_BY_BALL b
  ON  b."match_id"   = w."match_id"
  AND b."innings_no" = w."innings_no"
  AND b."over_id"    = w."over_id"
  AND b."ball_id"    = w."ball_id"
LIMIT 20;
```

```sql
--Description: Display a sample of runs scored off the bat for each delivery (BATSMAN_SCORED).
SELECT "match_id",
       "innings_no",
       "over_id",
       "ball_id",
       "runs_scored"
FROM IPL.IPL.BATSMAN_SCORED
LIMIT 20;
```

```sql
--Description: List all kinds of extras that can occur and their frequencies.
SELECT "extra_type",
       COUNT(*) AS "cnt"
FROM IPL.IPL.EXTRA_RUNS
GROUP BY "extra_type"
LIMIT 20;
```

```sql
--Description: Show combined view of one delivery with bat-runs and any extras (helps verify how to exclude extras for economy calculation).
SELECT b."match_id",
       b."innings_no",
       b."over_id",
       b."ball_id",
       bat."runs_scored"      AS "bat_runs",
       ex."extra_type",
       ex."extra_runs"
FROM IPL.IPL.BALL_BY_BALL b
LEFT JOIN IPL.IPL.BATSMAN_SCORED bat
  ON bat."match_id"   = b."match_id"
  AND bat."innings_no"= b."innings_no"
  AND bat."over_id"   = b."over_id"
  AND bat."ball_id"   = b."ball_id"
LEFT JOIN IPL.IPL.EXTRA_RUNS ex
  ON ex."match_id"    = b."match_id"
  AND ex."innings_no" = b."innings_no"
  AND ex."over_id"    = b."over_id"
  AND ex."ball_id"    = b."ball_id"
LIMIT 20;
```

```sql
--Description: Count the total number of legal balls bowled by each bowler (ignoring extras that add extra deliveries like wides/no-balls is handled later).
SELECT "bowler",
       COUNT(*) AS "balls_bowled"
FROM IPL.IPL.BALL_BY_BALL
GROUP BY "bowler"
ORDER BY "balls_bowled" DESC
LIMIT 20;
```

```sql
--Description: Calculate the total runs conceded off the bat (ignoring extras) by each bowler.
SELECT bb."bowler",
       SUM(bs."runs_scored") AS "runs_off_bat"
FROM IPL.IPL.BALL_BY_BALL  bb
LEFT JOIN IPL.IPL.BATSMAN_SCORED bs
  ON  bs."match_id"   = bb."match_id"
  AND bs."innings_no" = bb."innings_no"
  AND bs."over_id"    = bb."over_id"
  AND bs."ball_id"    = bb."ball_id"
GROUP BY bb."bowler"
ORDER BY "runs_off_bat" DESC
LIMIT 20;
```

```sql
--Description: Count dismissals credited to each bowler (exclude kinds like ‘run out’, ‘retired hurt’, etc.).
SELECT bowler_stats."bowler",
       COUNT(*) AS "wickets"
FROM (
    SELECT b."bowler"
    FROM IPL.IPL.WICKET_TAKEN w
    JOIN IPL.IPL.BALL_BY_BALL b
      ON  b."match_id"   = w."match_id"
      AND b."innings_no" = w."innings_no"
      AND b."over_id"    = w."over_id"
      AND b."ball_id"    = w."ball_id"
    WHERE w."kind_out" NOT ILIKE '%run%out%'   -- flexible filter; refine later
) bowler_stats
GROUP BY bowler_stats."bowler"
ORDER BY "wickets" DESC
LIMIT 20;
```

```sql
--Description: Derive economy rate for each bowler (runs_off_bat ÷ overs_bowled).
WITH balls AS (
    SELECT "bowler",
           COUNT(*) AS "balls_bowled"
    FROM IPL.IPL.BALL_BY_BALL
    GROUP BY "bowler"
),
runs AS (
    SELECT bb."bowler",
           SUM(bs."runs_scored") AS "runs_off_bat"
    FROM IPL.IPL.BALL_BY_BALL bb
    LEFT JOIN IPL.IPL.BATSMAN_SCORED bs
      ON  bs."match_id"   = bb."match_id"
      AND bs."innings_no" = bb."innings_no"
      AND bs."over_id"    = bb."over_id"
      AND bs."ball_id"    = bb."ball_id"
    GROUP BY bb."bowler"
)
SELECT r."bowler",
       r."runs_off_bat",
       b."balls_bowled",
       (r."runs_off_bat" / NULLIF(b."balls_bowled",0)) * 6 AS "economy_rate"
FROM runs r
JOIN balls b
  ON b."bowler" = r."bowler"
ORDER BY "economy_rate"
LIMIT 20;
```

```sql
--Description: Find each bowler’s best bowling in a single match (most wickets and corresponding runs conceded), formatted as “wickets-runs”.
WITH bowl_runs AS (
    SELECT bb."bowler",
           bb."match_id",
           SUM(bs."runs_scored") AS "runs_off_bat"
    FROM IPL.IPL.BALL_BY_BALL bb
    LEFT JOIN IPL.IPL.BATSMAN_SCORED bs
      ON bs."match_id"   = bb."match_id"
      AND bs."innings_no"= bb."innings_no"
      AND bs."over_id"   = bb."over_id"
      AND bs."ball_id"   = bb."ball_id"
    GROUP BY bb."bowler", bb."match_id"
),
bowl_wkts AS (
    SELECT b."bowler",
           w."match_id",
           COUNT(*) AS "wkts"
    FROM IPL.IPL.WICKET_TAKEN w
    JOIN IPL.IPL.BALL_BY_BALL b
      ON b."match_id"   = w."match_id"
      AND b."innings_no"= w."innings_no"
      AND b."over_id"   = w."over_id"
      AND b."ball_id"   = w."ball_id"
    WHERE w."kind_out" NOT ILIKE '%run%out%'
    GROUP BY b."bowler", w."match_id"
),
combined AS (
    SELECT w."bowler",
           w."match_id",
           w."wkts",
           r."runs_off_bat",
           TO_CHAR(w."wkts")||'-'||TO_CHAR(r."runs_off_bat") AS "best_figures"
    FROM bowl_wkts w
    JOIN bowl_runs r
      ON r."bowler" = w."bowler"
     AND r."match_id" = w."match_id"
)
SELECT c."bowler",
       c."match_id",
       c."best_figures"
FROM (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "bowler" ORDER BY "wkts" DESC, "runs_off_bat") AS rn
    FROM combined
) c
WHERE c.rn = 1
ORDER BY c."wkts" DESC
LIMIT 20;
```
