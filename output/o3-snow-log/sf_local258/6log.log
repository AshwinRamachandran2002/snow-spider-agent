Query:
--Description: Count dismissals credited to each bowler (exclude kinds like ‘run out’, ‘retired hurt’, etc.).
SELECT bowler_stats."bowler",
       COUNT(*) AS "wickets"
FROM (
    SELECT b."bowler"
    FROM IPL.IPL.WICKET_TAKEN w
    JOIN IPL.IPL.BALL_BY_BALL b
      ON  b."match_id"   = w."match_id"
      AND b."innings_no" = w."innings_no"
      AND b."over_id"    = w."over_id"
      AND b."ball_id"    = w."ball_id"
    WHERE w."kind_out" NOT ILIKE '%run%out%'   -- flexible filter; refine later
) bowler_stats
GROUP BY bowler_stats."bowler"
ORDER BY "wickets" DESC
LIMIT 20;
