--Description: 7) Combine wickets, balls, and runs together for every
-- bowler so we can compute Economy Rate and Strike Rate.
WITH r AS (
    SELECT b."bowler",
           COUNT(*)                        AS "balls_bowled",
           SUM(bs."runs_scored")           AS "runs_conceded"
    FROM IPL.IPL."BATSMAN_SCORED" bs
    JOIN IPL.IPL."BALL_BY_BALL" b
      ON  bs."match_id"   = b."match_id"
      AND bs."innings_no" = b."innings_no"
      AND bs."over_id"    = b."over_id"
      AND bs."ball_id"    = b."ball_id"
    GROUP BY b."bowler"
), w AS (
    SELECT b."bowler",
           COUNT(*) AS "wickets"
    FROM IPL.IPL."WICKET_TAKEN" w
    JOIN IPL.IPL."BALL_BY_BALL" b
      ON  w."match_id"   = b."match_id"
      AND w."innings_no" = b."innings_no"
      AND w."over_id"    = b."over_id"
      AND w."ball_id"    = b."ball_id"
    WHERE w."kind_out" NOT ILIKE '%run out%'
    GROUP BY b."bowler"
)
SELECT r."bowler",
       r."balls_bowled",
       r."runs_conceded",
       w."wickets"
FROM r
LEFT JOIN w USING ("bowler")
LIMIT 20;
