--Description: 10) Final query assembling everything: Total wickets,
-- economy, strike rate, and best bowling figure (wickets-runs) per bowler.
WITH per_ball AS (
    SELECT b."bowler",
           b."match_id",
           bs."runs_scored",
           CASE WHEN w."kind_out" NOT ILIKE '%run out%' THEN 1 ELSE 0 END AS "is_wicket"
    FROM IPL.IPL."BALL_BY_BALL" b
    LEFT JOIN IPL.IPL."BATSMAN_SCORED" bs
       ON  bs."match_id"   = b."match_id"
       AND bs."innings_no" = b."innings_no"
       AND bs."over_id"    = b."over_id"
       AND bs."ball_id"    = b."ball_id"
    LEFT JOIN IPL.IPL."WICKET_TAKEN" w
       ON  w."match_id"   = b."match_id"
       AND w."innings_no" = b."innings_no"
       AND w."over_id"    = b."over_id"
       AND w."ball_id"    = b."ball_id"
), overall AS (
    SELECT "bowler",
           COUNT(*)                          AS "balls_bowled",
           SUM("runs_scored")                AS "runs_conceded",
           SUM("is_wicket")                  AS "wickets"
    FROM per_ball
    GROUP BY "bowler"
), per_match AS (
    SELECT "bowler",
           "match_id",
           SUM("is_wicket")                  AS "wkt_in_match",
           SUM("runs_scored")                AS "runs_in_match"
    FROM per_ball
    GROUP BY "bowler", "match_id"
), best_match AS (
    SELECT p1."bowler",
           CONCAT(p1."wkt_in_match", '-', p1."runs_in_match") AS "best_fig"
    FROM per_match p1
    QUALIFY ROW_NUMBER() OVER (PARTITION BY p1."bowler"
                               ORDER BY p1."wkt_in_match" DESC,
                                        p1."runs_in_match" ASC) = 1
)
SELECT o."bowler",
       o."wickets",
       ROUND( (o."runs_conceded" / NULLIF(o."balls_bowled",0)) * 6 , 2) AS "economy_rate",
       ROUND( o."balls_bowled" / NULLIF(o."wickets",0), 2 )            AS "strike_rate",
       b."best_fig"                                                    AS "best_bowling"
FROM overall o
LEFT JOIN best_match b USING ("bowler")
ORDER BY o."wickets" DESC
LIMIT 20;
