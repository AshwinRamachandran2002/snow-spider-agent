```sql
--Description: 1) Peek at raw delivery-wise data (who bowled which ball).
SELECT *
FROM IPL.IPL."BALL_BY_BALL"
LIMIT 20;
```

```sql
--Description: 2) Find the distinct list of bowlers that ever delivered a ball in IPL data.
SELECT DISTINCT "bowler"
FROM IPL.IPL."BALL_BY_BALL"
LIMIT 20;
```

```sql
--Description: 3) Inspect all dismissal kinds so we know which ones to
-- filter out later (e.g., run-out).
SELECT DISTINCT "kind_out"
FROM IPL.IPL."WICKET_TAKEN"
LIMIT 20;
```

```sql
--Description: 4) Join WICKET_TAKEN with BALL_BY_BALL to attribute every
-- wicket to the correct bowler and show 20 sample rows.
SELECT b."bowler",
       w."player_out",
       w."kind_out",
       w."match_id",
       w."over_id",
       w."ball_id"
FROM IPL.IPL."WICKET_TAKEN" w
JOIN IPL.IPL."BALL_BY_BALL" b
  ON  w."match_id" = b."match_id"
  AND w."innings_no" = b."innings_no"
  AND w."over_id"   = b."over_id"
  AND w."ball_id"   = b."ball_id"
LIMIT 20;
```

```sql
--Description: 5) Check how many wickets each bowler has, EXCLUDING
-- dismissals that are NOT credited to the bowler such as run-out,
-- retired hurt, obstructing the field, etc.  List top 20 by wickets.
SELECT b."bowler",
       COUNT(*) AS "wickets"
FROM IPL.IPL."WICKET_TAKEN" w
JOIN IPL.IPL."BALL_BY_BALL" b
  ON  w."match_id" = b."match_id"
  AND w."innings_no" = b."innings_no"
  AND w."over_id"   = b."over_id"
  AND w."ball_id"   = b."ball_id"
WHERE w."kind_out" NOT ILIKE '%run out%'   -- keep only bowler-credited wickets
GROUP BY b."bowler"
ORDER BY "wickets" DESC
LIMIT 20;
```

```sql
--Description: 6) Attribute runs scored *off the bat* to each bowler
-- by joining BATSMAN_SCORED with BALL_BY_BALL.  Retrieve total runs
-- conceded and total balls bowled per bowler (ignoring extras).
SELECT b."bowler",
       COUNT(*)                       AS "balls_bowled",
       SUM(bs."runs_scored")          AS "runs_conceded"
FROM IPL.IPL."BATSMAN_SCORED" bs
JOIN IPL.IPL."BALL_BY_BALL" b
  ON  bs."match_id"   = b."match_id"
  AND bs."innings_no" = b."innings_no"
  AND bs."over_id"    = b."over_id"
  AND bs."ball_id"    = b."ball_id"
GROUP BY b."bowler"
ORDER BY "runs_conceded" DESC
LIMIT 20;
```

```sql
--Description: 7) Combine wickets, balls, and runs together for every
-- bowler so we can compute Economy Rate and Strike Rate.
WITH r AS (
    SELECT b."bowler",
           COUNT(*)                        AS "balls_bowled",
           SUM(bs."runs_scored")           AS "runs_conceded"
    FROM IPL.IPL."BATSMAN_SCORED" bs
    JOIN IPL.IPL."BALL_BY_BALL" b
      ON  bs."match_id"   = b."match_id"
      AND bs."innings_no" = b."innings_no"
      AND bs."over_id"    = b."over_id"
      AND bs."ball_id"    = b."ball_id"
    GROUP BY b."bowler"
), w AS (
    SELECT b."bowler",
           COUNT(*) AS "wickets"
    FROM IPL.IPL."WICKET_TAKEN" w
    JOIN IPL.IPL."BALL_BY_BALL" b
      ON  w."match_id"   = b."match_id"
      AND w."innings_no" = b."innings_no"
      AND w."over_id"    = b."over_id"
      AND w."ball_id"    = b."ball_id"
    WHERE w."kind_out" NOT ILIKE '%run out%'
    GROUP BY b."bowler"
)
SELECT r."bowler",
       r."balls_bowled",
       r."runs_conceded",
       w."wickets"
FROM r
LEFT JOIN w USING ("bowler")
LIMIT 20;
```

```sql
--Description: 8) Calculate Economy Rate and Strike Rate for each bowler.
WITH agg AS (
    SELECT r."bowler",
           r."balls_bowled",
           r."runs_conceded",
           COALESCE(w."wickets", 0) AS "wickets"
    FROM (
        SELECT b."bowler",
               COUNT(*)              AS "balls_bowled",
               SUM(bs."runs_scored") AS "runs_conceded"
        FROM IPL.IPL."BATSMAN_SCORED" bs
        JOIN IPL.IPL."BALL_BY_BALL" b
          ON  bs."match_id"   = b."match_id"
          AND bs."innings_no" = b."innings_no"
          AND bs."over_id"    = b."over_id"
          AND bs."ball_id"    = b."ball_id"
        GROUP BY b."bowler"
    ) r
    LEFT JOIN (
        SELECT b."bowler",
               COUNT(*) AS "wickets"
        FROM IPL.IPL."WICKET_TAKEN" w
        JOIN IPL.IPL."BALL_BY_BALL" b
          ON  w."match_id"   = b."match_id"
          AND w."innings_no" = b."innings_no"
          AND w."over_id"    = b."over_id"
          AND w."ball_id"    = b."ball_id"
        WHERE w."kind_out" NOT ILIKE '%run out%'
        GROUP BY b."bowler"
    ) w
    USING ("bowler")
)
SELECT a."bowler",
       a."wickets",
       a."runs_conceded",
       ROUND( (a."runs_conceded" / NULLIF(a."balls_bowled",0)) * 6 , 2) AS "economy_rate",
       ROUND( a."balls_bowled" / NULLIF(a."wickets",0) , 2)             AS "strike_rate"
FROM agg a
ORDER BY a."wickets" DESC
LIMIT 20;
```

```sql
--Description: 9) Compute each bowler’s wickets & runs conceded PER MATCH
-- to later pick the “best bowling” (most wickets, fewest runs if tie).
WITH per_ball AS (
    SELECT b."bowler",
           b."match_id",
           bs."runs_scored",
           CASE WHEN w."kind_out" NOT ILIKE '%run out%' THEN 1 ELSE 0 END AS "is_wicket"
    FROM IPL.IPL."BALL_BY_BALL" b
    LEFT JOIN IPL.IPL."BATSMAN_SCORED" bs
       ON  bs."match_id"   = b."match_id"
       AND bs."innings_no" = b."innings_no"
       AND bs."over_id"    = b."over_id"
       AND bs."ball_id"    = b."ball_id"
    LEFT JOIN IPL.IPL."WICKET_TAKEN" w
       ON  w."match_id"   = b."match_id"
       AND w."innings_no" = b."innings_no"
       AND w."over_id"    = b."over_id"
       AND w."ball_id"    = b."ball_id"
)
SELECT "bowler",
       "match_id",
       SUM("is_wicket")            AS "wkts",
       SUM("runs_scored")          AS "runs"
FROM per_ball
GROUP BY "bowler", "match_id"
HAVING SUM("is_wicket") > 0
ORDER BY "wkts" DESC, "runs" ASC
LIMIT 20;
```

```sql
--Description: 10) Final query assembling everything: Total wickets,
-- economy, strike rate, and best bowling figure (wickets-runs) per bowler.
WITH per_ball AS (
    SELECT b."bowler",
           b."match_id",
           bs."runs_scored",
           CASE WHEN w."kind_out" NOT ILIKE '%run out%' THEN 1 ELSE 0 END AS "is_wicket"
    FROM IPL.IPL."BALL_BY_BALL" b
    LEFT JOIN IPL.IPL."BATSMAN_SCORED" bs
       ON  bs."match_id"   = b."match_id"
       AND bs."innings_no" = b."innings_no"
       AND bs."over_id"    = b."over_id"
       AND bs."ball_id"    = b."ball_id"
    LEFT JOIN IPL.IPL."WICKET_TAKEN" w
       ON  w."match_id"   = b."match_id"
       AND w."innings_no" = b."innings_no"
       AND w."over_id"    = b."over_id"
       AND w."ball_id"    = b."ball_id"
), overall AS (
    SELECT "bowler",
           COUNT(*)                          AS "balls_bowled",
           SUM("runs_scored")                AS "runs_conceded",
           SUM("is_wicket")                  AS "wickets"
    FROM per_ball
    GROUP BY "bowler"
), per_match AS (
    SELECT "bowler",
           "match_id",
           SUM("is_wicket")                  AS "wkt_in_match",
           SUM("runs_scored")                AS "runs_in_match"
    FROM per_ball
    GROUP BY "bowler", "match_id"
), best_match AS (
    SELECT p1."bowler",
           CONCAT(p1."wkt_in_match", '-', p1."runs_in_match") AS "best_fig"
    FROM per_match p1
    QUALIFY ROW_NUMBER() OVER (PARTITION BY p1."bowler"
                               ORDER BY p1."wkt_in_match" DESC,
                                        p1."runs_in_match" ASC) = 1
)
SELECT o."bowler",
       o."wickets",
       ROUND( (o."runs_conceded" / NULLIF(o."balls_bowled",0)) * 6 , 2) AS "economy_rate",
       ROUND( o."balls_bowled" / NULLIF(o."wickets",0), 2 )            AS "strike_rate",
       b."best_fig"                                                    AS "best_bowling"
FROM overall o
LEFT JOIN best_match b USING ("bowler")
ORDER BY o."wickets" DESC
LIMIT 20;
```
