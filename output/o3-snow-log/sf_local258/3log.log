--Description: 8) Count the total balls bowled by each bowler (every recorded delivery).
--              This will feed into both strike-rate (balls per wicket) and overs.
SELECT   bb."bowler"   AS "bowler_id",
         COUNT(*)      AS "balls_bowled"
FROM     IPL.IPL."BALL_BY_BALL" bb
GROUP BY bb."bowler"
ORDER BY "balls_bowled" DESC
LIMIT    20;
