```sql
--Description: 1) Look at the various kinds of dismissals recorded so we know which ones
--              should be excluded (e.g. run-out, retired hurt, etc.) when counting a
--              bowler’s wickets.
SELECT DISTINCT 
       "kind_out"
FROM   IPL.IPL."WICKET_TAKEN"
LIMIT  20;
```

```sql
--Description: 2) Bring together every dismissal with the bowler who delivered the ball
--              (match_id+over_id+ball_id uniquely identifies each delivery).
--              This tells us which wickets are attributable to which bowler.
SELECT wt."match_id",
       wt."over_id",
       wt."ball_id",
       wt."player_out",
       wt."kind_out",
       bb."bowler"
FROM   IPL.IPL."WICKET_TAKEN" wt
JOIN   IPL.IPL."BALL_BY_BALL"  bb
  ON   wt."match_id" = bb."match_id"
 AND   wt."over_id"  = bb."over_id"
 AND   wt."ball_id"  = bb."ball_id"
LIMIT  20;
```

```sql
--Description: 3) Check what a single ball record looks like when we join the runs scored
--              off the bat to the delivery information; this will later help us in
--              computing runs conceded (ignoring extras).
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."bowler",
       bs."runs_scored",
       bb."team_batting",
       bb."team_bowling"
FROM   IPL.IPL."BALL_BY_BALL"    bb
JOIN   IPL.IPL."BATSMAN_SCORED"  bs
  ON   bb."match_id" = bs."match_id"
 AND   bb."over_id"  = bs."over_id"
 AND   bb."ball_id"  = bs."ball_id"
LIMIT  20;
```

```sql
--Description: 4) Inspect any extra runs (wides, no-balls, leg byes, etc.) on a delivery.
--              We'll exclude these when calculating economy rate.
SELECT er."match_id",
       er."over_id",
       er."ball_id",
       er."extra_type",
       er."extra_runs"
FROM   IPL.IPL."EXTRA_RUNS" er
LIMIT  20;
```

```sql
--Description: 5) Retrieve bowlers’ basic profile (ID, name, bowling skill) to attach
--              human-readable names to our statistics later.
SELECT DISTINCT 
       p."player_id",
       p."player_name",
       p."bowling_skill"
FROM   IPL.IPL."PLAYER" p
WHERE  p."bowling_skill" IS NOT NULL
LIMIT  20;
```

```sql
--Description: 6) First-cut aggregation – count how many wickets (excluding run-outs) a
--              bowler has taken overall.
SELECT   bb."bowler"           AS "bowler_id",
         COUNT(*)              AS "total_wickets"
FROM     IPL.IPL."WICKET_TAKEN" wt
JOIN     IPL.IPL."BALL_BY_BALL" bb
       ON wt."match_id" = bb."match_id"
      AND wt."over_id"  = bb."over_id"
      AND wt."ball_id"  = bb."ball_id"
WHERE    wt."kind_out" NOT ILIKE '%run%'      -- exclude run-outs
GROUP BY bb."bowler"
ORDER BY "total_wickets" DESC
LIMIT    20;
```

```sql
--Description: 7) Aggregate runs conceded off the bat by each bowler (ignoring extras).
SELECT   bb."bowler"           AS "bowler_id",
         SUM(bs."runs_scored") AS "runs_conceded_off_bat"
FROM     IPL.IPL."BALL_BY_BALL"   bb
LEFT JOIN IPL.IPL."BATSMAN_SCORED" bs
       ON bb."match_id" = bs."match_id"
      AND bb."over_id"  = bs."over_id"
      AND bb."ball_id"  = bs."ball_id"
GROUP BY bb."bowler"
ORDER BY "runs_conceded_off_bat" DESC
LIMIT    20;
```

```sql
--Description: 8) Count the total balls bowled by each bowler (every recorded delivery).
--              This will feed into both strike-rate (balls per wicket) and overs.
SELECT   bb."bowler"   AS "bowler_id",
         COUNT(*)      AS "balls_bowled"
FROM     IPL.IPL."BALL_BY_BALL" bb
GROUP BY bb."bowler"
ORDER BY "balls_bowled" DESC
LIMIT    20;
```

```sql
--Description: 9) Work out, for every bowler+match, how many wickets and runs they
--              conceded – enables identification of each bowler’s “best bowling”
--              performance (max wickets, then fewest runs).
WITH per_ball AS (
    SELECT bb."match_id",
           bb."bowler",
           COALESCE(bs."runs_scored",0)             AS runs_off_bat,
           CASE 
               WHEN wt."match_id" IS NOT NULL 
                AND wt."kind_out" NOT ILIKE '%run%' 
               THEN 1 ELSE 0 END                    AS wicket_flag
    FROM   IPL.IPL."BALL_BY_BALL"   bb
    LEFT JOIN IPL.IPL."BATSMAN_SCORED" bs
           ON bb."match_id" = bs."match_id"
          AND bb."over_id"  = bs."over_id"
          AND bb."ball_id"  = bs."ball_id"
    LEFT JOIN IPL.IPL."WICKET_TAKEN" wt
           ON wt."match_id" = bb."match_id"
          AND wt."over_id"  = bb."over_id"
          AND wt."ball_id"  = bb."ball_id"
)
SELECT   "bowler",
         "match_id",
         SUM(wicket_flag)      AS wickets_in_match,
         SUM(runs_off_bat)     AS runs_conceded
FROM     per_ball
GROUP BY "bowler","match_id"
ORDER BY wickets_in_match DESC, runs_conceded ASC
LIMIT    20;
```

```sql
--Description: 10) Combine player names with the headline bowling metrics we have built
--               so far (wickets, balls bowled, runs conceded) to get a human-readable
--               snapshot ready for final calculations of economy & strike rates.
WITH wickets AS (
    SELECT   bb."bowler" AS bowler_id,
             COUNT(*)    AS total_wkts
    FROM     IPL.IPL."WICKET_TAKEN" wt
    JOIN     IPL.IPL."BALL_BY_BALL" bb
         ON  wt."match_id" = bb."match_id"
        AND  wt."over_id"  = bb."over_id"
        AND  wt."ball_id"  = bb."ball_id"
    WHERE    wt."kind_out" NOT ILIKE '%run%'
    GROUP BY bb."bowler"
),
runs AS (
    SELECT   bb."bowler" AS bowler_id,
             SUM(bs."runs_scored") AS runs_off_bat
    FROM     IPL.IPL."BALL_BY_BALL"   bb
    LEFT JOIN IPL.IPL."BATSMAN_SCORED" bs
           ON bb."match_id" = bs."match_id"
          AND bb."over_id"  = bs."over_id"
          AND bb."ball_id"  = bs."ball_id"
    GROUP BY bb."bowler"
),
balls AS (
    SELECT   bb."bowler" AS bowler_id,
             COUNT(*)    AS balls_delivered
    FROM     IPL.IPL."BALL_BY_BALL" bb
    GROUP BY bb."bowler"
)
SELECT p."player_name",
       w.total_wkts,
       r.runs_off_bat,
       b.balls_delivered
FROM   wickets w
JOIN   runs    r ON r.bowler_id = w.bowler_id
JOIN   balls   b ON b.bowler_id = w.bowler_id
JOIN   IPL.IPL."PLAYER" p ON p."player_id" = w.bowler_id
ORDER  BY w.total_wkts DESC
LIMIT  20;
```
