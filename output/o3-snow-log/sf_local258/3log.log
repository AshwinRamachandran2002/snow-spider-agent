Query:
--Description: 6) First-cut aggregation – count how many wickets (excluding run-outs) a
--              bowler has taken overall.
SELECT   bb."bowler"           AS "bowler_id",
         COUNT(*)              AS "total_wickets"
FROM     IPL.IPL."WICKET_TAKEN" wt
JOIN     IPL.IPL."BALL_BY_BALL" bb
       ON wt."match_id" = bb."match_id"
      AND wt."over_id"  = bb."over_id"
      AND wt."ball_id"  = bb."ball_id"
WHERE    wt."kind_out" NOT ILIKE '%run%'      -- exclude run-outs
GROUP BY bb."bowler"
ORDER BY "total_wickets" DESC
LIMIT    20;
