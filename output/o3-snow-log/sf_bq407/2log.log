```sql
/*  Top-3 U.S. counties (population > 50 000) with the highest COVID-19
    case-fatality rates on 27-Aug-2020, together with ACS-2020 (5-year)
    median age & population, plus per-100 000 metrics.                     */

WITH county_cfr AS (          -- 1) pull 27-Aug-2020 cases & deaths
    SELECT
        c."county_fips_code",
        TRIM(c."county_name")              AS "county_name",
        c."state",
        c."_2020_08_27"                    AS "confirmed_cases",
        d."_2020_08_27"                    AS "deaths"
    FROM COVID19_USA.COVID19_USAFACTS."CONFIRMED_CASES"  c
    JOIN COVID19_USA.COVID19_USAFACTS."DEATHS"           d
      ON c."county_fips_code" = d."county_fips_code"
    WHERE c."_2020_08_27" > 0
),

acs_2020 AS (                  -- 2) 2020 5-yr ACS population & median age
    SELECT
        "county_fips_code",
        "total_population",
        "median_age"
    FROM CENSUS.ACS_5YEAR_2020."COUNTY"    -- ← adjust to actual ACS table
)

SELECT
    cc."county_name",
    cc."state",
    a."median_age",
    a."total_population",
    ROUND( cc."confirmed_cases" * 100000.0 / a."total_population" , 2) AS "cases_per_100k",
    ROUND( cc."deaths"          * 100000.0 / a."total_population" , 2) AS "deaths_per_100k",
    ROUND( cc."deaths" * 100.0 / cc."confirmed_cases"              , 2) AS "case_fatality_rate_pct"
FROM county_cfr cc
JOIN acs_2020 a
  ON cc."county_fips_code" = a."county_fips_code"
WHERE a."total_population" > 50000              -- population filter
ORDER BY "case_fatality_rate_pct" DESC NULLS LAST
LIMIT 3;
```
