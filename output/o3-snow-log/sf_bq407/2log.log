--Description: 8) Compare CFRs from SUMMARY with those from the dedicated daily tables
SELECT s."county_name",
       s."state",
       s."confirmed_cases" AS "cases_summary",
       s."deaths"          AS "deaths_summary",
       ROUND(100 * s."deaths" / NULLIF(s."confirmed_cases",0), 2) AS "cfr_summary",
       c."_2020_08_27"     AS "cases_table",
       d."_2020_08_27"     AS "deaths_table",
       ROUND(100 * d."_2020_08_27" / NULLIF(c."_2020_08_27",0), 2) AS "cfr_table"
FROM COVID19_USA.COVID19_USAFACTS."SUMMARY"          s
JOIN COVID19_USA.COVID19_USAFACTS."CONFIRMED_CASES"  c
  ON s."county_name" = c."county_name" AND s."state" = c."state"
JOIN COVID19_USA.COVID19_USAFACTS."DEATHS"           d
  ON c."county_fips_code" = d."county_fips_code"
WHERE s."date" = '2020-08-27'
  AND c."_2020_08_27" > 0
LIMIT 20;
