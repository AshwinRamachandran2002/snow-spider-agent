FROM COVID19_USA.COVID19_USAFACTS."CONFIRMED_CASES"
LIMIT 20;
```

```sql
--Description: 2) Preview 20 counties and their August-27-2020 confirmed-case counts
SELECT "county_fips_code",
       "county_name",
       "state",
       "_2020_08_27"  AS "confirmed_cases"
FROM COVID19_USA.COVID19_USAFACTS."CONFIRMED_CASES"
ORDER BY "_2020_08_27" DESC
LIMIT 20;
```

```sql
--Description: 3) Preview 20 counties and their August-27-2020 death counts
SELECT "county_fips_code",
       "county_name",
       "state",
       "_2020_08_27"  AS "deaths"
FROM COVID19_USA.COVID19_USAFACTS."DEATHS"
ORDER BY "_2020_08_27" DESC
LIMIT 20;
```

```sql
--Description: 4) Join confirmed-case and death tables (same date) to view both metrics side-by-side
SELECT c."county_fips_code",
       c."county_name",
       c."state",
       c."_2020_08_27" AS "confirmed_cases",
       d."_2020_08_27" AS "deaths"
FROM COVID19_USA.COVID19_USAFACTS."CONFIRMED_CASES"  c
JOIN COVID19_USA.COVID19_USAFACTS."DEATHS"           d
  ON c."county_fips_code" = d."county_fips_code"
LIMIT 20;
```

```sql
--Description: 5) Compute the raw case-fatality rate (CFR) for each county on August-27-2020
SELECT c."county_fips_code",
       c."county_name",
       c."state",
       c."_2020_08_27" AS "confirmed_cases",
       d."_2020_08_27" AS "deaths",
       ROUND(100 * d."_2020_08_27" / NULLIF(c."_2020_08_27",0), 2) AS "cfr_pct"
FROM COVID19_USA.COVID19_USAFACTS."CONFIRMED_CASES"  c
JOIN COVID19_USA.COVID19_USAFACTS."DEATHS"           d
  ON c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" > 0
LIMIT 20;
```

```sql
--Description: 6) List the 20 counties with the highest CFRs (cases > 0) on August-27-2020
SELECT c."county_fips_code",
       c."county_name",
       c."state",
       c."_2020_08_27" AS "confirmed_cases",
       d."_2020_08_27" AS "deaths",
       ROUND(100 * d."_2020_08_27" / NULLIF(c."_2020_08_27",0), 2) AS "cfr_pct"
FROM COVID19_USA.COVID19_USAFACTS."CONFIRMED_CASES"  c
JOIN COVID19_USA.COVID19_USAFACTS."DEATHS"           d
  ON c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" > 0
ORDER BY "cfr_pct" DESC
LIMIT 20;
```

```sql
--Description: 7) Verify August-27-2020 numbers using the time-series SUMMARY table
SELECT "county_name",
       "state",
       "confirmed_cases",
       "deaths",
       ROUND(100 * "deaths" / NULLIF("confirmed_cases",0), 2) AS "cfr_pct"
FROM COVID19_USA.COVID19_USAFACTS."SUMMARY"
WHERE "date" = '2020-08-27'
  AND "confirmed_cases" > 0
ORDER BY "cfr_pct" DESC
LIMIT 20;
```

```sql
--Description: 8) Compare CFRs from SUMMARY with those from the dedicated daily tables
SELECT s."county_name",
       s."state",
       s."confirmed_cases" AS "cases_summary",
       s."deaths"          AS "deaths_summary",
       ROUND(100 * s."deaths" / NULLIF(s."confirmed_cases",0), 2) AS "cfr_summary",
       c."_2020_08_27"     AS "cases_table",
       d."_2020_08_27"     AS "deaths_table",
       ROUND(100 * d."_2020_08_27" / NULLIF(c."_2020_08_27",0), 2) AS "cfr_table"
FROM COVID19_USA.COVID19_USAFACTS."SUMMARY"          s
JOIN COVID19_USA.COVID19_USAFACTS."CONFIRMED_CASES"  c
  ON s."county_name" = c."county_name" AND s."state" = c."state"
JOIN COVID19_USA.COVID19_USAFACTS."DEATHS"           d
  ON c."county_fips_code" = d."county_fips_code"
WHERE s."date" = '2020-08-27'
  AND c."_2020_08_27" > 0
LIMIT 20;
```

```sql
--Description: 9) Aggregate confirmed cases & deaths to find state-level CFR on August-27-2020
SELECT c."state",
       SUM(c."_2020_08_27") AS "total_cases",
       SUM(d."_2020_08_27") AS "total_deaths",
       ROUND(100 * SUM(d."_2020_08_27") / NULLIF(SUM(c."_2020_08_27"),0), 2) AS "state_cfr_pct"
FROM COVID19_USA.COVID19_USAFACTS."CONFIRMED_CASES"  c
JOIN COVID19_USA.COVID19_USAFACTS."DEATHS"           d
  ON c."county_fips_code" = d."county_fips_code"
GROUP BY c."state"
ORDER BY "state_cfr_pct" DESC
LIMIT 20;
```

```sql
--Description: 10) (Toward final answer) Build the county-level CFR list for August-27-2020, ready to join with 2020 ACS population & median-age data
SELECT c."county_fips_code",
       c."county_name",
       c."state",
       c."_2020_08_27" AS "confirmed_cases",
       d."_2020_08_27" AS "deaths",
       ROUND(100 * d."_2020_08_27" / NULLIF(c."_2020_08_27",0), 2) AS "cfr_pct"
FROM COVID19_USA.COVID19_USAFACTS."CONFIRMED_CASES"  c
JOIN COVID19_USA.COVID19_USAFACTS."DEATHS"           d
  ON c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" > 0
--   !! At this point you would INNER JOIN to an ACS 2020 5-year demographics table that
--   contains county_fips_code, median_age, and total_population to compute per-100k metrics
ORDER BY "cfr_pct" DESC
LIMIT 20;
```
