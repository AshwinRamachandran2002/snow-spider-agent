Query:
--Description: Compute the raw case-fatality rate (deaths / cases) for counties on 2020-08-27
SELECT c."county_fips_code",
       c."county_name",
       c."state",
       c."_2020_08_27" AS "cases",
       d."_2020_08_27" AS "deaths",
       CASE WHEN c."_2020_08_27" > 0
            THEN ROUND(100.0 * d."_2020_08_27" / c."_2020_08_27", 2)
            ELSE NULL
       END AS "case_fatality_rate_pct"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES  c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS          d
  ON  c."county_fips_code" = d."county_fips_code"
ORDER BY "case_fatality_rate_pct" DESC
LIMIT 20;
