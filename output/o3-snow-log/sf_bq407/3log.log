```sql
/*---------------------------------------------------------------------------
  Top-3 U.S. counties (population ≥ 50,000) with the highest COVID-19
  case-fatality rates on 2020-08-27, enriched with 2020 ACS 5-year
  population & median-age figures
---------------------------------------------------------------------------*/
WITH covid AS (            -- county-level cases, deaths & CFR on 2020-08-27
    SELECT  c."county_fips_code"                       AS "fips",
            TRIM(c."county_name")                     AS "county_name",
            c."state"                                 AS "state",
            c."_2020_08_27"::FLOAT                    AS "cases",
            d."_2020_08_27"::FLOAT                    AS "deaths",
            CASE WHEN c."_2020_08_27" > 0
                 THEN d."_2020_08_27"::FLOAT / c."_2020_08_27"
            END                                       AS "cfr"
    FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES  c
    JOIN COVID19_USA.COVID19_USAFACTS.DEATHS           d
      ON c."county_fips_code" = d."county_fips_code"
),
pop AS (               -- 2020 ACS 5-yr total-population  (table B01003)
    SELECT  REGEXP_REPLACE("GEO_ID",'US','')           AS "fips",
            "B01003_001E"::FLOAT                      AS "population"
    FROM "CENSUS"."ACS_2020_5YR"."B01003"
),
age AS (               -- 2020 ACS 5-yr median age (table B01002)
    SELECT  REGEXP_REPLACE("GEO_ID",'US','')           AS "fips",
            "B01002_001E"::FLOAT                      AS "median_age"
    FROM "CENSUS"."ACS_2020_5YR"."B01002"
),
census AS (            -- join population & age, keep counties ≥ 50k people
    SELECT  p."fips",
            p."population",
            a."median_age"
    FROM pop p
    JOIN age a USING ("fips")
    WHERE p."population" >= 50000
)
SELECT  cv."county_name",
        cv."state",
        cn."median_age",
        cn."population",
        ROUND(cv."cases"  / cn."population" * 100000, 2)   AS "cases_per_100k",
        ROUND(cv."deaths" / cn."population" * 100000, 2)   AS "deaths_per_100k",
        ROUND(cv."cfr" * 100, 2)                           AS "case_fatality_rate_pct"
FROM covid  cv
JOIN census cn
  ON cv."fips" = cn."fips"
ORDER BY "case_fatality_rate_pct" DESC NULLS LAST
LIMIT 3;
```
