```sql
--Description: Inspect which reporting dates exist in the daily summary table
SELECT DISTINCT "date"
FROM COVID19_USA.COVID19_USAFACTS.SUMMARY
ORDER BY "date"
LIMIT 20;
```

```sql
--Description: Take a quick look at the nationwide totals reported on 2020-08-27
SELECT "state",
       SUM("confirmed_cases") AS "cases_2020_08_27",
       SUM("deaths")          AS "deaths_2020_08_27"
FROM COVID19_USA.COVID19_USAFACTS.SUMMARY
WHERE "date" = '2020-08-27'
GROUP BY "state"
ORDER BY "cases_2020_08_27" DESC
LIMIT 20;
```

```sql
--Description: Pull county-level case counts on 2020-08-27 from the wide CONFIRMED_CASES table
SELECT "county_fips_code",
       "county_name",
       "state",
       "_2020_08_27" AS "cases_2020_08_27"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES
ORDER BY "_2020_08_27" DESC
LIMIT 20;
```

```sql
--Description: Pull county-level deaths on 2020-08-27 from the wide DEATHS table
SELECT "county_fips_code",
       "county_name",
       "state",
       "_2020_08_27" AS "deaths_2020_08_27"
FROM COVID19_USA.COVID19_USAFACTS.DEATHS
ORDER BY "_2020_08_27" DESC
LIMIT 20;
```

```sql
--Description: Join CONFIRMED_CASES and DEATHS to see cases vs. deaths on 2020-08-27
SELECT c."county_fips_code",
       c."county_name",
       c."state",
       c."_2020_08_27" AS "cases",
       d."_2020_08_27" AS "deaths"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES  c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS          d
  ON  c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" IS NOT NULL
ORDER BY c."_2020_08_27" DESC
LIMIT 20;
```

```sql
--Description: Compute the raw case-fatality rate (deaths / cases) for counties on 2020-08-27
SELECT c."county_fips_code",
       c."county_name",
       c."state",
       c."_2020_08_27" AS "cases",
       d."_2020_08_27" AS "deaths",
       CASE WHEN c."_2020_08_27" > 0
            THEN ROUND(100.0 * d."_2020_08_27" / c."_2020_08_27", 2)
            ELSE NULL
       END AS "case_fatality_rate_pct"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES  c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS          d
  ON  c."county_fips_code" = d."county_fips_code"
ORDER BY "case_fatality_rate_pct" DESC
LIMIT 20;
```

```sql
--Description: Restrict to counties with at least 1,000 confirmed cases to avoid small-number bias
SELECT c."county_name",
       c."state",
       c."_2020_08_27" AS "cases",
       d."_2020_08_27" AS "deaths",
       ROUND(100.0 * d."_2020_08_27" / c."_2020_08_27", 2) AS "cfr_pct"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS         d
  ON c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" >= 1000
ORDER BY "cfr_pct" DESC
LIMIT 20;
```

```sql
--Description: Verify that the daily SUMMARY table’s numbers agree with the wide tables for 2020-08-27
SELECT s."county_name",
       s."state",
       s."confirmed_cases" AS "summary_cases",
       c."_2020_08_27"     AS "wide_cases",
       s."deaths"          AS "summary_deaths",
       d."_2020_08_27"     AS "wide_deaths"
FROM COVID19_USA.COVID19_USAFACTS.SUMMARY          s
JOIN COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES  c
  ON s."county_name" = c."county_name" AND s."state" = c."state"
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS           d
  ON c."county_fips_code" = d."county_fips_code"
WHERE s."date" = '2020-08-27'
ORDER BY s."confirmed_cases" DESC
LIMIT 20;
```

```sql
--Description: Produce a county list with cases, deaths, and CFR ready to be combined with Census data
SELECT c."county_fips_code",
       c."county_name",
       c."state",
       c."_2020_08_27" AS "cases",
       d."_2020_08_27" AS "deaths",
       ROUND(100.0 * d."_2020_08_27" / NULLIF(c."_2020_08_27",0), 2) AS "cfr_pct"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES  c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS          d
  ON  c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" IS NOT NULL
ORDER BY "cfr_pct" DESC
LIMIT 20;
```

```sql
--Description: (Optional) Look for data quality issues such as missing deaths but non-zero cases
SELECT c."county_name",
       c."state",
       c."_2020_08_27" AS "cases",
       d."_2020_08_27" AS "deaths"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
LEFT JOIN COVID19_USA.COVID19_USAFACTS.DEATHS     d
  ON c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" > 0
  AND (d."_2020_08_27" IS NULL OR d."_2020_08_27" = 0)
ORDER BY c."_2020_08_27" DESC
LIMIT 20;
```
