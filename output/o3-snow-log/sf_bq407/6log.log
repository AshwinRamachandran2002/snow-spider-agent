```sql
--Description: Compute a simple case-fatality rate (CFR) for counties having ≥1 confirmed case
SELECT
  c."county_fips_code",
  c."county_name",
  c."state",
  c."_2020_08_27" AS "confirmed_2020_08_27",
  d."_2020_08_27" AS "deaths_2020_08_27",
  (d."_2020_08_27" / NULLIF(c."_2020_08_27",0)) * 100  AS "cfr_percent"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS         d
  ON c."county_fips_code" = d."county_fips_code"
     AND c."state"        = d."state"
WHERE c."_2020_08_27" > 0
LIMIT 20;
```

