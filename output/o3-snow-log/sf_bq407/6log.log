```sql
/*------------------------------------------------------------------------------------
  Top-3 U.S. counties (population > 50 000) with the highest COVID-19 case-fatality
  rate on 27-Aug-2020, together with 2020 ACS 5-year census demographics
------------------------------------------------------------------------------------*/
WITH covid AS (    -- 27-Aug-2020 pivot figures
    SELECT
        c."county_fips_code"                           AS "fips",
        TRIM(c."county_name")                          AS "county_name",
        c."state",
        c."_2020_08_27"                                AS "confirmed",
        d."_2020_08_27"                                AS "deaths"
    FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES  c
    JOIN COVID19_USA.COVID19_USAFACTS.DEATHS           d
          ON  c."county_fips_code" = d."county_fips_code"
         AND c."state"             = d."state"
    WHERE c."_2020_08_27" IS NOT NULL
      AND d."_2020_08_27" IS NOT NULL
      AND c."county_fips_code" <> '00000'              -- exclude statewide/unallocated rows
),
acs AS (          -- 2020 ACS 5-year county demographics
    SELECT
        "GEOID"              AS "fips",
        "B01003_001E"::NUMBER AS "total_population",   -- total population
        "B01002_001E"::NUMBER AS "median_age"          -- median age
    FROM CENSUS.ACS_5YEAR_2020.COUNTY
)
SELECT
    covid."county_name"                                       AS "county",
    covid."state",
    acs."median_age",
    acs."total_population",
    ROUND( (covid."confirmed" / acs."total_population") * 100000, 4) AS "confirmed_per_100k",
    ROUND( (covid."deaths"    / acs."total_population") * 100000, 4) AS "deaths_per_100k",
    ROUND( (covid."deaths"    / NULLIF(covid."confirmed",0)) * 100 , 4) AS "case_fatality_rate_percent"
FROM covid
JOIN acs
  ON covid."fips" = acs."fips"
WHERE acs."total_population" > 50000        -- only counties with population > 50 000
ORDER BY "case_fatality_rate_percent" DESC NULLS LAST
LIMIT 3;
```
