```sql
--Description:  The task calls for counties with population ≥ 50 000 and their COVID-19
--              case-fatality rates (CFR) on 27-Aug-2020.  However, in this Snowflake
--              environment we only have three USAFacts tables (CONFIRMED_CASES,
--              DEATHS, SUMMARY) and no census-population table, so we cannot yet
--              filter by population size or include median age.  Until those data
--              are provided, the best intermediate step is to compute CFR for every
--              county from the two pivot tables, join on county_fips_code + state, and
--              rank the results.  The calculation is: deaths ÷ confirmed × 100.
--              This query returns the 20 counties with the highest CFR on 2020-08-27.
SELECT
    c."county_fips_code",
    c."county_name",
    c."state",
    c."_2020_08_27" AS "confirmed_2020_08_27",
    d."_2020_08_27" AS "deaths_2020_08_27",
    (d."_2020_08_27" / NULLIF(c."_2020_08_27", 0)) * 100 AS "cfr_percent"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES AS c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS         AS d
