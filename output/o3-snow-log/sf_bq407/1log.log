```sql
--Description: Use SUMMARY to calculate the 27-Aug-2020 case-fatality rate and list the 20 worst counties
SELECT
  "county_name",
  "state",
  "confirmed_cases",
  "deaths",
  ("deaths" / NULLIF("confirmed_cases",0)) * 100 AS "case_fatality_rate_pct"
