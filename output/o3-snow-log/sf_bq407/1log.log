WITH covid AS (
    /* ---  County-level COVID-19 tallies on 27-Aug-2020  --- */
    SELECT
        c."county_fips_code"                 AS "fips",
        c."county_name",
        c."state",
        c."_2020_08_27"                      AS "cases",
        d."_2020_08_27"                      AS "deaths"
    FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
    JOIN COVID19_USA.COVID19_USAFACTS.DEATHS         d
      ON c."county_fips_code" = d."county_fips_code"
    WHERE c."_2020_08_27" IS NOT NULL
      AND d."_2020_08_27" IS NOT NULL
),
acs AS (
    /* ---  2020 ACS 5-Year county demographics  --- */
    SELECT
        "county_fips_code"  AS "fips",
        "B01003_001E"       AS "population",    -- total population
        "B01002_001E"       AS "median_age"     -- median age
    FROM CENSUS.ACS5YR_2020.COUNTY
)
SELECT
    cv."county_name"                                 AS "county",
    cv."state",
    ac."median_age",
    ac."population"                                  AS "total_population",
    (cv."cases"  / ac."population") * 100000         AS "cases_per_100k",
    (cv."deaths" / ac."population") * 100000         AS "deaths_per_100k",
    (cv."deaths" / NULLIF(cv."cases",0)) * 100       AS "case_fatality_rate_pct"
FROM covid cv
JOIN acs   ac
  ON cv."fips" = ac."fips"
WHERE ac."population" > 50000               -- only counties > 50 000 population
ORDER BY "case_fatality_rate_pct" DESC NULLS LAST
LIMIT 3;
```
