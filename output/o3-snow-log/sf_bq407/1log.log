    ROUND((cv."cases"  / ac."population") * 100000, 4)         AS "cases_per_100k",
    ROUND((cv."deaths" / ac."population") * 100000, 4)         AS "deaths_per_100k",
    ROUND((cv."deaths" / NULLIF(cv."cases",0)) * 100, 4)       AS "case_fatality_rate_pct"
FROM covid cv
JOIN acs   ac
      ON cv."fips" = ac."fips"
WHERE ac."population" > 50000                -- keep counties > 50 000 pop
ORDER BY "case_fatality_rate_pct" DESC NULLS LAST
LIMIT 3;
```
