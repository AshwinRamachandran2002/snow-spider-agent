Query:
--Description: Compute the 27-Aug-2020 case-fatality rate (%) for every county; show the 20 highest
SELECT
  c."county_fips_code",
  c."county_name",
  c."state",
  c."_2020_08_27" AS "cases",
  d."_2020_08_27" AS "deaths",
  (d."_2020_08_27" / NULLIF(c."_2020_08_27",0)) * 100 AS "case_fatality_rate_pct"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES  c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS          d
  ON c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" > 0
ORDER BY "case_fatality_rate_pct" DESC
LIMIT 20;
