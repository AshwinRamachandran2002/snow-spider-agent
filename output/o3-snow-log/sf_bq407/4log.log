```sql
WITH county_covid AS (
    /* --- 1.  Pull 8/27/2020 cumulative case & death totals for every county --- */
    SELECT
        c."county_fips_code"              AS "county_fips_code",
        TRIM(c."county_name")             AS "county_name",
        c."state"                         AS "state",
        c."_2020_08_27"                   AS "confirmed_cases",
        d."_2020_08_27"                   AS "deaths"
    FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES  AS c
    JOIN COVID19_USA.COVID19_USAFACTS.DEATHS           AS d
      ON  c."county_fips_code" = d."county_fips_code"
      AND c."state"            = d."state"
    /*  Ignore state‐wide “unallocated” records (FIPS = 00000)                   */
    WHERE c."county_fips_code" <> '00000'
),
census_demo AS (
    /* --- 2.  2020 5-year ACS county-level population & median-age figures --- */
    /*      DP05_0001E  →  total population estimate                            */
    /*      DP05_0018E  →  median age estimate                                  */
    SELECT
        RIGHT("GEO_ID",5)                 AS "county_fips_code",   -- last 5 digits
        CAST("DP05_0001E" AS NUMBER)      AS "total_population",
        CAST("DP05_0018E" AS NUMBER(8,2)) AS "median_age"
    FROM CENSUS.ACS5YR_2020.DP05
    WHERE "SUMLEV" = '050'                                   -- county level
),
combined AS (
    /* --- 3.  Merge COVID metrics with census demographics --- */
    SELECT
        cc."county_name",
        cc."state",
        cd."median_age",
        cd."total_population",
        cc."confirmed_cases",
        cc."deaths",
        /*  Rates per 100 000 residents                                             */
        ROUND( cc."confirmed_cases" / cd."total_population" * 100000 , 1) AS "cases_per_100k",
        ROUND( cc."deaths"          / cd."total_population" * 100000 , 1) AS "deaths_per_100k",
        /*  Case-fatality rate (percentage)                                         */
        ROUND( cc."deaths" / NULLIF(cc."confirmed_cases",0) * 100 , 2)   AS "case_fatality_pct"
    FROM county_covid     cc
    JOIN census_demo      cd
      ON cc."county_fips_code" = cd."county_fips_code"
    WHERE cd."total_population" > 50000          -- only counties > 50 000 pop
)
/* --- 4.  Return the three counties with the highest CFR -------------------- */
SELECT
    "county_name",
    "state",
    "median_age",
    "total_population",
    "cases_per_100k",
    "deaths_per_100k",
    "case_fatality_pct"
FROM combined
ORDER BY "case_fatality_pct" DESC NULLS LAST
LIMIT 3;
