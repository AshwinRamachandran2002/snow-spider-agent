      ON  c."county_fips_code" = d."county_fips_code"
      AND c."state"            = d."state"
    WHERE c."county_fips_code" <> '00000'              -- omit state-wide “unallocated”
),
census_demo AS (                    -- 2.  2020 5-yr ACS population & median-age
    SELECT
        RIGHT("GEO_ID",5)                      AS "county_fips_code",
        CAST("DP05_0001E" AS NUMBER)           AS "total_population",   -- population
        CAST("DP05_0018E" AS NUMBER(8,2))      AS "median_age"          -- median age
    FROM "census"."acs5yr_2020"."dp05"
    WHERE "SUMLEV" = '050'                                           -- county rows only
),
combined AS (                      -- 3.  Merge COVID data with census demographics
    SELECT
        cc."county_name",
        cc."state",
        cd."median_age",
        cd."total_population",
        cc."confirmed_cases",
        cc."deaths",
        ROUND( cc."confirmed_cases" / cd."total_population" * 100000 , 1) AS "cases_per_100k",
        ROUND( cc."deaths"          / cd."total_population" * 100000 , 1) AS "deaths_per_100k",
        ROUND( cc."deaths" / NULLIF(cc."confirmed_cases",0) * 100 , 2)    AS "case_fatality_pct"
    FROM county_covid cc
    JOIN census_demo  cd  ON cc."county_fips_code" = cd."county_fips_code"
    WHERE cd."total_population" > 50000                       -- population threshold
)
/* 4.  Return the three counties with the highest case-fatality rate */
SELECT
    "county_name",
    "state",
    "median_age",
    "total_population",
    "cases_per_100k",
    "deaths_per_100k",
    "case_fatality_pct"
FROM combined
ORDER BY "case_fatality_pct" DESC NULLS LAST
LIMIT 3;
