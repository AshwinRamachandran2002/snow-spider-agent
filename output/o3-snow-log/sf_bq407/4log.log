--Description: Compute the raw case-fatality rate (deaths / confirmed cases) for each county on Aug-27-2020
SELECT 
  c."county_fips_code",
  c."county_name",
  c."state",
  c."_2020_08_27"          AS "confirmed_cases",
  d."_2020_08_27"          AS "deaths",
  CASE 
    WHEN c."_2020_08_27" > 0 
         THEN d."_2020_08_27" / c."_2020_08_27" 
    ELSE NULL 
  END                     AS "case_fatality_rate"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES   AS c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS           AS d
  ON  c."county_fips_code" = d."county_fips_code"
