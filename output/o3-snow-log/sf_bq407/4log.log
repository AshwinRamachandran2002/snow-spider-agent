```sql
--Description: 
-- • Goal-in-principle → list counties with highest COVID-19 case-fatality rate (CFR) on 2020-08-27.  
-- • Available objects → CONFIRMED_CASES, DEATHS, SUMMARY.  None of them contain 2020 ACS
--   population (>50 000) or median-age fields, so we cannot fulfil that part of the brief
--   with the data we are authorised to query.  
-- • The SUMMARY table already holds BOTH “confirmed_cases” and “deaths” for every county / date,
--   so one table is enough: simply filter date = '2020-08-27', compute CFR, sort.  
-- • Division-by-zero is avoided with NULLIF.  
-- • When census statistics become available you would LEFT JOIN on “county_fips_code” (or name)
--   and add a predicate such as   WHERE p."total_population" > 50000.  
-- • For now this single query shows the top-20 counties by CFR that can be calculated
--   from the authorised catalogue.

SELECT
    s."county_name",
    s."state",
    s."confirmed_cases",
    s."deaths",
    ROUND( s."deaths" / NULLIF( s."confirmed_cases", 0 ) * 100 , 2 ) AS "case_fatality_pct"
FROM COVID19_USA.COVID19_USAFACTS.SUMMARY AS s
WHERE s."date" = '2020-08-27'
  AND s."confirmed_cases" > 0
ORDER BY "case_fatality_pct" DESC
LIMIT 20;
