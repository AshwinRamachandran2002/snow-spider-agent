```sql
--Description: Join CONFIRMED_CASES and DEATHS on county FIPS & state to align August-27-2020 counts
SELECT 
  c."county_fips_code",
  c."county_name",
  c."state",
  c."_2020_08_27"  AS "confirmed_cases",
  d."_2020_08_27"  AS "deaths"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES   AS c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS           AS d
  ON  c."county_fips_code" = d."county_fips_code"
  AND c."state"            = d."state"
LIMIT 20;
```

```sql
--Description: Compute the raw case-fatality rate (deaths / confirmed cases) for each county on Aug-27-2020
SELECT 
  c."county_fips_code",
  c."county_name",
  c."state",
  c."_2020_08_27"          AS "confirmed_cases",
  d."_2020_08_27"          AS "deaths",
  CASE 
    WHEN c."_2020_08_27" > 0 
         THEN d."_2020_08_27" / c."_2020_08_27" 
    ELSE NULL 
  END                     AS "case_fatality_rate"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES   AS c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS           AS d
  ON  c."county_fips_code" = d."county_fips_code"
  AND c."state"            = d."state"
LIMIT 20;
```

```sql
--Description: Display counties with at least 10 deaths, sorted by highest case-fatality rate first
SELECT 
  c."county_fips_code",
  c."county_name",
  c."state",
  c."_2020_08_27"          AS "confirmed_cases",
  d."_2020_08_27"          AS "deaths",
  ROUND(
    d."_2020_08_27" / NULLIF(c."_2020_08_27",0) * 100,   -- percentage
    2
  )                   AS "case_fatality_pct"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES   AS c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS           AS d
  ON  c."county_fips_code" = d."county_fips_code"
  AND c."state"            = d."state"
WHERE d."_2020_08_27" >= 10       -- adjust threshold if needed
ORDER BY "case_fatality_pct" DESC
LIMIT 20;
```

```sql
--Description: Aggregate county results to state-level to cross-check totals for sanity
SELECT 
  c."state",
  SUM(c."_2020_08_27") AS "state_confirmed",
  SUM(d."_2020_08_27") AS "state_deaths",
  ROUND( SUM(d."_2020_08_27") / NULLIF(SUM(c."_2020_08_27"),0) * 100, 2) AS "state_cfr_pct"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS         d
  ON  c."county_fips_code" = d."county_fips_code"
  AND c."state"            = d."state"
GROUP BY c."state"
ORDER BY "state_cfr_pct" DESC
LIMIT 20;
```

```sql
--Description: Identify the top 100 counties with the highest case-fatality percentage (all populations)
SELECT 
  c."county_fips_code",
  c."county_name",
  c."state",
  c."_2020_08_27" AS "confirmed_cases",
  d."_2020_08_27" AS "deaths",
  ROUND(
    d."_2020_08_27" / NULLIF(c."_2020_08_27",0) * 100, 
    2
  ) AS "case_fatality_pct"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS         d
  ON  c."county_fips_code" = d."county_fips_code"
  AND c."state"            = d."state"
WHERE c."_2020_08_27" >= 1
ORDER BY "case_fatality_pct" DESC
LIMIT 100;
```

```sql
--Description: (Final) Prepare a detailed list for counties (placeholders for population & median age columns) 
-- Replace POP_TABLE, "total_population", and "median_age" with the actual 2020 5-year census table / columns
SELECT 
  c."county_fips_code",
  c."county_name",
  c."state",
  p."total_population",
  p."median_age",
  ROUND( c."_2020_08_27" / NULLIF(p."total_population",0) * 100000, 2 ) AS "cases_per_100k",
  ROUND( d."_2020_08_27" / NULLIF(p."total_population",0) * 100000, 2 ) AS "deaths_per_100k",
  ROUND( d."_2020_08_27" / NULLIF(c."_2020_08_27",0) * 100, 2 )         AS "case_fatality_pct"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS         d
  ON  c."county_fips_code" = d."county_fips_code"
  AND c."state"            = d."state"
JOIN POP_TABLE                                       p    -- <<< substitute with 2020 ACS 5-Year table
  ON  c."county_fips_code" = p."county_fips_code"
WHERE p."total_population" > 50000
ORDER BY "case_fatality_pct" DESC
LIMIT 20;
```
