```sql
--Description: Compare figures between SUMMARY and the two snapshot tables for one county (Los Angeles, CA)
SELECT 
  s."county_name",
  s."state",
  s."confirmed_cases"::NUMBER  AS "summary_cases",
  s."deaths"::NUMBER           AS "summary_deaths",
  c."_2020_08_27"              AS "snapshot_cases",
  d."_2020_08_27"              AS "snapshot_deaths"
FROM COVID19_USA.COVID19_USAFACTS.SUMMARY          s
JOIN COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES  c
  ON s."county_name" = c."county_name"
  AND s."state"       = c."state"
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS           d
  ON c."county_fips_code" = d."county_fips_code"
WHERE s."county_name" ILIKE '%Los%Angeles%' 
  AND s."state" = 'CA'
  AND s."date"  = '2020-08-27'
LIMIT 20;
```

```sql
--Description: Aggregate total cases & deaths per county on 27-Aug-2020 (will be used for CFR calculation)
SELECT 
  c."county_fips_code",
  c."county_name",
  c."state",
  c."_2020_08_27"            AS "cases",
  d."_2020_08_27"            AS "deaths"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS          d
  ON c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" IS NOT NULL
  AND d."_2020_08_27" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Identify counties with ≥50 COVID-19 deaths (quick high-fatality scan)
SELECT 
  "county_name",
  "state",
  "_2020_08_27" AS "deaths"
FROM COVID19_USA.COVID19_USAFACTS.DEATHS
WHERE "_2020_08_27" >= 50
ORDER BY "_2020_08_27" DESC
LIMIT 20;
```

```sql
--Description: (Preparation for final answer) bring cases & deaths together and compute crude CFR
SELECT 
  c."county_name",
  c."state",
  c."_2020_08_27" ::NUMBER                                AS "cases",
  d."_2020_08_27" ::NUMBER                                AS "deaths",
  CASE WHEN c."_2020_08_27"::NUMBER > 0 
       THEN (d."_2020_08_27"::NUMBER / c."_2020_08_27"::NUMBER) * 100
       ELSE NULL
  END                                                     AS "cfr_percent"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS           d
  ON c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" IS NOT NULL
  AND d."_2020_08_27" IS NOT NULL
ORDER BY "cfr_percent" DESC
LIMIT 20;
```
