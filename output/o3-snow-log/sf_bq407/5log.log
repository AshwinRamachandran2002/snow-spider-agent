Query:
--Description: (Preparation for final answer) bring cases & deaths together and compute crude CFR
SELECT 
  c."county_name",
  c."state",
  c."_2020_08_27" ::NUMBER                                AS "cases",
  d."_2020_08_27" ::NUMBER                                AS "deaths",
  CASE WHEN c."_2020_08_27"::NUMBER > 0 
       THEN (d."_2020_08_27"::NUMBER / c."_2020_08_27"::NUMBER) * 100
       ELSE NULL
  END                                                     AS "cfr_percent"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS           d
  ON c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" IS NOT NULL
  AND d."_2020_08_27" IS NOT NULL
ORDER BY "cfr_percent" DESC
LIMIT 20;
