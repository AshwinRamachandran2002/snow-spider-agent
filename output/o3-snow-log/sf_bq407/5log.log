/*  Top-3 U.S. counties (population ≥ 50 000) with the highest COVID-19
    case-fatality rate on 27-Aug-2020, together with 2020 ACS-5-year
    population and median-age data                                          */

WITH covid AS (   -- 27-Aug-2020 confirmed cases & deaths
    SELECT
        c."county_fips_code",
        TRIM(c."county_name")                        AS "county_name",
        c."state",
        c."_2020_08_27"::NUMBER                      AS "cases",
        d."_2020_08_27"::NUMBER                      AS "deaths"
    FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES  c
    JOIN COVID19_USA.COVID19_USAFACTS.DEATHS            d
      ON c."county_fips_code" = d."county_fips_code"
    WHERE c."_2020_08_27" IS NOT NULL
      AND d."_2020_08_27" IS NOT NULL
),
acs AS (   -- 2020 ACS 5-year county population & median age
    SELECT
        LPAD("county_fips_code", 5, '0')             AS "county_fips_code",
        "total_population"::NUMBER                   AS "population",
        "median_age"::NUMBER                         AS "median_age"
    FROM ACS.ACS_2020_5YR.COUNTY
)
SELECT
    c."county_name"                                                   AS "county",
    c."state",
    a."median_age",
    a."population",
    ROUND((c."cases"  / a."population") * 100000, 4)                  AS "cases_per_100k",
    ROUND((c."deaths" / a."population") * 100000, 4)                  AS "deaths_per_100k",
    ROUND((c."deaths" / NULLIF(c."cases",0)) * 100, 4)                AS "case_fatality_rate_pct"
FROM covid c
JOIN acs   a
  ON c."county_fips_code" = a."county_fips_code"
WHERE a."population" >= 50000          -- retain counties with ≥ 50 000 pop
  AND c."cases" > 0                    -- avoid divide-by-zero
ORDER BY "case_fatality_rate_pct" DESC NULLS LAST
LIMIT 3;
```
