```sql
--Description: Missouri – counties with the most confirmed cases on 27-Aug-2020
SELECT "county_fips_code",
       "county_name",
       "state",
       "_2020_08_27" AS "confirmed_cases"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES
WHERE "state" = 'MO'
ORDER BY "_2020_08_27" DESC
LIMIT 20;
```

```sql
--Description: Top-20 counties nation-wide by raw confirmed cases on 27-Aug-2020
SELECT "county_fips_code",
       "county_name",
       "state",
       "_2020_08_27" AS "confirmed_cases"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES
ORDER BY "_2020_08_27" DESC
LIMIT 20;
```

```sql
--Description: Top-20 counties nation-wide by raw COVID-19 deaths on 27-Aug-2020
SELECT "county_fips_code",
       "county_name",
       "state",
       "_2020_08_27" AS "deaths"
FROM COVID19_USA.COVID19_USAFACTS.DEATHS
ORDER BY "_2020_08_27" DESC
LIMIT 20;
```

```sql
--Description: Join confirmed cases and deaths to compute the highest county-level case-fatality rates on 27-Aug-2020
SELECT c."county_fips_code",
       c."county_name",
       c."state",
       c."_2020_08_27"  AS "cases",
       d."_2020_08_27"  AS "deaths",
       (d."_2020_08_27" / NULLIF(c."_2020_08_27",0)) * 100 AS "case_fatality_rate_pct"
FROM  COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES  c
JOIN  COVID19_USA.COVID19_USAFACTS.DEATHS           d
  ON c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" > 0
ORDER BY "case_fatality_rate_pct" DESC
LIMIT 20;
```

```sql
--Description: Pull county-level data for 27-Aug-2020 from the time-series SUMMARY table
SELECT "county_name",
       "state",
       "date",
       "confirmed_cases",
       "deaths"
FROM COVID19_USA.COVID19_USAFACTS.SUMMARY
WHERE "date" = '2020-08-27'
ORDER BY "confirmed_cases" DESC
LIMIT 20;
```

```sql
--Description: Aggregate the SUMMARY table on 27-Aug-2020 to see state-level totals
SELECT "state",
       SUM("confirmed_cases") AS "total_cases",
       SUM("deaths")          AS "total_deaths"
FROM COVID19_USA.COVID19_USAFACTS.SUMMARY
WHERE "date" = '2020-08-27'
GROUP BY "state"
ORDER BY "total_deaths" DESC
LIMIT 20;
```

```sql
--Description: Retrieve 27-Aug-2020 SUMMARY records just for the state of New York
SELECT "county_name",
       "confirmed_cases",
       "deaths"
FROM COVID19_USA.COVID19_USAFACTS.SUMMARY
WHERE "state" = 'NY'
  AND "date" = '2020-08-27'
ORDER BY "confirmed_cases" DESC
LIMIT 20;
```

```sql
--Description: Check counties with at least 1,000 confirmed cases but zero deaths (potential CFR edge cases)
SELECT c."county_name",
       c."state",
       c."_2020_08_27" AS "cases",
       d."_2020_08_27" AS "deaths"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS        d
  ON c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" >= 1000
  AND d."_2020_08_27" = 0
LIMIT 20;
```

```sql
--Description: Locate counties whose deaths exceed 100 while cases remain under 2,000 on 27-Aug-2020 (high apparent CFR)
SELECT c."county_name",
       c."state",
       c."_2020_08_27" AS "cases",
       d."_2020_08_27" AS "deaths",
       (d."_2020_08_27" / NULLIF(c."_2020_08_27",0)) * 100 AS "case_fatality_rate_pct"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS        d
  ON c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" BETWEEN 1 AND 2000
  AND d."_2020_08_27" > 100
ORDER BY "case_fatality_rate_pct" DESC
LIMIT 20;
```
