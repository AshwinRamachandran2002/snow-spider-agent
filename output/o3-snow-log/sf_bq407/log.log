```sql
/* -----------------------------------------------------------------------
   Top-3 U.S. counties (population > 50,000; ACS-5-Year-2020)
   with the highest COVID-19 case-fatality rates on 27-Aug-2020
------------------------------------------------------------------------ */
WITH
/* ----------------------------------------------------------------------
   1)  County-level COVID-19 counts as of 27-Aug-2020
------------------------------------------------------------------------ */
covid AS (
    SELECT
        c."county_fips_code",
        TRIM(c."county_name")                     AS "county_name",
        c."state",
        c."_2020_08_27"::NUMBER                  AS "confirmed_cases",
        d."_2020_08_27"::NUMBER                  AS "deaths"
    FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
    JOIN COVID19_USA.COVID19_USAFACTS.DEATHS        d
      ON c."county_fips_code" = d."county_fips_code"
    /* drop pseudo / unallocated rows that use the “00000” FIPS code        */
    WHERE c."county_fips_code" <> '00000'
),
/* ----------------------------------------------------------------------
   2)  2020 ACS 5-Year county demographics
       ‑- keep only counties whose total population > 50,000
------------------------------------------------------------------------ */
demo AS (
    SELECT
        LPAD("county_fips_code",5,'0')            AS "county_fips_code",
        TRIM("county_name")                       AS "county_name",
        "state",
        "total_population"::NUMBER               AS "total_population",
        "median_age"::NUMBER                     AS "median_age"
    FROM CENSUS.ACS5YR_2020.COUNTY
    WHERE "total_population" > 50000
)
/* ----------------------------------------------------------------------
   3)  Combine, derive per-100k metrics & case-fatality rate, then rank
------------------------------------------------------------------------ */
SELECT
    d."county_name",
    d."state",
    d."median_age",
    d."total_population",
    ROUND( (c."confirmed_cases" / d."total_population") * 100000, 2 ) AS "cases_per_100k",
    ROUND( (c."deaths"          / d."total_population") * 100000, 2 ) AS "deaths_per_100k",
    ROUND( (c."deaths" / NULLIF(c."confirmed_cases",0)) * 100 , 4 )   AS "case_fatality_rate_pct"
FROM       covid c
INNER JOIN demo  d
        ON c."county_fips_code" = d."county_fips_code"
ORDER BY "case_fatality_rate_pct" DESC NULLS LAST
LIMIT 3;
```
