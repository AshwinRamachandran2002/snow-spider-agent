```sql
--Description: 6) Join CONFIRMED_CASES and DEATHS to calculate case fatality rate (CFR) for every county on 27-AUG-2020
SELECT 
  c."county_fips_code",
  c."county_name",
  c."state",
  c."_2020_08_27"  AS "cases_aug27",
  d."_2020_08_27"  AS "deaths_aug27",
  CASE 
    WHEN c."_2020_08_27" > 0 
    THEN (d."_2020_08_27" * 100.0) / c."_2020_08_27"
    ELSE NULL 
  END            AS "cfr_percent"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS        d 
  ON c."county_fips_code" = d."county_fips_code"
LIMIT 20;
```

```sql
--Description: 7) Same join as above, but keep only counties with ≥100 confirmed cases to avoid tiny denominators
SELECT 
  c."county_fips_code",
  c."county_name",
  c."state",
  c."_2020_08_27"  AS "cases_aug27",
  d."_2020_08_27"  AS "deaths_aug27",
  ROUND( (d."_2020_08_27" * 100.0) / c."_2020_08_27", 2) AS "cfr_percent"
FROM COVID19_USA.COVID19_USAFACTS.CONFIRMED_CASES c
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS        d 
  ON c."county_fips_code" = d."county_fips_code"
WHERE c."_2020_08_27" >= 100
ORDER BY "cfr_percent" DESC
LIMIT 20;
```

```sql
--Description: 8) Repeat the CFR calculation using the SUMMARY table for 27-AUG-2020
SELECT
  s."county_name",
  s."state",
  s."confirmed_cases"  AS "cases_aug27",
  s."deaths"           AS "deaths_aug27",
  ROUND( (s."deaths" * 100.0) / NULLIF(s."confirmed_cases",0), 2) AS "cfr_percent"
FROM COVID19_USA.COVID19_USAFACTS.SUMMARY s
WHERE s."date" = '2020-08-27'
  AND s."confirmed_cases" >= 100
ORDER BY "cfr_percent" DESC
LIMIT 20;
```

```sql
--Description: 9) Bring in county FIPS to the SUMMARY-based CFR list for easier future joins
SELECT
  d."county_fips_code",
  s."county_name",
  s."state",
  s."confirmed_cases" AS "cases_aug27",
  s."deaths"          AS "deaths_aug27",
  ROUND( (s."deaths" * 100.0) / NULLIF(s."confirmed_cases",0), 2) AS "cfr_percent"
FROM COVID19_USA.COVID19_USAFACTS.SUMMARY s
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS  d 
  ON s."county_name" = d."county_name" 
 AND s."state"       = d."state"
WHERE s."date" = '2020-08-27'
  AND s."confirmed_cases" >= 100
ORDER BY "cfr_percent" DESC
LIMIT 20;
```

```sql
--Description: 10) (Towards final answer) Retrieve the top three counties by CFR on 27-AUG-2020 along with cases & deaths; population/median-age will have to be joined in later once the ACS-2020 data set is located
SELECT
  d."county_fips_code",
  s."county_name",
  s."state",
  s."confirmed_cases" AS "cases_aug27",
  s."deaths"          AS "deaths_aug27",
  ROUND( (s."deaths" * 100.0) / NULLIF(s."confirmed_cases",0), 2) AS "cfr_percent"
FROM COVID19_USA.COVID19_USAFACTS.SUMMARY        s
JOIN COVID19_USA.COVID19_USAFACTS.DEATHS         d
  ON s."county_name" = d."county_name"
 AND s."state"       = d."state"
WHERE s."date" = '2020-08-27'
  AND s."confirmed_cases" >= 100
ORDER BY "cfr_percent" DESC
LIMIT 3;
```
