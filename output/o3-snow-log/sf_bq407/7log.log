```sql
/*-------------------------------------------------------------
  Top-3 U.S. counties (population > 50 000) with the highest
  COVID-19 case-fatality rate on 27-AUG-2020
-------------------------------------------------------------*/
WITH county_cfr AS (          -- 1)  build CFR numbers for 27-AUG-2020
    SELECT
        d."county_fips_code"                                          AS "fips",
        TRIM(s."county_name")                                         AS "county_name",
        s."state",
        CAST(s."confirmed_cases" AS NUMBER)                           AS "confirmed_cases",
        CAST(s."deaths"          AS NUMBER)                           AS "deaths",
        (CAST(s."deaths" AS NUMBER) * 100.0)
        / NULLIF(CAST(s."confirmed_cases" AS NUMBER),0)               AS "cfr_pct"
    FROM COVID19_USA.COVID19_USAFACTS.SUMMARY  s
    JOIN COVID19_USA.COVID19_USAFACTS.DEATHS   d
      ON s."county_name" = d."county_name"
     AND s."state"       = d."state"
    WHERE s."date" = '2020-08-27'
),
acs AS (                       -- 2)  pull 2020 5-year ACS population & median age
    SELECT
        "geoid"                             AS "fips",      -- 5-digit county FIPS
        "state_abbreviation"                AS "state",
        "name"                              AS "county_full_name",
        CAST("population"  AS NUMBER)       AS "population",
        CAST("median_age"  AS NUMBER)       AS "median_age"
    FROM   CENSUS.ACS_5YR_2020.COUNTY
)
SELECT
    cc."county_name"                                            AS "county",
    cc."state",
    acs."median_age",
    acs."population",
    ROUND(cc."confirmed_cases" * 100000.0 / acs."population",2) AS "cases_per_100k",
    ROUND(cc."deaths"          * 100000.0 / acs."population",2) AS "deaths_per_100k",
    ROUND(cc."cfr_pct",2)                                       AS "case_fatality_rate_pct"
FROM   county_cfr cc
JOIN   acs
  ON   cc."fips" = acs."fips"
WHERE  acs."population" > 50000
ORDER  BY cc."cfr_pct" DESC NULLS LAST
LIMIT  3;
```
