Query:
--Description: Calculate net quantity (BUY = +qty, SELL = –qty) per user per month
SELECT
       TO_CHAR(TO_DATE("txn_date", 'DD-MM-YYYY'), 'YYYY-MM') AS "month_flag",
       "member_id",
       SUM( CASE WHEN "txn_type" = 'BUY'  THEN "quantity"
                 WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
            END )                                           AS "net_qty"
FROM "BANK_SALES_TRADING"."BANK_SALES_TRADING"."BITCOIN_TRANSACTIONS"
GROUP BY 1, 2
ORDER BY 1, 2
LIMIT 20;
