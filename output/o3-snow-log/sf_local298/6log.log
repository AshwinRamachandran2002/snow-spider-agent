Query:
--Description: Final step – deliver only months where a valid previous-month total exists,
--using first month solely as baseline (excluded from output)
WITH total_monthly AS (
     SELECT
            "month_flag",
            SUM("adj_balance") AS "total_balance"
     FROM (
          SELECT
                 "member_id",
                 "month_flag",
                 CASE WHEN "running_balance" < 0 THEN 0 ELSE "running_balance" END AS "adj_balance"
          FROM (
               SELECT
                      "member_id",
                      "month_flag",
                      SUM("net_qty") OVER (PARTITION BY "member_id"
                                           ORDER BY "month_flag"
                                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
               FROM (
                    SELECT
                           "member_id",
                           TO_CHAR(TO_DATE("txn_date", 'DD-MM-YYYY'), 'YYYY-MM') AS "month_flag",
                           SUM( CASE WHEN "txn_type" = 'BUY'  THEN "quantity"
                                     WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
                                END ) AS "net_qty"
                    FROM "BANK_SALES_TRADING"."BANK_SALES_TRADING"."BITCOIN_TRANSACTIONS"
                    GROUP BY 1,2
               )
          )
     )
     GROUP BY 1
),
monthly_with_prev AS (
     SELECT
            "month_flag",
            "total_balance",
            LAG("total_balance") OVER (ORDER BY "month_flag") AS "prev_month_total_balance"
     FROM total_monthly
)
SELECT
       "month_flag",
       "prev_month_total_balance"  AS "total_balance_prev_month"
FROM monthly_with_prev
WHERE "prev_month_total_balance" IS NOT NULL   -- exclude the very first month
ORDER BY "month_flag"
LIMIT 20;
