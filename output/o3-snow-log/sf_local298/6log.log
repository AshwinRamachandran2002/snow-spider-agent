```

```sql
--Description: List the distinct transaction dates that exist in the data set
SELECT DISTINCT "txn_date"
FROM "BANK_SALES_TRADING"."BANK_SALES_TRADING"."BITCOIN_TRANSACTIONS"
ORDER BY "txn_date"
LIMIT 20;
```

```sql
--Description: Derive a YYYY-MM flag from each transaction date for easier month based aggregations
SELECT 
       "txn_id",
       "member_id",
       "txn_type",
       "quantity",
       "txn_date",
       TO_DATE("txn_date", 'DD-MM-YYYY')     AS "txn_dt",
       TO_CHAR(TO_DATE("txn_date", 'DD-MM-YYYY'), 'YYYY-MM') AS "month_flag"
FROM "BANK_SALES_TRADING"."BANK_SALES_TRADING"."BITCOIN_TRANSACTIONS"
LIMIT 20;
```

```sql
--Description: Calculate net quantity (BUY = +qty, SELL = –qty) per user per month
SELECT
       TO_CHAR(TO_DATE("txn_date", 'DD-MM-YYYY'), 'YYYY-MM') AS "month_flag",
       "member_id",
       SUM( CASE WHEN "txn_type" = 'BUY'  THEN "quantity"
                 WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
            END )                                           AS "net_qty"
FROM "BANK_SALES_TRADING"."BANK_SALES_TRADING"."BITCOIN_TRANSACTIONS"
GROUP BY 1, 2
ORDER BY 1, 2
LIMIT 20;
```

```sql
--Description: Compute cumulative balance for each user across months
WITH user_months AS (
     SELECT
            "member_id",
            TO_CHAR(TO_DATE("txn_date", 'DD-MM-YYYY'), 'YYYY-MM') AS "month_flag",
            SUM( CASE WHEN "txn_type" = 'BUY'  THEN "quantity"
                      WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
                 END ) AS "net_qty"
     FROM "BANK_SALES_TRADING"."BANK_SALES_TRADING"."BITCOIN_TRANSACTIONS"
     GROUP BY 1,2
)
SELECT
       "member_id",
       "month_flag",
       SUM("net_qty") 
           OVER (PARTITION BY "member_id"
                 ORDER BY "month_flag"
                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
FROM user_months
ORDER BY "member_id", "month_flag"
LIMIT 20;
```

```sql
--Description: Replace any negative running balances with zero (per user, per month)
WITH user_running AS (
     SELECT
            "member_id",
            "month_flag",
            SUM("net_qty") OVER (PARTITION BY "member_id"
                                 ORDER BY "month_flag"
                                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
     FROM (
          SELECT
                 "member_id",
                 TO_CHAR(TO_DATE("txn_date", 'DD-MM-YYYY'), 'YYYY-MM') AS "month_flag",
                 SUM( CASE WHEN "txn_type" = 'BUY'  THEN "quantity"
                           WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
                      END ) AS "net_qty"
          FROM "BANK_SALES_TRADING"."BANK_SALES_TRADING"."BITCOIN_TRANSACTIONS"
          GROUP BY 1,2
     )
)
SELECT
       "member_id",
       "month_flag",
       CASE WHEN "running_balance" < 0 THEN 0 ELSE "running_balance" END AS "adj_balance"
FROM user_running
ORDER BY "month_flag", "member_id"
LIMIT 20;
```

```sql
--Description: Aggregate adjusted balances across ALL users to get total balance per month
WITH monthly_bal AS (
     /* compute adjusted balance (negative → 0) for every user-month */
     SELECT
            "member_id",
            "month_flag",
            CASE WHEN "running_balance" < 0 THEN 0 ELSE "running_balance" END AS "adj_balance"
     FROM (
          SELECT
                 "member_id",
                 "month_flag",
                 SUM("net_qty") OVER (PARTITION BY "member_id"
                                      ORDER BY "month_flag"
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
          FROM (
               SELECT
                      "member_id",
                      TO_CHAR(TO_DATE("txn_date", 'DD-MM-YYYY'), 'YYYY-MM') AS "month_flag",
                      SUM( CASE WHEN "txn_type" = 'BUY'  THEN "quantity"
                                WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
                           END ) AS "net_qty"
               FROM "BANK_SALES_TRADING"."BANK_SALES_TRADING"."BITCOIN_TRANSACTIONS"
               GROUP BY 1,2
          )
     )
)
SELECT
       "month_flag",
       SUM("adj_balance") AS "total_balance"
FROM monthly_bal
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Attach the previous month’s total balance to every month (Lag function)
WITH total_monthly AS (
     /* Uses same logic from previous step to get total balance per month */
     SELECT
            "month_flag",
            SUM("adj_balance") AS "total_balance"
     FROM (
          SELECT
                 "member_id",
                 "month_flag",
                 CASE WHEN "running_balance" < 0 THEN 0 ELSE "running_balance" END AS "adj_balance"
          FROM (
               SELECT
                      "member_id",
                      "month_flag",
                      SUM("net_qty") OVER (PARTITION BY "member_id"
                                           ORDER BY "month_flag"
                                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
               FROM (
                    SELECT
                           "member_id",
                           TO_CHAR(TO_DATE("txn_date", 'DD-MM-YYYY'), 'YYYY-MM') AS "month_flag",
                           SUM( CASE WHEN "txn_type" = 'BUY'  THEN "quantity"
                                     WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
                                END ) AS "net_qty"
                    FROM "BANK_SALES_TRADING"."BANK_SALES_TRADING"."BITCOIN_TRANSACTIONS"
                    GROUP BY 1,2
               )
          )
     )
     GROUP BY 1
)
SELECT
       "month_flag",
       LAG("total_balance") OVER (ORDER BY "month_flag") AS "prev_month_total_balance",
       "total_balance"
FROM total_monthly
ORDER BY "month_flag"
LIMIT 20;
```

```sql
--Description: Final step – deliver only months where a valid previous-month total exists,
--using first month solely as baseline (excluded from output)
WITH total_monthly AS (
     SELECT
            "month_flag",
            SUM("adj_balance") AS "total_balance"
     FROM (
          SELECT
                 "member_id",
                 "month_flag",
                 CASE WHEN "running_balance" < 0 THEN 0 ELSE "running_balance" END AS "adj_balance"
          FROM (
               SELECT
                      "member_id",
                      "month_flag",
                      SUM("net_qty") OVER (PARTITION BY "member_id"
                                           ORDER BY "month_flag"
                                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
               FROM (
                    SELECT
                           "member_id",
                           TO_CHAR(TO_DATE("txn_date", 'DD-MM-YYYY'), 'YYYY-MM') AS "month_flag",
                           SUM( CASE WHEN "txn_type" = 'BUY'  THEN "quantity"
                                     WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
                                END ) AS "net_qty"
                    FROM "BANK_SALES_TRADING"."BANK_SALES_TRADING"."BITCOIN_TRANSACTIONS"
                    GROUP BY 1,2
               )
          )
     )
     GROUP BY 1
),
monthly_with_prev AS (
     SELECT
            "month_flag",
            "total_balance",
            LAG("total_balance") OVER (ORDER BY "month_flag") AS "prev_month_total_balance"
     FROM total_monthly
)
SELECT
       "month_flag",
       "prev_month_total_balance"  AS "total_balance_prev_month"
FROM monthly_with_prev
WHERE "prev_month_total_balance" IS NOT NULL   -- exclude the very first month
ORDER BY "month_flag"
LIMIT 20;
```

