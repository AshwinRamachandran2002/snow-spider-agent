Query:
--Description: Compute cumulative balance for each user across months
WITH user_months AS (
     SELECT
            "member_id",
            TO_CHAR(TO_DATE("txn_date", 'DD-MM-YYYY'), 'YYYY-MM') AS "month_flag",
            SUM( CASE WHEN "txn_type" = 'BUY'  THEN "quantity"
                      WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
                 END ) AS "net_qty"
     FROM "BANK_SALES_TRADING"."BANK_SALES_TRADING"."BITCOIN_TRANSACTIONS"
     GROUP BY 1,2
)
SELECT
       "member_id",
       "month_flag",
       SUM("net_qty") 
           OVER (PARTITION BY "member_id"
                 ORDER BY "month_flag"
                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "running_balance"
FROM user_months
ORDER BY "member_id", "month_flag"
LIMIT 20;
