--Description: 10) Exclude the very first month (baseline) & show final ordered result
WITH monthly_net AS (
  SELECT
    "member_id",
    SUBSTR("txn_date", 7, 4) || '-' || SUBSTR("txn_date", 4, 2)  AS "year_month",
    SUM(
        CASE WHEN "txn_type" = 'BUY'  THEN  "quantity"
             WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
             ELSE 0 END
       )                                                         AS "net_qty_month"
  FROM BANK_SALES_TRADING.BANK_SALES_TRADING.BITCOIN_TRANSACTIONS
  GROUP BY "member_id", "year_month"
), cum_bal AS (
  SELECT
    "member_id",
    "year_month",
    SUM("net_qty_month") OVER (PARTITION BY "member_id"
                               ORDER BY "year_month"
                               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "cumulative_balance"
  FROM monthly_net
), totals AS (
  SELECT
    "year_month",
    SUM("cumulative_balance") AS "total_balance_all_users"
  FROM cum_bal
  GROUP BY "year_month"
), non_negative AS (
  SELECT
    "year_month",
    GREATEST("total_balance_all_users", 0) AS "total_balance_all_users_non_negative"
  FROM totals
), ranked AS (
  SELECT
    "year_month",
    "total_balance_all_users_non_negative",
    ROW_NUMBER() OVER (ORDER BY "year_month") AS "rn"
  FROM non_negative
)
SELECT
  "year_month",
  "total_balance_all_users_non_negative"
FROM ranked
WHERE "rn" > 1     -- drop the very first month (baseline)
ORDER BY "year_month"
LIMIT 20;
