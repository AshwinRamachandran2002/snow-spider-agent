```sql
--Description: 1) Peek at the raw Bitcoin transaction data
SELECT 
  "txn_id",
  "member_id",
  "ticker",
  "txn_date",
  "txn_type",
  "quantity",
  "percentage_fee"
FROM BANK_SALES_TRADING.BANK_SALES_TRADING.BITCOIN_TRANSACTIONS
LIMIT 20;
```

```sql
--Description: 2) List the distinct transaction types that exist
SELECT DISTINCT 
  "txn_type"
FROM BANK_SALES_TRADING.BANK_SALES_TRADING.BITCOIN_TRANSACTIONS
LIMIT 20;
```

```sql
--Description: 3) Check the distinct transaction dates (to see the date range & raw format)
SELECT DISTINCT 
  "txn_date"
FROM BANK_SALES_TRADING.BANK_SALES_TRADING.BITCOIN_TRANSACTIONS
ORDER BY "txn_date"
LIMIT 20;
```

```sql
--Description: 4) Derive a simple YYYY-MM label from the raw “dd-mm-yyyy” text date
SELECT DISTINCT
  SUBSTR("txn_date", 7, 4) || '-' || SUBSTR("txn_date", 4, 2)  AS "year_month"
FROM BANK_SALES_TRADING.BANK_SALES_TRADING.BITCOIN_TRANSACTIONS
ORDER BY "year_month"
LIMIT 20;
```

```sql
--Description: 5) Add an “effective_quantity” (BUY = +qty, SELL = –qty) for each transaction
SELECT
  "txn_id",
  "member_id",
  "txn_date",
  "txn_type",
  CASE WHEN "txn_type" = 'BUY'  THEN  "quantity"
       WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
       ELSE 0 END               AS "effective_quantity"
FROM BANK_SALES_TRADING.BANK_SALES_TRADING.BITCOIN_TRANSACTIONS
LIMIT 20;
```

```sql
--Description: 6) Aggregate net quantity per user per calendar month
SELECT
  "member_id",
  SUBSTR("txn_date", 7, 4) || '-' || SUBSTR("txn_date", 4, 2)  AS "year_month",
  SUM(
      CASE WHEN "txn_type" = 'BUY'  THEN  "quantity"
           WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
           ELSE 0 END
     )                                                         AS "net_qty_month"
FROM BANK_SALES_TRADING.BANK_SALES_TRADING.BITCOIN_TRANSACTIONS
GROUP BY "member_id", "year_month"
ORDER BY "member_id", "year_month"
LIMIT 20;
```

```sql
--Description: 7) Compute each user’s cumulative balance up to and including each month
WITH monthly_net AS (
  SELECT
    "member_id",
    SUBSTR("txn_date", 7, 4) || '-' || SUBSTR("txn_date", 4, 2)  AS "year_month",
    SUM(
        CASE WHEN "txn_type" = 'BUY'  THEN  "quantity"
             WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
             ELSE 0 END
       )                                                         AS "net_qty_month"
  FROM BANK_SALES_TRADING.BANK_SALES_TRADING.BITCOIN_TRANSACTIONS
  GROUP BY "member_id", "year_month"
)
SELECT
  "member_id",
  "year_month",
  SUM("net_qty_month") OVER (PARTITION BY "member_id"
                             ORDER BY "year_month"
                             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "cumulative_balance"
FROM monthly_net
ORDER BY "member_id", "year_month"
LIMIT 20;
```

```sql
--Description: 8) Roll up to get the TOTAL balance across all users at the start of each month
WITH monthly_net AS (
  SELECT
    "member_id",
    SUBSTR("txn_date", 7, 4) || '-' || SUBSTR("txn_date", 4, 2)  AS "year_month",
    SUM(
        CASE WHEN "txn_type" = 'BUY'  THEN  "quantity"
             WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
             ELSE 0 END
       )                                                         AS "net_qty_month"
  FROM BANK_SALES_TRADING.BANK_SALES_TRADING.BITCOIN_TRANSACTIONS
  GROUP BY "member_id", "year_month"
), cum_bal AS (
  SELECT
    "member_id",
    "year_month",
    SUM("net_qty_month") OVER (PARTITION BY "member_id"
                               ORDER BY "year_month"
                               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "cumulative_balance"
  FROM monthly_net
)
SELECT
  "year_month",
  SUM("cumulative_balance") AS "total_balance_all_users"
FROM cum_bal
GROUP BY "year_month"
ORDER BY "year_month"
LIMIT 20;
```

```sql
--Description: 9) Replace any negative TOTAL balances with zero
WITH monthly_net AS (
  SELECT
    "member_id",
    SUBSTR("txn_date", 7, 4) || '-' || SUBSTR("txn_date", 4, 2)  AS "year_month",
    SUM(
        CASE WHEN "txn_type" = 'BUY'  THEN  "quantity"
             WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
             ELSE 0 END
       )                                                         AS "net_qty_month"
  FROM BANK_SALES_TRADING.BANK_SALES_TRADING.BITCOIN_TRANSACTIONS
  GROUP BY "member_id", "year_month"
), cum_bal AS (
  SELECT
    "member_id",
    "year_month",
    SUM("net_qty_month") OVER (PARTITION BY "member_id"
                               ORDER BY "year_month"
                               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "cumulative_balance"
  FROM monthly_net
), totals AS (
  SELECT
    "year_month",
    SUM("cumulative_balance") AS "total_balance_all_users"
  FROM cum_bal
  GROUP BY "year_month"
)
SELECT
  "year_month",
  GREATEST("total_balance_all_users", 0) AS "total_balance_all_users_non_negative"
FROM totals
ORDER BY "year_month"
LIMIT 20;
```

```sql
--Description: 10) Exclude the very first month (baseline) & show final ordered result
WITH monthly_net AS (
  SELECT
    "member_id",
    SUBSTR("txn_date", 7, 4) || '-' || SUBSTR("txn_date", 4, 2)  AS "year_month",
    SUM(
        CASE WHEN "txn_type" = 'BUY'  THEN  "quantity"
             WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
             ELSE 0 END
       )                                                         AS "net_qty_month"
  FROM BANK_SALES_TRADING.BANK_SALES_TRADING.BITCOIN_TRANSACTIONS
  GROUP BY "member_id", "year_month"
), cum_bal AS (
  SELECT
    "member_id",
    "year_month",
    SUM("net_qty_month") OVER (PARTITION BY "member_id"
                               ORDER BY "year_month"
                               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "cumulative_balance"
  FROM monthly_net
), totals AS (
  SELECT
    "year_month",
    SUM("cumulative_balance") AS "total_balance_all_users"
  FROM cum_bal
  GROUP BY "year_month"
), non_negative AS (
  SELECT
    "year_month",
    GREATEST("total_balance_all_users", 0) AS "total_balance_all_users_non_negative"
  FROM totals
), ranked AS (
  SELECT
    "year_month",
    "total_balance_all_users_non_negative",
    ROW_NUMBER() OVER (ORDER BY "year_month") AS "rn"
  FROM non_negative
)
SELECT
  "year_month",
  "total_balance_all_users_non_negative"
FROM ranked
WHERE "rn" > 1     -- drop the very first month (baseline)
ORDER BY "year_month"
LIMIT 20;
```
