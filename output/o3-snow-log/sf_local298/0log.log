--Description: 7) Compute each user’s cumulative balance up to and including each month
WITH monthly_net AS (
  SELECT
    "member_id",
    SUBSTR("txn_date", 7, 4) || '-' || SUBSTR("txn_date", 4, 2)  AS "year_month",
    SUM(
        CASE WHEN "txn_type" = 'BUY'  THEN  "quantity"
             WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
             ELSE 0 END
       )                                                         AS "net_qty_month"
  FROM BANK_SALES_TRADING.BANK_SALES_TRADING.BITCOIN_TRANSACTIONS
  GROUP BY "member_id", "year_month"
)
SELECT
  "member_id",
  "year_month",
  SUM("net_qty_month") OVER (PARTITION BY "member_id"
                             ORDER BY "year_month"
                             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "cumulative_balance"
FROM monthly_net
ORDER BY "member_id", "year_month"
LIMIT 20;
