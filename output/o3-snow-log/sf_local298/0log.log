--Description: 5) Add an “effective_quantity” (BUY = +qty, SELL = –qty) for each transaction
SELECT
  "txn_id",
  "member_id",
  "txn_date",
  "txn_type",
  CASE WHEN "txn_type" = 'BUY'  THEN  "quantity"
       WHEN "txn_type" = 'SELL' THEN -1 * "quantity"
       ELSE 0 END               AS "effective_quantity"
