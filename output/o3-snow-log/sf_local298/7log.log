--Description: Join every member to the PREVIOUS-month total balance figure.
--   • Re-build monthly totals (same logic as before: month_net → member_bal → member_bal_clean → total_bal).  
--   • In prev_bal, use LAG inside the SELECT and QUALIFY to discard the first month (avoids the
--     “window function appears outside …” error).  
--   • CROSS-JOIN all members to those month rows so each member can see the same
--     previous-month total (purely for inspection).  
--   • Show 20 rows for a quick check.

WITH month_net AS (          -- net qty per member per month (BUY +, SELL −)
    SELECT
        "member_id",
        SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4) AS "month_yyyy",
        SUM(
            CASE WHEN "txn_type" ILIKE '%BUY%'  THEN "quantity"
                 WHEN "txn_type" ILIKE '%SELL%' THEN -1 * "quantity"
                 ELSE 0 END
        ) AS "net_qty_month"
    FROM BANK_SALES_TRADING.BANK_SALES_TRADING."BITCOIN_TRANSACTIONS"
    GROUP BY "member_id",
             SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)
), member_bal AS (           -- cumulative balance per member
    SELECT
        "member_id",
        "month_yyyy",
        SUM("net_qty_month") OVER (
            PARTITION BY "member_id"
            ORDER BY "month_yyyy"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS "balance_eom"
    FROM month_net
), member_bal_clean AS (     -- clamp negatives to 0
    SELECT
        "member_id",
        "month_yyyy",
        CASE WHEN "balance_eom" < 0 THEN 0 ELSE "balance_eom" END AS "balance_eom_no_negative"
    FROM member_bal
), total_bal AS (            -- total balance across all users each month
    SELECT
        "month_yyyy",
        SUM("balance_eom_no_negative") AS "total_balance_eom_all_users"
    FROM member_bal_clean
    GROUP BY "month_yyyy"
), prev_bal AS (             -- previous-month totals (drop first month with QUALIFY)
    SELECT
        "month_yyyy",
        LAG("total_balance_eom_all_users") OVER (ORDER BY "month_yyyy") AS "total_balance_prev_month"
    FROM total_bal
    QUALIFY LAG("total_balance_eom_all_users") OVER (ORDER BY "month_yyyy") IS NOT NULL
)
SELECT
    m."member_id",
    p."month_yyyy",
    p."total_balance_prev_month"
FROM BANK_SALES_TRADING.BANK_SALES_TRADING."BITCOIN_MEMBERS" m
CROSS JOIN prev_bal p                -- each member sees same previous-month total
ORDER BY p."month_yyyy", m."member_id"
LIMIT 20;
