--Description / Thinking process:  
-- 1. From BITCOIN_TRANSACTIONS, derive a month key (MM-YYYY) and calculate each member’s
--    net quantity per month (BUY = +qty, SELL = −qty).                                       [CTE month_net]
-- 2. Convert those monthly nets into a running (cumulative) balance for every member,        [CTE member_bal]
--    ordered by month.  
-- 3. Force any negative cumulative balance to zero so no user can go below 0.               [CTE member_bal_clean]
-- 4. Sum the cleaned balances across all members to obtain the month-end total balance.     [CTE total_bal]
-- 5. Use LAG to fetch the total balance from the previous month for each row; then
--    QUALIFY to exclude the first month (which has no prior month).  
-- 6. Return the results sorted by month (ascending) and limit to 20 for quick inspection.

WITH month_net AS (          -- step-1: net qty per member per month
    SELECT
        "member_id",
        SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4) AS "month_yyyy",
        SUM(
            CASE WHEN "txn_type" ILIKE '%BUY%'  THEN "quantity"
                 WHEN "txn_type" ILIKE '%SELL%' THEN -1 * "quantity"
                 ELSE 0 END
        ) AS "net_qty_month"
    FROM BANK_SALES_TRADING.BANK_SALES_TRADING."BITCOIN_TRANSACTIONS"
    GROUP BY "member_id",
             SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)
),
member_bal AS (              -- step-2: cumulative balance per member
    SELECT
        "member_id",
        "month_yyyy",
        SUM("net_qty_month") OVER (
            PARTITION BY "member_id"
            ORDER BY "month_yyyy"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS "balance_eom"
    FROM month_net
),
member_bal_clean AS (        -- step-3: clamp negatives to zero
    SELECT
        "member_id",
        "month_yyyy",
        CASE WHEN "balance_eom" < 0 THEN 0 ELSE "balance_eom" END AS "balance_eom_no_negative"
    FROM member_bal
),
total_bal AS (               -- step-4: total end-of-month balance across all users
    SELECT
        "month_yyyy",
        SUM("balance_eom_no_negative") AS "total_balance_eom_all_users"
    FROM member_bal_clean
    GROUP BY "month_yyyy"
)
SELECT                        -- step-5 + 6: previous-month total (exclude first month)
    "month_yyyy",
    LAG("total_balance_eom_all_users") OVER (ORDER BY "month_yyyy") AS "total_balance_prev_month"
FROM total_bal
QUALIFY LAG("total_balance_eom_all_users") OVER (ORDER BY "month_yyyy") IS NOT NULL
ORDER BY "month_yyyy"
LIMIT 20;
