```sql
--Description:  Derive a simple month-key (dd-mm-yyyy ➜ mm-yyyy) and list all months present  
SELECT DISTINCT 
  SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4) AS "month_yyyy"
FROM BANK_SALES_TRADING.BANK_SALES_TRADING."BITCOIN_TRANSACTIONS"
ORDER BY "month_yyyy"
LIMIT 20;
```

```sql
--Description:  Calculate the net quantity per member per month  
--              (BUY = +quantity, SELL = -quantity)  
SELECT
  "member_id",
  SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)  AS "month_yyyy",
  SUM(CASE WHEN "txn_type" ILIKE '%BUY%'  THEN "quantity"
           WHEN "txn_type" ILIKE '%SELL%' THEN -1 * "quantity"
           ELSE 0 END) AS "net_qty_month"
FROM BANK_SALES_TRADING.BANK_SALES_TRADING."BITCOIN_TRANSACTIONS"
GROUP BY "member_id", SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)
ORDER BY "member_id", "month_yyyy"
LIMIT 20;
```

```sql
--Description:  Build running (cumulative) balances for each member by month  
WITH month_txn AS (
  SELECT
    "member_id",
    SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)  AS "month_yyyy",
    SUM(CASE WHEN "txn_type" ILIKE '%BUY%'  THEN "quantity"
             WHEN "txn_type" ILIKE '%SELL%' THEN -1 * "quantity"
             ELSE 0 END) AS "net_qty_month"
  FROM BANK_SALES_TRADING.BANK_SALES_TRADING."BITCOIN_TRANSACTIONS"
  GROUP BY "member_id", SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)
)
SELECT
  "member_id",
  "month_yyyy",
  SUM("net_qty_month") OVER (PARTITION BY "member_id"
                             ORDER BY "month_yyyy"
                             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "balance_eom"
FROM month_txn
ORDER BY "member_id", "month_yyyy"
LIMIT 20;
```

```sql
--Description:  Replace any negative month-end balances with zero  
WITH cte_bal AS (
  /* same cumulative balance logic as previous step */
  SELECT
    "member_id",
    "month_yyyy",
    SUM("net_qty_month") OVER (PARTITION BY "member_id"
                               ORDER BY "month_yyyy"
                               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "balance_eom"
  FROM (
      SELECT
        "member_id",
        SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)  AS "month_yyyy",
        SUM(CASE WHEN "txn_type" ILIKE '%BUY%'  THEN "quantity"
                 WHEN "txn_type" ILIKE '%SELL%' THEN -1 * "quantity"
                 ELSE 0 END) AS "net_qty_month"
      FROM BANK_SALES_TRADING.BANK_SALES_TRADING."BITCOIN_TRANSACTIONS"
      GROUP BY "member_id", SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)
  )
)
SELECT
  "member_id",
  "month_yyyy",
  CASE WHEN "balance_eom" < 0 THEN 0 ELSE "balance_eom" END AS "balance_eom_no_negative"
FROM cte_bal
ORDER BY "member_id", "month_yyyy"
LIMIT 20;
```

```sql
--Description:  Aggregate the (non-negative) balances across ALL users for each month  
WITH cte_bal_adj AS (
  /* derive balance per user & replace negatives with zero */
  SELECT
    "member_id",
    "month_yyyy",
    CASE WHEN "balance_eom" < 0 THEN 0 ELSE "balance_eom" END AS "balance_eom_no_negative"
  FROM (
      SELECT
        "member_id",
        "month_yyyy",
        SUM("net_qty_month") OVER (PARTITION BY "member_id"
                                   ORDER BY "month_yyyy"
                                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "balance_eom"
      FROM (
          SELECT
            "member_id",
            SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)  AS "month_yyyy",
            SUM(CASE WHEN "txn_type" ILIKE '%BUY%' THEN "quantity"
                     WHEN "txn_type" ILIKE '%SELL%' THEN -1 * "quantity"
                     ELSE 0 END) AS "net_qty_month"
          FROM BANK_SALES_TRADING.BANK_SALES_TRADING."BITCOIN_TRANSACTIONS"
          GROUP BY "member_id", SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)
      )
  )
)
SELECT
  "month_yyyy",
  SUM("balance_eom_no_negative") AS "total_balance_eom_all_users"
FROM cte_bal_adj
GROUP BY "month_yyyy"
ORDER BY "month_yyyy"
LIMIT 20;
```

```sql
--Description:  Pull the previous-month total balance for every month (excluding the very first one)  
WITH tot_bal AS (   /* re-use previous aggregation logic */
  SELECT
    "month_yyyy",
    SUM("balance_eom_no_negative") AS "total_balance_eom_all_users"
  FROM (
      /* same cte_bal_adj logic shown earlier */
      SELECT
        "member_id",
        "month_yyyy",
        CASE WHEN "balance_eom" < 0 THEN 0 ELSE "balance_eom" END AS "balance_eom_no_negative"
      FROM (
          SELECT
            "member_id",
            "month_yyyy",
            SUM("net_qty_month") OVER (PARTITION BY "member_id"
                                       ORDER BY "month_yyyy"
                                       ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "balance_eom"
          FROM (
              SELECT
                "member_id",
                SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)  AS "month_yyyy",
                SUM(CASE WHEN "txn_type" ILIKE '%BUY%' THEN "quantity"
                         WHEN "txn_type" ILIKE '%SELL%' THEN -1 * "quantity"
                         ELSE 0 END) AS "net_qty_month"
              FROM BANK_SALES_TRADING.BANK_SALES_TRADING."BITCOIN_TRANSACTIONS"
              GROUP BY "member_id", SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)
          )
      )
  )
  GROUP BY "month_yyyy"
)
SELECT
  "month_yyyy",
  LAG("total_balance_eom_all_users") OVER (ORDER BY "month_yyyy") AS "total_balance_prev_month"
FROM tot_bal
WHERE LAG("total_balance_eom_all_users") OVER (ORDER BY "month_yyyy") IS NOT NULL   -- drops first month
ORDER BY "month_yyyy";
```

```sql
--Description:  Join the final previous-month totals back to members (optional exploration)  
SELECT
  m."member_id",
  b."month_yyyy",
  p."total_balance_prev_month"
FROM BANK_SALES_TRADING.BANK_SALES_TRADING."BITCOIN_MEMBERS" m
JOIN (
    /* simplified version using the previous query as inline view */
    SELECT
      "month_yyyy",
      LAG("total_balance_eom_all_users") OVER (ORDER BY "month_yyyy") AS "total_balance_prev_month"
    FROM (
        SELECT
          SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)  AS "month_yyyy",
          SUM(CASE WHEN "txn_type" ILIKE '%BUY%' THEN "quantity"
                   WHEN "txn_type" ILIKE '%SELL%' THEN -1 * "quantity"
                   ELSE 0 END) AS "net_qty"
        FROM BANK_SALES_TRADING.BANK_SALES_TRADING."BITCOIN_TRANSACTIONS"
        GROUP BY SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)
    )
) p ON 1=1   -- cross join to show same figure for every member for inspection
LEFT JOIN (
    /* optional: user specific balances - keeping it small */
    SELECT
      "member_id",
      SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4) AS "month_yyyy",
      SUM(CASE WHEN "txn_type" ILIKE '%BUY%' THEN "quantity"
               WHEN "txn_type" ILIKE '%SELL%' THEN -1 * "quantity"
               ELSE 0 END) AS "net_qty"
    FROM BANK_SALES_TRADING.BANK_SALES_TRADING."BITCOIN_TRANSACTIONS"
    GROUP BY "member_id", SUBSTR("txn_date",4,2) || '-' || SUBSTR("txn_date",7,4)
) b 
  ON m."member_id" = b."member_id"
  AND p."month_yyyy" = b."month_yyyy"
ORDER BY b."month_yyyy", m."member_id"
LIMIT 20;
```
