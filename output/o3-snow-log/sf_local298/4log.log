--Description: Build monthly totals and fetch the previous-month balance with a single LAG.
-- Steps
-- 1) month_nets : net cash flow (deposit – withdrawal) for each customer in each calendar month.
-- 2) cust_bal   : running cumulative balance per customer, but never below zero (GREATEST with 0).
-- 3) month_tot  : total zero-floored balance across all customers for every month-start date.
-- 4) final_chk  : apply LAG to month_tot to retrieve the prior month’s total balance, so
--                 month N shows the balance that existed at month N-1.  The first month’s
--                 LAG result is NULL by definition and therefore excluded.
-- The output lets us confirm values quickly and ensures no negatives appear.

WITH month_nets AS (
    SELECT  "customer_id",
            TO_DATE(SUBSTR("txn_date", 1, 7) || '-01') AS "month_start",
            SUM(
                CASE
                    WHEN "txn_type" ILIKE '%deposit%'   THEN  "txn_amount"
                    WHEN "txn_type" ILIKE '%withdraw%'  THEN -1 * "txn_amount"
                    ELSE 0
                END
            ) AS "net_amt"
    FROM   BANK_SALES_TRADING.BANK_SALES_TRADING."CUSTOMER_TRANSACTIONS"
    GROUP  BY "customer_id",
             TO_DATE(SUBSTR("txn_date", 1, 7) || '-01')
), cust_bal AS (
    SELECT  "customer_id",
            "month_start",
            GREATEST(
                SUM("net_amt") OVER (
                    PARTITION BY "customer_id"
                    ORDER BY     "month_start"
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
                ),
                0
            ) AS "balance"
    FROM    month_nets
), month_tot AS (
    SELECT  "month_start",
            SUM("balance") AS "total_balance"
    FROM    cust_bal
    GROUP  BY "month_start"
), final_chk AS (
    SELECT  "month_start",
            LAG("total_balance") OVER (ORDER BY "month_start") AS "previous_month_total_balance"
    FROM    month_tot
)
SELECT *
FROM   final_chk
WHERE  "previous_month_total_balance" IS NOT NULL   -- skip the baseline month
ORDER  BY "month_start"
LIMIT  20;
