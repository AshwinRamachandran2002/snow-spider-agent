--4. Description: Net movement (deposits minus withdrawals) by customer and month
SELECT "customer_id",
       SUBSTR("txn_date",1,7)              AS "year_month",
       SUM(CASE WHEN "txn_type" ILIKE '%deposit%'   THEN "txn_amount"
                WHEN "txn_type" ILIKE '%withdraw%'  THEN -1 * "txn_amount"
                ELSE 0 END)                AS "net_amount"
