--Description: (#8)  Identify the very first month in the transaction history (baseline)
SELECT  MIN("month_start") AS "baseline_month"
FROM   (
           SELECT TO_DATE(SUBSTR("txn_date",1,7) || '-01') AS "month_start"
           FROM   BANK_SALES_TRADING.BANK_SALES_TRADING."CUSTOMER_TRANSACTIONS"
       ) t
