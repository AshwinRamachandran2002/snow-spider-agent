--    “total_balance” figure per month.
-- 4) final_out   : for every month AFTER the very first, report the previous-month’s total
--    balance (i.e., balance as at month N-1, shown under month N).  This meets the requirement
--    of “calculated as of the 1st of each month” and omits the baseline month itself.
-- 5) Result is ordered chronologically; LIMIT applied simply to keep output short for inspection.

WITH month_nets AS (
    SELECT  "customer_id",
            TO_DATE(SUBSTR("txn_date", 1, 7) || '-01') AS "month_start",
            SUM(
                CASE
                    WHEN "txn_type" ILIKE '%deposit%'   THEN  "txn_amount"
                    WHEN "txn_type" ILIKE '%withdraw%'  THEN -1 * "txn_amount"
                    ELSE 0
                END
            ) AS "net_amt"
    FROM   BANK_SALES_TRADING.BANK_SALES_TRADING."CUSTOMER_TRANSACTIONS"
    GROUP  BY "customer_id",
             TO_DATE(SUBSTR("txn_date", 1, 7) || '-01')
), cust_bal AS (
    SELECT  "customer_id",
            "month_start",
            -- cumulative balance per customer, floored at 0
            GREATEST(
                SUM("net_amt") OVER (
                    PARTITION BY "customer_id"
                    ORDER BY     "month_start"
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
                ),
                0
            ) AS "balance"
    FROM    month_nets
), month_tot AS (
    SELECT  "month_start",
            SUM("balance") AS "total_balance"
    FROM    cust_bal
    GROUP   BY "month_start"
), final_out AS (
    SELECT  curr."month_start"                            AS "month",
            prev."total_balance"                          AS "previous_month_total_balance"
    FROM    month_tot curr
    JOIN    month_tot prev
           ON prev."month_start" = DATEADD(MONTH, -1, curr."month_start")
)
SELECT *
FROM   final_out
ORDER  BY "month"
LIMIT  20;
