```sql
--4. Description: Net movement (deposits minus withdrawals) by customer and month
SELECT "customer_id",
       SUBSTR("txn_date",1,7)              AS "year_month",
       SUM(CASE WHEN "txn_type" ILIKE '%deposit%'   THEN "txn_amount"
                WHEN "txn_type" ILIKE '%withdraw%'  THEN -1 * "txn_amount"
                ELSE 0 END)                AS "net_amount"
FROM   BANK_SALES_TRADING.BANK_SALES_TRADING."CUSTOMER_TRANSACTIONS"
GROUP  BY "customer_id", SUBSTR("txn_date",1,7)
ORDER  BY "customer_id", "year_month"
LIMIT  20;
```

```sql
--5. Description: Cumulative balance for every customer measured on the first day of each month
WITH month_nets AS (
  SELECT "customer_id",
         TO_DATE(SUBSTR("txn_date",1,7)||'-01')      AS "month_start",
         SUM(CASE WHEN "txn_type" ILIKE '%deposit%'   THEN "txn_amount"
                  WHEN "txn_type" ILIKE '%withdraw%'  THEN -1 * "txn_amount"
                  ELSE 0 END)                        AS "net_amount"
  FROM   BANK_SALES_TRADING.BANK_SALES_TRADING."CUSTOMER_TRANSACTIONS"
  GROUP  BY "customer_id", SUBSTR("txn_date",1,7")
)
SELECT  "customer_id",
        "month_start",
        SUM("net_amount") OVER (PARTITION BY "customer_id"
                                ORDER BY "month_start"
                                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "balance_as_of_month"
FROM     month_nets
ORDER BY "customer_id", "month_start"
LIMIT    20;
```

```sql
--6. Description: Replace any negative balances with zero (customer-month level)
WITH cum_bal AS (
  SELECT  "customer_id",
          "month_start",
          SUM("net_amount") OVER (PARTITION BY "customer_id"
                                  ORDER BY "month_start"
                                  ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "balance"
  FROM   (
      SELECT "customer_id",
             TO_DATE(SUBSTR("txn_date",1,7)||'-01') AS "month_start",
             SUM(CASE WHEN "txn_type" ILIKE '%deposit%'   THEN "txn_amount"
                      WHEN "txn_type" ILIKE '%withdraw%'  THEN -1*"txn_amount"
                      ELSE 0 END)                     AS "net_amount"
      FROM   BANK_SALES_TRADING.BANK_SALES_TRADING."CUSTOMER_TRANSACTIONS"
      GROUP  BY "customer_id", SUBSTR("txn_date",1,7")
  )
)
SELECT  "customer_id",
        "month_start",
        CASE WHEN "balance" < 0 THEN 0 ELSE "balance" END AS "adjusted_balance"
FROM    cum_bal
ORDER BY "customer_id", "month_start"
LIMIT   20;
```

```sql
--7. Description: Total balance across ALL customers for each month (after negatives set to zero)
WITH cum_bal AS (
  SELECT  "customer_id",
          "month_start",
          SUM("net_amount") OVER (PARTITION BY "customer_id"
                                  ORDER BY "month_start"
                                  ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "balance"
  FROM   (
      SELECT "customer_id",
             TO_DATE(SUBSTR("txn_date",1,7)||'-01') AS "month_start",
             SUM(CASE WHEN "txn_type" ILIKE '%deposit%'   THEN "txn_amount"
                      WHEN "txn_type" ILIKE '%withdraw%'  THEN -1*"txn_amount"
                      ELSE 0 END)                     AS "net_amount"
      FROM   BANK_SALES_TRADING.BANK_SALES_TRADING."CUSTOMER_TRANSACTIONS"
      GROUP  BY "customer_id", SUBSTR("txn_date",1,7")
  )
)
SELECT  "month_start",
        SUM(CASE WHEN "balance" < 0 THEN 0 ELSE "balance" END) AS "total_balance"
FROM    cum_bal
GROUP BY "month_start"
ORDER BY "month_start"
LIMIT   20;
```

```sql
--8. Description: Determine the very first month in the series to use purely as baseline
SELECT MIN("month_start") AS "baseline_month"
FROM  (
  SELECT TO_DATE(SUBSTR("txn_date",1,7)||'-01') AS "month_start"
  FROM   BANK_SALES_TRADING.BANK_SALES_TRADING."CUSTOMER_TRANSACTIONS"
)
LIMIT  20;
```

```sql
--9. Description: Final result – previous-month total balances, negatives zeroed, excluding first month
WITH month_series AS (
  SELECT  TO_DATE(SUBSTR("txn_date",1,7)||'-01') AS "month_start"
  FROM    BANK_SALES_TRADING.BANK_SALES_TRADING."CUSTOMER_TRANSACTIONS"
  GROUP   BY TO_DATE(SUBSTR("txn_date",1,7)||'-01")
),
total_bal AS (
  /* reuse query from step 7 */
  WITH cum_bal AS (
    SELECT  "customer_id",
            "month_start",
            SUM("net_amount") OVER (PARTITION BY "customer_id"
                                    ORDER BY "month_start"
                                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "balance"
    FROM   (
        SELECT "customer_id",
               TO_DATE(SUBSTR("txn_date",1,7)||'-01') AS "month_start",
               SUM(CASE WHEN "txn_type" ILIKE '%deposit%'   THEN "txn_amount"
                        WHEN "txn_type" ILIKE '%withdraw%'  THEN -1*"txn_amount"
                        ELSE 0 END)                     AS "net_amount"
        FROM   BANK_SALES_TRADING.BANK_SALES_TRADING."CUSTOMER_TRANSACTIONS"
        GROUP  BY "customer_id", SUBSTR("txn_date",1,7")
    )
  )
  SELECT  "month_start",
          SUM(CASE WHEN "balance" < 0 THEN 0 ELSE "balance" END) AS "total_balance"
  FROM    cum_bal
  GROUP BY "month_start"
)
SELECT  t1."month_start"                           AS "current_month_start",
        t2."total_balance"                         AS "previous_month_total_balance"
FROM    month_series t1
JOIN    total_bal    t2
        ON t2."month_start" = DATEADD(MONTH,-1,t1."month_start")
WHERE   t1."month_start" > (SELECT MIN("month_start") FROM month_series) --exclude first month
ORDER BY t1."current_month_start"
LIMIT   20;
```

