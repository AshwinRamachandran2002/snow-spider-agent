{'DB_IMDB': {'DB_IMDB': ['COUNTRY', 'M_GENRE', 'M_LANGUAGE', 'LOCATION', 'MOVIE', 'M_DIRECTOR', 'M_LOCATION', 'M_PRODUCER', 'LANGUAGE', 'PERSON', 'GENRE', 'M_CAST', 'M_COUNTRY']}}

