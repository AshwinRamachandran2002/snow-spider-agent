```sql
--Description: From those movies pull the second-degree actor PIDs (anyone who acted with a first-degree co-actor).
WITH first_deg AS (
      SELECT DISTINCT c2."PID"
      FROM DB_IMDB.DB_IMDB.M_CAST c1
      JOIN DB_IMDB.DB_IMDB.M_CAST c2 
            ON c1."MID" = c2."MID"
      WHERE c1."PID" = '<SRK_PID>'
        AND c2."PID" <> '<SRK_PID>')
SELECT DISTINCT 
    mc2."PID"  AS "SECOND_DEG_PID"
FROM DB_IMDB.DB_IMDB.M_CAST mc1         -- first-degree actor’s row
JOIN DB_IMDB.DB_IMDB.M_CAST mc2         -- their co-actors
      ON mc1."MID" = mc2."MID"
WHERE mc1."PID" IN (SELECT * FROM first_deg)
LIMIT 20;
```

```sql
--Description: Attach names to those second-degree PIDs so we can read them.
WITH first_deg AS (
      SELECT DISTINCT c2."PID"
      FROM DB_IMDB.DB_IMDB.M_CAST c1
      JOIN DB_IMDB.DB_IMDB.M_CAST c2 
            ON c1."MID" = c2."MID"
      WHERE c1."PID" = '<SRK_PID>'
        AND c2."PID" <> '<SRK_PID>')
SELECT DISTINCT 
    p."PID",
    p."Name"
FROM DB_IMDB.DB_IMDB.PERSON p
JOIN DB_IMDB.DB_IMDB.M_CAST mc
      ON p."PID" = mc."PID"
WHERE p."PID" IN (
      SELECT DISTINCT mc2."PID"
      FROM DB_IMDB.DB_IMDB.M_CAST mc1
      JOIN DB_IMDB.DB_IMDB.M_CAST mc2
            ON mc1."MID" = mc2."MID"
      WHERE mc1."PID" IN (SELECT * FROM first_deg))
LIMIT 20;
```

```sql
--Description: Remove everyone who is either Shahrukh Khan or a first-degree co-actor to keep only pure second-degree actors.
WITH
    srk     AS (SELECT '<SRK_PID>' AS "PID"),
    first_deg AS (
        SELECT DISTINCT c2."PID"
        FROM DB_IMDB.DB_IMDB.M_CAST c1
        JOIN DB_IMDB.DB_IMDB.M_CAST c2 
              ON c1."MID" = c2."MID"
        WHERE c1."PID" = (SELECT "PID" FROM srk)
          AND c2."PID" <> (SELECT "PID" FROM srk)
    ),
    second_deg_raw AS (
        SELECT DISTINCT mc2."PID"
        FROM DB_IMDB.DB_IMDB.M_CAST mc1
        JOIN DB_IMDB.DB_IMDB.M_CAST mc2
              ON mc1."MID" = mc2."MID"
        WHERE mc1."PID" IN (SELECT "PID" FROM first_deg)
    )
SELECT DISTINCT
    p."PID",
    p."Name"
FROM DB_IMDB.DB_IMDB.PERSON p
WHERE p."PID" IN (SELECT "PID" FROM second_deg_raw)
  AND p."PID" NOT IN (SELECT "PID" FROM first_deg)
  AND p."PID" <> (SELECT "PID" FROM srk)
LIMIT 20;
```

```sql
--Description: Count how many distinct actors have a “Shahrukh number” of 2 (second-degree, not first-degree, not SRK).
WITH
    srk     AS (SELECT '<SRK_PID>' AS "PID"),
    first_deg AS (
        SELECT DISTINCT c2."PID"
        FROM DB_IMDB.DB_IMDB.M_CAST c1
        JOIN DB_IMDB.DB_IMDB.M_CAST c2 
              ON c1."MID" = c2."MID"
        WHERE c1."PID" = (SELECT "PID" FROM srk)
          AND c2."PID" <> (SELECT "PID" FROM srk)
    ),
    second_deg_raw AS (
        SELECT DISTINCT mc2."PID"
        FROM DB_IMDB.DB_IMDB.M_CAST mc1
        JOIN DB_IMDB.DB_IMDB.M_CAST mc2
              ON mc1."MID" = mc2."MID"
        WHERE mc1."PID" IN (SELECT "PID" FROM first_deg)
    )
SELECT 
    COUNT(DISTINCT "PID") AS "Shahrukh_Number_2_Count"
FROM second_deg_raw
WHERE "PID" NOT IN (SELECT "PID" FROM first_deg)
  AND "PID" <> (SELECT "PID" FROM srk);
```
