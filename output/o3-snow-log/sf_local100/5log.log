--Description: Display titles and years for all movies in which Shah Rukh Khan appears (dynamic PID lookup, trimming blanks).
SELECT DISTINCT
       m."MID",
       m."title",
       m."year"
FROM DB_IMDB.DB_IMDB.MOVIE  m
JOIN DB_IMDB.DB_IMDB.M_CAST c
         ON m."MID" = c."MID"
WHERE TRIM(c."PID") IN (               -- Shah Rukh Khan’s PID(s)
      SELECT TRIM(p."PID")
      FROM DB_IMDB.DB_IMDB.PERSON p
      WHERE LOWER(TRIM(p."Name")) LIKE '%rukh%khan%')
