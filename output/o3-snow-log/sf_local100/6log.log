--Description: Aggregate everything with CTEs and COUNT the actors whose Shahrukh-number is exactly 2
WITH shahrukh AS (
     SELECT "PID"
     FROM   DB_IMDB.DB_IMDB.PERSON
     WHERE  "Name" ILIKE '%Shahrukh%Khan%'
),
shahrukh_movies AS (
     SELECT DISTINCT "MID"
     FROM   DB_IMDB.DB_IMDB.M_CAST
     WHERE  "PID" IN ( SELECT "PID" FROM shahrukh )
),
first_degree AS (
     SELECT DISTINCT "PID"
     FROM   DB_IMDB.DB_IMDB.M_CAST
     WHERE  "MID" IN ( SELECT "MID" FROM shahrukh_movies )
     AND    "PID" NOT IN ( SELECT "PID" FROM shahrukh )
),
movies_of_first_degree AS (
     SELECT DISTINCT "MID"
     FROM   DB_IMDB.DB_IMDB.M_CAST
     WHERE  "PID" IN ( SELECT "PID" FROM first_degree )
     AND    "MID" NOT IN ( SELECT "MID" FROM shahrukh_movies )
),
second_degree AS (
     SELECT DISTINCT "PID"
     FROM   DB_IMDB.DB_IMDB.M_CAST
     WHERE  "MID" IN ( SELECT "MID" FROM movies_of_first_degree )
     AND    "PID" NOT IN ( SELECT "PID" FROM first_degree )
     AND    "PID" NOT IN ( SELECT "PID" FROM shahrukh )
)
SELECT COUNT(*) AS "shahrukh_number_2_count"
FROM   second_degree;
