--Description: The previous IN-filter failed because IDs inside M_CAST often carry leading blanks 
--(e.g. ' nm0451234'), while PERSON.PID is stored without them.  
--By joining the two tables and TRIM-ming both sides we can verify which “Khan” actors are
--actually present in the cast list and see the movie IDs they appear in.
SELECT DISTINCT mc."MID",
                TRIM(mc."PID") AS "PID",
                p."Name"
FROM   DB_IMDB.DB_IMDB.M_CAST  mc
JOIN   DB_IMDB.DB_IMDB.PERSON  p
       ON TRIM(mc."PID") = TRIM(p."PID")
WHERE  p."Name" ILIKE '%Khan%'
LIMIT 20;
