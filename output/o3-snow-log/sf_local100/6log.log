--Description: Aggregate logic with CTEs and COUNT actors whose Khan-number is exactly 2.
WITH khan_pids AS (
     SELECT "PID" FROM DB_IMDB.DB_IMDB.PERSON WHERE "Name" ILIKE '%Khan%'
),
movies_with_khan AS (
     SELECT DISTINCT mc."MID"
     FROM   DB_IMDB.DB_IMDB.M_CAST mc
     JOIN   khan_pids kp ON TRIM(mc."PID") = kp."PID"
),
first_degree_pids AS (
     SELECT DISTINCT TRIM(mc1."PID") AS "PID"
     FROM   DB_IMDB.DB_IMDB.M_CAST mc1
     WHERE  mc1."MID" IN ( SELECT "MID" FROM movies_with_khan )
     AND    TRIM(mc1."PID") NOT IN ( SELECT "PID" FROM khan_pids )
),
movies_of_first_degree AS (
     SELECT DISTINCT mc2."MID"
     FROM   DB_IMDB.DB_IMDB.M_CAST mc2
     WHERE  TRIM(mc2."PID") IN ( SELECT "PID" FROM first_degree_pids )
     AND    mc2."MID" NOT IN ( SELECT "MID" FROM movies_with_khan )
),
second_degree_pids AS (
     SELECT DISTINCT TRIM(mc3."PID") AS "PID"
     FROM   DB_IMDB.DB_IMDB.M_CAST mc3
     WHERE  mc3."MID" IN ( SELECT "MID" FROM movies_of_first_degree )
     AND    TRIM(mc3."PID") NOT IN ( SELECT "PID" FROM khan_pids )
     AND    TRIM(mc3."PID") NOT IN ( SELECT "PID" FROM first_degree_pids )
)
SELECT COUNT(*) AS "khan_number_2_count"
FROM   second_degree_pids
