--Description: Find all actor PIDs who co-starred with any PERSON whose name contains “Khan” (first-degree set),
--handling leading blanks in M_CAST.PID with TRIM.
SELECT DISTINCT TRIM(mc1."PID") AS "PID"
FROM   DB_IMDB.DB_IMDB.M_CAST mc1
WHERE  mc1."MID" IN (  /* movies that feature at least one “Khan” actor */
        SELECT DISTINCT mc."MID"
        FROM   DB_IMDB.DB_IMDB.M_CAST   mc
        JOIN   DB_IMDB.DB_IMDB.PERSON   p
               ON TRIM(mc."PID") = p."PID"
        WHERE  p."Name" ILIKE '%Khan%' )
AND    TRIM(mc1."PID") NOT IN (          /* exclude the “Khan” actors themselves */
        SELECT "PID"
        FROM   DB_IMDB.DB_IMDB.PERSON
        WHERE  "Name" ILIKE '%Khan%' )
LIMIT 20
