                WHERE LOWER(TRIM(p."Name")) LIKE '%shah%'
                  AND LOWER(TRIM(p."Name")) LIKE '%khan%'
             )
        AND TRIM(mc3."PID") NOT IN (
                SELECT DISTINCT TRIM(mc2."PID")
                FROM DB_IMDB.DB_IMDB."M_CAST" mc1
                JOIN DB_IMDB.DB_IMDB."PERSON" p1
                      ON TRIM(mc1."PID") = TRIM(p1."PID")
                JOIN DB_IMDB.DB_IMDB."M_CAST" mc2
                      ON mc1."MID" = mc2."MID"
                WHERE LOWER(TRIM(p1."Name")) LIKE '%shah%'
                  AND LOWER(TRIM(p1."Name")) LIKE '%khan%'
                  AND TRIM(mc2."PID") <> TRIM(mc1."PID")
             )
     ) pn2
JOIN DB_IMDB.DB_IMDB."PERSON" p
     ON TRIM(p."PID") = pn2."PID"
LIMIT 20;
