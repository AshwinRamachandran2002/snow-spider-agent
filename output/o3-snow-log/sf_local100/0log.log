```sql
--Description: 4) Show titles & years of those Shahrukh Khan movies
SELECT m."MID",
       m."title",
       m."year"
FROM DB_IMDB.DB_IMDB."MOVIE"   m
JOIN (
        SELECT DISTINCT mc."MID"
        FROM DB_IMDB.DB_IMDB."M_CAST" mc
        JOIN DB_IMDB.DB_IMDB."PERSON" p
              ON TRIM(mc."PID") = TRIM(p."PID")
        WHERE p."Name" ILIKE '%shahrukh%khan%'
     ) srk_movies
     ON m."MID" = srk_movies."MID"
LIMIT 20;
```

```sql
--Description: 5) Get the list of actor-PIDs who co-starred with Shahrukh Khan (Shahrukh-number = 1)
SELECT DISTINCT TRIM(mc2."PID")      AS "CoActor_PID",
       p2."Name"                     AS "CoActor_Name"
FROM DB_IMDB.DB_IMDB."M_CAST" mc1                        -- Shahrukh rows
JOIN DB_IMDB.DB_IMDB."PERSON"  p1  ON TRIM(mc1."PID") = TRIM(p1."PID")
JOIN DB_IMDB.DB_IMDB."M_CAST" mc2   ON mc1."MID" = mc2."MID"          -- same movie
LEFT JOIN DB_IMDB.DB_IMDB."PERSON"  p2  ON TRIM(mc2."PID") = TRIM(p2."PID")
WHERE p1."Name" ILIKE '%shahrukh%khan%'                 -- keep SRK rows
  AND TRIM(mc2."PID") <> TRIM(mc1."PID")                -- drop SRK himself
LIMIT 20;
```

```sql
--Description: 6) List the distinct movies in which any Shahrukh-co-actor appeared (excluding movies that already have Shahrukh)
SELECT DISTINCT mc."MID"
FROM DB_IMDB.DB_IMDB."M_CAST"     mc
JOIN (
        -- PIDs of Shahrukh’s direct co-actors
        SELECT DISTINCT TRIM(mc2."PID") AS "CoActor_PID"
        FROM DB_IMDB.DB_IMDB."M_CAST" mc1
        JOIN DB_IMDB.DB_IMDB."PERSON"  p1
              ON TRIM(mc1."PID") = TRIM(p1."PID")
        JOIN DB_IMDB.DB_IMDB."M_CAST"  mc2
              ON mc1."MID" = mc2."MID"
        WHERE p1."Name" ILIKE '%shahrukh%khan%'
          AND TRIM(mc2."PID") <> TRIM(mc1."PID")
     ) co
     ON TRIM(mc."PID") = co."CoActor_PID"
-- Remove movies that also contain Shahrukh
WHERE mc."MID" NOT IN (
        SELECT DISTINCT mc_srk."MID"
        FROM DB_IMDB.DB_IMDB."M_CAST" mc_srk
        JOIN DB_IMDB.DB_IMDB."PERSON" p_srk
              ON TRIM(mc_srk."PID") = TRIM(p_srk."PID")
        WHERE p_srk."Name" ILIKE '%shahrukh%khan%'
     )
LIMIT 20;
```

```sql
