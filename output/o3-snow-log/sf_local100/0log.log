--Description: 9) Display names of a few Shahrukh-number = 2 actors for verification
SELECT p."Name",
       pn2."PID" AS "Potential_Number2_PID"
FROM (
        SELECT DISTINCT TRIM(mc3."PID") AS "PID"
        FROM DB_IMDB.DB_IMDB."M_CAST" mc3
        JOIN (
                SELECT DISTINCT mc."MID"
                FROM DB_IMDB.DB_IMDB."M_CAST" mc
                JOIN (
                        SELECT DISTINCT TRIM(mc2."PID") AS "CoActor_PID"
                        FROM DB_IMDB.DB_IMDB."M_CAST" mc1
                        JOIN DB_IMDB.DB_IMDB."PERSON"  p1
                              ON TRIM(mc1."PID") = TRIM(p1."PID")
                        JOIN DB_IMDB.DB_IMDB."M_CAST"  mc2
                              ON mc1."MID" = mc2."MID"
                        WHERE LOWER(TRIM(p1."Name")) LIKE '%shah%'
                          AND LOWER(TRIM(p1."Name")) LIKE '%khan%'
                          AND TRIM(mc2."PID") <> TRIM(mc1."PID")
                     ) co
                     ON TRIM(mc."PID") = co."CoActor_PID"
                WHERE mc."MID" NOT IN (
                        SELECT DISTINCT mc_srk."MID"
                        FROM DB_IMDB.DB_IMDB."M_CAST" mc_srk
                        JOIN DB_IMDB.DB_IMDB."PERSON" p_srk
                              ON TRIM(mc_srk."PID") = TRIM(p_srk."PID")
                        WHERE LOWER(TRIM(p_srk."Name")) LIKE '%shah%'
                          AND LOWER(TRIM(p_srk."Name")) LIKE '%khan%'
                     )
             ) lvl2_movies
             ON mc3."MID" = lvl2_movies."MID"
        WHERE TRIM(mc3."PID") NOT IN (
                SELECT DISTINCT TRIM(p."PID")
                FROM DB_IMDB.DB_IMDB."PERSON" p
                WHERE LOWER(TRIM(p."Name")) LIKE '%shah%'
                  AND LOWER(TRIM(p."Name")) LIKE '%khan%'
             )
        AND TRIM(mc3."PID") NOT IN (
                SELECT DISTINCT TRIM(mc2."PID")
                FROM DB_IMDB.DB_IMDB."M_CAST" mc1
                JOIN DB_IMDB.DB_IMDB."PERSON" p1
                      ON TRIM(mc1."PID") = TRIM(p1."PID")
                JOIN DB_IMDB.DB_IMDB."M_CAST" mc2
                      ON mc1."MID" = mc2."MID"
                WHERE LOWER(TRIM(p1."Name")) LIKE '%shah%'
                  AND LOWER(TRIM(p1."Name")) LIKE '%khan%'
                  AND TRIM(mc2."PID") <> TRIM(mc1."PID")
             )
     ) pn2
JOIN DB_IMDB.DB_IMDB."PERSON" p
     ON TRIM(p."PID") = pn2."PID"
LIMIT 20
