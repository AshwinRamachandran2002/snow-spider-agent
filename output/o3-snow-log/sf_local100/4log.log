Query:
--Description: 5) Movies that feature at least one Shah Rukh-number 1 actor
--              but do NOT feature Shah Rukh Khan himself.
--              • “SRK_MOVIES” collects all movie-IDs with Shah Rukh Khan.
--              • “SRK1_PIDS” collects every PID that appears in those movies
--                (co-actors = number 1).
--              • Main query returns all distinct movie-IDs that have at least
--                one SRK1 actor and are not in SRK_MOVIES.
WITH SRK_MOVIES AS (            -- films that contain Shah Rukh Khan
        SELECT DISTINCT mc."MID"
        FROM   DB_IMDB.DB_IMDB."M_CAST"  mc
        JOIN   DB_IMDB.DB_IMDB."PERSON"  p
               ON TRIM(mc."PID") = TRIM(p."PID")
        WHERE  TRIM(p."Name") ILIKE '%Shah%Khan%' ),
SRK1_PIDS AS (                  -- PIDs of all SRK co-actors
        SELECT DISTINCT TRIM(mc."PID") AS "PID"
        FROM   DB_IMDB.DB_IMDB."M_CAST" mc
        WHERE  mc."MID" IN (SELECT "MID" FROM SRK_MOVIES) )
SELECT DISTINCT mc."MID"
FROM   DB_IMDB.DB_IMDB."M_CAST" mc
WHERE  TRIM(mc."PID") IN (SELECT "PID" FROM SRK1_PIDS)   -- needs a number-1 actor
AND    mc."MID"     NOT IN (SELECT "MID" FROM SRK_MOVIES) -- but no Shah Rukh Khan
LIMIT 20
