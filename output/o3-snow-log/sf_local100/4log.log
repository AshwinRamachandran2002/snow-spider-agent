--              • The second SELECT gathers Shah Rukh Khan’s movie-IDs (using a
--                name pattern and TRIM to ignore leading blanks).
--              • INTERSECT keeps only movie-IDs common to both sets.
--              • If the result count is 0 (or no rows are returned), they share
--                no films, confirming her Shahrukh number is 2.
SELECT COUNT(*) AS "shared_film_count"
