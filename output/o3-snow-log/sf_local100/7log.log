Query:
--Description: 10) Count how many distinct actors have “Khan-number = 2”, using the same CTE chain
--(kh → khan_movies → co_actors → co_movies → k2) employed in the previous query.
WITH kh AS (                            -- performers whose trimmed name contains “khan”
    SELECT "PID"
    FROM   "DB_IMDB"."DB_IMDB"."PERSON"
    WHERE  LOWER(TRIM("Name")) LIKE '%khan%'
),
khan_movies AS (                        -- movies featuring any Khan performer
    SELECT DISTINCT mc."MID"
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
    JOIN   kh
      ON   kh."PID" = TRIM(mc."PID")
),
co_actors AS (                          -- direct co-actors of Khans
    SELECT DISTINCT TRIM(mc."PID") AS "PID"
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
    WHERE  mc."MID" IN (SELECT "MID" FROM khan_movies)
      AND  TRIM(mc."PID") NOT IN (SELECT "PID" FROM kh)
),
co_movies AS (                          -- movies containing any of those co-actors
    SELECT DISTINCT mc."MID"
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
    WHERE  TRIM(mc."PID") IN (SELECT "PID" FROM co_actors)
),
k2 AS (                                 -- Khan-number = 2 performers
    SELECT DISTINCT TRIM(mc."PID") AS "PID"
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
    WHERE  mc."MID" IN (SELECT "MID" FROM co_movies)
      AND  TRIM(mc."PID") NOT IN (SELECT "PID" FROM kh)        -- exclude Khans
      AND  TRIM(mc."PID") NOT IN (SELECT "PID" FROM co_actors) -- exclude direct co-actors
)
SELECT COUNT(*) AS "num_actors_with_khan_number_2"
FROM   k2
