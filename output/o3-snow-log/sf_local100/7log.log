Query:
--Description: 4) Fetch every *co-actor* (PID) who appeared in a movie that also featured at least one
--“Khan”-named performer (as defined by PERSON records whose trimmed name contains ‘khan’),
--while excluding the Khan performers themselves.  Leading-space PID mismatches are handled
--via TRIM on M_CAST."PID".
SELECT DISTINCT TRIM(mc2."PID") AS "co_actor_pid"
FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc2
WHERE  mc2."MID" IN (  /* movies that have any Khan-named actor */
          SELECT DISTINCT mc."MID"
          FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
          JOIN  ( SELECT p."PID"
                  FROM   "DB_IMDB"."DB_IMDB"."PERSON" p
                  WHERE  LOWER(TRIM(p."Name")) LIKE '%khan%' ) pk
            ON   pk."PID" = TRIM(mc."PID")
       )
  AND  TRIM(mc2."PID") NOT IN (  /* all Khan PIDs */
          SELECT p."PID"
          FROM   "DB_IMDB"."DB_IMDB"."PERSON" p
          WHERE  LOWER(TRIM(p."Name")) LIKE '%khan%' )
LIMIT  20
