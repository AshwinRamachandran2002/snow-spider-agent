--Description: Earlier joins failed because of two issues: (1) we filtered for “%shah%khan%”, which returns no names,
--and (2) many M_CAST."PID" values have a leading space, so a direct join to PERSON fails.  
--To validate which films contain any “Khan”-named actor, we:  
--  • locate all PIDs whose trimmed PERSON."Name" contains “khan” (case-insensitive);  
--  • join to M_CAST after TRIM-ming its "PID" so the values match;  
--  • collect the distinct movie-IDs, then pull their titles and years.  
--This produces up to 20 rows of movies featuring at least one “Khan”.
SELECT  m."MID",
        m."title",
        m."year"
FROM    "DB_IMDB"."DB_IMDB"."MOVIE"  m
WHERE   m."MID" IN (
          SELECT DISTINCT mc."MID"
          FROM   "DB_IMDB"."DB_IMDB"."M_CAST"  mc
          JOIN   "DB_IMDB"."DB_IMDB"."PERSON"  p
                 ON p."PID" = TRIM(mc."PID")
          WHERE  LOWER(TRIM(p."Name")) LIKE '%khan%'
       )
LIMIT  20;
