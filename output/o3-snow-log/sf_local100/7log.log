```sql
--Description: Show up to 20 actors whose “Khan-number” = 2, i.e., they acted in a film with someone
--who acted with a performer whose trimmed name contains “khan”, but never acted in a film with a
--“Khan” performer themselves and are not that direct co-actor either.  CTEs build each required
--set (Khan performers → movies with Khan → direct co-actors → movies with those co-actors),
--and the final SELECT joins the resulting PID list to PERSON to fetch the actor names.
WITH kh AS (                            -- all performers whose name contains “khan”
    SELECT "PID"
    FROM   "DB_IMDB"."DB_IMDB"."PERSON"
    WHERE  LOWER(TRIM("Name")) LIKE '%khan%'
),
khan_movies AS (                        -- movies featuring any Khan performer
    SELECT DISTINCT mc."MID"
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
    JOIN   kh
      ON   kh."PID" = TRIM(mc."PID")
),
co_actors AS (                          -- direct co-actors of Khan performers
    SELECT DISTINCT TRIM(mc."PID") AS "PID"
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
    WHERE  mc."MID" IN (SELECT "MID" FROM khan_movies)
      AND  TRIM(mc."PID") NOT IN (SELECT "PID" FROM kh)   -- exclude Khans
),
co_movies AS (                          -- movies that include at least one co-actor
    SELECT DISTINCT mc."MID"
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
    WHERE  TRIM(mc."PID") IN (SELECT "PID" FROM co_actors)
),
k2 AS (                                 -- Khan-number-2 performers
    SELECT DISTINCT TRIM(mc."PID") AS "khan_number_2_pid"
    FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
    WHERE  mc."MID" IN (SELECT "MID" FROM co_movies)
      AND  TRIM(mc."PID") NOT IN (SELECT "PID" FROM kh)        -- not a Khan
      AND  TRIM(mc."PID") NOT IN (SELECT "PID" FROM co_actors) -- not a direct co-actor
)
SELECT  k2."khan_number_2_pid" AS "PID",
        TRIM(p."Name")         AS "actor_name"
FROM    k2
JOIN    "DB_IMDB"."DB_IMDB"."PERSON" p
  ON    p."PID" = k2."khan_number_2_pid"
LIMIT   20;
```
