--Description: 8) List the actors whose “Khan-number” = 2: they appear in movies from query-6
--but are neither Khan actors themselves nor the direct co-actors from query-4.
SELECT DISTINCT TRIM(mc."PID") AS "khan_number_2_pid"
FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc
WHERE  mc."MID" IN (  /* movies with at least one co-actor */
          SELECT DISTINCT mc6."MID"
          FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc6
          WHERE  TRIM(mc6."PID") IN (
                   SELECT DISTINCT TRIM(mc4."PID")
                   FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc4
                   WHERE  mc4."MID" IN (  SELECT DISTINCT mc5."MID"
                                          FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc5
                                          JOIN  ( SELECT p."PID"
                                                  FROM   "DB_IMDB"."DB_IMDB"."PERSON" p
                                                  WHERE  LOWER(TRIM(p."Name")) LIKE '%khan%' ) pk
                                             ON pk."PID" = TRIM(mc5."PID") )
                     AND  TRIM(mc4."PID") NOT IN ( SELECT p."PID"
                                                   FROM   "DB_IMDB"."DB_IMDB"."PERSON" p
                                                   WHERE  LOWER(TRIM(p."Name")) LIKE '%khan%' )
               ) )
  AND  TRIM(mc."PID") NOT IN ( SELECT p."PID"
                               FROM   "DB_IMDB"."DB_IMDB"."PERSON" p
                               WHERE  LOWER(TRIM(p."Name")) LIKE '%khan%' )
  AND  TRIM(mc."PID") NOT IN (  /* co-actors */
          SELECT DISTINCT TRIM(mc2."PID")
          FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc2
          WHERE  mc2."MID" IN (  SELECT DISTINCT mc3."MID"
                                 FROM   "DB_IMDB"."DB_IMDB"."M_CAST" mc3
                                 JOIN  ( SELECT p."PID"
                                         FROM   "DB_IMDB"."DB_IMDB"."PERSON" p
