        FROM "DB_IMDB"."DB_IMDB"."M_CAST" mc3
        WHERE TRIM(mc3."PID") <> 'nm0451321'
          AND TRIM(mc3."PID") NOT IN (
                SELECT DISTINCT TRIM(mcFD."PID")
                FROM "DB_IMDB"."DB_IMDB"."M_CAST" mcFD
                WHERE mcFD."MID" IN (
                        SELECT DISTINCT "MID"
                        FROM "DB_IMDB"."DB_IMDB"."M_CAST"
                        WHERE TRIM("PID") = 'nm0451321'
                      )
                  AND TRIM(mcFD."PID") <> 'nm0451321'
              )
          AND mc3."MID" IN (
                SELECT DISTINCT mc1."MID"
                FROM "DB_IMDB"."DB_IMDB"."M_CAST" mc1
                WHERE TRIM(mc1."PID") IN (
                        SELECT DISTINCT TRIM(mcFD."PID")
                        FROM "DB_IMDB"."DB_IMDB"."M_CAST" mcFD
                        WHERE mcFD."MID" IN (
                                SELECT DISTINCT "MID"
                                FROM "DB_IMDB"."DB_IMDB"."M_CAST"
                                WHERE TRIM("PID") = 'nm0451321'
                              )
                          AND TRIM(mcFD."PID") <> 'nm0451321'
                      )
                  AND mc1."MID" NOT IN (
                        SELECT DISTINCT "MID"
                        FROM "DB_IMDB"."DB_IMDB"."M_CAST"
                        WHERE TRIM("PID") = 'nm0451321'
                      )
              )
     ) q
  ON TRIM(p."PID") = q."PID"
LIMIT 20
