```sql
--Description: 1) Take a quick look at 2012 block-group geoids that belong to Kings County, NY (county FIPS 36047)
SELECT "geo_id", "total_pop", "median_income"
FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2012_5YR
WHERE  "geo_id" LIKE '36047%'      -- county 36047
LIMIT  20;
```

```sql
--Description: 2) Aggregate 2012 block-groups to the tract level (first 11 digits of the geoid) for Kings County
SELECT  SUBSTR("geo_id",1,11)                      AS "tract_id",
        SUM("total_pop")                           AS "pop_2012",
        SUM("median_income" * "total_pop")
          / NULLIF(SUM("total_pop"),0)             AS "income_2012"
FROM    CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2012_5YR
WHERE   "geo_id" LIKE '36047%'
GROUP BY 1
LIMIT 20;
```

```sql
--Description: 3) Take a quick look at 2018 block-group rows for Kings County
SELECT "geo_id", "total_pop", "median_income"
FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
WHERE  "geo_id" LIKE '36047%'
LIMIT  20;
```

```sql
--Description: 4) Aggregate 2018 block-groups to the tract level for Kings County
SELECT  SUBSTR("geo_id",1,11)                      AS "tract_id",
        SUM("total_pop")                           AS "pop_2018",
        SUM("median_income" * "total_pop")
          / NULLIF(SUM("total_pop"),0)             AS "income_2018"
FROM    CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
WHERE   "geo_id" LIKE '36047%'
GROUP BY 1
LIMIT 20;
```

```sql
--Description: 5) Join the 2012 and 2018 tract aggregates, keep tracts with >1,000 people in both years,
--              and calculate percentage pop change & income change
WITH t12 AS (
    SELECT  SUBSTR("geo_id",1,11) AS "tract_id",
            SUM("total_pop")      AS "pop_2012",
            SUM("median_income" * "total_pop")/NULLIF(SUM("total_pop"),0) AS "income_2012"
    FROM    CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2012_5YR
    WHERE   "geo_id" LIKE '36047%'
    GROUP BY 1
),
t18 AS (
    SELECT  SUBSTR("geo_id",1,11) AS "tract_id",
            SUM("total_pop")      AS "pop_2018",
            SUM("median_income" * "total_pop")/NULLIF(SUM("total_pop"),0) AS "income_2018"
    FROM    CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE   "geo_id" LIKE '36047%'
    GROUP BY 1
)
SELECT  a."tract_id",
        a."pop_2012",
        b."pop_2018",
        (b."pop_2018" - a."pop_2012")        AS "abs_pop_change",
        (b."pop_2018" - a."pop_2012")*100.0 / NULLIF(a."pop_2012",0) AS "pct_pop_change",
        a."income_2012",
        b."income_2018",
        (b."income_2018" - a."income_2012")  AS "abs_income_change"
FROM    t12 a
JOIN    t18 b USING ("tract_id")
WHERE   a."pop_2012" > 1000
  AND   b."pop_2018" > 1000
LIMIT 20;
```

```sql
--Description: 6) From the previous join, pull the 20 tracts with the largest % increase in population
WITH base AS ( /* same CTEs as query 5 */ 
    WITH t12 AS (
        SELECT  SUBSTR("geo_id",1,11) AS "tract_id",
                SUM("total_pop")      AS "pop_2012"
        FROM    CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2012_5YR
        WHERE   "geo_id" LIKE '36047%'
        GROUP BY 1
    ),
    t18 AS (
        SELECT  SUBSTR("geo_id",1,11) AS "tract_id",
                SUM("total_pop")      AS "pop_2018"
        FROM    CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
        WHERE   "geo_id" LIKE '36047%'
        GROUP BY 1
    )
    SELECT  a."tract_id",
            a."pop_2012",
            b."pop_2018",
            (b."pop_2018" - a."pop_2012")*100.0/NULLIF(a."pop_2012",0) AS "pct_pop_change"
    FROM    t12 a JOIN t18 b USING ("tract_id")
    WHERE   a."pop_2012" > 1000 AND b."pop_2018" > 1000
)
SELECT  "tract_id", "pct_pop_change"
FROM    base
ORDER BY "pct_pop_change" DESC
LIMIT 20;
```

```sql
--Description: 7) Pull the 20 tracts with the largest absolute increase in median income
WITH base AS ( /* similar CTEs but keep income columns */
    WITH t12 AS (
        SELECT  SUBSTR("geo_id",1,11) AS "tract_id",
                SUM("median_income" * "total_pop")/NULLIF(SUM("total_pop"),0) AS "income_2012",
                SUM("total_pop") AS "pop_2012"
        FROM    CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2012_5YR
        WHERE   "geo_id" LIKE '36047%'
        GROUP BY 1
    ),
    t18 AS (
        SELECT  SUBSTR("geo_id",1,11) AS "tract_id",
                SUM("median_income" * "total_pop")/NULLIF(SUM("total_pop"),0) AS "income_2018",
                SUM("total_pop") AS "pop_2018"
        FROM    CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
        WHERE   "geo_id" LIKE '36047%'
        GROUP BY 1
    )
    SELECT  a."tract_id",
            a."income_2012",
            b."income_2018",
            (b."income_2018" - a."income_2012") AS "abs_income_change",
            a."pop_2012",
            b."pop_2018"
    FROM    t12 a JOIN t18 b USING ("tract_id")
    WHERE   a."pop_2012" > 1000 AND b."pop_2018" > 1000
)
SELECT  "tract_id", "abs_income_change"
FROM    base
ORDER BY "abs_income_change" DESC
LIMIT 20;
```

```sql
--Description: 8) Combine the two “top-20” lists to find tracts present in both
WITH pct_top AS ( /* query 6 without LIMIT to mark ranks */
    WITH t12 AS (
        SELECT SUBSTR("geo_id",1,11) AS "tract_id",
               SUM("total_pop") AS "pop_2012"
        FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2012_5YR
        WHERE  "geo_id" LIKE '36047%'
        GROUP BY 1
    ),
    t18 AS (
        SELECT SUBSTR("geo_id",1,11) AS "tract_id",
               SUM("total_pop") AS "pop_2018"
        FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
        WHERE  "geo_id" LIKE '36047%'
        GROUP BY 1
    )
    SELECT  a."tract_id",
            (b."pop_2018"-a."pop_2012")*100.0/NULLIF(a."pop_2012",0) AS "pct_pop_change",
            ROW_NUMBER() OVER (ORDER BY (b."pop_2018"-a."pop_2012")*100.0/NULLIF(a."pop_2012",0) DESC) AS "rn_pct"
    FROM    t12 a JOIN t18 b USING ("tract_id")
    WHERE   a."pop_2012" > 1000 AND b."pop_2018" > 1000
),
inc_top AS ( /* query 7 without LIMIT to mark ranks */
    WITH t12 AS (
        SELECT SUBSTR("geo_id",1,11) AS "tract_id",
               SUM("median_income"* "total_pop")/NULLIF(SUM("total_pop"),0) AS "income_2012",
               SUM("total_pop") AS "pop_2012"
        FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2012_5YR
        WHERE  "geo_id" LIKE '36047%'
        GROUP BY 1
    ),
    t18 AS (
        SELECT SUBSTR("geo_id",1,11) AS "tract_id",
               SUM("median_income"* "total_pop")/NULLIF(SUM("total_pop"),0) AS "income_2018",
               SUM("total_pop") AS "pop_2018"
        FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
        WHERE  "geo_id" LIKE '36047%'
        GROUP BY 1
    )
    SELECT  a."tract_id",
            (b."income_2018" - a."income_2012") AS "abs_income_change",
            ROW_NUMBER() OVER (ORDER BY (b."income_2018" - a."income_2012") DESC) AS "rn_inc"
    FROM    t12 a JOIN t18 b USING ("tract_id")
    WHERE   a."pop_2012" > 1000 AND b."pop_2018" > 1000
)
SELECT  p."tract_id",
        p."pct_pop_change",
        i."abs_income_change"
FROM    pct_top p
JOIN    inc_top i USING ("tract_id")
WHERE   p."rn_pct" <= 20
  AND   i."rn_inc" <= 20
ORDER BY p."pct_pop_change" DESC
LIMIT 20;
```

