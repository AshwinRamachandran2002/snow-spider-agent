```sql
--Description: Join 2011 & 2018 tract-level data, calculate % population change & absolute income change
WITH tr11 AS (
  SELECT 
      t."geo_id"      AS "tract_id",
      t."total_pop"   AS "pop_2011",
      t."median_income" AS "inc_2011"
  FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."CENSUSTRACT_2011_5YR" t
  WHERE t."geo_id" LIKE '36047%'
    AND t."total_pop" > 1000
),
tr18 AS (
  SELECT
      SUBSTR(b."geo_id",1,11) AS "tract_id",
      SUM(b."total_pop")      AS "pop_2018",
      SUM(b."median_income"*b."total_pop")/NULLIF(SUM(b."total_pop"),0) AS "inc_2018"
  FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR" b
  WHERE b."geo_id" LIKE '36047%'
  GROUP BY SUBSTR(b."geo_id",1,11)
  HAVING SUM(b."total_pop") > 1000
)
SELECT
    j."tract_id",
    j."pop_2011",
    j."pop_2018",
    (j."pop_2018" - j."pop_2011")*100.0 / j."pop_2011" AS "pct_pop_change",
    j."inc_2011",
    j."inc_2018",
    (j."inc_2018" - j."inc_2011")                     AS "abs_inc_change"
FROM tr11
JOIN tr18 j
  USING ("tract_id")
LIMIT 20;
```

```sql
--Description: Top 20 Kings-County tracts by greatest % increase in population (2011→2018)
WITH joined AS (
  --(same join block as previous query)
  SELECT
      j."tract_id",
      j."pop_2011",
      j."pop_2018",
      (j."pop_2018" - j."pop_2011")*100.0 / j."pop_2011" AS "pct_pop_change"
  FROM (
      SELECT 
          t."geo_id" AS "tract_id",
          t."total_pop" AS "pop_2011"
      FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."CENSUSTRACT_2011_5YR" t
      WHERE t."geo_id" LIKE '36047%' AND t."total_pop" > 1000
  ) t
  JOIN (
      SELECT
          SUBSTR(b."geo_id",1,11) AS "tract_id",
          SUM(b."total_pop") AS "pop_2018"
      FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR" b
      WHERE b."geo_id" LIKE '36047%'
      GROUP BY SUBSTR(b."geo_id",1,11)
      HAVING SUM(b."total_pop") > 1000
  ) b
  USING ("tract_id")
)
SELECT *
FROM joined
ORDER BY "pct_pop_change" DESC
LIMIT 20;
```

```sql
--Description: Top 20 Kings-County tracts by largest absolute increase in median household income (2011→2018)
WITH joined AS (
  --re-join 2011 & 2018 with incomes
  SELECT
      t."tract_id",
      t."inc_2011",
      b."inc_2018",
      (b."inc_2018" - t."inc_2011") AS "abs_inc_change"
  FROM (
      SELECT 
          t."geo_id" AS "tract_id",
          t."median_income" AS "inc_2011"
      FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."CENSUSTRACT_2011_5YR" t
      WHERE t."geo_id" LIKE '36047%' AND t."total_pop" > 1000
  ) t
  JOIN (
      SELECT
          SUBSTR(b."geo_id",1,11) AS "tract_id",
          SUM(b."median_income"*b."total_pop")/NULLIF(SUM(b."total_pop"),0) AS "inc_2018"
      FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR" b
      WHERE b."geo_id" LIKE '36047%'
      GROUP BY SUBSTR(b."geo_id",1,11)
      HAVING SUM(b."total_pop") > 1000
  ) b
  USING ("tract_id")
)
SELECT *
FROM joined
ORDER BY "abs_inc_change" DESC
LIMIT 20;
```

```sql
--Description: Intersect the two Top-20 lists to find tracts satisfying both criteria
WITH pct_rank AS (
  --top 20 by % pop change
  SELECT
      "tract_id"
  FROM (
      SELECT
          t."tract_id",
          (b."pop_2018" - t."pop_2011")*100.0/t."pop_2011" AS pct_change,
          ROW_NUMBER() OVER (ORDER BY (b."pop_2018" - t."pop_2011")*100.0/t."pop_2011" DESC) AS rnk
      FROM (
          SELECT "geo_id" AS "tract_id", "total_pop" AS "pop_2011"
          FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."CENSUSTRACT_2011_5YR"
          WHERE "geo_id" LIKE '36047%' AND "total_pop" > 1000
      ) t
      JOIN (
          SELECT SUBSTR("geo_id",1,11) AS "tract_id", SUM("total_pop") AS "pop_2018"
          FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
          WHERE "geo_id" LIKE '36047%'
          GROUP BY SUBSTR("geo_id",1,11)
          HAVING SUM("total_pop") > 1000
      ) b USING ("tract_id")
  )
  WHERE rnk <= 20
),
inc_rank AS (
  --top 20 by absolute income change
  SELECT
      "tract_id"
  FROM (
      SELECT
          t."tract_id",
          (b."inc_2018" - t."inc_2011") AS abs_change,
          ROW_NUMBER() OVER (ORDER BY (b."inc_2018" - t."inc_2011") DESC) AS rnk
      FROM (
          SELECT "geo_id" AS "tract_id", "median_income" AS "inc_2011"
          FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."CENSUSTRACT_2011_5YR"
          WHERE "geo_id" LIKE '36047%' AND "total_pop" > 1000
      ) t
      JOIN (
          SELECT SUBSTR("geo_id",1,11) AS "tract_id",
                 SUM("median_income"* "total_pop")/NULLIF(SUM("total_pop"),0) AS "inc_2018"
          FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
          WHERE "geo_id" LIKE '36047%'
          GROUP BY SUBSTR("geo_id",1,11)
          HAVING SUM("total_pop") > 1000
      ) b USING ("tract_id")
  )
  WHERE rnk <= 20
)
SELECT DISTINCT p."tract_id"
FROM pct_rank p
JOIN inc_rank i
  ON p."tract_id" = i."tract_id"
LIMIT 20;
```

```sql
--Description: Display full metrics for the tracts that meet BOTH top-20 criteria
WITH winners AS (
  --use previous intersection query
  SELECT DISTINCT p."tract_id"
  FROM (
      /* top 20 % pop change */
      SELECT "tract_id"
      FROM (
          SELECT "tract_id",
                 ROW_NUMBER() OVER (ORDER BY (pop_2018 - pop_2011)*100.0/pop_2011 DESC) AS rnk
          FROM (
              SELECT
                  t."tract_id",
                  t."pop_2011",
                  b."pop_2018"
              FROM (
                  SELECT "geo_id" AS "tract_id", "total_pop" AS "pop_2011"
                  FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."CENSUSTRACT_2011_5YR"
                  WHERE "geo_id" LIKE '36047%' AND "total_pop" > 1000
              ) t
              JOIN (
                  SELECT SUBSTR("geo_id",1,11) AS "tract_id", SUM("total_pop") AS "pop_2018"
                  FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
                  WHERE "geo_id" LIKE '36047%'
                  GROUP BY SUBSTR("geo_id",1,11)
                  HAVING SUM("total_pop") > 1000
              ) b USING ("tract_id")
          )
      ) WHERE rnk <= 20
  ) p
  JOIN (
      /* top 20 absolute income change */
      SELECT "tract_id"
      FROM (
          SELECT "tract_id",
                 ROW_NUMBER() OVER (ORDER BY abs_inc_change DESC) AS rnk
          FROM (
              SELECT
                  t."tract_id",
                  b."inc_2018" - t."inc_2011" AS abs_inc_change
              FROM (
                  SELECT "geo_id" AS "tract_id", "median_income" AS "inc_2011"
                  FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."CENSUSTRACT_2011_5YR"
                  WHERE "geo_id" LIKE '36047%' AND "total_pop" > 1000
              ) t
              JOIN (
                  SELECT SUBSTR("geo_id",1,11) AS "tract_id",
                         SUM("median_income"* "total_pop")/NULLIF(SUM("total_pop"),0) AS "inc_2018"
                  FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
                  WHERE "geo_id" LIKE '36047%'
                  GROUP BY SUBSTR("geo_id",1,11)
                  HAVING SUM("total_pop") > 1000
              ) b USING ("tract_id")
          )
      ) WHERE rnk <= 20
  ) i USING ("tract_id")
)
SELECT
    w."tract_id",
    t."total_pop" AS "pop_2011",
    t."median_income" AS "inc_2011",
    b."pop_2018",
    b."inc_2018",
    (b."pop_2018" - t."total_pop")*100.0/t."total_pop" AS "pct_pop_change",
    b."inc_2018" - t."median_income" AS "abs_inc_change"
FROM winners w
JOIN CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."CENSUSTRACT_2011_5YR" t
  ON w."tract_id" = t."geo_id"
JOIN (
    SELECT 
        SUBSTR("geo_id",1,11) AS "tract_id",
        SUM("total_pop") AS "pop_2018",
        SUM("median_income"* "total_pop")/NULLIF(SUM("total_pop"),0) AS "inc_2018"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
    WHERE "geo_id" LIKE '36047%'
    GROUP BY SUBSTR("geo_id",1,11)
) b
  ON w."tract_id" = b."tract_id"
LIMIT 20;
```
