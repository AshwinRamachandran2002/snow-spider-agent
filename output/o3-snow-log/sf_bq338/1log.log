```sql
--Description: Join 2011 tract data to aggregated 2018 tract data for 36047
WITH tr2018 AS (
  SELECT SUBSTR("geo_id",1,11) AS "tract_id",
         SUM("total_pop")      AS "pop_2018",
         AVG("median_income")  AS "median_income_2018"
  FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
  WHERE "geo_id" LIKE '36047%'
  GROUP BY "tract_id"
)
SELECT t11."geo_id"           AS "tract_id",
       t11."total_pop"        AS "pop_2011",
       t11."median_income"    AS "median_income_2011",
       tr2018."pop_2018",
       tr2018."median_income_2018"
FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR" t11
JOIN tr2018 ON t11."geo_id" = tr2018."tract_id"
LIMIT 20;
```

```sql
--Description: Compute % population change & income change 2011→2018 (tracts >1,000 pop in both years)
WITH tr2018 AS (
  SELECT SUBSTR("geo_id",1,11) AS "tract_id",
         SUM("total_pop")      AS "pop_2018",
         AVG("median_income")  AS "median_income_2018"
  FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
  WHERE "geo_id" LIKE '36047%'
  GROUP BY "tract_id"
)
SELECT t11."geo_id"                             AS "tract_id",
       t11."total_pop"                          AS "pop_2011",
       tr2018."pop_2018",
       (tr2018."pop_2018" - t11."total_pop")
       / NULLIF(t11."total_pop",0)              AS "pct_pop_change",
       t11."median_income"                      AS "income_2011",
       tr2018."median_income_2018",
       tr2018."median_income_2018"
       - t11."median_income"                    AS "income_change"
FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR" t11
JOIN tr2018 ON t11."geo_id" = tr2018."tract_id"
WHERE t11."total_pop"  > 1000
  AND tr2018."pop_2018" > 1000
LIMIT 20;
```

```sql
--Description: Top 20 tracts by percentage population increase (2011→2018) in 36047
WITH tr2018 AS (
  SELECT SUBSTR("geo_id",1,11) AS "tract_id",
         SUM("total_pop")      AS "pop_2018"
  FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
  WHERE "geo_id" LIKE '36047%'
  GROUP BY "tract_id"
),
changes AS (
  SELECT t11."geo_id" AS "tract_id",
         (tr2018."pop_2018" - t11."total_pop") /
         NULLIF(t11."total_pop",0)             AS "pct_pop_change"
  FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR" t11
  JOIN tr2018 ON t11."geo_id" = tr2018."tract_id"
  WHERE t11."total_pop"  > 1000
    AND tr2018."pop_2018" > 1000
)
SELECT "tract_id", "pct_pop_change"
FROM changes
ORDER BY "pct_pop_change" DESC
LIMIT 20;
```

```sql
--Description: Top 20 tracts by absolute median-income increase (2011→2018) in 36047
WITH tr2018 AS (
  SELECT SUBSTR("geo_id",1,11) AS "tract_id",
         AVG("median_income")  AS "median_income_2018",
         SUM("total_pop")      AS "pop_2018"
  FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
  WHERE "geo_id" LIKE '36047%'
  GROUP BY "tract_id"
),
changes AS (
  SELECT t11."geo_id" AS "tract_id",
         tr2018."median_income_2018"
         - t11."median_income"              AS "income_change"
  FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR" t11
  JOIN tr2018 ON t11."geo_id" = tr2018."tract_id"
  WHERE t11."total_pop"  > 1000
    AND tr2018."pop_2018" > 1000
)
SELECT "tract_id", "income_change"
FROM changes
ORDER BY "income_change" DESC
LIMIT 20;
```

```sql
--Description: Tracts that are in BOTH top-20 lists (population % ↑ & income ↑) for 36047
WITH tr2018 AS (
  SELECT SUBSTR("geo_id",1,11) AS "tract_id",
         SUM("total_pop")      AS "pop_2018",
         AVG("median_income")  AS "income_2018"
  FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
  WHERE "geo_id" LIKE '36047%'
  GROUP BY "tract_id"
),
metrics AS (
  SELECT t11."geo_id"                          AS "tract_id",
         (tr2018."pop_2018" - t11."total_pop")
         / NULLIF(t11."total_pop",0)           AS "pct_pop_change",
         tr2018."income_2018" - t11."median_income" AS "income_change"
  FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR" t11
  JOIN tr2018 ON t11."geo_id" = tr2018."tract_id"
  WHERE t11."total_pop"  > 1000
    AND tr2018."pop_2018" > 1000
),
ranked AS (
  SELECT "tract_id",
         "pct_pop_change",
         "income_change",
         RANK() OVER (ORDER BY "pct_pop_change" DESC) AS "pop_rank",
         RANK() OVER (ORDER BY "income_change"  DESC) AS "income_rank"
  FROM metrics
)
SELECT "tract_id",
       "pct_pop_change",
       "income_change",
       "pop_rank",
       "income_rank"
FROM ranked
WHERE "pop_rank"   <= 20
  AND "income_rank"<= 20
ORDER BY "pop_rank", "income_rank"
LIMIT 20;
```

```sql
--Description: Count of tracts satisfying both top-20 criteria in 36047
WITH tr2018 AS (
  SELECT SUBSTR("geo_id",1,11) AS "tract_id",
         SUM("total_pop")      AS "pop_2018",
         AVG("median_income")  AS "income_2018"
  FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
  WHERE "geo_id" LIKE '36047%'
  GROUP BY "tract_id"
),
metrics AS (
  SELECT t11."geo_id"                          AS "tract_id",
         (tr2018."pop_2018" - t11."total_pop")
         / NULLIF(t11."total_pop",0)           AS "pct_pop_change",
         tr2018."income_2018" - t11."median_income" AS "income_change"
  FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR" t11
  JOIN tr2018 ON t11."geo_id" = tr2018."tract_id"
  WHERE t11."total_pop"  > 1000
    AND tr2018."pop_2018" > 1000
),
ranked AS (
  SELECT "tract_id",
         RANK() OVER (ORDER BY "pct_pop_change" DESC) AS "pop_rank",
         RANK() OVER (ORDER BY "income_change"  DESC) AS "income_rank"
  FROM metrics
)
SELECT COUNT(*) AS "n_matching_tracts"
FROM ranked
WHERE "pop_rank"   <= 20
  AND "income_rank"<= 20;
```

```sql
--Description: Final detailed list of qualifying tracts with 2011 & 2018 stats
WITH tr2018 AS (
  SELECT SUBSTR("geo_id",1,11) AS "tract_id",
         SUM("total_pop")      AS "pop_2018",
         AVG("median_income")  AS "income_2018"
  FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
  WHERE "geo_id" LIKE '36047%'
  GROUP BY "tract_id"
),
joined AS (
  SELECT t11."geo_id"                          AS "tract_id",
         t11."total_pop"                       AS "pop_2011",
         tr2018."pop_2018",
         t11."median_income"                   AS "income_2011",
         tr2018."income_2018",
         (tr2018."pop_2018" - t11."total_pop")
         / NULLIF(t11."total_pop",0)           AS "pct_pop_change",
         tr2018."income_2018" - t11."median_income" AS "income_change"
  FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR" t11
  JOIN tr2018 ON t11."geo_id" = tr2018."tract_id"
  WHERE t11."total_pop"  > 1000
    AND tr2018."pop_2018" > 1000
),
ranked AS (
  SELECT *,
         RANK() OVER (ORDER BY "pct_pop_change" DESC) AS "pop_rank",
         RANK() OVER (ORDER BY "income_change"  DESC) AS "income_rank"
  FROM joined
)
SELECT "tract_id",
       "pop_2011", "pop_2018", "pct_pop_change",
       "income_2011", "income_2018", "income_change",
       "pop_rank", "income_rank"
FROM ranked
WHERE "pop_rank"   <= 20
  AND "income_rank"<= 20
ORDER BY "pop_rank", "income_rank"
LIMIT 20;
```
