```sql
--Description: 3) Build 2018 tract-level stats for the same county by aggregating block-groups  
SELECT 
    SUBSTR("geo_id",1,11)        AS "tract_geoid",
    SUM("total_pop")             AS "pop2018",
    SUM("median_income"*"total_pop")/NULLIF(SUM("total_pop"),0) 
                                   AS "median_income2018"
FROM 
    CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
WHERE 
    "geo_id" LIKE '36047%'       -- county 36047
GROUP BY 
    SUBSTR("geo_id",1,11)
LIMIT 20;
```

```sql
--Description: 4) Combine 2011 tract table with the 2018 aggregation to compute changes  
SELECT 
    t11."geo_id"                          AS "tract_geoid",
    t11."total_pop"                       AS "pop2011",
    a18."pop2018",
    (a18."pop2018"-t11."total_pop")       AS "pop_abs_change",
    (a18."pop2018"-t11."total_pop")*100.0/NULLIF(t11."total_pop",0)
                                           AS "pop_pct_change",
    t11."median_income"                   AS "inc2011",
    a18."median_income2018",
    (a18."median_income2018"-t11."median_income") 
                                           AS "inc_abs_change"
FROM 
    CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR  AS t11
JOIN 
    ( SELECT 
          SUBSTR("geo_id",1,11) AS "tract_geoid",
          SUM("total_pop")      AS "pop2018",
          SUM("median_income"*"total_pop")/NULLIF(SUM("total_pop"),0) 
                                  AS "median_income2018"
      FROM 
          CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
      WHERE "geo_id" LIKE '36047%'
      GROUP BY SUBSTR("geo_id",1,11)
    ) AS a18
ON  t11."geo_id" = a18."tract_geoid"
WHERE 
    t11."geo_id" LIKE '36047%'
LIMIT 20;
```

```sql
--Description: 5) Top-20 tracts by largest % population increase (2011→2018) – only tracts ≥1 000 residents in both years  
WITH deltas AS (
    SELECT 
        t11."geo_id"                       AS "tract_geoid",
        t11."total_pop"                    AS "pop2011",
        a18."pop2018",
        (a18."pop2018"-t11."total_pop")*100.0/NULLIF(t11."total_pop",0)
                                            AS "pop_pct_change"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
    JOIN (
        SELECT SUBSTR("geo_id",1,11) AS "tract_geoid",
               SUM("total_pop")      AS "pop2018"
        FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
        WHERE  "geo_id" LIKE '36047%'
        GROUP BY SUBSTR("geo_id",1,11)
    ) a18
    ON t11."geo_id" = a18."tract_geoid"
    WHERE t11."geo_id" LIKE '36047%'
      AND t11."total_pop"  >= 1000
      AND a18."pop2018"    >= 1000
)
SELECT *
FROM   deltas
ORDER BY "pop_pct_change" DESC
LIMIT 20;
```

```sql
--Description: 6) Top-20 tracts by largest absolute increase in median income (2011→2018) – same population filter  
WITH deltas AS (
    SELECT 
        t11."geo_id"                       AS "tract_geoid",
        t11."median_income"                AS "inc2011",
        a18."median_income2018",
        (a18."median_income2018"-t11."median_income") 
                                            AS "inc_abs_change"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
    JOIN (
        SELECT SUBSTR("geo_id",1,11) AS "tract_geoid",
               SUM("median_income"*"total_pop")/NULLIF(SUM("total_pop"),0) 
                                            AS "median_income2018",
               SUM("total_pop")      AS "pop2018"
        FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
        WHERE  "geo_id" LIKE '36047%'
        GROUP BY SUBSTR("geo_id",1,11)
    ) a18
    ON  t11."geo_id" = a18."tract_geoid"
    WHERE t11."geo_id"     LIKE '36047%'
      AND t11."total_pop"  >= 1000
      AND a18."pop2018"    >= 1000
)
SELECT *
FROM   deltas
ORDER BY "inc_abs_change" DESC
LIMIT 20;
```

```sql
--Description: 7) Identify tracts that appear in BOTH of the top-20 lists above  
WITH pop_top AS (
    SELECT "tract_geoid"
    FROM (
        -- populate rank by % pop change
        SELECT 
            t11."geo_id" AS "tract_geoid",
            (a18."pop2018"-t11."total_pop")*100.0/NULLIF(t11."total_pop",0) 
                AS "pop_pct_change",
            ROW_NUMBER() OVER (ORDER BY 
                (a18."pop2018"-t11."total_pop")*100.0/NULLIF(t11."total_pop",0) DESC) AS rnk
        FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
        JOIN (
            SELECT SUBSTR("geo_id",1,11) AS "tract_geoid",
                   SUM("total_pop")      AS "pop2018"
            FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
            WHERE  "geo_id" LIKE '36047%'
            GROUP BY SUBSTR("geo_id",1,11)
        ) a18
        ON t11."geo_id" = a18."tract_geoid"
        WHERE t11."geo_id" LIKE '36047%'
          AND t11."total_pop" >= 1000
          AND a18."pop2018"   >= 1000
    ) 
    WHERE rnk <= 20
), inc_top AS (
    SELECT "tract_geoid"
    FROM (
        -- populate rank by absolute income change
        SELECT 
            t11."geo_id" AS "tract_geoid",
            (a18."median_income2018"-t11."median_income") AS "inc_abs_change",
            ROW_NUMBER() OVER (ORDER BY 
                (a18."median_income2018"-t11."median_income") DESC) AS rnk
        FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
        JOIN (
            SELECT SUBSTR("geo_id",1,11) AS "tract_geoid",
                   SUM("median_income"*"total_pop")/NULLIF(SUM("total_pop"),0) 
                       AS "median_income2018",
                   SUM("total_pop") AS "pop2018"
            FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
            WHERE  "geo_id" LIKE '36047%'
            GROUP BY SUBSTR("geo_id",1,11)
        ) a18
        ON t11."geo_id" = a18."tract_geoid"
        WHERE t11."geo_id" LIKE '36047%'
          AND t11."total_pop" >= 1000
          AND a18."pop2018"   >= 1000
    )
    WHERE rnk <= 20
)
SELECT DISTINCT p."tract_geoid"
FROM   pop_top p
JOIN   inc_top i
ON     p."tract_geoid" = i."tract_geoid"
LIMIT 20;
```

```sql
--Description: 8) Fetch the full 2011 & 2018 statistics for the intersecting tracts  
WITH target_tracts AS (
    /* reuse intersection logic and keep tract list */
    WITH pop_top AS (
        SELECT "tract_geoid"
        FROM (
            SELECT t11."geo_id" AS "tract_geoid",
                   (a18."pop2018"-t11."total_pop")*100.0/NULLIF(t11."total_pop",0) AS pct,
                   ROW_NUMBER() OVER (ORDER BY (a18."pop2018"-t11."total_pop")*100.0/NULLIF(t11."total_pop",0) DESC) r
            FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
            JOIN (
                SELECT SUBSTR("geo_id",1,11) AS "tract_geoid",
                       SUM("total_pop")      AS "pop2018"
                FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
                WHERE  "geo_id" LIKE '36047%'
                GROUP BY SUBSTR("geo_id",1,11)
            ) a18 ON t11."geo_id" = a18."tract_geoid"
            WHERE t11."geo_id" LIKE '36047%'
              AND t11."total_pop" >= 1000 AND a18."pop2018" >= 1000
        ) WHERE r <= 20
    ), inc_top AS (
        SELECT "tract_geoid"
        FROM (
            SELECT t11."geo_id" AS "tract_geoid",
                   (a18."median_income2018"-t11."median_income") AS inc_diff,
                   ROW_NUMBER() OVER (ORDER BY (a18."median_income2018"-t11."median_income") DESC) r
            FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
            JOIN (
                SELECT SUBSTR("geo_id",1,11) AS "tract_geoid",
                       SUM("median_income"*"total_pop")/NULLIF(SUM("total_pop"),0) AS "median_income2018",
                       SUM("total_pop") AS pop2018
                FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
                WHERE  "geo_id" LIKE '36047%'
                GROUP BY SUBSTR("geo_id",1,11)
            ) a18 ON t11."geo_id" = a18."tract_geoid"
            WHERE t11."geo_id" LIKE '36047%'
              AND t11."total_pop" >= 1000 AND a18.pop2018 >= 1000
        ) WHERE r <= 20
    )
    SELECT p."tract_geoid"
    FROM   pop_top p JOIN inc_top i ON p."tract_geoid" = i."tract_geoid"
)
SELECT 
    t."tract_geoid",
    t11."total_pop"            AS "pop2011",
    a18."pop2018",
    (a18."pop2018"-t11."total_pop")       AS "pop_abs_change",
    (a18."pop2018"-t11."total_pop")*100.0/NULLIF(t11."total_pop",0) AS "pop_pct_change",
    t11."median_income"        AS "inc2011",
    a18."median_income2018",
    (a18."median_income2018"-t11."median_income") AS "inc_abs_change"
FROM   target_tracts t
JOIN   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
       ON t."tract_geoid" = t11."geo_id"
JOIN   (
        SELECT SUBSTR("geo_id",1,11) AS "tract_geoid",
               SUM("total_pop") AS "pop2018",
               SUM("median_income"*"total_pop")/NULLIF(SUM("total_pop"),0) AS "median_income2018"
        FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
        WHERE  "geo_id" LIKE '36047%'
        GROUP BY SUBSTR("geo_id",1,11)
      ) a18
      ON t."tract_geoid" = a18."tract_geoid"
LIMIT 20;
```
