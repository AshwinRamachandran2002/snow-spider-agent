```sql
-- Description: 4) Bring 2011 tract data for county 36047 into a CTE style result set  
SELECT "geo_id"    AS "tract_id",
       "total_pop" AS "pop2011",
       "median_income" AS "medinc2011"
FROM   "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
WHERE  LEFT("geo_id",5) = '36047'
LIMIT  20;
```

```sql
-- Description: 5) Join 2011 tract data with 2018 tract aggregates to calculate changes  
SELECT  t11."tract_id",
        t11."pop2011",
        t18."pop2018",
        (t18."pop2018" - t11."pop2011")             AS "pop_abs_change",
        (t18."pop2018" - t11."pop2011")/NULLIF(t11."pop2011",0)  AS "pop_pct_change",
        t11."medinc2011",
        t18."medinc2018",
        (t18."medinc2018" - t11."medinc2011")       AS "medinc_abs_change"
FROM    ( /* 2011 */ SELECT "geo_id" AS "tract_id",
                           "total_pop" AS "pop2011",
                           "median_income" AS "medinc2011"
           FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
           WHERE LEFT("geo_id",5)='36047') t11
JOIN    ( /* 2018 aggregates */ SELECT SUBSTR("geo_id",1,11) AS "tract_id",
                                        SUM("total_pop") AS "pop2018",
                                        SUM("median_income"* "total_pop")/SUM("total_pop") AS "medinc2018"
           FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
           WHERE LEFT("geo_id",5)='36047'
           GROUP BY 1) t18
  ON t11."tract_id" = t18."tract_id"
LIMIT 20;
```

```sql
-- Description: 6) Top-20 tracts by % population increase (must also have >1,000 pop both years)  
SELECT  a.*
FROM   ( /* reuse joined calc */ 
        SELECT  t11."tract_id",
                t11."pop2011",
                t18."pop2018",
                (t18."pop2018"-t11."pop2011")/t11."pop2011" AS "pop_pct_change"
        FROM    (SELECT "geo_id" AS "tract_id",
                        "total_pop" AS "pop2011"
                 FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
                 WHERE LEFT("geo_id",5)='36047' AND "total_pop">1000) t11
        JOIN    (SELECT SUBSTR("geo_id",1,11) AS "tract_id",
                        SUM("total_pop") AS "pop2018"
                 FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
                 WHERE LEFT("geo_id",5)='36047'
                 GROUP BY 1
                 HAVING SUM("total_pop")>1000) t18
          ON t11."tract_id" = t18."tract_id" ) a
ORDER BY "pop_pct_change" DESC
LIMIT 20;
```

```sql
-- Description: 7) Top-20 tracts by absolute median-income increase (same >1,000 pop filter)  
WITH joined AS ( 
    SELECT  t11."tract_id",
            t11."medinc2011",
            t18."medinc2018",
            (t18."medinc2018" - t11."medinc2011") AS "medinc_abs_change"
    FROM   (SELECT "geo_id" AS "tract_id",
                   "median_income" AS "medinc2011",
                   "total_pop"
            FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
            WHERE LEFT("geo_id",5)='36047' AND "total_pop">1000) t11
    JOIN   (SELECT SUBSTR("geo_id",1,11) AS "tract_id",
                   SUM("median_income"* "total_pop")/SUM("total_pop") AS "medinc2018",
                   SUM("total_pop") AS "pop2018"
            FROM  "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
            WHERE LEFT("geo_id",5)='36047'
            GROUP BY 1
            HAVING SUM("total_pop")>1000) t18
      ON t11."tract_id" = t18."tract_id")
SELECT  *
FROM    joined
ORDER BY "medinc_abs_change" DESC
LIMIT 20;
```

```sql
-- Description: 8) Tracts that appear in both previous top-20 lists (intersection)  
WITH pop_top AS ( /* query 6 without LIMIT */ 
     SELECT  t11."tract_id"
     FROM   (SELECT "geo_id" AS "tract_id", "total_pop"
             FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
             WHERE LEFT("geo_id",5)='36047' AND "total_pop">1000) t11
     JOIN   (SELECT SUBSTR("geo_id",1,11) AS "tract_id", SUM("total_pop") AS "pop2018"
             FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
             WHERE LEFT("geo_id",5)='36047'
             GROUP BY 1
             HAVING SUM("total_pop")>1000) t18
       ON t11."tract_id" = t18."tract_id"
     ORDER BY (t18."pop2018"-t11."total_pop")/t11."total_pop" DESC
     LIMIT 20),
medinc_top AS ( /* query 7 without LIMIT */
     SELECT  t11."tract_id"
     FROM   (SELECT "geo_id" AS "tract_id", "median_income", "total_pop"
             FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
             WHERE LEFT("geo_id",5)='36047' AND "total_pop">1000) t11
     JOIN   (SELECT SUBSTR("geo_id",1,11) AS "tract_id",
                    SUM("median_income"* "total_pop")/SUM("total_pop") AS "medinc2018",
                    SUM("total_pop") AS "pop2018"
             FROM  "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
             WHERE LEFT("geo_id",5)='36047'
             GROUP BY 1
             HAVING SUM("total_pop")>1000) t18
       ON t11."tract_id" = t18."tract_id"
     ORDER BY (t18."medinc2018" - t11."median_income") DESC
     LIMIT 20)
SELECT DISTINCT p."tract_id"
FROM   pop_top p
JOIN   medinc_top m
  ON   p."tract_id" = m."tract_id"
LIMIT 20;
```

```sql
-- Description: 9) Final detail view for the intersecting tracts (population & income numbers)  
SELECT  j."tract_id",
        j."pop2011",
        j."pop2018",
        j."pop_pct_change",
        j."medinc2011",
        j."medinc2018",
        j."medinc_abs_change"
FROM   ( /* reuse comprehensive joined table from query 5 */ 
         SELECT  t11."tract_id",
                 t11."pop2011",
                 t18."pop2018",
                 (t18."pop2018" - t11."pop2011")/t11."pop2011" AS "pop_pct_change",
                 t11."medinc2011",
                 t18."medinc2018",
                 (t18."medinc2018" - t11."medinc2011") AS "medinc_abs_change"
         FROM   (SELECT "geo_id" AS "tract_id",
                        "total_pop" AS "pop2011",
                        "median_income" AS "medinc2011"
                 FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
                 WHERE LEFT("geo_id",5)='36047' AND "total_pop">1000) t11
         JOIN   (SELECT SUBSTR("geo_id",1,11) AS "tract_id",
                        SUM("total_pop") AS "pop2018",
                        SUM("median_income"* "total_pop")/SUM("total_pop") AS "medinc2018"
                 FROM  "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
                 WHERE LEFT("geo_id",5)='36047'
                 GROUP BY 1
                 HAVING SUM("total_pop")>1000) t18
           ON  t11."tract_id" = t18."tract_id") j
WHERE  j."tract_id" IN (SELECT "tract_id" FROM ( /* intersection query (8) */ 
                      WITH pop_top AS (
                           SELECT  t11."tract_id"
                           FROM   (SELECT "geo_id" AS "tract_id", "total_pop"
                                   FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
                                   WHERE LEFT("geo_id",5)='36047' AND "total_pop">1000) t11
                           JOIN   (SELECT SUBSTR("geo_id",1,11) AS "tract_id", SUM("total_pop") AS "pop2018"
                                   FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
                                   WHERE LEFT("geo_id",5)='36047'
                                   GROUP BY 1
                                   HAVING SUM("total_pop")>1000) t18
                             ON t11."tract_id" = t18."tract_id"
                           ORDER BY (t18."pop2018"-t11."total_pop")/t11."total_pop" DESC
                           LIMIT 20),
                           medinc_top AS (
                           SELECT  t11."tract_id"
                           FROM   (SELECT "geo_id" AS "tract_id", "median_income", "total_pop"
                                   FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
                                   WHERE LEFT("geo_id",5)='36047' AND "total_pop">1000) t11
                           JOIN   (SELECT SUBSTR("geo_id",1,11) AS "tract_id",
                                          SUM("median_income"* "total_pop")/SUM("total_pop") AS "medinc2018",
                                          SUM("total_pop") AS "pop2018"
                                   FROM  "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
                                   WHERE LEFT("geo_id",5)='36047'
                                   GROUP BY 1
                                   HAVING SUM("total_pop")>1000) t18
                             ON t11."tract_id" = t18."tract_id"
                           ORDER BY (t18."medinc2018" - t11."median_income") DESC
                           LIMIT 20)
                      SELECT DISTINCT p."tract_id"
                      FROM pop_top p JOIN medinc_top m ON p."tract_id" = m."tract_id"))
LIMIT 20;
