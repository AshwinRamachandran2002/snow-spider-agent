```sql
-- Description (thinking process):
-- Goal: Find Kings County, NY (FIPS 36047) census tracts that meet all three criteria:
--   1) Top-20 largest % increases in population from 2011→2018 (tracts must have >1,000 residents in both years).
--   2) Top-20 largest absolute increases in median household income over the same period.
--   3) Output each qualifying tract’s 2011 & 2018 population, % pop change, 2011 & 2018 median income, and absolute income change.
-- Method:
--   A) Pull 2011 tract-level pop & income (CENSUSTRACT_2011_5YR)   →  tract11.
--   B) Aggregate 2018 block-group data up to tract level (BLOCKGROUP_2018_5YR) → tract18.
--   C) Join those sets to compute pop % change and income abs change  → joined.
--   D) Rank joined tracts separately: by pop % change (pop_top) and by income abs change (medinc_top), each limited to 20.
--   E) Return the intersection (tracts appearing in both lists) with full detail.
WITH
tract11 AS (
    SELECT  "geo_id"        AS "tract_id",
            "total_pop"     AS "pop2011",
            "median_income" AS "medinc2011"
    FROM    "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
    WHERE   LEFT("geo_id",5) = '36047'          -- Kings County
      AND   "total_pop" > 1000                  -- pop threshold
),
tract18 AS (
    SELECT  SUBSTR("geo_id",1,11)               AS "tract_id",
            SUM("total_pop")                    AS "pop2018",
            SUM("median_income" * "total_pop") / SUM("total_pop") AS "medinc2018"
    FROM    "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
    WHERE   LEFT("geo_id",5) = '36047'
    GROUP   BY 1
    HAVING  SUM("total_pop") > 1000             -- pop threshold
),
joined AS (
    SELECT  t11."tract_id",
            t11."pop2011",
            t18."pop2018",
            (t18."pop2018" - t11."pop2011") / t11."pop2011"            AS "pop_pct_change",
            t11."medinc2011",
            t18."medinc2018",
            (t18."medinc2018" - t11."medinc2011")                       AS "medinc_abs_change"
    FROM    tract11 t11
    JOIN    tract18 t18
      ON    t11."tract_id" = t18."tract_id"
),
pop_top AS (
    SELECT  "tract_id"
    FROM    joined
    ORDER BY "pop_pct_change" DESC
    LIMIT   20
),
medinc_top AS (
    SELECT  "tract_id"
    FROM    joined
    ORDER BY "medinc_abs_change" DESC
    LIMIT   20
)
SELECT  j."tract_id",
        j."pop2011",
        j."pop2018",
        j."pop_pct_change",
        j."medinc2011",
        j."medinc2018",
        j."medinc_abs_change"
FROM    joined j
WHERE   j."tract_id" IN (SELECT "tract_id" FROM pop_top)
  AND   j."tract_id" IN (SELECT "tract_id" FROM medinc_top)
ORDER BY j."tract_id";
```
