Query:
-- Description: 5) Join 2011 tract data with 2018 tract aggregates to calculate changes  
SELECT  t11."tract_id",
        t11."pop2011",
        t18."pop2018",
        (t18."pop2018" - t11."pop2011")             AS "pop_abs_change",
        (t18."pop2018" - t11."pop2011")/NULLIF(t11."pop2011",0)  AS "pop_pct_change",
        t11."medinc2011",
        t18."medinc2018",
        (t18."medinc2018" - t11."medinc2011")       AS "medinc_abs_change"
FROM    ( /* 2011 */ SELECT "geo_id" AS "tract_id",
                           "total_pop" AS "pop2011",
                           "median_income" AS "medinc2011"
           FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
           WHERE LEFT("geo_id",5)='36047') t11
JOIN    ( /* 2018 aggregates */ SELECT SUBSTR("geo_id",1,11) AS "tract_id",
                                        SUM("total_pop") AS "pop2018",
                                        SUM("median_income"* "total_pop")/SUM("total_pop") AS "medinc2018"
           FROM "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
           WHERE LEFT("geo_id",5)='36047'
           GROUP BY 1) t18
  ON t11."tract_id" = t18."tract_id"
LIMIT 20;
