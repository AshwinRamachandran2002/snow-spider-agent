--Description: 6) Rank 36047 census tracts by absolute increase in median household income (2011 → 2018) – top 20  
WITH inc18 AS (
    SELECT 
        SUBSTR("geo_id",1,11)             AS "tract_id",
        AVG("median_income")              AS "median_income_2018"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE "geo_id" LIKE '36047%'
    GROUP BY SUBSTR("geo_id",1,11)
)
SELECT 
    t11."geo_id"                          AS "tract_id",
    t11."median_income"                   AS "income_2011",
    inc18."median_income_2018"            AS "income_2018",
    (inc18."median_income_2018" - t11."median_income") AS "income_change"
FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR  t11
JOIN inc18
  ON t11."geo_id" = inc18."tract_id"
WHERE t11."geo_id" LIKE '36047%'
ORDER BY "income_change" DESC
LIMIT 20
