--Description: Goal – obtain the 20 census tracts (11-digit GEOIDs) in Kings County (FIPS 36047) that experienced the largest percentage increase in population from 2011 to 2018.  
--Thinking process inside the SQL:  
--  1. Aggregate 2018 block-group population up to the tract level (each tract is the first 11 characters of a block-group GEOID).  
--  2. Join that 2018 tract population to the 2011 ACS tract table.  
--  3. Compute the % growth; guard against any 2011 population value of 0 with NULLIF to avoid division-by-zero.  
--  4. Order by the computed percentage in descending order and take the top 20.  

WITH agg18 AS (
    SELECT 
        SUBSTR("geo_id", 1, 11)                  AS "tract_id",
        SUM("total_pop")                         AS "pop_2018"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE "geo_id" LIKE '36047%'                -- only block-groups in Kings County
    GROUP BY SUBSTR("geo_id", 1, 11)
)
SELECT 
    t11."geo_id"                                AS "tract_id",
    t11."total_pop"                             AS "pop_2011",
    a18."pop_2018",
    (a18."pop_2018" - t11."total_pop")
      / NULLIF(t11."total_pop", 0) * 100        AS "pct_pop_increase"
FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR  t11
JOIN agg18 a18
  ON t11."geo_id" = a18."tract_id"
WHERE t11."geo_id" LIKE '36047%'                -- only tracts in Kings County
ORDER BY "pct_pop_increase" DESC
LIMIT 20;
