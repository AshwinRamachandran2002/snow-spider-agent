```sql
--Description: 7) Tracts appearing in BOTH top-20 lists, requiring >1,000 residents each year  
WITH pop_top AS (
     SELECT jt."tract_id"
     FROM (
           SELECT t11."geo_id" AS "tract_id",
                  t11."total_pop"    AS "pop_2011",
                  agg18."pop_2018"
           FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
           JOIN (
                 SELECT SUBSTR("geo_id",1,11) AS "tract_id",
                        SUM("total_pop")      AS "pop_2018"
                 FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
                 WHERE "geo_id" LIKE '36047%'
                 GROUP BY "tract_id"
                ) agg18
             ON t11."geo_id" = agg18."tract_id"
           WHERE t11."geo_id" LIKE '36047%'
                 AND t11."total_pop"  > 1000
                 AND agg18."pop_2018" > 1000
          ) jt
     ORDER BY (jt."pop_2018" - jt."pop_2011") / jt."pop_2011" DESC
     LIMIT 20
), inc_top AS (
     SELECT jt."tract_id"
     FROM (
           SELECT t11."geo_id" AS "tract_id",
                  t11."median_income"        AS "income_2011",
                  agg18."median_income_2018" AS "income_2018"
           FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
           JOIN (
                 SELECT SUBSTR("geo_id",1,11) AS "tract_id",
                        AVG("median_income")  AS "median_income_2018"
                 FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
                 WHERE "geo_id" LIKE '36047%'
                 GROUP BY "tract_id"
                ) agg18
             ON t11."geo_id" = agg18."tract_id"
           WHERE t11."geo_id" LIKE '36047%'
          ) jt
     ORDER BY (jt."income_2018" - jt."income_2011") DESC
     LIMIT 20
)
SELECT DISTINCT p."tract_id"
FROM pop_top p
JOIN inc_top i ON p."tract_id" = i."tract_id"
LIMIT 20;
```

```sql
--Description: 8) Detailed stats for the intersecting tracts (population & income, both years)  
WITH pop_top AS (
     SELECT jt."tract_id",
            (jt."pop_2018" - jt."pop_2011") / jt."pop_2011" * 100 AS "pct_pop_increase"
     FROM (
           SELECT t11."geo_id" AS "tract_id",
                  t11."total_pop" AS "pop_2011",
                  agg18."pop_2018"
           FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
           JOIN (
                 SELECT SUBSTR("geo_id",1,11) AS "tract_id",
                        SUM("total_pop")      AS "pop_2018"
                 FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
                 WHERE "geo_id" LIKE '36047%'
                 GROUP BY "tract_id"
                ) agg18
             ON t11."geo_id" = agg18."tract_id"
           WHERE t11."geo_id" LIKE '36047%'
                 AND t11."total_pop"  > 1000
                 AND agg18."pop_2018" > 1000
          ) jt
     ORDER BY "pct_pop_increase" DESC
     LIMIT 20
), inc_top AS (
     SELECT jt."tract_id",
            (jt."income_2018" - jt."income_2011") AS "income_change"
     FROM (
           SELECT t11."geo_id"        AS "tract_id",
                  t11."median_income" AS "income_2011",
                  agg18."median_income_2018" AS "income_2018"
           FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
           JOIN (
                 SELECT SUBSTR("geo_id",1,11) AS "tract_id",
                        AVG("median_income")   AS "median_income_2018"
                 FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
                 WHERE "geo_id" LIKE '36047%'
                 GROUP BY "tract_id"
                ) agg18
             ON t11."geo_id" = agg18."tract_id"
           WHERE t11."geo_id" LIKE '36047%'
          ) jt
     ORDER BY "income_change" DESC
     LIMIT 20
), both_top AS (
     SELECT DISTINCT p."tract_id"
     FROM pop_top p
     JOIN inc_top i ON p."tract_id" = i."tract_id"
)
SELECT b."tract_id",
       t11."total_pop"        AS "pop_2011",
       agg18."pop_2018",
       t11."median_income"    AS "income_2011",
       agg18."median_income_2018"
FROM both_top b
JOIN CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
  ON b."tract_id" = t11."geo_id"
JOIN (
      SELECT SUBSTR("geo_id",1,11) AS "tract_id",
             SUM("total_pop")      AS "pop_2018",
             AVG("median_income")  AS "median_income_2018"
      FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
      WHERE "geo_id" LIKE '36047%'
      GROUP BY "tract_id"
     ) agg18
  ON b."tract_id" = agg18."tract_id"
LIMIT 20;
```
