--Description: 8) Detailed 2011 & 2018 population and income statistics for tracts that qualify in BOTH lists above  
WITH pop18 AS (
    SELECT SUBSTR("geo_id",1,11)  AS "tract_id",
           SUM("total_pop")       AS "pop_2018"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE "geo_id" LIKE '36047%'
    GROUP BY SUBSTR("geo_id",1,11)
), inc18 AS (
    SELECT SUBSTR("geo_id",1,11)  AS "tract_id",
           AVG("median_income")   AS "income_2018"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE "geo_id" LIKE '36047%'
    GROUP BY SUBSTR("geo_id",1,11)
), pop_top AS (
    SELECT t11."geo_id" AS "tract_id",
           (pop18."pop_2018" - t11."total_pop")
           / NULLIF(t11."total_pop",0) * 100     AS "pct_pop_increase"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
    JOIN pop18 ON t11."geo_id" = pop18."tract_id"
    WHERE t11."geo_id" LIKE '36047%'
          AND t11."total_pop"  > 1000
          AND pop18."pop_2018" > 1000
    ORDER BY "pct_pop_increase" DESC
    LIMIT 20
), inc_top AS (
    SELECT t11."geo_id" AS "tract_id",
           (inc18."income_2018" - t11."median_income") AS "income_change"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
    JOIN inc18 ON t11."geo_id" = inc18."tract_id"
    WHERE t11."geo_id" LIKE '36047%'
    ORDER BY "income_change" DESC
    LIMIT 20
), both_top AS (
    SELECT DISTINCT p."tract_id"
    FROM pop_top p
    JOIN inc_top i ON p."tract_id" = i."tract_id"
)
SELECT 
    bt."tract_id",
    t11."total_pop"        AS "pop_2011",
    pop18."pop_2018",
    t11."median_income"    AS "income_2011",
    inc18."income_2018"
FROM both_top bt
JOIN CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
  ON bt."tract_id" = t11."geo_id"
JOIN pop18
  ON bt."tract_id" = pop18."tract_id"
JOIN inc18
  ON bt."tract_id" = inc18."tract_id"
LIMIT 20
