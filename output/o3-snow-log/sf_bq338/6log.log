--Description: 7) 36047 tracts that are in BOTH the top-20 % population-growth list and the top-20 absolute income-increase list, and that had >1,000 residents in 2011 & 2018  
WITH pop18 AS (   -- 2018 population aggregated to tract
    SELECT SUBSTR("geo_id",1,11) AS "tract_id",
           SUM("total_pop")      AS "pop_2018"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE "geo_id" LIKE '36047%'
    GROUP BY SUBSTR("geo_id",1,11)
),                                  -- top-20 by % pop growth
pop_top AS (
    SELECT 
        t11."geo_id"  AS "tract_id"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
    JOIN pop18
      ON t11."geo_id" = pop18."tract_id"
    WHERE t11."geo_id" LIKE '36047%'
          AND t11."total_pop"  > 1000
          AND pop18."pop_2018" > 1000
    ORDER BY (pop18."pop_2018" - t11."total_pop")
             / NULLIF(t11."total_pop",0) * 100 DESC
    LIMIT 20
),                                  -- top-20 by absolute income gain
inc18 AS (
    SELECT SUBSTR("geo_id",1,11) AS "tract_id",
           AVG("median_income")  AS "income_2018"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE "geo_id" LIKE '36047%'
    GROUP BY SUBSTR("geo_id",1,11)
),
inc_top AS (
    SELECT 
        t11."geo_id" AS "tract_id"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR t11
    JOIN inc18
      ON t11."geo_id" = inc18."tract_id"
    WHERE t11."geo_id" LIKE '36047%'
    ORDER BY (inc18."income_2018" - t11."median_income") DESC
    LIMIT 20
)
SELECT DISTINCT p."tract_id"
FROM pop_top  p
JOIN inc_top  i  ON p."tract_id" = i."tract_id"
LIMIT 20
