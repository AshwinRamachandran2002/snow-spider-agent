--Description: Identify tracts that are in BOTH top-20 lists above (population %-growth & income change)
WITH pop_rank AS (
    -- top 20 by % population increase
    WITH tract18 AS (
        SELECT SUBSTRING("geo_id",1,11) AS "tract_id",
               SUM("total_pop")         AS "pop_2018"
        FROM   "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
        WHERE  "geo_id" LIKE '36047%'
        GROUP  BY 1
    ),
    tract11 AS (
        SELECT "geo_id"    AS "tract_id",
               "total_pop" AS "pop_2011"
        FROM   "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
        WHERE  "geo_id" LIKE '36047%'
    )
    SELECT t11."tract_id"
    FROM   tract11 t11
    JOIN   tract18 t18 USING ("tract_id")
    WHERE  t11."pop_2011" > 1000 AND t18."pop_2018" > 1000
    ORDER  BY (t18."pop_2018" - t11."pop_2011") * 100.0 / t11."pop_2011" DESC
    LIMIT 20
),
income_rank AS (
    -- top 20 by absolute median-income increase
    WITH tract18 AS (
        SELECT SUBSTRING("geo_id",1,11) AS "tract_id",
               AVG("median_income")     AS "median_income_2018"
        FROM   "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
        WHERE  "geo_id" LIKE '36047%'
        GROUP  BY 1
    ),
    tract11 AS (
        SELECT "geo_id"        AS "tract_id",
               "median_income" AS "median_income_2011"
        FROM   "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
        WHERE  "geo_id" LIKE '36047%'
    )
    SELECT t11."tract_id"
    FROM   tract11 t11
    JOIN   tract18 t18 USING ("tract_id")
    ORDER  BY (t18."median_income_2018" - t11."median_income_2011") DESC
    LIMIT 20
)
SELECT DISTINCT p."tract_id"
FROM   pop_rank p
JOIN   income_rank i USING ("tract_id")
LIMIT 20;
