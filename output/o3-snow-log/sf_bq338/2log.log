            FROM   "CENSUS_BUREAU_ACS_1"."CENSUS_BUREAU_ACS"."CENSUSTRACT_2011_5YR"
            WHERE  "geo_id" LIKE '36047%'
        )
        SELECT t11."tract_id"
        FROM   tract11 t11
        JOIN   tract18 t18 USING ("tract_id")
        WHERE  t11."pop_2011" > 1000 AND t18."pop_2018" > 1000
        ORDER  BY (t18."pop_2018" - t11."pop_2011") * 100.0 / t11."pop_2011" DESC
