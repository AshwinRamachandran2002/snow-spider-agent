Query:
-- Description: Top-20 Kings County (36047) census tracts by absolute increase in median household income,
-- restricted to tracts with >1,000 residents in both 2011 & 2018.
WITH
/* ---------- 2011 data -----------------------------------------------------*/
pop11 AS (
    SELECT "geo_id"      AS "tract_id",
           "total_pop"   AS "pop_2011"
    FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR
    WHERE  "geo_id" LIKE '36047%'
),
inc11 AS (
    SELECT "geo_id"        AS "tract_id",
           "median_income" AS "med_inc_2011"
    FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR
    WHERE  "geo_id" LIKE '36047%'
),
/* ---------- 2018 data aggregated from block-groups ------------------------*/
pop18 AS (
    SELECT SUBSTR("geo_id",1,11) AS "tract_id",
           SUM("total_pop")      AS "pop_2018"
    FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE  "geo_id" LIKE '36047%'
    GROUP  BY 1
),
inc18 AS (
    SELECT SUBSTR("geo_id",1,11) AS "tract_id",
           AVG("median_income")  AS "med_inc_2018"
    FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE  "geo_id" LIKE '36047%'
    GROUP  BY 1
),
/* ---------- Compute absolute income change & filter pop>1k ---------------*/
metrics AS (
    SELECT i11."tract_id",
           i18."med_inc_2018" - i11."med_inc_2011" AS "abs_income_increase"
    FROM   inc11 i11
    JOIN   inc18 i18 ON i11."tract_id" = i18."tract_id"
    JOIN   pop11 p11 ON i11."tract_id" = p11."tract_id"
    JOIN   pop18 p18 ON i11."tract_id" = p18."tract_id"
    WHERE  p11."pop_2011" > 1000
      AND  p18."pop_2018" > 1000
      AND  i11."med_inc_2011" IS NOT NULL
      AND  i18."med_inc_2018" IS NOT NULL
)
SELECT "tract_id",
       "abs_income_increase"
FROM   metrics
ORDER  BY "abs_income_increase" DESC
LIMIT  20
