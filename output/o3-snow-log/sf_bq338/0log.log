```sql
-- Description (thinking process):
-- Goal → Kings County (FIPS 36047) census tracts that:
--   1) Had >1,000 residents in BOTH 2011 & 2018,
--   2) Are in the Top-20 for % population growth (2011→2018),
--   3) Are ALSO in the Top-20 for absolute ↑ in median household income,
-- Return those tracts with both growth metrics.
-- Steps inside the query:
--   • pop11 / inc11 : 2011 tract-level population & income (table already at tract resolution)
--   • pop18         : 2018 population by summing block-groups, then trimming to 11-digit tract id
--   • inc18         : 2018 median income by averaging block-groups (same trimming)
--   • metrics       : merge 11 vs 18; compute % pop change & $ income change; keep tracts meeting 1,000-pop rule
--   • pop_rank      : rank tracts by % pop change
--   • inc_rank      : rank tracts by $ income change
--   • final select  : intersect Top-20 lists (conditions 2 & 3)
WITH
/* 2011 data -----------------------------------------------------------------*/
pop11 AS (
    SELECT "geo_id"      AS "tract_id",
           "total_pop"   AS "pop_2011"
    FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR
    WHERE  "geo_id" LIKE '36047%'
),
inc11 AS (
    SELECT "geo_id"        AS "tract_id",
           "median_income" AS "med_inc_2011"
    FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR
    WHERE  "geo_id" LIKE '36047%'
),
/* 2018 data aggregated from block-groups ------------------------------------*/
pop18 AS (
    SELECT SUBSTR("geo_id",1,11) AS "tract_id",
           SUM("total_pop")      AS "pop_2018"
    FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE  "geo_id" LIKE '36047%'
    GROUP  BY 1
),
inc18 AS (
    SELECT SUBSTR("geo_id",1,11) AS "tract_id",
           AVG("median_income")  AS "med_inc_2018"
    FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE  "geo_id" LIKE '36047%'
    GROUP  BY 1
),
/* Combine & compute growth metrics -----------------------------------------*/
metrics AS (
    SELECT p11."tract_id",
           p11."pop_2011",
           p18."pop_2018",
           (p18."pop_2018" - p11."pop_2011") / p11."pop_2011" * 100  AS "pct_pop_increase",
           i11."med_inc_2011",
           i18."med_inc_2018",
           i18."med_inc_2018" - i11."med_inc_2011"                   AS "abs_inc_increase"
    FROM   pop11 p11
    JOIN   pop18 p18 ON p11."tract_id" = p18."tract_id"
    JOIN   inc11 i11 ON p11."tract_id" = i11."tract_id"
    JOIN   inc18 i18 ON p11."tract_id" = i18."tract_id"
    WHERE  p11."pop_2011" > 1000
      AND  p18."pop_2018" > 1000
      AND  i11."med_inc_2011" IS NOT NULL
      AND  i18."med_inc_2018" IS NOT NULL
),
/* Rank by population % growth ---------------------------------------------*/
pop_rank AS (
    SELECT "tract_id",
           "pct_pop_increase",
           ROW_NUMBER() OVER (ORDER BY "pct_pop_increase" DESC) AS "pop_rank"
    FROM   metrics
),
/* Rank by absolute income growth ------------------------------------------*/
inc_rank AS (
    SELECT "tract_id",
           "abs_inc_increase",
           ROW_NUMBER() OVER (ORDER BY "abs_inc_increase" DESC) AS "inc_rank"
    FROM   metrics
)
/* Intersect Top-20 lists ---------------------------------------------------*/
SELECT  p."tract_id",
        p."pct_pop_increase",
        i."abs_inc_increase",
        p."pop_rank",
        i."inc_rank"
FROM    pop_rank p
JOIN    inc_rank i
  ON    p."tract_id" = i."tract_id"
WHERE   p."pop_rank" <= 20   -- Top-20 by population growth
  AND   i."inc_rank" <= 20   -- Top-20 by income growth
ORDER BY p."pct_pop_increase" DESC;
