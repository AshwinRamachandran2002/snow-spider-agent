  AND  "total_pop" > 1000
LIMIT  20;
```

```sql
-- Description: 2011 median income per tract
SELECT "geo_id"         AS "tract_id",
       "median_income"  AS "med_income_2011"
FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR
WHERE  "geo_id" LIKE '36047%'
LIMIT  20;
```

```sql
-- Description: Combine 2011 vs 2018 numbers, compute % pop-change & $ income-change
WITH pop18 AS (
      SELECT SUBSTR("geo_id",1,11) AS "tract_id",
             SUM("total_pop")      AS "pop_2018"
      FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
      WHERE  "geo_id" LIKE '36047%'
      GROUP  BY 1
), inc18 AS (
      SELECT SUBSTR("geo_id",1,11) AS "tract_id",
             AVG("median_income")  AS "med_income_2018"
      FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
      WHERE  "geo_id" LIKE '36047%'
      GROUP  BY 1
), pop11 AS (
      SELECT "geo_id"  AS "tract_id",
             "total_pop" AS "pop_2011"
      FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR
      WHERE  "geo_id" LIKE '36047%'
), inc11 AS (
      SELECT "geo_id"        AS "tract_id",
             "median_income" AS "med_income_2011"
      FROM   CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUSTRACT_2011_5YR
      WHERE  "geo_id" LIKE '36047%'
)
SELECT p11."tract_id",
       p11."pop_2011",
       p18."pop_2018",
       (p18."pop_2018" - p11."pop_2011") / p11."pop_2011" * 100    AS "pct_pop_increase",
       i11."med_income_2011",
       i18."med_income_2018",
       i18."med_income_2018" - i11."med_income_2011"               AS "abs_income_increase"
FROM   pop11 p11
JOIN   pop18 p18 ON p11."tract_id" = p18."tract_id"
JOIN   inc11 i11 ON p11."tract_id" = i11."tract_id"
JOIN   inc18 i18 ON p11."tract_id" = i18."tract_id"
WHERE  p11."pop_2011" > 1000
  AND  p18."pop_2018" > 1000
LIMIT  20;
```

```sql
-- Description: Top-20 tracts by % population growth (among those with >1,000 pop both years)
WITH metrics AS ( /* same block as above */ 
      SELECT p11."tract_id",
             (p18."pop_2018" - p11."pop_2011") / p11."pop_2011" * 100 AS "pct_pop_increase"
      FROM   /* see previous CTEs */  pop11 p11
      JOIN   pop18 p18 ON p11."tract_id" = p18."tract_id"
      WHERE  p11."pop_2011" > 1000
        AND  p18."pop_2018" > 1000
)
SELECT "tract_id","pct_pop_increase"
FROM   metrics
ORDER  BY "pct_pop_increase" DESC
LIMIT  20;
```

```sql
-- Description: Top-20 tracts by absolute median-income growth (same population filter)
WITH metrics AS ( /* same joins as #7 */
      SELECT i11."tract_id",
             i18."med_income_2018" - i11."med_income_2011" AS "abs_income_increase"
      FROM   inc11 i11
      JOIN   inc18 i18 ON i11."tract_id" = i18."tract_id"
      JOIN   pop11 p11 ON i11."tract_id" = p11."tract_id"
      JOIN   pop18 p18 ON i11."tract_id" = p18."tract_id"
      WHERE  p11."pop_2011" > 1000
        AND  p18."pop_2018" > 1000
)
SELECT "tract_id","abs_income_increase"
FROM   metrics
ORDER  BY "abs_income_increase" DESC
LIMIT  20;
```

```sql
-- Description: FINAL – tracts that are in both Top-20 lists (population-growth & income-growth)
WITH pop_rank AS (
      /* % pop change & rank */
      SELECT p11."tract_id",
             (p18."pop_2018" - p11."pop_2011") / p11."pop_2011" * 100 AS "pct_pop_increase",
             ROW_NUMBER() OVER (ORDER BY (p18."pop_2018" - p11."pop_2011") / p11."pop_2011" DESC) AS "pop_rank"
      FROM   pop11 p11
      JOIN   pop18 p18 ON p11."tract_id" = p18."tract_id"
      WHERE  p11."pop_2011" > 1000
        AND  p18."pop_2018" > 1000
), inc_rank AS (
      /* $ income change & rank */
      SELECT i11."tract_id",
             i18."med_income_2018" - i11."med_income_2011"          AS "abs_income_increase",
             ROW_NUMBER() OVER (ORDER BY i18."med_income_2018" - i11."med_income_2011" DESC) AS "inc_rank"
      FROM   inc11 i11
      JOIN   inc18 i18 ON i11."tract_id" = i18."tract_id"
      JOIN   pop11 p11 ON i11."tract_id" = p11."tract_id"
      JOIN   pop18 p18 ON i11."tract_id" = p18."tract_id"
      WHERE  p11."pop_2011" > 1000
        AND  p18."pop_2018" > 1000
)
SELECT p."tract_id",
       p."pct_pop_increase",
       i."abs_income_increase"
FROM   pop_rank p
JOIN   inc_rank i ON p."tract_id" = i."tract_id"
WHERE  p."pop_rank" <= 20
  AND  i."inc_rank" <= 20
ORDER  BY p."pct_pop_increase" DESC
LIMIT  20;
```
