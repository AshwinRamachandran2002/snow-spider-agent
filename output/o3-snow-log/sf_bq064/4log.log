```sql
/* --------------------------------------------------------------------------
   1.  Select ZIP codes whose centroid lies within 5 miles (≈ 8 046.72 m) of
       the point 47.685833 °N , –122.191667 °W                           
   2.  For every such ZIP polygon, find every 2017 census tract polygon that
       overlaps it.                                                          
   3.  Allocate each tract’s population and income to the ZIP in proportion
       to the tract-ZIP area of intersection.                                
   4.  Aggregate the allocations, compute the average individual income,
       round to one decimal, and return the list ordered by that income.   
---------------------------------------------------------------------------*/
WITH
/* Target point as a GEOGRAPHY object */
target AS (
    SELECT ST_MAKEPOINT(-122.191667 , 47.685833)::GEOGRAPHY AS g
),

/* ZIP centroids that are within 5-mile (8 046.72 m) radius of the target */
candidate_zips AS (
    SELECT
        z."zip_code",
        z."internal_point_lat"  AS lat,
        z."internal_point_lon"  AS lon,
        ST_MAKEPOINT(z."internal_point_lon", z."internal_point_lat")::GEOGRAPHY AS centroid
    FROM  CENSUS_BUREAU_ACS_1.GEO_US_BOUNDARIES.ZIP_CODES  z
    WHERE ST_DISTANCE(
              ST_MAKEPOINT(z."internal_point_lon", z."internal_point_lat")::GEOGRAPHY ,
              (SELECT g FROM target)
          ) <= 8046.72          -- 5 miles in metres
),

/* Retrieve full ZIP polygons for the candidate list */
zip_geoms AS (
    SELECT
        g."zip_code",
        g."geometry"::GEOGRAPHY  AS geom
    FROM  CENSUS_BUREAU_ACS_1.GEO_US_BOUNDARIES.ZIP_CODES g
    WHERE g."zip_code" IN (SELECT "zip_code" FROM candidate_zips)
),

/* 2017 census tracts with geometry, population, and per-capita income */
tracts_2017 AS (
    SELECT
        t."geo_id"                          AS tract_id,
        t."total_pop",
        t."income_per_capita",
        t."geometry"::GEOGRAPHY             AS geom,
        ST_AREA(t."geometry"::GEOGRAPHY)    AS tract_area_m2,
        t."total_pop" * t."income_per_capita" AS tract_total_income
    FROM  CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.TRACTS_2017_5YR t
    WHERE t."total_pop" IS NOT NULL
),

/* Area-weighted allocation of tract population & income to ZIPs */
allocations AS (
    SELECT
        z."zip_code",
        SUM( t."total_pop" *
             ST_AREA( ST_INTERSECTION(z.geom , t.geom) ) /
             NULLIF( t.tract_area_m2 , 0 )
           )                                AS alloc_pop,
        SUM( t.tract_total_income *
             ST_AREA( ST_INTERSECTION(z.geom , t.geom) ) /
             NULLIF( t.tract_area_m2 , 0 )
           )                                AS alloc_income
    FROM   zip_geoms z
    JOIN   tracts_2017 t
           ON ST_INTERSECTS(z.geom , t.geom)
    GROUP  BY z."zip_code"
)

/* Final result: total population & average individual income per ZIP */
SELECT
    a."zip_code"                                        AS "ZIP_CODE",
    ROUND(a.alloc_pop                          , 1)     AS "total_population",
    ROUND(a.alloc_income / NULLIF(a.alloc_pop, 0), 1)   AS "average_individual_income"
FROM   allocations a
ORDER  BY "average_individual_income" DESC NULLS LAST;
```
