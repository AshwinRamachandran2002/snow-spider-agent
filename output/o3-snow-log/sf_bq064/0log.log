```sql
/*  STEP-BY-STEP
    1.  Bring in 2017 tract geometries and attach their ACS population & per-capita income.
    2.  Overlay those tracts with ZCTA (ZIP-code) polygons and
        work out the share of each tract that falls inside every ZIP.
    3.  Apportion each tract’s population and total income to the ZIPs
        in proportion to that area share.
    4.  Keep only ZIPs whose centroid is within 5 miles (≈8 046.72 m) of
        the reference point  (lat 47.685833  long –122.191667).
    5.  For every remaining ZIP, return the total population and the
        average individual (per-capita) income, rounded to 1 decimal,
        ordered by the latter (high → low).                                           */
WITH
/* ---------- 2017 TRACT SHAPES + DEMOGRAPHICS ---------- */
tracts AS (
    SELECT
        g."GEOID"                              AS "tract_geoid",
        g."GEOM"                               AS "geom",
        d."total_pop"                          AS "total_pop",
        d."income_per_capita"                  AS "income_per_capita"
    FROM  CENSUS_BUREAU_ACS_1.GEO_US_BOUNDARIES.CENSUS_TRACTS_2017        g
    JOIN  CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.CENSUS_TRACTS_2017_5YR    d
          ON g."GEOID" = d."geo_id"
),
/* ---------- ZIP-CODE (ZCTA) SHAPES ---------- */
zips AS (
    SELECT
        z."zip_code"       AS "zip_code",
        z."GEOM"           AS "geom"
    FROM CENSUS_BUREAU_ACS_1.GEO_US_BOUNDARIES.ZIP_CODES z
),
/* ---------- TRACT–ZIP AREA INTERSECTIONS ---------- */
overlaps AS (
    SELECT
        t."tract_geoid",
        z."zip_code",
        ST_AREA( ST_INTERSECTION(t."geom", z."geom") )    AS "inter_area",
        ST_AREA( t."geom" )                               AS "tract_area",
        t."total_pop",
        t."income_per_capita"
    FROM tracts t
    JOIN zips  z
          ON ST_INTERSECTS(t."geom", z."geom")
    WHERE ST_AREA( ST_INTERSECTION(t."geom", z."geom") ) > 0
),
/* ---------- POPULATION & INCOME ALLOCATED TO ZIPs ---------- */
allocated AS (
    SELECT
        "zip_code",
        SUM( ("total_pop" * "inter_area") / "tract_area" )                          AS "allocated_pop",
        SUM( ("total_pop" * "income_per_capita" * "inter_area") / "tract_area" )    AS "allocated_income"
    FROM overlaps
    GROUP BY "zip_code"
),
/* ---------- ZIP CENTROIDS WITH DISTANCE TO TARGET POINT ---------- */
zip_centroids AS (
    SELECT
        z."zip_code",
        z."internal_point_lat",
        z."internal_point_lon",
        ST_MAKEPOINT(z."internal_point_lon", z."internal_point_lat")  AS "centroid"
    FROM CENSUS_BUREAU_ACS_1.GEO_US_BOUNDARIES.ZIP_CODES z
)
/* ---------- FINAL RESULT ---------- */
SELECT
    a."zip_code",
    ROUND(a."allocated_pop", 1)                                       AS "total_population",
    ROUND(a."allocated_income" / NULLIF(a."allocated_pop", 0), 1)     AS "avg_individual_income"
FROM      allocated      a
JOIN      zip_centroids  c   ON a."zip_code" = c."zip_code"
WHERE ST_DISTANCE(
          c."centroid",
          ST_MAKEPOINT(-122.191667, 47.685833)      -- reference point
      ) <= 8046.72                                   -- <= 5 miles in metres
ORDER BY "avg_individual_income" DESC NULLS LAST;
```
