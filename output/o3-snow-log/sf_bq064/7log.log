```sql
/*---------------------------------------------------------------------------
  1.  Pull 2017 ACS tract-level population & per-capita income together with
      their polygons (GEOG) from the BigQuery public data that has been made
      available in Snowflake.
  2.  Intersect each tract polygon with ZIP-code polygons, allocate population
      and income in proportion to the overlap area.
  3.  Keep only ZIP codes whose internal point lies within a 5-mile (8 046.72 m)
      radius of the chosen point in Washington (47.685833 N, -122.191667 W).
  4.  Aggregate the allocated population and income to ZIP level, calculate the
      average individual income, round to one decimal, and show the result
      ordered by income (high → low).
---------------------------------------------------------------------------*/
WITH "TRACTS" AS (          -- 2017 ACS 5-year tract data
    SELECT
        "GEOID"                                         AS "TRACT_GEOID",
        CAST("TOTAL_POP"          AS DOUBLE)            AS "TRACT_POP",
        CAST("INCOME_PER_CAPITA"  AS DOUBLE)            AS "TRACT_PCI",
        "GEOG"                                          AS "TRACT_GEOG",
        CAST("TOTAL_POP" AS DOUBLE)
        * CAST("INCOME_PER_CAPITA" AS DOUBLE)           AS "TRACT_TOT_INC"
    FROM BIGQUERY_PUBLICDATA.CENSUS_BUREAU_ACS.ACS_TRACTS_2017_5YR
),

"ZIP_POLYS" AS (           -- ZIP polygons plus internal point
    SELECT
        "ZIP_CODE",
        "GEOG",                            -- polygon
        CAST("INTERNAL_POINT_LAT" AS DOUBLE) AS "LAT",
        CAST("INTERNAL_POINT_LON" AS DOUBLE) AS "LON"
    FROM CENSUS_BUREAU_ACS_1.GEO_US_BOUNDARIES.ZIP_CODES
),

/*  Intersect every tract with every ZIP it touches; compute the share
    of each tract that lies inside the ZIP (by area). */
"TRACT_ZIP_INTX" AS (
    SELECT
        t."TRACT_GEOID",
        z."ZIP_CODE",
        ST_AREA( ST_INTERSECTION(t."TRACT_GEOG", z."GEOG") )    AS "INT_AREA",
        ST_AREA( t."TRACT_GEOG" )                               AS "TRACT_AREA",
        t."TRACT_POP",
        t."TRACT_TOT_INC"
    FROM "TRACTS" t
    JOIN "ZIP_POLYS" z
      ON ST_INTERSECTS(t."TRACT_GEOG", z."GEOG")
    WHERE ST_AREA( ST_INTERSECTION(t."TRACT_GEOG", z."GEOG") ) > 0
),

/*  Allocate tract population & income to the ZIP in proportion
    to the intersecting area. */
"ALLOCATED" AS (
    SELECT
        "ZIP_CODE",
        SUM( "TRACT_POP"     * "INT_AREA" / NULLIF("TRACT_AREA",0) ) AS "ZIP_POP",
        SUM( "TRACT_TOT_INC" * "INT_AREA" / NULLIF("TRACT_AREA",0) ) AS "ZIP_INC"
    FROM "TRACT_ZIP_INTX"
    GROUP BY "ZIP_CODE"
),

/*  Keep ZIP codes whose internal point is within 5 miles (8 046.72 m). */
"IN_RADIUS" AS (
    SELECT
        a."ZIP_CODE",
        a."ZIP_POP",
        a."ZIP_INC"
    FROM "ALLOCATED"        a
    JOIN "ZIP_POLYS"        z
      ON a."ZIP_CODE" = z."ZIP_CODE"
    WHERE ST_DISTANCE(
              ST_MAKEPOINT(z."LON", z."LAT"),
              ST_MAKEPOINT(-122.191667 , 47.685833)
          ) <= 8046.72      -- 5 miles in metres
)

/*  Final result -----------------------------------------------------------*/
SELECT
    "ZIP_CODE",
    ROUND("ZIP_POP", 1)                                              AS "TOTAL_POPULATION",
    ROUND("ZIP_INC" / NULLIF("ZIP_POP",0), 1)                        AS "AVERAGE_INDIVIDUAL_INCOME"
FROM "IN_RADIUS"
ORDER BY "AVERAGE_INDIVIDUAL_INCOME" DESC NULLS LAST;
```
