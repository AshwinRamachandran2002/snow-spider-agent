```sql
WITH tract_attributes AS (   -- 2017 ACS tract-level population & income
    SELECT
        "geo_id",
        "total_pop",
        "income_per_capita"
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS."TRACTS_2017_5YR"
),

tract_geoms AS (            -- geographic polygons for each tract
    SELECT
        "geo_id",
        "geom"
    FROM CENSUS_BUREAU_ACS_1.GEO_US_BOUNDARIES."TRACTS"
),

zip_geoms AS (              -- polygons + centroid for each ZIP
    SELECT
        "zip_code",
        "geom",
        "internal_point_lat",
        "internal_point_lon"
    FROM CENSUS_BUREAU_ACS_1.GEO_US_BOUNDARIES."ZIP_CODES"
),

/* 1.  Find overlap area between every tract and every ZIP */
tract_zip_intersection AS (
    SELECT
        tg."geo_id"  AS tract_id,
        zg."zip_code",
        ST_AREA(ST_INTERSECTION(tg."geom", zg."geom")) AS intersect_area,
        ST_AREA(tg."geom")                            AS tract_area
    FROM tract_geoms tg
    JOIN zip_geoms  zg
      ON ST_INTERSECTS(tg."geom", zg."geom")
),

/* 2.  Allocate each tract’s population & income to ZIPs
       in proportion to the share of its area inside the ZIP */
proportional_allocation AS (
    SELECT
        tzi."zip_code",
        ta."total_pop" * (tzi.intersect_area / tzi.tract_area)              AS alloc_pop,
        (ta."total_pop" * ta."income_per_capita") * 
        (tzi.intersect_area / tzi.tract_area)                               AS alloc_income
    FROM tract_zip_intersection tzi
    JOIN tract_attributes       ta
      ON tzi.tract_id = ta."geo_id"
    WHERE tzi.intersect_area > 0
),

/* 3.  Aggregate to ZIP level */
zip_level AS (
    SELECT
        "zip_code",
        SUM(alloc_pop)                                AS total_pop,
        SUM(alloc_income) / NULLIF(SUM(alloc_pop),0)  AS avg_income
    FROM proportional_allocation
    GROUP BY "zip_code"
),

/* 4.  Keep only ZIPs within 5 miles of the given point in WA */
zips_within_radius AS (
    SELECT
        zl."zip_code",
        ROUND(zl.total_pop, 1)          AS total_pop,
        ROUND(zl.avg_income, 1)         AS average_individual_income
    FROM zip_level  zl
    JOIN zip_geoms zg
      ON zl."zip_code" = zg."zip_code"
    WHERE ST_DISTANCE(
              ST_MAKEPOINT(-122.191667, 47.685833)::GEOGRAPHY,
              ST_MAKEPOINT(zg."internal_point_lon", zg."internal_point_lat")::GEOGRAPHY
          ) <= 5 * 1609.34             -- 5 miles in metres
)

/* 5.  Final result */
SELECT
    "zip_code",
    total_pop,
    average_individual_income
FROM zips_within_radius
ORDER BY average_individual_income DESC NULLS LAST;
```
