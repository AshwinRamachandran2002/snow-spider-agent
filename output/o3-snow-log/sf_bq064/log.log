```sql
/* 1. bring in 2017 ACS tract-level population & per-capita income  */
WITH tract_acs AS (   
    SELECT
        "geo_id",
        CAST("total_pop"        AS FLOAT)  AS total_pop,
        CAST("income_per_capita" AS FLOAT) AS income_per_capita
    FROM CENSUS_BUREAU_ACS_1.CENSUS_BUREAU_ACS.TRACTS_2017_5YR
),

/* 2. geometry for tracts & ZIP codes                                            */
tract_geom AS (
    SELECT
        "geo_id",
        "geog"
    FROM CENSUS_BUREAU_ACS_1.GEO_US_BOUNDARIES.TRACTS
),
zip_geom AS (
    SELECT
        "zip_code",
        "geog",
        "internal_point_lat",
        "internal_point_lon"
    FROM CENSUS_BUREAU_ACS_1.GEO_US_BOUNDARIES.ZIP_CODES
),

/* 3. ZIP codes whose centroids lie within 5 miles of the given point            */
near_zips AS (
    SELECT
        "zip_code",
        "geog"
    FROM zip_geom
    WHERE ST_DISTANCE(
              TO_GEOGRAPHY(ST_POINT("internal_point_lon", "internal_point_lat")),
              TO_GEOGRAPHY(ST_POINT(-122.191667, 47.685833))
          ) <= 5 * 1609.34          -- 5 miles in metres
),

/* 4. area‐weighted intersection between those ZIPs and tracts                   */
tract_zip_int AS (
    SELECT
        nz."zip_code",
        tg."geo_id"                                        AS tract_id,
        ST_AREA(ST_INTERSECTION(nz."geog", tg."geog"))     AS intersect_area,
        ST_AREA(tg."geog")                                 AS tract_area
    FROM near_zips  nz
    JOIN tract_geom tg
      ON ST_INTERSECTS(nz."geog", tg."geog")
      AND ST_AREA(ST_INTERSECTION(nz."geog", tg."geog")) > 0
),

/* 5. allocate each tract’s population & income to the ZIP by the area ratio     */
alloc AS (
    SELECT
        tzi."zip_code",
        (ta.total_pop * tzi.intersect_area / tzi.tract_area)                        AS pop_alloc,
        (ta.income_per_capita * ta.total_pop * tzi.intersect_area / tzi.tract_area) AS income_alloc
    FROM tract_zip_int tzi
    JOIN tract_acs     ta
      ON ta."geo_id" = tzi.tract_id
),

/* 6. aggregate allocations to ZIP level                                         */
zip_totals AS (
    SELECT
        "zip_code",
        SUM(pop_alloc)                                               AS total_population,
        SUM(income_alloc) / NULLIF(SUM(pop_alloc), 0)                AS avg_individual_income
    FROM alloc
    GROUP BY "zip_code"
)

/* 7. final output                                                              */
SELECT
    "zip_code",
    ROUND(total_population,        1) AS "total_population",
    ROUND(avg_individual_income,   1) AS "average_individual_income"
FROM zip_totals
ORDER BY "average_individual_income" DESC NULLS LAST;
```
