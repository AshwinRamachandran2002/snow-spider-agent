--  fails to match (most of these are static-import lines such as
--  “import static …”).  By inspecting these edge-cases we can decide
--  whether the regex should be broadened.
--
--  Steps:
--    1. Restrict SAMPLE_CONTENTS to rows whose file path ends with '.java'.
--    2. Split each file’s entire text into individual lines (SPLIT_TO_TABLE).
--    3. Keep the lines that contain the keyword 'import'.
--    4. Apply the regex used in the main analysis to capture a normal package:
--         import\s+([A-Za-z0-9_\.]+)\.[A-Za-z0-9_\*]+\s*;
--       If REGEXP_SUBSTR returns NULL, that line did not match (edge-case).
--    5. Limit the output to 20 such unmatched lines.
SELECT
  ln.value::STRING AS "raw_import_line"
FROM  GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  sc,
      LATERAL SPLIT_TO_TABLE(sc."content", '\n') ln
WHERE sc."sample_path" ILIKE '%.java'                 -- only Java source files
  AND ln.value ILIKE 'import %'                       -- import statements
  AND REGEXP_SUBSTR(
        ln.value::STRING,
        'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
        1, 1, 'e', 1                                   -- return capture group 1
      ) IS NULL                                       -- regex did NOT match
LIMIT 20;
```
