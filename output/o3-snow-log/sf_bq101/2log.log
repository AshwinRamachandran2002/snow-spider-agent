--Description: 
--  Extract a sample of 20 Java import lines that are NOT matched by the
--  current package-extraction regex (most of these are static-import
--  statements such as “import static …”).  Analysing these edge-cases will
--  reveal patterns the regex currently ignores and indicate whether it
--  should be broadened.
--
--  Steps carried out by the query
--    1. Select rows from SAMPLE_CONTENTS where the file path ends in “.java”.
--    2. Split each file’s full text into individual lines (SPLIT_TO_TABLE).
--    3. Keep only lines that contain the keyword “import”.
--    4. Apply the “normal import” regex
--         import\s+([A-Za-z0-9_\.]+)\.[A-Za-z0-9_\*]+\s*;
--       If REGEXP_SUBSTR returns NULL, the regex missed that line (edge-case).
--    5. Limit the output to 20 unmatched lines.
SELECT
  ln.value::STRING AS "raw_import_line"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc,
     LATERAL SPLIT_TO_TABLE(sc."content", '\n') ln
WHERE sc."sample_path" ILIKE '%.java'                 -- only Java source files
  AND ln.value ILIKE 'import %'                       -- import statements
  AND REGEXP_SUBSTR(
        ln.value::STRING,
        'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
        1, 1, 'e', 1                                   -- return capture group #1
      ) IS NULL                                       -- regex did NOT match
LIMIT 20;
```
