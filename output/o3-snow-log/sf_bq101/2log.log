WHERE t."sample_path" ILIKE '%.java'
LIMIT 20;
```

```sql
--Description: Retrieve only the lines that look like Java import statements  
SELECT 
  l.value::STRING AS "import_line"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
     LATERAL SPLIT_TO_TABLE(t."content", '\n') l
WHERE t."sample_path" ILIKE '%.java'
  AND l.value ILIKE 'import %'
LIMIT 20;
```

```sql
--Description: Extract the full import target (package + class) with a regex  
SELECT 
  REGEXP_SUBSTR(l.value::STRING,
                'import\\s+([A-Za-z0-9_\\.\\*]+)\\s*;',
                1, 1, 'e')      AS "full_import"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
     LATERAL SPLIT_TO_TABLE(t."content", '\n') l
WHERE t."sample_path" ILIKE '%.java'
  AND l.value ILIKE 'import %'
LIMIT 20;
```

```sql
--Description: Extract only the package portion (drop the trailing class or *)  
SELECT 
  REGEXP_SUBSTR(l.value::STRING,
                'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
                1, 1, 'e', 1) AS "import_package"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
     LATERAL SPLIT_TO_TABLE(t."content", '\n') l
WHERE t."sample_path" ILIKE '%.java'
  AND l.value ILIKE 'import %'
LIMIT 20;
```

```sql
--Description: Count how many times each package occurs in the whole Java corpus  
SELECT 
  pkg."import_package",
  COUNT(*) AS "occurrences"
FROM (
  SELECT 
    REGEXP_SUBSTR(l.value::STRING,
                  'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
                  1, 1, 'e', 1) AS "import_package"
  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
       LATERAL SPLIT_TO_TABLE(t."content", '\n') l
  WHERE t."sample_path" ILIKE '%.java'
    AND l.value ILIKE 'import %'
) pkg
WHERE pkg."import_package" IS NOT NULL
GROUP BY pkg."import_package"
ORDER BY "occurrences" DESC
LIMIT 20;
```

```sql
--Description: Produce the top-10 most frequently imported packages in descending order  
SELECT 
  pkg."import_package"      AS "package",
  COUNT(*)                  AS "import_count"
FROM (
  SELECT 
    REGEXP_SUBSTR(l.value::STRING,
                  'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
                  1, 1, 'e', 1) AS "import_package"
  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
       LATERAL SPLIT_TO_TABLE(t."content", '\n') l
  WHERE t."sample_path" ILIKE '%.java'
    AND l.value ILIKE 'import %'
) pkg
WHERE pkg."import_package" IS NOT NULL
GROUP BY pkg."import_package"
ORDER BY "import_count" DESC
LIMIT 10;
```

```sql
--Description: Same as previous, but also list one example repository where each package appears  
SELECT 
  top_pkg."import_package"           AS "package",
  top_pkg."import_count",
  ANY_VALUE(top_pkg."sample_repo")   AS "example_repo"
FROM (
  SELECT 
    REGEXP_SUBSTR(l.value::STRING,
                  'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
                  1, 1, 'e', 1)      AS "import_package",
    t."sample_repo_name"             AS "sample_repo"
  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
       LATERAL SPLIT_TO_TABLE(t."content", '\n') l
  WHERE t."sample_path" ILIKE '%.java'
    AND l.value ILIKE 'import %'
) top_pkg
WHERE top_pkg."import_package" IS NOT NULL
GROUP BY top_pkg."import_package"
QUALIFY ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) <= 10
ORDER BY "import_count" DESC;
```

