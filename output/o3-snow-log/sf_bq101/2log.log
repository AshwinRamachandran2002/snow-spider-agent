--    3. Keep lines containing the keyword “import”.
--    4. Apply the regex used in the main analysis:
--         import\s+([A-Za-z0-9_\.]+)\.[A-Za-z0-9_\*]+\s*;
--       ‑ If REGEXP_SUBSTR returns NULL, the line did not match → edge-case.
--    5. Limit output to 20 unmatched lines.
SELECT
  ln.value::STRING AS "raw_import_line"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc,
     LATERAL SPLIT_TO_TABLE( sc."content", '\n' ) ln
WHERE sc."sample_path" ILIKE '%.java'                  -- inspect Java files
  AND ln.value ILIKE 'import %'                        -- import statements
  AND REGEXP_SUBSTR(
        ln.value::STRING,
        'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
        1, 1, 'e', 1                                    -- capture group 1
      ) IS NULL                                        -- regex did NOT match
LIMIT 20;
