--Description: 
--  Extract 20 Java import statements that the existing package-extraction
--  regex does NOT recognise (chiefly static imports like “import static …”).
--  These edge-cases reveal patterns the regex currently ignores and help
--  decide whether it should be broadened.
--
--  Steps performed by the query
--    1. Restrict to SAMPLE_CONTENTS rows whose file path ends in “.java”.
--    2. Split each file’s source text into individual lines (SPLIT_TO_TABLE).
--    3. Keep lines that include the keyword “import”.
--    4. Apply the analysis regex
--         import\s+([A-Za-z0-9_\.]+)\.[A-Za-z0-9_\*]+\s*;
--       If REGEXP_SUBSTR returns NULL, that line did not match (edge-case).
--    5. Limit the result to 20 such unmatched lines.
SELECT
  ln.value::STRING AS "raw_import_line"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc,
     LATERAL SPLIT_TO_TABLE(sc."content", '\n') ln
WHERE sc."sample_path" ILIKE '%.java'                      -- only Java source files
  AND ln.value ILIKE 'import %'                            -- import statements
  AND REGEXP_SUBSTR(
        ln.value::STRING,
        'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
        1, 1, 'e', 1                                        -- return capture group 1
      ) IS NULL                                            -- regex did NOT match
LIMIT 20;
```
