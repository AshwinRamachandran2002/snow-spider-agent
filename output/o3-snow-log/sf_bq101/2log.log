--Description: 
--  Purpose: Retrieve a sample of 20 Java import statements that the current
--  package-extraction regex fails to match (for example static imports
--  like “import static …”).  These edge-cases can then be inspected to
--  decide whether the regex should be broadened.
--
--  Logic:
--    1. Select rows from SAMPLE_CONTENTS whose file paths end in “.java”.
--    2. Split each file’s source text into individual lines (SPLIT_TO_TABLE).
--    3. Keep lines that contain the keyword “import”.
--    4. Run the regex used in the main analysis to capture the package:
--         import\s+([A-Za-z0-9_\.]+)\.[A-Za-z0-9_\*]+\s*;
--       If REGEXP_SUBSTR returns NULL the line didn’t match (i.e., it is an
--       edge-case statement the regex ignores).
--    5. Limit the output to 20 such unmatched lines for manual review.
SELECT
  ln.value::STRING AS "raw_import_line"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc,
     LATERAL SPLIT_TO_TABLE(sc."content", '\n') ln
WHERE sc."sample_path" ILIKE '%.java'                -- only Java source files
  AND ln.value ILIKE 'import %'                      -- import statements
  AND REGEXP_SUBSTR(
        ln.value::STRING,
        'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
        1, 1, 'e', 1                                 -- return first capture group
      ) IS NULL                                      -- regex did NOT match
LIMIT 20;
