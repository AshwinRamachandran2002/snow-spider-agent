```sql
--Description: 
--  Task: Find the 10 Java packages that appear most often in import statements, plus an example repo.
--  Thinking process:
--    • Filter SAMPLE_CONTENTS to rows whose paths end in “.java”.
--    • Split each Java file’s text into lines (SPLIT_TO_TABLE).
--    • Keep lines that begin with “import”.
--    • Use REGEXP_SUBSTR to pull out only the package part:
--          import  <package>.<ClassOr*> ;
--      The capturing group ([A-Za-z0-9_\.]+) stops at the last dot.
--    • Count occurrences of each package.
--    • ANY_VALUE gives one representative repo for each package.
--    • Order by count, return the top 10.
SELECT
    p."import_package"           AS "package",
    COUNT(*)                     AS "import_count",
    ANY_VALUE(p."sample_repo")   AS "example_repo"
FROM (
    SELECT
        REGEXP_SUBSTR(
            line.value::STRING,
            'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
            1, 1, 'e', 1)        AS "import_package",
        sc."sample_repo_name"     AS "sample_repo"
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc,
         LATERAL SPLIT_TO_TABLE(sc."content", '\n') line
    WHERE sc."sample_path" ILIKE '%.java'
      AND line.value ILIKE 'import %'
) p
WHERE p."import_package" IS NOT NULL
GROUP BY p."import_package"
ORDER BY "import_count" DESC
LIMIT 10;
```
