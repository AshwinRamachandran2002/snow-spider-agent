-- Description: Identify the 10 Java packages imported most frequently in all
--              sample *.java files.  
--              Thinking process encoded below:  
--                1) Restrict to rows where the file path ends in “.java”.  
--                2) Split each file’s content into individual lines.  
--                3) Keep only lines that match “import <package>.<class|*>;”.  
--                4) Use REGEXP_SUBSTR with sub-expression flag ('e') to capture
--                   only the package portion (group-1, everything before the last dot).  
--                5) Aggregate counts per package, sort by descending frequency,
--                   and return the top 10.
SELECT
    pkg."package_name",
    COUNT(*) AS "import_count"
FROM (
    SELECT
        REGEXP_SUBSTR(
            ln.value,                                            -- individual line text
            'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;', -- regex capturing package
            1, 1, 'e', 1                                         -- return capture group #1
        ) AS "package_name"
    FROM GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS" AS file
         , LATERAL SPLIT_TO_TABLE(file."content", '\n') AS ln
    WHERE file."sample_path" ILIKE '%.java'                       -- include only Java source files
      AND REGEXP_LIKE(
            ln.value,
            '^\\s*import\\s+[A-Za-z0-9_\\.]+\\.[A-Za-z0-9_\\*]+\\s*;' -- retain valid import lines
          )
) pkg
WHERE pkg."package_name" IS NOT NULL
GROUP BY pkg."package_name"
ORDER BY "import_count" DESC
LIMIT 10;
