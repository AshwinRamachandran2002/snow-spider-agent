-- Description: Retrieve 20 unique Java package names (without the trailing class or “*”)
--              from import statements to ensure the regex correctly isolates just
--              the package portion.  Logic:
--                1) Consider only rows whose file path ends with “.java”.
--                2) Split each file’s content into individual lines.
--                3) Keep lines matching the canonical pattern “import <package>.<class|*>;”.
--                4) REGEXP_SUBSTR with sub-expression flag ('e') returns the captured
--                   group containing only the package name (everything before the last dot).
SELECT DISTINCT
       REGEXP_SUBSTR(
           ln.value,
           'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
           1, 1, 'e', 1          -- captured group #1 = package name
       ) AS "package_name"
FROM GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS" AS f,
