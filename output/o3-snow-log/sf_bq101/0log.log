--              Query logic:
--                1) Consider only files whose paths end with “.java”.
--                2) Split each file’s source code into individual lines.
--                3) Keep lines matching the canonical pattern “import <package>.<class|*>;”.
--                4) Use REGEXP_SUBSTR (with sub-expression flag ‘e’) to capture only
--                   the package portion (everything before the last dot).
--                5) Group by that package, count occurrences, and return the top 10.
SELECT
    pkg."package_name",
