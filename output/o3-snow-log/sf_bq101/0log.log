-- Description: Show the 20 most frequently imported Java packages in the sample corpus.
--              Steps performed inside this single query:
--                1) Restrict to files whose path ends with “.java”.
--                2) Split each file’s content into individual lines.
--                3) Keep only lines that match the import pattern “import <package>.<class|*>;”.
--                4) REGEXP_SUBSTR with sub-expression flag ('e') captures only the package
--                   portion (group-1).  The outer query then aggregates counts and orders by frequency.
SELECT
    pkg."package_name",
    COUNT(*) AS "import_count"
FROM (
    SELECT
        REGEXP_SUBSTR(
            ln.value,
            'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
            1, 1, 'e', 1           -- captured group #1 = package name
        ) AS "package_name"
    FROM GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS" AS f,
         LATERAL SPLIT_TO_TABLE(f."content", '\n')   AS ln
    WHERE f."sample_path" ILIKE '%.java'
      AND REGEXP_LIKE(
            ln.value,
            '^\\s*import\\s+[A-Za-z0-9_\\.]+\\.[A-Za-z0-9_\\*]+\\s*;'
          )
) pkg
WHERE pkg."package_name" IS NOT NULL
GROUP BY pkg."package_name"
ORDER BY "import_count" DESC
LIMIT 20;
