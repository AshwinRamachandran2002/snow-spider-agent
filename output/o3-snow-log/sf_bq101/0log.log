-- Description: Retrieve 20 unique Java package names (package portion only, no trailing class or “*”)  
--              found in import statements.  
--              Steps:  
--                1) Limit to files whose paths end with “.java”.  
--                2) Split each file’s content into lines.  
--                3) Keep lines matching “import <package>.<class|*>;”.  
--                4) REGEXP_SUBSTR with sub-expression flag ('e') captures just the package name  
--                   (group-1, everything before the last dot).  
SELECT DISTINCT
       REGEXP_SUBSTR(
           ln.value,                                       -- individual source-code line
           'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',  -- pattern with capture
           1, 1, 'e', 1                                     -- return captured group #1
       ) AS "package_name"
FROM GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"  AS f
     , LATERAL SPLIT_TO_TABLE(f."content", '\n')   AS ln
WHERE f."sample_path" ILIKE '%.java'                                 -- only Java files
  AND REGEXP_LIKE(
        ln.value,
        '^\\s*import\\s+[A-Za-z0-9_\\.]+\\.[A-Za-z0-9_\\*]+\\s*;'     -- valid import lines
      )
  AND "package_name" IS NOT NULL
