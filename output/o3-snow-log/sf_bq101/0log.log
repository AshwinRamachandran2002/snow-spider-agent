```sql
-- Description: Show 20 distinct Java package names extracted from import lines
--              (package portion only, no trailing class or “*”).
SELECT DISTINCT
       REGEXP_SUBSTR(
           ln.value,
           'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
           1, 1, 'e', 1
       ) AS "package_name"
FROM GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"  AS file,
     LATERAL SPLIT_TO_TABLE(file."content", '\n') AS ln
WHERE file."sample_path" ILIKE '%.java'
  AND REGEXP_LIKE(
        ln.value,
        '^\\s*import\\s+[A-Za-z0-9_\\.]+\\.[A-Za-z0-9_\\*]+\\s*;'
      )
  AND "package_name" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Aggregate import counts per package and list the 20 most-used packages.
SELECT
    pkg."package_name",
    COUNT(*) AS "import_count"
FROM (
    SELECT
        REGEXP_SUBSTR(
            ln.value,
            'import\\s+([A-Za-z0-9_\\.]+)\\.[A-Za-z0-9_\\*]+\\s*;',
            1, 1, 'e', 1
        ) AS "package_name"
    FROM GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"  AS file,
         LATERAL SPLIT_TO_TABLE(file."content", '\n') AS ln
    WHERE file."sample_path" ILIKE '%.java'
      AND REGEXP_LIKE(
            ln.value,
            '^\\s*import\\s+[A-Za-z0-9_\\.]+\\.[A-Za-z0-9_\\*]+\\s*;'
          )
) pkg
GROUP BY pkg."package_name"
ORDER BY "import_count" DESC
LIMIT 20;
```

