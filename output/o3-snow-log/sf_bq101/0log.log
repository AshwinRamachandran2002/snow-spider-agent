```sql
-- Description: Aggregate counts of each package across all Java import statements
SELECT 
  pkg."package_name",
  COUNT(*) AS "import_count"
FROM (
  SELECT 
    REGEXP_SUBSTR( REGEXP_SUBSTR(s.value,
                                  'import\s+([A-Za-z0-9_\.]+)\.[A-Za-z0-9_\*]+\s*;',
                                  1, 1, 'e', 1),
                   '([A-Za-z0-9_\.]+)$', 1, 1, 'e', 1) AS "package_name"
  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
       LATERAL SPLIT_TO_TABLE(t."content", '\n') s
  WHERE t."sample_path" ILIKE '%.java'
    AND REGEXP_LIKE(s.value, '^\s*import\s+[A-Za-z0-9_\.]+\.[A-Za-z0-9_\*]+\s*;')
) pkg
WHERE pkg."package_name" IS NOT NULL
GROUP BY pkg."package_name"
ORDER BY "import_count" DESC
LIMIT 20;
