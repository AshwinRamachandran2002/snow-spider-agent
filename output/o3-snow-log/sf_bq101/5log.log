--               4. Remove the final “.ClassOrMember” to leave only the package name
--                  (e.g., java.util).
--               5. Group by package name, count occurrences, order by the count
--                  in descending order, and return the top 10 packages.
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$' , '')  AS "package_name",
       COUNT(*)                                       AS "import_count"
FROM (
        /* Step-3: clean each import line to obtain the full import path */
        SELECT REGEXP_REPLACE(
