--Description:
-- Goal:  List the 10 Java packages that are imported most often in the GitHub
--        sample data set.
-- Reasoning:
--   1.  SAMPLE_FILES holds file paths and blob IDs.  We only need rows whose
--       "path" ends in “.java”.  Those rows are joined to SAMPLE_CONTENTS
--       (file text) via the common "id".
--   2.  Each file’s text is split into individual lines with SPLIT(), then
--       LATERAL FLATTEN turns the resulting array into a row set.  We keep
--       only lines that begin with “import ” (ILIKE 'import %').
--   3.  Every remaining line is cleaned:
--         · remove leading “import static ” (if present) or plain “import ”;
--         · remove the trailing semicolon “;”.
--       The cleaned string is a full import path, e.g.  java.util.List.
--   4.  Using REGEXP_REPLACE, drop the last “.ClassOrMember” component,
--       leaving only the package portion (e.g.  java.util).
--   5.  Group by package name, count occurrences, order by that count in
--       descending order, and return the top 10 packages.
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$', '')   AS "package_name",
       COUNT(*)                                       AS "import_count"
FROM (
        /* Steps 2–3: extract each import line and clean it */
        SELECT REGEXP_REPLACE(                                   -- remove trailing ';'
                 REGEXP_REPLACE(                                 -- remove leading 'import '
                   REGEXP_REPLACE(line.value::STRING,            -- remove leading 'import static '
                                   '^import\\s+static\\s+', ''),
                   '^import\\s+', ''),
                 '\\s*;\\s*$', '')                               AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"      f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"   c
               ON f."id" = c."id",
               LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) line
        WHERE  f."path" ILIKE '%.java'
          AND  line.value::STRING ILIKE 'import %'
     )
GROUP BY 1
ORDER BY "import_count" DESC
LIMIT 10;
