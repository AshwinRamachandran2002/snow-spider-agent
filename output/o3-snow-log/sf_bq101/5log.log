--Description: Produce the 20 most-frequently imported Java packages.
-- Logic:
--   • Join SAMPLE_FILES with SAMPLE_CONTENTS to read the text of every “*.java” file.
--   • Split each file into lines and keep those that begin with “import ” (case-insensitive).
--   • For each import line, strip the leading keyword (“import” or “import static”)
--     and the trailing semicolon ⇒ the full import path (e.g. java.util.List).
--   • Remove the last “.ClassOrMember” segment, leaving just the package name (e.g. java.util).
--   • Group by package name, count how many times it occurs, order by that count,
--     and return the top 20 packages.
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$' , '')           AS "package_name",
       COUNT(*)                                                AS "import_count"
FROM (
        SELECT REGEXP_REPLACE(                                 -- clean each import line
                 REGEXP_REPLACE(
                   REGEXP_REPLACE(line.value::STRING,
                                   '^import\\s+static\\s+' , '' , 1 , 0),   -- drop “import static ”
                   '^import\\s+'            , '' , 1 , 0),                  -- drop “import ”
                 '\\s*;\\s*$'               , '' , 1 , 0)                   -- drop trailing semicolon
               AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"        AS f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"     AS c
               ON f."id" = c."id",
               LATERAL FLATTEN( INPUT => SPLIT(c."content", '\n') ) AS line
        WHERE  f."path" ILIKE '%.java'                         -- only Java source files
          AND  line.value::STRING ILIKE 'import %'             -- lines that start with “import ”
     )
GROUP BY 1
ORDER BY "import_count" DESC
LIMIT 20;
