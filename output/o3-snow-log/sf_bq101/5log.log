```sql
--Description: Provide an unordered sample (20 rows) showing how many times each
--             Java package is imported across the repository.
--             Workflow:
--               1.  Join SAMPLE_FILES and SAMPLE_CONTENTS to fetch text of every “*.java” file.
--               2.  Split each file’s text into lines; keep lines that start with “import ”.
--               3.  Clean each import line:
--                     • remove leading “import ” or “import static ”,
--                     • remove trailing semicolon,
--                   → yields the full import path (e.g., java.util.List).
--               4.  Remove the last “.ClassOrMember” segment to obtain only the package
--                   name (e.g., java.util).
--               5.  Group by package, count occurrences, and return 20 rows without ORDER BY.
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$' , '')     AS "package_name",
       COUNT(*)                                          AS "import_count"
FROM (
        SELECT REGEXP_REPLACE(                           -- step-3: clean import line
                 REGEXP_REPLACE(
                   REGEXP_REPLACE(line.value::STRING,
                                   '^import\\s+static\\s+' , '' , 1 , 0),   -- remove “import static ”
                   '^import\\s+'            , '' , 1 , 0),                  -- remove “import ”
                 '\\s*;\\s*$'               , '' , 1 , 0)                   -- remove trailing semicolon
               AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"        AS f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"     AS c
               ON f."id" = c."id",
               LATERAL FLATTEN( INPUT => SPLIT(c."content", '\n') ) AS line
        WHERE  f."path" ILIKE '%.java'              -- only Java source files
          AND  line.value::STRING ILIKE 'import %'  -- lines beginning with “import ”
     )
GROUP BY 1
LIMIT 20;
```
