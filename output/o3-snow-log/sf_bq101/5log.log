--                • Keep only lines that start with “import ” (case-insensitive).
--                • Clean each import line:
--                     1) remove a leading “import static ” or plain “import ”;
--                     2) remove the trailing semicolon “;”.
--                  → full import path (e.g., java.util.List).
--                • Drop the final “.ClassOrMember” via REGEXP_REPLACE so only the
--                  package remains (e.g., java.util).
--                • Group by package, count occurrences, and LIMIT 20 rows
--                  without ORDER BY (arbitrary sample).
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$', '') AS "package_name",
       COUNT(*)                                     AS "import_count"
FROM (
        SELECT REGEXP_REPLACE(                             -- remove trailing ';'
                 REGEXP_REPLACE(                           -- remove leading 'import '
                   REGEXP_REPLACE(line.value::STRING,      -- remove leading 'import static '
                                   '^import\\s+static\\s+', ''),
                   '^import\\s+', ''),
