--Description: Unordered sample of 20 Java package-level import counts (complete & correct)  
--             • Reads every “*.java” file by joining SAMPLE_FILES → SAMPLE_CONTENTS.  
--             • Splits file text into lines, keeps those starting with “import ”.  
--             • Removes the “import” / “import static” prefix and trailing “;”.  
--             • Drops the final “.ClassOrMember” so only the package remains.  
--             • Groups by package, counts occurrences, returns 20 rows without ORDER BY.
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$', '')  AS "package_name",
       COUNT(*)                                      AS "import_count"
FROM (
        /* Extract and clean each import line → full import path */
        SELECT REGEXP_REPLACE(                           -- strip trailing semicolon
                 REGEXP_REPLACE(                         -- strip leading “import ”
                   REGEXP_REPLACE(                       -- strip leading “import static ”
                     line.value::STRING,
                     '^import\\s+static\\s+', ''
                   ),
                   '^import\\s+', ''
                 ),
                 '\\s*;\\s*$', ''
               ) AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"     AS f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"  AS c
               ON f."id" = c."id",
               LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) AS line
        WHERE  f."path" ILIKE '%.java'
          AND  line.value::STRING ILIKE 'import %'
     )
GROUP BY 1
LIMIT 20;
```
