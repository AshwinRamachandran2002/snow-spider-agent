--Description:  Return an unordered sample of 20 Java packages and the number of
--              times each package is referenced in “import” statements.
--              Steps carried out in the query:
--                1.  Join SAMPLE_FILES with SAMPLE_CONTENTS so we can read the
--                    text of every file whose path ends in “.java”.
--                2.  Split each file’s text into individual lines (SPLIT) and
--                    turn the array into rows with LATERAL FLATTEN.
--                3.  Keep only lines that begin with “import ” (case-insensitive).
--                4.  Clean every retained line:
--                     • remove a leading “import static ” (if present) or
--                       plain “import ”;
--                     • remove the trailing semicolon “;”.
--                    The cleaned string is a full import path
--                    (for example  java.util.List).
--                5.  Remove the final “.ClassOrMember” component with
--                    REGEXP_REPLACE, leaving only the package portion
--                    (for example  java.util).
--                6.  Group by package name, count occurrences, and LIMIT 20
--                    rows without ORDER BY so the output is an arbitrary sample.
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$', '') AS "package_name",
       COUNT(*)                                     AS "import_count"
FROM (
        /* Steps 3 & 4: isolate each import line and clean it */
        SELECT REGEXP_REPLACE(                             -- remove trailing ';'
                 REGEXP_REPLACE(                           -- remove leading 'import '
                   REGEXP_REPLACE(line.value::STRING,      -- remove leading 'import static '
                                   '^import\\s+static\\s+', ''),
                   '^import\\s+', ''),
                 '\\s*;\\s*$', '')                         AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"      AS f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"   AS c
               ON f."id" = c."id",
               LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n'))            AS line
        WHERE  f."path" ILIKE '%.java'
          AND  line.value::STRING ILIKE 'import %'
     )
GROUP BY 1
LIMIT 20;
