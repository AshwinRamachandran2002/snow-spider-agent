--                   beginning with “import ” (case–insensitive).
--               3.  For every retained line:
--                     • remove the leading “import ” or “import static ”,
--                     • remove the trailing semicolon “;”,
--                   to obtain the full import path (e.g. java.util.List).
--               4.  Remove the final “.ClassOrMember” segment, leaving only the
--                   package name (e.g. java.util).
--               5.  Group by package name, count occurrences, and present 20 rows
--                   without ordering (so it is just a sample, not ranked).
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$' , '') AS "package_name",
       COUNT(*)                                      AS "import_count"
FROM (
        /* Step-3: clean each import line */
        SELECT REGEXP_REPLACE(
                 REGEXP_REPLACE(
                   REGEXP_REPLACE(line.value::STRING,
                                   '^import\\s+static\\s+' , '' , 1 , 0),   -- strip “import static ”
                   '^import\\s+'            , '' , 1 , 0),                  -- strip “import ”
