```sql
--Description:  Retrieve the 10 Java packages that appear most often in “import”
--              statements across the GitHub sample data.
--              --------------------------------------------------------------
-- 1.  Restrict SAMPLE_FILES to paths ending in “.java”; join to SAMPLE_CONTENTS
--     to read the source text.
-- 2.  Split each file’s text into lines (SPLIT) and turn the array into rows
--     with LATERAL FLATTEN.
-- 3.  Filter to lines that begin with “import ” (case-insensitive).
-- 4.  Clean each import line:
--       • remove the optional “import static ” or plain “import ” prefix;
--       • remove the trailing semicolon “;”.
--     This yields the full import path (e.g., java.util.List).
-- 5.  Drop the trailing “.ClassOrMember” segment with REGEXP_REPLACE so only
--     the package part remains (e.g., java.util).
-- 6.  Group by package, count occurrences, order by the count descending,
--     and return the top 10 packages.
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$', '')   AS "package_name",
       COUNT(*)                                       AS "import_count"
FROM (
        /* Steps 3-4: isolate and clean each import line */
        SELECT REGEXP_REPLACE(                                   -- remove trailing “;”
                 REGEXP_REPLACE(                                 -- remove leading “import ”
                   REGEXP_REPLACE(line.value::STRING,            -- remove leading “import static ”
                                   '^import\\s+static\\s+', ''),
                   '^import\\s+', ''),
                 '\\s*;\\s*$', '')                              AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"      f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"   c
               ON f."id" = c."id",
               LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) line
        WHERE  f."path" ILIKE '%.java'
          AND  line.value::STRING ILIKE 'import %'
     )
GROUP BY 1
ORDER BY "import_count" DESC
LIMIT 10;
```
