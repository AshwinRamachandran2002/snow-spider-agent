--Description: Determine the 10 most-frequently imported Java packages.
-- Thinking process:
--   1.  SAMPLE_FILES gives file paths and blob IDs; restrict to paths ending in “.java”.
--   2.  Join to SAMPLE_CONTENTS on the blob ID to read each file’s text.
--   3.  Split the text into lines with SPLIT + LATERAL FLATTEN.
--   4.  Keep lines that start with “import ” (ILIKE 'import %').
--   5.  Clean each import line:
--        • remove the prefix “import static ” (if present) or “import ”,
--        • remove the trailing semicolon “;”,
--      yielding the full import path (e.g., java.util.List).
--   6.  Remove the final “.ClassOrMember” segment, leaving only the package name (e.g., java.util).
--   7.  Group by package name, count occurrences, sort by count descending, limit to 10 rows.
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$', '')  AS "package_name",
       COUNT(*)                                      AS "import_count"
FROM (
        /* Steps 3-5: isolate and clean each import line */
        SELECT REGEXP_REPLACE(
                 REGEXP_REPLACE(
                   REGEXP_REPLACE(line.value::STRING,
                                   '^import\\s+static\\s+', ''),   -- drop “import static ”
                   '^import\\s+', ''),                             -- drop plain “import ”
                 '\\s*;\\s*$', '')                                -- drop trailing “;”
               AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"     AS f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"  AS c
               ON f."id" = c."id",
               LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) AS line
        WHERE  f."path" ILIKE '%.java'
          AND  line.value::STRING ILIKE 'import %'
     )
GROUP BY 1
ORDER BY "import_count" DESC
LIMIT 10;
