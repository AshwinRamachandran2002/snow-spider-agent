--               2. Split each file’s text into lines (SPLIT) and expand with LATERAL FLATTEN.  
--               3. Retain lines that begin with “import ” (case-insensitive).  
--               4. Clean each line: remove “import static ” or plain “import ” prefix and the
--                  trailing semicolon “;” → full import path (e.g. java.util.List).  
--               5. REGEXP_REPLACE drops the final “.ClassOrMember” segment, leaving only
--                  the package name (e.g. java.util).  
--               6. Group by package, count occurrences, and LIMIT 20 rows (no ORDER BY).  
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$', '') AS "package_name",
       COUNT(*)                                     AS "import_count"
FROM (
        SELECT REGEXP_REPLACE(                          -- remove trailing ';'
                 REGEXP_REPLACE(                        -- remove leading 'import '
                   REGEXP_REPLACE(                      -- remove leading 'import static '
                     line.value::STRING,
                     '^import\\s+static\\s+', ''
                   ),
                   '^import\\s+', ''
                 ),
                 '\\s*;\\s*$', ''
               ) AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"     AS f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"  AS c
               ON f."id" = c."id",
               LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) AS line
        WHERE  f."path" ILIKE '%.java'
          AND  line.value::STRING ILIKE 'import %'
     )
GROUP BY 1
LIMIT 20;
