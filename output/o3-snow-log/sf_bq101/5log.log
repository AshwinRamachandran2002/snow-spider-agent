--Description: Generate an unordered sample of 20 Java packages and the count of
--             “import” statements that reference each package.
--             Explanation of steps:
--               1.  SAMPLE_FILES is filtered to files whose path ends in '.java'.
--               2.  Join to SAMPLE_CONTENTS on SHA-1 "id" to read source text.
--               3.  Split each file’s text into lines with SPLIT() and expand
--                   them into rows using LATERAL FLATTEN.
--               4.  Keep lines beginning with “import ” (case-insensitive).
--               5.  Clean every retained line by:
--                    • removing a leading “import static ” (if present) or plain “import ”;
--                    • removing the trailing semicolon “;”.
--                  The cleaned string is the full import path such as java.util.List.
--               6.  REGEXP_REPLACE removes the final “.ClassOrMember” leaving only
--                   the package part (e.g., java.util).
--               7.  Group by package name, count occurrences, and LIMIT to 20 rows
--                   without ORDER BY (arbitrary sample).
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$', '') AS "package_name",
       COUNT(*)                                     AS "import_count"
FROM (
        SELECT REGEXP_REPLACE(                       -- step 5b: strip trailing ';'
                 REGEXP_REPLACE(                     -- step 5a-2: strip leading 'import '
                   REGEXP_REPLACE(                   -- step 5a-1: strip leading 'import static '
                     line.value::STRING,
                     '^import\\s+static\\s+', ''
                   ),
                   '^import\\s+', ''
                 ),
                 '\\s*;\\s*$', ''
               ) AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"     AS f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"  AS c
               ON f."id" = c."id",
               LATERAL FLATTEN( INPUT => SPLIT(c."content", '\n') ) AS line
        WHERE  f."path" ILIKE '%.java'
          AND  line.value::STRING ILIKE 'import %'
     )
GROUP BY 1
LIMIT 20;
```
