--Description: Identify the 10 Java packages most frequently referenced in “import” statements.
-- Reasoning:
-- 1. Restrict SAMPLE_FILES to files whose path ends with '.java' and join to SAMPLE_CONTENTS
--    (using the shared SHA-1 “id”) to read source text.
-- 2. Split each Java file’s text into individual lines with SPLIT, then expand the array
--    into rows via LATERAL FLATTEN.
-- 3. Retain only lines that begin with “import ” (case-insensitive).
-- 4. Clean every retained line:
--      • remove a leading “import static ” if present, otherwise remove “import ”;
--      • remove the trailing semicolon “;”.
--    The result is the full import path, e.g.  java.util.List.
-- 5. Use REGEXP_REPLACE to drop the trailing “.ClassOrMember” segment, leaving only
--    the package (e.g.  java.util).
-- 6. Group by package name, count occurrences, order by that count descending,
--    and return the top 10 packages.
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$', '')  AS "package_name",
       COUNT(*)                                      AS "import_count"
FROM (
        /* Steps 3-4: isolate each import line and clean it */
        SELECT REGEXP_REPLACE(                                -- strip trailing semicolon
                 REGEXP_REPLACE(                              -- strip leading 'import '
                   REGEXP_REPLACE(line.value::STRING,         -- strip leading 'import static '
                                   '^import\\s+static\\s+', ''),
                   '^import\\s+', ''),
                 '\\s*;\\s*$', '')                           AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"      AS f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"   AS c
               ON f."id" = c."id",
               LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) AS line
        WHERE  f."path" ILIKE '%.java'
          AND  line.value::STRING ILIKE 'import %'
     )
GROUP BY 1
ORDER BY "import_count" DESC
LIMIT 10;
