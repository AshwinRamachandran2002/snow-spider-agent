--Description:  Retrieve the 10 Java packages that are referenced most frequently
--              in “import” statements across every *.java file in the GitHub
--              sample data.
--              ---------------------------------------------------------------
--              1.  Filter SAMPLE_FILES to paths ending with '.java' and join to
--                  SAMPLE_CONTENTS (using the shared SHA-1 “id”) to read file text.
--              2.  Split each file’s text into individual lines via SPLIT() and
--                  expand the array into rows with LATERAL FLATTEN.
--              3.  Keep only lines that begin with “import ” (case-insensitive).
--              4.  Clean every retained line:
--                    • remove the optional “import static ” or plain “import ” prefix;
--                    • remove the trailing semicolon “;”.
--                  The cleaned value is a full import path (e.g., java.util.List).
--              5.  Use REGEXP_REPLACE to drop the final “.ClassOrMember” segment,
--                  leaving only the package portion (e.g., java.util).
--              6.  Group by package name, count occurrences, order by that count
--                  in descending order, and LIMIT the result to the top 10 packages.
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$', '')  AS "package_name",
       COUNT(*)                                      AS "import_count"
FROM (
        /* Steps 3–4: isolate and clean each import line → full_import */
        SELECT REGEXP_REPLACE(                                -- strip trailing semicolon
                 REGEXP_REPLACE(                              -- strip plain 'import '
                   REGEXP_REPLACE(                            -- strip 'import static '
                     line.value::STRING,
                     '^import\\s+static\\s+', ''
                   ),
                   '^import\\s+', ''
                 ),
                 '\\s*;\\s*$', ''
               ) AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"     AS f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"  AS c
               ON f."id" = c."id",
             LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) AS line
        WHERE  f."path" ILIKE '%.java'               -- consider only Java files
          AND  line.value::STRING ILIKE 'import %'    -- retain import lines
     )
GROUP BY 1
ORDER BY "import_count" DESC
LIMIT 10;
