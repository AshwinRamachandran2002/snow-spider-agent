--Description: Return an unsorted sample of 20 Java package-level import counts.
-- Thought process:
--   • Read every Java file by joining SAMPLE_FILES (paths + ids) with SAMPLE_CONTENTS (text).
--   • Split file text into lines (LATERAL FLATTEN + SPLIT) and keep lines beginning with “import ”.
--   • Clean each import line:
--        – remove leading “import ” or “import static ”,
--        – remove trailing semicolon,
--        → gives the full import path, e.g., java.util.List.
--   • Strip the final “.ClassOrMember” segment, leaving only the package, e.g., java.util.
--   • Group by package name, count occurrences, and return 20 rows without ORDER BY
--     (so it’s just a sample, not ranked).
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$' , '') AS "package_name",
       COUNT(*)                                      AS "import_count"
FROM (
        SELECT REGEXP_REPLACE(                        -- clean the import line
                 REGEXP_REPLACE(
                   REGEXP_REPLACE(line.value::STRING,
                                   '^import\\s+static\\s+' , '' , 1 , 0),   -- drop “import static ”
                   '^import\\s+'            , '' , 1 , 0),                  -- drop “import ”
                 '\\s*;\\s*$'               , '' , 1 , 0)                   -- drop trailing semicolon
               AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"      AS f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"   AS c
               ON f."id" = c."id",
               LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) AS line
        WHERE  f."path" ILIKE '%.java'                        -- only Java sources
          AND  line.value::STRING ILIKE 'import %'            -- lines with “import ”
     )
GROUP BY 1
LIMIT 20;
