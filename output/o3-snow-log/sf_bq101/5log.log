```sql
--Description / Thinking process:
-- We need the 10 most-frequently imported Java *packages*.
-- 1.  Join SAMPLE_FILES → SAMPLE_CONTENTS to get Java file text.
-- 2.  Split each file’s content into lines (FLATTEN + SPLIT).
-- 3.  Keep lines that begin with “import ” (case-insensitive match).
-- 4.  Clean those lines:
--       • remove “import ” or “import static ”
--       • strip trailing semicolon
-- 5.  From the cleaned import path, drop the last “.ClassOrMember”
--    to leave just the package portion.
-- 6.  Group by package, count occurrences, order by count desc,
--    keep top 10.

SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$' , '')  AS "package_name",
       COUNT(*)                                       AS "import_count"
FROM (
        SELECT
               -- clean the raw import line
               REGEXP_REPLACE(
                 REGEXP_REPLACE(
                   REGEXP_REPLACE(line.value::STRING,
                                   '^import\\s+static\\s+' , '' , 1 , 0 ),  -- drop leading “import static ”
                   '^import\\s+' , '' , 1 , 0 ),                             -- drop leading “import ”
                 '\\s*;\\s*$' , '' , 1 , 0 )                                -- drop trailing semicolon
               AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"      AS f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"   AS c
               ON f."id" = c."id",
               LATERAL FLATTEN( INPUT => SPLIT(c."content", '\n') ) AS line
        WHERE  f."path" ILIKE '%.java'                       -- only Java sources
          AND  line.value::STRING ILIKE 'import %'           -- lines starting with “import ”
      )
GROUP BY 1
ORDER BY "import_count" DESC
LIMIT 10;
```
