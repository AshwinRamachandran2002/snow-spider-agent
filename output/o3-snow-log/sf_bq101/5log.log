FROM (
        /* Extract and clean each import line → full import path */
        SELECT REGEXP_REPLACE(                       -- step ❸ remove trailing “;”
                 REGEXP_REPLACE(                     -- step ❷ remove leading 'import '
                   REGEXP_REPLACE(                   -- step ❶ remove leading 'import static '
                     line.value::STRING,
