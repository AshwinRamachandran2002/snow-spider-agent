--                • Join those rows to SAMPLE_CONTENTS (on the shared SHA-1 “id”) to read the file text.
--                • Split each file’s text into individual lines (SPLIT) and turn the array
--                  into rows with LATERAL FLATTEN.
--                • Keep only the lines that begin with the keyword “import ” (case-insensitive).
--                • Clean every retained line by:
--                     1) stripping a leading “import static ” or plain “import ”,
--                     2) stripping the trailing semicolon “;”.
--                  The cleaned value is a full import path such as  java.util.List.
--                • Use REGEXP_REPLACE to drop the final “.ClassOrMember” segment so only the
--                  package portion remains (e.g.  java.util).
--                • Group by the package name, count occurrences, and LIMIT 20 rows
--                  without ORDER BY (so the result is an arbitrary sample).
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$', '')   AS "package_name",
       COUNT(*)                                       AS "import_count"
FROM (
        /* extract each import line and clean it */
        SELECT REGEXP_REPLACE(                                    -- remove trailing “;”
                 REGEXP_REPLACE(                                  -- remove leading “import ”
                   REGEXP_REPLACE(line.value::STRING,             -- remove leading “import static ”
                                   '^import\\s+static\\s+', ''),
                   '^import\\s+', ''),
                 '\\s*;\\s*$', '')                               AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"     f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"  c
               ON f."id" = c."id",
               LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) line
        WHERE  f."path" ILIKE '%.java'
          AND  line.value::STRING ILIKE 'import %'
     )
GROUP BY 1
LIMIT 20;
