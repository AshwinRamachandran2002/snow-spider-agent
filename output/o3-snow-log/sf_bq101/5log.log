```sql
--Description: Display an unordered sample of 20 Java packages and the number of
--             times each package is referenced in “import” statements.
--             Steps performed in query:
--               1. Filter SAMPLE_FILES for rows whose "path" ends with '.java' and
--                  join to SAMPLE_CONTENTS (via SHA-1 "id") to read each file’s text.
--               2. Split the text into lines with SPLIT() and expand the array using
--                  LATERAL FLATTEN.
--               3. Keep only lines that begin with the keyword “import ” (ILIKE).
--               4. Clean each retained line by:
--                    • removing a leading “import static ” or plain “import ”;
--                    • removing the trailing semicolon “;”.
--                  The cleaned result is a full import path, e.g. java.util.List.
--               5. REGEXP_REPLACE removes the final “.ClassOrMember” segment,
--                  leaving only the package part, e.g. java.util.
--               6. Group by package name, count occurrences, and LIMIT 20 rows
--                  without ORDER BY to yield an arbitrary sample.
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$', '') AS "package_name",
       COUNT(*)                                     AS "import_count"
FROM (
        SELECT REGEXP_REPLACE(
                 REGEXP_REPLACE(
                   REGEXP_REPLACE(line.value::STRING,
                                   '^import\\s+static\\s+', ''),  -- strip 'import static '
                   '^import\\s+', ''),                            -- strip plain 'import '
                 '\\s*;\\s*$', '' )                              -- strip trailing semicolon
               AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"    f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS" c
               ON f."id" = c."id",
               LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) line
        WHERE  f."path" ILIKE '%.java'
          AND  line.value::STRING ILIKE 'import %'
     )
GROUP BY 1
LIMIT 20;
```
