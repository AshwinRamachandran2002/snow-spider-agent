--Description: Count Java package-level imports and list the 20 most-frequent packages.
-- Logic:
--   • Join SAMPLE_FILES with SAMPLE_CONTENTS to access file text.
--   • Split each Java file into lines and keep those beginning with “import”.
--   • Strip the keyword (“import” or “import static”) and trailing semicolon.
--   • Remove the final “.ClassOrMember” so only the package remains.
--   • Aggregate by package name, order by frequency, return top 20.
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$' , '') AS "package_name",
       COUNT(*)                                      AS "import_count"
FROM (
        SELECT REGEXP_REPLACE(
                 REGEXP_REPLACE(
                   REGEXP_REPLACE(line.value::STRING,
                                   '^import\\s+static\\s+' , '' , 1 , 0),  -- remove “import static ”
                   '^import\\s+'           , '' , 1 , 0),                  -- remove “import ”
                 '\\s*;\\s*$'              , '' , 1 , 0)                   -- remove trailing semicolon
               AS full_import
        FROM   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_FILES"      AS f
        JOIN   GITHUB_REPOS.GITHUB_REPOS."SAMPLE_CONTENTS"   AS c
               ON f."id" = c."id",
               LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) AS line
        WHERE  f."path" ILIKE '%.java'
          AND  line.value::STRING ILIKE 'import %'
     )
GROUP BY 1
ORDER BY "import_count" DESC
LIMIT 20;
