--       • removing the leading “import ” or “import static ”,
--       • removing the trailing semicolon,
--     which yields the full import path (e.g., java.util.List).
--  4. Remove the final “.ClassOrMember” segment, leaving only the package (e.g., java.util).
--  5. Group by package name, count occurrences, and return 20 rows without ORDER BY
--     (so the rows form an arbitrary sample, not ranked).
SELECT
       REGEXP_REPLACE(full_import, '\\.[^.]+$' , '') AS "package_name",
       COUNT(*)                                      AS "import_count"
FROM (
        /* Step-3: clean each import line to get the full import path */
        SELECT REGEXP_REPLACE(
                 REGEXP_REPLACE(
                   REGEXP_REPLACE(line.value::STRING,
                                   '^import\\s+static\\s+' , '' , 1 , 0),   -- drop “import static ”
                   '^import\\s+'            , '' , 1 , 0),                  -- drop “import ”
