                     ROW_NUMBER() OVER (PARTITION BY owb."match_id" ORDER BY owb."total_runs" DESC) AS "rn"
              FROM   over_with_bowler owb
       )
       WHERE  "rn" = 1
)
SELECT AVG("total_runs") AS "avg_highest_over_runs"
FROM   best_over
LIMIT 20;
