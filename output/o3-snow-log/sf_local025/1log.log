--Description: 7) Attach the bowler who delivered each over (one bowler per over)
WITH over_totals AS (
     SELECT 
            COALESCE(bat."match_id",ext."match_id")           AS "match_id",
            COALESCE(bat."innings_no",ext."innings_no")       AS "innings_no",
            COALESCE(bat."over_id",ext."over_id")             AS "over_id",
            NVL(bat."bat_runs",0)  + NVL(ext."extra_runs",0)  AS "total_runs"
     FROM (
            SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"
            FROM IPL.IPL.BATSMAN_SCORED GROUP BY "match_id","innings_no","over_id"
          ) bat
     FULL JOIN (
            SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "extra_runs"
            FROM IPL.IPL.EXTRA_RUNS GROUP BY "match_id","innings_no","over_id"
          ) ext
          ON  bat."match_id"   = ext."match_id"
          AND bat."innings_no" = ext."innings_no"
          AND bat."over_id"    = ext."over_id"
)
SELECT 
       o."match_id",
       o."innings_no",
       o."over_id",
       o."total_runs",
       MIN(b."bowler") AS "bowler"      -- only one bowler should exist per over
FROM   over_totals o
JOIN   IPL.IPL.BALL_BY_BALL b
       ON  o."match_id"   = b."match_id"
       AND o."innings_no" = b."innings_no"
       AND o."over_id"    = b."over_id"
GROUP  BY o."match_id",o."innings_no",o."over_id",o."total_runs"
LIMIT 20;
