```sql
--Description: 4) Aggregate batsman runs for every (match, innings, over)
SELECT 
       "match_id",
       "innings_no",
       "over_id",
       SUM("runs_scored")  AS "bat_runs"
FROM   IPL.IPL.BATSMAN_SCORED
GROUP  BY "match_id", "innings_no", "over_id"
LIMIT 20;
```

```sql
--Description: 5) Aggregate extra runs for every (match, innings, over)
SELECT 
       "match_id",
       "innings_no",
       "over_id",
       SUM("extra_runs")  AS "extra_runs"
FROM   IPL.IPL.EXTRA_RUNS
GROUP  BY "match_id", "innings_no", "over_id"
LIMIT 20;
```

```sql
--Description: 6) Combine batsman and extra runs to get total runs for each over
WITH bat AS (
     SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"
     FROM IPL.IPL.BATSMAN_SCORED
     GROUP BY "match_id","innings_no","over_id"
), ext AS (
     SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "extra_runs"
     FROM IPL.IPL.EXTRA_RUNS
     GROUP BY "match_id","innings_no","over_id"
)
SELECT 
       COALESCE(bat."match_id",ext."match_id")           AS "match_id",
       COALESCE(bat."innings_no",ext."innings_no")       AS "innings_no",
       COALESCE(bat."over_id",ext."over_id")             AS "over_id",
       NVL(bat."bat_runs",0)  + NVL(ext."extra_runs",0)  AS "total_runs"
FROM   bat
FULL JOIN ext
       ON  bat."match_id"   = ext."match_id"
       AND bat."innings_no" = ext."innings_no"
       AND bat."over_id"    = ext."over_id"
LIMIT 20;
```

```sql
--Description: 7) Attach the bowler who delivered each over (one bowler per over)
WITH over_totals AS (
     SELECT 
            COALESCE(bat."match_id",ext."match_id")           AS "match_id",
            COALESCE(bat."innings_no",ext."innings_no")       AS "innings_no",
            COALESCE(bat."over_id",ext."over_id")             AS "over_id",
            NVL(bat."bat_runs",0)  + NVL(ext."extra_runs",0)  AS "total_runs"
     FROM (
            SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"
            FROM IPL.IPL.BATSMAN_SCORED GROUP BY "match_id","innings_no","over_id"
          ) bat
     FULL JOIN (
            SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "extra_runs"
            FROM IPL.IPL.EXTRA_RUNS GROUP BY "match_id","innings_no","over_id"
          ) ext
          ON  bat."match_id"   = ext."match_id"
          AND bat."innings_no" = ext."innings_no"
          AND bat."over_id"    = ext."over_id"
)
SELECT 
       o."match_id",
       o."innings_no",
       o."over_id",
       o."total_runs",
       MIN(b."bowler") AS "bowler"      -- only one bowler should exist per over
FROM   over_totals o
JOIN   IPL.IPL.BALL_BY_BALL b
       ON  o."match_id"   = b."match_id"
       AND o."innings_no" = b."innings_no"
       AND o."over_id"    = b."over_id"
GROUP  BY o."match_id",o."innings_no",o."over_id",o."total_runs"
LIMIT 20;
```

```sql
--Description: 8) For every match, find the over (across both innings) with the maximum runs
WITH over_with_bowler AS (
     SELECT 
            o."match_id",
            o."innings_no",
            o."over_id",
            o."total_runs",
            MIN(b."bowler") AS "bowler"
     FROM (
            /* same over_totals CTE as in the previous query */
            WITH bat AS (
                 SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"
                 FROM IPL.IPL.BATSMAN_SCORED GROUP BY "match_id","innings_no","over_id"
            ), ext AS (
                 SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "extra_runs"
                 FROM IPL.IPL.EXTRA_RUNS GROUP BY "match_id","innings_no","over_id"
            )
            SELECT COALESCE(bat."match_id",ext."match_id")           AS "match_id",
                   COALESCE(bat."innings_no",ext."innings_no")       AS "innings_no",
                   COALESCE(bat."over_id",ext."over_id")             AS "over_id",
                   NVL(bat."bat_runs",0)  + NVL(ext."extra_runs",0)  AS "total_runs"
            FROM  bat
            FULL JOIN ext
                   ON bat."match_id"   = ext."match_id"
                  AND bat."innings_no" = ext."innings_no"
                  AND bat."over_id"    = ext."over_id"
     ) o
     JOIN IPL.IPL.BALL_BY_BALL b
          ON  o."match_id"   = b."match_id"
          AND o."innings_no" = b."innings_no"
          AND o."over_id"    = b."over_id"
     GROUP BY o."match_id",o."innings_no",o."over_id",o."total_runs"
)
SELECT *
FROM   (
       SELECT 
              owb.*,
              ROW_NUMBER() OVER (PARTITION BY owb."match_id" ORDER BY owb."total_runs" DESC) AS "rn"
       FROM   over_with_bowler owb
) q
WHERE  "rn" = 1
LIMIT 20;
```

```sql
--Description: 9) Show the list of “most expensive” overs per match along with the bowler
WITH over_with_bowler AS (
     /* same content as in Query 8 */
     SELECT 
            o."match_id",
            o."innings_no",
            o."over_id",
            o."total_runs",
            MIN(b."bowler") AS "bowler"
     FROM (
            WITH bat AS (
                 SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"
                 FROM IPL.IPL.BATSMAN_SCORED GROUP BY "match_id","innings_no","over_id"
            ), ext AS (
                 SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "extra_runs"
                 FROM IPL.IPL.EXTRA_RUNS GROUP BY "match_id","innings_no","over_id"
            )
            SELECT COALESCE(bat."match_id",ext."match_id")           AS "match_id",
                   COALESCE(bat."innings_no",ext."innings_no")       AS "innings_no",
                   COALESCE(bat."over_id",ext."over_id")             AS "over_id",
                   NVL(bat."bat_runs",0)  + NVL(ext."extra_runs",0)  AS "total_runs"
            FROM  bat
            FULL JOIN ext
                   ON bat."match_id"   = ext."match_id"
                  AND bat."innings_no" = ext."innings_no"
                  AND bat."over_id"    = ext."over_id"
     ) o
     JOIN IPL.IPL.BALL_BY_BALL b
          ON  o."match_id"   = b."match_id"
          AND o."innings_no" = b."innings_no"
          AND o."over_id"    = b."over_id"
     GROUP BY o."match_id",o."innings_no",o."over_id",o."total_runs"
), best_over AS (
       SELECT *
       FROM   (
              SELECT owb.*,
                     ROW_NUMBER() OVER (PARTITION BY owb."match_id" ORDER BY owb."total_runs" DESC) AS "rn"
              FROM   over_with_bowler owb
       )
       WHERE  "rn" = 1
)
SELECT *
FROM   best_over
LIMIT 20;
```

```sql
--Description: 10) Compute the average of the highest-scoring overs across all matches
WITH over_with_bowler AS (
     /* same content as in Query 8 */
     SELECT 
            o."match_id",
            o."innings_no",
            o."over_id",
            o."total_runs",
            MIN(b."bowler") AS "bowler"
     FROM (
            WITH bat AS (
                 SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"
                 FROM IPL.IPL.BATSMAN_SCORED GROUP BY "match_id","innings_no","over_id"
            ), ext AS (
                 SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "extra_runs"
                 FROM IPL.IPL.EXTRA_RUNS GROUP BY "match_id","innings_no","over_id"
            )
            SELECT COALESCE(bat."match_id",ext."match_id")           AS "match_id",
                   COALESCE(bat."innings_no",ext."innings_no")       AS "innings_no",
                   COALESCE(bat."over_id",ext."over_id")             AS "over_id",
                   NVL(bat."bat_runs",0)  + NVL(ext."extra_runs",0)  AS "total_runs"
            FROM  bat
            FULL JOIN ext
                   ON bat."match_id"   = ext."match_id"
                  AND bat."innings_no" = ext."innings_no"
                  AND bat."over_id"    = ext."over_id"
     ) o
     JOIN IPL.IPL.BALL_BY_BALL b
          ON  o."match_id"   = b."match_id"
          AND o."innings_no" = b."innings_no"
          AND o."over_id"    = b."over_id"
     GROUP BY o."match_id",o."innings_no",o."over_id",o."total_runs"
), best_over AS (
       SELECT *
       FROM   (
              SELECT owb.*,
                     ROW_NUMBER() OVER (PARTITION BY owb."match_id" ORDER BY owb."total_runs" DESC) AS "rn"
              FROM   over_with_bowler owb
       )
       WHERE  "rn" = 1
)
SELECT AVG("total_runs") AS "avg_highest_over_runs"
FROM   best_over
LIMIT 20;
```
