```sql
--Description: 1)  Preview how individual runs scored by batsmen are stored.
SELECT *
FROM "IPL"."IPL"."BATSMAN_SCORED"
LIMIT 20;
```

```sql
--Description: 2)  Preview how extra runs (wides, no-balls, byes, etc.) are stored.
SELECT *
FROM "IPL"."IPL"."EXTRA_RUNS"
LIMIT 20;
```

```sql
--Description: 3)  Look at the basic ball-by-ball feed (needed later for the bowler of each delivery / over).
SELECT *
FROM "IPL"."IPL"."BALL_BY_BALL"
LIMIT 20;
```

```sql
--Description: 4)  What does one entire over look like when we join BATSMAN_SCORED + EXTRA_RUNS?
--                (Match-id 335987 chosen just as an example)
SELECT b."match_id",
       b."innings_no",
       b."over_id",
       SUM(b."runs_scored")                AS "batsman_runs",
       COALESCE(SUM(e."extra_runs"), 0)    AS "extra_runs",
       SUM(b."runs_scored") + COALESCE(SUM(e."extra_runs"),0) AS "total_over_runs"
FROM   "IPL"."IPL"."BATSMAN_SCORED" b
LEFT JOIN "IPL"."IPL"."EXTRA_RUNS"  e
       ON  b."match_id"   = e."match_id"
       AND b."innings_no" = e."innings_no"
       AND b."over_id"    = e."over_id"
       AND b."ball_id"    = e."ball_id"
WHERE  b."match_id" = 335987
GROUP  BY b."match_id", b."innings_no", b."over_id"
ORDER  BY "total_over_runs" DESC
LIMIT 20;
```

```sql
--Description: 5)  Pull the bowler who delivered each ball in an over, then roll
--                that up to one bowler per over (the MIN bowler_id – every legal
--                ball in a single over should belong to the same bowler).
SELECT bb."match_id",
       bb."innings_no",
       bb."over_id",
       MIN(bb."bowler") AS "bowler_id"
FROM   "IPL"."IPL"."BALL_BY_BALL" bb
GROUP  BY bb."match_id", bb."innings_no", bb."over_id"
LIMIT 20;
```

```sql
--Description: 6)  Combine queries (4) & (5) to get total runs + bowler for
--                every over of every innings in every match.
SELECT r."match_id",
       r."innings_no",
       r."over_id",
       r."total_over_runs",
       o."bowler_id"
FROM   (
        SELECT b."match_id",
               b."innings_no",
               b."over_id",
               SUM(b."runs_scored") + COALESCE(SUM(e."extra_runs"),0) AS "total_over_runs"
        FROM   "IPL"."IPL"."BATSMAN_SCORED" b
        LEFT  JOIN "IPL"."IPL"."EXTRA_RUNS" e
               ON  b."match_id"   = e."match_id"
               AND b."innings_no" = e."innings_no"
               AND b."over_id"    = e."over_id"
               AND b."ball_id"    = e."ball_id"
        GROUP  BY b."match_id", b."innings_no", b."over_id"
       ) r
JOIN   (
        SELECT bb."match_id",
               bb."innings_no",
               bb."over_id",
               MIN(bb."bowler") AS "bowler_id"
        FROM   "IPL"."IPL"."BALL_BY_BALL" bb
        GROUP  BY bb."match_id", bb."innings_no", bb."over_id"
       ) o
ON     r."match_id"   = o."match_id"
AND    r."innings_no" = o."innings_no"
AND    r."over_id"    = o."over_id"
LIMIT 20;
```

```sql
--Description: 7)  For every (match, innings) keep ONLY the single over that
--                scored the maximum runs.
SELECT *
FROM   (
        SELECT s.*,
               ROW_NUMBER() OVER (PARTITION BY s."match_id", s."innings_no"
                                  ORDER BY s."total_over_runs" DESC) AS rn
        FROM   (
                -- subquery is identical to query (6) but without LIMIT
                SELECT r."match_id",
                       r."innings_no",
                       r."over_id",
                       r."total_over_runs",
                       o."bowler_id"
                FROM   (
                        SELECT b."match_id",
                               b."innings_no",
                               b."over_id",
                               SUM(b."runs_scored") + COALESCE(SUM(e."extra_runs"),0) AS "total_over_runs"
                        FROM   "IPL"."IPL"."BATSMAN_SCORED" b
                        LEFT  JOIN "IPL"."IPL"."EXTRA_RUNS" e
                               ON  b."match_id"   = e."match_id"
                               AND b."innings_no" = e."innings_no"
                               AND b."over_id"    = e."over_id"
                               AND b."ball_id"    = e."ball_id"
                        GROUP  BY b."match_id", b."innings_no", b."over_id"
                       ) r
                JOIN   (
                        SELECT bb."match_id",
                               bb."innings_no",
                               bb."over_id",
                               MIN(bb."bowler") AS "bowler_id"
                        FROM   "IPL"."IPL"."BALL_BY_BALL" bb
                        GROUP  BY bb."match_id", bb."innings_no", bb."over_id"
                       ) o
                ON     r."match_id"   = o."match_id"
                AND    r."innings_no" = o."innings_no"
                AND    r."over_id"    = o."over_id"
              ) s
       )
WHERE  rn = 1
LIMIT 20;
```

```sql
--Description: 8)  Now condense it further: for each match (across both innings)
--                pick the single highest-scoring over, again storing its bowler.
SELECT *
FROM   (
        SELECT t.*,
               ROW_NUMBER() OVER (PARTITION BY t."match_id"
                                  ORDER BY t."total_over_runs" DESC) AS rn
        FROM   (
                /* same logic as query 6 without LIMIT                  */
                SELECT r."match_id",
                       r."innings_no",
                       r."over_id",
                       r."total_over_runs",
                       o."bowler_id"
                FROM   (
                        SELECT b."match_id",
                               b."innings_no",
                               b."over_id",
                               SUM(b."runs_scored") + COALESCE(SUM(e."extra_runs"),0) AS "total_over_runs"
                        FROM   "IPL"."IPL"."BATSMAN_SCORED" b
                        LEFT  JOIN "IPL"."IPL"."EXTRA_RUNS" e
                               ON  b."match_id"   = e."match_id"
                               AND b."innings_no" = e."innings_no"
                               AND b."over_id"    = e."over_id"
                               AND b."ball_id"    = e."ball_id"
                        GROUP  BY b."match_id", b."innings_no", b."over_id"
                       ) r
                JOIN   (
                        SELECT bb."match_id",
                               bb."innings_no",
                               bb."over_id",
                               MIN(bb."bowler") AS "bowler_id"
                        FROM   "IPL"."IPL"."BALL_BY_BALL" bb
                        GROUP  BY bb."match_id", bb."innings_no", bb."over_id"
                       ) o
                ON     r."match_id"   = o."match_id"
                AND    r."innings_no" = o."innings_no"
                AND    r."over_id"    = o."over_id"
              ) t
       )
WHERE  rn = 1
LIMIT 20;
```

```sql
--Description: 9)  Attach the bowler’s actual name to the over with the most runs
--                for each match.
SELECT g."match_id",
       g."innings_no",
       g."over_id",
       g."total_over_runs",
       g."bowler_id",
       p."player_name" AS "bowler_name"
FROM  (
       /* result of query 8 but without LIMIT */
       SELECT *
       FROM   (
               SELECT t.*,
                      ROW_NUMBER() OVER (PARTITION BY t."match_id"
                                         ORDER BY t."total_over_runs" DESC) AS rn
               FROM   ( /* same block as query 8 */ ) t
              )
       WHERE  rn = 1
      ) g
LEFT JOIN "IPL"."IPL"."PLAYER" p
       ON g."bowler_id" = p."player_id"
LIMIT 20;
```

```sql
--Description: 10)  Finally, compute the average of these highest-scoring overs
--                 across all matches.
SELECT AVG(g."total_over_runs") AS "average_highest_over_runs"
FROM  (
       /* result of query 8 – one row per match, no LIMIT */
       SELECT t.*
       FROM   (
               SELECT s.*,
                      ROW_NUMBER() OVER (PARTITION BY s."match_id"
                                         ORDER BY s."total_over_runs" DESC) AS rn
               FROM   ( /* same block as in query 6 */ ) s
              )
       WHERE rn = 1
      ) g;
```
