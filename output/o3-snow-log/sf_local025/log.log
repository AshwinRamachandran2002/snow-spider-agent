Query:
--Description: 10) Compute the average runs of the single highest-scoring over in every
--               match.  Steps mirrored from the fixed query-9 logic:
--     1. over_runs            : total runs (batsman + extras) per over + bowler_id
--     2. match_highest_over   : rank overs inside each match, keep rn = 1
--     3. Final SELECT         : take the AVG(total_over_runs) across all matches
WITH over_runs AS (   -- per-over totals
    SELECT
        b."match_id",
        b."innings_no",
        b."over_id",
        SUM(b."runs_scored") + COALESCE(SUM(e."extra_runs"), 0) AS "total_over_runs"
    FROM "IPL"."IPL"."BATSMAN_SCORED" b
    LEFT JOIN "IPL"."IPL"."EXTRA_RUNS" e
           ON  b."match_id"   = e."match_id"
           AND b."innings_no" = e."innings_no"
           AND b."over_id"    = e."over_id"
           AND b."ball_id"    = e."ball_id"
    GROUP BY b."match_id", b."innings_no", b."over_id"
),
match_highest_over AS (  -- best over per match
    SELECT
        o."match_id",
        o."total_over_runs",
        ROW_NUMBER() OVER (PARTITION BY o."match_id"
                           ORDER BY o."total_over_runs" DESC) AS rn
    FROM over_runs o
)
SELECT
    AVG(m."total_over_runs") AS "average_highest_over_runs"
FROM match_highest_over m
WHERE m.rn = 1
