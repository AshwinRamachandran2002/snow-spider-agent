```sql
--Description:  Build the result in two steps (inside CTEs) and then display it.
--              1. CTE over_runs
--                 • Join BATSMAN_SCORED (b) with EXTRA_RUNS (e) on the same delivery
--                   to gather ALL runs for that ball.
--                 • Join BALL_BY_BALL (bb) so each delivery also gives its bowler.
--                 • Aggregate by match + innings + over to get:
--                       – total_over_runs  = SUM(batsman_runs + extra_runs)
--                       – bowler_id        = MIN(bowler)  (all balls in an over share a bowler)
--              2. CTE match_highest_over
--                 • Rank those overs within each match on total_over_runs (DESC).
--                 • Keep only rn = 1 → the single highest-scoring over for that match.
--              3. Final SELECT
--                 • Attach bowler_name from PLAYER table.
--                 • Show first 20 rows for inspection.
WITH over_runs AS (
    SELECT
        b."match_id",
        b."innings_no",
        b."over_id",
        SUM(b."runs_scored") + COALESCE(SUM(e."extra_runs"), 0) AS "total_over_runs",
        MIN(bb."bowler") AS "bowler_id"
    FROM "IPL"."IPL"."BATSMAN_SCORED" b
    LEFT JOIN "IPL"."IPL"."EXTRA_RUNS" e
           ON  b."match_id"   = e."match_id"
           AND b."innings_no" = e."innings_no"
           AND b."over_id"    = e."over_id"
           AND b."ball_id"    = e."ball_id"
    JOIN "IPL"."IPL"."BALL_BY_BALL" bb
           ON  b."match_id"   = bb."match_id"
           AND b."innings_no" = bb."innings_no"
           AND b."over_id"    = bb."over_id"
           AND b."ball_id"    = bb."ball_id"
    GROUP BY b."match_id", b."innings_no", b."over_id"
),
match_highest_over AS (
    SELECT
        o.*,
        ROW_NUMBER() OVER (PARTITION BY o."match_id"
                           ORDER BY o."total_over_runs" DESC) AS rn
    FROM over_runs o
)
SELECT
    m."match_id",
    m."innings_no",
    m."over_id",
    m."total_over_runs",
    m."bowler_id",
    p."player_name" AS "bowler_name"
FROM match_highest_over m
LEFT JOIN "IPL"."IPL"."PLAYER" p
       ON m."bowler_id" = p."player_id"
WHERE m.rn = 1
LIMIT 20;
```
