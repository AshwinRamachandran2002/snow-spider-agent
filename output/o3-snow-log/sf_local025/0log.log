--Description: 7) Retrieve bowler(s) who delivered the balls in those highest-run overs  
WITH best_overs AS ( /* query 6 without LIMIT */  
     SELECT "match_id","innings_no","over_id","total_runs"  
     FROM (  
        SELECT *,  
               RANK() OVER (PARTITION BY "match_id","innings_no"  
                            ORDER BY "total_runs" DESC) AS rnk  
        FROM (  
           SELECT  
              COALESCE(b."match_id",e."match_id") AS "match_id",  
              COALESCE(b."innings_no",e."innings_no") AS "innings_no",  
              COALESCE(b."over_id",e."over_id")  AS "over_id",  
              NVL(b."bat_runs",0)+NVL(e."ext_runs",0) AS "total_runs"  
           FROM (SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"  
                 FROM "IPL"."IPL"."BATSMAN_SCORED" GROUP BY 1,2,3) b  
           FULL JOIN (SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "ext_runs"  
                      FROM "IPL"."IPL"."EXTRA_RUNS" GROUP BY 1,2,3) e  
           ON  b."match_id" = e."match_id"  
           AND b."innings_no" = e."innings_no"  
           AND b."over_id"  = e."over_id")  
     ) WHERE rnk = 1)  
SELECT DISTINCT  
       bo."match_id",  
       bo."innings_no",  
       bo."over_id",  
       bo."total_runs",  
       bb."bowler"  
FROM best_overs bo  
JOIN "IPL"."IPL"."BALL_BY_BALL" bb  
  ON  bo."match_id"  = bb."match_id"  
  AND bo."innings_no"= bb."innings_no"  
  AND bo."over_id"   = bb."over_id"  
LIMIT 20;
