SELECT *  
FROM "IPL"."IPL"."EXTRA_RUNS"  
LIMIT 20;
```

```sql
--Description: 3) Runs scored by batsmen aggregated at match-innings-over level  
SELECT  
       "match_id",  
       "innings_no",  
       "over_id",  
       SUM("runs_scored") AS "batsman_runs"  
FROM "IPL"."IPL"."BATSMAN_SCORED"  
GROUP BY "match_id","innings_no","over_id"  
LIMIT 20;
```

```sql
--Description: 4) Extra runs aggregated at the same match-innings-over grain  
SELECT  
       "match_id",  
       "innings_no",  
       "over_id",  
       SUM("extra_runs") AS "extra_runs"  
FROM "IPL"."IPL"."EXTRA_RUNS"  
GROUP BY "match_id","innings_no","over_id"  
LIMIT 20;
```

```sql
--Description: 5) Combine batsman and extra runs to get total runs per over  
WITH b AS (  
   SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"  
   FROM "IPL"."IPL"."BATSMAN_SCORED"  
   GROUP BY 1,2,3),  
e AS (  
   SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "ext_runs"  
   FROM "IPL"."IPL"."EXTRA_RUNS"  
   GROUP BY 1,2,3)  
SELECT  
       COALESCE(b."match_id",e."match_id")  AS "match_id",  
       COALESCE(b."innings_no",e."innings_no") AS "innings_no",  
       COALESCE(b."over_id",e."over_id")   AS "over_id",  
       NVL(b."bat_runs",0)+NVL(e."ext_runs",0) AS "total_runs_in_over"  
FROM b  
FULL JOIN e  
ON  b."match_id" = e."match_id"  
AND b."innings_no" = e."innings_no"  
AND b."over_id"  = e."over_id"  
LIMIT 20;
```

```sql
--Description: 6) For every match & innings, pick the single over that had the maximum total runs  
WITH over_tot AS ( /* re-use query 5 logic */  
     SELECT  
            COALESCE(b."match_id",e."match_id") AS "match_id",  
            COALESCE(b."innings_no",e."innings_no") AS "innings_no",  
            COALESCE(b."over_id",e."over_id")  AS "over_id",  
            NVL(b."bat_runs",0)+NVL(e."ext_runs",0) AS "total_runs"  
     FROM (SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"  
           FROM "IPL"."IPL"."BATSMAN_SCORED" GROUP BY 1,2,3) b  
     FULL JOIN (SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "ext_runs"  
                FROM "IPL"."IPL"."EXTRA_RUNS" GROUP BY 1,2,3) e  
     ON  b."match_id" = e."match_id"  
     AND b."innings_no" = e."innings_no"  
     AND b."over_id"  = e."over_id")  
SELECT *  
FROM (  
     SELECT *,  
            RANK() OVER (PARTITION BY "match_id","innings_no"  
                         ORDER BY "total_runs" DESC) AS "rnk"  
     FROM over_tot) q  
WHERE "rnk" = 1  
LIMIT 20;
```

```sql
--Description: 7) Retrieve bowler(s) who delivered the balls in those highest-run overs  
WITH best_overs AS ( /* query 6 without LIMIT */  
     SELECT "match_id","innings_no","over_id","total_runs"  
     FROM (  
        SELECT *,  
               RANK() OVER (PARTITION BY "match_id","innings_no"  
                            ORDER BY "total_runs" DESC) AS rnk  
        FROM (  
           SELECT  
              COALESCE(b."match_id",e."match_id") AS "match_id",  
              COALESCE(b."innings_no",e."innings_no") AS "innings_no",  
              COALESCE(b."over_id",e."over_id")  AS "over_id",  
              NVL(b."bat_runs",0)+NVL(e."ext_runs",0) AS "total_runs"  
           FROM (SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"  
                 FROM "IPL"."IPL"."BATSMAN_SCORED" GROUP BY 1,2,3) b  
           FULL JOIN (SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "ext_runs"  
                      FROM "IPL"."IPL"."EXTRA_RUNS" GROUP BY 1,2,3) e  
           ON  b."match_id" = e."match_id"  
           AND b."innings_no" = e."innings_no"  
           AND b."over_id"  = e."over_id")  
     ) WHERE rnk = 1)  
SELECT DISTINCT  
       bo."match_id",  
       bo."innings_no",  
       bo."over_id",  
       bo."total_runs",  
       bb."bowler"  
FROM best_overs bo  
JOIN "IPL"."IPL"."BALL_BY_BALL" bb  
  ON  bo."match_id"  = bb."match_id"  
  AND bo."innings_no"= bb."innings_no"  
  AND bo."over_id"   = bb."over_id"  
LIMIT 20;
```

```sql
--Description: 8) Attach bowler names for readability  
WITH best_over_bowler AS ( /* query 7 without LIMIT */  
     SELECT DISTINCT  
            bo."match_id",  
            bo."innings_no",  
            bo."over_id",  
            bo."total_runs",  
            bb."bowler"  
     FROM ( /* same CTE best_overs as above */  
          SELECT "match_id","innings_no","over_id","total_runs"  
          FROM (  
              SELECT *,  
                     RANK() OVER (PARTITION BY "match_id","innings_no"  
                                  ORDER BY "total_runs" DESC) AS rnk  
              FROM (  
                  SELECT  
                      COALESCE(b."match_id",e."match_id") AS "match_id",  
                      COALESCE(b."innings_no",e."innings_no") AS "innings_no",  
                      COALESCE(b."over_id",e."over_id")  AS "over_id",  
                      NVL(b."bat_runs",0)+NVL(e."ext_runs",0) AS "total_runs"  
                  FROM (SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"  
                        FROM "IPL"."IPL"."BATSMAN_SCORED" GROUP BY 1,2,3) b  
                  FULL JOIN (SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "ext_runs"  
                             FROM "IPL"."IPL"."EXTRA_RUNS" GROUP BY 1,2,3) e  
                  ON  b."match_id" = e."match_id"  
                  AND b."innings_no" = e."innings_no"  
                  AND b."over_id"  = e."over_id")  
          ) WHERE rnk = 1) bo  
     JOIN "IPL"."IPL"."BALL_BY_BALL" bb  
       ON  bo."match_id"  = bb."match_id"  
       AND bo."innings_no"= bb."innings_no"  
       AND bo."over_id"   = bb."over_id")  
SELECT  
       bob."match_id",  
       bob."innings_no",  
       bob."over_id",  
       bob."total_runs",  
       p."player_name"    AS "bowler_name"  
FROM best_over_bowler bob  
JOIN "IPL"."IPL"."PLAYER" p  
  ON bob."bowler" = p."player_id"  
LIMIT 20;
```

```sql
--Description: 9) Compute the highest-over total for every match (any innings) and return one row per match with that over’s runs  
WITH per_innings_max AS ( /* query 6 logic */  
     SELECT "match_id","innings_no","total_runs"  
     FROM (  
        SELECT *,  
               RANK() OVER (PARTITION BY "match_id","innings_no" ORDER BY "total_runs" DESC) AS rnk  
        FROM ( /* over total calculation – same as earlier */  
             SELECT  
                COALESCE(b."match_id",e."match_id") AS "match_id",  
                COALESCE(b."innings_no",e."innings_no") AS "innings_no",  
                NVL(b."bat_runs",0)+NVL(e."ext_runs",0) AS "total_runs"  
             FROM (SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"  
                   FROM "IPL"."IPL"."BATSMAN_SCORED" GROUP BY 1,2,3) b  
             FULL JOIN (SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "ext_runs"  
                        FROM "IPL"."IPL"."EXTRA_RUNS" GROUP BY 1,2,3) e  
             ON  b."match_id" = e."match_id"  
             AND b."innings_no" = e."innings_no"  
             AND b."over_id"  = e."over_id")  
     ) WHERE rnk = 1),  
per_match_max AS ( /* pick the better of the two innings for each match */  
     SELECT "match_id", MAX("total_runs") AS "match_highest_over_runs"  
     FROM per_innings_max  
     GROUP BY "match_id")  
SELECT *  
FROM per_match_max  
LIMIT 20;
```

```sql
--Description: 10) Average of the highest-over totals across all matches  
WITH per_innings_max AS ( /* same as query 9 CTE-1 */  
     SELECT "match_id","innings_no","total_runs"  
     FROM (  
        SELECT *,  
               RANK() OVER (PARTITION BY "match_id","innings_no" ORDER BY "total_runs" DESC) AS rnk  
        FROM (  
             SELECT  
                COALESCE(b."match_id",e."match_id") AS "match_id",  
                COALESCE(b."innings_no",e."innings_no") AS "innings_no",  
                NVL(b."bat_runs",0)+NVL(e."ext_runs",0) AS "total_runs"  
             FROM (SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"  
                   FROM "IPL"."IPL"."BATSMAN_SCORED" GROUP BY 1,2,3) b  
             FULL JOIN (SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "ext_runs"  
                        FROM "IPL"."IPL"."EXTRA_RUNS" GROUP BY 1,2,3) e  
             ON  b."match_id" = e."match_id"  
             AND b."innings_no" = e."innings_no"  
             AND b."over_id"  = e."over_id")  
     ) WHERE rnk = 1),  
per_match_max AS (  
     SELECT "match_id", MAX("total_runs") AS "highest_over_runs"  
     FROM per_innings_max  
     GROUP BY "match_id")  
SELECT AVG("highest_over_runs") AS "avg_highest_over_per_match"  
FROM per_match_max  
LIMIT 20;
```
