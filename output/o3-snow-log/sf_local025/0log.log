--Description: 5) Combine batsman and extra runs to get total runs per over  
WITH b AS (  
   SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"  
   FROM "IPL"."IPL"."BATSMAN_SCORED"  
   GROUP BY 1,2,3),  
e AS (  
   SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "ext_runs"  
   FROM "IPL"."IPL"."EXTRA_RUNS"  
   GROUP BY 1,2,3)  
SELECT  
       COALESCE(b."match_id",e."match_id")  AS "match_id",  
       COALESCE(b."innings_no",e."innings_no") AS "innings_no",  
       COALESCE(b."over_id",e."over_id")   AS "over_id",  
       NVL(b."bat_runs",0)+NVL(e."ext_runs",0) AS "total_runs_in_over"  
FROM b  
FULL JOIN e  
ON  b."match_id" = e."match_id"  
AND b."innings_no" = e."innings_no"  
AND b."over_id"  = e."over_id"  
LIMIT 20;
