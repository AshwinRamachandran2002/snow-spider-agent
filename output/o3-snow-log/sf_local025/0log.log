--Description: 9) Compute the highest-over total for every match (any innings) and return one row per match with that over’s runs  
WITH per_innings_max AS ( /* query 6 logic */  
     SELECT "match_id","innings_no","total_runs"  
     FROM (  
        SELECT *,  
               RANK() OVER (PARTITION BY "match_id","innings_no" ORDER BY "total_runs" DESC) AS rnk  
        FROM ( /* over total calculation – same as earlier */  
             SELECT  
                COALESCE(b."match_id",e."match_id") AS "match_id",  
                COALESCE(b."innings_no",e."innings_no") AS "innings_no",  
                NVL(b."bat_runs",0)+NVL(e."ext_runs",0) AS "total_runs"  
             FROM (SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"  
                   FROM "IPL"."IPL"."BATSMAN_SCORED" GROUP BY 1,2,3) b  
             FULL JOIN (SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "ext_runs"  
                        FROM "IPL"."IPL"."EXTRA_RUNS" GROUP BY 1,2,3) e  
             ON  b."match_id" = e."match_id"  
             AND b."innings_no" = e."innings_no"  
             AND b."over_id"  = e."over_id")  
     ) WHERE rnk = 1),  
per_match_max AS ( /* pick the better of the two innings for each match */  
     SELECT "match_id", MAX("total_runs") AS "match_highest_over_runs"  
     FROM per_innings_max  
     GROUP BY "match_id")  
SELECT *  
FROM per_match_max  
LIMIT 20;
