```sql
--Description: For one sample match, combine batsman runs & extra runs to get over-total (show 20 rows)
SELECT bs."match_id",
       bs."innings_no",
       bs."over_id",
       SUM(bs."runs_scored")          AS "batsman_runs",
       COALESCE(SUM(er."extra_runs"),0) AS "extra_runs",
       SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "total_runs_over"
FROM   IPL.IPL.BATSMAN_SCORED bs
LEFT JOIN IPL.IPL.EXTRA_RUNS  er
       ON bs."match_id"   = er."match_id"
      AND bs."innings_no" = er."innings_no"
      AND bs."over_id"    = er."over_id"
      AND bs."ball_id"    = er."ball_id"
WHERE  bs."match_id" = 335987
GROUP  BY bs."match_id", bs."innings_no", bs."over_id"
ORDER  BY bs."over_id"
LIMIT  20;
```

```sql
--Description: Compute total runs per over for ALL matches & innings (limit to 20 random rows)
WITH over_tot AS (
    SELECT bs."match_id",
           bs."innings_no",
           bs."over_id",
           SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "total_runs_over"
    FROM   IPL.IPL.BATSMAN_SCORED bs
    LEFT  JOIN IPL.IPL.EXTRA_RUNS er
           ON  bs."match_id"   = er."match_id"
           AND bs."innings_no" = er."innings_no"
           AND bs."over_id"    = er."over_id"
           AND bs."ball_id"    = er."ball_id"
    GROUP BY bs."match_id", bs."innings_no", bs."over_id"
)
SELECT *
FROM   over_tot
LIMIT  20;
```

```sql
--Description: For each match, pick the single over (across both innings) with highest total runs
WITH over_tot AS (
    SELECT bs."match_id",
           bs."innings_no",
           bs."over_id",
           SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "total_runs_over"
    FROM   IPL.IPL.BATSMAN_SCORED bs
    LEFT  JOIN IPL.IPL.EXTRA_RUNS er
           ON  bs."match_id"   = er."match_id"
           AND bs."innings_no" = er."innings_no"
           AND bs."over_id"    = er."over_id"
           AND bs."ball_id"    = er."ball_id"
    GROUP BY bs."match_id", bs."innings_no", bs."over_id"
),
ranked AS (
    SELECT *,
           RANK() OVER (PARTITION BY "match_id" ORDER BY "total_runs_over" DESC) AS rnk
    FROM   over_tot
)
SELECT *
FROM   ranked
WHERE  rnk = 1               -- highest-scoring over in each match
LIMIT  20;
```

```sql
--Description: For those highest-scoring overs, pull the bowler (first ball of that over)
WITH best_over AS (
    /* same CTE as previous query */
    SELECT *
    FROM (
        SELECT bs."match_id",
               bs."innings_no",
               bs."over_id",
               SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "total_runs_over",
               RANK() OVER (PARTITION BY bs."match_id" ORDER BY SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) DESC) AS rnk
        FROM   IPL.IPL.BATSMAN_SCORED bs
        LEFT  JOIN IPL.IPL.EXTRA_RUNS er
               ON  bs."match_id"   = er."match_id"
               AND bs."innings_no" = er."innings_no"
               AND bs."over_id"    = er."over_id"
               AND bs."ball_id"    = er."ball_id"
        GROUP BY bs."match_id", bs."innings_no", bs."over_id"
    ) t
    WHERE rnk = 1
)
SELECT bo."match_id",
       bo."innings_no",
       bo."over_id",
       bo."total_runs_over",
       MIN(bbb."bowler") AS "bowler_id"   -- all balls in an over have same bowler
FROM   best_over bo
JOIN   IPL.IPL.BALL_BY_BALL bbb
       ON  bo."match_id"   = bbb."match_id"
       AND bo."innings_no" = bbb."innings_no"
       AND bo."over_id"    = bbb."over_id"
GROUP  BY bo."match_id", bo."innings_no", bo."over_id", bo."total_runs_over"
LIMIT  20;
```

```sql
--Description: Add bowler name using PLAYER table (limit 20 results)
WITH best_over_bowler AS (
    /* CTE from previous query */
    SELECT bo."match_id",
           bo."innings_no",
           bo."over_id",
           bo."total_runs_over",
           MIN(bbb."bowler") AS "bowler_id"
    FROM (
        /* inner repeated logic for highest over */
        SELECT *
        FROM (
            SELECT bs."match_id",
                   bs."innings_no",
                   bs."over_id",
                   SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "total_runs_over",
                   RANK() OVER (PARTITION BY bs."match_id" ORDER BY SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) DESC) AS rnk
            FROM   IPL.IPL.BATSMAN_SCORED bs
            LEFT  JOIN IPL.IPL.EXTRA_RUNS er
                   ON  bs."match_id"   = er."match_id"
                   AND bs."innings_no" = er."innings_no"
                   AND bs."over_id"    = er."over_id"
                   AND bs."ball_id"    = er."ball_id"
            GROUP BY bs."match_id", bs."innings_no", bs."over_id"
        ) x
        WHERE rnk = 1
    ) bo
    JOIN IPL.IPL.BALL_BY_BALL bbb
         ON  bo."match_id"   = bbb."match_id"
         AND bo."innings_no" = bbb."innings_no"
         AND bo."over_id"    = bbb."over_id"
    GROUP BY bo."match_id", bo."innings_no", bo."over_id", bo."total_runs_over"
)
SELECT bob."match_id",
       bob."innings_no",
       bob."over_id",
       bob."total_runs_over",
       bob."bowler_id",
       p."player_name" AS "bowler_name"
FROM   best_over_bowler bob
LEFT  JOIN IPL.IPL.PLAYER p
       ON bob."bowler_id" = p."player_id"
LIMIT  20;
```

```sql
--Description: Calculate the average runs of these highest-scoring overs across all matches
WITH per_match_max AS (
    SELECT bs."match_id",
           SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "total_runs_over",
           RANK() OVER (PARTITION BY bs."match_id" ORDER BY SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) DESC) AS rnk
    FROM   IPL.IPL.BATSMAN_SCORED bs
    LEFT  JOIN IPL.IPL.EXTRA_RUNS er
           ON  bs."match_id"   = er."match_id"
           AND bs."innings_no" = er."innings_no"
           AND bs."over_id"    = er."over_id"
           AND bs."ball_id"    = er."ball_id"
    GROUP BY bs."match_id", bs."innings_no", bs."over_id"
),
highest_per_match AS (
    SELECT "match_id",
           "total_runs_over"
    FROM   per_match_max
    WHERE  rnk = 1
)
SELECT AVG("total_runs_over") AS "avg_of_highest_over_runs"
FROM   highest_per_match;
```

```sql
--Description: View distribution of highest-over totals (distinct values with frequency)
WITH per_match_max AS (
    SELECT bs."match_id",
           SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "total_runs_over",
           RANK() OVER (PARTITION BY bs."match_id" ORDER BY SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) DESC) AS rnk
    FROM   IPL.IPL.BATSMAN_SCORED bs
    LEFT  JOIN IPL.IPL.EXTRA_RUNS er
           ON  bs."match_id"   = er."match_id"
           AND bs."innings_no" = er."innings_no"
           AND bs."over_id"    = er."over_id"
           AND bs."ball_id"    = er."ball_id"
    GROUP BY bs."match_id", bs."innings_no", bs."over_id"
),
highest_per_match AS (
    SELECT "match_id",
           "total_runs_over"
    FROM   per_match_max
    WHERE  rnk = 1
)
SELECT "total_runs_over",
       COUNT(*) AS "num_matches"
FROM   highest_per_match
GROUP  BY "total_runs_over"
ORDER  BY "num_matches" DESC,
         "total_runs_over" DESC
LIMIT  20;
```
