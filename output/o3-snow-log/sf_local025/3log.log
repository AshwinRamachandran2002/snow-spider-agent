--Description: Add bowler name using PLAYER table (limit 20 results)
WITH best_over_bowler AS (
    /* CTE from previous query */
    SELECT bo."match_id",
           bo."innings_no",
           bo."over_id",
           bo."total_runs_over",
           MIN(bbb."bowler") AS "bowler_id"
    FROM (
        /* inner repeated logic for highest over */
        SELECT *
        FROM (
            SELECT bs."match_id",
                   bs."innings_no",
                   bs."over_id",
                   SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "total_runs_over",
                   RANK() OVER (PARTITION BY bs."match_id" ORDER BY SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) DESC) AS rnk
            FROM   IPL.IPL.BATSMAN_SCORED bs
            LEFT  JOIN IPL.IPL.EXTRA_RUNS er
                   ON  bs."match_id"   = er."match_id"
                   AND bs."innings_no" = er."innings_no"
                   AND bs."over_id"    = er."over_id"
                   AND bs."ball_id"    = er."ball_id"
            GROUP BY bs."match_id", bs."innings_no", bs."over_id"
        ) x
        WHERE rnk = 1
    ) bo
    JOIN IPL.IPL.BALL_BY_BALL bbb
         ON  bo."match_id"   = bbb."match_id"
         AND bo."innings_no" = bbb."innings_no"
         AND bo."over_id"    = bbb."over_id"
    GROUP BY bo."match_id", bo."innings_no", bo."over_id", bo."total_runs_over"
)
SELECT bob."match_id",
       bob."innings_no",
       bob."over_id",
       bob."total_runs_over",
       bob."bowler_id",
       p."player_name" AS "bowler_name"
FROM   best_over_bowler bob
LEFT  JOIN IPL.IPL.PLAYER p
       ON bob."bowler_id" = p."player_id"
LIMIT  20;
