Query:
--Description: For each match, pick the single over (across both innings) with highest total runs
WITH over_tot AS (
    SELECT bs."match_id",
           bs."innings_no",
           bs."over_id",
           SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "total_runs_over"
    FROM   IPL.IPL.BATSMAN_SCORED bs
    LEFT  JOIN IPL.IPL.EXTRA_RUNS er
           ON  bs."match_id"   = er."match_id"
           AND bs."innings_no" = er."innings_no"
           AND bs."over_id"    = er."over_id"
           AND bs."ball_id"    = er."ball_id"
    GROUP BY bs."match_id", bs."innings_no", bs."over_id"
),
ranked AS (
    SELECT *,
           RANK() OVER (PARTITION BY "match_id" ORDER BY "total_runs_over" DESC) AS rnk
    FROM   over_tot
)
SELECT *
FROM   ranked
WHERE  rnk = 1               -- highest-scoring over in each match
LIMIT  20;
