```sql
--Description: For 5 random matches, compute per-match & per-innings highest over total runs (batsman + extras) and show the value
SELECT *
FROM (
    SELECT
        bs."match_id",
        bs."innings_no",
        MAX(SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0))
            OVER (PARTITION BY bs."match_id", bs."innings_no") AS "highest_over_runs",
        bs."over_id"
    FROM IPL.IPL.BATSMAN_SCORED bs
    LEFT JOIN IPL.IPL.EXTRA_RUNS er
           ON er."match_id"   = bs."match_id"
          AND er."innings_no" = bs."innings_no"
          AND er."over_id"    = bs."over_id"
          AND er."ball_id"    = bs."ball_id"
    WHERE bs."match_id" IN (SELECT DISTINCT "match_id" FROM IPL.IPL.BATSMAN_SCORED LIMIT 5)
    GROUP BY bs."match_id", bs."innings_no", bs."over_id"
) q
LIMIT 20;
```

```sql
--Description: Bring in the bowler for each of those peak overs (limited to 20 rows)
SELECT DISTINCT
    q."match_id",
    q."innings_no",
    q."over_id",
    q."highest_over_runs",
    bb."bowler"
FROM (
        /* re-use logic from previous query but restrict list for brevity */
        SELECT
            bs."match_id",
            bs."innings_no",
            bs."over_id",
            SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "highest_over_runs",
            ROW_NUMBER() OVER (PARTITION BY bs."match_id", bs."innings_no" 
                               ORDER BY SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) DESC) AS rn
        FROM IPL.IPL.BATSMAN_SCORED bs
        LEFT JOIN IPL.IPL.EXTRA_RUNS er
               ON er."match_id"   = bs."match_id"
              AND er."innings_no" = bs."innings_no"
              AND er."over_id"    = bs."over_id"
              AND er."ball_id"    = bs."ball_id"
        WHERE bs."match_id" IN (SELECT DISTINCT "match_id" FROM IPL.IPL.BATSMAN_SCORED LIMIT 5)
        GROUP BY bs."match_id", bs."innings_no", bs."over_id"
) q
JOIN IPL.IPL.BALL_BY_BALL bb
  ON bb."match_id"   = q."match_id"
 AND bb."innings_no" = q."innings_no"
 AND bb."over_id"    = q."over_id"
WHERE q.rn = 1
LIMIT 20;
