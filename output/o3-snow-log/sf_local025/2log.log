--Description: Compute the average of each match’s highest-scoring over (across all innings) throughout the entire dataset
WITH over_runs AS (
    SELECT
        bs."match_id",
        bs."innings_no",
        bs."over_id",
        SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "over_runs"
    FROM IPL.IPL.BATSMAN_SCORED bs
    LEFT JOIN IPL.IPL.EXTRA_RUNS er
           ON er."match_id"   = bs."match_id"
          AND er."innings_no" = bs."innings_no"
          AND er."over_id"    = bs."over_id"
          AND er."ball_id"    = bs."ball_id"
    GROUP BY bs."match_id", bs."innings_no", bs."over_id"
),
highest_each_match AS (
    SELECT
        o."match_id",
        o."over_runs" AS "highest_over_runs"
    FROM (
        SELECT
            over_runs.*,
            ROW_NUMBER() OVER (PARTITION BY over_runs."match_id"
                               ORDER BY over_runs."over_runs" DESC) AS rn
        FROM over_runs
    ) o
    WHERE o.rn = 1
)
SELECT
    AVG("highest_over_runs") AS "avg_highest_over_runs_across_matches"
FROM highest_each_match
LIMIT 20
