```sql
--Description: For 5 random matches, get each match-innings’ single highest-scoring over (batsman + extras) and show its run total
WITH over_runs AS (
    SELECT
        bs."match_id",
        bs."innings_no",
        bs."over_id",
        SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "over_runs"
    FROM IPL.IPL.BATSMAN_SCORED bs
    LEFT JOIN IPL.IPL.EXTRA_RUNS er
           ON er."match_id"   = bs."match_id"
          AND er."innings_no" = bs."innings_no"
          AND er."over_id"    = bs."over_id"
          AND er."ball_id"    = bs."ball_id"
    WHERE bs."match_id" IN (SELECT DISTINCT "match_id" FROM IPL.IPL.BATSMAN_SCORED LIMIT 5)
    GROUP BY bs."match_id", bs."innings_no", bs."over_id"
)
SELECT
    o."match_id",
    o."innings_no",
    o."over_id",
    o."over_runs" AS "highest_over_runs"
FROM (
    SELECT
        over_runs.*,
        ROW_NUMBER() OVER (PARTITION BY over_runs."match_id", over_runs."innings_no"
                           ORDER BY over_runs."over_runs" DESC) AS rn
    FROM over_runs
) o
WHERE o.rn = 1
LIMIT 20;
```

```sql
--Description: Bring in the bowler for each of those peak overs (same 5 random matches, top over per match-innings)
WITH over_runs AS (
    SELECT
        bs."match_id",
        bs."innings_no",
        bs."over_id",
        SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "over_runs"
    FROM IPL.IPL.BATSMAN_SCORED bs
    LEFT JOIN IPL.IPL.EXTRA_RUNS er
           ON er."match_id"   = bs."match_id"
          AND er."innings_no" = bs."innings_no"
          AND er."over_id"    = bs."over_id"
          AND er."ball_id"    = bs."ball_id"
    WHERE bs."match_id" IN (SELECT DISTINCT "match_id" FROM IPL.IPL.BATSMAN_SCORED LIMIT 5)
    GROUP BY bs."match_id", bs."innings_no", bs."over_id"
),
highest AS (
    SELECT
        o.*,
        ROW_NUMBER() OVER (PARTITION BY o."match_id", o."innings_no"
                           ORDER BY o."over_runs" DESC) AS rn
    FROM over_runs o
)
SELECT DISTINCT
    h."match_id",
    h."innings_no",
    h."over_id",
    h."over_runs" AS "highest_over_runs",
    bb."bowler"
FROM highest h
JOIN IPL.IPL.BALL_BY_BALL bb
  ON bb."match_id"   = h."match_id"
 AND bb."innings_no" = h."innings_no"
 AND bb."over_id"    = h."over_id"
WHERE h.rn = 1
LIMIT 20;
```

```sql
--Description: Compute the average of each match’s highest-scoring over (across all innings) throughout the entire dataset
WITH over_runs AS (
    SELECT
        bs."match_id",
        bs."innings_no",
        bs."over_id",
        SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "over_runs"
    FROM IPL.IPL.BATSMAN_SCORED bs
    LEFT JOIN IPL.IPL.EXTRA_RUNS er
           ON er."match_id"   = bs."match_id"
          AND er."innings_no" = bs."innings_no"
          AND er."over_id"    = bs."over_id"
          AND er."ball_id"    = bs."ball_id"
    GROUP BY bs."match_id", bs."innings_no", bs."over_id"
),
highest_each_match AS (
    SELECT
        o."match_id",
        o."over_runs" AS "highest_over_runs"
    FROM (
        SELECT
            over_runs.*,
            ROW_NUMBER() OVER (PARTITION BY over_runs."match_id"
                               ORDER BY over_runs."over_runs" DESC) AS rn
        FROM over_runs
    ) o
    WHERE o.rn = 1
)
SELECT
    AVG("highest_over_runs") AS "avg_highest_over_runs_across_matches"
FROM highest_each_match
LIMIT 20;
```
