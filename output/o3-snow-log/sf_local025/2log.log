```sql
--Description: Combine batsman runs and extra runs for one sample match & innings (match_id = 335987, innings_no = 1) grouped by over
SELECT
    bs."match_id",
    bs."innings_no",
    bs."over_id",
    SUM(bs."runs_scored")            AS "batsman_runs",
    COALESCE(SUM(er."extra_runs"),0) AS "extra_runs",
    SUM(bs."runs_scored") + COALESCE(SUM(er."extra_runs"),0) AS "total_over_runs"
FROM IPL.IPL.BATSMAN_SCORED  bs
LEFT JOIN IPL.IPL.EXTRA_RUNS er
       ON er."match_id"   = bs."match_id"
      AND er."innings_no" = bs."innings_no"
      AND er."over_id"    = bs."over_id"
      AND er."ball_id"    = bs."ball_id"
WHERE bs."match_id" = 335987
  AND bs."innings_no" = 1
GROUP BY bs."match_id", bs."innings_no", bs."over_id"
ORDER BY "total_over_runs" DESC
LIMIT 20;
```

```sql
--Description: Identify the single highest-scoring over (total runs) in that same sample match & innings
