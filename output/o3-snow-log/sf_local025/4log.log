FROM   IPL.IPL."BALL_BY_BALL"
LIMIT  20;
```

```sql
--Description: 6) Aggregate total runs off the bat per match-innings-over (sample 20)
SELECT "match_id",
       "innings_no",
       "over_id",
       SUM("runs_scored") AS "bat_runs_in_over"
FROM   IPL.IPL."BATSMAN_SCORED"
GROUP  BY "match_id","innings_no","over_id"
LIMIT  20;
```

```sql
--Description: 7) Aggregate total extra runs per match-innings-over (sample 20)
SELECT "match_id",
       "innings_no",
       "over_id",
       SUM("extra_runs") AS "extra_runs_in_over"
FROM   IPL.IPL."EXTRA_RUNS"
GROUP  BY "match_id","innings_no","over_id"
LIMIT  20;
```

```sql
--Description: 8) Combine both tables to get total runs per over (sample 20)
WITH bat AS (
    SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS bat_runs
    FROM   IPL.IPL."BATSMAN_SCORED"
    GROUP  BY "match_id","innings_no","over_id"
),
ext AS (
    SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS extra_runs
    FROM   IPL.IPL."EXTRA_RUNS"
    GROUP  BY "match_id","innings_no","over_id"
)
SELECT COALESCE(bat."match_id",ext."match_id")      AS "match_id",
       COALESCE(bat."innings_no",ext."innings_no")  AS "innings_no",
       COALESCE(bat."over_id",ext."over_id")        AS "over_id",
       COALESCE(bat.bat_runs,0)  +  COALESCE(ext.extra_runs,0) AS "total_runs_in_over"
FROM   bat
FULL   JOIN ext
       ON  bat."match_id" = ext."match_id"
       AND bat."innings_no" = ext."innings_no"
       AND bat."over_id" = ext."over_id"
LIMIT  20;
```

```sql
--Description: 9) For every match, find the single over (across both innings) with the highest total runs and bring the bowler who delivered that over
WITH bat AS (
    SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS bat_runs
    FROM   IPL.IPL."BATSMAN_SCORED"
    GROUP  BY "match_id","innings_no","over_id"
),
ext AS (
    SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS extra_runs
    FROM   IPL.IPL."EXTRA_RUNS"
    GROUP  BY "match_id","innings_no","over_id"
),
tot AS (
    SELECT COALESCE(bat."match_id",ext."match_id")     AS "match_id",
           COALESCE(bat."innings_no",ext."innings_no") AS "innings_no",
           COALESCE(bat."over_id",ext."over_id")       AS "over_id",
           COALESCE(bat.bat_runs,0) + COALESCE(ext.extra_runs,0) AS "total_runs_in_over"
    FROM   bat
    FULL   JOIN ext
        ON bat."match_id"   = ext."match_id"
       AND bat."innings_no" = ext."innings_no"
       AND bat."over_id"    = ext."over_id"
),
max_over AS (
    SELECT *
    FROM   (
        SELECT t.*,
               ROW_NUMBER() OVER(PARTITION BY "match_id" ORDER BY "total_runs_in_over" DESC, "innings_no", "over_id") AS rn
        FROM   tot t
    )
    WHERE  rn = 1
),
bowler_in_over AS (
    SELECT "match_id",
           "innings_no",
           "over_id",
           MIN("bowler") AS "bowler"           -- assuming one bowler per over; MIN() picks him
    FROM   IPL.IPL."BALL_BY_BALL"
    GROUP  BY "match_id","innings_no","over_id"
)
SELECT m."match_id",
       m."innings_no",
       m."over_id",
       m."total_runs_in_over",
       b."bowler"
FROM   max_over m
JOIN   bowler_in_over b
  ON   m."match_id"   = b."match_id"
 AND   m."innings_no" = b."innings_no"
 AND   m."over_id"    = b."over_id"
LIMIT  20;
```

```sql
--Description: 10) Compute the average of these highest-over totals across all matches
WITH bat AS (
    SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS bat_runs
    FROM   IPL.IPL."BATSMAN_SCORED"
    GROUP  BY "match_id","innings_no","over_id"
),
ext AS (
    SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS extra_runs
    FROM   IPL.IPL."EXTRA_RUNS"
    GROUP  BY "match_id","innings_no","over_id"
),
tot AS (
    SELECT COALESCE(bat."match_id",ext."match_id")     AS "match_id",
           COALESCE(bat."innings_no",ext."innings_no") AS "innings_no",
           COALESCE(bat."over_id",ext."over_id")       AS "over_id",
           COALESCE(bat.bat_runs,0) + COALESCE(ext.extra_runs,0) AS "total_runs_in_over"
    FROM   bat
    FULL   JOIN ext
        ON bat."match_id"   = ext."match_id"
       AND bat."innings_no" = ext."innings_no"
       AND bat."over_id"    = ext."over_id"
),
max_over AS (
    SELECT *
    FROM   (
        SELECT t.*,
               ROW_NUMBER() OVER(PARTITION BY "match_id" ORDER BY "total_runs_in_over" DESC) AS rn
        FROM   tot t
    )
    WHERE  rn = 1
)
SELECT AVG("total_runs_in_over") AS "avg_highest_over_runs_across_matches"
FROM   max_over;
```
