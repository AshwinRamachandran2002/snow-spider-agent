```sql
--Description: total batsman-runs scored in every over / innings (first 20 groups)  
SELECT "match_id",
       "innings_no",
       "over_id",
       SUM("runs_scored")   AS "bat_runs"
FROM IPL.IPL.BATSMAN_SCORED
GROUP BY "match_id","innings_no","over_id"
ORDER BY "match_id","over_id"
LIMIT 20;
```

```sql
--Description: total extra-runs given in every over / innings (first 20 groups)  
SELECT "match_id",
       "innings_no",
       "over_id",
       SUM("extra_runs")    AS "extra_runs"
FROM IPL.IPL.EXTRA_RUNS
GROUP BY "match_id","innings_no","over_id"
ORDER BY "match_id","over_id"
LIMIT 20;
```

```sql
--Description: combine batsman & extra runs to see full over-totals (sample 20 rows)  
SELECT COALESCE(b."match_id",e."match_id")     AS "match_id",
       COALESCE(b."innings_no",e."innings_no") AS "innings_no",
       COALESCE(b."over_id",e."over_id")       AS "over_id",
       COALESCE(b."bat_runs",0) + COALESCE(e."extra_runs",0) AS "total_runs"
FROM ( SELECT "match_id","innings_no","over_id",SUM("runs_scored") AS "bat_runs"
       FROM IPL.IPL.BATSMAN_SCORED
       GROUP BY "match_id","innings_no","over_id") b
FULL JOIN ( SELECT "match_id","innings_no","over_id",SUM("extra_runs") AS "extra_runs"
            FROM IPL.IPL.EXTRA_RUNS
            GROUP BY "match_id","innings_no","over_id") e
  ON b."match_id"  = e."match_id"
 AND b."innings_no"= e."innings_no"
 AND b."over_id"   = e."over_id"
LIMIT 20;
```

```sql
--Description: for every match keep only the single over (any innings) with the
--             highest combined total; show first 20 matches  
SELECT t."match_id",
       t."innings_no",
       t."over_id",
       t."total_runs"
FROM (
     SELECT c.*,
            ROW_NUMBER() OVER (PARTITION BY c."match_id"
                               ORDER BY c."total_runs" DESC) AS "rn"
     FROM (
          SELECT COALESCE(b."match_id",e."match_id")     AS "match_id",
                 COALESCE(b."innings_no",e."innings_no") AS "innings_no",
                 COALESCE(b."over_id",e."over_id")       AS "over_id",
                 COALESCE(b."bat_runs",0)+COALESCE(e."extra_runs",0) AS "total_runs"
          FROM (SELECT "match_id","innings_no","over_id",
                       SUM("runs_scored") AS "bat_runs"
                FROM IPL.IPL.BATSMAN_SCORED
                GROUP BY "match_id","innings_no","over_id") b
          FULL JOIN (SELECT "match_id","innings_no","over_id",
                            SUM("extra_runs") AS "extra_runs"
                     FROM IPL.IPL.EXTRA_RUNS
                     GROUP BY "match_id","innings_no","over_id") e
                ON b."match_id"  = e."match_id"
               AND b."innings_no"= e."innings_no"
               AND b."over_id"   = e."over_id"
     ) c
) t
WHERE t."rn" = 1
LIMIT 20;
```

```sql
--Description: attach bowler (first bowler of that over) to each match’s
--             highest-scoring over, sample 20 matches  
SELECT h."match_id",
       h."innings_no",
       h."over_id",
       h."total_runs",
       MIN(bbb."bowler") AS "bowler_id"
FROM (
     SELECT c.*,
            ROW_NUMBER() OVER (PARTITION BY c."match_id"
                               ORDER BY c."total_runs" DESC) AS "rn"
     FROM (
          SELECT COALESCE(b."match_id",e."match_id")     AS "match_id",
                 COALESCE(b."innings_no",e."innings_no") AS "innings_no",
                 COALESCE(b."over_id",e."over_id")       AS "over_id",
                 COALESCE(b."bat_runs",0)+COALESCE(e."extra_runs",0) AS "total_runs"
          FROM (SELECT "match_id","innings_no","over_id",
                       SUM("runs_scored") AS "bat_runs"
                FROM IPL.IPL.BATSMAN_SCORED
                GROUP BY "match_id","innings_no","over_id") b
          FULL JOIN (SELECT "match_id","innings_no","over_id",
                            SUM("extra_runs") AS "extra_runs"
                     FROM IPL.IPL.EXTRA_RUNS
                     GROUP BY "match_id","innings_no","over_id") e
                ON b."match_id"  = e."match_id"
               AND b."innings_no"= e."innings_no"
               AND b."over_id"   = e."over_id"
     ) c
) h
JOIN IPL.IPL.BALL_BY_BALL bbb
  ON h."match_id"  = bbb."match_id"
 AND h."innings_no"= bbb."innings_no"
 AND h."over_id"   = bbb."over_id"
WHERE h."rn" = 1
GROUP BY h."match_id",h."innings_no",h."over_id",h."total_runs"
LIMIT 20;
```

```sql
--Description: look up bowler names for those overs (sample 20)  
SELECT ho."match_id",
       ho."over_id",
       ho."innings_no",
       ho."total_runs",
       ho."bowler_id",
       p."player_name"
FROM (
     SELECT h."match_id",
            h."innings_no",
            h."over_id",
            h."total_runs",
            MIN(bbb."bowler") AS "bowler_id"
     FROM (
          SELECT c.*,
                 ROW_NUMBER() OVER (PARTITION BY c."match_id"
                                    ORDER BY c."total_runs" DESC) AS "rn"
          FROM (
               SELECT COALESCE(b."match_id",e."match_id")     AS "match_id",
                      COALESCE(b."innings_no",e."innings_no") AS "innings_no",
                      COALESCE(b."over_id",e."over_id")       AS "over_id",
                      COALESCE(b."bat_runs",0)+COALESCE(e."extra_runs",0) AS "total_runs"
               FROM (SELECT "match_id","innings_no","over_id",
                            SUM("runs_scored") AS "bat_runs"
                     FROM IPL.IPL.BATSMAN_SCORED
                     GROUP BY "match_id","innings_no","over_id") b
               FULL JOIN (SELECT "match_id","innings_no","over_id",
                                 SUM("extra_runs") AS "extra_runs"
                          FROM IPL.IPL.EXTRA_RUNS
                          GROUP BY "match_id","innings_no","over_id") e
                     ON b."match_id"  = e."match_id"
                    AND b."innings_no"= e."innings_no"
                    AND b."over_id"   = e."over_id"
          ) c
     ) h
     JOIN IPL.IPL.BALL_BY_BALL bbb
       ON h."match_id"  = bbb."match_id"
      AND h."innings_no"= bbb."innings_no"
      AND h."over_id"   = bbb."over_id"
     WHERE h."rn" = 1
     GROUP BY h."match_id",h."innings_no",h."over_id",h."total_runs"
) ho
LEFT JOIN IPL.IPL.PLAYER p
  ON ho."bowler_id" = p."player_id"
LIMIT 20;
```

```sql
--Description: compute (for the whole dataset) the average of each match’s
--             single highest-scoring over  
SELECT AVG("max_over_runs") AS "avg_highest_over_runs"
FROM (
     SELECT c."match_id",
            MAX(c."total_runs") AS "max_over_runs"
     FROM (
          SELECT COALESCE(b."match_id",e."match_id")     AS "match_id",
                 COALESCE(b."innings_no",e."innings_no") AS "innings_no",
                 COALESCE(b."over_id",e."over_id")       AS "over_id",
                 COALESCE(b."bat_runs",0)+COALESCE(e."extra_runs",0) AS "total_runs"
          FROM (SELECT "match_id","innings_no","over_id",
                       SUM("runs_scored") AS "bat_runs"
                FROM IPL.IPL.BATSMAN_SCORED
                GROUP BY "match_id","innings_no","over_id") b
          FULL JOIN (SELECT "match_id","innings_no","over_id",
                            SUM("extra_runs") AS "extra_runs"
                     FROM IPL.IPL.EXTRA_RUNS
                     GROUP BY "match_id","innings_no","over_id") e
                ON b."match_id"  = e."match_id"
               AND b."innings_no"= e."innings_no"
               AND b."over_id"   = e."over_id"
     ) c
     GROUP BY c."match_id"
) 
LIMIT 20;
```

```sql
--Description: full end-to-end query: highest-scoring over per match with bowler
--             name plus an overall average (display first 20 rows of detail)  
WITH bat AS (
     SELECT "match_id","innings_no","over_id",
            SUM("runs_scored") AS "bat_runs"
     FROM IPL.IPL.BATSMAN_SCORED
     GROUP BY "match_id","innings_no","over_id"
),
ext AS (
     SELECT "match_id","innings_no","over_id",
            SUM("extra_runs") AS "extra_runs"
     FROM IPL.IPL.EXTRA_RUNS
     GROUP BY "match_id","innings_no","over_id"
),
comb AS (
     SELECT COALESCE(b."match_id",e."match_id")     AS "match_id",
            COALESCE(b."innings_no",e."innings_no") AS "innings_no",
            COALESCE(b."over_id",e."over_id")       AS "over_id",
            COALESCE(b."bat_runs",0)+COALESCE(e."extra_runs",0) AS "total_runs"
     FROM bat b
     FULL JOIN ext e
       ON b."match_id"  = e."match_id"
      AND b."innings_no"= e."innings_no"
      AND b."over_id"   = e."over_id"
),
ranked AS (
     SELECT comb.*,
            ROW_NUMBER() OVER (PARTITION BY "match_id"
                               ORDER BY "total_runs" DESC) AS "rn"
     FROM comb
),
top_over AS (
     SELECT *
     FROM ranked
     WHERE "rn" = 1
),
with_bowler AS (
     SELECT t."match_id",
            t."innings_no",
            t."over_id",
            t."total_runs",
            MIN(bbb."bowler") AS "bowler_id"
     FROM top_over t
     JOIN IPL.IPL.BALL_BY_BALL bbb
       ON t."match_id"  = bbb."match_id"
      AND t."innings_no"= bbb."innings_no"
      AND t."over_id"   = bbb."over_id"
     GROUP BY t."match_id",t."innings_no",t."over_id",t."total_runs"
),
detailed AS (
     SELECT wb.*,
            p."player_name"
     FROM with_bowler wb
     LEFT JOIN IPL.IPL.PLAYER p
       ON wb."bowler_id" = p."player_id"
),
overall_avg AS (
     SELECT AVG("total_runs") AS "avg_highest_over_runs"
     FROM detailed
)
SELECT d.*,
       o."avg_highest_over_runs"
FROM detailed d
CROSS JOIN overall_avg o
LIMIT 20;
```
