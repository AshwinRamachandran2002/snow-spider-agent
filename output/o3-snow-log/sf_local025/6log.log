Query:
--Description: attach bowler (first bowler of that over) to each match’s
--             highest-scoring over, sample 20 matches  
SELECT h."match_id",
       h."innings_no",
       h."over_id",
       h."total_runs",
       MIN(bbb."bowler") AS "bowler_id"
FROM (
     SELECT c.*,
            ROW_NUMBER() OVER (PARTITION BY c."match_id"
                               ORDER BY c."total_runs" DESC) AS "rn"
     FROM (
          SELECT COALESCE(b."match_id",e."match_id")     AS "match_id",
                 COALESCE(b."innings_no",e."innings_no") AS "innings_no",
                 COALESCE(b."over_id",e."over_id")       AS "over_id",
                 COALESCE(b."bat_runs",0)+COALESCE(e."extra_runs",0) AS "total_runs"
          FROM (SELECT "match_id","innings_no","over_id",
                       SUM("runs_scored") AS "bat_runs"
                FROM IPL.IPL.BATSMAN_SCORED
                GROUP BY "match_id","innings_no","over_id") b
          FULL JOIN (SELECT "match_id","innings_no","over_id",
                            SUM("extra_runs") AS "extra_runs"
                     FROM IPL.IPL.EXTRA_RUNS
                     GROUP BY "match_id","innings_no","over_id") e
                ON b."match_id"  = e."match_id"
               AND b."innings_no"= e."innings_no"
               AND b."over_id"   = e."over_id"
     ) c
) h
JOIN IPL.IPL.BALL_BY_BALL bbb
  ON h."match_id"  = bbb."match_id"
 AND h."innings_no"= bbb."innings_no"
 AND h."over_id"   = bbb."over_id"
WHERE h."rn" = 1
GROUP BY h."match_id",h."innings_no",h."over_id",h."total_runs"
LIMIT 20;
