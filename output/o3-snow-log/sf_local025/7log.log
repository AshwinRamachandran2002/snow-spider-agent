WITH over_max AS (
  /* same logic as previous step */
  SELECT *
  FROM (
    SELECT  ot.*,
            ROW_NUMBER() OVER (PARTITION BY ot."match_id", ot."innings_no"
                               ORDER BY ot."runs_in_over" DESC) AS rn
    FROM (
      SELECT  b."match_id",
              b."innings_no",
              b."over_id",
