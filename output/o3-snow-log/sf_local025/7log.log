```sql
--Description: 1) Peek at a few matches to understand basic identifiers.
SELECT DISTINCT "match_id", "team_1", "team_2", "season_id"
FROM "IPL"."IPL"."MATCH"
LIMIT 20;
```

```sql
--Description: 2) Look at how runs scored by batsmen are stored – one row per ball.
SELECT "match_id", "innings_no", "over_id", "ball_id", "runs_scored"
FROM "IPL"."IPL"."BATSMAN_SCORED"
ORDER BY "match_id", "innings_no", "over_id", "ball_id"
LIMIT 20;
```

```sql
--Description: 3) Inspect extra-runs data to see the additional run types per ball.
SELECT "match_id", "innings_no", "over_id", "ball_id",
       "extra_type", "extra_runs"
FROM "IPL"."IPL"."EXTRA_RUNS"
ORDER BY "match_id", "innings_no", "over_id", "ball_id"
LIMIT 20;
```

```sql
--Description: 4) Review ball-by-ball table to locate bowler (needed later for top-scoring over).
SELECT "match_id", "innings_no", "over_id", "ball_id",
       "team_bowling", "bowler"
FROM "IPL"."IPL"."BALL_BY_BALL"
ORDER BY "match_id", "innings_no", "over_id", "ball_id"
LIMIT 20;
```

```sql
--Description: 5) Combine batsman runs + extra runs for a single match (e.g., first 1 found)  
--   to examine total runs per ball.
SELECT b."match_id", b."innings_no", b."over_id", b."ball_id",
       b."runs_scored"            AS "bat_runs",
       COALESCE(e."extra_runs",0) AS "extra_runs",
       b."runs_scored" + COALESCE(e."extra_runs",0) AS "total_runs"
FROM  "IPL"."IPL"."BATSMAN_SCORED" b
LEFT JOIN "IPL"."IPL"."EXTRA_RUNS" e
  ON  b."match_id"   = e."match_id"
  AND b."innings_no" = e."innings_no"
  AND b."over_id"    = e."over_id"
  AND b."ball_id"    = e."ball_id"
WHERE b."match_id" = (SELECT MIN("match_id") FROM "IPL"."IPL"."MATCH")
ORDER BY b."innings_no", b."over_id", b."ball_id"
LIMIT 20;
```

```sql
--Description: 6) Aggregate to get total runs per over (batsman + extras) for every match/innings.
SELECT  b."match_id",
        b."innings_no",
        b."over_id",
        SUM(b."runs_scored" + COALESCE(e."extra_runs",0)) AS "runs_in_over"
FROM "IPL"."IPL"."BATSMAN_SCORED" b
LEFT JOIN "IPL"."IPL"."EXTRA_RUNS" e
  ON  b."match_id"   = e."match_id"
  AND b."innings_no" = e."innings_no"
  AND b."over_id"    = e."over_id"
  AND b."ball_id"    = e."ball_id"
GROUP BY b."match_id", b."innings_no", b."over_id"
ORDER BY "runs_in_over" DESC
LIMIT 20;
```

```sql
--Description: 7) From those per-over totals, isolate the single highest-scoring over  
--   in each match & innings (window function keeps max only).
WITH over_totals AS (
  SELECT  b."match_id",
          b."innings_no",
          b."over_id",
          SUM(b."runs_scored" + COALESCE(e."extra_runs",0)) AS "runs_in_over"
  FROM "IPL"."IPL"."BATSMAN_SCORED" b
  LEFT JOIN "IPL"."IPL"."EXTRA_RUNS" e
    ON  b."match_id"   = e."match_id"
    AND b."innings_no" = e."innings_no"
    AND b."over_id"    = e."over_id"
    AND b."ball_id"    = e."ball_id"
  GROUP BY b."match_id", b."innings_no", b."over_id"
)
SELECT *
FROM (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "match_id", "innings_no"
                            ORDER BY "runs_in_over" DESC) AS rn
  FROM over_totals
) t
WHERE rn = 1
ORDER BY "runs_in_over" DESC
LIMIT 20;
```

```sql
--Description: 8) Attach the bowler responsible for those top overs  
--   (take first ball’s bowler in that over as representative).
WITH over_max AS (
  /* same logic as previous step */
  SELECT *
  FROM (
    SELECT  ot.*,
            ROW_NUMBER() OVER (PARTITION BY ot."match_id", ot."innings_no"
                               ORDER BY ot."runs_in_over" DESC) AS rn
    FROM (
      SELECT  b."match_id",
              b."innings_no",
              b."over_id",
              SUM(b."runs_scored" + COALESCE(e."extra_runs",0)) AS "runs_in_over"
      FROM "IPL"."IPL"."BATSMAN_SCORED" b
      LEFT JOIN "IPL"."IPL"."EXTRA_RUNS" e
        ON  b."match_id"   = e."match_id"
        AND b."innings_no" = e."innings_no"
        AND b."over_id"    = e."over_id"
        AND b."ball_id"    = e."ball_id"
      GROUP BY b."match_id", b."innings_no", b."over_id"
    ) ot
  ) x
  WHERE rn = 1
)
SELECT om."match_id", om."innings_no", om."over_id", om."runs_in_over",
       MIN(bb."bowler") AS "bowler_id"
FROM over_max om
JOIN "IPL"."IPL"."BALL_BY_BALL" bb
  ON bb."match_id"   = om."match_id"
  AND bb."innings_no"= om."innings_no"
  AND bb."over_id"   = om."over_id"
GROUP BY om."match_id", om."innings_no", om."over_id", om."runs_in_over"
ORDER BY om."runs_in_over" DESC
LIMIT 20;
```

```sql
--Description: 9) Compute the average of these highest-over totals across all matches.
WITH over_max AS (
  SELECT  ot.*
  FROM (
    SELECT  b."match_id",
            b."innings_no",
            b."over_id",
            SUM(b."runs_scored" + COALESCE(e."extra_runs",0)) AS "runs_in_over",
            ROW_NUMBER() OVER (PARTITION BY b."match_id", b."innings_no"
                               ORDER BY SUM(b."runs_scored" + COALESCE(e."extra_runs",0)) DESC) AS rn
    FROM "IPL"."IPL"."BATSMAN_SCORED" b
    LEFT JOIN "IPL"."IPL"."EXTRA_RUNS" e
      ON  b."match_id"   = e."match_id"
      AND b."innings_no" = e."innings_no"
      AND b."over_id"    = e."over_id"
      AND b."ball_id"    = e."ball_id"
    GROUP BY b."match_id", b."innings_no", b."over_id"
  ) ot
  WHERE rn = 1
)
SELECT AVG("runs_in_over") AS "avg_highest_over_runs"
FROM over_max;
```

```sql
--Description: 10) (Optional insight) Show top 10 most expensive overs ever,  
--   enriched with bowler & season for context.
WITH over_totals AS (
  SELECT  b."match_id",
          m."season_id",
          b."innings_no",
          b."over_id",
          SUM(b."runs_scored" + COALESCE(e."extra_runs",0)) AS "runs_in_over"
  FROM "IPL"."IPL"."BATSMAN_SCORED" b
  LEFT JOIN "IPL"."IPL"."EXTRA_RUNS" e
    ON  b."match_id"   = e."match_id"
    AND b."innings_no" = e."innings_no"
    AND b."over_id"    = e."over_id"
    AND b."ball_id"    = e."ball_id"
  JOIN "IPL"."IPL"."MATCH" m
    ON m."match_id" = b."match_id"
  GROUP BY b."match_id", m."season_id", b."innings_no", b."over_id"
),
over_top AS (
  SELECT *
  FROM over_totals
  ORDER BY "runs_in_over" DESC
  LIMIT 10
)
SELECT ot.*,
       MIN(bb."bowler") AS "bowler_id"
FROM over_top ot
JOIN "IPL"."IPL"."BALL_BY_BALL" bb
  ON bb."match_id" = ot."match_id"
  AND bb."innings_no" = ot."innings_no"
  AND bb."over_id" = ot."over_id"
GROUP BY ot."match_id", ot."season_id", ot."innings_no", ot."over_id", ot."runs_in_over"
ORDER BY ot."runs_in_over" DESC;
```
