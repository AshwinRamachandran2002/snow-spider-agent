```sql
--Description: Preview first 20 rows from the BATTING table to understand the available batting statistics.
SELECT *
FROM "BASEBALL"."BASEBALL"."BATTING"
LIMIT 20;
```

```sql
--Description: List 20 distinct team IDs that appear in the BATTING table.
SELECT DISTINCT "team_id"
FROM "BASEBALL"."BASEBALL"."BATTING"
LIMIT 20;
```

```sql
--Description: Display 20 distinct player-IDs together with the first/last names pulled from the PLAYER table.
SELECT DISTINCT b."player_id",
       p."name_first",
       p."name_last"
FROM "BASEBALL"."BASEBALL"."BATTING" b
JOIN "BASEBALL"."BASEBALL"."PLAYER"  p
  ON b."player_id" = p."player_id"
LIMIT 20;
```

```sql
--Description: Show 20 examples of players with their year, at-bats (AB) and hits (H).
SELECT b."player_id",
       b."year",
       b."ab",
       b."h"
FROM "BASEBALL"."BASEBALL"."BATTING" b
ORDER BY b."year" ASC
LIMIT 20;
```

```sql
--Description: Retrieve the top 20 player-seasons with the most home runs (HR) recorded in BATTING.
SELECT b."player_id",
       b."year",
       b."team_id",
       b."hr"::INTEGER AS "home_runs"
FROM "BASEBALL"."BASEBALL"."BATTING" b
WHERE b."hr" IS NOT NULL
ORDER BY "home_runs" DESC
LIMIT 20;
```

```sql
--Description: Aggregate total home runs by player (all seasons combined) and show the top 20 hitters.
SELECT b."player_id",
       SUM(b."hr"::INTEGER) AS "total_hr"
FROM "BASEBALL"."BASEBALL"."BATTING" b
WHERE b."hr" IS NOT NULL
GROUP BY b."player_id"
ORDER BY "total_hr" DESC
LIMIT 20;
```

```sql
--Description: For 20 random players, pull core batting slash-line stats together with their given first/last names.
SELECT b."player_id",
       p."name_first",
       p."name_last",
       b."year",
       b."ab",
       b."h",
       b."bb",
       b."so"
FROM "BASEBALL"."BASEBALL"."BATTING" b
JOIN "BASEBALL"."BASEBALL"."PLAYER"  p
  ON b."player_id" = p."player_id"
ORDER BY RANDOM()
LIMIT 20;
```

```sql
--Description: Count how many batting records exist for each season and show the first 20 season counts.
SELECT b."year",
       COUNT(*) AS "records_this_year"
FROM "BASEBALL"."BASEBALL"."BATTING" b
GROUP BY b."year"
ORDER BY b."year"
LIMIT 20;
```

```sql
--Description: Display 20 rows where players have at least 50 stolen bases (SB) to find prolific base stealers.
SELECT b."player_id",
       b."year",
       b."team_id",
       b."sb"::INTEGER AS "stolen_bases"
FROM "BASEBALL"."BASEBALL"."BATTING" b
WHERE b."sb"::INTEGER >= 50
ORDER BY b."sb"::INTEGER DESC
LIMIT 20;
```

```sql
--Description: Join PLAYER and BATTING to show 20 players born in the USA with at least 30 doubles in a season.
SELECT b."player_id",
       p."name_first",
       p."name_last",
       b."year",
       b."double"::INTEGER AS "doubles"
FROM "BASEBALL"."BASEBALL"."BATTING" b
JOIN "BASEBALL"."BASEBALL"."PLAYER"  p
  ON b."player_id" = p."player_id"
WHERE p."birth_country" = 'USA'
  AND b."double"::INTEGER >= 30
LIMIT 20;
```
