WITH all_pitches AS (      -- combine regular-season & post-season pitches
    SELECT "GAME_ID",
           "PITCHER_ID",
           "PITCH_SPEED"::NUMBER AS "PITCH_SPEED"
    FROM "BASEBALL"."BASEBALL"."PITCH"            -- regular season
    WHERE "PITCH_SPEED"::NUMBER > 0

    UNION ALL

    SELECT "GAME_ID",
           "PITCHER_ID",
           "PITCH_SPEED"::NUMBER AS "PITCH_SPEED"
    FROM "BASEBALL"."BASEBALL"."PITCH_POSTSEASON" -- post-season
    WHERE "PITCH_SPEED"::NUMBER > 0
),

games AS (                -- identify home/away clubs & rosters
    SELECT  "GAME_ID",
            "HOME_TEAM_ID",
            "AWAY_TEAM_ID",
            "HOME_PLAYER_IDS",    -- VARIANT / ARRAY  of player-ids
            "AWAY_PLAYER_IDS"
    FROM    "BASEBALL"."BASEBALL"."GAMES"
),

/* ---------- pitches confirmed for the HOME side -------------------------- */
home_side AS (
    SELECT  p."PITCHER_ID",
            g."HOME_TEAM_ID" AS "TEAM_ID",
            p."PITCH_SPEED"
    FROM    all_pitches  p
    JOIN    games        g  ON p."GAME_ID" = g."GAME_ID"
    JOIN    LATERAL FLATTEN (INPUT => g."HOME_PLAYER_IDS") hp
            ON hp.VALUE::STRING = p."PITCHER_ID"
),

/* ---------- pitches confirmed for the AWAY side -------------------------- */
away_side AS (
    SELECT  p."PITCHER_ID",
            g."AWAY_TEAM_ID" AS "TEAM_ID",
            p."PITCH_SPEED"
    FROM    all_pitches  p
    JOIN    games        g  ON p."GAME_ID" = g."GAME_ID"
    JOIN    LATERAL FLATTEN (INPUT => g."AWAY_PLAYER_IDS") ap
            ON ap.VALUE::STRING = p."PITCHER_ID"
),

/* ---------- every valid (team , pitcher , speed) ------------------------- */
team_pitches AS (
    SELECT * FROM home_side
    UNION ALL
    SELECT * FROM away_side
),

/* ---------- fastest pitch each pitcher ever threw for that club ---------- */
max_pitch_per_pitcher AS (
    SELECT  "TEAM_ID",
            "PITCHER_ID",
            MAX("PITCH_SPEED") AS "MAX_SPEED"
    FROM    team_pitches
    GROUP BY "TEAM_ID", "PITCHER_ID"
),

/* ---------- rank pitchers inside each club by their max speed ------------ */
ranked AS (
    SELECT  "TEAM_ID",
            "PITCHER_ID",
            "MAX_SPEED",
            ROW_NUMBER() OVER (PARTITION BY "TEAM_ID"
                               ORDER BY "MAX_SPEED" DESC NULLS LAST) AS rn
    FROM    max_pitch_per_pitcher
)

/* ---------- final answer -------------------------------------------------- */
SELECT  r."TEAM_ID",
        (pl."NAME_FIRST" || ' ' || pl."NAME_LAST") AS "PITCHER_FULL_NAME",
        r."MAX_SPEED"
FROM    ranked  r
JOIN    "BASEBALL"."BASEBALL"."PLAYER" pl
          ON pl."PLAYER_ID" = r."PITCHER_ID"
WHERE   r.rn = 1             -- only the top-speed pitcher per team
ORDER BY r."TEAM_ID";
```
