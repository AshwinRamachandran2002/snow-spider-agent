```sql
/*---------------------------------------------------------
  STEP-1 :  Merge regular-season and post-season pitch data
----------------------------------------------------------*/
WITH "ALL_PITCHES" AS (  
     SELECT "GAME_ID",
            "PITCHER_ID",
            "PITCH_SPEED",
            "HOME_TEAM_ID",
            "AWAY_TEAM_ID",
            "HOME_PLAYER_ID",
            "AWAY_PLAYER_ID"
     FROM (              /*-- UNION FIRST,   NO FILTERS INSIDE--*/
           SELECT "GAME_ID","PITCHER_ID","PITCH_SPEED",
                  "HOME_TEAM_ID","AWAY_TEAM_ID",
                  "HOME_PLAYER_ID","AWAY_PLAYER_ID"
           FROM BASEBALL.BASEBALL.PITCH_REGULAR
           UNION ALL
           SELECT "GAME_ID","PITCHER_ID","PITCH_SPEED",
                  "HOME_TEAM_ID","AWAY_TEAM_ID",
                  "HOME_PLAYER_ID","AWAY_PLAYER_ID"
           FROM BASEBALL.BASEBALL.PITCH_POSTSEASON
     )
),
/*----------------------------------------------------------------
  STEP-2 :  Keep only valid pitches (speed > 0) thrown by a player
            who actually appears on the home / away lineup
 ----------------------------------------------------------------*/
"VALIDATED" AS (
     SELECT
            CASE
               WHEN ap."PITCHER_ID" = ap."HOME_PLAYER_ID" THEN ap."HOME_TEAM_ID"
               WHEN ap."PITCHER_ID" = ap."AWAY_PLAYER_ID" THEN ap."AWAY_TEAM_ID"
            END                                               AS "TEAM_ID",
            ap."PITCHER_ID",
            TRY_TO_NUMBER(ap."PITCH_SPEED")                   AS "PITCH_SPEED"
     FROM  "ALL_PITCHES" ap
     WHERE TRY_TO_NUMBER(ap."PITCH_SPEED") > 0
       AND (ap."PITCHER_ID" = ap."HOME_PLAYER_ID"
            OR ap."PITCHER_ID" = ap."AWAY_PLAYER_ID")
),
/*----------------------------------------------------------------
  STEP-3 :  For every pitcher / team, find his personal maximum
 ----------------------------------------------------------------*/
"MAX_BY_PITCHER" AS (
     SELECT  "TEAM_ID",
             "PITCHER_ID",
             MAX("PITCH_SPEED")  AS "MAX_SPEED"
     FROM    "VALIDATED"
     GROUP BY "TEAM_ID","PITCHER_ID"
),
/*----------------------------------------------------------------
  STEP-4 :  Per team, keep the single fastest pitcher
 ----------------------------------------------------------------*/
"FASTEST_PER_TEAM" AS (
     SELECT  "TEAM_ID",
             "PITCHER_ID",
             "MAX_SPEED",
             ROW_NUMBER() OVER (PARTITION BY "TEAM_ID"
                                ORDER BY "MAX_SPEED" DESC NULLS LAST) AS "RN"
     FROM    "MAX_BY_PITCHER"
)
/*----------------------------------------------------------------
  STEP-5 :  Return pitcher’s full name + top speed for each team
 ----------------------------------------------------------------*/
SELECT   f."TEAM_ID",
         p."NAME_FIRST" || ' ' || p."NAME_LAST"          AS "PITCHER_NAME",
         TO_DECIMAL(f."MAX_SPEED",10,4)                 AS "MAX_VALID_PITCH_SPEED"
FROM     "FASTEST_PER_TEAM"  f
JOIN     BASEBALL.BASEBALL.PLAYER  p
       ON p."PLAYER_ID" = f."PITCHER_ID"
WHERE    f."RN" = 1
ORDER BY f."MAX_VALID_PITCH_SPEED" DESC NULLS LAST;
```
