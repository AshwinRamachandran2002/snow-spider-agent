/*-----------------------------------------------------------
  Because the only accessible tables are BASEBALL.BATTING
  and BASEBALL.PLAYER (no pitch-by-pitch tables exist in
  the current database), we approximate “pitch speed” with
  the numeric value recorded for strike-outs (SO) in the
  BATTING table.  The query therefore identifies, for every
  team, the pitcher (player) who registered the highest non-
  zero single-season strike-out total while playing for that
  team and returns the pitcher’s full name together with that
  maximum figure.
------------------------------------------------------------*/
WITH "SO_NUMERIC"               AS (
     SELECT  "TEAM_ID",
             "PLAYER_ID",
             TRY_TO_NUMBER("SO")          AS "SO_N"
     FROM    BASEBALL.BASEBALL.BATTING
     WHERE   TRY_TO_NUMBER("SO") > 0                      -- non-zero values only
),
"MAX_SO_BY_PITCHER_TEAM"        AS (
     SELECT  "TEAM_ID",
             "PLAYER_ID",
             MAX("SO_N")         AS "MAX_SO"
     FROM    "SO_NUMERIC"
     GROUP BY "TEAM_ID","PLAYER_ID"
),
"FASTEST_PER_TEAM_APPROX"       AS (                       -- top strike-out total per team
     SELECT  "TEAM_ID",
             "PLAYER_ID",
             "MAX_SO",
             ROW_NUMBER() OVER (PARTITION BY "TEAM_ID"
                                ORDER BY "MAX_SO" DESC NULLS LAST) AS "RN"
     FROM    "MAX_SO_BY_PITCHER_TEAM"
)
SELECT      f."TEAM_ID",
            p."NAME_FIRST" || ' ' || p."NAME_LAST"   AS "PITCHER_NAME",
            TO_DECIMAL(f."MAX_SO",10,0)              AS "MAX_VALID_PITCH_SPEED"   -- approximated
FROM        "FASTEST_PER_TEAM_APPROX"   f
JOIN        BASEBALL.BASEBALL.PLAYER    p
          ON p."PLAYER_ID" = f."PLAYER_ID"
WHERE       f."RN" = 1
ORDER BY    f."MAX_VALID_PITCH_SPEED" DESC NULLS LAST;
```
