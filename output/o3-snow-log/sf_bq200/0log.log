```sql
--Description: Show 20 different teams (team_id) that have records in BATTING
SELECT DISTINCT "team_id"
FROM BASEBALL.BASEBALL.BATTING
LIMIT 20;
```

```sql
--Description: Retrieve 20 sample rows of players’ basic batting totals
SELECT "player_id", "year", "team_id", "ab", "h", "hr", "rbi"
FROM BASEBALL.BASEBALL.BATTING
LIMIT 20;
```

```sql
--Description: Find 20 players who hit at least one home run (hr > '0')
SELECT "player_id", "year", "team_id", "hr"
FROM BASEBALL.BASEBALL.BATTING
WHERE "hr" > '0'
LIMIT 20;
```

```sql
--Description: Show 20 rows of batting records joined with the PLAYER table to get first & last names
SELECT b."player_id", p."name_first", p."name_last", b."year", b."team_id", b."ab", b."h"
FROM BASEBALL.BASEBALL.BATTING  b
JOIN BASEBALL.BASEBALL.PLAYER p
      ON b."player_id" = p."player_id"
LIMIT 20;
```

```sql
--Description: Retrieve 20 players (with names) who batted right-handed according to the PLAYER table
SELECT p."player_id", p."name_first", p."name_last", p."bats"
FROM BASEBALL.BASEBALL.PLAYER p
WHERE p."bats" = 'R'
LIMIT 20;
```

```sql
--Description: Show 20 sample pitchers (throws = 'R' or 'L') together with their batting rows (if any)
SELECT p."player_id", p."name_first", p."name_last", p."throws", b."year", b."team_id"
FROM BASEBALL.BASEBALL.PLAYER p
LEFT JOIN BASEBALL.BASEBALL.BATTING b
       ON p."player_id" = b."player_id"
WHERE p."throws" IN ('R','L')
LIMIT 20;
```

```sql
--Description: Display 20 rows of players born in Alabama (birth_state = 'AL')
SELECT "player_id", "name_first", "name_last", "birth_city", "birth_state", "birth_year"
FROM BASEBALL.BASEBALL.PLAYER
WHERE "birth_state" = 'AL'
LIMIT 20;
```

```sql
--Description: Get each player’s single-season maximum home-run total (show 20 results)
SELECT "player_id",
       MAX(CAST("hr" AS INTEGER)) AS "max_hr"
FROM BASEBALL.BASEBALL.BATTING
GROUP BY "player_id"
LIMIT 20;
```

```sql
--Description: Retrieve 20 batting records from the 1961 season for a quick look
SELECT "player_id", "team_id", "ab", "h", "hr", "rbi"
FROM BASEBALL.BASEBALL.BATTING
WHERE "year" = 1961
LIMIT 20;
```
