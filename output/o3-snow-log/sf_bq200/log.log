2025-05-07 06:09:40 - Thread-293 (execute) - INFO - [Try to run SQL in self-refine]
```sql
/* ----------------------------------------------------------------------------
   For every franchise, get the single fastest *valid* ( > 0 ) pitch that any
   of its pitchers threw in either the regular season or the post-season, then
   return the pitcher’s full name together with that top speed.
---------------------------------------------------------------------------- */

WITH ALL_PITCHES AS (          -- 1.  Regular-season + Post-season pitches
    SELECT
        "PITCHER_ID"                  AS "PITCHER_ID",
        "TEAM_ID"                     AS "TEAM_ID",
        "PITCH_SPEED"                 AS "PITCH_SPEED"
    FROM BASEBALL.BASEBALL."PITCH"            -- regular season
    WHERE "PITCH_SPEED" > 0                              -- ignore zero / null
                                                          
    UNION ALL                                            -- +
                                                          
    SELECT
        "PITCHER_ID",
        "TEAM_ID",
        "PITCH_SPEED"
    FROM BASEBALL.BASEBALL."PITCH_POST"       -- post-season
    WHERE "PITCH_SPEED" > 0
),

MAX_SPEED_PER_PITCHER AS (      -- 2.  Each pitcher’s top speed for a team
    SELECT
        "TEAM_ID",
        "PITCHER_ID",
        MAX("PITCH_SPEED") AS "MAX_SPEED"
    FROM ALL_PITCHES
    GROUP BY "TEAM_ID", "PITCHER_ID"
),

MAX_SPEED_PER_TEAM AS (         -- 3.  Pick the fastest pitcher per team
    SELECT
        "TEAM_ID",
        "PITCHER_ID",
        "MAX_SPEED",
        ROW_NUMBER() OVER (PARTITION BY "TEAM_ID"
                           ORDER BY "MAX_SPEED" DESC) AS "RN"
    FROM MAX_SPEED_PER_PITCHER
)

SELECT                           -- 4.  Add full name and present the answer
    m."TEAM_ID",
    CONCAT(p."NAME_FIRST", ' ', p."NAME_LAST") AS "PITCHER_FULL_NAME",
    m."MAX_SPEED"                                 AS "MAX_VALID_PITCH_SPEED"
FROM MAX_SPEED_PER_TEAM  m
JOIN BASEBALL.BASEBALL."PLAYER" p
      ON m."PITCHER_ID" = p."PLAYER_ID"
WHERE m."RN" = 1                                 -- fastest per franchise
ORDER BY m."MAX_SPEED" DESC NULLS LAST;          -- show hardest throwers first
```
