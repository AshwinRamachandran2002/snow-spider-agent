```sql
--Description: Inspect a handful of raw pitch-by-pitch records (both regular-season and post-season) to see the columns that hold pitch speed, player, game and team information. 
SELECT * 
FROM BASEBALL.BASEBALL."PITCHES"          -- raw pitch-level table
LIMIT 20;
```

```sql
--Description:  Take a quick look at the “GAMES” table to understand how home/away teams and the lists of participating players are recorded. 
SELECT * 
FROM BASEBALL.BASEBALL."GAMES"            -- game-level information
LIMIT 20;
```

```sql
--Description:  List every distinct club that appears in the pitch-by-pitch data.  
SELECT DISTINCT "team_id"
FROM BASEBALL.BASEBALL."PITCHES"
LIMIT 20;
```

```sql
--Description:  Pull every (team, player) pair that ever registered a non-zero pitch speed; this trims away pick-offs, pitch-outs or data-entry zeros. 
SELECT DISTINCT 
       "team_id",
       "player_id"
FROM   BASEBALL.BASEBALL."PITCHES"
WHERE  "pitch_speed" > 0
LIMIT 20;
```

```sql
--Description:  Display the 20 fastest individual pitches on record, together with the club and pitcher who threw them.  
SELECT 
       "game_id",
       "player_id",
       "team_id",
       "pitch_speed"
FROM   BASEBALL.BASEBALL."PITCHES"
WHERE  "pitch_speed" > 0
ORDER  BY "pitch_speed" DESC
LIMIT 20;
```

```sql
--Description:  Compute the maximum non-zero pitch speed logged for every team (regular season + post-season).  
SELECT 
       "team_id",
       MAX("pitch_speed") AS "max_pitch_speed"
FROM   BASEBALL.BASEBALL."PITCHES"
WHERE  "pitch_speed" > 0
GROUP  BY "team_id"
LIMIT 20;
```

```sql
--Description:  Use a window function to keep only those (team, player) rows whose pitch speed equals the club’s maximum.  
SELECT
       "team_id",
       "player_id",
       "pitch_speed" AS "max_pitch_speed"
FROM  (
        SELECT 
               "team_id",
               "player_id",
               "pitch_speed",
               RANK() OVER (PARTITION BY "team_id" ORDER BY "pitch_speed" DESC) AS rk
        FROM   BASEBALL.BASEBALL."PITCHES"
        WHERE  "pitch_speed" > 0
      ) t
WHERE  rk = 1
LIMIT 20;
```

```sql
--Description:  Join to the seasonal roster (BATTING table) just to verify that each identified pitcher actually appeared for that club in the corresponding season.  
SELECT DISTINCT
       p."team_id",
       p."player_id",
       p."max_pitch_speed"
FROM  (
        SELECT
               "team_id",
               "player_id",
               MAX("pitch_speed") AS "max_pitch_speed"
        FROM   BASEBALL.BASEBALL."PITCHES"
        WHERE  "pitch_speed" > 0
        GROUP  BY "team_id","player_id"
      )  p
JOIN  BASEBALL.BASEBALL."BATTING" b
      ON  b."player_id" = p."player_id"
      AND b."team_id"   = p."team_id"
LIMIT 20;
```

```sql
--Description:  Attach the pitcher’s first and last names from the master PLAYER table.  
SELECT 
       v."team_id",
       pl."name_first"  || ' ' || pl."name_last"  AS "pitcher_name",
       v."max_pitch_speed"
FROM  (
        SELECT
               "team_id",
               "player_id",
               MAX("pitch_speed") AS "max_pitch_speed"
        FROM   BASEBALL.BASEBALL."PITCHES"
        WHERE  "pitch_speed" > 0
        GROUP  BY "team_id","player_id"
      ) v
JOIN  BASEBALL.BASEBALL."PLAYER" pl
      ON  pl."player_id" = v."player_id"
LIMIT 20;
```

```sql
--Description:  Final answer – for every franchise, return the pitcher’s full name together with the highest valid pitch speed he recorded while on that club (regular or post-season). 
SELECT 
       v."team_id",
       pl."name_first"  || ' ' || pl."name_last"  AS "pitcher_name",
       v."max_pitch_speed"
FROM  (
        SELECT
               "team_id",
               "player_id",
               MAX("pitch_speed") AS "max_pitch_speed"
        FROM   BASEBALL.BASEBALL."PITCHES"
        WHERE  "pitch_speed" > 0
        GROUP  BY "team_id","player_id"
        QUALIFY ROW_NUMBER() OVER (PARTITION BY "team_id" 
                                   ORDER BY MAX("pitch_speed") DESC) = 1
      ) v
JOIN  BASEBALL.BASEBALL."PLAYER" pl
      ON  pl."player_id" = v."player_id"
LIMIT 20;
```
