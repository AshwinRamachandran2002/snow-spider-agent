--Description: Join batting with player bio data to add full names to single-season home-run totals, using TRY_TO_NUMBER to avoid cast errors on blank strings.
SELECT  b."PLAYER_ID",
        p."NAME_FIRST" || ' ' || p."NAME_LAST" AS "FULL_NAME",
        b."TEAM_ID",
        b."YEAR",
        TRY_TO_NUMBER(b."HR") AS "HOME_RUNS"
FROM    "BASEBALL"."BASEBALL"."BATTING"  b
JOIN    "BASEBALL"."BASEBALL"."PLAYER"   p
      ON b."PLAYER_ID" = p."PLAYER_ID"
WHERE   TRY_TO_NUMBER(b."HR") IS NOT NULL
