/* ------------------------------------------------------------
   1. Combine regular- and post-season pitch-by-pitch data
   2. Keep only non-null / non-zero speeds
   3. Verify the pitcher is on the correct roster and
      derive the team he pitched for in that game
   4. Take the fastest pitch each pitcher threw for every team
   5. Pick the single fastest pitcher for every team
   6. Attach the player’s full name
--------------------------------------------------------------*/
WITH ALL_PITCHES AS (                       -- ❶  regular + post
        SELECT  "GAME_ID",
                "PITCHER_ID",
                TRY_TO_NUMBER("PITCH_SPEED") AS "PITCH_SPEED"
        FROM    "BASEBALL"."BASEBALL"."PITCH"          -- regular season

        UNION ALL
        SELECT  "GAME_ID",
                "PITCHER_ID",
                TRY_TO_NUMBER("PITCH_SPEED") AS "PITCH_SPEED"
        FROM    "BASEBALL"."BASEBALL"."PITCH_POST"     -- post-season
),
VALIDATED AS (                               -- ❷ + ❸ roster check
        SELECT
               CASE
                    WHEN POSITION(a."PITCHER_ID" IN g."HOME_PLAYER_IDS") > 0
                         THEN g."HOME_TEAM_ID"
                    ELSE g."AWAY_TEAM_ID"
               END                         AS "TEAM_ID",
               a."PITCHER_ID",
               a."PITCH_SPEED"
        FROM   ALL_PITCHES a
        JOIN   "BASEBALL"."BASEBALL"."GAMES" g
               ON a."GAME_ID" = g."GAME_ID"
        WHERE  a."PITCH_SPEED" IS NOT NULL
          AND  a."PITCH_SPEED" > 0
          AND (  POSITION(a."PITCHER_ID" IN g."HOME_PLAYER_IDS") > 0
               OR POSITION(a."PITCHER_ID" IN g."AWAY_PLAYER_IDS") > 0 )
),
MAX_BY_PITCHER AS (                          -- ❹ fastest per pitcher / team
        SELECT  "TEAM_ID",
                "PITCHER_ID",
                MAX("PITCH_SPEED") AS "MAX_SPEED"
        FROM    VALIDATED
        GROUP BY "TEAM_ID", "PITCHER_ID"
),
TEAM_LEADERS AS (                            -- ❺ fastest pitcher per team
        SELECT  m.*,
                RANK() OVER (PARTITION BY m."TEAM_ID"
                             ORDER BY m."MAX_SPEED" DESC NULLS LAST) AS "RK"
        FROM    MAX_BY_PITCHER m
)
SELECT  tl."TEAM_ID",
        p."NAME_FIRST" || ' ' || p."NAME_LAST" AS "FULL_NAME",
        tl."MAX_SPEED"                          AS "MAX_PITCH_SPEED"
FROM    TEAM_LEADERS tl
JOIN    "BASEBALL"."BASEBALL"."PLAYER" p
          ON tl."PITCHER_ID" = p."PLAYER_ID"
WHERE   tl."RK" = 1
ORDER BY tl."TEAM_ID";
