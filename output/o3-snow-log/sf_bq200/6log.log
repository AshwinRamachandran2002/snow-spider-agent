/* ------------------------------------------------------------
   1.  UNION regular-season and post-season pitch-by-pitch data
   2.  Keep only non–null / non-zero speeds
   3.  Make sure the pitcher really appeared on the correct
       home- or away-roster for that game
   4.  Find the top (fastest) pitch each pitcher threw for every
       team he appeared with
   5.  Pick the single fastest pitcher for every team
   6.  Attach the player’s full name
--------------------------------------------------------------*/
WITH ALL_PITCHES AS (          -- ❶ regular season
        SELECT  pr."GAME_ID",
                pr."PITCHER_ID",
                pr."TEAM_ID",
                TRY_TO_NUMBER(pr."PITCH_SPEED")  AS "PITCH_SPEED"
        FROM    "BASEBALL"."BASEBALL"."PITCHES_REGULAR"  pr

        UNION ALL                -- ❶ post-season
        SELECT  pp."GAME_ID",
                pp."PITCHER_ID",
                pp."TEAM_ID",
                TRY_TO_NUMBER(pp."PITCH_SPEED")  AS "PITCH_SPEED"
        FROM    "BASEBALL"."BASEBALL"."PITCHES_POST"     pp
),
VALIDATED AS (                  -- ❷ + ❸ roster check
        SELECT  a.*
        FROM    ALL_PITCHES a
        JOIN    "BASEBALL"."BASEBALL"."GAMES" g
               ON a."GAME_ID" = g."GAME_ID"
        WHERE   a."PITCH_SPEED" IS NOT NULL
          AND   a."PITCH_SPEED" > 0
          AND ( (a."TEAM_ID" = g."HOME_TEAM_ID"
                  AND POSITION(a."PITCHER_ID" IN g."HOME_PLAYER_IDS") > 0)
             OR  (a."TEAM_ID" = g."AWAY_TEAM_ID"
                  AND POSITION(a."PITCHER_ID" IN g."AWAY_PLAYER_IDS") > 0) )
),
MAX_BY_PITCHER AS (             -- ❹
        SELECT  "TEAM_ID",
                "PITCHER_ID",
                MAX("PITCH_SPEED") AS "MAX_SPEED"
        FROM    VALIDATED
        GROUP BY "TEAM_ID", "PITCHER_ID"
),
TEAM_LEADERS AS (               -- ❺
        SELECT  m.*,
                RANK() OVER (PARTITION BY m."TEAM_ID"
                             ORDER BY m."MAX_SPEED" DESC NULLS LAST) AS "RK"
        FROM    MAX_BY_PITCHER m
)
SELECT  tl."TEAM_ID",
        p."NAME_FIRST" || ' ' || p."NAME_LAST" AS "FULL_NAME",
        tl."MAX_SPEED"                          AS "MAX_PITCH_SPEED"
FROM    TEAM_LEADERS tl
JOIN    "BASEBALL"."BASEBALL"."PLAYER" p
          ON tl."PITCHER_ID" = p."PLAYER_ID"
WHERE   tl."RK" = 1
ORDER BY tl."TEAM_ID";
