```sql
--Description: Preview a handful of raw batting records to understand available columns and example values.  
SELECT *  
FROM "BASEBALL"."BASEBALL"."BATTING"  
LIMIT 20;
```

```sql
--Description: List the distinct team IDs that appear in the batting table (helps gauge the scope of teams).  
SELECT DISTINCT "team_id"  
FROM "BASEBALL"."BASEBALL"."BATTING"  
LIMIT 20;
```

```sql
--Description: Show the distinct seasons that have batting data.  
SELECT DISTINCT "year"  
FROM "BASEBALL"."BASEBALL"."BATTING"  
ORDER BY "year"  
LIMIT 20;
```

```sql
--Description: Retrieve the 20 players who hit the most home runs in a single season (ties broken by year-ascending).  
SELECT "player_id", "team_id", "year", "hr"::INTEGER AS "home_runs"  
FROM "BASEBALL"."BASEBALL"."BATTING"  
WHERE "hr" IS NOT NULL AND "hr" <> ''  
ORDER BY "home_runs" DESC, "year" ASC  
LIMIT 20;
```

```sql
--Description: Join batting with player biographical data to show full names alongside their single-season home-run totals.  
SELECT b."player_id",  
       p."name_first" || ' ' || p."name_last" AS "full_name",  
       b."team_id",  
       b."year",  
       b."hr"::INTEGER AS "home_runs"  
FROM "BASEBALL"."BASEBALL"."BATTING" b  
JOIN "BASEBALL"."BASEBALL"."PLAYER" p  
  ON b."player_id" = p."player_id"  
WHERE b."hr" IS NOT NULL AND b."hr" <> ''  
ORDER BY "home_runs" DESC  
LIMIT 20;
```

```sql
--Description: For each team & year, find the player with the most strikeouts (SO), using a window-function ranking.  
SELECT *  
FROM (  
    SELECT b."team_id",  
           b."year",  
           b."player_id",  
           b."so"::INTEGER AS "strikeouts",  
           RANK() OVER (PARTITION BY b."team_id", b."year" ORDER BY b."so"::INTEGER DESC NULLS LAST) AS "rk"  
    FROM "BASEBALL"."BASEBALL"."BATTING" b  
    WHERE b."so" IS NOT NULL AND b."so" <> ''  
) t  
WHERE t."rk" = 1  
LIMIT 20;
```

```sql
--Description: Pull the full names for the team/year strikeout leaders identified in the previous query.  
SELECT t."team_id",  
       t."year",  
       p."name_first" || ' ' || p."name_last" AS "full_name",  
       t."strikeouts"  
FROM (  
    SELECT b."team_id", b."year", b."player_id", b."so"::INTEGER AS "strikeouts",  
           RANK() OVER (PARTITION BY b."team_id", b."year" ORDER BY b."so"::INTEGER DESC NULLS LAST) AS "rk"  
    FROM "BASEBALL"."BASEBALL"."BATTING" b  
    WHERE b."so" IS NOT NULL AND b."so" <> ''  
) t  
JOIN "BASEBALL"."BASEBALL"."PLAYER" p  
  ON t."player_id" = p."player_id"  
WHERE t."rk" = 1  
LIMIT 20;
```

```sql
--Description: Fetch any players whose last name roughly matches “Johnson” (illustrates fuzzy search).  
SELECT "player_id", "name_first", "name_last"  
FROM "BASEBALL"."BASEBALL"."PLAYER"  
WHERE "name_last" ILIKE '%johns%'  
LIMIT 20;
```

```sql
--Description: Determine the average number of walks (BB) per team per season to understand walk trends.  
SELECT "team_id", "year", AVG("bb"::FLOAT) AS "avg_walks"  
FROM "BASEBALL"."BASEBALL"."BATTING"  
WHERE "bb" IS NOT NULL AND "bb" <> ''  
GROUP BY "team_id", "year"  
ORDER BY "avg_walks" DESC  
LIMIT 20;
```

```sql
--Description: Combine batting & player tables to display, for each team, the single player with the highest RBI total across all seasons.  
WITH team_rbi AS (  
  SELECT b."team_id", b."player_id", MAX(b."rbi"::INTEGER) AS "max_rbi"  
  FROM "BASEBALL"."BASEBALL"."BATTING" b  
  WHERE b."rbi" IS NOT NULL AND b."rbi" <> ''  
  GROUP BY b."team_id", b."player_id"  
), ranked AS (  
  SELECT t.*,  
         RANK() OVER (PARTITION BY t."team_id" ORDER BY t."max_rbi" DESC) AS "rk"  
  FROM team_rbi t  
)  
SELECT r."team_id",  
       p."name_first" || ' ' || p."name_last" AS "full_name",  
       r."max_rbi"  
FROM ranked r  
JOIN "BASEBALL"."BASEBALL"."PLAYER" p  
  ON r."player_id" = p."player_id"  
WHERE r."rk" = 1  
LIMIT 20;
```
