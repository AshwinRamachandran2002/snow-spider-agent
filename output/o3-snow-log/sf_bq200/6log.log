SELECT  t."TEAM_ID",
        t."YEAR",
        p."NAME_FIRST" || ' ' || p."NAME_LAST" AS "FULL_NAME",
        t."STRIKEOUTS"
FROM  (
        SELECT  b."TEAM_ID",
                b."YEAR",
                b."PLAYER_ID",
                TRY_TO_NUMBER(b."SO") AS "STRIKEOUTS",
                RANK() OVER (PARTITION BY b."TEAM_ID", b."YEAR"
                             ORDER BY TRY_TO_NUMBER(b."SO") DESC NULLS LAST) AS "RK"
        FROM    "BASEBALL"."BASEBALL"."BATTING" b
        WHERE   TRY_TO_NUMBER(b."SO") IS NOT NULL
      ) t
