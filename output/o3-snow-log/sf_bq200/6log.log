--Description: For each team, obtain the player with the highest single-season RBI total, converting RBI with TRY_TO_NUMBER for safety.
WITH TEAM_RBI AS (
        SELECT  b."TEAM_ID",
                b."PLAYER_ID",
                MAX(TRY_TO_NUMBER(b."RBI")) AS "MAX_RBI"
        FROM    "BASEBALL"."BASEBALL"."BATTING" b
        WHERE   TRY_TO_NUMBER(b."RBI") IS NOT NULL
        GROUP BY b."TEAM_ID", b."PLAYER_ID"
), RANKED AS (
        SELECT  t.*,
                RANK() OVER (PARTITION BY t."TEAM_ID" ORDER BY t."MAX_RBI" DESC) AS "RK"
        FROM    TEAM_RBI t
)
