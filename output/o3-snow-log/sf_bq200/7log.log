/* -----------------------------------------------------------
   Pitcher with the single-fastest (non-zero) pitch for every team
   – regular-season + post-season combined
-------------------------------------------------------------*/

WITH GAME_PLAYER_MAP AS (                 -- 1. roster → row format
        /* home line-ups */
        SELECT  g."GAME_ID",
                g."HOME_TEAM_ID"                       AS "TEAM_ID",
                h.VALUE::TEXT                          AS "PLAYER_ID"
        FROM    BASEBALL.STATCAST."GAMES" g,
                LATERAL FLATTEN ( INPUT => g."HOME_PLAYER_IDS" ) h

        UNION ALL

        /* away line-ups */
        SELECT  g."GAME_ID",
                g."AWAY_TEAM_ID"                       AS "TEAM_ID",
                a.VALUE::TEXT                          AS "PLAYER_ID"
        FROM    BASEBALL.STATCAST."GAMES" g,
                LATERAL FLATTEN ( INPUT => g."AWAY_PLAYER_IDS" ) a
),

PITCH_SPEEDS AS (                          -- 2. keep positive numeric velo
        SELECT  p."GAME_ID",
                p."PITCHER_ID"                         AS "PLAYER_ID",
                TRY_TO_NUMBER( p."RELEASE_SPEED" )     AS "PITCH_SPEED"
        FROM    BASEBALL.STATCAST."PITCHES" p
        WHERE   TRY_TO_NUMBER( p."RELEASE_SPEED" ) > 0
),

VERIFIED_PITCHES AS (                      -- 3. confirm pitcher on roster
        SELECT  gp."TEAM_ID",
                ps."PLAYER_ID",
                ps."PITCH_SPEED"
        FROM    PITCH_SPEEDS     ps
        JOIN    GAME_PLAYER_MAP  gp
              ON ps."GAME_ID"   = gp."GAME_ID"
             AND ps."PLAYER_ID" = gp."PLAYER_ID"
),

TEAM_PITCHER_MAX AS (                      -- 4. max velo per (team, pitcher)
        SELECT  "TEAM_ID",
                "PLAYER_ID",
                MAX( "PITCH_SPEED" )                                      AS "MAX_PITCH_SPEED",
                ROW_NUMBER() OVER ( PARTITION BY "TEAM_ID"
                                     ORDER BY MAX( "PITCH_SPEED" ) DESC ) AS "RN"
        FROM    VERIFIED_PITCHES
        GROUP BY "TEAM_ID", "PLAYER_ID"
)

/* 5. one flamethrower per club, plus name */
SELECT  t."TEAM_ID",
        t."PLAYER_ID",
        pl."NAME_FIRST",
        pl."NAME_LAST",
        t."MAX_PITCH_SPEED"
FROM    TEAM_PITCHER_MAX            t
JOIN    BASEBALL.BASEBALL."PLAYER"  pl
      ON t."PLAYER_ID" = pl."PLAYER_ID"
WHERE   t."RN" = 1
ORDER BY t."MAX_PITCH_SPEED" DESC NULLS LAST;
