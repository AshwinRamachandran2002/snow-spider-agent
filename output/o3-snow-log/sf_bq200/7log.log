--Description: Join the max-SO totals to PLAYER names and, for every team, select the single player with the highest strike-out mark; TRY_TO_NUMBER avoids conversion failures
SELECT
  t.TEAM_ID,
  t.PLAYER_ID,
  p.NAME_FIRST,
  p.NAME_LAST,
  t.MAX_SO
FROM (
    SELECT
      b.TEAM_ID,
      b.PLAYER_ID,
      MAX(TRY_TO_NUMBER(b.SO)) AS MAX_SO,
      ROW_NUMBER() OVER (PARTITION BY b.TEAM_ID
                         ORDER BY MAX(TRY_TO_NUMBER(b.SO)) DESC) AS RN
    FROM BASEBALL.BASEBALL.BATTING b
    WHERE TRY_TO_NUMBER(b.SO) IS NOT NULL
    GROUP BY b.TEAM_ID, b.PLAYER_ID
) t
JOIN BASEBALL.BASEBALL.PLAYER p
  ON t.PLAYER_ID = p.PLAYER_ID
WHERE t.RN = 1
LIMIT 20
