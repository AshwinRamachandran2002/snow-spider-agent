```sql
--Description: Join BATTING and PLAYER to obtain each hitter’s first and last name for a single season (1871) so we can confirm the join keys and name fields  
SELECT 
  b."player_id",
  p."name_first",
  p."name_last",
  b."year",
  b."team_id",
  b."g",
  b."ab",
  b."h"
FROM BASEBALL.BASEBALL.BATTING  b
JOIN BASEBALL.BASEBALL.PLAYER   p
  ON b."player_id" = p."player_id"
WHERE b."year" = 1871
LIMIT 20;
```

```sql
--Description: Get, for every team in 1871, the single player with the highest non-zero strike-outs ("so") as a first approximation of “fastest pitches”  
SELECT *
FROM (
    SELECT
      b."team_id",
      b."player_id",
      p."name_first",
      p."name_last",
      b."so"::INTEGER   AS "strike_outs",
      ROW_NUMBER() OVER (PARTITION BY b."team_id" ORDER BY b."so"::INTEGER DESC) AS rn
    FROM BASEBALL.BASEBALL.BATTING b
    JOIN BASEBALL.BASEBALL.PLAYER p
      ON b."player_id" = p."player_id"
    WHERE b."so" IS NOT NULL AND b."so" <> ''
) x
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Retrieve the maximum “so” value each player recorded for each team across all years to see potential outliers we may want to treat as “max valid speed” later  
SELECT 
  b."team_id",
  b."player_id",
  MAX(b."so"::INTEGER) AS "max_so"
FROM BASEBALL.BASEBALL.BATTING b
WHERE b."so" IS NOT NULL AND b."so" <> ''
GROUP BY b."team_id", b."player_id"
LIMIT 20;
```

```sql
--Description: Combine prior aggregation with player names so we can directly see which player posted the highest strike-out total for every team (across seasons)  
SELECT
  t."team_id",
  t."player_id",
  p."name_first",
  p."name_last",
  t."max_so"
FROM (
    SELECT 
      b."team_id",
      b."player_id",
      MAX(b."so"::INTEGER) AS "max_so",
      ROW_NUMBER() OVER (PARTITION BY b."team_id" ORDER BY MAX(b."so"::INTEGER) DESC) AS rn
    FROM BASEBALL.BASEBALL.BATTING b
    WHERE b."so" IS NOT NULL AND b."so" <> ''
    GROUP BY b."team_id", b."player_id"
) t
JOIN BASEBALL.BASEBALL.PLAYER p
  ON t."player_id" = p."player_id"
WHERE t.rn = 1
LIMIT 20;
```

```sql
--Description: If we treat “hr” as another numeric performance metric, display—per team—the player with the single largest home-run value to ensure our filtering logic works with different numeric columns  
SELECT *
FROM (
    SELECT
      b."team_id",
      b."player_id",
      p."name_first",
      p."name_last",
      MAX(b."hr"::INTEGER) AS "max_hr",
      ROW_NUMBER() OVER (PARTITION BY b."team_id" ORDER BY MAX(b."hr"::INTEGER) DESC) AS rn
    FROM BASEBALL.BASEBALL.BATTING b
    JOIN BASEBALL.BASEBALL.PLAYER p
      ON b."player_id" = p."player_id"
    WHERE b."hr" IS NOT NULL AND b."hr" <> ''
    GROUP BY b."team_id", b."player_id", p."name_first", p."name_last"
) z
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Focus on one specific club (“NYA” shown only as an example) and retrieve every season’s top strike-out mark to validate per-season window logic  
