  ON b.PLAYER_ID = p.PLAYER_ID
WHERE TRY_TO_NUMBER(b.SO) > 0          -- excludes NULLs, blanks, and zeros
GROUP BY b.TEAM_ID, b.PLAYER_ID, p.NAME_FIRST, p.NAME_LAST
LIMIT 20
