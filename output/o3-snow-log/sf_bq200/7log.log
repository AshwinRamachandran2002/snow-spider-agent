/* -----------------------------------------------------------
   Pitcher with the single-fastest (non-zero) pitch for every team
   – regular-season + post-season combined
-------------------------------------------------------------*/

/* 1.  Flatten every game’s home- and away-rosters so we can later
       verify that a given pitcher actually appeared for that club
*/
WITH GAME_PLAYER_MAP AS (

    /* Home teams */
    SELECT  g."GAME_ID",
            g."HOME_TEAM_ID"       AS "TEAM_ID",
            fh.value::TEXT         AS "PLAYER_ID"
    FROM    BASEBALL.STATSCAST.GAMES  g,
            LATERAL FLATTEN(INPUT => g."HOME_PLAYER_IDS") fh

    UNION ALL

    /* Away teams */
    SELECT  g."GAME_ID",
            g."AWAY_TEAM_ID"       AS "TEAM_ID",
            fa.value::TEXT         AS "PLAYER_ID"
    FROM    BASEBALL.STATSCAST.GAMES  g,
            LATERAL FLATTEN(INPUT => g."AWAY_PLAYER_IDS") fa
),

/* 2.  Keep only pitches whose velocity is a valid positive number */
PITCH_SPEEDS AS (
    SELECT  p."GAME_ID",
            p."PITCHER_ID"                     AS "PLAYER_ID",
            TRY_TO_NUMBER(p."RELEASE_SPEED")   AS "PITCH_SPEED"
    FROM    BASEBALL.STATSCAST.PITCHES p
    WHERE   TRY_TO_NUMBER(p."RELEASE_SPEED") > 0          -- non-zero, numeric
),

/* 3.  Retain pitches thrown by players who are listed on the
       corresponding home/away roster for that exact game         */
VERIFIED_PITCHES AS (
    SELECT  gm."TEAM_ID",
            ps."PLAYER_ID",
            ps."PITCH_SPEED"
    FROM    PITCH_SPEEDS      ps
    JOIN    GAME_PLAYER_MAP   gm
           ON ps."GAME_ID"   = gm."GAME_ID"
          AND ps."PLAYER_ID" = gm."PLAYER_ID"
),

/* 4.  Per (team, pitcher) grab the single-fastest pitch */
TEAM_PITCHER_MAX AS (
    SELECT  "TEAM_ID",
            "PLAYER_ID",
            MAX("PITCH_SPEED")                              AS "MAX_PITCH_SPEED",
            ROW_NUMBER() OVER (PARTITION BY "TEAM_ID"
                               ORDER BY MAX("PITCH_SPEED") DESC) AS "RN"
    FROM    VERIFIED_PITCHES
    GROUP BY "TEAM_ID", "PLAYER_ID"
)

/* 5.  For each club, report the one pitcher whose top velocity is the greatest */
SELECT  t."TEAM_ID",
        t."PLAYER_ID",
        pl."NAME_FIRST",
        pl."NAME_LAST",
        t."MAX_PITCH_SPEED"
FROM    TEAM_PITCHER_MAX          t
JOIN    BASEBALL.BASEBALL.PLAYER  pl
       ON t."PLAYER_ID" = pl."PLAYER_ID"
WHERE   t."RN" = 1                       -- fastest arm per team
ORDER BY t."MAX_PITCH_SPEED" DESC NULLS LAST;
```
