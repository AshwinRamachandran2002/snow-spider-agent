FROM (
    SELECT
        b.TEAM_ID,
        b.PLAYER_ID,
        p.NAME_FIRST,
        p.NAME_LAST,
        TRY_TO_NUMBER(b.SO) AS STRIKE_OUTS,
        ROW_NUMBER() OVER (
            PARTITION BY b.TEAM_ID
            ORDER BY TRY_TO_NUMBER(b.SO) DESC
        ) AS RN
    FROM BASEBALL.BASEBALL.BATTING b
    JOIN BASEBALL.BASEBALL.PLAYER p
      ON b.PLAYER_ID = p.PLAYER_ID
    WHERE b.YEAR = 1871
      AND TRY_TO_NUMBER(b.SO) IS NOT NULL     -- drop blanks / non-numeric
      AND TRY_TO_NUMBER(b.SO) > 0             -- drop zeros
) x
WHERE RN = 1
LIMIT 20;
