```sql
--Description: Empty strings in the SO column cause CAST errors.  
--TRY_TO_NUMBER safely converts numeric text while turning blanks/non-numeric strings into NULL.  
--We restrict to 1871 rows where the converted SO is positive, then rank players by that value within each team and keep the top strike-out pitcher (RN = 1).  
SELECT *
FROM (
    SELECT
        b.TEAM_ID,
        b.PLAYER_ID,
        p.NAME_FIRST,
        p.NAME_LAST,
        TRY_TO_NUMBER(b.SO) AS STRIKE_OUTS,
        ROW_NUMBER() OVER (
            PARTITION BY b.TEAM_ID
            ORDER BY TRY_TO_NUMBER(b.SO) DESC
        ) AS RN
    FROM BASEBALL.BASEBALL.BATTING b
    JOIN BASEBALL.BASEBALL.PLAYER p
      ON b.PLAYER_ID = p.PLAYER_ID
    WHERE b.YEAR = 1871
      AND TRY_TO_NUMBER(b.SO) IS NOT NULL     -- drop blanks / non-numeric
      AND TRY_TO_NUMBER(b.SO) > 0             -- drop zeros
) x
WHERE RN = 1
LIMIT 20;
```
