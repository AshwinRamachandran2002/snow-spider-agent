LIMIT 20;
```

```sql
--Description: ❸  Get a quick look at the first 20 distinct teams that appear in the batting table  
SELECT DISTINCT "team_id"  
FROM BASEBALL.BASEBALL."BATTING"  
LIMIT 20;
```

```sql
--Description: ❹  List the first 20 player-IDs that have at least one batting record  
SELECT DISTINCT "player_id"  
FROM BASEBALL.BASEBALL."BATTING"  
LIMIT 20;
```

```sql
--Description: ❺  Join both tables to show 20 players’ full names together with one of their batting rows  
SELECT b."player_id",  
       p."name_first" || ' ' || p."name_last" AS "full_name",  
       b."year",  
       b."team_id",  
       b."ab",  
       b."h"  
FROM BASEBALL.BASEBALL."BATTING" b  
JOIN BASEBALL.BASEBALL."PLAYER"  p  
  ON b."player_id" = p."player_id"  
LIMIT 20;
```

```sql
--Description: ❻  For each team, show the highest numeric strike-out total (“so”) ever recorded in one game entry (first 20 teams)  
SELECT b."team_id",  
       MAX(TRY_TO_NUMBER(b."so")) AS "max_so_in_row"  
FROM BASEBALL.BASEBALL."BATTING" b  
GROUP BY b."team_id"  
ORDER BY "team_id"  
LIMIT 20;
```

```sql
--Description: ❼  Show, for the 1871 season only, the 20 players with the most home runs (numeric compare) together with their names  
SELECT b."player_id",  
       p."name_first" || ' ' || p."name_last" AS "full_name",  
       TRY_TO_NUMBER(b."hr")           AS "home_runs",  
       b."team_id"  
FROM BASEBALL.BASEBALL."BATTING" b  
JOIN BASEBALL.BASEBALL."PLAYER"  p  
  ON b."player_id" = p."player_id"  
WHERE b."year" = 1871  
  AND TRY_TO_NUMBER(b."hr") > 0  
ORDER BY "home_runs" DESC  
LIMIT 20;
```

```sql
--Description: ❽  Fuzzy-search for any player whose first or last name contains “aaron” (case-insensitive)  
SELECT "player_id",  
       "name_first",  
       "name_last"  
FROM BASEBALL.BASEBALL."PLAYER"  
WHERE "name_first" ILIKE '%aaron%'  
   OR "name_last"  ILIKE '%aaron%'  
LIMIT 20;
```

```sql
--Description: ❾  Pull the 20 batting rows where a player hit at least 10 HR in a season (numeric filter)  
SELECT *  
FROM BASEBALL.BASEBALL."BATTING"  
WHERE TRY_TO_NUMBER("hr") >= 10  
ORDER BY TRY_TO_NUMBER("hr") DESC  
LIMIT 20;
```

```sql
--Description: ❿  Combine birthplace info with batting data for players born in “AL” (Alabama) – first 20 rows  
SELECT p."name_first" || ' ' || p."name_last"          AS "full_name",  
       p."birth_city",  
       p."birth_state",  
       b."year",  
       b."team_id",  
       b."ab",  
       b."h"  
FROM BASEBALL.BASEBALL."PLAYER"  p  
JOIN BASEBALL.BASEBALL."BATTING" b  
  ON p."player_id" = b."player_id"  
WHERE p."birth_state" = 'AL'  
LIMIT 20;
```
