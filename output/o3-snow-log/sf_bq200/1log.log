```sql
/* ──────────────────────────────────────────────────────────────────────────────
   Highest (non-zero) pitch-speed by team – regular-season ᴜɴɪᴏɴ postseason
   ────────────────────────────────────────────────────────────────────────────── */

WITH ALL_PITCHES AS (     /* ❶ every pitch from both seasons                   */
        SELECT
               R."GAME_ID",
               R."PITCHER_ID"                      AS "PLAYER_ID",
               R."START_SPEED"                     AS "PITCH_SPEED"
        FROM   BASEBALL.BASEBALL."PITCH_REGULAR"   R
        
        UNION ALL
        
        SELECT
               P."GAME_ID",
               P."PITCHER_ID"                      AS "PLAYER_ID",
               P."START_SPEED"                     AS "PITCH_SPEED"
        FROM   BASEBALL.BASEBALL."PITCH_POSTSEASON" P
),

ALL_GAME_ROSTERS AS (     /* ❷ flatten every home/away roster for every game  */
        /* regular-season ‒ home side */
        SELECT  G."GAME_ID",
                G."HOME_TEAM_ID"                   AS "TEAM_ID",
                F.VALUE::STRING                    AS "PLAYER_ID"
        FROM    BASEBALL.BASEBALL."GAME_REGULAR"   G,
                LATERAL FLATTEN( INPUT => G."HOME_ROSTER" ) F
        
        UNION ALL
        
        /* regular-season ‒ away side */
        SELECT  G."GAME_ID",
                G."AWAY_TEAM_ID"                   AS "TEAM_ID",
                F.VALUE::STRING                    AS "PLAYER_ID"
        FROM    BASEBALL.BASEBALL."GAME_REGULAR"   G,
                LATERAL FLATTEN( INPUT => G."AWAY_ROSTER" ) F
        
        UNION ALL
        
        /* postseason ‒ home side */
        SELECT  G."GAME_ID",
                G."HOME_TEAM_ID"                   AS "TEAM_ID",
                F.VALUE::STRING                    AS "PLAYER_ID"
        FROM    BASEBALL.BASEBALL."GAME_POSTSEASON" G,
                LATERAL FLATTEN( INPUT => G."HOME_ROSTER" ) F
        
        UNION ALL
        
        /* postseason ‒ away side */
        SELECT  G."GAME_ID",
                G."AWAY_TEAM_ID"                   AS "TEAM_ID",
                F.VALUE::STRING                    AS "PLAYER_ID"
        FROM    BASEBALL.BASEBALL."GAME_POSTSEASON" G,
                LATERAL FLATTEN( INPUT => G."AWAY_ROSTER" ) F
),

CONFIRMED_PITCHES AS (    /* ❸ keep pitches thrown by a listed roster player  */
        SELECT
               P."PLAYER_ID",
               R."TEAM_ID",
               TRY_TO_NUMBER( P."PITCH_SPEED" )    AS "VALID_SPEED"
        FROM   ALL_PITCHES       P
        JOIN   ALL_GAME_ROSTERS  R
               ON  P."GAME_ID"  = R."GAME_ID"
               AND P."PLAYER_ID" = R."PLAYER_ID"
        WHERE  TRY_TO_NUMBER( P."PITCH_SPEED" ) > 0
),

PLAYER_TEAM_MAX AS (      /* ❹ max speed each pitcher achieved for a team     */
        SELECT
               "TEAM_ID",
               "PLAYER_ID",
               MAX( "VALID_SPEED" )                AS "MAX_SPEED"
        FROM   CONFIRMED_PITCHES
        GROUP  BY "TEAM_ID", "PLAYER_ID"
),

BEST_BY_TEAM AS (         /* ❺ single fastest pitcher per team                */
        SELECT
               "TEAM_ID",
               "PLAYER_ID",
               "MAX_SPEED",
               ROW_NUMBER() OVER (PARTITION BY "TEAM_ID"
                                   ORDER BY "MAX_SPEED" DESC) AS RN
        FROM   PLAYER_TEAM_MAX
)

SELECT
       B."TEAM_ID",
       P."NAME_FIRST" || ' ' || P."NAME_LAST"      AS "FULL_NAME",
       B."MAX_SPEED"
FROM   BEST_BY_TEAM        B
JOIN   BASEBALL.BASEBALL."PLAYER"  P
       ON P."PLAYER_ID" = B."PLAYER_ID"
WHERE  B.RN = 1
ORDER  BY B."TEAM_ID" NULLS LAST;
```
