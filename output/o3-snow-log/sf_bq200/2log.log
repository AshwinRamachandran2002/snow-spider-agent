```sql
/* -------------------------------------------------------------
   Highest (non-zero) recorded pitch speed per franchise
   – includes both regular-season and post-season games
--------------------------------------------------------------*/
WITH pitch_filtered AS (      -- keep only valid, non-zero speeds
    SELECT  p."GAME_ID",
            p."PITCHER_ID",
            TRY_TO_NUMBER(p."PITCH_SPEED") AS "PITCH_SPEED"
    FROM    BASEBALL.BASEBALL.PITCH p
    WHERE   TRY_TO_NUMBER(p."PITCH_SPEED") > 0
),

game_roster AS (              -- explode home & away player lists
    /* ------------- home players ------------- */
    SELECT  g."GAME_ID",
            g."HOME_TEAM_ID"        AS "TEAM_ID",
            f.value::TEXT           AS "PLAYER_ID"
    FROM    BASEBALL.BASEBALL.GAME g,
            LATERAL FLATTEN( INPUT => SPLIT(g."HOME_PLAYER_ID_LIST", ',')) f

    UNION ALL

    /* ------------- away players ------------- */
    SELECT  g."GAME_ID",
            g."AWAY_TEAM_ID"        AS "TEAM_ID",
            f.value::TEXT           AS "PLAYER_ID"
    FROM    BASEBALL.BASEBALL.GAME g,
            LATERAL FLATTEN( INPUT => SPLIT(g."AWAY_PLAYER_ID_LIST", ',')) f
),

pitch_team AS (                -- keep only pitches thrown by a listed player
    SELECT  pf."TEAM_ID",
            pf."PITCHER_ID",
            pf."PITCH_SPEED"
    FROM    pitch_filtered pf
    JOIN    game_roster gr
           ON pf."GAME_ID"    = gr."GAME_ID"
          AND pf."PITCHER_ID" = gr."PLAYER_ID"
),

speed_per_pitcher AS (         -- max speed each pitcher reached for that club
    SELECT  "TEAM_ID",
            "PITCHER_ID",
            MAX("PITCH_SPEED") AS "MAX_SPEED"
    FROM    pitch_team
    GROUP BY "TEAM_ID", "PITCHER_ID"
),

team_leader AS (               -- pick the hardest-thrower per team
    SELECT  sp.*,
            ROW_NUMBER() OVER (PARTITION BY "TEAM_ID"
                               ORDER BY "MAX_SPEED" DESC) AS "RN"
    FROM    speed_per_pitcher sp
)

SELECT  tl."TEAM_ID",
        COALESCE(pl."NAME_FIRST",'') || ' ' || COALESCE(pl."NAME_LAST",'') AS "PITCHER_NAME",
        tl."MAX_SPEED"
FROM    team_leader tl
LEFT JOIN BASEBALL.BASEBALL.PLAYER pl
       ON tl."PITCHER_ID" = pl."PLAYER_ID"
WHERE   tl."RN" = 1
ORDER BY tl."TEAM_ID";
```
