```sql
--Description: See distinct seasons that have batting (will later allow filtering to regular-season or post-season once we discover the flag/column that tells them apart, if any)  
SELECT DISTINCT "year"  
FROM BASEBALL.BASEBALL.BATTING  
ORDER BY "year"  
LIMIT 20;
```

```sql
--Description: Retrieve a list of all teams that appear in the batting table so we can later tie the maximum-speed pitcher to the correct club  
SELECT DISTINCT "team_id"  
FROM BASEBALL.BASEBALL.BATTING  
ORDER BY "team_id"  
LIMIT 20;
```

```sql
--Description: Preview how many batting records each player has (helps find multi-team seasons or post-season appearances)  
SELECT "player_id", COUNT(*) AS "cnt"  
FROM BASEBALL.BASEBALL.BATTING  
GROUP BY "player_id"  
ORDER BY "cnt" DESC  
LIMIT 20;
```

```sql
--Description: Get batting records where a player changed teams in the same year (multiple “stint” values); these cases may later need special handling when matching a pitcher’s max speed to a club  
SELECT *  
FROM BASEBALL.BASEBALL.BATTING  
WHERE "stint" > 1  
LIMIT 20;
```

```sql
--Description: Join batting and player dimension to display a player’s full name beside a few batting stats (verifies join key “player_id” and gives us first & last names for final answer)  
SELECT b."player_id", p."name_first", p."name_last", b."year", b."team_id", b."ab", b."h"  
FROM BASEBALL.BASEBALL.BATTING b  
LEFT JOIN BASEBALL.BASEBALL.PLAYER p  
  ON b."player_id" = p."player_id"  
LIMIT 20;
```

```sql
--Description: Check if league identifiers are present; might distinguish regular-season from post-season (many historical rows have blank string)  
SELECT DISTINCT "league_id"  
FROM BASEBALL.BASEBALL.BATTING  
LIMIT 20;
```

```sql
--Description: Count how many batting rows have a blank “league_id” (helps decide how to de-noise data when looking for pitchers later)  
SELECT CASE WHEN "league_id" = '' THEN 'BLANK' ELSE 'NON_BLANK' END AS "league_flag",  
       COUNT(*) AS "rows"  
FROM BASEBALL.BASEBALL.BATTING  
GROUP BY CASE WHEN "league_id" = '' THEN 'BLANK' ELSE 'NON_BLANK' END  
LIMIT 20;
```

```sql
--Description: Sample rows where the “cs” (caught stealing) or “sb” (stolen bases) are NULL or blank—useful to recognize other missing-value patterns which could also affect pitch-speed fields in a different table  
SELECT *  
FROM BASEBALL.BASEBALL.BATTING  
WHERE "sb" = '' OR "cs" = ''  
LIMIT 20;
```

```sql
--Description: Show combined batting totals per player & team across all seasons (verifies numeric casting of text columns; will be analogous to aggregating pitch-speed values)  
SELECT "player_id", "team_id",  
       SUM("ab"::INT) AS "career_ab",  
       SUM("h"::INT)  AS "career_h"  
FROM BASEBALL.BASEBALL.BATTING  
GROUP BY "player_id", "team_id"  
ORDER BY "career_ab" DESC  
LIMIT 20;
```
