```sql
--Description / Thinking process:  
--The previous equality test against '' failed because Snowflake tried to cast the empty string to a number.  
--To locate rows where stolen-base ("SB") or caught-stealing ("CS") data is absent,  
--convert possible NULLs to empty strings with COALESCE and then check that the resulting text length is zero.  
--This avoids numeric casting errors while still detecting both NULL and blank values.
SELECT *
FROM BASEBALL.BASEBALL.BATTING
WHERE LENGTH(COALESCE("SB", '')) = 0
   OR LENGTH(COALESCE("CS", '')) = 0
LIMIT 20;
