Query:
--Description: Aggregate career batting totals per player and team while safely converting the TEXT columns "AB" and "H" to numbers.  
--Using TRY_TO_NUMBER returns NULL (ignored by SUM) for any non-numeric or blank values, avoiding cast errors.
SELECT "PLAYER_ID",
       "TEAM_ID",
       SUM(TRY_TO_NUMBER("AB")) AS "CAREER_AB",
       SUM(TRY_TO_NUMBER("H"))  AS "CAREER_H"
FROM BASEBALL.BASEBALL.BATTING
GROUP BY "PLAYER_ID", "TEAM_ID"
ORDER BY "CAREER_AB" DESC
LIMIT 20
