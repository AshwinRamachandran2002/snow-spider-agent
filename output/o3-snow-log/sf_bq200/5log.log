```sql
/*-------------------------------------------------------------------------------
  1)  UNION the regular-season and post-season pitch feeds.
  2)  Keep only pitches that have a valid ( > 0 ) recorded speed.
  3)  Attach the TEAM the pitcher was actually playing for in that game by 
      confirming that the PITCHER_ID occurs in the appropriate home / away
      line-up columns for the same GAME_ID.
  4)  For every (TEAM_ID , PITCHER_ID) pair obtain the top pitch speed.
  5)  Per team, keep the single pitcher whose maximum recorded speed is the 
      greatest.
  6)  Add the pitcher’s full name from the PLAYER bio table and return the 
      requested result set.
-------------------------------------------------------------------------------*/
WITH pitch_union AS (          -- 1
    SELECT  "GAME_ID",
            "PITCHER_ID",
            TRY_TO_NUMBER("PITCH_SPEED")  AS "PITCH_SPEED"
    FROM    BASEBALL.BASEBALL.PITCH_REGULAR            -- regular season
    UNION ALL
    SELECT  "GAME_ID",
            "PITCHER_ID",
            TRY_TO_NUMBER("PITCH_SPEED")
    FROM    BASEBALL.BASEBALL.PITCH_POST               -- post-season
),
valid_pitches AS (             -- 2
    SELECT *
    FROM   pitch_union
    WHERE  "PITCH_SPEED" > 0
),
pitch_with_team AS (           -- 3
    SELECT 
        vp."PITCHER_ID",
        CASE
            WHEN vp."PITCHER_ID" IN 
                 (g."HOME_PLAYER_1", g."HOME_PLAYER_2", g."HOME_PLAYER_3",
                  g."HOME_PLAYER_4", g."HOME_PLAYER_5", g."HOME_PLAYER_6",
                  g."HOME_PLAYER_7", g."HOME_PLAYER_8", g."HOME_PLAYER_9",
                  g."HOME_PITCHER_ID")
            THEN g."HOME_TEAM_ID"

            WHEN vp."PITCHER_ID" IN 
                 (g."AWAY_PLAYER_1", g."AWAY_PLAYER_2", g."AWAY_PLAYER_3",
                  g."AWAY_PLAYER_4", g."AWAY_PLAYER_5", g."AWAY_PLAYER_6",
                  g."AWAY_PLAYER_7", g."AWAY_PLAYER_8", g."AWAY_PLAYER_9",
                  g."AWAY_PITCHER_ID")
            THEN g."AWAY_TEAM_ID"
        END                                                   AS "TEAM_ID",
        vp."PITCH_SPEED"
    FROM   valid_pitches          vp
    JOIN   BASEBALL.BASEBALL.GAME g
           ON vp."GAME_ID" = g."GAME_ID"
    /* keep only rows where the pitcher really appeared for either side */
    WHERE  vp."PITCHER_ID" IN
           (g."HOME_PLAYER_1", g."HOME_PLAYER_2", g."HOME_PLAYER_3",
            g."HOME_PLAYER_4", g."HOME_PLAYER_5", g."HOME_PLAYER_6",
            g."HOME_PLAYER_7", g."HOME_PLAYER_8", g."HOME_PLAYER_9",
            g."HOME_PITCHER_ID",
            g."AWAY_PLAYER_1", g."AWAY_PLAYER_2", g."AWAY_PLAYER_3",
            g."AWAY_PLAYER_4", g."AWAY_PLAYER_5", g."AWAY_PLAYER_6",
            g."AWAY_PLAYER_7", g."AWAY_PLAYER_8", g."AWAY_PLAYER_9",
            g."AWAY_PITCHER_ID")
),
team_pitcher_max AS (          -- 4
    SELECT  "TEAM_ID",
            "PITCHER_ID",
            MAX("PITCH_SPEED") AS "MAX_PITCH_SPEED"
    FROM    pitch_with_team
    GROUP BY "TEAM_ID", "PITCHER_ID"
),
best_per_team AS (             -- 5
    SELECT *
    FROM (
        SELECT  "TEAM_ID",
                "PITCHER_ID",
                "MAX_PITCH_SPEED",
                ROW_NUMBER() OVER (PARTITION BY "TEAM_ID"
                                   ORDER BY "MAX_PITCH_SPEED" DESC) AS rn
        FROM    team_pitcher_max
    )
    WHERE rn = 1
)
-- 6  ───────────────────────────────────────────────────────────────────────────
SELECT  
        bpt."TEAM_ID",
        CONCAT(pl."NAME_FIRST",' ',pl."NAME_LAST")      AS "PITCHER_NAME",
        bpt."MAX_PITCH_SPEED"
FROM    best_per_team              bpt
JOIN    BASEBALL.BASEBALL.PLAYER    pl
        ON bpt."PITCHER_ID" = pl."PLAYER_ID"
ORDER BY bpt."MAX_PITCH_SPEED" DESC NULLS LAST;
```
