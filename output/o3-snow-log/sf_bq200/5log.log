    SELECT  "GAME_ID",
            "PITCHER_ID",
            TRY_TO_NUMBER("PITCH_SPEED") AS "PITCH_SPEED"
    FROM    BASEBALL.BASEBALL.PITCH          -- regular season
    UNION ALL
    SELECT  "GAME_ID",
            "PITCHER_ID",
            TRY_TO_NUMBER("PITCH_SPEED")
    FROM    BASEBALL.BASEBALL.PITCH_POST     -- post-season
),
valid_pitches AS (             -- 2
    SELECT *
    FROM   pitch_union
    WHERE  "PITCH_SPEED" > 0
),
pitch_with_team AS (           -- 3
