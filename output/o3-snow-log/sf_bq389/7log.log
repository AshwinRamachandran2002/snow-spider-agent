    SELECT DATE_TRUNC('month', "date_local") AS m, AVG("arithmetic_mean") AS pm25_frm
    FROM "EPA_HISTORICAL_AIR_QUALITY"."EPA_HISTORICAL_AIR_QUALITY"."PM25_FRM_DAILY_SUMMARY"
    WHERE "state_name" = 'California' AND YEAR("date_local") = 2020
    GROUP BY 1
), pm25_nonfrm AS (
    SELECT DATE_TRUNC('month', "date_local") AS m, AVG("arithmetic_mean") AS pm25_nonfrm
    FROM "EPA_HISTORICAL_AIR_QUALITY"."EPA_HISTORICAL_AIR_QUALITY"."PM25_NONFRM_DAILY_SUMMARY"
    WHERE "state_name" = 'California' AND YEAR("date_local") = 2020
    GROUP BY 1
), voc AS (
    SELECT DATE_TRUNC('month', "date_local") AS m, AVG("arithmetic_mean") AS voc
    FROM "EPA_HISTORICAL_AIR_QUALITY"."EPA_HISTORICAL_AIR_QUALITY"."VOC_DAILY_SUMMARY"
    WHERE "state_name" = 'California' AND YEAR("date_local") = 2020
    GROUP BY 1
), so2 AS (
    SELECT DATE_TRUNC('month', "date_local") AS m, AVG("arithmetic_mean") * 10 AS so2_scaled
    FROM "EPA_HISTORICAL_AIR_QUALITY"."EPA_HISTORICAL_AIR_QUALITY"."SO2_DAILY_SUMMARY"
    WHERE "state_name" = 'California' AND YEAR("date_local") = 2020
    GROUP BY 1
), lead AS (
    SELECT DATE_TRUNC('month', "date_local") AS m, AVG("arithmetic_mean") * 100 AS lead_scaled
    FROM "EPA_HISTORICAL_AIR_QUALITY"."EPA_HISTORICAL_AIR_QUALITY"."LEAD_DAILY_SUMMARY"
    WHERE "state_name" = 'California' AND YEAR("date_local") = 2020
    GROUP BY 1
)
SELECT pm10.m AS "month_2020",
       pm10.pm10,
       pm25_frm.pm25_frm,
       pm25_nonfrm.pm25_nonfrm,
       voc.voc,
       so2.so2_scaled,
       lead.lead_scaled
FROM pm10
LEFT JOIN pm25_frm     ON pm10.m = pm25_frm.m
LEFT JOIN pm25_nonfrm  ON pm10.m = pm25_nonfrm.m
LEFT JOIN voc          ON pm10.m = voc.m
LEFT JOIN so2          ON pm10.m = so2.m
LEFT JOIN lead         ON pm10.m = lead.m
ORDER BY "month_2020"
LIMIT 20;
