--Description: For every top-level package (one that is never itself placed inside another),
--             walk the entire hierarchy of what it contains, multiply quantities all
--             the way down, and attach a readable name to each item: if the item is a
--             product use PRODUCTS.name, otherwise use PACKAGING.name.
WITH top_pkg AS (                             -- 1) find true “root” packages
    SELECT DISTINCT pr."packaging_id"
    FROM   ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
    LEFT   JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
           ON pr2."contains_id" = pr."packaging_id"
    WHERE  pr2."packaging_id" IS NULL
),
pkg_cte AS (                                  -- 2) recurse through PACKAGING_RELATIONS
    /* level-0 : direct children of each top-level package */
    SELECT pr."packaging_id"       AS root_pkg_id,
           pr."contains_id"        AS child_id,
           CAST(pr."qty" AS FLOAT) AS qty_mult
    FROM   ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
    JOIN   top_pkg tp
           ON tp."packaging_id" = pr."packaging_id"
    UNION ALL
    /* level-n : keep descending while the child is a package */
    SELECT cte.root_pkg_id,
           pr."contains_id",
           cte.qty_mult * pr."qty"
    FROM   pkg_cte cte
    JOIN   ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
           ON pr."packaging_id" = cte.child_id
)
SELECT  cte.root_pkg_id,
        root_pkg."name"                         AS root_pkg_name,
        cte.child_id                            AS item_id,
        COALESCE(prod_tbl."name", pkg_tbl."name") AS item_name,  -- prefer product name
        cte.qty_mult                            AS accumulated_qty
FROM        pkg_cte
JOIN        ORACLE_SQL.ORACLE_SQL."PACKAGING"  root_pkg   ON root_pkg."id" = cte.root_pkg_id
LEFT JOIN   ORACLE_SQL.ORACLE_SQL."PRODUCTS"   prod_tbl   ON prod_tbl."id" = cte.child_id
LEFT JOIN   ORACLE_SQL.ORACLE_SQL."PACKAGING"  pkg_tbl    ON pkg_tbl."id"  = cte.child_id
LIMIT 20;
