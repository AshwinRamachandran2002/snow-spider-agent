```sql
--Description:  Answer the business question in one go.
--              Goal → list every “top-level” package (one that never appears as a child)
--              that contains at least one *product* whose total quantity, after
--              multiplying through all nested packaging levels, exceeds 500 units.
--              Show the readable names of the container and the product plus that
--              accumulated quantity.
WITH top_pkg AS (  -------------------------------------------------------------(1)
    -- Packages that are never themselves contained in another package
    SELECT DISTINCT pr."packaging_id"
    FROM   ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
    LEFT   JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
           ON pr2."contains_id" = pr."packaging_id"
    WHERE  pr2."packaging_id" IS NULL
),
pkg_cte AS (  ---------------------------------------------------------------(2)
    -- Recursive walk starting at every top-level package, carrying a quantity multiplier
    /* level-0 : direct children of each top-level package */
    SELECT pr."packaging_id"        AS "root_pkg_id",
           pr."contains_id"         AS "child_id",
           CAST(pr."qty" AS FLOAT)  AS "qty_mult"
    FROM   ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
    JOIN   top_pkg tp
           ON tp."packaging_id" = pr."packaging_id"
    UNION ALL
    /* level-n : continue while the current child is itself a package */
    SELECT cte."root_pkg_id",
           pr2."contains_id",
           cte."qty_mult" * pr2."qty"
    FROM   pkg_cte                                           cte
    JOIN   ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
           ON pr2."packaging_id" = cte."child_id"
),
leaf_items AS (  -------------------------------------------------------------(3)
    -- Keep only real products: items that never act as a parent in PACKAGING_RELATIONS
    SELECT cte.*
    FROM   pkg_cte cte
    LEFT   JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
           ON pr."packaging_id" = cte."child_id"
    WHERE  pr."contains_id" IS NULL         -- child_id never appears as a parent
),
agg AS (  --------------------------------------------------------------------(4)
    -- Aggregate quantity per (top-level package, product) and filter > 500
    SELECT  li."root_pkg_id",
            li."child_id"            AS "product_id",
            SUM(li."qty_mult")       AS "total_qty"
    FROM    leaf_items li
    GROUP BY li."root_pkg_id", li."child_id"
    HAVING  SUM(li."qty_mult") > 500
)
SELECT  root_pkg."name"  AS "top_level_container",
        prod."name"      AS "product",
        agg."total_qty"  AS "accumulated_qty"
FROM    agg
JOIN    ORACLE_SQL.ORACLE_SQL."PACKAGING" root_pkg ON root_pkg."id" = agg."root_pkg_id"
JOIN    ORACLE_SQL.ORACLE_SQL."PRODUCTS"  prod     ON prod."id"     = agg."product_id"
ORDER BY root_pkg."name", prod."name"
LIMIT 20;
```
