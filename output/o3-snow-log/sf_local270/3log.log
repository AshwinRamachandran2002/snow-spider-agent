```sql
--Description: Build a “bill-of-materials” view that, for every top-level package
--             (packages never found inside another one), lists every item found
--             anywhere inside it, together with the accumulated quantity and a
--             readable name (product name if it is a product, otherwise package name).

WITH RECURSIVE top_pkg AS (                            -- Step-1: identify top-level containers
    SELECT DISTINCT pr."packaging_id"
    FROM   ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
    LEFT   JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
           ON pr2."contains_id" = pr."packaging_id"
    WHERE  pr2."packaging_id" IS NULL
),
pkg_cte AS (                                           -- Step-2: walk the hierarchy, multiplying quantities
    /* level-0 : direct children of each top-level package */
    SELECT pr."packaging_id"       AS root_pkg_id,
           pr."contains_id"        AS child_id,
           CAST(pr."qty" AS FLOAT) AS qty_mult
    FROM   ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
    JOIN   top_pkg tp
           ON tp."packaging_id" = pr."packaging_id"

    UNION ALL                                           -- level-n : recurse down
    SELECT cte.root_pkg_id,
           pr."contains_id",
           cte.qty_mult * pr."qty"
    FROM   pkg_cte cte
    JOIN   ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
           ON pr."packaging_id" = cte.child_id
)
SELECT  cte.root_pkg_id,
        root_pkg."name"                            AS root_pkg_name,
        cte.child_id                               AS item_id,
        COALESCE(prod."name", child_pkg."name")    AS item_name,   -- product first, else package
        cte.qty_mult                               AS accumulated_qty
FROM        pkg_cte                                      cte
JOIN        ORACLE_SQL.ORACLE_SQL."PACKAGING"     root_pkg   ON root_pkg."id" = cte.root_pkg_id
LEFT JOIN   ORACLE_SQL.ORACLE_SQL."PRODUCTS"      prod       ON prod."id"      = cte.child_id
LEFT JOIN   ORACLE_SQL.ORACLE_SQL."PACKAGING"     child_pkg  ON child_pkg."id" = cte.child_id
LIMIT 20;
