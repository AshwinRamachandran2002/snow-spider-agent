```sql
--Description: Identify “top-level” packaging – i.e., packages that are never found inside some other package
SELECT DISTINCT pr1."packaging_id"      AS "top_level_pkg_id",
       p."name"                         AS "top_level_pkg_name"
FROM   ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr1
JOIN   ORACLE_SQL.ORACLE_SQL."PACKAGING"           p  ON p."id" = pr1."packaging_id"
LEFT   JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
       ON pr2."contains_id" = pr1."packaging_id"
WHERE  pr2."packaging_id" IS NULL
LIMIT 20;
```

```sql
--Description: Build a recursive list of everything contained inside each top-level package, carrying the cumulative quantity multiplier down the hierarchy
WITH RECURSIVE pkg_cte AS (
        /* level-0 : immediate children of each top-level package                          */
        SELECT  pr."packaging_id"                       AS "root_pkg_id",
                pr."contains_id"                        AS "child_id",
                CAST(pr."qty" AS FLOAT)                 AS "qty_mult"
        FROM    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
        WHERE   pr."packaging_id" IN (
                SELECT DISTINCT pr1."packaging_id"
                FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr1
                LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
                       ON pr2."contains_id" = pr1."packaging_id"
                WHERE pr2."packaging_id" IS NULL
        )

        UNION ALL

        /* level-n : walk further down if the current child is still a package             */
        SELECT  pc."root_pkg_id",
                pr2."contains_id",
                pc."qty_mult" * pr2."qty"
        FROM    pkg_cte pc
        JOIN    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
               ON pr2."packaging_id" = pc."child_id"
)
SELECT * FROM pkg_cte
LIMIT 20;
```

```sql
--Description: Attach proper names (product name for leaf items, package name for embedded packages)
WITH RECURSIVE pkg_cte AS ( /* same as previous query */ 
        SELECT  pr."packaging_id" AS "root_pkg_id",
                pr."contains_id"  AS "child_id",
                CAST(pr."qty" AS FLOAT)  AS "qty_mult"
        FROM    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
        WHERE   pr."packaging_id" IN (
            SELECT pr1."packaging_id"
            FROM   ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr1
            LEFT   JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
                   ON pr2."contains_id" = pr1."packaging_id"
            WHERE  pr2."packaging_id" IS NULL
        )
        UNION ALL
        SELECT  cte."root_pkg_id",
                pr2."contains_id",
                cte."qty_mult" * pr2."qty"
        FROM    pkg_cte cte
        JOIN    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
               ON pr2."packaging_id" = cte."child_id"
)
SELECT  cte."root_pkg_id",
        root_p."name"                                   AS "root_pkg_name",
        cte."child_id"                                  AS "item_id",
        COALESCE(prod."name", pkg."name")               AS "item_name",
        cte."qty_mult"                                  AS "accumulated_qty"
FROM    pkg_cte cte
JOIN    ORACLE_SQL.ORACLE_SQL."PACKAGING" root_p ON root_p."id" = cte."root_pkg_id"
LEFT    JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"  prod   ON prod."id" = cte."child_id"
LEFT    JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" pkg    ON pkg."id"  = cte."child_id"
LIMIT 20;
```

```sql
--Description: Aggregate the total quantity for each leaf item (those not acting as parent elsewhere) inside each top-level package
WITH RECURSIVE pkg_cte AS (   /* hierarchy with multiplier, identical to previous step */ 
        SELECT  pr."packaging_id" AS "root_pkg_id",
                pr."contains_id"  AS "child_id",
                CAST(pr."qty" AS FLOAT)  AS "qty_mult"
        FROM    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
        WHERE   pr."packaging_id" IN (
            SELECT pr1."packaging_id"
            FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr1
            LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
                   ON pr2."contains_id" = pr1."packaging_id"
            WHERE pr2."packaging_id" IS NULL
        )
        UNION ALL
        SELECT  cte."root_pkg_id",
                pr2."contains_id",
                cte."qty_mult" * pr2."qty"
        FROM    pkg_cte cte
        JOIN    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
             ON pr2."packaging_id" = cte."child_id"
), 
leaf_items AS (
        /* keep only those child_ids that never act as parent (= true end products)        */
        SELECT  cte.*
        FROM    pkg_cte cte
        LEFT    JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
               ON pr."packaging_id" = cte."child_id"
        WHERE   pr."contains_id" IS NULL
) 
SELECT  li."root_pkg_id",
        rp."name"                         AS "root_pkg_name",
        li."child_id"                     AS "product_id",
        prd."name"                        AS "product_name",
        SUM(li."qty_mult")                AS "total_qty_in_root"
FROM    leaf_items li
JOIN    ORACLE_SQL.ORACLE_SQL."PACKAGING" rp ON rp."id" = li."root_pkg_id"
JOIN    ORACLE_SQL.ORACLE_SQL."PRODUCTS"  prd ON prd."id" = li."child_id"
GROUP BY li."root_pkg_id", rp."name", li."child_id", prd."name"
LIMIT 20;
```

```sql
--Description: Find any root package / product pair where the accumulated quantity exceeds 500
WITH RECURSIVE pkg_cte AS ( /* hierarchy with multiplier – see previous queries */ 
        SELECT  pr."packaging_id" AS "root_pkg_id",
                pr."contains_id"  AS "child_id",
                CAST(pr."qty" AS FLOAT)  AS "qty_mult"
        FROM    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
        WHERE   pr."packaging_id" IN (
            SELECT pr1."packaging_id"
            FROM   ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr1
            LEFT   JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
                   ON pr2."contains_id" = pr1."packaging_id"
            WHERE  pr2."packaging_id" IS NULL
        )
        UNION ALL
        SELECT  cte."root_pkg_id",
                pr2."contains_id",
                cte."qty_mult" * pr2."qty"
        FROM    pkg_cte cte
        JOIN    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
               ON pr2."packaging_id" = cte."child_id"
), 
leaf_items AS (
        SELECT cte.*
        FROM   pkg_cte cte
        LEFT   JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
               ON pr."packaging_id" = cte."child_id"
        WHERE  pr."contains_id" IS NULL
), 
agg AS (
        SELECT  li."root_pkg_id",
                li."child_id"                AS "product_id",
                SUM(li."qty_mult")           AS "total_qty"
        FROM    leaf_items li
        GROUP BY li."root_pkg_id", li."child_id"
)
SELECT  a."root_pkg_id",
        rp."name"            AS "root_pkg_name",
        a."product_id",
        prd."name"           AS "product_name",
        a."total_qty"
FROM    agg a
JOIN    ORACLE_SQL.ORACLE_SQL."PACKAGING" rp  ON rp."id" = a."root_pkg_id"
JOIN    ORACLE_SQL.ORACLE_SQL."PRODUCTS"  prd ON prd."id" = a."product_id"
