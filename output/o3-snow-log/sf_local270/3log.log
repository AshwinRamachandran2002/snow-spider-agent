        p1."name"                         AS "parent_pkg_name",
        pr."contains_id"                  AS "child_id",
        COALESCE(p2."name", prd."name")   AS "child_name",
        pr."qty"                          AS "units_in_parent"
FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING"      p1  ON p1."id" = pr."packaging_id"
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING"      p2  ON p2."id" = pr."contains_id"
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"       prd ON prd."id" = pr."contains_id"
LIMIT 20;
