Query:
--Description: Build a recursive list of everything contained inside each top-level package, carrying the cumulative quantity multiplier down the hierarchy
WITH RECURSIVE pkg_cte AS (
        /* level-0 : immediate children of each top-level package                          */
        SELECT  pr."packaging_id"                       AS "root_pkg_id",
                pr."contains_id"                        AS "child_id",
                CAST(pr."qty" AS FLOAT)                 AS "qty_mult"
        FROM    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
        WHERE   pr."packaging_id" IN (
                SELECT DISTINCT pr1."packaging_id"
                FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr1
                LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
                       ON pr2."contains_id" = pr1."packaging_id"
                WHERE pr2."packaging_id" IS NULL
        )

        UNION ALL

        /* level-n : walk further down if the current child is still a package             */
        SELECT  pc."root_pkg_id",
                pr2."contains_id",
                pc."qty_mult" * pr2."qty"
        FROM    pkg_cte pc
        JOIN    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
               ON pr2."packaging_id" = pc."child_id"
)
SELECT * FROM pkg_cte
LIMIT 20;
