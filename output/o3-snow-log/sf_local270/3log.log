```sql
--Description: Display the distinct top-level packages that hold at least one product with quantity > 500
WITH RECURSIVE pkg_cte AS ( /* hierarchy with multiplier */ 
        SELECT  pr."packaging_id" AS "root_pkg_id",
                pr."contains_id"  AS "child_id",
                CAST(pr."qty" AS FLOAT)  AS "qty_mult"
        FROM    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
        WHERE   pr."packaging_id" IN (
            SELECT pr1."packaging_id"
            FROM   ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr1
            LEFT   JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
                   ON pr2."contains_id" = pr1."packaging_id"
            WHERE  pr2."packaging_id" IS NULL
        )
        UNION ALL
        SELECT  cte."root_pkg_id",
                pr2."contains_id",
                cte."qty_mult" * pr2."qty"
        FROM    pkg_cte cte
        JOIN    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
               ON pr2."packaging_id" = cte."child_id"
), 
leaf_items AS (
        SELECT cte.*
        FROM   pkg_cte cte
        LEFT   JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
               ON pr."packaging_id" = cte."child_id"
        WHERE  pr."contains_id" IS NULL
), 
agg AS (
        SELECT  li."root_pkg_id",
                SUM(li."qty_mult")   AS "largest_product_qty"
        FROM    leaf_items li
        GROUP BY li."root_pkg_id", li."child_id"
        HAVING  SUM(li."qty_mult") > 500
) 
SELECT DISTINCT a."root_pkg_id",
                p."name" AS "root_pkg_name"
FROM   agg a
JOIN   ORACLE_SQL.ORACLE_SQL."PACKAGING" p ON p."id" = a."root_pkg_id"
LIMIT 20;
