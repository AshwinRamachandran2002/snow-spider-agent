--Description: If you want to see the full exploded bill-of-materials for a specific top-level package (replace 534 with desired id)
WITH RECURSIVE bom AS (
    SELECT  0                      AS "lvl",
            p_root."id"            AS "root_pkg_id",
            p_root."name"          AS "root_pkg_name",
            p_root."id"            AS "parent_id",
            p_root."name"          AS "parent_name",
            pr."contains_id"       AS "child_id",
            COALESCE(p_child."name", prod."name") AS "child_name",
            pr."qty"               AS "qty_in_parent",
            CAST(pr."qty" AS FLOAT) AS "qty_mult"
    FROM    ORACLE_SQL.ORACLE_SQL."PACKAGING" p_root
    JOIN    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
           ON pr."packaging_id" = p_root."id"
    LEFT    JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" p_child ON p_child."id" = pr."contains_id"
    LEFT    JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"  prod    ON prod."id" = pr."contains_id"
    WHERE   p_root."id" = 534  -- <== change here
    UNION ALL
    SELECT  b."lvl"+1,
            b."root_pkg_id",
            b."root_pkg_name",
            pr."packaging_id",
            COALESCE(pp."name", pd."name"),
            pr."contains_id",
            COALESCE(cp."name", cd."name"),
            pr."qty",
            b."qty_mult" * pr."qty"
    FROM    bom b
    JOIN    ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
           ON pr."packaging_id" = b."child_id"
    LEFT    JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" pp ON pp."id" = pr."packaging_id"
    LEFT    JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"  pd ON pd."id" = pr."packaging_id"
    LEFT    JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" cp ON cp."id" = pr."contains_id"
    LEFT    JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"  cd ON cd."id" = pr."contains_id"
)
SELECT * FROM bom
ORDER BY "lvl", "parent_id", "child_id"
LIMIT 20;
