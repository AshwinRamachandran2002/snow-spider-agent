```sql
--Description: 
-- Goal: list every top-level packaging container (never itself contained),
--        together with any nested item for which the total quantity inside
--        ONE such container exceeds 500 units.
-- Steps:
-- 1) top_pkg  : find root containers (packaging_id not used as contains_id).
-- 2) r        : recursively walk down the PACKAGING_RELATIONS tree starting
--               from each root; multiply the quantities along each edge so
--               total_qty = units of curr_id inside ONE root container.
-- 3) summed   : aggregate to get total units for each (root, item) pair.
-- 4) Final    : keep only rows where total_qty > 500 and show readable names.
WITH RECURSIVE
    top_pkg AS (                           -- step-1
        SELECT DISTINCT pr."packaging_id"
        FROM ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS pr
        WHERE pr."packaging_id" NOT IN (
              SELECT DISTINCT "contains_id"
              FROM ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS )
    ),
    r (top_id, curr_id, total_qty) AS (    -- step-2
        SELECT tp."packaging_id", tp."packaging_id", 1::FLOAT
        FROM top_pkg tp
        UNION ALL
        SELECT r.top_id,
               pr."contains_id",
               r.total_qty * pr."qty"
        FROM r
        JOIN ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS pr
          ON pr."packaging_id" = r.curr_id
    ),
    summed AS (                            -- step-3
        SELECT r.top_id,
               r.curr_id,
               SUM(r.total_qty) AS total_qty
        FROM r
        GROUP BY r.top_id, r.curr_id
    )
SELECT  p_top."name"                                        AS "top_level_container",
        COALESCE(p_item."name", TO_VARCHAR(summed.curr_id)) AS "contained_item",
        summed.total_qty
FROM    summed
JOIN    ORACLE_SQL.ORACLE_SQL.PACKAGING  p_top   ON p_top."id" = summed.top_id
LEFT JOIN ORACLE_SQL.ORACLE_SQL.PACKAGING p_item ON p_item."id" = summed.curr_id
WHERE   summed.total_qty > 500                -- step-4 threshold
ORDER BY summed.total_qty DESC
LIMIT 20;
```
