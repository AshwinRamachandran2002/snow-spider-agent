```sql
--Description: 7.  Expand every top-level container through all nested levels and accumulate quantities for each contained item  
WITH RECURSIVE
  top_pkg AS (  -- the root containers
      SELECT DISTINCT pr."packaging_id"
      FROM ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS pr
      WHERE pr."packaging_id" NOT IN (SELECT DISTINCT "contains_id"
                                      FROM ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS)
  ),
  r (top_id, curr_id, total_qty) AS (
      -- level 0 (the root itself counts 1)
      SELECT tp."packaging_id" AS top_id,
             tp."packaging_id" AS curr_id,
             1::FLOAT          AS total_qty
      FROM top_pkg tp
      UNION ALL
      -- walk down one step and multiply quantities
      SELECT r.top_id,
             pr."contains_id"  AS curr_id,
             r.total_qty * pr."qty"
      FROM r
      JOIN ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS pr
        ON pr."packaging_id" = r.curr_id
  )
SELECT r.top_id           AS "top_level_pkg_id",
       r.curr_id          AS "item_id",
       SUM(r.total_qty)   AS "total_qty"
FROM r
GROUP BY r.top_id, r.curr_id
LIMIT 20;
```

```sql
--Description: 8.  Keep only the items where the accumulated quantity exceeds 500 units  
WITH RECURSIVE
  top_pkg AS (
      SELECT DISTINCT pr."packaging_id"
      FROM ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS pr
      WHERE pr."packaging_id" NOT IN (SELECT DISTINCT "contains_id"
                                      FROM ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS)
  ),
  r (top_id, curr_id, total_qty) AS (
      SELECT tp."packaging_id" AS top_id,
             tp."packaging_id" AS curr_id,
             1::FLOAT          AS total_qty
      FROM top_pkg tp
      UNION ALL
      SELECT r.top_id,
             pr."contains_id",
             r.total_qty * pr."qty"
      FROM r
      JOIN ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS pr
        ON pr."packaging_id" = r.curr_id
  ),
  summed AS (
      SELECT r.top_id,
             r.curr_id,
             SUM(r.total_qty) AS total_qty
      FROM r
      GROUP BY r.top_id, r.curr_id
  )
SELECT p_top."name" AS "top_level_container",
       COALESCE(p_item."name", TO_VARCHAR(summed."curr_id")) AS "contained_item",
       summed."total_qty"
FROM summed
JOIN ORACLE_SQL.ORACLE_SQL.PACKAGING p_top  ON p_top."id" = summed."top_id"
LEFT JOIN ORACLE_SQL.ORACLE_SQL.PACKAGING p_item ON p_item."id" = summed."curr_id"
WHERE summed."total_qty" > 500
ORDER BY summed."total_qty" DESC
LIMIT 20;
```

