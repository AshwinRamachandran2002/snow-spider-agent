--Description: 9.  Show the final distinct (container ↔ item) pairs whose accumulated quantity > 500  
WITH RECURSIVE
    top_pkg AS (                       -- top-level containers
        SELECT DISTINCT pr."packaging_id"
        FROM ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS pr
        WHERE pr."packaging_id" NOT IN (
              SELECT DISTINCT "contains_id"
              FROM ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS)
    ),
    r (top_id, curr_id, total_qty) AS ( -- walk hierarchy, multiply qty
        SELECT tp."packaging_id", tp."packaging_id", 1::FLOAT
        FROM top_pkg tp
        UNION ALL
        SELECT r.top_id,
               pr."contains_id",
               r.total_qty * pr."qty"
        FROM r
        JOIN ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS pr
          ON pr."packaging_id" = r.curr_id
    ),
    summed AS (                         -- accumulate totals
        SELECT r.top_id,
               r.curr_id,
               SUM(r.total_qty) AS total_qty
        FROM r
        GROUP BY r.top_id, r.curr_id
    )
SELECT DISTINCT
       p_top."name"                                       AS "top_level_container",
       COALESCE(p_item."name", TO_VARCHAR(summed.curr_id)) AS "contained_item"
FROM   summed
JOIN   ORACLE_SQL.ORACLE_SQL.PACKAGING  p_top
       ON p_top."id" = summed.top_id
LEFT JOIN ORACLE_SQL.ORACLE_SQL.PACKAGING p_item
       ON p_item."id" = summed.curr_id
WHERE  summed.total_qty > 500
LIMIT 20
