          FROM ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS pr
          WHERE pr."packaging_id" NOT IN (SELECT DISTINCT "contains_id"
                                          FROM ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS)
      ),
      r (top_id, curr_id, total_qty) AS (
          SELECT tp."packaging_id" AS top_id,
                 tp."packaging_id" AS curr_id,
                 1::FLOAT          AS total_qty
          FROM top_pkg tp
          UNION ALL
          SELECT r.top_id,
                 pr."contains_id",
                 r.total_qty * pr."qty"
          FROM r
          JOIN ORACLE_SQL.ORACLE_SQL.PACKAGING_RELATIONS pr
            ON pr."packaging_id" = r.curr_id
      ),
      summed AS (
          SELECT r.top_id,
                 r.curr_id,
                 SUM(r.total_qty) AS total_qty
          FROM r
          GROUP BY r.top_id, r.curr_id
      )
    SELECT p_top."name" AS "top_level_container",
           COALESCE(p_item."name", TO_VARCHAR(summed."curr_id")) AS "contained_item",
           summed."total_qty"
