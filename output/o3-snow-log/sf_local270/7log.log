--Description / Thinking process:
-- Objective:  Return the names of every top-level packaging container (i.e., a package
--             that never appears as CONTAINS_ID) that holds more than 500 units of any
--             single leaf item somewhere in its nested hierarchy, along with the leaf
--             item’s name and the quantity.
--
-- Key steps
-- 1. Identify “roots” – packaging_id values that never occur as contains_id.
-- 2. Use a recursive CTE (rec):
--        • Anchor: take every edge (root → child) that emanates from a root.
--        • Recursion: follow PACKAGING_RELATIONS downward; at each step multiply the
--          edge quantity by the running product so cum_qty = product of all edge
--          quantities from the root to the current node.
-- 3. After traversal, rec contains one row for every path.  We aggregate cum_qty for
--    each (root, leaf) pair to get the total quantity a single root container holds of
--    that leaf.
-- 4. A leaf may itself be a packaging unit or a product; we resolve its name with
--    COALESCE(ip.name, pp.name).
-- 5. Filter with HAVING to keep only those combinations whose total_qty > 500.

WITH RECURSIVE rec AS (
    /* Anchor: immediate children of every true root container */
    SELECT
        pr."packaging_id"               AS root_id,
        pr."contains_id"                AS node_id,
        pr."qty"                        AS cum_qty
    FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
    WHERE pr."packaging_id" NOT IN (
          SELECT DISTINCT "contains_id"
          FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS"
    )

    UNION ALL

    /* Recursive step: descend hierarchy, multiplying quantities */
    SELECT
        rec.root_id,
        pr."contains_id",
        rec.cum_qty * pr."qty"          AS cum_qty
    FROM rec
    JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
         ON pr."packaging_id" = rec.node_id
)
SELECT
       rp."name"                                AS "top_level_container",
       COALESCE(ip."name", pp."name")           AS "contained_item",
       SUM(rec.cum_qty)                         AS "total_qty"
FROM rec
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" rp  ON rp."id" = rec.root_id   -- root container name
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" ip  ON ip."id" = rec.node_id   -- leaf if package
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"  pp  ON pp."id" = rec.node_id   -- leaf if product
GROUP BY
       rp."name",
       COALESCE(ip."name", pp."name")
HAVING SUM(rec.cum_qty) > 500
ORDER BY "total_qty" DESC;
