--Description / Thinking process:
-- Goal: list every top-level packaging container (a package that never appears as CONTAINS_ID)
--       which, through its entire nested hierarchy, holds more than 500 units of at least
--       one leaf item, and show the names of both the container and that leaf item.
--
-- Approach
-- 1. Identify “roots” with NOT IN (SELECT DISTINCT CONTAINS_ID …).
-- 2. Use a recursive CTE (rec) to traverse PACKAGING_RELATIONS downward, multiplying
--    quantities along each edge so CUM_QTY = product of all edge quantities from root
--    to the current node.
-- 3. Aggregate cumulative quantities per (root, leaf) pair.
-- 4. Resolve the leaf’s name: if it is itself a packaging unit use PACKAGING.name (ip),
--    otherwise use PRODUCTS.name (pp) — COALESCE picks whichever is not NULL.
-- 5. Keep only pairs whose total quantity > 500.
-- 6. Return the container name, item name, and total quantity, ordered by quantity.

WITH RECURSIVE rec AS (
    /* anchor: direct children of each true root container */
    SELECT
        pr."packaging_id"          AS "root_id",
        pr."contains_id"           AS "node_id",
        pr."qty"                   AS "cum_qty"
    FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
    WHERE pr."packaging_id" NOT IN (
          SELECT DISTINCT "contains_id"
          FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS"
    )

    UNION ALL

    /* recursive step: descend further, multiplying quantities */
    SELECT
        rec."root_id",
        pr."contains_id",
        rec."cum_qty" * pr."qty"   AS "cum_qty"
    FROM rec
    JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
         ON pr."packaging_id" = rec."node_id"
)

SELECT
       rp."name"                               AS "top_level_container",
       COALESCE(ip."name", pp."name")          AS "contained_item",
       SUM(rec."cum_qty")                      AS "total_qty"
FROM rec
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" rp ON rp."id" = rec."root_id"
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" ip ON ip."id" = rec."node_id"   -- leaf is a package
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"  pp ON pp."id" = rec."node_id"   -- leaf is a product
GROUP BY
       rp."name",
       COALESCE(ip."name", pp."name")
HAVING
       SUM(rec."cum_qty") > 500
ORDER BY
       "total_qty" DESC;
