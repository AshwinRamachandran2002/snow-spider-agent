```sql
--Description: 3) Display each (packaging_id → contains_id) pair
--              enriched with the names of both the parent- and child-packages (if any)
SELECT
       pr."packaging_id",
       pp."name"  AS "parent_name",
       pr."contains_id",
       cp."name"  AS "child_name",
       pr."qty"
FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" pp
       ON pp."id" = pr."packaging_id"
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" cp
       ON cp."id" = pr."contains_id"
LIMIT 20;
```

```sql
--Description: 4) Find “top-level” containers – packages that are NEVER found as a child
SELECT DISTINCT
       pr."packaging_id"          AS "root_packaging_id",
       p."name"                   AS "root_packaging_name"
FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" p
       ON p."id" = pr."packaging_id"
WHERE pr."packaging_id" NOT IN (
        SELECT DISTINCT "contains_id"
        FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS"
        WHERE "contains_id" IS NOT NULL
)
LIMIT 20;
```

```sql
--Description: 5) Run a recursive CTE for ONE root (e.g. first top-level id) to see the whole tree,
--              showing the path depth together with the quantity on each edge
WITH RECURSIVE rec AS (       
    SELECT
        pr."packaging_id"     AS "root_id",
        pr."packaging_id"     AS "parent_id",
        pr."contains_id"      AS "child_id",
        pr."qty"              AS "edge_qty",
        1                     AS "lvl"
    FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
    WHERE pr."packaging_id" = (    -- hard-wired to first root for inspection
          SELECT MIN("packaging_id")
          FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr2
          WHERE pr2."packaging_id" NOT IN (
                SELECT DISTINCT "contains_id"
                FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS"
          )
    )

    UNION ALL

    SELECT
        rec."root_id",
        pr."packaging_id",
        pr."contains_id",
        rec."edge_qty" * pr."qty"  AS "edge_qty",
        rec."lvl" + 1
    FROM rec
    JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
      ON pr."packaging_id" = rec."child_id"
)
SELECT *
FROM rec
ORDER BY "lvl", "parent_id", "child_id"
LIMIT 20;
```

```sql
--Description: 6) Extend the recursion for ALL roots, calculate the cumulative
--              (root → leaf) quantity and show only the leaf rows
WITH RECURSIVE rec AS (
    SELECT
        pr."packaging_id"  AS "root_id",
        pr."contains_id"   AS "node_id",
        pr."qty"           AS "cum_qty"
    FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
    WHERE pr."packaging_id" NOT IN (
        SELECT DISTINCT "contains_id"
        FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS"
    )

    UNION ALL

    SELECT
        rec."root_id",
        pr."contains_id",
        rec."cum_qty" * pr."qty"
    FROM rec
    JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
         ON pr."packaging_id" = rec."node_id"
)
SELECT *
FROM rec
WHERE "node_id" NOT IN (SELECT DISTINCT "packaging_id" FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS")
LIMIT 20;
```

```sql
--Description: 7) Aggregate the cumulative quantity per (root, leaf) pair
WITH RECURSIVE rec AS (
    SELECT
        pr."packaging_id"  AS "root_id",
        pr."contains_id"   AS "node_id",
        pr."qty"           AS "cum_qty"
    FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
    WHERE pr."packaging_id" NOT IN (
        SELECT DISTINCT "contains_id"
        FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS"
    )
    UNION ALL
    SELECT
        rec."root_id",
        pr."contains_id",
        rec."cum_qty" * pr."qty"
    FROM rec
    JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
         ON pr."packaging_id" = rec."node_id"
)
SELECT
       rec."root_id",
       rp."name"                       AS "root_name",
       rec."node_id"                   AS "item_id",
       ip."name"                       AS "item_name",
       SUM(rec."cum_qty")              AS "total_qty"
FROM rec
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" rp ON rp."id" = rec."root_id"
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" ip ON ip."id" = rec."item_id"
GROUP BY 1,2,3,4
ORDER BY "total_qty" DESC
LIMIT 20;
```

```sql
--Description: 8) Show only those (root, item) combinations whose total accumulated
--              quantity exceeds 500
WITH RECURSIVE rec AS (
    SELECT
        pr."packaging_id"  AS "root_id",
        pr."contains_id"   AS "node_id",
        pr."qty"           AS "cum_qty"
    FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
    WHERE pr."packaging_id" NOT IN (
        SELECT DISTINCT "contains_id"
        FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS"
    )
    UNION ALL
    SELECT
        rec."root_id",
        pr."contains_id",
        rec."cum_qty" * pr."qty"
    FROM rec
    JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
         ON pr."packaging_id" = rec."node_id"
)
SELECT
       rec."root_id",
       rp."name"          AS "root_name",
       rec."node_id"      AS "item_id",
       ip."name"          AS "item_name",
       SUM(rec."cum_qty") AS "total_qty"
FROM rec
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" rp ON rp."id" = rec."root_id"
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" ip ON ip."id" = rec."item_id"
GROUP BY 1,2,3,4
HAVING SUM(rec."cum_qty") > 500
ORDER BY "total_qty" DESC
LIMIT 20;
```

