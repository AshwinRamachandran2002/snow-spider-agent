```sql
--Description / Thinking process:
-- Goal: list every top-level packaging container (a packaging_id never used as contains_id)
--       that holds, through any level of nested packages, more than 500 units of a single
--       leaf item, along with that item’s name.
--
-- Steps
-- 1) Identify “root” packages (not found as contains_id).
-- 2) Walk the PACKAGING_RELATIONS hierarchy recursively, multiplying quantities on each
--    edge: cum_qty = qty(parent→child) × qty up to the parent.
-- 3) A node that no longer appears as a parent is a leaf.  It can be another packaging
--    unit or a real product; try to resolve the name from PACKAGING first, PRODUCTS
--    second (COALESCE).
-- 4) Aggregate cumulative quantities for every (root, leaf) pair.
-- 5) Keep only those pairs whose total_qty > 500 and present the names.

WITH RECURSIVE rec AS (
    /* Anchor: one step below every root container */
    SELECT
        pr."packaging_id"         AS "root_id",
        pr."contains_id"          AS "node_id",
        pr."qty"                  AS "cum_qty"
    FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
    WHERE pr."packaging_id" NOT IN (
          SELECT DISTINCT "contains_id"
          FROM ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS"
    )

    UNION ALL

    /* Recursive descent, multiplying quantities along the way */
    SELECT
        rec."root_id",
        pr."contains_id",
        rec."cum_qty" * pr."qty"  AS "cum_qty"
    FROM rec
    JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING_RELATIONS" pr
          ON pr."packaging_id" = rec."node_id"
)

SELECT
       rp."name"                              AS "top_level_container",
       COALESCE(pp."name", ip."name")         AS "contained_item",
       SUM(rec."cum_qty")                     AS "total_qty"
FROM rec
/* look-up names */
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" rp  ON rp."id" = rec."root_id"
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PACKAGING" ip  ON ip."id" = rec."node_id"   -- leaf is packaging
