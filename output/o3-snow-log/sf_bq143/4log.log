```sql
-- 1)  Pull Clear-Cell RCC discovery-study proteomics,
--     attach CPTAC-2 sample-type labels,
--     match RNA-seq records on the same submitter-ID and gene,
--     and prepare per-sample numeric values.
WITH joined AS (
    SELECT
        m."sample_type"                                                   AS sample_type,
        p."gene_symbol"                                                   AS gene_symbol,
        p."protein_abundance_log2ratio"                                   AS prot_log2ratio,
        /* log2(FPKM + 1)  ── Snowflake:  log(x)/log(2) */
        LOG( r."fpkm_unstranded" + 1 ) / LOG(2)                           AS expr_log2fpkm
    FROM  CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT  p
    JOIN  CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT            m
          ON p."aliquot_submitter_id" = m."sample_submitter_id"
    JOIN  CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT                                 r
          ON r."sample_barcode"     = m."sample_submitter_id"
         AND r."gene_name"          = p."gene_symbol"
    WHERE m."sample_type" IN ('Primary Tumor','Solid Tissue Normal')
      AND p."protein_abundance_log2ratio" IS NOT NULL
      AND r."fpkm_unstranded"              IS NOT NULL
),

-- 2)  Gene-level Spearman correlation (Pearson for log-space numbers)
--     within each sample-type cohort, discarding |corr| > 0.5.
gene_corr AS (
    SELECT
        sample_type,
        gene_symbol,
        CORR( prot_log2ratio, expr_log2fpkm )     AS corr_val
    FROM   joined
    GROUP  BY sample_type, gene_symbol
    HAVING ABS( CORR( prot_log2ratio, expr_log2fpkm ) ) <= 0.5
)

-- 3)  Average correlation after the |corr| ≤ 0.5 filter.
SELECT
    sample_type,
    AVG( corr_val )                              AS avg_correlation
FROM   gene_corr
GROUP  BY sample_type
ORDER  BY sample_type;
```
