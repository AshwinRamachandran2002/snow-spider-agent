Query:
--Description:
--  Diagnostic version of the original “Solid Tissue Normal” correlation query.
--  Counts how many rows survive the three-way INNER JOIN among
--    • proteome aliquots (p.aliquot_submitter_id)
--    • CPTAC-2 metadata (m.sample_submitter_id → sample_type)
--    • RNA-seq expression (r.sample_barcode)
--  when restricted to “Solid Tissue Normal”.  A result of 0 confirms that no
--  overlapping identifiers exist for this cohort, so the correlation step
--  cannot proceed.
SELECT COUNT(*) AS "normal_three_way_join_rows"
FROM CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT  p
JOIN CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT            m
     ON p."aliquot_submitter_id" = m."sample_submitter_id"
JOIN CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT                                 r
     ON r."sample_barcode"       = m."sample_submitter_id"
WHERE m."sample_type" ILIKE '%Solid Tissue Normal%'
