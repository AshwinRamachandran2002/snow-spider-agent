/*---------------------------------------------------------------
  Goal
  ----
  For Clear-Cell RCC (CCRCC) samples, relate proteomic abundance
  (log2-ratio) to RNA-seq expression (log2(FPKM+1)).

  Strategy
  --------
  1.  Compute the mean proteomic log2-ratio for every
      (sample_type , gene) combination.
  2.  Compute the mean RNA-seq log2(FPKM+1) for the same
      (sample_type , gene) pairs.
  3.  Join the two summaries on both sample_type and gene.
  4.  Within each sample_type, calculate the overall correlation
      across genes.  Retain correlations whose |value| > 0.5
      and report them (each is already the average for its cohort).
----------------------------------------------------------------*/
WITH proteome_avg AS (          -- Step-1
    SELECT
        m."sample_type"                                          AS sample_type,
        p."gene_symbol"                                          AS gene_symbol,
        AVG( p."protein_abundance_log2ratio" )                   AS prot_mean
    FROM CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT  p
    JOIN CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT            m
          ON p."sample_id" = m."sample_submitter_id"
    WHERE m."sample_type" IN ('Primary Tumor','Solid Tissue Normal')
      AND p."protein_abundance_log2ratio" IS NOT NULL
    GROUP BY m."sample_type", p."gene_symbol"
),
rna_avg AS (               -- Step-2
    SELECT
        r."sample_type_name"                                    AS sample_type,
        r."gene_name"                                           AS gene_symbol,
        AVG( LN(r."fpkm_unstranded" + 1) / LN(2) )              AS expr_mean
    FROM CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT  r
    WHERE r."sample_type_name" IN ('Primary Tumor','Solid Tissue Normal')
      AND r."fpkm_unstranded" IS NOT NULL
    GROUP BY r."sample_type_name", r."gene_name"
),
joined AS (                -- Step-3
    SELECT
        p.sample_type,
        p.gene_symbol,
        p.prot_mean,
        r.expr_mean
    FROM proteome_avg p
    JOIN rna_avg      r
      ON r.sample_type  = p.sample_type
     AND r.gene_symbol  = p.gene_symbol
),
corr_by_type AS (          -- Step-4
    SELECT
        sample_type,
        CORR( prot_mean , expr_mean )      AS corr_val
    FROM joined
    GROUP BY sample_type
    HAVING ABS( CORR( prot_mean , expr_mean ) ) > 0.5
)

SELECT
    sample_type,
    corr_val            AS avg_correlation       -- already averaged at cohort level
FROM corr_by_type
ORDER BY sample_type;
