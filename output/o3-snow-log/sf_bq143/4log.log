--        proteome table.
--     2. Collect the DISTINCT “sample_barcode” values from the RNA-seq table.
--     3. COUNT the matches from an INNER JOIN on these two columns.
--   If the result is zero, it confirms that the aliquot IDs never appear as
--   sample barcodes in RNA-seq, which explains the earlier empty result and
--   indicates we must look for a different linking key (e.g., case barcodes or
--   an intermediate mapping table) to integrate proteomics with transcriptomics.
SELECT COUNT(*) AS "proteome_vs_rnaseq_overlap"
FROM (
        SELECT DISTINCT "aliquot_submitter_id"
        FROM CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT
     ) p
INNER JOIN (
        SELECT DISTINCT "sample_barcode"
        FROM CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT
     ) r
ON p."aliquot_submitter_id" = r."sample_barcode";
```
