```sql
--Description / Thinking process:
-- The previous attempts showed that “sample_id” was not a shared key between the
-- CCRCC proteome table and the CPTAC-2 per-sample metadata.  The proteome table
-- also contains “aliquot_submitter_id” values (e.g., “CPT00…”) that resemble the
-- identifiers stored as “sample_submitter_id” in the metadata table.  To test
-- whether these two columns actually overlap, we:
--   1. Pull the DISTINCT list of aliquot IDs from the proteome table.
--   2. Pull the DISTINCT list of sample_submitter_ids from the metadata table.
--   3. Perform an INNER JOIN on these two lists.
--   4. Count the number of matches.  A non-zero result indicates that
--      “aliquot_submitter_id” is the correct field for linking proteomics data
--      to the metadata (and, by extension, to sample_type labels).
SELECT COUNT(*) AS "overlap_count"
FROM (
        SELECT DISTINCT "aliquot_submitter_id"
        FROM CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT
     ) p
JOIN (
        SELECT DISTINCT "sample_submitter_id"
        FROM CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT
     ) m
ON p."aliquot_submitter_id" = m."sample_submitter_id";
```
