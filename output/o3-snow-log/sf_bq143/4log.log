```sql
--Description: For Primary Tumor samples, compute gene-wise correlations
--             between protein (log2 ratio) and log-transformed expression.
SELECT p."gene_symbol",
       CORR(p."protein_abundance_log2ratio",
            LN(r."fpkm_unstranded" + 1))      AS "corr_primary"
FROM CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
JOIN CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT        m
     ON p."sample_id"      = m."sample_submitter_id"
JOIN CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT                             r
     ON r."sample_barcode" = m."sample_submitter_id"
    AND r."gene_name"      = p."gene_symbol"
WHERE m."sample_type" ILIKE '%Primary Tumor%'
GROUP BY p."gene_symbol"
HAVING ABS(CORR(p."protein_abundance_log2ratio",
                LN(r."fpkm_unstranded" + 1))) > 0.5
LIMIT 20;
```

