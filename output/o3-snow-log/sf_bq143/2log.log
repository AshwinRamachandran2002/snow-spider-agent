```sql
--Description: Quantify which key (“sample_id” vs. “aliquot_submitter_id”) actually links the CCRCC
--             proteome table to its metadata.  We join on OR logic, then classify each matched
--             row by the field that provided the hit and count how many rows fall into each
--             category.  This reveals the correct join key to use in later analyses.
SELECT
    CASE
        WHEN m."sample_submitter_id" = p."sample_id"            THEN 'sample_id_match'
        WHEN m."sample_submitter_id" = p."aliquot_submitter_id" THEN 'aliquot_match'
    END                                       AS "match_kind",
    COUNT(*)                                  AS "n_rows"
FROM  CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT  p
JOIN  CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT            m
      ON (m."sample_submitter_id" = p."sample_id"
          OR m."sample_submitter_id" = p."aliquot_submitter_id")
GROUP BY "match_kind"
LIMIT 20;
```
