```sql
--Description:  Because no individual samples are shared between the CCRCC proteome set
--              (aliquot IDs such as “CPT00…”) and the RNA-Seq set (barcodes such as
--              “C3N-…”, “TCGA-…”, etc.), we instead correlate the TWO data types at the
--              GENE level.  For each sample-type (Primary Tumor or Solid Tissue Normal)
--              we first compute the mean protein log2-ratio and the mean log(FPKM+1)
--              for every gene, then calculate the overall correlation across all genes.
WITH prot AS (   -- mean protein abundance per gene & sample-type
    SELECT  p."gene_symbol",
            m."sample_type",
            AVG(p."protein_abundance_log2ratio")   AS "avg_prot"
    FROM    CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
    JOIN    CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT        m
              ON p."aliquot_submitter_id" = m."sample_submitter_id"
    WHERE   m."sample_type" IN ('Primary Tumor', 'Solid Tissue Normal')
    GROUP BY p."gene_symbol", m."sample_type"
),
rna  AS (   -- mean log-transformed RNA abundance per gene & sample-type
    SELECT  r."gene_name"                          AS "gene_symbol",
            r."sample_type_name"                   AS "sample_type",
            AVG(LN(r."fpkm_unstranded" + 1))       AS "avg_rna"
    FROM    CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT r
    WHERE   r."sample_type_name" IN ('Primary Tumor', 'Solid Tissue Normal')
    GROUP BY r."gene_name", r."sample_type_name"
),
paired AS (  -- genes present in BOTH data types for the same sample-type
    SELECT  p."gene_symbol",
            p."sample_type",
            p."avg_prot",
            r."avg_rna"
    FROM    prot p
    JOIN    rna  r
      ON    p."gene_symbol"  = r."gene_symbol"
     AND    p."sample_type"  = r."sample_type"
)
SELECT  "sample_type",
        CORR("avg_prot", "avg_rna")  AS "corr_coef_over_genes"
FROM    paired
GROUP BY "sample_type"
LIMIT 20;
```
