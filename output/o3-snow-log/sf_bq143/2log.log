```sql
/*  Step-by-step:
    1)  Pull CCRCC proteome values and keep only Primary-Tumor / Solid-Tissue-Normal samples
        (sample_type information comes from the CPTAC_2 metadata table).
    2)  Pull CCRCC RNA-Seq values, log2-transform the expression (FPKM+1),
        and again keep only the same two sample-types
        (sample_type_name is provided by the HG38 metadata table).
    3)  Pair protein and RNA measurements that belong to the
        same      – sample_submitter_id
        same gene – gene_symbol
    4)  For every gene within each sample-type, calculate the
        Pearson correlation between protein abundance and RNA abundance.
        Retain only genes whose |correlation| > 0.5.
    5)  Average those per-gene correlations to obtain one number per sample-type.
*/

WITH proteome AS (          -- 1)  CCRCC proteomics + sample-type
    SELECT
        p."sample_id"                   AS "sample_submitter_id",
        p."gene_symbol"                 AS "gene_symbol",
        p."protein_abundance_log2ratio" AS "prot_log2ratio",
        m."sample_type"                 AS "sample_type"
    FROM CPTAC_PDC.CPTAC."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT"  p
    JOIN CPTAC_PDC.CPTAC."PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT"           m
      ON p."sample_id" = m."sample_submitter_id"
    WHERE m."sample_type" IN ('Primary Tumor', 'Solid Tissue Normal')
      AND p."protein_abundance_log2ratio" IS NOT NULL
),

rna AS (                    -- 2)  CCRCC RNA-Seq + sample-type  (log2(FPKM+1))
    SELECT
        r."sample_id"                   AS "sample_submitter_id",
        r."gene_name"                   AS "gene_symbol",
        LOG( r."fpkm_unstranded" + 1 , 2 ) AS "log_fpkm_plus1",
        m."sample_type_name"            AS "sample_type"
    FROM CPTAC_PDC.CPTAC."RNASEQ_HG38_GDC_CURRENT"                               r
    JOIN CPTAC_PDC.CPTAC."PER_SAMPLE_FILE_METADATA_HG38_GDC_CURRENT"             m
      ON r."sample_barcode" = m."sample_barcode"
    WHERE m."sample_type_name" IN ('Primary Tumor', 'Solid Tissue Normal')
      AND r."fpkm_unstranded" IS NOT NULL
),

paired AS (                 -- 3)  match protein + RNA on sample + gene
    SELECT
        p."sample_submitter_id",
        p."sample_type",
        p."gene_symbol",
        p."prot_log2ratio",
        r."log_fpkm_plus1"
    FROM proteome p
    JOIN rna     r
      ON p."sample_submitter_id" = r."sample_submitter_id"
     AND p."gene_symbol"         = r."gene_symbol"
),

gene_corr AS (              -- 4)  per-gene correlation within each sample-type
    SELECT
        "sample_type",
        "gene_symbol",
        CORR( "prot_log2ratio", "log_fpkm_plus1" ) AS "corr_coeff"
    FROM paired
    GROUP BY "sample_type", "gene_symbol"
    HAVING ABS( CORR( "prot_log2ratio", "log_fpkm_plus1" ) ) > 0.5
)

-- 5)  average the retained correlations per sample-type
SELECT
    "sample_type",
    AVG( "corr_coeff" ) AS "average_correlation"
FROM gene_corr
GROUP BY "sample_type"
ORDER BY "sample_type";
```
