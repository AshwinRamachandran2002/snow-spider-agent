```sql
--Description:  Join Proteome→Metadata via “aliquot_submitter_id”, then connect to RNA-Seq
--              via the metadata’s “sample_submitter_id”.  Pull one test gene (COX1) in
--              Primary Tumor samples to confirm that values line up.
SELECT  p."gene_symbol",
        p."protein_abundance_log2ratio",
        LN(r."fpkm_unstranded" + 1)       AS "log_fpkm_plus1",
        m."sample_type"
FROM    CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
JOIN    CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT           m
          ON p."aliquot_submitter_id" = m."sample_submitter_id"
JOIN    CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT                                r
          ON m."sample_submitter_id" = r."sample_barcode"
WHERE   m."sample_type"       = 'Primary Tumor'
  AND   r."sample_type_name"  = 'Primary Tumor'
  AND   p."gene_symbol"       = 'COX1'
  AND   r."gene_name"         = 'COX1'
LIMIT 20;
```

```sql
--Description:  For each gene and sample-type, compute the correlation between protein
--              abundance (log2 ratio) and log-transformed FPKM, keeping only those with
--              |ρ| > 0.5.  Proteome↔Metadata join uses “aliquot_submitter_id”.
SELECT  p."gene_symbol"                          AS "gene",
        m."sample_type"                          AS "sample_type",
        CORR(p."protein_abundance_log2ratio",
             LN(r."fpkm_unstranded" + 1))        AS "corr_coef"
FROM    CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
JOIN    CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT          m
          ON p."aliquot_submitter_id" = m."sample_submitter_id"
JOIN    CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT                               r
          ON m."sample_submitter_id" = r."sample_barcode"
WHERE   m."sample_type" IN ('Primary Tumor', 'Solid Tissue Normal')
  AND   r."sample_type_name" = m."sample_type"
  AND   p."gene_symbol"      = r."gene_name"
GROUP BY p."gene_symbol", m."sample_type"
HAVING  ABS(CORR(p."protein_abundance_log2ratio",
                 LN(r."fpkm_unstranded" + 1))) > 0.5
LIMIT 20;
```

```sql
--Description:  Take the filtered correlations above and compute the average ρ per
--              sample-type (Primary Tumor vs. Solid Tissue Normal).
WITH gene_corr AS (
    SELECT  p."gene_symbol",
            m."sample_type",
            CORR(p."protein_abundance_log2ratio",
                 LN(r."fpkm_unstranded" + 1)) AS "corr_coef"
    FROM    CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
    JOIN    CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT         m
              ON p."aliquot_submitter_id" = m."sample_submitter_id"
    JOIN    CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT                              r
              ON m."sample_submitter_id" = r."sample_barcode"
    WHERE   m."sample_type" IN ('Primary Tumor', 'Solid Tissue Normal')
      AND   r."sample_type_name" = m."sample_type"
      AND   p."gene_symbol"      = r."gene_name"
    GROUP BY p."gene_symbol", m."sample_type"
    HAVING  ABS(CORR(p."protein_abundance_log2ratio",
                     LN(r."fpkm_unstranded" + 1))) > 0.5
)
SELECT  "sample_type",
        AVG("corr_coef") AS "avg_corr_coef"
FROM    gene_corr
GROUP BY "sample_type"
LIMIT 20;
```
