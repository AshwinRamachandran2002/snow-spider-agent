/* -------------------------------------------------------------------------
   Correlation between protein abundance (proteome) and gene expression
   (RNA-Seq) for Clear-Cell RCC samples labelled as
   “Primary Tumor” or “Solid Tissue Normal”.
   -------------------------------------------------------------------------
     1.  Fetch proteome values + sample-type.
     2.  Fetch RNA-Seq values  + sample-type (log2(FPKM+1)).
     3.  Pair protein and RNA on           – sample_submitter_id
                                            – gene_symbol
     4.  For every gene & sample-type, compute the Pearson correlation
         (keep only non-NULL correlations).
     5.  For each sample-type, average only those correlations whose
         absolute value is > 0.5.  If none pass the threshold,
         the average_correlation will be NULL.
--------------------------------------------------------------------------- */

WITH proteome AS (                     /* 1) CCRCC proteome + sample-type */
    SELECT
        p."sample_id"                   AS "sample_submitter_id",
        p."gene_symbol"                 AS "gene_symbol",
        p."protein_abundance_log2ratio" AS "prot_log2ratio",
        m."sample_type"                 AS "sample_type"
    FROM CPTAC_PDC.CPTAC."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT"  p
    JOIN CPTAC_PDC.CPTAC."PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT"            m
          ON p."sample_id" = m."sample_submitter_id"
    WHERE m."sample_type" IN ('Primary Tumor', 'Solid Tissue Normal')
      AND p."protein_abundance_log2ratio" IS NOT NULL
),

rna AS (                               /* 2) RNA-Seq + sample-type */
    SELECT
        r."sample_barcode"                                   AS "sample_submitter_id",
        r."gene_name"                                        AS "gene_symbol",
        LOG2(r."fpkm_unstranded" + 1)                        AS "log_fpkm_plus1",
        m."sample_type_name"                                 AS "sample_type"
    FROM CPTAC_PDC.CPTAC."RNASEQ_HG38_GDC_CURRENT"                               r
    JOIN CPTAC_PDC.CPTAC."PER_SAMPLE_FILE_METADATA_HG38_GDC_CURRENT"             m
          ON r."sample_barcode" = m."sample_barcode"
    WHERE m."sample_type_name" IN ('Primary Tumor', 'Solid Tissue Normal')
      AND r."fpkm_unstranded" IS NOT NULL
),

paired AS (                            /* 3) protein + RNA matched pairs */
    SELECT
        p."sample_submitter_id",
        p."sample_type",
        p."gene_symbol",
        p."prot_log2ratio",
        r."log_fpkm_plus1"
    FROM proteome p
    JOIN rna      r
          ON p."sample_submitter_id" = r."sample_submitter_id"
         AND p."gene_symbol"         = r."gene_symbol"
),

gene_corr AS (                         /* 4) per-gene correlations  */
    SELECT
        "sample_type",
        "gene_symbol",
        CORR("prot_log2ratio", "log_fpkm_plus1") AS "corr_coeff"
    FROM paired
    GROUP BY "sample_type", "gene_symbol"
    HAVING CORR("prot_log2ratio", "log_fpkm_plus1") IS NOT NULL
)

SELECT                                   /* 5) average |corr|>0.5  */
    "sample_type",
    AVG(CASE WHEN ABS("corr_coeff") > 0.5 THEN "corr_coeff" END)
        AS "average_correlation"
FROM gene_corr
GROUP BY "sample_type"
ORDER BY "sample_type";
