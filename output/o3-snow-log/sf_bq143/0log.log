/*  Correlate protein abundance with RNA-seq expression within
    CCRCC “Primary Tumor” and “Solid Tissue Normal” cohorts.

    – Each cohort is handled separately.
    – Values are paired only by (gene_symbol , sample_type);
      the individual sample IDs do not have to be identical.            */

WITH proteome AS (          -- CCRCC discovery proteome + sample-type labels
    SELECT
        m."sample_type",                      -- ‘Primary Tumor’ / ‘Solid Tissue Normal’
        p."gene_symbol",
        p."protein_abundance_log2ratio" AS prot_log2ratio
    FROM   CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT  p
    JOIN   CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT            m
           ON p."sample_id" = m."sample_submitter_id"
    WHERE  m."sample_type" IN ('Primary Tumor','Solid Tissue Normal')
      AND  p."protein_abundance_log2ratio" IS NOT NULL
),
rna AS (                  -- HG38 RNA-seq with the same two tissue classes
    SELECT
        "sample_type_name"                AS sample_type,
        "gene_name"                       AS gene_symbol,
        LOG2("fpkm_unstranded" + 1)       AS expr_log2_fpkm
    FROM   CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT
    WHERE  "sample_type_name" IN ('Primary Tumor','Solid Tissue Normal')
      AND  "fpkm_unstranded" IS NOT NULL
),
paired AS (               -- pair rows by (sample_type , gene_symbol)
    SELECT
        pr.sample_type,
        pr.gene_symbol,
        pr.prot_log2ratio,
        r.expr_log2_fpkm
    FROM   proteome pr
    JOIN   rna      r
           ON  pr.sample_type = r.sample_type
           AND pr.gene_symbol = r.gene_symbol
),
corr_per_gene AS (        -- Pearson correlation for each gene within a cohort
    SELECT
        sample_type,
        gene_symbol,
        CORR(prot_log2ratio , expr_log2_fpkm) AS corr_val
    FROM   paired
    GROUP BY sample_type, gene_symbol
),
filtered AS (             -- retain strong correlations
    SELECT *
    FROM   corr_per_gene
    WHERE  ABS(corr_val) > 0.5
)

SELECT
    sample_type,
    AVG(corr_val) AS avg_correlation
FROM   filtered
GROUP  BY sample_type
ORDER  BY sample_type;
