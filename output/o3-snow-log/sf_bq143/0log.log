       "sample_type"
FROM   CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT
WHERE  "sample_type" IN ('Primary Tumor','Solid Tissue Normal')
LIMIT 20;
```

```sql
--Description: 5)  Quick look at the raw CCRCC discovery proteome table
--              (gene symbol, sample UUID, log2-ratio values, …)
SELECT "sample_id",
       "gene_symbol",
       "protein_abundance_log2ratio"
FROM   CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT
LIMIT 20;
```

```sql
--Description: 6)  Attach the sample-type information to the CCRCC proteome
--              rows so that we can separate “Primary Tumor” and “Normal”
SELECT p."sample_id",
       p."gene_symbol",
       p."protein_abundance_log2ratio",
       m."sample_type"
FROM   CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
JOIN   CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT          m
       ON p."sample_id" = m."sample_submitter_id"
WHERE  m."sample_type" IN ('Primary Tumor','Solid Tissue Normal')
LIMIT 20;
```

```sql
--Description: 7)  Verify that HG38 RNA-seq records for “Primary Tumor”
--              samples are present (gene, sample-barcode, FPKM value, …)
SELECT "sample_barcode",
       "gene_name",
       "fpkm_unstranded",
       "sample_type_name"
FROM   CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT
WHERE  "sample_type_name" = 'Primary Tumor'
LIMIT 20;
```

```sql
--Description: 8)  Same sanity check for “Solid Tissue Normal” RNA-seq rows
SELECT "sample_barcode",
       "gene_name",
       "fpkm_unstranded",
       "sample_type_name"
FROM   CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT
WHERE  "sample_type_name" = 'Solid Tissue Normal'
LIMIT 20;
```

```sql
--Description: 9)  Bring proteome & RNA-seq together: map each CCRCC
--              proteome UUID to its corresponding RNA-seq barcode,
--              keep only identical gene symbols, preview joined values
SELECT p."gene_symbol",
       p."sample_id"                       AS "proteome_sample",
       r."sample_barcode"                  AS "rnaseq_sample",
       p."protein_abundance_log2ratio",
       r."fpkm_unstranded"
FROM   CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
JOIN   CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT          m
       ON p."sample_id" = m."sample_submitter_id"
JOIN   CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT                               r
       ON r."sample_barcode" LIKE m."sample_submitter_id" || '%'
      AND r."gene_name" = p."gene_symbol"
WHERE  m."sample_type" IN ('Primary Tumor','Solid Tissue Normal')
LIMIT 20;
```

```sql
--Description: 10)  Final step – for every gene & sample-type compute the
--               Spearman/Pearson correlation between protein log2-ratio
--               and log10(FPKM+1); keep genes with |corr| > 0.5 and report
--               the average correlation for each tissue class
SELECT  x."sample_type",
        AVG(x."corr_val")  AS "avg_gene_correlation"
FROM   (
        SELECT  p."gene_symbol",
                m."sample_type",
                CORR( p."protein_abundance_log2ratio",
                      LOG10( r."fpkm_unstranded" + 1 ) ) AS "corr_val"
        FROM    CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT  p
        JOIN    CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT            m
                ON p."sample_id" = m."sample_submitter_id"
        JOIN    CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT                                  r
                ON r."sample_barcode" LIKE m."sample_submitter_id" || '%'
               AND r."gene_name" = p."gene_symbol"
        WHERE   m."sample_type" IN ('Primary Tumor','Solid Tissue Normal')
        GROUP BY p."gene_symbol", m."sample_type"
        HAVING  ABS( CORR( p."protein_abundance_log2ratio",
                           LOG10( r."fpkm_unstranded" + 1 ) ) ) > 0.5
       ) x
GROUP BY x."sample_type"
LIMIT 20;
```
