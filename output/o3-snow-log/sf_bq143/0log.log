--Description:
-- Quantify the overlap between UUIDs in the CCRCC proteome table ("sample_id")
-- and UUID-style barcodes in the RNA-seq table ("sample_barcode").  If the
-- count is > 0, it means those two columns can be used as a primary join key
-- for linking proteome and transcriptome data; if 0, we must keep searching
-- for a different mapping strategy.
SELECT  COUNT(*) AS "n_matched_sample_uuids"
FROM   ( SELECT DISTINCT "sample_id"
         FROM   CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT ) p
JOIN   ( SELECT DISTINCT "sample_barcode"
         FROM   CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT ) r
  ON r."sample_barcode" = p."sample_id";
