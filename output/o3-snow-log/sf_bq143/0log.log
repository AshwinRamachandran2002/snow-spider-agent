2025-05-07 06:49:20 - Thread-337 (execute) - INFO - [Try to run SQL in self-refine]
```sql
/*  Correlate protein abundance with RNA-seq expression for
    Clear-Cell RCC (“CCRCC”) ‘Primary Tumor’ and ‘Solid Tissue Normal’ samples.

    Steps
    1)  Limit CCRCC discovery proteome rows to samples whose UUID
        appears in the CPTAC-2 metadata table and is labelled
        “Primary Tumor” or “Solid Tissue Normal”.
    2)  Pull matching RNA-seq rows (same UUID in sample_barcode)
        for the same two tissue classes.
    3)  Join on (sample_uuid , gene_symbol) so every record has
        a paired protein-level and log2(FPKM+1) transcript value.
    4)  Compute Pearson correlation for each (gene , sample_type)
        and keep only |ρ| > 0.5.
    5)  Average those correlations within each tissue class.
*/

WITH proteome AS (
    SELECT
        p."sample_id"                         AS sample_uuid,
        m."sample_type"                       AS sample_type,
        p."gene_symbol"                       AS gene_symbol,
        p."protein_abundance_log2ratio"       AS prot_log2ratio
    FROM   CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT  p
    JOIN   CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT            m
           ON p."sample_id" = m."sample_submitter_id"
    WHERE  m."sample_type" IN ('Primary Tumor','Solid Tissue Normal')
      AND  p."protein_abundance_log2ratio" IS NOT NULL
),

rna AS (
    SELECT
        r."sample_barcode"                    AS sample_uuid,
        r."sample_type_name"                  AS sample_type,
        r."gene_name"                         AS gene_symbol,
        LOG( r."fpkm_unstranded" + 1 , 2 )    AS expr_log2_fpkm
    FROM   CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT  r
    WHERE  r."sample_type_name" IN ('Primary Tumor','Solid Tissue Normal')
      AND  r."fpkm_unstranded" IS NOT NULL
),

paired AS (
    SELECT
        p.sample_type,
        p.gene_symbol,
        p.prot_log2ratio,
        r.expr_log2_fpkm
    FROM proteome p
    JOIN rna     r
      ON  p.sample_uuid = r.sample_uuid     -- same biological sample
     AND p.gene_symbol = r.gene_symbol      -- same gene
),

corr_per_gene AS (
    SELECT
        sample_type,
        gene_symbol,
        CORR(prot_log2ratio , expr_log2_fpkm) AS corr_val
    FROM   paired
    GROUP  BY sample_type, gene_symbol
),

filtered AS (
    SELECT *
    FROM   corr_per_gene
    WHERE  ABS(corr_val) > 0.5
)

SELECT
    sample_type,
    AVG(corr_val)          AS avg_correlation
FROM   filtered
GROUP  BY sample_type
ORDER  BY sample_type;
```
