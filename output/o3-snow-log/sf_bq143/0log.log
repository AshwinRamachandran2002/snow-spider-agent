--Description:  
-- Compute gene-wise Pearson correlations between proteomic log2-ratios and
-- log-transformed (LN) RNA-seq FPKM values, linking datasets through the shared
-- UUID key (proteome.sample_id = rnaseq.sample_barcode).  Keep only “Primary Tumor”
-- and “Solid Tissue Normal” RNA-seq samples, filter to genes with |corr| > 0.5,
-- then report the average correlation for each tissue class.
SELECT  t."sample_type_name",
        AVG(t."corr_val") AS "avg_gene_correlation"
FROM  (
        SELECT  p."gene_symbol",
                r."sample_type_name",
                CORR( p."protein_abundance_log2ratio",
                      LN( r."fpkm_unstranded" + 1 ) ) AS "corr_val"
        FROM    CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
        JOIN    CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT r
               ON r."sample_barcode" = p."sample_id"
              AND r."gene_name"      = p."gene_symbol"
        WHERE   r."sample_type_name" IN ('Primary Tumor','Solid Tissue Normal')
        GROUP BY p."gene_symbol", r."sample_type_name"
        HAVING  ABS( CORR( p."protein_abundance_log2ratio",
                           LN( r."fpkm_unstranded" + 1 ) ) ) > 0.5
      ) t
GROUP BY t."sample_type_name"
LIMIT 20;
