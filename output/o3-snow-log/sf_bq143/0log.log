```sql
/*  Correlate protein abundance with RNA-seq expression in
    CCRCC “Primary Tumor” and “Solid Tissue Normal” cohorts.
    – Correlation is calculated per (gene , sample_type).
    – Correlations with |ρ| > 0.5 are discarded
      and the mean of the remaining values is reported
      for each tissue class.                                          */

WITH proteome AS (            -- CCRCC discovery proteome + tissue labels
    SELECT
        m."sample_type"                         AS sample_type,
        p."gene_symbol"                         AS gene_symbol,
        p."protein_abundance_log2ratio"         AS prot_value
    FROM  CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT  p
    JOIN  CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT            m
          ON p."sample_id" = m."sample_submitter_id"
    WHERE m."sample_type" IN ('Primary Tumor','Solid Tissue Normal')
      AND p."protein_abundance_log2ratio" IS NOT NULL
),
rna AS (                  -- HG38 RNA-seq for the same tissue classes
    SELECT
        "sample_type_name"                                   AS sample_type,
        "gene_name"                                          AS gene_symbol,
        LOG("fpkm_unstranded" + 1) / LOG(2)                  AS expr_log2_fpkm   -- log2(FPKM+1)
    FROM  CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT
    WHERE "sample_type_name" IN ('Primary Tumor','Solid Tissue Normal')
      AND "fpkm_unstranded" IS NOT NULL
),
joined AS (               -- pair rows by (sample_type , gene_symbol)
    SELECT
        pr.sample_type,
        pr.gene_symbol,
        pr.prot_value,
        r.expr_log2_fpkm
    FROM   proteome pr
    JOIN   rna      r
           ON  pr.sample_type = r.sample_type
           AND pr.gene_symbol = r.gene_symbol
),
corr_per_gene AS (        -- Pearson correlation for each gene within a cohort
    SELECT
        sample_type,
        gene_symbol,
        CORR(prot_value , expr_log2_fpkm) AS corr_val
    FROM   joined
    GROUP  BY sample_type, gene_symbol
),
filtered AS (             -- discard strong correlations (|ρ| > 0.5)
    SELECT
        sample_type,
        corr_val
    FROM   corr_per_gene
    WHERE  corr_val IS NOT NULL
      AND  ABS(corr_val) <= 0.5
)

SELECT
    sample_type,
    AVG(corr_val) AS avg_correlation
FROM   filtered
GROUP  BY sample_type
ORDER  BY sample_type;
```
