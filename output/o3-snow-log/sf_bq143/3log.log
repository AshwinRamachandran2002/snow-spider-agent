```sql
--Description:  Retrieve the list of sample identifiers that are common to both the clear-cell
--              RCC discovery proteome dataset (“sample_id”) and the HG38 RNA-seq dataset
--              (“sample_barcode”) **after** restricting the RNA-seq side to records annotated
--              as ‘Primary Tumor’ or ‘Solid Tissue Normal’.  Using INTERSECT guarantees we
--              see only the UUIDs present in both omics tables and meeting the desired
--              clinical-class filter.
WITH rna_filtered AS (
    SELECT DISTINCT "sample_barcode" AS "sample_id"
    FROM   CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT
    WHERE  "sample_type_name" IN ('Primary Tumor', 'Solid Tissue Normal')
)
SELECT *
FROM   (
        SELECT DISTINCT "sample_id"
        FROM   CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT
       ) proteome_ids
INTERSECT
SELECT * FROM rna_filtered
LIMIT 20;
```
