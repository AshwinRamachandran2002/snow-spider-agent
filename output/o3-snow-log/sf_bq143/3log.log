```sql
--Description:  Determine whether any sample identifiers are shared between the clear-cell RCC
--              discovery proteome dataset (“sample_id”) and the HG38 RNA-seq dataset
--              (“sample_barcode”).  We collect the distinct IDs from each table and
--              use INTERSECT to list those present in both.  A non-empty result means
--              the two omics datasets include common samples that can be used for
--              downstream correlation analyses.
WITH proteome_ids AS (
      SELECT DISTINCT "sample_id"
      FROM   CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT
),
rna_ids AS (
      SELECT DISTINCT "sample_barcode"
      FROM   CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT
)
SELECT *
FROM   proteome_ids
INTERSECT
SELECT *
FROM   rna_ids
LIMIT 20;
