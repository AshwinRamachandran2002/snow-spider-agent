/*======================================================================
  Correlate protein-abundance with gene-expression (RNA-seq) for
  Clear-cell Renal Cell Carcinoma (CCRCC) discovery samples.

  – Keep RNA-seq rows whose sample_type_name is
      ‘Primary Tumor’  or  ‘Solid Tissue Normal’.
  – Join the CCRCC proteome table to the RNA-seq table on:
        • identical sample identifier  (proteome.sample_id = rna.sample_barcode)
        • identical gene (gene_symbol = gene_name)
  – For every   gene × sample_type   pair compute the Pearson correlation
    between protein log2-ratio and  log2(FPKM+1).
  – Retain correlations with |ρ| > 0.5 and then average them for each
    sample class.
======================================================================*/
WITH matched_data AS (
    SELECT
        r."sample_type_name"                     AS sample_type,      -- Primary Tumor / Solid Tissue Normal
        p."gene_symbol"                          AS gene_symbol,
        p."protein_abundance_log2ratio"          AS prot_log2ratio,
        LOG(2, r."fpkm_unstranded" + 1)          AS expr_log2_fpkm    -- log2(FPKM+1)
    FROM   CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
    JOIN   CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT                         r
           ON  r."sample_barcode" = p."sample_id"        -- identical UUID
          AND r."gene_name"      = p."gene_symbol"
    WHERE  r."sample_type_name" IN ('Primary Tumor','Solid Tissue Normal')
      AND  p."protein_abundance_log2ratio" IS NOT NULL
      AND  r."fpkm_unstranded"            IS NOT NULL
),
gene_corr AS (                                      -- per-gene correlation
    SELECT
        sample_type,
        gene_symbol,
        CORR(prot_log2ratio, expr_log2_fpkm)  AS corr_value
    FROM matched_data
    GROUP BY sample_type, gene_symbol
    HAVING ABS(CORR(prot_log2ratio, expr_log2_fpkm)) > 0.5
)
SELECT
    sample_type,
    AVG(corr_value)  AS average_correlation
FROM gene_corr
GROUP BY sample_type
ORDER BY sample_type;
