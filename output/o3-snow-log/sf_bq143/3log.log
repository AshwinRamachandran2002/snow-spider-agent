```sql
-- 7) Description:  Pull paired protein & RNA abundance for one arbitrarily chosen gene to confirm numeric overlap.
SELECT p."sample_id",
       m."sample_type",
       p."protein_abundance_log2ratio"  AS "protein",
       r."fpkm_unstranded"              AS "fpkm"
FROM CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
JOIN CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT                               r
     ON p."sample_id" = r."sample_barcode"
     AND p."gene_symbol" = r."gene_name"
JOIN CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT          m
     ON p."sample_id" = m."sample_submitter_id"
WHERE m."sample_type" = 'Primary Tumor'
  AND p."gene_symbol"  = 'VHL'       -- clear-cell RCC hallmark gene for illustration
LIMIT 20;
```

```sql
-- 8) Description:  Compute gene-wise protein-vs-RNA correlation WITHIN Primary Tumor samples.
SELECT p."gene_symbol"                                        AS "gene",
       CORR(p."protein_abundance_log2ratio",
            LOG2(r."fpkm_unstranded" + 1))                   AS "corr_primary"
FROM CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
JOIN CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT                              r
     ON p."sample_id" = r."sample_barcode"
     AND p."gene_symbol" = r."gene_name"
JOIN CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT         m
     ON p."sample_id" = m."sample_submitter_id"
WHERE m."sample_type" = 'Primary Tumor'
GROUP BY p."gene_symbol"
HAVING ABS(CORR(p."protein_abundance_log2ratio",
                LOG2(r."fpkm_unstranded" + 1))) > 0.5
LIMIT 20;
```

```sql
-- 9) Description:  Repeat the correlation calculation for Solid Tissue Normal samples.
SELECT p."gene_symbol"                                        AS "gene",
       CORR(p."protein_abundance_log2ratio",
            LOG2(r."fpkm_unstranded" + 1))                   AS "corr_normal"
FROM CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
JOIN CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT                              r
     ON p."sample_id" = r."sample_barcode"
     AND p."gene_symbol" = r."gene_name"
JOIN CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT         m
     ON p."sample_id" = m."sample_submitter_id"
WHERE m."sample_type" = 'Solid Tissue Normal'
GROUP BY p."gene_symbol"
HAVING ABS(CORR(p."protein_abundance_log2ratio",
                LOG2(r."fpkm_unstranded" + 1))) > 0.5
LIMIT 20;
```

```sql
-- 10) Description:  Combined query:  calculate gene-wise correlations for BOTH sample classes,
--                   filter |corr| > 0.5, then average the correlations within each class.
WITH prot AS (
    SELECT p."sample_id",
           p."gene_symbol",
           p."protein_abundance_log2ratio"
    FROM CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
),
meta AS (
    SELECT "sample_submitter_id" AS "sample_id",
           "sample_type"
    FROM CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT
    WHERE "sample_type" IN ('Primary Tumor','Solid Tissue Normal')
),
rna AS (
    SELECT "sample_barcode"  AS "sample_id",
           "gene_name",
           "fpkm_unstranded",
           "sample_type_name" AS "sample_type"
    FROM CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT
    WHERE "sample_type_name" IN ('Primary Tumor','Solid Tissue Normal')
),
joined AS (
    SELECT m."sample_type",
           prot."gene_symbol",
           prot."protein_abundance_log2ratio"              AS "protein",
           LOG2(rna."fpkm_unstranded" + 1)                 AS "expression"
    FROM prot
    JOIN meta  m  ON prot."sample_id" = m."sample_id"
    JOIN rna       ON prot."sample_id" = rna."sample_id"
                  AND prot."gene_symbol" = rna."gene_name"
                  AND m."sample_type"   = rna."sample_type"
),
gene_corr AS (
    SELECT "gene_symbol",
           "sample_type",
           CORR("protein","expression") AS "corr"
    FROM joined
    GROUP BY "gene_symbol","sample_type"
    HAVING ABS(CORR("protein","expression")) > 0.5
)
SELECT "sample_type",
       AVG("corr") AS "avg_corr_filtered_>|0.5|"
FROM gene_corr
GROUP BY "sample_type"
LIMIT 20;
```
