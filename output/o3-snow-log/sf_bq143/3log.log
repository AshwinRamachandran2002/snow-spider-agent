```sql
/*======================================================================
  Correlate protein abundance with gene–expression (RNA-seq) for the
  Clear-cell Renal Cell Carcinoma (CCRCC) discovery cohort.

  Steps
  1.  Keep only samples annotated as  'Primary Tumor'  or
      'Solid Tissue Normal'  in the CPTAC-2 sample-metadata table.
  2.  Inner-join proteome (CCRCC discovery study) with that metadata
      on the UUID-based sample_submitter_id ⇄ sample_id.
  3.  Inner-join the matching RNA-seq rows (same UUID + same gene).
      The RNA-seq table already carries the same two sample-type names.
  4.  Compute   log2(FPKM + 1)   for expression and calculate the
      Pearson correlation between protein (log2-ratio) and expression
      for every   gene × sample_type   pair.
  5.  Retain only gene-level correlations with |ρ| > 0.5.
  6.  Average the remaining correlations within each sample type.
======================================================================*/
WITH matched_data AS (
    SELECT
        m."sample_type",                       -- Primary Tumor / Solid Tissue Normal
        p."gene_symbol",
        p."protein_abundance_log2ratio"        AS prot_log2ratio,
        LOG( r."fpkm_unstranded" + 1 , 2 )     AS expr_log2_fpkm
    FROM   CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT  p
    JOIN   CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT            m
           ON  m."sample_submitter_id" = p."sample_id"
          AND m."sample_type" IN ('Primary Tumor','Solid Tissue Normal')
    JOIN   CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT                                 r
           ON  r."sample_barcode"   = m."sample_submitter_id"
          AND r."gene_name"         = p."gene_symbol"
          AND r."sample_type_name"  = m."sample_type"          -- enforce same class
    WHERE  p."protein_abundance_log2ratio" IS NOT NULL
      AND  r."fpkm_unstranded"             IS NOT NULL
),
gene_level_corr AS (
    SELECT
        sample_type,
        gene_symbol,
        CORR( prot_log2ratio ,
              expr_log2_fpkm )           AS corr_value
    FROM matched_data
    GROUP BY
        sample_type,
        gene_symbol
    HAVING ABS( CORR( prot_log2ratio , expr_log2_fpkm ) ) > 0.5
)
SELECT
    sample_type,
    AVG( corr_value )  AS average_correlation
FROM gene_level_corr
GROUP BY sample_type
ORDER BY sample_type;
```
