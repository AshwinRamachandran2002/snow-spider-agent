```sql
/*======================================================================
  Correlate protein abundance with gene expression (RNA-seq) for
  Clear-cell Renal Cell Carcinoma (CCRCC) discovery samples.

  – Keep “Primary Tumor” and “Solid Tissue Normal” samples.
  – Join CCRCC proteome ↔ sample-metadata ↔ RNA-seq on UUID sample IDs
    and matching gene names.
  – Compute Pearson correlations for every   gene × sample_type   pair.
  – “Filter out” correlations whose absolute value is > 0.5
      (i.e. keep only |ρ| ≤ 0.5).
  – Report the average of the retained correlations for each sample type.
======================================================================*/
WITH usable_meta AS (              /* tumour / normal rows with UUID IDs */
    SELECT
        "sample_submitter_id"                         AS sample_uuid,
        TRIM("sample_type")                           AS sample_type
    FROM   CPTAC_PDC.CPTAC.PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT
    WHERE  TRIM("sample_type") IN ('Primary Tumor','Solid Tissue Normal')
),
matched_data AS (                  /* proteome ⟷ metadata ⟷ RNA-seq      */
    SELECT
        um.sample_type,                                 -- Primary Tumor / Solid Tissue Normal
        p."gene_symbol"                    AS gene_symbol,
        p."protein_abundance_log2ratio"    AS prot_log2ratio,
        LOG(2, r."fpkm_unstranded" + 1)    AS expr_log2_fpkm             -- log2(FPKM+1)
    FROM  CPTAC_PDC.CPTAC.QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT p
    JOIN  usable_meta               um  ON um.sample_uuid = p."sample_id"
    JOIN  CPTAC_PDC.CPTAC.RNASEQ_HG38_GDC_CURRENT          r
          ON r."sample_barcode" = um.sample_uuid
         AND r."gene_name"      = p."gene_symbol"
    WHERE p."protein_abundance_log2ratio" IS NOT NULL
      AND r."fpkm_unstranded"            IS NOT NULL
),
gene_corr AS (                      /* per-gene correlations, keep |ρ| ≤ 0.5 */
    SELECT
        sample_type,
        gene_symbol,
        CORR(prot_log2ratio, expr_log2_fpkm)  AS corr_value
    FROM   matched_data
    GROUP BY sample_type, gene_symbol
    HAVING ABS(CORR(prot_log2ratio, expr_log2_fpkm)) <= 0.5
)
SELECT
    sample_type,
    AVG(corr_value) AS average_correlation
FROM   gene_corr
GROUP BY sample_type
ORDER BY sample_type;
