--              1) proteome → CPTAC-2 metadata on sample_id = sample_submitter_id to pick up
--                 tumour / normal labels, and
--              2) RNA-seq → proteome only on the shared gene symbol (no sample-ID constraint)
--              so we can at least inspect paired protein vs. transcript numbers together with
--              their sample_type.  The goal is to verify that rows now appear before moving on
--              to correlation calculations.
SELECT
       p."gene_symbol",
       p."protein_abundance_log2ratio"                  AS "protein",
       LOG2(r."fpkm_unstranded" + 1)                    AS "log_fpkm",
       m."sample_type"
FROM   "CPTAC_PDC"."CPTAC"."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT"  p
JOIN   "CPTAC_PDC"."CPTAC"."PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT"            m
       ON p."sample_id" = m."sample_submitter_id"
JOIN   "CPTAC_PDC"."CPTAC"."RNASEQ_HG38_GDC_CURRENT"                                 r
       ON r."gene_name" = p."gene_symbol"
WHERE  m."sample_type" IN ('Primary Tumor', 'Solid Tissue Normal')
  AND  p."protein_abundance_log2ratio" IS NOT NULL
LIMIT  20;
```
