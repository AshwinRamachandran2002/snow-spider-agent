```sql
--Description:  Check whether any UUID “sample_id” values from the CCRCC proteome table
--              appear in the global ALIQUOT_TO_CASE mapping (which might then be used to
--              bridge to other metadata tables containing tumour/normal labels).  If this
--              query returns rows, we’ll know that ALIQUOT_TO_CASE is the right path for
--              linking; if not, we need to try a different key.
SELECT DISTINCT
       a."sample_submitter_id",
       a."sample_type"
FROM   "CPTAC_PDC"."PDC_METADATA"."ALIQUOT_TO_CASE_MAPPING_CURRENT"  a
WHERE  a."sample_submitter_id" IN (
        SELECT DISTINCT
               p."sample_id"
        FROM   "CPTAC_PDC"."CPTAC"."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT" p
        LIMIT  100                        -- limit sub-query to speed up the check
)
LIMIT 20;
