```sql
--Description: First combined view – join proteome, its sample type & RNA-seq on gene symbol
SELECT p."gene_symbol",
       p."protein_abundance_log2ratio"           AS "protein",
       r."fpkm_unstranded"                       AS "fpkm",
       m."sample_type"                           AS "sample_type",
       p."aliquot_submitter_id"                  AS "sample_submitter_id"
FROM   "CPTAC_PDC"."CPTAC"."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT"    p
JOIN   "CPTAC_PDC"."CPTAC"."PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT"              m
       ON p."aliquot_submitter_id" = m."sample_submitter_id"
JOIN   "CPTAC_PDC"."CPTAC"."RNASEQ_HG38_GDC_CURRENT"                                   r
       ON r."gene_name"      = p."gene_symbol"
      AND r."sample_barcode" = m."sample_submitter_id"      -- exploratory join key
WHERE  m."sample_type" IN ('Primary Tumor','Solid Tissue Normal')
LIMIT  20;
```

```sql
--Description: Add log-transformed RNA levels for correlation checks
SELECT p."gene_symbol",
       p."protein_abundance_log2ratio"                       AS "protein",
       LOG2(r."fpkm_unstranded" + 1)                         AS "log_fpkm",
       m."sample_type"
FROM   "CPTAC_PDC"."CPTAC"."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT" p
JOIN   "CPTAC_PDC"."CPTAC"."PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT"           m
       ON p."aliquot_submitter_id" = m."sample_submitter_id"
JOIN   "CPTAC_PDC"."CPTAC"."RNASEQ_HG38_GDC_CURRENT"                                r
       ON r."gene_name"      = p."gene_symbol"
      AND r."sample_barcode" = m."sample_submitter_id"
WHERE  m."sample_type" IN ('Primary Tumor','Solid Tissue Normal')
LIMIT  20;
```

```sql
--Description: Per-gene, per-sample-type correlation; keep |corr| > 0.5
SELECT  p."gene_symbol",
        m."sample_type",
        CORR(p."protein_abundance_log2ratio",
             LOG2(r."fpkm_unstranded" + 1))                   AS "corr_coef",
        COUNT(*)                                              AS "n_obs"
FROM    "CPTAC_PDC"."CPTAC"."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT" p
JOIN    "CPTAC_PDC"."CPTAC"."PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT"          m
        ON p."aliquot_submitter_id" = m."sample_submitter_id"
JOIN    "CPTAC_PDC"."CPTAC"."RNASEQ_HG38_GDC_CURRENT"                               r
        ON r."gene_name"      = p."gene_symbol"
       AND r."sample_barcode" = m."sample_submitter_id"
WHERE   m."sample_type" IN ('Primary Tumor','Solid Tissue Normal')
  AND   p."protein_abundance_log2ratio" IS NOT NULL
GROUP BY p."gene_symbol", m."sample_type"
HAVING  ABS(CORR(p."protein_abundance_log2ratio",
                 LOG2(r."fpkm_unstranded" + 1))) > 0.5
LIMIT   20;
```

```sql
--Description: Average of the filtered correlations for each sample type
SELECT  t."sample_type",
        AVG(t."corr_coef") AS "avg_corr_coef"
FROM   (
        SELECT  p."gene_symbol",
                m."sample_type",
                CORR(p."protein_abundance_log2ratio",
                     LOG2(r."fpkm_unstranded" + 1)) AS "corr_coef"
        FROM    "CPTAC_PDC"."CPTAC"."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT" p
        JOIN    "CPTAC_PDC"."CPTAC"."PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT"          m
               ON p."aliquot_submitter_id" = m."sample_submitter_id"
        JOIN    "CPTAC_PDC"."CPTAC"."RNASEQ_HG38_GDC_CURRENT"                               r
               ON r."gene_name"      = p."gene_symbol"
              AND r."sample_barcode" = m."sample_submitter_id"
        WHERE   m."sample_type" IN ('Primary Tumor','Solid Tissue Normal')
          AND   p."protein_abundance_log2ratio" IS NOT NULL
        GROUP BY p."gene_symbol", m."sample_type"
        HAVING  ABS(CORR(p."protein_abundance_log2ratio",
                         LOG2(r."fpkm_unstranded" + 1))) > 0.5
       ) t
GROUP BY t."sample_type"
LIMIT  20;
```
