```sql
--Description:
-- Demonstrate that a single sample-type mapping bridges proteomics (aliquot-level) and
-- RNA-seq (sample-barcode level) for the CCRCC cohort.  
-- • Step-1: Join proteome table to ALIQUOT_TO_CASE_MAPPING on “aliquot_submitter_id”.  
-- • Step-2: Join the resulting rows to RNA-seq table where “sample_barcode”
--   equals the mapped “sample_submitter_id”.  
-- • Step-3: Restrict to one illustrative gene (“COX1”) and the two desired sample types
--   (“Primary Tumor”, “Solid Tissue Normal”).  
-- • Step-4: Show log-transformed RNA expression together with protein log2 ratio so the
--   user can visually verify paired values needed for a later correlation step.
SELECT
    m."sample_type",
    p."gene_symbol",
    p."protein_abundance_log2ratio"                                    AS "prot_log2ratio",
    LN(r."fpkm_unstranded" + 1)                                        AS "log_fpkm_plus1",
    p."aliquot_submitter_id",
    m."sample_submitter_id"                                            AS "sample_barcode"
FROM CPTAC_PDC.CPTAC."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT" p
JOIN CPTAC_PDC.PDC_METADATA."ALIQUOT_TO_CASE_MAPPING_CURRENT"          m
     ON p."aliquot_submitter_id" = m."aliquot_submitter_id"
JOIN CPTAC_PDC.CPTAC."RNASEQ_HG38_GDC_CURRENT"                         r
     ON r."sample_barcode" = m."sample_submitter_id"
    AND r."gene_name"    = p."gene_symbol"
WHERE p."gene_symbol" = 'COX1'
  AND m."sample_type" IN ('Primary Tumor', 'Solid Tissue Normal')
LIMIT 20;
```
