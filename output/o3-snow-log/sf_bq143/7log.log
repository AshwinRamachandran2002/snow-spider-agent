```sql
--Description:
-- Goal: obtain fast, illustrative protein‒mRNA correlations for clear-cell RCC while
--        avoiding warehouse-timeout by **thinning the data up-front**.
-- Strategy / thinking process
-- 1) Take only proteomics aliquots that already map to a “Primary Tumor” or “Solid Tissue Normal”
--    sample (via ALIQUOT_TO_CASE_MAPPING_CURRENT).  That early filter discards QC, xenograft, etc.
-- 2) Further trim the proteome to ≤ 500 rows *per gene* (ROW_NUMBER … QUALIFY) so that the final
--    joined set is small enough to complete quickly even on modest warehouses.
-- 3) Join the trimmed proteome slice (prot_filtered) to RNA-seq on an exact match of
--    “sample_submitter_id” ↔ “sample_barcode” **and** matching gene symbol.
-- 4) Compute Pearson correlation between protein log2-ratio and log(FPKM + 1) for each
--    gene × sample_type pair; keep only |corr| > 0.5 and show up to 20 rows.
WITH prot_filtered AS (
    SELECT
        p."aliquot_submitter_id",
        p."gene_symbol",
        p."protein_abundance_log2ratio",
        m."sample_submitter_id",
        m."sample_type",
        ROW_NUMBER() OVER (PARTITION BY p."gene_symbol"
                           ORDER BY p."aliquot_submitter_id") AS rn
    FROM CPTAC_PDC.CPTAC."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT" p
    JOIN CPTAC_PDC.PDC_METADATA."ALIQUOT_TO_CASE_MAPPING_CURRENT" m
         ON p."aliquot_submitter_id" = m."aliquot_submitter_id"
    WHERE m."sample_type" IN ('Primary Tumor', 'Solid Tissue Normal')
      AND p."protein_abundance_log2ratio" IS NOT NULL
    QUALIFY rn <= 500            -- cap to 500 aliquot-rows per gene to shrink workload
)
SELECT
    r."gene_name"                 AS "gene_symbol",
    r."sample_type_name"          AS "sample_type",
    CORR(pr."protein_abundance_log2ratio",
         LN(r."fpkm_unstranded" + 1)) AS "pearson_corr"
FROM prot_filtered pr
JOIN CPTAC_PDC.CPTAC."RNASEQ_HG38_GDC_CURRENT" r
     ON r."sample_barcode" = pr."sample_submitter_id"
    AND r."gene_name"     = pr."gene_symbol"
WHERE r."fpkm_unstranded" IS NOT NULL
GROUP BY r."gene_name", r."sample_type_name"
HAVING ABS(CORR(pr."protein_abundance_log2ratio",
                LN(r."fpkm_unstranded" + 1))) > 0.5
LIMIT 20;
```
