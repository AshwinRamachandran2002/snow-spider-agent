--Description:
-- Corrected correlation query that properly connects proteomics to RNA-seq data
-- via the aliquot→sample mapping table (no fuzzy ILIKE concatenation).
-- 1) Proteome table (p) joins to ALIQUOT_TO_CASE_MAPPING (m) on “aliquot_submitter_id”.
-- 2) RNA-seq table (r) then joins on exact equality between r.“sample_barcode”
--    and m.“sample_submitter_id”.
-- 3) Keep only RNA-seq rows labelled “Primary Tumor” or “Solid Tissue Normal”.
-- 4) Compute Pearson correlation between protein log2-ratio and log(FPKM+1) for each
--    gene within each sample type.  Filter to |corr| > 0.5, show first 20 rows.
SELECT
    r."gene_name"                                                               AS "gene_symbol",
    r."sample_type_name"                                                        AS "sample_type",
    CORR(p."protein_abundance_log2ratio",
         LN(r."fpkm_unstranded" + 1))                                           AS "pearson_corr"
FROM CPTAC_PDC.CPTAC."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT" p
JOIN CPTAC_PDC.PDC_METADATA."ALIQUOT_TO_CASE_MAPPING_CURRENT"               m
     ON p."aliquot_submitter_id" = m."aliquot_submitter_id"
JOIN CPTAC_PDC.CPTAC."RNASEQ_HG38_GDC_CURRENT"                               r
     ON r."sample_barcode" = m."sample_submitter_id"
WHERE r."sample_type_name" IN ('Primary Tumor', 'Solid Tissue Normal')
GROUP BY r."gene_name", r."sample_type_name"
HAVING ABS(CORR(p."protein_abundance_log2ratio",
                LN(r."fpkm_unstranded" + 1))) > 0.5
LIMIT 20;
