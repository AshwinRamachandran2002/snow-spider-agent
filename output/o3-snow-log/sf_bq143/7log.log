```sql
-- 10) Correlation between protein (log2 ratio) and RNA-seq (log(FPKM+1))
SELECT r."gene_name"                          AS "gene_symbol",
       r."sample_type_name"                   AS "sample_type",
       CORR(p."protein_abundance_log2ratio",
            LN(r."fpkm_unstranded" + 1))      AS "pearson_corr"
FROM CPTAC_PDC.CPTAC."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT" p
JOIN CPTAC_PDC.CPTAC."RNASEQ_HG38_GDC_CURRENT" r
     ON r."gene_name" = p."gene_symbol"
JOIN CPTAC_PDC.PDC_METADATA."ALIQUOT_TO_CASE_MAPPING_CURRENT" m
     ON p."aliquot_submitter_id" = m."aliquot_submitter_id"
     AND r."sample_barcode" ILIKE m."sample_submitter_id" || '%'
WHERE r."sample_type_name" IN ('Primary Tumor', 'Solid Tissue Normal')
GROUP BY r."gene_name", r."sample_type_name"
HAVING ABS(CORR(p."protein_abundance_log2ratio",
                LN(r."fpkm_unstranded" + 1))) > 0.5
LIMIT 20;
