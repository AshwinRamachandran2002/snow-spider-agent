--Description: Identify sample barcodes that are present in BOTH the RNA-Seq table
--             (“sample_barcode”) and the CCRCC proteomics table (“sample_id”).
--             Join on the barcode only (no gene filter) and count how many proteomic
--             rows each shared sample has.  Display up to 20 barcodes together with
--             their RNA sample-type label and the number of overlapping proteome rows.
SELECT
  r."sample_barcode",
  r."sample_type_name",
  COUNT(*) AS "matched_proteome_rows"
FROM CPTAC_PDC.CPTAC."RNASEQ_HG38_GDC_CURRENT"                       r
JOIN CPTAC_PDC.CPTAC."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT" p
     ON p."sample_id" = r."sample_barcode"
GROUP BY
  r."sample_barcode",
  r."sample_type_name"
ORDER BY
  "matched_proteome_rows" DESC
LIMIT 20;
