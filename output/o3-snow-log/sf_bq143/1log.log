/*---------------------------------------------------------------------------
  1.  Filter RNA-Seq data to the two required sample types and
      compute log2(FPKM+1) expression values.
  2.  Keep only non-null protein ratios from the CCRCC proteome table.
  3.  Join the two matrices by
        – identical sample identifier  (RNA: sample_barcode, Proteome: sample_id)
        – identical gene symbol / gene name
  4.  For every (gene, sample_type) pair calculate the Pearson correlation
      between protein abundance and mRNA expression across all matched samples.
  5.  Retain correlations whose absolute value is larger than 0.5 and
      compute the average correlation for each sample type.
---------------------------------------------------------------------------*/
WITH filtered_rna AS (
    SELECT
        "sample_barcode"                  AS sample_id,
        "gene_name"                       AS gene_symbol,
        LOG2("fpkm_unstranded" + 1)       AS expr_log2_fpkm,
        "sample_type_name"                AS sample_type
    FROM CPTAC_PDC.CPTAC."RNASEQ_HG38_GDC_CURRENT"
    WHERE "sample_type_name" IN ('Primary Tumor', 'Solid Tissue Normal')
          AND "fpkm_unstranded" IS NOT NULL
), filtered_proteome AS (
    SELECT
        "sample_id",
        "gene_symbol",
        "protein_abundance_log2ratio"
    FROM CPTAC_PDC.CPTAC."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT"
    WHERE "protein_abundance_log2ratio" IS NOT NULL
), joined_matrix AS (
    SELECT
        r.sample_type,
        r.gene_symbol,
        r.expr_log2_fpkm,
        p."protein_abundance_log2ratio"   AS prot_log2ratio
    FROM filtered_rna      r
    JOIN filtered_proteome p
      ON r.sample_id   = p."sample_id"
     AND r.gene_symbol = p."gene_symbol"
), per_gene_corr AS (
    SELECT
        sample_type,
        gene_symbol,
        CORR(expr_log2_fpkm, prot_log2ratio) AS corr_val
    FROM joined_matrix
    GROUP BY sample_type, gene_symbol
)
SELECT
    sample_type,
    AVG(corr_val) AS average_correlation
FROM per_gene_corr
WHERE ABS(corr_val) > 0.5
GROUP BY sample_type
ORDER BY sample_type;
```
