```sql
--Description: Probe for overlapping rows between RNA-Seq and CCRCC proteomics that
--             represent the mitochondrial cytochrome-c oxidase subunit 1, which can be
--             labeled “COX1” in proteomics and “MT-CO1” (or “COX1”) in RNA-Seq.
--             1) Join on the shared UUID barcode:  RNA "sample_barcode" ↔ proteome "sample_id".
--             2) Keep only RNA rows annotated as “Primary Tumor”.
--             3) Accept either naming convention on each side, but require that the
--                gene identifiers correspond to the same biology:
--                   • proteome gene_symbol  = 'COX1'  OR 'MT-CO1'
--                   • RNA     gene_name     = 'COX1'  OR 'MT-CO1'
--             Return 20 rows showing both identifiers, plus protein log2-ratio and
--             RNA log2(FPKM+1), so we can confirm successful overlap.
SELECT
  r."sample_barcode",
  r."gene_name"                       AS "rna_gene",
  p."gene_symbol"                     AS "prot_gene",
  p."protein_abundance_log2ratio"     AS "prot_log2ratio",
  LN(r."fpkm_unstranded" + 1) / LN(2) AS "rna_log2fpkm"
FROM CPTAC_PDC.CPTAC."RNASEQ_HG38_GDC_CURRENT"                       r
JOIN CPTAC_PDC.CPTAC."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT" p
     ON p."sample_id" = r."sample_barcode"
WHERE r."sample_type_name" = 'Primary Tumor'
  AND (
        (p."gene_symbol" IN ('COX1', 'MT-CO1') AND r."gene_name" IN ('COX1', 'MT-CO1'))
      )
LIMIT 20;
```
