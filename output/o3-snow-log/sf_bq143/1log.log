```sql
-- 8. Join RNA-Seq and the CPTAC-2 sample-metadata table to keep only  
--    CCRCC Primary Tumor samples, and compute one example correlation  
--    (here for the gene “COX1”) between protein log2-ratio and log2(FPKM+1)
SELECT 
  r."sample_barcode",
  p."protein_abundance_log2ratio"            AS "prot_log2ratio",
  LN(r."fpkm_unstranded" + 1) / LN(2)        AS "rna_log2fpkm",
  CORR(p."protein_abundance_log2ratio",
       LN(r."fpkm_unstranded" + 1) / LN(2))  OVER ()       AS "corr_COX1_primary"
FROM CPTAC_PDC.CPTAC."RNASEQ_HG38_GDC_CURRENT"       r
JOIN CPTAC_PDC.CPTAC."PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT" m
     ON r."sample_barcode" = m."sample_submitter_id"
JOIN CPTAC_PDC.CPTAC."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT" p
     ON p."gene_symbol"   = r."gene_name"
    AND p."sample_id"     = r."sample_barcode"
WHERE m."sample_type"     = 'Primary Tumor'
  AND r."gene_name"       = 'COX1'
  AND p."gene_symbol"     = 'COX1'
LIMIT 20;
```

```sql
-- 9. Repeat the same style join & correlation for “Solid Tissue Normal” samples
SELECT 
  r."sample_barcode",
  p."protein_abundance_log2ratio"            AS "prot_log2ratio",
  LN(r."fpkm_unstranded" + 1) / LN(2)        AS "rna_log2fpkm",
  CORR(p."protein_abundance_log2ratio",
       LN(r."fpkm_unstranded" + 1) / LN(2))  OVER ()       AS "corr_COX1_normal"
FROM CPTAC_PDC.CPTAC."RNASEQ_HG38_GDC_CURRENT"       r
JOIN CPTAC_PDC.CPTAC."PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT" m
     ON r."sample_barcode" = m."sample_submitter_id"
JOIN CPTAC_PDC.CPTAC."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT" p
     ON p."gene_symbol"   = r."gene_name"
    AND p."sample_id"     = r."sample_barcode"
WHERE m."sample_type"     = 'Solid Tissue Normal'
  AND r."gene_name"       = 'COX1'
  AND p."gene_symbol"     = 'COX1'
LIMIT 20;
```

```sql
-- 10. General query to compute gene-wise correlations for every gene,  
--     keep only |corr| > 0.5, and then summarise the average correlation  
--     separately for Primary Tumor vs Solid Tissue Normal samples
WITH joined AS (
  SELECT
    m."sample_type",
    p."gene_symbol",
    p."protein_abundance_log2ratio"                AS prot,
    LN(r."fpkm_unstranded" + 1) / LN(2)            AS rna
  FROM CPTAC_PDC.CPTAC."RNASEQ_HG38_GDC_CURRENT"          r
  JOIN CPTAC_PDC.CPTAC."PER_SAMPLE_FILE_METADATA_CPTAC_2_PDC_CURRENT" m
       ON r."sample_barcode" = m."sample_submitter_id"
  JOIN CPTAC_PDC.CPTAC."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT" p
       ON p."gene_symbol" = r."gene_name"
      AND p."sample_id"   = r."sample_barcode"
  WHERE m."sample_type" IN ('Primary Tumor', 'Solid Tissue Normal')
),
gene_corr AS (
  SELECT
    "sample_type",
    "gene_symbol",
    CORR(prot, rna) AS corr_gene
  FROM joined
  GROUP BY "sample_type", "gene_symbol"
  HAVING ABS(CORR(prot, rna)) > 0.5
)
SELECT
  "sample_type",
  AVG(corr_gene) AS avg_corr_filtered
FROM gene_corr
GROUP BY "sample_type"
LIMIT 20;
```

These ten queries progress from simple table exploration to increasingly complex joins and finally illustrate how to calculate the filtered gene-wise correlations and their averages for the two sample types of interest, all while enclosing every column name in double quotes and limiting outputs to 20 rows.
