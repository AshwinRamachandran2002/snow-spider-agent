  LN(r."fpkm_unstranded" + 1) / LN(2)        AS "rna_log2fpkm",
  CORR(p."protein_abundance_log2ratio",
       LN(r."fpkm_unstranded" + 1) / LN(2))  OVER () AS "corr_COX1_primary"
