--Description:  The previous INNER JOIN failed because “sample_id” (a UUID in the proteome table)
--              has no counterpart in the CPTAC-3 metadata.  Many CPTAC-3 “sample_submitter_id”
--              values, however, begin with the same “CPT…” prefix found in the proteome
--              “aliquot_submitter_id”.  Therefore, attempt the join on those matching codes:
--              link proteome “aliquot_submitter_id” to metadata “sample_submitter_id”, and
--              display the first 20 matches together with their sample_type labels.
SELECT p."aliquot_submitter_id",
       m."sample_submitter_id",
       m."sample_type",
       p."gene_symbol",
       p."protein_abundance_log2ratio"
FROM   "CPTAC_PDC"."CPTAC"."QUANT_PROTEOME_CPTAC_CCRCC_DISCOVERY_STUDY_PDC_CURRENT"                          p
JOIN   "CPTAC_PDC"."CPTAC"."PER_SAMPLE_FILE_METADATA_CPTAC3_DISCOVERY_AND_CONFIRMATORY_PDC_CURRENT"          m
       ON p."aliquot_submitter_id" = m."sample_submitter_id"
LIMIT 20;
