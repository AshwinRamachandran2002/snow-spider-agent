Query:
--Description:  Pull twenty RNA-seq records from ccRCC (“Clear Cell” & “Renal”) cases that are
--              annotated as “Primary Tumor”.  First identify case IDs whose disease_type
--              contains BOTH “Renal” and “Clear Cell”, then fetch their expression rows.
SELECT  r."case_barcode",
        r."sample_barcode",
        r."gene_name",
        r."fpkm_unstranded",
        r."sample_type_name"
FROM    "CPTAC_PDC"."CPTAC"."RNASEQ_HG38_GDC_CURRENT"  r
WHERE   r."sample_type_name" = 'Primary Tumor'
  AND   r."case_barcode" IN (
          SELECT DISTINCT "case_submitter_id"
          FROM   "CPTAC_PDC"."PDC_METADATA"."CASE_METADATA_CURRENT"
          WHERE  "disease_type" ILIKE '%Renal%'
            AND  "disease_type" ILIKE '%Clear%Cell%'
        )
LIMIT 20
Answer:
