/*  Count counties where
 *    (1) unemployment rose between calendar-years 2015 and 2018
 *    (2) dual-eligible enrollment fell between 2015-12-01 and 2018-12-01
 */
WITH acs AS (   /*-- 5-year ACS unemployment by county */
    SELECT
        INITCAP(REGEXP_REPLACE("geo_name",' County',''))                AS county_name,
        SUM(CASE WHEN EXTRACT(YEAR FROM "do_date") = 2015 
                 THEN "unemployed_pop" END)                            AS unemp_2015,
        SUM(CASE WHEN EXTRACT(YEAR FROM "do_date") = 2018 
                 THEN "unemployed_pop" END)                            AS unemp_2018
    FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
    WHERE  EXTRACT(YEAR FROM "do_date") IN (2015, 2018)
    GROUP  BY county_name
),
acs_growth AS (      /* counties whose unemployment increased */
    SELECT county_name
    FROM   acs
    WHERE  unemp_2018 > unemp_2015
),

cms AS (   /*-- Dual-eligible enrollment snapshots */
    SELECT
        INITCAP("County_Name")                                         AS county_name,
        MAX(CASE WHEN "Date" = '2015-12-01' THEN "Public_Total" END)   AS dual_2015,
        MAX(CASE WHEN "Date" = '2018-12-01' THEN "Public_Total" END)   AS dual_2018
    FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    WHERE  "Date" IN ('2015-12-01','2018-12-01')
    GROUP  BY county_name
),
cms_decline AS (      /* counties whose dual enrollment decreased */
    SELECT county_name
    FROM   cms
    WHERE  dual_2018 < dual_2015
)

SELECT COUNT(DISTINCT g.county_name) AS "cnt_counties_unemp_up_duals_down"
FROM   acs_growth  g
JOIN   cms_decline d
       ON LOWER(g.county_name) = LOWER(d.county_name);
```
