```sql
--Description: “START” is a reserved word, which caused the previous compilation error.  
--Rename the CTEs to START_YR (earliest year) and END_YR (latest year).  
--Step-by-step:  
-- 1) START_YR collects unemployment totals for the minimum year found in the table.  
-- 2) END_YR collects unemployment totals for the maximum year found.  
-- 3) Join the two CTEs on geo_id and keep only those ZIPs where unemployment increased.  
--This single query returns the first 20 ZIP codes meeting the criterion, displaying both year totals.  
WITH START_YR AS (  
        SELECT "geo_id",
               SUM("unemployed_pop") AS "unemployed_start"
        FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
        WHERE  EXTRACT(year FROM "do_date") = (
                 SELECT MIN(EXTRACT(year FROM "do_date"))
                 FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR )
        GROUP BY "geo_id"
     ),
     END_YR AS (
        SELECT "geo_id",
               SUM("unemployed_pop") AS "unemployed_end"
        FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
        WHERE  EXTRACT(year FROM "do_date") = (
                 SELECT MAX(EXTRACT(year FROM "do_date"))
                 FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR )
        GROUP BY "geo_id"
     )
SELECT s."geo_id",
       s."unemployed_start",
       e."unemployed_end"
FROM   START_YR s
