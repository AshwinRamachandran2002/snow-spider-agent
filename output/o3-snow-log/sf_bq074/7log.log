```sql
--Description: (Logic demo) Combine ZIP-level unemployment increases with counties showing dual-enrollment decreases, once a ZIP-to-county
--mapping table (not provided here) is available.  Replace MAP_TABLE.* with the real mapping when it is identified.
WITH start AS (  /* unemployment earliest year */ 
        SELECT "geo_id",
               SUM("unemployed_pop") AS "unemployed_start"
        FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
        WHERE  EXTRACT(year FROM "do_date") = (
                  SELECT MIN(EXTRACT(year FROM "do_date"))
                  FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR )
        GROUP BY "geo_id"),
     finish AS ( /* unemployment latest year */
        SELECT "geo_id",
               SUM("unemployed_pop") AS "unemployed_end"
        FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
        WHERE  EXTRACT(year FROM "do_date") = (
                  SELECT MAX(EXTRACT(year FROM "do_date"))
                  FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR )
        GROUP BY "geo_id"),
     zip_increase AS (
        SELECT f."geo_id", s."unemployed_start", f."unemployed_end"
        FROM   start  s
        JOIN   finish f ON s."geo_id" = f."geo_id"
        WHERE  f."unemployed_end" > s."unemployed_start"),
     county_dual_drop AS (
        SELECT LOWER(c."County_Name") AS "county_lc",
               c."total_duals_2015",
               d."total_duals_2018"
        FROM (
               SELECT "County_Name",
                      "Public_Total" AS "total_duals_2015"
               FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
               WHERE  "Date" = '2015-12-01') c
        JOIN (
               SELECT "County_Name",
                      "Public_Total" AS "total_duals_2018"
               FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
               WHERE  "Date" = '2018-12-01') d
        ON LOWER(c."County_Name") = LOWER(d."County_Name")
        WHERE d."total_duals_2018" < c."total_duals_2015")
/* A real mapping table (e.g., ZIP_TO_COUNTY) with columns "ZIP" and "County_Name" is required here */
SELECT cd."county_lc",
       COUNT(DISTINCT zi."geo_id") AS "num_zips_with_unemp_increase"
FROM   zip_increase zi
JOIN   SOME_DB.SOME_SCHEMA.ZIP_TO_COUNTY map
          ON  zi."geo_id" = map."ZIP"
JOIN   county_dual_drop cd
          ON  LOWER(map."County_Name") = cd."county_lc"
GROUP  BY cd."county_lc"
LIMIT 20;
```

