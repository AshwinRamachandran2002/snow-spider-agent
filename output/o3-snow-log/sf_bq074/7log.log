```sql
--Description: We don’t have a ZIP-to-county bridge table in the accessible catalog, so we focus solely on the CMS
--dual-eligible enrollment table.  This query:
-- 1) Finds the table’s earliest and latest snapshot dates.
-- 2) Retrieves each county’s Public_Total at those two dates.
-- 3) Counts how many counties show a lower Public_Total in the latest snapshot than in the earliest,
--    giving the number of counties where dual-eligible enrollment declined over the full period.
WITH earliest AS (
        SELECT LOWER("County_Name") AS "county_lc",
               "Public_Total"      AS "duals_earliest"
        FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
        WHERE  "Date" = (SELECT MIN("Date")
                         FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM)
     ),
     latest AS (
        SELECT LOWER("County_Name") AS "county_lc",
               "Public_Total"      AS "duals_latest"
        FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
        WHERE  "Date" = (SELECT MAX("Date")
                         FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM)
     )
SELECT COUNT(*) AS "cnt_counties_duals_decreased"
FROM   earliest e
JOIN   latest   l
       ON e."county_lc" = l."county_lc"
WHERE  l."duals_latest" < e."duals_earliest";
```
