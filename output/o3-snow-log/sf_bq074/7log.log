```sql
--Description: Count how many counties experienced a decline in dual-eligible enrollment between the dataset’s
--earliest and latest snapshot dates.  The query (1) captures totals at the minimum and maximum dates,
--(2) joins on county name (lower-cased for case-insensitive match), and (3) counts distinct counties whose
--latest total < earliest total.
WITH earliest AS (
        SELECT LOWER("County_Name") AS county_lc,
               "Public_Total"      AS duals_earliest
        FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
        WHERE  "Date" = (
                 SELECT MIN("Date")
                 FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM)
     ),
     latest AS (
        SELECT LOWER("County_Name") AS county_lc,
               "Public_Total"      AS duals_latest
        FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
        WHERE  "Date" = (
                 SELECT MAX("Date")
                 FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM)
     )
SELECT COUNT(DISTINCT e.county_lc) AS cnt_counties_duals_decreased
FROM   earliest e
JOIN   latest   l  ON e.county_lc = l.county_lc
WHERE  l.duals_latest < e.duals_earliest;
```
