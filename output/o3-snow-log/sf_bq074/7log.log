```sql
--Description: Identify ZIP codes whose unemployment increased between the earliest and latest available ACS years (no hard-coded dates).
WITH start AS (
        SELECT "geo_id",
               SUM("unemployed_pop") AS "unemployed_start"
        FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
        WHERE  EXTRACT(year FROM "do_date") = (
                   SELECT MIN(EXTRACT(year FROM "do_date"))
                   FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
               )
        GROUP BY "geo_id"
     ),
     finish AS (
        SELECT "geo_id",
               SUM("unemployed_pop") AS "unemployed_end"
        FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
        WHERE  EXTRACT(year FROM "do_date") = (
                   SELECT MAX(EXTRACT(year FROM "do_date"))
                   FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
               )
        GROUP BY "geo_id"
     )
SELECT s."geo_id",
       s."unemployed_start",
       f."unemployed_end"
FROM   start s
JOIN   finish f
       ON s."geo_id" = f."geo_id"
WHERE  f."unemployed_end" > s."unemployed_start"
LIMIT 20;
