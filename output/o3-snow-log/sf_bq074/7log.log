--Description: (Placeholder final step) Count counties that meet BOTH criteria after the ZIP-to-county bridge is supplied.
WITH zip_increase AS ( /* same logic as previous CTE for unemployment */ ),
     county_dual_drop AS ( /* same logic as previous CTE for enrollment */ ),
     joined AS (
        SELECT DISTINCT cd."county_lc"
        FROM   zip_increase zi
        JOIN   SOME_DB.SOME_SCHEMA.ZIP_TO_COUNTY map
               ON zi."geo_id" = map."ZIP"
        JOIN   county_dual_drop cd
               ON LOWER(map."County_Name") = cd."county_lc" )
SELECT COUNT(*) AS "cnt_counties"
FROM   joined;
