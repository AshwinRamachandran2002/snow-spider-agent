),
cnt AS (
    SELECT  "County_Name",
            SUM(CASE WHEN "Date" = b."start_date" THEN "Public_Total" END) AS "dual_start",
            SUM(CASE WHEN "Date" = b."end_date"   THEN "Public_Total" END) AS "dual_end"
    FROM    SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM",
            bounds b
    GROUP BY "County_Name"
)
SELECT *
FROM   cnt
WHERE  "dual_end" < "dual_start"
LIMIT  20;
