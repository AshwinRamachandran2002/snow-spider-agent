```sql
--Description: Compare unemployment in the earliest vs latest year that actually exist in the table (rather than assuming 2015/2018)
WITH yr_bounds AS (
    SELECT MIN(YEAR("do_date")) AS "yr_start",
           MAX(YEAR("do_date")) AS "yr_end"
    FROM   SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
)
SELECT  z."geo_id",
        SUM(CASE WHEN YEAR(z."do_date") = y."yr_start" THEN z."unemployed_pop" END) AS "unemp_start",
        SUM(CASE WHEN YEAR(z."do_date") = y."yr_end"   THEN z."unemployed_pop" END) AS "unemp_end"
FROM    SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z
CROSS JOIN yr_bounds y
GROUP BY z."geo_id"
HAVING  "unemp_end" > "unemp_start"
LIMIT   20;
```

