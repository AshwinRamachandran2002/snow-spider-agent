```sql
/*  STEP-BY-STEP LOGIC
    1.  Build a county–level unemployment series from the 5-year ACS ZIP file, keeping only 2015
        and 2018 values and flagging the counties whose 2018 total is larger than their 2015 total.
        – The first five characters of every ACS ZIP ‘geo_id’ are the 5-digit county-FIPS code.
    2.  Build a county-level dual-eligible series with one record for 2015-12-01 and one for
        2018-12-01, then keep the counties whose 2018 enrollee count is smaller than their 2015
        count.  The CMS file already carries state- and county-code columns, so the same 5-digit
        county-FIPS key can be reconstructed with LPAD().
    3.  Join the two filtered lists on that FIPS key and count the surviving counties.
*/
WITH unemployment_15_vs_18 AS (          -- ↑-- counties whose unemployment ROSE
    SELECT
        LEFT("geo_id",5)                           AS county_fips ,
        SUM(CASE WHEN YEAR("do_date") = 2015
                 THEN COALESCE("unemployed_pop",0) END)     AS unemp_2015 ,
        SUM(CASE WHEN YEAR("do_date") = 2018
                 THEN COALESCE("unemployed_pop",0) END)     AS unemp_2018
    FROM   SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
    WHERE  YEAR("do_date") IN (2015, 2018)
    GROUP  BY county_fips
    HAVING unemp_2018 > unemp_2015
),
dual_enrollment_15_vs_18 AS (            -- ↑-- counties whose dual enrollment FELL
    SELECT
        LPAD(CAST("State_Code"  AS TEXT),2,'0')||
        LPAD(CAST("County_Code" AS TEXT),3,'0')     AS county_fips ,
        MAX(CASE WHEN "Date" = '2015-12-01' THEN "Public_Total" END) AS dual_2015 ,
        MAX(CASE WHEN "Date" = '2018-12-01' THEN "Public_Total" END) AS dual_2018
    FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
    WHERE  "Date" IN ('2015-12-01','2018-12-01')
    GROUP  BY county_fips
    HAVING dual_2018 < dual_2015
)
SELECT COUNT(*) AS counties_meeting_both_conditions
FROM   unemployment_15_vs_18  AS u
JOIN   dual_enrollment_15_vs_18 AS d
       USING (county_fips);
```
