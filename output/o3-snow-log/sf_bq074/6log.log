```sql
--Description: Bring unemployment (ZIP) and dual-eligible (county) data together by mapping ZIPs to counties via a simple name join (illustrative ‑ adjust mapping logic as needed)  
WITH unemp AS (
    SELECT  z."geo_id",
            TRIM(z."geo_id")                       AS "zip_code",
            SUM(CASE WHEN YEAR(z."do_date") = 2015 THEN z."unemployed_pop" END) AS "unemp_2015",
            SUM(CASE WHEN YEAR(z."do_date") = 2018 THEN z."unemployed_pop" END) AS "unemp_2018"
    FROM    SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR z
    WHERE   YEAR(z."do_date") IN (2015, 2018)
    GROUP BY z."geo_id"
),
dual AS (
    SELECT  INITCAP("County_Name") AS "county_name",
            SUM(CASE WHEN "Date" = '2015-12-01' THEN "Public_Total" END) AS "dual_2015",
            SUM(CASE WHEN "Date" = '2018-12-01' THEN "Public_Total" END) AS "dual_2018"
    FROM    SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    WHERE   "Date" IN ('2015-12-01','2018-12-01')
    GROUP BY INITCAP("County_Name")
)
-- Dummy join placeholder: replace with real ZIP-to-County lookup table if available
SELECT  d."county_name",
        COUNT(DISTINCT u."zip_code")              AS "zip_count",
        SUM(u."unemp_2015")                       AS "tot_unemp_2015",
        SUM(u."unemp_2018")                       AS "tot_unemp_2018",
        d."dual_2015",
        d."dual_2018"
FROM    dual d
JOIN    unemp u
        ON 1=0   -- <-- replace with real join condition when a lookup table is provided
WHERE   u."unemp_2018" > u."unemp_2015"
AND     d."dual_2018" < d."dual_2015"
GROUP BY d."county_name", d."dual_2015", d."dual_2018"
LIMIT  20;
```

```sql
--Description: Final count of counties meeting both criteria (increase in unemployment, decrease in dual-eligible enrollment) once a valid ZIP-to-County mapping table LOOKUP_ZIP_COUNTY is supplied  
WITH unemp AS (
    SELECT  l."County_Name",
            SUM(CASE WHEN YEAR(z."do_date") = 2015 THEN z."unemployed_pop" END) AS "unemp_2015",
            SUM(CASE WHEN YEAR(z."do_date") = 2018 THEN z."unemployed_pop" END) AS "unemp_2018"
    FROM    SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR z
    JOIN    LOOKUP_ZIP_COUNTY l
            ON l."ZIP" = z."geo_id"
    WHERE   YEAR(z."do_date") IN (2015, 2018)
    GROUP BY l."County_Name"
),
dual AS (
    SELECT  INITCAP("County_Name") AS "County_Name",
            SUM(CASE WHEN "Date" = '2015-12-01' THEN "Public_Total" END) AS "dual_2015",
            SUM(CASE WHEN "Date" = '2018-12-01' THEN "Public_Total" END) AS "dual_2018"
    FROM    SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    WHERE   "Date" IN ('2015-12-01','2018-12-01')
    GROUP BY INITCAP("County_Name")
)
SELECT COUNT(*) AS "cnt_counties_meeting_conditions"
FROM   dual d
JOIN   unemp u
       ON u."County_Name" ILIKE d."County_Name"
WHERE  u."unemp_2018" > u."unemp_2015"
AND    d."dual_2018"  < d."dual_2015";
```
