/*  Count counties whose unemployment rose (2015 → 2018) and whose
    dual-eligible enrollment fell (Dec-2015 → Dec-2018).                  */
WITH unemployment_15_vs_18 AS (        -- counties where unemployment ↑
    SELECT
        LEFT(geo_id, 5)                                                   AS county_fips ,
        SUM(CASE WHEN YEAR(do_date) = 2015 THEN COALESCE(unemployed_pop,0) END) AS unemp_2015 ,
        SUM(CASE WHEN YEAR(do_date) = 2018 THEN COALESCE(unemployed_pop,0) END) AS unemp_2018
    FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
    WHERE YEAR(do_date) IN (2015, 2018)
    GROUP BY county_fips
    HAVING unemp_2018 > unemp_2015
),
dual_enrollment_15_vs_18 AS (          -- counties where dual enrollment ↓
    SELECT
        LPAD(FIPS_STATE_CODE::TEXT , 2, '0') ||
        LPAD(FIPS_COUNTY_CODE::TEXT, 3, '0')                             AS county_fips ,
        MAX(CASE WHEN DATE = '2015-12-01' THEN PUBLIC_TOTAL END)         AS dual_2015 ,
        MAX(CASE WHEN DATE = '2018-12-01' THEN PUBLIC_TOTAL END)         AS dual_2018
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    WHERE DATE IN ('2015-12-01','2018-12-01')
    GROUP BY county_fips
    HAVING dual_2018 < dual_2015
)
SELECT COUNT(*) AS counties_meeting_both_conditions
FROM unemployment_15_vs_18  u
JOIN dual_enrollment_15_vs_18 d
      ON u.county_fips = d.county_fips;
```
