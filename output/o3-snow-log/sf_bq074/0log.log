```sql
/*  ----------------------------------------------------------
    1)  Build county–level unemployment totals for 2015 & 2018
    2)  Pull county–level dual-eligible enrollee totals for the
        two required CMS snapshots (2015-12-01 & 2018-12-01)
    3)  Count the counties that show
            – higher unemployment in 2018 than in 2015   AND
            – lower dual-eligible totals in 2018 than in 2015
    ---------------------------------------------------------- */
WITH unemp_by_cnty AS (   -- 5-year ACS unemployment
    SELECT
        TRIM(UPPER("County_Name"))            AS county_name,          -- normalise text
        SUM( CASE WHEN EXTRACT(YEAR FROM "do_date") = 2015
                  THEN "unemployed_pop" END ) AS unemp_2015,
        SUM( CASE WHEN EXTRACT(YEAR FROM "do_date") = 2018
                  THEN "unemployed_pop" END ) AS unemp_2018
    FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
    GROUP BY TRIM(UPPER("County_Name"))
),
dual_15 AS (            -- CMS dual-eligible, 1-Dec-2015 snapshot
    SELECT
        TRIM(UPPER("County_Name")) AS county_name,
        SUM("Public_Total")        AS public_2015
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
    WHERE "Date" = '2015-12-01'
    GROUP BY TRIM(UPPER("County_Name"))
),
dual_18 AS (            -- CMS dual-eligible, 1-Dec-2018 snapshot
    SELECT
        TRIM(UPPER("County_Name")) AS county_name,
        SUM("Public_Total")        AS public_2018
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
    WHERE "Date" = '2018-12-01'
    GROUP BY TRIM(UPPER("County_Name"))
),
combined AS (           -- Join unemployment & dual-eligible metrics
    SELECT
        u.county_name,
        u.unemp_2015,
        u.unemp_2018,
        d15.public_2015,
        d18.public_2018
    FROM unemp_by_cnty u
    JOIN dual_15  d15 ON d15.county_name = u.county_name
    JOIN dual_18  d18 ON d18.county_name = u.county_name
)
SELECT COUNT(*) AS counties_meeting_both_conditions
FROM   combined
WHERE  unemp_2018  > unemp_2015      -- unemployment increased
  AND  public_2018 < public_2015;    -- dual-eligible count decreased
```
