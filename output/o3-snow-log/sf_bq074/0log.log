SELECT "County_Name",
       "Date",
       "Public_Total",
       "QMB_Only",
       "QMB_plus_Full",
       "SLMB_only",
       "SLMB_plus_Full",
       "QI",
       "Other_full",
       "QDWI"
FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
WHERE "County_Name" ILIKE '%Autauga%'
  AND "Date" IN ('2015-12-01','2018-12-01')
LIMIT 20;
```

```sql
--Description: 9)  Aggregate December-1-2015 enrollee totals per county
SELECT "County_Name",
       SUM("Public_Total") AS "public_2015"
FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
WHERE "Date" = '2015-12-01'
GROUP BY "County_Name"
LIMIT 20;
```

```sql
--Description: 10)  List counties whose dual-eligible counts decreased between 2015-12-01 and 2018-12-01
WITH c2015 AS (
   SELECT "County_Name", SUM("Public_Total") AS "public_2015"
   FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
   WHERE "Date" = '2015-12-01'
   GROUP BY "County_Name"
), c2018 AS (
   SELECT "County_Name", SUM("Public_Total") AS "public_2018"
   FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
   WHERE "Date" = '2018-12-01'
   GROUP BY "County_Name"
)
SELECT c18."County_Name",
       c15."public_2015",
       c18."public_2018"
FROM c2018 c18
JOIN c2015 c15
  ON UPPER(TRIM(c18."County_Name")) = UPPER(TRIM(c15."County_Name"))
WHERE c18."public_2018" < c15."public_2015"
LIMIT 20;
```
