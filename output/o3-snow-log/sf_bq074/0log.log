WHERE "do_date" = '2015-01-01'
GROUP BY "geo_id"
LIMIT 20;
```

```sql
--Description: 5)  Aggregate unemployment by ZIP for calendar year-2018
SELECT "geo_id",
       SUM("unemployed_pop") AS "unemp_2018"
FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
WHERE "do_date" = '2018-01-01'
GROUP BY "geo_id"
LIMIT 20;
```

```sql
--Description: 6)  Identify ZIP codes that show an increase in unemployment between 2015 and 2018
WITH y2015 AS (
   SELECT "geo_id", SUM("unemployed_pop") AS "unemp_2015"
   FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
   WHERE "do_date" = '2015-01-01'
   GROUP BY "geo_id"
), y2018 AS (
   SELECT "geo_id", SUM("unemployed_pop") AS "unemp_2018"
   FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
   WHERE "do_date" = '2018-01-01'
   GROUP BY "geo_id"
)
SELECT y18."geo_id",
       y15."unemp_2015",
       y18."unemp_2018"
FROM y2018 y18
JOIN y2015 y15
  ON y18."geo_id" = y15."geo_id"
WHERE y18."unemp_2018" > y15."unemp_2015"
LIMIT 20;
```

