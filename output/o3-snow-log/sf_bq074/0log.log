--Description: 10)  List counties whose dual-eligible counts decreased between 2015-12-01 and 2018-12-01
WITH c2015 AS (
    SELECT "County_Name",
           SUM("Public_Total") AS "public_2015"
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
    WHERE "Date" = '2015-12-01'
    GROUP BY "County_Name"
), c2018 AS (
    SELECT "County_Name",
           SUM("Public_Total") AS "public_2018"
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
    WHERE "Date" = '2018-12-01'
    GROUP BY "County_Name"
)
SELECT c18."County_Name",
       c15."public_2015",
       c18."public_2018"
