    SELECT  "geo_id",
            SUM(CASE WHEN DATE_PART(year, "do_date") = 2015 THEN COALESCE("unemployed_pop",0) END) AS "u15",
            SUM(CASE WHEN DATE_PART(year, "do_date") = 2018 THEN COALESCE("unemployed_pop",0) END) AS "u18"
    FROM    SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
    WHERE   DATE_PART(year, "do_date") IN (2015, 2018)
    GROUP BY "geo_id"
)
SELECT COUNT(*) AS "cnt_increase_unemployment"
