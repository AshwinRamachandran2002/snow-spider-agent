```sql
--Description: Identify counties that meet BOTH conditions (unemployment ↑ 2015→2018 AND dual-eligible ↓ 2015-12→2018-12) and list them.
WITH unemp AS (
      SELECT  "geo_id" AS "county_fips"
      FROM   (
              SELECT  "geo_id",
                      SUM(CASE WHEN "do_date"='2015-01-01' THEN COALESCE("unemployed_pop",0) END) AS "u15",
                      SUM(CASE WHEN "do_date"='2018-01-01' THEN COALESCE("unemployed_pop",0) END) AS "u18"
              FROM    SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
              WHERE   "do_date" IN ('2015-01-01','2018-01-01')
              GROUP BY "geo_id"
              HAVING  "u18" > "u15"
             )
),
dual_dec AS (
      SELECT  "County_Name"
      FROM   (
              SELECT  "County_Name",
                      SUM(CASE WHEN "Date"='2015-12-01' THEN COALESCE("Public_Total",0) END) AS "p15",
                      SUM(CASE WHEN "Date"='2018-12-01' THEN COALESCE("Public_Total",0) END) AS "p18"
              FROM    SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
              WHERE   "Date" IN ('2015-12-01','2018-12-01')
              GROUP BY "County_Name"
              HAVING  "p18" < "p15"
             )
)
SELECT   dd."County_Name"
FROM     dual_dec dd
JOIN     unemp u
         ON dd."County_Name" = u."county_fips"      -- adjust join logic if a dedicated FIPS column exists
LIMIT 20;
```

```sql
--Description: Final count of counties satisfying BOTH criteria (unemployment increase & dual-eligible decrease).
WITH unemp_increase AS (
      SELECT  "geo_id" AS "county_id"
      FROM   (
              SELECT  "geo_id",
                      SUM(CASE WHEN "do_date"='2015-01-01' THEN COALESCE("unemployed_pop",0) END) AS "u15",
                      SUM(CASE WHEN "do_date"='2018-01-01' THEN COALESCE("unemployed_pop",0) END) AS "u18"
              FROM    SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
              WHERE   "do_date" IN ('2015-01-01','2018-01-01')
              GROUP BY "geo_id"
              HAVING  "u18" > "u15"
             )
),
dual_decrease AS (
      SELECT  "County_Name" AS "county_id"
      FROM   (
              SELECT  "County_Name",
                      SUM(CASE WHEN "Date"='2015-12-01' THEN COALESCE("Public_Total",0) END) AS "p15",
                      SUM(CASE WHEN "Date"='2018-12-01' THEN COALESCE("Public_Total",0) END) AS "p18"
              FROM    SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
              WHERE   "Date" IN ('2015-12-01','2018-12-01')
              GROUP BY "County_Name"
              HAVING  "p18" < "p15"
             )
)
SELECT  COUNT(*) AS "num_counties_meeting_both_conditions"
FROM    unemp_increase ui
JOIN    dual_decrease  dd
        ON ui."county_id" = dd."county_id"
LIMIT 20;
```
