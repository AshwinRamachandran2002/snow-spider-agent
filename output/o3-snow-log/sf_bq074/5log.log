FROM   (
        SELECT  "County_Name",
                SUM(CASE WHEN "Date"='2015-12-01' THEN COALESCE("Public_Total",0) END) AS "p15",
                SUM(CASE WHEN "Date"='2018-12-01' THEN COALESCE("Public_Total",0) END) AS "p18"
        FROM    SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
