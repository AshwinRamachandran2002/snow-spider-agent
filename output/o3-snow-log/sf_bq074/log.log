    FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    WHERE  DATE_PART(year,  "Date") = 2015
      AND  DATE_PART(month, "Date") = 12
    GROUP  BY "County_Name"
),
d18 AS (
    SELECT "County_Name",
           SUM("Public_Total") AS "total_2018"
    FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    WHERE  DATE_PART(year,  "Date") = 2018
      AND  DATE_PART(month, "Date") = 12
    GROUP  BY "County_Name"
)
SELECT d15."County_Name",
       d15."total_2015",
       d18."total_2018",
       d18."total_2018" - d15."total_2015" AS "diff_enrollment"
