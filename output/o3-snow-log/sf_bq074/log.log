--Description: List the first 20 counties (standardized to uppercase keys) whose dual-eligible enrollment declined between December 2015 and December 2018.
WITH d15 AS (
    SELECT UPPER("County_Name") AS "county_key",
           SUM("Public_Total")  AS "total_2015"
    FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    WHERE  DATE_PART(year,  "Date") = 2015
      AND  DATE_PART(month, "Date") = 12
    GROUP  BY UPPER("County_Name")
),
d18 AS (
    SELECT UPPER("County_Name") AS "county_key",
           SUM("Public_Total")  AS "total_2018"
    FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    WHERE  DATE_PART(year,  "Date") = 2018
      AND  DATE_PART(month, "Date") = 12
    GROUP  BY UPPER("County_Name")
)
SELECT d15."county_key"                    AS "County_Name",
       d15."total_2015",
       d18."total_2018",
       d18."total_2018" - d15."total_2015" AS "diff_enrollment"
FROM   d15
JOIN   d18 USING ("county_key")
WHERE  d18."total_2018" < d15."total_2015"
LIMIT 20
