--Description: Identify geographic areas whose unemployment counts increased between calendar-years 2015 and 2018, using year filters instead of the non-existent exact dates
WITH u15 AS (
    SELECT "geo_id",
           SUM("unemployed_pop") AS "unemp_2015"
    FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
    WHERE  DATE_PART(year, "do_date") = 2015
    GROUP  BY "geo_id"
),
u18 AS (
    SELECT "geo_id",
           SUM("unemployed_pop") AS "unemp_2018"
    FROM   SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
    WHERE  DATE_PART(year, "do_date") = 2018
    GROUP  BY "geo_id"
)
SELECT u15."geo_id",
       u15."unemp_2015",
       u18."unemp_2018",
       u18."unemp_2018" - u15."unemp_2015" AS "diff_unemp"
