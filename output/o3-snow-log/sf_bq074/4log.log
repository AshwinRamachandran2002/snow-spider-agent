    UPPER(d18."County_Name") AS "County_Name",
    d18."Public_Total" - d16."Public_Total" AS "dual_change"
  FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM" d16
  JOIN SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM" d18
