```sql
-- Description: Compute change in dual-eligible public total between Dec-2015 and Dec-2018 for each county
WITH d15 AS (
  SELECT "County_Name", "Public_Total" AS "pt_2015"
  FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
  WHERE "Date" = '2015-12-01'
),
d18 AS (
  SELECT "County_Name", "Public_Total" AS "pt_2018"
  FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
  WHERE "Date" = '2018-12-01'
)
SELECT 
  d18."County_Name",
  d15."pt_2015",
  d18."pt_2018",
  d18."pt_2018" - d15."pt_2015" AS "dual_delta"
FROM d15
JOIN d18
  ON UPPER(d15."County_Name") = UPPER(d18."County_Name")
LIMIT 20;
```

```sql
-- Description: Illustration of joining ZIP-level unemployment change (2015→2018) with county-level dual-eligible change
-- (Assumes a ZIP-to-county crosswalk table named ZIP_COUNTY_XWALK with columns "geo_id" and "County_Name"; 
-- change table names/columns if different or not yet available.)
WITH unemp15 AS (
  SELECT "geo_id", SUM("unemployed_pop") AS "unemp_2015"
  FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
  WHERE YEAR("do_date") = 2015
  GROUP BY "geo_id"
), unemp18 AS (
  SELECT "geo_id", SUM("unemployed_pop") AS "unemp_2018"
  FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
  WHERE YEAR("do_date") = 2018
  GROUP BY "geo_id"
), unemp_delta AS (
  SELECT
    u18."geo_id",
    u15."unemp_2015",
    u18."unemp_2018",
    u18."unemp_2018" - u15."unemp_2015" AS "unemp_change"
  FROM unemp15 u15
  JOIN unemp18 u18 USING ("geo_id")
), county_dual_delta AS (
  SELECT 
    UPPER(d18."County_Name") AS "County_Name",
    d18."Public_Total" - d15."Public_Total" AS "dual_change"
  FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM" d15
  JOIN SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM" d18
    ON UPPER(d15."County_Name") = UPPER(d18."County_Name")
  WHERE d15."Date" = '2015-12-01' 
    AND d18."Date" = '2018-12-01'
)
SELECT 
  cdd."County_Name",
  SUM(CASE WHEN ud."unemp_change" > 0 THEN 1 ELSE 0 END) AS "zip_increased_unemp_cnt",
  cdd."dual_change"
FROM unemp_delta ud
JOIN ZIP_COUNTY_XWALK xw ON ud."geo_id" = xw."geo_id"
JOIN county_dual_delta cdd ON UPPER(xw."County_Name") = cdd."County_Name"
GROUP BY cdd."County_Name", cdd."dual_change"
HAVING 
  SUM(CASE WHEN ud."unemp_change" > 0 THEN 1 ELSE 0 END) > 0   -- any ZIP in county saw ↑ unemployment
  AND cdd."dual_change" < 0                                     -- county saw ↓ dual-eligible
LIMIT 20;
```
