```sql
--Description: For every county, calculate the change in Public_Total between its earliest and latest snapshot dates
--(avoids hard-coding specific dates that might be missing).
WITH ranked AS (
  SELECT
    "County_Name",
    "Date",
    "Public_Total",
    ROW_NUMBER()  OVER (PARTITION BY "County_Name" ORDER BY "Date")          AS rn_earliest,
    ROW_NUMBER()  OVER (PARTITION BY "County_Name" ORDER BY "Date" DESC)     AS rn_latest
  FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
)
SELECT
  e."County_Name",
  e."Date"          AS "earliest_date",
  l."Date"          AS "latest_date",
  e."Public_Total"  AS "earliest_total",
  l."Public_Total"  AS "latest_total",
  l."Public_Total" - e."Public_Total" AS "dual_delta"
FROM ranked e
JOIN ranked l
  ON e."County_Name" = l."County_Name"
WHERE e.rn_earliest = 1
  AND l.rn_latest   = 1
LIMIT 20;
```

