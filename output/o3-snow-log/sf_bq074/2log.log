--Description: 9) ZIPs (all, since only one ACS year exists) paired with counties whose dual enrollment declined
WITH
-- 1. All ZIPs with their unemployed totals (single-year data)
zip_unemp AS (
    SELECT "geo_id", SUM("unemployed_pop") AS unemp_2014
    FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
    GROUP BY "geo_id"
),
-- 2. Counties whose dual enrollment declined
earliest_dt AS ( SELECT MIN("Date") AS start_dt FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM ),
latest_dt   AS ( SELECT MAX("Date") AS end_dt   FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM ),
start_tot AS (
    SELECT "County_Name", "Public_Total" AS pt_start
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    JOIN earliest_dt ON "Date" = start_dt
),
end_tot AS (
    SELECT "County_Name", "Public_Total" AS pt_end
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    JOIN latest_dt ON "Date" = end_dt
),
dec_enroll AS (
    SELECT e_end."County_Name"
    FROM start_tot s
    JOIN end_tot e_end USING ("County_Name")
    WHERE e_end.pt_end < s.pt_start
)
SELECT 
    z."geo_id"              AS zip_code,
    z.unemp_2014            AS unemployed_pop,
    d."County_Name"         AS county_with_decreasing_enrollment
FROM zip_unemp z
CROSS JOIN dec_enroll d
LIMIT 20;
