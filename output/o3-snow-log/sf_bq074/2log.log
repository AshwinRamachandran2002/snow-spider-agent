```sql
--Description: In the CMS dual-eligible table, county names differ in case between the
--             earliest (2015-03-01) and latest (2018-12-01) snapshots, so a plain join
--             misses matches.  By converting both sides to UPPER-case we guarantee a
--             successful join, then compute the change in Public_Total for each county.
--             The result is sorted by the most negative (largest decrease) values so we
--             can quickly see which counties, if any, experienced a decline.
WITH
earliest_dt AS (                       -- identify earliest snapshot date
    SELECT MIN("Date") AS start_dt
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
),
latest_dt AS (                         -- identify latest snapshot date
    SELECT MAX("Date") AS end_dt
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
),
start_tot AS (                         -- earliest counts, upper-case key
    SELECT 
        UPPER("County_Name") AS county_key,
        "Public_Total"       AS pt_start
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    JOIN earliest_dt ON "Date" = start_dt
),
end_tot AS (                           -- latest counts, upper-case key
    SELECT 
        UPPER("County_Name") AS county_key,
        "Public_Total"       AS pt_end
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    JOIN latest_dt ON "Date" = end_dt
)
SELECT
    e.county_key          AS "County_Name",
    s.pt_start,
    e.pt_end,
    (e.pt_end - s.pt_start) AS diff_total          -- negative = decrease
FROM start_tot s
JOIN end_tot  e ON s.county_key = e.county_key
ORDER BY diff_total ASC
LIMIT 20;
```
