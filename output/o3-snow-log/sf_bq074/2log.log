```sql
--Description: Because the ACS ZIP table appears to contain only one snapshot date,
--             we will compare unemployment totals for each ZIP between the table’s
--             earliest and latest dates (which might be identical).  This query
--             returns the totals at both dates and the computed difference; if the
--             earliest and latest dates are the same, the difference will be zero.
WITH date_bounds AS (
    SELECT 
        MIN("do_date") AS start_dt,
        MAX("do_date") AS end_dt
    FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
),
start_totals AS (
    SELECT 
        z."geo_id",
        SUM(z."unemployed_pop") AS unemp_start
    FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR z
    JOIN date_bounds d ON z."do_date" = d.start_dt
    GROUP BY z."geo_id"
),
end_totals AS (
    SELECT 
        z."geo_id",
        SUM(z."unemployed_pop") AS unemp_end
    FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR z
    JOIN date_bounds d ON z."do_date" = d.end_dt
    GROUP BY z."geo_id"
)
SELECT
    e."geo_id",
    s.unemp_start,
    e.unemp_end,
    (e.unemp_end - s.unemp_start) AS unemp_diff
FROM start_totals s
JOIN end_totals e USING ("geo_id")
LIMIT 20;
```
