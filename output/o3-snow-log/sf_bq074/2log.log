```sql
--Description: 9) List ZIPs with increasing unemployment (earliest→latest) alongside counties with decreasing dual enrollment (earliest→latest)
WITH
-- 1. ZIPs whose unemployment increased
earliest_year AS (SELECT MIN(EXTRACT(year FROM "do_date")) AS yr FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR),
latest_year   AS (SELECT MAX(EXTRACT(year FROM "do_date")) AS yr FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR),
unemp_start AS (
    SELECT "geo_id", SUM("unemployed_pop") AS unemp_start
    FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR, earliest_year
    WHERE EXTRACT(year FROM "do_date") = earliest_year.yr
    GROUP BY "geo_id"
),
unemp_end AS (
    SELECT "geo_id", SUM("unemployed_pop") AS unemp_end
    FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR, latest_year
    WHERE EXTRACT(year FROM "do_date") = latest_year.yr
    GROUP BY "geo_id"
),
inc_unemp_zips AS (
    SELECT u_end."geo_id"
    FROM unemp_start u_start
    JOIN unemp_end   u_end USING ("geo_id")
    WHERE u_end.unemp_end > u_start.unemp_start
),
-- 2. Counties whose dual enrollment declined
earliest_dt AS (SELECT MIN("Date") AS start_dt FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM),
latest_dt   AS (SELECT MAX("Date") AS end_dt   FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM),
enroll_start AS (
    SELECT "County_Name", "Public_Total" AS pt_start
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM, earliest_dt
    WHERE "Date" = earliest_dt.start_dt
),
enroll_end AS (
    SELECT "County_Name", "Public_Total" AS pt_end
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM, latest_dt
    WHERE "Date" = latest_dt.end_dt
),
dec_enroll_counties AS (
    SELECT e_end."County_Name"
    FROM enroll_start e_start
    JOIN enroll_end   e_end USING ("County_Name")
    WHERE e_end.pt_end < e_start.pt_start
)
SELECT 
    iu."geo_id"      AS "ZIP_with_Increasing_Unemployment",
    dc."County_Name" AS "County_with_Decreasing_Enrollment"
FROM inc_unemp_zips          iu
CROSS JOIN dec_enroll_counties dc
LIMIT 20;
```

