    JOIN enroll_end   e_end USING ("County_Name")
    WHERE e_end.pt_end < e_start.pt_start
),
-- C) Placeholder ZIP-to-county cross-walk (replace with a real table when available)
zip_to_county AS (
    /* Example schema if available:
