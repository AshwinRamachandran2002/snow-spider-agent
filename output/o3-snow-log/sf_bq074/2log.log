earliest_year AS (
    SELECT MIN(EXTRACT(year FROM "do_date")) AS "yr"
    FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
),
latest_year AS (
    SELECT MAX(EXTRACT(year FROM "do_date")) AS "yr"
    FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
),
y_start AS (
    SELECT z."geo_id", SUM(z."unemployed_pop") AS unemp_start
    FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR z
    JOIN earliest_year e
      ON EXTRACT(year FROM z."do_date") = e."yr"
    GROUP BY z."geo_id"
),
y_end AS (
    SELECT z."geo_id", SUM(z."unemployed_pop") AS unemp_end
    FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR z
    JOIN latest_year l
      ON EXTRACT(year FROM z."do_date") = l."yr"
    GROUP BY z."geo_id"
)
SELECT
    y_end."geo_id",
    y_start.unemp_start,
    y_end.unemp_end
FROM y_start
JOIN y_end USING ("geo_id")
WHERE y_end.unemp_end > y_start.unemp_start
