  FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
  WHERE "do_date" BETWEEN '2015-01-01' AND '2015-12-31'
  GROUP BY "geo_id"
),
y18 AS (
  SELECT "geo_id", SUM("unemployed_pop") AS unemp18
  FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
  WHERE "do_date" BETWEEN '2018-01-01' AND '2018-12-31'
  GROUP BY "geo_id"
)
SELECT 
  y18."geo_id",
  y15.unemp15,
