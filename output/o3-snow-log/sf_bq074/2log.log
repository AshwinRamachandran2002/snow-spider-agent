```sql
--Description: 9) ZIP list (single-year ACS) paired with counties whose dual enrollment truly declined
--             Case differences are handled by upper-casing county names before comparison.
WITH
/* 1.  All ZIPs with their unemployed totals (only 2014 data exist) */
zip_unemp AS (
    SELECT 
        "geo_id",
        SUM("unemployed_pop") AS unemp_2014
    FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
    GROUP BY "geo_id"
),
/* 2.  Identify earliest & latest dual-eligible snapshot dates */
earliest_dt AS ( SELECT MIN("Date") AS start_dt FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM ),
latest_dt   AS ( SELECT MAX("Date") AS end_dt   FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM ),
/* 3.  Earliest and latest enrollment totals, with UPPER-cased key */
start_tot AS (
    SELECT UPPER("County_Name") AS county_key, "Public_Total" AS pt_start
    FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    JOIN   earliest_dt ON "Date" = start_dt
),
end_tot AS (
    SELECT UPPER("County_Name") AS county_key, "Public_Total" AS pt_end
    FROM   SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
    JOIN   latest_dt   ON "Date" = end_dt
),
/* 4.  Counties whose dual-eligible enrollment decreased */
dec_enroll AS (
    SELECT e.county_key
    FROM   start_tot s
    JOIN   end_tot   e ON s.county_key = e.county_key
    WHERE  e.pt_end < s.pt_start
)
SELECT 
    z."geo_id"           AS zip_code,
