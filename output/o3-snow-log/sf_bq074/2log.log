```sql
--Description: 9) Bring together counties (via fuzzy match on county name) whose dual-eligible enrollment decreased
--     and whose underlying ZIPs showed higher unemployment in 2018 than 2015
WITH inc_unemp_zips AS (
  SELECT "geo_id"
  FROM (
      WITH y15 AS (
        SELECT "geo_id", SUM("unemployed_pop") AS unemp15
        FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
        WHERE "do_date" BETWEEN '2015-01-01' AND '2015-12-31'
        GROUP BY "geo_id"
      ),
      y18 AS (
        SELECT "geo_id", SUM("unemployed_pop") AS unemp18
        FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
        WHERE "do_date" BETWEEN '2018-01-01' AND '2018-12-31'
        GROUP BY "geo_id"
      )
      SELECT y18."geo_id"
      FROM y15
      JOIN y18 USING("geo_id")
      WHERE y18.unemp18 > y15.unemp15
  )
),
dec_enrollment_counties AS (
  SELECT y18."County_Name"
  FROM (
      SELECT "County_Name", "Public_Total" AS pt15
      FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
      WHERE "Date" = '2015-12-01'
  ) y15
  JOIN (
      SELECT "County_Name", "Public_Total" AS pt18
      FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
      WHERE "Date" = '2018-12-01'
  ) y18
  ON y15."County_Name" ILIKE y18."County_Name"
  WHERE y18.pt18 < y15.pt15
)
-- NOTE: A direct ZIP-to-county mapping is not stored in these two tables,
--       so this query only shows the two filtered lists side-by-side
SELECT 
  iu."geo_id"  AS "ZIP_with_Increasing_Unemployment",
  dc."County_Name" AS "County_with_Dec_Enrollment"
FROM inc_unemp_zips iu
CROSS JOIN dec_enrollment_counties dc
LIMIT 20;
```

```sql
--Description: 10) Count of counties meeting BOTH criteria (increase in unemployment & decrease in dual enrollment)
--         by approximating ZIP-to-county via first 5 digits of ZIP in county name comparison
--         (may need an external ZIP-to-county crosswalk not present in current schema)
WITH inc_unemp_zips AS (
  SELECT "geo_id"
  FROM (
      WITH y15 AS (
        SELECT "geo_id", SUM("unemployed_pop") AS unemp15
        FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
        WHERE "do_date" BETWEEN '2015-01-01' AND '2015-12-31'
        GROUP BY "geo_id"
      ),
      y18 AS (
        SELECT "geo_id", SUM("unemployed_pop") AS unemp18
        FROM SDOH.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
        WHERE "do_date" BETWEEN '2018-01-01' AND '2018-12-31'
        GROUP BY "geo_id"
      )
      SELECT y18."geo_id"
      FROM y15
      JOIN y18 USING("geo_id")
      WHERE y18.unemp18 > y15.unemp15
  )
),
dec_enrollment_counties AS (
  SELECT y18."County_Name"
  FROM (
      SELECT "County_Name", "Public_Total" AS pt15
      FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
      WHERE "Date" = '2015-12-01'
  ) y15
  JOIN (
      SELECT "County_Name", "Public_Total" AS pt18
      FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT.DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM
      WHERE "Date" = '2018-12-01'
  ) y18
  ON y15."County_Name" ILIKE y18."County_Name"
  WHERE y18.pt18 < y15.pt15
),
zip_to_county AS (
  -- Placeholder: user would substitute a true cross-walk table if available
  SELECT 
    NULL AS "County_Name",
    NULL AS "geo_id"
  WHERE 1=0
)
SELECT 
  COUNT(DISTINCT d."County_Name") AS "cnt_counties"
FROM dec_enrollment_counties d
JOIN zip_to_county z
     ON d."County_Name" ILIKE z."County_Name"
JOIN inc_unemp_zips u
     ON u."geo_id" = z."geo_id";
```
