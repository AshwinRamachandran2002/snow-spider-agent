--Description: 8) Exploratory join of counties with dual decreases (2016→2018) and ZIPs present in unemployment data (2014); join is still textual on county vs. ZIP pattern.
WITH dual_decr AS (
    /* counties with dual decrease 2016→2018 */
    WITH d16 AS (
        SELECT "County_Name", "Public_Total" AS "dual_2016"
        FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
        WHERE "Date" = '2016-12-01'
    ), d18 AS (
        SELECT "County_Name", "Public_Total" AS "dual_2018"
        FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
        WHERE "Date" = '2018-09-01'
    )
    SELECT d18."County_Name",
           (d18."dual_2018" - d16."dual_2016") AS "dual_change"
    FROM d16
    JOIN d18 USING ("County_Name")
    WHERE d18."dual_2018" < d16."dual_2016"
),
unemp_zip AS (
    /* all ZIPs from the only available year (2014) */
    SELECT "geo_id",
           SUM("unemployed_pop") AS "unemp_2014"
    FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
    WHERE EXTRACT(year FROM "do_date") = 2014
    GROUP BY "geo_id"
)
SELECT DISTINCT
    d."County_Name",
    d."dual_change",
    u."unemp_2014"
FROM dual_decr d
