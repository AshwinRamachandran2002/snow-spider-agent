--Description: 9) Count how many counties experienced a dual-eligible decrease (2016 → 2018,
--using case-insensitive match) and have at least one ZIP present in the 2014 unemployment
--table (matched via the same loose text join).
WITH dual_decr AS (
    WITH d16 AS (
        SELECT UPPER("County_Name") AS "county_key",
               "Public_Total"       AS "dual_2016"
        FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
        WHERE "Date" = '2016-12-01'
    ),
    d18 AS (
        SELECT UPPER("County_Name") AS "county_key",
               "County_Name",
               "Public_Total"       AS "dual_2018"
        FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
        WHERE "Date" = '2018-09-01'
    )
    SELECT d18."County_Name"
    FROM d16
    JOIN d18
      ON d16."county_key" = d18."county_key"
    WHERE d18."dual_2018" < d16."dual_2016"
),
unemp_zip AS (
    SELECT DISTINCT "geo_id"
    FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
    WHERE EXTRACT(year FROM "do_date") = 2014
)
SELECT COUNT(DISTINCT d."County_Name") AS "cnt_counties"
FROM dual_decr d
JOIN unemp_zip u
  ON d."County_Name" ILIKE '%' || u."geo_id" || '%';
