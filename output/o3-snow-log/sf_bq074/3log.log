```sql
--Description: 7) Compare 2015 vs 2018 dual-eligible counts to find counties with a decrease.
WITH dual_2015 AS (
    SELECT "County_Name", "Public_Total" AS "total_dual_2015"
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
    WHERE "Date" = '2015-12-01'
), dual_2018 AS (
    SELECT "County_Name", "Public_Total" AS "total_dual_2018"
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
    WHERE "Date" = '2018-12-01'
)
SELECT 
    d18."County_Name",
    d15."total_dual_2015",
    d18."total_dual_2018",
    (d18."total_dual_2018" - d15."total_dual_2015") AS "dual_change"
FROM dual_2015 d15
