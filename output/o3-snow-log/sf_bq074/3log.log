```sql
--Description: 8) Re-create “dual_decr” with case-insensitive county matching (UPPER) so it really
--captures counties whose dual-eligible enrolment dropped from 2016-12-01 to 2018-09-01, then
--join to 2014 ZIP unemployment records on a loose text match (county name contains ZIP code)
--and show the first 20 matches.
WITH dual_decr AS (
    /* counties with dual decrease 2016 → 2018 */
    WITH d16 AS (
        SELECT UPPER("County_Name") AS "county_key",
               "Public_Total"      AS "dual_2016"
        FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
        WHERE "Date" = '2016-12-01'
    ),
    d18 AS (
        SELECT UPPER("County_Name") AS "county_key",
               "County_Name",       -- mixed-case for display
               "Public_Total"       AS "dual_2018"
        FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
        WHERE "Date" = '2018-09-01'
    )
    SELECT
        d18."County_Name",
        d18."dual_2018" - d16."dual_2016" AS "dual_change"
    FROM d16
    JOIN d18
      ON d16."county_key" = d18."county_key"
    WHERE d18."dual_2018" < d16."dual_2016"
),
unemp_zip AS (
    /* unemployment totals for the only available year (2014) */
    SELECT
        "geo_id",
        SUM("unemployed_pop") AS "unemp_2014"
    FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
    WHERE EXTRACT(year FROM "do_date") = 2014
    GROUP BY "geo_id"
)
SELECT DISTINCT
    d."County_Name",
    d."dual_change",
    u."unemp_2014"
FROM dual_decr d
JOIN unemp_zip u
  ON d."County_Name" ILIKE '%' || u."geo_id" || '%'
LIMIT 20;
```

