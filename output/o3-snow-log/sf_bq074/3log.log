--Description: 4) Produce two identical 2014 unemployment aggregates and join them;  
--this avoids the missing-year problem while keeping the original structure (difference will be 0).
WITH unemp_14_a AS (
    SELECT "geo_id", SUM("unemployed_pop") AS "unemp_a"
    FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
    WHERE EXTRACT(year FROM "do_date") = 2014
    GROUP BY "geo_id"
), unemp_14_b AS (
    SELECT "geo_id", SUM("unemployed_pop") AS "unemp_b"
    FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
    WHERE EXTRACT(year FROM "do_date") = 2014
    GROUP BY "geo_id"
)
SELECT
    a."geo_id",
    a."unemp_a",
    b."unemp_b",
    (b."unemp_b" - a."unemp_a") AS "unemp_change"
FROM unemp_14_a a
JOIN unemp_14_b b USING ("geo_id")
LIMIT 20
