```sql
--Description: 8) Bridge ZIP-level unemployment increases to county-level dual decreases via simple text join on county names appearing in ZIP table’s geo_id pattern (exploratory).
SELECT DISTINCT
    d."County_Name",
    d."dual_change",
    u."unemp_change"
FROM (
    /* dual decrease */
    WITH dual_2015 AS (
        SELECT "County_Name", "Public_Total" AS "total_dual_2015"
        FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
        WHERE "Date" = '2015-12-01'
    ), dual_2018 AS (
        SELECT "County_Name", "Public_Total" AS "total_dual_2018"
        FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
        WHERE "Date" = '2018-12-01'
    )
    SELECT 
        d18."County_Name",
        (d18."total_dual_2018" - d15."total_dual_2015") AS "dual_change"
    FROM dual_2015 d15
    JOIN dual_2018 d18 USING ("County_Name")
    WHERE d18."total_dual_2018" < d15."total_dual_2015"
) d
JOIN (
    /* unemployment increase */
    WITH unemp_15 AS (
        SELECT "geo_id", SUM("unemployed_pop") AS "unemp_2015"
        FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
        WHERE EXTRACT(year FROM "do_date") = 2015
        GROUP BY "geo_id"
    ), unemp_18 AS (
        SELECT "geo_id", SUM("unemployed_pop") AS "unemp_2018"
        FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
        WHERE EXTRACT(year FROM "do_date") = 2018
        GROUP BY "geo_id"
    )
    SELECT 
        u18."geo_id",
        (u18."unemp_2018" - u15."unemp_2015") AS "unemp_change"
    FROM unemp_15 u15
    JOIN unemp_18 u18 USING ("geo_id")
    WHERE u18."unemp_2018" > u15."unemp_2015"
) u
ON d."County_Name" ILIKE '%' || u."geo_id" || '%'
LIMIT 20;
```

