```sql
/*  Step-by-step logic
    1.  Build 2015 and 2018 county-level unemployment totals (5-year ACS table).
        – “county_key” is the county name (upper-cased & trimmed) that comes
          before the first comma in the ACS “name” field (e.g. 
          “Autauga County, Alabama” → “AUTAUGA COUNTY”).
        – Keep only counties whose unemployment rose from 2015 → 2018.
    2.  Build 2015-12-01 and 2018-12-01 county-level dual-eligible totals.
        – Normalise “County_Name” with TRIM + UPPER.
        – Keep only counties whose enrollee count fell from 2015-12-01 → 2018-12-01.
    3.  Intersect the two county sets and count the result.
*/

WITH unemp_2015 AS (             /* 2015 unemployment by county */
    SELECT
        TRIM(UPPER(REGEXP_SUBSTR("name", '^[^,]+')))  AS county_key,
        SUM("unemployed_pop")                        AS unemp_2015
    FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
    WHERE EXTRACT(YEAR FROM "do_date") = 2015
    GROUP BY TRIM(UPPER(REGEXP_SUBSTR("name", '^[^,]+')))
), 
unemp_2018 AS (                  /* 2018 unemployment by county */
    SELECT
        TRIM(UPPER(REGEXP_SUBSTR("name", '^[^,]+')))  AS county_key,
        SUM("unemployed_pop")                        AS unemp_2018
    FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
    WHERE EXTRACT(YEAR FROM "do_date") = 2018
    GROUP BY TRIM(UPPER(REGEXP_SUBSTR("name", '^[^,]+')))
), 
unemp_increase AS (              /* counties with rising unemployment */
    SELECT  u18.county_key
    FROM    unemp_2015 u15
    JOIN    unemp_2018 u18 USING (county_key)
    WHERE   u18.unemp_2018 > u15.unemp_2015
), 

dual_2015 AS (                   /* 2015-12-01 dual-eligible totals */
    SELECT
        TRIM(UPPER("County_Name"))     AS county_key,
        SUM("Public_Total")            AS dual_2015
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
    WHERE "Date" = '2015-12-01'
    GROUP BY TRIM(UPPER("County_Name"))
), 
dual_2018 AS (                   /* 2018-12-01 dual-eligible totals */
    SELECT
        TRIM(UPPER("County_Name"))     AS county_key,
        SUM("Public_Total")            AS dual_2018
    FROM SDOH.SDOH_CMS_DUAL_ELIGIBLE_ENROLLMENT."DUAL_ELIGIBLE_ENROLLMENT_BY_COUNTY_AND_PROGRAM"
    WHERE "Date" = '2018-12-01'
    GROUP BY TRIM(UPPER("County_Name"))
), 
dual_decrease AS (               /* counties with falling enrollee counts */
    SELECT  d18.county_key
    FROM    dual_2015 d15
    JOIN    dual_2018 d18 USING (county_key)
    WHERE   d18.dual_2018 < d15.dual_2015
)

/*  Final answer: number of counties meeting BOTH conditions */
SELECT
    COUNT(*) AS "cnt_counties_inc_unemp_dec_dual"
FROM    unemp_increase  ui
JOIN    dual_decrease  dd
  ON    ui.county_key = dd.county_key;
```
