```sql
--Description: 4) Join 2015 vs 2018 unemployment to see ZIPs with an increase.
WITH unemp_15 AS (
    SELECT "geo_id", SUM("unemployed_pop") AS "unemp_2015"
    FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
    WHERE EXTRACT(year FROM "do_date") = 2015
    GROUP BY "geo_id"
), unemp_18 AS (
    SELECT "geo_id", SUM("unemployed_pop") AS "unemp_2018"
    FROM SDOH.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
    WHERE EXTRACT(year FROM "do_date") = 2018
    GROUP BY "geo_id"
)
SELECT 
    u18."geo_id",
    u15."unemp_2015",
    u18."unemp_2018",
    (u18."unemp_2018" - u15."unemp_2015") AS "unemp_change"
FROM unemp_15 u15
JOIN unemp_18 u18 USING ("geo_id")
WHERE u18."unemp_2018" > u15."unemp_2015"
LIMIT 20;
```

