```sql
WITH sales_cma AS (   -- 1.  Compute the centred moving-average for every product/month
    SELECT
        ms."product_id",
        ms."mth",
        ms."qty",
        (
            AVG(ms."qty") OVER (PARTITION BY ms."product_id"
                                ORDER BY ms."mth"
                                ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
          + AVG(ms."qty") OVER (PARTITION BY ms."product_id"
                                ORDER BY ms."mth"
                                ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
        ) / 2                        AS "cma_final"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES" ms
),
ratio_2017 AS (       -- 2.  Seasonality-adjusted sales ratio, keep only 2017 rows
    SELECT
        sc."product_id",
        sc."mth",
        sc."qty",
        sc."cma_final",
        sc."qty" / sc."cma_final"    AS "sales_to_cma_ratio"
    FROM sales_cma sc
    WHERE sc."mth" LIKE '2017-%'     -- restrict to calendar year 2017
      AND sc."cma_final" <> 0        -- protect against divide-by-zero
)
-- 3.  Products whose ratio exceeded 2 in EVERY month of 2017
SELECT
    p."id"   AS "product_id",
    p."name" AS "product_name"
FROM ratio_2017 r
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
      ON p."id" = r."product_id"
GROUP BY p."id", p."name"
HAVING COUNT(*) = 12                 -- all 12 months present
   AND MIN(r."sales_to_cma_ratio") > 2
ORDER BY p."id";
```
