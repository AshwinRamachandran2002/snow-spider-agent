```sql
--Description: For each product/month, compute the 12-month centered moving average 
--using the window of 5 months before and 6 months after (CMA_A).
SELECT 
  "PRODUCT_ID",
  "MTH",
  "QTY",
  AVG("QTY") OVER (
        PARTITION BY "PRODUCT_ID"
        ORDER BY "MTH"
        ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
  ) AS "CMA_A"
FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
ORDER BY "PRODUCT_ID", "MTH"
LIMIT 20;
```

```sql
--Description: Compute the alternative centered moving average that looks 6 months 
--back and 5 months forward (CMA_B) for the same records.
SELECT 
  "PRODUCT_ID",
  "MTH",
  "QTY",
  AVG("QTY") OVER (
        PARTITION BY "PRODUCT_ID"
        ORDER BY "MTH"
        ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
  ) AS "CMA_B"
FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
ORDER BY "PRODUCT_ID", "MTH"
LIMIT 20;
```

```sql
--Description: Blend the two CMAs (average of CMA_A and CMA_B) into a single final CMA value.
SELECT
  ms."PRODUCT_ID",
  ms."MTH",
  ms."QTY",
  (cma1."CMA_A" + cma2."CMA_B") / 2                              AS "CMA_FINAL"
FROM (
  SELECT 
    "PRODUCT_ID", "MTH", "QTY",
    AVG("QTY") OVER (
          PARTITION BY "PRODUCT_ID"
          ORDER BY "MTH"
          ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
    ) AS "CMA_A"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
) cma1
JOIN (
  SELECT 
    "PRODUCT_ID", "MTH", "QTY",
    AVG("QTY") OVER (
          PARTITION BY "PRODUCT_ID"
          ORDER BY "MTH"
          ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
    ) AS "CMA_B"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
) cma2
  ON cma1."PRODUCT_ID" = cma2."PRODUCT_ID"
 AND cma1."MTH"        = cma2."MTH"
JOIN "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" ms
  ON ms."PRODUCT_ID"   = cma1."PRODUCT_ID"
 AND ms."MTH"          = cma1."MTH"
ORDER BY ms."PRODUCT_ID", ms."MTH"
LIMIT 20;
```

```sql
--Description: Calculate the seasonality-adjusted sales ratio for each record in 2017.
SELECT
  t."PRODUCT_ID",
  t."MTH",
  t."QTY",
  t."CMA_FINAL",
  CASE WHEN t."CMA_FINAL" = 0 THEN NULL
       ELSE t."QTY" / t."CMA_FINAL"
  END                                                            AS "SALES_TO_CMA_RATIO"
FROM (
  -- (Same sub-query as in previous step generating CMA_FINAL)
  SELECT
    ms."PRODUCT_ID",
    ms."MTH",
    ms."QTY",
    (c1."CMA_A" + c2."CMA_B") / 2 AS "CMA_FINAL"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" ms
  JOIN (
        SELECT "PRODUCT_ID","MTH",
               AVG("QTY") OVER (PARTITION BY "PRODUCT_ID" ORDER BY "MTH"
                                ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) AS "CMA_A"
        FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
  ) c1
    ON ms."PRODUCT_ID" = c1."PRODUCT_ID" AND ms."MTH" = c1."MTH"
  JOIN (
        SELECT "PRODUCT_ID","MTH",
               AVG("QTY") OVER (PARTITION BY "PRODUCT_ID" ORDER BY "MTH"
                                ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "CMA_B"
        FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
  ) c2
    ON ms."PRODUCT_ID" = c2."PRODUCT_ID" AND ms."MTH" = c2."MTH"
) t
WHERE t."MTH" LIKE '2017-%'
ORDER BY t."PRODUCT_ID", t."MTH"
LIMIT 20;
```

```sql
--Description: Keep only the records from 2017 whose ratio is strictly above 2.
SELECT
  "PRODUCT_ID",
  "MTH",
  "SALES_TO_CMA_RATIO"
FROM (
  /* ========== same derived table as previous step ========== */
  SELECT
    t."PRODUCT_ID",
    t."MTH",
    t."QTY",
    t."CMA_FINAL",
    CASE WHEN t."CMA_FINAL" = 0 THEN NULL
         ELSE t."QTY" / t."CMA_FINAL"
    END AS "SALES_TO_CMA_RATIO"
  FROM ( /* see step-7 inner query */ ) t
) q
WHERE q."MTH" LIKE '2017-%'
  AND q."SALES_TO_CMA_RATIO" > 2
ORDER BY q."PRODUCT_ID", q."MTH"
LIMIT 20;
```

```sql
--Description: For each product, count how many 2017 months have a ratio greater than 2.
-- (There should be 12 such months if the ratio stayed above 2 all year.)
SELECT
  "PRODUCT_ID",
  COUNT(*)                              AS "MONTHS_ABOVE_2"
FROM (
  /* == same filtered data as in previous step == */
  SELECT
    "PRODUCT_ID",
    "MTH",
    "SALES_TO_CMA_RATIO"
  FROM ( /* see step-8 query body */ )
) s
GROUP BY "PRODUCT_ID"
HAVING COUNT(*) = 12
LIMIT 20;
```

