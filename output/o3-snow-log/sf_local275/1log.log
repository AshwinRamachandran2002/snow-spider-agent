Query:
--Description: 7) Keep only the 2017 records whose ratio is strictly above 2.
WITH cma AS (
  SELECT
    "product_id",
    "mth",
    "qty",
    ( AVG("qty") OVER (PARTITION BY "product_id" ORDER BY "mth"
                       ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
    + AVG("qty") OVER (PARTITION BY "product_id" ORDER BY "mth"
                       ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) ) / 2  AS "cma_final"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
)
SELECT
  "product_id",
  "mth",
  ("qty" / "cma_final") AS "sales_to_cma_ratio"
FROM cma
WHERE "mth" LIKE '2017-%'
  AND "cma_final" <> 0
  AND ("qty" / "cma_final") > 2
ORDER BY "product_id", "mth"
LIMIT 20
