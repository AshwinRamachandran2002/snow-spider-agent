```sql
--Description: To understand which products reached a sales-to-CMA ratio above 2 during 2017 (and how often),  
--1) build a CTE “cma” that calculates the centred moving average (average of two overlapping 12-month windows);  
--2) filter 2017 rows where the ratio ("qty"/"cma_final") exceeds 2 => CTE “above2”;  
--3) count those high-ratio months per product and order by the largest counts.  
--This reveals every product that ever crossed the >2 threshold in 2017 and how many months it did so.
WITH cma AS (
    SELECT
        "product_id",
        "mth",
        "qty",
        (
            AVG("qty") OVER (PARTITION BY "product_id" ORDER BY "mth"
                             ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
          + AVG("qty") OVER (PARTITION BY "product_id" ORDER BY "mth"
                             ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
        ) / 2 AS "cma_final"
    FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
), above2 AS (
    SELECT
        "product_id",
        "mth"
    FROM cma
    WHERE "mth" LIKE '2017-%'
      AND "cma_final" <> 0
      AND ("qty" / "cma_final") > 2
)
SELECT
    "product_id",
    COUNT(*) AS "months_above_2"
FROM above2
GROUP BY "product_id"
ORDER BY "months_above_2" DESC, "product_id"
LIMIT 20;
```
