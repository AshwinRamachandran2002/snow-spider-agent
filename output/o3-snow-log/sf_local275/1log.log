Query:
--Description: 5) Blend the two CMAs into a single CMA_FINAL value.
WITH cma1 AS (
  SELECT 
    "product_id", "mth", "qty",
    AVG("qty") OVER (PARTITION BY "product_id" ORDER BY "mth"
                     ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) AS "cma_a"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
), cma2 AS (
  SELECT 
    "product_id", "mth",
    AVG("qty") OVER (PARTITION BY "product_id" ORDER BY "mth"
                     ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "cma_b"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
)
SELECT
  s."product_id",
  s."mth",
  s."qty",
  (c1."cma_a" + c2."cma_b") / 2 AS "cma_final"
FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" s
JOIN cma1 c1 ON s."product_id" = c1."product_id" AND s."mth" = c1."mth"
JOIN cma2 c2 ON s."product_id" = c2."product_id" AND s."mth" = c2."mth"
ORDER BY s."product_id", s."mth"
LIMIT 20
