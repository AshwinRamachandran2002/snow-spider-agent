                     ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "cma_b"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
)
SELECT
  s."product_id",
  s."mth",
  s."qty",
  (c1."cma_a" + c2."cma_b") / 2 AS "cma_final"
FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" s
JOIN cma1 c1 ON s."product_id" = c1."product_id" AND s."mth" = c1."mth"
