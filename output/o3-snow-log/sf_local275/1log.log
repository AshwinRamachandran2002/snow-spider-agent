--Description: List product names that achieved a sales-to-CMA ratio > 2 in at least one month of 2017.
--Step-1: “cma” CTE computes the centred moving average for every product/month.  
--Step-2: “above2” retains 2017 rows whose ratio exceeds 2.  
--Step-3: “winners” collapses to distinct product_id values that met the condition (≥ 1 month).  
--Final select joins to PRODUCTS to display product names, ordered alphabetically, limited to 20 rows.
WITH cma AS (
    SELECT
        "product_id",
        "mth",
        "qty",
        (
            AVG("qty") OVER (PARTITION BY "product_id" ORDER BY "mth"
                             ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
          + AVG("qty") OVER (PARTITION BY "product_id" ORDER BY "mth"
                             ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
        ) / 2 AS "cma_final"
    FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
), above2 AS (
    SELECT
        "product_id",
        "mth"
    FROM cma
    WHERE "mth" LIKE '2017-%'
      AND "cma_final" <> 0
      AND ("qty" / "cma_final") > 2
), winners AS (
    SELECT DISTINCT
        "product_id"
    FROM above2
)
SELECT
    p."id"   AS "product_id",
    p."name" AS "product_name"
FROM "ORACLE_SQL"."ORACLE_SQL"."PRODUCTS" p
JOIN winners w
  ON p."id" = w."product_id"
ORDER BY p."name"
LIMIT 20;
```
