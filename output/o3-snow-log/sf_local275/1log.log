--Description: 3) For each product/month, compute the 12-month centered moving average (CMA_A) using 5 months before & 6 after.
SELECT 
  "product_id",
  "mth",
  "qty",
  AVG("qty") OVER (
        PARTITION BY "product_id"
        ORDER BY "mth"
        ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
  ) AS "cma_a"
FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
ORDER BY "product_id", "mth"
LIMIT 20
