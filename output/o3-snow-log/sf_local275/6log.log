```

```sql
--Description: 6) Add a centered moving average (window 5 months before, 6 months after) and a 2nd window (6 before, 5 after).
SELECT ms."product_id",
       ms."mth",
       ms."qty",
       AVG(ms."qty") OVER (
           PARTITION BY ms."product_id"
           ORDER BY ms."mth"
           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
       )                                             AS "cma_5_6",
       AVG(ms."qty") OVER (
           PARTITION BY ms."product_id"
           ORDER BY ms."mth"
           ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
       )                                             AS "cma_6_5"
FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" ms
ORDER  BY ms."product_id", ms."mth"
LIMIT 20;
```

```sql
--Description: 7) Compute the “combined CMA” (avg of the two) plus the Sales-to-CMA ratio for each row.
SELECT ms."product_id",
       ms."mth",
       ms."qty",
       ( (AVG(ms."qty") OVER (PARTITION BY ms."product_id" ORDER BY ms."mth"
                               ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
         + AVG(ms."qty") OVER (PARTITION BY ms."product_id" ORDER BY ms."mth"
                               ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) ) / 2
       )                                             AS "cma",
       ms."qty" /
       ( (AVG(ms."qty") OVER (PARTITION BY ms."product_id" ORDER BY ms."mth"
                               ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
         + AVG(ms."qty") OVER (PARTITION BY ms."product_id" ORDER BY ms."mth"
                               ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) ) / 2
       )                                             AS "sales_to_cma"
FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" ms
ORDER BY ms."product_id", ms."mth"
LIMIT 20;
```

```sql
--Description: 8) Restrict the above calculation to months in 2017 only and keep the ratio column for inspection.
WITH ratios AS (
  SELECT ms."product_id",
         ms."mth",
         ( (AVG(ms."qty") OVER (PARTITION BY ms."product_id" ORDER BY ms."mth"
                                 ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
           + AVG(ms."qty") OVER (PARTITION BY ms."product_id" ORDER BY ms."mth"
                                 ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) ) / 2
         )                           AS "cma",
         ms."qty"                    AS "qty",
         ms."qty" /
         ( (AVG(ms."qty") OVER (PARTITION BY ms."product_id" ORDER BY ms."mth"
                                 ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
           + AVG(ms."qty") OVER (PARTITION BY ms."product_id" ORDER BY ms."mth"
                                 ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) ) / 2
         )                           AS "ratio"
  FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" ms
  WHERE  ms."mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT *
FROM   ratios
ORDER  BY "product_id", "mth"
LIMIT 20;
```

```sql
--Description: 9) Find months in 2017 where the ratio exceeded 2; this tells us “peaks” above twice the CMA.
WITH ratios AS (
  SELECT ms."product_id",
         ms."mth",
         ms."qty" AS "qty",
         ms."qty" /
         ( (AVG(ms."qty") OVER (PARTITION BY ms."product_id" ORDER BY ms."mth"
                                 ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
           + AVG(ms."qty") OVER (PARTITION BY ms."product_id" ORDER BY ms."mth"
                                 ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) ) / 2
         )                           AS "ratio"
  FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" ms
  WHERE  ms."mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT *
FROM   ratios
WHERE  "ratio" > 2
ORDER  BY "product_id", "mth"
LIMIT 20;
```

```sql
--Description: 10) Identify products whose ratio stayed ABOVE 2 for *every* month of 2017 (i.e. never dipped ≤2).
WITH ratios AS (
  SELECT ms."product_id",
         ms."mth",
         ms."qty" /
         ( (AVG(ms."qty") OVER (PARTITION BY ms."product_id" ORDER BY ms."mth"
                                 ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
           + AVG(ms."qty") OVER (PARTITION BY ms."product_id" ORDER BY ms."mth"
                                 ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) ) / 2
         )                           AS "ratio"
  FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" ms
  WHERE  ms."mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT r."product_id", p."name"
FROM   ratios r
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PRODUCTS" p
       ON p."id" = r."product_id"
GROUP  BY r."product_id", p."name"
HAVING MIN(r."ratio") > 2
ORDER  BY r."product_id"
LIMIT 20;
```
