--Description: 8) Restrict to 2017 rows (using LIKE to avoid text-BETWEEN pitfalls) and expose CMA & ratio.
WITH ratios AS (
  SELECT
         ms."product_id",
         ms."mth",
         (  AVG(ms."qty") OVER (
               PARTITION BY ms."product_id"
               ORDER BY ms."mth"
               ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
            )
          + AVG(ms."qty") OVER (
               PARTITION BY ms."product_id"
               ORDER BY ms."mth"
               ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
            )
         ) / 2                 AS "cma",
         ms."qty",
         ms."qty" /
         (  AVG(ms."qty") OVER (
               PARTITION BY ms."product_id"
               ORDER BY ms."mth"
               ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
            )
          + AVG(ms."qty") OVER (
               PARTITION BY ms."product_id"
               ORDER BY ms."mth"
               ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
            )
         ) * 2                 AS "ratio"
  FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" ms
  WHERE  ms."mth" LIKE '2017-%'
)
SELECT *
FROM   ratios
ORDER  BY "product_id", "mth"
LIMIT 20
