--Description: Determine which products kept their Sales-to-CMA ratio above 2 every month of 2017.  
--             1) For each 2017 month, calculate two centred 12-month moving averages (5 prev/6 next and 6 prev/5 next).  
--             2) Average those two CMAs, then compute the ratio: actual / CMA.  
--             3) Aggregate per product and keep only those whose minimum 2017 ratio exceeds 2.  
WITH ratios AS (
    SELECT
           ms."product_id",
           ms."mth",
           ms."qty" /
           ( (AVG(ms."qty") OVER (PARTITION BY ms."product_id"
                                  ORDER BY ms."mth"
                                  ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
            + AVG(ms."qty") OVER (PARTITION BY ms."product_id"
                                  ORDER BY ms."mth"
                                  ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)) / 2
           ) AS "ratio"
    FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" ms
    WHERE  ms."mth" LIKE '2017-%'      -- restrict to 2017 months
)
