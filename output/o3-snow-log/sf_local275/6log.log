--Description: 6) Add two centered moving‐average windows (5-before/6-after and 6-before/5-after) for every product/month.
SELECT
       ms."product_id",
       ms."mth",
       ms."qty",
       AVG(ms."qty") OVER (
           PARTITION BY ms."product_id"
           ORDER BY ms."mth"
           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
       ) AS "cma_5_6",
       AVG(ms."qty") OVER (
           PARTITION BY ms."product_id"
           ORDER BY ms."mth"
           ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
       ) AS "cma_6_5"
FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" ms
ORDER  BY ms."product_id", ms."mth"
LIMIT 20
