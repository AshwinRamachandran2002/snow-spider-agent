--Description: 9) Show the 2017 months in which the Sales-to-CMA ratio exceeded 2 (peaks).
WITH ratios AS (
  SELECT
         ms."product_id",
         ms."mth",
         ms."qty",
         ms."qty" /
         (  AVG(ms."qty") OVER (
               PARTITION BY ms."product_id"
               ORDER BY ms."mth"
               ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
            )
          + AVG(ms."qty") OVER (
               PARTITION BY ms."product_id"
               ORDER BY ms."mth"
               ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
            )
         ) * 2                 AS "ratio"
  FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" ms
  WHERE  ms."mth" LIKE '2017-%'
)
SELECT *
FROM   ratios
WHERE  "ratio" > 2
ORDER  BY "product_id", "mth"
LIMIT 20
