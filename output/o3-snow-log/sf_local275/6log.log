Query:
--Description: 7) Compute the combined CMA (average of the two windows) and the Sales-to-CMA ratio for each row.
SELECT
       ms."product_id",
       ms."mth",
       ms."qty",
       (  AVG(ms."qty") OVER (
             PARTITION BY ms."product_id"
             ORDER BY ms."mth"
             ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
          )
        + AVG(ms."qty") OVER (
             PARTITION BY ms."product_id"
             ORDER BY ms."mth"
             ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
          )
       ) / 2                              AS "cma",
       ms."qty" /
       (  AVG(ms."qty") OVER (
             PARTITION BY ms."product_id"
             ORDER BY ms."mth"
             ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
          )
        + AVG(ms."qty") OVER (
             PARTITION BY ms."product_id"
             ORDER BY ms."mth"
             ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
          )
       ) * 2                              AS "sales_to_cma"
FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES" ms
ORDER  BY ms."product_id", ms."mth"
LIMIT 20
