--Description:
-- For every product, compute its seasonality-adjusted sales-to-CMA ratio for each month of 2017,
-- then list the minimum and maximum ratio it reached that year.  
-- This lets us see how close (or far) each product is to the “ratio > 2 for every month” goal
-- and avoids earlier alias errors by properly joining to the PRODUCTS table (alias p).  
WITH ratio_2017 AS (
    SELECT
        "product_id",
        "mth",
        "qty",
        /* centred moving average = mean of two overlapping 12-month windows */
        (   AVG("qty") OVER (
                PARTITION BY "product_id"
                ORDER BY "mth"
                ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
            )
          + AVG("qty") OVER (
                PARTITION BY "product_id"
                ORDER BY "mth"
                ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
            )
        ) / 2                                         AS "cma",
        /* sales-to-CMA ratio (NULL if CMA = 0) */
        "qty" / NULLIF(
            (   AVG("qty") OVER (
                    PARTITION BY "product_id"
                    ORDER BY "mth"
                    ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
                )
              + AVG("qty") OVER (
                    PARTITION BY "product_id"
                    ORDER BY "mth"
                    ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
                )
            ) / 2, 0)                                 AS "sales_to_cma"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
    WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT
    r."product_id",
    p."name"                    AS "product_name",
    MIN(r."sales_to_cma")       AS "min_ratio_2017",
    MAX(r."sales_to_cma")       AS "max_ratio_2017"
FROM ratio_2017 r
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
      ON p."id" = r."product_id"
GROUP BY r."product_id", p."name"
ORDER BY "min_ratio_2017" DESC
LIMIT 20;
