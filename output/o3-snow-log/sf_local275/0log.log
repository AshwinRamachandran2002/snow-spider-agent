```sql
-- 4. Description: Compute centered-moving-average (CMA) and sales-to-CMA ratio
-- for one sample product (4040) over its whole timeline, to verify logic
SELECT 
  "product_id",
  "mth",
  "qty",
  AVG("qty") OVER (PARTITION BY "product_id"
                   ORDER BY "mth"
                   ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)  AS "cma1",
  AVG("qty") OVER (PARTITION BY "product_id"
                   ORDER BY "mth"
                   ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)  AS "cma2",
  (AVG("qty") OVER (PARTITION BY "product_id"
                    ORDER BY "mth"
                    ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
   + 
   AVG("qty") OVER (PARTITION BY "product_id"
                    ORDER BY "mth"
                    ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)) / 2  AS "cma",
  CASE 
      WHEN ( (AVG("qty") OVER (PARTITION BY "product_id"
                               ORDER BY "mth"
                               ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
               + 
              AVG("qty") OVER (PARTITION BY "product_id"
                               ORDER BY "mth"
                               ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)) / 2 ) = 0 
      THEN NULL
      ELSE "qty" / ( (AVG("qty") OVER (PARTITION BY "product_id"
                                       ORDER BY "mth"
                                       ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
                       + 
                      AVG("qty") OVER (PARTITION BY "product_id"
                                       ORDER BY "mth"
                                       ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)) / 2 )
  END                                                    AS "sales_to_cma"
FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
WHERE "product_id" = 4040
ORDER BY "mth"
LIMIT 20;
```

```sql
-- 5. Description: Same CMA + ratio computation for every product,
-- but show only months in 2017 (7th–30th month from Jan-2016 is completely inside 2017)
SELECT
  "product_id",
  "mth",
  "qty",
  -- centered moving averages & ratio (same formula as query 4)
  (   AVG("qty") OVER (PARTITION BY "product_id"
                       ORDER BY "mth"
                       ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
    + AVG("qty") OVER (PARTITION BY "product_id"
                       ORDER BY "mth"
                       ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
  )/2                                    AS "cma",
  "qty" /
  (   (   AVG("qty") OVER (PARTITION BY "product_id"
                           ORDER BY "mth"
                           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
        + AVG("qty") OVER (PARTITION BY "product_id"
                           ORDER BY "mth"
                           ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
      )/2
  )                                      AS "sales_to_cma"
FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
LIMIT 20;
```

```sql
-- 6. Description: For each product, find the minimum sales-to-CMA ratio
-- across the 12 calendar months of 2017
WITH ratio_2017 AS (
  SELECT
    "product_id",
    "mth",
    "qty",
    (   AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY "mth"
                         ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
      + AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY "mth"
                         ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
    )/2                                  AS "cma",
    "qty" /
    (   (   AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
          + AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
        )/2
    )                                    AS "sales_to_cma"
  FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
  WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT
  "product_id",
  MIN("sales_to_cma") AS "min_ratio_2017",
  MAX("sales_to_cma") AS "max_ratio_2017"
FROM ratio_2017
GROUP BY "product_id"
ORDER BY "min_ratio_2017" DESC
LIMIT 20;
```

```sql
-- 7. Description: Filter the above to products whose minimum 2017 ratio > 2
WITH ratio_2017 AS (
  SELECT
    "product_id",
    "mth",
    (   AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY "mth"
                         ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
      + AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY "mth"
                         ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
    )/2                                  AS "cma",
    "qty" /
    (   (   AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
          + AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
        )/2
    )                                    AS "sales_to_cma"
  FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
  WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT "product_id"
FROM ratio_2017
GROUP BY "product_id"
HAVING MIN("sales_to_cma") > 2
LIMIT 20;
```

```sql
-- 8. Description: Attach human-readable product names for those winners
WITH ratio_2017 AS (
  SELECT
    "product_id",
    (   AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY "mth"
                         ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
      + AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY "mth"
                         ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
    )/2                                  AS "cma",
    "qty" /
    (   (   AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
          + AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
        )/2
    )                                    AS "sales_to_cma"
  FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
  WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT DISTINCT p."id"           AS "product_id",
       p."name"                  AS "product_name"
FROM ratio_2017 r
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
  ON p."id" = r."product_id"
GROUP BY p."id", p."name"
HAVING MIN(r."sales_to_cma") > 2
LIMIT 20;
```

```sql
-- 9. Description: (Final answer) show each month of 2017 for the qualifying
-- products to verify the ratio really stayed above 2 the whole year
WITH ratio_2017 AS (
  SELECT
    "product_id",
    "mth",
    "qty",
    (   AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY "mth"
                         ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
      + AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY "mth"
                         ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
    )/2                                  AS "cma",
    "qty" /
    (   (   AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
          + AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
        )/2
    )                                    AS "sales_to_cma"
  FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
  WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT  r."product_id",
        p."name"          AS "product_name",
        r."mth",
        r."qty",
        r."cma",
        r."sales_to_cma"
FROM ratio_2017 r
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
  ON p."id" = r."product_id"
WHERE r."product_id" IN (
    SELECT "product_id"
    FROM ratio_2017
    GROUP BY "product_id"
    HAVING MIN("sales_to_cma") > 2
)
ORDER BY r."product_id", r."mth"
LIMIT 20;
```

