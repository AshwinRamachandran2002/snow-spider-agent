```sql
WITH sales AS (
    SELECT 
        "product_id",
        TO_DATE("mth", 'YYYY-MM-DD')      AS "mth",
        "qty"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
), 
cma_calc AS (
    SELECT
        "product_id",
        "mth",
        "qty",
        -- centred-moving-average (mean of two overlapping 12-month windows)
        (
            AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
          + AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
        ) / 2                                             AS "cma",
        -- sales-to-CMA ratio
        "qty" / NULLIF(
            (
                AVG("qty") OVER (PARTITION BY "product_id"
                                 ORDER BY "mth"
                                 ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
              + AVG("qty") OVER (PARTITION BY "product_id"
                                 ORDER BY "mth"
                                 ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
            ) / 2 , 0)                                    AS "sales_to_cma"
    FROM sales
),
ratio_2017 AS (
    SELECT *
    FROM cma_calc
    WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT
    r."product_id",
    p."name" AS "product_name"
FROM ratio_2017 r
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
  ON p."id" = r."product_id"
GROUP BY
    r."product_id",
    p."name"
HAVING
    COUNT(*) = 12           -- all 12 months present
    AND MIN(r."sales_to_cma") > 2  -- ratio stayed above 2 every month
ORDER BY
    r."product_id";
```
