--Description: 
-- Build a seasonality–adjusted view of 2017 sales, then list the products whose
-- sales-to-CMA ratio stayed above 2 for every single month of that year.  
-- Steps
-- 1. ratio_2017:  for each product-month in 2017, compute the centred moving
--    average (CMA) = average of two overlapping 12-month windows
--       • window A: 5 months before + 6 months after
--       • window B: 6 months before + 5 months after
--    and derive sales_to_cma = qty ÷ CMA (NULLIF protects against /0).  
-- 2. winners: keep only the products whose MIN ratio across all 12 months > 2.  
-- 3. Final query joins to PRODUCTS to show the human-readable name.  
WITH ratio_2017 AS (
    SELECT
        "product_id",
        (
            AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
          + AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
        ) / 2                                                   AS "cma",
        "qty" / NULLIF(
            (
                AVG("qty") OVER (PARTITION BY "product_id"
                                 ORDER BY "mth"
                                 ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
              + AVG("qty") OVER (PARTITION BY "product_id"
                                 ORDER BY "mth"
                                 ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
            ) / 2 , 0)                                          AS "sales_to_cma"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
    WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
),
winners AS (
    SELECT
        "product_id"
    FROM ratio_2017
    GROUP BY "product_id"
    HAVING MIN("sales_to_cma") > 2                              -- ratio >2 every month
)
SELECT
    w."product_id",
    p."name"   AS "product_name"
FROM winners w
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
      ON p."id" = w."product_id"
ORDER BY w."product_id"
LIMIT 20;
