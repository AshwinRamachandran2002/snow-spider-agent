--Description:
-- Objective: identify products whose seasonality-adjusted sales ratio (sales ÷ centred-moving-average)
-- remained above 2 for every month of calendar year 2017.
-- Reasoning inside query:
--   1) ratio_2017 CTE:
--        • For each product-month in 2017, calculate the centred moving average (CMA) as the
--          average of two overlapping 12-month windows:
--             – Window A: 5 months before + 6 months after
--             – Window B: 6 months before + 5 months after
--        • Compute sales_to_cma = qty ÷ CMA (CMA never zero in data; otherwise NULLIF could be used).
--   2) Final SELECT joins to PRODUCTS (alias p) to display the product name, then aggregates
--      all twelve 2017 rows per product and filters with HAVING MIN(ratio) > 2, meaning the
--      ratio exceeded 2 in every month.  If no product meets this strict criterion
--      the query will naturally return zero rows.
WITH ratio_2017 AS (
    SELECT
        "product_id",
        "mth",
        "qty",
        (
            AVG("qty") OVER (
                PARTITION BY "product_id"
                ORDER BY "mth"
                ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
            )
          + AVG("qty") OVER (
                PARTITION BY "product_id"
                ORDER BY "mth"
                ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
            )
        ) / 2                                         AS "cma",
        "qty" /
        (
            (
                AVG("qty") OVER (
                    PARTITION BY "product_id"
                    ORDER BY "mth"
                    ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
                )
              + AVG("qty") OVER (
                    PARTITION BY "product_id"
                    ORDER BY "mth"
                    ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
                )
            ) / 2
        )                                             AS "sales_to_cma"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
    WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT
    r."product_id",
    p."name"                  AS "product_name",
    MIN(r."sales_to_cma")     AS "min_ratio_2017",
    MAX(r."sales_to_cma")     AS "max_ratio_2017"
FROM ratio_2017 r
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
      ON p."id" = r."product_id"
GROUP BY r."product_id", p."name"
HAVING MIN(r."sales_to_cma") > 2
ORDER BY r."product_id"
LIMIT 20;
