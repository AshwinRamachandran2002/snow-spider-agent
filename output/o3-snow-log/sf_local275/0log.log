Query:
-- 6. Description: For each product, find the minimum sales-to-CMA ratio
-- across the 12 calendar months of 2017
WITH ratio_2017 AS (
  SELECT
    "product_id",
    "mth",
    "qty",
    (   AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY "mth"
                         ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
      + AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY "mth"
                         ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
    )/2                                  AS "cma",
    "qty" /
    (   (   AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
          + AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
        )/2
    )                                    AS "sales_to_cma"
  FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
  WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT
  "product_id",
  MIN("sales_to_cma") AS "min_ratio_2017",
  MAX("sales_to_cma") AS "max_ratio_2017"
FROM ratio_2017
GROUP BY "product_id"
ORDER BY "min_ratio_2017" DESC
LIMIT 20;
