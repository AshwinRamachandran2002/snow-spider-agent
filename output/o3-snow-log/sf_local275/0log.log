--Description:
-- Goal: Examine, for every product, how its seasonality-adjusted sales ratio behaved during 2017.  
--        • Compute the centred moving average (CMA) for each month as the mean of two overlapping
--          12-month windows (5 months before + 6 after, and 6 before + 5 after).  
--        • Derive the ratio = sales ÷ CMA.  
--        • Aggregate to find the minimum and maximum ratio each product achieved in 2017.  
--        (You can adjust the HAVING clause to any threshold; here it is commented out so
--         you see all products and can decide whether any meet a chosen cut-off.)  
WITH ratio_2017 AS (
    SELECT
        "product_id",
        "mth",
        "qty",
        (
            AVG("qty") OVER (
                PARTITION BY "product_id"
                ORDER BY "mth"
                ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
            )
          + AVG("qty") OVER (
                PARTITION BY "product_id"
                ORDER BY "mth"
                ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
            )
        ) / 2                                                       AS "cma",
        "qty" /
        NULLIF((
            AVG("qty") OVER (
                PARTITION BY "product_id"
                ORDER BY "mth"
                ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
            )
          + AVG("qty") OVER (
                PARTITION BY "product_id"
                ORDER BY "mth"
                ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
            )
        ) / 2, 0)                                                   AS "sales_to_cma"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
    WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT
    r."product_id",
    p."name"                        AS "product_name",
    MIN(r."sales_to_cma")           AS "min_ratio_2017",
    MAX(r."sales_to_cma")           AS "max_ratio_2017"
