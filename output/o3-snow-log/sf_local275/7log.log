```sql
--Description:
-- Thinking process (inline):
-- 1. We need to know, per product, how often the sales-to-CMA ratio
--    exceeded 2 during 2017 and how many 2017 months exist in total.
-- 2. Build a month index (rn) so we can apply centred windows.
-- 3. Compute two overlapping 12-month averages, then take their mean as the CMA.
-- 4. Restrict to 2017 months, calculate the ratio, and aggregate:
--      • cnt_2017       : number of 2017 months we have sales for
--      • cnt_ratio_gt2  : number of those months where ratio > 2
-- 5. If cnt_2017 = cnt_ratio_gt2, the product stayed above 2 all year.
WITH seq AS (
    SELECT
        "product_id",
        "mth",
        "qty",
        ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth") AS "rn"
    FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
),
cma_calc AS (
    SELECT
        "product_id",
        "mth",
        "qty",
        ( AVG("qty") OVER (PARTITION BY "product_id"
                           ORDER BY "rn"
                           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
        + AVG("qty") OVER (PARTITION BY "product_id"
                           ORDER BY "rn"
                           ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)
        ) / 2 AS "cma"
    FROM seq
),
ratios_2017 AS (
    SELECT
        "product_id",
        "mth",
        "qty",
        "cma",
        "qty" / NULLIF("cma",0) AS "ratio"
    FROM cma_calc
    WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT
    "product_id",
    COUNT(*)                                   AS "cnt_2017",
    SUM(CASE WHEN "ratio" > 2 THEN 1 ELSE 0 END) AS "cnt_ratio_gt2"
FROM ratios_2017
GROUP BY "product_id"
ORDER BY "cnt_ratio_gt2" DESC, "product_id"
LIMIT 20;
