```

```sql
--Description: 2017 sales only, to see which months exist per product  
SELECT "product_id",
       "mth",
       "qty"  
FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"  
WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'  
ORDER BY "product_id", "mth"  
LIMIT 20;
```

```sql
--Description: Add an ordinal month index inside each product’s history  
SELECT "product_id",
       "mth",
       "qty",
       ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth") AS "mon_no"
FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"  
ORDER BY "product_id", "mth"  
LIMIT 20;
```

```sql
--Description: Restrict to months 7–30 (to avoid edge effects)  
WITH seq AS (  
  SELECT "product_id",
         "mth",
         "qty",
         ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth") AS "mon_no"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"  
)  
SELECT *  
FROM seq  
WHERE "mon_no" BETWEEN 7 AND 30  
ORDER BY "product_id", "mth"  
LIMIT 20;
```

```sql
--Description: Compute first centered-window average: 5 months before & 6 after  
WITH seq AS (  
  SELECT "product_id","mth","qty",
         ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth") AS "mon_no"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"  
)  
SELECT "product_id","mth","qty","mon_no",
       AVG("qty") OVER (PARTITION BY "product_id"
                        ORDER BY "mon_no"
                        ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) AS "cma1"
FROM seq  
WHERE "mon_no" BETWEEN 7 AND 30  
ORDER BY "product_id","mth"  
LIMIT 20;
```

```sql
--Description: Compute second centered-window average: 6 months before & 5 after  
WITH seq AS (  
  SELECT "product_id","mth","qty",
         ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth") AS "mon_no"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"  
)  
SELECT "product_id","mth","qty","mon_no",
       AVG("qty") OVER (PARTITION BY "product_id"
                        ORDER BY "mon_no"
                        ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "cma2"
FROM seq  
WHERE "mon_no" BETWEEN 7 AND 30  
ORDER BY "product_id","mth"  
LIMIT 20;
```

```sql
--Description: Combine both CMAs, take their average, and calculate the Sales-to-CMA ratio  
WITH seq AS (  
  SELECT "product_id","mth","qty",
         ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth") AS "mon_no"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"  
), cma AS (  
  SELECT *,
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "mon_no"
                          ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) AS "cma1",
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "mon_no"
                          ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "cma2"
  FROM seq  
  WHERE "mon_no" BETWEEN 7 AND 30  
)  
SELECT "product_id","mth","qty",
       ("cma1"+"cma2")/2 AS "cma",
       "qty"/NULLIF(("cma1"+"cma2")/2,0) AS "ratio"
FROM cma  
ORDER BY "product_id","mth"  
LIMIT 20;
```

```sql
--Description: Find 2017 months where the Sales-to-CMA ratio is NOT above 2  
WITH seq AS (  
  SELECT "product_id","mth","qty",
         ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth") AS "mon_no"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"  
), cma AS (  
  SELECT *,
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "mon_no"
                          ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) AS "cma1",
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "mon_no"
                          ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "cma2"
  FROM seq  
  WHERE "mon_no" BETWEEN 7 AND 30  
)  
SELECT "product_id","mth","qty",
       ("cma1"+"cma2")/2 AS "cma",
       "qty"/NULLIF(("cma1"+"cma2")/2,0) AS "ratio"
FROM cma  
WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
  AND ("qty"/NULLIF(("cma1"+"cma2")/2,0)) <= 2  
ORDER BY "product_id","mth"  
LIMIT 20;
```

```sql
--Description: Final list of products whose ratio stayed above 2 for every month in 2017  
WITH seq AS (  
  SELECT "product_id","mth","qty",
         ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth") AS "mon_no"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"  
), cma AS (  
  SELECT *,
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "mon_no"
                          ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) AS "cma1",
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "mon_no"
                          ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "cma2"
  FROM seq  
  WHERE "mon_no" BETWEEN 7 AND 30  
), ratios AS (  
  SELECT "product_id","mth",
         "qty",
         ("cma1"+"cma2")/2 AS "cma",
         "qty"/NULLIF(("cma1"+"cma2")/2,0) AS "ratio"
  FROM cma  
  WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'  
)  
SELECT DISTINCT "product_id"  
FROM ratios  
GROUP BY "product_id"  
HAVING MIN("ratio") > 2  
ORDER BY "product_id"  
LIMIT 20;
```
