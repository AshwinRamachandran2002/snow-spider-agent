/*  Products whose sales-to-CMA ratio exceeded 2 in every month of 2017  */
WITH seq AS (      /* add a sequential month index per product          */
    SELECT
        "product_id",
        "mth",
        "qty",
        ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth") AS "mon_no"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
),
calc AS (          /* both 12-month centred moving-average windows      */
    SELECT
        s."product_id",
        s."mth",
        s."qty",
        AVG(s."qty") OVER (PARTITION BY s."product_id"
                           ORDER BY s."mon_no"
                           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) AS "cma1",
        AVG(s."qty") OVER (PARTITION BY s."product_id"
                           ORDER BY s."mon_no"
                           ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "cma2"
    FROM seq s
),
cma AS (           /* final CMA and sales-to-CMA ratio                  */
    SELECT
        "product_id",
        "mth",
        "qty",
        ( "cma1" + "cma2" ) / 2                                        AS "cma",
        "qty" / NULLIF( ( "cma1" + "cma2" ) / 2 , 0 )                  AS "ratio"
    FROM calc
),
rat2017 AS (       /* keep only the 12 months of 2017                   */
    SELECT *
    FROM cma
    WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
)
SELECT
    p."id"   AS "product_id",
    p."name"
FROM (
    /* a product qualifies if every one of the 12 months in 2017
       has ratio > 2 and all 12 months are present                 */
    SELECT "product_id"
    FROM rat2017
    GROUP BY "product_id"
    HAVING MIN("ratio") > 2
       AND COUNT(*) = 12
) good
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
      ON p."id" = good."product_id"
ORDER BY p."id";
```
