--Description: Final list of products whose ratio stayed above 2 for every month in 2017  
WITH seq AS (  
  SELECT "product_id","mth","qty",
         ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth") AS "mon_no"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"  
), cma AS (  
  SELECT *,
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "mon_no"
                          ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) AS "cma1",
         AVG("qty") OVER (PARTITION BY "product_id"
                          ORDER BY "mon_no"
                          ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "cma2"
  FROM seq  
  WHERE "mon_no" BETWEEN 7 AND 30  
), ratios AS (  
  SELECT "product_id","mth",
         "qty",
         ("cma1"+"cma2")/2 AS "cma",
         "qty"/NULLIF(("cma1"+"cma2")/2,0) AS "ratio"
  FROM cma  
  WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'  
)  
SELECT DISTINCT "product_id"  
FROM ratios  
GROUP BY "product_id"  
HAVING MIN("ratio") > 2  
ORDER BY "product_id"  
LIMIT 20;
