```sql
WITH sales AS (   -- 1) prepare monthly sales with proper date datatype
    SELECT
        "product_id",
        TO_DATE("mth", 'YYYY-MM-DD') AS "mth",
        "qty"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
),
ma AS (           -- 2) the two 12-month moving-averages that will later be centered
    SELECT
        "product_id",
        "mth",
        "qty",
        AVG("qty") OVER (                 -- window A : 5 months before + current + 6 after
            PARTITION BY "product_id"
            ORDER BY "mth"
            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
        ) AS "avg_a",
        AVG("qty") OVER (                 -- window B : 6 months before + current + 5 after
            PARTITION BY "product_id"
            ORDER BY "mth"
            ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
        ) AS "avg_b"
    FROM sales
),
cma AS (          -- 3) final centred moving average
    SELECT
        "product_id",
        "mth",
        "qty",
        ("avg_a" + "avg_b") / 2 AS "cma"
    FROM ma
),
ratio_2017 AS (   -- 4) keep 2017 months and compute Sales-to-CMA ratio
    SELECT
        "product_id",
        "mth",
        "qty",
        "cma",
        CASE WHEN "cma" <> 0 THEN "qty" / "cma" END AS "ratio"
    FROM cma
    WHERE "mth" BETWEEN '2017-01-01' AND '2017-12-31'
),
qualified_products AS (  -- 5) products whose ratio is >2 for ALL 12 months of 2017
    SELECT
        "product_id"
    FROM ratio_2017
    GROUP BY "product_id"
    HAVING COUNT(*) = 12              -- make sure all 12 months are present
       AND MIN("ratio") > 2           -- ratio stayed consistently above 2
)
-- 6) return product id & name
SELECT
    p."id"   AS "product_id",
    p."name" AS "product_name"
FROM ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
JOIN qualified_products q
  ON p."id" = q."product_id"
ORDER BY "product_id";
```
