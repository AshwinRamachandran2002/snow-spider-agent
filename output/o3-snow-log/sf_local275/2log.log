```sql
-- Description: 5) Calculate the first centred-moving-average (CMA1) that spans 5 months before and 6 months after each row.
SELECT "product_id",
       "mth",
       "qty",
       AVG("qty") OVER (
              PARTITION BY "product_id"
              ORDER BY "mth"
              ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) AS "cma1"
FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
ORDER BY "product_id", "mth"
LIMIT 20;
```

```sql
-- Description: 6) Calculate the second centred-moving-average (CMA2) that spans 6 months before and 5 months after each row.
SELECT "product_id",
       "mth",
       "qty",
       AVG("qty") OVER (
              PARTITION BY "product_id"
              ORDER BY "mth"
              ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "cma2"
FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
ORDER BY "product_id", "mth"
LIMIT 20;
```

```sql
-- Description: 7) Combine CMA1 and CMA2, take their mean, and derive the seasonality-adjusted Sales-to-CMA ratio.
SELECT t."product_id",
       t."mth",
       t."qty",
       (t."cma1" + t."cma2") / 2     AS "cma_final",
       t."qty" / NULLIF( (t."cma1" + t."cma2") / 2 , 0) AS "ratio"
FROM (
        SELECT "product_id",
               "mth",
               "qty",
               AVG("qty") OVER (
                      PARTITION BY "product_id"
                      ORDER BY "mth"
                      ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) AS "cma1",
               AVG("qty") OVER (
                      PARTITION BY "product_id"
                      ORDER BY "mth"
                      ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "cma2"
        FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
     ) t
ORDER BY t."product_id", t."mth"
LIMIT 20;
```

```sql
-- Description: 8) Focus on 2017 only and keep rows where the seasonality-adjusted ratio exceeds 2.
WITH ratios AS (
     SELECT "product_id",
            "mth",
            "qty",
            (AVG("qty") OVER (PARTITION BY "product_id"
                              ORDER BY "mth"
                              ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
           + AVG("qty") OVER (PARTITION BY "product_id"
                              ORDER BY "mth"
                              ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)) / 2 AS "cma",
            "qty" / NULLIF(
                  (AVG("qty") OVER (PARTITION BY "product_id"
                                    ORDER BY "mth"
                                    ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
                 + AVG("qty") OVER (PARTITION BY "product_id"
                                    ORDER BY "mth"
                                    ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)) / 2 , 0) AS "ratio"
     FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
)
SELECT *
FROM ratios
WHERE "mth" LIKE '2017-%'
  AND "ratio" > 2
ORDER BY "product_id", "mth"
LIMIT 20;
```

```sql
-- Description: 9) Count in how many 2017 months each product’s ratio stayed above 2 (should be 12 for “every month”).
WITH ratios AS (
     SELECT "product_id",
            "mth",
            (AVG("qty") OVER (PARTITION BY "product_id"
                              ORDER BY "mth"
                              ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
           + AVG("qty") OVER (PARTITION BY "product_id"
                              ORDER BY "mth"
                              ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)) / 2 AS "cma",
            "qty" / NULLIF(
                  (AVG("qty") OVER (PARTITION BY "product_id"
                                    ORDER BY "mth"
                                    ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
                 + AVG("qty") OVER (PARTITION BY "product_id"
                                    ORDER BY "mth"
                                    ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)) / 2 , 0) AS "ratio"
     FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
)
SELECT r."product_id",
       COUNT(*) AS "months_above_2"
FROM ratios r
WHERE r."mth" LIKE '2017-%'
  AND r."ratio" > 2
GROUP BY r."product_id"
HAVING COUNT(*) = 12
LIMIT 20;
```

```sql
-- Description: 10) Retrieve the final list of products whose seasonality-adjusted ratio was >2 in every 2017 month, including product names.
WITH ratios AS (
     SELECT "product_id",
            "mth",
            (AVG("qty") OVER (PARTITION BY "product_id"
                              ORDER BY "mth"
                              ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
           + AVG("qty") OVER (PARTITION BY "product_id"
                              ORDER BY "mth"
                              ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)) / 2 AS "cma",
            "qty" / NULLIF(
                  (AVG("qty") OVER (PARTITION BY "product_id"
                                    ORDER BY "mth"
                                    ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)
                 + AVG("qty") OVER (PARTITION BY "product_id"
                                    ORDER BY "mth"
                                    ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING)) / 2 , 0) AS "ratio"
     FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
)
SELECT p."id"          AS "product_id",
       p."name"        AS "product_name"
FROM ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
JOIN (
       SELECT r."product_id"
       FROM ratios r
       WHERE r."mth" LIKE '2017-%'
         AND r."ratio" > 2
       GROUP BY r."product_id"
       HAVING COUNT(*) = 12
     ) q
     ON q."product_id" = p."id"
LIMIT 20;
```
