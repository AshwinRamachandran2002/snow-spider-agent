```sql
-- Description: 4) Retrieve month-by-month quantities for every product in 2017 to see the raw values we will later adjust.
SELECT s."product_id",
       p."name",
       s."mth",
       s."qty"
FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"  s
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"       p
