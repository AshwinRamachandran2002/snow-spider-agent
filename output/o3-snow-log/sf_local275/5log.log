-- Description: Filter to months 7-30 per product and keep only 2017 rows where ratio > 2
WITH step1 AS (
  SELECT "product_id",
         "mth",
         "qty",
         ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth") AS "row_no",
         AVG("qty") OVER (
           PARTITION BY "product_id"
           ORDER BY "mth"
           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
         ) AS "cma1",
         AVG("qty") OVER (
           PARTITION BY "product_id"
           ORDER BY "mth"
           ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
         ) AS "cma2"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
), step2 AS (
  SELECT "product_id",
         "mth",
         "qty",
         ("cma1" + "cma2") / 2 AS "cma",
         "row_no"
  FROM   step1
  WHERE  "row_no" BETWEEN 7 AND 30
)
SELECT *
FROM   step2
WHERE  SUBSTR("mth",1,4) = '2017'
  AND  "qty" / NULLIF("cma",0) > 2
ORDER  BY "product_id","mth"
LIMIT 20;
