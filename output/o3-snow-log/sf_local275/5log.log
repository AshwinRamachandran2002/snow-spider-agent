```sql
-- Description: Inspect raw sales data – first 20 rows in the monthly sales fact table
SELECT * 
FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
LIMIT 20;
```

```sql
-- Description: List distinct sales years that exist in the fact table
SELECT DISTINCT SUBSTR("mth",1,4) AS "year"
FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
ORDER BY "year"
LIMIT 20;
```

```sql
-- Description: Show how many sales‐months each product registered during calendar year 2017
SELECT "product_id",
       COUNT(*) AS "month_cnt_2017"
FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
WHERE  SUBSTR("mth",1,4) = '2017'
GROUP  BY "product_id"
ORDER  BY "month_cnt_2017" DESC
LIMIT 20;
```

```sql
-- Description: Display month-by-month quantities for one sample product (4040) across 2016-2018
SELECT "mth",
       "qty"
FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
WHERE  "product_id" = 4040
  AND  SUBSTR("mth",1,4) BETWEEN '2016' AND '2018'
ORDER  BY "mth"
LIMIT 20;
```

```sql
-- Description: Compute first centred window (5 months before, 6 months after) – CMA1
SELECT "product_id",
       "mth",
       "qty",
       AVG("qty") OVER (
         PARTITION BY "product_id"
         ORDER BY "mth"
         ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
       ) AS "cma1"
FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
ORDER  BY "product_id","mth"
LIMIT 20;
```

```sql
-- Description: Compute second centred window (6 months before, 5 months after) – CMA2
SELECT "product_id",
       "mth",
       "qty",
       AVG("qty") OVER (
         PARTITION BY "product_id"
         ORDER BY "mth"
         ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
       ) AS "cma2"
FROM   "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
ORDER  BY "product_id","mth"
LIMIT 20;
```

```sql
-- Description: Derive the final CMA as the average of CMA1 and CMA2
WITH two_windows AS (
  SELECT "product_id",
         "mth",
         "qty",
         AVG("qty") OVER (
           PARTITION BY "product_id"
           ORDER BY "mth"
           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
         ) AS "cma1",
         AVG("qty") OVER (
           PARTITION BY "product_id"
           ORDER BY "mth"
           ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
         ) AS "cma2"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
)
SELECT "product_id",
       "mth",
       "qty",
       ("cma1" + "cma2") / 2 AS "cma"
FROM   two_windows
ORDER  BY "product_id","mth"
LIMIT 20;
```

```sql
-- Description: Calculate the sales-to-CMA ratio for every record
WITH base AS (
  SELECT "product_id",
         "mth",
         "qty",
         AVG("qty") OVER (
           PARTITION BY "product_id"
           ORDER BY "mth"
           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
         ) AS "cma1",
         AVG("qty") OVER (
           PARTITION BY "product_id"
           ORDER BY "mth"
           ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
         ) AS "cma2"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
)
SELECT "product_id",
       "mth",
       "qty",
       ("cma1" + "cma2") / 2      AS "cma",
       CASE 
         WHEN ("cma1" + "cma2")/2 = 0 THEN NULL
         ELSE "qty" / (("cma1" + "cma2")/2) 
       END                       AS "sales_to_cma_ratio"
FROM   base
ORDER  BY "product_id","mth"
LIMIT 20;
```

```sql
-- Description: Filter to months 7-30 per product and keep only 2017 rows where ratio > 2
WITH step1 AS (
  SELECT "product_id",
         "mth",
         "qty",
         ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth") AS "row_no",
         AVG("qty") OVER (
           PARTITION BY "product_id"
           ORDER BY "mth"
           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
         ) AS "cma1",
         AVG("qty") OVER (
           PARTITION BY "product_id"
           ORDER BY "mth"
           ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
         ) AS "cma2"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
), step2 AS (
  SELECT "product_id",
         "mth",
         "qty",
         ("cma1" + "cma2") / 2 AS "cma",
         "row_no"
  FROM   step1
  WHERE  "row_no" BETWEEN 7 AND 30
)
SELECT *
FROM   step2
WHERE  SUBSTR("mth",1,4) = '2017'
  AND  "qty" / NULLIF("cma",0) > 2
ORDER  BY "product_id","mth"
LIMIT 20;
```

```sql
-- Description: Identify products whose 2017 ratio stayed above 2 for all 12 months
WITH ranked AS (
  SELECT "product_id",
         "mth",
         "qty",
         ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth") AS "row_no",
         AVG("qty") OVER (
           PARTITION BY "product_id"
           ORDER BY "mth"
           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
         ) AS "cma1",
         AVG("qty") OVER (
           PARTITION BY "product_id"
           ORDER BY "mth"
           ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
         ) AS "cma2"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
), ratios AS (
  SELECT "product_id",
         "mth",
         ("cma1" + "cma2")/2  AS "cma",
         "qty",
         "row_no"
  FROM   ranked
  WHERE  "row_no" BETWEEN 7 AND 30
), only17 AS (
  SELECT "product_id",
         COUNT(*)                                    AS "months_in_17",
         SUM( CASE WHEN "qty"/NULLIF("cma",0) > 2 
                   THEN 1 ELSE 0 END )              AS "ratio_gt2_cnt"
  FROM   ratios
  WHERE  SUBSTR("mth",1,4) = '2017'
  GROUP  BY "product_id"
)
SELECT "product_id"
FROM   only17
WHERE  "months_in_17" = 12
  AND  "ratio_gt2_cnt" = 12
LIMIT 20;
```
