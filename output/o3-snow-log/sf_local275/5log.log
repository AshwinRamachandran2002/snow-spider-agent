/*--------------------------------------------------------------------
  Identify products whose seasonality-adjusted sales ratio (Sales ÷ CMA)
  was greater than 2 for EVERY single month in calendar-year 2017.
--------------------------------------------------------------------*/
WITH base AS (  -- raw facts with dates converted
    SELECT
        "product_id",
        TO_DATE("mth")          AS "mth_date",
        "qty"
    FROM ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
),
calc AS (       -- two overlapping 12-month centred moving averages
    SELECT
        "product_id",
        "mth_date",
        "qty",
        ROW_NUMBER() OVER (PARTITION BY "product_id"
                           ORDER BY "mth_date")            AS "row_no",
        AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY "mth_date"
                         ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) AS "cma1",
        AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY "mth_date"
                         ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS "cma2"
    FROM base
),
ratio_data AS ( -- restrict to rows 7-30 and compute ratio
    SELECT
        "product_id",
        "mth_date",
        "qty",
        ("cma1" + "cma2") / 2                                AS "cma",
        CASE
            WHEN ("cma1" + "cma2") / 2 = 0 THEN NULL
            ELSE "qty" / (("cma1" + "cma2") / 2)
        END                                                  AS "ratio"
    FROM calc
    WHERE "row_no" BETWEEN 7 AND 30
),
good_months_2017 AS (  -- months in 2017 where ratio > 2
    SELECT
        "product_id",
        COUNT(*) AS "good_month_cnt"
    FROM ratio_data
    WHERE EXTRACT(year FROM "mth_date") = 2017
      AND "ratio" > 2
    GROUP BY "product_id"
)
SELECT
    g."product_id",
    p."name" AS "product_name"
FROM good_months_2017 g
JOIN ORACLE_SQL.ORACLE_SQL.PRODUCTS p
      ON p."id" = g."product_id"
WHERE g."good_month_cnt" = 12      -- all 12 months satisfied the condition
ORDER BY g."product_id";
```
