WITH base AS (                     -- Convert text month to DATE
    SELECT
        "product_id",
        TO_DATE("mth")      AS "mth_date",
        "qty"
    FROM ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
),
calc AS (                         -- Compute two centred 12-month CMAs
    SELECT
        "product_id",
        "mth_date",
        "qty",
        ROW_NUMBER() OVER (PARTITION BY "product_id"
                           ORDER BY "mth_date")                     AS "row_no",
        AVG("qty") OVER (PARTITION BY "product_id"
