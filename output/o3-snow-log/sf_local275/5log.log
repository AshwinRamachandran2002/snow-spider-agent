-- Description: Derive the final CMA as the average of CMA1 and CMA2
WITH two_windows AS (
  SELECT "product_id",
         "mth",
         "qty",
         AVG("qty") OVER (
           PARTITION BY "product_id"
           ORDER BY "mth"
           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
         ) AS "cma1",
         AVG("qty") OVER (
           PARTITION BY "product_id"
           ORDER BY "mth"
           ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING
         ) AS "cma2"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
)
SELECT "product_id",
       "mth",
       "qty",
       ("cma1" + "cma2") / 2 AS "cma"
FROM   two_windows
ORDER  BY "product_id","mth"
LIMIT 20;
