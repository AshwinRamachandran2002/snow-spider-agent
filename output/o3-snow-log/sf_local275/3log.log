Query:
--Description: Extend CMA to every product, plus calculate the Sales-to-CMA ratio
SELECT "product_id",
       "mth",
       "qty",
       AVG("qty") OVER (PARTITION BY "product_id"
                        ORDER BY "mth"
                        ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)                                       AS "cma_12m",
       CASE WHEN AVG("qty") OVER (PARTITION BY "product_id"
                                  ORDER BY "mth"
                                  ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) = 0
            THEN NULL
            ELSE ("qty" / AVG("qty") OVER (PARTITION BY "product_id"
                                           ORDER BY "mth"
                                           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING))
       END                                                                                               AS "ratio"
FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
ORDER BY "mth", "product_id"
LIMIT 20;
