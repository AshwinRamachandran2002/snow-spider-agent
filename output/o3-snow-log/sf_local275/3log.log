    FROM cma_calc
    WHERE SUBSTR("mth", 1, 4) = '2017'
)
SELECT
    "product_id",
    "mth",
    "ratio"
FROM ratios
WHERE "ratio" > 2
ORDER BY "product_id", "mth"
