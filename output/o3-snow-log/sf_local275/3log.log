--Description: Focus on the 2017 months and keep only ratios computed inside the safe 7-th to 30-th month range
WITH cte AS (
    SELECT "product_id",
           "mth",
           ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth")           AS "rn",
           "qty",
           AVG("qty") OVER (PARTITION BY "product_id"
                            ORDER BY "mth"
                            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)             AS "cma_12m"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
)
SELECT "product_id",
       "mth",
       "qty",
       "cma_12m",
       CASE WHEN "cma_12m" = 0 THEN NULL ELSE ("qty" / "cma_12m") END            AS "ratio"
FROM cte
WHERE SUBSTR("mth",1,4) = '2017'
  AND "rn" BETWEEN 7 AND 30
ORDER BY "product_id", "mth"
LIMIT 20;
