```sql
--Description: Compute a centered 12-month moving average (5 months before, 6 months after) for one sample product (4040) to validate math
SELECT "product_id",
       "mth",
       "qty",
       AVG("qty") OVER (PARTITION BY "product_id"
                        ORDER BY "mth"
                        ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)  AS "cma_12m"
FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
WHERE "product_id" = 4040
ORDER BY "mth"
LIMIT 20;
```

```sql
--Description: Extend CMA to every product, plus calculate the Sales-to-CMA ratio
SELECT "product_id",
       "mth",
       "qty",
       AVG("qty") OVER (PARTITION BY "product_id"
                        ORDER BY "mth"
                        ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)                                       AS "cma_12m",
       CASE WHEN AVG("qty") OVER (PARTITION BY "product_id"
                                  ORDER BY "mth"
                                  ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) = 0
            THEN NULL
            ELSE ("qty" / AVG("qty") OVER (PARTITION BY "product_id"
                                           ORDER BY "mth"
                                           ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING))
       END                                                                                               AS "ratio"
FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
ORDER BY "mth", "product_id"
LIMIT 20;
```

```sql
--Description: Focus on the 2017 months and keep only ratios computed inside the safe 7-th to 30-th month range
WITH cte AS (
    SELECT "product_id",
           "mth",
           ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth")           AS "rn",
           "qty",
           AVG("qty") OVER (PARTITION BY "product_id"
                            ORDER BY "mth"
                            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)             AS "cma_12m"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
)
SELECT "product_id",
       "mth",
       "qty",
       "cma_12m",
       CASE WHEN "cma_12m" = 0 THEN NULL ELSE ("qty" / "cma_12m") END            AS "ratio"
FROM cte
WHERE SUBSTR("mth",1,4) = '2017'
  AND "rn" BETWEEN 7 AND 30
ORDER BY "product_id", "mth"
LIMIT 20;
```

```sql
--Description: Identify products whose MIN ratio in 2017 (months 7-30) stays above 2
WITH sales_cma AS (
    SELECT "product_id",
           "mth",
           ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth")           AS "rn",
           "qty",
           AVG("qty") OVER (PARTITION BY "product_id"
                            ORDER BY "mth"
                            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)             AS "cma_12m"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
), ratios AS (
    SELECT "product_id",
           "mth",
           CASE WHEN "cma_12m" = 0 THEN NULL ELSE ("qty" / "cma_12m") END        AS "ratio"
    FROM sales_cma
    WHERE SUBSTR("mth",1,4) = '2017'
      AND "rn" BETWEEN 7 AND 30
)
SELECT DISTINCT r."product_id"
FROM ratios r
GROUP BY r."product_id"
HAVING MIN(r."ratio") > 2
LIMIT 20;
```

```sql
--Description: Final step – bring in product names for the consistently high-ratio products
WITH sales_cma AS (
    SELECT "product_id",
           "mth",
           ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "mth")           AS "rn",
           "qty",
           AVG("qty") OVER (PARTITION BY "product_id"
                            ORDER BY "mth"
                            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)             AS "cma_12m"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
), ratios AS (
    SELECT "product_id",
           "mth",
           CASE WHEN "cma_12m" = 0 THEN NULL ELSE ("qty" / "cma_12m") END        AS "ratio"
    FROM sales_cma
    WHERE SUBSTR("mth",1,4) = '2017'
      AND "rn" BETWEEN 7 AND 30
), filtered AS (
    SELECT "product_id"
    FROM ratios
    GROUP BY "product_id"
    HAVING MIN("ratio") > 2
)
SELECT f."product_id",
       p."name" AS "product_name"
FROM filtered f
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
       ON p."id" = f."product_id"
LIMIT 20;
```
