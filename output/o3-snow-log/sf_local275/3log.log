--the earlier “invalid identifier” error.
WITH cma_calc AS (          -- 1. centred 12-month moving average for each product / month
    SELECT
        "product_id",
        "mth",
        "qty",
        AVG("qty") OVER (
            PARTITION BY "product_id"
            ORDER BY "mth"
            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
        ) AS "cma_12m"
