--drop the row-number filter so the check covers all 12 months of 2017.
WITH cma_calc AS (
    SELECT
        "product_id",
        "mth",
        "qty",
        AVG("qty") OVER (
            PARTITION BY "product_id"
            ORDER BY "mth"
            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
        ) AS "cma_12m"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
),
ratios AS (
    SELECT
        "product_id",
        CASE
            WHEN "cma_12m" = 0 THEN NULL
            ELSE "qty" / "cma_12m"
        END AS "ratio"
    FROM cma_calc
    WHERE SUBSTR("mth", 1, 4) = '2017'
),
qualifying_products AS (
    SELECT "product_id"
    FROM ratios
    GROUP BY "product_id"
    HAVING MIN("ratio") > 2
)
SELECT
    q."product_id",
    p."NAME" AS "product_name"
FROM qualifying_products q
LEFT JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
       ON p."ID" = q."product_id"
LIMIT 20;
