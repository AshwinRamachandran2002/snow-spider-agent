```sql
/*-----------------------------------------------------------
  Determine which products maintained a seasonality-adjusted
  (Sales ÷ 12-month centred moving average) ratio > 2 for
  every single month of calendar year 2017.
-----------------------------------------------------------*/
WITH sales AS (   -- enrich raw sales with row number & centred 12-month CMA
    SELECT  "product_id",
            "mth",
            "qty",
            ROW_NUMBER() OVER (PARTITION BY "product_id"
                               ORDER BY "mth")                                             AS "rn",
            AVG("qty") OVER (PARTITION BY "product_id"
                             ORDER BY "mth"
                             ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING)                    AS "cma_12m"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
), ratios AS (     -- compute sales-to-CMA ratio, keep only safe rows inside rn 7-30
    SELECT  "product_id",
            "mth",
            CASE WHEN "cma_12m" = 0 THEN NULL ELSE "qty" / "cma_12m" END                 AS "ratio"
    FROM sales
    WHERE "rn" BETWEEN 7 AND 30
      AND SUBSTR("mth",1,4) = '2017'
), qualified_products AS (   -- products whose ratio > 2 for all 12 months of 2017
    SELECT  "product_id"
    FROM    ratios
    GROUP BY "product_id"
    HAVING  COUNT(*) = 12               -- all 12 months present
       AND  MIN("ratio") > 2            -- lowest monthly ratio still above 2
)
SELECT  p."id"   AS "product_id",
        p."name" AS "product_name"
FROM    qualified_products q
JOIN    ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
      ON p."id" = q."product_id"
ORDER BY p."id";
```
