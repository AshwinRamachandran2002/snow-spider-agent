--Description:  Compute a centred 12-month moving average (CMA) for every product/month,
--derive the Sales-to-CMA ratio for each 2017 month, keep products whose MIN ratio across
--all 2017 months is greater than 2 (i.e. the ratio never fell to 2 or below), and finally
--return those product id’s together with their human-readable names.  
--The PRODUCTS columns are referenced as p."id" and p."name" (lower-case, quoted) because
--previous errors showed that unquoted or upper-case references were not recognised.
WITH cma_calc AS (                         -- 1) centred 12-month moving average
    SELECT
        "product_id",
        "mth",
        "qty",
        AVG("qty") OVER (
            PARTITION BY "product_id"
            ORDER BY  "mth"
            ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING
        ) AS "cma_12m"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
), ratios AS (                             -- 2) 2017 Sales-to-CMA ratios
    SELECT
        "product_id",
        CASE
            WHEN "cma_12m" = 0 THEN NULL
            ELSE "qty" / "cma_12m"
        END AS "ratio"
    FROM cma_calc
    WHERE SUBSTR("mth",1,4) = '2017'
), qualified AS (                          -- 3) products whose MIN 2017 ratio > 2
    SELECT "product_id"
    FROM ratios
    GROUP BY "product_id"
    HAVING MIN("ratio") > 2
)
SELECT
    q."product_id",
    p."name" AS "product_name"
FROM qualified q
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
  ON p."id" = q."product_id"
LIMIT 20;
