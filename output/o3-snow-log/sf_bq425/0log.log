```sql
--Description: Combine the three PRODUCT tables, then pick the most recent approval date per trade name for “SanofiAventis.”  
WITH all_products AS (
      SELECT "trade_name", "approval_date" FROM EBI_CHEMBL.EBI_CHEMBL."PRODUCTS_26" WHERE "applicant_full_name" = 'SanofiAventis'
      UNION ALL
      SELECT "trade_name", "approval_date" FROM EBI_CHEMBL.EBI_CHEMBL."PRODUCTS_29" WHERE "applicant_full_name" = 'SanofiAventis'
      UNION ALL
      SELECT "trade_name", "approval_date" FROM EBI_CHEMBL.EBI_CHEMBL."PRODUCTS_33" WHERE "applicant_full_name" = 'SanofiAventis'
)
SELECT 
       "trade_name",
       MAX("approval_date") AS "latest_approval_date"
FROM   all_products
GROUP  BY "trade_name"
LIMIT 20;
