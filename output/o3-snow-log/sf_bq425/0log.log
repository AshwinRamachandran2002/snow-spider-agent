--Description: Combine the three PRODUCT tables and keep the most recent approval
--date per trade name where the applicant name contains both “sanofi” and “aventis.”
WITH all_products AS (
      SELECT "trade_name", "approval_date"
      FROM EBI_CHEMBL.EBI_CHEMBL."PRODUCTS_26"
      WHERE "applicant_full_name" ILIKE '%sanofi%aventis%'
      UNION ALL
      SELECT "trade_name", "approval_date"
      FROM EBI_CHEMBL.EBI_CHEMBL."PRODUCTS_29"
      WHERE "applicant_full_name" ILIKE '%sanofi%aventis%'
      UNION ALL
      SELECT "trade_name", "approval_date"
      FROM EBI_CHEMBL.EBI_CHEMBL."PRODUCTS_33"
      WHERE "applicant_full_name" ILIKE '%sanofi%aventis%'
)
SELECT
       "trade_name",
       MAX("approval_date") AS "latest_approval_date"
FROM   all_products
GROUP  BY "trade_name"
LIMIT 20
