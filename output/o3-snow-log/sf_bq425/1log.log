```sql
-- Description:  ChEMBL Release 23 – list every distinct trade-name that has
--                an applicant recorded exactly as “SanofiAventis”, keeping
--                only the most recent approval date for each trade-name.

SELECT
        p."trade_name",
        MAX( TO_TIMESTAMP(p."approval_date") ) AS "latest_approval_date"
FROM    EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_23  p               -- ChEMBL release 23
WHERE   p."applicant_full_name" = 'SanofiAventis'           -- exact match
GROUP BY
        p."trade_name"
ORDER BY
        p."trade_name";
```
