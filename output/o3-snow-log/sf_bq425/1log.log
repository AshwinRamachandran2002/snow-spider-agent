```sql
WITH union_products AS (
    SELECT "trade_name",
           "approval_date",
           "applicant_full_name"
    FROM   EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_26
    UNION ALL
    SELECT "trade_name",
           "approval_date",
           "applicant_full_name"
    FROM   EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_29
    UNION ALL
    SELECT "trade_name",
           "approval_date",
           "applicant_full_name"
    FROM   EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_33
)
SELECT
       up."trade_name",
       MAX(TO_TIMESTAMP(up."approval_date")) AS "latest_approval_date"
FROM   union_products up
WHERE  REGEXP_REPLACE(UPPER(up."applicant_full_name"), '[^A-Z]', '') = 'SANOFIAVENTIS'
GROUP BY
       up."trade_name"
ORDER BY
       up."trade_name";
```
