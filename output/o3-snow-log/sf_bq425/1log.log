Query:
--Description: List distinct applicant names in PRODUCTS_29 that contain both “sanofi” and “aventis,” helping identify the exact spelling variants present.
SELECT DISTINCT
       "applicant_full_name"
FROM   EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_29
WHERE  "applicant_full_name" ILIKE '%sanofi%aventis%'
LIMIT 20
