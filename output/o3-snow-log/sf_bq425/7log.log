Query:
--Description: For Sanofi Aventis applicants, show each trade name with its most recent approval date
SELECT 
    "trade_name",
    MAX("approval_date") AS "latest_approval_date"
FROM (
        SELECT * FROM EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_26
        UNION ALL
        SELECT * FROM EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_29
        UNION ALL
        SELECT * FROM EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_33
     )
WHERE 
    "applicant_full_name" ILIKE '%sanofi%aventis%'
GROUP BY 
    "trade_name"
ORDER BY 
    "latest_approval_date" DESC
LIMIT 20
