```sql
-- Description: From ChEMBL Release 23, list each distinct molecule (trade name) filed by the
-- company exactly named “SanofiAventis”, keeping only the most recent approval date.
SELECT
    "trade_name"                                            AS "molecule",
    MAX(TO_TIMESTAMP("approval_date"))                      AS "latest_approval_date"
FROM
    EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_23
WHERE
    "applicant_full_name" = 'SanofiAventis'                 -- exact match
GROUP BY
    "trade_name"
ORDER BY
    "latest_approval_date" DESC NULLS LAST;
