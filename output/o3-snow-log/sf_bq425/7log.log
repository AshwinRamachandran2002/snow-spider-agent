--Description: Combine PRODUCTS_26, _29, and _33 and list rows where the applicant name includes both “sanofi” and “aventis”
SELECT 
    "trade_name",
    "approval_date",
    "applicant_full_name"
FROM (
        SELECT * FROM EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_26
        UNION ALL
        SELECT * FROM EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_29
        UNION ALL
        SELECT * FROM EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_33
     )
