Query:
--Description / Correction:
-- Replace the exact-match filter with a flexible, case-insensitive pattern that captures
-- all “Sanofi-Aventis” name variants; then return the latest approval date per trade name
-- from PRODUCTS_29 (limit 20 for inspection).
SELECT
    "trade_name",
    MAX("approval_date") AS "latest_approval_date"
FROM EBI_CHEMBL.EBI_CHEMBL."PRODUCTS_29"
WHERE "applicant_full_name" ILIKE '%sanofi%aventis%'
GROUP BY "trade_name"
ORDER BY "trade_name"
LIMIT 20
