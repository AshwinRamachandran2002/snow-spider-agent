Query:
--Description / Correction:
-- Union the three product tables, filter on applicant names that contain both “Sanofi” and
-- “Aventis” (any case or separator), and keep only the most recent approval date for each
-- trade name across all tables (limit 20 for inspection).
SELECT
    "trade_name",
    MAX("approval_date") AS "latest_approval_date"
FROM (
    SELECT "trade_name", "approval_date"
    FROM EBI_CHEMBL.EBI_CHEMBL."PRODUCTS_26"
    WHERE "applicant_full_name" ILIKE '%sanofi%aventis%'

    UNION ALL

    SELECT "trade_name", "approval_date"
    FROM EBI_CHEMBL.EBI_CHEMBL."PRODUCTS_29"
    WHERE "applicant_full_name" ILIKE '%sanofi%aventis%'

    UNION ALL

    SELECT "trade_name", "approval_date"
    FROM EBI_CHEMBL.EBI_CHEMBL."PRODUCTS_33"
    WHERE "applicant_full_name" ILIKE '%sanofi%aventis%'
) AS unioned_products
GROUP BY "trade_name"
ORDER BY "trade_name"
LIMIT 20
