```sql
--Description / Thinking Process:
-- • Goal: list distinct trade names (molecules) linked to “Sanofi-Aventis” in ChEMBL 23,
--   showing only the most recent approval date for each.
-- • The company appears in different textual forms (e.g. “SANOFI AVENTIS US LLC”,
--   “SANOFI-AVENTIS US LLC”), so use ILIKE '%sanofi%aventis%' to match any of them.
-- • ChEMBL 23 distributes product data across three tables (PRODUCTS_26, PRODUCTS_29, PRODUCTS_33);
--   therefore UNION ALL the three sources first.
-- • Aggregate with MAX(approval_date) to keep the latest entry per trade_name.
-- • Return an alphabetically ordered list, limited to 20 rows for inspection.
SELECT
    "trade_name",
    MAX("approval_date") AS "latest_approval_date"
FROM (
    SELECT "trade_name", "approval_date"
    FROM EBI_CHEMBL.EBI_CHEMBL."PRODUCTS_26"
    WHERE "applicant_full_name" ILIKE '%sanofi%aventis%'

    UNION ALL

    SELECT "trade_name", "approval_date"
    FROM EBI_CHEMBL.EBI_CHEMBL."PRODUCTS_29"
    WHERE "applicant_full_name" ILIKE '%sanofi%aventis%'

    UNION ALL

    SELECT "trade_name", "approval_date"
    FROM EBI_CHEMBL.EBI_CHEMBL."PRODUCTS_33"
    WHERE "applicant_full_name" ILIKE '%sanofi%aventis%'
) AS merged_products
GROUP BY "trade_name"
ORDER BY "trade_name"
LIMIT 20;
```
