-- Description: Combine distinct molecules across the three PRODUCTS tables for every Sanofi-Aventis variant,
-- keeping the most recent approval_date from each table
SELECT *
FROM (
      SELECT "trade_name",
             MAX("approval_date") AS "latest_approval_date"
      FROM "EBI_CHEMBL"."EBI_CHEMBL"."PRODUCTS_26"
      WHERE "applicant_full_name" ILIKE '%sanofi%aventis%'
      GROUP BY "trade_name"
      UNION
      SELECT "trade_name",
             MAX("approval_date") AS "latest_approval_date"
      FROM "EBI_CHEMBL"."EBI_CHEMBL"."PRODUCTS_29"
      WHERE "applicant_full_name" ILIKE '%sanofi%aventis%'
      GROUP BY "trade_name"
      UNION
      SELECT "trade_name",
             MAX("approval_date") AS "latest_approval_date"
      FROM "EBI_CHEMBL"."EBI_CHEMBL"."PRODUCTS_33"
      WHERE "applicant_full_name" ILIKE '%sanofi%aventis%'
      GROUP BY "trade_name"
) AS combined
ORDER BY "trade_name"
LIMIT 20
