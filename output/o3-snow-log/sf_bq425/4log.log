Query:
--Description: Final answer query – distinct molecules with their latest approval date for applicants containing both “sanofi” and “aventis”
SELECT DISTINCT
       t."trade_name" AS "molecule_trade_name",
       MAX(t."approval_date") OVER (PARTITION BY t."trade_name") AS "latest_approval_date"
FROM   EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_23 t
WHERE  LOWER(t."applicant_full_name") LIKE '%sanofi%'
  AND  LOWER(t."applicant_full_name") LIKE '%aventis%'
QUALIFY ROW_NUMBER() OVER (PARTITION BY t."trade_name" ORDER BY t."approval_date" DESC) = 1
LIMIT 20
