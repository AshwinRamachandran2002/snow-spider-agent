WHERE  "applicant_full_name" = 'SanofiAventis'
LIMIT  20;
```

```sql
--Description: List every distinct trade name tied to “SanofiAventis”
SELECT DISTINCT "trade_name"
FROM   EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_23
WHERE  "applicant_full_name" = 'SanofiAventis'
LIMIT  20;
```

```sql
--Description: See the full set of approval dates for each SanofiAventis product
SELECT "trade_name",
       "approval_date"
FROM   EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_23
WHERE  "applicant_full_name" = 'SanofiAventis'
ORDER BY "trade_name", "approval_date" DESC
LIMIT  20;
```

```sql
--Description: Find the most recent approval date for each trade name (GROUP BY + MAX)
SELECT "trade_name",
       MAX("approval_date") AS "latest_approval_date"
FROM   EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_23
WHERE  "applicant_full_name" = 'SanofiAventis'
GROUP  BY "trade_name"
LIMIT  20;
```

```sql
--Description: Same as above but return distinct rows via QUALIFY & window function
SELECT "trade_name",
       "approval_date"
FROM   EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_23
WHERE  "applicant_full_name" = 'SanofiAventis'
QUALIFY ROW_NUMBER() OVER (PARTITION BY "trade_name" ORDER BY "approval_date" DESC) = 1
LIMIT  20;
```

```sql
--Description: Show both the latest approval and count of how many approvals per product
SELECT "trade_name",
       MAX("approval_date") AS "latest_approval_date",
       COUNT(*)             AS "num_approvals"
FROM   EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_23
WHERE  "applicant_full_name" = 'SanofiAventis'
GROUP  BY "trade_name"
ORDER  BY "latest_approval_date" DESC
LIMIT  20;
```

```sql
--Description: Full answer query – distinct molecules with their latest approval date
SELECT DISTINCT
       t."trade_name"                     AS "molecule_trade_name",
       MAX(t."approval_date") OVER (PARTITION BY t."trade_name") AS "latest_approval_date"
FROM   EBI_CHEMBL.EBI_CHEMBL.PRODUCTS_23 t
WHERE  t."applicant_full_name" = 'SanofiAventis'
QUALIFY ROW_NUMBER() OVER (PARTITION BY t."trade_name" ORDER BY t."approval_date" DESC) = 1
LIMIT  20;
```
