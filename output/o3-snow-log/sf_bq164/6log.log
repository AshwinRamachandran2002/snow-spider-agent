Query:
--Description: Search scRNA-seq Level-2 metadata files whose “Filename” contains the run-ID fragment “HT264P1”.
SELECT DISTINCT 
       t."Filename",
       t."HTAN_Parent_Data_File_ID"  AS "HTAN Parent Biospecimen/Data File ID",
       t."Component",
       t."File_Format",
       t."entityId"                 AS "Entity ID",
       'HT264P1-S1H2Fc2U1Z1Bs1-H2Bs2-Test' AS "Run ID"
FROM   HTAN_2.HTAN."SCRNASEQ_LEVEL2_METADATA_CURRENT" t
WHERE  t."Filename" ILIKE '%HT264P1%'
LIMIT  20;
