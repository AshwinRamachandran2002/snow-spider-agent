```sql
--Description:  “HTAN_Parent_Biospecimen_ID” often stores a comma-separated list of IDs, so a direct
--ILIKE on the whole field may fail if our target substring is embedded within a longer string.
--We therefore SPLIT the column on commas, FLATTEN it, trim whitespace, and search each individual
--ID for the prefix “HTA12_27”.  This one-step query should surface accessory-manifest rows whose
--parent biospecimen list includes any of the run-related IDs.

SELECT DISTINCT
       t."entityId"                                 AS "Entity ID",
       t."Component",
       t."HTAN_Parent_Biospecimen_ID"               AS "HTAN Parent Biospecimen/Data File ID",
       NULL                                         AS "Filename",
       NULL                                         AS "File_Format",
       'HT264P1-S1H2Fc2U1Z1Bs1-H2Bs2-Test'          AS "Run ID"
FROM   HTAN_2.HTAN."ACCESSORY_MANIFEST_CURRENT" t,
       LATERAL FLATTEN(input => SPLIT(t."HTAN_Parent_Biospecimen_ID", ',')) f
WHERE  TRIM(f.VALUE::STRING) ILIKE 'HTA12_27%'
LIMIT  20;
```
