--patterns; this will inform subsequent filtering for the desired run.

SELECT DISTINCT
       t."Source_filename"            AS "Filename",
       t."HTAN_Biospecimen_ID"        AS "HTAN Parent Biospecimen/Data File ID",
       'ImagingLevel4'                AS "Component",
       NULL                           AS "File_Format",
       t."Source_entityId"            AS "Entity ID",
       'HT264P1-S1H2Fc2U1Z1Bs1-H2Bs2-Test' AS "Run ID"
FROM   HTAN_2.HTAN."IMAGING_LEVEL4_DUKE_MIBI_CURRENT" t
LIMIT  20
