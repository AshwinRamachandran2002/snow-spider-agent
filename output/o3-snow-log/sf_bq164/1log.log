Query:
--Description: 2) scRNA-seq Level 4 metadata — broaden search to the core fragment “HT264” in either
--             the file name or the parent-data-file list.
SELECT DISTINCT
       "Filename",
       "HTAN_Parent_Data_File_ID"        AS "HTAN_Parent_Biospecimen_ID",
       "Component",
       "File_Format",
       "entityId",
       'HT264P1-S1H2Fc2U1Z1Bs1-H2Bs2-Test' AS "Run_ID"
FROM   HTAN_2.HTAN.SCRNASEQ_LEVEL4_METADATA_CURRENT
WHERE  "Filename"                ILIKE '%HT264%'
   OR  "HTAN_Parent_Data_File_ID" ILIKE '%HT264%'
LIMIT  20
