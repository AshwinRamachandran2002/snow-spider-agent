sessions_raw AS (   
    SELECT "EVENT_DATE", "USER_PSEUDO_ID", "EVENT_PARAMS"   
    FROM all_december_events   
    WHERE "EVENT_NAME" = 'session_start'   
),   

sessions_enriched AS (   
    SELECT    
        sr."EVENT_DATE",    
        sr."USER_PSEUDO_ID",    
        MAX(CASE WHEN ep.value:"key"::STRING = 'medium'   THEN COALESCE(ep.value:"value":"string_value"::STRING,
                                                                       ep.value:"value":"int_value"::STRING) END) AS medium,    
        MAX(CASE WHEN ep.value:"key"::STRING = 'source'   THEN COALESCE(ep.value:"value":"string_value"::STRING,
                                                                       ep.value:"value":"int_value"::STRING) END) AS source,    
        MAX(CASE WHEN ep.value:"key"::STRING = 'campaign' THEN COALESCE(ep.value:"value":"string_value"::STRING,
                                                                       ep.value:"value":"int_value"::STRING) END) AS campaign   
    FROM sessions_raw sr, LATERAL FLATTEN(INPUT => sr."EVENT_PARAMS") ep   
    GROUP BY sr."EVENT_DATE", sr."USER_PSEUDO_ID"   
),   

channelled_sessions AS (   
    SELECT    
        CASE    
            WHEN LOWER(source) = '(direct)' AND (medium IS NULL OR medium IN ('', '(not set)', '(none)'))          THEN 'Direct'    
            WHEN campaign ILIKE '%cross-network%'                                                                  THEN 'Cross-network'    
            WHEN ((source  RLIKE '(alibaba|amazon|google shopping|shopify|etsy|ebay|stripe|walmart)' 
                   OR campaign RLIKE '(^.*(([^a-df-z]|^)shop|shopping).*)') )
                  AND medium  RLIKE '(.*cp.*|ppc|retargeting|paid.*)'                                              THEN 'Paid Shopping'    
            WHEN source RLIKE '(baidu|bing|duckduckgo|ecosia|google|yahoo|yandex)'
                 AND medium RLIKE '(.*cp.*|ppc|paid.*)'                                                             THEN 'Paid Search'    
            WHEN source RLIKE '(badoo|facebook|fb|instagram|linkedin|pinterest|tiktok|twitter|whatsapp)' 
                 AND medium RLIKE '(.*cp.*|ppc|retargeting|paid.*)'                                                 THEN 'Paid Social'    
            WHEN source RLIKE '(dailymotion|disneyplus|netflix|youtube|vimeo|twitch)' 
                 AND medium RLIKE '(.*cp.*|ppc|retargeting|paid.*)'                                                 THEN 'Paid Video'    
            WHEN medium IN ('display','banner','expandable','interstitial','cpm')                                   THEN 'Display'    
            WHEN (source ILIKE 'email' OR medium IN ('email','e-mail','e_mail','e mail'))                           THEN 'Email'    
            WHEN medium = 'affiliate'                                                                              THEN 'Affiliates'    
            WHEN medium = 'audio'                                                                                  THEN 'Audio'    
            WHEN source = 'sms' OR medium = 'sms'                                                                  THEN 'SMS'    
            WHEN RIGHT(medium,4) = 'push' OR medium ILIKE '%mobile%' OR medium ILIKE '%notification%'              THEN 'Mobile Push Notifications'    
            WHEN ((source  RLIKE '(alibaba|amazon|google shopping|shopify|etsy|ebay|stripe|walmart)' 
                   OR campaign RLIKE '(^.*(([^a-df-z]|^)shop|shopping).*)'))                                        THEN 'Organic Shopping'    
            WHEN (source RLIKE '(badoo|facebook|fb|instagram|linkedin|pinterest|tiktok|twitter|whatsapp)' 
                   OR medium IN ('social','social-network','social-media','sm','social network','social media'))    THEN 'Organic Social'    
            WHEN (source RLIKE '(dailymotion|disneyplus|netflix|youtube|vimeo|twitch)' 
                   OR medium RLIKE '(.*video.*)')                                                                  THEN 'Organic Video'    
            WHEN (source RLIKE '(baidu|bing|duckduckgo|ecosia|google|yahoo|yandex)' 
                   OR medium = 'organic')                                                                         THEN 'Organic Search'    
            WHEN medium = 'referral'                                                                               THEN 'Referral'    
            ELSE 'Unassigned'    
        END AS channel   
    FROM sessions_enriched   
),   

ranked_channels AS (   
    SELECT channel, COUNT(*) AS sessions,   
           RANK() OVER (ORDER BY COUNT(*) DESC) AS channel_rank   
    FROM channelled_sessions   
    GROUP BY channel   
)   

SELECT channel, sessions   
FROM ranked_channels   
WHERE channel_rank = 4   
ORDER BY sessions DESC NULLS LAST;
