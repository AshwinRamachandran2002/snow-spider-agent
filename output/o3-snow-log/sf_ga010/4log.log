    SELECT "USER_PSEUDO_ID", "EVENT_PARAMS"
    FROM   all_december_events
    WHERE  "EVENT_NAME" = 'session_start'
),

/* pull ga_session_id, source, medium, campaign from params */
sessions_enriched AS (
    SELECT
        sr."USER_PSEUDO_ID",
        MAX(CASE WHEN ep.value:"key"::STRING = 'ga_session_id'
                 THEN ep.value:"value":"int_value"::STRING END)                                     AS GA_SESSION_ID,
        MAX(CASE WHEN ep.value:"key"::STRING = 'source'
                 THEN COALESCE(ep.value:"value":"string_value"::STRING,
                               ep.value:"value":"int_value"::STRING) END)                           AS SRC,
        MAX(CASE WHEN ep.value:"key"::STRING = 'medium'
                 THEN COALESCE(ep.value:"value":"string_value"::STRING,
                               ep.value:"value":"int_value"::STRING) END)                           AS MED,
        MAX(CASE WHEN ep.value:"key"::STRING = 'campaign'
                 THEN COALESCE(ep.value:"value":"string_value"::STRING,
                               ep.value:"value":"int_value"::STRING) END)                           AS CMP
    FROM sessions_raw sr,
         LATERAL FLATTEN(INPUT => sr."EVENT_PARAMS") ep
    GROUP BY sr."USER_PSEUDO_ID"
),

/* one row per (user , session) */
deduped_sessions AS (
    SELECT DISTINCT "USER_PSEUDO_ID",
           GA_SESSION_ID,
           SRC,
           MED,
           CMP
    FROM   sessions_enriched
),

/* map to channel group (regex simplified & case-insensitive via LOWER) */
channelled_sessions AS (
    SELECT
        CASE
            WHEN LOWER(COALESCE(SRC,'')) = '(direct)'
                 AND (MED IS NULL OR LOWER(MED) IN ('', '(not set)', '(none)'))                      THEN 'Direct'

            WHEN CMP ILIKE '%cross-network%'                                                        THEN 'Cross-network'

            WHEN (REGEXP_LIKE(LOWER(COALESCE(SRC,'')),
                              '(alibaba|amazon|google shopping|shopify|etsy|ebay|stripe|walmart)')
                  OR REGEXP_LIKE(LOWER(COALESCE(CMP,'')),
                                  '(shop|shopping)'))
                 AND REGEXP_LIKE(LOWER(COALESCE(MED,'')),
                                  '(cp|ppc|retargeting|paid)')                                       THEN 'Paid Shopping'

            WHEN REGEXP_LIKE(LOWER(COALESCE(SRC,'')),
                              '(baidu|bing|duckduckgo|ecosia|google|yahoo|yandex)')
                 AND REGEXP_LIKE(LOWER(COALESCE(MED,'')),
                                  '(cp|ppc|paid)')                                                   THEN 'Paid Search'

            WHEN REGEXP_LIKE(LOWER(COALESCE(SRC,'')),
                              '(badoo|facebook|fb|instagram|linkedin|pinterest|tiktok|twitter|whatsapp)')
                 AND REGEXP_LIKE(LOWER(COALESCE(MED,'')),
                                  '(cp|ppc|retargeting|paid)')                                       THEN 'Paid Social'

            WHEN REGEXP_LIKE(LOWER(COALESCE(SRC,'')),
                              '(dailymotion|disneyplus|netflix|youtube|vimeo|twitch)')
                 AND REGEXP_LIKE(LOWER(COALESCE(MED,'')),
                                  '(cp|ppc|retargeting|paid)')                                       THEN 'Paid Video'

            WHEN LOWER(MED) IN ('display','banner','expandable','interstitial','cpm')                THEN 'Display'

            WHEN LOWER(COALESCE(SRC,'')) IN ('email','e-mail','e_mail','e mail')
                 OR LOWER(MED) IN ('email','e-mail','e_mail','e mail')                               THEN 'Email'

            WHEN LOWER(MED) = 'affiliate'                                                           THEN 'Affiliates'
            WHEN LOWER(MED) = 'audio'                                                               THEN 'Audio'
            WHEN LOWER(COALESCE(SRC,'')) = 'sms' OR LOWER(MED) = 'sms'                              THEN 'SMS'

            WHEN RIGHT(LOWER(COALESCE(MED,'')),4) = 'push'
                 OR LOWER(MED) LIKE '%mobile%'
                 OR LOWER(MED) LIKE '%notification%'                                                THEN 'Mobile Push Notifications'

            WHEN (REGEXP_LIKE(LOWER(COALESCE(SRC,'')),
                              '(alibaba|amazon|google shopping|shopify|etsy|ebay|stripe|walmart)')
                  OR REGEXP_LIKE(LOWER(COALESCE(CMP,'')),
                                  '(shop|shopping)'))                                               THEN 'Organic Shopping'

            WHEN REGEXP_LIKE(LOWER(COALESCE(SRC,'')),
                              '(badoo|facebook|fb|instagram|linkedin|pinterest|tiktok|twitter|whatsapp)')
                 OR LOWER(MED) IN ('social','social-network','social-media','sm',
                                   'social network','social media')                                 THEN 'Organic Social'

            WHEN REGEXP_LIKE(LOWER(COALESCE(SRC,'')),
                              '(dailymotion|disneyplus|netflix|youtube|vimeo|twitch)')
                 OR REGEXP_LIKE(LOWER(COALESCE(MED,'')), 'video')                                    THEN 'Organic Video'

            WHEN REGEXP_LIKE(LOWER(COALESCE(SRC,'')),
                              '(baidu|bing|duckduckgo|ecosia|google|yahoo|yandex)')
                 OR LOWER(MED) = 'organic'                                                          THEN 'Organic Search'

            WHEN LOWER(MED) = 'referral'                                                            THEN 'Referral'
            ELSE 'Unassigned'
        END AS CHANNEL
    FROM deduped_sessions
),

/* count & rank channels */
ranked_channels AS (
    SELECT CHANNEL,
           COUNT(*) AS SESSIONS,
           ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS RN
    FROM   channelled_sessions
    GROUP BY CHANNEL
)

SELECT CHANNEL,
       SESSIONS
FROM   ranked_channels
WHERE  RN = 4;
```
