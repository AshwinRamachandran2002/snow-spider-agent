```sql
--Description: Count how many distinct persons are linked to each crash (state + case number) where at least two people were involved
SELECT p."state_number",
       p."consecutive_number",
       COUNT(*) AS "persons_in_accident"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016 p
GROUP BY p."state_number", p."consecutive_number"
HAVING COUNT(*) > 1
LIMIT 20;
```

```sql
--Description: Compute the average absolute speed-difference per crash (only valid numeric speeds) to gauge how the engineered feature looks
SELECT a."state_number",
       v."consecutive_number",
       AVG(ABS(v."travel_speed" - v."speed_limit")) AS "avg_speed_diff"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016 v
JOIN NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2016 a
  ON a."state_number"      = v."state_number"
 AND a."consecutive_number" = v."consecutive_number"
WHERE v."travel_speed" < 997
  AND v."speed_limit"  < 98
GROUP BY a."state_number", v."consecutive_number"
LIMIT 20;
```
