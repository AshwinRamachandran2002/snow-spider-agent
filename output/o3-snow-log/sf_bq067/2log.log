```sql
-- Description: Find the distinct vehicle body-type codes stored for 2016 vehicles
SELECT DISTINCT "body_type"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
LIMIT 20;
```

```sql
-- Description: Preview raw travel-speed and speed-limit pairs after excluding the special 997/998/999 & 98/99 codes
SELECT "consecutive_number",
       "travel_speed",
       "speed_limit"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
WHERE "travel_speed" < 997  -- 997,998,999 are special/unknown codes
  AND "speed_limit"  < 98   -- 98,99 are special/unknown codes
LIMIT 20;
```

```sql
-- Description: Compute the average absolute speed difference per crash (clean speeds only)
SELECT "consecutive_number",
       AVG(ABS("travel_speed" - "speed_limit")) AS "avg_speed_diff"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
WHERE "travel_speed" < 997
  AND "speed_limit"  < 98
GROUP BY "consecutive_number"
LIMIT 20;
```

```sql
-- Description: View the injury-severity codes that occur in the person table
SELECT DISTINCT "injury_severity"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016
LIMIT 20;
```

```sql
-- Description: List crashes that involve more than one distinct person
SELECT "consecutive_number",
       COUNT(*) AS "person_count"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016
GROUP BY "consecutive_number"
HAVING COUNT(*) > 1
LIMIT 20;
```

```sql
-- Description: Count how many fatally injured (severity = 4) persons appear in each crash
SELECT "consecutive_number",
       SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "fatal_persons"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016
GROUP BY "consecutive_number"
HAVING SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) > 0
LIMIT 20;
```

```sql
-- Description: Assemble all engineered predictors plus the binary label for a sample of 20 multi-person crashes
WITH veh AS (
    SELECT "consecutive_number",
           MIN("body_type") AS "body_type",
           CASE
               WHEN AVG(ABS("travel_speed" - "speed_limit")) < 20 THEN 0
               WHEN AVG(ABS("travel_speed" - "speed_limit")) < 40 THEN 1
               WHEN AVG(ABS("travel_speed" - "speed_limit")) < 60 THEN 2
               WHEN AVG(ABS("travel_speed" - "speed_limit")) < 80 THEN 3
               ELSE 4
           END AS "speed_diff_level"
    FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
    WHERE "travel_speed" < 997
      AND "speed_limit"  < 98
    GROUP BY "consecutive_number"
),
prs AS (
    SELECT "consecutive_number",
           COUNT(*) AS "person_count",
           SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "fatal_persons"
    FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016
    GROUP BY "consecutive_number"
),
lab AS (
    SELECT "consecutive_number",
           IFF("fatal_persons" > 1, 1, 0) AS "label"
    FROM prs
)
SELECT a."consecutive_number",
       a."state_number",
       v."body_type",
       a."number_of_drunk_drivers",
       a."day_of_week",
       a."hour_of_crash",
       IFF(a."work_zone" <> 'None', 1, 0) AS "work_zone_flag",
       v."speed_diff_level",
       l."label"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2016 a
JOIN prs  p ON a."consecutive_number" = p."consecutive_number" AND p."person_count" > 1
JOIN lab  l ON a."consecutive_number" = l."consecutive_number"
JOIN veh  v ON a."consecutive_number" = v."consecutive_number"
LIMIT 20;
```

```sql
-- Description: Quick sense-check of the final label distribution in the engineered sample
SELECT "label",
       COUNT(*) AS "num_accidents"
FROM (
    /* reuse the previous CTEs to derive label quickly */
    WITH prs AS (
        SELECT "consecutive_number",
               COUNT(*) AS "person_count",
               SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "fatal_persons"
        FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016
        GROUP BY "consecutive_number"
    )
    SELECT "consecutive_number",
           IFF("fatal_persons" > 1, 1, 0) AS "label"
    FROM prs
    WHERE "person_count" > 1
)
GROUP BY "label"
LIMIT 20;
```
