Query:
-- Description: Quick sense-check of the final label distribution in the engineered sample
SELECT "label",
       COUNT(*) AS "num_accidents"
FROM (
    /* reuse the previous CTEs to derive label quickly */
    WITH prs AS (
        SELECT "consecutive_number",
               COUNT(*) AS "person_count",
               SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "fatal_persons"
        FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016
        GROUP BY "consecutive_number"
    )
    SELECT "consecutive_number",
           IFF("fatal_persons" > 1, 1, 0) AS "label"
    FROM prs
    WHERE "person_count" > 1
)
GROUP BY "label"
LIMIT 20;
