Query:
-- Description: Assemble all engineered predictors plus the binary label for a sample of 20 multi-person crashes
WITH veh AS (
    SELECT "consecutive_number",
           MIN("body_type") AS "body_type",
           CASE
               WHEN AVG(ABS("travel_speed" - "speed_limit")) < 20 THEN 0
               WHEN AVG(ABS("travel_speed" - "speed_limit")) < 40 THEN 1
               WHEN AVG(ABS("travel_speed" - "speed_limit")) < 60 THEN 2
               WHEN AVG(ABS("travel_speed" - "speed_limit")) < 80 THEN 3
               ELSE 4
           END AS "speed_diff_level"
    FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
    WHERE "travel_speed" < 997
      AND "speed_limit"  < 98
    GROUP BY "consecutive_number"
),
prs AS (
    SELECT "consecutive_number",
           COUNT(*) AS "person_count",
           SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "fatal_persons"
    FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016
    GROUP BY "consecutive_number"
),
lab AS (
    SELECT "consecutive_number",
           IFF("fatal_persons" > 1, 1, 0) AS "label"
    FROM prs
)
SELECT a."consecutive_number",
       a."state_number",
       v."body_type",
       a."number_of_drunk_drivers",
       a."day_of_week",
       a."hour_of_crash",
       IFF(a."work_zone" <> 'None', 1, 0) AS "work_zone_flag",
       v."speed_diff_level",
       l."label"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2016 a
JOIN prs  p ON a."consecutive_number" = p."consecutive_number" AND p."person_count" > 1
JOIN lab  l ON a."consecutive_number" = l."consecutive_number"
JOIN veh  v ON a."consecutive_number" = v."consecutive_number"
LIMIT 20;
