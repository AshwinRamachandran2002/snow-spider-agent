--Description: 1)  Inspect key crash–level fields we will need from the accident table, including its primary-key columns.
SELECT 
  "state_number",
  "consecutive_number",
  "number_of_fatalities",
  "number_of_drunk_drivers",
  "day_of_week",
  "hour_of_crash",
  "work_zone"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2016
LIMIT 20;
```

```sql
--Description: 2)  Verify that vehicle rows can be linked to crashes and explore whether “body_type” is present.
SELECT DISTINCT
  "state_number",
  "consecutive_number",
  "vehicle_number",
  "body_type"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
LIMIT 20;
```

```sql
--Description: 3)  Peek at speed-related columns so we know how travel speed and speed limit are coded.
SELECT 
  "state_number",
  "consecutive_number",
  "vehicle_number",
  "travel_speed",
  "speed_limit"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
LIMIT 20;
```

```sql
--Description: 4)  Look at some records after excluding the special codes for speed to confirm feasible values.
SELECT 
  "state_number",
  "consecutive_number",
  "vehicle_number",
  "travel_speed",
  "speed_limit"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
WHERE "travel_speed" BETWEEN 0 AND 151
  AND "speed_limit" BETWEEN 0 AND 80
LIMIT 20;
```

```sql
--Description: 5)  Explore person-level data to find the injury severity column for labelling; check a few rows.
SELECT 
  "state_number",
  "consecutive_number",
  "person_number",
  "injury_severity"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016
LIMIT 20;
```

```sql
--Description: 6)  Count how many distinct persons are recorded per accident to spot multi-person crashes.
SELECT 
  "state_number",
  "consecutive_number",
  COUNT(DISTINCT "person_number") AS "num_persons"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016
GROUP BY 
  "state_number",
  "consecutive_number"
HAVING COUNT(DISTINCT "person_number") > 1
LIMIT 20;
```

```sql
--Description: 7)  Identify accidents with more than one fatal-injury person (injury_severity = 4) for our label.
SELECT 
  p."state_number",
  p."consecutive_number",
  COUNT(*) AS "fatal_person_count"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016 p
WHERE p."injury_severity" = 4
GROUP BY 
  p."state_number",
  p."consecutive_number"
HAVING COUNT(*) > 1
LIMIT 20;
```

```sql
--Description: 8)  Sample the work-zone text values to confirm what should be mapped to the indicator.
SELECT DISTINCT
  "work_zone"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2016
LIMIT 20;
```

```sql
--Description: 9)  Compute the average |speed–limit| per accident (after exclusions) to check range before binning.
SELECT 
  v."state_number",
  v."consecutive_number",
  AVG(ABS(v."travel_speed" - v."speed_limit")) AS "avg_speed_diff"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016 v
WHERE v."travel_speed" BETWEEN 0 AND 151
  AND v."speed_limit" BETWEEN 0 AND 80
GROUP BY 
  v."state_number",
  v."consecutive_number"
LIMIT 20;
```

```sql
--Description: 10)  Put everything together for a quick sanity-check mini-dataset (no filtering yet).
SELECT
  a."state_number",
  a."consecutive_number",
  a."number_of_drunk_drivers",
  a."day_of_week",
  a."hour_of_crash",
  a."work_zone",
  v."body_type",
  p."person_number",
  p."injury_severity",
  v."travel_speed",
  v."speed_limit"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2016 a
JOIN NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016 v
  ON v."state_number" = a."state_number"
 AND v."consecutive_number" = a."consecutive_number"
JOIN NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016 p
  ON p."state_number" = a."state_number"
 AND p."consecutive_number" = a."consecutive_number"
LIMIT 20;
```
