```sql
--Description: Explore the set of possible injury–severity codes that appear in the 2016 PERSON table  
SELECT DISTINCT "injury_severity"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016
LIMIT 20;
```

```sql
--Description: Look at a small sample of fatally-injured people (severity = 4) to verify coding and basic crash attributes  
SELECT "state_number",
       "hour_of_crash",
       "day_of_crash",
       "injury_severity",
       "vehicle_make_name"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016
WHERE "injury_severity" = 4
LIMIT 20;
```

```sql
--Description: Find accidents (state + consecutive number) that involve more than one distinct person  
SELECT p."state_number",
       p."consecutive_number",
       COUNT(DISTINCT p."person_number") AS "person_count"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016 p
GROUP BY p."state_number", p."consecutive_number"
HAVING COUNT(DISTINCT p."person_number") > 1
LIMIT 20;
```

```sql
--Description: Join those multi-person accidents to ACCIDENT_2016 to inspect key predictor columns  
SELECT a."state_number",
       a."consecutive_number",
       a."number_of_drunk_drivers",
       a."day_of_week",
       a."hour_of_crash",
       a."work_zone"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2016   a
JOIN (
      SELECT p."state_number", p."consecutive_number"
      FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016 p
      GROUP  BY p."state_number", p."consecutive_number"
      HAVING COUNT(*) > 1
     ) pc
  ON a."state_number"     = pc."state_number"
 AND a."consecutive_number"= pc."consecutive_number"
LIMIT 20;
```

```sql
--Description: See the set of coded values for the work-zone indicator in ACCIDENT_2016  
SELECT DISTINCT "work_zone"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2016
LIMIT 20;
```

```sql
--Description: Take a quick look at vehicle-level body-type, speed, and limit values for 2016 crashes  
SELECT "state_number",
       "consecutive_number",
       "vehicle_number",
       "body_type",
       "travel_speed",
       "speed_limit"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
LIMIT 20;
```

```sql
--Description: Compute per-vehicle absolute speed-difference (only for valid speed & limit values)  
SELECT "state_number",
       "consecutive_number",
       "vehicle_number",
       ABS("travel_speed" - "speed_limit") AS "speed_diff"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
WHERE "travel_speed" <= 151             -- remove 997/998/999 codes
  AND "speed_limit"  <= 80              -- remove 98/99 codes
LIMIT 20;
```

```sql
--Description: Average the valid speed-difference per accident (state + consecutive number)  
SELECT   "state_number",
         "consecutive_number",
         AVG(ABS("travel_speed" - "speed_limit")) AS "avg_speed_diff"
FROM     NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
WHERE    "travel_speed" <= 151
  AND    "speed_limit"  <= 80
GROUP BY "state_number","consecutive_number"
LIMIT 20;
```

```sql
--Description: Convert the per-accident average speed-difference into 0-to-4 bins (20-mph width)  
SELECT   "state_number",
         "consecutive_number",
         CASE
             WHEN "avg_speed_diff" < 20  THEN 0
             WHEN "avg_speed_diff" < 40  THEN 1
             WHEN "avg_speed_diff" < 60  THEN 2
             WHEN "avg_speed_diff" < 80  THEN 3
             ELSE 4
         END AS "speed_diff_level"
FROM (
      SELECT   "state_number",
               "consecutive_number",
               AVG(ABS("travel_speed" - "speed_limit")) AS "avg_speed_diff"
      FROM     NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
      WHERE    "travel_speed" <= 151
        AND    "speed_limit"  <= 80
      GROUP BY "state_number","consecutive_number"
     ) v
LIMIT 20;
```

```sql
--Description: Assemble the final labeled, feature-complete dataset (one row per qualified accident)  
SELECT a."state_number",
       v."body_type",
       a."number_of_drunk_drivers",
       a."day_of_week",
       a."hour_of_crash",
       CASE WHEN a."work_zone" <> 'None' THEN 1 ELSE 0 END AS "work_zone_flag",
       sd."speed_diff_level",
       CASE WHEN fi."fatal_count" > 1 THEN 1 ELSE 0 END AS "label"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2016 a
JOIN  ( -- multi-person accidents + fatal count
       SELECT p."state_number",
              p."consecutive_number",
              COUNT(*)                                         AS "person_count",
              SUM(CASE WHEN p."injury_severity" = 4 THEN 1 ELSE 0 END) AS "fatal_count"
       FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016 p
       GROUP  BY p."state_number", p."consecutive_number"
       HAVING COUNT(*) > 1
     ) fi
  ON a."state_number"      = fi."state_number"
 AND a."consecutive_number"= fi."consecutive_number"
LEFT JOIN ( -- one representative body-type per accident
           SELECT "state_number", "consecutive_number",
                  MIN("body_type") AS "body_type"
           FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
           GROUP BY "state_number","consecutive_number"
          ) v
  ON a."state_number"      = v."state_number"
 AND a."consecutive_number"= v."consecutive_number"
LEFT JOIN ( -- speed-difference category per accident
           SELECT "state_number","consecutive_number",
                  CASE
                      WHEN avg_diff < 20  THEN 0
                      WHEN avg_diff < 40  THEN 1
                      WHEN avg_diff < 60  THEN 2
                      WHEN avg_diff < 80  THEN 3
                      ELSE 4
                  END AS "speed_diff_level"
           FROM (
                 SELECT "state_number","consecutive_number",
                        AVG(ABS("travel_speed" - "speed_limit")) AS avg_diff
                 FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
                 WHERE  "travel_speed" <= 151
                   AND  "speed_limit"  <= 80
                 GROUP BY "state_number","consecutive_number"
                ) t
          ) sd
  ON a."state_number"      = sd."state_number"
 AND a."consecutive_number"= sd."consecutive_number"
LIMIT 20;
```
