Query:
--Description: Join those multi-person accidents to ACCIDENT_2016 to inspect key predictor columns  
SELECT a."state_number",
       a."consecutive_number",
       a."number_of_drunk_drivers",
       a."day_of_week",
       a."hour_of_crash",
       a."work_zone"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2016   a
JOIN (
      SELECT p."state_number", p."consecutive_number"
      FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016 p
      GROUP  BY p."state_number", p."consecutive_number"
      HAVING COUNT(*) > 1
     ) pc
  ON a."state_number"     = pc."state_number"
 AND a."consecutive_number"= pc."consecutive_number"
LIMIT 20;
