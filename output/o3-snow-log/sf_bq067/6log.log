Query:
--Description: Assemble the final labeled, feature-complete dataset (one row per qualified accident)  
SELECT a."state_number",
       v."body_type",
       a."number_of_drunk_drivers",
       a."day_of_week",
       a."hour_of_crash",
       CASE WHEN a."work_zone" <> 'None' THEN 1 ELSE 0 END AS "work_zone_flag",
       sd."speed_diff_level",
       CASE WHEN fi."fatal_count" > 1 THEN 1 ELSE 0 END AS "label"
FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2016 a
JOIN  ( -- multi-person accidents + fatal count
       SELECT p."state_number",
              p."consecutive_number",
              COUNT(*)                                         AS "person_count",
              SUM(CASE WHEN p."injury_severity" = 4 THEN 1 ELSE 0 END) AS "fatal_count"
       FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016 p
       GROUP  BY p."state_number", p."consecutive_number"
       HAVING COUNT(*) > 1
     ) fi
  ON a."state_number"      = fi."state_number"
 AND a."consecutive_number"= fi."consecutive_number"
LEFT JOIN ( -- one representative body-type per accident
           SELECT "state_number", "consecutive_number",
                  MIN("body_type") AS "body_type"
           FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
           GROUP BY "state_number","consecutive_number"
          ) v
  ON a."state_number"      = v."state_number"
 AND a."consecutive_number"= v."consecutive_number"
LEFT JOIN ( -- speed-difference category per accident
           SELECT "state_number","consecutive_number",
                  CASE
                      WHEN avg_diff < 20  THEN 0
                      WHEN avg_diff < 40  THEN 1
                      WHEN avg_diff < 60  THEN 2
                      WHEN avg_diff < 80  THEN 3
                      ELSE 4
                  END AS "speed_diff_level"
           FROM (
                 SELECT "state_number","consecutive_number",
                        AVG(ABS("travel_speed" - "speed_limit")) AS avg_diff
                 FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016
                 WHERE  "travel_speed" <= 151
                   AND  "speed_limit"  <= 80
                 GROUP BY "state_number","consecutive_number"
                ) t
          ) sd
  ON a."state_number"      = sd."state_number"
 AND a."consecutive_number"= sd."consecutive_number"
LIMIT 20;
