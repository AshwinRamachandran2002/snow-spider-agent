LIMIT 20;
```

```sql
--Description: Inspect realistic speed / limit pairs, filtering out special codes (997-999 for speed, 98-99 for limit)  
SELECT "travel_speed", "speed_limit"  
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."VEHICLE_2016"  
WHERE "travel_speed" < 997  
  AND "speed_limit"  < 98  
LIMIT 20;
```

```sql
--Description: Sample of the person-level table to identify the column that carries injury-severity information  
SELECT *  
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."PERSON_2016"  
LIMIT 20;
```

```sql
--Description: Prototype aggregation that links crashes and vehicles to compute an average absolute speed-difference per state  
SELECT a."state_number", 
       AVG(ABS(v."travel_speed" - v."speed_limit")) AS "avg_speed_diff"  
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."ACCIDENT_2016" a  
JOIN NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES."VEHICLE_2016"  v  
      ON a."state_number" = v."state_number"  
WHERE v."travel_speed" < 997  
  AND v."speed_limit"  < 98  
GROUP BY a."state_number"  
LIMIT 20;
```
