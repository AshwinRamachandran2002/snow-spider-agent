```sql
--Description: Identify accidents that involve more than one distinct person (needed for final label filtering)  
SELECT
    a."consecutive_number",
    COUNT(DISTINCT p."person_number") AS "person_cnt"
FROM
    NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2016      a
JOIN
    NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016        p
USING ("consecutive_number")
GROUP BY
    a."consecutive_number"
HAVING
    COUNT(DISTINCT p."person_number") > 1
LIMIT 20;
