```sql
--Description: Prototype the final labeled dataset (1 = >1 fatal-injury person) with engineered predictors for a small sample
SELECT
  a."consecutive_number",
  a."state_number",
  v."vehicle_body_type",
  a."number_of_drunk_drivers",
  a."day_of_week",
  a."hour_of_crash",
  CASE WHEN a."work_zone" <> 'None' THEN 1 ELSE 0 END AS "work_zone_flag",
  /* bucket the average speed difference into levels 0–4 (0–20,20–40,40–60,60–80,80+) */
  CASE
      WHEN s."avg_abs_speed_diff" < 20 THEN 0
      WHEN s."avg_abs_speed_diff" < 40 THEN 1
      WHEN s."avg_abs_speed_diff" < 60 THEN 2
      WHEN s."avg_abs_speed_diff" < 80 THEN 3
      ELSE 4
  END AS "speed_diff_bucket",
  /* label: 1 if >1 fatal-injury person in crash, else 0 */
  CASE WHEN f."fatal_count" > 1 THEN 1 ELSE 0 END AS "label"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.ACCIDENT_2016 a
JOIN (
      SELECT 
        v1."consecutive_number",
        AVG(ABS(v1."travel_speed" - v1."speed_limit")) AS "avg_abs_speed_diff"
      FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016 v1
      WHERE v1."travel_speed" BETWEEN 0 AND 151
        AND v1."speed_limit" BETWEEN 0 AND 80
      GROUP BY v1."consecutive_number"
     ) s
  ON a."consecutive_number" = s."consecutive_number"
JOIN (
      SELECT
        p1."consecutive_number",
        COUNT(CASE WHEN p1."injury_severity" = 4 THEN 1 END) AS "fatal_count"
      FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016 p1
      GROUP BY p1."consecutive_number"
     ) f
  ON a."consecutive_number" = f."consecutive_number"
JOIN NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.VEHICLE_2016 v
  ON a."consecutive_number" = v."consecutive_number"
WHERE f."fatal_count" >= 1
  AND a."consecutive_number" IN (
      SELECT p2."consecutive_number"
      FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016 p2
      GROUP BY p2."consecutive_number"
      HAVING COUNT(DISTINCT p2."person_number") > 1
  )
LIMIT 20;
```
