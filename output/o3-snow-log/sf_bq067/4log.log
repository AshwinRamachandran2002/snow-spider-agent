--Description: Identify crashes that involve more than one distinct person (simple join & count)
SELECT 
  p."consecutive_number",
  COUNT(DISTINCT p."person_number") AS "persons_in_crash"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2016 p
GROUP BY p."consecutive_number"
HAVING COUNT(DISTINCT p."person_number") > 1
LIMIT 20
