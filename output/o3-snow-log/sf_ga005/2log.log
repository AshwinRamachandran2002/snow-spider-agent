               'YYYYMMDD'
             )
), monday_cohorts AS (                  -- keep only Monday start dates within range
      SELECT "user_pseudo_id",
             DATE_TRUNC('week', first_session_dt) AS cohort_monday
      FROM   new_users
      WHERE  first_session_dt BETWEEN '2018-07-09' AND '2018-09-17'
), week2_returns AS (                   -- did user fire session_start in days 14-20?
      SELECT DISTINCT m."user_pseudo_id", m.cohort_monday
      FROM   monday_cohorts  m
      JOIN   all_events      e
        ON   e."user_pseudo_id" = m."user_pseudo_id"
       AND   e."event_name"    = 'session_start'
       AND   TO_DATE(e."event_date",'YYYYMMDD')
             BETWEEN m.cohort_monday + 14 AND m.cohort_monday + 20
), summary AS (
      SELECT cohort_monday,
             COUNT(DISTINCT mc."user_pseudo_id")          AS new_users,
             COUNT(DISTINCT wr."user_pseudo_id")          AS week2_retained
      FROM   monday_cohorts  mc
      LEFT JOIN week2_returns wr
        ON   wr."user_pseudo_id" = mc."user_pseudo_id"
       AND   wr.cohort_monday    = mc.cohort_monday
      GROUP BY cohort_monday
)
SELECT cohort_monday               AS cohort_week_start,
       ROUND(week2_retained * 100.0 / NULLIF(new_users,0),2) 
                                   AS week2_retention_rate_pct
FROM   summary
ORDER  BY cohort_week_start
LIMIT 20;
