      SELECT "user_pseudo_id","event_name","event_date","user_first_touch_timestamp"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20181002"
), new_users AS (                       -- users whose first session_start = first-touch
      SELECT DISTINCT e."user_pseudo_id",
             TO_DATE(e."event_date",'YYYYMMDD') AS first_session_dt
      FROM   all_events e
      WHERE  e."event_name" = 'session_start'
        AND  e."event_date" = TO_CHAR(
               TO_DATE(
                 TO_TIMESTAMP_LTZ(e."user_first_touch_timestamp" / 1000000.0)
