Query:
--Description: 6)  Daily new-user counts for the first three demo days (09–11 Jul 2018)  
WITH evts AS (                           -- collect needed cols from the three daily tables
      SELECT "user_pseudo_id","event_date",
             "user_first_touch_timestamp","event_name"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
      UNION ALL
      SELECT "user_pseudo_id","event_date",
             "user_first_touch_timestamp","event_name"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180710"
      UNION ALL
      SELECT "user_pseudo_id","event_date",
             "user_first_touch_timestamp","event_name"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180711"
)
SELECT "event_date",
       COUNT(DISTINCT "user_pseudo_id") AS "new_users"
FROM   evts
WHERE  "event_name" = 'session_start'
  AND  "event_date" = TO_CHAR(                       -- first-touch date = event_date
         TO_DATE(
           TO_TIMESTAMP_LTZ("user_first_touch_timestamp" / 1000000.0)
         ),
         'YYYYMMDD'
       )
GROUP  BY "event_date"
ORDER  BY "event_date"
LIMIT 20
