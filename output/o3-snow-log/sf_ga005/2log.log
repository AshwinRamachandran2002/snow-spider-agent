--Description: 8)  Which 09-Jul cohort users returned with session_start in week 2 (23-29 Jul 2018)  
WITH base AS (      -- 09-Jul “new” users
      SELECT DISTINCT "user_pseudo_id"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
      WHERE "event_name" = 'session_start'
        AND "event_date" = TO_CHAR(
              TO_DATE(
                TO_TIMESTAMP_LTZ("user_first_touch_timestamp" / 1000000.0)
              ),
              'YYYYMMDD'
            )
), w2 AS (          -- session_start events during 23-29 Jul
      SELECT DISTINCT "user_pseudo_id"
      FROM (
            SELECT "user_pseudo_id","event_name" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180723" UNION ALL
            SELECT "user_pseudo_id","event_name" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180724" UNION ALL
            SELECT "user_pseudo_id","event_name" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180725" UNION ALL
            SELECT "user_pseudo_id","event_name" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180726" UNION ALL
            SELECT "user_pseudo_id","event_name" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180727" UNION ALL
            SELECT "user_pseudo_id","event_name" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180728" UNION ALL
            SELECT "user_pseudo_id","event_name" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180729"
          )
      WHERE "event_name" = 'session_start'
)
SELECT *
FROM   base
WHERE  "user_pseudo_id" IN (SELECT "user_pseudo_id" FROM w2)
LIMIT 20
