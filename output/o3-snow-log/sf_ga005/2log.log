20180710,36
20180711,43
Query:
--Description: 7)  Build each user’s cohort Monday (2018-07-09 … 2018-07-29)  
WITH evts AS (
      SELECT "user_pseudo_id","event_date","event_name",
             TO_DATE("event_date",'YYYYMMDD') AS evt_dt
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
      UNION ALL
      SELECT "user_pseudo_id","event_date","event_name",
             TO_DATE("event_date",'YYYYMMDD')
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180710"
      UNION ALL
      SELECT "user_pseudo_id","event_date","event_name",
             TO_DATE("event_date",'YYYYMMDD')
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180711"
)
SELECT DISTINCT "user_pseudo_id",
       DATE_TRUNC('week', evt_dt) AS cohort_week_start
FROM   evts
WHERE  "event_name" = 'session_start'
LIMIT 20
