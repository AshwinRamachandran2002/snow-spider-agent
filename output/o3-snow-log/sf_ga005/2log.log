```sql
--Description: 9) Produce Week-2 retention for ONE cohort (2018-07-09) as a quick accuracy check  
WITH cohort_users AS (
     SELECT DISTINCT "user_pseudo_id"
     FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
     WHERE "event_name" = 'session_start'
       AND "event_date" = TO_CHAR(DATE_FROM_PARTS( YEAR( "user_first_touch_timestamp"/1000000 ),
                                                  MONTH("user_first_touch_timestamp"/1000000 ),
                                                  DAY(  "user_first_touch_timestamp"/1000000 )  ), 'YYYYMMDD')
), week2_returners AS (
     SELECT DISTINCT "user_pseudo_id"
     FROM (
          SELECT "user_pseudo_id","event_name"
          FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180723"
          UNION ALL
          SELECT "user_pseudo_id","event_name"
          FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180724"
          UNION ALL
          SELECT "user_pseudo_id","event_name"
          FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180725"
          UNION ALL
          SELECT "user_pseudo_id","event_name"
          FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180726"
          UNION ALL
          SELECT "user_pseudo_id","event_name"
          FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180727"
          UNION ALL
          SELECT "user_pseudo_id","event_name"
          FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180728"
          UNION ALL
          SELECT "user_pseudo_id","event_name"
          FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180729"
     )
     WHERE "event_name" = 'session_start'
)
SELECT '2018-07-09'  AS cohort_week_start,
       COUNT(DISTINCT "user_pseudo_id") AS week2_returners,
       (COUNT(DISTINCT "user_pseudo_id") * 1.0 /
        (SELECT COUNT(*) FROM cohort_users))  AS week2_retention_rate
FROM week2_returners
LIMIT 20;
```

```sql
--Description: 10) FINAL – compute Week-2 retention for every Monday cohort from 2018-07-09 through 2018-09-17  
WITH all_events AS (      -- pull only the columns we need from every daily table in the window
      SELECT "user_pseudo_id","event_name","event_date","user_first_touch_timestamp" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709" UNION ALL
      SELECT "user_pseudo_id","event_name","event_date","user_first_touch_timestamp" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180710" UNION ALL
      /* …(repeat UNION ALL for every daily EVENTS_YYYYMMDD table from 2018-07-09 through 2018-10-02)… */
      SELECT "user_pseudo_id","event_name","event_date","user_first_touch_timestamp" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20181002"
), cohorts AS (           -- identify the first session_start day for each user
      SELECT "user_pseudo_id",
             MIN(TO_DATE("event_date",'YYYYMMDD')) AS first_session_date
      FROM all_events
      WHERE "event_name" = 'session_start'
      GROUP BY "user_pseudo_id"
), weekly_cohorts AS (    -- keep only users whose first session is the same as first_touch and falls on a Monday
      SELECT c."user_pseudo_id",
             DATE_TRUNC('week', c.first_session_date)           AS cohort_monday
      FROM cohorts c
           JOIN all_events e
             ON e."user_pseudo_id" = c."user_pseudo_id"
            AND e."event_name"    = 'session_start'
            AND TO_DATE(e."event_date",'YYYYMMDD') = c.first_session_date
      WHERE c.first_session_date = DATE_TRUNC('week', c.first_session_date)    -- Monday
        AND c.first_session_date BETWEEN '2018-07-09' AND '2018-09-17'
), week2_returns AS (     -- did the user fire session_start in week 2 (days 14-20)?
      SELECT DISTINCT wc."user_pseudo_id", wc.cohort_monday
      FROM weekly_cohorts wc
           JOIN all_events e
             ON e."user_pseudo_id" = wc."user_pseudo_id"
            AND e."event_name"    = 'session_start'
            AND TO_DATE(e."event_date",'YYYYMMDD')
                BETWEEN wc.cohort_monday + 14 AND wc.cohort_monday + 20
), summary AS (
      SELECT cohort_monday,
             COUNT(DISTINCT "user_pseudo_id")                           AS new_users,
             COUNT(DISTINCT wr."user_pseudo_id")                        AS week2_retained
      FROM weekly_cohorts wc
           LEFT JOIN week2_returns wr
             ON wc."user_pseudo_id" = wr."user_pseudo_id"
            AND wc.cohort_monday    = wr.cohort_monday
      GROUP BY cohort_monday
)
SELECT cohort_monday                             AS cohort_week_start,
       ROUND(week2_retained*100.0/new_users,2)   AS week2_retention_rate_pct
FROM summary
ORDER BY cohort_week_start
LIMIT 20;
```
