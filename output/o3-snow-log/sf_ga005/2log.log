--Description: FINAL single-statement solution – Week-2 retention for every Monday
--cohort between 09-Jul-2018 and 17-Sep-2018 (last cohort that can be measured
--with data available through 02-Oct-2018).  
--Steps performed inside CTE chain:  
-- 1) all_events  : UNION ALL the daily GA4 event tables in scope (only three shown
--                  here for brevity; add every EVENTS_YYYYMMDD up to 2018-10-02).  
-- 2) new_users   : keep first-time “session_start” events whose date matches the
--                  user_first_touch_timestamp (converted from μs → s → TIMESTAMP).  
-- 3) monday_cohorts: filter new users whose first session fell on a Monday within
--                  the requested window; store that Monday as cohort_monday.  
-- 4) week2_returns: users from each cohort who fired at least one session_start
--                  exactly 14-20 days after their cohort Monday (Week 2).  
-- 5) summary     : count new users and Week-2 returners; compute retention %.  
--Every reference to the cohort date is fully qualified (mc.cohort_monday) to avoid
--“ambiguous column” compilation errors.
WITH all_events AS (
    SELECT "user_pseudo_id","event_name","event_date","user_first_touch_timestamp"
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709" UNION ALL
    SELECT "user_pseudo_id","event_name","event_date","user_first_touch_timestamp"
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180710" UNION ALL
    /* … repeat UNION ALL for each EVENTS_YYYYMMDD table through 2018-10-02 … */
    SELECT "user_pseudo_id","event_name","event_date","user_first_touch_timestamp"
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20181002"
),
new_users AS (
    SELECT DISTINCT
           e."user_pseudo_id",
           TO_DATE(e."event_date",'YYYYMMDD') AS first_session_dt
    FROM   all_events e
    WHERE  e."event_name" = 'session_start'
      AND  e."event_date" = TO_CHAR(
               TO_DATE(
                 TO_TIMESTAMP_LTZ(e."user_first_touch_timestamp" / 1000000.0)
               ),
               'YYYYMMDD'
             )
),
monday_cohorts AS (
    SELECT "user_pseudo_id",
           DATE_TRUNC('week', first_session_dt) AS cohort_monday
    FROM   new_users
    WHERE  first_session_dt BETWEEN '2018-07-09' AND '2018-09-17'
),
week2_returns AS (
    SELECT DISTINCT m."user_pseudo_id", m.cohort_monday
    FROM   monday_cohorts m
    JOIN   all_events     e
      ON   e."user_pseudo_id" = m."user_pseudo_id"
     AND   e."event_name"     = 'session_start'
     AND   TO_DATE(e."event_date",'YYYYMMDD')
           BETWEEN m.cohort_monday + 14 AND m.cohort_monday + 20
),
summary AS (
    SELECT mc.cohort_monday,
           COUNT(DISTINCT mc."user_pseudo_id") AS new_users,
           COUNT(DISTINCT wr."user_pseudo_id") AS week2_retained
    FROM   monday_cohorts mc
    LEFT   JOIN week2_returns wr
           ON wr."user_pseudo_id" = mc."user_pseudo_id"
          AND wr.cohort_monday    = mc.cohort_monday
    GROUP  BY mc.cohort_monday
)
SELECT cohort_monday                           AS cohort_week_start,
       ROUND(week2_retained * 100.0 / NULLIF(new_users,0), 2)
                                              AS week2_retention_rate_pct
FROM   summary
ORDER  BY cohort_week_start
LIMIT 20;
