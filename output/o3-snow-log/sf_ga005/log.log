--Description: 10) Count distinct users who triggered “session_start” in three consecutive Monday cohorts.
SELECT "event_date",
       COUNT(DISTINCT "user_pseudo_id") AS "session_start_users"
FROM (
      SELECT "event_date","user_pseudo_id"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
      WHERE "event_name" ILIKE '%session_start%'
      UNION ALL
      SELECT "event_date","user_pseudo_id"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180716"
      WHERE "event_name" ILIKE '%session_start%'
      UNION ALL
      SELECT "event_date","user_pseudo_id"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180723"
      WHERE "event_name" ILIKE '%session_start%'
) AS u
GROUP BY "event_date"
ORDER BY "event_date"
LIMIT 20;
