),
/* ----------------------------------------------------------
   2. Identify NEW users (session_start where event_dt = first_touch)
-----------------------------------------------------------*/
cohort_raw AS (
    SELECT   "user_pseudo_id"                                               AS user_id ,
             DATE_TRUNC('week', event_dt)                                   AS cohort_monday
    FROM     events_all
    WHERE    "event_name" = 'session_start'
      AND    event_dt = first_touch_dt
),
cohort_users AS (                    /* only cohorts we can measure week-2 for */
    SELECT DISTINCT user_id, cohort_monday
    FROM   cohort_raw
    WHERE  cohort_monday BETWEEN '2018-07-09'::DATE AND '2018-09-17'::DATE
),
cohort_sizes AS (
    SELECT  cohort_monday, COUNT(DISTINCT user_id) AS cohort_size
    FROM    cohort_users
    GROUP BY cohort_monday
),
/* ----------------------------------------------------------
   3. Users with a session_start in Week-2 (days 14-20)
-----------------------------------------------------------*/
week2_retained AS (
    SELECT DISTINCT cu.user_id, cu.cohort_monday
    FROM   cohort_users cu
    JOIN   events_all e
           ON cu.user_id = e."user_pseudo_id"
          AND e."event_name" = 'session_start'
          AND e.event_dt BETWEEN DATEADD(day,14,cu.cohort_monday)
                             AND DATEADD(day,20,cu.cohort_monday)
),
week2_counts AS (
    SELECT cohort_monday, COUNT(DISTINCT user_id) AS retained_users
    FROM   week2_retained
    GROUP BY cohort_monday
)
/* ----------------------------------------------------------
   4. Final weekly 2-week retention %
-----------------------------------------------------------*/
SELECT  cs.cohort_monday                     AS cohort_week_start ,
        ROUND( COALESCE(w2.retained_users,0) * 100.0 / cs.cohort_size , 2)  AS week2_retention_rate_percent
FROM    cohort_sizes   cs
LEFT JOIN week2_counts w2
       ON cs.cohort_monday = w2.cohort_monday
ORDER BY cohort_week_start;
