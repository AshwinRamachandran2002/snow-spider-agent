Query:
--Description: Count how many of that cohort returned with a session_start during 23-Jul-2018 week
SELECT COUNT(DISTINCT b."user_pseudo_id") AS "retained_users"
FROM (
  SELECT DISTINCT "user_pseudo_id"
  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
  WHERE "event_name" = 'session_start'
    AND "event_date" BETWEEN '20180709' AND '20180715'
    AND "event_date" = TO_CHAR(TO_DATE(TO_TIMESTAMP("user_first_touch_timestamp" / 1000000)), 'YYYYMMDD')
) a
JOIN (
  SELECT DISTINCT "user_pseudo_id"
  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180723"
  WHERE "event_name" = 'session_start'
    AND "event_date" BETWEEN '20180723' AND '20180729'
) b
ON a."user_pseudo_id" = b."user_pseudo_id"
LIMIT 20;
