--Description: Repeat Week-2 retention calculation for the last eligible cohort (17-Sep-2018 → 1-Oct-2018)
WITH cohort AS (
  SELECT DISTINCT "user_pseudo_id"
  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180917"
  WHERE "event_name" = 'session_start'
    AND "event_date" BETWEEN '20180917' AND '20180923'
    AND "event_date" = TO_CHAR(TO_DATE(TO_TIMESTAMP("user_first_touch_timestamp" / 1000000)), 'YYYYMMDD')
),
retained AS (
  SELECT DISTINCT "user_pseudo_id"
  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20181001"
  WHERE "event_name" = 'session_start'
    AND "event_date" BETWEEN '20181001' AND '20181007'
)
SELECT (SELECT COUNT(*) FROM retained) * 100.0 /
       NULLIF((SELECT COUNT(*) FROM cohort), 0) AS "week_2_retention_pct"
LIMIT 20;
