--Description: 8) For the three-week sample, get each user’s first “session_start” Monday cohort  
WITH first_sessions AS (
  SELECT "user_pseudo_id",
         MIN( DATE_TRUNC('WEEK', TO_DATE("event_date",'YYYYMMDD')) ) AS "cohort_monday"
  FROM (
        SELECT *
        FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
        WHERE "event_name" = 'session_start'
        UNION ALL
        SELECT *
        FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180716"
        WHERE "event_name" = 'session_start'
        UNION ALL
        SELECT *
        FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180723"
        WHERE "event_name" = 'session_start'
       )
  GROUP BY "user_pseudo_id"
)
SELECT *
FROM first_sessions
LIMIT 20;
