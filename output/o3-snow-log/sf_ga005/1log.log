  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
  WHERE "event_name" = 'session_start'
    AND "event_date" = '20180709'          -- Monday cohort
), week2 AS (
  SELECT DISTINCT "user_pseudo_id"
  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180723"  -- two Mondays later
  WHERE "event_name" = 'session_start'
