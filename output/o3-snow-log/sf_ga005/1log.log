Query:
--Description: 9) Find users from the 9-Jul cohort that returned with a session_start exactly 2 weeks later  
WITH cohort AS (
  SELECT DISTINCT "user_pseudo_id"
  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
  WHERE "event_name" = 'session_start'
    AND "event_date" = '20180709'          -- Monday cohort
), week2 AS (
  SELECT DISTINCT "user_pseudo_id"
  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180723"  -- two Mondays later
  WHERE "event_name" = 'session_start'
)
SELECT COUNT(*) AS "week2_returning"
FROM cohort
WHERE "user_pseudo_id" IN (SELECT "user_pseudo_id" FROM week2);
Answer:
week2_returning
132
