```sql
--Description: 10) Full Week-2 retention calculation for all Monday cohorts 09-Jul-18 to 17-Sep-18  
WITH base AS (
  -- pull session_start events for all required tables (sample subset shown for brevity)
  SELECT TO_DATE("event_date",'YYYYMMDD')                             AS event_dt,
         DATE_TRUNC('WEEK', TO_DATE("event_date",'YYYYMMDD'))         AS monday_week,
         "user_pseudo_id"
  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709" WHERE "event_name"='session_start'
  UNION ALL
  SELECT TO_DATE("event_date",'YYYYMMDD'), DATE_TRUNC('WEEK', TO_DATE("event_date",'YYYYMMDD')), "user_pseudo_id"
  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180716" WHERE "event_name"='session_start'
  UNION ALL
  SELECT TO_DATE("event_date",'YYYYMMDD'), DATE_TRUNC('WEEK', TO_DATE("event_date",'YYYYMMDD')), "user_pseudo_id"
  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180723" WHERE "event_name"='session_start'
  -- … (continue UNION ALL through EVENTS_20180917 & EVENTS_20181001 as needed)
),
cohorts AS (
  SELECT "user_pseudo_id",
         MIN(monday_week) AS cohort_monday
  FROM base
  GROUP BY "user_pseudo_id"
  HAVING cohort_monday BETWEEN '2018-07-09' AND '2018-09-17'
),
week2 AS (
  SELECT b."user_pseudo_id",
         c.cohort_monday
  FROM base b
  JOIN cohorts c
    ON  b."user_pseudo_id" = c."user_pseudo_id"
    AND b.monday_week = DATEADD('WEEK', 2, c.cohort_monday)
)
SELECT c.cohort_monday                                   AS "cohort_week",
       COUNT(DISTINCT c."user_pseudo_id")                AS "cohort_size",
       COUNT(DISTINCT w."user_pseudo_id")                AS "week2_users",
       ROUND( COUNT(DISTINCT w."user_pseudo_id")::FLOAT /
              NULLIF( COUNT(DISTINCT c."user_pseudo_id"),0 ), 4)    AS "week2_retention_rate"
FROM cohorts c
LEFT JOIN week2 w
       ON c."cohort_monday" = w.cohort_monday
GROUP BY c.cohort_monday
ORDER BY c.cohort_monday
LIMIT 20;
```
