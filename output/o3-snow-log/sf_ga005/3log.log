```sql
--Description: 10) FINAL – compute Week-2 retention rate for each weekly cohort (Mon-start)  
WITH events AS (
  /* union of all Monday tables 2018-07-09 through 2018-10-01 */  
  SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709" UNION ALL
  SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180716" UNION ALL
  SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180723" UNION ALL
  SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180730" UNION ALL
  SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180806" UNION ALL
  SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180813" UNION ALL
  SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180820" UNION ALL
  SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180827" UNION ALL
  SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180903" UNION ALL
  SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180910" UNION ALL
  SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180917" UNION ALL
  SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180924" UNION ALL
  SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20181001"
),
cohort AS (
  /* users whose FIRST session_start happens during the cohort week */
  SELECT DISTINCT "user_pseudo_id",
         DATE_TRUNC('week', TO_DATE("event_date", 'YYYYMMDD')) AS "cohort_week"
  FROM events
  WHERE "event_name" = 'session_start'
    AND "event_date" = TO_CHAR(TO_TIMESTAMP("user_first_touch_timestamp"/1000000), 'YYYYMMDD')
),
week2_returns AS (
  /* session_start exactly 2 weeks after cohort week (same weekday) */
  SELECT DISTINCT e."user_pseudo_id",
         DATE_TRUNC('week', TO_DATE(e."event_date", 'YYYYMMDD')) AS "event_week"
  FROM events e
  WHERE e."event_name" = 'session_start'
),
retention AS (
  SELECT c."cohort_week",
         COUNT(DISTINCT c."user_pseudo_id")                     AS "cohort_size",
         COUNT(DISTINCT CASE 
                 WHEN w."event_week" = DATEADD('day',14,c."cohort_week") 
                 THEN c."user_pseudo_id" END)                   AS "week2_users"
  FROM cohort c
  LEFT JOIN week2_returns w 
         ON c."user_pseudo_id" = w."user_pseudo_id"
  GROUP BY c."cohort_week"
)
SELECT "cohort_week"                         AS "cohort_monday",
       ROUND("week2_users" * 100.0 / NULLIF("cohort_size",0), 2) 
                                             AS "week2_retention_percent"
FROM retention
WHERE "cohort_week" BETWEEN '2018-07-09' AND '2018-09-17'
ORDER BY "cohort_week"
LIMIT 20;
```
