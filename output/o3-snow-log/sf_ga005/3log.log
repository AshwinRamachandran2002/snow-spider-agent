       ROUND("week2_users" * 100.0 / NULLIF("cohort_size",0), 2) AS "week2_retention_percent"
FROM retention
WHERE "cohort_week" BETWEEN '2018-07-09' AND '2018-09-17'
ORDER BY "cohort_week"
