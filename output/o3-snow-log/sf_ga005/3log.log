--Description: 6) Build a mini-cohort table (first two Mondays only) with cohort size  
WITH cohort AS (
  SELECT DISTINCT "user_pseudo_id",
         DATE_TRUNC('week', TO_DATE("event_date", 'YYYYMMDD')) AS "cohort_week"
  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
  WHERE "event_name" = 'session_start'
    AND "event_date" = TO_CHAR(TO_TIMESTAMP("user_first_touch_timestamp"/1000000), 'YYYYMMDD')
)
SELECT "cohort_week",
       COUNT(DISTINCT "user_pseudo_id") AS "cohort_size"
FROM cohort
GROUP BY "cohort_week"
LIMIT 20;
