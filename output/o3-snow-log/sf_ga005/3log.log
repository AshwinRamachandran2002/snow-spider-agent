--Description: 7) Count how many of those 2018-07-09 cohort users came back exactly 2 weeks later  
WITH cohort AS (
  SELECT DISTINCT "user_pseudo_id",
         DATE_TRUNC('week', TO_DATE("event_date", 'YYYYMMDD')) AS "cohort_week"
  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
  WHERE "event_name" = 'session_start'
    AND "event_date" = TO_CHAR(TO_TIMESTAMP("user_first_touch_timestamp"/1000000), 'YYYYMMDD')
),
returns AS (
  SELECT DISTINCT "user_pseudo_id"
  FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180723"
  WHERE "event_name" = 'session_start'
)
SELECT COUNT(DISTINCT r."user_pseudo_id") AS "week2_returning"
FROM cohort c
JOIN returns r ON c."user_pseudo_id" = r."user_pseudo_id"
LIMIT 20;
