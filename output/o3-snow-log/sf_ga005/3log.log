```sql
--Description:  Weekly-cohort Week-2 retention (thinking process embedded)
--  • Problem recap: UNION ALL on the raw daily tables failed because different
--    days have differing column counts.  To guarantee uniformity, explicitly
--    project the **same four columns** that are present in every table.
--  • Scope: Mondays (week starts) from 2018-07-09 through 2018-10-01.  This lets
--    us analyse cohorts 2018-07-09 … 2018-09-17 and still have the “+14-day”
--    Monday available for each cohort.
--  • Steps inside the CTEs:
--      1. events  – union of the Monday tables with 4 safe columns.
--      2. cohort  – “new” users ⇒ first session_start whose event_date equals
--                   the date of user_first_touch_timestamp.
--      3. week2   – any session_start the **same user** performs exactly
--                   14 days (2 weeks) after the cohort Monday.
--      4. retention – count and compute Week-2 rate.
--  • Output: cohort Monday plus Week-2 retention %, ordered chronologically.

WITH events AS (
    SELECT "event_date","user_pseudo_id","event_name","user_first_touch_timestamp"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709" UNION ALL
    SELECT "event_date","user_pseudo_id","event_name","user_first_touch_timestamp"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180716" UNION ALL
    SELECT "event_date","user_pseudo_id","event_name","user_first_touch_timestamp"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180723" UNION ALL
    SELECT "event_date","user_pseudo_id","event_name","user_first_touch_timestamp"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180730" UNION ALL
    SELECT "event_date","user_pseudo_id","event_name","user_first_touch_timestamp"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180806" UNION ALL
    SELECT "event_date","user_pseudo_id","event_name","user_first_touch_timestamp"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180813" UNION ALL
    SELECT "event_date","user_pseudo_id","event_name","user_first_touch_timestamp"
