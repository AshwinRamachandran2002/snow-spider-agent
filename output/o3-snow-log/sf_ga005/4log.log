```sql
--Description: Verify that the same user can appear on different days; take two consecutive Mondays  
--(09-Jul and 16-Jul) to see how min(event_date) behaves for each user.  
SELECT 
    t."user_pseudo_id",
    MIN(t."event_date") AS "first_seen_date"
FROM (
      SELECT "user_pseudo_id", "event_date"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
      WHERE "event_name" = 'session_start'
      UNION ALL
      SELECT "user_pseudo_id", "event_date"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180716"
      WHERE "event_name" = 'session_start'
     )  AS t
GROUP BY t."user_pseudo_id"
LIMIT 20;
