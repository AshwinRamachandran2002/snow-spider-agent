    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
    WHERE "event_name" = 'session_start'
    GROUP BY "user_pseudo_id"
)
SELECT COUNT(*) AS "new_users_20180709"
FROM first_session
WHERE "first_session_date" = '20180709';
