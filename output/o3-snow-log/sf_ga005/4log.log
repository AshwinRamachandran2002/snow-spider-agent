--Description: Prepare a tiny sample that joins the 09-Jul cohort with 23-Jul to see  
--whether those users returned exactly two weeks later.  
WITH cohort AS (
    SELECT DISTINCT "user_pseudo_id"
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
    WHERE "event_name" = 'session_start'
),
returns AS (
    SELECT DISTINCT "user_pseudo_id"
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180723"
    WHERE "event_name" = 'session_start'
)
SELECT 
    c."user_pseudo_id",
    CASE WHEN r."user_pseudo_id" IS NOT NULL THEN 1 ELSE 0 END AS "returned_in_week2"
