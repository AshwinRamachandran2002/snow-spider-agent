```sql
--Description: Inspect a handful of raw salary strings together with company and location
SELECT 
  "CompanyName",
  "Location",
  "Salary"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
LIMIT 20;
```

```sql
--Description: Remove all non–numeric characters from “Salary” and cast the result to NUMBER
SELECT
  "CompanyName",
  "Location",
  CAST(REGEXP_REPLACE("Salary", '[^0-9]', '') AS NUMBER) AS "clean_salary"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
LIMIT 20;
```

```sql
--Description: Find the average (cleaned) salary for every location to see overall city-level pay
SELECT
  "Location",
  AVG(CAST(REGEXP_REPLACE("Salary", '[^0-9]', '') AS NUMBER)) AS "avg_salary_city"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
GROUP BY "Location"
ORDER BY "avg_salary_city" DESC
LIMIT 20;
```

```sql
--Description: Mumbai ‑ average salary of each company operating in that city
SELECT
  "CompanyName",
  AVG(CAST(REGEXP_REPLACE("Salary", '[^0-9]', '') AS NUMBER)) AS "avg_salary_mumbai"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
WHERE "Location" = 'Mumbai'
GROUP BY "CompanyName"
ORDER BY "avg_salary_mumbai" DESC
LIMIT 20;
```

```sql
--Description: Pull records only for the four cities of interest
SELECT 
  "CompanyName",
  "Location",
  CAST(REGEXP_REPLACE("Salary", '[^0-9]', '') AS NUMBER) AS "clean_salary"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
LIMIT 20;
```

```sql
--Description: Average salary by company for the four chosen cities, sorted high-to-low
SELECT
  "Location",
  "CompanyName",
  AVG(CAST(REGEXP_REPLACE("Salary", '[^0-9]', '') AS NUMBER)) AS "avg_salary_city"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location","CompanyName"
ORDER BY "Location","avg_salary_city" DESC
LIMIT 20;
```

```sql
--Description: Rank companies inside each city so we can later keep only the top-5
SELECT
  "Location",
  "CompanyName",
  AVG(CAST(REGEXP_REPLACE("Salary", '[^0-9]', '') AS NUMBER)) AS "avg_salary_city",
  ROW_NUMBER() OVER (PARTITION BY "Location" 
                     ORDER BY AVG(CAST(REGEXP_REPLACE("Salary", '[^0-9]', '') AS NUMBER)) DESC) AS "rn"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location","CompanyName"
ORDER BY "Location","rn"
LIMIT 20;
```

```sql
--Description: Compute the overall (national) average salary across every record in the dataset
SELECT 
  AVG(CAST(REGEXP_REPLACE("Salary", '[^0-9]', '') AS NUMBER)) AS "national_avg_salary"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – top-5 companies by average salary in each city vs national average
WITH cleaned AS (
  SELECT 
    "CompanyName",
    "Location",
    CAST(REGEXP_REPLACE("Salary", '[^0-9]', '') AS NUMBER) AS salary_num
  FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
  WHERE "Salary" IS NOT NULL
),
national AS (
  SELECT AVG(salary_num) AS national_avg_salary
  FROM cleaned
),
city_company AS (
  SELECT
    "Location",
    "CompanyName",
    AVG(salary_num) AS avg_salary_city
  FROM cleaned
  WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
  GROUP BY "Location","CompanyName"
),
ranked AS (
  SELECT
    cc.*,
    ROW_NUMBER() OVER (PARTITION BY "Location" ORDER BY avg_salary_city DESC) AS rn
  FROM city_company cc
)
SELECT
  "Location",
  "CompanyName",
  ROUND(avg_salary_city, 2) AS "Average Salary in State",
  ROUND(n.national_avg_salary, 2) AS "Average Salary in Country"
FROM ranked
CROSS JOIN national n
WHERE rn <= 5
ORDER BY "Location", "Average Salary in State" DESC
LIMIT 20;
```
