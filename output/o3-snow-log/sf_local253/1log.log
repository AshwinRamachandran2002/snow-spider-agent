```sql
-- 4) Description: Show how the “Salary” string will be cleaned (keep only digits, then cast to NUMBER)
SELECT "CompanyName",
       "Location",
       "Salary",
       TO_NUMBER(REGEXP_REPLACE("Salary",'[^0-9]','')) AS "CleanSalary"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
WHERE "Location" ILIKE ANY ('%Mumbai%','%Pune%','%New Delhi%','%Hyderabad%')
LIMIT 20;
```

```sql
-- 5) Description: Compute the national (all-India) average salary after cleaning
SELECT AVG(TO_NUMBER(REGEXP_REPLACE("Salary",'[^0-9]',''))) AS "AvgSalary_India"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET;
```

```sql
-- 6) Description: Calculate average salary for every company within the four target cities
WITH cleaned AS (
    SELECT "CompanyName",
           "Location",
           TO_NUMBER(REGEXP_REPLACE("Salary",'[^0-9]','')) AS "CleanSalary"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
    WHERE "Location" ILIKE ANY ('%Mumbai%','%Pune%','%New Delhi%','%Hyderabad%')
)
SELECT "Location",
       "CompanyName",
       AVG("CleanSalary") AS "AvgSalary_City"
FROM cleaned
GROUP BY "Location","CompanyName"
ORDER BY "Location","AvgSalary_City" DESC
LIMIT 20;
```

```sql
-- 7) Description: Rank companies inside each city by their average salary
WITH cleaned AS (
    SELECT "CompanyName",
           "Location",
           TO_NUMBER(REGEXP_REPLACE("Salary",'[^0-9]','')) AS "CleanSalary"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
    WHERE "Location" ILIKE ANY ('%Mumbai%','%Pune%','%New Delhi%','%Hyderabad%')
), city_avg AS (
    SELECT "Location",
           "CompanyName",
           AVG("CleanSalary") AS "AvgSalary_City"
    FROM cleaned
    GROUP BY "Location","CompanyName"
)
SELECT "Location",
       "CompanyName",
       "AvgSalary_City",
       RANK() OVER (PARTITION BY "Location" ORDER BY "AvgSalary_City" DESC) AS "CityRank"
FROM city_avg
ORDER BY "Location","CityRank"
LIMIT 20;
```

```sql
-- 8) Description: Keep only the TOP-5 companies (by avg salary) for each of the four cities
WITH cleaned AS (
    SELECT "CompanyName",
           "Location",
           TO_NUMBER(REGEXP_REPLACE("Salary",'[^0-9]','')) AS "CleanSalary"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
    WHERE "Location" ILIKE ANY ('%Mumbai%','%Pune%','%New Delhi%','%Hyderabad%')
), city_avg AS (
    SELECT "Location",
           "CompanyName",
           AVG("CleanSalary") AS "AvgSalary_City"
    FROM cleaned
    GROUP BY "Location","CompanyName"
), ranked AS (
    SELECT "Location",
           "CompanyName",
           "AvgSalary_City",
           RANK() OVER (PARTITION BY "Location" ORDER BY "AvgSalary_City" DESC) AS "CityRank"
    FROM city_avg
)
SELECT *
FROM ranked
WHERE "CityRank" <= 5
ORDER BY "Location","CityRank"
LIMIT 20;
```

```sql
-- 9) Description: Store the country-wide average salary once so we can join it later
WITH national AS (
    SELECT AVG(TO_NUMBER(REGEXP_REPLACE("Salary",'[^0-9]',''))) AS "AvgSalary_India"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
)
SELECT *
FROM national;
```

```sql
-- 10) Description (FINAL): Produce the requested output – top-5 companies per city,
--                         showing their city-level avg salary and the national avg salary
WITH cleaned AS (
    SELECT "CompanyName",
           "Location",
           TO_NUMBER(REGEXP_REPLACE("Salary",'[^0-9]','')) AS "CleanSalary"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
    WHERE "Location" ILIKE ANY ('%Mumbai%','%Pune%','%New Delhi%','%Hyderabad%')
), city_avg AS (
    SELECT "Location",
           "CompanyName",
           AVG("CleanSalary") AS "AvgSalary_City"
    FROM cleaned
    GROUP BY "Location","CompanyName"
), ranked AS (
    SELECT "Location",
           "CompanyName",
           "AvgSalary_City",
           RANK() OVER (PARTITION BY "Location" ORDER BY "AvgSalary_City" DESC) AS "CityRank"
    FROM city_avg
), top5 AS (
    SELECT "Location",
           "CompanyName",
           "AvgSalary_City"
    FROM ranked
    WHERE "CityRank" <= 5
), national AS (
    SELECT AVG(TO_NUMBER(REGEXP_REPLACE("Salary",'[^0-9]',''))) AS "AvgSalary_India"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
)
SELECT t."Location"                                     AS "Location",
       t."CompanyName"                                  AS "Company Name",
       t."AvgSalary_City"                               AS "Average Salary in State",
       n."AvgSalary_India"                              AS "Average Salary in Country"
FROM top5 t
CROSS JOIN national n
ORDER BY t."Location", t."AvgSalary_City" DESC
LIMIT 20;
```
