```sql
--Description: Inspect a sample of the salary dataset to understand raw values
SELECT 
    * 
FROM 
    EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET 
LIMIT 20;
```

```sql
--Description: List distinct locations available in the salary dataset
SELECT DISTINCT 
    "Location"
FROM 
    EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
LIMIT 20;
```

```sql
--Description: Quickly search the four target cities with a fuzzy match check
SELECT DISTINCT 
    "Location"
FROM 
    EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
WHERE 
    "Location" ILIKE '%Mumbai%' 
    OR "Location" ILIKE '%Pune%' 
    OR "Location" ILIKE '%New%Delhi%' 
    OR "Location" ILIKE '%Hyderabad%'
LIMIT 20;
```

```sql
--Description: Preview how to convert the textual salary to numeric by stripping non-digits
SELECT 
    "CompanyName",
    "Location",
    "Salary"                                 AS "raw_salary",
    REGEXP_REPLACE("Salary", '[^0-9.]', '')  AS "numeric_char_only",
    REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT AS "salary_cleaned"
FROM 
    EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
LIMIT 20;
```

```sql
--Description: Compute the overall (national) average salary after cleaning
SELECT 
    AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_country"
FROM 
    EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
LIMIT 20;
```

```sql
--Description: Calculate average salary by company and location (city)
SELECT
    "Location",
    "CompanyName",
    AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_city_company"
FROM 
    EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
GROUP BY 
    "Location",
    "CompanyName"
LIMIT 20;
```

```sql
--Description: Restrict to the four specific cities and derive each company’s average salary there
WITH city_company_avg AS (
    SELECT
        "Location",
        "CompanyName",
        AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_city_company"
    FROM 
        EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
    WHERE 
        "Location" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad')
    GROUP BY
        "Location",
        "CompanyName"
)
SELECT * 
FROM city_company_avg
LIMIT 20;
```

```sql
--Description: Bring in the national average so it can be compared with each city-company average
WITH city_company_avg AS (
    SELECT
        "Location",
        "CompanyName",
        AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_city_company"
    FROM 
        EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
    WHERE 
        "Location" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad')
    GROUP BY
        "Location",
        "CompanyName"
),
country_avg AS (
    SELECT 
        AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_country"
    FROM 
        EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
)
SELECT 
    c."Location",
    c."CompanyName",
    c."avg_salary_city_company",
    d."avg_salary_country"
FROM 
    city_company_avg  AS c,
    country_avg       AS d
LIMIT 20;
```

```sql
--Description: Rank companies within each of the four cities by their average salary
WITH city_company_avg AS (
    SELECT
        "Location",
        "CompanyName",
        AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_city_company"
    FROM 
        EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
    WHERE 
        "Location" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad')
    GROUP BY
        "Location",
        "CompanyName"
),
ranked AS (
    SELECT
        *,
        RANK() OVER (PARTITION BY "Location" ORDER BY "avg_salary_city_company" DESC) AS "salary_rank_city"
    FROM 
        city_company_avg
)
SELECT * 
FROM ranked
WHERE "salary_rank_city" <= 5
LIMIT 20;
```

```sql
--Description: Final query – top 5 companies by average salary in each specified city compared to the country average
WITH city_company_avg AS (
    SELECT
        "Location",
        "CompanyName",
        AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_city_company"
    FROM 
        EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
    WHERE 
        "Location" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad')
    GROUP BY
        "Location",
        "CompanyName"
),
ranked AS (
    SELECT
        *,
        RANK() OVER (PARTITION BY "Location" ORDER BY "avg_salary_city_company" DESC) AS "salary_rank_city"
    FROM 
        city_company_avg
),
country_avg AS (
    SELECT 
        AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_country"
    FROM 
        EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
)
SELECT
    r."Location",
    r."CompanyName",
    r."avg_salary_city_company"        AS "Average Salary in State",
    c."avg_salary_country"             AS "Average Salary in Country"
FROM 
    ranked      AS r,
    country_avg AS c
WHERE 
    r."salary_rank_city" <= 5
ORDER BY 
    r."Location",
    r."salary_rank_city"
LIMIT 20;
```
