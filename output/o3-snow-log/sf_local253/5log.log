```sql
-- Description: Preview the first 20 rows of the salary dataset
SELECT *
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
LIMIT 20;
```

```sql
-- Description: List distinct locations available in the salary dataset
SELECT DISTINCT "Location"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
ORDER BY "Location"
LIMIT 20;
```

```sql
-- Description: Retrieve distinct company names that appear in Mumbai, Pune, New Delhi, and Hyderabad
SELECT DISTINCT "Location",
       "CompanyName"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
WHERE "Location" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad')
ORDER BY "Location", "CompanyName"
LIMIT 20;
```

```sql
-- Description: Demonstrate how to clean the “Salary” text to a pure numeric value
SELECT "Salary",
       REGEXP_REPLACE("Salary", '[^0-9]', '')                          AS "salary_digits",
       TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', ''))               AS "salary_numeric"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
LIMIT 20;
```

```sql
-- Description: Compute the average (cleaned) salary for every location
SELECT "Location",
       AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', '')))          AS "avg_salary"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
GROUP BY "Location"
ORDER BY "avg_salary" DESC
LIMIT 20;
```

```sql
-- Description: Calculate average salary per company in the four target cities
SELECT "Location",
       "CompanyName",
       AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', '')))          AS "avg_salary_in_city"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
WHERE "Location" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad')
GROUP BY "Location", "CompanyName"
ORDER BY "Location", "avg_salary_in_city" DESC
LIMIT 20;
```

```sql
-- Description: Determine the overall national average salary across all rows
SELECT AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', '')))          AS "national_avg_salary"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET;
```

```sql
-- Description: Final result – top 5 companies by average salary in each city,
--              along with comparison to the national average salary
WITH cleaned AS (
    SELECT "Location",
           "CompanyName",
           TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', ''))           AS "salary_numeric"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
    WHERE "Location" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad')
),
city_company_avg AS (
    SELECT "Location",
           "CompanyName",
           AVG("salary_numeric")                                       AS "avg_salary_in_state",
           ROW_NUMBER() OVER (PARTITION BY "Location"
                              ORDER BY AVG("salary_numeric") DESC)      AS rn
    FROM cleaned
    GROUP BY "Location", "CompanyName"
),
national_avg AS (
    SELECT AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', '')))      AS "avg_salary_country"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
)
SELECT cca."Location",
       cca."CompanyName",
       cca."avg_salary_in_state"                                       AS "Average Salary in State",
       na."avg_salary_country"                                         AS "Average Salary in Country"
FROM  city_company_avg  cca
CROSS JOIN national_avg na
WHERE cca.rn <= 5
ORDER BY cca."Location", cca."avg_salary_in_state" DESC
LIMIT 20;
```

```sql
-- Description: Show company salary ranking within Mumbai (top 20 rows)
SELECT "CompanyName",
       AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', '')))          AS "avg_salary_mumbai",
       RANK() OVER (ORDER BY AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', ''))) DESC) AS "rank_in_mumbai"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
WHERE "Location" = 'Mumbai'
GROUP BY "CompanyName"
ORDER BY "rank_in_mumbai"
LIMIT 20;
```

```sql
-- Description: Compare each Hyderabad company’s average salary to the national average
WITH nat AS (
    SELECT AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', '')))      AS nat_avg
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
)
SELECT s."CompanyName",
       AVG(TO_NUMBER(REGEXP_REPLACE(s."Salary", '[^0-9]', '')))        AS "avg_salary_hyderabad",
       AVG(TO_NUMBER(REGEXP_REPLACE(s."Salary", '[^0-9]', ''))) - n.nat_avg AS "difference_with_national"
FROM  EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET  s
CROSS JOIN nat n
WHERE s."Location" = 'Hyderabad'
GROUP BY s."CompanyName", n.nat_avg
ORDER BY "avg_salary_hyderabad" DESC
LIMIT 20;
```
