Query:
--Description: Join city-specific and national averages for Mumbai (top 5 companies)
WITH mumbai AS (
     SELECT 
            "CompanyName",
            AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', ''))) AS "Avg_Salary_Mumbai"
     FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
     WHERE "Location" ILIKE '%Mumbai%'
     GROUP BY "CompanyName"
     QUALIFY ROW_NUMBER() OVER (ORDER BY "Avg_Salary_Mumbai" DESC) <= 5
),
company_nat AS (
     SELECT 
            "CompanyName",
            AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', ''))) AS "Company_National_Avg"
     FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
     GROUP BY "CompanyName"
)
SELECT 
       'Mumbai'                           AS "Location",
       m."CompanyName"                    AS "Company_Name",
       m."Avg_Salary_Mumbai"              AS "Average_Salary_in_State",
       c."Company_National_Avg"           AS "Average_Salary_in_Country"
FROM mumbai m
LEFT JOIN company_nat c
       ON m."CompanyName" = c."CompanyName";
