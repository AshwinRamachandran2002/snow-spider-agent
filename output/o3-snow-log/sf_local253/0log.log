```sql
--Description: Clean the salary string by stripping non-numeric characters and casting to NUMBER (sample 20 rows)
SELECT 
       "CompanyName",
       "Location",
       "Salary",
       TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', '')) AS "Clean_Salary"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
LIMIT 20;
```

```sql
--Description: Compute the overall (national) average salary after cleaning
SELECT 
       AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', ''))) AS "National_Avg_Salary"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET";
```

```sql
--Description: For Mumbai only, find average salary by company and order by highest average (top 5)
SELECT 
       "CompanyName",
       AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', ''))) AS "Avg_Salary_Mumbai"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
WHERE "Location" ILIKE '%Mumbai%'
GROUP BY "CompanyName"
ORDER BY "Avg_Salary_Mumbai" DESC
LIMIT 5;
```

```sql
--Description: Compute average salary for every company across all cities (national average per company)
SELECT 
       "CompanyName",
       AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', ''))) AS "Company_National_Avg"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
GROUP BY "CompanyName"
LIMIT 20;
```

```sql
--Description: Join city-specific and national averages for Mumbai (top 5 companies)
WITH mumbai AS (
     SELECT 
            "CompanyName",
            AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', ''))) AS "Avg_Salary_Mumbai"
     FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
     WHERE "Location" ILIKE '%Mumbai%'
     GROUP BY "CompanyName"
     QUALIFY ROW_NUMBER() OVER (ORDER BY "Avg_Salary_Mumbai" DESC) <= 5
),
company_nat AS (
     SELECT 
            "CompanyName",
            AVG(TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', ''))) AS "Company_National_Avg"
     FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
     GROUP BY "CompanyName"
)
SELECT 
       'Mumbai'                           AS "Location",
       m."CompanyName"                    AS "Company_Name",
       m."Avg_Salary_Mumbai"              AS "Average_Salary_in_State",
       c."Company_National_Avg"           AS "Average_Salary_in_Country"
FROM mumbai m
LEFT JOIN company_nat c
       ON m."CompanyName" = c."CompanyName";
```

```sql
--Description: Build a helper CTE that returns the cleaned salary once to reuse in later queries
WITH cleaned AS (
     SELECT 
            "CompanyName",
            "Location",
            TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', '')) AS "Clean_Salary"
     FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
)
SELECT *
FROM cleaned
LIMIT 20;
```

```sql
--Description: FINAL – top 5 companies (by avg salary) in each of Mumbai, Pune, New Delhi, and Hyderabad with state vs. national average
WITH cleaned AS (
     SELECT 
            "CompanyName",
            "Location",
            TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', '')) AS "Clean_Salary"
     FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
),
city_avg AS (
     SELECT
            "Location",
            "CompanyName",
            AVG("Clean_Salary") AS "Avg_Salary_State",
            ROW_NUMBER() OVER (PARTITION BY "Location" ORDER BY AVG("Clean_Salary") DESC) AS rn
     FROM cleaned
     WHERE "Location" ILIKE ANY (ARRAY['%Mumbai%','%Pune%','%New%Delhi%','%Hyderabad%'])
     GROUP BY "Location", "CompanyName"
),
top5 AS (
     SELECT * 
     FROM city_avg
     WHERE rn <= 5
),
company_nat AS (
     SELECT 
            "CompanyName",
            AVG("Clean_Salary") AS "Avg_Salary_Country"
     FROM cleaned
     GROUP BY "CompanyName"
)
SELECT 
       t."Location",
       t."CompanyName"                      AS "Company_Name",
       t."Avg_Salary_State"                 AS "Average_Salary_in_State",
       cn."Avg_Salary_Country"              AS "Average_Salary_in_Country"
FROM top5 t
LEFT JOIN company_nat cn
       ON t."CompanyName" = cn."CompanyName"
ORDER BY 
       t."Location",
       t."Avg_Salary_State" DESC;
```
