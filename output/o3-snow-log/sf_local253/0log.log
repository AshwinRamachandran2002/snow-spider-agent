```sql
--Description: 
-- THINKING PROCESS:
-- 1. “Cleaned” CTE ➜ Convert the raw “Salary” text into a pure numeric value (“Clean_Salary”) so we can average it.  
-- 2. “city_avg” CTE ➜ For each requested city (Mumbai, Pune, New Delhi, Hyderabad) compute the average salary per company.  
--    Use ROW_NUMBER() to rank companies within each city (highest average first).  
-- 3. “top5” CTE ➜ Keep only the five highest-paying companies in each city (rn ≤ 5).  
-- 4. “company_nat” CTE ➜ Compute the national (all-cities) average salary for every company.  
-- 5. Final SELECT ➜ Join “top5” with “company_nat” to compare each company’s city-level average salary to its national average.  
--    Sort by city, then by state-level average salary (descending).
WITH cleaned AS (
    SELECT
        "CompanyName",
        "Location",
        TO_NUMBER(REGEXP_REPLACE("Salary", '[^0-9]', '')) AS "Clean_Salary"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS."SALARYDATASET"
), 
city_avg AS (
    SELECT
        "Location",
        "CompanyName",
        AVG("Clean_Salary") AS "Avg_Salary_State",
        ROW_NUMBER() OVER (
            PARTITION BY "Location"
            ORDER BY AVG("Clean_Salary") DESC
        ) AS rn
    FROM cleaned
    WHERE "Location" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad')
    GROUP BY "Location", "CompanyName"
), 
top5 AS (
    SELECT *
    FROM city_avg
    WHERE rn <= 5
), 
company_nat AS (
    SELECT
        "CompanyName",
        AVG("Clean_Salary") AS "Avg_Salary_Country"
    FROM cleaned
    GROUP BY "CompanyName"
)
SELECT
    t."Location",
    t."CompanyName"          AS "Company_Name",
    t."Avg_Salary_State"     AS "Average_Salary_in_State",
    cn."Avg_Salary_Country"  AS "Average_Salary_in_Country"
FROM top5 t
LEFT JOIN company_nat cn
       ON t."CompanyName" = cn."CompanyName"
ORDER BY
    t."Location",
    t."Avg_Salary_State" DESC;
```
