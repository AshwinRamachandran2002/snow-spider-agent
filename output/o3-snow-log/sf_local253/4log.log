Query:
--Description: Join the per-city averages with national average to enable comparison  
WITH city_co_avg AS (
    SELECT 
        "Location",
        "CompanyName",
        AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_city_co",
        RANK() OVER (PARTITION BY "Location" 
                     ORDER BY AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) DESC) AS "rank_in_city"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
    WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location", "CompanyName"
)
SELECT 
    c."Location",
    c."CompanyName",
    c."avg_salary_city_co",
    n."national_avg_salary"
FROM city_co_avg AS c
CROSS JOIN (
    SELECT AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "national_avg_salary"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
) AS n
WHERE c."rank_in_city" <= 5
ORDER BY c."Location", c."rank_in_city"
LIMIT 20;
