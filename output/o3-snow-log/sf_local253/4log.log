```sql
--Description: Preview raw salary strings together with company and location details  
SELECT 
    "CompanyName", 
    "Location", 
    "Salary" 
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
LIMIT 20;
```

```sql
--Description: Inspect the variety of locations recorded in the dataset  
SELECT DISTINCT 
    "Location" 
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
LIMIT 20;
```

```sql
--Description: Pick a few salary strings and show how they can be cleaned to retain only numeric characters  
SELECT 
    "Salary",
    REGEXP_REPLACE("Salary", '[^0-9.]', '') AS "salary_numeric_string"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
LIMIT 20;
```

```sql
--Description: Convert the cleaned salary string to FLOAT (salary is stored yearly, still in INR)  
SELECT 
    "CompanyName",
    "Location",
    REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT AS "salary_in_inr"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
LIMIT 20;
```

```sql
--Description: Calculate the overall national average salary across the entire table  
SELECT 
    AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "national_avg_salary"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET;
```

```sql
--Description: Get average salary per company (national, not split by city)  
SELECT 
    "CompanyName",
    AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_company"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
GROUP BY "CompanyName"
ORDER BY "avg_salary_company" DESC
LIMIT 20;
```

```sql
--Description: Compute average salary for each company inside the four target cities  
SELECT 
    "Location",
    "CompanyName",
    AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_city_co"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location", "CompanyName"
ORDER BY "Location", "avg_salary_city_co" DESC
LIMIT 20;
```

```sql
--Description: Rank companies by average salary within each of the four cities  
SELECT 
    "Location",
    "CompanyName",
    AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_city_co",
    RANK() OVER (PARTITION BY "Location" 
                 ORDER BY AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) DESC) AS "rank_in_city"
FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location", "CompanyName"
ORDER BY "Location", "rank_in_city"
LIMIT 20;
```

```sql
--Description: Join the per-city averages with national average to enable comparison  
WITH city_co_avg AS (
    SELECT 
        "Location",
        "CompanyName",
        AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_city_co",
        RANK() OVER (PARTITION BY "Location" 
                     ORDER BY AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) DESC) AS "rank_in_city"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
    WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location", "CompanyName"
)
SELECT 
    c."Location",
    c."CompanyName",
    c."avg_salary_city_co",
    n."national_avg_salary"
FROM city_co_avg AS c
CROSS JOIN (
    SELECT AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "national_avg_salary"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
) AS n
WHERE c."rank_in_city" <= 5
ORDER BY c."Location", c."rank_in_city"
LIMIT 20;
```

```sql
--Description: Final result – top 5 companies by average salary in each specified city compared with national average  
WITH city_co_avg AS (
    SELECT 
        "Location",
        "CompanyName",
        AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "avg_salary_city_co",
        RANK() OVER (PARTITION BY "Location" 
                     ORDER BY AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) DESC) AS "rank_in_city"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
    WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location", "CompanyName"
)
SELECT 
    c."Location"                            AS "Location",
    c."CompanyName"                         AS "Company Name",
    c."avg_salary_city_co"                  AS "Average Salary in State",
    n."national_avg_salary"                 AS "Average Salary in Country"
FROM city_co_avg AS c
CROSS JOIN (
    SELECT AVG(REGEXP_REPLACE("Salary", '[^0-9.]', '')::FLOAT) AS "national_avg_salary"
    FROM EDUCATION_BUSINESS.EDUCATION_BUSINESS.SALARYDATASET
) AS n
WHERE c."rank_in_city" <= 5
ORDER BY c."Location", c."rank_in_city";
```
