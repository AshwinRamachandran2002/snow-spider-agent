--Description: Calculate week-2 (days 7-13) retention for each first “quickplay” event
--             among users whose first quick-play occurred 01-15 Aug 2018.
--             Steps (explained inline):
--   1. AUG_EVENTS  → gather 1-15 Aug events (same 4 columns in every UNION).
--   2. COHORT      → first quick-play per user (rn=1) and its cohort_day.
--   3. DENOM       → cohort size per quick-play type.
--   4. SESSION_EVENTS → all 01-31 Aug session_start events (same 2-column select).
--   5. RETAINED    → users whose session_start is 7-13 days after cohort_day.
--   6. Final SELECT joins DENOM & RETAINED to output users_initial,
--      users_retained_week2, and retention_rate, sorted ascending (lowest first).

WITH aug_events AS (
    SELECT "user_pseudo_id","event_name","event_date","event_timestamp"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180801" UNION ALL
    SELECT "user_pseudo_id","event_name","event_date","event_timestamp"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180802" UNION ALL
