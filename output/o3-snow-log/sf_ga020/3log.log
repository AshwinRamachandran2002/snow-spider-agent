retained AS (
    SELECT DISTINCT c."quickplay_type", c."user_pseudo_id"
    FROM cohort c
    JOIN session_events s ON c."user_pseudo_id" = s."user_pseudo_id"
    WHERE c.rn = 1
      AND DATEDIFF('day', c.cohort_day, s.sess_day) BETWEEN 7 AND 13
)
SELECT d."quickplay_type",
       d.users_initial,
       COUNT(DISTINCT r."user_pseudo_id") AS users_retained_week2,
       ROUND(COUNT(DISTINCT r."user_pseudo_id") / NULLIF(d.users_initial,0)::FLOAT,4) AS retention_rate
FROM denom d
LEFT JOIN retained r
       ON d."quickplay_type" = r."quickplay_type"
GROUP BY 1,2
ORDER BY retention_rate ASC
