--Description: 9)  Inspect individual users from the worst-performing quick-play cohort
WITH retention AS (   -- reuse logic from corrected query #8 WITHOUT the final LIMIT
    /* --- paste the entire WITH-chain from query #8 up to the final SELECT --- */
    WITH aug_events AS (
        SELECT "user_pseudo_id","event_name","event_date","event_timestamp" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180801" UNION ALL
        /* … same UNION set as in query #8 … */
        SELECT "user_pseudo_id","event_name","event_date","event_timestamp" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180815"
    ),
    cohort AS ( /* identical to query #8 */ SELECT /* … */ ),
    denom  AS ( /* identical to query #8 */ SELECT /* … */ ),
    session_events AS ( /* identical to query #8 */ SELECT /* … */ ),
    retained AS ( /* identical to query #8 */ SELECT /* … */ )
    SELECT d."quickplay_type",
           d.users_initial,
           COUNT(DISTINCT r."user_pseudo_id") AS users_retained_week2,
           ROUND(COUNT(DISTINCT r."user_pseudo_id") / NULLIF(d.users_initial,0)::FLOAT,4) AS retention_rate
    FROM denom d
    LEFT JOIN retained r ON d."quickplay_type" = r."quickplay_type"
    GROUP BY 1,2
),
worst AS (            -- identify the lowest-retention type
    SELECT "quickplay_type"
    FROM retention
    ORDER BY retention_rate ASC
    LIMIT 1
),
cohort_users AS (     -- users in that worst cohort
    /* cohort CTE identical to query #8 – reproduced here */
    WITH aug_events AS (
        SELECT "user_pseudo_id","event_name","event_date","event_timestamp" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180801" UNION ALL
        /* … same UNION set … */
        SELECT "user_pseudo_id","event_name","event_date","event_timestamp" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180815"
    )
    SELECT "user_pseudo_id","event_name" AS "quickplay_type"
    FROM aug_events
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "user_pseudo_id" ORDER BY "event_timestamp") = 1
    AND "event_name" ILIKE '%quickplay%'
)
SELECT cu."user_pseudo_id", cu."quickplay_type"
FROM cohort_users cu
JOIN worst w ON cu."quickplay_type" = w."quickplay_type"
LIMIT 20;
