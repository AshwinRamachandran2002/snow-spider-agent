```sql
--Description: 10)  Combine cohort size with retained counts to compute week-2 retention rate and list cohorts with the lowest rates  
WITH raw_qp AS (
    SELECT "event_name","user_pseudo_id","event_date"
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180801" UNION ALL
    /* … UNION list 02-Aug → 15-Aug … */
    SELECT "event_name","user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180815"
), cohort AS (
    SELECT "event_name",
           "user_pseudo_id",
           MIN(TO_DATE("event_date",'YYYYMMDD')) AS first_date
    FROM   raw_qp
    WHERE  "event_name" ILIKE '%quickplay%'
    GROUP  BY "event_name","user_pseudo_id"
), cohort_size AS (
    SELECT "event_name",
           COUNT(DISTINCT "user_pseudo_id") AS cohort_users
    FROM   cohort
    GROUP  BY "event_name"
), aug_sessions AS (
    SELECT "user_pseudo_id",TO_DATE("event_date",'YYYYMMDD') AS sess_dt
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180801" WHERE "event_name"='session_start' UNION ALL
    /* … UNION list 02-Aug → 31-Aug … */
    SELECT "user_pseudo_id",TO_DATE("event_date",'YYYYMMDD') FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180831" WHERE "event_name"='session_start'
), retained AS (
    SELECT DISTINCT c."event_name", c."user_pseudo_id"
    FROM   cohort c
    JOIN   aug_sessions s
          ON c."user_pseudo_id" = s."user_pseudo_id"
    WHERE  DATEDIFF('day', c.first_date, s.sess_dt) BETWEEN 8 AND 14
), retained_cnt AS (
    SELECT "event_name",
           COUNT(DISTINCT "user_pseudo_id") AS retained_users
    FROM   retained
    GROUP  BY "event_name"
)
SELECT  cs."event_name",
        cs.cohort_users,
        COALESCE(rc.retained_users,0)                           AS users_retained,
        ROUND( COALESCE(rc.retained_users,0) / cs.cohort_users ,4) AS week2_retention_rate
FROM    cohort_size cs
LEFT   JOIN retained_cnt rc
       ON cs."event_name" = rc."event_name"
ORDER  BY week2_retention_rate ASC
LIMIT 20;
