--Description: 9)  Count retained users (session_start 8–14 days after day-0) for every quick-play event type.
--              Fix: reference the aliased session date exactly as s."sess_dt" (quoted) when used in DATEDIFF.

WITH raw_qp AS (             -- quick-play rows 01-15 Aug
    SELECT "event_name","user_pseudo_id","event_date"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180801" UNION ALL
    /* … UNION ALL 02-Aug → 14-Aug identical pattern … */
    SELECT "event_name","user_pseudo_id","event_date"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180815"
), cohort AS (                -- day-0 per (event_name , user)
    SELECT "event_name",
           "user_pseudo_id",
           MIN(TO_DATE("event_date",'YYYYMMDD')) AS first_date
    FROM   raw_qp
    WHERE  "event_name" ILIKE '%quickplay%'
    GROUP  BY "event_name","user_pseudo_id"
), aug_sessions AS (          -- all session_start rows 01-31 Aug
    SELECT "user_pseudo_id",
           TO_DATE("event_date",'YYYYMMDD') AS "sess_dt"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180801" WHERE "event_name"='session_start' UNION ALL
    /* … UNION ALL 02-Aug → 31-Aug identical pattern … */
    SELECT "user_pseudo_id",
           TO_DATE("event_date",'YYYYMMDD') AS "sess_dt"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180831" WHERE "event_name"='session_start'
), retained AS (              -- users who returned in week-2
    SELECT DISTINCT c."event_name",
                    c."user_pseudo_id"
    FROM   cohort        c
    JOIN   aug_sessions  s
      ON   c."user_pseudo_id" = s."user_pseudo_id"
    WHERE  DATEDIFF('day', c.first_date, s."sess_dt") BETWEEN 8 AND 14
)
SELECT  "event_name",
        COUNT(DISTINCT "user_pseudo_id") AS retained_users
FROM    retained
GROUP  BY "event_name"
ORDER BY "event_name"
LIMIT 20
