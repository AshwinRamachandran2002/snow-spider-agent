```sql
--Description: 7)  Gather every session_start event from 1 Aug–31 Aug with its date per user  
WITH aug_sessions AS (
    SELECT  "user_pseudo_id",
            TO_DATE("event_date",'YYYYMMDD') AS sess_dt
    FROM   FIREBASE.ANALYTICS_153293282."EVENTS_20180801"  WHERE "event_name" = 'session_start' UNION ALL
    SELECT  "user_pseudo_id",TO_DATE("event_date",'YYYYMMDD') FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180802" WHERE "event_name" = 'session_start' UNION ALL
    /* … continue UNION ALL for every EVENTS_201808** table through 20180831 … */
    SELECT  "user_pseudo_id",TO_DATE("event_date",'YYYYMMDD') FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180831" WHERE "event_name" = 'session_start'
)
SELECT *
FROM   aug_sessions
LIMIT 20;
```

```sql
--Description: 8)  Identify users who had a session_start 8–14 days after their first quick-play engagement  
WITH cohort AS ( /* same as step 5 */ ),
     aug_sessions AS ( /* same as step 7 */ )
SELECT  c."event_name",
        c."user_pseudo_id"
FROM    cohort        AS c
JOIN    aug_sessions  AS s
  ON    c."user_pseudo_id" = s."user_pseudo_id"
WHERE   DATEDIFF('day', c.first_date, s.sess_dt) BETWEEN 8 AND 14
GROUP   BY 1,2
LIMIT 20;
```

```sql
--Description: 9)  Count retained users (had session_start in week 2) per quick-play event  
WITH cohort AS ( /* step 5 */ ),
     aug_sessions AS ( /* step 7 */ ),
     retained AS (
        SELECT  c."event_name",
                c."user_pseudo_id"
        FROM    cohort  c
        JOIN    aug_sessions s
              ON c."user_pseudo_id" = s."user_pseudo_id"
        WHERE   DATEDIFF('day', c.first_date, s.sess_dt) BETWEEN 8 AND 14
        GROUP  BY 1,2
     )
SELECT  "event_name",
        COUNT(DISTINCT "user_pseudo_id") AS retained_users
FROM    retained
GROUP  BY 1
LIMIT 20;
```

```sql
--Description: 10)  Combine cohort size with retained users to calculate week-2 retention rate and rank lowest → highest  
WITH cohort AS ( /* step 5 */ ),
     cohort_size AS (
        SELECT  "event_name",
                COUNT(DISTINCT "user_pseudo_id") AS cohort_users
        FROM    cohort
        GROUP  BY 1
     ),
     aug_sessions AS ( /* step 7 */ ),
     retained AS (
        SELECT  c."event_name",
                c."user_pseudo_id"
        FROM    cohort  c
        JOIN    aug_sessions s
              ON c."user_pseudo_id" = s."user_pseudo_id"
        WHERE   DATEDIFF('day', c.first_date, s.sess_dt) BETWEEN 8 AND 14
        GROUP  BY 1,2
     ),
     retained_cnt AS (
        SELECT  "event_name",
                COUNT(DISTINCT "user_pseudo_id") AS retained_users
        FROM    retained
        GROUP  BY 1
     )
SELECT  cs."event_name",
        cs.cohort_users,
        rc.retained_users,
        ROUND( rc.retained_users / cs.cohort_users , 4 ) AS week2_retention_rate
FROM    cohort_size  cs
LEFT  JOIN retained_cnt rc
       ON cs."event_name" = rc."event_name"
ORDER BY week2_retention_rate ASC
LIMIT 20;
```
