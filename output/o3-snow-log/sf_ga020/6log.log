    SELECT "user_pseudo_id", TO_DATE("event_date",'YYYYMMDD') FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180830" WHERE "event_name"='session_start' UNION ALL
    SELECT "user_pseudo_id", TO_DATE("event_date",'YYYYMMDD') FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180831" WHERE "event_name"='session_start'
), retained AS (         ----------------------------------------------------------- 4
    SELECT DISTINCT c."event_name",
           c."user_pseudo_id"
    FROM   cohort   c
    JOIN   sessions s
          ON c."user_pseudo_id" = s."user_pseudo_id"
    WHERE  DATEDIFF('day', c.first_date, s.sess_date) BETWEEN 8 AND 14
), cohort_size AS (      ----------------------------------------------------------- 5
    SELECT "event_name",
           COUNT(DISTINCT "user_pseudo_id") AS users_in_cohort
    FROM   cohort
    GROUP BY "event_name"
), retained_cnt AS (     ----------------------------------------------------------- 6
    SELECT "event_name",
           COUNT(DISTINCT "user_pseudo_id") AS users_retained
    FROM   retained
    GROUP BY "event_name"
)
SELECT cs."event_name",
       cs.users_in_cohort,
       COALESCE(rc.users_retained,0) AS users_retained,
       ROUND( COALESCE(rc.users_retained,0) / cs.users_in_cohort ,4) AS week2_retention_rate
FROM   cohort_size cs
LEFT   JOIN retained_cnt rc
       ON cs."event_name" = rc."event_name"
ORDER  BY week2_retention_rate ASC
LIMIT 20;
