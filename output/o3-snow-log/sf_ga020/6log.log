retained AS (                         -- 4. Session within 0-30 days of day-0
    SELECT DISTINCT c."event_name", c."user_pseudo_id"
    FROM   cohort   c
    JOIN   sessions s
      ON   c."user_pseudo_id" = s."user_pseudo_id"
    WHERE  DATEDIFF('day', c.first_date, s."sess_dt") BETWEEN 0 AND 30
)
SELECT  "event_name",
        COUNT(DISTINCT "user_pseudo_id") AS users_with_session_0_30d
FROM    retained
GROUP BY "event_name"
ORDER BY "event_name"
LIMIT 20;
