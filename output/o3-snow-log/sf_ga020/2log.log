    ORDER BY retained_users*1.0/NULLIF(cohort_users,0) ASC
    LIMIT 1
),
sample_users AS (
    SELECT q."user_pseudo_id", q."event_name", q."evt_d"
    FROM quickplay q
    JOIN retention r ON q."event_name" = r."first_q_type"
    QUALIFY ROW_NUMBER() OVER (PARTITION BY q."user_pseudo_id" ORDER BY q."evt_d") = 1   --keep first occurrence
)
SELECT * FROM sample_users
LIMIT 20
