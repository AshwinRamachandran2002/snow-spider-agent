--Description:  Compute 2-nd-week (days 8-14) retention for users whose very first
--               quick-play event occurred between 01-Aug-2018 and 15-Aug-2018.
-- Thinking in-line:
--   1. quickplay  – pull just the three columns we need (user, event_name, date)
--      from each daily table in the range 01-Aug-15-Aug and keep rows whose
--      name contains “quickplay”.  Selecting the same three columns in every
--      branch guarantees the UNION column counts match.
--   2. first_q    – for every (user, quick-play-type) pair, capture the earliest
--      date; that’s the user’s “cohort join” date for that type.
--   3. sessions   – gather session_start events from 16-Aug-29-Aug (this window
--      can be 8-14 days after any 01-15 Aug day).  Only two columns kept.
--   4. final      – for each quick-play type
--          • cohort_users   = # distinct users whose FIRST quick-play was that type
--          • retained_users = # of those users with ≥1 session_start 8-14 days later
--        and compute retention percentage; ordered from worst to best.

WITH quickplay AS (
      SELECT "user_pseudo_id","event_name",TO_DATE("event_date",'YYYYMMDD') AS "evt_d"
        FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180801" WHERE "event_name" ILIKE '%quickplay%'
