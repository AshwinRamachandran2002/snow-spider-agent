      UNION ALL SELECT "user_pseudo_id","event_timestamp","event_name" FROM FIREBASE.ANALYTICS_153293282.EVENTS_20180829
         )
    WHERE "event_name" = 'session_start'
),
retained AS (                           -- users returning in week-2
    SELECT DISTINCT l.user_id
    FROM   later_ss l
    JOIN   cohort   c
      ON   l.user_id = c.user_id
     AND   l.ts BETWEEN c.first_ts + 7*24*3600*1000000
                    AND c.first_ts +14*24*3600*1000000
),
metrics AS (                            -- retention per quick-play event
    SELECT  c.first_event,
            COUNT(DISTINCT c.user_id)          AS cohort_users,
            COUNT(DISTINCT r.user_id)          AS retained_users,
            CASE WHEN COUNT(DISTINCT c.user_id)=0
                 THEN 0
                 ELSE COUNT(DISTINCT r.user_id)::FLOAT
                      / COUNT(DISTINCT c.user_id)
            END                                AS retention_rate
    FROM    cohort c
    LEFT JOIN retained r ON r.user_id = c.user_id
    GROUP BY c.first_event
)
SELECT  first_event           AS lowest_retention_event,
        retention_rate        AS week2_retention_rate
FROM    metrics
ORDER BY retention_rate
LIMIT 1;
