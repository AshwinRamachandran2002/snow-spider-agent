      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180812" WHERE "event_name" ILIKE '%quickplay%' UNION ALL
    SELECT "user_pseudo_id","event_timestamp","event_name"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180813" WHERE "event_name" ILIKE '%quickplay%' UNION ALL
    SELECT "user_pseudo_id","event_timestamp","event_name"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180814" WHERE "event_name" ILIKE '%quickplay%' UNION ALL
    SELECT "user_pseudo_id","event_timestamp","event_name"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180815" WHERE "event_name" ILIKE '%quickplay%'
), first_event AS (  -- 2) earliest quick-play per user + its name
    WITH min_ts AS (
