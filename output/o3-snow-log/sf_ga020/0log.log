    SELECT "user_pseudo_id","event_timestamp"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180828" WHERE "event_name"='session_start' UNION ALL
    SELECT "user_pseudo_id","event_timestamp"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180829" WHERE "event_name"='session_start'
), retained AS (  -- 4) week-2 retained users
    SELECT DISTINCT f."user_pseudo_id"
    FROM first_event f
    JOIN week2_sessions s
      ON f."user_pseudo_id" = s."user_pseudo_id"
     AND s."event_timestamp" BETWEEN f.first_ts + 7*24*60*60*1000000    -- +7 days
                                 AND f.first_ts +14*24*60*60*1000000    -- +14 days
)
/* 5) final aggregation and answer */
SELECT f.first_quickplay_event,
       COUNT(DISTINCT f."user_pseudo_id") AS users_total,
       COUNT(DISTINCT r."user_pseudo_id") AS users_retained_week2,
       ROUND( COUNT(DISTINCT r."user_pseudo_id")::FLOAT
             / NULLIF(COUNT(DISTINCT f."user_pseudo_id"),0), 4) AS week2_retention_rate
FROM first_event f
LEFT JOIN retained r USING ("user_pseudo_id")
GROUP BY f.first_quickplay_event
ORDER BY week2_retention_rate ASC
LIMIT 1;
