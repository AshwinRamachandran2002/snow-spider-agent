--Description: 4)  For every user in that cohort, record their *earliest* quick-play timestamp and associated event type.  
WITH cohort AS (
    SELECT 
        "user_pseudo_id",
        MIN("event_timestamp") AS "first_ts"
    FROM (
        SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180801" UNION ALL
