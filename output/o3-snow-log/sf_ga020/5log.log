WITH summary AS (
    /*  Re-use aggregation from query #9  */
    WITH qp_first AS ( /* same CTE as above */ ),
         ss       AS ( /* same CTE as above */ )
    SELECT q."event_name",
           COUNT(*)                                     AS "users_total",
           SUM(CASE WHEN ss."ss_date" BETWEEN q."first_date"+8 AND q."first_date"+14 THEN 1 ELSE 0 END) AS "users_retained"
