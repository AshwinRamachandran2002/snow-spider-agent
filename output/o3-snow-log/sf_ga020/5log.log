        SELECT "user_pseudo_id","event_name","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180815"
    )
    WHERE "event_name" ILIKE '%quickplay%'
),
cohort AS (                         /* first calendar day the user fired that event */
