```sql
--Description: 10)  Calculate week-2 retention percentage for each quick-play event   
--                type and order them from lowest to highest (top 20 only).
WITH summary AS (
    /*  Re-use aggregation from query #9  */
    WITH qp_first AS ( /* same CTE as above */ ),
         ss       AS ( /* same CTE as above */ )
    SELECT q."event_name",
           COUNT(*)                                     AS "users_total",
           SUM(CASE WHEN ss."ss_date" BETWEEN q."first_date"+8 AND q."first_date"+14 THEN 1 ELSE 0 END) AS "users_retained"
    FROM qp_first q
    LEFT JOIN ss
      ON q."user_pseudo_id" = ss."user_pseudo_id"
    GROUP BY q."event_name"
)
SELECT "event_name",
       "users_total",
       "users_retained",
       ROUND( ("users_retained"::FLOAT) / NULLIF("users_total",0), 4) AS "retention_rate_week2"
FROM summary
ORDER BY "retention_rate_week2" ASC
LIMIT 20;
```
