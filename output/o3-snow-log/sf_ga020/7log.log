                 )
            WHERE "event_name" = 'session_start'
          ) s
      ON c."user_pseudo_id" = s."user_pseudo_id"
     AND (CAST(s."sess_date" AS INTEGER) - CAST(c."first_date_int" AS INTEGER)) BETWEEN 8 AND 14
),
worst_event AS (
    SELECT "first_event_type"
    FROM  (
            /* reuse result of Query-7 but without LIMIT to find worst rate */
            SELECT  c."first_event_type",
                    COUNT(DISTINCT r."user_pseudo_id")  AS ret,
                    COUNT(DISTINCT c."user_pseudo_id")  AS total,
                    COUNT(DISTINCT r."user_pseudo_id") / NULLIF(COUNT(DISTINCT c."user_pseudo_id"),0) AS rate
            FROM  cohort c
            LEFT JOIN week2_retained r
                   ON c."user_pseudo_id" = r."user_pseudo_id"
            GROUP BY c."first_event_type"
            ORDER BY rate ASC
            LIMIT 1
          )
)
SELECT  c."user_pseudo_id"
FROM    cohort c
LEFT JOIN week2_retained r
       ON c."user_pseudo_id" = r."user_pseudo_id"
JOIN    worst_event w
       ON c."first_event_type" = w."first_event_type"
WHERE   r."user_pseudo_id" IS NULL      -- those who churned
LIMIT   20;
