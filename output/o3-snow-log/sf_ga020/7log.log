        FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180804" WHERE "event_name" ILIKE '%quickplay%' UNION ALL
        SELECT "user_pseudo_id","event_name","event_date","event_timestamp"
        FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180805" WHERE "event_name" ILIKE '%quickplay%' UNION ALL
        SELECT "user_pseudo_id","event_name","event_date","event_timestamp"
