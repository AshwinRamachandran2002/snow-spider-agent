             UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180810"
             UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180811"
             UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180812"
