--Description:
-- Goal:  Find the quickplay event-type whose users are least likely to return in week-2
--        (days 8-14) after their very first quickplay interaction between 1-15 Aug 2018.
-- Logical steps, all performed inside one statement:
--   1) cohort   – build the cohort: for every user, record the date and type of their FIRST
--                 quickplay event in the 1-15 Aug window.
--   2) sessions – collect every “session_start” fired during August (we need up to 31-Aug so
--                 that all 8-14-day spans are covered).  Each UNION branch selects EXACTLY
--                 the same two columns to avoid “different column count” errors.
--   3) retained – users who have a session_start 8-14 days after their first quickplay.
--   4) final    – calculate retention-rate per quickplay type and return the worst one.
WITH cohort AS (   ------------------------------------------------ Step-1
    SELECT  "user_pseudo_id",
            MIN("event_date")                                         AS "first_date",
            MIN_BY("event_name","event_timestamp")                    AS "first_event_type"
    FROM  (  /* 1-15 Aug tables, identical column list in every UNION */
        SELECT "user_pseudo_id","event_name","event_date","event_timestamp"
        FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180801" WHERE "event_name" ILIKE '%quickplay%' UNION ALL
        SELECT "user_pseudo_id","event_name","event_date","event_timestamp"
        FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180802" WHERE "event_name" ILIKE '%quickplay%' UNION ALL
        SELECT "user_pseudo_id","event_name","event_date","event_timestamp"
        FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180803" WHERE "event_name" ILIKE '%quickplay%' UNION ALL
