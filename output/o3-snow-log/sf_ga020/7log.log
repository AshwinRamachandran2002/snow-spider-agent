             UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180802"
             UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180803"
             UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180804"
