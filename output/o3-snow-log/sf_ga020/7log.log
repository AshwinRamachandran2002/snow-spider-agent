     AND CAST(s."event_date" AS INTEGER) - CAST(c."first_date" AS INTEGER) BETWEEN 8 AND 14
),  
metrics AS (                    -- retention per quick-play type
    SELECT  c."first_event_type",
            COUNT(DISTINCT c."user_pseudo_id") AS cohort_users,
            COUNT(DISTINCT r."user_pseudo_id") AS retained_users,
            ROUND(
              COUNT(DISTINCT r."user_pseudo_id") /
              NULLIF(COUNT(DISTINCT c."user_pseudo_id"),0)
            ,4) AS retention_rate
      FROM  cohort c
 LEFT JOIN  retained r USING ("user_pseudo_id")
  GROUP BY  c."first_event_type"
)  
SELECT first_event_type      AS quickplay_event_type,
       cohort_users,
       retained_users,
       retention_rate
  FROM metrics
 ORDER BY retention_rate ASC
 LIMIT 20;
