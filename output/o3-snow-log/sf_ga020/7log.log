/* cohort: each user’s very first quickplay interaction (1-Aug → 15-Aug) */
cohort_raw AS (
    SELECT  "user_pseudo_id",
            "event_name"            AS first_event_type,
            TO_DATE("event_date",'YYYYMMDD') AS first_event_date,
            ROW_NUMBER() OVER (PARTITION BY "user_pseudo_id"
                               ORDER BY "event_timestamp")    AS rn
    FROM    all_aug_events
    WHERE   "event_name" ILIKE '%quickplay%'
      AND   TO_DATE("event_date",'YYYYMMDD')
            BETWEEN TO_DATE('2018-08-01') AND TO_DATE('2018-08-15')
),
cohort AS (
    SELECT  "user_pseudo_id",
            first_event_type,
            first_event_date
    FROM    cohort_raw
    WHERE   rn = 1                      -- keep the very first quickplay
),

/* all August session_start events (used to measure return behaviour) */
sessions AS (
    SELECT  "user_pseudo_id",
            TO_DATE("event_date",'YYYYMMDD') AS sess_date
    FROM    all_aug_events
    WHERE   "event_name" = 'session_start'
),

/* join cohort to session_start to flag 2nd-week return */
retention_calc AS (
    SELECT
        c.first_event_type,
        COUNT(DISTINCT c."user_pseudo_id")                              AS cohort_size,
        COUNT(DISTINCT CASE
                          WHEN s."user_pseudo_id" IS NOT NULL THEN c."user_pseudo_id"
                       END)                                             AS retained_users
    FROM        cohort   c
    LEFT JOIN   sessions s
           ON   s."user_pseudo_id" = c."user_pseudo_id"
          AND   s.sess_date BETWEEN DATEADD(day,7 ,c.first_event_date)
                               AND     DATEADD(day,14,c.first_event_date)
    GROUP BY    c.first_event_type
)

/* find the quickplay event type with the lowest 2nd-week retention */
SELECT  first_event_type,
        retained_users,
        cohort_size,
        retained_users::FLOAT / cohort_size AS retention_rate
FROM    retention_calc
ORDER BY retention_rate ASC NULLS LAST
LIMIT 1;
