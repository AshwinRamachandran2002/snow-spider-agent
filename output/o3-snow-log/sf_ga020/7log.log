--Description:
--  Build the 01-15 Aug-2018 quick-play cohorts, measure week-2 (8-14 day) retention
--  via “session_start”, then show the cohort with the LOWEST retention rate.
--  Logic inside CTEs:
--    1) quickplay_raw  – every quick-play event in the window (identical 4-column UNION).
--    2) cohort         – first quick-play per user (ROW_NUMBER) → first_event_type & first_date.
--    3) sessions_aug   – every August session_start (identical 2-column UNION).
--    4) retained       – users whose session_start fell 8-14 days after first_date.
--    5) metrics        – cohort_users, retained_users, retention_rate per event_type.
--  Final SELECT returns the single worst-retaining quick-play event type.

WITH quickplay_raw AS (
    SELECT "user_pseudo_id","event_name","event_date","event_timestamp"
    FROM  FIREBASE.ANALYTICS_153293282."EVENTS_20180801" WHERE "event_name" ILIKE '%quickplay%' UNION ALL
    SELECT "user_pseudo_id","event_name","event_date","event_timestamp"
