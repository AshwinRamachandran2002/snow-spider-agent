```sql
--Description: 9) For cohort users, compare their first observed event_date and first_touch_timestamp.  
WITH cohort AS (
      SELECT DISTINCT "user_pseudo_id"
      FROM (
            SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180702"
      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180703"
      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180704"
      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180705"
      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180706"
      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180707"
      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180708"
      )
      WHERE "event_name" = 'session_start'
)
SELECT c."user_pseudo_id",
       MIN(e."event_date")                 AS "first_event_date",
       MIN(e."user_first_touch_timestamp") AS "first_touch_ts"
FROM cohort c
JOIN "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180702" e
  ON c."user_pseudo_id" = e."user_pseudo_id"
GROUP BY c."user_pseudo_id"
LIMIT 20;
```

