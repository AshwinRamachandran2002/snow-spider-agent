      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180707"
      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180708"
      )
      WHERE "event_name" = 'session_start'
),
week1 AS (
      SELECT DISTINCT "user_pseudo_id"
      FROM (
            SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180709"
      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180710"
      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180711"
      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180712"
      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180713"
      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180714"
      UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180715"
      )
)
SELECT COUNT(*) AS "retained_week1"
