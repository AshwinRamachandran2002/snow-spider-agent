--Description: 9) Display Week-0 base (new users) alongside the 0-4 retention counts
WITH cohort_users AS (
     /* cohort build exactly as queries above */
     SELECT "user_pseudo_id"
     FROM (
           SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180702" WHERE "event_name"='session_start'
           UNION ALL SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180703" WHERE "event_name"='session_start'
           UNION ALL SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180704" WHERE "event_name"='session_start'
           UNION ALL SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180705" WHERE "event_name"='session_start'
           UNION ALL SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180706" WHERE "event_name"='session_start'
           UNION ALL SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180707" WHERE "event_name"='session_start'
           UNION ALL SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180708" WHERE "event_name"='session_start'
     ) GROUP BY "user_pseudo_id"
),
retention AS (
     SELECT  CASE 
               WHEN DATEDIFF('WEEK',TO_DATE('2018-07-02'),TO_DATE("event_date",'YYYYMMDD')) = 0 THEN 'Week_0'
               WHEN DATEDIFF('WEEK',TO_DATE('2018-07-02'),TO_DATE("event_date",'YYYYMMDD')) = 1 THEN 'Week_1'
               WHEN DATEDIFF('WEEK',TO_DATE('2018-07-02'),TO_DATE("event_date",'YYYYMMDD')) = 2 THEN 'Week_2'
               WHEN DATEDIFF('WEEK',TO_DATE('2018-07-02'),TO_DATE("event_date",'YYYYMMDD')) = 3 THEN 'Week_3'
               WHEN DATEDIFF('WEEK',TO_DATE('2018-07-02'),TO_DATE("event_date",'YYYYMMDD')) = 4 THEN 'Week_4'
             END                                                   AS "week_bucket",
             COUNT(DISTINCT "user_pseudo_id")                      AS "retained_users"
     FROM (
           /* union all tables Jul-02 → Oct-02 as in previous queries */
           SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180702"
           UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180703"
           -- …continue through 20181002
     ) e
     JOIN cohort_users c USING("user_pseudo_id")
     WHERE DATEDIFF('WEEK',TO_DATE('2018-07-02'), TO_DATE(e."event_date",'YYYYMMDD')) BETWEEN 0 AND 4
     GROUP BY 1
)
SELECT  r."week_bucket",
        CASE WHEN r."week_bucket" = 'Week_0' THEN COUNT(*) END AS "new_users_week0",
        r."retained_users"
FROM    retention r
LEFT JOIN cohort_users c ON r."week_bucket" = 'Week_0'          -- attach base size only once
GROUP BY r."week_bucket", r."retained_users"
ORDER BY r."week_bucket"
LIMIT 20;
