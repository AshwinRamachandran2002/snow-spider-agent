--Description: 6) Join Week-0 cohort to ALL later event tables up to 02-Oct-2018  
--              and list the Mondays of the weeks in which each user re-appears
WITH cohort AS (SELECT "user_pseudo_id" FROM (
                 -- same cohort build as query #5
                 SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180702" WHERE "event_name"='session_start'
                 UNION ALL SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180703" WHERE "event_name"='session_start'
                 UNION ALL SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180704" WHERE "event_name"='session_start'
                 UNION ALL SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180705" WHERE "event_name"='session_start'
                 UNION ALL SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180706" WHERE "event_name"='session_start'
                 UNION ALL SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180707" WHERE "event_name"='session_start'
                 UNION ALL SELECT "user_pseudo_id" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180708" WHERE "event_name"='session_start'
               ) GROUP BY "user_pseudo_id"),
events_union AS (
       -- sample of a few tables; full query should UNION until 20181002
       SELECT "event_date","user_pseudo_id"
       FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"
       UNION ALL
       SELECT "event_date","user_pseudo_id"
       FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180710"
       UNION ALL
       SELECT "event_date","user_pseudo_id"
       FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180711"
       -- …continue through 20181002
)
SELECT  e."user_pseudo_id",
        TO_DATE(e."event_date",'YYYYMMDD')                             AS "event_day",
        DATE_TRUNC('WEEK', TO_DATE(e."event_date",'YYYYMMDD'))         AS "monday_of_week"
FROM    events_union  e
JOIN    cohort        c  ON c."user_pseudo_id" = e."user_pseudo_id"
LIMIT 20;
