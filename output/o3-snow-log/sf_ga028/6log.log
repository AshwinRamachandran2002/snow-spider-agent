    SELECT "user_pseudo_id","event_name",TO_DATE("event_date",'YYYYMMDD') FROM FIREBASE.ANALYTICS_153293282."EVENTS_20181002"
),

first_sessions AS (           -- earliest session_start per user
    SELECT "user_pseudo_id",
           MIN(event_dt) AS first_session_date
    FROM all_events
    WHERE "event_name" = 'session_start'
    GROUP BY "user_pseudo_id"
),

week0_new_users AS (          -- users whose FIRST session was in week 0
    SELECT "user_pseudo_id"
    FROM first_sessions
    WHERE first_session_date BETWEEN '2018-07-02'::DATE AND '2018-07-08'::DATE
),

w1_events AS (SELECT DISTINCT "user_pseudo_id" FROM all_events WHERE event_dt BETWEEN '2018-07-09' AND '2018-07-15'),
w2_events AS (SELECT DISTINCT "user_pseudo_id" FROM all_events WHERE event_dt BETWEEN '2018-07-16' AND '2018-07-22'),
w3_events AS (SELECT DISTINCT "user_pseudo_id" FROM all_events WHERE event_dt BETWEEN '2018-07-23' AND '2018-07-29'),
w4_events AS (SELECT DISTINCT "user_pseudo_id" FROM all_events WHERE event_dt BETWEEN '2018-07-30' AND '2018-08-05')

SELECT 'Week 0 – New Users' AS week_label , COUNT(*) AS user_count
FROM   week0_new_users
UNION ALL
SELECT 'Week 1 – Retained'  , COUNT(*) FROM week0_new_users WHERE "user_pseudo_id" IN (SELECT "user_pseudo_id" FROM w1_events)
UNION ALL
SELECT 'Week 2 – Retained'  , COUNT(*) FROM week0_new_users WHERE "user_pseudo_id" IN (SELECT "user_pseudo_id" FROM w2_events)
UNION ALL
SELECT 'Week 3 – Retained'  , COUNT(*) FROM week0_new_users WHERE "user_pseudo_id" IN (SELECT "user_pseudo_id" FROM w3_events)
UNION ALL
SELECT 'Week 4 – Retained'  , COUNT(*) FROM week0_new_users WHERE "user_pseudo_id" IN (SELECT "user_pseudo_id" FROM w4_events)
;
