```sql
--Description: 7. Compute week index (0-4) for every return of cohort users (dates already strings ‘YYYYMMDD’)  
WITH cohort AS (
     SELECT "user_pseudo_id",
            MIN("event_date") AS "cohort_start"
     FROM (
           SELECT "user_pseudo_id","event_date"
           FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180702"
           WHERE "event_name" ILIKE '%session_start%'
          )
     GROUP BY "user_pseudo_id"
     HAVING "cohort_start" BETWEEN '20180702' AND '20180708'
),
visits AS (
     SELECT e."user_pseudo_id",
            e."event_date",
            cohort."cohort_start"
     FROM cohort
     JOIN "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180907" e
       ON e."user_pseudo_id" = cohort."user_pseudo_id"
     WHERE e."event_date" <= '20181002'
)
SELECT "user_pseudo_id",
       FLOOR( (TO_DATE("event_date",'YYYYMMDD') - TO_DATE("cohort_start",'YYYYMMDD')) / 7 ) AS "wk_index"
FROM visits
LIMIT 20;
```

```sql
--Description: 8. Aggregate retained users by week index (0-4)  
WITH cohort AS (
     SELECT "user_pseudo_id",
            MIN("event_date") AS "cohort_start"
     FROM (
           SELECT "user_pseudo_id","event_date"
           FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180702"
           WHERE "event_name" ILIKE '%session_start%'
          )
     GROUP BY "user_pseudo_id"
     HAVING "cohort_start" BETWEEN '20180702' AND '20180708'
),
alles AS (
     SELECT e."user_pseudo_id",
            e."event_date",
            cohort."cohort_start"
     FROM cohort
     JOIN (
            SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180726"
            UNION ALL
            SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180826"
            UNION ALL
            SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180925"
            UNION ALL
            SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20181002"
          ) e
       ON e."user_pseudo_id" = cohort."user_pseudo_id"
     WHERE e."event_date" <= '20181002'
)
SELECT FLOOR( (TO_DATE("event_date",'YYYYMMDD') 
               - TO_DATE("cohort_start",'YYYYMMDD')) / 7 ) AS "wk_index",
       COUNT(DISTINCT "user_pseudo_id")                      AS "retained_users"
FROM alles
GROUP BY "wk_index"
HAVING "wk_index" BETWEEN 0 AND 4
ORDER BY "wk_index"
LIMIT 20;
```

