    UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180826"
    UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180925"
    UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20181002"
),
ret AS (
