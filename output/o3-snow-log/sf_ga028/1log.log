--Description: 10. Final single-query cohort table: Week-0 new users and Week-1 .. Week-4 retained users (Monday-based)  
WITH cohort AS (
     SELECT "user_pseudo_id",
            MIN("event_date")                               AS "cohort_start"
     FROM (
           SELECT "user_pseudo_id","event_date"
           FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180702"
           WHERE "event_name" ILIKE '%session_start%'
           UNION ALL
           SELECT "user_pseudo_id","event_date"
           FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180703"
           WHERE "event_name" ILIKE '%session_start%'
           UNION ALL
           SELECT "user_pseudo_id","event_date"
           FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180704"
           WHERE "event_name" ILIKE '%session_start%'
           UNION ALL
           SELECT "user_pseudo_id","event_date"
           FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180705"
           WHERE "event_name" ILIKE '%session_start%'
           UNION ALL
           SELECT "user_pseudo_id","event_date"
           FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180706"
           WHERE "event_name" ILIKE '%session_start%'
           UNION ALL
           SELECT "user_pseudo_id","event_date"
           FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180707"
           WHERE "event_name" ILIKE '%session_start%'
           UNION ALL
           SELECT "user_pseudo_id","event_date"
           FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180708"
           WHERE "event_name" ILIKE '%session_start%'
          )
     GROUP BY "user_pseudo_id"
     HAVING "cohort_start" BETWEEN '20180702' AND '20180708'
),
events_all AS (
       SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180702"
 UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180726"
 UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180826"
 UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180925"
 UNION ALL SELECT * FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20181002"
),
ret AS (
     SELECT c."user_pseudo_id",
            FLOOR( (TO_DATE(e."event_date",'YYYYMMDD') 
                   - TO_DATE(c."cohort_start",'YYYYMMDD')) / 7 ) AS "wk_index"
     FROM cohort c
     JOIN events_all e
       ON e."user_pseudo_id" = c."user_pseudo_id"
     WHERE e."event_date" <= '20181002'
),
pivot AS (
     SELECT
         COUNT(DISTINCT CASE WHEN "wk_index" = 0 THEN "user_pseudo_id" END) AS "week_0_new_users",
         COUNT(DISTINCT CASE WHEN "wk_index" = 1 THEN "user_pseudo_id" END) AS "week_1_retained",
         COUNT(DISTINCT CASE WHEN "wk_index" = 2 THEN "user_pseudo_id" END) AS "week_2_retained",
         COUNT(DISTINCT CASE WHEN "wk_index" = 3 THEN "user_pseudo_id" END) AS "week_3_retained",
         COUNT(DISTINCT CASE WHEN "wk_index" = 4 THEN "user_pseudo_id" END) AS "week_4_retained"
     FROM ret
)
SELECT *
FROM pivot
LIMIT 20;
