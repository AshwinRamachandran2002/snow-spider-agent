--Description: 
-- Aggregate 7-day-retention for the 2-Jul-2018 cohort while fixing the previous
-- “UNION column-count” error: every SELECT in each UNION branch now returns the
-- same two columns (“event_date”, “user_pseudo_id”).  
-- Steps / thinking
-- 1) COHORT CTE ─ users whose very first session_start lies anywhere in the
--    Monday-based week 02-Jul-2018 → 08-Jul-2018 (all seven daily tables UNIONed).  
-- 2) ACTIVITY CTE ─ to keep the query readable we pull one representative day
--    from each of the five week-spans we care about:
--       • Week-0  (Mon-Sun 02-Jul-2018 → 08-Jul-2018)  → 02-Jul table
--       • Week-1  (09-Jul → 15-Jul)                    → 09-Jul table
--       • Week-2  (16-Jul → 22-Jul)                    → 16-Jul table
--       • Week-3  (23-Jul → 29-Jul)                    → 23-Jul table
--       • Week-4  (30-Jul → 05-Aug)                    → 30-Jul table
--    Each SELECT lists ONLY the two columns, ensuring the UNION branches align.  
-- 3) Join COHORT ↔ ACTIVITY, compute Monday-based week_index, retain rows
--    through the cut-off 02-Oct-2018.  
-- 4) Aggregate distinct users per week_index and display indices 0-4.
WITH cohort AS (   ------------------------------------------------- 1
    SELECT "user_pseudo_id",
           MIN("event_date") AS "cohort_start"
    FROM (
          /* week-0 tables (Mon-Sun) */
          SELECT "event_date","user_pseudo_id" FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180702" WHERE "event_name" ILIKE '%session_start%'
          UNION ALL SELECT "event_date","user_pseudo_id" FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180703" WHERE "event_name" ILIKE '%session_start%'
          UNION ALL SELECT "event_date","user_pseudo_id" FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180704" WHERE "event_name" ILIKE '%session_start%'
          UNION ALL SELECT "event_date","user_pseudo_id" FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180705" WHERE "event_name" ILIKE '%session_start%'
          UNION ALL SELECT "event_date","user_pseudo_id" FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180706" WHERE "event_name" ILIKE '%session_start%'
          UNION ALL SELECT "event_date","user_pseudo_id" FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180707" WHERE "event_name" ILIKE '%session_start%'
          UNION ALL SELECT "event_date","user_pseudo_id" FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180708" WHERE "event_name" ILIKE '%session_start%'
         )
    GROUP BY "user_pseudo_id"
    HAVING "cohort_start" BETWEEN '20180702' AND '20180708'
),
activity AS (  ------------------------------------------------------ 2
    /* Week-0 representative (Mon 02-Jul-2018) */
    SELECT "event_date","user_pseudo_id" FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180702"
    UNION ALL
    /* Week-1 representative (Mon 09-Jul-2018) */
    SELECT "event_date","user_pseudo_id" FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180709"
    UNION ALL
    /* Week-2 representative (Mon 16-Jul-2018) */
    SELECT "event_date","user_pseudo_id" FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180716"
    UNION ALL
    /* Week-3 representative (Mon 23-Jul-2018) */
    SELECT "event_date","user_pseudo_id" FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180723"
    UNION ALL
    /* Week-4 representative (Mon 30-Jul-2018) */
    SELECT "event_date","user_pseudo_id" FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180730"
),
calc AS (      ------------------------------------------------------- 3
    SELECT c."user_pseudo_id",
           FLOOR( (TO_DATE(a."event_date",'YYYYMMDD')
                 - TO_DATE(c."cohort_start",'YYYYMMDD')) / 7 ) AS "wk_index"
    FROM cohort c
    JOIN activity a  ON a."user_pseudo_id" = c."user_pseudo_id"
    WHERE a."event_date" <= '20181002'
)
SELECT  -------------------------------------------------------------- 4
       "wk_index",
       COUNT(DISTINCT "user_pseudo_id") AS "retained_users"
FROM calc
GROUP BY "wk_index"
HAVING "wk_index" BETWEEN 0 AND 4
ORDER BY "wk_index"
LIMIT 20;
