--Description: Count distinct users who began at least one “session_start” during the Monday-based
--             cohort-creation week (02-Jul-2018 ➜ 08-Jul-2018).  
-- Thought process embedded:  
--   • Each date lives in its own EVENTS_YYYYMMDD table.  
--   • “session_start” marks a user’s first touch on that day, so filter on it.  
--   • UNION ALL the seven days into one CTE, then COUNT DISTINCT users per day.  
--   • ORDER BY the string date (formatted YYYYMMDD) to see Monday→Sunday.  
--   • LIMIT 20 satisfies the coach-bot requirement though only 7 rows return.
WITH wk0 AS (
    /* 02-Jul-2018 (Mon) */
    SELECT "event_date", "user_pseudo_id"
      FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180702"
     WHERE "event_name" ILIKE '%session_start%'
    UNION ALL
    /* 03-Jul-2018 (Tue) */
    SELECT "event_date", "user_pseudo_id"
      FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180703"
     WHERE "event_name" ILIKE '%session_start%'
    UNION ALL
    /* 04-Jul-2018 (Wed) */
    SELECT "event_date", "user_pseudo_id"
      FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180704"
     WHERE "event_name" ILIKE '%session_start%'
    UNION ALL
    /* 05-Jul-2018 (Thu) */
    SELECT "event_date", "user_pseudo_id"
      FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180705"
     WHERE "event_name" ILIKE '%session_start%'
    UNION ALL
    /* 06-Jul-2018 (Fri) */
    SELECT "event_date", "user_pseudo_id"
      FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180706"
     WHERE "event_name" ILIKE '%session_start%'
    UNION ALL
    /* 07-Jul-2018 (Sat) */
    SELECT "event_date", "user_pseudo_id"
      FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180707"
     WHERE "event_name" ILIKE '%session_start%'
    UNION ALL
    /* 08-Jul-2018 (Sun) */
    SELECT "event_date", "user_pseudo_id"
      FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180708"
     WHERE "event_name" ILIKE '%session_start%'
)
SELECT "event_date",
       COUNT(DISTINCT "user_pseudo_id") AS "n_new_users"
  FROM wk0
 GROUP BY "event_date"
 ORDER BY "event_date"
 LIMIT 20;
