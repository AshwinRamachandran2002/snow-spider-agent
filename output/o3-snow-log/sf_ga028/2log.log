```sql
-- 4. Description:  Sample of flattened event_params to understand the JSON structure.
SELECT  t."event_name",
        f.value:"key"::STRING          AS "param_key",
        f.value:"value":"string_value" AS "param_string",
        f.value:"value":"int_value"    AS "param_int"
FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180702"  t,
     LATERAL FLATTEN(input => t."event_params") f
LIMIT 20;
```

```sql
-- 5. Description: First session date per user during the cohort-building week (Mon 02-Jul-2018 to Sun 08-Jul-2018).
WITH july_week0 AS (   -- union all seven daily tables for the week
      SELECT "user_pseudo_id","event_date"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180702"  WHERE "event_name" = 'session_start'
      UNION ALL
      SELECT "user_pseudo_id","event_date"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180703"  WHERE "event_name" = 'session_start'
      UNION ALL
      SELECT "user_pseudo_id","event_date"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180704"  WHERE "event_name" = 'session_start'
      UNION ALL
      SELECT "user_pseudo_id","event_date"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180705"  WHERE "event_name" = 'session_start'
      UNION ALL
      SELECT "user_pseudo_id","event_date"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180706"  WHERE "event_name" = 'session_start'
      UNION ALL
      SELECT "user_pseudo_id","event_date"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180707"  WHERE "event_name" = 'session_start'
      UNION ALL
      SELECT "user_pseudo_id","event_date"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180708"  WHERE "event_name" = 'session_start'
)
SELECT "user_pseudo_id",
       MIN("event_date") AS "first_session_date"
FROM july_week0
GROUP BY "user_pseudo_id"
LIMIT 20;
```

```sql
-- 6. Description:  Count of NEW users whose first session fell in the cohort week (Week-0).
WITH first_sessions AS (
      -- reuse the CTE from query 5
      SELECT "user_pseudo_id",
             MIN("event_date") AS "first_session_date"
      FROM  (
             SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180702" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180703" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180704" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180705" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180706" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180707" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180708" WHERE "event_name"='session_start'
      )
      GROUP BY "user_pseudo_id"
      HAVING MIN("event_date") BETWEEN '20180702' AND '20180708'
)
SELECT COUNT(*) AS "new_users_week0"
FROM first_sessions
LIMIT 20;
```

```sql
-- 7. Description:  Pull all events (up to 02-Oct-2018) for the cohort users so we can compute week offsets.
WITH cohort AS ( /* same definition as first_sessions above */
      SELECT "user_pseudo_id",
             MIN("event_date") AS "first_session_date"
      FROM  (
             SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180702" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180703" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180704" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180705" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180706" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180707" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180708" WHERE "event_name"='session_start'
      )
      GROUP BY "user_pseudo_id"
      HAVING MIN("event_date") BETWEEN '20180702' AND '20180708'
),
all_events AS (
      -- grab every daily table from 02-Jul-2018 through 02-Oct-2018 (partial sample below)
      SELECT "user_pseudo_id","event_date"
      FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180702"
      UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180703"
      UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180704"
      /* keep UNION-ing through EVENTS_20181002 */
)
SELECT  e."user_pseudo_id",
        e."event_date",
        c."first_session_date",
        FLOOR( DATEDIFF('day',
                         TO_DATE(c."first_session_date",'YYYYMMDD'),
                         TO_DATE(e."event_date",'YYYYMMDD') ) / 7 )  AS "week_offset"
FROM    all_events e
JOIN    cohort     c
   ON   e."user_pseudo_id" = c."user_pseudo_id"
WHERE   e."event_date" <= '20181002'      -- cut-off
LIMIT 20;
```

```sql
-- 8. Description:  Weekly retention status (user-level) – who came back in weeks 0-4.
WITH user_weeks AS ( /* use query 7 logic but keep only relevant weeks */
       SELECT  DISTINCT
               "user_pseudo_id",
               CASE
                   WHEN week_offset BETWEEN 0 AND 4 THEN week_offset
               END AS "week_offset"
       FROM (
               /* put query 7’s SELECT body here without LIMIT */
            )
       WHERE week_offset BETWEEN 0 AND 4
)
SELECT *
FROM user_weeks
ORDER BY "user_pseudo_id","week_offset"
LIMIT 20;
```

```sql
-- 9. Description:  Aggregate counts – total new users (week 0) and retained users by week.
WITH cohort_size AS (
      SELECT COUNT(DISTINCT "user_pseudo_id") AS "week0_new_users"
      FROM   (
               /* same cohort CTE used earlier */
             )
),
weekly_retention AS (
      SELECT  "week_offset",
              COUNT(DISTINCT "user_pseudo_id") AS "retained_users"
      FROM    (
                /* user_weeks sub-query from query 8 */
              )
      GROUP BY "week_offset"
)
SELECT  w."week_offset",
        c."week0_new_users",
        w."retained_users"
FROM    weekly_retention w
CROSS JOIN cohort_size c
WHERE   w."week_offset" BETWEEN 0 AND 4
ORDER BY w."week_offset"
LIMIT 20;
```

```sql
--10. Description:  Same as query 9 but pivoted wide for a one-row cohort table (Week-0 through Week-4).
WITH weekly AS ( /* reuse weekly_retention CTE from query 9 */
      SELECT  "week_offset",
              COUNT(DISTINCT "user_pseudo_id") AS "retained"
      FROM   (
               /* user_weeks logic */
             )
      WHERE  "week_offset" BETWEEN 0 AND 4
      GROUP BY "week_offset"
),
cohort AS ( SELECT COUNT(DISTINCT "user_pseudo_id") AS "week0_users"
            FROM   (
                     /* cohort definition */
                   )
)
SELECT
       c."week0_users",
       MAX(CASE WHEN w."week_offset" = 1 THEN w."retained" END) AS "week1_retained",
       MAX(CASE WHEN w."week_offset" = 2 THEN w."retained" END) AS "week2_retained",
       MAX(CASE WHEN w."week_offset" = 3 THEN w."retained" END) AS "week3_retained",
       MAX(CASE WHEN w."week_offset" = 4 THEN w."retained" END) AS "week4_retained"
FROM cohort  c
LEFT JOIN weekly w  ON 1=1
GROUP BY c."week0_users"
LIMIT 20;
```

Each successive query moves from simple exploration toward the complete 7-day retention calculation (Week-0 through Week-4) while keeping a 20-row limit for safety.
