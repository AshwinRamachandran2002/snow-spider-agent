user_weeks AS (  -- Step-3: distinct (user, week_offset) for offsets 0-4
    SELECT DISTINCT
           e."user_pseudo_id",
           FLOOR(
               DATEDIFF('day',
                        TO_DATE(c."first_session_date",'YYYYMMDD'),
                        TO_DATE(e."event_date",'YYYYMMDD')
               ) / 7
           ) AS "week_offset"
    FROM all_events e
    JOIN cohort    c ON e."user_pseudo_id" = c."user_pseudo_id"
    WHERE e."event_date" <= '20181002'
      AND FLOOR(
            DATEDIFF('day',
                     TO_DATE(c."first_session_date",'YYYYMMDD'),
                     TO_DATE(e."event_date",'YYYYMMDD')
            ) / 7
          ) BETWEEN 0 AND 4
),
weekly_counts AS (  -- Step-4: how many users active in each week
    SELECT "week_offset",
           COUNT(DISTINCT "user_pseudo_id") AS "retained_users"
    FROM user_weeks
    GROUP BY "week_offset"
),
cohort_size AS ( SELECT COUNT(*) AS "week0_users" FROM cohort )
-- Step-5: final wide table
SELECT
    c."week0_users",
    MAX(CASE WHEN w."week_offset" = 1 THEN w."retained_users" END) AS "week1_retained",
    MAX(CASE WHEN w."week_offset" = 2 THEN w."retained_users" END) AS "week2_retained",
    MAX(CASE WHEN w."week_offset" = 3 THEN w."retained_users" END) AS "week3_retained",
    MAX(CASE WHEN w."week_offset" = 4 THEN w."retained_users" END) AS "week4_retained"
FROM cohort_size c
LEFT JOIN weekly_counts w ON 1=1
GROUP BY c."week0_users"
LIMIT 20;
