-- 6. Description:  Count of NEW users whose first session fell in the cohort week (Week-0).
WITH first_sessions AS (
      -- reuse the CTE from query 5
      SELECT "user_pseudo_id",
             MIN("event_date") AS "first_session_date"
      FROM  (
             SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180702" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180703" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180704" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180705" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180706" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180707" WHERE "event_name"='session_start'
             UNION ALL SELECT "user_pseudo_id","event_date" FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180708" WHERE "event_name"='session_start'
      )
      GROUP BY "user_pseudo_id"
      HAVING MIN("event_date") BETWEEN '20180702' AND '20180708'
)
SELECT COUNT(*) AS "new_users_week0"
FROM first_sessions
LIMIT 20;
