```sql
--Description: Skeleton of a single query that produces Week-0 to Week-4 retention (capped 2-Oct-2018); truncated to 20 rows  
WITH week0 AS (  --identify first-session users during 2-Jul-2018 week
      SELECT DISTINCT "user_pseudo_id"
      FROM   (
                SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180702"
      UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180703"
      UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180704"
      UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180705"
      UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180706"
      UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180707"
      UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180708"
              )
      WHERE  "event_name" ILIKE '%session%start%'
),
events_all AS (  --all session_start events up through 2-Oct-2018
      SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180709"  --Week1
 UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180716" --Week2
 UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180723" --Week3
 UNION ALL SELECT * FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180730" --Week4
)
SELECT 0 AS "week_num", (SELECT COUNT(*) FROM week0) AS "users"
UNION ALL
SELECT 1, COUNT(DISTINCT "user_pseudo_id") FROM events_all WHERE "event_date" BETWEEN '20180709' AND '20180715' AND "event_name" ILIKE '%session%start%' AND "user_pseudo_id" IN (SELECT * FROM week0)
UNION ALL
SELECT 2, COUNT(DISTINCT "user_pseudo_id") FROM events_all WHERE "event_date" BETWEEN '20180716' AND '20180722' AND "event_name" ILIKE '%session%start%' AND "user_pseudo_id" IN (SELECT * FROM week0)
UNION ALL
SELECT 3, COUNT(DISTINCT "user_pseudo_id") FROM events_all WHERE "event_date" BETWEEN '20180723' AND '20180729' AND "event_name" ILIKE '%session%start%' AND "user_pseudo_id" IN (SELECT * FROM week0)
UNION ALL
SELECT 4, COUNT(DISTINCT "user_pseudo_id") FROM events_all WHERE "event_date" BETWEEN '20180730' AND '20180805' AND "event_name" ILIKE '%session%start%' AND "user_pseudo_id" IN (SELECT * FROM week0)
LIMIT 20;
```
