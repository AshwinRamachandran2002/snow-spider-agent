--Description: 10)  Consolidated view with genotype counts, expectations, χ² and allele frequencies
WITH genotype_ct AS (
    SELECT
        v."reference_name",
        v."start",
        v."end",
        v."reference_bases",
        v."alternate_bases",
        v."VT",
        SUM(CASE WHEN f.value:"genotype"[0]::INT = 0
                  AND f.value:"genotype"[1]::INT = 0 THEN 1 ELSE 0 END) AS "hom_ref",
        SUM(CASE WHEN f.value:"genotype"[0]::INT != f.value:"genotype"[1]::INT THEN 1 ELSE 0 END) AS "het",
        SUM(CASE WHEN f.value:"genotype"[0]::INT = 1
                  AND f.value:"genotype"[1]::INT = 1 THEN 1 ELSE 0 END) AS "hom_alt",
        COUNT(*)                                                                                   AS "n"
    FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
         LATERAL FLATTEN(input => v."call") f
    WHERE v."reference_name" = '17'
      AND v."start" BETWEEN 41196311 AND 41277499
    GROUP BY v."reference_name", v."start", v."end",
             v."reference_bases", v."alternate_bases", v."VT"
),
calc AS (
    SELECT
        *,
        (2*"hom_alt" + "het")/(2.0*"n")             AS "q",   -- alt-allele freq
        1 - ( (2*"hom_alt" + "het")/(2.0*"n") )     AS "p"    -- ref-allele freq
    FROM genotype_ct
),
final AS (
    SELECT
        "reference_name",
        "start",
        "end",
        "reference_bases",
        "alternate_bases",
        "VT",
        "n"                                            AS "total_genotypes",
        "hom_ref",
        "het",
        "hom_alt",
        /* expected counts */
        "n"*POWER("p",2)                               AS "exp_hom_ref",
        "n"*2*"p"*"q"                                  AS "exp_het",
        "n"*POWER("q",2)                               AS "exp_hom_alt",
        /* χ² */
        POWER("hom_ref" - "n"*POWER("p",2),2)/NULLIF("n"*POWER("p",2),0)
      + POWER("het"     - "n"*2*"p"*"q",2)/NULLIF("n"*2*"p"*"q",0)
      + POWER("hom_alt" - "n"*POWER("q",2),2)/NULLIF("n"*POWER("q",2),0)  AS "chi_sq",
        "p"                                            AS "ref_AF",
        "q"                                            AS "alt_AF"
    FROM calc
)
SELECT *
FROM final
ORDER BY "start"
LIMIT 20
