```sql
--Description:
-- Single-query solution that delivers, for every variant on chromosome 17 between
-- positions 41 196 311 and 41 277 499, the reference / alternate information, variant
-- type, observed genotype counts, Hardy-Weinberg expected counts, χ² statistic,
-- sample-derived allele frequencies and the pre-computed 1000 Genomes continental
-- allele frequencies.  The query works by
--   1) flattening the nested “call” array so each row is one sample genotype,
--   2) classifying that genotype as hom-ref, het, or hom-alt,
--   3) aggregating those counts per variant,
--   4) deriving allele frequencies (p & q), H-W expectations, and χ².
WITH genotype_counts AS (
    SELECT
        v."reference_name",
        v."start",
        v."end",
        v."reference_bases",
        v."alternate_bases",
        v."VT",
        v."AF",        -- total AF provided by 1KG
        v."AFR_AF",
        v."EUR_AF",
        v."AMR_AF",
        v."ASN_AF",
        /* observed counts */
        SUM(
            CASE
                WHEN f.value:"genotype"[0]::INT = 0
                 AND f.value:"genotype"[1]::INT = 0
                THEN 1 ELSE 0
            END
        ) AS "hom_ref",
        SUM(
            CASE
                WHEN f.value:"genotype"[0]::INT != f.value:"genotype"[1]::INT
                THEN 1 ELSE 0
            END
        ) AS "het",
        SUM(
            CASE
                WHEN f.value:"genotype"[0]::INT = 1
                 AND f.value:"genotype"[1]::INT = 1
                THEN 1 ELSE 0
            END
        ) AS "hom_alt"
    FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
         LATERAL FLATTEN( INPUT => v."call" ) f
    WHERE v."reference_name" = '17'
      AND v."start" BETWEEN 41196311 AND 41277499
    GROUP BY v."reference_name", v."start", v."end",
             v."reference_bases", v."alternate_bases", v."VT",
             v."AF", v."AFR_AF", v."EUR_AF", v."AMR_AF", v."ASN_AF"
)
SELECT
    "reference_name",
    "start",
    "end",
    "reference_bases",
    "alternate_bases",
    "VT",
    /* observed genotype counts */
    "hom_ref",
    "het",
    "hom_alt",
    /* total genotypes */
    "hom_ref" + "het" + "hom_alt"                                                   AS "n_genotypes",
    /* sample-derived allele freqs */
    1 - ( (2*"hom_alt" + "het") / (2.0*("hom_ref" + "het" + "hom_alt")) )           AS "ref_AF",
    (2*"hom_alt" + "het")      / (2.0*("hom_ref" + "het" + "hom_alt"))              AS "alt_AF",
    /* Hardy-Weinberg expected counts */
    ("hom_ref" + "het" + "hom_alt") * POWER( 1 - ( (2*"hom_alt" + "het") /
                                                   (2.0*("hom_ref" + "het" + "hom_alt")) )
                                            , 2 )                                   AS "exp_hom_ref",
    ("hom_ref" + "het" + "hom_alt") * 2 * ( (2*"hom_alt" + "het") /
                                            (2.0*("hom_ref" + "het" + "hom_alt")) ) *
                                          ( 1 - ( (2*"hom_alt" + "het") /
                                                  (2.0*("hom_ref" + "het" + "hom_alt")) ) )
                                                                                   AS "exp_het",
    ("hom_ref" + "het" + "hom_alt") * POWER( (2*"hom_alt" + "het") /
                                             (2.0*("hom_ref" + "het" + "hom_alt"))
                                            , 2 )                                   AS "exp_hom_alt",
    /* χ² statistic:  Σ (obs − exp)² / exp */
    POWER( "hom_ref" - ( ("hom_ref" + "het" + "hom_alt") *
                          POWER( 1 - ( (2*"hom_alt" + "het") /
                                       (2.0*("hom_ref" + "het" + "hom_alt")) ), 2 ) )
         , 2 ) /
      NULLIF( ( ("hom_ref" + "het" + "hom_alt") *
                POWER( 1 - ( (2*"hom_alt" + "het") /
                             (2.0*("hom_ref" + "het" + "hom_alt")) ), 2 ) ), 0 )
    +
    POWER( "het" - ( ("hom_ref" + "het" + "hom_alt") * 2 *
                     ( (2*"hom_alt" + "het") /
                       (2.0*("hom_ref" + "het" + "hom_alt")) ) *
                     ( 1 - ( (2*"hom_alt" + "het") /
                             (2.0*("hom_ref" + "het" + "hom_alt")) ) ) )
         , 2 ) /
      NULLIF( ( ("hom_ref" + "het" + "hom_alt") * 2 *
               ( (2*"hom_alt" + "het") /
                 (2.0*("hom_ref" + "het" + "hom_alt")) ) *
               ( 1 - ( (2*"hom_alt" + "het") /
                       (2.0*("hom_ref" + "het" + "hom_alt")) ) ) ), 0 )
    +
    POWER( "hom_alt" - ( ("hom_ref" + "het" + "hom_alt") *
                         POWER( (2*"hom_alt" + "het") /
                                (2.0*("hom_ref" + "het" + "hom_alt")), 2 ) )
         , 2 ) /
      NULLIF( ( ("hom_ref" + "het" + "hom_alt") *
                POWER( (2*"hom_alt" + "het") /
                       (2.0*("hom_ref" + "het" + "hom_alt")), 2 ) ), 0 )
                                                                                   AS "chi_sq",
    /* 1000 Genomes pre-computed allele frequencies for comparison */
    "AF"       AS "AF_total_1KG",
    "AFR_AF",
    "EUR_AF",
    "AMR_AF",
    "ASN_AF"
FROM genotype_counts
ORDER BY "start"
LIMIT 20;
