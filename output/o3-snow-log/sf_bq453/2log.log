-- type, observed genotype counts, Hardy-Weinberg expected counts, χ² statistic,
-- sample-derived allele frequencies and the pre-computed 1000 Genomes continental
-- allele frequencies.  The query works by
--   1) flattening the nested “call” array so each row is one sample genotype,
--   2) classifying that genotype as hom-ref, het, or hom-alt,
--   3) aggregating those counts per variant,
--   4) deriving allele frequencies (p & q), H-W expectations, and χ².
WITH genotype_counts AS (
    SELECT
        v."reference_name",
        v."start",
        v."end",
        v."reference_bases",
        v."alternate_bases",
