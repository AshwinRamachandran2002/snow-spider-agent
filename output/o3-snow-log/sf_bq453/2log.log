```sql
--Description: 6)  Aggregate observed genotype counts (hom-ref / het / hom-alt) per variant  
SELECT v."reference_name",
       v."start",
       SUM( CASE WHEN f.value:"genotype"[0]::INT = 0 AND f.value:"genotype"[1]::INT = 0 THEN 1 ELSE 0 END ) AS "obs_hom_ref",
       SUM( CASE WHEN f.value:"genotype"[0]::INT = 0 AND f.value:"genotype"[1]::INT = 1 
                  OR  f.value:"genotype"[0]::INT = 1 AND f.value:"genotype"[1]::INT = 0 THEN 1 ELSE 0 END ) AS "obs_het",
       SUM( CASE WHEN f.value:"genotype"[0]::INT = 1 AND f.value:"genotype"[1]::INT = 1 THEN 1 ELSE 0 END ) AS "obs_hom_alt"
FROM   "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN( INPUT => v."call" )        f
WHERE  v."reference_name" = '17'
  AND  v."start" BETWEEN 41196311 AND 41277499
GROUP BY v."reference_name", v."start"
LIMIT 20;
```

```sql
--Description: 7)  Add total genotype count and derived allele counts / allele frequency (p & q)  
WITH g AS (
   SELECT v."reference_name",
          v."start",
          SUM( CASE WHEN f.value:"genotype"[0]::INT = 0 AND f.value:"genotype"[1]::INT = 0 THEN 1 ELSE 0 END ) AS hom_ref,
          SUM( CASE WHEN f.value:"genotype"[0]::INT != f.value:"genotype"[1]::INT                     THEN 1 ELSE 0 END ) AS het,
          SUM( CASE WHEN f.value:"genotype"[0]::INT = 1 AND f.value:"genotype"[1]::INT = 1 THEN 1 ELSE 0 END ) AS hom_alt
   FROM   "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
          LATERAL FLATTEN( INPUT => v."call" )        f
   WHERE  v."reference_name" = '17'
     AND  v."start" BETWEEN 41196311 AND 41277499
   GROUP BY v."reference_name", v."start"
)
SELECT reference_name,
       start,
       hom_ref + het + hom_alt                             AS "n_genotypes",
       hom_ref,
       het,
       hom_alt,
       2*hom_ref + het                                     AS "ref_allele_count",
       2*hom_alt + het                                     AS "alt_allele_count",
       (2*hom_alt + het) / (2.0*(hom_ref + het + hom_alt)) AS "alt_AF"
FROM   g
LIMIT 20;
```

```sql
--Description: 8)  Compute Hardy-Weinberg expected counts & Chi-square statistic for each variant  
WITH g AS (
   SELECT v."reference_name",
          v."start",
          v."end",
          v."reference_bases",
          v."alternate_bases",
          SUM( CASE WHEN f.value:"genotype"[0]::INT = 0 AND f.value:"genotype"[1]::INT = 0 THEN 1 ELSE 0 END ) AS hom_ref,
          SUM( CASE WHEN f.value:"genotype"[0]::INT != f.value:"genotype"[1]::INT                     THEN 1 ELSE 0 END ) AS het,
          SUM( CASE WHEN f.value:"genotype"[0]::INT = 1 AND f.value:"genotype"[1]::INT = 1 THEN 1 ELSE 0 END ) AS hom_alt
   FROM   "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
          LATERAL FLATTEN( INPUT => v."call" )        f
   WHERE  v."reference_name" = '17'
     AND  v."start" BETWEEN 41196311 AND 41277499
   GROUP BY v."reference_name", v."start", v."end", v."reference_bases", v."alternate_bases"
)
SELECT reference_name,
       start,
       end,
       reference_bases,
       alternate_bases,
       hom_ref,
       het,
       hom_alt,
       hom_ref + het + hom_alt                                                  AS "n",
       (2*hom_ref + het)  /(2.0*(hom_ref + het + hom_alt))                      AS "p_ref",
       (2*hom_alt + het) /(2.0*(hom_ref + het + hom_alt))                       AS "q_alt",
       (hom_ref + het + hom_alt) * POWER( (2*hom_ref + het)/(2.0*(hom_ref + het + hom_alt)) ,2) AS "exp_hom_ref",
       (hom_ref + het + hom_alt) * 2*( (2*hom_ref + het)/(2.0*(hom_ref + het + hom_alt)) )*
                                      ( (2*hom_alt + het)/(2.0*(hom_ref + het + hom_alt)) )     AS "exp_het",
       (hom_ref + het + hom_alt) * POWER( (2*hom_alt + het)/(2.0*(hom_ref + het + hom_alt)) ,2) AS "exp_hom_alt",
       /* Chi-square = Σ (obs-exp)^2 / exp */
       POWER(hom_ref - ( (hom_ref + het + hom_alt) * POWER( (2*hom_ref + het)/(2.0*(hom_ref + het + hom_alt)) ,2) ),2)/
         NULLIF( ( (hom_ref + het + hom_alt) * POWER( (2*hom_ref + het)/(2.0*(hom_ref + het + hom_alt)) ,2) ),0)
       +
       POWER(het - ( (hom_ref + het + hom_alt) * 2*( (2*hom_ref + het)/(2.0*(hom_ref + het + hom_alt)) )*
                                            ( (2*hom_alt + het)/(2.0*(hom_ref + het + hom_alt)) ) ),2)/
         NULLIF( ( (hom_ref + het + hom_alt) * 2*( (2*hom_ref + het)/(2.0*(hom_ref + het + hom_alt)) )*
                                            ( (2*hom_alt + het)/(2.0*(hom_ref + het + hom_alt)) ) ),0)
       +
       POWER(hom_alt - ( (hom_ref + het + hom_alt) * POWER( (2*hom_alt + het)/(2.0*(hom_ref + het + hom_alt)) ,2) ),2)/
         NULLIF( ( (hom_ref + het + hom_alt) * POWER( (2*hom_alt + het)/(2.0*(hom_ref + het + hom_alt)) ,2) ),0)
       AS "chi_sq"
FROM   g
LIMIT 20;
```

```sql
--Description: 9)  Join the calculated Chi-square back to the VARIANTS table to also include VT & existing HWE score  
WITH calc AS (
   /* reuse the Chi-square calculation from Query 8 but keep minimal columns */
   SELECT reference_name,
          start,
          -- Chi-square statistic as “chi_sq”
          POWER(SUM( CASE WHEN f.value:"genotype"[0]::INT = 0 AND f.value:"genotype"[1]::INT = 0 THEN 1 ELSE 0 END )
                - (cnt * POWER(p,2)),2)/(cnt*POWER(p,2))
          + POWER(SUM( CASE WHEN f.value:"genotype"[0]::INT != f.value:"genotype"[1]::INT THEN 1 ELSE 0 END )
                - (cnt * 2*p*q),2)/(cnt*2*p*q)
          + POWER(SUM( CASE WHEN f.value:"genotype"[0]::INT = 1 AND f.value:"genotype"[1]::INT = 1 THEN 1 ELSE 0 END )
                - (cnt * POWER(q,2)),2)/(cnt*POWER(q,2))      AS chi_sq
   FROM (
        SELECT v."reference_name",
               v."start",
               v."end",
               f.value:"genotype"[0]::INT AS a1,
               f.value:"genotype"[1]::INT AS a2
        FROM   "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
               LATERAL FLATTEN( INPUT => v."call" ) f
        WHERE  v."reference_name" = '17'
          AND  v."start" BETWEEN 41196311 AND 41277499
   ) s,
   LATERAL (
        SELECT COUNT(*)                                   AS cnt,
               (2*SUM(CASE WHEN a1 = 1 THEN 1 ELSE 0 END)
              + 2*SUM(CASE WHEN a2 = 1 THEN 1 ELSE 0 END)) / (2.0*COUNT(*)) AS q,
               1 - ( (2*SUM(CASE WHEN a1 = 1 THEN 1 ELSE 0 END)
                    + 2*SUM(CASE WHEN a2 = 1 THEN 1 ELSE 0 END)) / (2.0*COUNT(*)) )      AS p
   ) x
   GROUP BY reference_name, start, cnt, p, q
)
SELECT v."reference_name",
       v."start",
       v."end",
       v."reference_bases",
       v."alternate_bases",
       v."VT",
       v."HWE"                 AS "HWE_precomputed",
       c."chi_sq"              AS "chi_sq_recalc"
FROM   "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v
JOIN   calc  c
  ON   v."reference_name" = c."reference_name"
 AND   v."start"          = c."start"
WHERE  v."reference_name" = '17'
  AND  v."start" BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
--Description: 10)  Final consolidated view – every requested field ready for downstream export/report  
WITH genotype_ct AS (
   SELECT v."reference_name",
          v."start",
          v."end",
          v."reference_bases",
          v."alternate_bases",
          v."VT",
          /* observed genotype categories */
          SUM( CASE WHEN f.value:"genotype"[0]::INT = 0 AND f.value:"genotype"[1]::INT = 0 THEN 1 ELSE 0 END ) AS hom_ref,
          SUM( CASE WHEN f.value:"genotype"[0]::INT != f.value:"genotype"[1]::INT                     THEN 1 ELSE 0 END ) AS het,
          SUM( CASE WHEN f.value:"genotype"[0]::INT = 1 AND f.value:"genotype"[1]::INT = 1 THEN 1 ELSE 0 END ) AS hom_alt,
          COUNT(*)                                                                                           AS n
   FROM   "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
          LATERAL FLATTEN( INPUT => v."call" ) f
   WHERE  v."reference_name" = '17'
     AND  v."start" BETWEEN 41196311 AND 41277499
   GROUP BY v."reference_name", v."start", v."end", v."reference_bases",
            v."alternate_bases", v."VT"
),
chi_calc AS (
   SELECT *,
          (2*hom_alt + het) /(2.0*n)                     AS q,        -- alt allele freq
          1 - ( (2*hom_alt + het) /(2.0*n) )             AS p,        -- ref allele freq
          /* H-W expected numbers */
          n * POWER( 1 - ( (2*hom_alt + het)/(2.0*n) ),2 )            AS exp_hom_ref,
          n * 2*( (2*hom_alt + het)/(2.0*n) )*
                ( 1 - ( (2*hom_alt + het)/(2.0*n) ) )                 AS exp_het,
          n * POWER( (2*hom_alt + het)/(2.0*n), 2 )                   AS exp_hom_alt
   FROM genotype_ct
),
final AS (
   SELECT reference_name,
          start,
          end,
          reference_bases,
          alternate_bases,
          VT,
          n                                        AS total_genotypes,
          hom_ref,
          het,
          hom_alt,
          exp_hom_ref,
          exp_het,
          exp_hom_alt,
          /* Chi-square */
          POWER(hom_ref - exp_hom_ref,2)/NULLIF(exp_hom_ref,0) +
          POWER(het     - exp_het    ,2)/NULLIF(exp_het    ,0) +
          POWER(hom_alt - exp_hom_alt,2)/NULLIF(exp_hom_alt,0)   AS chi_sq,
          /* Report allele freqs */
          p                                        AS ref_AF,
          q                                        AS alt_AF
   FROM chi_calc
)
SELECT *
FROM   final
LIMIT 20;
```
