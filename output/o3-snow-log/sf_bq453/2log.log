--Description: 8)  Compute Hardy-Weinberg expected counts and χ² statistic for each variant
WITH g AS (
    SELECT
        v."reference_name",
        v."start",
        v."end",
        v."reference_bases",
        v."alternate_bases",
        SUM(CASE WHEN f.value:"genotype"[0]::INT = 0
                  AND f.value:"genotype"[1]::INT = 0 THEN 1 ELSE 0 END) AS "hom_ref",
        SUM(CASE WHEN f.value:"genotype"[0]::INT != f.value:"genotype"[1]::INT THEN 1 ELSE 0 END) AS "het",
        SUM(CASE WHEN f.value:"genotype"[0]::INT = 1
                  AND f.value:"genotype"[1]::INT = 1 THEN 1 ELSE 0 END) AS "hom_alt"
    FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
         LATERAL FLATTEN(input => v."call") f
    WHERE v."reference_name" = '17'
      AND v."start" BETWEEN 41196311 AND 41277499
    GROUP BY v."reference_name", v."start", v."end",
             v."reference_bases", v."alternate_bases"
)
SELECT
    "reference_name",
    "start",
    "end",
    "reference_bases",
    "alternate_bases",
    "hom_ref",
    "het",
    "hom_alt",
    "hom_ref" + "het" + "hom_alt"                                             AS "n",
    (2*"hom_ref" + "het")/(2.0*("hom_ref" + "het" + "hom_alt"))              AS "p_ref",
    (2*"hom_alt" + "het")/(2.0*("hom_ref" + "het" + "hom_alt"))              AS "q_alt",
    ("hom_ref" + "het" + "hom_alt")*POWER((2*"hom_ref" + "het")/
        (2.0*("hom_ref" + "het" + "hom_alt")),2)                             AS "exp_hom_ref",
    ("hom_ref" + "het" + "hom_alt")*2*( (2*"hom_ref" + "het")/
        (2.0*("hom_ref" + "het" + "hom_alt")) )*
        ( (2*"hom_alt" + "het")/(2.0*("hom_ref" + "het" + "hom_alt")) )       AS "exp_het",
    ("hom_ref" + "het" + "hom_alt")*POWER((2*"hom_alt" + "het")/
        (2.0*("hom_ref" + "het" + "hom_alt")),2)                             AS "exp_hom_alt",
    /* χ² statistic */
    POWER("hom_ref" - (("hom_ref" + "het" + "hom_alt")*POWER((2*"hom_ref" + "het")/
        (2.0*("hom_ref" + "het" + "hom_alt")),2)),2) /
        NULLIF((("hom_ref" + "het" + "hom_alt")*POWER((2*"hom_ref" + "het")/
        (2.0*("hom_ref" + "het" + "hom_alt")),2)),0)
    +
    POWER("het" - (("hom_ref" + "het" + "hom_alt")*2*( (2*"hom_ref" + "het")/
        (2.0*("hom_ref" + "het" + "hom_alt")) )*
        ( (2*"hom_alt" + "het")/(2.0*("hom_ref" + "het" + "hom_alt")) )),2) /
        NULLIF((("hom_ref" + "het" + "hom_alt")*2*( (2*"hom_ref" + "het")/
        (2.0*("hom_ref" + "het" + "hom_alt")) )*
        ( (2*"hom_alt" + "het")/(2.0*("hom_ref" + "het" + "hom_alt")) )),0)
    +
    POWER("hom_alt" - (("hom_ref" + "het" + "hom_alt")*POWER((2*"hom_alt" + "het")/
        (2.0*("hom_ref" + "het" + "hom_alt")),2)),2) /
        NULLIF((("hom_ref" + "het" + "hom_alt")*POWER((2*"hom_alt" + "het")/
        (2.0*("hom_ref" + "het" + "hom_alt")),2)),0)                          AS "chi_sq"
FROM g
LIMIT 20
