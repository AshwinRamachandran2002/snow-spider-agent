```sql
--Description:  Calculate Hardy-Weinberg χ² statistic for each variant (uses POWER() instead of “^”)
WITH genos AS (
  SELECT
    v."start" AS pos_start,
    v."end"   AS pos_end,
    CASE
      WHEN f.value:"genotype"[0]::INT = 0 AND f.value:"genotype"[1]::INT = 0 THEN 'hom_ref'
      WHEN f.value:"genotype"[0]::INT = 1 AND f.value:"genotype"[1]::INT = 1 THEN 'hom_alt'
      ELSE 'het'
    END AS g,
    (f.value:"genotype"[0]::INT + f.value:"genotype"[1]::INT) AS alt_sum
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call") f
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
),
obs AS (
  SELECT
    pos_start, pos_end,
    COUNT_IF(g='hom_ref') AS o_rr,
    COUNT_IF(g='het')     AS o_ra,
    COUNT_IF(g='hom_alt') AS o_aa,
    COUNT(*)              AS n
  FROM genos
  GROUP BY pos_start, pos_end
),
allele AS (
  SELECT
    pos_start, pos_end,
    SUM(alt_sum) AS ac,
    COUNT(*)*2   AS an
  FROM genos
  GROUP BY pos_start, pos_end
),
stats AS (
  SELECT
    o.pos_start, o.pos_end,
    o.o_rr, o.o_ra, o.o_aa, o.n,
    a.ac::FLOAT/a.an            AS p_alt,
    1 - a.ac::FLOAT/a.an        AS p_ref
  FROM obs o
  JOIN allele a USING (pos_start,pos_end)
)
SELECT
  pos_start AS "start",
  pos_end   AS "end",
  o_rr, o_ra, o_aa,
  ROUND(n*POWER(p_ref,2),2)        AS e_rr,
  ROUND(n*2*p_ref*p_alt,2)         AS e_ra,
  ROUND(n*POWER(p_alt,2),2)        AS e_aa,
  ROUND(
        NVL(POWER(o_rr - n*POWER(p_ref,2),2)/NULLIF(n*POWER(p_ref,2),0),0) +
        NVL(POWER(o_ra - n*2*p_ref*p_alt,2)/NULLIF(n*2*p_ref*p_alt,0),0)   +
        NVL(POWER(o_aa - n*POWER(p_alt,2),2)/NULLIF(n*POWER(p_alt,2),0),0)
       ,4)                          AS "chi_sq"
FROM stats
LIMIT 20;
```

```sql
--Description:  Merge variant fields with observed / expected counts and χ² statistic (POWER() used for squares)
WITH basic AS (
  SELECT
    "reference_name",
    "start",
    "end",
    "reference_bases",
    ARRAY_TO_STRING("alternate_bases",',') AS alt_bases,
    "VT"
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS"
  WHERE "reference_name" = '17'
    AND "start" BETWEEN 41196311 AND 41277499
),
chi AS (
  WITH genos AS (
    SELECT
      v."start" AS pos_start,
      v."end"   AS pos_end,
      CASE
        WHEN f.value:"genotype"[0]::INT = 0 AND f.value:"genotype"[1]::INT = 0 THEN 'hom_ref'
        WHEN f.value:"genotype"[0]::INT = 1 AND f.value:"genotype"[1]::INT = 1 THEN 'hom_alt'
        ELSE 'het'
      END AS g,
      (f.value:"genotype"[0]::INT + f.value:"genotype"[1]::INT) AS alt_sum
    FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
         LATERAL FLATTEN(input => v."call") f
    WHERE v."reference_name" = '17'
      AND v."start" BETWEEN 41196311 AND 41277499
  ),
  obs AS (
    SELECT
      pos_start, pos_end,
      COUNT_IF(g='hom_ref') AS o_rr,
      COUNT_IF(g='het')     AS o_ra,
      COUNT_IF(g='hom_alt') AS o_aa,
      COUNT(*)              AS n
    FROM genos
    GROUP BY pos_start, pos_end
  ),
  allele AS (
    SELECT
      pos_start, pos_end,
      SUM(alt_sum) AS ac,
      COUNT(*)*2   AS an
    FROM genos
    GROUP BY pos_start, pos_end
  ),
  stat AS (
    SELECT
      o.pos_start, o.pos_end,
      o.o_rr, o.o_ra, o.o_aa, o.n,
      a.ac::FLOAT/a.an        AS p_alt,
      1 - a.ac::FLOAT/a.an    AS p_ref
    FROM obs o
    JOIN allele a USING (pos_start,pos_end)
  )
  SELECT
    pos_start, pos_end,
    o_rr, o_ra, o_aa,
    n*POWER(p_ref,2)                             AS e_rr,
    n*2*p_ref*p_alt                              AS e_ra,
    n*POWER(p_alt,2)                             AS e_aa,
    ROUND(
          NVL(POWER(o_rr - n*POWER(p_ref,2),2)/NULLIF(n*POWER(p_ref,2),0),0) +
          NVL(POWER(o_ra - n*2*p_ref*p_alt,2)/NULLIF(n*2*p_ref*p_alt,0),0)   +
          NVL(POWER(o_aa - n*POWER(p_alt,2),2)/NULLIF(n*POWER(p_alt,2),0),0)
         ,4) AS chi_sq,
    p_ref,
    p_alt
  FROM stat
)
SELECT
  b."reference_name",
  b."start",
  b."end",
  b."reference_bases",
  b.alt_bases,
  b."VT",
  c.o_rr  AS obs_hom_ref,
  c.o_ra  AS obs_het,
  c.o_aa  AS obs_hom_alt,
  c.e_rr  AS exp_hom_ref,
  c.e_ra  AS exp_het,
  c.e_aa  AS exp_hom_alt,
  c.chi_sq,
  c.p_ref AS ref_allele_freq,
  c.p_alt AS alt_allele_freq
FROM basic b
JOIN chi   c
  ON b."start" = c.pos_start
 AND b."end"   = c.pos_end
LIMIT 20;
