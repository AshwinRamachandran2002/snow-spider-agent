reference_name,start,end,reference_bases,ALT_BASES,VT,OBS_HOM_REF,OBS_HET,OBS_HOM_ALT,EXP_HOM_REF,EXP_HET,EXP_HOM_ALT,CHI_SQ,REF_ALLELE_FREQ,ALT_ALLELE_FREQ
