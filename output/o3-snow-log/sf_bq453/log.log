),
chi AS (
  --reuse chi-square logic from previous query, trimmed to needed columns
  WITH genos AS (
    SELECT
      v."start",
      v."end",
      CASE 
        WHEN a1 = 0 AND a2 = 0 THEN 'hom_ref'
        WHEN a1 = 1 AND a2 = 1 THEN 'hom_alt'
        ELSE 'het'
      END AS "g"
    FROM (
      SELECT 
        v."start",
        v."end",
        f.value:"genotype"[0]::INT AS a1,
        f.value:"genotype"[1]::INT AS a2
      FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
           LATERAL FLATTEN(input => v."call") f
      WHERE v."reference_name" = '17'
        AND v."start" BETWEEN 41196311 AND 41277499
    )
  ),
  obs AS (
    SELECT 
      "start","end",
      COUNT_IF(g='hom_ref') AS o_rr,
      COUNT_IF(g='het')     AS o_ra,
      COUNT_IF(g='hom_alt') AS o_aa,
      COUNT(*)              AS n
    FROM genos
    GROUP BY "start","end"
  ),
  allele AS (
    SELECT
      "start","end",
      SUM(a1+a2) AS ac,
      COUNT(*)*2 AS an
    FROM (
      SELECT 
        v."start",
