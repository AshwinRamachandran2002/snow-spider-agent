  o.n,
  a.ac,
  a.an,
  (a.ac::FLOAT)/a.an                           AS p_alt,
  1 - (a.ac::FLOAT)/a.an                       AS p_ref,
  (a.an/2)*(1-p_alt)*(1-p_alt)                 AS e_hom_ref,
  (a.an/2)*(2*p_alt*(1-p_alt))                 AS e_het,
  (a.an/2)*(p_alt*p_alt)                       AS e_hom_alt
FROM obs o
JOIN allele a
  ON o."start" = a."start" AND o."end" = a."end"
LIMIT 20;
