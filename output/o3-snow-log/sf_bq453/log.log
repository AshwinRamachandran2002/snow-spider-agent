--Description: Compute allele counts (AC) and alternate-allele frequency per variant in the chr17 interval
WITH alleles AS (
  SELECT
    v."start" AS pos_start,
    v."end"   AS pos_end,
    (f.value:"genotype"[0]::INT + f.value:"genotype"[1]::INT) AS alt_alleles
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call") f
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
)
SELECT
  pos_start AS "start",
  pos_end   AS "end",
  SUM(alt_alleles)                     AS "AC_calc",
  COUNT(*)*2                           AS "AN_calc",
  SUM(alt_alleles)::FLOAT / (COUNT(*)*2) AS "p_alt_freq"
FROM alleles
GROUP BY pos_start, pos_end
LIMIT 20
