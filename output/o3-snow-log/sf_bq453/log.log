```sql
--7. Description:  Join observed genotype counts with allele frequency and derive expected counts
WITH genos AS (
  SELECT
    v."start",
    v."end",
    CASE 
      WHEN a1 = 0 AND a2 = 0 THEN 'hom_ref'
      WHEN a1 = 1 AND a2 = 1 THEN 'hom_alt'
      ELSE 'het'
    END AS "g"
  FROM (
    SELECT 
      v."start",
      v."end",
      f.value:"genotype"[0]::INT AS a1,
      f.value:"genotype"[1]::INT AS a2
    FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
         LATERAL FLATTEN(input => v."call") f
    WHERE v."reference_name" = '17'
      AND v."start" BETWEEN 41196311 AND 41277499
  )
),
obs AS (
  SELECT 
    "start",
    "end",
    COUNT_IF(g='hom_ref') AS o_hom_ref,
    COUNT_IF(g='het')     AS o_het,
    COUNT_IF(g='hom_alt') AS o_hom_alt,
    COUNT(*)              AS n
  FROM genos
  GROUP BY "start","end"
),
allele AS (
  SELECT
    "start",
    "end",
    SUM(a1+a2) AS ac,
    COUNT(*)*2 AS an
  FROM (
    SELECT 
      v."start",
      v."end",
      f.value:"genotype"[0]::INT AS a1,
      f.value:"genotype"[1]::INT AS a2
    FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
         LATERAL FLATTEN(input => v."call") f
    WHERE v."reference_name" = '17'
      AND v."start" BETWEEN 41196311 AND 41277499
  )
  GROUP BY "start","end"
)
SELECT 
  o."start",
  o."end",
  o.o_hom_ref,
  o.o_het,
  o.o_hom_alt,
  o.n,
  a.ac,
  a.an,
  (a.ac::FLOAT)/a.an                           AS p_alt,
  1 - (a.ac::FLOAT)/a.an                       AS p_ref,
  (a.an/2)*(1-p_alt)*(1-p_alt)                 AS e_hom_ref,
  (a.an/2)*(2*p_alt*(1-p_alt))                 AS e_het,
  (a.an/2)*(p_alt*p_alt)                       AS e_hom_alt
FROM obs o
JOIN allele a
  ON o."start" = a."start" AND o."end" = a."end"
LIMIT 20;
```

```sql
--8. Description:  Calculate Hardy-Weinberg chi-squared statistic for each variant
WITH stats AS (
  --reuse the previous CTE calculating observed & expected
  WITH genos AS (
    SELECT
      v."start",
      v."end",
      CASE 
        WHEN a1 = 0 AND a2 = 0 THEN 'hom_ref'
        WHEN a1 = 1 AND a2 = 1 THEN 'hom_alt'
        ELSE 'het'
      END AS "g"
    FROM (
      SELECT 
        v."start",
        v."end",
        f.value:"genotype"[0]::INT AS a1,
        f.value:"genotype"[1]::INT AS a2
      FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
           LATERAL FLATTEN(input => v."call") f
      WHERE v."reference_name" = '17'
        AND v."start" BETWEEN 41196311 AND 41277499
    )
  ),
  obs AS (
    SELECT 
      "start",
      "end",
      COUNT_IF(g='hom_ref') AS o_rr,
      COUNT_IF(g='het')     AS o_ra,
      COUNT_IF(g='hom_alt') AS o_aa,
      COUNT(*)              AS n
    FROM genos
    GROUP BY "start","end"
  ),
  allele AS (
    SELECT
      "start",
      "end",
      SUM(a1+a2) AS ac,
      COUNT(*)*2 AS an
    FROM (
      SELECT 
        v."start",
        v."end",
        f.value:"genotype"[0]::INT AS a1,
        f.value:"genotype"[1]::INT AS a2
      FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
           LATERAL FLATTEN(input => v."call") f
      WHERE v."reference_name" = '17'
        AND v."start" BETWEEN 41196311 AND 41277499
    )
    GROUP BY "start","end"
  )
  SELECT 
    o."start",
    o."end",
    o.o_rr,
    o.o_ra,
    o.o_aa,
    a.ac,
    a.an,
    (a.ac::FLOAT)/a.an     AS p_alt,
    1 -(a.ac::FLOAT)/a.an  AS p_ref,
    (o.n)*(p_ref*p_ref)    AS e_rr,
    (o.n)*(2*p_ref*p_alt)  AS e_ra,
    (o.n)*(p_alt*p_alt)    AS e_aa
  FROM obs o
  JOIN allele a ON o."start"=a."start" AND o."end"=a."end"
)
SELECT
  "start",
  "end",
  o_rr, o_ra, o_aa,
  ROUND(e_rr,2) AS e_rr,
  ROUND(e_ra,2) AS e_ra,
  ROUND(e_aa,2) AS e_aa,
  ROUND(  NVL((POWER(o_rr-e_rr,2)/NULLIF(e_rr,0)),0) +
         NVL((POWER(o_ra-e_ra,2)/NULLIF(e_ra,0)),0) +
         NVL((POWER(o_aa-e_aa,2)/NULLIF(e_aa,0)),0)
       ,4) AS "chi_sq"
FROM stats
LIMIT 20;
```

```sql
--9. Description:  Combine all requested information (basic variant fields + HWE chi-square & counts) for final review
WITH basic AS (
  SELECT 
    "reference_name",
    "start",
    "end",
    "reference_bases",
    ARRAY_TO_STRING("alternate_bases",',')  AS "alt_bases",
    "VT"
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS"
  WHERE "reference_name" = '17'
    AND "start" BETWEEN 41196311 AND 41277499
),
chi AS (
  --re-use query 8 but keep only needed cols
  WITH genos AS (
    SELECT
      v."start",
      v."end",
      CASE 
        WHEN a1 = 0 AND a2 = 0 THEN 'hom_ref'
        WHEN a1 = 1 AND a2 = 1 THEN 'hom_alt'
        ELSE 'het'
      END AS "g"
    FROM (
      SELECT 
        v."start",
        v."end",
        f.value:"genotype"[0]::INT AS a1,
        f.value:"genotype"[1]::INT AS a2
      FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
           LATERAL FLATTEN(input => v."call") f
      WHERE v."reference_name" = '17'
        AND v."start" BETWEEN 41196311 AND 41277499
    )
  ),
  obs AS (
    SELECT 
      "start","end",
      COUNT_IF(g='hom_ref') AS o_rr,
      COUNT_IF(g='het')     AS o_ra,
      COUNT_IF(g='hom_alt') AS o_aa,
      COUNT(*)              AS n
    FROM genos
    GROUP BY "start","end"
  ),
  allele AS (
    SELECT
      "start","end",
      SUM(a1+a2) AS ac,
      COUNT(*)*2 AS an
    FROM (
      SELECT 
        v."start",
        v."end",
        f.value:"genotype"[0]::INT AS a1,
        f.value:"genotype"[1]::INT AS a2
      FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
           LATERAL FLATTEN(input => v."call") f
      WHERE v."reference_name" = '17'
        AND v."start" BETWEEN 41196311 AND 41277499
    )
    GROUP BY "start","end"
  )
  SELECT 
    o."start",
    o."end",
    o.o_rr,
    o.o_ra,
    o.o_aa,
    a.ac,
    a.an,
    (a.ac::FLOAT)/a.an     AS p_alt,
    1-(a.ac::FLOAT)/a.an   AS p_ref,
    (o.n)*(p_ref*p_ref)    AS e_rr,
    (o.n)*(2*p_ref*p_alt)  AS e_ra,
    (o.n)*(p_alt*p_alt)    AS e_aa,
    ROUND(  NVL((POWER(o_rr-((o.n)*(p_ref*p_ref)),2)/NULLIF(((o.n)*(p_ref*p_ref)),0)),0) +
           NVL((POWER(o_ra-((o.n)*(2*p_ref*p_alt)),2)/NULLIF(((o.n)*(2*p_ref*p_alt)),0)),0) +
           NVL((POWER(o_aa-((o.n)*(p_alt*p_alt)),2)/NULLIF(((o.n)*(p_alt*p_alt)),0)),0)
          ,4) AS "chi_sq"
  FROM obs o
  JOIN allele a ON o."start"=a."start" AND o."end"=a."end"
)
SELECT 
  b."reference_name",
  b."start",
  b."end",
  b."reference_bases",
  b."alt_bases",
  b."VT",
  c.o_rr  AS "obs_hom_ref",
  c.o_ra  AS "obs_het",
  c.o_aa  AS "obs_hom_alt",
  c.e_rr  AS "exp_hom_ref",
  c.e_ra  AS "exp_het",
  c.e_aa  AS "exp_hom_alt",
  c."chi_sq",
  c.p_ref AS "ref_allele_freq",
  c.p_alt AS "alt_allele_freq"
FROM basic b
JOIN chi   c ON b."start"=c."start" AND b."end"=c."end"
LIMIT 20;
