SELECT 
  b."reference_name",
  b."start",
  b."end",
  b."reference_bases",
  b."alt_bases",
  b."VT",
  c.o_rr  AS "obs_hom_ref",
  c.o_ra  AS "obs_het",
  c.o_aa  AS "obs_hom_alt",
  c.e_rr  AS "exp_hom_ref",
  c.e_ra  AS "exp_het",
  c.e_aa  AS "exp_hom_alt",
  c."chi_sq",
  c.p_ref AS "ref_allele_freq",
  c.p_alt AS "alt_allele_freq"
FROM basic b
JOIN chi   c ON b."start"=c."start" AND b."end"=c."end"
LIMIT 20;
