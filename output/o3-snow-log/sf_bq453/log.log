        f.value:"genotype"[0]::INT AS a1,
        f.value:"genotype"[1]::INT AS a2
      FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
           LATERAL FLATTEN(input => v."call") f
      WHERE v."reference_name" = '17'
        AND v."start" BETWEEN 41196311 AND 41277499
    )
    GROUP BY "start","end"
  )
  SELECT 
    o."start",
    o."end",
    o.o_rr,
    o.o_ra,
    o.o_aa,
    (a.ac::FLOAT)/a.an     AS p_alt,
    1-(a.ac::FLOAT)/a.an   AS p_ref,
    (o.n)*(p_ref*p_ref)    AS e_rr,
    (o.n)*(2*p_ref*p_alt)  AS e_ra,
    (o.n)*(p_alt*p_alt)    AS e_aa,
    ROUND(
          NVL(POWER(o.o_rr-(o.n)*(p_ref*p_ref),2)/NULLIF((o.n)*(p_ref*p_ref),0),0) +
          NVL(POWER(o.o_ra-(o.n)*(2*p_ref*p_alt),2)/NULLIF((o.n)*(2*p_ref*p_alt),0),0) +
          NVL(POWER(o.o_aa-(o.n)*(p_alt*p_alt),2)/NULLIF((o.n)*(p_alt*p_alt),0),0)
         ,4) AS "chi_sq"
  FROM obs o
