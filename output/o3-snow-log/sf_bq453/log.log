--Description: Calculate Hardy–Weinberg chi-squared statistic for each variant
WITH stats AS (
  WITH genos AS (
    SELECT
      v."start",
      v."end",
      CASE 
        WHEN a1 = 0 AND a2 = 0 THEN 'hom_ref'
        WHEN a1 = 1 AND a2 = 1 THEN 'hom_alt'
        ELSE 'het'
      END AS "g"
    FROM (
      SELECT 
        v."start",
        v."end",
        f.value:"genotype"[0]::INT AS a1,
        f.value:"genotype"[1]::INT AS a2
      FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
           LATERAL FLATTEN(input => v."call") f
      WHERE v."reference_name" = '17'
        AND v."start" BETWEEN 41196311 AND 41277499
    )
  ),
  obs AS (
    SELECT 
      "start","end",
      COUNT_IF(g='hom_ref') AS o_rr,
      COUNT_IF(g='het')     AS o_ra,
      COUNT_IF(g='hom_alt') AS o_aa,
      COUNT(*)              AS n
    FROM genos
    GROUP BY "start","end"
  ),
  allele AS (
    SELECT
      "start","end",
      SUM(a1+a2) AS ac,
      COUNT(*)*2 AS an
    FROM (
      SELECT 
        v."start",
        v."end",
        f.value:"genotype"[0]::INT AS a1,
        f.value:"genotype"[1]::INT AS a2
      FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
           LATERAL FLATTEN(input => v."call") f
      WHERE v."reference_name" = '17'
        AND v."start" BETWEEN 41196311 AND 41277499
    )
    GROUP BY "start","end"
  )
  SELECT 
    o."start",
    o."end",
    o.o_rr,
    o.o_ra,
    o.o_aa,
    a.ac,
    a.an,
    (a.ac::FLOAT)/a.an     AS p_alt,
    1-(a.ac::FLOAT)/a.an   AS p_ref,
    (o.n)*(p_ref*p_ref)    AS e_rr,
    (o.n)*(2*p_ref*p_alt)  AS e_ra,
    (o.n)*(p_alt*p_alt)    AS e_aa
  FROM obs o
  JOIN allele a ON o."start"=a."start" AND o."end"=a."end"
)
SELECT
  "start",
  "end",
  o_rr, o_ra, o_aa,
  ROUND(e_rr,2) AS e_rr,
  ROUND(e_ra,2) AS e_ra,
  ROUND(e_aa,2) AS e_aa,
  ROUND(
        NVL(POWER(o_rr-e_rr,2)/NULLIF(e_rr,0),0) +
        NVL(POWER(o_ra-e_ra,2)/NULLIF(e_ra,0),0) +
        NVL(POWER(o_aa-e_aa,2)/NULLIF(e_aa,0),0)
       ,4) AS "chi_sq"
FROM stats
LIMIT 20;
```

