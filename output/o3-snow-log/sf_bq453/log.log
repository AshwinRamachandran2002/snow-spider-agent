--Description:  Display 1 KG continental allele frequencies plus calculated alt-allele frequency (no “^” operator)
WITH calc_freq AS (
  SELECT
    v."start" AS pos_start,
    v."end"   AS pos_end,
    SUM(f.value:"genotype"[0]::INT + f.value:"genotype"[1]::INT)
      ::FLOAT / (COUNT(*)*2) AS calc_p_alt
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call") f
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY v."start", v."end"
)
SELECT
  v."reference_name",
  v."start",
  v."end",
  v."reference_bases",
  ARRAY_TO_STRING(v."alternate_bases",',') AS alt_bases,
  v."VT",
  v."AFR_AF",
  v."EUR_AF",
  v."AMR_AF",
  v."ASN_AF",
  c.calc_p_alt AS calc_alt_freq
FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v
JOIN calc_freq c
  ON v."start" = c.pos_start
 AND v."end"   = c.pos_end
WHERE v."reference_name" = '17'
  AND v."start" BETWEEN 41196311 AND 41277499
LIMIT 20
