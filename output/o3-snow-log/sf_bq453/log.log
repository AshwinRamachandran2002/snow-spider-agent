```sql
--Description (thinking process):
--To get Hardy-Weinberg observed and expected genotype counts for every variant in
--chr17 positions 41,196,311–41,277,499, we:
-- 1) Flatten the “call” array (genos CTE) to classify each sample’s genotype and
--    record the number of alternate alleles (alt_sum).
-- 2) Count observed genotypes per variant (obs CTE).
-- 3) Sum alt alleles and total alleles to obtain allele counts/frequencies (allele CTE).
-- 4) Join obs + allele and, using Snowflake’s POWER(x,2) instead of “^”, compute
--    expected counts under Hardy-Weinberg.
WITH genos AS (
  SELECT
    v."start" AS pos_start,
    v."end"   AS pos_end,
    CASE
      WHEN f.value:"genotype"[0]::INT = 0 AND f.value:"genotype"[1]::INT = 0 THEN 'hom_ref'
      WHEN f.value:"genotype"[0]::INT = 1 AND f.value:"genotype"[1]::INT = 1 THEN 'hom_alt'
      ELSE 'het'
    END                                                         AS g,
    (f.value:"genotype"[0]::INT + f.value:"genotype"[1]::INT)   AS alt_sum
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call") f
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
),
obs AS (
  SELECT
    pos_start,
    pos_end,
    COUNT_IF(g = 'hom_ref') AS o_hom_ref,
    COUNT_IF(g = 'het')     AS o_het,
    COUNT_IF(g = 'hom_alt') AS o_hom_alt,
    COUNT(*)                AS n
  FROM genos
  GROUP BY pos_start, pos_end
),
allele AS (
  SELECT
    pos_start,
    pos_end,
    SUM(alt_sum) AS ac,
    COUNT(*)*2   AS an
  FROM genos
  GROUP BY pos_start, pos_end
)
SELECT
  o.pos_start AS "start",
  o.pos_end   AS "end",
  o.o_hom_ref,
  o.o_het,
  o.o_hom_alt,
  o.n,
  a.ac,
  a.an,
  a.ac::FLOAT / a.an                        AS p_alt,
  1 - (a.ac::FLOAT / a.an)                  AS p_ref,
  o.n * POWER(1 - (a.ac::FLOAT / a.an), 2)                       AS e_hom_ref,
  o.n * 2 * (1 - (a.ac::FLOAT / a.an)) * (a.ac::FLOAT / a.an)    AS e_het,
  o.n * POWER(a.ac::FLOAT / a.an, 2)                             AS e_hom_alt
FROM obs o
JOIN allele a USING (pos_start, pos_end)
LIMIT 20;
```
