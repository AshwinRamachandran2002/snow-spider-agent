--5. Description:  Aggregate observed genotype counts per variant
WITH genos AS (
  SELECT
    v."start",
    v."end",
    CASE 
      WHEN a1 = 0 AND a2 = 0 THEN 'hom_ref'
      WHEN a1 = 1 AND a2 = 1 THEN 'hom_alt'
      ELSE 'het'
    END AS "geno_type"
  FROM (
    SELECT 
      v."start",
      v."end",
      f.value:"genotype"[0]::INT AS a1,
      f.value:"genotype"[1]::INT AS a2
    FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
         LATERAL FLATTEN(input => v."call") f
    WHERE v."reference_name" = '17'
      AND v."start" BETWEEN 41196311 AND 41277499
  )
)
SELECT 
  "start",
  "end",
  COUNT_IF("geno_type" = 'hom_ref') AS "obs_hom_ref",
  COUNT_IF("geno_type" = 'het')      AS "obs_het",
