```sql
--Description (thinking process):
--1) Flatten the “call” array for each variant in chr17 (41,196,311–41,277,499).  
--2) Classify every sample’s genotype: 0/0 → hom_ref, 1/1 → hom_alt, otherwise het.  
--3) Aggregate counts of each genotype class per variant.  
--4) Use aliases (pos_start, pos_end) inside the CTE to avoid scope issues, then
--   project them back as "start" and "end" in the final SELECT.
WITH genos AS (
  SELECT
    v."start" AS pos_start,
    v."end"   AS pos_end,
    CASE
      WHEN f.value:"genotype"[0]::INT = 0 AND f.value:"genotype"[1]::INT = 0 THEN 'hom_ref'
      WHEN f.value:"genotype"[0]::INT = 1 AND f.value:"genotype"[1]::INT = 1 THEN 'hom_alt'
      ELSE 'het'
    END AS geno_type
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call") f
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
)
SELECT
  pos_start AS "start",
  pos_end   AS "end",
  COUNT_IF(geno_type = 'hom_ref') AS "obs_hom_ref",
  COUNT_IF(geno_type = 'het')     AS "obs_het",
  COUNT_IF(geno_type = 'hom_alt') AS "obs_hom_alt",
  COUNT(*)                        AS "n_genotypes"
FROM genos
GROUP BY pos_start, pos_end
LIMIT 20;
