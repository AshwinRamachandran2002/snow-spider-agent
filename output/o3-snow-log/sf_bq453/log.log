--Description: Present continental 1KG allele frequencies together with calculated alt-allele freq & chi-square
WITH chi AS (
  --compute alt-allele frequency (reuse simplified allele CTE)
  WITH genos AS (
    SELECT
      v."start",
      v."end",
      (f.value:"genotype"[0]::INT + f.value:"genotype"[1]::INT) AS "alt_sum"
    FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
         LATERAL FLATTEN(input => v."call") f
    WHERE v."reference_name" = '17'
      AND v."start" BETWEEN 41196311 AND 41277499
  )
  SELECT 
    "start",
    "end",
    SUM("alt_sum")::FLOAT / (COUNT(*)*2) AS p_alt
  FROM genos
  GROUP BY "start","end"
)
SELECT 
  v."reference_name",
  v."start",
  v."end",
  v."reference_bases",
  ARRAY_TO_STRING(v."alternate_bases",',') AS "alt_bases",
  v."VT",
  v."AFR_AF",
  v."EUR_AF",
  v."AMR_AF",
  v."ASN_AF",
  c.p_alt        AS "calc_alt_freq"
FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v
JOIN chi c
  ON v."start" = c."start" AND v."end" = c."end"
WHERE v."reference_name" = '17'
  AND v."start" BETWEEN 41196311 AND 41277499
LIMIT 20;
