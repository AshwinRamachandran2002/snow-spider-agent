--6. Description:  Compute allele counts (AC) & allele frequency (p = alt allele freq) per variant
WITH alleles AS (
  SELECT 
    v."start",
    v."end",
    (f.value:"genotype"[0]::INT + f.value:"genotype"[1]::INT) AS "alt_alleles"
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call") f
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
)
SELECT
  "start",
  "end",
  SUM("alt_alleles")                     AS "AC_calc",
