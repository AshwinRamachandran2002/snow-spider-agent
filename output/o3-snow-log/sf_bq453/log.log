Query:
--Description:  Calculate Hardy-Weinberg χ² statistic for each variant (uses POWER() instead of “^”)
WITH genos AS (
  SELECT
    v."start" AS pos_start,
    v."end"   AS pos_end,
    CASE
      WHEN f.value:"genotype"[0]::INT = 0 AND f.value:"genotype"[1]::INT = 0 THEN 'hom_ref'
      WHEN f.value:"genotype"[0]::INT = 1 AND f.value:"genotype"[1]::INT = 1 THEN 'hom_alt'
      ELSE 'het'
    END AS g,
    (f.value:"genotype"[0]::INT + f.value:"genotype"[1]::INT) AS alt_sum
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call") f
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
),
obs AS (
  SELECT
    pos_start, pos_end,
    COUNT_IF(g='hom_ref') AS o_rr,
    COUNT_IF(g='het')     AS o_ra,
    COUNT_IF(g='hom_alt') AS o_aa,
    COUNT(*)              AS n
  FROM genos
  GROUP BY pos_start, pos_end
),
allele AS (
  SELECT
    pos_start, pos_end,
    SUM(alt_sum) AS ac,
    COUNT(*)*2   AS an
  FROM genos
  GROUP BY pos_start, pos_end
),
stats AS (
  SELECT
    o.pos_start, o.pos_end,
    o.o_rr, o.o_ra, o.o_aa, o.n,
    a.ac::FLOAT/a.an            AS p_alt,
    1 - a.ac::FLOAT/a.an        AS p_ref
  FROM obs o
  JOIN allele a USING (pos_start,pos_end)
)
SELECT
  pos_start AS "start",
  pos_end   AS "end",
  o_rr, o_ra, o_aa,
  ROUND(n*POWER(p_ref,2),2)        AS e_rr,
  ROUND(n*2*p_ref*p_alt,2)         AS e_ra,
  ROUND(n*POWER(p_alt,2),2)        AS e_aa,
  ROUND(
        NVL(POWER(o_rr - n*POWER(p_ref,2),2)/NULLIF(n*POWER(p_ref,2),0),0) +
        NVL(POWER(o_ra - n*2*p_ref*p_alt,2)/NULLIF(n*2*p_ref*p_alt,0),0)   +
        NVL(POWER(o_aa - n*POWER(p_alt,2),2)/NULLIF(n*POWER(p_alt,2),0),0)
       ,4)                          AS "chi_sq"
FROM stats
LIMIT 20
Answer:
start,end,O_RR,O_RA,O_AA,E_RR,E_RA,E_AA,chi_sq
