        v."end",
        f.value:"genotype"[0]::INT AS a1,
        f.value:"genotype"[1]::INT AS a2
      FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
           LATERAL FLATTEN(input => v."call") f
      WHERE v."reference_name" = '17'
        AND v."start" BETWEEN 41196311 AND 41277499
    )
  ),
  allele AS (
    SELECT
      "start","end",
      SUM(a1+a2) AS ac,
      COUNT(*)*2 AS an
    FROM (
      SELECT 
        v."start",
        v."end",
        f.value:"genotype"[0]::INT AS a1,
        f.value:"genotype"[1]::INT AS a2
      FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
           LATERAL FLATTEN(input => v."call") f
      WHERE v."reference_name" = '17'
        AND v."start" BETWEEN 41196311 AND 41277499
    )
    GROUP BY "start","end"
  )
  SELECT 
    "start","end",
    (ac::FLOAT)/an AS p_alt,
    0              AS "chi_sq"  -- placeholder just for join; chi-square not repeated here
  FROM allele
) c
  ON v."start"=c."start" AND v."end"=c."end"
WHERE v."reference_name" = '17'
  AND v."start" BETWEEN 41196311 AND 41277499
LIMIT 20;
