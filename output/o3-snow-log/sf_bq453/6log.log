```sql
-- 7. Description:  Count observed genotypes (hom-ref, het, hom-alt) for each variant
WITH genos AS (
  SELECT 
    v."reference_name",
    v."start",
    CASE 
      WHEN f.value:"genotype"[0]::INT = 0 AND f.value:"genotype"[1]::INT = 0 THEN 'HOM_REF'
      WHEN f.value:"genotype"[0]::INT = 1 AND f.value:"genotype"[1]::INT = 1 THEN 'HOM_ALT'
      ELSE 'HET'
    END AS "geno_type"
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call") f
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
)
SELECT
  "reference_name",
  "start",
  COUNT_IF("geno_type" = 'HOM_REF') AS "obs_hom_ref",
  COUNT_IF("geno_type" = 'HET')      AS "obs_het",
  COUNT_IF("geno_type" = 'HOM_ALT')  AS "obs_hom_alt",
  COUNT(*)                           AS "total_genotypes"
FROM genos
GROUP BY "reference_name","start"
LIMIT 20;
```

```sql
-- 8. Description:  Compute allele frequency (p = ref, q = alt) and expected HWE genotype counts
WITH obs AS (
  SELECT
    v."reference_name",
    v."start",
    COUNT(*)                                AS "n",
    COUNT_IF(f.value:"genotype"[0] = 0 AND f.value:"genotype"[1] = 0) AS "hom_ref",
    COUNT_IF(f.value:"genotype"[0] = 1 AND f.value:"genotype"[1] = 1) AS "hom_alt",
    COUNT_IF((f.value:"genotype"[0] = 0 AND f.value:"genotype"[1] = 1)
          OR (f.value:"genotype"[0] = 1 AND f.value:"genotype"[1] = 0)) AS "het"
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call") f
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY v."reference_name", v."start"
)
SELECT
  "reference_name",
  "start",
  "n",
  "hom_ref",
  "het",
  "hom_alt",
  (2*"hom_ref" + "het")::FLOAT/(2*"n")                AS "ref_freq",
  (2*"hom_alt" + "het")::FLOAT/(2*"n")                AS "alt_freq",
  "n" * POWER(( (2*"hom_ref" + "het")::FLOAT/(2*"n") ),2)         AS "exp_hom_ref", -- p^2 * N
  2*"n"* ( ( (2*"hom_ref" + "het")::FLOAT/(2*"n") ) * ( (2*"hom_alt" + "het")::FLOAT/(2*"n") )) AS "exp_het", -- 2pqN
  "n" * POWER(( (2*"hom_alt" + "het")::FLOAT/(2*"n") ),2)         AS "exp_hom_alt"
FROM obs
LIMIT 20;
```

```sql
-- 9. Description:  Compute chi-square goodness-of-fit to HWE for each variant
WITH obs AS (
  SELECT
    v."reference_name",
    v."start",
    COUNT(*)                                AS "n",
    COUNT_IF(f.value:"genotype"[0] = 0 AND f.value:"genotype"[1] = 0) AS "hom_ref",
    COUNT_IF(f.value:"genotype"[0] = 1 AND f.value:"genotype"[1] = 1) AS "hom_alt",
    COUNT_IF((f.value:"genotype"[0] = 0 AND f.value:"genotype"[1] = 1)
          OR (f.value:"genotype"[0] = 1 AND f.value:"genotype"[1] = 0)) AS "het"
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call") f
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY v."reference_name", v."start"
),
calc AS (
  SELECT
    "reference_name",
    "start",
    "n",
    "hom_ref",
    "het",
    "hom_alt",
    (2*"hom_ref" + "het")::FLOAT/(2*"n")              AS "p",
    (2*"hom_alt" + "het")::FLOAT/(2*"n")              AS "q"
  FROM obs
)
SELECT
  "reference_name",
  "start",
  "n",
  "hom_ref" AS "obs_hom_ref",
  "het"     AS "obs_het",
  "hom_alt" AS "obs_hom_alt",
  "p",
  "q",
  ("n"*POWER("p",2))                     AS "exp_hom_ref",
  (2*"n"*"p"*"q")                        AS "exp_het",
  ("n"*POWER("q",2))                     AS "exp_hom_alt",
  (
      POWER("hom_ref" - ("n"*POWER("p",2)),2)/NULLIF(("n"*POWER("p",2)),0)
    + POWER("het"     - (2*"n"*"p"*"q"),2)/NULLIF((2*"n"*"p"*"q"),0)
    + POWER("hom_alt" - ("n"*POWER("q",2)),2)/NULLIF(("n"*POWER("q",2)),0)
  )                                      AS "chi_sq"
FROM calc
LIMIT 20;
```

```sql
-- 10. Description:  Combine key fields (positional info, alleles, VT, HWE p-value, chi-square, genotype counts & allele freq)
WITH geno AS (
  SELECT
    v."reference_name",
    v."start",
    v."end",
    v."reference_bases",
    v."alternate_bases",
    v."VT",
    v."HWE",
    v."AF",
    f.value:"genotype"[0]::INT       AS g1,
    f.value:"genotype"[1]::INT       AS g2
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call") f
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
),
agg AS (
  SELECT
    "reference_name",
    "start",
    MIN("end")                        AS "end",
    MIN("reference_bases")            AS "reference_bases",
    ARRAY_AGG(DISTINCT "alternate_bases") AS "distinct_alt_bases",
    MIN("VT")                         AS "VT",
    MIN("HWE")                        AS "HWE",
    MIN("AF")                         AS "AF_1KG",
    COUNT(*)                          AS "N",
    COUNT_IF(g1 = 0 AND g2 = 0)       AS "obs_hom_ref",
    COUNT_IF(g1 = 1 AND g2 = 1)       AS "obs_hom_alt",
    COUNT_IF((g1 = 0 AND g2 = 1) OR (g1 = 1 AND g2 = 0)) AS "obs_het"
  FROM geno
  GROUP BY "reference_name","start"
)
SELECT *
FROM agg
LIMIT 20;
```
