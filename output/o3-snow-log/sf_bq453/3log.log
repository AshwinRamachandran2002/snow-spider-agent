WITH g AS (
  SELECT
    v."reference_name",
    v."start",
    v."end",
    SUM( CASE WHEN c.value:"genotype"[0]::INT = 0 
               AND c.value:"genotype"[1]::INT = 0 THEN 1 ELSE 0 END ) AS hom_ref,
    SUM( CASE WHEN ( c.value:"genotype"[0]::INT = 0 
                     AND c.value:"genotype"[1]::INT = 1 )
            OR ( c.value:"genotype"[0]::INT = 1 
                 AND c.value:"genotype"[1]::INT = 0 ) THEN 1 ELSE 0 END ) AS het,
    SUM( CASE WHEN c.value:"genotype"[0]::INT = 1 
               AND c.value:"genotype"[1]::INT = 1 THEN 1 ELSE 0 END ) AS hom_alt,
    COUNT(*)                                                        AS total_geno
  FROM _1000_GENOMES._1000_GENOMES."VARIANTS" v,
       LATERAL FLATTEN ( INPUT => v."call" ) c
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY v."reference_name", v."start", v."end"
), h AS (
  SELECT
    g.*,
    ( (2*g.hom_alt + g.het)::FLOAT ) / (2*g.total_geno)                         AS q,  -- alt allele freq
    1 - ( (2*g.hom_alt + g.het)::FLOAT ) / (2*g.total_geno)                     AS p
  FROM g
)
