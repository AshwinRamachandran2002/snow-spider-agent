--  • tallies genotypes into HOM_REF / HET / HOM_ALT (g CTE),
--  • derives allele-frequencies p & q, Hardy–Weinberg expected counts and χ²
--    using POWER() (Snowflake’s exponent function) (hwe CTE),
--  • returns observed counts, expected counts, χ², observed ALT-AF and
--    1000 Genomes population AFs in the final SELECT.

WITH base AS (   -------------------------------------------------- variant basics
    SELECT
        v."reference_name",
        v."start",
        v."end",
        v."reference_bases",
        ARRAY_TO_STRING(ARRAY_AGG(DISTINCT alt.value::STRING), ',')         AS alt_bases,
        COALESCE(v."VT", v."SVTYPE")                                        AS variant_type,
        MAX(v."AF")      AS AF_1KG,
        MAX(v."AFR_AF")  AS AFR_AF_1KG,
        MAX(v."EUR_AF")  AS EUR_AF_1KG,
        MAX(v."ASN_AF")  AS ASN_AF_1KG,
        MAX(v."AMR_AF")  AS AMR_AF_1KG
    FROM _1000_GENOMES._1000_GENOMES."VARIANTS" v,
         LATERAL FLATTEN(INPUT => v."alternate_bases") alt
    WHERE v."reference_name" = '17'
      AND v."start" BETWEEN 41196311 AND 41277499
    GROUP BY v."reference_name", v."start", v."end",
             v."reference_bases", COALESCE(v."VT", v."SVTYPE")
),
g AS (      ------------------------------------------------- genotype category counts
    SELECT
        v."reference_name",
        v."start",
        v."end",
        SUM(
            IFF(
                c.value:"genotype"[0]::INT = 0
                AND c.value:"genotype"[1]::INT = 0,
                1, 0)
        ) AS hom_ref,
        SUM(
            IFF(
                   (c.value:"genotype"[0]::INT = 0 AND c.value:"genotype"[1]::INT = 1)
                OR (c.value:"genotype"[0]::INT = 1 AND c.value:"genotype"[1]::INT = 0),
                1, 0)
        ) AS het,
        SUM(
            IFF(
                c.value:"genotype"[0]::INT = 1
                AND c.value:"genotype"[1]::INT = 1,
                1, 0)
        ) AS hom_alt,
        COUNT(*) AS total_geno
    FROM _1000_GENOMES._1000_GENOMES."VARIANTS" v,
         LATERAL FLATTEN(INPUT => v."call") c
    WHERE v."reference_name" = '17'
      AND v."start" BETWEEN 41196311 AND 41277499
    GROUP BY v."reference_name", v."start", v."end"
),
hwe AS (      ------------------------------------ allele-freqs p/q, expected, χ² pieces
    SELECT
        g.*,
        ((2 * g.hom_alt + g.het)::FLOAT) / (2 * g.total_geno)     AS q,
        1 - (((2 * g.hom_alt + g.het)::FLOAT) / (2 * g.total_geno)) AS p
    FROM g
)
SELECT
    b."reference_name",
    b."start",
    b."end",
    b."reference_bases",
    b.alt_bases,
    b.variant_type,
    g.hom_ref,
    g.het,
    g.hom_alt,
    g.total_geno,
    ROUND(hwe.q, 6)                                               AS obs_alt_AF,
    ROUND(g.total_geno * POWER(hwe.p, 2), 2)                      AS exp_hom_ref,
    ROUND(2 * g.total_geno * hwe.p * hwe.q, 2)                    AS exp_het,
    ROUND(g.total_geno * POWER(hwe.q, 2), 2)                      AS exp_hom_alt,
    ROUND(
          COALESCE(
              POWER(g.hom_ref - (g.total_geno * POWER(hwe.p, 2)), 2) /
              NULLIF(g.total_geno * POWER(hwe.p, 2), 0), 0)
        + COALESCE(
              POWER(g.het - (2 * g.total_geno * hwe.p * hwe.q), 2) /
              NULLIF(2 * g.total_geno * hwe.p * hwe.q, 0), 0)
        + COALESCE(
              POWER(g.hom_alt - (g.total_geno * POWER(hwe.q, 2)), 2) /
              NULLIF(g.total_geno * POWER(hwe.q, 2), 0), 0)
    , 3)                                                           AS chi_sq,
    b.AF_1KG,
    b.AFR_AF_1KG,
    b.EUR_AF_1KG,
    b.ASN_AF_1KG,
    b.AMR_AF_1KG
FROM base b
JOIN g   ON b."reference_name" = g."reference_name"
        AND b."start"          = g."start"
        AND b."end"            = g."end"
JOIN hwe ON b."reference_name" = hwe."reference_name"
        AND b."start"          = hwe."start"
        AND b."end"            = hwe."end"
ORDER BY b."start"
LIMIT 20;
