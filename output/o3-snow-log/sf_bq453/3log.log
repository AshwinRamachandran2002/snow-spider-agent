Some few-shot examples after column exploration may be helpful:
Query:
--1) Description:  Take a first look at all variants that fall in Chr-17:41 196 311-41 277 499
SELECT
  v."reference_name",
  v."start",
  v."end",
  v."reference_bases",
  v."alternate_bases",
  v."VT",           -- short/INDEL/SNP etc.
  v."SVTYPE",       -- for any structural-variant records
  v."filter",
  v."quality"
FROM _1000_GENOMES._1000_GENOMES."VARIANTS"  v
WHERE v."reference_name" = '17'
  AND v."start" BETWEEN 41196311 AND 41277499
LIMIT 20;
