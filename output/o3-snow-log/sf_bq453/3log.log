```sql
--5) Description:  Inspect a few raw genotype objects (the “call” array) for the same variants.
SELECT
  v."start",
  c.value:"call_set_name"::STRING     AS "sample_id",
  c.value:"genotype"                  AS "genotype_array"
FROM _1000_GENOMES._1000_GENOMES."VARIANTS"  v,
     LATERAL FLATTEN ( INPUT => v."call" ) c
WHERE v."reference_name" = '17'
  AND v."start" BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
--6) Description:  Classify each genotype into HOM_REF / HET / HOM_ALT for one variant (first 1 only).
SELECT
  v."start",
  SUM( CASE WHEN c.value:"genotype"[0]::INT = 0 
             AND c.value:"genotype"[1]::INT = 0 THEN 1 END )  AS "hom_ref",
  SUM( CASE WHEN ( c.value:"genotype"[0]::INT = 0 
                   AND c.value:"genotype"[1]::INT = 1 )
          OR ( c.value:"genotype"[0]::INT = 1 
               AND c.value:"genotype"[1]::INT = 0 ) THEN 1 END ) AS "het",
  SUM( CASE WHEN c.value:"genotype"[0]::INT = 1 
             AND c.value:"genotype"[1]::INT = 1 THEN 1 END )  AS "hom_alt",
  COUNT(*)                                                      AS "total"
FROM _1000_GENOMES._1000_GENOMES."VARIANTS"  v,
     LATERAL FLATTEN ( INPUT => v."call" ) c
WHERE v."reference_name" = '17'
  AND v."start" BETWEEN 41196311 AND 41277499
GROUP BY v."start"
LIMIT 1;
```

```sql
--7) Description:  Produce genotype-category counts for EVERY variant in the interval.
SELECT
  v."reference_name",
  v."start",
  v."end",
  SUM( CASE WHEN c.value:"genotype"[0]::INT = 0 
             AND c.value:"genotype"[1]::INT = 0 THEN 1 ELSE 0 END ) AS "hom_ref",
  SUM( CASE WHEN ( c.value:"genotype"[0]::INT = 0 
                   AND c.value:"genotype"[1]::INT = 1 )
          OR ( c.value:"genotype"[0]::INT = 1 
               AND c.value:"genotype"[1]::INT = 0 ) THEN 1 ELSE 0 END ) AS "het",
  SUM( CASE WHEN c.value:"genotype"[0]::INT = 1 
             AND c.value:"genotype"[1]::INT = 1 THEN 1 ELSE 0 END ) AS "hom_alt",
  COUNT(*)                                                       AS "total_genotypes"
FROM _1000_GENOMES._1000_GENOMES."VARIANTS" v,
     LATERAL FLATTEN ( INPUT => v."call" ) c
WHERE v."reference_name" = '17'
  AND v."start" BETWEEN 41196311 AND 41277499
GROUP BY v."reference_name", v."start", v."end"
LIMIT 20;
```

```sql
--8) Description:  Add observed ALT-allele frequency calculated from the genotype counts.
WITH g AS (
  SELECT
    v."reference_name",
    v."start",
    v."end",
    SUM( CASE WHEN c.value:"genotype"[0]::INT = 0 
               AND c.value:"genotype"[1]::INT = 0 THEN 1 END ) AS hom_ref,
    SUM( CASE WHEN ( c.value:"genotype"[0]::INT = 0 
                     AND c.value:"genotype"[1]::INT = 1 )
            OR ( c.value:"genotype"[0]::INT = 1 
                 AND c.value:"genotype"[1]::INT = 0 ) THEN 1 END ) AS het,
    SUM( CASE WHEN c.value:"genotype"[0]::INT = 1 
               AND c.value:"genotype"[1]::INT = 1 THEN 1 END ) AS hom_alt,
    COUNT(*)                                                    AS total_geno
  FROM _1000_GENOMES._1000_GENOMES."VARIANTS" v,
       LATERAL FLATTEN ( INPUT => v."call" ) c
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY v."reference_name", v."start", v."end"
)
SELECT
  g.*,
  ( (2*g.hom_alt + g.het)::FLOAT ) / (2*g.total_geno)             AS "alt_AF_obs"
FROM g
LIMIT 20;
```

```sql
--9) Description:  Compute Hardy–Weinberg expected counts and χ² per variant.
WITH g AS (
  SELECT
    v."reference_name",
    v."start",
    v."end",
    SUM( CASE WHEN c.value:"genotype"[0]::INT = 0 
               AND c.value:"genotype"[1]::INT = 0 THEN 1 ELSE 0 END ) AS hom_ref,
    SUM( CASE WHEN ( c.value:"genotype"[0]::INT = 0 
                     AND c.value:"genotype"[1]::INT = 1 )
            OR ( c.value:"genotype"[0]::INT = 1 
                 AND c.value:"genotype"[1]::INT = 0 ) THEN 1 ELSE 0 END ) AS het,
    SUM( CASE WHEN c.value:"genotype"[0]::INT = 1 
               AND c.value:"genotype"[1]::INT = 1 THEN 1 ELSE 0 END ) AS hom_alt,
    COUNT(*)                                                        AS total_geno
  FROM _1000_GENOMES._1000_GENOMES."VARIANTS" v,
       LATERAL FLATTEN ( INPUT => v."call" ) c
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY v."reference_name", v."start", v."end"
), h AS (
  SELECT
    g.*,
    ( (2*g.hom_alt + g.het)::FLOAT ) / (2*g.total_geno)                         AS q,  -- alt allele freq
    1 - ( (2*g.hom_alt + g.het)::FLOAT ) / (2*g.total_geno)                     AS p
  FROM g
)
SELECT
  h."reference_name",
  h."start",
  h."end",
  h.hom_ref,
  h.het,
  h.hom_alt,
  h.total_geno,
  ROUND(h.q, 4)                                                 AS "alt_AF_obs",
  ROUND( h.total_geno * h.p * h.p, 2 )                          AS "exp_hom_ref",
  ROUND( 2*h.total_geno * h.p * h.q, 2 )                        AS "exp_het",
  ROUND( h.total_geno * h.q * h.q, 2 )                          AS "exp_hom_alt",
  ROUND( ( (h.hom_ref - (h.total_geno * h.p * h.p))^2 
           / NULLIF( h.total_geno * h.p * h.p, 0 )
         + (h.het - (2*h.total_geno * h.p * h.q))^2 
           / NULLIF( 2*h.total_geno * h.p * h.q, 0 )
         + (h.hom_alt - (h.total_geno * h.q * h.q))^2 
           / NULLIF( h.total_geno * h.q * h.q, 0 ) ), 3 )        AS "chi_sq"
FROM h
LIMIT 20;
```

```sql
--10) Description:  Final all-in-one query requested in the task.
WITH
base AS (
  SELECT
    v."reference_name",
    v."start",
    v."end",
    v."reference_bases",
    ARRAY_TO_STRING( ARRAY_AGG(DISTINCT alt.value::STRING), ',' ) AS "alt_bases",
    COALESCE( v."VT", v."SVTYPE" )                                AS "variant_type"
  FROM _1000_GENOMES._1000_GENOMES."VARIANTS" v,
       LATERAL FLATTEN ( INPUT => v."alternate_bases" ) alt
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY v."reference_name", v."start", v."end", v."reference_bases", COALESCE( v."VT", v."SVTYPE" )
),
gcounts AS (
  SELECT
    v."reference_name",
    v."start",
    v."end",
    SUM( CASE WHEN c.value:"genotype"[0]::INT = 0 
               AND c.value:"genotype"[1]::INT = 0 THEN 1 ELSE 0 END ) AS hom_ref,
    SUM( CASE WHEN ( c.value:"genotype"[0]::INT = 0 
                     AND c.value:"genotype"[1]::INT = 1 )
            OR ( c.value:"genotype"[0]::INT = 1 
                 AND c.value:"genotype"[1]::INT = 0 ) THEN 1 ELSE 0 END ) AS het,
    SUM( CASE WHEN c.value:"genotype"[0]::INT = 1 
               AND c.value:"genotype"[1]::INT = 1 THEN 1 ELSE 0 END ) AS hom_alt,
    COUNT(*)                                                        AS total_geno
  FROM _1000_GENOMES._1000_GENOMES."VARIANTS" v,
       LATERAL FLATTEN ( INPUT => v."call" ) c
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY v."reference_name", v."start", v."end"
),
hwe AS (
  SELECT
    g.*,
    ( (2*g.hom_alt + g.het)::FLOAT ) / (2*g.total_geno)                         AS q,
    1 - ( (2*g.hom_alt + g.het)::FLOAT ) / (2*g.total_geno)                     AS p
  FROM gcounts g
)
SELECT
  b."reference_name",
  b."start",
  b."end",
  b."reference_bases",
  b."alt_bases",
  b."variant_type",
  ROUND(h.q, 4)                                                 AS "ALT_AF_obs",
  ROUND( h.total_geno * h.p * h.p, 2 )                          AS "exp_hom_ref",
  ROUND( 2*h.total_geno * h.p * h.q, 2 )                        AS "exp_het",
  ROUND( h.total_geno * h.q * h.q, 2 )                          AS "exp_hom_alt",
  h.hom_ref,
  h.het,
  h.hom_alt,
  h.total_geno,
  ROUND( ( (h.hom_ref - (h.total_geno * h.p * h.p))^2 
           / NULLIF( h.total_geno * h.p * h.p, 0 )
         + (h.het - (2*h.total_geno * h.p * h.q))^2 
           / NULLIF( 2*h.total_geno * h.p * h.q, 0 )
         + (h.hom_alt - (h.total_geno * h.q * h.q))^2 
           / NULLIF( h.total_geno * h.q * h.q, 0 ) ), 3 )        AS "chi_sq",
  v."AF", v."AFR_AF", v."EUR_AF", v."ASN_AF", v."AMR_AF"         -- existing 1KG AF columns
FROM base b
JOIN hwe  h  ON  b."reference_name" = h."reference_name"
            AND b."start"          = h."start"
            AND b."end"            = h."end"
JOIN _1000_GENOMES._1000_GENOMES."VARIANTS" v
      ON v."reference_name" = b."reference_name"
     AND v."start"          = b."start"
     AND v."end"            = b."end"
LIMIT 20;
```
