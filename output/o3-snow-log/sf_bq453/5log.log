```sql
--Description / thinking process:
-- Goal: deliver, in one result set, for every variant on chr17 inside 41 196 311–41 277 499:
--   • coordinates, REF / distinct ALT(s), variant-type (VT)
--   • observed genotype counts (hom-ref, het, hom-alt) & total N
--   • Hardy–Weinberg expected counts, chi-squared statistic
--   • calculated allele frequencies (ref & alt) plus 1000 Genomes AF columns
--
-- Strategy (single statement built from CTEs):
--   1) alt_cte   – flatten alternate_bases to list distinct ALT alleles, keep REF & VT.
--   2) geno_cte  – flatten call array; count genotype classes for each variant.
--   3) stat_cte  – derive allele freqs p & q from observed counts.
--   4) hwe_cte   – compute H-W expectations and χ².
--   5) Final SELECT joins hwe_cte to alt_cte & original VARIANTS to expose AF columns.
-- All filtering on chromosome and interval is applied in each CTE to keep workload small.

WITH alt_cte AS (
  SELECT
    v."reference_name",
    v."start",
    v."end",
    MAX(v."reference_bases") AS "reference_bases",
    ARRAY_TO_STRING(ARRAY_AGG(DISTINCT f_alt.value::STRING), ',') AS "alternate_bases",
    MAX(v."VT") AS "variant_type"
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."alternate_bases") f_alt
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY v."reference_name", v."start", v."end"
),
geno_cte AS (
  SELECT
    v."start",
    v."end",
    COUNT_IF(g.a1 = 0 AND g.a2 = 0) AS obs_hom_ref,
    COUNT_IF(g.a1 <> g.a2)          AS obs_het,
    COUNT_IF(g.a1 = 1 AND g.a2 = 1) AS obs_hom_alt,
    COUNT(*)                        AS n_genotypes
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call") fc,
       LATERAL (SELECT
                 fc.value:"genotype"[0]::NUMBER AS a1,
                 fc.value:"genotype"[1]::NUMBER AS a2) g
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY v."start", v."end"
),
stat_cte AS (
  SELECT
    g.*,
    (2*obs_hom_alt + obs_het)::FLOAT / (2*n_genotypes) AS q,  -- alt allele freq
    1 - ((2*obs_hom_alt + obs_het)::FLOAT / (2*n_genotypes))  AS p   -- ref allele freq
  FROM geno_cte g
),
hwe_cte AS (
  SELECT
    s.*,
    n_genotypes*POWER(p,2)          AS exp_hom_ref,
    2*n_genotypes*p*q               AS exp_het,
    n_genotypes*POWER(q,2)          AS exp_hom_alt,
    NVL(POWER(obs_hom_ref-(n_genotypes*POWER(p,2)),2) / NULLIF(n_genotypes*POWER(p,2),0),0) +
    NVL(POWER(obs_het-(2*n_genotypes*p*q),2)        / NULLIF(2*n_genotypes*p*q,0),0) +
    NVL(POWER(obs_hom_alt-(n_genotypes*POWER(q,2)),2) / NULLIF(n_genotypes*POWER(q,2),0),0)
      AS chi_sq
  FROM stat_cte s
)
SELECT
  a."reference_name",
  a."start",
  a."end",
  a."reference_bases",
  a."alternate_bases",
  a."variant_type",
  h.chi_sq,
  h.n_genotypes,
  h.obs_hom_ref,
  h.obs_het,
  h.obs_hom_alt,
  h.exp_hom_ref,
  h.exp_het,
  h.exp_hom_alt,
  h.q  AS alt_AF_calc,
  h.p  AS ref_AF_calc,
  v."AF"      AS AF_1KG_overall,
  v."AFR_AF",
  v."EUR_AF",
  v."AMR_AF",
  v."ASN_AF"
FROM hwe_cte h
JOIN alt_cte a
  ON a."start" = h."start" AND a."end" = h."end"
JOIN "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v
  ON v."start" = h."start" AND v."end"   = h."end"
WHERE v."reference_name" = '17'
  AND v."start" BETWEEN 41196311 AND 41277499
ORDER BY a."start";
