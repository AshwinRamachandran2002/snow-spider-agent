Query:
--Description: 7)  Add Hardy-Weinberg expected counts for each genotype class.
WITH gen AS ( /* query-5 reused */
  SELECT 
    v."start",
    v."end",
    v."alternate_bases",
    COUNT_IF(g."allele_1" = 0 AND g."allele_2" = 0) AS "obs_hom_ref",
    COUNT_IF(g."allele_1" != g."allele_2")          AS "obs_het",
    COUNT_IF(g."allele_1" = 1 AND g."allele_2" = 1) AS "obs_hom_alt",
    COUNT(*)                                        AS "n_genotypes"
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call")           f,
       LATERAL (SELECT  
                  f.value:"genotype"[0]::NUMBER AS "allele_1",
                  f.value:"genotype"[1]::NUMBER AS "allele_2") g
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY 1,2,3
)
SELECT *,
       /* allele frequency of alt */
       (2*"obs_hom_alt" + "obs_het")::FLOAT/(2*"n_genotypes")          AS q,
       1 - ((2*"obs_hom_alt" + "obs_het")::FLOAT/(2*"n_genotypes"))    AS p,
       /* expected counts */
       "n_genotypes"*POWER(1-((2*"obs_hom_alt"+ "obs_het")::FLOAT/(2*"n_genotypes")),2) AS exp_hom_ref,
       2*"n_genotypes"*((1-((2*"obs_hom_alt"+ "obs_het")::FLOAT/(2*"n_genotypes")))*((2*"obs_hom_alt"+ "obs_het")::FLOAT/(2*"n_genotypes"))) AS exp_het,
       "n_genotypes"*POWER(((2*"obs_hom_alt"+ "obs_het")::FLOAT/(2*"n_genotypes")),2)    AS exp_hom_alt
FROM gen
LIMIT 20;
