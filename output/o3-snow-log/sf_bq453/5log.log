--Description: Corrected “final consolidated answer” query (SQL-10) – 
--             column-alias ambiguities removed, proper database / schema names kept.
--             Produces all requested metrics for every variant on chr17 between
--             41 196 311 – 41 277 499.
WITH calls AS (   ----------------------------------------------------------- STEP 1
  SELECT
    v."reference_name",
    v."start",
    v."end",
    v."reference_bases",
    ARRAY_AGG(DISTINCT f_alt.value::STRING)         AS "alt_list",
    v."VT",
    f_call.value:"genotype"[0]::NUMBER              AS g0,
    f_call.value:"genotype"[1]::NUMBER              AS g1
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."alternate_bases") f_alt,
       LATERAL FLATTEN(input => v."call")            f_call
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY
    v."reference_name", v."start", v."end", v."reference_bases", v."VT",
    g0, g1
),
geno AS (        ----------------------------------------------------------- STEP 2
  SELECT
    "reference_name",
    "start",
    "end",
    "reference_bases",
    "alt_list",
    "VT",
    COUNT_IF(g0 = 0 AND g1 = 0) AS obs_hom_ref,
    COUNT_IF(g0 <> g1)          AS obs_het,
    COUNT_IF(g0 = 1 AND g1 = 1) AS obs_hom_alt,
    COUNT(*)                    AS n_genotypes
  FROM calls
  GROUP BY 1,2,3,4,5,6
),
stats AS (       ----------------------------------------------------------- STEP 3
  SELECT
    *,
    (2*obs_hom_alt + obs_het)::FLOAT / (2*n_genotypes)            AS q,  -- alt AF
    1 - ((2*obs_hom_alt + obs_het)::FLOAT / (2*n_genotypes))      AS p,  -- ref AF
    n_genotypes*POWER(p,2)                                        AS exp_hom_ref,
    2*n_genotypes*p*q                                             AS exp_het,
    n_genotypes*POWER(q,2)                                        AS exp_hom_alt,
    NVL(POWER(obs_hom_ref-(n_genotypes*POWER(p,2)),2)
        / NULLIF(n_genotypes*POWER(p,2),0),0) +
    NVL(POWER(obs_het-(2*n_genotypes*p*q),2)
        / NULLIF(2*n_genotypes*p*q,0),0) +
    NVL(POWER(obs_hom_alt-(n_genotypes*POWER(q,2)),2)
        / NULLIF(n_genotypes*POWER(q,2),0),0)                      AS chi_sq
  FROM geno
)
SELECT
  s."reference_name",
  s."start",
  s."end",
  s."reference_bases",
  ARRAY_TO_STRING(s."alt_list", ',')  AS "alternate_bases",
  s."VT"                              AS "variant_type",
  s."chi_sq",
  s."n_genotypes",
  s."obs_hom_ref",
  s."obs_het",
  s."obs_hom_alt",
  s."exp_hom_ref",
  s."exp_het",
  s."exp_hom_alt",
  s."q"                               AS "alt_frequency",
  s."p"                               AS "ref_frequency",
  v."AF"                              AS "AF_1KG_overall",
  v."AFR_AF",
  v."EUR_AF",
  v."AMR_AF",
  v."ASN_AF"
FROM stats s
JOIN "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v
  ON v."start" = s."start" AND v."end" = s."end"
WHERE v."reference_name" = '17'
  AND v."start" BETWEEN 41196311 AND 41277499
ORDER BY s."start"
