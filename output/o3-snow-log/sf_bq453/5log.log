Query:
--Description: 6)  Derive allele counts and allele frequency (q = alt-allele) per variant.
SELECT 
  gen."start",
  gen."end",
  gen."alternate_bases",
  2*gen."obs_hom_ref" + gen."obs_het"          AS "ref_allele_count",
  2*gen."obs_hom_alt" + gen."obs_het"          AS "alt_allele_count",
  gen."n_genotypes" * 2                        AS "total_alleles",
  (2*gen."obs_hom_alt" + gen."obs_het")::FLOAT 
    / NULLIF(gen."n_genotypes"*2,0)            AS "alt_AF"
FROM ( /* query-5 reused as inline view */
  SELECT 
    v."start",
    v."end",
    v."alternate_bases",
    COUNT_IF(g."allele_1" = 0 AND g."allele_2" = 0) AS "obs_hom_ref",
    COUNT_IF(g."allele_1" != g."allele_2")          AS "obs_het",
    COUNT_IF(g."allele_1" = 1 AND g."allele_2" = 1) AS "obs_hom_alt",
    COUNT(*)                                        AS "n_genotypes"
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call")           f,
       LATERAL (SELECT  
                  f.value:"genotype"[0]::NUMBER AS "allele_1",
                  f.value:"genotype"[1]::NUMBER AS "allele_2") g
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY 1,2,3
) gen
LIMIT 20;
