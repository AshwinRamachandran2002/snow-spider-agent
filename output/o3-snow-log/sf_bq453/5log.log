```sql
--Description / thinking process:
-- We need a single query that reports, for every variant on chr17 between
-- 41 196 311 and 41 277 499, the coordinates, reference / alternate alleles,
-- variant type, observed genotype counts, Hardy-Weinberg expectations,
-- χ² statistic, calculated allele-frequencies, and the 1000 Genomes AF columns.
--
-- Pipeline of CTEs:
--   1) alt_cte   – flatten alternate_bases to build a comma-separated list of
--                  distinct ALT alleles plus REF base & VT (one row per variant).
--   2) geno_cte  – flatten call array; count genotype classes (00, 01/10, 11).
--   3) stats_cte – from counts derive allele frequencies (p,q), expectations,
--                  and χ² (Σ (obs-exp)² / exp).
--   4) Final SELECT joins stats_cte ↔ alt_cte ↔ VARIANTS to expose AF columns.
-- All chromosome / position filters are applied in every CTE to keep work small.

WITH alt_cte AS (                       -- 1️⃣ REF & ALT list per variant
  SELECT
    v."reference_name",
    v."start",
    v."end",
    MAX(v."reference_bases")                                        AS reference_bases,
    ARRAY_TO_STRING(ARRAY_AGG(DISTINCT f_alt.value::STRING), ',')   AS alternate_bases,
    MAX(v."VT")                                                     AS variant_type
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."alternate_bases") f_alt
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY v."reference_name", v."start", v."end"
),
geno_cte AS (                      -- 2️⃣ observed genotype counts
  SELECT
    v."start",
    v."end",
    COUNT_IF(g.a1 = 0 AND g.a2 = 0)  AS obs_hom_ref,
    COUNT_IF(g.a1 <> g.a2)           AS obs_het,
    COUNT_IF(g.a1 = 1 AND g.a2 = 1)  AS obs_hom_alt,
    COUNT(*)                         AS n_genotypes
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call") fc,
       LATERAL (SELECT
                 fc.value:"genotype"[0]::NUMBER AS a1,
                 fc.value:"genotype"[1]::NUMBER AS a2) g
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY v."start", v."end"
),
stats_cte AS (                    -- 3️⃣ allele freq, expectations, χ²
  SELECT
    g.*,
    (2*obs_hom_alt + obs_het)::FLOAT / (2*n_genotypes)              AS q,   -- alt AF
    1 - ((2*obs_hom_alt + obs_het)::FLOAT / (2*n_genotypes))        AS p,   -- ref AF
    n_genotypes*POWER(p,2)                                          AS exp_hom_ref,
    2*n_genotypes*p*q                                               AS exp_het,
    n_genotypes*POWER(q,2)                                          AS exp_hom_alt,
    NVL(POWER(obs_hom_ref - n_genotypes*POWER(p,2),2) / NULLIF(n_genotypes*POWER(p,2),0),0) +
    NVL(POWER(obs_het     - 2*n_genotypes*p*q     ,2) / NULLIF(2*n_genotypes*p*q,0),0) +
    NVL(POWER(obs_hom_alt - n_genotypes*POWER(q,2),2) / NULLIF(n_genotypes*POWER(q,2),0),0)
                                                                  AS chi_sq
  FROM geno_cte g
)
SELECT
  a."reference_name",
  a."start",
  a."end",
  a.reference_bases,
  a.alternate_bases,
  a.variant_type,
  s.chi_sq,
  s.n_genotypes,
  s.obs_hom_ref,
  s.obs_het,
  s.obs_hom_alt,
  s.exp_hom_ref,
  s.exp_het,
  s.exp_hom_alt,
  s.q                               AS alt_frequency_calc,
  s.p                               AS ref_frequency_calc,
  v."AF"                            AS af_1kg_overall,
  v."AFR_AF",
  v."EUR_AF",
  v."AMR_AF",
  v."ASN_AF"
FROM stats_cte s
JOIN alt_cte a
  ON a."start" = s."start" AND a."end" = s."end"
JOIN "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v
  ON v."start" = s."start" AND v."end" = s."end"
WHERE v."reference_name" = '17'
  AND v."start" BETWEEN 41196311 AND 41277499
ORDER BY a."start";
