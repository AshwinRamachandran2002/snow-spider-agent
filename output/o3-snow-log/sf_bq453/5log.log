```sql
--Description: 5)  Count observed genotype classes (0/0, 0/1, 1/1) for every variant.
SELECT 
  v."start",
  v."end",
  v."alternate_bases",
  COUNT_IF(g."allele_1" = 0 AND g."allele_2" = 0) AS "obs_hom_ref",
  COUNT_IF(g."allele_1" = 0 AND g."allele_2" = 1 OR 
           g."allele_1" = 1 AND g."allele_2" = 0) AS "obs_het",
  COUNT_IF(g."allele_1" = 1 AND g."allele_2" = 1) AS "obs_hom_alt",
  COUNT(*)                                        AS "n_genotypes"
FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS"  v,
     LATERAL FLATTEN(input => v."call")           f,
     LATERAL (SELECT  
                f.value:"genotype"[0]::NUMBER AS "allele_1",
                f.value:"genotype"[1]::NUMBER AS "allele_2") g
WHERE v."reference_name" = '17'
  AND v."start" BETWEEN 41196311 AND 41277499
GROUP BY 1,2,3
LIMIT 20;
```

```sql
--Description: 6)  Derive allele counts and allele frequency (q = alt-allele) per variant.
SELECT 
  gen."start",
  gen."end",
  gen."alternate_bases",
  2*gen."obs_hom_ref" + gen."obs_het"          AS "ref_allele_count",
  2*gen."obs_hom_alt" + gen."obs_het"          AS "alt_allele_count",
  gen."n_genotypes" * 2                        AS "total_alleles",
  (2*gen."obs_hom_alt" + gen."obs_het")::FLOAT 
    / NULLIF(gen."n_genotypes"*2,0)            AS "alt_AF"
FROM ( /* query-5 reused as inline view */
  SELECT 
    v."start",
    v."end",
    v."alternate_bases",
    COUNT_IF(g."allele_1" = 0 AND g."allele_2" = 0) AS "obs_hom_ref",
    COUNT_IF(g."allele_1" != g."allele_2")          AS "obs_het",
    COUNT_IF(g."allele_1" = 1 AND g."allele_2" = 1) AS "obs_hom_alt",
    COUNT(*)                                        AS "n_genotypes"
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call")           f,
       LATERAL (SELECT  
                  f.value:"genotype"[0]::NUMBER AS "allele_1",
                  f.value:"genotype"[1]::NUMBER AS "allele_2") g
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY 1,2,3
) gen
LIMIT 20;
```

```sql
--Description: 7)  Add Hardy-Weinberg expected counts for each genotype class.
WITH gen AS ( /* query-5 reused */
  SELECT 
    v."start",
    v."end",
    v."alternate_bases",
    COUNT_IF(g."allele_1" = 0 AND g."allele_2" = 0) AS "obs_hom_ref",
    COUNT_IF(g."allele_1" != g."allele_2")          AS "obs_het",
    COUNT_IF(g."allele_1" = 1 AND g."allele_2" = 1) AS "obs_hom_alt",
    COUNT(*)                                        AS "n_genotypes"
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
       LATERAL FLATTEN(input => v."call")           f,
       LATERAL (SELECT  
                  f.value:"genotype"[0]::NUMBER AS "allele_1",
                  f.value:"genotype"[1]::NUMBER AS "allele_2") g
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY 1,2,3
)
SELECT *,
       /* allele frequency of alt */
       (2*"obs_hom_alt" + "obs_het")::FLOAT/(2*"n_genotypes")          AS q,
       1 - ((2*"obs_hom_alt" + "obs_het")::FLOAT/(2*"n_genotypes"))    AS p,
       /* expected counts */
       "n_genotypes"*POWER(1-((2*"obs_hom_alt"+ "obs_het")::FLOAT/(2*"n_genotypes")),2) AS exp_hom_ref,
       2*"n_genotypes"*((1-((2*"obs_hom_alt"+ "obs_het")::FLOAT/(2*"n_genotypes")))*((2*"obs_hom_alt"+ "obs_het")::FLOAT/(2*"n_genotypes"))) AS exp_het,
       "n_genotypes"*POWER(((2*"obs_hom_alt"+ "obs_het")::FLOAT/(2*"n_genotypes")),2)    AS exp_hom_alt
FROM gen
LIMIT 20;
```

```sql
--Description: 8)  Calculate chi-squared statistic (Σ (obs-exp)²/exp) for each variant.
WITH hwe AS ( /* query-7 reused */
  SELECT *,
         (2*"obs_hom_alt" + "obs_het")::FLOAT/(2*"n_genotypes")        AS q,
         1 - ((2*"obs_hom_alt" + "obs_het")::FLOAT/(2*"n_genotypes"))  AS p
  FROM (
    SELECT 
      v."start",
      v."end",
      v."alternate_bases",
      COUNT_IF(g."allele_1" = 0 AND g."allele_2" = 0) AS "obs_hom_ref",
      COUNT_IF(g."allele_1" != g."allele_2")          AS "obs_het",
      COUNT_IF(g."allele_1" = 1 AND g."allele_2" = 1) AS "obs_hom_alt",
      COUNT(*)                                        AS "n_genotypes"
    FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
         LATERAL FLATTEN(input => v."call")           f,
         LATERAL (SELECT  
                    f.value:"genotype"[0]::NUMBER AS "allele_1",
                    f.value:"genotype"[1]::NUMBER AS "allele_2") g
    WHERE v."reference_name" = '17'
      AND v."start" BETWEEN 41196311 AND 41277499
    GROUP BY 1,2,3
  )
)
SELECT 
  "start",
  "end",
  "alternate_bases",
  "obs_hom_ref",
  "obs_het",
  "obs_hom_alt",
  "n_genotypes",
  ("n_genotypes"*POWER(p,2))                       AS "exp_hom_ref",
  (2*"n_genotypes"*p*q)                            AS "exp_het",
  ("n_genotypes"*POWER(q,2))                       AS "exp_hom_alt",
  /* chi-squared */
  NVL(POWER("obs_hom_ref"-("n_genotypes"*POWER(p,2)),2)/NULLIF(("n_genotypes"*POWER(p,2)),0),0) +
  NVL(POWER("obs_het"    -(2*"n_genotypes"*p*q),2)/NULLIF((2*"n_genotypes"*p*q),0),0) +
  NVL(POWER("obs_hom_alt"-("n_genotypes"*POWER(q,2)),2)/NULLIF(("n_genotypes"*POWER(q,2)),0),0)  AS "chi_sq"
FROM hwe
LIMIT 20;
```

```sql
--Description: 9)  Compare calculated alt-allele frequency with pre-computed 1KG AF columns.
SELECT 
  v."start",
  v."end",
  v."AF"        AS "AF_1KG",
  calc."alt_AF" AS "AF_calc"
FROM "_1000_GENOMES"."_1000_GENES"."VARIANTS" v   -- intentional typo? should be _1000_GENOMES."_1000_GENOMES".VARIANTS
JOIN (
  /* pull alt_AF from query-6 */ 
  SELECT 
    "start",
    "end",
    (2*"obs_hom_alt" + "obs_het")::FLOAT/(2*"n_genotypes") AS "alt_AF"
  FROM ( /* query-5 reused */
    SELECT 
      v."start",
      v."end",
      COUNT_IF(g."allele_1" = 0 AND g."allele_2" = 0) AS "obs_hom_ref",
      COUNT_IF(g."allele_1" != g."allele_2")          AS "obs_het",
      COUNT_IF(g."allele_1" = 1 AND g."allele_2" = 1) AS "obs_hom_alt",
      COUNT(*)                                        AS "n_genotypes"
    FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
         LATERAL FLATTEN(input => v."call") f,
         LATERAL (SELECT  
                    f.value:"genotype"[0]::NUMBER AS "allele_1",
                    f.value:"genotype"[1]::NUMBER AS "allele_2") g
    WHERE v."reference_name" = '17'
      AND v."start" BETWEEN 41196311 AND 41277499
    GROUP BY 1,2
  )
) calc
  ON v."start" = calc."start" AND v."end" = calc."end"
WHERE v."reference_name" = '17'
  AND v."start" BETWEEN 41196311 AND 41277499
LIMIT 20;
```

```sql
--Description: 10)  Final consolidated answer – everything requested for each variant (limited to 20 rows here).
WITH calls AS (
  SELECT 
    v."reference_name",
    v."start",
    v."end",
    v."reference_bases",
    ARRAY_AGG(DISTINCT f_alt.value::STRING) AS "alt_list",
    v."VT",
    f_call.value:"genotype"[0]::NUMBER AS g0,
    f_call.value:"genotype"[1]::NUMBER AS g1
  FROM "_1000_GENOMES"."_1000_GENOMES"."VARIANTS"  v,
       LATERAL FLATTEN(input => v."alternate_bases") f_alt,
       LATERAL FLATTEN(input => v."call")            f_call
  WHERE v."reference_name" = '17'
    AND v."start" BETWEEN 41196311 AND 41277499
  GROUP BY 
    v."reference_name", v."start", v."end", v."reference_bases", v."VT",
    g0, g1
), geno AS (
  SELECT 
    "reference_name",
    "start",
    "end",
    "reference_bases",
    "alt_list",
    "VT",
    COUNT_IF(g0 = 0 AND g1 = 0) AS obs_hom_ref,
    COUNT_IF(g0 != g1)          AS obs_het,
    COUNT_IF(g0 = 1 AND g1 = 1) AS obs_hom_alt,
    COUNT(*)                    AS n_genotypes
  FROM calls
  GROUP BY 1,2,3,4,5,6
), stats AS (
  SELECT 
    *,
    (2*obs_hom_alt + obs_het)::FLOAT/(2*n_genotypes)                       AS q,
    1 - ((2*obs_hom_alt + obs_het)::FLOAT/(2*n_genotypes))                 AS p,
    n_genotypes*POWER(p,2)                                                 AS exp_hom_ref,
    2*n_genotypes*p*q                                                      AS exp_het,
    n_genotypes*POWER(q,2)                                                 AS exp_hom_alt,
    NVL(POWER(obs_hom_ref-(n_genotypes*POWER(p,2)),2)/NULLIF(n_genotypes*POWER(p,2),0),0) +
    NVL(POWER(obs_het    -(2*n_genotypes*p*q),2)/NULLIF(2*n_genotypes*p*q,0),0) +
    NVL(POWER(obs_hom_alt-(n_genotypes*POWER(q,2)),2)/NULLIF(n_genotypes*POWER(q,2),0),0) AS chi_sq
  FROM geno
)
SELECT 
  "reference_name",
  "start",
  "end",
  "reference_bases",
  ARRAY_TO_STRING("alt_list", ',')              AS "alternate_bases",
  "VT"                                          AS "variant_type",
  "chi_sq",
  n_genotypes,
  obs_hom_ref, obs_het, obs_hom_alt,
  exp_hom_ref, exp_het, exp_hom_alt,
  /* allele frequencies */
  q                                             AS "alt_frequency",
  p                                             AS "ref_frequency",
  v."AF", v."AFR_AF", v."EUR_AF", v."AMR_AF", v."ASN_AF"  -- 1KG provided AFs
FROM stats s
JOIN "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v
  ON s."start" = v."start" AND s."end" = v."end"
WHERE v."reference_name" = '17'
  AND v."start" BETWEEN 41196311 AND 41277499
LIMIT 20;
```
