```sql
--Description: 5) List clones that satisfy BOTH the chr13-loss and chr17-loss criteria
SELECT DISTINCT c13."RefNo", c13."CaseNo", c13."InvNo", c13."Clone"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  c13
JOIN   "MITELMAN"."PROD"."CYTOCONVERTED"  c17
       ON  c13."RefNo" = c17."RefNo"
       AND c13."CaseNo" = c17."CaseNo"
       AND c13."InvNo"  = c17."InvNo"
       AND c13."Clone"  = c17."Clone"
WHERE  c13."ChrOrd" = 13
  AND  c13."Type"  ILIKE '%loss%'
  AND  c13."Start" <= 48481890
  AND  c13."End"   >= 48303751
  AND  c17."ChrOrd" = 17
  AND  c17."Type"  ILIKE '%loss%'
  AND  c17."Start" <= 7687490
  AND  c17."End"   >= 7668421
LIMIT 20;
```

```sql
--Description: 6) Add the chr11-gain criterion – clones that meet ALL THREE requirements
SELECT DISTINCT c13."RefNo", c13."CaseNo", c13."InvNo", c13."Clone"
FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  c13
JOIN   "MITELMAN"."PROD"."CYTOCONVERTED"  c17
       ON  c13."RefNo" = c17."RefNo"
       AND c13."CaseNo" = c17."CaseNo"
       AND c13."InvNo"  = c17."InvNo"
       AND c13."Clone"  = c17."Clone"
JOIN   "MITELMAN"."PROD"."CYTOCONVERTED"  c11
       ON  c13."RefNo" = c11."RefNo"
       AND c13."CaseNo" = c11."CaseNo"
       AND c13."InvNo"  = c11."InvNo"
       AND c13."Clone"  = c11."Clone"
WHERE  c13."ChrOrd" = 13              -- chr-13 loss
  AND  c13."Type"  ILIKE '%loss%'
  AND  c13."Start" <= 48481890
  AND  c13."End"   >= 48303751
  AND  c17."ChrOrd" = 17              -- chr-17 loss
  AND  c17."Type"  ILIKE '%loss%'
  AND  c17."Start" <= 7687490
  AND  c17."End"   >= 7668421
  AND  c11."ChrOrd" = 11              -- chr-11 gain
  AND  c11."Type"  ILIKE '%gain%'
  AND  c11."Start" <= 108369102
  AND  c11."End"   >= 108223067
LIMIT 20;
```

```sql
--Description: 7) Join those clones to KaryClone to view their karyotype descriptions
SELECT  t."RefNo",
        t."CaseNo",
        t."InvNo",
        t."Clone",
        k."CloneShort"
FROM  ( /* the clone list with all 3 events */
       SELECT DISTINCT c13."RefNo", c13."CaseNo", c13."InvNo", c13."Clone"
       FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  c13
       JOIN   "MITELMAN"."PROD"."CYTOCONVERTED"  c17
              ON  c13."RefNo" = c17."RefNo"
             AND c13."CaseNo" = c17."CaseNo"
             AND c13."InvNo"  = c17."InvNo"
             AND c13."Clone"  = c17."Clone"
       JOIN   "MITELMAN"."PROD"."CYTOCONVERTED"  c11
              ON  c13."RefNo" = c11."RefNo"
             AND c13."CaseNo" = c11."CaseNo"
             AND c13."InvNo"  = c11."InvNo"
             AND c13."Clone"  = c11."Clone"
       WHERE  c13."ChrOrd" = 13 AND c13."Type" ILIKE '%loss%'
         AND  c13."Start" <= 48481890 AND c13."End" >= 48303751
         AND  c17."ChrOrd" = 17 AND c17."Type" ILIKE '%loss%'
         AND  c17."Start" <= 7687490  AND c17."End" >= 7668421
         AND  c11."ChrOrd" = 11 AND c11."Type" ILIKE '%gain%'
         AND  c11."Start" <= 108369102 AND c11."End" >= 108223067
     ) t
LEFT JOIN "MITELMAN"."PROD"."KARYCLONE" k
       ON k."RefNo"  = t."RefNo"
      AND k."CaseNo" = t."CaseNo"
      AND k."InvNo"  = t."InvNo"
      AND k."CloneNo"= t."Clone"
LIMIT 20;
```

```sql
--Description: 8) Display the three individual CytoConverted rows for every matching clone
SELECT  m."RefNo",
        m."CaseNo",
        m."InvNo",
        m."Clone",
        m."ChrOrd",
        m."Start",
        m."End",
        m."Type"
FROM    "MITELMAN"."PROD"."CYTOCONVERTED" m
JOIN   ( /* clones meeting all 3 criteria */ 
        SELECT DISTINCT c13."RefNo", c13."CaseNo", c13."InvNo", c13."Clone"
        FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  c13
        JOIN   "MITELMAN"."PROD"."CYTOCONVERTED"  c17
               ON  c13."RefNo" = c17."RefNo"
              AND c13."CaseNo" = c17."CaseNo"
              AND c13."InvNo"  = c17."InvNo"
              AND c13."Clone"  = c17."Clone"
        JOIN   "MITELMAN"."PROD"."CYTOCONVERTED"  c11
               ON  c13."RefNo" = c11."RefNo"
              AND c13."CaseNo" = c11."CaseNo"
              AND c13."InvNo"  = c11."InvNo"
              AND c13."Clone"  = c11."Clone"
        WHERE  c13."ChrOrd" = 13 AND c13."Type" ILIKE '%loss%'
          AND  c13."Start" <= 48481890 AND c13."End" >= 48303751
          AND  c17."ChrOrd" = 17 AND c17."Type" ILIKE '%loss%'
          AND  c17."Start" <= 7687490  AND c17."End" >= 7668421
          AND  c11."ChrOrd" = 11 AND c11."Type" ILIKE '%gain%'
          AND  c11."Start" <= 108369102 AND c11."End" >= 108223067
      ) hit
  ON  m."RefNo"  = hit."RefNo"
  AND m."CaseNo" = hit."CaseNo"
  AND m."InvNo"  = hit."InvNo"
  AND m."Clone"  = hit."Clone"
WHERE ( (m."ChrOrd" = 13 AND m."Type" ILIKE '%loss%' AND m."Start" <= 48481890 AND m."End" >= 48303751)
     OR (m."ChrOrd" = 17 AND m."Type" ILIKE '%loss%' AND m."Start" <= 7687490  AND m."End" >= 7668421)
     OR (m."ChrOrd" = 11 AND m."Type" ILIKE '%gain%' AND m."Start" <= 108369102 AND m."End" >= 108223067) )
ORDER BY m."RefNo", m."CaseNo", m."InvNo", m."Clone", m."ChrOrd"
LIMIT 20;
```

```sql
--Description: 9) Return one row per matching clone, reporting the three regions plus CloneShort
SELECT
    t."RefNo",
    t."CaseNo",
    t."InvNo",
    t."Clone",
    MAX(CASE WHEN t."ChrOrd" = 13 THEN t."Start" END) AS "Chr13_Start",
    MAX(CASE WHEN t."ChrOrd" = 13 THEN t."End"   END) AS "Chr13_End",
    MAX(CASE WHEN t."ChrOrd" = 17 THEN t."Start" END) AS "Chr17_Start",
    MAX(CASE WHEN t."ChrOrd" = 17 THEN t."End"   END) AS "Chr17_End",
    MAX(CASE WHEN t."ChrOrd" = 11 THEN t."Start" END) AS "Chr11_Start",
    MAX(CASE WHEN t."ChrOrd" = 11 THEN t."End"   END) AS "Chr11_End",
    kc."CloneShort"
FROM "MITELMAN"."PROD"."CYTOCONVERTED" t
JOIN ( /* clones with all 3 alterations */
      SELECT DISTINCT c13."RefNo", c13."CaseNo", c13."InvNo", c13."Clone"
      FROM   "MITELMAN"."PROD"."CYTOCONVERTED"  c13
      JOIN   "MITELMAN"."PROD"."CYTOCONVERTED"  c17
             ON  c13."RefNo" = c17."RefNo"
            AND c13."CaseNo" = c17."CaseNo"
            AND c13."InvNo"  = c17."InvNo"
            AND c13."Clone"  = c17."Clone"
      JOIN   "MITELMAN"."PROD"."CYTOCONVERTED"  c11
             ON  c13."RefNo" = c11."RefNo"
            AND c13."CaseNo" = c11."CaseNo"
            AND c13."InvNo"  = c11."InvNo"
            AND c13."Clone"  = c11."Clone"
      WHERE  c13."ChrOrd" = 13 AND c13."Type" ILIKE '%loss%'
        AND  c13."Start" <= 48481890 AND c13."End" >= 48303751
        AND  c17."ChrOrd" = 17 AND c17."Type" ILIKE '%loss%'
        AND  c17."Start" <= 7687490  AND c17."End" >= 7668421
        AND  c11."ChrOrd" = 11 AND c11."Type" ILIKE '%gain%'
        AND  c11."Start" <= 108369102 AND c11."End" >= 108223067
     ) c
  ON t."RefNo"  = c."RefNo"
 AND t."CaseNo" = c."CaseNo"
 AND t."InvNo"  = c."InvNo"
 AND t."Clone"  = c."Clone"
LEFT JOIN "MITELMAN"."PROD"."KARYCLONE" kc
       ON kc."RefNo"  = c."RefNo"
      AND kc."CaseNo" = c."CaseNo"
      AND kc."InvNo"  = c."InvNo"
      AND kc."CloneNo"= c."Clone"
WHERE ( (t."ChrOrd" = 13 AND t."Type" ILIKE '%loss%' AND t."Start" <= 48481890 AND t."End" >= 48303751)
    OR  (t."ChrOrd" = 17 AND t."Type" ILIKE '%loss%' AND t."Start" <= 7687490  AND t."End" >= 7668421)
    OR  (t."ChrOrd" = 11 AND t."Type" ILIKE '%gain%' AND t."Start" <= 108369102 AND t."End" >= 108223067) )
GROUP BY t."RefNo", t."CaseNo", t."InvNo", t."Clone", kc."CloneShort"
LIMIT 20;
```

