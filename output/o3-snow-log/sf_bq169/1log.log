```sql
-- Description: Intersection – clones that satisfy ALL THREE alterations
WITH chr13 AS (
  SELECT DISTINCT "RefNo","CaseNo","InvNo","Clone"
  FROM   MITELMAN.PROD.CYTOCONVERTED
  WHERE  "ChrOrd" = 13 AND "Type"='Loss'
    AND  "Start" <= 48303751 AND "End" >= 48481890
),
chr17 AS (
  SELECT DISTINCT "RefNo","CaseNo","InvNo","Clone"
  FROM   MITELMAN.PROD.CYTOCONVERTED
  WHERE  "ChrOrd" = 17 AND "Type"='Loss'
    AND  "Start" <= 7668421  AND "End" >= 7687490
),
chr11 AS (
  SELECT DISTINCT "RefNo","CaseNo","InvNo","Clone"
  FROM   MITELMAN.PROD.CYTOCONVERTED
  WHERE  "ChrOrd" = 11 AND "Type"='Gain'
    AND  "Start" <= 108223067 AND "End" >= 108369102
)
SELECT DISTINCT c13."RefNo",c13."CaseNo",c13."InvNo",c13."Clone"
FROM   chr13 c13
JOIN   chr17 c17 USING ("RefNo","CaseNo","InvNo","Clone")
JOIN   chr11 c11 USING ("RefNo","CaseNo","InvNo","Clone")
LIMIT 20;
```

```sql
-- Description: Add karyotype (CloneShort) for the intersecting clones
WITH target AS (
  /* same intersection as above */
  WITH chr13 AS (
    SELECT DISTINCT "RefNo","CaseNo","InvNo","Clone"
    FROM   MITELMAN.PROD.CYTOCONVERTED
    WHERE  "ChrOrd" = 13 AND "Type"='Loss'
      AND  "Start" <= 48303751 AND "End" >= 48481890
  ),
  chr17 AS (
    SELECT DISTINCT "RefNo","CaseNo","InvNo","Clone"
    FROM   MITELMAN.PROD.CYTOCONVERTED
    WHERE  "ChrOrd" = 17 AND "Type"='Loss'
      AND  "Start" <= 7668421 AND "End" >= 7687490
  ),
  chr11 AS (
    SELECT DISTINCT "RefNo","CaseNo","InvNo","Clone"
    FROM   MITELMAN.PROD.CYTOCONVERTED
    WHERE  "ChrOrd" = 11 AND "Type"='Gain'
      AND  "Start" <= 108223067 AND "End" >= 108369102
  )
  SELECT DISTINCT c13."RefNo",c13."CaseNo",c13."InvNo",c13."Clone"
  FROM   chr13 c13
  JOIN   chr17 c17 USING ("RefNo","CaseNo","InvNo","Clone")
  JOIN   chr11 c11 USING ("RefNo","CaseNo","InvNo","Clone")
)
SELECT DISTINCT 
       t."RefNo", t."CaseNo", t."InvNo", t."Clone",
       k."CloneShort"
FROM   target t
LEFT  JOIN MITELMAN.PROD.KARYCLONE k
       ON k."RefNo"   = t."RefNo"
      AND k."CaseNo"  = t."CaseNo"
      AND k."InvNo"   = t."InvNo"
      AND k."CloneNo" = t."Clone"
LIMIT 20;
```

```sql
-- Description: Final detailed output – chromosomal coordinates plus CloneShort
WITH chr13 AS (
  SELECT "RefNo","CaseNo","InvNo","Clone",
         "ChrOrd","Start","End"
  FROM   MITELMAN.PROD.CYTOCONVERTED
  WHERE  "ChrOrd" = 13 AND "Type"='Loss'
    AND  "Start" <= 48303751 AND "End" >= 48481890
),
chr17 AS (
  SELECT "RefNo","CaseNo","InvNo","Clone",
         "ChrOrd","Start","End"
  FROM   MITELMAN.PROD.CYTOCONVERTED
  WHERE  "ChrOrd" = 17 AND "Type"='Loss'
    AND  "Start" <= 7668421 AND "End" >= 7687490
),
chr11 AS (
  SELECT "RefNo","CaseNo","InvNo","Clone",
         "ChrOrd","Start","End"
  FROM   MITELMAN.PROD.CYTOCONVERTED
  WHERE  "ChrOrd" = 11 AND "Type"='Gain'
    AND  "Start" <= 108223067 AND "End" >= 108369102
),
intersect_clones AS (
  SELECT DISTINCT c13."RefNo",c13."CaseNo",c13."InvNo",c13."Clone"
  FROM   chr13 c13
  JOIN   chr17 c17 USING ("RefNo","CaseNo","InvNo","Clone")
  JOIN   chr11 c11 USING ("RefNo","CaseNo","InvNo","Clone")
)
SELECT DISTINCT 
       ic."RefNo", ic."CaseNo", ic."InvNo", ic."Clone",
       k."CloneShort",
       c13."ChrOrd" AS "Chr13_Ord", c13."Start" AS "Chr13_Start", c13."End" AS "Chr13_End",
       c17."ChrOrd" AS "Chr17_Ord", c17."Start" AS "Chr17_Start", c17."End" AS "Chr17_End",
       c11."ChrOrd" AS "Chr11_Ord", c11."Start" AS "Chr11_Start", c11."End" AS "Chr11_End"
FROM   intersect_clones ic
JOIN   chr13 c13 USING ("RefNo","CaseNo","InvNo","Clone")
JOIN   chr17 c17 USING ("RefNo","CaseNo","InvNo","Clone")
JOIN   chr11 c11 USING ("RefNo","CaseNo","InvNo","Clone")
LEFT  JOIN MITELMAN.PROD.KARYCLONE k
       ON k."RefNo"   = ic."RefNo"
      AND k."CaseNo"  = ic."CaseNo"
      AND k."InvNo"   = ic."InvNo"
      AND k."CloneNo" = ic."Clone"
LIMIT 20;
```
