Table full name: MITELMAN.PROD.KARYBIT
Column name: CloneNo Type: NUMBER Description: clone number
Column name: RefNo Type: NUMBER Description: reference number
Column name: Bit Type: TEXT Description: karyotype 'bit', eg '46', or 'Xy', or 'idem', etc
