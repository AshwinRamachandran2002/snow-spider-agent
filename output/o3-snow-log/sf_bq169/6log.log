[{'RefNo': 4169, 'CaseNo': '384', 'InvNo': 1, 'CloneNo': 1, 'OrderNo': 1, 'Breakpoint': '?'}, {'RefNo': 10625, 'CaseNo': '6674', 'InvNo': 1, 'CloneNo': 2, 'OrderNo': 1, 'Breakpoint': '?'}, {'RefNo': 10776, 'CaseNo': '271', 'InvNo': 1, 'CloneNo': 2, 'OrderNo': 1, 'Breakpoint': '?'}, {'RefNo': 4752, 'CaseNo': '5732', 'InvNo': 1, 'CloneNo': 1, 'OrderNo': 1, 'Breakpoint': '?12'}, {'RefNo': 2971, 'CaseNo': '69', 'InvNo': 1, 'CloneNo': 1, 'OrderNo': 1, 'Breakpoint': '?12?'}]

