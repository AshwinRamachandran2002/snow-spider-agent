Table full name: MITELMAN.PROD.MOLCLINABNORM
Column name: InvNo Type: NUMBER Description: investigation number, usually between 1 and 10
Column name: OrderNo Type: NUMBER Description: order number, between 1 and 54
Column name: RefNo Type: NUMBER Description: reference number, eg '15563'
Column name: Abnormality Type: TEXT Description: abnormality description, eg 't(19;19)(p13;p13)' or 'del(7)(q?)'
Column name: MolClin Type: TEXT Description: flag indicating molecular 'M', or clinical 'C'
