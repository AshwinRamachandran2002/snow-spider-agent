```sql
--Description: 4) Locate clones that have BOTH the chr13-loss AND chr17-loss
--              (but ignore chr11 gain for now) by grouping.
SELECT DISTINCT
       "RefNo", "CaseNo", "InvNo", "Clone"
FROM   MITELMAN.PROD.CYTOCONVERTED
WHERE ( ("Chr" = 'chr13' AND "Type" = 'Loss' AND "Start" <= 48303751 AND "End" >= 48481890)
     OR ("Chr" = 'chr17' AND "Type" = 'Loss' AND "Start" <= 7668421  AND "End" >= 7687490) )
GROUP  BY "RefNo", "CaseNo", "InvNo", "Clone"
HAVING COUNT(DISTINCT CASE WHEN "Chr" = 'chr13' THEN 'chr13' END) = 1
   AND COUNT(DISTINCT CASE WHEN "Chr" = 'chr17' THEN 'chr17' END) = 1
LIMIT  20;
```

```sql
--Description: 5) Find clones that simultaneously show
--              chr13-loss, chr17-loss AND chr11-gain.
SELECT DISTINCT
       "RefNo", "CaseNo", "InvNo", "Clone"
FROM   MITELMAN.PROD.CYTOCONVERTED
WHERE ( ("Chr" = 'chr13' AND "Type" = 'Loss' AND "Start" <= 48303751 AND "End" >= 48481890)
     OR ("Chr" = 'chr17' AND "Type" = 'Loss' AND "Start" <= 7668421  AND "End" >= 7687490)
     OR ("Chr" = 'chr11' AND "Type" = 'Gain' AND "Start" <= 108223067 AND "End" >= 108369102) )
GROUP  BY "RefNo", "CaseNo", "InvNo", "Clone"
HAVING COUNT(DISTINCT 
             CASE 
                 WHEN "Chr" = 'chr13' THEN 'chr13'
                 WHEN "Chr" = 'chr17' THEN 'chr17'
                 WHEN "Chr" = 'chr11' THEN 'chr11'
             END) = 3
LIMIT  20;
```

```sql
--Description: 6) Inspect the karyotype descriptions (CloneShort) of the
--              candidate clones from step 5 by joining to KARYCLONE.
SELECT DISTINCT
       c."RefNo", c."CaseNo", c."InvNo", c."Clone"      AS "CloneNo",
       k."CloneShort"
FROM   (
        SELECT DISTINCT "RefNo", "CaseNo", "InvNo", "Clone"
        FROM   MITELMAN.PROD.CYTOCONVERTED
        WHERE ( ("Chr" = 'chr13' AND "Type" = 'Loss' AND "Start" <= 48303751 AND "End" >= 48481890)
             OR ("Chr" = 'chr17' AND "Type" = 'Loss' AND "Start" <= 7668421  AND "End" >= 7687490)
             OR ("Chr" = 'chr11' AND "Type" = 'Gain' AND "Start" <= 108223067 AND "End" >= 108369102) )
        GROUP  BY "RefNo", "CaseNo", "InvNo", "Clone"
        HAVING COUNT(DISTINCT 
                     CASE 
                         WHEN "Chr" = 'chr13' THEN 'chr13'
                         WHEN "Chr" = 'chr17' THEN 'chr17'
                         WHEN "Chr" = 'chr11' THEN 'chr11'
                     END) = 3
       ) c
JOIN   MITELMAN.PROD.KARYCLONE k
  ON   k."RefNo"  = c."RefNo"
 AND   k."CaseNo" = c."CaseNo"
 AND   k."InvNo"  = c."InvNo"
 AND   k."CloneNo"= c."Clone"
LIMIT  20;
```

```sql
--Description: 7) Retrieve full chromosomal details for EACH of the three
--              regions for every matching clone, plus the karyotype text.
SELECT DISTINCT
       base."RefNo",
       base."CaseNo",
       base."InvNo",
       base."Clone"                       AS "CloneNo",
       k."CloneShort",

       chr13."ChrOrd"  AS "Chr13_Ord",
       chr13."Start"   AS "Chr13_Start",
       chr13."End"     AS "Chr13_End",

       chr17."ChrOrd"  AS "Chr17_Ord",
       chr17."Start"   AS "Chr17_Start",
       chr17."End"     AS "Chr17_End",

       chr11."ChrOrd"  AS "Chr11_Ord",
       chr11."Start"   AS "Chr11_Start",
       chr11."End"     AS "Chr11_End"

FROM   (
        /* clones fulfilling all three alterations */
        SELECT DISTINCT "RefNo", "CaseNo", "InvNo", "Clone"
        FROM   MITELMAN.PROD.CYTOCONVERTED
        WHERE ( ("Chr" = 'chr13' AND "Type" = 'Loss' AND "Start" <= 48303751 AND "End" >= 48481890)
             OR ("Chr" = 'chr17' AND "Type" = 'Loss' AND "Start" <= 7668421  AND "End" >= 7687490)
             OR ("Chr" = 'chr11' AND "Type" = 'Gain' AND "Start" <= 108223067 AND "End" >= 108369102) )
        GROUP  BY "RefNo", "CaseNo", "InvNo", "Clone"
        HAVING COUNT(DISTINCT 
                     CASE 
                         WHEN "Chr" = 'chr13' THEN 'chr13'
                         WHEN "Chr" = 'chr17' THEN 'chr17'
                         WHEN "Chr" = 'chr11' THEN 'chr11'
                     END) = 3
       ) base
/* join each of the three chromosomal rows */
JOIN   MITELMAN.PROD.CYTOCONVERTED chr13
  ON   chr13."RefNo" = base."RefNo"
 AND   chr13."CaseNo"= base."CaseNo"
 AND   chr13."InvNo" = base."InvNo"
 AND   chr13."Clone" = base."Clone"
 AND   chr13."Chr"   = 'chr13'
 AND   chr13."Type"  = 'Loss'
 AND   chr13."Start" <= 48303751
 AND   chr13."End"   >= 48481890

JOIN   MITELMAN.PROD.CYTOCONVERTED chr17
  ON   chr17."RefNo" = base."RefNo"
 AND   chr17."CaseNo"= base."CaseNo"
 AND   chr17."InvNo" = base."InvNo"
 AND   chr17."Clone" = base."Clone"
 AND   chr17."Chr"   = 'chr17'
 AND   chr17."Type"  = 'Loss'
 AND   chr17."Start" <= 7668421
 AND   chr17."End"   >= 7687490

JOIN   MITELMAN.PROD.CYTOCONVERTED chr11
  ON   chr11."RefNo" = base."RefNo"
 AND   chr11."CaseNo"= base."CaseNo"
 AND   chr11."InvNo" = base."InvNo"
 AND   chr11."Clone" = base."Clone"
 AND   chr11."Chr"   = 'chr11'
 AND   chr11."Type"  = 'Gain'
 AND   chr11."Start" <= 108223067
 AND   chr11."End"   >= 108369102

JOIN   MITELMAN.PROD.KARYCLONE k
  ON   k."RefNo"   = base."RefNo"
 AND   k."CaseNo"  = base."CaseNo"
 AND   k."InvNo"   = base."InvNo"
 AND   k."CloneNo" = base."Clone"
LIMIT  20;
```

```sql
--Description: 8) Count how many such clones exist in the entire database.
SELECT COUNT(*) AS "Total_Clones_with_All_3_Alterations"
FROM (
      SELECT "RefNo", "CaseNo", "InvNo", "Clone"
      FROM   MITELMAN.PROD.CYTOCONVERTED
      WHERE ( ("Chr" = 'chr13' AND "Type" = 'Loss' AND "Start" <= 48303751 AND "End" >= 48481890)
           OR ("Chr" = 'chr17' AND "Type" = 'Loss' AND "Start" <= 7668421  AND "End" >= 7687490)
           OR ("Chr" = 'chr11' AND "Type" = 'Gain' AND "Start" <= 108223067 AND "End" >= 108369102) )
      GROUP  BY "RefNo", "CaseNo", "InvNo", "Clone"
      HAVING COUNT(DISTINCT 
                   CASE 
                       WHEN "Chr" = 'chr13' THEN 'chr13'
                       WHEN "Chr" = 'chr17' THEN 'chr17'
                       WHEN "Chr" = 'chr11' THEN 'chr11'
                   END) = 3
     ) q;
```

```sql
--Description: 9) Display full karyotype strings (long if available, else short)
--              for any reference that contains ≥1 qualifying clone.
SELECT DISTINCT
       k."RefNo",
       COALESCE(ki."KaryLong", ki."KaryShort") AS "Karyotype"
FROM   (
        SELECT DISTINCT "RefNo"
        FROM   MITELMAN.PROD.CYTOCONVERTED
        WHERE ( ("Chr" = 'chr13' AND "Type" = 'Loss' AND "Start" <= 48303751 AND "End" >= 48481890)
             OR ("Chr" = 'chr17' AND "Type" = 'Loss' AND "Start" <= 7668421  AND "End" >= 7687490)
             OR ("Chr" = 'chr11' AND "Type" = 'Gain' AND "Start" <= 108223067 AND "End" >= 108369102) )
        GROUP  BY "RefNo", "CaseNo", "InvNo", "Clone"
        HAVING COUNT(DISTINCT 
                     CASE 
                         WHEN "Chr" = 'chr13' THEN 'chr13'
                         WHEN "Chr" = 'chr17' THEN 'chr17'
                         WHEN "Chr" = 'chr11' THEN 'chr11'
                     END) = 3
       ) k
JOIN   MITELMAN.PROD.CYTOGENINV ki
  ON   ki."RefNo" = k."RefNo"
LIMIT  20;
```

```sql
--Description: 10) Show which publications reported the qualifying clones
--               (authors & year) by joining REFERENCE.
SELECT DISTINCT
       r."RefNo",
       r."Abbreviation",
       r."Year",
       r."Journal"
FROM  MITELMAN.PROD.REFERENCE r
JOIN (
      SELECT DISTINCT "RefNo"
      FROM   MITELMAN.PROD.CYTOCONVERTED
      WHERE ( ("Chr" = 'chr13' AND "Type" = 'Loss' AND "Start" <= 48303751 AND "End" >= 48481890)
           OR ("Chr" = 'chr17' AND "Type" = 'Loss' AND "Start" <= 7668421  AND "End" >= 7687490)
           OR ("Chr" = 'chr11' AND "Type" = 'Gain' AND "Start" <= 108223067 AND "End" >= 108369102) )
      GROUP  BY "RefNo", "CaseNo", "InvNo", "Clone"
      HAVING COUNT(DISTINCT 
                   CASE 
                       WHEN "Chr" = 'chr13' THEN 'chr13'
                       WHEN "Chr" = 'chr17' THEN 'chr17'
                       WHEN "Chr" = 'chr11' THEN 'chr11'
                   END) = 3
     ) x
ON  r."RefNo" = x."RefNo"
LIMIT  20;
```
