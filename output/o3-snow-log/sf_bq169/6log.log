SELECT DISTINCT
       base."RefNo",
       base."CaseNo",
       base."InvNo",
       base."Clone"                       AS "CloneNo",
       k."CloneShort",

       chr13."ChrOrd"  AS "Chr13_Ord",
       chr13."Start"   AS "Chr13_Start",
       chr13."End"     AS "Chr13_End",

