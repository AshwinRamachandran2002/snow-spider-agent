```sql
--Description: 8)  Find clones that simultaneously satisfy all three conditions
WITH chr13_loss AS (
        SELECT DISTINCT "RefNo", "CaseNo", "InvNo", "Clone"
        FROM "MITELMAN"."PROD"."CYTOCONVERTED"
        WHERE "ChrOrd" = 13
          AND "Type"  ILIKE '%Loss%'
          AND "Start" <= 48481890
          AND "End"   >= 48303751
), chr17_loss AS (
        SELECT DISTINCT "RefNo", "CaseNo", "InvNo", "Clone"
        FROM "MITELMAN"."PROD"."CYTOCONVERTED"
        WHERE "ChrOrd" = 17
          AND "Type"  ILIKE '%Loss%'
          AND "Start" <= 7687490
          AND "End"   >= 7668421
), chr11_gain AS (
        SELECT DISTINCT "RefNo", "CaseNo", "InvNo", "Clone"
        FROM "MITELMAN"."PROD"."CYTOCONVERTED"
        WHERE "ChrOrd" = 11
          AND "Type"  ILIKE '%Gain%'
          AND "Start" <= 108369102
          AND "End"   >= 108223067
)
SELECT DISTINCT c13."RefNo", c13."CaseNo", c13."InvNo", c13."Clone"
FROM chr13_loss c13
JOIN chr17_loss c17 USING ("RefNo","CaseNo","InvNo","Clone")
JOIN chr11_gain c11 USING ("RefNo","CaseNo","InvNo","Clone")
LIMIT 20;
```

```sql
--Description: 9)  Show the three alteration rows for each intersecting clone
WITH targets AS (
        /* same CTE from query 8 */
        SELECT DISTINCT c13."RefNo", c13."CaseNo", c13."InvNo", c13."Clone"
        FROM (
                SELECT DISTINCT "RefNo","CaseNo","InvNo","Clone"
                FROM "MITELMAN"."PROD"."CYTOCONVERTED"
                WHERE "ChrOrd" = 13 AND "Type" ILIKE '%Loss%' AND "Start" <= 48481890 AND "End" >= 48303751
             ) c13
        JOIN (
                SELECT DISTINCT "RefNo","CaseNo","InvNo","Clone"
                FROM "MITELMAN"."PROD"."CYTOCONVERTED"
                WHERE "ChrOrd" = 17 AND "Type" ILIKE '%Loss%' AND "Start" <= 7687490 AND "End" >= 7668421
             ) c17 USING ("RefNo","CaseNo","InvNo","Clone")
        JOIN (
                SELECT DISTINCT "RefNo","CaseNo","InvNo","Clone"
                FROM "MITELMAN"."PROD"."CYTOCONVERTED"
                WHERE "ChrOrd" = 11 AND "Type" ILIKE '%Gain%' AND "Start" <= 108369102 AND "End" >= 108223067
             ) c11 USING ("RefNo","CaseNo","InvNo","Clone")
)
SELECT cv."RefNo",
       cv."CaseNo",
       cv."InvNo",
       cv."Clone",
       cv."ChrOrd",
       cv."Start",
       cv."End",
       cv."Type"
FROM "MITELMAN"."PROD"."CYTOCONVERTED" cv
JOIN targets            t
  ON cv."RefNo"  = t."RefNo"
 AND cv."CaseNo" = t."CaseNo"
 AND cv."InvNo"  = t."InvNo"
 AND cv."Clone"  = t."Clone"
WHERE (cv."ChrOrd" = 13 AND cv."Type" ILIKE '%Loss%' AND cv."Start" <= 48481890 AND cv."End" >= 48303751)
   OR (cv."ChrOrd" = 17 AND cv."Type" ILIKE '%Loss%' AND cv."Start" <= 7687490  AND cv."End" >= 7668421)
   OR (cv."ChrOrd" = 11 AND cv."Type" ILIKE '%Gain%' AND cv."Start" <= 108369102 AND cv."End" >= 108223067)
ORDER BY cv."RefNo", cv."CaseNo", cv."InvNo", cv."Clone", cv."ChrOrd"
LIMIT 20;
```

```sql
--Description: 10)  Attach the karyotype (CloneShort) for every matching clone
WITH targets AS (
        SELECT DISTINCT c13."RefNo", c13."CaseNo", c13."InvNo", c13."Clone"
        FROM (
                SELECT DISTINCT "RefNo","CaseNo","InvNo","Clone"
                FROM "MITELMAN"."PROD"."CYTOCONVERTED"
                WHERE "ChrOrd" = 13 AND "Type" ILIKE '%Loss%' AND "Start" <= 48481890 AND "End" >= 48303751
             ) c13
        JOIN (
                SELECT DISTINCT "RefNo","CaseNo","InvNo","Clone"
                FROM "MITELMAN"."PROD"."CYTOCONVERTED"
                WHERE "ChrOrd" = 17 AND "Type" ILIKE '%Loss%' AND "Start" <= 7687490 AND "End" >= 7668421
             ) c17 USING ("RefNo","CaseNo","InvNo","Clone")
        JOIN (
                SELECT DISTINCT "RefNo","CaseNo","InvNo","Clone"
                FROM "MITELMAN"."PROD"."CYTOCONVERTED"
                WHERE "ChrOrd" = 11 AND "Type" ILIKE '%Gain%' AND "Start" <= 108369102 AND "End" >= 108223067
             ) c11 USING ("RefNo","CaseNo","InvNo","Clone")
)
SELECT DISTINCT t."RefNo",
       t."CaseNo",
       t."InvNo",
       t."Clone" AS "CloneNo",
       kc."CloneShort"
FROM targets                        t
LEFT JOIN "MITELMAN"."PROD"."KARYCLONE" kc
  ON kc."RefNo"  = t."RefNo"
 AND kc."CaseNo" = t."CaseNo"
 AND kc."InvNo"  = t."InvNo"
 AND kc."CloneNo"= t."Clone"
LIMIT 20;
```
