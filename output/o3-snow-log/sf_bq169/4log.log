--Description: 8)  Find clones that simultaneously satisfy all three conditions
WITH chr13_loss AS (
        SELECT DISTINCT "RefNo", "CaseNo", "InvNo", "Clone"
        FROM "MITELMAN"."PROD"."CYTOCONVERTED"
        WHERE "ChrOrd" = 13
          AND "Type"  ILIKE '%Loss%'
          AND "Start" <= 48481890
          AND "End"   >= 48303751
), chr17_loss AS (
        SELECT DISTINCT "RefNo", "CaseNo", "InvNo", "Clone"
        FROM "MITELMAN"."PROD"."CYTOCONVERTED"
        WHERE "ChrOrd" = 17
          AND "Type"  ILIKE '%Loss%'
          AND "Start" <= 7687490
          AND "End"   >= 7668421
), chr11_gain AS (
        SELECT DISTINCT "RefNo", "CaseNo", "InvNo", "Clone"
        FROM "MITELMAN"."PROD"."CYTOCONVERTED"
        WHERE "ChrOrd" = 11
          AND "Type"  ILIKE '%Gain%'
          AND "Start" <= 108369102
          AND "End"   >= 108223067
)
SELECT DISTINCT c13."RefNo", c13."CaseNo", c13."InvNo", c13."Clone"
FROM chr13_loss c13
JOIN chr17_loss c17 USING ("RefNo","CaseNo","InvNo","Clone")
JOIN chr11_gain c11 USING ("RefNo","CaseNo","InvNo","Clone")
LIMIT 20;
Answer:
RefNo,CaseNo,InvNo,Clone
