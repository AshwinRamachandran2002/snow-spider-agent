Table full name: MITELMAN.PROD.MOLCLINBREAK
Column name: RefNo Type: NUMBER Description: reference number, eg '15563'
Column name: MolClin Type: TEXT Description: flag indicating either molecular 'M', or clinical 'C'
Column name: Breakpoint Type: TEXT Description: breakpoint description, eg '19p13' or '12q2?3', etc
Column name: InvNo Type: NUMBER Description: investigation number, usually between 1 and 10
Column name: OrderNo Type: NUMBER Description: order number, between 1 and 68
