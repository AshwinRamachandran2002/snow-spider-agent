[{'MolClin': 'C', 'RefNo': 4541, 'InvNo': 1, 'OrderNo': 1, 'Prefix': None, 'Gene': 'PML::RARA', 'Suffix': None}, {'MolClin': 'C', 'RefNo': 4748, 'InvNo': 1, 'OrderNo': 1, 'Prefix': None, 'Gene': 'PML::RARA', 'Suffix': None}, {'MolClin': 'C', 'RefNo': 4994, 'InvNo': 1, 'OrderNo': 1, 'Prefix': None, 'Gene': 'TCF3::PBX1', 'Suffix': None}, {'MolClin': 'C', 'RefNo': 5666, 'InvNo': 1, 'OrderNo': 1, 'Prefix': None, 'Gene': 'RUNX1::RUNX1T1', 'Suffix': None}, {'MolClin': 'C', 'RefNo': 5750, 'InvNo': 1, 'OrderNo': 1, 'Prefix': None, 'Gene': 'ZBTB16::RARA', 'Suffix': None}]

