-- 8)  Same idea for the Chr 17-loss segment
SELECT 
       d."RefNo",
       d."CaseNo",
       d."InvNo",
       d."Clone",
       d."ChrOrd"  AS "ChrOrd_17",
       d."Start"   AS "Start_17",
       d."End"     AS "End_17"
FROM   MITELMAN.PROD.CYTOCONVERTED d
WHERE  d."ChrOrd" = 17
  AND  d."Type"   = 'Loss'
  AND  d."Start" <= 7668421
  AND  d."End"   >= 7687490
  AND (d."RefNo","CaseNo","InvNo","Clone") IN (
       /* identical sub-query to step 7 omitted for brevity */
       SELECT a."RefNo", a."CaseNo", a."InvNo", a."Clone"
       FROM   MITELMAN.PROD.CYTOCONVERTED a
       JOIN   MITELMAN.PROD.CYTOCONVERTED b
             ON a."RefNo"  = b."RefNo"
            AND a."CaseNo" = b."CaseNo"
            AND a."InvNo"  = b."InvNo"
            AND a."Clone"  = b."Clone"
       JOIN   MITELMAN.PROD.CYTOCONVERTED c
