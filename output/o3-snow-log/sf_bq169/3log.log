-- 6)  Preview of matching clones with their karyotype (CloneShort) added
SELECT DISTINCT
       x."RefNo",
       x."CaseNo",
       x."InvNo",
       x."Clone"         AS "CloneNo",
       k."CloneShort"
FROM (
       /* sub-query from step 5 */
       SELECT DISTINCT
              a."RefNo",
              a."CaseNo",
              a."InvNo",
              a."Clone"
       FROM   MITELMAN.PROD.CYTOCONVERTED a
       JOIN   MITELMAN.PROD.CYTOCONVERTED b
              ON a."RefNo"  = b."RefNo"
             AND a."CaseNo" = b."CaseNo"
             AND a."InvNo"  = b."InvNo"
             AND a."Clone"  = b."Clone"
       JOIN   MITELMAN.PROD.CYTOCONVERTED c
              ON a."RefNo"  = c."RefNo"
             AND a."CaseNo" = c."CaseNo"
             AND a."InvNo"  = c."InvNo"
             AND a."Clone"  = c."Clone"
       WHERE  a."ChrOrd" = 13
         AND  a."Type"   = 'Loss'
         AND  a."Start" <= 48303751
         AND  a."End"   >= 48481890
         AND  b."ChrOrd" = 17
         AND  b."Type"   = 'Loss'
         AND  b."Start" <= 7668421
         AND  b."End"   >= 7687490
         AND  c."ChrOrd" = 11
         AND  c."Type"   = 'Gain'
         AND  c."Start" <= 108223067
         AND  c."End"   >= 108369102
     )  x
LEFT JOIN MITELMAN.PROD.KARYCLONE k
       ON k."RefNo"   = x."RefNo"
      AND k."CaseNo"  = x."CaseNo"
      AND k."InvNo"   = x."InvNo"
      AND k."CloneNo" = x."Clone"
LIMIT  20;
