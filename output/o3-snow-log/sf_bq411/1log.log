```sql
--Description: Verify which rows inside the window fall on Monday-through-Friday
SELECT "week",
       TO_CHAR("week", 'DY')    AS "weekday_abbr",
       DATE_PART('DOW', "week") AS "weekday_num",
       "term",
       "rank"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DATE_PART('DOW', "week") BETWEEN 1 AND 5          -- 1 = Monday … 5 = Friday in Snowflake
ORDER BY "week", "rank"
LIMIT 20;
```

```sql
--Description: How many distinct “rank” values appear in the filtered weekday window
