Query:
--Description: Final pull of top-three Google Trends terms (ranks 1-3) between
--1-Sep-2024 and 14-Sep-2024, grouped by “refresh_date” and ordered newest-to-oldest.
--Weekday filtering has been removed because “week” appears to map to a single day
--(likely Sunday) for each week, and excluding it would discard all relevant data.
SELECT "refresh_date",
       "week",
       "rank",
       "term",
       "dma_name",
       "dma_id"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1, 2, 3)
ORDER BY "refresh_date" DESC,
         "rank" ASC,
         "term"
LIMIT 20
