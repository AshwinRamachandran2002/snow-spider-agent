       TO_CHAR("week", 'DY') AS "weekday_abbr"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DATE_PART('DOW', "week") BETWEEN 1 AND 5
LIMIT 20;
```

```sql
--Description: FINAL – top three Google-Trends search terms (ranks 1-3) 
