FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DATE_PART('DOW', "week") BETWEEN 1 AND 5
ORDER BY "rank"
LIMIT 20;
```

```sql
--Description: Preview terms whose ranks are 1, 2 or 3 in the weekday window
SELECT "week",
       "term",
       "rank",
       "dma_name",
       "refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DATE_PART('DOW', "week") BETWEEN 1 AND 5
  AND "rank" IN (1,2,3)
ORDER BY "week", "rank"
LIMIT 20;
```

```sql
--Description: Count of qualifying rows per “refresh_date” (handy for later grouping)
SELECT "refresh_date",
       COUNT(*) AS "rows_in_scope"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND DATE_PART('DOW', "week") BETWEEN 1 AND 5
  AND "rank" IN (1,2,3)
GROUP BY "refresh_date"
ORDER BY "refresh_date" DESC
LIMIT 20;
```

```sql
--Description: Double-check distinct weekday names for each “refresh_date”
