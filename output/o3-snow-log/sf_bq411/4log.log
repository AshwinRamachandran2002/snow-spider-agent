Query:
--Description: 9) Check counts to ensure exactly three terms per week for every refresh_date.
--Refresh_date filter keeps the scan efficient and avoids full-table scans.
SELECT
    "refresh_date",
    "week",
    COUNT(*) AS "n_terms"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1, 2, 3)
  AND "refresh_date" BETWEEN '2024-09-01' AND '2024-10-31'
GROUP BY "refresh_date", "week"
ORDER BY "refresh_date" DESC
LIMIT 20
