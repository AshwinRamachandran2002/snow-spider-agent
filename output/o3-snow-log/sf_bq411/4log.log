FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
LIMIT 20;
```

```sql
--Description: 3) Within that window keep only the top-three ranks
SELECT *
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1,2,3)
LIMIT 20;
```

```sql
--Description: 4) Add weekday filter (Monday=2 … Friday=6 in Snowflake’s DAYOFWEEK)
SELECT *
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1,2,3)
  AND DAYOFWEEK("week") BETWEEN 2 AND 6   -- Monday-Friday
LIMIT 20;
```

```sql
--Description: 5) Inspect distinct refresh_date values present in the narrowed data set
SELECT DISTINCT "refresh_date"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1,2,3)
  AND DAYOFWEEK("week") BETWEEN 2 AND 6
ORDER BY "refresh_date" DESC
LIMIT 20;
```

```sql
--Description: 6) Show the three terms for each weekday + refresh_date, ordering newest first
SELECT "refresh_date",
       "week",
       "rank",
       "term"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1,2,3)
  AND DAYOFWEEK("week") BETWEEN 2 AND 6
ORDER BY "refresh_date" DESC, "week", "rank"
LIMIT 20;
```

```sql
--Description: 7) Aggregate per refresh_date & week, concatenating the three terms (ordered by rank)
SELECT "refresh_date",
       "week",
       LISTAGG("term", ', ' ORDER BY "rank") AS "top_three_terms"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1,2,3)
  AND DAYOFWEEK("week") BETWEEN 2 AND 6
GROUP BY "refresh_date", "week"
ORDER BY "refresh_date" DESC
LIMIT 20;
```

```sql
--Description: 8) Collapse to refresh_date level (pooling all weekdays under each refresh_date)
SELECT "refresh_date",
       LISTAGG(DISTINCT "week"::STRING, ', ' ORDER BY "week")        AS "included_weeks",
       LISTAGG(DISTINCT "term"      , ', ' ORDER BY MIN("rank"))    AS "unique_terms"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1,2,3)
  AND DAYOFWEEK("week") BETWEEN 2 AND 6
GROUP BY "refresh_date"
ORDER BY "refresh_date" DESC
LIMIT 20;
```

```sql
--Description: 9) Check counts to ensure exactly three terms per weekday for every refresh_date
SELECT "refresh_date",
       "week",
       COUNT(*) AS "n_terms"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1,2,3)
  AND DAYOFWEEK("week") BETWEEN 2 AND 6
GROUP BY "refresh_date", "week"
ORDER BY "refresh_date" DESC
LIMIT 20;
```

```sql
--Description: 10) Final query: top-three terms (ranks 1-3) for each Mon–Fri weekday between Sept 1–14 2024, grouped by refresh_date and ordered newest first
SELECT "refresh_date",
       "week",
       "rank",
       "term"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1,2,3)
  AND DAYOFWEEK("week") BETWEEN 2 AND 6  -- Monday-Friday
ORDER BY "refresh_date" DESC, "week", "rank"
LIMIT 20;
```
