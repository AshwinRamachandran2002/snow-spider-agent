Query:
--Description: 10) Final query: top-three terms (ranks 1-3) for weeks 1–14 Sep 2024,
--ordered by the most recent refresh_date first.  The refresh_date filter prevents
--long scans and mirrors the constraint used in earlier queries.
SELECT
    "refresh_date",
    "week",
    "rank",
    "term"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1, 2, 3)
  AND "refresh_date" BETWEEN '2024-09-01' AND '2024-10-31'
ORDER BY "refresh_date" DESC, "week", "rank"
LIMIT 20
