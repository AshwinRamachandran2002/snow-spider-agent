```sql
--Description: Return a de-duplicated list of “refresh_date” values tied to rows
--ranked 1–3 for weeks between 1 Sep 2024 and 14 Sep 2024.  To avoid the prior
--timeout, the query (1) limits the scan by both week and refresh_date windows
--and (2) removes duplicates with a ROW_NUMBER() window function instead of
--DISTINCT/GROUP BY, which can be more efficient on large tables.
SELECT
    "refresh_date"
FROM (
    SELECT
        "refresh_date",
        ROW_NUMBER() OVER (PARTITION BY "refresh_date") AS rn
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
    WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
      AND "rank" IN (1, 2, 3)
      AND "refresh_date" BETWEEN '2024-09-01' AND '2024-10-31'
)
WHERE rn = 1
ORDER BY "refresh_date" DESC
LIMIT 20;
```
