/* Retrieve ranks 1–3 from TOP_TERMS that fall on Monday-through-Friday
   between 2024-09-01 and 2024-09-14, grouped (i.e., listed) by
   “refresh_date” and ordered with the most-recent refresh first          */

SELECT
    "refresh_date",
    "week",
    "term",
    "rank"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1, 2, 3)
  AND DAYOFWEEK_ISO("week") BETWEEN 1 AND 5          -- 1=Mon … 5=Fri
ORDER BY
    "refresh_date" DESC NULLS LAST,                  -- latest refresh first
    "week",
    "rank";
```
