--Description: Verify whether ranks 1, 2, and 3 occur at all between 2024-09-01 and 2024-09-14
SELECT DISTINCT "rank"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1, 2, 3)
ORDER BY "rank"
LIMIT 20
