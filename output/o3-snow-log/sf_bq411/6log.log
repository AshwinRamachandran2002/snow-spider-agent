Query:
--Description: Check which weekdays (1=Sun … 7=Sat) occur for rows in the same time-window
SELECT DISTINCT DAYOFWEEK("week") AS "weekday_num"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
ORDER BY "weekday_num"
LIMIT 20;
