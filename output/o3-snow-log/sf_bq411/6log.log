Query:
--Description: Count rows with ranks 1–3 for each “refresh_date” in the same window
SELECT
    "refresh_date",
    COUNT(*) AS "cnt_rank_1_3"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND "rank" IN (1, 2, 3)
GROUP BY "refresh_date"
ORDER BY "refresh_date" DESC
LIMIT 20
