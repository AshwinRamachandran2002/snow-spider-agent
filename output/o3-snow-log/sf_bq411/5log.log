```sql
--Description: Earlier we saw that only October 2024 refresh dates are present.  
--             This query returns, for each such “refresh_date”, the three distinct search terms
--             with ranks 1-3, concatenated in rank order.  LISTAGG(DISTINCT …) eliminates thousands
--             of duplicate rows (same term repeated for every DMA) while WITHIN GROUP preserves the
--             correct rank sequence.
SELECT
    "refresh_date",
    LISTAGG(DISTINCT "term", ', ') WITHIN GROUP (ORDER BY "rank") AS "top3_terms"
FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
WHERE "refresh_date" >= '2024-10-01'
  AND "refresh_date" <  '2024-11-01'
  AND "rank" IN (1, 2, 3)
GROUP BY "refresh_date"
ORDER BY "refresh_date" DESC
LIMIT 20;
