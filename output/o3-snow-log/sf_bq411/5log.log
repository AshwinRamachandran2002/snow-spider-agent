```sql
--Description:  A row-number approach that first orders per refresh_date by rank, then filters to the three best rows (weekday-only), preserving individual rows.
WITH ranked AS (
  SELECT
    "refresh_date",
    "week",
    "term",
    "rank",
    ROW_NUMBER() OVER (PARTITION BY "refresh_date" ORDER BY "rank") AS rn
  FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
  WHERE "refresh_date" BETWEEN '2024-09-01' AND '2024-09-14'
    AND "rank" IN (1,2,3)
    AND DAYOFWEEK("week") BETWEEN 1 AND 5
)
SELECT
  "refresh_date",
  "week",
  "term",
  "rank"
FROM ranked
WHERE rn <= 3
ORDER BY "refresh_date" DESC, "rank"
LIMIT 20;
```

```sql
--Description:  For each weekday refresh_date produce the three rows in a single lateral pivot style (max 3), keeping them side-by-side for easy reading.
WITH base AS (
  SELECT
    "refresh_date",
    "term",
    "rank"
  FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
  WHERE "refresh_date" BETWEEN '2024-09-01' AND '2024-09-14'
    AND "rank" IN (1,2,3)
    AND DAYOFWEEK("week") BETWEEN 1 AND 5
)
SELECT
  "refresh_date",
  MAX(CASE WHEN "rank" = 1 THEN "term" END) AS "rank_1_term",
  MAX(CASE WHEN "rank" = 2 THEN "term" END) AS "rank_2_term",
  MAX(CASE WHEN "rank" = 3 THEN "term" END) AS "rank_3_term"
FROM base
GROUP BY "refresh_date"
ORDER BY "refresh_date" DESC
LIMIT 20;
