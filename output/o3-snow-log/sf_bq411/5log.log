Query:
--Description: Same pivot as above but also shows the associated “week” (picked with MIN(week))
--             for each rank.  Uses the dedup layer to ensure only one row per (date, rank).
WITH per_rank AS (
    SELECT
        "refresh_date",
        "rank",
        MIN("term") AS "term",
        MIN("week") AS "week"     -- pick one week value
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
    WHERE "refresh_date" >= '2024-01-01'
      AND "refresh_date" <  '2025-01-01'
      AND "rank" IN (1,2,3)
    GROUP BY "refresh_date", "rank"
)
SELECT
    "refresh_date",
    MAX(CASE WHEN "rank" = 1 THEN "term" END) AS "rank_1_term",
    MAX(CASE WHEN "rank" = 1 THEN "week" END) AS "rank_1_week",
    MAX(CASE WHEN "rank" = 2 THEN "term" END) AS "rank_2_term",
    MAX(CASE WHEN "rank" = 2 THEN "week" END) AS "rank_2_week",
    MAX(CASE WHEN "rank" = 3 THEN "term" END) AS "rank_3_term",
    MAX(CASE WHEN "rank" = 3 THEN "week" END) AS "rank_3_week"
FROM per_rank
GROUP BY "refresh_date"
ORDER BY "refresh_date" DESC
LIMIT 20
