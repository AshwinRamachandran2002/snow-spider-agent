```sql
--Description:  LISTAGG kept failing because ORDER BY must be inside WITHIN GROUP and DISTINCT prevents
--              ordering by a different column.  To avoid duplicates (same term repeated for every DMA),
--              first condense the data so each (refresh_date, rank) combination appears only once,
--              selecting a representative term with MIN(term).  Then LISTAGG those three terms in
--              rank order to display the top-3 search terms for each 2024 refresh_date.
WITH per_rank AS (
    SELECT
        "refresh_date",
        "rank",
        MIN("term") AS "term"          -- one term per (date, rank)
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
    WHERE "refresh_date" >= '2024-01-01'
      AND "refresh_date" <  '2025-01-01'
      AND "rank" IN (1, 2, 3)
    GROUP BY "refresh_date", "rank"
)
SELECT
    "refresh_date",
    LISTAGG("term", ', ') WITHIN GROUP (ORDER BY "rank") AS "top3_terms"
FROM per_rank
GROUP BY "refresh_date"
ORDER BY "refresh_date" DESC
LIMIT 20;
