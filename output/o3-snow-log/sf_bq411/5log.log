```sql
--Description: Row-number approach (limit three rows per refresh_date) using a pre-deduplication
--             step so each (refresh_date, rank) pair appears once, avoiding millions of duplicate
--             DMA rows.  We then keep the three best (ranks 1-3) per date.
WITH per_rank AS (          -- one row per refresh_date + rank
    SELECT
        "refresh_date",
        "week",
        "rank",
        MIN("term") AS "term"      -- representative term
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
    WHERE "refresh_date" >= '2024-01-01'
      AND "refresh_date" <  '2025-01-01'
      AND "rank" IN (1,2,3)
    GROUP BY "refresh_date", "week", "rank"
), ranked AS (
    SELECT
        "refresh_date",
        "week",
        "term",
        "rank",
        ROW_NUMBER() OVER (PARTITION BY "refresh_date" ORDER BY "rank") AS rn
    FROM per_rank
)
SELECT
    "refresh_date",
    "week",
    "term",
    "rank"
FROM ranked
WHERE rn <= 3
ORDER BY "refresh_date" DESC, "rank"
LIMIT 20;
```

```sql
--Description: Pivot view (rank-1, 2, 3 terms side-by-side) built on the same deduplicated
--             per-rank set so each date/rank combination appears once.
WITH per_rank AS (
    SELECT
        "refresh_date",
        "rank",
        MIN("term") AS "term"
    FROM GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS
    WHERE "refresh_date" >= '2024-01-01'
      AND "refresh_date" <  '2025-01-01'
      AND "rank" IN (1,2,3)
    GROUP BY "refresh_date", "rank"
)
SELECT
    "refresh_date",
    MAX(CASE WHEN "rank" = 1 THEN "term" END) AS "rank_1_term",
    MAX(CASE WHEN "rank" = 2 THEN "term" END) AS "rank_2_term",
    MAX(CASE WHEN "rank" = 3 THEN "term" END) AS "rank_3_term"
FROM per_rank
GROUP BY "refresh_date"
ORDER BY "refresh_date" DESC
LIMIT 20;
```

```sql
--Description: Same pivot as above but also shows the associated “week” (picked with MIN(week))
