        "score",
        ROW_NUMBER() OVER (PARTITION BY "refresh_date" ORDER BY "rank") AS rn
    FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_TERMS"
    WHERE "refresh_date" >= '2024-09-01'
      AND "refresh_date" <  '2024-09-15'                -- 1 Sep 2024 – 14 Sep 2024
      AND DAYOFWEEK("refresh_date") BETWEEN 1 AND 5      -- Monday-Friday
)
WHERE rn <= 3                                             -- keep the three best-ranked terms
ORDER BY
    "refresh_date" DESC NULLS LAST,
    "rank"          ASC  NULLS LAST;
```
