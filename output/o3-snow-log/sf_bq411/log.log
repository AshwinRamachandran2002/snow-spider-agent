ORDER  BY "week"
LIMIT 20;
```

```sql
--Description: Preview Top-3 terms that also fall on weekdays (Mon-Fri)
SELECT 
       "week",
       "term",
       "rank",
       "refresh_date"
FROM   GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_TERMS"
WHERE  "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND  "rank" IN (1,2,3)
  AND  DAYOFWEEK("week") BETWEEN 2 AND 6        -- Monday-Friday
ORDER  BY "refresh_date" DESC, "rank"
LIMIT 20;
```

```sql
--Description: Distinct list of (refresh_date, term) for weekday Top-3
SELECT DISTINCT 
       "refresh_date",
       "term",
       "rank"
FROM   GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_TERMS"
WHERE  "refresh_date" BETWEEN '2024-09-01' AND '2024-09-14'
  AND  "rank" IN (1,2,3)
  AND  DAYOFWEEK("week") BETWEEN 2 AND 6
ORDER  BY "refresh_date" DESC, "rank"
LIMIT 20;
```

```sql
--Description: Count how many Top-3 terms exist for every refresh_date (quality check)
SELECT 
       "refresh_date",
       COUNT(*) AS "top3_terms_weekdays"
FROM   GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_TERMS"
WHERE  "refresh_date" BETWEEN '2024-09-01' AND '2024-09-14'
  AND  "rank" IN (1,2,3)
  AND  DAYOFWEEK("week") BETWEEN 2 AND 6
GROUP  BY "refresh_date"
ORDER  BY "refresh_date" DESC
LIMIT 20;
```

```sql
--Description: Final pull – Top-3 weekday search terms (Mon-Fri) per "refresh_date", ordered newest first
