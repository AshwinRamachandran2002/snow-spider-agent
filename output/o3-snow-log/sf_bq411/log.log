       "refresh_date",
       "week",
       "rank",
       "term",
       "score"
FROM   GOOGLE_TRENDS.GOOGLE_TRENDS."TOP_TERMS"
WHERE  "refresh_date" BETWEEN '2024-09-01' AND '2024-09-14'
  AND  "rank" IN (1,2,3)
