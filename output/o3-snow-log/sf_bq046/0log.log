    WHERE cv11."disease_code"   = 'BRCA'
      AND cv11."gender"         = 'FEMALE'
      AND cv11."age_at_diagnosis" <= 30
),

/* 2) Patient-level annotations that may disqualify ────────────────────────────*/
annotation_flags AS (
    SELECT DISTINCT
        rc."case_barcode",
        rc."category"       AS "categoryName",
        rc."classification" AS "classificationName"
    FROM TCGA_BIOCLIN_V0.REL14."rel14_caseData"  AS rc          -- ← archive-14 schema
    WHERE rc."entity_type" = 'Patient'
      AND (
              rc."category"       = 'History of unacceptable prior treatment related to a prior/other malignancy'
           OR rc."classification" = 'Redaction'
          )
),

/* 3) FULL JOIN & retain only rows **without** those annotations ───────────────*/
eligible_patients AS (
    SELECT
        COALESCE(cp."case_barcode", af."case_barcode") AS "case_barcode",
        cp."case_gdc_id"
    FROM clinical_patients  cp
    FULL JOIN annotation_flags af
      ON cp."case_barcode" = af."case_barcode"
    WHERE af."categoryName" IS NULL
      AND af."classificationName" IS NULL
),

/* 4) Map case-UUIDs → file-UUIDs → public GCS URLs (release-14) ───────────────*/
file_mapping AS (
    SELECT
        ep."case_barcode",
        url."gcs_url" AS "file_url"
    FROM eligible_patients                                   ep
    JOIN TCGA_BIOCLIN_V0.REL14."rel14_fileData_current"      fdc
      ON ep."case_gdc_id" = fdc."case_gdc_id"
    JOIN TCGA_BIOCLIN_V0.REL14."rel14_GDCfileID_to_GCSurl_NEW" url
      ON fdc."gdc_file_id" = url."gdc_file_id"
)

/* 5) Final list ───────────────────────────────────────────────────────────────*/
SELECT DISTINCT
       "case_barcode",
       "file_url"
FROM file_mapping
ORDER BY "case_barcode";
