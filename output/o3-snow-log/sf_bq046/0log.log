--Description: 8. Perform a FULL JOIN between “CLINICAL_V1” and “CLINICAL_V1_1” for BRCA female ≤ 30 and keep rows where both “tumor_type” (from CLINICAL) and “case_gdc_id” (from CLINICAL_V1) are NULL to mimic the categoryName / classificationName exclusion
SELECT COALESCE(v1."case_barcode", v1_1."case_barcode") AS "case_barcode",
       v1."case_gdc_id",
       v1."gender",
       v1."age_at_diagnosis",
       c."tumor_type"
FROM   TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL_V1"    v1
FULL JOIN  TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL_V1_1" v1_1
       ON v1."case_barcode" = v1_1."case_barcode"
LEFT JOIN  TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL"   c
       ON c."case_barcode"  = COALESCE(v1."case_barcode", v1_1."case_barcode")
WHERE v1_1."disease_code"        ILIKE '%BRCA%'
  AND COALESCE(v1."gender", v1_1."gender") ILIKE '%FEMALE%'
  AND COALESCE(v1."age_at_diagnosis", v1_1."age_at_diagnosis") <= 30
  AND v1."case_gdc_id" IS NULL
  AND c."tumor_type"    IS NULL
LIMIT 20;
```

