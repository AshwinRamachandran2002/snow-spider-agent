```sql
--Description: Thinking process → 
--1. We only need female BRCA patients diagnosed at age ≤ 30 (information lives in CLINICAL_V1_1).  
--2. We want their GDC case-level identifier (in CLINICAL_V1).  
--3. We still want to mimic the “no problematic annotation” logic by keeping rows where the legacy CLINICAL table has no tumor_type value (NULL).  
--4. INNER JOIN CLINICAL_V1_1 ↔ CLINICAL_V1 on case_barcode to bring in the GDC ID,  
--   then LEFT JOIN to CLINICAL to inspect tumor_type and filter to NULL.  
--5. Return the key columns so we can later link to file metadata.  
SELECT
       v1_1."case_barcode",
       v1."case_gdc_id",
       v1_1."gender",
       v1_1."age_at_diagnosis"
FROM   TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL_V1_1" v1_1
JOIN   TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL_V1"   v1
       ON v1_1."case_barcode" = v1."case_barcode"
LEFT  JOIN TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL"   c
       ON c."case_barcode" = v1_1."case_barcode"
WHERE  v1_1."disease_code"      = 'BRCA'
  AND  v1_1."gender"            = 'FEMALE'
  AND  v1_1."age_at_diagnosis" <= 30
  AND  c."tumor_type" IS NULL
LIMIT 20;
