```sql
/*  STEP-BY-STEP LOGIC
    1) Pull BRCA female patients ≤ 30 yr from the v1_1 clinical table and pick up their GDC-case-UUID
       from the companion v1 table.                                             → clinical_patients
    2) Find any patient–level annotations whose
           entity_type  = 'Patient'  AND
           (category     = 'History of unacceptable prior treatment related to a prior/other malignancy'
            OR classification = 'Redaction').                                    → annotation_flags
    3) FULL-JOIN those two result sets and keep only rows where both
       categoryName and classificationName are NULL (i.e. no disqualifying
       annotations).                                                             → eligible_patients
    4) Map the surviving GDC-case UUIDs to file UUIDs and then to their
       public GCS URLs using the release-14 file-metadata tables.                → final list
*/
WITH clinical_patients AS (     -- ── step 1 ───────────────────────────────────────────────────
    SELECT
        cv11."case_barcode",
        cv11."age_at_diagnosis",
        cv11."gender",
        cv1 ."case_gdc_id"
    FROM TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL_V1_1"  AS cv11
    JOIN TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL_V1"    AS cv1
          ON cv11."case_barcode" = cv1."case_barcode"
    WHERE cv11."disease_code"      = 'BRCA'
      AND cv11."gender"            = 'FEMALE'
      AND cv11."age_at_diagnosis" <= 30
),
annotation_flags AS (          -- ── step 2 ───────────────────────────────────────────────────
    SELECT DISTINCT
        rc."case_barcode",
        rc."category"        AS "categoryName",
        rc."classification"  AS "classificationName"
    FROM GDC_R14.GDC_R14."rel14_caseData"           AS rc
    WHERE rc."entity_type" = 'Patient'
      AND (   rc."category"       = 'History of unacceptable prior treatment related to a prior/other malignancy'
           OR rc."classification" = 'Redaction')
),
full_join_patients AS (        -- ── step 3 (FULL JOIN) ───────────────────────────────────────
    SELECT
        cp."case_barcode",
        cp."case_gdc_id",
        af."categoryName",
        af."classificationName"
    FROM clinical_patients  AS cp
    FULL JOIN annotation_flags AS af
           ON cp."case_barcode" = af."case_barcode"
),
eligible_patients AS (         -- keep only patients **without** disqualifying annotations
    SELECT
        "case_barcode",
        "case_gdc_id"
    FROM full_join_patients
    WHERE "categoryName"      IS NULL
      AND "classificationName" IS NULL
),
file_mapping AS (              -- ── step 4 ───────────────────────────────────────────────────
    SELECT
        ep."case_barcode",
        fdc."gdc_file_id",
        url."gcs_url"  AS "file_url"
    FROM eligible_patients                                     AS ep
    JOIN GDC_R14.GDC_R14."rel14_fileData_current"              AS fdc
          ON ep."case_gdc_id" = fdc."case_gdc_id"
    JOIN GDC_R14.GDC_R14."rel14_GDCfileID_to_GCSurl_NEW"       AS url
          ON fdc."gdc_file_id" = url."gdc_file_id"
)
SELECT DISTINCT
       "case_barcode",
       "file_url"
FROM file_mapping
ORDER BY "case_barcode";
```
