/*  Female BRCA patients ≤ 30 y, exclude disqualifying annotations,
    then fetch their GDC release-14 file URLs                                           */
WITH clinical_patients AS (          -- 1.  BRCA / FEMALE / age ≤ 30
    SELECT
        cv11."case_barcode",
        cv1."case_gdc_id"
    FROM TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL_V1_1"  AS cv11
    JOIN TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL_V1"    AS cv1
          ON cv11."case_barcode" = cv1."case_barcode"
    WHERE cv11."disease_code"     = 'BRCA'
      AND cv11."gender"           = 'FEMALE'
      AND cv11."age_at_diagnosis" <= 30
),
annotation_flags AS (           -- 2.  patient-level disqualifying annotations
    SELECT DISTINCT
        rc."case_barcode"
    FROM TCGA_BIOCLIN_V0.REL14."rel14_caseData"  AS rc
    WHERE rc."entity_type" = 'Patient'
      AND (   rc."category"       = 'History of unacceptable prior treatment related to a prior/other malignancy'
           OR rc."classification" = 'Redaction'
          )
),
eligible_patients AS (          -- 3.  keep only patients WITHOUT such annotations
    SELECT
        cp."case_barcode",
        cp."case_gdc_id"
    FROM clinical_patients cp
    LEFT JOIN annotation_flags af
           ON cp."case_barcode" = af."case_barcode"
    WHERE af."case_barcode" IS NULL
),
file_mapping AS (               -- 4.  map case → file → public URL (release-14)
    SELECT
        ep."case_barcode",
        url."gcs_url" AS "file_url"
    FROM eligible_patients                                   ep
    JOIN TCGA_BIOCLIN_V0.REL14."rel14_fileData_current"      fdc
          ON ep."case_gdc_id" = fdc."case_gdc_id"
    JOIN TCGA_BIOCLIN_V0.REL14."rel14_GDCfileID_to_GCSurl_NEW" url
          ON fdc."gdc_file_id" = url."gdc_file_id"
)
SELECT DISTINCT
       "case_barcode",
       "file_url"
FROM file_mapping
ORDER BY "case_barcode";
