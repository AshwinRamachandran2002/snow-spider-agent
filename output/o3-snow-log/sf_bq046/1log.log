```sql
/*---------------------------------------------------------------------
  1)  Pull barcodes that carry an “unacceptable-treatment / Redaction”
      annotation at the PATIENT level                             
  2)  Pull barcodes that are BRCA, FEMALE and ≤ 30 yr from V1_1
  3)  FULL-JOIN the two sets and keep only those rows where the
      annotation columns are NULL   →   patients **not** flagged
  4)  Bring in rel-14 metadata to obtain the corresponding GDC file
      URLs for every remaining barcode
---------------------------------------------------------------------*/
WITH flagged_cases AS (           -- step-1
    SELECT DISTINCT
           "case_barcode",
           "category"        AS "categoryName",
           "classification"  AS "classificationName"
    FROM   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."rel14_Annotations"
    WHERE  "entity_type" = 'Patient'
      AND ( "category"       = 'History of unacceptable prior treatment related to a prior/other malignancy'
         OR  "classification" = 'Redaction' )
),

clinical_cases AS (              -- step-2
    SELECT DISTINCT
           "case_barcode"
    FROM   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."CLINICAL_V1_1"
    WHERE  "disease_code"      = 'BRCA'
      AND  "gender"            = 'FEMALE'
      AND  "age_at_diagnosis" <= 30
),

combined AS (                    -- step-3  (FULL JOIN)
    SELECT 
           COALESCE(cc."case_barcode", fc."case_barcode") AS "case_barcode",
           fc."categoryName",
           fc."classificationName"
    FROM   clinical_cases cc
    FULL JOIN flagged_cases fc
           ON cc."case_barcode" = fc."case_barcode"
),

eligible_cases AS (              -- keep only NON-flagged barcodes
    SELECT  "case_barcode"
    FROM    combined
    WHERE   "categoryName"      IS NULL
      AND   "classificationName" IS NULL
)

SELECT DISTINCT                  -- step-4  (attach rel-14 file URLs)
       ec."case_barcode",
       url."gcs_url"  AS "file_url"
FROM   eligible_cases                                          ec
JOIN   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."rel14_caseData"            cd
       ON  ec."case_barcode" = cd."case_barcode"
JOIN   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."rel14_fileData_current"    fd
       ON  cd."case_gdc_id"  = fd."case_gdc_id"
JOIN   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."rel14_GDCfileID_to_GCSurl_NEW" url
       ON  fd."file_gdc_id"  = url."file_gdc_id";
```
