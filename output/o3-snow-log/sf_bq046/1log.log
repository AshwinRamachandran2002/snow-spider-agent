         OR classification = 'Redaction' )
),

clinical_cases AS (                   -- 2. BRCA · FEMALE · age ≤ 30
    SELECT DISTINCT
           case_barcode
    FROM   TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0.CLINICAL_V1_1
    WHERE  disease_code     = 'BRCA'
      AND  gender           = 'FEMALE'
      AND  age_at_diagnosis <= 30
),

eligible_cases AS (                   -- 3. keep only cases NOT in flagged list
    SELECT cc.case_barcode
