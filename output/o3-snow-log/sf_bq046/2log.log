```sql
/*==============================================================
  Female BRCA patients ≤ 30 yr who are NOT flagged by the
  specified Annotation categories/classifications – return their
  case barcodes together with every GDC file’s GCS URL
================================================================*/
WITH
/*--- 1.  Young female BRCA cases from Clinical ----------------*/
clinical_brca AS (
    SELECT DISTINCT
           "case_barcode"
    FROM   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."CLINICAL_V1_1"
    WHERE  "disease_code"      = 'BRCA'
      AND  "gender"            = 'FEMALE'
      AND  "age_at_diagnosis" <= 30
),

/*--- 2.  Patients carrying dis-qualifying annotations ----------*/
annotated_patients AS (
    SELECT DISTINCT
           "case_barcode",
           "category"       AS "categoryName",
           "classification" AS "classificationName"
    FROM   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."ANNOTATIONS"
    WHERE  "entity_type" = 'Patient'
      AND  ( "category" = 'History of unacceptable prior treatment related to a prior/other malignancy'
             OR "classification" = 'Redaction' )
),

/*--- 3.  FULL JOIN the two lists ------------------------------*/
combined AS (
    SELECT
        cb."case_barcode",
        ap."categoryName",
        ap."classificationName"
    FROM  clinical_brca       cb
    FULL OUTER JOIN annotated_patients ap
           ON cb."case_barcode" = ap."case_barcode"
)

/*--- 4.  Keep only records with NO dis-qualifying annotation ---
       then link to rel-14 metadata to obtain file URLs          */
SELECT DISTINCT
       comb."case_barcode",
       gcs."gcs_file_url"
FROM   combined                                                    comb
       LEFT JOIN "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."rel14_caseData"                  cd
              ON comb."case_barcode" = cd."case_barcode"
       LEFT JOIN "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."rel14_fileData_current"          fd
              ON cd."case_gdc_id"   = fd."case_gdc_id"
       LEFT JOIN "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."rel14_GDCfileID_to_GCSurl_NEW"   gcs
              ON fd."file_gdc_id"   = gcs."file_gdc_id"
WHERE  comb."categoryName"       IS NULL
  AND  comb."classificationName" IS NULL;
```
