```sql
/*================================================================
  Female BRCA patients (≤30 yrs) without dis-qualifying annotations
  and all of their GDC file GCS URLs
==================================================================*/
WITH
/*-- 1.  Young female BRCA cases --------------------------------*/
clinical_brca AS (
    SELECT DISTINCT
           "case_barcode"
    FROM   TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0.CLINICAL_V1_1
    WHERE  "disease_code"      = 'BRCA'
      AND  "gender"            = 'FEMALE'
      AND  "age_at_diagnosis" <= 30
),

/*-- 2.  Patients having the dis-qualifying annotations ----------*/
annotated_patients AS (
    SELECT DISTINCT
           "case_barcode",
           "category"       AS categoryname,
           "classification" AS classificationname
    FROM   TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0.ANNOTATIONS
    WHERE  "entity_type" = 'Patient'
      AND  ( "category" = 'History of unacceptable prior treatment related to a prior/other malignancy'
             OR "classification" = 'Redaction' )
),

/*-- 3.  Merge and retain only “clean” patients -----------------*/
eligible_cases AS (
    SELECT  cb."case_barcode"
    FROM    clinical_brca        cb
    FULL OUTER JOIN annotated_patients ap
           ON cb."case_barcode" = ap."case_barcode"
    WHERE   ap.categoryname       IS NULL
      AND   ap.classificationname IS NULL
)

/*-- 4.  Link to rel-14 metadata to fetch every GCS URL ----------*/
SELECT  DISTINCT
        ec."case_barcode",
        gcs.gcs_file_url
FROM    eligible_cases                             ec
JOIN    TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0.REL14_CASEDATA             cd
              ON ec."case_barcode" = cd.CASE_BARCODE
JOIN    TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0.REL14_FILEDATA_CURRENT     fd
              ON cd.CASE_GDC_ID  = fd.CASE_GDC_ID
JOIN    TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0.REL14_GDCFILEID_TO_GCSURL_NEW gcs
              ON fd.FILE_GDC_ID = gcs.FILE_GDC_ID
ORDER BY ec."case_barcode";
```
