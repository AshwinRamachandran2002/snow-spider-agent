2025-05-07 06:21:13 - Thread-364 (execute) - INFO - [Try to run SQL in self-refine]
```sql
/*  -----------------------------------------------------------
    Female BRCA patients ≤ 30 yrs with GDC file URLs
    – Exclude any patient carrying an “unacceptable prior-treatment”
      or “Redaction” annotation
    – Return one row per (case_barcode , GCS file-URL)
    -----------------------------------------------------------  */

/* 1)  Patients that are EXPLICITLY FLAGGED in the Annotations set  */
WITH annotations_flagged AS (
    SELECT DISTINCT
           "entity_submitter_id"              AS "case_barcode",   -- TCGA barcode
           "category"                         AS "categoryName",
           "classification"                   AS "classificationName"
    FROM  GDC_RELEASE_14.PUBLIC."ANNOTATIONS"
    WHERE "entity_type" = 'Patient'
      AND (  "category"      = 'History of unacceptable prior treatment related to a prior/other malignancy'
          OR "classification" = 'Redaction' )
),

/* 2)  Clinical cohort : young (≤30) female BRCA patients           */
clinical_brca_young_fem AS (
    SELECT DISTINCT
           c."case_barcode"
    FROM   TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL"         c
    JOIN   TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL_V1_1"    v11
           ON v11."case_barcode" = c."case_barcode"
    WHERE  v11."disease_code"   = 'BRCA'
      AND  c."age_at_diagnosis" <= 30
      AND  c."gender"           = 'FEMALE'
),

/* 3)  FULL-JOIN → keep ONLY rows *not* present in annotations      */
eligible_cases AS (
    SELECT  COALESCE(a."case_barcode", b."case_barcode")  AS "case_barcode"
    FROM    annotations_flagged           a
    FULL JOIN clinical_brca_young_fem     b
           ON a."case_barcode" = b."case_barcode"
    WHERE   a."case_barcode" IS NULL                      -- ==> un-flagged
)

/* 4)  Attach GDC release-14 metadata to obtain file GCS URLs       */
SELECT  DISTINCT
        ec."case_barcode",
        g2g."gcs_url"                         AS "file_gcs_url"
FROM    eligible_cases                                           ec
JOIN    GDC_RELEASE_14.PUBLIC."rel14_caseData"                   cd
        ON cd."submitter_id" = ec."case_barcode"
JOIN    GDC_RELEASE_14.PUBLIC."rel14_fileData_current"           fd
        ON fd."case_gdc_id"  = cd."case_gdc_id"
JOIN    GDC_RELEASE_14.PUBLIC."rel14_GDCfileID_to_GCSurl_NEW"    g2g
        ON g2g."file_gdc_id" = fd."file_gdc_id"
ORDER BY ec."case_barcode" ASC NULLS LAST;
```
