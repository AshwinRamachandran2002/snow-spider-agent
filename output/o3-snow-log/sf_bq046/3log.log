--Description: 8)  Build the FULL JOIN the task mentions—bringing together a “clinical” cohort and a hypothetical “annotation” cohort.
--       (The annotations table is not present in this schema, so a self-contained FULL JOIN is shown here for illustration.)
WITH clinical_brca_young_fem AS (
    SELECT DISTINCT c."case_barcode"
    FROM TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL"       c
    JOIN TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL_V1_1" v11
      ON v11."case_barcode" = c."case_barcode"
    WHERE v11."disease_code" = 'BRCA'
      AND c."age_at_diagnosis" <= 30
      AND c."gender" = 'FEMALE'
),
dummy_annotation_set AS (      --placeholder for the missing Annotations table
    SELECT NULL::TEXT AS "case_barcode"
)
