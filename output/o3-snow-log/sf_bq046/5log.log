```sql
/*  Step-by-step
    1)  Pick all annotations that refer to patients and meet either of the two exclusion
        conditions (category / classification).
    2)  Pick all clinical BRCA rows where gender = FEMALE and age ≤ 30.
    3)  FULL-JOIN the two sets and keep only those rows where the annotation columns
        are NULL  →  these are the “clean” cases.
    4)  Map the surviving barcodes to their GDC case-IDs, then to file-IDs, then to
        final GCS / HTTPS URLs contained in the rel-14 metadata tables.
*/

WITH patient_annotations AS (      -- step-1
    SELECT
        "entity_submitter_id"  AS "case_barcode",
        "category"             AS "categoryName",
        "classification"       AS "classificationName"
    FROM  GDC_METADATA.REL14."ANNOTATIONS"
    WHERE "entity_type" = 'Patient'
      AND (   "category" = 'History of unacceptable prior treatment related to a prior/other malignancy'
           OR "classification" = 'Redaction' )
),

clinical_candidates AS (           -- step-2
    SELECT  "case_barcode"
    FROM    TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL_V1_1"
    WHERE   "disease_code"      = 'BRCA'
      AND   "age_at_diagnosis" <= 30
      AND   "gender"            = 'FEMALE'
),

eligible_cases AS (               -- step-3
    SELECT  c."case_barcode"
    FROM    clinical_candidates  AS c
    FULL JOIN patient_annotations AS a
           ON c."case_barcode" = a."case_barcode"
    WHERE   a."categoryName" IS NULL
      AND   a."classificationName" IS NULL
),

files_with_urls AS (              -- step-4
    SELECT
        ec."case_barcode",
        u."file_gcs_url"
    FROM  eligible_cases                               ec
    JOIN  GDC_METADATA.REL14."rel14_caseData"          cd
          ON ec."case_barcode" = cd."case_barcode"
    JOIN  GDC_METADATA.REL14."rel14_fileData_current"  fd
          ON cd."case_gdc_id"  = fd."case_gdc_id"
    JOIN  GDC_METADATA.REL14."rel14_GDCfileID_to_GCSurl_NEW"  u
          ON fd."file_gdc_id"  = u."file_gdc_id"
)

SELECT DISTINCT
       "case_barcode",
       "file_gcs_url"  AS "gdc_file_url"
FROM   files_with_urls
ORDER BY "case_barcode";
```
