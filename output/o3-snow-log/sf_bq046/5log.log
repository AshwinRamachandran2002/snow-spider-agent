/*  Retrieve BRCA-female (≤ 30 yrs) case barcodes that have
    NO dis-qualifying “Patient” annotations and list their
    corresponding rel-14 GDC file URLs.                                */

WITH patient_annotations AS (          -- 1. annotations that should EXCLUDE a case
    SELECT
        "entity_submitter_id" AS "case_barcode",
        "category"            AS "categoryName",
        "classification"      AS "classificationName"
    FROM  RELEASE14.RELEASE14."ANNOTATIONS"
    WHERE "entity_type" = 'Patient'
      AND (   "category"       = 'History of unacceptable prior treatment related to a prior/other malignancy'
           OR "classification" = 'Redaction' )
),

clinical_candidates AS (               -- 2. BRCA | FEMALE | age ≤ 30
    SELECT  "case_barcode"
    FROM    TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0."CLINICAL_V1_1"
    WHERE   "disease_code"      = 'BRCA'
      AND   "age_at_diagnosis" <= 30
      AND   "gender"            = 'FEMALE'
),

eligible_cases AS (                    -- 3. keep only barcodes with NO bad annotation
    SELECT  c."case_barcode"
    FROM    clinical_candidates  c
    LEFT JOIN patient_annotations a
           ON c."case_barcode" = a."case_barcode"
    WHERE   a."case_barcode" IS NULL
),

files_with_urls AS (                   -- 4. map barcodes → case-ids → file-ids → URLs
    SELECT
        ec."case_barcode",
        u."file_gcs_url"
    FROM  eligible_cases                            ec
    JOIN  RELEASE14.RELEASE14."rel14_caseData"             cd
          ON ec."case_barcode" = cd."case_barcode"
    JOIN  RELEASE14.RELEASE14."rel14_fileData_current"     fd
          ON cd."case_gdc_id"  = fd."case_gdc_id"
    JOIN  RELEASE14.RELEASE14."rel14_GDCfileID_to_GCSurl_NEW" u
          ON fd."file_gdc_id"  = u."file_gdc_id"
)

SELECT DISTINCT
       "case_barcode",
       "file_gcs_url" AS "gdc_file_url"
FROM   files_with_urls
ORDER BY "case_barcode";
