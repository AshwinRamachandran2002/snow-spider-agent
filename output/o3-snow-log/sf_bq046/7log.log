           url.gcs_url AS file_url
    FROM   file_ids                                                  fi
    JOIN   TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0.REL14_GDCFILEID_TO_GCSURL_NEW url
           ON fi.file_gdc_id = url.file_gdc_id
)
-- -----------------------------------------------------------------
SELECT DISTINCT
       case_barcode,
       file_url
