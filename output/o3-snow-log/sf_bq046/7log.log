/* -----------------------------------------------------------------
   Return case barcodes for FEMALE BRCA patients ≤30 yrs that do NOT
   have disqualifying annotations.  File-URL columns are retained but
   will be NULL because the release-14 file-mapping tables are not
   available in the current catalog.
   ----------------------------------------------------------------- */
WITH annot_flagged AS (                      /* 1. cases to EXCLUDE  */
    /* Table REL14_ANNOTATIONDATA is absent ⇒ create empty set      */
    SELECT
        CAST(NULL AS STRING) AS case_barcode,
        CAST(NULL AS STRING) AS categoryName,
        CAST(NULL AS STRING) AS classificationName
    WHERE FALSE
),
young_female_brca AS (                       /* 2. target cohort     */
    SELECT DISTINCT
           "case_barcode"
    FROM   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."CLINICAL_V1_1"
    WHERE  "disease_code"     = 'BRCA'
      AND  "gender"           = 'FEMALE'
      AND  "age_at_diagnosis" <= 30
),
eligible_cases AS (                          /* 3. keep un-flagged   */
    SELECT c."case_barcode"
    FROM   young_female_brca  c
    LEFT  JOIN annot_flagged  a
           ON c."case_barcode" = a."case_barcode"
    WHERE  a."case_barcode" IS NULL          -- no disqualifying ann.
),
case_ids AS (                                /* 4. add GDC case-ID   */
    SELECT ec."case_barcode",
           cv1."case_gdc_id"
    FROM   eligible_cases                                     ec
    LEFT  JOIN "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."CLINICAL_V1" cv1
           ON ec."case_barcode" = cv1."case_barcode"
),
file_urls AS (                               /* 5. placeholder URLs  */
    SELECT ci."case_barcode",
           NULL AS "file_url"                -- rel14 URL table absent
    FROM   case_ids ci
)
SELECT DISTINCT
       "case_barcode",
       "file_url"
FROM   file_urls
ORDER BY "case_barcode" ASC;
