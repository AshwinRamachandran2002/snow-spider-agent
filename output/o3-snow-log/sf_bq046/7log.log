```sql
/*  ---------------------------------------------------------------
    1)  Pull annotations that *disqualify* a case
    --------------------------------------------------------------- */
WITH annot_flagged AS (          -- entity-level annotations
    SELECT DISTINCT
           "entity_submitter_id"          AS "case_barcode",
           "category"                     AS "categoryName",
           "classification"               AS "classificationName"
    FROM   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."rel14_AnnotationData"
    WHERE  LOWER("entity_type") = 'patient'
      AND ( "category" = 'History of unacceptable prior treatment related to a prior/other malignancy'
            OR "classification" = 'Redaction' )
),

/* -----------------------------------------------------------------
   2)  Female BRCA patients diagnosed at ≤30 yrs (clinical table)
   ----------------------------------------------------------------- */
young_female_brca AS (
    SELECT DISTINCT
           "case_barcode"
    FROM   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."CLINICAL_V1_1"
    WHERE  "disease_code"       = 'BRCA'
      AND  "gender"             = 'FEMALE'
      AND  "age_at_diagnosis"  <= 30
),

/* -----------------------------------------------------------------
   3)  FULL JOIN both sets and keep **only** those without flags
   ----------------------------------------------------------------- */
eligible_cases AS (
    SELECT DISTINCT
           COALESCE(c."case_barcode", a."case_barcode")  AS "case_barcode"
    FROM   young_female_brca  c
    FULL JOIN annot_flagged   a
           ON c."case_barcode" = a."case_barcode"
    WHERE  a."categoryName"      IS NULL
      AND  a."classificationName" IS NULL                  -- ← no disqualifying annotation
),

/* -----------------------------------------------------------------
   4)  Map cases → GDC IDs  →  file IDs  →  cloud URLs (rel-14)
   ----------------------------------------------------------------- */
case_ids AS (
    SELECT ec."case_barcode",
           cd."case_gdc_id"
    FROM   eligible_cases                               ec
    JOIN   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."rel14_caseData" cd
           ON ec."case_barcode" = cd."case_barcode"
),
file_ids AS (
    SELECT ci."case_barcode",
           fd."file_gdc_id"
    FROM   case_ids                                            ci
    JOIN   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."rel14_fileData_current" fd
           ON ci."case_gdc_id" = fd."case_gdc_id"
),
file_urls AS (
    SELECT fi."case_barcode",
           url."gcs_url"  AS "file_url"
    FROM   file_ids                                          fi
    JOIN   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."rel14_GDCfileID_to_GCSurl_NEW" url
           ON fi."file_gdc_id" = url."file_gdc_id"
)

/* -----------------------------------------------------------------
   5)  Final list of case barcodes with their corresponding GDC URLs
   ----------------------------------------------------------------- */
SELECT DISTINCT
       "case_barcode",
       "file_url"
FROM   file_urls
ORDER BY "case_barcode" ASC;
```
