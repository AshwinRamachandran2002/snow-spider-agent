2025-05-07 06:21:12 - Thread-367 (execute) - INFO - [Try to run SQL in self-refine]
```sql
/* --------------------------------------------------------------------------
   Retrieve GDC file URLs for TCGA breast-cancer (BRCA) cases that
   • are FEMALE and were ≤ 30 years old at diagnosis               (clinical filter)
   • do NOT carry patient–level annotations of the two unwanted
     kinds (“History of unacceptable prior treatment …” or “Redaction”)
   -------------------------------------------------------------------------- */

WITH annotated_cases AS (      -- ❶ patients carrying an unwanted annotation
    SELECT DISTINCT
           "case_barcode",
           "category"       AS "categoryName",
           "classification" AS "classificationName"
    FROM  "GDC_METADATA_REL14"."PUBLIC"."rel14_annotationData"
    WHERE "entity_type" = 'Patient'
      AND ( "category"       = 'History of unacceptable prior treatment related to a prior/other malignancy'
         OR "classification" = 'Redaction' )
),

young_female_brca AS (        -- ❷ BRCA cases ≤ 30 yrs, female
    SELECT DISTINCT
           "case_barcode"
    FROM  "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."CLINICAL_V1_1"
    WHERE "disease_code"      = 'BRCA'
      AND "gender"            = 'FEMALE'
      AND "age_at_diagnosis" <= 30
)

SELECT DISTINCT
       COALESCE(y."case_barcode", a."case_barcode")   AS "case_barcode",
       g."gcs_url"                                    AS "gdc_file_url"
FROM   young_female_brca                          y
FULL JOIN annotated_cases                         a
       ON y."case_barcode" = a."case_barcode"
LEFT JOIN "GDC_METADATA_REL14"."PUBLIC"."rel14_caseData"          c
       ON COALESCE(y."case_barcode", a."case_barcode") = c."case_barcode"
LEFT JOIN "GDC_METADATA_REL14"."PUBLIC"."rel14_fileData_current"  f
       ON c."case_gdc_id" = f."case_gdc_id"
LEFT JOIN "GDC_METADATA_REL14"."PUBLIC"."rel14_GDCfileID_to_GCSurl_NEW" g
       ON f."file_gdc_id" = g."datafile_gdc_id"
WHERE a."categoryName"       IS NULL          -- keep only cases with NO such annotations
  AND a."classificationName" IS NULL
  AND y."case_barcode"       IS NOT NULL      -- ensure the row originated from the BRCA cohort
  AND g."gcs_url"            IS NOT NULL      -- only rows with a resolvable file URL
ORDER BY "case_barcode";
```
