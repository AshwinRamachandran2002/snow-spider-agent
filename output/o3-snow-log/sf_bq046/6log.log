FULL JOIN "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."CLINICAL_V1" v1
       ON v1_1."case_barcode" = v1."case_barcode"
FULL JOIN "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."CLINICAL"    v0
       ON v1_1."case_barcode" = v0."case_barcode"
WHERE  (v1_1."disease_code" = 'BRCA' OR v1."tumor_type" ILIKE '%BRCA%' OR v0."tumor_type" ILIKE '%BRCA%')
  AND  COALESCE(v1_1."gender", v1."gender", v0."gender") = 'FEMALE'
  AND  COALESCE(v1_1."age_at_diagnosis", v1."age_at_diagnosis", v0."age_at_diagnosis") <= 30
LIMIT 20;
```
