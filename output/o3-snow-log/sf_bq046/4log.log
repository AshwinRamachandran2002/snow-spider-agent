/* Identify BRCA, young (≤30 yrs), female cases from the clinical table */
WITH clinical_patients AS ( 
    SELECT 
           "case_barcode"
    FROM   "TCGA_BIOCLIN_V0"."TCGA_BIOCLIN_V0"."CLINICAL_V1_1"
    WHERE  "disease_code"      = 'BRCA'
      AND  "gender"            = 'FEMALE'
      AND  "age_at_diagnosis" <= 30
),

/* Patients carrying undesirable annotations (to be excluded) */
annotation_patients AS ( 
    SELECT DISTINCT
           "case_barcode",
           "category"       AS "categoryName",
           "classification" AS "classificationName"
    FROM   "GDC_RELEASE14"."RELEASE14_METADATA"."ANNOTATIONS"
    WHERE  "entity_type" = 'Patient'
      AND ( "category" = 'History of unacceptable prior treatment related to a prior/other malignancy'
            OR "classification" = 'Redaction' )
),

/* Keep only the clinical patients that do NOT carry those annotations          */
eligible_cases AS ( 
    SELECT  COALESCE(c."case_barcode", a."case_barcode") AS "case_barcode"
    FROM    clinical_patients  c
    FULL JOIN annotation_patients a
           ON c."case_barcode" = a."case_barcode"
    WHERE   a."categoryName"      IS NULL
      AND   a."classificationName" IS NULL
),

/* Map the remaining case barcodes to their current GDC file identifiers        */
case_to_file AS (
    SELECT
           e."case_barcode",
           f."file_gdc_id"
    FROM   eligible_cases                               e
    JOIN   "GDC_RELEASE14"."RELEASE14_METADATA"."rel14_caseData"          cd
           ON cd."case_barcode" = e."case_barcode"
    JOIN   "GDC_RELEASE14"."RELEASE14_METADATA"."rel14_fileData_current"  f
           ON f."case_gdc_id"   = cd."case_gdc_id"
),

/* Attach the Google-Cloud-Storage (GCS) URLs for each file                     */
urls AS ( 
    SELECT DISTINCT
           ctf."case_barcode",
           g."gcs_url"   AS "file_gcs_url"
    FROM   case_to_file                                         ctf
    JOIN   "GDC_RELEASE14"."RELEASE14_METADATA"."rel14_GDCfileID_to_GCSurl_NEW" g
           ON g."file_gdc_id" = ctf."file_gdc_id"
)

/* Final list of case barcodes with their corresponding file URLs               */
SELECT 
       "case_barcode",
       "file_gcs_url"
FROM   urls
ORDER  BY "case_barcode" ASC, "file_gcs_url" ASC NULLS LAST;
```
