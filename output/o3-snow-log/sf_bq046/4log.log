/* ============================================================================
   STEP-5 :  Attach the corresponding Google-Cloud-Storage URLs
============================================================================ */
urls AS (
    SELECT DISTINCT
           ctf.case_barcode,
           urlmap.gcs_url   AS file_gcs_url
    FROM   case_to_file                                                ctf
    JOIN   TCGA_BIOCLIN_V0.TCGA_BIOCLIN_V0.rel14_GDCfileID_to_GCSurl_NEW urlmap
           ON  urlmap.file_gdc_id = ctf.file_gdc_id
)

/* ============================================================================
   FINAL RESULT
============================================================================ */
SELECT
       case_barcode,
       file_gcs_url
FROM   urls
ORDER  BY case_barcode ASC,
         file_gcs_url ASC NULLS LAST;
