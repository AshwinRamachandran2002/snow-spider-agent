--Description: 8) Aggregate the filtered set to find the most-frequent sender in large blocks
-- (4096-char criterion). LENGTH() used for size computation.
WITH big_blocks AS (
  SELECT "block_number" AS "BLOCK_NUMBER"
  FROM (
    SELECT
      "block_number",
      SUM(LENGTH("data")) AS "bytes"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "block_timestamp" >= 1672531200000000
    GROUP BY "block_number"
  )
  WHERE "bytes" > 4096
)
SELECT
  PARSE_JSON(de."ARGS")[0]::STRING AS "from_address",
  COUNT(*)                         AS "sender_txn_count"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" de
JOIN big_blocks bb
  ON de."BLOCK_NUMBER" = bb."BLOCK_NUMBER"
WHERE de."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON(de."ARGS")[1] IS NOT NULL
GROUP BY "from_address"
ORDER BY "sender_txn_count" DESC
LIMIT 20;
```

```sql
--Description: 9) Retrieve the top sender (most transfers in large blocks) and build its Cronoscan URL.
-- Uses LENGTH() for block-size calculation instead of BYTE_LENGTH().
WITH ranked_senders AS (
  WITH big_blocks AS (
    SELECT "block_number" AS "BLOCK_NUMBER"
    FROM (
      SELECT
        "block_number",
        SUM(LENGTH("data")) AS "bytes"
      FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
      WHERE "block_timestamp" >= 1672531200000000
      GROUP BY "block_number"
    )
    WHERE "bytes" > 4096
  )
  SELECT
    PARSE_JSON(de."ARGS")[0]::STRING AS "from_address",
    COUNT(*)                         AS "cnt",
    ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS "rnk"
  FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" de
  JOIN big_blocks bb
    ON de."BLOCK_NUMBER" = bb."BLOCK_NUMBER"
  WHERE de."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
    AND PARSE_JSON(de."ARGS")[1] IS NOT NULL
  GROUP BY "from_address"
)
SELECT
  CONCAT('https://cronoscan.com/address/', "from_address") AS "cronoscan_url",
  "cnt" AS "transfer_count"
FROM ranked_senders
WHERE "rnk" = 1;
