  PARSE_JSON("args")[1]::STRING  AS "to_address",
  PARSE_JSON("args")[2]::STRING  AS "token_value"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "event_signature" = 'Transfer(address,address,uint256)'
LIMIT 20;
```

```sql
--Description: 5) Count Transfer events since 1-Jan-2023 whose to_address is NOT NULL,  
-- grouped by sender (from_address), to see which addresses are most active.
SELECT  
  PARSE_JSON("args")[0]::STRING  AS "from_address",
  COUNT(*)                       AS "transfer_count"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "event_signature"        = 'Transfer(address,address,uint256)'
  AND "block_timestamp"        >= 1672531200000000        -- 2023-01-01 UTC in µs
  AND PARSE_JSON("args")[1] IS NOT NULL                   -- non-null to_address
GROUP BY "from_address"
ORDER BY "transfer_count" DESC
LIMIT 20;
```

```sql
--Description: 6) Estimate block “size” using the summed byte-length of all log “data” strings inside a block;  
-- return blocks whose total is > 4096 bytes since 2023-01-01.
WITH blk AS (
  SELECT 
    "block_number",
    SUM(BYTE_LENGTH("data")) AS "approx_block_bytes"
  FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
  WHERE "block_timestamp" >= 1672531200000000
  GROUP BY "block_number"
)
SELECT * 
FROM blk
WHERE "approx_block_bytes" > 4096
ORDER BY "approx_block_bytes" DESC
LIMIT 20;
```

```sql
--Description: 7) Combine the previous CTE with decoded Transfer events so we only keep transfers  
-- inside blocks whose total log-data length exceeds 4096 bytes.
WITH big_blocks AS (
  SELECT "block_number"
  FROM (
    SELECT "block_number",
           SUM(BYTE_LENGTH("data")) AS "bytes"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "block_timestamp" >= 1672531200000000
    GROUP BY "block_number"
  )
  WHERE "bytes" > 4096
)
SELECT 
  de."transaction_hash",
  PARSE_JSON(de."args")[0]::STRING AS "from_address",
  PARSE_JSON(de."args")[1]::STRING AS "to_address"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"  de
JOIN big_blocks bb
  ON de."block_number" = bb."block_number"
WHERE de."event_signature" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON(de."args")[1] IS NOT NULL
LIMIT 20;
```

```sql
--Description: 8) Aggregate the filtered set to find the most frequent sender in large blocks since 2023-01-01.
WITH big_blocks AS (
  SELECT "block_number"
  FROM (
    SELECT "block_number",
           SUM(BYTE_LENGTH("data")) AS "bytes"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "block_timestamp" >= 1672531200000000
    GROUP BY "block_number"
  )
  WHERE "bytes" > 4096
)
SELECT  
  PARSE_JSON(de."args")[0]::STRING AS "from_address",
  COUNT(*)                         AS "sender_txn_count"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" de
JOIN big_blocks bb
     ON de."block_number" = bb."block_number"
WHERE de."event_signature" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON(de."args")[1] IS NOT NULL
GROUP BY "from_address"
ORDER BY "sender_txn_count" DESC
LIMIT 20;
```

```sql
--Description: 9) Take the top sender from the previous query and build its Cronoscan URL.  
-- (This uses the most frequent “from_address” computed above.)
WITH ranked_senders AS (
  WITH big_blocks AS (
    SELECT "block_number"
    FROM (
      SELECT "block_number",
             SUM(BYTE_LENGTH("data")) AS "bytes"
      FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
      WHERE "block_timestamp" >= 1672531200000000
      GROUP BY "block_number"
    )
    WHERE "bytes" > 4096
  )
  SELECT  
    PARSE_JSON(de."args")[0]::STRING AS "from_address",
    COUNT(*)                         AS "cnt",
    ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS "rnk"
  FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" de
  JOIN big_blocks bb
       ON de."block_number" = bb."block_number"
  WHERE de."event_signature" = 'Transfer(address,address,uint256)'
    AND PARSE_JSON(de."args")[1] IS NOT NULL
  GROUP BY "from_address"
)
SELECT 
  CONCAT('https://cronoscan.com/address/', "from_address") AS "cronoscan_url",
  "cnt" AS "transfer_count"
FROM ranked_senders
WHERE "rnk" = 1;
