--Description: Determine “large” blocks by totaling the character length of every LOGS."data" field
-- (hex-encoded; two characters ≈ one byte) for each block mined since 1-Jan-2023.  Using LENGTH()—
-- Snowflake’s available string-length function—to approximate byte count, we then return just the
-- blocks whose aggregated length surpasses 4 096 characters (≈4 KB).  This set will later delimit
-- the transfers we analyse for the most-frequent sender.
WITH blk AS (
    SELECT
        "block_number",
