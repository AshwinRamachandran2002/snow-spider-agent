```sql
--Description: Identify blocks since 1-Jan-2023 that (a) are “large” — total LENGTH("data") > 4 096
-- characters — and (b) actually contain at least one decoded Transfer event.  The query
-- first computes per-block size from LOGS, then counts Transfer events from DECODED_EVENTS,
-- finally joining the two sets so we can verify that such blocks exist and inspect how
-- many Transfer events each holds.
WITH block_sizes AS (                   -- total hex-string length of all LOGS.data per block
    SELECT
        l."block_number",
        SUM(LENGTH(l."data")) AS "bytes"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
    WHERE l."block_timestamp" >= 1672531200000000         -- 2023-01-01 in µs
    GROUP BY l."block_number"
),
transfer_counts AS (                    -- number of Transfer events per block
    SELECT
        de."BLOCK_NUMBER",
        COUNT(*) AS "transfer_events"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" de
    WHERE de."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND de."BLOCK_TIMESTAMP" >= 1672531200000000
    GROUP BY de."BLOCK_NUMBER"
)
SELECT
    bs."block_number",
    bs."bytes"                AS "approx_block_chars",
    tc."transfer_events"
FROM block_sizes bs
JOIN transfer_counts tc
  ON bs."block_number" = tc."BLOCK_NUMBER"
WHERE bs."bytes" > 4096                           -- “large” blocks
ORDER BY bs."bytes" DESC
LIMIT 20;
```
