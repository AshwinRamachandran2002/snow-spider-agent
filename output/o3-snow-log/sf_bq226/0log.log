--Description: Identify the sender address that appears most frequently in decoded Transfer
-- events occurring within “large” blocks (total LOGS."data" length > 512 characters) since
-- 1-Jan-2023, then return that sender’s Cronoscan URL along with its transfer count.
WITH big_blocks AS (                                   -- blocks meeting the size condition
    SELECT
        "block_number" AS "BLOCK_NUMBER"
    FROM (
        SELECT
            "block_number",
            SUM(LENGTH("data")) AS "bytes"
        FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
        WHERE "block_timestamp" >= 1672531200000000     -- 2023-01-01 UTC in µs
        GROUP BY "block_number"
    )
    WHERE "bytes" > 512                                -- “large” block threshold
),
sender_counts AS (                                     -- count transfers per sender
    SELECT
        PARSE_JSON(de."ARGS")[0]::STRING AS "from_address",
        COUNT(*)                                       AS "transfer_count"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" de
    JOIN big_blocks bb
      ON de."BLOCK_NUMBER" = bb."BLOCK_NUMBER"
    WHERE de."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
    GROUP BY "from_address"
)
SELECT
    CONCAT('https://cronoscan.com/address/', "from_address") AS "cronoscan_url",
    "transfer_count"
FROM sender_counts
