    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "block_timestamp" >= 1672531200000000     -- 2023-01-01 00:00:00 UTC in µs
    GROUP BY "block_number"
)
SELECT
    "block_number",
    "approx_block_chars"
FROM blk
WHERE "approx_block_chars" > 4096
ORDER BY "approx_block_chars" DESC
LIMIT 20;
