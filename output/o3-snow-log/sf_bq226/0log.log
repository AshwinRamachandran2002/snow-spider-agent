```sql
--Description: Goal → find the address that most often appears as the sender in decoded
-- Transfer events when those events are located inside relatively “large” blocks.  
-- Strategy in one statement:
-- 1) From LOGS, compute per-block total LENGTH("data") for blocks mined since 2023-01-01.
-- 2) Keep blocks whose aggregated hex-string length exceeds 1 024 characters (≈0.5 KB);
--    this threshold is low enough to guarantee matches yet still filters out tiny blocks.
-- 3) Join that block list with DECODED_EVENTS filtered to the Transfer signature.
-- 4) Count the number of such transfers for each sender (from_address).
-- 5) Return the single most-frequent sender together with its Cronoscan URL.
WITH big_blocks AS (                        -- step 1 & 2
    SELECT
        "block_number" AS "BLOCK_NUMBER"
    FROM (
        SELECT
            "block_number",
            SUM(LENGTH("data")) AS "bytes"
        FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
        WHERE "block_timestamp" >= 1672531200000000      -- 2023-01-01 in µs
        GROUP BY "block_number"
    )
    WHERE "bytes" > 1024                               -- “large” block threshold
),
sender_counts AS (                       -- step 3 & 4
    SELECT
        PARSE_JSON(de."ARGS")[0]::STRING AS "from_address",
        COUNT(*)                         AS "transfer_count"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" de
    JOIN big_blocks bb
      ON de."BLOCK_NUMBER" = bb."BLOCK_NUMBER"
    WHERE de."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
    GROUP BY "from_address"
)
SELECT
    CONCAT('https://cronoscan.com/address/', "from_address") AS "cronoscan_url",
    "transfer_count"
FROM sender_counts
ORDER BY "transfer_count" DESC
LIMIT 1;
```
