Query:
-- Description: Produce sender addresses as complete Cronoscan URLs, ordered by frequency
-- (top 20).  This simplified version works solely on DECODED_EVENTS (no join to LOGS),
-- keeps ERC-20 “Transfer” events after 2023-01-01, requires a non-null “to” address,
-- and counts how often each sender (“from” address) appears.

SELECT
    'https://cronoscan.com/address/' || LOWER(PARSE_JSON("ARGS")[0]::STRING) AS "sender_url",
    COUNT(*)                                                                 AS "tx_cnt"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_HASH"      = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'  -- ERC-20 Transfer
  AND "BLOCK_TIMESTAMP" > 1672531200000000  -- after 2023-01-01 (µs)
  AND PARSE_JSON("ARGS")[1]::STRING IS NOT NULL
GROUP BY "sender_url"
ORDER BY "tx_cnt" DESC
LIMIT 20
