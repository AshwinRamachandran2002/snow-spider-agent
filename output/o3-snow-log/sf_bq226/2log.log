```sql
-- Description / Thinking process:
-- Objective ➜ Identify which sender address appears most often in ERC-20 “Transfer”
-- events (non-null `to`) that belong to transactions whose *raw* log payload is larger
-- than 4 096 characters, after 2023-01-01.  
-- Strategy  
--   1. Join DECODED_EVENTS (alias d) to LOGS (alias l) on TRANSACTION_HASH only
--      (LOG_INDEX granularity mismatch made previous joins empty).  
--   2. Filter for “Transfer” events via their EVENT_HASH.  
--   3. Keep blocks after 2023-01-01 (micro-seconds).  
--   4. Require at least one raw-log entry in the same tx with LENGTH(l."data") > 4096.  
--   5. Keep only events whose decoded “to” address is not NULL.  
--   6. Group by the sender address (decoded “from”), format it as a full Cronoscan URL,
--      and order by frequency (top 20 shown).  
-- Note: Because we join on tx-hash only, a single large-payload log makes the entire
-- transaction qualify; that matches the “within blocks larger than 4096 bytes” intent.

SELECT  'https://cronoscan.com/address/' || LOWER(PARSE_JSON(d."ARGS")[0]::STRING) AS "sender_url",
        COUNT(*)                                                                  AS "tx_cnt"
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
JOIN   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"          l
       ON d."TRANSACTION_HASH" = l."transaction_hash"
WHERE  d."EVENT_HASH"      = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'  -- Transfer
  AND  d."BLOCK_TIMESTAMP" > 1672531200000000     -- after 2023-01-01 (µs)
  AND  LENGTH(l."data")    > 4096                 -- large payload
  AND  PARSE_JSON(d."ARGS")[1]::STRING IS NOT NULL
