```sql
WITH big_log_txs AS (                       -- all tx hashes that contain ≥4097-char log payloads (2023-01-01+)
    SELECT DISTINCT
           "transaction_hash"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "block_timestamp" > 1672531200000000           -- after 2023-01-01 (µs)
      AND LENGTH("data") > 4096                          -- large-payload log
)
SELECT
    'https://cronoscan.com/address/' ||
    LOWER(PARSE_JSON(de."ARGS")[0]::STRING) AS "sender_url",
    COUNT(*)                                   AS "tx_cnt"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" de
WHERE de."TRANSACTION_HASH" IN (SELECT "transaction_hash" FROM big_log_txs)     -- tx has big log
  AND de."EVENT_HASH"     = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'   -- ERC-20 Transfer
  AND de."BLOCK_TIMESTAMP" > 1672531200000000                                    -- after 2023-01-01
  AND PARSE_JSON(de."ARGS")[1] IS NOT NULL                                        -- non-null “to” address
GROUP BY "sender_url"
ORDER BY "tx_cnt" DESC NULLS LAST
LIMIT 1;
```
