```sql
WITH big_logs AS (   -- 1) logs whose DATA payload exceeds 4 096 chars, 2023-01-01+
    SELECT
        "transaction_hash",
        "log_index"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "block_timestamp" > 1672531200000000           -- after 2023-01-01 (µs)
      AND LENGTH("data") > 4096                          -- “blocks” (logs) > 4 096 B
)
SELECT                                                    -- 2) most-frequent sender URL
       'https://cronoscan.com/address/' ||
       LOWER(PARSE_JSON(de."ARGS")[0]::STRING) AS "sender_url",
       COUNT(*)                                          AS "tx_cnt"
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"  de
JOIN   big_logs bl
       ON  de."TRANSACTION_HASH" = bl."transaction_hash"
       AND de."LOG_INDEX"        = bl."log_index"
WHERE  de."EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'  -- ERC-20 Transfer
  AND  PARSE_JSON(de."ARGS")[1]::STRING IS NOT NULL       -- non-null “to” address
GROUP BY "sender_url"
ORDER BY "tx_cnt" DESC NULLS LAST
LIMIT 1;
```
