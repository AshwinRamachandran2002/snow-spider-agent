-- Description / Thinking process:
-- 1. Identify every transaction (TRANSACTION_HASH) whose raw LOGS contain at least one
--    entry with a `data` payload longer than 4 096 characters, in blocks after
--    2023-01-01 (timestamps are stored in micro-seconds).
-- 2. Within DECODED_EVENTS, keep only ERC-20 “Transfer” events (EVENT_HASH =
--    0xddf252…3b3ef) that (a) occurred in the same date range, (b) have a non-null
--    decoded “to” address (ARGS[1]), and (c) belong to one of the large-payload
--    transactions found in step 1.  
-- 3. Count how often each sender (“from” address = ARGS[0]) appears, format the
--    address as a full Cronoscan URL, and list the top 20 by frequency.

SELECT
    'https://cronoscan.com/address/' || LOWER(PARSE_JSON(d."ARGS")[0]::STRING) AS "sender_url",
    COUNT(*)                                                                   AS "tx_cnt"
FROM  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
WHERE d."EVENT_HASH"      = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'  -- ERC-20 Transfer
  AND d."BLOCK_TIMESTAMP" > 1672531200000000   -- after 2023-01-01 (µs)
  AND PARSE_JSON(d."ARGS")[1]::STRING IS NOT NULL
  AND d."TRANSACTION_HASH" IN (
        SELECT DISTINCT l."transaction_hash"
        FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
        WHERE l."block_timestamp" > 1672531200000000   -- same date cutoff
          AND LENGTH(l."data") > 4096                  -- large payload
      )
GROUP BY "sender_url"
ORDER BY "tx_cnt" DESC
LIMIT 20;
```
