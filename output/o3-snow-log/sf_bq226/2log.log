-- Description / Thinking process:
-- Previous queries were too restrictive (large-payload logs, strict joins) and
-- returned no rows. To confirm basic data presence, we now take the simplest
-- possible approach:
--   • Work solely with DECODED_EVENTS (no join to LOGS).
--   • Filter for ERC-20 “Transfer” events using their well-known EVENT_HASH.
--   • Restrict to blocks after 2023-01-01 (timestamps stored in micro-seconds).
--   • Keep only rows whose decoded “to” address (ARGS[1]) is not NULL,
--     matching the task’s requirement of non-null recipients.
--   • Count how often each sender (“from” address = ARGS[0]) appears and show
--     the 20 most-frequent senders.  This verifies that transfer data exists and
--     lets us inspect leading addresses before re-adding any further constraints.

SELECT
    PARSE_JSON("ARGS")[0]::STRING AS "from_addr",
    COUNT(*)                      AS "tx_cnt"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_HASH"      = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'  -- ERC-20 Transfer
  AND "BLOCK_TIMESTAMP" > 1672531200000000   -- after 2023-01-01 (µs)
  AND PARSE_JSON("ARGS")[1]::STRING IS NOT NULL
GROUP BY "from_addr"
ORDER BY "tx_cnt" DESC
LIMIT 20;
```
