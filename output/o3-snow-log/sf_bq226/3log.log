```

```sql
--Description: Top-20 addresses that emitted the most decoded events after 1-Jan-2023.
SELECT
  "ADDRESS",
  COUNT(*) AS "event_cnt"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "BLOCK_TIMESTAMP" >= 1672444800000000
GROUP BY "ADDRESS"
ORDER BY "event_cnt" DESC
LIMIT 20;
```

```sql
--Description: Peek at 20 ERC-20 Transfer events and parse ARGS into from / to / value fields.
SELECT
  "ADDRESS"                                              AS "token_contract",
  TRY_PARSE_JSON("ARGS")[0]::STRING                      AS "from_address",
  TRY_PARSE_JSON("ARGS")[1]::STRING                      AS "to_address",
  TRY_PARSE_JSON("ARGS")[2]::STRING                      AS "amount_raw"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
LIMIT 20;
```

```sql
--Description: Count how many Transfer events each sender (“from_address”) initiated since 2023-01-01.
SELECT
  TRY_PARSE_JSON("ARGS")[0]::STRING AS "from_address",
  COUNT(*)                          AS "transfer_cnt"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672444800000000
GROUP BY "from_address"
ORDER BY "transfer_cnt" DESC
LIMIT 20;
```

```sql
--Description: Same as above but keep only transfers whose “to_address” is non-zero / non-null.
SELECT
  TRY_PARSE_JSON("ARGS")[0]::STRING AS "from_address",
  COUNT(*)                          AS "transfer_cnt"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672444800000000
  AND TRY_PARSE_JSON("ARGS")[1]::STRING IS NOT NULL
  AND TRY_PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
GROUP BY "from_address"
ORDER BY "transfer_cnt" DESC
LIMIT 20;
```

```sql
--Description: Build full Cronoscan URLs for the most frequent senders (top 20) in valid transfers.
SELECT
  CONCAT('https://cronoscan.com/address/', LOWER(TRY_PARSE_JSON("ARGS")[0]::STRING)) AS "sender_url",
  COUNT(*)                                                                            AS "transfer_cnt"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672444800000000
  AND TRY_PARSE_JSON("ARGS")[1]::STRING IS NOT NULL
  AND TRY_PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
GROUP BY "sender_url"
ORDER BY "transfer_cnt" DESC
LIMIT 20;
```
