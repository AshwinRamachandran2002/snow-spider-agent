--Description: Retrieve the 20 most-frequent sender addresses in all “Transfer” events since
--             1-Jan-2023, provided the surrounding transaction (same TRANSACTION_HASH) includes
--             at least one log whose `data` field exceeds 4 096 characters.  This broad match on
--             TRANSACTION_HASH (ignoring LOG_INDEX) keeps the query simple while still satisfying
--             the “large-block” requirement.  Counts are grouped by the sender (ARGS[0]) and
--             rendered as full Cronoscan URLs.
SELECT
    CONCAT('https://cronoscan.com/address/', PARSE_JSON(e."ARGS")[0]::STRING) AS "sender_url",
    COUNT(*)                                                                 AS "transfer_count"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS" e
WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND e."BLOCK_TIMESTAMP" >= 1672531200000000                    -- 2023-01-01 in µ-seconds
  AND EXISTS (
        SELECT 1
        FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS" l
        WHERE l."transaction_hash" = e."TRANSACTION_HASH"
          AND LENGTH(l."data") > 4096
      )
GROUP BY "sender_url"
ORDER BY "transfer_count" DESC
LIMIT 20;
