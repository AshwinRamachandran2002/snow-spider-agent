        SELECT 1
        FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS" l
        WHERE l."TRANSACTION_HASH" = e."TRANSACTION_HASH"
          AND LENGTH(l."data") > 4096
      )
GROUP BY "sender_url"
ORDER BY "transfer_count" DESC
LIMIT 20;
