--Description: Goal is to identify the sender address (as a Cronoscan URL) that occurs most often in “Transfer”
--             events since 1-Jan-2023, but *only* when the transaction also contains at least one log
--             whose `data` field is larger than 4 096 bytes (proxy for “blocks larger than 4 096 bytes”).
--             Steps:
--               1. Filter DECODED_EVENTS to “Transfer(address,address,uint256)” with timestamp ≥ 2023-01-01.
--               2. Exclude rows whose `to_address` (ARGS[1]) is the zero address.
--               3. Use EXISTS to ensure the same transaction hash appears in LOGS with LENGTH(data) > 4 096.
--               4. Aggregate by the sender (`from_address` = ARGS[0]) and turn it into a Cronoscan URL.
--               5. Order by the count, descending, and show the top 20.
SELECT
    CONCAT('https://cronoscan.com/address/', PARSE_JSON(e."ARGS")[0]::STRING)  AS "sender_url",
    COUNT(*)                                                                  AS "transfer_count"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS" e
WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND e."BLOCK_TIMESTAMP" >= 1672531200000000                                  -- 2023-01-01 in µs
  AND PARSE_JSON(e."ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
