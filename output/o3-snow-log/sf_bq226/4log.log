/*  Most-frequent sender URL in “Transfer” events whose “to” field is present
    (non-null) and which occurred after 1-Jan-2023 inside any block that
    contains at least one log entry with a data payload longer than 4 096
    characters.                                                      */

WITH big_blocks AS (          -- blocks that have at least one very large log
    SELECT DISTINCT
           "block_number"
    FROM   GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS"
    WHERE  LENGTH("data") > 4096
),

filtered_transfers AS (       -- qualifying ERC-20 Transfer events
    SELECT
           PARSE_JSON(d."ARGS")[0]::STRING AS "from_address"
    FROM   GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS" d
    WHERE  d."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND  d."BLOCK_TIMESTAMP" >= 1672531200000000               -- 2023-01-01 (µ-sec)
      AND  PARSE_JSON(d."ARGS")[1] IS NOT NULL                   -- ensure “to” exists
      AND  d."BLOCK_NUMBER" IN (SELECT "block_number" FROM big_blocks)
)

SELECT
       CONCAT('https://cronoscan.com/address/', "from_address") AS "sender_url",
       COUNT(*)                                                AS "transfer_count"
FROM   filtered_transfers
GROUP  BY "sender_url"
ORDER  BY "transfer_count" DESC NULLS LAST
LIMIT  1;
