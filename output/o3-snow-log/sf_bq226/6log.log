```sql
--Description: 4)  Parse the JSON array in ARGS to extract sender (“from”) and receiver (“to”) addresses
SELECT
  PARSE_JSON("ARGS")[0]::STRING  AS "from_address",
  PARSE_JSON("ARGS")[1]::STRING  AS "to_address",
  PARSE_JSON("ARGS")[2]::STRING  AS "value",
  "TRANSACTION_HASH",
  "BLOCK_NUMBER",
  "BLOCK_TIMESTAMP"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
LIMIT 20;
```

```sql
--Description: 5)  Inspect rows where the receiver (“to_address”) is non-null (not the zero address)
SELECT *
FROM (
  SELECT
    PARSE_JSON("ARGS")[0]::STRING  AS "from_address",
    PARSE_JSON("ARGS")[1]::STRING  AS "to_address",
    "TRANSACTION_HASH"
  FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
  WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
    AND "BLOCK_TIMESTAMP" >= 1672531200000000
) t
WHERE "to_address" ILIKE '0x%'                -- keep normal addresses
  AND "to_address" <> '0x0000000000000000000000000000000000000000'
LIMIT 20;
```

```sql
--Description: 6)  Count how many times each sender address appears (to non-null receivers) since 2023
SELECT
  PARSE_JSON("ARGS")[0]::STRING  AS "from_address",
  COUNT(*)                       AS "txs_from_sender"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
  AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
GROUP BY "from_address"
ORDER BY "txs_from_sender" DESC
LIMIT 20;
```

```sql
--Description: 7)  Produce the same ranking but also turn the raw sender address into a full Cronoscan URL
SELECT
  CONCAT('https://cronoscan.com/address/', PARSE_JSON("ARGS")[0]::STRING)   AS "cronoscan_sender_url",
  COUNT(*)                                                                  AS "txs_from_sender"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
  AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
GROUP BY "cronoscan_sender_url"
ORDER BY "txs_from_sender" DESC
LIMIT 20;
```

```sql
--Description: 8)  Return only the single most-frequent sender URL (final answer candidate)
SELECT
  CONCAT('https://cronoscan.com/address/', PARSE_JSON("ARGS")[0]::STRING) AS "most_frequent_sender_url",
  COUNT(*)                                                                AS "total_transactions"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
  AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
GROUP BY "most_frequent_sender_url"
ORDER BY "total_transactions" DESC
LIMIT 1;
```

```sql
--Description: 9)  (Optional deeper check)  Show monthly counts for that same top sender to verify consistency
WITH top_sender AS (
    SELECT PARSE_JSON("ARGS")[0]::STRING AS "sender"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND "BLOCK_TIMESTAMP" >= 1672531200000000
      AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
    GROUP BY "sender"
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT
  DATE_TRUNC('month', TO_TIMESTAMP_NTZ("BLOCK_TIMESTAMP"/1e6)) AS "month",
  COUNT(*)                                                     AS "txs_in_month"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
JOIN top_sender s
  ON PARSE_JSON(e."ARGS")[0]::STRING = s."sender"
WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND e."BLOCK_TIMESTAMP" >= 1672531200000000
  AND PARSE_JSON(e."ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
GROUP BY "month"
ORDER BY "month"
LIMIT 20;
```

```sql
--Description: 10)  Bring in the original LOGS table to double-check the same sender by matching on transaction hash
SELECT
  CONCAT('https://cronoscan.com/address/', d_sender.sender)::STRING AS "cronoscan_sender_url",
  COUNT(*)                                                         AS "logs_rows"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
JOIN (
    SELECT DISTINCT "TRANSACTION_HASH",
           PARSE_JSON("ARGS")[0]::STRING AS "sender"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND "BLOCK_TIMESTAMP" >= 1672531200000000
      AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
) d_sender
  ON l."TRANSACTION_HASH" = d_sender."TRANSACTION_HASH"
GROUP BY "cronoscan_sender_url"
ORDER BY "logs_rows" DESC
LIMIT 20;
```
