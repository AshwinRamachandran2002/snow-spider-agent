```sql
WITH big_blocks AS (   -- blocks whose total logs’ data exceed 4 096 bytes
    SELECT
        "block_number"
    FROM (
        SELECT
            "block_number",
            SUM( (LENGTH("data") - 2) / 2 ) AS bytes_in_block        -- (hex chars-2) /2 ≈ bytes
        FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
        GROUP BY "block_number"
    )
    WHERE bytes_in_block > 4096
),

transfer_events AS (   -- “Transfer” events in big blocks since 2023-01-01 with a non-zero receiver
    SELECT
        PARSE_JSON("ARGS")[0]::STRING AS sender,
        PARSE_JSON("ARGS")[1]::STRING AS receiver
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
    JOIN big_blocks b
        ON e."BLOCK_NUMBER" = b."block_number"
    WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND e."BLOCK_TIMESTAMP" >= 1672531200000000        -- 2023-01-01 in µs
      AND receiver <> '0x0000000000000000000000000000000000000000'
)

SELECT
    CONCAT('https://cronoscan.com/address/', sender) AS "most_frequent_sender_url",
    COUNT(*)                                        AS "total_transactions"
FROM transfer_events
GROUP BY sender
ORDER BY "total_transactions" DESC NULLS LAST
LIMIT 1;
```
