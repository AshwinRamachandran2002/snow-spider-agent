```sql
--Description:
-- We need the single sender address that shows up most often since 2023-01-01 in
-- on-chain “Transfer” events whose receiver (‘to_address’) is not the zero address.
-- Steps executed in one query:
--   1.  Filter the DECODED_EVENTS table for rows whose EVENT_SIGNATURE equals
--       ‘Transfer(address,address,uint256)’ and whose BLOCK_TIMESTAMP is on/after
--       2023-01-01 (1672531200000000 µs).
--   2.  From the JSON array stored in ARGS, pull index 0 (“from” address) and
--       index 1 (“to” address).  Discard rows whose ‘to’ address is the zero address.
--   3.  Group by the ‘from’ address, count how many qualifying transfers each has
--       produced, order descending, and keep only the top result.
--   4.  Present the sender as a full Cronoscan URL.
SELECT
  CONCAT('https://cronoscan.com/address/', sender) AS "cronoscan_sender_url",
  COUNT(*)                                         AS "total_transfers"
FROM (
    SELECT
      PARSE_JSON("ARGS")[0]::STRING AS sender,
      PARSE_JSON("ARGS")[1]::STRING AS receiver
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND "BLOCK_TIMESTAMP" >= 1672531200000000            -- 2023-01-01 (μs)
) t
WHERE receiver <> '0x0000000000000000000000000000000000000000'  -- non-null ‘to’
GROUP BY sender
ORDER BY "total_transfers" DESC
LIMIT 1;
```
