Query:
--Description: 9)  (Optional deeper check)  Show monthly counts for that same top sender to verify consistency
WITH top_sender AS (
    SELECT PARSE_JSON("ARGS")[0]::STRING AS "sender"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND "BLOCK_TIMESTAMP" >= 1672531200000000
      AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
    GROUP BY "sender"
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT
  DATE_TRUNC('month', TO_TIMESTAMP_NTZ("BLOCK_TIMESTAMP"/1e6)) AS "month",
  COUNT(*)                                                     AS "txs_in_month"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
JOIN top_sender s
  ON PARSE_JSON(e."ARGS")[0]::STRING = s."sender"
WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND e."BLOCK_TIMESTAMP" >= 1672531200000000
  AND PARSE_JSON(e."ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
GROUP BY "month"
ORDER BY "month"
LIMIT 20;
