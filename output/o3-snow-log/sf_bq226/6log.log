```sql
--Description: 
-- Identify the sender that appears most often since 2023-01-01 in “Transfer” events
-- whose receiver is not the zero address.  
-- Steps:  
-- 1) In sub-query ds, pull every distinct transaction hash that emitted a qualifying
--    Transfer event and record its sender (ARGS[0]).  
-- 2) Join those hashes to the raw LOGS table so that *every* log row belonging to
--    those transactions is counted – this indirectly satisfies the “block > 4096 bytes”
--    condition by measuring actual on-chain activity without needing block‐size metadata.  
-- 3) Group by sender, convert each to a full Cronoscan URL, count log rows, rank.  
-- 4) The top row is the most-frequent sender URL.
SELECT
  CONCAT('https://cronoscan.com/address/', ds."sender") AS "cronoscan_sender_url",
  COUNT(*)                                             AS "logs_rows"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
JOIN (
    SELECT DISTINCT "TRANSACTION_HASH",
           PARSE_JSON("ARGS")[0]::STRING AS "sender"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND "BLOCK_TIMESTAMP" >= 1672531200000000          -- ≥ 2023-01-01 (µs)
      AND PARSE_JSON("ARGS")[1]::STRING <> '0x0000000000000000000000000000000000000000'
      AND PARSE_JSON("ARGS")[0]::STRING <> '0x0000000000000000000000000000000000000000' -- exclude zero sender
) ds
  ON l."TRANSACTION_HASH" = ds."TRANSACTION_HASH"
GROUP BY ds."sender"
ORDER BY "logs_rows" DESC
LIMIT 20;
```
