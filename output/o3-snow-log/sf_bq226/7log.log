```

```sql
--Description:  Grab Transfer events that live inside those large blocks (block size > 4 096 bytes) and show their from/to addresses
WITH block_sizes AS (   
    SELECT
        "block_number",
        SUM(LENGTH("data")) AS "block_data_bytes"
