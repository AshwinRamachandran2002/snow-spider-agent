LIMIT 20;
```

```sql
--Description:  Pull out “from” and “to” addresses of Transfer events (first two elements of the ARGS array)
SELECT 
    PARSE_JSON("ARGS")[0]::STRING  AS "from_address",
    PARSE_JSON("ARGS")[1]::STRING  AS "to_address",
    "BLOCK_NUMBER",
    "BLOCK_TIMESTAMP"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672531200000000
LIMIT 20;
```

```sql
--Description:  Approximate block size by summing the byte-length of the “data” field for every log in each block (Jan-2023 forward)
SELECT 
    "BLOCK_NUMBER",
    SUM(LENGTH("DATA"))                          AS "block_data_bytes"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE "BLOCK_TIMESTAMP" >= 1672531200000000
GROUP BY "BLOCK_NUMBER"
ORDER BY "block_data_bytes" DESC
LIMIT 20;
```

```sql
--Description:  Identify all blocks from 2023-01-01 forward whose aggregated “data” exceeds 4 096 bytes
WITH block_sizes AS (   
    SELECT 
        "BLOCK_NUMBER",
        SUM(LENGTH("DATA")) AS "block_data_bytes"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "BLOCK_TIMESTAMP" >= 1672531200000000
    GROUP BY "BLOCK_NUMBER"
)
SELECT *
FROM block_sizes
WHERE "block_data_bytes" > 4096
ORDER BY "block_data_bytes" DESC
LIMIT 20;
```

```sql
--Description:  Join the large-block list back to decoded Transfer events to keep only events inside those “large” blocks
WITH block_sizes AS (   
    SELECT 
        "BLOCK_NUMBER",
        SUM(LENGTH("DATA")) AS "block_data_bytes"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "BLOCK_TIMESTAMP" >= 1672531200000000
    GROUP BY "BLOCK_NUMBER"
    HAVING "block_data_bytes" > 4096
)
SELECT 
    e."TRANSACTION_HASH",
    PARSE_JSON(e."ARGS")[0]::STRING  AS "from_address",
    PARSE_JSON(e."ARGS")[1]::STRING  AS "to_address",
    e."BLOCK_NUMBER"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
JOIN block_sizes b
  ON e."BLOCK_NUMBER" = b."BLOCK_NUMBER"
WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON(e."ARGS")[1] IS NOT NULL
LIMIT 20;
```

```sql
--Description:  Count how many times each sender (“from_address”) appears in those filtered events
WITH block_sizes AS (   
    SELECT 
        "BLOCK_NUMBER",
        SUM(LENGTH("DATA")) AS "block_data_bytes"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "BLOCK_TIMESTAMP" >= 1672531200000000
    GROUP BY "BLOCK_NUMBER"
    HAVING "block_data_bytes" > 4096
), large_block_events AS (
    SELECT 
        PARSE_JSON(e."ARGS")[0]::STRING  AS "from_address"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
    JOIN block_sizes b
      ON e."BLOCK_NUMBER" = b."BLOCK_NUMBER"
    WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND PARSE_JSON(e."ARGS")[1] IS NOT NULL        -- non-null to_address
)
SELECT 
    "from_address",
    COUNT(*) AS "tx_count"
FROM large_block_events
GROUP BY "from_address"
ORDER BY "tx_count" DESC
LIMIT 20;
```

```sql
--Description:  Convert each sender address into a full Cronoscan URL and order by frequency
WITH block_sizes AS (   
    SELECT 
        "BLOCK_NUMBER",
        SUM(LENGTH("DATA")) AS "block_data_bytes"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "BLOCK_TIMESTAMP" >= 1672531200000000
    GROUP BY "BLOCK_NUMBER"
    HAVING "block_data_bytes" > 4096
), large_block_events AS (
    SELECT 
        PARSE_JSON(e."ARGS")[0]::STRING  AS "from_address"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
    JOIN block_sizes b
      ON e."BLOCK_NUMBER" = b."BLOCK_NUMBER"
    WHERE e."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND PARSE_JSON(e."ARGS")[1] IS NOT NULL
)
SELECT 
    CONCAT('https://cronoscan.com/address/', LOWER("from_address")) AS "sender_url",
    COUNT(*)                                                       AS "tx_count"
FROM large_block_events
GROUP BY "sender_url"
ORDER BY "tx_count" DESC
LIMIT 20;
```

```sql
--Description:  Final single-row answer – the most frequently seen sender URL on Cronoscan under the stated constraints
