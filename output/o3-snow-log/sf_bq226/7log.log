Query:
--Description:  Return the single most-frequent Cronoscan sender URL for transfers since 2023-01-01
WITH transfers AS (
    SELECT
        PARSE_JSON("ARGS")[0]::STRING AS from_address
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND "BLOCK_TIMESTAMP" >= 1672531200000000
      AND PARSE_JSON("ARGS")[1] IS NOT NULL
)
SELECT
    CONCAT('https://cronoscan.com/address/', LOWER(from_address)) AS most_frequent_sender_url,
    COUNT(*)                                                     AS tx_count
FROM transfers
GROUP BY most_frequent_sender_url
ORDER BY tx_count DESC
LIMIT 1
