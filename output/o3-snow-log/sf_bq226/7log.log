```sql
--Description / Thinking process:
--Instead of restricting to “large” blocks (which returned no matches), first establish a baseline:
--count how many ERC-20 Transfer events each sender address (“from” address) has emitted on-chain since 2023-01-01,
--without any block-size filter.  We then render every sender as a full Cronoscan URL and show the 20 most-frequent.
WITH transfers AS (
    SELECT
        PARSE_JSON("ARGS")[0]::STRING AS from_address,
        PARSE_JSON("ARGS")[1]::STRING AS to_address
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
      AND "BLOCK_TIMESTAMP" >= 1672531200000000      -- 2023-01-01 in µs
      AND PARSE_JSON("ARGS")[1] IS NOT NULL          -- ensure non-null to_address
)
SELECT
    CONCAT('https://cronoscan.com/address/', LOWER(from_address)) AS sender_url,
    COUNT(*)                                                     AS tx_count
FROM transfers
GROUP BY sender_url
ORDER BY tx_count DESC
LIMIT 20;
