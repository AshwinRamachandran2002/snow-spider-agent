Query:
--Description:  List every block since 2023-01-01 whose cumulative log-data length exceeds 4 096 bytes
WITH block_sizes AS (   
    SELECT
        "block_number",
        SUM(LENGTH("data")) AS "block_data_bytes"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE "block_timestamp" >= 1672531200000000          -- 2023-01-01 in µs
    GROUP BY "block_number"
)
SELECT *
FROM block_sizes
WHERE "block_data_bytes" > 4096
ORDER BY "block_data_bytes" DESC
LIMIT 20
