```sql
--Description: Prior attempts joining on both transaction_hash and log_index showed no matches, so we test overlap more simply.
--We pull Transfer events emitted since 2023-01-01 from DECODED_EVENTS and keep only those whose transaction_hash
--also appears in the LOGS table (checked with an EXISTS sub-query).  This sidesteps any log_index mismatch while
--retaining the date filter, and previews 20 matching rows with the decoded “from” and “to” addresses.
SELECT
  d."transaction_hash",
  d."block_number",
  d."log_index"                 AS "tx_log_index",
  d."address"                   AS "token_contract",
  PARSE_JSON(d."args")[0]::STRING AS "from_address",
  PARSE_JSON(d."args")[1]::STRING AS "to_address"
FROM
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
WHERE
  d."event_signature" = 'Transfer(address,address,uint256)'
  AND d."block_timestamp" >= 1672531200 * 1000000        -- on/after 2023-01-01
  AND EXISTS (
        SELECT 1
        FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
        WHERE l."transaction_hash" = d."transaction_hash"
      )
LIMIT 20;
```
