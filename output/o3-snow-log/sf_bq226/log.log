```sql
--Description: Fetch some Transfer events since 2023-01-01 to confirm ARRAY layout in ARGS (index 0 => from, 1 => to, 2 => value).
SELECT 
  "TRANSACTION_HASH",
  "BLOCK_NUMBER",
  "BLOCK_TIMESTAMP",
  "ADDRESS"            AS "TOKEN_ADDRESS",
  PARSE_JSON("ARGS")[0]::STRING AS "FROM_ADDRESS",
  PARSE_JSON("ARGS")[1]::STRING AS "TO_ADDRESS",
  PARSE_JSON("ARGS")[2]::STRING AS "AMOUNT"
FROM 
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE 
  "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672531200 * 1000000  -- 2023-01-01 UTC (µs)
LIMIT 20;
```

```sql
--Description: Count total number of Transfer events per sending (“from”) address since 2023-01-01.
SELECT 
  PARSE_JSON("ARGS")[0]::STRING AS "FROM_ADDRESS",
  COUNT(*)                      AS "TRANSFER_EVENTS"
FROM 
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE 
  "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672531200 * 1000000  -- 2023-01-01
GROUP BY 
  "FROM_ADDRESS"
ORDER BY 
  "TRANSFER_EVENTS" DESC
LIMIT 20;
```

```sql
--Description: Retrieve log-level information for blocks larger than 4 096 bytes (block size not stored; approximate with log length >4 096).
SELECT
  "BLOCK_NUMBER",
  "TRANSACTION_HASH",
  "ADDRESS",
