Query:
--Description: Count total number of Transfer events per sending (“from”) address since 2023-01-01.
SELECT
  PARSE_JSON("ARGS")[0]::STRING AS "FROM_ADDRESS",
  COUNT(*)                      AS "TRANSFER_EVENTS"
FROM
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE
  "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND "BLOCK_TIMESTAMP" >= 1672531200 * 1000000
GROUP BY
  "FROM_ADDRESS"
ORDER BY
  "TRANSFER_EVENTS" DESC
LIMIT 20
