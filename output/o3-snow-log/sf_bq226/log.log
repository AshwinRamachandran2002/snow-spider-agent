```sql
WITH transfer_events AS (
    SELECT
        PARSE_JSON("ARGS")[0]::STRING AS "FROM_ADDRESS",
        PARSE_JSON("ARGS")[1]::STRING AS "TO_ADDRESS",
        "BLOCK_NUMBER"
    FROM
        "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_CRONOS_MAINNET_US"."DECODED_EVENTS"
    WHERE
        "EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
        AND "BLOCK_TIMESTAMP" >= 1672531200 * 1000000          -- 2023-01-01 in µs
),
big_blocks AS (
    SELECT
        "NUMBER" AS "BLOCK_NUMBER"
    FROM
        "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_CRONOS_MAINNET_US"."BLOCKS"
    WHERE
        "SIZE" > 4096                                           -- blocks larger than 4 096 bytes
)
SELECT
    CONCAT('https://cronoscan.com/address/', LOWER("FROM_ADDRESS")) AS "SENDER_URL"
FROM
    transfer_events
    JOIN big_blocks USING ("BLOCK_NUMBER")
WHERE
    "TO_ADDRESS" IS NOT NULL
    AND "TO_ADDRESS" <> '0x0000000000000000000000000000000000000000'
GROUP BY
    "SENDER_URL"
ORDER BY
    COUNT(*) DESC NULLS LAST
LIMIT 1;
```
