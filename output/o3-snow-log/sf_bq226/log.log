```sql
--Description: Identify logs whose hexadecimal "data" payload encodes more than 4 096 bytes.  
--Because two hex characters represent one byte, any payload larger than 4 096 bytes will have > 8 192 characters (plus the “0x” prefix).  
--We therefore filter on LENGTH("data") > 8192 and restrict results to logs from 2023-01-01 onward to examine recent large-payload entries.
SELECT
  "block_number",
  "transaction_hash",
  "address",
  LENGTH("data") AS "data_char_count"
FROM
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE
  LENGTH("data") > 8192              -- >4 096 bytes
  AND "block_timestamp" >= 1672531200 * 1000000  -- on/after 2023-01-01
LIMIT 20;
```
