--Description: Join logs with decoded Transfer events on transaction_hash & log_index to verify matching rows (uses correct lowercase column names for LOGS and uppercase for DECODED_EVENTS).
SELECT
  d."BLOCK_NUMBER",
  d."LOG_INDEX",
  d."TRANSACTION_HASH",
  d."ADDRESS"                     AS "TOKEN_ADDRESS",
  PARSE_JSON(d."ARGS")[0]::STRING AS "FROM_ADDRESS",
  PARSE_JSON(d."ARGS")[1]::STRING AS "TO_ADDRESS"
FROM
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
JOIN
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
    ON d."TRANSACTION_HASH" = l."transaction_hash"
   AND d."LOG_INDEX"        = l."log_index"
WHERE
  d."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND d."BLOCK_TIMESTAMP" >= 1672531200 * 1000000
LIMIT 20;
```

```sql
--Description: Count Transfer events whose TO_ADDRESS is non-null and whose corresponding log DATA length exceeds 4 096 bytes (hex string > 8 192 chars), grouping by FROM_ADDRESS.
SELECT
  PARSE_JSON(d."ARGS")[0]::STRING AS "FROM_ADDRESS",
  COUNT(*)                        AS "events_with_large_data"
FROM
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
JOIN
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
    ON d."TRANSACTION_HASH" = l."transaction_hash"
   AND d."LOG_INDEX"        = l."log_index"
WHERE
  d."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON(d."ARGS")[1] IS NOT NULL
  AND LENGTH(l."data") > 8192           -- >4 096 bytes
  AND d."BLOCK_TIMESTAMP" >= 1672531200 * 1000000
GROUP BY
  "FROM_ADDRESS"
ORDER BY
  "events_with_large_data" DESC
LIMIT 20;
```

```sql
--Description: Produce complete Cronoscan URLs for the top-used sender addresses in all Transfer events since 2023-01-01.
SELECT
  'https://cronoscan.com/address/' || PARSE_JSON(d."ARGS")[0]::STRING AS "sender_url",
  COUNT(*)                                                             AS "total_events"
FROM
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
WHERE
  d."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND d."BLOCK_TIMESTAMP" >= 1672531200 * 1000000
GROUP BY
  "sender_url"
ORDER BY
  "total_events" DESC
LIMIT 20;
```

