  AND "BLOCK_TIMESTAMP" >= 1672531200 * 1000000  -- 2023-01-01
LIMIT 20;
```

```sql
--Description: Join logs with decoded Transfer events on transaction_hash & log_index to verify matching rows (sample only).
SELECT 
  d."BLOCK_NUMBER",
  d."LOG_INDEX",
  d."TRANSACTION_HASH",
  d."ADDRESS"                      AS "TOKEN_ADDRESS",
  PARSE_JSON(d."ARGS")[0]::STRING  AS "FROM_ADDRESS",
  PARSE_JSON(d."ARGS")[1]::STRING  AS "TO_ADDRESS"
FROM 
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
JOIN 
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
  ON  d."TRANSACTION_HASH" = l."TRANSACTION_HASH"
  AND d."LOG_INDEX"      = l."LOG_INDEX"
WHERE 
  d."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND d."BLOCK_TIMESTAMP" >= 1672531200 * 1000000
LIMIT 20;
```

```sql
--Description: Count Transfer events whose TO_ADDRESS is non-null and underlying DATA length >4 096 bytes, grouping by FROM_ADDRESS.
SELECT
  PARSE_JSON(d."ARGS")[0]::STRING AS "FROM_ADDRESS",
  COUNT(*)                        AS "EVENTS_WITH_LARGE_DATA"
FROM 
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
JOIN 
  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS" l
  ON  d."TRANSACTION_HASH" = l."TRANSACTION_HASH"
  AND d."LOG_INDEX"        = l."LOG_INDEX"
WHERE 
  d."EVENT_SIGNATURE" = 'Transfer(address,address,uint256)'
  AND PARSE_JSON(d."ARGS")[1] IS NOT NULL          -- TO_ADDRESS present
  AND BYTE_LENGTH(l."DATA") > 4096                -- “block size” proxy
  AND d."BLOCK_TIMESTAMP" >= 1672531200 * 1000000 -- 2023-01-01
GROUP BY 
  "FROM_ADDRESS"
ORDER BY 
  "EVENTS_WITH_LARGE_DATA" DESC
LIMIT 20;
```

