--Description: (6) Compute the average distinct-NPI count across those TOP-10 specializations
WITH spec_counts AS ( /* query 5 above */ ),
top10 AS (
    SELECT *
      FROM spec_counts
     ORDER BY npi_cnt DESC
     LIMIT 10
)
SELECT AVG(npi_cnt) AS avg_npi_cnt
  FROM top10;
```

```sql
--Description: (7) Return the specialization in TOP-10 whose NPI count is closest to that average
WITH spec_counts AS ( /* query 5 above */ ),
top10 AS (
    SELECT *
      FROM spec_counts
     ORDER BY npi_cnt DESC
     LIMIT 10
), avg_val AS (
    SELECT AVG(npi_cnt) AS avg_npi_cnt FROM top10
)
SELECT t.specialization,
       t.npi_cnt,
       a.avg_npi_cnt,
       ABS(t.npi_cnt - a.avg_npi_cnt) AS diff_from_avg
  FROM top10 t
 CROSS JOIN avg_val a
 ORDER BY diff_from_avg
 LIMIT 1;
```

