), spec_counts AS (
    SELECT specialization,
           COUNT(DISTINCT "npi") AS npi_cnt
      FROM base
     WHERE specialization IS NOT NULL AND specialization <> ''
     GROUP BY specialization
), top10 AS (
    SELECT * FROM spec_counts ORDER BY npi_cnt DESC LIMIT 10
), closest AS (
    SELECT specialization
      FROM (
            SELECT specialization,
                   npi_cnt,
                   ABS(npi_cnt - (SELECT AVG(npi_cnt) FROM top10)) AS diff_
              FROM top10
      )
     ORDER BY diff_
     LIMIT 1
)
SELECT DISTINCT
       b."npi",
       b."provider_first_name",
       b."provider_last_name_legal_name",
       b.specialization
  FROM base b
  JOIN closest c  ON b.specialization = c.specialization
 LIMIT 20
