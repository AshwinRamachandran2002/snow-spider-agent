```sql
-- 4. Count distinct NPIs per specialization for Mountain View, CA
SELECT 
  specialization,
  COUNT(DISTINCT npi) AS npi_cnt
FROM (
    /* same UNION-ALL block as Query 3, limited to providers in Mountain View CA */
    SELECT "npi", "healthcare_provider_taxonomy_1_specialization"  AS specialization FROM "NPPES"."NPPES"."NPI_OPTIMIZED"
      WHERE "provider_business_practice_location_address_city_name" ILIKE '%mountain%view%'
        AND "provider_business_practice_location_address_state_name" = 'CA'
    UNION ALL
    SELECT "npi", "healthcare_provider_taxonomy_2_specialization"  FROM "NPPES"."NPPES"."NPI_OPTIMIZED"
      WHERE "provider_business_practice_location_address_city_name" ILIKE '%mountain%view%'
        AND "provider_business_practice_location_address_state_name" = 'CA'
    /* repeat for cols 3-15 … */
) t
WHERE specialization IS NOT NULL AND specialization <> ''
GROUP BY specialization
ORDER BY npi_cnt DESC
LIMIT 20;
```

```sql
-- 5. Derive the TOP-10 most common specializations (distinct NPI count) in Mountain View CA
WITH spec_counts AS (
  SELECT 
    specialization,
    COUNT(DISTINCT npi) AS npi_cnt
  FROM (
      /* same UNION-ALL block as above, providers in Mountain View, CA */
      SELECT "npi", "healthcare_provider_taxonomy_1_specialization"  AS specialization FROM "NPPES"."NPPES"."NPI_OPTIMIZED"
        WHERE "provider_business_practice_location_address_city_name" ILIKE '%mountain%view%'
          AND "provider_business_practice_location_address_state_name" = 'CA'
      UNION ALL
      SELECT "npi", "healthcare_provider_taxonomy_2_specialization"  FROM "NPPES"."NPPES"."NPI_OPTIMIZED"
        WHERE "provider_business_practice_location_address_city_name" ILIKE '%mountain%view%'
          AND "provider_business_practice_location_address_state_name" = 'CA'
      /* repeat for cols 3-15 … */
  ) u
  WHERE specialization IS NOT NULL AND specialization <> ''
  GROUP BY specialization
)
SELECT * 
FROM spec_counts
ORDER BY npi_cnt DESC
LIMIT 10;
```

```sql
-- 6. Compute the average distinct-NPI count across those TOP-10 specializations
WITH spec_counts AS ( /* same CTE as Query 5 */ ),
top10 AS (
  SELECT * 
  FROM spec_counts 
  ORDER BY npi_cnt DESC
  LIMIT 10
)
SELECT AVG(npi_cnt) AS avg_npi_cnt
FROM top10;
```

```sql
-- 7. Find the TOP-10 specialization whose NPI count is closest to that average
WITH spec_counts AS ( /* same CTE as Query 5 */ ),
top10 AS (
  SELECT * 
  FROM spec_counts 
  ORDER BY npi_cnt DESC
  LIMIT 10
),
avg_val AS (
  SELECT AVG(npi_cnt) AS avg_npi_cnt FROM top10
)
SELECT 
  t.specialization,
  t.npi_cnt,
  ABS(t.npi_cnt - a.avg_npi_cnt) AS diff_from_avg
FROM top10 t
CROSS JOIN avg_val a
ORDER BY diff_from_avg ASC
LIMIT 1;
```

```sql
-- 8. Show all TOP-10 specializations with their counts and the computed average side-by-side
WITH spec_counts AS ( /* same CTE as Query 5 */ ),
top10 AS (
  SELECT * 
  FROM spec_counts 
  ORDER BY npi_cnt DESC
  LIMIT 10
),
avg_val AS (
  SELECT AVG(npi_cnt) AS avg_npi_cnt FROM top10
)
SELECT 
  t.specialization,
  t.npi_cnt,
  a.avg_npi_cnt,
  ABS(t.npi_cnt - a.avg_npi_cnt) AS diff_from_avg
FROM top10 t
CROSS JOIN avg_val a
ORDER BY t.npi_cnt DESC
LIMIT 20;
```

```sql
-- 9. (Optional) List all Mountain View CA providers for the specialization closest to average
WITH spec_counts AS ( /* same CTE as Query 5 */ ),
top10 AS (
  SELECT * 
  FROM spec_counts 
  ORDER BY npi_cnt DESC
  LIMIT 10
),
closest AS (
  SELECT specialization
  FROM (
    SELECT *,
           ABS(npi_cnt - (SELECT AVG(npi_cnt) FROM top10)) AS diff_from_avg
    FROM top10
  )
  ORDER BY diff_from_avg
  LIMIT 1
)
SELECT DISTINCT 
  p."npi",
  p."provider_first_name",
  p."provider_last_name_legal_name",
  c.specialization
FROM closest c
JOIN (
    /* union-all block producing npi + specialization for Mountain View CA */
    SELECT "npi", "healthcare_provider_taxonomy_1_specialization"  AS specialization,
           "provider_first_name", "provider_last_name_legal_name"
      FROM "NPPES"."NPPES"."NPI_OPTIMIZED"
      WHERE "provider_business_practice_location_address_city_name" ILIKE '%mountain%view%'
        AND "provider_business_practice_location_address_state_name" = 'CA'
    UNION ALL
    SELECT "npi", "healthcare_provider_taxonomy_2_specialization",
           "provider_first_name", "provider_last_name_legal_name"
      FROM "NPPES"."NPPES"."NPI_OPTIMIZED"
      WHERE "provider_business_practice_location_address_city_name" ILIKE '%mountain%view%'
        AND "provider_business_practice_location_address_state_name" = 'CA'
    /* repeat for cols 3-15 … */
) p
ON p.specialization = c.specialization
LIMIT 20;
```

```sql
--10. Final concise query that gives the specialization closest to the average (single step)
WITH mountain_view_specs AS (
  SELECT "npi", "healthcare_provider_taxonomy_1_specialization"  AS specialization FROM "NPPES"."NPPES"."NPI_OPTIMIZED"
    WHERE "provider_business_practice_location_address_city_name" ILIKE '%mountain%view%'
      AND "provider_business_practice_location_address_state_name" = 'CA'
  UNION ALL
  SELECT "npi", "healthcare_provider_taxonomy_2_specialization"  FROM "NPPES"."NPPES"."NPI_OPTIMIZED"
    WHERE "provider_business_practice_location_address_city_name" ILIKE '%mountain%view%'
      AND "provider_business_practice_location_address_state_name" = 'CA'
  /* repeat for cols 3-15 … */
), spec_counts AS (
  SELECT specialization, COUNT(DISTINCT npi) AS npi_cnt
  FROM mountain_view_specs
  WHERE specialization IS NOT NULL AND specialization <> ''
  GROUP BY specialization
), top10 AS (
  SELECT *
  FROM spec_counts
  ORDER BY npi_cnt DESC
  LIMIT 10
)
SELECT specialization, npi_cnt
FROM top10
ORDER BY ABS(npi_cnt - (SELECT AVG(npi_cnt) FROM top10))
LIMIT 1;
```
