/*  Count distinct NPIs for each specialization  */
spec_counts AS (
    SELECT specialization,
           COUNT(DISTINCT npi) AS npi_cnt
      FROM mountain_view_specs
     WHERE specialization IS NOT NULL
       AND specialization <> ''
     GROUP BY specialization
),

/*  Top-10 specializations by NPI count  */
top10 AS (
    SELECT *
      FROM spec_counts
     ORDER BY npi_cnt DESC NULLS LAST
     LIMIT 10
),

/*  Average of the Top-10 counts  */
avg_val AS (
    SELECT AVG(npi_cnt) AS avg_npi_cnt
      FROM top10
),

/*  Specialization whose count is closest to the Top-10 average  */
closest AS (
    SELECT specialization,
           npi_cnt,
           ABS(npi_cnt - (SELECT avg_npi_cnt FROM avg_val)) AS diff_from_avg
      FROM top10
     ORDER BY diff_from_avg
     LIMIT 1
)

/*  Final output:   – Top-10 specializations
                    – Average of their counts
                    – Which specialization is closest to that average              */
SELECT  t.specialization,
        t.npi_cnt,
        a.avg_npi_cnt,
        ABS(t.npi_cnt - a.avg_npi_cnt)      AS diff_from_avg,
        CASE WHEN t.specialization = c.specialization THEN 'Y' ELSE 'N' END 
                                               AS is_closest_to_avg
  FROM  top10  t
  CROSS JOIN avg_val  a
  LEFT  JOIN closest  c
         ON t.specialization = c.specialization
ORDER BY t.npi_cnt DESC NULLS LAST;
