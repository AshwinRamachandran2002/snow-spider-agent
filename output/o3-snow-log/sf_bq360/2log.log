      )) U
      WHERE "tax_code" IS NOT NULL
    ) N
    JOIN NPPES.NPPES.HEALTHCARE_PROVIDER_TAXONOMY_CODE_SET T
      ON N."tax_code" = T."code"
    WHERE T."specialization" IS NOT NULL
      AND TRIM(T."specialization") <> ''
    GROUP BY T."specialization"
    ORDER BY COUNT(DISTINCT N."npi") DESC
    LIMIT 10
  ), avg_cte AS (
    SELECT AVG("cnt") AS "avg_cnt" FROM spec_counts
  )
  SELECT s."specialization"
  FROM spec_counts s, avg_cte a
  ORDER BY ABS(s."cnt" - a."avg_cnt")
  LIMIT 1
)
