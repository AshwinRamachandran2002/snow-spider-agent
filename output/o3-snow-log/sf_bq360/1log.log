--Description / Thinking Process:
-- 1) CTE mv           : keep only Mountain View-CA providers plus the 15 specialization columns and NPI.
-- 2) CTE spec_counts  : UNPIVOT the 15 specialization columns → one row per (NPI, specialization);
--                       remove blank specializations, then count distinct NPIs per specialization.
--                       Order by count desc and keep the TOP-10 most common specializations.
-- 3) CTE avg_cte      : compute the average distinct-NPI count across those 10 specializations.
-- 4) Final SELECT     : compute each Top-10 specialization’s distance from that average and return
--                       the specialization(s) whose count is closest to the average.
WITH mv AS (  -------------------------------------------------------------------- 1
    SELECT
        "npi",
        "healthcare_provider_taxonomy_1_specialization",
        "healthcare_provider_taxonomy_2_specialization",
        "healthcare_provider_taxonomy_3_specialization",
        "healthcare_provider_taxonomy_4_specialization",
        "healthcare_provider_taxonomy_5_specialization",
        "healthcare_provider_taxonomy_6_specialization",
        "healthcare_provider_taxonomy_7_specialization",
        "healthcare_provider_taxonomy_8_specialization",
        "healthcare_provider_taxonomy_9_specialization",
        "healthcare_provider_taxonomy_10_specialization",
        "healthcare_provider_taxonomy_11_specialization",
        "healthcare_provider_taxonomy_12_specialization",
        "healthcare_provider_taxonomy_13_specialization",
        "healthcare_provider_taxonomy_14_specialization",
        "healthcare_provider_taxonomy_15_specialization"
    FROM "NPPES"."NPPES"."NPI_OPTIMIZED"
    WHERE "provider_business_practice_location_address_city_name" ILIKE '%MOUNTAIN%VIEW%'
      AND "provider_business_practice_location_address_state_name" = 'CA'
),
spec_counts AS (  ------------------------------------------------------------------ 2
    SELECT
        up."specialization",
        COUNT(DISTINCT mv."npi") AS "npi_cnt"
    FROM mv
    UNPIVOT (
        "specialization" FOR "tax_idx" IN (
            "healthcare_provider_taxonomy_1_specialization",
            "healthcare_provider_taxonomy_2_specialization",
            "healthcare_provider_taxonomy_3_specialization",
            "healthcare_provider_taxonomy_4_specialization",
            "healthcare_provider_taxonomy_5_specialization",
            "healthcare_provider_taxonomy_6_specialization",
            "healthcare_provider_taxonomy_7_specialization",
            "healthcare_provider_taxonomy_8_specialization",
            "healthcare_provider_taxonomy_9_specialization",
            "healthcare_provider_taxonomy_10_specialization",
            "healthcare_provider_taxonomy_11_specialization",
            "healthcare_provider_taxonomy_12_specialization",
            "healthcare_provider_taxonomy_13_specialization",
            "healthcare_provider_taxonomy_14_specialization",
            "healthcare_provider_taxonomy_15_specialization"
        )
    ) up
    WHERE NVL(TRIM(up."specialization"), '') <> ''
    GROUP BY up."specialization"
    ORDER BY "npi_cnt" DESC
    LIMIT 10
),
avg_cte AS (  ---------------------------------------------------------------------- 3
    SELECT AVG("npi_cnt") AS "avg_npi_cnt" FROM spec_counts
)
SELECT  --------------------------------------------------------------------------- 4
    sc."specialization",
    sc."npi_cnt",
    a."avg_npi_cnt",
    ABS(sc."npi_cnt" - a."avg_npi_cnt") AS "distance_from_avg"
FROM spec_counts sc
CROSS JOIN avg_cte a
QUALIFY ABS(sc."npi_cnt" - a."avg_npi_cnt") = (  -- ensure we get the closest
        SELECT MIN(ABS("npi_cnt" - "avg_npi_cnt")) FROM spec_counts, avg_cte
)
ORDER BY "distance_from_avg" ASC, sc."specialization"
LIMIT 20;
