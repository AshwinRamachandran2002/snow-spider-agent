```sql
--Description: Goal – among Mountain View (CA) providers, find the 10 most common specializations
--             (by distinct NPIs) and then pick the one whose count is closest to the average of
--             those 10 counts.  The query proceeds in four CTE steps:
--   1) mv   : unpivot the 15 *_specialization columns so each (NPI, specialization) is a row and
--            keep only Mountain View, CA records with non-blank specializations.
--   2) top10: aggregate mv to get the distinct-NPI count per specialization, order by count
--            descending, and keep the top 10.
--   3) avg  : compute the average of those 10 counts.
--   4) final: join top10 to avg, calculate each specialization’s absolute difference from the
--            average, rank by that difference, and return the specialization whose count is
--            closest to the average.
WITH mv AS (
    SELECT DISTINCT
           npi,
           spec.specialization
    FROM NPPES.NPPES.NPI_OPTIMIZED,
         LATERAL (
             SELECT "healthcare_provider_taxonomy_1_specialization"  AS specialization UNION ALL
             SELECT "healthcare_provider_taxonomy_2_specialization"  UNION ALL
             SELECT "healthcare_provider_taxonomy_3_specialization"  UNION ALL
             SELECT "healthcare_provider_taxonomy_4_specialization"  UNION ALL
             SELECT "healthcare_provider_taxonomy_5_specialization"  UNION ALL
             SELECT "healthcare_provider_taxonomy_6_specialization"  UNION ALL
             SELECT "healthcare_provider_taxonomy_7_specialization"  UNION ALL
             SELECT "healthcare_provider_taxonomy_8_specialization"  UNION ALL
             SELECT "healthcare_provider_taxonomy_9_specialization"  UNION ALL
             SELECT "healthcare_provider_taxonomy_10_specialization" UNION ALL
             SELECT "healthcare_provider_taxonomy_11_specialization" UNION ALL
             SELECT "healthcare_provider_taxonomy_12_specialization" UNION ALL
             SELECT "healthcare_provider_taxonomy_13_specialization" UNION ALL
             SELECT "healthcare_provider_taxonomy_14_specialization" UNION ALL
             SELECT "healthcare_provider_taxonomy_15_specialization"
         ) spec
    WHERE "provider_business_practice_location_address_city_name" ILIKE '%MOUNTAIN%VIEW%'
      AND "provider_business_practice_location_address_state_name" = 'CA'
      AND spec.specialization IS NOT NULL
      AND spec.specialization <> ''
), top10 AS (
    SELECT specialization,
           COUNT(DISTINCT npi) AS npi_cnt
    FROM mv
    GROUP BY specialization
    ORDER BY npi_cnt DESC
    LIMIT 10
), avg AS (
    SELECT AVG(npi_cnt) AS avg_cnt
    FROM top10
), final AS (
    SELECT t.specialization,
           t.npi_cnt,
           ABS(t.npi_cnt - a.avg_cnt) AS diff_from_avg,
           ROW_NUMBER() OVER (ORDER BY ABS(t.npi_cnt - a.avg_cnt)) AS rnk
    FROM top10 t, avg a
)
SELECT specialization,
       npi_cnt,
       diff_from_avg
FROM final
WHERE rnk = 1;
```
