--Description:  Single-query solution with inline thinking steps:
--  1) mv  : From NPI_OPTIMIZED (alias n) pick Mountain View, CA providers and
--           UNPIVOT the 15 *_specialization columns via a LATERAL sub-query (alias spec);
--           keep each (distinct NPI, specialization) pair that is non-blank.
--  2) t10 : Aggregate mv to get distinct-NPI counts per specialization, order by count
--           descending, and keep the 10 most common specializations.
--  3) avg : Calculate the average of those 10 counts.
--  4) r   : Compute each top-10 specialization’s absolute distance from the average,
--           rank them by that distance, and select the one closest to the average.
WITH mv AS (
    SELECT DISTINCT
           n."npi",
           spec.specialization
    FROM NPPES.NPPES.NPI_OPTIMIZED n,
         LATERAL (
             SELECT n."healthcare_provider_taxonomy_1_specialization"  AS specialization UNION ALL
             SELECT n."healthcare_provider_taxonomy_2_specialization"  UNION ALL
             SELECT n."healthcare_provider_taxonomy_3_specialization"  UNION ALL
             SELECT n."healthcare_provider_taxonomy_4_specialization"  UNION ALL
             SELECT n."healthcare_provider_taxonomy_5_specialization"  UNION ALL
             SELECT n."healthcare_provider_taxonomy_6_specialization"  UNION ALL
             SELECT n."healthcare_provider_taxonomy_7_specialization"  UNION ALL
             SELECT n."healthcare_provider_taxonomy_8_specialization"  UNION ALL
             SELECT n."healthcare_provider_taxonomy_9_specialization"  UNION ALL
