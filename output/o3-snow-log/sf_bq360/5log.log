--         whose count is nearest to the average of those 10 counts.
--
--  1) mv   : Filter NPI_OPTIMIZED to Mountain View (ILIKE '%MOUNTAIN%VIEW%')
--            and unpivot the 15 *_specialization columns via CROSS JOIN LATERAL,
--            yielding one row per (npi, specialization); remove blanks.
--  2) top10: Aggregate mv → COUNT(DISTINCT npi) per specialization,
--            order by count descending, keep TOP 10.
--  3) avg   : Calculate the average of the 10 counts.
--  4) ranked: For each top-10 specialization, compute |count − average|;
--            rank by this distance.
--  5) final : Return the specialization whose count is closest to the average.
WITH mv AS (
    SELECT DISTINCT
           n."npi",
           spec.specialization
    FROM NPPES.NPPES.NPI_OPTIMIZED AS n
    CROSS JOIN LATERAL (
        SELECT n."healthcare_provider_taxonomy_1_specialization"  AS specialization UNION ALL
        SELECT n."healthcare_provider_taxonomy_2_specialization"  UNION ALL
        SELECT n."healthcare_provider_taxonomy_3_specialization"  UNION ALL
        SELECT n."healthcare_provider_taxonomy_4_specialization"  UNION ALL
        SELECT n."healthcare_provider_taxonomy_5_specialization"  UNION ALL
        SELECT n."healthcare_provider_taxonomy_6_specialization"  UNION ALL
        SELECT n."healthcare_provider_taxonomy_7_specialization"  UNION ALL
        SELECT n."healthcare_provider_taxonomy_8_specialization"  UNION ALL
        SELECT n."healthcare_provider_taxonomy_9_specialization"  UNION ALL
        SELECT n."healthcare_provider_taxonomy_10_specialization" UNION ALL
        SELECT n."healthcare_provider_taxonomy_11_specialization" UNION ALL
        SELECT n."healthcare_provider_taxonomy_12_specialization" UNION ALL
        SELECT n."healthcare_provider_taxonomy_13_specialization" UNION ALL
        SELECT n."healthcare_provider_taxonomy_14_specialization" UNION ALL
        SELECT n."healthcare_provider_taxonomy_15_specialization"
    ) AS spec
    WHERE n."provider_business_practice_location_address_city_name" ILIKE '%MOUNTAIN%VIEW%'
      AND n."provider_business_practice_location_address_state_name" = 'CA'
      AND spec.specialization IS NOT NULL
      AND spec.specialization <> ''
), top10 AS (
    SELECT
        specialization,
        COUNT(DISTINCT npi) AS npi_cnt
    FROM mv
    GROUP BY specialization
    ORDER BY npi_cnt DESC
    LIMIT 10
), avg_cte AS (
    SELECT AVG(npi_cnt) AS avg_cnt
    FROM top10
), ranked AS (
    SELECT
        t.specialization,
        t.npi_cnt,
        ABS(t.npi_cnt - a.avg_cnt) AS diff_from_avg,
        ROW_NUMBER() OVER (ORDER BY ABS(t.npi_cnt - a.avg_cnt)) AS rnk
    FROM top10 t
    CROSS JOIN avg_cte a
)
SELECT specialization,
       npi_cnt,
       diff_from_avg
FROM ranked
WHERE rnk = 1;
```
