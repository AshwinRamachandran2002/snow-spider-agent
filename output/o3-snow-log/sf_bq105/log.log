```sql
--Description:  To calculate “accidents per 100,000 people” we must first learn the
--              exact column name that stores 2010 Census population in the
--              reference table NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA.
--              Snowflake’s OBJECT_CONSTRUCT(*) converts an entire row into a
--              VARIANT object; OBJECT_KEYS() then returns the list of all column
--              names inside that object.  Selecting one row (LIMIT 1) gives us
--              every column header in the table so we can spot the population
--              field (e.g., POPULATION_2010, POP_2010, etc.).
SELECT ARRAY_TO_STRING(
           OBJECT_KEYS(OBJECT_CONSTRUCT(*)), 
           ', '
       ) AS "all_column_names"
FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
LIMIT  1;
```
