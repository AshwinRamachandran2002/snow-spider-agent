```sql
--Description: 10) Combine 2015 & 2016 (after mapping 2015 numbers to state names) 
--               to see both years’ distracted-crash counts side-by-side
WITH yr16 AS (
    SELECT  "state_name",
            COUNT(*) AS "cnt_2016"
    FROM    NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016
    WHERE   "driver_distracted_by_name" NOT IN ('Not Distracted',
                                                'Unknown if Distracted',
                                                'Not Reported')
    GROUP BY "state_name"
),
yr15 AS (
    SELECT  a."state_name",
            COUNT(*) AS "cnt_2015"
    FROM    NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d15
    JOIN    NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA            a
           ON LPAD(d15."state_number"::TEXT, 2, '0') = a."state_fips_code"
    WHERE   d15."driver_distracted_by_name" NOT IN ('Not Distracted',
                                                    'Unknown if Distracted',
                                                    'Not Reported')
    GROUP BY a."state_name"
)
SELECT COALESCE(yr16."state_name", yr15."state_name") AS "state_name",
       yr15."cnt_2015",
       yr16."cnt_2016"
FROM   yr15
FULL OUTER JOIN yr16
       ON yr15."state_name" = yr16."state_name"
ORDER BY COALESCE(yr16."cnt_2016",0) DESC, COALESCE(yr15."cnt_2015",0) DESC
LIMIT  20;
```
