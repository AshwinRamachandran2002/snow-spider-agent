    WHERE d."driver_distracted_by_name" NOT IN
          ('Not Distracted','Unknown if Distracted','Not Reported')
    GROUP BY a."state_name"
),

/* 2016: crashes involving driver distraction */
distract_2016 AS (
    SELECT
        "state_name" ,
        COUNT(*) AS crashes_2016
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016
    WHERE "driver_distracted_by_name" NOT IN
          ('Not Distracted','Unknown if Distracted','Not Reported')
    GROUP BY "state_name"
),

/* combine population with crash counts */
combined AS (
    SELECT
        p."state_name" ,
