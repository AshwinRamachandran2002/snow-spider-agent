```sql
/*  --------------------------------------------------------------
    Driver-distraction crash rates (per 100,000 population, 2010 base)
    – build the pieces, rank each year, return the 5 highest states
    -------------------------------------------------------------- */
WITH population AS (      -- 2010 Census population by state
    SELECT
        "state_fips_code"                      AS state_fips,
        "state_name",
        TO_NUMBER("population_2010")           AS pop_2010
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
    WHERE "population_2010" IS NOT NULL
),

/* 2015 – count distraction-related fatal crashes, matched to state via FIPS */
distract_2015 AS (
    SELECT
        a."state_name",
        COUNT(*)            AS crashes_2015
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015  d
    JOIN NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA               a
        ON a."state_fips_code" = LPAD(d."state_number"::TEXT, 2, '0')
    WHERE d."driver_distracted_by_name" NOT IN
          ('Not Distracted', 'Unknown if Distracted', 'Not Reported')
    GROUP BY a."state_name"
),

/* 2016 – count distraction-related fatal crashes (state already in table) */
distract_2016 AS (
    SELECT
        "state_name",
        COUNT(*)            AS crashes_2016
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016
    WHERE "driver_distracted_by_name" NOT IN
          ('Not Distracted', 'Unknown if Distracted', 'Not Reported')
    GROUP BY "state_name"
),

/* bring crash counts and population together */
calc AS (
    SELECT
        p."state_name",
        p.pop_2010,
        COALESCE(d15.crashes_2015, 0) AS crashes_2015,
        COALESCE(d16.crashes_2016, 0) AS crashes_2016
    FROM population        p
    LEFT JOIN distract_2015 d15 ON d15."state_name" = p."state_name"
    LEFT JOIN distract_2016 d16 ON d16."state_name" = p."state_name"
),

/* create one row per (year,state) with rate per 100k */
combined AS (
    SELECT
        '2015'                                     AS year,
        "state_name",
        ROUND(crashes_2015 * 100000.0 / pop_2010,4) AS accidents_per_100k
    FROM calc
    UNION ALL
    SELECT
        '2016',
        "state_name",
        ROUND(crashes_2016 * 100000.0 / pop_2010,4)
    FROM calc
),

/* rank by year, pick top 5 states each year */
ranked AS (
    SELECT
        year,
        state_name,
        accidents_per_100k,
        ROW_NUMBER() OVER (PARTITION BY year
                           ORDER BY accidents_per_100k DESC NULLS LAST) AS rn
    FROM combined
)

SELECT
    year,
    state_name,
    accidents_per_100k
FROM ranked
WHERE rn <= 5
ORDER BY year,
         accidents_per_100k DESC NULLS LAST;
```
