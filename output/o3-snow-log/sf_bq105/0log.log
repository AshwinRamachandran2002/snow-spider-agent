--Description:
--  We need to answer: “Which five states in 2015 and 2016 had the highest number of
--  distraction-related traffic crashes per 100 000 residents (2010 Census population),
--  excluding cases where the driver was listed as ‘Not Distracted’, ‘Unknown if Distracted’,
--  or ‘Not Reported’?”  One query accomplishes everything:
--
--  • crash16  – count valid distraction crashes in 2016 (state name already present).
--  • crash15  – count valid distraction crashes in 2015 (convert numeric FIPS in DISTRACT_2015
--               to two-digit text and join to US_STATES_AREA to get state name).
--  • crashes  – UNION ALL those yearly counts.
--  • rates    – join counts to 2010 population, compute crashes-per-100 000.
--  • ranked   – rank states within each year by that rate (highest first).
--  • Final SELECT – keep only the top-five states per year and display the results.
WITH crash16 AS (  /* 2016 distraction-related crashes by state */
    SELECT
        d."state_name",
        COUNT(*) AS "crashes",
        2016     AS "year"
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016 d
    WHERE d."driver_distracted_by_name" NOT IN
          ('Not Distracted', 'Unknown if Distracted', 'Not Reported')
    GROUP BY d."state_name"
),
crash15 AS (  /* 2015 distraction-related crashes by state (need FIPS → name) */
    SELECT
        s."state_name",
        COUNT(*) AS "crashes",
        2015     AS "year"
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d
    JOIN NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA s
         ON s."state_fips_code" = LPAD(d."state_number"::TEXT, 2, '0')
    WHERE d."driver_distracted_by_name" NOT IN
          ('Not Distracted', 'Unknown if Distracted', 'Not Reported')
    GROUP BY s."state_name"
),
crashes AS (  /* combine counts from both years */
    SELECT * FROM crash16
    UNION ALL
    SELECT * FROM crash15
),
rates AS (    /* attach population and calculate crash rate */
    SELECT
        c."year",
        c."state_name",
        c."crashes",
        u."population_2010",
        ROUND(c."crashes" / (u."population_2010" / 100000.0), 2) AS "crashes_per_100k"
    FROM crashes c
    JOIN NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA u
         ON u."state_name" = c."state_name"
    WHERE u."population_2010" IS NOT NULL
),
ranked AS (   /* rank states by crash rate within each year */
    SELECT
        r.*,
        ROW_NUMBER() OVER (PARTITION BY r."year"
                           ORDER BY r."crashes_per_100k" DESC) AS "rk"
    FROM rates r
)
SELECT
    "year",
    "state_name",
    "crashes"           AS "distraction_crashes",
    "population_2010",
    "crashes_per_100k"
FROM ranked
WHERE rk <= 5
ORDER BY "year" DESC, "crashes_per_100k" DESC;
