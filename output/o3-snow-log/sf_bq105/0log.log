```sql
--Description: 
-- Goal:  For BOTH 2015 and 2016, calculate each state’s distraction-related crash rate
--         (crashes per 100,000 residents, 2010 census population), then list the
--         five states with the highest rate in each year.
--
-- Logic
--   1.  Gather crash counts for 2016 directly from DISTRACT_2016
--       (filtering out “Not Distracted”, “Unknown if Distracted”, “Not Reported”).
--   2.  Gather crash counts for 2015 from DISTRACT_2015, converting the numeric
--       state FIPS (“state_number”) to two-digit text and joining to the state/
--       population table (US_STATES_AREA) to obtain the state name.
--   3.  UNION the two yearly result sets into one CTE (crash_counts).
--   4.  Join crash_counts to US_STATES_AREA again to fetch 2010 population,
--       then compute crashes_per_100k.
--   5.  Use ROW_NUMBER() partitioned by year to rank the states by rate and
--       keep only the top five for each year.
--
WITH crash_counts AS (          -- step 1 & 2
    /* 2016 */
    SELECT
        2016             AS "year",
        d."state_name"   AS "state_name",
        COUNT(*)         AS "crash_total"
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016 d
    WHERE d."driver_distracted_by_name"
          NOT IN ('Not Distracted', 'Unknown if Distracted', 'Not Reported')
    GROUP BY d."state_name"

    UNION ALL

    /* 2015 */
    SELECT
        2015                                         AS "year",
        s."state_name"                               AS "state_name",
        COUNT(*)                                     AS "crash_total"
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d
    JOIN NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA s
         ON s."state_fips_code" = LPAD(d."state_number"::TEXT, 2, '0')
    WHERE d."driver_distracted_by_name"
          NOT IN ('Not Distracted', 'Unknown if Distracted', 'Not Reported')
    GROUP BY s."state_name"
),
rates AS (                    -- step 3 & 4
    SELECT
        c."year",
        c."state_name",
        c."crash_total",
        u."population_2010",
        ROUND(c."crash_total" / (u."population_2010" / 100000.0), 2) 
            AS "crashes_per_100k"
    FROM crash_counts c
    JOIN NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA u
         ON u."state_name" = c."state_name"
    WHERE u."population_2010" IS NOT NULL
),
ranked AS (                   -- step 5
    SELECT
        r.*,
        ROW_NUMBER() OVER (PARTITION BY r."year" 
                           ORDER BY r."crashes_per_100k" DESC) AS rk
    FROM rates r
)
SELECT
    "year",
    "state_name",
    "crash_total"          AS "distraction_crashes",
    "population_2010",
    "crashes_per_100k"
FROM ranked
WHERE rk <= 5
ORDER BY "year" DESC, "crashes_per_100k" DESC;
```
