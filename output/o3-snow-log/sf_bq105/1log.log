--              3) Count qualifying crashes per state, convert that count to a per-capita rate:
--                     (accidents / population) * 100 000.
--              4) UNION the two years together, rank states within each year by the rate, and
--                 return the top-five states for each year.
WITH
/* ---- 2016 distracted-driver fatal crashes ---- */
cnt16 AS (
    SELECT
        u."state_name",
