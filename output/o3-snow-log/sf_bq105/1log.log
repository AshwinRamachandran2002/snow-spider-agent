```sql
--Description:  One-stop query that (1) counts 2015 and 2016 fatal-crash records where the
--              driver *was* distracted (i.e., “driver_distracted_by_name” is **not**
--              ‘Not Distracted’, ‘Unknown if Distracted’, or ‘Not Reported’);
--              (2) joins to the state reference / 2010-population table
--              NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
--              (assumes this table contains a column named “population_2010”);
--              (3) converts raw counts to rates per 100,000 residents;
--              (4) ranks states inside each year by that rate and returns the
--              top five for 2015 and for 2016.
WITH
/* 2016 – distracted-driver crashes per state */
c2016 AS (
    SELECT
        u."state_name",
        COUNT(*)                    AS "accidents",
        u."population_2010",
        '2016'                      AS "year"
    FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016 d
    JOIN   NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA u
           ON d."state_name" = u."state_name"
    WHERE  d."driver_distracted_by_name" NOT ILIKE '%Not Distracted%'
      AND  d."driver_distracted_by_name" NOT ILIKE '%Unknown if Distracted%'
      AND  d."driver_distracted_by_name" NOT ILIKE '%Not Reported%'
    GROUP BY u."state_name", u."population_2010"
),
/* 2015 – distracted-driver crashes per state (link via FIPS code) */
c2015 AS (
    SELECT
        u."state_name",
        COUNT(*)                    AS "accidents",
        u."population_2010",
        '2015'                      AS "year"
    FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d
    JOIN   NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA u
           ON LPAD(TO_VARCHAR(d."state_number"),2,'0') = u."state_fips_code"
    WHERE  d."driver_distracted_by_name" NOT ILIKE '%Not Distracted%'
      AND  d."driver_distracted_by_name" NOT ILIKE '%Unknown if Distracted%'
      AND  d."driver_distracted_by_name" NOT ILIKE '%Not Reported%'
    GROUP BY u."state_name", u."population_2010"
),
unioned AS (
    SELECT "state_name",
           "year",
           "accidents",
           ("accidents" * 100000.0) / "population_2010"  AS "accidents_per_100k"
    FROM c2015
    UNION ALL
    SELECT "state_name",
           "year",
           "accidents",
           ("accidents" * 100000.0) / "population_2010"
    FROM c2016
),
ranked AS (
    SELECT
        *,
        RANK() OVER (PARTITION BY "year"
                     ORDER BY "accidents_per_100k" DESC) AS "rank_in_year"
    FROM unioned
)
SELECT
    "year",
    "state_name",
    "accidents"       AS "distraction_accidents",
    ROUND("accidents_per_100k", 2) AS "accidents_per_100k"
FROM ranked
WHERE "rank_in_year" <= 5
ORDER BY "year", "rank_in_year";
```
