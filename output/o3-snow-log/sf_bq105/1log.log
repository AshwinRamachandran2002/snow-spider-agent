```sql
--Description:  One self-contained query that delivers, for BOTH 2015 and 2016, the five states
--              with the highest rate of distraction-related fatal crashes per 100,000 residents.
--              Steps performed inside the CTE chain:
--              ①  Pull 2016 records from DISTRACT_2016 and 2015 records from DISTRACT_2015, keeping
--                 only rows where the driver WAS distracted (i.e. “driver_distracted_by_name” is
--                 NOT ‘Not Distracted’, ‘Unknown if Distracted’, or ‘Not Reported’).
--              ②  Join each year’s rows to the reference table
--                 NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
--                 (assumed to hold 2010 population in column “population_2010”).
--                 • 2016 joins on state_name.
--                 • 2015 joins on two-digit FIPS code.
--              ③  Count crashes per state, compute a rate: (count / population_2010) * 100 000.
--              ④  UNION the two years, then RANK() states within each year by that rate.
--              ⑤  Return the top 5 states for each year.
WITH
/* ---------- 2016 distracted-driver fatal crashes ---------- */
c2016 AS (
    SELECT
        u."state_name",
        COUNT(*)                              AS accidents,
        u."population_2010"                   AS pop_2010,
        '2016'                                AS yr
    FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016 d
    JOIN   NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA         u
           ON d."state_name" = u."state_name"
    WHERE  d."driver_distracted_by_name" NOT ILIKE '%Not Distracted%'
       AND d."driver_distracted_by_name" NOT ILIKE '%Unknown if Distracted%'
       AND d."driver_distracted_by_name" NOT ILIKE '%Not Reported%'
    GROUP BY u."state_name", u."population_2010"
),
/* ---------- 2015 distracted-driver fatal crashes ---------- */
c2015 AS (
    SELECT
        u."state_name",
        COUNT(*)                              AS accidents,
        u."population_2010"                   AS pop_2010,
        '2015'                                AS yr
    FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d
    JOIN   NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA         u
           ON LPAD(TO_VARCHAR(d."state_number"), 2, '0') = u."state_fips_code"
    WHERE  d."driver_distracted_by_name" NOT ILIKE '%Not Distracted%'
       AND d."driver_distracted_by_name" NOT ILIKE '%Unknown if Distracted%'
       AND d."driver_distracted_by_name" NOT ILIKE '%Not Reported%'
    GROUP BY u."state_name", u."population_2010"
),
/* ---------- merge & compute per-capita rate ---------- */
both_years AS (
    SELECT
        "state_name",
        yr,
        accidents,
        (accidents * 100000.0) / pop_2010     AS accidents_per_100k
    FROM c2015
    UNION ALL
    SELECT
        "state_name",
        yr,
        accidents,
        (accidents * 100000.0) / pop_2010
    FROM c2016
),
/* ---------- rank states within each year ---------- */
ranked AS (
    SELECT
        *,
        RANK() OVER (PARTITION BY yr ORDER BY accidents_per_100k DESC) AS rnk
    FROM both_years
)
/* ---------- final result: five highest-rate states each year ---------- */
SELECT
    yr                                        AS "year",
    "state_name",
    accidents                                 AS "distraction_accidents",
    ROUND(accidents_per_100k, 2)              AS "accidents_per_100k"
FROM ranked
WHERE rnk <= 5
ORDER BY "year", rnk;
```
