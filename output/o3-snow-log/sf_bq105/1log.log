/*  Driver-distraction traffic accidents per 100,000 residents
    (based on 2010 Census population) – five highest-rate states
    for the years 2015 and 2016.  */

WITH population AS (               /* 2010 Census population by state */
    SELECT
        state_name,
        census_2010_population      AS pop_2010
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
    WHERE census_2010_population IS NOT NULL
),

/* 2016 – accidents involving a distracted driver */
accidents_2016 AS (
    SELECT
        d.state_name,
        COUNT(*)                       AS accident_cnt
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016 d
    WHERE d.driver_distracted_by_name NOT ILIKE '%Not Distracted%'
      AND d.driver_distracted_by_name NOT ILIKE '%Unknown if Distracted%'
      AND d.driver_distracted_by_name NOT ILIKE '%Not Reported%'
    GROUP BY d.state_name
),

/* 2015 – accidents involving a distracted driver */
accidents_2015 AS (
    SELECT
        u.state_name,
        COUNT(*)                       AS accident_cnt
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d
    JOIN NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA u
          ON LPAD(TO_VARCHAR(d.state_number),2,'0') = u.state_fips_code
    WHERE d.driver_distracted_by_name NOT ILIKE '%Not Distracted%'
      AND d.driver_distracted_by_name NOT ILIKE '%Unknown if Distracted%'
      AND d.driver_distracted_by_name NOT ILIKE '%Not Reported%'
    GROUP BY u.state_name
),

/* Combine the two years */
yearly_accidents AS (
    SELECT 2016 AS year, state_name, accident_cnt FROM accidents_2016
    UNION ALL
    SELECT 2015 AS year, state_name, accident_cnt FROM accidents_2015
),

/* Compute accidents per 100,000 residents */
rates AS (
    SELECT
        y.year,
        y.state_name,
        y.accident_cnt,
        p.pop_2010,
        (y.accident_cnt / p.pop_2010) * 100000 AS accidents_per_100k
    FROM yearly_accidents y
    JOIN population p
          ON y.state_name = p.state_name
),

/* Rank states within each year */
ranked AS (
    SELECT
        r.*,
        ROW_NUMBER() OVER (PARTITION BY r.year
                           ORDER BY r.accidents_per_100k DESC NULLS LAST) AS year_rank
    FROM rates r
)

/* Final output – top-5 states per year */
SELECT
    year,
    state_name,
    ROUND(accidents_per_100k, 4) AS accidents_per_100k,
    year_rank
FROM ranked
WHERE year_rank <= 5
ORDER BY year, year_rank;
