```sql
--Description:  In one statement, calculate for each state the 2015 and 2016 counts of fatal-crash
--              records where the driver WAS distracted (i.e., “driver_distracted_by_name” is
--              NOT ‘Not Distracted’, ‘Unknown if Distracted’, or ‘Not Reported’).  Join those
--              counts to the 2010 Census population held in the table
--              NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA (column “population”),
--              convert the counts to a rate per 100,000 residents, rank states within each year
--              by this rate, and return the five highest-rate states for 2015 and for 2016.
WITH
/* ---------- 2016 ---------- */
c2016 AS (
    SELECT
        u."state_name",
        COUNT(*)                       AS accidents,
        u."population"                 AS pop_2010,
        '2016'                         AS yr
    FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016 d
    JOIN   NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA       u
           ON d."state_name" = u."state_name"
    WHERE  d."driver_distracted_by_name" NOT ILIKE '%Not Distracted%'
       AND d."driver_distracted_by_name" NOT ILIKE '%Unknown if Distracted%'
       AND d."driver_distracted_by_name" NOT ILIKE '%Not Reported%'
    GROUP BY u."state_name", u."population"
),
/* ---------- 2015 ---------- */
c2015 AS (
    SELECT
        u."state_name",
        COUNT(*)                       AS accidents,
        u."population"                 AS pop_2010,
        '2015'                         AS yr
    FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d
    JOIN   NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA       u
           ON LPAD(TO_VARCHAR(d."state_number"),2,'0') = u."state_fips_code"
    WHERE  d."driver_distracted_by_name" NOT ILIKE '%Not Distracted%'
       AND d."driver_distracted_by_name" NOT ILIKE '%Unknown if Distracted%'
       AND d."driver_distracted_by_name" NOT ILIKE '%Not Reported%'
    GROUP BY u."state_name", u."population"
),
/* ---------- combine and compute rate ---------- */
all_years AS (
    SELECT
        "state_name",
        yr,
        accidents,
        (accidents * 100000.0) / pop_2010 AS accidents_per_100k
    FROM c2015
    UNION ALL
    SELECT
        "state_name",
        yr,
        accidents,
        (accidents * 100000.0) / pop_2010
    FROM c2016
),
ranked AS (
    SELECT
        *,
        RANK() OVER (PARTITION BY yr ORDER BY accidents_per_100k DESC) AS rnk
    FROM all_years
)
SELECT
    yr                                AS year,
    "state_name",
    accidents                         AS distraction_accidents,
    ROUND(accidents_per_100k, 2)      AS accidents_per_100k
FROM ranked
WHERE immense rnk <= 5  -- keep top 5 per year
ORDER BY year, rnk;
```
