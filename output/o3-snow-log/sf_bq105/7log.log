```sql
--Description:  Produce one result set that shows, for each of the two years (2015 and 2016),
--              the five states with the largest number of fatal crashes in which the driver
--              WAS distracted.  Steps inside CTEs:
--                • c2016 – count 2016 distracted-driver crashes per state.
--                • c2015 – count 2015 distracted-driver crashes per state (state_number
--                           is converted to a name via US_STATES_AREA).
--                • all_years – stack the two yearly tables with UNION ALL.
--                • ranked – rank states within each year by crash count.
--              The final SELECT returns only the top-5 states per year.
WITH c2016 AS (
    SELECT
        "state_name",
        2016 AS yr,
        COUNT(*) AS crashes
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016
    WHERE "driver_distracted_by_name" NOT ILIKE '%Not%Distracted%'
      AND "driver_distracted_by_name" NOT ILIKE '%Unknown%Distracted%'
      AND "driver_distracted_by_name" NOT ILIKE '%Not%Reported%'
    GROUP BY "state_name"
),
c2015 AS (
    SELECT
        s."state_name",
        2015 AS yr,
        COUNT(*) AS crashes
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d
    JOIN NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA s
      ON TO_NUMBER(s."state_fips_code") = d."state_number"
    WHERE d."driver_distracted_by_name" NOT ILIKE '%Not%Distracted%'
      AND d."driver_distracted_by_name" NOT ILIKE '%Unknown%Distracted%'
      AND d."driver_distracted_by_name" NOT ILIKE '%Not%Reported%'
    GROUP BY s."state_name"
),
all_years AS (
    SELECT * FROM c2016
    UNION ALL
    SELECT * FROM c2015
),
ranked AS (
    SELECT
        yr,
        "state_name",
        crashes,
        RANK() OVER (PARTITION BY yr ORDER BY crashes DESC) AS rnk
    FROM all_years
)
SELECT
    yr               AS "year",
    "state_name",
    crashes          AS "distracted_crash_count",
    rnk              AS "state_rank"
FROM ranked
WHERE rnk <= 5
ORDER BY yr, rnk;
```
