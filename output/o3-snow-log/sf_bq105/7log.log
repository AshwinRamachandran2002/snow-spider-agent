```sql
--Description: One‐shot query to find the five states with the highest distracted-driver crash
--             rates (per 100 000 residents) in BOTH 2015 and 2016.   
-- Thinking process inside:  
--   1) population CTE pulls 2010 Census population (“POPULATION_2010”) from the reference table.  
--   2) crashes_2016 CTE counts 2016 records whose distraction field is NOT “Not Distracted”,  
--      “Unknown if Distracted”, or “Not Reported”.  
--   3) rates_2016 joins 2016 counts to population and converts to a per-100k rate.  
--   4) crashes_2015 CTE does the same for 2015, first mapping the numeric “state_number”  
--      to a readable name via the same reference table.  
--   5) rates_2015 repeats the population join / rate calc for 2015.  
--   6) combined UNIONs the two years.  
--   7) Final SELECT ranks states inside each year (window RANK) and keeps only the top-5.  
WITH population AS (
    SELECT "state_name", "POPULATION_2010"
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
),
crashes_2016 AS (
    SELECT
        "state_name",
        COUNT(*) AS crashes
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016
    WHERE "driver_distracted_by_name" NOT ILIKE '%Not%Distracted%'
      AND "driver_distracted_by_name" NOT ILIKE '%Unknown%Distracted%'
      AND "driver_distracted_by_name" NOT ILIKE '%Not%Reported%'
    GROUP BY "state_name"
),
rates_2016 AS (
    SELECT
        c."state_name",
        2016 AS yr,
        ROUND(c.crashes * 100000.0 / p."POPULATION_2010", 2) AS rate_per_100k
    FROM crashes_2016 c
    JOIN population p ON c."state_name" = p."state_name"
),
crashes_2015 AS (
    SELECT
        usa."state_name",
        COUNT(*) AS crashes
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d
    JOIN NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA usa
      ON TO_NUMBER(usa."state_fips_code") = d."state_number"
    WHERE d."driver_distracted_by_name" NOT ILIKE '%Not%Distracted%'
      AND d."driver_distracted_by_name" NOT ILIKE '%Unknown%Distracted%'
      AND d."driver_distracted_by_name" NOT ILIKE '%Not%Reported%'
    GROUP BY usa."state_name"
),
rates_2015 AS (
    SELECT
        c."state_name",
        2015 AS yr,
        ROUND(c.crashes * 100000.0 / p."POPULATION_2010", 2) AS rate_per_100k
    FROM crashes_2015 c
    JOIN population p ON c."state_name" = p."state_name"
),
combined AS (
    SELECT * FROM rates_2016
    UNION ALL
    SELECT * FROM rates_2015
)
SELECT
    yr AS "year",
    "state_name",
    rate_per_100k AS "accidents_per_100k",
    RANK() OVER (PARTITION BY yr ORDER BY rate_per_100k DESC) AS "state_rank"
FROM combined
QUALIFY "state_rank" <= 5
ORDER BY yr, "state_rank";
```
