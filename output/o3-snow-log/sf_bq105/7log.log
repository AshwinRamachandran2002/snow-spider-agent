```sql
/* ---------------------------------------------------------------
   Driver-distraction fatal-crash RATES (per 100,000 inhabitants)
   – all states for 2015 and 2016 – plus a yearly top-5 list.
   --------------------------------------------------------------- */

WITH population AS (      -- 2010 Census population by state
    SELECT
        TO_NUMBER("state_fips_code")              AS "state_fips",
        "state_name",
        TO_NUMBER("population_2010")              AS "pop_2010"
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
    WHERE "population_2010" IS NOT NULL
),

/* --------------  2016 distraction crashes  -------------------- */
crash_2016 AS (
    SELECT
        d16."state_name",
        COUNT(*)                                  AS "crash_cnt"
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016 d16
    WHERE d16."driver_distracted_by_name" NOT ILIKE '%Not%Distracted%'
      AND d16."driver_distracted_by_name" NOT ILIKE '%Unknown%Distracted%'
      AND d16."driver_distracted_by_name" NOT ILIKE '%Not%Reported%'
    GROUP BY d16."state_name"
),

/* --------------  2015 distraction crashes  -------------------- */
crash_2015 AS (
    SELECT
        p."state_name",
        COUNT(*)                                  AS "crash_cnt"
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d15
    JOIN population              p
          ON p."state_fips" = d15."state_number"
    WHERE d15."driver_distracted_by_name" NOT ILIKE '%Not%Distracted%'
      AND d15."driver_distracted_by_name" NOT ILIKE '%Unknown%Distracted%'
      AND d15."driver_distracted_by_name" NOT ILIKE '%Not%Reported%'
    GROUP BY p."state_name"
),

/* --------------  crash-rate calculations  --------------------- */
rates AS (
    SELECT
        p."state_name",
        2016                                    AS "year",
        c16."crash_cnt",
        p."pop_2010",
        ROUND( (c16."crash_cnt" / p."pop_2010") * 100000 , 4)  AS "crash_rate_per_100k"
    FROM crash_2016 c16
    JOIN population p  USING ("state_name")

    UNION ALL

    SELECT
        p."state_name",
        2015                                    AS "year",
        c15."crash_cnt",
        p."pop_2010",
        ROUND( (c15."crash_cnt" / p."pop_2010") * 100000 , 4)  AS "crash_rate_per_100k"
    FROM crash_2015 c15
    JOIN population p  USING ("state_name")
),

/* --------------  rank states within each year  ---------------- */
ranked AS (
    SELECT
        r.*,
        DENSE_RANK() OVER (PARTITION BY "year"
                           ORDER BY "crash_rate_per_100k" DESC NULLS LAST) AS "year_rank"
    FROM rates r
)

/* --------------------  final result  -------------------------- */
SELECT
    "state_name",
    "year",
    "crash_rate_per_100k",
    "year_rank"
FROM ranked
ORDER BY "year" , "year_rank" , "state_name";
```
