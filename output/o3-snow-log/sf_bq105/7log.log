```sql
--Description:  Count 2015 and 2016 fatal crashes in which the driver **was** distracted,  
--              join those counts to the 2010-Census population stored in  
--              UTILITY_US.US_STATES_AREA (column POPULATION_2010), convert to a rate  
--              per 100 000 residents, then keep only the five states with the highest  
--              rates in each year.  
--              Steps inside CTEs:  
--                • pop   : pull 2010 population for every state.  
--                • d16_cnt : 2016 distracted-crash counts (excludes “Not Distracted”,  
--                            “Unknown if Distracted”, “Not Reported”).  
--                • d15_cnt : same for 2015, first mapping numeric state_number to a  
--                            name via the same states table.  
--                • rates   : union both years, compute rate = crashes ÷ population × 100 000.  
--                • final   : rank states within each year and keep the top-5.  
WITH pop AS (
    SELECT "state_name", POPULATION_2010
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
),
d16_cnt AS (
    SELECT
        "state_name",
        COUNT(*) AS crashes,
        2016   AS yr
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016
    WHERE "driver_distracted_by_name" NOT ILIKE '%Not%Distracted%'
      AND "driver_distracted_by_name" NOT ILIKE '%Unknown%Distracted%'
      AND "driver_distracted_by_name" NOT ILIKE '%Not%Reported%'
    GROUP BY "state_name"
),
d15_cnt AS (
    SELECT
        usa."state_name",
        COUNT(*) AS crashes,
        2015   AS yr
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d
    JOIN NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA usa
        ON TO_NUMBER(usa."state_fips_code") = d."state_number"
    WHERE d."driver_distracted_by_name" NOT ILIKE '%Not%Distracted%'
      AND d."driver_distracted_by_name" NOT ILIKE '%Unknown%Distracted%'
      AND d."driver_distracted_by_name" NOT ILIKE '%Not%Reported%'
    GROUP BY usa."state_name"
),
rates AS (
    SELECT
        c."state_name",
        c.yr,
        c.crashes,
        p.POPULATION_2010,
        ROUND(c.crashes * 100000.0 / p.POPULATION_2010, 2) AS rate_per_100k
    FROM (SELECT * FROM d16_cnt UNION ALL SELECT * FROM d15_cnt) c
    JOIN pop p ON c."state_name" = p."state_name"
),
final AS (
    SELECT
        yr AS "year",
        "state_name",
        crashes,
        rate_per_100k,
        RANK() OVER (PARTITION BY yr ORDER BY rate_per_100k DESC) AS rnk
    FROM rates
)
SELECT *
FROM final
WHERE rnk <= 5
ORDER BY "year", rnk;
```
