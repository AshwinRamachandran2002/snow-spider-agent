--Description: Five states with the highest NUMBER (not rate) of 2015 fatal crashes in which the
--             driver was distracted.  We exclude records whose distraction status is “Not
--             Distracted”, “Unknown if Distracted”, or “Not Reported,” convert the numeric
--             state_number to a state name via US_STATES_AREA, count crashes per state, and
--             return the top-5 by count.
SELECT
    s."state_name",
    COUNT(*) AS "distracted_crashes_2015"
FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d
JOIN NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA s
      ON TO_NUMBER(s."state_fips_code") = d."state_number"
WHERE d."driver_distracted_by_name" NOT ILIKE '%Not%Distracted%'
  AND d."driver_distracted_by_name" NOT ILIKE '%Unknown%Distracted%'
  AND d."driver_distracted_by_name" NOT ILIKE '%Not%Reported%'
GROUP BY s."state_name"
ORDER BY "distracted_crashes_2015" DESC
LIMIT 5
