        p.state_name,
        2015                       AS year,
        (c.crash_cnt_2015 * 100000.0) / p.population_2010
                                   AS accidents_per_100k
    FROM crashes_2015 c
    JOIN population_2010 p
      ON p.state_fips_code = c.state_fips_code
),

/* ---------- combine & rank ------------------------------------*/
all_rates AS (
    SELECT * FROM rate_2015
    UNION ALL
    SELECT * FROM rate_2016
),
ranked AS (
    SELECT
        year,
        state_name,
        ROUND(accidents_per_100k,4) AS accidents_per_100k,
        DENSE_RANK() OVER (PARTITION BY year
                           ORDER BY accidents_per_100k DESC) AS rate_rank
    FROM all_rates
)

/* ---------- top-5 each year -----------------------------------*/
SELECT
    year,
    state_name,
    accidents_per_100k,
    rate_rank
FROM ranked
WHERE rate_rank <= 5
ORDER BY year, rate_rank NULLS LAST;
