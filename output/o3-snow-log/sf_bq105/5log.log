            WHERE  "driver_distracted_by_name" NOT IN ('Not Distracted',
                                                       'Unknown if Distracted',
                                                       'Not Reported')
            GROUP  BY "state_name"
          ) d16
    JOIN  NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA usa
          ON usa."state_name" = d16."state_name"
    ORDER BY "rate_per_100k" DESC
    LIMIT 5
) t
ORDER BY "year", "rate_per_100k" DESC
LIMIT 20;
