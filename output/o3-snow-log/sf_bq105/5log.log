```sql
/*--------------------------------------------------------------------
  Driver–distraction crash rates (per 100,000 population)

  • 2015 crashes → NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015
  • 2016 crashes → NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016
  • 2010 population → NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
--------------------------------------------------------------------*/
WITH population_2010 AS (           -- 2010 Census population for every state
    SELECT
        "state_fips_code",
        "state_name",
        "population_2010"                      -- 2010 pop  (assumed numeric)
    FROM  NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
    WHERE "population_2010" IS NOT NULL
),

/* ----------  2016 : Distraction–related crashes  ---------- */
crashes_2016 AS (
    SELECT
        "state_name",
        COUNT(*)     AS "crash_cnt_2016"
    FROM  NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016
    WHERE "driver_distracted_by_name" NOT IN
          ('Not Distracted','Unknown if Distracted','Not Reported')
    GROUP BY "state_name"
),

rate_2016 AS (
    SELECT
        p."state_name",
        2016                                    AS "year",
        (c."crash_cnt_2016" * 100000.0) /
        p."population_2010"                     AS "accidents_per_100k"
    FROM   crashes_2016  c
    JOIN   population_2010 p
           ON p."state_name" = c."state_name"
),

/* ----------  2015 : Distraction–related crashes  ---------- */
crashes_2015 AS (
    SELECT
        LPAD("state_number",2,'0') AS "state_fips_code",
        COUNT(*)                   AS "crash_cnt_2015"
    FROM  NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015
    WHERE "driver_distracted_by_name" NOT IN
          ('Not Distracted','Unknown if Distracted','Not Reported')
    GROUP BY "state_number"
),

rate_2015 AS (
    SELECT
        p."state_name",
        2015                                    AS "year",
        (c."crash_cnt_2015" * 100000.0) /
        p."population_2010"                     AS "accidents_per_100k"
    FROM   crashes_2015       c
    JOIN   population_2010    p
           ON p."state_fips_code" = c."state_fips_code"
),

/* ----------  Stack the two years & rank  ---------- */
all_rates AS (
    SELECT * FROM rate_2015
    UNION ALL
    SELECT * FROM rate_2016
),

ranked AS (
    SELECT
        "year",
        "state_name",
        ROUND("accidents_per_100k",4) AS "accidents_per_100k",
        DENSE_RANK() OVER (PARTITION BY "year"
                           ORDER BY "accidents_per_100k" DESC) AS "rate_rank"
    FROM all_rates
)

/* ----------  Final: top-5 states for each year  ---------- */
SELECT
    "year",
    "state_name",
    "accidents_per_100k",
    "rate_rank"
FROM   ranked
WHERE  "rate_rank" <= 5
ORDER  BY "year", "rate_rank" NULLS LAST;
```
