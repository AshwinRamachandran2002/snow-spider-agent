```sql
--Description:  Reveal the exact column name that stores 2010-census population
--              in UTILITY_US.US_STATES_AREA.  One row is turned into an OBJECT,
--              its keys are flattened, and any key containing “POP” (case-
--              insensitive) is returned.  Knowing this name lets us build the
--              per-100 000-population crash-rate query without “invalid identifier”
--              errors.
SELECT DISTINCT 
       f.value::STRING AS "population_column_name"
FROM (
