```sql
--Description:  To verify whether the population field actually exists (and learn its
--              exact name), convert a single row from US_STATES_AREA into an OBJECT,
--              explode that OBJECT’s keys, and list only those keys containing the
--              substring “pop” (case-insensitive).  This will reveal the correct
--              population column name—if any—to use in subsequent rate calculations.
SELECT DISTINCT 
       key_name
FROM (
        /* Turn one row into an OBJECT of key-value pairs */
        SELECT OBJECT_KEYS(OBJECT_CONSTRUCT(*)) AS all_keys
        FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
        LIMIT 1
     ), 
     LATERAL FLATTEN(input => all_keys) f(key_name)
WHERE  key_name ILIKE '%pop%';
