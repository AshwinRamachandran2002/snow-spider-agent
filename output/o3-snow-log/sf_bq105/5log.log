```sql
--Description:  One-shot query that (1) counts 2015 and 2016 fatal crashes involving a
--              distracted driver (excludes “Not Distracted”, “Unknown if Distracted”,
--              and “Not Reported”); (2) converts 2015 state_number to state_name via
--              the FIPS code in US_STATES_AREA; (3) joins both years’ counts to
--              2010-census population in the same table; (4) computes crashes per
--              100,000 population; (5) ranks states within each year and returns
--              the five highest-rate states for 2015 and for 2016.
WITH
/* 2016 distraction-involved fatal crashes, keyed by state_name */
d16 AS (
    SELECT  "state_name",
            COUNT(*) AS crashes,
            '2016'   AS yr
    FROM    NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016
    WHERE   "driver_distracted_by_name" NOT IN ('Not Distracted',
                                                'Unknown if Distracted',
                                                'Not Reported')
    GROUP BY "state_name"
),
/* 2015 distraction-involved crashes – convert state_number → state_name via FIPS */
d15 AS (
    SELECT  usa."state_name",
            COUNT(*) AS crashes,
            '2015'   AS yr
    FROM    NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d
    JOIN    NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA        usa
           ON usa."state_fips_code" = LPAD(d."state_number", 2, '0')
    WHERE   d."driver_distracted_by_name" NOT IN ('Not Distracted',
                                                  'Unknown if Distracted',
                                                  'Not Reported')
    GROUP BY usa."state_name"
),
/* Combine both years */
all_years AS (
    SELECT * FROM d15
    UNION ALL
    SELECT * FROM d16
),
/* Attach population and compute rate */
rates AS (
    SELECT  a."state_name",
            a.yr                                    AS "year",
            a.crashes                               AS distract_crashes,
            usa."POPULATION_2010"                   AS population_2010,
            (a.crashes * 100000.0) / usa."POPULATION_2010" AS rate_per_100k
    FROM    all_years a
    JOIN    NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA  usa
           ON usa."state_name" = a."state_name"
),
/* Rank states by rate within each year */
ranked AS (
    SELECT  r.*,
            DENSE_RANK() OVER (PARTITION BY "year"
                               ORDER BY rate_per_100k DESC) AS rn
    FROM    rates r
)
/* Return the top-5 states for each year */
SELECT  "year",
        "state_name",
        distract_crashes,
        population_2010,
        rate_per_100k
FROM    ranked
WHERE   rn <= 5
ORDER BY "year", rate_per_100k DESC;
```
