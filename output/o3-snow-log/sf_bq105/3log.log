```

```sql
--Description: 4) Pull a sample of 2015 distraction records that are NOT ‘Not Distracted’, ‘Unknown if Distracted’, or ‘Not Reported’
SELECT 
       "state_number",
       "driver_distracted_by",
       "driver_distracted_by_name"
FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015
WHERE  "driver_distracted_by_name" NOT IN ('Not Distracted',
                                           'Unknown if Distracted',
                                           'Not Reported')
LIMIT 20;
```

```sql
--Description: 5) Count 2016 distraction-related crashes (excluding the three unwanted categories) per state
SELECT 
       "state_name",
       COUNT(*) AS "distraction_crashes_2016"
FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016
WHERE  "driver_distracted_by_name" NOT IN ('Not Distracted',
                                           'Unknown if Distracted',
                                           'Not Reported')
GROUP  BY "state_name"
ORDER  BY "distraction_crashes_2016" DESC
LIMIT 20;
```

```sql
--Description: 6) Bring in state names for 2015 by joining the FIPS code to the reference table, then count distraction-related crashes (excluding the three unwanted categories)
SELECT 
       ref."state_name",
       COUNT(*) AS "distraction_crashes_2015"
FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d15
JOIN   NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA ref
       ON LPAD(CAST(d15."state_number" AS STRING), 2, '0') = ref."state_fips_code"
WHERE  d15."driver_distracted_by_name" NOT IN ('Not Distracted',
                                              'Unknown if Distracted',
                                              'Not Reported')
GROUP  BY ref."state_name"
ORDER  BY "distraction_crashes_2015" DESC
LIMIT 20;
```

```sql
--Description: 7) Obtain a reference list of states with their FIPS codes from the utility table
SELECT DISTINCT 
       "state_fips_code",
       "state_name"
FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
ORDER  BY "state_name"
LIMIT 20;
```

```sql
--Description: 8) Check 2015 ‘FACTOR_2015’ table to see other contributing-circumstance columns (for context)
SELECT DISTINCT 
       "contributing_circumstances_motor_vehicle",
       "contributing_circumstances_motor_vehicle_name"
FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.FACTOR_2015
LIMIT 20;
```

```sql
--Description: 9) Produce a state-level summary for 2016 with both total crashes and distraction-related crashes (can be used later for rates)
SELECT 
       "state_name",
       COUNT(*)                                                 AS "total_crashes_2016",
       SUM(CASE WHEN "driver_distracted_by_name" NOT IN ('Not Distracted',
                                                         'Unknown if Distracted',
                                                         'Not Reported')
                THEN 1 ELSE 0 END)                              AS "distraction_crashes_2016"
FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016
GROUP  BY "state_name"
LIMIT 20;
```

```sql
--Description: 10) Produce a state-level summary for 2015 (joining to state names) with both total crashes and distraction-related crashes
SELECT 
       ref."state_name",
       COUNT(*)                                                 AS "total_crashes_2015",
       SUM(CASE WHEN d15."driver_distracted_by_name" NOT IN ('Not Distracted',
                                                             'Unknown if Distracted',
                                                             'Not Reported')
                THEN 1 ELSE 0 END)                              AS "distraction_crashes_2015"
FROM   NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d15
JOIN   NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA ref
       ON LPAD(CAST(d15."state_number" AS STRING), 2, '0') = ref."state_fips_code"
GROUP  BY ref."state_name"
LIMIT 20;
```
