{'NHTSA_TRAFFIC_FATALITIES_PLUS': {'NHTSA_TRAFFIC_FATALITIES': ['DISTRACT_2016', 'DISTRACT_2015', 'FACTOR_2015'], 'UTILITY_US': ['US_STATES_AREA']}}

