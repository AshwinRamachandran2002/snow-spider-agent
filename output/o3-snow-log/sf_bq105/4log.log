```sql
--Description / Thinking process:
--Goal:  Count 2015 fatal-crash records that involve a genuine driver distraction for each U.S. state.
--       “Genuine” = driver_distracted_by_name is NOT any of the three “non-distraction” labels.
--Steps
-- 1. DISTRACT_2015 stores state as a numeric FIPS code (column state_number).  
--    We translate that code to a readable state name by joining to
--    UTILITY_US.US_STATES_AREA (state_fips_code, state_name).
-- 2. Exclude rows whose distraction text ILIKE the phrases
--       • ‘Not Distracted’
--       • ‘Unknown if Distracted’
--       • ‘Not Reported’
--    (ILIKE with % on both ends shields us from minor wording differences.)
-- 3. GROUP BY state_name and COUNT(*) to obtain each state’s total distraction crashes.
-- 4. ORDER by the count descending so the states with the most such crashes come first.
-- 5. LIMIT 20 for a concise preview.
SELECT
    s."state_name",
    COUNT(*) AS "distraction_crashes_2015"
FROM  NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d
JOIN  NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA             s
      ON LPAD(s."state_fips_code", 2, '0')::NUMBER = d."state_number"
WHERE d."driver_distracted_by_name" NOT ILIKE '%Not Distracted%'
  AND d."driver_distracted_by_name" NOT ILIKE '%Unknown if Distracted%'
  AND d."driver_distracted_by_name" NOT ILIKE '%Not Reported%'
GROUP BY s."state_name"
ORDER BY "distraction_crashes_2015" DESC
LIMIT 20;
```
