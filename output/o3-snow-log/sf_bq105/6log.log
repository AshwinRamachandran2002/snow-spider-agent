--Description:  We need the five states with the most distraction-related fatal-crash
--records in 2015 and in 2016, AFTER removing records whose distraction status is
--'Not Distracted', 'Unknown if Distracted', or 'Not Reported'.  Because the
--2015 table stores only numeric state codes, we translate them to state names
--through the US_STATES_AREA utility table.  The 2016 table already has state
--names; we join only to obtain the matching FIPS code for a uniform key.
--Steps:
--  1) Build two year-specific aggregates (c15 and c16) that count qualifying
--     crashes per state.
--  2) Union those two result sets into “combined”, labeling each row with the
--     year.
--  3) Use ROW_NUMBER() to rank states by crash count within each year.
--  4) Keep rows whose rank ≤ 5 (top five per year) and present them.
WITH states AS (                       -- FIPS-to-name lookup
    SELECT
        "state_fips_code",
        "state_name"
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
),
c15 AS (                               -- 2015 counts (numeric code → FIPS)
    SELECT
        LPAD("state_number"::STRING, 2, '0') AS "state_fips_code",
        COUNT(*)                             AS "crashes"
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015
    WHERE "driver_distracted_by_name" NOT IN ('Not Distracted',
                                              'Unknown if Distracted',
                                              'Not Reported')
    GROUP BY LPAD("state_number"::STRING, 2, '0')
),
c16 AS (                               -- 2016 counts (state name → FIPS)
    SELECT
        s."state_fips_code",
        COUNT(*)                             AS "crashes"
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016 d
    JOIN states s
      ON d."state_name" = s."state_name"
    WHERE d."driver_distracted_by_name" NOT IN ('Not Distracted',
                                                'Unknown if Distracted',
                                                'Not Reported')
    GROUP BY s."state_fips_code"
),
combined AS (                          -- Align columns and attach year label
    SELECT 2015 AS "year", st."state_name", c15."crashes"
    FROM c15
    JOIN states st USING ("state_fips_code")
    UNION ALL
    SELECT 2016 AS "year", st."state_name", c16."crashes"
    FROM c16
    JOIN states st USING ("state_fips_code")
),
ranked AS (                            -- Rank by crashes within each year
    SELECT
        "year",
        "state_name",
        "crashes",
        ROW_NUMBER() OVER (PARTITION BY "year" ORDER BY "crashes" DESC) AS "rk"
    FROM combined
)
SELECT
    "year",
    "state_name",
    "crashes"
FROM ranked
WHERE "rk" <= 5
ORDER BY "year", "crashes" DESC;
