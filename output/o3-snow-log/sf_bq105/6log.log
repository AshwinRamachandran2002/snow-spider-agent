```sql
-- Description: Join the 2015 crash counts to the utility table to attach state names (and, eventually, population).  
SELECT 
  u."state_name", 
  c."crashes_2015_distracted" 
FROM (
  SELECT 
    "state_number", 
    COUNT(*) AS "crashes_2015_distracted" 
  FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 
  WHERE "driver_distracted_by_name" NOT IN ('Not Distracted', 'Unknown if Distracted', 'Not Reported') 
  GROUP BY "state_number"
)  c
JOIN NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA u
  ON LPAD(c."state_number"::STRING, 2, '0') = u."state_fips_code"
LIMIT 20;
```

```sql
-- Description: Compute 2016 distracted-crash rate per 100,000 population by joining the 2016 counts to population.  
SELECT 
  d."state_name", 
  d."crashes_2016_distracted", 
  u."population_2010" AS "pop_2010",           -- adjust to the actual population column name once confirmed
  (d."crashes_2016_distracted" * 100000.0) / u."population_2010" AS "rate_per_100k_2016"
FROM (
  SELECT 
    "state_name", 
    COUNT(*) AS "crashes_2016_distracted"
  FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016
  WHERE "driver_distracted_by_name" NOT IN ('Not Distracted', 'Unknown if Distracted', 'Not Reported')
  GROUP BY "state_name"
) d
JOIN NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA u
  ON d."state_name" = u."state_name"
LIMIT 20;
```

```sql
-- Description: Show the five states with the highest distracted-crash rates in 2015 and 2016.  
WITH pop AS (
  SELECT 
    "state_fips_code",
    "state_name",
    "population_2010"          -- update to the utility table’s actual column name
  FROM NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
), c15 AS (
  SELECT 
    LPAD("state_number"::STRING,2,'0') AS "state_fips_code",
    COUNT(*) AS "crashes_2015"
  FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015
  WHERE "driver_distracted_by_name" NOT IN ('Not Distracted','Unknown if Distracted','Not Reported')
  GROUP BY LPAD("state_number"::STRING,2,'0')
), c16 AS (
  SELECT 
    u."state_fips_code",
    COUNT(*) AS "crashes_2016"
  FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016 d
  JOIN pop u ON d."state_name" = u."state_name"
  WHERE d."driver_distracted_by_name" NOT IN ('Not Distracted','Unknown if Distracted','Not Reported')
  GROUP BY u."state_fips_code"
)
SELECT *
FROM (
  SELECT 
    p."state_name",
    (c15."crashes_2015" * 100000.0) / p."population_2010" AS "rate_per_100k_2015"
  FROM c15
  JOIN pop p USING ("state_fips_code")
  ORDER BY "rate_per_100k_2015" DESC
  LIMIT 5
) five_2015
UNION ALL
SELECT *
FROM (
  SELECT 
    p."state_name",
    (c16."crashes_2016" * 100000.0) / p."population_2010" AS "rate_per_100k_2016"
  FROM c16
  JOIN pop p USING ("state_fips_code")
  ORDER BY "rate_per_100k_2016" DESC
  LIMIT 5
) five_2016
LIMIT 20;
```
