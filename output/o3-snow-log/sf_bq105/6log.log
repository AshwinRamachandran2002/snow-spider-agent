```sql
/*--------------------------------------------------------------------
  Driver–distraction fatal-crash rates (per 100,000 residents)
  for every U.S. state in calendar-years 2015 and 2016, using
  2010 Census population.  “Rate_rank” lets us see which five
  states each year had the highest rates (rank 1–5).
--------------------------------------------------------------------*/
WITH population_2010 AS (
    SELECT
        "state_fips_code"      AS fips,
        "state_name",
        CAST("pop_2010" AS NUMBER) AS population_2010        -- 2010 Census population
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA
    WHERE "state_fips_code" IS NOT NULL
),

/* ----------  2016 – fatal crashes where driver WAS distracted  ----------- */
crashes_2016 AS (
    SELECT
        d."state_name",
        COUNT(*)                AS crashes,
        2016                    AS year
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2016 d
    WHERE d."driver_distracted_by_name" NOT IN ('Not Distracted',
                                                'Unknown if Distracted',
                                                'Not Reported')
    GROUP BY d."state_name"
),

/* ----------  2015 – same, but table uses numeric FIPS code  -------------- */
crashes_2015_raw AS (
    SELECT
        d."state_number"        AS state_number,
        COUNT(*)                AS crashes
    FROM NHTSA_TRAFFIC_FATALITIES_PLUS.NHTSA_TRAFFIC_FATALITIES.DISTRACT_2015 d
    WHERE d."driver_distracted_by_name" NOT IN ('Not Distracted',
                                                'Unknown if Distracted',
                                                'Not Reported')
    GROUP BY d."state_number"
),
crashes_2015 AS (
    SELECT
        p."state_name",
        r.crashes,
        2015                    AS year
    FROM crashes_2015_raw r
    JOIN NHTSA_TRAFFIC_FATALITIES_PLUS.UTILITY_US.US_STATES_AREA p
      ON LPAD(r.state_number::VARCHAR, 2, '0') = p."state_fips_code"
),

/* ----------  Combine the two years  -------------------------------------- */
all_crashes AS (
    SELECT * FROM crashes_2015
    UNION ALL
    SELECT * FROM crashes_2016
),

/* ----------  Attach population & compute rate  --------------------------- */
rates AS (
    SELECT
        a.year,
        a.state_name,
        a.crashes,
        pop.population_2010,
        ROUND( a.crashes / NULLIF(pop.population_2010,0) * 100000 , 4)
            AS accidents_per_100k
    FROM all_crashes a
    JOIN population_2010 pop
      ON a.state_name = pop.state_name
),

/* ----------  Rank states within each year by their rates  ---------------- */
ranked AS (
    SELECT
        r.*,
        RANK() OVER (PARTITION BY year ORDER BY accidents_per_100k DESC) AS rate_rank
    FROM rates r
)

/* ----------  Final result  ---------------------------------------------- */
SELECT
    year,
    state_name,
    crashes,
    population_2010,
    accidents_per_100k,
    rate_rank          -- 1–5 are the highest-rate states in that year
FROM ranked
ORDER BY year, accidents_per_100k DESC NULLS LAST;
```
