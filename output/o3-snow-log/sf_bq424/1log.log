[{'country_name': 'Thailand', 'country_code': 'THA', 'indicator_name': 'Percentage of repeaters in primary education, all grades, both sexes (%)', 'indicator_code': 'SE.PRM.REPT.ZS', 'value': 1.95879995822906, 'year': 2015}, {'country_name': 'Thailand', 'country_code': 'THA', 'indicator_name': 'Teachers in primary education, female (number)', 'indicator_code': 'SE.PRM.TCHR.FE', 'value': 100974.0, 'year': 1977}, {'country_name': 'Thailand', 'country_code': 'THA', 'indicator_name': 'Adjusted net enrolment rate, primary, female (%)', 'indicator_code': 'SE.PRM.TENR.FE', 'value': 95.6890335083008, 'year': 2009}, {'country_name': 'Thailand', 'country_code': 'THA', 'indicator_name': 'Adjusted net enrolment rate, primary, male (%)', 'indicator_code': 'SE.PRM.TENR.MA', 'value': 95.4373016357422, 'year': 2007}, {'country_name': 'Thailand', 'country_code': 'THA', 'indicator_name': 'Out-of-school children of primary school age, female (number)', 'indicator_code': 'SE.PRM.UNER.FE', 'value': 165834.0, 'year': 2008}]

