sion_factor': None, 'ppp_survey_year': None, 'balance_of_payments_manual_in_use': None, 'external_debt_reporting_status': None, 'system_of_trade': None, 'government_accounting_concept': None, 'imf_data_dissemination_standard': None, 'latest_population_census': None, 'latest_household_survey': None, 'source_of_most_recent_Income_and_expenditure_data': None, 'vital_registration_complete': None, 'latest_agricultural_census': None, 'latest_industrial_data': None, 'latest_trade_data': None, 'latest_water_withdrawal_data': None}, {'country_code': 'LMY', 'short_name': 'Low & middle income', 'table_name': 'Low & middle income', 'long_name': 'Low & middle income', 'two_alpha_code': 'XO', 'currency_unit': None, 'special_notes': 'Low and middle income group aggregate (all developing economies). Low- and middle-income economies are those in which 2015 GNI per capita was $12,475 or less.', 'region': None, 'income_group': None, 'wb_2_code': 'XO', 'national_accounts_base_year': None, 'national_accounts_reference_year': None, 'sna_price_valuation': None, 'lending_category': None, 'other_groups': None, 'system_of_national_accounts': None, 'alternative_conversion_factor': None, 'ppp_survey_year': None, 'balance_of_payments_manual_in_use': None, 'external_debt_reporting_status': None, 'system_of_trade': None, 'government_accounting_concept': None, 'imf_data_dissemination_standard': None, 'latest_population_census': None, 'latest_household_survey': None, 'source_of_most_recent_Income_and_expenditure_data': None, 'vital_registration_complete': None, 'latest_agricultural_census': None, 'latest_industrial_data': None, 'latest_trade_data': None, 'latest_water_withdrawal_data': None}]

