    and their ratio of households earning < $20 000 to total SNAP households               */

WITH county_acs_2017 AS (           /* 2017 5-year ACS county-level data */
    SELECT
        "GEO_ID"                                             AS county_fips,         -- 5-digit county FIPS
        "households_public_asst_or_food_stamps"              AS snap_households,     -- SNAP-participating households
        ("income_less_10000" +                               -- households with income <$20 000
         "income_10000_14999" +
