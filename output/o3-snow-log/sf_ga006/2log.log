purchase_events AS (                 -- 2. pull purchase revenue & session id
    SELECT
        eu."USER_PSEUDO_ID",
        gs.value:"int_value"::NUMBER                         AS "GA_SESSION_ID",
        /* choose the first non-null revenue measure */
        COALESCE(
            eu."ECOMMERCE":"purchase_revenue_in_usd"::FLOAT,
            eu."EVENT_VALUE_IN_USD",
            itm_rev."ITEM_REVENUE"
        )                                                   AS "PURCHASE_REVENUE_USD"
    FROM       events_union eu
    /* 2a. obtain ga_session_id from event_params           */
    ,  LATERAL FLATTEN(input => eu."EVENT_PARAMS") gs
    /* 2b. compute revenue from ITEMS if other fields null  */
    ,  LATERAL (
           SELECT SUM(it.value:"price"::FLOAT * it.value:"quantity"::FLOAT) AS "ITEM_REVENUE"
           FROM   LATERAL FLATTEN(input => eu."ITEMS") it
       ) itm_rev
    WHERE eu."EVENT_NAME" = 'purchase'
      AND gs.value:"key"::STRING = 'ga_session_id'          -- session id present
      AND COALESCE(
              eu."ECOMMERCE":"purchase_revenue_in_usd",
              eu."EVENT_VALUE_IN_USD",
              itm_rev."ITEM_REVENUE"
          ) IS NOT NULL
      AND gs.value:"int_value" IS NOT NULL
),
session_revenue AS (                 -- 3. total purchase $ per user-session
    SELECT
        "USER_PSEUDO_ID",
        "GA_SESSION_ID",
        SUM("PURCHASE_REVENUE_USD") AS "SESSION_PURCHASE_REVENUE"
    FROM purchase_events
    GROUP BY "USER_PSEUDO_ID", "GA_SESSION_ID"
)
SELECT                                -- 4. average revenue for users with >1 session
    "USER_PSEUDO_ID",
    AVG("SESSION_PURCHASE_REVENUE") AS "AVG_PURCHASE_REVENUE_PER_SESSION"
FROM   session_revenue
GROUP BY "USER_PSEUDO_ID"
HAVING COUNT(*) > 1
ORDER BY "AVG_PURCHASE_REVENUE_PER_SESSION" DESC NULLS LAST;
