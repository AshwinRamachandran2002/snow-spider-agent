                                          AS "PURCHASE_REVENUE_USD"
    FROM events_union eu
    ,    LATERAL FLATTEN( input => PARSE_JSON(eu."EVENT_PARAMS") ) ep
    WHERE eu."EVENT_NAME" = 'purchase'
      AND ep.value:"key"::STRING = 'ga_session_id'
      AND PARSE_JSON(eu."ECOMMERCE"):"purchase_revenue_in_usd" IS NOT NULL
      AND COALESCE(
            ep.value:"int_value",
            TRY_TO_NUMBER(ep.value:"string_value"::STRING)
          ) IS NOT NULL
),

session_revenue AS (       -- 3. total purchase revenue per user-session
    SELECT
        "USER_PSEUDO_ID",
        "GA_SESSION_ID",
        SUM("PURCHASE_REVENUE_USD") AS "SESSION_PURCHASE_REVENUE"
    FROM purchase_events
    GROUP BY "USER_PSEUDO_ID", "GA_SESSION_ID"
)

-- 4. average purchase-revenue per session, only users with >1 purchase session
SELECT
    "USER_PSEUDO_ID",
    AVG("SESSION_PURCHASE_REVENUE") AS "AVG_PURCHASE_REVENUE_PER_SESSION"
FROM session_revenue
GROUP BY "USER_PSEUDO_ID"
HAVING COUNT(*) > 1
ORDER BY "AVG_PURCHASE_REVENUE_PER_SESSION" DESC NULLS LAST;
```
