       ON f."company_id" = d."company_id"
WHERE  f."valuation" >= 1000000000
  AND  LEFT(d."date_joined",4) IN ('2019','2020','2021')
LIMIT 20;
```

```sql
--Description: 6) Attach industries for those 2019-2021 unicorns
SELECT ui."company_id",
       ui."join_year",
       i."industry"
FROM (
      SELECT f."company_id",
             LEFT(d."date_joined",4) AS "join_year"
      FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING  f
      JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_DATES    d
             ON f."company_id" = d."company_id"
      WHERE  f."valuation" >= 1000000000
        AND  LEFT(d."date_joined",4) IN ('2019','2020','2021')
     ) ui
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
     ON ui."company_id" = i."company_id"
LIMIT 20;
```

```sql
--Description: 7) Count new unicorns per industry, 2019-2021
SELECT i."industry",
       COUNT(*) AS "unicorns_2019_2021"
FROM (
      SELECT f."company_id"
      FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING  f
      JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_DATES    d
             ON f."company_id" = d."company_id"
      WHERE  f."valuation" >= 1000000000
        AND  LEFT(d."date_joined",4) IN ('2019','2020','2021')
     ) u
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
     ON u."company_id" = i."company_id"
GROUP BY i."industry"
ORDER BY "unicorns_2019_2021" DESC
LIMIT 20;
```

```sql
--Description: 8) Identify the top industry in that period (single row expected)
SELECT i."industry",
       COUNT(*) AS "total_unicorns"
FROM (
      SELECT f."company_id"
      FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING  f
      JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_DATES    d
             ON f."company_id" = d."company_id"
      WHERE  f."valuation" >= 1000000000
        AND  LEFT(d."date_joined",4) IN ('2019','2020','2021')
     ) u
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
     ON u."company_id" = i."company_id"
GROUP BY i."industry"
ORDER BY "total_unicorns" DESC
LIMIT 20;
```

```sql
--Description: 9) Count new unicorns by year for the (hard-coded) top industry found above
SELECT LEFT(d."date_joined",4)      AS "join_year",
       COUNT(*)                     AS "new_unicorns"
FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING   f
JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_DATES     d
       ON f."company_id" = d."company_id"
JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
       ON f."company_id" = i."company_id"
WHERE  f."valuation" >= 1000000000
  AND  LEFT(d."date_joined",4) IN ('2019','2020','2021')
  AND  i."industry" = 'Fintech'      -- ← replace with industry returned in query 8
GROUP BY LEFT(d."date_joined",4)
ORDER BY "join_year"
LIMIT 20;
```

```sql
--Description: 10) Compute the average number of new unicorns per year for that industry (2019-2021)
SELECT AVG("new_unicorns") AS "avg_new_unicorns_per_year"
FROM (
      SELECT LEFT(d."date_joined",4) AS "join_year",
             COUNT(*)                AS "new_unicorns"
      FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING   f
      JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_DATES     d
             ON f."company_id" = d."company_id"
      JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
             ON f."company_id" = i."company_id"
      WHERE  f."valuation" >= 1000000000
        AND  LEFT(d."date_joined",4) IN ('2019','2020','2021')
        AND  i."industry" = 'Fintech'   -- ← replace if query 8 shows a different top industry
      GROUP BY LEFT(d."date_joined",4)
     ) yr_counts
LIMIT 20;
```
