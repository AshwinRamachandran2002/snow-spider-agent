```sql
--Description: Count how many unicorns exist in each industry (overall, no date filter yet)
SELECT i."industry",
       COUNT(*) AS "unicorn_count"
FROM   "MODERN_DATA"."MODERN_DATA"."COMPANIES_FUNDING" f
JOIN   "MODERN_DATA"."MODERN_DATA"."COMPANIES_INDUSTRIES" i
       ON f."company_id" = i."company_id"
WHERE  f."valuation" >= 1000000000
GROUP  BY i."industry"
ORDER  BY "unicorn_count" DESC
LIMIT 20;
```

```sql
--Description: Check the spread of join-dates for all companies (helps to see usable years)
