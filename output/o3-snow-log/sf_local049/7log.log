       "date_joined",
       SUBSTR("date_joined",1,4) AS "year_joined"
FROM   "MODERN_DATA"."MODERN_DATA"."COMPANIES_DATES"
LIMIT 20;
```

```sql
--Description: Identify unicorns that joined between 2019-01-01 and 2021-12-31 (raw rows)
SELECT f."company_id",
       d."date_joined",
       SUBSTR(d."date_joined",1,4) AS "year_joined",
       f."valuation"
FROM   "MODERN_DATA"."MODERN_DATA"."COMPANIES_FUNDING"     f
JOIN   "MODERN_DATA"."MODERN_DATA"."COMPANIES_DATES"       d
       ON f."company_id" = d."company_id"
WHERE  f."valuation" >= 1000000000
  AND  d."date_joined" >= '2019-01-01'
  AND  d."date_joined" <= '2021-12-31'
LIMIT 20;
```

```sql
--Description: Aggregate unicorn counts in 2019-2021 window by industry
SELECT i."industry",
       COUNT(*) AS "unicorn_2019_2021"
FROM   "MODERN_DATA"."MODERN_DATA"."COMPANIES_FUNDING"  f
JOIN   "MODERN_DATA"."MODERN_DATA"."COMPANIES_DATES"    d
       ON f."company_id" = d."company_id"
JOIN   "MODERN_DATA"."MODERN_DATA"."COMPANIES_INDUSTRIES" i
       ON f."company_id" = i."company_id"
WHERE  f."valuation" >= 1000000000
  AND  d."date_joined" >= '2019-01-01'
  AND  d."date_joined" <= '2021-12-31'
GROUP  BY i."industry"
ORDER  BY "unicorn_2019_2021" DESC
LIMIT 20;
```

```sql
--Description: Show per-year unicorn counts for the top industry (swap 'Fintech' if the previous query shows a different leader)
SELECT SUBSTR(d."date_joined",1,4) AS "year_joined",
       COUNT(*)                     AS "new_unicorns"
FROM   "MODERN_DATA"."MODERN_DATA"."COMPANIES_FUNDING"  f
JOIN   "MODERN_DATA"."MODERN_DATA"."COMPANIES_DATES"    d
       ON f."company_id" = d."company_id"
JOIN   "MODERN_DATA"."MODERN_DATA"."COMPANIES_INDUSTRIES" i
       ON f."company_id" = i."company_id"
WHERE  f."valuation" >= 1000000000
  AND  d."date_joined" >= '2019-01-01'
  AND  d."date_joined" <= '2021-12-31'
  AND  i."industry" ILIKE '%Fintech%'          -- replace if needed
GROUP  BY SUBSTR(d."date_joined",1,4)
ORDER  BY "year_joined"
LIMIT 20;
```

```sql
--Description: Calculate the average number of new unicorns per year (2019-2021) for the chosen top industry
SELECT AVG("new_unicorns") AS "avg_new_unicorns_per_year"
FROM (
      SELECT SUBSTR(d."date_joined",1,4) AS "year_joined",
             COUNT(*)                     AS "new_unicorns"
      FROM   "MODERN_DATA"."MODERN_DATA"."COMPANIES_FUNDING"  f
      JOIN   "MODERN_DATA"."MODERN_DATA"."COMPANIES_DATES"    d
             ON f."company_id" = d."company_id"
      JOIN   "MODERN_DATA"."MODERN_DATA"."COMPANIES_INDUSTRIES" i
             ON f."company_id" = i."company_id"
      WHERE  f."valuation" >= 1000000000
        AND  d."date_joined" >= '2019-01-01'
        AND  d."date_joined" <= '2021-12-31'
        AND  i."industry" ILIKE '%Fintech%'      -- replace if needed
      GROUP  BY SUBSTR(d."date_joined",1,4)
     ) t
LIMIT 20;
```
