```sql
--Description: 2. Display all companies whose valuation is at least one-billion (i.e. potential unicorns)
SELECT "company_id",
       "valuation"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING
WHERE "valuation" >= 1000000000
LIMIT 20;
```

```sql
--Description: 3. See which industries these unicorns belong to
SELECT DISTINCT cf."company_id",
       ci."industry"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING cf
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES ci
  ON cf."company_id" = ci."company_id"
WHERE cf."valuation" >= 1000000000
LIMIT 20;
```

```sql
--Description: 4. Count of unicorns per industry to spot the top industry
SELECT ci."industry",
       COUNT(*) AS "unicorn_cnt"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING cf
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES ci
  ON cf."company_id" = ci."company_id"
WHERE cf."valuation" >= 1000000000
GROUP BY ci."industry"
ORDER BY "unicorn_cnt" DESC
LIMIT 20;
```

```sql
--Description: 5. Verify all unicorns inside the (likely) top industry – change ILIKE value once you know exact top
SELECT cf."company_id",
       ci."industry",
       cf."valuation"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING cf
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES ci
  ON cf."company_id" = ci."company_id"
WHERE cf."valuation" >= 1000000000
  AND ci."industry" ILIKE '%Fintech%'    -- replace '%Fintech%' after confirming top industry
LIMIT 20;
```

```sql
--Description: 6. Join in the join-date for those unicorns so we can pull the year
SELECT cf."company_id",
       ci."industry",
       cd."date_joined"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING  cf
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES ci
  ON cf."company_id" = ci."company_id"
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_DATES     cd
  ON cf."company_id" = cd."company_id"
WHERE cf."valuation" >= 1000000000
  AND ci."industry" ILIKE '%Fintech%'        -- keep same filter as query 5
LIMIT 20;
```

```sql
--Description: 7. Count how many new unicorns in the top industry for each year 2019-2021
SELECT LEFT(cd."date_joined", 4) AS "year",
       COUNT(*)                   AS "new_unicorns"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING  cf
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES ci
  ON cf."company_id" = ci."company_id"
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_DATES     cd
  ON cf."company_id" = cd."company_id"
WHERE cf."valuation" >= 1000000000
  AND ci."industry" ILIKE '%Fintech%'        -- top industry
  AND LEFT(cd."date_joined", 4) IN ('2019','2020','2021')
GROUP BY LEFT(cd."date_joined", 4)
ORDER BY "year";
```

```sql
--Description: 8. Compute the average number of new unicorns per year (2019-2021) for the top industry
WITH yearly AS (
    SELECT LEFT(cd."date_joined", 4) AS "yr",
           COUNT(*) AS "cnt"
    FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING  cf
    JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES ci
           ON cf."company_id" = ci."company_id"
    JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_DATES     cd
           ON cf."company_id" = cd."company_id"
    WHERE  cf."valuation" >= 1000000000
      AND  ci."industry" ILIKE '%Fintech%'        -- top industry
      AND  LEFT(cd."date_joined", 4) IN ('2019','2020','2021')
    GROUP BY LEFT(cd."date_joined", 4)
)
SELECT AVG("cnt") AS "avg_new_unicorns_per_year"
FROM yearly;
```

```sql
--Description: 9. (Optional) Show the exact companies contributing to each year’s count to double-check logic
SELECT LEFT(cd."date_joined", 4) AS "year",
       cf."company_id",
       ci."industry",
       cf."valuation"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING  cf
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES ci
  ON cf."company_id" = ci."company_id"
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_DATES     cd
  ON cf."company_id" = cd."company_id"
WHERE cf."valuation" >= 1000000000
  AND ci."industry" ILIKE '%Fintech%'        -- top industry
  AND LEFT(cd."date_joined", 4) IN ('2019','2020','2021')
ORDER BY "year", cf."company_id"
LIMIT 20;
```
