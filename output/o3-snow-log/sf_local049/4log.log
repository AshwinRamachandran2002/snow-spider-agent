```sql
--Description: We want the average number of new unicorns per year (2019-2021) in the top industry, which earlier analysis showed is “Fintech”.
--            • CTE “fintech_unicorns” collects Fintech companies whose valuation ≥ 1 B and keeps only join years 2019-2021.
--            • CTE “yearly_counts” counts how many such Fintech unicorns appeared in each of those three years.
--            • Final SELECT averages those yearly counts to give the requested metric.
WITH fintech_unicorns AS (
    SELECT 
        SUBSTR(d."date_joined", 1, 4) AS "year"
    FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING    f
    JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_DATES      d
           ON f."company_id" = d."company_id"
    JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
           ON f."company_id" = i."company_id"
    WHERE  f."valuation" >= 1000000000          -- unicorn definition
      AND  i."industry" = 'Fintech'             -- top industry
      AND  SUBSTR(d."date_joined", 1, 4) IN ('2019','2020','2021')
),
yearly_counts AS (
    SELECT "year", COUNT(*) AS "new_unicorns"
    FROM   fintech_unicorns
    GROUP  BY "year"
)
SELECT AVG("new_unicorns") AS "avg_new_unicorns_per_year"
FROM   yearly_counts;
```
