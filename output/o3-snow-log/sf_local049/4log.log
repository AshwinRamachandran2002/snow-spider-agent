--Description: Calculate the average number of Fintech unicorns created per year (2019-2021): first count new unicorns each year, then take the mean.
SELECT AVG("new_unicorns") AS "avg_new_unicorns_per_year"
FROM (
    SELECT 
        SUBSTR(d."date_joined", 1, 4) AS "year",
        COUNT(*)                      AS "new_unicorns"
    FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING   f
    JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_DATES     d
           ON f."company_id" = d."company_id"
    JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
           ON f."company_id" = i."company_id"
    WHERE  f."valuation" >= 1000000000      -- unicorn threshold
      AND  i."industry" = 'Fintech'         -- top industry
      AND  SUBSTR(d."date_joined", 1, 4) IN ('2019','2020','2021')
    GROUP BY SUBSTR(d."date_joined", 1, 4)
) AS yearly_counts
