```sql
--Description: 1)  Quick look at funding details – see company_id and valuation values
SELECT "company_id", "valuation", "funding"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING
LIMIT 20;
```

```sql
--Description: 2)  Review the industries table – list distinct industry names
SELECT DISTINCT "industry"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES
LIMIT 20;
```

```sql
--Description: 3)  Join funding & industries to isolate “unicorns” (valuation ≥ 1 B) and show their sectors
SELECT f."company_id",
       f."valuation",
       i."industry"
FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING   f
JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
       ON f."company_id" = i."company_id"
WHERE  f."valuation" >= 1000000000
LIMIT 20;
```

```sql
--Description: 4)  Count how many unicorns exist in every industry to find the top one
SELECT i."industry",
       COUNT(*) AS "unicorn_count"
FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING   f
JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
       ON f."company_id" = i."company_id"
WHERE  f."valuation" >= 1000000000
GROUP  BY i."industry"
ORDER  BY "unicorn_count" DESC
LIMIT 20;
```

```sql
--Description: 5)  Inspect date_joined values so we know what they look like (for year-filtering)
SELECT "company_id", "date_joined"
FROM   MODERN_DATA.MODERN_DATA.COMPANIES_DATES
WHERE  "date_joined" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 6)  Combine unicorn list with their join dates to see which years they joined
SELECT f."company_id",
       f."valuation",
       d."date_joined"
FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING   f
JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_DATES     d
       ON f."company_id" = d."company_id"
WHERE  f."valuation" >= 1000000000
LIMIT 20;
```

```sql
--Description: 7)  Filter to years 2019-2021 and tally unicorns per year per industry
SELECT i."industry",
       SUBSTR(d."date_joined", 1, 4) AS "year",
       COUNT(*) AS "yearly_new_unicorns"
FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING   f
JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_DATES     d
       ON f."company_id" = d."company_id"
JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
       ON f."company_id" = i."company_id"
WHERE  f."valuation" >= 1000000000
  AND  SUBSTR(d."date_joined", 1, 4) IN ('2019','2020','2021')
GROUP  BY i."industry", SUBSTR(d."date_joined", 1, 4)
ORDER  BY i."industry", "year"
LIMIT 20;
```

```sql
--Description: 8)  Identify the single industry with the highest total unicorn count (2019-2021 window)
SELECT i."industry",
       COUNT(*) AS "total_2019_2021"
FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING   f
JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_DATES     d
       ON f."company_id" = d."company_id"
JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
       ON f."company_id" = i."company_id"
WHERE  f."valuation" >= 1000000000
  AND  SUBSTR(d."date_joined", 1, 4) IN ('2019','2020','2021')
GROUP  BY i."industry"
ORDER  BY "total_2019_2021" DESC
LIMIT 20;
```

```sql
--Description: 9)  Using the top industry (replace %TOP_INDUSTRY% with result from step 8), compute counts per year
SELECT SUBSTR(d."date_joined", 1, 4) AS "year",
       COUNT(*) AS "new_unicorns"
FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING   f
JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_DATES     d
       ON f."company_id" = d."company_id"
JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
       ON f."company_id" = i."company_id"
WHERE  f."valuation" >= 1000000000
  AND  SUBSTR(d."date_joined", 1, 4) IN ('2019','2020','2021')
  AND  i."industry" = '%TOP_INDUSTRY%'   -- replace placeholder
GROUP  BY SUBSTR(d."date_joined", 1, 4)
ORDER  BY "year"
LIMIT 20;
```

```sql
--Description: 10)  Final step – average the yearly counts from 2019-2021 for the top industry
SELECT AVG("new_unicorns") AS "avg_new_unicorns_per_year"
FROM  (
        SELECT SUBSTR(d."date_joined", 1, 4) AS "year",
               COUNT(*)                       AS "new_unicorns"
        FROM   MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING   f
        JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_DATES     d
               ON f."company_id" = d."company_id"
        JOIN   MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
               ON f."company_id" = i."company_id"
        WHERE  f."valuation" >= 1000000000
          AND  SUBSTR(d."date_joined", 1, 4) IN ('2019','2020','2021')
          AND  i."industry" = '%TOP_INDUSTRY%'   -- replace placeholder
        GROUP  BY SUBSTR(d."date_joined", 1, 4)
      );
```
