```sql
--Description: Inspect sample values and make sure we can see which companies meet the ( ≥ 1,000,000,000 ) unicorn-valuation criterion
SELECT 
    "company_id",
    "valuation",
    "funding",
    "select_investors"
FROM MODERN_DATA.MODERN_DATA."COMPANIES_FUNDING"
ORDER BY "valuation" DESC
LIMIT 20;
```

```sql
--Description: Confirm which of those high-valuation companies have an “industry” tag
SELECT 
    cf."company_id",
    cf."valuation",
    ci."industry"
FROM MODERN_DATA.MODERN_DATA."COMPANIES_FUNDING" cf
JOIN MODERN_DATA.MODERN_DATA."COMPANIES_INDUSTRIES" ci
      ON cf."company_id" = ci."company_id"
WHERE cf."valuation" >= 1000000000
LIMIT 20;
```

```sql
--Description: Look at the join date for unicorn-valuation companies so we can derive the calendar year
SELECT
    cf."company_id",
    cf."valuation",
    cd."date_joined"
FROM MODERN_DATA.MODERN_DATA."COMPANIES_FUNDING"  cf
JOIN MODERN_DATA.MODERN_DATA."COMPANIES_DATES"    cd
      ON cf."company_id" = cd."company_id"
WHERE cf."valuation" >= 1000000000
LIMIT 20;
```

```sql
--Description: Extract the four-digit year from "date_joined" for every unicorn to be sure 2019-2021 are present
SELECT 
    SUBSTR(cd."date_joined",1,4)  AS "year_joined",
    COUNT(*)                      AS "cnt"
FROM MODERN_DATA.MODERN_DATA."COMPANIES_FUNDING"  cf
JOIN MODERN_DATA.MODERN_DATA."COMPANIES_DATES"    cd
      ON cf."company_id" = cd."company_id"
WHERE cf."valuation" >= 1000000000
GROUP BY SUBSTR(cd."date_joined",1,4)
ORDER BY "year_joined"
LIMIT 20;
```

```sql
--Description: Count total unicorns in every industry (across all years) so we can find the top industry
SELECT
    ci."industry",
    COUNT(*) AS "total_unicorns"
FROM MODERN_DATA.MODERN_DATA."COMPANIES_FUNDING"  cf
JOIN MODERN_DATA.MODERN_DATA."COMPANIES_INDUSTRIES" ci
      ON cf."company_id" = ci."company_id"
WHERE cf."valuation" >= 1000000000
GROUP BY ci."industry"
ORDER BY "total_unicorns" DESC
LIMIT 20;
```

```sql
--Description: Count unicorns by industry and year (2019-2021) to see annual behaviour per sector
SELECT
    ci."industry",
    SUBSTR(cd."date_joined",1,4) AS "year_joined",
    COUNT(*)                     AS "yearly_unicorns"
FROM MODERN_DATA.MODERN_DATA."COMPANIES_FUNDING"  cf
JOIN MODERN_DATA.MODERN_DATA."COMPANIES_DATES"    cd
      ON cf."company_id" = cd."company_id"
JOIN MODERN_DATA.MODERN_DATA."COMPANIES_INDUSTRIES" ci
      ON cf."company_id" = ci."company_id"
WHERE cf."valuation" >= 1000000000
  AND SUBSTR(cd."date_joined",1,4) IN ('2019','2020','2021')
GROUP BY ci."industry", SUBSTR(cd."date_joined",1,4)
ORDER BY "year_joined", "yearly_unicorns" DESC
LIMIT 20;
```

```sql
--Description: Identify which industry had the highest number of new unicorns during 2019-2021
SELECT
    ci."industry",
    COUNT(*) AS "total_2019_2021"
FROM MODERN_DATA.MODERN_DATA."COMPANIES_FUNDING"  cf
JOIN MODERN_DATA.MODERN_DATA."COMPANIES_DATES"    cd
      ON cf."company_id" = cd."company_id"
JOIN MODERN_DATA.MODERN_DATA."COMPANIES_INDUSTRIES" ci
      ON cf."company_id" = ci."company_id"
WHERE cf."valuation" >= 1000000000
  AND SUBSTR(cd."date_joined",1,4) IN ('2019','2020','2021')
GROUP BY ci."industry"
ORDER BY "total_2019_2021" DESC
LIMIT 20;
```

```sql
--Description: Once the top industry is known (suppose it is 'Fintech', adjust if query 7 shows different), 
--            count its unicorns for each year 2019-2021
SELECT
    SUBSTR(cd."date_joined",1,4) AS "year_joined",
    COUNT(*)                     AS "fintech_unicorns"
FROM MODERN_DATA.MODERN_DATA."COMPANIES_FUNDING"  cf
JOIN MODERN_DATA.MODERN_DATA."COMPANIES_DATES"    cd
      ON cf."company_id" = cd."company_id"
JOIN MODERN_DATA.MODERN_DATA."COMPANIES_INDUSTRIES" ci
      ON cf."company_id" = ci."company_id"
WHERE cf."valuation" >= 1000000000
  AND ci."industry" ILIKE '%Fintech%'           -- replace ʻFintechʼ if a different industry ranks #1
  AND SUBSTR(cd."date_joined",1,4) IN ('2019','2020','2021')
GROUP BY SUBSTR(cd."date_joined",1,4)
ORDER BY "year_joined"
LIMIT 20;
```

```sql
--Description: Compute the average number of new unicorns per year for that top industry between 2019-2021
SELECT
    AVG("yearly_cnt") AS "avg_new_unicorns_per_year"
FROM (
    SELECT
        SUBSTR(cd."date_joined",1,4) AS "year_joined",
        COUNT(*)                     AS "yearly_cnt"
    FROM MODERN_DATA.MODERN_DATA."COMPANIES_FUNDING"  cf
    JOIN MODERN_DATA.MODERN_DATA."COMPANIES_DATES"    cd
          ON cf."company_id" = cd."company_id"
    JOIN MODERN_DATA.MODERN_DATA."COMPANIES_INDUSTRIES" ci
          ON cf."company_id" = ci."company_id"
    WHERE cf."valuation" >= 1000000000
      AND ci."industry" ILIKE '%Fintech%'           -- replace with actual #1 industry if needed
      AND SUBSTR(cd."date_joined",1,4) IN ('2019','2020','2021')
    GROUP BY SUBSTR(cd."date_joined",1,4)
)
LIMIT 20;
```

```sql
--Description: For completeness, list all unicorns in the top industry that joined between 2019-2021
SELECT
    cf."company_id",
    cd."date_joined",
    ci."industry",
    cf."valuation"
FROM MODERN_DATA.MODERN_DATA."COMPANIES_FUNDING"  cf
JOIN MODERN_DATA.MODERN_DATA."COMPANIES_DATES"    cd
      ON cf."company_id" = cd."company_id"
JOIN MODERN_DATA.MODERN_DATA."COMPANIES_INDUSTRIES" ci
      ON cf."company_id" = ci."company_id"
WHERE cf."valuation" >= 1000000000
  AND ci."industry" ILIKE '%Fintech%'             -- adjust if necessary
  AND SUBSTR(cd."date_joined",1,4) IN ('2019','2020','2021')
ORDER BY cd."date_joined"
LIMIT 20;
```
