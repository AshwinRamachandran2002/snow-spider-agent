SELECT 
    cf."company_id",
    cf."valuation"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING cf
WHERE cf."valuation" >= 1000000000
LIMIT 20;
```

```sql
--Description: 4) Review the date information associated with companies
SELECT 
    "company_id",
    "date_joined",
    "year_founded"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_DATES
LIMIT 20;
```

```sql
--Description: 5) Combine dates with funding to keep only unicorns and extract join-year
SELECT 
    d."company_id",
    d."date_joined",
    SUBSTR(d."date_joined",1,4) AS "join_year",
    f."valuation"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_DATES d
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING f 
      ON d."company_id" = f."company_id"
WHERE f."valuation" >= 1000000000
LIMIT 20;
```

```sql
--Description: 6) Join unicorns with industries to see counts per join-year and industry (2019-2021 only, still sample)
SELECT 
    i."industry",
    SUBSTR(d."date_joined",1,4) AS "join_year",
    COUNT(*) AS "unicorn_cnt"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_DATES d 
      ON i."company_id" = d."company_id"
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING f 
      ON i."company_id" = f."company_id"
WHERE f."valuation" >= 1000000000
  AND SUBSTR(d."date_joined",1,4) IN ('2019','2020','2021')
GROUP BY i."industry", SUBSTR(d."date_joined",1,4)
ORDER BY "unicorn_cnt" DESC
LIMIT 20;
```

```sql
--Description: 7) Find the top industry by total unicorn count 2019-2021
SELECT 
    i."industry",
    COUNT(*) AS "total_2019_2021_unicorns"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_DATES d 
      ON i."company_id" = d."company_id"
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING f 
      ON i."company_id" = f."company_id"
WHERE f."valuation" >= 1000000000
  AND SUBSTR(d."date_joined",1,4) IN ('2019','2020','2021')
GROUP BY i."industry"
ORDER BY "total_2019_2021_unicorns" DESC
LIMIT 20;
```

```sql
--Description: 8) Count new unicorns per year just for that top industry (replace 'Fintech' if query 7 shows another)
SELECT 
    SUBSTR(d."date_joined",1,4) AS "join_year",
    COUNT(*) AS "yearly_unicorns"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_DATES d 
      ON i."company_id" = d."company_id"
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING f 
      ON i."company_id" = f."company_id"
WHERE f."valuation" >= 1000000000
  AND i."industry" = 'Fintech'   -- change to top industry if different
  AND SUBSTR(d."date_joined",1,4) IN ('2019','2020','2021')
GROUP BY SUBSTR(d."date_joined",1,4)
ORDER BY "join_year"
LIMIT 20;
```

```sql
--Description: 9) Compute the 3-year average of new unicorns for that top industry
SELECT 
    AVG("yearly_unicorns") AS "avg_new_unicorns_per_year"
FROM (
    SELECT 
        SUBSTR(d."date_joined",1,4) AS "join_year",
        COUNT(*) AS "yearly_unicorns"
    FROM MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
    JOIN MODERN_DATA.MODERN_DATA.COMPANIES_DATES d 
          ON i."company_id" = d."company_id"
    JOIN MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING f 
          ON i."company_id" = f."company_id"
    WHERE f."valuation" >= 1000000000
      AND i."industry" = 'Fintech'   -- change to top industry if different
      AND SUBSTR(d."date_joined",1,4) IN ('2019','2020','2021')
    GROUP BY SUBSTR(d."date_joined",1,4)
) t
LIMIT 20;
```

```sql
--Description: 10) (Optional) Show the raw list of companies used for the average for traceability
SELECT 
    i."industry",
    d."company_id",
    d."date_joined",
    f."valuation"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_DATES d 
      ON i."company_id" = d."company_id"
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING f 
      ON i."company_id" = f."company_id"
WHERE f."valuation" >= 1000000000
  AND i."industry" = 'Fintech'   -- change to top industry if different
  AND SUBSTR(d."date_joined",1,4) IN ('2019','2020','2021')
LIMIT 20;
```
