--Description: 8) Count new unicorns per year just for that top industry (replace 'Fintech' if query 7 shows another)
SELECT 
    SUBSTR(d."date_joined",1,4) AS "join_year",
    COUNT(*) AS "yearly_unicorns"
FROM MODERN_DATA.MODERN_DATA.COMPANIES_INDUSTRIES i
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_DATES d 
      ON i."company_id" = d."company_id"
JOIN MODERN_DATA.MODERN_DATA.COMPANIES_FUNDING f 
      ON i."company_id" = f."company_id"
WHERE f."valuation" >= 1000000000
  AND i."industry" = 'Fintech'   -- change to top industry if different
  AND SUBSTR(d."date_joined",1,4) IN ('2019','2020','2021')
GROUP BY SUBSTR(d."date_joined",1,4)
ORDER BY "join_year"
LIMIT 20;
