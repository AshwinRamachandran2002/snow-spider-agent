```sql
--Description: Quick look at the sellers table – id, city and state.  
SELECT 
    "seller_id",
    "seller_city",
    "seller_state"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES."SELLERS"
LIMIT 20;
```

```sql
--Description: Inspect a sample of order-items to understand price, freight and the seller behind each item.  
SELECT 
    "order_id",
    "seller_id",
    "product_id",
    "order_item_id",
    "price",
    "freight_value"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: For one random seller, see the link from order-items to the original order information.  
SELECT 
    oi."seller_id",
    oi."order_id",
    o."order_purchase_timestamp",
    o."order_approved_at",
    o."order_delivered_carrier_date"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"  oi 
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES."ORDERS"       o 
      ON oi."order_id" = o."order_id"
WHERE oi."seller_id" ILIKE '%'
LIMIT 20;
```

```sql
--Description: Calculate the packing time (in hours) for a sample – difference between approval and carrier pick-up.  
SELECT 
    oi."seller_id",
    oi."order_id",
    DATEDIFF('hour', 
             TO_TIMESTAMP(o."order_approved_at"), 
             TO_TIMESTAMP(o."order_delivered_carrier_date"))      AS "packing_time_hours"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"  oi
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES."ORDERS"       o
      ON oi."order_id" = o."order_id"
WHERE o."order_delivered_carrier_date" <> ''
LIMIT 20;
```

```sql
--Description: Join reviews to orders so we can later aggregate the average review score per seller.  
SELECT 
    r."order_id",
    r."review_score",
    o."customer_id"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_REVIEWS" r
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES."ORDERS"        o
      ON r."order_id" = o."order_id"
LIMIT 20;
```

```sql
--Description: Link products sold by each seller with their Portuguese category name.  
SELECT DISTINCT 
    oi."seller_id",
    p."product_id",
    p."product_category_name"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES."PRODUCTS"    p
      ON oi."product_id" = p."product_id"
LIMIT 20;
```

```sql
--Description: Translate Portuguese product category names to English.  
SELECT DISTINCT
    p."product_category_name",
    t."product_category_name_english"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES."PRODUCTS"                         p
LEFT JOIN ELECTRONIC_SALES.ELECTRONIC_SALES."PRODUCT_CATEGORY_NAME_TRANSLATION" t
       ON p."product_category_name" = t."product_category_name"
LIMIT 20;
```

```sql
--Description: Identify the top-selling (by quantity) English product categories across all sellers.  
SELECT 
    t."product_category_name_english"                       AS "category_en",
    COUNT(*)                                                AS "items_sold"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"                       oi
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES."PRODUCTS"                          p
      ON oi."product_id" = p."product_id"
LEFT JOIN ELECTRONIC_SALES.ELECTRONIC_SALES."PRODUCT_CATEGORY_NAME_TRANSLATION" t
      ON p."product_category_name" = t."product_category_name"
GROUP BY t."product_category_name_english"
ORDER BY "items_sold" DESC
LIMIT 20;
```

```sql
--Description: Aggregate total quantity, total sales value and average item price for each seller.  
SELECT 
    oi."seller_id",
    COUNT(*)                           AS "qty_sold",
    SUM(oi."price")                    AS "total_sales_value",
    AVG(oi."price")                    AS "avg_item_price"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
ORDER BY "total_sales_value" DESC
LIMIT 20;
```

```sql
--Description: Final performance report – sellers with >100 items sold, combining sales, reviews, and packing time, plus their best-selling English category.  
WITH seller_sales AS (
    SELECT
        oi."seller_id",
        COUNT(*)                         AS "qty_sold",
        SUM(oi."price")                  AS "total_sales_value",
        AVG(oi."price")                  AS "avg_item_price"
    FROM ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
    GROUP BY oi."seller_id"
    HAVING COUNT(*) > 100
),
seller_reviews AS (
    SELECT
        oi."seller_id",
        AVG(r."review_score")            AS "avg_review_score"
    FROM ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"   oi
    JOIN ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_REVIEWS" r
          ON oi."order_id" = r."order_id"
    GROUP BY oi."seller_id"
),
seller_packing AS (
    SELECT
        oi."seller_id",
        AVG(
            DATEDIFF('hour',
                     TO_TIMESTAMP(o."order_approved_at"),
                     TO_TIMESTAMP(o."order_delivered_carrier_date"))
        )                                AS "avg_packing_hours"
    FROM ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
    JOIN ELECTRONIC_SALES.ELECTRONIC_SALES."ORDERS"      o
          ON oi."order_id" = o."order_id"
    WHERE o."order_delivered_carrier_date" <> ''
    GROUP BY oi."seller_id"
),
seller_top_cat AS (
    SELECT
        oi."seller_id",
        t."product_category_name_english",
        COUNT(*)                                       AS "cat_qty"
    FROM ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"                       oi
    JOIN ELECTRONIC_SALES.ELECTRONIC_SALES."PRODUCTS"                          p
          ON oi."product_id" = p."product_id"
    LEFT JOIN ELECTRONIC_SALES.ELECTRONIC_SALES."PRODUCT_CATEGORY_NAME_TRANSLATION" t
          ON p."product_category_name" = t."product_category_name"
    GROUP BY oi."seller_id", t."product_category_name_english"
    QUALIFY ROW_NUMBER() OVER (PARTITION BY oi."seller_id" 
                               ORDER BY "cat_qty" DESC) = 1
)
SELECT
    ss."seller_id",
    ss."qty_sold",
    ss."total_sales_value",
    ss."avg_item_price",
    sr."avg_review_score",
    sp."avg_packing_hours",
    stc."product_category_name_english" AS "top_category_en"
FROM seller_sales    ss
LEFT JOIN seller_reviews  sr  ON ss."seller_id" = sr."seller_id"
LEFT JOIN seller_packing  sp  ON ss."seller_id" = sp."seller_id"
LEFT JOIN seller_top_cat  stc ON ss."seller_id" = stc."seller_id"
ORDER BY ss."total_sales_value" DESC
LIMIT 20;
```
