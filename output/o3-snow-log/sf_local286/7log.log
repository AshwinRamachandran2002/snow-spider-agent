--Description / Thinking process:
-- Goal: average packing time (approval → shipping-limit) for sellers with >100 items sold.
-- Issue to avoid: empty strings in date columns cause 22007 errors when cast to TIMESTAMP.
-- Solution steps
--   1. Use TRY_TO_TIMESTAMP() so invalid/blank strings return NULL instead of error.
--   2. Filter out rows where either timestamp is NULL.
--   3. Compute DATEDIFF in days for each remaining order-item.
--   4. Aggregate by seller_id, keeping only those with COUNT(*) > 100.
--   5. Order by fastest average packing time.
SELECT
    oi."seller_id",
    AVG(
        DATEDIFF(
            'day',
            TRY_TO_TIMESTAMP(o."order_approved_at"),
            TRY_TO_TIMESTAMP(oi."shipping_limit_date")
        )
    ) AS "avg_packing_days",
    COUNT(*) AS "items_sold"
FROM "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDER_ITEMS"  oi
JOIN "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDERS"       o
      ON oi."order_id" = o."order_id"
WHERE TRY_TO_TIMESTAMP(o."order_approved_at")    IS NOT NULL
  AND TRY_TO_TIMESTAMP(oi."shipping_limit_date") IS NOT NULL
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
ORDER BY "avg_packing_days"
LIMIT 20;
