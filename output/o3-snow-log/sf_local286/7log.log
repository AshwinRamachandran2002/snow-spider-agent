```sql
--Description: Identify sellers that have sold more than 100 items (volume check)
SELECT
    "seller_id",
    COUNT(*)                            AS "items_sold"
FROM "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDER_ITEMS"
GROUP BY "seller_id"
HAVING COUNT(*) > 100
ORDER BY "items_sold" DESC
LIMIT 20;
```

```sql
--Description: For high-volume sellers, view total sales amount and average item price
SELECT
    oi."seller_id",
    SUM(oi."price")                    AS "total_sales_value",
    AVG(oi."price")                    AS "avg_item_price",
    COUNT(*)                           AS "items_sold"
FROM "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDER_ITEMS"   oi
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
ORDER BY "total_sales_value" DESC
LIMIT 20;
```

```sql
--Description: Examine packing/handling time per order (approved → shipping deadline) for one seller sample
SELECT
    oi."seller_id",
    oi."order_id",
    o."order_approved_at",
    oi."shipping_limit_date",
    DATEDIFF('day', TO_TIMESTAMP(o."order_approved_at"), TO_TIMESTAMP(oi."shipping_limit_date")) AS "packing_days"
FROM "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDER_ITEMS"   oi
JOIN "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDERS"        o
      ON oi."order_id" = o."order_id"
WHERE oi."seller_id" IN (
        SELECT "seller_id"
        FROM "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDER_ITEMS"
        GROUP BY "seller_id"
        HAVING COUNT(*) > 100
)
LIMIT 20;
```

```sql
--Description: Average packing time per high-volume seller
SELECT
    oi."seller_id",
    AVG(
        DATEDIFF('day',
                 TO_TIMESTAMP(o."order_approved_at"),
                 TO_TIMESTAMP(oi."shipping_limit_date"))
       )                                         AS "avg_packing_days",
    COUNT(*)                                     AS "items_sold"
FROM "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDER_ITEMS"   oi
JOIN "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDERS"        o
      ON oi."order_id" = o."order_id"
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
ORDER BY "avg_packing_days"
LIMIT 20;
```

```sql
--Description: Link customer review scores back to sellers to gauge service quality
SELECT
    oi."seller_id",
    AVG(orv."review_score")                      AS "avg_review_score",
    COUNT(orv."review_id")                       AS "review_count"
FROM "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDER_ITEMS"   oi
JOIN "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDER_REVIEWS" orv
      ON oi."order_id" = orv."order_id"
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
ORDER BY "avg_review_score" DESC
