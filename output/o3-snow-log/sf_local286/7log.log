```sql
--Description: Consolidated seller-performance dashboard (sales, avg price, reviews, and **fixed** packing-time calculation)
SELECT
    s."seller_id",
    s."seller_city",
    s."seller_state",
    perf."items_sold",
    perf."total_sales_value",
    perf."avg_item_price",
    revs."avg_review_score",
    pack."avg_packing_days"
FROM "ELECTRONIC_SALES"."ELECTRONIC_SALES"."SELLERS"  s
JOIN (
        /* sales-volume & pricing for high-volume sellers */
        SELECT
            "seller_id",
            COUNT(*)        AS "items_sold",
            SUM("price")    AS "total_sales_value",
            AVG("price")    AS "avg_item_price"
        FROM "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDER_ITEMS"
        GROUP BY "seller_id"
        HAVING COUNT(*) > 100
     ) perf
  ON s."seller_id" = perf."seller_id"
LEFT JOIN (
        /* average review score per seller */
        SELECT
            oi."seller_id",
            AVG(orv."review_score") AS "avg_review_score"
        FROM "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDER_ITEMS"   oi
        JOIN "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDER_REVIEWS" orv
              ON oi."order_id" = orv."order_id"
        GROUP BY oi."seller_id"
     ) revs
  ON s."seller_id" = revs."seller_id"
LEFT JOIN (
        /* FIXED: packing-time metric that skips malformed/blank timestamps */
        SELECT
            oi."seller_id",
            AVG(
                DATEDIFF(
                    'day',
                    TRY_TO_TIMESTAMP(o."order_approved_at"),
                    TRY_TO_TIMESTAMP(oi."shipping_limit_date")
                )
            ) AS "avg_packing_days"
        FROM "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDER_ITEMS" oi
        JOIN "ELECTRONIC_SALES"."ELECTRONIC_SALES"."ORDERS"      o
          ON oi."order_id" = o."order_id"
        WHERE TRY_TO_TIMESTAMP(o."order_approved_at")    IS NOT NULL
          AND TRY_TO_TIMESTAMP(oi."shipping_limit_date") IS NOT NULL
        GROUP BY oi."seller_id"
     ) pack
  ON s."seller_id" = pack."seller_id"
ORDER BY perf."total_sales_value" DESC
LIMIT 20;
