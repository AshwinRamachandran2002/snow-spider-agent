```sql
--Description: Retrieve a sample of distinct sellers with their basic location information.
SELECT DISTINCT 
       "seller_id",
       "seller_city",
       "seller_state",
       "seller_zip_code_prefix"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.SELLERS
LIMIT 20;
```

```sql
--Description: List distinct seller_ids that have at least one sold product in ORDER_ITEMS.
SELECT DISTINCT 
       "seller_id"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS
LIMIT 20;
```

```sql
--Description: Calculate number of items sold and total sales value per seller.
SELECT 
       "seller_id",
       COUNT(*) AS "items_sold",
       SUM("price") AS "total_sales_value"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS
GROUP BY "seller_id"
ORDER BY "items_sold" DESC
LIMIT 20;
```

```sql
--Description: Show sellers who sold more than 100 items along with their city/state.
SELECT 
       oi."seller_id",
       s."seller_city",
       s."seller_state",
       COUNT(*) AS "items_sold",
       SUM(oi."price") AS "total_sales_value"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.SELLERS s
  ON oi."seller_id" = s."seller_id"
GROUP BY oi."seller_id", s."seller_city", s."seller_state"
HAVING COUNT(*) > 100
ORDER BY "items_sold" DESC
LIMIT 20;
```

```sql
--Description: Compute average item price for high-volume sellers (more than 100 items sold).
SELECT 
       oi."seller_id",
       AVG(oi."price") AS "avg_item_price"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
ORDER BY "avg_item_price" DESC
LIMIT 20;
```

```sql
--Description: Calculate average review score for each high-volume seller.
SELECT 
       oi."seller_id",
       AVG(orv."review_score") AS "avg_review_score",
       COUNT(orv."review_score") AS "review_count"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_REVIEWS orv
  ON oi."order_id" = orv."order_id"
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
ORDER BY "avg_review_score" DESC
LIMIT 20;
```

```sql
--Description: Estimate average packing time (hours from order approval to shipping limit) for each seller with >100 items.
SELECT 
       oi."seller_id",
       AVG(DATEDIFF('hour', TRY_TO_TIMESTAMP(o."order_approved_at"), TRY_TO_TIMESTAMP(oi."shipping_limit_date"))) AS "avg_packing_time_hours"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDERS o
  ON oi."order_id" = o."order_id"
WHERE o."order_approved_at" <> ''
  AND oi."shipping_limit_date" <> ''
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
ORDER BY "avg_packing_time_hours" ASC
LIMIT 20;
```

```sql
--Description: Identify product categories in English with highest sales volume.
SELECT 
       pct."product_category_name_english",
       COUNT(*) AS "total_items_sold"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCTS p
  ON oi."product_id" = p."product_id"
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCT_CATEGORY_NAME_TRANSLATION pct
  ON p."product_category_name" = pct."product_category_name"
GROUP BY pct."product_category_name_english"
ORDER BY "total_items_sold" DESC
LIMIT 20;
```

```sql
--Description: For each high-volume seller, show their top-selling English product category.
SELECT 
       t."seller_id",
       t."product_category_name_english",
       t."items_sold"
FROM (
      SELECT 
             oi."seller_id",
             pct."product_category_name_english",
             COUNT(*) AS "items_sold",
             ROW_NUMBER() OVER (PARTITION BY oi."seller_id" ORDER BY COUNT(*) DESC) AS rn
      FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
      JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCTS p
        ON oi."product_id" = p."product_id"
      JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCT_CATEGORY_NAME_TRANSLATION pct
        ON p."product_category_name" = pct."product_category_name"
      GROUP BY oi."seller_id", pct."product_category_name_english"
     ) t
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Final consolidated view bringing together sales, average price, review score and packing time for sellers with more than 100 items sold.
SELECT 
       perf."seller_id",
       s."seller_city",
       s."seller_state",
       perf."items_sold",
       perf."total_sales_value",
       perf."avg_item_price",
       rev."avg_review_score",
       pack."avg_packing_time_hours"
FROM (
      SELECT 
             "seller_id",
             COUNT(*) AS "items_sold",
             SUM("price") AS "total_sales_value",
             AVG("price") AS "avg_item_price"
      FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS
      GROUP BY "seller_id"
      HAVING COUNT(*) > 100
     ) perf
LEFT JOIN (
      SELECT 
             oi."seller_id",
             AVG(orv."review_score") AS "avg_review_score"
      FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
      JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_REVIEWS orv
        ON oi."order_id" = orv."order_id"
      GROUP BY oi."seller_id"
     ) rev
  ON perf."seller_id" = rev."seller_id"
LEFT JOIN (
      SELECT 
             oi."seller_id",
             AVG(DATEDIFF('hour', TRY_TO_TIMESTAMP(o."order_approved_at"), TRY_TO_TIMESTAMP(oi."shipping_limit_date"))) AS "avg_packing_time_hours"
      FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
      JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDERS o
        ON oi."order_id" = o."order_id"
      WHERE o."order_approved_at" <> ''
        AND oi."shipping_limit_date" <> ''
      GROUP BY oi."seller_id"
     ) pack
  ON perf."seller_id" = pack."seller_id"
LEFT JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.SELLERS s
  ON perf."seller_id" = s."seller_id"
ORDER BY perf."items_sold" DESC
LIMIT 20;
```
