Query:
--Description: For each high-volume seller, show their top-selling English product category.
SELECT 
       t."seller_id",
       t."product_category_name_english",
       t."items_sold"
FROM (
      SELECT 
             oi."seller_id",
             pct."product_category_name_english",
             COUNT(*) AS "items_sold",
             ROW_NUMBER() OVER (PARTITION BY oi."seller_id" ORDER BY COUNT(*) DESC) AS rn
      FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
      JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCTS p
        ON oi."product_id" = p."product_id"
      JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCT_CATEGORY_NAME_TRANSLATION pct
        ON p."product_category_name" = pct."product_category_name"
      GROUP BY oi."seller_id", pct."product_category_name_english"
     ) t
WHERE rn = 1
LIMIT 20;
