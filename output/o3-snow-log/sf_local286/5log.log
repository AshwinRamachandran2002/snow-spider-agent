Successfully executed. SQL:
--Description: 10) Assemble a consolidated performance snapshot for high–volume sellers (>100 items).
SELECT 
       hi."seller_id",
       hi."total_items_sold",
       ts."total_sales_value",
       ap."avg_item_price",
       rv."avg_review_score"
FROM  (
        SELECT oi."seller_id",
               COUNT(*) AS "total_items_sold"
        FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
        GROUP  BY oi."seller_id"
        HAVING COUNT(*) > 100
      ) hi
LEFT JOIN (
        SELECT oi."seller_id",
               SUM(oi."price") AS "total_sales_value"
        FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
        GROUP  BY oi."seller_id"
      ) ts  ON hi."seller_id" = ts."seller_id"
LEFT JOIN (
        SELECT oi."seller_id",
               AVG(oi."price") AS "avg_item_price"
        FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
        GROUP  BY oi."seller_id"
      ) ap  ON hi."seller_id" = ap."seller_id"
LEFT JOIN (
        SELECT oi."seller_id",
               AVG(orv."review_score") AS "avg_review_score"
        FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"   oi
        JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_REVIEWS" orv
               ON oi."order_id" = orv."order_id"
        GROUP  BY oi."seller_id"
      ) rv  ON hi."seller_id" = rv."seller_id"
ORDER  BY hi."total_items_sold" DESC
LIMIT 20;
