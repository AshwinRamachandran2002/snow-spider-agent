```sql
--Description: 1) Inspect basic information about every seller (city & state).
SELECT DISTINCT 
       s."seller_id",
       s."seller_city",
       s."seller_state"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."SELLERS" s
LIMIT 20;
```

```sql
--Description: 2) View raw sales lines linking each order item to its seller.
SELECT 
       oi."order_id",
       oi."product_id",
       oi."price",
       oi."seller_id",
       oi."order_item_id"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
LIMIT 20;
```

```sql
--Description: 3) Calculate the total number of items each seller has ever shipped.
SELECT 
       oi."seller_id",
       COUNT(*)            AS "total_items_sold"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
GROUP  BY oi."seller_id"
ORDER  BY "total_items_sold" DESC
LIMIT 20;
```

```sql
--Description: 4) Focus on high–volume sellers (more than 100 items sold).
SELECT 
       t."seller_id",
       t."total_items_sold"
FROM  (
        SELECT oi."seller_id",
               COUNT(*) AS "total_items_sold"
        FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
        GROUP  BY oi."seller_id"
      ) t
WHERE  t."total_items_sold" > 100
ORDER  BY t."total_items_sold" DESC
LIMIT 20;
```

```sql
--Description: 5) Compute total revenue generated by every seller.
SELECT 
       oi."seller_id",
       SUM(oi."price")    AS "total_sales_value"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
GROUP  BY oi."seller_id"
ORDER  BY "total_sales_value" DESC
LIMIT 20;
```

```sql
--Description: 6) Retrieve the average item price for each seller (unit revenue).
SELECT 
       oi."seller_id",
       AVG(oi."price")    AS "avg_item_price"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
GROUP  BY oi."seller_id"
ORDER  BY "avg_item_price" DESC
LIMIT 20;
```

```sql
--Description: 7) Derive average review score per seller by joining order reviews.
SELECT 
       oi."seller_id",
       AVG(orv."review_score") AS "avg_review_score",
       COUNT(*)                AS "review_count"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"      oi
JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_REVIEWS"    orv
       ON oi."order_id" = orv."order_id"
GROUP  BY oi."seller_id"
ORDER  BY "avg_review_score" DESC
LIMIT 20;
```

```sql
--Description: 8) Collect dates needed to study packing time (approval → shipped).
SELECT 
       oi."seller_id",
       o."order_id",
       o."order_approved_at",
       oi."shipping_limit_date"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDERS"      o
       ON oi."order_id" = o."order_id"
LIMIT 20;
```

```sql
--Description: 9) Identify product categories (English) with the largest sales volumes.
SELECT 
       pct."product_category_name_english",
       COUNT(*)                      AS "items_sold"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"                   oi
JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."PRODUCTS"                      p
       ON oi."product_id" = p."product_id"
JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."PRODUCT_CATEGORY_NAME_TRANSLATION" pct
       ON p."product_category_name" = pct."product_category_name"
GROUP  BY pct."product_category_name_english"
ORDER  BY "items_sold" DESC
LIMIT 20;
```

```sql
--Description: 10) Assemble a consolidated performance snapshot for high–volume sellers (>100 items).
SELECT 
       hi."seller_id",
       hi."total_items_sold",
       ts."total_sales_value",
       ap."avg_item_price",
       rv."avg_review_score"
FROM  (
        SELECT oi."seller_id",
               COUNT(*) AS "total_items_sold"
        FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
        GROUP  BY oi."seller_id"
        HAVING COUNT(*) > 100
      ) hi
LEFT JOIN (
        SELECT oi."seller_id",
               SUM(oi."price") AS "total_sales_value"
        FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
        GROUP  BY oi."seller_id"
      ) ts  ON hi."seller_id" = ts."seller_id"
LEFT JOIN (
        SELECT oi."seller_id",
               AVG(oi."price") AS "avg_item_price"
        FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
        GROUP  BY oi."seller_id"
      ) ap  ON hi."seller_id" = ap."seller_id"
LEFT JOIN (
        SELECT oi."seller_id",
               AVG(orv."review_score") AS "avg_review_score"
        FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"   oi
        JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_REVIEWS" orv
               ON oi."order_id" = orv."order_id"
        GROUP  BY oi."seller_id"
      ) rv  ON hi."seller_id" = rv."seller_id"
ORDER  BY hi."total_items_sold" DESC
LIMIT 20;
```
