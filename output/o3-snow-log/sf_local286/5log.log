Query:
--Description: 4) Focus on high–volume sellers (more than 100 items sold).
SELECT 
       t."seller_id",
       t."total_items_sold"
FROM  (
        SELECT oi."seller_id",
               COUNT(*) AS "total_items_sold"
        FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
        GROUP  BY oi."seller_id"
      ) t
WHERE  t."total_items_sold" > 100
ORDER  BY t."total_items_sold" DESC
LIMIT 20;
