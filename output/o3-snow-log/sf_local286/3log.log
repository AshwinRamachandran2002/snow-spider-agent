```sql
--Description: Quick look at sellers’ basic geographical information  
SELECT DISTINCT 
       "seller_id",
       "seller_city",
       "seller_state",
       "seller_zip_code_prefix"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."SELLERS"
LIMIT  20;
```

```sql
--Description: Preview of order-item lines to understand how each sale is registered for every seller  
SELECT 
       "order_id",
       "seller_id",
       "product_id",
       "order_item_id",
       "price",
       "freight_value"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"
LIMIT  20;
```

```sql
--Description: Count the total quantity of items each seller has already shipped (item > 100 filter kept for later)  
SELECT 
       "seller_id",
       COUNT(*)        AS "items_sold"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"
GROUP  BY "seller_id"
ORDER  BY "items_sold" DESC
LIMIT  20;
```

```sql
--Description: Locate sellers with more than 100 items shipped (early shortlist)  
SELECT 
       "seller_id",
       COUNT(*) AS "items_sold"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"
GROUP  BY "seller_id"
HAVING COUNT(*) > 100
ORDER  BY "items_sold" DESC
LIMIT  20;
```

```sql
--Description: Compute total sales amount and average item price for each high-volume seller (>100 items)  
SELECT 
       oi."seller_id",
       COUNT(*)                       AS "items_sold",
       SUM(oi."price")                AS "total_sales_value",
       AVG(oi."price")                AS "avg_item_price"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"  oi
GROUP  BY oi."seller_id"
HAVING COUNT(*) > 100
ORDER  BY "total_sales_value" DESC
LIMIT  20;
```

```sql
--Description: Join reviews with sellers to monitor average review score (only delivered orders)  
SELECT 
       oi."seller_id",
       AVG(orv."review_score") AS "avg_review_score",
       COUNT(*)                AS "review_count"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"   oi
JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_REVIEWS" orv
       ON oi."order_id" = orv."order_id"
GROUP  BY oi."seller_id"
HAVING COUNT(*) > 0
ORDER  BY "avg_review_score" DESC
LIMIT  20;
```

```sql
--Description: Preview timestamps needed for packing-time estimation (approved → shipping limit)  
SELECT 
       o."order_id",
       o."order_approved_at",
       oi."shipping_limit_date"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDERS"       o
JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"  oi
       ON o."order_id" = oi."order_id"
LIMIT  20;
```

```sql
--Description: Link products sold by each seller to their Portuguese category names  
SELECT 
       oi."seller_id",
       pr."product_category_name",
       COUNT(*) AS "items_in_category"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."PRODUCTS"    pr
       ON oi."product_id" = pr."product_id"
GROUP  BY oi."seller_id", pr."product_category_name"
ORDER  BY "items_in_category" DESC
LIMIT  20;
```

```sql
--Description: Highlight top selling categories (in English) among high-volume sellers (>100 items)  
SELECT 
       pct."product_category_name_english",
       SUM(cnt."items_in_category") AS "total_items_sold"
FROM  (
        SELECT 
               pr."product_category_name",
               COUNT(*) AS "items_in_category"
        FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS" oi
        JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."PRODUCTS"    pr
               ON oi."product_id" = pr."product_id"
        GROUP  BY pr."product_category_name"
      ) cnt
JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."PRODUCT_CATEGORY_NAME_TRANSLATION" pct
       ON cnt."product_category_name" = pct."product_category_name"
GROUP  BY pct."product_category_name_english"
ORDER  BY "total_items_sold" DESC
LIMIT  20;
```

```sql
--Description: Consolidated view – total sales, average price, average review score & sample packing time (hrs) for sellers with >100 items  
SELECT 
       s_sum."seller_id",
       s_sum."items_sold",
       s_sum."total_sales_value",
       s_sum."avg_item_price",
       rv."avg_review_score",
       rv."review_count",
       AVG(DATEDIFF('hour', o."order_approved_at", oi."shipping_limit_date")) AS "avg_packing_time_hrs"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"  oi
JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDERS"       o   ON oi."order_id"  = o."order_id"
JOIN  (SELECT 
              "seller_id",
              COUNT(*)        AS "items_sold",
              SUM("price")    AS "total_sales_value",
              AVG("price")    AS "avg_item_price"
       FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"
       GROUP  BY "seller_id"
       HAVING COUNT(*) > 100)                            s_sum
       ON oi."seller_id" = s_sum."seller_id"
LEFT JOIN
      (SELECT 
              oi2."seller_id",
              AVG(orv."review_score") AS "avg_review_score",
              COUNT(*)                AS "review_count"
       FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"   oi2
       JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_REVIEWS" orv
              ON oi2."order_id" = orv."order_id"
       GROUP  BY oi2."seller_id")                        rv
       ON s_sum."seller_id" = rv."seller_id"
GROUP  BY s_sum."seller_id",
          s_sum."items_sold",
          s_sum."total_sales_value",
          s_sum."avg_item_price",
          rv."avg_review_score",
          rv."review_count"
ORDER  BY s_sum."total_sales_value" DESC
LIMIT  20;
```
