```sql
--Description / Thinking process:
--We need a single consolidated report on high-volume sellers (sold >100 items) showing:
--  • items_sold, total_sales_value, avg_item_price
--  • avg_review_score, review_count
--  • avg_packing_time_hrs  (time from order_approved_at → shipping_limit_date)
--Issue previously: empty-string timestamps caused 22007 error.  Solution:
--  • Filter out rows where either timestamp field is NULL or ''.
--  • Wrap each timestamp with TRY_TO_TIMESTAMP so DATEDIFF skips unparsable strings (returns NULL).
--Query steps:
-- 1) s_sum   : aggregate ORDER_ITEMS per seller, keep only sellers with COUNT(*) > 100.
-- 2) rv      : aggregate review stats per seller.
-- 3) main    : join ORDER_ITEMS ↔ ORDERS to compute packing time; merge with s_sum & rv.
-- 4) group by seller and order by highest total_sales_value; limit 20 rows.

SELECT
       s_sum."seller_id",
       s_sum."items_sold",
       s_sum."total_sales_value",
       s_sum."avg_item_price",
       rv."avg_review_score",
       rv."review_count",
       AVG(
            DATEDIFF(
                      'hour',
                      TRY_TO_TIMESTAMP(o."order_approved_at"),
                      TRY_TO_TIMESTAMP(oi."shipping_limit_date")
                    )
          )                                   AS "avg_packing_time_hrs"
FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"  oi
JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDERS"       o
       ON oi."order_id" = o."order_id"
JOIN  ( SELECT
               "seller_id",
               COUNT(*)             AS "items_sold",
               SUM("price")         AS "total_sales_value",
               AVG("price")         AS "avg_item_price"
        FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"
        GROUP  BY "seller_id"
        HAVING COUNT(*) > 100
      )                                  s_sum
       ON oi."seller_id" = s_sum."seller_id"
LEFT JOIN
      ( SELECT
               oi2."seller_id",
               AVG(orv."review_score") AS "avg_review_score",
               COUNT(*)                AS "review_count"
        FROM   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_ITEMS"   oi2
        JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES."ORDER_REVIEWS" orv
               ON oi2."order_id" = orv."order_id"
        GROUP  BY oi2."seller_id"
      )                                  rv
       ON s_sum."seller_id" = rv."seller_id"
WHERE  o."order_approved_at"   IS NOT NULL
  AND  o."order_approved_at"  <> ''
  AND  oi."shipping_limit_date" IS NOT NULL
  AND  oi."shipping_limit_date" <> ''
GROUP  BY s_sum."seller_id",
          s_sum."items_sold",
          s_sum."total_sales_value",
          s_sum."avg_item_price",
          rv."avg_review_score",
          rv."review_count"
ORDER  BY s_sum."total_sales_value" DESC
LIMIT  20;
