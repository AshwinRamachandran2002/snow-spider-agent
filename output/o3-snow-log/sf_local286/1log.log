```sql
--Description: Quick look at the basic information we keep for each seller
SELECT DISTINCT 
       "seller_id",
       "seller_city",
       "seller_state"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.SELLERS
LIMIT 20;
```

```sql
--Description: Sample of the raw order-item lines tied to each seller (price at line level)
SELECT 
       "seller_id",
       "order_id",
       "product_id",
       "price",
       "freight_value"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS
LIMIT 20;
```

```sql
--Description: First pass – quantity sold and gross sales value by seller
SELECT 
       oi."seller_id",
       COUNT(*)               AS "items_sold",
       SUM(oi."price")        AS "total_sales"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS  oi
GROUP BY oi."seller_id"
ORDER BY "items_sold" DESC
LIMIT 20;
```

```sql
--Description: Inspect the two timestamps we will use to measure packing time
SELECT 
       o."order_id",
       o."order_approved_at",
       o."order_delivered_carrier_date"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDERS  o
WHERE o."order_approved_at" <> '' 
  AND o."order_delivered_carrier_date" <> ''
LIMIT 20;
```

```sql
--Description: Derive the packing time (days between approval and hand-off to carrier) for sample orders
SELECT 
       o."order_id",
       DATEDIFF('day',
                TO_TIMESTAMP(o."order_approved_at"),
                TO_TIMESTAMP(o."order_delivered_carrier_date"))  AS "packing_days"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDERS  o
WHERE o."order_approved_at" <> '' 
  AND o."order_delivered_carrier_date" <> ''
LIMIT 20;
```

```sql
--Description: Average review score received by each seller
SELECT 
       oi."seller_id",
       AVG(r."review_score")  AS "avg_review_score"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS   oi
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_REVIEWS r
     ON oi."order_id" = r."order_id"
GROUP BY oi."seller_id"
LIMIT 20;
```

```sql
--Description: Quantity of products sold per seller & product category (Portuguese names)
SELECT 
       oi."seller_id",
       p."product_category_name",
       COUNT(*)               AS "qty"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCTS     p
     ON oi."product_id" = p."product_id"
GROUP BY oi."seller_id", p."product_category_name"
ORDER BY "qty" DESC
LIMIT 20;
```

```sql
--Description: Link Portuguese category to its English translation
SELECT 
       p."product_category_name",
       t."product_category_name_english"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCTS                           p
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCT_CATEGORY_NAME_TRANSLATION t
     ON p."product_category_name" = t."product_category_name"
LIMIT 20;
```

```sql
--Description: Identify only those sellers that have sold more than 100 items
SELECT 
       s."seller_id",
       agg."items_sold"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.SELLERS s
JOIN (
       SELECT 
              oi."seller_id",
              COUNT(*) AS "items_sold"
       FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
       GROUP BY oi."seller_id"
       HAVING COUNT(*) > 100
     ) agg
  ON s."seller_id" = agg."seller_id"
LIMIT 20;
```

```sql
--Description: Comprehensive seller-performance snapshot (sales, avg price, reviews, packing time, and top English category); only sellers with >100 items appear
SELECT 
       agg."seller_id",
       agg."items_sold",
       agg."total_sales",
       ROUND(agg."total_sales" / agg."items_sold", 2)                     AS "avg_item_price",
       rev."avg_review_score",
       pack."avg_packing_days",
       cat."top_category_english"
FROM (
        /* total quantity & sales */
        SELECT 
               oi."seller_id",
               COUNT(*)           AS "items_sold",
               SUM(oi."price")    AS "total_sales"
        FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
        GROUP BY oi."seller_id"
        HAVING COUNT(*) > 100
     ) agg
LEFT JOIN (
        /* average review score */
        SELECT 
               oi."seller_id",
               AVG(r."review_score") AS "avg_review_score"
        FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS   oi
        JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_REVIEWS r
              ON oi."order_id" = r."order_id"
        GROUP BY oi."seller_id"
     ) rev
  ON agg."seller_id" = rev."seller_id"
LEFT JOIN (
        /* average packing days */
        SELECT 
               oi."seller_id",
               AVG(DATEDIFF('day',
                            TO_TIMESTAMP(o."order_approved_at"),
                            TO_TIMESTAMP(o."order_delivered_carrier_date"))) AS "avg_packing_days"
        FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
        JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDERS      o
              ON oi."order_id" = o."order_id"
        WHERE o."order_approved_at" <> '' 
          AND o."order_delivered_carrier_date" <> ''
        GROUP BY oi."seller_id"
     ) pack
  ON agg."seller_id" = pack."seller_id"
LEFT JOIN (
        /* top-selling English category per seller */
        SELECT 
               sub."seller_id",
               FIRST_VALUE(t."product_category_name_english") 
               OVER (PARTITION BY sub."seller_id" ORDER BY sub."qty" DESC) AS "top_category_english"
        FROM (
               SELECT 
                      oi."seller_id",
                      p."product_category_name",
                      COUNT(*) AS "qty"
               FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
               JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCTS     p
                     ON oi."product_id" = p."product_id"
               GROUP BY oi."seller_id", p."product_category_name"
             ) sub
        JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCT_CATEGORY_NAME_TRANSLATION t
              ON sub."product_category_name" = t."product_category_name"
     ) cat
  ON agg."seller_id" = cat."seller_id"
ORDER BY agg."total_sales" DESC
LIMIT 20;
```
