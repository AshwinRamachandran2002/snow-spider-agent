--Description: Comprehensive seller-performance snapshot (sales, avg price, reviews, packing time, and top English category); only sellers with >100 items appear
SELECT 
       agg."seller_id",
       agg."items_sold",
       agg."total_sales",
       ROUND(agg."total_sales" / agg."items_sold", 2)                     AS "avg_item_price",
       rev."avg_review_score",
       pack."avg_packing_days",
       cat."top_category_english"
FROM (
        /* total quantity & sales */
        SELECT 
               oi."seller_id",
               COUNT(*)           AS "items_sold",
               SUM(oi."price")    AS "total_sales"
        FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
        GROUP BY oi."seller_id"
        HAVING COUNT(*) > 100
     ) agg
LEFT JOIN (
        /* average review score */
