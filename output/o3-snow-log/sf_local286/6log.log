                   TRY_TO_TIMESTAMP(NULLIF(o."order_approved_at", '')),
                   TRY_TO_TIMESTAMP(NULLIF(o."order_delivered_carrier_date", ''))
               )
           )                                AS "avg_packing_days"
    FROM   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDERS      o
    JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
           ON o."order_id" = oi."order_id"
    WHERE  TRY_TO_TIMESTAMP(NULLIF(o."order_approved_at", ''))            IS NOT NULL
