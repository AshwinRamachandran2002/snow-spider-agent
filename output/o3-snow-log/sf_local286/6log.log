--Description: Final comprehensive report combining seller performance metrics (volume, sales, average price, review score, average packing days) and each seller’s top-selling English product category.  Blank timestamp strings are neutralised with NULLIF and parsed via TRY_TO_TIMESTAMP to avoid errors.
WITH seller_sales AS (                    -- high-volume sellers and monetary metrics
     SELECT oi."seller_id",
            COUNT(*)                        AS "items_sold",
            SUM(oi."price")                 AS "total_sales_value",
            AVG(oi."price")                 AS "avg_item_price"
     FROM   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
     GROUP  BY oi."seller_id"
     HAVING COUNT(*) > 100
),
seller_reviews AS (                       -- average review score
     SELECT oi."seller_id",
            AVG(r."review_score")          AS "avg_review_score"
     FROM   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_REVIEWS r
     JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS  oi
            ON r."order_id" = oi."order_id"
     GROUP  BY oi."seller_id"
),
seller_packing AS (                       -- average packing time in days (approval → carrier)
     SELECT oi."seller_id",
            AVG( DATEDIFF(
                     'day',
                     TRY_TO_TIMESTAMP(NULLIF(o."order_approved_at", '')),
                     TRY_TO_TIMESTAMP(NULLIF(o."order_delivered_carrier_date", ''))
                 ) )                       AS "avg_packing_days"
     FROM   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDERS      o
     JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
            ON o."order_id" = oi."order_id"
     WHERE  TRY_TO_TIMESTAMP(NULLIF(o."order_approved_at", ''))            IS NOT NULL
       AND  TRY_TO_TIMESTAMP(NULLIF(o."order_delivered_carrier_date", '')) IS NOT NULL
     GROUP  BY oi."seller_id"
),
seller_category AS (                      -- items sold by category per seller
     SELECT oi."seller_id",
            pct."product_category_name_english" AS "category_en",
            COUNT(*)                             AS "category_items"
     FROM   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS                      oi
     JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCTS                         p   ON oi."product_id" = p."product_id"
     JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCT_CATEGORY_NAME_TRANSLATION pct ON p."product_category_name" = pct."product_category_name"
     GROUP  BY oi."seller_id", pct."product_category_name_english"
),
seller_top_category AS (                  -- the top-selling category for each seller
     SELECT sc."seller_id",
            sc."category_en"
     FROM (
          SELECT sc."seller_id",
                 sc."category_en",
                 sc."category_items",
                 ROW_NUMBER() OVER (PARTITION BY sc."seller_id"
                                    ORDER BY sc."category_items" DESC) AS rn
          FROM  seller_category sc
     )
     WHERE rn = 1
)
SELECT ss."seller_id",
       ss."items_sold",
       ss."total_sales_value",
       ss."avg_item_price",
       sr."avg_review_score",
       sp."avg_packing_days",
       stc."category_en"                   AS "top_category_en"
FROM   seller_sales        ss
LEFT  JOIN seller_reviews  sr  ON ss."seller_id" = sr."seller_id"
LEFT  JOIN seller_packing  sp  ON ss."seller_id" = sp."seller_id"
LEFT  JOIN seller_top_category stc ON ss."seller_id" = stc."seller_id"
LIMIT 20;
