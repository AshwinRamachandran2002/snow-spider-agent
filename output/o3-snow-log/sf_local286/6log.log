--Description: Sample packing time (in days) for orders linked back to the seller.
SELECT oi."seller_id",
       o."order_id",
       o."order_approved_at",
       o."order_delivered_carrier_date",
       DATEDIFF('day',
                TO_TIMESTAMP(o."order_approved_at"),
                TO_TIMESTAMP(o."order_delivered_carrier_date")) AS "packing_days"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDERS      o
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
  ON o."order_id" = oi."order_id"
WHERE o."order_delivered_carrier_date" IS NOT NULL
LIMIT 20;
