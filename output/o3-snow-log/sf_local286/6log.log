```sql
--Description / Thinking Process:
-- We need a single statement that delivers consolidated performance metrics for sellers who sold
-- more than 100 products.  Metrics required:
--   • items_sold, total_sales_value, avg_item_price   → from ORDER_ITEMS
--   • avg_review_score                               → from ORDER_REVIEWS joined to ORDER_ITEMS
--   • avg_packing_days (approval → carrier dispatch) → from ORDERS joined to ORDER_ITEMS
-- Key technical issue was blank strings in timestamp columns; we neutralise them with NULLIF()
-- and convert safely with TRY_TO_TIMESTAMP(), which returns NULL instead of an error
-- when the value cannot be parsed.  Only rows where both timestamps convert successfully
-- are used in packing-time calculations.
-- Finally, we LEFT JOIN the three sub-queries so that missing review or packing data doesn’t
-- exclude a high-volume seller.  LIMIT 20 keeps the output concise for inspection.

WITH seller_sales AS (                    -- monetary / volume metrics, high-volume filter
    SELECT oi."seller_id",
           COUNT(*)                        AS "items_sold",
           SUM(oi."price")                 AS "total_sales_value",
           AVG(oi."price")                 AS "avg_item_price"
    FROM   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
    GROUP  BY oi."seller_id"
    HAVING COUNT(*) > 100
),
seller_reviews AS (                        -- review score per seller
    SELECT oi."seller_id",
           AVG(r."review_score")           AS "avg_review_score"
    FROM   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_REVIEWS r
    JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS  oi
           ON r."order_id" = oi."order_id"
    GROUP  BY oi."seller_id"
),
seller_packing AS (                        -- average packing days per seller
    SELECT oi."seller_id",
           AVG( DATEDIFF(
                    'day',
                    TRY_TO_TIMESTAMP(NULLIF(o."order_approved_at", '')),
                    TRY_TO_TIMESTAMP(NULLIF(o."order_delivered_carrier_date", ''))
                ) )                        AS "avg_packing_days"
    FROM   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDERS      o
    JOIN   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
           ON o."order_id" = oi."order_id"
    WHERE  TRY_TO_TIMESTAMP(NULLIF(o."order_approved_at", ''))            IS NOT NULL
      AND  TRY_TO_TIMESTAMP(NULLIF(o."order_delivered_carrier_date", '')) IS NOT NULL
    GROUP  BY oi."seller_id"
)

SELECT ss."seller_id",
       ss."items_sold",
       ss."total_sales_value",
       ss."avg_item_price",
       sr."avg_review_score",
       sp."avg_packing_days"
FROM   seller_sales   ss
LEFT  JOIN seller_reviews sr  ON ss."seller_id" = sr."seller_id"
LEFT  JOIN seller_packing sp  ON ss."seller_id" = sp."seller_id"
LIMIT 20;
