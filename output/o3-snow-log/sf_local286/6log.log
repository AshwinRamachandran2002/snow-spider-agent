FROM ELECTRONIC_SALES.ELECTRONIC_SALES.SELLERS
LIMIT 20;
```

```sql
--Description: View a handful of sale records linking sellers to order items and prices.
SELECT oi."order_id",
       oi."product_id",
       oi."price",
       oi."freight_value",
       s."seller_id",
       s."seller_city"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS      oi
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.SELLERS          s
  ON oi."seller_id" = s."seller_id"
LIMIT 20;
```

```sql
--Description: Count of items sold per seller, showing only those above 100 units.
SELECT oi."seller_id",
       COUNT(*) AS "items_sold"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: Total revenue and average item price for high-volume sellers (>100 items).
SELECT oi."seller_id",
       SUM(oi."price") AS "total_sales_value",
       AVG(oi."price") AS "avg_item_price",
       COUNT(*)        AS "items_sold"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: Sample packing time (in days) for orders linked back to the seller.
SELECT oi."seller_id",
       o."order_id",
       o."order_approved_at",
       o."order_delivered_carrier_date",
       DATEDIFF('day',
                TO_TIMESTAMP(o."order_approved_at"),
                TO_TIMESTAMP(o."order_delivered_carrier_date")) AS "packing_days"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDERS      o
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
  ON o."order_id" = oi."order_id"
WHERE o."order_delivered_carrier_date" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Average review score calculated at seller level.
SELECT oi."seller_id",
       AVG(r."review_score") AS "avg_review_score",
       COUNT(*)             AS "review_count"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_REVIEWS r
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS  oi
  ON r."order_id" = oi."order_id"
GROUP BY oi."seller_id"
LIMIT 20;
```

```sql
--Description: Consolidated performance metrics for sellers who sold more than 100 items.
SELECT m."seller_id",
       m."items_sold",
       m."total_sales_value",
       m."avg_item_price",
       rv."avg_review_score",
       pk."avg_packing_days"
FROM (
        SELECT oi."seller_id",
               COUNT(*)        AS "items_sold",
               SUM(oi."price") AS "total_sales_value",
               AVG(oi."price") AS "avg_item_price"
        FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
        GROUP BY oi."seller_id"
        HAVING COUNT(*) > 100
     )                       m
LEFT JOIN (
        SELECT oi."seller_id",
               AVG(r."review_score") AS "avg_review_score"
        FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_REVIEWS r
        JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS  oi
          ON r."order_id" = oi."order_id"
        GROUP BY oi."seller_id"
     )                       rv  ON m."seller_id" = rv."seller_id"
LEFT JOIN (
        SELECT oi."seller_id",
               AVG(DATEDIFF('day',
                            TO_TIMESTAMP(o."order_approved_at"),
                            TO_TIMESTAMP(o."order_delivered_carrier_date"))) AS "avg_packing_days"
        FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDERS       o
        JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS  oi
          ON o."order_id" = oi."order_id"
        WHERE o."order_delivered_carrier_date" IS NOT NULL
        GROUP BY oi."seller_id"
     )                       pk  ON m."seller_id" = pk."seller_id"
LIMIT 20;
```

```sql
--Description: Total quantity sold by product category (English) among high-volume sellers.
WITH high_sellers AS (
     SELECT oi."seller_id"
     FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
     GROUP BY oi."seller_id"
     HAVING COUNT(*) > 100
)
SELECT pct."product_category_name_english" AS "category_en",
       COUNT(*)                            AS "items_sold"
FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS                     oi
JOIN high_sellers                                                         hs
  ON oi."seller_id" = hs."seller_id"
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCTS                        p
  ON oi."product_id" = p."product_id"
JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCT_CATEGORY_NAME_TRANSLATION pct
  ON p."product_category_name" = pct."product_category_name"
GROUP BY pct."product_category_name_english"
ORDER BY "items_sold" DESC
LIMIT 20;
```

```sql
--Description: Identify the single product category (English) with the highest sales volume among high-volume sellers.
WITH high_sellers AS (
     SELECT oi."seller_id"
     FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
     GROUP BY oi."seller_id"
     HAVING COUNT(*) > 100
), category_sales AS (
     SELECT pct."product_category_name_english" AS "category_en",
            COUNT(*)                            AS "items_sold"
     FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS                      oi
     JOIN high_sellers                                                          hs
       ON oi."seller_id" = hs."seller_id"
     JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCTS                         p
       ON oi."product_id" = p."product_id"
     JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCT_CATEGORY_NAME_TRANSLATION pct
       ON p."product_category_name" = pct."product_category_name"
     GROUP BY pct."product_category_name_english"
)
SELECT "category_en",
       "items_sold"
FROM category_sales
ORDER BY "items_sold" DESC
LIMIT 1;
```

```sql
--Description: Final comprehensive report combining seller performance metrics and their top-selling English product category.
WITH
 seller_sales AS (
     SELECT oi."seller_id",
            COUNT(*)        AS "items_sold",
            SUM(oi."price") AS "total_sales_value",
            AVG(oi."price") AS "avg_item_price"
     FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
     GROUP BY oi."seller_id"
     HAVING COUNT(*) > 100
 ),
 seller_reviews AS (
     SELECT oi."seller_id",
            AVG(r."review_score") AS "avg_review_score"
     FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_REVIEWS r
     JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS  oi
       ON r."order_id" = oi."order_id"
     GROUP BY oi."seller_id"
 ),
 seller_packing AS (
     SELECT oi."seller_id",
            AVG(DATEDIFF('day',
                         TO_TIMESTAMP(o."order_approved_at"),
                         TO_TIMESTAMP(o."order_delivered_carrier_date"))) AS "avg_packing_days"
     FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDERS      o
     JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
       ON o."order_id" = oi."order_id"
     WHERE o."order_delivered_carrier_date" IS NOT NULL
     GROUP BY oi."seller_id"
 ),
 seller_category AS (
     SELECT oi."seller_id",
            pct."product_category_name_english" AS "category_en",
            COUNT(*)                            AS "category_items"
     FROM ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS                      oi
     JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCTS                         p
       ON oi."product_id" = p."product_id"
     JOIN ELECTRONIC_SALES.ELECTRONIC_SALES.PRODUCT_CATEGORY_NAME_TRANSLATION pct
       ON p."product_category_name" = pct."product_category_name"
     GROUP BY oi."seller_id", pct."product_category_name_english"
 ),
 seller_top_category AS (
     SELECT sc."seller_id",
            sc."category_en"
     FROM (
           SELECT sc."seller_id",
                  sc."category_en",
                  sc."category_items",
                  ROW_NUMBER() OVER (PARTITION BY sc."seller_id"
                                     ORDER BY sc."category_items" DESC) AS rn
           FROM seller_category sc
         )
     WHERE rn = 1
 )
SELECT ss."seller_id",
       ss."items_sold",
       ss."total_sales_value",
       ss."avg_item_price",
       sr."avg_review_score",
       sp."avg_packing_days",
       stc."category_en" AS "top_category_en"
FROM seller_sales        ss
LEFT JOIN seller_reviews sr  ON ss."seller_id" = sr."seller_id"
LEFT JOIN seller_packing sp  ON ss."seller_id" = sp."seller_id"
LEFT JOIN seller_top_category stc ON ss."seller_id" = stc."seller_id"
LIMIT 20;
```
