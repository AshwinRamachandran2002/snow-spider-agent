--   2. seller_reviews CTE: average review score per seller.
--   3. seller_packing CTE: average packing days per seller; skip rows with unparsable timestamps.
--   4. seller_category CTE: count items per (seller, category_en).
--   5. seller_top_category CTE: pick category with ROW_NUMBER() = 1 for each seller.
--   6. Final SELECT LEFT-JOINs all CTEs so missing reviews/packing dates don’t exclude a seller.
--   7. LIMIT 20 for preview.

WITH seller_sales AS (
    SELECT oi."seller_id",
           COUNT(*)                        AS "items_sold",
           SUM(oi."price")                 AS "total_sales_value",
           AVG(oi."price")                 AS "avg_item_price"
    FROM   ELECTRONIC_SALES.ELECTRONIC_SALES.ORDER_ITEMS oi
