```sql
WITH sales_2022 AS (   -- all 2022 Bourbon sales in Dubuque County
    SELECT
        SPLIT_PART("zip_code", '.', 1)                  AS zip5,          -- trim the “.0”
        "sale_dollars"                                  AS sale_dollars,
        "date"
    FROM IOWA_LIQUOR_SALES_PLUS.IOWA_LIQUOR_SALES.SALES
    WHERE "date" BETWEEN '2022-01-01' AND '2022-12-31'
      AND UPPER("county") = 'DUBUQUE'
      AND "category_name" ILIKE '%BOURBON%'             -- Bourbon‐related categories
),                                                         
zip_rank AS (          -- rank ZIP codes by total 2022 Bourbon sales
    SELECT
        zip5,
        SUM(sale_dollars)                                              AS total_sales,
        DENSE_RANK() OVER (ORDER BY SUM(sale_dollars) DESC NULLS LAST) AS sales_rank
    FROM sales_2022
    GROUP BY zip5
),                                                         
third_zip AS (         -- the ZIP code that ranks third
    SELECT zip5
    FROM zip_rank
    WHERE sales_rank = 3
),                                                         
population_21plus AS ( -- population aged 21+ from 2010 census
    SELECT
        "zipcode"                      AS zip5,
        SUM("population")              AS population_21_plus
    FROM IOWA_LIQUOR_SALES_PLUS.CENSUS_BUREAU_USA.POPULATION_BY_ZIP_2010
    WHERE ("gender" IS NULL OR "gender" = '')           -- total population rows
      AND "minimum_age" IS NOT NULL
      AND "minimum_age" >= 21                           -- 21 years and older
    GROUP BY "zipcode"
),                                                         
monthly_sales AS (     -- monthly Bourbon sales in the third-ranked ZIP
    SELECT
        DATE_TRUNC('month', "date") AS month_start,
        SUM(sale_dollars)           AS monthly_sales,
        zip5
    FROM sales_2022
    WHERE zip5 IN (SELECT zip5 FROM third_zip)
    GROUP BY DATE_TRUNC('month', "date"), zip5
)                                                         
SELECT
    TO_CHAR(month_start, 'YYYY-MM')                          AS month,
    ROUND(monthly_sales / population_21_plus, 4)             AS per_capita_bourbon_sales
FROM monthly_sales
JOIN population_21plus USING (zip5)
ORDER BY month;
```
