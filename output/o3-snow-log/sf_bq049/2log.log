```sql
WITH sales_2022 AS (          -- 2022 Bourbon sales in Dubuque County
    SELECT
        REGEXP_SUBSTR("zip_code", '^[0-9]{5}')        AS zip5,      -- 5-digit ZIP
        "sale_dollars",
        "date"
    FROM IOWA_LIQUOR_SALES_PLUS.IOWA_LIQUOR_SALES.SALES
    WHERE "date" >= '2022-01-01'               -- calendar year 2022
      AND "date" <  '2023-01-01'
      AND "county" ILIKE 'DUBUQUE%'            -- Dubuque County
      AND "category_name" ILIKE '%BOURBON%'    -- Bourbon categories
      AND "bottles_sold" > 0                   -- exclude returns
      AND REGEXP_SUBSTR("zip_code", '^[0-9]{5}') IS NOT NULL
),                                                             
ranked_zip AS (              -- total Bourbon sales by ZIP
    SELECT
        zip5,
        SUM(sale_dollars) AS total_sales
    FROM sales_2022
    GROUP BY zip5
),                                                             
third_zip AS (               -- ZIP code with 3rd-highest sales
    SELECT zip5
    FROM ranked_zip
    ORDER BY total_sales DESC NULLS LAST
    LIMIT 1 OFFSET 2
),                                                             
monthly_sales AS (           -- monthly sales for that ZIP
    SELECT
        DATE_TRUNC('month', "date") AS month_start,
        SUM(sale_dollars)           AS monthly_sales,
        zip5
    FROM sales_2022
    WHERE zip5 IN (SELECT zip5 FROM third_zip)
    GROUP BY DATE_TRUNC('month', "date"), zip5
),                                                             
population_21plus AS (       -- 21+ population from 2010 census
    SELECT
        "zipcode"              AS zip5,
        SUM("population")      AS population_21_plus
    FROM IOWA_LIQUOR_SALES_PLUS.CENSUS_BUREAU_USA.POPULATION_BY_ZIP_2010
    WHERE ("gender" IS NULL OR "gender" = '')     -- total population rows
      AND "minimum_age" >= 21                     -- 21 years and older
    GROUP BY "zipcode"
)                                                             
SELECT
    TO_CHAR(month_start, 'YYYY-MM')                     AS month,
    ROUND(monthly_sales / population_21_plus, 4)        AS per_capita_bourbon_sales
FROM monthly_sales
JOIN population_21plus USING (zip5)
ORDER BY month;
```
