```sql
WITH sales_filtered AS (
    /* 1.  All 2022 Bourbon‐category sales in Dubuque County, zip parsed to 5 digits */
    SELECT
        REGEXP_SUBSTR("zip_code", '[0-9]{5}')           AS "zipcode",
        "date",
        "sale_dollars"
    FROM IOWA_LIQUOR_SALES_PLUS.IOWA_LIQUOR_SALES.SALES
    WHERE "county" = 'DUBUQUE'
      AND "date" BETWEEN '2022-01-01' AND '2022-12-31'
      AND UPPER("category_name") LIKE '%BOURBON%'
),
total_sales_by_zip AS (
    /* 2.  Total 2022 Bourbon sales dollars by zip */
    SELECT
        "zipcode",
        SUM("sale_dollars") AS "total_sales_dollars"
    FROM sales_filtered
    GROUP BY "zipcode"
),
third_zip AS (
    /* 3.  Zip code that ranks third in total Bourbon sales */
    SELECT "zipcode"
    FROM (
        SELECT
            "zipcode",
            ROW_NUMBER() OVER (ORDER BY "total_sales_dollars" DESC NULLS LAST) AS "rn"
        FROM total_sales_by_zip
    )
    WHERE "rn" = 3
),
population_21plus AS (
    /* 4.  2010 Census population aged 21+ for every zip */
    SELECT
        "zipcode",
        SUM("population") AS "population_21plus"
    FROM IOWA_LIQUOR_SALES_PLUS.CENSUS_BUREAU_USA.POPULATION_BY_ZIP_2010
    WHERE ("gender" IS NULL OR "gender" = '')
      AND "minimum_age" >= 21
    GROUP BY "zipcode"
),
monthly_sales AS (
    /* 5.  Monthly Bourbon sales dollars for the third-ranked zip */
    SELECT
        DATE_TRUNC('month', "date")                       AS "month",
        SUM("sale_dollars")                               AS "monthly_sales_dollars"
    FROM sales_filtered
    WHERE "zipcode" IN (SELECT "zipcode" FROM third_zip)
    GROUP BY DATE_TRUNC('month', "date")
)

SELECT
    TO_CHAR(m."month", 'YYYY-MM')                        AS "month",
    m."monthly_sales_dollars",
    p."population_21plus",
    ROUND(m."monthly_sales_dollars" / p."population_21plus", 4)
                                                      AS "monthly_per_capita_sales"
FROM monthly_sales m
JOIN third_zip z
      ON 1 = 1               -- just to enable reference to the zip code value
JOIN population_21plus p
      ON p."zipcode" = z."zipcode"
ORDER BY m."month";
```
