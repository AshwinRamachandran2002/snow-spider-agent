Query:
-- Description: 7) Mark the top-3 scoring answers per question using window functions
SELECT
  "answer_id",
  "question_id",
  "owner_user_id",
  "score",
  "rank_in_question"
FROM (
      SELECT
        a."id"            AS "answer_id",
        a."parent_id"     AS "question_id",
        a."owner_user_id",
        a."score",
        DENSE_RANK() OVER (PARTITION BY a."parent_id" ORDER BY a."score" DESC) AS "rank_in_question"
      FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS" a
) r
WHERE r."rank_in_question" <= 3
LIMIT 20;
