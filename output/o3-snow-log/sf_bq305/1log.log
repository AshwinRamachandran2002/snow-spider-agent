--Description:
-- 1.  Pull minimal columns from questions (q) and answers (a).
-- 2.  Compute total answer-score per question (score_totals) – needed for the
--    “≥ 20 % share” rule.
-- 3.  Identify owners of the three highest-scoring answers for every question
--    (top3) with a window-function + QUALIFY.
-- 4.  Identify answers whose score is ≥ 20 % of their question’s total answer
--    score and > 0 (share) – multiply by 5 to avoid division.
-- 5.  UNION ALL the five rule sources into assoc_raw, always projecting the same
--    two columns (question_id,user_id), then DISTINCT to shrink the set.
-- 6.  Join to questions, sum view_count per user, sort, and return the top-10.

WITH
q AS (  -- questions
    SELECT
        "id"                     AS question_id,
        "owner_user_id"          AS question_owner,
        "view_count",
        "accepted_answer_id"
    FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_QUESTIONS"
),

a AS (  -- answers
    SELECT
        "id",
        "parent_id"              AS question_id,
        "owner_user_id",
        "score"
    FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS"
),

score_totals AS (  -- total answer score for each question
    SELECT
        question_id,
        SUM(score) AS total_score
    FROM a
    GROUP BY question_id
),

top3 AS (  -- owners of the three highest-scoring answers
    SELECT
        question_id,
        owner_user_id
    FROM a
    QUALIFY DENSE_RANK() OVER (PARTITION BY question_id ORDER BY score DESC) <= 3
),

share AS (  -- answers whose score ≥ 20 % of total answer score
    SELECT
        a.question_id,
        a.owner_user_id
    FROM a
    JOIN score_totals st ON st.question_id = a.question_id
    WHERE a.score > 0
      AND a.score * 5 >= st.total_score          -- (score / total) ≥ 0.20
),

assoc_raw AS (  -- UNION ALL of the five rule sources
    -- Rule 1: question owner
    SELECT q.question_id, q.question_owner            AS user_id FROM q
    UNION ALL
    -- Rule 2: accepted-answer owner
    SELECT q.question_id, a.owner_user_id             AS user_id
    FROM   q
    JOIN   a ON a.id = q.accepted_answer_id
    UNION ALL
    -- Rule 3: answer with score > 5
    SELECT question_id, owner_user_id                 AS user_id
    FROM   a
    WHERE  score > 5
    UNION ALL
    -- Rule 4: ≥ 20 % share answers
    SELECT question_id, owner_user_id                 AS user_id FROM share
    UNION ALL
    -- Rule 5: top-3 answers
    SELECT question_id, owner_user_id                 AS user_id FROM top3
),

assoc AS (SELECT DISTINCT question_id, user_id FROM assoc_raw)

SELECT
    assoc.user_id,
    SUM(q.view_count) AS total_views
FROM   assoc
JOIN   q ON q.question_id = assoc.question_id
GROUP BY assoc.user_id
ORDER BY total_views DESC
LIMIT 10;
