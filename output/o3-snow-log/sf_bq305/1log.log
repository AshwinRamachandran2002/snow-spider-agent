Query:
-- Description: 4) Join questions with their accepted answer   (question.accepted_answer_id = answer.id)
SELECT
  q."id"                    AS "question_id",
  q."view_count",
  q."owner_user_id"         AS "question_owner",
  a."id"                    AS "accepted_answer_id",
  a."owner_user_id"         AS "answer_owner",
  a."score"                 AS "answer_score"
FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_QUESTIONS"  q
JOIN "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS"    a
  ON q."accepted_answer_id" = a."id"
LIMIT 20;
Answer:
