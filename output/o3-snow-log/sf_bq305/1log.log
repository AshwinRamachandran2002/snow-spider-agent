--Description:
--   Find the ten users whose “associated” questions have the highest combined
--   view-counts.  A (question,user) association is established by any of the
--   five rules below.  After collecting all such pairs we deduplicate, join to
--   the questions table for the view_count, aggregate per user, and sort.
--
--   Rules that generate (question_id,user_id) pairs
--     R1  user is the question owner
--     R2  user owns the accepted answer
--     R3  user owns an answer whose score > 5
--     R4  user owns an answer whose score ≥ 20 % of the question’s total answer
--         score (score > 0)
--     R5  user owns one of the three highest-scoring answers
--
--   CTE layout
--     q        : minimal columns from POSTS_QUESTIONS
--     a        : minimal columns from POSTS_ANSWERS
--     totals   : total answer score per question         (for R4)
--     top3     : owners of the three highest-scoring answers (R5)
--     share    : answers meeting the 20 % share rule          (R4)
--     assoc    : DISTINCT union of all five rule sources
--     user_vw  : aggregate view_count per user
--
WITH
q AS (                                   -- questions
  SELECT
    "id"                    AS question_id,
    "owner_user_id"         AS question_owner,
    "view_count",
    "accepted_answer_id"
  FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_QUESTIONS"
),
a AS (                                   -- answers
  SELECT
    "id",
    "parent_id"             AS question_id,
    "owner_user_id",
    "score"
  FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS"
),
totals AS (                              -- Σ(score) per question
  SELECT
    question_id,
    SUM(score) AS total_score
  FROM a
  GROUP BY question_id
),
top3 AS (                                -- owners of top-3 answers (R5)
  SELECT
    question_id,
    owner_user_id
  FROM a
  QUALIFY DENSE_RANK() OVER (PARTITION BY question_id ORDER BY score DESC) <= 3
),
share AS (                               -- answers with ≥20 % of total score (R4)
  SELECT
    a.question_id,
    a.owner_user_id
  FROM   a
  JOIN   totals t ON t.question_id = a.question_id
  WHERE  a.score > 0
    AND  a.score * 5 >= t.total_score          -- avoids division
),
assoc AS (                                -- DISTINCT set of all rule-based pairs
  SELECT DISTINCT * FROM (
      /* R1: question owner */
      SELECT question_id, question_owner                 AS user_id FROM q
      UNION ALL
      /* R2: accepted-answer owner */
      SELECT q.question_id, a.owner_user_id              AS user_id
      FROM   q JOIN a ON a.id = q.accepted_answer_id
      UNION ALL
      /* R3: answers with score > 5 */
      SELECT question_id, owner_user_id                  AS user_id
      FROM   a
      WHERE  score > 5
      UNION ALL
      /* R4: answers with ≥20 % share */
      SELECT question_id, owner_user_id                  AS user_id FROM share
      UNION ALL
      /* R5: top-3 answers */
      SELECT question_id, owner_user_id                  AS user_id FROM top3
  )
),
user_vw AS (                              -- accumulate view_counts per user
  SELECT
    user_id,
    SUM(q.view_count) AS total_views
  FROM   assoc
  JOIN   q ON q.question_id = assoc.question_id
  GROUP BY user_id
)
SELECT
  user_id,
  total_views
FROM user_vw
ORDER BY total_views DESC
LIMIT 10;
