Query:
-- Description: 5) For every question, calculate total answer score and attach each answer’s share
SELECT
  a."id"                      AS "answer_id",
  a."parent_id"               AS "question_id",
  a."owner_user_id",
  a."score",
  total_scores."total_score",
  ROUND(a."score" / NULLIF(total_scores."total_score",0), 4) AS "score_fraction"
FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS" a
JOIN (
        SELECT "parent_id", SUM("score") AS "total_score"
        FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS"
        GROUP BY "parent_id"
     ) total_scores
  ON a."parent_id" = total_scores."parent_id"
LIMIT 20;
