```sql
--Description / thinking process:
-- Goal → users with largest sum of view-counts for questions they are “associated” with.
-- Association rules:
--   (QO)  question owner;
--   (AA)  accepted-answer owner;
--   (HS)  any answer whose score > 5;
--   (SH)  answer whose score ≥ 20 % of total answer-scores for that question (and > 0);
--   (T3)  owners of the three highest-scoring answers for each question.
-- Plan:
--  1.  CTE q   : essential question info (id, owner, view_count, accepted_answer_id)
--  2.  CTE a   : essential answer info (id, parent_id, owner, score)
--  3.  CTE tot : total answer score per question
--  4.  CTE top3: owners of top-3 answers (window function)
--  5.  CTE share: answers meeting 20 % share rule
--  6.  CTE assoc: UNION of all rules → list (question_id,user_id)  (DISTINCT not
--      needed because final GROUP BY removes duplicates)
--  7.  Aggregate view_count across assoc to obtain per-user totals; order desc-ending.
--  8.  LIMIT 10 for the final answer list (can raise if needed).

WITH
q AS (
  SELECT
    "id",
    "owner_user_id",
    "view_count",
    "accepted_answer_id"
  FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_QUESTIONS"
),
a AS (
  SELECT
    "id",
    "parent_id",
    "owner_user_id",
    "score"
  FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS"
),
tot AS (                     -- total answer score per question
  SELECT
    "parent_id",
    SUM("score") AS "tot_score"
  FROM a
  GROUP BY "parent_id"
),
top3 AS (                    -- owners of top-3 answers
  SELECT
    "parent_id",
    "owner_user_id"
  FROM (
        SELECT
          "parent_id",
          "owner_user_id",
          DENSE_RANK() OVER (PARTITION BY "parent_id" ORDER BY "score" DESC) AS rk
        FROM a
       ) s
  WHERE rk <= 3
),
share AS (                   -- answers whose score ≥ 20 % of total
  SELECT
    a."parent_id",
    a."owner_user_id"
  FROM a
  JOIN tot ON a."parent_id" = tot."parent_id"
  WHERE a."score" > 0
    AND a."score" >= 0.2 * tot."tot_score"
),
assoc AS (                   -- UNION of all association rules
  -- (QO) question owner
  SELECT q."id" AS "question_id", q."owner_user_id" AS "user_id" FROM q
  UNION ALL
  -- (AA) accepted-answer owner
  SELECT q."id", a."owner_user_id"
  FROM q
  JOIN a ON q."accepted_answer_id" = a."id"
  UNION ALL
  -- (HS) answers with score > 5
  SELECT "parent_id", "owner_user_id"
  FROM a
  WHERE "score" > 5
  UNION ALL
  -- (SH) ≥20 % share
  SELECT * FROM share
  UNION ALL
  -- (T3) top-3 answers
  SELECT * FROM top3
)
SELECT
  assoc."user_id",
  SUM(q."view_count") AS "total_view_count"
FROM assoc
JOIN q ON assoc."question_id" = q."id"
GROUP BY assoc."user_id"
ORDER BY "total_view_count" DESC
LIMIT 10;
```
