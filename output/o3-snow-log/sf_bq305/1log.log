Query:
-- Description: 8) Build a unified list of (question_id , associated_user_id) according to all rules
WITH
  q AS (SELECT "id", "owner_user_id", "view_count", "accepted_answer_id" FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_QUESTIONS"),
  a AS (SELECT "id", "parent_id", "owner_user_id", "score" FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS"),
  total AS (SELECT "parent_id", SUM("score") AS "tot" FROM a GROUP BY "parent_id"),
  top3 AS (
      SELECT "parent_id", "owner_user_id"
      FROM (
          SELECT "parent_id", "owner_user_id",
                 DENSE_RANK() OVER (PARTITION BY "parent_id" ORDER BY "score" DESC) AS rnk
          FROM a
      ) t WHERE rnk <= 3
  ),
  bigshare AS (
      SELECT a."parent_id", a."owner_user_id"
      FROM a JOIN total ON a."parent_id" = total."parent_id"
      WHERE a."score" > 0 AND a."score" >= 0.2 * total."tot"
  )
SELECT DISTINCT
  assoc."question_id",
  assoc."user_id"
FROM (
      -- question owner
      SELECT q."id" AS "question_id", q."owner_user_id" AS "user_id" FROM q
      UNION ALL
      -- accepted answer owner
      SELECT q."id", a."owner_user_id" FROM q JOIN a ON q."accepted_answer_id" = a."id"
      UNION ALL
      -- answer with score > 5
      SELECT a."parent_id", a."owner_user_id" FROM a WHERE a."score" > 5
      UNION ALL
      -- answer with >=20% share
      SELECT bigshare."parent_id", bigshare."owner_user_id" FROM bigshare
      UNION ALL
      -- top-3 answers
      SELECT top3."parent_id", top3."owner_user_id" FROM top3
) assoc
LIMIT 20;
