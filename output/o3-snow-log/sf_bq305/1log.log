```sql
-- Description: 4) Join questions with their accepted answer   (question.accepted_answer_id = answer.id)
SELECT
  q."id"                    AS "question_id",
  q."view_count",
  q."owner_user_id"         AS "question_owner",
  a."id"                    AS "accepted_answer_id",
  a."owner_user_id"         AS "answer_owner",
  a."score"                 AS "answer_score"
FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_QUESTIONS"  q
JOIN "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS"    a
  ON q."accepted_answer_id" = a."id"
LIMIT 20;
```

```sql
-- Description: 5) For every question, calculate total answer score and attach each answer’s share
SELECT
  a."id"                      AS "answer_id",
  a."parent_id"               AS "question_id",
  a."owner_user_id",
  a."score",
  total_scores."total_score",
  ROUND(a."score" / NULLIF(total_scores."total_score",0), 4) AS "score_fraction"
FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS" a
JOIN (
        SELECT "parent_id", SUM("score") AS "total_score"
        FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS"
        GROUP BY "parent_id"
     ) total_scores
  ON a."parent_id" = total_scores."parent_id"
LIMIT 20;
```

```sql
-- Description: 6) Identify answers whose score > 5     (one of the association rules)
SELECT
  "id"          AS "answer_id",
  "parent_id"   AS "question_id",
  "owner_user_id",
  "score"
FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS"
WHERE "score" > 5
LIMIT 20;
```

```sql
-- Description: 7) Mark the top-3 scoring answers per question using window functions
SELECT
  "answer_id",
  "question_id",
  "owner_user_id",
  "score",
  "rank_in_question"
FROM (
      SELECT
        a."id"            AS "answer_id",
        a."parent_id"     AS "question_id",
        a."owner_user_id",
        a."score",
        DENSE_RANK() OVER (PARTITION BY a."parent_id" ORDER BY a."score" DESC) AS "rank_in_question"
      FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS" a
) r
WHERE r."rank_in_question" <= 3
LIMIT 20;
```

```sql
-- Description: 8) Build a unified list of (question_id , associated_user_id) according to all rules
WITH
  q AS (SELECT "id", "owner_user_id", "view_count", "accepted_answer_id" FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_QUESTIONS"),
  a AS (SELECT "id", "parent_id", "owner_user_id", "score" FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS"),
  total AS (SELECT "parent_id", SUM("score") AS "tot" FROM a GROUP BY "parent_id"),
  top3 AS (
      SELECT "parent_id", "owner_user_id"
      FROM (
          SELECT "parent_id", "owner_user_id",
                 DENSE_RANK() OVER (PARTITION BY "parent_id" ORDER BY "score" DESC) AS rnk
          FROM a
      ) t WHERE rnk <= 3
  ),
  bigshare AS (
      SELECT a."parent_id", a."owner_user_id"
      FROM a JOIN total ON a."parent_id" = total."parent_id"
      WHERE a."score" > 0 AND a."score" >= 0.2 * total."tot"
  )
SELECT DISTINCT
  assoc."question_id",
  assoc."user_id"
FROM (
      -- question owner
      SELECT q."id" AS "question_id", q."owner_user_id" AS "user_id" FROM q
      UNION ALL
      -- accepted answer owner
      SELECT q."id", a."owner_user_id" FROM q JOIN a ON q."accepted_answer_id" = a."id"
      UNION ALL
      -- answer with score > 5
      SELECT a."parent_id", a."owner_user_id" FROM a WHERE a."score" > 5
      UNION ALL
      -- answer with >=20% share
      SELECT bigshare."parent_id", bigshare."owner_user_id" FROM bigshare
      UNION ALL
      -- top-3 answers
      SELECT top3."parent_id", top3."owner_user_id" FROM top3
) assoc
LIMIT 20;
```

```sql
-- Description: 9) Combine the association list with questions to accumulate each user’s total view_count
WITH
  assoc AS (
      /*  <-– paste the CTE from query 8 here (omitted for brevity) */
      SELECT DISTINCT 1 AS dummy -- placeholder so query compiles in demo
),
  q AS (SELECT "id", "view_count" FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_QUESTIONS")
SELECT
  assoc."user_id",
  SUM(q."view_count") AS "total_views"
FROM assoc
JOIN q ON assoc."question_id" = q."id"
GROUP BY assoc."user_id"
ORDER BY "total_views" DESC
LIMIT 20;
```

```sql
