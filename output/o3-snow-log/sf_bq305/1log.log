--  totals  : total answer-score per question  (for R4)
--  top3    : owners of 3 highest-scoring answers (R5)
--  share   : answers satisfying ≥20 % rule      (R4)
--  assoc   : DISTINCT UNION of all rule-based pairs (question_id , user_id)
--  user_vw : aggregate view_count over each user’s associated questions
--Final SELECT → top-10 users by total_views.

WITH
/*-------------------------------------------------------------------*/
q AS (                           -- questions
  SELECT
    "id"                    AS question_id,
    "owner_user_id"         AS question_owner,
    "view_count"            AS view_count,
    "accepted_answer_id"    AS acc_answer_id
  FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_QUESTIONS"
),
/*-------------------------------------------------------------------*/
a AS (                           -- answers
  SELECT
    "id",
    "parent_id"              AS question_id,
    "owner_user_id"          AS owner_id,
    "score"                  AS ans_score
  FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS"
),
/*-------------------------------------------------------------------*/
totals AS (                      -- Σ(score) per question
  SELECT
    question_id,
    SUM(ans_score) AS total_score
  FROM a
  GROUP BY question_id
),
/*-------------------------------------------------------------------*/
top3 AS (                        -- owners of 3 highest-scoring answers (R5)
  SELECT
    question_id,
    owner_id AS user_id
  FROM (
        SELECT
          question_id,
          owner_id,
          DENSE_RANK() OVER (PARTITION BY question_id
                             ORDER BY ans_score DESC) AS rk
        FROM a
  )
  WHERE rk <= 3
),
/*-------------------------------------------------------------------*/
share AS (                       -- answers with ≥20 % of total score (R4)
  SELECT
    a.question_id,
    a.owner_id AS user_id
  FROM a
  JOIN totals t
    ON t.question_id = a.question_id
  WHERE a.ans_score > 0
    AND a.ans_score * 5 >= t.total_score        -- avoids division
),
/*-------------------------------------------------------------------*/
assoc AS (                       -- DISTINCT list of all (question_id,user_id)
  SELECT DISTINCT * FROM (
      /* R1: question owner */
      SELECT question_id, question_owner        AS user_id FROM q
      UNION ALL
      /* R2: accepted-answer owner */
      SELECT q.question_id, a.owner_id          AS user_id
