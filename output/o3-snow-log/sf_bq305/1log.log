--Description: Build every (question,user) association required by the five rules
--             and then total the question view-counts per user.
--             CTE layout
--               q      : questions (id, owner, view_count, accepted answer)
--               a      : answers   (id, question, owner, score)
--               tot    : total answer-score per question
--               top3   : owners of the three highest-scoring answers (window fn)
--               share  : answers whose score ≥ 20 % of the question’s total
--               assoc_raw : UNION ALL of the five rule sources
--               assoc  : DISTINCT (question_id,user_id) pairs
--             Final SELECT aggregates view_count for each user and returns the
--             ten users with the greatest combined totals.

WITH
q AS (  -- questions
  SELECT
    "id"                       AS question_id,
    "owner_user_id"            AS q_owner,
    "view_count",
    "accepted_answer_id"
  FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_QUESTIONS"
),
a AS (  -- answers
  SELECT
    "id",
    "parent_id"                AS question_id,
    "owner_user_id",
    "score"
  FROM "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS"
),
tot AS (  -- total answer score per question
  SELECT
    question_id,
    SUM(score)                 AS total_score
  FROM a
  GROUP BY question_id
),
top3 AS (  -- owners of the three best-scoring answers
  SELECT
    question_id,
    owner_user_id
  FROM (
        SELECT
          question_id,
          owner_user_id,
          DENSE_RANK() OVER (PARTITION BY question_id
                             ORDER BY score DESC) AS rnk
        FROM a
       ) s
  WHERE rnk <= 3
),
share AS (  -- answers contributing ≥20 % of total answer score
  SELECT
    a.question_id,
    a.owner_user_id
  FROM a
  JOIN tot ON a.question_id = tot.question_id
  WHERE a.score > 0
    AND a.score * 5 >= tot.total_score          -- avoids division
),
assoc_raw AS (  -- all rule-based links
  -- question owner
  SELECT question_id, q_owner AS user_id FROM q
  UNION ALL
  -- accepted-answer owner
  SELECT q.question_id, a.owner_user_id
  FROM   q
  JOIN   a ON a.id = q.accepted_answer_id
  UNION ALL
  -- answers with score > 5
  SELECT question_id, owner_user_id FROM a WHERE score > 5
  UNION ALL
  -- ≥20 % share answers
  SELECT * FROM share
  UNION ALL
  -- top-3 answers
  SELECT * FROM top3
),
assoc AS (  -- de-duplicate pairs before join
  SELECT DISTINCT question_id, user_id FROM assoc_raw
)
SELECT
  assoc.user_id,
  SUM(q.view_count) AS total_views
FROM   assoc
JOIN   q ON q.question_id = assoc.question_id
GROUP BY assoc.user_id
ORDER BY total_views DESC
LIMIT 10;
