--Description:  Single-statement solution that:
--  • builds every (question_id , user_id) pair meeting one of the five association
--    rules (see below), deduplicates them, then
--  • sums the view_count of those questions per user and returns the 10 users
--    with the greatest combined totals.
--
--Association rules implemented
--  1) user owns the question
--  2) user owns the accepted answer
--  3) user owns an answer whose score > 5
--  4) user owns an answer whose score is ≥ 20 % of the question’s total answer
--     scores and > 0
--  5) user owns one of the three highest-scoring answers for the question
--
--CTE legend
--  q       : questions               (id, owner, view_count, accepted_answer_id)
--  a       : answers                 (id, parent question, owner, score)
--  totals  : SUM(score) per question         – for rule 4
--  top3    : owners of the three best-scoring answers – rule 5
--  share   : answers meeting the 20 % share rule      – rule 4
--  assoc   : DISTINCT union of all rule sources
--  user_views : final aggregation per user

WITH
q AS (
    SELECT
        "id"                    AS question_id,
        "owner_user_id"         AS question_owner,
        "view_count",
        "accepted_answer_id"
    FROM   "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_QUESTIONS"
),
a AS (
    SELECT
        "id",
        "parent_id"             AS question_id,
        "owner_user_id",
        "score"
    FROM   "STACKOVERFLOW"."STACKOVERFLOW"."POSTS_ANSWERS"
),
totals AS (                      -- total answer score per question
    SELECT
        question_id,
        SUM(score) AS total_score
    FROM   a
    GROUP BY question_id
),
top3 AS (                        -- owners of the 3 highest-scoring answers
    SELECT
        question_id,
        owner_user_id
    FROM   a
    QUALIFY DENSE_RANK() OVER (PARTITION BY question_id ORDER BY score DESC) <= 3
),
share AS (                       -- answers whose score ≥ 20 % of total
    SELECT
        a.question_id,
        a.owner_user_id
    FROM   a
    JOIN   totals t ON t.question_id = a.question_id
    WHERE  a.score > 0
      AND  a.score * 5 >= t.total_score         -- multiply by 5 (>=20 %) to avoid division
),
assoc AS (                       -- de-duplicated union of all five rules
    SELECT DISTINCT * FROM (
          -- rule 1: question owner
          SELECT question_id, question_owner             AS user_id FROM q
          UNION ALL
          -- rule 2: accepted-answer owner
          SELECT q.question_id, a.owner_user_id          AS user_id
          FROM   q JOIN a ON a.id = q.accepted_answer_id
          UNION ALL
          -- rule 3: any answer with score > 5
          SELECT question_id, owner_user_id              AS user_id
          FROM   a
          WHERE  score > 5
          UNION ALL
          -- rule 4: ≥20 % share answers
          SELECT question_id, owner_user_id              AS user_id FROM share
          UNION ALL
          -- rule 5: top-3 answers
          SELECT question_id, owner_user_id              AS user_id FROM top3
    )
),
user_views AS (                  -- aggregate view_count per user
    SELECT
        assoc.user_id,
        SUM(q.view_count) AS total_views
    FROM   assoc
    JOIN   q ON q.question_id = assoc.question_id
    GROUP BY assoc.user_id
)
SELECT
    user_id,
    total_views
FROM   user_views
ORDER BY total_views DESC
LIMIT 10;
