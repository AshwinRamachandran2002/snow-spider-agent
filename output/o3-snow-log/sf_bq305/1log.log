      JOIN a ON a.id = q.acc_answer_id
      UNION ALL
      /* R3: answers with score > 5 */
      SELECT question_id, owner_id              AS user_id
      FROM a
      WHERE ans_score > 5
      UNION ALL
      /* R4: ≥20 % share answers */
      SELECT question_id, user_id FROM share
      UNION ALL
      /* R5: top-3 answers */
      SELECT question_id, user_id FROM top3
  )
),
/*-------------------------------------------------------------------*/
user_vw AS (                      -- total view_count per user
  SELECT
    user_id,
    SUM(q.view_count) AS total_views
  FROM assoc
  JOIN q ON q.question_id = assoc.question_id
  GROUP BY user_id
)
/*-------------------------------------------------------------------*/
SELECT
  user_id,
  total_views
FROM user_vw
ORDER BY total_views DESC
LIMIT 10;
