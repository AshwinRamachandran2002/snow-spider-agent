```sql
--Description:  Return the 10 users whose associated questions have the highest
--sum of view counts.  We consider a user “associated” with a question if
--(1) they are the question owner,
--(2) they own the accepted answer,
--(3) they have any answer with score > 5,
--(4) they have an answer whose score is > 20 % of the total answer score
--    for that question and positive,
--(5) they own one of the three highest-scoring answers for that question.
--The query builds each of those sets, unions them into one list of
--(question_id, user_id) pairs, then aggregates view_count per user.

WITH
/* fundamental question data */
q AS (
  SELECT "id",
         "owner_user_id",
         "view_count",
         "accepted_answer_id"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS"
),

/* fundamental answer data */
a AS (
  SELECT "id",
         "parent_id",          -- question id
         "owner_user_id",
         "score"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
),

/* owners of accepted answers */
acc AS (
  SELECT q."id"                AS "question_id",
         a."owner_user_id"
  FROM q
  JOIN a ON a."id" = q."accepted_answer_id"
),

/* owners of answers with score > 5 */
hi AS (
  SELECT "parent_id"           AS "question_id",
         "owner_user_id"
  FROM a
  WHERE "score" > 5
),

/* owners of answers whose score is > 20 % of total answer score and positive */
share_ok AS (
  SELECT a."parent_id"         AS "question_id",
         a."owner_user_id"
  FROM a
  JOIN (
        SELECT "parent_id",
               SUM("score") AS total_score
        FROM a
        GROUP BY "parent_id"
       ) t
    ON t."parent_id" = a."parent_id"
  WHERE a."score" > 0
    AND a."score" > 0.2 * t.total_score
),

/* owners of the three highest-scoring answers per question */
top3 AS (
  SELECT "parent_id"           AS "question_id",
         "owner_user_id"
  FROM (
        SELECT "parent_id",
               "owner_user_id",
               ROW_NUMBER() OVER (PARTITION BY "parent_id"
                                  ORDER BY "score" DESC, "id") AS rn
        FROM a
       )
  WHERE rn <= 3
),

/* union all (question_id,user_id) associations – every branch delivers two columns */
assoc AS (
  SELECT "id"            AS "question_id",
         "owner_user_id" AS "user_id" FROM q      -- question owners
  UNION
  SELECT * FROM acc                                      -- accepted answers
  UNION
  SELECT * FROM hi                                       -- answers score > 5
  UNION
  SELECT * FROM share_ok                                 -- >20 % total score
  UNION
  SELECT * FROM top3                                     -- top-3 answers
)

SELECT assoc."user_id",
       SUM(q."view_count") AS "combined_question_views"
FROM assoc
JOIN q ON q."id" = assoc."question_id"
WHERE assoc."user_id" IS NOT NULL
GROUP BY assoc."user_id"
ORDER BY "combined_question_views" DESC
LIMIT 10;
```
