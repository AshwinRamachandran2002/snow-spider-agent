```sql
--Description / Thinking process:
-- Goal: find the 10 users whose combined view-counts (SUM of view_count of every
--       question they are “associated” with) are the largest.
-- A user is “associated” with a question if ANY of the following holds:
--   1) the user asked the question;
--   2) the user owns the accepted answer;
--   3) the user owns an answer with score > 5;
--   4) the user owns an answer whose score is positive and > 20 % of the total
--      answer-scores for that question;
--   5) the user owns one of the three highest-scoring answers for that question.
-- Steps
--   • Build five CTEs, one per rule, each yielding (question_id, user_id).
--   • UNION them (duplicates vanish because UNION defaults to DISTINCT).
--   • Join the resulting association list to POSTS_QUESTIONS to grab view_count.
--   • Aggregate view_count per user (COALESCE to treat NULL as 0).
--   • Sort by total_views DESC and keep the top 10.
--   • Join to USERS to show display_name alongside user_id.

WITH
/* ---------- Rule 1: question owners ----------------------------------------*/
owners AS (
  SELECT DISTINCT
         q."id"            AS question_id,
         q."owner_user_id" AS user_id
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS" q
  WHERE q."owner_user_id" IS NOT NULL
),

/* ---------- Rule 2: accepted-answer owners ---------------------------------*/
accepted AS (
  SELECT DISTINCT
         q."id"            AS question_id,
         a."owner_user_id" AS user_id
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS" q
  JOIN STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
    ON a."id" = q."accepted_answer_id"
  WHERE a."owner_user_id" IS NOT NULL
),

/* ---------- Rule 3: answers with score > 5 ---------------------------------*/
highscore AS (
  SELECT DISTINCT
         a."parent_id"     AS question_id,
         a."owner_user_id" AS user_id
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
  WHERE a."score" > 5
    AND a."owner_user_id" IS NOT NULL
),

/* ---------- Helper: total answer-score per question ------------------------*/
total_scores AS (
  SELECT
         "parent_id"                AS question_id,
         SUM("score") AS tot_score
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
  GROUP BY "parent_id"
),

/* ---------- Rule 4: answer > 0 and > 20 % of total -------------------------*/
twenty_pct AS (
  SELECT DISTINCT
         a."parent_id"     AS question_id,
         a."owner_user_id" AS user_id
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
  JOIN total_scores t
    ON t.question_id = a."parent_id"
  WHERE a."score" > 0
    AND a."score" > 0.2 * t.tot_score
    AND a."owner_user_id" IS NOT NULL
),

/* ---------- Rule 5: owners of top-3 answers by score -----------------------*/
top3 AS (
  SELECT question_id, user_id
  FROM (
    SELECT
           a."parent_id"     AS question_id,
           a."owner_user_id" AS user_id,
           ROW_NUMBER() OVER (PARTITION BY a."parent_id" ORDER BY a."score" DESC) AS rn
    FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
    WHERE a."owner_user_id" IS NOT NULL
  )
  WHERE rn <= 3
),

/* ---------- Combine all associations --------------------------------------*/
assoc AS (
  SELECT * FROM owners
  UNION
  SELECT * FROM accepted
  UNION
  SELECT * FROM highscore
  UNION
  SELECT * FROM twenty_pct
  UNION
  SELECT * FROM top3
),

/* ---------- Sum view_counts per user --------------------------------------*/
user_views AS (
  SELECT
         assoc.user_id,
         SUM(COALESCE(q."view_count",0)) AS total_views
  FROM assoc
  JOIN STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS" q
    ON q."id" = assoc.question_id
  GROUP BY assoc.user_id
)

/* ---------- Final output: top 10 users by total_views ---------------------*/
SELECT
  uv.user_id,
  u."display_name",
  uv.total_views
FROM user_views uv
LEFT JOIN STACKOVERFLOW.STACKOVERFLOW."USERS" u
       ON u."id" = uv.user_id
ORDER BY uv.total_views DESC
LIMIT 10;
```
