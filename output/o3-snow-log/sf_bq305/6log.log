/* ---------------------------------------------------------------------------
   Top 10 users by total view-count of questions they are “associated” with.
   Association rules
     1.  Question owner
     2.  Accepted-answer owner
     3.  Any answer having score > 5
     4.  Any answer whose score > 0 AND > 20 % of total answer-score for
        that question
     5.  Owners of the three highest-scoring answers for each question
   -------------------------------------------------------------------------*/
WITH
/* --- rule-1 : owners of the questions ------------------------------------*/
owners AS (
    SELECT DISTINCT
           q."id"            AS question_id,
           q."owner_user_id" AS user_id
    FROM   STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS" q
    WHERE  q."owner_user_id" IS NOT NULL
),

/* --- rule-2 : owners of accepted answers ---------------------------------*/
accepted AS (
    SELECT DISTINCT
           q."id"            AS question_id,
           a."owner_user_id" AS user_id
    FROM   STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS" q
    JOIN   STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"   a
           ON a."id" = q."accepted_answer_id"
    WHERE  a."owner_user_id" IS NOT NULL
),

/* --- rule-3 : owners of answers with score > 5 ---------------------------*/
highscore AS (
    SELECT DISTINCT
           a."parent_id"     AS question_id,
           a."owner_user_id" AS user_id
    FROM   STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
    WHERE  a."score" > 5
      AND  a."owner_user_id" IS NOT NULL
),

/* helper : total answer score per question --------------------------------*/
totals AS (
    SELECT  "parent_id" AS question_id,
            SUM("score") AS total_score
    FROM    STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
    GROUP BY "parent_id"
),

/* --- rule-4 : answers whose score > 0 and > 20 % of total ----------------*/
twenty_pct AS (
    SELECT DISTINCT
           a."parent_id"     AS question_id,
           a."owner_user_id" AS user_id
    FROM   STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
    JOIN   totals t
           ON t.question_id = a."parent_id"
    WHERE  a."score" > 0
      AND  a."score" > 0.20 * t.total_score
      AND  a."owner_user_id" IS NOT NULL
),

/* --- rule-5 : owners of the top-3 scoring answers per question -----------*/
top3 AS (
    SELECT  question_id,
            user_id
    FROM   (
        SELECT
               a."parent_id"     AS question_id,
               a."owner_user_id" AS user_id,
               ROW_NUMBER() OVER (PARTITION BY a."parent_id"
                                  ORDER BY a."score" DESC) AS rn
        FROM   STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
        WHERE  a."owner_user_id" IS NOT NULL
    )
    WHERE rn <= 3
),

/* --- union of all association rules (deduplicated) -----------------------*/
assoc AS (
    SELECT * FROM owners
    UNION
    SELECT * FROM accepted
    UNION
    SELECT * FROM highscore
    UNION
    SELECT * FROM twenty_pct
    UNION
    SELECT * FROM top3
),

/* --- total view-count per associated user --------------------------------*/
user_views AS (
    SELECT
        assoc.user_id,
        SUM(COALESCE(q."view_count",0)) AS total_views
    FROM   assoc
    JOIN   STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS" q
           ON q."id" = assoc.question_id
    GROUP BY assoc.user_id
)

/* --- final top-10 list ---------------------------------------------------*/
SELECT
    uv.user_id,
    u."display_name",
    uv.total_views
FROM   user_views uv
LEFT JOIN STACKOVERFLOW.STACKOVERFLOW."USERS" u
       ON u."id" = uv.user_id
ORDER BY uv.total_views DESC
LIMIT 10;
```
