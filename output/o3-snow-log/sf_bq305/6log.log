Query:
-- 3. Description: join questions with their answers and show total answer-score per question  
SELECT 
  q."id"               AS "question_id",
  SUM(a."score")       AS "total_answer_score"
FROM STACKOVERFLOW.STACKOVERFLOW.POSTS_QUESTIONS q
JOIN STACKOVERFLOW.STACKOVERFLOW.POSTS_ANSWERS   a
     ON a."parent_id" = q."id"
GROUP BY q."id"
LIMIT 20;
