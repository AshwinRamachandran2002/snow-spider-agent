accepted AS (
  SELECT DISTINCT
         q."id"            AS question_id,
         a."owner_user_id" AS user_id
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS" q
  JOIN STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
    ON a."id" = q."accepted_answer_id"
  WHERE a."owner_user_id" IS NOT NULL
),

/* ---------- Rule 3: answers with score > 5 ---------------------------------*/
highscore AS (
  SELECT DISTINCT
         a."parent_id"     AS question_id,
         a."owner_user_id" AS user_id
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
  WHERE a."score" > 5
    AND a."owner_user_id" IS NOT NULL
),

/* ---------- Helper: total answer-score per question ------------------------*/
total_scores AS (
  SELECT
         "parent_id"                AS question_id,
         SUM("score") AS tot_score
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
  GROUP BY "parent_id"
),

/* ---------- Rule 4: answer > 0 and > 20 % of total -------------------------*/
twenty_pct AS (
  SELECT DISTINCT
         a."parent_id"     AS question_id,
         a."owner_user_id" AS user_id
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
  JOIN total_scores t
    ON t.question_id = a."parent_id"
  WHERE a."score" > 0
    AND a."score" > 0.2 * t.tot_score
    AND a."owner_user_id" IS NOT NULL
),

/* ---------- Rule 5: owners of top-3 answers by score -----------------------*/
top3 AS (
