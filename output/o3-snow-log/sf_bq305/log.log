```sql
--Description: 1) Inspect some basic columns from the questions table
SELECT 
  "id",
  "owner_user_id",
  "title",
  "view_count",
  "accepted_answer_id"
FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS"
LIMIT 20;
```

```sql
--Description: 2) Show the owners of the accepted answers next to the question owners
SELECT 
  q."id"                               AS "question_id",
  q."view_count",
  q."owner_user_id"                    AS "question_owner",
  a."owner_user_id"                    AS "accepted_answer_owner",
  a."score"                            AS "accepted_answer_score"
FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS"  q
LEFT JOIN STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
       ON q."accepted_answer_id" = a."id"
LIMIT 20;
```

```sql
--Description: 3) Look at answers whose score is greater than 5 (one of the association rules)
SELECT 
  "id"            AS "answer_id",
  "parent_id"     AS "question_id",
  "owner_user_id" AS "answer_owner",
  "score"
FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
WHERE "score" > 5
ORDER BY "score" DESC
LIMIT 20;
```

```sql
--Description: 4) Compute total answer score per question (needed for the 20 % rule)
SELECT 
  "parent_id"           AS "question_id",
  SUM("score")          AS "total_answer_score"
FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
GROUP BY "parent_id"
ORDER BY "total_answer_score" DESC
LIMIT 20;
```

```sql
--Description: 5) Pick answers whose score exceeds 20 % of the total score of their question (and > 0)
SELECT 
  a."id"            AS "answer_id",
  a."parent_id"     AS "question_id",
  a."owner_user_id" AS "answer_owner",
  a."score",
  ts."total_answer_score"
FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
JOIN (
       SELECT 
         "parent_id"      AS "question_id",
         SUM("score")     AS "total_answer_score"
       FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
       GROUP BY "parent_id"
     ) ts
  ON a."parent_id" = ts."question_id"
WHERE a."score" > 0 
  AND a."score" >= 0.20 * ts."total_answer_score"
LIMIT 20;
```

```sql
--Description: 6) Find the three highest-scoring answers for each question
SELECT *
FROM (
  SELECT
    "id"            AS "answer_id",
    "parent_id"     AS "question_id",
    "owner_user_id" AS "answer_owner",
    "score",
    ROW_NUMBER() OVER (PARTITION BY "parent_id" ORDER BY "score" DESC) AS "rank_in_question"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
) t
WHERE "rank_in_question" <= 3
LIMIT 20;
```

```sql
--Description: 7) Build a unified list of (question_id, associated_user_id) pairs 
--               using the five association rules (sample rows only)
SELECT DISTINCT "id"                             AS "question_id",
       "owner_user_id"                           AS "associated_user_id",
       'QUESTION_OWNER'                          AS "rule"
FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS"
UNION ALL
SELECT DISTINCT q."id", a."owner_user_id", 'ACCEPTED_ANSWER'
FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS"  q
JOIN STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"     a
  ON q."accepted_answer_id" = a."id"
UNION ALL
SELECT DISTINCT "question_id", "answer_owner", 'ANSWER_SCORE_GT5'
FROM (
  SELECT "parent_id" AS "question_id",
         "owner_user_id" AS "answer_owner"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
  WHERE "score" > 5
) s
LIMIT 20;
```

```sql
--Description: 8) Continue the unified list adding 20 % rule & top-3 rule (sample only)
SELECT DISTINCT "question_id", "answer_owner", 'ANSWER_20_PERCENT'
FROM (
  -- 20 % rule subquery from step 5
  SELECT 
    a."parent_id"     AS "question_id",
    a."owner_user_id" AS "answer_owner"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
  JOIN (
         SELECT "parent_id", SUM("score") AS "total_score"
         FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
         GROUP BY "parent_id"
       ) t
    ON a."parent_id" = t."parent_id"
  WHERE a."score" > 0
    AND a."score" >= 0.20 * t."total_score"
) p
UNION ALL
SELECT DISTINCT "question_id", "answer_owner", 'TOP3_ANSWERS'
FROM (
  -- top-3 rule subquery from step 6
  SELECT
    "parent_id"     AS "question_id",
    "owner_user_id" AS "answer_owner",
    ROW_NUMBER() OVER (PARTITION BY "parent_id" ORDER BY "score" DESC) AS "rnk"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
) t
WHERE "rnk" <= 3
LIMIT 20;
```

```sql
--Description: 9) Sum question view_counts per associated user (intermediate result)
WITH associations AS (
  -- union of all five rules (using previous logic, trimmed for brevity)
  SELECT "id" AS "question_id", "owner_user_id" AS "user_id"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS"
  UNION
  SELECT q."id", a."owner_user_id"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS" q
  JOIN STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"  a
    ON q."accepted_answer_id" = a."id"
  UNION
  SELECT "parent_id", "owner_user_id"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
  WHERE "score" > 5
  UNION
  SELECT a."parent_id", a."owner_user_id"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
  JOIN (
        SELECT "parent_id", SUM("score") AS "tot"
        FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
        GROUP BY "parent_id"
      ) t
    ON a."parent_id" = t."parent_id"
   AND a."score" > 0
   AND a."score" >= 0.20 * t."tot"
  UNION
  SELECT "parent_id", "owner_user_id"
  FROM (
    SELECT "parent_id", "owner_user_id",
           ROW_NUMBER() OVER (PARTITION BY "parent_id" ORDER BY "score" DESC) AS "rnk"
    FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
  )
  WHERE "rnk" <= 3
)
SELECT 
  assoc."user_id",
  SUM(q."view_count") AS "combined_views"
FROM associations assoc
JOIN STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS" q
  ON assoc."question_id" = q."id"
GROUP BY assoc."user_id"
ORDER BY "combined_views" DESC
LIMIT 20;
```

```sql
--Description: 10) Final query – the 10 users with the highest combined view counts
WITH associations AS (
  /* (Same UNION logic as step 9) */
  SELECT "id" AS "question_id", "owner_user_id" AS "user_id"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS"
  UNION
  SELECT q."id", a."owner_user_id"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS" q
  JOIN STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"  a
    ON q."accepted_answer_id" = a."id"
  UNION
  SELECT "parent_id", "owner_user_id"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
  WHERE "score" > 5
  UNION
  SELECT a."parent_id", a."owner_user_id"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
  JOIN (
        SELECT "parent_id", SUM("score") AS "tot"
        FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
        GROUP BY "parent_id"
      ) t
    ON a."parent_id" = t."parent_id"
   AND a."score" > 0
   AND a."score" >= 0.20 * t."tot"
  UNION
  SELECT "parent_id", "owner_user_id"
  FROM (
    SELECT "parent_id", "owner_user_id",
           ROW_NUMBER() OVER (PARTITION BY "parent_id" ORDER BY "score" DESC) AS "rnk"
    FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
  )
  WHERE "rnk" <= 3
)
SELECT 
  assoc."user_id",
  SUM(q."view_count") AS "combined_views"
FROM associations assoc
JOIN STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS" q
  ON assoc."question_id" = q."id"
GROUP BY assoc."user_id"
ORDER BY "combined_views" DESC
LIMIT 10;
```

These ten queries move step-by-step from basic exploration of the necessary tables to a complete solution identifying the top-10 users by the summed view counts of questions with which they are “associated” according to the five specified rules.
