--Description: 10) Final query – the 10 users with the highest combined view counts
WITH associations AS (
  /* (Same UNION logic as step 9) */
  SELECT "id" AS "question_id", "owner_user_id" AS "user_id"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS"
  UNION
  SELECT q."id", a."owner_user_id"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS" q
  JOIN STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"  a
    ON q."accepted_answer_id" = a."id"
  UNION
  SELECT "parent_id", "owner_user_id"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
  WHERE "score" > 5
  UNION
  SELECT a."parent_id", a."owner_user_id"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
  JOIN (
        SELECT "parent_id", SUM("score") AS "tot"
        FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
        GROUP BY "parent_id"
      ) t
    ON a."parent_id" = t."parent_id"
   AND a."score" > 0
   AND a."score" >= 0.20 * t."tot"
  UNION
  SELECT "parent_id", "owner_user_id"
  FROM (
    SELECT "parent_id", "owner_user_id",
           ROW_NUMBER() OVER (PARTITION BY "parent_id" ORDER BY "score" DESC) AS "rnk"
    FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
  )
  WHERE "rnk" <= 3
)
SELECT 
  assoc."user_id",
  SUM(q."view_count") AS "combined_views"
FROM associations assoc
JOIN STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS" q
  ON assoc."question_id" = q."id"
GROUP BY assoc."user_id"
ORDER BY "combined_views" DESC
LIMIT 10;
