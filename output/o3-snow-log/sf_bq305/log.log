Query:
--Description: 6) Find the three highest-scoring answers for each question
SELECT *
FROM (
  SELECT
    "id"            AS "answer_id",
    "parent_id"     AS "question_id",
    "owner_user_id" AS "answer_owner",
    "score",
    ROW_NUMBER() OVER (PARTITION BY "parent_id" ORDER BY "score" DESC) AS "rank_in_question"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
) t
WHERE "rank_in_question" <= 3
LIMIT 20;
