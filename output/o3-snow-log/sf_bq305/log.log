--Description: 7) Build a unified list of (question_id, associated_user_id) pairs 
--               using the five association rules (sample rows only)
SELECT DISTINCT "id"                             AS "question_id",
       "owner_user_id"                           AS "associated_user_id",
       'QUESTION_OWNER'                          AS "rule"
FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS"
UNION ALL
SELECT DISTINCT q."id", a."owner_user_id", 'ACCEPTED_ANSWER'
FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_QUESTIONS"  q
JOIN STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"     a
  ON q."accepted_answer_id" = a."id"
UNION ALL
SELECT DISTINCT "question_id", "answer_owner", 'ANSWER_SCORE_GT5'
FROM (
  SELECT "parent_id" AS "question_id",
         "owner_user_id" AS "answer_owner"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
  WHERE "score" > 5
) s
LIMIT 20;
