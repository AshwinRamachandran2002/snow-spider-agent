         FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
         GROUP BY "parent_id"
       ) t
    ON a."parent_id" = t."parent_id"
  WHERE a."score" > 0
    AND a."score" >= 0.20 * t."total_score"
) p
UNION ALL
SELECT DISTINCT "question_id", "answer_owner", 'TOP3_ANSWERS'
FROM (
  -- top-3 rule subquery from step 6
  SELECT
    "parent_id"     AS "question_id",
    "owner_user_id" AS "answer_owner",
    ROW_NUMBER() OVER (PARTITION BY "parent_id" ORDER BY "score" DESC) AS "rnk"
  FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
) t
WHERE "rnk" <= 3
LIMIT 20;
