Query:
--Description: 5) Pick answers whose score exceeds 20 % of the total score of their question (and > 0)
SELECT 
  a."id"            AS "answer_id",
  a."parent_id"     AS "question_id",
  a."owner_user_id" AS "answer_owner",
  a."score",
  ts."total_answer_score"
FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS" a
JOIN (
       SELECT 
         "parent_id"      AS "question_id",
         SUM("score")     AS "total_answer_score"
       FROM STACKOVERFLOW.STACKOVERFLOW."POSTS_ANSWERS"
       GROUP BY "parent_id"
     ) ts
  ON a."parent_id" = ts."question_id"
WHERE a."score" > 0 
  AND a."score" >= 0.20 * ts."total_answer_score"
LIMIT 20;
