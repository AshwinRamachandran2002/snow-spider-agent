/*---------------------------------------------------------------------------
   Keep only sessions inside the requested window
---------------------------------------------------------------------------*/
SESSIONS AS
(
    SELECT
        "fullVisitorId"                                 AS fullvisitorid,
        "visitStartTime"::NUMBER                        AS visit_start_ts,
        "visitNumber"::NUMBER                           AS visit_number,
        PARSE_JSON("totals")                            AS totals_json,
        "date"                                          AS session_date
    FROM ALL_SESSIONS
    WHERE "date" BETWEEN '20160801' AND '20170430'
),

/*---------------------------------------------------------------------------
   Identify the 1st session for every visitor in that window
---------------------------------------------------------------------------*/
FIRST_SESSIONS AS
(
    SELECT
        fullvisitorid,
        MIN(visit_start_ts) AS first_visit_ts
    FROM SESSIONS
    WHERE visit_number = 1     -- first session recorded for that visitor
    GROUP BY fullvisitorid
),

/*---------------------------------------------------------------------------
   First-session users who stayed > 5 minutes (300 seconds)
---------------------------------------------------------------------------*/
QUALIFIED_FIRST AS
(
    SELECT DISTINCT s.fullvisitorid
    FROM SESSIONS      s
    JOIN FIRST_SESSIONS f
          ON  s.fullvisitorid = f.fullvisitorid
          AND s.visit_start_ts = f.first_visit_ts
    WHERE   COALESCE( s.totals_json:"timeOnSite"::NUMBER , 0 ) > 300
),

/*---------------------------------------------------------------------------
   Same users that completed ≥1 transaction in ANY later session
---------------------------------------------------------------------------*/
LATER_PURCHASERS AS
(
    SELECT DISTINCT s.fullvisitorid
    FROM SESSIONS      s
    JOIN FIRST_SESSIONS f
          ON  s.fullvisitorid = f.fullvisitorid
          AND s.visit_start_ts > f.first_visit_ts          -- later visit
    WHERE   COALESCE( s.totals_json:"transactions"::NUMBER , 0 ) > 0
)

/*---------------------------------------------------------------------------
   Final calculation
---------------------------------------------------------------------------*/
SELECT
    COUNT(DISTINCT CASE WHEN q.fullvisitorid IS NOT NULL
                         AND p.fullvisitorid IS NOT NULL
                         THEN fs.fullvisitorid END)               AS users_meeting_conditions,
    COUNT(DISTINCT fs.fullvisitorid)                              AS total_new_users,
    ROUND( 100.0 *
           COUNT(DISTINCT CASE WHEN q.fullvisitorid IS NOT NULL
                                AND p.fullvisitorid IS NOT NULL
                                THEN fs.fullvisitorid END)
           /
           COUNT(DISTINCT fs.fullvisitorid)
         , 4)                                                     AS pct_new_users
FROM         FIRST_SESSIONS   fs
LEFT  JOIN   QUALIFIED_FIRST  q  ON fs.fullvisitorid = q.fullvisitorid
LEFT  JOIN   LATER_PURCHASERS p  ON fs.fullvisitorid = p.fullvisitorid;
