$$
  const { ethers } = require('ethers');
  const ALPHABET   = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
  function encode58(bytes) {
      let digits = [0];
      for (const byte of bytes) {
          for (let j = 0; j < digits.length; j++) digits[j] <<= 8;
          digits[0] += byte;
          let carry = 0;
          for (let k = 0; k < digits.length; k++) {
              digits[k] += carry;
              carry = (digits[k] / 58) | 0;
              digits[k] %= 58;
          }
          while (carry) { digits.push(carry % 58); carry = (carry / 58) | 0; }
      }
      return digits.reverse().map(d => ALPHABET[d]).join('');
  }
  if (!hex || hex.length !== 42) return null;
  const addrBytes = Uint8Array.from(Buffer.from(hex.slice(2), 'hex'));
  const tronAddr  = Uint8Array.from([0x41, ...addrBytes]);
  const hash1     = ethers.utils.arrayify(ethers.utils.sha256(tronAddr));
  const hash2     = ethers.utils.arrayify(ethers.utils.sha256(hash1));
  const checksum  = hash2.slice(0, 4);
  const full      = Uint8Array.from([...tronAddr, ...checksum]);
  return encode58(full);
$$;
```

