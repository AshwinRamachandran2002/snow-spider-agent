```sql
-- Description: Identify the 20 calendar days with the highest number of log records in the LOGS table;  
--              block timestamps (stored in micro-seconds) are converted to Snowflake timestamps by  
--              dividing by 1 000 000 and wrapping with TO_TIMESTAMP_NTZ, then truncated to the day.
SELECT
       DATE_TRUNC('DAY', TO_TIMESTAMP_NTZ("block_timestamp" / 1e6)) AS "log_day",
       COUNT(*)                                                     AS "log_count"
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
GROUP BY "log_day"
ORDER BY "log_count" DESC
LIMIT 20;
```
