/*  Top-3 largest USDT “Transfer” events on TRON
    – converts the hexadecimal sender / receiver to TronLink Base-58 by
      calling the JavaScript UDF  hexToTron(…)
    – divides the raw value by 1 000 000 to obtain the final USDT amount  */

WITH transfers AS (
    SELECT
           "BLOCK_NUMBER"                                                      AS "block_number",
           hexToTron( PARSE_JSON("ARGS")[0]::STRING )                          AS "from_address_tron",
           hexToTron( PARSE_JSON("ARGS")[1]::STRING )                          AS "to_address_tron",
           TRY_TO_DECIMAL( PARSE_JSON("ARGS")[2]::STRING ,38,0 ) / 1e6         AS "usdt_amount"
    FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE  "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'   -- Transfer(...)
      AND  LOWER("ADDRESS") = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'                        -- USDT contract
      AND  TRY_TO_DECIMAL( PARSE_JSON("ARGS")[2]::STRING ,38,0 ) IS NOT NULL                      -- safety check
)
SELECT *
FROM   transfers
ORDER  BY "usdt_amount" DESC NULLS LAST
LIMIT  3;
```
