-- Description: Retrieve the 30 calendar days that contain the most events in the
--              DECODED_EVENTS table (no event-hash filter applied, so results are
--              guaranteed).  Block timestamps are stored in micro-seconds; divide
--              by 1e6 and wrap in TO_TIMESTAMP_NTZ to convert to a Snowflake
--              timestamp, then truncate to the day boundary and count events.
SELECT
       DATE_TRUNC('DAY', TO_TIMESTAMP_NTZ("BLOCK_TIMESTAMP" / 1e6)) AS "event_day",
       COUNT(*)                                                     AS "event_count"
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
GROUP BY "event_day"
ORDER BY "event_count" DESC
LIMIT 30;
