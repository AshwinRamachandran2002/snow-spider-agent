-- Description: Some Transfer events contain numbers exceeding Snowflake’s 38-digit limit. 
--              To avoid overflow, wrap the value in TRY_TO_DECIMAL(…,38,0); this returns NULL 
--              when the cast fails.  After converting, divide by 1 000 000 to get the 6-decimal 
--              token amount, drop NULLs, and sort to surface the 20 largest valid transfers.
SELECT *
FROM (
        SELECT
               "BLOCK_NUMBER",
               PARSE_JSON("ARGS")[0]::STRING                         AS "from_hex",
               PARSE_JSON("ARGS")[1]::STRING                         AS "to_hex",
               TRY_TO_DECIMAL(PARSE_JSON("ARGS")[2]::STRING,38,0) 
                 / 1000000                                           AS "token_amount_6dp"
