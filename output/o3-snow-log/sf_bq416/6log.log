```sql
-- Description: Locate the single address with the most negative net-USDT balance on Arbitrum,
--              calculated as USDT minted to the address minus USDT the address has burned
--              (sent to the zero-address).  A negative result means the address has burned
--              more than it received from mints.  TRY_TO_DECIMAL converts raw values safely,
--              dividing by 1 000 000 yields the 6-decimal USDT amount before aggregation.
WITH base AS (
    SELECT
           PARSE_JSON("ARGS")[0]::STRING                            AS from_hex,
           PARSE_JSON("ARGS")[1]::STRING                            AS to_hex,
           TRY_TO_DECIMAL(PARSE_JSON("ARGS")[2]::STRING, 38, 0) / 1e6 AS usdt_amount
    FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE  "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
      AND  TRY_TO_DECIMAL(PARSE_JSON("ARGS")[2]::STRING, 38, 0) IS NOT NULL
), mint_burn AS (
    SELECT
           CASE
               WHEN from_hex ILIKE '0x0000000000000000000000000000000000000000' THEN to_hex
               ELSE from_hex
           END                                                 AS addr,
           CASE WHEN from_hex ILIKE '0x0000000000000000000000000000000000000000' THEN usdt_amount ELSE 0 END AS minted,
           CASE WHEN to_hex   ILIKE '0x0000000000000000000000000000000000000000' THEN usdt_amount ELSE 0 END AS burned
    FROM base
    WHERE from_hex ILIKE '0x0000000000000000000000000000000000000000'
       OR to_hex   ILIKE '0x0000000000000000000000000000000000000000'
)
SELECT
       addr                          AS "address_hex",
       SUM(minted)                   AS "total_minted_usdt",
       SUM(burned)                   AS "total_burned_usdt",
       SUM(minted) - SUM(burned)     AS "net_usdt_balance"
FROM   mint_burn
GROUP BY addr
ORDER BY "net_usdt_balance" ASC   -- most negative = biggest net burner
LIMIT 1;
```
