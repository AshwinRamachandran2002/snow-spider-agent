```sql
-- Description: Show daily USDT transfer volume for the last 30 days on Arbitrum.  
--              The block timestamp is stored in micro-seconds; dividing by 1e6 and  
--              wrapping in TO_TIMESTAMP_NTZ converts it to a Snowflake timestamp.  
--              TRY_TO_DECIMAL safely casts the raw value (ARGS[2]) before scaling  
--              by 1 000 000 to obtain 6-decimal USDT units, which are then summed  
--              per calendar day, ordered with the most recent day first.
SELECT
       DATE_TRUNC('DAY', TO_TIMESTAMP_NTZ("BLOCK_TIMESTAMP" / 1e6)) AS transfer_day,
       COUNT(*)                                                     AS transfer_count,
       SUM(TRY_TO_DECIMAL(PARSE_JSON("ARGS")[2]::STRING,38,0)/1e6)  AS total_usdt
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE  "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND  TRY_TO_DECIMAL(PARSE_JSON("ARGS")[2]::STRING,38,0) IS NOT NULL
  AND  TO_TIMESTAMP_NTZ("BLOCK_TIMESTAMP" / 1e6) >= DATEADD(DAY, -30, CURRENT_TIMESTAMP())
GROUP BY transfer_day
ORDER BY transfer_day DESC
LIMIT 30;
