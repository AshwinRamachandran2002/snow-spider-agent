--ordered by human-readable amount.  These rows illustrate extreme transfers in the dataset.
SELECT
    "ADDRESS",
    "BLOCK_NUMBER",
    "ARGS"::VARIANT[0]::STRING AS "FROM_ADDRESS",
    "ARGS"::VARIANT[1]::STRING AS "TO_ADDRESS",
    ("ARGS"::VARIANT[2]::NUMBER) / 1000000 AS "TOKEN_AMOUNT"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
ORDER BY "TOKEN_AMOUNT" DESC
LIMIT 3;
```
