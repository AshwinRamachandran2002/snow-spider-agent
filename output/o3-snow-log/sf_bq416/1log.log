--(column names quoted in lowercase to match the table’s case-sensitive identifiers).
SELECT
    COUNT(*) AS "decoded_event_rows"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "address" ILIKE '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c';
```

```sql
--Description: Show a sample of decoded Transfer events (if any) for the TRON-USDT contract,
--using quoted lowercase column names and filtering on the standard ERC-20 Transfer hash.
SELECT
    "block_number",
    "log_index",
    "transaction_hash",
    "event_signature",
    "args"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "address" ILIKE '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND "event_hash" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
LIMIT 20;
```

```sql
--Description: Parse the JSON `args` array for any TRON-USDT Transfer events, extracting
--sender, recipient, and raw value (index 0, 1, 2 respectively).
SELECT
    "block_number",
    "args"::VARIANT[0]::STRING  AS "from_address",
    "args"::VARIANT[1]::STRING  AS "to_address",
    "args"::VARIANT[2]::NUMBER  AS "raw_value"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "address" ILIKE '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND "event_hash" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
LIMIT 20;
```

```sql
--Description: Compute human-readable USDT amounts (divide by 1,000,000) and list the
--largest 20 TRON-USDT transfers, if any exist.
SELECT
    "block_number",
    "args"::VARIANT[0]::STRING AS "from_address",
    "args"::VARIANT[1]::STRING AS "to_address",
    ("args"::VARIANT[2]::NUMBER) / 1000000 AS "usdt_amount"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "address" ILIKE '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND "event_hash" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
ORDER BY "usdt_amount" DESC
LIMIT 20;
```

