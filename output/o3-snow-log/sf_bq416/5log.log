```sql
--Description: Some ERC-20 “amount” values exceed Snowflake’s fixed-precision NUMBER limit (38 digits),
--triggering the earlier conversion error.  To avoid this, cast the string to DOUBLE with TRY_TO_DOUBLE,
--which returns NULL when the value cannot be represented; then scale by 1 000 000 to obtain the USDT
--amount, filter out NULL conversions, and return the 20 largest transfers seen on Arbitrum whose first
--topic hash equals the standard Transfer event (0xddf252ad…).
SELECT  "BLOCK_NUMBER",
        PARSE_JSON("ARGS")[0]::STRING                      AS "from_hex",
        PARSE_JSON("ARGS")[1]::STRING                      AS "to_hex",
        TRY_TO_DOUBLE(PARSE_JSON("ARGS")[2]::STRING) / 1e6 AS "usdt_amount"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE   "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
