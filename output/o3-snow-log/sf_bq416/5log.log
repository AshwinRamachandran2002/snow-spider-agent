Query:
--Description: Retrieve the three largest ERC-20 Transfers (by amount) using TRY_TO_DOUBLE to avoid overflow
SELECT
    e."BLOCK_NUMBER",
    e."TRANSACTION_HASH",
    e."LOG_INDEX",
    PARSE_JSON(e."ARGS")[0]::STRING                      AS "from_hex",
    PARSE_JSON(e."ARGS")[1]::STRING                      AS "to_hex",
    TRY_TO_DOUBLE(PARSE_JSON(e."ARGS")[2]::STRING) / 1e6 AS "usdt_amount"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" e
WHERE e."EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND TRY_TO_DOUBLE(PARSE_JSON(e."ARGS")[2]::STRING) IS NOT NULL
ORDER BY "usdt_amount" DESC
LIMIT 3
