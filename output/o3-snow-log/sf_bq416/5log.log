```sql
/* ---------------------------------------------------------------------------
   1)  Build a temporary JavaScript UDF that converts an Ethereum-style
       0x-hex address into its Base58 “TronLink” representation.
   2)  Use the UDF to extract the largest three USDT transfers that
       occurred on the TRON USDT contract, dividing the raw value by
       1,000,000 to obtain the human-readable amount.
---------------------------------------------------------------------------*/
CREATE OR REPLACE TEMPORARY FUNCTION HEXTOTRON(hex STRING)
RETURNS STRING
LANGUAGE JAVASCRIPT
STRICT
AS
$$
/* ---- helper to Base58-encode a byte buffer ---- */
function encode58(buf) {
  const alphabet = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
  let digits = [0];
  for (let i = 0; i < buf.length; i++) {
    let carry = buf[i];
    for (let j = 0; j < digits.length; j++) {
      const num   = digits[j] * 256 + carry;
      digits[j]   = num % 58;
      carry       = (num / 58) | 0;
    }
    while (carry) {
      digits.push(carry % 58);
      carry = (carry / 58) | 0;
    }
  }
  for (let k = 0; buf[k] === 0 && k < buf.length - 1; k++) {
    digits.push(0);
  }
  return digits.reverse().map(d => alphabet[d]).join('');
}

/* ---- main conversion routine ---- */
return (function (hexIn) {
  if (hexIn === null)                 return null;
  hexIn = hexIn.toLowerCase();
  if (hexIn.startsWith('0x'))         hexIn = hexIn.slice(2);
  if (hexIn.length !== 40)            return null;    // must be 20 bytes

  /* prepend the TRON network byte 0x41 */
  const addrBytes = Buffer.alloc(21);
  addrBytes[0] = 0x41;
  for (let i = 0; i < 20; i++) {
    addrBytes[i + 1] = parseInt(hexIn.substr(i * 2, 2), 16);
  }

  /* double-SHA256 for checksum */
  const crypto  = require('crypto');
  const hash1   = crypto.createHash('sha256').update(addrBytes).digest();
  const hash2   = crypto.createHash('sha256').update(hash1).digest();
  const chkSum  = hash2.slice(0, 4);

  /* concatenate and encode Base58 */
  const full    = Buffer.concat([addrBytes, chkSum]);
  return encode58(full);
})(hex);
$$;

/* -------------------- main query -------------------- */
SELECT
        d."BLOCK_NUMBER"                                                               AS "block_number",
        HEXTOTRON( PARSE_JSON(d."ARGS")[0]::STRING )                                   AS "from_tronlink",
        HEXTOTRON( PARSE_JSON(d."ARGS")[1]::STRING )                                   AS "to_tronlink",
        TRY_TO_DOUBLE( PARSE_JSON(d."ARGS")[2]::STRING ) / 1e6                         AS "usdt_amount"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
WHERE   d."EVENT_HASH"  = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'  -- Transfer
  AND   LOWER(d."ADDRESS") = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'                          -- USDT TRON contract
  AND   TRY_TO_DOUBLE( PARSE_JSON(d."ARGS")[2]::STRING ) IS NOT NULL
ORDER BY
        "usdt_amount" DESC NULLS LAST
LIMIT 3;
