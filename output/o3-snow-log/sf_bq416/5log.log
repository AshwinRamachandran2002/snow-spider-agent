/* ---------- helper: encode byte-array to Base58 ---------- */
function encode58(bytes) {
  let digits = [0];
  for (let i = 0; i < bytes.length; i++) {
    let carry = bytes[i];
    for (let j = 0; j < digits.length; j++) {
      const num = digits[j] * 256 + carry;
      digits[j] = num % 58;
      carry     = (num / 58) | 0;
    }
    while (carry) {
      digits.push(carry % 58);
      carry = (carry / 58) | 0;
    }
  }
  /* add “1” for each leading 0x00 byte */
  for (let k = 0; bytes[k] === 0 && k < bytes.length - 1; k++) digits.push(0);
  return digits.reverse().map(d => ALPHABET[d]).join('');
}

/* ---------- main conversion ---------- */
return (function (hexIn) {
  if (hexIn === null)                 return null;
  hexIn = hexIn.toLowerCase();
  if (hexIn.startsWith('0x'))         hexIn = hexIn.slice(2);
  if (hexIn.length !== 40)            return null;                // must be 20-byte address

