    a[0]::STRING                             AS FROM_HEX,
    a[1]::STRING                             AS TO_HEX,
    TRY_TO_NUMBER(a[2]::STRING) / 1000000    AS USDT_AMOUNT
FROM (
    SELECT
        BLOCK_NUMBER,
        PARSE_JSON(ARGS) AS a
    FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
    WHERE EVENT_HASH = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
) t
WHERE LENGTH(a[2]::STRING) <= 38
ORDER BY USDT_AMOUNT DESC
LIMIT 20
