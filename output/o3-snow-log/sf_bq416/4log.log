--Description: Retrieve transfers with the raw value divided by 1 000 000 to obtain human-readable USDT amounts.
SELECT
    BLOCK_NUMBER,
    PARSE_JSON(ARGS)[0]::STRING          AS FROM_HEX,
    PARSE_JSON(ARGS)[1]::STRING          AS TO_HEX,
    (PARSE_JSON(ARGS)[2]::NUMBER / 1e6)  AS USDT_AMOUNT
