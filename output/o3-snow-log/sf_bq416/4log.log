/* ---------------------------------------------------------------------------
   Define a temporary JavaScript UDF that converts an Ethereum-style 0x address
   into the corresponding TRON “TronLink” (Base58Check) address.
--------------------------------------------------------------------------- */
CREATE OR REPLACE TEMPORARY FUNCTION "HEX_TO_TRON"(hex STRING)
RETURNS STRING
LANGUAGE JAVASCRIPT
AS
$$
/* ---------- helper: Base58 encoder (Bitcoin / TRON alphabet) ----------- */
function encode58(bytes) {
  const ALPHABET = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
  let digits = [0];
  for (let i = 0; i < bytes.length; ++i) {
    let carry = bytes[i];
    for (let j = 0; j < digits.length; ++j) {
      carry += digits[j] << 8;
      digits[j] = carry % 58;
      carry = (carry / 58) | 0;
    }
    while (carry) {
      digits.push(carry % 58);
      carry = (carry / 58) | 0;
    }
  }
  /* add leading-zero equivalents */
  for (let k = 0; k < bytes.length && bytes[k] === 0; ++k) {
    digits.push(0);
  }
  return digits.reverse().map(d => ALPHABET[d]).join('');
}
/* --------------------------- main wrapper ------------------------------ */
return (function (hex) {
  if (!hex) return null;
  if (hex.startsWith('0x') || hex.startsWith('0X')) {
    hex = hex.slice(2);
  }
  /* TRON main-net prefix (0x41) + 20-byte address  */
  const addrHex   = '41' + hex.padStart(40, '0').toLowerCase();
  const addrBytes = Array.from(Buffer.from(addrHex, 'hex'));

  const crypto  = require('crypto');
  const hash1   = crypto.createHash('sha256').update(Buffer.from(addrBytes)).digest();
  const hash2   = crypto.createHash('sha256').update(hash1).digest();
  const checksum = Array.from(hash2.slice(0, 4));

  const full = Uint8Array.from(addrBytes.concat(checksum));
  return encode58(full);
})(hex);
$$;

/* ---------------------------------------------------------------------------
   Query the TRON–USDT contract and return the 3 largest transfers
   (values converted from raw units to “human” units by dividing by 1e6).
--------------------------------------------------------------------------- */
SELECT
    "BLOCK_NUMBER",
    HEX_TO_TRON( PARSE_JSON("ARGS")[0]::STRING ) AS "FROM_ADDRESS_TRON",
    HEX_TO_TRON( PARSE_JSON("ARGS")[1]::STRING ) AS "TO_ADDRESS_TRON",
    ( PARSE_JSON("ARGS")[2]::NUMBER / 1e6 )       AS "USDT_AMOUNT"
FROM  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
WHERE "ADDRESS"     = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'   -- TRON-USDT contract
  AND "EVENT_HASH"  = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef' -- Transfer
ORDER BY "USDT_AMOUNT" DESC NULLS LAST
LIMIT 3;
