```sql
--Description: Identify the three largest USDT transfers emitted by the Arbitrum-USDT contract
--(0xfd086b…) by selecting the Transfer event hash, extracting sender/receiver addresses from
--the ARGS JSON array, converting the raw 6-decimal token amount to human-readable USDT
--(divide by 1,000,000), and ordering by that amount in descending order.
SELECT
    BLOCK_NUMBER,
    PARSE_JSON(ARGS)[0]::STRING          AS FROM_HEX,
    PARSE_JSON(ARGS)[1]::STRING          AS TO_HEX,
    (PARSE_JSON(ARGS)[2]::NUMBER / 1e6)  AS USDT_AMOUNT
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.DECODED_EVENTS
WHERE ADDRESS    = '0xfd086bc7cd5c481dcc9c85ebe478a1c0b69fcbb9'        -- Arbitrum USDT contract
  AND EVENT_HASH = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'  -- Transfer
ORDER BY USDT_AMOUNT DESC
LIMIT 3;
```
