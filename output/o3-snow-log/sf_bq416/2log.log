/* ----------------------------------------------------------
   Helper UDF – convert 0x-style hex addresses to TronLink
   Base58Check strings (prefix 0x41 + double-SHA256 checksum)
---------------------------------------------------------- */
CREATE OR REPLACE TEMPORARY FUNCTION "HEX_TO_TRON"(hex_addr STRING)
RETURNS STRING
LANGUAGE JAVASCRIPT
AS
$$
function encode58(buf) {                 // minimal Base58 encoder
  const alphabet = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
  let digits = [0];
  for (let i = 0; i < buf.length; i++) {
    let carry = buf[i];
    for (let j = 0; j < digits.length; j++) {
      carry += digits[j] << 8;
      digits[j] = carry % 58;
      carry = (carry / 58) | 0;
    }
    while (carry) { digits.push(carry % 58); carry = (carry / 58) | 0; }
  }
  let out = '';
  for (let k = 0; buf[k] === 0 && k < buf.length - 1; k++) out += alphabet[0];
  for (let q = digits.length - 1; q >= 0; q--) out += alphabet[digits[q]];
  return out;
}
function sha256(b) { return require('crypto').createHash('sha256').update(Buffer.from(b)).digest(); }

if (hex_addr === null) return null;
let clean = hex_addr.toLowerCase().replace(/^0x/, '');
if (clean.length !== 40) return null;                            // not a 20-byte address

const addrBytes  = Buffer.concat([Buffer.from([0x41]), Buffer.from(clean, 'hex')]);
const checksum   = sha256(sha256(addrBytes)).slice(0, 4);
return encode58(Buffer.concat([addrBytes, checksum]));
$$;

/* ----------------------------------------------------------
   Query – three largest USDT transfers on the TRON blockchain
---------------------------------------------------------- */
WITH usdt_transfers AS (
  SELECT
      "BLOCK_NUMBER",
      HEX_TO_TRON(PARSE_JSON("ARGS")[0]::STRING)           AS "from_address_tron",
      HEX_TO_TRON(PARSE_JSON("ARGS")[1]::STRING)           AS "to_address_tron",
      TRY_TO_DECIMAL(PARSE_JSON("ARGS")[2]::STRING,38,0)
/ 1e6                                                     AS "usdt_amount"
  FROM  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
  WHERE LOWER("ADDRESS") = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'   -- USDT (TRON)
    AND "EVENT_HASH"   = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef' -- Transfer
    AND TRY_TO_DECIMAL(PARSE_JSON("ARGS")[2]::STRING,38,0) IS NOT NULL
)
SELECT *
FROM   usdt_transfers
ORDER BY "usdt_amount" DESC NULLS LAST
LIMIT 3;
```
