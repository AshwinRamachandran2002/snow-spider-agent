--Description: 9) (Requires `hexToTron` UDF) Retrieve the three largest ERC-20
--             Transfer events and convert addresses to TRON Base58.  Use
--             TRY_TO_DECIMAL to safely cast ARGS[2]; rows that overflow
--             Snowflake precision are skipped.
SELECT  d."BLOCK_NUMBER",
        hexToTron(PARSE_JSON(d."ARGS")[0]::STRING)                 AS "from_address_tron",
        hexToTron(PARSE_JSON(d."ARGS")[1]::STRING)                 AS "to_address_tron",
        TRY_TO_DECIMAL(PARSE_JSON(d."ARGS")[2]::STRING, 38, 0)
/ 1e6                                                               AS "token_amount_6dp"
