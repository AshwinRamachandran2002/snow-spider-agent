--Description: 10) Aggregate the total successfully-converted token value (6-decimal
--             units) per block.  TRY_TO_DECIMAL safely casts ARGS[2] only when the
--             number fits Snowflake’s 38-digit precision; NULLs are excluded.
--             Divide the summed value by 1 000 000 and list the 20 blocks with the
--             highest volumes of ERC-20 Transfer events.
SELECT  "BLOCK_NUMBER",
        SUM(TRY_TO_DECIMAL(PARSE_JSON("ARGS")[2]::STRING, 38, 0)) / 1e6
