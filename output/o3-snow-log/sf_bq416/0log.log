```sql
--Description: Retrieve 20 decoded USDT transfer events with parsed columns  
--for sender, receiver, and raw value (uint256) to validate extraction logic.
SELECT 
  t."BLOCK_NUMBER",
  TRY_PARSE_JSON(t."ARGS")[0]::STRING                  AS "from_address",
  TRY_PARSE_JSON(t."ARGS")[1]::STRING                  AS "to_address",
  TRY_PARSE_JSON(t."ARGS")[2]::NUMBER                  AS "raw_value"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS" t
WHERE t."ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND t."EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
LIMIT 20;
