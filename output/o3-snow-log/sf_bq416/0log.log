```sql
--Description: Convert the raw_value (6-decimals) to human-readable USDT by 
--dividing by 1 000 000, then sort to display the 20 largest transfers observed.
SELECT 
  t."BLOCK_NUMBER",
  TRY_PARSE_JSON(t."ARGS")[0]::STRING                                         AS "from_address",
  TRY_PARSE_JSON(t."ARGS")[1]::STRING                                         AS "to_address",
  (TRY_PARSE_JSON(t."ARGS")[2]::NUMBER / 1_000_000)                           AS "usdt_amount"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS" t
WHERE t."ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND t."EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
ORDER BY "usdt_amount" DESC
LIMIT 20;
```

```sql
--Description: Same as above but GROUP BY block-number & tx-hash so duplicates
--inside the same transaction don’t inflate counts; list top 20 grouped rows.
SELECT 
  t."BLOCK_NUMBER",
  t."TRANSACTION_HASH",
  MAX(TRY_PARSE_JSON(t."ARGS")[2]::NUMBER)   / 1_000_000  AS "usdt_amount"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS" t
WHERE t."ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND t."EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
GROUP BY t."BLOCK_NUMBER", t."TRANSACTION_HASH"
ORDER BY "usdt_amount" DESC
LIMIT 20;
```

```sql
--Description: Assuming a JavaScript UDF named hexToTron(hex_string) exists 
--(per the external-knowledge section) convert receiver addresses into 
--TronLink Base58 format for the 20 biggest transfers.
SELECT 
  t."BLOCK_NUMBER",
  TRY_PARSE_JSON(t."ARGS")[0]::STRING                                      AS "from_eth",
  hexToTron(TRY_PARSE_JSON(t."ARGS")[1]::STRING)                           AS "to_tron",
  (TRY_PARSE_JSON(t."ARGS")[2]::NUMBER / 1_000_000)                        AS "usdt_amount"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS" t
WHERE t."ADDRESS" = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
  AND t."EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
ORDER BY "usdt_amount" DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER query – return the three largest USDT transfers
