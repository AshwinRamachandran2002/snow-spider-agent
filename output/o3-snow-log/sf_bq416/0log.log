--Description: Very large uint256 “value” fields can overflow Snowflake’s fixed
--precision NUMBER.  Convert the value element to DOUBLE via TRY_TO_DOUBLE,
--which returns NULL rather than throwing on overflow, then divide by 1 000 000
--to express whole-token units.  Exclude NULLs and list the 20 biggest ERC-20
--Transfer events across every contract.
SELECT
  t."BLOCK_NUMBER",
  TRY_PARSE_JSON(t."ARGS")[0]::STRING                       AS "from_address",
  TRY_PARSE_JSON(t."ARGS")[1]::STRING                       AS "to_address",
  (TRY_TO_DOUBLE(TRY_PARSE_JSON(t."ARGS")[2]) / 1000000)    AS "token_amount"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS" t
WHERE t."EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND TRY_TO_DOUBLE(TRY_PARSE_JSON(t."ARGS")[2]) IS NOT NULL
ORDER BY "token_amount" DESC
LIMIT 20;
