      TRON/TronLink address.
---------------------------------------------------------------------------*/
CREATE OR REPLACE TEMPORARY FUNCTION HEX_TO_TRON(hex_addr STRING)
RETURNS STRING
LANGUAGE JAVASCRIPT
AS
$$
/* ---------- Base58 helper ---------- */
function encode58(buffer) {
  const alphabet = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
  var digits = [0];
  for (var i = 0; i < buffer.length; i++) {
    var carry = buffer[i];
    for (var j = 0; j < digits.length; j++) {
      carry += digits[j] << 8;
      digits[j] = carry % 58;
      carry = (carry / 58) | 0;
    }
    while (carry) {
      digits.push(carry % 58);
      carry = (carry / 58) | 0;
    }
  }
  var str = "";
  for (var k = digits.length - 1; k >= 0; k--) { str += alphabet[digits[k]]; }
  for (var q = 0; buffer[q] === 0 && q < buffer.length - 1; q++) { str = alphabet[0] + str; }
  return str;
}

/* ---------- Main body ---------- */
if (!hex_addr)                  { return null; }
hex_addr = hex_addr.toLowerCase().replace(/^0x/, "");
if (hex_addr.length !== 40)     { return null; }

var prefixAddr   = Buffer.from("41" + hex_addr, "hex");          // 0x41 + 20-byte addr
