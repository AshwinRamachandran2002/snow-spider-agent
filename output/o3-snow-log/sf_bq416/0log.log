/*--------------------------------------------------------------------------
  Create a temporary JavaScript UDF that converts an Ethereum–style hex
  address (20-byte / 40-char, with or without the 0x prefix) into the
  Base58-encoded TRON/TronLink representation.
---------------------------------------------------------------------------*/
CREATE OR REPLACE TEMPORARY FUNCTION HEX_TO_TRON(hex_addr STRING)
RETURNS STRING
LANGUAGE JAVASCRIPT
AS
$$
/* ---------- Base58 helper (Bitcoin / TRON alphabet) ---------- */
function encode58(buffer) {
  const alphabet = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
  let digits = [0];
  for (let i = 0; i < buffer.length; i++) {
    let carry = buffer[i];
    for (let j = 0; j < digits.length; j++) {
      carry += digits[j] << 8;
      digits[j] = carry % 58;
      carry = (carry / 58) | 0;
    }
    while (carry) {
      digits.push(carry % 58);
      carry = (carry / 58) | 0;
    }
  }
  let str = "";
  for (let k = digits.length - 1; k >= 0; k--) {
    str += alphabet[digits[k]];
  }
  /* keep leading-zero bytes */
  for (let q = 0; buffer[q] === 0 && q < buffer.length - 1; q++) {
    str = alphabet[0] + str;
  }
  return str;
}

/* ---------- Main body ---------- */
if (!hex_addr) return null;
hex_addr = hex_addr.toLowerCase().replace(/^0x/, "");
if (hex_addr.length !== 40) return null;          // must be 20 bytes

/* TRON adds the network prefix 0x41 before the 20-byte address */
const addressBytes = Buffer.from("41" + hex_addr, "hex");

/* Double-SHA256 checksum (first 4 bytes of second hash) */
const crypto = require("crypto");
const hash1  = crypto.createHash("sha256").update(addressBytes).digest();
const hash2  = crypto.createHash("sha256").update(hash1).digest();
const check  = hash2.slice(0, 4);

/* Append checksum, then Base58-encode */
return encode58(Buffer.concat([addressBytes, check]));
$$;

/*--------------------------------------------------------------------------
  Query: Top 3 largest USDT (TRC-20) transfers ever observed.
  – Contract address  : 0xa614f803b6fd780986a42c78ec9c7f77e6ded13c
  – Event signature   : Transfer(address,address,uint256)
  – Convert raw value : divide by 1,000,000 (USDT has 6 decimals)
---------------------------------------------------------------------------*/
SELECT
    de."BLOCK_NUMBER"                                                              AS "block_number",
    HEX_TO_TRON(TRY_PARSE_JSON(de."ARGS")[0]::STRING)                              AS "from_address_tron",
    HEX_TO_TRON(TRY_PARSE_JSON(de."ARGS")[1]::STRING)                              AS "to_address_tron",
    (TRY_PARSE_JSON(de."ARGS")[2]::NUMBER) / 1_000_000                             AS "usdt_amount"
FROM  GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."DECODED_EVENTS"   de
WHERE de."EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
  AND LOWER(de."ADDRESS") = '0xa614f803b6fd780986a42c78ec9c7f77e6ded13c'
ORDER BY "usdt_amount" DESC NULLS LAST
LIMIT 3;
