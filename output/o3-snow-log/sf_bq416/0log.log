var checksum     = crypto.createHash("sha256").update(
                     crypto.createHash("sha256").update(prefixAddr).digest()
                   ).digest().slice(0, 4);                       // double-SHA256, first 4 bytes
return encode58(Buffer.concat([prefixAddr, checksum]));
$$;

