Query:
--Description: Identify the 20 largest scaled “Transfer” amounts (any contract) safely, using TRY_TO_DOUBLE for big integers.
SELECT  
    "BLOCK_NUMBER",
    PARSE_JSON("ARGS")[0]::STRING                        AS "from_addr_hex",
    PARSE_JSON("ARGS")[1]::STRING                        AS "to_addr_hex",
    TRY_TO_DOUBLE(PARSE_JSON("ARGS")[2]::STRING) / 1e6   AS "usdt_amount"
