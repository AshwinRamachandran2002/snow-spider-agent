```sql
--Description: Pull the 20 largest “Transfer” events (by raw VALUE) from the decoded
-- dataset.  We flatten the ARGS JSON array to grab element-0 (from), element-1 (to),
-- and element-2 (value).  Because VALUE integers can exceed NUMBER(38) precision,
-- we wrap the cast in TRY_TO_DOUBLE, which converts huge integers to IEEE-754 double
-- (returning NULL only if the number is outside the double range).  We then divide
-- by 1 000 000 to express the amount in standard 6-decimal USDT units and sort by
-- this scaled figure.
SELECT
    "BLOCK_NUMBER",
    PARSE_JSON("ARGS")[0]::STRING                       AS "from_addr_hex",
    PARSE_JSON("ARGS")[1]::STRING                       AS "to_addr_hex",
