Query:
--Description: CTE that extracts fields once, then selects the top-3 largest transfers,
-- keeping destination address in hex (hexToTron removed).
WITH transfers AS (
    SELECT
        "BLOCK_NUMBER",
        PARSE_JSON("ARGS")[0]::STRING                      AS "from_addr_hex",
        PARSE_JSON("ARGS")[1]::STRING                      AS "to_addr_hex",
        TRY_TO_DOUBLE(PARSE_JSON("ARGS")[2]::STRING) / 1e6 AS "usdt_amount"
    FROM  "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS"
    WHERE "EVENT_HASH" = '0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef'
)
SELECT
    "BLOCK_NUMBER",
    "from_addr_hex",
    "to_addr_hex",
    "usdt_amount"
FROM  transfers
ORDER BY "usdt_amount" DESC
LIMIT 3
