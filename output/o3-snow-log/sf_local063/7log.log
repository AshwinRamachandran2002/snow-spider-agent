--Description: Shares by product-quarter and percentage-point change
-- Re-implements “top 20 %” logic with APPROX_PERCENTILE() (Snowflake-supported),
-- replaces the invalid APPROX_PERCENTILE_DISC() call, and adds an explicit
-- prod_total + p80 CTE to obtain the 80-th-percentile cut-off.
WITH growth_cities AS (                    -- placeholder; plug in real logic
    SELECT 'dummy_city' AS "city"
),
sales_qtr AS (                             -- promo-999 sales by product & quarter
    SELECT t."calendar_quarter_id" AS "qtr",
           s."prod_id",
           SUM(s."amount_sold")    AS "prod_sales"
    FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES      s
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES      t  ON s."time_id" = t."time_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS  cu ON s."cust_id" = cu."cust_id"
    WHERE  cu."cust_city" IN (SELECT "city" FROM growth_cities)
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" IN (1772, 1776)
    GROUP BY t."calendar_quarter_id", s."prod_id"
),
prod_total AS (                            -- total sales per product
    SELECT "prod_id",
           SUM("prod_sales") AS "total_sales"
    FROM   sales_qtr
    GROUP BY "prod_id"
),
p80 AS (                                   -- 80-th percentile threshold
    SELECT APPROX_PERCENTILE("total_sales", 0.80) AS "cutoff"
    FROM   prod_total
),
top20 AS (                                 -- products in the top 20 %
    SELECT pt."prod_id"
    FROM   prod_total pt, p80
    WHERE  pt."total_sales" >= p80."cutoff"
),
tot_qtr AS (                               -- total sales per quarter
    SELECT "qtr",
           SUM("prod_sales") AS "tot"
    FROM   sales_qtr
    GROUP BY "qtr"
),
share_qtr AS (                             -- product share within quarter
    SELECT s."prod_id",
           s."qtr",
           s."prod_sales" / t."tot" AS "share"
    FROM   sales_qtr s
    JOIN   tot_qtr  t ON s."qtr" = t."qtr"
)
SELECT sp."prod_id",
       MAX(CASE WHEN sp."qtr" = 1772 THEN sp."share" END) AS "share_2019q4",
       MAX(CASE WHEN sp."qtr" = 1776 THEN sp."share" END) AS "share_2020q4",
       MAX(CASE WHEN sp."qtr" = 1776 THEN sp."share" END) -
       MAX(CASE WHEN sp."qtr" = 1772 THEN sp."share" END) AS "pp_change"
FROM   share_qtr sp
WHERE  sp."prod_id" IN (SELECT "prod_id" FROM top20)
GROUP  BY sp."prod_id"
ORDER  BY ABS("pp_change") ASC
LIMIT 20;
