--Description:
-- Single-statement solution for the task
--   • Build city-level promo-999 sales for Q4-2019 (1772) & Q4-2020 (1776) and
--     keep only U.S. cities whose 2020-Q4 sales are ≥120 % of 2019-Q4 (growth_cities).
--   • Within those cities, aggregate sales per product for each quarter (prod_qtr).
--   • Compute total sales per product across both quarters; retain products whose
--     totals are in the top 20 % (top_products) using APPROX_PERCENTILE().
--   • Derive each product’s share of quarter sales and the percentage-point (pp)
--     change between the two quarters; pick the product with the smallest |pp-change|.
WITH city_qtr AS (          -- promo-999 sales per city & quarter
    SELECT cu."cust_city"              AS "city",
           t."calendar_quarter_id"     AS "qtr",
           SUM(s."amount_sold")        AS "city_sales"
    FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES      s
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES      t  ON s."time_id" = t."time_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS  cu ON s."cust_id" = cu."cust_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES  ct ON cu."country_id" = ct."country_id"
    WHERE  ct."country_name" ILIKE '%United%States%'
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" IN (1772, 1776)
    GROUP BY cu."cust_city", t."calendar_quarter_id"
), 
growth_cities AS (          -- cities with ≥20 % sales growth
    SELECT "city"
    FROM   city_qtr
    GROUP  BY "city"
    HAVING SUM(CASE WHEN "qtr" = 1772 THEN "city_sales" END) > 0
       AND SUM(CASE WHEN "qtr" = 1776 THEN "city_sales" END) >=
           1.20 * SUM(CASE WHEN "qtr" = 1772 THEN "city_sales" END)
), 
prod_qtr AS (               -- product sales per quarter inside growth cities
    SELECT s."prod_id",
           t."calendar_quarter_id"     AS "qtr",
           SUM(s."amount_sold")        AS "prod_sales"
    FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES      s
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES      t  ON s."time_id" = t."time_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS  cu ON s."cust_id" = cu."cust_id"
    WHERE  cu."cust_city" IN (SELECT "city" FROM growth_cities)
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" IN (1772, 1776)
    GROUP BY s."prod_id", t."calendar_quarter_id"
), 
prod_total AS (             -- total sales per product (both quarters)
    SELECT "prod_id",
           SUM("prod_sales") AS "total_sales"
    FROM   prod_qtr
    GROUP  BY "prod_id"
), 
top_products AS (           -- top 20 % products by total sales
    SELECT pt."prod_id"
    FROM   prod_total pt
    WHERE  pt."total_sales" >= (
           SELECT APPROX_PERCENTILE("total_sales", 0.80) FROM prod_total )
), 
tot_qtr AS (                -- overall sales per quarter
    SELECT "qtr",
           SUM("prod_sales") AS "quarter_sales"
    FROM   prod_qtr
    GROUP  BY "qtr"
), 
share_qtr AS (              -- product’s share of each quarter’s sales
    SELECT p."prod_id",
           p."qtr",
           p."prod_sales" / q."quarter_sales" AS "share"
    FROM   prod_qtr p
    JOIN   tot_qtr  q ON p."qtr" = q."qtr"
    WHERE  p."prod_id" IN (SELECT "prod_id" FROM top_products)
), 
change_calc AS (            -- compute pp-change of share
    SELECT "prod_id",
           MAX(CASE WHEN "qtr" = 1772 THEN "share" END) AS "share_2019q4",
           MAX(CASE WHEN "qtr" = 1776 THEN "share" END) AS "share_2020q4"
    FROM   share_qtr
    GROUP  BY "prod_id"
)
SELECT "prod_id",
       "share_2019q4",
       "share_2020q4",
       ("share_2020q4" - "share_2019q4") * 100 AS "percentage_point_change"
FROM   change_calc
ORDER  BY ABS(("share_2020q4" - "share_2019q4") * 100)      -- smallest |pp-change|
LIMIT 1;
