Query:
--Description: Shares by product-quarter and percentage-point change  
-- Returns up to 20 products (restricted to the top-20 % of total sales) whose  
-- promo-999 share changed the least between Q4-2019 (1772) and Q4-2020 (1776).  
WITH city_qtr AS (                         -- promo-999 sales per U.S. city & quarter
    SELECT cu."cust_city"              AS "city",
           t."calendar_quarter_id"     AS "qtr",
           SUM(s."amount_sold")        AS "city_sales"
    FROM   COMPLEX_ORACLE.COMPLEX_ORACLE."SALES"      s
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE."TIMES"      t  ON s."time_id" = t."time_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE."CUSTOMERS"  cu ON s."cust_id" = cu."cust_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE."COUNTRIES"  ct ON cu."country_id" = ct."country_id"
    WHERE  ct."country_name" ILIKE '%United%States%'
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" IN (1772, 1776)
    GROUP BY cu."cust_city", t."calendar_quarter_id"
), 
growth_cities AS (                         -- cities whose 2020-Q4 ≥120 % of 2019-Q4
    SELECT "city"
    FROM   city_qtr
    GROUP BY "city"
    HAVING SUM(CASE WHEN "qtr" = 1772 THEN "city_sales" END) > 0
       AND SUM(CASE WHEN "qtr" = 1776 THEN "city_sales" END) >=
           1.20 * SUM(CASE WHEN "qtr" = 1772 THEN "city_sales" END)
), 
sales_qtr AS (                             -- product sales per quarter in growth cities
    SELECT s."prod_id",
           t."calendar_quarter_id"     AS "qtr",
           SUM(s."amount_sold")        AS "prod_sales"
    FROM   COMPLEX_ORACLE.COMPLEX_ORACLE."SALES"      s
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE."TIMES"      t  ON s."time_id" = t."time_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE."CUSTOMERS"  cu ON s."cust_id" = cu."cust_id"
    WHERE  cu."cust_city" IN (SELECT "city" FROM growth_cities)
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" IN (1772, 1776)
    GROUP BY s."prod_id", t."calendar_quarter_id"
), 
prod_total AS (                            -- overall totals per product (both quarters)
    SELECT "prod_id",
           SUM("prod_sales") AS "total_sales"
    FROM   sales_qtr
    GROUP BY "prod_id"
), 
p80 AS (                                   -- 80-th percentile cut-off
    SELECT APPROX_PERCENTILE("total_sales", 0.80) AS "cutoff"
    FROM   prod_total
), 
top20 AS (                                 -- products in the top 20 % of total sales
    SELECT pt."prod_id"
    FROM   prod_total pt, p80
    WHERE  pt."total_sales" >= p80."cutoff"
), 
tot_qtr AS (                               -- total sales for each quarter
    SELECT "qtr",
           SUM("prod_sales") AS "tot_qtr_sales"
    FROM   sales_qtr
    GROUP BY "qtr"
), 
share_qtr AS (                             -- share of each top product within quarter
    SELECT s."prod_id",
           s."qtr",
           s."prod_sales" / t."tot_qtr_sales" AS "share"
    FROM   sales_qtr s
    JOIN   tot_qtr  t ON s."qtr" = t."qtr"
    WHERE  s."prod_id" IN (SELECT "prod_id" FROM top20)
)
SELECT sp."prod_id",
       MAX(CASE WHEN sp."qtr" = 1772 THEN sp."share" END) AS "share_2019q4",
       MAX(CASE WHEN sp."qtr" = 1776 THEN sp."share" END) AS "share_2020q4",
       (MAX(CASE WHEN sp."qtr" = 1776 THEN sp."share" END) -
        MAX(CASE WHEN sp."qtr" = 1772 THEN sp."share" END)) * 100 AS "percentage_point_change"
FROM   share_qtr sp
GROUP  BY sp."prod_id"
ORDER  BY ABS("percentage_point_change") ASC          -- smallest |pp-change|
LIMIT 20
