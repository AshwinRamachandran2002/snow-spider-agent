Query:
--Description: Product-level sales inside the growth cities, per quarter
WITH growth_cities AS (      --filtered list from previous step
  SELECT a."city"
  FROM  (
        SELECT c."cust_city" AS "city",
               t."calendar_quarter_id" AS "qtr",
               SUM(s."amount_sold") AS "tot"
        FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES     s
        JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
        JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
        JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES ct ON c."country_id" = ct."country_id"
        WHERE  ct."country_name" ILIKE '%United%States%'
          AND  s."promo_id" = 999
          AND  t."calendar_quarter_id" IN (1772,1776)
        GROUP  BY c."cust_city", t."calendar_quarter_id"
       ) a
  GROUP BY a."city"
  HAVING SUM(CASE WHEN a."qtr"=1772 THEN a."tot" END) > 0
     AND SUM(CASE WHEN a."qtr"=1776 THEN a."tot" END) >= 1.2*SUM(CASE WHEN a."qtr"=1772 THEN a."tot" END)
)
SELECT t."calendar_quarter_id",
       s."prod_id",
       SUM(s."amount_sold") AS "prod_sales"
FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES  s
JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES  t ON s."time_id" = t."time_id"
JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS cu ON s."cust_id" = cu."cust_id"
WHERE  cu."cust_city" IN (SELECT "city" FROM growth_cities)
  AND  s."promo_id" = 999
  AND  t."calendar_quarter_id" IN (1772,1776)
GROUP BY t."calendar_quarter_id", s."prod_id"
LIMIT 20;
