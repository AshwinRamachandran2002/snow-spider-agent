--Description: Final answer – single product (top-20 % seller) with the smallest 
--             absolute percentage-point share change between Q4-2019 and Q4-2020.
WITH city_qtr AS (                         -- promo-999 sales per U.S. city & quarter
    SELECT cu."cust_city"              AS "city",
           t."calendar_quarter_id"     AS "qtr",
           SUM(s."amount_sold")        AS "city_sales"
    FROM   COMPLEX_ORACLE.COMPLEX_ORACLE."SALES"      s
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE."TIMES"      t  ON s."time_id" = t."time_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE."CUSTOMERS"  cu ON s."cust_id" = cu."cust_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE."COUNTRIES"  ct ON cu."country_id" = ct."country_id"
    WHERE  ct."country_name" ILIKE '%United%States%'
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" IN (1772, 1776)
    GROUP BY cu."cust_city", t."calendar_quarter_id"
), 
growth_cities AS (                         -- cities whose 2020-Q4 ≥120 % of 2019-Q4
    SELECT "city"
    FROM   city_qtr
    GROUP BY "city"
    HAVING SUM(CASE WHEN "qtr" = 1772 THEN "city_sales" END) > 0
       AND SUM(CASE WHEN "qtr" = 1776 THEN "city_sales" END) >=
           1.20 * SUM(CASE WHEN "qtr" = 1772 THEN "city_sales" END)
), 
sales AS (                                 -- product sales per quarter in growth cities
    SELECT t."calendar_quarter_id" AS "qtr",
           s."prod_id",
           SUM(s."amount_sold")    AS "prod_sales"
    FROM   COMPLEX_ORACLE.COMPLEX_ORACLE."SALES"      s
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE."TIMES"      t  ON s."time_id" = t."time_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE."CUSTOMERS"  cu ON s."cust_id" = cu."cust_id"
    WHERE  cu."cust_city" IN (SELECT "city" FROM growth_cities)
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" IN (1772, 1776)
    GROUP BY t."calendar_quarter_id", s."prod_id"
), 
prod_total AS (                            -- overall totals per product
    SELECT "prod_id",
           SUM("prod_sales") AS "total_sales"
    FROM   sales
    GROUP  BY "prod_id"
), 
p80 AS (                                   -- 80-th percentile cut-off
    SELECT APPROX_PERCENTILE("total_sales", 0.80) AS "cutoff"
    FROM   prod_total
), 
top20 AS (                                 -- identify top-20 % products
    SELECT pt."prod_id"
    FROM   prod_total pt, p80
    WHERE  pt."total_sales" >= p80."cutoff"
), 
sales_share AS (                           -- product share within its quarter
    SELECT s."prod_id",
           s."qtr",
           s."prod_sales" / SUM(s."prod_sales") OVER (PARTITION BY s."qtr") AS "share"
    FROM   sales s
    WHERE  s."prod_id" IN (SELECT "prod_id" FROM top20)
), 
change_calc AS (                           -- compute pp-change per product
    SELECT "prod_id",
           MAX(CASE WHEN "qtr" = 1772 THEN "share" END) AS "share_2019q4",
           MAX(CASE WHEN "qtr" = 1776 THEN "share" END) AS "share_2020q4",
           MAX(CASE WHEN "qtr" = 1776 THEN "share" END) -
           MAX(CASE WHEN "qtr" = 1772 THEN "share" END) AS "pp_change"
    FROM   sales_share
    GROUP  BY "prod_id"
)
SELECT "prod_id",
       "share_2019q4",
       "share_2020q4",
       "pp_change" * 100 AS "percentage_point_change"
FROM   change_calc
ORDER  BY ABS("pp_change") ASC            -- most stable first
LIMIT 1;
