```sql
--Description: 
-- Goal – single query that completes the whole task in one shot:
--  • Step-1 : find U.S. cities whose promo-999 sales grew by ≥20 % from Q4-2019 (quarter 1772)
--              to Q4-2020 (quarter 1776).  
--  • Step-2 : within those “growth cities”, compute product sales in the two quarters.  
--  • Step-3 : keep only products that lie in the top-20 % of the total-sales distribution  
--              (APPROX_PERCENTILE_DISC at 0.80).  
--  • Step-4 : calculate each product’s share of total sales per quarter and the
--              percentage-point change between quarters.  
--  • Step-5 : return the product that shows the smallest absolute percentage-point change.  
WITH city_qtr AS (          -- total promo-999 sales per city & quarter
    SELECT cu."cust_city"               AS "city",
           t."calendar_quarter_id"      AS "qtr",
           SUM(s."amount_sold")         AS "city_sales"
    FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES      s
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES      t  ON s."time_id" = t."time_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS  cu ON s."cust_id" = cu."cust_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES  ct ON cu."country_id" = ct."country_id"
    WHERE  ct."country_name" ILIKE '%United%States%'
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" IN (1772, 1776)
    GROUP  BY cu."cust_city", t."calendar_quarter_id"
),
growth_cities AS (          -- cities with ≥20 % growth 2019-Q4➔2020-Q4
    SELECT "city"
    FROM   city_qtr
    GROUP  BY "city"
    HAVING SUM(CASE WHEN "qtr" = 1772 THEN "city_sales" END) > 0
       AND SUM(CASE WHEN "qtr" = 1776 THEN "city_sales" END) >=
           1.20 * SUM(CASE WHEN "qtr" = 1772 THEN "city_sales" END)
),
prod_qtr AS (               -- product sales in those growth cities (by quarter)
    SELECT s."prod_id",
           t."calendar_quarter_id"            AS "qtr",
           SUM(s."amount_sold")               AS "prod_sales"
    FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES      s
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES      t  ON s."time_id" = t."time_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS  cu ON s."cust_id" = cu."cust_id"
    WHERE  cu."cust_city" IN (SELECT "city" FROM growth_cities)
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" IN (1772, 1776)
    GROUP  BY s."prod_id", t."calendar_quarter_id"
),
prod_total AS (             -- overall total sales per product (both quarters)
    SELECT "prod_id",
           SUM("prod_sales") AS "total_sales"
    FROM   prod_qtr
    GROUP  BY "prod_id"
),
top20 AS (                  -- keep only products in the top-20 % of total sales
    SELECT "prod_id"
    FROM   prod_total
    WHERE  "total_sales" >= (SELECT APPROX_PERCENTILE_DISC("total_sales", 0.80)
                             FROM prod_total)
),
tot_qtr AS (                -- total sales of *all* products per quarter
    SELECT "qtr",
           SUM("prod_sales") AS "tot_sales_qtr"
    FROM   prod_qtr
    GROUP  BY "qtr"
),
share_qtr AS (              -- product share of quarter sales
    SELECT p."prod_id",
           p."qtr",
           p."prod_sales" / t."tot_sales_qtr" AS "share"
    FROM   prod_qtr p
    JOIN   tot_qtr  t ON p."qtr" = t."qtr"
    WHERE  p."prod_id" IN (SELECT "prod_id" FROM top20)
),
pp_change AS (              -- compute percentage-point change per product
    SELECT "prod_id",
           MAX(CASE WHEN "qtr" = 1772 THEN "share" END) AS "share_2019q4",
           MAX(CASE WHEN "qtr" = 1776 THEN "share" END) AS "share_2020q4"
    FROM   share_qtr
    GROUP  BY "prod_id"
)
SELECT "prod_id",
       "share_2019q4",
       "share_2020q4",
       ("share_2020q4" - "share_2019q4") * 100     AS "percentage_point_change"
FROM   pp_change
ORDER  BY ABS("percentage_point_change")           -- smallest pp-change first
LIMIT 1;
```
