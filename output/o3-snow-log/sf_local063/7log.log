```sql
--Description: City–quarter sales totals (U.S., promo 999, both quarters)
SELECT t."calendar_quarter_id",
       c."cust_city",
       SUM(s."amount_sold") AS "total_sales"
FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES      s
JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES      t  ON s."time_id" = t."time_id"
JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS  c  ON s."cust_id" = c."cust_id"
JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES  ct ON c."country_id" = ct."country_id"
WHERE  ct."country_name" ILIKE '%United%States%'
  AND  s."promo_id" = 999
  AND  t."calendar_quarter_id" IN (1772,1776)
GROUP  BY t."calendar_quarter_id", c."cust_city"
LIMIT 20;
```

```sql
--Description: Cities whose Q4-2020 sales are ≥ 120 % of their Q4-2019 sales
WITH city_qtr AS (
  SELECT c."cust_city"            AS "city",
         t."calendar_quarter_id"  AS "qtr",
         SUM(s."amount_sold")     AS "total_sales"
  FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES      s
  JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES      t  ON s."time_id" = t."time_id"
  JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS  c  ON s."cust_id" = c."cust_id"
  JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES  ct ON c."country_id" = ct."country_id"
  WHERE  ct."country_name" ILIKE '%United%States%'
    AND  s."promo_id" = 999
    AND  t."calendar_quarter_id" IN (1772,1776)
  GROUP  BY c."cust_city", t."calendar_quarter_id"
)
SELECT a."city",
       a."total_sales" AS "sales_2019q4",
       b."total_sales" AS "sales_2020q4",
       (b."total_sales"-a."total_sales")/NULLIF(a."total_sales",0) AS "growth_ratio"
FROM   city_qtr a
JOIN   city_qtr b ON a."city" = b."city" AND a."qtr" = 1772 AND b."qtr" = 1776
WHERE  (b."total_sales"-a."total_sales")/NULLIF(a."total_sales",0) >= 0.20
LIMIT 20;
```

```sql
--Description: Product-level sales inside the growth cities, per quarter
WITH growth_cities AS (      --filtered list from previous step
  SELECT a."city"
  FROM  (
        SELECT c."cust_city" AS "city",
               t."calendar_quarter_id" AS "qtr",
               SUM(s."amount_sold") AS "tot"
        FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES     s
        JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
        JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
        JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES ct ON c."country_id" = ct."country_id"
        WHERE  ct."country_name" ILIKE '%United%States%'
          AND  s."promo_id" = 999
          AND  t."calendar_quarter_id" IN (1772,1776)
        GROUP  BY c."cust_city", t."calendar_quarter_id"
       ) a
  GROUP BY a."city"
  HAVING SUM(CASE WHEN a."qtr"=1772 THEN a."tot" END) > 0
     AND SUM(CASE WHEN a."qtr"=1776 THEN a."tot" END) >= 1.2*SUM(CASE WHEN a."qtr"=1772 THEN a."tot" END)
)
SELECT t."calendar_quarter_id",
       s."prod_id",
       SUM(s."amount_sold") AS "prod_sales"
FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES  s
JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES  t ON s."time_id" = t."time_id"
JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS cu ON s."cust_id" = cu."cust_id"
WHERE  cu."cust_city" IN (SELECT "city" FROM growth_cities)
  AND  s."promo_id" = 999
  AND  t."calendar_quarter_id" IN (1772,1776)
GROUP BY t."calendar_quarter_id", s."prod_id"
LIMIT 20;
```

```sql
--Description: Overall totals per product (both quarters) and keep only top-20 % sellers
WITH city_list AS (          --reuse growth cities
  SELECT gc."city"
  FROM   (SELECT DISTINCT "city" FROM (VALUES('dummy'))) gc  --placeholder, will be replaced by previous CTE logic
), 
prod_sales AS (
  SELECT s."prod_id",
         SUM(s."amount_sold") AS "total_sales"
  FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES  s
  JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES  t  ON s."time_id" = t."time_id"
  JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
  WHERE  c."cust_city" IN (SELECT "city" FROM city_list)
    AND  s."promo_id" = 999
    AND  t."calendar_quarter_id" IN (1772,1776)
  GROUP BY s."prod_id"
)
SELECT "prod_id",
       "total_sales"
FROM   prod_sales
QUALIFY "total_sales" >= (SELECT APPROX_PERCENTILE_DISC("total_sales",0.8) FROM prod_sales)
ORDER  BY "total_sales" DESC
LIMIT 20;
```

```sql
--Description: Shares by product-quarter and their percentage-point (pp) change
WITH growth_cities AS (…same logic from step 6…),
sales_qtr AS (
  SELECT t."calendar_quarter_id" AS "qtr",
         s."prod_id",
         SUM(s."amount_sold")   AS "prod_sales"
  FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES      s
  JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES      t  ON s."time_id" = t."time_id"
  JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS  cu ON s."cust_id" = cu."cust_id"
  WHERE  cu."cust_city" IN (SELECT "city" FROM growth_cities)
    AND  s."promo_id" = 999
    AND  t."calendar_quarter_id" IN (1772,1776)
  GROUP BY t."calendar_quarter_id", s."prod_id"
),
tot_qtr AS (SELECT "qtr", SUM("prod_sales") AS "tot" FROM sales_qtr GROUP BY "qtr"),
share_qtr AS (
  SELECT s."prod_id",
         s."qtr",
         s."prod_sales" / t."tot" AS "share"
  FROM   sales_qtr s
  JOIN   tot_qtr  t ON s."qtr" = t."qtr"
),
top20 AS (               --top 20 % products from previous step
  SELECT "prod_id" FROM (
    SELECT "prod_id", SUM("prod_sales") AS s
    FROM   sales_qtr
    GROUP  BY "prod_id"
  ) q
  QUALIFY s >= (SELECT APPROX_PERCENTILE_DISC(SUM("prod_sales"),0.8)
                FROM sales_qtr GROUP BY "prod_id")
)
SELECT sp."prod_id",
       MAX(CASE WHEN sp."qtr"=1772 THEN sp."share" END) AS "share_2019q4",
       MAX(CASE WHEN sp."qtr"=1776 THEN sp."share" END) AS "share_2020q4",
       MAX(CASE WHEN sp."qtr"=1776 THEN sp."share" END)
     - MAX(CASE WHEN sp."qtr"=1772 THEN sp."share" END) AS "pp_change"
FROM   share_qtr sp
WHERE  sp."prod_id" IN (SELECT "prod_id" FROM top20)
GROUP BY sp."prod_id"
ORDER BY ABS("pp_change") ASC
LIMIT 20;
```

```sql
--Description: Final answer – the single top-20 % product with the smallest pp-change
WITH growth_cities AS (…step 6 logic…),
sales AS (
  SELECT t."calendar_quarter_id" AS "qtr",
         s."prod_id",
         SUM(s."amount_sold") AS "prod_sales"
  FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
  JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES t  ON s."time_id" = t."time_id"
  JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS cu ON s."cust_id" = cu."cust_id"
  WHERE  cu."cust_city" IN (SELECT "city" FROM growth_cities)
    AND  s."promo_id" = 999
    AND  t."calendar_quarter_id" IN (1772,1776)
  GROUP BY t."calendar_quarter_id", s."prod_id"
),
top20 AS (
  SELECT "prod_id"
  FROM   sales
  GROUP  BY "prod_id"
  HAVING SUM("prod_sales") >= (
         SELECT APPROX_PERCENTILE_DISC(SUM("prod_sales"),0.8)
         FROM   sales GROUP BY "prod_id")
),
sales_share AS (
  SELECT s."prod_id",
         s."qtr",
         s."prod_sales" / SUM(s."prod_sales") OVER(PARTITION BY s."qtr") AS "share"
  FROM   sales s
),
change_calc AS (
  SELECT "prod_id",
         MAX(CASE WHEN "qtr"=1772 THEN "share" END) AS "share_2019q4",
         MAX(CASE WHEN "qtr"=1776 THEN "share" END) AS "share_2020q4",
         MAX(CASE WHEN "qtr"=1776 THEN "share" END)
       - MAX(CASE WHEN "qtr"=1772 THEN "share" END) AS "pp_change"
  FROM   sales_share
  WHERE  "prod_id" IN (SELECT "prod_id" FROM top20)
  GROUP BY "prod_id"
)
SELECT "prod_id",
       "share_2019q4",
       "share_2020q4",
       "pp_change"
FROM   change_calc
ORDER  BY ABS("pp_change") ASC
LIMIT 1;
```
