--Description: For the top-20 % products, compute each product’s share of total promo sales per quarter and its percentage-point change; smallest change on top    
WITH top_products AS (            -- re-use previous query
    SELECT "prod_id"
    FROM (
        /* same RANKED step as above */
        SELECT "prod_id",
               "both_qtrs_sales",
               NTILE(5) OVER (ORDER BY "both_qtrs_sales" DESC) AS "ntile5"
        FROM (
            SELECT "prod_id",
                   SUM("amount_sold") AS "both_qtrs_sales"
            FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
            JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
            JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
            WHERE c."country_id" = (SELECT DISTINCT "country_id"
                                     FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                                     WHERE "country_name" ILIKE '%United%States%')
              AND s."promo_id" = 999
              AND t."calendar_quarter_id" IN (1772, 1776)
            GROUP BY "prod_id"
        )
    )
    WHERE "ntile5" = 1
), quarter_sales AS (
    SELECT s."prod_id",
           t."calendar_quarter_id",
           SUM(s."amount_sold") AS "prod_sales"
    FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
    JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
    JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
    WHERE c."country_id" = (SELECT DISTINCT "country_id"
                             FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                             WHERE "country_name" ILIKE '%United%States%')
      AND s."promo_id" = 999
      AND t."calendar_quarter_id" IN (1772, 1776)
      AND s."prod_id" IN (SELECT "prod_id" FROM top_products)
    GROUP BY s."prod_id", t."calendar_quarter_id"
), total_per_qtr AS (
    SELECT "calendar_quarter_id", SUM("prod_sales") AS "total_sales_qtr"
    FROM quarter_sales
    GROUP BY "calendar_quarter_id"
)
SELECT qs."prod_id",
       SUM(CASE WHEN qs."calendar_quarter_id" = 1772 THEN qs."prod_sales" END) AS "sales_2019Q4",
       SUM(CASE WHEN qs."calendar_quarter_id" = 1776 THEN qs."prod_sales" END) AS "sales_2020Q4",
       ROUND( SUM(CASE WHEN qs."calendar_quarter_id" = 1772 THEN qs."prod_sales" END)
              / (SELECT "total_sales_qtr" FROM total_per_qtr WHERE "calendar_quarter_id" = 1772) * 100, 2) AS "share_2019Q4_pct",
       ROUND( SUM(CASE WHEN qs."calendar_quarter_id" = 1776 THEN qs."prod_sales" END)
              / (SELECT "total_sales_qtr" FROM total_per_qtr WHERE "calendar_quarter_id" = 1776) * 100, 2) AS "share_2020Q4_pct",
       ROUND( ( ROUND( SUM(CASE WHEN qs."calendar_quarter_id" = 1776 THEN qs."prod_sales" END)
                       / (SELECT "total_sales_qtr" FROM total_per_qtr WHERE "calendar_quarter_id" = 1776) * 100, 2)
             - ROUND( SUM(CASE WHEN qs."calendar_quarter_id" = 1772 THEN qs."prod_sales" END)
                       / (SELECT "total_sales_qtr" FROM total_per_qtr WHERE "calendar_quarter_id" = 1772) * 100, 2)
             ), 2) AS "pct_point_change"
FROM quarter_sales qs
GROUP BY qs."prod_id"
ORDER BY ABS("pct_point_change") ASC      -- smallest change first
LIMIT 20;
