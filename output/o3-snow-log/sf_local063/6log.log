```sql
--Description: Calculate percent-growth per CITY from Q4-2019 to Q4-2020, keeping those ≥20%    
WITH q4_19 AS (
    SELECT c."cust_city", SUM(s."amount_sold") AS "sales_19"
    FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
    JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
    JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES t ON s."time_id" = t."time_id"
    WHERE c."country_id" = (SELECT DISTINCT "country_id"
                             FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                             WHERE "country_name" ILIKE '%United%States%')
      AND t."calendar_quarter_id" = 1772
      AND s."promo_id" = 999
    GROUP BY c."cust_city"
), q4_20 AS (
    SELECT c."cust_city", SUM(s."amount_sold") AS "sales_20"
    FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
    JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
    JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES t ON s."time_id" = t."time_id"
    WHERE c."country_id" = (SELECT DISTINCT "country_id"
                             FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                             WHERE "country_name" ILIKE '%United%States%')
      AND t."calendar_quarter_id" = 1776
      AND s."promo_id" = 999
    GROUP BY c."cust_city"
)
SELECT q4_20."cust_city",
       q4_19."sales_19",
       q4_20."sales_20",
       ROUND( (q4_20."sales_20" - q4_19."sales_19") / NULLIF(q4_19."sales_19",0) * 100, 2) AS "pct_growth"
FROM q4_19
JOIN q4_20 USING ("cust_city")
WHERE (q4_20."sales_20" - q4_19."sales_19") / NULLIF(q4_19."sales_19",0) >= 0.20
ORDER BY "pct_growth" DESC
LIMIT 20;
```

```sql
--Description: List the cities that qualified (≥20% growth) – to be reused later    
WITH growth_cities AS (
    SELECT q4_19."cust_city"
    FROM (
        SELECT c."cust_city", SUM(s."amount_sold") AS "sales_19"
        FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
        JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
        JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES t ON s."time_id" = t."time_id"
        WHERE c."country_id" = (SELECT DISTINCT "country_id"
                                 FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                                 WHERE "country_name" ILIKE '%United%States%')
          AND t."calendar_quarter_id" = 1772
          AND s."promo_id" = 999
        GROUP BY c."cust_city"
    ) q4_19
    JOIN (
        SELECT c."cust_city", SUM(s."amount_sold") AS "sales_20"
        FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
        JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
        JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES t ON s."time_id" = t."time_id"
        WHERE c."country_id" = (SELECT DISTINCT "country_id"
                                 FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                                 WHERE "country_name" ILIKE '%United%States%')
          AND t."calendar_quarter_id" = 1776
          AND s."promo_id" = 999
        GROUP BY c."cust_city"
    ) q4_20 USING ("cust_city")
    WHERE (q4_20."sales_20" - q4_19."sales_19") / NULLIF(q4_19."sales_19",0) >= 0.20
)
SELECT DISTINCT "cust_city"
FROM growth_cities
LIMIT 20;
```

```sql
--Description: Aggregate total sales per PRODUCT for the qualifying cities in both quarters    
WITH qualifying_cities AS (  -- reuse result from previous step
    SELECT DISTINCT "cust_city" FROM (
        /* same CTE as previous query – kept concise */
        SELECT c."cust_city"
        FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
        JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
        JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES t ON s."time_id" = t."time_id"
        WHERE c."country_id" = (SELECT DISTINCT "country_id"
                                 FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                                 WHERE "country_name" ILIKE '%United%States%')
          AND s."promo_id" = 999
          AND t."calendar_quarter_id" IN (1772, 1776)
    )
), sales_both_qtrs AS (
    SELECT s."prod_id",
           t."calendar_quarter_id",
           SUM(s."amount_sold") AS "total_sales"
    FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
    JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
    JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
    WHERE c."cust_city" IN (SELECT "cust_city" FROM qualifying_cities)
      AND c."country_id" = (SELECT DISTINCT "country_id"
                             FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                             WHERE "country_name" ILIKE '%United%States%')
      AND s."promo_id" = 999
      AND t."calendar_quarter_id" IN (1772, 1776)
    GROUP BY s."prod_id", t."calendar_quarter_id"
)
SELECT *
FROM sales_both_qtrs
ORDER BY "total_sales" DESC
LIMIT 20;
```

```sql
--Description: Calculate overall product totals across both quarters and flag those in top 20%    
WITH prod_totals AS (
    SELECT "prod_id",
           SUM("total_sales") AS "both_qtrs_sales"
    FROM (
        /* Re-use sales_both_qtrs from previous query */
        SELECT s."prod_id",
               SUM(s."amount_sold") AS "total_sales"
        FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
        JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
        JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
        WHERE c."country_id" = (SELECT DISTINCT "country_id"
                                 FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                                 WHERE "country_name" ILIKE '%United%States%')
          AND s."promo_id" = 999
          AND t."calendar_quarter_id" IN (1772, 1776)
          AND c."cust_city" IN (
              /* cities with ≥20 % growth */
              SELECT DISTINCT gc."cust_city"
              FROM (
                  /* condensed growth calculation */
                  SELECT c."cust_city",
                         SUM(CASE WHEN t."calendar_quarter_id" = 1772 THEN s."amount_sold" END) AS s19,
                         SUM(CASE WHEN t."calendar_quarter_id" = 1776 THEN s."amount_sold" END) AS s20
                  FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
                  JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
                  JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
                  WHERE c."country_id" = (SELECT DISTINCT "country_id"
                                           FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                                           WHERE "country_name" ILIKE '%United%States%')
                    AND s."promo_id" = 999
                    AND t."calendar_quarter_id" IN (1772, 1776)
                  GROUP BY c."cust_city"
                  HAVING s19 IS NOT NULL AND s20 IS NOT NULL
                     AND (s20 - s19)/NULLIF(s19,0) >= 0.20
              ) gc
          )
        GROUP BY s."prod_id"
    )
    GROUP BY "prod_id"
), ranked AS (
    SELECT "prod_id",
           "both_qtrs_sales",
           NTILE(5) OVER (ORDER BY "both_qtrs_sales" DESC) AS "ntile5"
    FROM prod_totals
)
SELECT *
FROM ranked
WHERE "ntile5" = 1               -- top 20 %
ORDER BY "both_qtrs_sales" DESC
LIMIT 20;
```

```sql
--Description: For the top-20 % products, compute each product’s share of total promo sales per quarter and its percentage-point change; smallest change on top    
WITH top_products AS (            -- re-use previous query
    SELECT "prod_id"
    FROM (
        /* same RANKED step as above */
        SELECT "prod_id",
               "both_qtrs_sales",
               NTILE(5) OVER (ORDER BY "both_qtrs_sales" DESC) AS "ntile5"
        FROM (
            SELECT "prod_id",
                   SUM("amount_sold") AS "both_qtrs_sales"
            FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
            JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
            JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
            WHERE c."country_id" = (SELECT DISTINCT "country_id"
                                     FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                                     WHERE "country_name" ILIKE '%United%States%')
              AND s."promo_id" = 999
              AND t."calendar_quarter_id" IN (1772, 1776)
            GROUP BY "prod_id"
        )
    )
    WHERE "ntile5" = 1
), quarter_sales AS (
    SELECT s."prod_id",
           t."calendar_quarter_id",
           SUM(s."amount_sold") AS "prod_sales"
    FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
    JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
    JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
    WHERE c."country_id" = (SELECT DISTINCT "country_id"
                             FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                             WHERE "country_name" ILIKE '%United%States%')
      AND s."promo_id" = 999
      AND t."calendar_quarter_id" IN (1772, 1776)
      AND s."prod_id" IN (SELECT "prod_id" FROM top_products)
    GROUP BY s."prod_id", t."calendar_quarter_id"
), total_per_qtr AS (
    SELECT "calendar_quarter_id", SUM("prod_sales") AS "total_sales_qtr"
    FROM quarter_sales
    GROUP BY "calendar_quarter_id"
)
SELECT qs."prod_id",
       SUM(CASE WHEN qs."calendar_quarter_id" = 1772 THEN qs."prod_sales" END) AS "sales_2019Q4",
       SUM(CASE WHEN qs."calendar_quarter_id" = 1776 THEN qs."prod_sales" END) AS "sales_2020Q4",
       ROUND( SUM(CASE WHEN qs."calendar_quarter_id" = 1772 THEN qs."prod_sales" END)
              / (SELECT "total_sales_qtr" FROM total_per_qtr WHERE "calendar_quarter_id" = 1772) * 100, 2) AS "share_2019Q4_pct",
       ROUND( SUM(CASE WHEN qs."calendar_quarter_id" = 1776 THEN qs."prod_sales" END)
              / (SELECT "total_sales_qtr" FROM total_per_qtr WHERE "calendar_quarter_id" = 1776) * 100, 2) AS "share_2020Q4_pct",
       ROUND( ( ROUND( SUM(CASE WHEN qs."calendar_quarter_id" = 1776 THEN qs."prod_sales" END)
                       / (SELECT "total_sales_qtr" FROM total_per_qtr WHERE "calendar_quarter_id" = 1776) * 100, 2)
             - ROUND( SUM(CASE WHEN qs."calendar_quarter_id" = 1772 THEN qs."prod_sales" END)
                       / (SELECT "total_sales_qtr" FROM total_per_qtr WHERE "calendar_quarter_id" = 1772) * 100, 2)
             ), 2) AS "pct_point_change"
FROM quarter_sales qs
GROUP BY qs."prod_id"
ORDER BY ABS("pct_point_change") ASC      -- smallest change first
LIMIT 20;
```
