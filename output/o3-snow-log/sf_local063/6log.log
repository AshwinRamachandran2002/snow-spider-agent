--Description: Calculate overall product totals across both quarters and flag those in top 20%    
WITH prod_totals AS (
    SELECT "prod_id",
           SUM("total_sales") AS "both_qtrs_sales"
    FROM (
        /* Re-use sales_both_qtrs from previous query */
        SELECT s."prod_id",
               SUM(s."amount_sold") AS "total_sales"
        FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
        JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
        JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
        WHERE c."country_id" = (SELECT DISTINCT "country_id"
                                 FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                                 WHERE "country_name" ILIKE '%United%States%')
          AND s."promo_id" = 999
          AND t."calendar_quarter_id" IN (1772, 1776)
          AND c."cust_city" IN (
              /* cities with ≥20 % growth */
              SELECT DISTINCT gc."cust_city"
              FROM (
                  /* condensed growth calculation */
                  SELECT c."cust_city",
                         SUM(CASE WHEN t."calendar_quarter_id" = 1772 THEN s."amount_sold" END) AS s19,
                         SUM(CASE WHEN t."calendar_quarter_id" = 1776 THEN s."amount_sold" END) AS s20
                  FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
                  JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
                  JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
                  WHERE c."country_id" = (SELECT DISTINCT "country_id"
                                           FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                                           WHERE "country_name" ILIKE '%United%States%')
                    AND s."promo_id" = 999
                    AND t."calendar_quarter_id" IN (1772, 1776)
                  GROUP BY c."cust_city"
                  HAVING s19 IS NOT NULL AND s20 IS NOT NULL
                     AND (s20 - s19)/NULLIF(s19,0) >= 0.20
              ) gc
          )
        GROUP BY s."prod_id"
    )
    GROUP BY "prod_id"
), ranked AS (
    SELECT "prod_id",
           "both_qtrs_sales",
           NTILE(5) OVER (ORDER BY "both_qtrs_sales" DESC) AS "ntile5"
    FROM prod_totals
)
SELECT *
FROM ranked
WHERE "ntile5" = 1               -- top 20 %
ORDER BY "both_qtrs_sales" DESC
LIMIT 20;
