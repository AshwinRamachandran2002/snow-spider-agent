Query:
--Description: Identify, among growth-qualified U.S. cities (≥ 20 % promo-999 sales gain from Q4-2019 to Q4-2020), the products that fall in the top-20 % of combined sales and have the smallest percentage-point change in sales share between the two quarters.

WITH us_ctry AS (                       -- United-States country_id
    SELECT "country_id"
    FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."COUNTRIES"
    WHERE "country_name" ILIKE '%United%States%'
    LIMIT 1
),
q19 AS (                                -- Q4-2019 city totals
    SELECT c."cust_city",
           SUM(s."amount_sold") AS sales_2019
    FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"  s
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"  t ON t."time_id" = s."time_id"
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" c ON c."cust_id" = s."cust_id"
    JOIN us_ctry u ON c."country_id" = u."country_id"
    WHERE t."calendar_quarter_id" = 1772
      AND s."promo_id" = 999
    GROUP BY c."cust_city"
),
q20 AS (                                -- Q4-2020 city totals
    SELECT c."cust_city",
           SUM(s."amount_sold") AS sales_2020
    FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"  s
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"  t ON t."time_id" = s."time_id"
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" c ON c."cust_id" = s."cust_id"
    JOIN us_ctry u ON c."country_id" = u."country_id"
    WHERE t."calendar_quarter_id" = 1776
      AND s."promo_id" = 999
    GROUP BY c."cust_city"
),
city_growth AS (                        -- Cities with ≥20 % growth
    SELECT q19."cust_city"
    FROM q19
    JOIN q20 USING ("cust_city")
    WHERE q19.sales_2019 > 0
      AND (q20.sales_2020 - q19.sales_2019) / q19.sales_2019 >= 0.20
),
prod_q AS (                             -- Product totals inside growth cities
    SELECT s."prod_id",
           SUM(CASE WHEN t."calendar_quarter_id" = 1772 THEN s."amount_sold" END) AS sales_2019,
           SUM(CASE WHEN t."calendar_quarter_id" = 1776 THEN s."amount_sold" END) AS sales_2020
    FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"  s
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"  t ON t."time_id" = s."time_id"
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" c ON c."cust_id" = s."cust_id"
    WHERE t."calendar_quarter_id" IN (1772,1776)
      AND s."promo_id" = 999
      AND c."cust_city" IN (SELECT "cust_city" FROM city_growth)
    GROUP BY s."prod_id"
),
totals AS (                              -- Totals for share calculation
    SELECT SUM(sales_2019) AS total_2019,
           SUM(sales_2020) AS total_2020
    FROM prod_q
),
shares AS (                              -- Shares and share change
    SELECT q."prod_id",
           q.sales_2019,
           q.sales_2020,
           q.sales_2019 / tot.total_2019 AS share_2019,
           q.sales_2020 / tot.total_2020 AS share_2020,
           (q.sales_2020 / tot.total_2020) - (q.sales_2019 / tot.total_2019) AS share_change,
           q.sales_2019 + q.sales_2020 AS combined_sales
    FROM prod_q q
    CROSS JOIN totals tot
),
ranked AS (                              -- Quintile buckets
    SELECT *,
           NTILE(5) OVER (ORDER BY combined_sales DESC) AS sales_bucket
    FROM shares
)
SELECT "prod_id",
       sales_2019,
       sales_2020,
       share_2019,
       share_2020,
       share_change
FROM ranked
WHERE sales_bucket = 1                  -- top-20 % by combined sales
ORDER BY ABS(share_change)              -- smallest share swing first
LIMIT 20
