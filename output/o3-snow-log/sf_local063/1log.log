--Description: 
-- Goal – one self-contained query (with inline thinking) that returns, among the
--            products sold in growth-cities (≥20 % promo-999 sales increase from
--            Q4-2019 to Q4-2020), the top-20 % (by combined sales) products whose
--            share of total sales changed the least between the two quarters.
-- Steps
--   1. Get the United-States "country_id".
--   2. Compute each U.S. city’s promo-999 sales for Q4-2019 (calendar_quarter_id 1772)
--      and Q4-2020 (1776).
--   3. Keep only the cities whose 2020 amount is ≥120 % of 2019 (≥20 % growth).
--   4. Inside those growth-qualified cities, aggregate product-level sales for the
--      two quarters.
--   5. Calculate every product’s share of total promo-999 sales in each quarter and
--      its percentage-point change.
--   6. Rank by combined (2019 + 2020) sales, split into 5 buckets (NTILE);
--      bucket 1 ≙ top-20 %.
--   7. Return bucket-1 products ordered by the smallest absolute share-change.

WITH "US_ID" AS (                       -- 1. United-States id
    SELECT "country_id"
    FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."COUNTRIES"
    WHERE "country_name" ILIKE '%United%States%'
    LIMIT 1
),
/* 2. city totals for each quarter */
"Q4_2019_CITY" AS (
    SELECT c."cust_city",
           SUM(s."amount_sold") AS "sales_2019"
    FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"      t ON t."time_id" = s."time_id"
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS"  c ON c."cust_id" = s."cust_id"
    JOIN "US_ID" u ON c."country_id" = u."country_id"
    WHERE t."calendar_quarter_id" = 1772
      AND s."promo_id" = 999
    GROUP BY c."cust_city"
),
"Q4_2020_CITY" AS (
    SELECT c."cust_city",
           SUM(s."amount_sold") AS "sales_2020"
    FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"      t ON t."time_id" = s."time_id"
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS"  c ON c."cust_id" = s."cust_id"
    JOIN "US_ID" u ON c."country_id" = u."country_id"
    WHERE t."calendar_quarter_id" = 1776
      AND s."promo_id" = 999
    GROUP BY c."cust_city"
),
/* 3. cities with ≥20 % growth */
"CITY_GROWTH" AS (
    SELECT c19."cust_city"
    FROM "Q4_2019_CITY" c19
    JOIN "Q4_2020_CITY" c20
      ON c19."cust_city" = c20."cust_city"
    WHERE c19."sales_2019" > 0
      AND (c20."sales_2020" - c19."sales_2019") / c19."sales_2019" >= 0.20
),
/* 4. product totals inside growth-cities */
"PROD_SALES" AS (
    SELECT s."prod_id",
           SUM(CASE WHEN t."calendar_quarter_id" = 1772 THEN s."amount_sold" END) AS "sales_2019",
           SUM(CASE WHEN t."calendar_quarter_id" = 1776 THEN s."amount_sold" END) AS "sales_2020"
    FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"     s
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"     t ON t."time_id" = s."time_id"
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" c ON c."cust_id" = s."cust_id"
    WHERE t."calendar_quarter_id" IN (1772,1776)
      AND s."promo_id" = 999
      AND c."cust_city" IN (SELECT "cust_city" FROM "CITY_GROWTH")
    GROUP BY s."prod_id"
),
/* 5. grand totals to compute shares */
"TOT" AS (
    SELECT SUM("sales_2019") AS "tot_2019",
           SUM("sales_2020") AS "tot_2020"
    FROM "PROD_SALES"
),
"SHARES" AS (
    SELECT p."prod_id",
           ps."sales_2019",
           ps."sales_2020",
           ps."sales_2019" / tot."tot_2019" AS "share_2019",
           ps."sales_2020" / tot."tot_2020" AS "share_2020",
           (ps."sales_2020" / tot."tot_2020") -
           (ps."sales_2019" / tot."tot_2019")           AS "share_change",
           ps."sales_2019" + ps."sales_2020"            AS "combined_sales"
    FROM "PROD_SALES" ps
    CROSS JOIN "TOT" tot
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."PRODUCTS" p
      ON p."prod_id" = ps."prod_id"
),
/* 6. assign quintile buckets by combined sales */
"RANKED" AS (
    SELECT *,
           NTILE(5) OVER (ORDER BY "combined_sales" DESC) AS "sales_bucket"
    FROM "SHARES"
)
/* 7. final answer */
SELECT "prod_id",
       "sales_2019",
       "sales_2020",
       "share_2019",
       "share_2020",
       "share_change"
FROM "RANKED"
WHERE "sales_bucket" = 1                   -- top-20 % by sales
ORDER BY ABS("share_change")               -- smallest share swing first
LIMIT 20;
