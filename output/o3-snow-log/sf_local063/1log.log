Query:
--Description: Compute sales growth from Q4-2019 to Q4-2020 at city level for U.S. promo 999 transactions.
WITH q4_2019 AS (
    SELECT c."cust_city",
           SUM(s."amount_sold") AS "sales_2019"
    FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"     s
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"     t ON t."time_id" = s."time_id"
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" c ON c."cust_id" = s."cust_id"
    WHERE t."calendar_quarter_id" = 1772
      AND s."promo_id" = 999
      AND c."country_id" = (SELECT "country_id"
                            FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."COUNTRIES"
                            WHERE "country_name" ILIKE '%United%States%'
                            LIMIT 1)
    GROUP BY c."cust_city"
),
q4_2020 AS (
    SELECT c."cust_city",
           SUM(s."amount_sold") AS "sales_2020"
    FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"     s
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"     t ON t."time_id" = s."time_id"
    JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" c ON c."cust_id" = s."cust_id"
    WHERE t."calendar_quarter_id" = 1776
      AND s."promo_id" = 999
      AND c."country_id" = (SELECT "country_id"
                            FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."COUNTRIES"
                            WHERE "country_name" ILIKE '%United%States%'
                            LIMIT 1)
    GROUP BY c."cust_city"
)
SELECT a."cust_city",
       a."sales_2019",
       b."sales_2020",
       CASE WHEN a."sales_2019" > 0
            THEN (b."sales_2020" - a."sales_2019") / a."sales_2019"
       END AS "growth_ratio"
FROM q4_2019 a
JOIN q4_2020 b ON a."cust_city" = b."cust_city"
WHERE a."sales_2019" > 0
ORDER BY "growth_ratio" DESC
LIMIT 20;
