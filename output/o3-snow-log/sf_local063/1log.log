Query:
--Description: Aggregate product-level sales in Q4-2019 for cities whose sales grew ≥20%.
WITH city_growth AS (
     /* same logic as previous CTE, but filtered for ≥20% growth */
     WITH q19 AS (
          SELECT c."cust_city", SUM(s."amount_sold") AS "sales_2019"
          FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"     s
          JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"     t ON t."time_id" = s."time_id"
          JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" c ON c."cust_id" = s."cust_id"
          WHERE t."calendar_quarter_id" = 1772
            AND s."promo_id" = 999
            AND c."country_id" = (SELECT "country_id"
                                   FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."COUNTRIES"
                                   WHERE "country_name" ILIKE '%United%States%'
                                   LIMIT 1)
          GROUP BY c."cust_city"
     ),
     q20 AS (
          SELECT c."cust_city", SUM(s."amount_sold") AS "sales_2020"
          FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"     s
          JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"     t ON t."time_id" = s."time_id"
          JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" c ON c."cust_id" = s."cust_id"
          WHERE t."calendar_quarter_id" = 1776
            AND s."promo_id" = 999
            AND c."country_id" = (SELECT "country_id"
                                   FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."COUNTRIES"
                                   WHERE "country_name" ILIKE '%United%States%'
                                   LIMIT 1)
          GROUP BY c."cust_city"
     )
     SELECT q19."cust_city"
     FROM q19
     JOIN q20 ON q19."cust_city" = q20."cust_city"
     WHERE q19."sales_2019" > 0
       AND (q20."sales_2020" - q19."sales_2019") / q19."sales_2019" >= 0.20
)
SELECT s."prod_id",
       SUM(s."amount_sold") AS "prod_sales_q4_2019"
FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"     s
JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"     t ON t."time_id" = s."time_id"
JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" c ON c."cust_id" = s."cust_id"
WHERE t."calendar_quarter_id" = 1772
  AND s."promo_id" = 999
  AND c."cust_city" IN (SELECT "cust_city" FROM city_growth)
GROUP BY s."prod_id"
ORDER BY "prod_sales_q4_2019" DESC
LIMIT 20;
