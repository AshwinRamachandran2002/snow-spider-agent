--Description: For growth-qualified cities, list products whose combined Q4-2019 & Q4-2020 sales place them in the top 20 % (promo_id = 999)
WITH growth_cities AS (
        SELECT gc."cust_city"
        FROM (
               SELECT c."cust_city",
                      t."calendar_quarter_id",
                      SUM(s."amount_sold") AS "city_qtr_sales"
               FROM  COMPLEX_ORACLE.COMPLEX_ORACLE.SALES     s
               JOIN  COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
               JOIN  COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
               WHERE s."promo_id" = 999
                 AND t."calendar_quarter_id" IN (1772,1776)
                 AND c."country_id" = (SELECT "country_id"
                                       FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                                       WHERE "country_name" ILIKE '%United%States%'
                                       LIMIT 1)
               GROUP BY c."cust_city", t."calendar_quarter_id"
        ) gc
        PIVOT (MIN("city_qtr_sales") FOR "calendar_quarter_id" IN (1772,1776))
              AS p ("cust_city","sales_2019Q4","sales_2020Q4")
        WHERE ("sales_2020Q4"-"sales_2019Q4")/NULLIF("sales_2019Q4",0) >= 0.20
),
prod_totals AS (
        SELECT s."prod_id",
               SUM(s."amount_sold") AS "total_sales_both_qtrs"
        FROM  COMPLEX_ORACLE.COMPLEX_ORACLE.SALES     s
        JOIN  COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
        JOIN  COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
        WHERE s."promo_id" = 999
          AND t."calendar_quarter_id" IN (1772,1776)
          AND c."cust_city" IN (SELECT "cust_city" FROM growth_cities)
        GROUP BY s."prod_id"
)
SELECT pt."prod_id",
       pt."total_sales_both_qtrs",
       RANK()         OVER(ORDER BY pt."total_sales_both_qtrs" DESC)  AS "rank",
       PERCENT_RANK() OVER(ORDER BY pt."total_sales_both_qtrs" DESC)  AS "pct_rank"
FROM   prod_totals pt
WHERE  PERCENT_RANK() OVER(ORDER BY pt."total_sales_both_qtrs" DESC) <= 0.20
LIMIT 20
