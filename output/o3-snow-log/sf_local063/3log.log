```sql
--Description:  Determine the products that are in the TOP-20 % of total promo-999 sales
--              across U.S. cities whose Q4-2020 sales out-grew Q4-2019 by ≥20 %.
-- 1. city_growth:  Aggregate promo-999 sales for every U.S. city in Q4-2019 (id 1772) and
--                  Q4-2020 (id 1776) using conditional SUM() instead of PIVOT.
-- 2. growth_cities: Keep only the cities showing ≥20 % growth from 2019 to 2020.
-- 3. prod_totals:   For those growth cities, sum each product’s sales across both quarters.
-- 4. Final SELECT:  Rank products by combined sales and QUALIFY to retain the top 20 %
--                  (PERCENT_RANK() ≤ 0.20).  Shows prod_id, total sales, rank, pct_rank.
WITH city_growth AS (
    SELECT c."cust_city",
           SUM(CASE WHEN t."calendar_quarter_id" = 1772 THEN s."amount_sold" END) AS "sales_2019Q4",
           SUM(CASE WHEN t."calendar_quarter_id" = 1776 THEN s."amount_sold" END) AS "sales_2020Q4"
    FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES     s
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
    WHERE  s."promo_id" = 999
      AND  t."calendar_quarter_id" IN (1772, 1776)
      AND  c."country_id" = (SELECT "country_id"
                             FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                             WHERE  "country_name" ILIKE '%United%States%'
                             LIMIT 1)
    GROUP BY c."cust_city"
),
growth_cities AS (
    SELECT "cust_city"
    FROM   city_growth
    WHERE  "sales_2019Q4" > 0
      AND  ("sales_2020Q4" - "sales_2019Q4") / "sales_2019Q4" >= 0.20
),
prod_totals AS (
    SELECT s."prod_id",
           SUM(s."amount_sold") AS "total_sales_both_qtrs"
    FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES     s
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
    JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."time_id" = t."time_id"
    WHERE  s."promo_id" = 999
      AND  t."calendar_quarter_id" IN (1772, 1776)
      AND  c."cust_city" IN (SELECT "cust_city" FROM growth_cities)
    GROUP BY s."prod_id"
)
SELECT pt."prod_id",
       pt."total_sales_both_qtrs",
       RANK()         OVER (ORDER BY pt."total_sales_both_qtrs" DESC) AS "rank",
       PERCENT_RANK() OVER (ORDER BY pt."total_sales_both_qtrs" DESC) AS "pct_rank"
FROM   prod_totals pt
QUALIFY PERCENT_RANK() OVER (ORDER BY pt."total_sales_both_qtrs" DESC) <= 0.20   -- keep top 20 %
LIMIT 20;
```
