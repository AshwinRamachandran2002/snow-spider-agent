```sql
--Description: Identify U.S. cities whose promo-999 sales grew ≥20 % from Q4-2019 to Q4-2020
WITH city_sales AS (
       SELECT c."CUST_CITY",
              t."CALENDAR_QUARTER_ID",
              SUM(s."AMOUNT_SOLD") AS "CITY_QTR_SALES"
       FROM   COMPLEX_ORACLE.COMPLEX_ORACLE.SALES     s
       JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."CUST_ID" = c."CUST_ID"
       JOIN   COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."TIME_ID" = t."TIME_ID"
       WHERE  s."PROMO_ID" = 999
         AND  t."CALENDAR_QUARTER_ID" IN (1772,1776)
         AND  c."COUNTRY_ID" = (SELECT "COUNTRY_ID"
                                FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                                WHERE "COUNTRY_NAME" ILIKE '%United%States%'
                                LIMIT 1)
       GROUP  BY c."CUST_CITY", t."CALENDAR_QUARTER_ID"
)
SELECT a."CUST_CITY",
       a."CITY_QTR_SALES"   AS "SALES_2019Q4",
       b."CITY_QTR_SALES"   AS "SALES_2020Q4",
       ROUND( (b."CITY_QTR_SALES" - a."CITY_QTR_SALES") / NULLIF(a."CITY_QTR_SALES",0) * 100 ,2) AS "PCT_GROWTH"
FROM   city_sales a
JOIN   city_sales b
       ON a."CUST_CITY" = b."CUST_CITY"
      AND a."CALENDAR_QUARTER_ID" = 1772
      AND b."CALENDAR_QUARTER_ID" = 1776
WHERE  (b."CITY_QTR_SALES" - a."CITY_QTR_SALES") / NULLIF(a."CITY_QTR_SALES",0) >= 0.20
LIMIT 20;
```

```sql
--Description: For growth-qualified cities, compute total sales per product across both quarters and list the top-20 % by total sales
WITH growth_cities AS (
       /* same sub-query as previous step */
       SELECT a."CUST_CITY"
       FROM (
              SELECT c."CUST_CITY",
                     t."CALENDAR_QUARTER_ID",
                     SUM(s."AMOUNT_SOLD") AS "CITY_QTR_SALES"
              FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
              JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."CUST_ID" = c."CUST_ID"
              JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES t     ON s."TIME_ID" = t."TIME_ID"
              WHERE s."PROMO_ID" = 999
                AND t."CALENDAR_QUARTER_ID" IN (1772,1776)
                AND c."COUNTRY_ID" = (SELECT "COUNTRY_ID"
                                      FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                                      WHERE "COUNTRY_NAME" ILIKE '%United%States%'
                                      LIMIT 1)
              GROUP  BY c."CUST_CITY", t."CALENDAR_QUARTER_ID"
       ) a
       PIVOT ( MIN("CITY_QTR_SALES") FOR "CALENDAR_QUARTER_ID" IN (1772,1776) )  AS p ("CUST_CITY","SALES_2019Q4","SALES_2020Q4")
       WHERE ("SALES_2020Q4" - "SALES_2019Q4") / NULLIF("SALES_2019Q4",0) >= 0.20
),
prod_totals AS (
       SELECT s."PROD_ID",
              SUM(s."AMOUNT_SOLD")               AS "TOTAL_SALES_BOTH_QTRS"
       FROM  COMPLEX_ORACLE.COMPLEX_ORACLE.SALES     s
       JOIN  COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."CUST_ID" = c."CUST_ID"
       JOIN  COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."TIME_ID" = t."TIME_ID"
       WHERE s."PROMO_ID" = 999
         AND t."CALENDAR_QUARTER_ID" IN (1772,1776)
         AND c."CUST_CITY" IN (SELECT "CUST_CITY" FROM growth_cities)
       GROUP BY s."PROD_ID"
)
SELECT p."PROD_ID",
       p."TOTAL_SALES_BOTH_QTRS",
       RANK()           OVER(ORDER BY p."TOTAL_SALES_BOTH_QTRS" DESC)                                    AS "RANK",
       PERCENT_RANK()   OVER(ORDER BY p."TOTAL_SALES_BOTH_QTRS" DESC)                                    AS "PCT_RANK"
FROM   prod_totals p
WHERE  PERCENT_RANK() OVER(ORDER BY p."TOTAL_SALES_BOTH_QTRS" DESC) <= 0.20   -- top 20 %
LIMIT 20;
```

```sql
--Description: For those top-20 % products, compute their share of total promo-999 sales in the growth-qualified cities for each quarter and the percentage-point change (sorted by smallest change)
WITH growth_cities AS (  /* same as above */ 
       SELECT a."CUST_CITY"
       FROM (
              SELECT c."CUST_CITY",
                     t."CALENDAR_QUARTER_ID",
                     SUM(s."AMOUNT_SOLD") AS "CITY_QTR_SALES"
              FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
              JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."CUST_ID" = c."CUST_ID"
              JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES t     ON s."TIME_ID" = t."TIME_ID"
              WHERE s."PROMO_ID" = 999
                AND t."CALENDAR_QUARTER_ID" IN (1772,1776)
                AND c."COUNTRY_ID" = (SELECT "COUNTRY_ID"
                                      FROM COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES
                                      WHERE "COUNTRY_NAME" ILIKE '%United%States%'
                                      LIMIT 1)
              GROUP  BY c."CUST_CITY", t."CALENDAR_QUARTER_ID"
       ) a
       PIVOT ( MIN("CITY_QTR_SALES") FOR "CALENDAR_QUARTER_ID" IN (1772,1776) )  AS p ("CUST_CITY","SALES_2019Q4","SALES_2020Q4")
       WHERE ("SALES_2020Q4" - "SALES_2019Q4") / NULLIF("SALES_2019Q4",0) >= 0.20
),
top_products AS ( /* reuse previous step to find products in top 20 % */
       SELECT *
       FROM (
              SELECT s."PROD_ID",
                     SUM(s."AMOUNT_SOLD") AS "TOTAL_SALES_BOTH_QTRS",
                     PERCENT_RANK() OVER(ORDER BY SUM(s."AMOUNT_SOLD") DESC) AS "PCT_RNK"
              FROM  COMPLEX_ORACLE.COMPLEX_ORACLE.SALES     s
              JOIN  COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."CUST_ID" = c."CUST_ID"
              JOIN  COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."TIME_ID" = t."TIME_ID"
              WHERE s."PROMO_ID" = 999
                AND t."CALENDAR_QUARTER_ID" IN (1772,1776)
                AND c."CUST_CITY" IN (SELECT "CUST_CITY" FROM growth_cities)
              GROUP BY s."PROD_ID"
       )
       WHERE "PCT_RNK" <= 0.20
),
share_by_qtr AS (
       SELECT t."CALENDAR_QUARTER_ID",
              s."PROD_ID",
              SUM(s."AMOUNT_SOLD")                                          AS "PROD_QTR_SALES",
              SUM(SUM(s."AMOUNT_SOLD")) OVER (PARTITION BY t."CALENDAR_QUARTER_ID") AS "TOTAL_QTR_SALES"
       FROM  COMPLEX_ORACLE.COMPLEX_ORACLE.SALES     s
       JOIN  COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."CUST_ID" = c."CUST_ID"
       JOIN  COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t ON s."TIME_ID" = t."TIME_ID"
       WHERE s."PROMO_ID" = 999
         AND t."CALENDAR_QUARTER_ID" IN (1772,1776)
         AND c."CUST_CITY" IN (SELECT "CUST_CITY" FROM growth_cities)
         AND s."PROD_ID"   IN (SELECT "PROD_ID" FROM top_products)
       GROUP BY t."CALENDAR_QUARTER_ID", s."PROD_ID"
)
SELECT a."PROD_ID",
       ROUND(a."PROD_QTR_SALES" / NULLIF(a."TOTAL_QTR_SALES",0) * 100, 2) AS "SHARE_2019Q4",
       ROUND(b."PROD_QTR_SALES" / NULLIF(b."TOTAL_QTR_SALES",0) * 100, 2) AS "SHARE_2020Q4",
       ROUND( (b."PROD_QTR_SALES" / NULLIF(b."TOTAL_QTR_SALES",0) * 100) 
            - (a."PROD_QTR_SALES" / NULLIF(a."TOTAL_QTR_SALES",0) * 100) , 2)                    AS "PP_CHANGE"
FROM   share_by_qtr  a
JOIN   share_by_qtr  b
       ON a."PROD_ID" = b."PROD_ID"
      AND a."CALENDAR_QUARTER_ID" = 1772
      AND b."CALENDAR_QUARTER_ID" = 1776
ORDER BY "PP_CHANGE" ASC
LIMIT 20;
```
