--Description: 80-th percentile threshold of combined sales (Q4-2019 & Q4-2020, promo 999) for products sold in “fast-growing” U.S. cities (≥20 % YoY growth).  
WITH q19 AS (                       -- city totals, Q4-2019
    SELECT cu."cust_city",
           SUM(s."amount_sold") AS "sales_19"
    FROM   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS"  cu ON s."cust_id" = cu."cust_id"
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"      t  ON s."time_id" = t."time_id"
    WHERE  cu."country_id"         = 52790    -- U.S.
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" = 1772     -- Q4-2019
    GROUP BY cu."cust_city"
), q20 AS (                         -- city totals, Q4-2020
    SELECT cu."cust_city",
           SUM(s."amount_sold") AS "sales_20"
    FROM   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS"  cu ON s."cust_id" = cu."cust_id"
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"      t  ON s."time_id" = t."time_id"
    WHERE  cu."country_id"         = 52790
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" = 1776     -- Q4-2020
    GROUP BY cu."cust_city"
), fast_cities AS (                 -- cities with ≥20 % growth
    SELECT q19."cust_city"
    FROM   q19
    JOIN   q20 ON q19."cust_city" = q20."cust_city"
    WHERE  (q20."sales_20" - q19."sales_19") / NULLIF(q19."sales_19",0) >= 0.20
)
SELECT APPROX_PERCENTILE("total_sales_both_quarters", 0.80) AS "p80_threshold"
FROM (
    SELECT s."prod_id",
           SUM(s."amount_sold") AS "total_sales_both_quarters"
    FROM   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS"  cu ON s."cust_id" = cu."cust_id"
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"      t  ON s."time_id" = t."time_id"
    WHERE  cu."cust_city"          IN (SELECT "cust_city" FROM fast_cities)
      AND  cu."country_id"         = 52790
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" IN (1772,1776)
    GROUP BY s."prod_id"
) x
LIMIT 20
