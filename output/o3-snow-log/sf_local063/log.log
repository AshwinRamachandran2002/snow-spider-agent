--Description:
--One-shot query that performs the complete logic:
--  1) Identify “fast-growing” U.S. cities whose promo-999 sales rose ≥20 % from Q4-2019 (id 1772) to Q4-2020 (id 1776).
--  2) Within those cities, keep only products that lie in the top 20 % of combined sales (both quarters).
--  3) For every such product, compute its share of total sales in each quarter and the
--     absolute percentage-point change between quarters.
--  4) Return the product with the smallest change.

WITH q19 AS (          -- City totals, Q4-2019
    SELECT cu."cust_city",
           SUM(s."amount_sold") AS "sales_19"
    FROM   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS"  cu  ON s."cust_id" = cu."cust_id"
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"      t   ON s."time_id" = t."time_id"
    WHERE  cu."country_id"         = 52790           -- United States
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" = 1772            -- Q4-2019
    GROUP BY cu."cust_city"
),
q20 AS (          -- City totals, Q4-2020
    SELECT cu."cust_city",
           SUM(s."amount_sold") AS "sales_20"
    FROM   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS"  cu  ON s."cust_id" = cu."cust_id"
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"      t   ON s."time_id" = t."time_id"
    WHERE  cu."country_id"         = 52790
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" = 1776            -- Q4-2020
    GROUP BY cu."cust_city"
),
fast_cities AS (        -- Cities with ≥20 % growth
    SELECT q19."cust_city"
    FROM   q19
    JOIN   q20 ON q19."cust_city" = q20."cust_city"
    WHERE  (q20."sales_20" - q19."sales_19") / NULLIF(q19."sales_19",0) >= 0.20
),
sales_filtered AS (     -- All promo-999 sales in fast-growing cities, both quarters
    SELECT s."prod_id",
           t."calendar_quarter_id",
           s."amount_sold"
    FROM   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS"  cu  ON s."cust_id" = cu."cust_id"
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"      t   ON s."time_id" = t."time_id"
    WHERE  cu."cust_city"          IN (SELECT "cust_city" FROM fast_cities)
      AND  cu."country_id"         = 52790
      AND  s."promo_id"            = 999
      AND  t."calendar_quarter_id" IN (1772, 1776)
),
prod_totals AS (        -- Combined sales by product (both quarters)
    SELECT "prod_id",
           SUM("amount_sold") AS "total_sales"
    FROM   sales_filtered
    GROUP BY "prod_id"
),
top_products AS (       -- Keep top 20 % products by sales volume
    SELECT "prod_id"
    FROM   (
        SELECT pt.*,
               CUME_DIST() OVER (ORDER BY pt."total_sales" DESC) AS cd
        FROM   prod_totals pt
    )
    WHERE cd <= 0.20
),
prod_quarter_sales AS ( -- Sales per product per quarter
    SELECT sf."prod_id",
           sf."calendar_quarter_id",
           SUM(sf."amount_sold") AS "qtr_sales"
    FROM   sales_filtered sf
    WHERE  sf."prod_id" IN (SELECT "prod_id" FROM top_products)
    GROUP BY sf."prod_id", sf."calendar_quarter_id"
),
quarter_totals AS (     -- Grand totals for each quarter (all products)
    SELECT sf."calendar_quarter_id",
           SUM(sf."amount_sold") AS "total_qtr_sales"
    FROM   sales_filtered sf
