         ROUND(ABS( (pqs20."qtr_sales"/qt20."total_qtr_sales")
                   - (pqs19."qtr_sales"/qt19."total_qtr_sales") ) * 100, 2) AS "pct_point_change"
FROM     prod_quarter_sales pqs19
JOIN     prod_quarter_sales pqs20  ON pqs19."prod_id" = pqs20."prod_id"
JOIN     quarter_totals     qt19   ON qt19."calendar_quarter_id" = 1772
JOIN     quarter_totals     qt20   ON qt20."calendar_quarter_id" = 1776
WHERE    pqs19."calendar_quarter_id" = 1772
  AND    pqs20."calendar_quarter_id" = 1776
