--Description: For the same “fast-growing” cities, list top-20 % products (by combined sales) and compute their sales share change between Q4-2019 and Q4-2020, returning the 20 products with the smallest percentage-point change.  
WITH q19 AS (   -- city totals 2019-Q4
    SELECT cu."cust_city",
           SUM(s."amount_sold") AS s19
    FROM   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES" s
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" cu ON s."cust_id" = cu."cust_id"
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES" t  ON s."time_id" = t."time_id"
    WHERE  cu."country_id" = 52790  AND s."promo_id" = 999 AND t."calendar_quarter_id" = 1772
    GROUP BY cu."cust_city"
), q20 AS (     -- city totals 2020-Q4
    SELECT cu."cust_city",
           SUM(s."amount_sold") AS s20
    FROM   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES" s
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" cu ON s."cust_id" = cu."cust_id"
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES" t  ON s."time_id" = t."time_id"
    WHERE  cu."country_id" = 52790  AND s."promo_id" = 999 AND t."calendar_quarter_id" = 1776
    GROUP BY cu."cust_city"
), fast_cities AS (
    SELECT q19."cust_city"
    FROM   q19 JOIN q20 USING ("cust_city")
    WHERE  (q20.s20 - q19.s19) / NULLIF(q19.s19,0) >= 0.20
), sales_filt AS (
    SELECT s."prod_id", t."calendar_quarter_id", s."amount_sold"
    FROM   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS"  cu ON s."cust_id" = cu."cust_id"
    JOIN   "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"      t  ON s."time_id" = t."time_id"
    WHERE  cu."cust_city" IN (SELECT "cust_city" FROM fast_cities)
      AND  cu."country_id" = 52790
      AND  s."promo_id"    = 999
      AND  t."calendar_quarter_id" IN (1772,1776)
), prod_tot AS (
    SELECT "prod_id", SUM("amount_sold") AS tot_sales
    FROM   sales_filt
    GROUP BY "prod_id"
), top_prod AS (               -- top 20 %
    SELECT "prod_id"
    FROM  (SELECT pt.*,
                  CUME_DIST() OVER (ORDER BY pt.tot_sales DESC) AS cd
           FROM prod_tot pt)
    WHERE cd <= 0.20
), prod_qtr AS (
    SELECT "prod_id","calendar_quarter_id", SUM("amount_sold") AS qtr_sales
    FROM   sales_filt
    WHERE  "prod_id" IN (SELECT "prod_id" FROM top_prod)
    GROUP BY "prod_id","calendar_quarter_id"
), qtr_tot AS (
    SELECT "calendar_quarter_id", SUM("amount_sold") AS grand
    FROM   sales_filt
    GROUP BY "calendar_quarter_id"
)
SELECT  p19."prod_id",
        p19.qtr_sales AS sales_2019,
        p20.qtr_sales AS sales_2020,
        ROUND(100*p19.qtr_sales/q19t.grand,2) AS share_2019_pct,
        ROUND(100*p20.qtr_sales/q20t.grand,2) AS share_2020_pct,
        ROUND(ABS( (p20.qtr_sales/q20t.grand) - (p19.qtr_sales/q19t.grand) )*100,2) AS pct_point_change
FROM    prod_qtr       p19
JOIN    prod_qtr       p20   ON p19."prod_id" = p20."prod_id"        AND p20."calendar_quarter_id" = 1776
JOIN    qtr_tot        q19t  ON q19t."calendar_quarter_id" = 1772
JOIN    qtr_tot        q20t  ON q20t."calendar_quarter_id" = 1776
WHERE   p19."calendar_quarter_id" = 1772
ORDER BY pct_point_change ASC
LIMIT 20;
