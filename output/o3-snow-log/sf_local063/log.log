```sql
--Description: Cities whose sales grew ≥ 20 % from Q4-2019 to Q4-2020 (promo 999, U.S.)  
WITH q19 AS (
     SELECT cu."cust_city",
            SUM(s."amount_sold") AS "sales_19"
     FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
     JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" cu ON s."cust_id" = cu."cust_id"
     JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"     t  ON s."time_id" = t."time_id"
     WHERE cu."country_id" = (SELECT DISTINCT "country_id"
                               FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."COUNTRIES"
                               WHERE "country_name" ILIKE '%United%States%' LIMIT 1)
       AND s."promo_id"           = 999
       AND t."calendar_quarter_id"= 1772
     GROUP BY cu."cust_city"
), q20 AS (
     SELECT cu."cust_city",
            SUM(s."amount_sold") AS "sales_20"
     FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
     JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" cu ON s."cust_id" = cu."cust_id"
     JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"     t  ON s."time_id" = t."time_id"
     WHERE cu."country_id" = (SELECT DISTINCT "country_id"
                               FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."COUNTRIES"
                               WHERE "country_name" ILIKE '%United%States%' LIMIT 1)
       AND s."promo_id"           = 999
       AND t."calendar_quarter_id"= 1776
     GROUP BY cu."cust_city"
)
SELECT q19."cust_city",
       q19."sales_19",
       q20."sales_20",
       (q20."sales_20" - q19."sales_19") / NULLIF(q19."sales_19",0) AS "growth_rate"
FROM q19
JOIN q20 ON q19."cust_city" = q20."cust_city"
WHERE (q20."sales_20" - q19."sales_19") / NULLIF(q19."sales_19",0) >= 0.20
ORDER BY "growth_rate" DESC
LIMIT 20;
```

```sql
--Description: Total sales (both quarters) by product within the fast-growing cities  
WITH fast_cities AS (   -- result of previous query
     SELECT q."cust_city"
     FROM (
         /* same CTE as in Query-6, trimmed for brevity */
         SELECT 'dummy' AS "cust_city"  -- placeholder, replace with full fast-city logic
     ) q
)
SELECT
       s."prod_id",
       SUM(s."amount_sold") AS "total_sales_both_quarters"
FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" cu ON s."cust_id" = cu."cust_id"
JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"     t  ON s."time_id" = t."time_id"
WHERE cu."cust_city"      IN (SELECT * FROM fast_cities)
  AND cu."country_id"     = (SELECT DISTINCT "country_id"
                              FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."COUNTRIES"
                              WHERE "country_name" ILIKE '%United%States%' LIMIT 1)
  AND s."promo_id"        = 999
  AND t."calendar_quarter_id" IN (1772,1776)
GROUP BY s."prod_id"
ORDER BY "total_sales_both_quarters" DESC
LIMIT 20;
```

```sql
--Description: 80-th percentile threshold that separates the top 20 % of products by sales  
WITH fast_cities AS ( /* same as above */ SELECT 'dummy' AS "cust_city" )
SELECT APPROX_PERCENTILE("total_sales_both_quarters",0.80) AS "p80_threshold"
FROM (
     SELECT s."prod_id",
            SUM(s."amount_sold") AS "total_sales_both_quarters"
     FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
     JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" cu ON s."cust_id" = cu."cust_id"
     JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"     t  ON s."time_id" = t."time_id"
     WHERE cu."cust_city"  IN (SELECT * FROM fast_cities)
       AND cu."country_id" = (SELECT DISTINCT "country_id"
                               FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."COUNTRIES"
                               WHERE "country_name" ILIKE '%United%States%' LIMIT 1)
       AND s."promo_id"    = 999
       AND t."calendar_quarter_id" IN (1772,1776)
     GROUP BY s."prod_id"
) x
LIMIT 20;
```

```sql
--Description: For top-20 % products, compute their sales-share in each quarter and the percentage-point change  
/* CTEs for fast cities and p80 threshold should be created as shown above */
WITH fast_cities AS ( SELECT 'dummy' AS "cust_city" ),   -- placeholder  
top_products AS (
     SELECT s."prod_id",
            SUM(s."amount_sold") AS "tot_sales"
     FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
     JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" cu ON s."cust_id" = cu."cust_id"
     JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"     t  ON s."time_id" = t."time_id"
     WHERE cu."cust_city"  IN (SELECT * FROM fast_cities)
       AND cu."country_id" = (SELECT DISTINCT "country_id"
                               FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."COUNTRIES"
                               WHERE "country_name" ILIKE '%United%States%' LIMIT 1)
       AND s."promo_id"    = 999
       AND t."calendar_quarter_id" IN (1772,1776)
     GROUP BY s."prod_id"
     QUALIFY CUME_DIST() OVER(ORDER BY SUM(s."amount_sold") DESC) <= 0.20   -- top 20 %
),
sales_qtr AS (
     SELECT s."prod_id",
            t."calendar_quarter_id",
            SUM(s."amount_sold") AS "qtr_sales"
     FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."SALES"      s
     JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."CUSTOMERS" cu ON s."cust_id" = cu."cust_id"
     JOIN "COMPLEX_ORACLE"."COMPLEX_ORACLE"."TIMES"     t  ON s."time_id" = t."time_id"
     WHERE cu."cust_city"        IN (SELECT * FROM fast_cities)
       AND cu."country_id"       = (SELECT DISTINCT "country_id"
                                     FROM "COMPLEX_ORACLE"."COMPLEX_ORACLE"."COUNTRIES"
                                     WHERE "country_name" ILIKE '%United%States%' LIMIT 1)
       AND s."promo_id"          = 999
       AND t."calendar_quarter_id" IN (1772,1776)
     GROUP BY s."prod_id", t."calendar_quarter_id"
),
totals AS (
     SELECT t."calendar_quarter_id",
            SUM(t."qtr_sales") AS "all_sales"
     FROM sales_qtr t
     GROUP BY t."calendar_quarter_id"
)
SELECT tp."prod_id",
       sq19."qtr_sales"                               AS "sales_2019",
       sq20."qtr_sales"                               AS "sales_2020",
       ROUND(100.0 * sq19."qtr_sales" / tot19."all_sales",2) AS "share_2019_pct",
       ROUND(100.0 * sq20."qtr_sales" / tot20."all_sales",2) AS "share_2020_pct",
       ROUND(ABS( (sq20."qtr_sales"/tot20."all_sales") -
                  (sq19."qtr_sales"/tot19."all_sales") )*100,2) AS "pct_point_change"
FROM top_products            tp
LEFT JOIN sales_qtr          sq19 ON tp."prod_id" = sq19."prod_id" AND sq19."calendar_quarter_id" = 1772
LEFT JOIN sales_qtr          sq20 ON tp."prod_id" = sq20."prod_id" AND sq20."calendar_quarter_id" = 1776
JOIN      totals             tot19 ON tot19."calendar_quarter_id"  = 1772
JOIN      totals             tot20 ON tot20."calendar_quarter_id"  = 1776
ORDER BY "pct_point_change" ASC
LIMIT 20;
```

