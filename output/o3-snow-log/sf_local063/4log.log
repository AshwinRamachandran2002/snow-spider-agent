--Description: 10) Among those growth-cities, find the top-20 % products (by total sales) 
--               and report the one whose share-of-sales changed the least between the two quarters
WITH us_customers AS (  -- all U.S. customer ids
  SELECT cu."cust_id"
  FROM COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS cu
  JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES co
        ON cu."country_id" = co."country_id"
  WHERE co."country_name" ILIKE '%United%States%'
),                                                                          
sales_us AS (       -- U.S. promo-999 sales in Q4-2019 & Q4-2020
  SELECT s.*,
         t."calendar_quarter_id",
         cu."cust_city"
  FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES      s
  JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES      t   ON s."time_id" = t."time_id"
  JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS  cu  ON s."cust_id" = cu."cust_id"
  WHERE s."promo_id" = 999
    AND s."cust_id" IN (SELECT * FROM us_customers)
    AND t."calendar_quarter_id" IN (1772,1776)
),                                                                          
city_ok AS (       -- keep only cities with ≥20 % growth
  SELECT "cust_city"
  FROM sales_us
  GROUP BY "cust_city"
  HAVING SUM(CASE WHEN "calendar_quarter_id" = 1776 THEN "amount_sold" END)
       >= 1.2 * SUM(CASE WHEN "calendar_quarter_id" = 1772 THEN "amount_sold" END)
),                                                                          
filtered_sales AS ( -- final sales fact set to analyse
  SELECT *
  FROM sales_us
  WHERE "cust_city" IN (SELECT * FROM city_ok)
),                                                                          
prod_tot AS (      -- total sales per product
  SELECT "prod_id",
         SUM("amount_sold") AS "tot_sales"
  FROM filtered_sales
  GROUP BY "prod_id"
),                                                                          
ranked AS (        -- percentile rank to get top 20 %
  SELECT "prod_id",
         "tot_sales",
         PERCENT_RANK() OVER (ORDER BY "tot_sales" DESC) AS "prank"
  FROM prod_tot
),                                                                          
top20 AS (         -- products whose rank ≤0.20
  SELECT "prod_id"
  FROM ranked
  WHERE "prank" <= 0.20
),                                                                          
prod_qtr AS (      -- product sales per quarter
  SELECT "prod_id",
         "calendar_quarter_id",
         SUM("amount_sold") AS "sales"
  FROM filtered_sales
  WHERE "prod_id" IN (SELECT * FROM top20)
  GROUP BY "prod_id","calendar_quarter_id"
),                                                                          
qtr_total AS (     -- total market sales per quarter
  SELECT "calendar_quarter_id",
         SUM("amount_sold") AS "market"
  FROM filtered_sales
  GROUP BY "calendar_quarter_id"
),                                                                          
share AS (         -- product share (%) per quarter
  SELECT p."prod_id",
         p."calendar_quarter_id",
         100.0 * p."sales" / t."market" AS "pct_share"
  FROM prod_qtr p
  JOIN qtr_total t
        ON p."calendar_quarter_id" = t."calendar_quarter_id"
),                                                                          
delta AS (         -- percentage-point change between the two quarters
  SELECT "prod_id",
         MAX(CASE WHEN "calendar_quarter_id" = 1776 THEN "pct_share" END)
       - MAX(CASE WHEN "calendar_quarter_id" = 1772 THEN "pct_share" END) 
         AS "pp_change"
  FROM share
  GROUP BY "prod_id"
)                                                                           
SELECT *
FROM delta
ORDER BY ABS("pp_change") ASC      -- smallest absolute change first
LIMIT 20;
