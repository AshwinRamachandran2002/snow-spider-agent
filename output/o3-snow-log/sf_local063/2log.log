--Description: Among products in the top 20 % of total two-quarter sales, pick the one whose share changed the least (absolute percentage-point change).
WITH growth_cities AS (
  /* city growth logic again */
  WITH city_qtr AS (
    SELECT c."cust_city",
           t."calendar_quarter_id",
           SUM(s."amount_sold") AS total_sales
    FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES     s
    JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES     t  ON s."time_id" = t."time_id"
    JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c  ON s."cust_id" = c."cust_id"
    JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.COUNTRIES co ON c."country_id" = co."country_id"
    WHERE co."country_name" = 'United States of America'
      AND s."promo_id"         = 999
      AND t."calendar_quarter_id" IN (1772,1776)
    GROUP BY c."cust_city", t."calendar_quarter_id"
  )
  SELECT a."cust_city"
  FROM city_qtr a
  JOIN city_qtr b ON a."cust_city" = b."cust_city"
  WHERE a."calendar_quarter_id" = 1772
    AND b."calendar_quarter_id" = 1776
    AND (b.total_sales - a.total_sales) / a.total_sales >= 0.20
), prod_qtr AS (
  SELECT s."prod_id",
         t."calendar_quarter_id",
         SUM(s."amount_sold") AS prod_sales
  FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
  JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES t ON s."time_id" = t."time_id"
  JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
  JOIN growth_cities gc ON c."cust_city" = gc."cust_city"
  WHERE s."promo_id" = 999
    AND t."calendar_quarter_id" IN (1772,1776)
  GROUP BY s."prod_id", t."calendar_quarter_id"
), tot_qtr AS (
  SELECT t."calendar_quarter_id",
         SUM(s."amount_sold") AS tot_sales
  FROM COMPLEX_ORACLE.COMPLEX_ORACLE.SALES s
  JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.TIMES t ON s."time_id" = t."time_id"
  JOIN COMPLEX_ORACLE.COMPLEX_ORACLE.CUSTOMERS c ON s."cust_id" = c."cust_id"
  JOIN growth_cities gc ON c."cust_city" = gc."cust_city"
  WHERE s."promo_id" = 999
    AND t."calendar_quarter_id" IN (1772,1776)
  GROUP BY t."calendar_quarter_id"
), prod_share AS (
  SELECT pq."prod_id",
         MAX(CASE WHEN pq."calendar_quarter_id" = 1772 THEN pq.prod_sales END) AS sales_2019_q4,
         MAX(CASE WHEN pq."calendar_quarter_id" = 1776 THEN pq.prod_sales END) AS sales_2020_q4,
         MAX(CASE WHEN pq."calendar_quarter_id" = 1772 THEN pq.prod_sales END) /
         (SELECT tot_sales FROM tot_qtr WHERE "calendar_quarter_id" = 1772)  AS share_2019_q4,
         MAX(CASE WHEN pq."calendar_quarter_id" = 1776 THEN pq.prod_sales END) /
         (SELECT tot_sales FROM tot_qtr WHERE "calendar_quarter_id" = 1776)  AS share_2020_q4
  FROM prod_qtr pq
  GROUP BY pq."prod_id"
), ranked AS (
  SELECT ps.*,
         (ps.sales_2019_q4 + ps.sales_2020_q4) AS two_qtr_total
  FROM prod_share ps
), top_20pct AS (
  SELECT *
  FROM ranked
  QUALIFY NTILE(5) OVER (ORDER BY two_qtr_total DESC) = 1   --top 20 %
)
SELECT "prod_id",
       share_2019_q4,
       share_2020_q4,
       ROUND(share_2020_q4 - share_2019_q4 , 6) AS share_change
FROM top_20pct
ORDER BY ABS(share_change)
LIMIT 20;
