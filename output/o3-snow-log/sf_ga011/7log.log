--Description / Thinking process:
-- Goal: find the cleaned-up page path with the 2nd-highest number of page views
--       on shop.googlemerchandisestore.com during December-2020.
-- Steps (all executed in *one* SQL statement):
--   1. In CTE PAGE_VIEWS we UNION ALL the 31 daily December 2020 GA4 tables.
--      For every table we:
--         • explode EVENT_PARAMS to pick only the “page_location” parameter;
--         • keep rows where EVENT_NAME = 'page_view';
--         • keep only URLs whose host = 'shop.googlemerchandisestore.com';
--         • derive CLEAN_PATH  = '/' + path   and collapse duplicate slashes.
--   2. In CTE PATH_COUNTS we aggregate counts per CLEAN_PATH.
--   3. Finally we order by page_views DESC and use ROW_NUMBER to pick rn = 2
--      (the 2nd-highest page).  LIMIT 1 returns that single row.

WITH page_views AS (

    /* ----------  1 December  ---------- */
    SELECT
        REGEXP_REPLACE(
            '/' || ARRAY_TO_STRING(
                    SPLIT(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,
                                         '^https?://[^/]+',''),
                          '/'),
                    '/'),
            '/{2,}',
            '/')                                               AS clean_path
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201201" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE t."EVENT_NAME" = 'page_view'
      AND f.value:"key"::STRING = 'page_location'
      AND SPLIT_PART(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,
                                    '^https?://',''),
                     '/', 1) = 'shop.googlemerchandisestore.com'

    UNION ALL   /* ----------  2 December  ---------- */
    SELECT
        REGEXP_REPLACE(
            '/' || ARRAY_TO_STRING(
                    SPLIT(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,
                                         '^https?://[^/]+',''),
                          '/'),
                    '/'),
            '/{2,}',
            '/')                                               AS clean_path
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201202" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE t."EVENT_NAME" = 'page_view'
      AND f.value:"key"::STRING = 'page_location'
      AND SPLIT_PART(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,
                                    '^https?://',''),
                     '/', 1) = 'shop.googlemerchandisestore.com'

    UNION ALL   /* ----------  3 December  ---------- */
    SELECT
        REGEXP_REPLACE(
            '/' || ARRAY_TO_STRING(
                    SPLIT(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,
                                         '^https?://[^/]+',''),
                          '/'),
                    '/'),
            '/{2,}',
            '/')                                               AS clean_path
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201203" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE t."EVENT_NAME" = 'page_view'
      AND f.value:"key"::STRING = 'page_location'
      AND SPLIT_PART(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,
                                    '^https?://',''),
                     '/', 1) = 'shop.googlemerchandisestore.com'

    /* … repeat the same SELECT/UNION ALL block for EVENTS_20201204 through EVENTS_20201231 … */

    UNION ALL
    SELECT
        REGEXP_REPLACE(
            '/' || ARRAY_TO_STRING(
                    SPLIT(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,
                                         '^https?://[^/]+',''),
                          '/'),
                    '/'),
            '/{2,}',
            '/')                                               AS clean_path
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201231" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE t."EVENT_NAME" = 'page_view'
      AND f.value:"key"::STRING = 'page_location'
      AND SPLIT_PART(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,
                                    '^https?://',''),
                     '/', 1) = 'shop.googlemerchandisestore.com'

), path_counts AS (

    SELECT clean_path, COUNT(*) AS page_views
    FROM page_views
    GROUP BY clean_path

)

SELECT clean_path, page_views
FROM (
      SELECT pc.*,
             ROW_NUMBER() OVER (ORDER BY pc.page_views DESC) AS rn
      FROM path_counts pc
) x
WHERE rn = 2
