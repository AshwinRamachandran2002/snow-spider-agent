       SPLIT_PART(REGEXP_REPLACE(pl,'^https?://',''), '/', 1)    AS "host",
       '/' || ARRAY_TO_STRING(SPLIT(REGEXP_REPLACE(pl,'^https?://[^/]+',''),'/'),'/') AS "raw_path"
