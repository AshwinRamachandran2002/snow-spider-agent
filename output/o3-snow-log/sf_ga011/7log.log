--Description: 6) Clean duplicated slashes for a sample of paths (DEC-01) – avoid quoted-identifier problem by
--             not double-quoting the alias RAW_PATH.
SELECT 
       REGEXP_REPLACE(RAW_PATH,'/{2,}','/') AS CLEAN_PATH
FROM (
      /* build RAW_PATH for the first 100 page_view rows on 2020-12-01 */
      SELECT 
             '/' || ARRAY_TO_STRING(
                    SPLIT(REGEXP_REPLACE(pl,'^https?://[^/]+',''),'/'),
                    '/')                                         AS RAW_PATH ,
             pl                                                 -- keep original url for filtering
      FROM (
            SELECT f.value:"value":"string_value"::STRING AS pl
            FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201201" t,
                 LATERAL FLATTEN(input => t."EVENT_PARAMS") f
            WHERE t."EVENT_NAME" = 'page_view'
              AND f.value:"key"::STRING = 'page_location'
            LIMIT 100
          ) q
      WHERE SPLIT_PART(REGEXP_REPLACE(pl,'^https?://',''), '/', 1)
            = 'shop.googlemerchandisestore.com'
)
LIMIT 20;
