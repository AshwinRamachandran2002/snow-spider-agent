    /* UNION ALL block for EVENTS_20201201 … EVENTS_20201231 (see #8 for pattern) */
    SELECT REGEXP_REPLACE(
             '/'||ARRAY_TO_STRING(
                 SPLIT(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,'^https?://[^/]+',''),'/'),
             '/'), '/{2,}','/') AS CLEAN_PATH
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201201" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE t."EVENT_NAME"='page_view'
      AND f.value:"key"::STRING='page_location'
      AND SPLIT_PART(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,'^https?://',''),
                     '/',1)='shop.googlemerchandisestore.com'
    UNION ALL
    /* … include SELECTs for the other December tables … */
    SELECT REGEXP_REPLACE(
             '/'||ARRAY_TO_STRING(
                 SPLIT(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,'^https?://[^/]+',''),'/'),
             '/'), '/{2,}','/')
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201231" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE t."EVENT_NAME"='page_view'
      AND f.value:"key"::STRING='page_location'
      AND SPLIT_PART(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,'^https?://',''),
                     '/',1)='shop.googlemerchandisestore.com'
), path_counts AS (
    SELECT CLEAN_PATH, COUNT(*) AS TOTAL_VIEWS
    FROM page_views
    GROUP BY CLEAN_PATH
)
SELECT CLEAN_PATH, TOTAL_VIEWS
FROM (
    SELECT pc.*,
           ROW_NUMBER() OVER (ORDER BY pc.TOTAL_VIEWS DESC) AS RN
    FROM path_counts pc
) sub
WHERE RN = 2    -- second-highest
LIMIT 1
