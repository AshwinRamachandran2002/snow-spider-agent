--Description: 8) Aggregate all DEC-2020 tables, return the page with 2nd-highest views
WITH december_tables AS (
    SELECT *
    FROM (
        /* union all all 31 December-2020 daily tables explicitly */
        SELECT 'EVENTS_20201201' AS tbl UNION ALL SELECT 'EVENTS_20201202' UNION ALL
        SELECT 'EVENTS_20201203' UNION ALL SELECT 'EVENTS_20201204' UNION ALL
        SELECT 'EVENTS_20201205' UNION ALL SELECT 'EVENTS_20201206' UNION ALL
        SELECT 'EVENTS_20201207' UNION ALL SELECT 'EVENTS_20201208' UNION ALL
        SELECT 'EVENTS_20201209' UNION ALL SELECT 'EVENTS_20201210' UNION ALL
        SELECT 'EVENTS_20201211' UNION ALL SELECT 'EVENTS_20201212' UNION ALL
        SELECT 'EVENTS_20201213' UNION ALL SELECT 'EVENTS_20201214' UNION ALL
        SELECT 'EVENTS_20201215' UNION ALL SELECT 'EVENTS_20201216' UNION ALL
        SELECT 'EVENTS_20201217' UNION ALL SELECT 'EVENTS_20201218' UNION ALL
        SELECT 'EVENTS_20201219' UNION ALL SELECT 'EVENTS_20201220' UNION ALL
        SELECT 'EVENTS_20201221' UNION ALL SELECT 'EVENTS_20201222' UNION ALL
        SELECT 'EVENTS_20201223' UNION ALL SELECT 'EVENTS_20201224' UNION ALL
        SELECT 'EVENTS_20201225' UNION ALL SELECT 'EVENTS_20201226' UNION ALL
        SELECT 'EVENTS_20201227' UNION ALL SELECT 'EVENTS_20201228' UNION ALL
        SELECT 'EVENTS_20201229' UNION ALL SELECT 'EVENTS_20201230' UNION ALL
        SELECT 'EVENTS_20201231'
    )
), full_data AS (
    SELECT
           REGEXP_REPLACE(
               '/' || ARRAY_TO_STRING(
                       SPLIT(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,'^https?://[^/]+',''),'/'),
                       '/'),
               '/{2,}',
               '/')                                              AS "clean_path"
    FROM december_tables dt,
         LATERAL (
             SELECT * FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE.identifier(dt.tbl)
         ) t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE t."EVENT_NAME" = 'page_view'
      AND f.value:"key"::STRING = 'page_location'
      AND SPLIT_PART(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,'^https?://',''), '/', 1) = 'shop.googlemerchandisestore.com'
)
SELECT "clean_path", COUNT(*) AS "total_page_views"
FROM full_data
GROUP BY 1
ORDER BY "total_page_views" DESC
LIMIT 2;            -- second row returned is the requested page
