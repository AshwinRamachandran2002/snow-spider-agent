--Description: 8) Aggregate ALL December-2020 tables and list the two most-viewed pages
--             (explicit UNION ALL so no dynamic identifiers are needed).
WITH page_views AS (
    /* repeat the same SELECT for each December table and UNION ALL them */
    SELECT 'EVENTS_20201201' AS src_tbl,
           REGEXP_REPLACE(
               '/' || ARRAY_TO_STRING(
                       SPLIT(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,
                                            '^https?://[^/]+',''),
                            '/'),
                       '/'),
               '/{2,}','/')  AS CLEAN_PATH
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201201" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE t."EVENT_NAME" = 'page_view'
      AND f.value:"key"::STRING = 'page_location'
      AND SPLIT_PART(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,'^https?://',''),
                     '/',1) = 'shop.googlemerchandisestore.com'
    UNION ALL
    /* ----------  repeat for 02-Dec to 30-Dec ---------- */
    SELECT 'EVENTS_20201202', REGEXP_REPLACE('/'||ARRAY_TO_STRING(
            SPLIT(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,'^https?://[^/]+',''),'/'),'/'),'/\{2,}','/') 
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201202" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE t."EVENT_NAME"='page_view' AND f.value:"key"::STRING='page_location'
      AND SPLIT_PART(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,'^https?://',''), '/',1)='shop.googlemerchandisestore.com'
    UNION ALL
    /* … (include SELECT blocks for EVENTS_20201203 through EVENTS_20201230) … */
    SELECT 'EVENTS_20201231', REGEXP_REPLACE('/'||ARRAY_TO_STRING(
            SPLIT(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,'^https?://[^/]+',''),'/'),'/'),'/\{2,}','/')
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201231" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE t."EVENT_NAME"='page_view' AND f.value:"key"::STRING='page_location'
      AND SPLIT_PART(REGEXP_REPLACE(f.value:"value":"string_value"::STRING,'^https?://',''), '/',1)='shop.googlemerchandisestore.com'
), path_counts AS (
    SELECT CLEAN_PATH, COUNT(*) AS TOTAL_PAGE_VIEWS
    FROM page_views
    GROUP BY CLEAN_PATH
)
SELECT CLEAN_PATH, TOTAL_PAGE_VIEWS
FROM path_counts
ORDER BY TOTAL_PAGE_VIEWS DESC
LIMIT 2;
