  REGEXP_REPLACE(
    '/' || ARRAY_TO_STRING(ARRAY_SLICE(SPLIT(loc_no_proto,'/'),1,999),'/'),
    '/{2,}','/'
  ) AS "clean_path"
FROM (
  SELECT SPLIT_PART(loc,'://',2) AS loc_no_proto
  FROM (
    SELECT f.VALUE:"value":"string_value"::STRING AS loc
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201207",
         LATERAL FLATTEN(input => "EVENT_PARAMS") f
    WHERE "EVENT_NAME" = 'page_view'
      AND f.VALUE:"key"::STRING = 'page_location'
  )
)
LIMIT 20
