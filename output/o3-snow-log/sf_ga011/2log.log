--Description: Count raw page-view occurrences by full URL on 1-Dec-2020 (corrected JSON path → value:string_value)
SELECT 
       ep.value:"value":"string_value"::STRING  AS "page_location",
       COUNT(*)                                AS "page_views"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201201" AS t,
     LATERAL FLATTEN(input => t."EVENT_PARAMS")             AS ep
WHERE t."EVENT_NAME" = 'page_view'
  AND ep.value:"key"::STRING = 'page_location'
  AND ep.value:"value":"string_value"::STRING ILIKE '%shop.googlemerchandisestore.com%'
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20
