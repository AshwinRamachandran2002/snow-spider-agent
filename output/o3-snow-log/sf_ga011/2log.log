Query:
--Description: Show URL-cleanup logic (strip protocol & domain, collapse double slashes) for 4-Dec-2020 (corrected JSON path)
SELECT 
       REGEXP_REPLACE(
         REGEXP_REPLACE(
           ep.value:"value":"string_value"::STRING,
           '^https?://shop\.googlemerchandisestore\.com', ''
         ),
         '/{2,}', '/'
       )                                         AS "clean_page_path",
       COUNT(*)                                  AS "page_views"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201204" AS t,
     LATERAL FLATTEN(input => t."EVENT_PARAMS")             AS ep
WHERE t."EVENT_NAME" = 'page_view'
  AND ep.value:"key"::STRING = 'page_location'
  AND ep.value:"value":"string_value"::STRING ILIKE '%shop.googlemerchandisestore.com%'
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20
