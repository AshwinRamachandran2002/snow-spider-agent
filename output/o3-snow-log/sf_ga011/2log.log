```sql
--Description: Determine the top two pages by total views in December after URL cleanup
WITH december_events AS ( /* same CTE as previous query */ ),
page_counts AS (
    SELECT REGEXP_REPLACE(
             REGEXP_REPLACE(
               ep.value:"string_value"::STRING,
               '^https?://shop\.googlemerchandisestore\.com', ''
             ),
             '/{2,}', '/'
           )                                   AS "clean_page_path",
           COUNT(*)                            AS "page_views"
    FROM december_events                      t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") ep
    WHERE t."EVENT_NAME" = 'page_view'
      AND ep.value:"key"::STRING = 'page_location'
      AND ep.value:"string_value"::STRING ILIKE '%shop.googlemerchandisestore.com%'
    GROUP BY 1
)
SELECT "clean_page_path",
       "page_views"
FROM (
      SELECT *,
             ROW_NUMBER() OVER (ORDER BY "page_views" DESC) AS rn
      FROM page_counts
     )
WHERE rn <= 2
ORDER BY "page_views" DESC;
```

