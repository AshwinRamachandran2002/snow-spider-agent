            UNION ALL
            SELECT * FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201205"
           ) t ,
           LATERAL FLATTEN ( INPUT => t."EVENT_PARAMS") f
