--Description: 5) Remove duplicated slashes to build a clean path (4-Dec-2020)
SELECT 
       REGEXP_REPLACE(
           PARSE_URL(f.value:"value":"string_value"::STRING):path::STRING ,
           '/{2,}',
           '/'
       ) AS "clean_path"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201204" t,
     LATERAL FLATTEN (INPUT => t."EVENT_PARAMS") f
WHERE t."EVENT_NAME" = 'page_view'
  AND f.value:"key"::STRING = 'page_location'
LIMIT 20
