```sql
--Description:
-- We need host + path from each “page_location” value on 4-Dec-2020.
-- • EVENT_PARAMS is an array → FLATTEN it.  
-- • Keep the element whose "key" equals 'page_location'.  
-- • PARSE_URL(url) returns an OBJECT: grab :host and :path.  
-- The query is limited to 20 rows for a quick check.

SELECT
       PARSE_URL(f.value:"value":"string_value"::STRING):host::STRING AS "host",
       PARSE_URL(f.value:"value":"string_value"::STRING):path::STRING AS "raw_path"
