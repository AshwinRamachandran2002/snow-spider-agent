Query:
--Description: 6) Apply the same cleaning logic to 15-Dec-2020 using the correct JSON path (value.string_value).
SELECT REGEXP_REPLACE(
         REGEXP_SUBSTR(
           f.value:"value":"string_value"::STRING,
           'https://shop\\.googlemerchandisestore\\.com/(.*)', 1, 1, 'e', 1),
         '/{2,}', '/')                   AS "clean_path",
       COUNT(*)                          AS "events_with_url"
FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20201215" t,
     LATERAL FLATTEN(input => t."EVENT_PARAMS") f
WHERE f.value:"key"::STRING = 'page_location'
  AND f.value:"value":"string_value" ILIKE 'https://shop.googlemerchandisestore.com/%'
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20
