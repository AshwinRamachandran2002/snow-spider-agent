--Description: 4) Count raw “page_location” URLs for 1-Dec-2020, without restricting to EVENT_NAME = 'page_view'.
SELECT f.value:"string_value"::STRING AS "page_location",
       COUNT(*)                       AS "events_with_url"
FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20201201" t,
     LATERAL FLATTEN(input => t."EVENT_PARAMS") f
WHERE f.value:"key"::STRING = 'page_location'
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20
