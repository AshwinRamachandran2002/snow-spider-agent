Query:
--Description: 7) Combine 1-Dec and 15-Dec to verify consistency, using value.string_value in both parts.
SELECT "clean_path",
       SUM("events_with_url") AS "total_events"
FROM (
  SELECT REGEXP_REPLACE(
           REGEXP_SUBSTR(
             f.value:"value":"string_value"::STRING,
             'https://shop\\.googlemerchandisestore\\.com/(.*)', 1, 1, 'e', 1),
           '/{2,}', '/')                AS "clean_path",
         COUNT(*)                       AS "events_with_url"
    FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20201201" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE f.value:"key"::STRING = 'page_location'
      AND f.value:"value":"string_value" ILIKE 'https://shop.googlemerchandisestore.com/%'
    GROUP BY 1
  UNION ALL
  SELECT REGEXP_REPLACE(
           REGEXP_SUBSTR(
             f.value:"value":"string_value"::STRING,
             'https://shop\\.googlemerchandisestore\\.com/(.*)', 1, 1, 'e', 1),
           '/{2,}', '/')                AS "clean_path",
         COUNT(*)                       AS "events_with_url"
    FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20201215" t,
         LATERAL FLATTEN(input => t."EVENT_PARAMS") f
    WHERE f.value:"key"::STRING = 'page_location'
      AND f.value:"value":"string_value" ILIKE 'https://shop.googlemerchandisestore.com/%'
    GROUP BY 1
) q
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20
