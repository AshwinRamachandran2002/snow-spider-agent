  SELECT * FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20201231"
),

paths AS (                  -- 2.  Extract & clean each page_location
  SELECT
    CASE
        WHEN REGEXP_SUBSTR(ep.value:"string_value"::STRING,
                           'https?://shop\.googlemerchandisestore\.com(/[^?#]*)',
                           1, 1, 'ie') IS NULL
        THEN NULL
        ELSE REGEXP_REPLACE(
               REGEXP_SUBSTR(
                 ep.value:"string_value"::STRING,
                 'https?://shop\.googlemerchandisestore\.com(/[^?#]*)', 1, 1, 'ie'
               ),
               '/{2,}', '/'
             )
    END                         AS page_path
  FROM december d,
       LATERAL FLATTEN(input => d."EVENT_PARAMS") ep
  WHERE d."EVENT_NAME"                 = 'page_view'
    AND ep.value:"key"::STRING         = 'page_location'
    AND ep.value:"string_value"::STRING ILIKE 'https://shop.googlemerchandisestore.com/%'
),

counts AS (                 -- 3.  Count page views
  SELECT
    COALESCE(page_path, '/')  AS page_path,     -- treat NULL as root
    COUNT(*)                  AS views
  FROM paths
  GROUP BY page_path
),

ranked AS (                 -- 4.  Exclude the root page and rank
  SELECT
    page_path,
    views,
    ROW_NUMBER() OVER (ORDER BY views DESC) AS rnk
  FROM counts
  WHERE page_path NOT IN ('/', '')            -- drop the home page
)

-- 5.  Second-highest page overall
SELECT page_path
FROM ranked
WHERE rnk = 1;
