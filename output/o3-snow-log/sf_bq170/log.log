```sql
/* -----------------------------------------------------------
   Copy-number landscape (HG38) for TCGA-BRCA – GDC Release 23
   -----------------------------------------------------------
   1.  Collect allelic CNV segments for TCGA-BRCA (R23 table)
   2.  Intersect every segment with every cytoband (HG38)
   3.  For every case × cytoband, calculate the
       overlap-weighted average copy number and round it
   4.  Convert the rounded value to a CNV category
        – 0  → Homozygous deletion
        – 1  → Heterozygous deletion
        – 2  → Diploid
        – 3  → Gain
        – >3 → Amplification
   5.  For every cytoband, report the % of TCGA-BRCA cases in
       each CNV class (two-decimal precision)
----------------------------------------------------------------*/

WITH brca_seg AS (   -- TCGA-BRCA, Release-23 segments
    SELECT
        /* Prefer CASE_BARCODE, fall back to other possible IDs */
        COALESCE("case_barcode","sample_barcode","aliquot_barcode")        AS case_id,
        "chromosome"                                                      AS chr,      -- e.g. 'chr1'
        "start_pos"                                                       AS seg_start,
        "end_pos"                                                         AS seg_end,
        "copy_number"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
    WHERE "project_short_name" = 'TCGA-BRCA'
),

bands AS (          -- Cytoband co-ordinates (HG38)
    SELECT
        "cytoband_name",
        "chromosome"        AS chr,          -- e.g. 'chr1'
        "hg38_start"        AS band_start,
        "hg38_stop"         AS band_end
    FROM TCGA_MITELMAN.PROD.CYTOBANDS_HG38
),

overlap_raw AS (    -- Intersect segments with cytobands
    SELECT
        s.case_id,
        b."cytoband_name",
        b.band_start,
        b.band_end,
        /* genomic overlap length (0 if none) */
        GREATEST(
            0,
            LEAST(s.seg_end, b.band_end) - GREATEST(s.seg_start, b.band_start)
        )                                              AS ov_len,
        s.copy_number
    FROM brca_seg  s
    JOIN bands     b
      ON  b.chr = s.chr
    /* retain only true overlaps */
    WHERE GREATEST(
              0,
              LEAST(s.seg_end, b.band_end) - GREATEST(s.seg_start, b.band_start)
          ) > 0
),

band_case_cn AS (   -- Weighted CN per cytoband × case
    SELECT
        case_id,
        cytoband_name,
        band_start,
        band_end,
        /* weighted average, then round to nearest integer */
        ROUND(
            SUM(ov_len * copy_number) / NULLIF(SUM(ov_len),0)
        )                                              AS rounded_cn
    FROM overlap_raw
    GROUP BY
        case_id, cytoband_name, band_start, band_end
),

band_case_class AS ( -- Assign CNV category
    SELECT
        cytoband_name,
        band_start,
        band_end,
        case_id,
        CASE
            WHEN rounded_cn = 0 THEN 'Homozygous Deletion'
            WHEN rounded_cn = 1 THEN 'Heterozygous Deletion'
            WHEN rounded_cn = 2 THEN 'Diploid'
            WHEN rounded_cn = 3 THEN 'Gain'
            WHEN rounded_cn > 3 THEN 'Amplification'
            ELSE 'Unknown'
        END                                            AS cnv_type
    FROM band_case_cn
),

tot_cases AS (       -- Total TCGA-BRCA cases present
    SELECT COUNT(DISTINCT case_id) AS n_cases
    FROM band_case_class
),

band_freq AS (       -- % frequency of each CNV type per cytoband
    SELECT
        c.cytoband_name,
        /* the start/stop are constant per cytoband */
        MIN(c.band_start)                             AS hg38_start,
        MIN(c.band_end)                               AS hg38_end,

        100.0 * SUM(CASE WHEN cnv_type='Homozygous Deletion'  THEN 1 ELSE 0 END)
              / n.n_cases                             AS pct_homdel,

        100.0 * SUM(CASE WHEN cnv_type='Heterozygous Deletion' THEN 1 ELSE 0 END)
              / n.n_cases                             AS pct_hetdel,

        100.0 * SUM(CASE WHEN cnv_type='Diploid'               THEN 1 ELSE 0 END)
              / n.n_cases                             AS pct_diploid,

        100.0 * SUM(CASE WHEN cnv_type='Gain'                  THEN 1 ELSE 0 END)
              / n.n_cases                             AS pct_gain,

        100.0 * SUM(CASE WHEN cnv_type='Amplification'         THEN 1 ELSE 0 END)
              / n.n_cases                             AS pct_amp
    FROM band_case_class  c
    CROSS JOIN tot_cases  n
    GROUP BY
        c.cytoband_name, n.n_cases
)

SELECT
    cytoband_name,
    hg38_start,
    hg38_end,
    ROUND(pct_homdel , 2) AS pct_homozygous_deletion,
    ROUND(pct_hetdel , 2) AS pct_heterozygous_deletion,
    ROUND(pct_diploid, 2) AS pct_diploid,
    ROUND(pct_gain   , 2) AS pct_gain,
    ROUND(pct_amp    , 2) AS pct_amplification
FROM band_freq
ORDER BY cytoband_name;
```
