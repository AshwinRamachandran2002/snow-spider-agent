--Description: Collect score & board for every quick-play completion on Sep-15 (no limit, but sub-query for later use)  
SELECT MAX(IFF(f.value:"key"::STRING='board',
               f.value:"value":"string_value"::STRING,NULL))                                     AS "board",
       MAX(IFF(f.value:"key"::STRING='score',
               COALESCE(f.value:"value":"int_value"::NUMBER,
                        f.value:"value":"double_value"::NUMBER,
                        f.value:"value":"float_value"::NUMBER,
                        f.value:"value":"string_value"::NUMBER),NULL))                          AS "score"
FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915"  t,
     LATERAL FLATTEN(input => t."event_params")          f
WHERE t."event_name" = 'level_end_quickplay'
GROUP BY t."event_timestamp", t."user_pseudo_id"
LIMIT 20;
