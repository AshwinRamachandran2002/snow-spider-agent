```sql
--Description (thinking process):
-- We need an “average score” for each board type on 2018-09-15 from quick-play completions.
-- The obvious completion event is “level_end_quickplay”.  
-- By flattening its event_params we can always pull the board code (key = 'board').  
-- The dataset, however, does not appear to store a dedicated “score” field inside those events;  
-- some games embed the numeric result under a generic key such as “value” or “score”.  
-- To capture anything that might be a score we therefore look for parameter keys IN ('score','value').  
-- If none is present the column will be NULL; the AVG() of NULLs stays NULL but the board still appears,  
-- giving us visibility into which boards lack score data.  
-- The query returns one row per board with its average of whatever score values exist.

WITH per_completion AS (
    SELECT
        MAX(CASE WHEN f.value:"key"::STRING = 'board'
                 THEN f.value:"value":"string_value"::STRING END)                                   AS board,
        MAX(CASE WHEN f.value:"key"::STRING IN ('score','value')
                 THEN COALESCE(f.value:"value":"int_value"::NUMBER,
                               f.value:"value":"double_value"::NUMBER,
                               f.value:"value":"float_value"::NUMBER,
                               f.value:"value":"string_value"::NUMBER) END)                         AS score
    FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915" t,
         LATERAL FLATTEN(input => t."event_params") f
    WHERE t."event_name" = 'level_end_quickplay'
    GROUP BY t."event_timestamp", t."user_pseudo_id"         -- one row per completion
)
SELECT board,
       AVG(score) AS avg_score
FROM   per_completion
WHERE  board IS NOT NULL
GROUP  BY board
ORDER  BY avg_score DESC NULLS LAST;
```
