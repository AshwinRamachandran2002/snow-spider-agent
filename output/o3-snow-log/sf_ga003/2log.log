--Description (thinking process):
-- We want to confirm that numeric “level” values actually exist for quick-play events on 2018-09-15,
-- and view a small sample paired with their board codes.  
-- Strategy
--   1. Look at every event whose name contains “quickplay” (captures start, end, fail).  
--   2. FLATTEN the JSON array event_params.  
--   3. For each event (identified by user_pseudo_id + event_timestamp) pull:  
--        • board  → parameter key = 'board' (string_value)  
--        • level  → parameter key = 'level' (numeric, can sit in int/double/float/string slot)  
--   4. Return up to 20 rows where both fields are present so we can visually verify data is there.

WITH per_event AS (  
    SELECT  
        MAX(CASE WHEN f.value:"key"::STRING = 'board'
                 THEN f.value:"value":"string_value"::STRING END)                                   AS board,  
        MAX(CASE WHEN f.value:"key"::STRING = 'level'
                 THEN COALESCE(f.value:"value":"int_value"::NUMBER,
                               f.value:"value":"double_value"::NUMBER,
                               f.value:"value":"float_value"::NUMBER,
                               f.value:"value":"string_value"::NUMBER) END)                         AS level_num  
    FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915" t  
         ,LATERAL FLATTEN(input => t."event_params") f  
    WHERE t."event_name" ILIKE '%quickplay%'  
    GROUP BY t."user_pseudo_id", t."event_timestamp"   
)  
SELECT board, level_num  
FROM   per_event  
WHERE  board IS NOT NULL  
  AND  level_num IS NOT NULL  
LIMIT 20;
