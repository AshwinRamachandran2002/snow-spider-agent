```sql
--Description (thinking process):
-- We would like a real performance metric for each board on 2018-09-15.  
-- The only numeric field present in quick-play events is “level”.  
-- Therefore, we:  
--   1) Grab every event whose name contains “quickplay” (start, end, fail).  
--   2) FLATTEN event_params, extract the board code (key = 'board') and the numeric level (key = 'level').  
--   3) Re-aggregate to one row per event (timestamp + user) holding those two values.  
--   4) Compute the average level per board, ordering from highest to lowest.  

WITH per_event AS (  
    SELECT  
        MAX(CASE WHEN f.value:"key"::STRING = 'board'  
                 THEN f.value:"value":"string_value"::STRING END)                                   AS board,  
        MAX(CASE WHEN f.value:"key"::STRING = 'level'  
                 THEN COALESCE(f.value:"value":"int_value"::NUMBER,  
                               f.value:"value":"double_value"::NUMBER,  
                               f.value:"value":"float_value"::NUMBER,  
                               f.value:"value":"string_value"::NUMBER) END)                         AS level_num  
    FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915" t  
         ,LATERAL FLATTEN(input => t."event_params") f  
    WHERE t."event_name" ILIKE '%quickplay%'  
    GROUP BY t."user_pseudo_id", t."event_timestamp"                -- one record per event  
)  
SELECT board,  
       AVG(level_num) AS avg_level  
FROM   per_event  
WHERE  board IS NOT NULL  
  AND  level_num IS NOT NULL  
GROUP  BY board  
ORDER  BY avg_level DESC;  
