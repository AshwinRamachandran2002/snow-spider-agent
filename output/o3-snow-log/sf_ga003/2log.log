```sql
--Description (thinking process):  
--1. Focus on quick-play completions → event_name = 'level_end_quickplay'.  
--2. Every event carries a JSON array “event_params”.  We FLATTEN it to reach each parameter object.  
--3. For each completion we need two pieces:  
--      a) board type  → parameter whose key = 'board' (string_value).  
--      b) numeric result (the “score”), but the dataset may call it either ‘score’ or generic ‘value’.  
--   Therefore we look for parameter keys ILIKE '%score%' OR exactly 'value'.  
--4. Re-aggregate back to one row per completion (GROUP BY timestamp & user) and keep rows that have both board and score.  
--5. Finally, average those scores per board to see which board was most effective on 2018-09-15.  

WITH per_completion AS (  
    SELECT  
        MAX(CASE WHEN f.value:"key"::STRING = 'board'  
                 THEN f.value:"value":"string_value"::STRING END)                                            AS board,  
        MAX(CASE WHEN (f.value:"key"::STRING = 'value' OR f.value:"key"::STRING ILIKE '%score%')  
                 THEN COALESCE(f.value:"value":"int_value"::NUMBER,  
                               f.value:"value":"double_value"::NUMBER,  
                               f.value:"value":"float_value"::NUMBER,  
                               f.value:"value":"string_value"::NUMBER) END)                                    AS score  
    FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915" t  
         ,LATERAL FLATTEN(input => t."event_params") f  
    WHERE t."event_name" = 'level_end_quickplay'  
    GROUP BY t."event_timestamp", t."user_pseudo_id"          -- one record per level completion  
)  
SELECT board,  
       AVG(score) AS avg_score  
FROM   per_completion  
WHERE  board IS NOT NULL  
  AND  score IS NOT NULL  
GROUP BY board  
ORDER BY avg_score DESC;  
```
