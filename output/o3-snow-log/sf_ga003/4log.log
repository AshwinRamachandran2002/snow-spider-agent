--Description: Compute the average numeric “value” metric per board for
--‘level_complete_quickplay’ events only on 15-Sep-2018, using a single FLATTEN
--pass and pivoting parameters to avoid cartesian multiplication.
SELECT
       board_type,
       AVG(value_metric) AS avg_score
FROM (
        SELECT
               MAX(CASE WHEN f.value:"key"::STRING = 'board'
                        THEN f.value:"string_value"::STRING END)                       AS board_type,
               MAX(CASE WHEN f.value:"key"::STRING = 'value'
                        THEN COALESCE(f.value:"int_value",f.value:"double_value")::FLOAT END) AS value_metric
        FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915" t,
             LATERAL FLATTEN(input => t."event_params") f
        WHERE t."event_name" = 'level_complete_quickplay'
        GROUP BY t."event_timestamp"
) sub
WHERE board_type IS NOT NULL
GROUP BY board_type
ORDER BY avg_score DESC
LIMIT 20
