/* Average score per board-type for quick-play completions on 15-Sep-2018 */
WITH quickplay_completions AS (
    SELECT
        e."event_timestamp",
        MAX(
            CASE WHEN f.value:"key"::STRING = 'board'
                 THEN f.value:"string_value"::STRING
            END
        ) AS board_type,
        MAX(
            CASE WHEN f.value:"key"::STRING = 'score'
                 THEN COALESCE( f.value:"int_value"::NUMBER,
                                f.value:"double_value"::NUMBER,
                                f.value:"float_value"::NUMBER,
                                TRY_TO_NUMBER(f.value:"string_value"::STRING) )
            END
        ) AS score
    FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915"  AS e
         , LATERAL FLATTEN(input => e."event_params")        AS f
    WHERE e."event_name" IN ('level_complete_quickplay', 'level_end_quickplay')
    GROUP BY e."event_timestamp"
)
SELECT
    board_type,
    AVG(score) AS average_score
FROM   quickplay_completions
WHERE  score IS NOT NULL
GROUP  BY board_type
ORDER  BY average_score DESC NULLS LAST;
