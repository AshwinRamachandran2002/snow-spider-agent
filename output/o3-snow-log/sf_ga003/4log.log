                               f.value:"int_value"::STRING   ,
                               f.value:"double_value"::STRING )
            END
        )                                             AS board_type,
        MAX(
            CASE
                WHEN f.value:"key"::STRING IN ('score' ,               -- common names
                                               'coins_earned',
                                               'points'      ,
                                               'coins')
                THEN COALESCE( f.value:"double_value",
