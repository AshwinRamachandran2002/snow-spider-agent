```sql
--Description: Combine ‘level_end_quickplay’ and ‘level_complete_quickplay’ events
--from 15-Sep-2018 and rank board types by their overall average numeric “value”
--metric.  The query pulls both parameters in a single FLATTEN pass, capturing the
--board identifier from whichever sub-field (string/int/double) is populated and
--excluding empty/null board values before averaging.
SELECT
       board_type,
       AVG(value_metric) AS avg_score
FROM (
        SELECT
               MAX(
                   CASE WHEN f.value:"key"::STRING = 'board'
                        THEN COALESCE(
                                 f.value:"string_value"::STRING,
                                 f.value:"int_value"::STRING,
                                 f.value:"double_value"::STRING)
                   END)                                                               AS board_type,
               MAX(
                   CASE WHEN f.value:"key"::STRING = 'value'
                        THEN COALESCE(
                                 f.value:"int_value",
                                 f.value:"double_value")::FLOAT
                   END)                                                               AS value_metric
        FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915" t,
             LATERAL FLATTEN(input => t."event_params") f
        WHERE t."event_name" IN ('level_end_quickplay', 'level_complete_quickplay')
        GROUP BY t."event_timestamp"
) evt
WHERE board_type IS NOT NULL
  AND board_type <> ''
GROUP BY board_type
ORDER BY avg_score DESC
LIMIT 20;
```
