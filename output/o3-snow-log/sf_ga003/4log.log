       SUM(IFF(f.value:"string_value" IS NOT NULL
               AND f.value:"string_value" <> '', 1, 0))                AS nonempty_string_values,
       SUM(IFF(f.value:"int_value" IS NOT NULL, 1, 0))                 AS int_values_present,
