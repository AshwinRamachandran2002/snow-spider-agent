```sql
--Description: Combine both completion event names and order by highest average score, giving the final view  
SELECT  
       board_type,  
       AVG(score_value) AS "avg_score"  
FROM (  
       SELECT  
              b.value:"string_value"::STRING                         AS board_type,  
              COALESCE(s.value:"int_value",s.value:"double_value")::FLOAT AS score_value  
       FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915" t  
