--Description: Count how many “board” parameters in 15-Sep-2018 quick-play events
--actually contain a non-empty identifier in each possible sub-field (string_value,
--int_value, double_value).  This confirms whether board data exists before we
--attempt any board-level score analysis.
SELECT
