        /* Collect board label and numeric score for every “post_score” event */
        SELECT
               MAX(
                   CASE
                       WHEN f.value:"key" IN ('board', 'level_name')
                       THEN f.value:"value":"string_value"::STRING
                   END
               )                                                             AS board_type,
               MAX(
                   CASE
                       WHEN f.value:"key" = 'score'
                       THEN COALESCE(f.value:"value":"int_value",
