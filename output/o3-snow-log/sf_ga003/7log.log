```sql
--Description:  Compute the average score for each board type on 15-Sep-2018.
--              Step 1 (CTE “events”):  For every “post_score” event, flatten the
--              event_params array and use conditional aggregation to pull the
--              board label (key = 'board') and the numeric score (key = 'score').
--              This yields one row per event with both values.
--              Step 2:  From those rows, keep only events that have both fields,
--              then calculate the average score per board and rank them from
--              highest to lowest.  Limit to 20 rows for brevity.
WITH events AS (
    SELECT
        MAX(CASE WHEN f.value:"key" = 'board'
                 THEN f.value:"value":"string_value"::STRING END)                        AS board_type,
        MAX(CASE WHEN f.value:"key" = 'score'
                 THEN COALESCE(f.value:"value":"int_value",
                               f.value:"value":"double_value",
                               f.value:"value":"float_value")::NUMBER END)               AS score
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t
         , LATERAL FLATTEN(input => t."event_params") f
    WHERE t."event_name" = 'post_score'
    GROUP BY t."event_timestamp"
)
SELECT
    board_type,
    AVG(score) AS avg_score
FROM events
WHERE board_type IS NOT NULL
  AND score      IS NOT NULL
GROUP BY board_type
ORDER BY avg_score DESC
LIMIT 20;
```
