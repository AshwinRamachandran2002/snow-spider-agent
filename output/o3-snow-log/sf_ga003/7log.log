```sql
--Description: 8)  Compute the average score for every board type on 15-Sep-2018
--              from the “post_score” events.  First, build a sub-set of events
--              (identified by event_timestamp) with both board label and score
--              using conditional aggregation.  Then average the score per board.
SELECT
       board_type,
       AVG(score) AS avg_score
FROM (
    SELECT
           MAX(CASE WHEN f.value:"key" IN ('board','level_name')
                    THEN f.value:"value":"string_value"::STRING END)        AS board_type,
           MAX(CASE WHEN f.value:"key" = 'score'
                    THEN COALESCE(f.value:"value":"int_value",
                                   f.value:"value":"double_value",
                                   f.value:"value":"float_value")::NUMBER END)
                                                                          AS score
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t
         , LATERAL FLATTEN(input => t."event_params") f
    WHERE t."event_name" = 'post_score'
    GROUP BY t."event_timestamp"
) evt
GROUP BY board_type
LIMIT 20;
```

```sql
--Description: 9)  Re-calculate the average score per board type but exclude any
--              events where either the board label or the numeric score is NULL,
--              ensuring that only complete data contributes to the averages.
SELECT
       board_type,
       AVG(score) AS avg_score
FROM (
    SELECT
           MAX(CASE WHEN f.value:"key" IN ('board','level_name')
                    THEN f.value:"value":"string_value"::STRING END)        AS board_type,
           MAX(CASE WHEN f.value:"key" = 'score'
                    THEN COALESCE(f.value:"value":"int_value",
                                   f.value:"value":"double_value",
                                   f.value:"value":"float_value")::NUMBER END)
                                                                          AS score
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t
         , LATERAL FLATTEN(input => t."event_params") f
    WHERE t."event_name" = 'post_score'
    GROUP BY t."event_timestamp"
) evt
WHERE board_type IS NOT NULL
  AND score      IS NOT NULL
GROUP BY board_type
LIMIT 20;
```

```sql
--Description: 10)  Present the average scores for each board type, ordered from
--               highest to lowest, for the 15-Sep-2018 “post_score” events.
SELECT
       board_type,
       ROUND(AVG(score), 2) AS avg_score
FROM (
    SELECT
           MAX(CASE WHEN f.value:"key" IN ('board','level_name')
                    THEN f.value:"value":"string_value"::STRING END)        AS board_type,
           MAX(CASE WHEN f.value:"key" = 'score'
                    THEN COALESCE(f.value:"value":"int_value",
                                   f.value:"value":"double_value",
                                   f.value:"value":"float_value")::NUMBER END)
                                                                          AS score
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t
         , LATERAL FLATTEN(input => t."event_params") f
    WHERE t."event_name" = 'post_score'
    GROUP BY t."event_timestamp"
) evt
WHERE board_type IS NOT NULL
  AND score      IS NOT NULL
GROUP BY board_type
ORDER BY avg_score DESC
LIMIT 20;
