             , LATERAL FLATTEN(INPUT => t."event_params") f
        WHERE t."event_name" = 'post_score'
        GROUP BY t."event_timestamp"
     ) s
WHERE board_type IN ('S', 'M', 'L')      -- quick-play board sizes
  AND score IS NOT NULL
GROUP BY board_type
ORDER BY avg_score DESC NULLS LAST;
