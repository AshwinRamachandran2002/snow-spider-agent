```

```sql
--Description: Pull out board type values from completions (board key value)
SELECT 
       t."user_pseudo_id",
       f.value:"value":"string_value"::STRING        AS "board",
       t."event_timestamp"
FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915" t,
     LATERAL FLATTEN(input => t."event_params") f
WHERE t."event_name" = 'level_end_quickplay'
  AND f.value:"key"::STRING = 'board'
LIMIT 20;
```

```sql
--Description: Look for any parameter whose key contains the word “score” so we know the exact key name
SELECT DISTINCT f.value:"key"::STRING AS "possible_score_key"
FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915" t,
     LATERAL FLATTEN(input => t."event_params") f
WHERE t."event_name" = 'level_end_quickplay'
  AND f.value:"key"::STRING ILIKE '%score%'
LIMIT 20;
```

```sql
--Description: Sample out both board and score for level_end_quickplay, side-by-side
SELECT 
       MAX(CASE WHEN f.value:"key"::STRING = 'board'  THEN f.value:"value":"string_value"::STRING END)  AS "board",
       MAX(CASE WHEN f.value:"key"::STRING = 'score'  THEN COALESCE(f.value:"value":"int_value", f.value:"value":"double_value")::NUMBER END) AS "score"
FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915" t,
     LATERAL FLATTEN(input => t."event_params") f
WHERE t."event_name" = 'level_end_quickplay'
GROUP BY t."event_timestamp"
LIMIT 20;
```

```sql
--Description: Aggregate – average score by board for level_end_quickplay on 2018-09-15
SELECT 
       board,
       AVG(score) AS avg_score
FROM (
    SELECT 
           MAX(CASE WHEN f.value:"key"::STRING = 'board' THEN f.value:"value":"string_value"::STRING END)  AS board,
           MAX(CASE WHEN f.value:"key"::STRING = 'score' THEN COALESCE(f.value:"value":"int_value", f.value:"value":"double_value")::NUMBER END) AS score
    FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915" t,
         LATERAL FLATTEN(input => t."event_params") f
    WHERE t."event_name" = 'level_end_quickplay'
    GROUP BY t."event_timestamp"
) sub
GROUP BY board
LIMIT 20;
```

```sql
--Description: If the score is stored under a different key (e.g., “steps” or “moves”), swap that key here and run again
SELECT 
       board,
       AVG(moves) AS avg_moves
FROM (
    SELECT 
           MAX(CASE WHEN f.value:"key"::STRING = 'board' THEN f.value:"value":"string_value"::STRING END)  AS board,
           MAX(CASE WHEN f.value:"key"::STRING = 'moves' THEN f.value:"value":"int_value"::NUMBER END)     AS moves
    FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915" t,
         LATERAL FLATTEN(input => t."event_params") f
    WHERE t."event_name" = 'level_end_quickplay'
    GROUP BY t."event_timestamp"
) sub
GROUP BY board
LIMIT 20;
```
