WITH completed_events AS (   -- one row per quick-play completion on 15-Sep-2018
    SELECT
        t."event_timestamp",

        /* board type */
        MAX(
            CASE
                WHEN f.value:"key"::STRING = 'board'
                THEN f.value:"value":"string_value"::STRING
            END
        )                                                           AS "board",

        /* numeric score stored in the generic “value” parameter */
        MAX(
            CASE
                WHEN f.value:"key"::STRING = 'value' THEN
                     CASE
                         WHEN f.value:"value":"int_value"         IS NOT NULL THEN f.value:"value":"int_value"::FLOAT
                         WHEN f.value:"value":"double_value"      IS NOT NULL THEN f.value:"value":"double_value"::FLOAT
                         WHEN f.value:"value":"string_value"      IS NOT NULL THEN TRY_TO_NUMBER(f.value:"value":"string_value"::STRING)::FLOAT
                     END
            END
        )                                                           AS "score"
    FROM "FIREBASE"."ANALYTICS_153293282"."EVENTS_20180915" t,
         LATERAL FLATTEN(input => t."event_params")             f
    WHERE t."event_name" = 'level_end_quickplay'
    GROUP BY t."event_timestamp"
)

