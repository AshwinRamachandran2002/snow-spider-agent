--Description: 8) Pre-check – average of that candidate performance value by board type (20 rows max)
SELECT  board,
        AVG(score_like) AS avg_score_like
FROM (
        SELECT MAX(CASE WHEN f.value:"key"::STRING = 'board'
                        THEN f.value:"string_value"::STRING END)                                     AS board,
               MAX(CASE WHEN f.value:"key"::STRING IN ('score','points','moves','steps')
                        THEN COALESCE(f.value:"int_value",
                                      f.value:"double_value")::NUMBER END)                           AS score_like
        FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
             LATERAL FLATTEN(input => t."event_params") f
        WHERE t."event_name" IN ('level_end','level_end_quickplay','level_complete')
        GROUP BY t."event_timestamp"
     ) q
GROUP BY board
LIMIT 20
