FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915"
LIMIT 20;
```

```sql
--Description: 2) Restrict to events that look like quick-play completions and list a few rows  
SELECT *
FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915"
WHERE "event_name" ILIKE '%level_end_quickplay%'
LIMIT 20;
```

```sql
--Description: 3) Peek inside the "event_params" array for the quick-play completions  
SELECT t."event_name",
       f.value
FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
LATERAL FLATTEN(input => t."event_params") f
WHERE t."event_name" ILIKE '%level_end_quickplay%'
LIMIT 20;
```

```sql
--Description: 4) List the distinct parameter keys carried in those quick-play completion events  
SELECT DISTINCT f.value:"key"::STRING AS "param_key"
FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
LATERAL FLATTEN(input => t."event_params") f
WHERE t."event_name" ILIKE '%level_end_quickplay%'
LIMIT 20;
```

```sql
--Description: 5) Inspect the “board” parameter values for a handful of completion events  
SELECT f.value:"string_value"::STRING AS "board_type"
FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
LATERAL FLATTEN(input => t."event_params") f
WHERE t."event_name" ILIKE '%level_end_quickplay%'
  AND f.value:"key"::STRING = 'board'
LIMIT 20;
```

```sql
--Description: 6) Inspect the possible “score” (or similarly named) parameter values  
SELECT f.value:"key"::STRING   AS "param_key",
       COALESCE(f.value:"int_value", f.value:"double_value", f.value:"string_value") AS "raw_val"
FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
LATERAL FLATTEN(input => t."event_params") f
WHERE t."event_name" ILIKE '%level_end_quickplay%'
  AND f.value:"key" ILIKE '%score%'
LIMIT 20;
```

```sql
--Description: 7) Pull each completion together with its board type and score (sample)  
SELECT t."user_pseudo_id",
       max(CASE WHEN f.value:"key"::STRING = 'board'  THEN f.value:"string_value"::STRING END)  AS "board",
       max(CASE WHEN f.value:"key" ILIKE '%score%'   THEN COALESCE(f.value:"int_value", f.value:"double_value")::NUMBER END) AS "score"
FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
LATERAL FLATTEN(input => t."event_params") f
WHERE t."event_name" ILIKE '%level_end_quickplay%'
GROUP BY t."user_pseudo_id"
LIMIT 20;
```

```sql
--Description: 8) Show average score by board type (pre-check, 20 rows max)  
SELECT board,
       AVG(score) AS avg_score
FROM (
    SELECT max(CASE WHEN f.value:"key"::STRING = 'board'  THEN f.value:"string_value"::STRING END)  AS board,
           max(CASE WHEN f.value:"key" ILIKE '%score%'   THEN COALESCE(f.value:"int_value", f.value:"double_value")::NUMBER END) AS score
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
    LATERAL FLATTEN(input => t."event_params") f
    WHERE t."event_name" ILIKE '%level_end_quickplay%'
    GROUP BY t."event_timestamp"
) q
GROUP BY board
LIMIT 20;
```

```sql
--Description: 9) Final query – average score for every board type on 15-Sep-2018 from quick-play completions  
SELECT board,
       ROUND(AVG(score),2) AS average_score
FROM (
    SELECT max(CASE WHEN f.value:"key"::STRING = 'board'  THEN f.value:"string_value"::STRING END)  AS board,
           max(CASE WHEN f.value:"key" ILIKE '%score%'   THEN COALESCE(f.value:"int_value", f.value:"double_value")::NUMBER END) AS score
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
    LATERAL FLATTEN(input => t."event_params") f
    WHERE t."event_name" ILIKE '%level_end_quickplay%'
    GROUP BY t."event_timestamp"
) q
WHERE board IS NOT NULL
GROUP BY board
ORDER BY average_score DESC
LIMIT 20;
```

```sql
--Description: 10) (Optional) Count of completions per board on that day to compare with averages  
SELECT board,
       COUNT(*) AS completions
FROM (
    SELECT max(CASE WHEN f.value:"key"::STRING = 'board'  THEN f.value:"string_value"::STRING END)  AS board
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
    LATERAL FLATTEN(input => t."event_params") f
    WHERE t."event_name" ILIKE '%level_end_quickplay%'
    GROUP BY t."event_timestamp"
) q
WHERE board IS NOT NULL
GROUP BY board
ORDER BY completions DESC
LIMIT 20;
```
