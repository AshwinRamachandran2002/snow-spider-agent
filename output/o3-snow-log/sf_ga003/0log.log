Query:
--Description: 6)  Extract “board” and (any) numeric value that is NOT the firebase_screen_id as a candidate
--            score for every quick-play completion event on 15-Sep-2018.
--            We avoid filtering on “%score%” (which returned no rows) and instead capture the first
--            numeric parameter that is not the technical screen-id.  Results are grouped by each
--            event-timestamp, giving one row per completion event.
SELECT
       MAX( CASE WHEN f.value:"key"::STRING = 'board'
                 THEN f.value:"value":"string_value"::STRING END )                                            AS "board_type",
       MAX( CASE
                 WHEN f.value:"key"::STRING <> 'firebase_screen_id'
                  AND ( f.value:"value":"int_value"  IS NOT NULL
                     OR f.value:"value":"double_value" IS NOT NULL )
                 THEN COALESCE( f.value:"value":"double_value",
                                 f.value:"value":"int_value")::FLOAT
            END )                                                                                             AS "score"
FROM   FIREBASE.ANALYTICS_153293282."EVENTS_20180915"  t,
       LATERAL FLATTEN( INPUT => t."event_params")     f
WHERE  t."event_name" = 'level_end_quickplay'
GROUP  BY t."event_timestamp"
LIMIT 20
