```sql
/* Average SCORE per BOARD for quick-play completions on 15-Sep-2018
   (covers both level_end_quickplay and level_complete_quickplay) */
WITH event_kv AS (
    /* explode every key/value pair inside event_params */
    SELECT
        t."user_pseudo_id",
        t."event_timestamp",
        f.value:"key"::STRING                                            AS param_key,
        f.value                                                          AS param_val
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
         LATERAL FLATTEN(input => t."event_params") f
    WHERE t."event_name" IN ('level_end_quickplay', 'level_complete_quickplay')
),
completions AS (
    /* re-assemble each event so we have BOARD and SCORE on the same row */
    SELECT
        MAX(CASE WHEN param_key = 'board'
                 THEN param_val:"string_value"::STRING
            END)                                                         AS board,
        MAX(CASE WHEN param_key = 'score'
                 THEN COALESCE(param_val:"int_value"::NUMBER,
                              param_val:"double_value"::FLOAT,
                              TRY_TO_NUMBER(param_val:"string_value"::STRING))
            END)                                                         AS score
    FROM event_kv
    GROUP BY "user_pseudo_id", "event_timestamp"
)
SELECT
    board,
    AVG(score) AS avg_score
FROM completions
WHERE board IS NOT NULL
  AND score IS NOT NULL                -- keep only rows where a score was reported
GROUP BY board
ORDER BY avg_score DESC NULLS LAST;
```
