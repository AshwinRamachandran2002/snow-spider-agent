```sql
--Description: Determine which boards (non-blank only) have successful quick-play completions on 15-Sep-2018 and how many times each board was completed.  
--We examine “level_complete_quickplay” events, extract the “board” parameter, exclude empty strings, aggregate, and sort by the completion count.
SELECT
       fb.value:"string_value"::STRING AS "board",
       COUNT(*)                       AS "num_completions"
FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" e,
     LATERAL FLATTEN(input => e."event_params") fb
WHERE e."event_name" = 'level_complete_quickplay'
  AND fb.value:"key"::STRING = 'board'
  AND COALESCE(fb.value:"string_value"::STRING, '') <> ''
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```
