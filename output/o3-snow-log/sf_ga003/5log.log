     ,LATERAL FLATTEN(input => t."event_params") f_board
     ,LATERAL FLATTEN(input => t."event_params") f_score
WHERE t."event_name" ILIKE '%level_end_quickplay%'
  AND f_board.value:"key" = 'board'
  AND f_score.value:"key" ILIKE '%score%'
GROUP BY 1
LIMIT 20;
```

```sql
--Description: 8)  The same average computation, but only for *quick-play* completions that also explicitly include “mode=quickplay” as a parameter (in case multiple modes are mixed).  
SELECT
       f_board.value:"string_value"::STRING     AS "board",
       AVG(f_score.value:"int_value"::NUMBER)   AS "avg_score"
FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915"  t
     ,LATERAL FLATTEN(input => t."event_params") f_board
     ,LATERAL FLATTEN(input => t."event_params") f_score
     ,LATERAL FLATTEN(input => t."event_params") f_mode
WHERE t."event_name" ILIKE '%level_end_quickplay%'
  AND f_board.value:"key" = 'board'
  AND f_score.value:"key" ILIKE '%score%'
  AND f_mode.value:"key"  = 'mode'
  AND f_mode.value:"string_value"::STRING ILIKE '%quickplay%'
GROUP BY 1
LIMIT 20;
```

