```sql
--Description:  Board information lives in “quick-play” events (names containing ‘quickplay’), while
--the numeric “score” is logged in subsequent “post_score” events.  The CTE “board_events” pulls
--every quick-play row that carries a board value; “score_events” pulls every post_score row that
--carries a score.  We join the two sets on the same user and require the score to be recorded
--within 60 seconds (60 × 1 000 000 µs) AFTER the board event, treating that pair as one level
--completion.  Finally, we average the matched scores for each board type to reveal which boards
--were most effective on 15-Sep-2018.
WITH board_events AS (
    SELECT
        t."user_pseudo_id",
        t."event_timestamp"                                         AS board_ts,
        f.value:"value":"string_value"::STRING                      AS board
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
         LATERAL FLATTEN(INPUT => t."event_params") f
    WHERE t."event_name" ILIKE '%quickplay%'
      AND f.value:"key"::STRING = 'board'
),
score_events AS (
    SELECT
        t."user_pseudo_id",
        t."event_timestamp"                                         AS score_ts,
        COALESCE( f.value:"value":"int_value"::NUMBER,
                  TRY_TO_NUMBER(f.value:"value":"string_value"::STRING) ) AS score
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
         LATERAL FLATTEN(INPUT => t."event_params") f
    WHERE t."event_name" = 'post_score'
      AND f.value:"key"::STRING = 'score'
)
SELECT
       b.board,
       AVG(s.score) AS "avg_score"
FROM   board_events b
JOIN   score_events s
  ON   s."user_pseudo_id" = b."user_pseudo_id"
 AND   s.score_ts BETWEEN b.board_ts AND b.board_ts + 60000000    -- within 60 seconds
GROUP  BY b.board
LIMIT 20;
```
