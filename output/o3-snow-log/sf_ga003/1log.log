```sql
--Description: Pivot all event_params on 15-Sep-2018 so each event row reveals its “board” and “score”.
--First, flatten once; then use conditional aggregation to capture board (string) and score
--(numeric or string converted).  Finally, compute the average score for every board type that
--actually appears, giving us the effectiveness measure requested.
SELECT
       board,
       AVG(score) AS avg_score
FROM (
        SELECT
               MAX(CASE WHEN f.value:"key"::STRING = 'board'
                        THEN f.value:"value":"string_value"::STRING END)                                   AS board,
               MAX(CASE WHEN f.value:"key"::STRING = 'score'
                        THEN COALESCE( f.value:"value":"int_value"::NUMBER,
                                       TRY_TO_NUMBER( f.value:"value":"string_value"::STRING ) ) END)      AS score
        FROM   FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
               LATERAL FLATTEN(INPUT => t."event_params") f
        GROUP  BY t."event_timestamp"       -- treat each logged event as a unit
     ) e
WHERE  board IS NOT NULL
  AND  score IS NOT NULL
GROUP BY board
LIMIT 20;
```
