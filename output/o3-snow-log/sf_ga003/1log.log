--Description: 10) Compute the average score per board when the score is stored only as a STRING
--in “post_score” events.  Pair each quick-play “board” event with the first subsequent “post_score”
--event (same user, within 60 seconds); convert the string to NUMBER and then average.
WITH board_events AS (
    SELECT
        t."user_pseudo_id",
        t."event_timestamp"                                       AS board_ts,
        f.value:"value":"string_value"::STRING                    AS board
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
         LATERAL FLATTEN(INPUT => t."event_params") f
    WHERE t."event_name" ILIKE '%quickplay%'
      AND f.value:"key"::STRING = 'board'
),
score_events AS (
    SELECT
        t."user_pseudo_id",
        t."event_timestamp"                                       AS score_ts,
        TRY_TO_NUMBER( f.value:"value":"string_value"::STRING )   AS score_num
    FROM FIREBASE.ANALYTICS_153293282."EVENTS_20180915" t,
         LATERAL FLATTEN(INPUT => t."event_params") f
    WHERE t."event_name" = 'post_score'
      AND f.value:"key"::STRING = 'score'
)
SELECT
       b.board,
       AVG(s.score_num) AS "avg_score"
FROM   board_events b
JOIN   score_events s
  ON   s."user_pseudo_id" = b."user_pseudo_id"
 AND   s.score_ts BETWEEN b.board_ts AND b.board_ts + 60000000    -- within 60 seconds
GROUP  BY b.board
LIMIT 20
