  AND t."trip_distance"   >= 0
  AND t."tip_amount"      >= 0
  AND t."tolls_amount"    >= 0
  AND t."mta_tax"         >= 0
  AND t."fare_amount"     >= 0
  AND t."total_amount"    >= 0
  AND z."borough" NOT IN ('Staten Island','EWR')
