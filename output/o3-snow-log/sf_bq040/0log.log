```sql
--6. Description:  Join a small sample of 1-7 Jan 2016 trips with zone table to see pickup boroughs
SELECT 
  t."pickup_datetime",
  z."borough"            AS "pickup_borough",
  z."zone_name"          AS "pickup_zone",
  t."tip_amount",
  t."total_amount"
FROM NEW_YORK_PLUS.NEW_YORK_TAXI_TRIPS.TLC_YELLOW_TRIPS_2016 t
JOIN NEW_YORK_PLUS.NEW_YORK_TAXI_TRIPS.TAXI_ZONE_GEOM z
     ON z."zone_id" = t."pickup_location_id"
WHERE t."pickup_datetime" BETWEEN 1451606400000000 AND 1452124799000000
LIMIT 20;
```

```sql
--7. Description:  Compute a raw tip rate (%) for a small sample (avoid division by zero with NULLIF)
SELECT 
  t."pickup_datetime",
  z."borough"  AS "pickup_borough",
  ROUND(
    100.0 * t."tip_amount" / NULLIF(t."total_amount" - t."tip_amount", 0)
  , 2)          AS "tip_rate_pct",
  t."total_amount",
  t."tip_amount"
FROM NEW_YORK_PLUS.NEW_YORK_TAXI_TRIPS.TLC_YELLOW_TRIPS_2016 t
JOIN NEW_YORK_PLUS.NEW_YORK_TAXI_TRIPS.TAXI_ZONE_GEOM        z
     ON z."zone_id" = t."pickup_location_id"
WHERE t."pickup_datetime" BETWEEN 1451606400000000 AND 1452124799000000
  AND z."borough" <> 'Staten Island'
  AND z."zone_name" <> 'EWR'
LIMIT 20;
```

```sql
--8. Description:  Categorise each trip into the required tip buckets (sample rows shown)
SELECT 
  z."borough" AS "pickup_borough",
  CASE
    WHEN t."tip_amount" = 0                                         THEN 'no tip'
    WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <= 5  THEN 'Less than 5%'
    WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <=10 THEN '5% to 10%'
    WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <=15 THEN '10% to 15%'
    WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <=20 THEN '15% to 20%'
    WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <=25 THEN '20% to 25%'
    ELSE                                                                 'More than 25%'
  END AS "tip_bucket"
FROM NEW_YORK_PLUS.NEW_YORK_TAXI_TRIPS.TLC_YELLOW_TRIPS_2016 t
JOIN NEW_YORK_PLUS.NEW_YORK_TAXI_TRIPS.TAXI_ZONE_GEOM z
     ON z."zone_id" = t."pickup_location_id"
WHERE t."pickup_datetime" BETWEEN 1451606400000000 AND 1452124799000000
  AND t."dropoff_datetime" > t."pickup_datetime"
  AND t."passenger_count" > 0
  AND t."trip_distance"   >= 0
  AND t."tip_amount"      >= 0
  AND t."tolls_amount"    >= 0
  AND t."mta_tax"         >= 0
  AND t."fare_amount"     >= 0
  AND t."total_amount"    >= 0
  AND z."borough" <> 'Staten Island'
  AND z."zone_name" <> 'EWR'
LIMIT 20;
```

```sql
--9. Description:  Aggregate counts of trips per borough & tip bucket for 1-7 Jan 2016 under all filters
SELECT 
  z."borough"                                                    AS "pickup_borough",
  CASE
    WHEN t."tip_amount" = 0                                         THEN 'no tip'
    WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <= 5  THEN 'Less than 5%'
    WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <=10 THEN '5% to 10%'
    WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <=15 THEN '10% to 15%'
    WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <=20 THEN '15% to 20%'
    WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <=25 THEN '20% to 25%'
    ELSE                                                                 'More than 25%'
  END                                                             AS "tip_bucket",
  COUNT(*)                                                        AS "trip_count"
FROM NEW_YORK_PLUS.NEW_YORK_TAXI_TRIPS.TLC_YELLOW_TRIPS_2016 t
JOIN NEW_YORK_PLUS.NEW_YORK_TAXI_TRIPS.TAXI_ZONE_GEOM          z
     ON z."zone_id" = t."pickup_location_id"
WHERE t."pickup_datetime" BETWEEN 1451606400000000 AND 1452124799000000
  AND t."dropoff_datetime" > t."pickup_datetime"
  AND t."passenger_count" > 0
  AND t."trip_distance"   >= 0
  AND t."tip_amount"      >= 0
  AND t."tolls_amount"    >= 0
  AND t."mta_tax"         >= 0
  AND t."fare_amount"     >= 0
  AND t."total_amount"    >= 0
  AND z."borough" <> 'Staten Island'
  AND z."zone_name" <> 'EWR'
GROUP BY 1,2
LIMIT 20;
```

```sql
--10. Description:  Final query – calculate the proportion of trips within each tip bucket by pickup borough
SELECT
  "pickup_borough",
  "tip_bucket",
  ROUND(100.0 * "trip_count" / SUM("trip_count") OVER (PARTITION BY "pickup_borough"), 2) 
      AS "pct_of_trips"
FROM (
  SELECT 
    z."borough"                                                    AS "pickup_borough",
    CASE
      WHEN t."tip_amount" = 0                                         THEN 'no tip'
      WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <= 5  THEN 'Less than 5%'
      WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <=10 THEN '5% to 10%'
      WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <=15 THEN '10% to 15%'
      WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <=20 THEN '15% to 20%'
      WHEN 100*t."tip_amount"/NULLIF(t."total_amount"-t."tip_amount",0) <=25 THEN '20% to 25%'
      ELSE                                                                 'More than 25%'
    END                                                             AS "tip_bucket",
    COUNT(*)                                                        AS "trip_count"
  FROM NEW_YORK_PLUS.NEW_YORK_TAXI_TRIPS.TLC_YELLOW_TRIPS_2016 t
  JOIN NEW_YORK_PLUS.NEW_YORK_TAXI_TRIPS.TAXI_ZONE_GEOM          z
       ON z."zone_id" = t."pickup_location_id"
  WHERE t."pickup_datetime" BETWEEN 1451606400000000 AND 1452124799000000
    AND t."dropoff_datetime" > t."pickup_datetime"
    AND t."passenger_count" > 0
    AND t."trip_distance"   >= 0
    AND t."tip_amount"      >= 0
    AND t."tolls_amount"    >= 0
    AND t."mta_tax"         >= 0
    AND t."fare_amount"     >= 0
    AND t."total_amount"    >= 0
    AND z."borough" <> 'Staten Island'
    AND z."zone_name" <> 'EWR'
  GROUP BY 1,2
) sub
ORDER BY "pickup_borough", "tip_bucket"
LIMIT 20;
```
