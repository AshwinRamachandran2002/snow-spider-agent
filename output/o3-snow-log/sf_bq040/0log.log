[{'trip_id': 'BSP19GEN-FS012-Sunday-00_000000_FS.S01R', 'arrival_time': '00:00:00', 'departure_time': '00:00:00', 'stop_id': 'S01S', 'stop_sequence': '1', 'stop_headsign': None, 'pickup_type': '0', 'dropoff_type': '0', 'shape_dist_traveled': None}, {'trip_id': 'BSP19GEN-FS011-Weekday-00_000000_FS.S01R', 'arrival_time': '00:00:00', 'departure_time': '00:00:00', 'stop_id': 'S01S', 'stop_sequence': '1', 'stop_headsign': None, 'pickup_type': '0', 'dropoff_type': '0', 'shape_dist_traveled': None}, {'trip_id': 'BSP19GEN-M086-Weekday-00_000000_M..S30R', 'arrival_time': '00:00:00', 'departure_time': '00:00:00', 'stop_id': 'M11S', 'stop_sequence': '1', 'stop_headsign': None, 'pickup_type': '0', 'dropoff_type': '0', 'shape_dist_traveled': None}, {'trip_id': 'BSP19SUPP-L022-Saturday-99_000100_L..N01X006', 'arrival_time': '00:01:00', 'departure_time': '00:01:00', 'stop_id': 'L29N', 'stop_sequence': '1', 'stop_headsign': None, 'pickup_type': '0', 'dropoff_type': '0', 'shape_dist_traveled': None}, {'trip_id': 'BSP19SUPP-L022-Sunday-99_000100_L..N01X004', 'arrival_time': '00:01:00', 'departure_time': '00:01:00', 'stop_id': 'L29N', 'stop_sequence': '1', 'stop_headsign': None, 'pickup_type': '0', 'dropoff_type': '0', 'shape_dist_traveled': None}]
