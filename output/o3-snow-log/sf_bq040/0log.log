  z."borough" AS "pickup_borough",
  ROUND(
    100.0 * t."tip_amount"
    / NULLIF(t."total_amount" - t."tip_amount", 0)
  , 2)        AS "tip_rate_pct",
  t."total_amount",
  t."tip_amount"
