```sql
--Description / Thinking process:
-- Produce the GloVe vector for the word ‘cell’, scaled element-wise by
-- 1 / (frequency^0.4), and reassembled in the original order.
-- 1) Join GLOVE_VECTORS (g) with WORD_FREQUENCIES (w) to obtain both the
--    raw vector and its corpus frequency.
-- 2) FLATTEN the vector (gv) so each row contains one component (gv.value)
--    together with its position (gv.index).
-- 3) Divide each component by POWER(w.frequency, 0.4) to apply the weight.
-- 4) Use ARRAY_AGG … WITHIN GROUP (ORDER BY gv.index) to reconstruct an
--    ordered array of the weighted components.
-- 5) COUNT(*) confirms the dimensionality of the vector.
SELECT
    g."word",
    COUNT(*)                                                           AS "vec_length",
    ARRAY_AGG(
        (gv.value::FLOAT) / POWER(w."frequency", 0.4)
    ) WITHIN GROUP (ORDER BY gv.index)                                 AS "weighted_vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    g
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES w
