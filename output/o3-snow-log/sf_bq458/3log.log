```sql
--Description / Thinking process:
-- Build a weighted-sum article vector for one article (id fixed).
-- Steps:
-- 1) Tokenise the article “body” (split on spaces, lowercase).
-- 2) Keep tokens that appear in both WORD_FREQUENCIES (for counts) and
--    GLOVE_VECTORS (for  d-dimensional vectors).
-- 3) Flatten each token’s GloVe vector into (index, value) pairs.
-- 4) Weight each value by 1 / frequency^0.4.
-- 5) Sum weighted values for every dimension across all tokens.
-- 6) Re-assemble the d summed components (ordered by index) into one array.
WITH token_dims AS (
    SELECT
        t."id",
        gv.index               AS dim,
        SUM( (gv.value::FLOAT) / POWER(w."frequency", 0.4) ) AS dim_value
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE              t
         ,LATERAL FLATTEN(input => SPLIT(LOWER(t."body"), ' ')) tok
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES    w
          ON tok.value::STRING = w."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS       g
          ON tok.value::STRING = g."word"
         ,LATERAL FLATTEN(input => g."vector")               gv
    WHERE t."id" = '95db4daa-a9f6-4eda-8ce3-c6045d75320f'
    GROUP BY t."id", gv.index
)
SELECT
    "id",
    ARRAY_AGG(dim_value ORDER BY dim) AS "article_vector_raw"
FROM token_dims
GROUP BY "id"
LIMIT 20;
```
