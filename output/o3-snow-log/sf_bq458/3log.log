```sql
--Description: 9) Show how one might scale a single word’s GloVe vector by that weight.
SELECT
  g."word",
  ARRAY_SIZE(g."vector") AS "vec_len",
  (SELECT ARRAY_AGG( (g2.value::FLOAT) / POWER(w."frequency", 0.4) )
     FROM TABLE(FLATTEN(input => g."vector")) g2 ) AS "weighted_vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES w
  ON g."word" = w."word"
WHERE g."word" = 'cell'
LIMIT 20;
```

```sql
--Description: 10) Illustrative skeleton for aggregating weighted word vectors
--   for one article (uses tokenisation; still limited to 20 tokens for demo).
SELECT
  t."id",
  ARRAY_AGG( (gv_flat.value::FLOAT)
/ POWER(w."frequency", 0.4) ) AS "article_vector_raw"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE t,
LATERAL FLATTEN(input => SPLIT(LOWER(t."body"), ' ')) tok,
WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES w,
WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv,
LATERAL FLATTEN(input => gv."vector") gv_flat
WHERE t."id" = 'YOUR_SAMPLE_ID_HERE'
  AND tok.value::STRING = w."word"
  AND tok.value::STRING = gv."word"
GROUP BY t."id"
LIMIT 20;
```

