```sql
--Description: 7) Join WORD_FREQUENCIES and GLOVE_VECTORS for a couple of chosen tokens.
SELECT
  w."word",
  w."frequency",
  g."vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES w
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
  ON w."word" = g."word"
WHERE w."word" IN ('cell', 'culture', 'toxicity')
LIMIT 20;
