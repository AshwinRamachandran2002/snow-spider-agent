```sql
--Description: Build the weighted-sum word-vector representation for one
--             article (id = 95db4daa-a9f6-4eda-8ce3-c6045d75320f), then
--             reassemble the summed components into a single ordered array.
-- Logic:
--   1) Tokenise the article body (lower-case, split on spaces).
--   2) Keep tokens that have BOTH a frequency row and a GloVe vector.
--   3) Flatten each token’s GloVe vector into (index, value) pairs.
--   4) Weight each value by 1 / (frequency^0.4) and SUM across all tokens
--      for each dimension.
--   5) ARRAY_AGG the per-dimension sums back into their original order
--      to produce the raw (unnormalised) article vector.
WITH per_dim AS (
    SELECT
        t."id",
        gv.index                                                  AS dim,
        SUM( (gv.value::FLOAT) / POWER(w."frequency", 0.4) )      AS dim_value
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE              t
         ,LATERAL FLATTEN(input => SPLIT(LOWER(t."body"), ' ')) tok
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES    w
          ON tok.value::STRING = w."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS       g
          ON tok.value::STRING = g."word"
         ,LATERAL FLATTEN(input => g."vector")               gv
    WHERE t."id" = '95db4daa-a9f6-4eda-8ce3-c6045d75320f'
    GROUP BY t."id", gv.index
)
SELECT
    "id",
    ARRAY_AGG(dim_value) WITHIN GROUP (ORDER BY dim) AS "article_vector_raw"
FROM per_dim
GROUP BY "id"
LIMIT 20;
```
