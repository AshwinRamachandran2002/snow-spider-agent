/* -----------------------------------------------------------
   Build a length-normalised GloVe article-vector for every
   Nature paper, after removing a small set of English stop-
   words and applying the frequency-0.4 weighting scheme.
-----------------------------------------------------------*/
WITH
/* 1) A minimal stop-word list */
stop_words(word) AS (
    SELECT column1 FROM VALUES
      ('the'),('of'),('and'),('in'),('to'),('a'),('is'),('it'),('for'),('on'),
      ('that'),('with'),('as'),('was'),('were'),('be'),('by'),('are'),('an'),
      ('at'),('from'),('this'),('or'),('which'),('have'),('has'),('had'),
      ('but'),('not'),('we'),('they'),('their'),('its'),('he'),('she'),
      ('his'),('her'),('them'),('also'),('may'),('can'),('will'),('would'),
      ('should'),('could'),('about')
),

/* 2) Tokenise every article body, lower-case and strip
       non-alphabetic characters */
article_tokens AS (
    SELECT
        n.id,
        REGEXP_REPLACE(LOWER(tok.value::STRING), '[^a-z]+', '') AS token
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN( INPUT => SPLIT(n.body, ' ') ) tok
),

/* 3) Keep non-empty tokens that are NOT stop-words */
filtered_tokens AS (
    SELECT id, token
    FROM   article_tokens t
    WHERE  token <> ''
      AND NOT EXISTS ( SELECT 1 FROM stop_words s WHERE s.word = t.token )
),

/* 4) Expand each kept token into its weighted GloVe values  */
token_vectors AS (
    SELECT
        ft.id,
        gv.index                                        AS dim,
        gv.value::FLOAT / POWER(w.frequency, 0.4)       AS weighted_val
    FROM filtered_tokens                                        ft
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES w
         ON ft.token = w.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  g
         ON ft.token = g.word,
         LATERAL FLATTEN( INPUT => g.vector )           gv
),

/* 5) Sum the weighted contributions per article & dimension */
article_dim_sum AS (
    SELECT id,
           dim,
           SUM(weighted_val) AS dim_val
    FROM   token_vectors
    GROUP  BY id, dim
),

/* 6) Compute the Euclidean norm of every raw article vector */
article_norms AS (
    SELECT id,
           SQRT( SUM(dim_val * dim_val) ) AS norm
    FROM   article_dim_sum
    GROUP  BY id
),

/* 7) Normalise each dimension by its article’s vector length */
article_dim_norm AS (
    SELECT
        s.id,
        s.dim,
        CASE WHEN n.norm = 0 THEN 0
             ELSE s.dim_val / n.norm
        END AS norm_val
    FROM article_dim_sum  s
    JOIN article_norms    n
      ON s.id = n.id
)

/* 8) Assemble the ordered, length-1 vector for every article */
SELECT
    nat.id,
    nat.date,
    nat.title,
    ARRAY_AGG(adn.norm_val ORDER BY adn.dim) AS article_vector
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE nat
LEFT JOIN article_dim_norm  adn
       ON nat.id = adn.id
GROUP BY nat.id, nat.date, nat.title
;
```
