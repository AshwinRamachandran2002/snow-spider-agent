  w."word",
  w."frequency",
  POWER(w."frequency", 0.4) AS "freq_pow_04"
FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES w
WHERE w."word" IN ('cell', 'culture', 'toxicity')
LIMIT 20;
