```sql
/* -----------------------------------------------------------------
   For every Nature article build a normalised article-level vector
   1. Tokenise body → words, strip punctuation, lower-case
   2. Drop empty tokens and simple stop-words
   3. Join to WORD_FREQUENCIES       (gives “frequency”)
      and  GLOVE_VECTORS             (gives  “vector”  ARRAY / VARIANT)
   4. Weight each word vector by 1/(frequency^0.4)
   5. Sum the weighted vectors -> article vector
   6. Normalise to unit length
   7. Return id , date , title , normalised article vector
   ----------------------------------------------------------------- */
WITH
/* --- 1.  tokenise body text ------------------------------------ */
raw_words AS (
    SELECT
        n."id",
        n."date",
        n."title",
        TRIM(w.value::STRING)            AS word
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE   n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                 LOWER(
                     REGEXP_REPLACE(n."body",'[^A-Za-z ]',' ')
                 ),
                 ' '
             )
         ) w
),
/* --- 2.  remove empty tokens & stop-words ---------------------- */
filtered_words AS (
    SELECT *
    FROM raw_words
    WHERE word <> ''
      AND word NOT IN (
          'a','after','also','an','and','are','as','at','be','before','between',
          'both','but','by','can','data','during','eight','et','fig','figure',
          'five','for','four','from','had','have','has','i','ii','iii','iv','ix',
          'is','it','its','iv','ix','more','most','n','nine','not','of','on',
          'one','or','our','over','results','seven','show','shows','shown',
          'similar','six','study','such','ten','than','that','the','their',
          'these','they','this','three','to','two','use','used','using','v',
          'vi','vii','viii','we','were','was','with'
      )
),
/* --- 3.  join to frequency table and glove vectors ------------- */
word_vectors AS (
    SELECT
        fw."id",
        fw."date",
        fw."title",
        gv."vector"              AS glove_vec,
        wf."frequency"           AS freq
    FROM filtered_words          fw
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  wf
          ON wf."word" = fw.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS     gv
          ON gv."word" = fw.word
),
/* --- 4.  weight each word-dimension & explode ------------------ */
weighted_components AS (
    SELECT
        id,
        date,
        title,
        vec.index                         AS idx,                    -- dimension #
        vec.value::FLOAT / POWER(freq,0.4) AS comp                    -- weighted value
    FROM word_vectors,
         LATERAL FLATTEN(INPUT => glove_vec) vec
),
/* --- 5.  sum components per article  --------------------------- */
article_components AS (
    SELECT
        id,
        date,
        title,
        idx,
        SUM(comp) AS component
    FROM weighted_components
    GROUP BY id, date, title, idx
),
/* --- 6.  build array + calculate norm -------------------------- */
article_vectors AS (
    SELECT
        id,
        date,
        title,
        ARRAY_AGG(component ORDER BY idx)                         AS vec,
        SQRT(SUM(POWER(component,2)))                              AS norm
    FROM article_components
    GROUP BY id, date, title
)
/* --- 7.  output normalised vector ------------------------------ */
SELECT
    id,
    date,
    title,
    ARRAY_TRANSFORM(vec, x -> x / NULLIF(norm,0)) AS normalised_article_vector
FROM article_vectors;
```
