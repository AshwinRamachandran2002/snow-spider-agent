```sql
--Description: Look at the most frequent words in WORD_FREQUENCIES (highest “frequency” first).
SELECT 
  "word",
  "frequency"
FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES
ORDER BY "frequency" DESC
LIMIT 20;
```

```sql
--Description: Count how many distinct words are stored in WORD_FREQUENCIES.
SELECT 
  COUNT(DISTINCT "word") AS "distinct_word_count"
FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES;
```

```sql
--Description: Sample a few GloVe vectors (word + first 150 characters of the vector).
SELECT 
  "word",
  LEFT("vector"::STRING, 150) AS "vector_preview"
FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS
LIMIT 20;
```

```sql
--Description: Find words that occur exactly 256 times and have GloVe vectors.
SELECT 
  f."word",
  f."frequency",
  g."vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES AS f
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  AS g
  ON f."word" = g."word"
WHERE f."frequency" = 256
LIMIT 20;
```

```sql
