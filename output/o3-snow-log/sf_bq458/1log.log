/* -----------------------------------------------------------------
   Build a normalised article-level vector for every Nature article
   ----------------------------------------------------------------- */
WITH
/* 1. Tokenise body text -------------------------------------------------- */
raw_words AS (
    SELECT
        n."id",
        n."date",
        n."title",
        TRIM(w.value::STRING) AS word
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                 LOWER(
                     REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' ')
                 ),
                 ' '
             )
         ) w
),
/* 2. Remove empty tokens & common stop-words ----------------------------- */
filtered_words AS (
    SELECT *
    FROM raw_words
    WHERE word <> ''
      AND word NOT IN (
          'a','after','also','an','and','are','as','at','be','before','between',
          'both','but','by','can','data','during','eight','et','fig','figure',
          'five','for','four','from','had','have','has','i','ii','iii','iv','ix',
          'is','it','its','more','most','n','nine','not','of','on','one','or',
          'our','over','results','seven','show','shows','shown','similar','six',
          'study','such','ten','than','that','the','their','these','they',
          'this','three','to','two','use','used','using','v','vi','vii','viii',
          'we','were','was','with'
      )
),
/* 3. Join to frequency table and GloVe vectors --------------------------- */
word_vectors AS (
    SELECT
        fw."id",
        fw."date",
        fw."title",
        gv."vector"     AS glove_vec,
        wf."frequency"  AS freq
    FROM filtered_words                                   fw
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON wf."word" = fw.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    gv
         ON gv."word" = fw.word
),
/* 4. Weight each vector component --------------------------------------- */
weighted_components AS (
    SELECT
        id,
        date,
        title,
        vec.index                             AS idx,
        vec.value::FLOAT / POWER(freq, 0.4)   AS comp
    FROM word_vectors,
         LATERAL FLATTEN(INPUT => glove_vec) vec
),
/* 5. Sum components per article ----------------------------------------- */
article_components AS (
    SELECT
        id,
        date,
        title,
        idx,
        SUM(comp) AS component
    FROM weighted_components
    GROUP BY id, date, title, idx
),
/* 6. Assemble vector & compute its norm --------------------------------- */
article_vectors AS (
    SELECT
        id,
        date,
        title,
        ARRAY_AGG(component) WITHIN GROUP (ORDER BY idx::INT)  AS vec,
        SQRT(SUM(POWER(component, 2)))                         AS norm
    FROM article_components
    GROUP BY id, date, title
)
/* 7. Output normalised article vector ----------------------------------- */
SELECT
    id,
    date,
    title,
    ARRAY_TRANSFORM(vec, x -> x / NULLIF(norm, 0)) AS normalised_article_vector
FROM article_vectors;
