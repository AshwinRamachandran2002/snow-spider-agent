```

```sql
--Description: Retrieve articles whose category roughly matches “Cell culture” (fuzzy match).
SELECT 
  "id",
  "date",
  "title",
  "category"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "category" ILIKE '%cell%culture%'
