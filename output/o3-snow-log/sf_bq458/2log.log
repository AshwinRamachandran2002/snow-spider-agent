```sql
--Description: Tokenise one article’s body into lower-case words (very raw split on space) for later joining.
SELECT 
  n."id",
  f.value::STRING AS "word"
FROM WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n,
     LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) f
WHERE n."id" = '10.1038/s41598-018-28648-8'   -- sample article
LIMIT 20;
```

```sql
--Description: Filter the tokenised words to remove a few stop-words and attach their frequency & vector.
SELECT 
  tok."id",
  tok."word",
  wf."frequency",
  gv."vector"
FROM (
    SELECT 
      n."id",
      f.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n,
         LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) f
    WHERE n."id" = '10.1038/s41598-018-28648-8'
) tok
JOIN WORD_VECTORS_US.WORD_VECTORS_US."WORD_FREQUENCIES" wf
     ON tok."word" = wf."word"
JOIN WORD_VECTORS_US.WORD_VECTORS_US."GLOVE_VECTORS" gv
     ON tok."word" = gv."word"
WHERE tok."word" NOT IN ('the','and','of','to','a')          -- very small stop-word sample
LIMIT 20;
```

```sql
--Description: Produce a frequency-weighted vector for each retained word from the sample article.
SELECT 
  tok."id",
  tok."word",
  ARRAY_AGG(  vec_flat.value::FLOAT / POWER(wf."frequency", 0.4) 
              ORDER BY vec_flat.index ) AS "weighted_vector"
FROM (
    SELECT 
      n."id",
      f.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n,
         LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) f
    WHERE n."id" = '10.1038/s41598-018-28648-8'
) tok
JOIN WORD_VECTORS_US.WORD_VECTORS_US."WORD_FREQUENCIES" wf
     ON tok."word" = wf."word"
JOIN WORD_VECTORS_US.WORD_VECTORS_US."GLOVE_VECTORS" gv
     ON tok."word" = gv."word",
LATERAL FLATTEN( INPUT => gv."vector" ) vec_flat
WHERE tok."word" NOT IN ('the','and','of','to','a')
GROUP BY tok."id", tok."word", wf."frequency"
LIMIT 20;
```

```sql
--Description: Aggregate the weighted vectors across all words to form (unnormalised) article vector, then normalise.
WITH tokenised AS (
    SELECT n."id",
           n."date",
           n."title",
           f.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n,
         LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) f
),
enriched AS (
    SELECT t."id",
           t."date",
           t."title",
           gv."vector" AS "vec",
           POWER(wf."frequency", 0.4) AS "freq_pow"
    FROM tokenised t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US."WORD_FREQUENCIES" wf
         ON t."word" = wf."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US."GLOVE_VECTORS" gv
         ON t."word" = gv."word"
    WHERE t."word" NOT IN ('the','and','of','to','a')
),
weighted AS (
    SELECT 
      e."id",
      e."date",
      e."title",
      ARRAY_AGG( vec_flat.value::FLOAT / e."freq_pow"
                 ORDER BY vec_flat.index ) AS "weighted_vec"
    FROM enriched e,
         LATERAL FLATTEN( INPUT => e."vec" ) vec_flat
    GROUP BY e."id", e."date", e."title"
),
aggregated AS (
    SELECT 
      "id",
      "date",
      "title",
      ARRAY_AGG( wv_flat.value::FLOAT ) AS "article_vec"
    FROM weighted,
         LATERAL FLATTEN( INPUT => "weighted_vec" ) wv_flat
    GROUP BY "id", "date", "title"
),
normalised AS (
    SELECT
      "id",
      "date",
      "title",
      -- compute vector magnitude
      SQRT( SUM( POWER(av_flat.value::FLOAT, 2) ) ) AS "norm",
      ARRAY_AGG(av_flat.value::FLOAT ORDER BY av_flat.index) AS "vec_raw"
    FROM aggregated,
         LATERAL FLATTEN( INPUT => "article_vec" ) av_flat
    GROUP BY "id", "date", "title"
)
SELECT
  "id",
  "date",
  "title",
  ARRAY_AGG( vr_flat.value::FLOAT / n."norm" ORDER BY vr_flat.index ) AS "normalised_article_vector"
FROM normalised n,
     LATERAL FLATTEN( INPUT => n."vec_raw" ) vr_flat
GROUP BY "id", "date", "title"
LIMIT 20;
```
