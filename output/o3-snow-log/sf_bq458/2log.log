Query:
--Description:
-- Corrected version of “Build the full weighted-sum article vector …” query.
-- Key fix: use  ARRAY_AGG( … ) WITHIN GROUP (ORDER BY …) for ordered aggregation.
WITH tokenised AS (
    SELECT
        n."id",
        n."date",
        n."title",
        f.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n,
         LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) f
    WHERE n."id" = '95db4daa-a9f6-4eda-8ce3-c6045d75320f'
),
enriched AS (
    SELECT
        t."id",
        t."date",
        t."title",
        vec_flat.index                      AS idx,
        vec_flat.value::FLOAT / POWER(wf."frequency", 0.4) AS weighted_comp
    FROM tokenised t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US."WORD_FREQUENCIES" wf
      ON t."word" = wf."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US."GLOVE_VECTORS" gv
      ON t."word" = gv."word",
    LATERAL FLATTEN( INPUT => gv."vector" ) vec_flat
    WHERE t."word" NOT IN ('the','and','of','to','a')
),
summed AS (
    SELECT
        "id",
        "date",
        "title",
        idx,
        SUM(weighted_comp) AS comp_sum
    FROM enriched
    GROUP BY "id", "date", "title", idx
),
magnitudes AS (
    SELECT
        "id",
        SQRT( SUM( comp_sum * comp_sum ) ) AS mag
    FROM summed
    GROUP BY "id"
)
SELECT
    s."id",
    s."date",
    s."title",
    ARRAY_AGG( s.comp_sum / m.mag ) WITHIN GROUP (ORDER BY s.idx) AS normalised_article_vector
FROM summed s
JOIN magnitudes m
  ON s."id" = m."id"
GROUP BY s."id", s."date", s."title"
LIMIT 20
