```sql
/* ------------------------------------------------------------
   Build a normalised article-level vector for every Nature entry
---------------------------------------------------------------*/
WITH tokenised AS (         -- 1. Split body text into lower-cased tokens
    SELECT
        n."id",
        n."date",
        n."title",
        TRIM(f.value)::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                 REGEXP_REPLACE( LOWER(n."body"), '[^a-z0-9 ]', ' ' ),   -- drop punctuation
                 ' '
             )
         ) f
    WHERE TRIM(f.value) <> ''                                       -- discard blanks
      AND TRIM(f.value) NOT IN (                                    -- simple stop-word list
            'the','and','of','to','a','in','is','on','for','with',
            'as','by','an','at','be','this','that','it','from'
      )
),
enriched AS (           -- 2. Attach frequency & glove vector, weight each component
    SELECT
        t."id",
        t."date",
        t."title",
        v.index                                                AS idx,          -- component position
        v.value::FLOAT / POWER(wf."frequency", 0.4)            AS weighted_comp
    FROM tokenised t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US."WORD_FREQUENCIES" wf
         ON t."word" = wf."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US."GLOVE_VECTORS" gv
         ON t."word" = gv."word",
    LATERAL FLATTEN( INPUT => gv."vector" ) v
),
summed AS (             -- 3. Sum weighted components per article
    SELECT
        "id",
        "date",
        "title",
        idx,
        SUM(weighted_comp) AS comp_sum
    FROM enriched
    GROUP BY "id", "date", "title", idx
),
magnitudes AS (         -- 4. Magnitude of each article vector
    SELECT
        "id",
        SQRT( SUM( comp_sum * comp_sum ) ) AS mag
    FROM summed
    GROUP BY "id"
)
-- 5. Normalise & return final vectors
SELECT
    s."id",
    s."date",
    s."title",
    ARRAY_AGG( s.comp_sum / m.mag ) WITHIN GROUP (ORDER BY s.idx)  AS "normalised_article_vector"
FROM summed        s
JOIN magnitudes    m   ON s."id" = m."id"
GROUP BY s."id", s."date", s."title";
```
