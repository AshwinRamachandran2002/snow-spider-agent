```sql
--Description:
-- Build the complete, normalised article vector for the specific Nature paper
--   (id = 95db4daa-a9f6-4eda-8ce3-c6045d75320f).
-- Steps
--   1. Tokenise the body text into lower-case words.
--   2. Remove a tiny stop-word list.
--   3. Join each token to its corpus frequency and 300-dimensional GloVe vector.
--   4. Weight every vector component by dividing by frequency^0.4.
--   5. Sum the weighted components across all tokens, per dimension, to form the raw article vector.
--   6. Compute its magnitude and normalise each component.
--   7. Re-assemble the ordered components into an array to return alongside id, date and title.
WITH tokenised AS (
    SELECT
        n."id",
        n."date",
        n."title",
        f.value::STRING AS word
    FROM WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n,
         LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) f
    WHERE n."id" = '95db4daa-a9f6-4eda-8ce3-c6045d75320f'
),
enriched AS (
    SELECT
        t."id",
        t."date",
        t."title",
        vec_flat.index                                     AS dim,
        vec_flat.value::FLOAT / POWER(wf."frequency", 0.4) AS weighted_component
    FROM tokenised t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US."WORD_FREQUENCIES" wf
      ON t.word = wf."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US."GLOVE_VECTORS" gv
      ON t.word = gv."word",
    LATERAL FLATTEN( INPUT => gv."vector" ) vec_flat
    WHERE t.word NOT IN ('the','and','of','to','a')
),
summed AS (
    SELECT
        "id",
        "date",
        "title",
        dim,
        SUM(weighted_component) AS comp_sum
    FROM enriched
    GROUP BY "id", "date", "title", dim
),
norms AS (
    SELECT
        "id",
        SQRT( SUM( comp_sum * comp_sum ) ) AS mag
    FROM summed
    GROUP BY "id"
)
SELECT
    s."id",
    s."date",
    s."title",
    ARRAY_AGG( s.comp_sum / n.mag ) WITHIN GROUP (ORDER BY s.dim) AS normalised_article_vector
FROM summed s
JOIN norms n
  ON s."id" = n."id"
GROUP BY s."id", s."date", s."title"
LIMIT 20;
```
