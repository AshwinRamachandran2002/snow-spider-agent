```sql
--Description: Filter the tokenised words from the chosen article (ID = 95db4daa-a9f6-4eda-8ce3-c6045d75320f), drop a small stop-word list, then join to frequency and GloVe tables so each remaining token carries its corpus frequency and vector.
SELECT
  tok."id",
  tok."word",
  wf."frequency",
  gv."vector"
FROM (
    SELECT
      n."id",
      f.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n,
         LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) f
    WHERE n."id" = '95db4daa-a9f6-4eda-8ce3-c6045d75320f'
) tok
JOIN WORD_VECTORS_US.WORD_VECTORS_US."WORD_FREQUENCIES" wf
     ON tok."word" = wf."word"
JOIN WORD_VECTORS_US.WORD_VECTORS_US."GLOVE_VECTORS" gv
     ON tok."word" = gv."word"
WHERE tok."word" NOT IN ('the','and','of','to','a')
LIMIT 20;
```

```sql
--Description: For every retained token in the same article, divide each vector component by frequency^0.4 to create a weighted vector; show the first 20 (token, weighted-vector) pairs.
SELECT
  tok."id",
  tok."word",
  ARRAY_AGG( vec_flat.value::FLOAT / POWER(wf."frequency", 0.4)
             ORDER BY vec_flat.index ) AS "weighted_vector"
FROM (
    SELECT
      n."id",
      f.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n,
         LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) f
    WHERE n."id" = '95db4daa-a9f6-4eda-8ce3-c6045d75320f'
) tok
JOIN WORD_VECTORS_US.WORD_VECTORS_US."WORD_FREQUENCIES" wf
     ON tok."word" = wf."word"
JOIN WORD_VECTORS_US.WORD_VECTORS_US."GLOVE_VECTORS" gv
     ON tok."word" = gv."word",
LATERAL FLATTEN( INPUT => gv."vector" ) vec_flat
WHERE tok."word" NOT IN ('the','and','of','to','a')
GROUP BY tok."id", tok."word", wf."frequency"
LIMIT 20;
```

```sql
--Description: Build the full weighted-sum article vector for the same paper, normalise it to unit length and return ID, date, title and the normalised vector.
WITH tokenised AS (
    SELECT n."id",
           n."date",
           n."title",
           f.value::STRING AS "word"
    FROM WORD_VECTORS_US.WORD_VECTORS_US."NATURE" n,
         LATERAL FLATTEN( INPUT => SPLIT( LOWER(n."body"), ' ' ) ) f
    WHERE n."id" = '95db4daa-a9f6-4eda-8ce3-c6045d75320f'
),
enriched AS (
    SELECT t."id",
           t."date",
           t."title",
           gv."vector"                       AS "vec",
           POWER(wf."frequency", 0.4)        AS "freq_pow"
    FROM tokenised t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US."WORD_FREQUENCIES" wf
         ON t."word" = wf."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US."GLOVE_VECTORS" gv
         ON t."word" = gv."word"
    WHERE t."word" NOT IN ('the','and','of','to','a')
),
components AS (
    SELECT
      e."id",
      e."date",
      e."title",
      vec_flat.index                      AS "idx",
      SUM( vec_flat.value::FLOAT / e."freq_pow" ) AS "comp_sum"
    FROM enriched e,
         LATERAL FLATTEN( INPUT => e."vec" ) vec_flat
    GROUP BY e."id", e."date", e."title", vec_flat.index
),
magnitudes AS (
    SELECT
      "id",
      SQRT( SUM( POWER( "comp_sum", 2 ) ) ) AS "mag"
    FROM components
    GROUP BY "id"
)
SELECT
  c."id",
  c."date",
  c."title",
  ARRAY_AGG( c."comp_sum" / m."mag" ORDER BY c."idx" ) AS "normalised_article_vector"
FROM components c
JOIN magnitudes m
  ON c."id" = m."id"
GROUP BY c."id", c."date", c."title"
LIMIT 20;
```
