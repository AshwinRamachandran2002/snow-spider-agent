```sql
WITH cleaned AS (   -- 1. keep only letters, make lower–case
    SELECT
        n."id",
        n."date",
        n."title",
        LOWER( REGEXP_REPLACE ( n."body" , '[^A-Za-z]+' , ' ' ) ) AS body_clean
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
    WHERE n."body" IS NOT NULL
), tokens AS (       -- 2. split into individual words
    SELECT
        c."id",
        c."date",
        c."title",
        TRIM(f.value::string)        AS word
    FROM cleaned c
         ,LATERAL FLATTEN ( INPUT => SPLIT( c.body_clean , ' ' ) ) f
    WHERE TRIM(f.value::string) <> ''
), no_stop AS (      -- 3. remove a basic English stop–word list
    SELECT t.*
    FROM tokens t
    LEFT JOIN (
          SELECT COLUMN1 AS stop_word
          FROM VALUES
              ('a'),('about'),('above'),('after'),('again'),('against'),('all'),('am'),('an'),
              ('and'),('any'),('are'),('as'),('at'),('be'),('because'),('been'),('before'),
              ('being'),('below'),('between'),('both'),('but'),('by'),('could'),('did'),('do'),
              ('does'),('doing'),('down'),('during'),('each'),('few'),('for'),('from'),
              ('further'),('had'),('has'),('have'),('having'),('he'),('her'),('here'),('hers'),
              ('herself'),('him'),('himself'),('his'),('how'),('i'),('if'),('in'),('into'),
              ('is'),('it'),('its'),('itself'),('just'),('me'),('more'),('most'),('my'),
              ('myself'),('no'),('nor'),('not'),('now'),('of'),('off'),('on'),('once'),
              ('only'),('or'),('other'),('our'),('ours'),('ourselves'),('out'),('over'),
              ('own'),('same'),('she'),('should'),('so'),('some'),('such'),('than'),('that'),
              ('the'),('their'),('theirs'),('them'),('themselves'),('then'),('there'),
              ('these'),('they'),('this'),('those'),('through'),('to'),('too'),('under'),
              ('until'),('up'),('very'),('was'),('we'),('were'),('what'),('when'),('where'),
              ('which'),('while'),('who'),('whom'),('why'),('with'),('you'),('your'),
              ('yours'),('yourself'),('yourselves')
    ) s
      ON t.word = s.stop_word
    WHERE s.stop_word IS NULL
), word_vectors AS ( -- 4. keep only words that have freq & Glove vector, apply weighting
    SELECT
        ns."id",
        ns."date",
        ns."title",
        gv."vector"                            AS vec,
        wf."frequency"::FLOAT                  AS freq
    FROM no_stop ns
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  gv  ON gv."word" = ns.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf ON wf."word" = ns.word
), weighted_flat AS ( -- 5. flatten each vector, divide by freq^0.4
    SELECT
        wv."id",
        wv."date",
        wv."title",
        f.index                            AS pos,
        ( f.value::FLOAT / POWER( wv.freq , 0.4 ) )  AS comp
    FROM word_vectors wv
         ,LATERAL FLATTEN ( INPUT => wv.vec ) f
), summed AS (        -- 6. sum the weighted components for every article
    SELECT
        id,
        date,
        title,
        pos,
        SUM(comp) AS component
    FROM weighted_flat
    GROUP BY id, date, title, pos
), with_mag AS (      -- 7. compute Euclidean norm (magnitude) of each article vector
    SELECT
        id,
        date,
        title,
        pos,
        component,
        SQRT( SUM(component*component) OVER (PARTITION BY id) ) AS magnitude
    FROM summed
), norm_components AS ( -- 8. normalise every component
    SELECT
        id,
        date,
        title,
        pos,
        CASE WHEN magnitude = 0 THEN 0 ELSE component / magnitude END AS component_norm
    FROM with_mag
), article_vectors AS ( -- 9. re-assemble ordered array of normalised components
    SELECT
        id,
        date,
        title,
        ARRAY_AGG( component_norm ORDER BY pos ) AS article_vector
    FROM norm_components
    GROUP BY id, date, title
)
-- 10. final output
SELECT
    id,
    date,
    title,
    article_vector
FROM article_vectors;
```
