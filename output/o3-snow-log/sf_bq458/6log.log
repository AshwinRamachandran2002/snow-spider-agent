    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
    WHERE n."body" IS NOT NULL
), tokenised AS (                      /* 2 ─ split into individual words           */
    SELECT
        c.id,
        c.art_date,
        c.title,
        TRIM( f.value::string )        AS word
    FROM cleaned c,
         LATERAL FLATTEN( INPUT => SPLIT( c.body_clean, ' ' ) ) f
    WHERE TRIM( f.value::string ) <> ''
), no_stop AS (                        /* 3 ─ filter out English stop-words         */
    SELECT tk.*
    FROM tokenised tk
    LEFT JOIN (
        SELECT COLUMN1 AS stop_word
        FROM VALUES
            ('a'),('about'),('above'),('after'),('again'),('against'),('all'),('am'),('an'),
            ('and'),('any'),('are'),('as'),('at'),('be'),('because'),('been'),('before'),
            ('being'),('below'),('between'),('both'),('but'),('by'),('could'),('did'),('do'),
            ('does'),('doing'),('down'),('during'),('each'),('few'),('for'),('from'),
            ('further'),('had'),('has'),('have'),('having'),('he'),('her'),('here'),('hers'),
            ('herself'),('him'),('himself'),('his'),('how'),('i'),('if'),('in'),('into'),
            ('is'),('it'),('its'),('itself'),('just'),('me'),('more'),('most'),('my'),
            ('myself'),('no'),('nor'),('not'),('now'),('of'),('off'),('on'),('once'),
            ('only'),('or'),('other'),('our'),('ours'),('ourselves'),('out'),('over'),
            ('own'),('same'),('she'),('should'),('so'),('some'),('such'),('than'),('that'),
            ('the'),('their'),('theirs'),('them'),('themselves'),('then'),('there'),
            ('these'),('they'),('this'),('those'),('through'),('to'),('too'),('under'),
            ('until'),('up'),('very'),('was'),('we'),('were'),('what'),('when'),('where'),
            ('which'),('while'),('who'),('whom'),('why'),('with'),('you'),('your'),
            ('yours'),('yourself'),('yourselves')
    ) sw
        ON tk.word = sw.stop_word
    WHERE sw.stop_word IS NULL
), word_counts AS (                   /* 4 ─ how many times each word appears      */
    SELECT
        id,
        art_date,
        title,
        word,
        COUNT(*)                       AS cnt
    FROM no_stop
    GROUP BY id, art_date, title, word
), word_vectors AS (                  /* 5 ─ attach GloVe vector and corpus freq   */
    SELECT
        wc.id,
        wc.art_date,
        wc.title,
        wc.cnt,
        gv."vector"                              AS vec,
        wf."frequency"::FLOAT                    AS freq
    FROM word_counts wc
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    gv
      ON gv."word" = wc.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
      ON wf."word" = wc.word
), weighted_flat AS (                 /* 6 ─ weight vector, flatten into 300 comps */
    SELECT
        wv.id,
        wv.art_date,
        wv.title,
        f.index                                           AS pos,
        ( wv.cnt * f.value::FLOAT / POWER( wv.freq , 0.4) ) AS comp
    FROM word_vectors wv,
         LATERAL FLATTEN( INPUT => wv.vec ) f
), summed AS (                        /* 7 ─ sum components for each article       */
    SELECT
        id,
        art_date,
        title,
        pos,
        SUM( comp ) AS component
    FROM weighted_flat
    GROUP BY id, art_date, title, pos
), magnitude AS (                     /* 8 ─ calculate squared-length per article  */
    SELECT
        id,
        art_date,
        title,
        SUM( component * component ) AS sumsq
    FROM summed
    GROUP BY id, art_date, title
), normalised AS (                    /* 9 ─ divide components by vector length    */
    SELECT
        s.id,
        s.art_date,
        s.title,
        s.pos,
        CASE
            WHEN m.sumsq = 0 THEN 0
            ELSE s.component / SQRT( m.sumsq )
        END AS component_norm
    FROM summed      s
    JOIN magnitude   m  USING ( id, art_date, title )
), article_vectors AS (               /* 10 ─ rebuild ordered array                */
    SELECT
        id,
        art_date,
        title,
        ARRAY_AGG( component_norm ORDER BY pos ) AS article_vector
    FROM normalised
    GROUP BY id, art_date, title
)
/* -------- Final output ------------------------------------------------------ */
SELECT
    id,
    art_date AS "date",
    title,
    article_vector
FROM article_vectors;
