        pos,
        SUM( comp )                         AS component
    FROM weighted_flat
    GROUP BY id, art_date, title, pos
), magnitude AS (                           /* 8. calculate squared-length per art.  */
    SELECT
        id,
        art_date,
        title,
        SUM( component * component )        AS sumsq
    FROM summed
    GROUP BY id, art_date, title
), normalised AS (                          /* 9. divide by vector length            */
    SELECT
        s.id,
        s.art_date,
        s.title,
        s.pos,
        CASE
            WHEN m.sumsq = 0 THEN 0
            ELSE s.component / SQRT( m.sumsq )
        END                                 AS component_norm
    FROM summed s
    JOIN magnitude m
      ON  s.id       = m.id
      AND s.art_date = m.art_date
      AND s.title    = m.title
), article_vectors AS (                     /* 10. collect ordered array             */
    SELECT
        id,
        art_date,
        title,
        ARRAY_AGG( component_norm ) 
            WITHIN GROUP ( ORDER BY pos )   AS article_vector
    FROM normalised
    GROUP BY id, art_date, title
)
/* ---------------------------- final result ---------------------------------- */
SELECT
    id,
    art_date AS "date",
    title,
    article_vector
FROM article_vectors;
```
