   ------------------------------------------------------------ */
WITH cleaned AS (                        /* 1 ─ tidy up text                        */
    SELECT
        n."id"                                     AS id,
        n."date"                                   AS art_date,
        n."title"                                  AS title,
        LOWER( REGEXP_REPLACE( n."body",
                               '[^A-Za-z]+',
