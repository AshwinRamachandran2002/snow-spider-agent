```sql
/* -----------------------------------------------------------
   Build a per-article unit-length vector from GloVe embeddings
   ----------------------------------------------------------- */
WITH
/* 1.  Basic article information & pre-tokenised body */
article_meta AS (
    SELECT  n."id",
            n."date",
            n."title",
            SPLIT(
                REGEXP_REPLACE( LOWER(n."body"), '[^a-z]+', ' ' ),
                ' '
            ) AS token_array
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
),
/* 2.  Explode tokens and discard blanks / stop-words              */
tokens AS (
    SELECT  am."id",
            tok.value::STRING AS token
    FROM article_meta am,
         LATERAL FLATTEN( INPUT => am.token_array ) tok
    WHERE tok.value IS NOT NULL
      AND tok.value::STRING NOT IN (      -- stop-word list
        '', 'the','and','a','an','of','to','in','for','on','with','is','was','are','be','by','that',
        'this','it','as','at','from','or','which','we','our','these','those','has','have','had','but',
        'can','could','should','would','also','may','might','been','were','not','than','then','into',
        'about','such','their','they','them','its','he','she','his','her','you','your','i','me','my',
        'do','does','did'
      )
),
/* 3.  Count each remaining word per article                       */
token_counts AS (
    SELECT  "id",
            token,
            COUNT(*) AS cnt
    FROM tokens
    GROUP BY "id", token
),
/* 4.  Bring in vector & corpus frequency once per token           */
token_info AS (
    SELECT  tc."id",
            tc.token,
            tc.cnt,
            gv."vector"            AS vec,
            wf."frequency"         AS freq
    FROM token_counts tc
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    gv  ON gv."word" = tc.token
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf  ON wf."word" = tc.token
),
/* 5.  Weight vector components (cnt / freq^0.4) and explode       */
weighted_components AS (
    SELECT  ti."id",
            comp.index                            AS idx,
            ( ti.cnt * comp.value::FLOAT
              / POWER( ti.freq::FLOAT , 0.4) )    AS w_val
    FROM token_info ti,
         LATERAL FLATTEN( INPUT => ti.vec ) comp
),
/* 6.  Sum weighted components to get raw article vectors          */
article_raw_vec AS (
    SELECT  "id",
            idx,
            SUM( w_val ) AS comp
    FROM weighted_components
    GROUP BY "id", idx
),
/* 7.  Compute magnitude of each raw vector                        */
article_mag AS (
    SELECT  "id",
            SQRT( SUM( comp * comp ) ) AS mag
    FROM article_raw_vec
    GROUP BY "id"
),
/* 8.  Normalise to unit length and (re)assemble ordered array     */
article_vector AS (
    SELECT  ar."id",
            ARRAY_AGG( ar.comp / NULLIF(am.mag,0)
                       ORDER BY ar.idx ) AS vector
    FROM article_raw_vec ar
    JOIN article_mag am
      ON ar."id" = am."id"
    GROUP BY ar."id"
)
/* 9.  Final result: meta data + unit vector                       */
SELECT  am."id",
        am."date",
        am."title",
        av.vector AS article_vector
FROM article_meta am
JOIN article_vector av
  ON am."id" = av."id";
```
