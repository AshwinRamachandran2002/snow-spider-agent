```sql
WITH articles AS (                                                         -- 1. pull body text and tokenize
    SELECT  n."id",
            n."date",
            n."title",
            SPLIT(                                                         -- simple word-tokenisation
                  REGEXP_REPLACE( LOWER(n."body"), '[^a-z]+', ' '),        -- keep only a-z
                  ' '
            ) AS token_array
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
),
tokens AS (                                                                 -- 2. explode the token array
    SELECT  a."id",
            a."date",
            a."title",
            f.value::STRING AS token
    FROM articles a,
         LATERAL FLATTEN( input => a.token_array ) f
    WHERE f.value IS NOT NULL
),
tokens_filtered AS (                                                        -- 3. drop blanks & stop-words
    SELECT *
    FROM tokens
    WHERE token NOT IN (
        '', 'the','and','a','an','of','to','in','for','on','with','is','was','are','be','by','that',
        'this','it','as','at','from','or','which','we','our','these','those','has','have','had','but',
        'can','could','should','would','also','may','might','been','were','not','than','then','into',
        'about','such','their','they','them','its','he','she','his','her','you','your','i','me','my',
        'do','does','did'
    )
),
joined AS (                                                                 -- 4. attach glove vector + frequency
    SELECT  t."id",
            t."date",
            t."title",
            gv."vector"       AS vector,
            wf."frequency"    AS freq
    FROM tokens_filtered t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS     gv ON t.token = gv."word"
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  wf ON t.token = wf."word"
),
weighted AS (                                                               -- 5. weight every component
    SELECT  j."id",
            j."date",
            j."title",
            v.index                                            AS v_index,
            ( v.value::FLOAT / POWER( j.freq::FLOAT , 0.4) )   AS weighted_val
    FROM joined j,
         LATERAL FLATTEN( input => j.vector ) v
),
article_components AS (                                                     -- 6. sum components per article
    SELECT  "id",
            "date",
            "title",
            v_index,
            SUM( weighted_val ) AS comp
    FROM weighted
    GROUP BY "id", "date", "title", v_index
),
article_magnitude AS (                                                      -- 7. ||vector||
    SELECT  "id",
            "date",
            "title",
            SQRT( SUM( comp * comp ) ) AS mag
    FROM article_components
    GROUP BY "id", "date", "title"
),
normalized AS (                                                             -- 8. normalise & rebuild array
    SELECT  ac."id",
            ac."date",
            ac."title",
            ARRAY_AGG( ac.comp / am.mag ORDER BY ac.v_index ) AS article_vector
    FROM article_components ac
    JOIN article_magnitude am
          ON ac."id" = am."id"
    GROUP BY ac."id", ac."date", ac."title"
)
SELECT  "id",
        "date",
        "title",
        article_vector
FROM normalized;
```
