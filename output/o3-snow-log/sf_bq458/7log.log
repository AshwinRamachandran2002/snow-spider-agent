-- 7)  Compute the weighting factor 1 / frequency^0.4 for every word  
WITH words AS (
  SELECT LOWER(tok.value)::STRING AS "word"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
       LATERAL SPLIT_TO_TABLE(
         REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' '), ' '
       ) tok
  WHERE n."id" = (SELECT "id" FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" LIMIT 1)
),
joined AS (
  SELECT w."word",
         wf."frequency",
         1.0 / POWER(wf."frequency", 0.4)   AS "weight"
  FROM words w
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
    ON wf."word" = w."word"
)
SELECT *
FROM joined
LIMIT 20;
