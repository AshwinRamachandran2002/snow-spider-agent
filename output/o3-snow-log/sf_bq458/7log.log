```sql
-- 6)  Attach corpus frequencies to those tokens  
WITH one_article AS (
  SELECT "id", "body"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
  ORDER BY "date" DESC
  LIMIT 1
),
tokens AS (
  SELECT tok.value::STRING AS "word"
  FROM one_article oa,
       LATERAL SPLIT_TO_TABLE(
         REGEXP_REPLACE(oa."body", '[^A-Za-z ]', ' '), ' '
       ) tok
)
SELECT t."word",
       wf."frequency"
FROM tokens t
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
  ON wf."word" = t."word"
LIMIT 20;
```

```sql
-- 7)  Compute the weighting factor 1 / frequency^0.4 for every word  
WITH words AS (
  SELECT LOWER(tok.value)::STRING AS "word"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
       LATERAL SPLIT_TO_TABLE(
         REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' '), ' '
       ) tok
  WHERE n."id" = (SELECT "id" FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" LIMIT 1)
),
joined AS (
  SELECT w."word",
         wf."frequency",
         1.0 / POWER(wf."frequency", 0.4)   AS "weight"
  FROM words w
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
    ON wf."word" = w."word"
)
SELECT *
FROM joined
LIMIT 20;
```

```sql
-- 8)  Bring in the 300-dimensional GloVe vectors for each weighted word  
WITH words AS (
  SELECT LOWER(tok.value)::STRING AS "word"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
       LATERAL SPLIT_TO_TABLE(
         REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' '), ' '
       ) tok
  WHERE n."id" = (SELECT "id" FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" LIMIT 1)
),
joined AS (
  SELECT w."word",
         wf."frequency",
         1.0 / POWER(wf."frequency", 0.4)                    AS "weight",
         gv."vector"
  FROM words w
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
    ON wf."word" = w."word"
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
    ON gv."word" = w."word"
)
SELECT "word", "weight", "vector"
FROM joined
LIMIT 20;
```

```sql
-- 9)  Multiply every element in the vector by its weight (element-wise scaling)  
WITH word_vecs AS (
  SELECT gv."word",
         1.0 / POWER(wf."frequency", 0.4)                               AS "weight",
         gv."vector"                                                    AS "vec"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"  wf
    ON gv."word" = wf."word"
  WHERE gv."word" IN ('cell','culture','serum')                         -- sample
)
SELECT "word",
       ARRAY_TRANSFORM("vec", x -> x * "weight") AS "weighted_vector"
FROM word_vecs
LIMIT 20;
```

```sql
--10)  Full pipeline (per article): sum the weighted vectors and normalise to unit length  
WITH tokens AS (  -- explode every article into cleaned word tokens
  SELECT n."id"           AS "article_id",
         n."date",
         n."title",
         LOWER(tok.value)::STRING AS "word"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
       LATERAL SPLIT_TO_TABLE(
         REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' '), ' '
       ) tok
  WHERE tok.value IS NOT NULL
),
wfreq AS (  -- attach corpus frequency
  SELECT t.*,
         wf."frequency",
         1.0 / POWER(wf."frequency", 0.4)                 AS "weight"
  FROM tokens t
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
    ON wf."word" = t."word"
),
wvecs AS (  -- add GloVe vectors & scale them
  SELECT w.*,
         ARRAY_TRANSFORM(gv."vector", x -> x * w."weight") AS "scaled_vec"
  FROM wfreq w
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
    ON gv."word" = w."word"
),
vec_sum AS (  -- sum all scaled vectors per article
  SELECT "article_id",
         "date",
         "title",
         ARRAY_AGG("scaled_vec")                AS "vec_list"
  FROM wvecs
  GROUP BY "article_id", "date", "title"
),
summed AS (  -- flatten & accumulate by index position
  SELECT vs."article_id",
         vs."date",
         vs."title",
         ARRAY_AGG(sv.value)                    AS "raw_sum_vec"
  FROM vec_sum vs,
       LATERAL FLATTEN(vs."vec_list") f1,       -- list of vectors
       LATERAL FLATTEN(input => f1.value) sv    -- individual dimensions
  GROUP BY vs."article_id", vs."date", vs."title", sv.index
  ORDER BY vs."article_id", sv.index
),
normed AS (  -- compute magnitude & divide each component
  SELECT s."article_id",
         s."date",
         s."title",
         ARRAY_AGG(s.raw_sum_vec[0])                          AS "sum_vector", -- rebuild
         SQRT(SUM(POWER(s.raw_sum_vec[0], 2)))                AS "norm"
  FROM summed s
  GROUP BY s."article_id", s."date", s."title"
)
SELECT "article_id" AS "id",
       "date",
       "title",
       ARRAY_TRANSFORM("sum_vector", x -> x / NULLIF("norm", 0)) 
         AS "normalized_vector"
FROM normed
LIMIT 20;
```
