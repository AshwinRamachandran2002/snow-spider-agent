```sql
--Description: Build a unit-length embedding for every Nature article.
-- Steps
-- 1. Split each article body into lowercase tokens (letters only).
-- 2. Join to WORD_FREQUENCIES → get frequency and compute weight = 1 / freq^0.4.
-- 3. Join to GLOVE_VECTORS and scale each 300-D vector by that weight
--    with ARRAY_TRANSFORM(gv.vector , v -> v * weight).
-- 4. Flatten the scaled vectors and sum per dimension to obtain one raw
--    article vector.
-- 5. Re-assemble the vector, compute its L2 norm, and divide each component
--    by the norm to yield a normalised (unit-length) article vector.
-- The query returns id, date, title, and the normalised vector (first 20 rows).

WITH tokens AS (            -- 1. explode bodies into tokens
    SELECT  n."id"  AS article_id,
            n."date",
            n."title",
            LOWER(tok.value)::STRING AS word
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
         LATERAL SPLIT_TO_TABLE(
             REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' '), ' '
         ) tok
    WHERE tok.value IS NOT NULL
      AND tok.value <> ''
),
wfreq AS (                  -- 2. attach frequency and weight
    SELECT  t.*,
            wf."frequency",
            1.0 / POWER(wf."frequency", 0.4) AS weight
    FROM tokens t
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
          ON wf."word" = t.word
),
wvecs AS (                  -- 3. scale GloVe vectors by weight
    SELECT  w.article_id,
            w."date",
            w."title",
            ARRAY_TRANSFORM(gv."vector", v -> v * weight) AS scaled_vec
    FROM wfreq w
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
          ON gv."word" = w.word
),
dims AS (                   -- 4. flatten into (dimension, value)
    SELECT  article_id,
            "date",
            "title",
            fv.index                AS dim,
            fv.value::FLOAT         AS val
    FROM wvecs,
         LATERAL FLATTEN(input => scaled_vec) fv
),
summed AS (                 -- sum across tokens per dimension
    SELECT  article_id,
            "date",
            "title",
            dim,
            SUM(val) AS dim_sum
    FROM dims
    GROUP BY article_id, "date", "title", dim
),
vec_and_norm AS (           -- 5. rebuild vector & compute norm
    SELECT  article_id,
            "date",
            "title",
            ARRAY_AGG(dim_sum ORDER BY dim) AS sum_vector,
            SQRT(SUM(POWER(dim_sum, 2)))    AS norm_val
    FROM summed
    GROUP BY article_id, "date", "title"
)
SELECT  article_id AS id,
        "date",
        "title",
        ARRAY_TRANSFORM(sum_vector, x -> x / NULLIF(norm_val, 0))
            AS normalized_vector
FROM vec_and_norm
LIMIT 20;
```
