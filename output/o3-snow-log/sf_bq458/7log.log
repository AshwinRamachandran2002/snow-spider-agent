```sql
-- 4)  Tokenise the BODY of that single article into individual words  
WITH one_article AS (
  SELECT "id", "body"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
  ORDER BY "date" DESC
  LIMIT 1
)
SELECT oa."id"    AS "article_id",
       tok.value::STRING  AS "token"
FROM one_article oa,
     LATERAL SPLIT_TO_TABLE(
