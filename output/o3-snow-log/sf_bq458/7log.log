            ' '                                           -- split on blanks
      ) tok
WHERE tok.value IS NOT NULL
  AND tok.value <> ''
LIMIT 20;
```

```sql
-- 5)  Same token list but drop a few common stop-words (very small example list)  
WITH one_article AS (
  SELECT "id", "body"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
  ORDER BY "date" DESC
  LIMIT 1
),
tokens AS (
  SELECT tok.value::STRING AS "word"
  FROM one_article oa,
       LATERAL SPLIT_TO_TABLE(
