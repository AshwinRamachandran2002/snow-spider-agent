WITH stop_words AS (
    SELECT column1 AS word FROM VALUES
        ('the'), ('and'), ('of'), ('to'), ('in'), ('a'), ('for'), ('on')
),
-- 1)  Tokenise BODY, drop blanks & stop-words
tokens AS (
    SELECT  n."id",
            n."date",
            n."title",
            LOWER(tok.value)::STRING AS word
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
            LATERAL SPLIT_TO_TABLE(
                    REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' '),   -- keep letters & blanks
                    ' '                                            -- split on blanks
            ) tok
    WHERE   tok.value IS NOT NULL
      AND   tok.value <> ''
      AND   LOWER(tok.value) NOT IN (SELECT word FROM stop_words)
),
-- 2)  Attach global frequency & 300-D GloVe vector, compute weight factor 1/freq^0.4
word_info AS (
    SELECT  t."id",
            t."date",
            t."title",
            gv."vector"                   AS vector,
            POWER(wf."frequency", 0.4)    AS freq_pow
    FROM    tokens t
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
           ON wf."word" = t.word
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"     gv
           ON gv."word" = t.word
),
-- 3)  Weight every component of every word vector
weighted_components AS (
    SELECT  wi."id",
            wi."date",
            wi."title",
            f.index                            AS pos,         -- component index 0-299
            (f.value::FLOAT / wi.freq_pow)    AS comp_value   -- weighted component
    FROM    word_info wi,
            LATERAL FLATTEN(input => wi.vector) f
),
-- 4)  Sum weighted components across all word-tokens of the article
summed AS (
    SELECT  "id",
            "date",
            "title",
            pos,
            SUM(comp_value) AS comp_sum
    FROM    weighted_components
    GROUP BY "id", "date", "title", pos
),
-- 5)  Article-vector magnitude (L2-norm)
norms AS (
    SELECT  "id",
            SQRT(SUM(comp_sum * comp_sum)) AS magnitude
    FROM    summed
    GROUP BY "id"
),
-- 6)  Build the normalised article vector (unit length)
normalised AS (
    SELECT  s."id",
            s."date",
            s."title",
            ARRAY_AGG( s.comp_sum / n.magnitude ORDER BY s.pos )  AS article_vector
    FROM    summed s
    JOIN    norms n  ON n."id" = s."id"
    GROUP BY s."id", s."date", s."title"
)
-- 7)  Final result
SELECT  "id",
        "date",
        "title",
        article_vector
FROM    normalised
ORDER BY "date" NULLS LAST;
```
