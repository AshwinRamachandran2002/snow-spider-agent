--Description: Build a unit-length (L2-normalised) embedding for every Nature
--             article.  Pipeline:
--             1) Tokenise each article body into lowercase words.
--             2) Attach corpus frequency and compute weight = 1 / freq^0.4.
--             3) Fetch each word’s 300-D GloVe vector and scale it by the
--                weight with ARRAY_TRANSFORM.
--             4) Flatten all scaled vectors, sum values per dimension to form
--                one raw 300-D vector per article.
--             5) Re-assemble the summed vector ordered by dimension, compute
--                its L2 norm, then divide every component to obtain a
--                unit-length article vector.
--             The query returns id, date, title and the normalised vector
--             (first 20 rows for illustration).

WITH tokens AS (                      -- 1. split body into words
    SELECT  n."id"  AS article_id,
            n."date",
            n."title",
            LOWER(tok.value)::STRING AS word
    FROM  "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
          LATERAL SPLIT_TO_TABLE(
              REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' '), ' '
          ) tok
    WHERE tok.value IS NOT NULL
      AND tok.value <> ''
),
wfreq AS (                            -- 2. add frequency & weight
    SELECT  t.*,
            wf."frequency",
            1.0 / POWER(wf."frequency", 0.4) AS weight
    FROM  tokens t
    JOIN  "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
          ON wf."word" = t.word
),
wvecs AS (                            -- 3. scale GloVe vectors
    SELECT  w.article_id,
            w."date",
            w."title",
            ARRAY_TRANSFORM(gv."vector", v -> v * weight) AS scaled_vec
    FROM  wfreq w
    JOIN  "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
          ON gv."word" = w.word
),
dims AS (                             -- 4. flatten to (dim,val) rows
    SELECT  article_id,
            "date",
            "title",
            f.index        AS dim,
            f.value::FLOAT AS val
    FROM  wvecs,
          LATERAL FLATTEN(input => scaled_vec) f
),
summed AS (                           --    sum per dimension
    SELECT  article_id,
            "date",
            "title",
            dim,
            SUM(val) AS dim_sum
    FROM  dims
    GROUP BY article_id, "date", "title", dim
),
vec_and_norm AS (                     -- 5. rebuild vector & compute norm
    SELECT  article_id,
            "date",
            "title",
            ARRAY_AGG(dim_sum) WITHIN GROUP (ORDER BY dim) AS sum_vector,
            SQRT(SUM(POWER(dim_sum, 2)))                   AS norm_val
    FROM  summed
    GROUP BY article_id, "date", "title"
)
SELECT  article_id AS id,
        "date",
        "title",
        ARRAY_TRANSFORM(sum_vector, x -> x / NULLIF(norm_val, 0)) AS normalized_vector
FROM  vec_and_norm
LIMIT 20;
