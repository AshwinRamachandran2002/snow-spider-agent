```sql
--Description:
-- Goal:  For the three sample words ‘cell’, ‘culture’, and ‘serum’
--        (1) obtain their corpus frequency,
--        (2) compute the weighting factor 1 / frequency^0.4,
--        (3) fetch the 300-D GloVe vector, and
--        (4) scale every element of that vector by the weight.
-- Approach:  Use one CTE (word_vecs) to join WORD_FREQUENCIES with
--            GLOVE_VECTORS, calculate the weight, then in the final
--            SELECT apply ARRAY_TRANSFORM to multiply each vector
--            component by wv.weight.  Referencing the column through
--            the table alias (wv.weight) avoids the earlier identifier
--            error inside the lambda.

WITH word_vecs AS (
    SELECT
        gv."word",
        1.0 / POWER(wf."frequency", 0.4) AS "weight",
