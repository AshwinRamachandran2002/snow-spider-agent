                REGEXP_REPLACE(n."body", '[^A-Za-z ]', ' '),   -- keep letters & blanks
                ' '                                            -- split on blanks
            ) tok
    WHERE   tok.value IS NOT NULL
      AND   tok.value <> ''
      AND   LOWER(tok.value) NOT IN (SELECT word FROM stop_words)
),
/* 2) Attach corpus frequency & GloVe vector, compute freq^0.4 */
word_info AS (
    SELECT  t."id",
            t."date",
            t."title",
            gv."vector"                     AS w_vector,
            POWER(wf."frequency", 0.4)      AS freq_pow
    FROM    tokens t
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
           ON wf."word" = t.word
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
           ON gv."word" = t.word
),
/* 3) Weight each component of every word vector */
weighted_components AS (
    SELECT  wi."id",
            wi."date",
            wi."title",
            f.index                                 AS pos,          -- component index
            (f.value::FLOAT / wi.freq_pow)          AS comp_value    -- weighted component
    FROM    word_info wi,
            LATERAL FLATTEN(input => wi.w_vector) f
),
/* 4) Sum weighted components per article */
summed AS (
    SELECT  "id",
            "date",
            "title",
            pos,
            SUM(comp_value) AS comp_sum
    FROM    weighted_components
    GROUP BY "id", "date", "title", pos
),
/* 5) Compute L2-norm per article */
norms AS (
    SELECT  "id",
            SQRT(SUM(comp_sum * comp_sum)) AS magnitude
    FROM    summed
    GROUP BY "id"
),
/* 6) Build the normalised (unit-length) article vector */
normalised AS (
    SELECT  s."id",
            s."date",
            s."title",
            ARRAY_AGG( s.comp_sum / n.magnitude )
              WITHIN GROUP (ORDER BY s.pos)        AS article_vector
    FROM    summed s
    JOIN    norms n  ON n."id" = s."id"
    GROUP BY s."id", s."date", s."title"
)
/* 7) Final output */
SELECT  "id",
        "date",
        "title",
        article_vector
FROM    normalised
ORDER BY "date" NULLS LAST;
