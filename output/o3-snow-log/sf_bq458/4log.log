    SELECT  "id",
            SQRT(SUM(POWER(component_sum, 2))) AS mag
    FROM   article_components
    GROUP BY "id"
    HAVING mag > 0
),

/* 9. normalise components */
normalized_components AS (
    SELECT  ac."id",
            ac.idx,
            ac.component_sum / m.mag AS norm_component
    FROM    article_components ac
    JOIN    magnitudes m ON ac."id" = m."id"
)

/* 10. final unit-length article vectors */
SELECT  a."id",
        a."date",
        a."title",
        ARRAY_AGG(nc.norm_component) WITHIN GROUP (ORDER BY nc.idx) AS article_vector
FROM    articles a
JOIN    normalized_components nc ON a."id" = nc."id"
GROUP BY a."id", a."date", a."title";
