/* =====================================================================
   Build a unit-length article vector for every Nature paper
   (runs fast because the JavaScript aggregate adds whole arrays,
    so we never explode each vector into 300 separate rows)
   ===================================================================== */

/* ---------- 1. helper aggregate – running, weighted sum of vectors --- */
CREATE OR REPLACE TEMPORARY FUNCTION weighted_vec_sum_agg(v ARRAY, f FLOAT)
RETURNS ARRAY
LANGUAGE JAVASCRIPT
AS
$${
  aggregate : {
    /* running total held in this.sum */
    init : function ()        { this.sum = null; },

    iterate : function (vec , freq_pow) {
      if (vec === null || freq_pow === null) return;

      /* weight = 1 / freq_pow  (0.4-th power of frequency) */
      var w = 1.0 / freq_pow;

      if (this.sum === null) {
        /* first vector ‑ make a weighted copy */
        this.sum = [];
        for (var i = 0; i < vec.length; i++) {
          this.sum.push(vec[i] * w);
        }
      } else {
        /* add, element-wise */
        for (var j = 0; j < vec.length; j++) {
          this.sum[j] += vec[j] * w;
        }
      }
    },

    merge : function (other) {
      if (other.sum === null) return;
      if (this.sum === null)  { this.sum = other.sum; }
      else {
        for (var k = 0; k < other.sum.length; k++) {
          this.sum[k] += other.sum[k];
        }
      }
    },

    result : function ()      { return this.sum; }
  }
}$$;

/* ---------- 2. helper scalar – L2 normalise a vector ---------------- */
CREATE OR REPLACE TEMPORARY FUNCTION vector_normalize(vec ARRAY)
RETURNS ARRAY
LANGUAGE JAVASCRIPT
AS
$$
  if (vec === null) return null;
  var norm = 0.0;
  for (var i = 0; i < vec.length; i++) norm += vec[i] * vec[i];
  norm = Math.sqrt(norm);
  if (norm === 0) return vec;

  var out = [];
  for (var j = 0; j < vec.length; j++) out.push(vec[j] / norm);
  return out;
$$;

/* ---------- 3. main query ------------------------------------------ */
WITH
/* stop-word list */
stop_words(word) AS (
  SELECT column1 FROM VALUES
    ('the'),('a'),('an'),('and'),('or'),('in'),('on'),('for'),('of'),('to'),
    ('is'),('are'),('was'),('were'),('be'),('been'),('this'),('that'),
    ('those'),('these'),('with'),('from'),('by'),('at'),('as'),('it'),
    ('its'),('but'),('not'),('have'),('has'),('had'),('he'),('she'),
    ('they'),('them'),('we'),('you'),('i')
),

/* tokenise article bodies */
tokens AS (
  SELECT  n."id",
          n."date",
          n."title",
          LOWER(REGEXP_REPLACE(tok.value , '[^A-Za-z0-9]+', '')) AS word
  FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
          LATERAL SPLIT_TO_TABLE(n."body", ' ') tok
  WHERE   tok.value IS NOT NULL
),

/* remove stop-words & blanks, keep each word once per article */
filtered_tokens AS (
  SELECT DISTINCT t."id", t."date", t."title", t.word
  FROM   tokens t
  LEFT   JOIN stop_words s ON t.word = s.word
  WHERE  s.word IS NULL
     AND t.word <> ''
),

/* attach word frequency & GloVe vector */
word_vectors AS (
  SELECT  ft."id",
          ft."date",
          ft."title",
          gv."vector"                         AS vec,
          POWER(wf."frequency", 0.4)          AS freq_pow
  FROM   filtered_tokens ft
  JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
           ON wf."word" = ft.word
  JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    gv
           ON gv."word"   = ft.word
),

/* aggregate to one weighted-sum vector per article */
raw_article_vectors AS (
  SELECT  "id",
          "date",
          "title",
          weighted_vec_sum_agg(vec, freq_pow) AS raw_vec
  FROM    word_vectors
  GROUP BY "id", "date", "title"
)

/* final, unit-length vectors */
SELECT  "id",
        "date",
        "title",
        vector_normalize(raw_vec) AS article_vector
FROM    raw_article_vectors;
