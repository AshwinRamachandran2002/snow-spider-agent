```sql
/* ---------------------------------------------------------
   Build a unit-length “article vector” for every Nature paper
   --------------------------------------------------------- */
WITH
/* --------------- 1.  hard-coded stop-word list ------------- */
stop_words(word) AS (
    SELECT column1 AS word FROM VALUES
        ('the'),('a'),('an'),('and'),('or'),('in'),('on'),('for'),('of'),('to'),
        ('is'),('are'),('was'),('were'),('be'),('been'),('this'),('that'),
        ('those'),('these'),('with'),('from'),('by'),('at'),('as'),('it'),
        ('its'),('but'),('not'),('have'),('has'),('had'),('he'),('she'),
        ('they'),('them'),('we'),('you'),('i')
),
/* --------------- 2.  pull raw article text ----------------- */
articles AS (
    SELECT  "id",
            "date",
            "title",
            "body"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
),
/* --------------- 3.  tokenise & clean ---------------------- */
tokens AS (
    SELECT  a."id",
            LOWER(REGEXP_REPLACE(tok.value,'[^A-Za-z0-9]+','')) AS word
    FROM   articles a,
           LATERAL SPLIT_TO_TABLE(a."body",' ') tok
    WHERE  tok.value IS NOT NULL
),
/* --------------- 4.  drop stop-words ----------------------- */
filtered_tokens AS (
    SELECT DISTINCT t."id", t.word
    FROM   tokens t
    LEFT   JOIN stop_words s ON t.word = s.word
    WHERE  s.word IS NULL
          AND t.word <> ''
),
/* --------------- 5.  join to frequency & GloVe ------------- */
word_info AS (
    SELECT  ft."id",
            gv."vector",                       -- GloVe vector (array)
            POWER(wf."frequency",0.4) AS freq_pow
    FROM   filtered_tokens ft
    JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
           ON wf."word" = ft.word
    JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"    gv
           ON gv."word" = ft.word
),
/* --------------- 6.  apply frequency weighting ------------- */
weighted_components AS (
    SELECT  wi."id",
            comp.index                                      AS idx,
            comp.value::FLOAT / wi.freq_pow                 AS component_value
    FROM   word_info wi,
           LATERAL FLATTEN(input => wi."vector") comp
),
/* --------------- 7.  sum components per article ------------ */
article_components AS (
    SELECT  "id",
            idx,
            SUM(component_value)            AS component_sum
    FROM   weighted_components
    GROUP BY "id", idx
),
/* --------------- 8.  compute vector magnitude -------------- */
magnitudes AS (
    SELECT  "id",
            SQRT(SUM(POWER(component_sum,2))) AS mag
    FROM   article_components
    GROUP BY "id"
    HAVING mag > 0                            -- drop empty vectors
),
/* --------------- 9.  normalise components ------------------ */
normalized_components AS (
    SELECT  ac."id",
            ac.idx,
            ac.component_sum / m.mag          AS norm_component
    FROM   article_components ac
    JOIN   magnitudes m  ON ac."id" = m."id"
)
/* --------------- 10. final article-level vector ------------ */
SELECT  a."id",
        a."date",
        a."title",
        ARRAY_AGG(nc.norm_component ORDER BY nc.idx) AS article_vector
FROM    articles               a
JOIN    normalized_components  nc ON a."id" = nc."id"
GROUP BY a."id", a."date", a."title";
```
