        ON f."word" = dw.word
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
        ON g."word" = dw.word
),

/* -------- 5. element-wise weight vector and SUM per article ---------*/
article_raw AS (
  SELECT
      ft."id",
      ft."date",
      ft."title",
      /* Element-wise divide by freq^0.4, then sum all arrays          */
      ARRAY_SUM_AGG(
