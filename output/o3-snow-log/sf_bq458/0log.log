```sql
/* ---------------------------------------------------------
   Build a TF-IDF–like, length-normalised GloVe vector
   for every article in WORD_VECTORS_US.WORD_VECTORS_US.NATURE
----------------------------------------------------------*/
WITH
/* -------- 1. stop-word list --------------------------------*/
stop_words(word) AS (
  SELECT * FROM VALUES
    ('the'),('of'),('and'),('in'),('to'),('a'),('is'),('was'),('were'),
    ('for'),('with'),('on'),('that'),('by'),('at'),('from'),('as'),('an'),
    ('be'),('it'),('this'),('are'),('or'),('which'),('these'),('can'),
    ('we'),('its'),('also'),('may'),('not'),('have'),('has'),('had'),
    ('but'),('their'),('they'),('been')
),

/* -------- 2. tokenise every body into lowercase words -------*/
tokens AS (
  SELECT
      n."id",
      n."date",
      n."title",
      /* keep only alpha-numeric chars inside each token            */
      LOWER(REGEXP_REPLACE(tk.value::STRING,'[^a-z0-9]','')) AS word
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN( input => SPLIT(LOWER(n."body"),' ') ) tk
),

/* -------- 3. keep words that                                         *
 *            – are not stop words                                     *
 *            – have a frequency entry                                 *
 *            – have a GloVe vector                                    */
filtered_tokens AS (
  SELECT
      t."id",
      t."date",
      t."title",
      t.word,
      f."frequency",
      g."vector"
  FROM tokens t
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
        ON f."word" = t.word
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   g
        ON g."word" = t.word
  LEFT JOIN stop_words s       ON s.word = t.word
  WHERE t.word <> ''           -- drop empty strings
    AND s.word IS NULL         -- drop stop-words
),

/* -------- 4. weight every vector by 1 / freq^0.4 --------------------*/
word_components AS (
  SELECT
      ft."id",
      ft."date",
      ft."title",
      v.index                            AS dim,                 -- 0-based
      ( v.value::FLOAT / POWER(ft."frequency",0.4) ) AS weight
  FROM filtered_tokens ft,
       LATERAL FLATTEN( input => ft."vector") v
),

/* -------- 5. sum weighted word vectors into one article vector ------*/
article_components AS (
  SELECT
      "id",
      "date",
      "title",
      dim,
      SUM(weight)                       AS component
  FROM word_components
  GROUP BY "id","date","title",dim
),

/* -------- 6. compute magnitude of every article vector --------------*/
article_magnitude AS (
  SELECT
      "id",
      "date",
      "title",
      SQRT( SUM( component*component ) ) AS mag
  FROM article_components
  GROUP BY "id","date","title"
),

/* -------- 7. normalise components to unit length --------------------*/
normalised AS (
  SELECT
      ac."id",
      ac."date",
      ac."title",
      ac.dim,
      ac.component / am.mag             AS norm_component
  FROM article_components ac
  JOIN article_magnitude  am
        ON am."id" = ac."id"
)

/* -------- 8. pack back into 300-long array --------------------------*/
SELECT
    "id",
    "date",
    "title",
    ARRAY_AGG( norm_component ORDER BY dim ) AS article_vector
FROM normalised
GROUP BY "id","date","title";
```
