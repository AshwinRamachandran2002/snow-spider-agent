  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS g
        ON g."word" = dw.word
),

/* -------- 5. weight each word-vector -----------------------*/
weighted_tokens AS (
  SELECT
      ft."id",
