  SELECT
      dw."id",
      dw."date",
      dw."title",
      f."frequency"               AS frequency,  -- alias without quotes
      g."vector"                  AS vector
  FROM distinct_words dw
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES f
