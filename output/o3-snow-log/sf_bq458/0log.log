```sql
--Description: Find titles that (fuzzily) mention polyamine-related research
SELECT 
  "id",
  "date",
  "title"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE "title" ILIKE '%polyamine%'
LIMIT 20;
```

```sql
--Description: Display the 20 most frequent words in the WORD_FREQUENCIES table
SELECT 
  "word", 
  "frequency"
FROM WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES
ORDER BY "frequency" DESC
LIMIT 20;
```

```sql
--Description: Sample 20 word–vector pairs from the GLOVE_VECTORS table
SELECT 
  "word",
  "vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS
LIMIT 20;
```

```sql
--Description: Show the dimensionality (array size) of each sampled GloVe vector
SELECT 
  "word",
  ARRAY_SIZE("vector") AS "vector_length"
FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS
LIMIT 20;
```

```sql
--Description: Tokenise one article’s body into individual lowercase words
SELECT 
  n."id",
  w.value::STRING  AS "token"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
     LATERAL FLATTEN(input => SPLIT(LOWER(n."body"), ' ')) w
WHERE n."id" = (SELECT MIN("id") FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE)
LIMIT 20;
```

```sql
--Description: Join article tokens to their corpus frequencies
SELECT 
  tok."token",
  freq."frequency"
FROM (
    SELECT w.value::STRING AS "token"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(input => SPLIT(LOWER(n."body"), ' ')) w
    WHERE n."id" = (SELECT MIN("id") FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE)
) tok
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES freq
  ON freq."word" = tok."token"
LIMIT 20;
```

```sql
--Description: Verify GloVe vectors exist for the tokens of that same article
SELECT 
  tok."token",
  gv."vector"
FROM (
    SELECT DISTINCT w.value::STRING AS "token"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(input => SPLIT(LOWER(n."body"), ' ')) w
    WHERE n."id" = (SELECT MIN("id") FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE)
) tok
JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
  ON gv."word" = tok."token"
LIMIT 20;
```
