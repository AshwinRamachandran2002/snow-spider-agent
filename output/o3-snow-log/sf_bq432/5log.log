Query:
--Description: Compute "brand_name_length" = number of brand names after cleansing 
--             and splitting by “ -- ” (first 20 rows).
WITH cte AS (
  SELECT
    "report_number",
    REGEXP_REPLACE(
        REGEXP_REPLACE("products_brand_name", '([0-9]), ([0-9])', '\\1##\\2'),
        ', ', ' -- '
    ) AS "brand_tmp"
  FROM "FDA"."FDA_FOOD"."FOOD_EVENTS"
  WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
    AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
)
SELECT
  "report_number",
  ARRAY_SIZE( SPLIT( REGEXP_REPLACE("brand_tmp", '##', ', '), ' -- ' ) ) 
       AS "brand_name_length"
FROM cte
LIMIT 20;
