```

```sql
--Description: Prepare a cleansed version of "products_brand_name".
--  1) Preserve numeric patterns like “1, 2” by temporarily replacing the comma with “##”.
--  2) Replace every remaining “, ” with “ -- ”.
--  3) Restore the preserved numeric comma.
SELECT
  "report_number",
  "products_brand_name",
  REGEXP_REPLACE(
      REGEXP_REPLACE("products_brand_name", '([0-9]), ([0-9])', '\\1##\\2'),
      ', ', ' -- '
  ) AS "brand_clean_tmp",
  REGEXP_REPLACE(
      REGEXP_REPLACE(
          REGEXP_REPLACE("products_brand_name", '([0-9]), ([0-9])', '\\1##\\2'),
          ', ', ' -- '
      ),
      '##', ', '
  ) AS "brand_clean_final"
FROM "FDA"."FDA_FOOD"."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```

```sql
--Description: Compute "brand_name_length" = number of brand names after cleansing 
--             and splitting by “ -- ” (first 20 rows).
WITH cte AS (
  SELECT
    "report_number",
    REGEXP_REPLACE(
        REGEXP_REPLACE("products_brand_name", '([0-9]), ([0-9])', '\\1##\\2'),
        ', ', ' -- '
    ) AS "brand_tmp"
  FROM "FDA"."FDA_FOOD"."FOOD_EVENTS"
  WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
    AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
)
SELECT
  "report_number",
  ARRAY_SIZE( SPLIT( REGEXP_REPLACE("brand_tmp", '##', ', '), ' -- ' ) ) 
       AS "brand_name_length"
FROM cte
LIMIT 20;
```

```sql
--Description: Clean the list-type columns: "products_industry_code", "products_role",
--             and "products_industry_name" by replacing “, ” with “ -- ”.  
--             Show the transformed values for inspection (first 20 rows).
SELECT
  "report_number",
  REGEXP_REPLACE("products_industry_code", ', ', ' -- ')  AS "industry_code_clean",
  REGEXP_REPLACE("products_role"        , ', ', ' -- ')  AS "products_role_clean",
  REGEXP_REPLACE("products_industry_name", ', ', ' -- ') AS "industry_name_clean"
FROM "FDA"."FDA_FOOD"."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```

```sql
--Description: Calculate "industry_code_length" (count of industry codes after cleansing) 
--             together with "brand_name_length", plus fully split "reactions" 
--             and "outcomes" arrays, assembling everything required by the task.
SELECT
  "report_number",
  SPLIT("reactions", ',')                                         AS "reaction_array",
  SPLIT("outcomes" , ',')                                         AS "outcome_array",
  /* Clean brand name (preserve digit comma digit) */
  REGEXP_REPLACE(
      REGEXP_REPLACE("products_brand_name", '([0-9]), ([0-9])', '\\1##\\2'),
      ', ', ' -- '
  )                                                               AS "brand_clean",
  ARRAY_SIZE(
      SPLIT(
          REGEXP_REPLACE(
              REGEXP_REPLACE("products_brand_name", '([0-9]), ([0-9])', '\\1##\\2'),
              ', ', ' -- '
          ),
          ' -- '
      )
  )                                                               AS "brand_name_length",
  /* Clean industry code */
  REGEXP_REPLACE("products_industry_code", ', ', ' -- ')          AS "industry_code_clean",
  ARRAY_SIZE(
      SPLIT(
          REGEXP_REPLACE("products_industry_code", ', ', ' -- '),
          ' -- '
      )
  )                                                               AS "industry_code_length"
FROM "FDA"."FDA_FOOD"."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```

These eight queries (each capped at 20 rows) progress from simple previews to the fully transformed data, demonstrating how every cleansing and derived-field requirement can be satisfied while exploring the January 2015 subset of FDA food-event records.
