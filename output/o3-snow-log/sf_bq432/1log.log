```sql
--Description: Goal – cleanse "products_brand_name" so that *all* comma-space pairs (", ")
--             are converted to " -- " EXCEPT when they occur between two digits
--             (e.g., “1, 2” must remain “1, 2”).  
--             Snowflake does not yet support variable-width look-behind, so we use a
--             three-step placeholder method inside one nested REGEXP_REPLACE chain:
--             1) Protect digit ,␣ digit patterns by converting the comma-space into a
--                temporary token "§" (REGEXP_REPLACE #1).  
--             2) Replace every remaining ", " with " -- "  (REGEXP_REPLACE #2).  
--             3) Convert the temporary token back to the original ", "               (REGEXP_REPLACE #3).  
--             Finally we show 20 sample rows for events whose "date_created"
--             and "date_started" are both within 01-Jan-2015 to 31-Jan-2015.
SELECT
    "report_number",
    REGEXP_REPLACE(                                     -- Step-3: restore placeholder to ", "
        REGEXP_REPLACE(                                 -- Step-2: convert other ", " to " -- "
            REGEXP_REPLACE(                             -- Step-1: protect digit-comma-digit
                "products_brand_name",
                '([0-9]),\\s([0-9])',                  -- find digit ,␣ digit
                '\\1§\\2'                              -- replace ", " with placeholder "§"
            ),
            ',\\s',                                    -- now safe to replace the rest
            ' -- '
        ),
        '([0-9])§([0-9])',                             -- find placeholder pattern
        '\\1, \\2'                                     -- restore original ", "
    ) AS "clean_brand_name"
FROM "FDA"."FDA_FOOD"."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```
