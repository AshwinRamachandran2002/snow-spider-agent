--Description: 8)  Compute "industry_code_length" and "brand_name_length"
--                (using placeholder technique to cleanse brand names first)
SELECT
    "report_number",
    -- industry_code_length
    ARRAY_SIZE(
        SPLIT(REGEXP_REPLACE("products_industry_code", ',\\s', ' -- '), ' -- ')
    ) AS "industry_code_length",
    -- brand_name_length (placeholder 3-step approach)
    ARRAY_SIZE(
        SPLIT(
