Query:
--Description: 8)  Compute "industry_code_length" and "brand_name_length"
--             using the placeholder method for brand names to preserve digit-comma-digit
--             patterns, then splitting on " -- " to count the items.  Shows 20 rows
--             for events where both dates are in January 2015.
SELECT
    "report_number",
    /* ---- industry_code_length ---- */
    ARRAY_SIZE(
        SPLIT(
            REGEXP_REPLACE("products_industry_code", ',\\s', ' -- '),
            ' -- '
        )
    ) AS "industry_code_length",
    /* ---- brand_name_length (3-step placeholder technique) ---- */
    ARRAY_SIZE(
        SPLIT(
            REGEXP_REPLACE(                                           /* Step-3 restore */
                REGEXP_REPLACE(                                       /* Step-2 replace */
                    REGEXP_REPLACE("products_brand_name",             /* Step-1 protect */
                                   '([0-9]),\\s([0-9])',
                                   '\\1§\\2'),
                    ',\\s',
                    ' -- '
                ),
                '([0-9])§([0-9])',
                '\\1, \\2'
            ),
            ' -- '
        )
    ) AS "brand_name_length"
FROM "FDA"."FDA_FOOD"."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20
