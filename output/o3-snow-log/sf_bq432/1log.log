Query:
--Description: 9)  Consolidated query returning cleansed arrays, brand name, industry
--             fields, and the derived length metrics for January 2015 events.  Fixes
--             the earlier quote typo on "products_industry_name".
SELECT
    "report_number",
    SPLIT("reactions", ',')  AS "reaction_array",
    SPLIT("outcomes",  ',')  AS "outcome_array",

    /* clean brand name (3-step placeholder) */
    REGEXP_REPLACE(
        REGEXP_REPLACE(
            REGEXP_REPLACE("products_brand_name",
                           '([0-9]),\\s([0-9])', '\\1§\\2'),
            ',\\s', ' -- '
        ),
        '([0-9])§([0-9])', '\\1, \\2'
    ) AS "clean_brand_name",

    /* other list fields */
    REGEXP_REPLACE("products_industry_code", ',\\s', ' -- ') AS "clean_industry_code",
    REGEXP_REPLACE("products_role",         ',\\s', ' -- ') AS "clean_role",
    REGEXP_REPLACE("products_industry_name",',\\s', ' -- ') AS "clean_industry_name",

    /* length metrics */
    ARRAY_SIZE(
        SPLIT(REGEXP_REPLACE("products_industry_code", ',\\s', ' -- '), ' -- ')
    ) AS "industry_code_length",
    ARRAY_SIZE(
        SPLIT(
            REGEXP_REPLACE(
                REGEXP_REPLACE(
                    REGEXP_REPLACE("products_brand_name",
                                   '([0-9]),\\s([0-9])', '\\1§\\2'),
                    ',\\s', ' -- '
                ),
                '([0-9])§([0-9])', '\\1, \\2'
            ),
            ' -- '
        )
    ) AS "brand_name_length",

    "date_created",
    "date_started",
    "consumer_gender",
    "consumer_age",
    "consumer_age_unit"
FROM "FDA"."FDA_FOOD"."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20
