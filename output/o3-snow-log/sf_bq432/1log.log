--             and date_started fall between 01-Jan-2015 and 31-Jan-2015.
--             Processing rules applied inside this single query:
--             • reactions / outcomes  → split on “,” to arrays.
--             • products_brand_name  → 3-step placeholder method to keep digit ,␣ digit
--               intact, otherwise change “, ” to “ -- ”.  Result exposed as clean_brand_name
--               and used to compute brand_name_length (array length after split).
--             • products_industry_code / products_role / products_industry_name
--               → direct replacement of every literal “, ” with “ -- ”; the cleansed
--               code string is then split to compute industry_code_length.
--             Limit output to 20 sample rows.
SELECT
    "report_number",
    /* arrays -------------------------------------------------------------*/
    SPLIT("reactions", ',')                         AS "reaction_array",
    SPLIT("outcomes",  ',')                         AS "outcome_array",

    /* ------- brand name cleansing (3-step placeholder) -----------------*/
    REGEXP_REPLACE(                                               /* Step-3 restore */
        REGEXP_REPLACE(                                           /* Step-2 replace */
            REGEXP_REPLACE("products_brand_name",                 /* Step-1 protect */
                           '([0-9]),\\s([0-9])',
                           '\\1§\\2'),
            ',\\s',
            ' -- '
        ),
        '([0-9])§([0-9])',
        '\\1, \\2'
    ) AS "clean_brand_name",

    /* ------- other list fields -----------------------------------------*/
    REGEXP_REPLACE("products_industry_code", ',\\s', ' -- ') AS "clean_industry_code",
    REGEXP_REPLACE("products_role",         ',\\s', ' -- ') AS "clean_role",
    REGEXP_REPLACE("products_industry_name",',\\s', ' -- ') AS "clean_industry_name",

    /* ------- derived counts --------------------------------------------*/
    ARRAY_SIZE(
        SPLIT(REGEXP_REPLACE("products_industry_code", ',\\s', ' -- '), ' -- ')
    ) AS "industry_code_length",

    ARRAY_SIZE(
        SPLIT(
            REGEXP_REPLACE(                                       /* Step-3 restore */
                REGEXP_REPLACE(                                   /* Step-2 replace */
                    REGEXP_REPLACE("products_brand_name",         /* Step-1 protect */
                                   '([0-9]),\\s([0-9])',
                                   '\\1§\\2'),
                    ',\\s', ' -- '
                ),
                '([0-9])§([0-9])', '\\1, \\2'
            ),
            ' -- '
        )
    ) AS "brand_name_length",

    /* raw date / demographic columns ------------------------------------*/
    "date_created",
    "date_started",
    "consumer_gender",
    "consumer_age",
    "consumer_age_unit"
FROM "FDA"."FDA_FOOD"."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```
