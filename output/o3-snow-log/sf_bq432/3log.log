       "report_number",
       SPLIT("reactions", ',')                        AS "reactions_arr",
       ARRAY_SIZE(SPLIT("reactions", ','))            AS "reactions_len",
       SPLIT("outcomes", ',')                         AS "outcomes_arr",
       ARRAY_SIZE(SPLIT("outcomes", ','))             AS "outcomes_len",
       REGEXP_REPLACE("products_brand_name",
                      '([0-9]), ([0-9])', '\\1@@\\2')         -- temporarily protect digit,comma,digit
