```sql
--Description: Cleanse “products_brand_name” for January-2015 records while preserving
--             digit-comma-digit (e.g., “50,000”) patterns.
-- THINKING PROCESS
--   • Step-1  Safeguard numeric-comma-numeric by swapping that comma with a placeholder
--             using REGEXP_REPLACE: '([0-9])\\s*,\\s*([0-9])'  →  '\1<<comma>>\2'.
--   • Step-2  Convert every remaining “, ” (comma + spaces) into “ -- ”.
--   • Step-3  Restore the placeholder back to a real comma.
--   • Output  Original and cleansed brand names for comparison.
SELECT  "report_number",
        "products_brand_name"                                                   AS "brand_original",
        REGEXP_REPLACE(                                                         -- Step-3
            REGEXP_REPLACE(                                                     -- Step-2
                REGEXP_REPLACE("products_brand_name",
                               '([0-9])\\s*,\\s*([0-9])', '\\1<<comma>>\\2'),   -- Step-1
                ',\\s+', ' -- '),
            '<<comma>>', ',')                                                   AS "brand_cleansed"
FROM    "FDA"."FDA_FOOD"."FOOD_EVENTS"
WHERE   "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND   "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```
