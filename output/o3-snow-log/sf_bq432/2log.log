Query:
--Description: 7) Replace every “, ” with “ -- ” in industry-related fields 
--             (industry code, role, and name) so that composite values stay intact.
SELECT  "report_number",
        REGEXP_REPLACE("products_industry_code", ',\\s+', ' -- ')  AS "industry_code_cleansed",
        REGEXP_REPLACE("products_role",         ',\\s+', ' -- ')  AS "products_role_cleansed",
        REGEXP_REPLACE("products_industry_name",',\\s+', ' -- ')  AS "industry_name_cleansed"
FROM    "FDA"."FDA_FOOD"."FOOD_EVENTS"
WHERE   "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND   "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20
