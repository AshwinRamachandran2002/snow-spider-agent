```sql
--Description: 6) Show how “products_brand_name” looks after protecting numeric-comma-numeric
--             patterns AND replacing other “, ” with “ -- ”.
--             The regex keeps a comma when it sits between two digits; all other ", "
--             become " -- ".
SELECT "report_number",
       "products_brand_name"                                   AS "brand_original",
       REGEXP_REPLACE("products_brand_name",
                     '(?<!\\d),\\s+(?!=\\d)', ' -- ')          AS "brand_cleansed"
FROM "FDA"."FDA_FOOD"."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```

```sql
--Description: 7) Replace every “, ” with “ -- ” in industry-related fields
--             (industry code, role, and name) so that composite values stay intact.
SELECT "report_number",
       REGEXP_REPLACE("products_industry_code", ',\\s+', ' -- ')  AS "industry_code_cleansed",
       REGEXP_REPLACE("products_role",         ',\\s+', ' -- ')  AS "products_role_cleansed",
       REGEXP_REPLACE("products_industry_name",',\\s+', ' -- ')  AS "industry_name_cleansed"
FROM "FDA"."FDA_FOOD"."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```

```sql
--Description: 8) Compute “industry_code_length” and “brand_name_length”
--             after the cleansing rules have been applied.
SELECT "report_number",
       ARRAY_SIZE(SPLIT(REGEXP_REPLACE("products_industry_code", ',\\s+', ' -- '), ' -- '))
           AS "industry_code_length",
