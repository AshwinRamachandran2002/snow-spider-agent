--Description: 4) Flatten the reactions array to list each reaction on its own row
--             (handy for later analysis).
SELECT t."report_number",
       TRIM(f.value::STRING)              AS "reaction_item"
FROM "FDA"."FDA_FOOD"."FOOD_EVENTS" t,
     LATERAL FLATTEN(input => SPLIT(t."reactions", ',')) f
WHERE t."date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND t."date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
