Query:
--Description: 9) Produce arrays for reactions, outcomes, cleansed brand names,
--             and cleansed industry codes using the safe placeholder approach.
SELECT  "report_number",
        SPLIT("reactions", ',')                                           AS "reactions_array",
        SPLIT("outcomes",  ',')                                           AS "outcomes_array",
        SPLIT(
            REGEXP_REPLACE(                                               -- restore placeholder
                REGEXP_REPLACE(                                           -- change other ", "
                    REGEXP_REPLACE("products_brand_name",
                                   '([0-9])\\s*,\\s*([0-9])',
                                   '\\1<<comma>>\\2'),                   -- protect numeric commas
                    ',\\s+', ' -- '),
                '<<comma>>', ',')
        , ' -- ')                                                         AS "brand_array",
        SPLIT(
            REGEXP_REPLACE("products_industry_code", ',\\s+', ' -- ')
        , ' -- ')                                                         AS "industry_code_array"
FROM    "FDA"."FDA_FOOD"."FOOD_EVENTS"
WHERE   "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND   "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20
