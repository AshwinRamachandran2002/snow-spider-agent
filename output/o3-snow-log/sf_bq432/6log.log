  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31';
```

```sql
--Description: 4) Inspect raw "reactions" and how they split into an array  
SELECT "report_number",
       "reactions",
       SPLIT("reactions", ',')         AS "reactions_array"
FROM FDA.FDA_FOOD."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```

```sql
--Description: 5) Inspect raw "outcomes" and its array version  
SELECT "report_number",
       "outcomes",
       SPLIT("outcomes", ',')          AS "outcomes_array"
FROM FDA.FDA_FOOD."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```

```sql
--Description: 6) Show brand-name cleansing logic (preserve 1,000-style numbers, replace other “, ” with “ -- ”)  
SELECT "report_number",
       "products_brand_name",
       REPLACE(
         REGEXP_REPLACE("products_brand_name", '(\\d),(\\d)', '\\1\\2'),
         ', ',
         ' -- '
       )                                 AS "brand_clean",
       ARRAY_SIZE(
         SPLIT(
           REPLACE(
             REGEXP_REPLACE("products_brand_name", '(\\d),(\\d)', '\\1\\2'),
             ', ',
             ' -- '
           ),
           ' -- '
         )
       )                                 AS "brand_name_length"
FROM FDA.FDA_FOOD."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```

```sql
--Description: 7) Show industry-code cleansing & resulting length  
SELECT "report_number",
       "products_industry_code",
       REPLACE("products_industry_code", ', ', ' -- ')              AS "industry_code_clean",
       ARRAY_SIZE(SPLIT(REPLACE("products_industry_code", ', ', ' -- '), ' -- ')) 
                                                                    AS "industry_code_length"
FROM FDA.FDA_FOOD."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```

```sql
--Description: 8) Verify cleansing for role & industry-name fields  
SELECT "report_number",
       "products_role",
       "products_industry_name",
       REPLACE("products_role",          ', ', ' -- ') AS "role_clean",
       REPLACE("products_industry_name", ', ', ' -- ') AS "industry_name_clean"
FROM FDA.FDA_FOOD."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```

```sql
--Description: 9) Final query – all requested cleansing steps & calculated lengths for Jan 1–31 2015  
SELECT
       "report_number",
       "date_created",
       "date_started",
       SPLIT("reactions", ',')                                            AS "reactions_array",
       SPLIT("outcomes",  ',')                                            AS "outcomes_array",
       /* brand name cleansing */
       REPLACE(
         REGEXP_REPLACE("products_brand_name", '(\\d),(\\d)', '\\1\\2'),
         ', ',
         ' -- '
       )                                                                  AS "products_brand_name_clean",
       ARRAY_SIZE(
         SPLIT(
           REPLACE(
             REGEXP_REPLACE("products_brand_name", '(\\d),(\\d)', '\\1\\2'),
             ', ',
             ' -- '
           ),
           ' -- '
         )
       )                                                                  AS "brand_name_length",
       /* industry code cleansing */
       REPLACE("products_industry_code", ', ', ' -- ')                    AS "products_industry_code_clean",
       ARRAY_SIZE(
         SPLIT(REPLACE("products_industry_code", ', ', ' -- '), ' -- ')
       )                                                                  AS "industry_code_length",
       /* role & industry name cleansing */
       REPLACE("products_role",          ', ', ' -- ')                    AS "products_role_clean",
       REPLACE("products_industry_name", ', ', ' -- ')                    AS "products_industry_name_clean",
       /* keep other useful columns */
       "consumer_gender",
       "consumer_age",
       "consumer_age_unit"
FROM FDA.FDA_FOOD."FOOD_EVENTS"
WHERE "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT 20;
```
