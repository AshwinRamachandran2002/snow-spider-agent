                                                                    AS "brand_name_length"
FROM   FDA.FDA_FOOD.FOOD_EVENTS
WHERE  "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND  "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT  20;
```

```sql
--Description: Cleanse industry codes the same way and calculate how many codes are listed  
SELECT "report_number",
       REGEXP_REPLACE("products_industry_code", ',\\s+', ' -- ')        AS "industry_code_clean",
       ARRAY_SIZE(SPLIT(REGEXP_REPLACE("products_industry_code", ',\\s+', ' -- '), ' -- '))
                                                                        AS "industry_code_length"
FROM   FDA.FDA_FOOD.FOOD_EVENTS
WHERE  "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND  "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT  20;
```

```sql
--Description: Final comprehensive query applying all cleansing rules, plus computed lengths; reactions & outcomes are split to arrays  
SELECT "report_number",
       "date_created",
       "date_started",
       SPLIT("reactions", ',')                                            AS "reactions_array",
       SPLIT("outcomes",  ',')                                            AS "outcomes_array",
       REGEXP_REPLACE("products_brand_name", ',\\s+', ' -- ')             AS "brand_name_clean",
       ARRAY_SIZE(SPLIT(REGEXP_REPLACE("products_brand_name", ',\\s+', ' -- '), ' -- '))
                                                                          AS "brand_name_length",
       REGEXP_REPLACE("products_industry_code", ',\\s+', ' -- ')          AS "industry_code_clean",
       ARRAY_SIZE(SPLIT(REGEXP_REPLACE("products_industry_code", ',\\s+', ' -- '), ' -- '))
                                                                          AS "industry_code_length",
       REGEXP_REPLACE("products_role",          ',\\s+', ' -- ')          AS "products_role_clean",
       REGEXP_REPLACE("products_industry_name", ',\\s+', ' -- ')          AS "industry_name_clean"
FROM   FDA.FDA_FOOD.FOOD_EVENTS
WHERE  "date_created" BETWEEN '2015-01-01' AND '2015-01-31'
  AND  "date_started" BETWEEN '2015-01-01' AND '2015-01-31'
LIMIT  20;
```

