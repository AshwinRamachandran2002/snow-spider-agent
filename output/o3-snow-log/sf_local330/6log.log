```sql
--Description: Inspect a few rows in the activity log to understand the basic columns we will use
SELECT 
    "stamp",
    "session",
    "action",
    "option",
    "path"
FROM LOG.LOG.ACTIVITY_LOG
LIMIT 20;
```

```sql
--Description: List distinct page paths that appear in the log
SELECT DISTINCT 
    "path"
FROM LOG.LOG.ACTIVITY_LOG
LIMIT 20;
```

```sql
--Description: Show a sample of sessions together with their earliest and latest time-stamps   
SELECT
    "session",
    MIN("stamp") AS "first_stamp",
    MAX("stamp") AS "last_stamp"
FROM LOG.LOG.ACTIVITY_LOG
GROUP BY "session"
LIMIT 20;
```

```sql
--Description: Derive the landing page (earliest page per session) for each session
SELECT
    "session",
    "path"  AS "landing_path",
    "stamp" AS "landing_stamp"
FROM LOG.LOG.ACTIVITY_LOG
QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" ASC) = 1
LIMIT 20;
```

```sql
--Description: Derive the exit page (latest page per session) for each session
SELECT
    "session",
    "path"  AS "exit_path",
    "stamp" AS "exit_stamp"
FROM LOG.LOG.ACTIVITY_LOG
QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) = 1
LIMIT 20;
```

```sql
--Description: Combine landing and exit pages so each session-page pair appears once
WITH landing AS (
    SELECT "session", "path"
    FROM LOG.LOG.ACTIVITY_LOG
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") = 1
),
exit AS (
    SELECT "session", "path"
    FROM LOG.LOG.ACTIVITY_LOG
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) = 1
)
SELECT DISTINCT
    l."session",
    l."path" AS "page"
FROM landing l
UNION
SELECT DISTINCT
    e."session",
    e."path" AS "page"
FROM exit e
LIMIT 20;
```

```sql
--Description: Count unique sessions for every page when the page is landing and/or exit
WITH landing AS (
    SELECT "session", "path"
    FROM LOG.LOG.ACTIVITY_LOG
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") = 1
),
exit AS (
    SELECT "session", "path"
    FROM LOG.LOG.ACTIVITY_LOG
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) = 1
),
union_se AS (
    SELECT DISTINCT "session", "path" FROM landing
    UNION
    SELECT DISTINCT "session", "path" FROM exit
)
SELECT
    "path"             AS "page",
    COUNT(DISTINCT "session") AS "unique_sessions"
FROM union_se
GROUP BY "path"
ORDER BY "unique_sessions" DESC
LIMIT 20;
```

```sql
--Description: Display only those pages that acted both as landing and exit for the same session
WITH landing AS (
    SELECT "session", "path" AS "landing_path"
    FROM LOG.LOG.ACTIVITY_LOG
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") = 1
),
exit AS (
    SELECT "session", "path" AS "exit_path"
    FROM LOG.LOG.ACTIVITY_LOG
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) = 1
)
SELECT
    l."session",
    l."landing_path" AS "page"
FROM landing l
JOIN exit e
  ON l."session" = e."session"
 AND l."landing_path" = e."exit_path"
LIMIT 20;
```

```sql
--Description: Count unique sessions per page where the page was both landing and exit
WITH landing AS (
    SELECT "session", "path"
    FROM LOG.LOG.ACTIVITY_LOG
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") = 1
),
exit AS (
    SELECT "session", "path"
    FROM LOG.LOG.ACTIVITY_LOG
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) = 1
),
both AS (
    SELECT l."session", l."path"
    FROM landing l
    JOIN exit e
      ON l."session" = e."session"
     AND l."path"    = e."path"
)
SELECT
    "path" AS "page",
    COUNT(DISTINCT "session") AS "unique_sessions_both"
FROM both
GROUP BY "path"
ORDER BY "unique_sessions_both" DESC
LIMIT 20;
```

```sql
--Description: Produce the final complete table of pages with total unique sessions considering landing OR exit (one row per page)
WITH landing AS (
    SELECT "session", "path"
    FROM LOG.LOG.ACTIVITY_LOG
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") = 1
),
exit AS (
    SELECT "session", "path"
    FROM LOG.LOG.ACTIVITY_LOG
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) = 1
),
union_se AS (
    SELECT DISTINCT "session", "path" FROM landing
    UNION
    SELECT DISTINCT "session", "path" FROM exit
)
SELECT
    "path" AS "page",
    COUNT(DISTINCT "session") AS "total_unique_sessions_landing_or_exit"
FROM union_se
GROUP BY "path"
ORDER BY "total_unique_sessions_landing_or_exit" DESC;
```
