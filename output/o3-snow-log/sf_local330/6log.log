Query:
--Description: Combine landing and exit pages so each session-page pair appears once
WITH landing AS (
    SELECT "session", "path"
    FROM LOG.LOG.ACTIVITY_LOG
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") = 1
),
exit AS (
    SELECT "session", "path"
    FROM LOG.LOG.ACTIVITY_LOG
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) = 1
)
SELECT DISTINCT
    l."session",
    l."path" AS "page"
FROM landing l
UNION
SELECT DISTINCT
    e."session",
    e."path" AS "page"
FROM exit e
LIMIT 20;
