```sql
-- Description: 1) Quick look at the list of different page paths recorded in the activity log
SELECT DISTINCT "path"
FROM   LOG.LOG.ACTIVITY_LOG
LIMIT  20;
```

```sql
-- Description: 2) Inspect time-series order of page views inside sessions
SELECT "session",
       "stamp",
       "path",
       "action",
       "option"
FROM   LOG.LOG.ACTIVITY_LOG
ORDER  BY "session",
          "stamp"
LIMIT  20;
```

```sql
-- Description: 3) For every row, attach ordinal position of the page inside its session
WITH ordered AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp")  AS rn_asc,
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) AS rn_desc
  FROM   LOG.LOG.ACTIVITY_LOG
)
SELECT "session",
       "stamp",
       "path",
       rn_asc  AS "rank_from_start",
       rn_desc AS "rank_from_end"
FROM   ordered
ORDER  BY "session",
          rn_asc
LIMIT  20;
```

```sql
-- Description: 4) Pick only landing pages (first page of each session)
WITH first_page AS (
  SELECT *
  FROM  (
        SELECT "session",
               "path",
               ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") AS rn
        FROM   LOG.LOG.ACTIVITY_LOG
       )
  WHERE  rn = 1
)
SELECT *
FROM   first_page
LIMIT  20;
```

```sql
-- Description: 5) Pick only exit pages (last page of each session)
WITH last_page AS (
  SELECT *
  FROM  (
        SELECT "session",
               "path",
               ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) AS rn
        FROM   LOG.LOG.ACTIVITY_LOG
       )
  WHERE  rn = 1
)
SELECT *
FROM   last_page
LIMIT  20;
```

```sql
-- Description: 6) Combine landing and exit pages, but keep one record per (session, path)
WITH first_page AS (
  SELECT "session",
         "path"
  FROM  (
        SELECT "session",
               "path",
               ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") AS rn
        FROM   LOG.LOG.ACTIVITY_LOG
       )
  WHERE  rn = 1
),
last_page AS (
  SELECT "session",
         "path"
  FROM  (
        SELECT "session",
               "path",
               ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) AS rn
        FROM   LOG.LOG.ACTIVITY_LOG
       )
  WHERE  rn = 1
)
SELECT DISTINCT *
FROM   (
        SELECT * FROM first_page
        UNION ALL
        SELECT * FROM last_page
       )
LIMIT  20;
```

```sql
-- Description: 7) Count, for each page, unique sessions in which the page is a landing OR exit page (count each session once per page)
WITH first_page AS (
  SELECT "session",
         "path"
  FROM  (
        SELECT "session",
               "path",
               ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") AS rn
        FROM   LOG.LOG.ACTIVITY_LOG
       )
  WHERE  rn = 1
),
last_page AS (
  SELECT "session",
         "path"
  FROM  (
        SELECT "session",
               "path",
               ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) AS rn
        FROM   LOG.LOG.ACTIVITY_LOG
       )
  WHERE  rn = 1
),
landing_exit_union AS (
  SELECT * FROM first_page
  UNION ALL
  SELECT * FROM last_page
),
dedup AS (
  SELECT DISTINCT "session",
                  "path"
  FROM   landing_exit_union
)
SELECT "path",
       COUNT(DISTINCT "session") AS "unique_sessions_landing_or_exit"
FROM   dedup
GROUP  BY "path"
ORDER  BY "unique_sessions_landing_or_exit" DESC
LIMIT  20;
```

```sql
-- Description: 8) Same as query 7 but showing the complete list without LIMIT, useful for exporting final answer
WITH first_page AS (
  SELECT "session",
         "path"
  FROM  (
        SELECT "session",
               "path",
               ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp") AS rn
        FROM   LOG.LOG.ACTIVITY_LOG
       )
  WHERE  rn = 1
),
last_page AS (
  SELECT "session",
         "path"
  FROM  (
        SELECT "session",
               "path",
               ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) AS rn
        FROM   LOG.LOG.ACTIVITY_LOG
       )
  WHERE  rn = 1
),
combined AS (
  SELECT * FROM first_page
  UNION ALL
  SELECT * FROM last_page
),
dedup AS (
  SELECT DISTINCT "session",
                  "path"
  FROM   combined
)
SELECT "path",
       COUNT(DISTINCT "session") AS "unique_sessions_landing_or_exit"
FROM   dedup
GROUP  BY "path"
ORDER  BY "unique_sessions_landing_or_exit" DESC;
```

```sql
-- Description: 9) Check sessions where the same page is simultaneously both landing and exit
WITH ranked AS (
  SELECT "session",
         "path",
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp")        AS rn_start,
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC)   AS rn_end
  FROM   LOG.LOG.ACTIVITY_LOG
),
both AS (
  SELECT "session",
         "path"
  FROM   ranked
  WHERE  rn_start = 1
  INTERSECT
  SELECT "session",
         "path"
  FROM   ranked
  WHERE  rn_end = 1
)
SELECT *
FROM   both
LIMIT  20;
```

```sql
-- Description: 10) For pages that were ever both landing AND exit in the same session, count such sessions
WITH ranked AS (
  SELECT "session",
         "path",
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp")        AS rn_start,
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC)   AS rn_end
  FROM   LOG.LOG.ACTIVITY_LOG
),
both AS (
  SELECT "session",
         "path"
  FROM   ranked
  WHERE  rn_start = 1
  INTERSECT
  SELECT "session",
         "path"
  FROM   ranked
  WHERE  rn_end = 1
)
SELECT "path",
       COUNT(DISTINCT "session") AS "sessions_both_landing_and_exit"
FROM   both
GROUP  BY "path"
ORDER  BY "sessions_both_landing_and_exit" DESC
LIMIT  20;
```
