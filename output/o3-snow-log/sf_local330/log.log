-- Description: 3) For every row, attach ordinal position of the page inside its session
WITH ordered AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp")  AS rn_asc,
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) AS rn_desc
  FROM   LOG.LOG.ACTIVITY_LOG
)
SELECT "session",
       "stamp",
       "path",
       rn_asc  AS "rank_from_start",
       rn_desc AS "rank_from_end"
FROM   ordered
ORDER  BY "session",
          rn_asc
LIMIT  20;
