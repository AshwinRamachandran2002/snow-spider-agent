  WHERE  rn_start = 1
  INTERSECT
  SELECT "session",
         "path"
  FROM   ranked
  WHERE  rn_end = 1
)
SELECT "path",
       COUNT(DISTINCT "session") AS "sessions_both_landing_and_exit"
FROM   both
GROUP  BY "path"
ORDER  BY "sessions_both_landing_and_exit" DESC
LIMIT  20;
