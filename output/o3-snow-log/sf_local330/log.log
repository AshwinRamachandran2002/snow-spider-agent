Query:
-- Description: 10) For pages that were ever both landing AND exit in the same session, count such sessions
WITH ranked AS (
  SELECT "session",
         "path",
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp")        AS rn_start,
         ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC)   AS rn_end
  FROM   LOG.LOG.ACTIVITY_LOG
),
both AS (
  SELECT "session",
         "path"
  FROM   ranked
  WHERE  rn_start = 1
  INTERSECT
  SELECT "session",
         "path"
  FROM   ranked
  WHERE  rn_end = 1
)
SELECT "path",
       COUNT(DISTINCT "session") AS "sessions_both_landing_and_exit"
FROM   both
GROUP  BY "path"
ORDER  BY "sessions_both_landing_and_exit" DESC
LIMIT  20;
