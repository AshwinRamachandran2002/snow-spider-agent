```sql
--Description: Fetch the landing page (first path by stamp) for every session  
WITH ranked AS (  
    SELECT
        "session",
        "path",
        "stamp",
        ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" ASC) AS rn
    FROM "LOG"."LOG"."ACTIVITY_LOG"
)
SELECT
    "session",
    "path"  AS "landing_path",
    "stamp"
FROM ranked
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Fetch the exit page (last path by stamp) for every session  
WITH ranked AS (  
    SELECT
        "session",
        "path",
        "stamp",
        ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) AS rn
    FROM "LOG"."LOG"."ACTIVITY_LOG"
)
SELECT
    "session",
    "path"  AS "exit_path",
    "stamp"
FROM ranked
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Show both landing and exit pages side-by-side for each session  
WITH landing AS (  
    SELECT
        "session",
        "path" AS "landing_path"
    FROM (
        SELECT
            "session",
            "path",
            ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" ASC) AS rn
        FROM "LOG"."LOG"."ACTIVITY_LOG"
    )
    WHERE rn = 1
), exit_page AS (  
    SELECT
        "session",
        "path" AS "exit_path"
    FROM (
        SELECT
            "session",
            "path",
            ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) AS rn
        FROM "LOG"."LOG"."ACTIVITY_LOG"
    )
    WHERE rn = 1
)
SELECT
    l."session",
    l."landing_path",
    e."exit_path"
FROM landing l
LEFT JOIN exit_page e
  ON l."session" = e."session"
LIMIT 20;
```

```sql
--Description: Produce a de-duplicated list of (session, page) pairs where the page is either landing OR exit  
WITH landing AS (  
    SELECT
        "session",
        "path"
    FROM (
        SELECT
            "session",
            "path",
            ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" ASC) AS rn
        FROM "LOG"."LOG"."ACTIVITY_LOG"
    )
    WHERE rn = 1
), exit_page AS (  
    SELECT
        "session",
        "path"
    FROM (
        SELECT
            "session",
            "path",
            ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) AS rn
        FROM "LOG"."LOG"."ACTIVITY_LOG"
    )
    WHERE rn = 1
)
SELECT DISTINCT
    "session",
    "path"
FROM landing
UNION
SELECT DISTINCT
    "session",
    "path"
FROM exit_page
LIMIT 20;
```

```sql
--Description: Identify sessions whose landing and exit page are identical  
WITH landing AS (  
    SELECT
        "session",
        "path"
    FROM (
        SELECT
            "session",
            "path",
            ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" ASC) AS rn
        FROM "LOG"."LOG"."ACTIVITY_LOG"
    )
    WHERE rn = 1
), exit_page AS (  
    SELECT
        "session",
        "path"
    FROM (
        SELECT
            "session",
            "path",
            ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) AS rn
        FROM "LOG"."LOG"."ACTIVITY_LOG"
    )
    WHERE rn = 1
)
SELECT
    l."session",
    l."path"  AS "landing_and_exit_path"
FROM landing l
JOIN exit_page e
  ON l."session" = e."session"
 AND l."path"    = e."path"
LIMIT 20;
```

```sql
--Description: Final answer query – count unique sessions per page where the page is a landing OR exit (session counted once per page)  
WITH landing AS (  
    SELECT
        "session",
        "path"
    FROM (
        SELECT
            "session",
            "path",
            ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" ASC) AS rn
        FROM "LOG"."LOG"."ACTIVITY_LOG"
    )
    WHERE rn = 1
), exit_page AS (  
    SELECT
        "session",
        "path"
    FROM (
        SELECT
            "session",
            "path",
            ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" DESC) AS rn
        FROM "LOG"."LOG"."ACTIVITY_LOG"
    )
    WHERE rn = 1
), combined AS (  
    SELECT * FROM landing
    UNION
    SELECT * FROM exit_page
)
SELECT
    "path",
    COUNT(DISTINCT "session") AS "unique_sessions"
FROM combined
GROUP BY "path"
ORDER BY "unique_sessions" DESC
LIMIT 20;
```
