--Description: Fetch the landing page (first path by stamp) for every session  
WITH ranked AS (  
    SELECT
        "session",
        "path",
        "stamp",
        ROW_NUMBER() OVER (PARTITION BY "session" ORDER BY "stamp" ASC) AS rn
    FROM "LOG"."LOG"."ACTIVITY_LOG"
)
SELECT
    "session",
    "path"  AS "landing_path",
    "stamp"
FROM ranked
WHERE rn = 1
LIMIT 20;
