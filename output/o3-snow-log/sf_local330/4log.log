Query:
-- 9) Description: Same as (8) but also shows whether each page is ever a landing page, an exit page, or both
WITH stamps AS (
  SELECT "session",
         MIN("stamp") AS "first_stamp",
         MAX("stamp") AS "last_stamp"
  FROM   "LOG"."LOG"."ACTIVITY_LOG"
  GROUP  BY "session"
),
roles AS (
  SELECT DISTINCT a."session",
         a."path",
         CASE
           WHEN a."stamp" = s."first_stamp" AND a."stamp" = s."last_stamp" THEN 'both'
           WHEN a."stamp" = s."first_stamp" THEN 'landing'
           ELSE 'exit'
         END AS "role"
  FROM   "LOG"."LOG"."ACTIVITY_LOG" a
  JOIN   stamps s
    ON   a."session" = s."session"
   AND  (a."stamp" = s."first_stamp" OR a."stamp" = s."last_stamp")
)
SELECT "path",
       COUNT(DISTINCT "session")          AS "unique_sessions",
       COUNT_IF("role" = 'landing')       AS "landing_counts",
       COUNT_IF("role" = 'exit')          AS "exit_counts",
       COUNT_IF("role" = 'both')          AS "both_counts"
FROM   roles
GROUP  BY "path"
ORDER  BY "unique_sessions" DESC
LIMIT  20;
Answer:
path,unique_sessions,landing_counts,exit_counts,both_counts
