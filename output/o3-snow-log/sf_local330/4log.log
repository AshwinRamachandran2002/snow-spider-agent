SELECT DISTINCT "path"
FROM   "LOG"."LOG"."ACTIVITY_LOG"
LIMIT  20;
```

```sql
-- 3) Description: Distinct user-sessions recorded in the log
SELECT DISTINCT "session"
FROM   "LOG"."LOG"."ACTIVITY_LOG"
LIMIT  20;
```

```sql
-- 4) Description: For each session, show the earliest and latest time-stamp strings
SELECT "session",
       MIN("stamp") AS "first_stamp",
       MAX("stamp") AS "last_stamp"
FROM   "LOG"."LOG"."ACTIVITY_LOG"
GROUP  BY "session"
LIMIT  20;
```

```sql
-- 5) Description: Landing pages (first page in a session); one row per session
WITH first_by_session AS (
  SELECT "session",
         MIN("stamp") AS "first_stamp"
  FROM   "LOG"."LOG"."ACTIVITY_LOG"
  GROUP  BY "session"
)
SELECT a."session",
       a."path"  AS "landing_page",
       a."stamp"
FROM   "LOG"."LOG"."ACTIVITY_LOG" a
JOIN   first_by_session f
  ON   a."session" = f."session"
 AND   a."stamp"   = f."first_stamp"
LIMIT  20;
```

```sql
-- 6) Description: Exit pages (last page in a session); one row per session
WITH last_by_session AS (
  SELECT "session",
         MAX("stamp") AS "last_stamp"
  FROM   "LOG"."LOG"."ACTIVITY_LOG"
  GROUP  BY "session"
)
SELECT a."session",
       a."path"  AS "exit_page",
       a."stamp"
FROM   "LOG"."LOG"."ACTIVITY_LOG" a
JOIN   last_by_session l
  ON   a."session" = l."session"
 AND   a."stamp"   = l."last_stamp"
LIMIT  20;
```

```sql
-- 7) Description: Union of landing and exit pages – keep one record per session-page pair
WITH first_last AS (
  SELECT "session",
         MIN("stamp") AS "first_stamp",
         MAX("stamp") AS "last_stamp"
  FROM   "LOG"."LOG"."ACTIVITY_LOG"
  GROUP  BY "session"
)
SELECT DISTINCT a."session",
       a."path"
FROM   "LOG"."LOG"."ACTIVITY_LOG" a
JOIN   first_last f
  ON   a."session" = f."session"
 AND  (a."stamp" = f."first_stamp"
       OR a."stamp" = f."last_stamp")
LIMIT  20;
```

```sql
-- 8) Description: Count how many unique sessions each page serves as landing, exit, or both
WITH first_last AS (
  SELECT "session",
         MIN("stamp") AS "first_stamp",
         MAX("stamp") AS "last_stamp"
  FROM   "LOG"."LOG"."ACTIVITY_LOG"
  GROUP  BY "session"
),
session_pages AS (
  SELECT DISTINCT a."session",
                  a."path"
  FROM   "LOG"."LOG"."ACTIVITY_LOG" a
  JOIN   first_last f
    ON   a."session" = f."session"
   AND  (a."stamp" = f."first_stamp"
         OR a."stamp" = f."last_stamp")
)
SELECT "path",
       COUNT(DISTINCT "session") AS "unique_sessions"
FROM   session_pages
GROUP  BY "path"
ORDER  BY "unique_sessions" DESC
LIMIT  20;
```

```sql
-- 9) Description: Same as (8) but also shows whether each page is ever a landing page, an exit page, or both
WITH stamps AS (
  SELECT "session",
         MIN("stamp") AS "first_stamp",
         MAX("stamp") AS "last_stamp"
  FROM   "LOG"."LOG"."ACTIVITY_LOG"
  GROUP  BY "session"
),
roles AS (
  SELECT DISTINCT a."session",
         a."path",
         CASE
           WHEN a."stamp" = s."first_stamp" AND a."stamp" = s."last_stamp" THEN 'both'
           WHEN a."stamp" = s."first_stamp" THEN 'landing'
           ELSE 'exit'
         END AS "role"
  FROM   "LOG"."LOG"."ACTIVITY_LOG" a
  JOIN   stamps s
    ON   a."session" = s."session"
   AND  (a."stamp" = s."first_stamp" OR a."stamp" = s."last_stamp")
)
SELECT "path",
       COUNT(DISTINCT "session")          AS "unique_sessions",
       COUNT_IF("role" = 'landing')       AS "landing_counts",
       COUNT_IF("role" = 'exit')          AS "exit_counts",
       COUNT_IF("role" = 'both')          AS "both_counts"
FROM   roles
GROUP  BY "path"
ORDER  BY "unique_sessions" DESC
LIMIT  20;
```

```sql
-- 10) Description: Identify pages that are exclusively exit pages (never a landing page)
WITH stamps AS (
  SELECT "session",
         MIN("stamp") AS "first_stamp",
         MAX("stamp") AS "last_stamp"
  FROM   "LOG"."LOG"."ACTIVITY_LOG"
  GROUP  BY "session"
),
roles AS (
  SELECT DISTINCT a."session",
         a."path",
         CASE
           WHEN a."stamp" = s."first_stamp" AND a."stamp" = s."last_stamp" THEN 'both'
           WHEN a."stamp" = s."first_stamp" THEN 'landing'
           ELSE 'exit'
         END AS "role"
  FROM   "LOG"."LOG"."ACTIVITY_LOG" a
  JOIN   stamps s
    ON   a."session" = s."session"
   AND  (a."stamp" = s."first_stamp" OR a."stamp" = s."last_stamp")
)
SELECT "path"
FROM   roles
GROUP  BY "path"
HAVING COUNT_IF("role" = 'landing') = 0   -- never a landing page
ORDER  BY "path"
LIMIT  20;
```
