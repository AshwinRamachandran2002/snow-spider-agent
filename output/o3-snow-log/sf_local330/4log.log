-- 7) Description: Union of landing and exit pages – keep one record per session-page pair
WITH first_last AS (
  SELECT "session",
         MIN("stamp") AS "first_stamp",
         MAX("stamp") AS "last_stamp"
  FROM   "LOG"."LOG"."ACTIVITY_LOG"
  GROUP  BY "session"
)
SELECT DISTINCT a."session",
       a."path"
FROM   "LOG"."LOG"."ACTIVITY_LOG" a
JOIN   first_last f
  ON   a."session" = f."session"
 AND  (a."stamp" = f."first_stamp"
       OR a."stamp" = f."last_stamp")
LIMIT  20;
