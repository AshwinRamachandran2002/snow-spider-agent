FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
LIMIT 20;
```

```sql
--Description:  Search (fuzzy) for the text “feeling-lucky” anywhere in the Sides JSON object
SELECT *
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value::STRING ILIKE '%feeling%lucky%'
LIMIT 20;
```

```sql
--Description:  Search (fuzzy) for the text “momentum” anywhere in the Sides JSON object
SELECT *
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value::STRING ILIKE '%momentum%'
LIMIT 20;
```

```sql
--Description:  Compute the intrinsic value for every trade (LastPx – StrikePrice for LONG, StrikePrice – LastPx for SHORT)  
--              and keep only LONG-side rows to verify the math.
SELECT t."TradeReportID",
       f.value:"Side"::STRING                              AS "Trade_Side",
       (t."LastPx" - t."StrikePrice")                     AS "Intrinsic_Value_RAW"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING ILIKE '%LONG%'
LIMIT 20;
```

```sql
--Description:  Average intrinsic value for LONG-side trades grouped by detected strategy name
SELECT   
       f.value:"Strategy"::STRING                          AS "Strategy_Name",
       AVG(t."LastPx" - t."StrikePrice")                   AS "Avg_Intrinsic_Value_Long"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING ILIKE '%LONG%'
GROUP BY 1
LIMIT 20;
```

```sql
--Description:  Retrieve the two numbers we care about: avg intrinsic for feeling-lucky vs momentum (LONG only)
SELECT
       AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%feeling%lucky%' THEN (t."LastPx" - t."StrikePrice") END) 
           AS "avg_intrinsic_feeling_lucky_long",
       AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%momentum%'      THEN (t."LastPx" - t."StrikePrice") END) 
           AS "avg_intrinsic_momentum_long"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING ILIKE '%LONG%';
```

```sql
--Description:  Final step – how much higher the avg intrinsic value is for feeling-lucky vs momentum on LONG-side trades
SELECT
       AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%feeling%lucky%' THEN (t."LastPx" - t."StrikePrice") END)
       -
       AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%momentum%'      THEN (t."LastPx" - t."StrikePrice") END)
       AS "intrinsic_value_difference_feeling_lucky_vs_momentum_long"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING ILIKE '%LONG%';
```

