```sql
--Description: Average intrinsic value for all LONG-side trades (no reliance on any “Strategy” key)
SELECT
       AVG(t."LastPx" - t."StrikePrice") AS "Avg_Intrinsic_Value_Long"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING ILIKE '%LONG%';
