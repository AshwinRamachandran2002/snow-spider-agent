```sql
--Description: Derive two LONG-side averages based on trader / desk codes found in PartyID:  
--             “MOMO”-prefixed codes (treated here as momentum) versus “PREDICT”-prefixed codes  
--             (treated here as feeling-lucky).  Pattern match is done on the first PartyID in each Sides record.
WITH sides_flat AS (
    SELECT
           t."TradeReportID",
           t."LastPx" - t."StrikePrice"                    AS intrinsic,
           LOWER(p.value:"PartyID"::STRING)                AS party_id,
           f.value:"Side"::STRING                          AS side_flag
    FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
         LATERAL FLATTEN(input => t."Sides")            f,
         LATERAL FLATTEN(input => f.value:"PartyIDs")   p
)
SELECT
       AVG(CASE WHEN party_id ILIKE 'momo%'    AND side_flag ILIKE '%LONG%' THEN intrinsic END)
           AS "avg_intrinsic_momentum_long",
       AVG(CASE WHEN party_id ILIKE 'predict%' AND side_flag ILIKE '%LONG%' THEN intrinsic END)
           AS "avg_intrinsic_feeling_lucky_long"
FROM sides_flat;
```

```sql
--Description: Difference between the two LONG-side averages computed above  
--             (feeling-lucky minus momentum, using the same PartyID pattern criteria)
WITH sides_flat AS (
    SELECT
           t."LastPx" - t."StrikePrice"                    AS intrinsic,
           LOWER(p.value:"PartyID"::STRING)                AS party_id,
           f.value:"Side"::STRING                          AS side_flag
    FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
         LATERAL FLATTEN(input => t."Sides")            f,
         LATERAL FLATTEN(input => f.value:"PartyIDs")   p
)
SELECT
       AVG(CASE WHEN party_id ILIKE 'predict%' AND side_flag ILIKE '%LONG%' THEN intrinsic END)
     - AVG(CASE WHEN party_id ILIKE 'momo%'    AND side_flag ILIKE '%LONG%' THEN intrinsic END)
       AS "intrinsic_value_difference_feeling_lucky_vs_momentum_long"
FROM sides_flat;
```
