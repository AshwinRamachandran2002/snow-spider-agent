```sql
--Description: Show 20 sample LONG–side trades together with the strategy (if present) for a quick sanity-check
SELECT 
    t."TradeReportID",
    f.value:"Side"::STRING     AS "trade_side",
    f.value:"Strategy"::STRING AS "strategy",
    t."LastPx",
    t."StrikePrice"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING = 'LONG'
LIMIT 20;
```

```sql
--Description: Compute the intrinsic value (StrikePrice − LastPx) for each LONG trade and show 20 examples
SELECT 
    t."TradeReportID",
    f.value:"Strategy"::STRING AS "strategy",
    (t."StrikePrice" - t."LastPx") AS "intrinsic_value"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING = 'LONG'
LIMIT 20;
```

```sql
--Description: Calculate average intrinsic value for each strategy (“feeling-lucky” and “momentum”) on LONG-side trades
SELECT
    f.value:"Strategy"::STRING                       AS "strategy",
    AVG(t."StrikePrice" - t."LastPx")                AS "avg_intrinsic_value"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING = 'LONG'
  AND f.value:"Strategy"::STRING IN ('feeling-lucky','momentum')
GROUP BY f.value:"Strategy"
LIMIT 20;
```

```sql
--Description: Return how much higher the average intrinsic value is for “feeling-lucky” versus “momentum” on LONG trades
WITH strategy_avgs AS (
    SELECT
        f.value:"Strategy"::STRING                       AS "strategy",
        AVG(t."StrikePrice" - t."LastPx")                AS "avg_intrinsic_value"
    FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
         LATERAL FLATTEN(input => t."Sides") f
    WHERE f.value:"Side"::STRING = 'LONG'
      AND f.value:"Strategy"::STRING IN ('feeling-lucky','momentum')
    GROUP BY f.value:"Strategy"
)
SELECT
    (MAX(CASE WHEN strategy = 'feeling-lucky' THEN avg_intrinsic_value END) -
     MAX(CASE WHEN strategy = 'momentum'     THEN avg_intrinsic_value END)
    ) AS "avg_intrinsic_value_difference"
FROM strategy_avgs
LIMIT 20;
```

