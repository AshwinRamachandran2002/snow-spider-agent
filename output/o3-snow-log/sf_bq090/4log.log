```sql
--Description: Compute the difference in average intrinsic value between LONG-side and SHORT-side trades
WITH side_avgs AS (
    SELECT
        f.value:"Side"::STRING                 AS side,
        AVG(t."StrikePrice" - t."LastPx")      AS avg_intrinsic_value
    FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
         LATERAL FLATTEN(input => t."Sides") f
    GROUP BY side
)
SELECT
    (MAX(CASE WHEN side = 'LONG'  THEN avg_intrinsic_value END) -
     MAX(CASE WHEN side = 'SHORT' THEN avg_intrinsic_value END)
    ) AS "avg_intrinsic_value_difference"
FROM side_avgs;
```

