LIMIT 20;
```

```sql
--Description: Sample any values whose JSON contains the word “strategy” (fuzzy search)                     --#4
SELECT t."TradeReportID",
       f.value::VARIANT AS "side_variant"
FROM   "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
       LATERAL FLATTEN(input => t."Sides") f
WHERE  f.value::STRING ILIKE '%strategy%'
LIMIT 20;
```

```sql
--Description: Sample trades whose JSON strategy looks like “%momentum%” (case-insensitive)                 --#5
SELECT t."TradeReportID",
       f.value:"Strategy"::STRING  AS "strategy",
       f.value:"Side"::STRING      AS "side",
       t."StrikePrice",
       t."LastPx"
FROM   "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
       LATERAL FLATTEN(input => t."Sides") f
WHERE  f.value:"Strategy"::STRING ILIKE '%momentum%'
LIMIT 20;
```

```sql
--Description: Sample trades whose JSON strategy looks like “%feeling%lucky%”                               --#6
SELECT t."TradeReportID",
       f.value:"Strategy"::STRING  AS "strategy",
       f.value:"Side"::STRING      AS "side",
       t."StrikePrice",
       t."LastPx"
FROM   "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
       LATERAL FLATTEN(input => t."Sides") f
WHERE  f.value:"Strategy"::STRING ILIKE '%feeling%lucky%'
LIMIT 20;
```

```sql
--Description: Calculate intrinsic value (LastPx-StrikePrice) for every long-side trade with any strategy   --#7
SELECT t."TradeReportID",
       f.value:"Strategy"::STRING                  AS "strategy",
       (t."LastPx" - t."StrikePrice")              AS "intrinsic_value"
FROM   "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
       LATERAL FLATTEN(input => t."Sides") f
WHERE  f.value:"Side"::STRING ILIKE '%LONG%'
LIMIT 20;
```

```sql
--Description: Average intrinsic value for “momentum” strategy under LONG side                               --#8
SELECT AVG(t."LastPx" - t."StrikePrice") AS "avg_intrinsic_momentum"
FROM   "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
       LATERAL FLATTEN(input => t."Sides") f
WHERE  f.value:"Side"::STRING ILIKE '%LONG%'
  AND  f.value:"Strategy"::STRING ILIKE '%momentum%';
```

```sql
--Description: Average intrinsic value for “feeling-lucky” strategy under LONG side                          --#9
SELECT AVG(t."LastPx" - t."StrikePrice") AS "avg_intrinsic_feeling_lucky"
FROM   "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
       LATERAL FLATTEN(input => t."Sides") f
WHERE  f.value:"Side"::STRING ILIKE '%LONG%'
  AND  f.value:"Strategy"::STRING ILIKE '%feeling%lucky%';
```

```sql
--Description: One query returning both averages and their difference                                        --#10
SELECT  AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%feeling%lucky%' THEN (t."LastPx" - t."StrikePrice") END) 
          AS "avg_feeling_lucky",
        AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%momentum%'       THEN (t."LastPx" - t."StrikePrice") END) 
          AS "avg_momentum",
        (AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%feeling%lucky%' THEN (t."LastPx" - t."StrikePrice") END)
         -
         AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%momentum%'       THEN (t."LastPx" - t."StrikePrice") END)
        )                                                                   AS "avg_intrinsic_diff"
FROM    "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
        LATERAL FLATTEN(input => t."Sides") f
WHERE   f.value:"Side"::STRING ILIKE '%LONG%';
```
