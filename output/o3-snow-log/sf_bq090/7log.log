```

```sql
--Description: Distinct list of strategy names found in Sides objects  
SELECT DISTINCT  
       f.value:"Strategy"::STRING AS "STRATEGY"  
FROM "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,  
     LATERAL FLATTEN(input => t."Sides") f  
WHERE f.value:"Strategy" IS NOT NULL  
LIMIT 20;
```

```sql
--Description: Sample of LONG-side trades together with their strategy names and prices  
SELECT  
       t."TradeDate",  
       t."Symbol",  
       t."StrikePrice",  
       t."LastPx",  
       (t."LastPx" - t."StrikePrice")  AS "INTRINSIC_VALUE",  
       f.value:"Strategy"::STRING      AS "STRATEGY"  
FROM "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,  
     LATERAL FLATTEN(input => t."Sides") f  
WHERE f.value:"Side"::STRING = 'LONG'  
LIMIT 20;
```

```sql
--Description: Sample LONG-side trades using a “feeling-lucky” strategy (fuzzy filter)  
SELECT  
       t."TradeDate",  
       t."Symbol",  
       t."LastPx" - t."StrikePrice" AS "INTRINSIC_VALUE",  
       f.value:"Strategy"::STRING  AS "STRATEGY"  
FROM "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,  
     LATERAL FLATTEN(input => t."Sides") f  
WHERE f.value:"Side"::STRING = 'LONG'  
  AND f.value:"Strategy"::STRING ILIKE '%feeling%lucky%'  
LIMIT 20;
```

```sql
--Description: Sample LONG-side trades using a “momentum” strategy (fuzzy filter)  
SELECT  
       t."TradeDate",  
       t."Symbol",  
       t."LastPx" - t."StrikePrice" AS "INTRINSIC_VALUE",  
       f.value:"Strategy"::STRING  AS "STRATEGY"  
FROM "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,  
     LATERAL FLATTEN(input => t."Sides") f  
WHERE f.value:"Side"::STRING = 'LONG'  
  AND f.value:"Strategy"::STRING ILIKE '%momentum%'  
LIMIT 20;
```

```sql
--Description: Average intrinsic value for each strategy on LONG-side trades  
SELECT  
       UPPER(f.value:"Strategy"::STRING)          AS "STRATEGY",  
       AVG(t."LastPx" - t."StrikePrice")          AS "AVG_INTRINSIC_VALUE"  
FROM "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,  
     LATERAL FLATTEN(input => t."Sides") f  
WHERE f.value:"Side"::STRING = 'LONG'  
GROUP BY 1  
LIMIT 20;
```

```sql
--Description: Difference in average intrinsic value between Feeling-Lucky & Momentum strategies for LONG-side trades  
SELECT  
       AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%feeling%lucky%'  
                THEN t."LastPx" - t."StrikePrice" END)  
       -  
       AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%momentum%'  
                THEN t."LastPx" - t."StrikePrice" END)  
       AS "AVG_INTRINSIC_DIFF_FEELING_LUCKY_VS_MOMENTUM"  
FROM "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,  
     LATERAL FLATTEN(input => t."Sides") f  
WHERE f.value:"Side"::STRING = 'LONG'  
LIMIT 20;
```
