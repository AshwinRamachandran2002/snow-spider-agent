```sql
--Description: Use a fuzzy search on the nested “PartyID” field (inside Sides → PartyIDs) to discover values that look like “feeling-lucky” (contains “lucky”) or “momentum” (contains “momo” / “momentum”).
SELECT DISTINCT
       pid.value:"PartyID"::STRING AS "strategy_name"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides")            f,
     LATERAL FLATTEN(input => f.value:"PartyIDs")   pid
WHERE pid.value:"PartyID"::STRING ILIKE '%lucky%' 
   OR pid.value:"PartyID"::STRING ILIKE '%momo%' 
   OR pid.value:"PartyID"::STRING ILIKE '%momentum%'
LIMIT 20;
```

```sql
--Description: Focus on LONG-side trades whose PartyID label hints at “feeling-lucky” or “momentum” and expose key price fields.
SELECT 
    t."TradeReportID",
    f.value:"Side"::STRING            AS "trade_side",
    pid.value:"PartyID"::STRING       AS "strategy_name",
    t."StrikePrice",
    t."LastPx"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides")            f,
     LATERAL FLATTEN(input => f.value:"PartyIDs")   pid
WHERE f.value:"Side"::STRING = 'LONG'
  AND (pid.value:"PartyID"::STRING ILIKE '%lucky%' 
       OR pid.value:"PartyID"::STRING ILIKE '%momo%' 
       OR pid.value:"PartyID"::STRING ILIKE '%momentum%')
LIMIT 20;
```

```sql
--Description: Compute an “intrinsic value” (LastPx − StrikePrice) for every LONG-side trade flagged as “feeling-lucky” or “momentum” via its PartyID.
SELECT 
    t."TradeReportID",
    pid.value:"PartyID"::STRING           AS "strategy_name",
    (t."LastPx" - t."StrikePrice")        AS "intrinsic_value"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides")            f,
     LATERAL FLATTEN(input => f.value:"PartyIDs")   pid
WHERE f.value:"Side"::STRING = 'LONG'
  AND (pid.value:"PartyID"::STRING ILIKE '%lucky%' 
       OR pid.value:"PartyID"::STRING ILIKE '%momo%' 
       OR pid.value:"PartyID"::STRING ILIKE '%momentum%')
LIMIT 20;
```

```sql
--Description: Aggregate – average intrinsic value by PartyID-based strategy for LONG-side trades.
SELECT 
    pid.value:"PartyID"::STRING                 AS "strategy_name",
    AVG(t."LastPx" - t."StrikePrice")           AS "avg_intrinsic_value"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides")            f,
     LATERAL FLATTEN(input => f.value:"PartyIDs")   pid
WHERE f.value:"Side"::STRING = 'LONG'
  AND (pid.value:"PartyID"::STRING ILIKE '%lucky%' 
       OR pid.value:"PartyID"::STRING ILIKE '%momo%' 
       OR pid.value:"PartyID"::STRING ILIKE '%momentum%')
GROUP BY 1
LIMIT 20;
```

```sql
--Description: Pivot the two strategies’ average intrinsic values into separate columns to aid comparison.
SELECT 
    AVG(CASE WHEN pid.value:"PartyID"::STRING ILIKE '%lucky%' 
             THEN (t."LastPx" - t."StrikePrice") END) AS "avg_intrinsic_feeling_lucky",
    AVG(CASE WHEN pid.value:"PartyID"::STRING ILIKE '%momo%' 
              OR pid.value:"PartyID"::STRING ILIKE '%momentum%' 
             THEN (t."LastPx" - t."StrikePrice") END) AS "avg_intrinsic_momentum"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides")            f,
     LATERAL FLATTEN(input => f.value:"PartyIDs")   pid
WHERE f.value:"Side"::STRING = 'LONG'
  AND (pid.value:"PartyID"::STRING ILIKE '%lucky%' 
       OR pid.value:"PartyID"::STRING ILIKE '%momo%' 
       OR pid.value:"PartyID"::STRING ILIKE '%momentum%')
LIMIT 20;
```

```sql
--Description: Final step – compute how much higher (positive or negative) the average intrinsic value is for “feeling-lucky” trades compared to “momentum” trades within LONG-side executions.
SELECT 
    AVG(CASE WHEN pid.value:"PartyID"::STRING ILIKE '%lucky%' 
             THEN (t."LastPx" - t."StrikePrice") END)
  - AVG(CASE WHEN pid.value:"PartyID"::STRING ILIKE '%momo%' 
              OR pid.value:"PartyID"::STRING ILIKE '%momentum%' 
             THEN (t."LastPx" - t."StrikePrice") END) AS "difference_feeling_lucky_minus_momentum"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides")            f,
     LATERAL FLATTEN(input => f.value:"PartyIDs")   pid
WHERE f.value:"Side"::STRING = 'LONG'
  AND (pid.value:"PartyID"::STRING ILIKE '%lucky%' 
       OR pid.value:"PartyID"::STRING ILIKE '%momo%' 
       OR pid.value:"PartyID"::STRING ILIKE '%momentum%')
LIMIT 1;
```
