```sql
--Description: Preview raw rows (including the JSON "Sides") to understand overall data content.
SELECT 
    "TradeReportID",
    "Symbol",
    "TradeDate",
    "StrikePrice",
    "LastPx",
    "Quantity",
    "Sides"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT
LIMIT 20;
```

```sql
--Description: Flatten the "Sides" array so each trade-side is on its own row and expose the most common keys.
SELECT 
    t."TradeReportID",
    f.value AS "side_json"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
LIMIT 20;
```

```sql
--Description: Pull out the “Side” (LONG / SHORT) value from the flattened JSON.
SELECT DISTINCT 
    f.value:"Side"::STRING AS "trade_side"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
LIMIT 20;
```

```sql
--Description: Probe for a “Strategy” (or similarly named) key inside the side JSON to see if it exists.
SELECT DISTINCT 
    f.value:"Strategy"::STRING AS "strategy_raw"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Strategy" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Use a fuzzy search to capture strategy strings that look like “feeling-lucky” or “momentum”.
SELECT DISTINCT 
    f.value:"Strategy"::STRING AS "strategy_name"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Strategy"::STRING ILIKE '%feeling%lucky%'
   OR f.value:"Strategy"::STRING ILIKE '%momentum%'
LIMIT 20;
```

```sql
--Description: Focus on trades whose side is LONG and already hold a strategy label of interest.
SELECT 
    t."TradeReportID",
    f.value:"Side"::STRING      AS "trade_side",
    f.value:"Strategy"::STRING  AS "strategy_name",
    t."StrikePrice",
    t."LastPx"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING = 'LONG'
  AND (f.value:"Strategy"::STRING ILIKE '%feeling%lucky%' 
       OR f.value:"Strategy"::STRING ILIKE '%momentum%')
LIMIT 20;
```

```sql
--Description: Compute an “intrinsic value” (LastPx − StrikePrice) for every LONG-side trade with a strategy.
SELECT 
    t."TradeReportID",
    f.value:"Strategy"::STRING  AS "strategy_name",
    (t."LastPx" - t."StrikePrice") AS "intrinsic_value"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING = 'LONG'
  AND (f.value:"Strategy"::STRING ILIKE '%feeling%lucky%' 
       OR f.value:"Strategy"::STRING ILIKE '%momentum%')
LIMIT 20;
```

```sql
--Description: Aggregate – average intrinsic value by strategy under LONG-side trades.
SELECT 
    f.value:"Strategy"::STRING              AS "strategy_name",
    AVG(t."LastPx" - t."StrikePrice")       AS "avg_intrinsic_value"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING = 'LONG'
  AND (f.value:"Strategy"::STRING ILIKE '%feeling%lucky%' 
       OR f.value:"Strategy"::STRING ILIKE '%momentum%')
GROUP BY 1
LIMIT 20;
```

```sql
--Description: Pivot the two strategy averages into separate columns for easy comparison.
SELECT 
    AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%feeling%lucky%' 
             THEN (t."LastPx" - t."StrikePrice") END) AS "avg_intrinsic_feeling_lucky",
    AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%momentum%'       
             THEN (t."LastPx" - t."StrikePrice") END) AS "avg_intrinsic_momentum"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING = 'LONG'
  AND (f.value:"Strategy"::STRING ILIKE '%feeling%lucky%' 
       OR f.value:"Strategy"::STRING ILIKE '%momentum%')
LIMIT 20;
```

```sql
--Description: Final step – show how much higher the average intrinsic value is for feeling-lucky vs momentum (difference in one row).
SELECT 
    AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%feeling%lucky%' 
             THEN (t."LastPx" - t."StrikePrice") END) 
  - AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%momentum%'       
             THEN (t."LastPx" - t."StrikePrice") END) AS "difference_feeling_lucky_minus_momentum"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING = 'LONG'
  AND (f.value:"Strategy"::STRING ILIKE '%feeling%lucky%' 
       OR f.value:"Strategy"::STRING ILIKE '%momentum%')
LIMIT 1;
```

