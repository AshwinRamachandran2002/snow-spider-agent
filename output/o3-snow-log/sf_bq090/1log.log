```sql
--Description: Confirm sample LONG-side rows that correspond to the momentum strategy
--             (proxied by PartyID codes that contain “MOMO”); show a few trades with intrinsic value.
SELECT
       t."TradeReportID",
       p.value:"PartyID"::STRING      AS "PartyID",
       t."StrikePrice",
       t."LastPx",
       t."LastPx" - t."StrikePrice"  AS "IntrinsicValue"
FROM   CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
       LATERAL FLATTEN(input => t."Sides")            s,
       LATERAL FLATTEN(input => s.value:"PartyIDs")   p
WHERE  s.value:"Side"::STRING ILIKE '%LONG%'
  AND  p.value:"PartyID"::STRING ILIKE '%MOMO%'
LIMIT 20;
```

```sql
--Description: Calculate intrinsic value per trade (LastPx – StrikePrice) for all LONG-side trades and
--             keep the leading PartyID as a proxy for strategy to verify values look reasonable.
SELECT
       t."TradeReportID",
       t."LastPx" - t."StrikePrice"              AS "IntrinsicValue",
       p.value:"PartyID"::STRING                 AS "PartyID_Proxy"
FROM   CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
       LATERAL FLATTEN(input => t."Sides")            s,
       LATERAL FLATTEN(input => s.value:"PartyIDs")   p
WHERE  s.value:"Side"::STRING ILIKE '%LONG%'
LIMIT 20;
```

```sql
--Description: Compute the average intrinsic value for each strategy proxy under LONG-side trades.
--             We bucket PartyIDs containing “LUCK” as “feeling-lucky”, those containing “MOMO”
--             as “momentum”, everything else as “other”.
SELECT
       CASE
           WHEN p.value:"PartyID"::STRING ILIKE '%LUCK%' THEN 'feeling-lucky'
           WHEN p.value:"PartyID"::STRING ILIKE '%MOMO%' THEN 'momentum'
           ELSE 'other'
       END                                           AS "Strategy_Label",
       AVG(t."LastPx" - t."StrikePrice")             AS "Avg_Intrinsic_Value",
       COUNT(*)                                      AS "Trades_Counted"
FROM   CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
       LATERAL FLATTEN(input => t."Sides")            s,
       LATERAL FLATTEN(input => s.value:"PartyIDs")   p
WHERE  s.value:"Side"::STRING ILIKE '%LONG%'
GROUP BY
       CASE
           WHEN p.value:"PartyID"::STRING ILIKE '%LUCK%' THEN 'feeling-lucky'
           WHEN p.value:"PartyID"::STRING ILIKE '%MOMO%' THEN 'momentum'
           ELSE 'other'
       END
LIMIT 20;
```

```sql
--Description: Final query – difference in average intrinsic value between feeling-lucky and momentum
--             strategies for LONG-side trades, using PartyID proxies.
SELECT
       AVG(CASE
               WHEN p.value:"PartyID"::STRING ILIKE '%LUCK%' THEN t."LastPx" - t."StrikePrice"
           END)
       -
       AVG(CASE
               WHEN p.value:"PartyID"::STRING ILIKE '%MOMO%' THEN t."LastPx" - t."StrikePrice"
           END)                                             AS "Delta_Avg_Intrinsic_Value"
FROM   CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
       LATERAL FLATTEN(input => t."Sides")            s,
       LATERAL FLATTEN(input => s.value:"PartyIDs")   p
WHERE  s.value:"Side"::STRING ILIKE '%LONG%';
```
