```sql
--Description: Show only those side-elements that are LONG sided, to confirm the string used (“LONG”, “BUY”, etc.)
SELECT
  f.value:"OrderID"::STRING AS "OrderID",
  f.value:"Side"::STRING    AS "Side_Type",
  f.value:"TradingStrategy"::STRING AS "TradingStrategy",
  f.value                   AS "full_side_json"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING ILIKE '%LONG%'
LIMIT 20;
```

```sql
--Description: Examine all distinct strategy labels that appear inside LONG-side trades
SELECT DISTINCT
  f.value:"TradingStrategy"::STRING AS "TradingStrategy"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING ILIKE '%LONG%'
LIMIT 20;
```

```sql
--Description: Confirm sample LONG-side rows that mention the feeling-lucky strategy
SELECT
  t."TradeReportID",
  f.value:"TradingStrategy"::STRING AS "TradingStrategy",
  f.value:"Side"::STRING            AS "Side_Type",
  t."StrikePrice",
  t."LastPx",
  t."LastPx" - t."StrikePrice"      AS "IntrinsicValue"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING ILIKE '%LONG%'
  AND f.value:"TradingStrategy"::STRING ILIKE '%feeling%lucky%'
LIMIT 20;
```

```sql
--Description: Confirm sample LONG-side rows that mention the momentum strategy
SELECT
  t."TradeReportID",
  f.value:"TradingStrategy"::STRING AS "TradingStrategy",
  f.value:"Side"::STRING            AS "Side_Type",
  t."StrikePrice",
  t."LastPx",
  t."LastPx" - t."StrikePrice"      AS "IntrinsicValue"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING ILIKE '%LONG%'
  AND f.value:"TradingStrategy"::STRING ILIKE '%momentum%'
LIMIT 20;
```

```sql
--Description: Calculate intrinsic value per trade (LastPx – StrikePrice) for all LONG-side trades to verify numbers look reasonable
SELECT
  t."TradeReportID",
  t."LastPx"  - t."StrikePrice" AS "IntrinsicValue",
  f.value:"TradingStrategy"::STRING AS "TradingStrategy"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING ILIKE '%LONG%'
LIMIT 20;
```

```sql
--Description: Compute the average intrinsic value for each trading strategy under LONG-side trades
SELECT
  f.value:"TradingStrategy"::STRING                  AS "TradingStrategy",
  AVG(t."LastPx" - t."StrikePrice")                  AS "Avg_Intrinsic_Value",
  COUNT(*)                                           AS "Trades_Counted"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING ILIKE '%LONG%'
GROUP BY f.value:"TradingStrategy"::STRING
LIMIT 20;
```

```sql
--Description: Final query – how much higher the average intrinsic value is for feeling-lucky vs momentum on LONG-side trades
SELECT
  AVG(CASE WHEN f.value:"TradingStrategy"::STRING ILIKE '%feeling%lucky%' THEN t."LastPx" - t."StrikePrice" END)
    -
  AVG(CASE WHEN f.value:"TradingStrategy"::STRING ILIKE '%momentum%'      THEN t."LastPx" - t."StrikePrice" END)
    AS "Delta_Avg_Intrinsic_Value"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS.TRADE_CAPTURE_REPORT t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING ILIKE '%LONG%';
```
