Query:
--Description: Average intrinsic value per potential strategy identifier for LONG-side trades
SELECT  p.value:"PartyID"::STRING            AS "potential_strategy_identifier",
        AVG(t."LastPx" - t."StrikePrice")    AS "avg_intrinsic_value"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS."TRADE_CAPTURE_REPORT"  t,
     LATERAL FLATTEN(input => t."Sides")                            s,
     LATERAL FLATTEN(input => s.value:"PartyIDs")                   p
WHERE s.value:"Side"::STRING = 'LONG'
GROUP BY 1
LIMIT 20
