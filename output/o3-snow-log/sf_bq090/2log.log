Query:
--Description: Compute intrinsic value for each LONG-side trade while showing its potential strategy identifier (PartyID)
SELECT  t."TradeReportID",
        p.value:"PartyID"::STRING            AS "potential_strategy_identifier",
        s.value:"Side"::STRING               AS "Side",
        (t."LastPx" - t."StrikePrice")       AS "intrinsic_value"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS."TRADE_CAPTURE_REPORT"  t,
     LATERAL FLATTEN(input => t."Sides")                            s,
     LATERAL FLATTEN(input => s.value:"PartyIDs")                   p
WHERE s.value:"Side"::STRING = 'LONG'
LIMIT 20
