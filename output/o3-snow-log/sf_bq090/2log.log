Query:
--Description: Difference in average intrinsic value between trades whose PartyID contains “feeling-lucky” vs “momentum” (LONG only)
SELECT  
       AVG(CASE WHEN p.value:"PartyID"::STRING ILIKE '%feeling%lucky%' 
                THEN t."LastPx" - t."StrikePrice" END)
     - AVG(CASE WHEN p.value:"PartyID"::STRING ILIKE '%momentum%' 
                THEN t."LastPx" - t."StrikePrice" END)  AS "avg_intrinsic_value_delta"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS."TRADE_CAPTURE_REPORT"  t,
     LATERAL FLATTEN(input => t."Sides")                            s,
     LATERAL FLATTEN(input => s.value:"PartyIDs")                   p
WHERE s.value:"Side"::STRING = 'LONG'
LIMIT 20
