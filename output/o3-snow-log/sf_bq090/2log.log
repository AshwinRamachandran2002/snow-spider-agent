```sql
--Description: Quick look at a handful of raw rows in the trade-capture table
SELECT * 
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS."TRADE_CAPTURE_REPORT" 
LIMIT 20;
```

```sql
--Description: Symbols traded in the sample set (helps see if certain symbols map to strategies)
SELECT DISTINCT "Symbol"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS."TRADE_CAPTURE_REPORT"
LIMIT 20;
```

```sql
--Description: Inspect the “Sides” JSON to see the structure and locate the Side/strategy fields
SELECT t."TradeReportID",
       f.value                               AS "sides_variant"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS."TRADE_CAPTURE_REPORT"  t,
     LATERAL FLATTEN(input => t."Sides") f
LIMIT 20;
```

```sql
--Description: Extract just the LONG / SHORT indicator from the Sides array
SELECT DISTINCT 
       f.value:"Side"::STRING                AS "Side"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS."TRADE_CAPTURE_REPORT" t,
     LATERAL FLATTEN(input => t."Sides") f
LIMIT 20;
```

```sql
--Description: Explore whether a “Strategy” (or similarly-named) key exists inside the Sides objects
SELECT DISTINCT 
       OBJECT_KEYS(f.value)                  AS "json_keys"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS."TRADE_CAPTURE_REPORT" t,
     LATERAL FLATTEN(input => t."Sides") f
LIMIT 20;
```

```sql
--Description: Pull any values that look like a strategy name (fuzzy search for ‘momentum’ or ‘feeling’)
SELECT  f.value:"Strategy"::STRING           AS "strategy_name",
        f.value:"Side"::STRING               AS "Side",
        t."TradeReportID"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS."TRADE_CAPTURE_REPORT" t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE  f.value:"Strategy"::STRING ILIKE '%momentum%' 
       OR f.value:"Strategy"::STRING ILIKE '%feeling%'
LIMIT 20;
```

```sql
--Description: Distinct list of strategy names discovered in the data
SELECT DISTINCT 
       f.value:"Strategy"::STRING            AS "strategy_name"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS."TRADE_CAPTURE_REPORT" t,
     LATERAL FLATTEN(input => t."Sides") f
LIMIT 20;
```

```sql
--Description: Compute intrinsic value (LastPx – StrikePrice) for each trade & show LONG-side records
SELECT  t."TradeReportID",
        f.value:"Strategy"::STRING           AS "strategy_name",
        f.value:"Side"::STRING               AS "Side",
        (t."LastPx" - t."StrikePrice")       AS "intrinsic_value"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS."TRADE_CAPTURE_REPORT" t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE  f.value:"Side"::STRING = 'LONG'
LIMIT 20;
```

```sql
--Description: Average intrinsic value per strategy for LONG-side trades
SELECT  f.value:"Strategy"::STRING           AS "strategy_name",
        AVG(t."LastPx" - t."StrikePrice")    AS "avg_intrinsic_value"
FROM CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS."TRADE_CAPTURE_REPORT" t,
     LATERAL FLATTEN(input => t."Sides") f
WHERE  f.value:"Side"::STRING = 'LONG'
GROUP BY 1
LIMIT 20;
```

```sql
--Description: Final query – difference in average intrinsic value between ‘feeling-lucky’ and ‘momentum’ strategies (LONG only)
SELECT  
        AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%feeling%lucky%' 
                 THEN t."LastPx" - t."StrikePrice" END)
      - AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%momentum%' 
                 THEN t."LastPx" - t."StrikePrice" END)          AS "avg_intrinsic_value_delta"
FROM  CYMBAL_INVESTMENTS.CYMBAL_INVESTMENTS."TRADE_CAPTURE_REPORT" t,
      LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING = 'LONG'
LIMIT 20;
```
