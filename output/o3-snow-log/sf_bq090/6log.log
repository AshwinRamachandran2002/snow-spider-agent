       f.value AS "SIDES_OBJECT"
FROM  "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
      LATERAL FLATTEN(input => t."Sides") f
LIMIT 20;
```

```sql
--Description: Inspect distinct values appearing in the inner “Side” field (e.g. LONG or SHORT)
SELECT DISTINCT 
       f.value:"Side"::STRING AS "SIDE_TYPE"
FROM  "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
      LATERAL FLATTEN(input => t."Sides") f
LIMIT 20;
```

```sql
--Description: Check whether a “Strategy” (or similarly-named) attribute exists inside each side object
SELECT DISTINCT 
       f.value:"Strategy"::STRING AS "STRATEGY_NAME"
FROM  "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
      LATERAL FLATTEN(input => t."Sides") f
WHERE  f.value:"Strategy" IS NOT NULL
LIMIT 20;
```

```sql
--Description: List unique strategy names found in LONG-side trades only
SELECT DISTINCT 
       f.value:"Strategy"::STRING AS "STRATEGY_NAME"
FROM  "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
      LATERAL FLATTEN(input => t."Sides") f
WHERE  f.value:"Side"::STRING ILIKE '%LONG%'
  AND  f.value:"Strategy" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Compute intrinsic value for LONG trades that use the “feeling-lucky” strategy
SELECT 
       AVG( t."LastPx" - t."StrikePrice") AS "AVG_INTRINSIC_VALUE_LUCKY"
FROM   "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
       LATERAL FLATTEN(input => t."Sides") f
WHERE  f.value:"Side"::STRING ILIKE '%LONG%'
  AND  f.value:"Strategy"::STRING ILIKE '%feeling%lucky%'
LIMIT 20;
```

```sql
--Description: Compute intrinsic value for LONG trades that use the “momentum” strategy
SELECT 
       AVG( t."LastPx" - t."StrikePrice") AS "AVG_INTRINSIC_VALUE_MOMENTUM"
FROM   "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
       LATERAL FLATTEN(input => t."Sides") f
WHERE  f.value:"Side"::STRING ILIKE '%LONG%'
  AND  f.value:"Strategy"::STRING ILIKE '%momentum%'
LIMIT 20;
```

```sql
--Description: Show both averages side-by-side to make comparison easier
SELECT
    (SELECT AVG(t1."LastPx" - t1."StrikePrice")
       FROM "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t1,
            LATERAL FLATTEN(input => t1."Sides") f1
      WHERE f1.value:"Side"::STRING ILIKE '%LONG%'
        AND f1.value:"Strategy"::STRING ILIKE '%feeling%lucky%')  AS "AVG_LUCKY",
    (SELECT AVG(t2."LastPx" - t2."StrikePrice")
       FROM "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t2,
            LATERAL FLATTEN(input => t2."Sides") f2
      WHERE f2.value:"Side"::STRING ILIKE '%LONG%'
        AND f2.value:"Strategy"::STRING ILIKE '%momentum%')       AS "AVG_MOMENTUM"
LIMIT 20;
```

```sql
--Description: Final calculation – how much higher the average intrinsic value is for feeling-lucky vs. momentum under LONG trades
SELECT 
      (AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%feeling%lucky%' THEN (t."LastPx" - t."StrikePrice") END)
     - AVG(CASE WHEN f.value:"Strategy"::STRING ILIKE '%momentum%'      THEN (t."LastPx" - t."StrikePrice") END))
      AS "INTRINSIC_VALUE_DIFF_LUCKY_MINUS_MOMENTUM"
FROM  "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
      LATERAL FLATTEN(input => t."Sides") f
WHERE f.value:"Side"::STRING ILIKE '%LONG%'
LIMIT 20;
```
