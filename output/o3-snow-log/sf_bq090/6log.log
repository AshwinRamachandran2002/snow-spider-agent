```sql
--Description: Calculate, in one scan, the average intrinsic value (LastPx – StrikePrice) for LONG-side trades belonging to the “feeling-lucky” (PartyID LIKE '%lucky%') and “momentum” (PartyID LIKE '%momo%') strategies, and show their difference (lucky minus momentum).
SELECT
       AVG(CASE WHEN pid.value:"PartyID"::STRING ILIKE '%lucky%' THEN t."LastPx" - t."StrikePrice" END) AS "AVG_LUCKY",
       AVG(CASE WHEN pid.value:"PartyID"::STRING ILIKE '%momo%'  THEN t."LastPx" - t."StrikePrice" END) AS "AVG_MOMENTUM",
       (AVG(CASE WHEN pid.value:"PartyID"::STRING ILIKE '%lucky%' THEN t."LastPx" - t."StrikePrice" END)
      - AVG(CASE WHEN pid.value:"PartyID"::STRING ILIKE '%momo%'  THEN t."LastPx" - t."StrikePrice" END)) AS "DIFF_LUCKY_MINUS_MOMENTUM"
FROM "CYMBAL_INVESTMENTS"."CYMBAL_INVESTMENTS"."TRADE_CAPTURE_REPORT" t,
     LATERAL FLATTEN(input => t."Sides") f,
     LATERAL FLATTEN(input => f.value:"PartyIDs") pid
WHERE f.value:"Side"::STRING ILIKE '%LONG%';
