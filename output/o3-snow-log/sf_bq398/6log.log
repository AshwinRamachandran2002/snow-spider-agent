```sql
--Description: Inspect Russia’s most recent (largest year) record for each indicator  
SELECT 
  t1."indicator_code",
  t1."indicator_name",
  t1."year",
  t1."value"
FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT" t1
JOIN (
      SELECT "indicator_code", MAX("year") AS max_year
      FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
      WHERE "country_code" = 'RUS'
      GROUP BY "indicator_code"
) t2
  ON t1."indicator_code" = t2."indicator_code"
 AND t1."year"          = t2.max_year
WHERE t1."country_code" = 'RUS'
ORDER BY t1."value" DESC
LIMIT 20;
```

```sql
--Description: Show the 20 highest individual debt‐value observations (any year) for Russia  
SELECT 
  "indicator_code",
  "indicator_name",
  "year",
  "value"
FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
WHERE "country_code" = 'RUS'
ORDER BY "value" DESC NULLS LAST
LIMIT 20;
```

```sql
--Description: Compute, for each indicator, Russia’s single-year peak debt value and order descending  
SELECT 
  "indicator_code",
  "indicator_name",
  MAX("value") AS "peak_value"
FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
WHERE "country_code" = 'RUS'
GROUP BY "indicator_code", "indicator_name"
ORDER BY "peak_value" DESC NULLS LAST
LIMIT 20;
```

```sql
--Description: Retrieve the TOP 3 debt indicators for Russia by their highest recorded debt values  
SELECT 
  "indicator_code",
  "indicator_name",
  MAX("value") AS "peak_value"
FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
WHERE "country_code" = 'RUS'
GROUP BY "indicator_code", "indicator_name"
ORDER BY "peak_value" DESC NULLS LAST
LIMIT 3;
```

```sql
--Description: Examine yearly trend of the single largest-magnitude indicator found above (replace CODE1)  
SELECT 
  "year",
  "value"
FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
WHERE "country_code" = 'RUS'
  AND "indicator_code" = 'CODE1'   -- replace CODE1 with the top indicator code from previous query
ORDER BY "year" ASC
LIMIT 20;
```

```sql
--Description: Compare the TOP 3 indicators’ values side-by-side for the latest year they all share  
WITH top3 AS (
  SELECT "indicator_code"
  FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
  WHERE "country_code" = 'RUS'
  GROUP BY "indicator_code"
  ORDER BY MAX("value") DESC NULLS LAST
  LIMIT 3
), latest AS (
  SELECT 
    t."indicator_code",
    MAX(t."year") AS latest_year
  FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT" t
  JOIN top3 ON t."indicator_code" = top3."indicator_code"
  WHERE t."country_code" = 'RUS'
  GROUP BY t."indicator_code"
)
SELECT 
  d."indicator_code",
  d."indicator_name",
  d."year",
  d."value"
FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT" d
JOIN latest l
  ON d."indicator_code" = l."indicator_code"
 AND d."year"          = l.latest_year
WHERE d."country_code" = 'RUS'
ORDER BY d."value" DESC
LIMIT 20;
```

```sql
--Description: Verify data availability—count of non-null observations per top 3 indicator  
WITH top3 AS (
  SELECT "indicator_code"
  FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
  WHERE "country_code" = 'RUS'
  GROUP BY "indicator_code"
  ORDER BY MAX("value") DESC NULLS LAST
  LIMIT 3
)
SELECT 
  "indicator_code",
  COUNT(*) AS "non_null_obs"
FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
WHERE "country_code" = 'RUS'
  AND "indicator_code" IN (SELECT "indicator_code" FROM top3)
  AND "value" IS NOT NULL
GROUP BY "indicator_code"
LIMIT 20;
```

