```sql
--Description:
-- Compare Russia’s latest-year debt totals with those of China and the United States.
-- Steps
--   1.  For every Russia debt indicator pick the most-recent (latest-year) value using ROW_NUMBER.
--   2.  Keep the five indicators whose latest values are greatest.
--   3.  Pull the same indicator-year rows for Russia, China and the USA to compare.
WITH rus_latest AS (   -- latest value for every RU indicator
    SELECT "indicator_code",
           "year"  AS "latest_year",
           "value" AS "rus_value"
    FROM (
        SELECT "indicator_code",
               "year",
               "value",
               ROW_NUMBER() OVER (PARTITION BY "indicator_code" ORDER BY "year" DESC) AS rn
        FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
        WHERE "country_code" = 'RUS'
          AND "value" IS NOT NULL
    )
    WHERE rn = 1
),
top5 AS (              -- five largest latest-year values
    SELECT "indicator_code",
           "latest_year",
           "rus_value"
    FROM rus_latest
    ORDER BY "rus_value" DESC
    LIMIT 5
)
SELECT d."country_code",
       d."indicator_code",
       d."year",
       d."value"
FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT" d
JOIN top5 t
  ON d."indicator_code" = t."indicator_code"
 AND d."year"           = t."latest_year"
WHERE d."country_code" IN ('RUS', 'CHN', 'USA')
ORDER BY t."rus_value" DESC,
         d."indicator_code",
         d."country_code"
LIMIT 20;
```

