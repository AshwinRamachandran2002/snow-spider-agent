```sql
--Description: Identify the latest (most recent year) debt value for each indicator Russia reports; list the 20 indicators with the biggest latest values.
WITH latest AS (
    SELECT "indicator_code",
           FIRST_VALUE("year")  OVER (PARTITION BY "indicator_code" ORDER BY "year" DESC)  AS "latest_year",
           FIRST_VALUE("value") OVER (PARTITION BY "indicator_code" ORDER BY "year" DESC)  AS "latest_value"
    FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
    WHERE "country_code" = 'RUS'
)
SELECT DISTINCT "indicator_code",
       "latest_year",
       "latest_value"
FROM latest
ORDER BY "latest_value" DESC
LIMIT 20;
```

```sql
--Description: Fetch metadata (topic and long_definition) for the 10 costliest debt indicators based on their maximum values for Russia.
WITH top_ind AS (
    SELECT "indicator_code"
    FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
    WHERE "country_code" = 'RUS'
    GROUP BY "indicator_code"
    ORDER BY MAX("value") DESC
    LIMIT 10
)
SELECT s."indicator_name",
       s."topic",
       s."long_definition"
FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."SERIES_SUMMARY" s
JOIN top_ind t
  ON s."series_code" = t."indicator_code"
LIMIT 20;
```

```sql
--Description: See if any series–specific notes exist for Russia’s top three debt indicators (by maximum value).
WITH ranked AS (
    SELECT "indicator_code",
           MAX("value") AS "max_val"
    FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
    WHERE "country_code" = 'RUS'
    GROUP BY "indicator_code"
    ORDER BY "max_val" DESC
    LIMIT 3
)
SELECT d."indicator_code",
       c."description"
FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."COUNTRY_SERIES_DEFINITIONS" c
