-- Steps
--   1.  From INTERNATIONAL_DEBT keep only Russia rows that have both a year and a value.
--   2.  For each indicator pick the most-recent (latest year) observation using ROW_NUMBER().
--   3.  Order those latest values in descending order and show the five largest,
--       together with the indicator’s official name from SERIES_SUMMARY.
WITH ru_latest AS (  -- latest dated value per Russian debt indicator
    SELECT "indicator_code",
           "year",
           "value",
           ROW_NUMBER() OVER (PARTITION BY "indicator_code" ORDER BY "year" DESC) AS rn
    FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
    WHERE "country_code" = 'RUS'
      AND "value" IS NOT NULL
      AND "year"  IS NOT NULL
)
SELECT l."indicator_code",
       s."indicator_name",
       l."year",
       l."value"
FROM ru_latest l
LEFT JOIN WORLD_BANK.WORLD_BANK_INTL_DEBT."SERIES_SUMMARY" s
  ON s."series_code" = l."indicator_code"
WHERE l.rn = 1                   -- keep only the most-recent row per indicator
ORDER BY l."value" DESC
LIMIT 5;
