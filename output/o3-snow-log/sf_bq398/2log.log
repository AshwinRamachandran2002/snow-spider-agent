--Description (thinking process):
-- 1) Filter INTERNATIONAL_DEBT to the Russian Federation (country_code = 'RUS') and exclude NULL values.
-- 2) For every debt indicator, calculate the maximum value ever recorded (this represents Russia’s peak debt level for that series).
-- 3) Sort these maxima in descending order and keep only the top three, which are the “largest” debt indicators.
-- 4) Join to SERIES_SUMMARY to attach the official indicator names, then present the results.
WITH ranked AS (
    SELECT "indicator_code",
           MAX("value") AS "max_val"
    FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
    WHERE "country_code" = 'RUS'
      AND "value" IS NOT NULL
    GROUP BY "indicator_code"
    ORDER BY "max_val" DESC
    LIMIT 3
)
SELECT r."indicator_code",
       s."indicator_name",
       r."max_val"
FROM ranked r
LEFT JOIN WORLD_BANK.WORLD_BANK_INTL_DEBT."SERIES_SUMMARY" s
  ON s."series_code" = r."indicator_code"
ORDER BY r."max_val" DESC;
