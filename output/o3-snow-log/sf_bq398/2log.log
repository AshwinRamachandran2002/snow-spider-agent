```sql
--Description: Compare Russia’s latest-year debt totals with those of China and the United States for perspective (top 5 indicators by latest value in Russia).
WITH rus_top AS (
    SELECT "indicator_code",
           FIRST_VALUE("year")  OVER (PARTITION BY "indicator_code" ORDER BY "year" DESC) AS "last_year",
           FIRST_VALUE("value") OVER (PARTITION BY "indicator_code" ORDER BY "year" DESC) AS "rus_value"
    FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT"
    WHERE "country_code" = 'RUS'
),
top5 AS (
    SELECT DISTINCT "indicator_code", "last_year"
    FROM rus_top
    ORDER BY "rus_value" DESC
    LIMIT 5
)
SELECT d."country_code",
       d."indicator_code",
       d."year",
       d."value"
FROM WORLD_BANK.WORLD_BANK_INTL_DEBT."INTERNATIONAL_DEBT" d
JOIN top5 t
  ON d."indicator_code" = t."indicator_code"
WHERE d."country_code" IN ('RUS', 'CHN', 'USA')
  AND d."year" = t."last_year"
ORDER BY d."indicator_code", d."country_code"
LIMIT 20;
```

