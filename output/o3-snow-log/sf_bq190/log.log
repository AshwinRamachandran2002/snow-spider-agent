```sql
--Description: Check the overall signup date span that exists in the USERS table.
SELECT 
  MIN(TO_TIMESTAMP_NTZ("created_at"/1000000)) AS "earliest_signup",
  MAX(TO_TIMESTAMP_NTZ("created_at"/1000000)) AS "latest_signup"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
LIMIT 20;
```

```sql
--Description: List 20 female users who signed up between 1-Jan-2019 and 30-Apr-2022 (inclusive).
SELECT
  "id",
  "age",
  TO_TIMESTAMP_NTZ("created_at"/1000000) AS "signup_timestamp"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
WHERE "gender" = 'F'
  AND TO_TIMESTAMP_NTZ("created_at"/1000000) 
        BETWEEN '2019-01-01' AND '2022-04-30 23:59:59'
LIMIT 20;
```

```sql
--Description: List 20 male users who signed up in the same date window.
SELECT
  "id",
  "age",
  TO_TIMESTAMP_NTZ("created_at"/1000000) AS "signup_timestamp"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
WHERE "gender" = 'M'
  AND TO_TIMESTAMP_NTZ("created_at"/1000000) 
        BETWEEN '2019-01-01' AND '2022-04-30 23:59:59'
LIMIT 20;
```

```sql
--Description: Find the minimum and maximum age reached for each gender inside the required signup period.
SELECT
  "gender",
  MIN("age") AS "min_age",
  MAX("age") AS "max_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
WHERE TO_TIMESTAMP_NTZ("created_at"/1000000) 
        BETWEEN '2019-01-01' AND '2022-04-30 23:59:59'
GROUP BY "gender"
LIMIT 20;
```

```sql
--Description: Count users who are at the minimum age for each gender in the period.
SELECT
  u."gender",
  u."age"  AS "min_age",
  COUNT(*) AS "user_cnt_min_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS u
JOIN (
    SELECT 
      "gender",
      MIN("age") AS "min_age"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
    WHERE TO_TIMESTAMP_NTZ("created_at"/1000000)
          BETWEEN '2019-01-01' AND '2022-04-30 23:59:59'
    GROUP BY "gender"
) m
  ON u."gender" = m."gender"
 AND u."age"    = m."min_age"
WHERE TO_TIMESTAMP_NTZ(u."created_at"/1000000)
        BETWEEN '2019-01-01' AND '2022-04-30 23:59:59'
GROUP BY u."gender", u."age"
LIMIT 20;
```

```sql
--Description: Count users who are at the maximum age for each gender in the period.
SELECT
  u."gender",
  u."age"  AS "max_age",
  COUNT(*) AS "user_cnt_max_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS u
JOIN (
    SELECT 
      "gender",
      MAX("age") AS "max_age"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
    WHERE TO_TIMESTAMP_NTZ("created_at"/1000000)
          BETWEEN '2019-01-01' AND '2022-04-30 23:59:59'
    GROUP BY "gender"
) m
  ON u."gender" = m."gender"
 AND u."age"    = m."max_age"
WHERE TO_TIMESTAMP_NTZ(u."created_at"/1000000)
        BETWEEN '2019-01-01' AND '2022-04-30 23:59:59'
GROUP BY u."gender", u."age"
LIMIT 20;
```

```sql
--Description: Combine youngest and oldest counts (min & max age) for every gender into one unified view.
WITH age_bounds AS (
  SELECT 
    "gender",
    MIN("age") AS "min_age",
    MAX("age") AS "max_age"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
  WHERE TO_TIMESTAMP_NTZ("created_at"/1000000) 
        BETWEEN '2019-01-01' AND '2022-04-30 23:59:59'
  GROUP BY "gender"
),
detail AS (
  SELECT
    u."gender",
    CASE WHEN u."age" = b."min_age" THEN 'min_age' ELSE 'max_age' END AS "age_type",
    u."age"  AS "age_value"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS u
  JOIN age_bounds b
    ON u."gender" = b."gender"
   AND (u."age" = b."min_age" OR u."age" = b."max_age")
  WHERE TO_TIMESTAMP_NTZ(u."created_at"/1000000) 
        BETWEEN '2019-01-01' AND '2022-04-30 23:59:59'
)
SELECT
  "gender",
  "age_type",
  "age_value",
  COUNT(*) AS "user_count"
FROM detail
GROUP BY "gender", "age_type", "age_value"
ORDER BY "gender", "age_type"
LIMIT 20;
```

```sql
--Description: Present the youngest & oldest age plus respective user counts in a single row per gender.
WITH age_bounds AS (
  SELECT 
    "gender",
    MIN("age") AS "min_age",
    MAX("age") AS "max_age"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
  WHERE TO_TIMESTAMP_NTZ("created_at"/1000000) 
        BETWEEN '2019-01-01' AND '2022-04-30 23:59:59'
  GROUP BY "gender"
),
counts AS (
  SELECT
    u."gender",
    u."age",
    COUNT(*) AS "cnt"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS u
  JOIN age_bounds b
    ON u."gender" = b."gender"
   AND (u."age" = b."min_age" OR u."age" = b."max_age")
  WHERE TO_TIMESTAMP_NTZ(u."created_at"/1000000) 
        BETWEEN '2019-01-01' AND '2022-04-30 23:59:59'
  GROUP BY u."gender", u."age"
)
SELECT
  c1."gender",
  MIN(CASE WHEN c1."age" = b."min_age" THEN c1."age" END) AS "youngest_age",
  SUM(CASE WHEN c1."age" = b."min_age" THEN c1."cnt" END) AS "youngest_user_cnt",
  MAX(CASE WHEN c1."age" = b."max_age" THEN c1."age" END) AS "oldest_age",
  SUM(CASE WHEN c1."age" = b."max_age" THEN c1."cnt" END) AS "oldest_user_cnt"
FROM counts c1
JOIN age_bounds b
  ON c1."gender" = b."gender"
GROUP BY c1."gender"
LIMIT 20;
```
