```sql
-- Description / Thinking process:
-- Goal: For sign-ups between 2019-01-01 and 2022-04-30 (timestamps in micro-seconds),
--       1) find the youngest (min_age) and oldest (max_age) ages per gender,
--       2) count how many users fall into those youngest and oldest age buckets.
-- Approach:
--   • bounds   : derive min_age & max_age per gender in the date window.
--   • youngest : count users whose age equals min_age for their gender.
--   • oldest   : count users whose age equals max_age for their gender.
--   • final    : join the three CTEs so each gender shows min_age, youngest_cnt, max_age, oldest_cnt.
WITH bounds AS (
    SELECT
        "gender",
        MIN("age") AS "min_age",
        MAX("age") AS "max_age"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
    WHERE "created_at" BETWEEN 1546300800000000  -- 2019-01-01 00:00:00
                         AND 1651363199000000     -- 2022-04-30 23:59:59
    GROUP BY "gender"
),
youngest AS (
    SELECT
        u."gender",
        COUNT(*) AS "youngest_cnt"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
    JOIN bounds b
      ON u."gender" = b."gender"
     AND u."age"    = b."min_age"
    WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
    GROUP BY u."gender"
),
oldest AS (
    SELECT
        u."gender",
        COUNT(*) AS "oldest_cnt"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
    JOIN bounds b
      ON u."gender" = b."gender"
     AND u."age"    = b."max_age"
    WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
    GROUP BY u."gender"
)
SELECT
    b."gender",
    b."min_age",
    y."youngest_cnt",
    b."max_age",
    o."oldest_cnt"
FROM bounds  b
LEFT JOIN youngest y ON b."gender" = y."gender"
LEFT JOIN oldest   o ON b."gender" = o."gender";
```
