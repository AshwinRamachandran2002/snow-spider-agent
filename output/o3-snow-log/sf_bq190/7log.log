```sql
-- Description: Identify the youngest users (per gender) in the time frame
WITH age_bounds AS (
    SELECT "gender",
           MIN("age") AS "min_age"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
    WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
    GROUP BY "gender"
)
SELECT u."gender",
       u."age",
