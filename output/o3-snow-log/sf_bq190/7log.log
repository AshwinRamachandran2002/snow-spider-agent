```sql
-- Description: Combine youngest & oldest counts for each gender in one result
WITH bounds AS (
    SELECT "gender",
           MIN("age") AS "min_age",
           MAX("age") AS "max_age"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
    WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
    GROUP BY "gender"
), youngest AS (
    SELECT "gender",
           COUNT(*) AS "youngest_cnt"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
    JOIN bounds b
      ON u."gender" = b."gender"
     AND u."age"    = b."min_age"
    WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
    GROUP BY "gender"
), oldest AS (
    SELECT "gender",
           COUNT(*) AS "oldest_cnt"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
    JOIN bounds b
      ON u."gender" = b."gender"
     AND u."age"    = b."max_age"
    WHERE u."created_at" BETWEEN 1546300800000000 AND 1651363199000000
    GROUP BY "gender"
)
SELECT b."gender",
       b."min_age",
       y."youngest_cnt",
       b."max_age",
       o."oldest_cnt"
FROM bounds b
LEFT JOIN youngest y USING ("gender")
LEFT JOIN oldest   o USING ("gender")
LIMIT 20;
