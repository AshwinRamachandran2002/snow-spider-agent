```sql
--1) Preview a few rows in the PAYMENT table (main sales table)
SELECT * 
FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
LIMIT 20;
```

```sql
--2) List the distinct customers that have at least one payment
SELECT DISTINCT "customer_id"
FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
LIMIT 20;
```

```sql
--3) Compute total lifetime sales (LTV) for every customer
SELECT 
      "customer_id",
      SUM("amount")  AS "total_ltv"
FROM  "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
GROUP BY "customer_id"
ORDER BY "total_ltv" DESC
LIMIT 20;
```

```sql
--4) Find each customer's first (earliest) payment timestamp
SELECT 
      "customer_id",
      MIN("payment_date") AS "first_payment_ts"
FROM  "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
GROUP BY "customer_id"
LIMIT 20;
```

```sql
--5) Payments that happened within the first exact 7×24 hours 
--   after a customer’s very first payment
WITH first_ts AS (
      SELECT "customer_id",
             MIN("payment_date") AS "first_payment_ts"
      FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
      GROUP BY "customer_id"
)
SELECT p."customer_id",
       p."payment_id",
       p."amount",
       p."payment_date"
FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"  p
JOIN   first_ts f
       ON p."customer_id" = f."customer_id"
WHERE  DATEDIFF('second', TO_TIMESTAMP(f."first_payment_ts"), 
                          TO_TIMESTAMP(p."payment_date")) <= 7*24*60*60
LIMIT 20;
```

```sql
--6) Payments that happened within the first exact 30×24 hours 
--   after the initial payment
WITH first_ts AS (
      SELECT "customer_id",
             MIN("payment_date") AS "first_payment_ts"
      FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
      GROUP BY "customer_id"
)
SELECT p."customer_id",
       p."payment_id",
       p."amount",
       p."payment_date"
FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"  p
JOIN   first_ts f
       ON p."customer_id" = f."customer_id"
WHERE  DATEDIFF('second', TO_TIMESTAMP(f."first_payment_ts"), 
                          TO_TIMESTAMP(p."payment_date")) <= 30*24*60*60
LIMIT 20;
```

```sql
--7) Compute, per customer, the total sales, the 7-day sales, and the 30-day sales
WITH first_ts AS (
      SELECT "customer_id",
             MIN("payment_date") AS "first_payment_ts"
      FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
      GROUP BY "customer_id"
),
sales AS (
      SELECT p."customer_id",
             SUM(p."amount")                                        AS "total_ltv",
             SUM(CASE WHEN DATEDIFF('second', TO_TIMESTAMP(f."first_payment_ts"), 
                                           TO_TIMESTAMP(p."payment_date")) 
                           <= 7*24*60*60 THEN p."amount" ELSE 0 END) AS "sales_7d",
             SUM(CASE WHEN DATEDIFF('second', TO_TIMESTAMP(f."first_payment_ts"), 
                                           TO_TIMESTAMP(p."payment_date")) 
                           <= 30*24*60*60 THEN p."amount" ELSE 0 END) AS "sales_30d"
      FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"  p
      JOIN   first_ts f
             ON p."customer_id" = f."customer_id"
      GROUP BY p."customer_id"
)
SELECT *
FROM   sales
LIMIT 20;
```

```sql
--8) Add percentage columns for 7-day and 30-day windows, exclude zero-LTV customers
WITH first_ts AS (
      SELECT "customer_id",
             MIN("payment_date") AS "first_payment_ts"
      FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
      GROUP BY "customer_id"
),
sales AS (
      SELECT p."customer_id",
             SUM(p."amount")                                        AS "total_ltv",
             SUM(CASE WHEN DATEDIFF('second', TO_TIMESTAMP(f."first_payment_ts"), 
                                           TO_TIMESTAMP(p."payment_date")) 
                           <= 7*24*60*60 THEN p."amount" ELSE 0 END) AS "sales_7d",
             SUM(CASE WHEN DATEDIFF('second', TO_TIMESTAMP(f."first_payment_ts"), 
                                           TO_TIMESTAMP(p."payment_date")) 
                           <= 30*24*60*60 THEN p."amount" ELSE 0 END) AS "sales_30d"
      FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"  p
      JOIN   first_ts f
             ON p."customer_id" = f."customer_id"
      GROUP BY p."customer_id"
)
SELECT "customer_id",
       "total_ltv",
       "sales_7d",
       "sales_30d",
       "sales_7d"  / "total_ltv" AS "pct_7d",
       "sales_30d" / "total_ltv" AS "pct_30d"
FROM   sales
WHERE  "total_ltv" > 0
LIMIT 20;
```

```sql
--9) Compute the average percentages across all customers (zero-LTV removed)
WITH first_ts AS (
      SELECT "customer_id",
             MIN("payment_date") AS "first_payment_ts"
      FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
      GROUP BY "customer_id"
),
sales AS (
      SELECT p."customer_id",
             SUM(p."amount")                                        AS "total_ltv",
             SUM(CASE WHEN DATEDIFF('second', TO_TIMESTAMP(f."first_payment_ts"), 
                                           TO_TIMESTAMP(p."payment_date")) 
                           <= 7*24*60*60 THEN p."amount" ELSE 0 END) AS "sales_7d",
             SUM(CASE WHEN DATEDIFF('second', TO_TIMESTAMP(f."first_payment_ts"), 
                                           TO_TIMESTAMP(p."payment_date")) 
                           <= 30*24*60*60 THEN p."amount" ELSE 0 END) AS "sales_30d"
      FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"  p
      JOIN   first_ts f
             ON p."customer_id" = f."customer_id"
      GROUP BY p."customer_id"
),
pct AS (
      SELECT "customer_id",
             "total_ltv",
             IFF("total_ltv" > 0, "sales_7d"  / "total_ltv", NULL) AS "pct_7d",
             IFF("total_ltv" > 0, "sales_30d" / "total_ltv", NULL) AS "pct_30d"
      FROM   sales
      WHERE  "total_ltv" > 0
)
SELECT 
       AVG("pct_7d")  AS "avg_pct_7d",
       AVG("pct_30d") AS "avg_pct_30d"
FROM   pct
LIMIT 20;
```

```sql
--10) Bring the average percentages together with the average total LTV
WITH first_ts AS (
      SELECT "customer_id",
             MIN("payment_date") AS "first_payment_ts"
      FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
      GROUP BY "customer_id"
),
sales AS (
      SELECT p."customer_id",
             SUM(p."amount")                                        AS "total_ltv",
             SUM(CASE WHEN DATEDIFF('second', TO_TIMESTAMP(f."first_payment_ts"), 
                                           TO_TIMESTAMP(p."payment_date")) 
                           <= 7*24*60*60 THEN p."amount" ELSE 0 END) AS "sales_7d",
             SUM(CASE WHEN DATEDIFF('second', TO_TIMESTAMP(f."first_payment_ts"), 
                                           TO_TIMESTAMP(p."payment_date")) 
                           <= 30*24*60*60 THEN p."amount" ELSE 0 END) AS "sales_30d"
      FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"  p
      JOIN   first_ts f
             ON p."customer_id" = f."customer_id"
      GROUP BY p."customer_id"
),
pct AS (
      SELECT "customer_id",
             "total_ltv",
             IFF("total_ltv" > 0, "sales_7d"  / "total_ltv", NULL) AS "pct_7d",
             IFF("total_ltv" > 0, "sales_30d" / "total_ltv", NULL) AS "pct_30d"
      FROM   sales
      WHERE  "total_ltv" > 0
)
SELECT 
       AVG("total_ltv") AS "avg_total_ltv",
       AVG("pct_7d")    AS "avg_pct_7d",
       AVG("pct_30d")   AS "avg_pct_30d"
FROM   pct
LIMIT 20;
```
