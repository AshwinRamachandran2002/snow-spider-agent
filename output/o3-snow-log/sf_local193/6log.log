```sql
--1) Preview a few raw payment records
SELECT * 
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT 
LIMIT 20;
```

```sql
--2) Find each customer’s first-ever purchase time
SELECT DISTINCT 
       p."customer_id",
       MIN(p."payment_date") AS "first_purchase_ts"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--3) Calculate the total lifetime sales (LTV) per customer
SELECT DISTINCT
       p."customer_id",
       SUM(p."amount")   AS "total_ltv"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
GROUP BY p."customer_id"
HAVING SUM(p."amount") > 0               --exclude zero-LTV customers
LIMIT 20;
```

```sql
--4) Add 1st-purchase timestamp to every payment so we can measure the elapsed seconds
SELECT DISTINCT
       p."payment_id",
       p."customer_id",
       p."payment_date",
       fp."first_purchase_ts",
       DATEDIFF('second', fp."first_purchase_ts", p."payment_date") AS "secs_from_start"
FROM  SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
JOIN ( SELECT "customer_id", MIN("payment_date") AS "first_purchase_ts"
       FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
       GROUP  BY "customer_id") fp
  ON fp."customer_id" = p."customer_id"
LIMIT 20;
```

```sql
--5) Aggregate payments that occurred in the first 7×24 hours (604 800 seconds)
SELECT DISTINCT
       p."customer_id",
       SUM(CASE WHEN DATEDIFF('second', fp."first_purchase_ts", p."payment_date") 
                     <= 604800 THEN p."amount" END)  AS "ltv_7d"
FROM  SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
JOIN ( SELECT "customer_id", MIN("payment_date") AS "first_purchase_ts"
       FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
       GROUP  BY "customer_id") fp
  ON fp."customer_id" = p."customer_id"
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--6) Aggregate payments that occurred in the first 30×24 hours (2 592 000 seconds)
SELECT DISTINCT
       p."customer_id",
       SUM(CASE WHEN DATEDIFF('second', fp."first_purchase_ts", p."payment_date") 
                     <= 2592000 THEN p."amount" END)  AS "ltv_30d"
FROM  SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
JOIN ( SELECT "customer_id", MIN("payment_date") AS "first_purchase_ts"
       FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
       GROUP  BY "customer_id") fp
  ON fp."customer_id" = p."customer_id"
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--7) Combine total LTV, 7-day LTV and 30-day LTV for every qualifying customer
SELECT DISTINCT
       tot."customer_id",
       tot."total_ltv",
       l7."ltv_7d",
       l30."ltv_30d",
       (l7."ltv_7d"  / NULLIF(tot."total_ltv",0)) AS "pct_7d",
       (l30."ltv_30d" / NULLIF(tot."total_ltv",0)) AS "pct_30d"
FROM  (SELECT "customer_id", SUM("amount") AS "total_ltv"
       FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
       GROUP  BY "customer_id"
       HAVING SUM("amount") > 0) tot
LEFT JOIN
      (SELECT "customer_id",
              SUM(CASE WHEN DATEDIFF('second', fp."first_purchase_ts", p."payment_date") 
                           <= 604800 THEN p."amount" END) AS "ltv_7d"
       FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
       JOIN  (SELECT "customer_id", MIN("payment_date") AS "first_purchase_ts"
              FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
              GROUP  BY "customer_id") fp
         ON fp."customer_id" = p."customer_id"
       GROUP BY p."customer_id") l7
  ON l7."customer_id" = tot."customer_id"
LEFT JOIN
      (SELECT "customer_id",
              SUM(CASE WHEN DATEDIFF('second', fp."first_purchase_ts", p."payment_date") 
                           <= 2592000 THEN p."amount" END) AS "ltv_30d"
       FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
       JOIN  (SELECT "customer_id", MIN("payment_date") AS "first_purchase_ts"
              FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
              GROUP  BY "customer_id") fp
         ON fp."customer_id" = p."customer_id"
       GROUP BY p."customer_id") l30
  ON l30."customer_id" = tot."customer_id"
LIMIT 20;
```

```sql
--8) Bring in the CUSTOMER table to attach first/last names (optional enrichment)
SELECT DISTINCT
       c."first_name",
       c."last_name",
       m."total_ltv",
       m."pct_7d",
       m."pct_30d"
FROM  SQLITE_SAKILA.SQLITE_SAKILA.CUSTOMER c
JOIN ( /* query #7 */ ) m
  ON m."customer_id" = c."customer_id"
LIMIT 20;
```

```sql
--9) Inspect the distribution of 7-day LTV percentages (bucketed roughly)
SELECT DISTINCT
       FLOOR(m."pct_7d" * 10) / 10.0 AS "bucket",
       COUNT(*)                      AS "customers_in_bucket"
FROM ( /* query #7 */ ) m
GROUP BY FLOOR(m."pct_7d" * 10) / 10.0
ORDER BY "bucket"
LIMIT 20;
```

```sql
--10) FINAL – Average 7-day & 30-day LTV % plus average total LTV across all customers
SELECT 
       AVG(m."pct_7d")   AS "avg_pct_7_days",
       AVG(m."pct_30d")  AS "avg_pct_30_days",
       AVG(m."total_ltv") AS "avg_total_ltv"
FROM ( /* query #7 */ ) m
LIMIT 20;
```
