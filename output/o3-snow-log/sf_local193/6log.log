```sql
--Description: Attach first & last names from CUSTOMER to each customer-level LTV metric
WITH "first_purchase" AS (
    SELECT p."customer_id",
           MIN(p."payment_date") AS "first_ts"
    FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
    GROUP  BY p."customer_id"
), 
"customer_ltv" AS (
    SELECT p."customer_id",
           SUM(p."amount") AS "total_ltv",
           SUM(CASE WHEN DATEDIFF('second', fp."first_ts", p."payment_date") <= 604800  THEN p."amount" END) AS "ltv_7d",
           SUM(CASE WHEN DATEDIFF('second', fp."first_ts", p."payment_date") <= 2592000 THEN p."amount" END) AS "ltv_30d"
    FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
    JOIN   "first_purchase" fp
      ON   fp."customer_id" = p."customer_id"
    GROUP  BY p."customer_id"
), 
"metrics" AS (
    SELECT c."customer_id",
           c."total_ltv",
           c."ltv_7d",
           c."ltv_30d",
           c."ltv_7d"  / NULLIF(c."total_ltv",0) AS "pct_7d",
           c."ltv_30d" / NULLIF(c."total_ltv",0) AS "pct_30d"
    FROM   "customer_ltv" c
    WHERE  c."total_ltv" > 0
)
SELECT  cust."first_name",
        cust."last_name",
        m."total_ltv",
        m."pct_7d",
        m."pct_30d"
FROM    SQLITE_SAKILA.SQLITE_SAKILA.CUSTOMER cust
JOIN    "metrics" m
  ON    m."customer_id" = cust."customer_id"
LIMIT 20;
```

```sql
--Description: Bucket the 7-day LTV percentage into deciles to view its distribution
WITH "first_purchase" AS (
    SELECT p."customer_id",
           MIN(p."payment_date") AS "first_ts"
    FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
    GROUP  BY p."customer_id"
), 
"customer_ltv" AS (
    SELECT p."customer_id",
           SUM(p."amount") AS "total_ltv",
           SUM(CASE WHEN DATEDIFF('second', fp."first_ts", p."payment_date") <= 604800  THEN p."amount" END) AS "ltv_7d"
    FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
    JOIN   "first_purchase" fp
      ON   fp."customer_id" = p."customer_id"
    GROUP  BY p."customer_id"
), 
"metrics" AS (
    SELECT c."customer_id",
           c."ltv_7d" / NULLIF(c."total_ltv",0) AS "pct_7d"
    FROM  "customer_ltv" c
    WHERE c."total_ltv" > 0
)
SELECT  FLOOR(m."pct_7d" * 10) / 10.0 AS "bucket",
        COUNT(*)                      AS "customers_in_bucket"
FROM    "metrics" m
GROUP BY FLOOR(m."pct_7d" * 10) / 10.0
ORDER BY "bucket"
LIMIT 20;
```

```sql
--Description: Final overall averages — average % of LTV in first 7 & 30 days and average total LTV
WITH "first_purchase" AS (
    SELECT p."customer_id",
           MIN(p."payment_date") AS "first_ts"
    FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
    GROUP  BY p."customer_id"
), 
"customer_ltv" AS (
    SELECT p."customer_id",
           SUM(p."amount") AS "total_ltv",
           SUM(CASE WHEN DATEDIFF('second', fp."first_ts", p."payment_date") <= 604800  THEN p."amount" END) AS "ltv_7d",
           SUM(CASE WHEN DATEDIFF('second', fp."first_ts", p."payment_date") <= 2592000 THEN p."amount" END) AS "ltv_30d"
    FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
    JOIN   "first_purchase" fp
      ON   fp."customer_id" = p."customer_id"
    GROUP  BY p."customer_id"
), 
"metrics" AS (
    SELECT c."customer_id",
           c."total_ltv",
           c."ltv_7d"  / NULLIF(c."total_ltv",0) AS "pct_7d",
           c."ltv_30d" / NULLIF(c."total_ltv",0) AS "pct_30d"
    FROM   "customer_ltv" c
    WHERE  c."total_ltv" > 0
)
SELECT  AVG(m."pct_7d")    AS "avg_pct_7_days",
        AVG(m."pct_30d")   AS "avg_pct_30_days",
        AVG(m."total_ltv") AS "avg_total_ltv"
FROM    "metrics" m;
