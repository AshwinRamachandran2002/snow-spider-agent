Query:
--4) Add 1st-purchase timestamp to every payment so we can measure the elapsed seconds
SELECT DISTINCT
       p."payment_id",
       p."customer_id",
       p."payment_date",
       fp."first_purchase_ts",
       DATEDIFF('second', fp."first_purchase_ts", p."payment_date") AS "secs_from_start"
FROM  SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
JOIN ( SELECT "customer_id", MIN("payment_date") AS "first_purchase_ts"
       FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
       GROUP  BY "customer_id") fp
  ON fp."customer_id" = p."customer_id"
LIMIT 20;
