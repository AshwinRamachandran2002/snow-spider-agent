```sql
--Description: Determine the average proportions of lifetime value (LTV) captured in the first
--7 days (604 800 s) and 30 days (2 592 000 s) after each customer’s very first payment, plus
--the average total LTV.  Steps inside CTEs:
-- 1) first_purchase  – earliest payment timestamp per customer.
-- 2) customer_ltv    – total LTV, plus 7-day and 30-day LTV using exact-second windows.
-- 3) filtered        – adds percentage columns and keeps only customers whose total LTV > 0.
-- The outer SELECT averages those percentages and totals across all qualifying customers.

WITH "first_purchase" AS (
    SELECT 
        p."customer_id",
        MIN(p."payment_date") AS "first_ts"
    FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
    GROUP BY p."customer_id"
),
"customer_ltv" AS (
    SELECT 
        p."customer_id",
        SUM(p."amount") AS "total_ltv",
        SUM(
            CASE WHEN DATEDIFF('second', fp."first_ts", p."payment_date") <= 604800 
                 THEN p."amount" END
        ) AS "ltv_7d",
        SUM(
            CASE WHEN DATEDIFF('second', fp."first_ts", p."payment_date") <= 2592000 
                 THEN p."amount" END
        ) AS "ltv_30d"
    FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
    JOIN "first_purchase" fp
      ON fp."customer_id" = p."customer_id"
    GROUP BY p."customer_id"
),
"filtered" AS (
    SELECT
        c."customer_id",
        c."total_ltv",
        c."ltv_7d",
        c."ltv_30d",
        c."ltv_7d"  / NULLIF(c."total_ltv",0) AS "pct_7d",
        c."ltv_30d" / NULLIF(c."total_ltv",0) AS "pct_30d"
    FROM "customer_ltv" c
    WHERE c."total_ltv" > 0
)
SELECT 
    AVG("pct_7d")    AS "avg_pct_7_days",
    AVG("pct_30d")   AS "avg_pct_30_days",
    AVG("total_ltv") AS "avg_total_ltv"
FROM "filtered";
```
