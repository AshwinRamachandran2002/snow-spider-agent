--5) Aggregate payments that occurred in the first 7×24 hours (604 800 seconds)
SELECT DISTINCT
       p."customer_id",
       SUM(CASE WHEN DATEDIFF('second', fp."first_purchase_ts", p."payment_date") 
                     <= 604800 THEN p."amount" END)  AS "ltv_7d"
FROM  SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
JOIN ( SELECT "customer_id", MIN("payment_date") AS "first_purchase_ts"
       FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
       GROUP  BY "customer_id") fp
  ON fp."customer_id" = p."customer_id"
GROUP BY p."customer_id"
LIMIT 20;
