```sql
--Description: Derive first-7-day sales for each customer using exact timestamp difference (604800 seconds)
WITH first_tx AS (
    SELECT 
        p."customer_id",
        MIN(p."payment_date") AS "first_ts"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
    GROUP BY p."customer_id"
)
SELECT
    p."customer_id",
    SUM(p."amount") AS "sales_first_7d"
FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
JOIN first_tx f
  ON p."customer_id" = f."customer_id"
WHERE DATEDIFF('second', f."first_ts", p."payment_date") <= 604800
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--Description: Derive first-30-day sales for each customer using exact timestamp difference (2592000 seconds)
WITH first_tx AS (
    SELECT 
        p."customer_id",
        MIN(p."payment_date") AS "first_ts"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
    GROUP BY p."customer_id"
)
SELECT
    p."customer_id",
    SUM(p."amount") AS "sales_first_30d"
FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
JOIN first_tx f
  ON p."customer_id" = f."customer_id"
WHERE DATEDIFF('second', f."first_ts", p."payment_date") <= 2592000
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--Description: Compute the percentage of LTV that occurred in the first 7 and 30 days for each customer
WITH base AS (
    SELECT 
        p."customer_id",
        MIN(p."payment_date")                                   AS "first_ts",
        SUM(p."amount")                                         AS "total_ltv"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
    GROUP BY p."customer_id"
    HAVING SUM(p."amount") > 0
), win AS (
    SELECT 
        b."customer_id",
        b."total_ltv",
        SUM(CASE WHEN DATEDIFF('second', b."first_ts", p."payment_date") <= 604800  THEN p."amount" ELSE 0 END) AS "ltv_7d",
        SUM(CASE WHEN DATEDIFF('second', b."first_ts", p."payment_date") <= 2592000 THEN p."amount" ELSE 0 END) AS "ltv_30d"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
    JOIN base b ON p."customer_id" = b."customer_id"
    GROUP BY b."customer_id", b."total_ltv"
)
SELECT
    w."customer_id",
    ROUND(w."ltv_7d"  * 100 / w."total_ltv", 2) AS "pct_7d",
    ROUND(w."ltv_30d" * 100 / w."total_ltv", 2) AS "pct_30d",
    w."total_ltv"
FROM win w
ORDER BY w."total_ltv" DESC
LIMIT 20;
```

```sql
--Description: Aggregate the average percentages and average LTV across all qualifying customers
WITH base AS (
    SELECT 
        p."customer_id",
        MIN(p."payment_date")                                   AS "first_ts",
        SUM(p."amount")                                         AS "total_ltv"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
    GROUP BY p."customer_id"
    HAVING SUM(p."amount") > 0
), win AS (
    SELECT 
        b."customer_id",
        b."total_ltv",
        SUM(CASE WHEN DATEDIFF('second', b."first_ts", p."payment_date") <= 604800  THEN p."amount" ELSE 0 END) AS "ltv_7d",
        SUM(CASE WHEN DATEDIFF('second', b."first_ts", p."payment_date") <= 2592000 THEN p."amount" ELSE 0 END) AS "ltv_30d"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
    JOIN base b ON p."customer_id" = b."customer_id"
    GROUP BY b."customer_id", b."total_ltv"
)
SELECT
    ROUND(AVG(ltv_7d  * 100.0 / NULLIF(total_ltv,0)), 2) AS "avg_pct_7d",
    ROUND(AVG(ltv_30d * 100.0 / NULLIF(total_ltv,0)), 2) AS "avg_pct_30d",
    ROUND(AVG(total_ltv), 2)                            AS "avg_total_ltv"
FROM win
LIMIT 20;
```

