```sql
--Description: Display a sample of 20 payments joined with their corresponding rental records,
--             providing basic insight into how payment amounts and rental timing relate.
SELECT 
    pay."payment_id",
    pay."customer_id",
    pay."amount",
    pay."payment_date",
    r."rental_date",
    r."return_date"
FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"  pay
JOIN "SQLITE_SAKILA"."SQLITE_SAKILA"."RENTAL"   r
  ON pay."rental_id" = r."rental_id"
ORDER BY pay."payment_id"
LIMIT 20;
```

```sql
--Description: Summarise payments by staff member—how many transactions each handled and the total
--             dollar amount collected—then list the top 20 collectors.  Removed the redundant
--             DISTINCT keyword (GROUP BY already ensures uniqueness).
SELECT
    pay."staff_id",
    s."first_name" || ' ' || s."last_name" AS "staff_fullname",
    COUNT(*)                               AS "payments_handled",
    SUM(pay."amount")                      AS "total_collected"
FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" pay
JOIN "SQLITE_SAKILA"."SQLITE_SAKILA"."STAFF"   s
  ON pay."staff_id" = s."staff_id"
GROUP BY pay."staff_id", s."first_name", s."last_name"
ORDER BY "total_collected" DESC
LIMIT 20;
```
