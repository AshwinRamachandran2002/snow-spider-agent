--Description: Compute each customer’s 7-day & 30-day LTV percentages and total LTV
WITH base AS (
    SELECT 
        p."customer_id",
        MIN(p."payment_date") AS "first_ts",
        SUM(p."amount")       AS "total_ltv"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
    GROUP BY p."customer_id"
    HAVING SUM(p."amount") > 0
), win AS (
    SELECT 
        b."customer_id",
        b."total_ltv",
        SUM(
            CASE WHEN DATEDIFF('second', b."first_ts", p."payment_date") <= 604800
                 THEN p."amount" ELSE 0 END
        ) AS "ltv_7d",
        SUM(
            CASE WHEN DATEDIFF('second', b."first_ts", p."payment_date") <= 2592000
                 THEN p."amount" ELSE 0 END
        ) AS "ltv_30d"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
    JOIN base b ON p."customer_id" = b."customer_id"
    GROUP BY b."customer_id", b."total_ltv"
)
SELECT
    w."customer_id",
    ROUND(w."ltv_7d"  * 100 / w."total_ltv", 2) AS "pct_7d",
    ROUND(w."ltv_30d" * 100 / w."total_ltv", 2) AS "pct_30d",
    w."total_ltv"
FROM win w
ORDER BY w."total_ltv" DESC
LIMIT 20
