```sql
--Description: 
-- Purpose & thinking process (inline):  
-- 1. Determine each customer’s first purchase timestamp (first_purchase_ts).  
-- 2. Compute total lifetime value (total_ltv) for every customer; filter out those with zero spend.  
-- 3. Calculate 7-day and 30-day sales windows by summing payments that fall within  
--    EXACT 7*24*60*60-second and 30*24*60*60-second ranges after first_purchase_ts.  
-- 4. Join the two window aggregates back to the lifetime table.  
-- 5. Derive per-customer % of LTV captured in 7 and 30 days, then average across customers.  
SELECT  AVG( (c."sales_7d"  / c."total_ltv") * 100 ) AS "avg_pct_ltv_7d",
        AVG( (c."sales_30d" / c."total_ltv") * 100 ) AS "avg_pct_ltv_30d",
        AVG(  c."total_ltv" )                         AS "avg_total_ltv"
FROM  (
        /* ---------- per-customer metrics ---------- */
        SELECT  t."customer_id",
                t."total_ltv",
                COALESCE(s7."sales_7d",  0) AS "sales_7d",
                COALESCE(s30."sales_30d", 0) AS "sales_30d"
        FROM (
              /* Lifetime value per customer (exclude zero) */
              SELECT  "customer_id",
                      SUM("amount") AS "total_ltv"
              FROM    SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
              GROUP   BY "customer_id"
              HAVING  SUM("amount") > 0
             ) t
        /* 7-day window sales */
        LEFT JOIN (
              SELECT  p."customer_id",
                      SUM(p."amount") AS "sales_7d"
              FROM    SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
              JOIN   (SELECT "customer_id",
                             MIN("payment_date") AS "first_purchase_ts"
                      FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
                      GROUP  BY "customer_id") fp
                ON p."customer_id" = fp."customer_id"
              WHERE   p."payment_date" BETWEEN fp."first_purchase_ts"
                                          AND DATEADD('SECOND', 7*24*60*60, fp."first_purchase_ts")
              GROUP   BY p."customer_id"
             ) s7
          ON t."customer_id" = s7."customer_id"
        /* 30-day window sales */
        LEFT JOIN (
              SELECT  p."customer_id",
                      SUM(p."amount") AS "sales_30d"
              FROM    SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT p
              JOIN   (SELECT "customer_id",
                             MIN("payment_date") AS "first_purchase_ts"
                      FROM   SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
                      GROUP  BY "customer_id") fp
                ON p."customer_id" = fp."customer_id"
              WHERE   p."payment_date" BETWEEN fp."first_purchase_ts"
                                          AND DATEADD('SECOND', 30*24*60*60, fp."first_purchase_ts")
              GROUP   BY p."customer_id"
             ) s30
          ON t."customer_id" = s30."customer_id"
      ) c;
