```sql
--Description: 1) Look at a sample of payment records that will be used to build “lifetime value (LTV)” metrics.  
SELECT "payment_id",
       "customer_id",
       "amount",
       "payment_date"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
LIMIT 20;
```

```sql
--Description: 2) Find the first (earliest) purchase moment for every customer – their “customer start date”.  
SELECT "customer_id",
       MIN("payment_date") AS "first_purchase_ts"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
GROUP BY "customer_id"
LIMIT 20;
```

```sql
--Description: 3) Total number of payments each customer ever made (helps see activity spread).  
SELECT "customer_id",
       COUNT(*) AS "payments_cnt"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
GROUP BY "customer_id"
ORDER BY "payments_cnt" DESC
LIMIT 20;
```

```sql
--Description: 4) Total lifetime sales (LTV) – the sum of all payments per customer.  
SELECT "customer_id",
       SUM("amount") AS "total_ltv"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
GROUP BY "customer_id"
ORDER BY "total_ltv" DESC
LIMIT 20;
```

```sql
--Description: 5) Preview 7-day revenue by joining each payment to the customer’s first purchase timestamp and keeping only payments within 7*24 hours.  
SELECT p."customer_id",
       p."amount",
       p."payment_date",
       fp."first_purchase_ts"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT  p
JOIN (
      SELECT "customer_id",
             MIN("payment_date") AS "first_purchase_ts"
      FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
      GROUP BY "customer_id"
) fp
  ON p."customer_id" = fp."customer_id"
WHERE p."payment_date" BETWEEN fp."first_purchase_ts"
                           AND DATEADD('SECOND', 7*24*60*60, fp."first_purchase_ts")
LIMIT 20;
```

```sql
--Description: 6) Aggregate 7-day sales per customer.  
SELECT p."customer_id",
       SUM(p."amount") AS "sales_7d"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT  p
JOIN (
      SELECT "customer_id",
             MIN("payment_date") AS "first_purchase_ts"
      FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
      GROUP BY "customer_id"
) fp
  ON p."customer_id" = fp."customer_id"
WHERE p."payment_date" BETWEEN fp."first_purchase_ts"
                           AND DATEADD('SECOND', 7*24*60*60, fp."first_purchase_ts")
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--Description: 7) Aggregate 30-day sales per customer the same way.  
SELECT p."customer_id",
       SUM(p."amount") AS "sales_30d"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT  p
JOIN (
      SELECT "customer_id",
             MIN("payment_date") AS "first_purchase_ts"
      FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
      GROUP BY "customer_id"
) fp
  ON p."customer_id" = fp."customer_id"
WHERE p."payment_date" BETWEEN fp."first_purchase_ts"
                           AND DATEADD('SECOND', 30*24*60*60, fp."first_purchase_ts")
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--Description: 8) Combine total LTV with 7- and 30-day LTV for each customer (customers with zero LTV are naturally excluded by the SUM > 0 check).  
SELECT tot."customer_id",
       tot."total_ltv",
       COALESCE(s7."sales_7d", 0)  AS "sales_7d",
       COALESCE(s30."sales_30d",0) AS "sales_30d"
FROM (
      SELECT "customer_id",
             SUM("amount") AS "total_ltv"
      FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
      GROUP BY "customer_id"
      HAVING SUM("amount") > 0       -- exclude zero-LTV customers
) tot
LEFT JOIN (
      SELECT p."customer_id",
             SUM(p."amount") AS "sales_7d"
      FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT  p
      JOIN (
            SELECT "customer_id",
                   MIN("payment_date") AS "first_purchase_ts"
            FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
            GROUP BY "customer_id"
      ) fp
        ON p."customer_id" = fp."customer_id"
      WHERE p."payment_date" BETWEEN fp."first_purchase_ts"
                                 AND DATEADD('SECOND', 7*24*60*60, fp."first_purchase_ts")
      GROUP BY p."customer_id"
) s7   ON tot."customer_id" = s7."customer_id"
LEFT JOIN (
      SELECT p."customer_id",
             SUM(p."amount") AS "sales_30d"
      FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT  p
      JOIN (
            SELECT "customer_id",
                   MIN("payment_date") AS "first_purchase_ts"
            FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
            GROUP BY "customer_id"
      ) fp
        ON p."customer_id" = fp."customer_id"
      WHERE p."payment_date" BETWEEN fp."first_purchase_ts"
                                 AND DATEADD('SECOND', 30*24*60*60, fp."first_purchase_ts")
      GROUP BY p."customer_id"
) s30  ON tot."customer_id" = s30."customer_id"
LIMIT 20;
```

```sql
--Description: 9) Calculate the 7- and 30-day percentages of lifetime sales for every customer, keeping the same exclusions.  
SELECT res."customer_id",
       res."total_ltv",
       res."sales_7d",
       res."sales_30d",
       (res."sales_7d"  / res."total_ltv") * 100 AS "pct_7d",
       (res."sales_30d" / res."total_ltv") * 100 AS "pct_30d"
FROM (
      /* re-use the combined table built in step 8 */
      SELECT tot."customer_id",
             tot."total_ltv",
             COALESCE(s7."sales_7d", 0)  AS "sales_7d",
             COALESCE(s30."sales_30d",0) AS "sales_30d"
      FROM (SELECT "customer_id", SUM("amount") AS "total_ltv"
            FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
            GROUP BY "customer_id"
            HAVING SUM("amount") > 0)  tot
      LEFT JOIN (/* 7-day block, same as step 6 */) s7
        ON tot."customer_id" = s7."customer_id"
      LEFT JOIN (/* 30-day block, same as step 7 */) s30
        ON tot."customer_id" = s30."customer_id"
) res
LIMIT 20;
```

```sql
--Description: 10) FINAL – Compute the requested averages across all qualifying customers:  
SELECT AVG((res."sales_7d"  / res."total_ltv") * 100) AS "avg_pct_ltv_7d",
       AVG((res."sales_30d" / res."total_ltv") * 100) AS "avg_pct_ltv_30d",
       AVG(res."total_ltv")                           AS "avg_total_ltv"
FROM (
      /* same sub-query used in step 9 to get per-customer metrics */
      SELECT tot."customer_id",
             tot."total_ltv",
             COALESCE(s7."sales_7d", 0)  AS "sales_7d",
             COALESCE(s30."sales_30d",0) AS "sales_30d"
      FROM (SELECT "customer_id", SUM("amount") AS "total_ltv"
            FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
            GROUP BY "customer_id"
            HAVING SUM("amount") > 0)  tot
      LEFT JOIN (/* 7-day block, same as step 6 */)  s7
        ON tot."customer_id" = s7."customer_id"
      LEFT JOIN (/* 30-day block, same as step 7 */) s30
        ON tot."customer_id" = s30."customer_id"
) res;
```
