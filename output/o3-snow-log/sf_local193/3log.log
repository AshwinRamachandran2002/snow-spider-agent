Query:
--Description: 5) Preview 7-day revenue by joining each payment to the customer’s first purchase timestamp and keeping only payments within 7*24 hours.  
SELECT p."customer_id",
       p."amount",
       p."payment_date",
       fp."first_purchase_ts"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT  p
JOIN (
      SELECT "customer_id",
             MIN("payment_date") AS "first_purchase_ts"
      FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
      GROUP BY "customer_id"
) fp
  ON p."customer_id" = fp."customer_id"
WHERE p."payment_date" BETWEEN fp."first_purchase_ts"
                           AND DATEADD('SECOND', 7*24*60*60, fp."first_purchase_ts")
LIMIT 20;
