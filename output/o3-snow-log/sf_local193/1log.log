```sql
--Description: Peek at the main monetary facts we will need – amounts and their timestamps
SELECT "payment_id",
       "customer_id",
       "amount",
       "payment_date"
FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
LIMIT 20;
```

```sql
--Description: Find each customer’s very first payment time (we will call this the “cohort start”)
SELECT "customer_id",
       MIN("payment_date") AS "first_payment_date"
FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
GROUP BY "customer_id"
LIMIT 20;
```

```sql
--Description: Compute lifetime sales (LTV) for every customer
SELECT "customer_id",
       SUM("amount") AS "lifetime_sales"
FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
GROUP BY "customer_id"
LIMIT 20;
```

```sql
--Description: Keep only customers whose lifetime sales are greater than zero
SELECT DISTINCT p."customer_id"
FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"  p
GROUP BY p."customer_id"
HAVING SUM(p."amount") > 0
LIMIT 20;
```

```sql
--Description: Calculate sales that occur during the first 7-day (= 604800-second) window
SELECT  p."customer_id",
        SUM(p."amount") AS "sales_first_7d"
FROM    "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"          p
JOIN   (SELECT "customer_id",
               MIN("payment_date") AS "first_payment_date"
        FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
        GROUP BY "customer_id") fp
      ON p."customer_id" = fp."customer_id"
WHERE  TO_TIMESTAMP(p."payment_date") 
       <= TO_TIMESTAMP(fp."first_payment_date") + INTERVAL '604800 seconds'
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--Description: Calculate sales that occur during the first 30-day (= 2592000-second) window
SELECT  p."customer_id",
        SUM(p."amount") AS "sales_first_30d"
FROM    "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"          p
JOIN   (SELECT "customer_id",
               MIN("payment_date") AS "first_payment_date"
        FROM   "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
        GROUP BY "customer_id") fp
      ON p."customer_id" = fp."customer_id"
WHERE  TO_TIMESTAMP(p."payment_date") 
       <= TO_TIMESTAMP(fp."first_payment_date") + INTERVAL '2592000 seconds'
GROUP BY p."customer_id"
LIMIT 20;
```

```sql
--Description: Bring lifetime, 7-day, and 30-day sales together for each eligible customer
WITH lt  AS (SELECT "customer_id", SUM("amount") AS "lifetime_sales"
             FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
             GROUP BY "customer_id"),
     s7  AS (SELECT p."customer_id", SUM(p."amount") AS "sales_first_7d"
             FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
             JOIN (SELECT "customer_id", MIN("payment_date") AS "first_payment_date"
                   FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
                   GROUP BY "customer_id") fp
               ON p."customer_id" = fp."customer_id"
             WHERE TO_TIMESTAMP(p."payment_date") 
                   <= TO_TIMESTAMP(fp."first_payment_date") + INTERVAL '604800 seconds'
             GROUP BY p."customer_id"),
     s30 AS (SELECT p."customer_id", SUM(p."amount") AS "sales_first_30d"
             FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
             JOIN (SELECT "customer_id", MIN("payment_date") AS "first_payment_date"
                   FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
                   GROUP BY "customer_id") fp
               ON p."customer_id" = fp."customer_id"
             WHERE TO_TIMESTAMP(p."payment_date") 
                   <= TO_TIMESTAMP(fp."first_payment_date") + INTERVAL '2592000 seconds'
             GROUP BY p."customer_id")
SELECT lt."customer_id",
       lt."lifetime_sales",
       COALESCE(s7."sales_first_7d", 0)  AS "sales_first_7d",
       COALESCE(s30."sales_first_30d",0) AS "sales_first_30d"
FROM   lt
LEFT  JOIN s7  ON lt."customer_id" = s7."customer_id"
LEFT  JOIN s30 ON lt."customer_id" = s30."customer_id"
WHERE  lt."lifetime_sales" > 0
LIMIT 20;
```

```sql
--Description: Compute per-customer percentages of lifetime sales captured in the first 7 and 30 days
WITH cust_sales AS (   /* same CTE as previous query */
    SELECT lt."customer_id",
           lt."lifetime_sales",
           COALESCE(s7."sales_first_7d", 0)  AS "sales_first_7d",
           COALESCE(s30."sales_first_30d",0) AS "sales_first_30d"
    FROM  (SELECT "customer_id", SUM("amount") AS "lifetime_sales"
           FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
           GROUP BY "customer_id")               lt
    LEFT JOIN (
           SELECT p."customer_id", SUM(p."amount") AS "sales_first_7d"
           FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
           JOIN (SELECT "customer_id", MIN("payment_date") AS "first_payment_date"
                 FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
                 GROUP BY "customer_id") fp
             ON p."customer_id" = fp."customer_id"
           WHERE TO_TIMESTAMP(p."payment_date") 
                 <= TO_TIMESTAMP(fp."first_payment_date") + INTERVAL '604800 seconds'
           GROUP BY p."customer_id")             s7
      ON lt."customer_id" = s7."customer_id"
    LEFT JOIN (
           SELECT p."customer_id", SUM(p."amount") AS "sales_first_30d"
           FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
           JOIN (SELECT "customer_id", MIN("payment_date") AS "first_payment_date"
                 FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
                 GROUP BY "customer_id") fp
             ON p."customer_id" = fp."customer_id"
           WHERE TO_TIMESTAMP(p."payment_date") 
                 <= TO_TIMESTAMP(fp."first_payment_date") + INTERVAL '2592000 seconds'
           GROUP BY p."customer_id")             s30
      ON lt."customer_id" = s30."customer_id"
    WHERE lt."lifetime_sales" > 0
)
SELECT "customer_id",
       "lifetime_sales",
       "sales_first_7d",
       "sales_first_30d",
       ROUND("sales_first_7d"  / "lifetime_sales", 4) AS "pct_first_7d",
       ROUND("sales_first_30d" / "lifetime_sales", 4) AS "pct_first_30d"
FROM   cust_sales
LIMIT 20;
```

```sql
--Description: Finally, average the percentages and the lifetime sales across all qualifying customers
WITH cust_sales AS (   /* same construction as previous step */
    SELECT lt."customer_id",
           lt."lifetime_sales",
           COALESCE(s7."sales_first_7d", 0)  AS "sales_first_7d",
           COALESCE(s30."sales_first_30d",0) AS "sales_first_30d"
    FROM  (SELECT "customer_id", SUM("amount") AS "lifetime_sales"
           FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
           GROUP BY "customer_id")               lt
    LEFT JOIN (
           SELECT p."customer_id", SUM(p."amount") AS "sales_first_7d"
           FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
           JOIN (SELECT "customer_id", MIN("payment_date") AS "first_payment_date"
                 FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
                 GROUP BY "customer_id") fp
             ON p."customer_id" = fp."customer_id"
           WHERE TO_TIMESTAMP(p."payment_date") 
                 <= TO_TIMESTAMP(fp."first_payment_date") + INTERVAL '604800 seconds'
           GROUP BY p."customer_id")             s7
      ON lt."customer_id" = s7."customer_id"
    LEFT JOIN (
           SELECT p."customer_id", SUM(p."amount") AS "sales_first_30d"
           FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
           JOIN (SELECT "customer_id", MIN("payment_date") AS "first_payment_date"
                 FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
                 GROUP BY "customer_id") fp
             ON p."customer_id" = fp."customer_id"
           WHERE TO_TIMESTAMP(p."payment_date") 
                 <= TO_TIMESTAMP(fp."first_payment_date") + INTERVAL '2592000 seconds'
           GROUP BY p."customer_id")             s30
      ON lt."customer_id" = s30."customer_id"
    WHERE lt."lifetime_sales" > 0
)
SELECT ROUND(AVG("sales_first_7d"  / "lifetime_sales"), 4) AS "avg_pct_first_7d",
       ROUND(AVG("sales_first_30d" / "lifetime_sales"), 4) AS "avg_pct_first_30d",
       ROUND(AVG("lifetime_sales"), 2)                    AS "avg_lifetime_sales"
FROM   cust_sales;
```
