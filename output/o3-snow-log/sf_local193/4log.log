    SELECT "customer_id",
           MIN("payment_ts") AS "first_purchase_ts"
    FROM payments_ts
    GROUP BY "customer_id"
),
ltv AS (
    SELECT "customer_id",
           SUM("amount") AS "ltv_total"
    FROM payments_ts
    GROUP BY "customer_id"
    HAVING SUM("amount") > 0
),
d7 AS (
    SELECT p."customer_id",
           SUM(p."amount") AS "sales_7d"
    FROM payments_ts p
    JOIN firsts f ON p."customer_id" = f."customer_id"
    WHERE p."payment_ts" <= DATEADD(day, 7, f."first_purchase_ts")
    GROUP BY p."customer_id"
),
d30 AS (
    SELECT p."customer_id",
           SUM(p."amount") AS "sales_30d"
    FROM payments_ts p
    JOIN firsts f ON p."customer_id" = f."customer_id"
    WHERE p."payment_ts" <= DATEADD(day, 30, f."first_purchase_ts")
    GROUP BY p."customer_id"
),
percents AS (
    SELECT l."customer_id",
           COALESCE(d7."sales_7d",  0) / l."ltv_total" AS "pct_7d",
           COALESCE(d30."sales_30d",0) / l."ltv_total" AS "pct_30d",
           l."ltv_total"
    FROM ltv l
    LEFT JOIN d7  ON l."customer_id" = d7."customer_id"
    LEFT JOIN d30 ON l."customer_id" = d30."customer_id"
)
SELECT
    AVG("pct_7d")   AS "avg_pct_7d",
    AVG("pct_30d")  AS "avg_pct_30d",
    AVG("ltv_total") AS "avg_ltv"
FROM percents
LIMIT 20;
