--Description:
-- Purpose: produce three final metrics in one shot:
--   1) average % of lifetime sales made within 7×24 h after first purchase
--   2) average % of lifetime sales made within 30×24 h after first purchase
--   3) average customer lifetime sales (LTV)
-- ---------------------------------------------------------------------------
-- Thinking process (annotated inline):
--  • Step-0: convert text "payment_date" to a real TIMESTAMP once (payments_ts).
--  • Step-1: firsts  – identify each customer’s first‐ever purchase moment.
--  • Step-2: ltv     – sum total $ per customer; filter out zero-LTV customers.
--  • Step-3: sales_7d / sales_30d – sum amounts whose timestamps fall inside
--             precise 7-day and 30-day windows (DATEADD used for exact hrs).
--  • Step-4: per_customer – compute percentages (sales_7d / ltv, sales_30d / ltv).
--  • Step-5: final SELECT – average those per-customer metrics across population.
WITH payments_ts AS (   -- Step-0
    SELECT
        "customer_id",
        "amount",
        TO_TIMESTAMP("payment_date") AS "payment_ts"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
),
firsts AS (             -- Step-1
    SELECT
        "customer_id",
        MIN("payment_ts") AS "first_purchase_ts"
    FROM payments_ts
    GROUP BY "customer_id"
),
ltv AS (                -- Step-2
    SELECT
        "customer_id",
        SUM("amount") AS "ltv_total"
    FROM payments_ts
    GROUP BY "customer_id"
    HAVING SUM("amount") > 0
),
sales_7d AS (           -- Step-3 (7-day window)
    SELECT
        p."customer_id",
        SUM(p."amount") AS "sales_7d"
    FROM payments_ts p
    JOIN firsts f ON p."customer_id" = f."customer_id"
    WHERE p."payment_ts" <= DATEADD(day, 7, f."first_purchase_ts")
    GROUP BY p."customer_id"
),
sales_30d AS (          -- Step-3 (30-day window)
    SELECT
        p."customer_id",
        SUM(p."amount") AS "sales_30d"
    FROM payments_ts p
    JOIN firsts f ON p."customer_id" = f."customer_id"
    WHERE p."payment_ts" <= DATEADD(day, 30, f."first_purchase_ts")
    GROUP BY p."customer_id"
),
per_customer AS (       -- Step-4
    SELECT
        l."customer_id",
        COALESCE(s7."sales_7d",  0) / l."ltv_total" AS "pct_7d",
        COALESCE(s30."sales_30d", 0) / l."ltv_total" AS "pct_30d",
        l."ltv_total"
    FROM ltv l
    LEFT JOIN sales_7d  s7  ON l."customer_id" = s7."customer_id"
    LEFT JOIN sales_30d s30 ON l."customer_id" = s30."customer_id"
)
SELECT                   -- Step-5 (final answer)
    AVG("pct_7d")    AS "avg_pct_7d",
    AVG("pct_30d")   AS "avg_pct_30d",
    AVG("ltv_total") AS "avg_ltv"
FROM per_customer;
