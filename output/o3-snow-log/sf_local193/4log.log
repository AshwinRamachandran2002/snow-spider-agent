Query:
--Description: 30-day sales per customer, using TIMESTAMP conversion and DATEADD for an exact 30×24-hour window
WITH firsts AS (
    SELECT
        "customer_id",
        MIN(TO_TIMESTAMP("payment_date")) AS "first_purchase_ts"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
    GROUP BY "customer_id"
)
SELECT
    p."customer_id",
    SUM(p."amount") AS "sales_30d"
FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
JOIN firsts f
  ON p."customer_id" = f."customer_id"
WHERE TO_TIMESTAMP(p."payment_date") <= DATEADD(day, 30, f."first_purchase_ts")
GROUP BY p."customer_id"
LIMIT 20
