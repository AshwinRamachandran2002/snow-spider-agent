```sql
--Description:
-- We need one query that returns three figures:
--   • average % of lifetime sales captured in the first 7 days
--   • average % of lifetime sales captured in the first 30 days
--   • average total lifetime sales (LTV) per customer
--
-- Key considerations / thinking process
-- 1. “payment_date” is stored as TEXT, so convert to TIMESTAMP via TO_TIMESTAMP().
-- 2. “Lifetime” sales = total SUM(amount) per customer (exclude zero-LTV customers).
-- 3. First purchase moment = MIN(payment_date) per customer.
-- 4. 7-day / 30-day windows are exact 7*24 and 30*24 hours after that first timestamp,
--    so use DATEADD(day, 7|30, first_purchase_ts).
-- 5. Compute per-customer percentages sales_7d / ltv_total and sales_30d / ltv_total.
-- 6. Finally AVG() those percentages and the LTV itself across the population.
WITH firsts AS (
    SELECT
        "customer_id",
        MIN(TO_TIMESTAMP("payment_date")) AS "first_purchase_ts"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
    GROUP BY "customer_id"
),
ltv AS (
    SELECT
        "customer_id",
        SUM("amount") AS "ltv_total"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
    GROUP BY "customer_id"
    HAVING SUM("amount") > 0      -- exclude zero-LTV customers
),
sales_7d AS (
    SELECT
        p."customer_id",
        SUM(p."amount") AS "sales_7d"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
    JOIN firsts f ON p."customer_id" = f."customer_id"
    WHERE TO_TIMESTAMP(p."payment_date")
          <= DATEADD(day, 7, f."first_purchase_ts")
    GROUP BY p."customer_id"
),
sales_30d AS (
    SELECT
        p."customer_id",
        SUM(p."amount") AS "sales_30d"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
    JOIN firsts f ON p."customer_id" = f."customer_id"
    WHERE TO_TIMESTAMP(p."payment_date")
          <= DATEADD(day, 30, f."first_purchase_ts")
    GROUP BY p."customer_id"
),
percentages AS (
    SELECT
        l."customer_id",
        COALESCE(s7."sales_7d",  0) / l."ltv_total" AS pct_7d,
        COALESCE(s30."sales_30d",0) / l."ltv_total" AS pct_30d,
        l."ltv_total"
    FROM ltv l
    LEFT JOIN sales_7d  s7  ON l."customer_id" = s7."customer_id"
    LEFT JOIN sales_30d s30 ON l."customer_id" = s30."customer_id"
)
SELECT
    AVG(pct_7d)  AS avg_pct_7d,
    AVG(pct_30d) AS avg_pct_30d,
    AVG(ltv_total) AS avg_ltv
FROM percentages;
```
