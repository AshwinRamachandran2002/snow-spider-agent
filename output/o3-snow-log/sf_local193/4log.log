```sql
--Description: Combine lifetime, 7-day, and 30-day sales to compute per-customer percentages of LTV.
WITH firsts AS (
    SELECT "customer_id",
           MIN("payment_date") AS "first_purchase_ts"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
    GROUP BY "customer_id"
),
ltv AS (
    SELECT "customer_id",
           SUM("amount") AS "ltv_total"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
    GROUP BY "customer_id"
    HAVING SUM("amount") > 0
),
d7 AS (
    SELECT p."customer_id",
           SUM(p."amount") AS "sales_7d"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
    JOIN firsts f ON p."customer_id" = f."customer_id"
    WHERE p."payment_date" <= f."first_purchase_ts" + INTERVAL '7 days'
    GROUP BY p."customer_id"
),
d30 AS (
    SELECT p."customer_id",
           SUM(p."amount") AS "sales_30d"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT" p
    JOIN firsts f ON p."customer_id" = f."customer_id"
    WHERE p."payment_date" <= f."first_purchase_ts" + INTERVAL '30 days'
    GROUP BY p."customer_id"
)
SELECT l."customer_id",
       l."ltv_total",
       COALESCE(d7."sales_7d",0)  / l."ltv_total" AS "pct_7d",
       COALESCE(d30."sales_30d",0) / l."ltv_total" AS "pct_30d"
