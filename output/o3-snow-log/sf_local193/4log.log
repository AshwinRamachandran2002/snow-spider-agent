Query:
--Description: Combine lifetime, 7-day, and 30-day sales per customer (all TIMESTAMP-safe) and return percentages
WITH payments_ts AS (
    SELECT "customer_id",
           "amount",
           TO_TIMESTAMP("payment_date") AS "payment_ts"
    FROM "SQLITE_SAKILA"."SQLITE_SAKILA"."PAYMENT"
),
firsts AS (
    SELECT "customer_id",
           MIN("payment_ts") AS "first_purchase_ts"
    FROM payments_ts
    GROUP BY "customer_id"
),
ltv AS (
    SELECT "customer_id",
           SUM("amount") AS "ltv_total"
    FROM payments_ts
    GROUP BY "customer_id"
    HAVING SUM("amount") > 0
),
d7 AS (
    SELECT p."customer_id",
           SUM(p."amount") AS "sales_7d"
    FROM payments_ts p
    JOIN firsts f ON p."customer_id" = f."customer_id"
    WHERE p."payment_ts" <= DATEADD(day, 7, f."first_purchase_ts")
    GROUP BY p."customer_id"
),
d30 AS (
    SELECT p."customer_id",
           SUM(p."amount") AS "sales_30d"
    FROM payments_ts p
    JOIN firsts f ON p."customer_id" = f."customer_id"
    WHERE p."payment_ts" <= DATEADD(day, 30, f."first_purchase_ts")
    GROUP BY p."customer_id"
)
SELECT
    l."customer_id",
    l."ltv_total",
