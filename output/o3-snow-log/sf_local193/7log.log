```sql
--Description: Preview a handful of payment transactions with the key columns we will use for LTV work.
SELECT 
    "payment_id",
    "customer_id",
    "amount",
    "payment_date",
    "staff_id",
    "rental_id"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
ORDER BY "payment_id"
LIMIT 20;
```

```sql
--Description: List some distinct customers that actually have at least one payment record.
SELECT DISTINCT 
    "customer_id"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
LIMIT 20;
```

```sql
--Description: For every customer, show the number of payments and the total lifetime sales (LTV) so far.
SELECT
    "customer_id",
    COUNT(*)                       AS "payment_count",
    SUM("amount")                  AS "total_lifetime_sales"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
GROUP BY "customer_id"
ORDER BY "total_lifetime_sales" DESC
LIMIT 20;
```

```sql
--Description: Find each customer’s first and last payment-date to understand the lifetime span.
SELECT
    "customer_id",
    MIN("payment_date") AS "first_payment",
    MAX("payment_date") AS "last_payment"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
GROUP BY "customer_id"
LIMIT 20;
```

```sql
--Description: For one sample customer (#1), list all payments and the hours since that customer’s first purchase.
SELECT
    "payment_id",
    "customer_id",
    "amount",
    "payment_date",
    DATEDIFF('second',
             MIN("payment_date") OVER (PARTITION BY "customer_id"),
             "payment_date") / 3600.0  AS "hours_since_first"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
WHERE "customer_id" = 1
ORDER BY "payment_date"
LIMIT 20;
```

```sql
--Description: Per customer, calculate LTV in the first 7 days (168 hrs) and total LTV.
WITH first_pay AS (
    SELECT
        "payment_id",
        "customer_id",
        "amount",
        "payment_date",
        MIN("payment_date") OVER (PARTITION BY "customer_id") AS "first_payment_date"
    FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
)
SELECT
    "customer_id",
    SUM(CASE WHEN DATEDIFF('second',"first_payment_date","payment_date") <= 7*24*3600 
             THEN "amount" ELSE 0 END)                    AS "ltv_7d",
    SUM("amount")                                         AS "total_ltv"
FROM first_pay
GROUP BY "customer_id"
LIMIT 20;
```

```sql
--Description: Per customer, calculate LTV in the first 30 days (720 hrs) alongside total LTV.
WITH first_pay AS (
    SELECT
        "payment_id",
        "customer_id",
        "amount",
        "payment_date",
        MIN("payment_date") OVER (PARTITION BY "customer_id") AS "first_payment_date"
    FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
)
SELECT
    "customer_id",
    SUM(CASE WHEN DATEDIFF('second',"first_payment_date","payment_date") <= 30*24*3600 
             THEN "amount" ELSE 0 END)                   AS "ltv_30d",
    SUM("amount")                                        AS "total_ltv"
FROM first_pay
GROUP BY "customer_id"
LIMIT 20;
```

```sql
--Description: Compute the average % of total LTV captured in the first 7 days and 30 days,
--             plus the average total LTV, excluding customers with zero lifetime sales.
WITH first_pay AS (
    SELECT
        "payment_id",
        "customer_id",
        "amount",
        "payment_date",
        MIN("payment_date") OVER (PARTITION BY "customer_id") AS "first_payment_date"
    FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
),
agg AS (
    SELECT
        "customer_id",
        SUM(CASE WHEN DATEDIFF('second',"first_payment_date","payment_date") <= 7*24*3600 
                 THEN "amount" ELSE 0 END)               AS "ltv_7d",
        SUM(CASE WHEN DATEDIFF('second',"first_payment_date","payment_date") <= 30*24*3600 
                 THEN "amount" ELSE 0 END)               AS "ltv_30d",
        SUM("amount")                                    AS "total_ltv"
    FROM first_pay
    GROUP BY "customer_id"
)
SELECT
    AVG("ltv_7d"  / "total_ltv")  AS "avg_pct_7d",
    AVG("ltv_30d" / "total_ltv")  AS "avg_pct_30d",
    AVG("total_ltv")              AS "avg_total_ltv"
FROM agg
WHERE "total_ltv" > 0
LIMIT 20;
```

```sql
--Description: Quick count of how many customers will be excluded (zero-LTV) vs included.
WITH lifetime AS (
    SELECT 
        "customer_id", 
        SUM("amount") AS "total_ltv"
    FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT
    GROUP BY "customer_id"
)
SELECT 
    COUNT(*)                                                   AS "customers_with_ltv",
    SUM(CASE WHEN "total_ltv" = 0 THEN 1 ELSE 0 END)          AS "zero_ltv_customers"
FROM lifetime
LIMIT 20;
```

```sql
--Description: Join a few payment records to their rental records to verify the date linkage.
SELECT
    p."payment_id",
    p."customer_id",
    r."rental_date",
    p."payment_date",
    p."amount"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT  p
JOIN SQLITE_SAKILA.SQLITE_SAKILA.RENTAL   r
      ON p."rental_id" = r."rental_id"
ORDER BY p."payment_id"
LIMIT 20;
```
