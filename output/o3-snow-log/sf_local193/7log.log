Query:
--Description: Join a few payment records to their rental records to verify the date linkage.
SELECT
    p."payment_id",
    p."customer_id",
    r."rental_date",
    p."payment_date",
    p."amount"
FROM SQLITE_SAKILA.SQLITE_SAKILA.PAYMENT  p
JOIN SQLITE_SAKILA.SQLITE_SAKILA.RENTAL   r
      ON p."rental_id" = r."rental_id"
ORDER BY p."payment_id"
LIMIT 20;
