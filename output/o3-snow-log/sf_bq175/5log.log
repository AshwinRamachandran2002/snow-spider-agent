/*  Top-11 chromosome-1 cytobands in the TCGA-KIRC gene-level copy-number
    file whose Amplification, Gain, and Heterozygous-Deletion counts
    all fall within the top eleven of their respective classes          */
WITH classified AS (   -- add CNV class per row, skip rows with no class
    SELECT
        c."cytoband_name",
        CASE
             WHEN COALESCE(g."max_copy_number", g."copy_number") > 3 THEN 'Amplification'
             WHEN COALESCE(g."max_copy_number", g."copy_number") = 3 THEN 'Gain'
             WHEN COALESCE(g."max_copy_number", g."copy_number") = 1 THEN 'Heterozygous Deletion'
             ELSE NULL
        END AS "alteration_type"
    FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
    JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38                               c
           ON  g."chromosome" = c."chromosome"
           AND g."start_pos"  <= c."hg38_stop"
           AND g."end_pos"    >= c."hg38_start"
    WHERE  g."project_short_name" = 'TCGA-KIRC'
      AND  g."chromosome"        = 'chr1'
      AND  COALESCE(g."max_copy_number", g."copy_number") IS NOT NULL
),
freq AS (                 -- count events per cytoband & alteration class
    SELECT
        "cytoband_name",
        "alteration_type",
        COUNT(*) AS "freq"
    FROM   classified
    WHERE  "alteration_type" IS NOT NULL
    GROUP  BY "cytoband_name", "alteration_type"
),
ranked AS (               -- rank cytobands within each class by frequency
    SELECT
        "cytoband_name",
        "alteration_type",
        "freq",
        RANK() OVER (PARTITION BY "alteration_type"
                     ORDER BY "freq" DESC NULLS LAST) AS "freq_rank"
    FROM   freq
),
top11 AS (                -- keep only ranks ≤ 11
    SELECT "cytoband_name",
           "alteration_type"
    FROM   ranked
    WHERE  "freq_rank" <= 11
)
/*  Cytobands that appear in the top-11 list for ALL three classes        */
SELECT   "cytoband_name"
FROM     top11
GROUP BY "cytoband_name"
HAVING   COUNT(DISTINCT "alteration_type") = 3
ORDER BY "cytoband_name";
```
