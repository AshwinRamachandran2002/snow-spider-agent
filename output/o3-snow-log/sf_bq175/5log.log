```sql
WITH freq AS (
    /* 1.  Count events per cytoband & alteration class                     */
    SELECT
        c."cytoband_name",
        CASE
            WHEN g."max_copy_number" > 3 THEN 'Amplification'
            WHEN g."max_copy_number" = 3 THEN 'Gain'
            WHEN g."max_copy_number" = 1 THEN 'Heterozygous Deletion'
        END                                                   AS "alteration_type",
        COUNT(*)                                              AS "freq"
    FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
    JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38                               c
           ON  g."chromosome" = c."chromosome"
           AND g."start_pos"  <= c."hg38_stop"
           AND g."end_pos"    >= c."hg38_start"
    WHERE  g."project_short_name" = 'TCGA-KIRC'
      AND  g."chromosome"        = 'chr1'
      AND (g."max_copy_number" IN (1,3) OR g."max_copy_number" > 3)  -- keep only the three classes
    GROUP BY c."cytoband_name", "alteration_type"
),
/* 2.  Rank cytobands within each alteration class by frequency            */
ranked AS (
    SELECT
        "cytoband_name",
        "alteration_type",
        "freq",
        RANK() OVER (PARTITION BY "alteration_type"
                     ORDER BY "freq" DESC NULLS LAST)        AS "freq_rank"
    FROM   freq
),
/* 3.  Keep only cytobands that are top-11 for each class                  */
top11 AS (
    SELECT "cytoband_name",
           "alteration_type"
    FROM   ranked
    WHERE  "freq_rank" <= 11
)
/* 4.  Cytobands that satisfy the criterion for ALL three classes          */
SELECT   "cytoband_name"
FROM     top11
GROUP BY "cytoband_name"
HAVING   COUNT(DISTINCT "alteration_type") = 3   -- must appear in Amplification, Gain, HetDel
ORDER BY "cytoband_name";
```
