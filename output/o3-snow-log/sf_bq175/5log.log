WHERE  "chromosome" = 'chr1'
LIMIT 20;
```

```sql
--Description: 5)  Map TCGA-KIRC chr1 segments to overlapping cytobands (quick sample)  
SELECT g."start_pos",
       g."end_pos",
       c."cytoband_name"
FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36"  g
JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"                                c
  ON   g."chromosome" = c."chromosome"
 AND   g."start_pos"  <= c."hg38_stop"
 AND   g."end_pos"    >= c."hg38_start"
WHERE  g."project_short_name" = 'TCGA-KIRC'
  AND  g."chromosome"        = 'chr1'
LIMIT 20;
```

```sql
--Description: 6)  Add alteration category (Amplification, Gain, HetDel) to the join  
SELECT c."cytoband_name",
       CASE WHEN g."max_copy_number" > 3 THEN 'Amplification'
            WHEN g."max_copy_number" = 3 THEN 'Gain'
            WHEN g."max_copy_number" = 1 THEN 'Heterozygous Deletion'
            ELSE 'Other' END AS "alteration_type"
FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36"  g
JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"                                c
  ON   g."chromosome" = c."chromosome"
 AND   g."start_pos"  <= c."hg38_stop"
 AND   g."end_pos"    >= c."hg38_start"
WHERE  g."project_short_name" = 'TCGA-KIRC'
  AND  g."chromosome"        = 'chr1'
LIMIT 20;
```

```sql
--Description: 7)  Count the frequency of each alteration type per cytoband  
SELECT c."cytoband_name",
       CASE WHEN g."max_copy_number" > 3 THEN 'Amplification'
            WHEN g."max_copy_number" = 3 THEN 'Gain'
            WHEN g."max_copy_number" = 1 THEN 'Heterozygous Deletion'
            ELSE 'Other' END AS "alteration_type",
       COUNT(*) AS "freq"
FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36"  g
JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"                                c
  ON   g."chromosome" = c."chromosome"
 AND   g."start_pos"  <= c."hg38_stop"
 AND   g."end_pos"    >= c."hg38_start"
WHERE  g."project_short_name" = 'TCGA-KIRC'
  AND  g."chromosome"        = 'chr1'
GROUP BY c."cytoband_name", "alteration_type"
LIMIT 20;
```

```sql
--Description: 8)  Rank cytobands by frequency within each alteration category  
WITH freq AS (
    SELECT c."cytoband_name",
           CASE WHEN g."max_copy_number" > 3 THEN 'Amplification'
                WHEN g."max_copy_number" = 3 THEN 'Gain'
                WHEN g."max_copy_number" = 1 THEN 'Heterozygous Deletion'
                ELSE 'Other' END AS "alteration_type",
           COUNT(*) AS "freq"
    FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36"  g
    JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"                                c
      ON   g."chromosome" = c."chromosome"
     AND   g."start_pos"  <= c."hg38_stop"
     AND   g."end_pos"    >= c."hg38_start"
    WHERE  g."project_short_name" = 'TCGA-KIRC'
      AND  g."chromosome"        = 'chr1'
    GROUP BY c."cytoband_name", "alteration_type"
)
SELECT "cytoband_name",
       "alteration_type",
       "freq",
       RANK() OVER (PARTITION BY "alteration_type" ORDER BY "freq" DESC) AS "freq_rank"
FROM   freq
LIMIT 20;
```

```sql
--Description: 9)  Keep only cytobands that rank within the top 11 for each alteration type  
WITH freq AS (
    SELECT c."cytoband_name",
           CASE WHEN g."max_copy_number" > 3 THEN 'Amplification'
                WHEN g."max_copy_number" = 3 THEN 'Gain'
                WHEN g."max_copy_number" = 1 THEN 'Heterozygous Deletion'
                ELSE 'Other' END AS "alteration_type",
           COUNT(*) AS "freq"
    FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36"  g
    JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"                                c
      ON   g."chromosome" = c."chromosome"
     AND   g."start_pos"  <= c."hg38_stop"
     AND   g."end_pos"    >= c."hg38_start"
    WHERE  g."project_short_name" = 'TCGA-KIRC'
      AND  g."chromosome"        = 'chr1'
    GROUP BY c."cytoband_name", "alteration_type"
),
ranked AS (
    SELECT "cytoband_name",
           "alteration_type",
           "freq",
           RANK() OVER (PARTITION BY "alteration_type" ORDER BY "freq" DESC) AS "freq_rank"
    FROM   freq
)
SELECT *
FROM   ranked
WHERE  "freq_rank" <= 11
LIMIT 20;
```

```sql
--Description: 10)  Final intersection: cytobands ranking in the top 11 for Amplification, Gain, and Het Deletion  
WITH freq AS (
    SELECT c."cytoband_name",
           CASE WHEN g."max_copy_number" > 3 THEN 'Amplification'
                WHEN g."max_copy_number" = 3 THEN 'Gain'
                WHEN g."max_copy_number" = 1 THEN 'Heterozygous Deletion'
                ELSE 'Other' END AS "alteration_type",
           COUNT(*) AS "freq"
    FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36"  g
    JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"                                c
      ON   g."chromosome" = c."chromosome"
     AND   g."start_pos"  <= c."hg38_stop"
     AND   g."end_pos"    >= c."hg38_start"
    WHERE  g."project_short_name" = 'TCGA-KIRC'
      AND  g."chromosome"        = 'chr1'
    GROUP BY c."cytoband_name", "alteration_type"
),
ranked AS (
    SELECT "cytoband_name",
           "alteration_type",
           RANK() OVER (PARTITION BY "alteration_type" ORDER BY "freq" DESC) AS "freq_rank"
    FROM   freq
    WHERE  "alteration_type" IN ('Amplification','Gain','Heterozygous Deletion')
)
SELECT DISTINCT "cytoband_name"
FROM   ranked
WHERE  "freq_rank" <= 11
GROUP BY "cytoband_name"
HAVING COUNT(DISTINCT "alteration_type") = 3
LIMIT 20;
```
