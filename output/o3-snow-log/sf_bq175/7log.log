```sql
/*  List the Top-11 cytobands (by event frequency) on chromosome 1
    for each of the three copy-number event classes—Amplification (>3 copies),
    Gain (=3 copies) and Heterozygous Deletion (=1 copy)—in the TCGA-KIRC
    gene-level copy-number dataset.                                       */

WITH segments AS (   -- chr1 segments from TCGA-KIRC with 1 / 3 / >3 copies
    SELECT  "chromosome",
            "start_pos",
            "max_copy_number"
    FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
    WHERE  "project_short_name" LIKE 'TCGA-KIRC%'         -- tolerate trailing chars
      AND  "chromosome"          = 'chr1'
      AND  "max_copy_number" IN (1,3,4,5,6,7,8,9,10)
),

cyto_mapped AS (      -- map each segment to its cytoband & classify event
    SELECT  c."cytoband_name",
            CASE
                WHEN s."max_copy_number" > 3 THEN 'Amplification'
                WHEN s."max_copy_number" = 3 THEN 'Gain'
                WHEN s."max_copy_number" = 1 THEN 'HeterozygousDeletion'
            END AS event_type
    FROM   segments s
    JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
      ON   s."chromosome" = c."chromosome"
     AND   s."start_pos"  BETWEEN c."hg38_start" AND c."hg38_stop"
    WHERE  s."max_copy_number" IN (1,3,4,5,6,7,8,9,10)
      AND  (s."max_copy_number" = 1 OR s."max_copy_number" = 3 OR s."max_copy_number" > 3)
),

event_counts AS (     -- event frequency per cytoband
    SELECT  event_type,
            "cytoband_name",
            COUNT(*) AS freq
    FROM   cyto_mapped
    WHERE  event_type IS NOT NULL
    GROUP  BY event_type, "cytoband_name"
),

ranked AS (           -- rank cytobands within each event class
    SELECT  event_type,
            "cytoband_name",
            freq,
            ROW_NUMBER() OVER (PARTITION BY event_type
                               ORDER BY freq DESC NULLS LAST) AS rk
    FROM   event_counts
)

SELECT  event_type,
        "cytoband_name",
        freq
FROM   ranked
WHERE  rk <= 11                    -- Top-11 per event class
ORDER  BY event_type,
        freq DESC NULLS LAST,
        "cytoband_name";
```
