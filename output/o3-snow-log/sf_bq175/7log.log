```sql
/*  Top-11 cytobands for each class of copy-number event on chr1 in TCGA-KIRC,
    then keep only those cytobands that appear in the Top-11 list of
    Amplifications (>3 copies), Gains (=3 copies) AND Heterozygous Deletions (=1 copy)
*/
WITH segments AS (        -- chr1 segments for TCGA-KIRC that could be 1/3/>3 copies
    SELECT  "chromosome",
            "start_pos",
            "max_copy_number"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
    WHERE "project_short_name" = 'TCGA-KIRC'
      AND "chromosome"         = 'chr1'
      AND "max_copy_number"    IN (1,3,4,5,6,7,8,9,10)
),
cyto_mapped AS (           -- tag every segment with its cytoband
    SELECT  c."cytoband_name",
            s."max_copy_number"
    FROM segments s
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
      ON s."chromosome" = c."chromosome"
     AND s."start_pos"  BETWEEN c."hg38_start" AND c."hg38_stop"
),
amplifications AS (        -- Top-11 cytobands for Amplifications (>3 copies)
    SELECT  "cytoband_name",
            COUNT(*) AS amp_freq
    FROM cyto_mapped
    WHERE "max_copy_number" > 3
    GROUP BY "cytoband_name"
    ORDER BY amp_freq DESC NULLS LAST
    LIMIT 11
),
gains AS (                 -- Top-11 cytobands for Gains (=3 copies)
    SELECT  "cytoband_name",
            COUNT(*) AS gain_freq
    FROM cyto_mapped
    WHERE "max_copy_number" = 3
    GROUP BY "cytoband_name"
    ORDER BY gain_freq DESC NULLS LAST
    LIMIT 11
),
heterozygous_deletions AS ( -- Top-11 cytobands for Heterozygous Deletions (=1 copy)
    SELECT  "cytoband_name",
            COUNT(*) AS hetdel_freq
    FROM cyto_mapped
    WHERE "max_copy_number" = 1
    GROUP BY "cytoband_name"
    ORDER BY hetdel_freq DESC NULLS LAST
    LIMIT 11
)
SELECT  a."cytoband_name",
        a."amp_freq",
        g."gain_freq",
        h."hetdel_freq"
FROM   amplifications        a
JOIN   gains                 g ON a."cytoband_name" = g."cytoband_name"
JOIN   heterozygous_deletions h ON a."cytoband_name" = h."cytoband_name"
ORDER BY a."cytoband_name";
```
