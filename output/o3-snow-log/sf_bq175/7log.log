/*  Identify cytobands on chr1 in TCGA-KIRC that rank within the
    top-11 for Amplifications (>3 copies), Gains (=3 copies),
    and Heterozygous Deletions (=1 copy) simultaneously            */
WITH segments AS (          -- chr1 segments of interest
    SELECT  "chromosome",
            "start_pos",
            "max_copy_number"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
    WHERE "project_short_name" = 'TCGA-KIRC'
      AND "chromosome"         = 'chr1'
      AND "max_copy_number"    IN (1,3,4,5,6,7,8,9,10)
),
cyto_mapped AS (            -- map segments to cytobands
    SELECT  c."cytoband_name",
            s."max_copy_number"
    FROM segments s
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
      ON s."chromosome" = c."chromosome"
     AND s."start_pos"  BETWEEN c."hg38_start" AND c."hg38_stop"
),
amplifications AS (         -- top-11 cytobands for >3 copies
    SELECT  "cytoband_name",
            COUNT(*) AS AMP_FREQ
    FROM cyto_mapped
    WHERE "max_copy_number" > 3
    GROUP BY "cytoband_name"
    ORDER BY AMP_FREQ DESC NULLS LAST
    LIMIT 11
),
gains AS (                  -- top-11 cytobands for exactly 3 copies
    SELECT  "cytoband_name",
            COUNT(*) AS GAIN_FREQ
    FROM cyto_mapped
    WHERE "max_copy_number" = 3
    GROUP BY "cytoband_name"
    ORDER BY GAIN_FREQ DESC NULLS LAST
    LIMIT 11
),
heterozygous_deletions AS ( -- top-11 cytobands for 1 copy
    SELECT  "cytoband_name",
            COUNT(*) AS HETDEL_FREQ
    FROM cyto_mapped
    WHERE "max_copy_number" = 1
    GROUP BY "cytoband_name"
    ORDER BY HETDEL_FREQ DESC NULLS LAST
    LIMIT 11
)
