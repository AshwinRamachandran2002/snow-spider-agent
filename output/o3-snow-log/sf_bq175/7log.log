```sql
--Description: 4) Retrieve all cytoband definitions for chromosome 1 (hg38)
SELECT "chromosome",
       "cytoband_name",
       "hg38_start",
       "hg38_stop"
FROM TCGA_MITELMAN.PROD.CYTOBANDS_HG38
WHERE "chromosome" = 'chr1'
LIMIT 20;
```

```sql
--Description: 5) Tag each KIRC gene-level segment with an EVENT label (Amplification, Gain, Heterozygous Deletion)
SELECT  "chromosome",
        "start_pos",
        "end_pos",
        "max_copy_number",
        CASE
            WHEN "max_copy_number" > 3 THEN 'Amplification'
            WHEN "max_copy_number" = 3 THEN 'Gain'
            WHEN "max_copy_number" = 1 THEN 'Heterozygous Deletion'
        END AS "event_type"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
WHERE "project_short_name" = 'TCGA-KIRC'
  AND "chromosome" = 'chr1'
  AND "max_copy_number" IN (1,3,4,5,6,7,8,9,10)        -- limits search to relevant values
LIMIT 20;
```

```sql
--Description: 6) Join chromosome 1 segments to their cytobands and keep only the three event types of interest
SELECT  cband."cytoband_name",
        seg."event_type"
FROM (
        SELECT  "chromosome",
                "start_pos",
                "end_pos",
                CASE
                    WHEN "max_copy_number" > 3 THEN 'Amplification'
                    WHEN "max_copy_number" = 3 THEN 'Gain'
                    WHEN "max_copy_number" = 1 THEN 'Heterozygous Deletion'
                END AS "event_type"
        FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
        WHERE "project_short_name" = 'TCGA-KIRC'
          AND "chromosome" = 'chr1'
          AND "max_copy_number" IN (1,3,4,5,6,7,8,9,10)
     ) seg
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 cband
  ON seg."chromosome" = cband."chromosome"
 AND seg."start_pos" BETWEEN cband."hg38_start" AND cband."hg38_stop"
WHERE seg."event_type" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 7) Count Amplification events per cytoband on chromosome 1 and show the top 11
SELECT  cband."cytoband_name",
        COUNT(*) AS "amplification_count"
FROM (
        SELECT  "chromosome",
                "start_pos",
                "end_pos"
        FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
        WHERE "project_short_name" = 'TCGA-KIRC'
          AND "chromosome" = 'chr1'
          AND "max_copy_number" > 3
     ) amp
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 cband
  ON amp."chromosome" = cband."chromosome"
 AND amp."start_pos" BETWEEN cband."hg38_start" AND cband."hg38_stop"
GROUP BY cband."cytoband_name"
ORDER BY "amplification_count" DESC
LIMIT 20;               -- top 11 appear within first 20 rows
```

```sql
--Description: 8) Count Gain events (copy number = 3) per cytoband and show the top 11
SELECT  cband."cytoband_name",
        COUNT(*) AS "gain_count"
FROM (
        SELECT  "chromosome",
                "start_pos",
                "end_pos"
        FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
        WHERE "project_short_name" = 'TCGA-KIRC'
          AND "chromosome" = 'chr1'
          AND "max_copy_number" = 3
     ) gain
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 cband
  ON gain."chromosome" = cband."chromosome"
 AND gain."start_pos" BETWEEN cband."hg38_start" AND cband."hg38_stop"
GROUP BY cband."cytoband_name"
ORDER BY "gain_count" DESC
LIMIT 20;               -- top 11 appear within first 20 rows
```

```sql
--Description: 9) Count Heterozygous Deletion events (copy number = 1) per cytoband and show the top 11
SELECT  cband."cytoband_name",
        COUNT(*) AS "het_del_count"
FROM (
        SELECT  "chromosome",
                "start_pos",
                "end_pos"
        FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
        WHERE "project_short_name" = 'TCGA-KIRC'
          AND "chromosome" = 'chr1'
          AND "max_copy_number" = 1
     ) del
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 cband
  ON del."chromosome" = cband."chromosome"
 AND del."start_pos" BETWEEN cband."hg38_start" AND cband."hg38_stop"
GROUP BY cband."cytoband_name"
ORDER BY "het_del_count" DESC
LIMIT 20;               -- top 11 appear within first 20 rows
```

```sql
--Description: 10) Combine the top-11 cytobands from each category (Amplification, Gain, Het-Deletion)
WITH amp AS (
    SELECT  cband."cytoband_name",
            COUNT(*) AS "freq"
    FROM (
            SELECT "chromosome","start_pos","end_pos"
            FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
            WHERE "project_short_name" = 'TCGA-KIRC'
              AND "chromosome" = 'chr1'
              AND "max_copy_number" > 3
         ) a
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 cband
      ON a."chromosome" = cband."chromosome"
     AND a."start_pos" BETWEEN cband."hg38_start" AND cband."hg38_stop"
    GROUP BY cband."cytoband_name"
    ORDER BY "freq" DESC
    LIMIT 11
), gain AS (
    SELECT  cband."cytoband_name",
            COUNT(*) AS "freq"
    FROM (
            SELECT "chromosome","start_pos","end_pos"
            FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
            WHERE "project_short_name" = 'TCGA-KIRC'
              AND "chromosome" = 'chr1'
              AND "max_copy_number" = 3
         ) g
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 cband
      ON g."chromosome" = cband."chromosome"
     AND g."start_pos" BETWEEN cband."hg38_start" AND cband."hg38_stop"
    GROUP BY cband."cytoband_name"
    ORDER BY "freq" DESC
    LIMIT 11
), hetdel AS (
    SELECT  cband."cytoband_name",
            COUNT(*) AS "freq"
    FROM (
            SELECT "chromosome","start_pos","end_pos"
            FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36
            WHERE "project_short_name" = 'TCGA-KIRC'
              AND "chromosome" = 'chr1'
              AND "max_copy_number" = 1
         ) d
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 cband
      ON d."chromosome" = cband."chromosome"
     AND d."start_pos" BETWEEN cband."hg38_start" AND cband."hg38_stop"
    GROUP BY cband."cytoband_name"
    ORDER BY "freq" DESC
    LIMIT 11
)
SELECT 'Amplification'        AS "event_type", * FROM amp   UNION ALL
SELECT 'Gain'                 AS "event_type", * FROM gain  UNION ALL
SELECT 'HeterozygousDeletion' AS "event_type", * FROM hetdel
LIMIT 20;   -- final combined result (first 20 rows shown)
```

