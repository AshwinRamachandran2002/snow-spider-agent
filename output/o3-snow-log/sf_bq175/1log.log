```sql
--Description: 10) Rank cytobands by event frequencies across all three alteration types  
WITH event_counts AS (
    SELECT  c."cytoband_name",
            CASE 
               WHEN g."copy_number" > 3 THEN 'Amplification'
               WHEN g."copy_number" = 3 THEN 'Gain'
               WHEN g."copy_number" = 1 THEN 'HetDeletion'
            END                       AS "alteration",
            COUNT(*)                  AS "events"
    FROM    "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
    JOIN    "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
          ON g."chromosome" = c."chromosome"
         AND g."start_pos"  <= c."hg38_stop"
         AND g."end_pos"    >= c."hg38_start"
    WHERE   g."project_short_name" = 'TCGA-KIRC'
      AND   g."chromosome"         = 'chr1'
      AND   g."copy_number" IN (1,3,4,5,6,7,8,9,10)   -- 1=HetDel, 3=Gain, >3=Amplification
    GROUP BY c."cytoband_name",
             "alteration"
)
SELECT  "cytoband_name",
        "alteration",
        "events",
        RANK() OVER (PARTITION BY "alteration" ORDER BY "events" DESC) AS "rank_within_alteration"
FROM    event_counts
WHERE   "rank_within_alteration" <= 11
ORDER BY "alteration", "rank_within_alteration"
LIMIT   20;
```
