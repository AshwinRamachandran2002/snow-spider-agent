```sql
--Description: 
-- Rank chromosome-1 cytobands in the TCGA-KICH copy-number dataset by how often each of
-- three alteration types occurs:
--   • Amplification  : copy_number > 3
--   • Gain           : copy_number = 3
--   • HetDeletion    : copy_number = 1
-- 1.  Build a CTE (event_counts) joining gene-level segments to cytobands and counting
--     events per cytoband for each alteration label.
-- 2.  In the outer query calculate RANK() within each alteration class and keep only the
--     top-11 cytobands per class using QUALIFY (Snowflake feature).
-- 3.  Order results by alteration then rank; show at most 20 rows.
WITH event_counts AS (
    SELECT  c."cytoband_name",
            CASE
                WHEN g."copy_number" > 3 THEN 'Amplification'
                WHEN g."copy_number" = 3 THEN 'Gain'
                WHEN g."copy_number" = 1 THEN 'HetDeletion'
            END                       AS "alteration",
            COUNT(*)                  AS "events"
    FROM    "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
    JOIN    "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
           ON g."chromosome" = c."chromosome"
          AND g."start_pos"  <= c."hg38_stop"
          AND g."end_pos"    >= c."hg38_start"
    WHERE   g."project_short_name" = 'TCGA-KICH'
      AND   g."chromosome"         = 'chr1'
      AND   g."copy_number" IN (1,3,4,5,6,7,8,9,10)
    GROUP BY c."cytoband_name", "alteration"
)
SELECT  "cytoband_name",
        "alteration",
        "events",
        RANK() OVER (PARTITION BY "alteration" ORDER BY "events" DESC) AS "rank_within_alteration"
FROM    event_counts
QUALIFY "rank_within_alteration" <= 11
ORDER BY "alteration", "rank_within_alteration"
LIMIT 20;
