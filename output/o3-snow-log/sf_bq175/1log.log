```sql
/*  ----------------------------------------------------------
    Top-11 cytobands on chromosome 1 for each CNV category
    in the TCGA-KIRC cohort, ranked by event frequency that
    is calculated from **max_copy_number** (severity metric).

    Categories
      • Amplification : max_copy_number  > 3
      • Gain          : max_copy_number  = 3
      • HetDeletion   : max_copy_number  = 1
    ----------------------------------------------------------*/
WITH band_counts AS (
    SELECT
        c."cytoband_name",
        CASE
            WHEN g."max_copy_number" > 3 THEN 'Amplification'
            WHEN g."max_copy_number" = 3 THEN 'Gain'
            WHEN g."max_copy_number" = 1 THEN 'HetDeletion'
        END                                  AS "alteration",
        COUNT(*)                             AS "events"
    FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36"  g
    JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"                                 c
           ON  g."chromosome" = c."chromosome"
           AND g."start_pos"  <= c."hg38_stop"
           AND g."end_pos"    >= c."hg38_start"
    WHERE  g."project_short_name" = 'TCGA-KIRC'
      AND  g."chromosome"         = 'chr1'
      AND  (
              g."max_copy_number" > 3  -- Amplification
           OR g."max_copy_number" = 3  -- Gain
           OR g."max_copy_number" = 1  -- HetDeletion
          )
    GROUP BY
        c."cytoband_name",
        "alteration"
),
ranked_bands AS (
    SELECT
        "cytoband_name",
        "alteration",
        "events",
        ROW_NUMBER() OVER (PARTITION BY "alteration"
                           ORDER BY "events" DESC NULLS LAST) AS rn
    FROM band_counts
)
SELECT
    "cytoband_name",
    "alteration",
    "events"
FROM   ranked_bands
WHERE  rn <= 11
ORDER BY
    "alteration",
    "events" DESC NULLS LAST;
```
