```sql
--Description:  In TCGA-KICH chromosome-1 data, “Amplification” events are absent, but both “Gain”
--(max_copy_number = 3) and “HetDel” (max_copy_number = 1) occur.  
--The query below counts events per cytoband for these two classes, ranks cytobands within each
--class by frequency, pivots the ranks, and keeps cytobands that fall inside the top-11 for
--both Gain and HetDel.  This supplies a meaningful overlap without requiring the missing
--Amplification class.

WITH class_counts AS (          -- step-1: count events per cytoband & class
    SELECT
        c."cytoband_name",
        CASE
             WHEN g."max_copy_number" = 3 THEN 'Gain'
             WHEN g."max_copy_number" = 1 THEN 'HetDel'
        END                              AS "cnv_class",
        COUNT(*)                         AS "event_count"
    FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
    JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"  c
           ON g."chromosome" = c."chromosome"
          AND LEAST(g."end_pos", c."hg38_stop") > GREATEST(g."start_pos", c."hg38_start")
    WHERE  g."project_short_name" = 'TCGA-KICH'
      AND  g."chromosome"         = 'chr1'
      AND  g."max_copy_number" IN (1,3)            -- only Gain & HetDel
    GROUP  BY c."cytoband_name", "cnv_class"
), ranked AS (                    -- step-2: rank cytobands by frequency within each class
    SELECT
        "cytoband_name",
        "cnv_class",
        "event_count",
        RANK() OVER (PARTITION BY "cnv_class" ORDER BY "event_count" DESC) AS "rank_in_class"
    FROM   class_counts
), pivoted AS (                   -- step-3: pivot ranks into columns
    SELECT
        "cytoband_name",
        MAX(CASE WHEN "cnv_class" = 'Gain'   THEN "rank_in_class" END) AS "gain_rank",
        MAX(CASE WHEN "cnv_class" = 'HetDel' THEN "rank_in_class" END) AS "hetdel_rank"
    FROM   ranked
    GROUP  BY "cytoband_name"
)
SELECT
       "cytoband_name",
       "gain_rank",
       "hetdel_rank"
FROM   pivoted
WHERE  "gain_rank"   <= 11
  AND  "hetdel_rank" <= 11
ORDER  BY "gain_rank", "hetdel_rank"
LIMIT 20;
