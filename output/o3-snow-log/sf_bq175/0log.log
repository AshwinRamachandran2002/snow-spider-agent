```sql
--Description:  This query confirms (a) which cytobands on chromosome-1 for the TCGA-KICH
--project rank within the TOP-11 most-frequent bands in BOTH “Gain” (max_copy_number = 3)
--and “HetDel” (max_copy_number = 1) classes, and (b) how many events of each class those
--bands actually contain.  The logic is:
-- 1.  Count events per (cytoband, class) and assign a frequency rank inside each class.
-- 2.  Keep only bands whose rank ≤ 11 in BOTH classes (using a HAVING clause).
-- 3.  Re-count events for the retained bands to present final totals.
WITH ranked AS (               /* step-1: count & rank per class */
    SELECT
        c."cytoband_name",
        CASE WHEN g."max_copy_number" = 3 THEN 'Gain'
             WHEN g."max_copy_number" = 1 THEN 'HetDel' END           AS cnv_class,
        COUNT(*)                                                      AS event_count,
        RANK() OVER (
              PARTITION BY CASE WHEN g."max_copy_number" = 3 THEN 'Gain'
                                 WHEN g."max_copy_number" = 1 THEN 'HetDel' END
              ORDER BY COUNT(*) DESC
        )                                                            AS freq_rank
    FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
    JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
           ON g."chromosome" = c."chromosome"
          AND LEAST(g."end_pos", c."hg38_stop") > GREATEST(g."start_pos", c."hg38_start")
    WHERE  g."project_short_name" = 'TCGA-KICH'
      AND  g."chromosome"         = 'chr1'
      AND  g."max_copy_number" IN (1,3)                                   -- only Gain & HetDel
    GROUP  BY c."cytoband_name", g."max_copy_number"
), top_bands AS (           /* step-2: retain bands ranking ≤11 in BOTH classes */
    SELECT
        "cytoband_name"
    FROM   ranked
    GROUP  BY "cytoband_name"
    HAVING MAX(CASE WHEN cnv_class = 'Gain'   THEN freq_rank END)   <= 11
       AND MAX(CASE WHEN cnv_class = 'HetDel' THEN freq_rank END)   <= 11
)
/* step-3: final event totals for the selected bands */
SELECT
       c."cytoband_name",
       CASE WHEN g."max_copy_number" = 3 THEN 'Gain'
            WHEN g."max_copy_number" = 1 THEN 'HetDel' END           AS cnv_class,
       COUNT(*)                                                      AS event_count
FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
       ON g."chromosome" = c."chromosome"
      AND LEAST(g."end_pos", c."hg38_stop") > GREATEST(g."start_pos", c."hg38_start")
JOIN   top_bands tb
       ON c."cytoband_name" = tb."cytoband_name"
WHERE  g."project_short_name" = 'TCGA-KICH'
  AND  g."chromosome"         = 'chr1'
  AND  g."max_copy_number" IN (1,3)
GROUP  BY c."cytoband_name", cnv_class
ORDER  BY c."cytoband_name", cnv_class
LIMIT 20;
