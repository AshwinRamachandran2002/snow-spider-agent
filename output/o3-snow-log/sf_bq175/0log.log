--Description: 9) Verify total event counts of the selected cytobands across the three CNV classes.  
WITH top_bands AS (
     -- (reuse CTE `pivoted` from previous query)
     SELECT *
     FROM  (
           SELECT
                  "cytoband_name",
                  MAX(CASE WHEN "cnv_class" = 'Amplification' THEN RANK() OVER (PARTITION BY "cnv_class" ORDER BY COUNT(*) DESC) END) AS "amp_rank",
                  MAX(CASE WHEN "cnv_class" = 'Gain'          THEN RANK() OVER (PARTITION BY "cnv_class" ORDER BY COUNT(*) DESC) END) AS "gain_rank",
                  MAX(CASE WHEN "cnv_class" = 'HetDel'        THEN RANK() OVER (PARTITION BY "cnv_class" ORDER BY COUNT(*) DESC) END) AS "hetdel_rank"
           FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
           JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"                                c
             ON   g."chromosome"  = c."chromosome"
            AND   LEAST(g."end_pos", c."hg38_stop") > GREATEST(g."start_pos", c."hg38_start")
           WHERE  g."project_short_name" = 'TCGA-KIRC'
             AND  g."chromosome"         = 'chr1'
           GROUP  BY c."cytoband_name", "cnv_class"
     ) t
     WHERE "amp_rank" <= 11 AND "gain_rank" <= 11 AND "hetdel_rank" <= 11
)
SELECT
       c."cytoband_name",
       CASE
            WHEN g."max_copy_number" >= 4 THEN 'Amplification'
            WHEN g."max_copy_number" = 3 THEN 'Gain'
            WHEN g."max_copy_number" = 1 THEN 'HetDel'
            ELSE 'Other'
       END                                   AS "cnv_class",
       COUNT(*)                              AS "event_count"
FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"                                c
  ON   g."chromosome"  = c."chromosome"
 AND   LEAST(g."end_pos", c."hg38_stop") > GREATEST(g."start_pos", c."hg38_start")
JOIN   top_bands tb
  ON   c."cytoband_name" = tb."cytoband_name"
WHERE  g."project_short_name" = 'TCGA-KIRC'
  AND  g."chromosome"         = 'chr1'
  AND  "cnv_class" IN ('Amplification', 'Gain', 'HetDel')
GROUP  BY c."cytoband_name", "cnv_class"
ORDER  BY c."cytoband_name", "cnv_class"
LIMIT 20;
