--Description:  End-to-end query to identify chromosome-1 cytobands in TCGA-KICH that are
--simultaneously among the 11 most-frequent regions for BOTH “Gain” (max_copy_number = 3)
--and “HetDel” (max_copy_number = 1).  The workflow inside one CTE chain is:
-- 1) Count events per (cytoband, CNV class) for the two relevant classes;
-- 2) Rank cytobands within each class by those counts;
-- 3) Pivot the two ranks into separate columns;
-- 4) Keep only cytobands whose rank ≤ 11 in BOTH classes and display their ranks.
WITH per_class_counts AS (         -- Step-1: counts
    SELECT
        c."cytoband_name",
        CASE WHEN g."max_copy_number" = 3 THEN 'Gain'
             WHEN g."max_copy_number" = 1 THEN 'HetDel' END AS "cnv_class",
        COUNT(*)                                            AS "events"
    FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
    JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"          c
           ON g."chromosome" = c."chromosome"
          AND LEAST(g."end_pos", c."hg38_stop") > GREATEST(g."start_pos", c."hg38_start")
    WHERE  g."project_short_name" = 'TCGA-KICH'
      AND  g."chromosome"         = 'chr1'
      AND  g."max_copy_number" IN (1,3)                    -- only Gain & HetDel
    GROUP BY c."cytoband_name", "cnv_class"
), ranked AS (                       -- Step-2: rank inside each class
    SELECT
        "cytoband_name",
        "cnv_class",
        RANK() OVER (PARTITION BY "cnv_class" ORDER BY "events" DESC) AS "rank_in_class"
    FROM   per_class_counts
), pivot AS (                        -- Step-3: pivot ranks to columns
    SELECT
        "cytoband_name",
        MAX(CASE WHEN "cnv_class" = 'Gain'   THEN "rank_in_class" END) AS "gain_rank",
        MAX(CASE WHEN "cnv_class" = 'HetDel' THEN "rank_in_class" END) AS "hetdel_rank"
    FROM   ranked
    GROUP BY "cytoband_name"
)
SELECT                                  -- Step-4: final shortlist
       "cytoband_name",
       "gain_rank",
       "hetdel_rank"
FROM   pivot
WHERE  "gain_rank"   <= 11
  AND  "hetdel_rank" <= 11
ORDER  BY "cytoband_name"
LIMIT 20;
