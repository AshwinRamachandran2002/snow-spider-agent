```sql
--Description: 8) Select cytobands whose ranks are ≤11 simultaneously in Amplification, Gain, and HetDel categories.  
WITH ranked AS (
     SELECT
            "cytoband_name",
            "cnv_class",
            "event_count",
            RANK() OVER (PARTITION BY "cnv_class" ORDER BY "event_count" DESC) AS "freq_rank"
     FROM  (
            SELECT
                   c."cytoband_name",
                   CASE
                        WHEN g."max_copy_number" >= 4 THEN 'Amplification'
                        WHEN g."max_copy_number" = 3 THEN 'Gain'
                        WHEN g."max_copy_number" = 1 THEN 'HetDel'
                        ELSE 'Other'
                   END                                   AS "cnv_class",
                   COUNT(*)                              AS "event_count"
            FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
            JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"                                c
              ON   g."chromosome"  = c."chromosome"
             AND   LEAST(g."end_pos", c."hg38_stop") > GREATEST(g."start_pos", c."hg38_start")
            WHERE  g."project_short_name" = 'TCGA-KIRC'
              AND  g."chromosome"         = 'chr1'
            GROUP  BY c."cytoband_name", "cnv_class"
     ) sub
     WHERE "cnv_class" IN ('Amplification', 'Gain', 'HetDel')
),
pivoted AS (
     SELECT
            "cytoband_name",
            MAX(CASE WHEN "cnv_class" = 'Amplification' THEN "freq_rank" END) AS "amp_rank",
            MAX(CASE WHEN "cnv_class" = 'Gain'          THEN "freq_rank" END) AS "gain_rank",
            MAX(CASE WHEN "cnv_class" = 'HetDel'        THEN "freq_rank" END) AS "hetdel_rank"
     FROM   ranked
     GROUP  BY "cytoband_name"
)
SELECT
       "cytoband_name",
       "amp_rank",
       "gain_rank",
       "hetdel_rank"
FROM   pivoted
WHERE  "amp_rank"   <= 11
  AND  "gain_rank"  <= 11
  AND  "hetdel_rank"<= 11
ORDER  BY "amp_rank", "gain_rank", "hetdel_rank"
LIMIT 20;
```

