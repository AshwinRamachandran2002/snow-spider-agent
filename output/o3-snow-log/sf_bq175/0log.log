/*--------------------------------------------------------------
Purpose :  Chromosome-1 cytobands in TCGA-KIRC whose  
           Amplification, Gain and HetDel event-counts each rank
           within the top-11 of their respective CNV classes.
----------------------------------------------------------------*/
WITH counts AS (      -- 1) tally events per cytoband & CNV class
    SELECT
        c."cytoband_name",
        CASE
            WHEN g."max_copy_number" >= 4 THEN 'Amplification'
            WHEN g."max_copy_number"  = 3 THEN 'Gain'
            WHEN g."max_copy_number"  = 1 THEN 'HetDel'
        END                                   AS "cnv_class",
        COUNT(*)                              AS "event_count"
    FROM  "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
    JOIN  "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"               c
      ON  REGEXP_REPLACE(g."chromosome", '^chr', '')        -- harmonise chromosome IDs
        = REGEXP_REPLACE(c."chromosome", '^chr', '')
     AND LEAST(g."end_pos",   c."hg38_stop")                -- physical overlap
       > GREATEST(g."start_pos", c."hg38_start")
    WHERE g."project_short_name" = 'TCGA-KIRC'
      AND REGEXP_REPLACE(g."chromosome", '^chr', '') = '1'  -- chromosome 1 only
      AND g."max_copy_number" IN (1,3,4,5,6,7,8,9,10)       -- exclude diploid / nulls
    GROUP BY c."cytoband_name",
             CASE
                 WHEN g."max_copy_number" >= 4 THEN 'Amplification'
                 WHEN g."max_copy_number"  = 3 THEN 'Gain'
                 WHEN g."max_copy_number"  = 1 THEN 'HetDel'
             END
    HAVING "cnv_class" IS NOT NULL
),
ranked AS (            -- 2) rank cytobands within each CNV class
    SELECT
        "cytoband_name",
        "cnv_class",
        "event_count",
        RANK() OVER (PARTITION BY "cnv_class"
                     ORDER BY "event_count" DESC NULLS LAST) AS "freq_rank"
    FROM counts
),
top11 AS (             -- 3) keep only top-11 per class
    SELECT "cytoband_name",
           "cnv_class"
    FROM   ranked
    WHERE  "freq_rank" <= 11
)
-- 4) cytobands that are present in the top-11 list of ALL THREE classes
SELECT
    "cytoband_name"
FROM   top11
GROUP  BY "cytoband_name"
HAVING COUNT(DISTINCT "cnv_class") = 3
ORDER  BY "cytoband_name";
