--Description: 10) Produce the final shortlist of cytoband names on chr1 ranking within the top-11 for Amplification, Gain, and HetDel in TCGA-KICH.
WITH ranked AS (
     SELECT
            c."cytoband_name",
            CASE
                 WHEN g."max_copy_number" >= 4 THEN 'Amplification'
                 WHEN g."max_copy_number" = 3 THEN 'Gain'
                 WHEN g."max_copy_number" = 1 THEN 'HetDel'
                 ELSE 'Other'
            END                           AS "cnv_class",
            COUNT(*)                      AS "event_count"
     FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
     JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"                                c
       ON   g."chromosome" = c."chromosome"
      AND   LEAST(g."end_pos", c."hg38_stop") > GREATEST(g."start_pos", c."hg38_start")
     WHERE  g."project_short_name" = 'TCGA-KICH'
       AND  g."chromosome"         = 'chr1'
       AND  g."max_copy_number" IN (1,3,4,5,6,7,8,9,10)
     GROUP  BY c."cytoband_name", "cnv_class"
), class_rank AS (
     SELECT
            "cytoband_name",
            "cnv_class",
            "event_count",
            RANK() OVER (PARTITION BY "cnv_class" ORDER BY "event_count" DESC) AS "rank_in_class"
     FROM   ranked
     WHERE  "cnv_class" IN ('Amplification','Gain','HetDel')
), summary AS (
     SELECT
            "cytoband_name",
            MAX(CASE WHEN "cnv_class" = 'Amplification' THEN "rank_in_class" END) AS "amp_rank",
            MAX(CASE WHEN "cnv_class" = 'Gain'          THEN "rank_in_class" END) AS "gain_rank",
            MAX(CASE WHEN "cnv_class" = 'HetDel'        THEN "rank_in_class" END) AS "hetdel_rank"
     FROM   class_rank
     GROUP  BY "cytoband_name"
)
SELECT
       "cytoband_name",
       "amp_rank",
       "gain_rank",
       "hetdel_rank"
FROM   summary
WHERE  "amp_rank"   <= 11
  AND  "gain_rank"  <= 11
  AND  "hetdel_rank"<= 11
ORDER  BY "cytoband_name"
LIMIT 20;
