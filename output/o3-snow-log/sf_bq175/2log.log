      ON   g."chromosome" = b."chromosome"
     AND   g."start_pos"  <= b."hg38_stop"
     AND   g."end_pos"    >= b."hg38_start"
    WHERE  g."project_short_name" = 'TCGA-KIRC'   -- kidney cancer cohort
      AND  g."chromosome"        = 'chr1'         -- chromosome 1 only
      AND g."max_copy_number" IN (1,3,4,5,6,7,8,9)  -- classes of interest
    GROUP  BY
        b."cytoband_name",
        CASE
