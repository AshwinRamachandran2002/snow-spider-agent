/*---------------------------------------------------------------------------
  Identify chromosome-1 cytobands in the TCGA-KIRC copy–number dataset for
  which EACH of the three CNV classes—Amplification (>3 copies), Gain (=3),
  and HeterozygousDeletion (=1)—appears in the top-11 by frequency.
---------------------------------------------------------------------------*/
WITH ranked AS (
    SELECT
        b."cytoband_name",
        /* ------------------  Classify CNV  ------------------ */
        CASE
            WHEN g."max_copy_number" > 3 THEN 'Amplification'
            WHEN g."max_copy_number" = 3 THEN 'Gain'
            WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
        END                                                     AS "cnv_category",
        /* ----------------  Count occurrences  ---------------- */
        COUNT(*)                                                AS "freq",
        /* --------------  Rank within each class -------------- */
        RANK() OVER (
            PARTITION BY
                CASE
                    WHEN g."max_copy_number" > 3 THEN 'Amplification'
                    WHEN g."max_copy_number" = 3 THEN 'Gain'
                    WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
                END
            ORDER BY COUNT(*) DESC NULLS LAST
        )                                                       AS "rank_in_cat"
    FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
    JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38                             b
      ON   g."chromosome" = b."chromosome"
     AND   g."start_pos"  <= b."hg38_stop"
     AND   g."end_pos"    >= b."hg38_start"
    WHERE  g."project_short_name" = 'TCGA-KIRC'   -- kidney cancer cohort
      AND  g."chromosome"        = 'chr1'         -- chromosome 1 only
      AND  g."max_copy_number" IN (1,3,4,5,6,7,8,9)  -- classes of interest
    GROUP  BY
           b."cytoband_name",
           CASE
               WHEN g."max_copy_number" > 3 THEN 'Amplification'
               WHEN g."max_copy_number" = 3 THEN 'Gain'
               WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
           END
),
/* ----------------  Cytobands that are top-11 in ALL three classes  ---------------- */
qualified_cytobands AS (
    SELECT  "cytoband_name"
    FROM    ranked
    WHERE   "rank_in_cat" <= 11
    GROUP BY "cytoband_name"
    HAVING  COUNT(DISTINCT "cnv_category") = 3      -- present in all three
)
/* --------------------------  Final result -------------------------- */
SELECT
       r."cytoband_name",
       r."cnv_category",
       r."freq",
       r."rank_in_cat"
FROM   ranked r
JOIN   qualified_cytobands q
  ON   r."cytoband_name" = q."cytoband_name"
WHERE  r."rank_in_cat" <= 11                       -- keep only top-11 rows
ORDER  BY r."cytoband_name", r."cnv_category";
