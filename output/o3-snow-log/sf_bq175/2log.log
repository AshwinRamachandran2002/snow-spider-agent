```sql
--Description: 3. Join one TCGA-KIRC segment (chromosome 1 only) to the
--              Cytobands table to verify the positional overlap logic.
SELECT 
       g."chromosome",
       g."start_pos",
       g."end_pos",
       b."cytoband_name",
       b."hg38_start",
       b."hg38_stop",
       g."max_copy_number"
FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38                              b
  ON   g."chromosome" = b."chromosome"
 AND   g."start_pos"  <= b."hg38_stop"
 AND   g."end_pos"    >= b."hg38_start"
WHERE  g."project_short_name" = 'TCGA-KIRC'
  AND  g."chromosome"         = 'chr1'
LIMIT  20;
```

```sql
--Description: 4. Create logical CNV categories (Amplification, Gain,
--              HeterozygousDeletion) using max_copy_number values,
--              still restricted to chromosome 1.
SELECT 
       g."max_copy_number",
       CASE 
         WHEN g."max_copy_number" > 3 THEN 'Amplification'
         WHEN g."max_copy_number" = 3 THEN 'Gain'
         WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
       END AS "cnv_category"
FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
WHERE  g."project_short_name" = 'TCGA-KIRC'
  AND  g."chromosome"         = 'chr1'
LIMIT  20;
```

```sql
--Description: 5. Count how many times each category appears in every cytoband
--              on chromosome 1 (TCGA-KIRC only).  This is the raw frequency.
SELECT 
       b."cytoband_name",
       CASE 
         WHEN g."max_copy_number" > 3 THEN 'Amplification'
         WHEN g."max_copy_number" = 3 THEN 'Gain'
         WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
       END                           AS "cnv_category",
       COUNT(*)                      AS "freq"
FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38                               b
  ON   g."chromosome" = b."chromosome"
 AND   g."start_pos"  <= b."hg38_stop"
 AND   g."end_pos"    >= b."hg38_start"
WHERE  g."project_short_name" = 'TCGA-KIRC'
  AND  g."chromosome"         = 'chr1'
  AND  g."max_copy_number" IN (1,3,4,5,6,7,8,9)   -- values we placed into categories
GROUP  BY b."cytoband_name", "cnv_category"
LIMIT  20;
```

```sql
--Description: 6. Rank cytoband frequencies for each CNV category using
--              a window function.  Smaller rank = higher frequency.
SELECT 
       "cytoband_name",
       "cnv_category",
       "freq",
       RANK() OVER (PARTITION BY "cnv_category" 
                        ORDER BY "freq" DESC) AS "rank_in_cat"
FROM (
      SELECT 
             b."cytoband_name",
             CASE 
               WHEN g."max_copy_number" > 3 THEN 'Amplification'
               WHEN g."max_copy_number" = 3 THEN 'Gain'
               WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
             END                           AS "cnv_category",
             COUNT(*)                      AS "freq"
      FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
      JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38                               b
        ON   g."chromosome" = b."chromosome"
       AND   g."start_pos"  <= b."hg38_stop"
       AND   g."end_pos"    >= b."hg38_start"
      WHERE  g."project_short_name" = 'TCGA-KIRC'
        AND  g."chromosome"         = 'chr1'
        AND  g."max_copy_number" IN (1,3,4,5,6,7,8,9)
      GROUP  BY b."cytoband_name", "cnv_category"
) q
LIMIT 20;
```

```sql
--Description: 7. Keep only cytoband rows whose rank is ≤ 11 in their
--              respective CNV category (still chromosome 1).
SELECT *
FROM (
      SELECT 
             "cytoband_name",
             "cnv_category",
             "freq",
             RANK() OVER (PARTITION BY "cnv_category" 
                              ORDER BY "freq" DESC) AS "rank_in_cat"
      FROM (
            SELECT 
                   b."cytoband_name",
                   CASE 
                     WHEN g."max_copy_number" > 3 THEN 'Amplification'
                     WHEN g."max_copy_number" = 3 THEN 'Gain'
                     WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
                   END                           AS "cnv_category",
                   COUNT(*)                      AS "freq"
            FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
            JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38                               b
              ON   g."chromosome" = b."chromosome"
             AND   g."start_pos"  <= b."hg38_stop"
             AND   g."end_pos"    >= b."hg38_start"
            WHERE  g."project_short_name" = 'TCGA-KIRC'
              AND  g."chromosome"         = 'chr1'
              AND  g."max_copy_number" IN (1,3,4,5,6,7,8,9)
            GROUP  BY b."cytoband_name", "cnv_category"
      ) w
)  r
WHERE "rank_in_cat" <= 11
LIMIT 20;
```

```sql
--Description: 8. Aggregate the previous result to identify cytobands that are
--              ranked in the top 11 simultaneously for all three categories.
SELECT 
       "cytoband_name",
       COUNT(DISTINCT "cnv_category") AS "num_cat_present"
FROM (
      /* Re-use ranked data computed above */
      SELECT 
             "cytoband_name",
             "cnv_category",
             RANK() OVER (PARTITION BY "cnv_category" 
                              ORDER BY COUNT(*) DESC) AS "rk"
      FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
      JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38                               b
        ON   g."chromosome" = b."chromosome"
       AND   g."start_pos"  <= b."hg38_stop"
       AND   g."end_pos"    >= b."hg38_start"
      WHERE  g."project_short_name" = 'TCGA-KIRC'
        AND  g."chromosome"         = 'chr1'
        AND  g."max_copy_number" IN (1,3,4,5,6,7,8,9)
      GROUP  BY b."cytoband_name", 
                CASE 
                  WHEN g."max_copy_number" > 3 THEN 'Amplification'
                  WHEN g."max_copy_number" = 3 THEN 'Gain'
                  WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
                END
) s
WHERE "rk" <= 11
GROUP  BY "cytoband_name"
HAVING COUNT(DISTINCT "cnv_category") = 3
LIMIT 20;
```

```sql
--Description: 9. Bring back the individual ranks & frequencies for those
--              “triple-top-11” cytobands to inspect their numbers.
SELECT 
       triple."cytoband_name",
       r."cnv_category",
       r."freq",
       r."rank_in_cat"
FROM (
      /* step 8 – list of cytobands that qualify in all 3 categories */
      SELECT 
             "cytoband_name"
      FROM (
            SELECT 
                   "cytoband_name",
                   "cnv_category",
                   RANK() OVER (PARTITION BY "cnv_category" 
                                    ORDER BY COUNT(*) DESC) AS "rk"
            FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
            JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38                               b
              ON   g."chromosome" = b."chromosome"
             AND   g."start_pos"  <= b."hg38_stop"
             AND   g."end_pos"    >= b."hg38_start"
            WHERE  g."project_short_name" = 'TCGA-KIRC'
              AND  g."chromosome"         = 'chr1'
              AND  g."max_copy_number" IN (1,3,4,5,6,7,8,9)
            GROUP  BY b."cytoband_name",
                      CASE 
                        WHEN g."max_copy_number" > 3 THEN 'Amplification'
                        WHEN g."max_copy_number" = 3 THEN 'Gain'
                        WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
                      END
      ) t
      WHERE t."rk" <= 11
      GROUP  BY "cytoband_name"
      HAVING COUNT(*) = 3
) triple
JOIN (
      /* ranked frequency table from step 6 */
      SELECT 
             *
      FROM (
            SELECT 
                   b."cytoband_name",
                   CASE 
                     WHEN g."max_copy_number" > 3 THEN 'Amplification'
                     WHEN g."max_copy_number" = 3 THEN 'Gain'
                     WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
                   END                           AS "cnv_category",
                   COUNT(*)                      AS "freq",
                   RANK() OVER (PARTITION BY 
                                   CASE 
                                     WHEN g."max_copy_number" > 3 THEN 'Amplification'
                                     WHEN g."max_copy_number" = 3 THEN 'Gain'
                                     WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
                                   END
                                ORDER BY COUNT(*) DESC) AS "rank_in_cat"
            FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
            JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38                               b
              ON   g."chromosome" = b."chromosome"
             AND   g."start_pos"  <= b."hg38_stop"
             AND   g."end_pos"    >= b."hg38_start"
            WHERE  g."project_short_name" = 'TCGA-KIRC'
              AND  g."chromosome"         = 'chr1'
              AND  g."max_copy_number" IN (1,3,4,5,6,7,8,9)
            GROUP  BY b."cytoband_name",
                      CASE 
                        WHEN g."max_copy_number" > 3 THEN 'Amplification'
                        WHEN g."max_copy_number" = 3 THEN 'Gain'
                        WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
                      END
      ) q
      WHERE "rank_in_cat" <= 11
) r
  ON triple."cytoband_name" = r."cytoband_name"
ORDER BY triple."cytoband_name", r."cnv_category"
LIMIT 20;
