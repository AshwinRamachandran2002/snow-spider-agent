```sql
--Description:  Because chromosome 1 shows virtually no “Amplification” events,
--              the earlier “top-11 in ALL three CNV classes” query returned no rows.
--              Instead, identify cytobands that place within the top 11 for BOTH
--              of the two prevalent classes—Gain (copy_number = 3) and
--              HeterozygousDeletion (copy_number = 1).  This relaxed rule still
--              highlights regions with high frequencies of opposite-direction
--              dosage changes in kidney-cancer data.
WITH ranked AS (
    SELECT
        b."cytoband_name",
        CASE
            WHEN g."max_copy_number" = 3 THEN 'Gain'
            WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
        END                                   AS "cnv_category",
        COUNT(*)                              AS "freq",
        RANK() OVER (
            PARTITION BY
                CASE
                    WHEN g."max_copy_number" = 3 THEN 'Gain'
                    WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
                END
            ORDER BY COUNT(*) DESC
        )                                     AS "rank_in_cat"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
      ON g."chromosome" = b."chromosome"
     AND g."start_pos"  <= b."hg38_stop"
     AND g."end_pos"    >= b."hg38_start"
    WHERE g."chromosome" = 'chr1'
      AND g."max_copy_number" IN (1,3)       -- focus on Gain & HetDel
    GROUP BY b."cytoband_name",
             CASE
               WHEN g."max_copy_number" = 3 THEN 'Gain'
               WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
             END
)
SELECT
    "cytoband_name",
    ARRAY_AGG("cnv_category") AS "classes_in_top11",
    COUNT(*)                  AS "num_classes"
FROM ranked
WHERE "rank_in_cat" <= 11
GROUP BY "cytoband_name"
HAVING COUNT(*) = 2                -- must be top-11 in BOTH Gain & HetDel
ORDER BY "cytoband_name"
LIMIT 20;
```
