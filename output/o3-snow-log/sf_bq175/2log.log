```sql
/*---------------------------------------------------------------------------
  Chromosome-1 cytobands in the TCGA-KIRC copy-number dataset for which
  Amplification (>3 copies), Gain (=3 copies), and HeterozygousDeletion (=1 copy)
  EACH place within the 11 most-frequent bands of their respective class.
---------------------------------------------------------------------------*/
WITH band_counts AS (     -- 1.  count occurrences per cytoband & CNV class
    SELECT
        b."cytoband_name",
        CASE
            WHEN g."max_copy_number" > 3 THEN 'Amplification'
            WHEN g."max_copy_number" = 3 THEN 'Gain'
            WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
        END                           AS "cnv_category",
        COUNT(*)                      AS "freq"
    FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
    JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38                       b
      ON   g."chromosome" = b."chromosome"
     AND   g."start_pos"  <= b."hg38_stop"
     AND   g."end_pos"    >= b."hg38_start"
    WHERE  g."project_short_name" = 'TCGA-KIRC'   -- kidney-cancer cohort
      AND  g."chromosome"        = 'chr1'         -- chromosome 1 only
      AND (g."max_copy_number" = 1                -- Het-del
           OR g."max_copy_number" = 3             -- Gain
           OR g."max_copy_number" > 3)            -- Amplification
    GROUP BY
        b."cytoband_name",
        CASE
            WHEN g."max_copy_number" > 3 THEN 'Amplification'
            WHEN g."max_copy_number" = 3 THEN 'Gain'
            WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
        END
),
ranked AS (           -- 2.  rank bands inside each CNV class
    SELECT
        bc.*,
        RANK() OVER (PARTITION BY bc."cnv_category"
                     ORDER BY bc."freq" DESC NULLS LAST) AS "rank_in_cat"
    FROM band_counts bc
),
qualified_bands AS (  -- 3.  bands that are top-11 for ALL three classes
    SELECT  "cytoband_name"
    FROM    ranked
    WHERE   "rank_in_cat" <= 11
    GROUP BY "cytoband_name"
    HAVING  COUNT(DISTINCT "cnv_category") = 3
)
-- 4.  final display ---------------------------------------------------------
SELECT
    r."cytoband_name",
    r."cnv_category",
    r."freq",
    r."rank_in_cat"
FROM   ranked r
JOIN   qualified_bands q
  ON   r."cytoband_name" = q."cytoband_name"
WHERE  r."rank_in_cat" <= 11
ORDER  BY r."cytoband_name", r."cnv_category";
```
