Query:
--Description: 9. Display ranks & frequencies for cytobands that appear in the
--              top-11 list of BOTH Gain (copy_number = 3) and HeterozygousDeletion
--              (copy_number = 1) on chromosome 1, across all projects.
WITH ranked AS (
    SELECT
        b."cytoband_name",
        CASE
            WHEN g."max_copy_number" = 3 THEN 'Gain'
            WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
        END                                   AS "cnv_category",
        COUNT(*)                              AS "freq",
        RANK() OVER (
            PARTITION BY
                CASE
                    WHEN g."max_copy_number" = 3 THEN 'Gain'
                    WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
                END
            ORDER BY COUNT(*) DESC
        )                                     AS "rank_in_cat"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
      ON g."chromosome" = b."chromosome"
     AND g."start_pos"  <= b."hg38_stop"
     AND g."end_pos"    >= b."hg38_start"
    WHERE g."chromosome" = 'chr1'
      AND g."max_copy_number" IN (1,3)
    GROUP BY b."cytoband_name",
             CASE
               WHEN g."max_copy_number" = 3 THEN 'Gain'
               WHEN g."max_copy_number" = 1 THEN 'HeterozygousDeletion'
             END
), both_classes AS (
    SELECT "cytoband_name"
    FROM   ranked
    WHERE  "rank_in_cat" <= 11
    GROUP  BY "cytoband_name"
    HAVING COUNT(DISTINCT "cnv_category") = 2   -- in top-11 for Gain & HetDel
)
SELECT
       r."cytoband_name",
       r."cnv_category",
       r."freq",
       r."rank_in_cat"
FROM   ranked r
JOIN   both_classes b
  ON   r."cytoband_name" = b."cytoband_name"
WHERE  r."rank_in_cat" <= 11
ORDER  BY r."cytoband_name", r."cnv_category"
