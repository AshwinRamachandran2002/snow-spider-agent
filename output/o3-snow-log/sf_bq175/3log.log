/*----------------------------------------------------------------------------
  Cytobands on chromosome-1 (hg38) whose frequencies of 
  AMPLIFICATION (copy_number ≥ 4), GAIN (=3) and 
  HETEROZYGOUS_DELETION (=1) are each ranked within the top-11
  for TCGA-KIRC samples.
----------------------------------------------------------------------------*/
WITH cnv_events AS (      -- 1. keep only KIRC chr1 events we care about
    SELECT
        g."chromosome",
        g."start_pos",
        g."end_pos",
        CASE
            WHEN g."max_copy_number" >= 4 THEN 'AMPLIFICATION'
            WHEN g."max_copy_number"  = 3 THEN 'GAIN'
            WHEN g."max_copy_number"  = 1 THEN 'HETEROZYGOUS_DELETION'
        END                                            AS "cnv_category"
    FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
    WHERE g."project_short_name" = 'TCGA-KIRC'
      AND g."chromosome"         = 'chr1'
      AND ( g."max_copy_number" >= 4
            OR g."max_copy_number" = 3
            OR g."max_copy_number" = 1 )
),
cnv_counts AS (           -- 2. count events per cytoband & category
    SELECT
        c."cytoband_name",
        e."cnv_category",
        COUNT(*)                               AS "event_count"
    FROM      cnv_events               e
    JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
      ON  e."chromosome" = c."chromosome"
     AND  e."start_pos"  <= c."hg38_stop"
     AND  e."end_pos"    >= c."hg38_start"
    GROUP BY
        c."cytoband_name",
        e."cnv_category"
),
ranked AS (               -- 3. rank cytobands within each category
    SELECT
        cc."cytoband_name",
        cc."cnv_category",
        cc."event_count",
        ROW_NUMBER() OVER (
            PARTITION BY cc."cnv_category"
            ORDER BY     cc."event_count" DESC NULLS LAST
        )                                   AS "rank_within_category"
    FROM cnv_counts cc
),
top11 AS (                -- 4. keep top-11 for every category
    SELECT
        "cytoband_name",
        "cnv_category"
    FROM ranked
    WHERE "rank_within_category" <= 11
),
amp  AS (SELECT "cytoband_name" FROM top11 WHERE "cnv_category" = 'AMPLIFICATION'),
gain AS (SELECT "cytoband_name" FROM top11 WHERE "cnv_category" = 'GAIN'),
het  AS (SELECT "cytoband_name" FROM top11 WHERE "cnv_category" = 'HETEROZYGOUS_DELETION')

-- 5. cytobands present in the top-11 list of ALL three categories
SELECT DISTINCT
       a."cytoband_name"
FROM   amp  a
JOIN   gain g ON a."cytoband_name" = g."cytoband_name"
JOIN   het  h ON a."cytoband_name" = h."cytoband_name"
ORDER BY
       a."cytoband_name";
