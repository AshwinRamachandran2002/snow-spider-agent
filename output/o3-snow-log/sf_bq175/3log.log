Query:
--Description: Rank cytobands separately for Amplification, Gain, and Heterozygous Deletion frequencies (top 11 for each category) in TCGA-KICH chromosome 1.
SELECT
       ranked.*
FROM (
       SELECT
              c."cytoband_name",
              cnv."cnv_category",
              COUNT(*)                                         AS "event_count",
              ROW_NUMBER() OVER (PARTITION BY cnv."cnv_category"
                                 ORDER BY COUNT(*) DESC)       AS "rank_within_category"
       FROM (
              SELECT
                     g."start_pos",
                     g."end_pos",
                     CASE
                         WHEN g."max_copy_number" >= 4 THEN 'AMPLIFICATION'
                         WHEN g."max_copy_number" =  3 THEN 'GAIN'
                         WHEN g."max_copy_number" =  1 THEN 'HETEROZYGOUS_DELETION'
                         ELSE 'OTHER'
                     END AS "cnv_category",
                     g."chromosome"
              FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
              WHERE  g."project_short_name" = 'TCGA-KICH'
                AND  g."chromosome"         = 'chr1'
            ) cnv
       JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
         ON   cnv."chromosome" = c."chromosome"
        AND   cnv."start_pos" <= c."hg38_stop"
        AND   cnv."end_pos"   >= c."hg38_start"
       GROUP BY
              c."cytoband_name",
              cnv."cnv_category"
     ) ranked
WHERE  ranked."rank_within_category" <= 11
LIMIT 20
