```sql
-- 6. Description:  Categorise each segment into Amplification, Gain, Heterozygous
--    Deletion or Other; preview 20 examples.
SELECT
       g."max_copy_number",
       CASE
           WHEN g."max_copy_number" >= 4 THEN 'AMPLIFICATION'
           WHEN g."max_copy_number" =  3 THEN 'GAIN'
           WHEN g."max_copy_number" =  1 THEN 'HETEROZYGOUS_DELETION'
           ELSE 'OTHER'
       END AS "cnv_category"
FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
WHERE  g."project_short_name" = 'TCGA-KIRC'
  AND  g."chromosome"         = 'chr1'
LIMIT 20;
```

```sql
-- 7. Description:  Count events per cytoband and CNV category on chromosome 1
--    (returns every cytoband/category pair, limited preview).
SELECT
       c."cytoband_name",
       cnv."cnv_category",
       COUNT(*) AS "event_count"
FROM  (
       SELECT
              g."start_pos",
              g."end_pos",
              CASE
                  WHEN g."max_copy_number" >= 4 THEN 'AMPLIFICATION'
                  WHEN g."max_copy_number" =  3 THEN 'GAIN'
                  WHEN g."max_copy_number" =  1 THEN 'HETEROZYGOUS_DELETION'
                  ELSE 'OTHER'
              END AS "cnv_category",
              g."chromosome"
       FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
       WHERE  g."project_short_name" = 'TCGA-KIRC'
         AND  g."chromosome"         = 'chr1'
      ) cnv
JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
  ON   cnv."chromosome"   = c."chromosome"
 AND   cnv."start_pos"   <= c."hg38_stop"
 AND   cnv."end_pos"     >= c."hg38_start"
GROUP BY
       c."cytoband_name",
       cnv."cnv_category"
LIMIT 20;
```

```sql
-- 8. Description:  Rank cytobands separately for Amplification, Gain, and
--    Heterozygous Deletion frequencies (top 11 for each category).
SELECT
       ranked.*
FROM (
       SELECT
              c."cytoband_name",
              cnv."cnv_category",
              COUNT(*)                                         AS "event_count",
              ROW_NUMBER() OVER (PARTITION BY cnv."cnv_category"
                                 ORDER BY COUNT(*) DESC)       AS "rank_within_category"
       FROM (
              SELECT
                     g."start_pos",
                     g."end_pos",
                     CASE
                         WHEN g."max_copy_number" >= 4 THEN 'AMPLIFICATION'
                         WHEN g."max_copy_number" =  3 THEN 'GAIN'
                         WHEN g."max_copy_number" =  1 THEN 'HETEROZYGOUS_DELETION'
                         ELSE 'OTHER'
                     END AS "cnv_category",
                     g."chromosome"
              FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
              WHERE  g."project_short_name" = 'TCGA-KIRC'
                AND  g."chromosome"         = 'chr1'
            ) cnv
       JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
         ON   cnv."chromosome" = c."chromosome"
        AND   cnv."start_pos" <= c."hg38_stop"
        AND   cnv."end_pos"   >= c."hg38_start"
       GROUP BY
              c."cytoband_name",
              cnv."cnv_category"
     ) ranked
WHERE  ranked."rank_within_category" <= 11
LIMIT 20;
```

```sql
-- 9. Description:  Isolate the set of chromosome-1 cytobands that appear in the
--    top-11 lists of ALL THREE categories (Amplification, Gain, Heterozygous Deletion).
SELECT DISTINCT
       a1."cytoband_name"
FROM (
        /* top-11 Amplifications */
        SELECT
               "cytoband_name"
        FROM  (
               /* reuse ranking logic */
               SELECT
                      c."cytoband_name",
                      ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rk
               FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
               JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
                 ON   g."chromosome"  = c."chromosome"
                AND   g."start_pos"  <= c."hg38_stop"
                AND   g."end_pos"    >= c."hg38_start"
               WHERE  g."project_short_name" = 'TCGA-KIRC'
                 AND  g."chromosome"         = 'chr1'
                 AND  g."max_copy_number"    >= 4
               GROUP BY c."cytoband_name"
               ORDER BY COUNT(*) DESC
               LIMIT 11
              ) amp
     ) a1
JOIN (
        /* top-11 Gains */
        SELECT
               "cytoband_name"
        FROM  (
               SELECT
                      c."cytoband_name",
                      ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rk
               FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
               JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
                 ON   g."chromosome" = c."chromosome"
                AND   g."start_pos" <= c."hg38_stop"
                AND   g."end_pos"   >= c."hg38_start"
               WHERE  g."project_short_name" = 'TCGA-KIRC'
                 AND  g."chromosome"         = 'chr1'
                 AND  g."max_copy_number"     = 3
               GROUP BY c."cytoband_name"
               ORDER BY COUNT(*) DESC
               LIMIT 11
              ) gain
     ) g1
  ON a1."cytoband_name" = g1."cytoband_name"
JOIN (
        /* top-11 Heterozygous Deletions */
        SELECT
               "cytoband_name"
        FROM  (
               SELECT
                      c."cytoband_name",
                      ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rk
               FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
               JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
                 ON   g."chromosome" = c."chromosome"
                AND   g."start_pos" <= c."hg38_stop"
                AND   g."end_pos"   >= c."hg38_start"
               WHERE  g."project_short_name" = 'TCGA-KIRC'
                 AND  g."chromosome"         = 'chr1'
                 AND  g."max_copy_number"     = 1
               GROUP BY c."cytoband_name"
               ORDER BY COUNT(*) DESC
               LIMIT 11
              ) het
     ) h1
  ON a1."cytoband_name" = h1."cytoband_name"
LIMIT 20;
```

```sql
-- 10. Description:  Retrieve final list of cytoband names (chromosome 1) that
--     simultaneously rank within the top-11 for Amplifications, Gains, and
--     Heterozygous Deletions in TCGA-KIRC (complete output).
SELECT *
FROM (
      /* repeat query 9 without LIMIT to deliver full intersection set,
         still capped at 20 rows for safety */
      SELECT DISTINCT
             a1."cytoband_name"
      FROM (
             /* top-11 Amplifications */
             SELECT
                    "cytoband_name"
             FROM  (
                    SELECT c."cytoband_name",
                           ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rk
                    FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
                    JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
                      ON   g."chromosome" = c."chromosome"
                     AND   g."start_pos" <= c."hg38_stop"
                     AND   g."end_pos"   >= c."hg38_start"
                    WHERE  g."project_short_name" = 'TCGA-KIRC'
                      AND  g."chromosome"         = 'chr1'
                      AND  g."max_copy_number"    >= 4
                    GROUP BY c."cytoband_name"
                    ORDER BY COUNT(*) DESC
                    LIMIT 11
                   )
            ) a1
      INNER JOIN (
             /* top-11 Gains */
             SELECT
                    "cytoband_name"
             FROM  (
                    SELECT c."cytoband_name",
                           ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rk
                    FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
                    JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
                      ON   g."chromosome" = c."chromosome"
                     AND   g."start_pos" <= c."hg38_stop"
                     AND   g."end_pos"   >= c."hg38_start"
                    WHERE  g."project_short_name" = 'TCGA-KIRC'
                      AND  g."chromosome"         = 'chr1'
                      AND  g."max_copy_number"     = 3
                    GROUP BY c."cytoband_name"
                    ORDER BY COUNT(*) DESC
                    LIMIT 11
                   )
            ) g1
        ON a1."cytoband_name" = g1."cytoband_name"
      INNER JOIN (
             /* top-11 Heterozygous Deletions */
             SELECT
                    "cytoband_name"
             FROM  (
                    SELECT c."cytoband_name",
                           ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rk
                    FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
                    JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
                      ON   g."chromosome" = c."chromosome"
                     AND   g."start_pos" <= c."hg38_stop"
                     AND   g."end_pos"   >= c."hg38_start"
                    WHERE  g."project_short_name" = 'TCGA-KIRC'
                      AND  g."chromosome"         = 'chr1'
                      AND  g."max_copy_number"     = 1
                    GROUP BY c."cytoband_name"
                    ORDER BY COUNT(*) DESC
                    LIMIT 11
                   )
            ) h1
        ON a1."cytoband_name" = h1."cytoband_name"
) final_intersection
LIMIT 20;
