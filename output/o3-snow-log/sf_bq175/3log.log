```sql
/*-----------------------------------------------------------------------------
  Identify chromosome-1 (hg38) cytobands in the TCGA-KIRC gene-level CNV data
  whose frequencies of AMPLIFICATION (max_copy_number ≥4), GAIN (=3) and
  HETEROZYGOUS_DELETION (=1) each rank within the top-11 of their
  respective categories.  A standardised chromosome key (chr1) is built to
  ensure that values such as “1” and “chr1” match the cytoband reference.
-----------------------------------------------------------------------------*/
WITH cnv_events AS (   -- 1. TCGA-KIRC chr1 CNV events of interest
    SELECT
        /* standardise chromosome to “chr*” so it always matches cytobands */
        CASE
            WHEN g."chromosome" LIKE 'chr%' THEN g."chromosome"
            ELSE CONCAT('chr', g."chromosome")
        END                                AS "chromosome_std",
        g."start_pos",
        g."end_pos",
        CASE
            WHEN g."max_copy_number" >= 4 THEN 'AMPLIFICATION'
            WHEN g."max_copy_number"  = 3 THEN 'GAIN'
            WHEN g."max_copy_number"  = 1 THEN 'HETEROZYGOUS_DELETION'
        END                                AS "cnv_category"
    FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
    WHERE g."project_short_name" = 'TCGA-KIRC'
      AND (g."chromosome" IN ('1', 'chr1'))          -- chromosome-1 only
      AND g."max_copy_number" IS NOT NULL
      AND g."max_copy_number" <> 2                   -- exclude diploid
      /* keep only rows that fall into one of the three categories          */
      AND (
             g."max_copy_number" = 1
          OR g."max_copy_number" = 3
          OR g."max_copy_number" >= 4
      )
),
cnv_counts AS (        -- 2. count events per cytoband & CNV category
    SELECT
        c."cytoband_name",
        e."cnv_category",
        COUNT(*)                         AS "event_count"
    FROM cnv_events e
    JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
      ON e."chromosome_std" = c."chromosome"
     AND e."start_pos"      <= c."hg38_stop"
     AND e."end_pos"        >= c."hg38_start"
    GROUP BY
        c."cytoband_name",
        e."cnv_category"
),
ranked AS (            -- 3. rank cytobands inside each category by frequency
    SELECT
        cc."cytoband_name",
        cc."cnv_category",
        ROW_NUMBER() OVER (
              PARTITION BY cc."cnv_category"
              ORDER BY cc."event_count" DESC NULLS LAST
        ) AS "rank_in_category"
    FROM cnv_counts cc
),
top11 AS (             -- 4. retain only the top-11 cytobands per category
    SELECT
        "cytoband_name",
        "cnv_category"
    FROM ranked
    WHERE "rank_in_category" <= 11
),
intersect_three AS (   -- 5. cytobands appearing in ALL THREE categories
    SELECT
        "cytoband_name"
    FROM top11
    GROUP BY "cytoband_name"
    HAVING COUNT(DISTINCT "cnv_category") = 3
)
SELECT
    "cytoband_name"
FROM intersect_three
ORDER BY "cytoband_name";
```
