--Description: Because TCGA-KICH chromosome 1 has virtually no ≥4-copy “AMPLIFICATION” events,
--focus on the two alteration types that do occur: GAIN (copy_number = 3) and 
--HETEROZYGOUS_DELETION (copy_number = 1).  For each type, count events per cytoband,
--rank them, and return the top-11 cytobands in each category (≤20 preview rows).
WITH event_counts AS (
    SELECT
           c."cytoband_name",
           CASE
               WHEN g."max_copy_number" = 3 THEN 'GAIN'
               WHEN g."max_copy_number" = 1 THEN 'HETEROZYGOUS_DELETION'
           END                         AS "cnv_category",
           COUNT(*)                    AS "event_count"
    FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
    JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
      ON   g."chromosome" = c."chromosome"
     AND   g."start_pos" <= c."hg38_stop"
     AND   g."end_pos"   >= c."hg38_start"
    WHERE  g."project_short_name" = 'TCGA-KICH'
      AND  g."chromosome"         = 'chr1'
      AND  g."max_copy_number" IN (1,3)          -- only categories that exist
    GROUP BY c."cytoband_name",
             CASE
                 WHEN g."max_copy_number" = 3 THEN 'GAIN'
                 WHEN g."max_copy_number" = 1 THEN 'HETEROZYGOUS_DELETION'
             END
),
ranked AS (
    SELECT
           e.*,
           ROW_NUMBER() OVER (PARTITION BY e."cnv_category"
                              ORDER BY e."event_count" DESC) AS "rk"
    FROM   event_counts e
)
SELECT
       "cytoband_name",
       "cnv_category",
       "event_count",
       "rk" AS "rank_within_category"
FROM   ranked
WHERE  "rk" <= 11
ORDER  BY "cnv_category", "rk"
LIMIT 20;
