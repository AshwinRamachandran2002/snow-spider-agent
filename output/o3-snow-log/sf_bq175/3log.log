--Description: TCGA-KICH chr1 lacks ≥4-copy “AMPLIFICATION” events, so intersect the top-11 cytobands for GAIN (copy_number = 3) and HETEROZYGOUS_DELETION (copy_number = 1) instead.  
--Step 1: build `gain_top` and `het_top` ranked by event count.  
--Step 2: return the cytobands common to both sets (≤20 rows).
WITH gain_top AS (
    SELECT c."cytoband_name"
    FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
    JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
      ON   g."chromosome" = c."chromosome"
     AND   g."start_pos" <= c."hg38_stop"
     AND   g."end_pos"   >= c."hg38_start"
    WHERE  g."project_short_name" = 'TCGA-KICH'
      AND  g."chromosome"         = 'chr1'
      AND  g."max_copy_number"     = 3            -- GAIN
    GROUP BY c."cytoband_name"
    ORDER  BY COUNT(*) DESC
    LIMIT 11
),
het_top AS (
    SELECT c."cytoband_name"
    FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
    JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
      ON   g."chromosome" = c."chromosome"
     AND   g."start_pos" <= c."hg38_stop"
     AND   g."end_pos"   >= c."hg38_start"
    WHERE  g."project_short_name" = 'TCGA-KICH'
      AND  g."chromosome"         = 'chr1'
      AND  g."max_copy_number"     = 1            -- HETEROZYGOUS_DELETION
    GROUP BY c."cytoband_name"
