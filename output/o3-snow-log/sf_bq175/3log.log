---------------------------------------------------------------------------*/
WITH cnv_events AS (                      -- 1. TCGA-KIRC chr1 events of interest
    SELECT
        g."start_pos",
        g."end_pos",
        g."chromosome",
        CASE
            WHEN g."max_copy_number" >= 4 THEN 'AMPLIFICATION'
            WHEN g."max_copy_number"  = 3 THEN 'GAIN'
            WHEN g."max_copy_number"  = 1 THEN 'HETEROZYGOUS_DELETION'
        END AS "cnv_category"
    FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
    WHERE g."project_short_name" = 'TCGA-KIRC'
      AND g."chromosome"         = 'chr1'
      AND g."max_copy_number" IN (1,3,4,5,6,7,8,9,10)   -- 1 / 3 / ≥4 copies
),
cnv_counts AS (                           -- 2. count events per cytoband & category
    SELECT
        c."cytoband_name",
        e."cnv_category",
        COUNT(*) AS "event_count"
    FROM cnv_events e
    JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
      ON  e."chromosome" = c."chromosome"
     AND e."start_pos"  <= c."hg38_stop"
     AND e."end_pos"    >= c."hg38_start"
    GROUP BY
        c."cytoband_name",
        e."cnv_category"
),
ranked AS (                               -- 3. rank cytobands within each category
    SELECT
        cc."cytoband_name",
        cc."cnv_category",
        cc."event_count",
        ROW_NUMBER() OVER (
            PARTITION BY cc."cnv_category"
            ORDER BY cc."event_count" DESC NULLS LAST
        ) AS "rank_in_category"
    FROM cnv_counts cc
)
