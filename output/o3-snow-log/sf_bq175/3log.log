--Description: Isolate chromosome-1 cytobands that appear in the top-11 lists for Amplifications, Gains, and Heterozygous Deletions in TCGA-KICH.
SELECT DISTINCT
       a1."cytoband_name"
FROM (
        /* top-11 Amplifications */
        SELECT
               "cytoband_name"
        FROM  (
               SELECT
                      c."cytoband_name",
                      ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rk
               FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
               JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
                 ON   g."chromosome" = c."chromosome"
                AND   g."start_pos" <= c."hg38_stop"
                AND   g."end_pos"   >= c."hg38_start"
               WHERE  g."project_short_name" = 'TCGA-KICH'
                 AND  g."chromosome"         = 'chr1'
                 AND  g."max_copy_number"    >= 4
               GROUP BY c."cytoband_name"
               ORDER BY COUNT(*) DESC
               LIMIT 11
              )
     ) a1
JOIN (
        /* top-11 Gains */
        SELECT
               "cytoband_name"
        FROM  (
               SELECT
                      c."cytoband_name",
                      ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rk
               FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
               JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
                 ON   g."chromosome" = c."chromosome"
                AND   g."start_pos" <= c."hg38_stop"
                AND   g."end_pos"   >= c."hg38_start"
               WHERE  g."project_short_name" = 'TCGA-KICH'
                 AND  g."chromosome"         = 'chr1'
                 AND  g."max_copy_number"     = 3
               GROUP BY c."cytoband_name"
               ORDER BY COUNT(*) DESC
               LIMIT 11
              )
     ) g1
  ON a1."cytoband_name" = g1."cytoband_name"
JOIN (
        /* top-11 Heterozygous Deletions */
        SELECT
               "cytoband_name"
        FROM  (
               SELECT
                      c."cytoband_name",
                      ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rk
               FROM   "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
               JOIN   "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" c
