```sql
--Description: 10) Rank cytobands on chromosome 1 for “TCGA-KICH” by high-gain (≥ 3),
--               standard gain (= 3), and heterozygous deletion (= 1) frequencies, and
--               keep those ranking in the top 11 for all three alteration types.
WITH band_stats AS (
  SELECT
    b."cytoband_name",
    COUNT_IF(g."max_copy_number" >= 3) AS "high_gain_cnt",
    COUNT_IF(g."max_copy_number" = 3)  AS "gain_cnt",
    COUNT_IF(g."max_copy_number" = 1)  AS "het_del_cnt"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
    ON g."chromosome" = b."chromosome"
   AND g."start_pos"  <= b."hg38_stop"
   AND g."end_pos"    >= b."hg38_start"
  WHERE g."project_short_name" = 'TCGA-KICH'
    AND g."chromosome" = 'chr1'
  GROUP BY b."cytoband_name"
), ranks AS (
  SELECT
    s.*,
    DENSE_RANK() OVER (ORDER BY s."high_gain_cnt" DESC) AS "high_gain_rank",
    DENSE_RANK() OVER (ORDER BY s."gain_cnt"      DESC) AS "gain_rank",
    DENSE_RANK() OVER (ORDER BY s."het_del_cnt"   DESC) AS "het_del_rank"
  FROM band_stats s
)
SELECT
  r."cytoband_name",
  r."high_gain_cnt",
  r."gain_cnt",
  r."het_del_cnt",
  r."high_gain_rank",
  r."gain_rank",
  r."het_del_rank"
FROM ranks r
WHERE r."high_gain_rank" <= 11
  AND r."gain_rank"      <= 11
  AND r."het_del_rank"   <= 11
ORDER BY r."cytoband_name"
LIMIT 20;
```
