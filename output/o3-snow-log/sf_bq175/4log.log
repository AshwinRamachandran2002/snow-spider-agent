```sql
--Description: 9) Consolidate amplification, gain, and het-deletion counts in one
--             query for comparison (TOP 20 rows ordered by amplification count).
SELECT 
  b."cytoband_name",
  COUNT_IF(g."max_copy_number" >= 4) AS "amp_cnt",
  COUNT_IF(g."max_copy_number" = 3)  AS "gain_cnt",
  COUNT_IF(g."max_copy_number" = 1)  AS "het_del_cnt"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
  ON g."chromosome"   = b."chromosome"
 AND g."start_pos"    <= b."hg38_stop"
 AND g."end_pos"      >= b."hg38_start"
WHERE g."project_short_name" = 'TCGA-KIRC'
  AND g."chromosome" = 'chr1'
GROUP BY b."cytoband_name"
ORDER BY "amp_cnt" DESC
LIMIT 20;
```

```sql
--Description: 10) Rank cytobands by each alteration type and keep ones that appear
--              in the TOP-11 across amplifications, gains, and het-deletions.
--              (Final filtered view, still limited to 20 rows for preview).
WITH band_stats AS (
  SELECT 
    b."cytoband_name",
    COUNT_IF(g."max_copy_number" >= 4) AS "amp_cnt",
    COUNT_IF(g."max_copy_number" = 3)  AS "gain_cnt",
    COUNT_IF(g."max_copy_number" = 1)  AS "het_del_cnt"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
    ON g."chromosome"   = b."chromosome"
   AND g."start_pos"    <= b."hg38_stop"
   AND g."end_pos"      >= b."hg38_start"
  WHERE g."project_short_name" = 'TCGA-KIRC'
    AND g."chromosome" = 'chr1'
  GROUP BY b."cytoband_name"
), ranks AS (
  SELECT
    s.*,
    DENSE_RANK() OVER (ORDER BY s."amp_cnt"  DESC) AS "amp_rank",
    DENSE_RANK() OVER (ORDER BY s."gain_cnt" DESC) AS "gain_rank",
    DENSE_RANK() OVER (ORDER BY s."het_del_cnt" DESC) AS "het_del_rank"
  FROM band_stats s
)
SELECT 
  r."cytoband_name",
  r."amp_cnt",
  r."gain_cnt",
  r."het_del_cnt",
  r."amp_rank",
  r."gain_rank",
  r."het_del_rank"
FROM ranks r
WHERE r."amp_rank"      <= 11
  AND r."gain_rank"     <= 11
  AND r."het_del_rank"  <= 11
ORDER BY r."cytoband_name"
LIMIT 20;
```
