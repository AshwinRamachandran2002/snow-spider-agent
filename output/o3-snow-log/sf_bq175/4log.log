   within the top-11 most-frequent bands                        */

WITH band_stats AS (
  SELECT
    b."cytoband_name",
    COUNT_IF(g."max_copy_number" >= 4) AS "amplification_cnt",
    COUNT_IF(g."max_copy_number" =  3) AS "gain_cnt",
    COUNT_IF(g."max_copy_number" =  1) AS "het_del_cnt"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
    /* harmonise chromosome labels (e.g. 1 vs chr1) */
    ON  REPLACE(g."chromosome", 'chr', '') = REPLACE(b."chromosome", 'chr', '')
   AND g."start_pos"  <= b."hg38_stop"
   AND g."end_pos"    >= b."hg38_start"
  WHERE g."project_short_name" = 'TCGA-KIRC'
    AND REPLACE(g."chromosome", 'chr', '') = '1'      -- chromosome 1 only
  GROUP BY b."cytoband_name"
),
ranks AS (
  SELECT
    s.*,
    DENSE_RANK() OVER (ORDER BY s."amplification_cnt" DESC NULLS LAST) AS "amplification_rank",
    DENSE_RANK() OVER (ORDER BY s."gain_cnt"          DESC NULLS LAST) AS "gain_rank",
    DENSE_RANK() OVER (ORDER BY s."het_del_cnt"       DESC NULLS LAST) AS "het_del_rank"
  FROM band_stats s
)
SELECT
  r."cytoband_name",
  r."amplification_cnt",
  r."gain_cnt",
  r."het_del_cnt",
  r."amplification_rank",
  r."gain_rank",
  r."het_del_rank"
FROM ranks r
WHERE r."amplification_rank" <= 11
  AND r."gain_rank"          <= 11
  AND r."het_del_rank"       <= 11
ORDER BY r."cytoband_name";
