```sql
--Description: Rank cytobands on chr1 for TCGA-KICH where high-copy (max_cn = 3) and heterozygous-deletion (max_cn = 1) 
--             counts each fall within their respective top 11 bands
WITH stats AS (
    SELECT c."cytoband_name",
           SUM(CASE WHEN g."max_copy_number" = 3 THEN 1 END) AS "high_cn_cnt",
           SUM(CASE WHEN g."max_copy_number" = 1 THEN 1 END) AS "het_del_cnt"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                c
      ON g."chromosome" = c."chromosome"
     AND g."start_pos"  <= c."hg38_stop"
     AND g."end_pos"    >= c."hg38_start"
    WHERE g."project_short_name" = 'TCGA-KICH'
      AND g."chromosome"        = 'chr1'
    GROUP BY c."cytoband_name"
), ranks AS (
    SELECT "cytoband_name",
           RANK() OVER (ORDER BY "high_cn_cnt" DESC) AS "high_cn_rnk",
           RANK() OVER (ORDER BY "het_del_cnt" DESC) AS "het_del_rnk"
    FROM stats
)
SELECT "cytoband_name",
       "high_cn_rnk",
       "het_del_rnk"
FROM ranks
WHERE "high_cn_rnk" <= 11
  AND "het_del_rnk" <= 11
ORDER BY "high_cn_rnk", "het_del_rnk"
LIMIT 20;
```
