```sql
--Description: Collate amplification, gain, and heterozygous deletion counts per cytoband on chr1 into one result set
SELECT  c."cytoband_name",
        SUM(CASE WHEN g."copy_number" > 3 THEN 1 END) AS "amp_cnt",
        SUM(CASE WHEN g."copy_number" = 3 THEN 1 END) AS "gain_cnt",
        SUM(CASE WHEN g."copy_number" = 1 THEN 1 END) AS "het_del_cnt"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                        c
  ON g."chromosome" = c."chromosome"
 AND g."start_pos"  <= c."hg38_stop"
 AND g."end_pos"    >= c."hg38_start"
WHERE g."project_short_name" = 'TCGA-KIRC'
  AND g."chromosome" = 'chr1'
GROUP BY c."cytoband_name"
ORDER BY "amp_cnt" DESC, "gain_cnt" DESC, "het_del_cnt" DESC
LIMIT 20;
```

```sql
--Description: Rank cytobands on chr1 for TCGA-KIRC where each alteration type (amp, gain, het. deletion) is within its top 11; filter the intersection
WITH stats AS (
     SELECT  c."cytoband_name",
             SUM(CASE WHEN g."copy_number" > 3 THEN 1 END) AS "amp_cnt",
             SUM(CASE WHEN g."copy_number" = 3 THEN 1 END) AS "gain_cnt",
             SUM(CASE WHEN g."copy_number" = 1 THEN 1 END) AS "het_del_cnt"
     FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
     JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                        c
       ON g."chromosome" = c."chromosome"
      AND g."start_pos"  <= c."hg38_stop"
      AND g."end_pos"    >= c."hg38_start"
     WHERE g."project_short_name" = 'TCGA-KIRC'
       AND g."chromosome" = 'chr1'
     GROUP BY c."cytoband_name"
), ranks AS (
     SELECT "cytoband_name",
            RANK() OVER (ORDER BY "amp_cnt"  DESC) AS "amp_rnk",
            RANK() OVER (ORDER BY "gain_cnt" DESC) AS "gain_rnk",
            RANK() OVER (ORDER BY "het_del_cnt" DESC) AS "het_del_rnk"
     FROM stats
)
SELECT "cytoband_name",
       "amp_rnk",
       "gain_rnk",
       "het_del_rnk"
FROM ranks
WHERE "amp_rnk"  <= 11
  AND "gain_rnk" <= 11
  AND "het_del_rnk" <= 11
ORDER BY "amp_rnk", "gain_rnk", "het_del_rnk"
LIMIT 20;
```
