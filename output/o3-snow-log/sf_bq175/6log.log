```sql
--Description: Determine amplified event counts per cytoband on chr1 for TCGA-KIRC by overlapping gene ranges with cytobands
SELECT c."cytoband_name",
       COUNT(*) AS "amp_count"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
