```sql
/* 1. Delivered orders only (runner did not cancel) */
WITH delivered_orders AS (
    SELECT DISTINCT "order_id"
    FROM MODERN_DATA.MODERN_DATA.PIZZA_RUNNER_ORDERS
    WHERE TRIM("cancellation") = ''
),

/* 2. Every pizza that was actually delivered */
order_pizzas AS (
    SELECT  o."order_id",
            o."pizza_id",
            o."exclusions",
            o."extras"
    FROM MODERN_DATA.MODERN_DATA.PIZZA_CUSTOMER_ORDERS o
    JOIN delivered_orders d
      ON d."order_id" = o."order_id"
),

/* 3. Recipe toppings for each delivered pizza */
recipe_toppings AS (
    SELECT  op."order_id",
            op."pizza_id",
            value::NUMBER            AS topping_id
    FROM order_pizzas op
    JOIN MODERN_DATA.MODERN_DATA.PIZZA_RECIPES r
      ON r."pizza_id" = op."pizza_id",
         LATERAL FLATTEN(
             SPLIT(REPLACE(r."toppings",' ',''), ',')
         )
),

/* 4. Extra toppings the customer asked for */
extra_toppings AS (
    SELECT  op."order_id",
            op."pizza_id",
            value::NUMBER            AS topping_id
    FROM order_pizzas op,
         LATERAL FLATTEN(
             CASE
                 WHEN TRIM(op."extras") = '' THEN ARRAY_CONSTRUCT()
                 ELSE SPLIT(REPLACE(op."extras",' ',''), ',')
             END
         )
),

/* 5. All toppings (recipe + extras) */
all_toppings AS (
    SELECT * FROM recipe_toppings
    UNION ALL
    SELECT * FROM extra_toppings
),

/* 6. Toppings the customer excluded */
excluded_toppings AS (
    SELECT  op."order_id",
            op."pizza_id",
            value::NUMBER            AS topping_id
    FROM order_pizzas op,
         LATERAL FLATTEN(
             CASE
                 WHEN TRIM(op."exclusions") = '' THEN ARRAY_CONSTRUCT()
                 ELSE SPLIT(REPLACE(op."exclusions",' ',''), ',')
             END
         )
),

/* 7. Final toppings actually used = (all – exclusions) */
final_toppings AS (
    SELECT  at."topping_id"
    FROM all_toppings at
    LEFT JOIN excluded_toppings et
           ON  et."order_id" = at."order_id"
           AND et."pizza_id" = at."pizza_id"
           AND et."topping_id" = at."topping_id"
    WHERE et."topping_id" IS NULL
)

/* 8. Aggregate quantity per ingredient */
SELECT  pt."topping_name"                     AS ingredient_name,
        COUNT(*)                              AS quantity
FROM final_toppings ft
JOIN MODERN_DATA.MODERN_DATA.PIZZA_TOPPINGS pt
  ON pt."topping_id" = ft."topping_id"
GROUP BY pt."topping_name"
ORDER BY quantity DESC NULLS LAST;
```
