    ),
    bike AS (
        SELECT
            TO_DATE( TO_TIMESTAMP( "starttime"/1000000 ) ) AS "day",
            COUNT(*) AS "trips"
        FROM NEW_YORK_GHCN.NEW_YORK.CITIBIKE_TRIPS
        WHERE "starttime" BETWEEN 1451606400000000 AND 1483228799000000
        GROUP BY "day"
    )
    SELECT
        r."rain_flag",
        AVG(b."trips") AS "avg_daily_citibike_trips"
    FROM rain r
    JOIN bike b USING ("day")
    GROUP BY r."rain_flag"
) x
