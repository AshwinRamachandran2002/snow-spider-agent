--Description: Join daily Citi Bike totals with rain classification and compute the average trips for each type of day.
WITH rain AS (
    SELECT
        "date"                         AS "day",
        CASE WHEN ("value"/10.0) > 5 
             THEN 'RAINY' ELSE 'NON_RAINY' END AS "rain_flag"
    FROM NEW_YORK_GHCN.GHCN_D.GHCND_2016
    WHERE "id" = 'USW00094728'
      AND "element" = 'PRCP'
      AND "qflag" IS NULL
),
bike AS (
    SELECT
        TO_DATE( TO_TIMESTAMP( "starttime"/1000000 ) ) AS "day",
        COUNT(*) AS "trips"
    FROM NEW_YORK_GHCN.NEW_YORK.CITIBIKE_TRIPS
    WHERE "starttime" BETWEEN 1451606400000000 AND 1483228799000000
    GROUP BY "day"
)
SELECT
    r."rain_flag",
    AVG(b."trips") AS "avg_daily_citibike_trips"
FROM rain r
JOIN bike b USING ("day")
GROUP BY r."rain_flag"
LIMIT 20;
