Query:
--Description: List the 20 GHCN stations nearest to Times Sq. (40.7128 -74.0060) and within 50 km.
SELECT
    "id",
    "name",
    "latitude",
    "longitude",
    6371*2*ASIN( SQRT(
          POWER( SIN( ( RADIANS("latitude") - RADIANS(40.7128) )/2 ), 2 )
        + COS( RADIANS(40.7128) )*COS( RADIANS("latitude") )*
          POWER( SIN( ( RADIANS("longitude") - RADIANS(-74.0060) )/2 ), 2 )
    ) )  AS "distance_km"
FROM NEW_YORK_GHCN.GHCN_D.GHCND_STATIONS
HAVING "distance_km" < 50
ORDER BY "distance_km"
LIMIT 20;
