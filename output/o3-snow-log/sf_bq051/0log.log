--Description: Classify each 2016 day for that station as RAINY ( >5 mm ) or NON_RAINY ( ≤5 mm ).
WITH pr AS (
    SELECT "date",
           ("value"/10.0) AS "precip_mm"
    FROM NEW_YORK_GHCN.GHCN_D.GHCND_2016
    WHERE "id" = 'USW00094728'
      AND "element" = 'PRCP'
      AND "qflag" IS NULL
)
SELECT
    "date",
    CASE WHEN "precip_mm" > 5 THEN 'RAINY' ELSE 'NON_RAINY' END AS "rain_flag",
    "precip_mm"
FROM pr
ORDER BY "date"
LIMIT 20;
