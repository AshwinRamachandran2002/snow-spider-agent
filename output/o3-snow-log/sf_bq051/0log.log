```sql
--Description: Peek at a few Citi Bike trips that started in 2016 to verify the epoch-µs time-stamp column.
SELECT 
    "tripduration",
    "starttime",
    "stoptime",
    "start_station_id",
    "end_station_id"
FROM NEW_YORK_GHCN.NEW_YORK.CITIBIKE_TRIPS
WHERE "starttime" BETWEEN 1451606400000000 /*2016-01-01*/ 
                      AND 1483228799000000 /*2016-12-31*/
LIMIT 20;
```

```sql
--Description: Count Citi Bike trips by calendar day for 2016 (NYC local date).
SELECT
    TO_DATE( TO_TIMESTAMP( "starttime"/1000000 ) ) AS "trip_date",
    COUNT(*) AS "daily_citibike_trips"
FROM NEW_YORK_GHCN.NEW_YORK.CITIBIKE_TRIPS
WHERE "starttime" BETWEEN 1451606400000000 AND 1483228799000000
GROUP BY "trip_date"
ORDER BY "trip_date"
LIMIT 20;
```

```sql
--Description: List the 20 GHCN stations nearest to Times Sq. (40.7128 -74.0060) and within 50 km.
SELECT
    "id",
    "name",
    "latitude",
    "longitude",
    6371*2*ASIN( SQRT(
          POWER( SIN( ( RADIANS("latitude") - RADIANS(40.7128) )/2 ), 2 )
        + COS( RADIANS(40.7128) )*COS( RADIANS("latitude") )*
          POWER( SIN( ( RADIANS("longitude") - RADIANS(-74.0060) )/2 ), 2 )
    ) )  AS "distance_km"
FROM NEW_YORK_GHCN.GHCN_D.GHCND_STATIONS
HAVING "distance_km" < 50
ORDER BY "distance_km"
LIMIT 20;
```

```sql
--Description: Check which of those nearby stations report precipitation (element ‘PRCP’) covering 2016.
SELECT DISTINCT
    inv."id",
    MIN(inv."firstyear") AS "first_year",
    MAX(inv."lastyear")  AS "last_year"
FROM NEW_YORK_GHCN.GHCN_D.GHCND_INVENTORY inv
JOIN (   /* sub-set to the 50 km list produced above */
      SELECT "id"
      FROM NEW_YORK_GHCN.GHCN_D.GHCND_STATIONS
      HAVING 6371*2*ASIN( SQRT(
              POWER( SIN( ( RADIANS("latitude") - RADIANS(40.7128) )/2 ), 2 )
            + COS( RADIANS(40.7128) )*COS( RADIANS("latitude") )*
              POWER( SIN( ( RADIANS("longitude") - RADIANS(-74.0060) )/2 ), 2 )
      ) ) < 50
) s USING ("id")
WHERE inv."element" = 'PRCP'
GROUP BY inv."id"
HAVING MAX(inv."lastyear") >= 2016
ORDER BY "last_year" DESC
LIMIT 20;
```

```sql
--Description: Show a sample of 2016 precipitation rows for the closest qualified station (replace ‘STATION_ID’ with one selected from the query above, e.g. 'USW00094728').
SELECT 
    "id",
    "date",
    "element",
    "value",
    "mflag",
    "qflag",
    "sflag"
FROM NEW_YORK_GHCN.GHCN_D.GHCND_2016
WHERE "id" = 'USW00094728'            -- put actual id found
  AND "element" = 'PRCP'
LIMIT 20;
```

```sql
--Description: Compute daily precipitation (mm = value/10) for that station in 2016, keeping only un-flagged rows.
SELECT
    "date",
    ("value"/10.0) AS "precip_mm"
FROM NEW_YORK_GHCN.GHCN_D.GHCND_2016
WHERE "id" = 'USW00094728'
  AND "element" = 'PRCP'
  AND "qflag" IS NULL
ORDER BY "date"
LIMIT 20;
```

```sql
--Description: Classify each 2016 day for that station as RAINY ( >5 mm ) or NON_RAINY ( ≤5 mm ).
WITH pr AS (
    SELECT "date",
           ("value"/10.0) AS "precip_mm"
    FROM NEW_YORK_GHCN.GHCN_D.GHCND_2016
    WHERE "id" = 'USW00094728'
      AND "element" = 'PRCP'
      AND "qflag" IS NULL
)
SELECT
    "date",
    CASE WHEN "precip_mm" > 5 THEN 'RAINY' ELSE 'NON_RAINY' END AS "rain_flag",
    "precip_mm"
FROM pr
ORDER BY "date"
LIMIT 20;
```

```sql
--Description: Produce complete 2016 daily Citi Bike trip counts (will later be joined to rainfall flag).
SELECT
    TO_DATE( TO_TIMESTAMP( "starttime"/1000000 ) ) AS "trip_date",
    COUNT(*) AS "daily_trips"
FROM NEW_YORK_GHCN.NEW_YORK.CITIBIKE_TRIPS
WHERE "starttime" BETWEEN 1451606400000000 AND 1483228799000000
GROUP BY "trip_date"
LIMIT 20;
```

```sql
--Description: Join daily Citi Bike totals with rain classification and compute the average trips for each type of day.
WITH rain AS (
    SELECT
        "date"                         AS "day",
        CASE WHEN ("value"/10.0) > 5 
             THEN 'RAINY' ELSE 'NON_RAINY' END AS "rain_flag"
    FROM NEW_YORK_GHCN.GHCN_D.GHCND_2016
    WHERE "id" = 'USW00094728'
      AND "element" = 'PRCP'
      AND "qflag" IS NULL
),
bike AS (
    SELECT
        TO_DATE( TO_TIMESTAMP( "starttime"/1000000 ) ) AS "day",
        COUNT(*) AS "trips"
    FROM NEW_YORK_GHCN.NEW_YORK.CITIBIKE_TRIPS
    WHERE "starttime" BETWEEN 1451606400000000 AND 1483228799000000
    GROUP BY "day"
)
SELECT
    r."rain_flag",
    AVG(b."trips") AS "avg_daily_citibike_trips"
FROM rain r
JOIN bike b USING ("day")
GROUP BY r."rain_flag"
LIMIT 20;
```

```sql
--Description: (Final) Display the rainy vs non-rainy average Citi Bike usage side-by-side.
SELECT
    MAX( CASE WHEN "rain_flag"='RAINY'     THEN "avg_daily_citibike_trips" END ) AS "avg_trips_rainy_days",
    MAX( CASE WHEN "rain_flag"='NON_RAINY' THEN "avg_daily_citibike_trips" END ) AS "avg_trips_non_rainy_days"
FROM (
    /* reuse previous aggregation as an inline view */
    WITH rain AS (
        SELECT
            "date" AS "day",
            CASE WHEN ("value"/10.0) > 5 THEN 'RAINY' ELSE 'NON_RAINY' END AS "rain_flag"
        FROM NEW_YORK_GHCN.GHCN_D.GHCND_2016
        WHERE "id" = 'USW00094728'
          AND "element" = 'PRCP'
          AND "qflag" IS NULL
    ),
    bike AS (
        SELECT
            TO_DATE( TO_TIMESTAMP( "starttime"/1000000 ) ) AS "day",
            COUNT(*) AS "trips"
        FROM NEW_YORK_GHCN.NEW_YORK.CITIBIKE_TRIPS
        WHERE "starttime" BETWEEN 1451606400000000 AND 1483228799000000
        GROUP BY "day"
    )
    SELECT
        r."rain_flag",
        AVG(b."trips") AS "avg_daily_citibike_trips"
    FROM rain r
    JOIN bike b USING ("day")
    GROUP BY r."rain_flag"
) x
LIMIT 20;
```
