```sql
/*---------------------------------------------------------------
  Average forecasted annual sales (2018) for products 4160 & 7790
  – First 36 months of data (Jan-2016 … Dec-2018)
  – Seasonality based on time-steps 7 … 30
  – “Weighted” (weight = month-index) linear-trend regression
----------------------------------------------------------------*/
WITH base AS (  -- grab the first 36 months for the two products
    SELECT
        "product_id",
        TO_DATE("mth")             AS mth_date,
        "qty"
    FROM  ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
    WHERE "product_id" IN (4160, 7790)
      AND TO_DATE("mth") BETWEEN '2016-01-01' AND '2018-12-31'
),
idx_tbl AS (    -- attach a month-index and month-of-year
    SELECT
        "product_id",
        mth_date,
        "qty",
        ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY mth_date)         AS idx,
        EXTRACT(month FROM mth_date)                                            AS month_no
    FROM base
),
cma_tbl AS (    -- two overlapping 12-month moving averages
    SELECT
        t.*,
        AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY idx ROWS BETWEEN 5 PRECEDING AND 6 FOLLOWING) AS ma1,
        AVG("qty") OVER (PARTITION BY "product_id"
                         ORDER BY idx ROWS BETWEEN 6 PRECEDING AND 5 FOLLOWING) AS ma2
    FROM idx_tbl t
),
ratio_tbl AS (  -- centred moving average (CMA) & Sales/CMA ratio
    SELECT
        "product_id"              AS product_id,
        mth_date,
        "qty"                     AS qty,
        idx,
        month_no,
        (ma1 + ma2)/2             AS cma_qty,
        CASE WHEN (ma1 + ma2) IS NOT NULL
