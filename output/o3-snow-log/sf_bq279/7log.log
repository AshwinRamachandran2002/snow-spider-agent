FROM AUSTIN.AUSTIN_BIKESHARE.BIKESHARE_STATIONS
WHERE DATE_PART('year', TO_TIMESTAMP("modified_date" / 1000000)) IN (2013, 2014)
GROUP BY 1
ORDER BY 1;
