Query:
--Description: ❾  Combine the six annual tables, compute medians, and find absolute differences for 2012-2017
WITH unified AS (
    SELECT SUBSTR("tax_pd",1,4)::NUMBER AS "year", "totrevenue", "totfuncexpns"
      FROM IRS_990.IRS_990."IRS_990_2012"
    UNION ALL
    SELECT FLOOR("tax_pd"/100)          AS "year", "totrevenue", "totfuncexpns"
      FROM IRS_990.IRS_990."IRS_990_2013"
    UNION ALL
    SELECT FLOOR("tax_pd"/100)          AS "year", "totrevenue", "totfuncexpns"
      FROM IRS_990.IRS_990."IRS_990_2014"
    UNION ALL
    SELECT FLOOR("tax_pd"/100)          AS "year", "totrevenue", "totfuncexpns"
      FROM IRS_990.IRS_990."IRS_990_2015"
    UNION ALL
    SELECT FLOOR("tax_pd"/100)          AS "year", "totrevenue", "totfuncexpns"
      FROM IRS_990.IRS_990."IRS_990_2016"
    UNION ALL
    SELECT FLOOR("tax_pd"/100)          AS "year", "totrevenue", "totfuncexpns"
      FROM IRS_990.IRS_990."IRS_990_2017"
)
SELECT "year",
       APPROX_PERCENTILE("totrevenue",0.5)   AS "median_revenue",
       APPROX_PERCENTILE("totfuncexpns",0.5) AS "median_expenses",
       ABS( APPROX_PERCENTILE("totrevenue",0.5)
          - APPROX_PERCENTILE("totfuncexpns",0.5) ) AS "abs_median_diff"
FROM   unified
WHERE  "year" BETWEEN 2012 AND 2017
  AND   "totrevenue"    IS NOT NULL
  AND   "totfuncexpns" IS NOT NULL
GROUP  BY "year"
ORDER  BY "abs_median_diff" ASC
LIMIT  20;
