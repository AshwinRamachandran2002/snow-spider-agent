       "totrevenue",
       "totfuncexpns"
FROM IRS_990.IRS_990.IRS_990_2013
LIMIT 20;
```

```sql
--Description: Verify distinct years that show up once we union together **all** 2012-2017 990 tables.
SELECT DISTINCT "year"
FROM (
        SELECT TO_NUMBER(SUBSTR("tax_pd",1,4)) AS "year"
        FROM IRS_990.IRS_990.IRS_990_2012
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year" FROM IRS_990.IRS_990.IRS_990_2013
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year" FROM IRS_990.IRS_990.IRS_990_2014
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year" FROM IRS_990.IRS_990.IRS_990_2015
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year" FROM IRS_990.IRS_990.IRS_990_2016
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year" FROM IRS_990.IRS_990.IRS_990_2017
) q
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: Compute the median revenue & median functional expenses **per year**
--             for the single 2012 file only (sense-check medians).
SELECT TO_NUMBER(SUBSTR("tax_pd",1,4))                               AS "year",
       MEDIAN("totrevenue")     AS "median_revenue",
       MEDIAN("totfuncexpns")   AS "median_expenses"
FROM IRS_990.IRS_990.IRS_990_2012
GROUP BY "year"
LIMIT 20;
```

```sql
--Description: Roll every 2012-2017 Form-990 record into one derived set, then
--             produce yearly medians of revenue vs. functional expenses.
SELECT d."year",
       MEDIAN(d."totrevenue")     AS "median_revenue",
       MEDIAN(d."totfuncexpns")   AS "median_expenses"
FROM (
        SELECT TO_NUMBER(SUBSTR("tax_pd",1,4)) AS "year",
               "totrevenue",
               "totfuncexpns"
        FROM IRS_990.IRS_990.IRS_990_2012
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year",
               "totrevenue",
               "totfuncexpns"
        FROM IRS_990.IRS_990.IRS_990_2013
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year",
               "totrevenue",
               "totfuncexpns"
        FROM IRS_990.IRS_990.IRS_990_2014
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year",
               "totrevenue",
               "totfuncexpns"
        FROM IRS_990.IRS_990.IRS_990_2015
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year",
               "totrevenue",
               "totfuncexpns"
        FROM IRS_990.IRS_990.IRS_990_2016
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year",
               "totrevenue",
               "totfuncexpns"
        FROM IRS_990.IRS_990.IRS_990_2017
     ) d
WHERE d."year" BETWEEN 2012 AND 2017
GROUP BY d."year"
ORDER BY d."year"
LIMIT 20;
```

```sql
--Description: Add the absolute difference between those two medians for each year.
SELECT a."year",
       a."median_revenue",
       a."median_expenses",
       ABS(a."median_revenue" - a."median_expenses") AS "median_diff"
FROM (
        SELECT d."year",
               MEDIAN(d."totrevenue")     AS "median_revenue",
               MEDIAN(d."totfuncexpns")   AS "median_expenses"
        FROM (
                SELECT TO_NUMBER(SUBSTR("tax_pd",1,4)) AS "year",
                       "totrevenue",
                       "totfuncexpns"
                FROM IRS_990.IRS_990.IRS_990_2012
                UNION ALL
                SELECT FLOOR("tax_pd"/100), "totrevenue", "totfuncexpns" FROM IRS_990.IRS_990.IRS_990_2013
                UNION ALL
                SELECT FLOOR("tax_pd"/100), "totrevenue", "totfuncexpns" FROM IRS_990.IRS_990.IRS_990_2014
                UNION ALL
                SELECT FLOOR("tax_pd"/100), "totrevenue", "totfuncexpns" FROM IRS_990.IRS_990.IRS_990_2015
                UNION ALL
                SELECT FLOOR("tax_pd"/100), "totrevenue", "totfuncexpns" FROM IRS_990.IRS_990.IRS_990_2016
                UNION ALL
                SELECT FLOOR("tax_pd"/100), "totrevenue", "totfuncexpns" FROM IRS_990.IRS_990.IRS_990_2017
             ) d
        WHERE d."year" BETWEEN 2012 AND 2017
        GROUP BY d."year"
     ) a
ORDER BY a."year"
LIMIT 20;
```

```sql
--Description: Final step – pull the three years (2012-2017) that have the SMALLEST
--             absolute gap between median revenue and median functional expenses.
SELECT a."year",
       ABS(a."median_revenue" - a."median_expenses") AS "median_difference"
FROM (
        SELECT d."year",
               MEDIAN(d."totrevenue")     AS "median_revenue",
               MEDIAN(d."totfuncexpns")   AS "median_expenses"
        FROM (
                SELECT TO_NUMBER(SUBSTR("tax_pd",1,4)) AS "year",
                       "totrevenue",
                       "totfuncexpns"
                FROM IRS_990.IRS_990.IRS_990_2012
                UNION ALL
                SELECT FLOOR("tax_pd"/100), "totrevenue", "totfuncexpns" FROM IRS_990.IRS_990.IRS_990_2013
                UNION ALL
                SELECT FLOOR("tax_pd"/100), "totrevenue", "totfuncexpns" FROM IRS_990.IRS_990.IRS_990_2014
                UNION ALL
                SELECT FLOOR("tax_pd"/100), "totrevenue", "totfuncexpns" FROM IRS_990.IRS_990.IRS_990_2015
                UNION ALL
                SELECT FLOOR("tax_pd"/100), "totrevenue", "totfuncexpns" FROM IRS_990.IRS_990.IRS_990_2016
                UNION ALL
                SELECT FLOOR("tax_pd"/100), "totrevenue", "totfuncexpns" FROM IRS_990.IRS_990.IRS_990_2017
             ) d
        WHERE d."year" BETWEEN 2012 AND 2017
        GROUP BY d."year"
     ) a
ORDER BY "median_difference" ASC
LIMIT 3;
```
