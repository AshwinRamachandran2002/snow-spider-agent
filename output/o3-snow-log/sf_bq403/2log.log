Query:
--Description: Roll every 2012-2017 Form-990 record into one derived set, then
--             produce yearly medians of revenue vs. functional expenses.
SELECT d."year",
       MEDIAN(d."totrevenue")     AS "median_revenue",
       MEDIAN(d."totfuncexpns")   AS "median_expenses"
FROM (
        SELECT TO_NUMBER(SUBSTR("tax_pd",1,4)) AS "year",
               "totrevenue",
               "totfuncexpns"
        FROM IRS_990.IRS_990.IRS_990_2012
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year",
               "totrevenue",
               "totfuncexpns"
        FROM IRS_990.IRS_990.IRS_990_2013
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year",
               "totrevenue",
               "totfuncexpns"
        FROM IRS_990.IRS_990.IRS_990_2014
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year",
               "totrevenue",
               "totfuncexpns"
        FROM IRS_990.IRS_990.IRS_990_2015
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year",
               "totrevenue",
               "totfuncexpns"
        FROM IRS_990.IRS_990.IRS_990_2016
        UNION ALL
        SELECT FLOOR("tax_pd"/100)            AS "year",
               "totrevenue",
               "totfuncexpns"
        FROM IRS_990.IRS_990.IRS_990_2017
     ) d
WHERE d."year" BETWEEN 2012 AND 2017
GROUP BY d."year"
ORDER BY d."year"
LIMIT 20;
