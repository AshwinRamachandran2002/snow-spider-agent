-- 10. Description: order the combined results to see the three smallest median differences
WITH yearly AS (
    SELECT '2012' AS "year", MEDIAN("totrevenue") AS "median_revenue", MEDIAN("totfuncexpns") AS "median_expenses",
           ABS( MEDIAN("totrevenue") - MEDIAN("totfuncexpns") ) AS "median_diff"
    FROM IRS_990.IRS_990."IRS_990_2012"
    UNION ALL
    SELECT '2013', MEDIAN("totrevenue"), MEDIAN("totfuncexpns"),
           ABS( MEDIAN("totrevenue") - MEDIAN("totfuncexpns") )
    FROM IRS_990.IRS_990."IRS_990_2013"
    UNION ALL
    SELECT '2014', MEDIAN("totrevenue"), MEDIAN("totfuncexpns"),
           ABS( MEDIAN("totrevenue") - MEDIAN("totfuncexpns") )
    FROM IRS_990.IRS_990."IRS_990_2014"
    UNION ALL
    SELECT '2015', MEDIAN("totrevenue"), MEDIAN("totfuncexpns"),
           ABS( MEDIAN("totrevenue") - MEDIAN("totfuncexpns") )
    FROM IRS_990.IRS_990."IRS_990_2015"
    UNION ALL
    SELECT '2016', MEDIAN("totrevenue"), MEDIAN("totfuncexpns"),
           ABS( MEDIAN("totrevenue") - MEDIAN("totfuncexpns") )
    FROM IRS_990.IRS_990."IRS_990_2016"
    UNION ALL
    SELECT '2017', MEDIAN("totrevenue"), MEDIAN("totfuncexpns"),
           ABS( MEDIAN("totrevenue") - MEDIAN("totfuncexpns") )
    FROM IRS_990.IRS_990."IRS_990_2017"
)
SELECT *
FROM yearly
ORDER BY "median_diff" ASC
LIMIT 20;
