```sql
--Description: Combine all years 2012-2017, compute medians per year (each table already represents a year)  
SELECT *
FROM (
      SELECT '2012' AS "filing_year", MEDIAN("totrevenue") AS "median_revenue",
             MEDIAN("totfuncexpns") AS "median_expenses"
      FROM   IRS_990.IRS_990."IRS_990_2012"
      UNION ALL
      SELECT '2013', MEDIAN("totrevenue"), MEDIAN("totfuncexpns")
      FROM   IRS_990.IRS_990."IRS_990_2013"
      UNION ALL
      SELECT '2014', MEDIAN("totrevenue"), MEDIAN("totfuncexpns")
      FROM   IRS_990.IRS_990."IRS_990_2014"
      UNION ALL
      SELECT '2015', MEDIAN("totrevenue"), MEDIAN("totfuncexpns")
      FROM   IRS_990.IRS_990."IRS_990_2015"
      UNION ALL
      SELECT '2016', MEDIAN("totrevenue"), MEDIAN("totfuncexpns")
      FROM   IRS_990.IRS_990."IRS_990_2016"
      UNION ALL
      SELECT '2017', MEDIAN("totrevenue"), MEDIAN("totfuncexpns")
      FROM   IRS_990.IRS_990."IRS_990_2017"
) t
LIMIT 20;
```

```sql
--Description: Add absolute difference between medians and show all six years  
SELECT  "filing_year",
        "median_revenue",
        "median_expenses",
        ABS("median_revenue" - "median_expenses") AS "median_diff"
FROM (
      SELECT '2012' AS "filing_year", MEDIAN("totrevenue") AS "median_revenue",
             MEDIAN("totfuncexpns") AS "median_expenses"
      FROM   IRS_990.IRS_990."IRS_990_2012"
      UNION ALL
      SELECT '2013', MEDIAN("totrevenue"), MEDIAN("totfuncexpns")
      FROM   IRS_990.IRS_990."IRS_990_2013"
      UNION ALL
      SELECT '2014', MEDIAN("totrevenue"), MEDIAN("totfuncexpns")
      FROM   IRS_990.IRS_990."IRS_990_2014"
      UNION ALL
      SELECT '2015', MEDIAN("totrevenue"), MEDIAN("totfuncexpns")
      FROM   IRS_990.IRS_990."IRS_990_2015"
      UNION ALL
      SELECT '2016', MEDIAN("totrevenue"), MEDIAN("totfuncexpns")
      FROM   IRS_990.IRS_990."IRS_990_2016"
      UNION ALL
      SELECT '2017', MEDIAN("totrevenue"), MEDIAN("totfuncexpns")
      FROM   IRS_990.IRS_990."IRS_990_2017"
) t
ORDER BY "median_diff"
LIMIT 20;
```

