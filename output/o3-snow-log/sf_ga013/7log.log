            WHEN POSITION('+' IN f.value:"value":"string_value"::STRING) > 0 THEN 'PDP'
            ELSE 'PLP'
        END                            AS "PAGE_TYPE",
        COUNT(*)                       AS "HITS"
FROM    GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
