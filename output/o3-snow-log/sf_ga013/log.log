```sql
-- Description / Thinking Process:
-- • Task: Retrieve every unique “page_location” URL that user 1402138.5184246691
--   visited on 02-Jan-2021 and label it as PDP or PLP.
-- • Source table: "EVENTS_20210102" (daily GA4 export for that date).
-- • page_location sits inside the semi-structured column EVENT_PARAMS.
--   We must FLATTEN this array to pull the element whose key = 'page_location'.
-- • PDP rule  : URL contains a “+” sign in the last (product) segment → test with ILIKE '%+%'.
-- • PLP rule  : URL has none of those “+” signs but does include a known category folder
--               (Accessories, Apparel, Lifestyle, etc.).  We check with ILIKE ANY and
--               ARRAY_CONSTRUCT holding the patterns ‘%/Category/%’.
-- • Evaluation order: PDP first (more specific), then PLP, else OTHER.
-- • DISTINCT removes duplicates; LIMIT 20 keeps result set small for inspection.
SELECT DISTINCT
       loc.value:"value":"string_value"::STRING                                 AS "page_location",
       CASE
            /* PDP if URL contains a plus sign anywhere (proxy for “+” in last segment) */
            WHEN loc.value:"value":"string_value"::STRING ILIKE '%+%'                THEN 'PDP'
            /* Otherwise PLP if URL contains one of our category path fragments */
            WHEN loc.value:"value":"string_value"::STRING ILIKE ANY (
                 ARRAY_CONSTRUCT(
                   '%/Accessories/%','%/Apparel/%','%/Brands/%',
                   '%/Campus%Collection/%','%/Drinkware/%','%/Electronics/%',
                   '%/Google%Redesign/%','%/Lifestyle/%','%/Nest/%',
                   '%/New%2015%20Logo/%','%/Notebooks%Journals/%','%/Office/%',
                   '%/Shop%by%Brand/%','%/Small%Goods/%','%/Stationery/%',
                   '%/Wearables/%')
            )                                                                         THEN 'PLP'
            ELSE 'OTHER'
       END                                                                           AS "page_type"
FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" AS t,
     LATERAL FLATTEN(input => t."EVENT_PARAMS") AS loc
WHERE t."USER_PSEUDO_ID" = '1402138.5184246691'
  AND loc.value:"key"::STRING = 'page_location'
LIMIT 20;
