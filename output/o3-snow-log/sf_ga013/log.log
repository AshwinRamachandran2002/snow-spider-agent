```sql
--Description:  Retrieve every unique page URL (“page_location”) that user 1402138.5184246691
--              visited on 02-Jan-2021 and classify the page as PDP or PLP in one pass.
--              • Flatten EVENT_PARAMS to isolate the element whose key = 'page_location'.
--              • PDP  = URL’s last segment contains a “+” (proxy test with REGEXP_LIKE on ‘/+[^/]*\+[^/]*$’).
--              • PLP  = URL contains one of the 16 category folders and does NOT match the PDP test.
--              • ILIKE ANY accepts a comma-separated list of patterns.
--              The query shows a de-duplicated list of pages with their inferred type (LIMIT 20 for brevity).
SELECT DISTINCT
       loc.value:"value":"string_value"::STRING                                           AS "page_location",
       CASE
            /* Product-detail page if last segment includes a plus sign */
            WHEN REGEXP_LIKE(loc.value:"value":"string_value"::STRING,
                             '/[^/]*\\+[^/]*$')                                           THEN 'PDP'
            /* Otherwise, product-listing page when it includes any category folder */
            WHEN loc.value:"value":"string_value"::STRING ILIKE ANY
                 ('%/Accessories/%','%/Apparel/%','%/Brands/%','%/Campus%Collection/%',
                  '%/Drinkware/%','%/Electronics/%','%/Google%Redesign/%','%/Lifestyle/%',
                  '%/Nest/%','%/New%2015%20Logo/%','%/Notebooks%Journals/%','%/Office/%',
                  '%/Shop%by%Brand/%','%/Small%Goods/%','%/Stationery/%','%/Wearables/%')
                                                                                         THEN 'PLP'
            ELSE 'OTHER'
       END                                                                               AS "page_type"
FROM "GA4"."GA4_OBFUSCATED_SAMPLE_ECOMMERCE"."EVENTS_20210102" AS t,
     LATERAL FLATTEN(input => t."EVENT_PARAMS")                    AS loc
WHERE t."USER_PSEUDO_ID" = '1402138.5184246691'
  AND loc.value:"key"::STRING = 'page_location'
LIMIT 20;
```
