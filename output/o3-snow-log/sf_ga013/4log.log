Query:
--Description: derive page_title + page_location per event and classify PDP / PLP  
SELECT DISTINCT
       MAX(CASE WHEN f.value:"key"::STRING = 'page_location' THEN f.value:"value":"string_value"::STRING END) AS page_location,
       MAX(CASE WHEN f.value:"key"::STRING = 'page_title'    THEN f.value:"value":"string_value"::STRING END) AS page_title,
       CASE
            WHEN REGEXP_LIKE(MAX(CASE WHEN f.value:"key"::STRING = 'page_location'
                                      THEN f.value:"value":"string_value"::STRING END), '\\+') THEN 'PDP'
            ELSE 'PLP'
       END AS "page_type"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
     LATERAL FLATTEN ( input => t."EVENT_PARAMS" ) f
WHERE t."USER_PSEUDO_ID" = '1402138.5184246691'
  AND t."EVENT_DATE"      = '20210102'
GROUP BY t."EVENT_TIMESTAMP"
LIMIT 20;
