```sql
--Description: pair every page URL with a quick PDP / PLP classification (regex on '+')  
SELECT loc."EVENT_TIMESTAMP",
       loc.page_location,
       CASE WHEN REGEXP_LIKE(loc.page_location, '\\+') THEN 'PDP' ELSE 'PLP' END AS "page_type"
FROM (
      SELECT t."EVENT_TIMESTAMP",
             f.value:"value":"string_value"::STRING AS page_location
      FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
           LATERAL FLATTEN ( input => t."EVENT_PARAMS" ) f
      WHERE t."USER_PSEUDO_ID" = '1402138.5184246691'
        AND t."EVENT_DATE"      = '20210102'
        AND f.value:"key"::STRING = 'page_location'
     ) loc
ORDER BY loc."EVENT_TIMESTAMP"
LIMIT 20;
```

```sql
--Description: derive page_title + page_location per event and classify PDP / PLP  
SELECT DISTINCT
       MAX(CASE WHEN f.value:"key"::STRING = 'page_location' THEN f.value:"value":"string_value"::STRING END) AS page_location,
       MAX(CASE WHEN f.value:"key"::STRING = 'page_title'    THEN f.value:"value":"string_value"::STRING END) AS page_title,
       CASE
            WHEN REGEXP_LIKE(MAX(CASE WHEN f.value:"key"::STRING = 'page_location'
                                      THEN f.value:"value":"string_value"::STRING END), '\\+') THEN 'PDP'
            ELSE 'PLP'
       END AS "page_type"
FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
     LATERAL FLATTEN ( input => t."EVENT_PARAMS" ) f
WHERE t."USER_PSEUDO_ID" = '1402138.5184246691'
  AND t."EVENT_DATE"      = '20210102'
GROUP BY t."EVENT_TIMESTAMP"
LIMIT 20;
```

```sql
--Description: count how many times the user hit PLPs vs PDPs on 02-Jan-2021  
SELECT CASE WHEN REGEXP_LIKE(page_location, '\\+') THEN 'PDP' ELSE 'PLP' END AS "page_type",
       COUNT(*) AS "visits"
FROM (
      SELECT f.value:"value":"string_value"::STRING AS page_location
      FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
           LATERAL FLATTEN ( input => t."EVENT_PARAMS" ) f
      WHERE t."USER_PSEUDO_ID" = '1402138.5184246691'
        AND t."EVENT_DATE"      = '20210102'
        AND f.value:"key"::STRING = 'page_location'
     ) sub
GROUP BY 1
LIMIT 20;
```

```sql
--Description: final de-duplicated list of pages (URL & title) visited by the user with PDP/PLP flag  
WITH per_event AS (
    SELECT t."EVENT_TIMESTAMP",
           MAX(CASE WHEN f.value:"key"::STRING = 'page_location'
                    THEN f.value:"value":"string_value"::STRING END) AS page_location,
           MAX(CASE WHEN f.value:"key"::STRING = 'page_title'
                    THEN f.value:"value":"string_value"::STRING END) AS page_title
    FROM GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
         LATERAL FLATTEN ( input => t."EVENT_PARAMS" ) f
    WHERE t."USER_PSEUDO_ID" = '1402138.5184246691'
      AND t."EVENT_DATE"      = '20210102'
    GROUP BY t."EVENT_TIMESTAMP"
)
SELECT DISTINCT
       page_location,
       page_title,
       CASE WHEN REGEXP_LIKE(page_location, '\\+') THEN 'PDP' ELSE 'PLP' END AS "page_type"
FROM per_event
ORDER BY page_location
LIMIT 20;
```
