```sql
--Description: 6)  Show page_title together with its corresponding page_location (one row per event).
SELECT  t."EVENT_TIMESTAMP",
        MAX(CASE WHEN f.value:"key"::STRING = 'page_title'
                 THEN f.value:"value":"string_value"::STRING END)       AS "page_title",
        MAX(CASE WHEN f.value:"key"::STRING = 'page_location'
                 THEN f.value:"value":"string_value"::STRING END)       AS "page_location"
FROM    GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
        LATERAL FLATTEN(input => t."EVENT_PARAMS") f
WHERE   t."EVENT_DATE" = '20210102'
  AND   t."USER_PSEUDO_ID" = '1402138.5184246691'
GROUP BY t."EVENT_TIMESTAMP"
ORDER BY t."EVENT_TIMESTAMP"
LIMIT   20;
```

```sql
--Description: 7)  List the distinct URLs (page_location) the user visited on 2-Jan-2021.
SELECT DISTINCT
       page_loc
FROM  (
        SELECT  MAX(CASE WHEN f.value:"key"::STRING = 'page_location'
                         THEN f.value:"value":"string_value"::STRING END) AS page_loc
        FROM    GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
                LATERAL FLATTEN(input => t."EVENT_PARAMS") f
        WHERE   t."EVENT_DATE" = '20210102'
          AND   t."USER_PSEUDO_ID" = '1402138.5184246691'
        GROUP BY t."EVENT_TIMESTAMP"
      )
WHERE  page_loc IS NOT NULL
LIMIT  20;
```

```sql
--Description: 8)  For every URL, break it into path segments to get a feel for the structure.
SELECT  page_loc,
        SPLIT_PART(page_loc, '/', 3)    AS "segment_4",
        SPLIT_PART(page_loc, '/', 4)    AS "segment_5"
FROM  (
        SELECT  MAX(CASE WHEN f.value:"key"::STRING = 'page_location'
                         THEN f.value:"value":"string_value"::STRING END) AS page_loc
        FROM    GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
                LATERAL FLATTEN(input => t."EVENT_PARAMS") f
        WHERE   t."EVENT_DATE" = '20210102'
          AND   t."USER_PSEUDO_ID" = '1402138.5184246691'
        GROUP BY t."EVENT_TIMESTAMP"
      )
WHERE  page_loc IS NOT NULL
LIMIT  20;
```

```sql
--Description: 9)  Classify every visited URL as PDP or PLP using simple “+”-based rule.
SELECT  page_loc,
        CASE
           WHEN REGEXP_COUNT(page_loc, '\\+') > 0 THEN 'PDP'
           ELSE 'PLP'
        END  AS "page_type"
FROM  (
        SELECT  MAX(CASE WHEN f.value:"key"::STRING = 'page_location'
                         THEN f.value:"value":"string_value"::STRING END) AS page_loc
        FROM    GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
                LATERAL FLATTEN(input => t."EVENT_PARAMS") f
        WHERE   t."EVENT_DATE" = '20210102'
          AND   t."USER_PSEUDO_ID" = '1402138.5184246691'
        GROUP BY t."EVENT_TIMESTAMP"
      )
WHERE  page_loc IS NOT NULL
LIMIT  20;
```

```sql
--Description: 10)  Final view – page_title, URL, and derived PDP / PLP label (20 events).
SELECT  MAX(CASE WHEN f.value:"key"::STRING = 'page_title'
                 THEN f.value:"value":"string_value"::STRING END)       AS "page_title",
        MAX(CASE WHEN f.value:"key"::STRING = 'page_location'
                 THEN f.value:"value":"string_value"::STRING END)       AS "page_location",
        CASE
           WHEN REGEXP_COUNT(MAX(CASE WHEN f.value:"key"::STRING = 'page_location'
                                      THEN f.value:"value":"string_value"::STRING END), '\\+') > 0
           THEN 'PDP'
           ELSE 'PLP'
        END                                                             AS "page_type"
FROM    GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
        LATERAL FLATTEN(input => t."EVENT_PARAMS") f
WHERE   t."EVENT_DATE" = '20210102'
  AND   t."USER_PSEUDO_ID" = '1402138.5184246691'
GROUP BY t."EVENT_TIMESTAMP"
ORDER BY t."EVENT_TIMESTAMP"
LIMIT   20;
```
