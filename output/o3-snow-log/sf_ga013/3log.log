SELECT
    CASE
        WHEN POSITION('+' IN SPLIT_PART(loc.value:"value":"string_value"::STRING,'/',-1)) > 0
             AND ( REGEXP_LIKE(SPLIT_PART(loc.value:"value":"string_value"::STRING,'/',4),
                 '(Accessories|Apparel|Brands|Campus\\s*Collection|Drinkware|Electronics|Google\\s*Redesign|Lifestyle|Nest|New\\s*2015\\s*Logo|Notebooks\\s*Journals|Office|Shop\\s*by\\s*Brand|Small\\s*Goods|Stationery|Wearables)','i')
                OR REGEXP_LIKE(SPLIT_PART(loc.value:"value":"string_value"::STRING,'/',5),
                 '(Accessories|Apparel|Brands|Campus\\s*Collection|Drinkware|Electronics|Google\\s*Redesign|Lifestyle|Nest|New\\s*2015\\s*Logo|Notebooks\\s*Journals|Office|Shop\\s*by\\s*Brand|Small\\s*Goods|Stationery|Wearables)','i') )
        THEN 'PDP'
        WHEN POSITION('+' IN SPLIT_PART(loc.value:"value":"string_value"::STRING,'/',4)) = 0
             AND POSITION('+' IN SPLIT_PART(loc.value:"value":"string_value"::STRING,'/',5)) = 0
             AND ( REGEXP_LIKE(SPLIT_PART(loc.value:"value":"string_value"::STRING,'/',4),
                 '(Accessories|Apparel|Brands|Campus\\s*Collection|Drinkware|Electronics|Google\\s*Redesign|Lifestyle|Nest|New\\s*2015\\s*Logo|Notebooks\\s*Journals|Office|Shop\\s*by\\s*Brand|Small\\s*Goods|Stationery|Wearables)','i')
                OR REGEXP_LIKE(SPLIT_PART(loc.value:"value":"string_value"::STRING,'/',5),
                 '(Accessories|Apparel|Brands|Campus\\s*Collection|Drinkware|Electronics|Google\\s*Redesign|Lifestyle|Nest|New\\s*2015\\s*Logo|Notebooks\\s*Journals|Office|Shop\\s*by\\s*Brand|Small\\s*Goods|Stationery|Wearables)','i') )
