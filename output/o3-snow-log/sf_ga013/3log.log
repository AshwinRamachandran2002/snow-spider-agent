--Description: 
-- One-shot query to answer: “Which pages (URL + title) did user 1402138.5184246691
-- view on 2021-01-02 and are they Product-Detail (PDP), Product-Listing (PLP) or OTHER?”  
-- -------------------------------------------------------------------------------
-- THINKING INSIDE QUERY
-- ❶  We inspect only table EVENTS_20210102 (already partitioned by date).
-- ❷  EVENT_PARAMS is an array; we FLATTEN once and aggregate with MAX() to pull
--     both ‘page_location’ (URL) and ‘page_title’ from each page_view hit.
-- ❸  From the URL we derive segment-4 and segment-5 (after the domain) because
--     business rules check those segments for category keywords.
-- ❹  CATEGORY_RE regex (case-insensitive flag 'i') lists all valid category names.
-- ❺  Classification logic  
--       • PDP  = last segment contains ‘+’  AND  (seg4 OR seg5) matches CATEGORY_RE  
--       • PLP  = seg4 & seg5 contain NO ‘+’  AND  (seg4 OR seg5) matches CATEGORY_RE  
--       • else OTHER
-- ❻  DISTINCT keeps each visited page once; LIMIT 20 just for sample output.
WITH hits AS (      -------------------------------- ❶ + ❷
    SELECT
        MAX(CASE WHEN ep.value:"key"::STRING = 'page_location'
                 THEN ep.value:"value":"string_value"::STRING END) AS url,
        MAX(CASE WHEN ep.value:"key"::STRING = 'page_title'
                 THEN ep.value:"value":"string_value"::STRING END) AS title
    FROM   GA4.GA4_OBFUSCATED_SAMPLE_ECOMMERCE."EVENTS_20210102" t,
           LATERAL FLATTEN(INPUT => t."EVENT_PARAMS") ep
    WHERE  t."USER_PSEUDO_ID" = '1402138.5184246691'
      AND  t."EVENT_NAME"     = 'page_view'
