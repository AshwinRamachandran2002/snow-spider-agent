LIMIT 20;
```

```sql
--Description: Snapshot of inventory positions for Manufacturing ASINs in the same 30-day window  
SELECT "DATE",
       "ASIN",
       "SELLABLE_ON_HAND_UNITS",
       "UNSELLABLE_ON_HAND_UNITS",
       "AGED_90PLUS_DAYS_SELLABLE_UNITS",
       "SELLABLE_ON_HAND_INVENTORY",
       "UNSELLABLE_ON_HAND_INVENTORY"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY"
WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND "DATE" BETWEEN '2022-01-07' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: Traffic (Glance Views) for Manufacturing ASINs in the 30-day window  
SELECT "DATE",
       "ASIN",
       "GLANCE_VIEWS"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"
WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND "DATE" BETWEEN '2022-01-07' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: Join Sales & Traffic to inspect daily conversion rate (ordered units / glance views)  
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       t."GLANCE_VIEWS",
       CASE WHEN t."GLANCE_VIEWS" > 0 THEN s."ORDERED_UNITS" / t."GLANCE_VIEWS" ELSE NULL END AS "CONVERSION_RATE"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"  s
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
  ON s."DATE" = t."DATE"
 AND s."ASIN" = t."ASIN"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" BETWEEN '2022-01-07' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: Payments – Distributor shipment receipts (net PPM proxy) inside the 30-day window  
SELECT "RECEIVE_DATE"  AS "DATE",
       "MANUFACTURER",
       "QUANTITY",
       "NET_RECEIPTS",
       "LIST_PRICE",
       "LIST_PRICE_CURRENCY"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS"
WHERE "RECEIVE_DATE" BETWEEN '2022-01-07' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: Payments – Customer shipment (sell-through proxy) inside the 30-day window  
SELECT "SHIP_DATE"  AS "DATE",
       "MANUFACTURER",
       "QUANTITY",
       "NET_SALES"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_CUSTOMER_SHIPMENT_DETAILS"
WHERE "SHIP_DATE" BETWEEN '2022-01-07' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: Combine Sales, Inventory, and Traffic to view units, revenue, on-hand units & glance views together  
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       s."ORDERED_REVENUE",
       i."SELLABLE_ON_HAND_UNITS",
       i."UNSELLABLE_ON_HAND_UNITS",
       t."GLANCE_VIEWS"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
       ON s."DATE" = i."DATE" AND s."ASIN" = i."ASIN"
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"   t
       ON s."DATE" = t."DATE" AND s."ASIN" = t."ASIN"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" BETWEEN '2022-01-07' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: Full joined view adding distributor receipts (net PPM) to sales / traffic / inventory in the 30-day window  
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       s."ORDERED_REVENUE",
       t."GLANCE_VIEWS",
       i."SELLABLE_ON_HAND_UNITS",
       i."SELLABLE_ON_HAND_INVENTORY",
       d."QUANTITY"           AS "NET_RECEIVED_UNITS",
       d."NET_RECEIPTS"       AS "NET_RECEIVED_VALUE"
FROM  AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES" s
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"   t
       ON s."DATE" = t."DATE" AND s."ASIN" = t."ASIN"
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
       ON s."DATE" = i."DATE" AND s."ASIN" = i."ASIN"
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS" d
       ON s."DATE" = d."RECEIVE_DATE"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" BETWEEN '2022-01-07' AND '2022-02-06'
LIMIT 20;
```
