```sql
--Description: 6) Aggregate ordered units, ordered revenue, shipped units, shipped revenue by DATE & ASIN
SELECT s."DATE",
       s."ASIN",
       SUM(s."ORDERED_UNITS")  AS "TOTAL_ORDERED_UNITS",
       SUM(s."ORDERED_REVENUE") AS "TOTAL_ORDERED_REVENUE",
       SUM(s."SHIPPED_UNITS")   AS "TOTAL_SHIPPED_UNITS",
       SUM(s."SHIPPED_REVENUE") AS "TOTAL_SHIPPED_REVENUE"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES" s
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" >= '2022-01-07'
  AND  s."DATE" <  '2022-02-07'
GROUP  BY s."DATE", s."ASIN"
ORDER  BY s."DATE", s."ASIN"
LIMIT  20;
```

```sql
--Description: 7) Aggregate inventory (on-hand units & inventory value) by DATE & ASIN for Manufacturing
SELECT i."DATE",
       i."ASIN",
       SUM(i."SELLABLE_ON_HAND_UNITS")            AS "TOTAL_SELLABLE_UNITS",
       SUM(i."UNSELLABLE_ON_HAND_UNITS")          AS "TOTAL_UNSELLABLE_UNITS",
       SUM(i."SELLABLE_ON_HAND_INVENTORY")        AS "TOTAL_SELLABLE_VALUE",
       SUM(i."UNSELLABLE_ON_HAND_INVENTORY")      AS "TOTAL_UNSELLABLE_VALUE"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
WHERE  i."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  i."DATE" >= '2022-01-07'
  AND  i."DATE" <  '2022-02-07'
GROUP  BY i."DATE", i."ASIN"
ORDER  BY i."DATE", i."ASIN"
LIMIT  20;
```

```sql
--Description: 8) Combine aggregated sales, traffic, and inventory to check core KPIs per DATE & ASIN
WITH sales AS (
    SELECT "DATE", "ASIN",
           SUM("ORDERED_UNITS")  AS ord_units,
           SUM("ORDERED_REVENUE") AS ord_rev,
           SUM("SHIPPED_UNITS")   AS shp_units,
           SUM("SHIPPED_REVENUE") AS shp_rev
    FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"
    WHERE  "DISTRIBUTOR_VIEW" = 'Manufacturing'
      AND  "DATE" >= '2022-01-07'
      AND  "DATE" <  '2022-02-07'
    GROUP  BY "DATE","ASIN"
), inv AS (
    SELECT "DATE","ASIN",
           SUM("SELLABLE_ON_HAND_UNITS")     AS sell_units,
           SUM("UNSELLABLE_ON_HAND_UNITS")   AS unsell_units
    FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY"
    WHERE  "DISTRIBUTOR_VIEW" = 'Manufacturing'
      AND  "DATE" >= '2022-01-07'
      AND  "DATE" <  '2022-02-07'
    GROUP  BY "DATE","ASIN"
), trf AS (
    SELECT "DATE","ASIN",
           SUM("GLANCE_VIEWS") AS gv
    FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"
    WHERE  "DISTRIBUTOR_VIEW" = 'Manufacturing'
      AND  "DATE" >= '2022-01-07'
      AND  "DATE" <  '2022-02-07'
    GROUP  BY "DATE","ASIN"
)
SELECT s."DATE",
       s."ASIN",
       s.ord_units,
       s.ord_rev,
       s.shp_units,
       s.shp_rev,
       trf.gv,
       inv.sell_units,
       inv.unsell_units
FROM   sales s
LEFT  JOIN trf ON s."DATE" = trf."DATE" AND s."ASIN" = trf."ASIN"
LEFT  JOIN inv ON s."DATE" = inv."DATE" AND s."ASIN" = inv."ASIN"
ORDER  BY s."DATE", s."ASIN"
LIMIT  20;
```

```sql
--Description: 9) Calculate daily conversion rate (ordered units / glance views) after joining sales & traffic
SELECT s."DATE",
       s."ASIN",
       SUM(s."ORDERED_UNITS") AS ordered_units,
       SUM(t."GLANCE_VIEWS")  AS glance_views,
       CASE WHEN SUM(t."GLANCE_VIEWS") > 0 
            THEN SUM(s."ORDERED_UNITS") / SUM(t."GLANCE_VIEWS") 
       END                    AS conversion_rate
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
      ON s."DATE" = t."DATE"
     AND s."ASIN" = t."ASIN"
     AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" >= '2022-01-07'
  AND  s."DATE" <  '2022-02-07'
GROUP  BY s."DATE", s."ASIN"
ORDER  BY s."DATE", s."ASIN"
LIMIT  20;
```

```sql
--Description: 10) Bring in receipts (net received units & value) to compare with sales on the same calendar day
SELECT s."DATE",
       SUM(s."ORDERED_UNITS")                 AS ordered_units,
       SUM(s."ORDERED_REVENUE")               AS ordered_revenue,
       SUM(p."QUANTITY")                      AS net_received_units,
       SUM(p."NET_RECEIPTS")                  AS net_received_value
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"          s
LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS" p
       ON CAST(s."DATE" AS DATE) = CAST(p."RECEIVE_DATE" AS DATE)
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" >= '2022-01-07'
  AND  s."DATE" <  '2022-02-07'
GROUP  BY s."DATE"
ORDER  BY s."DATE"
LIMIT  20;
```
