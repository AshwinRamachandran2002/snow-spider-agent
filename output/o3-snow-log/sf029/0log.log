--Description: 8) Combine aggregated sales, traffic, and inventory to check core KPIs per DATE & ASIN
WITH sales AS (
    SELECT "DATE", "ASIN",
           SUM("ORDERED_UNITS")  AS ord_units,
           SUM("ORDERED_REVENUE") AS ord_rev,
           SUM("SHIPPED_UNITS")   AS shp_units,
           SUM("SHIPPED_REVENUE") AS shp_rev
    FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"
    WHERE  "DISTRIBUTOR_VIEW" = 'Manufacturing'
      AND  "DATE" >= '2022-01-07'
      AND  "DATE" <  '2022-02-07'
    GROUP  BY "DATE","ASIN"
), inv AS (
    SELECT "DATE","ASIN",
           SUM("SELLABLE_ON_HAND_UNITS")     AS sell_units,
           SUM("UNSELLABLE_ON_HAND_UNITS")   AS unsell_units
    FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY"
    WHERE  "DISTRIBUTOR_VIEW" = 'Manufacturing'
      AND  "DATE" >= '2022-01-07'
      AND  "DATE" <  '2022-02-07'
    GROUP  BY "DATE","ASIN"
), trf AS (
    SELECT "DATE","ASIN",
           SUM("GLANCE_VIEWS") AS gv
    FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"
    WHERE  "DISTRIBUTOR_VIEW" = 'Manufacturing'
      AND  "DATE" >= '2022-01-07'
      AND  "DATE" <  '2022-02-07'
    GROUP  BY "DATE","ASIN"
)
SELECT s."DATE",
       s."ASIN",
       s.ord_units,
       s.ord_rev,
       s.shp_units,
       s.shp_rev,
       trf.gv,
       inv.sell_units,
       inv.unsell_units
FROM   sales s
LEFT  JOIN trf ON s."DATE" = trf."DATE" AND s."ASIN" = trf."ASIN"
LEFT  JOIN inv ON s."DATE" = inv."DATE" AND s."ASIN" = inv."ASIN"
ORDER  BY s."DATE", s."ASIN"
LIMIT  20;
Answer:
DATE,ASIN,ORD_UNITS,ORD_REV,SHP_UNITS,SHP_REV,GV,SELL_UNITS,UNSELL_UNITS
