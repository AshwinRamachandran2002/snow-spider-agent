```sql
--Description: 4) Examine traffic (glance views) and compare with last-year/prior-period values.
SELECT
       "DATE",
       "ASIN",
       "GLANCE_VIEWS",
       "GLANCE_VIEWS_LAST_YEAR",
       "GLANCE_VIEWS_PRIOR_PERIOD"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"
WHERE  "DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  "DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT  20;
```

```sql
--Description: 5) Join sales and traffic to calculate a basic conversion rate (ordered_units / glance_views).
SELECT
       s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       t."GLANCE_VIEWS",
       CASE WHEN t."GLANCE_VIEWS" > 0 
            THEN s."ORDERED_UNITS" / t."GLANCE_VIEWS" 
       END AS "CONVERSION_RATE"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
  ON   s."DATE" = t."DATE"
 AND   s."ASIN" = t."ASIN"
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  t."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT  20;
```

```sql
--Description: 6) Inspect net receipts (proxy for net PPM) from distributor shipments that arrived in the 30-day window.
SELECT
       "RECEIVE_DATE",
       "MANUFACTURER",
       "LIST_PRICE",
       "NET_RECEIPTS",
       "QUANTITY"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS"
WHERE  "RECEIVE_DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT  20;
```

```sql
--Description: 7) Combine sales, inventory, and traffic for Manufacturing ASINs on each day.
SELECT
       s."DATE",
       s."ASIN",
       s."PRODUCT_TITLE",
       s."ORDERED_UNITS",
       s."ORDERED_REVENUE",
       t."GLANCE_VIEWS",
       i."SELLABLE_ON_HAND_UNITS"  AS "ON_HAND_UNITS",
       i."SELLABLE_ON_HAND_INVENTORY" AS "ON_HAND_VALUE"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"     s
LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
       ON  s."DATE" = t."DATE" AND s."ASIN" = t."ASIN"
LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
       ON  s."DATE" = i."DATE" AND s."ASIN" = i."ASIN"
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT  20;
```

```sql
--Description: 8) Aggregate daily metrics into the 30-day window to prep for PPM & sell-through calculations.
SELECT
       s."ASIN",
       SUM(s."ORDERED_UNITS")                       AS "TOTAL_ORDERED_UNITS",
       SUM(s."ORDERED_REVENUE")                     AS "TOTAL_ORDERED_REVENUE",
       AVG( NULLIFZERO(s."ORDERED_REVENUE") / NULLIFZERO(s."ORDERED_UNITS") ) AS "AVG_SELLING_PRICE",
       SUM(t."GLANCE_VIEWS")                        AS "TOTAL_GLANCE_VIEWS",
       SUM(s."SHIPPED_UNITS")                       AS "TOTAL_SHIPPED_UNITS",
       SUM(s."SHIPPED_REVENUE")                     AS "TOTAL_SHIPPED_REVENUE"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
       ON  s."DATE" = t."DATE" AND s."ASIN" = t."ASIN"
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
GROUP BY s."ASIN"
LIMIT  20;
```

```sql
--Description: 9) Illustrative full-fledged join adding net receipts (as net PPM) for the report footprint.
SELECT
       s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       s."ORDERED_REVENUE",
       t."GLANCE_VIEWS",
       i."SELLABLE_ON_HAND_UNITS",
       i."SELLABLE_ON_HAND_INVENTORY",
       d."NET_RECEIPTS",
       d."QUANTITY"   AS "NET_RECEIPT_UNITS"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"  t
       ON s."DATE" = t."DATE" AND s."ASIN" = t."ASIN"
LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
       ON s."DATE" = i."DATE" AND s."ASIN" = i."ASIN"
LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS" d
       ON DATE_TRUNC('day', d."RECEIVE_DATE") = s."DATE"
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT  20;
```

```sql
--Description: 10) (Final prototype) Produce the daily Manufacturing sales report skeleton for the requested window.
SELECT
       s."DATE",
       s."ASIN",
       s."PRODUCT_TITLE",
       s."ORDERED_UNITS",
       s."ORDERED_REVENUE",
       CASE WHEN s."ORDERED_UNITS" > 0 THEN s."ORDERED_REVENUE" / s."ORDERED_UNITS" END AS "AVG_SELL_PRICE",
       t."GLANCE_VIEWS",
       CASE WHEN t."GLANCE_VIEWS" > 0 THEN s."ORDERED_UNITS" / t."GLANCE_VIEWS" END     AS "CONVERSION_RATE",
       s."SHIPPED_UNITS",
       s."SHIPPED_REVENUE",
       d."NET_RECEIPTS" / NULLIFZERO(d."QUANTITY")                                      AS "NET_PPM",
       i."SELLABLE_ON_HAND_UNITS" + i."UNSELLABLE_ON_HAND_UNITS"                        AS "TOTAL_ON_HAND_UNITS",
       i."SELLABLE_ON_HAND_INVENTORY" + i."UNSELLABLE_ON_HAND_INVENTORY"                AS "TOTAL_ON_HAND_VALUE"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"    s
LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"   t
       ON  s."DATE" = t."DATE" AND s."ASIN" = t."ASIN"
LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
       ON  s."DATE" = i."DATE" AND s."ASIN" = i."ASIN"
LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS" d
       ON  DATE_TRUNC('day', d."RECEIVE_DATE") = s."DATE"
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT  20;
```

