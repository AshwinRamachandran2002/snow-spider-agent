--Description: 7) Combine sales, inventory, and traffic for Manufacturing ASINs on each day.
SELECT
       s."DATE",
       s."ASIN",
       s."PRODUCT_TITLE",
       s."ORDERED_UNITS",
       s."ORDERED_REVENUE",
       t."GLANCE_VIEWS",
       i."SELLABLE_ON_HAND_UNITS"  AS "ON_HAND_UNITS",
