```sql
--Description: 3) Look at daily traffic (glance views) for those ASINs and dates.  
SELECT 
  t."DATE",
  t."ASIN",
  t."GLANCE_VIEWS",
  t."GLANCE_VIEWS_PRIOR_PERIOD",
  t."GLANCE_VIEWS_LAST_YEAR"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC" t
WHERE t."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND t."DATE" BETWEEN '2022-01-07' AND '2022-02-05'
  AND t."ASIN" IN (
        SELECT DISTINCT "ASIN"
        FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"
        WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
          AND "DATE" BETWEEN '2022-01-07' AND '2022-02-05'
      )
LIMIT 20;
```

```sql
--Description: 4) Join sales and traffic on DATE + ASIN to calculate a simple conversion rate
--   (ordered units ÷ glance views) for Manufacturing products.  
SELECT 
  s."DATE",
  s."ASIN",
  s."ORDERED_UNITS",
  t."GLANCE_VIEWS",
  CASE WHEN t."GLANCE_VIEWS" > 0 
       THEN s."ORDERED_UNITS" / t."GLANCE_VIEWS" 
       ELSE NULL END AS "CONVERSION_RATE"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"  s
JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC" t
  ON s."DATE" = t."DATE" 
 AND s."ASIN" = t."ASIN"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND t."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" BETWEEN '2022-01-07' AND '2022-02-05'
LIMIT 20;
```

```sql
--Description: 5) Incorporate inventory to view on-hand units & value alongside sales,
--   matching on DATE + ASIN + Distributor_View.  
SELECT 
  s."DATE",
  s."ASIN",
  s."ORDERED_UNITS",
  i."SELLABLE_ON_HAND_UNITS",
  i."UNSELLABLE_ON_HAND_UNITS",
  (i."SELLABLE_ON_HAND_INVENTORY" + i."UNSELLABLE_ON_HAND_INVENTORY") 
      AS "TOTAL_INVENTORY_VALUE"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"  s
JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_INVENTORY" i
  ON s."DATE" = i."DATE" 
 AND s."ASIN" = i."ASIN"
 AND s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" BETWEEN '2022-01-07' AND '2022-02-05'
LIMIT 20;
```

```sql
--Description: 6) Explore receipts from the Payments distributor-shipment table during
--   the same 30-day window (no ASIN, so just date-level view).  
SELECT 
  "RECEIVE_DATE" AS "DATE",
  "MANUFACTURER",
  SUM("QUANTITY")                AS "NET_RECEIPT_UNITS",
  SUM("NET_RECEIPTS")            AS "NET_RECEIPT_VALUE",
  SUM("LIST_PRICE")              AS "LIST_PRICE_TOTAL"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS"
WHERE "RECEIVE_DATE" BETWEEN '2022-01-07' AND '2022-02-05'
GROUP BY "RECEIVE_DATE", "MANUFACTURER"
LIMIT 20;
```

```sql
--Description: 7) Calculate vendor lead-time (days between order and ship) from the
--   Payments customer-shipment table for the period.  
SELECT 
  "ORDER_DATE",
  "SHIP_DATE",
  "MANUFACTURER",
  DATEDIFF('day', "ORDER_DATE", "SHIP_DATE") AS "VENDOR_LEAD_TIME_DAYS",
  "QUANTITY",
  "NET_SALES"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."PAYMENTS_CUSTOMER_SHIPMENT_DETAILS"
WHERE "ORDER_DATE" BETWEEN '2022-01-07' AND '2022-02-05'
LIMIT 20;
```

```sql
--Description: 8) Summarise average vendor lead time, receive fill rate (shipped ÷ ordered),
--   and sell-through (shipped ÷ on-hand) per day using sub-queries from earlier joins.  
WITH sales AS (
  SELECT "DATE", "ASIN", "ORDERED_UNITS", "SHIPPED_UNITS"
  FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"
  WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
    AND "DATE" BETWEEN '2022-01-07' AND '2022-02-05'
), inv AS (
  SELECT "DATE", "ASIN", "SELLABLE_ON_HAND_UNITS"
  FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_INVENTORY"
  WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
    AND "DATE" BETWEEN '2022-01-07' AND '2022-02-05'
)
SELECT 
  s."DATE",
  AVG( CASE WHEN s."ORDERED_UNITS" > 0 
            THEN s."SHIPPED_UNITS" / s."ORDERED_UNITS" 
       END ) AS "RECEIVE_FILL_RATE",
  AVG( CASE WHEN i."SELLABLE_ON_HAND_UNITS" > 0 
            THEN s."SHIPPED_UNITS" / i."SELLABLE_ON_HAND_UNITS" 
       END ) AS "SELL_THROUGH_RATE"
FROM sales s
LEFT JOIN inv i
  ON s."DATE" = i."DATE" AND s."ASIN" = i."ASIN"
GROUP BY s."DATE"
ORDER BY s."DATE" 
LIMIT 20;
```

```sql
--Description: 9) Pull net PPM-like metric by combining revenue and COGS, grouped daily.  
SELECT
  "DATE",
  "ASIN",
  SUM("SHIPPED_REVENUE") AS "REVENUE",
  SUM("SHIPPED_COGS")    AS "COGS",
  CASE WHEN SUM("SHIPPED_UNITS") > 0 
       THEN (SUM("SHIPPED_REVENUE") - SUM("SHIPPED_COGS")) / SUM("SHIPPED_UNITS")
       ELSE NULL END      AS "NET_PPM"
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"
WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND "DATE" BETWEEN '2022-01-07' AND '2022-02-05'
GROUP BY "DATE", "ASIN"
LIMIT 20;
```

```sql
--Description: 10) Full-scope daily product report (ordered units, ASP, glance views, conversion,
--   on-hand units/value, net receipts, net PPM, etc.) ready for export; limited to 20 rows here.  
WITH sales AS (
  SELECT "DATE", "ASIN", 
         SUM("ORDERED_UNITS")                AS "ORDERED_UNITS",
         SUM("ORDERED_REVENUE")              AS "ORDERED_REVENUE",
         SUM("SHIPPED_UNITS")                AS "SHIPPED_UNITS",
         SUM("SHIPPED_REVENUE")              AS "SHIPPED_REVENUE",
         SUM("SHIPPED_COGS")                 AS "SHIPPED_COGS"
  FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"
  WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
    AND "DATE" BETWEEN '2022-01-07' AND '2022-02-05'
  GROUP BY "DATE", "ASIN"
), traffic AS (
  SELECT "DATE", "ASIN", SUM("GLANCE_VIEWS") AS "GLANCE_VIEWS"
  FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC"
  WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
    AND "DATE" BETWEEN '2022-01-07' AND '2022-02-05'
  GROUP BY "DATE", "ASIN"
), inv AS (
  SELECT "DATE", "ASIN",
         SUM("SELLABLE_ON_HAND_UNITS")     AS "ON_HAND_UNITS",
         SUM("SELLABLE_ON_HAND_INVENTORY") AS "ON_HAND_VALUE"
  FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_INVENTORY"
  WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
    AND "DATE" BETWEEN '2022-01-07' AND '2022-02-05'
  GROUP BY "DATE", "ASIN"
)
SELECT 
  s."DATE",
  s."ASIN",
  s."ORDERED_UNITS",
  s."ORDERED_REVENUE",
  CASE WHEN s."ORDERED_UNITS" > 0 
       THEN s."ORDERED_REVENUE" / s."ORDERED_UNITS" 
       ELSE NULL END                       AS "AVG_SELLING_PRICE",
  t."GLANCE_VIEWS",
  CASE WHEN t."GLANCE_VIEWS" > 0 
       THEN s."ORDERED_UNITS" / t."GLANCE_VIEWS" 
       ELSE NULL END                       AS "CONVERSION_RATE",
  s."SHIPPED_UNITS",
  s."SHIPPED_REVENUE",
  CASE WHEN s."SHIPPED_UNITS" > 0 
       THEN (s."SHIPPED_REVENUE" - s."SHIPPED_COGS") / s."SHIPPED_UNITS"
       ELSE NULL END                       AS "NET_PPM",
  i."ON_HAND_UNITS",
  i."ON_HAND_VALUE"
FROM sales   s
LEFT JOIN traffic t ON s."DATE" = t."DATE" AND s."ASIN" = t."ASIN"
LEFT JOIN inv     i ON s."DATE" = i."DATE" AND s."ASIN" = i."ASIN"
ORDER BY s."DATE", s."ASIN"
LIMIT 20;
```
