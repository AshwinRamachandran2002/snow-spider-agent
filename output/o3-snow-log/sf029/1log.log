        SUM( COALESCE("SELLABLE_ON_HAND_INVENTORY",0) + COALESCE("UNSELLABLE_ON_HAND_INVENTORY",0) ) AS "ON_HAND_VALUE",
        AVG( CASE WHEN COALESCE("SELLABLE_ON_HAND_UNITS",0) = 0 THEN 1 ELSE 0 END )           AS "AVG_PROCURABLE_OOS"
