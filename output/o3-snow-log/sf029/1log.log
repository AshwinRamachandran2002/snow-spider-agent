    CASE WHEN S."ORDERED_UNITS" > 0
         THEN S."ORDERED_REVENUE" / S."ORDERED_UNITS"
    END                                            AS "AVG_SELLING_PRICE",

    T."GLANCE_VIEWS",
    CASE WHEN T."GLANCE_VIEWS" > 0
