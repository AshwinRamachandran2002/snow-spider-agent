    (S."ORDERED_UNITS" - S."SHIPPED_UNITS")       AS "UNFILLED_CUSTOMER_ORDERED_UNITS",

    /* Vendor / receive performance */
    CASE WHEN S."ORDERED_UNITS" > 0
         THEN S."SHIPPED_UNITS" / S."ORDERED_UNITS"
