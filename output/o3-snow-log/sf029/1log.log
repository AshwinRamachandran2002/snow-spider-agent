    S."SHIPPED_UNITS",
    S."SHIPPED_REVENUE",

    /* Net PPM (profit per unit) */
    CASE WHEN S."SHIPPED_UNITS" > 0
         THEN (S."SHIPPED_REVENUE" - S."SHIPPED_COGS") / S."SHIPPED_UNITS"
