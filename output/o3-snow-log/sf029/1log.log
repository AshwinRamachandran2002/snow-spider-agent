--Description: 8) Summarise average vendor lead time, receive fill rate (shipped ÷ ordered),
--   and sell-through (shipped ÷ on-hand) per day using sub-queries from earlier joins.  
WITH sales AS (
  SELECT "DATE", "ASIN", "ORDERED_UNITS", "SHIPPED_UNITS"
  FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"
  WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
    AND "DATE" BETWEEN '2022-01-07' AND '2022-02-05'
), inv AS (
  SELECT "DATE", "ASIN", "SELLABLE_ON_HAND_UNITS"
  FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_INVENTORY"
  WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'
    AND "DATE" BETWEEN '2022-01-07' AND '2022-02-05'
)
SELECT 
  s."DATE",
  AVG( CASE WHEN s."ORDERED_UNITS" > 0 
            THEN s."SHIPPED_UNITS" / s."ORDERED_UNITS" 
       END ) AS "RECEIVE_FILL_RATE",
  AVG( CASE WHEN i."SELLABLE_ON_HAND_UNITS" > 0 
            THEN s."SHIPPED_UNITS" / i."SELLABLE_ON_HAND_UNITS" 
       END ) AS "SELL_THROUGH_RATE"
FROM sales s
LEFT JOIN inv i
  ON s."DATE" = i."DATE" AND s."ASIN" = i."ASIN"
GROUP BY s."DATE"
ORDER BY s."DATE" 
LIMIT 20;
