FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."PAYMENTS_CUSTOMER_SHIPMENT_DETAILS"  
WHERE "SHIP_DATE" BETWEEN '2022-01-08' AND '2022-02-06'  
LIMIT 20;
```

```sql
--Description: 6) Join SALES & TRAFFIC to inspect daily conversion rate (shipped_units ÷ glance_views)  
SELECT s."DATE", s."ASIN",  
       s."ORDERED_UNITS", s."SHIPPED_UNITS",  
       t."GLANCE_VIEWS",  
       (s."SHIPPED_UNITS"/NULLIF(t."GLANCE_VIEWS",0)) AS "CONVERSION_RATE"  
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"  s  
JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC" t  
  ON   s."DATE" = t."DATE"  
 AND  s."ASIN" = t."ASIN"  
 AND  s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"  
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'  
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'  
LIMIT 20;
```

```sql
--Description: 7) Extend to include INVENTORY (on-hand units / value) for the same rows  
SELECT s."DATE", s."ASIN",  
       s."ORDERED_UNITS", s."ORDERED_REVENUE",  
       i."SELLABLE_ON_HAND_UNITS"  AS "ON_HAND_UNITS",  
       i."SELLABLE_ON_HAND_INVENTORY" AS "ON_HAND_VALUE"  
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"  s  
JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_INVENTORY" i  
  ON  s."DATE" = i."DATE"  
 AND s."ASIN" = i."ASIN"  
 AND s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"  
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'  
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'  
LIMIT 20;
```

```sql
--Description: 8) Bring Net-PPM (average net proceeds per unit) into the daily mix  
WITH ppm AS (  
  SELECT "RECEIVE_DATE"::DATE          AS "DATE",  
         'Manufacturing'              AS "DISTRIBUTOR_VIEW",   --align with other tables  
         NULL                         AS "ASIN",               --unknown at this grain  
         AVG("NET_RECEIPTS"/NULLIF("QUANTITY",0)) AS "AVG_NET_PPM"  
  FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS"  
  WHERE "RECEIVE_DATE" BETWEEN '2022-01-08' AND '2022-02-06'  
  GROUP BY 1,2)  
SELECT s."DATE", s."ASIN",  
       s."SHIPPED_UNITS", t."GLANCE_VIEWS",  
       p."AVG_NET_PPM"  
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"  s  
LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC" t  
       ON s."DATE" = t."DATE" AND s."ASIN" = t."ASIN" AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"  
LEFT JOIN ppm p  
       ON s."DATE"::DATE = p."DATE"  
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'  
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'  
LIMIT 20;
```

```sql
--Description: 9) Aggregate 30-day metrics per ASIN (sales, traffic, inventory, net-PPM)  
WITH base AS (  
  SELECT s."ASIN",  
         SUM(s."ORDERED_UNITS")    AS "TOT_ORDERED_UNITS",  
         SUM(s."ORDERED_REVENUE")  AS "TOT_ORDERED_REV",  
         AVG(s."ORDERED_REVENUE"/NULLIF(s."ORDERED_UNITS",0)) AS "AVG_SELL_PRICE",  
         SUM(s."SHIPPED_UNITS")    AS "TOT_SHIPPED_UNITS",  
         SUM(s."SHIPPED_REVENUE")  AS "TOT_SHIPPED_REV",  
         SUM(t."GLANCE_VIEWS")     AS "TOT_GLANCE_VIEWS",  
         SUM(i."SELLABLE_ON_HAND_UNITS") AS "AVG_ON_HAND_UNITS",  
         SUM(i."SELLABLE_ON_HAND_INVENTORY") AS "AVG_ON_HAND_VALUE"  
  FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"  s  
  LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC"  t  
         ON s."DATE" = t."DATE" AND s."ASIN" = t."ASIN"  
  LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_INVENTORY" i  
         ON s."DATE" = i."DATE" AND s."ASIN" = i."ASIN"  
  WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'  
    AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'  
  GROUP BY s."ASIN")  
SELECT *, (TOT_SHIPPED_UNITS/NULLIF(TOT_GLANCE_VIEWS,0)) AS "AVG_CONV_RATE"  
FROM base  
LIMIT 20;
```

```sql
--Description: 10) Daily detailed report combining ALL requested KPI-fields (sample of 20 rows)  
WITH inv AS (  
  SELECT "DATE", "ASIN", "DISTRIBUTOR_VIEW",  
         ("SELLABLE_ON_HAND_UNITS" + "UNSELLABLE_ON_HAND_UNITS")   AS "ON_HAND_UNITS",  
         ("SELLABLE_ON_HAND_INVENTORY" + "UNSELLABLE_ON_HAND_INVENTORY") AS "ON_HAND_VALUE"  
  FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_INVENTORY"  
  WHERE "DISTRIBUTOR_VIEW" = 'Manufacturing'),  
ppm AS (  
  SELECT "RECEIVE_DATE"::DATE AS "DATE",  
         AVG("NET_RECEIPTS"/NULLIF("QUANTITY",0)) AS "AVG_NET_PPM"  
  FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS"  
  WHERE "RECEIVE_DATE" BETWEEN '2022-01-08' AND '2022-02-06'  
  GROUP BY 1)  
SELECT s."DATE", s."ASIN",  
       s."ORDERED_UNITS", s."ORDERED_REVENUE",  
       (s."ORDERED_REVENUE"/NULLIF(s."ORDERED_UNITS",0)) AS "AVG_SELL_PRICE",  
       t."GLANCE_VIEWS",  
       (s."SHIPPED_UNITS"/NULLIF(t."GLANCE_VIEWS",0))     AS "CONVERSION_RATE",  
       s."SHIPPED_UNITS", s."SHIPPED_REVENUE",  
       p."AVG_NET_PPM",  
       inv."ON_HAND_UNITS", inv."ON_HAND_VALUE"  
FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"   s  
LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC"  t  
       ON s."DATE" = t."DATE" AND s."ASIN" = t."ASIN"  
LEFT JOIN inv  
       ON s."DATE" = inv."DATE" AND s."ASIN" = inv."ASIN"  
LEFT JOIN ppm p  
       ON s."DATE"::DATE = p."DATE"  
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'  
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'  
LIMIT 20;
```
