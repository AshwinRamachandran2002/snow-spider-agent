Query:
--Description: 9) Aggregate 30-day metrics per ASIN (sales, traffic, inventory, net-PPM)  
WITH base AS (  
  SELECT s."ASIN",  
         SUM(s."ORDERED_UNITS")    AS "TOT_ORDERED_UNITS",  
         SUM(s."ORDERED_REVENUE")  AS "TOT_ORDERED_REV",  
         AVG(s."ORDERED_REVENUE"/NULLIF(s."ORDERED_UNITS",0)) AS "AVG_SELL_PRICE",  
         SUM(s."SHIPPED_UNITS")    AS "TOT_SHIPPED_UNITS",  
         SUM(s."SHIPPED_REVENUE")  AS "TOT_SHIPPED_REV",  
         SUM(t."GLANCE_VIEWS")     AS "TOT_GLANCE_VIEWS",  
         SUM(i."SELLABLE_ON_HAND_UNITS") AS "AVG_ON_HAND_UNITS",  
         SUM(i."SELLABLE_ON_HAND_INVENTORY") AS "AVG_ON_HAND_VALUE"  
  FROM "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"  s  
  LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_TRAFFIC"  t  
         ON s."DATE" = t."DATE" AND s."ASIN" = t."ASIN"  
  LEFT JOIN "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_INVENTORY" i  
         ON s."DATE" = i."DATE" AND s."ASIN" = i."ASIN"  
  WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'  
    AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'  
  GROUP BY s."ASIN")  
SELECT *, (TOT_SHIPPED_UNITS/NULLIF(TOT_GLANCE_VIEWS,0)) AS "AVG_CONV_RATE"  
FROM base  
LIMIT 20;
