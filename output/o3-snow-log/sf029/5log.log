```sql
--Description: 5) Simple join of sales & traffic to view ordered units, revenue, glance views, and derive conversion rate
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       s."ORDERED_REVENUE",
       t."GLANCE_VIEWS",
       CASE WHEN t."GLANCE_VIEWS" = 0 THEN NULL
            ELSE ROUND(s."ORDERED_UNITS"::FLOAT / t."GLANCE_VIEWS", 4)
       END AS "CONVERSION_RATE"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
  ON   s."DATE" = t."DATE"
 AND   s."ASIN" = t."ASIN"
 AND   s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: 6) Join sales with inventory to look at same-day on-hand units & value together with shipped units/revenue
SELECT s."DATE",
       s."ASIN",
       s."SHIPPED_UNITS",
       s."SHIPPED_REVENUE",
       i."SELLABLE_ON_HAND_UNITS" + i."UNSELLABLE_ON_HAND_UNITS"      AS "TOTAL_ON_HAND_UNITS",
       i."SELLABLE_ON_HAND_INVENTORY" + i."UNSELLABLE_ON_HAND_INVENTORY" AS "TOTAL_ON_HAND_VALUE"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"      s
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY"  i
  ON   s."DATE" = i."DATE"
 AND   s."ASIN" = i."ASIN"
 AND   s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: 7) Explore distributor-side receipts (net receipts & quantities) during the 30-day horizon
SELECT "RECEIVE_DATE"  AS "DATE",
       "MANUFACTURER",
       "QUANTITY",
       "NET_RECEIPTS",
       "LIST_PRICE_CURRENCY"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS"
WHERE  "RECEIVE_DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: 8) Examine customer shipment details (orders shipped to customers) during the same window
SELECT "ORDER_DATE" AS "DATE",
       "MANUFACTURER",
       "QUANTITY",
       "NET_SALES",
       "SHIP_DATE"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_CUSTOMER_SHIPMENT_DETAILS"
WHERE  "ORDER_DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: 9) Calculate a quick net PPM proxy: (Shipped Revenue ‑ Shipped COGS) / Shipped Units
SELECT "DATE",
       "ASIN",
       "SHIPPED_UNITS",
       "SHIPPED_REVENUE",
       "SHIPPED_COGS",
       CASE WHEN "SHIPPED_UNITS" = 0 THEN NULL
            ELSE ROUND( ("SHIPPED_REVENUE" - "SHIPPED_COGS") / "SHIPPED_UNITS", 2)
       END AS "NET_PPM"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"
WHERE  "DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  "DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: 10) Comprehensive multi-table join (sales + traffic + inventory + payments) to preview the final daily grain report structure
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       s."ORDERED_REVENUE",
       ROUND( NULLIF(s."ORDERED_REVENUE",0)::FLOAT / NULLIF(s."ORDERED_UNITS",0), 2)       AS "AVG_SELLING_PRICE",
       t."GLANCE_VIEWS",
       CASE WHEN t."GLANCE_VIEWS" = 0 THEN NULL
            ELSE ROUND(s."ORDERED_UNITS"::FLOAT / t."GLANCE_VIEWS", 4)
       END                                                                                AS "CONVERSION_RATE",
       s."SHIPPED_UNITS",
       s."SHIPPED_REVENUE",
       ROUND( NULLIF(s."SHIPPED_REVENUE" - s."SHIPPED_COGS",0)::FLOAT /
              NULLIF(s."SHIPPED_UNITS",0), 2)                                            AS "NET_PPM",
       i."SELLABLE_ON_HAND_UNITS" + i."UNSELLABLE_ON_HAND_UNITS"                         AS "TOTAL_ON_HAND_UNITS",
       i."SELLABLE_ON_HAND_INVENTORY" + i."UNSELLABLE_ON_HAND_INVENTORY"                 AS "TOTAL_ON_HAND_VALUE",
       d."QUANTITY"                                                                      AS "NET_RECEIVED_UNITS",
       d."NET_RECEIPTS"                                                                  AS "NET_RECEIVED_VALUE"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"          s
LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"    t
       ON s."DATE" = t."DATE"
      AND s."ASIN" = t."ASIN"
      AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY"  i
       ON s."DATE" = i."DATE"
      AND s."ASIN" = i."ASIN"
      AND s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS" d
       ON s."DATE" = d."RECEIVE_DATE"
      AND s."ASIN"       = d."MANUFACTURER"    -- (example join key – adjust once true keys are confirmed)
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```
