--Description: 9) Calculate a quick net PPM proxy: (Shipped Revenue ‑ Shipped COGS) / Shipped Units
SELECT "DATE",
       "ASIN",
       "SHIPPED_UNITS",
       "SHIPPED_REVENUE",
       "SHIPPED_COGS",
       CASE WHEN "SHIPPED_UNITS" = 0 THEN NULL
            ELSE ROUND( ("SHIPPED_REVENUE" - "SHIPPED_COGS") / "SHIPPED_UNITS", 2)
       END AS "NET_PPM"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"
WHERE  "DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  "DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
