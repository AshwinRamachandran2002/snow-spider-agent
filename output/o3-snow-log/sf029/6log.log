```

```sql
--Description: Join SALES and TRAFFIC on DATE, ASIN & DISTRIBUTOR_VIEW to view ordered units vs. glance views
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       s."ORDERED_REVENUE",
       t."GLANCE_VIEWS",
       t."GLANCE_VIEWS_PRIOR_PERIOD"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"  s
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
  ON   s."DATE" = t."DATE"
  AND  s."ASIN" = t."ASIN"
  AND  s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: Extend the previous join by adding INVENTORY information
SELECT st."DATE",
       st."ASIN",
       st."ORDERED_UNITS",
       st."GLANCE_VIEWS",
       i."SELLABLE_ON_HAND_UNITS",
       i."UNSELLABLE_ON_HAND_UNITS",
       i."SELLABLE_ON_HAND_INVENTORY"
FROM (
        SELECT s."DATE",
               s."ASIN",
               s."ORDERED_UNITS",
               t."GLANCE_VIEWS"
        FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"  s
        JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
          ON   s."DATE" = t."DATE"
          AND  s."ASIN" = t."ASIN"
          AND  s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
        WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
          AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
     ) st
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
  ON  st."DATE" = i."DATE"
  AND st."ASIN" = i."ASIN"
WHERE i."DISTRIBUTOR_VIEW" = 'Manufacturing'
LIMIT 20;
```

```sql
--Description: Aggregate shipments to derive net received units & value by date
SELECT "RECEIVE_DATE"        AS "DATE",
       SUM("QUANTITY")       AS "NET_RECEIVED_UNITS",
       SUM("NET_RECEIPTS")   AS "NET_RECEIVED_VALUE"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS"
WHERE "RECEIVE_DATE" BETWEEN '2022-01-08' AND '2022-02-06'
GROUP BY "RECEIVE_DATE"
ORDER BY "RECEIVE_DATE"
LIMIT 20;
```

```sql
--Description: Combine SALES, TRAFFIC and aggregated SHIPMENTS to evaluate sell-through vs. receipts
WITH sales_traffic AS (
    SELECT s."DATE",
           s."ASIN",
           SUM(s."SHIPPED_UNITS")  AS "DAILY_SHIPPED_UNITS",
           SUM(s."ORDERED_UNITS")  AS "DAILY_ORDERED_UNITS",
           SUM(s."SHIPPED_REVENUE") AS "DAILY_SHIPPED_REVENUE",
           t."GLANCE_VIEWS"
    FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"  s
    JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
      ON   s."DATE" = t."DATE"
      AND  s."ASIN" = t."ASIN"
      AND  s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
    WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
      AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
    GROUP BY s."DATE", s."ASIN", t."GLANCE_VIEWS"
)
SELECT st."DATE",
       st."ASIN",
       st."DAILY_SHIPPED_UNITS",
       st."DAILY_ORDERED_UNITS",
       st."DAILY_SHIPPED_REVENUE",
       st."GLANCE_VIEWS",
       shp."NET_RECEIVED_UNITS",
       shp."NET_RECEIVED_VALUE"
FROM sales_traffic st
LEFT JOIN (
        SELECT "RECEIVE_DATE" AS "DATE",
               SUM("QUANTITY")     AS "NET_RECEIVED_UNITS",
               SUM("NET_RECEIPTS") AS "NET_RECEIVED_VALUE"
        FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS"
        WHERE "RECEIVE_DATE" BETWEEN '2022-01-08' AND '2022-02-06'
        GROUP BY "RECEIVE_DATE"
) shp
  ON st."DATE" = shp."DATE"
LIMIT 20;
```

```sql
--Description: Final prototype – comprehensive daily report joined across SALES, TRAFFIC, INVENTORY, & SHIPMENTS for Manufacturing (30-day window)
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS"                                 AS "TOTAL_ORDERED_UNITS",
       s."ORDERED_REVENUE"                               AS "TOTAL_ORDERED_REVENUE",
       CASE WHEN s."ORDERED_UNITS" = 0 THEN NULL
            ELSE s."ORDERED_REVENUE" / s."ORDERED_UNITS" END AS "AVG_SELLING_PRICE",
       t."GLANCE_VIEWS",
       CASE WHEN t."GLANCE_VIEWS" = 0 THEN NULL
            ELSE s."ORDERED_UNITS" / t."GLANCE_VIEWS"   END AS "CONVERSION_RATE",
       s."SHIPPED_UNITS",
       s."SHIPPED_REVENUE",
       i."SELLABLE_ON_HAND_UNITS" + i."UNSELLABLE_ON_HAND_UNITS" AS "TOTAL_ON_HAND_UNITS",
       i."SELLABLE_ON_HAND_INVENTORY" + i."UNSELLABLE_ON_HAND_INVENTORY" AS "TOTAL_ON_HAND_VALUE",
       shp."NET_RECEIVED_UNITS",
       shp."NET_RECEIVED_VALUE"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"    s
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"  t
     ON s."DATE" = t."DATE"
    AND s."ASIN" = t."ASIN"
    AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
     ON s."DATE" = i."DATE"
    AND s."ASIN" = i."ASIN"
    AND s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
LEFT JOIN (
     SELECT "RECEIVE_DATE"      AS "DATE",
            SUM("QUANTITY")     AS "NET_RECEIVED_UNITS",
            SUM("NET_RECEIPTS") AS "NET_RECEIVED_VALUE"
     FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS"
     WHERE "RECEIVE_DATE" BETWEEN '2022-01-08' AND '2022-02-06'
     GROUP BY "RECEIVE_DATE"
) shp
  ON s."DATE" = shp."DATE"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```
