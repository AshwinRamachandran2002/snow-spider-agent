--Description: Final prototype – comprehensive daily report joined across SALES, TRAFFIC, INVENTORY, & SHIPMENTS for Manufacturing (30-day window)
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS"                                 AS "TOTAL_ORDERED_UNITS",
       s."ORDERED_REVENUE"                               AS "TOTAL_ORDERED_REVENUE",
       CASE WHEN s."ORDERED_UNITS" = 0 THEN NULL
            ELSE s."ORDERED_REVENUE" / s."ORDERED_UNITS" END AS "AVG_SELLING_PRICE",
       t."GLANCE_VIEWS",
       CASE WHEN t."GLANCE_VIEWS" = 0 THEN NULL
            ELSE s."ORDERED_UNITS" / t."GLANCE_VIEWS"   END AS "CONVERSION_RATE",
       s."SHIPPED_UNITS",
       s."SHIPPED_REVENUE",
       i."SELLABLE_ON_HAND_UNITS" + i."UNSELLABLE_ON_HAND_UNITS" AS "TOTAL_ON_HAND_UNITS",
       i."SELLABLE_ON_HAND_INVENTORY" + i."UNSELLABLE_ON_HAND_INVENTORY" AS "TOTAL_ON_HAND_VALUE",
       shp."NET_RECEIVED_UNITS",
       shp."NET_RECEIVED_VALUE"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"    s
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"  t
     ON s."DATE" = t."DATE"
    AND s."ASIN" = t."ASIN"
    AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
     ON s."DATE" = i."DATE"
    AND s."ASIN" = i."ASIN"
    AND s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
LEFT JOIN (
     SELECT "RECEIVE_DATE"      AS "DATE",
            SUM("QUANTITY")     AS "NET_RECEIVED_UNITS",
            SUM("NET_RECEIPTS") AS "NET_RECEIVED_VALUE"
     FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS"
     WHERE "RECEIVE_DATE" BETWEEN '2022-01-08' AND '2022-02-06'
     GROUP BY "RECEIVE_DATE"
) shp
  ON s."DATE" = shp."DATE"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
