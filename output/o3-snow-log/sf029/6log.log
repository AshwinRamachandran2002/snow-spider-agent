Query:
--Description: Combine SALES, TRAFFIC and aggregated SHIPMENTS to evaluate sell-through vs. receipts
WITH sales_traffic AS (
    SELECT s."DATE",
           s."ASIN",
           SUM(s."SHIPPED_UNITS")  AS "DAILY_SHIPPED_UNITS",
           SUM(s."ORDERED_UNITS")  AS "DAILY_ORDERED_UNITS",
           SUM(s."SHIPPED_REVENUE") AS "DAILY_SHIPPED_REVENUE",
           t."GLANCE_VIEWS"
    FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"  s
    JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
      ON   s."DATE" = t."DATE"
      AND  s."ASIN" = t."ASIN"
      AND  s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
    WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
      AND s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
    GROUP BY s."DATE", s."ASIN", t."GLANCE_VIEWS"
)
SELECT st."DATE",
       st."ASIN",
       st."DAILY_SHIPPED_UNITS",
       st."DAILY_ORDERED_UNITS",
       st."DAILY_SHIPPED_REVENUE",
       st."GLANCE_VIEWS",
       shp."NET_RECEIVED_UNITS",
       shp."NET_RECEIVED_VALUE"
FROM sales_traffic st
LEFT JOIN (
        SELECT "RECEIVE_DATE" AS "DATE",
               SUM("QUANTITY")     AS "NET_RECEIVED_UNITS",
               SUM("NET_RECEIPTS") AS "NET_RECEIVED_VALUE"
        FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."PAYMENTS_DISTRIBUTOR_SHIPMENT_DETAILS"
        WHERE "RECEIVE_DATE" BETWEEN '2022-01-08' AND '2022-02-06'
        GROUP BY "RECEIVE_DATE"
) shp
  ON st."DATE" = shp."DATE"
LIMIT 20;
Answer:
DATE,ASIN,DAILY_SHIPPED_UNITS,DAILY_ORDERED_UNITS,DAILY_SHIPPED_REVENUE,GLANCE_VIEWS,NET_RECEIVED_UNITS,NET_RECEIVED_VALUE
