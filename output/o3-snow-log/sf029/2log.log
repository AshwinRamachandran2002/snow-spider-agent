```sql
--Description: 7) Join sales & traffic on DATE + ASIN for ‘Manufacturing’ to fetch ordered units, revenue, and glance views together.  
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       s."ORDERED_REVENUE",
       t."GLANCE_VIEWS"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"  s
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
  ON s."ASIN" = t."ASIN"
 AND s."DATE" = t."DATE"
 AND t."DISTRIBUTOR_VIEW" = 'Manufacturing'
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" BETWEEN '2022-01-07' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: 8) Combine sales, traffic, and inventory to view units, revenue, views, and on-hand stock in one row per ASIN-day.  
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       s."ORDERED_REVENUE",
       t."GLANCE_VIEWS",
       i."SELLABLE_ON_HAND_UNITS"   AS "ON_HAND_UNITS",
       i."SELLABLE_ON_HAND_INVENTORY" AS "ON_HAND_VALUE"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"      s
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"    t
  ON s."ASIN" = t."ASIN"
 AND s."DATE" = t."DATE"
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY"  i
  ON s."ASIN" = i."ASIN"
 AND s."DATE" = i."DATE"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND t."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND i."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" BETWEEN '2022-01-07' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: 9) Aggregate the above join to compute daily conversion rate (Ordered Units ÷ Glance Views) for each ASIN.  
SELECT jt."DATE",
       jt."ASIN",
       SUM(jt."ORDERED_UNITS")          AS "TOTAL_ORDERED_UNITS",
       SUM(jt."GLANCE_VIEWS")           AS "TOTAL_GLANCE_VIEWS",
       CASE WHEN SUM(jt."GLANCE_VIEWS") > 0
            THEN SUM(jt."ORDERED_UNITS") / SUM(jt."GLANCE_VIEWS")
       END                              AS "CONVERSION_RATE"
FROM (
      SELECT s."DATE",
             s."ASIN",
             s."ORDERED_UNITS",
             t."GLANCE_VIEWS"
      FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"  s
      JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
        ON s."ASIN" = t."ASIN"
       AND s."DATE" = t."DATE"
      WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
        AND t."DISTRIBUTOR_VIEW" = 'Manufacturing'
        AND s."DATE" BETWEEN '2022-01-07' AND '2022-02-06'
     ) jt
GROUP BY jt."DATE", jt."ASIN"
LIMIT 20;
```

```sql
--Description: 10) Produce a concise end-to-end view for the 30-day period (Feb-06-2022 inclusive) summarising key requested KPIs by ASIN.  
SELECT s."ASIN",
       SUM(s."ORDERED_UNITS")                         AS "TOT_ORDERED_UNITS",
       SUM(s."ORDERED_REVENUE")                       AS "TOT_ORDERED_REVENUE",
       CASE WHEN SUM(s."ORDERED_UNITS") > 0
            THEN SUM(s."ORDERED_REVENUE") / SUM(s."ORDERED_UNITS")
       END                                            AS "AVG_SELLING_PRICE",
       SUM(t."GLANCE_VIEWS")                          AS "TOT_GLANCE_VIEWS",
       CASE WHEN SUM(t."GLANCE_VIEWS") > 0
            THEN SUM(s."ORDERED_UNITS") / SUM(t."GLANCE_VIEWS")
       END                                            AS "AVG_CONVERSION_RATE",
       SUM(s."SHIPPED_UNITS")                         AS "TOT_SHIPPED_UNITS",
       SUM(s."SHIPPED_REVENUE")                       AS "TOT_SHIPPED_REVENUE",
       AVG(i."SELLABLE_ON_HAND_UNITS")                AS "AVG_ON_HAND_UNITS",
       AVG(i."SELLABLE_ON_HAND_INVENTORY")            AS "AVG_ON_HAND_VALUE"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"      s
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
       ON s."ASIN" = t."ASIN"
      AND s."DATE" = t."DATE"
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
       ON s."ASIN" = i."ASIN"
      AND s."DATE" = i."DATE"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" BETWEEN '2022-01-07' AND '2022-02-06'
GROUP BY s."ASIN"
LIMIT 20;
```
