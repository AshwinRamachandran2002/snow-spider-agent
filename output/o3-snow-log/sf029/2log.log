--Description: 10) Produce a concise end-to-end view for the 30-day period (Feb-06-2022 inclusive) summarising key requested KPIs by ASIN.  
SELECT s."ASIN",
       SUM(s."ORDERED_UNITS")                         AS "TOT_ORDERED_UNITS",
       SUM(s."ORDERED_REVENUE")                       AS "TOT_ORDERED_REVENUE",
       CASE WHEN SUM(s."ORDERED_UNITS") > 0
            THEN SUM(s."ORDERED_REVENUE") / SUM(s."ORDERED_UNITS")
       END                                            AS "AVG_SELLING_PRICE",
       SUM(t."GLANCE_VIEWS")                          AS "TOT_GLANCE_VIEWS",
       CASE WHEN SUM(t."GLANCE_VIEWS") > 0
            THEN SUM(s."ORDERED_UNITS") / SUM(t."GLANCE_VIEWS")
       END                                            AS "AVG_CONVERSION_RATE",
       SUM(s."SHIPPED_UNITS")                         AS "TOT_SHIPPED_UNITS",
       SUM(s."SHIPPED_REVENUE")                       AS "TOT_SHIPPED_REVENUE",
       AVG(i."SELLABLE_ON_HAND_UNITS")                AS "AVG_ON_HAND_UNITS",
       AVG(i."SELLABLE_ON_HAND_INVENTORY")            AS "AVG_ON_HAND_VALUE"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"      s
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
       ON s."ASIN" = t."ASIN"
      AND s."DATE" = t."DATE"
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
       ON s."ASIN" = i."ASIN"
      AND s."DATE" = i."DATE"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."DATE" BETWEEN '2022-01-07' AND '2022-02-06'
GROUP BY s."ASIN"
LIMIT 20;
