/*   Build a frequency-weighted aggregate GloVe vector for every article
     without relying on VECTOR-native functions, by flattening every 300-dim
     vector into (index , value) pairs, weighting, summing per coordinate
     and finally computing cosine similarities to the reference article.      */

WITH tokens AS (            -- 1. tokenize “body”, drop punctuation & stop-words
    SELECT
        n."id",
        LOWER(t.value)::string        AS word
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL SPLIT_TO_TABLE(                 -- split on blanks
             REGEXP_REPLACE(n."body", '[^A-Za-z]+', ' '),
             ' '
         ) t
    WHERE t.value IS NOT NULL
      AND LENGTH(t.value) > 2
      AND LOWER(t.value) NOT IN (      -- static stop-word list
           'the','and','for','from','that','with','this','have','has','had','were',
           'was','are','but','not','can','such','into','its','their','they','been',
           'his','her','she','him','our','out','all','any','may','who','one','two',
           'use','between','which','while','when','where','how','what','why','your',
           'you','than','then','them','these','those','there','here','after','before',
           'also','will','could','shall','would','about','among','because','other',
           'more','over','very','much','many','some','each','most','must','like',
           'is','in','on','at','by','to','of','as','it','an','be','or','if','we',
           'do','does','did','so','no','yes'
      )
),

word_info AS (              -- 2. keep only tokens that have both vector & frequency
    SELECT
        tok."id",
        gv."vector"                          AS vec,          -- VARIANT (300-length)
        wf."frequency"
    FROM tokens tok
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS      gv
         ON gv."word" = tok.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES   wf
         ON wf."word" = tok.word
),

weighted_elements AS (      -- 3. flatten every vector & apply  frequency weight
    SELECT
        wi."id",
        f.index::INT                     AS idx,             -- 0 … 299
        (f.value::FLOAT)
        / POWER(wi."frequency", 0.4)     AS val              -- weighted coordinate
    FROM word_info wi,
         LATERAL FLATTEN(input => wi.vec) f
),

agg_vec AS (                -- 4. sum coordinates → aggregate vector per article
    SELECT
        "id",
        idx,
        SUM(val)         AS coord_val
    FROM weighted_elements
    GROUP BY "id", idx
),

norms AS (                  -- 5. vector norm per article
    SELECT
        "id",
        SQRT(SUM(coord_val * coord_val)) AS norm
    FROM agg_vec
    GROUP BY "id"
),

-- 6. store the target article’s vector & its norm
target_vec AS (
    SELECT idx, coord_val
    FROM agg_vec
    WHERE "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),
target_norm AS (
    SELECT norm AS tnorm
    FROM norms
    WHERE "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),

-- 7. dot product of every article with the target
dot_products AS (
    SELECT
        a."id",
        SUM(a.coord_val * tv.coord_val) AS dot
    FROM agg_vec            a
    JOIN target_vec         tv
      ON a.idx = tv.idx
    GROUP BY a."id"
),

similarities AS (           -- 8. cosine similarity
    SELECT
        d."id",
        d.dot / ( n.norm * (SELECT tnorm FROM target_norm) ) AS sim
    FROM dot_products d
    JOIN norms       n  ON n."id" = d."id"
    WHERE d."id" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
      AND n.norm > 0
),

top10 AS (                  -- 9. pick top-10 most similar
    SELECT "id", sim
    FROM similarities
    ORDER BY sim DESC NULLS LAST
    LIMIT 10
)

-- 10. return requested columns
SELECT
    nat."id",
    nat."date",
    nat."title",
    ROUND(t.sim, 4)  AS cosine_similarity
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE nat
JOIN top10 t
  ON t."id" = nat."id"
ORDER BY t.sim DESC NULLS LAST;
