```sql
/*  1)  Tokenise “body”, drop non-alphabetic characters, split to words
    2)  discard very common English stop-words (static list)
    3)  keep only words that have both a GloVe vector and a corpus frequency
    4)  scale every vector by 1 / frequency^0.4
    5)  sum the scaled vectors to one aggregate vector per article
    6)  normalise every aggregate vector to unit length
    7)  compute cosine similarity to the required article
    8)  return the ten most similar articles                     */

WITH article_words AS (          -- split every article body into words
    SELECT
        n."id",
        LOWER(f.value::string)      AS word
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             input => SPLIT(
                          REGEXP_REPLACE(n."body", '[^A-Za-z]+', ' '),   -- keep letters only
                          ' ')
         ) f
    WHERE f.value IS NOT NULL               -- remove nulls produced by split
      AND LENGTH(f.value) > 2               -- drop 1- and 2-letter tokens
      AND LOWER(f.value) NOT IN (           -- simple stop-word list
          'the','and','for','from','that','with','this','have','has','had','were',
          'was','are','but','not','can','such','into','its','their','they','been',
          'his','her','she','him','our','out','all','any','may','who','one','two',
          'use','between','which','while','when','where','how','what','why','your',
          'you','than','then','them','these','those','there','here','after','before',
          'also','will','could','shall','would','about','among','because','other',
          'more','over','very','much','many','some','each','most','must','like',
          'is','in','on','at','by','to','of','as','it','an','be','or','if','we',
          'do','does','did','so','no','yes'
      )
),

word_info AS (                    -- attach vector and frequency to every kept word
    SELECT
        aw."id",
        gv."vector",              -- VARIANT holding the 300-d GloVe vector
        wf."frequency"
    FROM article_words                    aw
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS      gv
        ON gv."word" = aw.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES   wf
        ON wf."word" = aw.word
),

weighted AS (                     -- divide every vector by frequency^0.4
    SELECT
        "id",
        VECTOR_SCALE("vector", 1 / POWER("frequency", 0.4))   AS scaled_vector
    FROM word_info
),

aggregated AS (                   -- sum scaled vectors per article
    SELECT
        "id",
        VECTOR_ADD_AGG(scaled_vector) AS agg_vector
    FROM weighted
    GROUP BY "id"
),

normalised AS (                   -- turn every aggregate vector into unit length
    SELECT
        "id",
        VECTOR_NORMALIZE(agg_vector)   AS norm_vector
    FROM aggregated
),

target AS (                       -- vector of the reference article
    SELECT norm_vector
    FROM normalised
    WHERE "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),

similarities AS (                 -- cosine similarity of all other articles to the target
    SELECT
        n."id",
        VECTOR_COSINE_SIMILARITY(n.norm_vector,
                                 (SELECT norm_vector FROM target)) AS sim
    FROM normalised n
    WHERE n."id" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),

top10 AS (                        -- ten most similar articles
    SELECT *
    FROM similarities
    ORDER BY sim DESC NULLS LAST
    LIMIT 10
)

SELECT
    nat."id",
    nat."date",
    nat."title",
    ROUND(t.sim, 4) AS cosine_similarity
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE  nat
JOIN top10                                   t
  ON t."id" = nat."id"
ORDER BY t.sim DESC NULLS LAST;
```
