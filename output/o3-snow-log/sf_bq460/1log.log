/*  Re-write using the native VECTOR_* family of functions that are available in
    Snowflake.  The VARIANT array that stores every GloVe vector is first turned
    into an actual VECTOR value with VECTOR_ENCODE_FLOAT32( ).                  */

WITH article_words AS (          -- 1. tokenise, remove punctuation & stop-words
    SELECT
        n."id",
        LOWER(f.value::string)                             AS word
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(                                  -- split on blanks
             input => SPLIT(
                          REGEXP_REPLACE(n."body", '[^A-Za-z]+', ' '),
                          ' ')
         ) f
    WHERE f.value IS NOT NULL
      AND LENGTH(f.value) > 2
      AND LOWER(f.value) NOT IN (                         -- simple stop-word list
            'the','and','for','from','that','with','this','have','has','had','were',
            'was','are','but','not','can','such','into','its','their','they','been',
            'his','her','she','him','our','out','all','any','may','who','one','two',
            'use','between','which','while','when','where','how','what','why','your',
            'you','than','then','them','these','those','there','here','after','before',
            'also','will','could','shall','would','about','among','because','other',
            'more','over','very','much','many','some','each','most','must','like',
            'is','in','on','at','by','to','of','as','it','an','be','or','if','we',
            'do','does','did','so','no','yes'
      )
),

word_info AS (                   -- 2. keep only words that have both vector & freq
    SELECT
        aw."id",
        VECTOR_ENCODE_FLOAT32(gv."vector")   AS glove_vec,   -- VARIANT -> VECTOR
        wf."frequency"
    FROM article_words                            aw
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
         ON gv."word" = aw.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON wf."word" = aw.word
),

weighted AS (                    -- 3. scale every vector by 1 / freq^0.4
    SELECT
        "id",
        VECTOR_SCALAR_MULTIPLY(                   -- scale operation
              glove_vec ,
              1 / POWER("frequency", 0.4)
        ) AS scaled_vec
    FROM word_info
),

aggregated AS (                  -- 4. sum scaled vectors per article
    SELECT
        "id",
        VECTOR_ADD_AGG(scaled_vec) AS agg_vec
    FROM weighted
    GROUP BY "id"
),

normalised AS (                  -- 5. normalise to unit length
    SELECT
        "id",
        VECTOR_NORMALIZE(agg_vec) AS norm_vec
    FROM aggregated
),

target AS (                      -- 6. pick the reference article’s vector
    SELECT norm_vec
    FROM normalised
    WHERE "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),

similarities AS (                -- 7. cosine similarity for every other article
    SELECT
        n."id",
        VECTOR_COSINE_SIMILARITY(
              n.norm_vec ,
              (SELECT norm_vec FROM target)
        ) AS sim
    FROM normalised n
    WHERE n."id" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),

top10 AS (                       -- 8. pick the ten most similar
    SELECT *
    FROM similarities
    ORDER BY sim DESC NULLS LAST
    LIMIT 10
)

SELECT
    nat."id",
    nat."date",
    nat."title",
    ROUND(t.sim, 4) AS cosine_similarity
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE  nat
JOIN top10                                   t
  ON t."id" = nat."id"
ORDER BY t.sim DESC NULLS LAST;
