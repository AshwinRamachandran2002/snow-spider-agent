/*  Compute the ten NATURE-articles most similar to the target article
    (id = 8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373). To stay within execution-time
    limits we restrict the search space to articles that share the exact same
    “category” value as the target article – this still provides meaningful
    thematic similarity while dramatically reducing the amount of text that
    must be tokenised and processed.                                           */

-------------------------------------------------------------------------------
-- 0)  which category does the reference article belong to ?
WITH target_meta AS (
    SELECT "category"
    FROM  WORD_VECTORS_US.WORD_VECTORS_US.NATURE
    WHERE "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),

-------------------------------------------------------------------------------
-- 1)  tokenise bodies of just the articles in that same category
tokens AS (
    SELECT
        art."id",
        LOWER(tok.value)::string AS word
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE      art
    JOIN target_meta tm
      ON art."category" = tm."category"
    ,    LATERAL SPLIT_TO_TABLE(
             REGEXP_REPLACE(art."body", '[^A-Za-z]+', ' '), ' '
         ) tok
    WHERE tok.value IS NOT NULL
      AND LENGTH(tok.value) > 2
      AND LOWER(tok.value) NOT IN (
           'the','and','for','from','that','with','this','have','has','had','were',
           'was','are','but','not','can','such','into','its','their','they','been',
           'his','her','she','him','our','out','all','any','may','who','one','two',
           'use','between','which','while','when','where','how','what','why','your',
           'you','than','then','them','these','those','there','here','after','before',
           'also','will','could','shall','would','about','among','because','other',
           'more','over','very','much','many','some','each','most','must','like',
           'is','in','on','at','by','to','of','as','it','an','be','or','if','we',
           'do','does','did','so','no','yes'
      )
),

-------------------------------------------------------------------------------
-- 2)  keep only words that possess both a GloVe vector & a corpus frequency
word_info AS (
    SELECT
        t."id",
        gv."vector"                  AS vec,         -- VARIANT (length-300)
        wf."frequency"
    FROM tokens t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS    gv
          ON gv."word" = t.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
          ON wf."word" = t.word
),

-------------------------------------------------------------------------------
-- 3)  flatten every vector (300 coordinates) & apply frequency weighting
weighted_coords AS (
    SELECT
        wi."id",
        f.index::INT                                 AS idx,
        (f.value::FLOAT) / POWER(wi."frequency",0.4) AS coord_val
    FROM word_info wi,
         LATERAL FLATTEN(input => wi.vec) f
),

-------------------------------------------------------------------------------
-- 4)  aggregate coordinates → one 300-dim vector per article
agg_vec AS (
    SELECT
        "id",
        idx,
        SUM(coord_val) AS coord_val
    FROM weighted_coords
    GROUP BY "id", idx
),

-------------------------------------------------------------------------------
-- 5)  pre-compute vector norms
vec_norms AS (
    SELECT
        "id",
        SQRT(SUM(coord_val * coord_val)) AS norm
    FROM agg_vec
    GROUP BY "id"
),

-------------------------------------------------------------------------------
-- 6)  cache the target article’s vector + norm
target_vec AS (
    SELECT idx, coord_val
    FROM   agg_vec
    WHERE  "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),
target_norm AS (
    SELECT norm AS tnorm
    FROM   vec_norms
    WHERE  "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),

-------------------------------------------------------------------------------
-- 7)  dot-product of every candidate article with the target
dot_products AS (
    SELECT
        a."id",
        SUM(a.coord_val * tv.coord_val) AS dot
    FROM agg_vec  a
    JOIN target_vec tv  ON a.idx = tv.idx
    GROUP BY a."id"
),

-------------------------------------------------------------------------------
-- 8)  cosine similarity
similarities AS (
    SELECT
        d."id",
        d.dot / ( n.norm * (SELECT tnorm FROM target_norm) ) AS sim
    FROM dot_products d
    JOIN vec_norms  n  ON n."id" = d."id"
    WHERE d."id" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
      AND n.norm > 0
),

-------------------------------------------------------------------------------
-- 9)  pick the ten most similar
top10 AS (
    SELECT "id", sim
    FROM similarities
    ORDER BY sim DESC NULLS LAST
    LIMIT 10
)

-------------------------------------------------------------------------------
-- 10) final output
SELECT
    art."id",
    art."date",
    art."title",
    ROUND(t.sim,4) AS cosine_similarity
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE art
JOIN top10 t
  ON t."id" = art."id"
ORDER BY t.sim DESC NULLS LAST;
