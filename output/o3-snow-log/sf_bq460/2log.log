```sql
WITH stopwords AS (   -- simple stop-word list
    SELECT COLUMN1 AS word FROM VALUES
        ('a'),('an'),('the'),('and'),('or'),('of'),('in'),('to'),('it'),('for'),
        ('on'),('with'),('as'),('by'),('at'),('from'),('is'),('are'),('was'),
        ('were'),('be'),('been'),('this'),('that'),('these'),('those'),('i'),
        ('you'),('he'),('she'),('they'),('we'),('but'),('if'),('into'),('about'),
        ('than'),('up'),('down'),('over'),('after'),('before'),('between'),
        ('within'),('without'),('such'),('so'),('not'),('no'),('nor'),('can'),
        ('could'),('should'),('would'),('may'),('might'),('will'),('shall'),
        ('do'),('does'),('did'),('done'),('have'),('has'),('had'),('having'),
        ('which'),('who'),('whom'),('whose'),('what'),('when'),('where'),
        ('why'),('how')
),

/* ------------------------------------------------------------------*/
/* 1. tokenise bodies, lower-case, strip punctuation                  */
tokens AS (
    SELECT  n."id",
            n."date",
            n."title",
            LOWER(REGEXP_REPLACE(n."body",'[^A-Za-z ]',' '))   AS clean_text
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n
),

/* ------------------------------------------------------------------*/
/* 2. explode into single words and drop blanks / stop-words          */
words AS (
    SELECT  t.id,
            t.date,
            t.title,
            w.value::string                             AS word
    FROM tokens t,
         LATERAL FLATTEN(input => SPLIT(t.clean_text,' ')) w
    WHERE TRIM(w.value) <> ''
),
filtered_words AS (
    SELECT w.*
    FROM   words w
    LEFT JOIN stopwords s ON w.word = s.word
    WHERE  s.word IS NULL          -- remove stop-words
),

/* ------------------------------------------------------------------*/
/* 3. attach GloVe vectors and corpus frequencies                     */
word_data AS (
    SELECT  fw.id,
            fw.date,
            fw.title,
            gv."vector"                                 AS vec,
            wf."frequency"                              AS freq
    FROM   filtered_words                   fw
    JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"      gv  ON gv."word" = fw.word
    JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"   wf  ON wf."word" = fw.word
),

/* ------------------------------------------------------------------*/
/* 4. weight each vector element-wise by freq^-0.4 and flatten        */
weighted_elems AS (
    SELECT  wd.id,
            wd.date,
            wd.title,
            v.index                                        AS idx,
            (v.value::DOUBLE) / POWER(wd.freq,0.4)         AS val
    FROM   word_data wd,
           LATERAL FLATTEN(input => wd.vec) v
),

/* ------------------------------------------------------------------*/
/* 5. sum weighted elements → raw article vector                     */
article_vec_elems AS (
    SELECT  id,
            date,
            title,
            idx,
            SUM(val)                          AS elem_sum
    FROM   weighted_elems
    GROUP BY id, date, title, idx
),

/* ------------------------------------------------------------------*/
/* 6. compute L2-norm and normalise each element                     */
article_norms AS (
    SELECT id,
           SQRT(SUM(elem_sum * elem_sum))     AS norm
    FROM   article_vec_elems
    GROUP BY id
),
norm_elems AS (
    SELECT ave.id,
           ave.date,
           ave.title,
           ave.idx,
           ave.elem_sum / an.norm             AS nval
    FROM   article_vec_elems ave
    JOIN   article_norms   an  ON an.id = ave.id
),

/* ------------------------------------------------------------------*/
/* 7. elements of target article                                     */
target_elems AS (
    SELECT idx, nval AS tval
    FROM   norm_elems
    WHERE  id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),

/* ------------------------------------------------------------------*/
/* 8. cosine similarity = dot product (vectors already unit length)  */
cosine_scores AS (
    SELECT  ne.id,
            MAX(ne.date)  AS date,
            MAX(ne.title) AS title,
            SUM(ne.nval * te.tval)            AS cosine_similarity
    FROM    norm_elems      ne
    JOIN    target_elems    te   ON ne.idx = te.idx
    WHERE   ne.id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    GROUP BY ne.id
)

/* ------------------------------------------------------------------*/
/* 9. top-10 most similar articles                                   */
SELECT  id,
        date,
        title,
        cosine_similarity
FROM    cosine_scores
ORDER BY cosine_similarity DESC NULLS LAST
LIMIT 10;
```
