```sql
WITH stopwords AS (                                 -- a small English stop-word list
    SELECT COLUMN1 AS word
    FROM VALUES
        ('the'),('and'),('to'),('of'),('a'),('in'),('for'),('on'),('with'),
        ('that'),('as'),('by'),('an'),('be'),('are'),('at'),('from'),('or'),
        ('this'),('we'),('it'),('these'),('which'),('was'),('not'),('been'),
        ('also'),('its'),('such'),('can'),('but'),('their'),('they'),('were'),
        ('have'),('has')
),
tokens AS (                                          -- tokenize body, drop stop-words
    SELECT
        n."id",
        n."date",
        n."title",
        LOWER(f.value::string)          AS token
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                 REGEXP_REPLACE(LOWER(n."body"), '[^a-z0-9\s]', ' ')
             , ' ')
         ) f
    LEFT JOIN stopwords s
           ON LOWER(f.value::string) = s.word
    WHERE f.value::string IS NOT NULL
      AND f.value::string <> ''
      AND s.word IS NULL
),
word_vectors AS (                                   -- join to vectors & frequencies
    SELECT
        t."id",
        gv."vector"                 AS vec,
        wf."frequency"              AS freq
    FROM tokens t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS     gv ON gv."word" = t.token
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  wf ON wf."word" = t.token
),
weighted_vectors AS (                               -- weight:  vec / freq^0.4
    SELECT
        id,
        ARRAY_TRANSFORM(vec, x -> x / POWER(freq, 0.4))   AS w_vec
    FROM word_vectors
),
vec_elems AS (                                      -- flatten weighted vectors
    SELECT
        id,
        fe.index                AS idx,
        fe.value::FLOAT         AS val
    FROM weighted_vectors,
         LATERAL FLATTEN(INPUT => w_vec) fe
),
agg_vec AS (                                        -- sum element-wise per article
    SELECT
        id,
        idx,
        SUM(val)               AS comp
    FROM vec_elems
    GROUP BY id, idx
),
agg_arr AS (                                        -- reconstruct summed array
    SELECT
        id,
        ARRAY_AGG(comp ORDER BY idx)   AS sum_vec
    FROM agg_vec
    GROUP BY id
),
norms AS (                                          -- vector norms
    SELECT
        id,
        SQRT(SUM(POWER(comp,2)))      AS nrm
    FROM agg_vec
    GROUP BY id
),
norm_vec AS (                                       -- normalize to length 1
    SELECT
        a.id,
        ARRAY_AGG(comp / NULLIF(n.nrm,0) ORDER BY idx)  AS vec
    FROM agg_vec a
    JOIN norms n USING(id)
    GROUP BY a.id
),
norm_elems AS (                                     -- flattened normalised elems
    SELECT
        id,
        fe.index          AS idx,
        fe.value::FLOAT   AS val
    FROM norm_vec,
         LATERAL FLATTEN(INPUT => vec) fe
),
target AS (                                         -- elements of the target paper
    SELECT idx, val
    FROM norm_elems
    WHERE id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),
cosine AS (                                         -- cosine similarities
    SELECT
        ne.id,
        SUM(ne.val * t.val)      AS sim
    FROM norm_elems ne
    JOIN target     t  USING (idx)
    WHERE ne.id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    GROUP BY ne.id
),
final AS (                                         -- attach metadata
    SELECT
        c.id,
        n."date",
        n."title",
        c.sim                           AS similarity
    FROM cosine c
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.NATURE n ON n."id" = c.id
)
SELECT
    id,
    date,
    title,
    similarity
FROM final
ORDER BY similarity DESC NULLS LAST
LIMIT 10;
```
