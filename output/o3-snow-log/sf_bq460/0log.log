    ('may'),('might'),('will'),('shall')
),

-- --------------------------------------------------------
-- tokenize article bodies, lower-case, trim punctuation
-- --------------------------------------------------------
tokens AS (
  SELECT  n."id" AS article_id,
          LOWER(TRIM(tok.value)) AS word
  FROM    WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
          LATERAL SPLIT_TO_TABLE(
              REGEXP_REPLACE(n."body", '[^A-Za-z0-9 ]', ' '),  -- remove punctuation
              ' '
          ) tok
  WHERE   tok.value IS NOT NULL
          AND tok.value <> ''
),

-- --------------------------------------------------------
-- remove stop-words and ultra-short tokens
-- --------------------------------------------------------
tokens_filtered AS (
  SELECT  t.article_id,
          t.word
  FROM    tokens t
  LEFT JOIN stopwords s
       ON t.word = s.word
  WHERE   s.word IS NULL
          AND LENGTH(t.word) > 2
),

-- --------------------------------------------------------
-- attach GloVe vector + corpus frequency
-- --------------------------------------------------------
word_vectors AS (
  SELECT  tf.article_id,
          gv."vector"    AS vec,
          wf."frequency" AS freq
  FROM    tokens_filtered tf
  JOIN    WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
       ON gv."word" = tf.word
  JOIN    WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
       ON wf."word" = tf.word
),

-- --------------------------------------------------------
-- flatten vectors, apply weight 1 / freq^0.4, sum per dimension
-- --------------------------------------------------------
token_vector AS (
  SELECT  wv.article_id,
          f.index                       AS dim,
          SUM( (f.value::FLOAT) / POWER(wv.freq, 0.4) ) AS dim_sum
  FROM    word_vectors wv,
          LATERAL FLATTEN(input => wv.vec) f
  GROUP BY wv.article_id, f.index
),

-- --------------------------------------------------------
-- compute norm of each article vector
-- --------------------------------------------------------
agg_norm AS (
  SELECT  article_id,
          SQRT(SUM(POWER(dim_sum, 2))) AS norm
  FROM    token_vector
  GROUP BY article_id
  HAVING  norm > 0
),

-- --------------------------------------------------------
-- normalise vectors
-- --------------------------------------------------------
normalized AS (
  SELECT  tv.article_id,
          tv.dim,
          tv.dim_sum / an.norm AS value
  FROM    token_vector tv
  JOIN    agg_norm an
     ON   tv.article_id = an.article_id
),

-- --------------------------------------------------------
-- vector for the target article
-- --------------------------------------------------------
target_vec AS (
  SELECT dim, value
  FROM   normalized
  WHERE  article_id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),

-- --------------------------------------------------------
-- cosine similarity (dot product)
-- --------------------------------------------------------
similarity AS (
  SELECT  n.article_id,
          SUM(n.value * tv.value) AS cosine_sim
  FROM    normalized n
  JOIN    target_vec tv
     ON   n.dim = tv.dim
  GROUP BY n.article_id
)

-- --------------------------------------------------------
-- top-10 similar articles
-- --------------------------------------------------------
SELECT  sim.article_id               AS "ID",
        nat."date"                   AS "DATE",
        nat."title"                  AS "TITLE",
        sim.cosine_sim               AS "COSINE_SIMILARITY"
FROM    similarity sim
JOIN    WORD_VECTORS_US.WORD_VECTORS_US.NATURE nat
   ON   sim.article_id = nat."id"
WHERE   sim.article_id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
ORDER BY sim.cosine_sim DESC NULLS LAST
LIMIT 10;
