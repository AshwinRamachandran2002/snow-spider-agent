```sql
WITH 
-- --------------------------------------------------------
-- basic English stop-word list (extend as needed)
-- --------------------------------------------------------
stopwords(word) AS (
  SELECT column1 FROM VALUES
    ('a'),('an'),('the'),('and'),('or'),('but'),('if'),('while'),('with'),('for'),
    ('on'),('in'),('to'),('of'),('by'),('is'),('are'),('was'),('were'),
    ('be'),('been'),('has'),('have'),('had'),('do'),('does'),('did'),
    ('that'),('this'),('these'),('those'),('i'),('you'),('he'),('she'),
    ('it'),('we'),('they'),('them'),('as'),('at'),('from'),('which'),
    ('who'),('whom'),('not'),('can'),('could'),('should'),('would'),
    ('may'),('might'),('will'),('shall')
),

-- --------------------------------------------------------
-- tokenize article bodies, lower-case, trim punctuation
-- --------------------------------------------------------
tokens AS (
  SELECT  n."id"  AS article_id,
          LOWER(TRIM(tok.value)) AS word
  FROM    WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
          LATERAL SPLIT_TO_TABLE(
              REGEXP_REPLACE(n."body", '[^A-Za-z0-9 ]', ' ', 'g'),   -- keep only letters/numbers/spaces
              ' '
          ) tok
  WHERE   tok.value IS NOT NULL
          AND tok.value <> ''
),

-- --------------------------------------------------------
-- remove stop-words and ultra-short tokens
-- --------------------------------------------------------
tokens_filtered AS (
  SELECT  t.article_id,
          t.word
  FROM    tokens t
  LEFT JOIN stopwords s
         ON t.word = s.word
  WHERE   s.word IS NULL                     -- not a stop-word
          AND LENGTH(t.word) > 2             -- optional length filter
),

-- --------------------------------------------------------
-- attach GloVe vector + corpus frequency for every token
-- --------------------------------------------------------
word_vectors AS (
  SELECT  tf.article_id,
          gv."vector"          AS vec,
          wf."frequency"       AS freq
  FROM    tokens_filtered                               tf
  JOIN    WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
       ON gv."word" = tf.word
  JOIN    WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
       ON wf."word" = tf.word
),

-- --------------------------------------------------------
-- flatten every vector, apply weight 1 / freq^0.4  and sum per dimension
-- --------------------------------------------------------
token_vector AS (
  SELECT  wv.article_id,
          f.index                       AS dim,
          SUM( (f.value::FLOAT) / POWER(wv.freq, 0.4) )  AS dim_sum
  FROM    word_vectors wv,
          LATERAL FLATTEN(input => wv.vec) f
  GROUP BY wv.article_id, f.index
),

-- --------------------------------------------------------
-- compute vector norm for each article
-- --------------------------------------------------------
agg_norm AS (
  SELECT  article_id,
          SQRT(SUM(POWER(dim_sum, 2))) AS norm
  FROM    token_vector
  GROUP BY article_id
  HAVING  norm > 0
),

-- --------------------------------------------------------
-- normalise vectors to unit length
-- --------------------------------------------------------
normalized AS (
  SELECT  tv.article_id,
          tv.dim,
          tv.dim_sum / an.norm        AS value
  FROM    token_vector tv
  JOIN    agg_norm   an
       ON tv.article_id = an.article_id
),

-- --------------------------------------------------------
-- vector for the target article
-- --------------------------------------------------------
target_vec AS (
  SELECT  dim, value
  FROM    normalized
  WHERE   article_id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),

-- --------------------------------------------------------
-- cosine similarity (dot product – vectors are unit length)
-- --------------------------------------------------------
similarity AS (
  SELECT  n.article_id,
          SUM(n.value * tv.value)  AS cosine_sim
  FROM    normalized n
  JOIN    target_vec tv
       ON n.dim = tv.dim
  GROUP BY n.article_id
)

-- --------------------------------------------------------
-- final result: top-10 most similar articles (excluding target)
-- --------------------------------------------------------
SELECT  sim.article_id                 AS "ID",
        nat."date"                     AS "DATE",
        nat."title"                    AS "TITLE",
        sim.cosine_sim                 AS "COSINE_SIMILARITY"
FROM    similarity               sim
JOIN    WORD_VECTORS_US.WORD_VECTORS_US.NATURE nat
     ON sim.article_id = nat."id"
WHERE   sim.article_id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
ORDER BY sim.cosine_sim DESC NULLS LAST
LIMIT 10;
```
