```sql
WITH                                                    -- 1. stop-word list
STOPWORDS(word) AS (
  SELECT column1
  FROM VALUES
      ('the'),('and'),('or'),('to'),('of'),('in'),('a'),('an'),('for'),('on'),
      ('with'),('at'),('by'),('from'),('is'),('are'),('was'),('were'),('be'),
      ('been'),('but'),('not'),('that'),('this'),('these'),('those'),('as'),
      ('it'),('its'),('into'),('which'),('their'),('them'),('they'),('we'),
      ('us'),('our'),('you'),('your'),('he'),('she'),('his'),('her'),('have'),
      ('has'),('had'),('do'),('does'),('did'),('will'),('shall'),('can'),
      ('could'),('may'),('might')
),                                                      -- 2. tokenise body
TOKENS AS (
  SELECT  n.id,
          LOWER(REGEXP_REPLACE(n.body,'[^a-zA-Z0-9 ]',' '))     AS clean_body
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
),                                                      -- 3. explode words
WORD_LIST AS (
  SELECT  id,
          TRIM(value) AS word
  FROM TOKENS,
       LATERAL SPLIT_TO_TABLE(clean_body,' ')
  WHERE TRIM(value) <> ''
),                                                      -- 4. drop stop-words
FILTERED AS (
  SELECT  wl.id, wl.word
  FROM WORD_LIST wl
  LEFT JOIN STOPWORDS s ON wl.word = s.word
  WHERE s.word IS NULL
),                                                      -- 5. join to vector & freq.
WORD_INFO AS (
  SELECT  f.id,
          gv.vector,
          wf.frequency
  FROM FILTERED f
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS  gv ON gv.word = f.word
  JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf ON wf.word = f.word
),                                                      -- 6. weight & flatten
WORD_FLAT AS (
  SELECT  wi.id,
          fl.index                                     AS idx,
          fl.value::FLOAT * POWER(1.0/wi.frequency,0.4) AS weighted_val
  FROM WORD_INFO wi,
       LATERAL FLATTEN(INPUT => wi.vector) fl
),                                                      -- 7. sum per component
AGG AS (
  SELECT  id,
          idx,
          SUM(weighted_val) AS comp_val
  FROM WORD_FLAT
  GROUP BY id, idx
),                                                      -- 8. build article vector
VEC_AGG AS (
  SELECT  id,
          ARRAY_AGG(comp_val ORDER BY idx) AS agg_vec
  FROM AGG
  GROUP BY id
),                                                      -- 9. compute vector norms
NORMS AS (
  SELECT  id,
          SQRT( SUM( POWER(f.value::FLOAT,2) ) ) AS vnorm
  FROM VEC_AGG,
       LATERAL FLATTEN(INPUT => agg_vec) f
  GROUP BY id
),                                                      -- 10. normalise vectors
NORMED AS (
  SELECT  v.id,
          ARRAY_AGG( (f.value::FLOAT)/n.vnorm ORDER BY f.index ) AS norm_vec
  FROM VEC_AGG  v
  JOIN NORMS    n  ON v.id = n.id
  ,    LATERAL FLATTEN(INPUT => v.agg_vec) f
  GROUP BY v.id
),                                                      -- 11. isolate target vector
TARGET AS (
  SELECT norm_vec AS tvec
  FROM NORMED
  WHERE id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),                                                      -- 12. cosine similarities
SIM AS (
  SELECT  n.id,
          SUM(nf.value::FLOAT * tf.value::FLOAT) AS sim_score
  FROM   NORMED n
  JOIN   TARGET t
  JOIN   LATERAL FLATTEN(INPUT => n.norm_vec) nf
  JOIN   LATERAL FLATTEN(INPUT => t.tvec)     tf
             ON nf.index = tf.index
  WHERE  n.id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
  GROUP BY n.id
)                                                       -- 13. top-10 similar
SELECT  s.id,
        nat.date,
        nat.title,
        s.sim_score
FROM    SIM s
JOIN    WORD_VECTORS_US.WORD_VECTORS_US.NATURE nat ON nat.id = s.id
ORDER BY s.sim_score DESC NULLS LAST
LIMIT 10;
```
