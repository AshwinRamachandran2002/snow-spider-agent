WORD_INFO AS (
    SELECT
        f.article_id,
        gv."vector"           AS vector,
        wf."frequency"        AS frequency
    FROM FILTERED f
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv ON gv."word" = f.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf ON wf."word" = f.word
),

/*------------------------------------------------------------------*
 * 6. weight each vector component                                  *
 *------------------------------------------------------------------*/
WORD_FLAT AS (
    SELECT
        wi.article_id,
        fl."INDEX"                                   AS pos,
        (fl.value::FLOAT) / POWER(wi.frequency, 0.4) AS weighted_val
    FROM WORD_INFO wi,
         LATERAL FLATTEN(INPUT => wi.vector) fl
),

/*------------------------------------------------------------------*
 * 7. sum components per article                                    *
 *------------------------------------------------------------------*/
AGG AS (
    SELECT
        article_id,
        pos,
        SUM(weighted_val) AS comp_val
    FROM WORD_FLAT
    GROUP BY article_id, pos
),

/*------------------------------------------------------------------*
 * 8. assemble aggregate vector                                     *
 *------------------------------------------------------------------*/
VEC_AGG AS (
    SELECT
        article_id,
        ARRAY_AGG(comp_val) WITHIN GROUP (ORDER BY pos) AS agg_vec
    FROM AGG
    GROUP BY article_id
),

/*------------------------------------------------------------------*
 * 9. compute vector norms                                          *
 *------------------------------------------------------------------*/
NORMS AS (
    SELECT
        article_id,
        SQRT( SUM( POWER(f.value::FLOAT, 2) ) ) AS vnorm
    FROM VEC_AGG,
         LATERAL FLATTEN(INPUT => agg_vec) f
    GROUP BY article_id
),

/*------------------------------------------------------------------*
 * 10. normalise vectors                                            *
 *------------------------------------------------------------------*/
NORMED AS (
    SELECT
        v.article_id,
        ARRAY_AGG( (flt.value::FLOAT) / n.vnorm )
            WITHIN GROUP (ORDER BY flt."INDEX")      AS norm_vec
    FROM VEC_AGG v
    JOIN NORMS n ON v.article_id = n.article_id,
         LATERAL FLATTEN(INPUT => v.agg_vec) flt
    GROUP BY v.article_id, n.vnorm
),

/*------------------------------------------------------------------*
 * 11. target article vector                                        *
 *------------------------------------------------------------------*/
TARGET AS (
    SELECT norm_vec AS tvec
    FROM NORMED
    WHERE article_id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),

/*------------------------------------------------------------------*
 * 12. cosine similarities                                          *
 *------------------------------------------------------------------*/
SIM AS (
    SELECT
        n.article_id,
        SUM(nf.value::FLOAT * tf.value::FLOAT) AS sim_score
    FROM NORMED n,
         LATERAL FLATTEN(INPUT => n.norm_vec) nf,
         TARGET t,
         LATERAL FLATTEN(INPUT => t.tvec) tf
    WHERE n.article_id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
      AND nf."INDEX" = tf."INDEX"
    GROUP BY n.article_id
)

/*------------------------------------------------------------------*
 * 13. top-10 most similar articles                                 *
 *------------------------------------------------------------------*/
SELECT
    s.article_id AS id,
    nat."date",
    nat."title",
    s.sim_score
FROM SIM s
JOIN WORD_VECTORS_US.WORD_VECTORS_US.NATURE nat
  ON nat."id" = s.article_id
ORDER BY s.sim_score DESC NULLS LAST
LIMIT 10;
