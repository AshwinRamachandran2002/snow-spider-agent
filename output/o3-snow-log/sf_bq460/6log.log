/* -----------------------------------------------------------------
   Helper scalar JavaScript functions for simple vector arithmetic
------------------------------------------------------------------*/
CREATE OR REPLACE TEMPORARY FUNCTION VECTOR_DIVIDE(vec ARRAY, scalar FLOAT)
RETURNS ARRAY
LANGUAGE JAVASCRIPT
AS
$$
  if (scalar === 0) return vec;
  return vec.map(v => v / scalar);
$$;

CREATE OR REPLACE TEMPORARY FUNCTION VECTOR_NORMALIZE(vec ARRAY)
RETURNS ARRAY
LANGUAGE JAVASCRIPT
AS
$$
  let norm = Math.sqrt(vec.reduce((s, v) => s + v*v , 0));
  if (norm === 0) return vec;
  return vec.map(v => v / norm);
$$;

CREATE OR REPLACE TEMPORARY FUNCTION COSINE_SIMILARITY(vec1 ARRAY , vec2 ARRAY )
RETURNS FLOAT
LANGUAGE JAVASCRIPT
AS
$$
  let len = Math.min(vec1.length , vec2.length);
  let dot = 0;
  for (let i = 0 ; i < len ; i++){ dot += vec1[i]*vec2[i]; }
  return dot;
$$;

/* -----------------------------------------------------------------
   Build one normalised article-vector per Nature article,
   then measure cosine similarity to the requested article
------------------------------------------------------------------*/
WITH tokenised AS (
    SELECT
        n."id",
        n."date",
        n."title",
        LOWER(TRIM(tok.value::STRING))                            AS word
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
             INPUT => SPLIT(
                       REGEXP_REPLACE(LOWER(n."body"), '[^a-z0-9 ]', ' '),
                       ' ')
         ) tok
),
-- remove very common stop-words
filtered AS (
    SELECT *
    FROM   tokenised
    WHERE  word <> ''
      AND  word NOT IN
           ('a','an','the','and','or','but','if','on','in','with','is','to','of','for',
            'by','at','from','up','out','into','over','after','under','above','below',
            'about','before','between','again','further','then','once','here','there',
            'when','where','why','how','all','any','both','each','few','more','most',
            'other','some','such','no','nor','not','only','own','same','so','than',
            'too','very','can','will','just','don','should','now')
),
-- attach GloVe vector and corpus frequency
word_info AS (
    SELECT
        f."id",
        f."date",
        f."title",
        gv."vector",
        wf."frequency"
    FROM   filtered f
    JOIN   WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS       gv  ON gv."word" = f.word
    JOIN   WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES    wf  ON wf."word" = f.word
),
-- weight each word vector by  freq ^ -0.4
weighted AS (
    SELECT
        "id", "date", "title",
        VECTOR_DIVIDE("vector", POWER("frequency", 0.4))        AS wvec
    FROM   word_info
),
-- explode vectors, sum per dimension per article
components AS (
    SELECT
        w."id", w."date", w."title",
        cmp."index"                                              AS idx,
        cmp."value"::FLOAT                                       AS comp
    FROM   weighted w,
           LATERAL FLATTEN(INPUT => w.wvec) cmp
),
summed AS (
    SELECT
        "id", "date", "title", idx,
        SUM(comp)                                                AS comp_sum
    FROM   components
    GROUP  BY "id", "date", "title", idx
),
agg_vecs AS (
    SELECT
        "id", "date", "title",
        ARRAY_AGG(comp_sum ORDER BY idx)                         AS agg_vec
    FROM   summed
    GROUP  BY "id", "date", "title"
),
normed AS (
    SELECT
        "id", "date", "title",
        VECTOR_NORMALIZE(agg_vec)                                AS norm_vec
    FROM   agg_vecs
),
target AS (
    SELECT norm_vec AS tgt_vec
    FROM   normed
    WHERE  "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),
similarities AS (
    SELECT
        n."id",
        n."date",
        n."title",
        COSINE_SIMILARITY(n.norm_vec, t.tgt_vec)                 AS cosine_similarity
    FROM   normed n
    CROSS  JOIN target t
    WHERE  n."id" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
SELECT
    "id",
    "date",
    "title",
    cosine_similarity
FROM   similarities
ORDER  BY cosine_similarity DESC NULLS LAST
LIMIT  10;
```
