```sql
--Description: 5)  Derive monthly net-movement (purchases – sales) for every product in 2019
WITH s AS (
    SELECT "product_id",
           TO_CHAR(TO_DATE("mth"), 'YYYY-MM') AS "month",
           SUM("qty") AS "sales_qty"
    FROM   ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
    WHERE  "mth" LIKE '2019-%'
    GROUP  BY "product_id", TO_CHAR(TO_DATE("mth"), 'YYYY-MM')
), p AS (
    SELECT "product_id",
           TO_CHAR(TO_DATE("purchased"), 'YYYY-MM') AS "month",
           SUM("qty") AS "purchase_qty"
    FROM   ORACLE_SQL.ORACLE_SQL.PURCHASES
    WHERE  "purchased" LIKE '2019-%'
    GROUP  BY "product_id", TO_CHAR(TO_DATE("purchased"), 'YYYY-MM')
)
SELECT COALESCE(p."product_id", s."product_id")               AS "product_id",
       COALESCE(p."month",      s."month")                    AS "month",
       COALESCE("purchase_qty", 0) - COALESCE("sales_qty", 0) AS "net_movement"
FROM   p
FULL JOIN s
ON     p."product_id" = s."product_id"
AND    p."month"      = s."month"
ORDER  BY "product_id", "month"
LIMIT  20;
```

```sql
--Description: 6)  Build December-2018 ending inventory (starting point for recursion)
WITH inv AS (
    SELECT "product_id",
           SUM("qty") AS "on_hand_qty"
    FROM   ORACLE_SQL.ORACLE_SQL.INVENTORY
    GROUP  BY "product_id"
), sales18 AS (
    SELECT "product_id",
           SUM("qty") AS "sales_2018_qty"
    FROM   ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
    WHERE  "mth" BETWEEN '2018-01-01' AND '2018-12-31'
    GROUP  BY "product_id"
), purch18 AS (
    SELECT "product_id",
           SUM("qty") AS "purchase_2018_qty"
    FROM   ORACLE_SQL.ORACLE_SQL.PURCHASES
    WHERE  "purchased" BETWEEN '2018-01-01' AND '2018-12-31'
    GROUP  BY "product_id"
)
SELECT i."product_id",
       (i."on_hand_qty"
        + COALESCE(purch18."purchase_2018_qty",0)
        - COALESCE(sales18."sales_2018_qty",0)
       ) AS "ending_inv_dec_2018"
FROM   inv i
LEFT JOIN sales18 ON sales18."product_id" = i."product_id"
LEFT JOIN purch18 ON purch18."product_id" = i."product_id"
ORDER  BY i."product_id"
LIMIT  20;
```

```sql
--Description: 7)  Recursive monthly inventory calculation for 2019:
--                restock (add "qty_purchase") when ending inventory < minimum
WITH minrules AS (
    SELECT "product_id", "qty_minimum", "qty_purchase"
    FROM   ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS
),
movements AS (
    SELECT COALESCE(p."product_id", s."product_id")      AS "product_id",
           COALESCE(p."month", s."month")                AS "month",
           COALESCE("purchase_qty",0) - COALESCE("sales_qty",0) AS "net_movement"
    FROM (
        SELECT "product_id",
               TO_CHAR(TO_DATE("purchased"), 'YYYY-MM') AS "month",
               SUM("qty") AS "purchase_qty"
        FROM   ORACLE_SQL.ORACLE_SQL.PURCHASES
        WHERE  "purchased" LIKE '2019-%'
        GROUP  BY "product_id", TO_CHAR(TO_DATE("purchased"), 'YYYY-MM')
    ) p
    FULL JOIN (
        SELECT "product_id",
               TO_CHAR(TO_DATE("mth"), 'YYYY-MM') AS "month",
               SUM("qty") AS "sales_qty"
        FROM   ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
        WHERE  "mth" LIKE '2019-%'
        GROUP  BY "product_id", TO_CHAR(TO_DATE("mth"), 'YYYY-MM')
    ) s
    ON  p."product_id" = s."product_id"
    AND p."month"      = s."month"
),
seed AS (                                     -- starting inventory 2018-12
    SELECT "product_id", 
           '2018-12'::STRING AS "month",
           "ending_inv_dec_2018" AS "ending_inv"
    FROM  (
            -- same sub-query as step 6
            SELECT i."product_id",
                   (i."on_hand_qty"
                    + COALESCE(purch18."purchase_2018_qty",0)
                    - COALESCE(sales18."sales_2018_qty",0)
                   ) AS "ending_inv_dec_2018"
            FROM  (
                      SELECT "product_id", SUM("qty") AS "on_hand_qty"
                      FROM   ORACLE_SQL.ORACLE_SQL.INVENTORY
                      GROUP  BY "product_id"
                  ) i
            LEFT JOIN (
                      SELECT "product_id", SUM("qty") AS "sales_2018_qty"
                      FROM   ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
                      WHERE  "mth" BETWEEN '2018-01-01' AND '2018-12-31'
                      GROUP  BY "product_id"
                  ) sales18  ON sales18."product_id" = i."product_id"
            LEFT JOIN (
                      SELECT "product_id", SUM("qty") AS "purchase_2018_qty"
                      FROM   ORACLE_SQL.ORACLE_SQL.PURCHASES
                      WHERE  "purchased" BETWEEN '2018-01-01' AND '2018-12-31'
                      GROUP  BY "product_id"
                  ) purch18 ON purch18."product_id" = i."product_id"
         )
),
r AS (                                         -- recursive section
    SELECT * FROM seed
    UNION ALL
    SELECT  m."product_id",
            m."month",
            CASE 
              WHEN (r."ending_inv" + COALESCE(m."net_movement",0)) < mr."qty_minimum"
              THEN (r."ending_inv" + COALESCE(m."net_movement",0) + mr."qty_purchase")
              ELSE (r."ending_inv" + COALESCE(m."net_movement",0))
            END AS "ending_inv"
    FROM   r
    JOIN   movements  m  ON m."product_id" = r."product_id"
                         AND DATEADD(month,1,TO_DATE(r."month"||'-01')) = TO_DATE(m."month"||'-01')
    LEFT  JOIN minrules mr ON mr."product_id" = r."product_id"
    WHERE  m."month" BETWEEN '2019-01' AND '2019-12'
)
SELECT * 
FROM   r
WHERE  "month" BETWEEN '2019-01' AND '2019-12'
ORDER  BY "product_id", "month"
LIMIT  20;
```

```sql
--Description: 8)  For every product/month in 2019, get the absolute gap to its minimum level
WITH inv AS (                                     -- previous recursive query (step 7)
    SELECT "product_id", "month", "ending_inv"
    FROM   (
        -- reference step-7 CTE “r”
        SELECT * FROM r
    )
    WHERE  "month" BETWEEN '2019-01' AND '2019-12'
), minrules AS (
    SELECT "product_id", "qty_minimum"
    FROM   ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS
)
SELECT  i."product_id",
        i."month",
        ABS(i."ending_inv" - mr."qty_minimum") AS "abs_gap"
FROM    inv i
JOIN    minrules mr
ON      mr."product_id" = i."product_id"
ORDER BY i."product_id", i."month"
LIMIT   20;
```

```sql
--Description: 9)  Pick, for each product, the month in 2019 where the absolute gap is the smallest
WITH gaps AS (                                   -- use step-8
    SELECT  i."product_id",
            i."month",
            ABS(i."ending_inv" - mr."qty_minimum") AS "abs_gap",
            ROW_NUMBER() OVER (PARTITION BY i."product_id"
                               ORDER BY ABS(i."ending_inv" - mr."qty_minimum") ASC) AS rn
    FROM   (
        SELECT "product_id", "month", "ending_inv"
        FROM   r                                   -- recursive result from step-7
        WHERE  "month" BETWEEN '2019-01' AND '2019-12'
    ) i
    JOIN   ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS mr
    ON     mr."product_id" = i."product_id"
)
SELECT  "product_id",
        "month",
        "abs_gap"
FROM    gaps
WHERE   rn = 1            -- the smallest gap per product
ORDER BY "product_id"
LIMIT   20;
```

```sql
--Description: 10)  Final answer – month in 2019 where each product’s ending inventory is closest to its minimum
SELECT  "product_id",
        "month",
        "abs_gap"
FROM   (
    -- same sub-query as step-9 SELECT block
    WITH gaps AS (
        SELECT  i."product_id",
                i."month",
                ABS(i."ending_inv" - mr."qty_minimum") AS "abs_gap",
                ROW_NUMBER() OVER (PARTITION BY i."product_id"
                                   ORDER BY ABS(i."ending_inv" - mr."qty_minimum")) AS rn
        FROM   (
            SELECT "product_id", "month", "ending_inv"
            FROM   r
            WHERE  "month" BETWEEN '2019-01' AND '2019-12'
        ) i
        JOIN   ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS mr
        ON     mr."product_id" = i."product_id"
    )
    SELECT * FROM gaps WHERE rn = 1
) t
ORDER BY "product_id"
LIMIT  20;
```
