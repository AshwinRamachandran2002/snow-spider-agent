```sql
/*————————————————————————————————————————————————————————————
  Recursive monthly inventory simulation                     

  1.  Start with each product that has a minimum-inventory rule
      (table PRODUCT_MINIMUMS).

  2.  Anchor month = 2018-12.
      Beginning inventory for that month is assumed to be
      qty_minimum + qty_purchase.

  3.  For every following month we
         – subtract that month’s sales (MONTHLY_SALES)
         – if the resulting stock < qty_minimum
           then one replenishment of qty_purchase is added.
      The process is repeated month-by-month up to 2019-12.

  4.  For calendar year 2019 we calculate
         | ending_inventory – qty_minimum |   (absolute difference)
      and keep, per product, the month where that difference
      is the smallest (ties → earliest month).

  5.  Return product_id, the month (YYYY-MM) and the difference.
————————————————————————————————————————————————————————————*/
WITH
base AS (                            -- products with minimum rules
    SELECT  "product_id",
            "qty_minimum",
            "qty_purchase"
    FROM    ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS
),
sales AS (                           -- monthly sales (Dec-18 .. Dec-19)
    SELECT  "product_id",
            TO_DATE("mth")     AS mth,
            SUM("qty")         AS sales_qty
    FROM    ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
    WHERE   TO_DATE("mth") >= '2018-12-01'
      AND   "product_id" IN (SELECT "product_id" FROM base)
    GROUP BY "product_id", TO_DATE("mth")
),
/*——————————————————  recursive inventory calculation  —————————————————*/
RECURSIVE inv AS (
    /* Anchor row : 2018-12 */
    SELECT  b."product_id",
            b."qty_minimum",
            b."qty_purchase",
            TO_DATE('2018-12-01')                         AS mth,
            (b."qty_minimum" + b."qty_purchase")          AS begin_inv,
            COALESCE(s.sales_qty,0)                       AS sales_qty,
            CASE
                WHEN (b."qty_minimum" + b."qty_purchase") - COALESCE(s.sales_qty,0)
                       < b."qty_minimum"
                THEN (b."qty_minimum" + b."qty_purchase") - COALESCE(s.sales_qty,0)
                       + b."qty_purchase"
                ELSE (b."qty_minimum" + b."qty_purchase") - COALESCE(s.sales_qty,0)
            END                                           AS ending_inv
    FROM    base b
    LEFT JOIN sales s
           ON s."product_id" = b."product_id"
          AND s.mth         = TO_DATE('2018-12-01')

    UNION ALL

    /* Subsequent months up to 2019-12 */
    SELECT  i."product_id",
            i."qty_minimum",
            i."qty_purchase",
            DATEADD(month,1,i.mth)                        AS mth,
            i.ending_inv                                  AS begin_inv,
            COALESCE(s2.sales_qty,0)                      AS sales_qty,
            CASE
                WHEN i.ending_inv - COALESCE(s2.sales_qty,0) < i."qty_minimum"
                THEN i.ending_inv - COALESCE(s2.sales_qty,0) + i."qty_purchase"
                ELSE i.ending_inv - COALESCE(s2.sales_qty,0)
            END                                           AS ending_inv
    FROM    inv i
    LEFT JOIN sales s2
           ON s2."product_id" = i."product_id"
          AND s2.mth         = DATEADD(month,1,i.mth)
    WHERE   i.mth < '2019-12-01'          -- stop when the next row would be 2020-01
),
/*——————————————————  absolute differences for 2019  ——————————————————*/
diffs AS (
    SELECT  "product_id",
            mth,
            ABS(ending_inv - "qty_minimum")  AS abs_diff,
            ROW_NUMBER() OVER (PARTITION BY "product_id"
                               ORDER BY ABS(ending_inv - "qty_minimum"), mth) AS rn
    FROM    inv
    WHERE   mth BETWEEN '2019-01-01' AND '2019-12-01'
)
/*——————————————————  final answer  ————————————————————————*/
SELECT  "product_id",
        TO_CHAR(mth,'YYYY-MM')  AS month_2019,
        abs_diff
FROM    diffs
WHERE   rn = 1
ORDER BY "product_id";
```
