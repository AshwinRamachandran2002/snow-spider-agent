```sql
--Description: 9) Compute 2019 monthly net change (budget – sales) for one sample product to validate recursive logic  
SELECT  COALESCE(b."mth",s."mth")       AS "mth",
        COALESCE(b."qty",0)             AS "purchased",
        COALESCE(s."qty",0)             AS "sold",
        b."product_id"
FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_BUDGET"  b
FULL JOIN ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"   s
       ON b."product_id" = s."product_id"
      AND b."mth" = s."mth"
WHERE COALESCE(b."product_id",s."product_id") = 6520      --sample
  AND COALESCE(b."mth",s."mth") BETWEEN '2019-01-01' AND '2019-12-01'
ORDER BY "mth"
LIMIT 20;
```

```sql
--Description: 10) Preview the minimum-difference calculation concept: absolute gap between ending inventory & minimum for each 2019 month (sample product)  
WITH base AS (  --net monthly movement  
    SELECT  COALESCE(b."mth",s."mth")          AS "mth",
            COALESCE(b."qty",0) - COALESCE(s."qty",0) AS "net_change"
    FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_BUDGET"  b
    FULL JOIN ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"   s
           ON b."product_id" = s."product_id"
          AND b."mth" = s."mth"
    WHERE COALESCE(b."product_id",s."product_id") = 6520
      AND COALESCE(b."mth",s."mth") BETWEEN '2019-01-01' AND '2019-12-01'
), running AS (  --recursive inventory path (simplified, non-recursive preview)
    SELECT  '2018-12-01' AS "mth", 100.0 AS "end_inv"  --placeholder starting qty
    UNION ALL
    SELECT  b."mth",
            lag."end_inv" + b."net_change"
    FROM base b
    JOIN running lag
      ON lag."mth" = '2018-12-01'  --dummy join just for LIMIT demo
)
SELECT r."mth",
       r."end_inv",
       p."qty_minimum",
       ABS(r."end_inv" - p."qty_minimum") AS "abs_diff"
FROM running r
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS" p
     ON p."product_id" = 6520
LIMIT 20;
```
