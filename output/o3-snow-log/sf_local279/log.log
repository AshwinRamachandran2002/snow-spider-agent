```sql
--Description: The recursive CTE raised a data-type mismatch on “end_inv”.  To
--avoid recursion and type issues, we’ll rebuild the preview for product 6520
--using a two-step window-function approach:
-- 1) “base” finds each 2018 month’s net inventory movement
--    (budget purchases minus sales).  
-- 2) “calc” applies a starting stock of 100 units (2017-12-01) and produces a
--    running ending-inventory total with SUM() OVER (ORDER BY mth).  
-- Finally we join to PRODUCT_MINIMUMS to see the absolute gap to the minimum.
WITH base AS (
    SELECT  COALESCE(b."mth", s."mth")                 AS "mth",
            COALESCE(b."qty",0) - COALESCE(s."qty",0)  AS "net_change"
    FROM   ORACLE_SQL.ORACLE_SQL."MONTHLY_BUDGET" b
    FULL   JOIN ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"  s
           ON b."product_id" = s."product_id"
          AND b."mth"        = s."mth"
    WHERE  COALESCE(b."product_id", s."product_id") = 6520
      AND  COALESCE(b."mth", s."mth") BETWEEN '2018-01-01' AND '2018-12-01'
),
calc AS (
    SELECT  "mth",
            100                                   AS "start_inv",   --assumed
            "net_change",
            100 + SUM("net_change") OVER (ORDER BY "mth")  AS "end_inv"
    FROM    base
)
SELECT  c."mth",
        c."end_inv",
        p."qty_minimum",
        ABS(c."end_inv" - p."qty_minimum") AS "abs_diff"
FROM    calc c
JOIN    ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS" p
        ON p."product_id" = 6520
ORDER BY c."mth"
LIMIT 20;
