```

```sql
--Description: 3) Show the on-hand inventory (all locations summed) for the products that have minimum rules.
SELECT 
    i."product_id",
    SUM(i."qty")       AS "on_hand_qty"
FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"   i
WHERE i."product_id" IN (SELECT "product_id" FROM ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS")
GROUP BY i."product_id"
LIMIT 20;
```

```sql
--Description: 4) Inspect monthly sales history for those same products (all years).
SELECT 
    ms."product_id",
    ms."mth",
    ms."qty"
FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES" ms
WHERE ms."product_id" IN (SELECT "product_id" FROM ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS")
ORDER BY ms."product_id", ms."mth"
LIMIT 20;
```

```sql
--Description: 5) Verify if any 2019 sales exist in MONTHLY_SALES (quick check).
SELECT DISTINCT
    ms."mth"
FROM ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES" ms
WHERE ms."mth" ILIKE '2019%'
LIMIT 20;
```

```sql
--Description: 6) Look at detailed order lines for 2019 to see demand month-by-month.
SELECT 
    o."ordered",
    ol."product_id",
    ol."qty"
FROM ORACLE_SQL.ORACLE_SQL."ORDERLINES"  ol
JOIN ORACLE_SQL.ORACLE_SQL."ORDERS"      o
  ON ol."order_id" = o."id"
WHERE o."ordered" ILIKE '2019%'
  AND ol."product_id" IN (SELECT "product_id" FROM ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS")
ORDER BY ol."product_id", o."ordered"
LIMIT 20;
```

```sql
--Description: 7) Check how much we purchased (restocked) in 2018 and 2019 for those products.
SELECT
    pr."purchased",
    pr."product_id",
    pr."qty"
FROM ORACLE_SQL.ORACLE_SQL."PURCHASES" pr
WHERE pr."purchased" ILIKE '2018%' OR pr."purchased" ILIKE '2019%'
  AND pr."product_id" IN (SELECT "product_id" FROM ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS")
ORDER BY pr."product_id", pr."purchased"
LIMIT 20;
```

```sql
--Description: 8) Aggregate 2019 demand (orders) by product and month (string substr as month key).
SELECT
    ol."product_id",
    SUBSTR(o."ordered", 1, 7) AS "yyyy_mm",
    SUM(ol."qty")             AS "demand_qty"
FROM ORACLE_SQL.ORACLE_SQL."ORDERLINES"  ol
JOIN ORACLE_SQL.ORACLE_SQL."ORDERS"      o
  ON ol."order_id" = o."id"
WHERE o."ordered" ILIKE '2019%'
  AND ol."product_id" IN (SELECT "product_id" FROM ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS")
GROUP BY ol."product_id", SUBSTR(o."ordered", 1, 7)
ORDER BY ol."product_id", "yyyy_mm"
LIMIT 20;
```

```sql
--Description: 9) Aggregate 2019 purchases (restocks) by product and month.
SELECT
    pr."product_id",
    SUBSTR(pr."purchased", 1, 7) AS "yyyy_mm",
    SUM(pr."qty")                AS "restock_qty"
FROM ORACLE_SQL.ORACLE_SQL."PURCHASES" pr
WHERE pr."purchased" ILIKE '2019%'
  AND pr."product_id" IN (SELECT "product_id" FROM ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS")
GROUP BY pr."product_id", SUBSTR(pr."purchased", 1, 7)
ORDER BY pr."product_id", "yyyy_mm"
LIMIT 20;
```

```sql
--Description: 10) Bring everything together (starting inventory, 2019 demand & restock, minimum) 
--   to help us later compute the recursive month-by-month ending inventory.
SELECT
    pm."product_id",
    p."name",
    pm."qty_minimum",
    inv."on_hand_qty",
    dm."demand_qty_2019",
    rs."restock_qty_2019"
FROM ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS"  pm
LEFT JOIN (
    SELECT i."product_id", SUM(i."qty") AS "on_hand_qty"
    FROM ORACLE_SQL.ORACLE_SQL."INVENTORY" i
    GROUP BY i."product_id"
) inv ON inv."product_id" = pm."product_id"
LEFT JOIN (
    SELECT ol."product_id", SUM(ol."qty") AS "demand_qty_2019"
    FROM ORACLE_SQL.ORACLE_SQL."ORDERLINES"  ol
    JOIN ORACLE_SQL.ORACLE_SQL."ORDERS"      o
      ON ol."order_id" = o."id"
    WHERE o."ordered" ILIKE '2019%'
    GROUP BY ol."product_id"
) dm ON dm."product_id" = pm."product_id"
LEFT JOIN (
    SELECT pr."product_id", SUM(pr."qty") AS "restock_qty_2019"
    FROM ORACLE_SQL.ORACLE_SQL."PURCHASES" pr
    WHERE pr."purchased" ILIKE '2019%'
    GROUP BY pr."product_id"
) rs ON rs."product_id" = pm."product_id"
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
  ON p."id" = pm."product_id"
LIMIT 20;
```
