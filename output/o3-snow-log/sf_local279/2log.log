/*----------------------------------------------------------
  Recursive monthly inventory model – corrected Snowflake SQL
----------------------------------------------------------*/
WITH RECURSIVE
/*----------------------------------------------------------
  1) Minimums & purchase-lot sizes we must respect
----------------------------------------------------------*/
PM AS (
    SELECT
        "product_id",
        "qty_minimum",
        "qty_purchase"
    FROM ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS"
),
/*----------------------------------------------------------
  2) Inventory position at the end of 2018-12
----------------------------------------------------------*/
DEC_END AS (
    SELECT
        pm."product_id",
        pm."qty_minimum",
        pm."qty_purchase",
        COALESCE(SUM(p."qty"),  0)                 AS bought_qty,
        COALESCE(SUM(ms."qty"), 0)                 AS sold_qty,
        COALESCE(SUM(p."qty"),  0) -
        COALESCE(SUM(ms."qty"), 0)                 AS end_inv
    FROM PM  pm
    LEFT JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"     p
           ON p."product_id" = pm."product_id"
          AND TO_DATE(p."purchased") <= TO_DATE('2018-12-31')
    LEFT JOIN ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES" ms
           ON ms."product_id" = pm."product_id"
          AND TO_DATE(ms."mth")      <= TO_DATE('2018-12-01')
    GROUP BY pm."product_id", pm."qty_minimum", pm."qty_purchase"
),
/*----------------------------------------------------------
  3) The 12 calendar months of 2019 (2019-01-01 … 2019-12-01)
----------------------------------------------------------*/
MONTHS_2019 AS (
    SELECT
        DATEADD(month, SEQ4(), TO_DATE('2019-01-01')) AS mth
    FROM TABLE(GENERATOR(ROWCOUNT => 12))
),
/*----------------------------------------------------------
  4) Recursive month-by-month inventory calculation
----------------------------------------------------------*/
inv (product_id, qty_minimum, qty_purchase, mth, end_inv) AS (

    /* Anchor row : ending inventory at 2018-12-01 */
    SELECT
        d."product_id",
        d."qty_minimum",
        d."qty_purchase",
        TO_DATE('2018-12-01')               AS mth,
        d.end_inv                           AS end_inv
    FROM DEC_END d

    UNION ALL

    /* Recursive step : advance one month */
    SELECT
        i.product_id,
        i.qty_minimum,
        i.qty_purchase,
        DATEADD(month, 1, i.mth)            AS mth,
        CASE
             WHEN i.end_inv - COALESCE(ms.qty, 0)
                  < i.qty_minimum
             THEN i.end_inv - COALESCE(ms.qty, 0) + i.qty_purchase
             ELSE i.end_inv - COALESCE(ms.qty, 0)
        END                                 AS end_inv
    FROM inv i
    JOIN MONTHS_2019  m
         ON DATEADD(month, 1, i.mth) = m.mth
    LEFT JOIN ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES" ms
           ON ms."product_id" = i.product_id
          AND TO_DATE(ms."mth") = m.mth
    WHERE i.mth < TO_DATE('2019-12-01')     -- stop after Nov-19 generates Dec-19
),
/*----------------------------------------------------------
  5) Keep only the 2019 rows
----------------------------------------------------------*/
INV_2019 AS (
    SELECT *
    FROM   inv
    WHERE  mth BETWEEN TO_DATE('2019-01-01') AND TO_DATE('2019-12-01')
),
/*----------------------------------------------------------
  6) Rank months by closeness to the minimum
----------------------------------------------------------*/
ranked AS (
    SELECT
        product_id,
        mth,
        qty_minimum,
        end_inv,
        ABS(end_inv - qty_minimum)                      AS abs_diff,
        ROW_NUMBER() OVER (
            PARTITION BY product_id
            ORDER BY ABS(end_inv - qty_minimum), mth
        )                                               AS rn
    FROM INV_2019
)
/*----------------------------------------------------------
  Final result
----------------------------------------------------------*/
SELECT
    product_id,
    TO_CHAR(mth, 'YYYY-MM')   AS month_2019,
