```sql
/*----------------------------------------------------------
  Recursive monthly inventory model
  ----------------------------------------------------------
  1)  Find the ending inventory for each product on
      2018-12-31   (purchases  –  sales).
  2)  Walk through every month of 2019.  
      If the ending inventory of the previous month is
      below the minimum, add one purchase lot.
  3)  For every product keep the 2019-month whose
      ending inventory is closest to the minimum.
----------------------------------------------------------*/
WITH
    /* Minimums & purchase-lot sizes we must respect */
    "PM" AS (
        SELECT  "product_id",
                "qty_minimum",
                "qty_purchase"
        FROM ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS"
    ),

    /* Inventory position at the end of 2018-12 */
    "DEC_END" AS (
        SELECT
            pm."product_id",
            pm."qty_minimum",
            pm."qty_purchase",
            /* total bought up to 2018-12-31 */
            COALESCE( SUM(p."qty") , 0 )          AS bought_qty,
            /* total sold   up to 2018-12-01 (month bucket) */
            COALESCE( SUM(ms."qty"), 0 )          AS sold_qty,
            /* ending inventory that will seed the recursion */
            COALESCE( SUM(p."qty"), 0 )
          - COALESCE( SUM(ms."qty"), 0 )          AS end_inv
        FROM "PM" pm
        LEFT JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES"      p
               ON p."product_id" = pm."product_id"
              AND TO_DATE(p."purchased") <= TO_DATE('2018-12-31')
        LEFT JOIN ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"  ms
               ON ms."product_id" = pm."product_id"
              AND TO_DATE(ms."mth")      <= TO_DATE('2018-12-01')
        GROUP BY pm."product_id", pm."qty_minimum", pm."qty_purchase"
    ),

    /* 12 calendar months of 2019 (1-Jan through 1-Dec) */
    "MONTHS_2019" AS (
        SELECT DATEADD(month, SEQ4(), TO_DATE('2019-01-01')) AS mth
        FROM   TABLE(GENERATOR(ROWCOUNT => 12))
    ),

    /*----------------------------------------------------
      Recursive calculation of month-by-month inventory
      ----------------------------------------------------*/
    RECURSIVE inv (product_id, qty_minimum, qty_purchase, mth, end_inv) AS (

        /*  Seed row : inventory at 2018-12-01 (end of Dec-18) */
        SELECT  d."product_id",
                d."qty_minimum",
                d."qty_purchase",
                TO_DATE('2018-12-01')          AS mth,
                d.end_inv                      AS end_inv
        FROM    "DEC_END" d

        UNION ALL

        /*  Forward one month at a time through 2019 */
        SELECT
            i."product_id",
            i."qty_minimum",
            i."qty_purchase",
            DATEADD(month, 1, i.mth)           AS mth,      -- next month
            CASE
                 /* subtract this month’s sales, then restock if needed */
                 WHEN i.end_inv - COALESCE(ms."qty",0)
                      <  i."qty_minimum"
                 THEN i.end_inv - COALESCE(ms."qty",0)
                      + i."qty_purchase"
                 ELSE i.end_inv - COALESCE(ms."qty",0)
            END                                   AS end_inv
        FROM   inv  i
        JOIN   "MONTHS_2019"  m
               ON DATEADD(month, 1, i.mth) = m.mth
        LEFT  JOIN ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES" ms
               ON ms."product_id" = i."product_id"
              AND TO_DATE(ms."mth") = m.mth
        /* stop when we have reached December 2019 */
        WHERE  i.mth < TO_DATE('2019-12-01')
    ),

    /* keep only the 2019 rows produced by the recursion */
    "INV_2019" AS (
        SELECT *
        FROM   inv
        WHERE  mth BETWEEN TO_DATE('2019-01-01') AND TO_DATE('2019-12-01')
    ),

    /* pick the month whose ending inventory is closest to the minimum */
    ranked AS (
        SELECT
            product_id,
            mth,
            qty_minimum,
            end_inv,
            ABS(end_inv - qty_minimum)          AS abs_diff,
            ROW_NUMBER() OVER (
                PARTITION BY product_id
                ORDER BY ABS(end_inv - qty_minimum), mth
            )                                   AS rn
        FROM  "INV_2019"
    )

/*----------------------------------------------------------
  Final answer
----------------------------------------------------------*/
SELECT
    product_id,
    TO_CHAR(mth, 'YYYY-MM')   AS month_2019,
    abs_diff                  AS abs_difference
FROM   ranked
WHERE  rn = 1
ORDER BY product_id;
```
