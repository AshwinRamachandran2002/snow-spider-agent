----------------------------------------------------------*/
DEC_END AS (
    SELECT
        pm.PRODUCT_ID,
        pm.QTY_MINIMUM,
        pm.QTY_PURCHASE,
        COALESCE(SUM(p.QTY), 0)  AS BOUGHT_QTY,
        COALESCE(SUM(ms.QTY),0)  AS SOLD_QTY,
        COALESCE(SUM(p.QTY), 0) - COALESCE(SUM(ms.QTY),0) AS END_INV
    FROM PM  pm
    LEFT JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES      p
           ON p.PRODUCT_ID = pm.PRODUCT_ID
          AND TO_DATE(p.PURCHASED) <= DATE '2018-12-31'
    LEFT JOIN ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES  ms
           ON ms.PRODUCT_ID = pm.PRODUCT_ID
          AND TO_DATE(ms.MTH)      <= DATE '2018-12-01'
    GROUP BY pm.PRODUCT_ID, pm.QTY_MINIMUM, pm.QTY_PURCHASE
),
/*----------------------------------------------------------
  3) All twelve months of 2019
----------------------------------------------------------*/
MONTHS_2019 AS (
    SELECT DATEADD(month, SEQ4(), DATE '2019-01-01') AS MTH
    FROM TABLE(GENERATOR(ROWCOUNT => 12))
),
/*----------------------------------------------------------
  4) Recursive month-by-month inventory calculation
----------------------------------------------------------*/
INV (PRODUCT_ID, QTY_MINIMUM, QTY_PURCHASE, MTH, END_INV) AS (
    /* Anchor row : 2018-12-01 */
    SELECT
        d.PRODUCT_ID,
        d.QTY_MINIMUM,
        d.QTY_PURCHASE,
        DATE '2018-12-01'        AS MTH,
        d.END_INV                AS END_INV
    FROM DEC_END d

    UNION ALL

    /* Recursive step : advance one month */
    SELECT
        i.PRODUCT_ID,
        i.QTY_MINIMUM,
        i.QTY_PURCHASE,
        DATEADD(month, 1, i.MTH)                                  AS MTH,
        CASE
             WHEN i.END_INV - COALESCE(ms.QTY,0) < i.QTY_MINIMUM
             THEN i.END_INV - COALESCE(ms.QTY,0) + i.QTY_PURCHASE
             ELSE i.END_INV - COALESCE(ms.QTY,0)
        END                                                       AS END_INV
    FROM INV i
    JOIN MONTHS_2019 m
         ON DATEADD(month, 1, i.MTH) = m.MTH
    LEFT JOIN ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES ms
           ON ms.PRODUCT_ID = i.PRODUCT_ID
          AND TO_DATE(ms.MTH) = m.MTH
    WHERE i.MTH < DATE '2019-12-01'        -- last recursion produces 2019-12-01
),
/*----------------------------------------------------------
  5) Keep only the months inside 2019
----------------------------------------------------------*/
INV_2019 AS (
    SELECT *
    FROM INV
    WHERE MTH BETWEEN DATE '2019-01-01' AND DATE '2019-12-01'
),
