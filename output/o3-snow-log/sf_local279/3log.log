/*-----------------------------------------------------------
  Recursive monthly inventory forecast for 2019
  – start with physical stock assumed to be the 31-Dec-2018
    quantity found in ORACLE_SQL.ORACLE_SQL.INVENTORY
  – for every month:   end = start – sales
                       if end < minimum  ⇒  end := end + qty_purchase
  – capture absolute difference to minimum and, per product,
    keep the month where that difference is smallest
-----------------------------------------------------------*/
WITH
/* 1. safety-stock rules */
min_rules AS (
    SELECT
        "product_id",
        "qty_minimum",
        "qty_purchase"
    FROM ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS
),

/* 2. starting inventory (used as 31-Dec-2018 closing balance) */
start_inv AS (
    SELECT
        "product_id",
        COALESCE(SUM("qty"),0)           AS qty_end_2018
    FROM ORACLE_SQL.ORACLE_SQL.INVENTORY
    GROUP BY "product_id"
),

/* 3. sales registered for 2019 (one row per product & month) */
sales_2019 AS (
    SELECT
        "product_id",
        TO_DATE("mth")                   AS mth,
        SUM("qty")                       AS sales_qty
    FROM ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
    WHERE "mth" BETWEEN '2019-01-01' AND '2019-12-31'
    GROUP BY "product_id", TO_DATE("mth")
),

/* 4. month series for the twelve months of 2019 */
months_2019 AS (
    SELECT DATEADD(month, seq4(), TO_DATE('2019-01-01')) AS mth
    FROM TABLE(GENERATOR(ROWCOUNT => 12))
),

/* 5. Cartesian list of every product (with min rule) and every month */
prod_months AS (
    SELECT
        mr."product_id",
        m.mth,
        mr."qty_minimum",
        mr."qty_purchase"
    FROM min_rules mr
    CROSS JOIN months_2019 m
),

/* 6. initial (January-2019) state to seed the recursion */
initial_state AS (
    SELECT
        pm."product_id",
        pm.mth,
        pm."qty_minimum",
        pm."qty_purchase",
        COALESCE(si.qty_end_2018,0)      AS start_inventory,
        COALESCE(s19.sales_qty,0)        AS sales_qty
    FROM prod_months          pm
    LEFT JOIN start_inv       si  ON si."product_id" = pm."product_id"
    LEFT JOIN sales_2019      s19 ON s19."product_id" = pm."product_id"
                                 AND s19.mth          = pm.mth
    WHERE pm.mth = '2019-01-01'
),

/*-----------------------------------------------------------
  7. recursive month-by-month inventory calculation
-----------------------------------------------------------*/
inventory_recursive AS (

    /* anchor : January 2019 */
    SELECT
        ist."product_id",
        ist.mth,
        ist."qty_minimum",
        ist."qty_purchase",
        ist.start_inventory                  AS inventory_start,
        ist.sales_qty,
        CASE
             WHEN ist.start_inventory - ist.sales_qty < ist."qty_minimum"
             THEN ist.start_inventory - ist.sales_qty + ist."qty_purchase"
             ELSE ist.start_inventory - ist.sales_qty
        END                                   AS inventory_end
    FROM initial_state ist

    UNION ALL

    /* recursive part : February-2019 … December-2019 */
    SELECT
        pm."product_id",
        pm.mth,
        pm."qty_minimum",
        pm."qty_purchase",
        ir.inventory_end                     AS inventory_start,
        COALESCE(s19.sales_qty,0)            AS sales_qty,
        CASE
             WHEN ir.inventory_end - COALESCE(s19.sales_qty,0) < pm."qty_minimum"
             THEN ir.inventory_end - COALESCE(s19.sales_qty,0) + pm."qty_purchase"
             ELSE ir.inventory_end - COALESCE(s19.sales_qty,0)
        END                                   AS inventory_end
    FROM inventory_recursive ir
    JOIN prod_months       pm  ON pm."product_id" = ir."product_id"
                              AND pm.mth          = DATEADD(month, 1, ir.mth)
    LEFT JOIN sales_2019   s19 ON s19."product_id" = pm."product_id"
                              AND s19.mth          = pm.mth
),

/* 8. absolute difference between ending stock and minimum */
differences AS (
    SELECT
        "product_id",
        mth,
        ABS(inventory_end - "qty_minimum")   AS abs_diff
    FROM inventory_recursive
)

/* 9. pick, per product, the month with the smallest deviation */
SELECT
    "product_id",
    TO_CHAR(mth, 'YYYY-MM-01')               AS month_2019,
    abs_diff
FROM (
    SELECT
        d.*,
        ROW_NUMBER() OVER (PARTITION BY "product_id"
                           ORDER BY abs_diff ASC, mth) AS rn
    FROM differences d
)
WHERE rn = 1
ORDER BY "product_id";
```
