```sql
--Description: 10) (One-shot) Calculate, per product, the 2019 month whose ending stock is closest to the minimum.
--This query illustrates the complete recursive logic tying together starting inventory, sales, restocks and minimums.
WITH
    start_inv AS (                              -- inventory as of 2018-12-31
        SELECT 
            p."product_id",
            COALESCE(SUM(p."qty"),0) AS "opening_qty"
        FROM ORACLE_SQL.ORACLE_SQL.PURCHASES p
        WHERE p."purchased" <= '2018-12-31'
        GROUP BY p."product_id"
    ),
    cal AS (                                    -- the 12 months in order
        SELECT 
            DATEADD(month, SEQ4(), '2019-01-01')::DATE AS "mth"
        FROM TABLE(GENERATOR(ROWCOUNT => 12))
    ),
    sales AS (                                  -- 2019 sales per product & month
        SELECT 
            "product_id",
            "mth"::DATE   AS "mth",
            SUM("qty")    AS "sales_qty"
        FROM ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
        WHERE "mth" BETWEEN '2019-01-01' AND '2019-12-31'
        GROUP BY "product_id", "mth"
    ),
    budgets AS (                                -- 2019 planned purchases
        SELECT 
            "product_id",
            "mth"::DATE  AS "mth",
            SUM("qty")   AS "buy_qty"
        FROM ORACLE_SQL.ORACLE_SQL.MONTHLY_BUDGET
        WHERE "mth" BETWEEN '2019-01-01' AND '2019-12-31'
        GROUP BY "product_id", "mth"
    ),
    min_rules AS (                              -- minimum / restock rules
        SELECT 
            "product_id",
            "qty_minimum",
            "qty_purchase"
        FROM ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS
    ),
    all_products AS (                           -- make sure every product appears in every month row
        SELECT DISTINCT s."product_id" FROM sales s
        UNION
        SELECT DISTINCT b."product_id" FROM budgets b
        UNION
        SELECT DISTINCT m."product_id" FROM min_rules m
    ),
/* -------------  recursive inventory walk ------------- */
    inv_by_month AS (
        SELECT      -- anchor for January 2019
            p."product_id",
            c."mth",
            si."opening_qty"                             AS "opening_qty",
            COALESCE(b."buy_qty",0)                      AS "planned_buy",
            0                                            AS "restock_qty",          -- evaluated later
            COALESCE(s."sales_qty",0)                    AS "sales_qty",
            NULL::FLOAT                                  AS "closing_qty"           -- evaluated later
        FROM all_products     p
        CROSS JOIN (SELECT * FROM cal WHERE "mth" = '2019-01-01') c
        LEFT  JOIN start_inv  si ON si."product_id" = p."product_id"
        LEFT  JOIN sales      s  ON s."product_id"      = p."product_id" AND s."mth" = c."mth"
        LEFT  JOIN budgets    b  ON b."product_id"      = p."product_id" AND b."mth" = c."mth"

        UNION ALL

        SELECT      -- subsequent months pick prior closing balance
            curr."product_id",
            c."mth",
            prev."closing_qty"                          AS "opening_qty",
            COALESCE(b."buy_qty",0)                     AS "planned_buy",
            0                                           AS "restock_qty",
            COALESCE(s."sales_qty",0)                   AS "sales_qty",
            NULL::FLOAT                                 AS "closing_qty"
        FROM inv_by_month         prev
        JOIN all_products         curr  ON curr."product_id" = prev."product_id"
        JOIN cal                  c     ON c."mth"           = DATEADD(month,1,prev."mth")
        LEFT JOIN sales           s     ON s."product_id"    = curr."product_id" AND s."mth" = c."mth"
        LEFT JOIN budgets         b     ON b."product_id"    = curr."product_id" AND b."mth" = c."mth"
        WHERE c."mth" <= '2019-12-01'
    ),
    calc AS (               -- work out closing stock + triggered restocks
        SELECT 
            m.*,
            r."qty_minimum",
            r."qty_purchase",
            CASE 
                WHEN (m."opening_qty" + m."planned_buy" - m."sales_qty") < r."qty_minimum"
                     THEN r."qty_purchase"
                     ELSE 0
            END                                       AS "restock_qty_final",
            (m."opening_qty" + m."planned_buy" - m."sales_qty" + 
                 CASE WHEN (m."opening_qty" + m."planned_buy" - m."sales_qty") < r."qty_minimum"
                          THEN r."qty_purchase" ELSE 0 END)              AS "closing_qty_final"
        FROM inv_by_month m
        JOIN min_rules   r ON r."product_id" = m."product_id"
    ),
    want AS (            -- distance to minimum each month
        SELECT
            "product_id",
            "mth",
            ABS("closing_qty_final" - "qty_minimum") AS "abs_diff"
        FROM calc
    ),
    ranked AS (          -- take the month with the smallest absolute difference
        SELECT 
            w.*,
            ROW_NUMBER() OVER (PARTITION BY "product_id" ORDER BY "abs_diff", "mth") AS rn
        FROM want w
    )
SELECT 
    "product_id",
    "mth"     AS "closest_month",
    "abs_diff"::NUMBER(10,2)  AS "smallest_gap_to_min"
FROM ranked
WHERE rn = 1
ORDER BY "product_id"
LIMIT 20;
```
