```sql
--Description: 10) One-shot inventory walk now anchored to 2016 (year with sales).  
--Rest of logic unchanged, but dates adjusted to 2016 to ensure data presence.
WITH
    start_inv AS (
        SELECT 
            p."product_id",
            COALESCE(SUM(p."qty"),0) AS "opening_qty"
        FROM ORACLE_SQL.ORACLE_SQL.PURCHASES p
        WHERE p."purchased" <= '2015-12-31'
        GROUP BY p."product_id"
    ),
    cal AS (
        SELECT DATEADD(month, SEQ4(), '2016-01-01')::DATE AS "mth"
        FROM TABLE(GENERATOR(ROWCOUNT => 12))
    ),
    sales AS (
        SELECT 
            "product_id",
            "mth"::DATE AS "mth",
            SUM("qty")  AS "sales_qty"
        FROM ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
        WHERE "mth" BETWEEN '2016-01-01' AND '2016-12-31'
        GROUP BY "product_id", "mth"
    ),
    budgets AS (           -- keep 2016 even if mostly zero
        SELECT 
            "product_id",
            "mth"::DATE AS "mth",
            SUM("qty")  AS "buy_qty"
        FROM ORACLE_SQL.ORACLE_SQL.MONTHLY_BUDGET
        WHERE "mth" BETWEEN '2016-01-01' AND '2016-12-31'
        GROUP BY "product_id", "mth"
    ),
    min_rules AS (
        SELECT 
            "product_id",
            "qty_minimum",
            "qty_purchase"
        FROM ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS
    ),
    all_products AS (
        SELECT DISTINCT s."product_id" FROM sales s
        UNION
        SELECT DISTINCT b."product_id" FROM budgets b
        UNION
        SELECT DISTINCT m."product_id" FROM min_rules m
    ),
    inv_by_month AS (
        SELECT
            p."product_id",
            c."mth",
            si."opening_qty",
            COALESCE(b."buy_qty",0) AS "planned_buy",
            COALESCE(s."sales_qty",0) AS "sales_qty"
        FROM all_products p
        CROSS JOIN (SELECT * FROM cal WHERE "mth" = '2016-01-01') c
        LEFT JOIN start_inv si ON si."product_id" = p."product_id"
        LEFT JOIN sales     s  ON s."product_id" = p."product_id" AND s."mth" = c."mth"
        LEFT JOIN budgets   b  ON b."product_id" = p."product_id" AND b."mth" = c."mth"
        UNION ALL
        SELECT
            prev."product_id",
            c."mth",
            prev_closing."closing_qty_final" AS "opening_qty",
            COALESCE(b."buy_qty",0),
            COALESCE(s."sales_qty",0)
        FROM inv_by_month prev
        JOIN all_products ap          ON ap."product_id" = prev."product_id"
        JOIN cal         c            ON c."mth" = DATEADD(month,1,prev."mth")
        LEFT JOIN sales  s            ON s."product_id" = ap."product_id" AND s."mth" = c."mth"
        LEFT JOIN budgets b           ON b."product_id" = ap."product_id" AND b."mth" = c."mth"
        JOIN LATERAL (                -- compute closing of prior month to feed forward
            SELECT
                CASE 
                    WHEN (prev."opening_qty" + prev."planned_buy" - prev."sales_qty") 
                         < mr."qty_minimum" THEN 
                         (prev."opening_qty" + prev."planned_buy" - prev."sales_qty") 
                         + mr."qty_purchase"
                    ELSE
                         (prev."opening_qty" + prev."planned_buy" - prev."sales_qty")
                END AS "closing_qty_final"
            FROM min_rules mr
            WHERE mr."product_id" = prev."product_id"
        ) prev_closing
        WHERE c."mth" <= '2016-12-01'
    ),
    calc AS (
        SELECT
            ibm.*,
            mr."qty_minimum",
            mr."qty_purchase",
            CASE
                WHEN (ibm."opening_qty" + ibm."planned_buy" - ibm."sales_qty") < mr."qty_minimum"
                     THEN mr."qty_purchase"
                     ELSE 0
            END AS "restock_qty",
            (ibm."opening_qty" + ibm."planned_buy" - ibm."sales_qty"
             + CASE
                   WHEN (ibm."opening_qty" + ibm."planned_buy" - ibm."sales_qty") < mr."qty_minimum"
                   THEN mr."qty_purchase" ELSE 0 END) AS "closing_qty_final"
        FROM inv_by_month ibm
        JOIN min_rules  mr ON mr."product_id" = ibm."product_id"
    ),
    ranked AS (
        SELECT
            "product_id",
            "mth",
            ABS("closing_qty_final" - "qty_minimum") AS "abs_diff",
            ROW_NUMBER() OVER (PARTITION BY "product_id" 
                               ORDER BY ABS("closing_qty_final" - "qty_minimum"), "mth") AS rn
        FROM calc
    )
SELECT
    "product_id",
    "mth"       AS "closest_month",
    "abs_diff"  AS "smallest_gap_to_min"
FROM ranked
WHERE rn = 1
ORDER BY "product_id"
LIMIT 20;
```
