--Description:  Starting inventory as of 2018-12-31
--Thinking process:
-- 1. We need each product’s on-hand quantity before the 2019 simulation begins.
-- 2. INVENTORY holds the stock units, but we only want those originating from
--    PURCHASES dated on or before 2018-12-31.  Therefore we join INVENTORY (i)
--    to PURCHASES (p) on PURCHASE_ID = ID, then filter p.PURCHASED.
-- 3. SUM(i.QTY) returns the total pieces per PRODUCT_ID.
-- 4. Unquoted identifiers are used so Snowflake automatically resolves them
--    in uppercase, avoiding the previous “invalid identifier” issue that
--    arose from mismatched quoted casing.
-- 5. Finally, GROUP BY PRODUCT_ID, order for visibility, and limit sample rows.
SELECT
       i.PRODUCT_ID,
       SUM(i.QTY) AS DEC_2018_QTY
FROM   ORACLE_SQL.ORACLE_SQL.INVENTORY  i
JOIN   ORACLE_SQL.ORACLE_SQL.PURCHASES  p
       ON p.ID = i.PURCHASE_ID
WHERE  p.PURCHASED <= '2018-12-31'
GROUP  BY i.PRODUCT_ID
ORDER  BY i.PRODUCT_ID
LIMIT  20;
