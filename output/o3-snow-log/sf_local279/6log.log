```sql
--Description:  Calculate per-product, per-month running inventory (non-recursive example)
SELECT
       x.PRODUCT_ID,
       x.MTH,
       x.STARTING_QTY - x.SALES_QTY + x.RESTOCK_QTY AS ENDING_QTY
FROM (
       SELECT
              m.PRODUCT_ID,
              m.MTH,
              COALESCE( LAG(m.STARTING_QTY - m.SALES_QTY + m.RESTOCK_QTY)
                        OVER (PARTITION BY m.PRODUCT_ID ORDER BY m.MTH),
                        inv.DEC_2018_QTY)              AS STARTING_QTY,
              m.SALES_QTY,
              m.RESTOCK_QTY
       FROM (
              SELECT
                     s.PRODUCT_ID,
                     s.MTH,
                     s.QTY                           AS SALES_QTY,
                     COALESCE( (SELECT SUM(pu.QTY)
                                FROM ORACLE_SQL.ORACLE_SQL.PURCHASES pu
                                WHERE pu.PRODUCT_ID = s.PRODUCT_ID
                                  AND pu.PURCHASED  = s.MTH), 0) AS RESTOCK_QTY,
                     0                                 AS STARTING_QTY  -- placeholder
              FROM   ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES s
              WHERE  s.MTH BETWEEN '2019-01-01' AND '2019-12-31'
            ) m
       JOIN (
              SELECT
                     i.PRODUCT_ID,
                     SUM(i.QTY) AS DEC_2018_QTY
              FROM   ORACLE_SQL.ORACLE_SQL.INVENTORY  i
              JOIN   ORACLE_SQL.ORACLE_SQL.PURCHASES  p
                     ON p.ID = i.PURCHASE_ID
              WHERE  p.PURCHASED <= '2018-12-31'
              GROUP  BY i.PRODUCT_ID
            ) inv
            ON inv.PRODUCT_ID = m.PRODUCT_ID
     ) x
ORDER  BY x.PRODUCT_ID, x.MTH
LIMIT  20;
```

```sql
--Description:  Identify, for each product, the 2019 month where ending inventory is closest to its minimum
WITH inv_start AS (   -- starting stock on 2018-12-31
