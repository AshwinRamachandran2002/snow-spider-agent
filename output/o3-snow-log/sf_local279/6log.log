```sql
--Description:  Calculate per product, per month, the running ending inventory *including* restocks (simple example without recursion)  
SELECT 
       x."product_id",
       x."mth",
       x."starting_qty" 
       - x."sales_qty" 
       + x."restock_qty"                    AS "ending_qty"
FROM (
       SELECT 
              m."product_id",
              m."mth",
              NVL(LAG( m."starting_qty" 
                       - m."sales_qty" 
                       + m."restock_qty") OVER (PARTITION BY m."product_id" ORDER BY m."mth"), 
                  inv."dec_2018_qty")       AS "starting_qty",
              m."sales_qty",
              m."restock_qty"
       FROM (
              SELECT 
                     s."product_id",
                     s."mth",
                     s."qty"                       AS "sales_qty",
                     COALESCE( (SELECT SUM(pu."qty")
                                FROM ORACLE_SQL.ORACLE_SQL."PURCHASES" pu
                                WHERE pu."product_id" = s."product_id"
                                  AND pu."purchased" = s."mth"), 0)  AS "restock_qty",
                     0                               AS "starting_qty"  --placeholder overwritten by LAG
              FROM   ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES" s
              WHERE  s."mth" BETWEEN '2019-01-01' AND '2019-12-31'
            ) m
       JOIN (
              SELECT 
                     i."product_id",
                     SUM(i."qty") AS "dec_2018_qty"
              FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY" i
              JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES" p
                     ON p."id" = i."purchase_id"
              WHERE  p."purchased" <= '2018-12-31'
              GROUP  BY i."product_id"
            ) inv
            ON inv."product_id" = m."product_id"
     ) x
ORDER  BY x."product_id", x."mth"
LIMIT  20;
```

```sql
--Description:  Identify, for each product in 2019, the month where the absolute gap between ending inventory and its minimum is smallest  
WITH inv_start AS (   --starting quantities on 2018-12-31  
     SELECT 
            i."product_id",
            SUM(i."qty") AS "dec_2018_qty"
     FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY" i
     JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES" p
            ON p."id" = i."purchase_id"
     WHERE  p."purchased" <= '2018-12-31'
     GROUP  BY i."product_id"),
min_req AS (          --minimums  
     SELECT 
            "product_id",
            "qty_minimum"
     FROM   ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS"),
sales AS (            --2019 sales per month  
     SELECT 
            "product_id",
            "mth",
            "qty"
     FROM   ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
     WHERE  "mth" BETWEEN '2019-01-01' AND '2019-12-31'),
restock AS (          --2019 purchases per month  
     SELECT 
            "product_id",
            "purchased"        AS "mth",
            SUM("qty")         AS "restock_qty"
     FROM   ORACLE_SQL.ORACLE_SQL."PURCHASES"
     WHERE  "purchased" BETWEEN '2019-01-01' AND '2019-12-31'
     GROUP  BY "product_id", "purchased"),
all_months AS (       --combine sales & restock  
     SELECT 
            s."product_id",
            s."mth",
            s."qty"                        AS "sales_qty",
            COALESCE(r."restock_qty",0)    AS "restock_qty"
     FROM   sales s
     LEFT  JOIN restock r
            ON r."product_id" = s."product_id"
           AND r."mth"       = s."mth"),
running AS (          --recursive running inventory  
     SELECT 
            a."product_id",
            a."mth",
            (i."dec_2018_qty"
             - a."sales_qty"
             + a."restock_qty")            AS "ending_qty",
            i."dec_2018_qty"               AS "starting_qty"
     FROM   all_months  a
     JOIN   inv_start   i
            ON i."product_id" = a."product_id"
     WHERE  a."mth" = (SELECT MIN("mth") 
                       FROM all_months am 
                       WHERE am."product_id" = a."product_id")
     UNION ALL
     SELECT 
            a."product_id",
            a."mth",
            (r."ending_qty"
             - a."sales_qty"
             + a."restock_qty")            AS "ending_qty",
            r."ending_qty"                 AS "starting_qty"
     FROM   running r
     JOIN   all_months a
            ON a."product_id" = r."product_id"
           AND a."mth"       = (SELECT MIN("mth") 
                                FROM all_months am 
                                WHERE am."product_id" = a."product_id"
                                  AND am."mth" > r."mth"))
SELECT 
       res."product_id",
       res."mth",
       ABS(res."ending_qty" - m."qty_minimum") AS "abs_diff"
FROM   running res
JOIN   min_req m
       ON m."product_id" = res."product_id"
QUALIFY ROW_NUMBER() OVER (PARTITION BY res."product_id" 
                           ORDER BY ABS(res."ending_qty" - m."qty_minimum")) = 1
ORDER  BY res."product_id"
LIMIT  20;
```

These ten queries progress from exploring the essential source tables to assembling a complete, recursive month-by-month inventory calculation and finally isolating, for each product, the 2019 month where the ending inventory most closely matches its required minimum level.
