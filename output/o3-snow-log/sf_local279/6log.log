     FROM   ORACLE_SQL.ORACLE_SQL.INVENTORY  i
     JOIN   ORACLE_SQL.ORACLE_SQL.PURCHASES  p
            ON p.ID = i.PURCHASE_ID
     WHERE  p.PURCHASED <= '2018-12-31'
     GROUP  BY i.PRODUCT_ID),
min_req AS (          -- minimum levels
     SELECT
            PRODUCT_ID,
            QTY_MINIMUM
     FROM   ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS),
sales AS (            -- 2019 sales
     SELECT
            PRODUCT_ID,
            MTH,
            QTY
     FROM   ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
     WHERE  MTH BETWEEN '2019-01-01' AND '2019-12-31'),
restock AS (          -- 2019 purchases (restocks)
     SELECT
            PRODUCT_ID,
            PURCHASED        AS MTH,
            SUM(QTY)         AS RESTOCK_QTY
     FROM   ORACLE_SQL.ORACLE_SQL.PURCHASES
     WHERE  PURCHASED BETWEEN '2019-01-01' AND '2019-12-31'
     GROUP  BY PRODUCT_ID, PURCHASED),
all_months AS (       -- combine sales & restock
     SELECT
            s.PRODUCT_ID,
            s.MTH,
            s.QTY                        AS SALES_QTY,
            COALESCE(r.RESTOCK_QTY,0)    AS RESTOCK_QTY
     FROM   sales s
     LEFT  JOIN restock r
            ON r.PRODUCT_ID = s.PRODUCT_ID
           AND r.MTH        = s.MTH),
running AS (          -- recursive running inventory
     SELECT
            a.PRODUCT_ID,
            a.MTH,
            (i.DEC_2018_QTY - a.SALES_QTY + a.RESTOCK_QTY) AS ENDING_QTY,
            i.DEC_2018_QTY                                 AS STARTING_QTY
     FROM   all_months a
     JOIN   inv_start  i
            ON i.PRODUCT_ID = a.PRODUCT_ID
     WHERE  a.MTH = (SELECT MIN(MTH)
                     FROM all_months am
                     WHERE am.PRODUCT_ID = a.PRODUCT_ID)
     UNION ALL
     SELECT
            a.PRODUCT_ID,
            a.MTH,
            (r.ENDING_QTY - a.SALES_QTY + a.RESTOCK_QTY)   AS ENDING_QTY,
            r.ENDING_QTY                                   AS STARTING_QTY
     FROM   running     r
     JOIN   all_months  a
            ON a.PRODUCT_ID = r.PRODUCT_ID
           AND a.MTH       = (SELECT MIN(MTH)
                              FROM all_months am
                              WHERE am.PRODUCT_ID = a.PRODUCT_ID
                                AND am.MTH > r.MTH))
SELECT
       res.PRODUCT_ID,
       res.MTH,
       ABS(res.ENDING_QTY - m.QTY_MINIMUM) AS ABS_DIFF
FROM   running res
JOIN   min_req m
       ON m.PRODUCT_ID = res.PRODUCT_ID
QUALIFY ROW_NUMBER() OVER (PARTITION BY res.PRODUCT_ID
                           ORDER BY ABS(res.ENDING_QTY - m.QTY_MINIMUM)) = 1
ORDER  BY res.PRODUCT_ID
LIMIT  20;
```
