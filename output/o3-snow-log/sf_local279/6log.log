```sql
--Description:  Show 2019 ending inventory levels **after** subtracting year-to-date sales but **before** any new purchases, for quick sanity check  
SELECT 
       inv."product_id",
       inv."dec_2018_qty" - NVL(sales."ytd_sales",0) AS "pre_restock_eoy_2019_qty"
FROM (
        SELECT 
               i."product_id",
               SUM(i."qty") AS "dec_2018_qty"
        FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY" i
        JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES" p
               ON p."id" = i."purchase_id"
        WHERE  p."purchased" <= '2018-12-31'
        GROUP  BY i."product_id"
     ) inv
LEFT JOIN (
        SELECT 
               "product_id",
               SUM("qty") AS "ytd_sales"
        FROM   ORACLE_SQL.ORACLE_SQL."MONTHLY_SALES"
        WHERE  "mth" BETWEEN '2019-01-01' AND '2019-12-31'
        GROUP  BY "product_id"
     ) sales
     ON sales."product_id" = inv."product_id"
ORDER  BY inv."product_id"
LIMIT  20;
