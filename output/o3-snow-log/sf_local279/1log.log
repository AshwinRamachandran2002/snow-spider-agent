```sql
--Description: 2)  Inspect current on–hand inventory (qty still in stock) together with the purchase record that created it
SELECT i."id"       AS "inventory_id",
       i."product_id",
       i."qty",
       p."purchased"   AS "purchase_date",
       p."qty"         AS "purchase_qty"
FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY"      i
JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"      p
       ON i."purchase_id" = p."id"
LIMIT 20;
```

```sql
--Description: 3)  Find December-2018 purchases – they provide the starting inventory position for the 2019 recursion
SELECT p."id"          AS "purchase_id",
       p."product_id",
       p."qty",
       p."purchased"
FROM   ORACLE_SQL.ORACLE_SQL."PURCHASES" p
WHERE  p."purchased" BETWEEN '2018-12-01' AND '2018-12-31'
LIMIT 20;
```

```sql
--Description: 4)  Show every sales order-line executed in calendar-year 2019 (product, qty, order reference)
SELECT ol."id"          AS "orderline_id",
       ol."order_id",
       ol."product_id",
       ol."qty"
FROM   ORACLE_SQL.ORACLE_SQL."ORDERLINES"  ol
JOIN   ORACLE_SQL.ORACLE_SQL."ORDERS"      o
       ON ol."order_id" = o."id"
WHERE  o."ordered" BETWEEN '2019-01-01' AND '2019-12-31'
LIMIT 20;
```

```sql
--Description: 5)  Summarise 2019 purchases by product & month (these will be added to inventory)
SELECT p."product_id",
       TO_CHAR(p."purchased", 'YYYY-MM')  AS "month",
       SUM(p."qty")                       AS "purchased_qty"
FROM   ORACLE_SQL.ORACLE_SQL."PURCHASES" p
WHERE  p."purchased" BETWEEN '2019-01-01' AND '2019-12-31'
GROUP  BY p."product_id", TO_CHAR(p."purchased", 'YYYY-MM')
LIMIT 20;
```

```sql
--Description: 6)  Summarise 2019 sales (qty leaving inventory) by product & month
SELECT ol."product_id",
       TO_CHAR(o."ordered", 'YYYY-MM')    AS "month",
       SUM(ol."qty")                      AS "sold_qty"
FROM   ORACLE_SQL.ORACLE_SQL."ORDERLINES"  ol
JOIN   ORACLE_SQL.ORACLE_SQL."ORDERS"      o
       ON ol."order_id" = o."id"
WHERE  o."ordered" BETWEEN '2019-01-01' AND '2019-12-31'
GROUP  BY ol."product_id", TO_CHAR(o."ordered", 'YYYY-MM')
LIMIT 20;
```

```sql
--Description: 7)  Calculate starting on-hand balance per product at 2018-12-31 (sum of qty from purchases up to that date)
WITH inv AS (
  SELECT i."product_id", SUM(i."qty") AS "on_hand"
  FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY" i
  JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES" p
         ON i."purchase_id" = p."id"
  WHERE  p."purchased" <= '2018-12-31'
  GROUP  BY i."product_id"
)
SELECT *
FROM   inv
LIMIT 20;
```

```sql
--Description: 8)  Bring together starting balance, monthly purchases and monthly sales to build a month-by-month net change table
WITH start_bal AS (
  SELECT i."product_id", SUM(i."qty") AS "start_qty"
  FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY" i
  JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES" p
         ON i."purchase_id" = p."id"
  WHERE  p."purchased" <= '2018-12-31'
  GROUP  BY i."product_id"
),
purch AS (
  SELECT p."product_id",
         TO_CHAR(p."purchased", 'YYYY-MM') AS "month",
         SUM(p."qty")                      AS "purchased_qty"
  FROM   ORACLE_SQL.ORACLE_SQL."PURCHASES" p
  WHERE  p."purchased" BETWEEN '2019-01-01' AND '2019-12-31'
  GROUP  BY p."product_id", TO_CHAR(p."purchased", 'YYYY-MM')
),
sales AS (
  SELECT ol."product_id",
         TO_CHAR(o."ordered", 'YYYY-MM')   AS "month",
         SUM(ol."qty")                     AS "sold_qty"
  FROM   ORACLE_SQL.ORACLE_SQL."ORDERLINES"  ol
  JOIN   ORACLE_SQL.ORACLE_SQL."ORDERS"      o
         ON ol."order_id" = o."id"
  WHERE  o."ordered" BETWEEN '2019-01-01' AND '2019-12-31'
  GROUP  BY ol."product_id", TO_CHAR(o."ordered", 'YYYY-MM')
)
SELECT COALESCE(purch."product_id", sales."product_id") AS "product_id",
       COALESCE(purch."month",  sales."month")          AS "month",
       COALESCE(purch."purchased_qty", 0)               AS "purchases",
       COALESCE(sales."sold_qty",      0)               AS "sales"
FROM   purch
FULL   JOIN sales
       ON purch."product_id" = sales."product_id"
      AND purch."month"      = sales."month"
ORDER  BY "product_id", "month"
LIMIT 20;
```

```sql
--Description: 9)  Recursively apply “previous ending + purchases – sales” to get each month’s ending inventory, then compare with minimum
WITH start_bal AS (
  SELECT i."product_id", SUM(i."qty") AS "start_qty"
  FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY" i
  JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES" p
         ON i."purchase_id" = p."id"
  WHERE  p."purchased" <= '2018-12-31'
  GROUP  BY i."product_id"
),
calendar AS (
  SELECT '2019-01' AS "month" UNION ALL SELECT '2019-02' UNION ALL
  SELECT '2019-03' UNION ALL SELECT '2019-04' UNION ALL
  SELECT '2019-05' UNION ALL SELECT '2019-06' UNION ALL
  SELECT '2019-07' UNION ALL SELECT '2019-08' UNION ALL
  SELECT '2019-09' UNION ALL SELECT '2019-10' UNION ALL
  SELECT '2019-11' UNION ALL SELECT '2019-12'
),
movements AS (  --net change per product & month
  SELECT COALESCE(purch."product_id", sales."product_id") AS "product_id",
         cal."month",
         COALESCE(purch."purchased_qty", 0)               AS "purchases",
         COALESCE(sales."sold_qty",      0)               AS "sales"
  FROM calendar cal
  LEFT JOIN ( SELECT p."product_id",
                     TO_CHAR(p."purchased", 'YYYY-MM') AS "month",
                     SUM(p."qty")                      AS "purchased_qty"
              FROM ORACLE_SQL.ORACLE_SQL."PURCHASES" p
              WHERE p."purchased" BETWEEN '2019-01-01' AND '2019-12-31'
              GROUP BY p."product_id", TO_CHAR(p."purchased", 'YYYY-MM')
            ) purch
         ON purch."month" = cal."month"
  LEFT JOIN ( SELECT ol."product_id",
                     TO_CHAR(o."ordered", 'YYYY-MM')  AS "month",
                     SUM(ol."qty")                    AS "sold_qty"
              FROM ORACLE_SQL.ORACLE_SQL."ORDERLINES" ol
              JOIN ORACLE_SQL.ORACLE_SQL."ORDERS"     o
                   ON ol."order_id" = o."id"
              WHERE o."ordered" BETWEEN '2019-01-01' AND '2019-12-31'
              GROUP BY ol."product_id", TO_CHAR(o."ordered", 'YYYY-MM')
            ) sales
         ON sales."product_id" = purch."product_id"
        AND sales."month"      = cal."month"
)
SELECT m."product_id",
       m."month",
       /* running total start_qty + Σ(purchases - sales) over months */
       SUM( COALESCE(m."purchases",0) - COALESCE(m."sales",0) )
         OVER (PARTITION BY m."product_id" ORDER BY m."month"
               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) 
       + COALESCE(s."start_qty",0)                      AS "ending_inventory",
       pm."qty_minimum"
FROM   movements m
JOIN   start_bal  s  ON m."product_id" = s."product_id"
JOIN   ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS" pm
       ON pm."product_id" = m."product_id"
ORDER  BY m."product_id", m."month"
LIMIT 20;
```

```sql
--Description: 10)  For each product, pick the 2019 month where the absolute gap between ending inventory and minimum is smallest
WITH start_bal AS (
  SELECT i."product_id", SUM(i."qty") AS "start_qty"
  FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY" i
  JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES" p
         ON i."purchase_id" = p."id"
  WHERE  p."purchased" <= '2018-12-31'
  GROUP  BY i."product_id"
),
calendar AS (
  SELECT '2019-01' AS "month" UNION ALL SELECT '2019-02' UNION ALL
  SELECT '2019-03' UNION ALL SELECT '2019-04' UNION ALL
  SELECT '2019-05' UNION ALL SELECT '2019-06' UNION ALL
  SELECT '2019-07' UNION ALL SELECT '2019-08' UNION ALL
  SELECT '2019-09' UNION ALL SELECT '2019-10' UNION ALL
  SELECT '2019-11' UNION ALL SELECT '2019-12'
),
movements AS (
  SELECT COALESCE(purch."product_id", sales."product_id") AS "product_id",
         cal."month",
         COALESCE(purch."purchased_qty", 0)               AS "purchases",
         COALESCE(sales."sold_qty",      0)               AS "sales"
  FROM calendar cal
  LEFT JOIN ( SELECT p."product_id",
                     TO_CHAR(p."purchased", 'YYYY-MM') AS "month",
                     SUM(p."qty")                      AS "purchased_qty"
              FROM ORACLE_SQL.ORACLE_SQL."PURCHASES" p
              WHERE p."purchased" BETWEEN '2019-01-01' AND '2019-12-31'
              GROUP BY p."product_id", TO_CHAR(p."purchased", 'YYYY-MM')
            ) purch
         ON purch."month" = cal."month"
  LEFT JOIN ( SELECT ol."product_id",
                     TO_CHAR(o."ordered", 'YYYY-MM')  AS "month",
                     SUM(ol."qty")                    AS "sold_qty"
              FROM ORACLE_SQL.ORACLE_SQL."ORDERLINES" ol
              JOIN ORACLE_SQL.ORACLE_SQL."ORDERS"     o
                   ON ol."order_id" = o."id"
              WHERE o."ordered" BETWEEN '2019-01-01' AND '2019-12-31'
              GROUP BY ol."product_id", TO_CHAR(o."ordered", 'YYYY-MM')
            ) sales
         ON sales."product_id" = purch."product_id"
        AND sales."month"      = cal."month"
),
running AS (
  SELECT m."product_id",
         m."month",
         SUM( COALESCE(m."purchases",0) - COALESCE(m."sales",0) )
           OVER (PARTITION BY m."product_id" ORDER BY m."month"
                 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) 
         + COALESCE(s."start_qty",0)                    AS "ending_inventory"
  FROM   movements m
  JOIN   start_bal  s  ON m."product_id" = s."product_id"
),
compare AS (
  SELECT r."product_id",
         r."month",
         ABS(r."ending_inventory" - pm."qty_minimum")   AS "abs_gap"
  FROM   running r
  JOIN   ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS" pm
         ON pm."product_id" = r."product_id"
)
SELECT c."product_id",
       c."month"  AS "best_month",
       c."abs_gap"
FROM   (
        SELECT c.*,
               ROW_NUMBER() OVER
                 (PARTITION BY c."product_id" ORDER BY c."abs_gap") AS rn
        FROM   compare c
       ) c
WHERE  c.rn = 1
LIMIT 20;
```
