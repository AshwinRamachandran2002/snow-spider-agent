```sql
/*-------------------------------------------------------------
  For every product that has a minimum-stock definition we
  1)  calculate the inventory on 2018-12-31  (= sum(purchases)
      to that date  –  sum(sales) to 2018-12)
  2)  simulate month by month through 2019
        opening  = previous month’s ending
        ending-pre = opening – month-sales
        if ending-pre < minimum   then restock by qty_purchase
        ending = ending-pre  (+ qty_purchase when restocked)
  3)  pick the 2019 month in which |ending – minimum| is smallest
--------------------------------------------------------------*/
WITH
/*---  starting inventory per product as of 2018-12-31 ----------*/
start_inv AS (
    SELECT
        pm."product_id",
        /* net stock up to 2018-12-31 */
        COALESCE(SUM(CASE
                       WHEN p."id" IS NOT NULL THEN p."qty"
                       ELSE 0
                     END),0)                               AS purchased_qty,
        COALESCE(SUM(CASE
                       WHEN s."qty" IS NOT NULL THEN s."qty"
                       ELSE 0
                     END),0)                               AS sold_qty,
        COALESCE(SUM(CASE
                       WHEN p."id" IS NOT NULL THEN p."qty"
                       ELSE 0
                     END),0)
      - COALESCE(SUM(CASE
                       WHEN s."qty" IS NOT NULL THEN s."qty"
                       ELSE 0
                     END),0)                               AS opening_inventory
    FROM ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS pm
    /* purchases up to 2018-12-31 */
    LEFT JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES p
           ON p."product_id" = pm."product_id"
          AND TO_DATE(p."purchased") <= '2018-12-31'
    /* sales up to and including 2018-12 (date stored as first of month) */
    LEFT JOIN ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES s
           ON s."product_id" = pm."product_id"
          AND TO_DATE(s."mth") <= '2018-12-01'
    GROUP BY pm."product_id"
),
/*---  sales for 2019 (missing rows treated as zero) -------------*/
sales19 AS (
    SELECT
        "product_id",
        TO_DATE("mth")         AS mth,
        "qty"
    FROM ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
    WHERE TO_DATE("mth") >= '2019-01-01'
      AND TO_DATE("mth") <  '2020-01-01'
),
/*---  recursive simulation of 2019 monthly inventory ------------*/
inventory(product_id, mth, ending_inventory) AS (
    /* anchor : January 2019 */
    SELECT
        pm."product_id",
        TO_DATE('2019-01-01')                        AS mth,
        /* ending inventory after possible restock */
        CASE
            WHEN (si.opening_inventory
                  - COALESCE(s19."qty",0)) < pm."qty_minimum"
            THEN (si.opening_inventory
                  - COALESCE(s19."qty",0))
                 + pm."qty_purchase"
            ELSE (si.opening_inventory
                  - COALESCE(s19."qty",0))
        END                                          AS ending_inventory
    FROM start_inv              si
    JOIN ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS pm
         ON pm."product_id" = si."product_id"
    LEFT JOIN sales19           s19
         ON s19."product_id" = pm."product_id"
        AND s19.mth            = TO_DATE('2019-01-01')

    UNION ALL

    /* recursive part : the next month */
    SELECT
        inv."product_id",
        DATEADD(month,1,inv.mth)                     AS mth,
        CASE
            WHEN (inv.ending_inventory
                  - COALESCE(s19."qty",0)) < pm."qty_minimum"
            THEN (inv.ending_inventory
                  - COALESCE(s19."qty",0))
                 + pm."qty_purchase"
            ELSE (inv.ending_inventory
                  - COALESCE(s19."qty",0))
        END                                          AS ending_inventory
    FROM inventory                 inv
    JOIN ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS pm
         ON pm."product_id" = inv."product_id"
    LEFT JOIN sales19              s19
         ON s19."product_id" = inv."product_id"
        AND s19.mth            = DATEADD(month,1,inv.mth)
    WHERE inv.mth < '2019-12-01'   /* stop after producing December */
),
/*---  compute absolute difference to minimum each month --------*/
diffs AS (
    SELECT
        inv."product_id",
        inv.mth,
        ABS(inv.ending_inventory - pm."qty_minimum") AS abs_diff,
        ROW_NUMBER() OVER (
            PARTITION BY inv."product_id"
            ORDER BY ABS(inv.ending_inventory - pm."qty_minimum"),
                     inv.mth          /* earliest month on ties */
        )                                              AS rn
    FROM inventory inv
    JOIN ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS pm
         ON pm."product_id" = inv."product_id"
)
/*---  final answer ---------------------------------------------*/
SELECT
    "product_id",
    TO_CHAR(mth,'YYYY-MM')  AS month_with_smallest_gap,
    abs_diff                AS absolute_difference
FROM diffs
WHERE rn = 1
ORDER BY "product_id";
```
