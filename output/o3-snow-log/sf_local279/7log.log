```sql
--Description: Demonstrate a recursive CTE that derives month-end inventory for product 6520 only
WITH RECURSIVE inv AS (
    --Seed: ending balance December 2018 (use 0 when no Dec-2018 balance is found)
    SELECT 
        6520                   AS product_id,
        '2018-12'              AS ym,
        COALESCE( (
            SELECT SUM(i."qty")
            FROM ORACLE_SQL.ORACLE_SQL.INVENTORY i
            JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES p
              ON i."purchase_id" = p."id"
            WHERE i."product_id" = 6520
              AND p."purchased" ILIKE '2018-12-%'
        ), 0 )                 AS ending_inv
    UNION ALL
    --Recurse month by month through 2019
    SELECT
        r.product_id,
        TO_CHAR( DATEADD(month, 1, r.ym || '-01' ), 'YYYY-MM')                 AS ym,
        r.ending_inv                                                       -- opening
        - COALESCE(s.sold, 0)                                              -- minus sales
        + CASE                                                             -- plus purchases (only when restocking triggered)
              WHEN r.ending_inv - COALESCE(s.sold,0) < m."qty_minimum"
              THEN m."qty_purchase"
              ELSE 0
          END                                                              AS ending_inv
    FROM inv r
    JOIN ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS m
         ON m."product_id" = r.product_id
    LEFT JOIN (
        SELECT 
            l."product_id",
            TO_CHAR(o."ordered", 'YYYY-MM') AS ym,
            SUM(l."qty")                    AS sold
        FROM ORACLE_SQL.ORACLE_SQL.ORDERLINES l
        JOIN ORACLE_SQL.ORACLE_SQL.ORDERS   o
          ON l."order_id" = o."id"
        WHERE o."ordered" ILIKE '2019-%'
          AND l."product_id" = 6520
        GROUP BY l."product_id", TO_CHAR(o."ordered", 'YYYY-MM')
    ) s
      ON s.ym = TO_CHAR( DATEADD(month, 1, r.ym || '-01' ), 'YYYY-MM')
    WHERE r.ym < '2019-12'
)
SELECT *
FROM inv
LIMIT 20;
```

```sql
--Description: Extend the recursive inventory calculation to ALL products (shows the first 20 calculated rows)
WITH RECURSIVE seed AS (
    --Initial stock position per product as of Dec-2018
    SELECT 
        i."product_id",
        '2018-12'          AS ym,
        SUM(i."qty")       AS ending_inv
    FROM ORACLE_SQL.ORACLE_SQL.INVENTORY i
    JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES p
      ON i."purchase_id" = p."id"
    WHERE p."purchased" ILIKE '2018-12-%'
    GROUP BY i."product_id"
), inv AS (
    SELECT * FROM seed
    UNION ALL
    SELECT
        r.product_id,
        TO_CHAR( DATEADD(month, 1, r.ym || '-01' ), 'YYYY-MM')            AS ym,
        r.ending_inv
        - COALESCE(s.sold,0)
        + CASE WHEN r.ending_inv - COALESCE(s.sold,0) < m."qty_minimum"
               THEN m."qty_purchase" ELSE 0 END                          AS ending_inv
    FROM inv r
    JOIN ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS m
      ON m."product_id" = r.product_id
    LEFT JOIN (
        SELECT 
            l."product_id",
            TO_CHAR(o."ordered", 'YYYY-MM') AS ym,
            SUM(l."qty")                    AS sold
        FROM ORACLE_SQL.ORACLE_SQL.ORDERLINES l
        JOIN ORACLE_SQL.ORACLE_SQL.ORDERS   o
          ON l."order_id" = o."id"
        WHERE o."ordered" ILIKE '2019-%'
        GROUP BY l."product_id", TO_CHAR(o."ordered", 'YYYY-MM')
    ) s
      ON s."product_id" = r.product_id
     AND s.ym           = TO_CHAR( DATEADD(month, 1, r.ym || '-01' ), 'YYYY-MM')
    WHERE r.ym < '2019-12'
)
SELECT *
FROM inv
ORDER BY "product_id", "ym"
LIMIT 20;
```

```sql
--Description: From the recursive result, retrieve the month in 2019 per product where the absolute difference
--             between ending inventory and minimum level is the smallest (TOP-1 per product)
WITH RECURSIVE seed AS (
    SELECT 
        i."product_id",
        '2018-12' AS ym,
        SUM(i."qty") AS ending_inv
    FROM ORACLE_SQL.ORACLE_SQL.INVENTORY i
    JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES p
      ON i."purchase_id" = p."id"
    WHERE p."purchased" ILIKE '2018-12-%'
    GROUP BY i."product_id"
), inv AS (
    SELECT * FROM seed
    UNION ALL
    SELECT
        r.product_id,
        TO_CHAR(DATEADD(month, 1, r.ym||'-01'), 'YYYY-MM') AS ym,
        r.ending_inv
        - COALESCE(s.sold,0)
        + CASE WHEN r.ending_inv - COALESCE(s.sold,0) < m."qty_minimum"
               THEN m."qty_purchase" ELSE 0 END           AS ending_inv
    FROM inv r
    JOIN ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS m
      ON m."product_id" = r.product_id
    LEFT JOIN (
        SELECT 
            l."product_id",
            TO_CHAR(o."ordered", 'YYYY-MM') AS ym,
            SUM(l."qty")                    AS sold
        FROM ORACLE_SQL.ORACLE_SQL.ORDERLINES l
        JOIN ORACLE_SQL.ORACLE_SQL.ORDERS   o
          ON l."order_id" = o."id"
        WHERE o."ordered" ILIKE '2019-%'
        GROUP BY l."product_id", TO_CHAR(o."ordered", 'YYYY-MM')
    ) s
      ON s."product_id" = r.product_id
     AND s.ym           = TO_CHAR(DATEADD(month, 1, r.ym||'-01'), 'YYYY-MM')
    WHERE r.ym < '2019-12'
), diff AS (
    SELECT 
        v.product_id,
        v.ym,
        ABS(v.ending_inv - m."qty_minimum")  AS abs_diff
    FROM inv v
    JOIN ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS m
       ON m."product_id" = v.product_id
    WHERE v.ym ILIKE '2019-%'
)
SELECT 
    d.product_id,
    d.ym              AS best_month_2019,
    d.abs_diff
FROM (
    SELECT 
        product_id,
        ym,
        abs_diff,
        ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY abs_diff ASC) AS rn
    FROM diff
) d
WHERE d.rn = 1
ORDER BY d.product_id
LIMIT 20;
```

```sql
--Description: Cross-check one of the results above (e.g., product 6520) to see its month-by-month distance to minimum
WITH result AS (
    --Bring forward the monthly inventory/diff already computed above for product 6520
    WITH RECURSIVE inv AS (
        SELECT 
            6520 AS product_id,
            '2018-12' AS ym,
            COALESCE( (
                SELECT SUM(i."qty")
                FROM ORACLE_SQL.ORACLE_SQL.INVENTORY i
                JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES p
                  ON i."purchase_id" = p."id"
                WHERE i."product_id" = 6520
                  AND p."purchased" ILIKE '2018-12-%'
            ), 0) AS ending_inv
        UNION ALL
        SELECT
            r.product_id,
            TO_CHAR(DATEADD(month, 1, r.ym||'-01'), 'YYYY-MM') AS ym,
            r.ending_inv
            - COALESCE(s.sold,0)
            + CASE WHEN r.ending_inv - COALESCE(s.sold,0) < m."qty_minimum"
                   THEN m."qty_purchase" ELSE 0 END           AS ending_inv
        FROM inv r
        JOIN ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS m
          ON m."product_id" = r.product_id
        LEFT JOIN (
            SELECT 
                l."product_id",
                TO_CHAR(o."ordered", 'YYYY-MM') AS ym,
                SUM(l."qty")                    AS sold
            FROM ORACLE_SQL.ORACLE_SQL.ORDERLINES l
            JOIN ORACLE_SQL.ORACLE_SQL.ORDERS   o
              ON l."order_id" = o."id"
            WHERE o."ordered" ILIKE '2019-%'
              AND l."product_id" = 6520
            GROUP BY l."product_id", TO_CHAR(o."ordered", 'YYYY-MM')
        ) s
          ON s.ym = TO_CHAR(DATEADD(month, 1, r.ym||'-01'), 'YYYY-MM')
        WHERE r.ym <= '2019-12'
    )
    SELECT
        v.ym,
        v.ending_inv,
        m."qty_minimum",
        ABS(v.ending_inv - m."qty_minimum") AS abs_diff
    FROM inv v
    JOIN ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS m
      ON m."product_id" = v.product_id
    WHERE v.ym ILIKE '2019-%'
)
SELECT * 
FROM result
ORDER BY ym
LIMIT 20;
```
