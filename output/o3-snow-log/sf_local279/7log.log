/*-------------------------------------------------------------
  Simulate 2019 inventory month-by-month and return, for every
  product that has a minimum-stock definition, the 2019 month
  whose ending inventory is closest to (qty_minimum).
-------------------------------------------------------------*/
WITH
/*-------------------------------------------------------------*/
/* stock on hand per product as of 2018-12-31                  */
start_inv AS (
    SELECT
        pm.product_id,
        COALESCE(SUM(p.qty),0)          /* total purchased */
      - COALESCE(SUM(s.qty),0)          /* minus total sold */
            AS opening_inventory
    FROM ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS pm
    LEFT JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES p
           ON  p.product_id = pm.product_id
          AND TO_DATE(p.purchased) <= '2018-12-31'
    LEFT JOIN ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES s
           ON  s.product_id = pm.product_id
          AND TO_DATE(s.mth)      <= '2018-12-01'
    GROUP BY pm.product_id
),
/*-------------------------------------------------------------*/
/* 2019 sales per product / month                               */
sales19 AS (
    SELECT
        product_id,
        TO_DATE(mth) AS mth,
        qty
    FROM ORACLE_SQL.ORACLE_SQL.MONTHLY_SALES
    WHERE TO_DATE(mth) BETWEEN '2019-01-01' AND '2019-12-31'
),
/*-------------------------------------------------------------*/
/* recursive simulation of 2019 ending inventories              */
inventory (product_id, mth, ending_inventory) AS (
    /* ------- January 2019 (anchor row) ------- */
    SELECT
        pm.product_id,
        TO_DATE('2019-01-01')                      AS mth,
        CASE
             WHEN (si.opening_inventory
                   - COALESCE(s19.qty,0)) < pm.qty_minimum
             THEN (si.opening_inventory
                   - COALESCE(s19.qty,0)) + pm.qty_purchase
             ELSE (si.opening_inventory
                   - COALESCE(s19.qty,0))
        END                                        AS ending_inventory
    FROM start_inv si
    JOIN ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS pm
         ON pm.product_id = si.product_id
    LEFT JOIN sales19 s19
         ON s19.product_id = pm.product_id
        AND s19.mth        = TO_DATE('2019-01-01')

    UNION ALL
    /* ------- subsequent months ------- */
    SELECT
        inv.product_id,
        DATEADD(month, 1, inv.mth)                AS mth,
        CASE
             WHEN (inv.ending_inventory
                   - COALESCE(s19.qty,0)) < pm.qty_minimum
             THEN (inv.ending_inventory
                   - COALESCE(s19.qty,0)) + pm.qty_purchase
             ELSE (inv.ending_inventory
                   - COALESCE(s19.qty,0))
        END                                        AS ending_inventory
    FROM inventory inv
    JOIN ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS pm
         ON pm.product_id = inv.product_id
    LEFT JOIN sales19 s19
         ON s19.product_id = inv.product_id
        AND s19.mth        = DATEADD(month, 1, inv.mth)
    WHERE inv.mth < '2019-12-01'      /* stop once December row produced */
),
/*-------------------------------------------------------------*/
/* absolute deviation from minimum each month                   */
diffs AS (
    SELECT
        inv.product_id,
        inv.mth,
        ABS(inv.ending_inventory - pm.qty_minimum) AS abs_diff,
        ROW_NUMBER() OVER (
            PARTITION BY inv.product_id
            ORDER BY ABS(inv.ending_inventory - pm.qty_minimum),
                     inv.mth                       /* earliest month on ties */
        )                                           AS rn
    FROM inventory inv
    JOIN ORACLE_SQL.ORACLE_SQL.PRODUCT_MINIMUMS pm
         ON pm.product_id = inv.product_id
)
/*-------------------------------------------------------------*/
SELECT
    product_id,
    TO_CHAR(mth,'YYYY-MM')  AS month_with_smallest_gap,
    abs_diff                AS absolute_difference
FROM diffs
WHERE rn = 1
ORDER BY product_id;
