--Description:  Sum the quantities of all inventory rows whose related purchase
--              occurred in December 2018 in order to obtain the starting stock
--              per product for our 2019 simulation.  
--              • All identifiers are quoted in UPPER-CASE, matching the form
--                Snowflake stores for columns that were originally created
--                without quotes, which avoids the earlier “invalid identifier”
--                errors.  
--              • We use an IN-subquery to fetch only those INVENTORY records
--                whose PURCHASE_ID appears in the set of December-2018
--                purchases.
SELECT
    "PRODUCT_ID",
    SUM("QTY") AS "START_QTY_DEC2018"
FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"
WHERE "PURCHASE_ID" IN (
        SELECT "ID"
        FROM "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"
        WHERE "PURCHASED" LIKE '2018-12-%'
      )
GROUP BY "PRODUCT_ID"
LIMIT 20;
