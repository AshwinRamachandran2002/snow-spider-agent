```sql
--Description: 6) Join 2019 sales and minimum levels to see how much each product sold vs. its minimum
SELECT
  s."product_id",
  s."mth",
  s."qty"          AS "sales_qty",
  pm."qty_minimum"
FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"     s
JOIN "ORACLE_SQL"."ORACLE_SQL"."PRODUCT_MINIMUMS"  pm
  ON s."product_id" = pm."product_id"
WHERE s."mth" LIKE '2019-%'
LIMIT 20;
```

```sql
--Description: 7) Produce one row per product per month for the entire 2019 horizon
WITH months AS (
  SELECT '2019-01-01' AS "mth" UNION ALL
  SELECT '2019-02-01' UNION ALL
  SELECT '2019-03-01' UNION ALL
  SELECT '2019-04-01' UNION ALL
  SELECT '2019-05-01' UNION ALL
  SELECT '2019-06-01' UNION ALL
  SELECT '2019-07-01' UNION ALL
  SELECT '2019-08-01' UNION ALL
  SELECT '2019-09-01' UNION ALL
  SELECT '2019-10-01' UNION ALL
  SELECT '2019-11-01' UNION ALL
  SELECT '2019-12-01'
)
SELECT
  pm."product_id",
  m."mth"
FROM  "ORACLE_SQL"."ORACLE_SQL"."PRODUCT_MINIMUMS" pm
CROSS JOIN months m
LIMIT 20;
```

```sql
--Description: 8) Build a simple (non-recursive) month-by-month inventory ledger for 2019
WITH start_inv AS (
  SELECT inv."product_id",
         SUM(inv."qty") AS "start_qty"
  FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  inv
  JOIN "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"  pur
    ON inv."purchase_id" = pur."id"
  WHERE pur."purchased" LIKE '2018-12-%'
  GROUP BY inv."product_id"
),
sales AS (
  SELECT "product_id",
         "mth",
         SUM("qty") AS "sales_qty"
  FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
  WHERE "mth" LIKE '2019-%'
  GROUP BY "product_id","mth"
),
restock AS (
  SELECT "product_id",
         "purchased" AS "mth",
         SUM("qty")  AS "restock_qty"
  FROM "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"
  WHERE "purchased" LIKE '2019-%'
  GROUP BY "product_id","purchased"
)
SELECT
  s."product_id",
  s."mth",
  COALESCE(si."start_qty",0)           AS "opening_qty",
  COALESCE(r."restock_qty",0)          AS "restock_qty",
  s."sales_qty",
  COALESCE(si."start_qty",0)
    + COALESCE(r."restock_qty",0)
    - COALESCE(s."sales_qty",0)        AS "ending_qty"
FROM sales s
LEFT JOIN restock  r  ON r."product_id" = s."product_id" AND r."mth" = s."mth"
LEFT JOIN start_inv si ON si."product_id" = s."product_id"
LIMIT 20;
```

```sql
--Description: 9) Verify for each product / month how far the simulated ending stock is from its minimum
WITH sim AS (  -- (reuse ledger logic from query 8) ---------------------------------
  SELECT
    s."product_id",
    s."mth",
    COALESCE(si."start_qty",0)
      + COALESCE(r."restock_qty",0)
      - COALESCE(s."sales_qty",0)      AS "ending_qty"
  FROM (
        SELECT "product_id","mth",SUM("qty") AS "sales_qty"
        FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
        WHERE "mth" LIKE '2019-%'
        GROUP BY "product_id","mth"
       ) s
  LEFT JOIN (
        SELECT "product_id","purchased" AS "mth",SUM("qty") AS "restock_qty"
        FROM  "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"
        WHERE "purchased" LIKE '2019-%'
        GROUP BY "product_id","purchased"
       ) r  ON r."product_id" = s."product_id" AND r."mth" = s."mth"
  LEFT JOIN (
        SELECT inv."product_id",SUM(inv."qty") AS "start_qty"
        FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" inv
        JOIN "ORACLE_SQL"."ORACLE_SQL"."PURCHASES" pur
          ON inv."purchase_id" = pur."id"
        WHERE pur."purchased" LIKE '2018-12-%'
        GROUP BY inv."product_id"
       ) si ON si."product_id" = s."product_id"
)
SELECT
  sim."product_id",
  sim."mth",
  sim."ending_qty",
  pm."qty_minimum",
  ABS(sim."ending_qty" - pm."qty_minimum") AS "abs_diff"
FROM sim
JOIN "ORACLE_SQL"."ORACLE_SQL"."PRODUCT_MINIMUMS" pm
  ON pm."product_id" = sim."product_id"
LIMIT 20;
```

```sql
--Description: 10) Final step – for each product, return the 2019 month where
--               the absolute difference between ending stock and minimum is the smallest
WITH sim AS (                       -- same simulated ledger as in query 9
  SELECT
    s."product_id",
    s."mth",
    COALESCE(si."start_qty",0)
      + COALESCE(r."restock_qty",0)
      - COALESCE(s."sales_qty",0)      AS "ending_qty"
  FROM (
        SELECT "product_id","mth",SUM("qty") AS "sales_qty"
        FROM "ORACLE_SQL"."ORACLE_SQL"."MONTHLY_SALES"
        WHERE "mth" LIKE '2019-%'
        GROUP BY "product_id","mth"
       ) s
  LEFT JOIN (
        SELECT "product_id","purchased" AS "mth",SUM("qty") AS "restock_qty"
        FROM  "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"
        WHERE "purchased" LIKE '2019-%'
        GROUP BY "product_id","purchased"
       ) r  ON r."product_id" = s."product_id" AND r."mth" = s."mth"
  LEFT JOIN (
        SELECT inv."product_id",SUM(inv."qty") AS "start_qty"
        FROM "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" inv
        JOIN "ORACLE_SQL"."ORACLE_SQL"."PURCHASES" pur
          ON inv."purchase_id" = pur."id"
        WHERE pur."purchased" LIKE '2018-12-%'
        GROUP BY inv."product_id"
       ) si ON si."product_id" = s."product_id"
),
dist AS (                            -- measure deviation from minimum
  SELECT
    sim."product_id",
    sim."mth",
    ABS(sim."ending_qty" - pm."qty_minimum") AS "abs_diff"
  FROM sim
  JOIN "ORACLE_SQL"."ORACLE_SQL"."PRODUCT_MINIMUMS" pm
    ON pm."product_id" = sim."product_id"
),
ranked AS (                           -- keep the month with the smallest abs_diff
  SELECT
    d.*,
    ROW_NUMBER() OVER (PARTITION BY d."product_id"
                       ORDER BY d."abs_diff" ASC) AS "rn"
  FROM dist d
)
SELECT
  "product_id",
  "mth"          AS "closest_month_2019",
  "abs_diff"
FROM ranked
WHERE "rn" = 1
LIMIT 20;
```
