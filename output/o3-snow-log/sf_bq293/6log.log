```sql
--Description: 1) Peek at 20 random trips from 1-Jan-2015 with plausible NYC coordinates  
SELECT 
       t."pickup_datetime",
       t."pickup_latitude",
       t."pickup_longitude"
FROM   NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015 t
WHERE  t."pickup_datetime" >= 1420070400000000   -- 2015-01-01 00:00:00
  AND  t."pickup_datetime" <  1420156800000000   -- 2015-01-02 00:00:00
  AND  t."pickup_latitude"  BETWEEN 40 AND 41
  AND  t."pickup_longitude" BETWEEN -75 AND -72
LIMIT  20;
```

```sql
--Description: 2) Check overall temporal range of the 2015 table  
