Query:
--Description: 8) Build a day-level time-series for the first 14 days of 2015 to later support lag / MA logic  
SELECT 
       DATE_FROM_PARTS(2015,1,1 + seq4()) AS "cal_date",
       COUNT(t.*)                         AS "trip_cnt"
FROM   TABLE(GENERATOR(ROWCOUNT => 14)) d
LEFT   JOIN NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015 t
       ON  t."pickup_datetime" >= (1420070400000000 + 86400000000 * seq4())
       AND t."pickup_datetime" <  (1420070400000000 + 86400000000 * (seq4()+1))
       AND t."pickup_latitude"  BETWEEN 40 AND 41
       AND t."pickup_longitude" BETWEEN -75 AND -72
GROUP  BY "cal_date"
ORDER  BY "cal_date"
LIMIT  20;
