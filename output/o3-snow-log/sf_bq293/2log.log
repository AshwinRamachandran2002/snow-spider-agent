```sql
--Description: For sanity, show some records with obviously invalid coordinate values (outside NYC bounding box).
SELECT
  "pickup_datetime",
  "pickup_longitude",
  "pickup_latitude"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
WHERE ("pickup_longitude" NOT BETWEEN -75 AND -72)
   OR ("pickup_latitude"  NOT BETWEEN  40 AND  41)
LIMIT 20;
```

```sql
--Description: Trip counts per hour bucket for the first two weeks of 2015 to help in lag / moving-window logic.
SELECT
  FLOOR("pickup_datetime" / 3600000000000) AS "hour_bucket",
  COUNT(*)                                 AS "trip_cnt"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
WHERE "pickup_datetime" BETWEEN 1420070400000000           -- 1-Jan-2015 00:00
                          AND 1421280000000000             -- 16-Jan-2015 00:00
GROUP BY 1
ORDER BY "hour_bucket"
LIMIT 20;
```

```sql
--Description: All distinct rounded lon/lat combos paired with distinct hourly buckets on 1-Jan-2015 (Cartesian sample, limit 20).
WITH hrs AS (
  SELECT DISTINCT FLOOR("pickup_datetime" / 3600000000000) AS "hour_bucket"
  FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799000000
),
coords AS (
  SELECT DISTINCT
    ROUND("pickup_longitude", 3) AS "lon_3dp",
    ROUND("pickup_latitude" , 3) AS "lat_3dp"
  FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799000000
)
SELECT
  c."lon_3dp",
  c."lat_3dp",
  h."hour_bucket"
FROM coords c
CROSS JOIN hrs h
LIMIT 20;
```
