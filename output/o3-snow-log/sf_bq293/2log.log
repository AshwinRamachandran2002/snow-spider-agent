```sql
/* ---------------------------------------------------------
   NYC yellow-taxi – 1-Jan-2015, hourly counts per ZIP code
   (lags, moving avgs & stdevs)          ‑- Snowflake SQL
----------------------------------------------------------*/
WITH
/* 1.  Trips on 1-Jan-2015 with valid coordinates            */
trips AS (
    SELECT
        FLOOR("pickup_datetime" / 3600000000)              AS "hour_bucket" ,   -- µs → hours
        TO_GEOGRAPHY('POINT(' || "pickup_longitude" || ' ' || "pickup_latitude" || ')')
                                                           AS "pickup_geog"
    FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
    WHERE "pickup_datetime" BETWEEN 1420070400000000        -- 2015-01-01 00:00:00
                               AND     1420156799000000      -- 2015-01-01 23:59:59.9
      AND "pickup_longitude" BETWEEN -75 AND -72            -- keep only plausible NYC pts
      AND "pickup_latitude"  BETWEEN  40 AND  41
),
/* 2.  NYC ZIP-code polygons                                 */
nyc_zips AS (
    SELECT
        "zip_code",
        "geometry"                                          AS "zip_geom"
    FROM GEO_US_BOUNDARIES.PUBLIC.ZIP_CODES
    WHERE "state_code" = 'NY'                               -- limit to New-York State
),
/* 3.  Attach each trip to its ZIP using a spatial join      */
trip_zip AS (
    SELECT
        z."zip_code",
        t."hour_bucket"
    FROM trips     t
    JOIN nyc_zips  z
      ON ST_CONTAINS(z."zip_geom", t."pickup_geog")
),
/* 4.  Hourly trip counts per ZIP                            */
hourly_zip_cnt AS (
    SELECT
        "zip_code",
        "hour_bucket",
        COUNT(*) AS "trip_cnt"
    FROM trip_zip
    GROUP BY 1,2
),
/* 5.  Build a complete ZIP × HOUR grid so zero-trip hours
       are retained                                          */
all_hours AS (                -- distinct hours that occurred on 1-Jan-2015
    SELECT DISTINCT "hour_bucket" FROM hourly_zip_cnt
),
all_zips  AS (                -- distinct NYC zip codes that had ≥1 trip that day
    SELECT DISTINCT "zip_code" FROM hourly_zip_cnt
),
zip_hour_grid AS (            -- cartesian product → full coverage
    SELECT z."zip_code", h."hour_bucket"
    FROM all_zips z
    CROSS JOIN all_hours h
),
full_data AS (                -- left join to put in zeroes where missing
    SELECT
        g."zip_code",
        g."hour_bucket",
        COALESCE(c."trip_cnt", 0) AS "trip_cnt"
    FROM zip_hour_grid      g
    LEFT JOIN hourly_zip_cnt c
           ON g."zip_code"    = c."zip_code"
          AND g."hour_bucket" = c."hour_bucket"
),
/* 6.  Lags & moving statistics (excludes current hour)      */
calc AS (
    SELECT
        "zip_code",
        "hour_bucket",
        "trip_cnt",

        /* lagged counts */
        LAG("trip_cnt",   1) OVER (PARTITION BY "zip_code" ORDER BY "hour_bucket")
            AS "cnt_1h_ago",
        LAG("trip_cnt",  24) OVER (PARTITION BY "zip_code" ORDER BY "hour_bucket")
            AS "cnt_24h_ago",
        LAG("trip_cnt", 168) OVER (PARTITION BY "zip_code" ORDER BY "hour_bucket")
            AS "cnt_168h_ago",
        LAG("trip_cnt", 336) OVER (PARTITION BY "zip_code" ORDER BY "hour_bucket")
            AS "cnt_336h_ago",

        /* moving averages & stdevs – 14-day (336 h) and 21-day (504 h) */
        AVG("trip_cnt") OVER (PARTITION BY "zip_code"
                              ORDER BY "hour_bucket"
                              ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING)  AS "ma_14d",
        AVG("trip_cnt") OVER (PARTITION BY "zip_code"
                              ORDER BY "hour_bucket"
                              ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING)  AS "ma_21d",

        STDDEV_SAMP("trip_cnt") OVER (PARTITION BY "zip_code"
                                      ORDER BY "hour_bucket"
                                      ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING) AS "std_14d",
        STDDEV_SAMP("trip_cnt") OVER (PARTITION BY "zip_code"
                                      ORDER BY "hour_bucket"
                                      ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING) AS "std_21d"
    FROM full_data
)

/* 7.  Return the five ZIP×hour rows with the most trips     */
SELECT *
FROM   calc
ORDER  BY "trip_cnt" DESC NULLS LAST
LIMIT 5;
```
