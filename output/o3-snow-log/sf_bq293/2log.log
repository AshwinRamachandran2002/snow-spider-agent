{'NEW_YORK_GEO': {'NEW_YORK': ['TLC_YELLOW_TRIPS_2011', 'TLC_YELLOW_TRIPS_2015', 'TLC_YELLOW_TRIPS_2010', 'TLC_YELLOW_TRIPS_2013', 'TLC_YELLOW_TRIPS_2012', 'TLC_YELLOW_TRIPS_2014']}}

