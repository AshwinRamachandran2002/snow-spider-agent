```sql
--Description: Quick glance at 20 raw rows from the 2015 yellow-cab trips table
SELECT *
FROM NEW_YORK_GEO.NEW_YORK."TLC_YELLOW_TRIPS_2015"
LIMIT 20;
```

```sql
--Description: 20 trips whose “pickup_datetime” value falls within the numeric range that roughly corresponds to Jan-01-2015 (00:00 – 23:59 UTC)
SELECT *
FROM NEW_YORK_GEO.NEW_YORK."TLC_YELLOW_TRIPS_2015"
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799000000
LIMIT 20;
```

```sql
--Description: Distinct hour-slot identifiers (integer division by micro-seconds-per-hour) for Jan-01-2015, shown in descending trip volume
SELECT ("pickup_datetime" / 3600000000)            AS "hour_slot",
       COUNT(*)                                     AS "trip_cnt"
FROM   NEW_YORK_GEO.NEW_YORK."TLC_YELLOW_TRIPS_2015"
WHERE  "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799000000
GROUP  BY 1
ORDER  BY "trip_cnt" DESC
LIMIT 20;
```

```sql
--Description: Top 20 longitude / latitude pairs with the most pickups on Jan-01-2015
SELECT "pickup_longitude",
       "pickup_latitude",
       COUNT(*) AS "trip_cnt"
FROM   NEW_YORK_GEO.NEW_YORK."TLC_YELLOW_TRIPS_2015"
WHERE  "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799000000
GROUP  BY 1, 2
ORDER  BY "trip_cnt" DESC
LIMIT 20;
```

```sql
--Description: Spot-check possible bad coordinates by listing 20 trips whose latitude is outside a broad NYC range (lat < 40 or lat > 41)
SELECT "pickup_datetime",
       "pickup_longitude",
       "pickup_latitude"
FROM   NEW_YORK_GEO.NEW_YORK."TLC_YELLOW_TRIPS_2015"
WHERE  "pickup_latitude" < 40
   OR  "pickup_latitude" > 41
LIMIT 20;
```

```sql
--Description: Distinct pickup longitudes (rounded to 3 decimals) observed on Jan-01-2015  
SELECT DISTINCT ROUND("pickup_longitude", 3) AS "pickup_lng_rd_3"
FROM   NEW_YORK_GEO.NEW_YORK."TLC_YELLOW_TRIPS_2015"
WHERE  "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799000000
LIMIT 20;
```

```sql
--Description: Earliest and latest “pickup_datetime” values found for Jan-01-2015 range  
SELECT MIN("pickup_datetime") AS "min_ts",
       MAX("pickup_datetime") AS "max_ts"
FROM   NEW_YORK_GEO.NEW_YORK."TLC_YELLOW_TRIPS_2015"
WHERE  "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799000000;
```

```sql
--Description: Compare Jan-01 trips in the 2014 table to understand inter-year differences  
SELECT *
FROM   NEW_YORK_GEO.NEW_YORK."TLC_YELLOW_TRIPS_2014"
WHERE  "pickup_datetime" BETWEEN 1388534400000000 AND 1388620799000000  --approx Jan-01-2014
LIMIT 20;
```

```sql
--Description: Count of trips in the 2015 table that have both latitude & longitude within a broad NYC bounding box  
SELECT COUNT(*) AS "valid_geo_trip_cnt"
FROM   NEW_YORK_GEO.NEW_YORK."TLC_YELLOW_TRIPS_2015"
WHERE  "pickup_latitude"  BETWEEN 40.0 AND 41.0
  AND  "pickup_longitude" BETWEEN -75.0 AND -72.0;
```

```sql
--Description: Show the 20 most frequent integer-hour-slot / rounded-zip-code proxy (first 2 decimals of lat) combinations on Jan-01-2015  
SELECT ("pickup_datetime" / 3600000000)            AS "hour_slot",
       ROUND("pickup_latitude", 2)                 AS "lat_rd_2",
       COUNT(*)                                    AS "trip_cnt"
FROM   NEW_YORK_GEO.NEW_YORK."TLC_YELLOW_TRIPS_2015"
WHERE  "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799000000
GROUP  BY 1, 2
ORDER  BY "trip_cnt" DESC
LIMIT 20;
```
