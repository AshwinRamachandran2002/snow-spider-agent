```sql
/* ---------------------------------------------------------------
   Hour-by-hour January-01-2015 yellow-cab activity per NYC ZIP code
   – includes zero-trip hours, time-shifted counts, moving stats
------------------------------------------------------------------*/
WITH valid_trips AS (              -- 1) keep only geo-valid 2015 trips for the target day
    SELECT
        TO_TIMESTAMP("pickup_datetime", 6)                       AS pickup_ts,        -- micro-sec epoch ➜ TIMESTAMP
        DATE_TRUNC('HOUR', TO_TIMESTAMP("pickup_datetime", 6))   AS hour_ts,
        TO_GEOGRAPHY('POINT('||"pickup_longitude"||' '||"pickup_latitude"||')') AS pt
    FROM NEW_YORK_GEO.NEW_YORK."TLC_YELLOW_TRIPS_2015"
    WHERE "pickup_latitude"  BETWEEN 40.0 AND 41.0               -- coarse NYC bbox
      AND "pickup_longitude" BETWEEN -75.0 AND -72.0
      AND "pickup_datetime" BETWEEN 1420070400000000             -- 2015-01-01 00:00:00
                              AND 1420156799000000               -- 2015-01-01 23:59:59.999
),                                                               
nyc_zips AS (                -- 2) NYC ZIP polygons
    SELECT CAST("ZIP_CODE" AS VARCHAR) AS zip_code,
           "GEOM"                      AS geom
    FROM GEO_US_BOUNDARIES.PUBLIC.ZIP_CODES
    WHERE "STATE" = 'NY'
),
hour_series AS (             -- 3) the 24 hour-slots of 1-Jan-2015
    SELECT DATEADD(HOUR, SEQ4(), '2015-01-01 00:00:00') AS hour_ts
    FROM   TABLE(GENERATOR(ROWCOUNT => 24))
),
trip_counts AS (             -- 4) trips → (zip, hour) aggregates
    SELECT
        z.zip_code,
        DATE_TRUNC('HOUR', v.pickup_ts) AS hour_ts,
        COUNT(*)                        AS trip_cnt
    FROM valid_trips v
    JOIN nyc_zips   z
      ON ST_CONTAINS(z.geom, v.pt)
    GROUP BY 1,2
),
grid AS (                    -- 5) every ZIP × every hour (24) →  complete grid
    SELECT z.zip_code, h.hour_ts
    FROM   nyc_zips   z
    CROSS  JOIN hour_series h
),
full_grid AS (               -- 6) attach counts, defaulting to zero
    SELECT
        g.zip_code,
        g.hour_ts,
        COALESCE(t.trip_cnt, 0) AS trip_cnt
    FROM grid        g
    LEFT JOIN trip_counts t
           ON g.zip_code = t.zip_code
          AND g.hour_ts  = t.hour_ts
),
metrics AS (                 -- 7) time-shifted counts & moving statistics
    SELECT
        zip_code,
        hour_ts,
        trip_cnt,
        LAG(trip_cnt,   1) OVER (PARTITION BY zip_code ORDER BY hour_ts)  AS trips_1hr_ago,
        LAG(trip_cnt,  24) OVER (PARTITION BY zip_code ORDER BY hour_ts)  AS trips_24hr_ago,
        LAG(trip_cnt, 168) OVER (PARTITION BY zip_code ORDER BY hour_ts)  AS trips_7d_ago,
        LAG(trip_cnt, 336) OVER (PARTITION BY zip_code ORDER BY hour_ts)  AS trips_14d_ago,
        AVG(trip_cnt)        OVER (PARTITION BY zip_code ORDER BY hour_ts
                                   ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING)          AS ma_14d,
        STDDEV_SAMP(trip_cnt) OVER (PARTITION BY zip_code ORDER BY hour_ts
                                   ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING)          AS std_14d,
        AVG(trip_cnt)        OVER (PARTITION BY zip_code ORDER BY hour_ts
                                   ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING)          AS ma_21d,
        STDDEV_SAMP(trip_cnt) OVER (PARTITION BY zip_code ORDER BY hour_ts
                                   ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING)          AS std_21d
    FROM full_grid
)
SELECT *
FROM   metrics
WHERE  hour_ts BETWEEN '2015-01-01 00:00:00' AND '2015-01-01 23:00:00'
ORDER  BY trip_cnt DESC NULLS LAST
LIMIT 5;
```
