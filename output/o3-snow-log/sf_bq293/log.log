```sql
/* ──────────────────────────────────────────────────────────────────────────────
   NYC Yellow-Taxi pickups on 01-JAN-2015
   – Hour-by-hour counts per ZIP code (incl. zero-trip hours)
   – 1-hour / 1-day / 7-day / 14-day lags
   – 14-day & 21-day moving averages / stdevs
   – Top-5 (ZIP , hour) combinations by trip volume
   --------------------------------------------------------------------------- */
WITH
/* 1.  Twenty-four hourly “buckets” covering 01-JAN-2015 (UTC) */
hours AS (
    SELECT
        FLOOR(1420070400000000/1000000/3600) + SEQ4()  AS "epoch_hour"  -- 14200704…µs = 2015-01-01 00:00:00
    FROM TABLE(GENERATOR(ROWCOUNT => 24))                                -- produces 24 rows (0 … 23)
),

/* 2.  NYC ZIP-code polygons (adjust database / schema / column names if different) */
zip_nyc AS (
    SELECT
        "ZIP_CODE" AS "zip_code",
        "GEOM"     AS "geom"
    FROM GEO_US_BOUNDARIES.PUBLIC.ZIP_CODES
    WHERE "STATEFP" = '36'                   -- FIPS for New-York State
),

/* 3.  All (hour × ZIP) combinations ⇒ guarantees zero-trip rows will exist */
dim AS (
    SELECT
        h."epoch_hour",
        z."zip_code"
    FROM hours  h
    CROSS JOIN zip_nyc z
),

/* 4.  Trip counts that actually occurred during the day, already bucketed by hour */
trip_counts AS (
    SELECT
        FLOOR(t."pickup_datetime" / 1000000 / 3600)   AS "epoch_hour",
        z."zip_code",
        COUNT(*)                                      AS "trip_count"
    FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015  t
    JOIN zip_nyc z
      ON ST_CONTAINS(
             z."geom",
             TO_GEOGRAPHY( ST_POINT(t."pickup_longitude", t."pickup_latitude") )
         )
    WHERE t."pickup_datetime" BETWEEN 1420070400000000     -- 2015-01-01 00:00:00
                                 AND     1420156799999999   -- 2015-01-01 23:59:59.999999
          /* keep only rows that truly have coordinates                         */
          AND t."pickup_latitude"  BETWEEN -90  AND 90
          AND t."pickup_longitude" BETWEEN -180 AND 180
    GROUP BY 1, 2
),

/* 5.  Add missing (hour,ZIP) pairs → fill with zero trips                     */
fact AS (
    SELECT
        d."epoch_hour",
        d."zip_code",
        COALESCE(tc."trip_count", 0) AS "trip_count"
    FROM dim d
    LEFT JOIN trip_counts tc
           ON d."epoch_hour" = tc."epoch_hour"
          AND d."zip_code"   = tc."zip_code"
),

/* 6.  Time-shifted metrics & rolling statistics                               */
metrics AS (
    SELECT
        "epoch_hour",
        "zip_code",
        "trip_count",

        /* simple lags */
        LAG ("trip_count",   1)  OVER (PARTITION BY "zip_code" ORDER BY "epoch_hour") AS "cnt_1hr_ago",
        LAG ("trip_count",  24)  OVER (PARTITION BY "zip_code" ORDER BY "epoch_hour") AS "cnt_24hr_ago",
        LAG ("trip_count", 168)  OVER (PARTITION BY "zip_code" ORDER BY "epoch_hour") AS "cnt_168hr_ago",
        LAG ("trip_count", 336)  OVER (PARTITION BY "zip_code" ORDER BY "epoch_hour") AS "cnt_336hr_ago",

        /* rolling windows – exclude current hour ( … 1 PRECEDING ) */
        AVG("trip_count")          OVER (
            PARTITION BY "zip_code"
            ORDER BY "epoch_hour"
            ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING
        ) AS "avg_14d",

        STDDEV_SAMP("trip_count")  OVER (
            PARTITION BY "zip_code"
            ORDER BY "epoch_hour"
            ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING
        ) AS "std_14d",

        AVG("trip_count")          OVER (
            PARTITION BY "zip_code"
            ORDER BY "epoch_hour"
            ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING
        ) AS "avg_21d",

        STDDEV_SAMP("trip_count")  OVER (
            PARTITION BY "zip_code"
            ORDER BY "epoch_hour"
            ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING
        ) AS "std_21d"
    FROM fact
)

/* 7.  Final output – top-5 (hour,ZIP) combinations by trip volume             */
SELECT *
FROM metrics
ORDER BY "trip_count" DESC NULLS LAST
LIMIT 5;
```
