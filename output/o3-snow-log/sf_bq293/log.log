Query:
--Description: Add a 1-hour lag column (trips from 1 hour ago) for the same filtered set. 
WITH hourly AS (
  SELECT 
    FLOOR("pickup_datetime"/1000000/3600) AS "epoch_hour",
    COUNT(*)                               AS "trip_count"
  FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799999999
    AND "pickup_latitude"  BETWEEN 40 AND 41
    AND "pickup_longitude" BETWEEN -75 AND -73
  GROUP BY "epoch_hour"
)
SELECT 
  "epoch_hour",
  "trip_count",
  LAG("trip_count",1) OVER (ORDER BY "epoch_hour") AS "cnt_1hr_ago"
FROM hourly
ORDER BY "epoch_hour"
LIMIT 20;
