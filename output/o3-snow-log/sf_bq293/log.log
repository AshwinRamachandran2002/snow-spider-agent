```sql
--Description: Preview 20 random rows from the 2015 Yellow-Taxi table to confirm overall structure. 
SELECT 
  "pickup_datetime", 
  "pickup_longitude", 
  "pickup_latitude"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
LIMIT 20;
```

```sql
--Description: Inspect 20 trips whose pickups happened on 01-JAN-2015 (micro-seconds between 00:00 and 23:59 UTC). 
SELECT 
  "pickup_datetime", 
  "pickup_longitude", 
  "pickup_latitude"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799999999
LIMIT 20;
```

```sql
--Description: List the distinct hour-buckets (epoch-hours) present on 01-JAN-2015. 
SELECT DISTINCT 
  FLOOR("pickup_datetime"/1000000/3600) AS "epoch_hour"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799999999
ORDER BY "epoch_hour"
LIMIT 20;
```

```sql
--Description: Basic hourly trip counts for 01-JAN-2015 (all pickup points). 
SELECT 
  FLOOR("pickup_datetime"/1000000/3600) AS "epoch_hour",
  COUNT(*)                                AS "trip_count"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799999999
GROUP BY "epoch_hour"
ORDER BY "epoch_hour"
LIMIT 20;
```

```sql
--Description: Hourly counts for 01-JAN-2015 restricted to a rough NYC bounding box (lat 40-41, long −75 to −73). 
SELECT 
  FLOOR("pickup_datetime"/1000000/3600) AS "epoch_hour",
  COUNT(*)                                AS "trip_count"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799999999
  AND "pickup_latitude"  BETWEEN 40 AND 41
  AND "pickup_longitude" BETWEEN -75 AND -73
GROUP BY "epoch_hour"
ORDER BY "trip_count" DESC
LIMIT 20;
```

```sql
--Description: Add a 1-hour lag column (trips from 1 hour ago) for the same filtered set. 
WITH hourly AS (
  SELECT 
    FLOOR("pickup_datetime"/1000000/3600) AS "epoch_hour",
    COUNT(*)                               AS "trip_count"
  FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799999999
    AND "pickup_latitude"  BETWEEN 40 AND 41
    AND "pickup_longitude" BETWEEN -75 AND -73
  GROUP BY "epoch_hour"
)
SELECT 
  "epoch_hour",
  "trip_count",
  LAG("trip_count",1) OVER (ORDER BY "epoch_hour") AS "cnt_1hr_ago"
FROM hourly
ORDER BY "epoch_hour"
LIMIT 20;
```

```sql
--Description: Extend to also include the count from 24 hours (1 day) ago. 
WITH hourly AS (
  SELECT 
    FLOOR("pickup_datetime"/1000000/3600) AS "epoch_hour",
    COUNT(*)                               AS "trip_count"
  FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799999999
    AND "pickup_latitude"  BETWEEN 40 AND 41
    AND "pickup_longitude" BETWEEN -75 AND -73
  GROUP BY "epoch_hour"
)
SELECT 
  "epoch_hour",
  "trip_count",
  LAG("trip_count",1)  OVER (ORDER BY "epoch_hour")  AS "cnt_1hr_ago",
  LAG("trip_count",24) OVER (ORDER BY "epoch_hour")  AS "cnt_24hr_ago"
FROM hourly
ORDER BY "epoch_hour"
LIMIT 20;
```

```sql
--Description: Further include 7-day (168 h) and 14-day (336 h) lagged trip counts. 
WITH hourly AS (
  SELECT 
    FLOOR("pickup_datetime"/1000000/3600) AS "epoch_hour",
    COUNT(*)                               AS "trip_count"
  FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799999999
    AND "pickup_latitude"  BETWEEN 40 AND 41
    AND "pickup_longitude" BETWEEN -75 AND -73
  GROUP BY "epoch_hour"
)
SELECT 
  "epoch_hour",
  "trip_count",
  LAG("trip_count",1)    OVER (ORDER BY "epoch_hour") AS "cnt_1hr_ago",
  LAG("trip_count",24)   OVER (ORDER BY "epoch_hour") AS "cnt_24hr_ago",
  LAG("trip_count",168)  OVER (ORDER BY "epoch_hour") AS "cnt_168hr_ago",
  LAG("trip_count",336)  OVER (ORDER BY "epoch_hour") AS "cnt_336hr_ago"
FROM hourly
ORDER BY "epoch_hour"
LIMIT 20;
```

```sql
--Description: Compute 14-day (336 h) and 21-day (504 h) moving averages & standard deviations of trip counts (excluding current hour). 
WITH hourly AS (
  SELECT 
    FLOOR("pickup_datetime"/1000000/3600) AS "epoch_hour",
    COUNT(*)                               AS "trip_count"
  FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799999999
    AND "pickup_latitude"  BETWEEN 40 AND 41
    AND "pickup_longitude" BETWEEN -75 AND -73
  GROUP BY "epoch_hour"
)
SELECT 
  "epoch_hour",
  "trip_count",
  AVG("trip_count")       OVER (ORDER BY "epoch_hour" ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING) AS "avg_14d",
  STDDEV_SAMP("trip_count") OVER (ORDER BY "epoch_hour" ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING) AS "std_14d",
  AVG("trip_count")       OVER (ORDER BY "epoch_hour" ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING) AS "avg_21d",
  STDDEV_SAMP("trip_count") OVER (ORDER BY "epoch_hour" ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING) AS "std_21d"
FROM hourly
ORDER BY "epoch_hour"
LIMIT 20;
```

```sql
--Description: Final step – top-5 hour buckets on 01-JAN-2015 with full lag/rolling metrics, ordered by highest trip counts. 
WITH hourly AS (
  SELECT 
    FLOOR("pickup_datetime"/1000000/3600) AS "epoch_hour",
    COUNT(*)                               AS "trip_count"
  FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156799999999
    AND "pickup_latitude"  BETWEEN 40 AND 41
    AND "pickup_longitude" BETWEEN -75 AND -73
  GROUP BY "epoch_hour"
),
metrics AS (
  SELECT 
    "epoch_hour",
    "trip_count",
    LAG("trip_count",1)    OVER (ORDER BY "epoch_hour")  AS "cnt_1hr_ago",
    LAG("trip_count",24)   OVER (ORDER BY "epoch_hour")  AS "cnt_24hr_ago",
    LAG("trip_count",168)  OVER (ORDER BY "epoch_hour")  AS "cnt_168hr_ago",
    LAG("trip_count",336)  OVER (ORDER BY "epoch_hour")  AS "cnt_336hr_ago",
    AVG("trip_count")         OVER (ORDER BY "epoch_hour" ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING) AS "avg_14d",
    STDDEV_SAMP("trip_count") OVER (ORDER BY "epoch_hour" ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING) AS "std_14d",
    AVG("trip_count")         OVER (ORDER BY "epoch_hour" ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING) AS "avg_21d",
    STDDEV_SAMP("trip_count") OVER (ORDER BY "epoch_hour" ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING) AS "std_21d"
  FROM hourly
)
SELECT *
FROM metrics
ORDER BY "trip_count" DESC
LIMIT 5;
```
