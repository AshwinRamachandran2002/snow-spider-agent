```sql
--Description: Quick look at raw January-2015 Yellow-Taxi data (pickup epoch, longitude, latitude)
SELECT 
  "pickup_datetime",
  "pickup_longitude",
  "pickup_latitude"
FROM "NEW_YORK_GEO"."NEW_YORK"."TLC_YELLOW_TRIPS_2015"
LIMIT 20;
```

```sql
--Description: Convert micro-second epoch to real timestamps and show first 20 trips that occurred on 1-Jan-2015  
SELECT 
  TO_TIMESTAMP_NTZ("pickup_datetime"/1000000)   AS "pickup_ts",
  "pickup_longitude",
  "pickup_latitude"
FROM "NEW_YORK_GEO"."NEW_YORK"."TLC_YELLOW_TRIPS_2015"
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000   -- 00:00-24:00 1-Jan-2015 UTC
LIMIT 20;
```

```sql
--Description: List the distinct hour-buckets (as integer IDs) appearing on 1-Jan-2015  
SELECT DISTINCT 
  FLOOR("pickup_datetime"/3600000000) AS "hour_slot_id"
FROM "NEW_YORK_GEO"."NEW_YORK"."TLC_YELLOW_TRIPS_2015"
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000
ORDER BY "hour_slot_id"
LIMIT 20;
```

```sql
--Description: Trip counts per hour for 1-Jan-2015  
SELECT 
  FLOOR("pickup_datetime"/3600000000)            AS "hour_slot_id",
  COUNT(*)                                       AS "trip_cnt"
FROM "NEW_YORK_GEO"."NEW_YORK"."TLC_YELLOW_TRIPS_2015"
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000
GROUP BY "hour_slot_id"
ORDER BY "trip_cnt" DESC
LIMIT 24;
```

```sql
--Description: Show 20 distinct, clearly valid lat/long pairs recorded on 1-Jan-2015  
SELECT DISTINCT
  "pickup_latitude",
  "pickup_longitude"
FROM "NEW_YORK_GEO"."NEW_YORK"."TLC_YELLOW_TRIPS_2015"
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000
  AND "pickup_latitude" BETWEEN 40 AND 41      -- coarse NYC lat range
  AND "pickup_longitude" BETWEEN -75 AND -72   -- coarse NYC lon range
LIMIT 20;
```

```sql
--Description: Aggregate 1-Jan-2015 trips by 3-decimal rounded lat/long “cells” (roughly ZIP-sized)  
SELECT
  ROUND("pickup_latitude", 3)  AS "lat_3dec",
  ROUND("pickup_longitude",3)  AS "lon_3dec",
  COUNT(*)                     AS "trip_cnt"
FROM "NEW_YORK_GEO"."NEW_YORK"."TLC_YELLOW_TRIPS_2015"
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000
GROUP BY "lat_3dec", "lon_3dec"
ORDER BY "trip_cnt" DESC
LIMIT 20;
```

```sql
--Description: Hour-by-hour counts for every 3-decimal lat/long cell on 1-Jan-2015  
SELECT
  ROUND("pickup_latitude", 3)                   AS "lat_3dec",
  ROUND("pickup_longitude",3)                   AS "lon_3dec",
  FLOOR("pickup_datetime"/3600000000)           AS "hour_slot_id",
  COUNT(*)                                      AS "trip_cnt"
FROM "NEW_YORK_GEO"."NEW_YORK"."TLC_YELLOW_TRIPS_2015"
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000
GROUP BY "lat_3dec", "lon_3dec", "hour_slot_id"
ORDER BY "trip_cnt" DESC
LIMIT 20;
```

```sql
--Description: For each 3-decimal cell, compare current hour’s trips with the *previous* hour (lag) on 1-Jan-2015  
WITH hr AS (
  SELECT
    ROUND("pickup_latitude",3)                 AS "lat_3dec",
    ROUND("pickup_longitude",3)                AS "lon_3dec",
    FLOOR("pickup_datetime"/3600000000)        AS "hour_slot_id",
    COUNT(*)                                   AS "trip_cnt"
  FROM "NEW_YORK_GEO"."NEW_YORK"."TLC_YELLOW_TRIPS_2015"
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000
  GROUP BY "lat_3dec","lon_3dec","hour_slot_id"
)
SELECT
  "lat_3dec",
  "lon_3dec",
  "hour_slot_id",
  "trip_cnt",
  LAG("trip_cnt") OVER (PARTITION BY "lat_3dec","lon_3dec" ORDER BY "hour_slot_id") AS "trip_cnt_prev_hr"
FROM hr
ORDER BY "trip_cnt" DESC
LIMIT 20;
```

```sql
--Description: 14-hour rolling average & std-dev of trips per 3-decimal cell (excluding current hour) on 1-Jan-2015  
WITH hr AS (
  SELECT
    ROUND("pickup_latitude",3)                 AS "lat_3dec",
    ROUND("pickup_longitude",3)                AS "lon_3dec",
    FLOOR("pickup_datetime"/3600000000)        AS "hour_slot_id",
    COUNT(*)                                   AS "trip_cnt"
  FROM "NEW_YORK_GEO"."NEW_YORK"."TLC_YELLOW_TRIPS_2015"
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000
  GROUP BY "lat_3dec","lon_3dec","hour_slot_id"
)
SELECT
  "lat_3dec",
  "lon_3dec",
  "hour_slot_id",
  "trip_cnt",
  AVG("trip_cnt")    OVER (PARTITION BY "lat_3dec","lon_3dec" 
                           ORDER BY "hour_slot_id"
                           ROWS BETWEEN 14 PRECEDING AND 1 PRECEDING) AS "avg_prev_14hr",
  STDDEV_SAMP("trip_cnt") OVER (PARTITION BY "lat_3dec","lon_3dec"
                                ORDER BY "hour_slot_id"
                                ROWS BETWEEN 14 PRECEDING AND 1 PRECEDING) AS "stddev_prev_14hr"
FROM hr
ORDER BY "hour_slot_id"
LIMIT 20;
```

```sql
--Description: Top-5 hour-slot / 3-decimal-cell combinations with the most trips on 1-Jan-2015  
WITH hr AS (
  SELECT
    ROUND("pickup_latitude",3)                 AS "lat_3dec",
    ROUND("pickup_longitude",3)                AS "lon_3dec",
    FLOOR("pickup_datetime"/3600000000)        AS "hour_slot_id",
    COUNT(*)                                   AS "trip_cnt"
  FROM "NEW_YORK_GEO"."NEW_YORK"."TLC_YELLOW_TRIPS_2015"
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000
  GROUP BY "lat_3dec","lon_3dec","hour_slot_id"
)
SELECT 
  "lat_3dec",
  "lon_3dec",
  "hour_slot_id",
  "trip_cnt"
FROM hr
ORDER BY "trip_cnt" DESC
LIMIT 5;
```
