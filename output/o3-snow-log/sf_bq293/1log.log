--Description: 14-hour rolling average & std-dev of trips per 3-decimal cell (excluding current hour) on 1-Jan-2015  
WITH hr AS (
  SELECT
    ROUND("pickup_latitude",3)                 AS "lat_3dec",
    ROUND("pickup_longitude",3)                AS "lon_3dec",
    FLOOR("pickup_datetime"/3600000000)        AS "hour_slot_id",
    COUNT(*)                                   AS "trip_cnt"
  FROM "NEW_YORK_GEO"."NEW_YORK"."TLC_YELLOW_TRIPS_2015"
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000
  GROUP BY "lat_3dec","lon_3dec","hour_slot_id"
)
SELECT
  "lat_3dec",
  "lon_3dec",
  "hour_slot_id",
  "trip_cnt",
  AVG("trip_cnt")    OVER (PARTITION BY "lat_3dec","lon_3dec" 
                           ORDER BY "hour_slot_id"
                           ROWS BETWEEN 14 PRECEDING AND 1 PRECEDING) AS "avg_prev_14hr",
  STDDEV_SAMP("trip_cnt") OVER (PARTITION BY "lat_3dec","lon_3dec"
                                ORDER BY "hour_slot_id"
                                ROWS BETWEEN 14 PRECEDING AND 1 PRECEDING) AS "stddev_prev_14hr"
FROM hr
ORDER BY "hour_slot_id"
LIMIT 20;
