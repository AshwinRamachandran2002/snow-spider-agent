/*------------------------------------------------------------------*/
/* 1)  Raw trips for the 21-day look-back window that feeds all      */
/*     lag / moving-average calculations (00:00 12-Dec-2014 …        */
/*     23:59 01-Jan-2015, UTC).  Keep only geometrically “sane”      */
/*     NYC coordinates.                                              */
--------------------------------------------------------------------*/
raw_trips AS (
    SELECT
        TO_TIMESTAMP_NTZ("pickup_datetime" / 1_000_000)                   AS pickup_ts ,
        DATE_TRUNC('hour', TO_TIMESTAMP_NTZ("pickup_datetime" / 1_000_000)) AS pickup_hr ,
        "pickup_latitude"                                                 AS lat ,
        "pickup_longitude"                                                AS lon
    FROM  "NEW_YORK_GEO"."NEW_YORK"."TLC_YELLOW_TRIPS_2015"
    WHERE "pickup_datetime"
          BETWEEN 1418342400000000          -- 2014-12-12 00:00 UTC
              AND 1420156799000000          -- 2015-01-01 23:59:59.9 UTC
      AND  "pickup_latitude"  BETWEEN 40  AND 41     -- coarse NYC box
      AND  "pickup_longitude" BETWEEN -75 AND -72
),

/*------------------------------------------------------------------*/
/* 2)  Attach each trip to its ZIP code via point-in-polygon.        */
--------------------------------------------------------------------*/
trips_zip AS (
    SELECT
        z."ZIP_CODE"                                      AS zip ,
        r.pickup_hr                                       AS hr ,
        COUNT(*)                                          AS trip_cnt
    FROM           raw_trips            r
    JOIN "GEO_US_BOUNDARIES"."PUBLIC"."ZIP_CODES"  z
      ON ST_CONTAINS( z."GEOG"
                     , TO_GEOGRAPHY(POINT(r.lon , r.lat)) )
    GROUP BY zip , hr
),

/*------------------------------------------------------------------*/
/* 3)  Build the “complete grid”: every NYC zip  ✕  every distinct  */
/*     hour that appears in the 21-day window.                      */
--------------------------------------------------------------------*/
all_zips AS (          /* distinct NYC ZIPs                             */
    SELECT DISTINCT "ZIP_CODE" AS zip
    FROM   "GEO_US_BOUNDARIES"."PUBLIC"."ZIP_CODES"
),
all_hrs  AS (          /* distinct hours from the data window           */
    SELECT DISTINCT hr
    FROM   trips_zip
),
zip_hr_grid AS (       /* cartesian product                             */
    SELECT z.zip , h.hr
    FROM   all_zips z
    CROSS  JOIN all_hrs h
),

/*------------------------------------------------------------------*/
/* 4)  Merge real counts onto the complete grid, filling gaps with 0 */
--------------------------------------------------------------------*/
zip_hr_filled AS (
    SELECT
        g.zip ,
        g.hr ,
        COALESCE(t.trip_cnt , 0) AS trip_cnt
    FROM   zip_hr_grid g
    LEFT   JOIN trips_zip  t
           ON  t.zip = g.zip
           AND t.hr  = g.hr
),

/*------------------------------------------------------------------*/
/* 5)  Compute requested lagged counts + moving averages / stdevs   */
/*------------------------------------------------------------------*/
enriched AS (
    SELECT
        zip ,
        hr ,
        trip_cnt ,

        /* lagged counts */
        LAG( trip_cnt ,  1)  OVER (PARTITION BY zip ORDER BY hr) AS trip_cnt_1h_ago  ,
        LAG( trip_cnt , 24)  OVER (PARTITION BY zip ORDER BY hr) AS trip_cnt_24h_ago ,
        LAG( trip_cnt ,168)  OVER (PARTITION BY zip ORDER BY hr) AS trip_cnt_7d_ago  ,
        LAG( trip_cnt ,336)  OVER (PARTITION BY zip ORDER BY hr) AS trip_cnt_14d_ago ,

        /* rolling windows – EXCLUDE CURRENT ROW */
        AVG( trip_cnt )       OVER (PARTITION BY zip ORDER BY hr
                                    ROWS BETWEEN 14*24 PRECEDING AND 1 PRECEDING) AS mov_avg_14d ,
        STDDEV_SAMP( trip_cnt)OVER (PARTITION BY zip ORDER BY hr
                                    ROWS BETWEEN 14*24 PRECEDING AND 1 PRECEDING) AS mov_std_14d ,
        AVG( trip_cnt )       OVER (PARTITION BY zip ORDER BY hr
                                    ROWS BETWEEN 21*24 PRECEDING AND 1 PRECEDING) AS mov_avg_21d ,
        STDDEV_SAMP( trip_cnt)OVER (PARTITION BY zip ORDER BY hr
                                    ROWS BETWEEN 21*24 PRECEDING AND 1 PRECEDING) AS mov_std_21d
    FROM zip_hr_filled
)

/*------------------------------------------------------------------*/
/* 6)  Restrict to 1-Jan-2015 hours only, then show the 5 busiest   */
/*     ZIP/hour slots.                                              */
--------------------------------------------------------------------*/
SELECT
    zip                                AS "zip_code" ,
    hr                                 AS "pickup_hour" ,
    trip_cnt                           AS "trip_cnt" ,
    trip_cnt_1h_ago ,
    trip_cnt_24h_ago ,
    trip_cnt_7d_ago ,
    trip_cnt_14d_ago ,
    mov_avg_14d ,
    mov_std_14d ,
    mov_avg_21d ,
    mov_std_21d
FROM   enriched
WHERE  hr BETWEEN '2015-01-01 00:00:00'::timestamp_ntz
            AND  '2015-01-01 23:00:00'::timestamp_ntz
ORDER  BY trip_cnt DESC NULLS LAST
LIMIT 5;
