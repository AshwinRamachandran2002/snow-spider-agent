```sql
/*  Hour-by-hour NYC yellow-cab demand on 1-Jan-2015
    – counts, lags, moving averages & stdevs – per ZIP code                 */

WITH boundary_zips AS (          -- NYC ZIP-code polygons
    SELECT
        "ZIPCODE" AS "zip_code",
        "GEOM"    AS "geom"
    FROM GEO_US_BOUNDARIES.PUBLIC.ZIP_CODES
    WHERE "STATE" = 'NY'                           -- keep NY-state ZIPs only
),

/* ---------------------------------------------------------------------- */
/*  Generate the full list of hours needed: 14-day look-back (336 h) plus
    1-Jan-2015 (24 h)  →  total 360 consecutive hours                     */
hours AS (
    SELECT
        DATEADD(
            hour,
            seq4(),
            TO_TIMESTAMP('2014-12-18 00:00:00')   -- 336 h before 2015-01-01 00:00
        ) AS "hour_ts"
    FROM TABLE(GENERATOR(ROWCOUNT => 360))
),

/*  Distinct NYC ZIP codes                                                 */
zips AS (
    SELECT DISTINCT "zip_code"
    FROM boundary_zips
),

/*  Cartesian grid of every ZIP × every hour                              */
grid AS (
    SELECT
        z."zip_code",
        h."hour_ts"
    FROM zips  z
    CROSS JOIN hours h
),

/* ---------------------------------------------------------------------- */
/*  Raw trips inside the 14-day window, keeping only sensible coordinates */
raw_trips AS (
    SELECT
        TO_TIMESTAMP("pickup_datetime"/1000000) AS "pickup_ts",
        "pickup_longitude"                      AS "lon",
        "pickup_latitude"                       AS "lat"
    FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
    WHERE "pickup_datetime" BETWEEN 1420070400000000 - 336*3600000000   -- 14 d back
                              AND     1420156800000000                  -- 1-Jan-2015 24:00
      AND "pickup_longitude" BETWEEN -75 AND -71
      AND "pickup_latitude"  BETWEEN  40 AND  42
),

/*  Attach each trip to its ZIP via a spatial point-in-polygon test        */
trips_with_zip AS (
    SELECT
        b."zip_code",
        DATE_TRUNC('hour', r."pickup_ts") AS "hour_ts"
    FROM raw_trips      r
    JOIN boundary_zips  b
      ON ST_CONTAINS(
             b."geom",
             TO_GEOGRAPHY( 'POINT(' || r."lon" || ' ' || r."lat" || ')' )
         )
),

/*  Hourly counts per ZIP                                                  */
agg AS (
    SELECT
        "zip_code",
        "hour_ts",
        COUNT(*) AS "trips"
    FROM trips_with_zip
    GROUP BY 1,2
),

/*  Place the counts onto the complete ZIP × hour grid, filling gaps with 0 */
filled AS (
    SELECT
        g."zip_code",
        g."hour_ts",
        COALESCE(a."trips", 0) AS "trips"
    FROM grid g
    LEFT JOIN agg a
           ON g."zip_code" = a."zip_code"
          AND g."hour_ts"  = a."hour_ts"
),

/*  Compute lags & moving statistics                                       */
metrics AS (
    SELECT
        "zip_code",
        "hour_ts",
        "trips",
        LAG("trips",   1) OVER (PARTITION BY "zip_code" ORDER BY "hour_ts") AS "trips_1hr_ago",
        LAG("trips",  24) OVER (PARTITION BY "zip_code" ORDER BY "hour_ts") AS "trips_24hr_ago",
        LAG("trips", 168) OVER (PARTITION BY "zip_code" ORDER BY "hour_ts") AS "trips_7d_ago",
        LAG("trips", 336) OVER (PARTITION BY "zip_code" ORDER BY "hour_ts") AS "trips_14d_ago",
        AVG   ("trips")   OVER (PARTITION BY "zip_code"
                                ORDER BY "hour_ts"
                                ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING) AS "ma_14d",
        AVG   ("trips")   OVER (PARTITION BY "zip_code"
                                ORDER BY "hour_ts"
                                ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING) AS "ma_21d",
        STDDEV("trips")   OVER (PARTITION BY "zip_code"
                                ORDER BY "hour_ts"
                                ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING) AS "std_14d"
    FROM filled
),

/*  Keep only the 24 hours of 1-Jan-2015                                    */
final AS (
    SELECT *
    FROM metrics
    WHERE "hour_ts" BETWEEN '2015-01-01 00:00:00'::TIMESTAMP
                        AND '2015-01-01 23:59:59'::TIMESTAMP
)

SELECT *
FROM final
ORDER BY "trips" DESC NULLS LAST
LIMIT 5;
```
