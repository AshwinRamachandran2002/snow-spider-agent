```sql
--Description: Quick look at raw rows in the 2015 yellow-cab table
SELECT 
  "pickup_datetime",
  "pickup_longitude",
  "pickup_latitude"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
LIMIT 20;
```

```sql
--Description: Distinct minimum / maximum pickup longitudes & latitudes observed in 2015
SELECT  
  MIN("pickup_longitude") AS "min_lon",
  MAX("pickup_longitude") AS "max_lon",
  MIN("pickup_latitude")  AS "min_lat",
  MAX("pickup_latitude")  AS "max_lat"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
LIMIT 20;
```

```sql
--Description: Preview only those trips whose coordinates look valid for the NYC area
SELECT 
  "pickup_datetime",
  "pickup_longitude",
  "pickup_latitude"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
WHERE "pickup_longitude" BETWEEN -75 AND -71
  AND "pickup_latitude"  BETWEEN  40 AND  42
LIMIT 20;
```

```sql
--Description: Inspect trips that occurred on 1-Jan-2015 (micro-seconds between 00:00 and 23:59)
SELECT 
  "pickup_datetime",
  "pickup_longitude",
  "pickup_latitude"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000
LIMIT 20;
```

```sql
--Description: Distinct hour “buckets” (integer hours since epoch) seen on 1-Jan-2015
SELECT DISTINCT 
  FLOOR("pickup_datetime"/3600000000) AS "hour_bucket"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000
ORDER BY "hour_bucket"
LIMIT 20;
```

```sql
--Description: Trip counts per hour on 1-Jan-2015
SELECT
  FLOOR("pickup_datetime"/3600000000) AS "hour_bucket",
  COUNT(*)                          AS "trips_in_hour"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000
GROUP BY 1
ORDER BY "trips_in_hour" DESC
LIMIT 20;
```

```sql
--Description: Bucket coordinates to ~0.01° grid, then count trips within each grid cell for 1-Jan-2015
SELECT
  ROUND("pickup_latitude",  2) AS "lat_bucket",
  ROUND("pickup_longitude", 2) AS "lon_bucket",
  COUNT(*)                    AS "trips_in_cell"
FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420156800000000
  AND "pickup_longitude" BETWEEN -75 AND -71
  AND "pickup_latitude"  BETWEEN  40 AND  42
GROUP BY 1,2
ORDER BY "trips_in_cell" DESC
LIMIT 20;
```

```sql
--Description: Hourly counts for the first week of 2015 with the count 1 hour earlier (lag)
WITH hrs AS (
  SELECT 
    FLOOR("pickup_datetime"/3600000000) AS "hour_bucket",
    COUNT(*)                            AS "trips"
  FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420684800000000   -- 1-Jan-2015 to 8-Jan-2015
  GROUP BY 1
)
SELECT 
  "hour_bucket",
  "trips",
  LAG("trips",1) OVER (ORDER BY "hour_bucket") AS "trips_1hr_ago"
FROM hrs
ORDER BY "hour_bucket"
LIMIT 20;
```

```sql
--Description: Same seven-day window, now compare each hour to 24 hours earlier
WITH hrs AS (
  SELECT 
    FLOOR("pickup_datetime"/3600000000) AS "hour_bucket",
    COUNT(*)                            AS "trips"
  FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1420684800000000
  GROUP BY 1
)
SELECT 
  "hour_bucket",
  "trips",
  LAG("trips",24) OVER (ORDER BY "hour_bucket") AS "trips_24hr_ago"
FROM hrs
ORDER BY "hour_bucket"
LIMIT 20;
```

```sql
--Description: Hourly counts for all of January 2015 including 14-day moving avg & stdev (excluding current hour)
WITH hrs AS (
  SELECT 
    FLOOR("pickup_datetime"/3600000000) AS "hour_bucket",
    COUNT(*)                            AS "trips"
  FROM NEW_YORK_GEO.NEW_YORK.TLC_YELLOW_TRIPS_2015
  WHERE "pickup_datetime" BETWEEN 1420070400000000 AND 1422748800000000   -- 1-Jan-2015 to 1-Feb-2015
  GROUP BY 1
)
SELECT 
  "hour_bucket",
  "trips",
  AVG("trips")  OVER (ORDER BY "hour_bucket" ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING)  AS "ma_14d",
  AVG("trips")  OVER (ORDER BY "hour_bucket" ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING)  AS "ma_21d",
  STDDEV("trips") OVER (ORDER BY "hour_bucket" ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING) AS "std_14d"
FROM hrs
ORDER BY "hour_bucket"
LIMIT 20;
```
