```sql
/*  Average number of units picked per product for Order 421
    (FIFO respected by ordering the pick-lines on their original line_no) */
WITH fifo_pick AS (
    SELECT
        "line_no",
        "product_id",
        "qty"
    FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE
    WHERE "order_id" = 421
    ORDER BY "line_no"         -- first-in / first-out sequence
)
SELECT
    pr."name"        AS "product_name",
    fp."product_id",
    AVG(fp."qty")    AS "avg_units_picked"
FROM fifo_pick fp
JOIN ORACLE_SQL.ORACLE_SQL.PRODUCTS pr
  ON pr."id" = fp."product_id"
GROUP BY fp."product_id", pr."name"
ORDER BY fp."product_id";
```
