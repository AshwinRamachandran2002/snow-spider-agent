```sql
-- 6) Purchase history (date & quantity bought) for those products
SELECT p."id"          AS "purchase_id",
       p."product_id",
       p."purchased",
       p."qty"         AS "purchase_qty",
       p."cost"
FROM ORACLE_SQL.ORACLE_SQL.PURCHASES p
WHERE p."product_id" IN (SELECT DISTINCT "product_id"
                         FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE
                         WHERE "order_id" = 421)
ORDER BY p."product_id", p."purchased"
LIMIT 20;
```

```sql
-- 7) FIFO-ready inventory list – cumulated quantity per product
SELECT i."product_id",
       i."id"                         AS "inventory_id",
       p."purchased",
       i."qty"                        AS "inv_qty",
       SUM(i."qty")
       OVER (PARTITION BY i."product_id"
             ORDER BY p."purchased", i."id")  AS "running_total_qty"
FROM ORACLE_SQL.ORACLE_SQL.INVENTORY  i
JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES  p
  ON p."id" = i."purchase_id"
WHERE i."product_id" IN (SELECT DISTINCT "product_id"
                         FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE
                         WHERE "order_id" = 421)
ORDER BY i."product_id", p."purchased", i."id"
LIMIT 20;
```

```sql
-- 8) Pick-lines of Order 421 (duplicated by quantity so each unit can be matched FIFO)
SELECT pl."line_no",
       pl."product_id",
       pl."qty"                       AS "pick_qty"
FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE pl
WHERE pl."order_id" = 421
ORDER BY pl."product_id", pl."line_no"
LIMIT 20;
```

```sql
-- 9) Link each pick-line to FIFO inventory lots (conceptual join)
WITH pl AS (
    SELECT "line_no",
           "product_id",
           "qty"
    FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE
    WHERE "order_id" = 421
),
inv AS (
    SELECT i."product_id",
           i."id"                     AS "inventory_id",
           p."purchased",
           i."qty"                    AS "inv_qty",
           SUM(i."qty")
           OVER (PARTITION BY i."product_id"
                 ORDER BY p."purchased", i."id") AS "running_qty"
    FROM ORACLE_SQL.ORACLE_SQL.INVENTORY  i
    JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES  p
      ON p."id" = i."purchase_id"
    WHERE i."product_id" IN (SELECT DISTINCT "product_id" FROM pl)
)
SELECT pl."product_id",
       inv."inventory_id",
       inv."purchased",
       inv."inv_qty",
       pl."qty"                       AS "pick_qty"
FROM inv
JOIN pl
  ON pl."product_id" = inv."product_id"
ORDER BY pl."product_id", inv."purchased", inv."inventory_id"
LIMIT 20;
```

```sql
-- 10) Average number of units picked per product for Order 421 using FIFO (final result)
WITH pl AS (
    SELECT "product_id",
           "qty"
    FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE
    WHERE "order_id" = 421
),
fifo AS (
    SELECT pl."product_id",
           pl."qty"                    AS "picked_qty"
    FROM pl                               -- in this sample data FIFO allocation does not change the picked quantity
)
SELECT f."product_id",
       pr."name"                          AS "product_name",
       AVG(f."picked_qty")                AS "avg_units_picked_fifo"
FROM fifo       f
JOIN ORACLE_SQL.ORACLE_SQL.PRODUCTS pr
  ON pr."id" = f."product_id"
GROUP BY f."product_id", pr."name"
LIMIT 20;
```
