```sql
--Description: 3)  Total quantity that was picked for each product in order 421
SELECT pl."product_id",
       pr."name"                       AS "product_name",
       SUM(pl."qty")                   AS "total_units_picked"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE"  pl
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PRODUCTS"      pr
  ON   pr."id" = pl."product_id"
WHERE  pl."order_id" = 421
GROUP  BY pl."product_id", pr."name"
LIMIT 20;
```

```sql
--Description: 4)  What inventory batches exist for the products that were picked
SELECT inv."id"            AS "inventory_id",
       inv."product_id",
       pur."purchased"     AS "purchased_date",
       inv."qty"           AS "onhand_units",
       inv."location_id"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  inv
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES" pur
  ON   pur."id" = inv."purchase_id"
WHERE  inv."product_id" IN ( SELECT DISTINCT "product_id"
                             FROM "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE"
                             WHERE "order_id" = 421 )
ORDER  BY inv."product_id", pur."purchased"
LIMIT 20;
```

```sql
--Description: 5)  Inventory batches per product ordered by purchase date (FIFO view)
SELECT inv."product_id",
       pur."purchased",
       inv."id"           AS "inventory_id",
       inv."qty"          AS "onhand_units"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  inv
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"  pur
  ON   pur."id" = inv."purchase_id"
WHERE  inv."product_id" IN ( SELECT DISTINCT "product_id"
                             FROM "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE"
                             WHERE "order_id" = 421 )
ORDER  BY inv."product_id", pur."purchased"
LIMIT 20;
```

```sql
--Description: 6)  Pick-lines for each product, numbered in the order they were made
SELECT pl."product_id",
       pl."line_no",
       pl."qty",
       ROW_NUMBER() OVER (PARTITION BY pl."product_id"
                          ORDER BY pl."line_no") AS "pick_seq"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
WHERE  pl."order_id" = 421
ORDER  BY pl."product_id", "pick_seq"
LIMIT 20;
```

```sql
--Description: 7)  Inventory batches for each product, numbered by oldest first (FIFO batches)
SELECT inv."product_id",
       pur."purchased",
       inv."id"                                AS "inventory_id",
       inv."qty",
       ROW_NUMBER() OVER (PARTITION BY inv."product_id"
                          ORDER BY pur."purchased") AS "fifo_batch_no"
FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  inv
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"  pur
  ON   pur."id" = inv."purchase_id"
WHERE  inv."product_id" IN ( SELECT DISTINCT "product_id"
                             FROM "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE"
                             WHERE "order_id" = 421 )
ORDER  BY inv."product_id", "fifo_batch_no"
LIMIT 20;
```

```sql
--Description: 8)  Combine cumulative picks with cumulative inventory to see which FIFO batches satisfy each pick-line
WITH ordered_picks AS (
    SELECT pl."product_id",
           pl."qty",
           pl."line_no",
           SUM(pl."qty") OVER (PARTITION BY pl."product_id"
                               ORDER BY pl."line_no")          AS "cum_pick"
    FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
    WHERE  pl."order_id" = 421
),
fifo_inventory AS (
    SELECT inv."product_id",
           inv."id"                            AS "inventory_id",
           inv."qty",
           pur."purchased",
           SUM(inv."qty") OVER (PARTITION BY inv."product_id"
                               ORDER BY pur."purchased")       AS "cum_inv"
    FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  inv
    JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"  pur
      ON   pur."id" = inv."purchase_id"
    WHERE  inv."product_id" IN (SELECT DISTINCT "product_id" FROM ordered_picks)
)
SELECT p."product_id",
       p."line_no",
       p."qty"                AS "picked_units",
       i."inventory_id",
       i."purchased"          AS "fifo_batch_purchased"
FROM   ordered_picks   p
JOIN   fifo_inventory  i
  ON   p."product_id" = i."product_id"
 AND   i."cum_inv" - i."qty" < p."cum_pick"
 AND   p."cum_pick" <= i."cum_inv"
ORDER  BY p."product_id", p."line_no", i."purchased"
LIMIT 20;
```

```sql
--Description: 9)  Average number of units picked per product for order 421 (FIFO batch details not needed for the average)
SELECT pl."product_id",
       pr."name"                            AS "product_name",
       AVG(pl."qty")                        AS "avg_units_picked"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE"  pl
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PRODUCTS"      pr
  ON   pr."id" = pl."product_id"
WHERE  pl."order_id" = 421
GROUP  BY pl."product_id", pr."name"
ORDER  BY pl."product_id"
LIMIT 20;
```

```sql
--Description: 10)  Final answer – show product, FIFO confirmation (oldest purchase date used), and the average units picked
WITH first_fifo_purchase AS (
    SELECT inv."product_id",
           MIN(pur."purchased") AS "oldest_purchase_date"
    FROM   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"  inv
    JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES" pur
      ON   pur."id" = inv."purchase_id"
    WHERE  inv."product_id" IN (
            SELECT DISTINCT "product_id"
            FROM "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE"
            WHERE "order_id" = 421)
    GROUP BY inv."product_id"
),
avg_picked AS (
    SELECT pl."product_id",
           AVG(pl."qty")      AS "avg_units_picked"
    FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
    WHERE  pl."order_id" = 421
    GROUP  BY pl."product_id"
)
SELECT a."product_id",
       pr."name"                 AS "product_name",
       f."oldest_purchase_date"  AS "fifo_start",
       a."avg_units_picked"
FROM   avg_picked            a
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PRODUCTS"          pr
  ON   pr."id" = a."product_id"
JOIN   first_fifo_purchase   f
  ON   f."product_id" = a."product_id"
ORDER  BY a."product_id"
LIMIT 20;
```
