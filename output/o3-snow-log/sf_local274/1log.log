```sql
WITH fifo_pick AS (
    /* 1)  Get every pick-line for order 421
       2)  Add a sequence per product based on the order the lines were created
           (FIFO = lowest line_no first)                                    */
    SELECT
        "product_id",
        "qty",
        ROW_NUMBER() OVER (PARTITION BY "product_id" 
                           ORDER BY "line_no") AS "fifo_no"
    FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE
    WHERE "order_id" = 421
)
SELECT
    fp."product_id",
    pr."name"                           AS "product_name",
    AVG(fp."qty")                       AS "avg_qty_picked"
FROM fifo_pick fp
LEFT JOIN ORACLE_SQL.ORACLE_SQL.PRODUCTS pr
       ON pr."id" = fp."product_id"
GROUP BY fp."product_id", pr."name"
ORDER BY fp."product_id";
```
