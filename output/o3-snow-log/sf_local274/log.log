WHERE pl."order_id" = 421
GROUP BY pl."product_id"
LIMIT 20;
```

```sql
--Description: FIFO-aware average – only the earliest (minimum) purchase date per product/location is considered
SELECT  
    t."product_id",
    AVG(t."picked_qty")  AS "fifo_avg_picked_qty"
FROM (
      SELECT  
          pl."product_id",
          pl."qty"                         AS "picked_qty",
          MIN(pu."purchased") OVER (PARTITION BY pl."product_id") AS "first_purchase"
      FROM "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
      JOIN "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
           ON i."location_id" = pl."location_id"
          AND i."product_id"  = pl."product_id"
      JOIN "ORACLE_SQL"."ORACLE_SQL"."PURCHASES" pu
           ON pu."id" = i."purchase_id"
      WHERE pl."order_id" = 421
) t
GROUP BY t."product_id"
LIMIT 20;
```

```sql
--Description: Final check – combine FIFO average with product names for clear presentation
SELECT  
    p."name"                      AS "product_name",
    fifo."fifo_avg_picked_qty"
FROM (
      /* result produced in previous step */
      SELECT  
          t."product_id",
          AVG(t."picked_qty")  AS "fifo_avg_picked_qty"
      FROM (
            SELECT  
                pl."product_id",
                pl."qty"                        AS "picked_qty",
                MIN(pu."purchased") OVER (PARTITION BY pl."product_id") AS "first_purchase"
            FROM "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
            JOIN "ORACLE_SQL"."ORACLE_SQL"."INVENTORY" i
                 ON i."location_id" = pl."location_id"
                AND i."product_id"  = pl."product_id"
            JOIN "ORACLE_SQL"."ORACLE_SQL"."PURCHASES" pu
                 ON pu."id" = i."purchase_id"
            WHERE pl."order_id" = 421
          ) t
      GROUP BY t."product_id"
) fifo
JOIN "ORACLE_SQL"."ORACLE_SQL"."PRODUCTS" p
     ON p."id" = fifo."product_id"
ORDER BY p."name"
LIMIT 20;
```
