```sql
/* Which products were picked for order 421 and the average number of units picked
   for each product (FIFO simply implies we use the pick-lines in the sequence they
   were created, which does not alter the arithmetic average). */

SELECT
    pl."product_id",
    pr."name"                       AS "product_name",
    AVG(pl."qty")                   AS "avg_units_picked"
FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"  AS pl
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"      AS pr
      ON pr."id" = pl."product_id"
WHERE pl."order_id" = 421
GROUP BY
    pl."product_id",
    pr."name"
ORDER BY
    pl."product_id";
```
