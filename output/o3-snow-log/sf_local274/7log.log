```

```sql
--Description: Average number of units picked per product for order 421
SELECT 
    "product_id",
    AVG("qty") AS "avg_qty_picked"
FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
WHERE "order_id" = 421
GROUP BY "product_id"
LIMIT 20;
```

```sql
--Description: All inventory buckets that still contain any of the products picked on order 421 (for FIFO checks)
SELECT 
    "id"           AS "inv_id",
    "product_id",
    "purchase_id",
    "location_id",
    "qty"
FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"
WHERE "product_id" IN (
      SELECT DISTINCT "product_id"
      FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
      WHERE "order_id" = 421 )
ORDER BY "product_id", "purchase_id"
LIMIT 20;
```

```sql
--Description: Purchases corresponding to those inventory buckets (to see the purchase/receipt dates -> FIFO)
SELECT 
    inv."product_id",
    inv."purchase_id",
    pur."purchased",
    pur."qty"      AS "purchased_qty",
    pur."cost"
FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  inv
JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" pur
      ON pur."id" = inv."purchase_id"
WHERE inv."product_id" IN (
      SELECT DISTINCT "product_id"
      FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
      WHERE "order_id" = 421 )
ORDER BY inv."product_id", pur."purchased"
LIMIT 20;
```

```sql
--Description: FIFO-style list: oldest receipts per product contrasted with what was picked for order 421
SELECT 
    pur."product_id",
    pur."purchased"            AS "received_date",
    pur."qty"                  AS "receipt_qty",
    pkl."qty"                  AS "picked_qty_for_order_421"
FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pkl
JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" pur
      ON pur."product_id" = pkl."product_id"
WHERE pkl."order_id" = 421
ORDER BY pur."product_id", pur."purchased"
LIMIT 20;
```

```sql
--Description: Check if any product picked for order 421 has defined minimum / purchase batch sizes
SELECT 
    pm."product_id",
    pm."qty_minimum",
    pm."qty_purchase"
FROM ORACLE_SQL.ORACLE_SQL."PRODUCT_MINIMUMS" pm
WHERE pm."product_id" IN (
      SELECT DISTINCT "product_id"
      FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
      WHERE "order_id" = 421 )
LIMIT 20;
```

```sql
--Description: Put everything together – product name, average picked, first receipt date (FIFO) for reference
SELECT 
    prd."name"                                     AS "product_name",
    pkl_stats."avg_qty_picked",
    MIN(pur."purchased")                           AS "fifo_first_receipt"
FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pkl
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS" prd
      ON prd."id" = pkl."product_id"
JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" pur
      ON pur."product_id" = pkl."product_id"
JOIN (
    SELECT "product_id", AVG("qty") AS "avg_qty_picked"
    FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
    WHERE "order_id" = 421
    GROUP BY "product_id"
) pkl_stats
      ON pkl_stats."product_id" = pkl."product_id"
WHERE pkl."order_id" = 421
GROUP BY prd."name", pkl_stats."avg_qty_picked"
ORDER BY prd."name"
LIMIT 20;
```
