```sql
--Description: Build FIFO inventory stacks (oldest first) and calculate running balance per product  
WITH inv AS (
    SELECT i."id"              AS "inv_id",
           i."product_id",
           i."qty"             AS "inv_qty",
           pu."purchased"      AS "purchased_date",
           SUM(i."qty") OVER (PARTITION BY i."product_id"
                              ORDER BY pu."purchased", i."id") 
               AS "cum_inv_qty"
    FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
    JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"  pu
           ON pu."id" = i."purchase_id"
    WHERE  i."product_id" IN (SELECT DISTINCT "product_id"
                              FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
                              WHERE "order_id" = 421)
)
SELECT *
FROM   inv
ORDER  BY "product_id", "purchased_date"
LIMIT 20;
```

```sql
--Description: Attach pick-lines to the FIFO layers to see which inventory lots satisfy each pick  
WITH inv AS (
    SELECT i."id"              AS "inv_id",
           i."product_id",
           i."qty"             AS "inv_qty",
           pu."purchased"      AS "purchased_date",
           SUM(i."qty") OVER (PARTITION BY i."product_id"
                              ORDER BY pu."purchased", i."id") 
               AS "cum_inv_qty"
    FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
    JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"  pu
           ON pu."id" = i."purchase_id"
    WHERE  i."product_id" IN (SELECT DISTINCT "product_id"
                              FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
                              WHERE "order_id" = 421)
),
picks AS (
    SELECT pl."line_no",
           pl."product_id",
           pl."qty"            AS "pick_qty",
           SUM(pl."qty") OVER (PARTITION BY pl."product_id"
                               ORDER BY pl."line_no") 
               AS "cum_pick_qty"
    FROM   ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
    WHERE  pl."order_id" = 421
)
SELECT pk."line_no",
       pk."product_id",
       pk."pick_qty",
       pk."cum_pick_qty",
       iv."inv_id",
       iv."purchased_date",
       iv."inv_qty",
       iv."cum_inv_qty"
FROM   picks pk
JOIN   inv   iv
       ON iv."product_id" = pk."product_id"
      AND iv."cum_inv_qty" >= pk."cum_pick_qty"
ORDER  BY pk."product_id", pk."line_no", iv."purchased_date"
LIMIT 20;
```

```sql
--Description: Allocate every picked unit to the oldest possible inventory lots (FIFO)  
WITH inv AS (
    SELECT i."id"              AS "inv_id",
           i."product_id",
           i."qty"             AS "inv_qty",
           pu."purchased"      AS "purchased_date",
           SUM(i."qty") OVER (PARTITION BY i."product_id"
                              ORDER BY pu."purchased", i."id") 
               AS "cum_inv_qty"
    FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
    JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"  pu
           ON pu."id" = i."purchase_id"
    WHERE  i."product_id" IN (SELECT DISTINCT "product_id"
                              FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
                              WHERE "order_id" = 421)
),
picks AS (
    SELECT pl."line_no",
           pl."product_id",
           pl."qty"            AS "pick_qty",
           SUM(pl."qty") OVER (PARTITION BY pl."product_id"
                               ORDER BY pl."line_no") 
               AS "cum_pick_qty"
    FROM   ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
    WHERE  pl."order_id" = 421
),
link AS (
    SELECT pk.*,
           MIN(iv."inv_id")   KEEP (DENSE_RANK FIRST ORDER BY iv."purchased_date", iv."inv_id")
               AS "fifo_inv_id"
    FROM   picks pk
    JOIN   inv   iv
           ON iv."product_id" = pk."product_id"
          AND iv."cum_inv_qty" >= pk."cum_pick_qty"
    GROUP  BY pk."line_no",
             pk."product_id",
             pk."pick_qty",
             pk."cum_pick_qty"
)
SELECT l.*,
       i."purchased_date"      AS "from_purchase_date"
FROM   link  l
JOIN   (SELECT i."id",
               pu."purchased" AS "purchased_date"
        FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY" i
        JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"  pu
               ON pu."id" = i."purchase_id")  i
       ON i."id" = l."fifo_inv_id"
ORDER  BY l."product_id", l."line_no"
LIMIT 20;
```

```sql
--Description: Final FIFO-based average quantity picked per product for order 421  
WITH fifo_alloc AS (
    /* the “link” CTE from previous query */
    WITH inv AS (
        SELECT i."id"              AS "inv_id",
               i."product_id",
               i."qty"             AS "inv_qty",
               pu."purchased"      AS "purchased_date",
               SUM(i."qty") OVER (PARTITION BY i."product_id"
                                  ORDER BY pu."purchased", i."id") 
                   AS "cum_inv_qty"
        FROM   ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
        JOIN   ORACLE_SQL.ORACLE_SQL."PURCHASES"  pu
               ON pu."id" = i."purchase_id"
        WHERE  i."product_id" IN (SELECT DISTINCT "product_id"
                                  FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
                                  WHERE "order_id" = 421)
    ),
    picks AS (
        SELECT pl."line_no",
               pl."product_id",
               pl."qty"            AS "pick_qty",
               SUM(pl."qty") OVER (PARTITION BY pl."product_id"
                                   ORDER BY pl."line_no") 
                   AS "cum_pick_qty"
        FROM   ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
        WHERE  pl."order_id" = 421
    )
    SELECT pk."product_id",
           pk."pick_qty"
    FROM   picks pk
    JOIN   inv   iv
           ON iv."product_id" = pk."product_id"
          AND iv."cum_inv_qty" >= pk."cum_pick_qty"
)
SELECT fa."product_id",
       p."name"                           AS "product_name",
       AVG(fa."pick_qty")                 AS "avg_fifo_picked_qty"
FROM   fifo_alloc fa
JOIN   ORACLE_SQL.ORACLE_SQL."PRODUCTS" p
       ON p."id" = fa."product_id"
GROUP  BY fa."product_id", p."name"
LIMIT 20;
```
