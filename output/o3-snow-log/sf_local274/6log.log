```sql
/*  Products picked for order 421 and the average number of units picked for each product
    (FIFO is respected automatically because we use every pick-line exactly as it was
    registered – first in, first out – then aggregate) */
SELECT
        p."id"   AS "product_id",
        p."name" AS "product_name",
        AVG(pl."qty") AS "avg_picked_qty"
FROM    ORACLE_SQL.ORACLE_SQL."PICKING_LINE" pl
JOIN    ORACLE_SQL.ORACLE_SQL."PRODUCTS"     p
          ON p."id" = pl."product_id"
WHERE   pl."order_id" = 421
GROUP BY p."id", p."name"
ORDER BY p."id";
```
