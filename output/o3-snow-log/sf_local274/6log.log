```

```sql
--Description: Show the distinct products that were picked for order 421
SELECT DISTINCT "product_id"
FROM "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE"
WHERE "order_id" = 421
LIMIT 20;
```

```sql
--Description: Join the picked lines with product names for better readability
SELECT pl."product_id",
       p."name"           AS "product_name",
       pl."qty"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PRODUCTS"     p
       ON p."id" = pl."product_id"
WHERE  pl."order_id" = 421
LIMIT 20;
```

```sql
--Description: Aggregate the picked quantities per product for order 421
SELECT pl."product_id",
       SUM(pl."qty") AS "total_picked_qty"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
WHERE  pl."order_id" = 421
GROUP  BY pl."product_id"
LIMIT 20;
```

```sql
--Description: Calculate the average quantity picked per line for each product on order 421
SELECT pl."product_id",
       AVG(pl."qty") AS "avg_picked_qty_per_line"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
WHERE  pl."order_id" = 421
GROUP  BY pl."product_id"
LIMIT 20;
```

```sql
--Description: Link each picked line to inventory entries at the same location to identify the stock batch (needed for FIFO)
SELECT pl."picklist_id",
       pl."line_no",
       pl."location_id",
       pl."product_id",
       pl."qty",
       i."purchase_id",
       i."qty"          AS "inv_qty_balance"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
JOIN   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"   i
       ON i."location_id" = pl."location_id"
      AND i."product_id"  = pl."product_id"
WHERE  pl."order_id" = 421
ORDER  BY pl."location_id"
LIMIT 20;
```

```sql
--Description: Add purchase information (date & cost) to the inventory rows to see which batch was first-in (FIFO)
SELECT pl."product_id",
       pu."purchased",
       pu."cost",
       pl."qty"      AS "picked_qty"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
JOIN   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"   i
       ON i."location_id" = pl."location_id"
      AND i."product_id"  = pl."product_id"
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"   pu
       ON pu."id" = i."purchase_id"
WHERE  pl."order_id" = 421
ORDER  BY pl."product_id", pu."purchased"
LIMIT 20;
```

```sql
--Description: For each product, find the earliest (FIFO) purchase date that still has inventory in the picked location set
SELECT pl."product_id",
       MIN(pu."purchased") AS "fifo_first_purchase_date"
FROM   "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
JOIN   "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"   i
       ON i."location_id" = pl."location_id"
      AND i."product_id"  = pl."product_id"
JOIN   "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"   pu
       ON pu."id" = i."purchase_id"
WHERE  pl."order_id" = 421
GROUP  BY pl."product_id"
LIMIT 20;
```

```sql
--Description: Combine FIFO first-purchase date with the average picked quantity per product for the final analysis
SELECT  pl."product_id",
        MIN(pu."purchased")                    AS "fifo_first_purchase_date",
        AVG(pl."qty")                          AS "avg_picked_qty_per_line"
FROM    "ORACLE_SQL"."ORACLE_SQL"."PICKING_LINE" pl
JOIN    "ORACLE_SQL"."ORACLE_SQL"."INVENTORY"    i
        ON i."location_id" = pl."location_id"
       AND i."product_id"  = pl."product_id"
JOIN    "ORACLE_SQL"."ORACLE_SQL"."PURCHASES"    pu
        ON pu."id" = i."purchase_id"
WHERE   pl."order_id" = 421
GROUP   BY pl."product_id"
ORDER   BY pl."product_id"
LIMIT 20;
```
