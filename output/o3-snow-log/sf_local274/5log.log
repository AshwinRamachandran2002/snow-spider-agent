```sql
--Description: Show inventory lots (FIFO layers) that reside in the same locations used for order 421
SELECT inv."id"            AS "inv_id",
       inv."location_id",
       inv."product_id",
       inv."purchase_id",
       inv."qty"
FROM ORACLE_SQL.ORACLE_SQL.INVENTORY inv
WHERE inv."location_id" IN (
      SELECT DISTINCT "location_id"
      FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE
      WHERE "order_id" = 421)
ORDER BY inv."product_id", inv."location_id"
LIMIT 20;
```

```sql
--Description: Add purchase dates to those inventory lots to establish FIFO order
SELECT inv."id"            AS "inv_id",
       inv."location_id",
       inv."product_id",
       pur."purchased"     AS "purchase_date",
       inv."qty"
FROM ORACLE_SQL.ORACLE_SQL.INVENTORY inv
JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES pur
  ON pur."id" = inv."purchase_id"
WHERE inv."location_id" IN (
      SELECT DISTINCT "location_id"
      FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE
      WHERE "order_id" = 421)
ORDER BY inv."product_id", pur."purchased"
LIMIT 20;
```

```sql
--Description: For each product/location pair used in order 421, select the oldest (FIFO) inventory layer
SELECT inv."product_id",
       inv."location_id",
       MIN(pur."purchased") AS "oldest_purchase_date"
FROM ORACLE_SQL.ORACLE_SQL.INVENTORY inv
JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES pur
  ON pur."id" = inv."purchase_id"
WHERE inv."location_id" IN (
      SELECT DISTINCT "location_id"
      FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE
      WHERE "order_id" = 421)
GROUP BY inv."product_id", inv."location_id"
LIMIT 20;
```

```sql
--Description: Combine FIFO inventory dates with picking lines for order 421
SELECT pl."line_no",
       pl."product_id",
       pl."qty",
       fifo."oldest_purchase_date"
FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE pl
JOIN (
    SELECT inv."product_id",
           inv."location_id",
           MIN(pur."purchased") AS "oldest_purchase_date"
    FROM ORACLE_SQL.ORACLE_SQL.INVENTORY inv
    JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES pur
      ON pur."id" = inv."purchase_id"
    WHERE inv."location_id" IN (
          SELECT DISTINCT "location_id"
          FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE
          WHERE "order_id" = 421)
    GROUP BY inv."product_id", inv."location_id"
) fifo
  ON fifo."product_id"  = pl."product_id"
 AND fifo."location_id" = pl."location_id"
WHERE pl."order_id" = 421
ORDER BY pl."line_no"
LIMIT 20;
```

```sql
--Description: Final summary – average picked units per product for order 421, annotated with FIFO first-purchase date
SELECT pl."product_id",
       p."name"                     AS "product_name",
       AVG(pl."qty")                AS "avg_picked_qty",
       MIN(fifo."oldest_purchase_date") AS "fifo_first_purchase_date"
FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE pl
JOIN ORACLE_SQL.ORACLE_SQL.PRODUCTS     p
  ON p."id" = pl."product_id"
LEFT JOIN (
    SELECT inv."product_id",
           inv."location_id",
           MIN(pur."purchased") AS "oldest_purchase_date"
    FROM ORACLE_SQL.ORACLE_SQL.INVENTORY inv
    JOIN ORACLE_SQL.ORACLE_SQL.PURCHASES pur
      ON pur."id" = inv."purchase_id"
    WHERE inv."location_id" IN (
          SELECT DISTINCT "location_id"
          FROM ORACLE_SQL.ORACLE_SQL.PICKING_LINE
          WHERE "order_id" = 421)
    GROUP BY inv."product_id", inv."location_id"
) fifo
  ON fifo."product_id"  = pl."product_id"
 AND fifo."location_id" = pl."location_id"
WHERE pl."order_id" = 421
GROUP BY pl."product_id", p."name"
ORDER BY pl."product_id"
LIMIT 20;
```


