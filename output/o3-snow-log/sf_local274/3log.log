```

```sql
--Description: 3) Show picked products together with their names  
SELECT pl."product_id", p."name"  
FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"  pl  
JOIN ORACLE_SQL.ORACLE_SQL."PRODUCTS"      p USING ("product_id")  
WHERE pl."order_id" = 421  
LIMIT 20;
```

```sql
--Description: 4) Display the inventory lots that still hold the picked products (to prepare for FIFO)  
SELECT i.*  
FROM ORACLE_SQL.ORACLE_SQL."INVENTORY" i  
WHERE i."product_id" IN (SELECT DISTINCT "product_id" 
                         FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE" 
                         WHERE "order_id" = 421)  
ORDER BY i."purchase_id"  
LIMIT 20;
```

```sql
--Description: 5) Add purchase information and date for those inventory lots  
SELECT i."id"               AS "inventory_id",
       i."product_id",
       i."qty",
       pu."purchased"
FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" pu
     ON pu."id" = i."purchase_id"
WHERE i."product_id" IN (SELECT DISTINCT "product_id"
                         FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
                         WHERE "order_id" = 421)
ORDER BY pu."purchased"
LIMIT 20;
```

```sql
--Description: 6) Check the chronological list of purchase lots per product (true FIFO sequence)  
SELECT i."product_id",
       pu."purchased",
       i."qty",
       ROW_NUMBER() OVER (PARTITION BY i."product_id" ORDER BY pu."purchased") AS "fifo_rank"
FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" pu
     ON pu."id" = i."purchase_id"
WHERE i."product_id" IN (SELECT DISTINCT "product_id"
                         FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
                         WHERE "order_id" = 421)
ORDER BY i."product_id", pu."purchased"
LIMIT 20;
```

```sql
--Description: 7) Compute the total quantity picked for each product in order 421  
SELECT "product_id",
       SUM("qty") AS "total_picked_qty"
FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
WHERE "order_id" = 421
GROUP BY "product_id"
LIMIT 20;
```

```sql
--Description: 8) Compute how many individual pick-lines were made per product for order 421  
SELECT "product_id",
       COUNT(*) AS "pickline_cnt"
FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
WHERE "order_id" = 421
GROUP BY "product_id"
LIMIT 20;
```

```sql
--Description: 9) Get the average number of units picked per product (simple average)  
SELECT "product_id",
       AVG("qty") AS "avg_units_per_pickline"
FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
WHERE "order_id" = 421
GROUP BY "product_id"
LIMIT 20;
```

```sql
--Description: 10) Final FIFO-aware average per product: spread the picked quantity over purchase lots in chronological order, then average  
WITH pl AS (  -- picked lines for the order
    SELECT "product_id", "qty"
    FROM ORACLE_SQL.ORACLE_SQL."PICKING_LINE"
    WHERE "order_id" = 421
), lots AS (  -- inventory lots in FIFO sequence
    SELECT i."product_id",
           i."qty"               AS "lot_qty",
           pu."purchased",
           ROW_NUMBER() OVER (PARTITION BY i."product_id"
                              ORDER BY pu."purchased") AS "fifo_rank"
    FROM ORACLE_SQL.ORACLE_SQL."INVENTORY"  i
    JOIN ORACLE_SQL.ORACLE_SQL."PURCHASES" pu
         ON pu."id" = i."purchase_id"
    WHERE i."product_id" IN (SELECT DISTINCT "product_id" FROM pl)
), spread AS (  -- use MATCH_RECOGNIZE-style logic by iterative subtraction
    SELECT l."product_id",
           l."fifo_rank",
           CASE
                WHEN SUM(pl."qty") OVER (PARTITION BY l."product_id"
                                         ORDER BY l."fifo_rank") <= l."lot_qty"
                     THEN SUM(pl."qty") OVER (PARTITION BY l."product_id"
                                              ORDER BY l."fifo_rank")
                ELSE l."lot_qty"
           END AS "picked_from_lot"
    FROM lots l
    JOIN pl   USING ("product_id")
    QUALIFY ROW_NUMBER() OVER (PARTITION BY l."product_id", l."fifo_rank") = 1
)
SELECT "product_id",
       AVG("picked_from_lot") AS "fifo_avg_units"
FROM spread
GROUP BY "product_id"
LIMIT 20;
```
