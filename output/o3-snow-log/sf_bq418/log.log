Below is a step-by-step set of at most ten Snowflake SQL queries that progressively explore the data needed to identify  
the three lowest-level Reactome pathways (with TAS evidence) that show the highest χ² statistics for Homo sapiens
targets of the drug sorafenib, under the specified assay constraints.

Each query is wrapped in a code block and preceded by a short description.

```sql
-- 1.  Find the Targetome drugID(s) that correspond to “sorafenib”
SELECT DISTINCT "drugID",
       "synonym"
FROM   "TARGETOME_REACTOME"."TARGETOME_VERSIONED"."DRUG_SYNONYMS_V1"
WHERE  "synonym" ILIKE '%sorafenib%'
LIMIT 20;
```

```sql
-- 2.  Preview all Targetome interactions that involve any of those sorafenib drugID(s)
SELECT DISTINCT i."interactionID",
       i."drugID",
       i."drugName",
       i."targetID",
       i."targetName",
       i."target_uniprotID",
       i."expID"
FROM   "TARGETOME_REACTOME"."TARGETOME_VERSIONED"."INTERACTIONS_V1"  i
WHERE  i."drugID" IN ( /*<< fill-in ids returned by query-1 >>*/ )
LIMIT 20;
```

```sql
-- 3.  Add experimental‐assay information and keep only records that satisfy:
--       median ≤ 100  AND  (low ≤ 100 OR NULL)  AND  (high ≤ 100 OR NULL)
SELECT DISTINCT i."interactionID",
       i."drugID",
       i."targetID",
       i."target_uniprotID",
       e."expID",
       e."exp_assayValueMedian",
       e."exp_assayValueLow",
       e."exp_assayValueHigh"
FROM   "TARGETOME_REACTOME"."TARGETOME_VERSIONED"."INTERACTIONS_V1"  i
JOIN   "TARGETOME_REACTOME"."TARGETOME_VERSIONED"."EXPERIMENTS_V1"   e
       ON i."expID" = e."expID"
WHERE  i."drugID" IN ( /* sorafenib ids */ )
  AND  (e."exp_assayValueMedian" IS NOT NULL AND e."exp_assayValueMedian" <= 100)
  AND  (e."exp_assayValueLow"   IS NULL OR e."exp_assayValueLow"  <= 100)
  AND  (e."exp_assayValueHigh"  IS NULL OR e."exp_assayValueHigh" <= 100)
LIMIT 20;
```

```sql
-- 4.  Restrict to Homo sapiens targets only
SELECT DISTINCT i."targetID",
       i."target_uniprotID"
FROM   "TARGETOME_REACTOME"."TARGETOME_VERSIONED"."INTERACTIONS_V1"  i
JOIN   "TARGETOME_REACTOME"."TARGETOME_VERSIONED"."EXPERIMENTS_V1"   e
       ON i."expID" = e."expID"
WHERE  i."drugID" IN ( /* sorafenib ids */ )
  AND  (e."exp_assayValueMedian" IS NOT NULL AND e."exp_assayValueMedian" <= 100)
  AND  (e."exp_assayValueLow"   IS NULL OR e."exp_assayValueLow"  <= 100)
  AND  (e."exp_assayValueHigh"  IS NULL OR e."exp_assayValueHigh" <= 100)
  AND  i."targetSpecies" = 'Homo sapiens'
LIMIT 20;
```

```sql
-- 5.  Map those Homo sapiens target UniProt IDs to Reactome physical-entity
--     stable IDs (one target may map to several PE IDs)
SELECT DISTINCT p."uniprot_id",
       p."stable_id"  AS "pe_stable_id",
       p."name"
FROM   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PHYSICAL_ENTITY_V77" p
JOIN  (
        /* query-4 with no LIMIT to provide the target UniProt set */
        SELECT DISTINCT i."target_uniprotID"
        FROM   "TARGETOME_REACTOME"."TARGETOME_VERSIONED"."INTERACTIONS_V1"  i
        JOIN   "TARGETOME_REACTOME"."TARGETOME_VERSIONED"."EXPERIMENTS_V1"   e
               ON i."expID" = e."expID"
        WHERE  i."drugID" IN ( /* sorafenib ids */ )
          AND  (e."exp_assayValueMedian" IS NOT NULL AND e."exp_assayValueMedian" <= 100)
          AND  (e."exp_assayValueLow"   IS NULL OR e."exp_assayValueLow"  <= 100)
          AND  (e."exp_assayValueHigh"  IS NULL OR e."exp_assayValueHigh" <= 100)
          AND  i."targetSpecies" = 'Homo sapiens'
      ) t
      ON  p."uniprot_id" = t."target_uniprotID"
LIMIT 20;
```

```sql
-- 6.  Link those physical entities to pathways that have TAS evidence
SELECT DISTINCT pep."pe_stable_id",
       pep."pathway_stable_id"
FROM   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PE_TO_PATHWAY_V77" pep
JOIN  ( /* PE list from query-5 */ ) pe
      ON pep."pe_stable_id" = pe."pe_stable_id"
WHERE  pep."evidence_code" = 'TAS'
LIMIT 20;
```

```sql
-- 7.  Keep only lowest-level, Homo sapiens pathways and pull pathway names
SELECT DISTINCT pep."pathway_stable_id"           AS "pathway_id",
       pw."name",
       pw."url"
FROM   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PE_TO_PATHWAY_V77" pep
JOIN   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PATHWAY_V77"       pw
       ON  pep."pathway_stable_id" = pw."stable_id"
JOIN  ( /* PE list from query-5 */ ) pe
       ON pep."pe_stable_id" = pe."pe_stable_id"
WHERE  pep."evidence_code" = 'TAS'
  AND  pw."species" = 'Homo sapiens'
  AND  pw."lowest_level" = TRUE
LIMIT 20;
```

```sql
-- 8.  For every TAS, lowest-level, Homo sapiens pathway obtain:
--       • count of sorafenib targets inside the pathway
SELECT   pw."stable_id"   AS "pathway_id",
         pw."name",
         COUNT(DISTINCT pe."pe_stable_id") AS "target_in_path"
FROM     "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PATHWAY_V77"       pw
JOIN     "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PE_TO_PATHWAY_V77" pep
         ON pw."stable_id" = pep."pathway_stable_id"
JOIN    ( /* PE list from query-5 */ ) pe
         ON pep."pe_stable_id" = pe."pe_stable_id"
WHERE    pep."evidence_code" = 'TAS'
  AND    pw."species"       = 'Homo sapiens'
  AND    pw."lowest_level"  = TRUE
GROUP BY pw."stable_id", pw."name"
LIMIT 20;
```

```sql
-- 9.  Build a universe of ALL Homo sapiens PE IDs that have TAS evidence to any
--     lowest-level pathway (needed for “non-target” counts)
SELECT DISTINCT pep."pe_stable_id"
FROM   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PE_TO_PATHWAY_V77" pep
JOIN   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PATHWAY_V77"       pw
       ON  pw."stable_id" = pep."pathway_stable_id"
WHERE  pep."evidence_code" = 'TAS'
  AND  pw."species"       = 'Homo sapiens'
  AND  pw."lowest_level"  = TRUE;
```

```sql
-- 10.  Final query – for every pathway, derive the 2×2 contingency counts
--      and compute the chi-squared statistic, then report the top three
WITH
sorafenib_targets AS (   -- PE IDs from query-5
    SELECT DISTINCT pe."pe_stable_id"
    FROM (
            /* full text of query-5 without LIMIT */
         ) pe
),
tas_hsap_pe AS (        -- universe from query-9
    SELECT DISTINCT pep."pe_stable_id"
    FROM   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PE_TO_PATHWAY_V77" pep
    JOIN   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PATHWAY_V77"       pw
           ON  pw."stable_id" = pep."pathway_stable_id"
    WHERE  pep."evidence_code" = 'TAS'
      AND  pw."species"       = 'Homo sapiens'
      AND  pw."lowest_level"  = TRUE
),
path_pe AS (            -- map each pathway to its PE IDs
    SELECT DISTINCT pep."pathway_stable_id",
           pep."pe_stable_id"
    FROM   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PE_TO_PATHWAY_V77" pep
    JOIN   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PATHWAY_V77"       pw
           ON  pw."stable_id" = pep."pathway_stable_id"
    WHERE  pep."evidence_code" = 'TAS'
      AND  pw."species"       = 'Homo sapiens'
      AND  pw."lowest_level"  = TRUE
),
contingency AS (
    SELECT
          p."pathway_stable_id"                      AS "pathway_id",
          SUM(CASE WHEN pe."pe_stable_id" IN (SELECT * FROM sorafenib_targets) THEN 1 ELSE 0 END) AS a_target_in,
          SUM(CASE WHEN pe."pe_stable_id" NOT IN (SELECT * FROM sorafenib_targets) THEN 1 ELSE 0 END) AS c_nontarget_in
    FROM  path_pe  p
    JOIN  tas_hsap_pe pe
          ON p."pe_stable_id" = pe."pe_stable_id"
    GROUP BY p."pathway_stable_id"
),
totals AS (
    SELECT
        (SELECT COUNT(*)  FROM sorafenib_targets)                       AS total_targets,
        (SELECT COUNT(*)  FROM tas_hsap_pe)                             AS universe_size
),
chi2 AS (
    SELECT
        c."pathway_id",
        c.a_target_in                                               AS a,
        (t.total_targets - c.a_target_in)                           AS b,
        c.c_nontarget_in                                            AS c,
        (t.universe_size - t.total_targets - c.c_nontarget_in)      AS d,
        t.universe_size                                             AS n,
        -- χ² = n*(ad - bc)² / ((a+b)(c+d)(a+c)(b+d))
        ( t.universe_size * POWER( (c.a_target_in * (t.universe_size - t.total_targets - c.c_nontarget_in)
                                   - (t.total_targets - c.a_target_in) * c.c_nontarget_in), 2)
          )
        /
        ((c.a_target_in + t.total_targets - c.a_target_in) *
         (c.c_nontarget_in + t.universe_size - t.total_targets - c.c_nontarget_in) *
         (c.a_target_in + c.c_nontarget_in) *
         (t.total_targets - c.a_target_in + t.universe_size - t.total_targets - c.c_nontarget_in)
        )                                                          AS chi_squared
    FROM   contingency  c
    CROSS JOIN totals   t
)
SELECT  chi."pathway_id",
        pw."name",
        chi.a                AS "targets_in_path",
        chi.b                AS "targets_outside_path",
        chi.c                AS "non_targets_in_path",
        chi.d                AS "non_targets_outside_path",
        chi.chi_squared
FROM    chi2  chi
JOIN    "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PATHWAY_V77" pw
        ON pw."stable_id" = chi."pathway_id"
ORDER BY chi.chi_squared DESC
LIMIT 3;
```

These ten queries (fill-in comments where indicated) will let you
(1) identify sorafenib in the Targetome,  
(2) isolate its Homo sapiens targets supported by assays that meet the ≤ 100-nM criteria,  
(3) map those targets to Reactome physical entities and TAS pathways, and  
(4) compute χ² statistics so you can list, for the top three pathways, the counts of targets and non-targets that lie inside and outside each pathway.
