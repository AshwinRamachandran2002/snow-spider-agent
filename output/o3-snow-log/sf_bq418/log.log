--Description: 10) Compute 2×2 contingency counts for every TAS, lowest-level
-- Homo sapiens pathway vs. sorafenib PE targets and return the three pathways
-- with the highest χ² statistic (plus target/non-target counts inside/outside).
WITH soraf_pe AS (           -- PE IDs associated with sorafenib targets
    SELECT DISTINCT p."stable_id" AS "pe_stable_id"
    FROM   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PHYSICAL_ENTITY_V77" p
    JOIN  (
            SELECT DISTINCT i."target_uniprotID"
            FROM   "TARGETOME_REACTOME"."TARGETOME_VERSIONED"."INTERACTIONS_V1" i
            JOIN   "TARGETOME_REACTOME"."TARGETOME_VERSIONED"."EXPERIMENTS_V1"  e
                   ON i."expID" = e."expID"
            WHERE  i."drugID" = 157
              AND  (e."exp_assayValueMedian" IS NOT NULL AND e."exp_assayValueMedian" <= 100)
              AND  (e."exp_assayValueLow"   IS NULL OR e."exp_assayValueLow"  <= 100)
              AND  (e."exp_assayValueHigh"  IS NULL OR e."exp_assayValueHigh" <= 100)
              AND  i."targetSpecies" = 'Homo sapiens'
          ) t
          ON p."uniprot_id" = t."target_uniprotID"
),
tas_hs_pe AS (               -- universe PE IDs (query-9)
    SELECT DISTINCT
           pep."pe_stable_id"
    FROM   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PE_TO_PATHWAY_V77"  pep
    JOIN   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PATHWAY_V77"        pw
           ON pw."stable_id" = pep."pathway_stable_id"
    WHERE  pep."evidence_code" = 'TAS'
      AND  pw."species"      = 'Homo sapiens'
      AND  pw."lowest_level" = TRUE
),
path_pe AS (                 -- map each pathway to its PE IDs
    SELECT DISTINCT
           pep."pathway_stable_id",
           pep."pe_stable_id"
    FROM   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PE_TO_PATHWAY_V77"  pep
    JOIN   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PATHWAY_V77"        pw
           ON pw."stable_id" = pep."pathway_stable_id"
    WHERE  pep."evidence_code" = 'TAS'
      AND  pw."species"      = 'Homo sapiens'
      AND  pw."lowest_level" = TRUE
),
cont AS (                     -- contingency pieces a & c for each pathway
    SELECT
        p."pathway_stable_id"                        AS "pathway_id",
        SUM(CASE WHEN p."pe_stable_id" IN (SELECT * FROM soraf_pe) THEN 1 ELSE 0 END) AS a,
        SUM(CASE WHEN p."pe_stable_id" NOT IN (SELECT * FROM soraf_pe) THEN 1 ELSE 0 END) AS c
    FROM  path_pe p
    GROUP BY p."pathway_stable_id"
),
tot AS (                      -- overall totals
    SELECT
        (SELECT COUNT(*) FROM soraf_pe)  AS total_targets,
        (SELECT COUNT(*) FROM tas_hs_pe) AS universe_size
),
chi2 AS (
    SELECT
        cont."pathway_id",
        cont.a,
        tot.total_targets - cont.a                         AS b,
        cont.c,
        tot.universe_size - tot.total_targets - cont.c     AS d,
        tot.universe_size                                   AS n,
        -- χ² computation
        ( tot.universe_size
          * POWER( (cont.a * (tot.universe_size - tot.total_targets - cont.c)
                     - (tot.total_targets - cont.a) * cont.c), 2 )
        )
        /
        ((cont.a + tot.total_targets - cont.a)
         * (cont.c + tot.universe_size - tot.total_targets - cont.c)
         * (cont.a + cont.c)
         * (tot.total_targets - cont.a + tot.universe_size - tot.total_targets - cont.c)
        ) AS chi_squared
    FROM cont
    CROSS JOIN tot
)
SELECT
       chi."pathway_id",
       pw."name",
       chi.a  AS "targets_in_path",
       chi.b  AS "targets_outside_path",
       chi.c  AS "non_targets_in_path",
       chi.d  AS "non_targets_outside_path",
       chi.chi_squared
FROM   chi2 chi
JOIN   "TARGETOME_REACTOME"."REACTOME_VERSIONED"."PATHWAY_V77" pw
       ON pw."stable_id" = chi."pathway_id"
ORDER BY chi.chi_squared DESC
LIMIT 3
