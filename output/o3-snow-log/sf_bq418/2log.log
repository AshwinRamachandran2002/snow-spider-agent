--Description: Compute contingency-table counts (targets/non-targets in/out) for each Sorafenib-associated pathway (max 20 rows).
WITH soraf_targets AS (
    SELECT DISTINCT i."target_uniprotID"
    FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1 i
    JOIN TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1 e
      ON i."expID" = e."expID"
    WHERE i."drugID" = 157
      AND i."targetSpecies" = 'Homo sapiens'
      AND COALESCE(e."exp_assayValueMedian",1000) <= 100
      AND (e."exp_assayValueLow"  <= 100 OR e."exp_assayValueLow"  IS NULL)
      AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
), soraf_pes AS (
    SELECT DISTINCT p."stable_id" AS "pe_stable_id"
    FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PHYSICAL_ENTITY_V77 p
    JOIN soraf_targets st
      ON p."uniprot_id" = st."target_uniprotID"
), tas_low_paths AS (
    SELECT DISTINCT pep."pathway_stable_id"
    FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77 pep
    WHERE pep."evidence_code" = 'TAS'
      AND pep."pe_stable_id" IN (SELECT "pe_stable_id" FROM soraf_pes)
      AND pep."pathway_stable_id" IN (
          SELECT "stable_id"
          FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77
          WHERE "lowest_level" = TRUE
      )
), universe AS (
    SELECT DISTINCT pep."pe_stable_id", pep."pathway_stable_id"
    FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77 pep
    WHERE pep."evidence_code" = 'TAS'
      AND pep."pathway_stable_id" IN (SELECT "pathway_stable_id" FROM tas_low_paths)
)
SELECT
       p."pathway_stable_id" AS "pathway_id",
       COUNT(DISTINCT CASE WHEN u."pe_stable_id" IN (SELECT "pe_stable_id" FROM soraf_pes) THEN u."pe_stable_id" END) AS "a_targets_in",
       (SELECT COUNT(DISTINCT "pe_stable_id") FROM soraf_pes)
         - COUNT(DISTINCT CASE WHEN u."pe_stable_id" IN (SELECT "pe_stable_id" FROM soraf_pes) THEN u."pe_stable_id" END)                 AS "b_targets_out",
       COUNT(DISTINCT CASE WHEN u."pe_stable_id" NOT IN (SELECT "pe_stable_id" FROM soraf_pes) THEN u."pe_stable_id" END)               AS "c_nontargets_in",
       (SELECT COUNT(DISTINCT "pe_stable_id") FROM universe)
         - COUNT(DISTINCT u."pe_stable_id")
         - ((SELECT COUNT(DISTINCT "pe_stable_id") FROM soraf_pes)
            - COUNT(DISTINCT CASE WHEN u."pe_stable_id" IN (SELECT "pe_stable_id" FROM soraf_pes) THEN u."pe_stable_id" END))           AS "d_nontargets_out"
FROM universe u
JOIN tas_low_paths p
  ON u."pathway_stable_id" = p."pathway_stable_id"
GROUP BY p."pathway_stable_id"
LIMIT 20;
