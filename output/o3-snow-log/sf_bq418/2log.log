--Description: Filter Sorafenib (drugID = 157) interactions to Homo sapiens targets whose potency values meet the ≤ 100 nM criteria; return distinct Target IDs and UniProt IDs (max 20 rows).
WITH good_exp AS (
    SELECT "expID"
    FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1
    WHERE COALESCE("exp_assayValueMedian",1000) <= 100
      AND ("exp_assayValueLow"  <= 100 OR "exp_assayValueLow"  IS NULL)
      AND ("exp_assayValueHigh" <= 100 OR "exp_assayValueHigh" IS NULL)
)
SELECT DISTINCT
       i."targetID",
       i."target_uniprotID"
FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1 i
JOIN good_exp e
  ON i."expID" = e."expID"
WHERE i."drugID" = 157
  AND i."targetSpecies" = 'Homo sapiens'
LIMIT 20
