```sql
-- 8.  Build a universe of all Homo sapiens physical entities that
--     have TAS evidence to any lowest-level pathway (needed for χ²)
WITH hp_pes AS (
    SELECT DISTINCT
           p."stable_id" AS "pe_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED.PHYSICAL_ENTITY_V77 p
    WHERE  p."location" IS NOT NULL              -- quick filter to real entities
      AND  p."uniprot_id" IS NOT NULL
), tas_low_paths AS ( ...same as query-7... )
SELECT DISTINCT
       pep."pe_stable_id",
       pep."pathway_stable_id"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77 pep
JOIN   tas_low_paths tlp
  ON   pep."pathway_stable_id" = tlp."stable_id"
JOIN   hp_pes hp
  ON   hp."pe_stable_id" = pep."pe_stable_id"
WHERE  pep."evidence_code" = 'TAS'
LIMIT 20;
```

```sql
-- 9.  Count  (a) Sorafenib targets in pathway,
--          (b) Sorafenib targets not in pathway,
--          (c) Non-targets in pathway,
--          (d) Non-targets not in pathway
WITH soraf_pes AS ( ...query-5... ),
     tas_low_paths AS ( ...query-7... ),
     universe AS ( ...query-8... )
SELECT
       tlp."stable_id"                                          AS "pathway_id",
       COUNT(DISTINCT CASE WHEN u."pe_stable_id" IN (SELECT "pe_stable_id" FROM soraf_pes) THEN u."pe_stable_id" END) AS "a_targets_in",
       (SELECT COUNT(*) FROM soraf_pes) -
       COUNT(DISTINCT CASE WHEN u."pe_stable_id" IN (SELECT "pe_stable_id" FROM soraf_pes) THEN u."pe_stable_id" END) AS "b_targets_out",
       COUNT(DISTINCT CASE WHEN u."pe_stable_id" NOT IN (SELECT "pe_stable_id" FROM soraf_pes) THEN u."pe_stable_id" END) AS "c_nontargets_in",
       (SELECT COUNT(*) FROM universe) -
       COUNT(DISTINCT u."pe_stable_id") -
       ((SELECT COUNT(*) FROM soraf_pes) -
        COUNT(DISTINCT CASE WHEN u."pe_stable_id" IN (SELECT "pe_stable_id" FROM soraf_pes) THEN u."pe_stable_id" END))  AS "d_nontargets_out"
FROM   universe u
JOIN   tas_low_paths tlp
  ON   u."pathway_stable_id" = tlp."stable_id"
GROUP BY tlp."stable_id"
LIMIT 20;
```

```sql
-- 10.  Compute χ² for each pathway and keep the top three
WITH counts AS ( ...query-9... )
SELECT
       "pathway_id",
       "a_targets_in",
       "b_targets_out",
       "c_nontargets_in",
       "d_nontargets_out",
       /*  χ² = (N(ad−bc)²)/((a+b)(c+d)(a+c)(b+d))  */
       ( ( ( "a_targets_in" * "d_nontargets_out" ) - ( "b_targets_out" * "c_nontargets_in" ) ) ^ 2
         * ( "a_targets_in" + "b_targets_out" + "c_nontargets_in" + "d_nontargets_out" )
       ) /
       NULLIF( ( "a_targets_in" + "b_targets_out" )
             * ( "c_nontargets_in" + "d_nontargets_out" )
             * ( "a_targets_in" + "c_nontargets_in" )
             * ( "b_targets_out" + "d_nontargets_out" ), 0)             AS "chi_squared"
FROM   counts
ORDER BY "chi_squared" DESC
LIMIT 3;
```
