```sql
-- 4.  Filter those interactions to keep only
--     • Homo sapiens targets
--     • experiments that satisfy the potency cut-offs
WITH good_exp AS (
    SELECT  "expID"
    FROM    TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1
    WHERE   COALESCE("exp_assayValueMedian",1000) <= 100
      AND  ( "exp_assayValueLow"  <= 100 OR "exp_assayValueLow"  IS NULL )
      AND  ( "exp_assayValueHigh" <= 100 OR "exp_assayValueHigh" IS NULL )
)
SELECT DISTINCT
       i."targetID",
       i."target_uniprotID"
FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1 i
JOIN   good_exp  e
  ON   i."expID" = e."expID"
WHERE  i."drugID"       = <<SORAFENIB_DRUG_ID>>
  AND  i."targetSpecies" = 'Homo sapiens'
LIMIT 20;
```

```sql
-- 5.  Map those Sorafenib targets to Reactome physical entities
WITH soraf_targets AS (
    SELECT DISTINCT i."target_uniprotID"
    FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1 i
    JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1 e
      ON   i."expID" = e."expID"
    WHERE  i."drugID"       = <<SORAFENIB_DRUG_ID>>
      AND  i."targetSpecies" = 'Homo sapiens'
      AND  COALESCE(e."exp_assayValueMedian",1000) <= 100
      AND (e."exp_assayValueLow"  <= 100 OR e."exp_assayValueLow"  IS NULL)
      AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
)
SELECT DISTINCT
       p."stable_id"        AS "pe_stable_id",
       p."uniprot_id"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED.PHYSICAL_ENTITY_V77 p
JOIN   soraf_targets st
  ON   p."uniprot_id" = st."target_uniprotID"
LIMIT 20;
