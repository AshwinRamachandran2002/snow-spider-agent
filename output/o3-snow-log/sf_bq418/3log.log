--Description:  Find the three lowest-level Homo sapiens Reactome pathways (TAS evidence)
--              having the highest Pearson chi-squared statistic when comparing potent
--              Sorafenib targets (T) to all other physical entities (N) inside vs. outside
--              each pathway.  “Potent” = assays with median ≤ 100 nM and low/high ≤ 100 nM
--              (or NULL).  The query returns pathway ID, pathway name, and the four cell
--              counts (T_in, N_in, T_out, N_out) plus the chi-square value.

WITH
/* 1)  Potent Sorafenib (drugID = 157) human targets → Reactome PE IDs */
soraf_targets AS (
    SELECT DISTINCT p."stable_id" AS pe_stable_id
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED.PHYSICAL_ENTITY_V77  p
    JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1     i
           ON p."uniprot_id" = i."target_uniprotID"
    JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1      e
           ON i."expID" = e."expID"
    WHERE  i."drugID" = 157
      AND  i."targetSpecies" ILIKE '%Homo sapiens%'
      AND  COALESCE(e."exp_assayValueMedian", 1e9) <= 100
      AND (e."exp_assayValueLow"  <= 100 OR e."exp_assayValueLow"  IS NULL)
      AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
),
/* 2)  TAS PE-to-pathway links restricted to lowest-level Homo sapiens pathways */
tas_links AS (
    SELECT pe2p."pe_stable_id",
           pe2p."pathway_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77  pe2p
    JOIN   TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77        pw
           ON pw."stable_id" = pe2p."pathway_stable_id"
    WHERE  pe2p."evidence_code" = 'TAS'
      AND  pw."species" ILIKE '%Homo sapiens%'
      AND  pw."lowest_level" = TRUE
),
/* 3)  Universe of all PEs present in any TAS pathway above */
universe AS (
    SELECT DISTINCT pe_stable_id FROM tas_links
),
/* 4)  Counts inside each pathway (T_in, total_in) */
inside AS (
    SELECT
        tl."pathway_stable_id"            AS pathway_id,
        COUNT(*)                          AS total_in,
        COUNT(st.pe_stable_id)            AS T_in
    FROM   tas_links tl
    LEFT  JOIN soraf_targets st
           ON tl.pe_stable_id = st.pe_stable_id
    GROUP BY tl."pathway_stable_id"
),
/* 5)  Overall universe totals */
totals AS (
    SELECT
        (SELECT COUNT(*) FROM soraf_targets)        AS T_total,
        (SELECT COUNT(*) FROM universe)             AS U_total
)
/* 6)  Assemble 2×2 counts and compute chi-square; return top 3 pathways */
SELECT
       ic.pathway_id,
       pw."name"                                    AS pathway_name,
       ic.T_in                                      AS targets_in_pathway,
       ic.total_in - ic.T_in                        AS non_targets_in_pathway,
       t.T_total - ic.T_in                          AS targets_outside_pathway,
       (t.U_total - t.T_total)
         - (ic.total_in - ic.T_in)                  AS non_targets_outside_pathway,
       /* Pearson chi-square statistic (2×2) */
       (
         POWER(ic.T_in -
               (ic.total_in * t.T_total / t.U_total), 2) /
               NULLIF(ic.total_in * t.T_total / t.U_total, 0)
       + POWER((ic.total_in - ic.T_in) -
               (ic.total_in * (t.U_total - t.T_total) / t.U_total), 2) /
               NULLIF(ic.total_in * (t.U_total - t.T_total) / t.U_total, 0)
       + POWER((t.T_total - ic.T_in) -
               ((t.U_total - ic.total_in) * t.T_total / t.U_total), 2) /
               NULLIF((t.U_total - ic.total_in) * t.T_total / t.U_total, 0)
       + POWER(((t.U_total - t.T_total) - (ic.total_in - ic.T_in)) -
               ((t.U_total - ic.total_in) * (t.U_total - t.T_total) / t.U_total), 2) /
               NULLIF((t.U_total - ic.total_in) * (t.U_total - t.T_total) / t.U_total, 0)
       )                                           AS chi_squared
FROM   inside ic
CROSS  JOIN totals t
JOIN   TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77 pw
       ON pw."stable_id" = ic.pathway_id
ORDER  BY chi_squared DESC
LIMIT 3;
```
