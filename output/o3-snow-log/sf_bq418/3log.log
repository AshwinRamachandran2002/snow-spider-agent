--Description:  Build a 2×2 contingency-table count for every lowest-level Homo sapiens
--              Reactome pathway that has TAS evidence.  “Potent Sorafenib targets” are
--              human targets (drugID = 157) with median ≤ 100 nM and low/high ≤ 100 nM
--              or NULL.  For each pathway the query returns:
--                  • targets_in_pathway
--                  • non_targets_in_pathway
--                  • targets_outside_pathway
--                  • non_targets_outside_pathway
--              These counts can later be used for chi-square calculation.
WITH
/* 1)  Potent Sorafenib human targets mapped to Reactome physical entities (PEs) */
soraf_targets AS (
    SELECT DISTINCT p."stable_id" AS pe_stable_id
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED.PHYSICAL_ENTITY_V77  p
    JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1     i
           ON p."uniprot_id" = i."target_uniprotID"
    JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1      e
           ON i."expID" = e."expID"
    WHERE  i."drugID" = 157
      AND  i."targetSpecies" ILIKE '%Homo sapiens%'
      AND  COALESCE(e."exp_assayValueMedian", 1e9) <= 100
      AND (e."exp_assayValueLow"  <= 100 OR e."exp_assayValueLow"  IS NULL)
      AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
),
/* 2)  TAS PE→pathway links restricted to Homo sapiens lowest-level pathways */
tas_links AS (
    SELECT DISTINCT pe2p."pe_stable_id",
           pe2p."pathway_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77  pe2p
    JOIN   TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77        pw
           ON pw."stable_id" = pe2p."pathway_stable_id"
    WHERE  pe2p."evidence_code" = 'TAS'
      AND  pw."species" ILIKE '%Homo sapiens%'
      AND  pw."lowest_level" = TRUE
),
/* 3)  Universe of all PEs that occur in any TAS pathway above */
universe AS (
    SELECT DISTINCT pe_stable_id FROM tas_links
),
/* 4)  Inside-pathway counts (targets_in & total_in) */
inside_counts AS (
    SELECT
        tl."pathway_stable_id"                         AS pathway_id,
        COUNT(tl.pe_stable_id)                         AS total_in,
        COUNT(st.pe_stable_id)                         AS targets_in
    FROM   tas_links tl
    LEFT  JOIN soraf_targets st
           ON tl.pe_stable_id = st.pe_stable_id
    GROUP BY tl."pathway_stable_id"
),
/* 5)  Global universe totals (single row) */
totals AS (
    SELECT
        (SELECT COUNT(*) FROM soraf_targets)  AS T_total,
        (SELECT COUNT(*) FROM universe)       AS U_total
)
/* 6)  Final 2×2 counts per pathway */
SELECT
       ic.pathway_id,
       ic.targets_in                                            AS targets_in_pathway,
       ic.total_in - ic.targets_in                              AS non_targets_in_pathway,
       t.T_total - ic.targets_in                                AS targets_outside_pathway,
       (t.U_total - t.T_total) - (ic.total_in - ic.targets_in)  AS non_targets_outside_pathway
FROM   inside_counts ic
CROSS  JOIN totals t
ORDER  BY ic.targets_in_pathway DESC
LIMIT 20;
