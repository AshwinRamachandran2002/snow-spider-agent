```sql
--Description: 9)  For each lowest-level pathway, count Sorafenib targets (T) vs. all other Homo sapiens physical entities (N) inside/outside  
WITH soraf_targets AS ( /* query-6 returning distinct pe_stable_id */ ),
     tas_paths     AS ( /* query-8 returning distinct pathway_id */ ),
     tas_links     AS (
         SELECT pe2p."pe_stable_id",
                pe2p."pathway_stable_id"
         FROM   TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77 pe2p
         WHERE  pe2p."evidence_code" = 'TAS'
     ),
     universe AS (  --all Homo sapiens physical entities linked (TAS) to any lowest-level pathway
         SELECT DISTINCT pe2p."pe_stable_id"
         FROM   TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77 pe2p
         JOIN   TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77 pw
                ON pw."stable_id" = pe2p."pathway_stable_id"
         WHERE  pw."species" ILIKE '%Homo sapiens%'
           AND  pw."lowest_level" = TRUE
           AND  pe2p."evidence_code" = 'TAS'
     )
SELECT
       tp."pathway_stable_id"                     AS "pathway_id",
       SUM(CASE WHEN st."pe_stable_id" IS NOT NULL      THEN 1 ELSE 0 END) AS "targets_in_pathway",
       SUM(CASE WHEN st."pe_stable_id" IS NULL        THEN 1 ELSE 0 END) AS "non_targets_in_pathway",
       SUM(CASE WHEN st2."pe_stable_id" IS NOT NULL     THEN 1 ELSE 0 END) AS "targets_outside_pathway",
       SUM(CASE WHEN st2."pe_stable_id" IS NULL       THEN 1 ELSE 0 END) AS "non_targets_outside_pathway"
FROM   tas_links  tp
JOIN   universe   u  ON u."pe_stable_id" = tp."pe_stable_id"
LEFT  JOIN soraf_targets st   ON st."pe_stable_id" = tp."pe_stable_id"
LEFT  JOIN soraf_targets st2  ON st2."pe_stable_id" = u."pe_stable_id" AND st2."pe_stable_id" NOT IN
                                                     (SELECT "pe_stable_id" FROM tas_links WHERE "pathway_stable_id" = tp."pathway_stable_id")
GROUP  BY tp."pathway_stable_id"
ORDER  BY "targets_in_pathway" DESC
LIMIT 20;
```

```sql
--Description: 10)  Extend query-9 by adding a Pearson chi-squared statistic for each pathway  
WITH soraf_targets AS ( /* same as in query-9 */ ),
     tas_paths     AS ( /* same as in query-8 */ ),
     tas_links     AS ( /* same as in query-9 */ ),
     universe AS    ( /* same as in query-9 */ ),
     counts AS (
         SELECT
              tp."pathway_stable_id",
              SUM(CASE WHEN st."pe_stable_id" IS NOT NULL  THEN 1 ELSE 0 END)  AS T_in,
              SUM(CASE WHEN st."pe_stable_id" IS NULL      THEN 1 ELSE 0 END)  AS N_in,
              SUM(CASE WHEN st2."pe_stable_id" IS NOT NULL THEN 1 ELSE 0 END)  AS T_out,
              SUM(CASE WHEN st2."pe_stable_id" IS NULL     THEN 1 ELSE 0 END)  AS N_out
         FROM   tas_links  tp
         JOIN   universe   u  ON u."pe_stable_id" = tp."pe_stable_id"
         LEFT  JOIN soraf_targets st   ON st."pe_stable_id" = tp."pe_stable_id"
         LEFT  JOIN soraf_targets st2  ON st2."pe_stable_id" = u."pe_stable_id"
                                          AND st2."pe_stable_id" NOT IN
                                              (SELECT "pe_stable_id"
                                               FROM tas_links
                                               WHERE "pathway_stable_id" = tp."pathway_stable_id")
         GROUP BY tp."pathway_stable_id"
     )
SELECT
       c."pathway_stable_id",
       c.T_in, c.N_in, c.T_out, c.N_out,
       -- Chi-square = Σ( (observed-expected)^2 / expected )
       (  POWER(c.T_in  - ((c.T_in+c.T_out)*(c.T_in+c.N_in) / NULLIF((c.T_in+c.N_in+c.T_out+c.N_out),0)), 2)
        / NULLIF((c.T_in+c.T_out)*(c.T_in+c.N_in) / NULLIF((c.T_in+c.N_in+c.T_out+c.N_out),0),0)
       +  POWER(c.N_in  - ((c.N_in+c.N_out)*(c.T_in+c.N_in) / NULLIF((c.T_in+c.N_in+c.T_out+c.N_out),0)), 2)
        / NULLIF((c.N_in+c.N_out)*(c.T_in+c.N_in) / NULLIF((c.T_in+c.N_in+c.T_out+c.N_out),0),0)
       +  POWER(c.T_out - ((c.T_in+c.T_out)*(c.T_out+c.N_out) / NULLIF((c.T_in+c.N_in+c.T_out+c.N_out),0)), 2)
        / NULLIF((c.T_in+c.T_out)*(c.T_out+c.N_out) / NULLIF((c.T_in+c.N_in+c.T_out+c.N_out),0),0)
       +  POWER(c.N_out - ((c.N_in+c.N_out)*(c.T_out+c.N_out) / NULLIF((c.T_in+c.N_in+c.T_out+c.N_out),0)), 2)
        / NULLIF((c.N_in+c.N_out)*(c.T_out+c.N_out) / NULLIF((c.T_in+c.N_in+c.T_out+c.N_out),0),0)
       ) AS "chi_squared"
FROM   counts c
ORDER  BY "chi_squared" DESC
LIMIT 20;
```
