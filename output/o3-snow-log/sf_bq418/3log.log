      AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
),
tas_links AS (
    SELECT pe2p."pe_stable_id",
           pe2p."pathway_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77 pe2p
    JOIN   TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77       pw
           ON pw."stable_id" = pe2p."pathway_stable_id"
    WHERE  pe2p."evidence_code" = 'TAS'
      AND  pw."species" ILIKE '%Homo sapiens%'
      AND  pw."lowest_level" = TRUE
),
universe AS (
    SELECT DISTINCT "pe_stable_id"
    FROM   tas_links
),
counts AS (
    SELECT
        tl."pathway_stable_id",
        SUM(CASE WHEN st."pe_stable_id" IS NOT NULL THEN 1 ELSE 0 END) AS T_in,
        SUM(CASE WHEN st."pe_stable_id" IS NULL      THEN 1 ELSE 0 END) AS N_in,
        SUM(CASE WHEN ut."pe_stable_id" IS NOT NULL THEN 1 ELSE 0 END) AS T_out,
        SUM(CASE WHEN ut."pe_stable_id" IS NULL      THEN 1 ELSE 0 END) AS N_out
    FROM   tas_links tl
    JOIN   universe  u   ON u."pe_stable_id" = tl."pe_stable_id"
    LEFT  JOIN soraf_targets st ON st."pe_stable_id" = tl."pe_stable_id"
    LEFT  JOIN soraf_targets ut ON ut."pe_stable_id" = u."pe_stable_id"
                                  AND ut."pe_stable_id" NOT IN (
                                      SELECT "pe_stable_id"
                                      FROM   tas_links
                                      WHERE  "pathway_stable_id" = tl."pathway_stable_id"
                                  )
    GROUP BY tl."pathway_stable_id"
)
SELECT
       c."pathway_stable_id",
       c.T_in, c.N_in, c.T_out, c.N_out,
       -- Chi-square calculation for 2×2 table
       ( POWER(c.T_in  - ((c.T_in + c.T_out) * (c.T_in + c.N_in)   /
            NULLIF((c.T_in + c.N_in + c.T_out + c.N_out),0)), 2) /
         NULLIF(((c.T_in + c.T_out) * (c.T_in + c.N_in)   /
           NULLIF((c.T_in + c.N_in + c.T_out + c.N_out),0)),0)
       + POWER(c.N_in  - ((c.N_in + c.N_out) * (c.T_in + c.N_in)   /
            NULLIF((c.T_in + c.N_in + c.T_out + c.N_out),0)), 2) /
         NULLIF(((c.N_in + c.N_out) * (c.T_in + c.N_in)   /
           NULLIF((c.T_in + c.N_in + c.T_out + c.N_out),0)),0)
       + POWER(c.T_out - ((c.T_in + c.T_out) * (c.T_out + c.N_out) /
            NULLIF((c.T_in + c.N_in + c.T_out + c.N_out),0)), 2) /
         NULLIF(((c.T_in + c.T_out) * (c.T_out + c.N_out) /
           NULLIF((c.T_in + c.N_in + c.T_out + c.N_out),0)),0)
       + POWER(c.N_out - ((c.N_in + c.N_out) * (c.T_out + c.N_out) /
            NULLIF((c.T_in + c.N_in + c.T_out + c.N_out),0)), 2) /
         NULLIF(((c.N_in + c.N_out) * (c.T_out + c.N_out) /
           NULLIF((c.T_in + c.N_in + c.T_out + c.N_out),0)),0)
       ) AS "chi_squared"
FROM   counts c
ORDER  BY "chi_squared" DESC
LIMIT 20;
```
