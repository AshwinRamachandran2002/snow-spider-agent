```sql
--Description: 1)  List all drug names in TARGETOME that look like Sorafenib  
SELECT DISTINCT "drugName"
FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1
WHERE "drugName" ILIKE '%sorafenib%'
LIMIT 20;
```

```sql
--Description: 2)  Show Sorafenib – target interactions (one line per target / expID)  
SELECT DISTINCT
       "interactionID",
       "targetID",
       "targetName",
       "target_uniprotID",
       "targetSpecies",
       "expID"
FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1
WHERE "drugName" ILIKE '%sorafenib%'
LIMIT 20;
```

```sql
--Description: 3)  Join to EXPERIMENTS and keep only rows that satisfy every assay ≤ 100 (or NULL)  
SELECT
       i."interactionID",
       i."targetID",
       i."targetName",
       i."target_uniprotID",
       e."exp_assayValueMedian",
       e."exp_assayValueLow",
       e."exp_assayValueHigh"
FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1  i
JOIN TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1  e
     ON i."expID" = e."expID"
WHERE i."drugName" ILIKE '%sorafenib%'
  AND (e."exp_assayValueMedian" <= 100 OR e."exp_assayValueMedian" IS NULL)
  AND (e."exp_assayValueLow"   <= 100 OR e."exp_assayValueLow"   IS NULL)
  AND (e."exp_assayValueHigh"  <= 100 OR e."exp_assayValueHigh"  IS NULL)
LIMIT 20;
```

```sql
--Description: 4)  Homo sapiens Sorafenib targets that pass the assay filters  
SELECT DISTINCT
       i."targetID",
       i."targetName",
       i."target_uniprotID"
FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1  i
JOIN TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1  e
     ON i."expID" = e."expID"
WHERE i."drugName" ILIKE '%sorafenib%'
  AND i."targetSpecies" = 'Homo sapiens'
  AND (e."exp_assayValueMedian" <= 100 OR e."exp_assayValueMedian" IS NULL)
  AND (e."exp_assayValueLow"   <= 100 OR e."exp_assayValueLow"   IS NULL)
  AND (e."exp_assayValueHigh"  <= 100 OR e."exp_assayValueHigh"  IS NULL)
LIMIT 20;
```

```sql
--Description: 5)  Map those Human targets to Reactome physical-entity (PE) stable IDs  
SELECT DISTINCT
       t."targetID",
       t."target_uniprotID",
       p."stable_id"   AS "pe_stable_id"
FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1  t
JOIN TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1   e
       ON t."expID" = e."expID"
JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PHYSICAL_ENTITY_V77 p
       ON p."uniprot_id" = t."target_uniprotID"
WHERE t."drugName" ILIKE '%sorafenib%'
  AND t."targetSpecies" = 'Homo sapiens'
  AND (e."exp_assayValueMedian" <= 100 OR e."exp_assayValueMedian" IS NULL)
  AND (e."exp_assayValueLow"   <= 100 OR e."exp_assayValueLow"   IS NULL)
  AND (e."exp_assayValueHigh"  <= 100 OR e."exp_assayValueHigh"  IS NULL)
LIMIT 20;
```

```sql
--Description: 6)  Link those PE IDs to TAS-supported Reactome pathways  
SELECT DISTINCT
       pe."pe_stable_id",
       rel."pathway_stable_id"
FROM (
      SELECT DISTINCT p."stable_id" AS "pe_stable_id"
      FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1  t
      JOIN TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1   e
            ON t."expID" = e."expID"
      JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PHYSICAL_ENTITY_V77 p
            ON p."uniprot_id" = t."target_uniprotID"
      WHERE t."drugName" ILIKE '%sorafenib%'
        AND t."targetSpecies" = 'Homo sapiens'
        AND (e."exp_assayValueMedian" <= 100 OR e."exp_assayValueMedian" IS NULL)
        AND (e."exp_assayValueLow"   <= 100 OR e."exp_assayValueLow"   IS NULL)
        AND (e."exp_assayValueHigh"  <= 100 OR e."exp_assayValueHigh"  IS NULL)
     ) pe
JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77  rel
     ON pe."pe_stable_id" = rel."pe_stable_id"
WHERE rel."evidence_code" = 'TAS'
LIMIT 20;
```

```sql
--Description: 7)  Retrieve pathway metadata (only Homo sapiens & lowest-level) for TAS pathways  
SELECT DISTINCT
       pw."stable_id",
       pw."name",
       pw."lowest_level",
       pw."species"
FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77 pw
WHERE pw."stable_id" IN (
      SELECT rel."pathway_stable_id"
      FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77 rel
      WHERE rel."evidence_code" = 'TAS'
)
  AND pw."species" = 'Homo sapiens'
  AND pw."lowest_level" = TRUE
LIMIT 20;
```

```sql
--Description: 8)  Count how many Sorafenib targets (passing filters) fall in each lowest-level TAS pathway  
SELECT
       rel."pathway_stable_id",
       COUNT(DISTINCT pe."pe_stable_id") AS "target_count"
FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77 rel
JOIN (
      SELECT DISTINCT p."stable_id" AS "pe_stable_id"
      FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1  t
      JOIN TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1   e
            ON t."expID" = e."expID"
      JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PHYSICAL_ENTITY_V77 p
            ON p."uniprot_id" = t."target_uniprotID"
      WHERE t."drugName" ILIKE '%sorafenib%'
        AND t."targetSpecies" = 'Homo sapiens'
        AND (e."exp_assayValueMedian" <= 100 OR e."exp_assayValueMedian" IS NULL)
        AND (e."exp_assayValueLow"   <= 100 OR e."exp_assayValueLow"   IS NULL)
        AND (e."exp_assayValueHigh"  <= 100 OR e."exp_assayValueHigh"  IS NULL)
     ) pe
     ON rel."pe_stable_id" = pe."pe_stable_id"
JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77 pw
     ON rel."pathway_stable_id" = pw."stable_id"
WHERE rel."evidence_code" = 'TAS'
  AND pw."species" = 'Homo sapiens'
  AND pw."lowest_level" = TRUE
GROUP BY rel."pathway_stable_id"
ORDER BY "target_count" DESC
LIMIT 20;
```

```sql
--Description: 9)  Background size: total TAS-supported physical entities per lowest-level human pathway  
SELECT
       rel."pathway_stable_id",
       COUNT(DISTINCT rel."pe_stable_id") AS "total_pe_with_TAS"
FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77  rel
JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77        pw
     ON rel."pathway_stable_id" = pw."stable_id"
WHERE rel."evidence_code" = 'TAS'
  AND pw."species" = 'Homo sapiens'
  AND pw."lowest_level" = TRUE
GROUP BY rel."pathway_stable_id"
ORDER BY "total_pe_with_TAS" DESC
LIMIT 20;
```

```sql
--Description: 10)  Build contingency counts (targets-in / targets-out / non-targets-in / non-targets-out)  
SELECT
       pw."stable_id"                                                  AS "pathway_id",
       COUNT(DISTINCT CASE WHEN tgt_pe."pe_stable_id" IS NOT NULL
                           THEN tgt_pe."pe_stable_id" END)            AS "targets_in_pathway",
       ( (SELECT COUNT(DISTINCT pe_all."pe_stable_id")
          FROM (
                SELECT DISTINCT p2."stable_id" AS "pe_stable_id"
                FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1  t2
                JOIN TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1   e2
                       ON t2."expID" = e2."expID"
                JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PHYSICAL_ENTITY_V77 p2
                       ON p2."uniprot_id" = t2."target_uniprotID"
                WHERE t2."drugName" ILIKE '%sorafenib%'
                  AND t2."targetSpecies" = 'Homo sapiens'
                  AND (e2."exp_assayValueMedian" <= 100 OR e2."exp_assayValueMedian" IS NULL)
                  AND (e2."exp_assayValueLow"   <= 100 OR e2."exp_assayValueLow"   IS NULL)
                  AND (e2."exp_assayValueHigh"  <= 100 OR e2."exp_assayValueHigh"  IS NULL)
               ) pe_all
        ) - COUNT(DISTINCT CASE WHEN tgt_pe."pe_stable_id" IS NOT NULL
                                THEN tgt_pe."pe_stable_id" END)
       )                                                              AS "targets_outside_pathway",
       COUNT(DISTINCT CASE WHEN tgt_pe."pe_stable_id" IS NULL
                           THEN rel_all."pe_stable_id" END)           AS "non_targets_in_pathway"
FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77            pw
JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77      rel_all
     ON pw."stable_id" = rel_all."pathway_stable_id"
LEFT JOIN (
      /* Sorafenib targets that map to this pathway */
      SELECT DISTINCT rel."pathway_stable_id",
                      rel."pe_stable_id"
      FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77 rel
      JOIN (
            SELECT DISTINCT p."stable_id" AS "pe_stable_id"
            FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1  t
            JOIN TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1   e
                  ON t."expID" = e."expID"
            JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PHYSICAL_ENTITY_V77 p
                  ON p."uniprot_id" = t."target_uniprotID"
            WHERE t."drugName" ILIKE '%sorafenib%'
              AND t."targetSpecies" = 'Homo sapiens'
              AND (e."exp_assayValueMedian" <= 100 OR e."exp_assayValueMedian" IS NULL)
              AND (e."exp_assayValueLow"   <= 100 OR e."exp_assayValueLow"   IS NULL)
              AND (e."exp_assayValueHigh"  <= 100 OR e."exp_assayValueHigh"  IS NULL)
           ) tgt
           ON rel."pe_stable_id" = tgt."pe_stable_id"
) tgt_pe
     ON  pw."stable_id" = tgt_pe."pathway_stable_id"
WHERE pw."species"      = 'Homo sapiens'
  AND pw."lowest_level" = TRUE
  AND rel_all."evidence_code" = 'TAS'
GROUP BY pw."stable_id"
LIMIT 20;
```
