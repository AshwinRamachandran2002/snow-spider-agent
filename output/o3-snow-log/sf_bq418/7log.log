--Description: For each lowest-level Homo sapiens pathway with TAS evidence,
--             count Sorafenib targets inside the pathway versus outside.
--             “targets_pe” holds all Sorafenib target PE IDs.  
--             “path_targets” lists the PE IDs that are both Sorafenib targets
--             and in the pathway (TAS evidence).  The outside count is the
--             remainder of targets_pe not mapped to that pathway.
WITH targets_pe AS (          -- all Sorafenib target PE IDs
    SELECT DISTINCT
           p."stable_id" AS "pe_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" p
    JOIN  (
        SELECT DISTINCT
               i."target_uniprotID"
        FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" i
        JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"  e
               ON i."expID" = e."expID"
        WHERE  i."drugID"        = 157
          AND  i."targetSpecies" = 'Homo sapiens'
          AND  e."exp_assayValueMedian" <= 100
          AND (e."exp_assayValueLow"  <= 100 OR e."exp_assayValueLow"  IS NULL)
          AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
    ) t
      ON p."uniprot_id" = t."target_uniprotID"
), path_targets AS (          -- Sorafenib target PEs that sit in each pathway
    SELECT DISTINCT
           pep."pathway_stable_id",
           pep."pe_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77" pep
    JOIN   targets_pe tp
           ON pep."pe_stable_id" = tp."pe_stable_id"
    WHERE  pep."evidence_code" = 'TAS'
)
SELECT
       pw."stable_id" AS "pathway_stable_id",
       COUNT(DISTINCT pt."pe_stable_id")                                     AS "targets_in_pathway",
       ( SELECT COUNT(*) FROM targets_pe ) - COUNT(DISTINCT pt."pe_stable_id") AS "targets_outside_pathway"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77" pw
LEFT  JOIN path_targets pt
       ON pw."stable_id" = pt."pathway_stable_id"
WHERE  pw."lowest_level" = TRUE
  AND  pw."species"      = 'Homo sapiens'
GROUP BY pw."stable_id"
ORDER BY "targets_in_pathway" DESC
LIMIT 20
