--Description: Map the Sorafenib-qualified UniProt IDs from the previous step to
--             their Reactome physical-entity (PE) stable IDs, returning PE ID,
--             UniProt ID, entity name, and sub-cellular location.
WITH qualified_targets AS (
    SELECT DISTINCT
           i."target_uniprotID"
    FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" AS i
    JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"  AS e
           ON i."expID" = e."expID"
    WHERE  i."drugID"        = 157
      AND  i."targetSpecies" = 'Homo sapiens'
      AND  e."exp_assayValueMedian" <= 100
      AND (e."exp_assayValueLow"  <= 100 OR e."exp_assayValueLow"  IS NULL)
      AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
)
SELECT DISTINCT
       p."uniprot_id",
       p."stable_id" AS "pe_stable_id",
       p."name",
       p."location"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" AS p
JOIN   qualified_targets qt
       ON p."uniprot_id" = qt."target_uniprotID"
LIMIT 20
