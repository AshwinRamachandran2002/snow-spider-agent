```sql
-- 6) Map those UniProt IDs to Reactome physical-entity stable IDs
SELECT DISTINCT 
       p."uniprot_id",
       p."stable_id"               AS "pe_stable_id",
       p."name",
       p."location"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77"  p
JOIN  ( /* query-5 */ )  t
      ON p."uniprot_id" = t."target_uniprotID"
LIMIT  20;
```

```sql
-- 7) Retrieve TAS-supported pathway mappings for those physical entities
SELECT DISTINCT
       pep."pe_stable_id",
       pep."pathway_stable_id",
       pep."evidence_code"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77"   pep
JOIN  ( /* query-6 */ )  pe
      ON pep."pe_stable_id" = pe."pe_stable_id"
WHERE  pep."evidence_code" = 'TAS'
LIMIT  20;
```

```sql
-- 8) Attach pathway names and keep only pathways that are marked as lowest level
SELECT DISTINCT
       pw."stable_id"          AS "pathway_stable_id",
       pw."name",
       pw."species",
       pw."lowest_level"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77"         pw
JOIN  ( /* query-7 */ )  tas
      ON pw."stable_id" = tas."pathway_stable_id"
WHERE  pw."lowest_level" = TRUE
  AND  pw."species"      = 'Homo sapiens'
LIMIT  20;
```

```sql
-- 9) For each lowest-level TAS pathway, count how many Sorafenib targets
--    (passing the assay filter) fall inside vs. outside the pathway
SELECT 
       pw."pathway_stable_id",
       COUNT(DISTINCT CASE WHEN tas."pe_stable_id" IS NOT NULL THEN tas."pe_stable_id" END) AS "targets_in_pathway",
       COUNT(DISTINCT CASE WHEN tas."pe_stable_id" IS NULL THEN pe."pe_stable_id" END)      AS "targets_outside_pathway"
FROM  ( /* query-6 */ )  pe
LEFT JOIN TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77" tas
       ON tas."pe_stable_id"       = pe."pe_stable_id"
      AND tas."evidence_code"      = 'TAS'
JOIN  TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77"           pw
       ON pw."stable_id"           = tas."pathway_stable_id"
      AND pw."lowest_level"        = TRUE
      AND pw."species"             = 'Homo sapiens'
GROUP BY pw."pathway_stable_id"
ORDER BY "targets_in_pathway" DESC
LIMIT 20;
```

