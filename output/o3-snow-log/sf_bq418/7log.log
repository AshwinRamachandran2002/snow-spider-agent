```sql
--Description: List distinct Homo sapiens target UniProt IDs whose Sorafenib
--             assay data meet the potency filter (median ≤ 100 nM and low/high ≤ 100 nM
--             or NULL).  A CTE “qualified_targets” reproduces the filter so the query
--             is self-contained.
WITH qualified_targets AS (
    SELECT DISTINCT
           i."target_uniprotID"
    FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" AS i
    JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"  AS e
           ON i."expID" = e."expID"
    WHERE  i."drugID"        = 157                -- Sorafenib
      AND  i."targetSpecies" = 'Homo sapiens'
      AND  e."exp_assayValueMedian" <= 100
      AND (e."exp_assayValueLow"  <= 100 OR e."exp_assayValueLow"  IS NULL)
      AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
)
SELECT DISTINCT
       qt."target_uniprotID"
FROM   qualified_targets qt
LIMIT 20;
```

```sql
--Description: Map the Sorafenib-qualified UniProt IDs from the previous step to
--             their Reactome physical-entity (PE) stable IDs, returning PE ID,
--             UniProt ID, entity name, and sub-cellular location.
WITH qualified_targets AS (
    SELECT DISTINCT
           i."target_uniprotID"
    FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" AS i
    JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"  AS e
           ON i."expID" = e."expID"
    WHERE  i."drugID"        = 157
      AND  i."targetSpecies" = 'Homo sapiens'
      AND  e."exp_assayValueMedian" <= 100
      AND (e."exp_assayValueLow"  <= 100 OR e."exp_assayValueLow"  IS NULL)
      AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
)
SELECT DISTINCT
       p."uniprot_id",
       p."stable_id" AS "pe_stable_id",
       p."name",
       p."location"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" AS p
JOIN   qualified_targets qt
       ON p."uniprot_id" = qt."target_uniprotID"
LIMIT 20;
```

```sql
--Description: Retrieve TAS-supported pathway mappings for the Sorafenib physical
--             entities.  Returns PE ID, pathway ID, and evidence code (TAS).
WITH targets_pe AS (
    SELECT DISTINCT
           p."stable_id" AS "pe_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" p
    JOIN  (
        SELECT DISTINCT
               i."target_uniprotID"
        FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" i
        JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"  e
               ON i."expID" = e."expID"
        WHERE  i."drugID"        = 157
          AND  i."targetSpecies" = 'Homo sapiens'
          AND  e."exp_assayValueMedian" <= 100
          AND (e."exp_assayValueLow"  <= 100 OR e."exp_assayValueLow"  IS NULL)
          AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
    ) t
      ON p."uniprot_id" = t."target_uniprotID"
)
SELECT DISTINCT
       pep."pe_stable_id",
       pep."pathway_stable_id",
       pep."evidence_code"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77" pep
JOIN   targets_pe tp
       ON pep."pe_stable_id" = tp."pe_stable_id"
WHERE  pep."evidence_code" = 'TAS'
LIMIT 20;
```

```sql
--Description: Attach human lowest-level pathway metadata to the TAS mappings for
--             Sorafenib targets, returning pathway ID, name, species, and the
--             lowest_level flag.
WITH tas_paths AS (
    SELECT DISTINCT
           pep."pathway_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77" pep
    JOIN  (
        SELECT DISTINCT
               p."stable_id" AS "pe_stable_id"
        FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" p
        JOIN  (
            SELECT DISTINCT
                   i."target_uniprotID"
            FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" i
            JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"  e
                   ON i."expID" = e."expID"
            WHERE  i."drugID"        = 157
              AND  i."targetSpecies" = 'Homo sapiens'
              AND  e."exp_assayValueMedian" <= 100
              AND (e."exp_assayValueLow"  <= 100 OR e."exp_assayValueLow"  IS NULL)
              AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
        ) t
          ON p."uniprot_id" = t."target_uniprotID"
    ) tp
      ON pep."pe_stable_id" = tp."pe_stable_id"
    WHERE pep."evidence_code" = 'TAS'
)
SELECT DISTINCT
       pw."stable_id"  AS "pathway_stable_id",
       pw."name",
       pw."species",
       pw."lowest_level"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77" pw
JOIN   tas_paths tp
       ON pw."stable_id" = tp."pathway_stable_id"
WHERE  pw."lowest_level" = TRUE
  AND  pw."species"      = 'Homo sapiens'
LIMIT 20;
```

```sql
--Description: For each lowest-level Homo sapiens pathway with TAS evidence,
--             count Sorafenib targets inside the pathway versus outside.
--             “targets_pe” holds all Sorafenib target PE IDs.  
--             “path_targets” lists the PE IDs that are both Sorafenib targets
--             and in the pathway (TAS evidence).  The outside count is the
--             remainder of targets_pe not mapped to that pathway.
WITH targets_pe AS (          -- all Sorafenib target PE IDs
    SELECT DISTINCT
           p."stable_id" AS "pe_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" p
    JOIN  (
        SELECT DISTINCT
               i."target_uniprotID"
        FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" i
        JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"  e
               ON i."expID" = e."expID"
        WHERE  i."drugID"        = 157
          AND  i."targetSpecies" = 'Homo sapiens'
          AND  e."exp_assayValueMedian" <= 100
          AND (e."exp_assayValueLow"  <= 100 OR e."exp_assayValueLow"  IS NULL)
          AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
    ) t
      ON p."uniprot_id" = t."target_uniprotID"
), path_targets AS (          -- Sorafenib target PEs that sit in each pathway
    SELECT DISTINCT
           pep."pathway_stable_id",
           pep."pe_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77" pep
    JOIN   targets_pe tp
           ON pep."pe_stable_id" = tp."pe_stable_id"
    WHERE  pep."evidence_code" = 'TAS'
)
SELECT
       pw."stable_id" AS "pathway_stable_id",
       COUNT(DISTINCT pt."pe_stable_id")                                     AS "targets_in_pathway",
       ( SELECT COUNT(*) FROM targets_pe ) - COUNT(DISTINCT pt."pe_stable_id") AS "targets_outside_pathway"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77" pw
LEFT  JOIN path_targets pt
       ON pw."stable_id" = pt."pathway_stable_id"
WHERE  pw."lowest_level" = TRUE
  AND  pw."species"      = 'Homo sapiens'
GROUP BY pw."stable_id"
ORDER BY "targets_in_pathway" DESC
LIMIT 20;
```

```sql
--Description: Retrieve all Homo sapiens physical-entity stable IDs that are NOT
--             Sorafenib targets (per the potency filter).  This set forms the
--             background for chi-squared calculations.
WITH soraf_targets_uniprot AS (
    SELECT DISTINCT
           i."target_uniprotID"
    FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" i
    JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"  e
           ON i."expID" = e."expID"
    WHERE  i."drugID"        = 157
      AND  i."targetSpecies" = 'Homo sapiens'
      AND  e."exp_assayValueMedian" <= 100
      AND (e."exp_assayValueLow"  <= 100 OR e."exp_assayValueLow"  IS NULL)
      AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
)
SELECT DISTINCT
       p."stable_id" AS "pe_stable_id"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" p
WHERE  p."uniprot_id" NOT IN ( SELECT * FROM soraf_targets_uniprot )
LIMIT 20;
```
