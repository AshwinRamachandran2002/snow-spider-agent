```sql
-- 4) Attach experimental assay data and retain only assays that satisfy:
--    median ≤100 AND (low ≤100 OR NULL) AND (high ≤100 OR NULL)
SELECT DISTINCT
       i."interactionID",
       i."targetID",
       i."target_uniprotID",
       e."expID",
       e."exp_assayValueMedian",
       e."exp_assayValueLow",
       e."exp_assayValueHigh",
       e."exp_assayUnits"
FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1"  i
JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"  e
         ON i."expID" = e."expID"
WHERE  i."drugID"        IN ( /* Sorafenib drugID(s) */ )
  AND  i."targetSpecies" =  'Homo sapiens'
  AND  e."exp_assayValueMedian" <= 100
  AND (e."exp_assayValueLow"  <= 100 OR e."exp_assayValueLow"  IS NULL)
  AND (e."exp_assayValueHigh" <= 100 OR e."exp_assayValueHigh" IS NULL)
LIMIT  20;
```

```sql
-- 5) List the unique Homo sapiens target UniProt IDs that pass the assay filter
SELECT DISTINCT 
       filt."target_uniprotID"
FROM ( /* query-4 goes here */ )  filt
LIMIT  20;
