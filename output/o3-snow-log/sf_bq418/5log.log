-- 4)  Inspect the experiment rows attached to those interaction IDs
--     to see the available assay-type codes and values.
SELECT  e."expID",
        e."exp_assayType",
        e."exp_assayValueMedian",
        e."exp_assayValueLow",
        e."exp_assayValueHigh",
        e."exp_assayUnits"
FROM    TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"   e
JOIN    ( SELECT DISTINCT i."expID"
          FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" i
          WHERE i."drugID" IN ( SELECT DISTINCT d."drugID"
                                FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."DRUG_SYNONYMS_V1" d
                                WHERE d."synonym" ILIKE '%sorafenib%' )
            AND i."targetSpecies" = 'Homo sapiens' ) s
  ON  e."expID" = s."expID"
LIMIT 20;
