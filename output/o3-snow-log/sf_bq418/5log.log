--Description:  We need to know whether any of the sorafenib (drugID = 157) interaction-linked
--              experiments that pass the ≤ 100 nM constraints are tagged with assay-type
--              “TAS”.  First, gather all human sorafenib experiments whose median, low and
--              high values are each ≤ 100 nM (NULL allowed) and then count how many belong
--              to each assay-type.  If the resulting set shows zero “TAS” rows, our earlier
--              “exp_assayType = 'TAS'” filter is indeed too strict and must be relaxed.
SELECT   e."exp_assayType",
         COUNT(*) AS "num_experiments"
FROM     TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"  e
JOIN    ( SELECT DISTINCT i."expID"
          FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" i
          WHERE  i."drugID"        = 157              -- Sorafenib Tosylate
            AND  i."targetSpecies" = 'Homo sapiens'
            AND  i."expID"         IS NOT NULL ) s
   ON    e."expID" = s."expID"
WHERE    COALESCE(e."exp_assayValueMedian", 0) <= 100
  AND   (e."exp_assayValueLow"  IS NULL OR e."exp_assayValueLow"  <= 100)
  AND   (e."exp_assayValueHigh" IS NULL OR e."exp_assayValueHigh" <= 100)
GROUP BY e."exp_assayType"
ORDER BY "num_experiments" DESC
LIMIT 20;
