--Description: (10)  Build a 2 × 2 contingency table per lowest-level human pathway with
--                        TAS evidence, using the sorafenib targets defined in (6–7).
--                        Compute the chi-squared statistic for each, then list the top 20.
WITH soraf_targets_pe AS (
    SELECT DISTINCT p."stable_id"      AS "pe_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77"   p
    JOIN  ( SELECT DISTINCT i."target_uniprotID"
            FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" i
            JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"  e
                   ON e."expID" = i."expID"
            WHERE  i."drugID"        = 157
              AND  i."targetSpecies" = 'Homo sapiens'
              AND  COALESCE(e."exp_assayValueMedian", 0) <= 100
              AND (e."exp_assayValueLow"  IS NULL OR e."exp_assayValueLow"  <= 100)
              AND (e."exp_assayValueHigh" IS NULL OR e."exp_assayValueHigh" <= 100)
          ) u
      ON p."uniprot_id" = u."target_uniprotID"
),
all_human_pe AS (
    SELECT DISTINCT p."stable_id" AS "pe_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" p
    WHERE  p."stable_id" IS NOT NULL
),
pathway_pe AS (
    SELECT DISTINCT p2p."pathway_stable_id",
                    p2p."pe_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77" p2p
    WHERE  p2p."evidence_code" = 'TAS'
),
pathway_counts AS (
    SELECT  pw."stable_id"                              AS "pathway_stable_id",
            /* a */ COUNT(DISTINCT CASE WHEN t."pe_stable_id" IS NOT NULL THEN t."pe_stable_id" END) AS targets_in_path,
            /* c */ COUNT(DISTINCT CASE WHEN t."pe_stable_id" IS NULL  THEN ap."pe_stable_id" END) AS nontargets_in_path
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77" pw
    JOIN   pathway_pe  pp   ON pp."pathway_stable_id" = pw."stable_id"
    JOIN   all_human_pe ap  ON ap."pe_stable_id" = pp."pe_stable_id"
    LEFT  JOIN soraf_targets_pe t
           ON t."pe_stable_id" = ap."pe_stable_id"
    WHERE  pw."species" = 'Homo sapiens'
      AND  pw."lowest_level" = TRUE
    GROUP BY pw."stable_id"
),
totals AS (
    SELECT  pc.*,
            ( SELECT COUNT(*) FROM soraf_targets_pe )                             AS total_targets,
            ( SELECT COUNT(*) FROM all_human_pe ) - ( SELECT COUNT(*) FROM soraf_targets_pe ) AS total_nontargets
    FROM   pathway_counts pc
)
SELECT  t."pathway_stable_id",
        pw."name"  AS "pathway_name",
        t.targets_in_path,
        (t.total_targets     - t.targets_in_path)          AS targets_out_path,
        t.nontargets_in_path,
        (t.total_nontargets - t.nontargets_in_path)        AS nontargets_out_path,
        /* χ² statistic */
        ( (t.total_targets + t.total_nontargets) *
          POWER( (t.targets_in_path *
                  (t.total_nontargets - t.nontargets_in_path) ) -
                 ( (t.total_targets - t.targets_in_path) *
                   t.nontargets_in_path ) ,
                 2)
          /
          ( t.total_targets *
            t.total_nontargets *
            (t.targets_in_path + t.nontargets_in_path) *
            ( (t.total_targets - t.targets_in_path) + (t.total_nontargets - t.nontargets_in_path) )
          )
        )                       AS chi_sq
FROM   totals t
JOIN   TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77" pw
  ON   pw."stable_id" = t."pathway_stable_id"
ORDER BY chi_sq DESC
LIMIT 20
