Query:
-- 1)  Find all drug–synonym spellings that contain the string “sorafenib”.
SELECT DISTINCT  d."drugID",
                 d."synonym"
FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."DRUG_SYNONYMS_V1" d
WHERE  d."synonym" ILIKE '%sorafenib%'
LIMIT 20;
