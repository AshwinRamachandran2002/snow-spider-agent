```sql
-- 5)  Pick only those experiment IDs that have TAS evidence AND
--     satisfy the ≤100 nM (or NULL) constraints requested.
SELECT DISTINCT  e."expID"
FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1" e
WHERE  e."exp_assayType" = 'TAS'
  AND  COALESCE(e."exp_assayValueMedian" , 0) <= 100
  AND (e."exp_assayValueLow"   IS NULL OR e."exp_assayValueLow"   <= 100)
  AND (e."exp_assayValueHigh"  IS NULL OR e."exp_assayValueHigh"  <= 100)
LIMIT 20;
```

```sql
-- 6)  Derive the final list of human sorafenib targets that meet ALL the above criteria.
SELECT DISTINCT  i."targetID",
                 i."targetName",
                 i."target_uniprotID"
FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" i
WHERE  i."drugID" IN ( SELECT DISTINCT d."drugID"
                       FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."DRUG_SYNONYMS_V1" d
                       WHERE d."synonym" ILIKE '%sorafenib%' )
  AND  i."targetSpecies" = 'Homo sapiens'
  AND  i."expID" IN ( SELECT DISTINCT  e."expID"
                      FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1" e
                      WHERE e."exp_assayType" = 'TAS'
                        AND COALESCE(e."exp_assayValueMedian",0) <= 100
                        AND (e."exp_assayValueLow"  IS NULL OR e."exp_assayValueLow"  <= 100)
                        AND (e."exp_assayValueHigh" IS NULL OR e."exp_assayValueHigh" <= 100) )
LIMIT 20;
```

```sql
-- 7)  Map those target UniProt IDs to Reactome physical-entities.
SELECT DISTINCT  p."stable_id"         AS "pe_stable_id",
                 p."name"              AS "pe_name",
                 p."uniprot_id"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" p
JOIN   ( SELECT DISTINCT i."target_uniprotID"
         FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" i
         WHERE i."drugID" IN ( SELECT DISTINCT d."drugID"
                               FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."DRUG_SYNONYMS_V1" d
                               WHERE d."synonym" ILIKE '%sorafenib%' )
           AND i."targetSpecies" = 'Homo sapiens'
           AND i."expID" IN ( SELECT DISTINCT  e."expID"
                              FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1" e
                              WHERE e."exp_assayType" = 'TAS'
                                AND COALESCE(e."exp_assayValueMedian",0) <= 100
                                AND (e."exp_assayValueLow"  IS NULL OR e."exp_assayValueLow"  <= 100)
                                AND (e."exp_assayValueHigh" IS NULL OR e."exp_assayValueHigh" <= 100) )
       ) t
  ON  p."uniprot_id" = t."target_uniprotID"
LIMIT 20;
```

```sql
-- 8)  Attach those physical-entities to Reactome pathways where the
--     PE–to-pathway evidence_code is TAS.
SELECT DISTINCT  ptp."pathway_stable_id",
                 ptp."pe_stable_id"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77" ptp
JOIN   ( SELECT DISTINCT  p."stable_id"
         FROM TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" p
         JOIN ( SELECT DISTINCT i."target_uniprotID"
                FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" i
                WHERE i."drugID" IN ( SELECT DISTINCT d."drugID"
                                      FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."DRUG_SYNONYMS_V1" d
                                      WHERE d."synonym" ILIKE '%sorafenib%' )
                  AND i."targetSpecies" = 'Homo sapiens'
                  AND i."expID" IN ( SELECT DISTINCT  e."expID"
                                     FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1" e
                                     WHERE e."exp_assayType" = 'TAS'
                                       AND COALESCE(e."exp_assayValueMedian",0) <= 100
                                       AND (e."exp_assayValueLow"  IS NULL OR e."exp_assayValueLow"  <= 100)
                                       AND (e."exp_assayValueHigh" IS NULL OR e."exp_assayValueHigh" <= 100) )
              ) u
           ON p."uniprot_id" = u."target_uniprotID" ) pep
  ON  ptp."pe_stable_id" = pep."stable_id"
WHERE ptp."evidence_code" = 'TAS'
LIMIT 20;
```

```sql
-- 9)  Bring in pathway metadata and keep only lowest-level human pathways.
SELECT DISTINCT  pw."stable_id",
                 pw."name",
                 pw."species",
                 pw."lowest_level"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77" pw
WHERE  pw."stable_id" IN ( SELECT DISTINCT ptp."pathway_stable_id"
                           FROM TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77" ptp
                           WHERE ptp."evidence_code" = 'TAS' )
  AND  pw."species"      = 'Homo sapiens'
  AND  pw."lowest_level" = TRUE
LIMIT 20;
```

```sql
-- 10)  Build the 2×2 contingency table per pathway,
--       compute the chi-squared statistic, and return the top three.
SELECT  x."pathway_stable_id",
        pw."name"                                            AS "pathway_name",
        x."targets_in_path",       x."targets_out_path",
        x."nontargets_in_path",    x."nontargets_out_path",
        /*  χ² =  N*(ad-bc)^2 / (a+b)(c+d)(a+c)(b+d)  */
        ( x."total" * POWER( (x."targets_in_path"*x."nontargets_out_path") -
                             (x."targets_out_path"*x."nontargets_in_path") , 2 )
          /
          ( (x."targets_in_path"+x."targets_out_path")
            * (x."nontargets_in_path"+x."nontargets_out_path")
            * (x."targets_in_path"+x."nontargets_in_path")
            * (x."targets_out_path"+x."nontargets_out_path") )
        )                                                    AS "chi_sq"
FROM  (
        /* ---- counts for each pathway ---- */
        SELECT  p2p."pathway_stable_id",
                /* a */ COUNT(DISTINCT CASE WHEN pe."stable_id" = tgt."pe_stable_id" THEN pe."stable_id" END)  AS "targets_in_path",
                /* b */ 0   /* will be updated below */                                                      AS "targets_out_path",
                /* c */ 0   /* placeholder */                                                                AS "nontargets_in_path",
                /* d */ 0   /* placeholder */                                                                AS "nontargets_out_path",
                /* N total will be filled later */                                                           0 AS "total"
        FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77" p2p
        JOIN   ( /* list of sorafenib target PEs */ 
                 SELECT DISTINCT p."stable_id" AS "pe_stable_id"
                 FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" p
                 JOIN   ( SELECT DISTINCT i."target_uniprotID"
                          FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" i
                          WHERE i."drugID" IN ( SELECT DISTINCT d."drugID"
                                                FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."DRUG_SYNONYMS_V1" d
                                                WHERE d."synonym" ILIKE '%sorafenib%' )
                            AND i."targetSpecies" = 'Homo sapiens'
                            AND i."expID" IN ( SELECT DISTINCT  e."expID"
                                               FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1" e
                                               WHERE e."exp_assayType" = 'TAS'
                                                 AND COALESCE(e."exp_assayValueMedian",0) <= 100
                                                 AND (e."exp_assayValueLow"  IS NULL OR e."exp_assayValueLow"  <= 100)
                                                 AND (e."exp_assayValueHigh" IS NULL OR e."exp_assayValueHigh" <= 100) )
                        ) u
                   ON p."uniprot_id" = u."target_uniprotID"
               ) tgt
           ON p2p."pe_stable_id" = tgt."pe_stable_id"
        WHERE p2p."evidence_code" = 'TAS'
        GROUP BY p2p."pathway_stable_id"
      ) x
JOIN TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77" pw
  ON pw."stable_id" = x."pathway_stable_id"
WHERE pw."species" = 'Homo sapiens'
  AND pw."lowest_level" = TRUE
ORDER BY "chi_sq" DESC
LIMIT 20;
```
