Query:
-- 3)  Pull all interaction-records for sorafenib together with their linked experiment IDs
--     and keep only human targets.
SELECT DISTINCT  i."interactionID",
                 i."targetID",
                 i."targetName",
                 i."target_uniprotID",
                 i."targetSpecies",
                 i."expID"
FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1" i
WHERE  i."drugID" IN ( SELECT DISTINCT d."drugID"
                       FROM TARGETOME_REACTOME.TARGETOME_VERSIONED."DRUG_SYNONYMS_V1" d
                       WHERE d."synonym" ILIKE '%sorafenib%' )
  AND  i."targetSpecies" = 'Homo sapiens'
LIMIT 20;
