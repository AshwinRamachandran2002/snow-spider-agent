FROM ( /* query #4 result */ )               pt
JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PHYSICAL_ENTITY_V77 pe
     ON pe."uniprot_id" = pt."target_uniprotID"
JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77 pp
     ON pp."pe_stable_id" = pe."stable_id"
JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77 pw
     ON pw."stable_id" = pp."pathway_stable_id"
WHERE pp."evidence_code" = 'TAS'
  AND pw."lowest_level" = TRUE
