--Description: 1)  Look-up every Targetome drug record and synonym that contains the text “sorafenib” (case–insensitive) to learn the internal drugID(s) that represent Sorafenib.
SELECT DISTINCT d."drugID",
       d."drugName",
       s."synonym"
FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1            d
LEFT JOIN TARGETOME_REACTOME.TARGETOME_VERSIONED.DRUG_SYNONYMS_V1  s
       ON d."drugID" = s."drugID"
WHERE d."drugName" ILIKE '%sorafenib%' 
      OR s."synonym" ILIKE '%sorafenib%'
LIMIT 20;
