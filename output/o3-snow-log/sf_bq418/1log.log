```sql
--Description:  Build the complete 2×2 contingency table for every lowest-level, Homo sapiens Reactome
--              pathway that has TAS evidence and compute the χ² statistic for enrichment of Sorafenib
--              (drugID = 157) potent (≤100 nM) Homo sapiens targets.  Finally, list the three pathways
--              with the highest χ² together with the numbers of targets / non-targets inside vs outside
--              each pathway.
WITH                                                                               
soraf_targets AS (   -------------------------------------------------------------- -- step 1: potent Hs targets of Sorafenib
    SELECT DISTINCT i."target_uniprotID" AS uniprot_id
    FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1  i
    JOIN TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1   e
          ON i."expID" = e."expID"
    WHERE i."drugID" = 157
      AND COALESCE(e."exp_assayValueMedian",0) <= 100
      AND (e."exp_assayValueLow"  IS NULL OR e."exp_assayValueLow"  <= 100)
      AND (e."exp_assayValueHigh" IS NULL OR e."exp_assayValueHigh" <= 100)
      AND i."targetSpecies" = 'Homo sapiens'
),                                                                                
tas_pe_map AS (    --------------------------------------------------------------- -- step 2: TAS PE→Pathway map (Homo sapiens, lowest-level)
    SELECT DISTINCT
           pp."pe_stable_id",
           pe."uniprot_id",
           pp."pathway_stable_id"
    FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77  pp
    JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PHYSICAL_ENTITY_V77 pe
           ON pe."stable_id" = pp."pe_stable_id"
    JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77        pw
           ON pw."stable_id" = pp."pathway_stable_id"
    WHERE pp."evidence_code" = 'TAS'
      AND pw."lowest_level" = TRUE
      AND pw."species"      = 'Homo sapiens'
      AND pe."uniprot_id" IS NOT NULL
),                                                                                
universe AS (        ------------------------------------------------------------- -- step 3: total target & non-target counts
    SELECT COUNT(DISTINCT uniprot_id) AS total_proteins
    FROM tas_pe_map
),                                                                                
target_counts AS (   ------------------------------------------------------------- -- step 4: per-pathway target / non-target counts *inside*
    SELECT
        pw."stable_id"               AS pathway_id,
        pw."name"                    AS pathway_name,
        COUNT(DISTINCT CASE WHEN st.uniprot_id IS NOT NULL THEN tp.uniprot_id END) AS targets_in,
        COUNT(DISTINCT CASE WHEN st.uniprot_id IS     NULL THEN tp.uniprot_id END) AS nontargets_in
    FROM tas_pe_map                           tp
    JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77 pw
          ON pw."stable_id" = tp."pathway_stable_id"
    LEFT JOIN soraf_targets                   st
          ON st.uniprot_id = tp."uniprot_id"
    GROUP BY pw."stable_id", pw."name"
),                                                                                
chi2 AS (            ------------------------------------------------------------- -- step 5: add outside counts & χ²
    SELECT
        tc.pathway_id,
        tc.pathway_name,
        tc.targets_in,
        ( SELECT COUNT(*) FROM soraf_targets ) - tc.targets_in                    AS targets_out,
        tc.nontargets_in,
        ( u.total_proteins - (tc.targets_in + tc.nontargets_in) )               AS nontargets_out,
        ------------------------------------------------------- χ² calculation
        (
          POWER( (tc.targets_in * (u.total_proteins - (tc.targets_in + tc.nontargets_in))
                 - tc.nontargets_in * ( ( SELECT COUNT(*) FROM soraf_targets ) - tc.targets_in )
                ), 2)
          * u.total_proteins
        )
        /
        ( (tc.targets_in + tc.nontargets_in)                                       -- row-1 total
          * ( ( SELECT COUNT(*) FROM soraf_targets ) - tc.targets_in
              + u.total_proteins - (tc.targets_in + tc.nontargets_in) )            -- row-2 total
          * (tc.targets_in + ( SELECT COUNT(*) FROM soraf_targets ) - tc.targets_in)  -- col-1 total
          * (tc.nontargets_in + u.total_proteins - (tc.targets_in + tc.nontargets_in)) -- col-2 total
        )  AS chi_squared
    FROM target_counts tc
    CROSS JOIN universe u
)                                                                                
SELECT
    pathway_id,
    pathway_name,
    targets_in,
    targets_out,
    nontargets_in,
    nontargets_out,
    chi_squared
FROM chi2
ORDER BY chi_squared DESC
LIMIT 3;
```
