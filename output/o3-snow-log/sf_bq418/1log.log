       COUNT(DISTINCT pp."pe_stable_id") AS "total_pe_in_pathway"
FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77 pp
JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77 pw
     ON pw."stable_id" = pp."pathway_stable_id"
WHERE pp."evidence_code" = 'TAS'
  AND pw."lowest_level" = TRUE
  AND pw."species" = 'Homo sapiens'
GROUP BY pw."stable_id"
LIMIT 20;
```

```sql
--Description: 10)  Combine target-in-pathway counts with overall background counts to 
--                  build the 2×2 contingency table (targets in/out vs non-targets in/out) 
--                  that will be used to compute chi-squared statistics downstream.
WITH soraf_targets AS (
    SELECT DISTINCT i."target_uniprotID"
    FROM TARGETOME_REACTOME.TARGETOME_VERSIONED.INTERACTIONS_V1  i
    JOIN TARGETOME_REACTOME.TARGETOME_VERSIONED.EXPERIMENTS_V1   e
         ON i."expID" = e."expID"
    WHERE i."drugID" IN ( /* sorafenib drugID(s) */ )
      AND COALESCE(e."exp_assayValueMedian",0) <= 100
      AND (e."exp_assayValueLow"  IS NULL OR e."exp_assayValueLow"  <= 100)
      AND (e."exp_assayValueHigh" IS NULL OR e."exp_assayValueHigh" <= 100)
      AND i."targetSpecies" = 'Homo sapiens'
), pe_map AS (
    SELECT DISTINCT p."stable_id" AS "pe_id",
           p."uniprot_id"
    FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PHYSICAL_ENTITY_V77 p
), tas_paths AS (
    SELECT pp."pe_stable_id",
           pp."pathway_stable_id"
    FROM TARGETOME_REACTOME.REACTOME_VERSIONED.PE_TO_PATHWAY_V77 pp
    WHERE pp."evidence_code" = 'TAS'
), final AS (
    SELECT pw."stable_id"  AS "pathway_id",
           pw."name",
           SUM( CASE WHEN st."uniprot_id" IS NOT NULL THEN 1 ELSE 0 END ) AS "num_targets_in",
           SUM( CASE WHEN st."uniprot_id" IS     NULL THEN 1 ELSE 0 END ) AS "num_nontargets_in"
    FROM tas_paths tp
    JOIN TARGETOME_REACTOME.REACTOME_VERSIONED.PATHWAY_V77 pw
         ON pw."stable_id" = tp."pathway_stable_id"
    JOIN pe_map pm
         ON pm."pe_id" = tp."pe_stable_id"
    LEFT JOIN soraf_targets st
         ON st."target_uniprotID" = pm."uniprot_id"
    WHERE pw."lowest_level" = TRUE
      AND pw."species" = 'Homo sapiens'
    GROUP BY pw."stable_id", pw."name"
)
SELECT *
FROM final
ORDER BY "num_targets_in" DESC
LIMIT 20;
```

These ten exploratory queries reveal the Sorafenib drugID(s), retrieve its Homo sapiens targets with potent (≤100 nM) evidence, map those targets to Reactome physical entities, attach TAS-supported lowest-level Homo sapiens pathways, and produce the counts necessary to calculate chi-squared statistics for selecting the top three pathways.
