--Description:  Compute a 2×2 enrichment test for every lowest-level Reactome pathway
--              that (i) is backed by TAS evidence and (ii) contains at least one
--              physical entity (PE) mapped from a potency-qualified Homo sapiens
--              sorafenib target (median ≤ 100 nM and low/high ≤ 100 nM or NULL).
--              Using those contingency tables, calculate the χ² statistic and return
--              the three pathways with the highest χ² together with counts of
--              targets_in, targets_out, nontargets_in, nontargets_out.
WITH soraf_targets AS (            -- UniProt IDs of qualified sorafenib targets
    SELECT DISTINCT i."target_uniprotID"
    FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1"  i
    JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"   e
      ON  i."expID" = e."expID"
    WHERE i."drugName" ILIKE '%sorafenib%'
      AND i."targetSpecies" = 'Homo sapiens'
      AND e."exp_assayValueMedian" IS NOT NULL
      AND e."exp_assayValueMedian" <= 100
      AND (e."exp_assayValueLow"  IS NULL OR e."exp_assayValueLow"  <= 100)
      AND (e."exp_assayValueHigh" IS NULL OR e."exp_assayValueHigh" <= 100)
),
soraf_pes AS (                     -- PE stable IDs for those targets
    SELECT DISTINCT p."stable_id" AS "pe_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" p
    JOIN   soraf_targets t
      ON  p."uniprot_id" = t."target_uniprotID"
),
tas_lowest_pathways AS (           -- lowest-level TAS pathways with ≥1 such PE
    SELECT DISTINCT pw."stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77"        pw
    JOIN   TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77"  m
      ON  m."pathway_stable_id" = pw."stable_id"
    JOIN   soraf_pes sp
      ON  sp."pe_stable_id" = m."pe_stable_id"
    WHERE pw."lowest_level" = TRUE
      AND m."evidence_code" = 'TAS'
),
counts AS (                         -- inside-pathway PE counts
    SELECT
        pw."stable_id" AS "pathway_id",
        pw."name"      AS "pathway_name",
        COUNT(DISTINCT CASE WHEN sp."pe_stable_id" IS NOT NULL THEN m."pe_stable_id" END) AS "targets_in",
        COUNT(DISTINCT CASE WHEN sp."pe_stable_id" IS NULL  THEN m."pe_stable_id" END)   AS "nontargets_in"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77"        pw
    JOIN   TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77"  m
      ON  m."pathway_stable_id" = pw."stable_id"
    LEFT  JOIN soraf_pes sp
      ON  sp."pe_stable_id" = m."pe_stable_id"
    WHERE pw."stable_id" IN (SELECT * FROM tas_lowest_pathways)
      AND m."evidence_code" = 'TAS'
    GROUP BY pw."stable_id", pw."name"
),
totals AS (                         -- global totals of target PEs and all PEs
    SELECT
        (SELECT COUNT(DISTINCT "pe_stable_id") FROM soraf_pes)                                                   AS "total_targets",
        (SELECT COUNT(DISTINCT "stable_id")    FROM TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77") AS "total_pes"
),
chi AS (                             -- add “out” counts & marginal totals
    SELECT
        c."pathway_id",
        c."pathway_name",
        c."targets_in",
        (tot."total_targets" - c."targets_in")                                                   AS "targets_out",
        c."nontargets_in",
        (tot."total_pes" - c."targets_in" - c."nontargets_in"
                         - (tot."total_targets" - c."targets_in"))                              AS "nontargets_out",
        tot."total_targets"                                                                     AS "row_total_targets",
        (tot."total_pes" - tot."total_targets")                                                 AS "row_total_nontargets",
        (c."targets_in" + c."nontargets_in")                                                    AS "col_total_in",
        (tot."total_pes" - c."targets_in" - c."nontargets_in")                                  AS "col_total_out",
        tot."total_pes"                                                                         AS "grand_total"
    FROM counts c
    CROSS JOIN totals tot
)
SELECT
    "pathway_id",
    "pathway_name",
    "targets_in",
    "targets_out",
    "nontargets_in",
    "nontargets_out",
    /* χ² test statistic for 2×2 contingency table */
    (POWER(("targets_in"    - ("row_total_targets"   * "col_total_in")  / "grand_total"), 2)
       /  (("row_total_targets" * "col_total_in")  / "grand_total")) +
     POWER(("targets_out"   - ("row_total_targets"   * "col_total_out") / "grand_total"), 2)
       /  (("row_total_targets" * "col_total_out") / "grand_total") +
     POWER(("nontargets_in" - ("row_total_nontargets" * "col_total_in")  / "grand_total"), 2)
       /  (("row_total_nontargets" * "col_total_in")  / "grand_total") +
     POWER(("nontargets_out"- ("row_total_nontargets" * "col_total_out") / "grand_total"), 2)
       /  (("row_total_nontargets" * "col_total_out") / "grand_total"))                       AS "chi_squared"
FROM   chi
ORDER BY "chi_squared" DESC
LIMIT 3;
```
