WHERE  "drugName" ILIKE '%sorafenib%'
LIMIT 20;
```

```sql
--2)  List every interaction record that involves sorafenib together with its experiment-ID
SELECT DISTINCT 
       "interactionID",
       "drugID",
       "targetID",
       "targetName",
       "target_uniprotID",
       "targetSpecies",
       "expID"
FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1"
WHERE  "drugName" ILIKE '%sorafenib%'
LIMIT 20;
```

```sql
--3)  Join to EXPERIMENTS_V1 and keep only the rows that pass the potency filter
--    (median ≤100  AND  (low ≤100 OR NULL)  AND  (high ≤100 OR NULL) )
SELECT DISTINCT
       i."targetID",
       i."targetName",
       i."target_uniprotID",
       i."targetSpecies",
       i."expID",
       e."exp_assayValueMedian",
       e."exp_assayValueLow",
       e."exp_assayValueHigh"
FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1"  i
JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"   e
       ON  i."expID" = e."expID"
WHERE  i."drugName"            ILIKE  '%sorafenib%'
  AND  ( e."exp_assayValueMedian" IS NOT NULL 
         AND e."exp_assayValueMedian" <= 100 )
  AND  ( e."exp_assayValueLow"  IS NULL OR e."exp_assayValueLow"  <= 100 )
  AND  ( e."exp_assayValueHigh" IS NULL OR e."exp_assayValueHigh" <= 100 )
LIMIT 20;
```

```sql
--4)  Sub-select Homo sapiens targets that satisfy the potency criteria
SELECT DISTINCT
       "targetID",
       "targetName",
       "target_uniprotID"
FROM (
        /* use the potency-filtered set from query-3 */
        SELECT DISTINCT
               i."targetID",
               i."targetName",
               i."target_uniprotID",
               i."targetSpecies"
        FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1"  i
        JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"   e
               ON  i."expID" = e."expID"
        WHERE  i."drugName"            ILIKE  '%sorafenib%'
          AND  ( e."exp_assayValueMedian" IS NOT NULL 
                 AND e."exp_assayValueMedian" <= 100 )
          AND  ( e."exp_assayValueLow"  IS NULL OR e."exp_assayValueLow"  <= 100 )
          AND  ( e."exp_assayValueHigh" IS NULL OR e."exp_assayValueHigh" <= 100 )
     ) AS f
WHERE  f."targetSpecies" = 'Homo sapiens'
LIMIT 20;
```

```sql
--5)  Map the qualified Homo sapiens targets to their Reactome physical-entity stable-IDs
SELECT DISTINCT
       t."targetID",
       t."target_uniprotID",
       p."stable_id"        AS "pe_stable_id",
       p."name"             AS "pe_name"
FROM  (
        /* result of query-4 without the LIMIT clause */
        SELECT DISTINCT
               "targetID",
               "target_uniprotID"
        FROM   (
                 /* same inner selection as in query-4 */
                 SELECT DISTINCT
                        i."targetID",
                        i."target_uniprotID",
                        i."targetSpecies"
                 FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1"  i
                 JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"   e
                        ON  i."expID" = e."expID"
                 WHERE  i."drugName"            ILIKE  '%sorafenib%'
                   AND  ( e."exp_assayValueMedian" IS NOT NULL 
                          AND e."exp_assayValueMedian" <= 100 )
                   AND  ( e."exp_assayValueLow"  IS NULL OR e."exp_assayValueLow"  <= 100 )
                   AND  ( e."exp_assayValueHigh" IS NULL OR e."exp_assayValueHigh" <= 100 )
               ) 
        WHERE  "targetSpecies" = 'Homo sapiens'
      )  t
JOIN  TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77"  p
      ON  p."uniprot_id" = t."target_uniprotID"
LIMIT 20;
```

```sql
--6)  Retrieve TAS-supported pathway memberships for those physical entities
SELECT DISTINCT
       m."pe_stable_id",
       m."pathway_stable_id"
FROM   (
         /* result of query-5 without the LIMIT clause */
         SELECT DISTINCT
                p."stable_id" AS "pe_stable_id"
         FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77"  p
         JOIN  (
                 /* same target-to-PE mapping logic as in query-5 */
               ) q
               ON p."stable_id" = q."pe_stable_id"
       )  pe
JOIN   TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77"  m
       ON  m."pe_stable_id" = pe."pe_stable_id"
WHERE  m."evidence_code" = 'TAS'
LIMIT 20;
```

```sql
--7)  Keep only *lowest-level* Reactome pathways among the TAS set
SELECT DISTINCT
       pw."stable_id",
       pw."name"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77"  pw
JOIN (
        /* distinct pathway IDs from query-6 without LIMIT */
      )  x
      ON x."pathway_stable_id" = pw."stable_id"
WHERE  pw."lowest_level" = TRUE
LIMIT 20;
```

```sql
--8)  Count the number of sorafenib targets that fall inside each lowest-level TAS pathway
SELECT
       pw."stable_id",
       pw."name",
       COUNT(DISTINCT m."pe_stable_id") AS "sorafenib_target_count"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77"         pw
JOIN   TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77"   m
       ON m."pathway_stable_id" = pw."stable_id"
JOIN (
        /* PE list of qualified sorafenib targets from query-5 without LIMIT */
      )  s
      ON s."pe_stable_id" = m."pe_stable_id"
WHERE  pw."lowest_level" = TRUE
  AND  m."evidence_code" = 'TAS'
GROUP BY
       pw."stable_id",
       pw."name"
ORDER BY
       "sorafenib_target_count" DESC
LIMIT 20;
```

```sql
--9)  For each of those pathways, create the 2×2 contingency table counts:
--    (a) sorafenib targets inside, (b) sorafenib targets outside,
--    (c) non-targets  inside,      (d) non-targets  outside
SELECT
       pw."stable_id"                                              AS "pathway_id",
       pw."name"                                                   AS "pathway_name",
       COUNT(DISTINCT CASE WHEN s."pe_stable_id" IS NOT NULL THEN pe."pe_stable_id" END) AS "targets_in",
       COUNT(DISTINCT CASE WHEN s."pe_stable_id" IS NULL  THEN pe."pe_stable_id" END)   AS "nontargets_in",
       ( SELECT COUNT(*) FROM  ( /* PE list of sorafenib targets */ )  ) 
          - COUNT(DISTINCT CASE WHEN s."pe_stable_id" IS NOT NULL THEN pe."pe_stable_id" END)              AS "targets_out",
       ( SELECT COUNT(*) FROM TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" )
          - COUNT(DISTINCT pe."pe_stable_id")
          - ( SELECT COUNT(*) FROM  ( /* PE list of sorafenib targets */ )  ) 
          + COUNT(DISTINCT CASE WHEN s."pe_stable_id" IS NOT NULL THEN pe."pe_stable_id" END)             AS "nontargets_out"
FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PE_TO_PATHWAY_V77"   pe
JOIN   TARGETOME_REACTOME.REACTOME_VERSIONED."PATHWAY_V77"         pw
       ON  pw."stable_id" = pe."pathway_stable_id"
LEFT JOIN ( /* PE list of sorafenib targets */ )  s
       ON s."pe_stable_id" = pe."pe_stable_id"
WHERE  pw."lowest_level"   = TRUE
  AND  pe."evidence_code"  = 'TAS'
GROUP BY
       pw."stable_id",
       pw."name"
LIMIT 20;
```

```sql
--10)  Compute chi-squared values and select the top-3 lowest-level TAS pathways
SELECT
       c.*,
       /*  χ²  =  Σ ( (observed − expected)² / expected )  for 2×2 table  */
       ( (c."targets_in"     - (c."row_total_targets" * c."col_total_in"  ) / c."grand_total" )^2 
         / ((c."row_total_targets" * c."col_total_in")  / c."grand_total") )
     + ( (c."targets_out"    - (c."row_total_targets" * c."col_total_out" ) / c."grand_total" )^2 
         / ((c."row_total_targets" * c."col_total_out") / c."grand_total") )
     + ( (c."nontargets_in"  - (c."row_total_nontargets" * c."col_total_in")  / c."grand_total" )^2
         / ((c."row_total_nontargets" * c."col_total_in")  / c."grand_total") )
     + ( (c."nontargets_out" - (c."row_total_nontargets" * c."col_total_out") / c."grand_total" )^2
         / ((c."row_total_nontargets" * c."col_total_out") / c."grand_total") )        AS "chi_squared"
FROM (
       /* derive all needed marginal totals from query-9’s logic */
     ) c
ORDER BY
       "chi_squared" DESC
LIMIT 3;
```



