```sql
--Description: Identify all TAS-supported Reactome pathways that include at least one
--             physical entity (PE) corresponding to a Homo sapiens sorafenib target
--             whose potency satisfies: median ≤ 100 nM and (low ≤ 100 nM or NULL) and
--             (high ≤ 100 nM or NULL).  Steps:
--             1) soraf_targets  – collect UniProt IDs of qualified targets.
--             2) soraf_pes      – map those UniProt IDs to Reactome PE stable IDs.
--             3) Final SELECT   – return distinct PE–pathway pairs with evidence_code = 'TAS'.
WITH soraf_targets AS (
    SELECT DISTINCT i."target_uniprotID"
    FROM   TARGETOME_REACTOME.TARGETOME_VERSIONED."INTERACTIONS_V1"  i
    JOIN   TARGETOME_REACTOME.TARGETOME_VERSIONED."EXPERIMENTS_V1"   e
           ON i."expID" = e."expID"
    WHERE  i."drugName" ILIKE '%sorafenib%'              -- drug filter
      AND  i."targetSpecies" = 'Homo sapiens'            -- species filter
      AND  e."exp_assayValueMedian" IS NOT NULL          -- potency filter
      AND  e."exp_assayValueMedian" <= 100
      AND (e."exp_assayValueLow"  IS NULL OR e."exp_assayValueLow"  <= 100)
      AND (e."exp_assayValueHigh" IS NULL OR e."exp_assayValueHigh" <= 100)
),
soraf_pes AS (
    SELECT DISTINCT p."stable_id" AS "pe_stable_id"
    FROM   TARGETOME_REACTOME.REACTOME_VERSIONED."PHYSICAL_ENTITY_V77" p
    JOIN   soraf_targets t
           ON p."uniprot_id" = t."target_uniprotID"
)
SELECT DISTINCT
       sp."pe_stable_id",
       m."pathway_stable_id"
FROM   soraf_pes sp
