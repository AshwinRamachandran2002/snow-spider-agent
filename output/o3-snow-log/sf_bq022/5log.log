    ROUND(MAX("trip_seconds") / 60.0) AS "max_minutes",
    COUNT(*)                          AS "total_trips",
    ROUND(AVG("fare"), 2)             AS "avg_fare"
FROM bucketed
GROUP BY "quantile_group"
ORDER BY "quantile_group";
