```sql
--Description:
--Objective:  For taxi trips that last 0–60 minutes, split the data into six equal-frequency
--quantile groups (1–6) based on trip duration and, for every group, return:
--   • minimum trip duration (minutes, rounded)
--   • maximum trip duration (minutes, rounded)
--   • number of trips in the group
--   • average fare (rounded to two decimals)
--
--Thinking process
--1) The raw table exceeds 200 M rows; percentile functions on the full set timed out.
--2) A 5 % Bernoulli SAMPLE still leaves several million rows—ample for reliable
--   “approximate” quantile statistics yet small enough to finish within the time limit.
--3) Restrict to trips whose "trip_seconds" are 0–3 600 (≤ 60 min) before sampling.
--4) Use NTILE(6) over "trip_seconds" to create six equal-frequency buckets.
--5) Aggregate by bucket, converting seconds to minutes (÷ 60) and rounding where needed.
WITH sampled AS (
    SELECT
        "trip_seconds",
        "fare"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 0 AND 3600      -- keep only 0-60-minute trips
    SAMPLE BERNOULLI (5)                         -- ~5 % sample for speed
), bucketed AS (
    SELECT
        NTILE(6) OVER (ORDER BY "trip_seconds") AS "quantile",
        "trip_seconds",
        "fare"
    FROM sampled
)
SELECT
    "quantile"                                    AS "quantile_group",
    ROUND(MIN("trip_seconds") / 60.0) AS "min_minutes",
    ROUND(MAX("trip_seconds") / 60.0) AS "max_minutes",
    COUNT(*)                         AS "total_trips",
    ROUND(AVG("fare"), 2)            AS "avg_fare"
FROM bucketed
GROUP BY "quantile"
ORDER BY "quantile";
```
