```sql
--Description:
--Purpose:  Produce six equal-frequency quantile groups for Chicago taxi trips lasting 0–60 minutes
--and, for each group, report min & max duration (rounded minutes), trip count, and average fare.
--
--Thinking process
--1. Full-table scans (>200 M rows) time out; we therefore:
--      • first filter to trips with 0 ≤ trip_seconds ≤ 3 600 (≤ 60 min),
--      • then apply a 5 % BERNOULLI SAMPLE to shrink the dataset while
--        retaining millions of rows—ample for stable statistics.
--2. Use NTILE(6) over trip_seconds on this sampled subset to label six
--   equal-frequency buckets (quantile_group 1–6).
--3. Aggregate by bucket:
--      • convert seconds→minutes (÷ 60) and ROUND for min/max,
--      • COUNT(*) for total_trips,
--      • AVG(fare) rounded to two decimals.
WITH base AS (
    SELECT "trip_seconds", "fare"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 0 AND 3600          -- 0–60-minute trips only
), sampled AS (
    SELECT "trip_seconds", "fare"
    FROM base
    SAMPLE BERNOULLI (5)                             -- 5 % sample to avoid timeout
), bucketed AS (
    SELECT
        NTILE(6) OVER (ORDER BY "trip_seconds") AS "quantile_group",
        "trip_seconds",
        "fare"
    FROM sampled
)
SELECT
    "quantile_group",
    ROUND(MIN("trip_seconds") / 60.0) AS "min_minutes",
    ROUND(MAX("trip_seconds") / 60.0) AS "max_minutes",
    COUNT(*)                          AS "total_trips",
    ROUND(AVG("fare"), 2)             AS "avg_fare"
FROM bucketed
GROUP BY "quantile_group"
ORDER BY "quantile_group";
```
