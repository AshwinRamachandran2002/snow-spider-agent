WITH boundaries AS (                                   -- 1) find cut-points (≈-quantiles) without sorting the whole set
    SELECT
        APPROX_PERCENTILE("trip_seconds", 1.0/6) AS p1,
        APPROX_PERCENTILE("trip_seconds", 2.0/6) AS p2,
        APPROX_PERCENTILE("trip_seconds", 3.0/6) AS p3,
        APPROX_PERCENTILE("trip_seconds", 4.0/6) AS p4,
        APPROX_PERCENTILE("trip_seconds", 5.0/6) AS p5
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 0 AND 3600            -- keep only 0-60-minute trips
)

SELECT                                                   -- 2) aggregate per (approx.) sextile
    quantile_group,
    ROUND(MIN(duration_minutes))     AS min_minutes,
    ROUND(MAX(duration_minutes))     AS max_minutes,
    COUNT(*)                         AS num_trips,
    ROUND(AVG("fare"), 2)            AS avg_fare
FROM (
    SELECT
        t."trip_seconds",
        t."fare",
        t."trip_seconds" / 60.0      AS duration_minutes,
        CASE                          -- bucket by the previously computed boundaries
            WHEN t."trip_seconds" <= b.p1 THEN 1
            WHEN t."trip_seconds" <= b.p2 THEN 2
            WHEN t."trip_seconds" <= b.p3 THEN 3
            WHEN t."trip_seconds" <= b.p4 THEN 4
            WHEN t."trip_seconds" <= b.p5 THEN 5
            ELSE 6
        END                          AS quantile_group
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS t
    CROSS JOIN boundaries b
    WHERE t."trip_seconds" BETWEEN 0 AND 3600
)
GROUP BY quantile_group
ORDER BY quantile_group;
```
