--Description: 9) Show 20 example trips from the longest-duration quantile (bucket = 6)
--using the same sampled-and-bucketed approach as above.
SELECT
    "unique_key",
    "trip_seconds",
    ROUND("trip_seconds" / 60.0, 2) AS "minutes",
    "fare",
    "company"
FROM (
    SELECT
        "unique_key",
        "trip_seconds",
        "fare",
        "company",
        NTILE(6) OVER (ORDER BY "trip_seconds") AS bucket
    FROM (
        SELECT "unique_key", "trip_seconds", "fare", "company"
        FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
        WHERE "trip_seconds" BETWEEN 0 AND 3600
    ) SAMPLE BERNOULLI (5)                         -- 5 % sample for speed
) s
WHERE bucket = 6
LIMIT 20
