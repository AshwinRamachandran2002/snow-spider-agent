--Description: 8) Show 20 example trips from the shortest-duration quantile (bucket = 1).
--We first filter to 0-60-minute trips, apply a 5 % Bernoulli sample to keep the query fast,
--bucket the sampled rows with NTILE(6), then return records where bucket = 1.
SELECT
    "unique_key",
    "trip_seconds",
    ROUND("trip_seconds" / 60.0, 2) AS "minutes",
    "fare",
    "company"
FROM (
    SELECT
        "unique_key",
        "trip_seconds",
        "fare",
        "company",
        NTILE(6) OVER (ORDER BY "trip_seconds") AS bucket
    FROM (
        SELECT "unique_key", "trip_seconds", "fare", "company"
        FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
        WHERE "trip_seconds" BETWEEN 0 AND 3600
    ) SAMPLE BERNOULLI (5)                         -- 5 % sample for speed
) s
WHERE bucket = 1
LIMIT 20
