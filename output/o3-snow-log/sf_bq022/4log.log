```sql
--Description: Quick look at a handful of records – raw trip-duration information (seconds), total cost and fare.
SELECT "unique_key",
       "trip_seconds",
       "trip_miles",
       "fare",
       "trip_total"
FROM   CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
LIMIT  20;
```

```sql
--Description: Inspect distinct rounded trip-duration values (in minutes) for a sense of the distribution.
SELECT DISTINCT ROUND("trip_seconds" / 60.0)            AS "trip_minutes_rounded"
FROM   CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
ORDER  BY "trip_minutes_rounded"
LIMIT  20;
```

```sql
--Description: Retrieve min-to-max trip_seconds when restricting to 0–60 minutes.
SELECT MIN("trip_seconds") AS "min_trip_seconds",
       MAX("trip_seconds") AS "max_trip_seconds",
       COUNT(*)            AS "total_rows"
FROM   CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE  "trip_seconds" BETWEEN 0 AND 3600;
```

```sql
--Description: Pull a sample of only those trips whose duration falls within the 0–60-minute window.
SELECT "unique_key",
       "trip_seconds",
       ROUND("trip_seconds"/60.0,2) AS "trip_minutes",
       "fare",
       "trip_total"
FROM   CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE  "trip_seconds" BETWEEN 0 AND 3600
LIMIT  20;
```

```sql
--Description: See how fare values vary by coarse 5-minute buckets of trip duration.
SELECT FLOOR("trip_seconds" / 300)       AS "five_min_bucket",
       COUNT(*)                          AS "cnt_trips",
       ROUND(AVG("fare"),2)              AS "avg_fare"
FROM   CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE  "trip_seconds" BETWEEN 0 AND 3600
GROUP  BY 1
ORDER  BY 1
LIMIT  20;
```

```sql
--Description: Gather basic stats of fare for the targeted duration range (min, max, avg).
SELECT MIN("fare")  AS "min_fare",
       MAX("fare")  AS "max_fare",
       AVG("fare")  AS "avg_fare"
FROM   CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE  "trip_seconds" BETWEEN 0 AND 3600;
```

```sql
--Description: Explore relationship between trip minutes (rounded) and total number of trips.
SELECT ROUND("trip_seconds" / 60.0) AS "trip_minutes_rounded",
       COUNT(*)                     AS "num_trips"
FROM   CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE  "trip_seconds" BETWEEN 0 AND 3600
GROUP  BY 1
ORDER  BY 1
LIMIT  20;
```

```sql
--Description: Investigate possible skewness by looking at the 25th, 50th, and 75th percentile of trip_seconds.
SELECT APPROX_PERCENTILE("trip_seconds", 0.25) AS "p25_seconds",
       APPROX_PERCENTILE("trip_seconds", 0.50) AS "p50_seconds",
       APPROX_PERCENTILE("trip_seconds", 0.75) AS "p75_seconds"
FROM   CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE  "trip_seconds" BETWEEN 0 AND 3600;
```

```sql
--Description: Retrieve fare vs. trip minutes for trips shorter than 30 minutes to observe short-trip pricing.
SELECT ROUND("trip_seconds"/60.0,1) AS "trip_minutes",
       "fare",
       "trip_total"
FROM   CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE  "trip_seconds" BETWEEN 0 AND 1800
LIMIT  20;
```

```sql
--Description: Identify the 16.67%, 33.33%, 50%, 66.67%, and 83.33% cut points for trip_seconds (basis for six quantiles).
SELECT APPROX_PERCENTILE("trip_seconds", 0.1667) AS "q1_16_67_pct",
       APPROX_PERCENTILE("trip_seconds", 0.3333) AS "q2_33_33_pct",
       APPROX_PERCENTILE("trip_seconds", 0.5000) AS "q3_50_pct",
       APPROX_PERCENTILE("trip_seconds", 0.6667) AS "q4_66_67_pct",
       APPROX_PERCENTILE("trip_seconds", 0.8333) AS "q5_83_33_pct"
FROM   CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE  "trip_seconds" BETWEEN 0 AND 3600;
```
