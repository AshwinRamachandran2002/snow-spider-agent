```sql
WITH "filtered_trips" AS (               -- keep only trips 0–60 min
    SELECT
        "trip_seconds",
        "fare",
        ROUND("trip_seconds" / 60.0) AS "trip_minutes_rounded"
    FROM  CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 0 AND 3600               -- 0-60 minutes
      AND "trip_seconds" IS NOT NULL
),
"trip_quantiles" AS (                    -- assign six equal-count quantile groups
    SELECT
        "trip_minutes_rounded",
        "fare",
        NTILE(6) OVER (ORDER BY "trip_seconds") AS "quantile_group"
    FROM "filtered_trips"
)
SELECT
    "quantile_group"                              AS "quantile",
    MIN("trip_minutes_rounded")                   AS "min_trip_minutes",
    MAX("trip_minutes_rounded")                   AS "max_trip_minutes",
    COUNT(*)                                      AS "total_trips",
    ROUND(AVG("fare"), 4)                         AS "avg_fare"
FROM   "trip_quantiles"
GROUP  BY "quantile_group"
ORDER  BY "quantile_group";
```
