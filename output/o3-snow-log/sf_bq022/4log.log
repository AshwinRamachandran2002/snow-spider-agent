/*  Six-quantile summary (0–60-minute trips) – using approximate percentile
    cut-points to avoid the full-table sort that caused the timeout           */
WITH "edges" AS (     -- obtain boundaries that split the data into ~6 equal parts
    SELECT
        APPROX_PERCENTILE("trip_seconds", 0.1666666667) AS "p1",
        APPROX_PERCENTILE("trip_seconds", 0.3333333333) AS "p2",
        APPROX_PERCENTILE("trip_seconds", 0.5000000000) AS "p3",
        APPROX_PERCENTILE("trip_seconds", 0.6666666667) AS "p4",
        APPROX_PERCENTILE("trip_seconds", 0.8333333333) AS "p5"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 0 AND 3600
),
"bucketed" AS (       -- place each trip into one of the six quantile buckets
    SELECT
        ROUND("trip_seconds" / 60.0)                     AS "trip_minutes_rounded",
        "fare",
        CASE
            WHEN "trip_seconds" <  e."p1" THEN 1
            WHEN "trip_seconds" <  e."p2" THEN 2
            WHEN "trip_seconds" <  e."p3" THEN 3
            WHEN "trip_seconds" <  e."p4" THEN 4
            WHEN "trip_seconds" <  e."p5" THEN 5
            ELSE 6
        END                                             AS "quantile"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS t
    CROSS JOIN "edges" e
    WHERE t."trip_seconds" BETWEEN 0 AND 3600
)
SELECT
    "quantile",
    MIN("trip_minutes_rounded")  AS "min_trip_minutes",
    MAX("trip_minutes_rounded")  AS "max_trip_minutes",
    COUNT(*)                     AS "total_trips",
    ROUND(AVG("fare"), 4)        AS "avg_fare"
FROM   "bucketed"
GROUP  BY "quantile"
ORDER  BY "quantile";
```
