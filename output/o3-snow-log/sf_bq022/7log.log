```sql
--Description:  FINAL summary – combine rounded min / max minutes, total-trip count, and
--              average fare per six-quantile duration group on a 0.05 % Bernoulli sample of
--              trips whose durations are 0-60 minutes.  NTILE(6) is calculated in “bucketed,”
--              then aggregated in the outer query.
WITH sampled AS (
    SELECT *
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
         TABLESAMPLE BERNOULLI (0.05)
    WHERE "trip_seconds" BETWEEN 0 AND 3600
),
bucketed AS (
    SELECT
        NTILE(6) OVER (ORDER BY "trip_seconds") AS "dur_bucket",
        "trip_seconds",
        "fare"
    FROM sampled
)
SELECT
    "dur_bucket"                              AS "duration_group",
    ROUND(MIN("trip_seconds") / 60.0)         AS "min_minutes",
    ROUND(MAX("trip_seconds") / 60.0)         AS "max_minutes",
    COUNT(*)                                  AS "total_trips",
    ROUND(AVG("fare"), 2)                     AS "average_fare"
FROM bucketed
GROUP BY "dur_bucket"
ORDER BY "dur_bucket";
