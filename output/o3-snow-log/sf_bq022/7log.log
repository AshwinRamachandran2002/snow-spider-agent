```sql
--Description:  Goal → six equal-frequency (quantile) groups for trips lasting 0-60 minutes,
--              then report rounded min / max minutes, total trips, and average fare per group.
--              Direct NTILE(6) over ~208 M rows times out because a gigantic sort is required.
--              Instead:
--              ①  Use APPROX_PERCENTILE() to obtain the five cut-points that split the data at
--                 16 ⅔ %, 33 ⅓ %, 50 %, 66 ⅔ %, and 83 ⅓ %.  This scans but does not sort.
--              ②  Join those boundaries back to the filtered rows and assign each row to a
--                 bucket via a CASE expression (no heavy window sort).
--              ③  Aggregate by bucket to compute the requested metrics.
WITH bounds AS (   -- five percentile thresholds for 0–60-minute trips
    SELECT
        APPROX_PERCENTILE("trip_seconds", 0.1666667) AS p1,
        APPROX_PERCENTILE("trip_seconds", 0.3333333) AS p2,
        APPROX_PERCENTILE("trip_seconds", 0.5       ) AS p3,
        APPROX_PERCENTILE("trip_seconds", 0.6666667) AS p4,
        APPROX_PERCENTILE("trip_seconds", 0.8333333) AS p5
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 0 AND 3600
),
bucketed AS (      -- assign each trip to one of 6 quantile buckets
    SELECT
        CASE
            WHEN "trip_seconds" <= p1 THEN 1
            WHEN "trip_seconds" <= p2 THEN 2
            WHEN "trip_seconds" <= p3 THEN 3
            WHEN "trip_seconds" <= p4 THEN 4
            WHEN "trip_seconds" <= p5 THEN 5
            ELSE 6
        END                        AS "duration_group",
        "trip_seconds",
        "fare"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS, bounds
    WHERE "trip_seconds" BETWEEN 0 AND 3600
)
SELECT "duration_group",
       ROUND(MIN("trip_seconds") / 60.0) AS "min_minutes",
       ROUND(MAX("trip_seconds") / 60.0) AS "max_minutes",
       COUNT(*)                          AS "total_trips",
       ROUND(AVG("fare"), 2)             AS "average_fare"
FROM bucketed
GROUP BY "duration_group"
ORDER BY "duration_group";
```
