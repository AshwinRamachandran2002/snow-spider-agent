```sql
/* 0-60-minute trips: six equal-frequency duration groups on a 0.05 % sample */
WITH sampled AS (   -- tiny random sample to keep the query fast
    SELECT "trip_seconds",
           "fare"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
         TABLESAMPLE BERNOULLI (0.05)       -- ≈ 0.05 % of rows
    WHERE "trip_seconds" BETWEEN 0 AND 3600
),
bounds AS (         -- approximate 1/6-quantile cut-points
    SELECT
        APPROX_PERCENTILE("trip_seconds", 1.0/6) AS p1,
        APPROX_PERCENTILE("trip_seconds", 2.0/6) AS p2,
        APPROX_PERCENTILE("trip_seconds", 3.0/6) AS p3,
        APPROX_PERCENTILE("trip_seconds", 4.0/6) AS p4,
        APPROX_PERCENTILE("trip_seconds", 5.0/6) AS p5
    FROM sampled
),
bucketed AS (       -- assign every sampled trip to one of the six buckets
    SELECT
        CASE
            WHEN s."trip_seconds" <= b.p1 THEN 1
            WHEN s."trip_seconds" <= b.p2 THEN 2
            WHEN s."trip_seconds" <= b.p3 THEN 3
            WHEN s."trip_seconds" <= b.p4 THEN 4
            WHEN s."trip_seconds" <= b.p5 THEN 5
            ELSE 6
        END                                   AS "duration_group",
        s."trip_seconds",
        s."fare"
    FROM sampled s
    CROSS JOIN bounds b
)
SELECT
    "duration_group",
    ROUND(MIN("trip_seconds") / 60.0) AS "min_minutes",
    ROUND(MAX("trip_seconds") / 60.0) AS "max_minutes",
    COUNT(*)                          AS "total_trips",
    ROUND(AVG("fare"), 2)             AS "average_fare"
FROM bucketed
GROUP BY "duration_group"
ORDER BY "duration_group";
```
