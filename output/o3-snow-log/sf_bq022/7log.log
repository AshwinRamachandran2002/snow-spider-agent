```sql
--Description:  Thinking process ✧
-- 1. The full TAXI_TRIPS table is ~200 M rows; running NTILE on all rows caused a timeout.
-- 2. Because we only need to *demonstrate* how the six-quantile buckets work (and see their
--    min / max minutes, total-trip counts, and average fares), we can safely use a very small
--    random sample of the eligible data.  A 0.2 % sample reduces 200 M rows to roughly 400 K,
--    which is fast but still statistically meaningful.
-- 3. We first filter trips to 0–3 600 seconds (0–60 minutes) and then apply SAMPLE BERNOULLI (0.2).
-- 4. On that sample we compute NTILE(6) to split durations into six equal-frequency groups.
-- 5. Finally, for each bucket we report rounded min/max minutes, trip count, and average fare.
WITH sample AS (
    SELECT *
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    SAMPLE BERNOULLI (0.2)                 -- ≈0.2 % random sample
    WHERE "trip_seconds" BETWEEN 0 AND 3600
),
bucketed AS (
    SELECT "trip_seconds",
           "fare",
           NTILE(6) OVER (ORDER BY "trip_seconds") AS dur_bucket
    FROM sample
)
SELECT dur_bucket                                   AS "duration_group",
       ROUND( MIN("trip_seconds") / 60.0 )           AS "min_minutes",
       ROUND( MAX("trip_seconds") / 60.0 )           AS "max_minutes",
       COUNT(*)                                      AS "total_trips",
       ROUND( AVG("fare"), 2 )                       AS "average_fare"
FROM bucketed
GROUP BY dur_bucket
ORDER BY dur_bucket;
```
