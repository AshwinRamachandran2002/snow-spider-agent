```sql
--Description:  We need min / max trip duration (seconds) for each of six equal-frequency
--              buckets, but a direct NTILE(6) on the full 200-million-row table times out
--              and cannot be grouped because window outputs are not allowed in the same
--              SELECT list as GROUP BY.  Solution → two-stage approach:
--              1. Down-sample the data: TABLESAMPLE BERNOULLI (0.05) keeps ~0.05 % of rows
--                 whose "trip_seconds" lie between 0 and 3 600 (0–60 min).  The resulting
--                 subset is tiny enough to sort quickly.  
--              2. In CTE “bucketed” compute NTILE(6) over "trip_seconds" so each sampled row
--                 gets a bucket label (dur_bucket).  This happens before aggregation.  
--              3. In the outer SELECT, GROUP BY the pre-computed bucket and calculate
--                 MIN / MAX "trip_seconds" for every bucket.  Finally, order the results by
--                 bucket number.
WITH sampled AS (
    SELECT *
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
         TABLESAMPLE BERNOULLI (0.05)          -- ≈0.05 % random sample
    WHERE "trip_seconds" BETWEEN 0 AND 3600
),
bucketed AS (
    SELECT
        "trip_seconds",
        NTILE(6) OVER (ORDER BY "trip_seconds") AS "dur_bucket"
    FROM sampled
)
SELECT
    "dur_bucket",
    MIN("trip_seconds") AS "min_seconds",
    MAX("trip_seconds") AS "max_seconds"
FROM bucketed
GROUP BY "dur_bucket"
ORDER BY "dur_bucket";
