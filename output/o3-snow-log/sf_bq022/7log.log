Query:
--Description:  Convert the min / max trip duration (seconds) to rounded minutes for each of
--              six equal-frequency buckets created on a 0.05 % Bernoulli sample of 0-60-minute
--              trips.  NTILE(6) is computed in the “bucketed” CTE, then aggregated outside.
WITH sampled AS (
    SELECT *
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
         TABLESAMPLE BERNOULLI (0.05)        -- ≈ 0.05 % random sample
    WHERE "trip_seconds" BETWEEN 0 AND 3600
),
bucketed AS (
    SELECT
        NTILE(6) OVER (ORDER BY "trip_seconds") AS "dur_bucket",
        "trip_seconds"
    FROM sampled
)
SELECT
    "dur_bucket",
    ROUND(MIN("trip_seconds") / 60.0) AS "min_minutes_rounded",
    ROUND(MAX("trip_seconds") / 60.0) AS "max_minutes_rounded"
FROM bucketed
GROUP BY "dur_bucket"
ORDER BY "dur_bucket"
