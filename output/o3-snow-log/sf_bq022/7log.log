--Description:  Show min / max duration (seconds) for each of six NTILE buckets, using a 0.05 %  
--              Bernoulli sample of trips lasting 0-60 minutes to avoid the full-table sort.
WITH sampled AS (
    SELECT *
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
         TABLESAMPLE BERNOULLI (0.05)            -- ≈0.05 % random sample
    WHERE "trip_seconds" BETWEEN 0 AND 3600
)
SELECT NTILE(6) OVER (ORDER BY "trip_seconds") AS "dur_bucket",
       MIN("trip_seconds")                     AS "min_seconds",
       MAX("trip_seconds")                     AS "max_seconds"
FROM sampled
GROUP BY "dur_bucket"
ORDER BY "dur_bucket";
