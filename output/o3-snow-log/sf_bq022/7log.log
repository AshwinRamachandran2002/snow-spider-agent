```sql
--Description: Convert the min / max seconds above to rounded minutes
WITH filt AS (
    SELECT *,
           NTILE(6) OVER (ORDER BY "trip_seconds") AS "dur_bucket"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 0 AND 3600
)
SELECT "dur_bucket",
       ROUND(MIN("trip_seconds")/60.0) AS "min_minutes_rounded",
       ROUND(MAX("trip_seconds")/60.0) AS "max_minutes_rounded"
FROM filt
GROUP BY "dur_bucket"
ORDER BY "dur_bucket";
```

```sql
--Description: Calculate total trips and average fare for each duration bucket
WITH filt AS (
    SELECT *,
           NTILE(6) OVER (ORDER BY "trip_seconds") AS "dur_bucket"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 0 AND 3600
)
SELECT "dur_bucket",
       COUNT(*)              AS "total_trips",
       AVG("fare")           AS "avg_fare"
FROM filt
GROUP BY "dur_bucket"
ORDER BY "dur_bucket";
```

```sql
--Description: FINAL – combine rounded min/max minutes, trip count, and average fare per 6-quantile duration group
WITH filt AS (
    SELECT *,
           NTILE(6) OVER (ORDER BY "trip_seconds") AS "dur_bucket"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 0 AND 3600
)
SELECT "dur_bucket"                                       AS "duration_group",
       ROUND(MIN("trip_seconds")/60.0)                    AS "min_minutes",
       ROUND(MAX("trip_seconds")/60.0)                    AS "max_minutes",
       COUNT(*)                                           AS "total_trips",
       ROUND(AVG("fare"), 2)                              AS "average_fare"
FROM filt
GROUP BY "dur_bucket"
ORDER BY "dur_bucket";
```
