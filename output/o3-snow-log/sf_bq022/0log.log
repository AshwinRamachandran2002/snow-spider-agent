```sql
--Description: Preview how Snowflake’s NTILE(6) will split the 0–60-minute trips into six groups
SELECT "unique_key",
       ROUND("trip_seconds"/60.0) AS "trip_minutes",
       NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_quantile"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 3600
LIMIT 20;
```

```sql
--Description: Check min / max trip minutes for each NTILE(6) group (without rounding yet)
SELECT NTILE(6) OVER (ORDER BY "trip_seconds")        AS "duration_quantile",
       MIN("trip_seconds")                            AS "min_seconds",
       MAX("trip_seconds")                            AS "max_seconds"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 3600
GROUP BY "duration_quantile"
ORDER BY "duration_quantile"
LIMIT 20;
```

```sql
--Description: FINAL – compute min & max trip duration (minutes, rounded), # of trips, and average fare for each of six equal-quantile duration groups (0–60 minutes)
WITH trips_0_60 AS (
    SELECT *,
           "trip_seconds"/60.0                             AS trip_minutes,
           NTILE(6) OVER (ORDER BY "trip_seconds")         AS duration_quantile
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 0 AND 3600
)
SELECT duration_quantile                                        AS "quantile_group",
       ROUND(MIN(trip_minutes))                                 AS "min_trip_minutes",
       ROUND(MAX(trip_minutes))                                 AS "max_trip_minutes",
       COUNT(*)                                                 AS "total_trips",
       ROUND(AVG("fare"), 2)                                    AS "avg_fare"
FROM trips_0_60
GROUP BY duration_quantile
ORDER BY duration_quantile;
```
