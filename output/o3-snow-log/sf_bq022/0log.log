Query:
--Description:  Lightweight preview of min / max trip duration (seconds) inside each NTILE(6)
--              bucket for 0–60-minute trips.  We take a 0.2 % Bernoulli sample first so the
--              window function finishes quickly, then aggregate by the quantile.
WITH sampled AS (
    SELECT "trip_seconds"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS SAMPLE (0.2)     -- ≈0.2 % random sample
    WHERE "trip_seconds" BETWEEN 0 AND 3600                     -- 0-60-minute trips
),
bucketed AS (
    SELECT
        NTILE(6) OVER (ORDER BY "trip_seconds") AS duration_quantile,
        "trip_seconds"
    FROM sampled
)
SELECT
    duration_quantile                 AS "quantile_group",
    MIN("trip_seconds")               AS "min_seconds",
    MAX("trip_seconds")               AS "max_seconds"
FROM bucketed
GROUP BY duration_quantile
ORDER BY duration_quantile
LIMIT 20
Answer:
quantile_group,min_seconds,max_seconds
1,0,240
2,240,420
3,420,540
4,540,780
5,780,1260
6,1260,3600
Query:
--Description:  FINAL preview of the requested statistics (min/max rounded minutes, trip count,
--              average fare) for each of six equal-quantile duration groups (0–60 minutes),
--              computed on a 0.2 % sample to avoid time-out.
WITH sampled AS (
    SELECT *
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS SAMPLE (0.2)     -- ≈0.2 % sample
    WHERE "trip_seconds" BETWEEN 0 AND 3600                     -- 0-60-minute trips
),
q AS (
    SELECT
        NTILE(6) OVER (ORDER BY "trip_seconds") AS duration_quantile,
        "trip_seconds" / 60.0                   AS trip_minutes,
        "fare"
    FROM sampled
)
SELECT
    duration_quantile                           AS "quantile_group",
    ROUND(MIN(trip_minutes))                    AS "min_trip_minutes",
    ROUND(MAX(trip_minutes))                    AS "max_trip_minutes",
    COUNT(*)                                    AS "total_trips",
    ROUND(AVG("fare"), 2)                       AS "avg_fare"
FROM q
GROUP BY duration_quantile
ORDER BY duration_quantile
Answer:
