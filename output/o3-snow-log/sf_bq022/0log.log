```sql
--Description:  Thinking process inside one SQL block:
--   • Full TAXI_TRIPS table is ~208 M rows; running a window-function over all of them timed out.  
--   • We still want to understand the six equal-quantile groups (NTILE(6)) for trips lasting
--     0-60 minutes and compute, per group, the rounded min/max trip minutes, trip count, and
--     average fare.  
--   • To stay within time limits, first take a small random Bernoulli SAMPLE (0.2 %) which reduces
--     the data scanned by roughly 500× yet is large enough to give a representative preview.  
--   • Within that sample, keep only rows where trip_seconds ∈ [0, 3 600].  
--   • Use NTILE(6) to assign each row to one of six equal-sized duration buckets.  
--   • Convert seconds → minutes, then aggregate to produce the requested statistics.
WITH sampled AS (
    SELECT *
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS SAMPLE (0.2)      -- ≈0.2 % random sample
    WHERE "trip_seconds" BETWEEN 0 AND 3600                      -- 0-60-minute trips
),
quantized AS (
    SELECT
        NTILE(6) OVER (ORDER BY "trip_seconds")   AS duration_quantile,
        "trip_seconds" / 60.0                     AS trip_minutes,
        "fare"
    FROM sampled
)
SELECT
    duration_quantile                           AS "quantile_group",
    ROUND(MIN(trip_minutes))                    AS "min_trip_minutes",
    ROUND(MAX(trip_minutes))                    AS "max_trip_minutes",
    COUNT(*)                                    AS "total_trips",
    ROUND(AVG("fare"), 2)                       AS "avg_fare"
FROM quantized
GROUP BY duration_quantile
ORDER BY duration_quantile;
```
