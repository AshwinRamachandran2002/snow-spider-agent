```sql
--Description:  Lightweight preview of min / max trip duration (seconds) inside each NTILE(6)
--              bucket for 0–60-minute trips.  We take a 0.2 % Bernoulli sample first so the
--              window function finishes quickly, then aggregate by the quantile.
WITH sampled AS (
    SELECT "trip_seconds"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS SAMPLE (0.2)     -- ≈0.2 % random sample
    WHERE "trip_seconds" BETWEEN 0 AND 3600                     -- 0-60-minute trips
),
bucketed AS (
    SELECT
        NTILE(6) OVER (ORDER BY "trip_seconds") AS duration_quantile,
        "trip_seconds"
    FROM sampled
)
SELECT
    duration_quantile                 AS "quantile_group",
    MIN("trip_seconds")               AS "min_seconds",
    MAX("trip_seconds")               AS "max_seconds"
FROM bucketed
GROUP BY duration_quantile
ORDER BY duration_quantile
LIMIT 20;
```

