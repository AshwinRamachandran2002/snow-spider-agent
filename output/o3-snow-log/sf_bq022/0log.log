    ROUND(MIN(trip_minutes))                    AS "min_trip_minutes",
    ROUND(MAX(trip_minutes))                    AS "max_trip_minutes",
    COUNT(*)                                    AS "total_trips",
    ROUND(AVG("fare"), 2)                       AS "avg_fare"
FROM q
GROUP BY duration_quantile
ORDER BY duration_quantile;
