```sql
--Description / thinking process:
-- Objective: We need (per six-quantile duration bucket, 0–60 min) the min & max rounded
--             minutes, trip count, and average fare.  Full table scans have timed-out,
--             so we limit work by RANDOM-sampling 2 % of eligible rows; that is large
--             enough to see the structure yet small enough to run quickly.
-- Steps:
--   1) “sampled” CTE keeps only trips of 0–3 600 sec and selects 2 % of them.
--   2) In the same CTE we pre-compute rounded minutes to avoid repeating ROUND().
--   3) “bucketed” subquery applies NTILE(6) OVER (ORDER BY trip_seconds) to assign the
--      six equal-row quantile groups.
--   4) Final SELECT groups on the quantile and returns:
--        • min_minutes / max_minutes  – range of rounded minutes inside bucket
--        • total_trips               – count of rows in bucket (from sample)
--        • avg_fare                  – rounded to cents
--   5) ORDER BY quantile so results list buckets 1-6.
WITH sampled AS (
    SELECT  "unique_key",
            "fare",
            "trip_seconds",
            ROUND("trip_seconds" / 60.0) AS "trip_minutes"
    FROM    CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE   "trip_seconds" BETWEEN 0 AND 3600
    SAMPLE (2)            -- 2 % random sample to keep query fast
),
bucketed AS (
    SELECT  *,
            NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_quantile"
    FROM    sampled
)
SELECT  "duration_quantile",
        MIN("trip_minutes")               AS "min_minutes",
        MAX("trip_minutes")               AS "max_minutes",
        COUNT(*)                          AS "total_trips",
        ROUND(AVG("fare"), 2)             AS "avg_fare"
FROM    bucketed
GROUP BY "duration_quantile"
ORDER BY "duration_quantile";
```
