Query:
--Description: Count of trips in each 0–60-minute quantile bucket (using a 5 % Bernoulli
--             sample to avoid time-out).  NTILE(6) is computed in a sub-query and then
--             aggregated.
WITH sampled AS (
    SELECT "trip_seconds"
    FROM   CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
           SAMPLE BERNOULLI (5)         -- 5 % random sample
    WHERE  "trip_seconds" BETWEEN 0 AND 3600
),
bucketed AS (
    SELECT NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_quantile"
    FROM   sampled
)
SELECT "duration_quantile",
       COUNT(*) AS "num_trips"
FROM   bucketed
GROUP BY "duration_quantile"
ORDER BY "duration_quantile"
LIMIT 20
