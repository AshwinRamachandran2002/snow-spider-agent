```sql
--Description: Quick look at a handful of raw taxi-trip records.
SELECT *
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
LIMIT 20;
```

```sql
--Description: Show 20 distinct raw trip durations in seconds (ordered) to verify the column’s values.
SELECT DISTINCT "trip_seconds"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
ORDER BY "trip_seconds"
LIMIT 20;
```

```sql
--Description: Convert seconds to minutes (rounded) and display 20 sample trips whose durations are between 0 and 60 minutes.
SELECT "unique_key",
       ROUND("trip_seconds" / 60.0)  AS "trip_minutes",
       "trip_seconds",
       "fare"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 3600
LIMIT 20;
```

```sql
--Description: Aggregate overall minimum, maximum, average trip duration (in minutes) for trips that last 0–60 minutes.
SELECT  ROUND(MIN("trip_seconds")/60.0) AS "min_minutes",
        ROUND(MAX("trip_seconds")/60.0) AS "max_minutes",
        ROUND(AVG("trip_seconds")/60.0,2) AS "avg_minutes"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 3600
LIMIT 20;
```

```sql
--Description: Preview how trips would be split into six equal-sized quantile buckets by duration (0–60 min).  
--(NTILE assigns 1-6; we list first 20 sample rows.)
SELECT "unique_key",
       ROUND("trip_seconds"/60.0)  AS "trip_minutes",
       NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_quantile"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 3600
LIMIT 20;
```

```sql
--Description: Count of trips in each quantile bucket (0–60 min) – limited since result ≤6.
SELECT NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_quantile",
       COUNT(*)                               AS "num_trips"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 3600
GROUP BY "duration_quantile"
LIMIT 20;
```

```sql
--Description: Minimum & maximum rounded minutes for each quantile bucket (0–60 min) – result ≤6.
SELECT MIN(ROUND("trip_seconds"/60.0)) AS "min_minutes",
       MAX(ROUND("trip_seconds"/60.0)) AS "max_minutes",
       NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_quantile"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 3600
GROUP BY "duration_quantile"
LIMIT 20;
```

```sql
--Description: Average fare for each quantile bucket (0–60 min) – result ≤6.
SELECT NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_quantile",
       ROUND(AVG("fare"),2)                   AS "avg_fare"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 3600
GROUP BY "duration_quantile"
LIMIT 20;
```

```sql
--Description: Bring everything together: min & max minutes, trip count, average fare per quantile – result ≤6.
SELECT  NTILE(6) OVER (ORDER BY "trip_seconds")      AS "duration_quantile",
        MIN(ROUND("trip_seconds"/60.0))              AS "min_minutes",
        MAX(ROUND("trip_seconds"/60.0))              AS "max_minutes",
        COUNT(*)                                     AS "total_trips",
        ROUND(AVG("fare"),2)                         AS "avg_fare"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 3600
GROUP BY "duration_quantile"
LIMIT 20;
```

```sql
--Description: Inspect 20 longest short-trips (near 60 min) to confirm upper boundary handling.
SELECT "unique_key",
       ROUND("trip_seconds"/60.0) AS "trip_minutes",
       "fare"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
