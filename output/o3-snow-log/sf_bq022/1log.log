--Description: Aggregate overall minimum, maximum, average trip duration (in minutes) for trips that last 0–60 minutes.
SELECT  ROUND(MIN("trip_seconds")/60.0) AS "min_minutes",
        ROUND(MAX("trip_seconds")/60.0) AS "max_minutes",
        ROUND(AVG("trip_seconds")/60.0,2) AS "avg_minutes"
