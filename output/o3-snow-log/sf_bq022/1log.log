```sql
--Description (thinking process):
-- Task:  For taxi trips lasting 0–60 minutes, split the data into six equal-sized
--        duration buckets (NTILE = 1-6) and, for each bucket, return:
--          • min & max rounded minutes
--          • total number of trips
--          • average fare
-- Challenge:  A full-table scan has timed-out; shrink input size with a 5 % Bernoulli
--             sample taken BEFORE filtering (Snowflake syntax requires SAMPLE right
--             after the table name).  This keeps results representative yet fast.
-- Steps:
--   1) CTE “sampled”  –  draw 5 % random rows and keep only trips 0–3 600 sec.
--   2) Sub-query “bucketed”  –  assign NTILE(6) buckets and compute rounded minutes.
--   3) Final SELECT  –  aggregate the needed metrics per bucket and order them 1-6.
WITH sampled AS (
    SELECT  "trip_seconds",
            "fare"
    FROM    CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
            SAMPLE BERNOULLI (5)            -- 5 % random sample (must precede WHERE)
    WHERE   "trip_seconds" BETWEEN 0 AND 3600
),
bucketed AS (
    SELECT  ROUND("trip_seconds" / 60.0)            AS "trip_minutes",
            "fare",
            NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_quantile"
    FROM    sampled
)
SELECT  "duration_quantile",
        MIN("trip_minutes")               AS "min_minutes",
        MAX("trip_minutes")               AS "max_minutes",
        COUNT(*)                          AS "total_trips",
        ROUND(AVG("fare"), 2)             AS "avg_fare"
FROM    bucketed
GROUP BY "duration_quantile"
ORDER BY "duration_quantile";
```
