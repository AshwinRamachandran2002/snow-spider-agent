--Description:  NTILE(6) is a window function and cannot coexist with MIN()/MAX()
--              aggregations in the same SELECT without first materialising its
--              output.  The fix is to compute NTILE inside a CTE (“ranked”)
--              that filters to trips 1–3 600 s (0-60 min); then the outer query
--              groups by the derived column duration_group to obtain, for each
--              of the six equal-sized quantiles, the minimum and maximum rounded
--              trip length (minutes).
WITH ranked AS (
    SELECT
        NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_group",
        ROUND("trip_seconds" / 60)              AS "trip_minutes"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 1 AND 3600
)
SELECT
    "duration_group",
    MIN("trip_minutes") AS "min_minutes",
    MAX("trip_minutes") AS "max_minutes"
FROM ranked
GROUP BY "duration_group"
ORDER BY "duration_group";
