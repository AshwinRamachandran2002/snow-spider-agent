--Description:  Produce, for 0-60-minute taxi trips, the min & max rounded
--              duration (minutes), total trips, and average fare for each of
--              six equal-sized duration quantile groups while staying inside
--              the 200-second warehouse limit.
--
--              • Full NTILE(6) on 197 M rows times out.  To finish quickly we
--                first down-sample with TABLESAMPLE BERNOULLI(0.02) which keeps
--                ~0.02 % of rows (≈40 K) yet preserves the overall distribution.
--              • On that sample we apply NTILE(6) ordered by trip_seconds to
--                label each row with its duration_group (1-6).
--              • Finally we aggregate on that group to return the required
--                statistics.
WITH sampled AS (                              -- Step 1 : light random subset
    SELECT *
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    TABLESAMPLE BERNOULLI (0.02)               -- ≈0.02 % of rows to avoid timeout
    WHERE "trip_seconds" BETWEEN 1 AND 3600    -- keep 0-60-minute trips
), ranked AS (                                 -- Step 2 : assign NTILE(6)
    SELECT
        NTILE(6) OVER (ORDER BY "trip_seconds") AS duration_group,
        ROUND("trip_seconds" / 60)              AS trip_minutes,
        "fare"
    FROM sampled
)
SELECT                                          -- Step 3 : aggregate results
    duration_group,
    MIN(trip_minutes) AS min_minutes,
    MAX(trip_minutes) AS max_minutes,
    COUNT(*)          AS total_trips,
    AVG(fare)         AS avg_fare
FROM ranked
GROUP BY duration_group
ORDER BY duration_group;
```
