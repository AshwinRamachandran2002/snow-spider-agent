/* --------------------------------------------------------------------
   Quantile analysis for trips lasting 1–3 600 seconds (0–60 minutes)
   -------------------------------------------------------------------- */
WITH filtered AS (          -- keep only trips up to 60 min
    SELECT
        "trip_seconds",
        "fare",
        ROUND("trip_seconds"/60.0) AS "trip_minutes"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 1 AND 3600
),
bounds AS (                 -- pre-compute 1/6 … 5/6 percentile cut-points
    SELECT
        APPROX_PERCENTILE("trip_seconds", 0.1666666667) AS b1,
        APPROX_PERCENTILE("trip_seconds", 0.3333333333) AS b2,
        APPROX_PERCENTILE("trip_seconds", 0.5000000000) AS b3,
        APPROX_PERCENTILE("trip_seconds", 0.6666666667) AS b4,
        APPROX_PERCENTILE("trip_seconds", 0.8333333333) AS b5
    FROM filtered
),
classified AS (             -- assign each trip to one of six quantile groups
    SELECT
        CASE
            WHEN f."trip_seconds" <= b1 THEN 1
            WHEN f."trip_seconds" <= b2 THEN 2
            WHEN f."trip_seconds" <= b3 THEN 3
            WHEN f."trip_seconds" <= b4 THEN 4
            WHEN f."trip_seconds" <= b5 THEN 5
            ELSE 6
        END                           AS "quantile_group",
        f."trip_minutes",
        f."fare"
    FROM filtered f, bounds
)
SELECT
    "quantile_group",
    MIN("trip_minutes")  AS "min_trip_minutes",
    MAX("trip_minutes")  AS "max_trip_minutes",
    COUNT(*)             AS "total_trips",
    AVG("fare")          AS "avg_fare"
FROM classified
GROUP BY "quantile_group"
ORDER BY "quantile_group";
