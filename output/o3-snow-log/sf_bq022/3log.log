--Description:  We need, for every taxi-trip that lasts 0-60 minutes (1–3 600 s),
--              to break the data into six equal-sized duration quantiles and
--              then return per-quantile statistics:
--                    • min_minutes  – minimum rounded trip length
--                    • max_minutes  – maximum rounded trip length
--                    • total_trips  – number of trips in the quantile
--                    • avg_fare     – average fare in the quantile
--              Strategy
--              1) Filter to the required duration range (WHERE trip_seconds 1-3600).
--              2) Use NTILE(6) window function ordered by trip_seconds to assign
--                 each row to a “duration_group” (1-6), giving six equal parts.
--              3) Round seconds to whole minutes with ROUND(trip_seconds/60).
--              4) Aggregate those rows by duration_group to compute the stats.
--              The entire logic is wrapped in one CTE so the final SELECT is
--              clean; it performs one pass to assign NTILE and one pass to
--              aggregate.
WITH q AS (
    SELECT
        ROUND("trip_seconds" / 60)                     AS trip_minutes,
        "fare",
        NTILE(6) OVER (ORDER BY "trip_seconds")        AS duration_group
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 1 AND 3600            -- 0-60-minute trips
)
SELECT
    duration_group,
    MIN(trip_minutes) AS min_minutes,
    MAX(trip_minutes) AS max_minutes,
    COUNT(*)          AS total_trips,
    AVG(fare)         AS avg_fare
FROM q
GROUP BY duration_group
ORDER BY duration_group;
