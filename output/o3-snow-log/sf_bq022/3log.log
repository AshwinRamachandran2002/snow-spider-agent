```sql
/* ------------------------------------------------------------------------
   For trips lasting 1–3 600 seconds (0–60 min):
   1.  Calculate approximate 1/6-th, 2/6-th … 5/6-th percentile cut-points
       for trip_seconds (avoids the expensive global sort required by NTILE).
   2.  Use those cut-points to assign each trip to one of six quantile groups.
   3.  Return, for every quantile, the rounded-minute min / max duration,
       total number of trips, and average fare.
   ------------------------------------------------------------------------ */
WITH filtered AS (
    SELECT
        "trip_seconds",
        "fare",
        ROUND("trip_seconds" / 60.0) AS "trip_minutes"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 1 AND 3600
),
bounds AS (
    SELECT
        /* approximate boundaries for six equal-sized groups */
        APPROX_PERCENTILE("trip_seconds", 1.0/6) AS b1,
        APPROX_PERCENTILE("trip_seconds", 2.0/6) AS b2,
        APPROX_PERCENTILE("trip_seconds", 3.0/6) AS b3,
        APPROX_PERCENTILE("trip_seconds", 4.0/6) AS b4,
        APPROX_PERCENTILE("trip_seconds", 5.0/6) AS b5
    FROM filtered
),
classified AS (
    SELECT
        CASE
            WHEN f."trip_seconds" <= b1 THEN 1
            WHEN f."trip_seconds" <= b2 THEN 2
            WHEN f."trip_seconds" <= b3 THEN 3
            WHEN f."trip_seconds" <= b4 THEN 4
            WHEN f."trip_seconds" <= b5 THEN 5
            ELSE 6
        END                                                      AS "quantile_group",
        f."trip_minutes",
        f."fare"
    FROM filtered f, bounds
)
SELECT
    "quantile_group",
    MIN("trip_minutes")                   AS "min_trip_minutes",
    MAX("trip_minutes")                   AS "max_trip_minutes",
    COUNT(*)                              AS "total_trips",
    AVG("fare")                           AS "avg_fare"
FROM classified
GROUP BY "quantile_group"
ORDER BY "quantile_group";
```
