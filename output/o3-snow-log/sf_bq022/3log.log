```sql
--Description: Task ‑ “For trips 0-60 min, split data into six equal-sized duration quantiles (NTILE-6)  
--             and, for each group, return: min & max trip duration (rounded minutes), trip count, and
--             average fare.”  
--             Approach / thinking  
--             1. Filter to trips whose "trip_seconds" is 1-3 600 (0-60 min).  
--             2. Use NTILE(6) window function ordered by "trip_seconds" to assign each row to a
--                quantile bucket (duration_group 1-6).  This guarantees as even a split as possible.  
--             3. Wrap that in a CTE (“q”) so we can aggregate per duration_group.  
--             4. In the final SELECT, compute  
--                   • min_minutes / max_minutes  – MIN & MAX rounded seconds÷60  
--                   • total_trips                – COUNT(*)  
--                   • avg_fare                   – AVG("fare")  
--             NOTE: This scans the full 197 M-row subset (0-60 min).  If warehouse timeouts are a risk,
--                   run on a larger warehouse, or add TABLESAMPLE BERNOULLI (…) inside the CTE for
--                   approximate results.  Here we show the exact formulation.  
WITH q AS (  
    SELECT
        ROUND("trip_seconds" / 60)                     AS trip_minutes,
        "fare",
        NTILE(6) OVER (ORDER BY "trip_seconds")        AS duration_group
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 1 AND 3600            -- 0-60 minutes
)
SELECT
    duration_group,
    MIN(trip_minutes)                     AS min_minutes,
    MAX(trip_minutes)                     AS max_minutes,
    COUNT(*)                              AS total_trips,
    AVG(fare)                             AS avg_fare
FROM q
GROUP BY duration_group
ORDER BY duration_group;
```
