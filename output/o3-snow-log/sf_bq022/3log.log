```sql
--Description:  Goal ‑ For all taxi-trips that last 0-60 minutes, split the data
--               into six equal-sized duration quantile groups and, for each
--               group, return:   • min_minutes   • max_minutes
--                                • total_trips   • avg_fare
--
-- 1) bounds CTE
--      • Uses APPROX_PERCENTILE on "trip_seconds" to find the five cut-points
--        that split the 0-60-minute subset into six equal parts (≈16.7 % each).
--        These cut-points are p17, p33, p50, p67, p83  (seconds).
-- 2) bucketed CTE
--      • For every trip (0-60 min) we CROSS JOIN the single-row bounds table
--        and classify the trip into a duration_group (1-6) via CASE logic.
--        • trip_minutes is ROUND("trip_seconds"/60).
-- 3) Final aggregate
--      • Per duration_group compute MIN & MAX trip_minutes, COUNT(*), AVG(fare).
--      • ORDER BY duration_group so the result shows groups 1-6 in order.
--
-- NOTE: APPROX_PERCENTILE returns approximate cut-points; the six groups will
--       have almost identical counts.  Using CASE avoids the heavy NTILE
--       window function over 197 M rows, improving performance.
WITH bounds AS (
    SELECT
        APPROX_PERCENTILE("trip_seconds", 0.166666) AS p17,
        APPROX_PERCENTILE("trip_seconds", 0.333333) AS p33,
        APPROX_PERCENTILE("trip_seconds", 0.500000) AS p50,
        APPROX_PERCENTILE("trip_seconds", 0.666666) AS p67,
        APPROX_PERCENTILE("trip_seconds", 0.833333) AS p83
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 1 AND 3600          -- 0-60 minutes
),
bucketed AS (
    SELECT
        CASE
            WHEN t."trip_seconds" <= b.p17 THEN 1
            WHEN t."trip_seconds" <= b.p33 THEN 2
            WHEN t."trip_seconds" <= b.p50 THEN 3
            WHEN t."trip_seconds" <= b.p67 THEN 4
            WHEN t."trip_seconds" <= b.p83 THEN 5
            ELSE 6
        END                                          AS "duration_group",
        ROUND(t."trip_seconds" / 60)                 AS "trip_minutes",
        t."fare"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS t
    CROSS JOIN bounds b                              -- gives access to cut-points
    WHERE t."trip_seconds" BETWEEN 1 AND 3600
)
SELECT
    "duration_group",
    MIN("trip_minutes") AS "min_minutes",
    MAX("trip_minutes") AS "max_minutes",
    COUNT(*)            AS "total_trips",
    AVG("fare")         AS "avg_fare"
FROM bucketed
GROUP BY "duration_group"
ORDER BY "duration_group";
```
