```sql
--Description:  Compute six equal-sized duration quantiles for all 0-60-minute
--              taxi trips, then return per-quantile statistics
--              (min & max rounded minutes, trip count, average fare) in a
--              single query that avoids the heavy full-table sort which caused
--              prior timeouts.
--
-- 1) bounds  : use APPROX_PERCENTILE on trip_seconds (after filtering to
--              1-3 600 s) to get the five cut-points (≈16.67 %, 33.33 %, …,
--              83.33 %) that split the data into six equal pieces.  This scan
--              needs no sort, so it is fast even on 197 M rows.
-- 2) bucketed: CROSS JOIN each trip with the single-row bounds table and
--              classify the trip into a duration_group (1-6) via CASE logic;
--              also pre-compute rounded minutes.
-- 3) Final   : aggregate on duration_group to produce the requested metrics.
--
--              Because APPROX_PERCENTILE is approximate, each group will have
--              nearly (not exactly) the same size, but the calculation is far
--              more efficient than a full NTILE(6) sort.
WITH bounds AS (
    SELECT
        APPROX_PERCENTILE("trip_seconds", 0.166666) AS p17,
        APPROX_PERCENTILE("trip_seconds", 0.333333) AS p33,
        APPROX_PERCENTILE("trip_seconds", 0.500000) AS p50,
        APPROX_PERCENTILE("trip_seconds", 0.666666) AS p67,
        APPROX_PERCENTILE("trip_seconds", 0.833333) AS p83
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 1 AND 3600                -- 0-60-minute trips
),
bucketed AS (
    SELECT
        CASE
            WHEN t."trip_seconds" <= b.p17 THEN 1
            WHEN t."trip_seconds" <= b.p33 THEN 2
            WHEN t."trip_seconds" <= b.p50 THEN 3
            WHEN t."trip_seconds" <= b.p67 THEN 4
            WHEN t."trip_seconds" <= b.p83 THEN 5
            ELSE 6
        END                                           AS duration_group,
        ROUND(t."trip_seconds" / 60)                  AS trip_minutes,
        t."fare"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS t
    CROSS JOIN bounds b
    WHERE t."trip_seconds" BETWEEN 1 AND 3600
)
SELECT
    duration_group,
    MIN(trip_minutes) AS min_minutes,
    MAX(trip_minutes) AS max_minutes,
    COUNT(*)          AS total_trips,
    AVG(fare)         AS avg_fare
FROM bucketed
GROUP BY duration_group
ORDER BY duration_group;
```
