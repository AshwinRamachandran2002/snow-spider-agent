```sql
--Description: FINAL – for each of six equal quantile groups (based on trip duration 0-60 minutes), 
--calculate min & max trip duration (minutes, rounded), trip count, and average fare.
SELECT 
  "duration_group",
  MIN(ROUND("trip_seconds" / 60))           AS "min_trip_minutes",
  MAX(ROUND("trip_seconds" / 60))           AS "max_trip_minutes",
  COUNT(*)                                   AS "total_trips",
  AVG("fare")                                AS "avg_fare"
FROM (
    SELECT 
      "trip_seconds",
      "fare",
      NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_group"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" > 0 
      AND "trip_seconds" <= 3600
) q
GROUP BY "duration_group"
ORDER BY "duration_group"
LIMIT 20;
```
