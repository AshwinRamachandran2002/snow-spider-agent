```sql
--Description: 
-- Thinking process:
-- 1) Assign each taxi trip that lasts between 1 and 3 600 seconds (0-60 min) to one of six
--    equal-frequency buckets (quantiles) based on "trip_seconds".
-- 2) A direct NTILE() over the full table timed out, so we switch to a two-step plan:
--      a. Compute the five internal break-points once with APPROX_PERCENTILE.  Snowflake
--         requires percentile arguments to be *literal* numbers between 0 and 1, so we
--         hard-code 0.1666667, 0.3333333, 0.5, 0.6666667, and 0.8333333.
--      b. Cross-join those break-points to every qualifying row and use a CASE expression
--         to place each trip into bucket 1-6.  This avoids the heavy window operation.
-- 3) Aggregate per bucket, returning the minimum & maximum rounded trip minutes, trip
--    count, and average fare, then sort in bucket order.
WITH boundaries AS (
    SELECT
        APPROX_PERCENTILE("trip_seconds", 0.1666667) AS q1,
        APPROX_PERCENTILE("trip_seconds", 0.3333333) AS q2,
        APPROX_PERCENTILE("trip_seconds", 0.5)       AS q3,
        APPROX_PERCENTILE("trip_seconds", 0.6666667) AS q4,
        APPROX_PERCENTILE("trip_seconds", 0.8333333) AS q5
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 1 AND 3600
),
bucketed AS (
    SELECT
        ROUND(t."trip_seconds" / 60) AS trip_minutes,
        t."fare",
        CASE
            WHEN t."trip_seconds" <= b.q1 THEN 1
            WHEN t."trip_seconds" <= b.q2 THEN 2
            WHEN t."trip_seconds" <= b.q3 THEN 3
            WHEN t."trip_seconds" <= b.q4 THEN 4
            WHEN t."trip_seconds" <= b.q5 THEN 5
            ELSE 6
        END AS duration_group
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS t
    CROSS JOIN boundaries b
    WHERE t."trip_seconds" BETWEEN 1 AND 3600
)
SELECT
    duration_group,
    MIN(trip_minutes) AS min_trip_minutes,
    MAX(trip_minutes) AS max_trip_minutes,
    COUNT(*)          AS total_trips,
    AVG("fare")       AS avg_fare
FROM bucketed
GROUP BY duration_group
ORDER BY duration_group;
