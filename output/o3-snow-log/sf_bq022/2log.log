/*  Six-quantile (sextile) statistics for trips 0-60 minutes          */
/*  Uses APPROX_PERCENTILE to avoid the full sort required by NTILE   */

WITH filtered AS (          -- keep only trips of 0-60 minutes
    SELECT
        "trip_seconds",
        "fare"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" > 0
      AND "trip_seconds" <= 3600
),                                                              
bounds AS (              -- compute approximate sextile cut-points
    SELECT
        APPROX_PERCENTILE("trip_seconds", 0.1666666667) AS p1,
        APPROX_PERCENTILE("trip_seconds", 0.3333333333) AS p2,
        APPROX_PERCENTILE("trip_seconds", 0.5000000000) AS p3,
        APPROX_PERCENTILE("trip_seconds", 0.6666666667) AS p4,
        APPROX_PERCENTILE("trip_seconds", 0.8333333333) AS p5
    FROM filtered
),
bucketed AS (            -- assign each trip to a sextile bucket
    SELECT
        CASE
            WHEN "trip_seconds" <= p1 THEN 1
            WHEN "trip_seconds" <= p2 THEN 2
            WHEN "trip_seconds" <= p3 THEN 3
            WHEN "trip_seconds" <= p4 THEN 4
            WHEN "trip_seconds" <= p5 THEN 5
            ELSE 6
        END                           AS quantile_group,
        "trip_seconds",
        "fare"
    FROM filtered, bounds             -- scalar cross-join
)
SELECT
    quantile_group,
    MIN(ROUND("trip_seconds" / 60)) AS min_trip_minutes,
    MAX(ROUND("trip_seconds" / 60)) AS max_trip_minutes,
    COUNT(*)                       AS total_trips,
    ROUND(AVG("fare"), 4)          AS avg_fare
FROM bucketed
GROUP BY quantile_group
ORDER BY quantile_group;
