```sql
--Description: 
-- Thinking process:
-- 1) We need six equal-frequency buckets (quantiles) of trip duration for rides whose
--    "trip_seconds" lie between 1 and 3600 seconds (0-60 minutes).
-- 2) To avoid an expensive full-table NTILE() window that previously timed out,
--    we first derive the five internal cut-points with APPROX_PERCENTILE, which is
--    fast and scalable.  These approximate 16 2⁄3 %, 33 1⁄3 %, 50 %, 66 2⁄3 %,
--    and 83 1⁄3 % duration boundaries.  
-- 3) We then assign each trip to a bucket (1–6) by comparing its "trip_seconds"
--    against those boundaries.  This CASE expression is cheap because the limits
--    are computed once in a small CTE and cross-joined.  
-- 4) Finally, we aggregate per bucket to return:
--      • minimum & maximum rounded trip length (minutes),
--      • total trip count,
--      • average fare.  
-- 5) Ordering by bucket (1–6) yields the requested summary. 
WITH boundaries AS (
    SELECT
        APPROX_PERCENTILE("trip_seconds", 1.0/6) AS q1,
        APPROX_PERCENTILE("trip_seconds", 2.0/6) AS q2,
        APPROX_PERCENTILE("trip_seconds", 3.0/6) AS q3,
        APPROX_PERCENTILE("trip_seconds", 4.0/6) AS q4,
        APPROX_PERCENTILE("trip_seconds", 5.0/6) AS q5
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" > 0
      AND "trip_seconds" <= 3600           -- 0-60 minutes
)
, bucketed AS (
    SELECT
        ROUND(t."trip_seconds" / 60)                       AS trip_minutes,
        t."fare",
        CASE
            WHEN t."trip_seconds" <= b.q1 THEN 1
            WHEN t."trip_seconds" <= b.q2 THEN 2
            WHEN t."trip_seconds" <= b.q3 THEN 3
            WHEN t."trip_seconds" <= b.q4 THEN 4
            WHEN t."trip_seconds" <= b.q5 THEN 5
            ELSE 6
        END                                               AS duration_group
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS t
    CROSS JOIN boundaries b
    WHERE t."trip_seconds" > 0
      AND t."trip_seconds" <= 3600
)
SELECT
    duration_group,
    MIN(trip_minutes)  AS min_trip_minutes,
    MAX(trip_minutes)  AS max_trip_minutes,
    COUNT(*)           AS total_trips,
    AVG("fare")        AS avg_fare
FROM bucketed
GROUP BY duration_group
ORDER BY duration_group;
