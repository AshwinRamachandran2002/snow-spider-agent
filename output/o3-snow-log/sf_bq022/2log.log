--Description: 
-- Thinking process:
-- • Directly scanning the entire CHICAGO_TAXI_TRIPS table with NTILE(6) exceeds the
--   200-second warehouse timeout.  To stay within limit yet preserve statistical
--   meaning, we (a) draw a moderate random sample (≈5 %) of all 0-60-minute trips,
--   (b) derive the five internal break-points that split that sample into six
--   equal-frequency buckets via APPROX_PERCENTILE (percentile arguments must be
--   numeric literals), (c) assign each sampled trip to a bucket with a simple CASE
--   expression, and (d) aggregate the requested metrics per bucket.
--
-- • The sample keeps the workload light while still giving a representative view
--   of min/max duration, trip count, and average fare for each quantile.
WITH sample_trips AS (          -- ≈5 % random sample of 0-60-minute trips
    SELECT
        "trip_seconds",
        "fare"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    SAMPLE BERNOULLI (5)         -- adjust up/down if needed
    WHERE "trip_seconds" BETWEEN 1 AND 3600
),
boundaries AS (                 -- compute 1/6 … 5/6 quantile cut-points
    SELECT
        APPROX_PERCENTILE("trip_seconds", 0.1666667) AS q1,
        APPROX_PERCENTILE("trip_seconds", 0.3333333) AS q2,
        APPROX_PERCENTILE("trip_seconds", 0.5)       AS q3,
        APPROX_PERCENTILE("trip_seconds", 0.6666667) AS q4,
        APPROX_PERCENTILE("trip_seconds", 0.8333333) AS q5
    FROM sample_trips
),
bucketed AS (                   -- assign each trip to bucket 1–6
    SELECT
        ROUND(s."trip_seconds" / 60) AS trip_minutes,
        s."fare",
        CASE
            WHEN s."trip_seconds" <= b.q1 THEN 1
            WHEN s."trip_seconds" <= b.q2 THEN 2
            WHEN s."trip_seconds" <= b.q3 THEN 3
            WHEN s."trip_seconds" <= b.q4 THEN 4
            WHEN s."trip_seconds" <= b.q5 THEN 5
            ELSE 6
        END AS duration_group
    FROM sample_trips s
    CROSS JOIN boundaries b
)
SELECT
    duration_group,
    MIN(trip_minutes) AS min_trip_minutes,
    MAX(trip_minutes) AS max_trip_minutes,
    COUNT(*)          AS total_trips,
    AVG("fare")       AS avg_fare
FROM bucketed
GROUP BY duration_group
ORDER BY duration_group;
