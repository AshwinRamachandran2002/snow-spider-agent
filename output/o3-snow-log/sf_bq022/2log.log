```sql
/*  Six-quantile (sextile) statistics for trips lasting 0-60 minutes
    – Uses APPROX_PERCENTILE (no full sort) to obtain cut-points        */

WITH bounds AS (   -- one scalar row holding the 5 interior boundaries
    SELECT
        APPROX_PERCENTILE("trip_seconds", 0.1666667) AS p1,
        APPROX_PERCENTILE("trip_seconds", 0.3333333) AS p2,
        APPROX_PERCENTILE("trip_seconds", 0.5000000) AS p3,
        APPROX_PERCENTILE("trip_seconds", 0.6666667) AS p4,
        APPROX_PERCENTILE("trip_seconds", 0.8333333) AS p5
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" > 0
      AND "trip_seconds" <= 3600
)
SELECT
    quantile_group,
    MIN(ROUND("trip_seconds" / 60)) AS min_trip_minutes,
    MAX(ROUND("trip_seconds" / 60)) AS max_trip_minutes,
    COUNT(*)                       AS total_trips,
    ROUND(AVG("fare"), 4)          AS avg_fare
FROM (
    SELECT
        CASE
            WHEN t."trip_seconds" <= b.p1 THEN 1
            WHEN t."trip_seconds" <= b.p2 THEN 2
            WHEN t."trip_seconds" <= b.p3 THEN 3
            WHEN t."trip_seconds" <= b.p4 THEN 4
            WHEN t."trip_seconds" <= b.p5 THEN 5
            ELSE 6
        END                         AS quantile_group,
        t."trip_seconds",
        t."fare"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS t
    CROSS JOIN bounds b
    WHERE t."trip_seconds" > 0
      AND t."trip_seconds" <= 3600
) q
GROUP BY quantile_group
ORDER BY quantile_group;
