--      APPROX_PERCENTILE at literal quantile positions 1/6, 2/6, … 5/6  
--      (Snowflake requires the percentile argument be a constant numeric literal).
--   2. Cross-join those cut-points to every qualifying row and assign a bucket via
--      a CASE expression—much cheaper than a huge NTILE window.
--   3. Aggregate per bucket to deliver the requested stats, ordered 1→6.
WITH boundaries AS (
    SELECT
        APPROX_PERCENTILE("trip_seconds", 0.1666667) AS q1,
        APPROX_PERCENTILE("trip_seconds", 0.3333333) AS q2,
        APPROX_PERCENTILE("trip_seconds", 0.5)       AS q3,
        APPROX_PERCENTILE("trip_seconds", 0.6666667) AS q4,
        APPROX_PERCENTILE("trip_seconds", 0.8333333) AS q5
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 1 AND 3600
),
bucketed AS (
