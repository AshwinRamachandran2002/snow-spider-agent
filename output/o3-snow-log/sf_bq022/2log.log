-- Calculate stats for six equal-sized trip-duration quantile groups (0-60 minutes)
WITH filtered AS (
    SELECT
        "trip_seconds",
        "fare"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" > 0
      AND "trip_seconds" <= 3600        -- keep trips that last 0-60 minutes
),
sextiled AS (
