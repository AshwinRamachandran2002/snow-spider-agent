/*  Sextile statistics (0-60-minute trips) using 5 % TABLESAMPLE
    – TABLESAMPLE keeps run-time below the 200-second limit
    – APPROX_PERCENTILE gives approximate 6-quantile cut-points           */

WITH bounds AS (                       -- 1st pass: small sample → boundaries
    SELECT
        APPROX_PERCENTILE(
            "trip_seconds",
            ARRAY_CONSTRUCT(0.1666666667, 0.3333333333, 0.5,
                            0.6666666667, 0.8333333333)
        )                                                AS pct               -- returns array
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS TABLESAMPLE BERNOULLI (5)
    WHERE "trip_seconds" > 0
      AND "trip_seconds" <= 3600
),
bucketed AS (                        -- 2nd pass: sample again → group stats
    SELECT
        CASE
            WHEN "trip_seconds" <= pct[0] THEN 1
            WHEN "trip_seconds" <= pct[1] THEN 2
            WHEN "trip_seconds" <= pct[2] THEN 3
            WHEN "trip_seconds" <= pct[3] THEN 4
            WHEN "trip_seconds" <= pct[4] THEN 5
            ELSE 6
        END                             AS quantile_group,
        "trip_seconds",
        "fare"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS TABLESAMPLE BERNOULLI (5),
         bounds                                   -- scalar cross-join
    WHERE "trip_seconds" > 0
      AND "trip_seconds" <= 3600
)
SELECT
    quantile_group,
    MIN(ROUND("trip_seconds" / 60)) AS min_trip_minutes,
    MAX(ROUND("trip_seconds" / 60)) AS max_trip_minutes,
    COUNT(*)                       AS total_trips,
    ROUND(AVG("fare"), 4)          AS avg_fare
FROM bucketed
GROUP BY quantile_group
ORDER BY quantile_group;
