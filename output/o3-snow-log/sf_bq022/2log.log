--Description: 
-- thinking process:
-- 1) We must summarise every taxi trip whose "trip_seconds" lies between 1 – 3 600 s
--    (0 – 60 min) in six equal-frequency duration buckets.
-- 2) A direct NTILE(6) window scan timed-out, so we replace it with a lighter
--    two-pass method:
--      a. “bounds” CTE – one quick scan that uses APPROX_PERCENTILE with literal
--         percentile constants (0.1666667 … 0.8333333) to fetch the five internal
--         cut-points (q1-q5) which split the distribution into six equal parts.
--      b. “bucketed” CTE – cross-join those cut-points (only one row) to all
--         qualifying trips and assign each row to bucket 1-6 via a CASE
--         expression (far cheaper than a giant NTILE window).
-- 3) The final SELECT aggregates per bucket, returning min & max rounded minutes,
--    trip count, and average fare, ordered 1→6.  Because it performs just two
--    sequential scans without heavy windows, it completes within the 200-second
--    warehouse limit.
WITH bounds AS (                             -- five break-points (≈1/6 … 5/6)
    SELECT
        APPROX_PERCENTILE("trip_seconds", 0.1666667) AS q1,
        APPROX_PERCENTILE("trip_seconds", 0.3333333) AS q2,
        APPROX_PERCENTILE("trip_seconds", 0.5)       AS q3,
        APPROX_PERCENTILE("trip_seconds", 0.6666667) AS q4,
        APPROX_PERCENTILE("trip_seconds", 0.8333333) AS q5
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 1 AND 3600
),
bucketed AS (                                -- assign bucket 1-6
    SELECT
        ROUND(t."trip_seconds" / 60) AS trip_minutes,
        t."fare",
        CASE
            WHEN t."trip_seconds" <= b.q1 THEN 1
            WHEN t."trip_seconds" <= b.q2 THEN 2
            WHEN t."trip_seconds" <= b.q3 THEN 3
            WHEN t."trip_seconds" <= b.q4 THEN 4
            WHEN t."trip_seconds" <= b.q5 THEN 5
            ELSE 6
        END AS duration_group
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS t
    CROSS JOIN bounds b
    WHERE t."trip_seconds" BETWEEN 1 AND 3600
)
SELECT
    duration_group,
    MIN(trip_minutes) AS min_trip_minutes,
    MAX(trip_minutes) AS max_trip_minutes,
    COUNT(*)          AS total_trips,
    AVG("fare")       AS avg_fare
FROM bucketed
GROUP BY duration_group
ORDER BY duration_group;
