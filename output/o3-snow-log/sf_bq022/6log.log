```sql
--Description: Preview a handful of raw trip-duration and fare values to understand the basic range of numbers we will be working with.
SELECT 
    "taxi_id",
    "trip_seconds",
    "trip_miles",
    "fare",
    "trip_total"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
LIMIT 20;
```

```sql
--Description: Look at some distinct rounded minute-values derived from “trip_seconds” to confirm typical minute buckets that appear in the data.
SELECT DISTINCT 
    ROUND("trip_seconds" / 60.0) AS "trip_minutes"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
LIMIT 20;
```

```sql
--Description: Sample trips whose raw duration is between 0 and 3,600 seconds (0–60 minutes) after filtering; include a computed whole-minute column.
SELECT
    "unique_key",
    "trip_seconds",
    ROUND("trip_seconds" / 60.0) AS "trip_minutes",
    "fare",
    "payment_type"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 3600
LIMIT 20;
```

```sql
--Description: Quick aggregate check of minimum, maximum, and average raw seconds for trips in the 0–60 minute window.
SELECT 
    MIN("trip_seconds") AS "min_seconds",
    MAX("trip_seconds") AS "max_seconds",
    AVG("trip_seconds") AS "avg_seconds"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 3600
LIMIT 20;
```

```sql
--Description: Obtain a feel for the distribution by listing a sample of trips along with the six-quantile group number (NTILE(6)) based on “trip_seconds.”
SELECT
    "unique_key",
    "trip_seconds",
    NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_quantile"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 3600
LIMIT 20;
```

```sql
--Description: Aggregate statistics (min/max seconds, trip count, average fare) for each of the six equal-sized quantile groups; provides the core metrics requested.
SELECT
    "duration_quantile",
    MIN("trip_seconds") AS "min_trip_seconds",
    MAX("trip_seconds") AS "max_trip_seconds",
    COUNT(*)           AS "total_trips",
    AVG("fare")        AS "avg_fare"
FROM (
    SELECT 
        "trip_seconds",
        "fare",
        NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_quantile"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 0 AND 3600
) q
GROUP BY "duration_quantile"
ORDER BY "duration_quantile"
LIMIT 20;
```

```sql
--Description: Check how many very short trips (under 2 minutes) might exist; good sanity test for potential data anomalies.
SELECT 
    COUNT(*) AS "trips_under_two_minutes"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 120
LIMIT 20;
```

```sql
--Description: View the same six quantile groups but translate seconds to rounded minutes so ranges are easier to interpret.
SELECT
    "duration_quantile",
    ROUND(MIN("trip_seconds") / 60.0) AS "min_minutes",
    ROUND(MAX("trip_seconds") / 60.0) AS "max_minutes"
FROM (
    SELECT 
        "trip_seconds",
        NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_quantile"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" BETWEEN 0 AND 3600
) q
GROUP BY "duration_quantile"
ORDER BY "duration_quantile"
LIMIT 20;
```

```sql
--Description: Compare average fares by payment type for trips that last 0–60 minutes; helps confirm if payments skew fare values in our target window.
SELECT
    "payment_type",
    COUNT(*)          AS "num_trips",
    AVG("fare")       AS "avg_fare",
    AVG("trip_seconds") AS "avg_trip_seconds"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
WHERE "trip_seconds" BETWEEN 0 AND 3600
GROUP BY "payment_type"
ORDER BY "num_trips" DESC
LIMIT 20;
```

```sql
--Description: (Bonus exploratory) Relate taxi drop-off community areas to corresponding crime reports in 2017 to see if high-traffic areas overlap with crimes.
SELECT
    tt."dropoff_community_area",
    COUNT(*)                    AS "taxi_trips",
    COUNT(c."unique_key")       AS "crime_incidents_2017"
FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS tt
LEFT JOIN CHICAGO.CHICAGO_CRIME.CRIME c
       ON tt."dropoff_community_area" = c."community_area"
      AND c."year" = 2017
GROUP BY tt."dropoff_community_area"
ORDER BY "taxi_trips" DESC
LIMIT 20;
```
