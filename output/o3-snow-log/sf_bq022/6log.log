Query:
--Description:  
--Re-run the six-quantile aggregate but on a 5 % random sample to avoid a warehouse timeout.  
--The sub-query keeps trips 0-60 min, samples ~5 % (BERNOULLI), then tags each row with  
--NTILE(6).  We aggregate to min/max seconds, trip count and average fare per bucket.  
SELECT
    "duration_quantile",
    MIN("trip_seconds") AS "min_trip_seconds",
    MAX("trip_seconds") AS "max_trip_seconds",
    COUNT(*)           AS "total_trips",
    AVG("fare")        AS "avg_fare"
FROM (
    SELECT
        "trip_seconds",
        "fare",
        NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_quantile"
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    TABLESAMPLE BERNOULLI (5)                       -- shrink working set
    WHERE "trip_seconds" BETWEEN 0 AND 3600
) q
GROUP BY "duration_quantile"
ORDER BY "duration_quantile"
LIMIT 20
