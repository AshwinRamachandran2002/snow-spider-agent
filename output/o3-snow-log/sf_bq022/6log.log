    MIN("trip_seconds") AS "min_trip_seconds",
    MAX("trip_seconds") AS "max_trip_seconds",
    COUNT(*)           AS "total_trips",
    AVG("fare")        AS "avg_fare"
FROM (
    SELECT
        "trip_seconds",
        "fare",
        NTILE(6) OVER (ORDER BY "trip_seconds") AS "duration_quantile"
