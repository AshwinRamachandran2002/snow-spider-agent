```sql
--Description: 2) Look at a handful of bike-share stations with their coordinates  
SELECT  b."station_id",
        b."name",
        b."lat",
        b."lon"
FROM    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_BIKESHARE."BIKESHARE_STATION_INFO" b
WHERE   b."lat" IS NOT NULL 
   AND  b."lon" IS NOT NULL
LIMIT   20;
```

```sql
--Description: 3) Sample which neighborhood each of those stations falls inside (spatial point-in-polygon test)  
SELECT  b."station_id",
        b."name",
        n."neighborhood"
FROM    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_BIKESHARE."BIKESHARE_STATION_INFO" b
JOIN    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS."BOUNDARIES" n
       ON ST_CONTAINS(
              TO_GEOGRAPHY(n."neighborhood_geom"),
              ST_POINT(b."lon", b."lat")
          )
WHERE   b."lat" IS NOT NULL 
   AND  b."lon" IS NOT NULL
LIMIT   20;
```

```sql
--Description: 4) Count bike-share stations per neighborhood  
SELECT  n."neighborhood",
        COUNT(*)            AS "station_cnt"
FROM    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_BIKESHARE."BIKESHARE_STATION_INFO" b
JOIN    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS."BOUNDARIES" n
       ON ST_CONTAINS(
              TO_GEOGRAPHY(n."neighborhood_geom"),
              ST_POINT(b."lon", b."lat")
          )
WHERE   b."lat" IS NOT NULL 
   AND  b."lon" IS NOT NULL
GROUP BY n."neighborhood"
ORDER BY "station_cnt" DESC
LIMIT   20;
```

```sql
--Description: 5) Preview crime-incident rows that hold valid coordinates  
SELECT  i."unique_key",
        i."category",
        i."latitude",
        i."longitude"
FROM    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_SFPD_INCIDENTS."SFPD_INCIDENTS" i
WHERE   i."latitude"  BETWEEN  37.6 AND 37.9   -- rough SF lat bounds
  AND   i."longitude" BETWEEN -123  AND -122.3 -- rough SF lon bounds
LIMIT   20;
```

```sql
--Description: 6) Attach those incidents to their neighborhood polygons  
SELECT  i."unique_key",
        i."category",
        n."neighborhood"
FROM    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_SFPD_INCIDENTS."SFPD_INCIDENTS" i
JOIN    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS."BOUNDARIES" n
       ON ST_CONTAINS(
              TO_GEOGRAPHY(n."neighborhood_geom"),
              ST_POINT(i."longitude", i."latitude")
          )
WHERE   i."latitude"  BETWEEN 37.6 AND 37.9
  AND   i."longitude" BETWEEN -123  AND -122.3
LIMIT   20;
```

```sql
--Description: 7) Count crime incidents per neighborhood  
SELECT  n."neighborhood",
        COUNT(*)           AS "incident_cnt"
FROM    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_SFPD_INCIDENTS."SFPD_INCIDENTS" i
JOIN    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS."BOUNDARIES" n
       ON ST_CONTAINS(
              TO_GEOGRAPHY(n."neighborhood_geom"),
              ST_POINT(i."longitude", i."latitude")
          )
WHERE   i."latitude"  BETWEEN 37.6 AND 37.9
  AND   i."longitude" BETWEEN -123  AND -122.3
GROUP BY n."neighborhood"
ORDER BY "incident_cnt" DESC
LIMIT   20;
```

```sql
--Description: 8) Combine the station counts & incident counts, showing only neighborhoods that have both  
WITH station_ct AS (
        SELECT  n."neighborhood",
                COUNT(*) AS "station_cnt"
        FROM    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_BIKESHARE."BIKESHARE_STATION_INFO" b
        JOIN    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS."BOUNDARIES" n
               ON ST_CONTAINS(
                      TO_GEOGRAPHY(n."neighborhood_geom"),
                      ST_POINT(b."lon", b."lat")
                  )
        WHERE   b."lat" IS NOT NULL 
           AND  b."lon" IS NOT NULL
        GROUP BY n."neighborhood"
),
incident_ct AS (
        SELECT  n."neighborhood",
                COUNT(*) AS "incident_cnt"
        FROM    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_SFPD_INCIDENTS."SFPD_INCIDENTS" i
        JOIN    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS."BOUNDARIES" n
               ON ST_CONTAINS(
                      TO_GEOGRAPHY(n."neighborhood_geom"),
                      ST_POINT(i."longitude", i."latitude")
                  )
        WHERE   i."latitude"  BETWEEN 37.6 AND 37.9
          AND   i."longitude" BETWEEN -123  AND -122.3
        GROUP BY n."neighborhood"
)
SELECT  s."neighborhood",
        s."station_cnt",
        c."incident_cnt"
FROM    station_ct s
JOIN    incident_ct c
   ON   s."neighborhood" = c."neighborhood"
LIMIT   20;
```

```sql
--Description: 9) Same as (8) but ordered by most crime incidents  
WITH station_ct AS (
        SELECT  n."neighborhood",
                COUNT(*) AS "station_cnt"
        FROM    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_BIKESHARE."BIKESHARE_STATION_INFO" b
        JOIN    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS."BOUNDARIES" n
               ON ST_CONTAINS(
                      TO_GEOGRAPHY(n."neighborhood_geom"),
                      ST_POINT(b."lon", b."lat")
                  )
        WHERE   b."lat" IS NOT NULL 
           AND  b."lon" IS NOT NULL
        GROUP BY n."neighborhood"
),
incident_ct AS (
        SELECT  n."neighborhood",
                COUNT(*) AS "incident_cnt"
        FROM    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_SFPD_INCIDENTS."SFPD_INCIDENTS" i
        JOIN    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS."BOUNDARIES" n
               ON ST_CONTAINS(
                      TO_GEOGRAPHY(n."neighborhood_geom"),
                      ST_POINT(i."longitude", i."latitude")
                  )
        WHERE   i."latitude"  BETWEEN 37.6 AND 37.9
          AND   i."longitude" BETWEEN -123  AND -122.3
        GROUP BY n."neighborhood"
)
SELECT  s."neighborhood",
        s."station_cnt",
        c."incident_cnt"
FROM    station_ct s
JOIN    incident_ct c
   ON   s."neighborhood" = c."neighborhood"
ORDER BY c."incident_cnt" DESC
LIMIT   20;
```

```sql
--Description: 10) (Optional) Inspect one neighborhood in detail – show its first 20 stations & first 20 incidents  
SELECT  'STATIONS'       AS "data_type",
        b."station_id"   AS "id_or_key",
        b."name"         AS "details",
        b."lat",
        b."lon"
FROM    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_BIKESHARE."BIKESHARE_STATION_INFO" b
JOIN    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS."BOUNDARIES" n
      ON n."neighborhood" = 'Mission'   -- change to any neighborhood of interest
     AND ST_CONTAINS(
            TO_GEOGRAPHY(n."neighborhood_geom"),
            ST_POINT(b."lon", b."lat")
         )

UNION ALL

SELECT  'INCIDENTS'      AS "data_type",
        i."unique_key"   AS "id_or_key",
        i."category"     AS "details",
        i."latitude",
        i."longitude"
FROM    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_SFPD_INCIDENTS."SFPD_INCIDENTS" i
JOIN    SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS."BOUNDARIES" n
      ON n."neighborhood" = 'Mission'   -- same neighborhood as above
     AND ST_CONTAINS(
            TO_GEOGRAPHY(n."neighborhood_geom"),
            ST_POINT(i."longitude", i."latitude")
         )
LIMIT 20;
```
