```sql
-- Description: Count bike‐share stations that fall inside each neighborhood using spatial containment
SELECT
    n."neighborhood",
    COUNT(*) AS "bike_station_cnt"
FROM SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS.BOUNDARIES n
JOIN SAN_FRANCISCO_PLUS.SAN_FRANCISCO_BIKESHARE.BIKESHARE_STATION_INFO s
  ON ST_CONTAINS(
        TO_GEOGRAPHY(n."neighborhood_geom"),
        TO_GEOGRAPHY(POINT(s."lon", s."lat"))
     )
GROUP BY n."neighborhood"
ORDER BY "bike_station_cnt" DESC
LIMIT 20;
```

```sql
-- Description: Count SFPD crime incidents that fall inside each neighborhood
SELECT
    n."neighborhood",
    COUNT(*) AS "crime_cnt"
FROM SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS.BOUNDARIES n
JOIN SAN_FRANCISCO_PLUS.SAN_FRANCISCO_SFPD_INCIDENTS.SFPD_INCIDENTS c
  ON ST_CONTAINS(
        TO_GEOGRAPHY(n."neighborhood_geom"),
        TO_GEOGRAPHY(POINT(c."longitude", c."latitude"))
     )
GROUP BY n."neighborhood"
ORDER BY "crime_cnt" DESC
LIMIT 20;
```

```sql
-- Description: Identify neighborhoods that have at least one bike station and at least one crime
WITH bike AS (
    SELECT
        n."neighborhood",
        COUNT(*) AS "bike_station_cnt"
    FROM SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS.BOUNDARIES n
    JOIN SAN_FRANCISCO_PLUS.SAN_FRANCISCO_BIKESHARE.BIKESHARE_STATION_INFO s
      ON ST_CONTAINS(
            TO_GEOGRAPHY(n."neighborhood_geom"),
            TO_GEOGRAPHY(POINT(s."lon", s."lat"))
         )
    GROUP BY n."neighborhood"
),
crime AS (
    SELECT
        n."neighborhood",
        COUNT(*) AS "crime_cnt"
    FROM SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS.BOUNDARIES n
    JOIN SAN_FRANCISCO_PLUS.SAN_FRANCISCO_SFPD_INCIDENTS.SFPD_INCIDENTS c
      ON ST_CONTAINS(
            TO_GEOGRAPHY(n."neighborhood_geom"),
            TO_GEOGRAPHY(POINT(c."longitude", c."latitude"))
         )
    GROUP BY n."neighborhood"
)
SELECT
    b."neighborhood",
    b."bike_station_cnt",
    c."crime_cnt"
FROM bike b
JOIN crime c
  ON b."neighborhood" = c."neighborhood"
LIMIT 20;
```

