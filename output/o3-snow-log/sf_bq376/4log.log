```sql
-- Description: Final aggregation that fulfills requested output for ALL neighborhoods (no LIMIT here for real run)
SELECT
    b."neighborhood",
    b."bike_station_cnt",
    c."crime_cnt"
FROM (
      SELECT
          n."neighborhood",
          COUNT(*) AS "bike_station_cnt"
      FROM SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS.BOUNDARIES n
      JOIN SAN_FRANCISCO_PLUS.SAN_FRANCISCO_BIKESHARE.BIKESHARE_STATION_INFO s
        ON ST_CONTAINS(
              TO_GEOGRAPHY(n."neighborhood_geom"),
              TO_GEOGRAPHY(POINT(s."lon", s."lat"))
           )
      GROUP BY n."neighborhood"
) b
JOIN (
      SELECT
          n."neighborhood",
          COUNT(*) AS "crime_cnt"
      FROM SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS.BOUNDARIES n
      JOIN SAN_FRANCISCO_PLUS.SAN_FRANCISCO_SFPD_INCIDENTS.SFPD_INCIDENTS c
        ON ST_CONTAINS(
              TO_GEOGRAPHY(n."neighborhood_geom"),
              TO_GEOGRAPHY(POINT(c."longitude", c."latitude"))
           )
      GROUP BY n."neighborhood"
) c
  ON b."neighborhood" = c."neighborhood"
ORDER BY b."neighborhood";
```

```sql
-- Description: Quickly inspect resulting counts for a specific neighborhood (e.g., SOMA) once the aggregation is created
SELECT
    *
FROM (
    /* paste the final aggregation query here as a subquery */ 
    SELECT
        b."neighborhood",
        b."bike_station_cnt",
        c."crime_cnt"
    FROM (
          SELECT
              n."neighborhood",
              COUNT(*) AS "bike_station_cnt"
          FROM SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS.BOUNDARIES n
          JOIN SAN_FRANCISCO_PLUS.SAN_FRANCISCO_BIKESHARE.BIKESHARE_STATION_INFO s
            ON ST_CONTAINS(
                  TO_GEOGRAPHY(n."neighborhood_geom"),
                  TO_GEOGRAPHY(POINT(s."lon", s."lat"))
               )
          GROUP BY n."neighborhood"
    ) b
    JOIN (
          SELECT
              n."neighborhood",
              COUNT(*) AS "crime_cnt"
          FROM SAN_FRANCISCO_PLUS.SAN_FRANCISCO_NEIGHBORHOODS.BOUNDARIES n
          JOIN SAN_FRANCISCO_PLUS.SAN_FRANCISCO_SFPD_INCIDENTS.SFPD_INCIDENTS c
            ON ST_CONTAINS(
                  TO_GEOGRAPHY(n."neighborhood_geom"),
                  TO_GEOGRAPHY(POINT(c."longitude", c."latitude"))
               )
          GROUP BY n."neighborhood"
    ) c
      ON b."neighborhood" = c."neighborhood"
) t
WHERE t."neighborhood" ILIKE '%soma%'
LIMIT 20;
