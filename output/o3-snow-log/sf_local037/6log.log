```sql
--Description: Join payments to order-items to see which products received which payment type  
SELECT p."payment_type",
       p."payment_value",
       oi."product_id"
FROM BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_ORDER_PAYMENTS  p
JOIN BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_ORDER_ITEMS     oi
  ON p."order_id" = oi."order_id"
LIMIT 20;
```

```sql
--Description: Bring in the product category for each paid item  
SELECT p."payment_type",
       pr."product_category_name",
       oi."product_id"
FROM BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_ORDER_PAYMENTS  p
JOIN BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_ORDER_ITEMS     oi
  ON p."order_id" = oi."order_id"
JOIN BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_PRODUCTS        pr
  ON oi."product_id" = pr."product_id"
LIMIT 20;
```

```sql
--Description: Count how many payments of each type exist inside every product category  
SELECT pr."product_category_name",
       p."payment_type",
       COUNT(*) AS "payment_cnt"
FROM BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_ORDER_PAYMENTS  p
JOIN BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_ORDER_ITEMS     oi
  ON p."order_id" = oi."order_id"
JOIN BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_PRODUCTS        pr
  ON oi."product_id" = pr."product_id"
GROUP BY pr."product_category_name",
         p."payment_type"
ORDER BY "payment_cnt" DESC
LIMIT 20;
```

```sql
--Description: Add a row number to find the most-used payment type inside every category  
SELECT *,
       ROW_NUMBER() OVER (PARTITION BY "product_category_name"
                          ORDER BY "payment_cnt" DESC) AS "rn"
FROM (
      SELECT pr."product_category_name",
             p."payment_type",
             COUNT(*) AS "payment_cnt"
      FROM BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_ORDER_PAYMENTS  p
      JOIN BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_ORDER_ITEMS     oi
        ON p."order_id" = oi."order_id"
      JOIN BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_PRODUCTS        pr
        ON oi."product_id" = pr."product_id"
      GROUP BY pr."product_category_name",
               p."payment_type"
     ) t
LIMIT 20;
```

```sql
--Description: Keep only the single most common payment type for each category  
SELECT "product_category_name",
       "payment_type",
       "payment_cnt"
FROM (
      SELECT "product_category_name",
             "payment_type",
             "payment_cnt",
             ROW_NUMBER() OVER (PARTITION BY "product_category_name"
                                ORDER BY "payment_cnt" DESC) AS "rn"
      FROM (
            SELECT pr."product_category_name",
                   p."payment_type",
                   COUNT(*) AS "payment_cnt"
            FROM BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_ORDER_PAYMENTS  p
            JOIN BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_ORDER_ITEMS     oi
              ON p."order_id" = oi."order_id"
            JOIN BRAZILIAN_E_COMMERCE.BRAZILIAN_E_COMMERCE.OLIST_PRODUCTS        pr
              ON oi."product_id" = pr."product_id"
            GROUP BY pr."product_category_name",
                     p."payment_type"
           ) x
     ) y
WHERE "rn" = 1
LIMIT 20;
```

