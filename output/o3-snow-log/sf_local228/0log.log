        bb.BOWLER
),

/* Rank bowlers – top three per season */
top_bowler AS (
    SELECT
        SEASON_ID,
        PLAYER_ID,
        TOTAL_WICKETS,
        ROW_NUMBER() OVER (
            PARTITION BY SEASON_ID
            ORDER BY TOTAL_WICKETS DESC, PLAYER_ID ASC
        ) AS POS
    FROM bowler_wkts
    QUALIFY POS <= 3
)

/* ---------------------------------------------------------
   Final output: pair batsmen & bowlers by (season, position)
--------------------------------------------------------- */
SELECT
    b.SEASON_ID,
    b.PLAYER_ID   AS BATSMAN_ID,
    b.TOTAL_RUNS,
    w.PLAYER_ID   AS BOWLER_ID,
    w.TOTAL_WICKETS
FROM top_batsman b
JOIN top_bowler w
  ON  b.SEASON_ID = w.SEASON_ID
  AND b.POS       = w.POS
ORDER BY
