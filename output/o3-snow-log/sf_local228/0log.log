```sql
WITH
/* ---------------------------------------------------------
   Total runs scored by every batsman in every season
--------------------------------------------------------- */
batsman_runs AS (
    SELECT
        m.season_id,
        bb.striker              AS player_id,
        SUM(bs.runs_scored)     AS total_runs
    FROM IPL.IPL."MATCH"      m
    JOIN IPL.IPL.BATSMAN_SCORED bs
         ON bs.match_id = m.match_id
    JOIN IPL.IPL.BALL_BY_BALL  bb
         ON  bs.match_id   = bb.match_id
         AND bs.innings_no = bb.innings_no
         AND bs.over_id    = bb.over_id
         AND bs.ball_id    = bb.ball_id
    GROUP BY
        m.season_id,
        bb.striker
),

/* rank batsmen – top three per season (tie-break: smaller player_id) */
top_batsman AS (
    SELECT
        season_id,
        player_id,
        total_runs,
        ROW_NUMBER() OVER (
            PARTITION BY season_id
            ORDER BY total_runs DESC NULLS LAST, player_id ASC
        ) AS pos
    FROM batsman_runs
    QUALIFY pos <= 3
),

/* ---------------------------------------------------------
   Total wickets taken by every bowler in every season
   (excluding run-out, hit-wicket, retired-hurt)
--------------------------------------------------------- */
bowler_wkts AS (
    SELECT
        m.season_id,
        bb.bowler              AS player_id,
        COUNT(*)               AS total_wickets
    FROM IPL.IPL."MATCH"     m
    JOIN IPL.IPL.WICKET_TAKEN wt
         ON wt.match_id = m.match_id
    JOIN IPL.IPL.BALL_BY_BALL bb
         ON  wt.match_id   = bb.match_id
         AND wt.innings_no = bb.innings_no
         AND wt.over_id    = bb.over_id
         AND wt.ball_id    = bb.ball_id
    WHERE LOWER(wt.kind_out) NOT IN ('run out', 'hit wicket', 'retired hurt')
    GROUP BY
        m.season_id,
        bb.bowler
),

/* rank bowlers – top three per season (tie-break: smaller player_id) */
top_bowler AS (
    SELECT
        season_id,
        player_id,
        total_wickets,
        ROW_NUMBER() OVER (
            PARTITION BY season_id
            ORDER BY total_wickets DESC NULLS LAST, player_id ASC
        ) AS pos
    FROM bowler_wkts
    QUALIFY pos <= 3
)

/* ---------------------------------------------------------
   Final output: pair batsmen & bowlers by season and rank
--------------------------------------------------------- */
SELECT
    b.season_id,
    b.player_id  AS batsman_id,
    b.total_runs,
    w.player_id  AS bowler_id,
    w.total_wickets
FROM top_batsman b
JOIN top_bowler  w
  ON  b.season_id = w.season_id
  AND b.pos       = w.pos
ORDER BY
    b.season_id,
    b.pos;
```
