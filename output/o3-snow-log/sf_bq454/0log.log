/*-----------------------------------------------------------
  Common autosomal variants (AF ≥ 0.05) – sharing profile per
  1000 Genomes super-population
-----------------------------------------------------------*/
WITH super_pop_sizes AS (          -- total number of samples in each super population
    SELECT
        "Super_Population"                AS super_pop,
        COUNT(*)                          AS pop_size
    FROM  "_1000_GENOMES"."_1000_GENOMES"."SAMPLE_INFO"
    WHERE "Super_Population" IS NOT NULL
    GROUP BY "Super_Population"
),
common_autosomal_calls AS (        -- one row per (variant, sample) carrying ≥1 alt allele
    SELECT
        /* simple reproducible key for the variant */
        CONCAT(
            v."reference_name", ':',
            v."start", ':',
            v."reference_bases", ':',
            v."alternate_bases"[0]::string
        )                                               AS variant_id,
        si."Super_Population"                           AS super_pop,
        f.value:"call_set_name"::string                 AS sample_name
    FROM  "_1000_GENOMES"."_1000_GENOMES"."VARIANTS" v,
          LATERAL FLATTEN(input => v."call") f
          JOIN "_1000_GENOMES"."_1000_GENOMES"."SAMPLE_INFO" si
            ON si."Sample" = f.value:"call_set_name"::string
    WHERE v."AF" >= 0.05                                -- common variants
      AND v."reference_name" NOT IN ('X','Y','MT')      -- autosomes only
      /* sample must carry at least one alternate allele (non-reference) */
      AND ( (f.value:"genotype")[0]::int <> 0
         OR (f.value:"genotype")[1]::int <> 0 )
      AND si."Super_Population" IS NOT NULL
),
variant_sample_counts AS (        -- how many samples in each super pop share the variant
    SELECT
        super_pop,
        variant_id,
        COUNT(DISTINCT sample_name)  AS samples_with_variant
    FROM  common_autosomal_calls
    GROUP BY super_pop, variant_id
),
distribution AS (                 -- distribution: how many variants are shared by N samples
    SELECT
        super_pop,
        samples_with_variant,
        COUNT(*)                  AS variant_count
    FROM  variant_sample_counts
    GROUP BY super_pop, samples_with_variant
)

SELECT
    d.super_pop                                AS "Super_Population",
    s.pop_size                                 AS "Population_Size",
    TRUE                                       AS "Is_Common_Variant_AF>=0.05",
    d.samples_with_variant                     AS "Samples_With_Variant",
    d.variant_count                            AS "Variant_Count"
FROM   distribution d
JOIN   super_pop_sizes s
       ON s.super_pop = d.super_pop
ORDER BY d.super_pop,
         d.samples_with_variant;
```
