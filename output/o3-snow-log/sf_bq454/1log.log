```sql
/*  -------------------------------------------------------------
    Distribution of COMMON (AF ≥ 0.05) autosomal variants
    per super-population in the 1000 Genomes data set
----------------------------------------------------------------*/

WITH
/* 1. Number of individuals per super-population -------------- */
pop_size AS (
    SELECT
        "Super_Population"              AS super_pop ,
        COUNT(DISTINCT "Sample")        AS population_size
    FROM   _1000_GENOMES._1000_GENOMES.SAMPLE_INFO
    WHERE  "Super_Population" IS NOT NULL
    GROUP  BY "Super_Population"
),

/* 2. Pre-filter variants that are common in ≥ 1 population
      (avoids flattening the full table)                       */
variant_common AS (
    SELECT *
    FROM   _1000_GENOMES._1000_GENOMES.VARIANTS
    WHERE  "reference_name" NOT IN ('X','Y','MT')              -- autosomes
      AND ( NVL("AFR_AF",0) >= 0.05
         OR NVL("AMR_AF",0) >= 0.05
         OR NVL("EUR_AF",0) >= 0.05
         OR NVL("ASN_AF",0) >= 0.05 )                          -- common
),

/* 3. For every (variant , super-pop) count samples
      carrying ≥1 alternate allele                              */
variant_sample_counts AS (
    SELECT
        vc."reference_name"                AS chr ,
        vc."start"                         AS pos ,
        vc."alternate_bases"               AS alt ,
        si."Super_Population"              AS super_pop ,
        COUNT(DISTINCT si."Sample")        AS samples_with_alt
    FROM   variant_common                      vc
           ,LATERAL FLATTEN (INPUT => vc."call") c
           JOIN _1000_GENOMES._1000_GENOMES.SAMPLE_INFO si
                ON si."Sample" = c.value:"call_set_name"::string
    WHERE  si."Super_Population" IS NOT NULL
      AND ( COALESCE( c.value:"genotype"[0]::INT , 0 ) > 0
         OR COALESCE( c.value:"genotype"[1]::INT , 0 ) > 0 )   -- ≥1 alt allele
    GROUP  BY vc."reference_name",
              vc."start",
              vc."alternate_bases",
              si."Super_Population"
),

/* 4. Distribution: for each super-population,
      #variants shared by N samples                             */
variant_distribution AS (
    SELECT
        super_pop,
        samples_with_alt,
        COUNT(*)  AS variants_count
    FROM   variant_sample_counts
    GROUP  BY super_pop, samples_with_alt
)

/* 5. Final report -------------------------------------------- */
SELECT
    vd.super_pop,
    ps.population_size,                     -- total individuals
    TRUE AS is_common_variant_af_ge_0_05,   -- all variants meet AF filter
    vd.samples_with_alt,                    -- N samples sharing variant
    vd.variants_count                       -- how many such variants
FROM   variant_distribution vd
       JOIN pop_size ps
         ON ps.super_pop = vd.super_pop
ORDER  BY vd.super_pop,
         vd.samples_with_alt;
