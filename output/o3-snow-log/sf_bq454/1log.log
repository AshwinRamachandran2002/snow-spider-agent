```sql
/* ---------------------------------------------------------------
   Common (AF ≥ 0.05) AUTOSOMAL variants – distribution per
   super–population in the 1000 Genomes data set
-----------------------------------------------------------------*/

WITH  -------------------------------------------------------------
/* 1. population size (number of samples) per super-population  */
pop_size AS (
    SELECT
        "Super_Population"                         AS super_pop ,
        COUNT(DISTINCT "Sample")                   AS population_size
    FROM   _1000_GENOMES._1000_GENOMES.SAMPLE_INFO
    WHERE  "Super_Population" IS NOT NULL
    GROUP  BY "Super_Population"
),

/* 2. for every variant & super-population:
      how many samples carry ≥1 alternate allele                 */
variant_sample_counts AS (
    SELECT
        v."reference_name"                         AS chr ,
        v."start"                                  AS pos ,
        v."reference_bases"                        AS ref ,
        v."alternate_bases"                        AS alt ,
        si."Super_Population"                      AS super_pop ,
        COUNT(DISTINCT si."Sample")                AS samples_with_alt
    FROM   _1000_GENOMES._1000_GENOMES.VARIANTS  v
           ,LATERAL FLATTEN (INPUT => v."call")  c      -- one row per call
           JOIN _1000_GENOMES._1000_GENOMES.SAMPLE_INFO si
                 ON si."Sample" = c.value:"call_set_name"::string
    WHERE  v."reference_name"        NOT IN ('X','Y','MT')   -- autosomes only
      AND  v."AF"                   >= 0.05                 -- common variant
      AND  si."Super_Population"     IS NOT NULL
      -- sample must have at least one non-reference allele
      AND ( COALESCE( c.value:"genotype"[0]::INT , 0 ) > 0
         OR COALESCE( c.value:"genotype"[1]::INT , 0 ) > 0 )
    GROUP  BY  v."reference_name", v."start",
               v."reference_bases", v."alternate_bases",
               si."Super_Population"
),

/* 3. distribution: for each super-population,
      how many variants are shared by N samples                 */
variant_distribution AS (
    SELECT
        super_pop,
        samples_with_alt,
        COUNT(*)          AS variants_count
    FROM   variant_sample_counts
    GROUP  BY super_pop, samples_with_alt
)

/* 4. final report ---------------------------------------------*/
SELECT
    vd.super_pop,
    ps.population_size,                       -- total samples in pop
    TRUE  AS is_common_variant_af_ge_0_05,    -- constant (all variants pass AF filter)
    vd.samples_with_alt,                      -- N samples that share the variant
    vd.variants_count                         -- how many variants have that N
FROM   variant_distribution vd
       JOIN pop_size ps  ON ps.super_pop = vd.super_pop
ORDER  BY vd.super_pop,
         vd.samples_with_alt;
```
