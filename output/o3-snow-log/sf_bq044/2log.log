--Description: 2)  Fetch every unique TCGA-BLCA patient that harbours a CDKN2A mutation in the
--GDC Release-10 somatic-mutation table; this trims the list to barcodes only.
SELECT DISTINCT 
       m."case_barcode"
FROM "TCGA"."TCGA_VERSIONED"."SOMATIC_MUTATION_HG38_GDC_R10"  m
WHERE m."project_short_name" = 'TCGA-BLCA'
  AND  m."Hugo_Symbol"       = 'CDKN2A'
LIMIT 20
