```sql
--Description: 8)  Retrieve expression values (FPKM) for the four downstream genes in
--TCGA-BLCA from the R40 RNA-seq snapshot; no join attempted because the table
--appears not to carry per-patient barcodes.
SELECT
       e."gene_name",
       e."fpkm_unstranded"
FROM "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R40" AS e
WHERE e."project_short_name" = 'TCGA-BLCA'
  AND  e."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
LIMIT 20;
```

```sql
--Description: 9)  Combine CDKN2A-mutation information with clinical data for the
--single BLCA case we found (TCGA-FD-A5BV); append R40 project-level expression
--values for the four genes, recognising that expression is not per-patient here.
SELECT
       m."case_barcode",
       m."Variant_Classification",
       m."Variant_Type",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death",
       e."gene_name",
       e."fpkm_unstranded"
FROM "TCGA"."TCGA_VERSIONED"."SOMATIC_MUTATION_HG38_GDC_R10"  m
JOIN "TCGA"."TCGA_VERSIONED"."CLINICAL_GDC_R39"               c
  ON m."case_barcode" = c."submitter_id"
JOIN "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R40"            e
  ON e."project_short_name" = 'TCGA-BLCA'      -- project-level match
WHERE m."project_short_name" = 'TCGA-BLCA'
  AND  m."Hugo_Symbol"       = 'CDKN2A'
  AND  e."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
LIMIT 20;
```

```sql
--Description: 10)  Summarise the CDKN2A-mutant bladder-cancer patient’s mutation
--attributes and clinical status alongside project-level FPKM for the four genes.
SELECT
       m."case_barcode",
       m."Variant_Classification",
       m."Variant_Type",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death",
       MAX(CASE WHEN e."gene_name" = 'MDM2'   THEN e."fpkm_unstranded" END) AS "MDM2_FPKM",
       MAX(CASE WHEN e."gene_name" = 'TP53'   THEN e."fpkm_unstranded" END) AS "TP53_FPKM",
       MAX(CASE WHEN e."gene_name" = 'CDKN1A' THEN e."fpkm_unstranded" END) AS "CDKN1A_FPKM",
       MAX(CASE WHEN e."gene_name" = 'CCNE1'  THEN e."fpkm_unstranded" END) AS "CCNE1_FPKM"
FROM "TCGA"."TCGA_VERSIONED"."SOMATIC_MUTATION_HG38_GDC_R10"  m
JOIN "TCGA"."TCGA_VERSIONED"."CLINICAL_GDC_R39"               c
  ON m."case_barcode" = c."submitter_id"
JOIN "TCGA"."TCGA_VERSIONED"."RNASEQ_HG38_GDC_R40"            e
  ON e."project_short_name" = 'TCGA-BLCA'
WHERE m."project_short_name" = 'TCGA-BLCA'
  AND  m."Hugo_Symbol"       = 'CDKN2A'
  AND  e."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
GROUP BY
       m."case_barcode",
       m."Variant_Classification",
       m."Variant_Type",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death"
LIMIT 20;
```
