Query:
--Description: 3)  Pull gender, vital-status, and days-to-death for those CDKN2A-mutant
--bladder-cancer cases identified in step-2, using clinical release 39.
SELECT 
       c."submitter_id",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death"
FROM "TCGA"."TCGA_VERSIONED"."CLINICAL_GDC_R39"  c
WHERE c."submitter_id" IN ( 
      SELECT DISTINCT m."case_barcode"
      FROM "TCGA"."TCGA_VERSIONED"."SOMATIC_MUTATION_HG38_GDC_R10" m
      WHERE m."project_short_name" = 'TCGA-BLCA'
        AND m."Hugo_Symbol"        = 'CDKN2A' )
LIMIT 20
