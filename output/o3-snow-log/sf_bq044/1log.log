```sql
--Description: 10)  Provide a combined view that links (a) CDKN2A-mutant
--                TCGA-BLCA patients (identified in HG19 DCC 2017-02) with
--                (b) their clinical attributes (GDC clinical R39), and
--                (c) the average BLCA-level expression of the four
--                downstream genes (calculated from RNA-seq R35).  Because
--                the RNA-seq table lacks case-level barcodes, expression
--                is aggregated at the project level before joining.
WITH cdkn2a_patients AS (
    SELECT DISTINCT
           "case_barcode",
           "Variant_Classification"
    FROM   TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG19_DCC_2017_02"
    WHERE  "project_short_name" = 'TCGA-BLCA'
      AND  "Hugo_Symbol"        = 'CDKN2A'
),
blca_expression AS (
    SELECT
           "gene_name",
           AVG("fpkm_unstranded") AS "avg_fpkm",
           AVG("tpm_unstranded")  AS "avg_tpm"
    FROM   TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"
    WHERE  "project_short_name" = 'TCGA-BLCA'
      AND  "gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
    GROUP BY "gene_name"
)
SELECT
       p."case_barcode",
       p."Variant_Classification"          AS "cdkn2a_mutation_type",
       c."demo__gender"                    AS "gender",
       c."demo__vital_status"              AS "vital_status",
       c."demo__days_to_death"             AS "days_to_death",
       e."gene_name",
       e."avg_fpkm",
       e."avg_tpm"
FROM   cdkn2a_patients            p
JOIN   TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"  c
       ON c."submitter_id" = p."case_barcode"
JOIN   blca_expression            e
       ON 1=1        -- Cartesian join to append BLCA-level gene expression
LIMIT  20;
```
