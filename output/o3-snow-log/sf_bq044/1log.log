-- 10.  Final composite query: link CDKN2A-mutant BLCA patients to
--      (i) their mutation types, (ii) clinical attributes from release-39,
--      and (iii) expression of the four downstream genes
SELECT
       mut."case_barcode",
       mut."Variant_Classification"          AS "cdkn2a_mutation_type",
       clin."demo__gender"                  AS "gender",
       clin."demo__vital_status"            AS "vital_status",
       clin."demo__days_to_death"           AS "days_to_death",
       expr."gene_name",
       expr."fpkm_unstranded"               AS "fpkm",
       expr."tpm_unstranded"                AS "tpm"
FROM   (  /* CDKN2A-mutant set */
        SELECT DISTINCT
               "case_barcode",
               "Variant_Classification"
        FROM   TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG38_GDC_R7"
        WHERE  "project_short_name" = 'TCGA-BLCA'
          AND  "Hugo_Symbol"       = 'CDKN2A' )                mut
JOIN   TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                  clin
      ON clin."submitter_id" = mut."case_barcode"
JOIN   TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"               expr
      ON expr."case_barcode"      = mut."case_barcode"
     AND expr."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
LIMIT  20;
```
