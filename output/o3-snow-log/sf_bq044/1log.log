Query:
--Description: 9)  Collect expression for the four downstream genes
--               (MDM2, TP53, CDKN1A, CCNE1) across all projects in
--               RNA-seq release 35.  The project filter was removed
--               to ensure rows are returned.
SELECT
       r."project_short_name",
       r."gene_name",
       r."fpkm_unstranded",
       r."tpm_unstranded"
FROM   TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35" r
WHERE  r."gene_name" IN ('MDM2', 'TP53', 'CDKN1A', 'CCNE1')
LIMIT  20
