Query:
--Description: 4)  Summarise the spectrum of CDKN2A mutation effects observed
--               in TCGA-BLCA using the HG19 DCC 2017-02 mutation release
--               (the only table in which CDKN2A hits were confirmed).
SELECT DISTINCT
       "Variant_Classification"
FROM   TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG19_DCC_2017_02"
WHERE  "project_short_name" = 'TCGA-BLCA'
  AND  "Hugo_Symbol"        = 'CDKN2A'
LIMIT  20
Answer:
Variant_Classification
Nonsense_Mutation
Missense_Mutation
Query:
--Description: 5)  Pull gender, vital-status and days-to-death (GDC clinical
--               release 39) for TCGA-BLCA patients carrying a CDKN2A
--               mutation (defined in the HG19 DCC 2017-02 table).
SELECT
       clin."submitter_id"       AS "case_barcode",
       clin."demo__gender"       AS "gender",
       clin."demo__vital_status" AS "vital_status",
       clin."demo__days_to_death"
FROM   TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39" clin
WHERE  clin."submitter_id" IN (
        SELECT DISTINCT
               "case_barcode"
        FROM   TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG19_DCC_2017_02"
        WHERE  "project_short_name" = 'TCGA-BLCA'
          AND  "Hugo_Symbol"        = 'CDKN2A'
      )
LIMIT  20
Answer:
case_barcode,gender,vital_status,demo__days_to_death
TCGA-ZF-A9R4,male,Alive,
TCGA-GU-A42Q,male,Dead,344
TCGA-GU-A766,male,Alive,
TCGA-GD-A3OS,female,Alive,
Query:
--Description: 7)  Retrieve rows that contain expression values for the gene
--               MDM2 (any project) from RNA-seq release 35.  The earlier BLCA
--               filter was removed because no BLCA entries were detected.
SELECT
       r."project_short_name",
       r."gene_name",
       r."fpkm_unstranded",
       r."tpm_unstranded"
FROM   TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35" r
WHERE  r."gene_name" = 'MDM2'
LIMIT  20
