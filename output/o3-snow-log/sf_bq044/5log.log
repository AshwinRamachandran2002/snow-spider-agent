Query:
--Description: 4) Join CDKN2A-mutated LUAD patients (CDKN2A = ENSG00000147889, allow
--             version suffix) with their clinical data.  We use TCGA-LUAD because
--             the earlier check showed CDKN2A mutations are present only in LUAD,
--             not BLCA, in Release 39.
SELECT
       mut."case_barcode"          AS "submitter_id",
       mut."Variant_Classification",
       mut."Variant_Type",
       clin."demo__gender",
       clin."demo__vital_status",
       clin."demo__days_to_death"
FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"  mut
JOIN   TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                     clin
  ON   mut."case_barcode" = clin."submitter_id"
WHERE  mut."project_short_name" = 'TCGA-LUAD'
  AND  mut."Gene"               LIKE 'ENSG00000147889%'   -- CDKN2A
LIMIT  20
Answer:
submitter_id,Variant_Classification,Variant_Type,demo__gender,demo__vital_status,demo__days_to_death
TCGA-55-1594,Frame_Shift_Ins,INS,male,Alive,
