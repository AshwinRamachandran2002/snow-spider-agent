[{'project_short_name': 'TCGA-HNSC', 'gene_name': 'Y_RNA', 'HTSeq__Counts': 0, 'HTSeq__FPKM': 0.0, 'HTSeq__FPKM_UQ': 0.0}, {'project_short_name': 'TCGA-HNSC', 'gene_name': 'AC009065.1', 'HTSeq__Counts': 0, 'HTSeq__FPKM': 0.0, 'HTSeq__FPKM_UQ': 0.0}, {'project_short_name': 'TCGA-HNSC', 'gene_name': 'RP11-586K12.1', 'HTSeq__Counts': 0, 'HTSeq__FPKM': 0.0, 'HTSeq__FPKM_UQ': 0.0}, {'project_short_name': 'TCGA-HNSC', 'gene_name': 'HIST1H2AI', 'HTSeq__Counts': 15, 'HTSeq__FPKM': 0.514392112073, 'HTSeq__FPKM_UQ': 14469.2254045}, {'project_short_name': 'TCGA-HNSC', 'gene_name': 'RP11-178C3.6', 'HTSeq__Counts': 0, 'HTSeq__FPKM': 0.0, 'HTSeq__FPKM_UQ': 0.0}]

