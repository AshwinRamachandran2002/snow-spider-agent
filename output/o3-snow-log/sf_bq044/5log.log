Query:
--Description: 9) Wide view: for each LUAD patient with a CDKN2A mutation, show the
--             mutation class plus FPKM-UQ expression of four downstream genes
--             (expression from Release 35).
SELECT
       mut."case_barcode"                                       AS "submitter_id",
       MAX(mut."Variant_Classification")                        AS "cdkn2a_mut_class",
       MAX(CASE WHEN expr."gene_name" = 'MDM2'   THEN expr."fpkm_uq_unstranded" END) AS "MDM2_FPKM_UQ",
       MAX(CASE WHEN expr."gene_name" = 'TP53'   THEN expr."fpkm_uq_unstranded" END) AS "TP53_FPKM_UQ",
       MAX(CASE WHEN expr."gene_name" = 'CDKN1A' THEN expr."fpkm_uq_unstranded" END) AS "CDKN1A_FPKM_UQ",
       MAX(CASE WHEN expr."gene_name" = 'CCNE1'  THEN expr."fpkm_uq_unstranded" END) AS "CCNE1_FPKM_UQ"
FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"  mut
LEFT JOIN TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"               expr
       ON expr."project_short_name" = mut."project_short_name"
      AND expr."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
WHERE  mut."project_short_name" = 'TCGA-LUAD'
  AND  mut."Gene"               LIKE 'ENSG00000147889%'   -- CDKN2A
GROUP BY mut."case_barcode"
LIMIT  20
Answer:
submitter_id,cdkn2a_mut_class,MDM2_FPKM_UQ,TP53_FPKM_UQ,CDKN1A_FPKM_UQ,CCNE1_FPKM_UQ
TCGA-55-1594,Frame_Shift_Ins,40.8099,20.5936,153.829,10.4731
Query:
--Description: 10) Final integrated view – add clinical data to the wide mutation /
--              expression table for CDKN2A-mutated LUAD cases (expression from R35).
SELECT
       w."submitter_id",
       clin."demo__gender",
       clin."demo__vital_status",
       clin."demo__days_to_death",
       w."cdkn2a_mut_class",
       w."MDM2_FPKM_UQ",
       w."TP53_FPKM_UQ",
       w."CDKN1A_FPKM_UQ",
       w."CCNE1_FPKM_UQ"
FROM (
       SELECT
              mut."case_barcode" AS "submitter_id",
              MAX(mut."Variant_Classification") AS "cdkn2a_mut_class",
              MAX(CASE WHEN expr."gene_name" = 'MDM2'   THEN expr."fpkm_uq_unstranded" END) AS "MDM2_FPKM_UQ",
              MAX(CASE WHEN expr."gene_name" = 'TP53'   THEN expr."fpkm_uq_unstranded" END) AS "TP53_FPKM_UQ",
              MAX(CASE WHEN expr."gene_name" = 'CDKN1A' THEN expr."fpkm_uq_unstranded" END) AS "CDKN1A_FPKM_UQ",
              MAX(CASE WHEN expr."gene_name" = 'CCNE1'  THEN expr."fpkm_uq_unstranded" END) AS "CCNE1_FPKM_UQ"
       FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"  mut
       LEFT JOIN TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"               expr
              ON expr."project_short_name" = mut."project_short_name"
             AND expr."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
       WHERE  mut."project_short_name" = 'TCGA-LUAD'
         AND  mut."Gene"               LIKE 'ENSG00000147889%'   -- CDKN2A
       GROUP BY mut."case_barcode"
     ) w
LEFT JOIN TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39" clin
       ON w."submitter_id" = clin."submitter_id"
LIMIT  20
Answer:
submitter_id,demo__gender,demo__vital_status,demo__days_to_death,cdkn2a_mut_class,MDM2_FPKM_UQ,TP53_FPKM_UQ,CDKN1A_FPKM_UQ,CCNE1_FPKM_UQ
TCGA-55-1594,male,Alive,,Frame_Shift_Ins,40.8099,20.5936,153.829,10.4731
