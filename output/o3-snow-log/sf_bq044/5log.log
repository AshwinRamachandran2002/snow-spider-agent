--Description: 8) Combine CDKN2A-mutated LUAD cases with their MDM2 expression
--             (expression pulled from Release 35; joined by project name).
SELECT
       mut."case_barcode"        AS "submitter_id",
       mut."Variant_Classification",
       expr."gene_name",
       expr."fpkm_unstranded",
       expr."tpm_unstranded"
FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"  mut
JOIN   TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"                  expr
  ON   expr."project_short_name" = mut."project_short_name"
WHERE  mut."project_short_name" = 'TCGA-LUAD'
  AND  mut."Gene"               LIKE 'ENSG00000147889%'   -- CDKN2A
  AND  expr."gene_name"         = 'MDM2'
LIMIT  20
