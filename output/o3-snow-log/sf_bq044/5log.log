```

```sql
--Description: 7)  Fetch expression of the four downstream genes (MDM2, TP53,
--               CDKN1A, CCNE1) in a single query for BLCA samples.
SELECT
       "gene_name",
       "fpkm_unstranded",
       "tpm_unstranded",
       "fpkm_uq_unstranded"
FROM   TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"
WHERE  "project_short_name" = 'TCGA-BLCA'
  AND  "gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
LIMIT  20;
```

```sql
--Description: 8)  Combine the CDKN2A-mutated BLCA cases with their MDM2 expression
--               values by matching on project (note: the RNA-seq table does not
--               store barcodes, so this join uses only the project name).
SELECT
       mut."case_barcode"                        AS "submitter_id",
       mut."Variant_Classification",
       expr."gene_name",
       expr."fpkm_unstranded",
       expr."tpm_unstranded"
FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"  mut
JOIN   TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"                  expr
  ON   expr."project_short_name" = mut."project_short_name"
WHERE  mut."project_short_name"  = 'TCGA-BLCA'
  AND  mut."Gene"                = 'CDKN2A'
  AND  expr."gene_name"          = 'MDM2'
LIMIT  20;
```

```sql
--Description: 9)  Build a wide view that lists, for every BLCA patient harbouring
--               a CDKN2A mutation, the mutation class plus the expression of
--               all four downstream genes (FPKM-UQ).  (Uses conditional aggregation.)
SELECT
       mut."case_barcode"                                       AS "submitter_id",
       MAX(mut."Variant_Classification")                        AS "cdkn2a_mut_class",
       MAX(CASE WHEN expr."gene_name" = 'MDM2'   THEN expr."fpkm_uq_unstranded" END) AS "MDM2_FPKM_UQ",
       MAX(CASE WHEN expr."gene_name" = 'TP53'   THEN expr."fpkm_uq_unstranded" END) AS "TP53_FPKM_UQ",
       MAX(CASE WHEN expr."gene_name" = 'CDKN1A' THEN expr."fpkm_uq_unstranded" END) AS "CDKN1A_FPKM_UQ",
       MAX(CASE WHEN expr."gene_name" = 'CCNE1'  THEN expr."fpkm_uq_unstranded" END) AS "CCNE1_FPKM_UQ"
FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"  mut
LEFT JOIN TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"               expr
       ON expr."project_short_name" = mut."project_short_name"
      AND expr."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
WHERE  mut."project_short_name" = 'TCGA-BLCA'
  AND  mut."Gene"               = 'CDKN2A'
GROUP BY mut."case_barcode"
LIMIT  20;
```

```sql
--Description: 10)  Final integrated view – adds clinical information (gender, vital
--                status, days-to-death) to the previous wide view of mutations +
--                gene expression for CDKN2A-mutated BLCA cases (GDC R39).
SELECT
       w."submitter_id",
       clin."demo__gender",
       clin."demo__vital_status",
       clin."demo__days_to_death",
       w."cdkn2a_mut_class",
       w."MDM2_FPKM_UQ",
       w."TP53_FPKM_UQ",
       w."CDKN1A_FPKM_UQ",
       w."CCNE1_FPKM_UQ"
FROM  (
       SELECT
              mut."case_barcode"                                       AS "submitter_id",
              MAX(mut."Variant_Classification")                        AS "cdkn2a_mut_class",
              MAX(CASE WHEN expr."gene_name" = 'MDM2'   THEN expr."fpkm_uq_unstranded" END) AS "MDM2_FPKM_UQ",
              MAX(CASE WHEN expr."gene_name" = 'TP53'   THEN expr."fpkm_uq_unstranded" END) AS "TP53_FPKM_UQ",
              MAX(CASE WHEN expr."gene_name" = 'CDKN1A' THEN expr."fpkm_uq_unstranded" END) AS "CDKN1A_FPKM_UQ",
              MAX(CASE WHEN expr."gene_name" = 'CCNE1'  THEN expr."fpkm_uq_unstranded" END) AS "CCNE1_FPKM_UQ"
       FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"  mut
       LEFT JOIN TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"               expr
              ON expr."project_short_name" = mut."project_short_name"
             AND expr."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
       WHERE  mut."project_short_name" = 'TCGA-BLCA'
         AND  mut."Gene"               = 'CDKN2A'
       GROUP BY mut."case_barcode"
      ) w
LEFT JOIN TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39" clin
       ON w."submitter_id" = clin."submitter_id"
LIMIT  20;
```
