       MAX(CASE WHEN r."gene_name" = 'CDKN1A' THEN r."fpkm_uq_unstranded" END) AS "CDKN1A_FPKM_UQ",
       MAX(CASE WHEN r."gene_name" = 'CCNE1'  THEN r."fpkm_uq_unstranded" END) AS "CCNE1_FPKM_UQ"
FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"  m
LEFT  JOIN TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                  c
       ON m."case_barcode" = c."submitter_id"
LEFT  JOIN TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"               r
       ON r."project_short_name" = m."project_short_name"
WHERE  m."Hugo_Symbol" = 'CDKN2A'
