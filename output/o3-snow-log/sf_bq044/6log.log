```sql
/*  Bladder-cancer (TCGA-BLCA) patients carrying a CDKN2A mutation:
    – mutation types (classification & variant type)
    – GDC-R39 clinical variables (gender, vital-status, days_to_death)
    – expression (FPKM-UQ) of four downstream genes: MDM2, TP53, CDKN1A, CCNE1          */

WITH mutated_cases AS (
    SELECT
        "case_barcode",
        LISTAGG(DISTINCT "Variant_Classification", ';') 
            WITHIN GROUP (ORDER BY "Variant_Classification") AS "variant_classifications",
        LISTAGG(DISTINCT "Variant_Type", ';') 
            WITHIN GROUP (ORDER BY "Variant_Type")           AS "variant_types"
    FROM   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"
    WHERE  "Hugo_Symbol"        = 'CDKN2A'
      AND  "project_short_name" = 'TCGA-BLCA'
    GROUP BY "case_barcode"
),

clinical AS (
    SELECT
        "submitter_id"        AS "case_barcode",
        "demo__gender"        AS "gender",
        "demo__vital_status"  AS "vital_status",
        "demo__days_to_death" AS "days_to_death"
    FROM TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"
),

expression AS (
    SELECT
        "case_barcode",
        MAX(CASE WHEN "gene_name" = 'MDM2'   THEN "fpkm_uq_unstranded" END) AS "MDM2_FPKM_UQ",
        MAX(CASE WHEN "gene_name" = 'TP53'   THEN "fpkm_uq_unstranded" END) AS "TP53_FPKM_UQ",
        MAX(CASE WHEN "gene_name" = 'CDKN1A' THEN "fpkm_uq_unstranded" END) AS "CDKN1A_FPKM_UQ",
        MAX(CASE WHEN "gene_name" = 'CCNE1'  THEN "fpkm_uq_unstranded" END) AS "CCNE1_FPKM_UQ"
    FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"
    WHERE "project_short_name" = 'TCGA-BLCA'
      AND "gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
    GROUP BY "case_barcode"
)

SELECT
    m."case_barcode",
    m."variant_classifications",
    m."variant_types",
    c."gender",
    c."vital_status",
    c."days_to_death",
    e."MDM2_FPKM_UQ",
    e."TP53_FPKM_UQ",
    e."CDKN1A_FPKM_UQ",
    e."CCNE1_FPKM_UQ"
FROM   mutated_cases m
LEFT JOIN clinical   c ON c."case_barcode" = m."case_barcode"
LEFT JOIN expression e ON e."case_barcode" = m."case_barcode"
ORDER BY m."case_barcode";
```
