  MAX(CASE WHEN e."gene_name" = 'TP53'   THEN e."fpkm_uq_unstranded" END) AS "TP53_FPKM_UQ",
  MAX(CASE WHEN e."gene_name" = 'CDKN1A' THEN e."fpkm_uq_unstranded" END) AS "CDKN1A_FPKM_UQ",
  MAX(CASE WHEN e."gene_name" = 'CCNE1'  THEN e."fpkm_uq_unstranded" END) AS "CCNE1_FPKM_UQ",
  c."demo__gender"                                  AS "gender",
  c."demo__vital_status"                            AS "vital_status",
  c."demo__days_to_death"                           AS "days_to_death"
FROM TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39"  m
JOIN TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                      c
     ON m."case_barcode" = c."submitter_id"
JOIN TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"                   e
     ON m."case_barcode" = e."case_barcode"
WHERE m."project_short_name" = 'TCGA-BLCA'
  AND ( m."Gene" = 'ENSG00000147889' OR m."Gene" ILIKE '%CDKN2A%' )
  AND e."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
GROUP BY 
  m."case_barcode",
  m."Variant_Classification",
  c."demo__gender",
  c."demo__vital_status",
  c."demo__days_to_death"
LIMIT 20;
