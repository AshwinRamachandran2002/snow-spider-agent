Query:
--Description: 10) Integrated view – CDKN2A mutation class, clinical info, and project-average FPKM-UQ for four genes  
WITH expr AS (
     SELECT
            "project_short_name",
            "gene_name",
            AVG("fpkm_uq_unstranded") AS "avg_fpkm_uq"
     FROM   TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R35"
     WHERE  "gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
     GROUP BY "project_short_name","gene_name"
)
SELECT
       m."case_barcode"                                   AS "patient_id",
       m."Variant_Classification"                         AS "cdkn2a_mut_class",
       MAX(CASE WHEN e."gene_name" = 'MDM2'   THEN e."avg_fpkm_uq" END) AS "MDM2_FPKM_UQ",
       MAX(CASE WHEN e."gene_name" = 'TP53'   THEN e."avg_fpkm_uq" END) AS "TP53_FPKM_UQ",
       MAX(CASE WHEN e."gene_name" = 'CDKN1A' THEN e."avg_fpkm_uq" END) AS "CDKN1A_FPKM_UQ",
       MAX(CASE WHEN e."gene_name" = 'CCNE1'  THEN e."avg_fpkm_uq" END) AS "CCNE1_FPKM_UQ",
       c."demo__gender"                                  AS "gender",
       c."demo__vital_status"                            AS "vital_status",
       c."demo__days_to_death"                           AS "days_to_death"
FROM   TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG38_GDC_R10"  m
JOIN   TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"               c
       ON m."case_barcode" = c."submitter_id"
LEFT JOIN expr e
       ON e."project_short_name" = 'TCGA-BLCA'
WHERE  m."project_short_name" = 'TCGA-BLCA'
  AND  m."Hugo_Symbol"        = 'CDKN2A'
GROUP BY
       m."case_barcode",
       m."Variant_Classification",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death"
LIMIT 20
