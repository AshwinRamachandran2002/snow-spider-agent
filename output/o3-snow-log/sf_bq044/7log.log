--Description:
-- We need gender/vital-status values for bladder-cancer (TCGA-BLCA) cases in clinical release 39.
-- Because “submitter_id” itself lacks the project code, a LIKE '%BLCA%' filter fails.
-- Instead, identify BLCA patients by joining the clinical table to a table that *does*
-- carry “project_short_name”.  The masked-somatic mutation R39 table contains that field.
-- Join on the shared barcode (submitter_id ↔ case_barcode), then list distinct
-- gender / vital-status pairs.  Limit to 20 rows for inspection.
SELECT DISTINCT
       c."demo__gender",
       c."demo__vital_status"
FROM   TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"                     c
JOIN   TCGA.TCGA_VERSIONED."MASKED_SOMATIC_MUTATION_HG38_GDC_R39" m
       ON c."submitter_id" = m."case_barcode"
WHERE  m."project_short_name" = 'TCGA-BLCA'
LIMIT 20;
