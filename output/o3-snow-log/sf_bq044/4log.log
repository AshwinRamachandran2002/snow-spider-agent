Query:
--Description: 6)  Summarise the vital-status distribution (Alive vs Dead) for the
--               CDKN2A-mutant bladder-cancer cohort.
SELECT cl."demo__vital_status",
       COUNT(*) AS "num_cases"
FROM (
      SELECT DISTINCT "case_barcode"
      FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG38_GDC_R10
      WHERE "project_short_name" = 'TCGA-BLCA'
        AND "Hugo_Symbol" = 'CDKN2A'
     ) cd
JOIN TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39 cl
  ON cd."case_barcode" = cl."submitter_id"
GROUP BY cl."demo__vital_status"
LIMIT 20
Answer:
demo__vital_status,num_cases
Dead,1
