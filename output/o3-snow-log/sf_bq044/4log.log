```sql
--Description: 5)  Retrieve gender, vital-status and days-to-death
--               for the CDKN2A-mutant bladder cancer patients
--               by joining the mutation list to the Release-39
--               clinical table.
SELECT c."case_barcode",
       cl."demo__gender"       AS "gender",
       cl."demo__vital_status" AS "vital_status",
       cl."demo__days_to_death"
FROM (
      SELECT DISTINCT "case_barcode"
      FROM TCGA.TCGA_VERSIONED.MASKED_SOMATIC_MUTATION_HG38_GDC_R39
      WHERE "project_short_name" = 'TCGA-BLCA'
        AND "Gene" = 'ENSG00000147889'
     ) c
LEFT JOIN TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39 cl
       ON c."case_barcode" = cl."submitter_id"
LIMIT 20;
```

```sql
--Description: 6)  Quickly view how many of those patients are reported
