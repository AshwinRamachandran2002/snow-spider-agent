Query:
--Description: 5)  Retrieve gender, vital-status and days-to-death for the
--               CDKN2A-mutant bladder-cancer patients by joining their barcodes
--               to the Release-39 clinical table.
SELECT c."case_barcode",
       cl."demo__gender"       AS "gender",
       cl."demo__vital_status" AS "vital_status",
       cl."demo__days_to_death"
FROM (
      SELECT DISTINCT "case_barcode"
      FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG38_GDC_R10
      WHERE "project_short_name" = 'TCGA-BLCA'
        AND "Hugo_Symbol" = 'CDKN2A'
     ) c
LEFT JOIN TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39 cl
       ON c."case_barcode" = cl."submitter_id"
LIMIT 20
