```sql
--Description: Combine un-masked mutation data (HG38_GDC_R10) with Release-39 clinical and RNA-seq information to show,
--for each TCGA-BLCA patient who harbours a CDKN2A mutation, the mutation details, clinical outcome variables, and
--TPM expression of four downstream genes (MDM2, TP53, CDKN1A, CCNE1).  Expression rows are filtered by project and
--gene list, then pivoted via CASE logic.
SELECT 
       m."case_barcode",
       m."Variant_Classification",
       m."Variant_Type",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death",
       MAX(CASE WHEN e."gene_name" = 'MDM2'   THEN e."tpm_unstranded" END) AS "MDM2_TPM",
       MAX(CASE WHEN e."gene_name" = 'TP53'   THEN e."tpm_unstranded" END) AS "TP53_TPM",
       MAX(CASE WHEN e."gene_name" = 'CDKN1A' THEN e."tpm_unstranded" END) AS "CDKN1A_TPM",
       MAX(CASE WHEN e."gene_name" = 'CCNE1'  THEN e."tpm_unstranded" END) AS "CCNE1_TPM"
FROM TCGA.TCGA_VERSIONED.SOMATIC_MUTATION_HG38_GDC_R10  m
JOIN TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39               c
  ON m."case_barcode" = c."submitter_id"
JOIN TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39            e
  ON e."project_short_name" = 'TCGA-BLCA'
     AND e."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
WHERE m."project_short_name" = 'TCGA-BLCA'
  AND m."Hugo_Symbol" = 'CDKN2A'
GROUP BY 
       m."case_barcode",
       m."Variant_Classification",
       m."Variant_Type",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death"
LIMIT 20;
```
