```sql
-- 10.  Pull everything together: mutation + clinical + the four gene expression levels per patient
SELECT 
       m."case_barcode",
       m."Variant_Classification",
       m."Variant_Type",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death",
       MAX(CASE WHEN e."gene_name" = 'MDM2'   THEN e."tpm_unstranded" END) AS "MDM2_TPM",
       MAX(CASE WHEN e."gene_name" = 'TP53'   THEN e."tpm_unstranded" END) AS "TP53_TPM",
       MAX(CASE WHEN e."gene_name" = 'CDKN1A' THEN e."tpm_unstranded" END) AS "CDKN1A_TPM",
       MAX(CASE WHEN e."gene_name" = 'CCNE1'  THEN e."tpm_unstranded" END) AS "CCNE1_TPM"
FROM TCGA.TCGA_VERSIONED.MASKED_SOMATIC_MUTATION_HG38_GDC_R39  m
JOIN TCGA.TCGA_VERSIONED.CLINICAL_GDC_R39                      c
  ON m."case_barcode" = c."submitter_id"
JOIN TCGA.TCGA_VERSIONED.RNASEQ_HG38_GDC_R39                   e
  ON e."project_short_name" = 'TCGA-BLCA'      -- restrict expression to BLCA samples
     AND e."gene_name" IN ('MDM2','TP53','CDKN1A','CCNE1')
WHERE m."project_short_name" = 'TCGA-BLCA'
  AND m."Gene" ILIKE '%CDKN2A%'
GROUP BY 
       m."case_barcode",
       m."Variant_Classification",
       m."Variant_Type",
       c."demo__gender",
       c."demo__vital_status",
       c."demo__days_to_death"
LIMIT 20;
```
