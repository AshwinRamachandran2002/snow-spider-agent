Query:
-- Description: Join multi-person crashes with their severe-injury counts (Jan–Aug only)
WITH people_cnt AS (
    SELECT
        "state_number",
        "consecutive_number",
        COUNT(DISTINCT "person_number") AS persons_in_crash
    FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
    WHERE "month_of_crash" BETWEEN 1 AND 8
    GROUP BY "state_number", "consecutive_number"
),
severe_cnt AS (
    SELECT
        "state_number",
        "consecutive_number",
        COUNT(*) AS severe_injuries
    FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
    WHERE "month_of_crash" BETWEEN 1 AND 8
      AND "injury_severity" = 4
    GROUP BY "state_number", "consecutive_number"
)
SELECT
    p."state_number",
    p."consecutive_number",
    p.persons_in_crash,
    COALESCE(s.severe_injuries, 0) AS severe_injuries
FROM people_cnt p
LEFT JOIN severe_cnt s
  ON p."state_number"      = s."state_number"
 AND p."consecutive_number" = s."consecutive_number"
WHERE p.persons_in_crash > 1
LIMIT 20
