WITH crash_stats AS (
    SELECT
        "state_number",
        "consecutive_number",
        COUNT(DISTINCT "person_number")                                          AS "persons_in_crash",
        SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END)                  AS "severe_cnt"
