```sql
-- Description / thinking process:
-- Goal: Among 2015 crashes occurring Jan–Aug that involve more than one distinct person,
--       calculate the percentage in which more than one person suffered a severe injury (injury_severity = 4).
-- Steps implemented below:
--   1. Aggregate PERSON_2015 by the composite crash key ("state_number", "consecutive_number")
--      for months 1-8, counting:
--        • persons_in_crash  – distinct "person_number"
--        • severe_cnt        – number of people with injury_severity = 4
--   2. In the final SELECT, derive:
--        • numerator   – crashes with persons_in_crash > 1 AND severe_cnt > 1
--        • denominator – crashes with persons_in_crash > 1
--        • percentage  – numerator ÷ denominator × 100 (rounded to 2 decimals)
WITH crash_stats AS (
    SELECT
        "state_number",
        "consecutive_number",
        COUNT(DISTINCT "person_number")                                 AS persons_in_crash,
        SUM(IFF("injury_severity" = 4, 1, 0))                           AS severe_cnt
    FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
    WHERE "month_of_crash" BETWEEN 1 AND 8
    GROUP BY "state_number", "consecutive_number"
)
SELECT
    COUNT_IF(persons_in_crash > 1 AND severe_cnt > 1)  AS numerator_multi_severe,
    COUNT_IF(persons_in_crash > 1)                     AS denominator_multi_person,
    ROUND(
        100.0 * COUNT_IF(persons_in_crash > 1 AND severe_cnt > 1)
        / NULLIF(COUNT_IF(persons_in_crash > 1), 0),
        2
    )                                                  AS percent_multi_severe
FROM crash_stats;
```
