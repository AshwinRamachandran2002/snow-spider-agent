       COUNT(*) AS "severe_injuries"
FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
WHERE "month_of_crash" BETWEEN 1 AND 8
  AND "injury_severity" = 4
GROUP BY "ST_CASE"
LIMIT 20;
```

```sql
-- Description: Join the two previous ideas – crashes Jan-Aug with >1 person, keeping severe-injury counts
SELECT a."ST_CASE",
       a."persons_in_crash",
       COALESCE(b."severe_injuries",0) AS "severe_injuries"
FROM (
        SELECT "ST_CASE",
               COUNT(DISTINCT "person_number") AS "persons_in_crash"
        FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
        WHERE "month_of_crash" BETWEEN 1 AND 8
        GROUP BY "ST_CASE"
     ) a
LEFT JOIN (
        SELECT "ST_CASE",
               COUNT(*) AS "severe_injuries"
        FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
        WHERE "month_of_crash" BETWEEN 1 AND 8
          AND "injury_severity" = 4
        GROUP BY "ST_CASE"
     ) b
ON a."ST_CASE" = b."ST_CASE"
WHERE a."persons_in_crash" > 1
LIMIT 20;
```

```sql
