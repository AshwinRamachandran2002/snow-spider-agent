```

```sql
-- Description: Count the denominator = (# crashes Jan-Aug w/ >1 person, regardless of severity)
SELECT COUNT(*) AS "denominator_multi_person_crashes"
FROM (
        SELECT "ST_CASE",
               COUNT(DISTINCT "person_number") AS "persons_in_crash"
        FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
        WHERE "month_of_crash" BETWEEN 1 AND 8
        GROUP BY "ST_CASE"
     ) t
WHERE "persons_in_crash" > 1
LIMIT 20;
```

```sql
-- Description: Put numerator and denominator together and compute the desired percentage
WITH crash_stats AS (
    SELECT "ST_CASE",
           COUNT(DISTINCT "person_number") AS "persons_in_crash",
           SUM(IFF("injury_severity" = 4,1,0)) AS "severe_cnt"
    FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
    WHERE "month_of_crash" BETWEEN 1 AND 8
    GROUP BY "ST_CASE"
)
SELECT
   COUNT_IF("persons_in_crash" > 1 AND "severe_cnt" > 1)  AS "numerator_multi_severe",
   COUNT_IF("persons_in_crash" > 1)                       AS "denominator_multi",
   ROUND(100.0 * COUNT_IF("persons_in_crash" > 1 AND "severe_cnt" > 1)
          / NULLIF(COUNT_IF("persons_in_crash" > 1),0), 2) AS "percentage"
FROM crash_stats
LIMIT 20;
```
