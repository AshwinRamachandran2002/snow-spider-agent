```sql
--Description: Display some sample accident records (identified by ST_CASE) that
--occurred January–August, including month, person number, and injury severity
SELECT
    "ST_CASE",
    "person_number",
    "month_of_crash",
    "injury_severity"
FROM
    NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
WHERE
    "month_of_crash" BETWEEN 1 AND 8
LIMIT 20;
```

```sql
--Description: For January–August crashes, count the number of distinct people
--in accidents that involved more than one person
SELECT
    "ST_CASE",
    COUNT(DISTINCT "person_number") AS "num_persons"
FROM
    NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
WHERE
    "month_of_crash" BETWEEN 1 AND 8
GROUP BY
    "ST_CASE"
HAVING
    COUNT(DISTINCT "person_number") > 1
LIMIT 20;
```

```sql
--Description: For January–August crashes, compute how many people in each crash
--had injury severity = 4 (K-level fatal injury)
SELECT
    "ST_CASE",
    SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "num_severe"
FROM
    NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
WHERE
    "month_of_crash" BETWEEN 1 AND 8
GROUP BY
    "ST_CASE"
LIMIT 20;
```

```sql
--Description: Identify accidents that (a) involved >1 person and (b) had >1 person
--with injury severity = 4, for the January–August window
SELECT
    "ST_CASE"
FROM (
    SELECT
        "ST_CASE",
        COUNT(DISTINCT "person_number") AS "num_persons",
        SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "num_severe"
    FROM
        NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE
        "month_of_crash" BETWEEN 1 AND 8
    GROUP BY
        "ST_CASE"
) t
WHERE
    t."num_persons" > 1
    AND t."num_severe"  > 1
LIMIT 20;
```

```sql
--Description: Count all January–August accidents that involved more than one person
SELECT
    COUNT(*) AS "total_multi_person_accidents"
FROM (
    SELECT
        "ST_CASE"
    FROM
        NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE
        "month_of_crash" BETWEEN 1 AND 8
    GROUP BY
        "ST_CASE"
    HAVING
        COUNT(DISTINCT "person_number") > 1
) t
LIMIT 20;
```

```sql
--Description: Count how many of those multi-person accidents had >1 person with
--injury severity = 4 in the January–August period
SELECT
    COUNT(*) AS "multi_severe_injury_accidents"
FROM (
    SELECT
        "ST_CASE",
        SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "num_severe"
    FROM
        NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE
        "month_of_crash" BETWEEN 1 AND 8
    GROUP BY
        "ST_CASE"
    HAVING
        COUNT(DISTINCT "person_number") > 1
        AND SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) > 1
) t
LIMIT 20;
```

```sql
--Description: Compute the percentage of January–August multi-person accidents
--that had more than one person with injury severity = 4
WITH multi_person AS (
    SELECT
        "ST_CASE",
        COUNT(DISTINCT "person_number")                                       AS "num_persons",
        SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END)               AS "num_severe"
    FROM
        NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE
        "month_of_crash" BETWEEN 1 AND 8
    GROUP BY
        "ST_CASE"
    HAVING
        COUNT(DISTINCT "person_number") > 1
)
SELECT
    ROUND(
        100.0 * SUM(CASE WHEN "num_severe" > 1 THEN 1 ELSE 0 END) / COUNT(*),
        2
    ) AS "pct_multi_severe_injuries"
FROM
    multi_person
LIMIT 20;
```

