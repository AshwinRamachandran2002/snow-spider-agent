    SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "num_severe"
FROM
    NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
WHERE
    "month_of_crash" BETWEEN 1 AND 8
GROUP BY
    "state_number",
    "consecutive_number"
LIMIT 20;
```

```sql
--Description: Identify crashes (Jan–Aug) that involved more than one person
--AND more than one person with injury_severity = 4.  Uses the two-column key
--("state_number","consecutive_number") as the crash identifier and shows the
--first 20 qualifying crashes.
SELECT
    "state_number",
    "consecutive_number"
FROM
    NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
WHERE
    "month_of_crash" BETWEEN 1 AND 8
GROUP BY
    "state_number",
    "consecutive_number"
HAVING
    COUNT(DISTINCT "person_number") > 1
    AND SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) > 1
LIMIT 20;
```

```sql
--Description: Count all January–August crashes that involved more than one
--distinct person.  The sub-query groups by the two-column crash key and the
--outer query returns the total number of such crashes.
SELECT
    COUNT(*) AS "total_multi_person_accidents"
FROM (
    SELECT
        "state_number",
        "consecutive_number"
    FROM
        NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE
        "month_of_crash" BETWEEN 1 AND 8
    GROUP BY
        "state_number",
        "consecutive_number"
    HAVING
        COUNT(DISTINCT "person_number") > 1
) t;
```

```sql
--Description: Count how many of the January–August multi-person crashes had
--more than one person with injury_severity = 4.
SELECT
    COUNT(*) AS "multi_severe_injury_accidents"
FROM (
    SELECT
        "state_number",
        "consecutive_number",
        SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "num_severe"
    FROM
        NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE
        "month_of_crash" BETWEEN 1 AND 8
    GROUP BY
        "state_number",
        "consecutive_number"
    HAVING
        COUNT(DISTINCT "person_number") > 1
        AND SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) > 1
) t;
```

```sql
--Description: Compute the percentage of January–August multi-person crashes
--that had more than one person with injury_severity = 4.  The CTE collects
--all multi-person crashes, then the final SELECT calculates the percentage.
WITH multi_person AS (
    SELECT
        "state_number",
        "consecutive_number",
        COUNT(DISTINCT "person_number")                                   AS "num_persons",
        SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END)           AS "num_severe"
    FROM
        NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE
        "month_of_crash" BETWEEN 1 AND 8
    GROUP BY
        "state_number",
        "consecutive_number"
    HAVING
        COUNT(DISTINCT "person_number") > 1
)
SELECT
    ROUND(
        100.0 * SUM(CASE WHEN "num_severe" > 1 THEN 1 ELSE 0 END) / COUNT(*),
        2
    ) AS "pct_multi_severe_injuries"
FROM
    multi_person;
```
