Query:
--Description: For January–August crashes, compute how many people in each crash
--had injury_severity = 4.  Because PERSON_2015 lacks “ST_CASE”, we identify each
--crash with ("state_number","consecutive_number").  The query lists the first
--20 crashes and their counts of severely-injured persons.
SELECT
    "state_number",
    "consecutive_number",
    SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "num_severe"
FROM
    NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
WHERE
    "month_of_crash" BETWEEN 1 AND 8
GROUP BY
    "state_number",
    "consecutive_number"
LIMIT 20
