--Description: For each multi-person crash, count the number of people with severe injuries (injury_severity = 4).
SELECT "state_number",
       "consecutive_number",
       SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "severe_injury_count",
       COUNT(DISTINCT "person_number")                         AS "person_count"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
WHERE "month_of_crash" BETWEEN 1 AND 8
GROUP BY "state_number", "consecutive_number"
HAVING COUNT(DISTINCT "person_number") > 1
LIMIT 20;
```

```sql
--Description: Compute the total number of January–August crashes that had more than one person.
SELECT COUNT(*) AS "total_multi_person_crashes"
FROM (
      SELECT "state_number", "consecutive_number"
      FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
      WHERE "month_of_crash" BETWEEN 1 AND 8
      GROUP BY "state_number", "consecutive_number"
      HAVING COUNT(DISTINCT "person_number") > 1
     ) t
LIMIT 20;
```

```sql
--Description: Count how many multi-person crashes also had more than one person with severe injuries.
SELECT COUNT(*) AS "crashes_with_multi_severe_injuries"
FROM (
      SELECT "state_number", "consecutive_number"
      FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
      WHERE "month_of_crash" BETWEEN 1 AND 8
      GROUP BY "state_number", "consecutive_number"
      HAVING COUNT(DISTINCT "person_number") > 1
         AND SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) > 1
     ) t
LIMIT 20;
```

```sql
--Description: Calculate the percentage of January–August multi-person crashes that had more than one severe injury.
SELECT 
  ( 100.0 * SUM(CASE WHEN "severe_injury_count" > 1 THEN 1 ELSE 0 END)
    / NULLIF(COUNT(*),0)
  ) AS "percent_multi_person_crashes_with_multi_severe_injuries"
FROM (
      SELECT "state_number",
             "consecutive_number",
             COUNT(DISTINCT "person_number")                      AS "person_count",
             SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "severe_injury_count"
      FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
      WHERE "month_of_crash" BETWEEN 1 AND 8
      GROUP BY "state_number", "consecutive_number"
      HAVING COUNT(DISTINCT "person_number") > 1
     ) t
LIMIT 20;
```
