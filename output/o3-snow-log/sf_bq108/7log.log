--Description: For each multi-person crash, count persons with injury_severity = 4
WITH multi AS (
      SELECT "state_number", "consecutive_number"
      FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
      WHERE "month_of_crash" BETWEEN 1 AND 8
      GROUP BY "state_number", "consecutive_number"
      HAVING COUNT(DISTINCT "person_number") > 1
)
SELECT  p."state_number",
        p."consecutive_number",
        COUNT(CASE WHEN p."injury_severity" = 4 THEN 1 END)  AS "severe_injuries",
        COUNT(DISTINCT p."person_number")                    AS "distinct_persons"
FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015" p
JOIN multi m
  ON p."state_number" = m."state_number"
 AND p."consecutive_number" = m."consecutive_number"
GROUP BY p."state_number", p."consecutive_number"
LIMIT 20
