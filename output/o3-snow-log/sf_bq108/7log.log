```sql
--Description: Percentage of multi-person Jan-Aug crashes that had >1 severe injury
WITH multi AS (
      SELECT "state_number", "consecutive_number"
      FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
      WHERE "month_of_crash" BETWEEN 1 AND 8
      GROUP BY "state_number", "consecutive_number"
      HAVING COUNT(DISTINCT "person_number") > 1
),
severe AS (
      SELECT "state_number", "consecutive_number"
      FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
      WHERE "month_of_crash" BETWEEN 1 AND 8
      GROUP BY "state_number", "consecutive_number"
      HAVING COUNT(CASE WHEN "injury_severity" = 4 THEN 1 END) > 1
)
SELECT 
       100.0 * COUNT(DISTINCT severe."state_number", severe."consecutive_number")
     / NULLIF(COUNT(DISTINCT multi."state_number", multi."consecutive_number"),0) 
       AS "pct_with_multiple_severe"
FROM multi
LEFT JOIN severe
  ON multi."state_number"      = severe."state_number"
 AND multi."consecutive_number" = severe."consecutive_number";
