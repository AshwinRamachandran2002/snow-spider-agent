```sql
--Description: Total number of such multi-person crashes Jan-Aug
SELECT COUNT(*) AS "multi_person_crashes"
FROM (
      SELECT "ST_CASE"
      FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
      WHERE "month_of_crash" BETWEEN 1 AND 8
      GROUP BY "ST_CASE"
      HAVING COUNT(DISTINCT "person_number") > 1
     )
LIMIT 20;
```

```sql
--Description: For each multi-person crash, count number of persons with injury_severity = 4
SELECT p."ST_CASE",
       COUNT(CASE WHEN p."injury_severity" = 4 THEN 1 END) AS "severe_injuries",
       COUNT(DISTINCT p."person_number")                  AS "distinct_persons"
FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015" p
JOIN (
      SELECT "ST_CASE"
      FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
      WHERE "month_of_crash" BETWEEN 1 AND 8
      GROUP BY "ST_CASE"
      HAVING COUNT(DISTINCT "person_number") > 1
     ) m
  ON p."ST_CASE" = m."ST_CASE"
GROUP BY p."ST_CASE"
LIMIT 20;
```

```sql
--Description: Count crashes (Jan-Aug) that have >1 person with injury_severity = 4
SELECT COUNT(*) AS "crashes_with_multiple_severe"
FROM (
      SELECT p."ST_CASE"
      FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015" p
      WHERE p."month_of_crash" BETWEEN 1 AND 8
      GROUP BY p."ST_CASE"
      HAVING COUNT(DISTINCT p."person_number") > 1
         AND COUNT(CASE WHEN p."injury_severity" = 4 THEN 1 END) > 1
     )
LIMIT 20;
```

```sql
--Description: Compute the percentage of multi-person Jan-Aug crashes that had >1 severe injury
WITH multi AS (
      SELECT "ST_CASE"
      FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
      WHERE "month_of_crash" BETWEEN 1 AND 8
      GROUP BY "ST_CASE"
      HAVING COUNT(DISTINCT "person_number") > 1
),
severe AS (
      SELECT "ST_CASE"
      FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
      WHERE "month_of_crash" BETWEEN 1 AND 8
      GROUP BY "ST_CASE"
      HAVING COUNT(CASE WHEN "injury_severity" = 4 THEN 1 END) > 1
)
SELECT 100.0 * COUNT(DISTINCT severe."ST_CASE") / COUNT(DISTINCT multi."ST_CASE") AS "pct_with_multiple_severe"
FROM multi
LEFT JOIN severe ON multi."ST_CASE" = severe."ST_CASE"
LIMIT 20;
```

```sql
--Description: One-shot summary showing both numerator & denominator for clarity
WITH jan_aug AS (
      SELECT "ST_CASE",
             "injury_severity",
             "person_number"
      FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
      WHERE "month_of_crash" BETWEEN 1 AND 8
),
crash_rollup AS (
      SELECT "ST_CASE",
             COUNT(DISTINCT "person_number")                                  AS "n_persons",
             COUNT(CASE WHEN "injury_severity" = 4 THEN 1 END)               AS "n_severe"
      FROM jan_aug
      GROUP BY "ST_CASE"
)
SELECT COUNT_IF("n_persons" > 1)                                        AS "multi_person_crashes",
       COUNT_IF("n_persons" > 1 AND "n_severe" > 1)                     AS "multi_person_crashes_with_multi_severe",
       100.0 * COUNT_IF("n_persons" > 1 AND "n_severe" > 1)
/ NULLIF(COUNT_IF("n_persons" > 1),0)                                   AS "percentage_with_multi_severe"
FROM crash_rollup
LIMIT 20;
```
