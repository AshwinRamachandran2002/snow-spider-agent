```sql
--Description:  To find the required percentage in ONE step, the query
--  1) restricts PERSON_2015 to January-August rows;
--  2) rolls each crash up by its composite key ("state_number","consecutive_number"),
--     counting distinct persons (n_persons) and the number with injury_severity = 4 (n_severe);
--  3) aggregates those roll-ups, producing:
--        • denom = crashes that involved >1 distinct person (the universe we care about);
--        • numer = of those, crashes that had >1 person with injury_severity = 4;
--  4) returns the percentage as 100 * numer / denom.
WITH crash_rollup AS (
    SELECT
        "state_number",
        "consecutive_number",
        COUNT(DISTINCT "person_number")                                    AS n_persons,
        COUNT(CASE WHEN "injury_severity" = 4 THEN 1 END)                 AS n_severe
    FROM "NHTSA_TRAFFIC_FATALITIES"."NHTSA_TRAFFIC_FATALITIES"."PERSON_2015"
    WHERE "month_of_crash" BETWEEN 1 AND 8
    GROUP BY "state_number", "consecutive_number"
)
SELECT
    COUNT_IF(n_persons > 1 AND n_severe > 1)::FLOAT   AS numerator_crashes,
    COUNT_IF(n_persons > 1)::FLOAT                    AS denominator_crashes,
    100.0 * COUNT_IF(n_persons > 1 AND n_severe > 1)
/ NULLIF(COUNT_IF(n_persons > 1),0)                  AS pct_multi_severe
FROM crash_rollup;
```
