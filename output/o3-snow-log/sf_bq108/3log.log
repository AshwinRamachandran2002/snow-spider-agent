```sql
--Description: 4) Confirm the crash identifier (ST_CASE) exists and review some sample IDs
SELECT DISTINCT "ST_CASE"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
LIMIT 20;
```

```sql
--Description: 5) Count how many distinct people were involved in each crash Jan–Aug 2015
SELECT 
  "ST_CASE",
  COUNT(DISTINCT "person_number") AS "persons_in_crash"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
WHERE "month_of_crash" BETWEEN 1 AND 8
GROUP BY "ST_CASE"
LIMIT 20;
```

```sql
--Description: 6) Retain only crashes Jan–Aug that involved more than one person
SELECT 
  "ST_CASE",
  COUNT(DISTINCT "person_number") AS "persons_in_crash"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
WHERE "month_of_crash" BETWEEN 1 AND 8
GROUP BY "ST_CASE"
HAVING COUNT(DISTINCT "person_number") > 1
LIMIT 20;
```

```sql
--Description: 7) For Jan–Aug crashes, count the number of persons with severe injury (severity = 4)
SELECT 
  "ST_CASE",
  SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "severe_inj_cnt"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
WHERE "month_of_crash" BETWEEN 1 AND 8
GROUP BY "ST_CASE"
LIMIT 20;
```

```sql
--Description: 8) Find crashes Jan–Aug that have more than one person AND more than one person severely injured
SELECT 
  s."ST_CASE",
  s."persons_in_crash",
  i."severe_inj_cnt"
FROM (
    SELECT "ST_CASE", COUNT(DISTINCT "person_number") AS "persons_in_crash"
    FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE "month_of_crash" BETWEEN 1 AND 8
    GROUP BY "ST_CASE"
    HAVING COUNT(DISTINCT "person_number") > 1
) s
JOIN (
    SELECT "ST_CASE", SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) AS "severe_inj_cnt"
    FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE "month_of_crash" BETWEEN 1 AND 8
    GROUP BY "ST_CASE"
) i
ON s."ST_CASE" = i."ST_CASE"
WHERE i."severe_inj_cnt" > 1
LIMIT 20;
```

```sql
--Description: 9) Prepare counts of (a) all multi-person crashes Jan–Aug and (b) those with >1 severe injuries
WITH multi_person_crashes AS (
    SELECT "ST_CASE"
    FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE "month_of_crash" BETWEEN 1 AND 8
    GROUP BY "ST_CASE"
    HAVING COUNT(DISTINCT "person_number") > 1
),
multi_person_multi_severe AS (
    SELECT "ST_CASE"
    FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE "month_of_crash" BETWEEN 1 AND 8
    GROUP BY "ST_CASE"
    HAVING COUNT(DISTINCT "person_number") > 1
       AND SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) > 1
)
SELECT 
  (SELECT COUNT(*) FROM multi_person_crashes)  AS "total_multi_person_crashes",
  (SELECT COUNT(*) FROM multi_person_multi_severe) AS "multi_person_with_multi_severe"
FROM dual
LIMIT 20;
```

```sql
--Description: 10) Compute the percentage of Jan–Aug 2015 multi-person crashes that had more than one severely-injured individual
WITH multi_person_crashes AS (
    SELECT "ST_CASE"
    FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE "month_of_crash" BETWEEN 1 AND 8
    GROUP BY "ST_CASE"
    HAVING COUNT(DISTINCT "person_number") > 1
),
multi_person_multi_severe AS (
    SELECT "ST_CASE"
    FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE "month_of_crash" BETWEEN 1 AND 8
    GROUP BY "ST_CASE"
    HAVING COUNT(DISTINCT "person_number") > 1
       AND SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) > 1
)
SELECT 
  (COUNT(DISTINCT mps."ST_CASE") * 100.0 / NULLIF(COUNT(DISTINCT mpc."ST_CASE"),0)) AS "pct_multi_severe"
FROM multi_person_crashes mpc
LEFT JOIN multi_person_multi_severe mps
     ON mps."ST_CASE" = mpc."ST_CASE"
LIMIT 20;
```
