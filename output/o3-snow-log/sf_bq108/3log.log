```sql
--Description: 9) Count (a) all Jan–Aug 2015 multi-person crashes and (b) those where >1 person had severe injuries
WITH per_crash AS (
    SELECT 
        "state_number",
        "consecutive_number",
        COUNT(DISTINCT "person_number")                                AS "persons_in_crash",
        SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END)        AS "severe_inj_cnt"
    FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE "month_of_crash" BETWEEN 1 AND 8
    GROUP BY "state_number", "consecutive_number"
),
multi_person_crashes AS (
    SELECT * FROM per_crash
    WHERE "persons_in_crash" > 1
),
multi_person_multi_severe AS (
    SELECT * FROM per_crash
    WHERE "persons_in_crash" > 1
      AND "severe_inj_cnt"  > 1
)
SELECT 
  (SELECT COUNT(*) FROM multi_person_crashes)        AS "total_multi_person_crashes",
  (SELECT COUNT(*) FROM multi_person_multi_severe)   AS "multi_person_with_multi_severe"
LIMIT 20;
```

```sql
--Description: 10) Compute the percentage of Jan–Aug 2015 multi-person crashes that had >1 severely-injured individual
WITH per_crash AS (
    SELECT 
        "state_number",
        "consecutive_number",
        COUNT(DISTINCT "person_number")                                AS "persons_in_crash",
        SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END)        AS "severe_inj_cnt"
    FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE "month_of_crash" BETWEEN 1 AND 8
    GROUP BY "state_number", "consecutive_number"
),
multi_person_crashes AS (
    SELECT * FROM per_crash
    WHERE "persons_in_crash" > 1
),
multi_person_multi_severe AS (
    SELECT * FROM per_crash
    WHERE "persons_in_crash" > 1
      AND "severe_inj_cnt"  > 1
)
SELECT 
  (COUNT(DISTINCT mps."state_number" || '-' || mps."consecutive_number") * 100.0 / 
   NULLIF(COUNT(DISTINCT mpc."state_number" || '-' || mpc."consecutive_number"),0)
  ) AS "pct_multi_severe"
FROM multi_person_crashes        mpc
LEFT JOIN multi_person_multi_severe mps
       ON mps."state_number" = mpc."state_number"
      AND mps."consecutive_number" = mpc."consecutive_number"
LIMIT 20;
```
