```sql
--Description: Count how many persons in each crash (Jan–Aug) have severe injuries (severity = 4)
SELECT 
  "ST_CASE",
  COUNT(*) AS "severe_cnt"
FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
WHERE "MONTH_OF_CRASH" BETWEEN 1 AND 8
  AND "INJURY_SEVERITY" = 4
GROUP BY "ST_CASE"
ORDER BY "severe_cnt" DESC
LIMIT 20;
```

```sql
--Description: Isolate crashes (Jan–Aug) that (a) have >1 person and (b) have >1 severely-injured person
WITH persons_per_crash AS (
  SELECT "ST_CASE", COUNT(*) AS "person_cnt"
  FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
  WHERE "MONTH_OF_CRASH" BETWEEN 1 AND 8
  GROUP BY "ST_CASE"
), severe_per_crash AS (
  SELECT "ST_CASE", COUNT(*) AS "severe_cnt"
  FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
  WHERE "MONTH_OF_CRASH" BETWEEN 1 AND 8
    AND "INJURY_SEVERITY" = 4
  GROUP BY "ST_CASE"
)
SELECT 
  s."ST_CASE",
  p."person_cnt",
  s."severe_cnt"
FROM severe_per_crash s
JOIN persons_per_crash p
  ON p."ST_CASE" = s."ST_CASE"
WHERE p."person_cnt" > 1
  AND s."severe_cnt" > 1
LIMIT 20;
```

```sql
--Description: Retrieve the total number of qualifying crashes (Jan–Aug, >1 person)
WITH persons_per_crash AS (
  SELECT "ST_CASE", COUNT(*) AS "person_cnt"
  FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
  WHERE "MONTH_OF_CRASH" BETWEEN 1 AND 8
  GROUP BY "ST_CASE"
)
SELECT 
  COUNT(*) AS "total_multi_person_crashes"
FROM persons_per_crash
WHERE "person_cnt" > 1
LIMIT 20;
```

```sql
--Description: Retrieve the number of those crashes that also include >1 severe-injury person
WITH persons_per_crash AS (
  SELECT "ST_CASE", COUNT(*) AS "person_cnt"
  FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
  WHERE "MONTH_OF_CRASH" BETWEEN 1 AND 8
  GROUP BY "ST_CASE"
), severe_per_crash AS (
  SELECT "ST_CASE", COUNT(*) AS "severe_cnt"
  FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
  WHERE "MONTH_OF_CRASH" BETWEEN 1 AND 8
    AND "INJURY_SEVERITY" = 4
  GROUP BY "ST_CASE"
)
SELECT 
  COUNT(*) AS "multi_person_and_multi_severe_crashes"
FROM severe_per_crash s
JOIN persons_per_crash p
  ON p."ST_CASE" = s."ST_CASE"
WHERE p."person_cnt" > 1
  AND s."severe_cnt" > 1
LIMIT 20;
```

```sql
--Description: Compute the percentage of multi-person Jan–Aug crashes that have >1 severely-injured person
WITH persons_per_crash AS (
  SELECT "ST_CASE", COUNT(*) AS "person_cnt"
  FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
  WHERE "MONTH_OF_CRASH" BETWEEN 1 AND 8
  GROUP BY "ST_CASE"
), severe_per_crash AS (
  SELECT "ST_CASE", COUNT(*) AS "severe_cnt"
  FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
  WHERE "MONTH_OF_CRASH" BETWEEN 1 AND 8
    AND "INJURY_SEVERITY" = 4
  GROUP BY "ST_CASE"
), crash_sets AS (
  SELECT 
    p."ST_CASE",
    p."person_cnt",
    COALESCE(s."severe_cnt", 0) AS "severe_cnt"
  FROM persons_per_crash p
  LEFT JOIN severe_per_crash s
    ON s."ST_CASE" = p."ST_CASE"
  WHERE p."person_cnt" > 1
)
SELECT 
  COUNT_IF("severe_cnt" > 1)                   AS "num_with_multi_severe",
  COUNT(*)                                      AS "total_multi_person",
  ROUND(100.0 * COUNT_IF("severe_cnt" > 1) / NULLIF(COUNT(*), 0), 2) AS "pct_with_multi_severe"
FROM crash_sets
LIMIT 20;
```

