--Description: Compute the percentage of multi-person months (Jan – Aug) that also have >1 severely-injured person
WITH persons_per_month AS (
  SELECT "month_of_crash", COUNT(*) AS "person_cnt"
  FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
  WHERE "month_of_crash" BETWEEN 1 AND 8
  GROUP BY "month_of_crash"
), severe_per_month AS (
  SELECT "month_of_crash", COUNT(*) AS "severe_cnt"
  FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
  WHERE "month_of_crash" BETWEEN 1 AND 8
    AND "injury_severity" = 4
  GROUP BY "month_of_crash"
), month_sets AS (
  SELECT 
    p."month_of_crash",
    p."person_cnt",
    COALESCE(s."severe_cnt", 0) AS "severe_cnt"
  FROM persons_per_month p
  LEFT JOIN severe_per_month s
    ON s."month_of_crash" = p."month_of_crash"
  WHERE p."person_cnt" > 1
)
SELECT 
  COUNT_IF("severe_cnt" > 1) AS "num_with_multi_severe",
  COUNT(*)                  AS "total_multi_person",
  ROUND(100.0 * COUNT_IF("severe_cnt" > 1) / NULLIF(COUNT(*),0), 2) AS "pct_with_multi_severe"
FROM month_sets
LIMIT 20
