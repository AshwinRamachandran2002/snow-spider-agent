```sql
--Description:  Determine the percentage of crashes (identified by the unique
--combination of "state_number" and "consecutive_number") that happened in
--January–August 2015, involved more than one distinct person, and had more
--than one person with severe injuries (injury_severity = 4).  
--Step-1 (CTE crashes):   find all Jan-Aug crashes with >1 person.  
--Step-2 (CTE severe_crashes): from those, keep only crashes where the count of
--                             persons with injury_severity = 4 exceeds 1.  
--Final SELECT:  count such severe crashes and divide by total qualifying
--               crashes to get the desired percentage.
WITH crashes AS (
    SELECT "state_number",
           "consecutive_number"
    FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE  "month_of_crash" BETWEEN 1 AND 8
    GROUP  BY "state_number", "consecutive_number"
    HAVING COUNT(DISTINCT "person_number") > 1
), 
severe_crashes AS (
    SELECT "state_number",
           "consecutive_number"
    FROM   NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
    WHERE  "month_of_crash" BETWEEN 1 AND 8
    GROUP  BY "state_number", "consecutive_number"
    HAVING COUNT(DISTINCT "person_number") > 1
       AND SUM(CASE WHEN "injury_severity" = 4 THEN 1 ELSE 0 END) > 1
)
SELECT COUNT(*)                                                   AS "crashes_gt1_severe",
       (COUNT(*) * 100.0) / NULLIF((SELECT COUNT(*) FROM crashes), 0)
                                                                  AS "percent_with_gt1_severe"
FROM   severe_crashes;
```
