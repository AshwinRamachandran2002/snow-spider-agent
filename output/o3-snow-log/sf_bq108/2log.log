```sql
-- Description: Count of Jan-Aug crashes with >1 person in them (needed for percentage)
WITH multi_person AS (
    SELECT "ST_CASE"
    FROM (
        SELECT "ST_CASE",
               COUNT(DISTINCT "PERSON_NUMBER") AS "DISTINCT_PERSONS"
        FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
        WHERE "MONTH_OF_CRASH" BETWEEN 1 AND 8
        GROUP BY "ST_CASE"
    )
    WHERE "DISTINCT_PERSONS" > 1
)
SELECT COUNT(*) AS "CRASHES_WITH_GT1_PERSON"
FROM multi_person
LIMIT 20;
```

```sql
-- Description: Count of Jan-Aug crashes that (1) have >1 person and (2) have >1 severe injuries
WITH multi_person AS (
    SELECT "ST_CASE"
    FROM (
        SELECT "ST_CASE",
               COUNT(DISTINCT "PERSON_NUMBER") AS "DISTINCT_PERSONS"
        FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
        WHERE "MONTH_OF_CRASH" BETWEEN 1 AND 8
        GROUP BY "ST_CASE"
    )
    WHERE "DISTINCT_PERSONS" > 1
),
multi_severe AS (
    SELECT "ST_CASE"
    FROM (
        SELECT "ST_CASE",
               COUNT(CASE WHEN "INJURY_SEVERITY" = 4 THEN 1 END) AS "SEVERE_COUNT"
        FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
        WHERE "MONTH_OF_CRASH" BETWEEN 1 AND 8
        GROUP BY "ST_CASE"
    )
    WHERE "SEVERE_COUNT" > 1
)
SELECT COUNT(*) AS "CRASHES_WITH_GT1_PERSON_AND_GT1_SEVERE"
FROM multi_person
JOIN multi_severe USING ("ST_CASE")
LIMIT 20;
```

```sql
-- Description: Final percentage of Jan-Aug 2015 crashes that have >1 person AND >1 severe injury (injury_severity = 4)
WITH multi_person AS (
    SELECT "ST_CASE"
    FROM (
        SELECT "ST_CASE",
               COUNT(DISTINCT "PERSON_NUMBER") AS "DISTINCT_PERSONS"
        FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
        WHERE "MONTH_OF_CRASH" BETWEEN 1 AND 8
        GROUP BY "ST_CASE"
    )
    WHERE "DISTINCT_PERSONS" > 1
),
multi_severe AS (
    SELECT "ST_CASE"
    FROM (
        SELECT "ST_CASE",
               COUNT(CASE WHEN "INJURY_SEVERITY" = 4 THEN 1 END) AS "SEVERE_COUNT"
        FROM NHTSA_TRAFFIC_FATALITIES.NHTSA_TRAFFIC_FATALITIES.PERSON_2015
        WHERE "MONTH_OF_CRASH" BETWEEN 1 AND 8
        GROUP BY "ST_CASE"
    )
    WHERE "SEVERE_COUNT" > 1
),
num AS (
    SELECT COUNT(*) AS "NUMERATOR"
    FROM multi_person
    JOIN multi_severe USING ("ST_CASE")
),
den AS (
    SELECT COUNT(*) AS "DENOMINATOR"
    FROM multi_person
)
SELECT 
  num."NUMERATOR",
  den."DENOMINATOR",
  CASE WHEN den."DENOMINATOR" = 0 THEN NULL
       ELSE ROUND(100.0 * num."NUMERATOR" / den."DENOMINATOR", 2)
  END AS "PERCENT_WITH_MULTIPLE_SEVERE_INJURIES"
FROM num, den
LIMIT 20;
```
