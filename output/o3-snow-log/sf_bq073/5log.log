Query:
--Description: Complete query – state list ordered by total vulnerable workers,
--             showing wholesale, manufacturing, and combined vulnerable counts.
SELECT
    g."state_name",
    SUM(z17."employed_wholesale_trade" * 0.38) AS "vulnerable_wholesale_trade",
    SUM(z17."employed_manufacturing"  * 0.41)  AS "vulnerable_manufacturing",
    SUM(
        (z17."employed_wholesale_trade" * 0.38) +
        (z17."employed_manufacturing"  * 0.41)
    ) AS "total_vulnerable_workers"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" g
  ON z17."geo_id" = g."zip_code"
GROUP BY g."state_name"
ORDER BY "total_vulnerable_workers" DESC
LIMIT 20;
