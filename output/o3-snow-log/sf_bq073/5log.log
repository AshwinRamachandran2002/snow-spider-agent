--Description: Example join of one ZIP-level record (income change + vulnerable counts)
--             to the ZIP-state lookup, just to verify the join keys line up.
SELECT 
    vz."geo_id"        AS "zip_code",
    g."state_name",
    vz."vul_wholesale",
    vz."vul_manufacturing",
    vz."total_vulnerable"
FROM (
      SELECT 
          z17."geo_id",
          (z17."employed_wholesale_trade" * 0.38) AS "vul_wholesale",
          (z17."employed_manufacturing"  * 0.41) AS "vul_manufacturing",
          (z17."employed_wholesale_trade" * 0.38) +
          (z17."employed_manufacturing"  * 0.41) AS "total_vulnerable"
      FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
      LIMIT 1
) vz
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" g
  ON vz."geo_id" = g."zip_code";
