--Description: Compute the 2015-to-2018 median-income change for a small sample
--             of ZIP codes (positive, negative, or zero) as a sense-check.
SELECT 
    z15."geo_id",
    z15."median_income"  AS "income_2015",
    z18."median_income"  AS "income_2018",
    (z18."median_income" - z15."median_income") AS "income_change"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"  z15
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"  z18
  ON z15."geo_id" = z18."geo_id"
LIMIT 20;
