Query:
--Description: Aggregate the vulnerable counts from all ZIP codes to the state level.
--             This is the core roll-up (ignoring income change for the moment).
SELECT
    g."state_name",
    SUM(z17."employed_wholesale_trade" * 0.38) AS "vul_wholesale",
    SUM(z17."employed_manufacturing"  * 0.41)  AS "vul_manufacturing",
    SUM(
        (z17."employed_wholesale_trade" * 0.38) +
        (z17."employed_manufacturing"  * 0.41)
    ) AS "total_vulnerable"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" g
  ON z17."geo_id" = g."zip_code"
GROUP BY g."state_name"
LIMIT 20;
