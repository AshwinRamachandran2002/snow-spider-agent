Query:
--Description: Same as the previous query but WITH median-income change applied as a
--             filter example (only ZIPs whose median household income declined
--             between 2015 and 2018).  Remove WHERE clause if not needed.
SELECT
    g."state_name",
    SUM(z17."employed_wholesale_trade" * 0.38) AS "vulnerable_wholesale_trade",
    SUM(z17."employed_manufacturing"  * 0.41)  AS "vulnerable_manufacturing",
    SUM(
        (z17."employed_wholesale_trade" * 0.38) +
        (z17."employed_manufacturing"  * 0.41)
    ) AS "total_vulnerable_workers"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
JOIN (
      SELECT 
          z15."geo_id",
          (z18."median_income" - z15."median_income") AS "income_change"
      FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
      JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
        ON z15."geo_id" = z18."geo_id"
) inc ON z17."geo_id" = inc."geo_id"
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" g
  ON z17."geo_id" = g."zip_code"
WHERE inc."income_change" < 0     -- only ZIPs with declining median income
GROUP BY g."state_name"
ORDER BY "total_vulnerable_workers" DESC
LIMIT 20;
