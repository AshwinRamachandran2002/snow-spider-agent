```sql
--Description: Peek at 20 ZIP codes from the 2015 ACS file to confirm the ZIP code id
--             and that median household income is available for 2015.
SELECT 
    "geo_id", 
    "median_income"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"
LIMIT 20;
```

```sql
--Description: Peek at 20 ZIP codes from the 2018 ACS file to confirm the 2018
--             median household income figures we will subtract from 2015 values.
SELECT 
    "geo_id", 
    "median_income"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
LIMIT 20;
```

```sql
--Description: Inspect the 2017 ZIP‐level employment data (wholesale & manufacturing)
--             that will be used to derive “vulnerable” workers.
SELECT 
    "geo_id",
    "employed_wholesale_trade",
    "employed_manufacturing"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"
LIMIT 20;
```

```sql
--Description: Compute the 2015-to-2018 median-income change for a small sample
--             of ZIP codes (positive, negative, or zero) as a sense-check.
SELECT 
    z15."geo_id",
    z15."median_income"  AS "income_2015",
    z18."median_income"  AS "income_2018",
    (z18."median_income" - z15."median_income") AS "income_change"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"  z15
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"  z18
  ON z15."geo_id" = z18."geo_id"
LIMIT 20;
```

```sql
--Description: Bring together income-change and 2017 employment to calculate the
--             ZIP-level counts of *vulnerable* workers  
--             (41% of manufacturing + 38% of wholesale trade) for a quick look.
SELECT 
    z17."geo_id",
    (z17."employed_wholesale_trade" * 0.38)  AS "vul_wholesale",
    (z17."employed_manufacturing"  * 0.41)   AS "vul_manufacturing",
    (z17."employed_wholesale_trade" * 0.38) +
    (z17."employed_manufacturing"  * 0.41)   AS "total_vulnerable"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
LIMIT 20;
```

```sql
--Description: Look at the geographic file that maps each ZIP code to its state
--             (state_code & state_name).  This will let us sum ZIP figures to the
--             state level.
SELECT 
    "zip_code",
    "state_code",
    "state_name"
FROM CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"
LIMIT 20;
```

```sql
--Description: Example join of one ZIP-level record (income change + vulnerable counts)
--             to the ZIP-state lookup, just to verify the join keys line up.
SELECT 
    vz."geo_id"        AS "zip_code",
    g."state_name",
    vz."vul_wholesale",
    vz."vul_manufacturing",
    vz."total_vulnerable"
FROM (
      SELECT 
          z17."geo_id",
          (z17."employed_wholesale_trade" * 0.38) AS "vul_wholesale",
          (z17."employed_manufacturing"  * 0.41) AS "vul_manufacturing",
          (z17."employed_wholesale_trade" * 0.38) +
          (z17."employed_manufacturing"  * 0.41) AS "total_vulnerable"
      FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
      LIMIT 1
) vz
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" g
  ON vz."geo_id" = g."zip_code";
```

```sql
--Description: Aggregate the vulnerable counts from all ZIP codes to the state level.
--             This is the core roll-up (ignoring income change for the moment).
SELECT
    g."state_name",
    SUM(z17."employed_wholesale_trade" * 0.38) AS "vul_wholesale",
    SUM(z17."employed_manufacturing"  * 0.41)  AS "vul_manufacturing",
    SUM(
        (z17."employed_wholesale_trade" * 0.38) +
        (z17."employed_manufacturing"  * 0.41)
    ) AS "total_vulnerable"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" g
  ON z17."geo_id" = g."zip_code"
GROUP BY g."state_name"
LIMIT 20;
```

```sql
--Description: Complete query – state list ordered by total vulnerable workers,
--             showing wholesale, manufacturing, and combined vulnerable counts.
SELECT
    g."state_name",
    SUM(z17."employed_wholesale_trade" * 0.38) AS "vulnerable_wholesale_trade",
    SUM(z17."employed_manufacturing"  * 0.41)  AS "vulnerable_manufacturing",
    SUM(
        (z17."employed_wholesale_trade" * 0.38) +
        (z17."employed_manufacturing"  * 0.41)
    ) AS "total_vulnerable_workers"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" g
  ON z17."geo_id" = g."zip_code"
GROUP BY g."state_name"
ORDER BY "total_vulnerable_workers" DESC
LIMIT 20;
```

```sql
--Description: Same as the previous query but WITH median-income change applied as a
--             filter example (only ZIPs whose median household income declined
--             between 2015 and 2018).  Remove WHERE clause if not needed.
SELECT
    g."state_name",
    SUM(z17."employed_wholesale_trade" * 0.38) AS "vulnerable_wholesale_trade",
    SUM(z17."employed_manufacturing"  * 0.41)  AS "vulnerable_manufacturing",
    SUM(
        (z17."employed_wholesale_trade" * 0.38) +
        (z17."employed_manufacturing"  * 0.41)
    ) AS "total_vulnerable_workers"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
JOIN (
      SELECT 
          z15."geo_id",
          (z18."median_income" - z15."median_income") AS "income_change"
      FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
      JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
        ON z15."geo_id" = z18."geo_id"
) inc ON z17."geo_id" = inc."geo_id"
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" g
  ON z17."geo_id" = g."zip_code"
WHERE inc."income_change" < 0     -- only ZIPs with declining median income
GROUP BY g."state_name"
ORDER BY "total_vulnerable_workers" DESC
LIMIT 20;
```
