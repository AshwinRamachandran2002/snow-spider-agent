```

```sql
--Description: 5)  Join 2017 ZIP employment data to the ZIP-to-State lookup
--              to make sure the keys line up and the state names come through.
SELECT 
    z17."geo_id"       AS "zip",
    s."state_name",
    z17."employed_wholesale_trade",
    z17."employed_manufacturing"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"  z17
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"           s
      ON z17."geo_id" = s."zip_code"
LIMIT 20;
```

```sql
--Description: 6)  Aggregate 2017 “vulnerable” workers (38 % of wholesale-trade
--              workers and 41 % of manufacturing workers) by state.
SELECT
    s."state_name",
    SUM(0.38 * z17."employed_wholesale_trade")    AS "vul_wholesale",
    SUM(0.41 * z17."employed_manufacturing")      AS "vul_manufacturing",
    SUM(0.38 * z17."employed_wholesale_trade") +
    SUM(0.41 * z17."employed_manufacturing")      AS "total_vulnerable"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"  z17
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"           s
      ON z17."geo_id" = s."zip_code"
GROUP BY s."state_name"
LIMIT 20;
```

```sql
--Description: 7)  Compute the 2015-to-2018 median-income change for each ZIP
--              code (showing a small sample).
SELECT 
    z15."geo_id"                                        AS "zip",
    z15."median_income"                                 AS "median_2015",
    z18."median_income"                                 AS "median_2018",
    (z18."median_income" - z15."median_income")         AS "income_diff"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
      ON z15."geo_id" = z18."geo_id"
LIMIT 20;
```

```sql
--Description: 8)  Summarize the average 2015-to-2018 income change by state 
--              (helps us see how income trends differ across states).
WITH diff AS (
    SELECT 
        z15."geo_id"                    AS "zip",
        (z18."median_income" - z15."median_income") AS "income_diff"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
    JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
          ON z15."geo_id" = z18."geo_id"
)
SELECT
    s."state_name",
    AVG(d."income_diff")               AS "avg_income_diff"
FROM diff d
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" s
      ON d."zip" = s."zip_code"
GROUP BY s."state_name"
LIMIT 20;
```

```sql
--Description: 9)  Combine the vulnerable-worker tallies with the average
--              income difference for each state so we can examine both
--              economic exposure and recent income trends.
WITH vuln AS (
    SELECT
        s."state_name",
        SUM(0.38 * z17."employed_wholesale_trade") AS "vul_wholesale",
        SUM(0.41 * z17."employed_manufacturing")   AS "vul_manufacturing"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"          s
          ON z17."geo_id" = s."zip_code"
    GROUP BY s."state_name"
),
income AS (
    SELECT
        s."state_name",
        AVG(z18."median_income" - z15."median_income") AS "avg_income_diff"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
    JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
          ON z15."geo_id" = z18."geo_id"
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"          s
          ON z15."geo_id" = s."zip_code"
    GROUP BY s."state_name"
)
SELECT
    v."state_name",
    v."vul_wholesale",
    v."vul_manufacturing",
    (v."vul_wholesale" + v."vul_manufacturing")      AS "total_vulnerable",
    i."avg_income_diff"
FROM vuln  v
LEFT JOIN income i
       ON v."state_name" = i."state_name"
LIMIT 20;
```

```sql
--Description: 10)  Produce the final state-by-state list ordered by total 
--               vulnerable workers (descending), ready for reporting.
SELECT
    v."state_name",
    v."vul_wholesale",
    v."vul_manufacturing",
    (v."vul_wholesale" + v."vul_manufacturing")  AS "total_vulnerable"
FROM (
    SELECT
        s."state_name",
        SUM(0.38 * z17."employed_wholesale_trade") AS "vul_wholesale",
        SUM(0.41 * z17."employed_manufacturing")   AS "vul_manufacturing"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"          s
          ON z17."geo_id" = s."zip_code"
    GROUP BY s."state_name"
) v
ORDER BY "total_vulnerable" DESC
LIMIT 20;
```
