```sql
--Description: For a small sample, join 2015 and 2018 to see the median-income change per ZIP
SELECT z15."geo_id"             AS "zip",
       z15."median_income"      AS "inc_2015",
       z18."median_income"      AS "inc_2018",
       (z18."median_income" - z15."median_income") AS "inc_diff"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR" z15
JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR" z18
  ON z15."geo_id" = z18."geo_id"
LIMIT 20;
```

```sql
--Description: Add 2017 employment figures to the previous join; calculate vulnerable workers for one ZIP sample
SELECT z15."geo_id"                                         AS "zip",
       z18."median_income" - z15."median_income"            AS "inc_diff",
       z17."employed_wholesale_trade",
       z17."employed_manufacturing",
       ROUND(0.38 * z17."employed_wholesale_trade", 2)      AS "vul_wholesale",
       ROUND(0.41 * z17."employed_manufacturing", 2)        AS "vul_manufacturing"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR" z15
JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR" z18
  ON z15."geo_id" = z18."geo_id"
JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" z17
  ON z15."geo_id" = z17."geo_id"
LIMIT 20;
```

```sql
--Description: Attach state names to the ZIP-level vulnerable-worker calculations (sample output)
SELECT s."state_name",
       v.*
FROM (
    SELECT z15."geo_id" AS "zip",
           ROUND(0.38 * z17."employed_wholesale_trade", 2) AS "vul_wholesale",
           ROUND(0.41 * z17."employed_manufacturing", 2)   AS "vul_manufacturing"
    FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR" z15
    JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR" z18
      ON z15."geo_id" = z18."geo_id"
    JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" z17
      ON z15."geo_id" = z17."geo_id"
) v
JOIN "CENSUS_BUREAU_ACS_2"."GEO_US_BOUNDARIES"."ZIP_CODES" s
  ON v."zip" = s."zip_code"
LIMIT 20;
```

```sql
--Description: Aggregate vulnerable-worker counts by state (top 20 states shown)
SELECT s."state_name",
       SUM(ROUND(0.38 * z17."employed_wholesale_trade", 2))      AS "vulnerable_wholesale",
       SUM(ROUND(0.41 * z17."employed_manufacturing", 2))        AS "vulnerable_manufacturing",
       SUM(ROUND(0.38 * z17."employed_wholesale_trade", 2))
       + SUM(ROUND(0.41 * z17."employed_manufacturing", 2))      AS "total_vulnerable"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR" z15
JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR" z18
  ON z15."geo_id" = z18."geo_id"
JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" z17
  ON z15."geo_id" = z17."geo_id"
JOIN "CENSUS_BUREAU_ACS_2"."GEO_US_BOUNDARIES"."ZIP_CODES" s
  ON z15."geo_id" = s."zip_code"
GROUP BY s."state_name"
ORDER BY "total_vulnerable" DESC
LIMIT 20;
```

```sql
--Description: Produce the full, final list of states in descending order of total vulnerable workers
SELECT s."state_name"                                            AS "state",
       SUM(ROUND(0.38 * z17."employed_wholesale_trade", 2))      AS "vulnerable_wholesale_trade_workers",
       SUM(ROUND(0.41 * z17."employed_manufacturing", 2))        AS "vulnerable_manufacturing_workers",
       SUM(ROUND(0.38 * z17."employed_wholesale_trade", 2))
       + SUM(ROUND(0.41 * z17."employed_manufacturing", 2))      AS "total_vulnerable_workers"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR" z15
JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR" z18
  ON z15."geo_id" = z18."geo_id"
JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" z17
  ON z15."geo_id" = z17."geo_id"
JOIN "CENSUS_BUREAU_ACS_2"."GEO_US_BOUNDARIES"."ZIP_CODES" s
  ON z15."geo_id" = s."zip_code"
GROUP BY s."state_name"
ORDER BY "total_vulnerable_workers" DESC;
```

```sql
--Description: Double-check the state names list for any “NULL” or unexpected values that might indicate missing matches
SELECT DISTINCT s."state_name"
FROM "CENSUS_BUREAU_ACS_2"."GEO_US_BOUNDARIES"."ZIP_CODES" s
LEFT JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" z17
       ON s."zip_code" = z17."geo_id"
WHERE z17."geo_id" IS NULL
LIMIT 20;
