--Description: Attach state names to the ZIP-level vulnerable-worker calculations (sample output)
SELECT s."state_name",
       v.*
FROM (
    SELECT z15."geo_id" AS "zip",
           ROUND(0.38 * z17."employed_wholesale_trade", 2) AS "vul_wholesale",
           ROUND(0.41 * z17."employed_manufacturing", 2)   AS "vul_manufacturing"
    FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR" z15
    JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR" z18
      ON z15."geo_id" = z18."geo_id"
    JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" z17
      ON z15."geo_id" = z17."geo_id"
) v
JOIN "CENSUS_BUREAU_ACS_2"."GEO_US_BOUNDARIES"."ZIP_CODES" s
  ON v."zip" = s."zip_code"
LIMIT 20;
