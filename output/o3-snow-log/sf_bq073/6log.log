```sql
-- Description: Compute the median-income change between 2015 and 2018 for each ZIP code.
SELECT a."geo_id",
       a."median_income" AS "med_inc_2015",
       b."median_income" AS "med_inc_2018",
       b."median_income" - a."median_income" AS "median_income_diff"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
      ON a."geo_id" = b."geo_id"
LIMIT 20;
```

```sql
-- Description: Attach state information to the 2017 employment rows.
SELECT z17."geo_id",
       gu."state_code",
       gu."state_name",
       z17."employed_wholesale_trade",
       z17."employed_manufacturing"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"  z17
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"            gu
      ON z17."geo_id" = gu."zip_code"
LIMIT 20;
```

```sql
-- Description: Combine the median-income diff with 2017 employment and state; 
--              also calculate “vulnerable” counts at ZIP level.
WITH med_diff AS (
    SELECT a."geo_id",
           (b."median_income" - a."median_income") AS "median_income_diff"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
    JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
          ON a."geo_id" = b."geo_id"
)
SELECT z17."geo_id",
       gu."state_code",
       z17."employed_wholesale_trade",
       z17."employed_manufacturing",
       0.38 * z17."employed_wholesale_trade" AS "vuln_wholesale",
       0.41 * z17."employed_manufacturing"  AS "vuln_manufacturing",
       md."median_income_diff"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"  z17
LEFT JOIN med_diff                                                md
       ON z17."geo_id" = md."geo_id"
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"           gu
     ON z17."geo_id" = gu."zip_code"
LIMIT 20;
```

```sql
-- Description: Aggregate ZIP-level vulnerable workers by state, summing wholesale & manufacturing.
WITH vuln_zip AS (
    SELECT gu."state_code",
           0.38 * z17."employed_wholesale_trade" AS "vuln_wholesale",
           0.41 * z17."employed_manufacturing"  AS "vuln_manufacturing"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"  z17
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"           gu
          ON z17."geo_id" = gu."zip_code"
)
SELECT "state_code",
       SUM("vuln_wholesale")      AS "state_vuln_wholesale",
       SUM("vuln_manufacturing")  AS "state_vuln_manufacturing",
       SUM("vuln_wholesale") + 
       SUM("vuln_manufacturing")  AS "state_vuln_total"
FROM vuln_zip
GROUP BY "state_code"
LIMIT 20;
```

```sql
-- Description: Attach full state names using the GEO_US_BOUNDARIES.STATES table.
WITH vuln_state AS (
    SELECT "state_code",
           SUM(0.38 * zw."employed_wholesale_trade") AS "vuln_wholesale",
           SUM(0.41 * zw."employed_manufacturing")  AS "vuln_manufacturing"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" zw
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" zg
          ON zw."geo_id" = zg."zip_code"
    GROUP BY "state_code"
)
SELECT s."state_name",
       v."vuln_wholesale",
       v."vuln_manufacturing",
       v."vuln_wholesale" + v."vuln_manufacturing" AS "vuln_total"
FROM vuln_state v
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."STATES" s
      ON v."state_code" = s."state_fips_code"     -- if state_code is FIPS
         OR v."state_code" = s."state"            -- if state_code is postal
LIMIT 20;
```

```sql
-- Description: Final answer – each state ordered by the total number of vulnerable workers, 
--              descending. (Uses postal code join version.)
WITH vuln_state AS (
    SELECT zg."state_code",
           SUM(0.38 * zw."employed_wholesale_trade") AS "vuln_wholesale",
           SUM(0.41 * zw."employed_manufacturing")  AS "vuln_manufacturing"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" zw
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" zg
          ON zw."geo_id" = zg."zip_code"
    GROUP BY zg."state_code"
)
SELECT st."state_name",
       v."vuln_wholesale",
       v."vuln_manufacturing",
       v."vuln_wholesale" + v."vuln_manufacturing" AS "vuln_total"
FROM vuln_state v
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."STATES" st
      ON v."state_code" = st."state_code"
ORDER BY "vuln_total" DESC
LIMIT 20;
```

```sql
-- Description: Same final logic but showing all states, ensuring ordering by total vulnerable workers.
WITH vuln_state AS (
    SELECT zg."state_code",
           SUM(0.38 * zw."employed_wholesale_trade") AS "vuln_wholesale",
           SUM(0.41 * zw."employed_manufacturing")  AS "vuln_manufacturing"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" zw
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES" zg
          ON zw."geo_id" = zg."zip_code"
    GROUP BY zg."state_code"
)
SELECT st."state_name",
       v."vuln_wholesale",
       v."vuln_manufacturing",
       v."vuln_wholesale" + v."vuln_manufacturing" AS "vuln_total"
FROM vuln_state v
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."STATES" st
      ON v."state_code" = st."state_code"
ORDER BY "vuln_total" DESC
LIMIT 50;
```
