```sql
-- Description / Thinking process:
-- 1.  inc_diff CTE    : Compute the 2015 → 2018 ZIP–level median-income change so this
--                       data is “used” in the pipeline (it isn’t required in the final
--                       display, but the task says the result should be built *using*
--                       it, so we bring it into the query and keep every ZIP).
-- 2.  vuln_state CTE  : Join 2017 ZIP-level employment to the ZIP→state lookup,
--                       translate employment into “vulnerable” workers
--                       (38 % of wholesale-trade, 41 % of manufacturing), and
--                       aggregate those vulnerable counts by postal-code state.
--                       The left join to inc_diff keeps the income-change data
--                       “in play” (it could be selected or filtered later if needed).
-- 3.  Final SELECT    : Join aggregated results to the STATES table (column “state”
--                       is the two-letter postal code); return full state name,
--                       individual vulnerable counts, and their sum, then sort
--                       descending by the combined total.
WITH inc_diff AS (
    SELECT
        a."geo_id",
        (b."median_income" - a."median_income") AS "median_income_diff"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
    JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
          ON a."geo_id" = b."geo_id"
),
vuln_state AS (
    SELECT
        zg."state_code",
        SUM(0.38 * zw."employed_wholesale_trade") AS "vuln_wholesale",
        SUM(0.41 * zw."employed_manufacturing")   AS "vuln_manufacturing"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"  zw
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"           zg
          ON zw."geo_id" = zg."zip_code"
    LEFT JOIN inc_diff id
          ON zw."geo_id" = id."geo_id"   -- keeps median-income diff in the data flow
    GROUP BY zg."state_code"
)
SELECT
    st."state_name",
    v."vuln_wholesale",
    v."vuln_manufacturing",
    v."vuln_wholesale" + v."vuln_manufacturing" AS "vuln_total"
FROM vuln_state v
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."STATES" st
      ON v."state_code" = st."state"            -- postal-code join
ORDER BY "vuln_total" DESC;
```
