Query:
-- Description: Same logic as before but returning **all** states (LIMIT 50); 
--              corrected join to GEO_US_BOUNDARIES.STATES via postal code (“state”), 
--              not the non-existent “state_code” column.
WITH vuln_state AS (
    SELECT 
        zg."state_code",
        SUM(0.38 * zw."employed_wholesale_trade") AS "vuln_wholesale",
        SUM(0.41 * zw."employed_manufacturing")   AS "vuln_manufacturing"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"  zw
    JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"           zg
          ON zw."geo_id" = zg."zip_code"
    GROUP BY zg."state_code"
)
SELECT 
    st."state_name",
    v."vuln_wholesale",
    v."vuln_manufacturing",
    v."vuln_wholesale" + v."vuln_manufacturing" AS "vuln_total"
FROM vuln_state v
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."STATES" st
      ON v."state_code" = st."state"      -- postal-code join
ORDER BY "vuln_total" DESC
LIMIT 50
