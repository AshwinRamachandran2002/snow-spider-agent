Query:
-- 6. Compute “vulnerable” employment at the ZIP level (38 % wholesale,
--    41 % manufacturing) for a small sample of ZIP codes.
SELECT
  z17."geo_id"                                                       AS "zip",
  ROUND(0.38 * z17."employed_wholesale_trade", 2)                    AS "vuln_wholesale",
  ROUND(0.41 * z17."employed_manufacturing",   2)                    AS "vuln_manufacturing",
  ROUND(0.38 * z17."employed_wholesale_trade"
        + 0.41 * z17."employed_manufacturing", 2)                    AS "vuln_total"
FROM
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
LIMIT 20;
