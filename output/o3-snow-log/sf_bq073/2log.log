  "median_income",
  "employed_manufacturing",
  "employed_wholesale_trade"
FROM
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"
LIMIT 20;
```

```sql
-- 2. Preview the same set of columns for 2018 so we can later compute
--    the 2015→2018 median–income change per ZIP code.
SELECT
  "geo_id",
  "median_income",
  "employed_manufacturing",
  "employed_wholesale_trade"
FROM
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
LIMIT 20;
```

```sql
-- 3. Inspect the 2017 ACS employment figures that will be used to build
--    the “vulnerable‐worker” metric (38 % wholesale, 41 % manufacturing).
SELECT
  "geo_id",
  "median_income",
  "employed_manufacturing",
  "employed_wholesale_trade"
FROM
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"
LIMIT 20;
```

```sql
-- 4. Preview the ZIP-to-state look-up table to see how ZIP codes map to
--    two–letter state codes and full state names.
SELECT
  "zip_code",
  "state_code",
  "state_name"
FROM
  CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"
LIMIT 20;
```

```sql
-- 5. Verify that a random ZIP (e.g. ‘90210’) joins correctly from the
--    2017 employment table to its state name.
SELECT
  z17."geo_id"                         AS "zip",
  g."state_code",
  g."state_name",
  z17."employed_manufacturing",
  z17."employed_wholesale_trade"
FROM
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"   z17
JOIN
  CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"            g
    ON z17."geo_id" = g."zip_code"
WHERE
  z17."geo_id" = '90210'
LIMIT 20;
```

```sql
-- 6. Compute “vulnerable” employment at the ZIP level (38 % wholesale,
--    41 % manufacturing) for a small sample of ZIP codes.
SELECT
  z17."geo_id"                                                       AS "zip",
  ROUND(0.38 * z17."employed_wholesale_trade", 2)                    AS "vuln_wholesale",
  ROUND(0.41 * z17."employed_manufacturing",   2)                    AS "vuln_manufacturing",
  ROUND(0.38 * z17."employed_wholesale_trade"
        + 0.41 * z17."employed_manufacturing", 2)                    AS "vuln_total"
FROM
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
LIMIT 20;
```

```sql
-- 7. Illustrate the 2015→2018 median-income change for each ZIP code.
--    (Positive values mean income rose, negative values mean it fell.)
SELECT
  z18."geo_id"                                         AS "zip",
  z15."median_income"                                  AS "income_2015",
  z18."median_income"                                  AS "income_2018",
  (z18."median_income" - z15."median_income")          AS "income_delta"
FROM
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
JOIN
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
    ON z15."geo_id" = z18."geo_id"
LIMIT 20;
```

```sql
-- 8. Bring together the ZIP-level vulnerable employment (2017) with the
--    2015→2018 income change, keeping only ZIP codes that exist in all
--    three datasets.  Inspect 20 rows.
SELECT
  z17."geo_id"                                       AS "zip",
  g."state_name",
  (z18."median_income" - z15."median_income")        AS "income_delta",
  0.38 * z17."employed_wholesale_trade"              AS "vuln_wholesale",
  0.41 * z17."employed_manufacturing"                AS "vuln_manufacturing"
FROM
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
JOIN
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
    ON z17."geo_id" = z15."geo_id"
JOIN
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
    ON z17."geo_id" = z18."geo_id"
JOIN
  CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"  g
    ON z17."geo_id" = g."zip_code"
LIMIT 20;
```

```sql
-- 9. Aggregate vulnerable workers by state, ordering by the combined total
--    (wholesale + manufacturing) in descending order.
SELECT
  g."state_name"                                                                            AS "state",
  ROUND(SUM(0.38 * z17."employed_wholesale_trade"))  AS "vulnerable_wholesale_trade_workers",
  ROUND(SUM(0.41 * z17."employed_manufacturing"))    AS "vulnerable_manufacturing_workers",
  ROUND(SUM(0.38 * z17."employed_wholesale_trade"
          + 0.41 * z17."employed_manufacturing"))    AS "total_vulnerable_workers"
FROM
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"      z17
JOIN
  CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"               g
    ON z17."geo_id" = g."zip_code"
GROUP BY
  g."state_name"
ORDER BY
  "total_vulnerable_workers" DESC
LIMIT 20;
```

```sql
-- 10. Produce the full, final list (no LIMIT) of every state’s vulnerable
--     wholesale-trade workers, vulnerable manufacturing workers, and the
--     combined total, sorted from most to fewest vulnerable workers.
SELECT
  g."state_name"                                                                            AS "state",
  ROUND(SUM(0.38 * z17."employed_wholesale_trade"))  AS "vulnerable_wholesale_trade_workers",
  ROUND(SUM(0.41 * z17."employed_manufacturing"))    AS "vulnerable_manufacturing_workers",
  ROUND(SUM(0.38 * z17."employed_wholesale_trade"
          + 0.41 * z17."employed_manufacturing"))    AS "total_vulnerable_workers"
FROM
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"      z17
JOIN
  CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"               g
    ON z17."geo_id" = g."zip_code"
GROUP BY
  g."state_name"
ORDER BY
  "total_vulnerable_workers" DESC;
```
