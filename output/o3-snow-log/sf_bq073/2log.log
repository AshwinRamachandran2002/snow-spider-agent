  g."state_name"                                                                            AS "state",
  ROUND(SUM(0.38 * z17."employed_wholesale_trade"))  AS "vulnerable_wholesale_trade_workers",
  ROUND(SUM(0.41 * z17."employed_manufacturing"))    AS "vulnerable_manufacturing_workers",
  ROUND(SUM(0.38 * z17."employed_wholesale_trade"
          + 0.41 * z17."employed_manufacturing"))    AS "total_vulnerable_workers"
FROM
  CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"      z17
JOIN
  CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"               g
    ON z17."geo_id" = g."zip_code"
GROUP BY
  g."state_name"
ORDER BY
  "total_vulnerable_workers" DESC
LIMIT 20;
