```sql
--Description: 2) Inspect 2018 ZIP-code ACS file for the same set of fields.
SELECT *
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"
LIMIT 20;
```

```sql
--Description: 3) Look at the 2017 ZIP-code ACS file that contains the employment figures needed for “vulnerable” worker counts.
SELECT "geo_id",
       "median_income",
       "employed_manufacturing",
       "employed_wholesale_trade"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"
LIMIT 20;
```

```sql
--Description: 4) Review ZIP-to-state cross-walk from the GEO_US_BOUNDARIES reference table.
SELECT "zip_code",
       "state_code",
       "state_name"
FROM CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"
LIMIT 20;
```

```sql
--Description: 5) Compute the ZIP-level change in median income between 2015 and 2018 (sample of 20 ZIPs).
SELECT a."geo_id"                       AS "zip",
       a."median_income"                AS "income_2015",
       b."median_income"                AS "income_2018",
       (b."median_income" - a."median_income") AS "income_change"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
JOIN   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
  ON   a."geo_id" = b."geo_id"
WHERE  a."median_income" IS NOT NULL
  AND  b."median_income" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 6) Derive 2017 “vulnerable” worker counts at ZIP level (sample of 20 ZIPs).
SELECT "geo_id"                                           AS "zip",
       "employed_wholesale_trade" * 0.38                  AS "vulnerable_wholesale",
       "employed_manufacturing"  * 0.41                  AS "vulnerable_manufacturing"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"
WHERE  "employed_wholesale_trade" IS NOT NULL
   AND "employed_manufacturing"  IS NOT NULL
LIMIT 20;
```

```sql
--Description: 7) Attach state information to the 2017 “vulnerable” ZIP-level counts (sample of 20 rows).
SELECT z."geo_id"                                        AS "zip",
       s."state_name",
       z."employed_wholesale_trade" * 0.38               AS "vulnerable_wholesale",
       z."employed_manufacturing"  * 0.41               AS "vulnerable_manufacturing"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z
JOIN   CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"  g
  ON   z."geo_id" = g."zip_code"
JOIN   CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."STATES"     s
  ON   g."state_code" = s."state"
LIMIT 20;
```

```sql
--Description: 8) Combine the income-change requirement with 2017 vulnerable worker counts (sample of 20 ZIPs).
SELECT z17."geo_id"                                              AS "zip",
       s."state_name",
       (z18."median_income" - z15."median_income")               AS "income_change",
       z17."employed_wholesale_trade" * 0.38                     AS "vulnerable_wholesale",
       z17."employed_manufacturing"  * 0.41                     AS "vulnerable_manufacturing"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
JOIN   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
  ON   z15."geo_id" = z18."geo_id"
JOIN   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
  ON   z15."geo_id" = z17."geo_id"
JOIN   CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"         g
  ON   z15."geo_id" = g."zip_code"
JOIN   CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."STATES"            s
  ON   g."state_code" = s."state"
WHERE  z15."median_income" IS NOT NULL
  AND  z18."median_income" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 9) Aggregate vulnerable workers by state, ordering by total vulnerable workers (top 20 states).
SELECT s."state_name",
       SUM(z."employed_wholesale_trade" * 0.38)   AS "vulnerable_wholesale",
       SUM(z."employed_manufacturing"  * 0.41)   AS "vulnerable_manufacturing",
       SUM(z."employed_wholesale_trade" * 0.38) +
       SUM(z."employed_manufacturing"  * 0.41)   AS "total_vulnerable_workers"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z
JOIN   CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"         g
  ON   z."geo_id" = g."zip_code"
JOIN   CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."STATES"            s
  ON   g."state_code" = s."state"
GROUP BY s."state_name"
ORDER BY "total_vulnerable_workers" DESC
LIMIT 20;
```

```sql
--Description: 10) Full-criteria query: only include states whose ZIPs saw a positive median-income change from 2015-2018; present final state-level vulnerable counts (all states).
SELECT   s."state_name",
         SUM(z17."employed_wholesale_trade" * 0.38) AS "vulnerable_wholesale",
         SUM(z17."employed_manufacturing"  * 0.41) AS "vulnerable_manufacturing",
         SUM(z17."employed_wholesale_trade" * 0.38) +
         SUM(z17."employed_manufacturing"  * 0.41) AS "total_vulnerable_workers"
FROM     CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
JOIN     CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
       ON z15."geo_id" = z18."geo_id"
JOIN     CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
       ON z15."geo_id" = z17."geo_id"
JOIN     CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"          g
       ON z15."geo_id" = g."zip_code"
JOIN     CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."STATES"             s
       ON g."state_code" = s."state"
WHERE    z18."median_income" - z15."median_income" > 0
GROUP BY s."state_name"
ORDER BY "total_vulnerable_workers" DESC
LIMIT 20;
```
