Query:
--Description: Join 2017 ZIP employment to the ZIP→state cross-walk and compute the “vulnerable” head-counts for a handful of ZIP codes.  
SELECT 
    z."geo_id"                         AS "zip",
    g."state_code",
    g."state_name",
    z."employed_wholesale_trade" * 0.38 AS "vuln_wholesale",
    z."employed_manufacturing"  * 0.41 AS "vuln_manufacturing"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"   z
