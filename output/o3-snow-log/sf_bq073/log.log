    "state_code", 
    "state_name"
FROM CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"
LIMIT 20;
```

```sql
--Description: Join 2017 ZIP employment to the ZIP→state cross-walk and compute the “vulnerable” head-counts for a handful of ZIP codes.  
SELECT 
    z."geo_id"                         AS "zip",
    g."state_code",
    g."state_name",
    z."employed_wholesale_trade" * 0.38 AS "vuln_wholesale",
    z."employed_manufacturing"  * 0.41 AS "vuln_manufacturing"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"   z
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"            g
      ON z."geo_id" = g."zip_code"
LIMIT 20;
```

```sql
--Description: Aggregate those vulnerable-worker counts by state to see preliminary totals (unsorted, sample of 20 states).  
SELECT
    g."state_name",
    SUM(z."employed_wholesale_trade" * 0.38) AS "vuln_wholesale",
    SUM(z."employed_manufacturing"  * 0.41) AS "vuln_manufacturing",
    SUM(z."employed_wholesale_trade" * 0.38) 
      + SUM(z."employed_manufacturing" * 0.41) AS "total_vulnerable"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"   z
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"            g
      ON z."geo_id" = g."zip_code"
GROUP BY g."state_name"
LIMIT 20;
```

```sql
--Description: Compute average 2017 median household income for each state (useful when combining with the income-difference calculation).  
SELECT
    g."state_name",
    AVG(z."median_income") AS "avg_2017_income"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"   z
JOIN CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"            g
      ON z."geo_id" = g."zip_code"
WHERE z."median_income" IS NOT NULL
GROUP BY g."state_name"
LIMIT 20;
```

```sql
--Description: Check whether a median-income column exists in the 2015 table (if it does, pull it; if not, this query will fail and we know to adjust).  
SELECT 
    "geo_id",
    "median_income"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"
LIMIT 20;
```

```sql
--Description: Illustrative income-difference pull: join 2015 and 2018 ZIP files on geo_id and calculate Δ median income, keeping only ZIP codes present in both years.  
SELECT
    a."geo_id"                                         AS "zip",
    a."median_income"                                  AS "income_2015",
    b."median_income"                                  AS "income_2018",
    b."median_income" - a."median_income"              AS "income_diff"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"  a
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"  b
      ON a."geo_id" = b."geo_id"
WHERE a."median_income" IS NOT NULL
  AND b."median_income" IS NOT NULL
LIMIT 20;
```
