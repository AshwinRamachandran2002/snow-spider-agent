Query:
--10) FINAL – state-level vulnerable-worker counts (38% wholesale, 41% mfg), ranked
SELECT d."state_name",
       SUM(0.38 * c."employed_wholesale_trade")   AS "vulnerable_wholesale_trade",
       SUM(0.41 * c."employed_manufacturing")     AS "vulnerable_manufacturing",
       SUM(0.38 * c."employed_wholesale_trade"
           + 0.41 * c."employed_manufacturing")   AS "total_vulnerable_workers"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR"              a
JOIN   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR"              b
       ON a."geo_id" = b."geo_id"                         -- to get 2015 vs 2018 incomes
JOIN   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR"              c
       ON a."geo_id" = c."geo_id"                         -- 2017 employment figures
JOIN   CENSUS_BUREAU_ACS_2.GEO_US_BOUNDARIES."ZIP_CODES"                      d
       ON a."geo_id" = d."zip_code"                       -- map ZIP to state
GROUP  BY d."state_name"
ORDER  BY "total_vulnerable_workers" DESC
LIMIT  20;
