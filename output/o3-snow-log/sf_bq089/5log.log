    COUNT(*)                       AS "vaccine_sites_all_modes"
FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
WHERE "facility_sub_region_1" = 'California'
GROUP BY "facility_sub_region_2_code"
ORDER BY "vaccine_sites_all_modes" DESC
LIMIT 20;
```

```sql
--Description: similar count but use WALK-access table as a cross-check
SELECT
    "facility_sub_region_2_code"   AS "county_fips",
    COUNT(*)                       AS "vaccine_sites_walk"
FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_WALK
WHERE "facility_sub_region_1" = 'California'
GROUP BY "facility_sub_region_2_code"
ORDER BY "vaccine_sites_walk" DESC
LIMIT 20;
```

```sql
--Description: join county population (2018 5-year ACS) to vaccine-site counts  
--to produce the number of sites per 1,000 residents for California counties
WITH county_pop AS (
    SELECT 
        LEFT("geo_id",5) AS "county_fips",
        SUM("total_pop") AS "county_pop_2018_5yr"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE "geo_id" ILIKE '06%'        -- California
    GROUP BY LEFT("geo_id",5)
),
site_cnt AS (
    SELECT
        "facility_sub_region_2_code" AS "county_fips",
        COUNT(*)                     AS "vaccine_sites"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
    WHERE "facility_sub_region_1" = 'California'
    GROUP BY "facility_sub_region_2_code"
)
SELECT
    p."county_fips",
    p."county_pop_2018_5yr",
    s."vaccine_sites",
    (s."vaccine_sites" / NULLIF(p."county_pop_2018_5yr",0)) * 1000  AS "sites_per_1000_pop"
FROM county_pop p
JOIN site_cnt  s USING ("county_fips")
ORDER BY "sites_per_1000_pop" DESC
LIMIT 20;
```

```sql
--Description: display counties with the fewest vaccine sites per 1,000 people (bottom end)
WITH county_pop AS (
    SELECT 
        LEFT("geo_id",5) AS "county_fips",
        SUM("total_pop") AS "county_pop_2018_5yr"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE "geo_id" ILIKE '06%'
    GROUP BY LEFT("geo_id",5)
),
site_cnt AS (
    SELECT
        "facility_sub_region_2_code" AS "county_fips",
        COUNT(*)                     AS "vaccine_sites"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
    WHERE "facility_sub_region_1" = 'California'
    GROUP BY "facility_sub_region_2_code"
)
SELECT
    p."county_fips",
    p."county_pop_2018_5yr",
    s."vaccine_sites",
    (s."vaccine_sites" / NULLIF(p."county_pop_2018_5yr",0)) * 1000  AS "sites_per_1000_pop"
FROM county_pop p
JOIN site_cnt  s USING ("county_fips")
ORDER BY "sites_per_1000_pop" ASC
LIMIT 20;
```

```sql
--Description: bring in the county names from the vaccination table for readability  
--(there is no name in the population table, so we link via the site table)
WITH county_pop AS (
    SELECT 
        LEFT("geo_id",5) AS "county_fips",
        SUM("total_pop") AS "county_pop_2018_5yr"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE "geo_id" ILIKE '06%'
    GROUP BY LEFT("geo_id",5)
),
site_cnt AS (
    SELECT
        "facility_sub_region_2_code" AS "county_fips",
        MAX("facility_sub_region_2") AS "county_name",
        COUNT(*)                     AS "vaccine_sites"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
    WHERE "facility_sub_region_1" = 'California'
    GROUP BY "facility_sub_region_2_code"
)
SELECT
    s."county_name",
    p."county_pop_2018_5yr",
    s."vaccine_sites",
    (s."vaccine_sites" / NULLIF(p."county_pop_2018_5yr",0)) * 1000  AS "sites_per_1000_pop"
FROM county_pop p
JOIN site_cnt  s USING ("county_fips")
ORDER BY "sites_per_1000_pop" DESC
LIMIT 20;
```

```sql
--Description: final check – list distinct California county FIPS found in population but missing from site table
WITH county_pop AS (
    SELECT LEFT("geo_id",5) AS "county_fips"
    FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE  "geo_id" ILIKE '06%'
    GROUP BY LEFT("geo_id",5)
),
site_cnt AS (
    SELECT DISTINCT "facility_sub_region_2_code" AS "county_fips"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
    WHERE "facility_sub_region_1" = 'California'
)
SELECT 
    p."county_fips"
FROM county_pop p
LEFT JOIN site_cnt s USING ("county_fips")
WHERE s."county_fips" IS NULL
LIMIT 20;
```
