```sql
-- 1) Description: Inspect the 2018 5-year ACS Block-Group table to confirm that it
--    contains both a geography id (``geo_id``) and the 2018 population estimate
--    (``total_pop``).  
SELECT 
  "geo_id",
  "total_pop"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
LIMIT 20;
```

```sql
-- 2) Description: Look only at California block-groups (state FIPS = '06') so we
--    can later roll them up to the county level.  
SELECT 
  "geo_id",
  "total_pop"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
WHERE SUBSTR("geo_id",1,2) = '06'
LIMIT 20;
```

```sql
-- 3) Description: Aggregate California block-groups to get the 2018 population
--    for each county (five–digit FIPS = state(2) + county(3)).  
SELECT
  SUBSTR("geo_id",1,5)         AS "county_fips",
  SUM("total_pop")             AS "county_pop_2018"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
WHERE SUBSTR("geo_id",1,2) = '06'
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
-- 4) Description: Preview vaccination-site records in the master “ALL” boundary
--    file for California and note the county FIPS codes provided.  
SELECT
  "facility_name",
  "facility_sub_region_2",        -- county name
  "facility_sub_region_2_code"    -- five-digit county FIPS
FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
WHERE "facility_sub_region_1" = 'California'
  AND "facility_sub_region_2_code" IS NOT NULL
LIMIT 20;
```

```sql
-- 5) Description: Count distinct vaccination sites per California county in the
--    “ALL” boundary file.  
SELECT
  "facility_sub_region_2_code" AS "county_fips",
  COUNT(DISTINCT "facility_name") AS "all_facilities"
FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
WHERE "facility_sub_region_1" = 'California'
  AND "facility_sub_region_2_code" IS NOT NULL
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 6) Description: Do the same count for the “WALK” travel-mode boundary file,
--    which also contains county FIPS codes.  
SELECT
  "facility_sub_region_2_code" AS "county_fips",
  COUNT(DISTINCT "facility_name") AS "walk_facilities"
FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_WALK
WHERE "facility_sub_region_1" = 'California'
  AND "facility_sub_region_2_code" IS NOT NULL
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 7) Description: Combine the “ALL” and “WALK” counts to obtain the total
--    number of unique vaccination sites per California county.  
WITH all_cnt AS (
    SELECT "facility_sub_region_2_code" AS "county_fips",
           COUNT(DISTINCT "facility_name") AS "facilities"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
    WHERE "facility_sub_region_1" = 'California'
      AND "facility_sub_region_2_code" IS NOT NULL
    GROUP BY 1
),
walk_cnt AS (
    SELECT "facility_sub_region_2_code" AS "county_fips",
           COUNT(DISTINCT "facility_name") AS "facilities"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_WALK
    WHERE "facility_sub_region_1" = 'California'
      AND "facility_sub_region_2_code" IS NOT NULL
    GROUP BY 1
)
SELECT
  "county_fips",
  SUM("facilities") AS "total_facilities"
FROM (
  SELECT * FROM all_cnt
  UNION ALL
  SELECT * FROM walk_cnt
)
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 8) Description: Join the county-level facility counts with the 2018 ACS county
--    population estimates and calculate the number of vaccine sites per 1,000
--    people for each California county.  
WITH county_pop AS (
    SELECT
      SUBSTR("geo_id",1,5) AS "county_fips",
      SUM("total_pop")     AS "county_pop_2018"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE SUBSTR("geo_id",1,2) = '06'
    GROUP BY 1
),
facility_cnt AS (
    SELECT
      "county_fips",
      SUM("facilities") AS "total_facilities"
    FROM (
      SELECT "facility_sub_region_2_code" AS "county_fips",
             COUNT(DISTINCT "facility_name") AS "facilities"
      FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
      WHERE "facility_sub_region_1" = 'California'
        AND "facility_sub_region_2_code" IS NOT NULL
      GROUP BY 1
      UNION ALL
      SELECT "facility_sub_region_2_code" AS "county_fips",
             COUNT(DISTINCT "facility_name") AS "facilities"
      FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_WALK
      WHERE "facility_sub_region_1" = 'California'
        AND "facility_sub_region_2_code" IS NOT NULL
      GROUP BY 1
    )
    GROUP BY 1
)
SELECT
  p."county_fips",
  p."county_pop_2018",
  f."total_facilities",
  ROUND( f."total_facilities" / (p."county_pop_2018" / 1000), 3 ) AS "sites_per_1000"
FROM county_pop p
JOIN facility_cnt f
  ON p."county_fips" = f."county_fips"
ORDER BY "sites_per_1000" DESC
LIMIT 20;
```
