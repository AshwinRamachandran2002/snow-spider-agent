       "total_pop"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
WHERE "geo_id" LIKE '06%'
LIMIT 20;
```

```sql
-- Description: Aggregate the 2018 block-group populations up to the county level for California.
-- The first five characters of the GEOID are the county FIPS code.
SELECT SUBSTR("geo_id", 1, 5)               AS "county_fips",
       SUM("total_pop")                     AS "county_pop_2018"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
WHERE  "geo_id" LIKE '06%'      -- California block-groups
GROUP  BY 1
ORDER  BY 2 DESC
LIMIT 20;
```

```sql
-- Description: Preview vaccination-site records for California to understand the columns that hold county name and FIPS.
SELECT "facility_name",
       "facility_sub_region_2",        -- county name
       "facility_sub_region_2_code"    -- 5-digit county FIPS
FROM   COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
WHERE  "facility_sub_region_1" = 'California'
LIMIT 20;
```

```sql
-- Description: Count distinct vaccination sites in each California county (using county FIPS code).
SELECT "facility_sub_region_2_code"            AS "county_fips",
       COUNT(DISTINCT "facility_name")         AS "facility_sites"
FROM   COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
WHERE  "facility_sub_region_1" = 'California'
GROUP  BY 1
ORDER  BY 2 DESC
LIMIT 20;
```

```sql
-- Description: Cross-check that every California vaccination-site record indeed has a county FIPS code.
SELECT DISTINCT "facility_sub_region_2", "facility_sub_region_2_code"
FROM   COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
WHERE  "facility_sub_region_1" = 'California'
  AND  "facility_sub_region_2_code" IS NULL
LIMIT 20;
```

```sql
-- Description: Join the 2018 population (per county) with the vaccination-site counts
-- and compute sites per 1,000 people for every California county.
SELECT  p."county_fips",
        p."county_pop_2018",
        f."facility_sites",
        (f."facility_sites" / p."county_pop_2018") * 1000 AS "sites_per_1000"
FROM   (
          SELECT SUBSTR("geo_id", 1, 5) AS "county_fips",
                 SUM("total_pop")       AS "county_pop_2018"
          FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
          WHERE  "geo_id" LIKE '06%'                -- California
          GROUP  BY 1
       ) p
LEFT JOIN (
          SELECT "facility_sub_region_2_code" AS "county_fips",
                 COUNT(DISTINCT "facility_name") AS "facility_sites"
          FROM   COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
          WHERE  "facility_sub_region_1" = 'California'
          GROUP  BY 1
       ) f
ON p."county_fips" = f."county_fips"
ORDER BY "sites_per_1000" DESC
LIMIT 20;
```

```sql
-- Description: (Optional deeper dive)  Display counties with very low (or NULL) site-to-population ratios to
-- identify potential access deserts.
SELECT p."county_fips",
       p."county_pop_2018",
       COALESCE(f."facility_sites", 0)                AS "facility_sites",
       COALESCE((f."facility_sites" / p."county_pop_2018") * 1000, 0) AS "sites_per_1000"
FROM   (
          SELECT SUBSTR("geo_id", 1, 5) AS "county_fips",
                 SUM("total_pop")       AS "county_pop_2018"
          FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
          WHERE  "geo_id" LIKE '06%'
          GROUP  BY 1
       ) p
LEFT JOIN (
          SELECT "facility_sub_region_2_code" AS "county_fips",
                 COUNT(DISTINCT "facility_name") AS "facility_sites"
          FROM   COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
          WHERE  "facility_sub_region_1" = 'California'
          GROUP  BY 1
       ) f
ON p."county_fips" = f."county_fips"
ORDER BY "sites_per_1000" ASC
LIMIT 20;
```
