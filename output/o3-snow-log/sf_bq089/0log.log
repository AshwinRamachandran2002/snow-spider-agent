Query:
--Description:  Show counties with the lowest vaccination-site access by listing California counties
--              in ascending order of sites per 1,000 people.  Uses COALESCE to treat null site counts
--              as zero so every California county appears.
SELECT p."county_fips",
       p."county_pop_2018",
       COALESCE(f."facility_sites", 0)                                    AS "facility_sites",
       COALESCE((f."facility_sites" / p."county_pop_2018") * 1000, 0)     AS "sites_per_1000"
FROM   (
          SELECT SUBSTR("geo_id", 1, 5) AS "county_fips",
                 SUM("total_pop")       AS "county_pop_2018"
          FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
          WHERE  "geo_id" LIKE '06%'            -- California block-groups
          GROUP  BY 1
       ) p
LEFT JOIN (
          SELECT "facility_sub_region_2_code" AS "county_fips",
                 COUNT(DISTINCT "facility_name") AS "facility_sites"
          FROM   COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
          WHERE  "facility_sub_region_1" = 'California'
          GROUP  BY 1
       ) f
ON p."county_fips" = f."county_fips"
ORDER BY "sites_per_1000" ASC
LIMIT 20
