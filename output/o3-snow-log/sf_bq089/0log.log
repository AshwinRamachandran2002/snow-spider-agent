Query:
--Description:  Join 2018 county-level population (derived from block-group GEOIDs) with counts of
--              distinct vaccination sites per California county, then compute the number of sites
--              per 1,000 residents.  Results are ordered from highest to lowest “sites_per_1000”.
SELECT  p."county_fips",
        p."county_pop_2018",
        f."facility_sites",
        (f."facility_sites" / p."county_pop_2018") * 1000 AS "sites_per_1000"
FROM   (
          SELECT SUBSTR("geo_id", 1, 5) AS "county_fips",
                 SUM("total_pop")       AS "county_pop_2018"
          FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
          WHERE  "geo_id" LIKE '06%'                -- California
          GROUP  BY 1
       ) p
LEFT JOIN (
          SELECT "facility_sub_region_2_code" AS "county_fips",
                 COUNT(DISTINCT "facility_name") AS "facility_sites"
          FROM   COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
          WHERE  "facility_sub_region_1" = 'California'
          GROUP  BY 1
       ) f
ON p."county_fips" = f."county_fips"
ORDER BY "sites_per_1000" DESC
LIMIT 20
