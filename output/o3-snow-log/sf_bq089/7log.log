--Description: 9) Join the walk-mode facility counts to the population table  
--              and compute walk-accessible sites per 1,000 residents.  
WITH pop AS (
    SELECT SUBSTR("geo_id",1,5) AS "county_fips",
           SUM("total_pop")     AS "county_population_2018"
    FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
    WHERE  "geo_id" LIKE '06%'
    GROUP  BY SUBSTR("geo_id",1,5)
),
walk AS (
    SELECT "facility_sub_region_2_code" AS "county_fips",
           COUNT(*)                     AS "walk_facilities"
    FROM   "COVID19_USA"."COVID19_VACCINATION_ACCESS"."FACILITY_BOUNDARY_US_WALK"
    WHERE  "facility_sub_region_1" = 'California'
    GROUP  BY "facility_sub_region_2_code"
)
SELECT w."county_fips",
       p."county_population_2018",
       w."walk_facilities",
       ROUND(w."walk_facilities" / p."county_population_2018" * 1000 , 4)  
           AS "walk_sites_per_1000_pop"
FROM   walk w
JOIN   pop  p USING ("county_fips")
ORDER  BY "walk_sites_per_1000_pop" DESC
LIMIT 20;
