```sql
--Description: 1) Take a first look at the 2018 five-year ACS Block-Group file to see what columns are available.  
SELECT *  
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"  
LIMIT 20;
```

```sql
--Description: 2) Show a sample of California block-groups –  California state FIPS codes all start with ‘06’.  
SELECT "geo_id", "total_pop"  
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"  
WHERE "geo_id" LIKE '06%'  
LIMIT 20;
```

```sql
--Description: 3) Aggregate the 2018 block-group populations up to the county-level for California.  
--County FIPS = first 5 characters of the block-group GEOID.  
SELECT SUBSTR("geo_id",1,5)            AS "county_fips" ,
       SUM("total_pop")                AS "county_population_2018"
FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
WHERE  "geo_id" LIKE '06%'                       -- California only
GROUP  BY SUBSTR("geo_id",1,5)
LIMIT 20;
```

```sql
--Description: 4) Order the aggregated California county populations largest to smallest (sample).  
SELECT SUBSTR("geo_id",1,5)            AS "county_fips" ,
       SUM("total_pop")                AS "county_population_2018"
FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
WHERE  "geo_id" LIKE '06%'
GROUP  BY SUBSTR("geo_id",1,5)
ORDER  BY "county_population_2018" DESC
LIMIT 20;
```

```sql
--Description: 5) Inspect a few vaccination-site rows for California in the “all modes” facility table.  
SELECT "facility_name",
       "facility_sub_region_1",
       "facility_sub_region_2",
       "facility_sub_region_2_code"
FROM   "COVID19_USA"."COVID19_VACCINATION_ACCESS"."FACILITY_BOUNDARY_US_ALL"
WHERE  "facility_sub_region_1" = 'California'
LIMIT 20;
```

```sql
--Description: 6) Count the number of vaccination sites per California county (all modes table).  
SELECT "facility_sub_region_2_code"    AS "county_fips",
       COUNT(*)                        AS "vaccination_sites"
FROM   "COVID19_USA"."COVID19_VACCINATION_ACCESS"."FACILITY_BOUNDARY_US_ALL"
WHERE  "facility_sub_region_1" = 'California'
GROUP  BY "facility_sub_region_2_code"
LIMIT 20;
```

```sql
--Description: 7) Join the county-level population (2018 5-yr ACS) to the facility counts  
--             and calculate vaccination sites per 1,000 residents for California counties.  
WITH pop AS (
    SELECT SUBSTR("geo_id",1,5) AS "county_fips",
           SUM("total_pop")     AS "county_population_2018"
    FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
    WHERE  "geo_id" LIKE '06%'
    GROUP  BY SUBSTR("geo_id",1,5)
),
sites AS (
    SELECT "facility_sub_region_2_code" AS "county_fips",
           COUNT(*)                     AS "vaccination_sites"
    FROM   "COVID19_USA"."COVID19_VACCINATION_ACCESS"."FACILITY_BOUNDARY_US_ALL"
    WHERE  "facility_sub_region_1" = 'California'
    GROUP  BY "facility_sub_region_2_code"
)
SELECT s."county_fips",
       p."county_population_2018",
       s."vaccination_sites",
       ROUND(s."vaccination_sites" / p."county_population_2018" * 1000 , 4)  
           AS "sites_per_1000_pop"
FROM   sites s
JOIN   pop   p USING ("county_fips")
ORDER  BY "sites_per_1000_pop" DESC
LIMIT 20;
```

```sql
--Description: 8) Repeat the facility count using the “walk” accessibility layer  
--             to compare with the previous “all” counts (California only).  
SELECT "facility_sub_region_2_code"    AS "county_fips",
       COUNT(*)                        AS "walk_facilities"
FROM   "COVID19_USA"."COVID19_VACCINATION_ACCESS"."FACILITY_BOUNDARY_US_WALK"
WHERE  "facility_sub_region_1" = 'California'
GROUP  BY "facility_sub_region_2_code"
LIMIT 20;
```

```sql
--Description: 9) Join the walk-mode facility counts to the population table  
--              and compute walk-accessible sites per 1,000 residents.  
WITH pop AS (
    SELECT SUBSTR("geo_id",1,5) AS "county_fips",
           SUM("total_pop")     AS "county_population_2018"
    FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
    WHERE  "geo_id" LIKE '06%'
    GROUP  BY SUBSTR("geo_id",1,5)
),
walk AS (
    SELECT "facility_sub_region_2_code" AS "county_fips",
           COUNT(*)                     AS "walk_facilities"
    FROM   "COVID19_USA"."COVID19_VACCINATION_ACCESS"."FACILITY_BOUNDARY_US_WALK"
    WHERE  "facility_sub_region_1" = 'California'
    GROUP  BY "facility_sub_region_2_code"
)
SELECT w."county_fips",
       p."county_population_2018",
       w."walk_facilities",
       ROUND(w."walk_facilities" / p."county_population_2018" * 1000 , 4)  
           AS "walk_sites_per_1000_pop"
FROM   walk w
JOIN   pop  p USING ("county_fips")
ORDER  BY "walk_sites_per_1000_pop" DESC
LIMIT 20;
```

```sql
--Description: 10) Produce a final ranked list of California counties with  
--               overall (all-modes) sites per 1,000 residents (no LIMIT).  
WITH pop AS (
    SELECT SUBSTR("geo_id",1,5) AS "county_fips",
           SUM("total_pop")     AS "county_population_2018"
    FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."BLOCKGROUP_2018_5YR"
    WHERE  "geo_id" LIKE '06%'
    GROUP  BY SUBSTR("geo_id",1,5)
),
sites AS (
    SELECT "facility_sub_region_2_code" AS "county_fips",
           COUNT(*)                     AS "vaccination_sites"
    FROM   "COVID19_USA"."COVID19_VACCINATION_ACCESS"."FACILITY_BOUNDARY_US_ALL"
    WHERE  "facility_sub_region_1" = 'California'
    GROUP  BY "facility_sub_region_2_code"
)
SELECT s."county_fips",
       p."county_population_2018",
       s."vaccination_sites",
       ROUND(s."vaccination_sites" / p."county_population_2018" * 1000 , 4)  
           AS "sites_per_1000_pop"
FROM   sites s
JOIN   pop   p USING ("county_fips")
ORDER  BY "sites_per_1000_pop" DESC;
```
