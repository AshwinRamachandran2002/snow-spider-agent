```sql
--Description:  Compute the number of vaccination sites per 1,000 residents for every California county.  
--              • county_pop   : aggregate 2018 ACS block-group records (GEOID starts with ‘06’) to 5-digit county FIPS  
--                                and sum “total_pop”.  
--              • site_counts  : count DISTINCT facility names in the “all-modes” vaccination-site table for each county.  
--              • county_names : grab a readable county name (where a site exists) to accompany the FIPS.  
--              • Final SELECT joins population to site counts (LEFT JOIN so counties without sites get zero) and
--                calculates sites_per_1000 = sites ÷ (pop/1,000).  Ordered by highest access.  
WITH county_pop AS (
    SELECT SUBSTR("geo_id", 1, 5) AS "county_fips",
           SUM("total_pop")       AS "county_pop"
    FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
    WHERE  "geo_id" LIKE '06%'               -- California
    GROUP  BY SUBSTR("geo_id", 1, 5)
),
site_counts AS (
    SELECT "facility_sub_region_2_code"      AS "county_fips",
           COUNT(DISTINCT "facility_name")   AS "site_cnt"
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_ALL"
    WHERE  "facility_sub_region_1" = 'California'
      AND  "facility_sub_region_2_code" IS NOT NULL
    GROUP  BY "facility_sub_region_2_code"
),
county_names AS (
    SELECT DISTINCT "facility_sub_region_2_code" AS "county_fips",
           "facility_sub_region_2"               AS "county_name"
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_ALL"
    WHERE  "facility_sub_region_1" = 'California'
      AND  "facility_sub_region_2_code" IS NOT NULL
)
SELECT
       cp."county_fips",
       cn."county_name",
       cp."county_pop",
       COALESCE(sc."site_cnt", 0)                                       AS "vax_sites",
       COALESCE(sc."site_cnt", 0) / (cp."county_pop" / 1000)            AS "sites_per_1000"
FROM   county_pop  cp
LEFT JOIN site_counts  sc ON cp."county_fips" = sc."county_fips"
LEFT JOIN county_names cn ON cp."county_fips" = cn."county_fips"
ORDER  BY "sites_per_1000" DESC, cp."county_fips";
```
