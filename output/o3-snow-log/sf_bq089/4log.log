```sql
--Description:  Identify California counties that have population recorded in the 2018 ACS but show **no** vaccination sites in the DRIVE-mode file.  
--   • Gather county-level population: take every block-group GEOID that starts with ‘06’ (California state FIPS)  
--     and sum “total_pop” after truncating the GEOID to its first 5 characters (state+county).  
--   • Collect the distinct 5-digit county FIPS codes that appear in the DRIVE vaccination-site file for California.  
--   • LEFT JOIN population → sites; counties where the join yields NULL on the site side have zero sites.  
--   • Return up to 20 such counties (if any) with their 2018 population.
SELECT
       pop."county_fips",
       pop."county_pop"
FROM (
       SELECT SUBSTR("geo_id", 1, 5) AS "county_fips",
              SUM("total_pop")       AS "county_pop"
       FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
       WHERE  "geo_id" LIKE '06%'                       -- California only
       GROUP  BY SUBSTR("geo_id", 1, 5)
) AS pop
LEFT JOIN (
       SELECT DISTINCT "facility_sub_region_2_code"     AS "county_fips"
       FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_DRIVE"
       WHERE  "facility_sub_region_1" = 'California'
         AND  "facility_sub_region_2_code" IS NOT NULL
) AS sites
ON  pop."county_fips" = sites."county_fips"
WHERE sites."county_fips" IS NULL
ORDER BY pop."county_fips"
LIMIT 20;
```
