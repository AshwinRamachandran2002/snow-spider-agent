```sql
-- 1.  Look at the list of California counties that appear in the nation-wide
--     “all–modes” vaccination-site file.
SELECT DISTINCT
       "facility_sub_region_2"      AS "county_name",
       "facility_sub_region_2_code" AS "county_fips"
FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_ALL"
WHERE  "facility_sub_region_1" = 'California'
LIMIT  20;
```

```sql
-- 2.  Count how many vaccination-site records are stored for each
--     California county in the “all-modes” table.
SELECT
       "facility_sub_region_2_code"        AS "county_fips",
       COUNT(*)                            AS "site_count"
FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_ALL"
WHERE  "facility_sub_region_1"   = 'California'
  AND  "facility_sub_region_2_code" IS NOT NULL
GROUP  BY "facility_sub_region_2_code"
ORDER  BY "site_count" DESC
LIMIT  20;
```

```sql
-- 3.  Peek at 2018 five-year ACS block-group records that belong
--     to California (GEOIDs that start with the state code ‘06’).
SELECT
       "geo_id",
       "total_pop"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
WHERE  "geo_id" LIKE '06%'
LIMIT  20;
```

```sql
-- 4.  Aggregate 2018 block-group populations up to the county level
--     (first 5 characters of the 12-digit GEOID = state+county FIPS).
SELECT
       SUBSTR("geo_id",1,5)        AS "county_fips",
       SUM("total_pop")            AS "county_pop"
FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
WHERE  "geo_id" LIKE '06%'
GROUP  BY SUBSTR("geo_id",1,5)
ORDER  BY "county_pop" DESC
LIMIT  20;
```

```sql
-- 5.  How many distinct California counties are represented
--     in the 2018 block-group file?
SELECT COUNT(*) AS "num_counties"
FROM (
        SELECT DISTINCT SUBSTR("geo_id",1,5) AS "county_fips"
        FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
        WHERE  "geo_id" LIKE '06%'
     )
LIMIT 20;
```

```sql
-- 6.  Vaccination sites by county when we keep only DISTINCT
--     provider IDs from the “drive” file (helps spot duplicates).
SELECT
       "facility_sub_region_2_code"        AS "county_fips",
       COUNT(DISTINCT "facility_provider_id") AS "distinct_site_count"
FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_DRIVE"
WHERE  "facility_sub_region_1" = 'California'
  AND  "facility_sub_region_2_code" IS NOT NULL
GROUP  BY "facility_sub_region_2_code"
ORDER  BY "distinct_site_count" DESC
LIMIT  20;
```

```sql
-- 7.  Build a combined list of vaccination sites across DRIVE, WALK,
--     and TRANSIT tables and count how many appear in each county.
SELECT
       "county_fips",
       COUNT(*) AS "total_sites_all_modes"
FROM (
        SELECT "facility_sub_region_2_code" AS "county_fips"
        FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_DRIVE"
        WHERE  "facility_sub_region_1" = 'California'
        UNION ALL
        SELECT "facility_sub_region_2_code"
        FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_WALK"
        WHERE  "facility_sub_region_1" = 'California'
        UNION ALL
        SELECT "facility_sub_region_2_code"
        FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_TRANSIT"
        WHERE  "facility_sub_region_1" = 'California'
     ) t
WHERE  "county_fips" IS NOT NULL
GROUP  BY "county_fips"
ORDER  BY "total_sites_all_modes" DESC
LIMIT  20;
```

```sql
-- 8.  Count DISTINCT facility names (rough way to de-duplicate)
--     in the “all-modes” table for each California county.
SELECT
       "county_fips",
       COUNT(DISTINCT "facility_name") AS "total_sites"
FROM (
        SELECT "facility_sub_region_2_code" AS "county_fips",
               "facility_name"
        FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_ALL"
        WHERE  "facility_sub_region_1" = 'California'
          AND  "facility_sub_region_2_code" IS NOT NULL
     ) a
GROUP  BY "county_fips"
ORDER  BY "total_sites" DESC
LIMIT  20;
```

```sql
-- 9.  Join county-level population (2018 5-yr ACS) to DISTINCT
--     facility-name counts to compute “sites per 1,000 people”.
SELECT
       pop."county_fips",
       pop."county_pop",
       sites."total_sites",
       sites."total_sites" / (pop."county_pop" / 1000) AS "sites_per_1000"
FROM (
       SELECT SUBSTR("geo_id",1,5) AS "county_fips",
              SUM("total_pop")     AS "county_pop"
       FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
       WHERE  "geo_id" LIKE '06%'
       GROUP  BY SUBSTR("geo_id",1,5)
     )  pop
JOIN (
       SELECT "facility_sub_region_2_code" AS "county_fips",
              COUNT(DISTINCT "facility_name") AS "total_sites"
       FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_ALL"
       WHERE  "facility_sub_region_1"   = 'California'
         AND  "facility_sub_region_2_code" IS NOT NULL
       GROUP  BY "facility_sub_region_2_code"
     ) sites
ON   pop."county_fips" = sites."county_fips"
ORDER BY "sites_per_1000" DESC
LIMIT 20;
```

```sql
-- 10.  Identify California counties that have population in the
--      2018 ACS but *no* vaccination sites recorded.
SELECT
       pop."county_fips",
       pop."county_pop"
FROM (
       SELECT SUBSTR("geo_id",1,5) AS "county_fips",
              SUM("total_pop")     AS "county_pop"
       FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
       WHERE  "geo_id" LIKE '06%'
       GROUP  BY SUBSTR("geo_id",1,5)
     ) pop
LEFT JOIN (
       SELECT DISTINCT "facility_sub_region_2_code" AS "county_fips"
       FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_ALL"
       WHERE  "facility_sub_region_1" = 'California'
         AND  "facility_sub_region_2_code" IS NOT NULL
     ) sites
ON  pop."county_fips" = sites."county_fips"
WHERE sites."county_fips" IS NULL
LIMIT 20;
```
