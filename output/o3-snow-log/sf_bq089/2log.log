```sql
--Description: Derive the number of vaccination sites per 1,000 residents for every
--             California county (using 2018 5-year ACS population and the two
--             vaccination-site layers that store county FIPS codes).
--             Steps:
--             1) county_pop  – aggregate block-group population (“geo_id” 1-5 = county FIPS).
--             2) all_sites   – UNION DISTINCT records from _ALL and _WALK tables
--                              (each supplies “facility_sub_region_2_code”).
--             3) county_sites – count unique facilities per county.
--             4) Final SELECT joins population with facility counts and computes
--                sites per 1,000 people.  LIMIT 20 just to sample the output.
WITH county_pop AS (
    SELECT
        SUBSTRING("geo_id", 1, 5)        AS county_fips,
        SUM("total_pop")                 AS county_pop_2018
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE "geo_id" LIKE '06%'            -- California GEOIDs start with 06
    GROUP BY SUBSTRING("geo_id", 1, 5)
),
all_sites AS (
    SELECT DISTINCT
           "facility_sub_region_2_code"  AS county_fips,
           "facility_name"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
    WHERE "facility_sub_region_1" = 'California'

    UNION

    SELECT DISTINCT
           "facility_sub_region_2_code"  AS county_fips,
           "facility_name"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_WALK
    WHERE "facility_sub_region_1" = 'California'
),
county_sites AS (
    SELECT
        county_fips,
        COUNT(DISTINCT "facility_name")  AS uniq_facility_cnt
    FROM all_sites
    GROUP BY county_fips
)
SELECT
    p.county_fips,
    p.county_pop_2018,
    s.uniq_facility_cnt,
    ROUND(s.uniq_facility_cnt / p.county_pop_2018 * 1000, 4) AS sites_per_1000_pop
FROM county_pop p
LEFT JOIN county_sites s
       ON p.county_fips = s.county_fips
ORDER BY sites_per_1000_pop DESC
LIMIT 20;
```
