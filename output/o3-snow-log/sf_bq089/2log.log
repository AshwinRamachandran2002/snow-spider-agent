```sql
--Description: 9. Combine all four layers to get a de-duplicated count of unique facility names per county.  
WITH all_sites AS (
    SELECT DISTINCT "facility_sub_region_2_code" AS county_fips,
           "facility_name"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
    WHERE "facility_sub_region_1" = 'California'
    UNION
    SELECT DISTINCT "facility_sub_region_2_code", "facility_name"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_DRIVE
    WHERE "facility_sub_region_1" = 'California'
    UNION
    SELECT DISTINCT "facility_sub_region_2_code", "facility_name"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_TRANSIT
    WHERE "facility_sub_region_1" = 'California'
    UNION
    SELECT DISTINCT "facility_sub_region_2_code", "facility_name"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_WALK
    WHERE "facility_sub_region_1" = 'California'
)
SELECT county_fips,
       COUNT(DISTINCT facility_name) AS uniq_facility_cnt
FROM all_sites
GROUP BY county_fips
LIMIT 20;
```

```sql
--Description: 10. Final query – join county population (2018 5-yr ACS) with unique facility counts to compute
--               vaccine sites per 1,000 residents for every California county.  
WITH county_pop AS (
    SELECT SUBSTRING("geo_id", 1, 5)          AS county_fips,
           SUM("total_pop")                   AS county_pop_2018
    FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE  "geo_id" LIKE '06%'                -- California only
    GROUP BY SUBSTRING("geo_id", 1, 5)
), all_sites AS (
    SELECT DISTINCT "facility_sub_region_2_code" AS county_fips,
           "facility_name"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
    WHERE "facility_sub_region_1" = 'California'
    UNION
    SELECT DISTINCT "facility_sub_region_2_code", "facility_name"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_DRIVE
    WHERE "facility_sub_region_1" = 'California'
    UNION
    SELECT DISTINCT "facility_sub_region_2_code", "facility_name"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_TRANSIT
    WHERE "facility_sub_region_1" = 'California'
    UNION
    SELECT DISTINCT "facility_sub_region_2_code", "facility_name"
    FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_WALK
    WHERE "facility_sub_region_1" = 'California'
), county_sites AS (
    SELECT county_fips,
           COUNT(DISTINCT facility_name) AS uniq_facility_cnt
    FROM all_sites
    GROUP BY county_fips
)
SELECT p.county_fips,
       p.county_pop_2018,
       s.uniq_facility_cnt,
       ROUND(s.uniq_facility_cnt / p.county_pop_2018 * 1000, 4) AS sites_per_1000_pop
FROM county_pop p
LEFT JOIN county_sites s
      ON p.county_fips = s.county_fips
ORDER BY sites_per_1000_pop DESC
LIMIT 20;
```
