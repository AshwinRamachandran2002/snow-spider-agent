```sql
--1. Description: Preview California block–group GEOIDs & population values in the 2018 5-year ACS.
SELECT 
  "geo_id",
  "total_pop"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
WHERE "geo_id" ILIKE '06%'          -- California GEOIDs start with state code 06
LIMIT 20;
```

```sql
--2. Description: Aggregate 2018 block-group population to the county-level (first 5 digits of GEOID) for California.
SELECT 
  SUBSTR("geo_id",1,5)              AS "county_fips",
  SUM("total_pop")                  AS "county_pop_2018"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
WHERE "geo_id" ILIKE '06%'          -- keep only California rows
GROUP BY SUBSTR("geo_id",1,5)
LIMIT 20;
```

```sql
--3. Description: Preview vaccination-site records in California from the “ALL” modality table.
SELECT 
  "facility_name",
  "facility_sub_region_2",          -- county name
  "facility_sub_region_2_code",     -- 5-digit county FIPS
  "facility_sub_region_1"
FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
WHERE "facility_sub_region_1" = 'California'
LIMIT 20;
```

```sql
--4. Description: Count all vaccination sites by county FIPS for California.
SELECT
  "facility_sub_region_2_code"      AS "county_fips",
  COUNT(*)                          AS "site_cnt"
FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
WHERE "facility_sub_region_1" = 'California'
GROUP BY "facility_sub_region_2_code"
LIMIT 20;
```

```sql
--5. Description: Check whether every California county appearing in the facility table
--   also exists in the 2018 ACS population result (sanity-check via DISTINCT list).
SELECT DISTINCT
  f."county_fips"
FROM (
      SELECT SUBSTR("geo_id",1,5) AS "county_fips"
      FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
      WHERE "geo_id" ILIKE '06%'
     ) p
RIGHT JOIN (
      SELECT "facility_sub_region_2_code" AS "county_fips"
      FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
      WHERE "facility_sub_region_1" = 'California'
     ) f
ON p."county_fips" = f."county_fips"
LIMIT 20;
```

```sql
--6. Description: Combine 2018 population with vaccination-site counts 
--   and compute sites per 1,000 residents for each California county.
WITH pop AS (
     SELECT 
        SUBSTR("geo_id",1,5) AS "county_fips",
        SUM("total_pop")     AS "county_pop_2018"
     FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
     WHERE "geo_id" ILIKE '06%'
     GROUP BY SUBSTR("geo_id",1,5)
),
sites AS (
     SELECT
        "facility_sub_region_2_code" AS "county_fips",
        COUNT(*)                     AS "site_cnt"
     FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
     WHERE "facility_sub_region_1" = 'California'
     GROUP BY "facility_sub_region_2_code"
)
SELECT 
   p."county_fips",
   p."county_pop_2018",
   s."site_cnt",
   (s."site_cnt" * 1000.0) / p."county_pop_2018"  AS "sites_per_1000"
FROM pop p
JOIN sites s
  ON p."county_fips" = s."county_fips"
LIMIT 20;
```

```sql
--7. Description: Produce the full list (no LIMIT) of California counties 
--   with vaccination-site density (sites per 1,000 people) ordered from highest to lowest.
WITH pop AS (
     SELECT 
        SUBSTR("geo_id",1,5) AS "county_fips",
        SUM("total_pop")     AS "county_pop_2018"
     FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
     WHERE "geo_id" ILIKE '06%'
     GROUP BY SUBSTR("geo_id",1,5)
),
sites AS (
     SELECT
        "facility_sub_region_2_code" AS "county_fips",
        COUNT(*)                     AS "site_cnt"
     FROM COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
     WHERE "facility_sub_region_1" = 'California'
     GROUP BY "facility_sub_region_2_code"
)
SELECT 
   p."county_fips",
   p."county_pop_2018",
   s."site_cnt",
   (s."site_cnt" * 1000.0) / p."county_pop_2018"  AS "sites_per_1000"
FROM pop p
JOIN sites s
  ON p."county_fips" = s."county_fips"
ORDER BY "sites_per_1000" DESC;
```

