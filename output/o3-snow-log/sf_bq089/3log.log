-- 8) Description:  Combine the four accessibility layers to get total unique site counts per county (using UNION ALL then re-aggregating).  
WITH all_sites AS (
    SELECT "facility_sub_region_2_code" AS "county_fips"
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_ALL"
    WHERE  "facility_sub_region_1" = 'California'
    UNION ALL
    SELECT "facility_sub_region_2_code"
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_WALK"
    WHERE  "facility_sub_region_1" = 'California'
    UNION ALL
    SELECT "facility_sub_region_2_code"
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_DRIVE"
    WHERE  "facility_sub_region_1" = 'California'
    UNION ALL
    SELECT "facility_sub_region_2"                -- TRANSIT table stores FIPS in the name column
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_TRANSIT"
    WHERE  "facility_sub_region_1" = 'California'
)
SELECT "county_fips",
       COUNT(*) AS "facility_total"               -- counts duplicated sites if they appear in several layers
FROM   all_sites
GROUP  BY 1
ORDER  BY "facility_total" DESC
LIMIT  20;
