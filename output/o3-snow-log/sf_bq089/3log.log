-- 9) Description:  Join county-level population (2018 ACS) with facility totals to compute sites per 1,000 residents.  
WITH pop AS (
    SELECT SUBSTR("geo_id",1,5)  AS "county_fips",
           SUM("total_pop")      AS "county_population"
    FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
    WHERE  "geo_id" ILIKE '06%'
