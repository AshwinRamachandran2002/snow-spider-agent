```sql
-- 8) Description:  Combine the four accessibility layers to get total unique site counts per county (using UNION ALL then re-aggregating).  
WITH all_sites AS (
    SELECT "facility_sub_region_2_code" AS "county_fips"
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_ALL"
    WHERE  "facility_sub_region_1" = 'California'
    UNION ALL
    SELECT "facility_sub_region_2_code"
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_WALK"
    WHERE  "facility_sub_region_1" = 'California'
    UNION ALL
    SELECT "facility_sub_region_2_code"
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_DRIVE"
    WHERE  "facility_sub_region_1" = 'California'
    UNION ALL
    SELECT "facility_sub_region_2"                -- TRANSIT table stores FIPS in the name column
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_TRANSIT"
    WHERE  "facility_sub_region_1" = 'California'
)
SELECT "county_fips",
       COUNT(*) AS "facility_total"               -- counts duplicated sites if they appear in several layers
FROM   all_sites
GROUP  BY 1
ORDER  BY "facility_total" DESC
LIMIT  20;
```

```sql
-- 9) Description:  Join county-level population (2018 ACS) with facility totals to compute sites per 1,000 residents.  
WITH pop AS (
    SELECT SUBSTR("geo_id",1,5)  AS "county_fips",
           SUM("total_pop")      AS "county_population"
    FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
    WHERE  "geo_id" ILIKE '06%'
    GROUP  BY 1
), sites AS (
    SELECT "county_fips",
           COUNT(*)              AS "facility_total"
    FROM (
        SELECT "facility_sub_region_2_code" AS "county_fips"
        FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_ALL"
        WHERE  "facility_sub_region_1" = 'California'
        UNION ALL
        SELECT "facility_sub_region_2_code"
        FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_WALK"
        WHERE  "facility_sub_region_1" = 'California'
        UNION ALL
        SELECT "facility_sub_region_2_code"
        FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_DRIVE"
        WHERE  "facility_sub_region_1" = 'California'
        UNION ALL
        SELECT "facility_sub_region_2"
        FROM   COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_TRANSIT"
        WHERE  "facility_sub_region_1" = 'California'
    )
    GROUP BY 1
)
SELECT p."county_fips",
       p."county_population",
       s."facility_total",
       (s."facility_total" / p."county_population") * 1000  AS "sites_per_1000"
FROM   pop p
LEFT   JOIN sites s
       ON p."county_fips" = s."county_fips"
ORDER  BY "sites_per_1000" DESC
LIMIT  20;
```

```sql
-- 10) Description:  Inspect a few rows where the population is large but the site-per-1000 ratio is low (potential need areas).  
WITH results AS (
    /* same CTE definitions as query #9 */
    WITH pop AS (
        SELECT SUBSTR("geo_id",1,5) AS "county_fips",
               SUM("total_pop")     AS "county_population"
        FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."BLOCKGROUP_2018_5YR"
        WHERE  "geo_id" ILIKE '06%'
        GROUP  BY 1
    ), sites AS (
        SELECT "county_fips",
               COUNT(*) AS "facility_total"
        FROM (
            SELECT "facility_sub_region_2_code" FROM COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_ALL"    WHERE "facility_sub_region_1"='California'
            UNION ALL
            SELECT "facility_sub_region_2_code" FROM COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_WALK"   WHERE "facility_sub_region_1"='California'
            UNION ALL
            SELECT "facility_sub_region_2_code" FROM COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_DRIVE"  WHERE "facility_sub_region_1"='California'
            UNION ALL
            SELECT "facility_sub_region_2"      FROM COVID19_USA.COVID19_VACCINATION_ACCESS."FACILITY_BOUNDARY_US_TRANSIT" WHERE "facility_sub_region_1"='California'
        ) GROUP BY 1
    )
    SELECT p."county_fips",
           p."county_population",
           s."facility_total",
           (s."facility_total"/p."county_population")*1000 AS "sites_per_1000"
    FROM   pop p
    LEFT   JOIN sites s ON p."county_fips"=s."county_fips"
)
SELECT *
FROM   results
WHERE  "county_population" > 500000      -- large populations
ORDER  BY "sites_per_1000" ASC
LIMIT  20;
```
