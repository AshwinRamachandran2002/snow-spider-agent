--Description / Thinking process:
-- 1. Start with ACS BLOCKGROUP_2018_5YR: every GEOID whose first two digits are ‘06’ is in California.
--    Summing TOTAL_POP by the first 5 digits (county FIPS) gives each county’s 2018 5-year ACS population.
-- 2. Vaccination-site layers (“ALL”, “WALK”, “DRIVE”, “TRANSIT”) each contain a county identifier:
--      • ALL / WALK / DRIVE  → FACILITY_SUB_REGION_2_CODE (5-digit county FIPS)
--      • TRANSIT            → FACILITY_SUB_REGION_2       (also 5-digit county FIPS for U.S. data)
--    UNION ALL the four tables, keep only California rows, and count rows per county (treat each row as a site).
-- 3. Join the site counts to the population table.  Compute: sites_per_1000 = (sites ÷ pop) × 1000.
-- 4. Return counties with >500 000 residents, ordered from fewest to most sites per 1 000, to highlight
--    where access may be comparatively sparse.
WITH county_pop AS (
    SELECT SUBSTR("geo_id",1,5)                           AS county_fips,
           SUM("total_pop")                               AS county_population
    FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.BLOCKGROUP_2018_5YR
    WHERE  "geo_id" ILIKE '06%'                           -- California
    GROUP  BY county_fips
),
all_sites AS (
    SELECT "facility_sub_region_2_code" AS county_fips
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_ALL
    WHERE  "facility_sub_region_1" = 'California'
    UNION ALL
    SELECT "facility_sub_region_2_code"
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_WALK
    WHERE  "facility_sub_region_1" = 'California'
    UNION ALL
    SELECT "facility_sub_region_2_code"
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_DRIVE
    WHERE  "facility_sub_region_1" = 'California'
    UNION ALL
    SELECT "facility_sub_region_2"
    FROM   COVID19_USA.COVID19_VACCINATION_ACCESS.FACILITY_BOUNDARY_US_TRANSIT
    WHERE  "facility_sub_region_1" = 'California'
),
site_counts AS (
    SELECT county_fips,
           COUNT(*) AS facility_total
    FROM   all_sites
    GROUP  BY county_fips
)
SELECT cp.county_fips,
       cp.county_population,
       COALESCE(sc.facility_total,0)                             AS facility_total,
       (COALESCE(sc.facility_total,0) / cp.county_population) * 1000 AS sites_per_1000
FROM   county_pop cp
LEFT JOIN site_counts sc
       ON cp.county_fips = sc.county_fips
WHERE  cp.county_population > 500000
ORDER  BY sites_per_1000 ASC
LIMIT  20;
```
