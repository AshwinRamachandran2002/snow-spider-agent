```sql
WITH base AS (  -- calculate rounded trip duration (in minutes)
    SELECT
        "fare",
        ROUND("trip_seconds" / 60.0)            AS rounded_minutes
    FROM CHICAGO.CHICAGO_TAXI_TRIPS.TAXI_TRIPS
    WHERE "trip_seconds" IS NOT NULL
),
filtered AS (    -- keep trips whose rounded duration is between 1-50 minutes
    SELECT
        "fare",
        rounded_minutes
    FROM base
    WHERE rounded_minutes BETWEEN 1 AND 50
),
with_quantile AS (   -- split into ten equal-sized groups by duration
    SELECT
        "fare",
        rounded_minutes,
        NTILE(10) OVER (ORDER BY rounded_minutes) AS quantile
    FROM filtered
),
agg AS (  -- aggregate statistics for each quantile
    SELECT
        quantile,
        MIN(rounded_minutes)                    AS min_min,
        MAX(rounded_minutes)                    AS max_min,
        COUNT(*)                                AS total_trips,
        ROUND(AVG("fare"), 2)                   AS avg_fare
    FROM with_quantile
    GROUP BY quantile
)
SELECT
    LPAD(TO_VARCHAR(min_min), 2, '0') || 'm to ' ||
    LPAD(TO_VARCHAR(max_min), 2, '0') || 'm'     AS time_range,
    total_trips,
    avg_fare
FROM agg
ORDER BY min_min;     -- chronological order of the time ranges
```
