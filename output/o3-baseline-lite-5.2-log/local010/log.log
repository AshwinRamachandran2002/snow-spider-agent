```sql
WITH
-- predefined borders of every distance band  
ranges(r) AS (
    SELECT 0 UNION ALL SELECT 1000 UNION ALL SELECT 2000 UNION ALL
    SELECT 3000 UNION ALL SELECT 4000 UNION ALL SELECT 5000 UNION ALL
    SELECT 6000
),
-- take airport coordinates and the English city name
airport_coords AS (
    SELECT
        airport_code,
        json_extract(city,'$.en')                         AS city,
        CAST(substr(coordinates,2, instr(coordinates,',')-2)           AS REAL) AS lon,
        CAST(substr(coordinates, instr(coordinates,',')+1,
                    length(coordinates)-instr(coordinates,',')-1)      AS REAL) AS lat
    FROM airports_data
),
-- build every flight together with the cities it connects
routes AS (
    SELECT
        CASE WHEN d.city < a.city THEN d.city ELSE a.city END  AS city1,
        CASE WHEN d.city < a.city THEN a.city ELSE d.city END  AS city2,
        d.lon  AS lon1, d.lat AS lat1,
        a.lon  AS lon2, a.lat AS lat2
    FROM flights f
    JOIN airport_coords d ON d.airport_code = f.departure_airport
    JOIN airport_coords a ON a.airport_code = f.arrival_airport
),
-- distance (km) of every single flight
distances AS (
    SELECT
        city1, city2,
        12742.0 * asin(
            sqrt(
                pow( sin( ((lat2-lat1)*0.017453292519943295)/2 ), 2 ) +
                cos(lat1*0.017453292519943295) *
                cos(lat2*0.017453292519943295) *
                pow( sin( ((lon2-lon1)*0.017453292519943295)/2 ), 2 )
            )
        ) AS dist_km
    FROM routes
),
-- average distance for every unordered city pair
pair_avg AS (
    SELECT city1, city2, AVG(dist_km) AS avg_dist
    FROM distances
    GROUP BY city1, city2
),
-- put every pair into its 0‑1000, 1000‑2000 … bucket
bucketed AS (
    SELECT
        CASE
            WHEN avg_dist < 1000 THEN 0
            WHEN avg_dist < 2000 THEN 1000
            WHEN avg_dist < 3000 THEN 2000
            WHEN avg_dist < 4000 THEN 3000
            WHEN avg_dist < 5000 THEN 4000
            WHEN avg_dist < 6000 THEN 5000
            ELSE 6000
        END AS r
    FROM pair_avg
),
-- how many pairs each bucket finally contains (include empty buckets)
bucket_counts AS (
    SELECT
        ranges.r,
        COALESCE(COUNT(bucketed.r),0) AS pair_count
    FROM ranges
    LEFT JOIN bucketed ON bucketed.r = ranges.r
    GROUP BY ranges.r
)
-- the answer: smallest (non‑negative) bucket size
SELECT MIN(pair_count) AS fewest_pairs
FROM bucket_counts;
```
