/* -----------------------------------------------------------------
   CPC technology areas (level‑4 CPC groups) whose German patents
   granted in December‑2016 show the highest exponential moving
   average (α = 0.1) of yearly patent‑filing counts.

   Returned columns:
        • full_title  – complete CPC title
        • cpc_group   – level‑4 CPC group symbol (e.g. F16K31/00)
        • best_year   – year in which EMA reaches its maximum
------------------------------------------------------------------*/

WITH RECURSIVE
/* 1.  German patents whose effective grant‑date falls in
       December 2016; explode their CPC codes                          */
grant_subset AS (
    SELECT
        COALESCE(NULLIF(p."grant_date",0), p."publication_date")  AS grant_date_num,
        p."filing_date"                                           AS filing_date_num,   -- yyyymmdd
        f.value:"code"::STRING                                    AS cpc_code
    FROM PATENTS.PATENTS.PUBLICATIONS  AS p,
         LATERAL FLATTEN (INPUT => p."cpc") AS f
    WHERE p."country_code" = 'DE'
      AND COALESCE(NULLIF(p."grant_date",0), p."publication_date")
          BETWEEN 20161201 AND 20161231
      AND p."filing_date" IS NOT NULL
      AND p."filing_date" > 0
),
/* 2.  Build level‑4 CPC *group* code (“…/00”) & filing year          */
group_codes AS (
    SELECT
        EXTRACT(YEAR FROM TO_DATE(filing_date_num::STRING,'YYYYMMDD')) AS filing_year,
        UPPER(
              REGEXP_REPLACE(cpc_code , '/.*' , '')   -- keep up to group digits
             ) || '/00'                                AS group_code
    FROM grant_subset
    WHERE cpc_code IS NOT NULL AND cpc_code <> ''
),
/* 3.  Annual filing counts per CPC group                              */
yearly_counts AS (
    SELECT
        group_code,
        filing_year,
        COUNT(*) AS filings
    FROM group_codes
    GROUP BY group_code, filing_year
),
/* 4.  Order years (per group) to drive recursive EMA                  */
ordered AS (
    SELECT
        group_code,
        filing_year,
        filings,
        ROW_NUMBER() OVER (PARTITION BY group_code
                           ORDER BY filing_year) AS rn
    FROM yearly_counts
),
/* 5.  Recursive EMA:  EMAₜ = 0.1·xₜ + 0.9·EMAₜ₋₁                     */
ema_calc AS (
      /* initial year for each group */
      SELECT
          group_code,
          filing_year,
          filings,
          rn,
          CAST(filings AS FLOAT) AS ema
      FROM ordered
      WHERE rn = 1

      UNION ALL

      /* subsequent years */
      SELECT
          o.group_code,
          o.filing_year,
          o.filings,
          o.rn,
          0.1 * o.filings + 0.9 * e.ema AS ema
      FROM ordered   AS o
      JOIN ema_calc  AS e
            ON o.group_code = e.group_code
           AND o.rn        = e.rn + 1
),
/* 6.  Pick the year with highest EMA for every CPC group              */
best_years AS (
    SELECT
        group_code,
        filing_year        AS best_year,
        ema,
        ROW_NUMBER() OVER (PARTITION BY group_code
                           ORDER BY ema DESC, filing_year) AS rk
    FROM ema_calc
)
/* 7.  Attach CPC definition title (level‑4) & final output            */
SELECT
    COALESCE(d."titleFull", '(title not found)') AS "full_title",
    b.group_code                                 AS "cpc_group",
    b.best_year                                  AS "best_year"
FROM best_years               AS b
JOIN PATENTS.PATENTS.CPC_DEFINITION AS d
  ON d."symbol" = b.group_code
WHERE d."level" = 4   -- ensure level‑4 CPC groups
  AND b.rk = 1        -- keep max‑EMA row per group
ORDER BY "full_title" ASC NULLS LAST, "cpc_group";
