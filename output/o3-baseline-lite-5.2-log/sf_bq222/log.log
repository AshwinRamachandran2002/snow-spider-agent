/*  -------------------------------------------------------------
    CPC groups (level 4) in Germany whose patents – granted
    during December‑2016 – show the highest exponential moving
    average (α = 0.1) of yearly patent‑filing counts.

    Output : full CPC title, CPC group symbol, year of peak EMA
-----------------------------------------------------------------*/

WITH RECURSIVE
/* --------------------------------------------------------------
   1.  Patents granted in Germany during December‑2016
       + explode their CPC codes
-----------------------------------------------------------------*/
subset AS (
    SELECT
        p."filing_date",                       -- YYYYMMDD (NUMBER)
        p."grant_date",
        f.value:"code"::STRING  AS cpc_code
    FROM PATENTS.PATENTS.PUBLICATIONS  AS p,
         LATERAL FLATTEN (INPUT => p."cpc") AS f
    WHERE p."country_code" = 'DE'
      AND p."grant_date" BETWEEN 20161201 AND 20161231
),
/* --------------------------------------------------------------
   2.  Build CPC *group* code (level‑4 → “…/00”)
-----------------------------------------------------------------*/
group_codes AS (
    SELECT
        TO_DATE("filing_date"::STRING,'YYYYMMDD')                     AS filing_dt,
        EXTRACT(YEAR FROM TO_DATE("filing_date"::STRING,'YYYYMMDD'))  AS filing_year,
        UPPER(cpc_code)                                               AS cpc_code,
        UPPER( REGEXP_REPLACE(cpc_code,'/.*','') ) || '/00'           AS group_code
    FROM subset
    WHERE cpc_code IS NOT NULL
),
/* --------------------------------------------------------------
   3.  Yearly filing counts for each CPC group
-----------------------------------------------------------------*/
yearly_counts AS (
    SELECT
        group_code,
        filing_year,
        COUNT(*) AS filings
    FROM group_codes
    GROUP BY group_code, filing_year
),
/* --------------------------------------------------------------
   4.  Order the years inside each group
-----------------------------------------------------------------*/
ordered AS (
    SELECT
        group_code,
        filing_year,
        filings,
        ROW_NUMBER() OVER (PARTITION BY group_code ORDER BY filing_year) AS rn
    FROM yearly_counts
),
/* --------------------------------------------------------------
   5.  Recursive computation of EMA  (EMAₜ = 0.1·xₜ + 0.9·EMAₜ₋₁)
-----------------------------------------------------------------*/
ema_calc AS (
      /* seed (first year per group) */
      SELECT
          group_code,
          filing_year,
          filings,
          rn,
          CAST(filings AS FLOAT) AS ema
      FROM ordered
      WHERE rn = 1

      UNION ALL

      /* recursive step */
      SELECT
          o.group_code,
          o.filing_year,
          o.filings,
          o.rn,
          0.1 * o.filings + 0.9 * e.ema  AS ema
      FROM ordered   AS o
      JOIN ema_calc  AS e
            ON o.group_code = e.group_code
           AND o.rn       = e.rn + 1
),
/* --------------------------------------------------------------
   6.  Pick the year with highest EMA inside each group
-----------------------------------------------------------------*/
best_years AS (
    SELECT
        group_code,
        filing_year                    AS best_year,
        ema,
        ROW_NUMBER() OVER (PARTITION BY group_code
                           ORDER BY ema DESC, filing_year) AS rk
    FROM ema_calc
)
/* --------------------------------------------------------------
   7.  Attach CPC full title (level‑4 definitions) & final output
-----------------------------------------------------------------*/
SELECT
    d."titleFull"        AS "full_title",
    b.group_code         AS "cpc_group",
    b.best_year          AS "best_year"
FROM best_years                  AS b
JOIN PATENTS.PATENTS.CPC_DEFINITION AS d
      ON d."symbol" = b.group_code
WHERE d."level" = 4      -- keep only level‑4 CPC groups
  AND b.rk = 1            -- max‑EMA row per group
ORDER BY d."titleFull" ASC;
```
