  JOIN UNNEST(v.call) AS c
  JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS s
    ON s.sample = c.call_set_name
  WHERE v.reference_name IN UNNEST(GENERATE_ARRAY(1,22)::ARRAY<STRING>) = FALSE -- placeholder
)
