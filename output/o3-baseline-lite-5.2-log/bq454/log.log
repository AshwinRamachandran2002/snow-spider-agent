  SELECT
    CONCAT(
      reference_name, '_',
      CAST(start AS STRING), '_',
      reference_bases, '_',
      ARRAY_TO_STRING(alternate_bases, ',')
    )                                              AS variant_id,
    s.super_population                             AS super_population,
    c.call_set_name                                AS sample
  FROM `bigquery-public-data.human_genome_variants.1000_genomes_variants` AS v
  JOIN UNNEST(v.call) AS c
  JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS s
    ON s.sample = c.call_set_name
  WHERE reference_name NOT IN ('X','Y','MT')       -- autosomes only
    AND AF >= 0.05                                 -- common variants
