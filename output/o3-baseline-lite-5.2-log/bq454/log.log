```sql
/*  Histogram of common (AF ≥ 0.05) autosomal variants per super‑population
    ----------------------------------------------------------------------
    – Only chromosomes 1‑22 are considered      (X, Y, MT excluded)
    – “Common” is defined by the overall AF column (AF ≥ 0.05)
    – A sample is counted for a variant if at least one allele is non‑reference
    – For every super population we report:
         • total number of samples in that super population
         • a constant flag (TRUE) marking that we looked at common variants
         • N  = number of samples with the variant
         • variant_count = how many distinct variants are seen in exactly N samples
*/
WITH
-- population sizes -------------------------------------------------------
super_pop_sizes AS (
  SELECT
    Super_Population              AS super_population,
    COUNT(DISTINCT Sample)        AS population_size
  FROM `spider2-public-data.1000_genomes.sample_info`
  WHERE Super_Population IS NOT NULL
  GROUP BY Super_Population
),

-- one row per (variant, sample, super_pop) where the sample carries ≥1 alt allele
variant_sample_sp AS (
  SELECT
    CONCAT(v.reference_name,'_',CAST(v.start AS STRING),'_',v.reference_bases,'_',ARRAY_TO_STRING(v.alternate_bases,',')) AS variant_id,
    s.Super_Population         AS super_population,
    c.call_set_name            AS sample
  FROM `spider2-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.call)          AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = c.call_set_name
  WHERE v.reference_name NOT IN ('X','Y','MT')     -- autosomes only
    AND v.AF >= 0.05                               -- common variants
    AND (SELECT COUNTIF(gt > 0) FROM UNNEST(c.genotype) AS gt) > 0  -- has alt
    AND s.Super_Population IS NOT NULL
),

-- count how many samples (within each super pop) carry every variant ----------
variant_sp_counts AS (
  SELECT
    super_population,
    variant_id,
    COUNT(DISTINCT sample)  AS samples_with_variant
  FROM variant_sample_sp
  GROUP BY super_population, variant_id
)

-- final histogram -------------------------------------------------------------
SELECT
  v.super_population,
  p.population_size,
  TRUE                              AS is_common_variant,
  v.samples_with_variant,           -- N
  COUNT(*)        AS variant_count  -- how many variants seen in exactly N samples
FROM variant_sp_counts AS v
JOIN super_pop_sizes  AS p
  ON p.super_population = v.super_population
GROUP BY
  v.super_population,
  p.population_size,
  is_common_variant,
  v.samples_with_variant
ORDER BY
  v.super_population,
  v.samples_with_variant;
```
