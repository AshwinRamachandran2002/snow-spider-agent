/*  Histogram of common (AF ≥ 0.05) autosomal variants per super‑population
    using public dataset bigquery-public-data.human_genome_variants
    -----------------------------------------------------------------------
    • Autosomes only (chromosomes 1‑22)
    • “Common” = overall allele‑frequency (info.AF[0]) ≥ 0.05
    • A sample is counted for a variant if its genotype contains ≥1 ALT allele
*/

WITH --------------------------------------------------------------------------
-- total number of samples in every super‑population --------------------------
super_pop_sizes AS (
  SELECT
    super_population,
    COUNT(DISTINCT sample) AS population_size
  FROM `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`
  WHERE super_population IS NOT NULL
  GROUP BY super_population
),

-- one row per (variant, sample, super_pop) where the sample carries ≥1 ALT ----
variant_sample_sp AS (
  SELECT
    CONCAT(
      reference_name, '_',
      CAST(start_position AS STRING), '_',
      reference_bases, '_',
      ARRAY_TO_STRING(alternate_bases, ',')
    )                           AS variant_id,
    s.super_population          AS super_population,
    c.call_set_name             AS sample
