Table full name: bigquery-public-data.libraries_io.dependencies
Column name: id Type: INT64 Description: The unique primary key of the dependency in the Libraries.io database.
Column name: platform Type: STRING Description: The name of the Package manager the dependency is available on.
Column name: project_name Type: STRING Description: The name of the project the dependency belongs to.
Column name: project_id Type: INT64 Description: The unique primary key of the project for this dependency in the Libraries.io database.
Column name: version_number Type: STRING Description: The number of the version that the dependency belongs to.
Column name: version_id Type: INT64 Description: The unique primary key of the version for this dependency in the Libraries.io database.
Column name: dependency_name Type: STRING Description: The name of the project that the dependency specifies.
Column name: dependency_platform Type: STRING Description: The name of the package manager that the project that the dependency specifies is available from (only different for Atom).
Column name: dependency_kind Type: STRING Description: The type of dependency, often declared for the phase of usage, e.g. runtime, test, development, build.
Column name: optional_dependency Type: STRING Description: Is the dependency optional?.
Column name: dependency_requirements Type: STRING Description: The version or range of versions that the dependency specifies, resolution of that to a particular version is package manager specific.
Column name: dependency_project_id Type: INT64 Description: The unique primary key of the project for this dependency in the Libraries.io database.
Sample rows:
[{'id': 63688894, 'platform': 'Packagist', 'project_name': 'jackshadow/yii2-sentry', 'project_id': 2499997, 'version_number': '1.0.1', 'version_id': 10963540, 'dependency_name': 'codeception/verify', 'dependency_platform': 'Packagist', 'dependency_kind': 'Development', 'optional_dependency': 'false', 'dependency_requirements': ' *', 'dependency_project_id': 48204}, {'id': 93706523, 'platform': 'Packagist', 'project_name': 'immediate/im-fabric-wordpress', 'project_id': 3261980, 'version_number': '1.2.3', 'version_id': 15670669, 'dependency_name': '10up/wp_mock', 'dependency_platform': 'Packagist', 'dependency_kind': 'Development', 'optional_dependency': 'false', 'dependency_requirements': ' 0.3.0', 'dependency_project_id': 37460}, {'id': 88984643, 'platform': 'NPM', 'project_name': 'react-hig-datepicker', 'project_id': 3196162, 'version_number': '0.1.3-h', 'version_id': 15150299, 'dependency_name': 'react', 'dependency_platform': 'NPM', 'dependency_kind': 'runtime', 'optional_dependency': 'false', 'dependency_requirements': ' ^15.4.1', 'dependency_project_id': 304875}, {'id': 70881952, 'platform': 'NPM', 'project_name': '@machinemode/cryptopia', 'project_id': 2619549, 'version_number': '0.1.0', 'version_id': 11984358, 'dependency_name': 'dotenv', 'dependency_platform': 'NPM', 'dependency_kind': 'Development', 'optional_dependency': 'false', 'dependency_requirements': ' ^4.0.0', 'dependency_project_id': 142776}, {'id': 85289846, 'platform': 'Maven', 'project_name': 'de.taimos:dvalin-interconnect-core', 'project_id': 2673189, 'version_number': '1.20', 'version_id': 12274677, 'dependency_name': 'org.apache.activemq:activemq-client', 'dependency_platform': 'Maven', 'dependency_kind': 'runtime', 'optional_dependency': 'false', 'dependency_requirements': '${activemq.version}', 'dependency_project_id': 359766}]

