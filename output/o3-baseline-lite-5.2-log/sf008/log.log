Table full name: US_REAL_ESTATE.CYBERSYN.IRS_INDIVIDUAL_INCOME_ATTRIBUTES
Column name: VARIABLE_NAME Type: TEXT Description: Human-readable name for the variable
Column name: SEASONALLY_ADJUSTED Type: BOOLEAN Description: Indicates whether the value is seasonally adjusted
Column name: INCOME_BRACKET Type: TEXT Description: The adjusted gross income bracket of individuals within the series
Column name: UNIT Type: TEXT Description: Unit of measure for the value (e.g., USD, returns, individuals, dependents)
Column name: FREQUENCY Type: TEXT Description: Frequency of the variable measurement
Column name: VARIABLE Type: TEXT Description: Unique identifier for a variable joinable to the timeseries table
Sample rows:
[{'VARIABLE': 'Total_income_-_Number_of_returns,_AGI_bin:_$100,000_under_$200,000', 'VARIABLE_NAME': 'Total income - Number of returns, AGI bin: $100,000 under $200,000', 'INCOME_BRACKET': '$100,000 under $200,000', 'UNIT': 'Returns', 'SEASONALLY_ADJUSTED': False, 'FREQUENCY': 'Annual'}, {'VARIABLE': 'Investment_interest_paid_-_Amount,_AGI_bin:_$200,000_or_more', 'VARIABLE_NAME': 'Investment interest paid - Amount, AGI bin: $200,000 or more', 'INCOME_BRACKET': '$200,000 or more', 'UNIT': 'USD', 'SEASONALLY_ADJUSTED': False, 'FREQUENCY': 'Annual'}, {'VARIABLE': 'Personal_property_taxes_-_Number_of_returns,_AGI_bin:_$25,000_under_$50,000', 'VARIABLE_NAME': 'Personal property taxes - Number of returns, AGI bin: $25,000 under $50,000', 'INCOME_BRACKET': '$25,000 under $50,000', 'UNIT': 'Returns', 'SEASONALLY_ADJUSTED': False, 'FREQUENCY': 'Annual'}, {'VARIABLE': 'Economic_impact_payment_second_round_[15,_17]_-_Amount,_AGI_bin:_$200,000_or_more', 'VARIABLE_NAME': 'Economic impact payment second round [15, 17] - Amount, AGI bin: $200,000 or more', 'INCOME_BRACKET': '$200,000 or more', 'UNIT': 'USD', 'SEASONALLY_ADJUSTED': False, 'FREQUENCY': 'Annual'}, {'VARIABLE': 'Domestic_production_activities_deduction_-_Number_of_returns,_AGI_bin:_$75,000_under_$100,000', 'VARIABLE_NAME': 'Domestic production activities deduction - Number of returns, AGI bin: $75,000 under $100,000', 'INCOME_BRACKET': '$75,000 under $100,000', 'UNIT': 'Returns', 'SEASONALLY_ADJUSTED': False, 'FREQUENCY': 'Annual'}]

