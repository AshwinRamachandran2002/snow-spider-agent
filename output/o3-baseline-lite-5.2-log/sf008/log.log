Sample rows:
[{'TABLE_NAME': 'company_relationships_history', 'TABLE_NAME_PROPER': 'Company Relationships Point in Time History', 'TABLE_TYPE': 'point-in-time history', 'LISTING_URL': '[\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX66"\n]', 'LISTING_NAME': '[\n  "Financials & Economics: Enterprise "\n]', 'DATA_SOURCE': '[\n  "PermID",\n  "US Securities & Exchange Commission (SEC)",\n  "Global Legal Entity Identifier Foundation (GLEIF)"\n]', 'DESCRIPTION': 'Tracks history of the company_relationships table with start and end timestamps to indicate row validity periods. \n\nCurrent rows have a NULL end timestamp. Updated and deleted rows are time-stamped, including deletion time, in Eastern Time with UTC offset.', 'ENTITIES': '[\n  "company_id",\n  "related_company_id"\n]', 'SELECT_RELATED_TABLES': '[\n  "company_relationships"\n]', 'DATA_SOURCE_URL': '[\n  "https://permid.org/",\n  "https://www.sec.gov/edgar/search-and-access",\n  "https://www.gleif.org/"\n]', 'LICENSE_URL': '[\n  "https://permid.org/terms",\n  "https://creativecommons.org/licenses/by/4.0/",\n  "https://www.sec.gov/privacy#security",\n  "https://www.gleif.org/en/meta/terms"\n]', 'CREATED_DATE': '2024-03-21', 'LAST_UPDATED_TIMESTAMP': '2024-08-24 10:08:57.631000+00:00', 'DOCUMENTATION_URL': None, 'SHORT_DESCRIPTION': None}, {'TABLE_NAME': 'consumer_spending_essentials_merchant_platform_timeseries', 'TABLE_NAME_PROPER': 'Consumer Spending Essentials - Merchant Platform Timeseries', 'TABLE_TYPE': 'timeseries', 'LISTING_URL': '[\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX3R"\n]', 'LISTING_NAME': '[\n  "Consumer Spending Essentials"\n]', 'DATA_SOURCE': '[\n  "Consumer Spending Aggregator"\n]', 'DESCRIPTION': 'The Consumer Spending Foundation includes projected consumer spending activity nationally in the United States. The card panel is made up of data from nearly 100M credit and debit cards from a number of banks and financial institutions. The data is aggregated and normalized to create a representative panel of activity in the US consumer economy.\n\nProvides historical values for spend across merchants through different platforms, e.g. McDonald\'s sales through DoorDash, with breakdowns by demographics (age and income level), purchase channels (online vs. offline) and consumer or merchant location. Geographic estimates range from national estimates for the entire US and go as granular as Core Based Statistical Areas ("CBSAs").\n\nEach row represents a distinct timeseries, date, and value.', 'ENTITIES': None, 'SELECT_RELATED_TABLES': '[\n  "geography_index",\n  "geography_relationships",\n  "calendar_index",\n  "merchant_company_relationships"\n]', 'DATA_SOURCE_URL': None, 'LICENSE_URL': None, 'CREATED_DATE': '2024-07-02', 'LAST_UPDATED_TIMESTAMP': '2024-08-28 01:39:02.112000+00:00', 'DOCUMENTATION_URL': None, 'SHORT_DESCRIPTION': None}, {'TABLE_NAME': 'federal_reserve_attributes', 'TABLE_NAME_PROPER': 'Federal Reserve Attributes', 'TABLE_TYPE': 'attributes', 'LISTING_URL': '[\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KGK",\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX66"\n]', 'LISTING_NAME': '[\n  "Global Government",\n  "Financials & Economics: Enterprise "\n]', 'DATA_SOURCE': '[\n  "Federal Reserve"\n]', 'DESCRIPTION': 'Borrowing patterns, credit card debt, commercial paper, finance companies, industrial production, capacity utilization, assets, liabilities, and net worth in the US, provided by the Fed.\n\nThe Federal Reserve, often referred to as the Fed, is the central banking system of the US. The data details (1) Consumer Credit - borrowing patterns, credit card debt, and other forms of consumer loans, (2) Commercial Paper - a short-term debt instrument used by corporations for financing, (3) health and activity of Finance Companies, (4) Industrial Production and Capacity Utilization of the manufacturing sector, and (5) US Financial Accounts - assets, liabilities, and net worth.\n\nProvides a wide format breakdown of variables included in the federal_reserve_timeseries table.', 'ENTITIES': None, 'SELECT_RELATED_TABLES': '[\n  "federal_reserve_timeseries"\n]', 'DATA_SOURCE_URL': '[\n  "https://www.federalreserve.gov/data.htm"\n]', 'LICENSE_URL': '[\n  "https://www.federalreserve.gov/disclaimer.htm"\n]', 'CREATED_DATE': '2024-01-08', 'LAST_UPDATED_TIMESTAMP': '2024-08-16 13:16:14.329000+00:00', 'DOCUMENTATION_URL': 'https://docs.cybersyn.com/public-domain-sources/us-federal-reserve', 'SHORT_DESCRIPTION': 'Borrowing patterns, credit card debt, commercial paper, finance companies, industrial production, capacity utilization, assets, liabilities, and net worth in the US, provided by the Fed.'}, {'TABLE_NAME': 'federal_reserve_timeseries', 'TABLE_NAME_PROPER': 'Federal Reserve Timeseries', 'TABLE_TYPE': 'timeseries', 'LISTING_URL': '[\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KGK",\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX66"\n]', 'LISTING_NAME': '[\n  "Global Government",\n  "Financials & Economics: Enterprise "\n]', 'DATA_SOURCE': '[\n  "Federal Reserve"\n]', 'DESCRIPTION': 'Borrowing patterns, credit card debt, commercial paper, finance companies, industrial production, capacity utilization, assets, liabilities, and net worth in the US, provided by the Fed.\n\nThe Federal Reserve, often referred to as the Fed, is the central banking system of the US. The data details (1) Consumer Credit - borrowing patterns, credit card debt, and other forms of consumer loans, (2) Commercial Paper - a short-term debt instrument used by corporations for financing, (3) health and activity of Finance Companies, (4) Industrial Production and Capacity Utilization of the manufacturing sector, and (5) US Financial Accounts - assets, liabilities, and net worth.\n\nProvides historical values for each variable collected.\n\nEach row represents a distinct timeseries, date, and value by geographic entity. Each variable is detailed in the federal_reserve_attributes table.', 'ENTITIES': '[\n  "geo_id"\n]', 'SELECT_RELATED_TABLES': '[\n  "federal_reserve_attributes",\n  "geography_index"\n]', 'DATA_SOURCE_URL': '[\n  "https://www.federalreserve.gov/data.htm"\n]', 'LICENSE_URL': '[\n  "https://www.federalreserve.gov/disclaimer.htm"\n]', 'CREATED_DATE': '2024-01-08', 'LAST_UPDATED_TIMESTAMP': '2024-08-16 13:16:15.634000+00:00', 'DOCUMENTATION_URL': 'https://docs.cybersyn.com/public-domain-sources/us-federal-reserve', 'SHORT_DESCRIPTION': 'Borrowing patterns, credit card debt, commercial paper, finance companies, industrial production, capacity utilization, assets, liabilities, and net worth in the US, provided by the Fed.'}, {'TABLE_NAME': 'fhfa_house_price_timeseries', 'TABLE_NAME_PROPER': 'FHFA House Price Index Timeseries', 'TABLE_TYPE': 'timeseries', 'LISTING_URL': '[\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KF7",\n  "https://app.snowflake.com/marketplace/listing/GZTSZAS2KI6",\n  "https://app.snowflake.com/marketplace/listing/GZTSZ290BUX66"\n]', 'LISTING_NAME': '[\n  "Finance & Economics",\n  "US Real Estate",\n  "Financials & Economics: Enterprise "\n]', 'DATA_SOURCE': '[\n  "Federal Housing Finance Agency (FHFA)"\n]', 'DESCRIPTION': 'House price indexes measuring single-family home price changes in the US since 1975, across various geographic levels and property classifications, provided from the FHFA based on Fannie Mae and Freddie Mac mortgage data.\n\nThe Federal Housing Finance Agency (FHFA) provides the House Price Index (HPI), a collection of publicly available price indexes that measure movement of single-family house prices in the US since 1975. The FHFA compiles this data by examining repeat mortgage transactions on single-family properties whose mortgages have been purchased or securitized by Fannie Mae or Freddie Mac, across various geographic levels.\n\nProvides historical values for each variable collected by the FHFA HPI by GEO_ID.\n\nEach row represents a distinct timeseries, date, and value by geographic entity. Each variable is detailed in the fhfa_house_price_attributes table.', 'ENTITIES': '[\n  "geo_id"\n]', 'SELECT_RELATED_TABLES': '[\n  "fhfa_house_price_attributes",\n  "geography_index"\n]', 'DATA_SOURCE_URL': '[\n  "https://www.fhfa.gov/DataTools"\n]', 'LICENSE_URL': '[\n  "https://www.fhfa.gov/AboutUs/Policies/Pages/Website-Social-Media-Policies.aspx"\n]', 'CREATED_DATE': '2023-01-05', 'LAST_UPDATED_TIMESTAMP': '2024-08-27 14:03:20.088000+00:00', 'DOCUMENTATION_URL': 'https://docs.cybersyn.com/public-domain-sources/fhfa', 'SHORT_DESCRIPTION': 'House price indexes measuring single-family home price changes in the US since 1975, across various geographic levels and property classifications, provided from the FHFA based on Fannie Mae and Freddie Mac mortgage data.'}]

