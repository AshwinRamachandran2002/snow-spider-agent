Column name: DATE Type: DATE Description: Date associated with the value, for gross migration data it is the last day of the second year being reported
Column name: VALUE Type: NUMBER Description: The actual numeric value for the variable
Column name: GEO_ID Type: TEXT Description: A unique identifier for a place (state, county, zipcode) joinable to the geography_index/relationships tables
Sample rows:
[{'GEO_ID': 'geoId/24', 'VARIABLE': 'Outflow_Returns_-_number_of_returns,_primary_taxpayers_ages_35_under_45,_All_AGI_classes', 'VARIABLE_NAME': 'Outflow Returns - number of returns, primary taxpayers ages 35 under 45, All AGI classes', 'DATE': '2022-12-31', 'VALUE': 17022, 'UNIT': 'Returns'}, {'GEO_ID': 'geoId/02', 'VARIABLE': 'Outflow_Returns_–_adjusted_gross_income_from_Year_2,_primary_taxpayers_ages_26_under_35,_AGI_bin:_$50,000_under_$75,000', 'VARIABLE_NAME': 'Outflow Returns – adjusted gross income from Year 2, primary taxpayers ages 26 under 35, AGI bin: $50,000 under $75,000', 'DATE': '2014-12-31', 'VALUE': 61403000, 'UNIT': 'USD'}, {'GEO_ID': 'geoId/35', 'VARIABLE': 'Total_Returns_-_number_of_returns,_primary_taxpayers_ages_26_under,_All_AGI_classes', 'VARIABLE_NAME': 'Total Returns - number of returns, primary taxpayers ages 26 under, All AGI classes', 'DATE': '2019-12-31', 'VALUE': 141322, 'UNIT': 'Returns'}, {'GEO_ID': 'geoId/26', 'VARIABLE': 'Same_State_Returns_–_number_of_individuals,_primary_taxpayers_ages_45_under_55,_AGI_bin:_$25,000_under_$50,000', 'VARIABLE_NAME': 'Same State Returns – number of individuals, primary taxpayers ages 45 under 55, AGI bin: $25,000 under $50,000', 'DATE': '2018-12-31', 'VALUE': 8097, 'UNIT': 'Individuals'}, {'GEO_ID': 'geoId/47', 'VARIABLE': 'Inflow_Returns_–_adjusted_gross_income_from_Year_2,_primary_taxpayers_ages_26_under_35,_AGI_bin:_$50,000_under_$75,000', 'VARIABLE_NAME': 'Inflow Returns – adjusted gross income from Year 2, primary taxpayers ages 26 under 35, AGI bin: $50,000 under $75,000', 'DATE': '2019-12-31', 'VALUE': 296221000, 'UNIT': 'USD'}]

