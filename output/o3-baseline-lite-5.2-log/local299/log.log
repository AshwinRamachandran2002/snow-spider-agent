```sql
/* 1. Work out each customer's daily net change                  */
WITH daily_txn AS (     
  SELECT
        customer_id,
        DATE(txn_date)                              AS txn_date,
        SUM(CASE WHEN txn_type = 'deposit'
                 THEN  txn_amount                  /* deposits add  */
                 ELSE -txn_amount                  /* anything else subtracts */
            END)                                   AS net_change
  FROM   customer_transactions
  GROUP  BY customer_id,
           DATE(txn_date)
),

/* 2. Cumulative running balance per customer                    */
running_balance AS (      
  SELECT
        customer_id,
        txn_date,
        SUM(net_change) 
          OVER (PARTITION BY customer_id
                ORDER BY        txn_date)          AS balance
  FROM   daily_txn
),

/* 3. Add helpers: row‑number & 30‑day rolling average balance   */
balance_metrics AS (      
  SELECT
        customer_id,
        txn_date,
        balance,
        ROW_NUMBER() OVER (PARTITION BY customer_id
                           ORDER BY txn_date)      AS rn,
        AVG(balance) OVER (PARTITION BY customer_id
                           ORDER BY txn_date
                           ROWS BETWEEN 29 PRECEDING AND CURRENT ROW) AS avg30
  FROM   running_balance
),

/* 4. Keep averages only after 30 days and floor negatives to 0  */
valid_avg AS (      
  SELECT
        customer_id,
        txn_date,
        CASE WHEN rn >= 30
             THEN CASE WHEN avg30 < 0 THEN 0 ELSE avg30 END
             ELSE NULL
        END                                        AS avg_30_bal
  FROM   balance_metrics
  WHERE  rn >= 30                                  -- ensures 30 days present
),

/* 5. Identify each customer’s first (baseline) month            */
baseline_month AS (      
  SELECT customer_id,
         STRFTIME('%Y-%m', MIN(DATE(txn_date)))    AS base_month
  FROM   customer_transactions
  GROUP  BY customer_id
),

/* 6. For every customer‑month, take the maximum 30‑day average   */
cust_monthly_max AS (      
  SELECT  v.customer_id,
          STRFTIME('%Y-%m', v.txn_date)            AS month_year,
          MAX(v.avg_30_bal)                        AS max_30_avg
  FROM    valid_avg   v
  JOIN    baseline_month b
         ON v.customer_id = b.customer_id
  WHERE   STRFTIME('%Y-%m', v.txn_date) <> b.base_month   -- drop baseline month
  GROUP   BY v.customer_id,
           month_year
),

/* 7. Sum those maxima across all customers per month            */
monthly_totals AS (      
  SELECT  month_year,
          ROUND(SUM(max_30_avg), 4)                AS total_max_30day_avg_balance
  FROM    cust_monthly_max
  GROUP   BY month_year
)

/* 8. Final output                                               */
SELECT month_year,
       total_max_30day_avg_balance
FROM   monthly_totals
ORDER  BY month_year;
```
