```sql
WITH abakan_airports AS (
    /* code(s) of the airport(s) that serve Abakan city */
    SELECT airport_code
    FROM airports_data
    WHERE json_extract(city,'$.en') = 'Abakan'
),
abakan_flights AS (
    /* every flight that either departs from, or arrives at, Abakan */
    SELECT flight_id,
           departure_airport,
           arrival_airport
    FROM flights
    WHERE departure_airport IN (SELECT airport_code FROM abakan_airports)
       OR arrival_airport   IN (SELECT airport_code FROM abakan_airports)
),
coords AS (
    /* grab coordinates (kept as text like “(lon,lat)”) for both ends of every Abakan flight */
    SELECT f.flight_id,
           d.coordinates AS dep_coord,
           a.coordinates AS arr_coord
    FROM abakan_flights f
    JOIN airports_data d ON d.airport_code = f.departure_airport
    JOIN airports_data a ON a.airport_code = f.arrival_airport
),
parsed AS (
    /* convert the coordinate strings into numeric longitude / latitude values               */
    /* the point literal is “(lon,lat)”, so lon starts at 2, lat begins right after “,”      */
    SELECT
        flight_id,
        CAST(substr(dep_coord,2,instr(dep_coord,',')-2) AS REAL)                                  AS dep_lon,
        CAST(substr(dep_coord,instr(dep_coord,',')+1,
                    instr(dep_coord,')')-instr(dep_coord,',')-1) AS REAL)                         AS dep_lat,
        CAST(substr(arr_coord,2,instr(arr_coord,',')-2) AS REAL)                                  AS arr_lon,
        CAST(substr(arr_coord,instr(arr_coord,',')+1,
                    instr(arr_coord,')')-instr(arr_coord,',')-1) AS REAL)                         AS arr_lat
    FROM coords
),
rad AS (
    /* convert degrees to radians (needed by the haversine formula) */
    SELECT
        flight_id,
        dep_lat*3.141592653589793/180.0 AS dep_lat_rad,
        dep_lon*3.141592653589793/180.0 AS dep_lon_rad,
        arr_lat*3.141592653589793/180.0 AS arr_lat_rad,
        arr_lon*3.141592653589793/180.0 AS arr_lon_rad
    FROM parsed
),
haversine_a AS (
    /* “a” part of the haversine formula                                                */
    /* a = sin²(Δφ/2)+cos φ₁·cos φ₂·sin²(Δλ/2)                                          */
    SELECT
        flight_id,
        (sin((arr_lat_rad - dep_lat_rad)/2.0) * sin((arr_lat_rad - dep_lat_rad)/2.0))
        +
        (cos(dep_lat_rad) * cos(arr_lat_rad) *
         sin((arr_lon_rad - dep_lon_rad)/2.0) * sin((arr_lon_rad - dep_lon_rad)/2.0)
        ) AS a_val
    FROM rad
),
/* ---------------------------------------------------------------------- */
/* SQLite in this environment does not have the built‑in SQRT function.   */
/* We obtain the square root with Newton‑Raphson iterations inside a      */
/* recursive CTE.  Fifteen iterations are more than enough for double‑    */
/* precision accuracy.                                                    */
/* ---------------------------------------------------------------------- */
sqrt_iter AS (
    SELECT flight_id,
           a_val                         AS val,          /* the number whose sqrt is needed */
           a_val/2.0                     AS guess,        /* initial guess                    */
           0                             AS step
    FROM haversine_a
    UNION ALL
    SELECT flight_id,
           val,
           (guess + val/guess)/2.0       AS guess,
           step + 1
    FROM sqrt_iter
    WHERE step < 15                      -- 15 iterations → convergence
),
sqrt_done AS (
    SELECT flight_id, guess AS root
    FROM sqrt_iter
    WHERE step = 15
),
distances AS (
    /* great‑circle distance (Earth radius = 6 371 km) */
    SELECT
        h.flight_id,
        6371.0 * 2.0 * asin(s.root) AS distance_km
    FROM haversine_a h
    JOIN sqrt_done   s USING (flight_id)
)
SELECT ROUND(MAX(distance_km),4) AS longest_distance_km
FROM distances;
```
