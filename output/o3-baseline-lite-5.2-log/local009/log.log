diffs AS (                         --------------------------------------------
    /* differences (in degrees) and mean latitude                              */
    SELECT flight_id,
           arr_lat - dep_lat                         AS d_lat,
           arr_lon - dep_lon                         AS d_lon,
           (arr_lat + dep_lat) / 2.0                 AS mean_lat
    FROM parsed
),
cos_part AS (                      --------------------------------------------
    /* approximate cos(mean_lat) with a 4‑term Maclaurin polynomial            */
    /* mean_lat is first turned into radians                                   */
    SELECT flight_id,
           d_lat,
           d_lon,
           -- convert mean latitude to radians
           mean_lat * 3.141592653589793 / 180.0       AS mean_lat_rad
    FROM diffs
),
cos_approx AS (
    SELECT flight_id,
           d_lat,
           d_lon,
           -- x = mean_lat_rad,  x2 = x²
           1.0 
           - (mean_lat_rad*mean_lat_rad)/2.0
           + (mean_lat_rad*mean_lat_rad*mean_lat_rad*mean_lat_rad)/24.0
           - (mean_lat_rad*mean_lat_rad*mean_lat_rad*mean_lat_rad
              *mean_lat_rad*mean_lat_rad)/720.0
           + (mean_lat_rad*mean_lat_rad*mean_lat_rad*mean_lat_rad
              *mean_lat_rad*mean_lat_rad*mean_lat_rad*mean_lat_rad)/40320.0
           AS cos_mean_lat
    FROM cos_part
),
plane_len_sq AS (                  --------------------------------------------
    /* squared planar distance in degree units                                 */
    SELECT flight_id,
           d_lat*d_lat + (cos_mean_lat * d_lon)*(cos_mean_lat * d_lon) AS deg_sq
    FROM cos_approx
),
/*--------------------------------------------------------------------*/
/*  Square root by Newton‑Raphson (SQLite lacks an intrinsic SQRT)    */
/*--------------------------------------------------------------------*/
sqrt_iter AS (
    SELECT flight_id,
           deg_sq                       AS val,
           CASE WHEN deg_sq>0 THEN deg_sq/2.0 ELSE 1 END  AS guess,
           0                              AS step
    FROM plane_len_sq
    UNION ALL
    SELECT flight_id,
           val,
           (guess + val/guess)/2.0       AS guess,
           step + 1
    FROM sqrt_iter
    WHERE step < 15                      -- enough iterations for double precision
),
sqrt_done AS (
    SELECT flight_id,
           guess AS deg_distance         -- distance in degrees
    FROM sqrt_iter
    WHERE step = 15
),
distances AS (                     --------------------------------------------
    /* convert degrees to kilometres (≈111.2 km per 1°)                        */
    SELECT flight_id,
           111.2 * deg_distance AS distance_km
    FROM sqrt_done
)
SELECT ROUND(MAX(distance_km),4) AS longest_distance_km
FROM distances;
