--  Detect chromosome‑12 variants whose Yates‑corrected χ² statistic
--  (EAS vs non‑EAS) is ≥ 29.71679 and whose four expected counts are ≥ 5
WITH sample_map AS (
  SELECT
    sample AS call_set_name,
    super_population
  FROM `genomics-public-data.1000_genomes.sample_info`
),

-- Count reference and alternate alleles per variant and population group
variant_counts AS (
  SELECT
    v.start_position AS start_pos,
    v.end_position   AS end_pos,
    IF(sm.super_population = 'EAS', 'EAS', 'OTHERS') AS grp,
    SUM(CASE WHEN allele > 0 THEN 1 ELSE 0 END) AS alt_cnt,
    SUM(CASE WHEN allele = 0 THEN 1 ELSE 0 END) AS ref_cnt
  FROM `genomics-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call)            AS c
  LEFT  JOIN sample_map                AS sm
         ON sm.call_set_name = c.call_set_name
  CROSS JOIN UNNEST(c.genotype)        AS allele
  WHERE v.reference_name = '12'           -- chromosome 12 only
    AND allele != -1                      -- ignore missing alleles
  GROUP BY start_pos, end_pos, grp
),

-- Build 2×2 contingency table per variant
per_variant AS (
  SELECT
    start_pos,
    end_pos,
    SUM(IF(grp = 'EAS',    alt_cnt, 0)) AS A,  -- cases alt
    SUM(IF(grp = 'EAS',    ref_cnt, 0)) AS B,  -- cases ref
    SUM(IF(grp = 'OTHERS', alt_cnt, 0)) AS C,  -- controls alt
    SUM(IF(grp = 'OTHERS', ref_cnt, 0)) AS D   -- controls ref
  FROM variant_counts
  GROUP BY start_pos, end_pos
),

-- Compute expected counts and Yates‑corrected χ² statistic
stats AS (
  SELECT
    start_pos,
    end_pos,
    A, B, C, D,
    (A + B + C + D)                                           AS N,
    ((A + B) * (A + C)) / (A + B + C + D)                     AS E_A,
    ((A + B) * (B + D)) / (A + B + C + D)                     AS E_B,
    ((C + D) * (A + C)) / (A + B + C + D)                     AS E_C,
    ((C + D) * (B + D)) / (A + B + C + D)                     AS E_D
  FROM per_variant
  WHERE (A + B + C + D) > 0
),

filtered AS (
  SELECT
    start_pos,
    end_pos,
    (N * POW(ABS(A * D - B * C) - (N / 2.0), 2))
      / ((A + B) * (C + D) * (A + C) * (B + D))               AS chi_sq
  FROM stats
  WHERE E_A >= 5 AND E_B >= 5 AND E_C >= 5 AND E_D >= 5
)

SELECT
  start_pos AS start_position,
  end_pos   AS end_position,
  chi_sq
FROM filtered
WHERE chi_sq >= 29.71679
ORDER BY chi_sq DESC, start_position;
