```sql
-- Identify chr12 variants whose Yates‑corrected χ² statistic (EAS vs. non‑EAS)
-- is at least 29.71679 and whose four expected counts are all ≥ 5
WITH sample_map AS (
  SELECT
    Sample AS call_set_name,
    Super_Population
  FROM `spider2-public-data.1000_genomes.sample_info`
),

-- Count reference and alternate alleles per variant and population group
variant_counts AS (
  SELECT
    v.start                                      AS start_pos,
    v.end                                        AS end_pos,
    CASE WHEN sm.Super_Population = 'EAS'
         THEN 'EAS' ELSE 'OTHERS' END            AS grp,
    SUM(CASE WHEN g > 0 THEN 1 ELSE 0 END)      AS alt_cnt,
    SUM(CASE WHEN g = 0 THEN 1 ELSE 0 END)      AS ref_cnt
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call)            AS c
  LEFT  JOIN sample_map                AS sm
         ON sm.call_set_name = c.call_set_name
  CROSS JOIN UNNEST(c.genotype)        AS g
  WHERE v.reference_name = '12'           -- chromosome 12 only
    AND g != -1                           -- ignore missing alleles
  GROUP BY start_pos, end_pos, grp
),

-- Build 2×2 contingency table per variant
per_variant AS (
  SELECT
    start_pos,
    end_pos,
    SUM(CASE WHEN grp = 'EAS'    THEN alt_cnt ELSE 0 END) AS A, -- cases  alt
    SUM(CASE WHEN grp = 'EAS'    THEN ref_cnt ELSE 0 END) AS B, -- cases  ref
    SUM(CASE WHEN grp = 'OTHERS' THEN alt_cnt ELSE 0 END) AS C, -- controls alt
    SUM(CASE WHEN grp = 'OTHERS' THEN ref_cnt ELSE 0 END) AS D  -- controls ref
  FROM variant_counts
  GROUP BY start_pos, end_pos
),

-- Compute expected counts and χ² with Yates’s correction
stats AS (
  SELECT
    start_pos,
    end_pos,
    A, B, C, D,
    (A+B+C+D)                                                       AS N,
    ((A+B)*(A+C) / (A+B+C+D))                                       AS E_A,
    ((A+B)*(B+D) / (A+B+C+D))                                       AS E_B,
    ((C+D)*(A+C) / (A+B+C+D))                                       AS E_C,
    ((C+D)*(B+D) / (A+B+C+D))                                       AS E_D
  FROM per_variant
  WHERE (A+B+C+D) > 0
),

-- Keep variants that satisfy expected‑count criterion
filtered AS (
  SELECT
    *,
    -- Yates‑corrected chi‑squared
    (N * POW(ABS(A*D - B*C) - (N / 2.0), 2))
      / ((A+B)*(C+D)*(A+C)*(B+D))                                   AS chi_sq
  FROM stats
  WHERE E_A >= 5 AND E_B >= 5 AND E_C >= 5 AND E_D >= 5
)

SELECT
  start_pos AS start,
  end_pos   AS end,
  chi_sq
FROM filtered
WHERE chi_sq >= 29.71679
ORDER BY chi_sq DESC, start_pos;
```
