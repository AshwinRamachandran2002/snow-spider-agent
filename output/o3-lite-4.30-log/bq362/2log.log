Below are 10 exploratory SQL snippets (all capped with `LIMIT 20`) that move from basic inspection to the final answer.

```sql
-- 1. Peek at a few company names only
SELECT DISTINCT company
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE company IS NOT NULL
LIMIT 20;
```

```sql
-- 2. List distinct (year, month) combinations that appear in the data
SELECT DISTINCT
       EXTRACT(YEAR  FROM trip_start_timestamp) AS yr,
       EXTRACT(MONTH FROM trip_start_timestamp) AS mo
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
ORDER BY yr, mo
LIMIT 20;
```

```sql
-- 3. Trip count for all companies in January 2018
SELECT company,
       COUNT(*) AS jan_trips
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE EXTRACT(YEAR  FROM trip_start_timestamp) = 2018
  AND EXTRACT(MONTH FROM trip_start_timestamp) = 1
GROUP BY company
ORDER BY jan_trips DESC
LIMIT 20;
```

```sql
-- 4. Monthly trip counts per company for the whole of 2018
SELECT company,
       EXTRACT(MONTH FROM trip_start_timestamp) AS month,
       COUNT(*) AS trips
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE EXTRACT(YEAR FROM trip_start_timestamp) = 2018
GROUP BY company, month
ORDER BY company, month
LIMIT 20;
```

```sql
-- 5. Twelve‑month profile for one sample company (replace with an actual name)
SELECT EXTRACT(MONTH FROM trip_start_timestamp) AS month,
       COUNT(*) AS trips
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE EXTRACT(YEAR FROM trip_start_timestamp) = 2018
  AND company = 'Taxi Affiliation Services'         -- example name
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
-- 6. Month‑over‑month change per company in 2018 using window functions
SELECT company,
       month,
       trips,
       trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff_from_prev
FROM (
  SELECT company,
         EXTRACT(MONTH FROM trip_start_timestamp) AS month,
         COUNT(*) AS trips
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE EXTRACT(YEAR FROM trip_start_timestamp) = 2018
  GROUP BY company, month
)
ORDER BY company, month
LIMIT 20;
```

```sql
-- 7. Greatest single‑month increase for every company in 2018
SELECT company,
       MAX(diff_from_prev) AS max_increase
FROM (
  SELECT company,
         month,
         trips,
         trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff_from_prev
  FROM (
    SELECT company,
           EXTRACT(MONTH FROM trip_start_timestamp) AS month,
           COUNT(*) AS trips
    FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE EXTRACT(YEAR FROM trip_start_timestamp) = 2018
    GROUP BY company, month
  )
)
GROUP BY company
ORDER BY max_increase DESC
LIMIT 20;
```

```sql
-- 8. Top 10 company–month pairs with the largest positive jump
SELECT company,
       month,
       diff_from_prev AS increase
FROM (
  SELECT company,
         month,
         trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff_from_prev
  FROM (
    SELECT company,
           EXTRACT(MONTH FROM trip_start_timestamp) AS month,
           COUNT(*) AS trips
    FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE EXTRACT(YEAR FROM trip_start_timestamp) = 2018
    GROUP BY company, month
  )
)
WHERE diff_from_prev IS NOT NULL
ORDER BY increase DESC
LIMIT 20;
```

```sql
-- 9. Verify month names, attach year‑month label for readability
SELECT company,
       FORMAT_DATE('%Y-%m', DATE(2018, month, 1)) AS yr_mo,
       trips,
       diff_from_prev AS increase
FROM (
  SELECT company,
         month,
         trips,
         trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff_from_prev
  FROM (
    SELECT company,
           EXTRACT(MONTH FROM trip_start_timestamp) AS month,
           COUNT(*) AS trips
    FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE EXTRACT(YEAR FROM trip_start_timestamp) = 2018
    GROUP BY company, month
  )
)
WHERE diff_from_prev IS NOT NULL
ORDER BY increase DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: three companies with the largest single month‑to‑next‑month
--     trip increase during 2018
SELECT company,
       FORMAT_DATE('%Y-%m', DATE(2018, month, 1))           AS current_month,
       FORMAT_DATE('%Y-%m', DATE(2018, month - 1, 1))       AS previous_month,
       diff_from_prev                                       AS trip_increase
FROM (
  SELECT company,
         month,
         trips,
         trips - LAG(trips) OVER (PARTITION BY company ORDER BY month) AS diff_from_prev
  FROM (
    -- build monthly counts first
    SELECT company,
           EXTRACT(MONTH FROM trip_start_timestamp) AS month,
           COUNT(*) AS trips
    FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE EXTRACT(YEAR FROM trip_start_timestamp) = 2018
    GROUP BY company, month
  )
)
WHERE diff_from_prev IS NOT NULL
ORDER BY trip_increase DESC
LIMIT 20;      -- returns the top 3 rows (others will be ties if any)
```

Running query 10 will return the three companies that experienced the greatest positive jump in trip count between any two consecutive months during 2018, along with the month pair and the numeric increase.
