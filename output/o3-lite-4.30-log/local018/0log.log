Begin Exploring Related Columns
Relevant columns and their potential usage  
• collisions.case_id: key to link every collision record to its calendar year (via case_ids).  
• case_ids.db_year: lets us filter for 2011 and 2021.  
• collisions.pcf_violation_category: shows the “primary collision‑factor violation category” that caused each crash.  
• (condition) WHERE case_ids.db_year = 2021 (or 2011).  
• (condition) GROUP BY collisions.pcf_violation_category to tally collisions in each year.  
• (condition) COUNT(*)*1.0 / (SELECT COUNT(*) …) to get a category’s percentage share.  

Ten exploratory‑to‑final SQL queries
```sql
-- 1️⃣  Preview a few year tags stored in the case_ids table
SELECT DISTINCT "db_year"
FROM "case_ids"
LIMIT 20;
```

```sql
-- 2️⃣  See some violation categories that appear in the collisions table
SELECT DISTINCT "pcf_violation_category"
FROM "collisions"
LIMIT 20;
```

```sql
-- 3️⃣  Verify joinability: pick 20 random (case_id, year) pairs present in both tables
SELECT c."case_id", y."db_year"
FROM "collisions" AS c
JOIN "case_ids"  AS y
  ON c."case_id" = y."case_id"
LIMIT 20;
```

```sql
-- 4️⃣  List 20 collision rows that occurred in 2021 with their violation category
SELECT c."case_id",
       y."db_year",
       c."pcf_violation_category"
FROM   "collisions" AS c
JOIN   "case_ids"   AS y
  ON   c."case_id" = y."case_id"
WHERE  y."db_year" = 2021
LIMIT 20;
```

```sql
-- 5️⃣  Count collisions per violation category in 2021 (show top 20)
SELECT c."pcf_violation_category",
       COUNT(*) AS "cnt_2021"
FROM   "collisions" AS c
JOIN   "case_ids"   AS y
  ON   c."case_id" = y."case_id"
WHERE  y."db_year" = 2021
GROUP  BY c."pcf_violation_category"
ORDER  BY "cnt_2021" DESC
LIMIT 20;
```

```sql
-- 6️⃣  Compute each category’s percentage share of all 2021 crashes
WITH year_tot AS (
  SELECT COUNT(*) AS total_2021
  FROM   "collisions" c
  JOIN   "case_ids"  y ON c."case_id" = y."case_id"
  WHERE  y."db_year" = 2021
)
SELECT c."pcf_violation_category",
       ROUND(100.0*COUNT(*)/t.total_2021,2) AS pct_2021
FROM   "collisions" c
JOIN   "case_ids"  y ON c."case_id" = y."case_id",
       year_tot t
WHERE  y."db_year" = 2021
GROUP  BY c."pcf_violation_category"
ORDER  BY pct_2021 DESC
LIMIT 20;
```

```sql
-- 7️⃣  Grab the most frequent 2021 violation category (one row only)
WITH ranked AS (
  SELECT c."pcf_violation_category",
         COUNT(*) AS cnt
  FROM   "collisions" c
  JOIN   "case_ids"  y ON c."case_id" = y."case_id"
  WHERE  y."db_year" = 2021
  GROUP  BY c."pcf_violation_category"
  ORDER  BY cnt DESC
)
SELECT "pcf_violation_category"
FROM   ranked
LIMIT 1;
```

```sql
-- 8️⃣  Compute that top‑2021 category’s share in both 2011 and 2021
WITH top21 AS (
  SELECT c."pcf_violation_category"
  FROM   "collisions" c
  JOIN   "case_ids"  y ON c."case_id" = y."case_id"
  WHERE  y."db_year" = 2021
  GROUP  BY c."pcf_violation_category"
  ORDER  BY COUNT(*) DESC
  LIMIT 1
),
year_totals AS (
  SELECT y."db_year", COUNT(*) AS tot
  FROM   "collisions" c
  JOIN   "case_ids"  y ON c."case_id" = y."case_id"
  WHERE  y."db_year" IN (2011,2021)
  GROUP  BY y."db_year"
)
SELECT y."db_year",
       COUNT(*) AS cat_cnt,
       t.tot      AS year_cnt,
       ROUND(100.0*COUNT(*)/t.tot,2) AS pct_share
FROM   "collisions" c
JOIN   "case_ids"  y ON c."case_id" = y."case_id"
JOIN   top21       g ON c."pcf_violation_category" = g."pcf_violation_category"
JOIN   year_totals t ON y."db_year" = t."db_year"
WHERE  y."db_year" IN (2011,2021)
GROUP  BY y."db_year", t.tot
ORDER  BY y."db_year"
LIMIT 20;
```

```sql
-- 9️⃣  Report the percentage‑point change between 2011 and 2021 for that category
WITH top21 AS (
  SELECT c."pcf_violation_category"
  FROM   "collisions" c
  JOIN   "case_ids"  y ON c."case_id" = y."case_id"
  WHERE  y."db_year" = 2021
  GROUP  BY c."pcf_violation_category"
  ORDER  BY COUNT(*) DESC
  LIMIT 1
),
shares AS (
  SELECT y."db_year",
         ROUND(100.0*COUNT(*)/
               (SELECT COUNT(*) FROM "collisions" c2
                 JOIN "case_ids" y2 ON c2."case_id" = y2."case_id"
                 WHERE y2."db_year" = y."db_year"),2) AS pct_share
  FROM   "collisions" c
  JOIN   "case_ids"  y ON c."case_id" = y."case_id"
  JOIN   top21       g ON c."pcf_violation_category" = g."pcf_violation_category"
  WHERE  y."db_year" IN (2011,2021)
  GROUP  BY y."db_year"
)
SELECT (SELECT pct_share FROM shares WHERE db_year = 2021) -
       (SELECT pct_share FROM shares WHERE db_year = 2011) AS pct_point_drop
LIMIT 20;
```

```sql
-- 🔟  All‑in‑one final query: name the category and show its 2021‑vs‑2011 share & drop
WITH top21 AS (
  SELECT c."pcf_violation_category" AS cat
  FROM   "collisions" c
  JOIN   "case_ids"  y ON c."case_id" = y."case_id"
  WHERE  y."db_year" = 2021
  GROUP  BY c."pcf_violation_category"
  ORDER  BY COUNT(*) DESC
  LIMIT 1
),
shares AS (
  SELECT y."db_year",
         t.cat,
         ROUND(100.0*COUNT(*)/
               (SELECT COUNT(*) FROM "collisions" c2
                 JOIN "case_ids" y2 ON c2."case_id" = y2."case_id"
                 WHERE y2."db_year" = y."db_year"),2) AS pct_share
  FROM   "collisions"   c
  JOIN   "case_ids"     y ON c."case_id" = y."case_id"
  JOIN   top21          t ON c."pcf_violation_category" = t.cat
  WHERE  y."db_year" IN (2011,2021)
  GROUP  BY y."db_year", t.cat
)
SELECT (SELECT cat          FROM shares LIMIT 1)             AS violation_category,
       (SELECT pct_share    FROM shares WHERE db_year=2011) AS pct_2011,
       (SELECT pct_share    FROM shares WHERE db_year=2021) AS pct_2021,
       (SELECT pct_share    FROM shares WHERE db_year=2021) -
       (SELECT pct_share    FROM shares WHERE db_year=2011) AS pct_point_change
LIMIT 20;
```
Each query is capped with `LIMIT 20` to keep result sets concise while stepping from basic inspection through to the computation of the requested percentage‑point decrease.
