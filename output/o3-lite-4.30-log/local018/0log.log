WITH top_2021 AS (           -- most frequent violation category in 2021
    SELECT c."pcf_violation_category" AS cat
    FROM   "collisions" c
    JOIN   "case_ids"  y ON c."case_id" = y."case_id"
    WHERE  y."db_year" = 2021
    GROUP  BY c."pcf_violation_category"
    ORDER  BY COUNT(*) DESC
    LIMIT 1
),
year_totals AS (             -- total crashes per year (2011 & 2021)
    SELECT y."db_year",
           COUNT(*) AS total_crashes
    FROM   "collisions" c
    JOIN   "case_ids"  y ON c."case_id" = y."case_id"
    WHERE  y."db_year" IN (2011, 2021)
    GROUP  BY y."db_year"
),
cat_totals AS (              -- crashes of the chosen category per year
    SELECT y."db_year",
           COUNT(*) AS cat_crashes
    FROM   "collisions" c
    JOIN   "case_ids"  y ON c."case_id" = y."case_id"
    JOIN   top_2021    t ON c."pcf_violation_category" = t.cat
    WHERE  y."db_year" IN (2011, 2021)
    GROUP  BY y."db_year"
),
shares AS (                  -- percentage share per year
    SELECT ct."db_year",
           100.0 * ct.cat_crashes / yt.total_crashes AS pct_share
    FROM   cat_totals  ct
    JOIN   year_totals yt ON ct."db_year" = yt."db_year"
)
