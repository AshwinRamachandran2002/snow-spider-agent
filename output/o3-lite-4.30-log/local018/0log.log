WITH top_2021 AS (                         -- most common PCF category in 2021
    SELECT c."pcf_violation_category" AS cat
    FROM   "collisions" c
    JOIN   "case_ids"  y ON c."case_id" = y."case_id"
    WHERE  y."db_year" = 2021
    GROUP  BY c."pcf_violation_category"
    ORDER  BY COUNT(*) DESC
    LIMIT 1
),
totals AS (                                -- total crashes for each year
    SELECT
        SUM(CASE WHEN y."db_year" = 2011 THEN 1 END) AS total_2011,
        SUM(CASE WHEN y."db_year" = 2021 THEN 1 END) AS total_2021
    FROM   "collisions" c
    JOIN   "case_ids"  y ON c."case_id" = y."case_id"
    WHERE  y."db_year" IN (2011, 2021)
),
category_counts AS (                       -- crashes of that category for each year
    SELECT
        SUM(CASE WHEN y."db_year" = 2011 THEN 1 END) AS cat_2011,
        SUM(CASE WHEN y."db_year" = 2021 THEN 1 END) AS cat_2021
    FROM   "collisions" c
    JOIN   "case_ids"  y ON c."case_id" = y."case_id"
    JOIN   top_2021    t ON c."pcf_violation_category" = t.cat
    WHERE  y."db_year" IN (2011, 2021)
)
SELECT
    (SELECT cat FROM top_2021)                             AS violation_category,
    ROUND(
        COALESCE(cat_2011 * 100.0 / NULLIF(total_2011, 0), 0) -
        COALESCE(cat_2021 * 100.0 / NULLIF(total_2021, 0), 0)
    , 4)                                                   AS percentage_point_decrease
FROM category_counts, totals;
