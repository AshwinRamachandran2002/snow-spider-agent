  FROM   "collisions"   c
  JOIN   "case_ids"     y ON c."case_id" = y."case_id"
  JOIN   top21          t ON c."pcf_violation_category" = t.cat
  WHERE  y."db_year" IN (2011,2021)
  GROUP  BY y."db_year", t.cat
)
SELECT (SELECT cat          FROM shares LIMIT 1)             AS violation_category,
       (SELECT pct_share    FROM shares WHERE db_year=2011) AS pct_2011,
       (SELECT pct_share    FROM shares WHERE db_year=2021) AS pct_2021,
       (SELECT pct_share    FROM shares WHERE db_year=2021) -
       (SELECT pct_share    FROM shares WHERE db_year=2011) AS pct_point_change
LIMIT 20;
