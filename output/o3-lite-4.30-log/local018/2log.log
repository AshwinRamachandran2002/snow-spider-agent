Begin Exploring Related Columns
Relevant tables / columns and how they will be used  
• case_ids.case_id : key to join with collisions, gives the year of the crash (db_year)  
• case_ids.db_year : to isolate the two years that we must compare (2011 & 2021)  
• collisions.case_id : key to join with case_ids  
• collisions.pcf_violation_category : the “primary collision‑factor violation category”; we need counts by year and category  
Conditions that will be applied  
• INNER JOIN collisions ON collisions.case_id = case_ids.case_id  
• WHERE case_ids.db_year IN (2011, 2021)  
• Ignore NULL pcf_violation_category rows – add “AND collisions.pcf_violation_category IS NOT NULL”  

Ten exploratory → final SQL queries
```sql
-- 1. Check a few 2021 case‑ids are present
SELECT ci.case_id, ci.db_year
FROM case_ids AS ci
WHERE ci.db_year = 2021
LIMIT 20;
```

```sql
-- 2. What distinct violation categories appear in 2021?
SELECT DISTINCT c.pcf_violation_category
FROM collisions AS c
JOIN case_ids AS ci ON ci.case_id = c.case_id
WHERE ci.db_year = 2021
  AND c.pcf_violation_category IS NOT NULL
LIMIT 20;
```

```sql
-- 3. Count collisions by violation category in 2021 (top 20)
SELECT c.pcf_violation_category,
       COUNT(*) AS collisions_2021
FROM collisions AS c
JOIN case_ids AS ci ON ci.case_id = c.case_id
WHERE ci.db_year = 2021
  AND c.pcf_violation_category IS NOT NULL
GROUP BY c.pcf_violation_category
ORDER BY collisions_2021 DESC
LIMIT 20;
```

```sql
-- 4. Count collisions by violation category in 2011 (top 20)
SELECT c.pcf_violation_category,
       COUNT(*) AS collisions_2011
FROM collisions AS c
JOIN case_ids AS ci ON ci.case_id = c.case_id
WHERE ci.db_year = 2011
  AND c.pcf_violation_category IS NOT NULL
GROUP BY c.pcf_violation_category
ORDER BY collisions_2011 DESC
LIMIT 20;
```

```sql
-- 5. Total number of 2021 collisions (denominator for shares)
SELECT COUNT(*) AS total_2021
FROM collisions AS c
JOIN case_ids AS ci ON ci.case_id = c.case_id
WHERE ci.db_year = 2021;
```

```sql
-- 6. Total number of 2011 collisions (denominator for shares)
SELECT COUNT(*) AS total_2011
FROM collisions AS c
JOIN case_ids AS ci ON ci.case_id = c.case_id
WHERE ci.db_year = 2011;
```

```sql
-- 7. Market share (% of crashes) of every violation category in 2021
WITH cnt AS (
  SELECT c.pcf_violation_category AS cat,
         COUNT(*) AS n
  FROM collisions c
  JOIN case_ids ci ON ci.case_id = c.case_id
  WHERE ci.db_year = 2021
    AND c.pcf_violation_category IS NOT NULL
  GROUP BY cat
), tot AS (
  SELECT SUM(n) AS total FROM cnt
)
SELECT cat,
       ROUND(100.0 * n / total, 2) AS pct_2021
FROM cnt, tot
ORDER BY pct_2021 DESC
LIMIT 20;
```

```sql
-- 8. Market share (% of crashes) of every violation category in 2011
WITH cnt AS (
  SELECT c.pcf_violation_category AS cat,
         COUNT(*) AS n
  FROM collisions c
  JOIN case_ids ci ON ci.case_id = c.case_id
  WHERE ci.db_year = 2011
    AND c.pcf_violation_category IS NOT NULL
  GROUP BY cat
), tot AS (
  SELECT SUM(n) AS total FROM cnt
)
SELECT cat,
       ROUND(100.0 * n / total, 2) AS pct_2011
FROM cnt, tot
ORDER BY pct_2011 DESC
LIMIT 20;
```

```sql
-- 9. Identify the MOST common violation category in 2021
WITH cnt AS (
  SELECT c.pcf_violation_category AS cat,
         COUNT(*) AS n
  FROM collisions c
  JOIN case_ids ci ON ci.case_id = c.case_id
  WHERE ci.db_year = 2021
    AND c.pcf_violation_category IS NOT NULL
  GROUP BY cat
)
SELECT cat
FROM cnt
ORDER BY n DESC
LIMIT 1;
```

```sql
-- 10. FINAL ANSWER: How many percentage‑points did its share drop from 2011 to 2021?
WITH counts AS (
  SELECT ci.db_year,
         c.pcf_violation_category AS cat,
         COUNT(*) AS n
  FROM collisions c
  JOIN case_ids ci ON ci.case_id = c.case_id
  WHERE ci.db_year IN (2011, 2021)
    AND c.pcf_violation_category IS NOT NULL
  GROUP BY ci.db_year, cat
),
totals AS (
  SELECT db_year, SUM(n) AS total_n
  FROM counts
  GROUP BY db_year
),
shares AS (
  SELECT cat,
         db_year,
         100.0 * n / total_n AS pct
  FROM counts
  JOIN totals USING (db_year)
),
top_2021 AS (             -- the dominant category in 2021
  SELECT cat
  FROM shares
  WHERE db_year = 2021
  ORDER BY pct DESC
  LIMIT 1
),
s2011 AS (
  SELECT pct AS pct_2011
  FROM shares
  WHERE db_year = 2011
    AND cat IN (SELECT cat FROM top_2021)
),
s2021 AS (
  SELECT pct AS pct_2021
  FROM shares
  WHERE db_year = 2021
    AND cat IN (SELECT cat FROM top_2021)
)
SELECT ROUND( (SELECT pct_2011 FROM s2011) -
              (SELECT pct_2021 FROM s2021), 2
            ) AS decrease_percentage_points;
```
The last query returns precisely the number of percentage points by which the leading 2021 collision‑factor category’s share of total crashes has fallen relative to 2011.
