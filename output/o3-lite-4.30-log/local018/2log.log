WITH year_totals AS (
    SELECT ci.db_year AS year,
           COUNT(*)   AS total_collisions
    FROM collisions AS c
    JOIN case_ids  AS ci ON ci.case_id = c.case_id
    WHERE ci.db_year IN (2011, 2021)
    GROUP BY ci.db_year
),
cat_counts AS (
    SELECT ci.db_year              AS year,
           c.pcf_violation_category AS category,
           COUNT(*)                 AS cat_collisions
    FROM collisions AS c
    JOIN case_ids  AS ci ON ci.case_id = c.case_id
    WHERE ci.db_year IN (2011, 2021)
      AND c.pcf_violation_category IS NOT NULL
    GROUP BY ci.db_year, c.pcf_violation_category
),
top_cat AS (          -- most common violation category in 2021
    SELECT category
    FROM   cat_counts
    WHERE  year = 2021
    ORDER  BY cat_collisions DESC
    LIMIT  1
),
shares AS (           -- percentage share of that category in each year
    SELECT cc.year,
           cc.category,
           100.0 * cc.cat_collisions / yt.total_collisions AS pct_share
    FROM   cat_counts  AS cc
    JOIN   year_totals AS yt ON yt.year = cc.year
    JOIN   top_cat     AS tc ON tc.category = cc.category
)
SELECT
    (SELECT category   FROM top_cat)                                 AS violation_category,
    ROUND(
        (SELECT pct_share FROM shares WHERE year = 2011) -
        (SELECT pct_share FROM shares WHERE year = 2021)
    , 2)                                                             AS percentage_point_decrease
;
