    FROM collisions c
    JOIN case_ids  ci ON ci.case_id = c.case_id
    WHERE ci.db_year IN (2021, (SELECT yr FROM first_year))
      AND c.pcf_violation_category IS NOT NULL
    GROUP BY ci.db_year, cat
),
totals AS (                                  -- totals per year
    SELECT db_year, SUM(n) AS total_n
    FROM counts
    GROUP BY db_year
),
shares AS (                                  -- % share per category per year
    SELECT cat,
           db_year,
           100.0 * n / total_n AS pct
    FROM counts
    JOIN totals USING (db_year)
),
top_2021 AS (                                -- dominant category in 2021
    SELECT cat
    FROM shares
    WHERE db_year = 2021
    ORDER BY pct DESC
    LIMIT 1
)
SELECT ROUND(                                -- percentage‑point drop
         (SELECT pct FROM shares 
          WHERE db_year = (SELECT yr FROM first_year)
            AND cat = (SELECT cat FROM top_2021)
        ) -
         (SELECT pct FROM shares 
          WHERE db_year = 2021
            AND cat = (SELECT cat FROM top_2021)
        ), 
        2) AS decrease_percentage_points;
