    JOIN   case_ids    AS ci ON ci.case_id = c.case_id
    WHERE  c.pcf_violation_category IS NOT NULL
    GROUP  BY ci.db_year
), first_year AS (                           -- earliest year with >0 rows
    SELECT MIN(db_year) AS yr
    FROM   year_counts
), counts AS (                               -- collisions by year & category
    SELECT ci.db_year,
           c.pcf_violation_category AS cat,
           COUNT(*)                 AS n
    FROM   collisions  AS c
    JOIN   case_ids    AS ci ON ci.case_id = c.case_id
    WHERE  ci.db_year IN (2021, (SELECT yr FROM first_year))
      AND  c.pcf_violation_category IS NOT NULL
    GROUP  BY ci.db_year, cat
), totals AS (                               -- total collisions per year
    SELECT db_year,
           SUM(n) AS total_n
    FROM   counts
    GROUP  BY db_year
), shares AS (                               -- % share per category per year
