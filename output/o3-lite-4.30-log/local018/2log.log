           db_year,
           100.0 * n / total_n AS pct
    FROM   counts
    JOIN   totals USING (db_year)
), top_2021 AS (                             -- dominant category in 2021
    SELECT cat
    FROM   shares
    WHERE  db_year = 2021
    ORDER  BY pct DESC
    LIMIT 1
)
SELECT ROUND(
