Begin Exploring Related Columns
Relevant columns and their potential usage  
• collisions."case_id": key that lets us connect every crash stored in collisions to its calendar year (found in case_ids).  
• case_ids."case_id": key to join with collisions; case_ids."db_year": the calendar year in which the collision occurred – needed to isolate 2011 vs 2021 records.  
• collisions."pcf_violation_category": text label that tells us the Primary Collision‑Factor (PCF) category – the “cause” we must analyse.  

Typical conditions we will need  
• INNER JOIN collisions c ON c."case_id" = ci."case_id"  
• WHERE ci."db_year" IN (2011, 2021) – restrict to the two target years.  

Below are 10 exploratory → analytical SQL queries, each capped at 20 rows (when row‑lists are returned) and annotated:

```sql
-- 1.  What calendar years are available in the data set?
SELECT DISTINCT ci."db_year"
FROM "case_ids" AS ci
ORDER BY ci."db_year" LIMIT 20;
```

```sql
-- 2.  Roughly how many collisions are recorded for each year
SELECT ci."db_year",
       COUNT(*) AS collisions_in_year
FROM   "collisions" AS c
JOIN   "case_ids"  AS ci ON ci."case_id" = c."case_id"
GROUP  BY ci."db_year"
ORDER  BY ci."db_year" LIMIT 20;
```

```sql
-- 3.  Show distinct PCF violation categories that appear in 2021
SELECT DISTINCT c."pcf_violation_category"
FROM   "collisions" AS c
JOIN   "case_ids"  AS ci ON ci."case_id" = c."case_id"
WHERE  ci."db_year" = 2021
ORDER  BY 1 LIMIT 20;
```

```sql
-- 4.  Count collisions by PCF category in 2021 (top 20)
SELECT c."pcf_violation_category",
       COUNT(*) AS collisions_2021
FROM   "collisions" AS c
JOIN   "case_ids"  AS ci ON ci."case_id" = c."case_id"
WHERE  ci."db_year" = 2021
GROUP  BY c."pcf_violation_category"
ORDER  BY collisions_2021 DESC
LIMIT 20;
```

```sql
-- 5.  Identify the single most common PCF category in 2021
SELECT c."pcf_violation_category",
       COUNT(*) AS collisions_2021
FROM   "collisions" AS c
JOIN   "case_ids"  AS ci ON ci."case_id" = c."case_id"
WHERE  ci."db_year" = 2021
GROUP  BY c."pcf_violation_category"
ORDER  BY collisions_2021 DESC
LIMIT 1;
```

```sql
-- 6.  For 2011, how many collisions involved that top‑2021 PCF category?
--     (Replace ? with the exact string returned by query 5)
SELECT COUNT(*) AS collisions_2011_for_top_pcf
FROM   "collisions" AS c
JOIN   "case_ids"  AS ci ON ci."case_id" = c."case_id"
WHERE  ci."db_year" = 2011
  AND  c."pcf_violation_category" = ?;
```

```sql
-- 7.  Total collisions in 2011 and in 2021 (needed for later percentage)
SELECT ci."db_year",
       COUNT(*) AS total_collisions
FROM   "collisions" AS c
JOIN   "case_ids"  AS ci ON ci."case_id" = c."case_id"
WHERE  ci."db_year" IN (2011, 2021)
GROUP  BY ci."db_year"
ORDER  BY ci."db_year";
```

```sql
-- 8.  Combine counts so we can compute each year’s share for the top PCF
WITH top_pcf AS (
     SELECT c."pcf_violation_category"
     FROM   "collisions" c
     JOIN   "case_ids" ci ON ci."case_id" = c."case_id"
     WHERE  ci."db_year" = 2021
     GROUP  BY c."pcf_violation_category"
     ORDER  BY COUNT(*) DESC
     LIMIT 1
)
SELECT ci."db_year",
       COUNT(*)                   AS collisions_with_top_pcf
FROM   "collisions" AS c
JOIN   "case_ids"  AS ci ON ci."case_id" = c."case_id"
JOIN   top_pcf     AS tp ON tp."pcf_violation_category" = c."pcf_violation_category"
WHERE  ci."db_year" IN (2011, 2021)
GROUP  BY ci."db_year";
```

```sql
-- 9.  Percentage share for the top PCF in each year
WITH totals AS (
     SELECT ci."db_year", COUNT(*) AS total_collisions
     FROM   "collisions" c
     JOIN   "case_ids"  ci ON ci."case_id" = c."case_id"
     WHERE  ci."db_year" IN (2011, 2021)
     GROUP  BY ci."db_year"
),
top_pcf AS (
     SELECT c."pcf_violation_category"
     FROM   "collisions" c
     JOIN   "case_ids" ci ON ci."case_id" = c."case_id"
     WHERE  ci."db_year" = 2021
     GROUP  BY c."pcf_violation_category"
     ORDER  BY COUNT(*) DESC
     LIMIT 1
),
pcf_counts AS (
     SELECT ci."db_year", COUNT(*) AS pcf_collisions
     FROM   "collisions" c
     JOIN   "case_ids"  ci ON ci."case_id" = c."case_id"
     JOIN   top_pcf     tp ON tp."pcf_violation_category" = c."pcf_violation_category"
     WHERE  ci."db_year" IN (2011, 2021)
     GROUP  BY ci."db_year"
)
SELECT t."db_year",
       ROUND(100.0 * p."pcf_collisions" / t."total_collisions", 2) AS pcf_share_pct
FROM   totals t
JOIN   pcf_counts p USING ("db_year")
ORDER  BY t."db_year";
```

```sql
-- 10.  Final answer: percentage‑point change from 2011 → 2021
WITH totals AS (
     SELECT ci."db_year", COUNT(*) AS total
     FROM   "collisions" c
     JOIN   "case_ids"  ci ON ci."case_id" = c."case_id"
     WHERE  ci."db_year" IN (2011, 2021)
     GROUP  BY ci."db_year"
),
top_pcf AS (
     SELECT c."pcf_violation_category"
     FROM   "collisions" c
     JOIN   "case_ids" ci ON ci."case_id" = c."case_id"
     WHERE  ci."db_year" = 2021
     GROUP  BY c."pcf_violation_category"
     ORDER  BY COUNT(*) DESC
     LIMIT 1
),
pcf_counts AS (
     SELECT ci."db_year", COUNT(*) AS pcf_cnt
     FROM   "collisions" c
     JOIN   "case_ids"  ci ON ci."case_id" = c."case_id"
     JOIN   top_pcf     tp ON tp."pcf_violation_category" = c."pcf_violation_category"
     WHERE  ci."db_year" IN (2011, 2021)
     GROUP  BY ci."db_year"
),
shares AS (
     SELECT t."db_year",
            100.0 * p."pcf_cnt" / t."total" AS share_pct
     FROM   totals t JOIN pcf_counts p USING ("db_year")
)
SELECT ROUND(
       (SELECT share_pct FROM shares WHERE "db_year" = 2021) -
       (SELECT share_pct FROM shares WHERE "db_year" = 2011), 2
) AS pct_point_change_2021_vs_2011;
```

Running these queries sequentially lets you  
1) discover the most common PCF violation category in 2021,  
2) measure its prevalence in 2011, and  
3) obtain the requested percentage‑point decrease.
