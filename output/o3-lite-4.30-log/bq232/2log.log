```sql
-- 4) Distinct calendar years for which we have Westminster data
SELECT DISTINCT year
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
ORDER BY year
LIMIT 20;
```

```sql
-- 5) Raw monthly rows that match our exact filters
SELECT year, month, lsoa_code, value
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND major_category = 'Theft and Handling'
  AND minor_category = 'Other Theft'
LIMIT 20;
```

```sql
-- 6) Yearly total number of rows (not crimes) that match the filter
SELECT year,
       COUNT(*) AS num_rows
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND major_category = 'Theft and Handling'
  AND minor_category = 'Other Theft'
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
-- 7) Yearly sum of ‘value’ (total incidents) for Other Theft
SELECT year,
       SUM(value) AS total_incidents
