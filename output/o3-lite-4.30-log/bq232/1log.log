Ten exploratory → final queries
```sql
-- 1. Distinct borough names (quick look)
SELECT DISTINCT borough
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
LIMIT 20;
```

```sql
-- 2. Distinct major crime categories recorded in Westminster
SELECT DISTINCT major_category
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
LIMIT 20;
```

```sql
-- 3. Distinct minor categories that sit under “Theft and Handling”
SELECT DISTINCT minor_category
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE major_category = 'Theft and Handling'
LIMIT 20;
```

```sql
-- 4. Sample raw rows for ‘Other Theft’ in Westminster
SELECT *
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND major_category = 'Theft and Handling'
  AND minor_category = 'Other Theft'
LIMIT 20;
```

```sql
-- 5. Total ‘Other Theft’ incidents in Westminster (all years combined)
SELECT SUM(value) AS total_other_theft_westminster
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND major_category = 'Theft and Handling'
  AND minor_category = 'Other Theft'
LIMIT 20;
```

```sql
-- 6. Year‑by‑year sums for the chosen crime type in Westminster
SELECT year,
       SUM(value) AS total_other_theft_in_year
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND major_category = 'Theft and Handling'
  AND minor_category = 'Other Theft'
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
-- 7. Conditional aggregation alternative (same result as #6)
SELECT year,
       SUM(CASE
             WHEN major_category = 'Theft and Handling'
              AND minor_category = 'Other Theft' THEN value
             ELSE 0 END) AS total_other_theft_in_year
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
-- 8. Using a WITH clause for readability
WITH westminster_theft AS (
  SELECT *
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE borough = 'Westminster'
    AND major_category = 'Theft and Handling'
)
SELECT year,
       SUM(value) AS total_other_theft_in_year
FROM westminster_theft
WHERE minor_category = 'Other Theft'
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
-- 9. Just list the years available for Westminster theft & handling data
SELECT DISTINCT year
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND major_category = 'Theft and Handling'
ORDER BY year
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: total number of 'Other Theft' incidents within
-- “Theft and Handling” for each year in the Westminster borough
SELECT
  year,
  SUM(value) AS total_other_theft_incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND major_category = 'Theft and Handling'
  AND minor_category = 'Other Theft'
GROUP BY year
ORDER BY year;
```
