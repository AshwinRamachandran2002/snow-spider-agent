-- 10. FINAL ANSWER QUERY:
--    Total number of “Other Theft” incidents in the “Theft and Handling” category
--    for each year, restricted to the borough of Westminster
SELECT
  year,
  SUM(value) AS total_other_theft_incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND major_category = 'Theft and Handling'
  AND minor_category = 'Other Theft'
GROUP BY year
ORDER BY year;
