-- 8. Yearly totals within “Theft and Handling” across all of London
SELECT year, borough, SUM(value) AS london_theft_handling
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE major_category = 'Theft and Handling'
GROUP BY year, borough
ORDER BY year, borough
LIMIT 20;
