Relevant tables, columns & potential usage  

• LANGUAGES."repo_name": join‑key to other tables  
• LANGUAGES."language": filter repositories that contain the word Shell (ILIKE '%Shell%')  

• LICENSES."repo_name": join‑key  
• LICENSES."license": keep only 'apache-2.0'  

• SAMPLE_COMMITS."repo_name": join‑key  
• SAMPLE_COMMITS."message": apply length filter (LEN > 5 AND < 10000) and “does not start with” filters  
  – NOT ILIKE 'merge%'  
  – NOT ILIKE 'update%'  
  – NOT ILIKE 'test%'  


Below are ten exploratory Snowflake SQL queries (simple → complex → answer).  
All column names are wrapped in double quotes; each query ends with LIMIT 20.

```sql
-- 1. Quick look at how the language values are stored
SELECT DISTINCT "language"
FROM GITHUB_REPOS.GITHUB_REPOS.LANGUAGES
LIMIT 20;
```

```sql
-- 2. Sample repositories that declare Shell as one of their languages
SELECT DISTINCT "repo_name", "language"
FROM GITHUB_REPOS.GITHUB_REPOS.LANGUAGES
WHERE "language" ILIKE '%Shell%'
LIMIT 20;
```

```sql
-- 3. Check which repositories carry the Apache‑2.0 license
SELECT DISTINCT "repo_name", "license"
FROM GITHUB_REPOS.GITHUB_REPOS.LICENSES
WHERE "license" = 'apache-2.0'
LIMIT 20;
```

```sql
-- 4. Intersect: repositories that both use Shell and are Apache‑2.0 licensed
SELECT DISTINCT l."repo_name"
FROM GITHUB_REPOS.GITHUB_REPOS.LANGUAGES  l
JOIN GITHUB_REPOS.GITHUB_REPOS.LICENSES   c
      ON l."repo_name" = c."repo_name"
WHERE l."language" ILIKE '%Shell%'
  AND c."license"  = 'apache-2.0'
LIMIT 20;
```

```sql
-- 5. Peek at commit messages of one such repository
SELECT s."repo_name", s."message"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_COMMITS s
JOIN (
      SELECT DISTINCT l."repo_name"
      FROM GITHUB_REPOS.GITHUB_REPOS.LANGUAGES l
      JOIN GITHUB_REPOS.GITHUB_REPOS.LICENSES  c
            ON l."repo_name" = c."repo_name"
      WHERE l."language" ILIKE '%Shell%'
        AND c."license" = 'apache-2.0'
     ) r ON s."repo_name" = r."repo_name"
LIMIT 20;
```

```sql
-- 6. Same sample but only messages with length > 5 characters
SELECT s."repo_name",
       s."message",
       LEN(s."message") AS "len"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_COMMITS s
JOIN (
      SELECT DISTINCT l."repo_name"
      FROM GITHUB_REPOS.GITHUB_REPOS.LANGUAGES l
      JOIN GITHUB_REPOS.GITHUB_REPOS.LICENSES  c
            ON l."repo_name" = c."repo_name"
      WHERE l."language" ILIKE '%Shell%'
        AND c."license" = 'apache-2.0'
     ) r ON s."repo_name" = r."repo_name"
WHERE LEN(s."message") > 5
LIMIT 20;
```

```sql
-- 7. Add lower‑case “does not start with” filter
SELECT s."repo_name",
       s."message"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_COMMITS s
JOIN (
      SELECT DISTINCT l."repo_name"
      FROM GITHUB_REPOS.GITHUB_REPOS.LANGUAGES l
      JOIN GITHUB_REPOS.GITHUB_REPOS.LICENSES  c
            ON l."repo_name" = c."repo_name"
      WHERE l."language" ILIKE '%Shell%'
        AND c."license" = 'apache-2.0'
     ) r ON s."repo_name" = r."repo_name"
WHERE LEN(s."message") > 5
  AND LOWER(s."message") NOT LIKE 'merge%'
  AND LOWER(s."message") NOT LIKE 'update%'
  AND LOWER(s."message") NOT LIKE 'test%'
LIMIT 20;
```

```sql
-- 8. Also impose upper bound: messages shorter than 10 000 chars
SELECT s."repo_name",
       LEN(s."message") AS "len",
       s."message"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_COMMITS s
JOIN (
      SELECT DISTINCT l."repo_name"
      FROM GITHUB_REPOS.GITHUB_REPOS.LANGUAGES l
      JOIN GITHUB_REPOS.GITHUB_REPOS.LICENSES  c
            ON l."repo_name" = c."repo_name"
      WHERE l."language" ILIKE '%Shell%'
        AND c."license" = 'apache-2.0'
     ) r ON s."repo_name" = r."repo_name"
WHERE LEN(s."message") BETWEEN 6 AND 9999
  AND LOWER(s."message") NOT LIKE 'merge%'
  AND LOWER(s."message") NOT LIKE 'update%'
  AND LOWER(s."message") NOT LIKE 'test%'
LIMIT 20;
```

```sql
-- 9. Count per repository, ordered by most such commits
SELECT s."repo_name",
       COUNT(*) AS "qualifying_commits"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_COMMITS s
JOIN (
      SELECT DISTINCT l."repo_name"
      FROM GITHUB_REPOS.GITHUB_REPOS.LANGUAGES l
      JOIN GITHUB_REPOS.GITHUB_REPOS.LICENSES  c
            ON l."repo_name" = c."repo_name"
      WHERE l."language" ILIKE '%Shell%'
        AND c."license" = 'apache-2.0'
     ) r ON s."repo_name" = r."repo_name"
WHERE LEN(s."message") BETWEEN 6 AND 9999
  AND LOWER(s."message") NOT LIKE 'merge%'
  AND LOWER(s."message") NOT LIKE 'update%'
  AND LOWER(s."message") NOT LIKE 'test%'
GROUP BY s."repo_name"
ORDER BY "qualifying_commits" DESC
LIMIT 20;
```

```sql
-- 10. Final answer: total number of commit messages satisfying all conditions
SELECT COUNT(*) AS "total_commit_messages"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_COMMITS s
JOIN (
      SELECT DISTINCT l."repo_name"
      FROM GITHUB_REPOS.GITHUB_REPOS.LANGUAGES l
      JOIN GITHUB_REPOS.GITHUB_REPOS.LICENSES  c
            ON l."repo_name" = c."repo_name"
      WHERE l."language" ILIKE '%Shell%'
        AND c."license" = 'apache-2.0'
     ) r ON s."repo_name" = r."repo_name"
WHERE LEN(s."message") BETWEEN 6 AND 9999
  AND LOWER(s."message") NOT LIKE 'merge%'
  AND LOWER(s."message") NOT LIKE 'update%'
  AND LOWER(s."message") NOT LIKE 'test%'
LIMIT 20;
```
