Relevant tables / columns and how they will be used  

• GITHUB_REPOS.GITHUB_REPOS.LANGUAGES  
  – "repo_name": to join with other tables  
  – "language": to keep rows that contain the value ‘Shell’ (case–insensitive test)  

• GITHUB_REPOS.GITHUB_REPOS.LICENSES  
  – "repo_name": to join with other tables  
  – "license": to keep rows that contain the value ‘apache-2.0’ (case–insensitive test)  

• GITHUB_REPOS.GITHUB_REPOS.SAMPLE_COMMITS  
  – "repo_name": to join with other tables  
  – "message": the commit message text to be filtered  
  – Conditions that may be used on "message":  
      • LENGTH("message") > 5 and LENGTH("message") < 10000  
      • NOT (LOWER("message") LIKE 'merge%' OR LOWER("message") LIKE 'update%' OR LOWER("message") LIKE 'test%')  

Below are ten exploratory Snowflake SQL queries (each limited to 20 rows where applicable) that progressively build toward the required answer.  
All identifiers are enclosed in double quotes and every query is preceded with a short description comment.

```sql
-- 1. Description: Show a sample of repos whose primary language text contains ‘Shell’
SELECT DISTINCT "repo_name", "language"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"
WHERE LOWER("language") LIKE '%shell%'
LIMIT 20;
```

```sql
-- 2. Description: Show a sample of repos whose license text contains ‘apache-2.0’
SELECT DISTINCT "repo_name", "license"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."LICENSES"
WHERE LOWER("license") LIKE '%apache-2.0%'
LIMIT 20;
```

```sql
-- 3. Description: Show repos that satisfy BOTH: ‘Shell’ language AND ‘apache-2.0’ license
SELECT DISTINCT l."repo_name"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"  l
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LICENSES"   c
      ON l."repo_name" = c."repo_name"
WHERE LOWER(l."language") LIKE '%shell%'
  AND LOWER(c."license") LIKE '%apache-2.0%'
LIMIT 20;
```

```sql
-- 4. Description: Look at commit messages for those matched repos (no filtering yet)
SELECT sc."repo_name", sc."message"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" sc
JOIN (
      SELECT DISTINCT l."repo_name"
      FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"  l
      JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LICENSES"   c
            ON l."repo_name" = c."repo_name"
      WHERE LOWER(l."language") LIKE '%shell%'
        AND LOWER(c."license")  LIKE '%apache-2.0%'
     ) AS x
     ON sc."repo_name" = x."repo_name"
LIMIT 20;
```

```sql
-- 5. Description: Same set, but keep only commit messages whose length is between 6 and 9,999
SELECT sc."repo_name", sc."message", LENGTH(sc."message") AS "msg_len"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" sc
JOIN (
      SELECT DISTINCT l."repo_name"
      FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"  l
      JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LICENSES"   c
            ON l."repo_name" = c."repo_name"
      WHERE LOWER(l."language") LIKE '%shell%'
        AND LOWER(c."license")  LIKE '%apache-2.0%'
     ) AS x
     ON sc."repo_name" = x."repo_name"
WHERE LENGTH(sc."message") > 5
  AND LENGTH(sc."message") < 10000
LIMIT 20;
```

```sql
-- 6. Description: Exclude commit messages that start with ‘merge’ (case‑insensitive)
SELECT sc."repo_name", sc."message"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" sc
JOIN (
      SELECT DISTINCT l."repo_name"
      FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"  l
      JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LICENSES"   c
            ON l."repo_name" = c."repo_name"
      WHERE LOWER(l."language") LIKE '%shell%'
        AND LOWER(c."license")  LIKE '%apache-2.0%'
     ) AS x
     ON sc."repo_name" = x."repo_name"
WHERE LENGTH(sc."message") BETWEEN 6 AND 9999
  AND LOWER(sc."message") NOT LIKE 'merge%'
LIMIT 20;
```

```sql
-- 7. Description: Further exclude messages that start with ‘update’
SELECT sc."repo_name", sc."message"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" sc
JOIN (
      SELECT DISTINCT l."repo_name"
      FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"  l
      JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LICENSES"   c
            ON l."repo_name" = c."repo_name"
      WHERE LOWER(l."language") LIKE '%shell%'
        AND LOWER(c."license")  LIKE '%apache-2.0%'
     ) AS x
     ON sc."repo_name" = x."repo_name"
WHERE LENGTH(sc."message") BETWEEN 6 AND 9999
  AND LOWER(sc."message") NOT LIKE 'merge%'
  AND LOWER(sc."message") NOT LIKE 'update%'
LIMIT 20;
```

```sql
-- 8. Description: Exclude messages that start with ‘test’ as well
SELECT sc."repo_name", sc."message"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" sc
JOIN (
      SELECT DISTINCT l."repo_name"
      FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"  l
      JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LICENSES"   c
            ON l."repo_name" = c."repo_name"
      WHERE LOWER(l."language") LIKE '%shell%'
        AND LOWER(c."license")  LIKE '%apache-2.0%'
     ) AS x
     ON sc."repo_name" = x."repo_name"
WHERE LENGTH(sc."message") BETWEEN 6 AND 9999
  AND LOWER(sc."message") NOT LIKE 'merge%'
  AND LOWER(sc."message") NOT LIKE 'update%'
  AND LOWER(sc."message") NOT LIKE 'test%'
LIMIT 20;
```

```sql
-- 9. Description: List distinct repos that have AT LEAST one commit meeting all criteria
SELECT DISTINCT sc."repo_name"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" sc
JOIN (
      SELECT DISTINCT l."repo_name"
      FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"  l
      JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LICENSES"   c
            ON l."repo_name" = c."repo_name"
      WHERE LOWER(l."language") LIKE '%shell%'
        AND LOWER(c."license")  LIKE '%apache-2.0%'
     ) AS x
     ON sc."repo_name" = x."repo_name"
WHERE LENGTH(sc."message") BETWEEN 6 AND 9999
  AND LOWER(sc."message") NOT LIKE 'merge%'
  AND LOWER(sc."message") NOT LIKE 'update%'
  AND LOWER(sc."message") NOT LIKE 'test%'
LIMIT 20;
```

```sql
-- 10. Description: Final count of commit messages that satisfy all required conditions
SELECT COUNT(*) AS "commit_message_count"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_COMMITS" sc
JOIN (
      SELECT DISTINCT l."repo_name"
      FROM "GITHUB_REPOS"."GITHUB_REPOS"."LANGUAGES"  l
      JOIN "GITHUB_REPOS"."GITHUB_REPOS"."LICENSES"   c
            ON l."repo_name" = c."repo_name"
      WHERE LOWER(l."language") LIKE '%shell%'
        AND LOWER(c."license")  LIKE '%apache-2.0%'
     ) AS x
     ON sc."repo_name" = x."repo_name"
WHERE LENGTH(sc."message") BETWEEN 6 AND 9999
  AND LOWER(sc."message") NOT LIKE 'merge%'
  AND LOWER(sc."message") NOT LIKE 'update%'
  AND LOWER(sc."message") NOT LIKE 'test%';
```

