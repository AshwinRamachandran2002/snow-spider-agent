```sql
--Description: Corrected UNION‑ALL query.  Corn is still limited to bushels (BU); the
--mushroom side no longer filters on unit_desc, so production will appear in its
--reported unit (expected LB).  The unit for each half is carried through as unit_desc.

SELECT
  state_alpha,
  state_name,
