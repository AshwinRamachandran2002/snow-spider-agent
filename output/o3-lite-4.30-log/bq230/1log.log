```sql
--Description: Pivot‑style final table.  Corn remains in bushels; mushrooms are summed
--regardless of unit (reported unit is preserved in a companion column).  This avoids the
--previous BU filter that returned no rows for mushrooms.

WITH corn AS (
  SELECT
    state_alpha,
    state_name,
    SUM(value) AS corn_bu_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND group_desc = 'FIELD CROPS'
    AND commodity_desc = 'CORN'
    AND statisticcat_desc = 'PRODUCTION'
    AND unit_desc = 'BU'
    AND agg_level_desc = 'STATE'
    AND value IS NOT NULL
  GROUP BY state_alpha, state_name
),
mush AS (
  SELECT
    state_alpha,
    state_name,
    MIN(unit_desc)           AS mush_unit,       -- expected LB
    SUM(value)               AS mushroom_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND group_desc = 'HORTICULTURE'
    AND commodity_desc = 'MUSHROOMS'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc = 'STATE'
    AND value IS NOT NULL
  GROUP BY state_alpha, state_name
)

SELECT
  COALESCE(corn.state_alpha, mush.state_alpha) AS state_alpha,
  COALESCE(corn.state_name , mush.state_name ) AS state_name,
  corn.corn_bu_2022,
  mushroom_2022,
  mush_unit
FROM corn
FULL OUTER JOIN mush
USING (state_alpha, state_name)
ORDER BY state_alpha
LIMIT 20;
```
