--Description: Final query – 2022 corn (bushels) and mushroom production per state.
WITH corn AS (
  SELECT
    state_alpha,
    state_name,
    value AS corn_bu
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND group_desc = 'FIELD CROPS'
    AND commodity_desc = 'CORN'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc = 'STATE'
    AND unit_desc = 'BU'
    AND value IS NOT NULL
),
mush AS (
  SELECT
    state_alpha,
    state_name,
    value AS mushrooms_val
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND group_desc = 'HORTICULTURE'
    AND commodity_desc = 'MUSHROOMS'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc = 'STATE'
    AND value IS NOT NULL
)
SELECT
  c.state_alpha           AS state,
  c.state_name,
  c.corn_bu,
  COALESCE(m.mushrooms_val, 0) AS mushrooms
FROM corn AS c
LEFT JOIN mush  AS m
USING (state_alpha, state_name)
ORDER BY state_alpha;
