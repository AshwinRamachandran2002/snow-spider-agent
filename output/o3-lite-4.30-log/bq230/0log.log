```sql
--Description: Pivot the revised UNION so corn (BU) and mushroom production (any unit,
--shown separately) sit side by side.  We bring along unit information for mushrooms
--so the reader knows the unit differs from corn.
WITH two AS (
  SELECT
    state_name,
    'CORN' AS commodity,
    value  AS prod,
    unit_desc
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND commodity_desc = 'CORN'
    AND group_desc     = 'FIELD CROPS'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc   = 'STATE'
    AND unit_desc = 'BU'
    AND value IS NOT NULL

  UNION ALL

  SELECT
    state_name,
    'MUSHROOMS',
    value,
    unit_desc
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND commodity_desc = 'MUSHROOMS'
    AND group_desc     = 'HORTICULTURE'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc   = 'STATE'
    AND value IS NOT NULL
)
SELECT
  state_name,
  MAX(CASE WHEN commodity = 'CORN'      THEN prod END)                     AS corn_bu_2022,
  MAX(CASE WHEN commodity = 'MUSHROOMS' THEN prod END)                    AS mushroom_prod_2022,
  MAX(CASE WHEN commodity = 'MUSHROOMS' THEN unit_desc END)               AS mushroom_unit
FROM two
GROUP BY state_name
LIMIT 20;
```

```sql
--Description: Final aggregation per state.  Corn totals are restricted to BU; mushroom
--totals take whatever unit the data provide (typically LB).  The result shows both
--figures side‑by‑side and includes the mushroom‑unit column so users know the units
--differ.
SELECT
  state_name,
  SUM(CASE
        WHEN commodity_desc = 'CORN'
             AND group_desc  = 'FIELD CROPS'
             AND unit_desc   = 'BU'  THEN value
      END) AS corn_bu_2022,

  SUM(CASE
        WHEN commodity_desc = 'MUSHROOMS'
             AND group_desc  = 'HORTICULTURE'     THEN value
      END) AS mushroom_prod_2022,

  MAX(CASE
        WHEN commodity_desc = 'MUSHROOMS'
             AND group_desc  = 'HORTICULTURE'     THEN unit_desc
      END) AS mushroom_unit
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND statisticcat_desc = 'PRODUCTION'
  AND agg_level_desc   = 'STATE'
  AND value IS NOT NULL
  AND (
        (commodity_desc = 'CORN'      AND group_desc = 'FIELD CROPS' )
     OR (commodity_desc = 'MUSHROOMS' AND group_desc = 'HORTICULTURE')
      )
GROUP BY state_name
ORDER BY state_name
LIMIT 20;
```
