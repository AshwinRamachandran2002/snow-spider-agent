2025-05-01 02:58:18 - Thread-1063 (execute) - INFO - [Try to run SQL in self-refine]
```sql
WITH corn AS (
  SELECT
    state_name,
    SUM(value) AS corn_production_bu
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND commodity_desc        = 'CORN'
    AND group_desc            = 'FIELD CROPS'
    AND statisticcat_desc     = 'PRODUCTION'
    AND agg_level_desc        = 'STATE'
    AND unit_desc             = 'BU'                          -- bushels
    AND domain_desc           = 'TOTAL'                       -- avoid double‑counting
    AND class_desc            = 'ALL CLASSES'
    AND prodn_practice_desc   = 'ALL PRODUCTION PRACTICES'
    AND util_practice_desc    = 'GRAIN'
    AND value IS NOT NULL
  GROUP BY state_name
),
mushrooms AS (
  /* 1 bushel ≈ 12 lb for mushrooms; convert pounds to bushels               */
  SELECT
    state_name,
    SUM(value) / 12.0 AS mushroom_production_bu
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND commodity_desc        = 'MUSHROOMS'
    AND group_desc            = 'HORTICULTURE'
    AND statisticcat_desc     = 'PRODUCTION'
    AND agg_level_desc        = 'STATE'
    AND unit_desc             = 'LB'                          -- original unit
    AND domain_desc           = 'TOTAL'
    AND class_desc            = 'ALL CLASSES'
    AND prodn_practice_desc   = 'ALL PRODUCTION PRACTICES'
    AND util_practice_desc    = 'ALL UTILIZATION PRACTICES'
    AND value IS NOT NULL
  GROUP BY state_name
)
SELECT
  COALESCE(c.state_name, m.state_name)        AS state,
  ROUND(c.corn_production_bu,       4)        AS corn_production_bu,
  ROUND(m.mushroom_production_bu,   4)        AS mushroom_production_bu
FROM corn c
FULL JOIN mushrooms m
ON c.state_name = m.state_name
ORDER BY state;
```
