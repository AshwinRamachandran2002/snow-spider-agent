FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND statisticcat_desc = 'PRODUCTION'
  AND agg_level_desc = 'STATE'
LIMIT 20;
```

```sql
-- 2. Description: which measurement units are used for corn production in any year?
SELECT DISTINCT unit_desc
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE commodity_desc = 'CORN'
  AND statisticcat_desc = 'PRODUCTION'
LIMIT 20;
```

```sql
-- 3. Description: confirm corn belongs to ‘FIELD CROPS’ group (sanity check).
SELECT DISTINCT group_desc
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE commodity_desc = 'CORN'
  AND statisticcat_desc = 'PRODUCTION'
LIMIT 20;
```

```sql
-- 4. Description: check which units mushrooms are reported in for production.
SELECT DISTINCT unit_desc
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE commodity_desc = 'MUSHROOMS'
  AND statisticcat_desc = 'PRODUCTION'
LIMIT 20;
```

```sql
-- 5. Description: sample 2022 mushroom production rows so we can see structure.
SELECT commodity_desc, group_desc, unit_desc, value, state_name
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND commodity_desc = 'MUSHROOMS'
  AND statisticcat_desc = 'PRODUCTION'
  AND agg_level_desc = 'STATE'
LIMIT 20;
```

```sql
-- 6. Description: 2022 corn production (BU) for 20 states.
SELECT state_name,
       value AS corn_bu_2022
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND commodity_desc = 'CORN'
  AND group_desc = 'FIELD CROPS'
  AND statisticcat_desc = 'PRODUCTION'
  AND agg_level_desc = 'STATE'
  AND unit_desc = 'BU'
  AND value IS NOT NULL
LIMIT 20;
```

```sql
-- 7. Description: 2022 mushroom production (BU) for 20 states.
SELECT state_name,
       value AS mushroom_bu_2022
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND commodity_desc = 'MUSHROOMS'
  AND group_desc = 'HORTICULTURE'
  AND statisticcat_desc = 'PRODUCTION'
  AND agg_level_desc = 'STATE'
  AND unit_desc = 'BU'
  AND value IS NOT NULL
LIMIT 20;
```

```sql
-- 8. Description: combine the two result sets with UNION ALL and show a flag column.
SELECT state_name,
       'CORN'        AS commodity,
       value         AS bu_2022
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND commodity_desc = 'CORN'
  AND group_desc = 'FIELD CROPS'
  AND statisticcat_desc = 'PRODUCTION'
  AND agg_level_desc = 'STATE'
  AND unit_desc = 'BU'
  AND value IS NOT NULL
UNION ALL
SELECT state_name,
       'MUSHROOMS'   AS commodity,
       value         AS bu_2022
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND commodity_desc = 'MUSHROOMS'
  AND group_desc = 'HORTICULTURE'
  AND statisticcat_desc = 'PRODUCTION'
  AND agg_level_desc = 'STATE'
  AND unit_desc = 'BU'
  AND value IS NOT NULL
LIMIT 20;
```

```sql
-- 9. Description: pivot those UNION ALL results so corn and mushrooms sit side by side.
WITH two AS (
  SELECT state_name,
         'CORN' AS commodity,
         value  AS bu_2022
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND commodity_desc = 'CORN'
    AND group_desc = 'FIELD CROPS'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc = 'STATE'
    AND unit_desc = 'BU'
    AND value IS NOT NULL
  UNION ALL
  SELECT state_name,
         'MUSHROOMS',
         value
  FROM `bigquery-public-data.usda_nass_agriculture.crops`
  WHERE year = 2022
    AND commodity_desc = 'MUSHROOMS'
    AND group_desc = 'HORTICULTURE'
    AND statisticcat_desc = 'PRODUCTION'
    AND agg_level_desc = 'STATE'
    AND unit_desc = 'BU'
    AND value IS NOT NULL
)
SELECT state_name,
       MAX(CASE WHEN commodity = 'CORN'      THEN bu_2022 END) AS corn_bu_2022,
       MAX(CASE WHEN commodity = 'MUSHROOMS' THEN bu_2022 END) AS mushroom_bu_2022
FROM two
GROUP BY state_name
LIMIT 20;
```

```sql
-- 10. Description: final query – every state, 2022 production in bushels for corn (FIELD CROPS)
--     and mushrooms (HORTICULTURE).  NULL means no mushroom data in BU for that state.
SELECT
  state_name,
  SUM(CASE
        WHEN commodity_desc = 'CORN'      THEN value
      END) AS corn_bu_2022,
  SUM(CASE
        WHEN commodity_desc = 'MUSHROOMS' THEN value
      END) AS mushroom_bu_2022
FROM `bigquery-public-data.usda_nass_agriculture.crops`
WHERE year = 2022
  AND statisticcat_desc = 'PRODUCTION'
  AND agg_level_desc = 'STATE'
  AND unit_desc = 'BU'
  AND value IS NOT NULL
  AND (
        (commodity_desc = 'CORN'      AND group_desc = 'FIELD CROPS')
     OR (commodity_desc = 'MUSHROOMS' AND group_desc = 'HORTICULTURE')
      )
GROUP BY state_name
ORDER BY state_name
LIMIT 20;
```

The sequence moves from simple inspection of relevant columns to increasingly focussed filters, ending with a single query that returns each U.S. state’s 2022 bushel totals for corn (FIELD CROPS) and mushrooms (HORTICULTURE).
