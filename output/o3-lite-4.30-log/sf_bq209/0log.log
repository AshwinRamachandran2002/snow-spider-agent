--                 then JOIN to the cited set when either the cited publication_number
--                 or application_number matches an element of that array.
--                 We also require the citing patent’s filing_date to be
--                 within the 10‑year window (filing_date ≤ cited_filing + 100000).
--
-- 3) CTE counts : we count DISTINCT citing application_numbers per 2010 patent.
--
-- 4) FINAL      : we count how many 2010 patents ended up with fwd_cite_cnt = 1.
WITH cited AS (
    SELECT
        "publication_number",
        "application_number",
        "filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "grant_date" BETWEEN 20100101 AND 20101231   -- granted in calendar 2010
      AND "application_kind" = 'A'                     -- utility patents
),
fwd AS (
    SELECT
        cited."publication_number"                  AS cited_pub,
        cited."filing_date"                         AS cited_filing,
        citing."application_number"                 AS citing_app,
        citing."filing_date"                        AS citing_filing
    FROM PATENTS.PATENTS.PUBLICATIONS  citing
    CROSS JOIN LATERAL FLATTEN(input => citing."citation") f
    JOIN cited
         ON  f.value:"publication_number"::STRING = cited."publication_number"
          OR f.value:"application_number" ::STRING = cited."application_number"
    WHERE citing."filing_date" <= cited."filing_date" + 100000   -- within 10 yrs
),
counts AS (
    SELECT
        cited_pub,
        COUNT(DISTINCT citing_app) AS fwd_cite_cnt
    FROM fwd
    GROUP BY cited_pub
)
SELECT
    COUNT(*) AS num_utility_patents_2010_with_one_forward_citation
FROM counts
WHERE fwd_cite_cnt = 1;
