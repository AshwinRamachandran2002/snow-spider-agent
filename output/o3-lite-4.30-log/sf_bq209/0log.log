Relevant columns and their potential usage  
• "application_kind": to restrict the analysis to utility patents (most commonly value = 'A').  
• "grant_date": to pick patents granted in the calendar year 2010 (20100101‑20101231).  
• "filing_date": starting date for the 10‑year forward‑citation window.  
• "publication_number": unique identifier that other patents may cite.  
• "application_number": second unique identifier that can also be cited.  
• "citation": VARIANT array that holds the list of patents this document cites; by searching other patents’ "citation" arrays we can discover forward citations.  

Typical conditions you will need  
• "application_kind" = 'A'  
• "grant_date" BETWEEN 20100101 AND 20101231  
• LATERAL FLATTEN on "citation" to see its inner keys (e.g. "publication_number", "application_number").  
• WHERE cited‑doc IN (…) AND citing_doc."filing_date" <= cited_doc."filing_date" + 100000 (≈10 years).  
• GROUP BY cited_doc to COUNT(DISTINCT citing_doc."application_number") = 1.  

Ten step‑by‑step exploratory queries
```sql
-- 1) Description: See one random 2010‑grant utility patent record
SELECT 
  "publication_number",
  "application_number",
  "grant_date",
  "filing_date",
  "application_kind"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "grant_date" BETWEEN 20100101 AND 20101231
  AND "application_kind" = 'A'
LIMIT 20;

-- 2) Description: Inspect the raw structure of the "citation" column for one of those 2010 patents
SELECT 
  "publication_number",
  "citation"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "grant_date" BETWEEN 20100101 AND 20101231
  AND "application_kind" = 'A'
LIMIT 20;

-- 3) Description: Flatten the "citation" array of one 2010 patent to look at the JSON keys
SELECT 
  p."publication_number"  AS "citing_pub_no",
  f.value                 AS "citation_item"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20101231
  AND p."application_kind" = 'A'
LIMIT 20;

-- 4) Description: Pull out possible keys inside each citation object (e.g. cited publication number)
SELECT 
  f.value:"publication_number"::STRING      AS "cited_pub_no",
  f.value:"application_number"::STRING      AS "cited_app_no",
  f.value:"country_code"::STRING            AS "cited_country",
  COUNT(*) AS "freq"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
WHERE p."grant_date" BETWEEN 20100101 AND 20101231
  AND p."application_kind" = 'A'
GROUP BY 1,2,3
LIMIT 20;

-- 5) Description: Find all patents (any grant year) that cite something, flatten their citations
SELECT 
  p."publication_number"                       AS "citing_pub_no",
  p."application_number"                       AS "citing_app_no",
  p."filing_date"                              AS "citing_filing",
  f.value:"publication_number"::STRING         AS "cited_pub_no",
  f.value:"application_number"::STRING         AS "cited_app_no"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."citation") f
LIMIT 20;

-- 6) Description: Build a small sample join – patents granted 2010 (potentially cited) and their forward citations
WITH cited AS (
  SELECT "publication_number", "application_number", "filing_date"
  FROM PATENTS.PATENTS.PUBLICATIONS
  WHERE "grant_date" BETWEEN 20100101 AND 20101231
    AND "application_kind" = 'A'
)
SELECT 
  cited."publication_number"                   AS "2010_patent",
  citing."publication_number"                  AS "citing_pub",
  citing."application_number"                  AS "citing_app",
  citing."filing_date"                         AS "citing_filing"
FROM cited
JOIN PATENTS.PATENTS.PUBLICATIONS citing,
     LATERAL FLATTEN(input => citing."citation") f
       ON (   f.value:"publication_number"::STRING = cited."publication_number"
           OR f.value:"application_number"::STRING = cited."application_number")
WHERE citing."filing_date" <= cited."filing_date" + 100000
LIMIT 20;

-- 7) Description: Count distinct citing applications per 2010 patent inside the 10‑year window
WITH cited AS (
  SELECT "publication_number", "application_number", "filing_date"
  FROM PATENTS.PATENTS.PUBLICATIONS
  WHERE "grant_date" BETWEEN 20100101 AND 20101231
    AND "application_kind" = 'A'
)
SELECT 
  cited."publication_number",
  COUNT(DISTINCT citing."application_number") AS "fwd_cite_cnt"
FROM cited
JOIN PATENTS.PATENTS.PUBLICATIONS citing,
     LATERAL FLATTEN(input => citing."citation") f
       ON (   f.value:"publication_number"::STRING = cited."publication_number"
           OR f.value:"application_number"::STRING = cited."application_number")
WHERE citing."filing_date" <= cited."filing_date" + 100000
GROUP BY cited."publication_number"
LIMIT 20;

-- 8) Description: Pick only those patents with exactly one forward citation in the 10‑year window
WITH cited AS (
  SELECT "publication_number", "application_number", "filing_date"
  FROM PATENTS.PATENTS.PUBLICATIONS
  WHERE "grant_date" BETWEEN 20100101 AND 20101231
    AND "application_kind" = 'A'
), counts AS (
  SELECT 
    cited."publication_number",
    COUNT(DISTINCT citing."application_number") AS "fwd_cite_cnt"
  FROM cited
  JOIN PATENTS.PATENTS.PUBLICATIONS citing,
       LATERAL FLATTEN(input => citing."citation") f
         ON (   f.value:"publication_number"::STRING = cited."publication_number"
             OR f.value:"application_number"::STRING = cited."application_number")
  WHERE citing."filing_date" <= cited."filing_date" + 100000
  GROUP BY cited."publication_number"
)
SELECT *
FROM counts
WHERE "fwd_cite_cnt" = 1
LIMIT 20;

-- 9) Description: Show the citing application that satisfied the “exactly one” condition
WITH cited AS (
  SELECT "publication_number", "application_number", "filing_date"
  FROM PATENTS.PATENTS.PUBLICATIONS
  WHERE "grant_date" BETWEEN 20100101 AND 20101231
    AND "application_kind" = 'A'
), one_cite AS (
  SELECT 
    cited."publication_number"                 AS "2010_patent",
    citing."application_number"                AS "citing_app_no",
    citing."filing_date"                       AS "citing_filing"
  FROM cited
  JOIN PATENTS.PATENTS.PUBLICATIONS citing,
       LATERAL FLATTEN(input => citing."citation") f
         ON (   f.value:"publication_number"::STRING = cited."publication_number"
             OR f.value:"application_number"::STRING = cited."application_number")
  WHERE citing."filing_date" <= cited."filing_date" + 100000
)
SELECT * 
FROM one_cite
QUALIFY COUNT(*) OVER (PARTITION BY "2010_patent") = 1
LIMIT 20;

-- 10) Description: Final aggregate – total number of 2010‑grant utility patents with exactly one forward citation in 10 years
WITH cited AS (
  SELECT "publication_number", "application_number", "filing_date"
  FROM PATENTS.PATENTS.PUBLICATIONS
  WHERE "grant_date" BETWEEN 20100101 AND 20101231
    AND "application_kind" = 'A'
), counts AS (
  SELECT 
    cited."publication_number",
    COUNT(DISTINCT citing."application_number") AS "fwd_cite_cnt"
  FROM cited
  JOIN PATENTS.PATENTS.PUBLICATIONS citing,
       LATERAL FLATTEN(input => citing."citation") f
         ON (   f.value:"publication_number"::STRING = cited."publication_number"
             OR f.value:"application_number"::STRING = cited."application_number")
  WHERE citing."filing_date" <= cited."filing_date" + 100000
  GROUP BY cited."publication_number"
)
SELECT COUNT(*) AS "num_utility_patents_with_one_fwd_cite"
FROM counts
WHERE "fwd_cite_cnt" = 1;
