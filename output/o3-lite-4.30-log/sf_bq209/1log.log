    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "grant_date" BETWEEN 20100101 AND 20101231
      AND "application_kind" = 'A'
),
cite_pairs AS (
    SELECT
        e."publication_number"         AS "early_pub",
        cflat."application_number"     AS "citing_app"
    FROM early e
    JOIN (
        SELECT
            c."application_number",
            c."filing_date",
            f.value:"publication_number"::STRING AS "cited_pub"
        FROM PATENTS.PATENTS.PUBLICATIONS c,
             LATERAL FLATTEN(input => c."citation") f
    ) cflat
      ON cflat."cited_pub" = e."publication_number"
    WHERE cflat."filing_date" BETWEEN e."filing_date" AND (e."filing_date" + 100000)
),
agg AS (
    SELECT
        "early_pub",
        COUNT(DISTINCT "citing_app") AS "forward_cite_cnt"
    FROM cite_pairs
    GROUP BY "early_pub"
)
SELECT *
FROM agg
