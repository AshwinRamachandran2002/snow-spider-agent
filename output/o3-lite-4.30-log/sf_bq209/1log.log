```sql
--Description: Return up to 20 (early_pub, later_pub) pairs where the later publication
--cites a 2010‑granted utility patent.  To be sure we get rows, the CTE “early_cited”
--first keeps only those 2010 patents that really appear in at least one citation list
--anywhere in the database; then we look for citing publications whose filing date
--falls within 10 years of the early patent’s filing date.
WITH early_cited AS (      -- 2010 utility patents that are actually cited
    SELECT DISTINCT
           e."publication_number",
           e."filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS e,
         LATERAL FLATTEN(input => e."citation") f
    WHERE e."grant_date" BETWEEN 20100101 AND 20101231
      AND e."application_kind" = 'A'
      AND e."citation" IS NOT NULL
    LIMIT 50
),
citing_flat AS (           -- every (citing_pub, cited_pub) pair in the database
    SELECT
        c."publication_number"              AS "citing_pub",
        c."application_number"              AS "citing_app_no",
        c."filing_date"                     AS "citing_filing",
        f.value:"publication_number"::STRING AS "cited_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS c,
         LATERAL FLATTEN(input => c."citation") f
)
SELECT
    e."publication_number"  AS "early_pub",
    cf."citing_pub"         AS "later_pub",
    cf."citing_app_no"
FROM early_cited e
JOIN citing_flat cf
  ON cf."cited_pub" = e."publication_number"
WHERE cf."citing_filing" BETWEEN e."filing_date" AND (e."filing_date" + 100000)
LIMIT 20;
```

```sql
--Description: For every 2010‑granted utility patent that is actually cited at least once,
--count the distinct citing application numbers within the 10‑year window, and show a
--sample of the resulting counts (up to 20 rows).
WITH early_cited AS (
    SELECT DISTINCT
           e."publication_number",
           e."filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS e,
         LATERAL FLATTEN(input => e."citation") f
    WHERE e."grant_date" BETWEEN 20100101 AND 20101231
      AND e."application_kind" = 'A'
      AND e."citation" IS NOT NULL
),
cite_pairs AS (
    SELECT
        e."publication_number"                    AS "early_pub",
        cf."citing_app_no"                        AS "citing_app"
    FROM early_cited e
    JOIN (  -- flattened full citation list
        SELECT
            c."application_number"              AS "citing_app_no",
            c."filing_date"                     AS "citing_filing",
            f.value:"publication_number"::STRING AS "cited_pub"
        FROM PATENTS.PATENTS.PUBLICATIONS c,
             LATERAL FLATTEN(input => c."citation") f
    ) cf
      ON cf."cited_pub" = e."publication_number"
    WHERE cf."citing_filing" BETWEEN e."filing_date" AND (e."filing_date" + 100000)
)
SELECT
    "early_pub" AS "publication_number",
    COUNT(DISTINCT "citing_app") AS "forward_cite_cnt"
FROM cite_pairs
GROUP BY "early_pub"
LIMIT 20;
```

```sql
--Description: Show up to 20 of the 2010‑granted utility patents that have EXACTLY one
--distinct forward citation within 10 years of their filing dates.
WITH early_cited AS (
    SELECT DISTINCT
           e."publication_number",
           e."filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS e,
         LATERAL FLATTEN(input => e."citation") f
    WHERE e."grant_date" BETWEEN 20100101 AND 20101231
      AND e."application_kind" = 'A'
      AND e."citation" IS NOT NULL
),
cite_pairs AS (
    SELECT
        e."publication_number"                    AS "early_pub",
        cf."citing_app_no"                        AS "citing_app"
    FROM early_cited e
    JOIN (
        SELECT
            c."application_number"              AS "citing_app_no",
            c."filing_date"                     AS "citing_filing",
            f.value:"publication_number"::STRING AS "cited_pub"
        FROM PATENTS.PATENTS.PUBLICATIONS c,
             LATERAL FLATTEN(input => c."citation") f
    ) cf
      ON cf."cited_pub" = e."publication_number"
    WHERE cf."citing_filing" BETWEEN e."filing_date" AND (e."filing_date" + 100000)
),
agg AS (
    SELECT
        "early_pub",
        COUNT(DISTINCT "citing_app") AS "forward_cite_cnt"
    FROM cite_pairs
    GROUP BY "early_pub"
)
SELECT *
FROM agg
WHERE "forward_cite_cnt" = 1
LIMIT 20;
```

```sql
--Description: Compute the total number of 2010‑granted utility patents that received
--exactly one distinct forward citation inside 10 years of their filing date.
WITH early_cited AS (
    SELECT DISTINCT
           e."publication_number",
           e."filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS e,
         LATERAL FLATTEN(input => e."citation") f
    WHERE e."grant_date" BETWEEN 20100101 AND 20101231
      AND e."application_kind" = 'A'
      AND e."citation" IS NOT NULL
),
cite_pairs AS (
    SELECT
        e."publication_number"                    AS "early_pub",
        cf."citing_app_no"                        AS "citing_app"
    FROM early_cited e
    JOIN (
        SELECT
            c."application_number"              AS "citing_app_no",
            c."filing_date"                     AS "citing_filing",
            f.value:"publication_number"::STRING AS "cited_pub"
        FROM PATENTS.PATENTS.PUBLICATIONS c,
             LATERAL FLATTEN(input => c."citation") f
    ) cf
      ON cf."cited_pub" = e."publication_number"
    WHERE cf."citing_filing" BETWEEN e."filing_date" AND (e."filing_date" + 100000)
),
agg AS (
    SELECT
        "early_pub",
        COUNT(DISTINCT "citing_app") AS "forward_cite_cnt"
    FROM cite_pairs
    GROUP BY "early_pub"
)
SELECT COUNT(*) AS "num_utility_pats_with_one_forward_cite"
FROM agg
WHERE "forward_cite_cnt" = 1;
```

