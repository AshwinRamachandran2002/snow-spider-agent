```sql
--Description: List sample pairs (early_pub, later_pub) where a later publication cites a 2010‑granted
--utility patent, keeping only citing publications filed within 10 years of the early patent’s filing date.
WITH early AS (
    SELECT "publication_number", "filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS
