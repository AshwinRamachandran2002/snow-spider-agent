```sql
--Description: For every 2010‑granted utility patent, count DISTINCT citing application numbers
--that reference it within 10 years of its own filing date, returning a sample of counts.
WITH early AS (
    SELECT "publication_number", "filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "grant_date" BETWEEN 20100101 AND 20101231
      AND "application_kind" = 'A'
),
cite_pairs AS (
    SELECT
        e."publication_number"                    AS "early_pub",
        cflat."application_number"                AS "citing_app",
        cflat."filing_date"                       AS "citing_filing"
    FROM early e
    JOIN (
        SELECT
            c."publication_number",
            c."application_number",
            c."filing_date",
            f.value:"publication_number"::STRING AS "cited_pub"
        FROM PATENTS.PATENTS.PUBLICATIONS c,
             LATERAL FLATTEN(input => c."citation") f
    ) cflat
      ON cflat."cited_pub" = e."publication_number"
    WHERE cflat."filing_date" BETWEEN e."filing_date" AND (e."filing_date" + 100000)
)
SELECT
    "early_pub"          AS "publication_number",
    COUNT(DISTINCT "citing_app") AS "forward_cite_cnt"
FROM cite_pairs
GROUP BY "early_pub"
LIMIT 20;
```

```sql
--Description: Keep only those 2010‑granted utility patents that have EXACTLY one distinct forward
