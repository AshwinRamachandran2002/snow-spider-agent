    c."publication_number"  AS "citing_pub",
    c."application_number"  AS "citing_app_no"
FROM PATENTS.PATENTS.PUBLICATIONS c,
     LATERAL FLATTEN(input => c."citation") f,
     sample_cited s
WHERE f.value:"publication_number"::STRING = s."cited_pub"
LIMIT 20;
