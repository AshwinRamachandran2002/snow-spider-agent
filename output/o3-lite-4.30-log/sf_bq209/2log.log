```sql
--Description:
-- Count how many utility patents granted in 2010 received at least one forward citation
-- (no 10‑year window restriction, and no filter on the citing document’s type).
-- Steps:
--   1. “forward”: explode every citation across the entire PUBLICATIONS table, recording
--      the cited publication number and the citing application number.
--   2.  Take every utility patent whose grant_date is in 2010 and left‑join to “forward”.
--   3.  For each 2010 utility patent, count distinct citing applications and retain
--      those with at least one.  Finally count how many such patents exist.

WITH forward AS (
    SELECT
        f.value:"publication_number"::STRING AS "cited_pub",
        p."application_number"               AS "citing_app"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
),
cited_2010_u AS (
    SELECT
        u."publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS u
    LEFT JOIN forward
           ON forward."cited_pub" = u."publication_number"
    WHERE u."grant_date" BETWEEN 20100101 AND 20101231
      AND u."application_kind" = 'U'
    GROUP BY u."publication_number"
    HAVING COUNT(DISTINCT forward."citing_app") >= 1
)
