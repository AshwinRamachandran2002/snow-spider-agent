FROM PATENTS.PATENTS.PUBLICATIONS s,
     LATERAL FLATTEN( INPUT => s."citation") f
WHERE s."application_kind" = 'U'
  AND s."filing_date" IS NOT NULL
LIMIT 20;
```

```sql
--Description: For every utility patent granted in 2010, count the number of
--distinct citing applications whose filing date falls within a 10‑year window
--that starts on the focal patent’s filing_date.
WITH forward AS (
    SELECT
        f.value:"publication_number"::STRING AS "cited_pub",
        s."application_number"               AS "citing_app",
        s."filing_date"                      AS "citing_filing"
    FROM PATENTS.PATENTS.PUBLICATIONS s,
         LATERAL FLATTEN( INPUT => s."citation") f
    WHERE s."application_kind" = 'U'
      AND s."filing_date" IS NOT NULL
)
SELECT
    p."publication_number",
    p."filing_date",
    COUNT(DISTINCT forward."citing_app") AS "forward_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS p
LEFT JOIN forward
       ON forward."cited_pub" = p."publication_number"
      AND forward."citing_filing"
            BETWEEN p."filing_date" AND p."filing_date" + 100000
WHERE p."grant_date" BETWEEN 20100101 AND 20101231
  AND p."application_kind" = 'U'
GROUP BY p."publication_number", p."filing_date"
LIMIT 20;
```

```sql
--Description: List utility patents granted in 2010 that received exactly one
--distinct forward citation during the 10‑year window after their filing date.
WITH forward AS (
    SELECT
        f.value:"publication_number"::STRING AS "cited_pub",
        s."application_number"               AS "citing_app",
        s."filing_date"                      AS "citing_filing"
    FROM PATENTS.PATENTS.PUBLICATIONS s,
         LATERAL FLATTEN( INPUT => s."citation") f
    WHERE s."application_kind" = 'U'
      AND s."filing_date" IS NOT NULL
)
SELECT
    p."publication_number",
    p."application_number",
    p."filing_date",
    p."grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS p
LEFT JOIN forward
       ON forward."cited_pub" = p."publication_number"
      AND forward."citing_filing"
            BETWEEN p."filing_date" AND p."filing_date" + 100000
WHERE p."grant_date" BETWEEN 20100101 AND 20101231
  AND p."application_kind" = 'U'
GROUP BY
    p."publication_number",
    p."application_number",
    p."filing_date",
    p."grant_date"
HAVING COUNT(DISTINCT forward."citing_app") = 1
LIMIT 20;
```

```sql
--Description: Count the total number of utility patents granted in 2010 that have
--exactly one forward citation within 10 years of their filing_date.
WITH forward AS (
    SELECT
        f.value:"publication_number"::STRING AS "cited_pub",
        s."application_number"               AS "citing_app",
        s."filing_date"                      AS "citing_filing"
    FROM PATENTS.PATENTS.PUBLICATIONS s,
         LATERAL FLATTEN( INPUT => s."citation") f
    WHERE s."application_kind" = 'U'
      AND s."filing_date" IS NOT NULL
), focal AS (
    SELECT
        p."publication_number",
        p."filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p
    WHERE p."grant_date" BETWEEN 20100101 AND 20101231
      AND p."application_kind" = 'U'
)
SELECT
    COUNT(*) AS "utility_granted_2010_one_forward_citation"
FROM focal
LEFT JOIN forward
       ON forward."cited_pub" = focal."publication_number"
      AND forward."citing_filing"
            BETWEEN focal."filing_date" AND focal."filing_date" + 100000
GROUP BY focal."publication_number"
HAVING COUNT(DISTINCT forward."citing_app") = 1
LIMIT 20;
```
