```sql
WITH forward AS (  /* every forward citation that has valid filing date & citing app */
    SELECT
        f.value:"publication_number"::STRING            AS "cited_pub",
        p."application_number"                          AS "citing_app",
        TRY_TO_DATE(p."filing_date"::STRING,'YYYYMMDD') AS "citing_filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
    WHERE TRY_TO_DATE(p."filing_date"::STRING,'YYYYMMDD') IS NOT NULL
      AND p."application_number" IS NOT NULL
      AND f.value:"publication_number" IS NOT NULL
), focal AS (       /* utility patents granted in 2010 having valid filing date */
    SELECT
        pub."publication_number",
        TRY_TO_DATE(pub."filing_date"::STRING,'YYYYMMDD') AS "filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS pub
    WHERE pub."application_kind" = 'U'
      AND pub."grant_date" BETWEEN 20100101 AND 20101231
      AND TRY_TO_DATE(pub."filing_date"::STRING,'YYYYMMDD') IS NOT NULL
), one_citation AS (/* focal patents with exactly 1 distinct forward citation in 10‑yr window */
    SELECT
        fcl."publication_number"
    FROM focal fcl
    LEFT JOIN forward fwd
           ON fwd."cited_pub" = fcl."publication_number"
          AND fwd."citing_filing_date"
                BETWEEN fcl."filing_date"
                    AND DATEADD(year, 10, fcl."filing_date")
    GROUP BY fcl."publication_number"
    HAVING COUNT(DISTINCT fwd."citing_app") = 1
)
SELECT
    2010 AS grant_year,
    COUNT(*) AS patents_with_exactly_one_forward_citation
FROM one_citation;
```
