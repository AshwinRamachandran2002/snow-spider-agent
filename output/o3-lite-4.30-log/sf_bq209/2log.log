SELECT t."publication_number",
       COUNT(*) AS "backward_citation_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."grant_date" BETWEEN 20100101 AND 20101231
  AND t."application_kind" = 'U'
GROUP BY t."publication_number"
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 7. Build a helper list of (cited_pub, citing_application, citing_filing_date)
SELECT
       f.value:"publication_number"::STRING AS "cited_pub",
       s."application_number"               AS "citing_application",
       s."filing_date"                      AS "citing_filing"
FROM PATENTS.PATENTS.PUBLICATIONS s,
     LATERAL FLATTEN(input => s."citation") f
WHERE s."application_kind" = 'U'
  AND s."filing_date" IS NOT NULL
LIMIT 20;
```

```sql
-- 8. For each 2010‑granted patent, count distinct citing applications within 10 years
WITH forward AS (
  SELECT
         f.value:"publication_number"::STRING AS "cited_pub",
         s."application_number"               AS "citing_app",
         s."filing_date"                      AS "citing_filing"
  FROM PATENTS.PATENTS.PUBLICATIONS s,
       LATERAL FLATTEN(input => s."citation") f
  WHERE s."application_kind" = 'U'
    AND s."filing_date" IS NOT NULL
)
SELECT p."publication_number",
       p."filing_date",
       COUNT(DISTINCT forward."citing_app") AS "forward_cnt"
FROM PATENTS.PATENTS.PUBLICATIONS p
LEFT JOIN forward
      ON forward."cited_pub" = p."publication_number"
     AND forward."citing_filing" BETWEEN p."filing_date" AND p."filing_date" + 100000   -- crude +10 years
WHERE p."grant_date" BETWEEN 20100101 AND 20101231
  AND p."application_kind" = 'U'
GROUP BY p."publication_number", p."filing_date"
LIMIT 20;
```

```sql
-- 9. Show only those with exactly one forward citation in the 10‑year window
WITH forward AS (
  SELECT
         f.value:"publication_number"::STRING AS "cited_pub",
         s."application_number"               AS "citing_app",
         s."filing_date"                      AS "citing_filing"
  FROM PATENTS.PATENTS.PUBLICATIONS s,
       LATERAL FLATTEN(input => s."citation") f
  WHERE s."application_kind" = 'U'
    AND s."filing_date" IS NOT NULL
)
SELECT p."publication_number",
       p."application_number",
       p."filing_date",
       p."grant_date"
FROM PATENTS.PATENTS.PUBLICATIONS p
LEFT JOIN forward
      ON forward."cited_pub" = p."publication_number"
     AND forward."citing_filing" BETWEEN p."filing_date" AND p."filing_date" + 100000
WHERE p."grant_date" BETWEEN 20100101 AND 20101231
  AND p."application_kind" = 'U'
GROUP BY p."publication_number",
         p."application_number",
         p."filing_date",
         p."grant_date"
HAVING COUNT(DISTINCT forward."citing_app") = 1
LIMIT 20;
```

```sql
-- 10. (Toward final answer) Retrieve the total count of such patents
WITH forward AS (
  SELECT
         f.value:"publication_number"::STRING AS "cited_pub",
         s."application_number"               AS "citing_app",
         s."filing_date"                      AS "citing_filing"
  FROM PATENTS.PATENTS.PUBLICATIONS s,
