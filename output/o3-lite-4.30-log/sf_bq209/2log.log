```sql
WITH forward AS (
    /* every citation made by a *utility* application, keeping the citing
       application‑number and its filing‑date                       */
    SELECT
        f.value:"publication_number"::STRING            AS "cited_pub",
        p."application_number"                          AS "citing_app",
        TO_DATE(p."filing_date"::VARCHAR,'YYYYMMDD')    AS "citing_filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN( INPUT => p."citation") f
    WHERE p."application_kind" = 'U'
      AND p."filing_date"     IS NOT NULL
      AND p."application_number" IS NOT NULL
      AND f.value:"publication_number" IS NOT NULL
), focal AS (
    /* utility patents granted in 2010 (the focal set) */
    SELECT
        pub."publication_number",
        TO_DATE(pub."filing_date"::VARCHAR,'YYYYMMDD')  AS "filing_date"
    FROM PATENTS.PATENTS.PUBLICATIONS pub
    WHERE pub."application_kind" = 'U'
      AND pub."grant_date" BETWEEN 20100101 AND 20101231
      AND pub."filing_date" IS NOT NULL
)
SELECT
    2010 AS grant_year,
    COUNT(*) AS patents_with_exactly_one_forward_citation
FROM focal
LEFT JOIN forward
       ON forward."cited_pub" = focal."publication_number"
      AND forward."citing_filing_date"
            BETWEEN focal."filing_date"
                AND DATEADD(year, 10, focal."filing_date")
GROUP BY grant_year
HAVING COUNT(DISTINCT forward."citing_app") = 1;
```
