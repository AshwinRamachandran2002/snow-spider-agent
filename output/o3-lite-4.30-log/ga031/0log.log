Begin Exploring Related Columns
Relevant columns for the requested analysis  

• event_date: limit the data set to `20210102`.  
• event_name: keep only `'page_view'` events.  
• event_params  
  – key = 'page_title'  → value.string_value holds the title; look for ‘Home’ and ‘Checkout Confirmation’.  
  – key = 'ga_session_id' → value.int_value gives the visit / session id.  
  – key = 'ga_session_number' (optional) → value.int_value shows visit order.  
• user_pseudo_id: the visitor identifier; combine with `ga_session_id` to create a unique session key.  
• event_timestamp: can be used to order page views inside a session if needed.

Typical filter conditions that will be used  

```
event_date = '20210102'
AND event_name = 'page_view'
AND ep.key = 'page_title'
```

--------------------------------------------------------------------
Ten exploration‑to‑solution queries
--------------------------------------------------------------------

```sql
-- 1)  List all event names that occurred on 2‑Jan‑2021
SELECT DISTINCT event_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE event_date = '20210102'
LIMIT 20;
```

```sql
-- 2)  What parameter keys are present in page_view events?
SELECT DISTINCT ep.key
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS ep
WHERE event_date = '20210102'
  AND event_name = 'page_view'
LIMIT 20;
```

```sql
-- 3)  Sample of page titles that were logged
SELECT DISTINCT ep.value.string_value AS page_title
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS ep
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND ep.key = 'page_title'
LIMIT 20;
```

```sql
-- 4)  Count of each page title on that date (top 20)
SELECT
  ep.value.string_value AS page_title,
  COUNT(*) AS pv
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS ep
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND ep.key = 'page_title'
GROUP BY page_title
ORDER BY pv DESC
LIMIT 20;
```

```sql
-- 5)  Look at ga_session_id values for page_view events
SELECT DISTINCT
  user_pseudo_id,
  (SELECT value.int_value FROM UNNEST(event_params)
   WHERE key = 'ga_session_id' LIMIT 1) AS ga_session_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE event_date = '20210102'
  AND event_name = 'page_view'
LIMIT 20;
```

```sql
-- 6)  Sample sessions that contained the Home page
SELECT DISTINCT
  user_pseudo_id,
  (SELECT value.int_value FROM UNNEST(event_params)
   WHERE key = 'ga_session_id' LIMIT 1) AS ga_session_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS e,
     UNNEST(e.event_params) AS ep
WHERE e.event_date = '20210102'
  AND e.event_name = 'page_view'
  AND ep.key = 'page_title'
  AND ep.value.string_value = 'Home'
LIMIT 20;
```

```sql
-- 7)  Sample sessions that contained BOTH Home and Checkout Confirmation pages
WITH pages AS (
  SELECT
    user_pseudo_id,
    (SELECT value.int_value FROM UNNEST(event_params)
     WHERE key = 'ga_session_id' LIMIT 1) AS ga_session_id,
    MAX(IF(ep.key = 'page_title' AND ep.value.string_value = 'Home', 1, 0))  AS has_home,
    MAX(IF(ep.key = 'page_title' AND ep.value.string_value = 'Checkout Confirmation', 1, 0)) AS has_confirm
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS ep
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
  GROUP BY user_pseudo_id, ga_session_id
)
SELECT user_pseudo_id, ga_session_id
FROM pages
WHERE has_home = 1 AND has_confirm = 1
LIMIT 20;
```

```sql
-- 8)  How many sessions had a Home page view?
SELECT COUNT(*) AS sessions_with_home
FROM (
  SELECT DISTINCT user_pseudo_id,
                  (SELECT value.int_value FROM UNNEST(event_params)
                   WHERE key = 'ga_session_id' LIMIT 1) AS ga_session_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS e,
       UNNEST(e.event_params) AS ep
  WHERE e.event_date = '20210102'
    AND e.event_name = 'page_view'
    AND ep.key = 'page_title'
    AND ep.value.string_value = 'Home'
)
LIMIT 20;
```

```sql
-- 9)  How many of those sessions also reached Checkout Confirmation?
WITH pages AS (
  SELECT
    user_pseudo_id,
    (SELECT value.int_value FROM UNNEST(event_params)
     WHERE key = 'ga_session_id' LIMIT 1) AS ga_session_id,
    MAX(IF(ep.key = 'page_title' AND ep.value.string_value = 'Home', 1, 0))  AS has_home,
    MAX(IF(ep.key = 'page_title' AND ep.value.string_value = 'Checkout Confirmation', 1, 0)) AS has_confirm
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS ep
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
  GROUP BY user_pseudo_id, ga_session_id
)
SELECT
  COUNTIF(has_home = 1)                    AS sessions_with_home,
  COUNTIF(has_home = 1 AND has_confirm=1)  AS sessions_with_home_and_confirmation
FROM pages
LIMIT 20;
```

```sql
-- 10)  Final conversion‑rate calculation for 2‑Jan‑2021
--      (% of sessions that had both Home and Confirmation among sessions with Home)
WITH pages AS (
  SELECT
    user_pseudo_id,
    (SELECT value.int_value FROM UNNEST(event_params)
     WHERE key = 'ga_session_id' LIMIT 1) AS ga_session_id,
    MAX(IF(ep.key = 'page_title' AND ep.value.string_value = 'Home', 1, 0))  AS has_home,
    MAX(IF(ep.key = 'page_title' AND ep.value.string_value = 'Checkout Confirmation', 1, 0)) AS has_confirm
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS ep
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
  GROUP BY user_pseudo_id, ga_session_id
)
SELECT
  SAFE_DIVIDE(
      COUNTIF(has_home = 1 AND has_confirm = 1),
      COUNTIF(has_home = 1)
  ) * 100 AS conversion_rate_percent
FROM pages
LIMIT 20;
```

These ten queries take you from basic inspection all the way to the final session‑conversion‑rate figure for January 2 2021, using only `page_view` events and the GA4 session fields contained in `event_params`.
