```sql
--Description:
-- Compute the Home‑to‑Checkout‑Confirmation session conversion rate for 2‑Jan‑2021
-- while showing the reasoning inside the query.
-- • Step‑1 page_views CTE:
--     • keep only events from 20210102 with event_name = 'page_view'.
--     • extract ga_session_id and page_title out of event_params.
--     • discard rows where page_title IS NULL to avoid ARRAY_AGG errors later.
-- • Step‑2 sessions CTE:
--     • aggregate DISTINCT, non‑null page titles per (user_pseudo_id, ga_session_id)
--       so each row represents one visit/session with its set of pages.
-- • Step‑3 totals CTE:
--     • count how many sessions include 'Home'.
--     • count how many of those also include 'Checkout Confirmation'.
-- • Final SELECT:
--     • return both counts and the conversion rate as a percentage.
WITH page_views AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
     FROM UNNEST(event_params) ep
     WHERE ep.key = 'ga_session_id') AS ga_session_id,
    (SELECT ep.value.string_value
     FROM UNNEST(event_params) ep
     WHERE ep.key = 'page_title')    AS page_title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
    -- remove rows where page_title is NULL so later ARRAY_AGG has no nulls
    AND (SELECT ep.value.string_value
         FROM UNNEST(event_params) ep
         WHERE ep.key = 'page_title') IS NOT NULL
),
sessions AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    ARRAY_AGG(DISTINCT page_title) AS pages
  FROM page_views
  GROUP BY user_pseudo_id, ga_session_id
),
totals AS (
  SELECT
    COUNTIF('Home' IN UNNEST(pages)) AS sessions_with_home,
    COUNTIF('Home' IN UNNEST(pages)
            AND 'Checkout Confirmation' IN UNNEST(pages))
        AS sessions_home_and_checkout
  FROM sessions
)
SELECT
  sessions_home_and_checkout,
  sessions_with_home,
  SAFE_DIVIDE(sessions_home_and_checkout, sessions_with_home) * 100
      AS conversion_rate_percent
FROM totals;
```
