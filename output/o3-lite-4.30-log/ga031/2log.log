```sql
-- 7. Build a light session table (one row per page_view)
SELECT
  user_pseudo_id,
  (SELECT ev.value.int_value
   FROM UNNEST(event_params) ev
   WHERE ev.key = 'ga_session_id')   AS ga_session_id,
  (SELECT ev.value.string_value
   FROM UNNEST(event_params) ev
   WHERE ev.key = 'page_title')      AS page_title
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE event_date = '20210102'
  AND event_name = 'page_view'
LIMIT 20;
```

```sql
-- 8. One row per session with an ARRAY of distinct pages visited
WITH page_views AS (
  SELECT
    user_pseudo_id,
    (SELECT ev.value.int_value
     FROM UNNEST(event_params) ev
     WHERE ev.key = 'ga_session_id') AS ga_session_id,
    (SELECT ev.value.string_value
     FROM UNNEST(event_params) ev
     WHERE ev.key = 'page_title')    AS page_title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
)
SELECT
  user_pseudo_id,
  ga_session_id,
  ARRAY_AGG(DISTINCT page_title) AS pages_in_session
FROM page_views
GROUP BY user_pseudo_id, ga_session_id
LIMIT 20;
