FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS ep
WHERE event_date = '20210102'
  AND event_name = 'page_view'
LIMIT 20;
```

```sql
-- 3. Distinct page titles that appear in page_view events
SELECT DISTINCT
       ep.value.string_value AS page_title
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS ep
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND ep.key = 'page_title'
LIMIT 20;
```

```sql
-- 4. Distinct page URLs (page_location) in the same data
SELECT DISTINCT
       ep.value.string_value AS page_location
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS ep
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND ep.key = 'page_location'
LIMIT 20;
```

```sql
-- 5. Sample rows of page_view events whose page_title contains 'Home'
SELECT
  user_pseudo_id,
  (SELECT ev.value.int_value
   FROM UNNEST(event_params) ev
   WHERE ev.key = 'ga_session_id') AS ga_session_id,
  (SELECT ev.value.string_value
   FROM UNNEST(event_params) ev
   WHERE ev.key = 'page_title')    AS page_title
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND LOWER(
        (SELECT ev.value.string_value
         FROM UNNEST(event_params) ev
         WHERE ev.key = 'page_title')
      ) LIKE '%home%'
LIMIT 20;
```

```sql
-- 6. Sample rows of page_view events whose page_title contains 'Checkout Confirmation'
SELECT
  user_pseudo_id,
  (SELECT ev.value.int_value
   FROM UNNEST(event_params) ev
   WHERE ev.key = 'ga_session_id') AS ga_session_id,
  (SELECT ev.value.string_value
   FROM UNNEST(event_params) ev
   WHERE ev.key = 'page_title')    AS page_title
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND LOWER(
        (SELECT ev.value.string_value
         FROM UNNEST(event_params) ev
         WHERE ev.key = 'page_title')
      ) LIKE '%checkout%confirmation%'
LIMIT 20;
```

```sql
-- 7. Build a light session table (one row per page_view)
SELECT
  user_pseudo_id,
  (SELECT ev.value.int_value
   FROM UNNEST(event_params) ev
   WHERE ev.key = 'ga_session_id')   AS ga_session_id,
  (SELECT ev.value.string_value
   FROM UNNEST(event_params) ev
   WHERE ev.key = 'page_title')      AS page_title
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE event_date = '20210102'
  AND event_name = 'page_view'
LIMIT 20;
```

```sql
-- 8. One row per session with an ARRAY of distinct pages visited
WITH page_views AS (
  SELECT
    user_pseudo_id,
    (SELECT ev.value.int_value
     FROM UNNEST(event_params) ev
     WHERE ev.key = 'ga_session_id') AS ga_session_id,
    (SELECT ev.value.string_value
     FROM UNNEST(event_params) ev
     WHERE ev.key = 'page_title')    AS page_title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
)
SELECT
  user_pseudo_id,
  ga_session_id,
  ARRAY_AGG(DISTINCT page_title) AS pages_in_session
FROM page_views
GROUP BY user_pseudo_id, ga_session_id
LIMIT 20;
```

```sql
-- 9. Count sessions that contain Home, and those that contain both Home & Checkout Confirmation
WITH page_views AS (
  SELECT
    user_pseudo_id,
    (SELECT ev.value.int_value
     FROM UNNEST(event_params) ev
     WHERE ev.key = 'ga_session_id') AS ga_session_id,
    (SELECT ev.value.string_value
     FROM UNNEST(event_params) ev
     WHERE ev.key = 'page_title')    AS page_title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
),
sessions AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    ARRAY_AGG(DISTINCT page_title) AS pages
  FROM page_views
  GROUP BY user_pseudo_id, ga_session_id
)
SELECT
  COUNTIF('Home' IN UNNEST(pages))                                              AS sessions_with_home,
  COUNTIF('Home' IN UNNEST(pages)
          AND 'Checkout Confirmation' IN UNNEST(pages))                        AS sessions_home_and_checkout
FROM sessions
LIMIT 20;
```

```sql
-- 10. FINAL: compute the Home → Checkout Confirmation conversion rate for 2‑Jan‑2021
WITH page_views AS (
  SELECT
    user_pseudo_id,
    (SELECT ev.value.int_value
     FROM UNNEST(event_params) ev
     WHERE ev.key = 'ga_session_id') AS ga_session_id,
    (SELECT ev.value.string_value
     FROM UNNEST(event_params) ev
     WHERE ev.key = 'page_title')    AS page_title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
),
sessions AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    ARRAY_AGG(DISTINCT page_title) AS pages
  FROM page_views
  GROUP BY user_pseudo_id, ga_session_id
),
totals AS (
  SELECT
    COUNTIF('Home' IN UNNEST(pages))                                             AS sessions_with_home,
    COUNTIF('Home' IN UNNEST(pages)
            AND 'Checkout Confirmation' IN UNNEST(pages))                       AS sessions_home_and_checkout
  FROM sessions
)
SELECT
  sessions_home_and_checkout,
  sessions_with_home,
  SAFE_DIVIDE(sessions_home_and_checkout, sessions_with_home) * 100
     AS conversion_rate_percent
FROM totals
LIMIT 20;
```

Running the last query will return the two session counts and the “Home → Checkout Confirmation” conversion rate (in %).
