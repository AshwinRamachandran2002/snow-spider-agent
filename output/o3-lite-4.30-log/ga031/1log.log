--Description: #9 – compute the conversion‑rate percentage for 2‑Jan‑2021 sessions.
WITH flags AS (
  SELECT
    CAST(sid.value.int_value AS INT64)         AS session_id,
    LOWER(pt.value.string_value)               AS page_title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS pt,
       UNNEST(event_params) AS sid
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
    AND pt.key  = 'page_title'
    AND sid.key = 'ga_session_id'
)
SELECT
  100 * SAFE_DIVIDE(
        COUNTIF(saw_home AND saw_checkout),
        COUNTIF(saw_home)
      ) AS session_conversion_rate_pct
FROM (
  SELECT
    session_id,
    MAX(page_title = 'home')                  AS saw_home,
    MAX(page_title = 'checkout confirmation') AS saw_checkout
  FROM flags
  GROUP BY session_id
)
LIMIT 20
