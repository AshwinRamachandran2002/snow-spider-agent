Begin Exploring Related Columns
Key columns & their possible usage  

• event_date: filter strictly to the single day “20210102”.  
• event_name: keep only the “page_view” rows.  
• event_params:  
  – key = "page_title" ➜ shows which page was viewed (“Home”, “Checkout Confirmation”, …).  
  – key = "ga_session_id" ➜ the numeric session identifier that lets us group all hits that belong to one visit.  
• user_pseudo_id: optional secondary key when we want to make sure the same visitor is being analysed.  

Essential WHERE‑clauses we will apply repeatedly  

• event_date = '20210102'  
• event_name = 'page_view'  
• LOWER(page_title) IN ('home', 'checkout confirmation') (when we need only those two pages)  

Below are ten exploratory → increasingly complex queries (all capped with LIMIT 20) that walk through the logic up to the final conversion‑rate calculation.  
Every query is preceded by a short description.

```sql
-- 1. Quick look at any events from 2‑Jan‑2021
SELECT *
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
LIMIT 20;
```

```sql
-- 2. Only the page_view hits of that day
SELECT event_timestamp, user_pseudo_id, event_params
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`
WHERE event_date = '20210102'
  AND event_name = 'page_view'
LIMIT 20;
```

```sql
-- 3. Extract page_title values to see what titles exist
SELECT DISTINCT
       JSON_VALUE(param.value, '$.string_value') AS page_title
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS param
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND param.key = 'page_title'
LIMIT 20;
```

```sql
-- 4. Show sample Home page views with their session id
SELECT user_pseudo_id,
       JSON_VALUE(pt.value,  '$.string_value') AS page_title,
       JSON_VALUE(sid.value, '$.int_value')    AS session_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params)  AS pt,
     UNNEST(event_params)  AS sid
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND pt.key  = 'page_title'
  AND LOWER(JSON_VALUE(pt.value,  '$.string_value')) = 'home'
  AND sid.key = 'ga_session_id'
LIMIT 20;
```

```sql
-- 5. Show sample Checkout‑Confirmation page views with their session id
SELECT user_pseudo_id,
       JSON_VALUE(pt.value,  '$.string_value') AS page_title,
       JSON_VALUE(sid.value, '$.int_value')    AS session_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params)  AS pt,
     UNNEST(event_params)  AS sid
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND pt.key  = 'page_title'
  AND LOWER(JSON_VALUE(pt.value,  '$.string_value')) = 'checkout confirmation'
  AND sid.key = 'ga_session_id'
LIMIT 20;
```

```sql
-- 6. List every page_view on Home or Checkout Confirmation with a tidy column set
SELECT user_pseudo_id,
       CAST(JSON_VALUE(sid.value, '$.int_value') AS INT64)    AS session_id,
       LOWER(JSON_VALUE(pt.value, '$.string_value'))          AS page_title
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
     UNNEST(event_params) AS pt,
     UNNEST(event_params) AS sid
WHERE event_date = '20210102'
  AND event_name = 'page_view'
  AND pt.key  = 'page_title'
  AND LOWER(JSON_VALUE(pt.value, '$.string_value')) IN ('home','checkout confirmation')
  AND sid.key = 'ga_session_id'
LIMIT 20;
```

```sql
-- 7. For every session, flag whether Home and/or Checkout Confirmation appeared
WITH hits AS (
  SELECT
    CAST(JSON_VALUE(sid.value,'$.int_value') AS INT64)     AS session_id,
    LOWER(JSON_VALUE(pt.value,'$.string_value'))           AS page_title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS pt,
       UNNEST(event_params) AS sid
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
    AND pt.key  = 'page_title'
    AND sid.key = 'ga_session_id'
)
SELECT session_id,
       MAX(page_title = 'home')                 AS saw_home,
       MAX(page_title = 'checkout confirmation') AS saw_checkout
FROM hits
GROUP BY session_id
LIMIT 20;
```

```sql
-- 8. Count the sessions that landed on Home (denominator) and
--    those among them that also hit Checkout Confirmation (numerator)
WITH flags AS (
  SELECT
    CAST(JSON_VALUE(sid.value,'$.int_value') AS INT64)     AS session_id,
    LOWER(JSON_VALUE(pt.value,'$.string_value'))           AS page_title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS pt,
       UNNEST(event_params) AS sid
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
    AND pt.key  = 'page_title'
    AND sid.key = 'ga_session_id'
)
SELECT
  COUNTIF(saw_home)                                   AS sessions_landed_home,
  COUNTIF(saw_home AND saw_checkout)                  AS sessions_home_and_checkout
FROM (
  SELECT
    session_id,
    MAX(page_title = 'home')                  AS saw_home,
    MAX(page_title = 'checkout confirmation') AS saw_checkout
  FROM flags
  GROUP BY session_id
)
LIMIT 20;
```

```sql
-- 9. Compute the conversion‑rate percentage
WITH flags AS (
  SELECT
    CAST(JSON_VALUE(sid.value,'$.int_value') AS INT64)     AS session_id,
    LOWER(JSON_VALUE(pt.value,'$.string_value'))           AS page_title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS pt,
       UNNEST(event_params) AS sid
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
    AND pt.key  = 'page_title'
    AND sid.key = 'ga_session_id'
)
SELECT
  100 * SAFE_DIVIDE(
        COUNTIF(saw_home AND saw_checkout),
        COUNTIF(saw_home)
       ) AS session_conversion_rate_pct
FROM (
  SELECT
    session_id,
    MAX(page_title = 'home')                  AS saw_home,
    MAX(page_title = 'checkout confirmation') AS saw_checkout
  FROM flags
  GROUP BY session_id
)
LIMIT 20;
```

```sql
-- 10. Same result but also show raw counts so it is self‑contained
WITH page_hits AS (
  SELECT
    CAST(JSON_VALUE(sid.value,'$.int_value') AS INT64)     AS session_id,
    LOWER(JSON_VALUE(pt.value,'$.string_value'))           AS page_title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS pt,
       UNNEST(event_params) AS sid
  WHERE event_date = '20210102'
    AND event_name = 'page_view'
    AND pt.key  = 'page_title'
    AND sid.key = 'ga_session_id'
),
session_flags AS (
  SELECT
    session_id,
    MAX(page_title = 'home')                  AS saw_home,
    MAX(page_title = 'checkout confirmation') AS saw_checkout
  FROM page_hits
  GROUP BY session_id
)
SELECT
  COUNTIF(saw_home)                               AS sessions_on_home,
  COUNTIF(saw_home AND saw_checkout)              AS sessions_reached_checkout,
  100 * SAFE_DIVIDE(
        COUNTIF(saw_home AND saw_checkout),
        COUNTIF(saw_home)
      )                                           AS conversion_rate_pct
FROM session_flags
LIMIT 20;
```

