The table structure information is (table names): 
['player', 'team', 'match', 'player_match', 'ball_by_ball', 'batsman_scored', 'wicket_taken', 'extra_runs']
Begin Exploring Related Columns
Relevant columns and their potential usage  
• batsman_scored.runs_scored : add up to get every player’s runs in a match  
• batsman_scored.match_id / over_id / ball_id / innings_no : join keys to ball_by_ball  
• ball_by_ball.striker : the player (‑id) who faced the ball and scored those runs  
• player_match.team_id : the team that the player represented in that match  
• match.match_winner : id of the team that won the match – used to know if the player’s side lost  
• player.player_name : name to be returned  

Essential conditions  
1. SUM(batsman_scored.runs_scored) ≥ 100 – player hit a century  
2. player_match.team_id ≠ match.match_winner – that player’s team lost the game  

Ten exploratory → final queries
```sql
-- 1. Inspect raw runs–per‑ball data
SELECT * 
FROM batsman_scored 
LIMIT 20;

-- 2. Attach the striker (batsman) to every scoring event
SELECT b.match_id, b.over_id, b.ball_id, bb.striker, b.runs_scored
FROM batsman_scored AS b
JOIN ball_by_ball  AS bb
  ON b.match_id = bb.match_id
 AND b.over_id   = bb.over_id
 AND b.ball_id   = bb.ball_id
 AND b.innings_no= bb.innings_no
LIMIT 20;

-- 3. Total runs by each batsman in each match
SELECT b.match_id, bb.striker AS player_id, 
       SUM(b.runs_scored) AS total_runs
FROM batsman_scored AS b
JOIN ball_by_ball AS bb
  ON b.match_id = bb.match_id
 AND b.over_id  = bb.over_id
 AND b.ball_id  = bb.ball_id
 AND b.innings_no = bb.innings_no
GROUP BY b.match_id, bb.striker
LIMIT 20;

-- 4. Batsmen who reached at least 100 in a match
SELECT b.match_id, bb.striker AS player_id, 
       SUM(b.runs_scored) AS total_runs
FROM batsman_scored AS b
JOIN ball_by_ball AS bb
  ON b.match_id = bb.match_id
 AND b.over_id  = bb.over_id
 AND b.ball_id  = bb.ball_id
 AND b.innings_no = bb.innings_no
GROUP BY b.match_id, bb.striker
HAVING total_runs >= 100
LIMIT 20;

-- 5. Add player names to those centuries
SELECT p.player_name, t1.*
FROM (
    SELECT b.match_id, bb.striker AS player_id, 
           SUM(b.runs_scored) AS total_runs
    FROM batsman_scored AS b
    JOIN ball_by_ball AS bb
      ON b.match_id = bb.match_id
     AND b.over_id  = bb.over_id
     AND b.ball_id  = bb.ball_id
     AND b.innings_no = bb.innings_no
    GROUP BY b.match_id, bb.striker
    HAVING total_runs >= 100
) AS t1
JOIN player AS p 
  ON p.player_id = t1.player_id
LIMIT 20;

-- 6. Add the side (team_id) that each centurion played for
SELECT t1.match_id, t1.player_id, p.player_name, 
       pm.team_id, t1.total_runs
FROM (
    SELECT b.match_id, bb.striker AS player_id, 
           SUM(b.runs_scored) AS total_runs
    FROM batsman_scored AS b
    JOIN ball_by_ball AS bb
      ON b.match_id = bb.match_id
     AND b.over_id  = bb.over_id
     AND b.ball_id  = bb.ball_id
     AND b.innings_no = bb.innings_no
    GROUP BY b.match_id, bb.striker
    HAVING total_runs >= 100
) AS t1
JOIN player_match AS pm
  ON pm.match_id = t1.match_id
 AND pm.player_id = t1.player_id
JOIN player AS p
  ON p.player_id = t1.player_id
LIMIT 20;

-- 7. Compare with match winner – find centuries for the losing side
SELECT t1.match_id, p.player_name, 
       pm.team_id      AS players_team,
       m.match_winner  AS winning_team,
       t1.total_runs
FROM (
    SELECT b.match_id, bb.striker AS player_id, 
           SUM(b.runs_scored) AS total_runs
    FROM batsman_scored AS b
    JOIN ball_by_ball AS bb
      ON b.match_id = bb.match_id
     AND b.over_id  = bb.over_id
     AND b.ball_id  = bb.ball_id
     AND b.innings_no = bb.innings_no
    GROUP BY b.match_id, bb.striker
    HAVING total_runs >= 100
) AS t1
JOIN player_match AS pm
  ON pm.match_id = t1.match_id
 AND pm.player_id = t1.player_id
JOIN match AS m
  ON m.match_id = t1.match_id
JOIN player AS p
  ON p.player_id = t1.player_id
WHERE pm.team_id <> m.match_winner
LIMIT 20;

-- 8. Same as 7 but bring actual team names and order by runs
SELECT p.player_name, t.name AS players_team_name, 
       t1.total_runs
FROM (
    SELECT b.match_id, bb.striker AS player_id, 
           SUM(b.runs_scored) AS total_runs
    FROM batsman_scored AS b
    JOIN ball_by_ball AS bb
      ON b.match_id = bb.match_id
     AND b.over_id  = bb.over_id
     AND b.ball_id  = bb.ball_id
     AND b.innings_no = bb.innings_no
    GROUP BY b.match_id, bb.striker
    HAVING total_runs >= 100
) AS t1
JOIN player_match AS pm
  ON pm.match_id = t1.match_id
 AND pm.player_id = t1.player_id
JOIN match AS m
  ON m.match_id = t1.match_id
JOIN team  AS t
  ON t.team_id = pm.team_id
JOIN player AS p
  ON p.player_id = t1.player_id
WHERE pm.team_id <> m.match_winner
ORDER BY t1.total_runs DESC
LIMIT 20;

-- 9. CTE‑based result (match_id, name, runs) when the team lost
WITH player_centuries AS (
    SELECT b.match_id, bb.striker AS player_id,
           SUM(b.runs_scored) AS total_runs
    FROM batsman_scored AS b
    JOIN ball_by_ball AS bb
      ON b.match_id = bb.match_id
     AND b.over_id  = bb.over_id
     AND b.ball_id  = bb.ball_id
     AND b.innings_no = bb.innings_no
    GROUP BY b.match_id, bb.striker
    HAVING total_runs >= 100
)
SELECT pc.match_id, p.player_name, pc.total_runs
FROM player_centuries AS pc
JOIN player_match AS pm
  ON pm.match_id = pc.match_id
 AND pm.player_id = pc.player_id
JOIN match AS m
  ON m.match_id = pc.match_id
JOIN player AS p
  ON p.player_id = pc.player_id
WHERE pm.team_id <> m.match_winner
LIMIT 20;

-- 10. FINAL ANSWER – distinct names of players with 100+ whose team lost
WITH player_centuries AS (
    SELECT b.match_id, bb.striker AS player_id,
           SUM(b.runs_scored) AS total_runs
    FROM batsman_scored AS b
    JOIN ball_by_ball AS bb
      ON b.match_id = bb.match_id
     AND b.over_id  = bb.over_id
     AND b.ball_id  = bb.ball_id
     AND b.innings_no = bb.innings_no
    GROUP BY b.match_id, bb.striker
    HAVING total_runs >= 100
)
SELECT DISTINCT p.player_name
FROM player_centuries AS pc
JOIN player_match AS pm
  ON pm.match_id = pc.match_id
 AND pm.player_id = pc.player_id
JOIN match AS m
  ON m.match_id = pc.match_id
JOIN player AS p
  ON p.player_id = pc.player_id
WHERE pm.team_id <> m.match_winner;
```
