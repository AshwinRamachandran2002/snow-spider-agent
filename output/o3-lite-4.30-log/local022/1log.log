-- 8. Keep rows where the batsman's team actually lost
SELECT p.player_name, x.match_id,
       pm.team_id, m.match_winner,
       x.total_runs
FROM (
      SELECT b.match_id,
             b.striker          AS player_id,
             SUM(s.runs_scored) AS total_runs
      FROM   "ball_by_ball" AS b
      JOIN   "batsman_scored" AS s
        ON   b.match_id   = s.match_id
       AND   b.over_id    = s.over_id
       AND   b.ball_id    = s.ball_id
       AND   b.innings_no = s.innings_no
      GROUP BY b.match_id, b.striker
      HAVING SUM(s.runs_scored) >= 100
) AS x
JOIN "player_match" AS pm
  ON pm.match_id  = x.match_id
 AND pm.player_id = x.player_id
JOIN "match" AS m
  ON m.match_id = x.match_id
JOIN "player" AS p
  ON p.player_id = x.player_id
WHERE m.match_winner IS NOT NULL
  AND pm.team_id <> m.match_winner
LIMIT 20;
