Begin Exploring Related Columns
Relevant tables / columns and their usage
• model_score.name : problem identifier to be compared across tables  
• model_score.version : version identifier so that comparisons are done inside the same version  
• model_score.step : limits the analysis to steps 1, 2 and 3  
• model_score.model : used to separate “Stack” models  (model LIKE '%Stack%') from the other models  
• model_score.test_score : metric we compare (best non‑Stack vs Stack)  

• solution.name : counts how many times each problem appears in the solution table  
• solution.version : allows the count above to be done by (name, version) when needed  

Typical conditions that will be used  
• model_score.step IN (1,2,3)                        – restrict to the required steps  
• model_score.model  LIKE '%Stack%'                  – select the Stack models  
• model_score.model NOT LIKE '%Stack%'               – select the non‑Stack models  
• st.stack_test  > ns.max_non_stack_test             – Stack outperforms the best non‑Stack  

Exploratory‑to‑final SQL queries
```sql
-- 1. Distinct problem names present in the model_score table
SELECT DISTINCT name
FROM model_score
LIMIT 20;
```

```sql
-- 2. Inspect different model names to see how the “Stack” models are labelled
SELECT DISTINCT model
FROM model_score
WHERE model LIKE '%Stack%'
LIMIT 20;
```

```sql
-- 3. Maximum test‑score of all NON‑Stack models per problem / version / step
SELECT  name,
        version,
        step,
        MAX(test_score) AS max_non_stack_test
FROM    model_score
WHERE   model NOT LIKE '%Stack%'
GROUP BY name, version, step
LIMIT 20;
```

```sql
-- 4. Test‑score of the Stack model (or the best one if several) per problem / version / step
SELECT  name,
        version,
        step,
        MAX(test_score) AS stack_test
FROM    model_score
WHERE   model LIKE '%Stack%'
GROUP BY name, version, step
LIMIT 20;
```

```sql
-- 5. Compare the two scores obtained above and keep the cases where Stack wins
SELECT  ns.name,
        ns.version,
        ns.step,
        ns.max_non_stack_test,
        st.stack_test
FROM   ( SELECT name, version, step, MAX(test_score) AS max_non_stack_test
         FROM   model_score
         WHERE  model NOT LIKE '%Stack%' AND step IN (1,2,3)
         GROUP  BY name, version, step ) AS ns
JOIN   ( SELECT name, version, step, MAX(test_score) AS stack_test
         FROM   model_score
         WHERE  model LIKE '%Stack%' AND step IN (1,2,3)
         GROUP  BY name, version, step ) AS st
      ON  ns.name    = st.name
      AND ns.version = st.version
      AND ns.step    = st.step
WHERE  st.stack_test > ns.max_non_stack_test
LIMIT 20;
```

```sql
-- 6. For every (problem, version) count how many steps 1‑3 satisfy “Stack > best non‑Stack”
SELECT  name,
        version,
        COUNT(*) AS outperform_steps
FROM   (
        /* query 5 without the LIMIT */
        SELECT  ns.name, ns.version, ns.step
        FROM   ( SELECT name, version, step, MAX(test_score) AS max_non_stack_test
                 FROM   model_score
                 WHERE  model NOT LIKE '%Stack%' AND step IN (1,2,3)
                 GROUP  BY name, version, step ) AS ns
        JOIN   ( SELECT name, version, step, MAX(test_score) AS stack_test
                 FROM   model_score
                 WHERE  model LIKE '%Stack%' AND step IN (1,2,3)
                 GROUP  BY name, version, step ) AS st
              ON  ns.name    = st.name
              AND ns.version = st.version
              AND ns.step    = st.step
        WHERE  st.stack_test > ns.max_non_stack_test
       ) AS t
GROUP BY name, version
LIMIT 20;
```

```sql
-- 7. Count how many rows each problem has in the solution table (all versions together)
SELECT  name,
        COUNT(*) AS solution_occurrences
FROM    solution
GROUP BY name
LIMIT 20;
```

```sql
-- 8. Same as 7 but broken down by (problem, version)
SELECT  name,
        version,
        COUNT(*) AS solution_occurrences
FROM    solution
GROUP BY name, version
LIMIT 20;
```

```sql
-- 9. Compare the “outperform_steps” with the number of solution rows
--    Keep (problem, version) where the first number exceeds the second
SELECT  o.name,
        o.version,
        o.outperform_steps,
        s.solution_occurrences
FROM  ( /* counts obtained in query 6 */
        SELECT  name, version, COUNT(*) AS outperform_steps
        FROM   (
                 SELECT  ns.name, ns.version, ns.step
                 FROM   ( SELECT name, version, step, MAX(test_score) AS max_non_stack_test
                          FROM   model_score
                          WHERE  model NOT LIKE '%Stack%' AND step IN (1,2,3)
                          GROUP  BY name, version, step ) AS ns
                 JOIN   ( SELECT name, version, step, MAX(test_score) AS stack_test
                          FROM   model_score
                          WHERE  model LIKE '%Stack%' AND step IN (1,2,3)
                          GROUP  BY name, version, step ) AS st
                       ON  ns.name    = st.name
                       AND ns.version = st.version
                       AND ns.step    = st.step
                 WHERE  st.stack_test > ns.max_non_stack_test
               ) AS t
        GROUP BY name, version
      ) AS o
JOIN  ( /* counts from query 8 */
        SELECT  name, version, COUNT(*) AS solution_occurrences
        FROM    solution
        GROUP BY name, version
      ) AS s
  ON  o.name    = s.name
  AND o.version = s.version
WHERE o.outperform_steps > s.solution_occurrences
LIMIT 20;
```

