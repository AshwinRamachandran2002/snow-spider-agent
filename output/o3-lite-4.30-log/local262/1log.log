      JOIN ( SELECT  name, version, COUNT(*) AS solution_occurrences
             FROM    solution
             GROUP BY name, version
           ) AS s
        ON  o.name    = s.name
        AND o.version = s.version
      WHERE o.outperform_steps > s.solution_occurrences
) AS result
LIMIT 20;
