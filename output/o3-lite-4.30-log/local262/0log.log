```sql
--Description: Return problems whose number of (version,step) combinations in steps 1‑3
--where the Stack model’s best test_score beats every non‑Stack model’s best test_score
--(“Stack wins”) exceeds the number of rows that problem has in the solution table.

WITH
stack_scores AS (          -- best Stack test_score per (name,version,step)
    SELECT ms."name",
           ms."version",
           ms."step",
           MAX(ms."test_score") AS stack_test
    FROM   "model_score" ms
    WHERE  ms."model" LIKE '%Stack%'
      AND  ms."step" IN (1,2,3)
    GROUP BY ms."name", ms."version", ms."step"
),
non_stack_scores AS (      -- best non‑Stack test_score for the same keys
    SELECT ms."name",
           ms."version",
           ms."step",
           MAX(ms."test_score") AS non_stack_best
    FROM   "model_score" ms
    WHERE  ms."model" NOT LIKE '%Stack%'
      AND  ms."step" IN (1,2,3)
    GROUP BY ms."name", ms."version", ms."step"
),
stack_wins AS (            -- combinations where Stack > best non‑Stack
    SELECT s."name",
           s."version",
           s."step"
    FROM   stack_scores     AS s
    JOIN   non_stack_scores AS n
      ON   s."name"    = n."name"
     AND   s."version" = n."version"
     AND   s."step"    = n."step"
    WHERE  s.stack_test > n.non_stack_best
),
cnt_stack_wins AS (        -- count Stack wins per problem
    SELECT sw."name",
           COUNT(*) AS cnt_stack_wins
    FROM   stack_wins sw
    GROUP  BY sw."name"
),
cnt_solution AS (          -- count rows per problem in solution table
    SELECT sol."name",
           COUNT(*) AS cnt_in_solution
    FROM   "solution" sol
    GROUP  BY sol."name"
)
SELECT csw."name"
FROM   cnt_stack_wins csw
JOIN   cnt_solution   csol
  ON   csw."name" = csol."name"
WHERE  csw.cnt_stack_wins > csol.cnt_in_solution
LIMIT 20;
```
