```sql
--Description:  For every (problem name, version, step) in steps 1‑3, find the Stack model’s
--best test_score and the best non‑Stack test_score.  Keep only those combinations where the
--Stack model outperforms the best non‑Stack model (“Stack wins”).  Count how many such wins occur
--per problem and compare that count with how many times the same problem appears in the solution
--table.  Return the problems whose number of Stack wins exceeds their number of solution rows.

WITH
stack_scores AS (          -- best Stack test_score per (name,version,step)
    SELECT ms."name",
           ms."version",
           ms."step",
           MAX(ms."test_score") AS stack_test
    FROM   "model_score" ms
    WHERE  ms."model" LIKE '%Stack%'
      AND  ms."step" IN (1,2,3)
    GROUP BY ms."name", ms."version", ms."step"
),
non_stack_scores AS (      -- best non‑Stack test_score for the same keys
    SELECT ms."name",
           ms."version",
           ms."step",
           MAX(ms."test_score") AS non_stack_best
    FROM   "model_score" ms
    WHERE  ms."model" NOT LIKE '%Stack%'
      AND  ms."step" IN (1,2,3)
    GROUP BY ms."name", ms."version", ms."step"
),
stack_wins AS (            -- keep only (name,version,step) where Stack > non‑Stack
    SELECT s."name",
           s."version",
           s."step"
    FROM   stack_scores     s
    JOIN   non_stack_scores n
      ON   s."name"    = n."name"
     AND   s."version" = n."version"
     AND   s."step"    = n."step"
    WHERE  s.stack_test > n.non_stack_best
),
cnt_wins AS (              -- count Stack wins per problem
    SELECT "name",
           COUNT(*) AS win_cnt
    FROM   stack_wins
    GROUP BY "name"
),
cnt_solution AS (          -- count occurrences in solution table
    SELECT "name",
           COUNT(*) AS sol_cnt
    FROM   "solution"
    GROUP BY "name"
)
SELECT w."name"
FROM   cnt_wins      w
JOIN   cnt_solution  s
  ON   w."name" = s."name"
WHERE  w.win_cnt > s.sol_cnt;
```
