-- Description / Thinking process ------------------------------------------------
-- ❶ For each (problem = name, version, step) we need two values:
--      • stack_score  = test_score of the row whose model == 'Stack'
--      • best_other   = MAX(test_score) among rows whose model <> 'Stack'
-- ❷ When stack_score > best_other, Stack beats every other model for that (name,version,step).
--    Collect all such winning triplets in CTE “better”.
-- ❸ Count, per problem, how many winning triplets exist  →  cnt_better.
-- ❹ Separately, count how many total rows the same problem has in table solution → cnt_sol.
-- ❺ Return problems where cnt_better > cnt_sol.
-- ------------------------------------------------------------------------------
WITH better AS (
    SELECT
        s.name,
        s.version,
        s.step
    FROM   model_score AS s
    JOIN   ( SELECT
                 name,
                 version,
                 step,
                 MAX(test_score) AS best_other
             FROM   model_score
             WHERE  model <> 'Stack'
             GROUP  BY name, version, step
           ) AS o
      ON  s.name    = o.name
      AND s.version = o.version
      AND s.step    = o.step
