cnt_solution AS (
    SELECT "name", COUNT(*) AS cnt_sol
    FROM "solution"
    GROUP BY "name"
)
SELECT cb."name" AS problem
FROM   cnt_better  AS cb
JOIN   cnt_solution AS cs ON cb."name" = cs."name"
WHERE  cb.cnt_better > cs.cnt_sol
ORDER BY cb."name";
```
