Query:
--Description: 10) Retrieve the top 5 months (Aug‑2022 → Nov‑2023) with the largest positive month‑over‑month profit increase
WITH monthly AS (
    SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000), 'YYYY‑MM') AS "delivery_month",
           SUM(oi."sale_price" - p."cost") AS "profit"
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"       u
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o  ON o."user_id" = u."id"
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi ON oi."order_id" = o."order_id"
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p  ON p."id"       = oi."product_id"
    WHERE  u."traffic_source" ILIKE '%Facebook%'
      AND  o."status"      = 'Complete'
      AND  oi."status"     = 'Complete'
      AND  o."created_at" BETWEEN 1659312000000000 AND 1701302399000000
    GROUP  BY 1
), changes AS (
    SELECT "delivery_month",
           "profit",
           "profit" - LAG("profit") OVER (ORDER BY "delivery_month") AS "profit_change"
    FROM   monthly
)
SELECT "delivery_month",
       "profit",
       "profit_change"
FROM   changes
WHERE  "profit_change" IS NOT NULL
ORDER  BY "profit_change" DESC
LIMIT 5;
