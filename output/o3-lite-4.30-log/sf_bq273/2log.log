2025-05-01 01:50:04 - Thread-495 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
• USERS."id": join key to ORDERS / ORDER_ITEMS for the shopper  
• USERS."traffic_source": identify ‘Facebook’ shoppers  
• ORDERS."order_id": join key to ORDER_ITEMS  
• ORDERS."user_id": join key to USERS  
• ORDERS."status": keep only ‘Complete’ orders  
• ORDERS."created_at": restrict to Aug‑2022 → Nov‑2023 order‑creation window  
• ORDER_ITEMS."order_id": join key to ORDERS  
• ORDER_ITEMS."product_id": join key to PRODUCTS  
• ORDER_ITEMS."sale_price": sales dollars for each line item  
• ORDER_ITEMS."delivered_at": month used for final profit aggregation  
• ORDER_ITEMS."status": keep only ‘Complete’ lines (matches order status)  
• PRODUCTS."id": join key to ORDER_ITEMS  
• PRODUCTS."cost": item cost; profit = sale_price – cost  

Helpful conditions  
• USERS."traffic_source" ILIKE '%Facebook%'  
• ORDERS."status" = 'Complete'  
• ORDER_ITEMS."status" = 'Complete'  
• ORDERS."created_at" BETWEEN 1659312000000000 /*≈2022‑08‑01*/  
                     AND    1701302399000000 /*≈2023‑11‑30*/  

Below are ten exploratory Snowflake SQL queries (LIMIT 20 rows each).  
Replace or adjust LIMIT as needed.

```sql
--Description: 1) Inspect distinct traffic sources available in the USERS table
SELECT DISTINCT "traffic_source"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
LIMIT 20;
```

```sql
--Description: 2) Inspect distinct order statuses in the ORDERS table
SELECT DISTINCT "status"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
LIMIT 20;
```

```sql
--Description: 3) Peek at a few Facebook shoppers (user IDs and traffic source)
SELECT "id"      AS "user_id",
       "traffic_source"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE  "traffic_source" ILIKE '%Facebook%'
LIMIT 20;
```

```sql
--Description: 4) Display a sample of completed orders created on or after 1‑Aug‑2022
SELECT "order_id",
       "user_id",
       "status",
       "created_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE  "status"      = 'Complete'
  AND  "created_at" >= 1659312000000000   -- ≈ 2022‑08‑01
LIMIT 20;
```

```sql
--Description: 5) Show distinct ORDER_ITEMS statuses to verify which rows are ‘Complete’
SELECT DISTINCT "status"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: 6) Sample of ORDER_ITEMS joined to PRODUCTS to calculate line‑item profit
SELECT oi."id"                  AS "order_item_id",
       oi."sale_price",
       p."cost",
       (oi."sale_price" - p."cost") AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON p."id" = oi."product_id"
LIMIT 20;
```

```sql
--Description: 7) Combine USERS, ORDERS, and ORDER_ITEMS for Facebook‑sourced, completed orders
SELECT o."order_id",
       u."id"            AS "user_id",
       oi."id"           AS "order_item_id",
       oi."sale_price",
       p."cost",
       (oi."sale_price" - p."cost") AS "profit",
       oi."delivered_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
       ON o."user_id" = u."id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
       ON oi."order_id" = o."order_id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
       ON p."id" = oi."product_id"
WHERE  u."traffic_source" ILIKE '%Facebook%'
  AND  o."status"       = 'Complete'
  AND  oi."status"      = 'Complete'
  AND  o."created_at"  BETWEEN 1659312000000000 AND 1701302399000000
LIMIT 20;
```

```sql
--Description: 8) Aggregate total profit per delivery month (epoch microsecond -> month string) for the target period
SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000), 'YYYY‑MM') AS "delivery_month",
       SUM(oi."sale_price" - p."cost")                                AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o  ON o."user_id" = u."id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi ON oi."order_id" = o."order_id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p  ON p."id"       = oi."product_id"
WHERE  u."traffic_source" ILIKE '%Facebook%'
  AND  o."status"       = 'Complete'
  AND  oi."status"      = 'Complete'
  AND  o."created_at"  BETWEEN 1659312000000000 AND 1701302399000000
GROUP  BY TO_CHAR(TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000), 'YYYY‑MM')
ORDER  BY "delivery_month"
LIMIT 20;
```

```sql
--Description: 9) Compute month‑over‑month profit change for Facebook‑sourced completed orders
WITH monthly AS (
    SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000), 'YYYY‑MM') AS "delivery_month",
           SUM(oi."sale_price" - p."cost") AS "profit"
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"       u
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o  ON o."user_id" = u."id"
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi ON oi."order_id" = o."order_id"
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p  ON p."id"       = oi."product_id"
    WHERE  u."traffic_source" ILIKE '%Facebook%'
      AND  o."status"      = 'Complete'
      AND  oi."status"     = 'Complete'
      AND  o."created_at" BETWEEN 1659312000000000 AND 1701302399000000
    GROUP  BY 1
)
SELECT "delivery_month",
       "profit",
       "profit" - LAG("profit") OVER (ORDER BY "delivery_month") AS "profit_change"
FROM   monthly
ORDER  BY "delivery_month"
LIMIT 20;
```

```sql
--Description: 10) Retrieve the top 5 months (Aug‑2022 → Nov‑2023) with the largest positive month‑over‑month profit increase
WITH monthly AS (
    SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."delivered_at"/1000000), 'YYYY‑MM') AS "delivery_month",
           SUM(oi."sale_price" - p."cost") AS "profit"
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"       u
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o  ON o."user_id" = u."id"
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi ON oi."order_id" = o."order_id"
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p  ON p."id"       = oi."product_id"
    WHERE  u."traffic_source" ILIKE '%Facebook%'
      AND  o."status"      = 'Complete'
      AND  oi."status"     = 'Complete'
      AND  o."created_at" BETWEEN 1659312000000000 AND 1701302399000000
    GROUP  BY 1
), changes AS (
    SELECT "delivery_month",
           "profit",
           "profit" - LAG("profit") OVER (ORDER BY "delivery_month") AS "profit_change"
    FROM   monthly
)
SELECT "delivery_month",
       "profit",
       "profit_change"
FROM   changes
WHERE  "profit_change" IS NOT NULL
ORDER  BY "profit_change" DESC
LIMIT 5;
```
