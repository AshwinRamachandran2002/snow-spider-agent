The table structure information is ({database name: {schema name: [table name]}}): 
{'THELOOK_ECOMMERCE': {'THELOOK_ECOMMERCE': ['DISTRIBUTION_CENTERS', 'ORDERS', 'USERS', 'EVENTS', 'INVENTORY_ITEMS', 'PRODUCTS', 'ORDER_ITEMS']}}
Begin Exploring Related Columns
Relevant columns and their potential usage  
• ORDERS."created_at" : filter the orders that were placed between 2022‑08‑01 and 2023‑11‑30 (micro‑seconds epoch)  
• ORDERS."status" : keep only the rows whose value is ‘Complete’  
• ORDERS."delivered_at" : derive the delivery month that will be used for the month‑over‑month comparison  
• ORDERS."order_id", ORDERS."user_id" : join keys to ORDER_ITEMS and USERS, respectively  
• USERS."id" : join key back to ORDERS  
• USERS."traffic_source" : keep only rows whose value is ‘Facebook’ (or any case‑insensitive match)  
• ORDER_ITEMS."order_id" : tie every line item back to one order  
• ORDER_ITEMS."sale_price" : line‑item revenue  
• ORDER_ITEMS."inventory_item_id" : join key to INVENTORY_ITEMS  
• INVENTORY_ITEMS."id" : join key back to ORDER_ITEMS  
• INVENTORY_ITEMS."cost" : unit cost; profit = sale_price – cost  

Typical conditions you will probably use  
• USERS."traffic_source" ILIKE 'Facebook%'  
• ORDERS."status" = 'Complete'  
• ORDER_ITEMS."status" = 'Complete'   (optional extra guard)  
• TO_TIMESTAMP(ORDERS."created_at"/1e6) BETWEEN '2022‑08‑01' AND '2023‑11‑30'  

Below are ten exploratory Snowflake queries (LIMIT 20 on each) that gradually build toward the requested result.  
All column names are enclosed in double quotes, and only the tables listed in THELOOK_ECOMMERCE schema are referenced.

```sql
-- 1. Description: inspect the distinct traffic sources that exist in USERS
SELECT DISTINCT "traffic_source"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
LIMIT 20;
```

```sql
-- 2. Description: sample a few Facebook‑sourced users
SELECT "id",
       "first_name",
       "last_name",
       "traffic_source"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE "traffic_source" ILIKE 'Facebook%'
LIMIT 20;
```

```sql
-- 3. Description: view orders created between Aug‑2022 and Nov‑2023
SELECT "order_id",
       TO_TIMESTAMP("created_at"/1e6)  AS "order_ts",
       "status",
       "user_id"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE TO_TIMESTAMP("created_at"/1e6) BETWEEN '2022-08-01' AND '2023-11-30'
LIMIT 20;
```

```sql
-- 4. Description: join ORDERS <> USERS to keep only Facebook & Complete
SELECT o."order_id",
       TO_TIMESTAMP(o."created_at"/1e6)  AS "order_ts",
       o."status",
       u."traffic_source"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"  AS o
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"   AS u
       ON o."user_id" = u."id"
WHERE  o."status" = 'Complete'
  AND  u."traffic_source" ILIKE 'Facebook%'
  AND  TO_TIMESTAMP(o."created_at"/1e6) BETWEEN '2022-08-01' AND '2023-11-30'
LIMIT 20;
```

```sql
-- 5. Description: bring in the order‑level revenue from ORDER_ITEMS
SELECT oi."order_id",
       oi."sale_price"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" AS oi
WHERE  oi."status" = 'Complete'
LIMIT 20;
```

```sql
-- 6. Description: show how sale price pairs with cost at the line‑item level
SELECT oi."order_id",
       oi."inventory_item_id",
       oi."sale_price",
       ii."cost",
       (oi."sale_price" - ii."cost") AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"      AS oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"  AS ii
       ON oi."inventory_item_id" = ii."id"
WHERE  oi."status" = 'Complete'
LIMIT 20;
```

```sql
-- 7. Description: aggregate profit per order for completed Facebook orders
SELECT o."order_id",
       SUM(oi."sale_price" - ii."cost") AS "order_profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"          AS o
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"           AS u
       ON o."user_id" = u."id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     AS oi
       ON o."order_id" = oi."order_id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" AS ii
       ON oi."inventory_item_id" = ii."id"
WHERE  o."status" = 'Complete'
  AND  oi."status" = 'Complete'
  AND  u."traffic_source" ILIKE 'Facebook%'
  AND  TO_TIMESTAMP(o."created_at"/1e6) BETWEEN '2022-08-01' AND '2023-11-30'
GROUP  BY o."order_id"
LIMIT 20;
```

```sql
-- 8. Description: compute total monthly profit (delivery month) for the same slice
SELECT DATE_TRUNC('MONTH', TO_TIMESTAMP(o."delivered_at"/1e6)) AS "delivery_month",
       SUM(oi."sale_price" - ii."cost")                       AS "monthly_profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"          AS o
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"           AS u
       ON o."user_id" = u."id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     AS oi
       ON o."order_id" = oi."order_id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" AS ii
       ON oi."inventory_item_id" = ii."id"
WHERE  o."status" = 'Complete'
  AND  oi."status" = 'Complete'
  AND  u."traffic_source" ILIKE 'Facebook%'
  AND  TO_TIMESTAMP(o."created_at"/1e6) BETWEEN '2022-08-01' AND '2023-11-30'
GROUP  BY 1
ORDER  BY 1
LIMIT 20;
```

```sql
-- 9. Description: add month‑over‑month profit change using LAG()
SELECT "delivery_month",
       "monthly_profit",
       "monthly_profit" - LAG("monthly_profit") OVER (ORDER BY "delivery_month") AS "mom_change"
FROM (
      SELECT DATE_TRUNC('MONTH', TO_TIMESTAMP(o."delivered_at"/1e6)) AS "delivery_month",
             SUM(oi."sale_price" - ii."cost")                       AS "monthly_profit"
      FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"          AS o
      JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"           AS u
             ON o."user_id" = u."id"
      JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     AS oi
             ON o."order_id" = oi."order_id"
      JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" AS ii
             ON oi."inventory_item_id" = ii."id"
      WHERE  o."status" = 'Complete'
        AND  oi."status" = 'Complete'
        AND  u."traffic_source" ILIKE 'Facebook%'
        AND  TO_TIMESTAMP(o."created_at"/1e6) BETWEEN '2022-08-01' AND '2023-11-30'
      GROUP  BY 1
     )
ORDER BY "delivery_month"
LIMIT 20;
```

```sql
--10. Description: final query – top‑5 months (Aug‑2022 to Nov‑2023) that had the largest positive MoM profit increase
WITH monthly AS (
      SELECT DATE_TRUNC('MONTH', TO_TIMESTAMP(o."delivered_at"/1e6)) AS "delivery_month",
             SUM(oi."sale_price" - ii."cost")                       AS "monthly_profit"
      FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"          AS o
      JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"           AS u
             ON o."user_id" = u."id"
      JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     AS oi
             ON o."order_id" = oi."order_id"
      JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" AS ii
             ON oi."inventory_item_id" = ii."id"
      WHERE  o."status" = 'Complete'
        AND  oi."status" = 'Complete'
        AND  u."traffic_source" ILIKE 'Facebook%'
        AND  TO_TIMESTAMP(o."created_at"/1e6) BETWEEN '2022-08-01' AND '2023-11-30'
      GROUP  BY 1
),
mom AS (
      SELECT "delivery_month",
             "monthly_profit",
             "monthly_profit" - LAG("monthly_profit") OVER (ORDER BY "delivery_month") AS "profit_change"
      FROM   monthly
)
SELECT "delivery_month",
       "monthly_profit",
       "profit_change"
FROM   mom
WHERE  "profit_change" IS NOT NULL
ORDER  BY "profit_change" DESC
LIMIT 5;
```

