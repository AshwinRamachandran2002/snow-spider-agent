2025-05-01 02:58:27 - Thread-1102 (execute) - INFO - [Exploration]
Relevant columns & why  
• FORUMMESSAGEVOTES."ToUserId": user who received the up‑vote (we need to count these)  
• FORUMMESSAGEVOTES."VoteDate": lets us keep only 2019 up‑votes  
• USERS."Id": join key to map a user id to a username  
• USERS."UserName": used for the alphabetical tie‑break  
• (Optionally) FORUMMESSAGEVOTES."Id": unique key handy for simple row counts  

Below are 10 incremental Snowflake SQL queries (each limited to 20 rows) that let you explore the needed data step‑by‑step until you have everything required for the “closest‑to‑average 2019 up‑votes” calculation.  
All identifiers are wrapped in double quotes and the fully‑qualified table names are used.

```sql
-- 1) Look at a few raw vote records to understand the columns
SELECT 
  "Id",
  "FromUserId",
  "ToUserId",
  "VoteDate"
FROM "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES"
LIMIT 20;
```

```sql
-- 2) Confirm we really have votes that happened in calendar year 2019
SELECT 
  "Id",
  "FromUserId",
  "ToUserId",
  "VoteDate"
FROM "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES"
WHERE "VoteDate" >= '2019-01-01' 
  AND "VoteDate" <  '2020-01-01'
LIMIT 20;
```

```sql
-- 3) See which users received the most up‑votes in 2019 (raw counts)
SELECT 
  "ToUserId",
  COUNT(*) AS "upvote_cnt_2019"
FROM "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES"
WHERE "VoteDate" >= '2019-01-01' 
  AND "VoteDate" <  '2020-01-01'
GROUP BY "ToUserId"
ORDER BY "upvote_cnt_2019" DESC
LIMIT 20;
```

```sql
-- 4) Check how many unique users actually received at least one 2019 up‑vote
SELECT 
  COUNT(DISTINCT "ToUserId") AS "distinct_receivers_2019"
FROM "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES"
WHERE "VoteDate" >= '2019-01-01' 
  AND "VoteDate" <  '2020-01-01';
```

```sql
-- 5) Compute the average number of up‑votes received per user in 2019
WITH per_user AS (
  SELECT "ToUserId", COUNT(*) AS "upvote_cnt_2019"
  FROM "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES"
  WHERE "VoteDate" >= '2019-01-01' 
    AND "VoteDate" <  '2020-01-01'
  GROUP BY "ToUserId"
)
SELECT 
  AVG("upvote_cnt_2019") AS "avg_upvotes_2019"
FROM per_user;
```

```sql
-- 6) Attach usernames and look at some sample counts
SELECT 
  u."UserName",
  f."ToUserId",
  COUNT(*) AS "upvote_cnt_2019"
FROM "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" f
JOIN "META_KAGGLE"."META_KAGGLE"."USERS" u
  ON u."Id" = f."ToUserId"
WHERE f."VoteDate" >= '2019-01-01' 
  AND f."VoteDate" <  '2020-01-01'
GROUP BY u."UserName", f."ToUserId"
ORDER BY u."UserName"
LIMIT 20;
```

```sql
-- 7) For each user, compute the absolute distance from the average (2‑step)
WITH per_user AS (
  SELECT "ToUserId", COUNT(*) AS "upvote_cnt_2019"
  FROM "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES"
  WHERE "VoteDate" >= '2019-01-01' 
    AND "VoteDate" <  '2020-01-01'
  GROUP BY "ToUserId"
),
avg_calc AS (
  SELECT AVG("upvote_cnt_2019") AS "avg_u" FROM per_user
)
SELECT 
  p."ToUserId",
  p."upvote_cnt_2019",
  a."avg_u",
  ABS(p."upvote_cnt_2019" - a."avg_u") AS "diff_from_avg"
FROM per_user p, avg_calc a
ORDER BY "diff_from_avg" ASC
LIMIT 20;
```

```sql
-- 8) Same as #7 but joined to usernames and sorted for tie‑break inspection
WITH per_user AS (
  SELECT "ToUserId", COUNT(*) AS "upvote_cnt_2019"
  FROM "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES"
  WHERE "VoteDate" >= '2019-01-01' 
    AND "VoteDate" <  '2020-01-01'
  GROUP BY "ToUserId"
),
avg_calc AS (
  SELECT AVG("upvote_cnt_2019") AS "avg_u" FROM per_user
)
SELECT 
  u."UserName",
  p."upvote_cnt_2019",
  ABS(p."upvote_cnt_2019" - a."avg_u") AS "diff_from_avg"
FROM per_user p
JOIN "META_KAGGLE"."META_KAGGLE"."USERS" u
  ON u."Id" = p."ToUserId"
CROSS JOIN avg_calc a
ORDER BY "diff_from_avg" ASC, u."UserName" ASC
LIMIT 20;
```

```sql
-- 9) Use a window function to rank users by closeness to the average
WITH per_user AS (
  SELECT "ToUserId", COUNT(*) AS "upvote_cnt_2019"
  FROM "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES"
  WHERE "VoteDate" >= '2019-01-01' 
    AND "VoteDate" <  '2020-01-01'
  GROUP BY "ToUserId"
),
avg_calc AS (
  SELECT AVG("upvote_cnt_2019") AS "avg_u" FROM per_user
),
diffed AS (
  SELECT 
    p.*,
    ABS(p."upvote_cnt_2019" - a."avg_u") AS "diff_from_avg"
  FROM per_user p, avg_calc a
)
SELECT 
  u."UserName",
  d."upvote_cnt_2019",
  d."diff_from_avg",
  RANK() OVER (ORDER BY d."diff_from_avg" ASC, u."UserName" ASC) AS "rank_by_closeness"
FROM diffed d
JOIN "META_KAGGLE"."META_KAGGLE"."USERS" u
  ON u."Id" = d."ToUserId"
ORDER BY "rank_by_closeness"
LIMIT 20;
```

```sql
-- 10) One‑shot query that returns only the single best match 
-- ( closest to average, ties resolved alphabetically )
WITH per_user AS (
  SELECT "ToUserId", COUNT(*) AS "upvote_cnt_2019"
  FROM "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES"
  WHERE "VoteDate" >= '2019-01-01' 
    AND "VoteDate" <  '2020-01-01'
  GROUP BY "ToUserId"
),
avg_calc AS (
  SELECT AVG("upvote_cnt_2019") AS "avg_u" FROM per_user
),
scored AS (
  SELECT 
    p."ToUserId",
    p."upvote_cnt_2019",
    ABS(p."upvote_cnt_2019" - a."avg_u") AS "diff_from_avg"
  FROM per_user p, avg_calc a
),
ranked AS (
  SELECT 
    u."UserName",
    s."upvote_cnt_2019",
    s."diff_from_avg",
    ROW_NUMBER() OVER (ORDER BY s."diff_from_avg" ASC, u."UserName" ASC) AS "row_num"
  FROM scored s
  JOIN "META_KAGGLE"."META_KAGGLE"."USERS" u
    ON u."Id" = s."ToUserId"
)
SELECT 
  "UserName",
  "upvote_cnt_2019",
  "diff_from_avg"
FROM ranked
WHERE "row_num" = 1
LIMIT 20;
```

These queries lead from simple inspection all the way to the final selection logic, while letting you review intermediate values at each step.
