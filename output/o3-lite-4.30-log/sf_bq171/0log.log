Query:
-- 7) For each user, compute the absolute distance from the average (2‑step)
WITH per_user AS (
  SELECT "ToUserId", COUNT(*) AS "upvote_cnt_2019"
  FROM "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES"
  WHERE "VoteDate" >= '2019-01-01' 
    AND "VoteDate" <  '2020-01-01'
  GROUP BY "ToUserId"
),
avg_calc AS (
  SELECT AVG("upvote_cnt_2019") AS "avg_u" FROM per_user
)
SELECT 
  p."ToUserId",
  p."upvote_cnt_2019",
  a."avg_u",
  ABS(p."upvote_cnt_2019" - a."avg_u") AS "diff_from_avg"
FROM per_user p, avg_calc a
ORDER BY "diff_from_avg" ASC
LIMIT 20;
