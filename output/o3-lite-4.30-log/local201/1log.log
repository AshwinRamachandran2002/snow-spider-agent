Relevant tables / columns & how they will be used  
• word_list.words : list of all dictionary words – we will  
  – keep only words that start with the lowercase letter “r”  
  – keep only words whose length is between 4 and 5 characters (inclusive)  
  – break every such word into individual characters so we can create a canonical
    “signature” that is identical for all of its anagrams  
  – count how many words share the same signature; keep only signatures that occur
    more than once ( = at least one anagram besides the word itself)  

Typical filter / helper conditions  
• words LIKE 'r%'         -- starts with lower‑case r (case‑sensitive)  
• LENGTH(words) BETWEEN 4 AND 5  
• HAVING COUNT(*) > 1     -- at least one anagram  
• ORDER BY words ASC LIMIT 10   -- “first” 10 alphabetically  

Below are ten progressively more‑complex SQLite queries that lead from basic
inspection to the final answer.  
(Use any of them in your SQL client; all LIMIT values are set to 20 just for
quick previews.)

```sql
-- 1) Peek at a handful of raw words
SELECT DISTINCT words
FROM word_list
LIMIT 20;
```

```sql
-- 2) Words that begin with the letter 'r'
SELECT DISTINCT words
FROM word_list
WHERE words LIKE 'r%'
LIMIT 20;
```

```sql
-- 3) Words that begin with 'r' and are exactly 4–5 characters long
SELECT DISTINCT words
FROM word_list
WHERE words LIKE 'r%'
  AND LENGTH(words) BETWEEN 4 AND 5
LIMIT 20;
```

```sql
-- 4) Split each *candidate* word into one row per character
WITH RECURSIVE chars AS (
  SELECT words AS word,
         1      AS pos,
         SUBSTR(words,1,1) AS ch
  FROM   word_list
  WHERE  words LIKE 'r%'
    AND  LENGTH(words) BETWEEN 4 AND 5
  UNION ALL
  SELECT word,
         pos + 1,
         SUBSTR(word,pos+1,1)
  FROM   chars
  WHERE  pos + 1 <= LENGTH(word)
)
SELECT *
FROM   chars
LIMIT 20;
```

```sql
-- 5) Create a *signature* for every candidate word
WITH RECURSIVE chars AS (
  SELECT words AS word,
         1      AS pos,
         SUBSTR(words,1,1) AS ch
  FROM   word_list
  WHERE  words LIKE 'r%'
    AND  LENGTH(words) BETWEEN 4 AND 5
  UNION ALL
  SELECT word,
         pos + 1,
         SUBSTR(word,pos+1,1)
  FROM   chars
  WHERE  pos + 1 <= LENGTH(word)
),
sorted_chars AS (
  SELECT word, ch
  FROM   chars
  ORDER  BY word, ch         -- put letters in A‑Z order for each word
),
signatures AS (
  SELECT word,
         GROUP_CONCAT(ch,'') AS signature   -- e.g. 'rail' & 'lair' → 'ailr'
  FROM   sorted_chars
  GROUP  BY word
)
SELECT *
FROM   signatures
LIMIT 20;
```

```sql
-- 6) How many words share each signature?
WITH ...       -- (same three CTE blocks as above)
,sig_counts AS (
  SELECT signature,
         COUNT(*) AS anagram_cnt
  FROM   signatures
  GROUP  BY signature
)
SELECT *
FROM   sig_counts
WHERE  anagram_cnt > 1     -- signatures with 2+ words ⇒ real anagram sets
LIMIT 20;
```

```sql
-- 7) Attach the anagram counts back to every individual word
WITH ...       -- chars, sorted_chars, signatures as before
,sig_counts AS (
  SELECT signature,
         COUNT(*) AS anagram_cnt
  FROM   signatures
  GROUP  BY signature
  HAVING COUNT(*) > 1
)
SELECT s.word,
       c.anagram_cnt
FROM   signatures  AS s
JOIN   sig_counts  AS c USING (signature)
LIMIT 20;
```

```sql
-- 8) Keep only the 'r%' + 4–5‑letter candidates
WITH ...        -- same as query 7
SELECT s.word,
       c.anagram_cnt
FROM   signatures AS s
JOIN   sig_counts AS c USING (signature)
WHERE  s.word LIKE 'r%'
  AND  LENGTH(s.word) BETWEEN 4 AND 5
LIMIT 20;
```

```sql
-- 9) Put them in alphabetical order & take the first 10
WITH ...        -- same as query 8
SELECT s.word,
       c.anagram_cnt
FROM   signatures AS s
JOIN   sig_counts AS c USING (signature)
WHERE  s.word LIKE 'r%'
  AND  LENGTH(s.word) BETWEEN 4 AND 5
ORDER  BY s.word ASC
LIMIT 10;
```

```sql
-- 10) FINAL ANSWER ─ first 10 alphabetically that
--     (a) start with 'r', (b) are 4‑5 letters long,
--     (c) have at least one anagram of the same length.
WITH RECURSIVE chars AS (
  SELECT words AS word,
         1      AS pos,
         SUBSTR(words,1,1) AS ch
  FROM   word_list
  WHERE  words LIKE 'r%'
    AND  LENGTH(words) BETWEEN 4 AND 5
  UNION ALL
  SELECT word,
         pos + 1,
         SUBSTR(word,pos+1,1)
  FROM   chars
  WHERE  pos + 1 <= LENGTH(word)
),
sorted_chars AS (
  SELECT word, ch
  FROM   chars
  ORDER  BY word, ch
),
signatures AS (
  SELECT word,
         GROUP_CONCAT(ch,'') AS signature
  FROM   sorted_chars
  GROUP  BY word
),
sig_counts AS (
  SELECT signature,
         COUNT(*) AS anagram_cnt
  FROM   signatures
  GROUP  BY signature
  HAVING COUNT(*) > 1
)
SELECT s.word          AS word,
       c.anagram_cnt   AS total_anagrams
FROM   signatures AS s
JOIN   sig_counts AS c USING (signature)
ORDER  BY s.word ASC
LIMIT 10;
```

