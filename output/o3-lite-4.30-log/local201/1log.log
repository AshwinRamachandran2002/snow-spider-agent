    SELECT word,
           GROUP_CONCAT(ch,'') AS signature
    FROM   sorted_chars
    GROUP  BY word
),
sig_counts AS (                               -- count words per signature
    SELECT signature,
           COUNT(*) AS anagram_cnt
    FROM   signatures
    GROUP  BY signature
    HAVING COUNT(*) > 1                       -- keep only real anagram sets
)
SELECT s.word,
       c.anagram_cnt
FROM   signatures AS s
JOIN   sig_counts  AS c USING (signature)
LIMIT 20
