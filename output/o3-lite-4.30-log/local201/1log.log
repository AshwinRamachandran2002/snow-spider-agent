Query:
--Description: Attach the anagram‑group sizes to every 4‑ or 5‑letter word that starts
--             with ‘r’. Show any such word (even if its anagram mates start with other
--             letters) together with how many total words share its signature. 20 rows.
WITH RECURSIVE chars AS (                     -- explode candidate words into letters
    SELECT words AS word,
           1 AS pos,
           SUBSTR(words,1,1) AS ch
    FROM   word_list
    WHERE  words LIKE 'r%'
      AND  LENGTH(words) BETWEEN 4 AND 5
    UNION ALL
    SELECT word,
           pos + 1,
           SUBSTR(word,pos+1,1)
    FROM   chars
    WHERE  pos + 1 <= LENGTH(word)
),
sorted_chars AS (                             -- sort letters within each word
    SELECT word, ch
    FROM   chars
    ORDER  BY word, ch
),
signatures AS (                               -- canonical anagram signature
    SELECT word,
           GROUP_CONCAT(ch,'') AS signature
    FROM   sorted_chars
    GROUP  BY word
),
sig_counts AS (                               -- count words per signature
    SELECT signature,
           COUNT(*) AS anagram_cnt
    FROM   signatures
    GROUP  BY signature
    HAVING COUNT(*) > 1                       -- keep only real anagram sets
)
SELECT s.word,
       c.anagram_cnt
FROM   signatures AS s
JOIN   sig_counts  AS c USING (signature)
LIMIT 20
