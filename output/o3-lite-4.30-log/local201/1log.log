Query:
--Description: FINAL ANSWER – the first ten alphabetically ordered words
--             (starting with ‘r’, 4‑5 letters long) that have at least one
--             anagram of equal length. Report each word and how many total
--             words share its anagram signature.
WITH RECURSIVE chars AS (
    SELECT words AS word,
           1 AS pos,
           SUBSTR(words,1,1) AS ch
    FROM   word_list
    WHERE  words LIKE 'r%'
      AND  LENGTH(words) BETWEEN 4 AND 5
    UNION ALL
    SELECT word,
           pos + 1,
           SUBSTR(word,pos+1,1)
    FROM   chars
    WHERE  pos + 1 <= LENGTH(word)
),
sorted_chars AS (
    SELECT word, ch
    FROM   chars
    ORDER  BY word, ch
),
signatures AS (
    SELECT word,
           GROUP_CONCAT(ch,'') AS signature
    FROM   sorted_chars
    GROUP  BY word
),
sig_counts AS (
    SELECT signature,
           COUNT(*) AS anagram_cnt
    FROM   signatures
    GROUP  BY signature
    HAVING COUNT(*) > 1
)
SELECT s.word          AS word,
       c.anagram_cnt   AS total_anagrams
FROM   signatures AS s
JOIN   sig_counts  AS c USING (signature)
ORDER  BY s.word ASC
LIMIT 10
