```sql
--Description / Thinking process:
-- Goal: list the first 10 words (alphabetically) that
--   • start with lowercase 'r'
--   • are 4‑ or 5‑letters long
--   • have at least one anagram of equal length in the same list,
--     and show how many such anagrams exist.
--
-- Steps implemented below:
-- 1) Filter the word_list table to the size/initial‑letter criteria.
-- 2) Break each word into its individual letters (recursive CTE “chars”).
-- 3) Sort the letters within each word and re‑assemble them to form a
--    canonical “signature” for anagrams (CTE “signatures”).
-- 4) Count how many words share each signature; retain only those where
--    the count > 1 (CTE “sig_counts”).
-- 5) Join back to the original words, order alphabetically, and take the first 10.

WITH RECURSIVE chars AS (                 -- Step 1 & 2: explode words into letters
    SELECT words AS word,
           1 AS pos,
           SUBSTR(words,1,1) AS ch
    FROM   word_list
    WHERE  words LIKE 'r%'                -- must start with 'r'
      AND  LENGTH(words) BETWEEN 4 AND 5  -- 4–5 characters long
    UNION ALL
    SELECT word,
           pos + 1,
           SUBSTR(word,pos+1,1)
    FROM   chars
    WHERE  pos + 1 <= LENGTH(word)
),
sorted_chars AS (                         -- Step 3: arrange letters in alphabetical order
    SELECT word, ch
    FROM   chars
    ORDER  BY word, ch
),
signatures AS (                           -- Step 3: create the anagram signature
    SELECT word,
           GROUP_CONCAT(ch,'') AS signature
    FROM   sorted_chars
    GROUP  BY word
),
sig_counts AS (                           -- Step 4: count words per signature
    SELECT signature,
           COUNT(*) AS anagram_cnt
    FROM   signatures
    GROUP  BY signature
    HAVING COUNT(*) > 1                   -- keep only real anagram sets
)
-- Step 5: fetch the words & their anagram counts, alphabetise, show first 10
SELECT  s.word,
        c.anagram_cnt
FROM    signatures AS s
JOIN    sig_counts  AS c USING (signature)
ORDER   BY s.word ASC
LIMIT 10;
```
