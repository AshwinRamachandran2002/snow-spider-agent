Relevant columns  
• word_list.words : contains every single word in the dictionary – this is the only column we need for the task.  

We have to  
1. look only at the words table,  
2. keep the words whose length is 4‑5 characters,  
3. keep those that begin with the lowercase letter “r”,  
4. keep only the ones that belong to an anagram family made of ≥ 2 words of the **same length** (case‑sensitive),  
5. list the first 10 such words in alphabetical order together with the size of their anagram family.

Below are 10 exploratory → final SQL queries that progressively build the solution.
All queries use at most 20 preview rows (except the final answer).  
Double quotes are placed around identifiers that might contain special characters.

```sql
-- 1. Have a look at some raw words
SELECT DISTINCT words
FROM word_list
LIMIT 20;
```

```sql
-- 2. Words whose length is exactly 4 or 5
SELECT words
FROM word_list
WHERE length(words) BETWEEN 4 AND 5
LIMIT 20;
```

```sql
-- 3. Same set but restricted to words that start with 'r'
SELECT words
FROM word_list
WHERE words LIKE 'r%' COLLATE BINARY
  AND length(words) BETWEEN 4 AND 5
LIMIT 20;
```

```sql
-- 4. Alphabetical preview of all the candidate words (no LIMIT in final)
SELECT words
FROM word_list
WHERE words LIKE 'r%' COLLATE BINARY
  AND length(words) BETWEEN 4 AND 5
ORDER BY words
LIMIT 20;
```

```sql
-- 5. Break every word into one‑based (<word, position, character>) rows
WITH chars AS (
  SELECT words AS word,
         1        AS pos,
         substr(words,1,1) AS ch
  FROM word_list
  UNION ALL
  SELECT word,
         pos+1,
         substr(word,pos+1,1)
  FROM chars
  WHERE pos < length(word)
)
SELECT *                -- preview
FROM chars
LIMIT 20;
```

```sql
-- 6. For each word, put its letters in alphabetical order -> “canonical key”
WITH chars AS (
  SELECT words   AS word,
         1       AS pos,
         substr(words,1,1) AS ch
  FROM word_list
  UNION ALL
  SELECT word,
         pos+1,
         substr(word,pos+1,1)
  FROM chars
  WHERE pos < length(word)
),
ordered AS (
  SELECT word,
         group_concat(ch, '')        AS canon            -- letters ordered a‑z
  FROM (
    SELECT word, ch
    FROM chars
    ORDER BY word, ch
  )
  GROUP BY word
)
SELECT * FROM ordered LIMIT 20;
```

```sql
-- 7. Count how many words share the same canonical key & the same length
WITH chars AS (
  SELECT words AS word, 1 AS pos, substr(words,1,1) AS ch
  FROM word_list
  UNION ALL
  SELECT word, pos+1, substr(word,pos+1,1)
  FROM chars
  WHERE pos < length(word)
),
ordered AS (
  SELECT word,
         length(word)               AS len,
         group_concat(ch,'')        AS canon
  FROM (
      SELECT word, ch
      FROM chars
      ORDER BY word, ch
  )
  GROUP BY word
),
family AS (
  SELECT canon,
         len,
         count(*) AS fam_cnt
  FROM ordered
  GROUP BY canon, len
  HAVING fam_cnt > 1
)
SELECT * FROM family LIMIT 20;
```

```sql
-- 8. Join back to get each individual word belonging to an anagram family
WITH chars AS (
  SELECT words AS word, 1 AS pos, substr(words,1,1) AS ch
  FROM word_list
  UNION ALL
  SELECT word, pos+1, substr(word,pos+1,1)
  FROM chars
  WHERE pos < length(word)
),
ordered AS (
  SELECT word,
         length(word)        AS len,
         group_concat(ch,'') AS canon
  FROM (
      SELECT word, ch
      FROM chars
      ORDER BY word, ch
  )
  GROUP BY word
),
family AS (
  SELECT canon, len, count(*) AS fam_cnt
  FROM ordered
  GROUP BY canon, len
  HAVING fam_cnt > 1
)
SELECT o.word, f.fam_cnt
FROM ordered o
JOIN family  f
  ON o.len   = f.len
 AND o.canon = f.canon
LIMIT 20;
```

```sql
-- 9. Apply the r‑prefix and length filters
WITH chars AS (
  SELECT words AS word, 1 AS pos, substr(words,1,1) AS ch
  FROM word_list
  UNION ALL
  SELECT word, pos+1, substr(word,pos+1,1)
  FROM chars
  WHERE pos < length(word)
),
ordered AS (
  SELECT word,
         length(word)        AS len,
         group_concat(ch,'') AS canon
  FROM (
       SELECT word, ch
       FROM chars
       ORDER BY word, ch
  )
  GROUP BY word
),
family AS (
  SELECT canon, len, count(*) AS fam_cnt
  FROM ordered
  GROUP BY canon, len
  HAVING fam_cnt > 1
)
SELECT o.word, f.fam_cnt
FROM ordered o
JOIN family  f
  ON o.len   = f.len
 AND o.canon = f.canon
WHERE o.len BETWEEN 4 AND 5
  AND o.word LIKE 'r%' COLLATE BINARY
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER:
--     first 10 qualifying words in pure alphabetical order
WITH chars AS (
  SELECT words AS word, 1 AS pos, substr(words,1,1) AS ch
  FROM word_list
  UNION ALL
  SELECT word, pos+1, substr(word,pos+1,1)
  FROM chars
  WHERE pos < length(word)
),
ordered AS (
  SELECT word,
         length(word)        AS len,
         group_concat(ch,'') AS canon
  FROM (
      SELECT word, ch
      FROM chars
      ORDER BY word, ch
  )
  GROUP BY word
),
family AS (
  SELECT canon, len, count(*) AS fam_cnt
  FROM ordered
  GROUP BY canon, len
  HAVING fam_cnt > 1            -- at least one anagram sibling
)
SELECT o.word                       AS word,
       f.fam_cnt                    AS anagram_count
FROM ordered o
JOIN family  f
  ON o.len   = f.len
 AND o.canon = f.canon
WHERE o.len BETWEEN 4 AND 5
  AND o.word LIKE 'r%' COLLATE BINARY
ORDER BY o.word          -- alphabetical order
LIMIT 10;                -- “first” 10 words
```

