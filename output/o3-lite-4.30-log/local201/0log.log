WITH words_filtered AS (
    SELECT words AS word
    FROM word_list
    WHERE word LIKE 'r%'              -- starts with lowercase r
      AND length(word) BETWEEN 4 AND 5
),
-- break every word into individual characters together with its length
chars AS (
    SELECT word,
           length(word) AS len,
           1            AS pos,
           substr(word,1,1) AS ch
    FROM words_filtered
    UNION ALL
    SELECT word,
           len,
           pos + 1,
           substr(word,pos + 1,1)
    FROM chars
    WHERE pos + 1 <= len
),
-- canonical signature = letters of the word sorted a‑z (case–sensitive)
canon_per_word AS (
    SELECT word,
           len,
           group_concat(ch,'') AS canon
    FROM (
        SELECT word,
               len,
               ch
        FROM chars
        ORDER BY word, ch               -- sort letters for each word
    )
    GROUP BY word, len
),
-- size of every anagram family (same length, same canonical signature)
family_counts AS (
    SELECT canon,
           len,
           COUNT(*) AS anagram_count
    FROM canon_per_word
    GROUP BY canon, len
    HAVING anagram_count > 1            -- keep only families with ≥ 2 words
)
SELECT cpw.word,
       fc.anagram_count
FROM canon_per_word cpw
JOIN family_counts fc
  ON cpw.canon = fc.canon
 AND cpw.len   = fc.len
ORDER BY cpw.word                      -- alphabetical order
LIMIT 10;
