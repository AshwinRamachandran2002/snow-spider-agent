2025-05-01 03:29:39 - Thread-1449 (execute) - INFO - [Exploration]
Relevant tables / columns and why  

• word_list.words : contains every word we can search through – this is the only place we will look for 4‑ or 5‑letter “r …” words and their possible anagrams.  

Main conditions we are going to use  

1. length(words) BETWEEN 4 AND 5           – keep words that are 4 or 5 characters long  
2. words LIKE 'r%' COLLATE BINARY          – make sure the word (case‑sensitive) starts with the lowercase ‘r’  
3. An anagram test – build a “signature” by alphabetically sorting the letters in each word; if more than one different word shares the same signature it has (at least) one anagram.  
4. Finally, take the first 10 such words in standard alphabetical order and report how many anagrams each has.  

Below are ten progressively richer SQL queries (every one limited to 20 rows except the final answer).  
All identifiers use double‑quotes only when needed, and no schema or PRAGMA calls are made.

```sql
-- 1. Quick peek at the raw words table
SELECT DISTINCT words
FROM word_list
LIMIT 20;
```

```sql
-- 2. Show words that actually start with lowercase ‘r’
SELECT DISTINCT words
FROM word_list
WHERE words LIKE 'r%' COLLATE BINARY
LIMIT 20;
```

```sql
-- 3. Now restrict to 4‑ or 5‑letter “r …” words
SELECT DISTINCT words
FROM word_list
WHERE length(words) BETWEEN 4 AND 5
  AND words LIKE 'r%' COLLATE BINARY
LIMIT 20;
```

```sql
-- 4. Break every word into one row per character (recursive CTE)
WITH RECURSIVE chars(word, pos, ch) AS (
    SELECT words, 1, substr(words,1,1)
    FROM word_list
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos < length(word)
)
SELECT word, pos, ch
FROM chars
LIMIT 20;
```

```sql
-- 5. For every word build an alphabetically‑sorted “signature”
WITH RECURSIVE chars(word, pos, ch) AS (
    SELECT words, 1, substr(words,1,1)
    FROM word_list
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos < length(word)
),
sig AS (
    SELECT word,
           group_concat(ch, '') AS sorted_sig
    FROM (
        SELECT word, ch
        FROM chars
        ORDER BY word, ch          -- order characters, not original positions
    )
    GROUP BY word
)
SELECT word, sorted_sig
FROM sig
LIMIT 20;
```

```sql
-- 6. Count how many other words share each signature (i.e. number of anagrams)
WITH RECURSIVE chars(word, pos, ch) AS (
    SELECT words, 1, substr(words,1,1)
    FROM word_list
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos < length(word)
),
sig AS (
    SELECT word,
           group_concat(ch, '') AS sorted_sig
    FROM (
        SELECT word, ch
        FROM chars
        ORDER BY word, ch
    )
    GROUP BY word
),
sig_counts AS (
    SELECT sorted_sig,
           COUNT(*)  AS anagram_cnt
    FROM sig
    GROUP BY sorted_sig
)
SELECT s.word, s.sorted_sig, c.anagram_cnt
FROM sig AS s
JOIN sig_counts AS c USING (sorted_sig)
LIMIT 20;
```

```sql
-- 7. Keep only signatures that have more than one word (=> at least 1 anagram)
WITH RECURSIVE chars(word, pos, ch) AS (
    SELECT words, 1, substr(words,1,1)
    FROM word_list
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos < length(word)
),
sig AS (
    SELECT word,
           group_concat(ch, '') AS sorted_sig
    FROM (
        SELECT word, ch
        FROM chars
        ORDER BY word, ch
    )
    GROUP BY word
),
sig_counts AS (
    SELECT sorted_sig,
           COUNT(*)  AS anagram_cnt
    FROM sig
    GROUP BY sorted_sig
    HAVING COUNT(*) > 1
)
SELECT s.word, c.anagram_cnt
FROM sig AS s
JOIN sig_counts AS c USING (sorted_sig)
LIMIT 20;
```

```sql
-- 8. Put the 4‑to‑5‑letter and “r …” requirements back in
WITH RECURSIVE chars(word, pos, ch) AS (
    SELECT words, 1, substr(words,1,1)
    FROM word_list
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos < length(word)
),
sig AS (
    SELECT word,
           group_concat(ch, '') AS sorted_sig
    FROM (
        SELECT word, ch
        FROM chars
        ORDER BY word, ch
    )
    GROUP BY word
),
sig_counts AS (
    SELECT sorted_sig,
           COUNT(*) AS anagram_cnt
    FROM sig
    GROUP BY sorted_sig
    HAVING COUNT(*) > 1
)
SELECT s.word, c.anagram_cnt
FROM sig AS s
JOIN sig_counts AS c USING (sorted_sig)
WHERE length(s.word) BETWEEN 4 AND 5
  AND s.word LIKE 'r%' COLLATE BINARY
LIMIT 20;
```

```sql
-- 9. Sort alphabetically and take exactly the first 10 that meet every rule
WITH RECURSIVE chars(word, pos, ch) AS (
    SELECT words, 1, substr(words,1,1)
    FROM word_list
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos < length(word)
),
sig AS (
    SELECT word,
           group_concat(ch, '') AS sorted_sig
    FROM (
        SELECT word, ch
        FROM chars
        ORDER BY word, ch
    )
    GROUP BY word
),
sig_counts AS (
    SELECT sorted_sig,
           COUNT(*) AS anagram_cnt
    FROM sig
    GROUP BY sorted_sig
    HAVING COUNT(*) > 1
)
SELECT s.word               AS word,
       c.anagram_cnt        AS anagram_count
FROM sig        AS s
JOIN sig_counts AS c USING (sorted_sig)
WHERE length(s.word) BETWEEN 4 AND 5
  AND s.word LIKE 'r%' COLLATE BINARY
ORDER BY s.word              -- alphabetical
LIMIT 10;
```

```sql
-- 10. FINAL QUERY (no LIMIT 20 – it already limits to 10 words):
--     First 10 alphabetically, 4–5 chars, start with 'r', with >=1 anagram; report how many
WITH RECURSIVE chars(word, pos, ch) AS (
    SELECT words, 1, substr(words,1,1)
    FROM word_list
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos < length(word)
),
sig AS (
    SELECT word,
           group_concat(ch, '') AS sorted_sig
    FROM (
        SELECT word, ch
        FROM chars
        ORDER BY word, ch
    )
    GROUP BY word
),
sig_counts AS (
    SELECT sorted_sig,
           COUNT(*) AS anagram_cnt
    FROM sig
    GROUP BY sorted_sig
    HAVING COUNT(*) > 1
)
SELECT s.word               AS word,
       c.anagram_cnt        AS anagram_count
FROM sig        AS s
JOIN sig_counts AS c USING (sorted_sig)
WHERE length(s.word) BETWEEN 4 AND 5
  AND s.word LIKE 'r%' COLLATE BINARY
ORDER BY s.word              -- alphabetical order
LIMIT 10;
```

Running the final query will return something like  

word | anagram_count  
---- | --------------  
...  | ...  

(the exact 10 words depend on the full contents of `word_list`).
