```sql
--Description:
--Goal: Annual retention rate for legislators whose first term began between 1‑Jan‑1917 and 31‑Dec‑1999.
--Logic:
-- 1. Cohort: for every legislator choose the minimum term_start and keep those inside the date window.
-- 2. Years CTE: recursively create integers 1‑20 (year offsets).
-- 3. Retention: for each offset count how many cohort members still hold office on the checkpoint date
--    (defined as 31‑Dec of first_start + n years).  A term must start on/before and end on/after the checkpoint.
-- 4. Combine with total cohort size to turn counts into proportions; keep all 20 offsets,
--    substituting 0 when no one is retained.
WITH RECURSIVE
cohort AS (                       -- Step 1
    SELECT id_bioguide,
           DATE(MIN(term_start)) AS first_start
    FROM legislators_terms
    GROUP BY id_bioguide
    HAVING MIN(term_start) BETWEEN '1917-01-01' AND '1999-12-31'
),
years(n) AS (                     -- Step 2
    SELECT 1
    UNION ALL
    SELECT n + 1 FROM years WHERE n < 20
),
retention AS (                    -- Step 3
    SELECT y.n AS year_offset,
           COUNT(DISTINCT c.id_bioguide) AS retained_cnt
    FROM years              AS y
    JOIN cohort             AS c
    JOIN legislators_terms  AS lt
      ON lt.id_bioguide = c.id_bioguide
      AND DATE(lt.term_start) <= DATE(c.first_start,
                                      '+'||y.n||' years',
                                      'start of year','+11 months','+30 days')  -- 31‑Dec
      AND DATE(lt.term_end)   >= DATE(c.first_start,
                                      '+'||y.n||' years',
                                      'start of year','+11 months','+30 days')
    GROUP BY y.n
),
tot AS (SELECT COUNT(*) AS cohort_size FROM cohort)  -- Step 4
SELECT y.n                                                   AS year_offset,
       ROUND(COALESCE(r.retained_cnt,0) * 1.0 / tot.cohort_size, 4) AS retention_rate
FROM years  AS y
LEFT JOIN retention AS r ON r.year_offset = y.n
CROSS JOIN tot
ORDER BY y.n;
```
