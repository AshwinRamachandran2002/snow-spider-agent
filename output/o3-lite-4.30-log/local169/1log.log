--Description: For the fixed calendar date 1935‑12‑31, count how many legislators from the
--             1917‑1999 entry cohort were serving on that specific day (i.e., the date falls
--             between any of their term_start and term_end values).
WITH cohort AS (
    SELECT "id_bioguide",
           MIN("term_start") AS first_term_start
    FROM   "legislators_terms"
    GROUP  BY "id_bioguide"
    HAVING date(MIN("term_start")) BETWEEN '1917-01-01' AND '1999-12-31'
)
SELECT COUNT(DISTINCT c."id_bioguide") AS in_office_on_1935_12_31
FROM   cohort             AS c
JOIN   "legislators_terms" AS t
       ON t."id_bioguide" = c."id_bioguide"
WHERE  date('1935-12-31') BETWEEN t."term_start" AND t."term_end"
