Query:
--Description: Compute, for every legislator in the 1917‑1999 cohort, the span from their
--             first term_start to their last term_end, then return the single maximum
--             tenure (in years) observed among all cohort members.
WITH cohort AS (
    SELECT "id_bioguide"
    FROM   "legislators_terms"
    GROUP  BY "id_bioguide"
    HAVING date(MIN("term_start")) BETWEEN '1917-01-01' AND '1999-12-31'
),
spans AS (
    SELECT c."id_bioguide",
           MIN(date(t."term_start")) AS min_start,
           MAX(date(t."term_end"))   AS max_end
    FROM   "legislators_terms" t
    JOIN   cohort c USING ("id_bioguide")
    GROUP  BY c."id_bioguide"
)
SELECT MAX( (julianday(max_end) - julianday(min_start)) / 365.25 ) AS max_years_in_office
FROM   spans
