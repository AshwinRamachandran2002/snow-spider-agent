```sql
--Description: First, find each legislator’s earliest recorded “term_start”
--             (that is their first time entering Congress).  This is done
--             in the CTE named first_terms.  Then keep only those whose
--             first term began between 1917‑01‑01 and 1999‑12‑31.  Finally,
--             group these first‑term start dates by calendar year and count
--             how many legislators entered in each year (limit 20 rows just
--             for a quick glance).
WITH first_terms AS (
    SELECT "id_bioguide",
           MIN(date("term_start")) AS first_term_start
    FROM   "legislators_terms"
    GROUP  BY "id_bioguide"
)
SELECT strftime('%Y', first_term_start) AS first_term_year,
       COUNT(*)                         AS legislator_count
FROM   first_terms
WHERE  first_term_start BETWEEN '1917-01-01' AND '1999-12-31'
GROUP  BY first_term_year
ORDER  BY first_term_year
LIMIT 20;
```
