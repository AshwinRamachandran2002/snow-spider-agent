ORDER  BY "term_end"
LIMIT  20;
```

```sql
--Description: List 20 sample members of the 1917‑1999 cohort together with the date their
--             very first congressional term began.  MIN(term_start) is filtered in the
--             HAVING clause so only people whose first term lies in the window are shown.
SELECT "id_bioguide",
       MIN("term_start") AS "first_term_start"
FROM   "legislators_terms"
GROUP  BY "id_bioguide"
HAVING date(MIN("term_start")) BETWEEN '1917-01-01' AND '1999-12-31'
LIMIT  20;
```

```sql
--Description: For the fixed calendar date 1935‑12‑31, count how many legislators from the
--             1917‑1999 entry cohort were serving on that specific day (i.e., the date falls
--             between any of their term_start and term_end values).
WITH cohort AS (
    SELECT "id_bioguide",
           MIN("term_start") AS first_term_start
    FROM   "legislators_terms"
    GROUP  BY "id_bioguide"
    HAVING date(MIN("term_start")) BETWEEN '1917-01-01' AND '1999-12-31'
)
SELECT COUNT(DISTINCT c."id_bioguide") AS in_office_on_1935_12_31
FROM   cohort             AS c
JOIN   "legislators_terms" AS t
       ON t."id_bioguide" = c."id_bioguide"
WHERE  date('1935-12-31') BETWEEN t."term_start" AND t."term_end";
```

```sql
--Description: Determine how the 1917‑1999 cohort breaks down between House (“rep”) and
--             Senate (“sen”) service (counting distinct people, not terms).
WITH cohort AS (
    SELECT "id_bioguide"
    FROM   "legislators_terms"
    GROUP  BY "id_bioguide"
    HAVING date(MIN("term_start")) BETWEEN '1917-01-01' AND '1999-12-31'
)
SELECT t."term_type",
       COUNT(DISTINCT t."id_bioguide") AS legislator_count
FROM   "legislators_terms" t
JOIN   cohort c USING ("id_bioguide")
GROUP  BY t."term_type"
LIMIT  20;
```

```sql
--Description: Compute, for every legislator in the 1917‑1999 cohort, the span from their
--             first term_start to their last term_end, then return the single maximum
--             tenure (in years) observed among all cohort members.
WITH cohort AS (
    SELECT "id_bioguide"
    FROM   "legislators_terms"
    GROUP  BY "id_bioguide"
    HAVING date(MIN("term_start")) BETWEEN '1917-01-01' AND '1999-12-31'
),
spans AS (
    SELECT c."id_bioguide",
           MIN(date(t."term_start")) AS min_start,
           MAX(date(t."term_end"))   AS max_end
    FROM   "legislators_terms" t
    JOIN   cohort c USING ("id_bioguide")
    GROUP  BY c."id_bioguide"
)
SELECT MAX( (julianday(max_end) - julianday(min_start)) / 365.25 ) AS max_years_in_office
FROM   spans;
```

```sql
--Description: Prototype calculation—count how many cohort members remain in office on each
--             of the first five “anniversary” 31‑December dates after their initial entry
--             year (0‑through‑4 years after start).  The anniv CTE now includes the index
--             years_after_start so the outer query can group on it.
WITH cohort AS (
    SELECT "id_bioguide",
           MIN(date("term_start")) AS first_start
    FROM   "legislators_terms"
    GROUP  BY "id_bioguide"
    HAVING first_start BETWEEN '1917-01-01' AND '1999-12-31'
),
dates AS (
    SELECT c."id_bioguide",
           first_start,
           strftime('%Y', first_start) AS start_year
    FROM   cohort c
),
anniv AS (
    SELECT d."id_bioguide",
           n                       AS years_after_start,
           (CAST(d.start_year AS INTEGER) + n) AS yr,
           (CAST(d.start_year AS INTEGER) + n) || '-12-31' AS check_date
    FROM   dates d
    JOIN  (SELECT 0 AS n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4) n
)
SELECT a.years_after_start,
       COUNT(DISTINCT a."id_bioguide") AS still_serving
FROM   anniv a
JOIN   "legislators_terms" t
       ON a."id_bioguide" = t."id_bioguide"
WHERE  date(a.check_date) BETWEEN t."term_start" AND t."term_end"
GROUP  BY a.years_after_start
ORDER  BY a.years_after_start
LIMIT  20;
```
