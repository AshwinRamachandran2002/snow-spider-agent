Begin Exploring Related Columns
Relevant columns and why they matter  
• `year`:           to limit the analysis to 2010‑2014 and to report the result year  
• `month`:          to aggregate by calendar month and report the result month  
• `air_temperature`:       one of the four temperatures whose monthly mean is required  
• `wetbulb_temperature`:   one of the four temperatures whose monthly mean is required  
• `dewpoint_temperature`:  one of the four temperatures whose monthly mean is required  
• `sea_surface_temp`:      one of the four temperatures whose monthly mean is required  

Typical conditions that will be applied  
• `year BETWEEN 2010 AND 2014` – restrict the five yearly tables to the study period  
• the four temperature columns **IS NOT NULL** – ensure each record used in the mean contains every temperature needed  
• optional quality checks such as `ncdc_qc_flags IS NULL` or record‑count thresholds can be added, but are not strictly required for the basic answer  

Below are ten exploratory/final BigQuery SQL statements (each different, all `SELECT` only, each limited to 20 rows).  
Replace or append additional logic as needed; the last two queries show how to arrive at the requested top‑3 result.

```sql
--Description: 1) Quick look at temperature values in 2010
SELECT year, month, air_temperature, wetbulb_temperature, dewpoint_temperature, sea_surface_temp
FROM `bigquery-public-data.noaa_icoads.icoads_core_2010`
LIMIT 20;
```

```sql
--Description: 2) Same quick look for 2011
SELECT year, month, air_temperature, wetbulb_temperature, dewpoint_temperature, sea_surface_temp
FROM `bigquery-public-data.noaa_icoads.icoads_core_2011`
LIMIT 20;
```

```sql
--Description: 3) Distinct year‑month pairs having *all* four temps in 2012
SELECT DISTINCT year, month
FROM `bigquery-public-data.noaa_icoads.icoads_core_2012`
WHERE air_temperature IS NOT NULL
  AND wetbulb_temperature IS NOT NULL
  AND dewpoint_temperature IS NOT NULL
  AND sea_surface_temp IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4) Monthly mean temperatures for 2013 (sample 20 rows)
SELECT year,
       month,
       AVG(air_temperature)       AS avg_air,
       AVG(wetbulb_temperature)   AS avg_wbt,
       AVG(dewpoint_temperature)  AS avg_dpt,
       AVG(sea_surface_temp)      AS avg_sst
FROM `bigquery-public-data.noaa_icoads.icoads_core_2013`
WHERE air_temperature IS NOT NULL
  AND wetbulb_temperature IS NOT NULL
  AND dewpoint_temperature IS NOT NULL
  AND sea_surface_temp IS NOT NULL
GROUP BY year, month
ORDER BY year, month
LIMIT 20;
```

```sql
--Description: 5) Count of valid observations in 2014 by month
SELECT year,
       month,
       COUNT(1) AS records_with_all_temps
FROM `bigquery-public-data.noaa_icoads.icoads_core_2014`
WHERE air_temperature IS NOT NULL
  AND wetbulb_temperature IS NOT NULL
  AND dewpoint_temperature IS NOT NULL
  AND sea_surface_temp IS NOT NULL
GROUP BY year, month
ORDER BY records_with_all_temps DESC
LIMIT 20;
```

```sql
--Description: 6) Union the five tables (2010‑14) and compute monthly means (first 20)
WITH all_years AS (
  SELECT year, month,
         air_temperature      AS air,
         wetbulb_temperature  AS wbt,
         dewpoint_temperature AS dpt,
         sea_surface_temp     AS sst
  FROM `bigquery-public-data.noaa_icoads.icoads_core_2010` UNION ALL
  SELECT year, month, air_temperature, wetbulb_temperature, dewpoint_temperature, sea_surface_temp
  FROM `bigquery-public-data.noaa_icoads.icoads_core_2011` UNION ALL
  SELECT year, month, air_temperature, wetbulb_temperature, dewpoint_temperature, sea_surface_temp
  FROM `bigquery-public-data.noaa_icoads.icoads_core_2012` UNION ALL
  SELECT year, month, air_temperature, wetbulb_temperature, dewpoint_temperature, sea_surface_temp
  FROM `bigquery-public-data.noaa_icoads.icoads_core_2013` UNION ALL
  SELECT year, month, air_temperature, wetbulb_temperature, dewpoint_temperature, sea_surface_temp
  FROM `bigquery-public-data.noaa_icoads.icoads_core_2014`
)
SELECT year, month,
       AVG(air) AS avg_air,
       AVG(wbt) AS avg_wbt,
       AVG(dpt) AS avg_dpt,
       AVG(sst) AS avg_sst
FROM all_years
WHERE air IS NOT NULL AND wbt IS NOT NULL AND dpt IS NOT NULL AND sst IS NOT NULL
GROUP BY year, month
ORDER BY year, month
LIMIT 20;
```

```sql
--Description: 7) Compute the monthly sum of |differences| between the four averages (sample 20)
WITH monthly_means AS (
  -- same CTE as query 6
  SELECT year, month,
         AVG(air_temperature)       AS avg_air,
         AVG(wetbulb_temperature)   AS avg_wbt,
         AVG(dewpoint_temperature)  AS avg_dpt,
         AVG(sea_surface_temp)      AS avg_sst
  FROM (
    SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2010`
    UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2011`
    UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2012`
    UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2013`
    UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2014`
  )
  WHERE year BETWEEN 2010 AND 2014
    AND air_temperature IS NOT NULL
    AND wetbulb_temperature IS NOT NULL
    AND dewpoint_temperature IS NOT NULL
    AND sea_surface_temp IS NOT NULL
  GROUP BY year, month
)
SELECT year,
       month,
       ABS(avg_air - avg_wbt) +
       ABS(avg_air - avg_dpt) +
       ABS(avg_air - avg_sst) +
       ABS(avg_wbt - avg_dpt) +
       ABS(avg_wbt - avg_sst) +
       ABS(avg_dpt - avg_sst) AS sum_abs_diff
FROM monthly_means
ORDER BY sum_abs_diff
LIMIT 20;
```

```sql
--Description: 8) Same as #7 but keep only months with ≥5,000 valid observations (sample 20)
WITH joined AS (
  SELECT year, month,
         air_temperature      AS air,
         wetbulb_temperature  AS wbt,
         dewpoint_temperature AS dpt,
         sea_surface_temp     AS sst
  FROM (
    SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2010`
    UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2011`
    UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2012`
    UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2013`
    UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2014`
  )
  WHERE year BETWEEN 2010 AND 2014
    AND air_temperature IS NOT NULL AND wetbulb_temperature IS NOT NULL
    AND dewpoint_temperature IS NOT NULL AND sea_surface_temp IS NOT NULL
),
monthly_stats AS (
  SELECT year, month,
         AVG(air) AS avg_air,
         AVG(wbt) AS avg_wbt,
         AVG(dpt) AS avg_dpt,
         AVG(sst) AS avg_sst,
         COUNT(*) AS nrec
  FROM joined
  GROUP BY year, month
  HAVING nrec >= 5000
)
SELECT year,
       month,
       ABS(avg_air - avg_wbt) +
       ABS(avg_air - avg_dpt) +
       ABS(avg_air - avg_sst) +
       ABS(avg_wbt - avg_dpt) +
       ABS(avg_wbt - avg_sst) +
       ABS(avg_dpt - avg_sst) AS sum_abs_diff
FROM monthly_stats
ORDER BY sum_abs_diff
LIMIT 20;
```

```sql
--Description: 9) FINAL – Top 3 months (YYYY, MM) with smallest sum of absolute differences
WITH joined AS (
  SELECT year, month,
         air_temperature      AS air,
         wetbulb_temperature  AS wbt,
         dewpoint_temperature AS dpt,
         sea_surface_temp     AS sst
  FROM (
    SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2010`
    UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2011`
    UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2012`
    UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2013`
    UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2014`
  )
  WHERE year BETWEEN 2010 AND 2014
    AND air_temperature IS NOT NULL AND wetbulb_temperature IS NOT NULL
    AND dewpoint_temperature IS NOT NULL AND sea_surface_temp IS NOT NULL
),
monthly_means AS (
  SELECT year, month,
         AVG(air) AS avg_air,
         AVG(wbt) AS avg_wbt,
         AVG(dpt) AS avg_dpt,
         AVG(sst) AS avg_sst
  FROM joined
  GROUP BY year, month
),
monthly_scores AS (
  SELECT year,
         month,
         ABS(avg_air - avg_wbt) +
         ABS(avg_air - avg_dpt) +
         ABS(avg_air - avg_sst) +
         ABS(avg_wbt - avg_dpt) +
         ABS(avg_wbt - avg_sst) +
         ABS(avg_dpt - avg_sst) AS sum_abs_diff
  FROM monthly_means
)
SELECT year, month, sum_abs_diff
FROM monthly_scores
ORDER BY sum_abs_diff
LIMIT 3;
```

```sql
--Description: 10) Same as #9 but shown in ascending order of year & month for the top‑3
WITH top3 AS (
  -- reuse the CTEs and logic from query 9
  WITH joined AS (
    SELECT year, month,
           air_temperature      AS air,
           wetbulb_temperature  AS wbt,
           dewpoint_temperature AS dpt,
           sea_surface_temp     AS sst
    FROM (
      SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2010`
      UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2011`
      UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2012`
      UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2013`
      UNION ALL SELECT * FROM `bigquery-public-data.noaa_icoads.icoads_core_2014`
    )
    WHERE year BETWEEN 2010 AND 2014
      AND air_temperature IS NOT NULL AND wetbulb_temperature IS NOT NULL
      AND dewpoint_temperature IS NOT NULL AND sea_surface_temp IS NOT NULL
  ),
  monthly_means AS (
    SELECT year, month,
           AVG(air) AS avg_air,
           AVG(wbt) AS avg_wbt,
           AVG(dpt) AS avg_dpt,
           AVG(sst) AS avg_sst
    FROM joined
    GROUP BY year, month
  ),
  monthly_scores AS (
    SELECT year,
           month,
           ABS(avg_air - avg_wbt) +
           ABS(avg_air - avg_dpt) +
           ABS(avg_air - avg_sst) +
           ABS(avg_wbt - avg_dpt) +
           ABS(avg_wbt - avg_sst) +
           ABS(avg_dpt - avg_sst) AS sum_abs_diff
    FROM monthly_means
  )
  SELECT *
  FROM monthly_scores
  ORDER BY sum_abs_diff
  LIMIT 3
)
SELECT year, month, sum_abs_diff
FROM top3
ORDER BY year, month
LIMIT 20;
```

