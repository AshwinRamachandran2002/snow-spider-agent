Query:
-- 10) FINAL: Difference in average balances between
--     (a) the month with the most customers who ended positive, and
--     (b) the month with the fewest customers who ended positive
WITH monthly_balances AS (
    SELECT customer_id,
           SUBSTR(txn_date, 1, 7) AS month_yyyy_mm,
           SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
               END) AS month_end_balance
    FROM customer_transactions
    WHERE txn_date LIKE '2020-%'
    GROUP BY customer_id, month_yyyy_mm
),
positive_counts AS (
    SELECT month_yyyy_mm,
           COUNT(DISTINCT customer_id) AS positive_cust_cnt
    FROM monthly_balances
    WHERE month_end_balance > 0
    GROUP BY month_yyyy_mm
),
target_months AS (
    SELECT month_yyyy_mm
    FROM positive_counts
    WHERE positive_cust_cnt = (SELECT MAX(positive_cust_cnt) FROM positive_counts)
    UNION
    SELECT month_yyyy_mm
    FROM positive_counts
    WHERE positive_cust_cnt = (SELECT MIN(positive_cust_cnt) FROM positive_counts)
),
avg_balances AS (
    SELECT month_yyyy_mm,
           AVG(month_end_balance) AS avg_balance
    FROM monthly_balances
    WHERE month_yyyy_mm IN (SELECT month_yyyy_mm FROM target_months)
    GROUP BY month_yyyy_mm
)
SELECT
       MAX(CASE WHEN rn = 1 THEN avg_balance END) AS avg_high_month,
       MAX(CASE WHEN rn = 2 THEN avg_balance END) AS avg_low_month,
       (MAX(CASE WHEN rn = 1 THEN avg_balance END)
        -
        MAX(CASE WHEN rn = 2 THEN avg_balance END))  AS difference_between_avgs
FROM (
      SELECT month_yyyy_mm,
             avg_balance,
             ROW_NUMBER() OVER (ORDER BY avg_balance DESC) AS rn
      FROM avg_balances
) t
LIMIT 20;
