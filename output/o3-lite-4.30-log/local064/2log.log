Relevant tables, columns and how they will be used

customer_transactions  
• customer_id : customer identifier – will be used to aggregate by customer  
• txn_date : transaction date – will be filtered to the ‘2020‑%’ year and truncated to year‑month for month‑level aggregation  
• txn_type : either ‘deposit’ or ‘withdrawal’; will drive +/‑ sign logic in balance calculation  
• txn_amount : amount to be summed (+ for deposits, – for withdrawals)  

Typical conditions we will need  
• txn_date LIKE '2020-%'            → keep only 2020 activity  
• txn_type = 'deposit'              → deposits only  
• txn_type = 'withdrawal'           → withdrawals only  
• balance > 0                       → customers with positive month‑end balance  
• strftime('%Y-%m', txn_date) …     → convert txn_date to yyyy‑mm (if the format is already ‘YYYY‑MM‑DD’ we can also just use SUBSTR)  

10 exploratory–to–final SQL queries
(Every query limited to 20 rows, each preceded by an explanatory comment)

```sql
-- 1) List the different transaction types that exist in the data set
SELECT DISTINCT txn_type
FROM customer_transactions
LIMIT 20;
```

```sql
-- 2) Quickly inspect a few 2020 transactions
SELECT *
FROM customer_transactions
WHERE txn_date LIKE '2020-%'
LIMIT 20;
```

```sql
-- 3) Show total deposits per customer for January‑2020
SELECT customer_id,
       SUM(txn_amount) AS jan20_deposits
FROM customer_transactions
WHERE txn_type = 'deposit'
  AND txn_date BETWEEN '2020-01-01' AND '2020-01-31'
GROUP BY customer_id
LIMIT 20;
```

```sql
-- 4) Show total withdrawals per customer for January‑2020
SELECT customer_id,
       SUM(txn_amount) AS jan20_withdrawals
FROM customer_transactions
WHERE txn_type = 'withdrawal'
  AND txn_date BETWEEN '2020-01-01' AND '2020-01-31'
GROUP BY customer_id
LIMIT 20;
```

```sql
-- 5) Compute each customer’s net month‑end balance for every 2020 month
SELECT customer_id,
       SUBSTR(txn_date, 1, 7)          AS month_yyyy_mm,
       SUM(CASE WHEN txn_type='deposit'     THEN txn_amount
                WHEN txn_type='withdrawal'  THEN -txn_amount
           END)                         AS month_end_balance
FROM customer_transactions
WHERE txn_date LIKE '2020-%'
GROUP BY customer_id, month_yyyy_mm
LIMIT 20;
```

```sql
-- 6) Count, for every month, how many customers ended the month with a positive balance
WITH monthly_balances AS (
    SELECT customer_id,
           SUBSTR(txn_date, 1, 7) AS month_yyyy_mm,
           SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
               END)                AS month_end_balance
    FROM customer_transactions
    WHERE txn_date LIKE '2020-%'
    GROUP BY customer_id, month_yyyy_mm
)
SELECT month_yyyy_mm,
       COUNT(DISTINCT customer_id) AS positive_cust_cnt
FROM monthly_balances
WHERE month_end_balance > 0
GROUP BY month_yyyy_mm
ORDER BY month_yyyy_mm
LIMIT 20;
```

```sql
-- 7) Identify the month(s) in 2020 with the highest positive‑customer count
WITH monthly_balances AS (
    SELECT customer_id,
           SUBSTR(txn_date, 1, 7) AS month_yyyy_mm,
           SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
               END) AS month_end_balance
    FROM customer_transactions
    WHERE txn_date LIKE '2020-%'
    GROUP BY customer_id, month_yyyy_mm
),
positive_counts AS (
    SELECT month_yyyy_mm,
           COUNT(DISTINCT customer_id) AS positive_cust_cnt
    FROM monthly_balances
    WHERE month_end_balance > 0
    GROUP BY month_yyyy_mm
)
SELECT *
FROM positive_counts
WHERE positive_cust_cnt = (SELECT MAX(positive_cust_cnt) FROM positive_counts)
LIMIT 20;
```

```sql
-- 8) Identify the month(s) in 2020 with the lowest positive‑customer count
WITH monthly_balances AS (
    SELECT customer_id,
           SUBSTR(txn_date, 1, 7) AS month_yyyy_mm,
           SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
               END) AS month_end_balance
    FROM customer_transactions
    WHERE txn_date LIKE '2020-%'
    GROUP BY customer_id, month_yyyy_mm
),
positive_counts AS (
    SELECT month_yyyy_mm,
           COUNT(DISTINCT customer_id) AS positive_cust_cnt
    FROM monthly_balances
    WHERE month_end_balance > 0
    GROUP BY month_yyyy_mm
)
SELECT *
FROM positive_counts
WHERE positive_cust_cnt = (SELECT MIN(positive_cust_cnt) FROM positive_counts)
LIMIT 20;
```

```sql
-- 9) Average month‑end balance for every month (needed to later pick only the two target months)
WITH monthly_balances AS (
    SELECT customer_id,
           SUBSTR(txn_date, 1, 7) AS month_yyyy_mm,
           SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
               END) AS month_end_balance
    FROM customer_transactions
    WHERE txn_date LIKE '2020-%'
    GROUP BY customer_id, month_yyyy_mm
)
SELECT month_yyyy_mm,
       AVG(month_end_balance) AS avg_month_end_balance
FROM monthly_balances
GROUP BY month_yyyy_mm
ORDER BY month_yyyy_mm
LIMIT 20;
```

```sql
-- 10) FINAL: Difference in average balances between
--     (a) the month with the most customers who ended positive, and
--     (b) the month with the fewest customers who ended positive
WITH monthly_balances AS (
    SELECT customer_id,
           SUBSTR(txn_date, 1, 7) AS month_yyyy_mm,
           SUM(CASE WHEN txn_type='deposit'    THEN txn_amount
                    WHEN txn_type='withdrawal' THEN -txn_amount
               END) AS month_end_balance
    FROM customer_transactions
    WHERE txn_date LIKE '2020-%'
    GROUP BY customer_id, month_yyyy_mm
),
positive_counts AS (
    SELECT month_yyyy_mm,
           COUNT(DISTINCT customer_id) AS positive_cust_cnt
    FROM monthly_balances
    WHERE month_end_balance > 0
    GROUP BY month_yyyy_mm
),
target_months AS (
    SELECT month_yyyy_mm
    FROM positive_counts
    WHERE positive_cust_cnt = (SELECT MAX(positive_cust_cnt) FROM positive_counts)
    UNION
    SELECT month_yyyy_mm
    FROM positive_counts
    WHERE positive_cust_cnt = (SELECT MIN(positive_cust_cnt) FROM positive_counts)
),
avg_balances AS (
    SELECT month_yyyy_mm,
           AVG(month_end_balance) AS avg_balance
    FROM monthly_balances
    WHERE month_yyyy_mm IN (SELECT month_yyyy_mm FROM target_months)
    GROUP BY month_yyyy_mm
)
SELECT
       MAX(CASE WHEN rn = 1 THEN avg_balance END) AS avg_high_month,
       MAX(CASE WHEN rn = 2 THEN avg_balance END) AS avg_low_month,
       (MAX(CASE WHEN rn = 1 THEN avg_balance END)
        -
        MAX(CASE WHEN rn = 2 THEN avg_balance END))  AS difference_between_avgs
FROM (
      SELECT month_yyyy_mm,
             avg_balance,
             ROW_NUMBER() OVER (ORDER BY avg_balance DESC) AS rn
      FROM avg_balances
) t
LIMIT 20;
```
