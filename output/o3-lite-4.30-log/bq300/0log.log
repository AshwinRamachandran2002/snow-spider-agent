```sql
--Description: We need the largest answer_count for a question that is explicitly
--             about Python 2 but not Python 3.  In the public Stack Overflow dataset
--             each post’s tags are stored as a single pipe‑delimited string such as
--             “python|python-2.x|pandas”.  Therefore:
--               • A Python‑2 question = any tag that starts with “python-2”.
--               • Exclude questions that also have a tag that starts with “python-3”.
--             REGEXP_CONTAINS is convenient because we can anchor the match at the
--             beginning of a tag or after a ‘|’.  Finally, we take MAX(answer_count)
--             to obtain the highest number of answers any such question received.

SELECT
  MAX(answer_count) AS highest_python2_only_answer_count
FROM
  `bigquery-public-data.stackoverflow.posts_questions`
WHERE
  REGEXP_CONTAINS(LOWER(tags), r'(^|[|])python-2')      -- has a Python‑2 tag
  AND NOT REGEXP_CONTAINS(LOWER(tags), r'(^|[|])python-3');  -- but no Python‑3 tag
```
