--Description:
-- Determine the maximum number of answers any Stack Overflow question ever received
-- while being explicitly about Python 2 and making no reference to Python 3.
-- • Table used: bigquery-public-data.stackoverflow.posts_questions
-- • answer_count holds the count we want to maximise.
-- • A question is considered “Python 2–specific” when its tags include “python-2”
--   or “python2”, or its title/body text contains “python 2”.
-- • It is excluded if it has a “python-3” tag or if the title/body text mentions “python 3”.
-- • Finally, we apply MAX() to obtain the single highest answer_count.
SELECT
  MAX(answer_count) AS highest_answer_count_python2
FROM
  `bigquery-public-data.stackoverflow.posts_questions`
WHERE
  (
    tags LIKE '%python-2%'             -- python-2.x, python-27, etc.
    OR tags LIKE '%python2%'           -- alternative spelling
    OR LOWER(title) LIKE '%python 2%'  -- textual mention in title
    OR LOWER(body)  LIKE '%python 2%'  -- textual mention in body
  )
  AND tags NOT LIKE '%python-3%'           -- exclude python‑3 tag
  AND LOWER(title) NOT LIKE '%python 3%'   -- exclude title mentions of python 3
  AND LOWER(body)  NOT LIKE '%python 3%';  -- exclude body mentions of python 3
