Begin Exploring Related Columns
Relevant columns and how they will be used  

actor.actor_id : primary key of actors – join to film_actor.actor_id  
actor.first_name / actor.last_name : show human‑readable actor names  
film_actor.actor_id : link an actor to each film (JOIN to actor & film)  
film_actor.film_id : link each film back to film and then to inventory  
inventory.film_id : link a film to every individual copy (JOIN to film_actor)  
inventory.inventory_id : link each physical copy to rentals (JOIN to rental)  
rental.inventory_id : tie a rental to the inventory copy (JOIN to inventory)  
rental.customer_id : tells which customer made the rental  
customer.customer_id : base population; lets us count every customer  

Typical conditions / join paths  
film_actor.film_id = inventory.film_id  
inventory.inventory_id = rental.inventory_id  
rental.customer_id = customer.customer_id  
Filtering actors that appear in the TOP‑5 list (a sub‑query ordered by
COUNT(*) DESC LIMIT 5).  

------------------------------------------------------------------------
Exploratory queries (all limited to 20 rows where reasonable)

```sql
-- 1) List a handful of actors
SELECT DISTINCT "actor_id", "first_name", "last_name"
FROM "actor"
LIMIT 20;
```

```sql
-- 2) How many different films has each actor performed in?
SELECT fa."actor_id",
       COUNT(DISTINCT fa."film_id") AS film_count
FROM   "film_actor" AS fa
GROUP  BY fa."actor_id"
ORDER  BY film_count DESC
LIMIT 20;
```

```sql
-- 3) Rental count credited to each actor (via films they appear in)
SELECT fa."actor_id",
       COUNT(*) AS rental_count
FROM   "film_actor" AS fa
JOIN   "inventory" AS i  ON i."film_id"   = fa."film_id"
JOIN   "rental"   AS r  ON r."inventory_id" = i."inventory_id"
GROUP  BY fa."actor_id"
ORDER  BY rental_count DESC
LIMIT 20;
```

```sql
-- 4) The TOP‑5 actors by total rentals, including their names
SELECT fa."actor_id",
       a."first_name",
       a."last_name",
       COUNT(*) AS rental_count
FROM   "film_actor" AS fa
JOIN   "actor"     AS a ON a."actor_id" = fa."actor_id"
JOIN   "inventory" AS i ON i."film_id"  = fa."film_id"
JOIN   "rental"    AS r ON r."inventory_id" = i."inventory_id"
GROUP  BY fa."actor_id"
ORDER  BY rental_count DESC
LIMIT 5;
```

```sql
-- 5) Sample of customers who rented a film with any of the TOP‑5 actors
SELECT DISTINCT r."customer_id"
FROM   "rental"      AS r
JOIN   "inventory"   AS i  ON i."inventory_id" = r."inventory_id"
JOIN   "film_actor"  AS fa ON fa."film_id"     = i."film_id"
WHERE  fa."actor_id" IN (
        SELECT fa2."actor_id"
        FROM   "film_actor" AS fa2
        JOIN   "inventory"  AS i2 ON i2."film_id"     = fa2."film_id"
        JOIN   "rental"     AS r2 ON r2."inventory_id" = i2."inventory_id"
        GROUP  BY fa2."actor_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 5
)
LIMIT 20;
```

```sql
-- 6) Total number of DISTINCT customers who rented TOP‑5 actors’ films
SELECT COUNT(DISTINCT r."customer_id") AS customers_top5_actors
FROM   "rental"      AS r
JOIN   "inventory"   AS i  ON i."inventory_id" = r."inventory_id"
JOIN   "film_actor"  AS fa ON fa."film_id"     = i."film_id"
WHERE  fa."actor_id" IN (
        SELECT fa2."actor_id"
        FROM   "film_actor" AS fa2
        JOIN   "inventory"  AS i2 ON i2."film_id"     = fa2."film_id"
        JOIN   "rental"     AS r2 ON r2."inventory_id" = i2."inventory_id"
        GROUP  BY fa2."actor_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 5
);
```

```sql
-- 7) Count of all customers in the database
SELECT COUNT(*) AS total_customers
FROM   "customer";
```

```sql
-- 8) Percentage of customers who have rented films featuring the TOP‑5 actors
SELECT 100.0 * t1.customers_top5 / t2.total AS percentage_customers
FROM  (
       SELECT COUNT(DISTINCT r."customer_id") AS customers_top5
       FROM   "rental"     AS r
       JOIN   "inventory"  AS i  ON i."inventory_id" = r."inventory_id"
       JOIN   "film_actor" AS fa ON fa."film_id"     = i."film_id"
       WHERE  fa."actor_id" IN (
                SELECT fa2."actor_id"
                FROM   "film_actor" AS fa2
                JOIN   "inventory"  AS i2 ON i2."film_id"     = fa2."film_id"
                JOIN   "rental"     AS r2 ON r2."inventory_id" = i2."inventory_id"
                GROUP  BY fa2."actor_id"
                ORDER  BY COUNT(*) DESC
                LIMIT 5
       )
) AS t1
CROSS JOIN (
       SELECT COUNT(*) AS total
       FROM   "customer"
) AS t2;
```

```sql
-- 9) Quick lookup table: IDs and names of those TOP‑5 actors
SELECT "actor_id", "first_name", "last_name"
FROM   "actor"
WHERE  "actor_id" IN (
        SELECT fa2."actor_id"
        FROM   "film_actor" AS fa2
        JOIN   "inventory"  AS i2 ON i2."film_id"     = fa2."film_id"
        JOIN   "rental"     AS r2 ON r2."inventory_id" = i2."inventory_id"
        GROUP  BY fa2."actor_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 5
)
LIMIT 20;
```

```sql
-- 10) A sample of rentals showing which actor was involved
SELECT r."rental_id",
       r."customer_id",
       fa."actor_id",
       a."first_name",
       a."last_name",
       i."film_id"
FROM   "rental"      AS r
JOIN   "inventory"   AS i  ON i."inventory_id" = r."inventory_id"
JOIN   "film_actor"  AS fa ON fa."film_id"     = i."film_id"
JOIN   "actor"       AS a  ON a."actor_id"     = fa."actor_id"
LIMIT 20;
```
