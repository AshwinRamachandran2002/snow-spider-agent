-- 10. FINAL query: overall average salary for remote Data‑Analyst jobs
--     that require at least one of the TOP‑3 skills.
WITH filtered_jobs AS (           -- Remote Data‑Analyst postings with salary
     SELECT "job_id", "salary_year_avg"
     FROM   "job_postings_fact"
     WHERE  "job_title_short" LIKE 'Data Analyst'
       AND  "job_work_from_home" = 1
       AND  "salary_year_avg"    IS NOT NULL),

     top3_skills AS (            -- Determine the 3 most requested skills
     SELECT sd."skill_id"
     FROM   "skills_job_dim" AS sj
     JOIN   filtered_jobs   AS fj ON fj."job_id" = sj."job_id"
     JOIN   "skills_dim"     AS sd ON sd."skill_id" = sj."skill_id"
     GROUP  BY sd."skill_id"
     ORDER  BY COUNT(*) DESC
     LIMIT  3),

     jobs_with_top3 AS (         -- Jobs that have any of those 3 skills
     SELECT DISTINCT sj."job_id"
     FROM   "skills_job_dim" AS sj
     WHERE  sj."skill_id" IN (SELECT "skill_id" FROM top3_skills) )

SELECT AVG(fj."salary_year_avg") AS "overall_avg_salary"
FROM   filtered_jobs AS fj
WHERE  fj."job_id" IN (SELECT "job_id" FROM jobs_with_top3)
