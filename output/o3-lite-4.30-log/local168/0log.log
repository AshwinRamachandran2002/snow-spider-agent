Relevant columns and how they will be used  
• job_postings_fact."job_id":  join key to skills_job_dim  
• job_postings_fact."job_title_short":  filter to only “Data Analyst” postings  
• job_postings_fact."job_work_from_home":  select only remote postings (value = 1)  
• job_postings_fact."salary_year_avg":  keep records whose annual‐average salary is not NULL; use it to compute the final average  
• skills_job_dim."job_id":  join to the matching job in job_postings_fact  
• skills_job_dim."skill_id":  join to skills_dim  
• skills_dim."skill_id":  join key  
• skills_dim."skills":  skill name; used to find the three most frequently requested skills  

Typical filter conditions  
  job_postings_fact."job_title_short"  LIKE 'Data Analyst'  
  job_postings_fact."job_work_from_home" = 1  
  job_postings_fact."salary_year_avg"   IS NOT NULL  

Exploratory SQL queries
```sql
-- 1. Distinct short titles to verify exact spelling of “Data Analyst”.
SELECT DISTINCT "job_title_short"
FROM   "job_postings_fact"
LIMIT  20;

-- 2. A peek at Data‑Analyst postings together with salary and remote flag.
SELECT "job_id",
       "job_title_short",
       "job_work_from_home",
       "salary_year_avg"
FROM   "job_postings_fact"
WHERE  "job_title_short" LIKE 'Data Analyst'
LIMIT  20;

-- 3. Data‑Analyst postings that are remote and have a non‑null annual salary.
SELECT "job_id",
       "salary_year_avg"
FROM   "job_postings_fact"
WHERE  "job_title_short"     LIKE 'Data Analyst'
  AND  "job_work_from_home"  = 1
  AND  "salary_year_avg"     IS NOT NULL
LIMIT  20;

-- 4. How many such remote & paid Data‑Analyst postings exist?
SELECT COUNT(*) AS "remote_paid_data_analyst_jobs"
FROM   "job_postings_fact"
WHERE  "job_title_short"     LIKE 'Data Analyst'
  AND  "job_work_from_home"  = 1
  AND  "salary_year_avg"     IS NOT NULL;

-- 5. Show the skills (id only) linked to those jobs.
SELECT sj."skill_id",
       sj."job_id"
FROM   "skills_job_dim"  AS sj
WHERE  sj."job_id" IN (
       SELECT "job_id"
       FROM   "job_postings_fact"
       WHERE  "job_title_short" LIKE 'Data Analyst'
         AND  "job_work_from_home" = 1
         AND  "salary_year_avg"    IS NOT NULL)
LIMIT  20;

-- 6. Add skill names and count their occurrences.
SELECT sd."skills",
       COUNT(*) AS "times_requested"
FROM   "skills_job_dim" AS sj
JOIN   "skills_dim"     AS sd
       ON sd."skill_id" = sj."skill_id"
WHERE  sj."job_id" IN (
       SELECT "job_id"
       FROM   "job_postings_fact"
       WHERE  "job_title_short" LIKE 'Data Analyst'
         AND  "job_work_from_home" = 1
         AND  "salary_year_avg"    IS NOT NULL)
GROUP  BY sd."skills"
ORDER  BY "times_requested" DESC
LIMIT  20;

-- 7. Retrieve only the TOP‑3 most frequent skills.
SELECT sd."skills",
       COUNT(*) AS "times_requested"
FROM   "skills_job_dim" AS sj
JOIN   "skills_dim"     AS sd
       ON sd."skill_id" = sj."skill_id"
WHERE  sj."job_id" IN (
       SELECT "job_id"
       FROM   "job_postings_fact"
       WHERE  "job_title_short" LIKE 'Data Analyst'
         AND  "job_work_from_home" = 1
         AND  "salary_year_avg"    IS NOT NULL)
GROUP  BY sd."skills"
ORDER  BY "times_requested" DESC
LIMIT  3;

-- 8. List job‑ids that contain at least one of those TOP‑3 skills.
WITH top3 AS (
     SELECT sd."skill_id"
     FROM   "skills_job_dim" AS sj
     JOIN   "skills_dim"     AS sd ON sd."skill_id" = sj."skill_id"
     WHERE  sj."job_id" IN (
            SELECT "job_id"
            FROM   "job_postings_fact"
            WHERE  "job_title_short" LIKE 'Data Analyst'
              AND  "job_work_from_home" = 1
              AND  "salary_year_avg"    IS NOT NULL)
     GROUP  BY sd."skill_id"
     ORDER  BY COUNT(*) DESC
     LIMIT  3 )
SELECT DISTINCT sj."job_id"
FROM   "skills_job_dim" AS sj
WHERE  sj."skill_id" IN (SELECT "skill_id" FROM top3)
LIMIT  20;

-- 9. Inspect salaries of jobs that have any of those TOP‑3 skills.
WITH top3 AS (
     SELECT sd."skill_id"
     FROM   "skills_job_dim" AS sj
     JOIN   "skills_dim"     AS sd ON sd."skill_id" = sj."skill_id"
     WHERE  sj."job_id" IN (
            SELECT "job_id"
            FROM   "job_postings_fact"
            WHERE  "job_title_short" LIKE 'Data Analyst'
              AND  "job_work_from_home" = 1
              AND  "salary_year_avg"    IS NOT NULL)
     GROUP  BY sd."skill_id"
     ORDER  BY COUNT(*) DESC
     LIMIT  3 )
SELECT jp."job_id",
       jp."salary_year_avg"
FROM   "job_postings_fact" AS jp
WHERE  jp."job_id" IN (
       SELECT DISTINCT sj."job_id"
       FROM   "skills_job_dim" AS sj
       WHERE  sj."skill_id" IN (SELECT "skill_id" FROM top3))
LIMIT  20;

-- 10. FINAL query: overall average salary for remote Data‑Analyst jobs
--     that require at least one of the TOP‑3 skills.
WITH filtered_jobs AS (           -- Remote Data‑Analyst postings with salary
     SELECT "job_id", "salary_year_avg"
     FROM   "job_postings_fact"
     WHERE  "job_title_short" LIKE 'Data Analyst'
       AND  "job_work_from_home" = 1
       AND  "salary_year_avg"    IS NOT NULL),

     top3_skills AS (            -- Determine the 3 most requested skills
     SELECT sd."skill_id"
     FROM   "skills_job_dim" AS sj
     JOIN   filtered_jobs   AS fj ON fj."job_id" = sj."job_id"
     JOIN   "skills_dim"     AS sd ON sd."skill_id" = sj."skill_id"
     GROUP  BY sd."skill_id"
     ORDER  BY COUNT(*) DESC
     LIMIT  3),

     jobs_with_top3 AS (         -- Jobs that have any of those 3 skills
     SELECT DISTINCT sj."job_id"
     FROM   "skills_job_dim" AS sj
     WHERE  sj."skill_id" IN (SELECT "skill_id" FROM top3_skills) )

SELECT AVG(fj."salary_year_avg") AS "overall_avg_salary"
FROM   filtered_jobs AS fj
WHERE  fj."job_id" IN (SELECT "job_id" FROM jobs_with_top3);
```

