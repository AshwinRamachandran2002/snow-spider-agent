JOIN   "skills_job_dim"    AS sj ON jf."job_id" = sj."job_id"
JOIN   "skills_dim"        AS sd ON sj."skill_id" = sd."skill_id"
WHERE  jf."job_title_short"   = 'Data Analyst'
  AND  jf."job_work_from_home" = 1
  AND  jf."salary_year_avg"    IS NOT NULL
GROUP  BY sd."skills"
ORDER  BY freq DESC
LIMIT 20;
```

```sql
--Description: #8  – Extract only the TOP‑3 most frequent skills (names) for the target postings,
--using a sub‑query sorted by COUNT(*) DESC and limited to 3.
SELECT "skills"
FROM (
      SELECT sd."skills",
             COUNT(*) AS freq
      FROM   "job_postings_fact" AS jf
      JOIN   "skills_job_dim"    AS sj ON jf."job_id" = sj."job_id"
      JOIN   "skills_dim"        AS sd ON sj."skill_id" = sd."skill_id"
      WHERE  jf."job_title_short"   = 'Data Analyst'
        AND  jf."job_work_from_home" = 1
        AND  jf."salary_year_avg"    IS NOT NULL
      GROUP  BY sd."skills"
      ORDER  BY freq DESC
      LIMIT 3
) AS top3
LIMIT 20;
```

```sql
--Description: #9  – Return every DISTINCT (job_id, salary) pair that belongs to at least one
--of the TOP‑3 skills identified in #8.  The WITH‐clause first captures those skill_ids.
WITH top3 AS (
     SELECT sd."skill_id"
     FROM   "job_postings_fact" AS jf
     JOIN   "skills_job_dim"    AS sj ON jf."job_id" = sj."job_id"
     JOIN   "skills_dim"        AS sd ON sj."skill_id" = sd."skill_id"
     WHERE  jf."job_title_short"   = 'Data Analyst'
       AND  jf."job_work_from_home" = 1
       AND  jf."salary_year_avg"    IS NOT NULL
     GROUP  BY sd."skill_id"
     ORDER  BY COUNT(*) DESC
     LIMIT 3
)
SELECT DISTINCT jf."job_id",
       jf."salary_year_avg"
FROM   "job_postings_fact" AS jf
JOIN   "skills_job_dim"    AS sj ON jf."job_id" = sj."job_id"
WHERE  jf."job_title_short"   = 'Data Analyst'
  AND  jf."job_work_from_home" = 1
  AND  jf."salary_year_avg"    IS NOT NULL
  AND  sj."skill_id" IN (SELECT "skill_id" FROM top3)
LIMIT 20;
```

```sql
--Description: #10  – FINAL answer.  Compute the overall average annual salary for remote
--“Data Analyst” postings (salary present) that mention at least one of the three most
--frequently requested skills for that cohort.
WITH filtered AS (
     SELECT jf."job_id",
            jf."salary_year_avg"
     FROM   "job_postings_fact" AS jf
     WHERE  jf."job_title_short"   = 'Data Analyst'
       AND  jf."job_work_from_home" = 1
       AND  jf."salary_year_avg"    IS NOT NULL
),
top3 AS (
     SELECT sd."skill_id"
     FROM   filtered          AS f
     JOIN   "skills_job_dim"  AS sj ON f."job_id" = sj."job_id"
     JOIN   "skills_dim"      AS sd ON sj."skill_id" = sd."skill_id"
     GROUP  BY sd."skill_id"
     ORDER  BY COUNT(*) DESC
     LIMIT 3
),
jobs_with_top3 AS (
     SELECT DISTINCT f."job_id",
            f."salary_year_avg"
     FROM   filtered          AS f
     JOIN   "skills_job_dim"  AS sj ON f."job_id" = sj."job_id"
     WHERE  sj."skill_id" IN (SELECT "skill_id" FROM top3)
)
SELECT AVG("salary_year_avg") AS overall_avg_salary
FROM   jobs_with_top3;
```
