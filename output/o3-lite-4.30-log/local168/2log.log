LIMIT 20;
```

```sql
--Description: #6  – Count how often each skill occurs for those same postings.  The INNER JOIN
--sequence mirrors #5 to be sure every counted row truly belongs to a qualified job.
SELECT sd."skills",
       COUNT(*) AS freq
FROM   "job_postings_fact" AS jf
JOIN   "skills_job_dim"    AS sj ON jf."job_id" = sj."job_id"
JOIN   "skills_dim"        AS sd ON sj."skill_id" = sd."skill_id"
WHERE  jf."job_title_short"   = 'Data Analyst'
  AND  jf."job_work_from_home" = 1
  AND  jf."salary_year_avg"    IS NOT NULL
GROUP  BY sd."skills"
LIMIT 20;
```

```sql
