JOIN   "skills_job_dim"    AS sj ON jf."job_id" = sj."job_id"
JOIN   "skills_dim"        AS sd ON sj."skill_id" = sd."skill_id"
WHERE  jf."job_title_short"   = 'Data Analyst'
  AND  jf."job_work_from_home" = 1
