The table structure information is (table names): 
['aliens_details', 'skills_dim', 'legislators_terms', 'cities_currencies', 'legislators', 'skills_job_dim', 'job_postings_fact', 'alien_data', 'cities_countries', 'legislation_date_dim', 'cities', 'aliens_location', 'aliens', 'cities_languages', 'job_company']
Begin Exploring Related Columns
Relevant tables, columns, and how they will be used
• job_postings_fact  
  – job_id : join key to skills_job_dim  
  – job_title_short : filter to ‘Data Analyst’ postings  
  – job_work_from_home : identify remote (1 = remote)  
  – salary_year_avg : must be NOT NULL, and will be averaged  

• skills_job_dim  
  – job_id : join to job_postings_fact  
  – skill_id : join to skills_dim  

• skills_dim  
  – skill_id : join key  
  – skills : name of the skill (to find the “top‑3 most frequent” skills)  

Basic conditions we will repeatedly use  
1. job_postings_fact."job_title_short" = 'Data Analyst'  
2. job_postings_fact."job_work_from_home" = 1                 -- remote only  
3. job_postings_fact."salary_year_avg" IS NOT NULL            -- salary present  

Below are 10 exploratory → increasingly complex SQL queries, each limited to 20 rows and annotated.

```sql
-- 1. List the distinct short titles to confirm wording
SELECT DISTINCT "job_title_short"
FROM "job_postings_fact"
LIMIT 20;
```

```sql
-- 2. What values appear in the remote flag?
SELECT DISTINCT "job_work_from_home"
FROM "job_postings_fact"
LIMIT 20;
```

```sql
-- 3. Peek at remote Data‑Analyst postings that have a salary
SELECT "job_id",
       "job_title_short",
       "job_work_from_home",
       "salary_year_avg"
FROM   "job_postings_fact"
WHERE  "job_title_short" = 'Data Analyst'
  AND  "job_work_from_home" = 1
  AND  "salary_year_avg" IS NOT NULL
LIMIT 20;
```

```sql
-- 4. Show skills connected to one sample Data‑Analyst posting
SELECT sj."job_id",
       sd."skills"
FROM   "skills_job_dim"  AS sj
JOIN   "skills_dim"      AS sd USING ("skill_id")
WHERE  sj."job_id" = (SELECT "job_id"
                      FROM   "job_postings_fact"
                      WHERE  "job_title_short" = 'Data Analyst'
                        AND  "job_work_from_home" = 1
                        AND  "salary_year_avg" IS NOT NULL
                      LIMIT 1)
LIMIT 20;
```

```sql
-- 5. All skills for every remote, salaried Data‑Analyst posting (no counts yet)
SELECT DISTINCT sd."skills"
FROM   "job_postings_fact" AS jf
JOIN   "skills_job_dim"    AS sj USING ("job_id")
JOIN   "skills_dim"        AS sd USING ("skill_id")
WHERE  jf."job_title_short" = 'Data Analyst'
  AND  jf."job_work_from_home" = 1
  AND  jf."salary_year_avg" IS NOT NULL
LIMIT 20;
```

```sql
-- 6. Frequency of each skill for those postings (top results, unsorted preview)
SELECT sd."skills",
       COUNT(*) AS freq
FROM   "job_postings_fact" AS jf
JOIN   "skills_job_dim"    AS sj USING ("job_id")
JOIN   "skills_dim"        AS sd USING ("skill_id")
WHERE  jf."job_title_short" = 'Data Analyst'
  AND  jf."job_work_from_home" = 1
  AND  jf."salary_year_avg" IS NOT NULL
GROUP  BY sd."skills"
LIMIT 20;
```

```sql
-- 7. Same as #6 but sorted to see the most frequent skills
SELECT sd."skills",
       COUNT(*) AS freq
FROM   "job_postings_fact" AS jf
JOIN   "skills_job_dim"    AS sj USING ("job_id")
JOIN   "skills_dim"        AS sd USING ("skill_id")
WHERE  jf."job_title_short" = 'Data Analyst'
  AND  jf."job_work_from_home" = 1
  AND  jf."salary_year_avg" IS NOT NULL
GROUP  BY sd."skills"
ORDER  BY freq DESC
LIMIT 20;
```

```sql
-- 8. Derive only the TOP‑3 most common skills (sub‑query)
SELECT "skills"
FROM  (
       SELECT sd."skills",
              COUNT(*) AS freq
       FROM   "job_postings_fact" AS jf
       JOIN   "skills_job_dim"    AS sj USING ("job_id")
       JOIN   "skills_dim"        AS sd USING ("skill_id")
       WHERE  jf."job_title_short" = 'Data Analyst'
         AND  jf."job_work_from_home" = 1
         AND  jf."salary_year_avg" IS NOT NULL
       GROUP  BY sd."skills"
       ORDER  BY freq DESC
       LIMIT 3
) AS top3
LIMIT 20;
```

```sql
-- 9. Show every (job_id, salary) that involves at least one of those top‑3 skills
WITH top3 AS (
       SELECT sd."skill_id"
       FROM   "job_postings_fact" AS jf
       JOIN   "skills_job_dim"    AS sj USING ("job_id")
       JOIN   "skills_dim"        AS sd USING ("skill_id")
       WHERE  jf."job_title_short" = 'Data Analyst'
         AND  jf."job_work_from_home" = 1
         AND  jf."salary_year_avg" IS NOT NULL
       GROUP  BY sd."skill_id"
       ORDER  BY COUNT(*) DESC
       LIMIT 3
)
SELECT DISTINCT jf."job_id",
       jf."salary_year_avg"
FROM   "job_postings_fact" AS jf
JOIN   "skills_job_dim"    AS sj USING ("job_id")
WHERE  jf."job_title_short" = 'Data Analyst'
  AND  jf."job_work_from_home" = 1
  AND  jf."salary_year_avg" IS NOT NULL
  AND  sj."skill_id" IN (SELECT "skill_id" FROM top3)
LIMIT 20;
```

```sql
-- 10. FINAL: overall average salary for remote Data‑Analyst roles that list any of the top‑3 skills
WITH filtered AS (
       SELECT jf."job_id",
              jf."salary_year_avg"
       FROM   "job_postings_fact" AS jf
       WHERE  jf."job_title_short" = 'Data Analyst'
         AND  jf."job_work_from_home" = 1
         AND  jf."salary_year_avg" IS NOT NULL
),
top3 AS (
       SELECT sd."skill_id"
       FROM   filtered AS f
       JOIN   "skills_job_dim" AS sj USING ("job_id")
       JOIN   "skills_dim"     AS sd USING ("skill_id")
       GROUP  BY sd."skill_id"
       ORDER  BY COUNT(*) DESC
       LIMIT 3
),
jobs_with_top3 AS (
       SELECT DISTINCT f."job_id",
              f."salary_year_avg"
       FROM   filtered          AS f
       JOIN   "skills_job_dim"  AS sj USING ("job_id")
       WHERE  sj."skill_id" IN (SELECT "skill_id" FROM top3)
)
SELECT AVG("salary_year_avg") AS overall_avg_salary
FROM   jobs_with_top3;
```

