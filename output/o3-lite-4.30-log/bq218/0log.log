```

```sql
-- 4) Total 2023 sales dollars by item (un‑ranked)
SELECT
  item_number,
  item_description,
  SUM(sale_dollars) AS sales_2023
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2023
GROUP BY item_number, item_description
LIMIT 20;
```

```sql
-- 5) Total 2022 sales dollars by item (un‑ranked)
SELECT
  item_number,
  item_description,
  SUM(sale_dollars) AS sales_2022
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2022
GROUP BY item_number, item_description
LIMIT 20;
```

```sql
-- 6) Combine 2022 and 2023 totals side‑by‑side for a few items
WITH yearly AS (
  SELECT
    item_number,
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars) AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_number, item_description, yr
)
SELECT
  item_number,
  item_description,
  SUM(CASE WHEN yr = 2022 THEN total_sales END) AS sales_2022,
  SUM(CASE WHEN yr = 2023 THEN total_sales END) AS sales_2023
FROM yearly
GROUP BY item_number, item_description
LIMIT 20;
```

```sql
-- 7) Add the year‑over‑year growth % for a handful of items
WITH yearly AS (
  SELECT
    item_number,
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars) AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_number, item_description, yr
),
pivot AS (
  SELECT
    item_number,
    item_description,
    SUM(CASE WHEN yr = 2022 THEN total_sales END) AS sales_2022,
    SUM(CASE WHEN yr = 2023 THEN total_sales END) AS sales_2023
  FROM yearly
  GROUP BY item_number, item_description
)
SELECT
  item_number,
  item_description,
  sales_2022,
  sales_2023,
  SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100 AS yoy_growth_pct
FROM pivot
LIMIT 20;
```

```sql
-- 8) Same as #7 but keep only items that actually grew
WITH yearly AS (
  SELECT
    item_number,
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars) AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_number, item_description, yr
),
pivot AS (
  SELECT
    item_number,
    item_description,
    SUM(CASE WHEN yr = 2022 THEN total_sales END) AS sales_2022,
    SUM(CASE WHEN yr = 2023 THEN total_sales END) AS sales_2023
  FROM yearly
  GROUP BY item_number, item_description
)
SELECT *
FROM (
  SELECT
    item_number,
    item_description,
    sales_2022,
    sales_2023,
    SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100 AS yoy_growth_pct
  FROM pivot
  WHERE sales_2022 > 0 AND sales_2023 > sales_2022
)
ORDER BY yoy_growth_pct DESC
LIMIT 20;
```

```sql
-- 9) Rank all items by YoY growth % for 2023 (dense_rank version)
WITH yearly AS (
  SELECT
    item_number,
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars) AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_number, item_description, yr
),
pivot AS (
  SELECT
    item_number,
    item_description,
    SUM(CASE WHEN yr = 2022 THEN total_sales END) AS sales_2022,
    SUM(CASE WHEN yr = 2023 THEN total_sales END) AS sales_2023
  FROM yearly
  GROUP BY item_number, item_description
),
growth AS (
  SELECT
    item_number,
    item_description,
    sales_2022,
    sales_2023,
    SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100 AS yoy_growth_pct
  FROM pivot
  WHERE sales_2022 > 0
)
SELECT
  DENSE_RANK() OVER (ORDER BY yoy_growth_pct DESC) AS rk,
  item_number,
  item_description,
  sales_2022,
  sales_2023,
  yoy_growth_pct
FROM growth
ORDER BY rk
LIMIT 20;
```

