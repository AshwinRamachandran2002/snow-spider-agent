2025-05-01 02:22:52 - Thread-817 (execute) - INFO - [Exploration]
Relevant columns and why  
`date`: used to extract calendar years (2022 vs 2023).  
`sale_dollars`: numeric field that holds the revenue we need to aggregate.  
`item_number`: stable key for each product (“item”).  
`item_description`: human‑readable name shown in the final list.  

Typical filter / join conditions  
• EXTRACT(YEAR FROM `date`) IN (2022, 2023) – keep the two comparison years.  
• `sale_dollars` IS NOT NULL AND `sale_dollars` <> 0 – ignore empty rows.  
• Aggregate with SUM … GROUP BY `item_number` (optionally `item_description`).  
• When computing growth, keep only items whose 2022 sales are positive to avoid divide‑by‑zero.  

────────────────────────────────────────
Ten exploratory → final SQLs
Each query is capped with LIMIT 20 so you can run them safely in the console.  
Replace nothing – all project / dataset / table names are already the real ones.

```sql
-- 1) Peek at 20 random rows
SELECT *
FROM `bigquery-public-data.iowa_liquor_sales.sales`
ORDER BY RAND()
LIMIT 20;
```

```sql
-- 2) Distinct years that exist in the table
SELECT DISTINCT EXTRACT(YEAR FROM `date`) AS sales_year
FROM `bigquery-public-data.iowa_liquor_sales.sales`
ORDER BY sales_year
LIMIT 20;
```

```sql
-- 3) Sample of distinct items
SELECT DISTINCT item_number, item_description
FROM `bigquery-public-data.iowa_liquor_sales.sales`
LIMIT 20;
```

```sql
-- 4) Total 2023 sales dollars by item (un‑ranked)
SELECT
  item_number,
  item_description,
  SUM(sale_dollars) AS sales_2023
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2023
GROUP BY item_number, item_description
LIMIT 20;
```

```sql
-- 5) Total 2022 sales dollars by item (un‑ranked)
SELECT
  item_number,
  item_description,
  SUM(sale_dollars) AS sales_2022
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2022
GROUP BY item_number, item_description
LIMIT 20;
```

```sql
-- 6) Combine 2022 and 2023 totals side‑by‑side for a few items
WITH yearly AS (
  SELECT
    item_number,
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars) AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_number, item_description, yr
)
SELECT
  item_number,
  item_description,
  SUM(CASE WHEN yr = 2022 THEN total_sales END) AS sales_2022,
  SUM(CASE WHEN yr = 2023 THEN total_sales END) AS sales_2023
FROM yearly
GROUP BY item_number, item_description
LIMIT 20;
```

```sql
-- 7) Add the year‑over‑year growth % for a handful of items
WITH yearly AS (
  SELECT
    item_number,
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars) AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_number, item_description, yr
),
pivot AS (
  SELECT
    item_number,
    item_description,
    SUM(CASE WHEN yr = 2022 THEN total_sales END) AS sales_2022,
    SUM(CASE WHEN yr = 2023 THEN total_sales END) AS sales_2023
  FROM yearly
  GROUP BY item_number, item_description
)
SELECT
  item_number,
  item_description,
  sales_2022,
  sales_2023,
  SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100 AS yoy_growth_pct
FROM pivot
LIMIT 20;
```

```sql
-- 8) Same as #7 but keep only items that actually grew
WITH yearly AS (
  SELECT
    item_number,
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars) AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_number, item_description, yr
),
pivot AS (
  SELECT
    item_number,
    item_description,
    SUM(CASE WHEN yr = 2022 THEN total_sales END) AS sales_2022,
    SUM(CASE WHEN yr = 2023 THEN total_sales END) AS sales_2023
  FROM yearly
  GROUP BY item_number, item_description
)
SELECT *
FROM (
  SELECT
    item_number,
    item_description,
    sales_2022,
    sales_2023,
    SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100 AS yoy_growth_pct
  FROM pivot
  WHERE sales_2022 > 0 AND sales_2023 > sales_2022
)
ORDER BY yoy_growth_pct DESC
LIMIT 20;
```

```sql
-- 9) Rank all items by YoY growth % for 2023 (dense_rank version)
WITH yearly AS (
  SELECT
    item_number,
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars) AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_number, item_description, yr
),
pivot AS (
  SELECT
    item_number,
    item_description,
    SUM(CASE WHEN yr = 2022 THEN total_sales END) AS sales_2022,
    SUM(CASE WHEN yr = 2023 THEN total_sales END) AS sales_2023
  FROM yearly
  GROUP BY item_number, item_description
),
growth AS (
  SELECT
    item_number,
    item_description,
    sales_2022,
    sales_2023,
    SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100 AS yoy_growth_pct
  FROM pivot
  WHERE sales_2022 > 0
)
SELECT
  DENSE_RANK() OVER (ORDER BY yoy_growth_pct DESC) AS rk,
  item_number,
  item_description,
  sales_2022,
  sales_2023,
  yoy_growth_pct
FROM growth
ORDER BY rk
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: top 5 items with highest YoY growth % in total sales revenue for 2023
WITH yearly AS (
  SELECT
    item_number,
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars) AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_number, item_description, yr
),
pivot AS (
  SELECT
    item_number,
    item_description,
    SUM(CASE WHEN yr = 2022 THEN total_sales END) AS sales_2022,
    SUM(CASE WHEN yr = 2023 THEN total_sales END) AS sales_2023
  FROM yearly
  GROUP BY item_number, item_description
),
growth AS (
  SELECT
    item_number,
    item_description,
    sales_2022,
    sales_2023,
    SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100 AS yoy_growth_pct
  FROM pivot
  WHERE sales_2022 > 0    -- avoid division by zero
        AND sales_2023 IS NOT NULL
)
SELECT
  item_number,
  item_description,
  ROUND(sales_2022, 2) AS sales_2022_dollars,
  ROUND(sales_2023, 2) AS sales_2023_dollars,
  ROUND(yoy_growth_pct, 2) AS yoy_growth_percent
FROM growth
ORDER BY yoy_growth_pct DESC
LIMIT 20;      -- top 5 rows will satisfy the requested list
```
