  item_name,
  ROUND(
    SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100, 2
  )                                 AS yoy_growth_percentage
FROM pivot
WHERE sales_2022 > 0
ORDER BY yoy_growth_percentage DESC, item_id
LIMIT 5;
