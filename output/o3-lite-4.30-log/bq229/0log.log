```sql
--Description:  Return two counts based on DISTINCT original URLs in the Open‑Images dataset.
--              • cat_url_cnt   – # of URLs whose image_id has at least one label row
--                                with label_name = '/m/01yrx' (the “Cat” class) and confidence = 1.
--              • other_url_cnt – # of URLs whose image_id never has that confident cat label.
--              -------------------------------------------------------------------------------
--              Thinking process encoded in the query:
--              1) Begin with open_images.images (every image_id + original_url).
--              2) LEFT JOIN to open_images.labels, so images without labels remain.
--              3) For each URL, convert joined label rows into a numeric flag:
--                   1 when (label_name = cat AND confidence = 1) else 0.
--                 MAX() of the flag per URL is 1 if ANY row is a confident cat → has_cat = TRUE.
--              4) Outer SELECT uses COUNTIF(has_cat) and COUNTIF(NOT has_cat)
--                 to deliver the requested two numbers.
SELECT
  COUNTIF(has_cat)         AS cat_url_cnt,
  COUNTIF(NOT has_cat)     AS other_url_cnt
FROM (
  SELECT
    i.original_url,
    MAX(CASE
          WHEN l.label_name = '/m/01yrx' AND l.confidence = 1 THEN 1
          ELSE 0
        END) = 1 AS has_cat
  FROM `bigquery-public-data.open_images.images`  AS i
  LEFT JOIN `bigquery-public-data.open_images.labels`  AS l
    ON i.image_id = l.image_id
  GROUP BY i.original_url
);
