Query:
--Description: 9) Join with SAMPLE_FILES to also output git id and file mode while classifying lines.
SELECT
    f."repo_name",
    f."path",
    f."mode",
    CASE
         WHEN REGEXP_LIKE(line.value::STRING, '[ \t]+$') THEN 'Trailing'
         WHEN REGEXP_LIKE(line.value::STRING, '^ ')      THEN 'Space'
         ELSE 'Other'
    END                       AS "line_type"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
      ON f."id" = c."id"
     AND f."repo_name" = c."sample_repo_name",
     LATERAL SPLIT_TO_TABLE(c."content", '\n') line
WHERE c."content" IS NOT NULL
LIMIT 20
