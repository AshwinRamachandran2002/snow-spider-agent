```sql
--Description:
-- Goal: report, for every repository present in SAMPLE_CONTENTS,
--        how many lines fall into each of the three categories:
--        1) “trailing” – lines ending with whitespace (RLIKE '\s+$')
--        2) “space”    – lines beginning with a space (RLIKE '^ +')
--        3) “other”    – all remaining lines.
-- Method:
--   • LATERAL FLATTEN is used to split the "content" text of every file
--     into individual lines (via SPLIT on '\n').
--   • A single pass over all lines applies two regex predicates and
--     tallies category counts using SUM + CASE expressions.
--   • GROUP BY "sample_repo_name" aggregates results per repository.
SELECT
  c."sample_repo_name",
  COUNT(*)                                                                                         AS "total_lines",
  SUM(CASE WHEN f.value::STRING RLIKE '\\s+$' THEN 1 ELSE 0 END)                                   AS "trailing_lines",
  SUM(CASE WHEN f.value::STRING RLIKE '^ +'   THEN 1 ELSE 0 END)                                   AS "space_lines",
  SUM(CASE WHEN NOT (f.value::STRING RLIKE '\\s+$' OR f.value::STRING RLIKE '^ +') THEN 1 ELSE 0 END)
                                                                                                   AS "other_lines"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS c,
     LATERAL FLATTEN(input => SPLIT(c."content", '\n')) f
GROUP BY c."sample_repo_name";
```
