--Description: 9) Count of fast uninstalls (≤ 7 days) vs. those that also had a crash.
--              Scan 01‑Sep‑2018 … 07‑Oct‑2018 (sept + 7‑day buffer).
WITH events AS (
  SELECT
    user_pseudo_id,
    event_name,
    event_timestamp
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'
),
first_open AS (
  SELECT
    user_pseudo_id,
    DATE(TIMESTAMP_MICROS(event_timestamp)) AS open_date
  FROM events
  WHERE event_name = 'first_open'
    AND DATE(TIMESTAMP_MICROS(event_timestamp))
        BETWEEN DATE '2018-09-01' AND DATE '2018-09-30'
),
removes AS (
  SELECT
    user_pseudo_id,
    DATE(TIMESTAMP_MICROS(event_timestamp)) AS remove_date
  FROM events
  WHERE event_name = 'app_remove'
),
fast_uninstalls AS (
  SELECT DISTINCT o.user_pseudo_id
  FROM first_open o
  JOIN removes r USING (user_pseudo_id)
  WHERE DATE_DIFF(r.remove_date, o.open_date, DAY) BETWEEN 0 AND 7
),
crashes AS (
  SELECT DISTINCT user_pseudo_id
  FROM events
  WHERE event_name = 'app_exception'
)
SELECT
  COUNT(*)                AS total_fast_uninstalls,
  COUNT(c.user_pseudo_id) AS fast_uninstalls_with_crash
FROM fast_uninstalls f
LEFT JOIN crashes c USING (user_pseudo_id)
LIMIT 20
