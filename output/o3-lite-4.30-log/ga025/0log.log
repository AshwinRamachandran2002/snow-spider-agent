```sql
--Description: 8) For fast‑uninstall users (sample days), indicate if they also had a crash.
--              Select only essential columns and avoid * to keep schemas consistent.
WITH sept_plus_oct AS (
  SELECT
    user_pseudo_id,
    event_name,
    DATE(TIMESTAMP_MICROS(event_timestamp)) AS evt_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX IN ('20180901','20180902','20180903','20181001')
),
first_open AS (
  SELECT
    user_pseudo_id,
    evt_date AS open_date
  FROM sept_plus_oct
  WHERE event_name = 'first_open'
    AND evt_date BETWEEN DATE '2018-09-01' AND DATE '2018-09-30'
),
removes AS (
  SELECT
    user_pseudo_id,
    evt_date AS remove_date
  FROM sept_plus_oct
  WHERE event_name = 'app_remove'
),
crashes AS (
  SELECT DISTINCT user_pseudo_id
  FROM sept_plus_oct
  WHERE event_name = 'app_exception'
)
SELECT DISTINCT
  o.user_pseudo_id,
  o.open_date,
  r.remove_date,
  DATE_DIFF(r.remove_date, o.open_date, DAY) AS days_to_uninstall,
  IF(c.user_pseudo_id IS NOT NULL, 1, 0)     AS had_crash
FROM first_open o
JOIN removes  r USING (user_pseudo_id)
LEFT JOIN crashes c USING (user_pseudo_id)
WHERE DATE_DIFF(r.remove_date, o.open_date, DAY) BETWEEN 0 AND 7
LIMIT 20;
```

```sql
--Description: 9) Count fast uninstalls (≤ 7 days) versus those that also had a crash.
--              Use one wildcard scan (2018‑09‑01 … 2018‑10‑03) and select only
--              user_pseudo_id, event_name, event_timestamp.
WITH unioned AS (
  SELECT
    user_pseudo_id,
    event_name,
    event_timestamp
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181003'
),
first_open AS (
  SELECT
    user_pseudo_id,
    DATE(TIMESTAMP_MICROS(event_timestamp)) AS open_date
  FROM unioned
  WHERE event_name = 'first_open'
    AND DATE(TIMESTAMP_MICROS(event_timestamp))
        BETWEEN DATE '2018-09-01' AND DATE '2018-09-30'
),
removes AS (
  SELECT
    user_pseudo_id,
    DATE(TIMESTAMP_MICROS(event_timestamp)) AS remove_date
  FROM unioned
  WHERE event_name = 'app_remove'
),
fast_uninstalls AS (
  SELECT DISTINCT o.user_pseudo_id
  FROM first_open o
  JOIN removes r USING (user_pseudo_id)
  WHERE DATE_DIFF(r.remove_date, o.open_date, DAY) BETWEEN 0 AND 7
),
crashes AS (
  SELECT DISTINCT user_pseudo_id
  FROM unioned
  WHERE event_name = 'app_exception'
)
SELECT
  COUNT(*)                AS total_fast_uninstalls,
  COUNT(c.user_pseudo_id) AS fast_uninstalls_with_crash
FROM fast_uninstalls f
LEFT JOIN crashes c USING (user_pseudo_id)
LIMIT 20;
```

