```sql
--Description: 7) Sample September users who uninstalled within 7 days of their first‑open.
--              Scan three September days with a wildcard and pick only needed columns.
WITH sept_events AS (
  SELECT
    user_pseudo_id,
    event_name,
    DATE(TIMESTAMP_MICROS(event_timestamp)) AS evt_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180903'
),
first_open AS (
  SELECT
    user_pseudo_id,
    evt_date AS open_date
  FROM sept_events
  WHERE event_name = 'first_open'
),
removes AS (
  SELECT
    user_pseudo_id,
    evt_date AS remove_date
  FROM sept_events
  WHERE event_name = 'app_remove'
)
SELECT DISTINCT
  o.user_pseudo_id,
  open_date,
  remove_date,
  DATE_DIFF(remove_date, open_date, DAY) AS days_to_uninstall
FROM first_open o
JOIN removes r USING (user_pseudo_id)
WHERE DATE_DIFF(remove_date, open_date, DAY) BETWEEN 0 AND 7
LIMIT 20;
