--Description: 7) Sample of September‑2018 users whose first_open and app_remove are ≤ 7 days apart.
--              Widen the scan window to 01‑Sep‑2018 … 15‑Sep‑2018 to improve hit‑rate.
WITH events AS (
  SELECT
    user_pseudo_id,
    event_name,
    DATE(PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS evt_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180915'
),
first_open AS (
  SELECT
    user_pseudo_id,
    MIN(evt_date) AS open_date
  FROM events
  WHERE event_name = 'first_open'
    AND evt_date BETWEEN DATE '2018-09-01' AND DATE '2018-09-30'
  GROUP BY user_pseudo_id
),
removes AS (
  SELECT
    user_pseudo_id,
    evt_date AS remove_date
  FROM events
  WHERE event_name = 'app_remove'
)
SELECT DISTINCT
  o.user_pseudo_id,
  o.open_date,
  r.remove_date,
  DATE_DIFF(r.remove_date, o.open_date, DAY) AS days_to_uninstall
FROM first_open o
JOIN removes r USING (user_pseudo_id)
WHERE DATE_DIFF(r.remove_date, o.open_date, DAY) BETWEEN 0 AND 7
LIMIT 20
