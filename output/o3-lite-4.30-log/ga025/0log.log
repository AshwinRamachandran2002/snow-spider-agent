```sql
--Description ─ Thinking process embedded step‑by‑step
-- Goal: % of Sept‑2018 first‑time users who un‑installed ≤ 7 days later and experienced ≥1 crash.
-- 1️⃣  Scan GA4 export tables with wildcard (`events_*`) for 2018‑09‑01 … 2018‑10‑07
--     (Sept plus 7‑day buffer).  _TABLE_SUFFIX holds the YYYYMMDD part.
-- 2️⃣  FIRST_OPEN CTE:   for each user, earliest date in Sept‑2018 where event_name = 'first_open'.
-- 3️⃣  APP_REMOVE CTE:   for each user, earliest uninstall date (event_name = 'app_remove').
-- 4️⃣  FAST_UNINSTALL:   keep users whose uninstall date is 0–7 days after their first_open.
-- 5️⃣  CRASH_USERS:      users with at least one `app_exception` during the scan window.
-- 6️⃣  Final SELECT:     denominator = FAST_UNINSTALL count,
--                        numerator   = FAST_UNINSTALL ∩ CRASH_USERS,
--                        percentage  = numerator / denominator * 100.
WITH events AS (
  SELECT
    user_pseudo_id,
    event_name,
    DATE(PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)) AS event_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181007'   -- Sept plus 7‑day horizon
),
first_open AS (          -- 2️⃣
  SELECT
    user_pseudo_id,
    MIN(event_date) AS open_date
  FROM events
  WHERE event_name = 'first_open'
    AND event_date BETWEEN DATE '2018-09-01' AND DATE '2018-09-30'
  GROUP BY user_pseudo_id
),
app_remove AS (          -- 3️⃣
  SELECT
    user_pseudo_id,
    MIN(event_date) AS remove_date
  FROM events
  WHERE event_name = 'app_remove'
  GROUP BY user_pseudo_id
),
fast_uninstall AS (      -- 4️⃣
  SELECT
    f.user_pseudo_id,
    f.open_date,
    r.remove_date
  FROM first_open f
  JOIN app_remove r USING (user_pseudo_id)
  WHERE DATE_DIFF(r.remove_date, f.open_date, DAY) BETWEEN 0 AND 7
),
crash_users AS (         -- 5️⃣
  SELECT DISTINCT user_pseudo_id
  FROM events
  WHERE event_name = 'app_exception'
)
-- 6️⃣  Final answer
SELECT
  COUNT(*)                                   AS total_fast_uninstalls,
  COUNT(c.user_pseudo_id)                    AS fast_uninstalls_with_crash,
  ROUND(SAFE_DIVIDE(COUNT(c.user_pseudo_id),
                    COUNT(*)) * 100, 2)      AS pct_with_crash
FROM fast_uninstall u
LEFT JOIN crash_users c USING (user_pseudo_id);
```
