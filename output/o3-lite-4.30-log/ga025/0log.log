--Description: 6) Match a user’s 1‑Sep‑2018 first‑open with an uninstall that occurred
--              within the next seven days.  Use one wildcard scan, restrict to
--              the two days we need, and select only minimal columns to avoid
--              STRUCT‑mismatch errors.
WITH sept_events AS (
  SELECT
    user_pseudo_id,
    event_name,
    DATE(TIMESTAMP_MICROS(event_timestamp)) AS evt_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX IN ('20180901','20180908')          -- only 1‑Sep & 8‑Sep
),
first_open AS (
  SELECT
    user_pseudo_id,
    evt_date AS open_date
  FROM sept_events
  WHERE event_name = 'first_open'
    AND evt_date = DATE '2018-09-01'
),
removes AS (
  SELECT
    user_pseudo_id,
    evt_date AS remove_date
  FROM sept_events
  WHERE event_name = 'app_remove'
    AND evt_date = DATE '2018-09-08'
)
SELECT *
FROM first_open o
JOIN removes r ON o.user_pseudo_id = r.user_pseudo_id
WHERE DATE_DIFF(r.remove_date, o.open_date, DAY) BETWEEN 0 AND 7
LIMIT 20;
