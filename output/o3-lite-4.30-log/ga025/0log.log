```sql
--Description: 6) Match a user’s “first_open” on 1‑Sep‑18 with an “app_remove” that happened
--within 7 calendar days (still looking only at tables 1‑Sep to 8‑Sep for brevity).
WITH first_open AS (
  SELECT user_pseudo_id,
         DATE(TIMESTAMP_MICROS(event_timestamp)) AS open_date,
         TIMESTAMP_MICROS(event_timestamp)        AS open_ts
  FROM   `firebase-public-project.analytics_153293282.events_20180901`
  WHERE  event_name = 'first_open'
),
removes AS (
  SELECT user_pseudo_id,
         DATE(TIMESTAMP_MICROS(event_timestamp)) AS remove_date,
         TIMESTAMP_MICROS(event_timestamp)       AS remove_ts
  FROM   `firebase-public-project.analytics_153293282.events_20180908`
  WHERE  event_name = 'app_remove'
)
SELECT *
FROM   first_open o
JOIN   removes r
  ON   o.user_pseudo_id = r.user_pseudo_id
WHERE  r.remove_date <= o.open_date + 7
LIMIT 20;
```

```sql
--Description: 7) Turn the join above into a list of *all* Sept‑2018 users who uninstalled ≤7 days.
WITH sept_events AS (
  -- union only Sept tables to keep the sample small for this demo
  SELECT * FROM `firebase-public-project.analytics_153293282.events_20180901` UNION ALL
  SELECT * FROM `firebase-public-project.analytics_153293282.events_20180902` UNION ALL
  SELECT * FROM `firebase-public-project.analytics_153293282.events_20180903`
),
first_open AS (
  SELECT user_pseudo_id,
         DATE(TIMESTAMP_MICROS(event_timestamp)) AS open_date
  FROM   sept_events
  WHERE  event_name = 'first_open'
),
removes AS (
  SELECT user_pseudo_id,
         DATE(TIMESTAMP_MICROS(event_timestamp)) AS remove_date
  FROM   sept_events
  WHERE  event_name = 'app_remove'
)
SELECT DISTINCT r.user_pseudo_id,
       open_date,
       remove_date,
       DATE_DIFF(remove_date, open_date, DAY) AS days_to_uninstall
FROM first_open o
JOIN removes  r
  USING (user_pseudo_id)
WHERE DATE_DIFF(remove_date, open_date, DAY) BETWEEN 0 AND 7
LIMIT 20;
```

```sql
--Description: 8) See whether those fast‑uninstall users also threw a crash before uninstall.
WITH sept_plus_oct AS (
  -- include 1‑Sep‑18 through 3‑Oct‑18 (last required date for the +7 day window)
  SELECT * FROM `firebase-public-project.analytics_153293282.events_20180901` UNION ALL
  SELECT * FROM `firebase-public-project.analytics_153293282.events_20180902` UNION ALL
  SELECT * FROM `firebase-public-project.analytics_153293282.events_20180903` UNION ALL
  SELECT * FROM `firebase-public-project.analytics_153293282.events_20181001`
),
first_open AS (
  SELECT user_pseudo_id,
         DATE(TIMESTAMP_MICROS(event_timestamp)) AS open_date,
         TIMESTAMP_MICROS(event_timestamp)       AS open_ts
  FROM   sept_plus_oct
  WHERE  event_name = 'first_open'
    AND  DATE(TIMESTAMP_MICROS(event_timestamp)) 
         BETWEEN DATE '2018-09-01' AND DATE '2018-09-30'
),
removes AS (
  SELECT user_pseudo_id,
         DATE(TIMESTAMP_MICROS(event_timestamp)) AS remove_date
  FROM   sept_plus_oct
  WHERE  event_name = 'app_remove'
),
crashes AS (
  SELECT DISTINCT user_pseudo_id
  FROM   sept_plus_oct
  WHERE  event_name = 'app_exception'
)
SELECT DISTINCT o.user_pseudo_id,
       o.open_date,
       r.remove_date,
       DATE_DIFF(r.remove_date, o.open_date, DAY) AS days_to_uninstall,
       IF(c.user_pseudo_id IS NOT NULL, 1, 0)     AS had_crash
FROM first_open o
JOIN removes  r USING (user_pseudo_id)
LEFT JOIN crashes c USING (user_pseudo_id)
WHERE DATE_DIFF(r.remove_date, o.open_date, DAY) BETWEEN 0 AND 7
LIMIT 20;
