Ten step‑by‑step exploration queries (LIMIT 20 each)
────────────────────────────────────────────────────────────────────

```sql
-- 1. Distinct event names seen in September 2018
SELECT DISTINCT event_name
FROM  `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
LIMIT 20;
```

```sql
-- 2. How many first‑open events per day in September 2018?
SELECT PARSE_DATE('%Y%m%d', event_date) AS open_date,
       COUNT(DISTINCT user_pseudo_id)   AS first_open_users
FROM   `firebase-public-project.analytics_153293282.events_*`
WHERE  _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
  AND  event_name = 'first_open'
GROUP  BY open_date
ORDER  BY open_date
LIMIT 20;
```

```sql
-- 3. Sample of users who first opened in September 2018
SELECT DISTINCT user_pseudo_id,
       event_date AS first_open_date
FROM   `firebase-public-project.analytics_153293282.events_*`
WHERE  _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
  AND  event_name = 'first_open'
LIMIT 20;
```

```sql
-- 4. Sample uninstall (app_remove) events for those September first‑open users
SELECT r.user_pseudo_id,
       r.event_date      AS uninstall_date,
       f.event_date      AS first_open_date
FROM   `firebase-public-project.analytics_153293282.events_*`  r
JOIN   (SELECT DISTINCT user_pseudo_id, event_date
        FROM `firebase-public-project.analytics_153293282.events_*`
        WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
          AND event_name = 'first_open') AS f
ON     r.user_pseudo_id = f.user_pseudo_id
WHERE  r.event_name = 'app_remove'
LIMIT 20;
```

```sql
-- 5. Add the day‑difference between uninstall and first open
SELECT  r.user_pseudo_id,
        PARSE_DATE('%Y%m%d', f.event_date) AS first_open_dt,
        PARSE_DATE('%Y%m%d', r.event_date) AS uninstall_dt,
        DATE_DIFF(PARSE_DATE('%Y%m%d', r.event_date),
                  PARSE_DATE('%Y%m%d', f.event_date), DAY) AS days_to_uninstall
FROM    `firebase-public-project.analytics_153293282.events_*`  r
JOIN    (SELECT user_pseudo_id, event_date
         FROM `firebase-public-project.analytics_153293282.events_*`
         WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
           AND event_name = 'first_open') AS f
ON      r.user_pseudo_id = f.user_pseudo_id
WHERE   r.event_name = 'app_remove'
LIMIT 20;
```

```sql
-- 6. Keep only uninstalls occurring within 7 days of first open
SELECT *
FROM  (
  SELECT r.user_pseudo_id,
         DATE_DIFF(PARSE_DATE('%Y%m%d', r.event_date),
                   PARSE_DATE('%Y%m%d', f.event_date), DAY) AS days_to_uninstall
  FROM   `firebase-public-project.analytics_153293282.events_*` r
  JOIN   (SELECT user_pseudo_id, event_date
          FROM `firebase-public-project.analytics_153293282.events_*`
          WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
            AND event_name = 'first_open') f
  ON     r.user_pseudo_id = f.user_pseudo_id
  WHERE  r.event_name = 'app_remove'
)
WHERE  days_to_uninstall BETWEEN 0 AND 7
LIMIT 20;
```

```sql
-- 7. Did those ≤7‑day uninstall users also experience an app crash?
SELECT DISTINCT e.user_pseudo_id
FROM   (
  SELECT user_pseudo_id
  FROM   `firebase-public-project.analytics_153293282.events_*` r
  JOIN   (SELECT user_pseudo_id, event_date
          FROM `firebase-public-project.analytics_153293282.events_*`
          WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
            AND event_name = 'first_open') f
  ON     r.user_pseudo_id = f.user_pseudo_id
  WHERE  r.event_name = 'app_remove'
    AND  DATE_DIFF(PARSE_DATE('%Y%m%d', r.event_date),
                   PARSE_DATE('%Y%m%d', f.event_date), DAY) BETWEEN 0 AND 7
) AS u
JOIN `firebase-public-project.analytics_153293282.events_*` e
ON   e.user_pseudo_id = u.user_pseudo_id
WHERE e.event_name = 'app_exception'
LIMIT 20;
```

```sql
-- 8. Count of users who uninstalled within 7 days (denominator)
SELECT COUNT(DISTINCT u.user_pseudo_id) AS uninstall_within_7d
FROM (
  SELECT r.user_pseudo_id
  FROM   `firebase-public-project.analytics_153293282.events_*` r
  JOIN   (SELECT user_pseudo_id, event_date
          FROM `firebase-public-project.analytics_153293282.events_*`
          WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
            AND event_name = 'first_open') f
  ON     r.user_pseudo_id = f.user_pseudo_id
  WHERE  r.event_name = 'app_remove'
    AND  DATE_DIFF(PARSE_DATE('%Y%m%d', r.event_date),
                   PARSE_DATE('%Y%m%d', f.event_date), DAY) BETWEEN 0 AND 7
) u
LIMIT 20;
```

```sql
-- 9. Count of those uninstall‑within‑7d users who ALSO had an app_exception (numerator)
WITH uninstall_7d AS (
  SELECT r.user_pseudo_id
  FROM   `firebase-public-project.analytics_153293282.events_*` r
  JOIN   (SELECT user_pseudo_id, event_date
          FROM `firebase-public-project.analytics_153293282.events_*`
          WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
            AND event_name = 'first_open') f
  ON     r.user_pseudo_id = f.user_pseudo_id
  WHERE  r.event_name = 'app_remove'
    AND  DATE_DIFF(PARSE_DATE('%Y%m%d', r.event_date),
                   PARSE_DATE('%Y%m%d', f.event_date), DAY) BETWEEN 0 AND 7
)
SELECT COUNT(DISTINCT e.user_pseudo_id) AS uninstall_7d_with_crash
FROM   uninstall_7d  u
JOIN   `firebase-public-project.analytics_153293282.events_*` e
ON     e.user_pseudo_id = u.user_pseudo_id
WHERE  e.event_name = 'app_exception'
LIMIT 20;
```

```sql
-- 10. Final percentage of Sept‑2018 first‑open users who uninstalled within 7 days
--     AND experienced at least one app_exception before uninstall
WITH first_open AS (
  SELECT user_pseudo_id,
         PARSE_DATE('%Y%m%d', event_date) AS first_open_dt
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
    AND  event_name = 'first_open'
),
uninstall_7d AS (
  SELECT r.user_pseudo_id,
         PARSE_DATE('%Y%m%d', r.event_date) AS uninstall_dt
  FROM   `firebase-public-project.analytics_153293282.events_*` r
  JOIN   first_open f
  ON     r.user_pseudo_id = f.user_pseudo_id
  WHERE  r.event_name = 'app_remove'
    AND  DATE_DIFF(PARSE_DATE('%Y%m%d', r.event_date), f.first_open_dt, DAY) BETWEEN 0 AND 7
),
uninstall_7d_with_crash AS (
  SELECT DISTINCT u.user_pseudo_id
  FROM   uninstall_7d u
  JOIN   `firebase-public-project.analytics_153293282.events_*` e
  ON     e.user_pseudo_id = u.user_pseudo_id
  WHERE  e.event_name = 'app_exception'
    -- keep only crashes that happened before uninstall date
    AND  PARSE_DATE('%Y%m%d', e.event_date) <= u.uninstall_dt
)
SELECT
  (SELECT COUNT(*) FROM uninstall_7d_with_crash) * 100.0
  / NULLIF((SELECT COUNT(*) FROM uninstall_7d),0) AS pct_uninstallers_with_crash
LIMIT 20;
```

Each successive query builds knowledge of the data set, culminating in query 10, which returns the requested percentage.
