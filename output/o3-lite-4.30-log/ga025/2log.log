WITH events AS (
  -- bring in only the days we need: Sept‑2018 plus the first 3 days of Oct‑2018
  SELECT
    user_pseudo_id,
    event_name,
    PARSE_DATE('%Y%m%d', event_date) AS event_dt
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20181003'
),
first_open AS (
  -- users whose first _open happened during September 2018
  SELECT
    user_pseudo_id,
    MIN(event_dt) AS first_open_dt
  FROM events
  WHERE event_name = 'first_open'
    AND event_dt BETWEEN DATE '2018-09-01' AND DATE '2018-09-30'
  GROUP BY user_pseudo_id
),
uninstall_7d AS (
  -- those users who uninstalled within 7 days of their Sept first _open
  SELECT
    e.user_pseudo_id,
    MIN(e.event_dt) AS uninstall_dt              -- earliest uninstall date
  FROM events e
  JOIN first_open f
    ON e.user_pseudo_id = f.user_pseudo_id
  WHERE e.event_name = 'app_remove'
    AND e.event_dt BETWEEN f.first_open_dt
                        AND DATE_ADD(f.first_open_dt, INTERVAL 7 DAY)
  GROUP BY e.user_pseudo_id
),
crashed_users AS (
  -- among the ≤7‑day uninstallers, who had at least one crash on/before uninstall?
  SELECT DISTINCT
         u.user_pseudo_id
  FROM   uninstall_7d u
  JOIN   events e
    ON   e.user_pseudo_id = u.user_pseudo_id
  WHERE  e.event_name = 'app_exception'
    AND  e.event_dt <= u.uninstall_dt
)
SELECT
  ROUND(
        100 * COUNT(DISTINCT crashed_users.user_pseudo_id)
        / NULLIF(COUNT(DISTINCT uninstall_7d.user_pseudo_id), 0)
       , 4) AS crash_percentage_within_7d
FROM uninstall_7d
LEFT JOIN crashed_users
  ON uninstall_7d.user_pseudo_id = crashed_users.user_pseudo_id;
