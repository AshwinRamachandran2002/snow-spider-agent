```sql
--Description: We want the percentage of users whose very first app open occurred in September 2018,
--             who uninstalled (app_remove) within 7 days of that first open, and who experienced at
--             least one crash (app_exception) on or before the uninstall date.
--
-- STEP 1  (first_open): capture each user’s 1st‑open event in Sept‑2018 and turn the yyyymmdd string
--         into a DATE so that we can perform date arithmetic later.
--
-- STEP 2  (uninstall_7d): join those users to any subsequent uninstall event (app_remove) and keep
--         only the rows whose uninstall date is from 0 to 7 days after first_open.
--
-- STEP 3  (crashes): for every such uninstalling user, look for at least one crash
--         (app_exception) that happened on or before the uninstall date.  The DISTINCT keeps the
--         list unique.
--
-- STEP 4  (final SELECT): divide the count of uninstallers‑with‑crash by the total uninstallers‑in‑7d
--         and multiply by 100 to get the desired percentage.  NULLIF prevents division by zero.
WITH first_open AS (
  SELECT
      user_pseudo_id,
      PARSE_DATE('%Y%m%d', event_date) AS first_open_dt
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
    AND  event_name = 'first_open'
),
uninstall_7d AS (
  SELECT
      r.user_pseudo_id,
      PARSE_DATE('%Y%m%d', r.event_date) AS uninstall_dt
  FROM  `firebase-public-project.analytics_153293282.events_*` r
  JOIN  first_open f
    ON r.user_pseudo_id = f.user_pseudo_id
  WHERE r.event_name = 'app_remove'
    AND DATE_DIFF(PARSE_DATE('%Y%m%d', r.event_date), f.first_open_dt, DAY) BETWEEN 0 AND 7
),
crashes AS (
  SELECT DISTINCT
         u.user_pseudo_id
  FROM   uninstall_7d u
  JOIN   `firebase-public-project.analytics_153293282.events_*` e
    ON   e.user_pseudo_id = u.user_pseudo_id
  WHERE  e.event_name = 'app_exception'
    AND  PARSE_DATE('%Y%m%d', e.event_date) <= u.uninstall_dt
)
SELECT
  100.0 * COUNT(DISTINCT crashes.user_pseudo_id)
        / NULLIF(COUNT(DISTINCT uninstall_7d.user_pseudo_id), 0)  AS pct_uninstallers_with_crash
FROM uninstall_7d
LEFT JOIN crashes
  ON uninstall_7d.user_pseudo_id = crashes.user_pseudo_id;
```
