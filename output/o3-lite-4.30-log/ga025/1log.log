```

```sql
--8. Description: users that un‑installed within 7 days of their first open (September cohort, raw ids).
WITH first_open AS (
  SELECT user_pseudo_id,
         MIN(DATE(PARSE_DATE('%Y%m%d',event_date))) AS fo_date
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
    AND  event_name = 'first_open'
  GROUP BY user_pseudo_id
), uninstall AS (
  SELECT user_pseudo_id,
         MIN(DATE(PARSE_DATE('%Y%m%d',event_date))) AS uninstall_date
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  event_name = 'app_remove'
  GROUP BY user_pseudo_id
)
SELECT  f.user_pseudo_id,
        f.fo_date,
        u.uninstall_date,
        DATE_DIFF(u.uninstall_date,f.fo_date,DAY) AS days_to_uninstall
FROM    first_open f
JOIN    uninstall  u USING (user_pseudo_id)
WHERE   DATE_DIFF(u.uninstall_date,f.fo_date,DAY) BETWEEN 0 AND 7
LIMIT   20;
```

```sql
--9. Description: users from (8) that also encountered at least one crash in the 7‑day window.
WITH first_open AS (
  SELECT user_pseudo_id,
         MIN(DATE(PARSE_DATE('%Y%m%d',event_date))) AS fo_date
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
    AND  event_name = 'first_open'
  GROUP BY user_pseudo_id
), uninstall AS (
  SELECT user_pseudo_id,
         MIN(DATE(PARSE_DATE('%Y%m%d',event_date))) AS uninstall_date
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  event_name = 'app_remove'
  GROUP BY user_pseudo_id
), crashes AS (
  SELECT DISTINCT user_pseudo_id,
         DATE(PARSE_DATE('%Y%m%d',event_date)) AS crash_date
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  event_name = 'app_exception'
)
SELECT  fu.user_pseudo_id,
        fu.fo_date,
        fu.uninstall_date,
        MIN(c.crash_date) AS first_crash_date
FROM   (
        SELECT  f.user_pseudo_id, f.fo_date, u.uninstall_date
        FROM    first_open f
        JOIN    uninstall u USING (user_pseudo_id)
        WHERE   DATE_DIFF(u.uninstall_date,f.fo_date,DAY) BETWEEN 0 AND 7
       ) AS fu
JOIN   crashes c
  ON   c.user_pseudo_id = fu.user_pseudo_id
  AND  c.crash_date BETWEEN fu.fo_date AND fu.uninstall_date
GROUP BY fu.user_pseudo_id, fu.fo_date, fu.uninstall_date
LIMIT 20;
```

```sql
--10. Description: final percentage – share of Sept‑2018 first_open users who un‑installed within 7 days AND experienced a crash in those 7 days.
WITH first_open AS (
  SELECT user_pseudo_id,
         MIN(DATE(PARSE_DATE('%Y%m%d',event_date))) AS fo_date
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
    AND  event_name = 'first_open'
  GROUP BY user_pseudo_id
), uninstall AS (
  SELECT user_pseudo_id,
         MIN(DATE(PARSE_DATE('%Y%m%d',event_date))) AS uninstall_date
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  event_name = 'app_remove'
  GROUP BY user_pseudo_id
), cohort AS (
  SELECT  f.user_pseudo_id , f.fo_date , u.uninstall_date
  FROM    first_open f
  JOIN    uninstall  u USING (user_pseudo_id)
  WHERE   DATE_DIFF(u.uninstall_date,f.fo_date,DAY) BETWEEN 0 AND 7
), crashes AS (
  SELECT DISTINCT user_pseudo_id,
         DATE(PARSE_DATE('%Y%m%d',event_date)) AS crash_date
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  event_name = 'app_exception'
)
SELECT
  COUNT(DISTINCT c.user_pseudo_id)    AS users_uninstall_7d_with_crash ,
  COUNT(DISTINCT cohort.user_pseudo_id) AS users_uninstall_7d ,
  ROUND( 100 * COUNT(DISTINCT c.user_pseudo_id) /
               COUNT(DISTINCT cohort.user_pseudo_id) , 2)  AS pct_with_crash
FROM  cohort
LEFT JOIN crashes c
  ON  c.user_pseudo_id = cohort.user_pseudo_id
  AND c.crash_date BETWEEN cohort.fo_date AND cohort.uninstall_date
LIMIT 20;
```

