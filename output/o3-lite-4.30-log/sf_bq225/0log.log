The table structure information is ({database name: {schema name: [table name]}}): 
{'GITHUB_REPOS': {'GITHUB_REPOS': ['SAMPLE_FILES', 'LANGUAGES', 'LICENSES', 'SAMPLE_COMMITS', 'SAMPLE_CONTENTS', 'SAMPLE_REPOS']}}
Begin Exploring Related Columns
Relevant columns & their potential usage  
• SAMPLE_FILES."path" – contains the file name & extension, needed to detect the programming language.  
• SAMPLE_FILES."id" – blob‑hash that lets us join to SAMPLE_CONTENTS."id".  
• SAMPLE_CONTENTS."id" – join key coming from SAMPLE_FILES."id".  
• SAMPLE_CONTENTS."content" – must be non‑NULL / non‑empty to make sure the file really has content.  
• (optionally) SAMPLE_CONTENTS."binary" – can be inspected to exclude binaries, though the task only asks for non‑empty content.  

Below are ten different Snowflake SQL queries – from very small “exploratory” snippets up to one that will return the 10 most‑frequent languages.  
Make sure the database / schema / table names are exactly as shown, and every identifier is wrapped with double quotes.

```sql
-- 1) Description: Peek at a few file paths and their ids.
SELECT 
  "path",
  "id",
  "repo_name"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
LIMIT 20;
```

```sql
-- 2) Description: Display unique file‑extensions that occur in SAMPLE_FILES.
SELECT DISTINCT 
  LOWER(SPLIT_PART("path", '.', -1))          AS "file_ext"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.%'                      -- guarantees an extension exists
LIMIT 20;
```

```sql
-- 3) Description: Check contents associated with a few ids and see if they are empty.
SELECT 
  "id",
  "size",
  "binary",
  CASE WHEN "content" IS NULL OR "content" = '' THEN 'EMPTY' ELSE 'HAS_CONTENT' END AS "content_flag"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
LIMIT 20;
```

```sql
-- 4) Description: Sample join between FILES and CONTENTS using the shared "id".
SELECT 
  f."path",
  c."size",
  LEFT(c."content", 100)        AS "content_snippet"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
  ON f."id" = c."id"
LIMIT 20;
```

```sql
-- 5) Description: Bring out path, extension and content-length just for non‑empty contents.
SELECT
  f."path",
  LOWER(SPLIT_PART(f."path", '.', -1))                AS "file_ext",
  LENGTH(c."content")                                  AS "content_len"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
  ON f."id" = c."id"
WHERE c."content" IS NOT NULL AND c."content" <> ''
LIMIT 20;
```

```sql
-- 6) Description: Count files per extension (non‑empty content only).
SELECT
  LOWER(SPLIT_PART(f."path", '.', -1))  AS "file_ext",
  COUNT(*)                              AS "file_cnt"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
  ON f."id" = c."id"
WHERE c."content" IS NOT NULL AND c."content" <> ''
GROUP BY 1
ORDER BY "file_cnt" DESC
LIMIT 20;
```

```sql
-- 7) Description: Map extensions to programming languages with a CASE expression.
SELECT
  CASE 
    WHEN LOWER(f."path") ILIKE '%.asm'  OR LOWER(f."path") ILIKE '%.nasm'  THEN 'Assembly'
    WHEN LOWER(f."path") ILIKE '%.c'    THEN 'C'
    WHEN LOWER(f."path") ILIKE '%.h'    THEN 'C'
    WHEN LOWER(f."path") ILIKE '%.cpp'  OR LOWER(f."path") ILIKE '%.c++' OR LOWER(f."path") ILIKE '%.hpp' OR LOWER(f."path") ILIKE '%.h++' THEN 'C++'
    WHEN LOWER(f."path") ILIKE '%.cs'   THEN 'C#'
    WHEN LOWER(f."path") ILIKE '%.go'   THEN 'Go'
    WHEN LOWER(f."path") ILIKE '%.java' THEN 'Java'
    WHEN LOWER(f."path") ILIKE '%.js'   OR LOWER(f."path") ILIKE '%.cjs'  THEN 'JavaScript'
    WHEN LOWER(f."path") ILIKE '%.py'   THEN 'Python'
    WHEN LOWER(f."path") ILIKE '%.rb'   THEN 'Ruby'
    -- add more WHEN clauses as required …
    ELSE NULL
  END AS "language",
  f."path"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
  ON f."id" = c."id"
WHERE c."content" IS NOT NULL AND c."content" <> ''
LIMIT 20;
```

```sql
-- 8) Description: Aggregate the map from query 7 and get counts (still non‑empty content only).
SELECT
  CASE 
    WHEN LOWER(f."path") ILIKE '%.asm'  OR LOWER(f."path") ILIKE '%.nasm'  THEN 'Assembly'
    WHEN LOWER(f."path") ILIKE '%.c'    THEN 'C'
    WHEN LOWER(f."path") ILIKE '%.h'    THEN 'C'
    WHEN LOWER(f."path") ILIKE '%.cpp'  OR LOWER(f."path") ILIKE '%.c++' OR LOWER(f."path") ILIKE '%.hpp' OR LOWER(f."path") ILIKE '%.h++' THEN 'C++'
    WHEN LOWER(f."path") ILIKE '%.cs'   THEN 'C#'
    WHEN LOWER(f."path") ILIKE '%.go'   THEN 'Go'
    WHEN LOWER(f."path") ILIKE '%.java' THEN 'Java'
    WHEN LOWER(f."path") ILIKE '%.js'   OR LOWER(f."path") ILIKE '%.cjs'  THEN 'JavaScript'
    WHEN LOWER(f."path") ILIKE '%.py'   THEN 'Python'
    WHEN LOWER(f."path") ILIKE '%.rb'   THEN 'Ruby'
    ELSE NULL
  END AS "language",
  COUNT(*) AS "file_cnt"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
  ON f."id" = c."id"
WHERE c."content" IS NOT NULL AND c."content" <> ''
GROUP BY "language"
ORDER BY "file_cnt" DESC
LIMIT 20;
```

```sql
-- 9) Description: Same as (8) but exclude rows where language could not be detected (NULL).
SELECT
  language,
  file_cnt
FROM (
  SELECT
    CASE 
      WHEN LOWER(f."path") ILIKE '%.asm'  OR LOWER(f."path") ILIKE '%.nasm'  THEN 'Assembly'
      WHEN LOWER(f."path") ILIKE '%.c'    THEN 'C'
      WHEN LOWER(f."path") ILIKE '%.h'    THEN 'C'
      WHEN LOWER(f."path") ILIKE '%.cpp'  OR LOWER(f."path") ILIKE '%.c++' OR LOWER(f."path") ILIKE '%.hpp' OR LOWER(f."path") ILIKE '%.h++' THEN 'C++'
      WHEN LOWER(f."path") ILIKE '%.cs'   THEN 'C#'
      WHEN LOWER(f."path") ILIKE '%.go'   THEN 'Go'
      WHEN LOWER(f."path") ILIKE '%.java' THEN 'Java'
      WHEN LOWER(f."path") ILIKE '%.js'   OR LOWER(f."path") ILIKE '%.cjs'  THEN 'JavaScript'
      WHEN LOWER(f."path") ILIKE '%.py'   THEN 'Python'
      WHEN LOWER(f."path") ILIKE '%.rb'   THEN 'Ruby'
      ELSE NULL
    END AS "language"
  , COUNT(*) AS "file_cnt"
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   f
  JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
    ON f."id" = c."id"
  WHERE c."content" IS NOT NULL AND c."content" <> ''
  GROUP BY "language"
) q
WHERE language IS NOT NULL
ORDER BY "file_cnt" DESC
LIMIT 20;
```

```sql
-- 10) Description: Final query – return the 10 programming languages that occur most frequently
-- in files that have non‑empty content, based on recognized extensions.
SELECT
  language,
  file_cnt
FROM (
  SELECT
    CASE 
      WHEN LOWER(f."path") ILIKE '%.asm'  OR LOWER(f."path") ILIKE '%.nasm'                                  THEN 'Assembly'
      WHEN LOWER(f."path") ILIKE '%.c'    THEN 'C'
      WHEN LOWER(f."path") ILIKE '%.h'    THEN 'C'
      WHEN LOWER(f."path") ILIKE '%.cpp'  OR LOWER(f."path") ILIKE '%.c++' OR LOWER(f."path") ILIKE '%.hpp'  OR LOWER(f."path") ILIKE '%.h++' THEN 'C++'
      WHEN LOWER(f."path") ILIKE '%.cs'   THEN 'C#'
      WHEN LOWER(f."path") ILIKE '%.css'  THEN 'CSS'
      WHEN LOWER(f."path") ILIKE '%.go'   THEN 'Go'
      WHEN LOWER(f."path") ILIKE '%.java' THEN 'Java'
      WHEN LOWER(f."path") ILIKE '%.js'   OR LOWER(f."path") ILIKE '%.cjs'                                  THEN 'JavaScript'
      WHEN LOWER(f."path") ILIKE '%.jsx'  THEN 'JavaScript'
      WHEN LOWER(f."path") ILIKE '%.kt'   OR LOWER(f."path") ILIKE '%.kts'                                  THEN 'Kotlin'
      WHEN LOWER(f."path") ILIKE '%.php'  THEN 'PHP'
      WHEN LOWER(f."path") ILIKE '%.py'   THEN 'Python'
      WHEN LOWER(f."path") ILIKE '%.rb'   THEN 'Ruby'
      WHEN LOWER(f."path") ILIKE '%.rs'   THEN 'Rust'
      WHEN LOWER(f."path") ILIKE '%.scala' THEN 'Scala'
      WHEN LOWER(f."path") ILIKE '%.sh'   OR LOWER(f."path") ILIKE '%.bash'                                 THEN 'Shell'
      WHEN LOWER(f."path") ILIKE '%.ts'   THEN 'TypeScript'
      WHEN LOWER(f."path") ILIKE '%.vue'  THEN 'Vue'
      ELSE NULL
    END AS "language"
  , COUNT(*) AS "file_cnt"
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   f
  JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
    ON f."id" = c."id"
  WHERE c."content" IS NOT NULL AND c."content" <> ''
  GROUP BY "language"
) q
WHERE language IS NOT NULL
ORDER BY file_cnt DESC
LIMIT 10;
```
