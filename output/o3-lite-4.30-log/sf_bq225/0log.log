-- THINKING PROCESS ------------------------------------------------------------
-- Goal: find the 10 programming languages that appear most often among files
--       with non‑empty content, basing language detection solely on file
--       extensions listed in the prompt.
--
-- Steps
-- 1. Join github_repos.sample_files (f) with github_repos.sample_contents (c)
--    on their shared "id" to get paths and their actual content.
-- 2. Keep only rows where the content column is NOT NULL and not '' (empty).
-- 3. From every path, classify a programming language via a CASE expression
--    that maps known extensions → language names.  LOWER() + ILIKE ensures
--    the match is case‑insensitive.
-- 4. GROUP BY that derived language and COUNT(*) to get file counts.
-- 5. Discard rows where the language is NULL (unknown / un‑mapped).
-- 6. Order by count descending and return the top 10 languages.
-------------------------------------------------------------------------------
SELECT
  "language",
  "file_cnt"
FROM (
  SELECT
    CASE
      WHEN LOWER(f."path") ILIKE '%.asm'  OR LOWER(f."path") ILIKE '%.nasm'                                   THEN 'Assembly'
      WHEN LOWER(f."path") ILIKE '%.c'                                                                       THEN 'C'
      WHEN LOWER(f."path") ILIKE '%.h'                                                                       THEN 'C'
      WHEN LOWER(f."path") ILIKE '%.cpp'  OR LOWER(f."path") ILIKE '%.c++'
        OR LOWER(f."path") ILIKE '%.hpp' OR LOWER(f."path") ILIKE '%.h++'                                     THEN 'C++'
      WHEN LOWER(f."path") ILIKE '%.cs'                                                                      THEN 'C#'
      WHEN LOWER(f."path") ILIKE '%.css'                                                                     THEN 'CSS'
      WHEN LOWER(f."path") ILIKE '%.go'                                                                      THEN 'Go'
      WHEN LOWER(f."path") ILIKE '%.java'                                                                    THEN 'Java'
      WHEN LOWER(f."path") ILIKE '%.js'   OR LOWER(f."path") ILIKE '%.cjs'                                    THEN 'JavaScript'
      WHEN LOWER(f."path") ILIKE '%.py'                                                                      THEN 'Python'
      WHEN LOWER(f."path") ILIKE '%.rb'                                                                      THEN 'Ruby'
      WHEN LOWER(f."path") ILIKE '%.rs'                                                                      THEN 'Rust'
      WHEN LOWER(f."path") ILIKE '%.sh'   OR LOWER(f."path") ILIKE '%.bash'                                   THEN 'Shell'
      WHEN LOWER(f."path") ILIKE '%.ts'                                                                      THEN 'TypeScript'
      WHEN LOWER(f."path") ILIKE '%.php'                                                                     THEN 'PHP'
      WHEN LOWER(f."path") ILIKE '%.kt'   OR LOWER(f."path") ILIKE '%.kts'                                    THEN 'Kotlin'
      ELSE NULL
    END AS "language",
    COUNT(*) AS "file_cnt"
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"     f
  JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"  c
        ON f."id" = c."id"
  WHERE c."content" IS NOT NULL
    AND c."content" <> ''
  GROUP BY "language"
) agg
WHERE "language" IS NOT NULL
ORDER BY "file_cnt" DESC
LIMIT 10;
