      ELSE 'Other'
    END AS "language",
    COUNT(*) AS "file_count"
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   AS f
  JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
    ON f."id" = c."id"
  WHERE c."binary" = FALSE
    AND c."content" IS NOT NULL
    AND c."size"   > 0
  GROUP BY 1
) AS ranked
ORDER BY "file_count" DESC
LIMIT 20;
