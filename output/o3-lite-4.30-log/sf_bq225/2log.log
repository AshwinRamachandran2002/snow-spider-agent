Relevant columns and their potential usage  
GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES  
• "path": extract a file‑extension so we can infer the programming language.  
• "id": join key that links one row in SAMPLE_FILES to its full “content” row in SAMPLE_CONTENTS.  
• "repo_name": (optional) lets us know which repository owns the file.  

GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  
• "id": join key coming from SAMPLE_FILES.  
• "content": we only want rows where this is NOT NULL/empty (the task asks for “files that have non‑empty content”).  
• "binary": skip binary blobs when TRUE.  
• "size": an extra way to be sure the content is not empty (size > 0).  


------------------------------------------------------------------
10 exploratory Snowflake SQL queries (from simple to more complex).  
All identifier names are wrapped in double quotes and each query is limited to 20 rows.

```sql
-- 1. Description: Peek at a handful of file paths to see the raw filenames we will parse.
SELECT 
  "path",
  "repo_name"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
LIMIT 20;
```

```sql
-- 2. Description: Show distinct file‑extensions that appear in the SAMPLE_FILES table.
SELECT DISTINCT
  SPLIT_PART("path", '.', -1) AS "file_extension"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.%'      -- keep rows that really have “dot‑something”
LIMIT 20;
```

```sql
-- 3. Description: Join files with their content and keep only records that have a non‑null, non‑binary body.
SELECT
  f."path",
  c."size",
  c."binary"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   AS f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
  ON f."id" = c."id"
WHERE c."binary" = FALSE              -- skip binaries
  AND c."content" IS NOT NULL
  AND c."size"   > 0
LIMIT 20;
```

```sql
-- 4. Description: Show distinct file‑extensions that satisfy the “non‑empty content” filter from #3.
SELECT DISTINCT
  SPLIT_PART(f."path", '.', -1) AS "file_extension"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   AS f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
  ON f."id" = c."id"
WHERE c."binary" = FALSE
  AND c."content" IS NOT NULL
  AND c."size"   > 0
  AND f."path" ILIKE '%.%'
LIMIT 20;
```

```sql
-- 5. Description: Count how many files we have per raw extension (non‑empty content only).
SELECT
  SPLIT_PART(f."path", '.', -1)       AS "file_extension",
  COUNT(*)                            AS "file_count"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   AS f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
  ON f."id" = c."id"
WHERE c."binary" = FALSE
  AND c."content" IS NOT NULL
  AND c."size"   > 0
GROUP BY 1
ORDER BY "file_count" DESC
LIMIT 20;
```

```sql
-- 6. Description: Restrict to extensions that map to the languages we care about (example subset).
SELECT
  SPLIT_PART(f."path", '.', -1)       AS "target_extension",
  COUNT(*)                            AS "file_count"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   AS f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
  ON f."id" = c."id"
WHERE c."binary" = FALSE
  AND c."content" IS NOT NULL
  AND c."size"   > 0
  AND SPLIT_PART(f."path", '.', -1) IN (
        'c','h','cpp','hpp','py','java','js','ts','rb','go'
      )
GROUP BY 1
ORDER BY "file_count" DESC
LIMIT 20;
```

```sql
-- 7. Description: Map extensions to the requested language names via CASE; count files per language.
SELECT
  CASE
    WHEN LOWER(f."path") LIKE '%.c'          THEN 'C'
    WHEN LOWER(f."path") LIKE '%.h'          THEN 'C'
    WHEN LOWER(f."path") LIKE '%.cpp'        THEN 'C++'
    WHEN LOWER(f."path") LIKE '%.hpp'        THEN 'C++'
    WHEN LOWER(f."path") LIKE '%.py'         THEN 'Python'
    WHEN LOWER(f."path") LIKE '%.java'       THEN 'Java'
    WHEN LOWER(f."path") LIKE '%.js'         THEN 'JavaScript'
    WHEN LOWER(f."path") LIKE '%.ts'         THEN 'TypeScript'
    WHEN LOWER(f."path") LIKE '%.rb'         THEN 'Ruby'
    WHEN LOWER(f."path") LIKE '%.go'         THEN 'Go'
    ELSE 'Other'
  END AS "language",
  COUNT(*) AS "file_count"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   AS f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
  ON f."id" = c."id"
WHERE c."binary" = FALSE
  AND c."content" IS NOT NULL
  AND c."size"   > 0
GROUP BY 1
ORDER BY "file_count" DESC
LIMIT 20;
```

```sql
-- 8. Description: Pull the TOP 10 languages (still using the CASE logic for extension→language).
SELECT
  "language",
  "file_count"
FROM (
  SELECT
    CASE
      WHEN LOWER(f."path") LIKE '%.c'          THEN 'C'
      WHEN LOWER(f."path") LIKE '%.h'          THEN 'C'
      WHEN LOWER(f."path") LIKE '%.cpp'        THEN 'C++'
      WHEN LOWER(f."path") LIKE '%.hpp'        THEN 'C++'
      WHEN LOWER(f."path") LIKE '%.py'         THEN 'Python'
      WHEN LOWER(f."path") LIKE '%.java'       THEN 'Java'
      WHEN LOWER(f."path") LIKE '%.js'         THEN 'JavaScript'
      WHEN LOWER(f."path") LIKE '%.ts'         THEN 'TypeScript'
      WHEN LOWER(f."path") LIKE '%.rb'         THEN 'Ruby'
      WHEN LOWER(f."path") LIKE '%.go'         THEN 'Go'
      WHEN LOWER(f."path") LIKE '%.cs'         THEN 'C#'
      WHEN LOWER(f."path") LIKE '%.rs'         THEN 'Rust'
      WHEN LOWER(f."path") LIKE '%.swift'      THEN 'Swift'
      WHEN LOWER(f."path") LIKE '%.sh'         THEN 'Shell'
      ELSE 'Other'
    END AS "language",
    COUNT(*) AS "file_count"
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   AS f
  JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
    ON f."id" = c."id"
  WHERE c."binary" = FALSE
    AND c."content" IS NOT NULL
    AND c."size"   > 0
  GROUP BY 1
) AS ranked
ORDER BY "file_count" DESC
LIMIT 20;
```

```sql
-- 9. Description: Show, for each repository, which of the tracked languages is the most abundant.
SELECT
  f."repo_name",
  CASE
    WHEN LOWER(f."path") LIKE '%.py'    THEN 'Python'
    WHEN LOWER(f."path") LIKE '%.java'  THEN 'Java'
    WHEN LOWER(f."path") LIKE '%.js'    THEN 'JavaScript'
    ELSE 'Other'
  END AS "language_guess",
  COUNT(*) AS "file_count"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   AS f
JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
  ON f."id" = c."id"
WHERE c."binary" = FALSE
  AND c."content" IS NOT NULL
  AND c."size"   > 0
GROUP BY
  f."repo_name",
  "language_guess"
ORDER BY
  "file_count" DESC
LIMIT 20;
```

```sql
-- 10. Description: Same as #8 but ordered and limited to the final Top‑10 languages only.
SELECT
  "language",
  "file_count"
FROM (
  SELECT
    CASE
      WHEN LOWER(f."path") LIKE '%.c'          THEN 'C'
      WHEN LOWER(f."path") LIKE '%.h'          THEN 'C'
      WHEN LOWER(f."path") LIKE '%.cpp'        THEN 'C++'
      WHEN LOWER(f."path") LIKE '%.hpp'        THEN 'C++'
      WHEN LOWER(f."path") LIKE '%.py'         THEN 'Python'
      WHEN LOWER(f."path") LIKE '%.java'       THEN 'Java'
      WHEN LOWER(f."path") LIKE '%.js'         THEN 'JavaScript'
      WHEN LOWER(f."path") LIKE '%.ts'         THEN 'TypeScript'
      WHEN LOWER(f."path") LIKE '%.rb'         THEN 'Ruby'
      WHEN LOWER(f."path") LIKE '%.go'         THEN 'Go'
      WHEN LOWER(f."path") LIKE '%.rs'         THEN 'Rust'
      WHEN LOWER(f."path") LIKE '%.cs'         THEN 'C#'
      WHEN LOWER(f."path") LIKE '%.sh'         THEN 'Shell'
      WHEN LOWER(f."path") LIKE '%.swift'      THEN 'Swift'
      ELSE 'Other'
    END AS "language",
    COUNT(*) AS "file_count"
  FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"   AS f
  JOIN "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" AS c
    ON f."id" = c."id"
  WHERE c."binary" = FALSE
    AND c."content" IS NOT NULL
    AND c."size"   > 0
  GROUP BY 1
  ORDER BY "file_count" DESC
  LIMIT 10
) AS top10
LIMIT 20;
```

These ten queries progressively explore the relevant tables, isolate files with meaningful text content, build an extension‑to‑language mapping, and finally produce the counts necessary to identify the ten most common programming languages—all without directly presenting the final numeric answer.
