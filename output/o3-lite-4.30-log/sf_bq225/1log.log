Begin Exploring Related Columns
Relevant columns and their potential usage  
• SAMPLE_FILES."path": Needed to extract the file‑name extension so we can infer a programming‑language.  
• SAMPLE_FILES."id": Primary key used to join with SAMPLE_CONTENTS."id".  
• SAMPLE_CONTENTS."content": Must be NOT NULL / <> '' to guarantee the file really contains text.  
• SAMPLE_CONTENTS."binary": Helps us ignore files that are marked as binary (keep only FALSE or NULL).  
• SAMPLE_CONTENTS."size": Optional extra guard (e.g. >0) to be sure the file isn’t empty.  

Typical conditions that may be useful  
• SAMPLE_CONTENTS."content" IS NOT NULL AND SAMPLE_CONTENTS."content" <> ''  
• (SAMPLE_CONTENTS."binary" = FALSE OR SAMPLE_CONTENTS."binary" IS NULL)  
• SAMPLE_CONTENTS."size" > 0  
• SAMPLE_FILES."path" ILIKE '%.py'  (or any other extension of interest)  

Below are ten exploratory Snowflake SQL queries (each limited to 20 rows) that progress from very basic inspection to the kind of aggregation you would finally use to answer the task.  Adjust “DATABASE”, “SCHEMA”, and “TABLE” only if your environment differs; here we keep them as provided: GITHUB_REPOS.GITHUB_REPOS.*

```sql
-- 1. Description: Peek at raw rows inside SAMPLE_FILES
SELECT *
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
LIMIT 20;
```

```sql
-- 2. Description: Peek at raw rows inside SAMPLE_CONTENTS
SELECT *
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"
LIMIT 20;
```

```sql
-- 3. Description: Join files to their contents (verify join works, limit to 20)
SELECT sf."repo_name",
       sf."path",
       sc."size",
       sc."binary",
       LEFT(sc."content", 120) AS "content_snippet"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"     sf
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"  sc
       ON sf."id" = sc."id"
WHERE  sc."content" IS NOT NULL
  AND  sc."content" <> ''
LIMIT 20;
```

```sql
-- 4. Description: List distinct file‑name extensions that appear in SAMPLE_FILES
SELECT DISTINCT
       LOWER(SPLIT_PART(sf."path", '.', -1)) AS "extension"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" sf
WHERE  POSITION('.' IN sf."path") > 0
LIMIT 20;
```

```sql
-- 5. Description: Quick count of files per extension (with non‑empty content)
SELECT LOWER(SPLIT_PART(sf."path", '.', -1)) AS "extension",
       COUNT(*)                                AS "file_count"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"     sf
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"  sc
       ON sf."id" = sc."id"
WHERE  sc."content" IS NOT NULL
  AND  sc."content" <> ''
  AND  (sc."binary" = FALSE OR sc."binary" IS NULL)
GROUP  BY "extension"
ORDER  BY "file_count" DESC
LIMIT 20;
```

```sql
-- 6. Description: Preview the path & detected extension for a specific language family, e.g. Python (.py)
SELECT sf."repo_name",
       sf."path",
       sc."size"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"     sf
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"  sc
       ON sf."id" = sc."id"
WHERE  LOWER(SPLIT_PART(sf."path", '.', -1)) = 'py'
  AND  sc."content" IS NOT NULL
  AND  sc."content" <> ''
LIMIT 20;
```

```sql
-- 7. Description: Map popular extensions to languages via CASE expression (10 rows sample)
SELECT CASE
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) IN ('c', 'h')                  THEN 'C'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) IN ('cpp', 'hpp', 'c++', 'h++') THEN 'C++'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'py'                        THEN 'Python'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'js'                        THEN 'JavaScript'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'java'                      THEN 'Java'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'rb'                        THEN 'Ruby'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'go'                        THEN 'Go'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'ts'                        THEN 'TypeScript'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'rs'                        THEN 'Rust'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'php'                       THEN 'PHP'
         ELSE 'OTHER'
       END                                  AS "language_guess",
       sf."path"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES" sf
LIMIT 20;
```

```sql
-- 8. Description: Aggregate counts for the language mapping (top 20 only)
SELECT CASE
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) IN ('c', 'h')                  THEN 'C'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) IN ('cpp', 'hpp', 'c++', 'h++') THEN 'C++'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'py'                        THEN 'Python'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'js'                        THEN 'JavaScript'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'java'                      THEN 'Java'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'rb'                        THEN 'Ruby'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'go'                        THEN 'Go'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'ts'                        THEN 'TypeScript'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'rs'                        THEN 'Rust'
         WHEN LOWER(SPLIT_PART(sf."path", '.', -1)) =  'php'                       THEN 'PHP'
         ELSE 'OTHER'
       END                                  AS "language_guess",
       COUNT(*)                             AS "file_count"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"     sf
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"  sc
       ON sf."id" = sc."id"
WHERE  sc."content" IS NOT NULL
  AND  sc."content" <> ''
  AND  (sc."binary" = FALSE OR sc."binary" IS NULL)
GROUP  BY "language_guess"
ORDER  BY "file_count" DESC
LIMIT 20;
```

```sql
-- 9. Description: Inspect some very large (size > 50000) non‑binary files to ensure they are text, sample 20
