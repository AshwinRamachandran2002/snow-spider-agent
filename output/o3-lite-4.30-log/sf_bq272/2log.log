FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
-- 2. Description: List distinct status flags to understand which ones mean a completed sale
SELECT DISTINCT "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
-- 3. Description: Check how many rows have non‑NULL "returned_at" (potential returns)
SELECT COUNT(*) AS "rows_with_returns"
