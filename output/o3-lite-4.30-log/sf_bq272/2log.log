WHERE "returned_at" IS NOT NULL;
```

```sql
-- 4. Description: Inspect the micro‑seconds timestamp and convert it to regular dates
SELECT 
    "id",
    "created_at",
    TO_TIMESTAMP_NTZ("created_at"/1000000) AS "created_at_ts"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
-- 5. Description: List the first 20 month‑buckets that exist in data (YYYY‑MM)
SELECT DISTINCT 
       TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1000000), 'YYYY‑MM') AS "year_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
ORDER BY "year_month"
LIMIT 20;
```

```sql
-- 6. Description: Join ORDER_ITEMS with INVENTORY_ITEMS to compare sale_price vs. cost per line
SELECT 
    o."id"          AS "order_item_id",
    o."product_id",
    o."inventory_item_id",
    o."sale_price",
    i."cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
  ON o."inventory_item_id" = i."id"
LIMIT 20;
```

```sql
-- 7. Description: Compute per‑row profit (sale_price – cost) for a small sample
SELECT 
    o."id"                                                    AS "order_item_id",
    (o."sale_price" - i."cost")                               AS "profit_per_unit",
    TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000), 'YYYY‑MM') AS "year_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
  ON o."inventory_item_id" = i."id"
WHERE o."status" NOT ILIKE '%cancel%' 
  AND o."returned_at" IS NULL
LIMIT 20;
```

```sql
-- 8. Description: Bring in product names for clarity
SELECT 
    o."product_id",
    p."name"          AS "product_name",
    o."sale_price",
    i."cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
  ON o."inventory_item_id" = i."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON o."product_id" = p."id"
LIMIT 20;
```

```sql
-- 9. Description: Aggregate monthly profit per product (still sample, top 20 by profit)
SELECT 
    TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000), 'YYYY‑MM') AS "year_month",
    p."name"                                                     AS "product_name",
    SUM(o."sale_price") - SUM(i."cost")                          AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
  ON o."inventory_item_id" = i."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
  ON o."product_id" = p."id"
WHERE o."status" NOT ILIKE '%cancel%' 
  AND o."returned_at" IS NULL
  AND TO_TIMESTAMP_NTZ(o."created_at"/1000000) BETWEEN '2019‑01‑01' AND '2022‑08‑31'
GROUP BY 1, 2
ORDER BY "profit" DESC
LIMIT 20;
```

```sql
--10. Description: Rank products inside each month and keep only the top 3 (limit 20 rows preview)
WITH monthly_profit AS (
    SELECT 
        TO_CHAR(TO_TIMESTAMP_NTZ(o."created_at"/1000000), 'YYYY‑MM') AS "year_month",
        p."name"                                                     AS "product_name",
        SUM(o."sale_price") - SUM(i."cost")                          AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" i
      ON o."inventory_item_id" = i."id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
      ON o."product_id" = p."id"
    WHERE o."status" NOT ILIKE '%cancel%' 
      AND o."returned_at" IS NULL
      AND TO_TIMESTAMP_NTZ(o."created_at"/1000000) BETWEEN '2019‑01‑01' AND '2022‑08‑31'
    GROUP BY 1, 2
), ranked AS (
    SELECT 
        "year_month",
        "product_name",
        "profit",
        RANK() OVER (PARTITION BY "year_month" ORDER BY "profit" DESC) AS "rk"
    FROM monthly_profit
)
SELECT *
FROM ranked
WHERE "rk" <= 3
ORDER BY "year_month", "rk"
LIMIT 20;
```

