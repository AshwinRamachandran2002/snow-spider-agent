```sql
-- 6) Description: Produce one row per LGG participant with the average log10(normalized_count+1)
--                 expression of DRG2.  This is the basic expression metric we will test.
SELECT "ParticipantBarcode",
       AVG(LOG10("normalized_count" + 1)) AS "avg_log_expr"
FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED"
WHERE "Study" = 'LGG'
  AND "Symbol" = 'DRG2'
GROUP BY "ParticipantBarcode"
LIMIT 20;
```

```sql
-- 7) Description: Tag each participant in the expression sub‑set as TP53‑mutated (PASS) or not.
SELECT e."ParticipantBarcode",
       e."avg_log_expr",
       CASE WHEN m."ParticipantBarcode" IS NOT NULL THEN 1 ELSE 0 END AS "TP53_MUT"
FROM (
      SELECT "ParticipantBarcode",
             AVG(LOG10("normalized_count" + 1)) AS "avg_log_expr"
      FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED"
      WHERE "Study" = 'LGG'
        AND "Symbol" = 'DRG2'
      GROUP BY "ParticipantBarcode"
     ) e
LEFT JOIN (
      SELECT DISTINCT "ParticipantBarcode"
      FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE"
      WHERE "Study" = 'LGG'
        AND "Hugo_Symbol" = 'TP53'
        AND "FILTER" = 'PASS'
) m
  ON e."ParticipantBarcode" = m."ParticipantBarcode"
LIMIT 20;
```

```sql
-- 8) Description: Compute counts, sums and sums of squares for the mutated group only.
WITH expr AS (
  SELECT "ParticipantBarcode",
         AVG(LOG10("normalized_count" + 1)) AS "avg_log_expr"
  FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED"
  WHERE "Study" = 'LGG'
    AND "Symbol" = 'DRG2'
  GROUP BY "ParticipantBarcode"
),
mutated AS (
  SELECT DISTINCT "ParticipantBarcode"
  FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE"
  WHERE "Study" = 'LGG'
    AND "Hugo_Symbol" = 'TP53'
    AND "FILTER" = 'PASS'
)
SELECT COUNT(*)                                   AS "N_y",
       SUM("avg_log_expr")                        AS "S_y",
       SUM(POWER("avg_log_expr",2))               AS "Q_y"
FROM expr
JOIN mutated USING ("ParticipantBarcode")
LIMIT 20;
```

```sql
-- 9) Description: Do the same for the non‑mutated group.
WITH expr AS (
  SELECT "ParticipantBarcode",
         AVG(LOG10("normalized_count" + 1)) AS "avg_log_expr"
  FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED"
  WHERE "Study" = 'LGG'
    AND "Symbol" = 'DRG2'
  GROUP BY "ParticipantBarcode"
),
mutated AS (
  SELECT DISTINCT "ParticipantBarcode"
  FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE"
  WHERE "Study" = 'LGG'
    AND "Hugo_Symbol" = 'TP53'
    AND "FILTER" = 'PASS'
)
SELECT COUNT(*)                                   AS "N_n",
       SUM("avg_log_expr")                        AS "S_n",
       SUM(POWER("avg_log_expr",2))               AS "Q_n"
FROM expr e
LEFT JOIN mutated m
       ON e."ParticipantBarcode" = m."ParticipantBarcode"
WHERE m."ParticipantBarcode" IS NULL
LIMIT 20;
```

```sql
-- 10) Description: Final query – compute Welch’s t‑score (rounded to 2 decimals) comparing
--                  DRG2 expression between TP53‑mutated vs. non‑mutated LGG participants.
WITH expr AS (
  -- per‑participant mean log10 expression of DRG2
  SELECT "ParticipantBarcode",
         AVG(LOG10("normalized_count" + 1)) AS "g"
  FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED"
  WHERE "Study" = 'LGG'
    AND "Symbol" = 'DRG2'
  GROUP BY "ParticipantBarcode"
),
mutated AS (
  -- participants harbouring at least one PASS TP53 mutation
  SELECT DISTINCT "ParticipantBarcode"
  FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE"
  WHERE "Study" = 'LGG'
    AND "Hugo_Symbol" = 'TP53'
    AND "FILTER" = 'PASS'
),
stats AS (
  SELECT
    -- counts
    COUNT(CASE WHEN m."ParticipantBarcode" IS NOT NULL THEN 1 END)              AS "N_y",
    COUNT(CASE WHEN m."ParticipantBarcode" IS NULL  THEN 1 END)                AS "N_n",
    -- sums
    SUM(CASE WHEN m."ParticipantBarcode" IS NOT NULL THEN e."g" END)            AS "S_y",
    SUM(CASE WHEN m."ParticipantBarcode" IS NULL  THEN e."g" END)               AS "S_n",
    -- sums of squares
    SUM(CASE WHEN m."ParticipantBarcode" IS NOT NULL THEN POWER(e."g",2) END)   AS "Q_y",
    SUM(CASE WHEN m."ParticipantBarcode" IS NULL  THEN POWER(e."g",2) END)      AS "Q_n"
  FROM expr e
  LEFT JOIN mutated m
         ON e."ParticipantBarcode" = m."ParticipantBarcode"
)
SELECT
  -- derived statistics
  "N_y",
  "N_n",
  ROUND( (("S_y"/"N_y") - ("S_n"/"N_n")) /
         SQRT( ((("Q_y" - ("S_y"* "S_y")/"N_y") / (GREATEST("N_y"-1,1))) / "N_y") +
               ((("Q_n" - ("S_n"* "S_n")/"N_n") / (GREATEST("N_n"-1,1))) / "N_n") )
       , 2)                           AS "t_score"
FROM stats
WHERE "N_y" >= 10
  AND "N_n" >= 10
  AND ("Q_y" - ("S_y"* "S_y")/"N_y") > 0
  AND ("Q_n" - ("S_n"* "S_n")/"N_n") > 0
LIMIT 20;
```

These queries move from basic exploration (listing values, confirming gene names) through intermediate aggregation, and finally to computation of the Welch’s t‑score for DRG2 expression between TP53‑mutated and non‑mutated LGG participants, subject to the size and variance constraints described in `t_score.md`.
