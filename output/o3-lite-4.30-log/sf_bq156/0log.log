FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE"
WHERE "Study" = 'LGG'
LIMIT 20;
```

```sql
-- 5) Description:  Show TP53 mutations that passed all filters in LGG
