        MIN(CASE WHEN is_mut = 0 THEN Q END) AS Q_n
    FROM stats
)
SELECT
    ROUND(
      (S_y/N_y - S_n/N_n) /
      SQRT( ((Q_y - S_y*S_y/N_y)/(N_y-1))/N_y + ((Q_n - S_n*S_n/N_n)/(N_n-1))/N_n )
    , 2) AS t_score
FROM vars
WHERE N_y >= 10
  AND N_n >= 10
  AND (Q_y - S_y*S_y/N_y) > 0
  AND (Q_n - S_n*S_n/N_n) > 0;
