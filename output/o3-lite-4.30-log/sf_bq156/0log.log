```sql
--Description:
-- Purpose: produce the Welch t‑score comparing DRG2 expression (log10‑transformed average per participant)
--          between TP53‑mutated and non‑mutated LGG patients.
-- Strategy:
--   1. tp53_mut  : get LGG participants whose tumors have ≥1 TP53 mutation with FILTER='PASS'.
--   2. drg2      : compute each participant’s mean LOG10(normalized_count+1) for DRG2.
--   3. flagged   : join drg2 with tp53_mut to assign mutation status (is_mut = 1 / 0).
--   4. stats     : per group, calculate N, Σx (S), Σx² (Q) needed for sample mean/variance.
--   5. vars      : pull both groups into one row; derive unbiased variances.
--   6. final     : apply Welch’s formula; round t‑score to 2 decimals; enforce size/variance filters ≥10 & >0.
WITH tp53_mut AS (
    SELECT DISTINCT "ParticipantBarcode"
    FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE"
    WHERE "Study" = 'LGG'
      AND "Hugo_Symbol" = 'TP53'
      AND "FILTER" = 'PASS'
),
drg2 AS (
    SELECT "ParticipantBarcode",
           AVG( LOG(10, "normalized_count" + 1) ) AS expr
    FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED"
    WHERE "Study" = 'LGG'
      AND "Symbol" = 'DRG2'
    GROUP BY "ParticipantBarcode"
),
flagged AS (
    SELECT d.expr,
           CASE WHEN t."ParticipantBarcode" IS NOT NULL THEN 1 ELSE 0 END AS is_mut
    FROM drg2 d
    LEFT JOIN tp53_mut t
      ON d."ParticipantBarcode" = t."ParticipantBarcode"
),
stats AS (
    SELECT is_mut,
           COUNT(*)                AS N,
           SUM(expr)               AS S,
           SUM(expr*expr)          AS Q
    FROM flagged
    GROUP BY is_mut
),
vars AS (
    SELECT
        MIN(CASE WHEN is_mut = 1 THEN N END) AS N_y,
        MIN(CASE WHEN is_mut = 1 THEN S END) AS S_y,
        MIN(CASE WHEN is_mut = 1 THEN Q END) AS Q_y,
        MIN(CASE WHEN is_mut = 0 THEN N END) AS N_n,
        MIN(CASE WHEN is_mut = 0 THEN S END) AS S_n,
        MIN(CASE WHEN is_mut = 0 THEN Q END) AS Q_n
    FROM stats
)
SELECT
    ROUND(
      (S_y/N_y - S_n/N_n) /
      SQRT( ((Q_y - S_y*S_y/N_y)/(N_y-1))/N_y + ((Q_n - S_n*S_n/N_n)/(N_n-1))/N_n )
    , 2) AS t_score
FROM vars
WHERE N_y >= 10
  AND N_n >= 10
  AND (Q_y - S_y*S_y/N_y) > 0
  AND (Q_n - S_n*S_n/N_n) > 0;
```
