FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED"
WHERE "Study" = 'LGG'
  AND "Symbol" = 'DRG2'
LIMIT 20;
```

```sql
-- 3) Description:  Inspect log‑transformed expression values for DRG2
SELECT "ParticipantBarcode",
       LOG10("normalized_count" + 1) AS "log10_expr"
FROM "PANCANCER_ATLAS_1"."PANCANCER_ATLAS_FILTERED"."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED"
WHERE "Study" = 'LGG'
  AND "Symbol" = 'DRG2'
LIMIT 20;
```

```sql
-- 4) Description:  List distinct genes that are mutated in LGG (mutation table)
