```sql
--Description: We need Welch’s t‑score for average log10‑transformed DRG2 expression
--             comparing TP53‑mutated (PASS only) vs non‑mutated participants in LGG.
-- STEP‑BY‑STEP (all wrapped in one query via CTEs):
-- 1) expr:   For every LGG participant, compute the mean of LOG10(normalized_count+1) for DRG2.
-- 2) tp53:   List LGG participants whose TP53 mutation passed all filters.
-- 3) classed:Join #1 and #2 to label each participant (is_mut =1 if TP53‑mutated).
-- 4) stats:  For each group (0 / 1) calculate N, mean, and unbiased variance; keep groups with N≥10 & var>0.
-- 5) calc:   Apply Welch’s formula using those summary stats, then round to 2 dp.
WITH expr AS (
    SELECT
        e."ParticipantBarcode",
        AVG(LOG(10, e."normalized_count" + 1)) AS expr_avg
    FROM PANCANCER_ATLAS_1.PANCANCER_ATLAS_FILTERED."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED" e
    WHERE e."Study" = 'LGG'
      AND e."Symbol" = 'DRG2'
    GROUP BY e."ParticipantBarcode"
),
tp53 AS (
    SELECT DISTINCT "ParticipantBarcode"
    FROM PANCANCER_ATLAS_1.PANCANCER_ATLAS_FILTERED."MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE"
    WHERE "Study" = 'LGG'
      AND "Hugo_Symbol" = 'TP53'
      AND "FILTER" = 'PASS'
),
classed AS (
    SELECT
        expr."ParticipantBarcode",
        expr.expr_avg,
        CASE WHEN tp53."ParticipantBarcode" IS NULL THEN 0 ELSE 1 END AS is_mut
    FROM expr
    LEFT JOIN tp53 ON expr."ParticipantBarcode" = tp53."ParticipantBarcode"
),
stats AS (
    SELECT
        is_mut,
        COUNT(*)              AS N,
        AVG(expr_avg)         AS mean,
        VAR_SAMP(expr_avg)    AS var
    FROM classed
    GROUP BY is_mut
    HAVING COUNT(*) >= 10 AND VAR_SAMP(expr_avg) > 0
),
calc AS (
    SELECT
        (
            (SELECT mean FROM stats WHERE is_mut = 1) -
            (SELECT mean FROM stats WHERE is_mut = 0)
        )
        /
        SQRT(
            (SELECT var FROM stats WHERE is_mut = 1) / (SELECT N FROM stats WHERE is_mut = 1) +
            (SELECT var FROM stats WHERE is_mut = 0) / (SELECT N FROM stats WHERE is_mut = 0)
        ) AS t_score
)
SELECT ROUND(t_score, 2) AS "Welch_t_score"
FROM calc;
```
