```sql
-- 6) Description: Join expression with mutation status to preview DRG2 log‑expression per participant
SELECT e."ParticipantBarcode",
       AVG(LOG10(e."normalized_count" + 1)) AS "log10_expr",
       CASE WHEN m."ParticipantBarcode" IS NULL THEN 'Non‑mutated' ELSE 'TP53_mutated' END AS "group"
FROM PANCANCER_ATLAS_1.PANCANCER_ATLAS_FILTERED."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED" e
LEFT JOIN (
    SELECT DISTINCT "ParticipantBarcode"
    FROM PANCANCER_ATLAS_1.PANCANCER_ATLAS_FILTERED."MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE"
    WHERE "Study" = 'LGG'
      AND "Hugo_Symbol" = 'TP53'
      AND "FILTER" = 'PASS'
) m
ON e."ParticipantBarcode" = m."ParticipantBarcode"
WHERE e."Study" = 'LGG'
  AND e."Symbol" = 'DRG2'
GROUP BY e."ParticipantBarcode", m."ParticipantBarcode"
LIMIT 20;
```

```sql
-- 7) Description: Summary statistics (N, mean, variance) for each group
WITH expr AS (
  SELECT e."ParticipantBarcode",
         AVG(LOG10(e."normalized_count" + 1)) AS expr_avg
  FROM PANCANCER_ATLAS_1.PANCANCER_ATLAS_FILTERED."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED" e
  WHERE e."Study" = 'LGG'
    AND e."Symbol" = 'DRG2'
  GROUP BY e."ParticipantBarcode"
),
tp53 AS (
  SELECT DISTINCT "ParticipantBarcode"
  FROM PANCANCER_ATLAS_1.PANCANCER_ATLAS_FILTERED."MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE"
  WHERE "Study" = 'LGG'
    AND "Hugo_Symbol" = 'TP53'
    AND "FILTER" = 'PASS'
)
SELECT CASE WHEN t."ParticipantBarcode" IS NULL THEN 0 ELSE 1 END AS is_mutated,
       COUNT(*)                          AS N,
       AVG(expr_avg)                     AS mean_expr,
       VAR_SAMP(expr_avg)                AS var_expr
FROM expr e
LEFT JOIN tp53 t ON e."ParticipantBarcode" = t."ParticipantBarcode"
GROUP BY is_mutated
LIMIT 20;
```

```sql
-- 8) Description: Participants retained after enforcing N≥10 and variance>0 per group
WITH expr AS (
  SELECT e."ParticipantBarcode",
         AVG(LOG10(e."normalized_count" + 1)) AS expr_avg
  FROM PANCANCER_ATLAS_1.PANCANCER_ATLAS_FILTERED."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED" e
  WHERE e."Study" = 'LGG'
