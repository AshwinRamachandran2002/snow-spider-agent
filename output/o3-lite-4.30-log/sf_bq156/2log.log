         ON e."ParticipantBarcode" = t."ParticipantBarcode"
),
stats AS (
  SELECT 
      is_mut,
      COUNT(*)               AS N,
      AVG(expr_avg)          AS mean,
      VAR_SAMP(expr_avg)     AS var
  FROM classed
  GROUP BY is_mut
  HAVING COUNT(*) >= 10 AND VAR_SAMP(expr_avg) > 0
)
SELECT *
FROM stats
LIMIT 20;
