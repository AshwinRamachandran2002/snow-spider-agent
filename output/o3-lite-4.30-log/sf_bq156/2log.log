```sql
-- 10) Description: Final query – Welch’s t‑score (rounded to 2 decimals) for DRG2 expression in TP53‑mutated vs non‑mutated LGG patients
WITH expr AS (
  SELECT e."ParticipantBarcode",
         AVG(LOG10(e."normalized_count" + 1)) AS expr_avg
  FROM PANCANCER_ATLAS_1.PANCANCER_ATLAS_FILTERED."EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED" e
  WHERE e."Study" = 'LGG'
    AND e."Symbol" = 'DRG2'
  GROUP BY e."ParticipantBarcode"
),
tp53 AS (
  SELECT DISTINCT "ParticipantBarcode"
  FROM PANCANCER_ATLAS_1.PANCANCER_ATLAS_FILTERED."MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE"
  WHERE "Study" = 'LGG'
    AND "Hugo_Symbol" = 'TP53'
    AND "FILTER" = 'PASS'
),
classed AS (
  SELECT e."ParticipantBarcode",
         expr_avg,
         CASE WHEN t."ParticipantBarcode" IS NULL THEN 0 ELSE 1 END AS is_mut
  FROM expr e
  LEFT JOIN tp53 t ON e."ParticipantBarcode" = t."ParticipantBarcode"
),
stats AS (
  SELECT is_mut,
         COUNT(*)            AS N,
         AVG(expr_avg)       AS mean,
         VAR_SAMP(expr_avg)  AS var
  FROM classed
  GROUP BY is_mut
  HAVING COUNT(*) >= 10 AND VAR_SAMP(expr_avg) > 0
),
calc AS (
  SELECT
    ( (SELECT mean FROM stats WHERE is_mut = 1) - (SELECT mean FROM stats WHERE is_mut = 0) )
      /
    SQRT( (SELECT var FROM stats WHERE is_mut = 1) / (SELECT N FROM stats WHERE is_mut = 1)
        + (SELECT var FROM stats WHERE is_mut = 0) / (SELECT N FROM stats WHERE is_mut = 0) )
    AS t_score
)
SELECT ROUND(t_score, 2) AS "Welch_t_score"
FROM calc
LIMIT 20;
```

