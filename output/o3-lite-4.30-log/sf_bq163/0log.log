```sql
-- 8. Description: Compute average X_VALUE per gene for female epithelial cells in cluster 41, 74‑year‑old stage
SELECT "FEATURE_NAME",
       AVG("X_VALUE") AS "avg_female_X"
FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CLUSTERS" = '41'
  AND "CELL_TYPE_COARSE" = 'Epithelial'
  AND "DEVELOPMENT_STAGE" ILIKE '%74%year%old%'
  AND "SEX" ILIKE 'female'
GROUP BY "FEATURE_NAME"
ORDER BY "avg_female_X" DESC
LIMIT 20;
```

```sql
-- 9. Description: Compute average X_VALUE per gene for male epithelial cells in cluster 41, 74‑year‑old stage
SELECT "FEATURE_NAME",
       AVG("X_VALUE") AS "avg_male_X"
FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CLUSTERS" = '41'
  AND "CELL_TYPE_COARSE" = 'Epithelial'
  AND "DEVELOPMENT_STAGE" ILIKE '%74%year%old%'
  AND "SEX" ILIKE 'male'
GROUP BY "FEATURE_NAME"
ORDER BY "avg_male_X" DESC
LIMIT 20;
```

```sql
-- 10. Description: Final analytical query – return the 20 genes with the largest (female − male) average expression difference
WITH female_avg AS (
    SELECT "FEATURE_NAME",
           AVG("X_VALUE") AS "avg_female"
    FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
    WHERE "CLUSTERS" = '41'
      AND "CELL_TYPE_COARSE" = 'Epithelial'
      AND "DEVELOPMENT_STAGE" ILIKE '%74%year%old%'
      AND "SEX" ILIKE 'female'
    GROUP BY "FEATURE_NAME"
),
male_avg AS (
    SELECT "FEATURE_NAME",
           AVG("X_VALUE") AS "avg_male"
    FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
    WHERE "CLUSTERS" = '41'
      AND "CELL_TYPE_COARSE" = 'Epithelial'
      AND "DEVELOPMENT_STAGE" ILIKE '%74%year%old%'
      AND "SEX" ILIKE 'male'
    GROUP BY "FEATURE_NAME"
)
SELECT f."FEATURE_NAME",
       f."avg_female" - COALESCE(m."avg_male",0) AS "female_minus_male_avg_X"
FROM female_avg f
LEFT JOIN male_avg m
  ON f."FEATURE_NAME" = m."FEATURE_NAME"
ORDER BY "female_minus_male_avg_X" DESC
LIMIT 20;
```

