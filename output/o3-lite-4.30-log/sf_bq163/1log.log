--Description / Thinking process:
-- Goal: Identify genes whose expression differs between female and male epithelial cells
--       in cluster 41 among 74‑year‑old human stage patients.
-- Steps embedded in this single query:
--   1. Apply filters:
--        • "CELL_TYPE_COARSE" = 'Epithelial'
--        • "CLUSTERS"         = '41'
--        • "DEVELOPMENT_STAGE" contains '74-year'
--   2. Use CASE expressions to calculate separate averages of "X_VALUE" for females and males.
--      LOWER("SEX") handles any capitalization inconsistencies.
--   3. Aggregate by "FEATURE_NAME".
--   4. Keep only genes that have non‑NULL averages for BOTH sexes.
--   5. Compute the difference: female average minus male average.
--   6. Limit to 20 rows (sample output – remove LIMIT for full list or add ORDER BY to rank).

WITH gene_means AS (
    SELECT
        "FEATURE_NAME",
        AVG(CASE WHEN LOWER("SEX") = 'female' THEN "X_VALUE" END) AS avg_female,
        AVG(CASE WHEN LOWER("SEX") = 'male'   THEN "X_VALUE" END) AS avg_male
    FROM HTAN_2.HTAN.SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT
    WHERE "CELL_TYPE_COARSE" = 'Epithelial'
      AND "CLUSTERS" = '41'
      AND "DEVELOPMENT_STAGE" ILIKE '%74-year%'
    GROUP BY "FEATURE_NAME"
)
SELECT
    "FEATURE_NAME",
    avg_female,
    avg_male,
    (avg_female - avg_male) AS diff_female_minus_male
FROM gene_means
WHERE avg_female IS NOT NULL
  AND avg_male   IS NOT NULL
LIMIT 20;
