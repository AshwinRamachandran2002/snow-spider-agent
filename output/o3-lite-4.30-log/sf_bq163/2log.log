```sql
--Description: 6) Average expression for every gene by sex ontology in epithelial cells (no cluster filter, limit 20).
SELECT
    "FEATURE_NAME",
    "SEX_ONTOLOGY_TERM_ID",
    AVG("X_VALUE") AS "avg_xvalue"
FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CELL_TYPE_COARSE" ILIKE 'Epithelial%'
  AND "SEX_ONTOLOGY_TERM_ID" IN ('PATO:0000383', 'PATO:0000384')
GROUP BY "FEATURE_NAME", "SEX_ONTOLOGY_TERM_ID"
LIMIT 20;
```

```sql
--Description: 7) Compute female – male average X_VALUE for each gene across all epithelial cells.
SELECT
    "FEATURE_NAME",
    AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000383' THEN "X_VALUE" END) AS "avg_female",
    AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000384' THEN "X_VALUE" END) AS "avg_male",
    AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000383' THEN "X_VALUE" END)
      - AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000384' THEN "X_VALUE" END) AS "female_minus_male"
FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CELL_TYPE_COARSE" ILIKE 'Epithelial%'
  AND "SEX_ONTOLOGY_TERM_ID" IN ('PATO:0000383', 'PATO:0000384')
GROUP BY "FEATURE_NAME"
LIMIT 20;
```

```sql
--Description: 8) Same as #7 but include only genes measured in ≥100 epithelial‑cell rows.
SELECT
    "FEATURE_NAME",
    COUNT(*) AS "cell_count",
    AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000383' THEN "X_VALUE" END) AS "avg_female",
    AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000384' THEN "X_VALUE" END) AS "avg_male",
    AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000383' THEN "X_VALUE" END)
      - AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000384' THEN "X_VALUE" END) AS "female_minus_male"
FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CELL_TYPE_COARSE" ILIKE 'Epithelial%'
  AND "SEX_ONTOLOGY_TERM_ID" IN ('PATO:0000383', 'PATO:0000384')
GROUP BY "FEATURE_NAME"
HAVING COUNT(*) >= 100
LIMIT 20;
```

```sql
--Description: 9) Rank genes by absolute female – male difference in epithelial cells.
SELECT
