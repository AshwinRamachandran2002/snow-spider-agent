  AND "DEVELOPMENT_STAGE_ONTOLOGY_TERM_ID" = 'HsapDv:0000xxx'   --replace with 74‑year‑old code
GROUP BY "FEATURE_NAME"
ORDER BY "female_minus_male" DESC
LIMIT 20;
```

