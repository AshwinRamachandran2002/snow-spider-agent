    AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000383' THEN "X_VALUE" END) AS "avg_female",
    AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000384' THEN "X_VALUE" END) AS "avg_male",
    AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000383' THEN "X_VALUE" END)
      - AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000384' THEN "X_VALUE" END) AS "female_minus_male"
FROM "HTAN_2"."HTAN"."SCRNASEQ_MSK_SCLC_COMBINED_SAMPLES_CURRENT"
WHERE "CELL_TYPE_COARSE" ILIKE 'Epithelial%'
  AND "SEX_ONTOLOGY_TERM_ID" IN ('PATO:0000383', 'PATO:0000384')
GROUP BY "FEATURE_NAME"
ORDER BY ABS(
         AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000383' THEN "X_VALUE" END)
       - AVG(CASE WHEN "SEX_ONTOLOGY_TERM_ID" = 'PATO:0000384' THEN "X_VALUE" END)
       ) DESC
LIMIT 20;
