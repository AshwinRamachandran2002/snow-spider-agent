```sql
WITH france_customers AS (
    SELECT cu."cust_id"
    FROM "customers" cu
    JOIN "countries" co ON co."country_id" = cu."country_id"
    WHERE co."country_name" = 'France'
),
sales_filtered AS (
    SELECT s."amount_sold",
           s."time_id"
    FROM "sales" s
    JOIN france_customers fc       ON fc."cust_id" = s."cust_id"
    JOIN "channels" ch             ON ch."channel_id" = s."channel_id"
                                   AND ch."channel_total_id" = 1
    JOIN "promotions" pr           ON pr."promo_id"   = s."promo_id"
                                   AND pr."promo_total_id"  = 1
),
monthly_avg AS (
    SELECT t."calendar_year"        AS year,
           t."calendar_month_number" AS month,
           AVG(s."amount_sold")      AS avg_sales
    FROM sales_filtered s
    JOIN "times" t ON t."time_id" = s."time_id"
    WHERE t."calendar_year" IN (2019, 2020)
    GROUP BY t."calendar_year",
             t."calendar_month_number"
),
growth AS (
    SELECT m20.month,
           m19.avg_sales                       AS avg_2019,
           m20.avg_sales                       AS avg_2020,
           CASE WHEN m19.avg_sales = 0 THEN NULL
                ELSE m20.avg_sales * 1.0 / m19.avg_sales
           END                                  AS growth_rate
    FROM (SELECT * FROM monthly_avg WHERE year = 2020) m20
    JOIN (SELECT * FROM monthly_avg WHERE year = 2019) m19
      ON m20.month = m19.month
),
projected_2021 AS (
    SELECT month,
           avg_2020 * growth_rate AS projected_avg_sales
    FROM growth
),
projected_sales_usd AS (
    SELECT p.month,
           p.projected_avg_sales * COALESCE(cu."to_us", 1.0) AS projected_avg_sales_usd
    FROM projected_2021 p
    LEFT JOIN "currency" cu
           ON cu."country" = 'France'
          AND cu."year"    = 2021
          AND cu."month"   = p.month
),
ranked AS (
    SELECT projected_avg_sales_usd,
           ROW_NUMBER() OVER (ORDER BY projected_avg_sales_usd) AS rn,
           COUNT(*)  OVER ()                                    AS cnt
    FROM projected_sales_usd
),
middle AS (
    SELECT projected_avg_sales_usd
    FROM ranked
    WHERE rn = (cnt + 1) / 2
       OR rn = (cnt + 2) / 2
)
SELECT ROUND(AVG(projected_avg_sales_usd), 4) AS median_projected_monthly_sales_usd
FROM middle;
```
