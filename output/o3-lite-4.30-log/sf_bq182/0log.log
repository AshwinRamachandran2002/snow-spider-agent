    WHERE  f.value:"name" IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (PARTITION BY l."repo_name"
                               ORDER BY f.value:"bytes"::NUMBER DESC) = 1
)
SELECT
       pl.primary_language,
       COUNT(*) AS total_pr_events
FROM   pr_events      pe
JOIN   primary_lang   pl
  ON   pe.repo_name = pl.repo_name
GROUP  BY pl.primary_language
