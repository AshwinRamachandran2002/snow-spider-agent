```sql
--Description:  For each repository, determine its primary language—the language object
--              with the highest byte count—in GITHUB_REPOS.LANGUAGES.  The VARIANT
--              column “language” is an array of objects such as
--              {"name":"Ruby","bytes":4036}.  We flatten the array, pull out "name"
--              and "bytes", rank each language per repo by byte count, keep the top
--              one (ROW_NUMBER = 1), and preview 20 results to verify structure.
WITH lang_flat AS (
    SELECT
        l."repo_name",
        f.value:"name"::STRING  AS language,
        f.value:"bytes"::NUMBER AS bytes
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
           LATERAL FLATTEN(input => l."language") f
    WHERE  f.value:"name" IS NOT NULL
)
SELECT
       repo_name,
       language        AS primary_language,
       bytes           AS primary_language_bytes
FROM   (
    SELECT
        repo_name,
        language,
        bytes,
        ROW_NUMBER() OVER (PARTITION BY repo_name ORDER BY bytes DESC) AS rn
    FROM   lang_flat
) ranked
WHERE  rn = 1
LIMIT 20;
```
