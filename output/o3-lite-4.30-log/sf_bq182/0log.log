--Description:  Find the “primary” programming languages—defined as the language
--              with the highest byte count for each repository—that accumulate at
--              least 100 PullRequestEvent records on 18‑Jan‑2023 (UTC).  
--              • pr_events CTE pulls all PR events that day, using TRY_CAST to turn
--                non‑string values in repo:name into NULL (avoids cast errors).  
--              • primary_lang CTE flattens GITHUB_REPOS.LANGUAGES and keeps only the
--                language with the greatest byte total per repository.  
--              • Final step joins the two CTEs, groups by language, and filters to
--                those languages whose combined PR‑event count is ≥100.  
WITH pr_events AS (
    SELECT
        TRY_CAST("repo":"name" AS STRING) AS repo_name
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE  "type" = 'PullRequestEvent'
      AND  "created_at" BETWEEN 1674000000000000 AND 1674086399999999   -- 2023‑01‑18
      AND  TRY_CAST("repo":"name" AS STRING) IS NOT NULL
), primary_lang AS (
    SELECT
        l."repo_name",
        f.key::STRING   AS primary_language,
        f.value::NUMBER AS bytes
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
           LATERAL FLATTEN(input => l."language") f
    QUALIFY ROW_NUMBER() OVER (PARTITION BY l."repo_name"
                               ORDER BY f.value::NUMBER DESC) = 1
)
SELECT
       pl.primary_language,
       COUNT(*) AS total_pr_events
FROM   pr_events     pe
JOIN   primary_lang  pl  ON pe.repo_name = pl.repo_name
GROUP  BY pl.primary_language
HAVING COUNT(*) >= 100
ORDER  BY total_pr_events DESC;
