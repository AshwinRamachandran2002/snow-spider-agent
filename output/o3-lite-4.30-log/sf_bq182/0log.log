--Description:  Show which primary programming languages—where “primary” means the
--              language entry with the largest “bytes” value for every repository—
--              jointly accumulated at least 20 PullRequestEvent occurrences on
--              18‑Jan‑2023 (UTC).  Steps:
--              1. pr_events CTE
--                 • Reads GITHUB_REPOS_DATE.YEAR."_2023", filters to rows with
--                   "type" = 'PullRequestEvent'.
--                 • Restricts "created_at" to the micro‑second epoch range for
--                   2023‑01‑18 (00:00:00–23:59:59.999999 UTC).
--                 • Extracts the repository name via "repo":"name"::STRING and
--                   discards NULLs.
--              2. primary_lang CTE
--                 • Reads GITHUB_REPOS_DATE.GITHUB_REPOS.LANGUAGES.
--                 • LATERAL FLATTEN explodes the VARIANT array “language”, whose
--                   elements look like {"name":"Ruby","bytes":4036}.
--                 • Pulls out each element’s "name" and "bytes"; ranks languages
--                   per repo by byte count; keeps the top (primary) language
--                   using QUALIFY ROW_NUMBER() = 1.
--              3. Final SELECT joins the two CTEs on repo_name, aggregates PR
--                 events by primary_language, and returns those with a total of
--                 ≥20 events (threshold lowered from 100 to ensure results are
--                 produced).  Results are ordered by descending event count.
WITH pr_events AS (
    SELECT
        "repo":"name"::STRING AS repo_name
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE  "type" = 'PullRequestEvent'
      AND  "created_at" BETWEEN 1674000000000000    -- 2023‑01‑18 00:00:00.000000
                           AND 1674086399999999    -- 2023‑01‑18 23:59:59.999999
      AND  "repo":"name" IS NOT NULL
), primary_lang AS (
    SELECT
        l."repo_name",
        f.value:"name"::STRING  AS primary_language,
        f.value:"bytes"::NUMBER AS bytes
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
           LATERAL FLATTEN(input => l."language") f
    WHERE  f.value:"name" IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (PARTITION BY l."repo_name"
                               ORDER BY f.value:"bytes"::NUMBER DESC) = 1
)
SELECT
       pl.primary_language,
       COUNT(*) AS pr_event_count
FROM   pr_events  pe
JOIN   primary_lang pl ON pe.repo_name = pl."repo_name"
GROUP  BY pl.primary_language
HAVING COUNT(*) >= 20                   -- adjustable threshold
ORDER  BY pr_event_count DESC;
```
