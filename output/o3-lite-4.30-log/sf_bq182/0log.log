```

```sql
-- 8) Identify each repository’s primary language (highest bytes)
SELECT l."repo_name",
       f.key::STRING   AS "primary_language",
       f.value::NUMBER AS "lang_bytes"
FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
     LATERAL FLATTEN(input => l."language") f
QUALIFY ROW_NUMBER() OVER (PARTITION BY l."repo_name" 
                           ORDER BY f.value::NUMBER DESC) = 1
LIMIT 20;
```

```sql
-- 9) Join primary language to repos with >=100 PR events on 18‑Jan‑2023
WITH pr AS (
    SELECT "repo":"name"::STRING AS "repo_name",
           COUNT(*)              AS "pr_events"
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE "type" = 'PullRequestEvent'
      AND "created_at" BETWEEN 1674000000000000 AND 1674086399999999
    GROUP BY "repo_name"
    HAVING COUNT(*) >= 100
)
SELECT pr."repo_name",
       pl."primary_language",
       pr."pr_events"
FROM pr
JOIN (
    SELECT l."repo_name",
           f.key::STRING   AS "primary_language",
           f.value::NUMBER AS "lang_bytes"
    FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
         LATERAL FLATTEN(input => l."language") f
    QUALIFY ROW_NUMBER() OVER (PARTITION BY l."repo_name"
                               ORDER BY f.value::NUMBER DESC) = 1
) pl
  ON pr."repo_name" = pl."repo_name"
LIMIT 20;
```

```sql
-- 10) Aggregate to find languages that have ≥100 PR events across all their repos on 18‑Jan‑2023
WITH pr AS (
    SELECT "repo":"name"::STRING AS "repo_name"
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE "type" = 'PullRequestEvent'
      AND "created_at" BETWEEN 1674000000000000 AND 1674086399999999
), primary_lang AS (
    SELECT l."repo_name",
           f.key::STRING   AS "primary_language",
           f.value::NUMBER AS "lang_bytes"
    FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
         LATERAL FLATTEN(input => l."language") f
    QUALIFY ROW_NUMBER() OVER (PARTITION BY l."repo_name"
                               ORDER BY f.value::NUMBER DESC) = 1
)
SELECT pl."primary_language",
       COUNT(*) AS "total_pr_events"
FROM pr
JOIN primary_lang pl USING ("repo_name")
GROUP BY pl."primary_language"
HAVING COUNT(*) >= 100
ORDER BY "total_pr_events" DESC
LIMIT 20;
```

