Begin Exploring Related Columns
Relevant columns and their potential usage  
• GITHUB_REPOS_DATE.YEAR."_2023"."type": filter only Pull‑Request events (value = 'PullRequestEvent').  
• GITHUB_REPOS_DATE.YEAR."_2023"."created_at": restrict the time window to the calendar day 2023‑01‑18 (micro‑seconds since epoch).  
• GITHUB_REPOS_DATE.YEAR."_2023"."repo": take the field "name" in this VARIANT to obtain the repository name for joining.  
• GITHUB_REPOS_DATE.GITHUB_REPOS.LANGUAGES."repo_name": join key that matches the value extracted above.  
• GITHUB_REPOS_DATE.GITHUB_REPOS.LANGUAGES."language": JSON / VARIANT holding {language‑name: bytes}.  Flatten it to reach individual language‑byte pairs, and pick the language with the maximum bytes so it becomes the repository’s primary language.  

Typical conditions that will be used  
• "type" = 'PullRequestEvent'  
• "created_at" BETWEEN 1674000000000000 AND 1674086399999999      -- micro‑sec range for 2023‑01‑18 UTC (adjust if needed)  
• HAVING COUNT(*) ≥ 100                                           -- at least 100 pull‑request events  
• QUALIFY ROW_NUMBER() OVER (PARTITION BY "repo_name" ORDER BY bytes DESC) = 1   -- keep only the primary language per repo  

Below are ten exploratory Snowflake SQL statements (20‑row caps) that gradually build up the logic.  All identifiers are enclosed in double quotes.  

```sql
-- 1) Peek at the 2023 event structure
SELECT *
FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
LIMIT 20;
```

```sql
-- 2) Only PullRequestEvent rows
SELECT "type",
       "created_at",
       "repo",
       "payload"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
WHERE "type" = 'PullRequestEvent'
LIMIT 20;
```

```sql
-- 3) Pull‑requests that happened on 18‑Jan‑2023 (micro‑second epoch window)
SELECT "type",
       "created_at",
       "repo":"name"::STRING           AS "repo_name"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
WHERE "type" = 'PullRequestEvent'
  AND "created_at" BETWEEN 1674000000000000 AND 1674086399999999
LIMIT 20;
```

```sql
-- 4) Count pull‑request events per repository for 2023‑01‑18
SELECT "repo":"name"::STRING AS "repo_name",
       COUNT(*)              AS "pr_events_20230118"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
WHERE "type" = 'PullRequestEvent'
  AND "created_at" BETWEEN 1674000000000000 AND 1674086399999999
GROUP BY "repo_name"
ORDER BY "pr_events_20230118" DESC
LIMIT 20;
```

```sql
-- 5) Keep repos with >= 100 pull‑request events on that day
SELECT "repo":"name"::STRING AS "repo_name",
       COUNT(*)              AS "pr_events_20230118"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
WHERE "type" = 'PullRequestEvent'
  AND "created_at" BETWEEN 1674000000000000 AND 1674086399999999
GROUP BY "repo_name"
HAVING COUNT(*) >= 100
ORDER BY "pr_events_20230118" DESC
LIMIT 20;
```

```sql
-- 6) Inspect the LANGUAGES table structure
SELECT *
FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES"
LIMIT 20;
```

```sql
-- 7) Flatten language / byte pairs for a sample of repositories
SELECT l."repo_name",
       f.key::STRING  AS "language",
       f.value::NUMBER AS "bytes"
FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
     LATERAL FLATTEN(input => l."language") f
LIMIT 20;
```

```sql
-- 8) Identify each repository’s primary language (highest bytes)
SELECT l."repo_name",
       f.key::STRING   AS "primary_language",
       f.value::NUMBER AS "lang_bytes"
FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
     LATERAL FLATTEN(input => l."language") f
QUALIFY ROW_NUMBER() OVER (PARTITION BY l."repo_name" 
                           ORDER BY f.value::NUMBER DESC) = 1
LIMIT 20;
```

```sql
-- 9) Join primary language to repos with >=100 PR events on 18‑Jan‑2023
WITH pr AS (
    SELECT "repo":"name"::STRING AS "repo_name",
           COUNT(*)              AS "pr_events"
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE "type" = 'PullRequestEvent'
      AND "created_at" BETWEEN 1674000000000000 AND 1674086399999999
    GROUP BY "repo_name"
    HAVING COUNT(*) >= 100
)
SELECT pr."repo_name",
       pl."primary_language",
       pr."pr_events"
FROM pr
JOIN (
    SELECT l."repo_name",
           f.key::STRING   AS "primary_language",
           f.value::NUMBER AS "lang_bytes"
    FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
         LATERAL FLATTEN(input => l."language") f
    QUALIFY ROW_NUMBER() OVER (PARTITION BY l."repo_name"
                               ORDER BY f.value::NUMBER DESC) = 1
) pl
  ON pr."repo_name" = pl."repo_name"
LIMIT 20;
```

```sql
-- 10) Aggregate to find languages that have ≥100 PR events across all their repos on 18‑Jan‑2023
WITH pr AS (
    SELECT "repo":"name"::STRING AS "repo_name"
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE "type" = 'PullRequestEvent'
      AND "created_at" BETWEEN 1674000000000000 AND 1674086399999999
), primary_lang AS (
    SELECT l."repo_name",
           f.key::STRING   AS "primary_language",
           f.value::NUMBER AS "lang_bytes"
    FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
         LATERAL FLATTEN(input => l."language") f
    QUALIFY ROW_NUMBER() OVER (PARTITION BY l."repo_name"
                               ORDER BY f.value::NUMBER DESC) = 1
)
SELECT pl."primary_language",
       COUNT(*) AS "total_pr_events"
FROM pr
JOIN primary_lang pl USING ("repo_name")
GROUP BY pl."primary_language"
HAVING COUNT(*) >= 100
ORDER BY "total_pr_events" DESC
LIMIT 20;
```

These queries step from exploring the raw event data to deriving the primary language per repository and finally to counting languages whose repositories collectively generated at least 100 pull‑request events on 18‑Jan‑2023.
