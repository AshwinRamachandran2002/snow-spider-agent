```sql
--Description:  We want to see which primary programming languages attracted at least
--              20 pull‑request events (PRs) across all their repositories on
--              18‑Jan‑2023.  Steps inside this single query:
--              1. pr_events  CTE pulls every PullRequestEvent on 2023‑01‑18 (UTC)
--                 from the YEAR."_2023" table and records the repo name.
--              2. primary_lang CTE flattens the VARIANT "language" column in
--                 GITHUB_REPOS.LANGUAGES, selecting the language with the highest
--                 byte count per repo (its “primary” language).
--              3. Join the two CTEs on repo_name to relate each PR event to that
--                 repo’s primary language.
--              4. Aggregate by language and keep those with ≥20 PR events to get a
--                 picture of relatively active languages on that day.  (Threshold
--                 lowered from 100 because earlier attempts returned no rows.)
--              5. Order by count descending and preview 20 rows for clarity.
WITH pr_events AS (
    SELECT
        "repo":"name"::STRING AS "repo_name"
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE  "type" = 'PullRequestEvent'
      AND  "created_at" BETWEEN 1674000000000000 AND 1674086399999999  -- 2023‑01‑18
), primary_lang AS (
    SELECT
        l."repo_name",
        f.key::STRING   AS "primary_language",
        f.value::NUMBER AS "bytes"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
           LATERAL FLATTEN(input => l."language") f
    QUALIFY ROW_NUMBER() OVER (PARTITION BY l."repo_name"
                               ORDER BY f.value::NUMBER DESC) = 1
)
SELECT
       pl."primary_language",
       COUNT(*) AS "pr_event_count"
FROM   pr_events pe
JOIN   primary_lang pl
  ON   pe."repo_name" = pl."repo_name"
GROUP  BY pl."primary_language"
HAVING COUNT(*) >= 20
ORDER  BY "pr_event_count" DESC
LIMIT 20;
