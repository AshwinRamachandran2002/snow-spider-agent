--Description:  Determine which primary programming languages—defined as the language
--              with the largest “bytes” value for each repository—collectively recorded
--              at least 100 PullRequestEvent occurrences on 18‑Jan‑2023 (UTC).
--              • pr_events CTE pulls every PullRequestEvent that day, extracting the
--                repository name from the VARIANT column "repo".  Repos whose name is
--                NULL are discarded.
--              • primary_lang CTE flattens the JSON array in GITHUB_REPOS.LANGUAGES,
--                ranks the array objects by their "bytes" field for each repo, and keeps
--                only the object with the highest byte count (the repo’s primary language).
--              • The final SELECT joins both CTEs, aggregates PR‑event counts per
--                primary language, and returns languages whose repositories in total
--                generated at least 100 PR events on that date.
WITH pr_events AS (
    SELECT
        "repo":"name"::STRING AS repo_name
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE  "type" = 'PullRequestEvent'
      AND  "created_at" BETWEEN 1674000000000000 AND 1674086399999999   -- 2023‑01‑18 UTC
      AND  "repo":"name" IS NOT NULL
), primary_lang AS (
    SELECT
        l.repo_name,
        f.value:"name"::STRING  AS primary_language,
        f.value:"bytes"::NUMBER AS bytes
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
           LATERAL FLATTEN(input => l.language) f
    WHERE  f.value:"name" IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (PARTITION BY l.repo_name
                               ORDER BY f.value:"bytes"::NUMBER DESC) = 1
)
SELECT
       pl.primary_language,
       COUNT(*) AS total_pr_events
FROM   pr_events pe
JOIN   primary_lang pl
  ON   pe.repo_name = pl.repo_name
GROUP  BY pl.primary_language
HAVING COUNT(*) >= 100
ORDER  BY total_pr_events DESC;
