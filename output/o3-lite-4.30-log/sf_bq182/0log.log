--                whose micro‑second epoch timestamp falls inside 2023‑01‑18 and
--                extracts the repository name (repo_name) from the VARIANT "repo".
--              • primary_lang CTE ─ Reads GITHUB_REPOS.LANGUAGES, flattens the JSON
--                array in column "language", pulls the "name" and "bytes" fields
--                from each element, ranks them by bytes per repo, and retains the
--                largest‑byte (primary) language for each repository.
--              • The main query joins both CTEs on repo_name, aggregates the PR
--                events per primary language, and returns languages whose total
--                event count reaches or exceeds 100.
WITH pr_events AS (
    SELECT
        "repo":"name"::STRING AS repo_name
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE  "type" = 'PullRequestEvent'
      AND  "created_at" BETWEEN 1674000000000000    -- 2023‑01‑18 00:00:00.000000 UTC
