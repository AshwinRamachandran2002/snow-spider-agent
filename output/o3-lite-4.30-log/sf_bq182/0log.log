--Description: Identify primary programming languages whose repositories accumulated
--             at least 100 PullRequestEvent records on 18‑Jan‑2023 (UTC).
--             • pr_events CTE: pulls all PR events that day from YEAR."_2023",
--               extracting the repository name with TRY_TO_VARCHAR to avoid
--               cast errors on non‑string VARIANTs.
--             • primary_lang CTE: flattens GITHUB_REPOS.LANGUAGES, retaining the
--               language with the highest byte count per repository (ROW_NUMBER = 1).
--             • Final SELECT joins the two CTEs, aggregates PR events by language,
--               and returns languages meeting the ≥100‑event threshold.
WITH pr_events AS (
    SELECT
        TRY_TO_VARCHAR("repo":"name") AS repo_name
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE  "type" = 'PullRequestEvent'
      AND  "created_at" BETWEEN 1674000000000000 AND 1674086399999999   -- 2023‑01‑18 UTC
      AND  TRY_TO_VARCHAR("repo":"name") IS NOT NULL
),
primary_lang AS (
    SELECT
        l."repo_name",
        f.key::STRING   AS primary_language,
        f.value::NUMBER AS bytes
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
           LATERAL FLATTEN(input => l."language") f
    QUALIFY ROW_NUMBER() OVER (PARTITION BY l."repo_name"
                               ORDER BY f.value::NUMBER DESC) = 1
)
SELECT
       pl.primary_language,
       COUNT(*) AS total_pr_events
FROM   pr_events      pe
JOIN   primary_lang   pl  ON pe.repo_name = pl.repo_name
GROUP  BY pl.primary_language
HAVING COUNT(*) >= 100
ORDER  BY total_pr_events DESC;
