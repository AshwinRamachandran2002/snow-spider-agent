```sql
WITH pr_events AS (          -- all pull‑request events on 18‑Jan‑2023 (UTC)
    SELECT
        "repo":"name"::STRING AS "repo_name"
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE "type" = 'PullRequestEvent'
      AND "created_at" BETWEEN 1674000000000000 AND 1674086399999999          -- 2023‑01‑18 UTC
),
primary_language AS (        -- primary language per repository (largest byte count)
    SELECT
        l."repo_name",
        f.value:"name"::STRING  AS "language",
        ROW_NUMBER() OVER (PARTITION BY l."repo_name"
                           ORDER BY f.value:"bytes"::NUMBER DESC NULLS LAST) AS "rn"
    FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
         LATERAL FLATTEN(input => l."language") f
)
SELECT
    pl."language"
FROM pr_events          pe
JOIN primary_language   pl
  ON pe."repo_name" = pl."repo_name"
 WHERE pl."rn" = 1                       -- keep only the primary language of each repo
GROUP BY pl."language"
HAVING COUNT(*) >= 100                   -- at least 100 PR events across all repos
ORDER BY pl."language";
```
