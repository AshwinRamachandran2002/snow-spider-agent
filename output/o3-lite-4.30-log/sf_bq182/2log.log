--             primary language received that day; return those with ≥100 events.
WITH pr AS (                                   -- Pull‑request events on 2023‑01‑18
    SELECT
        "repo":"name"::STRING AS "repo_name"
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE "type" = 'PullRequestEvent'
      AND "created_at" BETWEEN 1674000000000000  -- 2023‑01‑18 00:00:00 UTC in µs
