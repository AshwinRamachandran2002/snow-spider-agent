SELECT *
FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
LIMIT 20;
```

```sql
-- 2. Description: inspect only the key columns we care about (event type, created_at, repo)
SELECT "type",
       "created_at",
       "repo"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
LIMIT 20;
```

```sql
-- 3. Description: list distinct event "type" values that occur in 2023 data
SELECT DISTINCT "type"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
LIMIT 20;
```

```sql
-- 4. Description: sample 20 PullRequestEvent rows so we can observe the numeric range of "created_at"
SELECT "created_at",
       "repo"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
WHERE "type" = 'PullRequestEvent'
ORDER BY "created_at"                -- earliest first
LIMIT 20;
```

```sql
-- 5. Description: pull out the repo name from the VARIANT column for a few PR events
SELECT pr."created_at",
       pr."repo":"name"::STRING  AS "repo_name"
FROM   "GITHUB_REPOS_DATE"."YEAR"."_2023" pr
WHERE  pr."type" = 'PullRequestEvent'
LIMIT 20;
```

```sql
-- 6. Description: glance at the LANGUAGES table to see its raw structure
SELECT *
FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES"
LIMIT 20;
```

```sql
-- 7. Description: for one repo, expand (flatten) its language‑bytes map to see the byte counts
SELECT lg."repo_name",
       f.key::STRING     AS "language",
       f.value::NUMBER   AS "bytes"
FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" lg,
       LATERAL FLATTEN(INPUT => lg."language") f
WHERE  lg."repo_name" ILIKE '%linux%'         -- fuzzy pick one repo
LIMIT 20;
```

```sql
-- 8. Description: derive the PRIMARY language (max bytes) for every repository
WITH lang_flat AS (
    SELECT lg."repo_name",
           f.key::STRING     AS "language",
           f.value::NUMBER   AS "bytes"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" lg,
           LATERAL FLATTEN(INPUT => lg."language") f
)
SELECT lf."repo_name",
       lf."language"      AS "primary_language"
FROM   (
        SELECT "repo_name",
               "language",
               ROW_NUMBER() OVER (PARTITION BY "repo_name"
                                  ORDER BY "bytes" DESC) AS rn
        FROM   lang_flat
) lf
WHERE  lf.rn = 1
LIMIT 20;
```

```sql
-- 9. Description: join PullRequestEvents on 2023‑01‑18 with the primary language per repo; sample rows
WITH pr AS (
    SELECT "created_at",
           "repo":"name"::STRING AS "repo_name"
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE  "type" = 'PullRequestEvent'
      AND  "created_at" BETWEEN 1674000000000 AND 1674086399000   -- adjust once you inspect actual range for 2023‑01‑18
),
lang_primary AS (
    /* reuse CTE from previous step */
    WITH lang_flat AS (
        SELECT lg."repo_name",
               f.key::STRING   AS "language",
               f.value::NUMBER AS "bytes"
        FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" lg,
               LATERAL FLATTEN(INPUT => lg."language") f
    )
    SELECT lf."repo_name",
           lf."language"
    FROM   (
        SELECT "repo_name",
               "language",
               ROW_NUMBER() OVER (PARTITION BY "repo_name"
                                  ORDER BY "bytes" DESC) AS rn
        FROM   lang_flat
    ) lf
    WHERE  lf.rn = 1
)
SELECT pr."repo_name",
       lp."language"
FROM   pr
JOIN   lang_primary lp
  ON   pr."repo_name" = lp."repo_name"
LIMIT 20;
```

```sql
-- 10. Description: aggregate to find languages that reached at least 100 PR events on 2023‑01‑18
WITH pr AS (
    SELECT "repo":"name"::STRING AS "repo_name"
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2023"
    WHERE  "type" = 'PullRequestEvent'
      AND  "created_at" BETWEEN 1674000000000 AND 1674086399000        -- 2023‑01‑18
),
lang_primary AS (
    WITH lang_flat AS (
        SELECT lg."repo_name",
               f.key::STRING   AS "language",
               f.value::NUMBER AS "bytes"
        FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" lg,
               LATERAL FLATTEN(INPUT => lg."language") f
    )
    SELECT "repo_name",
           FIRST_VALUE("language") OVER (PARTITION BY "repo_name"
                                         ORDER BY "bytes" DESC) AS "primary_language"
    FROM   lang_flat
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "repo_name"
                               ORDER BY "bytes" DESC) = 1
)
SELECT lp."primary_language",
       COUNT(*) AS "pull_request_events"
FROM   pr
JOIN   lang_primary lp
  ON   pr."repo_name" = lp."repo_name"
GROUP  BY lp."primary_language"
HAVING COUNT(*) >= 100
ORDER  BY "pull_request_events" DESC
LIMIT 20;
```


These progressively reveal what’s inside each column, demonstrate how to extract / flatten JSON, and finally show how you could answer the main question.
