```sql
--Description:  Derive the primary programming language (the language with the greatest
--byte count in each repository) and then list those languages whose repositories
--accumulated at least 100 PullRequestEvents on 18‑Jan‑2023 (UTC).
--Steps inside this single query:
-- 1️⃣ day_events CTE – filter YEAR."_2023" to PullRequestEvent rows whose "created_at"
--    micro‑second epoch value lies between 00:00:00 and 23:59:59.999999 on
--    2023‑01‑18, extract the repo’s full name ( "repo":name ) and count events
--    per repo.
-- 2️⃣ lang_expanded CTE – explode each repo’s language array from LANGUAGES into
--    individual rows, pulling out "name" and "bytes" fields; safely cast bytes
--    to INT (missing bytes default to 0).
-- 3️⃣ primary_lang CTE – keep, for every repo, the single language with the highest
--    byte count (ROW_NUMBER ordered by bytes DESC).
-- 4️⃣ Final SELECT – join day_events with primary_lang, sum PullRequestEvents by
--    language, and keep languages reaching the 100‑event threshold.
WITH day_events AS (
    SELECT
        t."repo":name::STRING AS repo_name,
        COUNT(*)              AS pr_events
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2023" t
    WHERE t."type" = 'PullRequestEvent'
      AND t."created_at" BETWEEN 1674000000000000      -- 2023‑01‑18 00:00:00 UTC
                           AND 1674086399999999        -- 2023‑01‑18 23:59:59.999999 UTC
    GROUP BY 1
),
lang_expanded AS (
    SELECT
        l."repo_name",
        f.value:"name"::STRING            AS language,
        COALESCE(f.value:"bytes", 0)::INT AS bytes
    FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
         LATERAL FLATTEN(input => l."language") f
),
primary_lang AS (
    SELECT
        repo_name,
        language
    FROM (
        SELECT
            repo_name,
            language,
            ROW_NUMBER() OVER (PARTITION BY repo_name ORDER BY bytes DESC, language) AS rn
        FROM lang_expanded
    )
    WHERE rn = 1
)
SELECT
    pl.language        AS primary_language,
    SUM(de.pr_events)  AS total_pr_events
FROM day_events   de
JOIN primary_lang pl ON de.repo_name = pl.repo_name
GROUP BY 1
HAVING SUM(de.pr_events) >= 100
ORDER BY total_pr_events DESC;
```
