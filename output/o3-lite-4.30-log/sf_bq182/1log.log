```sql
--Description: Determine which primary languages (largest‑byte language per repo)
--had ≥ 100 PullRequestEvents on 2023‑01‑18.
--Thought process inside comments:
-- 1) Filter YEAR."_2023" to PullRequestEvent rows whose "created_at" falls on 2023‑01‑18.
--    "created_at" is in microseconds since epoch; the chosen range is
--    1674000000000000 (00:00:00 UTC) to 1674086399000000 (23:59:59 UTC).
--    Extract the repo’s name via "repo":name (object field access), then count events per repo.
-- 2) From LANGUAGES, FLATTEN each repo’s language map, sort by byte count, and
--    pick the first language (max bytes) per repo to label its primary language.
-- 3) Join the two CTEs on repo_name, sum PR events per language, and keep only
--    languages whose combined PR‑event count is at least 100.
WITH day_events AS (  -- step 1
    SELECT
        t."repo":name::STRING                   AS repo_name,
        COUNT(*)                                AS pr_events
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2023" t
    WHERE t."type" = 'PullRequestEvent'
      AND t."created_at" BETWEEN 1674000000000000  -- 2023‑01‑18 start (µs)
                           AND 1674086399000000    -- 2023‑01‑18 end   (µs)
    GROUP BY 1
),
primary_lang AS (  -- step 2
    SELECT
        l."repo_name",
        FIRST_VALUE(f.key)
          OVER (PARTITION BY l."repo_name" ORDER BY f.value::INT DESC) AS primary_language
    FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
         LATERAL FLATTEN(input => l."language") f
)
-- step 3: final aggregation
SELECT
    pl.primary_language,
    SUM(de.pr_events) AS total_pr_events
FROM day_events   de
JOIN primary_lang pl ON de.repo_name = pl."repo_name"
GROUP BY 1
HAVING SUM(de.pr_events) >= 100
ORDER BY total_pr_events DESC;
