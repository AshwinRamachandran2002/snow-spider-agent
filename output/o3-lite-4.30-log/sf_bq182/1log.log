Query:
--Description: 🔟 Combine PullRequestEvents from 2023‑01‑18 with primary languages.
--Fixes applied: extract repo name directly via "repo":name instead of FLATTENing the object,
--and use correct field extraction inside the LANGUAGES FLATTEN.
WITH day_events AS (                       -- PR‑event counts per repo on 18‑Jan‑2023
    SELECT
        t."repo":name::STRING AS repo_name,
        COUNT(*)              AS pr_events
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2023" t
    WHERE t."type" = 'PullRequestEvent'
      AND t."created_at" BETWEEN 1674000000000000  -- 2023‑01‑18 00:00:00 UTC
                           AND 1674086399000000    -- 2023‑01‑18 23:59:59 UTC
    GROUP BY 1
),
primary_lang AS (                           -- largest‑byte language per repo
    SELECT
        l."repo_name"::STRING               AS repo_name,
        FIRST_VALUE(f.value:"name"::STRING)
          OVER (PARTITION BY l."repo_name"
                ORDER BY f.value:"bytes"::INT DESC) AS primary_language
    FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
         LATERAL FLATTEN(input => l."language") f
)
SELECT
    pl.primary_language,
    SUM(de.pr_events) AS total_pr_events
FROM day_events   de
JOIN primary_lang pl ON de.repo_name = pl.repo_name
GROUP BY 1
HAVING SUM(de.pr_events) >= 100
ORDER BY total_pr_events DESC
LIMIT 20
