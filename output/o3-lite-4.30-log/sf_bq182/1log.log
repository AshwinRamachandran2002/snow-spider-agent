--Description: 9️⃣ Derive each repository’s primary language using the largest “bytes” field
--from LANGUAGES.language (array of {"name","bytes"} objects); use proper field extraction.
WITH primary_lang AS (
    SELECT
        l."repo_name",
        FIRST_VALUE(f.value:"name"::STRING)
          OVER (PARTITION BY l."repo_name"
                ORDER BY f.value:"bytes"::INT DESC) AS primary_language
    FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
         LATERAL FLATTEN(input => l."language") f
)
SELECT DISTINCT *
FROM primary_lang
LIMIT 20
