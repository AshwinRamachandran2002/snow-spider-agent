Begin Exploring Related Columns
Relevant columns and their potential usage  
• GITHUB_REPOS_DATE.YEAR."_2023"  
  – "type": filter rows that are Pull‑Request events.  
  – "created_at": restrict rows to the calendar day 2023‑01‑18 (value is a UNIX epoch in µ‑seconds).  
  – "repo": VARIANT ⇒ repo.value:"name" gives the repository’s full name needed for joins.  

• GITHUB_REPOS_DATE.GITHUB_REPOS."LANGUAGES"  
  – "repo_name": join key to the event’s repo name.  
  – "language": VARIANT in the form {"C":183920, "Python":3912, …}.  
     The language with the highest byte count is the repository’s primary language. We retrieve it with FLATTEN, order by bytes DESC, LIMIT 1.  


Example exploration and solution‑building queries  
(Every query is capped with LIMIT 20 and wrapped in ```sql```; adjust, run, inspect, and iterate.)

```sql
-- 1️⃣ Description: Quick look at the structure of the 2023 events table.
SELECT *
FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
LIMIT 20;
```

```sql
-- 2️⃣ Description: Distinct event types recorded in 2023.
SELECT DISTINCT "type"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
LIMIT 20;
```

```sql
-- 3️⃣ Description: Inspect a few PullRequestEvents to understand the "repo" and "created_at" content.
SELECT "created_at",
       TO_TIMESTAMP("created_at"/1000000) AS "ts_utc",
       "repo"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
WHERE "type" = 'PullRequestEvent'
LIMIT 20;
```

```sql
-- 4️⃣ Description: Verify we can isolate the exact calendar day 2023‑01‑18
-- (00:00:00 UTC to 23:59:59 UTC) by numeric epoch range.
SELECT "created_at",
       TO_TIMESTAMP("created_at"/1000000) AS "ts_utc"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2023"
WHERE "type" = 'PullRequestEvent'
  AND "created_at" BETWEEN 1674000000000000 AND 1674086399000000  -- 2023‑01‑18
LIMIT 20;
```

```sql
-- 5️⃣ Description: Extract repository names from those same events using FLATTEN.
SELECT repo_name_record.value:"name"::STRING     AS "repo_name",
       TO_TIMESTAMP(t."created_at"/1000000)       AS "ts_utc"
FROM   "GITHUB_REPOS_DATE"."YEAR"."_2023"  t,
       LATERAL FLATTEN(input => t."repo") repo_name_record
WHERE  t."type" = 'PullRequestEvent'
  AND  t."created_at" BETWEEN 1674000000000000 AND 1674086399000000
LIMIT 20;
```

```sql
-- 6️⃣ Description: Count PullRequestEvents per repo on 2023‑01‑18.
SELECT repo_name_record.value:"name"::STRING AS "repo_name",
       COUNT(*)                              AS "pr_events"
FROM   "GITHUB_REPOS_DATE"."YEAR"."_2023" t,
       LATERAL FLATTEN(input => t."repo") repo_name_record
WHERE  t."type"      = 'PullRequestEvent'
  AND  t."created_at" BETWEEN 1674000000000000 AND 1674086399000000
GROUP  BY 1
HAVING COUNT(*) >= 1
ORDER  BY 2 DESC
LIMIT 20;
```

```sql
-- 7️⃣ Description: Peek at the shape of the LANGUAGES table.
SELECT *
FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES"
LIMIT 20;
```

```sql
-- 8️⃣ Description: For a sample repo, list all language‑byte pairs.
SELECT  l."repo_name",
        lang_kv.key          AS "language",
        lang_kv.value::INT   AS "bytes"
FROM  "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES"  l,
      LATERAL FLATTEN(input => l."language")          lang_kv
WHERE l."repo_name" ILIKE '%linux%'      -- fuzzy sample
LIMIT 20;
```

```sql
-- 9️⃣ Description: Derive the PRIMARY language (max bytes) for every repository.
WITH primary_lang AS (
    SELECT  l."repo_name",
            FIRST_VALUE(lang_kv.key)  OVER (PARTITION BY l."repo_name"
                                            ORDER BY lang_kv.value::INT DESC) AS "primary_language"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
           LATERAL FLATTEN(input => l."language")         lang_kv
)
SELECT DISTINCT *
FROM primary_lang
LIMIT 20;
```

```sql
-- 🔟 Description: Combine everything – languages with ≥100 PullRequestEvents on 2023‑01‑18.
WITH day_events AS (
     SELECT repo_name_record.value:"name"::STRING AS repo_name,
            COUNT(*)                              AS pr_events
     FROM  "GITHUB_REPOS_DATE"."YEAR"."_2023" t,
           LATERAL FLATTEN(input => t."repo") repo_name_record
     WHERE t."type" = 'PullRequestEvent'
       AND t."created_at" BETWEEN 1674000000000000 AND 1674086399000000
     GROUP BY 1
),
primary_lang AS (
     SELECT l."repo_name",
            FIRST_VALUE(lang_kv.key)
            OVER (PARTITION BY l."repo_name"
                  ORDER BY lang_kv.value::INT DESC) AS primary_language
     FROM  "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
           LATERAL FLATTEN(input => l."language") lang_kv
)
SELECT  pl.primary_language,
        SUM(d.pr_events) AS total_pr_events
FROM    day_events d
JOIN    primary_lang pl
  ON    d.repo_name = pl."repo_name"
GROUP   BY 1
HAVING  SUM(d.pr_events) >= 100
ORDER   BY total_pr_events DESC
LIMIT 20;
```

