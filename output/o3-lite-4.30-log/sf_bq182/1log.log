-- 5️⃣ Description: Extract repository names from those same events using FLATTEN.
SELECT repo_name_record.value:"name"::STRING     AS "repo_name",
       TO_TIMESTAMP(t."created_at"/1000000)       AS "ts_utc"
FROM   "GITHUB_REPOS_DATE"."YEAR"."_2023"  t,
       LATERAL FLATTEN(input => t."repo") repo_name_record
WHERE  t."type" = 'PullRequestEvent'
  AND  t."created_at" BETWEEN 1674000000000000 AND 1674086399000000
LIMIT 20;
