--Description: Retrieve each (language, bytes) pair for repositories whose names contain
--“linux”.  The LANGUAGES.language column is an array of objects such as
--{"name":"C","bytes":12345}.  We FLATTEN that array and, for every element,
--pull out its "name" and "bytes" fields separately; the bytes field is then
--safely cast to INT, preventing the prior object‑to‑INT cast error.
SELECT
    l."repo_name",
    f.value:"name"::STRING  AS language,
    f.value:"bytes"::INT    AS bytes
FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
     LATERAL FLATTEN(input => l."language") f
WHERE l."repo_name" ILIKE '%linux%'
LIMIT 20;
