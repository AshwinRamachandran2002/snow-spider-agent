--Description: Count PullRequestEvents that occurred on 18‑Jan‑2023, map each repository to its
--primary language (the language object with the greatest “bytes” value in LANGUAGES.language),
--and list those languages whose repositories generated at least 100 such events.  
--Steps inside the query:
-- 1️⃣ day_events – filter YEAR."_2023" to PullRequestEvent rows whose micro‑epoch “created_at”
--    lies between 00:00:00 and 23:59:59.999999 UTC on 2023‑01‑18; group by repo name.  
-- 2️⃣ lang_expanded – FLATTEN the array of language objects ({"name","bytes"}) per repo,
--    alias the repository column as repo_name (unquoted to avoid case errors), extract fields,
--    and cast “bytes” to INT.  
-- 3️⃣ primary_lang – choose, per repo, the language with the highest byte count via ROW_NUMBER.  
-- 4️⃣ Final SELECT – join day_events with primary_lang, aggregate PR‑event counts by language,
--    and retain languages whose total count is ≥ 100.
WITH day_events AS (
    SELECT
        t."repo":name::STRING AS repo_name,
        COUNT(*)              AS pr_events
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2023" t
    WHERE t."type" = 'PullRequestEvent'
      AND t."created_at" BETWEEN 1674000000000000      -- 2023‑01‑18 00:00:00 UTC
                           AND 1674086399999999        -- 2023‑01‑18 23:59:59.999999 UTC
    GROUP BY 1
),
lang_expanded AS (
    SELECT
        l."repo_name"::STRING            AS repo_name,      -- keep identifier case‑neutral
        f.value:"name"::STRING           AS language,
        COALESCE(f.value:"bytes",0)::INT AS bytes
    FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LANGUAGES" l,
         LATERAL FLATTEN(input => l."language") f
),
primary_lang AS (
    SELECT repo_name, language
    FROM (
        SELECT
            repo_name,
            language,
            ROW_NUMBER() OVER (PARTITION BY repo_name
                               ORDER BY bytes DESC, language) AS rn
        FROM lang_expanded
    )
    WHERE rn = 1
)
SELECT
    pl.language        AS primary_language,
    SUM(de.pr_events)  AS total_pr_events
FROM day_events   de
JOIN primary_lang pl ON de.repo_name = pl.repo_name
GROUP BY 1
HAVING SUM(de.pr_events) >= 100
ORDER BY total_pr_events DESC;
