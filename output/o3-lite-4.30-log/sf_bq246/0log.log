```sql
--Description:
--We want to count, for every patent (“patent_id”), the number of backward
--citations whose cited patent was applied for within the 365 days that
--precede the citing patent’s own application date.  Some APPLICATION rows
--contain malformed dates such as “1968‑05‑00”; using TRY_TO_DATE() instead
--of TO_DATE() converts those to NULL and prevents errors.  We therefore:
--  • join USPATENTCITATION to two aliases of APPLICATION (acurr = citing
--    patent, acited = cited patent);
--  • filter out any records where either converted date is NULL;
--  • keep only those citation pairs where the cited application date is
--    0–365 days earlier than the citing application date;
--  • count such citations per citing patent.
--The LIMIT clause merely shows the first 20 rows for a quick check.

SELECT  bc."patent_id",
        COUNT(*) AS "back_last_1yr"
FROM    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION   bc
JOIN    PATENTSVIEW.PATENTSVIEW.APPLICATION        acurr
        ON bc."patent_id"   = acurr."patent_id"
JOIN    PATENTSVIEW.PATENTSVIEW.APPLICATION        acited
        ON bc."citation_id" = acited."patent_id"
WHERE   TRY_TO_DATE(acurr."date")  IS NOT NULL
  AND   TRY_TO_DATE(acited."date") IS NOT NULL
  AND   DATEDIFF('day',
                 TRY_TO_DATE(acited."date"),
                 TRY_TO_DATE(acurr."date")) BETWEEN 0 AND 365
GROUP BY bc."patent_id"
LIMIT 20;
```
