Query:
--Description: 7.  Forward citations that occur ≤ 1 year after application,
--safely handling malformed dates by using TRY_TO_DATE() and discarding NULLs.
SELECT  fc."citation_id" AS "patent_id",
        COUNT(*)         AS "fwd_first_year"
FROM    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION fc
JOIN    PATENTSVIEW.PATENTSVIEW.APPLICATION      acurr   -- cited patent (focal)
        ON fc."citation_id" = acurr."patent_id"
JOIN    PATENTSVIEW.PATENTSVIEW.APPLICATION      aciting -- citing patent
        ON fc."patent_id"   = aciting."patent_id"
WHERE   TRY_TO_DATE(acurr."date")  IS NOT NULL
  AND   TRY_TO_DATE(aciting."date") IS NOT NULL
  AND   DATEDIFF('day',
                 TRY_TO_DATE(aciting."date"),
                 TRY_TO_DATE(acurr."date")) BETWEEN 0 AND 365
GROUP BY fc."citation_id"
LIMIT 20
