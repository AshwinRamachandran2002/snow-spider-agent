--Description: 10.  FINAL ANSWER query.  Finds patents (here filtered to CPC
--subsection ‘C08’) that have ≥1 backward citation within 1 year before the
--application and ≥1 forward citation within 1 year after; also counts forward
--citations within the first 3 years.  All date parsing uses TRY_TO_DATE().
WITH back AS (
    SELECT bc."patent_id",
           COUNT(*) AS "back_last_1yr"
    FROM   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION bc
    JOIN   PATENTSVIEW.PATENTSVIEW.APPLICATION      acurr
           ON bc."patent_id"   = acurr."patent_id"
    JOIN   PATENTSVIEW.PATENTSVIEW.APPLICATION      acited
           ON bc."citation_id" = acited."patent_id"
    WHERE  TRY_TO_DATE(acurr."date")  IS NOT NULL
      AND  TRY_TO_DATE(acited."date") IS NOT NULL
      AND  DATEDIFF('day',
                    TRY_TO_DATE(acited."date"),
                    TRY_TO_DATE(acurr."date")) BETWEEN 0 AND 365
    GROUP BY bc."patent_id"
),
fwd AS (
    SELECT fc."citation_id" AS "patent_id",
           COUNT(*) AS "fwd_first_3yr",
           SUM(
               CASE
                   WHEN TRY_TO_DATE(aciting."date") IS NOT NULL
                        AND TRY_TO_DATE(acurr."date")  IS NOT NULL
                        AND DATEDIFF('day',
                                     TRY_TO_DATE(aciting."date"),
                                     TRY_TO_DATE(acurr."date")) BETWEEN 0 AND 365
                   THEN 1 ELSE 0
               END
           ) AS "fwd_first_year"
    FROM   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION fc
    JOIN   PATENTSVIEW.PATENTSVIEW.APPLICATION      acurr
           ON fc."citation_id" = acurr."patent_id"
    JOIN   PATENTSVIEW.PATENTSVIEW.APPLICATION      aciting
           ON fc."patent_id"   = aciting."patent_id"
    WHERE  TRY_TO_DATE(acurr."date")  IS NOT NULL
      AND  TRY_TO_DATE(aciting."date") IS NOT NULL
      AND  DATEDIFF('day',
                    TRY_TO_DATE(aciting."date"),
                    TRY_TO_DATE(acurr."date")) BETWEEN 0 AND 1095
    GROUP BY fc."citation_id"
),
both_sides AS (
    SELECT b."patent_id",
           b."back_last_1yr",
           f."fwd_first_3yr"
    FROM   back b
    JOIN   fwd  f ON b."patent_id" = f."patent_id"
    WHERE  f."fwd_first_year" > 0   -- ensures at least one forward citation in first year
)
SELECT  p."id"   AS "patent_id",
        p."title"AS "patent_title",
        bs."back_last_1yr" AS "backward_cites_1yr_before",
        bs."fwd_first_3yr" AS "forward_cites_3yr_after"
FROM    both_sides bs
JOIN    PATENTSVIEW.PATENTSVIEW.CPC_CURRENT cpc
        ON bs."patent_id" = cpc."patent_id"
JOIN    PATENTSVIEW.PATENTSVIEW.PATENT      p
        ON p."id" = bs."patent_id"
WHERE   cpc."subsection_id" = 'C08'   -- adjust CPC filter as needed
ORDER BY bs."back_last_1yr" DESC
LIMIT 1
