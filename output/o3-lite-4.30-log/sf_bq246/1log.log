--Description: Retrieve U.S. patents in chosen CPC sections (‘G’, ‘H’) – no date math
--             involved, but application dates are still cleaned with TRY_TO_DATE 
--             for potential later use.
WITH app AS (
    SELECT  "patent_id",
            MIN(TRY_TO_DATE("date")) AS "app_date"
    FROM    PATENTSVIEW.PATENTSVIEW.APPLICATION
    WHERE   TRY_TO_DATE("date") IS NOT NULL
    GROUP BY "patent_id"
), cpc AS (
    SELECT DISTINCT "patent_id"
    FROM   PATENTSVIEW.PATENTSVIEW.CPC_CURRENT
    WHERE  "section_id" IN ('G', 'H')
)
SELECT  p."id",
        p."number",
        p."title"
FROM    PATENTSVIEW.PATENTSVIEW.PATENT AS p
JOIN    cpc ON cpc."patent_id" = p."id"
WHERE   p."country" = 'US'
LIMIT 20
