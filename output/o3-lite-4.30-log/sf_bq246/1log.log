```sql
--Description: Ensure at least one forward citation in the 1‑year window AFTER filing.
WITH app AS (
    SELECT  "patent_id",
            MIN(TRY_TO_DATE("date")) AS "app_date"
    FROM    PATENTSVIEW.PATENTSVIEW.APPLICATION
    WHERE   TRY_TO_DATE("date") IS NOT NULL
    GROUP BY "patent_id"
), fwd1 AS (
    SELECT  u."citation_id" AS "patent_id",
            COUNT(*)        AS "fwd_1y"
    FROM    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION AS u
    JOIN    app AS cur    ON cur."patent_id"   = u."citation_id"
    JOIN    app AS citing ON citing."patent_id" = u."patent_id"
    WHERE   cur."app_date"   IS NOT NULL
      AND   citing."app_date" IS NOT NULL
      AND   citing."app_date" BETWEEN cur."app_date"
                                 AND DATEADD(year, 1, cur."app_date")
    GROUP BY u."citation_id"
)
SELECT *
FROM   fwd1
WHERE  "fwd_1y" > 0
LIMIT 20;
