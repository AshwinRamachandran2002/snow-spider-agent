```sql
--Description: Final end‑to‑end query.  Uses TRY_TO_DATE everywhere, so bad date strings
--             are ignored.  Returns the single U.S. patent (in CPC sections G or H) with:
--               • ≥1 backward citation filed within 1 year BEFORE its filing date
--               • ≥1 forward citation within 1 year AFTER
--               • counts of ALL forward citations within 3 years AFTER
--             Ordered by the backward‑citation count (desc) and limited to 1 result.
WITH app AS (
    SELECT  "patent_id",
            MIN(TRY_TO_DATE("date")) AS "app_date"
    FROM    PATENTSVIEW.PATENTSVIEW.APPLICATION
    WHERE   TRY_TO_DATE("date") IS NOT NULL
    GROUP BY "patent_id"
), back_1y AS (
    SELECT  u."patent_id",
            COUNT(*) AS "backward_1y"
    FROM    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION AS u
    JOIN    app AS cur   ON cur."patent_id"   = u."patent_id"
    JOIN    app AS cited ON cited."patent_id" = u."citation_id"
    WHERE   cur."app_date"   IS NOT NULL
      AND   cited."app_date" IS NOT NULL
      AND   cited."app_date" BETWEEN DATEADD(year, -1, cur."app_date")
                                AND      cur."app_date"
    GROUP BY u."patent_id"
), fwd_3y AS (
    SELECT  u."citation_id" AS "patent_id",
            COUNT(*)        AS "forward_3y"
    FROM    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION AS u
    JOIN    app AS cur    ON cur."patent_id"   = u."citation_id"
    JOIN    app AS citing ON citing."patent_id" = u."patent_id"
    WHERE   cur."app_date"   IS NOT NULL
      AND   citing."app_date" IS NOT NULL
      AND   citing."app_date" BETWEEN cur."app_date"
                                 AND DATEADD(year, 3, cur."app_date")
    GROUP BY u."citation_id"
), fwd_1y AS (
    SELECT  u."citation_id" AS "patent_id",
            COUNT(*)        AS "forward_1y"
    FROM    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION AS u
    JOIN    app AS cur    ON cur."patent_id"   = u."citation_id"
    JOIN    app AS citing ON citing."patent_id" = u."patent_id"
    WHERE   cur."app_date"   IS NOT NULL
      AND   citing."app_date" IS NOT NULL
      AND   citing."app_date" BETWEEN cur."app_date"
                                 AND DATEADD(year, 1, cur."app_date")
    GROUP BY u."citation_id"
), cpc AS (
    SELECT DISTINCT "patent_id"
    FROM   PATENTSVIEW.PATENTSVIEW.CPC_CURRENT
    WHERE  "section_id" IN ('G', 'H')
)
SELECT  p."number"          AS "patent_number",
        b."backward_1y",
        f1."forward_1y",
        f3."forward_3y"
FROM    back_1y  AS b
JOIN    fwd_1y   AS f1 ON f1."patent_id" = b."patent_id"
JOIN    fwd_3y   AS f3 ON f3."patent_id" = b."patent_id"
JOIN    cpc           ON cpc."patent_id" = b."patent_id"
JOIN    PATENTSVIEW.PATENTSVIEW.PATENT AS p
       ON p."id" = b."patent_id"
WHERE   p."country" = 'US'
ORDER BY b."backward_1y" DESC
LIMIT 1;
