--Description: Forward citations restricted to the 3‑year window AFTER a patent’s filing
--             (uses TRY_TO_DATE to ignore malformed application‑date strings).
WITH app AS (
    SELECT  "patent_id",
            MIN(TRY_TO_DATE("date")) AS "app_date"
    FROM    PATENTSVIEW.PATENTSVIEW.APPLICATION
    WHERE   TRY_TO_DATE("date") IS NOT NULL
    GROUP BY "patent_id"
)
SELECT  u."citation_id" AS "patent_id",
        COUNT(*)        AS "forward_3y"
FROM    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION AS u
JOIN    app AS cur    ON cur."patent_id"   = u."citation_id"   -- the cited / older patent
JOIN    app AS citing ON citing."patent_id" = u."patent_id"    -- the citing / newer patent
WHERE   cur."app_date"   IS NOT NULL
  AND   citing."app_date" IS NOT NULL
  AND   citing."app_date" BETWEEN cur."app_date"
                               AND DATEADD(year, 3, cur."app_date")
GROUP BY u."citation_id"
LIMIT 20
