```sql
--Description:
-- Goal: count backward citations that fall within the 1‑year window before each patent’s
--       U.S. application date, ignoring rows whose date strings cannot be parsed.
-- Steps embedded as comments:
WITH
/* 1.  Parse application dates; discard rows where conversion fails. */
appl AS (
    SELECT
        "patent_id",
        TRY_TO_DATE("date") AS "app_date"
    FROM PATENTSVIEW.PATENTSVIEW.APPLICATION
    WHERE TRY_TO_DATE("date") IS NOT NULL          -- keep only valid dates
)
/* 2.  Join the clean application set to USPATENTCITATION treating UC."patent_id"
       as the citing patent (i.e., backward citations). */
SELECT
    appl."patent_id",
    /* 3. Count citations whose own dates lie between (app_date – 1 year) and app_date. */
    COUNT(*) AS "bwd_cites_1yr"
FROM appl
JOIN PATENTSVIEW.PATENTSVIEW.USPATENTCITATION UC
  ON UC."patent_id" = appl."patent_id"
WHERE
      TRY_TO_DATE(UC."date") BETWEEN               -- TRY_TO_DATE returns NULL on bad strings
            DATEADD(year, -1, appl."app_date")
        AND appl."app_date"
GROUP BY
    appl."patent_id"
LIMIT 20;
```
