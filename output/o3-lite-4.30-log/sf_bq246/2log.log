     JOIN   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION UC
            ON UC."citation_id" = appl."patent_id"
     WHERE  TRY_TO_DATE(UC."date") BETWEEN
            appl."app_date" AND DATEADD(year, 3, appl."app_date")
     GROUP BY appl."patent_id"
)
SELECT  bwd."patent_id",
        bwd."bwd_cnt",
        fwd1."fwd1_cnt",
        fwd3."fwd3_cnt"
FROM    bwd
JOIN    fwd1 ON fwd1."patent_id" = bwd."patent_id"
JOIN    fwd3 ON fwd3."patent_id" = bwd."patent_id"
JOIN    PATENTSVIEW.PATENTSVIEW.CPC_CURRENT CC
          ON CC."patent_id" = bwd."patent_id"
WHERE   CC."group_id" IN ('G06F', 'C12Q')              -- specify desired CPC groups
ORDER BY bwd."bwd_cnt" DESC
LIMIT 1
