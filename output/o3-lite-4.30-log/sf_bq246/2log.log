2025-05-01 00:52:05 - Thread-108 (execute) - INFO - [Exploration]
Relevant columns and their possible roles  
• APPLICATION."patent_id": joins every patent to its application information  
• APPLICATION."date": original U.S. application filing date used as the time anchor  
• USPATENTCITATION."patent_id": the citing (later) patent ⇒ backward‑citation perspective  
• USPATENTCITATION."citation_id": the cited (earlier) patent ⇒ forward‑citation perspective when you flip the join  
• USPATENTCITATION."date": publication / priority date of the cited patent (stored as ‘YYYY‑MM‑DD’) – can be compared with the application‑date window  
• CPC_CURRENT."patent_id": links patents to CPC codes for technology‑field filtering  
• CPC_CURRENT."section_id" / "subsection_id" / "group_id" / "subgroup_id": choose the “specific CPC categories” requested  
Conditions that will be used  
• TO_DATE(USPATENTCITATION."date") BETWEEN DATEADD(year,-1,TO_DATE(APPL."date")) AND TO_DATE(APPL."date")    -- backward window (‑1 year)  
• TO_DATE(USPATENTCITATION."date") BETWEEN TO_DATE(APPL."date") AND DATEADD(year,3,TO_DATE(APPL."date"))    -- forward window (+3 years)  
• HAVING SUM(CASE WHEN … +1 year … THEN 1 END)>0   -- keep only patents with ≥1 forward citation in the first year  
• CPC_CURRENT."group_id" IN ('G06F','C12Q', … )   -- sample technology filters  

Below are ten exploratory‑to‑final Snowflake SQL queries (each limited to 20 rows except the last one) to understand the data and to build the requested result step‑by‑step.  
All identifiers are double‑quoted and fully‑qualified.

```sql
-- 1) Quick look at application‑date strings
SELECT DISTINCT "patent_id",
       "date"
FROM PATENTSVIEW.PATENTSVIEW.APPLICATION
ORDER BY "date"
LIMIT 20;
```

```sql
-- 2) Inspect a few rows in the USPATENTCITATION table
SELECT "patent_id"      AS "citing_patent",
       "citation_id"    AS "cited_patent",
       "date"
FROM PATENTSVIEW.PATENTSVIEW.USPATENTCITATION
LIMIT 20;
```

```sql
-- 3) List patents and how many BACKWARD citations occur within one year
SELECT  APPL."patent_id",
        COUNT(*) AS "bwd_cites_1yr"
FROM    PATENTSVIEW.PATENTSVIEW.APPLICATION  APPL
JOIN    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION  UC
          ON UC."patent_id" = APPL."patent_id"
WHERE   TO_DATE(UC."date") BETWEEN
        DATEADD(year,-1,TO_DATE(APPL."date"))
        AND TO_DATE(APPL."date")
GROUP BY APPL."patent_id"
LIMIT 20;
```

```sql
-- 4) List patents and how many FORWARD citations they receive in 3 years
SELECT  APPL."patent_id",
        COUNT(*) AS "fwd_cites_3yr"
FROM    PATENTSVIEW.PATENTSVIEW.APPLICATION  APPL
JOIN    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION  UC
          ON UC."citation_id" = APPL."patent_id"
WHERE   TO_DATE(UC."date") BETWEEN
        TO_DATE(APPL."date")
        AND DATEADD(year,3,TO_DATE(APPL."date"))
GROUP BY APPL."patent_id"
LIMIT 20;
```

```sql
-- 5) Forward‑citation count restricted to the FIRST year
SELECT  APPL."patent_id",
        COUNT(*) AS "fwd_cites_1yr"
FROM    PATENTSVIEW.PATENTSVIEW.APPLICATION  APPL
JOIN    PATENTSVIEW.PATENTSVIEW.USPATENTCITATION  UC
          ON UC."citation_id" = APPL."patent_id"
WHERE   TO_DATE(UC."date") BETWEEN
        TO_DATE(APPL."date")
        AND DATEADD(year,1,TO_DATE(APPL."date"))
GROUP BY APPL."patent_id"
LIMIT 20;
```

```sql
-- 6) Simple CPC filter example – patents in subsection C08
SELECT DISTINCT CC."patent_id",
       CC."section_id",
       CC."subsection_id"
FROM   PATENTSVIEW.PATENTSVIEW.CPC_CURRENT CC
WHERE  CC."subsection_id" = 'C08'
LIMIT 20;
```

```sql
-- 7) Combine backward & forward counts, keep only patents with ≥1 forward citation in year 1
WITH bwd AS (
   SELECT APPL."patent_id",
          COUNT(*) AS "bwd_cnt"
   FROM   PATENTSVIEW.PATENTSVIEW.APPLICATION  APPL
   JOIN   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION UC
            ON UC."patent_id" = APPL."patent_id"
   WHERE  TO_DATE(UC."date") BETWEEN
          DATEADD(year,-1,TO_DATE(APPL."date"))
          AND TO_DATE(APPL."date")
   GROUP BY APPL."patent_id"
),
fwd AS (
   SELECT APPL."patent_id",
          COUNT(*) AS "fwd1_cnt"
   FROM   PATENTSVIEW.PATENTSVIEW.APPLICATION  APPL
   JOIN   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION UC
            ON UC."citation_id" = APPL."patent_id"
   WHERE  TO_DATE(UC."date") BETWEEN
          TO_DATE(APPL."date")
          AND DATEADD(year,1,TO_DATE(APPL."date"))
   GROUP BY APPL."patent_id"
)
SELECT bwd."patent_id",
       bwd."bwd_cnt",
       fwd."fwd1_cnt"
FROM   bwd
JOIN   fwd  ON fwd."patent_id" = bwd."patent_id"
LIMIT 20;
```

```sql
-- 8) Same as #7 but add CPC filter for two example groups and show 3‑year forward count
WITH bwd AS (
     SELECT APPL."patent_id",
            COUNT(*) AS "bwd_cnt"
     FROM   PATENTSVIEW.PATENTSVIEW.APPLICATION  APPL
     JOIN   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION UC
              ON UC."patent_id" = APPL."patent_id"
     WHERE  TO_DATE(UC."date") BETWEEN
            DATEADD(year,-1,TO_DATE(APPL."date"))
            AND TO_DATE(APPL."date")
     GROUP BY APPL."patent_id"
),
fwd3 AS (
     SELECT APPL."patent_id",
            COUNT(*) AS "fwd3_cnt"
     FROM   PATENTSVIEW.PATENTSVIEW.APPLICATION  APPL
     JOIN   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION UC
              ON UC."citation_id" = APPL."patent_id"
     WHERE  TO_DATE(UC."date") BETWEEN
            TO_DATE(APPL."date")
            AND DATEADD(year,3,TO_DATE(APPL."date"))
     GROUP BY APPL."patent_id"
),
fwd1 AS (
     SELECT APPL."patent_id",
            COUNT(*) AS "fwd1_cnt"
     FROM   PATENTSVIEW.PATENTSVIEW.APPLICATION  APPL
     JOIN   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION UC
              ON UC."citation_id" = APPL."patent_id"
     WHERE  TO_DATE(UC."date") BETWEEN
            TO_DATE(APPL."date")
            AND DATEADD(year,1,TO_DATE(APPL."date"))
     GROUP BY APPL."patent_id"
)
SELECT bwd."patent_id",
       bwd."bwd_cnt",
       fwd1."fwd1_cnt",
       fwd3."fwd3_cnt"
FROM   bwd
JOIN   fwd1 ON fwd1."patent_id" = bwd."patent_id"
JOIN   fwd3 ON fwd3."patent_id" = bwd."patent_id"
JOIN   PATENTSVIEW.PATENTSVIEW.CPC_CURRENT CC
          ON CC."patent_id" = bwd."patent_id"
WHERE  CC."group_id" IN ('G06F', 'C12Q')   -- example categories
LIMIT 20;
```

```sql
-- 9) Order the result by backward citations, pick top 20
WITH bwd AS (
     SELECT APPL."patent_id",
            COUNT(*) AS "bwd_cnt"
     FROM   PATENTSVIEW.PATENTSVIEW.APPLICATION  APPL
     JOIN   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION UC
              ON UC."patent_id" = APPL."patent_id"
     WHERE  TO_DATE(UC."date") BETWEEN
            DATEADD(year,-1,TO_DATE(APPL."date"))
            AND TO_DATE(APPL."date")
     GROUP BY APPL."patent_id"
),
fwd1 AS (
     SELECT APPL."patent_id",
            COUNT(*) AS "fwd1_cnt"
     FROM   PATENTSVIEW.PATENTSVIEW.APPLICATION  APPL
     JOIN   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION UC
              ON UC."citation_id" = APPL."patent_id"
     WHERE  TO_DATE(UC."date") BETWEEN
            TO_DATE(APPL."date")
            AND DATEADD(year,1,TO_DATE(APPL."date"))
     GROUP BY APPL."patent_id"
)
SELECT bwd."patent_id",
       bwd."bwd_cnt",
       fwd1."fwd1_cnt"
FROM   bwd
JOIN   fwd1 ON fwd1."patent_id" = bwd."patent_id"
JOIN   PATENTSVIEW.PATENTSVIEW.CPC_CURRENT CC
          ON CC."patent_id" = bwd."patent_id"
WHERE  CC."group_id" IN ('G06F', 'C12Q')   -- example categories
ORDER BY bwd."bwd_cnt" DESC
LIMIT 20;
```

```sql
-- 10) FINAL query: one U.S. patent in the chosen CPC groups
--     (a) has ≥1 backward citation in the year‑prior window,
--     (b) has ≥1 forward citation in the year‑after window,
--     (c) report total forward citations in first 3 years,
--     ordered by backward‑citation count, return the top record.
WITH app AS (
     SELECT "patent_id",
            TO_DATE("date") AS "app_date"
     FROM   PATENTSVIEW.PATENTSVIEW.APPLICATION
),
bwd AS (
     SELECT A."patent_id",
            COUNT(*) AS "bwd_cnt"
     FROM   app A
     JOIN   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION UC
              ON UC."patent_id" = A."patent_id"
     WHERE  TO_DATE(UC."date") BETWEEN
            DATEADD(year,-1,A."app_date") AND A."app_date"
     GROUP BY A."patent_id"
),
fwd1 AS (
     SELECT A."patent_id",
            COUNT(*) AS "fwd1_cnt"
     FROM   app A
     JOIN   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION UC
              ON UC."citation_id" = A."patent_id"
     WHERE  TO_DATE(UC."date") BETWEEN
            A."app_date" AND DATEADD(year,1,A."app_date")
     GROUP BY A."patent_id"
),
fwd3 AS (
     SELECT A."patent_id",
            COUNT(*) AS "fwd3_cnt"
     FROM   app A
     JOIN   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION UC
              ON UC."citation_id" = A."patent_id"
     WHERE  TO_DATE(UC."date") BETWEEN
            A."app_date" AND DATEADD(year,3,A."app_date")
     GROUP BY A."patent_id"
)
SELECT  bwd."patent_id",
        bwd."bwd_cnt",
        fwd1."fwd1_cnt",
        fwd3."fwd3_cnt"
FROM    bwd
JOIN    fwd1 ON fwd1."patent_id" = bwd."patent_id"
JOIN    fwd3 ON fwd3."patent_id" = bwd."patent_id"
JOIN    PATENTSVIEW.PATENTSVIEW.CPC_CURRENT CC
          ON CC."patent_id" = bwd."patent_id"
WHERE   CC."group_id" IN ('G06F', 'C12Q')        -- supply the desired CPC groups here
ORDER BY bwd."bwd_cnt" DESC
LIMIT 1;
```

Each successive query adds a new layer (time windows, CPC filtering, ranking) until the final statement meets every requirement of the task.
