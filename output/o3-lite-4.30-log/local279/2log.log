Begin Exploring Related Columns
Relevant tables / columns and why they matter  
• product_minimums.product_id : product we must track  
• product_minimums.qty_minimum : “safety” / minimum level that must be on‑hand each month  
• product_minimums.qty_purchase : quantity we automatically add the moment (end_qty < qty_minimum)  
• inventory.product_id         : on‑hand lots that create the 2018‑12 “opening balance”  
• inventory.qty                : quantity of that lot still on hand  
• inventory.purchase_id        : lets us date each lot (link to purchases)  
• purchases.id / purchases.purchased : purchase date so we can filter lots received ≤ 2018‑12‑31  
• orderlines.product_id        : quantity that leaves stock (sales)  
• orderlines.qty               : how much left stock  
• orders.ordered               : date of each sale so we can roll monthly usage  
Typical filters  
  purchases.purchased        ≤ '2018‑12‑31'  – opening balance  
  orders.ordered  BETWEEN '2019‑01‑01' AND '2019‑12‑31'  – monthly usage in 2019  

Below are ten exploratory queries, from very simple “peek” queries to a complete recursive model that finds, for every product, the 2019 month whose ending inventory is closest to (but not necessarily below) the minimum.  
(Each query uses DISTINCT where appropriate and LIMIT 20 for safety.)

```sql
-- 1) What products actually have minimum rules?
SELECT DISTINCT product_id
FROM product_minimums
LIMIT 20;
```

```sql
-- 2) Show the minimum level and replenish quantity for those products
SELECT product_id,
       qty_minimum,
       qty_purchase
FROM product_minimums
LIMIT 20;
```

```sql
-- 3) All inventory lots that were received on or before 2018‑12‑31
SELECT i.id            AS inventory_id,
       i.product_id,
       i.qty,
       p.purchased
FROM   inventory  AS i
JOIN   purchases  AS p  ON p.id = i.purchase_id
WHERE  p.purchased <= '2018-12-31'
LIMIT 20;
```

```sql
-- 4) Opening balance (end of 2018‑12) for every tracked product
SELECT i.product_id,
       SUM(i.qty) AS opening_qty
FROM   inventory  AS i
JOIN   purchases  AS p ON p.id = i.purchase_id
WHERE  p.purchased <= '2018-12-31'
GROUP  BY i.product_id
LIMIT 20;
```

```sql
-- 5) Monthly 2019 sales (in units) for every product
SELECT ol.product_id,
       strftime('%Y-%m-01', o.ordered) AS month,
       SUM(ol.qty)                    AS sold_qty
FROM   orderlines AS ol
JOIN   orders     AS o  ON o.id = ol.order_id
WHERE  o.ordered BETWEEN '2019-01-01' AND '2019-12-31'
GROUP  BY ol.product_id,
          month
LIMIT 20;
```

```sql
-- 6) Combine minimums with the opening balance, just to eyeball data
SELECT pm.product_id,
       pm.qty_minimum,
       ob.opening_qty
FROM   product_minimums                        AS pm
LEFT   JOIN (SELECT i.product_id,
                    SUM(i.qty) AS opening_qty
             FROM   inventory  AS i
             JOIN   purchases  AS p ON p.id = i.purchase_id
             WHERE  p.purchased <= '2018-12-31'
             GROUP  BY i.product_id)           AS ob
       ON ob.product_id = pm.product_id
LIMIT 20;
```

```sql
-- 7) Anchor row for a recursive inventory model (month = 2018‑12)
WITH opening AS (
  SELECT pm.product_id,
         '2018-12-01'                 AS month,
         COALESCE(SUM(i.qty), 0)      AS end_qty
  FROM   product_minimums             AS pm
  LEFT   JOIN inventory  AS i   ON i.product_id = pm.product_id
  LEFT   JOIN purchases  AS p   ON p.id = i.purchase_id
                                 AND p.purchased <= '2018-12-31'
  GROUP  BY pm.product_id
)
SELECT * FROM opening
LIMIT 20;
```

```sql
-- 8) Recursive model that rolls inventory through each month of 2019
WITH RECURSIVE inv AS (
  -- anchor (2018‑12)
  SELECT pm.product_id,
         '2018-12-01'                       AS month,
         COALESCE(SUM(i.qty), 0)            AS start_qty,
         0                                   AS sold_qty,
         COALESCE(SUM(i.qty), 0)            AS end_qty
  FROM   product_minimums  AS pm
  LEFT   JOIN inventory    AS i  ON i.product_id = pm.product_id
  LEFT   JOIN purchases    AS p  ON p.id = i.purchase_id
                                  AND p.purchased <= '2018-12-31'
  GROUP  BY pm.product_id

  UNION ALL

  -- recursive step – advance one month, subtract sales, add restock if needed
  SELECT inv.product_id,
         date(inv.month, '+1 month')                         AS month,
         inv.end_qty                                         AS start_qty,

         COALESCE( (SELECT SUM(ol.qty)
                    FROM   orderlines AS ol
                    JOIN   orders     AS o  ON o.id = ol.order_id
                    WHERE  ol.product_id = inv.product_id
                      AND  strftime('%Y-%m', o.ordered)
                           = strftime('%Y-%m', date(inv.month, '+1 month'))
                   ), 0)                                     AS sold_qty,

         CASE
             WHEN inv.end_qty
                  - COALESCE( (SELECT SUM(ol.qty)
                               FROM   orderlines AS ol
                               JOIN   orders     AS o  ON o.id = ol.order_id
                               WHERE  ol.product_id = inv.product_id
                                 AND  strftime('%Y-%m', o.ordered)
                                      = strftime('%Y-%m', date(inv.month, '+1 month'))
                              ), 0)
                  < pm.qty_minimum
             THEN inv.end_qty
                  - COALESCE( (SELECT SUM(ol.qty)
                               FROM   orderlines AS ol
                               JOIN   orders     AS o  ON o.id = ol.order_id
                               WHERE  ol.product_id = inv.product_id
                                 AND  strftime('%Y-%m', o.ordered)
                                      = strftime('%Y-%m', date(inv.month, '+1 month'))
                              ), 0)
                  + pm.qty_purchase
             ELSE inv.end_qty
                  - COALESCE( (SELECT SUM(ol.qty)
                               FROM   orderlines AS ol
                               JOIN   orders     AS o  ON o.id = ol.order_id
                               WHERE  ol.product_id = inv.product_id
                                 AND  strftime('%Y-%m', o.ordered)
                                      = strftime('%Y-%m', date(inv.month, '+1 month'))
                              ), 0)
         END                                                AS end_qty
  FROM   inv
  JOIN   product_minimums AS pm ON pm.product_id = inv.product_id
  WHERE  inv.month < '2019-12-01'      -- stop after generating 2019‑12
)
SELECT *
FROM   inv
LIMIT 20;
```

```sql
-- 9) Add ABS(end_qty - minimum) so we can later pick the closest month
WITH RECURSIVE inv AS ( ... same as query 8 ... )
SELECT inv.product_id,
       inv.month,
       inv.end_qty,
       ABS(inv.end_qty - pm.qty_minimum) AS diff_from_min
FROM   inv
JOIN   product_minimums AS pm ON pm.product_id = inv.product_id
WHERE  inv.month BETWEEN '2019-01-01' AND '2019-12-01'
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: for each product, the 2019 month whose ending
--     inventory is closest to its minimum level
WITH RECURSIVE inv AS (
  /* identical recursive block from query 8 */
  SELECT pm.product_id,
         '2018-12-01'                       AS month,
         COALESCE(SUM(i.qty), 0)            AS start_qty,
         0                                   AS sold_qty,
         COALESCE(SUM(i.qty), 0)            AS end_qty
  FROM   product_minimums  AS pm
  LEFT   JOIN inventory    AS i  ON i.product_id = pm.product_id
  LEFT   JOIN purchases    AS p  ON p.id = i.purchase_id
                                  AND p.purchased <= '2018-12-31'
  GROUP  BY pm.product_id

  UNION ALL

  SELECT inv.product_id,
         date(inv.month, '+1 month')                         AS month,
         inv.end_qty                                         AS start_qty,

         COALESCE( (SELECT SUM(ol.qty)
                    FROM   orderlines AS ol
                    JOIN   orders     AS o  ON o.id = ol.order_id
                    WHERE  ol.product_id = inv.product_id
                      AND  strftime('%Y-%m', o.ordered)
                           = strftime('%Y-%m', date(inv.month, '+1 month'))
                   ), 0)                                     AS sold_qty,

         CASE
             WHEN inv.end_qty
                  - COALESCE( (SELECT SUM(ol.qty)
                               FROM   orderlines AS ol
                               JOIN   orders     AS o  ON o.id = ol.order_id
                               WHERE  ol.product_id = inv.product_id
                                 AND  strftime('%Y-%m', o.ordered)
                                      = strftime('%Y-%m', date(inv.month, '+1 month'))
                              ), 0)
                  < pm.qty_minimum
             THEN inv.end_qty
                  - COALESCE( (SELECT SUM(ol.qty)
                               FROM   orderlines AS ol
                               JOIN   orders     AS o  ON o.id = ol.order_id
                               WHERE  ol.product_id = inv.product_id
                                 AND  strftime('%Y-%m', o.ordered)
                                      = strftime('%Y-%m', date(inv.month, '+1 month'))
                              ), 0)
                  + pm.qty_purchase
             ELSE inv.end_qty
                  - COALESCE( (SELECT SUM(ol.qty)
                               FROM   orderlines AS ol
                               JOIN   orders     AS o  ON o.id = ol.order_id
                               WHERE  ol.product_id = inv.product_id
                                 AND  strftime('%Y-%m', o.ordered)
                                      = strftime('%Y-%m', date(inv.month, '+1 month'))
                              ), 0)
         END                                                AS end_qty
  FROM   inv
  JOIN   product_minimums AS pm ON pm.product_id = inv.product_id
  WHERE  inv.month < '2019-12-01'
),
diffs AS (
  SELECT inv.product_id,
         inv.month,
         ABS(inv.end_qty - pm.qty_minimum) AS diff_from_min
  FROM   inv
  JOIN   product_minimums AS pm ON pm.product_id = inv.product_id
  WHERE  inv.month BETWEEN '2019-01-01' AND '2019-12-01'
)
SELECT d1.product_id,
       d1.month        AS closest_month,
       d1.diff_from_min
FROM   diffs AS d1
JOIN   (SELECT product_id,
               MIN(diff_from_min) AS best_diff
        FROM   diffs
        GROUP  BY product_id) AS d2
      ON d2.product_id = d1.product_id
     AND d2.best_diff  = d1.diff_from_min
ORDER BY d1.product_id
LIMIT 20;
```

