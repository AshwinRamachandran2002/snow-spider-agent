-- 8) Recursive model that rolls inventory through each month of 2019
WITH RECURSIVE inv AS (
  -- anchor (2018‑12)
  SELECT pm.product_id,
         '2018-12-01'                       AS month,
         COALESCE(SUM(i.qty), 0)            AS start_qty,
         0                                   AS sold_qty,
         COALESCE(SUM(i.qty), 0)            AS end_qty
  FROM   product_minimums  AS pm
  LEFT   JOIN inventory    AS i  ON i.product_id = pm.product_id
  LEFT   JOIN purchases    AS p  ON p.id = i.purchase_id
                                  AND p.purchased <= '2018-12-31'
  GROUP  BY pm.product_id

  UNION ALL

  -- recursive step – advance one month, subtract sales, add restock if needed
  SELECT inv.product_id,
         date(inv.month, '+1 month')                         AS month,
         inv.end_qty                                         AS start_qty,

         COALESCE( (SELECT SUM(ol.qty)
                    FROM   orderlines AS ol
                    JOIN   orders     AS o  ON o.id = ol.order_id
                    WHERE  ol.product_id = inv.product_id
                      AND  strftime('%Y-%m', o.ordered)
                           = strftime('%Y-%m', date(inv.month, '+1 month'))
                   ), 0)                                     AS sold_qty,

         CASE
             WHEN inv.end_qty
                  - COALESCE( (SELECT SUM(ol.qty)
                               FROM   orderlines AS ol
                               JOIN   orders     AS o  ON o.id = ol.order_id
                               WHERE  ol.product_id = inv.product_id
                                 AND  strftime('%Y-%m', o.ordered)
                                      = strftime('%Y-%m', date(inv.month, '+1 month'))
                              ), 0)
                  < pm.qty_minimum
             THEN inv.end_qty
                  - COALESCE( (SELECT SUM(ol.qty)
                               FROM   orderlines AS ol
                               JOIN   orders     AS o  ON o.id = ol.order_id
                               WHERE  ol.product_id = inv.product_id
                                 AND  strftime('%Y-%m', o.ordered)
                                      = strftime('%Y-%m', date(inv.month, '+1 month'))
                              ), 0)
                  + pm.qty_purchase
             ELSE inv.end_qty
                  - COALESCE( (SELECT SUM(ol.qty)
                               FROM   orderlines AS ol
                               JOIN   orders     AS o  ON o.id = ol.order_id
                               WHERE  ol.product_id = inv.product_id
                                 AND  strftime('%Y-%m', o.ordered)
                                      = strftime('%Y-%m', date(inv.month, '+1 month'))
                              ), 0)
         END                                                AS end_qty
  FROM   inv
  JOIN   product_minimums AS pm ON pm.product_id = inv.product_id
  WHERE  inv.month < '2019-12-01'      -- stop after generating 2019‑12
)
SELECT *
FROM   inv
LIMIT 20;
