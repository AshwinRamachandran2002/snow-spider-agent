```sql
--Description:  Final answer – simulate inventories month‑by‑month (anchor at
--2018‑12‑01), subtract sales, auto‑restock if the projected level would fall
--below the product’s minimum, then find – for every product that has a minimum
--rule – the 2019 month whose simulated ending inventory is **closest** to the
--minimum (ties resolved by keeping the earliest month).  The result shows
--product_id, that “closest” month and the absolute difference.
WITH RECURSIVE inv AS (            /* -------------- inventory simulation -------------- */
    /* anchor: closing balance on 2018‑12‑01 */
    SELECT  pm.product_id,
            '2018-12-01'                       AS month,
            COALESCE(SUM(i.qty),0)             AS start_qty,
            0                                  AS sold_qty,
            COALESCE(SUM(i.qty),0)             AS end_qty
    FROM    product_minimums  pm
    LEFT    JOIN inventory    i  ON i.product_id = pm.product_id
    LEFT    JOIN purchases    p  ON p.id = i.purchase_id
                                   AND p.purchased <= '2018-12-31'
    GROUP   BY pm.product_id

    UNION ALL

    /* recursive: move forward one calendar month */
    SELECT  inv.product_id,
            date(inv.month,'+1 month')                           AS month,
            inv.end_qty                                          AS start_qty,

            /* sales in the forthcoming month */
            COALESCE((
                SELECT SUM(ol.qty)
                FROM   orderlines ol
                JOIN   orders     o ON o.id = ol.order_id
                WHERE  ol.product_id = inv.product_id
                  AND  strftime('%Y-%m', o.ordered) =
                       strftime('%Y-%m', date(inv.month,'+1 month'))
            ),0)                                                 AS sold_qty,

            /* ending qty after subtracting sales and restock if needed */
            CASE
                WHEN inv.end_qty
                     - COALESCE((
                         SELECT SUM(ol.qty)
                         FROM   orderlines ol
                         JOIN   orders     o ON o.id = ol.order_id
                         WHERE  ol.product_id = inv.product_id
                           AND  strftime('%Y-%m', o.ordered) =
                                strftime('%Y-%m', date(inv.month,'+1 month'))
                     ),0) < pm.qty_minimum
                THEN inv.end_qty
                     - COALESCE((
                         SELECT SUM(ol.qty)
                         FROM   orderlines ol
                         JOIN   orders     o ON o.id = ol.order_id
                         WHERE  ol.product_id = inv.product_id
                           AND  strftime('%Y-%m', o.ordered) =
                                strftime('%Y-%m', date(inv.month,'+1 month'))
                     ),0)
                     + pm.qty_purchase
                ELSE inv.end_qty
                     - COALESCE((
                         SELECT SUM(ol.qty)
                         FROM   orderlines ol
                         JOIN   orders     o ON o.id = ol.order_id
                         WHERE  ol.product_id = inv.product_id
                           AND  strftime('%Y-%m', o.ordered) =
                                strftime('%Y-%m', date(inv.month,'+1 month'))
                     ),0)
            END                                                  AS end_qty
    FROM    inv
    JOIN    product_minimums pm ON pm.product_id = inv.product_id
    WHERE   inv.month < '2019-12-01'           -- generate rows up to 2019‑12‑01
),
diffs AS (                          /* -------------- deviation per month -------------- */
    SELECT inv.product_id,
           inv.month,
           ABS(inv.end_qty - pm.qty_minimum) AS diff_from_min
    FROM   inv
    JOIN   product_minimums pm ON pm.product_id = inv.product_id
    WHERE  inv.month BETWEEN '2019-01-01' AND '2019-12-01'
),
best AS (                           /* -------------- pick best deviation -------------- */
    SELECT product_id,
           MIN(diff_from_min) AS best_diff
    FROM   diffs
    GROUP  BY product_id
),
best_month AS (                      /* -------------- earliest month with best diff --- */
    SELECT d.product_id,
           MIN(d.month) AS month
    FROM   diffs d
    JOIN   best  b ON b.product_id = d.product_id
                  AND b.best_diff  = d.diff_from_min
    GROUP  BY d.product_id
)
SELECT bm.product_id,
       bm.month,
       b.best_diff AS diff_from_min
FROM   best_month bm
JOIN   best       b  ON b.product_id = bm.product_id
ORDER  BY bm.product_id;
