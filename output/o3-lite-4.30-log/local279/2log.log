--Description: Re‑create the recursive inventory simulation (anchor row for 2018‑12‑01,
--then step forward one month at a time through 2019).  For each generated 2019
--row we output the product, month, simulated ending quantity and the absolute
--difference between that ending quantity and the product’s minimum level.  This
--is the corrected version of the earlier query (the “… same as query 8 …”
--placeholder caused the syntax error).
WITH RECURSIVE inv AS (
    /* -------------------------------------------------
       Anchor row – closing balance for 2018‑12‑01
       ------------------------------------------------- */
    SELECT  pm.product_id,
            '2018-12-01'                       AS month,
            COALESCE(SUM(i.qty),0)             AS start_qty,
            0                                  AS sold_qty,
            COALESCE(SUM(i.qty),0)             AS end_qty
    FROM    product_minimums  pm
    LEFT    JOIN inventory    i  ON i.product_id = pm.product_id
    LEFT    JOIN purchases    p  ON p.id = i.purchase_id
                                   AND p.purchased <= '2018-12-31'
    GROUP   BY pm.product_id

    UNION ALL

    /* -------------------------------------------------
       Recursive step – advance exactly one calendar month
       ------------------------------------------------- */
    SELECT  inv.product_id,
            date(inv.month, '+1 month')                           AS month,
            inv.end_qty                                          AS start_qty,

            /* total sales for that product in the coming month */
            COALESCE((
                SELECT SUM(ol.qty)
                FROM   orderlines ol
                JOIN   orders     o ON o.id = ol.order_id
                WHERE  ol.product_id = inv.product_id
                  AND  strftime('%Y-%m', o.ordered)
                       = strftime('%Y-%m', date(inv.month, '+1 month'))
            ), 0)                                                AS sold_qty,

            /* calculate ending quantity, adding an automatic purchase
               if the post‑sales level would fall below the minimum */
            CASE
                WHEN inv.end_qty
                     - COALESCE((
                         SELECT SUM(ol.qty)
                         FROM   orderlines ol
                         JOIN   orders     o ON o.id = ol.order_id
                         WHERE  ol.product_id = inv.product_id
                           AND  strftime('%Y-%m', o.ordered)
                                = strftime('%Y-%m', date(inv.month, '+1 month'))
                     ), 0) < pm.qty_minimum
                THEN inv.end_qty
                     - COALESCE((
                         SELECT SUM(ol.qty)
                         FROM   orderlines ol
                         JOIN   orders     o ON o.id = ol.order_id
                         WHERE  ol.product_id = inv.product_id
                           AND  strftime('%Y-%m', o.ordered)
                                = strftime('%Y-%m', date(inv.month, '+1 month'))
                     ), 0)
                     + pm.qty_purchase
                ELSE inv.end_qty
                     - COALESCE((
                         SELECT SUM(ol.qty)
                         FROM   orderlines ol
                         JOIN   orders     o ON o.id = ol.order_id
                         WHERE  ol.product_id = inv.product_id
                           AND  strftime('%Y-%m', o.ordered)
                                = strftime('%Y-%m', date(inv.month, '+1 month'))
                     ), 0)
            END                                                  AS end_qty
    FROM    inv
    JOIN    product_minimums pm ON pm.product_id = inv.product_id
    WHERE   inv.month < '2019-12-01'     -- stop after generating 2019‑12‑01 row
)
SELECT  inv.product_id,
        inv.month,
        inv.end_qty,
        ABS(inv.end_qty - pm.qty_minimum) AS diff_from_min
