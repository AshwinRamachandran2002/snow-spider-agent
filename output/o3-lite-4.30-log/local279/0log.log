Begin Exploring Related Columns
Relevant tables / columns and why they matter  

• product_minimums.qty_minimum : minimum level that must be kept in stock for each product.  
• product_minimums.qty_purchase : quantity we re‑order (restock) each time the minimum is violated.  
• inventory.product_id / inventory.qty : on‑hand quantity as of the latest snapshot (we will treat the snapshot that belongs to December‑2018 as the starting level).  
• monthly_sales.product_id / monthly_sales.mth / monthly_sales.qty : aggregate monthly demand that will be subtracted from inventory.  
• purchases.product_id / purchases.purchased / purchases.qty : can be used to double‑check how re‑stocking is normally logged (not strictly required for the modelling exercise but good to inspect).  

Typical filters you may use  

• monthly_sales.mth BETWEEN '2018-12-01' AND '2019-12-01'  
• strftime('%Y', monthly_sales.mth) = '2019'  
• purchases.purchased >= '2019-01-01'  
• inventory.qty IS NOT NULL  

Ten exploration queries, from simple to gradually more analytical, all capped at 20 rows.

```sql
-- 1. Description:  List every product that has a defined minimum inventory level.
SELECT DISTINCT
       "product_id",
       "qty_minimum",
       "qty_purchase"
FROM   "product_minimums"
LIMIT  20;
```

```sql
-- 2. Description:  View a few rows from the raw inventory snapshot to see current on‑hand quantities.
SELECT DISTINCT
       "product_id",
       "qty"
FROM   "inventory"
LIMIT  20;
```

```sql
-- 3. Description:  See which inventory rows belong to December 2018 (assuming purchase_id can locate time).
SELECT DISTINCT
       i."product_id",
       i."qty",
       p."purchased"          -- date of the purchase that created the stock line
FROM   "inventory"  AS i
JOIN   "purchases"  AS p  ON p."id" = i."purchase_id"
WHERE  p."purchased" BETWEEN '2018-12-01' AND '2018-12-31'
LIMIT  20;
```

```sql
-- 4. Description:  Grab monthly sales figures from December 2018 that will be our starting offset.
SELECT DISTINCT
       "product_id",
       "mth",
       "qty"
FROM   "monthly_sales"
WHERE  "mth" = '2018-12-01'
LIMIT  20;
```

```sql
-- 5. Description:  Inspect all monthly sales for 2019 for products that have minimum levels.
SELECT DISTINCT
       ms."product_id",
       ms."mth",
       ms."qty"
FROM   "monthly_sales"  AS ms
JOIN   "product_minimums" AS pm USING ("product_id")
WHERE  strftime('%Y', ms."mth") = '2019'
LIMIT  20;
```

```sql
-- 6. Description:  Look at how purchases (potential re‑stock events) are recorded for 2019.
SELECT DISTINCT
       "product_id",
       "purchased",
       "qty"
FROM   "purchases"
WHERE  "purchased" >= '2019-01-01'
LIMIT  20;
```

```sql
-- 7. Description:  Get a feel for the size of 2019 monthly sales vs the minimum level (first 20 rows).
SELECT DISTINCT
       ms."product_id",
       pm."qty_minimum",
       ms."qty"          AS "mth_sales"
FROM   "monthly_sales"   AS ms
JOIN   "product_minimums" AS pm USING ("product_id")
WHERE  strftime('%Y', ms."mth") = '2019'
LIMIT  20;
```

```sql
-- 8. Description:  Compute provisional ending inventory for January 2019
--     (Dec‑2018 stock minus Jan‑2019 sales) for products where we know both figures.
SELECT
       dec18."product_id",
       dec18."start_qty"   AS "dec_end_qty",
       jan19."sales_qty",
       dec18."start_qty" - jan19."sales_qty"  AS "jan19_end_qty"
FROM (
      SELECT i."product_id", SUM(i."qty") AS "start_qty"
      FROM   "inventory" AS i
      JOIN   "purchases" AS p ON p."id" = i."purchase_id"
      WHERE  p."purchased" BETWEEN '2018-12-01' AND '2018-12-31'
      GROUP  BY i."product_id"
) dec18
JOIN (
      SELECT "product_id", SUM("qty") AS "sales_qty"
      FROM   "monthly_sales"
      WHERE  "mth" = '2019-01-01'
      GROUP  BY "product_id"
) jan19 USING ("product_id")
LIMIT 20;
```

```sql
-- 9. Description:  Identify products whose January 2019 ending inventory falls below minimum.
SELECT
       t."product_id",
       t."jan19_end_qty",
       pm."qty_minimum"
FROM (
      /* query 8 re‑used here as CTE or sub‑query */
      SELECT
             dec18."product_id",
             dec18."start_qty" - jan19."sales_qty" AS "jan19_end_qty"
      FROM (
            SELECT i."product_id", SUM(i."qty") AS "start_qty"
            FROM   "inventory" AS i
            JOIN   "purchases" AS p ON p."id" = i."purchase_id"
            WHERE  p."purchased" BETWEEN '2018-12-01' AND '2018-12-31'
            GROUP  BY i."product_id"
      ) dec18
      JOIN (
            SELECT "product_id", SUM("qty") AS "sales_qty"
            FROM   "monthly_sales"
            WHERE  "mth" = '2019-01-01'
            GROUP  BY "product_id"
      ) jan19 USING ("product_id")
) AS t
JOIN "product_minimums" AS pm  ON pm."product_id" = t."product_id"
WHERE t."jan19_end_qty" < pm."qty_minimum"
LIMIT 20;
```

```sql
-- 10. Description:  (Toward the final answer) For every product/month in 2019
--      compute |ending_qty − minimum| and keep the month where that absolute
--      difference is smallest.  (Still LIMIT 20 for sampling.)
WITH start_stock AS (
     SELECT i."product_id",
            SUM(i."qty") AS "start_qty"
     FROM   "inventory" AS i
     JOIN   "purchases" AS p ON p."id" = i."purchase_id"
     WHERE  p."purchased" BETWEEN '2018-12-01' AND '2018-12-31'
     GROUP  BY i."product_id"
),
sales_19 AS (
     SELECT "product_id",
            "mth",
            SUM("qty") AS "sales_qty"
     FROM   "monthly_sales"
     WHERE  "mth" BETWEEN '2019-01-01' AND '2019-12-01'
     GROUP  BY "product_id", "mth"
),
running AS (
     -- recursively subtract month by month and restock when needed
     SELECT
            s."product_id",
            '2019-01-01' AS "mth",
            CAST(s."start_qty" AS REAL) AS "opening",
            CAST(s."start_qty" - COALESCE(j."sales_qty",0) AS REAL) AS "ending"
     FROM   start_stock  AS s
     LEFT   JOIN sales_19 AS j  ON j."product_id" = s."product_id" AND j."mth" = '2019-01-01'
     UNION ALL
     SELECT
            r."product_id",
            date(r."mth", '+1 month') AS "mth",
            CASE
                 WHEN r."ending" < pm."qty_minimum"
                 THEN r."ending" + pm."qty_purchase"
                 ELSE r."ending"
            END AS "opening",
            CASE
                 WHEN r."ending" < pm."qty_minimum"
                 THEN r."ending" + pm."qty_purchase" - COALESCE(j2."sales_qty",0)
                 ELSE r."ending" - COALESCE(j2."sales_qty",0)
            END AS "ending"
     FROM   running            AS r
     JOIN   product_minimums   AS pm ON pm."product_id" = r."product_id"
     LEFT   JOIN sales_19      AS j2 ON j2."product_id" = r."product_id"
                                      AND j2."mth" = date(r."mth", '+1 month')
     WHERE  r."mth" < '2019-12-01'
),
abs_diff AS (
     SELECT
            r."product_id",
            r."mth",
            ABS(r."ending" - pm."qty_minimum") AS "abs_diff"
     FROM   running           AS r
     JOIN   product_minimums  AS pm USING ("product_id")
)
SELECT
       ad."product_id",
       ad."mth"          AS "closest_month",
       ad."abs_diff"
FROM (
     SELECT
            product_id,
            mth,
            abs_diff,
            ROW_NUMBER() OVER (PARTITION BY product_id
                               ORDER BY abs_diff ASC) AS rn
     FROM   abs_diff
) ad
WHERE  ad.rn = 1
LIMIT 20;
```

Each query progressively reveals the data needed and culminates in a working prototype of the recursive monthly inventory adjustment required to answer the task.
