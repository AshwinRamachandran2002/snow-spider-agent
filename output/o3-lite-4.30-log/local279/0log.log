--Description:  Compute provisional ending inventory for January 2019 by taking the
--December‑2018 stock (summed) and subtracting January‑2019 sales.  A LEFT JOIN
--makes sales default to 0 when no January‑2019 row exists.
SELECT
       dec18."product_id",
       dec18."start_qty"                       AS "dec_end_qty",
       COALESCE(jan19."sales_qty", 0)          AS "jan19_sales",
       dec18."start_qty" - COALESCE(jan19."sales_qty", 0) AS "jan19_end_qty"
FROM (
      SELECT i."product_id", SUM(i."qty") AS "start_qty"
      FROM   "inventory" AS i
      JOIN   "purchases" AS p ON p."id" = i."purchase_id"
      WHERE  p."purchased" BETWEEN '2018-12-01' AND '2018-12-31'
      GROUP  BY i."product_id"
) dec18
LEFT JOIN (
      SELECT "product_id", SUM("qty") AS "sales_qty"
      FROM   "monthly_sales"
      WHERE  "mth" = '2019-01-01'
      GROUP  BY "product_id"
) jan19 USING ("product_id")
LIMIT 20
