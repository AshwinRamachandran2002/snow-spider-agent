WITH RECURSIVE
-- 1. December‑2018 closing stock (starting level for 2019)
start_stock AS (
  SELECT
         i.product_id,
         SUM(i.qty) AS start_qty
  FROM   inventory  AS i
  JOIN   purchases  AS p
         ON p.id = i.purchase_id
  WHERE  p.purchased BETWEEN '2018-12-01' AND '2018-12-31'
  GROUP  BY i.product_id
),

-- 2. 2019 monthly sales (0 later when no row exists)
sales_2019 AS (
  SELECT
         product_id,
         mth,
         SUM(qty) AS sales_qty
  FROM   monthly_sales
  WHERE  mth BETWEEN '2019-01-01' AND '2019-12-01'
  GROUP  BY product_id , mth
),

-- 3. Month‑by‑month inventory evolution with automatic restock
running AS (
  /* Seed row : January‑2019 */
  SELECT
         ss.product_id,
         '2019-01-01'          AS mth,
         ss.start_qty          AS opening,
         ss.start_qty - COALESCE(s.sales_qty,0)  AS ending,
         1                     AS month_idx
  FROM   start_stock  AS ss
  LEFT   JOIN sales_2019 AS s
         ON s.product_id = ss.product_id
        AND s.mth        = '2019-01-01'

  UNION ALL

  /* Carry forward month by month up to December */
  SELECT
         r.product_id,
         date(r.mth,'+1 month')                                     AS mth,
         CASE
              WHEN r.ending < pm.qty_minimum
              THEN r.ending + pm.qty_purchase
              ELSE r.ending
         END                                                       AS opening,
         CASE
              WHEN r.ending < pm.qty_minimum
              THEN r.ending + pm.qty_purchase - COALESCE(s2.sales_qty,0)
              ELSE r.ending                 - COALESCE(s2.sales_qty,0)
         END                                                       AS ending,
         r.month_idx + 1
  FROM   running            AS r
  JOIN   product_minimums   AS pm  ON pm.product_id = r.product_id
  LEFT   JOIN sales_2019    AS s2  ON s2.product_id = r.product_id
                                  AND s2.mth = date(r.mth,'+1 month')
  WHERE  r.month_idx < 12               -- stop at December‑2019
),

-- 4. Absolute gap to the minimum after each month
abs_gap AS (
  SELECT
         r.product_id,
         r.mth,
         ABS(r.ending - pm.qty_minimum) AS gap
  FROM   running          AS r
  JOIN   product_minimums AS pm  ON pm.product_id = r.product_id
),

-- 5. Pick the month with the smallest gap per product
best_month AS (
  SELECT
         product_id,
         mth,
         gap,
         ROW_NUMBER() OVER (PARTITION BY product_id
                            ORDER BY gap, mth) AS rn
  FROM   abs_gap
)

SELECT
       product_id,
       mth       AS month,
       gap       AS abs_difference
FROM   best_month
WHERE  rn = 1
ORDER  BY product_id;
```
