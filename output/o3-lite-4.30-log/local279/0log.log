```sql
--Description:  Compute provisional ending inventory for January 2019 by taking the
--December‑2018 stock (summed) and subtracting January‑2019 sales.  Use LEFT JOIN
--so that products with no January sales default to 0 sales.
SELECT
       dec18."product_id",
       dec18."start_qty"                       AS "dec_end_qty",
       COALESCE(jan19."sales_qty", 0)          AS "jan19_sales",
       dec18."start_qty" - COALESCE(jan19."sales_qty", 0) AS "jan19_end_qty"
FROM (
      SELECT i."product_id", SUM(i."qty") AS "start_qty"
      FROM   "inventory" AS i
      JOIN   "purchases" AS p ON p."id" = i."purchase_id"
      WHERE  p."purchased" BETWEEN '2018-12-01' AND '2018-12-31'
      GROUP  BY i."product_id"
) dec18
LEFT JOIN (
      SELECT "product_id", SUM("qty") AS "sales_qty"
      FROM   "monthly_sales"
      WHERE  "mth" = '2019-01-01'
      GROUP  BY "product_id"
) jan19 USING ("product_id")
LIMIT 20;
```

```sql
--Description:  Using the January 2019 ending inventory just calculated, list the
--products where that ending quantity falls below the required minimum.  Again
--COALESCE ensures missing sales count as zero.
WITH jan_calc AS (
      SELECT
             dec18."product_id",
             dec18."start_qty" - COALESCE(jan19."sales_qty", 0) AS "jan19_end_qty"
      FROM (
            SELECT i."product_id", SUM(i."qty") AS "start_qty"
            FROM   "inventory" AS i
            JOIN   "purchases" AS p ON p."id" = i."purchase_id"
            WHERE  p."purchased" BETWEEN '2018-12-01' AND '2018-12-31'
            GROUP  BY i."product_id"
      ) dec18
      LEFT JOIN (
            SELECT "product_id", SUM("qty") AS "sales_qty"
            FROM   "monthly_sales"
            WHERE  "mth" = '2019-01-01'
            GROUP  BY "product_id"
      ) jan19 USING ("product_id")
)
SELECT
       jc."product_id",
       jc."jan19_end_qty",
       pm."qty_minimum"
FROM   jan_calc        AS jc
JOIN   product_minimums AS pm ON pm."product_id" = jc."product_id"
WHERE  jc."jan19_end_qty" < pm."qty_minimum"
LIMIT 20;
```

```sql
--Description:  Recursive model for the whole of 2019:
-- 1) Start with Dec‑2018 inventory totals.
-- 2) Subtract monthly sales (0 if none).
-- 3) If ending inventory < minimum, restock by qty_purchase before next month.
-- 4) For every product, keep the 2019 month with the smallest |ending − minimum|.
WITH start_stock AS (
     SELECT i."product_id",
            SUM(i."qty") AS "start_qty"
     FROM   "inventory" AS i
     JOIN   "purchases" AS p ON p."id" = i."purchase_id"
     WHERE  p."purchased" BETWEEN '2018-12-01' AND '2018-12-31'
     GROUP  BY i."product_id"
),
sales AS (
     SELECT "product_id",
            "mth",
            SUM("qty") AS "sales_qty"
     FROM   "monthly_sales"
     WHERE  "mth" BETWEEN '2019-01-01' AND '2019-12-01'
     GROUP  BY "product_id", "mth"
),
running(month_idx, product_id, mth, opening, ending) AS (
     -- month_idx tracks recursion depth (1..12)
     SELECT
            1,
            s."product_id",
            '2019-01-01',
            s."start_qty"                  AS opening,
            s."start_qty" - COALESCE(sa."sales_qty",0) AS ending
     FROM   start_stock AS s
     LEFT   JOIN sales AS sa
            ON sa."product_id" = s."product_id" AND sa."mth" = '2019-01-01'
     UNION ALL
     SELECT
            r.month_idx + 1,
            r.product_id,
            date(r.mth , '+1 month'),
            CASE
                 WHEN r.ending < pm.qty_minimum
                 THEN r.ending + pm.qty_purchase
                 ELSE r.ending
            END                                                          AS opening,
            CASE
                 WHEN r.ending < pm.qty_minimum
                 THEN r.ending + pm.qty_purchase - COALESCE(sa2.sales_qty,0)
                 ELSE r.ending                - COALESCE(sa2.sales_qty,0)
            END                                                          AS ending
     FROM   running          AS r
     JOIN   product_minimums AS pm  ON pm.product_id = r.product_id
     LEFT   JOIN sales       AS sa2 ON sa2.product_id = r.product_id
                                   AND sa2.mth = date(r.mth , '+1 month')
     WHERE  r.month_idx < 12           -- recurse until December
),
abs_gap AS (
     SELECT
            r.product_id,
            r.mth,
            ABS(r.ending - pm.qty_minimum) AS gap
     FROM   running          AS r
     JOIN   product_minimums AS pm USING (product_id)
)
SELECT
       ag.product_id,
       ag.mth      AS closest_month,
       ag.gap      AS abs_difference
FROM (
     SELECT
            product_id,
            mth,
            gap,
            ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY gap) AS rn
     FROM   abs_gap
) ag
WHERE  ag.rn = 1
LIMIT 20;
```
