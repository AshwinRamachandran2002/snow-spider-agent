```sql
--Description: 9) Prototype month‑by‑month inventory recursion for product 4040 over 2016 (using 2015‑12‑01 as the notional opening month).
WITH RECURSIVE
base AS (
    SELECT 4040             AS product_id,
           '2015-12-01'     AS mth,
           SUM(qty)         AS ending_qty
    FROM   inventory
    WHERE  product_id = 4040
),
calendar AS (
    SELECT '2016-01-01' AS mth
    UNION ALL
    SELECT DATE(mth, '+1 month')
    FROM   calendar
    WHERE  mth < '2016-12-01'
),
tx AS (
    SELECT mth, product_id, -qty AS delta
    FROM   monthly_sales
    WHERE  product_id = 4040
      AND  mth BETWEEN '2016-01-01' AND '2016-12-01'
    UNION ALL
    SELECT purchased AS mth, product_id, qty AS delta
    FROM   purchases
    WHERE  product_id = 4040
      AND  purchased BETWEEN '2016-01-01' AND '2016-12-31'
),
mon AS (
    SELECT c.mth,
           COALESCE(SUM(t.delta), 0) AS net_delta
    FROM   calendar AS c
    LEFT   JOIN tx AS t
           ON t.mth = c.mth
    GROUP  BY c.mth
),
rec(product_id, mth, ending_qty) AS (
    -- January
    SELECT base.product_id,
           '2016-01-01' AS mth,
           base.ending_qty + mon.net_delta
    FROM   base
    JOIN   mon ON mon.mth = '2016-01-01'
    UNION ALL
    -- subsequent months, adding purchase lot when below minimum
    SELECT r.product_id,
           DATE(r.mth,'+1 month') AS mth,
           (CASE
                WHEN r.ending_qty < (SELECT qty_minimum
                                     FROM   product_minimums
                                     WHERE  product_id = r.product_id)
                THEN r.ending_qty +
                     (SELECT qty_purchase
                      FROM   product_minimums
                      WHERE  product_id = r.product_id)
                ELSE r.ending_qty
            END) +
            (SELECT mon.net_delta
             FROM   mon
             WHERE  mon.mth = DATE(r.mth,'+1 month'))
    FROM   rec AS r
    WHERE  r.mth < '2016-12-01'
)
SELECT *
FROM   rec
LIMIT 20;
```

```sql
--Description: 10) Full recursive model for every product over 2016; for each product, return the month whose ending stock is closest to its minimum.
WITH RECURSIVE
open AS (
    SELECT pm.product_id,
           COALESCE(SUM(i.qty), 0) AS opening_qty
    FROM   product_minimums pm
    LEFT   JOIN inventory i ON i.product_id = pm.product_id
    GROUP  BY pm.product_id
),
calendar(mth) AS (
    SELECT '2016-01-01'
    UNION ALL
    SELECT DATE(mth,'+1 month') FROM calendar WHERE mth < '2016-12-01'
),
tx AS (
    SELECT product_id, mth, -qty AS delta
    FROM   monthly_sales
    WHERE  mth BETWEEN '2016-01-01' AND '2016-12-01'
    UNION ALL
    SELECT product_id, purchased AS mth, qty
    FROM   purchases
    WHERE  purchased BETWEEN '2016-01-01' AND '2016-12-31'
),
deltas AS (
    SELECT cal.mth,
           pm.product_id,
           COALESCE(SUM(tx.delta), 0) AS net_delta
    FROM   product_minimums pm
    CROSS  JOIN calendar cal
    LEFT   JOIN tx
           ON tx.product_id = pm.product_id
          AND tx.mth       = cal.mth
    GROUP  BY pm.product_id, cal.mth
),
rec(product_id, mth, ending_qty) AS (
    -- January calculation
    SELECT d.product_id,
           d.mth,
           open.opening_qty + d.net_delta
    FROM   deltas d
    JOIN   open ON open.product_id = d.product_id
    WHERE  d.mth = '2016-01-01'
    UNION ALL
    -- Subsequent months with restock logic
    SELECT d.product_id,
           d.mth,
           (CASE
                WHEN r.ending_qty < pm.qty_minimum
                     THEN r.ending_qty + pm.qty_purchase
                ELSE r.ending_qty
            END) + d.net_delta
    FROM   rec       r
    JOIN   deltas    d  ON d.product_id = r.product_id
                       AND d.mth       = DATE(r.mth,'+1 month')
    JOIN   product_minimums pm USING(product_id)
),
diffs AS (
    SELECT product_id,
           mth,
           ABS(ending_qty - pm.qty_minimum) AS abs_gap
    FROM   rec
    JOIN   product_minimums pm USING(product_id)
)
SELECT product_id,
       mth            AS closest_mth_2016,
       abs_gap        AS smallest_abs_gap
FROM   (
    SELECT product_id,
           mth,
           abs_gap,
           ROW_NUMBER() OVER (PARTITION BY product_id
                              ORDER BY abs_gap, mth) AS rn
    FROM   diffs
)
WHERE  rn = 1
LIMIT 20;
```
