```sql
WITH
/* opening balance taken as the quantity that is sitting in the inventory
   on 2018‑12‑31 (the table holds the latest snapshot) */
open AS (
    SELECT pm.product_id,
           COALESCE(SUM(i.qty),0) AS opening_qty
    FROM   product_minimums pm
    LEFT   JOIN inventory i USING(product_id)
    GROUP  BY pm.product_id
),
/* calendar of the 12 months of 2019 */
calendar(mth) AS (
    SELECT '2019-01-01'
    UNION ALL
    SELECT date(mth,'+1 month')
    FROM   calendar
    WHERE  mth < '2019-12-01'
),
/* all movements that change stock, expressed as a monthly net delta
   (sales are negative, purchase receipts are positive)               */
tx AS (
    /* outflow – sales */
    SELECT product_id,
           mth,
           -qty AS delta
    FROM   monthly_sales
    WHERE  mth BETWEEN '2019-01-01' AND '2019-12-01'

    UNION ALL

    /* inflow – purchases (collapsed to month‑start to match calendar) */
    SELECT product_id,
           date(purchased,'start of month') AS mth,
           qty  AS delta
    FROM   purchases
    WHERE  purchased BETWEEN '2019-01-01' AND '2019-12-31'
),
/* net delta for every product / month pair (zero when no movements) */
deltas AS (
    SELECT pm.product_id,
           cal.mth,
           COALESCE(SUM(tx.delta),0) AS net_delta
    FROM   product_minimums pm
    CROSS  JOIN calendar cal
    LEFT   JOIN tx
           ON tx.product_id = pm.product_id
          AND tx.mth       = cal.mth
    GROUP  BY pm.product_id, cal.mth
),
/* recursive month‑by‑month inventory calculation with auto‑replenish */
rec(product_id, mth, ending_qty) AS (
    /* January 2019 = opening balance + that month’s net delta */
    SELECT d.product_id,
           d.mth,
           open.opening_qty + d.net_delta
    FROM   deltas d
    JOIN   open ON open.product_id = d.product_id
    WHERE  d.mth = '2019-01-01'

    UNION ALL

    /* February‑December: add purchase lot if previous month closed
       below minimum, then apply this month’s net delta              */
    SELECT d.product_id,
           d.mth,
           (CASE
                WHEN r.ending_qty < pm.qty_minimum
                     THEN r.ending_qty + pm.qty_purchase
                ELSE r.ending_qty
            END) + d.net_delta
    FROM   rec              r
    JOIN   deltas           d  ON d.product_id = r.product_id
                               AND d.mth       = date(r.mth,'+1 month')
    JOIN   product_minimums pm ON pm.product_id = r.product_id
),
/* absolute gap between ending stock and minimum each month */
diffs AS (
    SELECT product_id,
           mth,
           ABS(ending_qty - pm.qty_minimum) AS abs_diff
    FROM   rec
    JOIN   product_minimums pm USING(product_id)
),
/* pick, per product, the month with the smallest gap */
ranked AS (
    SELECT product_id,
           mth,
           abs_diff,
           ROW_NUMBER() OVER (PARTITION BY product_id
                              ORDER BY abs_diff, mth) AS rn
    FROM   diffs
)
SELECT product_id,
       mth   AS month,
       abs_diff AS abs_difference
FROM   ranked
WHERE  rn = 1
ORDER  BY product_id;
