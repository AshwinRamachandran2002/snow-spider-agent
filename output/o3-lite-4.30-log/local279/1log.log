--Description: 7) Compare each product’s current inventory with its minimum to see the immediate stock gap.
SELECT pmin."product_id",
       COALESCE(inv."current_qty", 0)                      AS "opening_qty",
       pmin."qty_minimum",
       ABS(COALESCE(inv."current_qty", 0) - pmin."qty_minimum") AS "opening_abs_gap"
