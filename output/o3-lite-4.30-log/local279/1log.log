```sql
-- 9. Prototype recursive calculation for a single product (4040) over 2019
WITH RECURSIVE
base AS (
    -- start with Dec‑2018 ending stock
    SELECT 4040      AS product_id,
           '2018-12-01' AS mth,
           SUM(qty) AS ending_qty
    FROM   inventory
    WHERE  product_id = 4040
),
calendar AS (
    SELECT '2019-01-01' AS mth
    UNION ALL
    SELECT date(mth, '+1 month')
    FROM   calendar
    WHERE  mth < '2019-12-01'
),
tx AS (
    SELECT mth, product_id, qty * -1 AS delta
    FROM   monthly_sales
    WHERE  product_id = 4040
      AND  mth BETWEEN '2019-01-01' AND '2019-12-01'
    UNION ALL
    SELECT purchased AS mth, product_id, qty        AS delta
    FROM   purchases
    WHERE  product_id = 4040
      AND  purchased BETWEEN '2019-01-01' AND '2019-12-31'
),
mon AS (
    SELECT c.mth,
           COALESCE(SUM(t.delta), 0) AS net_delta
    FROM   calendar AS c
    LEFT   JOIN tx AS t
           ON t.mth = c.mth
    GROUP  BY c.mth
),
rec(product_id, mth, ending_qty) AS (
    SELECT base.product_id, '2019-01-01', 
           base.ending_qty + mon.net_delta
    FROM   base
    JOIN   mon ON mon.mth = '2019-01-01'
    UNION ALL
    SELECT rec.product_id,
           date(rec.mth,'+1 month'),
           CASE
               WHEN rec.ending_qty < (
                        SELECT qty_minimum
                        FROM product_minimums
                        WHERE product_id = rec.product_id
                    )
               THEN rec.ending_qty
                    + (
                        SELECT qty_purchase
                        FROM product_minimums
                        WHERE product_id = rec.product_id
                      )
               ELSE rec.ending_qty
           END
           + (
               SELECT mon.net_delta
               FROM   mon
               WHERE  mon.mth = date(rec.mth,'+1 month')
             )
    FROM   rec
    WHERE  rec.mth < '2019-12-01'
)
SELECT * FROM rec
LIMIT 20;
```

```sql
-- 10. (Full) Identify per product the 2019 month whose ending stock is closest to its minimum
WITH RECURSIVE
open AS (
    SELECT pm.product_id,
           COALESCE(SUM(i.qty),0) AS opening_qty
    FROM   product_minimums pm
    LEFT   JOIN inventory i ON i.product_id = pm.product_id
    GROUP  BY pm.product_id
),
calendar(mth) AS (
    SELECT '2019-01-01'
    UNION ALL
    SELECT date(mth,'+1 month') FROM calendar WHERE mth < '2019-12-01'
),
tx AS (
    SELECT product_id, mth, -qty AS delta
    FROM   monthly_sales
    WHERE  mth BETWEEN '2019-01-01' AND '2019-12-01'
    UNION ALL
    SELECT product_id, purchased AS mth, qty
    FROM   purchases
    WHERE  purchased BETWEEN '2019-01-01' AND '2019-12-31'
),
deltas AS (
    SELECT cal.mth, pm.product_id, COALESCE(SUM(tx.delta),0) AS net_delta
    FROM   product_minimums pm
    CROSS  JOIN calendar cal
    LEFT   JOIN tx ON tx.product_id = pm.product_id AND tx.mth = cal.mth
    GROUP  BY pm.product_id, cal.mth
),
rec(product_id, mth, ending_qty) AS (
    -- January calculation
    SELECT d.product_id, d.mth,
           open.opening_qty + d.net_delta
    FROM   deltas d
    JOIN   open ON open.product_id = d.product_id
    WHERE  d.mth = '2019-01-01'
    UNION ALL
    -- subsequent months with restock when below minimum
    SELECT d.product_id,
           d.mth,
           (CASE
                WHEN r.ending_qty < pm.qty_minimum
                     THEN r.ending_qty + pm.qty_purchase
                ELSE r.ending_qty
            END) + d.net_delta
    FROM   rec r
    JOIN   deltas d ON d.product_id = r.product_id
                   AND d.mth = date(r.mth,'+1 month')
    JOIN   product_minimums pm ON pm.product_id = r.product_id
),
diffs AS (
    SELECT product_id, mth,
           ABS(ending_qty - pm.qty_minimum) AS abs_gap
    FROM   rec
    JOIN   product_minimums pm USING(product_id)
)
SELECT product_id,
       mth  AS closest_mth_2019,
       abs_gap AS smallest_abs_gap
FROM   (
    SELECT product_id, mth, abs_gap,
           ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY abs_gap, mth) AS rn
    FROM   diffs
) 
WHERE  rn = 1
LIMIT 20;
```

The 10th statement is the fully fledged answer query; statements 1‑9 are incremental explorations that help verify underlying data and logic.
