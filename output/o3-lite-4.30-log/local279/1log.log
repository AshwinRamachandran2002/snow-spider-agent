--Description: 9) Prototype month‑by‑month inventory recursion for product 4040 over 2016 (using 2015‑12‑01 as the notional opening month).
WITH RECURSIVE
base AS (
    SELECT 4040             AS product_id,
           '2015-12-01'     AS mth,
           SUM(qty)         AS ending_qty
    FROM   inventory
    WHERE  product_id = 4040
),
calendar AS (
    SELECT '2016-01-01' AS mth
    UNION ALL
    SELECT DATE(mth, '+1 month')
    FROM   calendar
    WHERE  mth < '2016-12-01'
),
tx AS (
    SELECT mth, product_id, -qty AS delta
    FROM   monthly_sales
    WHERE  product_id = 4040
      AND  mth BETWEEN '2016-01-01' AND '2016-12-01'
    UNION ALL
    SELECT purchased AS mth, product_id, qty AS delta
    FROM   purchases
    WHERE  product_id = 4040
      AND  purchased BETWEEN '2016-01-01' AND '2016-12-31'
),
mon AS (
    SELECT c.mth,
           COALESCE(SUM(t.delta), 0) AS net_delta
    FROM   calendar AS c
    LEFT   JOIN tx AS t
           ON t.mth = c.mth
    GROUP  BY c.mth
),
rec(product_id, mth, ending_qty) AS (
    -- January
    SELECT base.product_id,
           '2016-01-01' AS mth,
           base.ending_qty + mon.net_delta
    FROM   base
    JOIN   mon ON mon.mth = '2016-01-01'
    UNION ALL
    -- subsequent months, adding purchase lot when below minimum
    SELECT r.product_id,
           DATE(r.mth,'+1 month') AS mth,
           (CASE
                WHEN r.ending_qty < (SELECT qty_minimum
                                     FROM   product_minimums
                                     WHERE  product_id = r.product_id)
                THEN r.ending_qty +
                     (SELECT qty_purchase
                      FROM   product_minimums
                      WHERE  product_id = r.product_id)
                ELSE r.ending_qty
            END) +
            (SELECT mon.net_delta
             FROM   mon
             WHERE  mon.mth = DATE(r.mth,'+1 month'))
    FROM   rec AS r
    WHERE  r.mth < '2016-12-01'
)
SELECT *
FROM   rec
LIMIT 20
