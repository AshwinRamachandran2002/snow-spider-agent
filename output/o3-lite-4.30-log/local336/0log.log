```sql
--Description: List races that actually feature early retirements (laps 1‑5). 
--Shows how many cars retired in the opening laps for the first 20 races that meet the criterion.
SELECT
    race_id,
    COUNT(*) AS early_retirement_count
FROM retirements
WHERE lap BETWEEN 1 AND 5
GROUP BY race_id
HAVING early_retirement_count > 0
ORDER BY early_retirement_count DESC
LIMIT 20;
```

```sql
--Description: Find position changes between laps 1 and 2 (on‑track action) for all races, 
--returning only cases where the driver’s position really changed.
SELECT a.race_id,
       a.driver_id,
       a.position AS lap1_pos,
       b.position AS lap2_pos,
       a.position - b.position AS delta
FROM lap_positions AS a
JOIN lap_positions AS b
      ON a.race_id  = b.race_id
     AND a.driver_id = b.driver_id
     AND b.lap       = a.lap + 1
WHERE a.lap = 1
  AND b.lap = 2
  AND a.lap_type = 'Race'
  AND b.lap_type = 'Race'
  AND a.position <> b.position
LIMIT 20;
```

```sql
--Description: Show “early‑pitters” (pit‑stops on laps 1‑5) by joining lap_positions with pit_stops, 
--so we can see the driver’s track position when the stop occurred (across all races).
SELECT lp.race_id,
       lp.driver_id,
       lp.lap            AS track_lap,
       lp.position       AS track_position,
       ps.lap            AS pit_lap
FROM lap_positions AS lp
JOIN pit_stops    AS ps
      ON lp.race_id  = ps.race_id
     AND lp.driver_id = ps.driver_id
     AND ps.lap BETWEEN 1 AND 5
WHERE lp.lap BETWEEN 1 AND 5
  AND lp.lap_type = 'Race'
LIMIT 20;
```

```sql
--Description: Identify laps 1‑5 where a retirement occurred and show which other drivers were still circulating on that same lap. 
--Useful for spotting position gains due to a rival dropping out.
SELECT lp.race_id,
       lp.driver_id         AS continuing_driver,
       lp.lap,
       r.driver_id          AS retired_driver
FROM lap_positions AS lp
JOIN retirements   AS r
      ON lp.race_id = r.race_id
     AND lp.lap     = r.lap
WHERE lp.lap BETWEEN 1 AND 5
LIMIT 20;
```

```sql
--Description: Comprehensive opening‑lap overtake classification for each race (laps 0‑5). 
--Counts overtakes stemming from retirements, pit‑stops, the start itself, and “pure” on‑track passes. 
--Shows the first 20 races in the dataset.
SELECT
    lp0.race_id,
    SUM(CASE WHEN r.driver_id  IS NOT NULL THEN 1 ELSE 0 END)                                   AS retirement_overtakes,
    SUM(CASE WHEN ps.driver_id IS NOT NULL THEN 1 ELSE 0 END)                                   AS pitstop_overtakes,
    SUM(CASE WHEN lp0.lap = 0 AND lp0.position <> lp1.position          THEN 1 ELSE 0 END)      AS start_overtakes,
    SUM(CASE WHEN r.driver_id  IS NULL
              AND ps.driver_id IS NULL
              AND lp0.lap_type = 'Race' AND lp1.lap_type = 'Race'
              AND lp0.position <> lp1.position
              AND lp0.lap BETWEEN 1 AND 4                                   THEN 1 ELSE 0 END)  AS standard_ontrack_overtakes
FROM lap_positions AS lp0
JOIN lap_positions AS lp1
      ON lp0.race_id  = lp1.race_id
     AND lp0.driver_id = lp1.driver_id
     AND lp1.lap       = lp0.lap + 1
LEFT JOIN pit_stops  AS ps
      ON lp0.race_id  = ps.race_id
     AND lp0.driver_id = ps.driver_id
     AND ps.lap        = lp1.lap
LEFT JOIN retirements AS r
      ON lp0.race_id = r.race_id
     AND r.lap       = lp1.lap
WHERE lp0.lap BETWEEN 0 AND 4
GROUP BY lp0.race_id
LIMIT 20;
```
