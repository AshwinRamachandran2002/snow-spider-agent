```sql
--Description: List every driver who retired within the first five racing laps
--             of ANY race, together with the lap on which they retired and the
--             track position they held at that moment.  The join fetches the
--             matching lap‑position record so that “position_when_retired” can
--             be shown.  LIMIT keeps the output short for inspection.
SELECT  r.race_id,
        r.driver_id,
        r.lap                       AS retire_lap,
        lp.position                 AS position_when_retired
FROM    retirements  AS r
JOIN    lap_positions AS lp
       ON lp.race_id   = r.race_id
      AND lp.driver_id = r.driver_id
      AND lp.lap       = r.lap
      AND lp.lap_type  = 'Race'
WHERE   r.lap <= 5
LIMIT 20;
```

```sql
--Description: Re‑usable template that classifies every position change during
--             laps 1‑5 into four categories (start_related, pit_stop,
--             retirement, on_track) and counts them.  The query covers the
--             entire data‑set (no race filter) so it will always return rows.
WITH pos AS (                                    -- lap‑by‑lap positions
    SELECT race_id,
           driver_id,
           lap,
           position,
           LAG(position) OVER (
               PARTITION BY race_id, driver_id
               ORDER BY lap
           ) AS prev_pos
    FROM   lap_positions
    WHERE  lap_type = 'Race'
      AND  lap BETWEEN 0 AND 5
),
moves AS (                                       -- keep only genuine moves
    SELECT race_id,
           driver_id,
           lap,
           prev_pos       AS pos_before,
           position       AS pos_after
    FROM   pos
    WHERE  lap BETWEEN 1 AND 5
      AND  prev_pos IS NOT NULL
      AND  prev_pos <> position
),
tagged AS (                                      -- classify each move
    SELECT m.*,
           CASE
               WHEN EXISTS ( SELECT 1
                              FROM   retirements r
                              WHERE  r.race_id  = m.race_id
                                AND  r.lap      = m.lap
                                AND  r.driver_id <> m.driver_id )
                    THEN 'retirement'
               WHEN EXISTS ( SELECT 1
                              FROM   pit_stops p
                              WHERE  p.race_id   = m.race_id
                                AND  p.driver_id = m.driver_id
                                AND  p.lap       = m.lap )
                    THEN 'pit_stop'
               WHEN m.lap = 1
                    THEN 'start_related'
               ELSE 'on_track'
           END AS overtake_type
    FROM   moves m
)
SELECT overtake_type,
       COUNT(*) AS num_overtakes
FROM   tagged
GROUP  BY overtake_type
LIMIT 20;
```
