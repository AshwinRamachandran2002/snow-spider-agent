```sql
--Description: Count how many overtakes in the first five racing laps of
--             race_id = 1 fall into four categories:
--             • start_related   – changes that happen on lap 1 vs. the grid
--             • pit_stop        – driver pits on that lap and his position changes
--             • retirement      – someone else retires on that very lap and the
--                                 driver’s position changes as a consequence
--             • on_track        – every other genuine pass
--             Steps
--             1.  Pull positions for laps 0‑5, then with LAG() create a row‑
--                 by‑row “move” whenever a driver’s position differs from the
--                 previous lap.
--             2.  Tag each move according to the priority order shown above.
--             3.  Aggregate to obtain the counts per overtake type.
--
--NOTE: remove or change the race_id filter to analyse another race or all races.
WITH pos AS (                         -- lap‑by‑lap positions incl. grid (lap 0)
    SELECT race_id,
           driver_id,
           lap,
           position,
           LAG(position) OVER (
               PARTITION BY race_id, driver_id
               ORDER BY lap
           ) AS prev_position
    FROM   lap_positions
    WHERE  lap_type = 'Race'
      AND  lap BETWEEN 0 AND 5
      AND  race_id = 1                -- <<< choose the race here
),
moves AS (                            -- keep only laps where position changed
    SELECT race_id,
           driver_id,
           lap,
           prev_position  AS pos_before,
           position       AS pos_after,
           (COALESCE(prev_position, position) - position) AS delta
    FROM   pos
    WHERE  lap BETWEEN 1 AND 5
      AND  prev_position IS NOT NULL
      AND  prev_position <> position
),
tagged AS (                           -- classify the move
    SELECT m.*,
           CASE
               WHEN EXISTS ( SELECT 1
                              FROM   retirements r
                              WHERE  r.race_id  = m.race_id
                                AND  r.lap      = m.lap
                                AND  r.driver_id <> m.driver_id )
                    THEN 'retirement'
               WHEN EXISTS ( SELECT 1
                              FROM   pit_stops  p
                              WHERE  p.race_id   = m.race_id
                                AND  p.driver_id = m.driver_id
                                AND  p.lap       = m.lap )
                    THEN 'pit_stop'
               WHEN m.lap = 1
                    THEN 'start_related'
               ELSE 'on_track'
           END AS overtake_type
    FROM   moves m
)
SELECT overtake_type,
       COUNT(*) AS num_overtakes
FROM   tagged
GROUP  BY overtake_type;
```
