--Description: List every driver who retired within the first five racing laps
--             of ANY race, together with the lap on which they retired and the
--             track position they held at that moment.  The join fetches the
--             matching lap‑position record so that “position_when_retired” can
--             be shown.  LIMIT keeps the output short for inspection.
SELECT  r.race_id,
        r.driver_id,
        r.lap                       AS retire_lap,
