                 WHERE r."race_id" = m."race_id"
                   AND r."lap"     = m."lap"
                   AND r."driver_id" <> m."driver_id"
            ) THEN 'retirement'
            WHEN EXISTS (                       -- the gaining driver pits this lap
                 SELECT 1 FROM "pit_stops" p
                 WHERE p."race_id"  = m."race_id"
                   AND p."driver_id"= m."driver_id"
                   AND p."lap"      = m."lap"
            ) THEN 'pit_stop'
            WHEN m."lap" = 1 THEN 'start_related'
            ELSE 'on_track'
        END AS overtake_type
    FROM moves m
)
SELECT
    "overtake_type" AS overtake_type,
    COUNT(*)        AS overtake_count
FROM tagged
GROUP BY "overtake_type"
ORDER BY "overtake_type";
