The table structure information is (table names): 
['circuits', 'constructor_results', 'constructor_standings', 'constructors', 'driver_standings', 'drivers', 'lap_times', 'pit_stops', 'qualifying', 'races', 'results', 'seasons', 'status', 'sprint_results', 'short_grand_prix_names', 'short_constructor_names', 'liveries', 'tdr_overrides', 'circuits_ext', 'constructors_ext', 'drivers_ext', 'driver_standings_ext', 'lap_times_ext', 'lap_time_stats', 'races_ext', 'team_driver_ranks', 'drives', 'retirements', 'lap_positions']
Begin Exploring Related Columns
Relevant columns, why they matter & typical filters
• lap_positions.lap : lap number; WHERE lap BETWEEN 0 AND 5  
• lap_positions.position : ranking on every lap; used to see position changes  
• lap_positions.lap_type : distinguishes the grid snapshot (lap 0, ‘Starting Position – Grid Drop’) from true race laps (lap ≥1, ‘Race’)  
• lap_positions.race_id / driver_id : keys for joining other tables and scoping to one event  
• pit_stops.lap : lap on which a stop happened; WHERE lap ≤ 5 gives early‑stop occasions  
• pit_stops.race_id / driver_id : join back to lap_positions to see position loss/gain after a stop  
• retirements.lap : lap on which a car retired; WHERE lap ≤ 5 counts early‑race DNFs that trigger “overtakes by retirement”  
• retirements.race_id / driver_id / status_id : link to lap_positions so we know when a car disappeared  
• results.grid : original grid slot; compare with lap_positions at lap 1 to measure start‑phase changes  
• results.race_id / driver_id : join key  
Typical conditions  
• race_id = ?            -- focus on one race  
• lap BETWEEN 0 AND 5    -- first five laps only  
• lap_type = 'Race'      -- ignore grid rows when analysing on‑track passes  

Ten exploratory‑to‑final SQL queries
```sql
--1️⃣  All position snapshots (grid + laps 1‑5) for one race
SELECT DISTINCT "race_id","driver_id","lap","position","lap_type"
FROM "lap_positions"
WHERE "race_id" = 1 AND "lap" <= 5
LIMIT 20;
```

```sql
--2️⃣  Early‑race pit‑stop events (≤ lap 5)
SELECT DISTINCT "race_id","driver_id","lap","stop"
FROM "pit_stops"
WHERE "lap" <= 5
LIMIT 20;
```

```sql
--3️⃣  Retirements that happened in the first five laps
SELECT DISTINCT "race_id","driver_id","lap","retirement_type"
FROM "retirements"
WHERE "lap" <= 5
LIMIT 20;
```

```sql
--4️⃣  Starting grid versus finishing position after lap 1
SELECT DISTINCT r."driver_id",
                r."grid"          AS "grid_pos",
                p."position"      AS "lap1_pos"
FROM "results"       AS r
JOIN "lap_positions" AS p
  ON p."race_id" = r."race_id"
 AND p."driver_id" = r."driver_id"
WHERE r."race_id" = 1
  AND p."lap" = 1
LIMIT 20;
```

```sql
--5️⃣  Count of retirements in laps 1‑5 (proxy for ‘retirement‑overtakes’)
SELECT COUNT(DISTINCT "driver_id") AS "retirement_overtakes"
FROM "retirements"
WHERE "race_id" = 1
  AND "lap" BETWEEN 1 AND 5;
```

```sql
--6️⃣  Count of pit‑stop occurrences in laps 1‑5 (proxy for ‘pit‑overtakes’)
SELECT COUNT(*) AS "pitstop_overtakes"
FROM "pit_stops"
WHERE "race_id" = 1
  AND "lap" BETWEEN 1 AND 5;
```

```sql
--7️⃣  Start‑phase overtakes: drivers who improved position from grid to lap 1
SELECT COUNT(*) AS "start_overtakes"
FROM (
    SELECT r."driver_id"
    FROM "results"       AS r
    JOIN "lap_positions" AS p
      ON p."race_id" = r."race_id"
     AND p."driver_id" = r."driver_id"
    WHERE r."race_id" = 1
      AND p."lap" = 1
      AND p."position" < r."grid"      -- lower number = better position
);
```

```sql
--8️⃣  Raw position changes between consecutive laps 1‑5 (all on‑track moves)
SELECT COUNT(*) AS "position_changes"
FROM (
    SELECT lp1."driver_id", lp1."lap", lp1."position" AS "pos_now",
           lp0."position"        AS "pos_prev"
    FROM "lap_positions" AS lp1
    JOIN "lap_positions" AS lp0
      ON lp1."race_id" = lp0."race_id"
     AND lp1."driver_id" = lp0."driver_id"
     AND lp1."lap" = lp0."lap" + 1
    WHERE lp1."race_id" = 1
      AND lp1."lap_type" = 'Race'
      AND lp1."lap" BETWEEN 1 AND 5
      AND lp1."position" <> lp0."position"
);
```

```sql
--9️⃣  Standard on‑track passes = total position changes minus those due to starts, pits or retirements
WITH
    pos_chg AS (  -- all lap‑to‑lap changes 1‑5
        SELECT lp1."driver_id", lp1."lap"
        FROM "lap_positions" AS lp1
        JOIN "lap_positions" AS lp0
          ON lp1."race_id" = lp0."race_id"
         AND lp1."driver_id" = lp0."driver_id"
         AND lp1."lap" = lp0."lap" + 1
        WHERE lp1."race_id" = 1
          AND lp1."lap" BETWEEN 1 AND 5
          AND lp1."position" <> lp0."position"
    ),
    pit_evt AS (
        SELECT "driver_id","lap" FROM "pit_stops"
        WHERE "race_id" = 1 AND "lap" BETWEEN 1 AND 5
    ),
    dnf_evt AS (
        SELECT "driver_id","lap" FROM "retirements"
        WHERE "race_id" = 1 AND "lap" BETWEEN 1 AND 5
    ),
    start_evt AS (  -- any change grid→lap1
        SELECT r."driver_id", 1 AS "lap"
        FROM "results" AS r
        JOIN "lap_positions" AS p
          ON p."race_id" = r."race_id"
         AND p."driver_id" = r."driver_id"
        WHERE r."race_id" = 1 AND p."lap" = 1
              AND p."position" <> r."grid"
    )
SELECT COUNT(*) AS "ontrack_overtakes"
FROM pos_chg pc
LEFT JOIN pit_evt   USING ("driver_id","lap")
LEFT JOIN dnf_evt   USING ("driver_id","lap")
LEFT JOIN start_evt USING ("driver_id","lap")
WHERE pit_evt."driver_id"   IS NULL
  AND dnf_evt."driver_id"   IS NULL
  AND start_evt."driver_id" IS NULL;
```

```sql
--🔟  Summary: overtakes per category in the first five laps
WITH
    retirement_ct AS (
        SELECT COUNT(*) AS cnt FROM "retirements"
        WHERE "race_id" = 1 AND "lap" BETWEEN 1 AND 5
    ),
    pit_ct AS (
        SELECT COUNT(*) AS cnt FROM "pit_stops"
        WHERE "race_id" = 1 AND "lap" BETWEEN 1 AND 5
    ),
    start_ct AS (
        SELECT COUNT(*) AS cnt
        FROM "results" AS r
        JOIN "lap_positions" AS p
          ON p."race_id" = r."race_id"
         AND p."driver_id" = r."driver_id"
        WHERE r."race_id" = 1 AND p."lap" = 1
              AND p."position" <> r."grid"
    ),
    ontrack_ct AS (   -- reuse logic from query 9
        WITH
            pos_chg AS (
                SELECT lp1."driver_id", lp1."lap"
                FROM "lap_positions" AS lp1
                JOIN "lap_positions" AS lp0
                  ON lp1."race_id" = lp0."race_id"
                 AND lp1."driver_id" = lp0."driver_id"
                 AND lp1."lap" = lp0."lap" + 1
                WHERE lp1."race_id" = 1
                  AND lp1."lap" BETWEEN 1 AND 5
                  AND lp1."position" <> lp0."position"
            ),
            pit_evt AS (SELECT "driver_id","lap"
                        FROM "pit_stops"
                        WHERE "race_id" = 1 AND "lap" BETWEEN 1 AND 5),
            dnf_evt AS (SELECT "driver_id","lap"
                        FROM "retirements"
                        WHERE "race_id" = 1 AND "lap" BETWEEN 1 AND 5),
            start_evt AS (SELECT r."driver_id", 1 AS "lap"
                          FROM "results" AS r
                          JOIN "lap_positions" AS p
                            ON p."race_id" = r."race_id"
                           AND p."driver_id" = r."driver_id"
                          WHERE r."race_id" = 1 AND p."lap" = 1
                                AND p."position" <> r."grid")
        SELECT COUNT(*) AS cnt
        FROM pos_chg pc
        LEFT JOIN pit_evt   USING ("driver_id","lap")
        LEFT JOIN dnf_evt   USING ("driver_id","lap")
        LEFT JOIN start_evt USING ("driver_id","lap")
        WHERE pit_evt."driver_id"   IS NULL
          AND dnf_evt."driver_id"   IS NULL
          AND start_evt."driver_id" IS NULL
    )
SELECT 'Retirements'          AS category, (SELECT cnt FROM retirement_ct) AS overtakes UNION ALL
SELECT 'Pit stops'            AS category, (SELECT cnt FROM pit_ct)        AS overtakes UNION ALL
SELECT 'Start‑phase'          AS category, (SELECT cnt FROM start_ct)      AS overtakes UNION ALL
SELECT 'Standard on‑track'    AS category, (SELECT cnt FROM ontrack_ct)    AS overtakes;
```
