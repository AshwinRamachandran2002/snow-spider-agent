```sql
-- total balance on the 1st day of each month, then previous‑month balance (negative -> 0)
WITH daily_net AS (           -- net movement per calendar day
    SELECT
        txn_date,
        SUM(CASE
                WHEN txn_type = 'deposit'    THEN  txn_amount      -- add deposits
                WHEN txn_type = 'withdrawal' THEN -1 * txn_amount  -- subtract withdrawals
                ELSE 0                                            -- ignore other types
            END) AS net_amount
    FROM customer_transactions
    GROUP BY txn_date
),
running_bal AS (              -- cumulative platform balance day‑by‑day
    SELECT
        txn_date,
        SUM(net_amount) OVER (ORDER BY txn_date) AS total_balance
    FROM daily_net
),
month_starts AS (             -- snapshot on the 1‑st of every month
    SELECT
        substr(txn_date,1,7)             AS month,          -- YYYY‑MM
        total_balance
    FROM running_bal
    WHERE substr(txn_date,9,2) = '01'                       -- keep only day = 01
),
with_prev AS (                -- attach previous month’s balance
    SELECT
        month,
        LAG(total_balance) OVER (ORDER BY month) AS prev_month_balance
    FROM month_starts
)
SELECT
    month,
    CASE 
        WHEN prev_month_balance < 0 THEN 0                 -- replace negatives with zero
        ELSE prev_month_balance
    END AS total_balance_prev_month
FROM with_prev
WHERE prev_month_balance IS NOT NULL                       -- drop the very first month
ORDER BY month;
