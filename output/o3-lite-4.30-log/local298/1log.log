Begin Exploring Related Columns
column name: potential usage
• customer_transactions.customer_id: identify each user whose balance contributes to monthly total  
• customer_transactions.txn_date: place transactions in time so we can isolate everything that happened before the 1st of every month  
• customer_transactions.txn_type: decide whether a record increases the balance (“deposit”) or decreases it (“withdrawal”)  
• customer_transactions.txn_amount: amount to add or subtract when building each user’s running balance  

Typical conditions that will be required  
• WHERE txn_type = 'deposit'  -- treat the amount as positive  
• WHERE txn_type = 'withdrawal' -- treat the amount as negative  
• WHERE DATE(txn_date) < 'YYYY‑MM‑01'  -- bring the balance up to (but not including) the 1st of the month we want  
• GROUP BY customer_id, snapshot_month -- calculate running balance per user per month  
• CASE WHEN balance < 0 THEN 0 END     -- replace any negative balances with zero  
• Exclude the very first snapshot month in the final SELECT  

Below are ten exploratory SQL queries (LIMIT 20 rows each, all using DISTINCT whenever sensible) that go from simple inspection to more advanced steps which will be useful when writing the final solution.

```sql
-- 1. Description: Look at the different transaction types that exist.
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 2. Description: Peek at a handful of raw customer‑transaction records in time order.
SELECT "customer_id",
       "txn_date",
       "txn_type",
       "txn_amount"
FROM   "customer_transactions"
ORDER  BY "txn_date"
LIMIT 20;
```

```sql
-- 3. Description: Extract year‑month (YYYY‑MM) for every transaction so we see the span of data.
SELECT DISTINCT strftime('%Y-%m', "txn_date") AS "year_month"
FROM   "customer_transactions"
ORDER  BY "year_month"
LIMIT 20;
```

```sql
-- 4. Description: Find the first transaction date that exists for each customer.
SELECT "customer_id",
       MIN("txn_date") AS "first_txn_date"
FROM   "customer_transactions"
GROUP  BY "customer_id"
ORDER  BY "first_txn_date"
LIMIT 20;
```

```sql
-- 5. Description: Calculate each customer’s net amount by month
--                 (deposits positive, withdrawals negative).
SELECT strftime('%Y-%m', "txn_date")           AS "month",
       "customer_id",
       SUM(CASE WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
           END)                                AS "net_monthly_amount"
FROM   "customer_transactions"
GROUP  BY "month", "customer_id"
ORDER  BY "month", "customer_id"
LIMIT 20;
```

```sql
-- 6. Description: Cumulative balance per customer up to (but not including) 2020‑03‑01.
SELECT "customer_id",
       SUM(CASE WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                WHEN "txn_type" = 'withdrawal' THEN - "txn_amount"
           END)                                AS "balance_to_2020_03_01"
FROM   "customer_transactions"
WHERE  DATE("txn_date") < '2020-03-01'
GROUP  BY "customer_id"
LIMIT 20;
```

```sql
-- 7. Description: Snapshot every customer’s balance as at the first of each month.
WITH months AS (
  SELECT DISTINCT DATE(strftime('%Y-%m-01', "txn_date")) AS "month_start"
  FROM   "customer_transactions"
)
SELECT m."month_start",
       ct."customer_id",
       SUM(CASE WHEN ct."txn_type" = 'deposit'    THEN  ct."txn_amount"
                WHEN ct."txn_type" = 'withdrawal' THEN - ct."txn_amount"
           END) AS "balance"
FROM   months  AS m
JOIN   "customer_transactions" AS ct
       ON DATE(ct."txn_date") < m."month_start"
GROUP  BY m."month_start", ct."customer_id"
ORDER  BY m."month_start", ct."customer_id"
LIMIT 20;
```

```sql
-- 8. Description: Apply the “no negative balances” rule at the customer level
--                 for snapshot 2020‑04‑01.
WITH bal AS (
  SELECT ct."customer_id",
         SUM(CASE WHEN ct."txn_type" = 'deposit'    THEN  ct."txn_amount"
                  WHEN ct."txn_type" = 'withdrawal' THEN - ct."txn_amount"
             END) AS "raw_bal"
  FROM   "customer_transactions" ct
  WHERE  DATE(ct."txn_date") < '2020-04-01'
  GROUP  BY ct."customer_id"
)
SELECT "customer_id",
       CASE WHEN "raw_bal" < 0 THEN 0 ELSE "raw_bal" END AS "adjusted_bal"
FROM   bal
LIMIT 20;
```

```sql
-- 9. Description: Total adjusted balance for ALL users as at 2020‑04‑01.
WITH bal AS (
  SELECT ct."customer_id",
         SUM(CASE WHEN ct."txn_type" = 'deposit'    THEN  ct."txn_amount"
                  WHEN ct."txn_type" = 'withdrawal' THEN - ct."txn_amount"
             END) AS "raw_bal"
  FROM   "customer_transactions" ct
  WHERE  DATE(ct."txn_date") < '2020-04-01'
  GROUP  BY ct."customer_id"
), adj AS (
  SELECT CASE WHEN "raw_bal" < 0 THEN 0 ELSE "raw_bal" END AS "adj_bal"
  FROM   bal
)
SELECT SUM("adj_bal") AS "total_adjusted_balance"
FROM   adj;
```

```sql
--10. Description: Build the full month‑by‑month series (excluding the first)
--                 and sum the adjusted balances across users.
WITH month_list AS (
  SELECT DISTINCT DATE(strftime('%Y-%m-01', "txn_date")) AS "month_start"
  FROM   "customer_transactions"
),
ordered_months AS (
  SELECT "month_start",
         ROW_NUMBER() OVER (ORDER BY "month_start") AS rn
  FROM   month_list
),
snapshots AS (
  SELECT om2."month_start" AS "current_month",
         om1."month_start" AS "prev_month_start"
  FROM   ordered_months om1
  JOIN   ordered_months om2
         ON om2.rn = om1.rn + 1      -- pair each month with the following month
),
customer_balances AS (
  SELECT s."current_month",
         ct."customer_id",
         SUM(CASE WHEN ct."txn_type" = 'deposit'    THEN  ct."txn_amount"
                  WHEN ct."txn_type" = 'withdrawal' THEN - ct."txn_amount"
             END) AS "raw_bal"
  FROM   snapshots s
  JOIN   "customer_transactions" ct
         ON DATE(ct."txn_date") < s."current_month"
  GROUP  BY s."current_month", ct."customer_id"
),
totals AS (
  SELECT "current_month",
         SUM(CASE WHEN "raw_bal" < 0 THEN 0 ELSE "raw_bal" END) AS "total_adjusted_balance"
  FROM   customer_balances
  GROUP  BY "current_month"
)
SELECT DATE("current_month") AS "month_start",
       "total_adjusted_balance"
FROM   totals
ORDER  BY "current_month"
LIMIT 20;
```
