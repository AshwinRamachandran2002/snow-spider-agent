  AND ab.alt = 'T'                  -- alt is T
  AND v.allele = 'T'                -- annotation refers to this same T allele
  AND v.SYMBOL = 'BRCA1'            -- gene of interest
  AND v.Consequence LIKE '%missense_variant%'   -- missense consequence
ORDER BY
  t.start_position;
