Begin Exploring Related Columns
Relevant columns / typical conditions you will need 

• `reference_name` – filter to chromosome 17  
• `start_position` – the value you finally want to list  
• `reference_bases` – must equal `'C'`  
• `alternate_bases`  
    • UNNEST this array → field `alt` must equal `'T'`  
• `vep`  
    • UNNEST this array → field `SYMBOL` must equal `'BRCA1'`  
    • field `Consequence` contains the string `'missense_variant'`  
    • field `allele` (from the VEP struct) should match the same alternate base (`'T'`) that you kept after unnesting `alternate_bases`

---------------------------------------------------------------------------  
Below are ten example BigQuery SQL snippets – from exploratory to the final answer – showing different ways to look at the data.  
Each query is limited to 20 rows so you can run them safely.  
Replace `YOUR_PROJECT` with your GCP project ID if you copy‑paste.

```sql
-- 1. Quick peek at a couple of BRCA1 rows in the genomes table
SELECT *
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
WHERE reference_name = '17'
  AND reference_bases = 'C'
LIMIT 20;
```

```sql
-- 2. Look only at the alternate_bases array to verify 'C'→'T' SNVs
SELECT start_position, ab.alt
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS ab
WHERE reference_name = '17'
  AND reference_bases = 'C'
  AND ab.alt = 'T'
LIMIT 20;
```

```sql
-- 3. First glance at VEP annotations that mention BRCA1
SELECT start_position, v.SYMBOL, v.Consequence
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(vep) AS v
WHERE v.SYMBOL = 'BRCA1'
LIMIT 20;
```

```sql
-- 4. Join alternate_bases and vep on the allele to be sure you’re keeping the same ‘T’
SELECT DISTINCT start_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS ab,
     UNNEST(vep)            AS v
WHERE reference_name        = '17'
  AND reference_bases       = 'C'
  AND ab.alt                = 'T'
  AND v.allele              = 'T'
  AND v.SYMBOL              = 'BRCA1'
  AND v.Consequence LIKE '%missense_variant%'
LIMIT 20;
```

```sql
-- 5. Same as (4) but showing extra columns for manual inspection
SELECT start_position,
       reference_bases,
       ab.alt               AS alt_base,
       v.Consequence,
       v.Feature            AS transcript,
       v.HGVSc
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS ab,
     UNNEST(vep)            AS v
WHERE reference_name  = '17'
  AND reference_bases = 'C'
  AND ab.alt          = 'T'
  AND v.allele        = 'T'
  AND v.SYMBOL        = 'BRCA1'
  AND v.Consequence LIKE '%missense_variant%'
LIMIT 20;
```

```sql
-- 6. Do the same search in the EXOMES table
SELECT DISTINCT start_position
FROM `bigquery-public-data.gnomAD.v2_1_1_exomes__chr17`,
     UNNEST(alternate_bases) AS ab,
     UNNEST(vep)            AS v
WHERE reference_name  = '17'
  AND reference_bases = 'C'
  AND ab.alt          = 'T'
  AND v.allele        = 'T'
  AND v.SYMBOL        = 'BRCA1'
  AND v.Consequence LIKE '%missense_variant%'
LIMIT 20;
```

```sql
-- 7. Combine GENOMES and EXOMES results with UNION
SELECT DISTINCT start_position
FROM (
  SELECT start_position
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
       UNNEST(alternate_bases) AS ab,
       UNNEST(vep)            AS v
  WHERE reference_name  = '17'
    AND reference_bases = 'C'
    AND ab.alt          = 'T'
    AND v.allele        = 'T'
    AND v.SYMBOL        = 'BRCA1'
    AND v.Consequence LIKE '%missense_variant%'
  UNION DISTINCT
  SELECT start_position
  FROM `bigquery-public-data.gnomAD.v2_1_1_exomes__chr17`,
       UNNEST(alternate_bases) AS ab,
       UNNEST(vep)            AS v
  WHERE reference_name  = '17'
    AND reference_bases = 'C'
    AND ab.alt          = 'T'
    AND v.allele        = 'T'
    AND v.SYMBOL        = 'BRCA1'
    AND v.Consequence LIKE '%missense_variant%'
)
ORDER BY start_position
LIMIT 20;
```

```sql
-- 8. Add the gnomAD allele count (AC) to see population support
SELECT DISTINCT g.start_position,
       ab.AC,
       ab.AF
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS g,
     UNNEST(g.alternate_bases) AS ab,
     UNNEST(g.vep)            AS v
WHERE g.reference_name = '17'
  AND g.reference_bases = 'C'
  AND ab.alt            = 'T'
  AND v.allele          = 'T'
  AND v.SYMBOL          = 'BRCA1'
  AND v.Consequence LIKE '%missense_variant%'
LIMIT 20;
```

```sql
-- 9. Get all distinct start positions from GENOMES only (production query)
SELECT DISTINCT start_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(alternate_bases) AS ab,
     UNNEST(vep)            AS v
WHERE reference_name  = '17'
  AND reference_bases = 'C'
  AND ab.alt          = 'T'
  AND v.allele        = 'T'
  AND v.SYMBOL        = 'BRCA1'
  AND v.Consequence LIKE '%missense_variant%'
ORDER BY start_position;
```

```sql
-- 10. Final two‑table query that returns the union of all unique start positions
--     satisfying the conditions in either data set (no LIMIT)
SELECT DISTINCT start_position
FROM (
  -- genomes
  SELECT start_position
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
       UNNEST(alternate_bases) AS ab,
       UNNEST(vep)            AS v
  WHERE reference_name  = '17'
    AND reference_bases = 'C'
    AND ab.alt          = 'T'
    AND v.allele        = 'T'
    AND v.SYMBOL        = 'BRCA1'
    AND v.Consequence LIKE '%missense_variant%'
  UNION DISTINCT
  -- exomes
  SELECT start_position
  FROM `bigquery-public-data.gnomAD.v2_1_1_exomes__chr17`,
       UNNEST(alternate_bases) AS ab,
       UNNEST(vep)            AS v
  WHERE reference_name  = '17'
    AND reference_bases = 'C'
    AND ab.alt          = 'T'
    AND v.allele        = 'T'
    AND v.SYMBOL        = 'BRCA1'
    AND v.Consequence LIKE '%missense_variant%'
)
ORDER BY start_position;
```

