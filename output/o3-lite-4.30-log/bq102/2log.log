FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS g
CROSS JOIN UNNEST(g.alternate_bases) AS ab         -- exposes alt, AC, AF
CROSS JOIN UNNEST(g.vep)            AS v           -- exposes allele, SYMBOL, Consequence
WHERE g.reference_name  = '17'                     -- chromosome 17
  AND g.reference_bases = 'C'                      -- reference base C
  AND ab.alt            = 'T'                      -- alternate base T
  AND v.allele          = 'T'                      -- same allele in VEP
  AND v.SYMBOL          = 'BRCA1'                  -- gene BRCA1
  AND v.Consequence     LIKE '%missense_variant%'  -- missense consequence
LIMIT 20;
```
