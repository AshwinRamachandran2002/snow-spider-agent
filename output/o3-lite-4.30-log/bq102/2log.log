```sql
--Description: obtain BRCA1 missense C→T variants on chr17 from gnomAD genomes,
--             returning each start_position with its allele count (AC) and
--             allele frequency (AF).  The table is aliased as g; both nested
--             arrays are flattened via CROSS JOIN UNNEST so their fields can
--             be filtered (alt = 'T', allele = 'T', gene = BRCA1, consequence 
--             contains 'missense_variant').

SELECT DISTINCT
  g.start_position,
  ab.AC,
  ab.AF
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS g
CROSS JOIN UNNEST(g.alternate_bases) AS ab
CROSS JOIN UNNEST(g.vep)            AS v
WHERE g.reference_name  = '17'
  AND g.reference_bases = 'C'
  AND ab.alt            = 'T'
  AND v.allele          = 'T'
  AND v.SYMBOL          = 'BRCA1'
  AND v.Consequence     LIKE '%missense_variant%'
LIMIT 20;
```
