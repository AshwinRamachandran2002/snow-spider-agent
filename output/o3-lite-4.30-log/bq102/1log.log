Begin Exploring Related Columns
Below are the most useful columns for this task and the filtering logic they enable.

column name : potential usage / condition
• `reference_name` : keep only chromosome 17 → `reference_name = '17'`  
• `start_position` : coordinate we finally need to report  
• `reference_bases` : keep only reference allele “C” → `reference_bases = 'C'`  
• `alternate_bases.alt` : keep only alternate allele “T” → `ab.alt = 'T'`  
• `alternate_bases.vep.SYMBOL` : find variants that fall in BRCA1 → `v.SYMBOL = 'BRCA1'`  
• `alternate_bases.vep.Consequence` : keep only missense variants  
  (the string may contain several consequences separated by “&”)  
  → `REGEXP_CONTAINS(v.Consequence, r'\bmissense_variant\b')`

--------------------------------------------------------------------
Ten exploratory‑to‑answer BigQuery SQL statements
--------------------------------------------------------------------

```sql
-- 1. Peek at a few rows to understand the overall structure (genomes)
SELECT *
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
LIMIT 20;
```

```sql
-- 2. Show how many alternate alleles each record can contain
SELECT start_position, ARRAY_LENGTH(alternate_bases) AS n_alt_alleles
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
LIMIT 20;
```

```sql
-- 3. Inspect the ALT alleles for one position
SELECT start_position, ab.alt
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
UNNEST(alternate_bases) AS ab
WHERE start_position = 43044295          -- any example position
LIMIT 20;
```

```sql
-- 4. List distinct gene symbols found on chr17 in the genomes file
SELECT DISTINCT v.SYMBOL
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
UNNEST(alternate_bases) AS ab,
UNNEST(ab.vep)          AS v
ORDER BY v.SYMBOL
LIMIT 50;
```

```sql
-- 5. Check the distribution of consequences for BRCA1 records
SELECT v.Consequence, COUNT(*) AS n
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
UNNEST(alternate_bases) AS ab,
UNNEST(ab.vep)          AS v
WHERE v.SYMBOL = 'BRCA1'
GROUP BY v.Consequence
ORDER BY n DESC
LIMIT 20;
```

```sql
-- 6. Find all BRCA1 variants whose main consequence is missense (genomes)
SELECT DISTINCT start_position, reference_bases, ab.alt, v.Consequence
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
UNNEST(alternate_bases) AS ab,
UNNEST(ab.vep)          AS v
WHERE v.SYMBOL = 'BRCA1'
  AND REGEXP_CONTAINS(v.Consequence, r'\bmissense_variant\b')
LIMIT 20;
```

```sql
-- 7. Apply the nucleotide‑level filters: ref = 'C', alt = 'T'
SELECT DISTINCT start_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
UNNEST(alternate_bases) AS ab,
UNNEST(ab.vep)          AS v
WHERE reference_name = '17'
  AND reference_bases = 'C'
  AND ab.alt           = 'T'
  AND v.SYMBOL         = 'BRCA1'
  AND REGEXP_CONTAINS(v.Consequence, r'\bmissense_variant\b')
ORDER BY start_position
LIMIT 20;
```

```sql
-- 8. Run the same search on the exomes file
SELECT DISTINCT start_position
FROM `bigquery-public-data.gnomAD.v2_1_1_exomes__chr17`,
UNNEST(alternate_bases) AS ab,
UNNEST(ab.vep)          AS v
WHERE reference_name = '17'
  AND reference_bases = 'C'
  AND ab.alt           = 'T'
  AND v.SYMBOL         = 'BRCA1'
  AND REGEXP_CONTAINS(v.Consequence, r'\bmissense_variant\b')
ORDER BY start_position
LIMIT 20;
```

```sql
-- 9. Combine genomes and exomes to see how many unique positions we have
SELECT DISTINCT start_position
FROM (
  -- genomes
  SELECT start_position
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
  UNNEST(alternate_bases) AS ab,
  UNNEST(ab.vep)          AS v
  WHERE reference_name = '17'
    AND reference_bases = 'C'
    AND ab.alt           = 'T'
    AND v.SYMBOL         = 'BRCA1'
    AND REGEXP_CONTAINS(v.Consequence, r'\bmissense_variant\b')
  UNION DISTINCT
  -- exomes
  SELECT start_position
  FROM `bigquery-public-data.gnomAD.v2_1_1_exomes__chr17`,
  UNNEST(alternate_bases) AS ab,
  UNNEST(ab.vep)          AS v
  WHERE reference_name = '17'
    AND reference_bases = 'C'
    AND ab.alt           = 'T'
    AND v.SYMBOL         = 'BRCA1'
    AND REGEXP_CONTAINS(v.Consequence, r'\bmissense_variant\b')
)
ORDER BY start_position
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: list *all* start positions meeting every criterion
SELECT DISTINCT start_position AS missense_start_position
FROM (
  -- genomes
  SELECT start_position
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
  UNNEST(alternate_bases) AS ab,
  UNNEST(ab.vep)          AS v
  WHERE reference_name = '17'
    AND reference_bases = 'C'
    AND ab.alt           = 'T'
    AND v.SYMBOL         = 'BRCA1'
    AND REGEXP_CONTAINS(v.Consequence, r'\bmissense_variant\b')
  UNION DISTINCT
  -- exomes
  SELECT start_position
  FROM `bigquery-public-data.gnomAD.v2_1_1_exomes__chr17`,
  UNNEST(alternate_bases) AS ab,
  UNNEST(ab.vep)          AS v
  WHERE reference_name = '17'
    AND reference_bases = 'C'
    AND ab.alt           = 'T'
    AND v.SYMBOL         = 'BRCA1'
    AND REGEXP_CONTAINS(v.Consequence, r'\bmissense_variant\b')
)
ORDER BY missense_start_position;
```

The last query returns the complete, non‑redundant list of chromosome 17 start positions that correspond to C→T missense variants in the BRCA1 gene, as recorded in gnomAD v2.1.1.
