--Description: Combine genomes and exomes to list unique chr17 positions that
--             satisfy all criteria (BRCA1, C→T, missense) and show the first
--             20 to verify.
SELECT DISTINCT start_position
FROM (
  -- genomes
  SELECT start_position
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
  UNNEST(alternate_bases) AS ab,
  UNNEST(ab.vep)          AS v
  WHERE reference_name  = '17'
    AND reference_bases = 'C'
    AND ab.alt          = 'T'
    AND v.SYMBOL        = 'BRCA1'
    AND REGEXP_CONTAINS(v.Consequence, r'\bmissense_variant\b')
  UNION DISTINCT
  -- exomes
  SELECT start_position
  FROM `bigquery-public-data.gnomAD.v2_1_1_exomes__chr17`,
  UNNEST(alternate_bases) AS ab,
  UNNEST(ab.vep)          AS v
  WHERE reference_name  = '17'
    AND reference_bases = 'C'
    AND ab.alt          = 'T'
    AND v.SYMBOL        = 'BRCA1'
    AND REGEXP_CONTAINS(v.Consequence, r'\bmissense_variant\b')
)
ORDER BY start_position
LIMIT 20
