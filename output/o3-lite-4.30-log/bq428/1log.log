Query:
--Description: Join the top‑five markets (based on 2013‑2017 second‑period feats) to all 2010‑2018 NCAA tournament games; return games involving any of those markets (sample 20).
WITH top5 AS (
  WITH big_games AS (
    SELECT player_id, team_market
    FROM `bigquery-public-data.ncaa_basketball.mbb_pbp_sr`
    WHERE season BETWEEN 2013 AND 2017
      AND period = 2
      AND points_scored IS NOT NULL
    GROUP BY season, game_id, player_id, team_market
    HAVING SUM(points_scored) >= 15
  )
  SELECT team_market
  FROM (
    SELECT team_market,
           COUNT(DISTINCT player_id) AS cnt
    FROM big_games
    GROUP BY team_market
    ORDER BY cnt DESC
    LIMIT 5
  )
)
SELECT
  t.season,
  t.round,
  t.game_date,
  t.win_market,
  t.win_name,
  t.win_seed,
  t.win_pts,
  t.lose_market,
  t.lose_name,
  t.lose_seed,
  t.lose_pts
FROM `bigquery-public-data.ncaa_basketball.mbb_historical_tournament_games` AS t
JOIN top5
  ON t.win_market = top5.team_market
  OR t.lose_market = top5.team_market
WHERE t.season BETWEEN 2010 AND 2018
LIMIT 20
