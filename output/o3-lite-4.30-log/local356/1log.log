The table structure information is (table names): 
['circuits', 'constructor_results', 'constructor_standings', 'constructors', 'driver_standings', 'drivers', 'lap_times', 'pit_stops', 'qualifying', 'races', 'results', 'seasons', 'status', 'sprint_results', 'short_grand_prix_names', 'short_constructor_names', 'liveries', 'tdr_overrides', 'circuits_ext', 'constructors_ext', 'drivers_ext', 'driver_standings_ext', 'lap_times_ext', 'lap_time_stats', 'races_ext', 'team_driver_ranks', 'drives', 'retirements', 'lap_positions']
Begin Exploring Related Columns
Relevant tables / columns and their potential usage
---------------------------------------------------
lap_positions  
• race_id: link laps to a particular race  
• driver_id: identify the driver whose position is being tracked  
• lap: lap number (used for ordering and to hide lap‑1 “start” changes)  
• position: on‑track position at the END of the lap  
• lap_type: value 'Race' keeps only normal race laps (drops ‘Pit In’, ‘Pit Out’, etc.)  

pit_stops  
• race_id / driver_id / lap: laps in which a driver enters or exits the pits –‑ laps to be ignored when counting overtakes  

retirements  
• race_id / driver_id / lap: lap in which a driver retires –‑ ignore position changes triggered by retirements  

drivers_ext  
• driver_id: key to join with lap_positions  
• full_name: required output (full driver name to be returned)  

Typical conditions that will be required  
• lap_positions.lap_type = 'Race'               -- keep only pure race laps  
• lap_positions.lap  > 1                        -- remove first‑lap start movements  
• pit_stops.lap IS NULL                         -- exclude laps that coincide with a pit stop  
• retirements.lap IS NULL                       -- exclude laps that coincide with a retirement  
• Use window function  LAG(position)  to compare each lap to the previous lap for the same driver inside the same race.  
  – position  < LAG(position)  ⇒ driver overtook somebody  
  – position  > LAG(position)  ⇒ driver was overtaken  

Ten exploratory → final SQL statements
--------------------------------------

```sql
-- 1) Peek at some drivers (their full names)
SELECT DISTINCT full_name
FROM drivers_ext
LIMIT 20;
```

```sql
-- 2) Inspect a handful of raw lap‑by‑lap position rows
SELECT *
FROM lap_positions
LIMIT 20;
```

```sql
-- 3) Which different lap_type values are stored?
SELECT DISTINCT lap_type
FROM lap_positions
LIMIT 20;
```

```sql
-- 4) Count how many rows exist for each lap_type (helps decide filter)
SELECT lap_type, COUNT(*) AS cnt
FROM lap_positions
GROUP BY lap_type
ORDER BY cnt DESC
LIMIT 20;
```

```sql
-- 5) For one driver (id = 1) show the evolution of his positions in a race
SELECT race_id, lap, position,
       LAG(position) OVER (PARTITION BY race_id ORDER BY lap) AS prev_pos
FROM lap_positions
WHERE driver_id = 1
ORDER BY race_id, lap
LIMIT 20;
```

```sql
-- 6) First global attempt – raw counts of laps gained / lost for every driver
WITH pos AS (
  SELECT race_id,
         driver_id,
         lap,
         position,
         LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
  FROM lap_positions
)
SELECT driver_id,
       SUM(CASE WHEN position < prev_pos THEN 1 ELSE 0 END) AS overtakes_made,
       SUM(CASE WHEN position > prev_pos THEN 1 ELSE 0 END) AS overtakes_suffered
FROM pos
WHERE prev_pos IS NOT NULL
GROUP BY driver_id
LIMIT 20;
```

```sql
-- 7) Same as (6) but keep only pure race laps (lap_type = 'Race') and skip lap 1
WITH filtered AS (
  SELECT lp.*
  FROM lap_positions lp
  WHERE lp.lap_type = 'Race'
    AND lp.lap > 1
), pos AS (
  SELECT race_id,
         driver_id,
         lap,
         position,
         LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
  FROM filtered
)
SELECT driver_id,
       SUM(CASE WHEN position < prev_pos THEN 1 ELSE 0 END) AS gained,
       SUM(CASE WHEN position > prev_pos THEN 1 ELSE 0 END) AS lost
FROM pos
WHERE prev_pos IS NOT NULL
GROUP BY driver_id
LIMIT 20;
```

```sql
-- 8) Add filter to remove laps that coincide with a pit stop for that driver
WITH filtered AS (
  SELECT lp.*
  FROM lap_positions lp
  LEFT JOIN pit_stops ps
         ON ps.race_id = lp.race_id
        AND ps.driver_id = lp.driver_id
        AND ps.lap = lp.lap
  WHERE lp.lap_type = 'Race'
    AND lp.lap > 1
    AND ps.lap IS NULL          -- exclude pit‑in / pit‑out laps
), pos AS (
  SELECT race_id,
         driver_id,
         lap,
         position,
         LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
  FROM filtered
)
SELECT driver_id,
       SUM(CASE WHEN position < prev_pos THEN 1 ELSE 0 END) AS gained,
       SUM(CASE WHEN position > prev_pos THEN 1 ELSE 0 END) AS lost
FROM pos
WHERE prev_pos IS NOT NULL
GROUP BY driver_id
LIMIT 20;
```

```sql
-- 9) Remove laps that correspond to a retirement event as well
WITH filtered AS (
  SELECT lp.*
  FROM lap_positions lp
  LEFT JOIN pit_stops ps
         ON ps.race_id = lp.race_id
        AND ps.driver_id = lp.driver_id
        AND ps.lap = lp.lap
  LEFT JOIN retirements rt
         ON rt.race_id = lp.race_id
        AND rt.driver_id = lp.driver_id
        AND rt.lap       = lp.lap
  WHERE lp.lap_type = 'Race'
    AND lp.lap > 1
    AND ps.lap IS NULL          -- drop pit laps
    AND rt.lap IS NULL          -- drop retirement lap
), pos AS (
  SELECT race_id,
         driver_id,
         lap,
         position,
         LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
  FROM filtered
)
SELECT driver_id,
       SUM(CASE WHEN position < prev_pos THEN 1 ELSE 0 END) AS gained,
       SUM(CASE WHEN position > prev_pos THEN 1 ELSE 0 END) AS lost
FROM pos
WHERE prev_pos IS NOT NULL
GROUP BY driver_id
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER  – full driver names where lost > gained
WITH filtered AS (
  SELECT lp.*
  FROM lap_positions lp
  LEFT JOIN pit_stops ps
         ON ps.race_id = lp.race_id
        AND ps.driver_id = lp.driver_id
        AND ps.lap = lp.lap
  LEFT JOIN retirements rt
         ON rt.race_id = lp.race_id
        AND rt.driver_id = lp.driver_id
        AND rt.lap       = lp.lap
  WHERE lp.lap_type = 'Race'
    AND lp.lap > 1
    AND ps.lap IS NULL          -- exclude pit‑entry / pit‑exit laps
    AND rt.lap IS NULL          -- exclude retirement laps
), pos_changes AS (
  SELECT race_id,
         driver_id,
         lap,
         position,
         LAG(position) OVER (PARTITION BY race_id, driver_id ORDER BY lap) AS prev_pos
  FROM filtered
), counters AS (
  SELECT driver_id,
         SUM(CASE WHEN position < prev_pos THEN 1 ELSE 0 END) AS overtakes_made,
         SUM(CASE WHEN position > prev_pos THEN 1 ELSE 0 END) AS overtakes_suffered
  FROM pos_changes
  WHERE prev_pos IS NOT NULL
  GROUP BY driver_id
)
SELECT DISTINCT de.full_name
FROM counters c
JOIN drivers_ext de ON de.driver_id = c.driver_id
WHERE c.overtakes_suffered > c.overtakes_made
ORDER BY de.full_name
LIMIT 20;
```


