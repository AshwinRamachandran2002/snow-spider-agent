WITH deltas AS (
    SELECT
        curr."race_id",
        curr."driver_id",
        CASE WHEN prev."position" - curr."position" > 0
             THEN prev."position" - curr."position"      -- overtakes
             ELSE 0
        END AS overtakes,
        CASE WHEN prev."position" - curr."position" < 0
             THEN curr."position" - prev."position"      -- was overtaken
             ELSE 0
        END AS was_overtaken
    FROM "lap_positions" AS curr
    JOIN "lap_positions" AS prev
         ON curr."race_id"   = prev."race_id"
        AND curr."driver_id" = prev."driver_id"
        AND curr."lap"       = prev."lap" + 1
    WHERE curr."lap" > 1                       -- ignore start‑lap changes
      AND curr."lap_type" = 'Race'
      AND prev."lap_type" = 'Race'
      -- exclude laps when the driver made a pit stop (entry or exit)
      AND curr."lap" NOT IN (SELECT ps."lap"
                             FROM "pit_stops" ps
                             WHERE ps."race_id" = curr."race_id"
                               AND ps."driver_id" = curr."driver_id")
      AND prev."lap" NOT IN (SELECT ps."lap"
                             FROM "pit_stops" ps
                             WHERE ps."race_id" = prev."race_id"
                               AND ps."driver_id" = prev."driver_id")
      -- exclude the lap on which the driver retired
      AND curr."lap" NOT IN (SELECT r."lap"
                             FROM "retirements" r
                             WHERE r."race_id" = curr."race_id"
                               AND r."driver_id" = curr."driver_id")
),
totals AS (
    SELECT
        "driver_id",
        SUM(overtakes)      AS overtakes,
        SUM(was_overtaken)  AS was_overtaken
    FROM deltas
    GROUP BY "driver_id"
)
