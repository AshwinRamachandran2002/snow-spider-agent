--Description: FINAL – full names of drivers who have been overtaken more than
--they overtake, after all exclusions.  Works generically across the entire
--dataset, unaffected by missing pit‑stop rows for individual races.
WITH deltas AS (
  SELECT lp_curr."race_id",
         lp_curr."driver_id",
         CASE WHEN (lp_prev."position" - lp_curr."position") > 0
              THEN (lp_prev."position" - lp_curr."position") ELSE 0 END AS overtakes,
         CASE WHEN (lp_prev."position" - lp_curr."position") < 0
              THEN (lp_curr."position" - lp_prev."position") ELSE 0 END AS was_overtaken
  FROM   "lap_positions" AS lp_curr
  JOIN   "lap_positions" AS lp_prev
         ON lp_curr."race_id"   = lp_prev."race_id"
        AND lp_curr."driver_id" = lp_prev."driver_id"
        AND lp_curr."lap"       = lp_prev."lap" + 1
  WHERE  lp_curr."lap"     > 1
    AND  lp_curr."lap_type" = 'Race'
    AND  lp_prev."lap_type" = 'Race'
    AND  lp_curr."lap" NOT IN (SELECT ps."lap"
                               FROM   "pit_stops" ps
                               WHERE  ps."race_id"   = lp_curr."race_id"
                                 AND  ps."driver_id" = lp_curr."driver_id")
    AND  lp_prev."lap" NOT IN (SELECT ps."lap"
                               FROM   "pit_stops" ps
                               WHERE  ps."race_id"   = lp_prev."race_id"
                                 AND  ps."driver_id" = lp_prev."driver_id")
    AND  lp_curr."lap" NOT IN (SELECT r."lap"
                               FROM   "retirements" r
                               WHERE  r."race_id"   = lp_curr."race_id"
                                 AND  r."driver_id" = lp_curr."driver_id")
)
, tot AS (
  SELECT d."driver_id",
         SUM(d.overtakes)     AS total_overtakes,
         SUM(d.was_overtaken) AS total_times_overtaken
  FROM   deltas AS d
  GROUP  BY d."driver_id"
)
SELECT de."full_name"
FROM   tot
JOIN   "drivers_ext" AS de
       ON de."driver_id" = tot."driver_id"
WHERE  tot.total_times_overtaken > tot.total_overtakes
ORDER  BY tot.total_times_overtaken - tot.total_overtakes DESC
LIMIT 20
