-- Description / thinking process:
-- Goal: Find states whose male AND female legislators each have a non‑zero
--       retention rate at six checkpoints (0,2,4,6,8,10 years after a member’s
--       first‑term start).  “Retained” means the legislator is in office on
--       31‑Dec of the evaluation year.
--
-- Steps implemented via CTEs:
-- 1. first        – earliest term_start for every legislator (their cohort start).
-- 2. eval_years   – append the six checkpoint years (y0…y10) to every legislator.
-- 3. retention    – for every state‑gender pair, test whether *any* term for each
--                   legislator spans each Dec‑31; aggregate with MAX() so the
--                   pair’s flag is 1 if at least one member is present at the date.
-- 4. good_gender  – keep only those state‑gender pairs whose six flags are all 1.
-- 5. final state  – states that appear in good_gender for BOTH genders.
--
-- The final SELECT lists those state abbreviations (one per row).
WITH first AS (
    SELECT  l.id_bioguide,
            l.gender,
            lt.state,
            MIN(lt.term_start) AS first_term_start
    FROM    legislators_terms lt
    JOIN    legislators l
           ON l.id_bioguide = lt.id_bioguide
    GROUP BY l.id_bioguide
),
eval_years AS (
    SELECT  f.*,
            CAST(strftime('%Y', f.first_term_start) AS INTEGER)            AS y0,
            CAST(strftime('%Y', f.first_term_start) AS INTEGER) + 2        AS y2,
            CAST(strftime('%Y', f.first_term_start) AS INTEGER) + 4        AS y4,
            CAST(strftime('%Y', f.first_term_start) AS INTEGER) + 6        AS y6,
            CAST(strftime('%Y', f.first_term_start) AS INTEGER) + 8        AS y8,
            CAST(strftime('%Y', f.first_term_start) AS INTEGER) + 10       AS y10
    FROM    first f
),
retention AS (
    SELECT  e.state,
            e.gender,
            -- flags: 1 if ANY legislator of this cohort covers the checkpoint date
            MAX(DATE(e.y0  || '-12-31') BETWEEN t.term_start AND t.term_end)  AS r0,
            MAX(DATE(e.y2  || '-12-31') BETWEEN t.term_start AND t.term_end)  AS r2,
            MAX(DATE(e.y4  || '-12-31') BETWEEN t.term_start AND t.term_end)  AS r4,
            MAX(DATE(e.y6  || '-12-31') BETWEEN t.term_start AND t.term_end)  AS r6,
            MAX(DATE(e.y8  || '-12-31') BETWEEN t.term_start AND t.term_end)  AS r8,
            MAX(DATE(e.y10 || '-12-31') BETWEEN t.term_start AND t.term_end)  AS r10
    FROM    eval_years e
    JOIN    legislators_terms t
           ON t.id_bioguide = e.id_bioguide
    GROUP BY e.state, e.gender
),
good_gender AS (
    SELECT state, gender
    FROM   retention
    WHERE  r0 = 1 AND r2 = 1 AND r4 = 1 AND r6 = 1 AND r8 = 1 AND r10 = 1
)
SELECT DISTINCT state
FROM   good_gender
GROUP  BY state
HAVING COUNT(DISTINCT gender) = 2    -- both male and female cohorts qualify
ORDER  BY state;
```
