Query:
--Description:  Final query that returns the state abbreviations where BOTH male and
--              female cohorts keep a non‑zero retention rate at 0,2,4,6,8,10 years
--              after their first‑term start (i.e., at least one legislator of each
--              gender is still in office on every 31‑Dec checkpoint).
--              The query fixes the earlier syntax error caused by an extra quote
--              inside the BETWEEN expression.

WITH first AS (                    -- earliest term_start for every legislator
    SELECT  l.id_bioguide,
            l.gender,
            lt.state,
            MIN(lt.term_start) AS first_term_start
    FROM    legislators_terms lt
    JOIN    legislators       l  ON l.id_bioguide = lt.id_bioguide
    GROUP BY l.id_bioguide
),
eval_years AS (                    -- add the six evaluation years
    SELECT  f.*,
            CAST(strftime('%Y', f.first_term_start) AS INTEGER)            AS y0,
            CAST(strftime('%Y', f.first_term_start) AS INTEGER) + 2        AS y2,
            CAST(strftime('%Y', f.first_term_start) AS INTEGER) + 4        AS y4,
            CAST(strftime('%Y', f.first_term_start) AS INTEGER) + 6        AS y6,
            CAST(strftime('%Y', f.first_term_start) AS INTEGER) + 8        AS y8,
            CAST(strftime('%Y', f.first_term_start) AS INTEGER) + 10       AS y10
    FROM    first f
),
checks AS (                         -- retention flags aggregated by state & gender
    SELECT  e.state,
            e.gender,
            MAX( DATE(e.y0  || '-12-31') BETWEEN t.term_start AND t.term_end )  AS r0,
            MAX( DATE(e.y2  || '-12-31') BETWEEN t.term_start AND t.term_end )  AS r2,
            MAX( DATE(e.y4  || '-12-31') BETWEEN t.term_start AND t.term_end )  AS r4,
            MAX( DATE(e.y6  || '-12-31') BETWEEN t.term_start AND t.term_end )  AS r6,
            MAX( DATE(e.y8  || '-12-31') BETWEEN t.term_start AND t.term_end )  AS r8,
            MAX( DATE(e.y10 || '-12-31') BETWEEN t.term_start AND t.term_end )  AS r10
    FROM    eval_years e
    JOIN    legislators_terms t
           ON t.id_bioguide = e.id_bioguide
    GROUP BY e.state, e.gender
),
good_states AS (                    -- keep cohorts whose six flags are all 1
    SELECT state
    FROM   checks
    WHERE  r0 = 1 AND r2 = 1 AND r4 = 1 AND r6 = 1 AND r8 = 1 AND r10 = 1
)
SELECT DISTINCT gs1.state
FROM   good_states gs1
JOIN   good_states gs2 ON gs1.state = gs2.state  -- ensure both genders
WHERE  EXISTS (SELECT 1 FROM checks WHERE state = gs1.state AND gender = 'M')
  AND  EXISTS (SELECT 1 FROM checks WHERE state = gs1.state AND gender = 'F')
ORDER  BY gs1.state
