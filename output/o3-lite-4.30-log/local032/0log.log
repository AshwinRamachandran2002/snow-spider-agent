Begin Exploring Related Columns
Below is a compact “road‑map” of the tables / columns that matter for each requested metric, followed by ten exploratory SQL statements (from very simple to the complete answer) that will let you inspect the data step‑by‑step.

Relevant tables / columns and how they are used
• olist_orders  
  – order_id : links to olist_order_items / olist_order_reviews / olist_order_payments  
  – customer_id : links to olist_customers  
  – order_status : keep only ‘delivered’

• olist_order_items  
  – order_id : joins to olist_orders  
  – seller_id : tells who sold the item  
  – price / freight_value : used to compute profit (price − freight_value)

• olist_customers  
  – customer_id : joins to olist_orders  
  – customer_unique_id : used to count distinct final customers per seller

• olist_order_reviews  
  – order_id : joins to olist_orders  
  – review_score : select 5‑star reviews and count them per seller (through order_items)

• olist_sellers  
  – seller_id : dimension table, mainly for readability (not strictly required for the metrics)

SQL snippets
Each query is annotated; all have LIMIT 20 just for inspection.  
(Replace or remove LIMIT when you really want the full result.)

```sql
-- 1. Look at some delivered orders only
SELECT order_id, customer_id, order_purchase_timestamp
FROM olist_orders
WHERE order_status = 'delivered'
LIMIT 20;

-- 2. Join delivered orders to their items (who sold what)
SELECT oi.order_id, oi.seller_id, oi.price, oi.freight_value
FROM olist_order_items AS oi
JOIN olist_orders       AS o
  ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
LIMIT 20;

-- 3. Check distinct customer UNIQUE ids that bought from each seller
SELECT DISTINCT oi.seller_id, c.customer_unique_id
FROM olist_order_items AS oi
JOIN olist_orders       AS o ON o.order_id = oi.order_id
JOIN olist_customers    AS c ON c.customer_id = o.customer_id
WHERE o.order_status = 'delivered'
LIMIT 20;

-- 4. Preview profits (price - freight) for delivered order items
SELECT oi.order_id,
       oi.seller_id,
       (oi.price - oi.freight_value) AS profit
FROM olist_order_items AS oi
JOIN olist_orders       AS o ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
LIMIT 20;

-- 5. Inspect 5‑star reviews attached to delivered orders
SELECT r.order_id, r.review_score
FROM olist_order_reviews AS r
JOIN olist_orders        AS o ON o.order_id = r.order_id
WHERE o.order_status = 'delivered'
  AND r.review_score = 5
LIMIT 20;

-- 6. Aggregate: top sellers by distinct customer_unique_id
SELECT oi.seller_id,
       COUNT(DISTINCT c.customer_unique_id) AS distinct_customers
FROM olist_order_items AS oi
JOIN olist_orders    AS o ON o.order_id = oi.order_id
JOIN olist_customers AS c ON c.customer_id = o.customer_id
WHERE o.order_status = 'delivered'
GROUP BY oi.seller_id
ORDER BY distinct_customers DESC
LIMIT 20;

-- 7. Aggregate: top sellers by total profit
SELECT oi.seller_id,
       SUM(oi.price - oi.freight_value) AS total_profit
FROM olist_order_items AS oi
JOIN olist_orders AS o ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
GROUP BY oi.seller_id
ORDER BY total_profit DESC
LIMIT 20;

-- 8. Aggregate: top sellers by number of delivered orders
SELECT oi.seller_id,
       COUNT(DISTINCT oi.order_id) AS delivered_orders
FROM olist_order_items AS oi
JOIN olist_orders AS o ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
GROUP BY oi.seller_id
ORDER BY delivered_orders DESC
LIMIT 20;

-- 9. Aggregate: top sellers by number of 5‑star reviews
SELECT oi.seller_id,
       COUNT(*) AS five_star_reviews
FROM olist_order_items   AS oi
JOIN olist_orders        AS o ON o.order_id = oi.order_id
JOIN olist_order_reviews AS r ON r.order_id = oi.order_id
WHERE o.order_status = 'delivered'
  AND r.review_score = 5
GROUP BY oi.seller_id
ORDER BY five_star_reviews DESC
LIMIT 20;

-- 10. FINAL ANSWER: one row per achievement (four rows total)
SELECT 'Most distinct customer unique IDs' AS achievement,
       seller_id,
       metric_value
FROM (
    SELECT oi.seller_id,
           COUNT(DISTINCT c.customer_unique_id) AS metric_value
    FROM olist_order_items AS oi
    JOIN olist_orders    AS o ON o.order_id = oi.order_id
    JOIN olist_customers AS c ON c.customer_id = o.customer_id
    WHERE o.order_status = 'delivered'
    GROUP BY oi.seller_id
    ORDER BY metric_value DESC
    LIMIT 1
)
UNION ALL
SELECT 'Highest total profit',
       seller_id,
       metric_value
FROM (
    SELECT oi.seller_id,
           SUM(oi.price - oi.freight_value) AS metric_value
    FROM olist_order_items AS oi
    JOIN olist_orders AS o ON o.order_id = oi.order_id
    WHERE o.order_status = 'delivered'
    GROUP BY oi.seller_id
    ORDER BY metric_value DESC
    LIMIT 1
)
UNION ALL
SELECT 'Most distinct orders delivered',
       seller_id,
       metric_value
FROM (
    SELECT oi.seller_id,
           COUNT(DISTINCT oi.order_id) AS metric_value
    FROM olist_order_items AS oi
    JOIN olist_orders AS o ON o.order_id = oi.order_id
    WHERE o.order_status = 'delivered'
    GROUP BY oi.seller_id
    ORDER BY metric_value DESC
    LIMIT 1
)
UNION ALL
SELECT 'Most 5‑star reviews',
       seller_id,
       metric_value
FROM (
    SELECT oi.seller_id,
           COUNT(*) AS metric_value
    FROM olist_order_items   AS oi
    JOIN olist_orders        AS o ON o.order_id = oi.order_id
    JOIN olist_order_reviews AS r ON r.order_id = oi.order_id
    WHERE o.order_status = 'delivered'
      AND r.review_score = 5
    GROUP BY oi.seller_id
    ORDER BY metric_value DESC
    LIMIT 1
);
```

