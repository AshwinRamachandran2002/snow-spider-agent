Query:
-- 10. (Near‑final) Union the four “winners” into one labeled result set
SELECT 'Most distinct customers' AS achievement,
       seller_id,
       distinct_customers AS value
FROM (
      SELECT oi.seller_id,
             COUNT(DISTINCT c.customer_unique_id) AS distinct_customers
      FROM olist_order_items AS oi
      JOIN olist_orders    AS o  USING (order_id)
      JOIN olist_customers AS c  ON o.customer_id = c.customer_id
      WHERE o.order_status = 'delivered'
      GROUP BY oi.seller_id
      ORDER BY distinct_customers DESC
      LIMIT 1
)
UNION ALL
SELECT 'Highest profit',
       seller_id,
       total_profit
FROM (
      SELECT oi.seller_id,
             SUM(oi.price - oi.freight_value) AS total_profit
      FROM olist_order_items AS oi
      JOIN olist_orders AS o USING (order_id)
      WHERE o.order_status = 'delivered'
      GROUP BY oi.seller_id
      ORDER BY total_profit DESC
      LIMIT 1
)
UNION ALL
SELECT 'Most delivered orders',
       seller_id,
       delivered_orders
FROM (
      SELECT oi.seller_id,
             COUNT(DISTINCT oi.order_id) AS delivered_orders
      FROM olist_order_items AS oi
      JOIN olist_orders AS o USING (order_id)
      WHERE o.order_status = 'delivered'
      GROUP BY oi.seller_id
      ORDER BY delivered_orders DESC
      LIMIT 1
)
UNION ALL
SELECT 'Most 5‑star reviews',
       seller_id,
       five_star_reviews
FROM (
      SELECT oi.seller_id,
             COUNT(*) AS five_star_reviews
      FROM olist_order_reviews AS r
      JOIN olist_orders      AS o  USING (order_id)
      JOIN olist_order_items AS oi USING (order_id)
      WHERE o.order_status = 'delivered'
        AND r.review_score = 5
      GROUP BY oi.seller_id
      ORDER BY five_star_reviews DESC
      LIMIT 1
)
LIMIT 20
