    SELECT oi.*, o.customer_id
    FROM   olist_order_items AS oi
    JOIN   olist_orders      AS o ON o.order_id = oi.order_id
    WHERE  o.order_status = 'delivered'
),
cust_map AS (
    SELECT c.customer_id, c.customer_unique_id
    FROM   olist_customers AS c
),
five_star AS (
    SELECT r.order_id
    FROM   olist_order_reviews AS r
    WHERE  r.review_score = 5
)

-- seller with most distinct customer_unique_ids
SELECT 'Most distinct customers' AS achievement,
       seller_id,
       DISTINCT_CUSTOMERS AS value
FROM (
    SELECT di.seller_id,
           COUNT(DISTINCT cm.customer_unique_id) AS DISTINCT_CUSTOMERS
    FROM   delivered_items AS di
    JOIN   cust_map        AS cm ON cm.customer_id = di.customer_id
    GROUP BY di.seller_id
    ORDER BY DISTINCT_CUSTOMERS DESC
    LIMIT 1
)

UNION ALL
-- seller with highest profit
SELECT 'Highest profit', seller_id, seller_profit
FROM (
    SELECT di.seller_id,
           SUM(di.price - di.freight_value) AS seller_profit
    FROM   delivered_items AS di
    GROUP BY di.seller_id
    ORDER BY seller_profit DESC
    LIMIT 1
)

UNION ALL
-- seller with most delivered orders
SELECT 'Most delivered orders', seller_id, delivered_orders
FROM (
    SELECT di.seller_id,
           COUNT(DISTINCT di.order_id) AS delivered_orders
    FROM   delivered_items AS di
    GROUP BY di.seller_id
    ORDER BY delivered_orders DESC
    LIMIT 1
)

UNION ALL
-- seller with most 5‑star ratings
SELECT 'Most 5‑star reviews', seller_id, five_star_cnt
FROM (
    SELECT di.seller_id,
           COUNT(*) AS five_star_cnt
    FROM   delivered_items AS di
    JOIN   five_star      AS fs ON fs.order_id = di.order_id
    GROUP BY di.seller_id
    ORDER BY five_star_cnt DESC
    LIMIT 1
);
