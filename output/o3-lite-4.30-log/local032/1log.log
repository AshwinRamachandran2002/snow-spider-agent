Begin Exploring Related Columns
Below are the pieces you will need to build the answer.  
Part 1 lists only the columns that matter for the four requested metrics and what they are good for.  
Part 2 gives ten progressively more‐complex SQLite queries (all capped with LIMIT 20 so you can inspect intermediate results quickly).  The last query (#10) returns exactly the four rows you were asked for – one row per “best seller”, each labelled with the achievement.

────────────────────────────────────────
Part 1 – Relevant columns and their usage
────────────────────────────────────────
olist_orders  
• order_id: join key to order_items / order_reviews  
• customer_id: join key to olist_customers  
• order_status: filter to 'delivered' only

olist_customers  
• customer_id: join key to olist_orders  
• customer_unique_id: needed to count DISTINCT final consumers (one shopper may order several times)

olist_order_items  
• order_id: join key to orders / reviews  
• seller_id: the seller we are ranking  
• price: revenue part of profit (price – freight_value)  
• freight_value: cost part of profit

olist_order_reviews  
• order_id: join key to orders / order_items  
• review_score: filter to 5‑star reviews

Conditions that will be used  
1. orders.order_status = 'delivered'  → only delivered orders  
2. review_score = 5                  → only 5‑star reviews when counting them

────────────────────────────────────────
Part 2 – Ten exploratory SQL snippets
────────────────────────────────────────
```sql
-- 1. Peek at 20 delivered orders
SELECT *
FROM olist_orders
WHERE order_status = 'delivered'
LIMIT 20;
```

```sql
-- 2. List 20 order‑items that belong to delivered orders
SELECT oi.*
FROM olist_order_items AS oi
JOIN olist_orders AS o
  ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
LIMIT 20;
```

```sql
-- 3. How many different sellers are in the delivered orders?
SELECT COUNT(DISTINCT oi.seller_id) AS seller_cnt
FROM olist_order_items AS oi
JOIN olist_orders  AS o  ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered';
```

```sql
-- 4. Bring customers into the picture (one row per order‑item)
SELECT oi.seller_id,
       c.customer_unique_id
FROM   olist_order_items AS oi
JOIN   olist_orders      AS o  ON o.order_id = oi.order_id
JOIN   olist_customers   AS c  ON c.customer_id = o.customer_id
WHERE  o.order_status = 'delivered'
LIMIT 20;
```

```sql
-- 5. Count distinct customer_unique_id per seller
SELECT   oi.seller_id,
         COUNT(DISTINCT c.customer_unique_id) AS distinct_customers
FROM     olist_order_items AS oi
JOIN     olist_orders      AS o  ON o.order_id = oi.order_id
JOIN     olist_customers   AS c  ON c.customer_id = o.customer_id
WHERE    o.order_status = 'delivered'
GROUP BY oi.seller_id
ORDER BY distinct_customers DESC
LIMIT 20;
```

```sql
-- 6. Compute profit (price – freight_value) per seller
SELECT   oi.seller_id,
         SUM(oi.price - oi.freight_value) AS seller_profit
FROM     olist_order_items AS oi
JOIN     olist_orders      AS o  ON o.order_id = oi.order_id
WHERE    o.order_status = 'delivered'
GROUP BY oi.seller_id
ORDER BY seller_profit DESC
LIMIT 20;
```

```sql
-- 7. Count delivered orders per seller (distinct order_id)
SELECT   oi.seller_id,
         COUNT(DISTINCT oi.order_id) AS delivered_orders
FROM     olist_order_items AS oi
JOIN     olist_orders      AS o  ON o.order_id = oi.order_id
WHERE    o.order_status = 'delivered'
GROUP BY oi.seller_id
ORDER BY delivered_orders DESC
LIMIT 20;
```

```sql
-- 8. 5‑star reviews per seller (delivered orders only)
SELECT   oi.seller_id,
         COUNT(*) AS five_star_reviews
FROM     olist_order_items  AS oi
JOIN     olist_orders       AS o  ON o.order_id = oi.order_id
JOIN     olist_order_reviews AS r ON r.order_id = o.order_id
WHERE    o.order_status = 'delivered'
  AND    r.review_score = 5
GROUP BY oi.seller_id
ORDER BY five_star_reviews DESC
LIMIT 20;
```

```sql
-- 9. Grab ONLY the seller that leads each metric (using one query per metric)
--    Here, example shown for “most distinct customers”.
SELECT   oi.seller_id,
         COUNT(DISTINCT c.customer_unique_id) AS distinct_customers
FROM     olist_order_items AS oi
JOIN     olist_orders      AS o  ON o.order_id = oi.order_id
JOIN     olist_customers   AS c  ON c.customer_id = o.customer_id
WHERE    o.order_status = 'delivered'
GROUP BY oi.seller_id
ORDER BY distinct_customers DESC
LIMIT 1;
```

```sql
-- 10. FINAL ANSWER – four rows, one for each achievement
WITH delivered_items AS (
    SELECT oi.*, o.customer_id
    FROM   olist_order_items AS oi
    JOIN   olist_orders      AS o ON o.order_id = oi.order_id
    WHERE  o.order_status = 'delivered'
),
cust_map AS (
    SELECT c.customer_id, c.customer_unique_id
    FROM   olist_customers AS c
),
five_star AS (
    SELECT r.order_id
    FROM   olist_order_reviews AS r
    WHERE  r.review_score = 5
)

-- seller with most distinct customer_unique_ids
SELECT 'Most distinct customers' AS achievement,
       seller_id,
       DISTINCT_CUSTOMERS AS value
FROM (
    SELECT di.seller_id,
           COUNT(DISTINCT cm.customer_unique_id) AS DISTINCT_CUSTOMERS
    FROM   delivered_items AS di
    JOIN   cust_map        AS cm ON cm.customer_id = di.customer_id
    GROUP BY di.seller_id
    ORDER BY DISTINCT_CUSTOMERS DESC
    LIMIT 1
)

UNION ALL
-- seller with highest profit
SELECT 'Highest profit', seller_id, seller_profit
FROM (
    SELECT di.seller_id,
           SUM(di.price - di.freight_value) AS seller_profit
    FROM   delivered_items AS di
    GROUP BY di.seller_id
    ORDER BY seller_profit DESC
    LIMIT 1
)

UNION ALL
-- seller with most delivered orders
SELECT 'Most delivered orders', seller_id, delivered_orders
FROM (
    SELECT di.seller_id,
           COUNT(DISTINCT di.order_id) AS delivered_orders
    FROM   delivered_items AS di
    GROUP BY di.seller_id
    ORDER BY delivered_orders DESC
    LIMIT 1
)

UNION ALL
-- seller with most 5‑star ratings
SELECT 'Most 5‑star reviews', seller_id, five_star_cnt
FROM (
    SELECT di.seller_id,
           COUNT(*) AS five_star_cnt
    FROM   delivered_items AS di
    JOIN   five_star      AS fs ON fs.order_id = di.order_id
    GROUP BY di.seller_id
    ORDER BY five_star_cnt DESC
    LIMIT 1
);
```

