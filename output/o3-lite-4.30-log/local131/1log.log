Begin Exploring Related Columns
Relevant columns and their usage
• Musical_Styles.StyleID ­– primary‑key of every style; used to join to Musical_Preferences.  
• Musical_Styles.StyleName ­– the description we finally want to show.  
• Musical_Preferences.StyleID ­– foreign‑key that tells which style a customer prefers; used in the join.  
• Musical_Preferences.PreferenceSeq ­– ordinal position of the preference (1st, 2nd, 3rd …); used in the CASE expressions that count how many times a style is chosen as 1, 2 or 3.  
Condition likely to appear:  WHERE mp.PreferenceSeq IN (1,2,3)

Ten exploratory → increasingly complex SQLite queries  
(Every SELECT is limited to 20 rows so you can preview the data.)

```sql
-- 1. List the first 20 musical styles
SELECT DISTINCT "StyleID", "StyleName"
FROM "Musical_Styles"
LIMIT 20;
```

```sql
-- 2. Peek at 20 preference rows
SELECT DISTINCT "CustomerID", "StyleID", "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
-- 3. See what every preference looks like with its style name attached
SELECT ms."StyleName", mp."CustomerID", mp."PreferenceSeq"
FROM "Musical_Preferences" AS mp
JOIN "Musical_Styles"  AS ms ON ms."StyleID" = mp."StyleID"
LIMIT 20;
```

```sql
-- 4. How many total rows exist for each PreferenceSeq (1 / 2 / 3)?
SELECT mp."PreferenceSeq", COUNT(*) AS "cnt"
FROM "Musical_Preferences" AS mp
GROUP BY mp."PreferenceSeq"
LIMIT 20;
```

```sql
-- 5. Count how many customers list a given style as their 1st preference
SELECT ms."StyleName", COUNT(*) AS "first_pref_cnt"
FROM "Musical_Preferences" AS mp
JOIN "Musical_Styles" AS ms ON ms."StyleID" = mp."StyleID"
WHERE mp."PreferenceSeq" = 1
GROUP BY ms."StyleName"
LIMIT 20;
```

```sql
-- 6. Same idea, but for 2nd preference
SELECT ms."StyleName", COUNT(*) AS "second_pref_cnt"
FROM "Musical_Preferences" AS mp
JOIN "Musical_Styles" AS ms ON ms."StyleID" = mp."StyleID"
WHERE mp."PreferenceSeq" = 2
GROUP BY ms."StyleName"
LIMIT 20;
```

```sql
-- 7. Same idea, but for 3rd preference
SELECT ms."StyleName", COUNT(*) AS "third_pref_cnt"
FROM "Musical_Preferences" AS mp
JOIN "Musical_Styles" AS ms ON ms."StyleID" = mp."StyleID"
WHERE mp."PreferenceSeq" = 3
GROUP BY ms."StyleName"
LIMIT 20;
```

```sql
-- 8. Conditional aggregation: counts of 1st, 2nd, 3rd in one row per style
SELECT ms."StyleName",
       SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "first_pref",
       SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "second_pref",
       SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "third_pref"
FROM  "Musical_Styles" AS ms
LEFT JOIN "Musical_Preferences" AS mp
       ON mp."StyleID" = ms."StyleID"
GROUP BY ms."StyleName"
LIMIT 20;
```

```sql
-- 9. Same as #8 but showing the StyleID as well and sorted by StyleName
SELECT ms."StyleID",
       ms."StyleName",
       SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "first_pref",
       SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "second_pref",
       SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "third_pref"
FROM  "Musical_Styles" AS ms
LEFT JOIN "Musical_Preferences" AS mp
       ON mp."StyleID" = ms."StyleID"
GROUP BY ms."StyleID", ms."StyleName"
ORDER BY ms."StyleName"
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: every musical style with its counts for 1st, 2nd, 3rd preference
SELECT ms."StyleID",
       ms."StyleName",
       SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "Pref1Count",
       SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "Pref2Count",
       SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "Pref3Count"
FROM "Musical_Styles"      AS ms
LEFT JOIN "Musical_Preferences" AS mp
       ON mp."StyleID" = ms."StyleID"
GROUP BY ms."StyleID", ms."StyleName"
ORDER BY ms."StyleName";
```
