LIMIT 20;
```

```sql
-- 4) Join preference rows with their style names (first 20 rows)
SELECT mp.CustomerID,
       mp.StyleID,
       ms.StyleName,
       mp.PreferenceSeq
FROM Musical_Preferences AS mp
JOIN Musical_Styles     AS ms ON ms.StyleID = mp.StyleID
LIMIT 20;
```

```sql
-- 5) How many total rows exist for each preference sequence?
SELECT PreferenceSeq,
       COUNT(*) AS Cnt
FROM Musical_Preferences
GROUP BY PreferenceSeq
ORDER BY PreferenceSeq
LIMIT 20;
```

```sql
-- 6) Count of "1st preference" rows per musical style
SELECT ms.StyleName,
       COUNT(*) AS FirstPreferenceCnt
FROM Musical_Preferences AS mp
JOIN Musical_Styles      AS ms ON ms.StyleID = mp.StyleID
WHERE mp.PreferenceSeq = 1
GROUP BY ms.StyleID, ms.StyleName
ORDER BY FirstPreferenceCnt DESC
LIMIT 20;
```

```sql
-- 7) Count of "2nd preference" rows per style
SELECT ms.StyleName,
       COUNT(*) AS SecondPreferenceCnt
FROM Musical_Preferences AS mp
JOIN Musical_Styles      AS ms ON ms.StyleID = mp.StyleID
WHERE mp.PreferenceSeq = 2
GROUP BY ms.StyleID, ms.StyleName
ORDER BY SecondPreferenceCnt DESC
LIMIT 20;
```

```sql
-- 8) Count of "3rd preference" rows per style
SELECT ms.StyleName,
       COUNT(*) AS ThirdPreferenceCnt
FROM Musical_Preferences AS mp
JOIN Musical_Styles      AS ms ON ms.StyleID = mp.StyleID
WHERE mp.PreferenceSeq = 3
GROUP BY ms.StyleID, ms.StyleName
ORDER BY ThirdPreferenceCnt DESC
LIMIT 20;
```

```sql
-- 9) Combined counts (1st+2nd+3rd) per style, one column for each sequence
SELECT ms.StyleName,
       SUM(CASE WHEN mp.PreferenceSeq = 1 THEN 1 ELSE 0 END) AS FirstPref,
       SUM(CASE WHEN mp.PreferenceSeq = 2 THEN 1 ELSE 0 END) AS SecondPref,
       SUM(CASE WHEN mp.PreferenceSeq = 3 THEN 1 ELSE 0 END) AS ThirdPref
FROM Musical_Preferences AS mp
JOIN Musical_Styles      AS ms ON ms.StyleID = mp.StyleID
WHERE mp.PreferenceSeq IN (1,2,3)
GROUP BY ms.StyleID, ms.StyleName
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: list every musical style with counts of 1st, 2nd, and 3rd preferences
SELECT ms.StyleName                                                   AS "Musical Style",
       SUM(CASE WHEN mp.PreferenceSeq = 1 THEN 1 ELSE 0 END) AS "1st Pref Cnt",
       SUM(CASE WHEN mp.PreferenceSeq = 2 THEN 1 ELSE 0 END) AS "2nd Pref Cnt",
       SUM(CASE WHEN mp.PreferenceSeq = 3 THEN 1 ELSE 0 END) AS "3rd Pref Cnt"
FROM Musical_Preferences AS mp
JOIN Musical_Styles      AS ms ON ms.StyleID = mp.StyleID
WHERE mp.PreferenceSeq IN (1,2,3)
GROUP BY ms.StyleID, ms.StyleName
ORDER BY ms.StyleName
LIMIT 20;
```
