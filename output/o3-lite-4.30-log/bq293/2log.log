  STDDEV(IFNULL(tc.trip_cnt,0)) OVER(PARTITION BY z.zip_code
                                   ORDER BY h.hour_utc
                                   ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING) AS std_21d
FROM `bigquery-public-data.geo_us_boundaries.zip_codes` AS z
CROSS JOIN hours AS h
