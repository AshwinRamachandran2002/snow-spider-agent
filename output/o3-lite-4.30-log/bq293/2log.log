WITH nyc_zips AS (       -- five borough zip codes only
  SELECT zip_code
  FROM `bigquery-public-data.geo_us_boundaries.zip_codes`
  WHERE state_code = 'NY'
    AND county IN ('New York County','Kings County',
                   'Queens County','Bronx County','Richmond County')
),
hours AS (               -- every hour of 1‑Jan‑2015 (UTC)
  SELECT ts AS hour_start
  FROM UNNEST(
        GENERATE_TIMESTAMP_ARRAY('2015-01-01 00:00:00+00',
                                 '2015-01-01 23:00:00+00',
                                 INTERVAL 1 HOUR)
       ) AS ts
),
-- trip counts by (zip, hour) for 1‑Jan‑2015
trip_counts AS (
  SELECT
    z.zip_code,
    TIMESTAMP_TRUNC(t.pickup_datetime, HOUR) AS hour_start,
    COUNT(*) AS trip_count
  FROM `bigquery-public-data.new_york.tlc_yellow_trips_2015` AS t
  JOIN `bigquery-public-data.geo_us_boundaries.zip_codes` AS z
    ON z.state_code = 'NY'
   AND z.county IN ('New York County','Kings County',
                    'Queens County','Bronx County','Richmond County')
   AND ST_CONTAINS(z.zip_code_geom,
                   ST_GEOGPOINT(t.pickup_longitude, t.pickup_latitude))
  WHERE DATE(t.pickup_datetime) = '2015-01-01'
    AND t.pickup_longitude IS NOT NULL  AND t.pickup_latitude IS NOT NULL
    AND t.pickup_longitude <> 0         AND t.pickup_latitude  <> 0
  GROUP BY z.zip_code, hour_start
),
-- complete grid of (zip, hour)
grid AS (
  SELECT z.zip_code, h.hour_start
  FROM nyc_zips AS z
  CROSS JOIN hours AS h
),
grid_with_counts AS (
  SELECT
    g.zip_code,
    g.hour_start,
    IFNULL(tc.trip_count,0) AS trip_count
  FROM grid AS g
  LEFT JOIN trip_counts AS tc
    ON  tc.zip_code   = g.zip_code
    AND tc.hour_start = g.hour_start
)
SELECT
  zip_code,
  hour_start,
  trip_count,
  LAG(trip_count,   1) OVER (PARTITION BY zip_code ORDER BY hour_start) AS lag_1h,
  LAG(trip_count,  24) OVER (PARTITION BY zip_code ORDER BY hour_start) AS lag_24h,
  LAG(trip_count, 168) OVER (PARTITION BY zip_code ORDER BY hour_start) AS lag_168h,
  LAG(trip_count, 336) OVER (PARTITION BY zip_code ORDER BY hour_start) AS lag_336h,
  AVG(   trip_count) OVER (PARTITION BY zip_code ORDER BY hour_start
                           ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING) AS ma_14d,
  AVG(   trip_count) OVER (PARTITION BY zip_code ORDER BY hour_start
                           ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING) AS ma_21d,
  STDDEV(trip_count) OVER (PARTITION BY zip_code ORDER BY hour_start
                           ROWS BETWEEN 336 PRECEDING AND 1 PRECEDING) AS sd_14d,
  STDDEV(trip_count) OVER (PARTITION BY zip_code ORDER BY hour_start
                           ROWS BETWEEN 504 PRECEDING AND 1 PRECEDING) AS sd_21d
FROM grid_with_counts
ORDER BY trip_count DESC, zip_code, hour_start
LIMIT 5;
```
