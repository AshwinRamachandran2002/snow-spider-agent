  WHERE  TIMESTAMP_DIFF(a.creation_date, fq.first_question_ts, DAY) BETWEEN 0 AND 30
        AND a.creation_date > fq.first_question_ts
)
SELECT n.yyyymm,
       COUNT(*) AS total_new_users,
       SAFE_DIVIDE(COUNTIF(n.user_id IN (SELECT * FROM asked30)),
