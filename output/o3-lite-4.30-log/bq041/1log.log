The table structure information is ({database name: {schema name: [table name]}}): 
{'bigquery-public-data': {'stackoverflow': ['posts_answers', 'users', 'posts_orphaned_tag_wiki', 'posts_tag_wiki', 'stackoverflow_posts', 'posts_questions', 'comments', 'posts_tag_wiki_excerpt', 'posts_wiki_placeholder', 'posts_privilege_wiki', 'post_history', 'badges', 'post_links', 'tags', 'votes', 'posts_moderator_nomination']}}
Begin Exploring Related Columns
Relevant columns and how they will be used  
• users.id – unique key to join posts back to the account that created them.  
• users.creation_date – signup time; lets us pick “new users created in 2021” and calculate 30‑day windows.  
• posts_questions.owner_user_id – links a question to the user who asked it.  
• posts_questions.creation_date – time a question was asked; used to check “asked within 30 days of signup” and to get a user’s first‑question time‑stamp.  
• posts_answers.owner_user_id – links an answer to its author.  
• posts_answers.creation_date – time an answer was posted; used to see whether a user answered after asking and still inside the 30‑day window that begins with their first question.  

Typical conditions you will need  
• DATE(u.creation_date) BETWEEN '2021‑01‑01' AND '2021‑12‑31' → new 2021 users  
• TIMESTAMP_DIFF(q.creation_date, u.creation_date, DAY) BETWEEN 0 AND 30 → question was asked ≤ 30 days after signup  
• TIMESTAMP_DIFF(a.creation_date, fq.first_question_ts, DAY) BETWEEN 0 AND 30  
 AND a.creation_date > fq.first_question_ts → answer posted after first question but still inside its 30‑day window  

Below are ten exploratory BigQuery SQL queries (each limited to 20 rows) that move from very simple inspection all the way to the final monthly result.

```sql
-- 1. Peek at a few users who signed up in 2021
SELECT id, creation_date
FROM `bigquery-public-data.stackoverflow.users`
WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
ORDER BY creation_date
LIMIT 20;
```

```sql
-- 2. New‑user counts per month in 2021
SELECT FORMAT_DATE('%Y-%m', DATE_TRUNC(DATE(creation_date), MONTH)) AS yyyymm,
       COUNT(*) AS new_users
FROM `bigquery-public-data.stackoverflow.users`
WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
GROUP BY yyyymm
ORDER BY yyyymm
LIMIT 20;
```

```sql
-- 3. Sample: users together with any questions they asked within 30 days of signup
SELECT u.id                AS user_id,
       u.creation_date     AS signup_ts,
       q.id                AS question_id,
       q.creation_date     AS question_ts,
       TIMESTAMP_DIFF(q.creation_date, u.creation_date, DAY) AS days_after_signup
FROM   `bigquery-public-data.stackoverflow.users`          AS u
JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
  ON   q.owner_user_id = u.id
WHERE  DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
  AND  TIMESTAMP_DIFF(q.creation_date, u.creation_date, DAY) BETWEEN 0 AND 30
ORDER BY user_id
LIMIT 20;
```

```sql
-- 4. For each 2021 user, find the time of their first question (if any)
SELECT u.id                                   AS user_id,
       MIN(q.creation_date)                   AS first_question_ts
FROM   `bigquery-public-data.stackoverflow.users`          AS u
LEFT JOIN `bigquery-public-data.stackoverflow.posts_questions` AS q
       ON q.owner_user_id = u.id
WHERE  DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
GROUP BY user_id
LIMIT 20;
```

```sql
-- 5. Users who asked at least one question within 30 days of signup
WITH first_q AS (
  SELECT u.id AS user_id,
         MIN(q.creation_date) AS first_question_ts
  FROM   `bigquery-public-data.stackoverflow.users`          AS u
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
         ON q.owner_user_id = u.id
  WHERE  DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
         AND TIMESTAMP_DIFF(q.creation_date, u.creation_date, DAY) BETWEEN 0 AND 30
  GROUP BY user_id
)
SELECT *
FROM first_q
LIMIT 20;
```

```sql
-- 6. Sample answers that fall into the 30‑day window AFTER a user's first question
WITH first_q AS (
  SELECT u.id AS user_id,
         MIN(q.creation_date) AS first_question_ts
  FROM   `bigquery-public-data.stackoverflow.users`          AS u
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
         ON q.owner_user_id = u.id
  WHERE  DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
         AND TIMESTAMP_DIFF(q.creation_date, u.creation_date, DAY) BETWEEN 0 AND 30
  GROUP BY user_id
)
SELECT a.owner_user_id  AS user_id,
       a.id             AS answer_id,
       a.creation_date  AS answer_ts
FROM   first_q AS fq
JOIN   `bigquery-public-data.stackoverflow.posts_answers` AS a
       ON a.owner_user_id = fq.user_id
WHERE  TIMESTAMP_DIFF(a.creation_date, fq.first_question_ts, DAY) BETWEEN 0 AND 30
  AND  a.creation_date > fq.first_question_ts
LIMIT 20;
```

```sql
-- 7. Monthly count of 2021 new users who asked within 30 days
WITH asked30 AS (
  SELECT u.id AS user_id,
         u.creation_date AS signup_ts
  FROM   `bigquery-public-data.stackoverflow.users`          AS u
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
         ON q.owner_user_id = u.id
  WHERE  DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
    AND  TIMESTAMP_DIFF(q.creation_date, u.creation_date, DAY) BETWEEN 0 AND 30
  GROUP BY user_id, signup_ts
)
SELECT FORMAT_DATE('%Y-%m', DATE_TRUNC(DATE(signup_ts), MONTH)) AS yyyymm,
       COUNT(DISTINCT user_id) AS users_asked_30
FROM asked30
GROUP BY yyyymm
ORDER BY yyyymm
LIMIT 20;
```

```sql
-- 8. Monthly count of those users who also answered within 30 days of their first question
WITH first_q AS (
  SELECT u.id AS user_id,
         u.creation_date AS signup_ts,
         MIN(q.creation_date) AS first_question_ts
  FROM   `bigquery-public-data.stackoverflow.users`          AS u
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
         ON q.owner_user_id = u.id
  WHERE  DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
    AND  TIMESTAMP_DIFF(q.creation_date, u.creation_date, DAY) BETWEEN 0 AND 30
  GROUP BY user_id, signup_ts
), ans30 AS (
  SELECT DISTINCT fq.user_id
  FROM   first_q AS fq
  JOIN   `bigquery-public-data.stackoverflow.posts_answers` AS a
         ON a.owner_user_id = fq.user_id
  WHERE  TIMESTAMP_DIFF(a.creation_date, fq.first_question_ts, DAY) BETWEEN 0 AND 30
        AND a.creation_date > fq.first_question_ts
)
SELECT FORMAT_DATE('%Y-%m', DATE_TRUNC(DATE(signup_ts), MONTH)) AS yyyymm,
       COUNT(DISTINCT ans30.user_id) AS users_answered_after_q
FROM first_q AS fq
JOIN ans30
  ON ans30.user_id = fq.user_id
GROUP BY yyyymm
ORDER BY yyyymm
LIMIT 20;
```

```sql
-- 9. Combine (new users, asked‑within‑30, answered‑after‑asking‑within‑30) side‑by‑side
WITH new_users AS (
  SELECT id AS user_id,
         creation_date AS signup_ts,
         FORMAT_DATE('%Y-%m', DATE_TRUNC(DATE(creation_date), MONTH)) AS yyyymm
  FROM `bigquery-public-data.stackoverflow.users`
  WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
),
asked30 AS (
  SELECT DISTINCT u.id AS user_id
  FROM   `bigquery-public-data.stackoverflow.users`          AS u
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
         ON q.owner_user_id = u.id
  WHERE  DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
    AND  TIMESTAMP_DIFF(q.creation_date, u.creation_date, DAY) BETWEEN 0 AND 30
),
first_q AS (
  SELECT u.id AS user_id,
         MIN(q.creation_date) AS first_question_ts
  FROM   `bigquery-public-data.stackoverflow.users`          AS u
  JOIN   `bigquery-public-data.stackoverflow.posts_questions` AS q
         ON q.owner_user_id = u.id
  WHERE  DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
    AND  TIMESTAMP_DIFF(q.creation_date, u.creation_date, DAY) BETWEEN 0 AND 30
  GROUP BY user_id
),
answered30 AS (
  SELECT DISTINCT fq.user_id
  FROM   first_q AS fq
  JOIN   `bigquery-public-data.stackoverflow.posts_answers` AS a
         ON a.owner_user_id = fq.user_id
  WHERE  TIMESTAMP_DIFF(a.creation_date, fq.first_question_ts, DAY) BETWEEN 0 AND 30
        AND a.creation_date > fq.first_question_ts
)
SELECT n.yyyymm,
       COUNT(*) AS new_users,
       COUNTIF(n.user_id IN (SELECT * FROM asked30)) AS asked_30,
       COUNTIF(n.user_id IN (SELECT * FROM answered30)) AS answered_after_q_30
FROM new_users AS n
GROUP BY yyyymm
ORDER BY yyyymm
LIMIT 20;
```

