Relevant columns and how they will be used

• bigquery-public-data.stackoverflow.users  
  – id : joins the user to her posts.  
  – creation_date : month the account was created; anchor date for all “within 30‑day” windows.

• bigquery-public-data.stackoverflow.posts_questions  
  – owner_user_id : joins a question to the author in users.  
  – creation_date : date a question was asked; compare to user.creation_date to see whether it was posted within 30 days of sign‑up.

• bigquery-public-data.stackoverflow.posts_answers  
  – owner_user_id : joins an answer to the author in users.  
  – creation_date : date an answer was posted; compare to the user’s FIRST question date to see whether it was posted in the next 30 days.

Typical conditions that will be used

1.   Users created in 2021  
     WHERE DATE(`creation_date`) BETWEEN '2021‑01‑01' AND '2021‑12‑31'

2.   Questions within 30 days of sign‑up  
     WHERE q.owner_user_id = u.id  
       AND q.creation_date < u.creation_date + INTERVAL 30 DAY

3.   User’s first question date  
     QUALIFY ROW_NUMBER() OVER(PARTITION BY owner_user_id ORDER BY creation_date) = 1

4.   Answers in the 30 days after the first question  
     WHERE a.creation_date BETWEEN first_question_date  
                               AND first_question_date + INTERVAL 30 DAY

10 exploratory → increasingly complex BigQuery SQL queries  
(each limited to 20 rows so you can peek at the data)

```sql
-- 1. Peek at 20 users that joined during 2021
SELECT id, creation_date
FROM `bigquery-public-data.stackoverflow.users`
WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
ORDER BY creation_date
LIMIT 20;
```

```sql
-- 2. Count of new users per month in 2021
SELECT
  FORMAT_DATE('%Y-%m', DATE(creation_date)) AS month,
  COUNT(*) AS new_users
FROM `bigquery-public-data.stackoverflow.users`
WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
GROUP BY month
ORDER BY month
LIMIT 20;
```

```sql
-- 3. Sample of questions asked by people who joined in 2021 (any time)
SELECT q.id AS question_id,
       q.owner_user_id,
       q.creation_date AS question_date,
       u.creation_date AS signup_date
FROM `bigquery-public-data.stackoverflow.users`           AS u
JOIN `bigquery-public-data.stackoverflow.posts_questions` AS q
  ON q.owner_user_id = u.id
WHERE DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
ORDER BY q.creation_date
LIMIT 20;
```

```sql
-- 4. Users who asked a question within 30 days of signing up
SELECT DISTINCT u.id AS user_id,
       u.creation_date AS signup_date
FROM `bigquery-public-data.stackoverflow.users`           AS u
JOIN `bigquery-public-data.stackoverflow.posts_questions` AS q
  ON q.owner_user_id = u.id
WHERE DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
  AND q.creation_date < u.creation_date + INTERVAL 30 DAY
LIMIT 20;
```

```sql
-- 5. First question date for every 2021 user (one row per user)
SELECT owner_user_id,
       MIN(creation_date) AS first_question_date
FROM `bigquery-public-data.stackoverflow.posts_questions`
WHERE owner_user_id IN (
      SELECT id
      FROM `bigquery-public-data.stackoverflow.users`
      WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31')
GROUP BY owner_user_id
LIMIT 20;
```

```sql
-- 6. Answers authored within 30 days after the first question
WITH first_q AS (
  SELECT owner_user_id,
         MIN(creation_date) AS first_question_date
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  GROUP BY owner_user_id
)
SELECT a.id        AS answer_id,
       a.owner_user_id,
       a.creation_date AS answer_date,
       f.first_question_date
FROM first_q                         AS f
JOIN `bigquery-public-data.stackoverflow.posts_answers` AS a
  ON a.owner_user_id = f.owner_user_id
WHERE a.creation_date BETWEEN f.first_question_date
                          AND f.first_question_date + INTERVAL 30 DAY
LIMIT 20;
```

```sql
-- 7. For 2021 sign‑ups: flag who asked ≥1 question within 30 days
WITH user_2021 AS (
  SELECT id, creation_date
  FROM `bigquery-public-data.stackoverflow.users`
  WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
)
SELECT u.id,
       MIN(CASE
             WHEN q.id IS NOT NULL THEN 1
             ELSE 0
           END) AS asked_within_30d
FROM user_2021 AS u
LEFT JOIN `bigquery-public-data.stackoverflow.posts_questions` AS q
  ON q.owner_user_id = u.id
 AND q.creation_date < u.creation_date + INTERVAL 30 DAY
GROUP BY u.id
LIMIT 20;
```

```sql
-- 8. For those who had a 30‑day question, compute whether they later answered
WITH user_2021 AS (
  SELECT id, creation_date
  FROM `bigquery-public-data.stackoverflow.users`
  WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
),
first_q AS (
  SELECT owner_user_id,
         MIN(creation_date) AS first_question_date
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  GROUP BY owner_user_id
),
valid_q AS (
  SELECT f.*
  FROM user_2021 AS u
  JOIN first_q   AS f
    ON f.owner_user_id = u.id
  WHERE f.first_question_date < u.creation_date + INTERVAL 30 DAY
)
SELECT v.owner_user_id,
       MIN(CASE WHEN a.id IS NOT NULL THEN 1 ELSE 0 END) AS answered_after
FROM valid_q AS v
LEFT JOIN `bigquery-public-data.stackoverflow.posts_answers` AS a
  ON  a.owner_user_id = v.owner_user_id
  AND a.creation_date BETWEEN v.first_question_date
                          AND v.first_question_date + INTERVAL 30 DAY
GROUP BY v.owner_user_id
LIMIT 20;
```

```sql
-- 9. Monthly stats: how many 2021 new users asked a Q within 30 days
WITH
users_2021 AS (
  SELECT id,
         creation_date,
         FORMAT_DATE('%Y-%m', DATE(creation_date)) AS signup_month
  FROM `bigquery-public-data.stackoverflow.users`
  WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
),
askers AS (
  SELECT DISTINCT u.id, u.signup_month
  FROM users_2021 AS u
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS q
    ON q.owner_user_id = u.id
   AND q.creation_date < u.creation_date + INTERVAL 30 DAY
)
SELECT u.signup_month,
       COUNT(*)        AS total_new_users,
       SUM(CASE WHEN a.id IS NOT NULL THEN 1 ELSE 0 END) AS new_users_with_question
FROM users_2021 AS u
LEFT JOIN askers AS a
  ON a.id = u.id
GROUP BY u.signup_month
ORDER BY u.signup_month
LIMIT 20;
```

```sql
--10. Final step: full metric set for each 2021 month
WITH
users_2021 AS (
  SELECT id,
         creation_date,
         FORMAT_DATE('%Y-%m', DATE(creation_date)) AS signup_month
  FROM `bigquery-public-data.stackoverflow.users`
  WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
),
first_q AS (
  SELECT owner_user_id,
         MIN(creation_date) AS first_question_date
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  GROUP BY owner_user_id
),
q_within_30 AS (
  SELECT u.id,
         u.signup_month,
         fq.first_question_date
  FROM users_2021 AS u
  JOIN first_q     AS fq
    ON fq.owner_user_id = u.id
  WHERE fq.first_question_date < u.creation_date + INTERVAL 30 DAY
),
answered_after_q AS (
  SELECT DISTINCT q.id
  FROM q_within_30         AS q
  JOIN `bigquery-public-data.stackoverflow.posts_answers` AS a
    ON a.owner_user_id = q.id
   AND a.creation_date BETWEEN q.first_question_date
                           AND q.first_question_date + INTERVAL 30 DAY
)
SELECT
  u.signup_month,
  COUNT(*)                                            AS total_new_users,
  COUNT(q.id)                                         AS users_asked_30d,
  COUNT(ans.id)                                       AS users_answered_after_q,
  ROUND(100 * COUNT(q.id)  / COUNT(*), 2)             AS pct_asked_30d,
  ROUND(100 * COUNT(ans.id) / NULLIF(COUNT(q.id),0),2) AS pct_answered_after_q
FROM users_2021                  AS u
LEFT JOIN q_within_30            AS q   ON q.id   = u.id
LEFT JOIN answered_after_q       AS ans ON ans.id = u.id
GROUP BY u.signup_month
ORDER BY u.signup_month
LIMIT 20;
```

Each successive query builds understanding of the needed columns, joins, and date filters, culminating in a single statement (#10) that produces every figure required to answer the task.
