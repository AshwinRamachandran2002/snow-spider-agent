Query:
--10. Final step: full metric set for each 2021 month
WITH
users_2021 AS (
  SELECT id,
         creation_date,
         FORMAT_DATE('%Y-%m', DATE(creation_date)) AS signup_month
  FROM `bigquery-public-data.stackoverflow.users`
  WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
),
first_q AS (
  SELECT owner_user_id,
         MIN(creation_date) AS first_question_date
  FROM `bigquery-public-data.stackoverflow.posts_questions`
  GROUP BY owner_user_id
),
q_within_30 AS (
  SELECT u.id,
         u.signup_month,
         fq.first_question_date
  FROM users_2021 AS u
  JOIN first_q     AS fq
    ON fq.owner_user_id = u.id
  WHERE fq.first_question_date < u.creation_date + INTERVAL 30 DAY
),
answered_after_q AS (
  SELECT DISTINCT q.id
  FROM q_within_30         AS q
  JOIN `bigquery-public-data.stackoverflow.posts_answers` AS a
    ON a.owner_user_id = q.id
   AND a.creation_date BETWEEN q.first_question_date
                           AND q.first_question_date + INTERVAL 30 DAY
)
SELECT
  u.signup_month,
  COUNT(*)                                            AS total_new_users,
  COUNT(q.id)                                         AS users_asked_30d,
  COUNT(ans.id)                                       AS users_answered_after_q,
  ROUND(100 * COUNT(q.id)  / COUNT(*), 2)             AS pct_asked_30d,
  ROUND(100 * COUNT(ans.id) / NULLIF(COUNT(q.id),0),2) AS pct_answered_after_q
FROM users_2021                  AS u
LEFT JOIN q_within_30            AS q   ON q.id   = u.id
LEFT JOIN answered_after_q       AS ans ON ans.id = u.id
GROUP BY u.signup_month
ORDER BY u.signup_month
LIMIT 20;
