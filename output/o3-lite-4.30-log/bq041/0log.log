-- 8. Counts of “asked then answered” per month
WITH early_ask AS (
  SELECT
    u.id                  AS user_id,
    FORMAT_DATE('%Y-%m', DATE(u.creation_date)) AS month_2021,
    MIN(pq.creation_date) AS first_q_time
  FROM `bigquery-public-data.stackoverflow.users`           AS u
