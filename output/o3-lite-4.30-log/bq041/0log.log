2025-05-01 02:14:05 - Thread-727 (execute) - INFO - [Exploration]
Relevant tables / columns and how they will be used
----------------------------------------------------
users  
 • `id`              : primary key – joins to owner ids in the post tables.  
 • `creation_date`   : find sign‑up moment, filter to 2021, derive the calendar month.

posts_questions  
 • `owner_user_id`   : joins to `users.id` – tells who asked.  
 • `creation_date`   : compare with user’s sign‑up date → “asked within 30 days”.  
 • `id`              : first question id (needed only to order questions).

posts_answers  
 • `owner_user_id`   : joins to `users.id` – tells who answered.  
 • `creation_date`   : compare with (first‑question date + 30 days) and must be later than first question.  

Typical conditions  
 • User cohort          : DATE(`u.creation_date`) BETWEEN '2021‑01‑01' AND '2021‑12‑31'  
 • Month bucket         : FORMAT_DATE('%Y-%m', DATE(u.creation_date)) AS month_2021  
 • Question window      : pq.creation_date BETWEEN u.creation_date AND TIMESTAMP_ADD(u.creation_date, INTERVAL 30 DAY)  
 • First question time  : MIN(pq.creation_date) OVER (PARTITION BY pq.owner_user_id)  
 • Answer window        : pa.creation_date BETWEEN first_q_time AND TIMESTAMP_ADD(first_q_time, INTERVAL 30 DAY)  
 • Answer must be AFTER the question: pa.creation_date > first_q_time  


Ten exploratory → final SQL snippets
------------------------------------

```sql
-- 1. Peek at 2021 sign‑ups
SELECT id, creation_date
FROM `bigquery-public-data.stackoverflow.users`
WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
LIMIT 20;
```

```sql
-- 2. Monthly count of new users in 2021
SELECT
  FORMAT_DATE('%Y-%m', DATE(creation_date)) AS month_2021,
  COUNT(*)                                   AS new_users
FROM `bigquery-public-data.stackoverflow.users`
WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
GROUP BY month_2021
ORDER BY month_2021
LIMIT 20;
```

```sql
-- 3. Users who asked ANY question within 30 days of sign‑up
SELECT DISTINCT u.id
FROM `bigquery-public-data.stackoverflow.users`            AS u
JOIN `bigquery-public-data.stackoverflow.posts_questions`  AS pq
  ON pq.owner_user_id = u.id
WHERE DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
  AND pq.creation_date BETWEEN u.creation_date
                          AND TIMESTAMP_ADD(u.creation_date, INTERVAL 30 DAY)
LIMIT 20;
```

```sql
-- 4. Count of such “early askers” by month
SELECT
  FORMAT_DATE('%Y-%m', DATE(u.creation_date)) AS month_2021,
  COUNT(DISTINCT u.id)                        AS early_askers
FROM `bigquery-public-data.stackoverflow.users`           AS u
JOIN `bigquery-public-data.stackoverflow.posts_questions` AS pq
  ON pq.owner_user_id = u.id
WHERE DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
  AND pq.creation_date BETWEEN u.creation_date
                          AND TIMESTAMP_ADD(u.creation_date, INTERVAL 30 DAY)
GROUP BY month_2021
ORDER BY month_2021
LIMIT 20;
```

```sql
-- 5. First‑question timestamp for every 2021 user who asked within 30 days
SELECT
  u.id                    AS user_id,
  MIN(pq.creation_date)   AS first_q_time
FROM `bigquery-public-data.stackoverflow.users`           AS u
JOIN `bigquery-public-data.stackoverflow.posts_questions` AS pq
  ON pq.owner_user_id = u.id
WHERE DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
  AND pq.creation_date BETWEEN u.creation_date
                          AND TIMESTAMP_ADD(u.creation_date, INTERVAL 30 DAY)
GROUP BY user_id
LIMIT 20;
```

```sql
-- 6. Sample of answers that fall in the 30‑day window AFTER the first question
WITH first_q AS (
  SELECT
    u.id                  AS user_id,
    MIN(pq.creation_date) AS first_q_time
  FROM `bigquery-public-data.stackoverflow.users`           AS u
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS pq
    ON pq.owner_user_id = u.id
  WHERE DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
    AND pq.creation_date BETWEEN u.creation_date
                            AND TIMESTAMP_ADD(u.creation_date, INTERVAL 30 DAY)
  GROUP BY user_id
)
SELECT
  fq.user_id,
  pa.id            AS answer_id,
  pa.creation_date AS answer_time
FROM first_q AS fq
JOIN `bigquery-public-data.stackoverflow.posts_answers` AS pa
  ON pa.owner_user_id = fq.user_id
WHERE pa.creation_date >  fq.first_q_time
  AND pa.creation_date <= TIMESTAMP_ADD(fq.first_q_time, INTERVAL 30 DAY)
LIMIT 20;
```

```sql
-- 7. Users who satisfied BOTH conditions (asked, then answered) – distinct list
WITH first_q AS (
  SELECT u.id AS user_id,
         MIN(pq.creation_date) AS first_q_time
  FROM `bigquery-public-data.stackoverflow.users`           AS u
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS pq
    ON pq.owner_user_id = u.id
  WHERE DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
    AND pq.creation_date BETWEEN u.creation_date
                            AND TIMESTAMP_ADD(u.creation_date, INTERVAL 30 DAY)
  GROUP BY user_id
)
SELECT DISTINCT fq.user_id
FROM first_q AS fq
JOIN `bigquery-public-data.stackoverflow.posts_answers` AS pa
  ON pa.owner_user_id = fq.user_id
WHERE pa.creation_date >  fq.first_q_time
  AND pa.creation_date <= TIMESTAMP_ADD(fq.first_q_time, INTERVAL 30 DAY)
LIMIT 20;
```

```sql
-- 8. Counts of “asked then answered” per month
WITH early_ask AS (
  SELECT
    u.id                  AS user_id,
    FORMAT_DATE('%Y-%m', DATE(u.creation_date)) AS month_2021,
    MIN(pq.creation_date) AS first_q_time
  FROM `bigquery-public-data.stackoverflow.users`           AS u
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS pq
    ON pq.owner_user_id = u.id
  WHERE DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
    AND pq.creation_date BETWEEN u.creation_date
                            AND TIMESTAMP_ADD(u.creation_date, INTERVAL 30 DAY)
  GROUP BY user_id, month_2021
), ask_then_answer AS (
  SELECT DISTINCT ea.user_id, ea.month_2021
  FROM early_ask AS ea
  JOIN `bigquery-public-data.stackoverflow.posts_answers` AS pa
    ON pa.owner_user_id = ea.user_id
  WHERE pa.creation_date >  ea.first_q_time
    AND pa.creation_date <= TIMESTAMP_ADD(ea.first_q_time, INTERVAL 30 DAY)
)
SELECT
  month_2021,
  COUNT(*) AS ask_then_answer_users
FROM ask_then_answer
GROUP BY month_2021
ORDER BY month_2021
LIMIT 20;
```

```sql
-- 9. Putting everything together – monthly stats with percentages
WITH base AS (
  SELECT
    id,
    creation_date,
    FORMAT_DATE('%Y-%m', DATE(creation_date)) AS month_2021
  FROM `bigquery-public-data.stackoverflow.users`
  WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
),
early_ask AS (
  SELECT
    b.id                  AS user_id,
    b.month_2021,
    MIN(pq.creation_date) AS first_q_time
  FROM base AS b
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS pq
    ON pq.owner_user_id = b.id
  WHERE pq.creation_date BETWEEN b.creation_date
                            AND TIMESTAMP_ADD(b.creation_date, INTERVAL 30 DAY)
  GROUP BY user_id, month_2021
),
ask_then_answer AS (
  SELECT DISTINCT ea.user_id, ea.month_2021
  FROM early_ask AS ea
  JOIN `bigquery-public-data.stackoverflow.posts_answers` AS pa
    ON pa.owner_user_id = ea.user_id
  WHERE pa.creation_date >  ea.first_q_time
    AND pa.creation_date <= TIMESTAMP_ADD(ea.first_q_time, INTERVAL 30 DAY)
)
SELECT
  b.month_2021,
  COUNT(DISTINCT b.id)                                              AS new_users,
  COUNT(DISTINCT ea.user_id) / COUNT(DISTINCT b.id) * 100           AS pct_asked_within_30,
  COUNT(DISTINCT ata.user_id) / NULLIF(COUNT(DISTINCT ea.user_id),0) * 100
                                                                    AS pct_answer_after_question
FROM base AS b
LEFT JOIN early_ask      AS ea  ON ea.user_id = b.id
LEFT JOIN ask_then_answer AS ata ON ata.user_id = b.id
GROUP BY b.month_2021
ORDER BY b.month_2021
LIMIT 20;
```

```sql
-- 10. (Optional) Exact final answer without LIMIT – ready for production
SELECT
  b.month_2021                                        AS month,
  COUNT(DISTINCT b.id)                                AS total_new_users,
  ROUND(100 * COUNT(DISTINCT ea.user_id)
            / COUNT(DISTINCT b.id), 2)                AS pct_asked_in_30days,
  ROUND(100 * COUNT(DISTINCT ata.user_id)
            / NULLIF(COUNT(DISTINCT ea.user_id),0),2) AS pct_answer_after_question
FROM (
  SELECT id,
         creation_date,
         FORMAT_DATE('%Y-%m', DATE(creation_date)) AS month_2021
  FROM `bigquery-public-data.stackoverflow.users`
  WHERE DATE(creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
) AS b
LEFT JOIN (
  SELECT
    u.id AS user_id,
    FORMAT_DATE('%Y-%m', DATE(u.creation_date)) AS month_2021,
    MIN(pq.creation_date)                       AS first_q_time
  FROM `bigquery-public-data.stackoverflow.users`           AS u
  JOIN `bigquery-public-data.stackoverflow.posts_questions` AS pq
    ON pq.owner_user_id = u.id
  WHERE DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
    AND pq.creation_date BETWEEN u.creation_date
                            AND TIMESTAMP_ADD(u.creation_date, INTERVAL 30 DAY)
  GROUP BY user_id, month_2021
) AS ea
  ON ea.user_id  = b.id  AND ea.month_2021 = b.month_2021
LEFT JOIN (
  SELECT DISTINCT ea.user_id, ea.month_2021
  FROM (
    SELECT
      u.id AS user_id,
      FORMAT_DATE('%Y-%m', DATE(u.creation_date)) AS month_2021,
      MIN(pq.creation_date) AS first_q_time
    FROM `bigquery-public-data.stackoverflow.users`           AS u
    JOIN `bigquery-public-data.stackoverflow.posts_questions` AS pq
      ON pq.owner_user_id = u.id
    WHERE DATE(u.creation_date) BETWEEN '2021-01-01' AND '2021-12-31'
      AND pq.creation_date BETWEEN u.creation_date
                              AND TIMESTAMP_ADD(u.creation_date, INTERVAL 30 DAY)
    GROUP BY user_id, month_2021
  ) AS ea
  JOIN `bigquery-public-data.stackoverflow.posts_answers` AS pa
    ON pa.owner_user_id = ea.user_id
  WHERE pa.creation_date >  ea.first_q_time
    AND pa.creation_date <= TIMESTAMP_ADD(ea.first_q_time, INTERVAL 30 DAY)
) AS ata
  ON ata.user_id = b.id  AND ata.month_2021 = b.month_2021
GROUP BY month
ORDER BY month;
```

Each query above is limited to 20 rows (except the last which provides the full result) and builds step‑by‑step from simple inspection to the complete monthly statistics required.
