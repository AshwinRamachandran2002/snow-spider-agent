Begin Exploring Related Columns
Relevant columns and their potential usage  
• "created_at":  Registration date of each user – needed to keep only users registered between 1‑Jan‑2019 and 30‑Apr‑2022.  
• "age":          Age at registration – needed to identify the oldest and youngest users in that window.  
• "id":           Unique user key – can be counted to know how many users belong to each age group.

Typical conditions that will be reused  
• "created_at" BETWEEN 1546300800000000 AND 1651363199000000        -- 01‑Jan‑2019 00:00:00  to 30‑Apr‑2022 23:59:59 (micro‑seconds)  
• HAVING "age" = (SELECT MAX("age") …) or MIN("age")                -- to pick oldest / youngest ages

Ten exploratory SQL statements (all return ≤20 rows)  
```sql
-- 1. Quick look at user creation dates and ages
SELECT "id", "age", "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
LIMIT 20;
```

```sql
-- 2. Users that registered in the target period, ordered by date
SELECT "id", "age", "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
ORDER BY "created_at"
LIMIT 20;
```

```sql
-- 3. Distinct ages that appear in the target period
SELECT DISTINCT "age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
ORDER BY "age"
LIMIT 20;
```

```sql
-- 4. Oldest (maximum) age among users in the window
SELECT MAX("age") AS "max_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
LIMIT 20;
```

```sql
-- 5. Youngest (minimum) age among users in the window
SELECT MIN("age") AS "min_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
LIMIT 20;
```

```sql
-- 6. User counts by age in the period (top 20 ages)
SELECT "age", COUNT(*) AS "user_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY "age"
ORDER BY "age" DESC
LIMIT 20;
```

```sql
-- 7. Number of users who have the oldest age
WITH t AS (
  SELECT MAX("age") AS "oldest_age"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
)
SELECT COUNT(*) AS "oldest_user_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS", t
WHERE "age" = t."oldest_age"
  AND "created_at" BETWEEN 1546300800000000 AND 1651363199000000
LIMIT 20;
```

```sql
-- 8. Number of users who have the youngest age
WITH t AS (
  SELECT MIN("age") AS "youngest_age"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
)
SELECT COUNT(*) AS "youngest_user_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS", t
WHERE "age" = t."youngest_age"
  AND "created_at" BETWEEN 1546300800000000 AND 1651363199000000
LIMIT 20;
```

```sql
-- 9. Oldest and youngest ages together with their respective counts
WITH age_bounds AS (
  SELECT MIN("age") AS "youngest", MAX("age") AS "oldest"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
)
SELECT
  CASE WHEN "age" = (SELECT "oldest"  FROM age_bounds) THEN 'oldest'
       WHEN "age" = (SELECT "youngest" FROM age_bounds) THEN 'youngest'
  END AS "age_type",
  COUNT(*) AS "user_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS", age_bounds
WHERE "age" IN (age_bounds."youngest", age_bounds."oldest")
  AND "created_at" BETWEEN 1546300800000000 AND 1651363199000000
GROUP BY "age_type"
LIMIT 20;
```

```sql
-- 10. Difference in the number of oldest and youngest users
WITH age_extremes AS (
  SELECT MIN("age") AS "youngest", MAX("age") AS "oldest"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
),
counts AS (
  SELECT
    SUM(CASE WHEN "age" = (SELECT "oldest"  FROM age_extremes) THEN 1 ELSE 0 END) AS "oldest_cnt",
    SUM(CASE WHEN "age" = (SELECT "youngest" FROM age_extremes) THEN 1 ELSE 0 END) AS "youngest_cnt"
  FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
  WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
)
SELECT ("oldest_cnt" - "youngest_cnt") AS "difference_in_counts"
FROM counts
LIMIT 20;
```
