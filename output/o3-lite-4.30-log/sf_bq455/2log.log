--Description: Inspect slice positions of a concrete large CT series to detect duplicate
--             or irregular z‑spacing.  The SeriesInstanceUID is filled in with the first
--             candidate that appeared in the earlier size‑ranking query
--             (1.3.6.1.4.1.9328.50.17.3212576209713183142629060667025805170).
--             The query parses the third element (z‑coordinate) from ImagePositionPatient
--             and orders the images by that value so that spacing patterns can be reviewed.
SELECT  "InstanceNumber",
        "ImagePositionPatient",
        TRY_TO_DOUBLE( SPLIT_PART("ImagePositionPatient"::STRING, ',', 3) ) AS "z_mm"
FROM    IDC.IDC_V17.DICOM_ALL
WHERE   "SeriesInstanceUID" = '1.3.6.1.4.1.9328.50.17.3212576209713183142629060667025805170'
ORDER BY "z_mm"
LIMIT   20
