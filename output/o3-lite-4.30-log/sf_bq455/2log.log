```sql
--Description: The query assembles every CT SOP instance that is NOT from the “nlst” collection,
--             is NOT JPEG‑compressed, and is NOT tagged as a LOCALIZER image.  For each
--             SeriesInstanceUID it then aggregates:
--               • total byte‑size   -> MiB,
--               • image count,
--               • number of distinct values for orientation, pixel spacing, rows and columns.
--             Only series with perfectly consistent geometry (one unique value for each of
--             those parameters) are retained.  Finally, the list is ordered by total size
--             and the five largest series are returned together with their UID, series
--             number, patient ID and size.
WITH series_stats AS (
    SELECT  "SeriesInstanceUID",
            MIN("SeriesNumber")                        AS "SeriesNumber",
            MIN("PatientID")                           AS "PatientID",
            SUM("instance_size") / 1048576.0           AS "series_size_mib",
            COUNT(*)                                   AS n_images,
            COUNT(DISTINCT "ImageOrientationPatient")  AS n_orient,
            COUNT(DISTINCT "PixelSpacing")             AS n_pixsp,
            COUNT(DISTINCT "Rows")                     AS n_rows,
            COUNT(DISTINCT "Columns")                  AS n_cols
    FROM    IDC.IDC_V17.DICOM_ALL
    WHERE   "Modality" = 'CT'                                   -- keep CT only
      AND   "collection_id" <> 'nlst'                           -- exclude NLST
      AND   "TransferSyntaxUID" NOT IN                          -- drop JPEG series
            ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
      AND   ( "ImageType" IS NULL OR                            -- remove LOCALIZER images
              "ImageType" NOT ILIKE '%LOCALIZER%' )
    GROUP BY "SeriesInstanceUID"
)
SELECT  "SeriesInstanceUID",
        "SeriesNumber",
        "PatientID",
        "series_size_mib"
FROM    series_stats
WHERE   n_orient = 1     -- exactly one orientation vector
  AND   n_pixsp  = 1     -- one pixel spacing
  AND   n_rows   = 1     -- one row dimension
  AND   n_cols   = 1     -- one column dimension
ORDER BY "series_size_mib" DESC
LIMIT 5;
```
