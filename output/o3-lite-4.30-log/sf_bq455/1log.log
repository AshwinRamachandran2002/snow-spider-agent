--Description ─ Thinking process embedded in comments
--Goal: list the 5 largest CT scan series (MiB) that
--  ▸ are not in the NLST collection
--  ▸ are uncompressed (exclude JPEG TransferSyntaxUIDs)
--  ▸ contain no LOCALIZER images
--  ▸ have consistent pixel spacing, rows, columns, and ImageOrientationPatient
--  ▸ have orientation with |cross‑product z| ≈ 1  (slice plane orthogonal to z)
--  ▸ have no duplicate slices (#images = #unique z positions)
--Steps (implemented as CTEs):
-- 1) base            : initial modality / collection / compression filter
-- 2) localizer_series: identify any series that include LOCALIZER images
-- 3) non_localizer   : exclude those series completely
-- 4) series_consistent: keep series with single spacing / size / orientation value
-- 5) orientation_ok  : keep series whose orientation meets |cz|∈[0.99,1.01]
-- 6) z_unique        : ensure #images = #unique z positions (no duplicate slices)
-- 7) final_sizes     : aggregate byte size to MiB per surviving series
--Finally return the 5 largest series.

WITH base AS (                                             -- Step‑1
    SELECT *
    FROM IDC.IDC_V17.DICOM_ALL
    WHERE "Modality" = 'CT'
      AND "collection_id" <> 'nlst'
      AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70',   -- JPEG Lossless
                                      '1.2.840.10008.1.2.4.51')   -- JPEG Baseline
),
localizer_series AS (                                      -- Step‑2
    SELECT DISTINCT "SeriesInstanceUID"
    FROM base, LATERAL FLATTEN(INPUT => "ImageType") it
    WHERE it.value::STRING ILIKE '%LOCALIZER%'
),
non_localizer AS (                                         -- Step‑3
    SELECT *
    FROM base
    WHERE "SeriesInstanceUID" NOT IN (SELECT "SeriesInstanceUID"
                                      FROM localizer_series)
),
series_consistent AS (                                     -- Step‑4
    SELECT "SeriesInstanceUID"
    FROM non_localizer
    GROUP BY "SeriesInstanceUID"
    HAVING COUNT(DISTINCT "PixelSpacing")            = 1
       AND COUNT(DISTINCT "Rows")                    = 1
       AND COUNT(DISTINCT "Columns")                 = 1
       AND COUNT(DISTINCT "ImageOrientationPatient") = 1
),
orientation_ok AS (                                       -- Step‑5
    SELECT DISTINCT n."SeriesInstanceUID"
    FROM non_localizer n
    JOIN series_consistent sc
      ON n."SeriesInstanceUID" = sc."SeriesInstanceUID"
    WHERE ABS( (n."ImageOrientationPatient"[0]::FLOAT * n."ImageOrientationPatient"[4]::FLOAT)
              - (n."ImageOrientationPatient"[1]::FLOAT * n."ImageOrientationPatient"[3]::FLOAT) )
          BETWEEN 0.99 AND 1.01
),
z_unique AS (                                              -- Step‑6
    SELECT "SeriesInstanceUID"
    FROM non_localizer
    WHERE "SeriesInstanceUID" IN (SELECT "SeriesInstanceUID" FROM orientation_ok)
    GROUP BY "SeriesInstanceUID"
    HAVING COUNT(*) = COUNT(DISTINCT "ImagePositionPatient"[2]::FLOAT)
),
final_sizes AS (                                           -- Step‑7
    SELECT "SeriesInstanceUID",
           MAX("SeriesNumber")           AS "SeriesNumber",
           MAX("PatientID")              AS "PatientID",
           SUM("instance_size")/1048576.0 AS "series_size_MiB"
    FROM non_localizer
    WHERE "SeriesInstanceUID" IN (SELECT "SeriesInstanceUID" FROM z_unique)
    GROUP BY "SeriesInstanceUID"
)
SELECT "SeriesInstanceUID",
       "SeriesNumber",
       "PatientID",
       ROUND("series_size_MiB",2) AS "series_size_MiB"
FROM final_sizes
ORDER BY "series_size_MiB" DESC
LIMIT 5;
