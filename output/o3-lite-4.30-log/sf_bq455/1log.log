Begin Exploring Related Columns
Relevant columns and their potential usage  
• "Modality": modality filter (keep ‘CT’)  
• "collection_id": exclude ‘nlst’ collection  
• "TransferSyntaxUID": exclude JPEG‐compressed transfer syntaxes  
• "ImageType": exclude images whose type contains ‘LOCALIZER’  
• "SeriesInstanceUID": group/identify a CT series  
• "SeriesNumber": return in final output  
• "PatientID": return in final output  
• "instance_size": aggregate to get total series size (MiB)  
• "Rows", "Columns": pixel dimensions – must be constant inside a series  
• "PixelSpacing": must be constant inside a series  
• "ImageOrientationPatient": must be constant; also used to compute cross‑product z–component  
• "ImagePositionPatient": derive slice z–location and in‑plane x/y positions – must be unique/consistent  
• "XRayTubeCurrentInmA", "ExposureTime", "ExposureInmAs": exposure‑level consistency (illustrative – at least one of those fields usually populated)  
• "InstanceNumber" or "SOPInstanceUID": count images per series  

Below are 10 exploratory → progressively complex Snowflake SQL queries (all limited to 20 rows) to examine the data and arrive at a final query that satisfies all constraints.  Replace %DATABASE%, %SCHEMA%, %TABLE% with IDC.IDC_V17.DICOM_ALL exactly as shown.  Every column name is enclosed in double quotes.

```sql
-- 1)  Distinct imaging modalities present in the table
SELECT DISTINCT "Modality"
FROM IDC.IDC_V17.DICOM_ALL
LIMIT 20;
```

```sql
-- 2)  All collections that contain CT images (to verify which collections to exclude)
SELECT DISTINCT "collection_id"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
LIMIT 20;
```

```sql
-- 3)  All TransferSyntaxUID values used by CT images (find JPEG syntaxes to discard)
SELECT DISTINCT "TransferSyntaxUID"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
ORDER BY "TransferSyntaxUID"
LIMIT 20;
```

```sql
-- 4)  Sample ImageType strings found in CT images (flatten first element of the VALUE array)
--     Helps confirm how LOCALIZER appears in the tag
SELECT DISTINCT img_type.value::STRING AS "ImageType_String"
FROM IDC.IDC_V17.DICOM_ALL t,
     LATERAL FLATTEN( INPUT => t."ImageType") img_type
WHERE t."Modality" = 'CT'
LIMIT 20;
```

```sql
-- 5)  Inspect one CT series (non‑NLST) to see orientation, pixel spacing & slice positions
SELECT "SeriesInstanceUID",
       "PatientID",
       "SeriesNumber",
       "InstanceNumber",
       "ImageOrientationPatient",
       "PixelSpacing",
       "ImagePositionPatient"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_id" <> 'nlst'
  AND "SeriesInstanceUID" = (
        SELECT DISTINCT "SeriesInstanceUID"
        FROM IDC.IDC_V17.DICOM_ALL
        WHERE "Modality" = 'CT'
          AND "collection_id" <> 'nlst'
        LIMIT 1
      )
ORDER BY "InstanceNumber"
LIMIT 20;
```

```sql
-- 6)  Compute the absolute z‑component of the cross product between row & column direction cosines
--     for a sample of CT slices (expect |cz| ~ 1 for properly aligned axial/coronal/sagittal scans)
SELECT "SeriesInstanceUID",
       ABS( ("ImageOrientationPatient"[0]::FLOAT * "ImageOrientationPatient"[4]::FLOAT)
          - ("ImageOrientationPatient"[1]::FLOAT * "ImageOrientationPatient"[3]::FLOAT) ) AS "abs_cz"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_id" <> 'nlst'
LIMIT 20;
```

```sql
-- 7)  Aggregate total uncompressed size (MiB) per CT series that are *not* JPEG encoded
SELECT "SeriesInstanceUID",
       "SeriesNumber",
       "PatientID",
       SUM("instance_size")/1048576.0 AS "series_size_MiB",
       COUNT(*)                       AS "num_images"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_id" <> 'nlst'
  AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')
GROUP BY "SeriesInstanceUID", "SeriesNumber", "PatientID"
ORDER BY "series_size_MiB" DESC
LIMIT 20;
```

```sql
-- 8)  Check within each series that Pixel Spacing, Rows, Columns, and ImageOrientationPatient are unique
--     Any series with more than 1 distinct value in any of those tags will be excluded later
SELECT "SeriesInstanceUID",
       COUNT(DISTINCT "PixelSpacing")          AS cnt_px_spacing,
       COUNT(DISTINCT "Rows")                  AS cnt_rows,
       COUNT(DISTINCT "Columns")               AS cnt_cols,
       COUNT(DISTINCT "ImageOrientationPatient") AS cnt_iop
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_id" <> 'nlst'
GROUP BY "SeriesInstanceUID"
HAVING cnt_px_spacing = 1
   AND cnt_rows = 1
   AND cnt_cols = 1
   AND cnt_iop  = 1
LIMIT 20;
```

```sql
-- 9)  Series that have the same #images as #unique z‑positions (no duplicate slices)
WITH z_pos AS (
  SELECT "SeriesInstanceUID",
         "ImagePositionPatient"[2]::FLOAT AS z_loc
  FROM IDC.IDC_V17.DICOM_ALL
  WHERE "Modality" = 'CT'
    AND "collection_id" <> 'nlst'
)
SELECT s."SeriesInstanceUID",
       COUNT(*)               AS num_images,
       COUNT(DISTINCT z_loc)  AS uniq_z
FROM z_pos s
GROUP BY s."SeriesInstanceUID"
HAVING num_images = uniq_z
LIMIT 20;
```

```sql
-- 10)  Final selection: largest 5 CT series satisfying ALL stated constraints
WITH base AS (
    SELECT *
    FROM IDC.IDC_V17.DICOM_ALL
    WHERE "Modality" = 'CT'
      AND "collection_id" <> 'nlst'
      AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70','1.2.840.10008.1.2.4.51')
),
non_localizer AS (
    SELECT *
    FROM base b
    WHERE NOT EXISTS (
          SELECT 1
          FROM LATERAL FLATTEN( INPUT => b."ImageType") it
          WHERE it.value::STRING ILIKE '%LOCALIZER%'
    )
),
series_ok AS (
    -- retain series with consistent tech parameters
    SELECT "SeriesInstanceUID"
    FROM non_localizer
    GROUP BY "SeriesInstanceUID"
    HAVING COUNT(DISTINCT "PixelSpacing")           = 1
       AND COUNT(DISTINCT "Rows")                   = 1
       AND COUNT(DISTINCT "Columns")                = 1
       AND COUNT(DISTINCT "ImageOrientationPatient")= 1
),
orientation_ok AS (
    SELECT DISTINCT n."SeriesInstanceUID"
    FROM non_localizer n
         JOIN series_ok so USING ("SeriesInstanceUID")
    WHERE ABS( (n."ImageOrientationPatient"[0]::FLOAT * n."ImageOrientationPatient"[4]::FLOAT)
             - (n."ImageOrientationPatient"[1]::FLOAT * n."ImageOrientationPatient"[3]::FLOAT) ) BETWEEN 0.99 AND 1.01
),
z_ok AS (
    -- series whose #images = #unique z‐positions
    SELECT "SeriesInstanceUID"
    FROM non_localizer
    WHERE "SeriesInstanceUID" IN (SELECT * FROM orientation_ok)
    GROUP BY "SeriesInstanceUID"
    HAVING COUNT(*) = COUNT(DISTINCT "ImagePositionPatient"[2]::FLOAT)
),
size_tab AS (
    SELECT "SeriesInstanceUID",
           MAX("SeriesNumber")         AS "SeriesNumber",
           MAX("PatientID")            AS "PatientID",
           SUM("instance_size")/1048576.0  AS "series_size_MiB"
    FROM non_localizer
    WHERE "SeriesInstanceUID" IN (SELECT * FROM z_ok)
    GROUP BY "SeriesInstanceUID"
)
SELECT "SeriesInstanceUID",
       "SeriesNumber",
       "PatientID",
       ROUND("series_size_MiB",2) AS "series_size_MiB"
FROM size_tab
ORDER BY "series_size_MiB" DESC
LIMIT 5;
```
