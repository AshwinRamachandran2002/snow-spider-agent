```sql
--Description:  One‑shot query that returns the five largest CT series (MiB) that
--              meet every requested constraint:
--                 • CT modality, not from the NLST collection
--                 • uncompressed (exclude two JPEG TransferSyntaxUIDs)
--                 • no “LOCALIZER” images in ImageType
--                 • exactly one value for ImageOrientationPatient, PixelSpacing, Rows, Columns
--                 • number of images equals number of distinct z‑positions
--                 • |z‑component of IOP cross‑product| between 0.99 and 1.01
--                 • slice‑spacing standard deviation < 0.001  (uniform spacing)
--              The result is ordered by total series size (MiB) descending
--              and limited to the top five qualifying series.
WITH base AS (   --------------------------------------  filter instance‑level rows
    SELECT *
    FROM  IDC.IDC_V17.DICOM_ALL
    WHERE "Modality" = 'CT'
      AND "collection_id" <> 'nlst'
      AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70',
                                      '1.2.840.10008.1.2.4.51')
      AND "ImageType"::STRING NOT ILIKE '%LOCALIZER%'
),
series_ok AS (   -----------------------------------------  series‑level screening
    SELECT
        "SeriesInstanceUID",
        MIN("SeriesNumber")                        AS series_number,
        MIN("PatientID")                           AS patient_id,
        SUM("instance_size")/(1024*1024)           AS series_mib
    FROM   base
    GROUP BY "SeriesInstanceUID"
    HAVING COUNT(DISTINCT "ImageOrientationPatient") = 1            -- single IOP
       AND COUNT(DISTINCT "PixelSpacing")            = 1            -- one spacing
       AND COUNT(DISTINCT "Rows")                    = 1            -- const rows
       AND COUNT(DISTINCT "Columns")                 = 1            -- const columns
       AND COUNT(*) = COUNT(DISTINCT "ImagePositionPatient"[2])     -- no dup z
       AND ABS( MIN( ("ImageOrientationPatient"[0]::FLOAT *
                      "ImageOrientationPatient"[4]::FLOAT) -
                     ("ImageOrientationPatient"[1]::FLOAT *
                      "ImageOrientationPatient"[3]::FLOAT) ) )
           BETWEEN 0.99 AND 1.01                                    -- axial alignment
),
slice_spacing AS (  -----------------------------  slice‑spacing uniformity check
    SELECT
        "SeriesInstanceUID",
        STDDEV(dz) AS dz_std
    FROM (
        SELECT
            "SeriesInstanceUID",
            ABS( zpos - LAG(zpos) OVER (PARTITION BY "SeriesInstanceUID"
                                         ORDER BY zpos) ) AS dz
        FROM (
            SELECT
                "SeriesInstanceUID",
                "ImagePositionPatient"[2]::FLOAT AS zpos
            FROM base
        )
    )
    WHERE dz IS NOT NULL
    GROUP BY "SeriesInstanceUID"
    HAVING dz_std < 0.001                                          -- uniform spacing
)
SELECT  s."SeriesInstanceUID",
        s.series_number,
        s.patient_id,
        s.series_mib
FROM    series_ok      s
JOIN    slice_spacing  sp
       ON sp."SeriesInstanceUID" = s."SeriesInstanceUID"
ORDER BY s.series_mib DESC
LIMIT 5;
```
