```sql
/*  Top‑5 largest non‑NLST CT series that satisfy all stated quality criteria  */
WITH base AS (                                             -- 1) per‑instance filters
    SELECT
        "SeriesInstanceUID",
        "SeriesNumber",
        "PatientID",
        "ImageOrientationPatient",
        "ImagePositionPatient",
        "PixelSpacing",
        "Rows",
        "Columns",
        "instance_size"
    FROM IDC.IDC_V17.DICOM_ALL
    WHERE "Modality" = 'CT'
      AND "collection_id" <> 'nlst'                                -- exclude NLST
      AND "TransferSyntaxUID" NOT IN (                             -- exclude JPEG
            '1.2.840.10008.1.2.4.70',
            '1.2.840.10008.1.2.4.51')
      AND ARRAY_POSITION("ImageType", TO_VARIANT('LOCALIZER')) = 0  -- exclude LOCALIZER
),
series_basic AS (                                         -- 2) per‑series consistency checks
    SELECT
        "SeriesInstanceUID",
        MIN("SeriesNumber")                        AS series_number,
        MIN("PatientID")                           AS patient_id,
        COUNT(*)                                   AS img_cnt,
        COUNT(DISTINCT "ImageOrientationPatient")  AS orient_cnt,
        COUNT(DISTINCT "PixelSpacing")             AS pxsp_cnt,
        COUNT(DISTINCT "Rows")                     AS row_cnt,
        COUNT(DISTINCT "Columns")                  AS col_cnt,
        COUNT(DISTINCT "ImagePositionPatient"[2])  AS z_cnt,
        ABS(
            MIN( ("ImageOrientationPatient"[0]::FLOAT * "ImageOrientationPatient"[4]::FLOAT) -
                 ("ImageOrientationPatient"[1]::FLOAT * "ImageOrientationPatient"[3]::FLOAT) )
        )                                          AS z_cross_abs,
        SUM("instance_size") / (1024*1024)         AS series_mib
    FROM base
    GROUP BY "SeriesInstanceUID"
    HAVING orient_cnt = 1                -- single orientation
       AND pxsp_cnt = 1                  -- constant pixel spacing
       AND row_cnt  = 1                  -- constant rows
       AND col_cnt  = 1                  -- constant columns
       AND img_cnt  = z_cnt              -- one slice per z position
       AND z_cross_abs BETWEEN 0.99 AND 1.01
),
slice_diff AS (                                           -- 3) slice‑to‑slice spacing
    SELECT
        "SeriesInstanceUID",
        ABS( zpos - LAG(zpos) OVER (PARTITION BY "SeriesInstanceUID"
                                    ORDER BY zpos) ) AS dz
    FROM (
        SELECT
            "SeriesInstanceUID",
            "ImagePositionPatient"[2]::FLOAT AS zpos
        FROM base
    )
),
series_spacing AS (                                       -- 4) spacing std‑dev per series
    SELECT
        "SeriesInstanceUID",
        STDDEV(dz) AS dz_std
    FROM slice_diff
    WHERE dz IS NOT NULL
    GROUP BY "SeriesInstanceUID"
),
qualified AS (                                            -- 5) join basic & spacing rules
    SELECT
        sb.*
    FROM series_basic   sb
    JOIN series_spacing ss
          ON sb."SeriesInstanceUID" = ss."SeriesInstanceUID"
    WHERE ss.dz_std < 0.001                              -- nearly constant slice spacing
)
SELECT
    "SeriesInstanceUID",
    series_number,
    patient_id,
    ROUND(series_mib, 4) AS series_size_mib
FROM qualified
ORDER BY series_size_mib DESC NULLS LAST, "SeriesInstanceUID"
LIMIT 5;
```
