      AND "TransferSyntaxUID" NOT IN (                                -- no JPEG
            '1.2.840.10008.1.2.4.70',
            '1.2.840.10008.1.2.4.51')
      AND NOT ARRAY_CONTAINS('LOCALIZER', "ImageType")                -- no LOCALIZER
),
series_basic AS (   --  per‑series tests that only need simple aggregates
    SELECT
        "SeriesInstanceUID",
        MIN("SeriesNumber")                                            AS series_number,
        MIN("PatientID")                                               AS patient_id,
        COUNT(*)                                                       AS img_cnt,
        COUNT(DISTINCT "ImageOrientationPatient")                      AS orient_cnt,
        COUNT(DISTINCT "PixelSpacing")                                 AS pxsp_cnt,
        COUNT(DISTINCT "Rows")                                         AS row_cnt,
        COUNT(DISTINCT "Columns")                                      AS col_cnt,
        COUNT(DISTINCT "ImagePositionPatient"[2])                      AS z_cnt,
        ABS(
            MIN( ("ImageOrientationPatient"[0]::FLOAT * "ImageOrientationPatient"[4]::FLOAT) -
                 ("ImageOrientationPatient"[1]::FLOAT * "ImageOrientationPatient"[3]::FLOAT) )
        )                                                              AS z_cross_abs,
        SUM("instance_size")/(1024*1024)                               AS series_mib
    FROM base
    GROUP BY "SeriesInstanceUID"
    HAVING orient_cnt = 1                  -- single IOP
       AND pxsp_cnt = 1                    -- constant PixelSpacing
       AND row_cnt = 1                     -- constant Rows
       AND col_cnt = 1                     -- constant Columns
       AND img_cnt = z_cnt                 -- no duplicate slices
       AND z_cross_abs BETWEEN 0.99 AND 1.01  -- axial alignment
),
spacing_ok AS (   --  constant slice spacing (σ < 0.001 mm)
    SELECT
        sb.*,
        STDDEV(dz) AS dz_std
    FROM series_basic sb
    JOIN LATERAL (
        SELECT
            ABS(zpos - LAG(zpos) OVER (ORDER BY zpos)) AS dz
        FROM (
            SELECT "ImagePositionPatient"[2]::FLOAT AS zpos
            FROM   base
            WHERE  "SeriesInstanceUID" = sb."SeriesInstanceUID"
        ) z
    ) diff
    GROUP BY sb."SeriesInstanceUID",
             sb.series_number,
             sb.patient_id,
             sb.series_mib
    HAVING dz_std < 0.001
)
SELECT
    "SeriesInstanceUID",
    series_number,
    patient_id,
    ROUND(series_mib, 4) AS series_size_mib
FROM spacing_ok
ORDER BY series_size_mib DESC NULLS LAST, "SeriesInstanceUID"
LIMIT 5;
