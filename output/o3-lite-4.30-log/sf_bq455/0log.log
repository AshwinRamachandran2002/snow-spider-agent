--Description: Compute the z‑component of the cross‑product of the IOP vectors
--             and return 20 examples whose absolute value lies between 0.99 and 1.01.
WITH s AS (
    SELECT  "SeriesInstanceUID",
            "ImageOrientationPatient"[0]::FLOAT AS iop0,
            "ImageOrientationPatient"[1]::FLOAT AS iop1,
            "ImageOrientationPatient"[3]::FLOAT AS iop3,
            "ImageOrientationPatient"[4]::FLOAT AS iop4
    FROM    IDC.IDC_V17.DICOM_ALL
    WHERE   "Modality" = 'CT'
      AND   "collection_id" <> 'nlst'
    GROUP BY "SeriesInstanceUID", "ImageOrientationPatient"
)
SELECT DISTINCT
       "SeriesInstanceUID",
       (iop0 * iop4 - iop1 * iop3) AS z_cross
FROM   s
WHERE  ABS(iop0 * iop4 - iop1 * iop3) BETWEEN 0.99 AND 1.01
LIMIT 20
