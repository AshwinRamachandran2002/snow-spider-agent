Begin Exploring Related Columns
Relevant columns and their potential use  
• "collection_id": filter out `'nlst'`.  
• "Modality": keep only `'CT'`.  
• "SeriesInstanceUID": series identifier, needed for grouping.  
• "SeriesNumber": reportable attribute.  
• "PatientID": reportable attribute.  
• "instance_size": add up to obtain series size (MiB = SUM(instance_size)/(1024*1024)).  
• "ImageType": eliminate series that contain the value `'LOCALIZER'`.  
• "TransferSyntaxUID": exclude JPEG–compressed transfer syntaxes  
  (`'1.2.840.10008.1.2.4.70'`,`'1.2.840.10008.1.2.4.51'`).  
• "ImageOrientationPatient": check that only one unique value exists per series and use
  its two direction–cosine triplets to derive the z‑component of their cross‑product.  
• "ImagePositionPatient": verify consistency of slice intervals and uniqueness of
  z‑axis positions as well as in–plane (x,y) positions.  
• "PixelSpacing": make sure only one unique value per series.  
• "Rows","Columns": pixel dimensions – must be constant within the series.  
• "ExposureTime","XRayTubeCurrentInmA" (example exposure columns) – can be tested for
  consistency if desired.  
• "InstanceNumber": helps order slices, detect duplicates.  


Below are ten exploratory → progressively complex Snowflake SQL queries
(only the `IDC.IDC_V17.DICOM_ALL` table is referenced; all column names are
double‑quoted; each query returns ≤20 rows).


```sql
-- 1)  Distinct modalities available in the table (quick sanity check)
SELECT DISTINCT "Modality"
FROM IDC.IDC_V17.DICOM_ALL
LIMIT 20;
```

```sql
-- 2)  How many CT instances exist per collection (top 20 collections)
SELECT "collection_id",
       COUNT(*) AS ct_instance_cnt
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
GROUP BY "collection_id"
ORDER BY ct_instance_cnt DESC
LIMIT 20;
```

```sql
-- 3)  Distinct ImageType value‑sets found in CT instances (excluding NLST)
SELECT DISTINCT "ImageType"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_id" <> 'nlst'
LIMIT 20;
```

```sql
-- 4)  Transfer syntaxes that appear in CT instances
SELECT DISTINCT "TransferSyntaxUID"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_id" <> 'nlst'
LIMIT 20;
```

```sql
-- 5)  Sample CT series (non‑NLST) that are NOT JPEG‑compressed
--     and NOT LOCALIZER (quick check of ImageType filter)
SELECT "SeriesInstanceUID",
       MIN("SeriesNumber")  AS series_number,
       MIN("PatientID")     AS patient_id,
       COUNT(*)             AS num_images
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_id" <> 'nlst'
  AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70','1.2.840.10008.1.2.4.51')
  AND NOT ARRAY_CONTAINS('LOCALIZER', "ImageType")
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
-- 6)  Check that each candidate series has a single ImageOrientationPatient value
SELECT "SeriesInstanceUID",
       COUNT(DISTINCT "ImageOrientationPatient") AS orient_cnt,
       MIN("SeriesNumber")                        AS series_number,
       MIN("PatientID")                           AS patient_id
FROM IDC.IDC_V17.DICOM_ALL
WHERE "Modality" = 'CT'
  AND "collection_id" <> 'nlst'
GROUP BY "SeriesInstanceUID"
HAVING orient_cnt = 1
LIMIT 20;
```

```sql
-- 7)  Calculate the z‑component of the cross‑product of the IOP vectors
--     (show 20 examples, already filtered to abs(z) between 0.99 and 1.01)
WITH s AS (
  SELECT "SeriesInstanceUID",
         "ImageOrientationPatient"[0]::FLOAT  AS iop0,
         "ImageOrientationPatient"[1]::FLOAT  AS iop1,
         "ImageOrientationPatient"[2]::FLOAT  AS iop2,
         "ImageOrientationPatient"[3]::FLOAT  AS iop3,
         "ImageOrientationPatient"[4]::FLOAT  AS iop4,
         "ImageOrientationPatient"[5]::FLOAT  AS iop5
  FROM IDC.IDC_V17.DICOM_ALL
  WHERE "Modality" = 'CT'
    AND "collection_id" <> 'nlst'
)
SELECT DISTINCT "SeriesInstanceUID",
       (iop0*iop4 - iop1*iop3) AS z_cross
FROM s
WHERE ABS(iop0*iop4 - iop1*iop3) BETWEEN 0.99 AND 1.01
LIMIT 20;
```

```sql
-- 8)  Verify that number of images equals number of unique z positions
--     (quick sample of 20 series)
WITH imgs AS (
  SELECT "SeriesInstanceUID",
         COUNT(*)                              AS img_cnt,
         COUNT(DISTINCT "ImagePositionPatient"[2]) AS z_cnt
  FROM IDC.IDC_V17.DICOM_ALL
  WHERE "Modality" = 'CT'
    AND "collection_id" <> 'nlst'
  GROUP BY "SeriesInstanceUID"
)
SELECT *
FROM imgs
WHERE img_cnt = z_cnt
LIMIT 20;
```

```sql
-- 9)  Compute per‑series slice spacing stdev to ensure constant intervals
--     (series with stdev < 1e‑3 are likely constant; show 20)
WITH z AS (
  SELECT "SeriesInstanceUID",
         "ImagePositionPatient"[2]::FLOAT AS zpos
  FROM IDC.IDC_V17.DICOM_ALL
  WHERE "Modality" = 'CT'
    AND "collection_id" <> 'nlst'
),
dz AS (
  SELECT "SeriesInstanceUID",
         zpos,
         LAG(zpos)  OVER (PARTITION BY "SeriesInstanceUID" ORDER BY zpos) AS prev_z
  FROM z
),
dif AS (
  SELECT "SeriesInstanceUID",
         ABS(zpos - prev_z) AS dz
  FROM dz
  WHERE prev_z IS NOT NULL
),
agg AS (
  SELECT "SeriesInstanceUID",
         STDDEV(dz) AS dz_std
  FROM dif
  GROUP BY "SeriesInstanceUID"
)
SELECT *
FROM agg
WHERE dz_std < 0.001  -- roughly constant spacing
LIMIT 20;
```

```sql
-- 10)  FINAL: Top‑5 largest CT series (MiB) fulfilling all conditions
WITH base AS (
  SELECT *
  FROM IDC.IDC_V17.DICOM_ALL
  WHERE "Modality" = 'CT'
    AND "collection_id" <> 'nlst'
    AND "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70','1.2.840.10008.1.2.4.51')
    AND NOT ARRAY_CONTAINS('LOCALIZER', "ImageType")
),
series_ok AS (
  /* keep only series that have:
     – exactly one ImageOrientationPatient
     – constant PixelSpacing, Rows, Columns
     – img_cnt = unique z_cnt
     – z‑axis of cross‑product within ±0.01 of 1
  */
  SELECT
    "SeriesInstanceUID",
    MIN("SeriesNumber")                         AS series_number,
    MIN("PatientID")                            AS patient_id,
    COUNT(*)                                    AS img_cnt,
    COUNT(DISTINCT "ImageOrientationPatient")   AS orient_cnt,
    COUNT(DISTINCT "PixelSpacing")              AS pxsp_cnt,
    COUNT(DISTINCT "Rows")                      AS row_cnt,
    COUNT(DISTINCT "Columns")                   AS col_cnt,
    COUNT(DISTINCT "ImagePositionPatient"[2])   AS z_cnt,
    MIN(ABS(
        ("ImageOrientationPatient"[0]::FLOAT * "ImageOrientationPatient"[4]::FLOAT) -
        ("ImageOrientationPatient"[1]::FLOAT * "ImageOrientationPatient"[3]::FLOAT)
    ))                                          AS z_cross_abs,
    SUM("instance_size")/(1024*1024)            AS series_mib
  FROM base
  GROUP BY "SeriesInstanceUID"
  HAVING orient_cnt = 1
     AND pxsp_cnt = 1
     AND row_cnt  = 1
     AND col_cnt  = 1
     AND img_cnt  = z_cnt
     AND z_cross_abs BETWEEN 0.99 AND 1.01
),
spacing_ok AS (
  /* constant slice spacing check */
  SELECT so.*,
         STDDEV(dz) AS dz_std
  FROM series_ok so
  JOIN LATERAL (
        SELECT ABS(zpos - prev_z) AS dz
        FROM (
          SELECT "ImagePositionPatient"[2]::FLOAT AS zpos,
                 LAG("ImagePositionPatient"[2]::FLOAT) OVER (ORDER BY "ImagePositionPatient"[2]::FLOAT) AS prev_z
          FROM base b
          WHERE b."SeriesInstanceUID" = so."SeriesInstanceUID"
        ) q
        WHERE prev_z IS NOT NULL
  ) t
  GROUP BY so."SeriesInstanceUID", so.series_number, so.patient_id, so.img_cnt,
           so.series_mib, so.z_cross_abs
  HAVING dz_std < 0.001
)
SELECT "SeriesInstanceUID",
       series_number,
       patient_id,
       series_mib
FROM spacing_ok
ORDER BY series_mib DESC
LIMIT 5;
```

