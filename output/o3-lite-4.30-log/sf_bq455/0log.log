```sql
--Description: Check CT series (non‑NLST) that have exactly one unique ImageOrientationPatient value.
SELECT  "SeriesInstanceUID",
        COUNT(DISTINCT "ImageOrientationPatient") AS orient_cnt,
        MIN("SeriesNumber")                        AS series_number,
        MIN("PatientID")                           AS patient_id
FROM    IDC.IDC_V17.DICOM_ALL
WHERE   "Modality" = 'CT'
  AND   "collection_id" <> 'nlst'
GROUP BY "SeriesInstanceUID"
HAVING  orient_cnt = 1
LIMIT 20;
```

```sql
--Description: Compute the z‑component of the cross‑product of the IOP vectors
--             and return 20 examples whose absolute value lies between 0.99 and 1.01.
WITH s AS (
    SELECT  "SeriesInstanceUID",
            "ImageOrientationPatient"[0]::FLOAT AS iop0,
            "ImageOrientationPatient"[1]::FLOAT AS iop1,
            "ImageOrientationPatient"[3]::FLOAT AS iop3,
            "ImageOrientationPatient"[4]::FLOAT AS iop4
    FROM    IDC.IDC_V17.DICOM_ALL
    WHERE   "Modality" = 'CT'
      AND   "collection_id" <> 'nlst'
    GROUP BY "SeriesInstanceUID", "ImageOrientationPatient"
)
SELECT DISTINCT
       "SeriesInstanceUID",
       (iop0 * iop4 - iop1 * iop3) AS z_cross
FROM   s
WHERE  ABS(iop0 * iop4 - iop1 * iop3) BETWEEN 0.99 AND 1.01
LIMIT 20;
```

```sql
--Description: Verify that, for each CT series (non‑NLST), the number of
--             images equals the number of unique z‑axis positions.
WITH imgs AS (
    SELECT  "SeriesInstanceUID",
            COUNT(*)                                AS img_cnt,
            COUNT(DISTINCT "ImagePositionPatient"[2]) AS z_cnt
    FROM    IDC.IDC_V17.DICOM_ALL
    WHERE   "Modality" = 'CT'
      AND   "collection_id" <> 'nlst'
    GROUP BY "SeriesInstanceUID"
)
SELECT *
FROM   imgs
WHERE  img_cnt = z_cnt
LIMIT 20;
```

```sql
--Description: For every CT series (non‑NLST) compute the standard deviation of
--             inter‑slice spacing; keep those with almost constant spacing (σ < 0.001).
WITH z AS (
    SELECT  "SeriesInstanceUID",
            "ImagePositionPatient"[2]::FLOAT AS zpos
    FROM    IDC.IDC_V17.DICOM_ALL
    WHERE   "Modality" = 'CT'
      AND   "collection_id" <> 'nlst'
),
dz AS (
    SELECT  "SeriesInstanceUID",
            zpos,
            LAG(zpos) OVER (PARTITION BY "SeriesInstanceUID" ORDER BY zpos) AS prev_z
    FROM    z
),
dif AS (
    SELECT  "SeriesInstanceUID",
            ABS(zpos - prev_z) AS dz
    FROM    dz
    WHERE   prev_z IS NOT NULL
),
agg AS (
    SELECT  "SeriesInstanceUID",
            STDDEV(dz) AS dz_std
    FROM    dif
    GROUP BY "SeriesInstanceUID"
)
SELECT *
FROM   agg
WHERE  dz_std < 0.001        -- nearly constant slice spacing
LIMIT 20;
```

```sql
--Description: Final query — top‑5 largest non‑NLST CT series (size in MiB)
--             that satisfy all required consistency checks.
WITH base AS (   -- filter by modality, collection, compression, LOCALIZER
    SELECT *
    FROM   IDC.IDC_V17.DICOM_ALL
    WHERE  "Modality" = 'CT'
      AND  "collection_id" <> 'nlst'
      AND  "TransferSyntaxUID" NOT IN ('1.2.840.10008.1.2.4.70',
                                       '1.2.840.10008.1.2.4.51')
      AND  "ImageType"::STRING NOT ILIKE '%LOCALIZER%'
),
series_ok AS (   -- series‑level constraints except slice‑spacing
    SELECT
        "SeriesInstanceUID",
        MIN("SeriesNumber")                       AS series_number,
        MIN("PatientID")                          AS patient_id,
        COUNT(*)                                  AS img_cnt,
        COUNT(DISTINCT "ImageOrientationPatient") AS orient_cnt,
        COUNT(DISTINCT "PixelSpacing")            AS pxsp_cnt,
        COUNT(DISTINCT "Rows")                    AS row_cnt,
        COUNT(DISTINCT "Columns")                 AS col_cnt,
        COUNT(DISTINCT "ImagePositionPatient"[2]) AS z_cnt,
        ABS( MIN(
              ("ImageOrientationPatient"[0]::FLOAT *
               "ImageOrientationPatient"[4]::FLOAT) -
              ("ImageOrientationPatient"[1]::FLOAT *
               "ImageOrientationPatient"[3]::FLOAT)
            ))                                    AS z_cross_abs,
        SUM("instance_size") / (1024*1024)        AS series_mib
    FROM  base
    GROUP BY "SeriesInstanceUID"
    HAVING orient_cnt = 1         -- one IOP value
       AND pxsp_cnt = 1           -- constant pixel spacing
       AND row_cnt  = 1           -- constant rows
       AND col_cnt  = 1           -- constant columns
       AND img_cnt  = z_cnt       -- no duplicate z positions
       AND z_cross_abs BETWEEN 0.99 AND 1.01
),
spacing_ok AS (  -- enforce near‑constant slice spacing (σ < 0.001)
    SELECT  so.*,
            STDDEV(dz) AS dz_std
    FROM    series_ok so
    CROSS JOIN LATERAL (
        SELECT  ABS(zpos - prev_z) AS dz
        FROM   (
            SELECT "ImagePositionPatient"[2]::FLOAT AS zpos,
                   LAG("ImagePositionPatient"[2]::FLOAT)
                   OVER (ORDER BY "ImagePositionPatient"[2]::FLOAT) AS prev_z
            FROM   base b
            WHERE  b."SeriesInstanceUID" = so."SeriesInstanceUID"
        ) s
        WHERE  prev_z IS NOT NULL
    ) t
    GROUP BY so."SeriesInstanceUID", so.series_number, so.patient_id,
             so.img_cnt, so.series_mib, so.z_cross_abs
    HAVING  dz_std < 0.001
)
SELECT  "SeriesInstanceUID",
        series_number,
        patient_id,
        series_mib
FROM    spacing_ok
ORDER BY series_mib DESC
LIMIT 5;
```
