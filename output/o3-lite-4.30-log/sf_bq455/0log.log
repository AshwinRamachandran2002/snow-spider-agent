--Description: For every CT series (non‑NLST) compute the standard deviation of
--             inter‑slice spacing; keep those with almost constant spacing (σ < 0.001).
WITH z AS (
    SELECT  "SeriesInstanceUID",
            "ImagePositionPatient"[2]::FLOAT AS zpos
    FROM    IDC.IDC_V17.DICOM_ALL
    WHERE   "Modality" = 'CT'
      AND   "collection_id" <> 'nlst'
),
dz AS (
    SELECT  "SeriesInstanceUID",
            zpos,
            LAG(zpos) OVER (PARTITION BY "SeriesInstanceUID" ORDER BY zpos) AS prev_z
    FROM    z
),
dif AS (
    SELECT  "SeriesInstanceUID",
            ABS(zpos - prev_z) AS dz
    FROM    dz
    WHERE   prev_z IS NOT NULL
),
agg AS (
    SELECT  "SeriesInstanceUID",
            STDDEV(dz) AS dz_std
    FROM    dif
    GROUP BY "SeriesInstanceUID"
)
SELECT *
FROM   agg
WHERE  dz_std < 0.001        -- nearly constant slice spacing
LIMIT 20
