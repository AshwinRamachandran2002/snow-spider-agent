```sql
--Description: Find 2021 Bitcoin transactions that qualify as CoinJoin candidates
--             using two practical, data‑backed rules:
--             • the transaction has more than two outputs (≥3), and
--             • at least one output amount repeats within the transaction
--               (multiple equal‑value outputs).
--             The query returns each candidate’s hash together with the number
--             of identical‑value outputs observed for the *most common* value,
--             helping assess CoinJoin strength.  Limiting to 20 keeps output readable.
WITH tx21 AS (                      -- 2021 transactions with >2 outputs
    SELECT "hash"
    FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
    WHERE "output_count" > 2
      AND "block_timestamp" BETWEEN 1609459200000000  -- 01‑Jan‑2021
                                AND 1640995199000000  -- 31‑Dec‑2021
),
dup_counts AS (                     -- count how many times each value repeats
    SELECT
        o."transaction_hash",
        MAX(COUNT(*)) AS "max_equal_outputs"          -- highest repeat count per tx
    FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o
    JOIN tx21 t ON t."hash" = o."transaction_hash"
    GROUP BY o."transaction_hash", o."value"
    HAVING COUNT(*) > 1
)
SELECT
    "transaction_hash",
    "max_equal_outputs"
FROM dup_counts
ORDER BY "max_equal_outputs" DESC
LIMIT 20;
```
