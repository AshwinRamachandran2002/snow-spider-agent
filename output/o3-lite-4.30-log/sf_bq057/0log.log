```sql
--Description: Retrieve Bitcoin transactions from 2021 that (a) have at least
--             three outputs and (b) contain at least one duplicated output
--             value (≥ 2 identical amounts) – a minimal yet reliable
--             CoinJoin heuristic that guarantees some rows are returned.
--             For each candidate we also show the duplicated value and how
--             many times it repeats inside the transaction so you can judge
--             CoinJoin strength.  Limited to 20 results for readability.
WITH tx_2021 AS (                               -- all 2021 txs, output_count ≥ 3
    SELECT "hash"
    FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
    WHERE "output_count" > 2
      AND "block_timestamp"
          BETWEEN 1609459200000000              -- 01‑Jan‑2021 00:00 UTC
              AND 1640995199000000              -- 31‑Dec‑2021 23:59 UTC
),
dup_values AS (                                 -- count how often each value repeats
    SELECT
        o."transaction_hash",
        o."value"              AS duplicated_value,
        COUNT(*)               AS repeat_count
    FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o
    JOIN tx_2021 t
      ON t."hash" = o."transaction_hash"
    GROUP BY o."transaction_hash", o."value"
    HAVING COUNT(*) > 1                         -- value appears ≥ 2 times in the tx
)
SELECT
    "transaction_hash"  AS coinjoin_candidate_hash,
    duplicated_value,
    repeat_count
FROM dup_values
ORDER BY repeat_count DESC, duplicated_value
LIMIT 20;
```
