        GROUP BY o."transaction_hash", o."value"
        HAVING COUNT(*) > 1
    )
    SELECT DISTINCT m."hash"
    FROM multi_out m
    JOIN dup_values d ON d."transaction_hash" = m."hash"
    WHERE m."output_value" <= m."input_value"
),
all_inputs AS (
    SELECT
        MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m",
        COUNT(*) AS "in_utxos"
    FROM CRYPTO.CRYPTO_BITCOIN.INPUTS i
    JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t
      ON t."hash" = i."transaction_hash"
    WHERE t."block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
    GROUP BY 1
),
cj_inputs AS (
    SELECT
        MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m",
        COUNT(*) AS "cj_in_utxos"
    FROM CRYPTO.CRYPTO_BITCOIN.INPUTS i
    JOIN cj_hash h ON h."hash" = i."transaction_hash"
    JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t ON t."hash" = h."hash"
    GROUP BY 1
)
SELECT
    a."m" AS "month",
    a."in_utxos",
    COALESCE(c."cj_in_utxos",0) AS "cj_in_utxos"
FROM all_inputs a
LEFT JOIN cj_inputs c USING("m")
ORDER BY "month";
