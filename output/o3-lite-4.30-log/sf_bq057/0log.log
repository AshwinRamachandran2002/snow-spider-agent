--Description: #9 – Monthly CoinJoin vs. total Bitcoin volume in 2021 (satoshis).
WITH cj_hash AS ( /* same as earlier */ 
    WITH multi_out AS (
        SELECT "hash","output_value","input_value","block_timestamp"
        FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
        WHERE "output_count" > 2
          AND "block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
    ),
    dup_values AS (
        SELECT o."transaction_hash"
        FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o
        JOIN multi_out m ON m."hash" = o."transaction_hash"
        GROUP BY o."transaction_hash", o."value"
        HAVING COUNT(*) > 1
    )
    SELECT DISTINCT m."hash"
    FROM multi_out m
    JOIN dup_values d ON d."transaction_hash" = m."hash"
    WHERE m."output_value" <= m."input_value"
),
vol_all AS (
    SELECT
        MONTH(TO_TIMESTAMP_NTZ("block_timestamp"/1e6)) AS "m",
        SUM("output_value") AS "tot_vol"
    FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
    WHERE "block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
    GROUP BY 1
),
vol_cj AS (
    SELECT
        MONTH(TO_TIMESTAMP_NTZ("block_timestamp"/1e6)) AS "m",
        SUM("output_value") AS "cj_vol"
    FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
    WHERE "hash" IN (SELECT "hash" FROM cj_hash)
    GROUP BY 1
)
SELECT
    a."m"  AS "month",
    a."tot_vol",
    COALESCE(c."cj_vol",0) AS "cj_vol"
FROM vol_all a
LEFT JOIN vol_cj c USING("m")
ORDER BY "month";
