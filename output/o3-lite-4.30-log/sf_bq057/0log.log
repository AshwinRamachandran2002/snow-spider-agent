```sql
--Description: #5 – Flag 2021 CoinJoin‐candidate transactions.
--             Criteria: (a) more than two outputs, (b) output_value ≤ input_value,
--             (c) at least one duplicated output amount inside the tx.
--             Returns 20 candidate tx hashes.
WITH multi_out AS (
    SELECT
        "hash",
        "output_value",
        "input_value",
        "block_timestamp"
    FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
    WHERE "output_count" > 2
      AND "block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000   -- 2021
),
dup_values AS (
    SELECT
        o."transaction_hash"
    FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o
    JOIN multi_out m
      ON m."hash" = o."transaction_hash"
    GROUP BY o."transaction_hash", o."value"
    HAVING COUNT(*) > 1                       -- duplicate amount
),
cj AS (
    SELECT DISTINCT m."hash"
    FROM multi_out m
    JOIN dup_values d ON d."transaction_hash" = m."hash"
    WHERE m."output_value" <= m."input_value"  -- value conservation
)
SELECT *
FROM cj
LIMIT 20;
```

```sql
--Description: #6 – Monthly count of all vs. CoinJoin transactions in 2021.
WITH cj_hash AS (                                         -- CoinJoin tx hashes (query #5)
    WITH multi_out AS (
        SELECT "hash","output_value","input_value","block_timestamp"
        FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
        WHERE "output_count" > 2
          AND "block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
    ),
    dup_values AS (
        SELECT o."transaction_hash"
        FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o
        JOIN multi_out m ON m."hash" = o."transaction_hash"
        GROUP BY o."transaction_hash", o."value"
        HAVING COUNT(*) > 1
    )
    SELECT DISTINCT m."hash"
    FROM multi_out m
    JOIN dup_values d ON d."transaction_hash" = m."hash"
    WHERE m."output_value" <= m."input_value"
),
all_tx AS (
    SELECT
        MONTH(TO_TIMESTAMP_NTZ("block_timestamp"/1e6)) AS "m",
        COUNT(*) AS "total_txs"
    FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
    WHERE "block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
    GROUP BY 1
),
cj_tx AS (
    SELECT
        MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m",
        COUNT(*) AS "cj_txs"
    FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t
    JOIN cj_hash c ON c."hash" = t."hash"
    GROUP BY 1
)
SELECT
    a."m"        AS "month",
    a."total_txs",
    COALESCE(c."cj_txs",0) AS "cj_txs"
FROM all_tx a
LEFT JOIN cj_tx c USING("m")
ORDER BY "month";
```

