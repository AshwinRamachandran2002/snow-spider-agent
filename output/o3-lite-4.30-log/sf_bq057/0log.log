--Description: #7 – Monthly CoinJoin input‑UTXO share in 2021.
WITH cj_hash AS ( /* same construction as query #6 */ 
    WITH multi_out AS (
        SELECT "hash","output_value","input_value","block_timestamp"
        FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
        WHERE "output_count" > 2
