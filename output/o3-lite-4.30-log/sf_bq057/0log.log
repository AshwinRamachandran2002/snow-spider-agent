```sql
--Description: Identify 2021 Bitcoin transactions that meet three CoinJoin heuristics:
--             ① at least three outputs, ② total outputs ≤ total inputs (value conserved),
--             ③ ≥ 2 identical output amounts in the same transaction.
--             Returns up to 20 CoinJoin‑candidate transaction hashes.
WITH candidate_tx AS (                    -- heuristics ① & ②
    SELECT
        "hash"
    FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
    WHERE "output_count" > 2
      AND "output_value" <= "input_value"
      AND "block_timestamp" BETWEEN 1609459200000000   -- 01‑Jan‑2021 00:00 UTC
                                AND 1640995199000000   -- 31‑Dec‑2021 23:59 UTC
),
dup_value_tx AS (                          -- heuristic ③
    SELECT
        o."transaction_hash"
    FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o
    JOIN candidate_tx t ON t."hash" = o."transaction_hash"
    GROUP BY o."transaction_hash", o."value"
    HAVING COUNT(*) > 1                    -- duplicated output amount
)
SELECT DISTINCT
    "transaction_hash" AS coinjoin_candidate_hash
FROM dup_value_tx
LIMIT 20;
