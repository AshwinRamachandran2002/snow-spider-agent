```sql
--Description: #10 – Determine the 2021 month with the highest CoinJoin volume share
--             and report all requested percentages.
WITH
cj_hash AS ( /* CoinJoin tx hashes – same logic as earlier */ 
    WITH multi_out AS (
        SELECT "hash","output_value","input_value","block_timestamp"
        FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
        WHERE "output_count" > 2
          AND "block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
    ),
    dup_values AS (
        SELECT o."transaction_hash"
        FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o
        JOIN multi_out m ON m."hash" = o."transaction_hash"
        GROUP BY o."transaction_hash", o."value"
        HAVING COUNT(*) > 1
    )
    SELECT DISTINCT m."hash"
    FROM multi_out m
    JOIN dup_values d ON d."transaction_hash" = m."hash"
    WHERE m."output_value" <= m."input_value"
),
base AS (
    SELECT
        MONTH(TO_TIMESTAMP_NTZ("block_timestamp"/1e6)) AS "m",
        COUNT(*)            AS "total_tx",
        SUM("output_value") AS "tot_vol"
    FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
    WHERE "block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
    GROUP BY 1
),
cj AS (
    SELECT
        MONTH(TO_TIMESTAMP_NTZ("block_timestamp"/1e6)) AS "m",
        COUNT(*)            AS "cj_tx",
        SUM("output_value") AS "cj_vol"
    FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
    WHERE "hash" IN (SELECT "hash" FROM cj_hash)
    GROUP BY 1
),
in_all AS (
    SELECT MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m", COUNT(*) AS "in_utxos"
    FROM CRYPTO.CRYPTO_BITCOIN.INPUTS i
    JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t ON t."hash" = i."transaction_hash"
    WHERE t."block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
    GROUP BY 1
),
in_cj AS (
    SELECT MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m", COUNT(*) AS "cj_in_utxos"
    FROM CRYPTO.CRYPTO_BITCOIN.INPUTS i
    JOIN cj_hash c ON c."hash" = i."transaction_hash"
    JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t ON t."hash" = c."hash"
    GROUP BY 1
),
out_all AS (
    SELECT MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m", COUNT(*) AS "out_utxos"
    FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o
    JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t ON t."hash" = o."transaction_hash"
    WHERE t."block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
    GROUP BY 1
),
out_cj AS (
    SELECT MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m", COUNT(*) AS "cj_out_utxos"
    FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o
    JOIN cj_hash c ON c."hash" = o."transaction_hash"
    JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t ON t."hash" = c."hash"
    GROUP BY 1
),
joined AS (
    SELECT
        b."m",
        b."total_tx",
        c."cj_tx",
        ROUND(c."cj_tx"*100.0 / b."total_tx", 1) AS "pct_tx_cj",
        (ic."cj_in_utxos" + oc."cj_out_utxos") / 2.0             AS "cj_utxos",
        (ia."in_utxos"      + oa."out_utxos") / 2.0              AS "all_utxos",
        ROUND(((ic."cj_in_utxos"+oc."cj_out_utxos")/2.0)
              *100.0 / ((ia."in_utxos"+oa."out_utxos")/2.0), 1)  AS "pct_utxo_cj",
        b."tot_vol",
        c."cj_vol",
        ROUND(c."cj_vol"*100.0 / b."tot_vol", 1) AS "pct_vol_cj"
    FROM base b
    JOIN cj      c  ON b."m" = c."m"
    JOIN in_all  ia ON b."m" = ia."m"
    JOIN in_cj   ic ON b."m" = ic."m"
    JOIN out_all oa ON b."m" = oa."m"
    JOIN out_cj  oc ON b."m" = oc."m"
)
SELECT
    "m"               AS "month_number",
    "pct_tx_cj",      -- % of all txs that are CoinJoin
    "pct_utxo_cj",    -- % of UTXOs in CoinJoin (avg in/out)
    "pct_vol_cj"      -- % of volume that is CoinJoin
FROM joined
ORDER BY "pct_vol_cj" DESC
LIMIT 1;
```
