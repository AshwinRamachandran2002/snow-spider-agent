),
dup AS (
    SELECT 
        o."transaction_hash",
        o."value"
    FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o
    JOIN tx21 t
      ON t."hash" = o."transaction_hash"
    GROUP BY o."transaction_hash", o."value"
    HAVING COUNT(*) > 1            -- repeated value within the same tx
)
SELECT *
FROM dup
LIMIT 20;
