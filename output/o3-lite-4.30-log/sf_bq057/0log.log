--Description: Locate probable CoinJoin transactions by first selecting every Bitcoin
--             transaction that has more than two outputs (a common CoinJoin trait),
--             then finding cases where at least one output value appears multiple
--             times within the same transaction.  We return up to 20 such
--             (transaction‑hash, identical‑value‑output‑count) pairs for inspection.
WITH multi_out_tx AS (
    SELECT "hash"
    FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
    WHERE "output_count" > 2           -- basic CoinJoin characteristic
),
dup_values AS (
    SELECT
        o."transaction_hash",
        COUNT(*) AS "identical_value_outputs"
    FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o
    JOIN multi_out_tx t
      ON t."hash" = o."transaction_hash"
    GROUP BY o."transaction_hash", o."value"
    HAVING COUNT(*) > 1                -- same value repeated within the tx
)
SELECT
    "transaction_hash",
    "identical_value_outputs"
FROM dup_values
ORDER BY "identical_value_outputs" DESC
LIMIT 20;
