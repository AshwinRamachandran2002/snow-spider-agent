Relevant columns and their potential usage  

• CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS  
  – "hash": join‑key to INPUTS / OUTPUTS  
  – "block_timestamp": filter to 2021 and extract month  
  – "input_value", "output_value": compare input vs. output sums  
  – "output_count": be sure transaction has > 2 outputs  
  – "input_count": (needed later for UTXO percentages)  

• CRYPTO.CRYPTO_BITCOIN.OUTPUTS  
  – "transaction_hash": join‐key to TRANSACTIONS  
  – "value": detect repeated equal‑value outputs (CoinJoin heuristic)  

• CRYPTO.CRYPTO_BITCOIN.INPUTS  
  – "transaction_hash": join‐key to TRANSACTIONS  
  – "value": count input UTXOs for UTXO percentage  


Below are ten exploratory Snowflake SQL snippets (all limited to 20 rows) that walk from simple inspection toward the final logic.  
Remember to adjust the database / schema / table names if your naming differs; every identifier is double‑quoted.

```sql
-- 1. Preview 2021 Bitcoin transactions with basic monetary fields
SELECT 
    "hash",
    "block_timestamp",
    "input_value",
    "output_value",
    "input_count",
    "output_count"
FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
WHERE "block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000  -- 2021 in micro‑seconds
LIMIT 20;
```

```sql
-- 2. Inspect a few 2021 outputs to see the format of the "value" field
SELECT 
    "transaction_hash",
    "value"
FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS
WHERE "transaction_hash" IN (
      SELECT "hash"
      FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
      WHERE "block_timestamp" BETWEEN 1609459200000000 AND 1609545600000000     -- 1‑Jan‑2021
      LIMIT 10 )
LIMIT 20;
```

```sql
-- 3. Show transactions that have more than two outputs in 2021
SELECT 
    "hash",
    "output_count"
FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
WHERE "output_count" > 2
  AND "block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
-- 4. Detect transactions that contain at least two identical output values
--    (candidate CoinJoin heuristic)
WITH dup AS (
  SELECT 
      "transaction_hash"
  FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS
  WHERE "transaction_hash" IN (
        SELECT "hash"
        FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
        WHERE "block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000)
  GROUP BY "transaction_hash", "value"
  HAVING COUNT(*) > 1
)
SELECT *
FROM dup
LIMIT 20;
```

```sql
-- 5. Combine previous logic to flag probable CoinJoin transactions
WITH dup AS (
  SELECT 
      "transaction_hash"
  FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS
  GROUP BY "transaction_hash", "value"
  HAVING COUNT(*) > 1
),
cj AS (
  SELECT t."hash"
  FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t
  JOIN dup d ON t."hash" = d."transaction_hash"
  WHERE t."output_count" > 2
    AND t."output_value" <= t."input_value"
    AND t."block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
)
SELECT *
FROM cj
LIMIT 20;
```

```sql
-- 6. Monthly counts of CoinJoin vs. all transactions
WITH cj AS ( /* use query from #5 */ SELECT ... ),
all_tx AS (
  SELECT 
      DATE_FROM_PARTS(2021, MONTH(TO_TIMESTAMP_NTZ("block_timestamp"/1e6)), 1) AS "month_start",
      COUNT(*) AS "total_txs"
  FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
  WHERE "block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
  GROUP BY 1
),
cj_tx AS (
  SELECT 
      DATE_FROM_PARTS(2021, MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)), 1) AS "month_start",
      COUNT(*) AS "cj_txs"
  FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t
  JOIN cj ON t."hash" = cj."hash"
  GROUP BY 1
)
SELECT 
    a."month_start", a."total_txs", c."cj_txs"
FROM all_tx a
LEFT JOIN cj_tx c USING ("month_start")
ORDER BY a."month_start"
LIMIT 20;
```

```sql
-- 7. Monthly CoinJoin UTXO involvement
WITH cj_hash AS ( /* use query from #5 */ SELECT ... ),
inputs AS (
  SELECT 
      MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m",
      COUNT(*) AS "in_utxos"
  FROM CRYPTO.CRYPTO_BITCOIN.INPUTS i
  JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t
    ON t."hash" = i."transaction_hash"
  GROUP BY 1
),
cj_inputs AS (
  SELECT 
      MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m",
      COUNT(*) AS "cj_in_utxos"
  FROM CRYPTO.CRYPTO_BITCOIN.INPUTS i
  JOIN cj_hash cj ON cj."hash" = i."transaction_hash"
  JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t
    ON t."hash" = cj."hash"
  GROUP BY 1
)
SELECT *
FROM cj_inputs
JOIN inputs USING("m")
LIMIT 20;
```

```sql
-- 8. Monthly CoinJoin output UTXOs
WITH cj_hash AS ( /* use query from #5 */ SELECT ... ),
outs AS (
  SELECT 
      MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m",
      COUNT(*) AS "out_utxos"
  FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o
  JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t
    ON t."hash" = o."transaction_hash"
  GROUP BY 1
),
cj_outs AS (
  SELECT 
      MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m",
      COUNT(*) AS "cj_out_utxos"
  FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o
  JOIN cj_hash cj ON cj."hash" = o."transaction_hash"
  JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t
    ON t."hash" = cj."hash"
  GROUP BY 1
)
SELECT *
FROM cj_outs
JOIN outs USING("m")
LIMIT 20;
```

```sql
-- 9. Monthly CoinJoin volume (satoshis) vs. total volume
WITH cj_hash AS ( /* use query from #5 */ SELECT ... ),
vol_all AS (
  SELECT 
      MONTH(TO_TIMESTAMP_NTZ("block_timestamp"/1e6)) AS "m",
      SUM("output_value") AS "tot_vol"
  FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
  WHERE "block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
  GROUP BY 1
),
vol_cj AS (
  SELECT 
      MONTH(TO_TIMESTAMP_NTZ("block_timestamp"/1e6)) AS "m",
      SUM("output_value") AS "cj_vol"
  FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
  WHERE "hash" IN (SELECT "hash" FROM cj_hash)
  GROUP BY 1
)
SELECT *
FROM vol_cj
JOIN vol_all USING("m")
LIMIT 20;
```

```sql
-- 10. Pick the 2021 month with the highest CoinJoin‑volume share and compute all requested %s
WITH
cj_hash AS ( /* coin‑join transaction hashes */ SELECT ... ),
base AS (
  SELECT 
      MONTH(TO_TIMESTAMP_NTZ("block_timestamp"/1e6)) AS "m",
      COUNT(*)                        AS "total_tx",
      SUM("output_value")             AS "tot_vol"
  FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
  WHERE "block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
  GROUP BY 1
),
cj AS (
  SELECT 
      MONTH(TO_TIMESTAMP_NTZ("block_timestamp"/1e6)) AS "m",
      COUNT(*)                        AS "cj_tx",
      SUM("output_value")             AS "cj_vol"
  FROM CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS
  WHERE "hash" IN (SELECT "hash" FROM cj_hash)
  GROUP BY 1
),
in_all AS (
  SELECT MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m", COUNT(*) AS "in_utxos"
  FROM CRYPTO.CRYPTO_BITCOIN.INPUTS i JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t ON t."hash" = i."transaction_hash"
  WHERE t."block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
  GROUP BY 1),
in_cj AS (
  SELECT MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m", COUNT(*) AS "cj_in_utxos"
  FROM CRYPTO.CRYPTO_BITCOIN.INPUTS i JOIN cj_hash c ON c."hash" = i."transaction_hash"
  JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t ON t."hash" = c."hash"
  GROUP BY 1),
out_all AS (
  SELECT MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m", COUNT(*) AS "out_utxos"
  FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t ON t."hash" = o."transaction_hash"
  WHERE t."block_timestamp" BETWEEN 1609459200000000 AND 1640995199000000
  GROUP BY 1),
out_cj AS (
  SELECT MONTH(TO_TIMESTAMP_NTZ(t."block_timestamp"/1e6)) AS "m", COUNT(*) AS "cj_out_utxos"
  FROM CRYPTO.CRYPTO_BITCOIN.OUTPUTS o JOIN cj_hash c ON c."hash" = o."transaction_hash"
  JOIN CRYPTO.CRYPTO_BITCOIN.TRANSACTIONS t ON t."hash" = c."hash"
  GROUP BY 1),
joined AS (
  SELECT 
      b."m",
      b."total_tx",
      c."cj_tx",
      ROUND(c."cj_tx"*100.0 / b."total_tx", 1)               AS "pct_tx_cj",
      (ic."cj_in_utxos" + oc."cj_out_utxos")/2.0             AS "avg_cj_utxos",
      (ia."in_utxos"  + oa."out_utxos")/2.0                  AS "avg_all_utxos",
      ROUND(((ic."cj_in_utxos" + oc."cj_out_utxos")/2.0)*100.0 / ((ia."in_utxos" + oa."out_utxos")/2.0), 1) AS "pct_utxo_cj",
      va."tot_vol",
      vc."cj_vol",
      ROUND(vc."cj_vol"*100.0/va."tot_vol", 1)               AS "pct_vol_cj"
  FROM base b
  JOIN cj c   ON b."m" = c."m"
  JOIN in_all ia ON b."m" = ia."m"
  JOIN in_cj  ic ON b."m" = ic."m"
  JOIN out_all oa ON b."m" = oa."m"
  JOIN out_cj  oc ON b."m" = oc."m"
  JOIN (SELECT * FROM vol_all) va ON b."m" = va."m"
  JOIN (SELECT * FROM vol_cj)  vc ON b."m" = vc."m"
)
SELECT *
FROM joined
ORDER BY "pct_vol_cj" DESC
LIMIT 1;   -- month with highest CoinJoin volume share
```

These incremental queries let you examine the data, verify the CoinJoin heuristic, and ultimately derive:  
• Month number (1‑12) with the largest CoinJoin‑volume share in 2021  
• % of all transactions that are CoinJoins  
• % of UTXOs participating in CoinJoins (average of input & output shares)  
• % of total 2021 Bitcoin volume sent through CoinJoins  

All percentages are rounded to one decimal place in the last query.
