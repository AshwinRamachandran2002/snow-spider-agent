2025-05-01 01:11:05 - Thread-228 (execute) - INFO - [Exploration]
Relevant columns and how they will be used  
• stn: primary station identifier in the daily GSOD weather tables; join‐key to stations.usaf  
• wban: secondary identifier; join‐key to stations.wban (helps uniqueness)  
• prcp: precipitation for the day – used to decide if a day is “rainy” (prcp > 0 AND prcp != 99.99)  
• date / year / mo / da: calendar information; in this task we only need the “year” part to separate 2022 vs 2023 (year = '2022' or '2023') – the “date” column is handy when we need DISTINCT dates  
• state: two‑letter U.S. state code in stations – filter to Washington (state = 'WA')  
• country: must be 'US' to ensure the state code is meaningful (optional extra filter)

Principal conditions  
1. stations.state = 'WA' and stations.country = 'US'  
2. gsod20xx.prcp > 0            — the day had measurable precipitation  
3. gsod20xx.prcp != 99.99       — discard “missing” precipitation rows  
4. Rainy‑day count2023 > 150  
5. Rainy‑day count2023 < Rainy‑day count2022  

Below are ten exploratory ⇢ progressively complex BigQuery SQL snippets (every query returns ≤ 20 rows so they will all run quickly).  

```sql
-- 1) Peek at the stations table for Washington State
--    - shows the identifiers we will need for the join.
SELECT
  usaf AS stn,
  wban,
  name,
  country,
  state
FROM `bigquery-public-data.noaa_gsod.stations`
WHERE state = 'WA'
LIMIT 20;
```

```sql
-- 2) Sample 2023 daily records for one WA station to inspect precipitation values
SELECT
  g.stn,
  g.wban,
  g.date,
  g.prcp
FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE s.state = 'WA'
  AND g.prcp NOT IN (99.99)          -- keep only valid precipitation
LIMIT 20;
```

```sql
-- 3) Count rainy days per WA station in 2023 (no filter on the count yet)
SELECT
  g.stn,
  g.wban,
  COUNTIF(g.prcp > 0 AND g.prcp != 99.99) AS rainy_days_2023
FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE s.state = 'WA'
GROUP BY g.stn, g.wban
LIMIT 20;
```

```sql
-- 4) Count rainy days per WA station in 2022
SELECT
  g.stn,
  g.wban,
  COUNTIF(g.prcp > 0 AND g.prcp != 99.99) AS rainy_days_2022
FROM `bigquery-public-data.noaa_gsod.gsod2022` AS g
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON g.stn = s.usaf AND g.wban = s.wban
WHERE s.state = 'WA'
GROUP BY g.stn, g.wban
LIMIT 20;
```

```sql
-- 5) Look at both years side‑by‑side for one specific station
SELECT
  t23.stn,
  t23.wban,
  t23.rainy_days_2023,
  t22.rainy_days_2022
FROM (
  SELECT stn, wban,
         COUNTIF(prcp > 0 AND prcp != 99.99) AS rainy_days_2023
  FROM `bigquery-public-data.noaa_gsod.gsod2023`
  WHERE stn = '727930'               -- change to any WA station of interest
  GROUP BY stn, wban
) AS t23
LEFT JOIN (
  SELECT stn, wban,
         COUNTIF(prcp > 0 AND prcp != 99.99) AS rainy_days_2022
  FROM `bigquery-public-data.noaa_gsod.gsod2022`
  WHERE stn = '727930'
  GROUP BY stn, wban
) AS t22
USING (stn, wban)
LIMIT 20;
```

```sql
-- 6) All WA stations having >150 rainy days in 2023
SELECT
  stn,
  wban,
  rainy_days_2023
FROM (
  SELECT
    g.stn,
    g.wban,
    COUNTIF(g.prcp > 0 AND g.prcp != 99.99) AS rainy_days_2023
  FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE s.state = 'WA'
  GROUP BY g.stn, g.wban
)
WHERE rainy_days_2023 > 150
LIMIT 20;
```

```sql
-- 7) Merge the 2022 & 2023 rainy‑day counts for WA stations (no filtering yet)
WITH rainy23 AS (
  SELECT stn, wban,
         COUNTIF(prcp > 0 AND prcp != 99.99) AS rainy_2023
  FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE s.state = 'WA'
  GROUP BY stn, wban
),
rainy22 AS (
  SELECT stn, wban,
         COUNTIF(prcp > 0 AND prcp != 99.99) AS rainy_2022
  FROM `bigquery-public-data.noaa_gsod.gsod2022` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE s.state = 'WA'
  GROUP BY stn, wban
)
SELECT
  r23.stn,
  r23.wban,
  r23.rainy_2023,
  r22.rainy_2022
FROM rainy23 AS r23
LEFT JOIN rainy22 AS r22
  ON r23.stn = r22.stn AND r23.wban = r22.wban
LIMIT 20;
```

```sql
-- 8) Add the filter:  >150 rainy days in 2023 and 2023 < 2022
WITH rainy23 AS (
  SELECT stn, wban,
         COUNTIF(prcp > 0 AND prcp != 99.99) AS rainy_2023
  FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE s.state = 'WA'
  GROUP BY stn, wban
),
rainy22 AS (
  SELECT stn, wban,
         COUNTIF(prcp > 0 AND prcp != 99.99) AS rainy_2022
  FROM `bigquery-public-data.noaa_gsod.gsod2022` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE s.state = 'WA'
  GROUP BY stn, wban
)
SELECT
  r23.stn,
  r23.wban,
  r23.rainy_2023,
  r22.rainy_2022
FROM rainy23 AS r23
JOIN rainy22 AS r22
  ON r23.stn = r22.stn AND r23.wban = r22.wban
WHERE r23.rainy_2023 > 150
  AND r23.rainy_2023 < r22.rainy_2022
LIMIT 20;
```

```sql
-- 9) Bring back the station names to make results readable
WITH rainy23 AS (
  SELECT stn, wban,
         COUNTIF(prcp > 0 AND prcp != 99.99) AS rainy_2023
  FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE s.state = 'WA'
  GROUP BY stn, wban
),
rainy22 AS (
  SELECT stn, wban,
         COUNTIF(prcp > 0 AND prcp != 99.99) AS rainy_2022
  FROM `bigquery-public-data.noaa_gsod.gsod2022` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE s.state = 'WA'
  GROUP BY stn, wban
)
SELECT
  r23.stn,
  r23.wban,
  s.name         AS station_name,
  r23.rainy_2023,
  r22.rainy_2022
FROM rainy23 AS r23
JOIN rainy22 AS r22
  ON r23.stn = r22.stn AND r23.wban = r22.wban
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON r23.stn = s.usaf AND r23.wban = s.wban
WHERE r23.rainy_2023 > 150
  AND r23.rainy_2023 < r22.rainy_2022
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER QUERY
--     Washington stations with >150 rainy days in 2023 AND fewer rainy days than in 2022
WITH rainy_2023 AS (
  SELECT
    g.stn,
    g.wban,
    COUNTIF(g.prcp > 0 AND g.prcp != 99.99) AS rainy_days_2023
  FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE s.country = 'US'
    AND s.state   = 'WA'
  GROUP BY g.stn, g.wban
),
rainy_2022 AS (
  SELECT
    g.stn,
    g.wban,
    COUNTIF(g.prcp > 0 AND g.prcp != 99.99) AS rainy_days_2022
  FROM `bigquery-public-data.noaa_gsod.gsod2022` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE s.country = 'US'
    AND s.state   = 'WA'
  GROUP BY g.stn, g.wban
)
SELECT
  r23.stn,
  r23.wban,
  s.name  AS station_name,
  r23.rainy_days_2023,
  r22.rainy_days_2022
FROM rainy_2023 AS r23
JOIN rainy_2022 AS r22
  ON r23.stn = r22.stn AND r23.wban = r22.wban
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON r23.stn = s.usaf AND r23.wban = s.wban
WHERE r23.rainy_days_2023 > 150
  AND r23.rainy_days_2023 < r22.rainy_days_2022
ORDER BY r23.rainy_days_2023 DESC
LIMIT 20;
```
