--Description: To find Washington‑state weather stations that logged >150 rainy days in 2023
--             but fewer such days than in 2022, we:
--   1. Build two CTEs (rainy_2023, rainy_2022) that count “rainy days”
--      (prcp > 0 AND prcp != 99.99) per (stn,wban) for each year, keeping
--      only stations whose metadata has state='WA'.
--   2. Join the yearly summaries on the two station keys.
--   3. Filter for the required condition (>150 in 2023 AND 2023 < 2022).
--   4. Bring the human‑readable station name from the stations table.
--      Explicit aliases (g.stn AS stn, g.wban AS wban) eliminate ambiguity.
WITH rainy_2023 AS (
  SELECT
    g.stn  AS stn,
    g.wban AS wban,
    COUNTIF(g.prcp > 0 AND g.prcp != 99.99) AS rainy_days_2023
  FROM `bigquery-public-data.noaa_gsod.gsod2023` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE s.state = 'WA'          -- Washington only
  GROUP BY stn, wban
),
rainy_2022 AS (
  SELECT
    g.stn  AS stn,
    g.wban AS wban,
    COUNTIF(g.prcp > 0 AND g.prcp != 99.99) AS rainy_days_2022
  FROM `bigquery-public-data.noaa_gsod.gsod2022` AS g
  JOIN `bigquery-public-data.noaa_gsod.stations` AS s
    ON g.stn = s.usaf AND g.wban = s.wban
  WHERE s.state = 'WA'
  GROUP BY stn, wban
)
SELECT
  r23.stn,
  r23.wban,
  s.name AS station_name,
  r23.rainy_days_2023,
  r22.rainy_days_2022
FROM rainy_2023 AS r23
JOIN rainy_2022 AS r22
  ON r23.stn = r22.stn AND r23.wban = r22.wban
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON r23.stn = s.usaf AND r23.wban = s.wban
WHERE r23.rainy_days_2023 > 150
  AND r23.rainy_days_2023 < r22.rainy_days_2022
ORDER BY r23.rainy_days_2023 DESC
LIMIT 20;
