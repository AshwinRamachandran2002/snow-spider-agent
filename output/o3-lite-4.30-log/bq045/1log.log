--Description: 7) Add station name/coordinates to the combined rainy‑day counts for WA.
WITH y23 AS (
  SELECT stn, wban, COUNT(*) AS rainy_days_2023
  FROM   `bigquery-public-data.noaa_gsod.gsod2023`
  WHERE  prcp > 0 AND prcp <> 99.99
  GROUP  BY stn, wban
),
y22 AS (
