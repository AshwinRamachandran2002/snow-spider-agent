```sql
-- Description: 1) Peek at all stations that have state = 'WA' in the master list
SELECT usaf, wban, name, lat, lon
FROM   `bigquery-public-data.noaa_gsod.stations`
WHERE  state = 'WA'
LIMIT  20;
```

```sql
-- Description: 2) Show a few daily precipitation values for one WA station in 2023
SELECT stn, wban, date, prcp
FROM   `bigquery-public-data.noaa_gsod.gsod2023`
WHERE  stn  = '727936'            -- change to any WA usaf code you found above
  AND  prcp <> 99.99
ORDER  BY date
LIMIT  20;
```

```sql
-- Description: 3) Count “rainy days” in 2023 for every WA station
SELECT  g.stn, g.wban, COUNT(1) AS rainy_days_2023
FROM    `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN    `bigquery-public-data.noaa_gsod.stations` AS s
        ON g.stn  = s.usaf
       AND g.wban = s.wban
WHERE   s.state = 'WA'
  AND   g.prcp  > 0
  AND   g.prcp <> 99.99
GROUP BY g.stn, g.wban
LIMIT 20;
```

```sql
-- Description: 4) Count “rainy days” in 2022 for every WA station
