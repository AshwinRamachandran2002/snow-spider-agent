```sql
--Description: 8) List any station (all states) with more than 150 rainy days in 2023.
WITH cnt AS (
  SELECT stn, wban, COUNT(*) AS rainy_days_2023
  FROM   `bigquery-public-data.noaa_gsod.gsod2023`
  WHERE  prcp > 0 AND prcp <> 99.99
  GROUP  BY stn, wban
)
SELECT
  stn,
  wban,
  rainy_days_2023
FROM   cnt
WHERE  rainy_days_2023 > 150
ORDER BY rainy_days_2023 DESC
LIMIT 20;
```

```sql
--Description: 9) Interim Washington check: WA stations with >150 rainy days in 2023
--             and fewer than in 2022.
WITH y23 AS (
  SELECT stn, wban, COUNT(*) AS rainy_days_2023
  FROM   `bigquery-public-data.noaa_gsod.gsod2023`
  WHERE  prcp > 0 AND prcp <> 99.99
  GROUP  BY stn, wban
),
y22 AS (
  SELECT stn, wban, COUNT(*) AS rainy_days_2022
  FROM   `bigquery-public-data.noaa_gsod.gsod2022`
  WHERE  prcp > 0 AND prcp <> 99.99
  GROUP  BY stn, wban
)
SELECT
  TRIM(s.name)          AS station_name,
  y23.rainy_days_2023,
  y22.rainy_days_2022
FROM   y23
JOIN   y22 USING (stn, wban)
JOIN   `bigquery-public-data.noaa_gsod.stations` AS s
  ON y23.stn = s.usaf AND y23.wban = s.wban
WHERE  s.state = 'WA'
  AND  y23.rainy_days_2023 > 150
  AND  y23.rainy_days_2023 < y22.rainy_days_2022
LIMIT 20;
```

```sql
--Description: 10) Final answer – WA stations with >150 rainy days in 2023 and fewer than 2022.
SELECT
  s.usaf               AS stn,
  s.wban,
  TRIM(s.name)         AS station_name,
  y23.rainy_days_2023,
  y22.rainy_days_2022
FROM (
  SELECT stn, wban, COUNT(*) AS rainy_days_2023
  FROM   `bigquery-public-data.noaa_gsod.gsod2023`
  WHERE  prcp > 0 AND prcp <> 99.99
  GROUP  BY stn, wban
) AS y23
JOIN (
  SELECT stn, wban, COUNT(*) AS rainy_days_2022
  FROM   `bigquery-public-data.noaa_gsod.gsod2022`
  WHERE  prcp > 0 AND prcp <> 99.99
  GROUP  BY stn, wban
) AS y22 USING (stn, wban)
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON y23.stn = s.usaf AND y23.wban = s.wban
WHERE
  s.state = 'WA'
  AND y23.rainy_days_2023 > 150
  AND y23.rainy_days_2023 < y22.rainy_days_2022
ORDER BY
  y23.rainy_days_2023 DESC
LIMIT 20;
```
