The table structure information is ({database name: {schema name: [table name]}}): 
{'bigquery-public-data': {'noaa_gsod': ['gsod2023', 'gsod2022', 'stations'], 'noaa_historic_severe_storms': [], 'noaa_hurricanes': [], 'noaa_icoads': [], 'noaa_passive_acoustic_index': [], 'noaa_passive_bioacoustic': [], 'noaa_pifsc_metadata': [], 'noaa_preliminary_severe_storms': [], 'noaa_significant_earthquakes': [], 'noaa_tsunami': []}}
Begin Exploring Related Columns
Relevant columns and their possible use  
• `gsod2023.stn`, `gsod2022.stn` : station id – use to join with `stations.usaf`  
• `gsod2023.wban`, `gsod2022.wban` : WBAN id – second join key to make the match unique  
• `gsod2023.date`, `gsod2022.date` : day of observation – helps group by year if we ever need it (already split into `year`, `mo`, `da`)  
• `gsod2023.prcp`, `gsod2022.prcp` : daily precipitation in inches ( 99.99  = missing).  A “rainy day” = `prcp > 0 AND prcp <> 99.99`  
• `stations.state` : select only Washington stations (`'WA'`)  
• `stations.name` : human‑readable station name for the final list  

Typical conditions we will need  
```sql
WHERE prcp > 0            -- any measurable precipitation  
  AND prcp <> 99.99       -- skip the “missing” code  
```  
```sql
WHERE state = 'WA'        -- Washington State only
```  

Below are 10 illustrative BigQuery SQL statements (each limited to 20 rows) that progress from simple inspection to the complete answer.  
-------------------------------------------------------------------

```sql
-- Description: 1) Peek at all stations that have state = 'WA' in the master list
SELECT usaf, wban, name, lat, lon
FROM   `bigquery-public-data.noaa_gsod.stations`
WHERE  state = 'WA'
LIMIT  20;
```

```sql
-- Description: 2) Show a few daily precipitation values for one WA station in 2023
SELECT stn, wban, date, prcp
FROM   `bigquery-public-data.noaa_gsod.gsod2023`
WHERE  stn  = '727936'            -- change to any WA usaf code you found above
  AND  prcp <> 99.99
ORDER  BY date
LIMIT  20;
```

```sql
-- Description: 3) Count “rainy days” in 2023 for every WA station
SELECT  g.stn, g.wban, COUNT(1) AS rainy_days_2023
FROM    `bigquery-public-data.noaa_gsod.gsod2023` AS g
JOIN    `bigquery-public-data.noaa_gsod.stations` AS s
        ON g.stn  = s.usaf
       AND g.wban = s.wban
WHERE   s.state = 'WA'
  AND   g.prcp  > 0
  AND   g.prcp <> 99.99
GROUP BY g.stn, g.wban
LIMIT 20;
```

```sql
-- Description: 4) Count “rainy days” in 2022 for every WA station
SELECT  g.stn, g.wban, COUNT(1) AS rainy_days_2022
FROM    `bigquery-public-data.noaa_gsod.gsod2022` AS g
JOIN    `bigquery-public-data.noaa_gsod.stations` AS s
        ON g.stn  = s.usaf
       AND g.wban = s.wban
WHERE   s.state = 'WA'
  AND   g.prcp  > 0
  AND   g.prcp <> 99.99
GROUP BY g.stn, g.wban
LIMIT 20;
```

```sql
-- Description: 5) Combine 2023 and 2022 counts side‑by‑side for WA stations
WITH y23 AS (
  SELECT stn, wban, COUNT(*) AS rainy_days_2023
  FROM   `bigquery-public-data.noaa_gsod.gsod2023`
  WHERE  prcp > 0 AND prcp <> 99.99
  GROUP  BY stn, wban
),
y22 AS (
  SELECT stn, wban, COUNT(*) AS rainy_days_2022
  FROM   `bigquery-public-data.noaa_gsod.gsod2022`
  WHERE  prcp > 0 AND prcp <> 99.99
  GROUP  BY stn, wban
)
SELECT y23.stn, y23.wban, y23.rainy_days_2023, y22.rainy_days_2022
FROM   y23
JOIN   y22 USING (stn, wban)
LIMIT 20;
```

```sql
-- Description: 6) Same as (5) but restricted to WA stations only
WITH y23 AS (
  SELECT stn, wban, COUNT(*) AS rainy_days_2023
  FROM   `bigquery-public-data.noaa_gsod.gsod2023`
  WHERE  prcp > 0 AND prcp <> 99.99
  GROUP  BY stn, wban
),
y22 AS (
  SELECT stn, wban, COUNT(*) AS rainy_days_2022
  FROM   `bigquery-public-data.noaa_gsod.gsod2022`
  WHERE  prcp > 0 AND prcp <> 99.99
  GROUP  BY stn, wban
)
SELECT  y23.stn, y23.wban, y23.rainy_days_2023, y22.rainy_days_2022
FROM    y23
JOIN    y22 USING (stn, wban)
JOIN    `bigquery-public-data.noaa_gsod.stations` AS s
        ON y23.stn = s.usaf AND y23.wban = s.wban
WHERE   s.state = 'WA'
LIMIT   20;
```

```sql
-- Description: 7) Bring in station name and geographic info for WA stations
SELECT  s.name, s.lat, s.lon, c.*
FROM  (
  SELECT y23.stn, y23.wban, y23.rainy_days_2023, y22.rainy_days_2022
  FROM  (
     SELECT stn, wban, COUNT(*) AS rainy_days_2023
     FROM   `bigquery-public-data.noaa_gsod.gsod2023`
     WHERE  prcp > 0 AND prcp <> 99.99
     GROUP  BY stn, wban
  ) AS y23
  JOIN (
     SELECT stn, wban, COUNT(*) AS rainy_days_2022
     FROM   `bigquery-public-data.noaa_gsod.gsod2022`
     WHERE  prcp > 0 AND prcp <> 99.99
     GROUP  BY stn, wban
  ) AS y22
  USING (stn, wban)
) AS c
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
  ON c.stn = s.usaf AND c.wban = s.wban
WHERE s.state = 'WA'
LIMIT 20;
```

```sql
-- Description: 8) Filter to stations with >150 rainy days in 2023
WITH cnt AS (
  SELECT stn, wban, COUNT(*) AS rainy_days_2023
  FROM   `bigquery-public-data.noaa_gsod.gsod2023`
  WHERE  prcp > 0 AND prcp <> 99.99
  GROUP  BY stn, wban
)
SELECT *
FROM   cnt
WHERE  rainy_days_2023 > 150
LIMIT 20;
```

```sql
-- Description: 9) Interim check – which WA stations had >150 rainy days in 2023 AND fewer than in 2022
WITH y23 AS (
  SELECT stn, wban, COUNT(*) AS rainy_days_2023
  FROM   `bigquery-public-data.noaa_gsod.gsod2023`
  WHERE  prcp > 0 AND prcp <> 99.99
  GROUP  BY stn, wban
),
y22 AS (
  SELECT stn, wban, COUNT(*) AS rainy_days_2022
  FROM   `bigquery-public-data.noaa_gsod.gsod2022`
  WHERE  prcp > 0 AND prcp <> 99.99
  GROUP  BY stn, wban
)
SELECT s.name,
       y23.rainy_days_2023,
       y22.rainy_days_2022
FROM   y23
JOIN   y22 USING (stn, wban)
JOIN   `bigquery-public-data.noaa_gsod.stations` AS s
       ON y23.stn = s.usaf AND y23.wban = s.wban
WHERE  s.state = 'WA'
  AND  y23.rainy_days_2023 > 150
  AND  y23.rainy_days_2023 < y22.rainy_days_2022
LIMIT 20;
```

```sql
-- Description: 10) Final answer – list all WA stations that meet the criteria, ordered by rainy_days_2023
SELECT  s.usaf          AS stn,
        s.wban          AS wban,
        s.name          AS station_name,
        y23.rainy_days_2023,
        y22.rainy_days_2022
FROM  (
    SELECT stn, wban, COUNT(*) AS rainy_days_2023
    FROM   `bigquery-public-data.noaa_gsod.gsod2023`
    WHERE  prcp > 0 AND prcp <> 99.99
    GROUP  BY stn, wban
) AS y23
JOIN (
    SELECT stn, wban, COUNT(*) AS rainy_days_2022
    FROM   `bigquery-public-data.noaa_gsod.gsod2022`
    WHERE  prcp > 0 AND prcp <> 99.99
    GROUP  BY stn, wban
) AS y22 USING (stn, wban)
JOIN `bigquery-public-data.noaa_gsod.stations` AS s
     ON y23.stn = s.usaf AND y23.wban = s.wban
WHERE s.state = 'WA'
  AND y23.rainy_days_2023 > 150
  AND y23.rainy_days_2023 < y22.rainy_days_2022
ORDER BY y23.rainy_days_2023 DESC
LIMIT 20;
```

