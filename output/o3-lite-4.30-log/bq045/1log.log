```sql
--Description: Final solution, with inline reasoning.
-- Objective: Identify Washington (WA) weather stations that:
--   • logged more than 150 “rainy days” in 2023, and
--   • logged fewer rainy days in 2023 than in 2022.
-- Definition of a “rainy day”: daily precipitation (prcp) > 0
--   while prcp ≠ 99.99 (99.99 indicates missing / not‑reported data).
-- Approach:
--   1. Two CTEs tally rainy‑day counts per (stn, wban) for 2023 and 2022.
--   2. Join the CTEs to compare the counts.
--   3. Join with the stations reference table to filter to WA and fetch names.
--   4. Apply the >150 and “2023 < 2022” criteria.
--   5. Return station ID, name, and both counts, ordered by 2023 rainy‑day count.

WITH rain_2023 AS (
  SELECT
    stn,
    wban,
    COUNT(*) AS rainy_days_2023
  FROM
    `bigquery-public-data.noaa_gsod.gsod2023`
  WHERE
    prcp > 0            -- measurable precipitation
    AND prcp <> 99.99   -- exclude missing
  GROUP BY
    stn, wban
),
rain_2022 AS (
  SELECT
    stn,
    wban,
    COUNT(*) AS rainy_days_2022
  FROM
    `bigquery-public-data.noaa_gsod.gsod2022`
  WHERE
    prcp > 0
    AND prcp <> 99.99
  GROUP BY
    stn, wban
)

SELECT
  s.usaf               AS stn,
  s.wban,
  TRIM(s.name)         AS station_name,
  r23.rainy_days_2023,
  r22.rainy_days_2022
FROM
  rain_2023 r23
JOIN
  rain_2022 r22
USING (stn, wban)
JOIN
  `bigquery-public-data.noaa_gsod.stations` s
ON
  s.usaf = r23.stn
  AND s.wban = r23.wban
WHERE
  s.state = 'WA'                    -- Washington stations
  AND r23.rainy_days_2023 > 150     -- >150 rainy days in 2023
  AND r23.rainy_days_2023 < r22.rainy_days_2022 -- fewer than 2022
ORDER BY
  r23.rainy_days_2023 DESC;
```
