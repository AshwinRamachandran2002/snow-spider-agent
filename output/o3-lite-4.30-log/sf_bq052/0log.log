       p."id"                                                      AS patent_id,
       p."title",
       a.app_dt                                                    AS application_date,
       /* patents that cited this one 1‑30 days BEFORE its app date */
       COUNT( DISTINCT CASE
               WHEN ac.app_dt BETWEEN DATEADD(day,-30, a.app_dt)
                                  AND DATEADD(day,-1 , a.app_dt)
               THEN u."patent_id" END )                            AS backward_citations_1m,
       /* patents that cited this one 1‑30 days AFTER  its app date */
