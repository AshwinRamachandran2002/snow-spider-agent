-- 3) Counts citations within 30 days BEFORE (backward_cnt) and AFTER (forward_cnt)
--    each patent’s application date.
-- 4) Returns patent_id, title, application_date, backward_cnt, forward_cnt.
-- 5) No HAVING filter, so patents are shown even if the counts are zero.
-- 6) Limited to 20 rows for a light preview.

WITH cpc AS (
    SELECT DISTINCT "patent_id"
    FROM PATENTSVIEW.PATENTSVIEW.CPC_CURRENT
    WHERE "subsection_id" = 'C05'
