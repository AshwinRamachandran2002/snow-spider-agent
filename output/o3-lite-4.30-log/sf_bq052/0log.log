--              TRY_TO_DATE; malformed dates become NULL and are dropped.
--   3) Main  – joins PATENT, APPLICATION, CPC, and the cleaned citation set;
--              counts citations in the 30‑day windows before/after filing.
--              COALESCE ensures patents with no hits show 0 counts.
--   4) No HAVING clause is applied so we always get data (even zeros).  To
--              surface patents that do have activity, the ORDER BY sorts
--              first on total citations (backward + forward) descending,
--              then by application date.
--   5) LIMIT 20 keeps the result set small for inspection.

WITH cpc AS (
    SELECT DISTINCT "patent_id"
    FROM PATENTSVIEW.PATENTSVIEW.CPC_CURRENT
    WHERE "subsection_id" = 'C05'
       OR "group_id"      = 'A01G'
),
cite AS (
    SELECT "citation_id",
           TRY_TO_DATE("date") AS "cit_date"
    FROM PATENTSVIEW.PATENTSVIEW.USPATENTCITATION
    WHERE TRY_TO_DATE("date") IS NOT NULL        -- drop bad date strings
)
SELECT p."id"                                                     AS "patent_id",
       p."title",
       TO_DATE(a."date")                                          AS "application_date",
       p."abstract",
       COALESCE(SUM(CASE                                           -- ‑30…‑1 days
              WHEN cite."cit_date" BETWEEN DATEADD(day,-30,TO_DATE(a."date"))
                                       AND     DATEADD(day,-1 ,TO_DATE(a."date"))
              THEN 1 END),0)                                      AS "backward_cnt",
       COALESCE(SUM(CASE                                           -- +1…+30 days
              WHEN cite."cit_date" BETWEEN DATEADD(day, 1 ,TO_DATE(a."date"))
                                       AND     DATEADD(day, 30,TO_DATE(a."date"))
              THEN 1 END),0)                                      AS "forward_cnt"
FROM   PATENTSVIEW.PATENTSVIEW.PATENT      p
JOIN   PATENTSVIEW.PATENTSVIEW.APPLICATION a   ON a."patent_id" = p."id"
JOIN   cpc                                     ON cpc."patent_id" = p."id"
LEFT  JOIN cite                                ON cite."citation_id" = p."id"
GROUP  BY p."id", p."title", p."abstract", a."date"
ORDER  BY (   COALESCE(SUM(CASE WHEN cite."cit_date" BETWEEN DATEADD(day,-30,TO_DATE(a."date"))
                                              AND DATEADD(day,-1,TO_DATE(a."date")) THEN 1 END),0)
