```sql
--Description (thinking process):
-- 1) The task requires counting citations that occur within ±30 days of a patent’s
--    application date.  Dates in USPATENTCITATION can be malformed (e.g. “1987‑10‑00”)
--    so we convert them with TRY_TO_DATE(); rows that fail parsing become NULL and are
--    ignored automatically.
-- 2) Three CTEs are used:
--      • app  – each patent’s ID, title, abstract, and clean application date.
--      • cpc  – patents that belong to CPC subsection ‘C05’ OR CPC group ‘A01G’.
--      • cite – citation rows with valid parsed dates (“cit_date”).
-- 3) In the final SELECT we LEFT JOIN the citation table so every focal patent is kept,
--    then count DISTINCT citation events that fall in the backward (–30 … –1 days)
--    or forward (+1 … +30 days) windows.
-- 4) HAVING filters out patents that have zero such citations.
-- 5) Results are ordered by the application date and trimmed with LIMIT 20 for safety.

WITH app AS (
    SELECT p."id"                  AS "patent_id",
           p."title",
           p."abstract",
           TO_DATE(a."date")       AS "app_date"
    FROM   PATENTSVIEW.PATENTSVIEW.PATENT      p
    JOIN   PATENTSVIEW.PATENTSVIEW.APPLICATION a
           ON a."patent_id" = p."id"
),
cpc AS (
    SELECT DISTINCT "patent_id"
    FROM   PATENTSVIEW.PATENTSVIEW.CPC_CURRENT
    WHERE  "subsection_id" = 'C05'
       OR  "group_id"      = 'A01G'
),
cite AS (
    SELECT "citation_id",
           TRY_TO_DATE("date") AS "cit_date"
    FROM   PATENTSVIEW.PATENTSVIEW.USPATENTCITATION
    WHERE  TRY_TO_DATE("date") IS NOT NULL          -- drop malformed dates
)
SELECT  app."patent_id",
        app."title",
        app."app_date"                                                      AS "application_date",
        app."abstract",
        COUNT(DISTINCT CASE
                WHEN cite."cit_date" BETWEEN DATEADD(day,-30,app."app_date")
                                         AND     DATEADD(day,-1 ,app."app_date")
                THEN cite."cit_date" END)                                   AS "backward_cnt",
        COUNT(DISTINCT CASE
                WHEN cite."cit_date" BETWEEN DATEADD(day, 1 ,app."app_date")
                                         AND     DATEADD(day, 30,app."app_date")
                THEN cite."cit_date" END)                                   AS "forward_cnt"
FROM    app
JOIN    cpc   ON cpc."patent_id"  = app."patent_id"
LEFT JOIN cite ON cite."citation_id" = app."patent_id"
GROUP   BY app."patent_id", app."title", app."abstract", app."app_date"
HAVING  COALESCE(COUNT(DISTINCT CASE
                    WHEN cite."cit_date" BETWEEN DATEADD(day,-30,app."app_date")
                                             AND     DATEADD(day,-1 ,app."app_date")
                    THEN cite."cit_date" END),0)
      + COALESCE(COUNT(DISTINCT CASE
                    WHEN cite."cit_date" BETWEEN DATEADD(day, 1 ,app."app_date")
                                             AND     DATEADD(day, 30,app."app_date")
                    THEN cite."cit_date" END),0) > 0
ORDER BY app."app_date"
LIMIT 20;
```
