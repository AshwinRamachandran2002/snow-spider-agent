```sql
--Description:
-- We need the top‑three Google‑Trends search terms (ranks 1–3) for each weekday
-- between 2024‑09‑01 and 2024‑09‑14, grouped by “refresh_date”.
-- Steps performed in this single query:
--   1. FROM the table GOOGLE_TRENDS.GOOGLE_TRENDS.TOP_TERMS.
--   2. Filter “week” to the two weeks of interest with BETWEEN.
--   3. Exclude Saturday and Sunday via TO_CHAR("week",'DY') NOT IN ('SAT','SUN').
--   4. Keep only rows where “rank” is 1, 2, or 3.
--   5. GROUP BY both “refresh_date” and “week”.
--   6. Inside each group, ARRAY_AGG the “term” field ordered by “rank”
--      so the array position 1,2,3 corresponds to ranks 1,2,3.
--   7. ORDER the final output by “refresh_date” descending (latest first).
--   8. LIMIT 20 just to keep the preview manageable.
SELECT
    "refresh_date",
    "week",
    ARRAY_AGG("term") WITHIN GROUP (ORDER BY "rank") AS "top_three_terms"
FROM "GOOGLE_TRENDS"."GOOGLE_TRENDS"."TOP_TERMS"
WHERE "week" BETWEEN '2024-09-01' AND '2024-09-14'
  AND TO_CHAR("week", 'DY') NOT IN ('SAT', 'SUN')
  AND "rank" IN (1, 2, 3)
GROUP BY "refresh_date", "week"
ORDER BY "refresh_date" DESC
LIMIT 20;
```
