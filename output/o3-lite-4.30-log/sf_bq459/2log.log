```sql
WITH stopwords(word) AS (
    VALUES
    ('a'),('an'),('the'),('and'),('or'),('but'),('if'),('while'),('with'),('to'),('in'),
    ('on'),('for'),('of'),('at'),('by'),('from'),('up'),('down'),('out'),('over'),('under'),
    ('again'),('further'),('then'),('once'),('here'),('there'),('all'),('any'),('both'),('each'),
    ('few'),('more'),('most'),('other'),('some'),('such'),('no'),('nor'),('not'),('only'),
    ('own'),('same'),('so'),('than'),('too'),('very'),('s'),('t'),('can'),('will'),('just')
),

/* =====================  QUERY VECTOR  ===================== */
query_tokens AS (
    SELECT LOWER(t.value::string) AS token
    FROM TABLE(
            FLATTEN(
                INPUT => SPLIT(
                             LOWER(
                                 REGEXP_REPLACE(
                                     'Epigenetics and cerebral organoids: promising directions in autism spectrum disorders',
                                     '[^a-z ]',' ','g')
                             ),
                             ' '
                         )
            )
         ) t
    WHERE token <> ''
      AND token NOT IN (SELECT word FROM stopwords)
),
query_dims AS (
    SELECT  fv.index                                                  AS idx,
            SUM( fv.value / POWER(wf.frequency, 0.4) )               AS dim_sum
    FROM    query_tokens  qt
    JOIN    WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
                 ON wf.word = qt.token
    JOIN    WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS     gv
                 ON gv.word = qt.token,
            LATERAL FLATTEN( INPUT => gv.vector ) fv
    GROUP BY fv.index
),
query_norm AS (
    SELECT SQRT( SUM(dim_sum*dim_sum) ) AS qnorm
    FROM   query_dims
),
query_unit AS (
    SELECT idx,
           dim_sum / qnorm                                               AS value
    FROM   query_dims, query_norm
),

/* =====================  ARTICLE VECTORS  ===================== */
article_tokens AS (
    SELECT n.id,
           n.date,
           n.title,
           LOWER(t.value::string)                                        AS token
    FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
           TABLE(
               FLATTEN(
                   INPUT => SPLIT(
                                LOWER(
                                    REGEXP_REPLACE(n.body,'[^a-z ]',' ','g')
                                ),
                                ' '
                            )
               )
           ) t
    WHERE  token <> ''
       AND token NOT IN (SELECT word FROM stopwords)
),
article_token_vec AS (
    SELECT  at.id,
            at.date,
            at.title,
            gv.vector,
            wf.frequency
    FROM    article_tokens                                           at
    JOIN    WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS         gv
                ON gv.word = at.token
    JOIN    WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES      wf
                ON wf.word = at.token
),
article_dims AS (
    SELECT  id,
            date,
            title,
            fv.index                                                  AS idx,
            SUM( fv.value / POWER(frequency,0.4) )                    AS dim_sum
    FROM    article_token_vec,
            LATERAL FLATTEN( INPUT => vector ) fv
    GROUP BY id, date, title, fv.index
),
article_norm AS (
    SELECT  id,
            date,
            title,
            SQRT( SUM(dim_sum*dim_sum) )                              AS anorm
    FROM    article_dims
    GROUP BY id, date, title
),
article_unit AS (
    SELECT  ad.id,
            ad.date,
            ad.title,
            ad.idx,
            ad.dim_sum / an.anorm                                      AS value
    FROM    article_dims  ad
    JOIN    article_norm  an
          ON ad.id = an.id
),

/* =====================  COSINE SIMILARITY  ===================== */
similarity AS (
    SELECT  au.id,
            au.date,
            au.title,
            SUM( au.value * qu.value )                                AS cosine_similarity
    FROM    article_unit au
    JOIN    query_unit   qu
          ON au.idx = qu.idx
    GROUP BY au.id, au.date, au.title
)

SELECT  id,
        date,
        title,
        cosine_similarity
FROM    similarity
ORDER BY cosine_similarity DESC NULLS LAST,
         date               DESC NULLS LAST
LIMIT   10;
```
