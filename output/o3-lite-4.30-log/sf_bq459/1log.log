FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS", 
     LATERAL FLATTEN(input => "vector") f
WHERE "word" = 'epigenetics'
LIMIT 20;
```

```sql
--Description: 10) Compute a re‑weighted vector for one token (epigenetics) using frequency^-0.4
WITH freq AS (
    SELECT "frequency"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"
    WHERE "word" = 'epigenetics'
), vec AS (
    SELECT "vector"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"
    WHERE "word" = 'epigenetics'
)
SELECT (f.value::FLOAT / POW((SELECT "frequency" FROM freq), 0.4)) AS "weighted_dim"
FROM vec, LATERAL FLATTEN(input => vec."vector") f
LIMIT 20;
```

