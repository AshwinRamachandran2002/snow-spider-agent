/* -------------- helper JavaScript UDFs (executed inside Snowflake) -------------- */
CREATE OR REPLACE TEMPORARY FUNCTION DOT_PROD(a ARRAY, b ARRAY)
RETURNS FLOAT
LANGUAGE JAVASCRIPT
AS
$$
    var m = Math.min(a.length , b.length);
    var s = 0;
    for (var i = 0 ; i < m ; i++){
        s += (a[i] || 0) * (b[i] || 0);
    }
    return s;
$$;

CREATE OR REPLACE TEMPORARY FUNCTION SUM_ARRAYS(arr ARRAY)
RETURNS ARRAY
LANGUAGE JAVASCRIPT
AS
$$
    if (!arr || arr.length === 0) return [];
    var res = arr[0].slice();
    for (var i = 1 ; i < arr.length ; i++){
        var v = arr[i];
        for (var j = 0 ; j < v.length ; j++){
            res[j] = (res[j] || 0) + (v[j] || 0);
        }
    }
    return res;
$$;

CREATE OR REPLACE TEMPORARY FUNCTION LENGTH_ARRAY(a ARRAY)
RETURNS FLOAT
LANGUAGE JAVASCRIPT
AS
$$
    var s = 0;
    for (var i = 0 ; i < a.length ; i++){
        s += a[i] * a[i];
    }
    return Math.sqrt(s);
$$;

CREATE OR REPLACE TEMPORARY FUNCTION NORMALIZE_ARRAY(a ARRAY)
RETURNS ARRAY
LANGUAGE JAVASCRIPT
AS
$$
    var s = 0;
    for (var i = 0 ; i < a.length ; i++){  s += a[i]*a[i]; }
    var len = Math.sqrt(s);
    if (len === 0) return a;
    var r = [];
    for (var i = 0 ; i < a.length ; i++){ r[i] = a[i]/len; }
    return r;
$$;

/* ---------------------- main computation ---------------------- */
WITH stopwords(word) AS (SELECT * FROM VALUES
 ('the'),('and'),('for'),('with'),('that'),('this'),('have'),('has'),('are'),('was'),
 ('were'),('but'),('not'),('from'),('into'),('between'),('before'),('after'),('during'),
 ('above'),('below'),('over'),('under'),('again'),('against'),('when'),('where'),
 ('which'),('while'),('will'),('would'),('could'),('should'),('about'),('upon'),
 ('these'),('those'),('been'),('being'),('than'),('then')
),

/* -------- tokenise bodies (lower‑case letters only, drop stop‑words) -------- */
article_tokens AS (
    SELECT n."id",
           n."date",
           n."title",
           tok
    FROM (
        SELECT "id","date","title",
               TRIM(f.value::STRING) AS tok
        FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE",
             LATERAL FLATTEN(
                 INPUT => SPLIT(
                     REGEXP_REPLACE(LOWER("body"), '[^a-z ]',' '),
                     ' ')
             ) f
        WHERE "body" IS NOT NULL
    ) n
    WHERE tok<>'' AND LENGTH(tok)>2
      AND tok NOT IN (SELECT word FROM stopwords)
),

/* -------- attach GloVe vectors & frequencies; apply 1/freq^0.4 weight -------- */
token_vectors AS (
    SELECT  at."id",
            at."date",
            at."title",
            ARRAY_TRANSFORM(gv."vector", x -> x / POWER(wf."frequency",0.4)) AS scaled_vec
    FROM   article_tokens at
    JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"      gv ON gv."word" = at.tok
    JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"   wf ON wf."word" = at.tok
),

/* -------- sum weighted vectors for each article -------- */
article_vecs AS (
    SELECT "id","date","title",
           SUM_ARRAYS(ARRAY_AGG(scaled_vec)) AS vec
    FROM   token_vectors
    GROUP BY "id","date","title"
),

/* ------------------- build (unit‑length) query vector ------------------- */
query_tokens(token) AS (
    SELECT column1 FROM VALUES
        ('epigenetics'),('cerebral'),('organoids'),
        ('promising'),('directions'),('autism'),
        ('spectrum'),('disorders')
),

query_scaled AS (
    SELECT ARRAY_TRANSFORM(gv."vector", x -> x / POWER(wf."frequency",0.4)) AS scaled_vec
    FROM   query_tokens qt
    JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"      gv ON gv."word" = qt.token
    JOIN   "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"   wf ON wf."word" = qt.token
),

query_unit AS (
    SELECT NORMALIZE_ARRAY(SUM_ARRAYS(ARRAY_AGG(scaled_vec))) AS vec
    FROM   query_scaled
),

/* -------------------- cosine similarity -------------------- */
similarity AS (
    SELECT  a."id",
            a."date",
            a."title",
            DOT_PROD(a.vec, q.vec) / NULLIF(LENGTH_ARRAY(a.vec),0) AS cosine_similarity
    FROM    article_vecs a
    CROSS JOIN query_unit q
)

SELECT  "id",
        "date",
        "title",
        ROUND(cosine_similarity,4) AS cosine_similarity
FROM    similarity
ORDER BY cosine_similarity DESC NULLS LAST,
         "date"              DESC NULLS LAST
LIMIT 10;
```
