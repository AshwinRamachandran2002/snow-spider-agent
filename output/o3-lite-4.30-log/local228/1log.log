```sql
--Description: Derive the top three bowlers (by wickets) for every IPL season.
--Approach  
--  • Join the match table to ball_by_ball (aliased “bbb”) to attach season_id to every delivery.  
--  • Join wicket_taken on the complete ball key so we keep only deliveries where a dismissal occurred.  
--  • Exclude dismissals that should not be credited to the bowler: run‑out, hit‑wicket, retired‑hurt.  
--  • Aggregate COUNT(*) as total wickets for each bowler per season.  
--  • Use ROW_NUMBER() (partitioned by season) to rank bowlers by wickets DESC, then player_id ASC to break ties.  
--  • Keep rows with rank ≤ 3 and present the final list ordered by season and rank.
SELECT season_id,
       player_id,
       wickets
FROM (
    SELECT
        m.season_id,
        bbb.bowler                           AS player_id,
        COUNT(*)                             AS wickets,
        ROW_NUMBER() OVER (
            PARTITION BY m.season_id
            ORDER BY COUNT(*) DESC, bbb.bowler
        )                                   AS rn
    FROM match            AS m
    JOIN ball_by_ball     AS bbb ON bbb.match_id = m.match_id
    JOIN wicket_taken     AS wt  ON wt.match_id   = bbb.match_id
                                 AND wt.over_id   = bbb.over_id
                                 AND wt.ball_id   = bbb.ball_id
                                 AND wt.innings_no= bbb.innings_no
    WHERE wt.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
    GROUP BY m.season_id, bbb.bowler
)
WHERE rn <= 3
ORDER BY season_id, rn
LIMIT 20;
