Query:
--Description: Combine the top‑3 batsmen and top‑3 bowlers for every season,
--             pairing them by rank position (1 with 1, 2 with 2, 3 with 3).  
--Workflow
-- 1. top_batsmen CTE
--      • Join match → ball_by_ball (alias bbb) → batsman_scored.
--      • Sum runs per striker per season.
--      • Rank with ROW_NUMBER(), breaking ties by smaller player_id.
-- 2. top_bowlers CTE
--      • Join match → ball_by_ball (alias bbb) → wicket_taken.
--      • Filter out (‘run out’, ‘hit wicket’, ‘retired hurt’) so only bowler‑credited wickets count.
--      • Count wickets per bowler per season.
--      • Rank with ROW_NUMBER(), breaking ties by smaller player_id.
-- 3. Final SELECT
--      • Join the two CTEs on season_id AND identical rank (pos) to align
--        batsman‑1 with bowler‑1, batsman‑2 with bowler‑2, etc.
--      • Keep only top 3 positions.
--      • Order by season and position for the required presentation.
WITH top_batsmen AS (
    SELECT
        m.season_id,
        bbb.striker                     AS player_id,
        SUM(bs.runs_scored)             AS total_runs,
        ROW_NUMBER() OVER (
            PARTITION BY m.season_id
            ORDER BY SUM(bs.runs_scored) DESC, bbb.striker
        )                               AS pos
    FROM match            AS m
    JOIN ball_by_ball     AS bbb ON bbb.match_id = m.match_id
    JOIN batsman_scored   AS bs  ON bs.match_id   = bbb.match_id
                                 AND bs.over_id    = bbb.over_id
                                 AND bs.ball_id    = bbb.ball_id
                                 AND bs.innings_no = bbb.innings_no
    GROUP BY m.season_id, bbb.striker
),
top_bowlers AS (
    SELECT
        m.season_id,
        bbb.bowler                     AS player_id,
        COUNT(*)                       AS wickets,
        ROW_NUMBER() OVER (
            PARTITION BY m.season_id
            ORDER BY COUNT(*) DESC, bbb.bowler
        )                              AS pos
    FROM match            AS m
    JOIN ball_by_ball     AS bbb ON bbb.match_id = m.match_id
    JOIN wicket_taken     AS wt  ON wt.match_id   = bbb.match_id
                                 AND wt.over_id   = bbb.over_id
                                 AND wt.ball_id   = bbb.ball_id
                                 AND wt.innings_no= bbb.innings_no
    WHERE wt.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
    GROUP BY m.season_id, bbb.bowler
)
SELECT
    tb.season_id,
    tb.player_id  AS batsman_id,
    tb.total_runs,
    bw.player_id  AS bowler_id,
    bw.wickets
FROM top_batsmen tb
JOIN top_bowlers bw
  ON tb.season_id = bw.season_id
 AND tb.pos       = bw.pos
WHERE tb.pos <= 3
ORDER BY tb.season_id, tb.pos
