--Description:
-- 5.  Season‑1 wicket snapshot.  wicket_taken IDs the dismissal ball but not the bowler,
--     so we join to ball_by_ball (same ball coordinates) to grab bb.bowler.
--     After filtering unwanted dismissal kinds we count wickets per bowler,
--     sort, and show the top 20 for season 1.
SELECT
        bb.bowler AS bowler_id,
        COUNT(*)  AS total_wkts
FROM    wicket_taken AS wt
JOIN    ball_by_ball AS bb
       ON  bb.match_id   = wt.match_id
       AND bb.over_id    = wt.over_id
       AND bb.ball_id    = wt.ball_id
       AND bb.innings_no = wt.innings_no
JOIN    match AS m
       ON m.match_id = wt.match_id
WHERE   m.season_id = 1
  AND   wt.kind_out NOT IN ('run out', 'hit wicket', 'retired hurt')
GROUP BY bb.bowler
ORDER  BY total_wkts DESC,
          bb.bowler
LIMIT 20
