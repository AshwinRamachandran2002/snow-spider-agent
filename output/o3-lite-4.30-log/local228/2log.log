       pb.player_name AS top_batsman,
       tb.total_runs,
       pw.player_name AS top_bowler,
       tw.total_wkts
FROM   top_bats AS tb
JOIN   player    AS pb ON pb.player_id = tb.player_id
JOIN   top_bowl  AS tw ON tw.season_id = tb.season_id AND tw.rk = tb.rk
JOIN   player    AS pw ON pw.player_id = tw.player_id
ORDER  BY tb.season_id, tb.rk
LIMIT 20
