```sql
--Description:
-- batsman_scored tells us how many runs were scored on each ball, but it does not
-- store the identity of the batsman.  That information lives in ball_by_ball
-- (column striker).  Therefore we:
--   • join batsman_scored to ball_by_ball on the full ball coordinates
--     (match_id, over_id, ball_id, innings_no) to attach the striker to every run;
--   • join to match so we can restrict the data set to a single season (season_id = 1);
--   • aggregate (SUM) the runs per striker to obtain each player’s season total;
--   • sort by total_runs descending, then by player_id ascending to resolve ties;
--   • limit to 20 rows just for a concise preview.
SELECT
       bb.striker AS player_id,
       SUM(bs.runs_scored) AS total_runs
FROM   batsman_scored AS bs
JOIN   ball_by_ball  AS bb
       ON  bb.match_id   = bs.match_id
       AND bb.over_id    = bs.over_id
       AND bb.ball_id    = bs.ball_id
       AND bb.innings_no = bs.innings_no
JOIN   match AS m
       ON m.match_id = bs.match_id
WHERE  m.season_id = 1
GROUP  BY bb.striker
ORDER  BY total_runs DESC,
          bb.striker
LIMIT 20;
```
