--Description: Sample a wicket event linked with its bowler and dismissal type by
--joining wicket_taken to ball_by_ball on the full delivery key.  Shows 20 rows.
SELECT
    w."match_id",
    w."over_id",
    w."ball_id",
    bb."bowler",
    w."kind_out"
FROM "wicket_taken" AS w
JOIN "ball_by_ball" AS bb
  ON w."match_id"   = bb."match_id"
 AND w."over_id"    = bb."over_id"
 AND w."ball_id"    = bb."ball_id"
 AND w."innings_no" = bb."innings_no"
LIMIT 20;
```

```sql
--Description: Preview total runs per batsman in each season.  Aggregates runs
--from batsman_scored, joins to ball_by_ball for the striker (batsman) and to
--match for season information, then orders by season and runs.
SELECT
    m."season_id",
    bb."striker"          AS "batsman_id",
    SUM(bs."runs_scored") AS "total_runs"
FROM "batsman_scored" AS bs
JOIN "ball_by_ball"   AS bb
  ON bs."match_id"   = bb."match_id"
 AND bs."over_id"    = bb."over_id"
 AND bs."ball_id"    = bb."ball_id"
 AND bs."innings_no" = bb."innings_no"
JOIN "match"         AS m
  ON m."match_id"    = bs."match_id"
GROUP BY m."season_id", bb."striker"
ORDER BY m."season_id", "total_runs" DESC
LIMIT 20;
```

```sql
--Description: Preview total wickets per bowler in each season while excluding
--run‑out, hit‑wicket, and retired‑hurt dismissals.  Counts qualifying wickets
--per bowler and season.
SELECT
    m."season_id",
    bb."bowler"   AS "bowler_id",
    COUNT(*)      AS "total_wkts"
FROM "wicket_taken" AS w
JOIN "ball_by_ball" AS bb
  ON w."match_id"   = bb."match_id"
 AND w."over_id"    = bb."over_id"
 AND w."ball_id"    = bb."ball_id"
 AND w."innings_no" = bb."innings_no"
JOIN "match"        AS m
  ON m."match_id"   = w."match_id"
WHERE w."kind_out" NOT IN ('run out', 'hit wicket', 'retired hurt')
GROUP BY m."season_id", bb."bowler"
ORDER BY m."season_id", "total_wkts" DESC
LIMIT 20;
```

```sql
--Description: Prototype for season 1 — aligns the top‑3 run scorers with the
--top‑3 wicket takers in matching rank positions (1‑to‑1, 2‑to‑2, 3‑to‑3).
WITH top_bats AS (
    SELECT
        m."season_id",
        bb."striker"                AS "player_id",
        SUM(bs."runs_scored")       AS "runs",
        ROW_NUMBER() OVER (
            PARTITION BY m."season_id"
            ORDER BY SUM(bs."runs_scored") DESC, bb."striker"
        )                           AS rn
    FROM "batsman_scored" AS bs
    JOIN "ball_by_ball"   AS bb
      ON bs."match_id"   = bb."match_id"
     AND bs."over_id"    = bb."over_id"
     AND bs."ball_id"    = bb."ball_id"
     AND bs."innings_no" = bb."innings_no"
    JOIN "match"         AS m
      ON m."match_id"    = bs."match_id"
    GROUP BY m."season_id", bb."striker"
),
top_bowl AS (
    SELECT
        m."season_id",
        bb."bowler"                 AS "player_id",
        COUNT(*)                    AS "wkts",
        ROW_NUMBER() OVER (
            PARTITION BY m."season_id"
            ORDER BY COUNT(*) DESC, bb."bowler"
        )                           AS rn
    FROM "wicket_taken" AS w
    JOIN "ball_by_ball" AS bb
      ON w."match_id"   = bb."match_id"
     AND w."over_id"    = bb."over_id"
     AND w."ball_id"    = bb."ball_id"
     AND w."innings_no" = bb."innings_no"
    JOIN "match"        AS m
      ON m."match_id"   = w."match_id"
    WHERE w."kind_out" NOT IN ('run out', 'hit wicket', 'retired hurt')
    GROUP BY m."season_id", bb."bowler"
)
SELECT
    b."season_id",
    b."player_id" AS "batsman_id",
    b."runs",
    w."player_id" AS "bowler_id",
    w."wkts"
FROM top_bats AS b
JOIN top_bowl AS w
  ON b."season_id" = w."season_id"
 AND b.rn          = w.rn
WHERE b."season_id" = 1
ORDER BY b.rn
LIMIT 20;
```
