2025-05-01 02:18:10 - Thread-768 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  

• `patient.id`: primary key for the patient record –‑ join field to the other two tables.  
• `patient.name` (ARRAY<STRUCT>): contains `family`; filter last‑names that start with “A”.  
• `patient.deceased.boolean` (and the whole `deceased` STRUCT): identify living patients (value is FALSE or NULL).  

• `condition.subject.patientId`: links a condition to its patient.  
• `condition.code.coding` (ARRAY<STRUCT>): fields `code` & `display` give the condition SNOMED code / wording – used to count a patient’s distinct conditions and to report the final answer.  

• `medication_request.subject.patientId`: links a medication‑request to its patient.  
• `medication_request.status`: filter only ‘active’ prescriptions.  
• `medication_request.medication.codeableConcept.coding` (ARRAY<STRUCT>): each element’s `code` (and optionally `display`) is treated as one medication; used to count distinct active medications prescribed to a patient.  


Ten exploratory → final BigQuery SQL queries
(Every query is limited to 20 rows except the final answer; feel free to run them in sequence.)

```sql
-- 1. List some patients whose last name starts with “A”
SELECT p.id , n.family
FROM `bigquery-public-data.fhir_synthea.patient` AS p
CROSS JOIN UNNEST(p.name) AS n
WHERE n.family LIKE 'A%'
LIMIT 20;
```

```sql
-- 2. Living patients whose last name starts with “A”
SELECT p.id , n.family
FROM `bigquery-public-data.fhir_synthea.patient` AS p
CROSS JOIN UNNEST(p.name) AS n
WHERE n.family LIKE 'A%'
  AND (p.deceased.boolean IS FALSE OR p.deceased.boolean IS NULL)
LIMIT 20;
```

```sql
-- 3. See one coding for each condition record
SELECT c.id ,
       c.subject.patientId AS patient_id ,
       cc.code , cc.display
FROM `bigquery-public-data.fhir_synthea.condition` AS c
CROSS JOIN UNNEST(c.code.coding) AS cc
LIMIT 20;
```

```sql
-- 4. Patients that have exactly ONE distinct condition
SELECT patient_id , COUNT(DISTINCT condition_code) AS cnt_conditions
FROM (
  SELECT c.subject.patientId         AS patient_id ,
         cc.code                     AS condition_code
  FROM   `bigquery-public-data.fhir_synthea.condition` c
  CROSS  JOIN UNNEST(c.code.coding)  AS cc )
GROUP BY patient_id
HAVING cnt_conditions = 1
LIMIT 20;
```

```sql
-- 5. Living “A*” patients that also meet the “one‑condition” rule
SELECT lp.patient_id , n.family
FROM (
  SELECT patient_id
  FROM (
    SELECT c.subject.patientId AS patient_id , cc.code AS cond_code
    FROM   `bigquery-public-data.fhir_synthea.condition` c
    CROSS  JOIN UNNEST(c.code.coding) AS cc )
  GROUP BY patient_id
  HAVING COUNT(DISTINCT cond_code) = 1 ) AS lp
JOIN `bigquery-public-data.fhir_synthea.patient` AS p
  ON p.id = lp.patient_id
CROSS JOIN UNNEST(p.name) AS n
WHERE n.family LIKE 'A%'
  AND (p.deceased.boolean IS FALSE OR p.deceased.boolean IS NULL)
LIMIT 20;
```

```sql
-- 6. How many different *active* medications has each patient been prescribed?
SELECT mr.subject.patientId              AS patient_id ,
       COUNT(DISTINCT mc.code)           AS num_active_meds
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
WHERE mr.status = 'active'
GROUP BY patient_id
ORDER BY num_active_meds DESC
LIMIT 20;
```

```sql
-- 7. Combine selections: “A*” living, one‑condition, plus active‑med counts
SELECT sel.patient_id ,
       sel.family ,
       med.num_active_meds
FROM (
  /* Re‑use previous filter for patients */
  SELECT p.id AS patient_id , n.family
  FROM `bigquery-public-data.fhir_synthea.patient` p
  CROSS JOIN UNNEST(p.name) AS n
  WHERE n.family LIKE 'A%'
    AND (p.deceased.boolean IS FALSE OR p.deceased.boolean IS NULL)
    AND p.id IN (
      SELECT patient_id
      FROM (
        SELECT c.subject.patientId AS patient_id , cc.code AS c_code
        FROM   `bigquery-public-data.fhir_synthea.condition` c
        CROSS  JOIN UNNEST(c.code.coding) AS cc )
      GROUP BY patient_id
      HAVING COUNT(DISTINCT c_code) = 1) ) AS sel
LEFT JOIN (
  SELECT mr.subject.patientId AS patient_id ,
         COUNT(DISTINCT mc.code) AS num_active_meds
  FROM `bigquery-public-data.fhir_synthea.medication_request` mr
  CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
  WHERE mr.status = 'active'
  GROUP BY patient_id ) AS med
ON sel.patient_id = med.patient_id
ORDER BY med.num_active_meds DESC
LIMIT 20;
```

```sql
-- 8. Add each patient’s unique condition information
SELECT sel.patient_id ,
       cond.condition_code ,
       cond.condition_display ,
       med.num_active_meds
FROM (
  /* Same patient filter as above */
  SELECT p.id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient` p
  CROSS JOIN UNNEST(p.name) AS n
  WHERE n.family LIKE 'A%'
    AND (p.deceased.boolean IS FALSE OR p.deceased.boolean IS NULL)
    AND p.id IN (
      SELECT patient_id
      FROM (
        SELECT c.subject.patientId AS patient_id , cc.code AS c_code
        FROM   `bigquery-public-data.fhir_synthea.condition` c
        CROSS  JOIN UNNEST(c.code.coding) AS cc )
      GROUP BY patient_id
      HAVING COUNT(DISTINCT c_code) = 1) ) AS sel
JOIN (
  SELECT c.subject.patientId AS patient_id ,
         cc.code   AS condition_code ,
         cc.display AS condition_display
  FROM `bigquery-public-data.fhir_synthea.condition` c
  CROSS JOIN UNNEST(c.code.coding) AS cc ) AS cond
  ON sel.patient_id = cond.patient_id
LEFT JOIN (
  SELECT mr.subject.patientId AS patient_id ,
         COUNT(DISTINCT mc.code) AS num_active_meds
  FROM `bigquery-public-data.fhir_synthea.medication_request` mr
  CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
  WHERE mr.status = 'active'
  GROUP BY patient_id ) AS med
  ON sel.patient_id = med.patient_id
ORDER BY med.num_active_meds DESC
LIMIT 20;
```

```sql
-- 9. For every condition, take the *maximum* #active‑meds seen on any single patient
SELECT condition_code ,
       condition_display ,
       MAX(num_active_meds) AS max_active_meds_for_single_patient
FROM (
  /* reuse query 8 but drop the LIMIT */
  SELECT sel.patient_id ,
         cond.condition_code ,
         cond.condition_display ,
         med.num_active_meds
  FROM (
    SELECT p.id AS patient_id
    FROM `bigquery-public-data.fhir_synthea.patient` p
    CROSS JOIN UNNEST(p.name) AS n
    WHERE n.family LIKE 'A%'
      AND (p.deceased.boolean IS FALSE OR p.deceased.boolean IS NULL)
      AND p.id IN (
        SELECT patient_id
        FROM (
          SELECT c.subject.patientId AS patient_id , cc.code AS c_code
          FROM   `bigquery-public-data.fhir_synthea.condition` c
          CROSS  JOIN UNNEST(c.code.coding) AS cc )
        GROUP BY patient_id
        HAVING COUNT(DISTINCT c_code) = 1) ) AS sel
  JOIN (
    SELECT c.subject.patientId AS patient_id ,
           cc.code AS condition_code ,
           cc.display AS condition_display
    FROM `bigquery-public-data.fhir_synthea.condition` c
    CROSS JOIN UNNEST(c.code.coding) AS cc ) AS cond
    ON sel.patient_id = cond.patient_id
  LEFT JOIN (
    SELECT mr.subject.patientId AS patient_id ,
           COUNT(DISTINCT mc.code) AS num_active_meds
    FROM `bigquery-public-data.fhir_synthea.medication_request` mr
    CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
    WHERE mr.status = 'active'
    GROUP BY patient_id ) AS med
    ON sel.patient_id = med.patient_id )
GROUP BY condition_code , condition_display
ORDER BY max_active_meds_for_single_patient DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: eight conditions with the highest
--      “max #different active medications prescribed
--      to any single living A* patient who has only one condition”
SELECT condition_code ,
       condition_display ,
       max_active_meds_for_single_patient
FROM (
  SELECT condition_code ,
         condition_display ,
         MAX(num_active_meds) AS max_active_meds_for_single_patient
  FROM (
    /* identical inner logic as query 9 */
    SELECT sel.patient_id ,
           cond.condition_code ,
           cond.condition_display ,
           med.num_active_meds
    FROM (
      SELECT p.id AS patient_id
      FROM `bigquery-public-data.fhir_synthea.patient` p
      CROSS JOIN UNNEST(p.name) AS n
      WHERE n.family LIKE 'A%'
        AND (p.deceased.boolean IS FALSE OR p.deceased.boolean IS NULL)
        AND p.id IN (
          SELECT patient_id
          FROM (
            SELECT c.subject.patientId AS patient_id , cc.code AS c_code
            FROM   `bigquery-public-data.fhir_synthea.condition` c
            CROSS  JOIN UNNEST(c.code.coding) AS cc )
          GROUP BY patient_id
          HAVING COUNT(DISTINCT c_code) = 1) ) AS sel
    JOIN (
      SELECT c.subject.patientId AS patient_id ,
             cc.code AS condition_code ,
             cc.display AS condition_display
      FROM `bigquery-public-data.fhir_synthea.condition` c
      CROSS JOIN UNNEST(c.code.coding) AS cc ) AS cond
      ON sel.patient_id = cond.patient_id
    LEFT JOIN (
      SELECT mr.subject.patientId AS patient_id ,
             COUNT(DISTINCT mc.code) AS num_active_meds
      FROM `bigquery-public-data.fhir_synthea.medication_request` mr
      CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
      WHERE mr.status = 'active'
      GROUP BY patient_id ) AS med
      ON sel.patient_id = med.patient_id )
  GROUP BY condition_code , condition_display )
ORDER BY max_active_meds_for_single_patient DESC
LIMIT 8;
```

