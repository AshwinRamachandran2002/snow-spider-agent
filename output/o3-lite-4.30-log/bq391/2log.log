  LEFT JOIN patient_active_meds AS pm
    ON pc.patient_id = pm.patient_id
  GROUP BY pc.code, pc.display
)
SELECT condition,
       code
FROM condition_max_meds
ORDER BY max_meds DESC, code
LIMIT 8;
