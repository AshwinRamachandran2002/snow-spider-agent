```sql
-- 7. Active medications for each qualifying patient; count DISTINCT medications
SELECT  mr.subject.patientId                                AS patient_id,
        COUNT(DISTINCT mr.medication.codeableConcept
                         .coding[OFFSET(0)].code)            AS active_meds
FROM    `bigquery-public-data.fhir_synthea.medication_request` AS mr
JOIN    (
        -- patients that are alive, last name “A*”, with exactly 1 condition
        SELECT  patient_id
        FROM    (
                SELECT  c.subject.patientId AS patient_id,
                        COUNT(DISTINCT c.code.coding[OFFSET(0)].code) AS distinct_conditions
                FROM    `bigquery-public-data.fhir_synthea.condition` AS c
                JOIN    (
                        SELECT DISTINCT p.id
                        FROM   `bigquery-public-data.fhir_synthea.patient` AS p,
                               UNNEST(p.name) AS n
                        WHERE  n.family LIKE 'A%'
                          AND  (p.deceased.boolean IS NULL AND p.deceased.dateTime IS NULL)
                        ) AS alive_A
                ON      alive_A.id = c.subject.patientId
                GROUP  BY patient_id
                HAVING DISTINCT_CONDITIONS = 1
               )
        ) AS qual
ON      qual.patient_id = mr.subject.patientId
WHERE   mr.status = 'active'
GROUP   BY patient_id
LIMIT 20;
```

```sql
-- 8. Combine condition + medication counts per patient
