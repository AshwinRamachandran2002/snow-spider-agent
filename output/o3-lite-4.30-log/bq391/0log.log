2025-05-01 02:17:36 - Thread-766 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
• patient.id: joins to both condition.subject.patientId and medication_request.subject.patientId  
• patient.name.family (inside the name array): patient’s last‑name; filter for those that begin with “A”  
• patient.deceased.boolean / patient.deceased.dateTime: identify living patients (deceased = FALSE / NULL)  
• condition.subject.patientId: joins each condition record to its patient  
• condition.code.coding.code & condition.code.text: the condition’s code / description that we must rank  
• medication_request.subject.patientId: joins each prescription to its patient  
• medication_request.status: keep only prescriptions whose status = 'active'  
• medication_request.medication.codeableConcept.coding.code: code of the prescribed medication; count DISTINCT values per patient  
• condition.id (or the whole row): allows us to COUNT DISTINCT conditions per patient  

Below are ten exploratory SQL queries—each limited to 20 rows—to move step‑by‑step from simple inspection to the full answer.  
(Replace YOUR‑PROJECT if you copy‑paste.)

```sql
-- 1. Inspect raw patient names
SELECT id,
       name
FROM   `bigquery-public-data.fhir_synthea.patient`
LIMIT  20;
```

```sql
-- 2. Grab last names that start with “A”
SELECT p.id,
       n.family AS last_name
FROM   `bigquery-public-data.fhir_synthea.patient` AS p,
       UNNEST(p.name) AS n
WHERE  n.family LIKE 'A%'
LIMIT  20;
```

```sql
-- 3. Living patients whose last names begin with “A”
SELECT DISTINCT p.id,
       n.family AS last_name
FROM   `bigquery-public-data.fhir_synthea.patient` AS p,
       UNNEST(p.name) AS n
WHERE  n.family LIKE 'A%'
  AND  (p.deceased.boolean IS NULL AND p.deceased.dateTime IS NULL)
LIMIT  20;
```

```sql
-- 4. Conditions carried by those “A*” living patients
SELECT  c.id AS condition_id,
        c.subject.patientId AS patient_id,
        c.code.coding[OFFSET(0)].code   AS cond_code,
        c.code.text                     AS cond_text
FROM    `bigquery-public-data.fhir_synthea.condition` AS c
JOIN    (
        SELECT DISTINCT p.id
        FROM   `bigquery-public-data.fhir_synthea.patient` AS p,
               UNNEST(p.name) AS n
        WHERE  n.family LIKE 'A%'
          AND  (p.deceased.boolean IS NULL AND p.deceased.dateTime IS NULL)
        ) AS alive_A
ON      alive_A.id = c.subject.patientId
LIMIT 20;
```

```sql
-- 5. Count how many DISTINCT condition codes each chosen patient has
SELECT  c.subject.patientId AS patient_id,
        COUNT(DISTINCT c.code.coding[OFFSET(0)].code) AS distinct_conditions
FROM    `bigquery-public-data.fhir_synthea.condition` AS c
JOIN    (
        SELECT DISTINCT p.id
        FROM   `bigquery-public-data.fhir_synthea.patient` AS p,
               UNNEST(p.name) AS n
        WHERE  n.family LIKE 'A%'
          AND  (p.deceased.boolean IS NULL AND p.deceased.dateTime IS NULL)
        ) AS alive_A
ON      alive_A.id = c.subject.patientId
GROUP BY patient_id
LIMIT 20;
```

```sql
-- 6. Only patients that have EXACTLY ONE distinct condition
SELECT  patient_id
FROM    (
        SELECT  c.subject.patientId AS patient_id,
                COUNT(DISTINCT c.code.coding[OFFSET(0)].code) AS distinct_conditions
        FROM    `bigquery-public-data.fhir_synthea.condition` AS c
        JOIN    (
                SELECT DISTINCT p.id
                FROM   `bigquery-public-data.fhir_synthea.patient` AS p,
                       UNNEST(p.name) AS n
                WHERE  n.family LIKE 'A%'
                  AND  (p.deceased.boolean IS NULL AND p.deceased.dateTime IS NULL)
                ) AS alive_A
        ON      alive_A.id = c.subject.patientId
        GROUP  BY patient_id
        HAVING DISTINCT_CONDITIONS = 1
        )
LIMIT 20;
```

```sql
-- 7. Active medications for each qualifying patient; count DISTINCT medications
SELECT  mr.subject.patientId                                AS patient_id,
        COUNT(DISTINCT mr.medication.codeableConcept
                         .coding[OFFSET(0)].code)            AS active_meds
FROM    `bigquery-public-data.fhir_synthea.medication_request` AS mr
JOIN    (
        -- patients that are alive, last name “A*”, with exactly 1 condition
        SELECT  patient_id
        FROM    (
                SELECT  c.subject.patientId AS patient_id,
                        COUNT(DISTINCT c.code.coding[OFFSET(0)].code) AS distinct_conditions
                FROM    `bigquery-public-data.fhir_synthea.condition` AS c
                JOIN    (
                        SELECT DISTINCT p.id
                        FROM   `bigquery-public-data.fhir_synthea.patient` AS p,
                               UNNEST(p.name) AS n
                        WHERE  n.family LIKE 'A%'
                          AND  (p.deceased.boolean IS NULL AND p.deceased.dateTime IS NULL)
                        ) AS alive_A
                ON      alive_A.id = c.subject.patientId
                GROUP  BY patient_id
                HAVING DISTINCT_CONDITIONS = 1
               )
        ) AS qual
ON      qual.patient_id = mr.subject.patientId
WHERE   mr.status = 'active'
GROUP   BY patient_id
LIMIT 20;
```

```sql
-- 8. Combine condition + medication counts per patient
SELECT  c.code.coding[OFFSET(0)].code  AS condition_code,
        c.code.text                    AS condition_text,
        c.subject.patientId            AS patient_id,
        COUNT(DISTINCT mr.medication.codeableConcept.coding[OFFSET(0)].code)
                                        AS num_active_meds
FROM    `bigquery-public-data.fhir_synthea.condition`         AS c
JOIN    `bigquery-public-data.fhir_synthea.medication_request` AS mr
  ON    mr.subject.patientId = c.subject.patientId
JOIN   (
        -- qualifying patients
        SELECT  patient_id
        FROM    (
                SELECT  c.subject.patientId AS patient_id,
                        COUNT(DISTINCT c.code.coding[OFFSET(0)].code) AS distinct_conditions
                FROM    `bigquery-public-data.fhir_synthea.condition` AS c
                JOIN    (
                        SELECT DISTINCT p.id
                        FROM   `bigquery-public-data.fhir_synthea.patient` AS p,
                               UNNEST(p.name) AS n
                        WHERE  n.family LIKE 'A%'
                          AND  (p.deceased.boolean IS NULL AND p.deceased.dateTime IS NULL)
                        ) AS alive_A
                ON      alive_A.id = c.subject.patientId
                GROUP BY patient_id
                HAVING DISTINCT_CONDITIONS = 1
              )
      ) AS qual
  ON   qual.patient_id = c.subject.patientId
WHERE   mr.status = 'active'
GROUP  BY condition_code, condition_text, patient_id
LIMIT 20;
```

```sql
-- 9. For each condition, find the MAX number of active meds seen in any single patient
SELECT  condition_code,
        condition_text,
        MAX(num_active_meds) AS max_active_meds_per_patient
FROM   (
        -- reuse query #8 without LIMIT
        SELECT  c.code.coding[OFFSET(0)].code  AS condition_code,
                c.code.text                    AS condition_text,
                c.subject.patientId            AS patient_id,
                COUNT(DISTINCT mr.medication.codeableConcept.coding[OFFSET(0)].code)
                                                AS num_active_meds
        FROM    `bigquery-public-data.fhir_synthea.condition`         AS c
        JOIN    `bigquery-public-data.fhir_synthea.medication_request` AS mr
          ON    mr.subject.patientId = c.subject.patientId
        JOIN   (
                SELECT  patient_id
                FROM    (
                        SELECT  c.subject.patientId AS patient_id,
                                COUNT(DISTINCT c.code.coding[OFFSET(0)].code) AS distinct_conditions
                        FROM    `bigquery-public-data.fhir_synthea.condition` AS c
                        JOIN    (
                                SELECT DISTINCT p.id
                                FROM   `bigquery-public-data.fhir_synthea.patient` AS p,
                                       UNNEST(p.name) AS n
                                WHERE  n.family LIKE 'A%'
                                  AND  (p.deceased.boolean IS NULL AND p.deceased.dateTime IS NULL)
                              ) AS alive_A
                        ON      alive_A.id = c.subject.patientId
                        GROUP BY patient_id
                        HAVING DISTINCT_CONDITIONS = 1
                      )
              ) AS qual
          ON   qual.patient_id = c.subject.patientId
        WHERE   mr.status = 'active'
        GROUP  BY condition_code, condition_text, patient_id
       )
GROUP  BY condition_code, condition_text
LIMIT 20;
```

```sql
-- 10. Final answer: the top 8 conditions (code & description) ranked by that max count
SELECT  condition_code,
        condition_text,
        max_active_meds_per_patient
FROM   (
        -- query #9 without LIMIT
        SELECT  condition_code,
                condition_text,
                MAX(num_active_meds) AS max_active_meds_per_patient
        FROM   (
                SELECT  c.code.coding[OFFSET(0)].code  AS condition_code,
                        c.code.text                    AS condition_text,
                        c.subject.patientId            AS patient_id,
                        COUNT(DISTINCT mr.medication.codeableConcept.coding[OFFSET(0)].code)
                                                            AS num_active_meds
                FROM    `bigquery-public-data.fhir_synthea.condition`         AS c
                JOIN    `bigquery-public-data.fhir_synthea.medication_request` AS mr
                  ON    mr.subject.patientId = c.subject.patientId
                JOIN   (
                        SELECT  patient_id
                        FROM    (
                                SELECT  c.subject.patientId AS patient_id,
                                        COUNT(DISTINCT c.code.coding[OFFSET(0)].code) AS distinct_conditions
                                FROM    `bigquery-public-data.fhir_synthea.condition` AS c
                                JOIN    (
                                        SELECT DISTINCT p.id
                                        FROM   `bigquery-public-data.fhir_synthea.patient` AS p,
                                               UNNEST(p.name) AS n
                                        WHERE  n.family LIKE 'A%'
                                          AND  (p.deceased.boolean IS NULL AND p.deceased.dateTime IS NULL)
                                    ) AS alive_A
                                ON      alive_A.id = c.subject.patientId
                                GROUP BY patient_id
                                HAVING DISTINCT_CONDITIONS = 1
                              )
                      ) AS qual
                  ON   qual.patient_id = c.subject.patientId
                WHERE   mr.status = 'active'
                GROUP  BY condition_code, condition_text, patient_id
               )
        GROUP  BY condition_code, condition_text
       )
ORDER BY max_active_meds_per_patient DESC
LIMIT 8;
```

