--Description / thinking process:
-- Objective: Return the eight conditions (code & name) that, for any single
--            living patient whose last name starts with “A” and who has
--            exactly one condition, are associated with the greatest number
--            of distinct active medications prescribed to that patient.
-- Logical steps inside CTEs:
--   1. living_A_patients  – IDs of alive patients with last name LIKE 'A%'.
--   2. one_cond_pat       – filter those patients to ones having exactly one
--                           condition; capture that condition’s code & text.
--   3. med_cnt            – for every living “A*” patient count DISTINCT
--                           active medications in medication_request.
--   4. Final SELECT       – join (2) and (3); per condition report the
--                           MAX(active_meds) observed for any patient;
--                           sort descending; limit to 8 rows.

WITH living_A_patients AS (
  SELECT p.id AS patient_id
  FROM   `bigquery-public-data.fhir_synthea.patient` AS p
  CROSS  JOIN UNNEST(p.name) AS n
  WHERE  n.family LIKE 'A%'                                            -- last name begins with A
    AND (p.deceased.boolean IS NULL AND p.deceased.dateTime IS NULL)   -- ensure patient is alive
),
one_cond_pat AS (
  SELECT c.subject.patientId AS patient_id,
         ANY_VALUE(cc.code)    AS cond_code,
         ANY_VALUE(cc.display) AS cond_name
  FROM   `bigquery-public-data.fhir_synthea.condition` AS c
  CROSS  JOIN UNNEST(c.code.coding) AS cc
  WHERE  c.subject.patientId IN (SELECT patient_id FROM living_A_patients)
  GROUP  BY patient_id
  HAVING COUNT(DISTINCT c.id) = 1                                      -- exactly one condition
),
med_cnt AS (
  SELECT mr.subject.patientId AS patient_id,
         COUNT(DISTINCT mc.code) AS active_meds
  FROM   `bigquery-public-data.fhir_synthea.medication_request` AS mr
  CROSS  JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
  WHERE  mr.status = 'active'                                          -- active prescriptions
    AND  mr.subject.patientId IN (SELECT patient_id FROM living_A_patients)
  GROUP  BY patient_id
)
SELECT oc.cond_name  AS condition,
       oc.cond_code  AS condition_code,
       MAX(m.active_meds) AS max_active_drugs_for_any_patient
FROM   one_cond_pat AS oc
JOIN   med_cnt      AS m
  ON   oc.patient_id = m.patient_id
GROUP  BY oc.cond_name, oc.cond_code
ORDER  BY max_active_drugs_for_any_patient DESC
LIMIT 8;
