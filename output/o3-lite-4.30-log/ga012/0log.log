Query:
--Description: 
-- #10 (corrected) – One‑stop query: rank categories by avg tax‑rate, keep rn = 1
--    (top category), then output purchase‑event details for that category on
--    2020‑11‑30.  Uses CROSS JOIN instead of an ON with a constant.
WITH ranked_categories AS (
  SELECT
    i.item_category,
    AVG(ecommerce.tax_value_in_usd / ecommerce.purchase_revenue_in_usd) AS avg_tax_rate,
    ROW_NUMBER() OVER (ORDER BY AVG(ecommerce.tax_value_in_usd / ecommerce.purchase_revenue_in_usd) DESC) AS rn
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`,
       UNNEST(items) AS i
  WHERE event_name = 'purchase'
    AND event_date = '20201130'
    AND ecommerce.purchase_revenue_in_usd > 0
  GROUP BY i.item_category
)
SELECT
  e.ecommerce.transaction_id,
  e.ecommerce.total_item_quantity,
  e.ecommerce.purchase_revenue_in_usd,
  e.ecommerce.purchase_revenue
FROM ranked_categories rc
CROSS JOIN `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e
JOIN UNNEST(e.items) AS i
  ON i.item_category = rc.item_category
WHERE rc.rn = 1
  AND e.event_name = 'purchase'
  AND e.event_date = '20201130'
LIMIT 20
