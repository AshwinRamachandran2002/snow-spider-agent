```sql
--Description / Thinking process:
-- 1) Convert the micro‑second epoch "block_timestamp" to a real timestamp and truncate it
--    to the first day of its month → "month_start".  This serves as the single GROUP BY key.
-- 2) COUNT(*) on those grouped rows gives the raw number of log rows (transactions) per month.
-- 3) The exact length of each month in seconds is obtained with
--    DATEDIFF('second', month_start, month_start + INTERVAL '1 month'),
--    so leap years or 30‑/31‑day months are handled automatically.
-- 4) Divide the monthly count by that second count → transactions‑per‑second (TPS); round to 6 dp.
-- 5) Extract numeric year / month solely for readability and sort by the monthly count descending.

WITH monthly AS (
    SELECT
        DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1e6)) AS "month_start",
        COUNT(*)                                                   AS "monthly_txn_cnt"
    FROM
        GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
    WHERE
        DATE_PART('year', TO_TIMESTAMP("block_timestamp" / 1e6)) = 2023
    GROUP BY
        "month_start"
)
SELECT
    DATE_PART('year',  "month_start")                              AS "year",
    DATE_PART('month', "month_start")                              AS "month",
    "monthly_txn_cnt",
    ROUND(
        "monthly_txn_cnt" /
        DATEDIFF('second', "month_start", "month_start" + INTERVAL '1 month'),
        6
    )                                                              AS "txns_per_second"
FROM
    monthly
ORDER BY
    "monthly_txn_cnt" DESC;
```
