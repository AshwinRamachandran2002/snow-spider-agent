       "transaction_hash"
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE  "block_timestamp" >= 1672531200000000        -- 2023‑01‑01
  AND  "block_timestamp" <  1704067200000000        -- 2024‑01‑01
LIMIT 20;
```

```sql
-- 5. Raw monthly transaction‑record counts (no deduplication)
SELECT YEAR(TO_TIMESTAMP("block_timestamp"/1e6))  AS yr,
       MONTH(TO_TIMESTAMP("block_timestamp"/1e6)) AS mo,
       COUNT(*)                                    AS tx_records
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE  "block_timestamp" >= 1672531200000000
  AND  "block_timestamp" <  1704067200000000
GROUP  BY yr, mo
ORDER  BY mo
LIMIT 20;
```

```sql
-- 6. Compute the exact number of seconds inside each month of 2023
WITH months_23 AS (
  SELECT DATE_TRUNC('month', DATE '2023-01-01' + (seq4())::INT * INTERVAL '1 month') AS first_day
  FROM TABLE(GENERATOR(ROWCOUNT => 12))
)
SELECT first_day                                             AS month_start,
       DATEDIFF('second', first_day, DATEADD('month',1,first_day)) AS seconds_in_month
FROM   months_23
LIMIT 20;
```

```sql
-- 7. Join the seconds‑per‑month list with the monthly counts to get TPS
WITH months_23 AS (
  SELECT DATE_TRUNC('month', DATE '2023-01-01' + (seq4())::INT * INTERVAL '1 month') AS month_start,
         DATEDIFF('second', 
                  DATE_TRUNC('month', DATE '2023-01-01' + (seq4())::INT * INTERVAL '1 month'),
                  DATEADD('month', 1, DATE_TRUNC('month', DATE '2023-01-01' + (seq4())::INT * INTERVAL '1 month'))
         ) AS seconds_in_month
  FROM TABLE(GENERATOR(ROWCOUNT => 12))
),
tx_by_month AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp"/1e6)) AS month_start,
         COUNT(*)                                                AS tx_records
  FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
  WHERE  "block_timestamp" >= 1672531200000000
    AND  "block_timestamp" <  1704067200000000
  GROUP  BY month_start
)
SELECT t.month_start,
       t.tx_records,
       m.seconds_in_month,
       t.tx_records / m.seconds_in_month::FLOAT AS tx_per_second
FROM   tx_by_month t
JOIN   months_23  m  USING (month_start)
LIMIT 20;
```

```sql
