--Description: (#7) Build a helper list of 2023 months with exact seconds, count rows in LOGS per month,
--             then join the two to compute transactions‑per‑second (TPS) for each month (sample 20 rows).
WITH months_23 AS (
    SELECT DATE_TRUNC('month', DATEADD('month', SEQ4(), DATE '2023-01-01'))                         AS month_start,
           DATEDIFF('second',
                    DATE_TRUNC('month', DATEADD('month', SEQ4(), DATE '2023-01-01')),
                    DATEADD('month', 1, DATE_TRUNC('month', DATEADD('month', SEQ4(), DATE '2023-01-01')))
           )                                                                                       AS seconds_in_month
    FROM TABLE(GENERATOR(ROWCOUNT => 12))
),
tx_by_month AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1e6)) AS month_start,
           COUNT(*)                                                   AS tx_records
    FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE  "block_timestamp" >= 1672531200000000   -- 2023‑01‑01
      AND  "block_timestamp" <  1704067200000000   -- 2024‑01‑01
    GROUP  BY month_start
)
SELECT t.month_start,
       t.tx_records,
       m.seconds_in_month,
       t.tx_records / m.seconds_in_month::FLOAT AS tx_per_second
FROM   tx_by_month t
JOIN   months_23  m USING (month_start)
LIMIT 20
