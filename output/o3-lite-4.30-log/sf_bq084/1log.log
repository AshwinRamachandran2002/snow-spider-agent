```sql
--Description / Thinking process:
-- Step‑1: Build a helper table “months_23” that lists the first day of each month in 2023
--         by adding SEQ4() months (0‑11) to 2023‑01‑01.  For every month_start we also
--         calculate the exact number of seconds in that month with DATEDIFF.
-- Step‑2: Aggregate the LOGS table for 2023, counting every row (no hash‑deduplication)
--         and truncating each timestamp to month_start so it aligns with the helper list.
-- Step‑3: Join the helper table with the monthly counts, derive transactions‑per‑second,
--         and return year, month, total rows, and TPS, ordering by descending volume.

WITH months_23 AS (
    SELECT DATE_TRUNC('month', DATEADD('month', SEQ4(), DATE '2023-01-01')) AS month_start,
           DATEDIFF(
               'second',
               DATE_TRUNC('month', DATEADD('month', SEQ4(), DATE '2023-01-01')),
               DATEADD('month', 1, DATE_TRUNC('month', DATEADD('month', SEQ4(), DATE '2023-01-01')))
           ) AS seconds_in_month
    FROM TABLE(GENERATOR(ROWCOUNT => 12))
),
tx_by_month AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1e6)) AS month_start,
           COUNT(*)                                                   AS tx_records
    FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE  "block_timestamp" >= 1672531200000000    -- 2023‑01‑01 00:00:00 UTC in μs
      AND  "block_timestamp" <  1704067200000000    -- 2024‑01‑01 00:00:00 UTC in μs
    GROUP  BY month_start
)
SELECT YEAR(m.month_start)                          AS yr,
       MONTH(m.month_start)                         AS mo,
       t.tx_records                                 AS monthly_transaction_count,
       t.tx_records / m.seconds_in_month::FLOAT     AS transactions_per_second
FROM   months_23 m
JOIN   tx_by_month t USING (month_start)
ORDER  BY monthly_transaction_count DESC;
```
