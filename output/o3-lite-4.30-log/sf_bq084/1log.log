       "transaction_hash"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
LIMIT 20;
```

```sql
-- 4. Verify that filtering for the 2023 calendar year works
