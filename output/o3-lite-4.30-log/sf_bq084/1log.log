Begin Exploring Related Columns
Relevant columns and their potential usage for this task  
• "block_timestamp": micro‑seconds since Unix epoch; used to locate the exact second a transaction was added to a block, extract month/year, and to measure the exact number of seconds in every month.  
• "transaction_hash": string that identifies the transaction; we count every row that carries a hash (no de‑duplication).  
• "block_number", "log_index", "address", "removed", "block_hash", "transaction_index": not needed for the requested metrics but can help in sanity checks or additional grouping if desired.  
Main filtering condition: limit rows to calendar‑year 2023  
    WHERE "block_timestamp" >= 1672531200000000  -- 2023‑01‑01 00:00:00 UTC, micro‐seconds  
      AND "block_timestamp" <  1704067200000000  -- 2024‑01‑01 00:00:00 UTC, micro‐seconds  

Below are ten exploratory Snowflake SQL queries (each limited to 20 rows) that progress from simple inspection to the complete monthly count + TPS computation.  
All column names are wrapped in double quotes and every query is preceded by a short comment.

```sql
-- 1. Quick look at raw rows in the LOGS table (sample)
SELECT *
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
LIMIT 20;
```

```sql
-- 2. Inspect only the timestamps and hashes to confirm micro‑second format
SELECT "block_timestamp",
       "transaction_hash"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
LIMIT 20;
```

```sql
-- 3. Convert micro‑seconds to a TIMESTAMP_NTZ and show the derived year/month
SELECT TO_TIMESTAMP("block_timestamp"/1e6)        AS ts,
       YEAR(TO_TIMESTAMP("block_timestamp"/1e6))  AS yr,
       MONTH(TO_TIMESTAMP("block_timestamp"/1e6)) AS mo,
       "transaction_hash"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
LIMIT 20;
```

```sql
-- 4. Verify that filtering for the 2023 calendar year works
SELECT TO_TIMESTAMP("block_timestamp"/1e6) AS ts,
       "transaction_hash"
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE  "block_timestamp" >= 1672531200000000        -- 2023‑01‑01
  AND  "block_timestamp" <  1704067200000000        -- 2024‑01‑01
LIMIT 20;
```

```sql
-- 5. Raw monthly transaction‑record counts (no deduplication)
SELECT YEAR(TO_TIMESTAMP("block_timestamp"/1e6))  AS yr,
       MONTH(TO_TIMESTAMP("block_timestamp"/1e6)) AS mo,
       COUNT(*)                                    AS tx_records
FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE  "block_timestamp" >= 1672531200000000
  AND  "block_timestamp" <  1704067200000000
GROUP  BY yr, mo
ORDER  BY mo
LIMIT 20;
```

```sql
-- 6. Compute the exact number of seconds inside each month of 2023
WITH months_23 AS (
  SELECT DATE_TRUNC('month', DATE '2023-01-01' + (seq4())::INT * INTERVAL '1 month') AS first_day
  FROM TABLE(GENERATOR(ROWCOUNT => 12))
)
SELECT first_day                                             AS month_start,
       DATEDIFF('second', first_day, DATEADD('month',1,first_day)) AS seconds_in_month
FROM   months_23
LIMIT 20;
```

```sql
-- 7. Join the seconds‑per‑month list with the monthly counts to get TPS
WITH months_23 AS (
  SELECT DATE_TRUNC('month', DATE '2023-01-01' + (seq4())::INT * INTERVAL '1 month') AS month_start,
         DATEDIFF('second', 
                  DATE_TRUNC('month', DATE '2023-01-01' + (seq4())::INT * INTERVAL '1 month'),
                  DATEADD('month', 1, DATE_TRUNC('month', DATE '2023-01-01' + (seq4())::INT * INTERVAL '1 month'))
         ) AS seconds_in_month
  FROM TABLE(GENERATOR(ROWCOUNT => 12))
),
tx_by_month AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp"/1e6)) AS month_start,
         COUNT(*)                                                AS tx_records
  FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
  WHERE  "block_timestamp" >= 1672531200000000
    AND  "block_timestamp" <  1704067200000000
  GROUP  BY month_start
)
SELECT t.month_start,
       t.tx_records,
       m.seconds_in_month,
       t.tx_records / m.seconds_in_month::FLOAT AS tx_per_second
FROM   tx_by_month t
JOIN   months_23  m  USING (month_start)
LIMIT 20;
```

```sql
-- 8. Same as #7 but adding the numeric year and month and ordering by descending records
WITH months_23 AS (
  SELECT DATE_TRUNC('month', DATE '2023-01-01' + (seq4())::INT * INTERVAL '1 month') AS month_start,
         DATEDIFF('second',
                  DATE_TRUNC('month', DATE '2023-01-01' + (seq4())::INT * INTERVAL '1 month'),
                  DATEADD('month', 1, DATE_TRUNC('month', DATE '2023-01-01' + (seq4())::INT * INTERVAL '1 month'))
         ) AS seconds_in_month
  FROM TABLE(GENERATOR(ROWCOUNT => 12))
),
tx_by_month AS (
  SELECT DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp"/1e6)) AS month_start,
         COUNT(*)                                                AS tx_records
  FROM   "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
  WHERE  "block_timestamp" >= 1672531200000000
    AND  "block_timestamp" <  1704067200000000
  GROUP  BY month_start
)
SELECT YEAR(month_start)                AS yr,
       MONTH(month_start)               AS mo,
       tx_records,
       tx_records / seconds_in_month::FLOAT AS tx_per_second
FROM   tx_by_month
JOIN   months_23 USING (month_start)
ORDER  BY tx_records DESC
LIMIT 20;
```

