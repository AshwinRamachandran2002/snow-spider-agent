--Description: Some observations for the fixed code DT.DOD.DECT.CD have NULL years,
--             so instead search the facts table for any indicator whose name contains
--             both “external debt stocks” and “long‑term”.  Keep rows with non‑NULL
--             year & value, pick the most recent observation per country (ROW_NUMBER),
--             join to the country metadata to discard entities that lack a ‘region’,
--             and finally list the 20 countries with the largest latest‑year values.
WITH debt AS (
  SELECT country_code,
         country_name,
         year,
         value
  FROM `bigquery-public-data.world_bank_intl_debt.international_debt`
  WHERE LOWER(indicator_name) LIKE '%external debt stocks%'
    AND LOWER(indicator_name) LIKE '%long-term%'
    AND year  IS NOT NULL
    AND value IS NOT NULL
),
latest AS (
  SELECT d.*,
         ROW_NUMBER() OVER (PARTITION BY country_code ORDER BY year DESC) AS rn
  FROM debt d
)
SELECT cs.short_name AS country,
       cs.region,
       l.year,
       l.value AS long_term_external_debt_usd
FROM latest l
JOIN `bigquery-public-data.world_bank_intl_debt.country_summary` cs
  USING (country_code)
WHERE l.rn = 1                 -- keep only each country’s latest year
  AND cs.region IS NOT NULL    -- exclude “no‑region” entities
ORDER BY l.value DESC
LIMIT 20;
```
