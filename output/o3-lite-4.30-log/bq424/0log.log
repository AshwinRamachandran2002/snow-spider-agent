--Description:  A direct MAX(year) join failed because many rows for the series
--              ‘DT.DOD.DECT.CD’ (External debt stocks, long‑term) have NULL in
--              either the `year` or `value` column.  To guarantee data:
--              1)  Select only records with non‑NULL year AND value.
--              2)  Use ROW_NUMBER(), ordered by year DESC, to keep each country’s
--                 most‑recent observation.
--              3)  Join to country metadata and drop entities whose `region`
--                 is NULL.
--              4)  Return the 20 countries with the largest latest‑year value of
--                 long‑term external‑debt stocks.
SELECT cs.short_name AS country,
       cs.region,
       d.year,
       d.value AS long_term_external_debt_usd
FROM (
  SELECT country_code,
         year,
         value,
         ROW_NUMBER() OVER (PARTITION BY country_code ORDER BY year DESC) AS rn
  FROM `bigquery-public-data.world_bank_intl_debt.international_debt`
  WHERE indicator_code = 'DT.DOD.DECT.CD'
    AND year  IS NOT NULL
    AND value IS NOT NULL
) AS d
JOIN `bigquery-public-data.world_bank_intl_debt.country_summary` AS cs
  USING (country_code)
WHERE d.rn = 1                 -- most‑recent record per country
  AND cs.region IS NOT NULL    -- exclude undefined regions
ORDER BY d.value DESC
LIMIT 20;
