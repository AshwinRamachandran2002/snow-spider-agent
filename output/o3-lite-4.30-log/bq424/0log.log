         s.region
ORDER BY total_long_term_debt_usd DESC
LIMIT 20;
```

```sql
--Description: Retrieve the latest‑year value (not the sum) of long‑term external debt
--             for each country that has a region, then list the top 20.
WITH latest AS (
  SELECT country_code,
         MAX(year) AS latest_year
  FROM `bigquery-public-data.world_bank_intl_debt.international_debt`
  WHERE indicator_code = 'DT.DOD.DECT.CD'
  GROUP BY country_code
)
SELECT s.short_name  AS country,
       s.region,
       d.value        AS long_term_debt_latest_year_usd,
       d.year
FROM latest
JOIN `bigquery-public-data.world_bank_intl_debt.international_debt` AS d
  ON d.country_code = latest.country_code
 AND d.year         = latest.latest_year
 AND d.indicator_code = 'DT.DOD.DECT.CD'
JOIN `bigquery-public-data.world_bank_intl_debt.country_summary`     AS s
  ON s.country_code = d.country_code
WHERE s.region IS NOT NULL
ORDER BY d.value DESC
LIMIT 20;
```

```sql
--Description: Final answer – top 10 countries with the largest cumulative amount of
--             long‑term external debt, excluding countries without a specified region.
SELECT s.short_name AS country,
       s.region,
       SUM(d.value) AS total_long_term_external_debt_usd
FROM `bigquery-public-data.world_bank_intl_debt.international_debt` AS d
JOIN `bigquery-public-data.world_bank_intl_debt.country_summary`     AS s
  USING (country_code)
WHERE d.indicator_code = 'DT.DOD.DECT.CD'   -- External debt stocks, long‑term (current US$)
  AND s.region IS NOT NULL
GROUP BY country,
         s.region
ORDER BY total_long_term_external_debt_usd DESC
LIMIT 10;
```
