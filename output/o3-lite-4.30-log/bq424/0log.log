```sql
--Description:  Rows for the code DT.DOD.DECT.CD often have NULL year/value, so earlier
--              “latest‑year” joins came back empty.  To guarantee data we:
--              1) scan the facts table for any indicator whose name contains both
--                 “external debt stocks” and “long‑term” (case‑insensitive);
--              2) keep only records with non‑NULL year and value;
--              3) assign ROW_NUMBER over each country ordered by year DESC to isolate
--                 that country’s most‑recent observation;
--              4) join to the country metadata and discard entities whose `region`
--                 is NULL;
--              5) return the 20 largest latest‑year values of long‑term external debt.
SELECT cs.short_name AS country,
       cs.region,
       d.year,
       d.value AS long_term_external_debt_usd
FROM (
  SELECT country_code,
         year,
         value,
         ROW_NUMBER() OVER (PARTITION BY country_code ORDER BY year DESC) AS rn
  FROM `bigquery-public-data.world_bank_intl_debt.international_debt`
  WHERE LOWER(indicator_name) LIKE '%external debt stocks%'
    AND LOWER(indicator_name) LIKE '%long-term%'
    AND year  IS NOT NULL
    AND value IS NOT NULL
) AS d
JOIN `bigquery-public-data.world_bank_intl_debt.country_summary` AS cs
  USING (country_code)
WHERE d.rn = 1            -- latest observation per country
  AND cs.region IS NOT NULL
ORDER BY d.value DESC
LIMIT 20;
```
