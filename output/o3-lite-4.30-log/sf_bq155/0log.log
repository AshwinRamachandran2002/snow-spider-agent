```sql
--Description / thinking process:
-- • Need per‑sample log10‑average expression of SNORA31 in TCGA‑BRCA.
-- • Clinical filters: disease_code = 'BRCA', age_at_diagnosis ≤ 80, pathologic_stage ∈ {Stage I, Stage II, Stage IIA}.
-- • Step‑1: pull eligible case_barcodes from CLINICAL.
-- • Step‑2: join those cases to RNASEQ_GENE_EXPRESSION rows where gene_name = 'SNORA31'.
-- • Step‑3: compute average HTSeq__Counts per sample (robust even if duplicate rows) and then log10( value + 1 ).
-- • Snowflake has LOG(base, value) instead of LOG10().
-- • Limit 20 rows just for inspection.
WITH eligible_cases AS (
    SELECT "case_barcode"
    FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
    WHERE "disease_code" = 'BRCA'
      AND "age_at_diagnosis" <= 80
      AND "pathologic_stage" IN ('Stage I', 'Stage II', 'Stage IIA')
)
SELECT
    r."sample_barcode",
    LOG(10, AVG(r."HTSeq__Counts") + 1) AS "log10_SNORA31"
FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION r
JOIN eligible_cases e
      ON r."case_barcode" = e."case_barcode"
WHERE r."gene_name" = 'SNORA31'
GROUP BY r."sample_barcode"
LIMIT 20;
