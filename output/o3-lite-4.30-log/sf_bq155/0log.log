Query:
--Description: ⑨  Compute Pearson correlation between log10‑SNORA31 and every miRNA
--              (Snowflake uses LOG(base,value) instead of LOG10).
WITH eligible_cases AS (
    SELECT "case_barcode"
    FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
    WHERE "disease_code"     = 'BRCA'
      AND "age_at_diagnosis" <= 80
      AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
),
snora31 AS (
    SELECT
        r."sample_barcode",
        LOG(10, r."HTSeq__Counts" + 1) AS "log10_SNORA31"
    FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION r
    JOIN eligible_cases e
          ON r."case_barcode" = e."case_barcode"
    WHERE r."gene_name" = 'SNORA31'
),
mirna AS (
    SELECT
        m."sample_barcode",
        m."mirna_id",
        AVG(m."reads_per_million_miRNA_mapped") AS "avg_mirna_rpm"
    FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.MIRNASEQ_EXPRESSION m
    JOIN eligible_cases e
          ON m."case_barcode" = e."case_barcode"
    GROUP BY m."sample_barcode", m."mirna_id"
)
SELECT
    mi."mirna_id",
    COUNT(*)                                        AS "n_samples",
    CORR(sn."log10_SNORA31", mi."avg_mirna_rpm")    AS "pearson_r"
FROM mirna mi
JOIN snora31 sn
      ON mi."sample_barcode" = sn."sample_barcode"
GROUP BY mi."mirna_id"
HAVING COUNT(*) > 25
   AND ABS(CORR(sn."log10_SNORA31", mi."avg_mirna_rpm")) BETWEEN 0.3 AND 1.0
LIMIT 20
