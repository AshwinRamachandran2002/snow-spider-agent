The table structure information is ({database name: {schema name: [table name]}}): 
{'TCGA_HG38_DATA_V0': {'QOTM': [], 'TCGA_BIOCLIN_V0': ['CLINICAL'], 'TCGA_HG38_DATA_V0': ['MIRNASEQ_EXPRESSION', 'RNASEQ_GENE_EXPRESSION']}}
Begin Exploring Related Columns
Relevant columns and their potential usage  
• “project_short_name” (all 3 tables): cohort filter – keep only rows where the value is ‘TCGA‑BRCA’.  
• “disease_code” (CLINICAL): alternative cohort filter – value ‘BRCA’.  
• “case_barcode” (all 3 tables): patient identifier – lets us connect expression tables with the clinical table.  
• “sample_barcode” (MIRNASEQ_EXPRESSION / RNASEQ_GENE_EXPRESSION): sample identifier – enables one‑to‑one match between RNA‑Seq and miRNA‑Seq measurements collected from the same tumour sample.  
• “gene_name” (RNASEQ_GENE_EXPRESSION): used to pull the SNORA31 record only.  
• “HTSeq__Counts” (RNASEQ_GENE_EXPRESSION): raw RNA‑Seq counts – transformed as log10( HTSeq__Counts + 1 ).  
• “mirna_id” (MIRNASEQ_EXPRESSION): id of every unique micro‑RNA; required to compute a separate correlation for each mirna_id.  
• “reads_per_million_miRNA_mapped” (MIRNASEQ_EXPRESSION): expression measure that will be averaged per sample for every mirna_id.  
• “age_at_diagnosis” (CLINICAL): filter – only patients whose age_at_diagnosis ≤ 80.  
• “pathologic_stage” (CLINICAL): filter – only “Stage I”, “Stage II”, “Stage IIA”.  
• “age_at_diagnosis”, “pathologic_stage”, “case_barcode” (CLINICAL): provide the list of eligible patients to be joined with expression data.  

Main conditions that will be used  
1. “project_short_name” = ‘TCGA‑BRCA’  (or “disease_code” = ‘BRCA’)  
2. “age_at_diagnosis” ≤ 80  
3. “pathologic_stage” ILIKE ‘Stage I%’ OR = ‘Stage II’ OR = ‘Stage IIA’  
4. “gene_name” = ‘SNORA31’  
5. Aggregate only micro‑RNAs that have > 25 matched samples and |corr| between 0.3 and 1.0.  

Below are ten stepwise Snowflake SQL queries (each limited to 20 rows) that range from exploratory checks to the full correlation + t‑statistic computation.

```sql
-- 1. Description: Distinct pathologic_stage values recorded for TCGA‑BRCA
SELECT DISTINCT "pathologic_stage"
FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
WHERE "disease_code" = 'BRCA'
LIMIT 20;
```

```sql
-- 2. Description: Basic count of BRCA patients who meet the age (≤80) and stage filters
SELECT COUNT(*) AS "eligible_patients"
FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
WHERE "disease_code" = 'BRCA'
  AND "age_at_diagnosis" <= 80
  AND (
        "pathologic_stage" = 'Stage I'
     OR "pathologic_stage" = 'Stage II'
     OR "pathologic_stage" = 'Stage IIA'
      )
LIMIT 20;
```

```sql
-- 3. Description: List the first 20 case_barcodes that satisfy the clinical criteria
SELECT "case_barcode", "age_at_diagnosis", "pathologic_stage"
FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
WHERE "disease_code" = 'BRCA'
  AND "age_at_diagnosis" <= 80
  AND (
        "pathologic_stage" = 'Stage I'
     OR "pathologic_stage" = 'Stage II'
     OR "pathologic_stage" = 'Stage IIA'
      )
LIMIT 20;
```

```sql
-- 4. Description: Raw RNA‑Seq counts for SNORA31 in TCGA‑BRCA
SELECT "case_barcode", "sample_barcode", "HTSeq__Counts"
FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "gene_name" = 'SNORA31'
LIMIT 20;
```

```sql
-- 5. Description: miRNA‑Seq rows (case + sample + mirna_id + expression) for TCGA‑BRCA
SELECT "case_barcode", "sample_barcode", "mirna_id", "reads_per_million_miRNA_mapped"
FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.MIRNASEQ_EXPRESSION
WHERE "project_short_name" = 'TCGA-BRCA'
LIMIT 20;
```

```sql
-- 6. Description: Build a list of ‘good’ samples – they belong to eligible patients
WITH eligible_cases AS (
  SELECT "case_barcode"
  FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
  WHERE "disease_code" = 'BRCA'
    AND "age_at_diagnosis" <= 80
    AND (
          "pathologic_stage" = 'Stage I'
       OR "pathologic_stage" = 'Stage II'
       OR "pathologic_stage" = 'Stage IIA'
        )
)
SELECT DISTINCT r."sample_barcode", r."case_barcode"
FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION r
JOIN eligible_cases e
  ON r."case_barcode" = e."case_barcode"
WHERE r."gene_name" = 'SNORA31'
LIMIT 20;
```

```sql
-- 7. Description: Average log10(HTSeq__Counts + 1) for SNORA31, one value per sample
WITH eligible_cases AS (
  SELECT "case_barcode"
  FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
  WHERE "disease_code" = 'BRCA'
    AND "age_at_diagnosis" <= 80
    AND (
          "pathologic_stage" = 'Stage I'
       OR "pathologic_stage" = 'Stage II'
       OR "pathologic_stage" = 'Stage IIA'
        )
)
SELECT
  r."sample_barcode",
  LOG10(AVG(r."HTSeq__Counts") + 1) AS "log10_SNORA31"
FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION r
JOIN eligible_cases e
  ON r."case_barcode" = e."case_barcode"
WHERE r."gene_name" = 'SNORA31'
GROUP BY r."sample_barcode"
LIMIT 20;
```

```sql
-- 8. Description: Average miRNA expression (reads_per_million) per sample for every mirna_id
WITH eligible_cases AS (
  SELECT "case_barcode"
  FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
  WHERE "disease_code" = 'BRCA'
    AND "age_at_diagnosis" <= 80
    AND (
          "pathologic_stage" = 'Stage I'
       OR "pathologic_stage" = 'Stage II'
       OR "pathologic_stage" = 'Stage IIA'
        )
)
SELECT
  m."sample_barcode",
  m."mirna_id",
  AVG(m."reads_per_million_miRNA_mapped") AS "avg_mirna_rpm"
FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.MIRNASEQ_EXPRESSION m
JOIN eligible_cases e
  ON m."case_barcode" = e."case_barcode"
GROUP BY m."sample_barcode", m."mirna_id"
LIMIT 20;
```

```sql
-- 9. Description: Compute Pearson correlation between SNORA31 expression and every miRNA across matched samples
WITH eligible_cases AS (
  SELECT "case_barcode"
  FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
  WHERE "disease_code" = 'BRCA'
    AND "age_at_diagnosis" <= 80
    AND (
          "pathologic_stage" = 'Stage I'
       OR "pathologic_stage" = 'Stage II'
       OR "pathologic_stage" = 'Stage IIA'
        )
),
snora31 AS (
  SELECT
    r."sample_barcode",
    LOG10(r."HTSeq__Counts" + 1) AS "log10_SNORA31"
  FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION r
  JOIN eligible_cases e
    ON r."case_barcode" = e."case_barcode"
  WHERE r."gene_name" = 'SNORA31'
),
mirna AS (
  SELECT
    m."sample_barcode",
    m."mirna_id",
    AVG(m."reads_per_million_miRNA_mapped") AS "avg_mirna_rpm"
  FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.MIRNASEQ_EXPRESSION m
  JOIN eligible_cases e
    ON m."case_barcode" = e."case_barcode"
  GROUP BY m."sample_barcode", m."mirna_id"
)
SELECT
  mi."mirna_id",
  COUNT(*)                              AS "n_samples",
  CORR(sn."log10_SNORA31", mi."avg_mirna_rpm") AS "pearson_r"
FROM mirna mi
JOIN snora31 sn
  ON mi."sample_barcode" = sn."sample_barcode"
GROUP BY mi."mirna_id"
HAVING COUNT(*) > 25
   AND ABS(CORR(sn."log10_SNORA31", mi."avg_mirna_rpm")) BETWEEN 0.3 AND 1.0
LIMIT 20;
```

```sql
-- 10. Description: Final step – add t‑statistic derived from the Pearson r for every qualifying miRNA
WITH eligible_cases AS (
  SELECT "case_barcode"
  FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
  WHERE "disease_code" = 'BRCA'
    AND "age_at_diagnosis" <= 80
    AND (
          "pathologic_stage" = 'Stage I'
       OR "pathologic_stage" = 'Stage II'
       OR "pathologic_stage" = 'Stage IIA'
        )
),
snora31 AS (
  SELECT
    r."sample_barcode",
    LOG10(r."HTSeq__Counts" + 1) AS "log10_SNORA31"
  FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION r
  JOIN eligible_cases e
    ON r."case_barcode" = e."case_barcode"
  WHERE r."gene_name" = 'SNORA31'
),
mirna AS (
  SELECT
    m."sample_barcode",
    m."mirna_id",
    AVG(m."reads_per_million_miRNA_mapped") AS "avg_mirna_rpm"
  FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.MIRNASEQ_EXPRESSION m
  JOIN eligible_cases e
    ON m."case_barcode" = e."case_barcode"
  GROUP BY m."sample_barcode", m."mirna_id"
),
corr_table AS (
  SELECT
    mi."mirna_id",
    COUNT(*) AS "n_samples",
    CORR(sn."log10_SNORA31", mi."avg_mirna_rpm") AS "pearson_r"
  FROM mirna mi
  JOIN snora31 sn
    ON mi."sample_barcode" = sn."sample_barcode"
  GROUP BY mi."mirna_id"
  HAVING COUNT(*) > 25
     AND ABS(CORR(sn."log10_SNORA31", mi."avg_mirna_rpm")) BETWEEN 0.3 AND 1.0
)
SELECT
  "mirna_id",
  "n_samples",
  "pearson_r",
  ("pearson_r" * SQRT( ("n_samples" - 2) / (1 - POWER("pearson_r", 2)) )) AS "t_statistic"
FROM corr_table
ORDER BY ABS("pearson_r") DESC
LIMIT 20;
```

