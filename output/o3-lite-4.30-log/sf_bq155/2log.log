--Description: End‑to‑end solution with inline thinking process
-- -----------------------------------------------------------------
-- Goal: For TCGA‑BRCA, compute t‑statistics derived from Pearson r
--       between log10‑transformed SNORA31 RNA‑seq expression and the
--       average expression of each miRNA, restricted to patients
--       ≤80 yrs at diagnosis and pathologic stage I / II / IIA.
-- Steps (annotated):
--   1) gene_case  : gather SNORA31 counts, average per case, add 1,
--                   then convert to log10  (Snowflake uses LOG(base,val)).
--   2) mirna_case : for every miRNA, average reads_per_million per case.
--   3) eligible   : select cases satisfying the age & stage filters.
--   4) Join       : pair gene & miRNA values on eligible cases,
--                   compute r and the t‑statistic;
--                   retain rows with n>25 and 0.3≤|r|≤1.
WITH gene_case AS (  ----------------------------------------------------
    -- 1) Compute log10‑SNORA31 per case
    SELECT
        "case_barcode",
        LOG(10, AVG("HTSeq__Counts") + 1) AS "log10_snora31"
    FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."RNASEQ_GENE_EXPRESSION"
    WHERE "project_short_name" = 'TCGA-BRCA'
      AND "gene_name" = 'SNORA31'
    GROUP BY "case_barcode"
), mirna_case AS (  ------------------------------------------------------
    -- 2) Average miRNA expression per (case, miRNA)
    SELECT
        "case_barcode",
        "mirna_id",
        AVG("reads_per_million_miRNA_mapped") AS "mirna_avg"
    FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."MIRNASEQ_EXPRESSION"
    WHERE "project_short_name" = 'TCGA-BRCA'
    GROUP BY "case_barcode", "mirna_id"
), eligible AS (  --------------------------------------------------------
    -- 3) Clinical filtering: age ≤80 & desired pathologic stages
    SELECT "case_barcode"
    FROM "TCGA_HG38_DATA_V0"."TCGA_BIOCLIN_V0"."CLINICAL"
    WHERE "project_short_name" = 'TCGA-BRCA'
      AND "age_at_diagnosis" <= 80
      AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
)
-- 4) Correlate, filter for sample size & r‑range, calculate t
SELECT
    m."mirna_id",
    COUNT(*)                                   AS "n_samples",
    CORR(g."log10_snora31", m."mirna_avg")     AS "pearson_r",
    (CORR(g."log10_snora31", m."mirna_avg") * SQRT(COUNT(*) - 2))
      / SQRT(1 - POWER(CORR(g."log10_snora31", m."mirna_avg"), 2))
                                                AS "t_statistic"
FROM eligible e
JOIN gene_case  g ON e."case_barcode" = g."case_barcode"
JOIN mirna_case m ON e."case_barcode" = m."case_barcode"
GROUP BY m."mirna_id"
HAVING COUNT(*) > 25
   AND ABS(CORR(g."log10_snora31", m."mirna_avg")) BETWEEN 0.3 AND 1.0
ORDER BY ABS("pearson_r") DESC
LIMIT 20;
