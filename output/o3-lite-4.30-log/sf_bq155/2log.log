Relevant columns & how they will be used  
------------------------------------------------  
• "project_short_name": cohort filter – keep only `TCGA‑BRCA` rows in every table.  
• "case_barcode": patient identifier – key for joining CLINICAL, RNASEQ and MIRNASEQ tables.  
• "age_at_diagnosis": age filter – keep cases with value ≤ 80 (years).  
• "pathologic_stage": stage filter – keep only `Stage I`, `Stage II`, `Stage IIA`.  
• "gene_name": choose gene of interest – filter to `'SNORA31'` in RNASEQ table.  
• "HTSeq__Counts": raw gene‑expression counts – will be averaged per case, then log10(count+1).  
• "mirna_id": micro‑RNA symbol – will be paired with SNORA31 for correlations.  
• "reads_per_million_miRNA_mapped": miRNA expression value – will be averaged per case.  

Conditions that will be applied  
• "project_short_name" = 'TCGA‑BRCA'  
• "age_at_diagnosis" ≤ 80  
• "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')  

Ten exploratory / step‑wise Snowflake SQL queries  
------------------------------------------------  

```sql
--Description: 1) List distinct pathological stages recorded for TCGA‑BRCA cases
SELECT DISTINCT "pathologic_stage"
FROM "TCGA_HG38_DATA_V0"."TCGA_BIOCLIN_V0"."CLINICAL"
WHERE "project_short_name" = 'TCGA-BRCA'
LIMIT 20;
```

```sql
--Description: 2) Count BRCA cases that meet the age (≤80) & stage (I, II, IIA) criteria
SELECT COUNT(*) AS "n_cases"
FROM "TCGA_HG38_DATA_V0"."TCGA_BIOCLIN_V0"."CLINICAL"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "age_at_diagnosis" <= 80
  AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
LIMIT 20;
```

```sql
--Description: 3) Show basic clinical info for the first 20 eligible BRCA patients
SELECT "case_barcode",
       "age_at_diagnosis",
       "pathologic_stage",
       "vital_status"
FROM "TCGA_HG38_DATA_V0"."TCGA_BIOCLIN_V0"."CLINICAL"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "age_at_diagnosis" <= 80
  AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
LIMIT 20;
```

```sql
--Description: 4) Raw SNORA31 RNA‑seq counts for BRCA samples
SELECT "case_barcode",
       "sample_barcode",
       "HTSeq__Counts"
FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."RNASEQ_GENE_EXPRESSION"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "gene_name" = 'SNORA31'
LIMIT 20;
```

```sql
--Description: 5) Average SNORA31 counts per case (all BRCA samples)
SELECT "case_barcode",
       AVG("HTSeq__Counts") AS "avg_snora31_counts"
FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."RNASEQ_GENE_EXPRESSION"
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "gene_name" = 'SNORA31'
GROUP BY "case_barcode"
LIMIT 20;
```

```sql
--Description: 6) Average miRNA expression per case across ALL miRNAs
SELECT "case_barcode",
       AVG("reads_per_million_miRNA_mapped") AS "avg_mirna_expr"
FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."MIRNASEQ_EXPRESSION"
WHERE "project_short_name" = 'TCGA-BRCA'
GROUP BY "case_barcode"
LIMIT 20;
```

```sql
--Description: 7) For each miRNA, number of BRCA samples having expression data
SELECT "mirna_id",
       COUNT(DISTINCT "sample_barcode") AS "n_samples"
FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."MIRNASEQ_EXPRESSION"
WHERE "project_short_name" = 'TCGA-BRCA'
GROUP BY "mirna_id"
ORDER BY "n_samples" DESC
LIMIT 20;
```

```sql
--Description: 8) Eligible cases (age & stage) that also have SNORA31 RNA‑seq data
SELECT DISTINCT c."case_barcode"
FROM "TCGA_HG38_DATA_V0"."TCGA_BIOCLIN_V0"."CLINICAL"            c
JOIN "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."RNASEQ_GENE_EXPRESSION" g
      ON c."case_barcode" = g."case_barcode"
WHERE c."project_short_name" = 'TCGA-BRCA'
  AND c."age_at_diagnosis" <= 80
  AND c."pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
  AND g."gene_name" = 'SNORA31'
LIMIT 20;
```

```sql
--Description: 9) Correlation (Pearson r) between log10‑SNORA31 and each miRNA, preliminary view
WITH gene_case AS (
    SELECT "case_barcode",
           LOG10(AVG("HTSeq__Counts")+1) AS "log10_snora31"
    FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."RNASEQ_GENE_EXPRESSION"
    WHERE "project_short_name" = 'TCGA-BRCA'
      AND "gene_name" = 'SNORA31'
    GROUP BY "case_barcode"
),
mirna_case AS (
    SELECT "case_barcode",
           "mirna_id",
           AVG("reads_per_million_miRNA_mapped") AS "mirna_avg"
    FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."MIRNASEQ_EXPRESSION"
    WHERE "project_short_name" = 'TCGA-BRCA'
    GROUP BY "case_barcode","mirna_id"
),
eligible AS (
    SELECT "case_barcode"
    FROM "TCGA_HG38_DATA_V0"."TCGA_BIOCLIN_V0"."CLINICAL"
    WHERE "project_short_name" = 'TCGA-BRCA'
      AND "age_at_diagnosis" <= 80
      AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
)
SELECT m."mirna_id",
       COUNT(*)                                 AS "n_samples",
       CORR(g."log10_snora31", m."mirna_avg")   AS "r_value"
FROM eligible e
JOIN gene_case g  ON e."case_barcode" = g."case_barcode"
JOIN mirna_case m ON e."case_barcode" = m."case_barcode"
GROUP BY m."mirna_id"
LIMIT 20;
```

```sql
--Description: 10) Final t‑statistic (pairs with n>25 & |r| between 0.3 and 1.0)
WITH gene_case AS (
    SELECT "case_barcode",
           LOG10(AVG("HTSeq__Counts")+1) AS "log10_snora31"
    FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."RNASEQ_GENE_EXPRESSION"
    WHERE "project_short_name" = 'TCGA-BRCA'
      AND "gene_name" = 'SNORA31'
    GROUP BY "case_barcode"
),
mirna_case AS (
    SELECT "case_barcode",
           "mirna_id",
           AVG("reads_per_million_miRNA_mapped") AS "mirna_avg"
    FROM "TCGA_HG38_DATA_V0"."TCGA_HG38_DATA_V0"."MIRNASEQ_EXPRESSION"
    WHERE "project_short_name" = 'TCGA-BRCA'
    GROUP BY "case_barcode","mirna_id"
),
eligible AS (
    SELECT "case_barcode"
    FROM "TCGA_HG38_DATA_V0"."TCGA_BIOCLIN_V0"."CLINICAL"
    WHERE "project_short_name" = 'TCGA-BRCA'
      AND "age_at_diagnosis" <= 80
      AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
)
SELECT m."mirna_id",
       COUNT(*)                                   AS "n_samples",
       CORR(g."log10_snora31", m."mirna_avg")     AS "r_value",
       (CORR(g."log10_snora31", m."mirna_avg") * SQRT(COUNT(*)-2))
       / SQRT(1 - POWER(CORR(g."log10_snora31", m."mirna_avg"),2)) AS "t_statistic"
FROM eligible e
JOIN gene_case g  ON e."case_barcode" = g."case_barcode"
JOIN mirna_case m ON e."case_barcode" = m."case_barcode"
GROUP BY m."mirna_id"
HAVING COUNT(*) > 25
   AND ABS(CORR(g."log10_snora31", m."mirna_avg")) BETWEEN 0.3 AND 1.0
LIMIT 20;
```
