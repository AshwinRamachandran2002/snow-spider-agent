Begin Exploring Related Columns
Relevant columns and their potential usage  

CLINICAL  
• "project_short_name": filter to the TCGA‑BRCA cohort.  
• "age_at_diagnosis": select patients ≤ 80 years.  
• "pathologic_stage": keep “Stage I”, “Stage II”, “Stage IIA”.  
• "case_barcode": patient identifier used to join to expression tables.  

RNASEQ_GENE_EXPRESSION  
• "case_barcode": link to clinical table.  
• "gene_name": pick rows where gene_name = ‘SNORA31’.  
• "HTSeq__Counts": raw read counts; add 1 then LOG10‑transform and average per patient.  
• "sample_barcode": allows averaging replicate samples that belong to the same case.  

MIRNASEQ_EXPRESSION  
• "case_barcode": link to clinical table.  
• "mirna_id": every unique micro‑RNA.  
• "reads_per_million_miRNA_mapped": numeric expression value to be averaged per patient.  

Main filter / join conditions that will be used  
1.  "project_short_name" = 'TCGA-BRCA'  
2.  "age_at_diagnosis" ≤ 80  
3.  "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')  
4.  matching "case_barcode" across the three tables  
5.  only miRNA–SNORA31 pairs with COUNT(DISTINCT case_barcode) > 25  
6.  0.3 ≤ ABS(Pearson r) ≤ 1.0  

Below are ten exploratory Snowflake SQL queries (each returns ≤ 20 rows) that progress from simple inspection to the final t‑statistic calculation.  
All identifiers are enclosed in double quotes.

```sql
-- 1. Distinct pathological stages recorded for TCGA-BRCA
SELECT DISTINCT "pathologic_stage"
FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
WHERE "project_short_name" = 'TCGA-BRCA'
LIMIT 20;
```

```sql
-- 2. Patient counts by pathologic_stage for TCGA-BRCA (all ages)
SELECT "pathologic_stage",
       COUNT(*) AS "n_patients"
FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
WHERE "project_short_name" = 'TCGA-BRCA'
GROUP BY "pathologic_stage"
LIMIT 20;
```

```sql
-- 3. List some eligible patients (≤80 yrs, Stage I / II / IIA)
SELECT DISTINCT "case_barcode"
FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
WHERE "project_short_name" = 'TCGA-BRCA'
  AND "age_at_diagnosis" <= 80
  AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
LIMIT 20;
```

```sql
-- 4. Raw SNORA31 counts for those patients
SELECT r."case_barcode",
       r."sample_barcode",
       r."HTSeq__Counts"
FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION r
JOIN (
      SELECT DISTINCT "case_barcode"
      FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
      WHERE "project_short_name" = 'TCGA-BRCA'
        AND "age_at_diagnosis" <= 80
        AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
     ) c
     ON r."case_barcode" = c."case_barcode"
WHERE r."gene_name" = 'SNORA31'
LIMIT 20;
```

```sql
-- 5. Average log10‑transformed SNORA31 expression per patient
SELECT r."case_barcode",
       AVG( LOG10(r."HTSeq__Counts" + 1) ) AS "avg_log10_SNORA31"
FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION r
JOIN (
      SELECT DISTINCT "case_barcode"
      FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
      WHERE "project_short_name" = 'TCGA-BRCA'
        AND "age_at_diagnosis" <= 80
        AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
     ) elig
     ON r."case_barcode" = elig."case_barcode"
WHERE r."gene_name" = 'SNORA31'
GROUP BY r."case_barcode"
LIMIT 20;
```

```sql
-- 6. Average miRNA expression (RPM) per patient for the same cohort
SELECT m."case_barcode",
       m."mirna_id",
       AVG(m."reads_per_million_miRNA_mapped") AS "avg_miRNA_RPM"
FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.MIRNASEQ_EXPRESSION m
JOIN (
      SELECT DISTINCT "case_barcode"
      FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
      WHERE "project_short_name" = 'TCGA-BRCA'
        AND "age_at_diagnosis" <= 80
        AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
     ) elig
     ON m."case_barcode" = elig."case_barcode"
GROUP BY m."case_barcode", m."mirna_id"
LIMIT 20;
```

```sql
-- 7. miRNAs that have expression data for >25 eligible patients
WITH mi AS (
  SELECT m."mirna_id",
         COUNT(DISTINCT m."case_barcode") AS "n_cases"
  FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.MIRNASEQ_EXPRESSION m
  JOIN (
        SELECT DISTINCT "case_barcode"
        FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
        WHERE "project_short_name" = 'TCGA-BRCA'
          AND "age_at_diagnosis" <= 80
          AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
       ) elig
       ON m."case_barcode" = elig."case_barcode"
  GROUP BY m."mirna_id"
)
SELECT *
FROM mi
WHERE "n_cases" > 25
LIMIT 20;
```

```sql
-- 8. Pearson correlation between SNORA31 and each miRNA (all pairs)
WITH sn AS (
  SELECT r."case_barcode",
         AVG( LOG10(r."HTSeq__Counts" + 1) ) AS "log10_SNORA31"
  FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION r
  JOIN (
        SELECT DISTINCT "case_barcode"
        FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
        WHERE "project_short_name" = 'TCGA-BRCA'
          AND "age_at_diagnosis" <= 80
          AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
       ) elig
       ON r."case_barcode" = elig."case_barcode"
  WHERE r."gene_name" = 'SNORA31'
  GROUP BY r."case_barcode"
),
mi AS (
  SELECT m."case_barcode",
         m."mirna_id",
         AVG(m."reads_per_million_miRNA_mapped") AS "avg_miRNA_RPM"
  FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.MIRNASEQ_EXPRESSION m
  JOIN (
        SELECT DISTINCT "case_barcode"
        FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
        WHERE "project_short_name" = 'TCGA-BRCA'
          AND "age_at_diagnosis" <= 80
          AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
       ) elig
       ON m."case_barcode" = elig."case_barcode"
  GROUP BY m."case_barcode", m."mirna_id"
)
SELECT mi."mirna_id",
       CORR(mi."avg_miRNA_RPM", sn."log10_SNORA31") AS "pearson_r",
       COUNT(*) AS "n_samples"
FROM mi
JOIN sn ON mi."case_barcode" = sn."case_barcode"
GROUP BY mi."mirna_id"
LIMIT 20;
```

```sql
-- 9. Filter to correlations with |r| between 0.3 and 1.0 and >25 samples
WITH corr_tbl AS (
  /*  copy query #8   */
  SELECT mi."mirna_id",
         CORR(mi."avg_miRNA_RPM", sn."log10_SNORA31") AS "pearson_r",
         COUNT(*) AS "n_samples"
  FROM (
        /*  same mi CTE as above */  
        SELECT m."case_barcode",
               m."mirna_id",
               AVG(m."reads_per_million_miRNA_mapped") AS "avg_miRNA_RPM"
        FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.MIRNASEQ_EXPRESSION m
        JOIN (
              SELECT DISTINCT "case_barcode"
              FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
              WHERE "project_short_name" = 'TCGA-BRCA'
                AND "age_at_diagnosis" <= 80
                AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
             ) elig
             ON m."case_barcode" = elig."case_barcode"
        GROUP BY m."case_barcode", m."mirna_id"
       ) mi
  JOIN (
        /*  same sn CTE as above */
        SELECT r."case_barcode",
               AVG( LOG10(r."HTSeq__Counts" + 1) ) AS "log10_SNORA31"
        FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION r
        JOIN (
              SELECT DISTINCT "case_barcode"
              FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
              WHERE "project_short_name" = 'TCGA-BRCA'
                AND "age_at_diagnosis" <= 80
                AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
             ) elig2
             ON r."case_barcode" = elig2."case_barcode"
        WHERE r."gene_name" = 'SNORA31'
        GROUP BY r."case_barcode"
       ) sn
       ON mi."case_barcode" = sn."case_barcode"
  GROUP BY mi."mirna_id"
)
SELECT *
FROM corr_tbl
WHERE ABS("pearson_r") BETWEEN 0.3 AND 1.0
  AND "n_samples" > 25
LIMIT 20;
```

```sql
-- 10. Calculate t‑statistic for the qualifying miRNAs
WITH qualified AS (
  /*  copy query #9 up to the WHERE clause */
  SELECT *
  FROM (
        /*  full correlation calculation as in #9 */
        SELECT mi."mirna_id",
               CORR(mi."avg_miRNA_RPM", sn."log10_SNORA31") AS "pearson_r",
               COUNT(*) AS "n_samples"
        FROM (
              SELECT m."case_barcode",
                     m."mirna_id",
                     AVG(m."reads_per_million_miRNA_mapped") AS "avg_miRNA_RPM"
              FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.MIRNASEQ_EXPRESSION m
              JOIN (
                    SELECT DISTINCT "case_barcode"
                    FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
                    WHERE "project_short_name" = 'TCGA-BRCA'
                      AND "age_at_diagnosis" <= 80
                      AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
                   ) elig
                   ON m."case_barcode" = elig."case_barcode"
              GROUP BY m."case_barcode", m."mirna_id"
             ) mi
        JOIN (
              SELECT r."case_barcode",
                     AVG( LOG10(r."HTSeq__Counts" + 1) ) AS "log10_SNORA31"
              FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION r
              JOIN (
                    SELECT DISTINCT "case_barcode"
                    FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
                    WHERE "project_short_name" = 'TCGA-BRCA'
                      AND "age_at_diagnosis" <= 80
                      AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
                   ) elig2
                   ON r."case_barcode" = elig2."case_barcode"
              WHERE r."gene_name" = 'SNORA31'
              GROUP BY r."case_barcode"
             ) sn
             ON mi."case_barcode" = sn."case_barcode"
        GROUP BY mi."mirna_id"
       ) res
  WHERE ABS(res."pearson_r") BETWEEN 0.3 AND 1.0
    AND res."n_samples" > 25
)
SELECT "mirna_id",
       "pearson_r",
       "n_samples",
       ("pearson_r" * SQRT("n_samples" - 2)) / SQRT(1 - "pearson_r" * "pearson_r") AS "t_statistic"
FROM qualified
LIMIT 20;
```

These ten queries build the necessary pieces—from identifying eligible TCGA‑BRCA patients, extracting and transforming SNORA31 RNA‑Seq data, aggregating miRNA‑Seq data, computing Pearson correlations, filtering by sample size and correlation strength, and finally producing the requested t‑statistics.
