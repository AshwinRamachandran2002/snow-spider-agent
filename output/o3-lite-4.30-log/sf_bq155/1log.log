--Description:  End‑to‑end derivation (thinking process in‑line) of t‑statistics for the correlation
--              between log10‑transformed SNORA31 RNA‑Seq expression and every miRNA’s mean RPM
--              in TCGA‑BRCA patients who were ≤80 years old and pathologic Stage I / II / IIA.
--              CTE blocks show each reasoning step.
WITH
/*─────────────────────────────────────────────────────────
 STEP 1: Identify ELIGIBLE cases
─────────────────────────────────────────────────────────*/
eligible_cases AS (
    SELECT DISTINCT "case_barcode"
    FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
    WHERE "project_short_name" = 'TCGA-BRCA'        -- restrict to BRCA cohort
      AND "age_at_diagnosis" <= 80                  -- age ≤ 80 years
      AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')   -- desired stages
),
/*─────────────────────────────────────────────────────────
 STEP 2: Compute average log10(SNORA31 counts + 1) per case
─────────────────────────────────────────────────────────*/
snora31_per_case AS (
    SELECT r."case_barcode",
           AVG( LOG(10, r."HTSeq__Counts" + 1) ) AS "log10_SNORA31"
    FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.RNASEQ_GENE_EXPRESSION r
    JOIN eligible_cases e USING ("case_barcode")
    WHERE r."gene_name" = 'SNORA31'
    GROUP BY r."case_barcode"
),
/*─────────────────────────────────────────────────────────
 STEP 3: Compute average RPM for every miRNA per case
─────────────────────────────────────────────────────────*/
mirna_per_case AS (
    SELECT m."case_barcode",
           m."mirna_id",
           AVG(m."reads_per_million_miRNA_mapped") AS "avg_miRNA_RPM"
    FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.MIRNASEQ_EXPRESSION m
    JOIN eligible_cases e USING ("case_barcode")
    GROUP BY m."case_barcode", m."mirna_id"
),
/*─────────────────────────────────────────────────────────
 STEP 4: Pearson correlation of each miRNA vs SNORA31
─────────────────────────────────────────────────────────*/
corr_stats AS (
    SELECT mp."mirna_id",
           CORR(mp."avg_miRNA_RPM", sp."log10_SNORA31") AS "pearson_r",
           COUNT(*)                                     AS "n_samples"
    FROM mirna_per_case mp
    JOIN snora31_per_case sp USING ("case_barcode")
    GROUP BY mp."mirna_id"
),
/*─────────────────────────────────────────────────────────
 STEP 5: Keep miRNAs meeting criteria and derive t‑stat
─────────────────────────────────────────────────────────*/
qualified AS (
    SELECT "mirna_id",
           "pearson_r",
           "n_samples",
           ("pearson_r" * SQRT("n_samples" - 2))
             / SQRT(1 - POWER("pearson_r", 2))          AS "t_statistic"
    FROM corr_stats
    WHERE "n_samples" > 25
      AND ABS("pearson_r") BETWEEN 0.3 AND 1.0
)
/*─────────────────────────────────────────────────────────
 FINAL: Return strongest 20 associations
─────────────────────────────────────────────────────────*/
SELECT "mirna_id",
       "pearson_r",
       "n_samples",
       "t_statistic"
FROM qualified
ORDER BY ABS("t_statistic") DESC
LIMIT 20;
