           COUNT(DISTINCT m."case_barcode") AS "n_cases"
    FROM TCGA_HG38_DATA_V0.TCGA_HG38_DATA_V0.MIRNASEQ_EXPRESSION m
    JOIN (
          SELECT DISTINCT "case_barcode"
          FROM TCGA_HG38_DATA_V0.TCGA_BIOCLIN_V0.CLINICAL
          WHERE "project_short_name" = 'TCGA-BRCA'
            AND "age_at_diagnosis" <= 80
            AND "pathologic_stage" IN ('Stage I','Stage II','Stage IIA')
         ) elig
      ON m."case_barcode" = elig."case_barcode"
    GROUP BY m."mirna_id"
)
SELECT *
FROM mi
WHERE "n_cases" > 25
LIMIT 20;
