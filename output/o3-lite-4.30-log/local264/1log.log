```

```sql
-- 7. Description: Produce a two‑row summary table comparing Stack vs Traditional counts
SELECT CASE 
         WHEN LOWER("L1_model") LIKE '%stack%' THEN 'Stack'
         ELSE 'Traditional'
       END AS model_group,
       COUNT(*) AS total_occurrences
FROM   "model"
