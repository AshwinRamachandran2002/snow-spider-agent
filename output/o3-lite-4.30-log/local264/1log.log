--Description: Same as the previous query but ordered by the highest count first.
SELECT model_group,
       total_occurrences
FROM (
        SELECT 'Stack'        AS model_group,
               (SELECT COUNT(*) FROM "model"
                WHERE LOWER("L1_model") LIKE '%stack%')        AS total_occurrences
        UNION ALL
        SELECT 'Traditional'  AS model_group,
               (SELECT COUNT(*) FROM "model"
                WHERE LOWER("L1_model") NOT LIKE '%stack%')
     )
