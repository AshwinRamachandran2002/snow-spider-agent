Begin Exploring Related Columns
Relevant columns and how they will probably be used  
--------------------------------------------------  
`candidate_committee_2016.cmte_id`: join‑key to the committee tables  
`candidate_committee_2016.cand_id`: join‑key to the candidate table  
`candidate_committee_2016.fec_election_yr`: must equal 2016 (limit to the 2016 cycle)

`committee_2016.cmte_id`: join‑key to contributions / candidate linkage  
`committee_2016.cmte_nm`: committee name we have to report

`indiv16.cmte_id`: join‑key to the committee table  
`indiv16.transaction_amt`: dollar amount; filter 0 < amount < 200  
`indiv16.entity_tp`: should be ‘IND’ (individual) – optional extra filter  
`indiv16.transaction_dt`: can be used to make sure the gift was inside the 2016 cycle if needed

`candidate_2016.cand_id`: join‑key to candidate‑committee table  
`candidate_2016.cand_name`: candidate name we must list

Conditions that will be applied in the later queries  
• `candidate_committee_2016.fec_election_yr = 2016`  
• `indiv16.transaction_amt > 0 AND indiv16.transaction_amt < 200`  
• `SUM(indiv16.transaction_amt) > 0` (per committee)  

Ten step‑by‑step exploration queries  
-------------------------------------

```sql
-- 1. Inspect candidate‑committee links for the 2016 cycle
SELECT *
FROM `bigquery-public-data.fec.candidate_committee_2016`
WHERE fec_election_yr = 2016
LIMIT 20;
```

```sql
-- 2. Get distinct committees that supported any candidate in 2016
SELECT DISTINCT cmte_id
FROM `bigquery-public-data.fec.candidate_committee_2016`
WHERE fec_election_yr = 2016
LIMIT 20;
```

```sql
-- 3. Look at raw individual‑contribution rows with amounts below $200
SELECT cmte_id, transaction_amt, transaction_dt
FROM `bigquery-public-data.fec.indiv16`
WHERE transaction_amt > 0
  AND transaction_amt < 200
LIMIT 20;
```

```sql
-- 4. Aggregate small‑dollar contributions per committee
SELECT cmte_id,
       SUM(transaction_amt) AS small_dollar_total,
       COUNT(*)              AS num_small_dollar_txns
FROM `bigquery-public-data.fec.indiv16`
WHERE transaction_amt > 0
  AND transaction_amt < 200
GROUP BY cmte_id
LIMIT 20;
```

```sql
-- 5. Join committee names onto the small‑dollar summary
SELECT agg.cmte_id,
       c.cmte_nm,
       agg.small_dollar_total
FROM (
    SELECT cmte_id,
           SUM(transaction_amt) AS small_dollar_total
    FROM `bigquery-public-data.fec.indiv16`
    WHERE transaction_amt > 0 AND transaction_amt < 200
    GROUP BY cmte_id
) AS agg
LEFT JOIN `bigquery-public-data.fec.committee_2016` AS c
ON agg.cmte_id = c.cmte_id
LIMIT 20;
```

```sql
-- 6. Count how many unique candidates each committee supported
SELECT cmte_id,
       COUNT(DISTINCT cand_id) AS num_candidates_supported
FROM `bigquery-public-data.fec.candidate_committee_2016`
WHERE fec_election_yr = 2016
GROUP BY cmte_id
LIMIT 20;
```

```sql
-- 7. Merge candidate names with their committees for 2016
SELECT DISTINCT cc.cmte_id,
       cand.cand_name
FROM `bigquery-public-data.fec.candidate_committee_2016` AS cc
JOIN `bigquery-public-data.fec.candidate_2016`             AS cand
ON cc.cand_id = cand.cand_id
WHERE cc.fec_election_yr = 2016
LIMIT 20;
```

```sql
-- 8. Produce an alphabetically‑sorted, comma‑separated list of 
--    candidates for each committee
SELECT cc.cmte_id,
       STRING_AGG(DISTINCT cand.cand_name, ', ' ORDER BY cand.cand_name) AS cand_names
FROM `bigquery-public-data.fec.candidate_committee_2016` AS cc
JOIN `bigquery-public-data.fec.candidate_2016`             AS cand
ON cc.cand_id = cand.cand_id
WHERE cc.fec_election_yr = 2016
GROUP BY cc.cmte_id
LIMIT 20;
```

```sql
-- 9. Bring together small‑dollar totals and candidate counts
SELECT name_agg.cmte_id,
       cmte.cmte_nm,
       name_agg.cand_names,
       cnt.num_candidates_supported,
       small.small_dollar_total
FROM (
    SELECT cc.cmte_id,
           STRING_AGG(DISTINCT cand.cand_name, ', ' ORDER BY cand.cand_name) AS cand_names
    FROM `bigquery-public-data.fec.candidate_committee_2016` AS cc
    JOIN `bigquery-public-data.fec.candidate_2016`             AS cand
    ON cc.cand_id = cand.cand_id
    WHERE cc.fec_election_yr = 2016
    GROUP BY cc.cmte_id
) AS name_agg
JOIN (
    SELECT cmte_id,
           COUNT(DISTINCT cand_id) AS num_candidates_supported
    FROM `bigquery-public-data.fec.candidate_committee_2016`
    WHERE fec_election_yr = 2016
    GROUP BY cmte_id
) AS cnt
ON name_agg.cmte_id = cnt.cmte_id
JOIN (
    SELECT cmte_id, SUM(transaction_amt) AS small_dollar_total
    FROM `bigquery-public-data.fec.indiv16`
    WHERE transaction_amt > 0 AND transaction_amt < 200
    GROUP BY cmte_id
) AS small
ON name_agg.cmte_id = small.cmte_id
LEFT JOIN `bigquery-public-data.fec.committee_2016` AS cmte
ON name_agg.cmte_id = cmte.cmte_id
LIMIT 20;
```

```sql
-- 10. FINAL query: committees (2016 cycle) that supported ≥1 candidate
--     and whose aggregate individual contributions 0<amt<200
--     sum to >0.  Lists committee name, # of candidates, 
--     alphabetized names, and total small‑dollar $.
SELECT
  cmte.cmte_nm                       AS committee_name,
  cnt.num_candidates_supported       AS num_unique_candidates,
  name_agg.cand_names                AS candidate_names_alphabetical,
  FORMAT('%.2f', small.small_dollar_total) AS total_small_dollar
FROM
  -- candidate names per committee
  (SELECT
     cc.cmte_id,
     STRING_AGG(DISTINCT cand.cand_name, ', ' ORDER BY cand.cand_name) AS cand_names
   FROM `bigquery-public-data.fec.candidate_committee_2016` AS cc
   JOIN `bigquery-public-data.fec.candidate_2016`             AS cand
   ON cc.cand_id = cand.cand_id
   WHERE cc.fec_election_yr = 2016
   GROUP BY cc.cmte_id) AS name_agg
JOIN
  -- candidate count per committee
  (SELECT
     cmte_id,
     COUNT(DISTINCT cand_id) AS num_candidates_supported
   FROM `bigquery-public-data.fec.candidate_committee_2016`
   WHERE fec_election_yr = 2016
   GROUP BY cmte_id) AS cnt
ON name_agg.cmte_id = cnt.cmte_id
JOIN
  -- small‑dollar totals per committee
  (SELECT
     cmte_id,
     SUM(transaction_amt) AS small_dollar_total
   FROM `bigquery-public-data.fec.indiv16`
   WHERE transaction_amt > 0
     AND transaction_amt < 200
   GROUP BY cmte_id
   HAVING SUM(transaction_amt) > 0) AS small
ON name_agg.cmte_id = small.cmte_id
LEFT JOIN
  `bigquery-public-data.fec.committee_2016` AS cmte
ON name_agg.cmte_id = cmte.cmte_id
ORDER BY committee_name
LIMIT 20;
```

