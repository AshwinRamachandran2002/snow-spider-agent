     AND transaction_amt < 200
   GROUP BY cmte_id
   HAVING SUM(transaction_amt) > 0) AS small
ON name_agg.cmte_id = small.cmte_id
LEFT JOIN
  `bigquery-public-data.fec.committee_2016` AS cmte
ON name_agg.cmte_id = cmte.cmte_id
ORDER BY committee_name
LIMIT 20;
