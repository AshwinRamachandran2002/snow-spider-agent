WHERE fec_election_yr = 2016
LIMIT 20;
```

```sql
-- 3. Attach candidate names to those pairs
SELECT cc.cmte_id,
       cc.cand_id,
       c.cand_name
FROM   `bigquery-public-data.fec.candidate_committee_2016` AS cc
JOIN   `bigquery-public-data.fec.candidate_2016`            AS c
       ON cc.cand_id = c.cand_id
WHERE  cc.fec_election_yr = 2016
LIMIT 20;
```

```sql
-- 4. Preview committees’ official names
SELECT cmte_id, cmte_nm
FROM   `bigquery-public-data.fec.committee_2016`
LIMIT 20;
```

```sql
-- 5. Look at individual‑contribution records ≤ $200
SELECT cmte_id,
       transaction_amt
FROM   `bigquery-public-data.fec.indiv16`
WHERE  transaction_amt > 0
  AND  transaction_amt <= 200
LIMIT 20;
```

```sql
-- 6. Aggregate small‑dollar totals per committee
SELECT cmte_id,
       SUM(transaction_amt) AS small_dollar_total
FROM   `bigquery-public-data.fec.indiv16`
WHERE  transaction_amt > 0
  AND  transaction_amt <= 200
GROUP  BY cmte_id
HAVING SUM(transaction_amt) > 0
LIMIT 20;
```

```sql
-- 7. Combine small‑dollar totals with committee names
SELECT s.cmte_id,
       cm.cmte_nm,
       s.small_dollar_total
FROM  (
        SELECT cmte_id,
               SUM(transaction_amt) AS small_dollar_total
        FROM   `bigquery-public-data.fec.indiv16`
        WHERE  transaction_amt > 0
          AND  transaction_amt <= 200
        GROUP  BY cmte_id
        HAVING SUM(transaction_amt) > 0
      ) AS s
JOIN   `bigquery-public-data.fec.committee_2016` AS cm
       ON s.cmte_id = cm.cmte_id
LIMIT 20;
```

```sql
-- 8. Count how many distinct candidates each committee supports (2016 only)
SELECT cmte_id,
       COUNT(DISTINCT cand_id) AS num_candidates
FROM   `bigquery-public-data.fec.candidate_committee_2016`
WHERE  fec_election_yr = 2016
GROUP  BY cmte_id
LIMIT 20;
```

```sql
-- 9. Produce a comma‑separated, alphabetically ordered candidate list per committee
SELECT cmte_id,
       STRING_AGG(cand_name, ', ' ORDER BY cand_name) AS candidate_names
FROM (
      SELECT DISTINCT cc.cmte_id, c.cand_name
      FROM   `bigquery-public-data.fec.candidate_committee_2016` AS cc
      JOIN   `bigquery-public-data.fec.candidate_2016`            AS c
             ON cc.cand_id = c.cand_id
      WHERE  cc.fec_election_yr = 2016
     )
GROUP  BY cmte_id
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER:
-- All 2016 committees that (a) supported ≥1 candidate and
-- (b) received >$0 total from contributions >$0 and ≤$200.
SELECT
  cm.cmte_nm                                         AS committee_name,
  cand_info.num_candidates                           AS num_unique_candidates_supported,
  cand_info.candidate_names                          AS candidates_alphabetical,
  sd.small_dollar_total                              AS total_small_dollar_received
FROM  -- (a) committees that have small‑dollar money
  (
    SELECT cmte_id,
           SUM(transaction_amt) AS small_dollar_total
    FROM   `bigquery-public-data.fec.indiv16`
    WHERE  transaction_amt > 0
      AND  transaction_amt <= 200
    GROUP  BY cmte_id
    HAVING SUM(transaction_amt) > 0
  ) AS sd
JOIN  -- (b) committees that are linked to ≥1 candidate in 2016
  (
    SELECT
      cc.cmte_id,
      COUNT(DISTINCT cc.cand_id)                                                AS num_candidates,
      STRING_AGG(c.cand_name, ', ' ORDER BY c.cand_name)                        AS candidate_names
    FROM   `bigquery-public-data.fec.candidate_committee_2016`  AS cc
    JOIN   `bigquery-public-data.fec.candidate_2016`             AS c
           ON cc.cand_id = c.cand_id
    WHERE  cc.fec_election_yr = 2016
    GROUP  BY cc.cmte_id
  ) AS cand_info
  ON sd.cmte_id = cand_info.cmte_id
JOIN `bigquery-public-data.fec.committee_2016` AS cm
  ON sd.cmte_id = cm.cmte_id
ORDER BY total_small_dollar_received DESC, committee_name
LIMIT 20;  -- remove limit to see complete list
```
