-- 10) FINAL ANSWER:
--     For each league return ONE team (tie‑broken by smallest team_api_id)
--     that has the fewest total wins across all seasons.
WITH all_matches AS (
      SELECT league_id,
             home_team_api_id AS team_id,
             CASE WHEN home_team_goal > away_team_goal THEN 1 ELSE 0 END AS win_flag
      FROM Match
      UNION ALL
      SELECT league_id,
             away_team_api_id AS team_id,
             CASE WHEN away_team_goal > home_team_goal THEN 1 ELSE 0 END AS win_flag
      FROM Match
),
team_wins AS (
      SELECT league_id, team_id, SUM(win_flag) AS wins
      FROM all_matches
      GROUP BY league_id, team_id
),
league_min AS (
      SELECT league_id, MIN(wins) AS fewest_wins
      FROM team_wins
      GROUP BY league_id
),
candidates AS (
      SELECT tw.league_id, tw.team_id, tw.wins
      FROM team_wins  AS tw
      JOIN league_min AS lm
        ON tw.league_id = lm.league_id
       AND tw.wins     = lm.fewest_wins
),
one_per_league AS (
      -- deterministic tiebreaker: keep the numerically smallest team_id
      SELECT league_id,
             MIN(team_id) AS team_id,
             MAX(wins) AS wins      -- wins are all equal here (=fewest_wins)
      FROM candidates
      GROUP BY league_id
)
SELECT  l.name  AS league_name,
        t.team_long_name AS team_with_fewest_wins,
        o.wins AS total_wins
FROM    one_per_league AS o
JOIN    League        AS l ON l.id          = o.league_id
JOIN    Team          AS t ON t.team_api_id = o.team_id
ORDER BY league_name
LIMIT 20;
