JOIN   fewest          AS f  ON f.league_id = w.league_id
                             AND f.min_wins = w.wins
JOIN   League          AS l  ON l.id        = w.league_id
JOIN   Team            AS t  ON t.team_api_id = w.team_api_id
GROUP  BY w.league_id
ORDER  BY l.name
LIMIT 20;
