    SELECT til.league_id,
           til.team_api_id,
           COALESCE(tw.wins, 0) AS wins
    FROM   teams_in_league AS til
    LEFT JOIN total_wins    AS tw
           ON  tw.league_id = til.league_id
           AND tw.team_api_id = til.team_api_id
),

-- fewest number of wins found in each league
min_wins AS (
    SELECT league_id, MIN(wins) AS min_wins
    FROM   wins_with_zero
    GROUP  BY league_id
)

SELECT  l.name                         AS league_name,
        MIN(t.team_long_name)          AS team_name,      -- pick one when tied (alphabetical first)
        mw.min_wins                    AS total_wins
FROM        wins_with_zero AS w
INNER JOIN   min_wins      AS mw ON mw.league_id = w.league_id
                                      AND mw.min_wins = w.wins
INNER JOIN   League        AS l  ON l.id          = w.league_id
INNER JOIN   Team          AS t  ON t.team_api_id = w.team_api_id
GROUP  BY    l.id, mw.min_wins
ORDER BY     l.name;
