Begin Exploring Related Columns
Relevant columns, why they matter, and typical filters/joins  
• census_bureau_acs.county_*_5yr  
  – `geo_id` : county FIPS code → join key to natality files (use LPAD(geo_id,5,'0')).  
  – `poverty` : number of persons in poverty → numerator for poverty‑rate.  
  – `pop_determined_poverty_status` : population with poverty status determined → denominator.  
  – (`total_pop` can be used instead of the denominator if desired.)  

• sdoh_cdc_wonder_natality.county_natality  
  – `Year` : birth year (DATE) → filter 2016‑01‑01, 2017‑01‑01, 2018‑01‑01.  
  – `County_of_Residence_FIPS` : county FIPS → join key.  
  – `Births` : total births → denominator when computing “% births with NO maternal morbidity”.  

• sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity  
  – `Year` : same as above.  
  – `County_of_Residence_FIPS` : join key.  
  – `Maternal_Morbidity_YN` : 1 = “None checked” (i.e. no morbidity) → filter.  
  – `Births` : births in the “no morbidity” category → numerator for the percentage.  

Typical filters / joins  
• `Maternal_Morbidity_YN = 1` (only the births with “None checked”).  
• `Year` between '2016‑01‑01' and '2018‑01‑01'.  
• Join condition: `LPAD(c.geo_id,5,'0') = County_of_Residence_FIPS`.  

Below are 10 progressively‑complex SQL snippets (each limited to 20 rows unless noted) that let you inspect the data and finally compute the Pearson correlation coefficient for every required year.

```sql
-- 1. Preview poverty counts and denominators in 2015 ACS
SELECT geo_id,
       poverty,
       pop_determined_poverty_status
FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
LIMIT 20;
```

```sql
-- 2. Compute a sample poverty‑rate for 2015 ACS counties
SELECT geo_id,
       SAFE_DIVIDE(poverty, pop_determined_poverty_status) AS poverty_rate
FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
LIMIT 20;
```

```sql
-- 3. Show total births recorded for 2016
SELECT Year,
       County_of_Residence_FIPS,
       Births
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality`
WHERE Year = '2016-01-01'
LIMIT 20;
```

```sql
-- 4. Show “no maternal morbidity” births for 2016
SELECT Year,
       County_of_Residence_FIPS,
       Maternal_Morbidity_Desc,
       Births
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE Year = '2016-01-01'
  AND Maternal_Morbidity_YN = 1
LIMIT 20;
```

```sql
-- 5. Compute % of births with NO morbidity for each county in 2016
SELECT nm.County_of_Residence_FIPS               AS fips,
       nm.Births                                 AS births_no_morbidity,
       tot.Births                                AS total_births,
       SAFE_DIVIDE(nm.Births, tot.Births)        AS pct_no_morbidity
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` AS nm
JOIN `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality`                       AS tot
  ON nm.Year = tot.Year
 AND nm.County_of_Residence_FIPS = tot.County_of_Residence_FIPS
WHERE nm.Year = '2016-01-01'
  AND nm.Maternal_Morbidity_YN = 1
LIMIT 20;
```

```sql
-- 6. Join 2016 “no morbidity” % with 2015 poverty‑rate (matching counties)
SELECT c.geo_id,
       SAFE_DIVIDE(c.poverty, c.pop_determined_poverty_status) AS poverty_rate,
       m.pct_no_morbidity
FROM (
      -- subquery: pct_no_morbidity for 2016
      SELECT nm.County_of_Residence_FIPS AS fips,
             SAFE_DIVIDE(nm.Births, tot.Births) AS pct_no_morbidity
      FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` nm
      JOIN `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality` tot
        ON tot.Year = nm.Year
       AND tot.County_of_Residence_FIPS = nm.County_of_Residence_FIPS
      WHERE nm.Year = '2016-01-01'
        AND nm.Maternal_Morbidity_YN = 1
     ) AS m
JOIN `bigquery-public-data.census_bureau_acs.county_2015_5yr` AS c
  ON LPAD(c.geo_id,5,'0') = m.fips
LIMIT 20;
```

```sql
-- 7. Pearson correlation (poverty‑rate vs % no morbidity) for births in 2016
SELECT CORR(poverty_rate, pct_no_morbidity) AS corr_2016
FROM (
      SELECT LPAD(c.geo_id,5,'0') AS fips,
             SAFE_DIVIDE(c.poverty, c.pop_determined_poverty_status) AS poverty_rate,
             SAFE_DIVIDE(nm.Births, tot.Births)                      AS pct_no_morbidity
      FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`                   AS c
      JOIN `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` AS nm
        ON nm.Year = '2016-01-01'
       AND nm.Maternal_Morbidity_YN = 1
       AND LPAD(c.geo_id,5,'0') = nm.County_of_Residence_FIPS
      JOIN `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality` AS tot
        ON tot.Year = nm.Year
       AND tot.County_of_Residence_FIPS = nm.County_of_Residence_FIPS
);
```

```sql
-- 8. Pearson correlation for births in 2017 (uses 2016 ACS poverty)
SELECT CORR(poverty_rate, pct_no_morbidity) AS corr_2017
FROM (
      SELECT LPAD(c.geo_id,5,'0') AS fips,
             SAFE_DIVIDE(c.poverty, c.pop_determined_poverty_status) AS poverty_rate,
             SAFE_DIVIDE(nm.Births, tot.Births)                      AS pct_no_morbidity
      FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`                   AS c
      JOIN `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` AS nm
        ON nm.Year = '2017-01-01'
       AND nm.Maternal_Morbidity_YN = 1
       AND LPAD(c.geo_id,5,'0') = nm.County_of_Residence_FIPS
      JOIN `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality` AS tot
        ON tot.Year = nm.Year
       AND tot.County_of_Residence_FIPS = nm.County_of_Residence_FIPS
);
```

```sql
-- 9. Pearson correlation for births in 2018 (uses 2017 ACS poverty)
SELECT CORR(poverty_rate, pct_no_morbidity) AS corr_2018
FROM (
      SELECT LPAD(c.geo_id,5,'0') AS fips,
             SAFE_DIVIDE(c.poverty, c.pop_determined_poverty_status) AS poverty_rate,
             SAFE_DIVIDE(nm.Births, tot.Births)                      AS pct_no_morbidity
      FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`                   AS c
      JOIN `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` AS nm
        ON nm.Year = '2018-01-01'
       AND nm.Maternal_Morbidity_YN = 1
       AND LPAD(c.geo_id,5,'0') = nm.County_of_Residence_FIPS
      JOIN `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality` AS tot
        ON tot.Year = nm.Year
       AND tot.County_of_Residence_FIPS = nm.County_of_Residence_FIPS
);
```

```sql
-- 10. One shot: correlation for each year 2016‑2018 (no row‑limit)
WITH poverty AS (
  SELECT '2016' AS birth_year,
         LPAD(geo_id,5,'0')                         AS fips,
         SAFE_DIVIDE(poverty, pop_determined_poverty_status) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  UNION ALL
  SELECT '2017', LPAD(geo_id,5,'0'), SAFE_DIVIDE(poverty, pop_determined_poverty_status)
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
  UNION ALL
  SELECT '2018', LPAD(geo_id,5,'0'), SAFE_DIVIDE(poverty, pop_determined_poverty_status)
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
),
no_morbidity AS (
  SELECT CAST(EXTRACT(YEAR FROM Year) AS STRING)               AS birth_year,
         County_of_Residence_FIPS                               AS fips,
         SAFE_DIVIDE(SUM(Births), ANY_VALUE(tot.Births))        AS pct_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` AS nm
  JOIN `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality`                       AS tot
    ON tot.Year = nm.Year
   AND tot.County_of_Residence_FIPS = nm.County_of_Residence_FIPS
  WHERE nm.Maternal_Morbidity_YN = 1
    AND Year BETWEEN '2016-01-01' AND '2018-01-01'
  GROUP BY birth_year, fips
)
SELECT birth_year,
       CORR(poverty_rate, pct_no_morbidity) AS poverty_vs_no_morbidity_corr
FROM poverty p
JOIN no_morbidity m USING (birth_year, fips)
GROUP BY birth_year
ORDER BY birth_year;
```

