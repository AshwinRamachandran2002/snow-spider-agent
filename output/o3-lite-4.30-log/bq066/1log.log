Relevant tables & columns  

bigquery-public-data.census_bureau_acs.county_2015_5yr  
• `geo_id`: county FIPS – join key with natality tables  
• `poverty`: number of people below poverty – numerator for poverty‑rate  
• `pop_determined_poverty_status`: population for whom poverty status is determined – denominator for poverty‑rate  

bigquery-public-data.census_bureau_acs.county_2016_5yr (identical set of columns – used for births in 2017)  

bigquery-public-data.census_bureau_acs.county_2017_5yr (identical set of columns – used for births in 2018)  

bigquery-public-data.sdoh_cdc_wonder_natality.county_natality  
• `Year`: birth year (DATE) – restrict to 2016‑2018  
• `County_of_Residence_FIPS`: county FIPS – join key  
• `Births`: total live births – denominator for “no‑morbidity share”  

bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity  
• `Year`: birth year (DATE) – restrict to 2016‑2018  
• `County_of_Residence_FIPS`: join key  
• `Maternal_Morbidity_Desc`: text flag; use `= 'None checked'` to keep only births with NO maternal morbidity  
• `Maternal_Morbidity_YN`: numeric flag (1 = none checked) – alternative filter  
• `Births`: number of births in that category – numerator for “no‑morbidity share”  

Typical conditions  
• `EXTRACT(YEAR FROM Year) = 2016   -- or 2017 / 2018`  
• `(Maternal_Morbidity_Desc = 'None checked' OR Maternal_Morbidity_YN = 1)`  
• `pop_determined_poverty_status > 0` (to avoid division by zero)  


Below are 10 exploratory BigQuery SQL queries (each limited to 20 rows) that progress from simple inspection to preparation of the final correlation analysis.  
```sql
-- 1. Inspect poverty counts and denominators for 2015 ACS (to be paired with 2016 births)
SELECT
  geo_id,
  poverty,
  pop_determined_poverty_status
FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
LIMIT 20;
```

```sql
-- 2. Compute 2015 poverty rate for a quick glance
SELECT
  geo_id,
  ROUND(poverty / pop_determined_poverty_status, 4) AS poverty_rate_2015
FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
WHERE pop_determined_poverty_status > 0
LIMIT 20;
```

```sql
-- 3. Total births per county in 2016
SELECT
  County_of_Residence_FIPS AS fips,
  SUM(Births) AS total_births_2016
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality`
WHERE EXTRACT(YEAR FROM Year) = 2016
GROUP BY fips
LIMIT 20;
```

```sql
-- 4. Births with NO maternal morbidity in 2016
SELECT
  County_of_Residence_FIPS AS fips,
  SUM(Births) AS no_morbidity_births_2016
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM Year) = 2016
  AND (Maternal_Morbidity_Desc = 'None checked' OR Maternal_Morbidity_YN = 1)
GROUP BY fips
LIMIT 20;
```

```sql
-- 5. Percentage of 2016 births without maternal morbidity (per county)
WITH tot AS (
  SELECT County_of_Residence_FIPS AS fips, SUM(Births) AS total_births
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality`
  WHERE EXTRACT(YEAR FROM Year) = 2016
  GROUP BY fips),
nomorb AS (
  SELECT County_of_Residence_FIPS AS fips, SUM(Births) AS no_morbidity_births
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2016
    AND (Maternal_Morbidity_Desc = 'None checked' OR Maternal_Morbidity_YN = 1)
  GROUP BY fips)
SELECT
  t.fips,
  ROUND(n.no_morbidity_births / t.total_births, 4) AS pct_no_morbidity_2016
FROM tot t
JOIN nomorb n USING (fips)
LIMIT 20;
```

```sql
-- 6. Join 2015 poverty rate with 2016 no‑morbidity share (first step toward correlation)
WITH pov AS (
  SELECT geo_id AS fips,
         poverty / pop_determined_poverty_status AS poverty_rate_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE pop_determined_poverty_status > 0),
nomorb16 AS (
  -- reuse query 5 logic
  SELECT County_of_Residence_FIPS AS fips,
         SUM(CASE WHEN (Maternal_Morbidity_Desc = 'None checked' OR Maternal_Morbidity_YN = 1) THEN Births ELSE 0 END)
/ SUM(Births) AS pct_no_morbidity_2016
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2016
  GROUP BY fips)
SELECT
  p.fips,
  p.poverty_rate_2015,
  n.pct_no_morbidity_2016
FROM pov p
JOIN nomorb16 n USING (fips)
LIMIT 20;
```

```sql
-- 7. Prepare analogous 2017 poverty / 2018 births linkage sample
WITH pov17 AS (
  SELECT geo_id AS fips,
         poverty / pop_determined_poverty_status AS poverty_rate_2017
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
  WHERE pop_determined_poverty_status > 0),
nomorb18 AS (
  SELECT County_of_Residence_FIPS AS fips,
         SUM(CASE WHEN (Maternal_Morbidity_Desc = 'None checked' OR Maternal_Morbidity_YN = 1) THEN Births ELSE 0 END)
/ SUM(Births) AS pct_no_morbidity_2018
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2018
  GROUP BY fips)
SELECT
  p.fips,
  p.poverty_rate_2017,
  n.pct_no_morbidity_2018
FROM pov17 p
JOIN nomorb18 n USING (fips)
LIMIT 20;
```

```sql
-- 8. Compute Pearson correlation for 2016 births vs 2015 poverty (all counties)
WITH pov AS (
  SELECT geo_id AS fips,
         poverty / pop_determined_poverty_status AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE pop_determined_poverty_status > 0),
nomorb AS (
  SELECT County_of_Residence_FIPS AS fips,
         SUM(CASE WHEN (Maternal_Morbidity_Desc = 'None checked' OR Maternal_Morbidity_YN = 1) THEN Births ELSE 0 END)
/ SUM(Births) AS pct_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2016
  GROUP BY fips)
SELECT
  CORR(poverty_rate, pct_no_morbidity) AS corr_2016
FROM pov
JOIN nomorb USING (fips);
```

```sql
-- 9. Pearson correlation for 2017 births vs 2016 poverty
WITH pov AS (
  SELECT geo_id AS fips,
         poverty / pop_determined_poverty_status AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
  WHERE pop_determined_poverty_status > 0),
nomorb AS (
  SELECT County_of_Residence_FIPS AS fips,
         SUM(CASE WHEN (Maternal_Morbidity_Desc = 'None checked' OR Maternal_Morbidity_YN = 1) THEN Births ELSE 0 END)
/ SUM(Births) AS pct_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2017
  GROUP BY fips)
SELECT
  CORR(poverty_rate, pct_no_morbidity) AS corr_2017
FROM pov
JOIN nomorb USING (fips);
```

```sql
-- 10. Single query returning correlation coefficients for 2016–2018 in one result set
WITH
pov AS (
  SELECT '2016' AS birth_year, geo_id AS fips,
         poverty / pop_determined_poverty_status AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  WHERE pop_determined_poverty_status > 0
  UNION ALL
  SELECT '2017', geo_id, poverty / pop_determined_poverty_status
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
  WHERE pop_determined_poverty_status > 0
  UNION ALL
  SELECT '2018', geo_id, poverty / pop_determined_poverty_status
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
  WHERE pop_determined_poverty_status > 0),
morb AS (
  SELECT CAST(EXTRACT(YEAR FROM Year) AS STRING) AS birth_year,
         County_of_Residence_FIPS AS fips,
         SUM(CASE WHEN (Maternal_Morbidity_Desc = 'None checked' OR Maternal_Morbidity_YN = 1) THEN Births ELSE 0 END)
/ SUM(Births) AS pct_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) BETWEEN 2016 AND 2018
  GROUP BY birth_year, fips)
SELECT
  birth_year,
  CORR(poverty_rate, pct_no_morbidity) AS pearson_corr
FROM pov
JOIN morb USING (birth_year, fips)
GROUP BY birth_year
ORDER BY birth_year;
```

These queries incrementally explore, join, and finally correlate county‑level poverty rates from the ACS with the share of births reporting no maternal morbidity for the 2016–2018 period.
