Begin Exploring Related Columns
Relevant Columns and Their Usage
• alien_data.state : groups aliens by U.S. state  
• alien_data.age : used to calculate the average age of aliens in each state  
• alien_data.aggressive : 0 = friendly, 1 = hostile – used to compare the two groups  
• alien_data.id (implicit primary key) : counted to find population size  

Key conditions  
• friendly > hostile  → SUM(CASE WHEN aggressive = 0 …) > SUM(CASE WHEN aggressive = 1 …)  
• avg_age > 200  → AVG(age) > 200  
• top‑10 states by population  → ORDER BY COUNT(*) DESC LIMIT 10  

SQL Queries  
```sql
--  1. List some states that appear in alien_data
SELECT DISTINCT state
FROM alien_data
LIMIT 20;
```

```sql
-- 2. Show the ten states with the largest alien populations
SELECT state,
       COUNT(*) AS total_aliens
FROM alien_data
GROUP BY state
ORDER BY total_aliens DESC
LIMIT 20;
```

```sql
-- 3. Friendly vs. hostile counts for every state
SELECT state,
       SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) AS friendly,
       SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) AS hostile
FROM alien_data
GROUP BY state
LIMIT 20;
```

```sql
-- 4. Friendly & hostile percentages for every state
SELECT state,
       1.0 * SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) / COUNT(*)  AS pct_friendly,
       1.0 * SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) / COUNT(*)  AS pct_hostile
FROM alien_data
GROUP BY state
LIMIT 20;
```

```sql
-- 5. Average alien age for every state
SELECT state,
       AVG(age) AS avg_age
FROM alien_data
GROUP BY state
LIMIT 20;
```

```sql
-- 6. States where friendly > hostile and average age > 200
SELECT state,
       COUNT(*)                                         AS total,
       SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) AS friendly,
       SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) AS hostile,
       AVG(age)                                         AS avg_age
FROM alien_data
GROUP BY state
HAVING friendly > hostile
   AND avg_age   > 200
LIMIT 20;
```

```sql
-- 7. Apply the same filter, but only inside the TOP‑10 most‑populated states
SELECT state, total, friendly, hostile, avg_age
FROM (
        SELECT state,
               COUNT(*)                                         AS total,
               SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) AS friendly,
               SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) AS hostile,
               AVG(age)                                         AS avg_age
        FROM alien_data
        GROUP BY state
        ORDER BY total DESC
        LIMIT 10
     )
WHERE friendly > hostile
  AND avg_age   > 200
LIMIT 20;
```

```sql
-- 8. How many of those TOP‑10 states meet the criteria?
SELECT COUNT(*) AS num_states
FROM (
        SELECT state
        FROM (
                SELECT state,
                       COUNT(*)                                         AS total,
                       SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) AS friendly,
                       SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) AS hostile,
                       AVG(age)                                         AS avg_age
                FROM alien_data
                GROUP BY state
                ORDER BY total DESC
                LIMIT 10
             )
        WHERE friendly > hostile
          AND avg_age   > 200
     )
LIMIT 20;
```

```sql
-- 9. Show friendly & hostile percentages plus average age for those states
SELECT state,
       ROUND(100.0 * friendly / total, 2) AS pct_friendly,
       ROUND(100.0 * hostile  / total, 2) AS pct_hostile,
       ROUND(avg_age, 1)                  AS avg_age
FROM (
        SELECT state,
               COUNT(*)                                         AS total,
               SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) AS friendly,
               SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) AS hostile,
               AVG(age)                                         AS avg_age
        FROM alien_data
        GROUP BY state
        ORDER BY total DESC
        LIMIT 10
     )
WHERE friendly > hostile
  AND avg_age   > 200
LIMIT 20;
```

```sql
-- 10. Final answer: the count of TOP‑10 states whose friendly share is greater than hostile, and whose average age > 200
SELECT COUNT(*) AS num_top10_friendly_states
FROM (
        SELECT state
        FROM (
                SELECT state,
                       COUNT(*)                                         AS total,
                       SUM(CASE WHEN aggressive = 0 THEN 1 ELSE 0 END) AS friendly,
                       SUM(CASE WHEN aggressive = 1 THEN 1 ELSE 0 END) AS hostile,
                       AVG(age)                                         AS avg_age
                FROM alien_data
                GROUP BY state
                ORDER BY total DESC
                LIMIT 10
             )
        WHERE friendly > hostile
          AND avg_age   > 200
     )
LIMIT 20;
```

