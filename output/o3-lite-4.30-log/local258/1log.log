--Description: 8) Count legal balls & overs for one sample bowler, basis for economy / strike rate.
SELECT p.player_name,
       COUNT(*)       AS legal_balls,
       COUNT(*)/6.0   AS overs_bowled
FROM   ball_by_ball  AS bb
LEFT  JOIN extra_runs AS er
  ON   bb.match_id   = er.match_id
 AND   bb.over_id    = er.over_id
 AND   bb.ball_id    = er.ball_id
 AND   bb.innings_no = er.innings_no
JOIN   player        AS p
  ON   bb.bowler     = p.player_id
WHERE  p.player_name = 'SC Ganguly'   -- replace with any bowler
  AND (er.extra_type IS NULL
       OR er.extra_type NOT IN ('wide','wides','no ball','noball','noballs'))
GROUP  BY p.player_name
LIMIT 20
