WITH legal_balls AS (
    SELECT bb.match_id,
           bb.over_id,
           bb.ball_id,
           bb.innings_no,
           bb.bowler,
           bs.runs_scored
    FROM   ball_by_ball   AS bb
    JOIN   batsman_scored AS bs
      ON   bb.match_id   = bs.match_id
     AND   bb.over_id    = bs.over_id
     AND   bb.ball_id    = bs.ball_id
     AND   bb.innings_no = bs.innings_no
    LEFT  JOIN extra_runs AS er
      ON   bb.match_id   = er.match_id
     AND   bb.over_id    = er.over_id
     AND   bb.ball_id    = er.ball_id
     AND   bb.innings_no = er.innings_no
    WHERE  er.extra_type IS NULL
       OR  er.extra_type NOT IN ('wide','wides','no ball','noball','noballs')
),
bowler_wickets AS (
    SELECT bb.bowler,
           COUNT(*) AS wkts
    FROM   wicket_taken AS wt
    JOIN   ball_by_ball AS bb
      ON   wt.match_id   = bb.match_id
     AND   wt.over_id    = bb.over_id
     AND   wt.ball_id    = bb.ball_id
     AND   wt.innings_no = bb.innings_no
    WHERE  wt.kind_out NOT IN ('run out','retired hurt','obstructing the field')
    GROUP  BY bb.bowler
),
best_match AS (
    SELECT bowler,
           wkts_in_match,
           runs_in_match
    FROM (
        SELECT bb.bowler,
               COUNT(*)                    AS wkts_in_match,
               SUM(lb.runs_scored)         AS runs_in_match,
               ROW_NUMBER() OVER (PARTITION BY bb.bowler
                                  ORDER BY COUNT(*) DESC,
                                           SUM(lb.runs_scored) ASC) AS rn
        FROM   wicket_taken AS wt
        JOIN   ball_by_ball AS bb
          ON   wt.match_id   = bb.match_id
         AND   wt.over_id    = bb.over_id
         AND   wt.ball_id    = bb.ball_id
         AND   wt.innings_no = bb.innings_no
        JOIN   legal_balls  AS lb
          ON   lb.match_id   = bb.match_id
         AND   lb.over_id    = bb.over_id
         AND   lb.ball_id    = bb.ball_id
         AND   lb.innings_no = bb.innings_no
        WHERE  wt.kind_out NOT IN ('run out','retired hurt','obstructing the field')
        GROUP  BY bb.bowler, bb.match_id
    ) sub
    WHERE rn = 1
)
SELECT p.player_name                                                AS bowler,
       bw.wkts                                                      AS total_wickets,
       ROUND(SUM(lb.runs_scored)*1.0 / (COUNT(*)/6.0), 2)           AS economy_rate,
       ROUND(COUNT(*)*1.0 / bw.wkts, 2)                             AS strike_rate,
       printf('%d-%d', bm.wkts_in_match, bm.runs_in_match)          AS best_figures
FROM   legal_balls     AS lb
JOIN   bowler_wickets  AS bw ON lb.bowler = bw.bowler
LEFT   JOIN best_match AS bm ON lb.bowler = bm.bowler
JOIN   player          AS p  ON lb.bowler = p.player_id
GROUP  BY lb.bowler, p.player_name, bw.wkts, bm.wkts_in_match, bm.runs_in_match
ORDER  BY total_wickets DESC
LIMIT 20
