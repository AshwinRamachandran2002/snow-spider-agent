Successfully corrected. SQL:
--Description:  (thinking process embedded as comments)  
--Goal: For every bowler produce: total wickets (only bowler‑credited kinds), economy rate,
--      strike rate, and best bowling in a match (“wkts‑runs”).  
--Plan:  
-- 1. legal_balls CTE  -> keep deliveries that are legal (exclude wides/no‑balls by checking
--    extra_runs) and bring in runs_scored; forms basis for ball count & runs conceded.  
-- 2. bowler_wkts CTE  -> count valid wickets per bowler from wicket_taken joined to
--    ball_by_ball, removing run‑outs etc.  
-- 3. best_match CTE   -> within each bowler’s matches count wickets + runs (legal only),
--    rank by most wickets then fewest runs, pick top row, format “wickets‑runs”.  
-- 4. Final SELECT     -> aggregate legal_balls to compute:
--       economy = runs / (balls/6) ; strike = balls / wickets ; attach best_match.  
WITH legal_balls AS (
    SELECT bb.bowler,
           bb.match_id,
           bb.over_id,
           bb.ball_id,
           bb.innings_no,
           bs.runs_scored
    FROM   ball_by_ball   bb
    JOIN   batsman_scored bs
           ON bb.match_id = bs.match_id
          AND bb.over_id  = bs.over_id
          AND bb.ball_id  = bs.ball_id
          AND bb.innings_no = bs.innings_no
    LEFT  JOIN extra_runs er
           ON bb.match_id = er.match_id
          AND bb.over_id  = er.over_id
          AND bb.ball_id  = er.ball_id
          AND bb.innings_no = er.innings_no
    WHERE  er.extra_type IS NULL          -- no extras at all
       OR  er.extra_type NOT IN ('wide','wides','no ball','noball','noballs')  -- ignore wides/no‑balls
),
bowler_wkts AS (
    SELECT bb.bowler,
           COUNT(*) AS total_wkts
    FROM   wicket_taken wt
    JOIN   ball_by_ball bb
           ON wt.match_id   = bb.match_id
          AND wt.over_id    = bb.over_id
          AND wt.ball_id    = bb.ball_id
          AND wt.innings_no = bb.innings_no
    WHERE  wt.kind_out NOT IN ('run out','retired hurt','obstructing the field')
    GROUP  BY bb.bowler
),
best_match AS (
    SELECT bowler,
           printf('%d-%d', wkts_in_match, runs_in_match) AS best_fig
    FROM (
        SELECT bb.bowler,
               bb.match_id,
               COUNT(*)                   AS wkts_in_match,
               SUM(lb.runs_scored)        AS runs_in_match,
               ROW_NUMBER() OVER (PARTITION BY bb.bowler
                                  ORDER BY COUNT(*) DESC,
                                           SUM(lb.runs_scored) ASC) AS rn
        FROM   wicket_taken wt
        JOIN   ball_by_ball bb
               ON wt.match_id   = bb.match_id
              AND wt.over_id    = bb.over_id
              AND wt.ball_id    = bb.ball_id
              AND wt.innings_no = bb.innings_no
        JOIN   legal_balls lb
               ON lb.match_id   = bb.match_id
              AND lb.over_id    = bb.over_id
              AND lb.ball_id    = bb.ball_id
              AND lb.innings_no = bb.innings_no
        WHERE  wt.kind_out NOT IN ('run out','retired hurt','obstructing the field')
        GROUP  BY bb.bowler, bb.match_id
    ) x
    WHERE rn = 1
)
SELECT p.player_name                              AS bowler,
       bw.total_wkts                              AS total_wickets,
       ROUND(SUM(lb.runs_scored)*1.0 / (COUNT(*)/6.0), 2) AS economy_rate,
       ROUND(COUNT(*)*1.0 / bw.total_wkts, 2)      AS strike_rate,
       bm.best_fig                                 AS best_bowling
FROM   legal_balls lb
JOIN   bowler_wkts bw ON lb.bowler = bw.bowler
LEFT   JOIN best_match bm ON lb.bowler = bm.bowler
JOIN   player p ON lb.bowler = p.player_id
GROUP  BY lb.bowler, p.player_name, bw.total_wkts, bm.best_fig
ORDER  BY bw.total_wkts DESC;
