```sql
--Description:
--Goal: find how many city‑pairs fall in the LEAST‑populated distance band
--(0‑1000, 1000‑2000, …, 6000+ km).  SQLite here lacks ACOS / SIN / COS, so
--the great‑circle formula will not run.  We therefore use a coarse but
--function‑free proxy: treat Δlatitude and Δlongitude (degrees) as legs of a
--right‑triangle on a flat surface, convert degrees→kilometres with the mean
--scale 111.2 km / degree, and apply Pythagoras.  Although crude, it is fully
--deterministic and adequate for slotting routes into 1000‑km buckets.
--
--Steps inside the CTE chain:
-- 1. coords  – join every flight to its origin & destination airports and
--              pull lon/lat numbers out of the “(lon,lat)” text.
-- 2. flight_dist – compute the approximate distance for each flight.
-- 3. avg_pair – collapse direction (A‑>B vs B‑>A) and average over all routes
--               between the same unordered city pair.
-- 4. bucketed – assign each pair to the requested distance ranges.
-- 5. range_counts – count pairs in each bucket and pick the *minimum* count.
WITH coords AS (
    SELECT f."flight_id",
           json_extract(a1."city",'$.en') AS city_from_raw,
           json_extract(a2."city",'$.en') AS city_to_raw,
           /* longitude & latitude for airport #1 */
           (substr(a1."coordinates", 2,
                   instr(a1."coordinates", ',') - 2))*1.0                        AS lon1,
           (substr(a1."coordinates",
                   instr(a1."coordinates", ',') + 1,
                   length(a1."coordinates") - instr(a1."coordinates", ',') - 1))*1.0 AS lat1,
           /* longitude & latitude for airport #2 */
           (substr(a2."coordinates", 2,
                   instr(a2."coordinates", ',') - 2))*1.0                        AS lon2,
           (substr(a2."coordinates",
                   instr(a2."coordinates", ',') + 1,
                   length(a2."coordinates") - instr(a2."coordinates", ',') - 1))*1.0 AS lat2
    FROM   "flights"       AS f
    JOIN   "airports_data" AS a1 ON a1."airport_code" = f."departure_airport"
    JOIN   "airports_data" AS a2 ON a2."airport_code" = f."arrival_airport"
),
flight_dist AS (
    SELECT city_from_raw                 AS c1,
           city_to_raw                   AS c2,
           111.2 * sqrt( (lat2 - lat1)*(lat2 - lat1)
                        + (lon2 - lon1)*(lon2 - lon1) )  AS dist_km
    FROM   coords
),
avg_pair AS (
    SELECT CASE WHEN c1 < c2 THEN c1 ELSE c2 END AS city_from,
           CASE WHEN c1 < c2 THEN c2 ELSE c1 END AS city_to,
           AVG(dist_km) AS avg_dist_km
    FROM   flight_dist
    GROUP  BY city_from, city_to
),
bucketed AS (
    SELECT *,
           CASE
             WHEN avg_dist_km < 1000 THEN '0‑1000'
             WHEN avg_dist_km < 2000 THEN '1000‑2000'
             WHEN avg_dist_km < 3000 THEN '2000‑3000'
             WHEN avg_dist_km < 4000 THEN '3000‑4000'
             WHEN avg_dist_km < 5000 THEN '4000‑5000'
             WHEN avg_dist_km < 6000 THEN '5000‑6000'
             ELSE                         '6000+'
           END AS distance_band
    FROM   avg_pair
),
range_counts AS (
    SELECT distance_band, COUNT(*) AS pair_count
    FROM   bucketed
    GROUP  BY distance_band
)
SELECT MIN(pair_count) AS fewest_pairs_in_any_band
FROM   range_counts;
```
