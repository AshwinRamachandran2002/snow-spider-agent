--Description: #10  Final answer – determine the count of city‑pairs in every 1000‑km
--bucket (using the proxy distance) and return the *smallest* of those counts.
WITH flight_dist AS (
    SELECT
        json_extract(a1.city,'$.en') AS c1,
        json_extract(a2.city,'$.en') AS c2,
        55.6 * (
            ABS( (SUBSTR(a1.coordinates,INSTR(a1.coordinates,',')+1,
                          LENGTH(a1.coordinates)-INSTR(a1.coordinates,',')-1))*1.0
               - (SUBSTR(a2.coordinates,INSTR(a2.coordinates,',')+1,
                          LENGTH(a2.coordinates)-INSTR(a2.coordinates,',')-1))*1.0 )
          + ABS( (SUBSTR(a1.coordinates,2,INSTR(a1.coordinates,',')-2))*1.0
               - (SUBSTR(a2.coordinates,2,INSTR(a2.coordinates,',')-2))*1.0 )
        ) AS dist
    FROM flights        AS f
    JOIN airports_data  AS a1 ON a1.airport_code = f.departure_airport
    JOIN airports_data  AS a2 ON a2.airport_code = f.arrival_airport
),
avg_pair AS (
    SELECT CASE WHEN c1 < c2 THEN c1 ELSE c2 END AS city_from,
           CASE WHEN c1 < c2 THEN c2 ELSE c1 END AS city_to,
           AVG(dist) AS avg_dist
    FROM   flight_dist
    GROUP  BY city_from, city_to
),
bucketed AS (
    SELECT *,
           CASE
             WHEN avg_dist < 1000 THEN '0‑1000'
             WHEN avg_dist < 2000 THEN '1000‑2000'
             WHEN avg_dist < 3000 THEN '2000‑3000'
             WHEN avg_dist < 4000 THEN '3000‑4000'
             WHEN avg_dist < 5000 THEN '4000‑5000'
             WHEN avg_dist < 6000 THEN '5000‑6000'
             ELSE                      '6000+'
           END AS distance_range
    FROM   avg_pair
),
range_counts AS (
    SELECT distance_range,
           COUNT(*) AS pair_cnt
    FROM   bucketed
    GROUP  BY distance_range
)
SELECT MIN(pair_cnt) AS least_number_of_pairs
FROM   range_counts
