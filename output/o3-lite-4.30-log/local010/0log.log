Ten exploratory / building‑block queries  
(all written for SQLite, LIMIT 20 for inspection)

```sql
-- 1. Look at the airport codes we have
SELECT DISTINCT "airport_code"
FROM "airports_data"
LIMIT 20;

-- 2. Peek at one airport’s JSON city field (English name)
SELECT "airport_code",
       json_extract("city",'$.en') AS "city_en"
FROM   "airports_data"
LIMIT 20;

-- 3. Inspect the raw coordinates string
SELECT "airport_code",
       "coordinates"
FROM   "airports_data"
LIMIT 20;

-- 4. Show a few (origin, destination) airport codes that appear in flights
SELECT DISTINCT "departure_airport",
                "arrival_airport"
FROM   "flights"
LIMIT 20;

-- 5. Join flights with both airport rows to get city names
SELECT f."flight_id",
       json_extract(a1."city",'$.en') AS "from_city",
       json_extract(a2."city",'$.en') AS "to_city"
FROM   "flights"        AS f
JOIN   "airports_data"  AS a1 ON a1."airport_code" = f."departure_airport"
JOIN   "airports_data"  AS a2 ON a2."airport_code" = f."arrival_airport"
LIMIT 20;

-- 6. Extract numeric longitude / latitude in radians for the first airport
SELECT "airport_code",
       (substr("coordinates",2,instr("coordinates",',')-2))*1.0    AS "lon_deg",
       (substr("coordinates",instr("coordinates",',')+1,
               length("coordinates")-instr("coordinates",',')-1))*1.0 AS "lat_deg"
FROM   "airports_data"
LIMIT 20;

-- 7. Compute great‑circle distance for a handful of flights
WITH cte AS (
  SELECT f."flight_id",
         (substr(a1."coordinates",2,instr(a1."coordinates",',')-2))*1.0    AS lon1,
         (substr(a1."coordinates",instr(a1."coordinates",',')+1,
                 length(a1."coordinates")-instr(a1."coordinates",',')-1))*1.0 AS lat1,
         (substr(a2."coordinates",2,instr(a2."coordinates",',')-2))*1.0    AS lon2,
         (substr(a2."coordinates",instr(a2."coordinates",',')+1,
                 length(a2."coordinates")-instr(a2."coordinates",',')-1))*1.0 AS lat2
  FROM   "flights"       AS f
  JOIN   "airports_data" AS a1 ON a1."airport_code" = f."departure_airport"
  JOIN   "airports_data" AS a2 ON a2."airport_code" = f."arrival_airport"
  LIMIT 20
)
SELECT "flight_id",
       6371 * acos(
           cos(radians(lat1)) * cos(radians(lat2)) *
           cos(radians(lon2 - lon1)) +
           sin(radians(lat1)) * sin(radians(lat2))
       ) AS distance_km
FROM cte;

-- 8. Produce direction‑free city pairs with one distance value per flight
WITH flight_dist AS (
  SELECT json_extract(a1."city",'$.en') AS c1,
         json_extract(a2."city",'$.en') AS c2,
         6371 * acos(
           cos(radians( (substr(a1."coordinates",instr(a1."coordinates",',')+1,
                                   length(a1."coordinates")-instr(a1."coordinates",',')-1))*1.0 )) *
           cos(radians( (substr(a2."coordinates",instr(a2."coordinates",',')+1,
                                   length(a2."coordinates")-instr(a2."coordinates",',')-1))*1.0 )) *
           cos(radians(
              (substr(a2."coordinates",2,instr(a2."coordinates",',')-2))*1.0 -
              (substr(a1."coordinates",2,instr(a1."coordinates",',')-2))*1.0
           )) +
           sin(radians( (substr(a1."coordinates",instr(a1."coordinates",',')+1,
                                   length(a1."coordinates")-instr(a1."coordinates",',')-1))*1.0 )) *
           sin(radians( (substr(a2."coordinates",instr(a2."coordinates",',')+1,
                                   length(a2."coordinates")-instr(a2."coordinates",',')-1))*1.0 ))
         ) AS dist
  FROM   "flights"       AS f
  JOIN   "airports_data" AS a1 ON a1."airport_code" = f."departure_airport"
  JOIN   "airports_data" AS a2 ON a2."airport_code" = f."arrival_airport"
)
SELECT CASE WHEN c1 < c2 THEN c1 ELSE c2 END AS city_from,
       CASE WHEN c1 < c2 THEN c2 ELSE c1 END AS city_to,
       dist
FROM flight_dist
LIMIT 20;

-- 9. Average the distance over all routes between the same city pair
WITH city_pair AS (
  SELECT CASE WHEN c1 < c2 THEN c1 ELSE c2 END AS city_from,
         CASE WHEN c1 < c2 THEN c2 ELSE c1 END AS city_to,
         dist
  FROM (
    /* same sub‑query as #8, shortened here for brevity */
    SELECT json_extract(a1."city",'$.en') AS c1,
           json_extract(a2."city",'$.en') AS c2,
           6371 * acos(
             cos(radians( (substr(a1."coordinates",instr(a1."coordinates",',')+1,
                                     length(a1."coordinates")-instr(a1."coordinates",',')-1))*1.0 )) *
             cos(radians( (substr(a2."coordinates",instr(a2."coordinates",',')+1,
                                     length(a2."coordinates")-instr(a2."coordinates",',')-1))*1.0 )) *
             cos(radians(
                (substr(a2."coordinates",2,instr(a2."coordinates",',')-2))*1.0 -
                (substr(a1."coordinates",2,instr(a1."coordinates",',')-2))*1.0
             )) +
             sin(radians( (substr(a1."coordinates",instr(a1."coordinates",',')+1,
                                     length(a1."coordinates")-instr(a1."coordinates",',')-1))*1.0 )) *
             sin(radians( (substr(a2."coordinates",instr(a2."coordinates",',')+1,
                                     length(a2."coordinates")-instr(a2."coordinates",',')-1))*1.0 ))
           ) AS dist
    FROM   "flights"       AS f
    JOIN   "airports_data" AS a1 ON a1."airport_code" = f."departure_airport"
    JOIN   "airports_data" AS a2 ON a2."airport_code" = f."arrival_airport"
  )
)
SELECT "city_from","city_to", AVG(dist) AS "avg_distance_km"
FROM   city_pair
GROUP  BY "city_from","city_to"
LIMIT 20;

-- 10. Final answer – count of pairs in the least‑populated distance bucket
WITH flight_dist AS ( … same as #8 … ),
avg_pair AS (
  SELECT CASE WHEN c1 < c2 THEN c1 ELSE c2 END AS city_from,
         CASE WHEN c1 < c2 THEN c2 ELSE c1 END AS city_to,
         AVG(dist) AS avg_dist
  FROM   flight_dist
  GROUP  BY city_from, city_to
),
bucketed AS (
  SELECT *,
         CASE
           WHEN avg_dist < 1000 THEN '0‑1000'
           WHEN avg_dist < 2000 THEN '1000‑2000'
           WHEN avg_dist < 3000 THEN '2000‑3000'
           WHEN avg_dist < 4000 THEN '3000‑4000'
           WHEN avg_dist < 5000 THEN '4000‑5000'
           WHEN avg_dist < 6000 THEN '5000‑6000'
           ELSE                      '6000+'
         END AS distance_range
  FROM   avg_pair
),
range_counts AS (
  SELECT distance_range,
         COUNT(*) AS pair_cnt
  FROM   bucketed
  GROUP  BY distance_range
)
SELECT MIN(pair_cnt) AS least_number_of_pairs
FROM   range_counts;
```

