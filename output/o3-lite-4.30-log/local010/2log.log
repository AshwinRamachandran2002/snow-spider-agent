--Description: Compute the great‑circle distance (km) for every scheduled flight leg
--             even though SQRT, POW and ACOS are unavailable.  
--             • Parse each airport’s longitude/latitude from its POINT string.  
--             • For every leg whose departure city differs from its arrival city,
--               build the haversine value h = sin²(Δφ/2)+cosφ₁·cosφ₂·sin²(Δλ/2).  
--             • Obtain √h with six Newton iterations inside a recursive CTE
--               (yₙ₊₁ = (yₙ + h / yₙ)/2).  
--             • Central angle θ = 2·asin(√h); distance = θ·R, where R = 6 371 km.  
--             • Return the first 20 city‑pairs and their distance.  

WITH RECURSIVE
/* --------------------------------------------------------------------
   Airport lookup : code → city , longitude° , latitude°
-------------------------------------------------------------------- */
ap AS (
    SELECT  a.airport_code,
            json_extract(a.city,'$.en')                                              AS city,
            CAST(substr(a.coordinates, 2,
                        instr(a.coordinates, ',')-2)                         AS REAL) AS lon_deg,
            CAST(substr(a.coordinates,
                        instr(a.coordinates, ',')+1,
                        length(a.coordinates) - instr(a.coordinates, ',')-1) AS REAL) AS lat_deg
    FROM   airports_data AS a
),
/* --------------------------------------------------------------------
   Every flight leg (departure ≠ arrival city) with angle deltas
-------------------------------------------------------------------- */
legs AS (
    SELECT  da.city AS dep_city,
            aa.city AS arr_city,
            (aa.lat_deg - da.lat_deg) * 0.017453292519943295            AS dlat,
            (aa.lon_deg - da.lon_deg) * 0.017453292519943295            AS dlon,
            da.lat_deg * 0.017453292519943295                           AS lat1,
            aa.lat_deg * 0.017453292519943295                           AS lat2
    FROM   flights AS f
    JOIN   ap      AS da ON da.airport_code = f.departure_airport
    JOIN   ap      AS aa ON aa.airport_code = f.arrival_airport
    WHERE  da.city <> aa.city
),
/* --------------------------------------------------------------------
   Haversine value h
-------------------------------------------------------------------- */
hvals AS (
    SELECT  dep_city,
            arr_city,
            sin(dlat/2.0)*sin(dlat/2.0) +
            cos(lat1) * cos(lat2) *
            sin(dlon/2.0)*sin(dlon/2.0)                                AS h
    FROM    legs
),
/* --------------------------------------------------------------------
   Newton iteration to approximate √h  (six steps are plenty)
-------------------------------------------------------------------- */
sqrt_iter(dep_city, arr_city, h, y, step) AS (
    SELECT dep_city, arr_city, h, h/2.0 AS y, 0              -- initial guess
    FROM   hvals
    UNION ALL
    SELECT dep_city, arr_city, h,
           (y + h / y) / 2.0  AS y, step + 1                 -- refinement
    FROM   sqrt_iter
    WHERE  step < 5                                          -- total 6 rows (0..5)
),
sqrt_final AS (
    SELECT dep_city, arr_city, y AS sqrt_h
    FROM   sqrt_iter
    WHERE  step = 5                                          -- last iteration
)
/* --------------------------------------------------------------------
   Final distance
-------------------------------------------------------------------- */
SELECT  dep_city,
        arr_city,
        2 * 6371 * asin(sqrt_h)  AS distance_km
FROM    sqrt_final
LIMIT 20;
