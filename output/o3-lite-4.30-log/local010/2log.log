```sql
--Description: one‑step rebuild of step 7 — compute the great‑circle distance (km) for
--             every scheduled flight leg.  The Haversine formula is kept, but the
--             missing SQRT() call is replaced with POW(x, 0.5).  Trigonometric
--             functions (radians, sin, cos, asin) are available in the environment.
--             Only the first 20 legs are displayed so the result set is small.
WITH ap AS (                                                 -- airport → city, lon, lat
    SELECT  a.airport_code,
            json_extract(a.city,'$.en')                                              AS city,
            CAST(substr(a.coordinates, 2,
                        instr(a.coordinates, ',')-2)                         AS REAL) AS lon,
            CAST(substr(a.coordinates,
                        instr(a.coordinates, ',')+1,
                        length(a.coordinates) - instr(a.coordinates, ',')-1) AS REAL) AS lat
    FROM   airports_data AS a
),
legs AS (                                                    -- one row per flight leg
    SELECT  da.city AS dep_city,
            aa.city AS arr_city,
            da.lat  AS dep_lat,  da.lon AS dep_lon,
            aa.lat  AS arr_lat,  aa.lon AS arr_lon
    FROM   flights AS f
    JOIN   ap      AS da ON da.airport_code = f.departure_airport
    JOIN   ap      AS aa ON aa.airport_code = f.arrival_airport
    WHERE  da.city <> aa.city
)
SELECT  dep_city,
        arr_city,
        6371 * 2 *
        asin(
            POW(
                POW( sin( radians(arr_lat - dep_lat) / 2 ), 2 ) +
                cos( radians(dep_lat) ) *
                cos( radians(arr_lat) ) *
                POW( sin( radians(arr_lon - dep_lon) / 2 ), 2 )
            , 0.5)
        ) AS distance_km
FROM    legs
LIMIT 20;
