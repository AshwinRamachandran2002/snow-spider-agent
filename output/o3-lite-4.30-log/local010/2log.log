```sql
--Description: Re‑implement step 7 without the missing SQRT and POW functions.
--             The spherical law‑of‑cosines needs only SIN, COS and ACOS, which are
--             usually available even when SQRT/POW are not.  Airport coordinates
--             are parsed from the POINT text, converted from degrees to radians
--             by multiplication with π/180, then fed into the formula.  The query
--             shows the first 20 legs together with their great‑circle distance
--             in kilometres.
WITH ap AS (                           -- airport → city, longitude, latitude
    SELECT  a.airport_code,
            json_extract(a.city,'$.en')                                              AS city,
            CAST(substr(a.coordinates, 2,
                        instr(a.coordinates, ',')-2)                         AS REAL) AS lon_deg,
            CAST(substr(a.coordinates,
                        instr(a.coordinates, ',')+1,
                        length(a.coordinates) - instr(a.coordinates, ',')-1) AS REAL) AS lat_deg
    FROM   airports_data AS a
),
legs AS (                              -- every scheduled flight leg
    SELECT  da.city AS dep_city,
            aa.city AS arr_city,
            da.lat_deg AS dep_lat_deg, da.lon_deg AS dep_lon_deg,
            aa.lat_deg AS arr_lat_deg, aa.lon_deg AS arr_lon_deg
    FROM   flights AS f
    JOIN   ap      AS da ON da.airport_code = f.departure_airport
    JOIN   ap      AS aa ON aa.airport_code = f.arrival_airport
    WHERE  da.city <> aa.city
)
SELECT  dep_city,
        arr_city,
        6371 * acos(                        -- distance = R · arccos( … )
            sin(dep_lat_deg * 0.017453292519943295) *
            sin(arr_lat_deg * 0.017453292519943295) +
            cos(dep_lat_deg * 0.017453292519943295) *
            cos(arr_lat_deg * 0.017453292519943295) *
            cos((arr_lon_deg - dep_lon_deg) * 0.017453292519943295)
        ) AS distance_km
FROM    legs
LIMIT 20;
