Query:
--Description:  #9  Average distance per unordered city pair
--              Re‑write step 9 so it works with an SQLite build that has *no* SIN/COS/
--              SQRT/POW/ACOS functions.  A crude but usable flat‑earth metric is
--                  distance_km ≈ 111.1 · √( (Δlat°)² + (Δlon°)² )
--              The √ is obtained with six Newton iterations in a recursive CTE.
--              We then average that distance over all legs that connect the same
--              unordered city pair.  The first 20 pairs are returned.
WITH RECURSIVE
ap AS (                                  -- airport → city , lon° , lat°
    SELECT  airport_code,
            json_extract(city,'$.en')                                         AS city,
            CAST(substr(coordinates,2,instr(coordinates,',')-2)       AS REAL) AS lon_deg,
            CAST(substr(coordinates,
                        instr(coordinates,',')+1,
                        length(coordinates)-instr(coordinates,',')-1) AS REAL) AS lat_deg
    FROM   airports_data
),
legs AS (                                -- flight legs, cities alphabetised
    SELECT  CASE WHEN da.city < aa.city THEN da.city ELSE aa.city END AS city1,
            CASE WHEN da.city < aa.city THEN aa.city ELSE da.city END AS city2,
            (aa.lat_deg - da.lat_deg)                                 AS dlat,
            (aa.lon_deg - da.lon_deg)                                 AS dlon
    FROM   flights f
    JOIN   ap da ON da.airport_code = f.departure_airport
    JOIN   ap aa ON aa.airport_code = f.arrival_airport
    WHERE  da.city <> aa.city
),
hvals AS (                               -- h = (Δlat)² + (Δlon)²
    SELECT  city1, city2,
            (dlat*dlat) + (dlon*dlon)                                AS h
    FROM    legs
),
sqrt_iter(city1,city2,h,y,step) AS (     -- Newton √h  (6 iterations)
    SELECT  city1, city2, h, h/2.0, 0 FROM hvals
    UNION ALL
    SELECT  city1, city2, h,
            (y + h / y)/2.0, step+1
    FROM    sqrt_iter
    WHERE   step < 5
),
root AS (
    SELECT  city1, city2, y AS root_h
    FROM    sqrt_iter
    WHERE   step = 5
),
dist AS (
    SELECT  city1,
            city2,
            111.1 * root_h                                            AS distance_km
    FROM    root
)
SELECT  city1,
        city2,
        AVG(distance_km) AS avg_distance_km
FROM    dist
GROUP BY city1, city2
LIMIT 20
