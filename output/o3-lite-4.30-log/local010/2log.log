--Description:
-- Build each scheduled flight leg as an unordered pair of cities (so A–B = B–A) and
-- give an approximate distance (km) using only basic arithmetic, because every trig,
-- power‑ or root‑related function that SQLite normally offers (SIN, COS, SQRT, POW,
-- ACOS, etc.) is absent in this sandbox.  Method:
-- 1.  Extract longitude / latitude in degrees from airports_data.coordinates.
-- 2.  Join the two airports of every flight; alphabetise the two city names so the
--     pair is direction‑independent.
-- 3.  Work in flat‑earth degree space:  h = (Δlat)² + (Δlon)².
-- 4.  Obtain √h with six Newton iterations inside a recursive CTE
--        y₀ = h/2 ;  yₙ₊₁ = (yₙ + h / yₙ) / 2 .
-- 5.  Multiply √h by 111.1 km (≈ km per degree of latitude) to get a rough distance.
-- 6.  Show the first 20 unordered city pairs and that distance.

WITH RECURSIVE
ap AS (                                   -- airport → city , lon° , lat°
    SELECT  airport_code,
            json_extract(city, '$.en')                                        AS city,
            CAST(substr(coordinates, 2,
                        instr(coordinates, ',') - 2)                  AS REAL) AS lon_deg,
            CAST(substr(coordinates,
                        instr(coordinates, ',') + 1,
                        length(coordinates) - instr(coordinates, ',') - 1) AS REAL) AS lat_deg
    FROM    airports_data
),
legs AS (                                 -- flight legs, cities alphabetised
    SELECT  CASE WHEN da.city < aa.city THEN da.city ELSE aa.city END AS city1,
            CASE WHEN da.city < aa.city THEN aa.city ELSE da.city END AS city2,
            (aa.lat_deg - da.lat_deg)                                 AS dlat,
            (aa.lon_deg - da.lon_deg)                                 AS dlon
    FROM    flights  f
    JOIN    ap       da ON da.airport_code = f.departure_airport
    JOIN    ap       aa ON aa.airport_code = f.arrival_airport
    WHERE   da.city <> aa.city
),
hvals AS (                                -- squared planar gap  h = (Δlat)² + (Δlon)²
    SELECT  city1,
            city2,
            (dlat * dlat) + (dlon * dlon)                             AS h
    FROM    legs
),
sqrt_iter(city1, city2, h, y, step) AS (   -- Newton iterations to approximate √h
    SELECT  city1, city2, h,
            CASE WHEN h = 0 THEN 0 ELSE h / 2.0 END                  AS y, 0
    FROM    hvals
    UNION ALL
    SELECT  city1, city2, h,
            CASE WHEN y = 0 THEN 0 ELSE (y + h / y) / 2.0 END        AS y,
            step + 1
    FROM    sqrt_iter
    WHERE   step < 5                                                 -- six passes total
),
sqrt_final AS (
    SELECT  city1, city2, y AS root_h
    FROM    sqrt_iter
    WHERE   step = 5
)
SELECT  city1,
        city2,
        111.1 * root_h                                               AS distance_km
FROM    sqrt_final
LIMIT 20;
