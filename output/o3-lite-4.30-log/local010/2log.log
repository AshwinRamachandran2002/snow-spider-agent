```sql
WITH
-- convert every airport to (city, latitude°, longitude°)
ap AS (
    SELECT
        airport_code,
        json_extract(city,'$.en')                             AS city,
        CAST(substr(coordinates,2,instr(coordinates,',')-2)  AS REAL) AS lon_deg,
        CAST(substr(coordinates,
                    instr(coordinates,',')+1,
                    length(coordinates)-instr(coordinates,',')-1)     AS REAL) AS lat_deg
    FROM airports_data
),
-- every scheduled leg with the two cities in alphabetical order
legs AS (
    SELECT
        CASE WHEN da.city < aa.city THEN da.city ELSE aa.city END AS city1,
        CASE WHEN da.city < aa.city THEN aa.city ELSE da.city END AS city2,
        da.lat_deg AS lat1, da.lon_deg AS lon1,
        aa.lat_deg AS lat2, aa.lon_deg AS lon2
    FROM flights  f
    JOIN ap da ON da.airport_code = f.departure_airport
    JOIN ap aa ON aa.airport_code = f.arrival_airport
    WHERE da.city <> aa.city
),
-- great‑circle distance (Haversine) for each leg
distances AS (
    SELECT
        city1,
        city2,
        6371.0 * 2.0 *
        atan2(
            sqrt( a ),
            sqrt( 1.0 - a )
        ) AS leg_distance
    FROM (
        SELECT
            city1, city2,
            sin( (lat2-lat1) * 0.0174532925199433 / 2.0 )
            * sin( (lat2-lat1) * 0.0174532925199433 / 2.0 )
          + cos( lat1 * 0.0174532925199433 )
            * cos( lat2 * 0.0174532925199433 )
            * sin( (lon2-lon1) * 0.0174532925199433 / 2.0 )
            * sin( (lon2-lon1) * 0.0174532925199433 / 2.0 )              AS a
        FROM legs
    )
),
-- average distance for every unordered city pair
pair_avg AS (
    SELECT
        city1,
        city2,
        AVG(leg_distance) AS avg_distance
    FROM distances
    GROUP BY city1, city2
),
-- bucket the pairs
bucketed AS (
    SELECT
        CASE
            WHEN avg_distance < 1000 THEN '0'
            WHEN avg_distance < 2000 THEN '1000'
            WHEN avg_distance < 3000 THEN '2000'
            WHEN avg_distance < 4000 THEN '3000'
            WHEN avg_distance < 5000 THEN '4000'
            WHEN avg_distance < 6000 THEN '5000'
            ELSE                             '6000+'
        END AS distance_range
    FROM pair_avg
),
-- count pairs per bucket
counts AS (
    SELECT distance_range, COUNT(*) AS pair_cnt
    FROM bucketed
    GROUP BY distance_range
)
SELECT distance_range AS range_with_fewest_pairs,
       pair_cnt       AS pair_count
FROM counts
ORDER BY pair_cnt, distance_range
LIMIT 1;
