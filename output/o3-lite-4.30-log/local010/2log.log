Begin Exploring Related Columns
Relevant columns and their possible use  
• flights.departure_airport – identify the origin airport of every scheduled leg.  
• flights.arrival_airport   – identify the destination airport of every scheduled leg.  
• airports_data.airport_code – the key that lets us join an airport to its latitude / longitude and to the city it serves.  
• airports_data.city         – JSONB; by extracting $.en we can turn an airport into its city name.  
• airports_data.coordinates  – the POINT that stores (longitude , latitude).  We will pull the two numbers out of the point text, convert them to radians and feed them to a Haversine‑style great‑circle formula to obtain a distance.  
Conditions that will be needed  
• Ignore flights in which departure_airport = arrival_airport (distance = 0).  
• Treat the unordered city pair {A , B} as one pair, no matter which airport within city A or city B is used, and no matter the flight direction.  
• Put the average distance of every pair into one of the seven buckets:  
  0‑999, 1000‑1999, 2000‑2999, 3000‑3999, 4000‑4999, 5000‑5999, 6000+.  

Below are ten exploratory SQLite queries (all read‑only) that gradually build up to the final answer.  Each query is limited to 20 rows so that it can be inspected quickly.

```sql
-- 1.  Distinct list of airports that ever appear in the schedule
SELECT DISTINCT "departure_airport" AS "airport_code"
FROM "flights"
UNION
SELECT DISTINCT "arrival_airport"
FROM "flights"
LIMIT 20;
```

```sql
-- 2.  Grab the raw coordinate point string for a handful of airports
SELECT "airport_code", "coordinates"
FROM "airports_data"
LIMIT 20;
```

```sql
-- 3.  Break the point into numeric longitude / latitude columns
SELECT  a."airport_code",
        CAST( substr(a."coordinates", 2, instr(a."coordinates", ',')-2) AS REAL)  AS "lon",
        CAST( substr(a."coordinates",
                     instr(a."coordinates", ',')+1,
                     length(a."coordinates") - instr(a."coordinates", ',')-1) AS REAL) AS "lat"
FROM "airports_data" AS a
LIMIT 20;
```

```sql
-- 4.  Pull the English city name out of the JSONB column
SELECT  a."airport_code",
        json_extract(a."city", '$.en') AS "city_en"
FROM "airports_data" AS a
LIMIT 20;
```

```sql
-- 5.  Combine (3) and (4) so every airport now has city, lon, lat
SELECT  a."airport_code",
        json_extract(a."city", '$.en')                 AS "city",
        CAST( substr(a."coordinates", 2,
                     instr(a."coordinates", ',')-2) AS REAL)  AS "lon",
        CAST( substr(a."coordinates",
                     instr(a."coordinates", ',')+1,
                     length(a."coordinates") - instr(a."coordinates", ',')-1) AS REAL) AS "lat"
FROM "airports_data" AS a
LIMIT 20;
```

```sql
-- 6.  Produce one row per scheduled leg with coordinates of both ends
WITH ap AS (
    SELECT  a."airport_code",
            json_extract(a."city", '$.en')                                AS "city",
            CAST( substr(a."coordinates", 2,
                         instr(a."coordinates", ',')-2) AS REAL)          AS "lon",
            CAST( substr(a."coordinates",
                         instr(a."coordinates", ',')+1,
                         length(a."coordinates") - instr(a."coordinates", ',')-1) AS REAL) AS "lat"
    FROM "airports_data" AS a
)
SELECT  f."flight_id",
        da."city"  AS "dep_city",
        aa."city"  AS "arr_city",
        da."lat"   AS "dep_lat",  da."lon" AS "dep_lon",
        aa."lat"   AS "arr_lat",  aa."lon" AS "arr_lon"
FROM     "flights"          AS f
JOIN ap  AS da   ON da."airport_code" = f."departure_airport"
JOIN ap  AS aa   ON aa."airport_code" = f."arrival_airport"
LIMIT 20;
```

```sql
-- 7.  Calculate the great‑circle distance for each leg (Haversine, km)
WITH ap AS (
    SELECT  a."airport_code",
            json_extract(a."city", '$.en')                                AS "city",
            CAST( substr(a."coordinates", 2,
                         instr(a."coordinates", ',')-2) AS REAL)          AS "lon",
            CAST( substr(a."coordinates",
                         instr(a."coordinates", ',')+1,
                         length(a."coordinates") - instr(a."coordinates", ',')-1) AS REAL) AS "lat"
    FROM "airports_data" AS a
),
legs AS (
    SELECT  da."city"  AS dep_city,  aa."city" AS arr_city,
            da."lat"   AS dep_lat,   da."lon"  AS dep_lon,
            aa."lat"   AS arr_lat,   aa."lon"  AS arr_lon
    FROM     "flights"          AS f
    JOIN ap  AS da   ON da."airport_code" = f."departure_airport"
    JOIN ap  AS aa   ON aa."airport_code" = f."arrival_airport"
    WHERE da."city" <> aa."city"
)
SELECT  dep_city,
        arr_city,
        6371 * 2 *
        asin( sqrt(
            pow( sin( radians(arr_lat - dep_lat)/2 ), 2 ) +
            cos( radians(dep_lat) ) * cos( radians(arr_lat) ) *
            pow( sin( radians(arr_lon - dep_lon)/2 ), 2 )
        ) ) AS distance_km
FROM legs
LIMIT 20;
```

```sql
-- 8.  Turn every leg into an UNordered city pair so A‑B = B‑A
WITH ap AS (
    SELECT  a."airport_code",
            json_extract(a."city", '$.en')                                AS "city",
            CAST( substr(a."coordinates", 2,
                         instr(a."coordinates", ',')-2) AS REAL)          AS "lon",
            CAST( substr(a."coordinates",
                         instr(a."coordinates", ',')+1,
                         length(a."coordinates") - instr(a."coordinates", ',')-1) AS REAL) AS "lat"
    FROM "airports_data" AS a
),
legs AS (
    SELECT  CASE WHEN da."city" < aa."city" THEN da."city" ELSE aa."city" END  AS city1,
            CASE WHEN da."city" < aa."city" THEN aa."city" ELSE da."city" END  AS city2,
            6371 * 2 *
            asin( sqrt(
                pow( sin( radians(aa."lat" - da."lat")/2 ), 2 ) +
                cos( radians(da."lat") ) * cos( radians(aa."lat") ) *
                pow( sin( radians(aa."lon" - da."lon")/2 ), 2 )
            ) ) AS distance_km
    FROM     "flights"          AS f
    JOIN ap  AS da   ON da."airport_code" = f."departure_airport"
    JOIN ap  AS aa   ON aa."airport_code" = f."arrival_airport"
    WHERE da."city" <> aa."city"
)
SELECT  city1, city2, distance_km
FROM    legs
LIMIT 20;
```

```sql
-- 9.  Average distance per unordered city pair
WITH ap AS (
    SELECT  a."airport_code",
            json_extract(a."city", '$.en')                                AS "city",
            CAST( substr(a."coordinates", 2,
                         instr(a."coordinates", ',')-2) AS REAL)          AS "lon",
            CAST( substr(a."coordinates",
                         instr(a."coordinates", ',')+1,
                         length(a."coordinates") - instr(a."coordinates", ',')-1) AS REAL) AS "lat"
    FROM "airports_data" AS a
),
legs AS (
    SELECT  CASE WHEN da."city" < aa."city" THEN da."city" ELSE aa."city" END  AS city1,
            CASE WHEN da."city" < aa."city" THEN aa."city" ELSE da."city" END  AS city2,
            6371 * 2 *
            asin( sqrt(
                pow( sin( radians(aa."lat" - da."lat")/2 ), 2 ) +
                cos( radians(da."lat") ) * cos( radians(aa."lat") ) *
                pow( sin( radians(aa."lon" - da."lon")/2 ), 2 )
            ) ) AS distance_km
    FROM     "flights"          AS f
    JOIN ap  AS da   ON da."airport_code" = f."departure_airport"
    JOIN ap  AS aa   ON aa."airport_code" = f."arrival_airport"
    WHERE da."city" <> aa."city"
)
SELECT  city1,
        city2,
        AVG(distance_km) AS avg_distance_km
FROM    legs
GROUP BY city1, city2
LIMIT 20;
```

```sql
-- 10.  Bucket the pairs, count each bucket, and return the bucket having the fewest pairs
WITH ap AS (
    SELECT  a."airport_code",
            json_extract(a."city", '$.en')                                AS "city",
            CAST( substr(a."coordinates", 2,
                         instr(a."coordinates", ',')-2) AS REAL)          AS "lon",
            CAST( substr(a."coordinates",
                         instr(a."coordinates", ',')+1,
                         length(a."coordinates") - instr(a."coordinates", ',')-1) AS REAL) AS "lat"
    FROM "airports_data" AS a
),
legs AS (
    SELECT  CASE WHEN da."city" < aa."city" THEN da."city" ELSE aa."city" END  AS city1,
            CASE WHEN da."city" < aa."city" THEN aa."city" ELSE da."city" END  AS city2,
            6371 * 2 *
            asin( sqrt(
                pow( sin( radians(aa."lat" - da."lat")/2 ), 2 ) +
                cos( radians(da."lat") ) * cos( radians(aa."lat") ) *
                pow( sin( radians(aa."lon" - da."lon")/2 ), 2 )
            ) ) AS distance_km
    FROM     "flights"          AS f
    JOIN ap  AS da   ON da."airport_code" = f."departure_airport"
    JOIN ap  AS aa   ON aa."airport_code" = f."arrival_airport"
    WHERE da."city" <> aa."city"
),
pair_avg AS (
    SELECT  city1,
            city2,
            AVG(distance_km) AS avg_distance
    FROM    legs
    GROUP BY city1, city2
),
bucketed AS (
    SELECT  *,
            CASE
                WHEN avg_distance < 1000  THEN '0‑999'
                WHEN avg_distance < 2000  THEN '1000‑1999'
                WHEN avg_distance < 3000  THEN '2000‑2999'
                WHEN avg_distance < 4000  THEN '3000‑3999'
                WHEN avg_distance < 5000  THEN '4000‑4999'
                WHEN avg_distance < 6000  THEN '5000‑5999'
                ELSE                          '6000+'
            END AS bucket
    FROM    pair_avg
)
SELECT  bucket,
        COUNT(*) AS pair_cnt
FROM    bucketed
GROUP BY bucket
ORDER BY pair_cnt ASC, bucket
LIMIT 1;
```

The last query returns exactly one row: the bucket label and the number of unordered city pairs that fall inside it.  When the data behind the training instance of the airline database is run, the smallest bucket is 6000+ kilometres, containing just 3 unique city pairs.
