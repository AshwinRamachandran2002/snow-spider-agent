--Description:  #10  Bucket unordered city pairs by average distance and return
--              the bucket that has the fewest pairs.  Uses the same flat‑earth
--              distance approximation and Newton √ method as in #9.
WITH RECURSIVE
ap AS (
    SELECT  airport_code,
            json_extract(city,'$.en')                                         AS city,
            CAST(substr(coordinates,2,instr(coordinates,',')-2)       AS REAL) AS lon_deg,
            CAST(substr(coordinates,
                        instr(coordinates,',')+1,
                        length(coordinates)-instr(coordinates,',')-1) AS REAL) AS lat_deg
    FROM   airports_data
),
legs AS (
    SELECT  CASE WHEN da.city < aa.city THEN da.city ELSE aa.city END AS city1,
            CASE WHEN da.city < aa.city THEN aa.city ELSE da.city END AS city2,
            (aa.lat_deg - da.lat_deg)                                 AS dlat,
            (aa.lon_deg - da.lon_deg)                                 AS dlon
    FROM   flights f
    JOIN   ap da ON da.airport_code = f.departure_airport
    JOIN   ap aa ON aa.airport_code = f.arrival_airport
    WHERE  da.city <> aa.city
),
hvals AS (
    SELECT  city1, city2,
            (dlat*dlat) + (dlon*dlon)                                AS h
    FROM    legs
),
sqrt_iter(city1,city2,h,y,step) AS (
    SELECT  city1, city2, h, h/2.0, 0 FROM hvals
    UNION ALL
    SELECT  city1, city2, h,
            (y + h / y)/2.0, step+1
    FROM    sqrt_iter
    WHERE   step < 5
),
root AS (
    SELECT  city1, city2, y AS root_h
    FROM    sqrt_iter
    WHERE   step = 5
),
pair_avg AS (                            -- average distance per unordered pair
    SELECT  city1,
            city2,
            AVG(111.1 * root_h) AS avg_distance
    FROM    root
    GROUP BY city1, city2
),
bucketed AS (                            -- put into 7 range buckets
    SELECT  *,
            CASE
                WHEN avg_distance < 1000 THEN '0-999'
                WHEN avg_distance < 2000 THEN '1000-1999'
                WHEN avg_distance < 3000 THEN '2000-2999'
                WHEN avg_distance < 4000 THEN '3000-3999'
                WHEN avg_distance < 5000 THEN '4000-4999'
                WHEN avg_distance < 6000 THEN '5000-5999'
                ELSE                         '6000+'
            END AS bucket
    FROM    pair_avg
)
SELECT  bucket,
        COUNT(*) AS pair_cnt
FROM    bucketed
GROUP BY bucket
ORDER BY pair_cnt ASC, bucket
LIMIT 1
