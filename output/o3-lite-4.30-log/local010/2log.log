--Description:
-- Goal: list flight legs as UNordered city pairs (so Moscow–Sochi = Sochi–Moscow)
--       and give the great‑circle distance for each leg, even though SQLite here
--       lacks SQRT, POW and ACOS.  Plan:
--   1. Extract every airport’s longitude/latitude (degrees) from the text POINT in
--      airports_data, then convert to radians with the factor π/180.
--   2. Join the two airports of every scheduled flight leg whose cities differ.
--      Put the two city strings in alphabetical order to make the pair direction‑free.
--   3. Compute the haversine value
--         h = sin²(Δφ/2) + cos φ1 · cos φ2 · sin²(Δλ/2).
--   4. Obtain √h by six Newton iterations inside a recursive CTE
--         y₀ = h/2,   yₙ₊₁ = (yₙ + h / yₙ)/2.
--   5. Central angle θ = 2·asin(√h); distance = θ·R with R = 6 371 km.
--   6. Show the first 20 unordered city pairs and their distance in km.

WITH RECURSIVE
ap AS (                                    -- airport → city, lon°, lat°
    SELECT  airport_code,
            json_extract(city, '$.en')                                           AS city,
            CAST(substr(coordinates, 2,
                        instr(coordinates, ',') - 2)                     AS REAL) AS lon_deg,
            CAST(substr(coordinates,
                        instr(coordinates, ',') + 1,
                        length(coordinates) - instr(coordinates, ',') - 1) AS REAL) AS lat_deg
    FROM    airports_data
),
legs AS (                                   -- every flight leg, cities alphabetised
    SELECT  CASE WHEN da.city < aa.city THEN da.city ELSE aa.city END   AS city1,
            CASE WHEN da.city < aa.city THEN aa.city ELSE da.city END   AS city2,
            (aa.lat_deg - da.lat_deg) * 0.017453292519943295            AS dlat,
            (aa.lon_deg - da.lon_deg) * 0.017453292519943295            AS dlon,
            da.lat_deg * 0.017453292519943295                           AS lat1,
            aa.lat_deg * 0.017453292519943295                           AS lat2
    FROM    flights  f
    JOIN    ap       da ON da.airport_code = f.departure_airport
    JOIN    ap       aa ON aa.airport_code = f.arrival_airport
    WHERE   da.city <> aa.city
),
hvals AS (                                  -- haversine h
    SELECT  city1,
            city2,
            sin(dlat/2.0) * sin(dlat/2.0) +
            cos(lat1) * cos(lat2) *
            sin(dlon/2.0) * sin(dlon/2.0)                        AS h
    FROM    legs
),
sqrt_iter(city1, city2, h, y, step) AS (    -- Newton iterations for √h (6 steps)
    SELECT  city1, city2, h, h/2.0 AS y, 0
    FROM    hvals
    UNION ALL
    SELECT  city1, city2, h,
            (y + h / y) / 2.0, step + 1
    FROM    sqrt_iter
    WHERE   step < 5
),
sqrt_final AS (                              -- final √h
    SELECT  city1, city2, y AS root_h
    FROM    sqrt_iter
    WHERE   step = 5
)
SELECT  city1,
        city2,
        2 * 6371 * asin(root_h)                AS distance_km
FROM    sqrt_final
LIMIT 20;
