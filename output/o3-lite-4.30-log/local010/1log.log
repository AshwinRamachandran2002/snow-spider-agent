Begin Exploring Related Columns
Relevant tables / columns and how they will be used

airports_data  
• airport_code : join key to flights  
• city         : json; extract the English city name for every airport  
• coordinates  : point text; split into longitude/latitude to measure distance  

flights  
• departure_airport : join to airports_data.airport_code  
• arrival_airport   : join to airports_data.airport_code  
• (any WHERE status = 'Scheduled' if you want only planned flights, etc.)

Typical conditions you might need  
• json_extract(a.city,'$.en') IS NOT NULL               -- be sure the city field exists  
• f.departure_airport <> f.arrival_airport              -- ignore “same‑airport” legs  
• distance > 0 AND distance <= 1000, 1000< …           -- bucket by distance ranges  
• HAVING COUNT(*) > 1                                   -- only city pairs that have flights, etc.


Ten exploratory SQLite queries (all limited to 20 rows)

```sql
-- 1) List 20 distinct English‑spelled cities that have airports
SELECT DISTINCT json_extract(a.city,'$.en') AS city_en
FROM airports_data AS a
WHERE json_extract(a.city,'$.en') IS NOT NULL
LIMIT 20;
```

```sql
-- 2) Look at raw coordinate strings for a handful of airports
SELECT a.airport_code,
       a.coordinates
FROM airports_data AS a
LIMIT 20;
```

```sql
-- 3) Parse longitude / latitude from the “point” text (first 20 rows)
SELECT a.airport_code,
       CAST(substr(a.coordinates, 2, instr(a.coordinates, ',')-2) AS REAL)  AS longitude,
       CAST(substr(a.coordinates, instr(a.coordinates, ',')+1,
                   length(a.coordinates) - instr(a.coordinates, ',') - 1) AS REAL) AS latitude
FROM airports_data AS a
LIMIT 20;
```

```sql
-- 4) Show 20 flights together with their departure / arrival city names
SELECT f.flight_no,
       json_extract(ad.city,'$.en') AS dep_city,
       json_extract(aa.city,'$.en') AS arr_city
FROM flights AS f
JOIN airports_data AS ad ON ad.airport_code = f.departure_airport
JOIN airports_data AS aa ON aa.airport_code = f.arrival_airport
LIMIT 20;
```

```sql
-- 5) Get the first 20 different origin‑destination city pairs (direction kept)
SELECT DISTINCT
       json_extract(ad.city,'$.en') AS dep_city,
       json_extract(aa.city,'$.en') AS arr_city
FROM flights AS f
JOIN airports_data AS ad ON ad.airport_code = f.departure_airport
JOIN airports_data AS aa ON aa.airport_code = f.arrival_airport
WHERE f.departure_airport <> f.arrival_airport
LIMIT 20;
```

```sql
-- 6) Count how many flights exist for each ordered city pair (top 20)
SELECT
       json_extract(ad.city,'$.en') AS dep_city,
       json_extract(aa.city,'$.en') AS arr_city,
       COUNT(*) AS flights_cnt
FROM flights AS f
JOIN airports_data AS ad ON ad.airport_code = f.departure_airport
JOIN airports_data AS aa ON aa.airport_code = f.arrival_airport
WHERE f.departure_airport <> f.arrival_airport
GROUP BY dep_city, arr_city
ORDER BY flights_cnt DESC
LIMIT 20;
```

```sql
-- 7) Convert ordered pairs to UNordered pairs (A–B = B–A) and look at them
SELECT DISTINCT
       CASE
            WHEN dep_city < arr_city THEN dep_city
            ELSE arr_city
       END AS city1,
       CASE
            WHEN dep_city < arr_city THEN arr_city
            ELSE dep_city
       END AS city2
FROM (
     SELECT
           json_extract(ad.city,'$.en') AS dep_city,
           json_extract(aa.city,'$.en') AS arr_city
     FROM flights AS f
     JOIN airports_data AS ad ON ad.airport_code = f.departure_airport
     JOIN airports_data AS aa ON aa.airport_code = f.arrival_airport
     WHERE f.departure_airport <> f.arrival_airport
) AS q
LIMIT 20;
```

```sql
-- 8) Compute great‑circle distance for every flight (approx.; first 20 rows)
--    (SQLite has trig functions SIN/COS/ACOS if compiled with math; if not,
--    treat this as conceptual.)
SELECT
       f.flight_no,
       json_extract(ad.city,'$.en') AS dep_city,
       json_extract(aa.city,'$.en') AS arr_city,
       6371 * 2 * 
       ACOS(
          COS(RADIANS(dep_lat)) * COS(RADIANS(arr_lat)) *
          COS(RADIANS(arr_lon) - RADIANS(dep_lon)) +
          SIN(RADIANS(dep_lat)) * SIN(RADIANS(arr_lat))
       ) AS km_distance
FROM (
     SELECT f.flight_no,
            d.coordinates  AS dep_pt,
            a.coordinates  AS arr_pt,
            CAST(substr(d.coordinates, 2, instr(d.coordinates, ',')-2) AS REAL)  AS dep_lon,
            CAST(substr(d.coordinates, instr(d.coordinates, ',')+1,
                        length(d.coordinates) - instr(d.coordinates, ',') - 1) AS REAL) AS dep_lat,
            CAST(substr(a.coordinates, 2, instr(a.coordinates, ',')-2) AS REAL)  AS arr_lon,
            CAST(substr(a.coordinates, instr(a.coordinates, ',')+1,
                        length(a.coordinates) - instr(a.coordinates, ',') - 1) AS REAL) AS arr_lat
     FROM flights AS f
     JOIN airports_data AS d ON d.airport_code = f.departure_airport
     JOIN airports_data AS a ON a.airport_code = f.arrival_airport
     WHERE f.departure_airport <> f.arrival_airport
) AS sub
JOIN flights AS f ON f.flight_no = sub.flight_no
JOIN airports_data AS ad ON ad.airport_code = f.departure_airport
JOIN airports_data AS aa ON aa.airport_code = f.arrival_airport
LIMIT 20;
```

```sql
-- 9) Average the distance across ALL flights for every unordered city pair,
--    then bucket the average into the requested 0‑1000‑…‑6000+ ranges.
SELECT
       city1,
       city2,
       AVG(km_distance) AS avg_km,
       CASE
            WHEN AVG(km_distance) <=   0 THEN '0'
            WHEN AVG(km_distance) <=1000 THEN '0‑1000'
            WHEN AVG(km_distance) <=2000 THEN '1000‑2000'
            WHEN AVG(km_distance) <=3000 THEN '2000‑3000'
            WHEN AVG(km_distance) <=4000 THEN '3000‑4000'
            WHEN AVG(km_distance) <=5000 THEN '4000‑5000'
            WHEN AVG(km_distance) <=6000 THEN '5000‑6000'
            ELSE                         '6000+'
       END AS dist_range
FROM (
     -- (Use the sub‑query of #8 to get km_distance per flight here)
) AS flights_with_km
GROUP BY city1, city2
LIMIT 20;
```

```sql
-- 10) Finally, count how many unique city pairs fall into each distance bucket
--     and find the bucket that has the minimum count (the exact answer asked).
WITH pair_ranges AS (
     SELECT
            CASE WHEN city1 < city2 THEN city1 ELSE city2 END AS c1,
            CASE WHEN city1 < city2 THEN city2 ELSE city1 END AS c2,
            dist_range
     FROM (
          -- same aggregation as in query #9
     )
)
SELECT dist_range,
       COUNT(*) AS pairs_in_range
FROM pair_ranges
GROUP BY dist_range
ORDER BY pairs_in_range ASC
LIMIT 20;
```

These ten queries progress from simple exploration of city names and coordinates, through construction of unordered city‑pairs, distance calculations, bucketing those distances, and finally identifying the distance bucket that contains the fewest unique city pairs.
