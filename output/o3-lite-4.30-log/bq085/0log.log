  – value : 2020 population value to be turned into “per‑100 000” rates  
  
Key conditions that will show up in the queries  
  – date = '2020‑04‑20'  
  – country_region IN ('US','France','China','Italy','Spain','Germany','Iran')  
  – indicator_code = 'SP.POP.TOTL'  AND year = 2020  
  – country_name IN ('United States','France','China','Italy','Spain','Germany','Iran, Islamic Rep.')  

Ten step‑by‑step exploration queries
```sql
--1. Description: Quick look at raw JHU COVID‑19 rows
SELECT *
FROM `bigquery-public-data.covid19_jhu_csse.summary`
LIMIT 20;

--2. Description: Distinct report dates available in the JHU table
SELECT DISTINCT `date`
FROM `bigquery-public-data.covid19_jhu_csse.summary`
ORDER BY `date`
LIMIT 20;

--3. Description: Distinct country names as written in the JHU table
SELECT DISTINCT country_region
FROM `bigquery-public-data.covid19_jhu_csse.summary`
ORDER BY country_region
LIMIT 20;

--4. Description: Confirmed cases for the United States on 2020‑04‑20
SELECT country_region, SUM(confirmed) AS confirmed_cases
FROM `bigquery-public-data.covid19_jhu_csse.summary`
WHERE `date` = '2020-04-20'
  AND country_region = 'US'
GROUP BY country_region
LIMIT 20;

--5. Description: Confirmed cases on 2020‑04‑20 for the seven required countries
SELECT country_region, SUM(confirmed) AS confirmed_cases
FROM `bigquery-public-data.covid19_jhu_csse.summary`
WHERE `date` = '2020-04-20'
  AND country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
GROUP BY country_region
ORDER BY confirmed_cases DESC
LIMIT 20;

--6. Description: Inspect 2020 population records in the World Bank file
SELECT *
FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
WHERE indicator_code = 'SP.POP.TOTL'
  AND year = 2020
LIMIT 20;

--7. Description: Pull the 2020 populations for the seven target countries
SELECT country_name, value AS population_2020
FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
WHERE indicator_code = 'SP.POP.TOTL'
  AND year = 2020
  AND country_name IN ('United States','France','China','Italy','Spain','Germany','Iran, Islamic Rep.')
LIMIT 20;

--8. Description: Build a tiny mapping table & preview how names will line up
WITH pop AS (
  SELECT
    CASE
      WHEN country_name = 'United States'     THEN 'US'
      WHEN country_name = 'Iran, Islamic Rep.' THEN 'Iran'
      ELSE country_name
    END AS country_region,
    value AS population_2020
  FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
  WHERE indicator_code = 'SP.POP.TOTL'
    AND year = 2020
    AND country_name IN ('United States','France','China','Italy','Spain','Germany','Iran, Islamic Rep.')
)
SELECT *
FROM pop
LIMIT 20;

--9. Description: Join COVID totals with population and compute cases per 100 000
WITH covid AS (
  SELECT country_region,
         SUM(confirmed) AS confirmed_cases
  FROM `bigquery-public-data.covid19_jhu_csse.summary`
  WHERE `date` = '2020-04-20'
    AND country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country_region
),
pop AS (
  SELECT
    CASE
      WHEN country_name = 'United States'     THEN 'US'
      WHEN country_name = 'Iran, Islamic Rep.' THEN 'Iran'
      ELSE country_name
    END AS country_region,
    value AS population_2020
  FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
  WHERE indicator_code = 'SP.POP.TOTL'
    AND year = 2020
    AND country_name IN ('United States','France','China','Italy','Spain','Germany','Iran, Islamic Rep.')
)
SELECT
  c.country_region,
  c.confirmed_cases,
  p.population_2020,
  ROUND( (c.confirmed_cases / p.population_2020) * 100000 , 2) AS cases_per_100k
FROM covid AS c
JOIN pop   AS p USING (country_region)
ORDER BY confirmed_cases DESC
LIMIT 20;

--10. Description: Final concise query returning exactly the requested metrics
WITH covid AS (
  SELECT country_region,
         SUM(confirmed) AS confirmed_cases
  FROM `bigquery-public-data.covid19_jhu_csse.summary`
  WHERE `date` = '2020-04-20'
    AND country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country_region
),
pop AS (
  SELECT
    CASE
      WHEN country_name = 'United States'     THEN 'US'
      WHEN country_name = 'Iran, Islamic Rep.' THEN 'Iran'
      ELSE country_name
    END AS country_region,
    value AS population_2020
  FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
  WHERE indicator_code = 'SP.POP.TOTL'
    AND year = 2020
    AND country_name IN ('United States','France','China','Italy','Spain','Germany','Iran, Islamic Rep.')
)
SELECT
  c.country_region                    AS country,
  c.confirmed_cases                   AS confirmed_as_of_2020_04_20,
  ROUND( (c.confirmed_cases / p.population_2020) * 100000 , 2) AS cases_per_100k
FROM covid AS c
JOIN pop   AS p USING (country_region)
ORDER BY confirmed_as_of_2020_04_20 DESC
LIMIT 20;
