Begin Exploring Related Columns
Relevant columns and how we will use them  

Match."season": to group matches by season.  
Match."home_team_api_id": team identifier when playing at home.  
Match."away_team_api_id": team identifier when playing away.  
Match."home_team_goal": goals scored by the home side (part of a team’s season total).  
Match."away_team_goal": goals scored by the away side (part of a team’s season total).  
Team."team_api_id": stable key that lets us attach a readable club name if we wish.  
Team."team_long_name": optional for readability when checking results.

Typical filter / join conditions  

• Match."home_team_api_id" IS NOT NULL OR Match."away_team_api_id" IS NOT NULL  
• When joining Team, use Match."home_team_api_id" = Team."team_api_id" (or the away key).  

Below are 10 exploratory‑to‑final queries (each capped with LIMIT 20) that gradually build the logic needed to get “the median of the highest season‑goal total achieved by every team”.

```sql
-- 1) Distinct list of seasons present in the Match table
SELECT DISTINCT "season"
FROM "Match"
ORDER BY "season"
LIMIT 20;
```

```sql
-- 2) Distinct teams and their long names
SELECT DISTINCT "team_api_id", "team_long_name"
FROM "Team"
ORDER BY "team_api_id"
LIMIT 20;
```

```sql
-- 3) A quick look at goals in raw Match rows
SELECT "season",
       "home_team_api_id",
       "away_team_api_id",
       "home_team_goal",
       "away_team_goal"
FROM "Match"
ORDER BY RANDOM()
LIMIT 20;
```

```sql
-- 4) Home‑side goals aggregated by season & team
SELECT "season",
       "home_team_api_id"  AS "team_api_id",
       SUM("home_team_goal") AS "home_goals"
FROM "Match"
GROUP BY "season", "home_team_api_id"
ORDER BY "home_goals" DESC
LIMIT 20;
```

```sql
-- 5) Away‑side goals aggregated by season & team
SELECT "season",
       "away_team_api_id"  AS "team_api_id",
       SUM("away_team_goal") AS "away_goals"
FROM "Match"
GROUP BY "season", "away_team_api_id"
ORDER BY "away_goals" DESC
LIMIT 20;
```

```sql
-- 6) Total goals (home + away) per team per season
SELECT "season",
       "team_api_id",
       SUM("goals") AS "season_goals"
FROM (
        -- home slice
        SELECT "season",
               "home_team_api_id" AS "team_api_id",
               "home_team_goal"   AS "goals"
        FROM "Match"
        UNION ALL
        -- away slice
        SELECT "season",
               "away_team_api_id" AS "team_api_id",
               "away_team_goal"   AS "goals"
        FROM "Match"
) AS g
GROUP BY "season", "team_api_id"
ORDER BY "season_goals" DESC
LIMIT 20;
```

```sql
-- 7) For every club, find the season when it scored the most goals
SELECT "team_api_id",
       MAX("season_goals") AS "max_season_goals"
FROM (
        /* re‑use the season‑totals sub‑query from #6 */
        SELECT "season",
               "team_api_id",
               SUM("goals") AS "season_goals"
        FROM (
                SELECT "season",
                       "home_team_api_id" AS "team_api_id",
                       "home_team_goal"   AS "goals"
                FROM "Match"
                UNION ALL
                SELECT "season",
                       "away_team_api_id" AS "team_api_id",
                       "away_team_goal"   AS "goals"
                FROM "Match"
        )
        GROUP BY "season", "team_api_id"
) 
GROUP BY "team_api_id"
ORDER BY "max_season_goals" DESC
LIMIT 20;
```

```sql
-- 8) Order those “max season” values and attach row numbers for median work
WITH "highest" AS (
     SELECT "team_api_id",
            MAX("season_goals") AS "max_season_goals"
     FROM (
            SELECT "season",
                   "team_api_id",
                   SUM("goals") AS "season_goals"
            FROM (
                    SELECT "season",
                           "home_team_api_id" AS "team_api_id",
                           "home_team_goal"   AS "goals"
                    FROM "Match"
                    UNION ALL
                    SELECT "season",
                           "away_team_api_id" AS "team_api_id",
                           "away_team_goal"   AS "goals"
                    FROM "Match"
            )
            GROUP BY "season", "team_api_id"
     )
     GROUP BY "team_api_id"
)
SELECT "max_season_goals",
       ROW_NUMBER() OVER (ORDER BY "max_season_goals")          AS "rn",
       COUNT(*)     OVER ()                                      AS "cnt"
FROM   "highest"
ORDER BY "max_season_goals"
LIMIT 20;
```

```sql
-- 9) Isolate the exact middle row(s) needed for a median
WITH "highest" AS (
     SELECT "team_api_id",
            MAX("season_goals") AS "max_season_goals"
     FROM (
            SELECT "season",
                   "team_api_id",
                   SUM("goals") AS "season_goals"
            FROM (
                    SELECT "season",
                           "home_team_api_id" AS "team_api_id",
                           "home_team_goal"   AS "goals"
                    FROM "Match"
                    UNION ALL
                    SELECT "season",
                           "away_team_api_id" AS "team_api_id",
                           "away_team_goal"   AS "goals"
                    FROM "Match"
            )
            GROUP BY "season", "team_api_id"
     )
     GROUP BY "team_api_id"
),
"ordered" AS (
     SELECT "max_season_goals",
            ROW_NUMBER() OVER (ORDER BY "max_season_goals") AS "rn",
            COUNT(*)     OVER ()                            AS "cnt"
     FROM   "highest"
)
SELECT "max_season_goals"
FROM   "ordered"
WHERE  "rn" IN ((cnt + 1)/2, (cnt + 2)/2)   -- middle 1 or 2 rows
ORDER BY "rn"
LIMIT 20;
```

```sql
-- 10) FINAL: compute the median of the best‑ever season‑goal totals across teams
WITH "highest" AS (
     SELECT "team_api_id",
            MAX("season_goals") AS "max_season_goals"
     FROM (
            SELECT "season",
                   "team_api_id",
                   SUM("goals") AS "season_goals"
            FROM (
                    SELECT "season",
                           "home_team_api_id" AS "team_api_id",
                           "home_team_goal"   AS "goals"
                    FROM "Match"
                    UNION ALL
                    SELECT "season",
                           "away_team_api_id" AS "team_api_id",
                           "away_team_goal"   AS "goals"
                    FROM "Match"
            )
            GROUP BY "season", "team_api_id"
     )
     GROUP BY "team_api_id"
),
"ordered" AS (
     SELECT "max_season_goals",
            ROW_NUMBER() OVER (ORDER BY "max_season_goals") AS "rn",
            COUNT(*)     OVER ()                            AS "cnt"
     FROM   "highest"
)
SELECT AVG("max_season_goals") AS "median_highest_season_goals"
FROM   "ordered"
WHERE  "rn" IN ((cnt + 1)/2, (cnt + 2)/2)
LIMIT 20;
```

Running the last statement will return a single‑row, single‑column answer: the median number of goals that represents the “middle” of the best‑ever season tallies achieved by every team in the dataset.
