-- 10. FINAL ANSWER  – median of all teams’ best‑ever seasonal goal totals
WITH team_season AS (
  SELECT "home_team_api_id" AS team_id,
         "season",
         SUM("home_team_goal") AS goals
  FROM "Match"
  GROUP BY team_id, "season"
  UNION ALL
  SELECT "away_team_api_id",
         "season",
         SUM("away_team_goal")
  FROM "Match"
  GROUP BY "away_team_api_id", "season"
),
team_best AS (
  SELECT team_id, MAX(goals) AS best_goals
  FROM team_season
  GROUP BY team_id
),
ordered AS (
  SELECT best_goals,
         ROW_NUMBER() OVER (ORDER BY best_goals) AS rn,
         COUNT(*)  OVER ()                             AS cnt
  FROM team_best
)
SELECT AVG(best_goals) AS median_best_season_goals
FROM ordered
WHERE rn IN ( (cnt + 1) / 2, (cnt + 2) / 2 )
