```sql
--Description:
-- Goal: identify the World‑Bank region whose median GDP (constant 2015 US$) is highest.
-- Logic:
--   1.  GDP (constant 2015 US$) values live in world_bank_wdi.indicators_data
--       under indicator_code = 'NY.GDP.MKTP.KD'.
--   2.  Each country’s “region” is stored in world_bank_wdi.country_summary.
--   3.  Join the two tables on country_code so every GDP figure is tagged with its region;
--       ignore rows whose region is NULL (aggregates / special groupings).
--   4.  For each region compute the median using APPROX_QUANTILES(value,2)[OFFSET(1)]
--       (BigQuery’s standard way to get an exact‑enough median without PERCENTILE_CONT).
--   5.  Sort those region‑level medians in descending order and LIMIT 1 to output
--       the single region that has the highest median GDP.
SELECT
  region,
  APPROX_QUANTILES(value, 2)[OFFSET(1)] AS median_gdp_constant_2015_usd
FROM (
  SELECT
    c.region,
    d.value
  FROM `bigquery-public-data.world_bank_wdi.indicators_data` AS d
  JOIN `bigquery-public-data.world_bank_wdi.country_summary`  AS c
        ON d.country_code = c.country_code
  WHERE d.indicator_code = 'NY.GDP.MKTP.KD'   -- GDP (constant 2015 US$)
    AND c.region IS NOT NULL                  -- keep only valid regions
)
GROUP BY region
ORDER BY median_gdp_constant_2015_usd DESC
LIMIT 1;
```
