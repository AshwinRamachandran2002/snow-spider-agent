Begin Exploring Related Columns
Relevant columns & how they may be used

orders  
• order_status : to keep only ‘FINISHED’ orders.  
• order_moment_finished : to know in which month / year the order was finished (or, when functions are not handy, fall back to order_created_month & order_created_year).  
• store_id : will let us reach the hub.  

stores  
• hub_id : foreign key that links a store to its hub.  

hubs  
• hub_id / hub_name : final identification of the hub we must show.  


Typical conditions that will appear  
• o."order_status" = 'FINISHED'  
• strftime('%m', o."order_moment_finished") = '02'  (February)  
• strftime('%m', o."order_moment_finished") = '03'  (March)  
• o."order_moment_finished" IS NOT NULL  


Exploratory → Progressively more complex queries
(Each returns at most 20 rows just to have a look at the data)

```sql
-- 1) What order statuses exist?
SELECT DISTINCT o."order_status"
FROM "orders" AS o
LIMIT 20;
```

```sql
-- 2) Quickly see a few finished orders and their finish‑time stamp
SELECT o."order_id",
       o."order_moment_finished"
FROM   "orders" AS o
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_moment_finished" IS NOT NULL
LIMIT 20;
```

```sql
-- 3) Count finished orders by year & month
SELECT strftime('%Y', o."order_moment_finished")   AS "yr",
       strftime('%m', o."order_moment_finished")   AS "mn",
       COUNT(*)                                    AS "qty"
FROM   "orders" AS o
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_moment_finished" IS NOT NULL
GROUP  BY 1,2
LIMIT 20;
```

```sql
-- 4) See how stores relate to hubs
SELECT s."store_id", s."hub_id", h."hub_name"
FROM   "stores" AS s
JOIN   "hubs"   AS h  ON h."hub_id" = s."hub_id"
LIMIT 20;
```

```sql
-- 5) Finished orders with their hub
SELECT o."order_id",
       h."hub_id",
       h."hub_name",
       o."order_moment_finished"
FROM   "orders" AS o
JOIN   "stores" AS s  ON s."store_id" = o."store_id"
JOIN   "hubs"   AS h  ON h."hub_id"   = s."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_moment_finished" IS NOT NULL
LIMIT 20;
```

```sql
-- 6) Finished orders per hub in February
SELECT h."hub_id",
       h."hub_name",
       COUNT(*) AS feb_finished_orders
FROM   "orders" AS o
JOIN   "stores" AS s ON s."store_id" = o."store_id"
JOIN   "hubs"   AS h ON h."hub_id"   = s."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  strftime('%m', o."order_moment_finished") = '02'
  AND  o."order_moment_finished" IS NOT NULL
GROUP  BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
-- 7) Finished orders per hub in March
SELECT h."hub_id",
       h."hub_name",
       COUNT(*) AS mar_finished_orders
FROM   "orders" AS o
JOIN   "stores" AS s ON s."store_id" = o."store_id"
JOIN   "hubs"   AS h ON h."hub_id"   = s."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  strftime('%m', o."order_moment_finished") = '03'
  AND  o."order_moment_finished" IS NOT NULL
GROUP  BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
-- 8) Combine February & March counts side by side
WITH feb AS (
    SELECT h."hub_id", COUNT(*) AS feb_qty
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    JOIN   "hubs"   h ON h."hub_id"   = s."hub_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  strftime('%m', o."order_moment_finished") = '02'
      AND  o."order_moment_finished" IS NOT NULL
    GROUP BY h."hub_id"
),
mar AS (
    SELECT h."hub_id", COUNT(*) AS mar_qty
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    JOIN   "hubs"   h ON h."hub_id"   = s."hub_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  strftime('%m', o."order_moment_finished") = '03'
      AND  o."order_moment_finished" IS NOT NULL
    GROUP BY h."hub_id"
)
SELECT h."hub_name", feb.feb_qty, mar.mar_qty
FROM   "hubs" h
LEFT   JOIN feb ON feb."hub_id" = h."hub_id"
LEFT   JOIN mar ON mar."hub_id" = h."hub_id"
LIMIT 20;
```

