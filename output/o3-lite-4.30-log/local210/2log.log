--Description: Combine February (month = 2) & March (month = 3) FINISHED‑order counts side by side for each hub.
WITH feb AS (
    SELECT h."hub_id", COUNT(*) AS feb_qty
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    JOIN   "hubs"   h ON h."hub_id"   = s."hub_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  o."order_created_month" = 2
    GROUP BY h."hub_id"
),
mar AS (
    SELECT h."hub_id", COUNT(*) AS mar_qty
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    JOIN   "hubs"   h ON h."hub_id"   = s."hub_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  o."order_created_month" = 3
    GROUP BY h."hub_id"
)
SELECT h."hub_name",
       feb.feb_qty,
       mar.mar_qty
FROM   "hubs" h
LEFT   JOIN feb ON feb."hub_id" = h."hub_id"
LEFT   JOIN mar ON mar."hub_id" = h."hub_id"
LIMIT 20
