Relevant columns and their potential usage

• orders.order_status: to filter only finished orders  
• orders.order_created_month: to isolate February (=2) and March (=3)  
• orders.order_created_year: to be sure we compare the same year (optional)  
• orders.store_id: to link an order to a store  
• stores.hub_id: to link a store to its hub  
• hubs.hub_id / hubs.hub_name: to return the hub that registered the variation  

Typical conditions that may be used

• orders.order_status = 'FINISHED'            -- be sure we are counting finished orders  
• orders.order_created_month IN (2,3)         -- restrict to February and March  
• orders.order_created_year = 2023            -- (example) keep the same year  
• GROUP BY hubs.hub_id, orders.order_created_month  

Below are ten exploratory SQL statements (each limited to 20 rows) that gradually build toward the final answer.

```sql
-- 1. Description: Inspect the list of hubs that exist in the data set
SELECT DISTINCT hub_id, hub_name
FROM hubs
LIMIT 20;
```

```sql
-- 2. Description: What order statuses are present?
SELECT DISTINCT order_status
FROM orders
LIMIT 20;
```

```sql
-- 3. Description: See which months have finished orders
SELECT DISTINCT order_created_year, order_created_month
FROM orders
WHERE order_status = 'FINISHED'
ORDER BY 1,2
LIMIT 20;
```

```sql
-- 4. Description: Sampling the link between orders -> stores -> hubs
SELECT o.order_id,
       o.store_id,
       s.hub_id,
       h.hub_name
FROM   orders  AS o
JOIN   stores  AS s ON s.store_id = o.store_id
JOIN   hubs    AS h ON h.hub_id  = s.hub_id
LIMIT 20;
```

```sql
-- 5. Description: Count finished orders per hub per month (all months)
SELECT s.hub_id,
       h.hub_name,
       o.order_created_month,
       COUNT(*) AS finished_orders
FROM   orders  AS o
JOIN   stores  AS s ON s.store_id = o.store_id
JOIN   hubs    AS h ON h.hub_id  = s.hub_id
WHERE  o.order_status = 'FINISHED'
GROUP  BY s.hub_id, o.order_created_month
ORDER  BY s.hub_id, o.order_created_month
LIMIT 20;
```

```sql
-- 6. Description: Keep only February (2) and March (3)
SELECT s.hub_id,
       h.hub_name,
       o.order_created_month,
       COUNT(*) AS finished_orders
FROM   orders  AS o
JOIN   stores  AS s ON s.store_id = o.store_id
JOIN   hubs    AS h ON h.hub_id  = s.hub_id
WHERE  o.order_status = 'FINISHED'
  AND  o.order_created_month IN (2,3)
GROUP  BY s.hub_id, o.order_created_month
ORDER  BY s.hub_id, o.order_created_month
LIMIT 20;
```

```sql
-- 7. Description: Pivot February vs March counts per hub
SELECT s.hub_id,
       h.hub_name,
       SUM(CASE WHEN o.order_created_month = 2 THEN 1 ELSE 0 END) AS feb_orders,
       SUM(CASE WHEN o.order_created_month = 3 THEN 1 ELSE 0 END) AS mar_orders
FROM   orders  AS o
JOIN   stores  AS s ON s.store_id = o.store_id
JOIN   hubs    AS h ON h.hub_id  = s.hub_id
WHERE  o.order_status = 'FINISHED'
  AND  o.order_created_month IN (2,3)
GROUP  BY s.hub_id
LIMIT 20;
```

```sql
-- 8. Description: Compute percentage increase from February to March
SELECT hub_id,
       hub_name,
       feb_orders,
       mar_orders,
       CASE
           WHEN feb_orders = 0 THEN NULL
           ELSE (mar_orders - feb_orders)*1.0 / feb_orders
       END AS pct_increase
FROM (
     SELECT s.hub_id,
            h.hub_name,
            SUM(CASE WHEN o.order_created_month = 2 THEN 1 ELSE 0 END) AS feb_orders,
            SUM(CASE WHEN o.order_created_month = 3 THEN 1 ELSE 0 END) AS mar_orders
     FROM   orders  AS o
     JOIN   stores  AS s ON s.store_id = o.store_id
     JOIN   hubs    AS h ON h.hub_id  = s.hub_id
     WHERE  o.order_status = 'FINISHED'
       AND  o.order_created_month IN (2,3)
     GROUP  BY s.hub_id
) AS t
LIMIT 20;
```

```sql
-- 9. Description: Retain hubs whose March volume is >20 % higher than February
SELECT hub_id,
       hub_name,
       feb_orders,
       mar_orders,
       ROUND(pct_increase*100,1) AS pct_increase_pct
FROM (
     SELECT s.hub_id,
            h.hub_name,
            SUM(CASE WHEN o.order_created_month = 2 THEN 1 ELSE 0 END) AS feb_orders,
            SUM(CASE WHEN o.order_created_month = 3 THEN 1 ELSE 0 END) AS mar_orders,
            CASE
               WHEN SUM(CASE WHEN o.order_created_month = 2 THEN 1 ELSE 0 END) = 0
               THEN NULL
               ELSE (SUM(CASE WHEN o.order_created_month = 3 THEN 1 ELSE 0 END) -
                     SUM(CASE WHEN o.order_created_month = 2 THEN 1 ELSE 0 END))*1.0 /
                     SUM(CASE WHEN o.order_created_month = 2 THEN 1 ELSE 0 END)
            END AS pct_increase
     FROM   orders  AS o
     JOIN   stores  AS s ON s.store_id = o.store_id
     JOIN   hubs    AS h ON h.hub_id  = s.hub_id
     WHERE  o.order_status = 'FINISHED'
       AND  o.order_created_month IN (2,3)
     GROUP  BY s.hub_id
) AS t
WHERE pct_increase > 0.20
LIMIT 20;
```

```sql
-- 10. Description: FINAL query – list hubs with >20 % February→March growth in finished orders
SELECT DISTINCT hub_name
FROM (
     SELECT s.hub_id,
            h.hub_name,
            SUM(CASE WHEN o.order_created_month = 2 THEN 1 ELSE 0 END) AS feb_orders,
            SUM(CASE WHEN o.order_created_month = 3 THEN 1 ELSE 0 END) AS mar_orders
     FROM   orders  AS o
     JOIN   stores  AS s ON s.store_id = o.store_id
     JOIN   hubs    AS h ON h.hub_id  = s.hub_id
     WHERE  o.order_status = 'FINISHED'
       AND  o.order_created_month IN (2,3)
     GROUP  BY s.hub_id
     HAVING feb_orders > 0
        AND (mar_orders - feb_orders) * 1.0 / feb_orders > 0.20
) AS final
LIMIT 20;
```
