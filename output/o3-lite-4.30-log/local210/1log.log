Begin Exploring Related Columns
Relevant columns and their possible use  
• hubs.hub_id / hubs.hub_name : hub identifier & name to be shown in the result  
• stores.hub_id               : links every store to its hub  
• stores.store_id             : needed to join stores ↔ orders  
• orders.store_id             : links every order to its store (and indirectly to its hub)  
• orders.order_status         : filter only ‘FINISHED’ orders  
• orders.order_created_month  : filter Feb (2) vs Mar (3)  
• orders.order_created_year   : (optional) keep the same year if dataset has many years  

Typical conditions  
• orders.order_status = 'FINISHED'  
• orders.order_created_month IN (2,3)  
• (if necessary) orders.order_created_year = 2021  

Below are 10 exploratory‑to‑final SQL queries (each limited to 20 rows) that gradually lead to the answer “which hubs grew >20 % in finished orders from February to March”.

```sql
-- 1. Distinct order statuses – verify the keyword for finished orders
SELECT DISTINCT "order_status"
FROM "orders"
LIMIT 20;
```

```sql
-- 2. Sample of finished orders created in February
SELECT *
FROM "orders"
WHERE "order_status" = 'FINISHED'
  AND "order_created_month" = 2
LIMIT 20;
```

```sql
-- 3. Monthly count of finished orders (all hubs together)
SELECT "order_created_year",
       "order_created_month",
       COUNT(*) AS "num_finished"
FROM   "orders"
WHERE  "order_status" = 'FINISHED'
GROUP  BY "order_created_year","order_created_month"
ORDER  BY "order_created_year","order_created_month"
LIMIT 20;
```

```sql
-- 4. Show how each finished order maps to its hub
SELECT o."order_id",
       s."hub_id",
       o."order_created_month",
       o."order_status"
FROM   "orders"  AS o
JOIN   "stores"  AS s ON o."store_id" = s."store_id"
WHERE  o."order_status" = 'FINISHED'
LIMIT 20;
```

```sql
-- 5. Finished‑order counts by hub for February
SELECT s."hub_id",
       COUNT(*) AS "finished_feb"
FROM   "orders" AS o
JOIN   "stores" AS s ON o."store_id" = s."store_id"
WHERE  o."order_status"        = 'FINISHED'
  AND  o."order_created_month" = 2
GROUP  BY s."hub_id"
LIMIT 20;
```

```sql
-- 6. Finished‑order counts by hub for March
SELECT s."hub_id",
       COUNT(*) AS "finished_mar"
FROM   "orders" AS o
JOIN   "stores" AS s ON o."store_id" = s."store_id"
WHERE  o."order_status"        = 'FINISHED'
  AND  o."order_created_month" = 3
GROUP  BY s."hub_id"
LIMIT 20;
```

```sql
-- 7. Combine Feb & Mar counts plus percentage growth for every hub
SELECT feb."hub_id",
       feb."finished_feb",
       mar."finished_mar",
       ( (mar."finished_mar" - feb."finished_feb") * 1.0 / feb."finished_feb" ) AS "perc_growth"
FROM ( SELECT s."hub_id", COUNT(*) AS "finished_feb"
       FROM   "orders" AS o
       JOIN   "stores" AS s ON o."store_id" = s."store_id"
       WHERE  o."order_status" = 'FINISHED'
         AND  o."order_created_month" = 2
       GROUP  BY s."hub_id" ) AS feb
JOIN ( SELECT s."hub_id", COUNT(*) AS "finished_mar"
       FROM   "orders" AS o
       JOIN   "stores" AS s ON o."store_id" = s."store_id"
       WHERE  o."order_status" = 'FINISHED'
         AND  o."order_created_month" = 3
       GROUP  BY s."hub_id" ) AS mar
     ON feb."hub_id" = mar."hub_id"
LIMIT 20;
```

```sql
-- 8. Hub IDs whose finished orders grew by more than 20 %
SELECT c."hub_id"
FROM  (
        SELECT feb."hub_id",
               ( (mar."finished_mar" - feb."finished_feb") * 1.0 / feb."finished_feb" ) AS "perc_growth"
        FROM (
              SELECT s."hub_id", COUNT(*) AS "finished_feb"
              FROM   "orders" AS o
              JOIN   "stores" AS s ON o."store_id" = s."store_id"
              WHERE  o."order_status" = 'FINISHED'
                AND  o."order_created_month" = 2
              GROUP  BY s."hub_id"
             ) AS feb
        JOIN (
              SELECT s."hub_id", COUNT(*) AS "finished_mar"
              FROM   "orders" AS o
              JOIN   "stores" AS s ON o."store_id" = s."store_id"
              WHERE  o."order_status" = 'FINISHED'
                AND  o."order_created_month" = 3
              GROUP  BY s."hub_id"
             ) AS mar
          ON feb."hub_id" = mar."hub_id"
      ) AS c
WHERE c."perc_growth" > 0.20
LIMIT 20;
```

```sql
-- 9. Corresponding hub names that surpassed the 20 % growth threshold
SELECT h."hub_name"
FROM   "hubs" AS h
WHERE  h."hub_id" IN (
        SELECT c."hub_id"
        FROM  (
                SELECT feb."hub_id",
                       ( (mar."finished_mar" - feb."finished_feb") * 1.0 / feb."finished_feb" ) AS "perc_growth"
                FROM (
                      SELECT s."hub_id", COUNT(*) AS "finished_feb"
                      FROM   "orders" AS o
                      JOIN   "stores" AS s ON o."store_id" = s."store_id"
                      WHERE  o."order_status" = 'FINISHED'
                        AND  o."order_created_month" = 2
                      GROUP  BY s."hub_id"
                     ) AS feb
                JOIN (
                      SELECT s."hub_id", COUNT(*) AS "finished_mar"
                      FROM   "orders" AS o
                      JOIN   "stores" AS s ON o."store_id" = s."store_id"
                      WHERE  o."order_status" = 'FINISHED'
                        AND  o."order_created_month" = 3
                      GROUP  BY s."hub_id"
                     ) AS mar
                  ON feb."hub_id" = mar."hub_id"
             ) AS c
        WHERE c."perc_growth" > 0.20
      )
LIMIT 20;
```

```sql
-- 10. Final report: hub name and growth percentage, rounded, for hubs with >20 % jump
SELECT h."hub_name",
       ROUND( ( (mar."finished_mar" - feb."finished_feb")*1.0 / feb."finished_feb" )*100 , 2) AS "growth_percent"
FROM  ( SELECT s."hub_id", COUNT(*) AS "finished_feb"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON o."store_id" = s."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 2
        GROUP  BY s."hub_id" ) AS feb
JOIN  ( SELECT s."hub_id", COUNT(*) AS "finished_mar"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON o."store_id" = s."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 3
        GROUP  BY s."hub_id" ) AS mar
      ON feb."hub_id" = mar."hub_id"
JOIN   "hubs"        AS h  ON h."hub_id" = feb."hub_id"
WHERE  ( (mar."finished_mar" - feb."finished_feb") * 1.0 / feb."finished_feb" ) > 0.20
LIMIT 20;
```

