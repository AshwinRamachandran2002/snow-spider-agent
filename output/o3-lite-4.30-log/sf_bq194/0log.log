Relevant columns & their potential usage for this task  

• GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  
  – "sample_path": to keep only files that end in .py, .r, .R, .Rmd, .rmd or .ipynb  
  – "content": to hunt for import / library / require statements that indicate which module gets loaded  
  – "sample_repo_name": to know which repository a file comes from (helpful when de‑duplicating)  

• GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES (optionally)  
  – "path": alternative place to filter on extensions if we do not need the whole file body  

(The other tables are not necessary for extracting import statements.)

Below are ten exploratory Snowflake SQL queries, from very simple samplers to more complex aggregations, that one could run while working toward the final answer (all limited to 20 rows as requested).

```sql
-- 1. Show 20 sample Python files that are present in the contents table
SELECT 
  "sample_repo_name",
  "sample_path"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE "sample_path" ILIKE '%.py'
LIMIT 20;
```

```sql
-- 2. Peek at the first 20 Python files that actually contain an “import” keyword
SELECT 
  "sample_repo_name",
  "sample_path",
  LEFT("content", 500) AS "first_500_chars"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE "sample_path" ILIKE '%.py'
  AND "content" ILIKE '%import%'
LIMIT 20;
```

```sql
-- 3. Extract one import‑like substring from each Python file
SELECT 
  "sample_path",
  REGEXP_SUBSTR("content", '(import|from)\\s+[a-zA-Z0-9_\\.]+', 1, 1, 'e') AS "import_example"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE "sample_path" ILIKE '%.py'
  AND "content" ILIKE '%import%'
LIMIT 20;
```

```sql
-- 4. Same idea for R‑script style “library(…)” or “require(…)” statements
SELECT 
  "sample_path",
  REGEXP_SUBSTR("content", '(library|require)\\s*\\(.*?\\)', 1, 1, 'e') AS "library_example"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE LOWER("sample_path") LIKE '%.r%'  -- matches .r, .R, .rmd, .Rmd
  AND "content" ILIKE '%library(%'
LIMIT 20;
```

```sql
-- 5. Quick look at IPython notebooks that refer to "import "
SELECT 
  "sample_path",
  REGEXP_SUBSTR("content", '"import\\s+[a-zA-Z0-9_\\.]+"', 1, 1, 'e') AS "ipynb_import_example"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE "sample_path" ILIKE '%.ipynb'
  AND "content" ILIKE '%"import %'
LIMIT 20;
```

```sql
-- 6. Break Python files into lines and list distinct raw import lines
SELECT DISTINCT 
  f.value::STRING AS "import_line"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
     LATERAL FLATTEN(input => SPLIT(t."content", '\n')) f
WHERE t."sample_path" ILIKE '%.py'
  AND f.value ILIKE 'import %'      -- crude pattern
LIMIT 20;
```

```sql
-- 7. Parse out the module token that follows “import” (simplified)
SELECT 
  LOWER(REGEXP_SUBSTR(f.value::STRING, 'import\\s+([a-zA-Z0-9_\\.]+)', 1, 1, 'e', 1)) AS "module"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
     LATERAL FLATTEN(input => SPLIT(t."content", '\n')) f
WHERE t."sample_path" ILIKE '%.py'
  AND f.value ILIKE 'import %'
  AND f.value NOT ILIKE '%from %'         -- focus on plain import X
LIMIT 20;
```

```sql
-- 8. Count the occurrence of each explicitly imported Python module
SELECT 
  LOWER(REGEXP_SUBSTR(f.value::STRING, 'import\\s+([a-zA-Z0-9_\\.]+)', 1, 1, 'e', 1)) AS "module",
  COUNT(*) AS "cnt"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
     LATERAL FLATTEN(input => SPLIT(t."content", '\n')) f
WHERE t."sample_path" ILIKE '%.py'
  AND f.value ILIKE 'import %'
GROUP BY "module"
ORDER BY "cnt" DESC
LIMIT 20;
```

```sql
-- 9. Aggregate top “library(…)” names within R/Rmd files
SELECT 
  LOWER(REGEXP_SUBSTR(f.value::STRING, '(library|require)\\s*\\(\\s*([a-zA-Z0-9_\\.]+)', 1, 1, 'e', 2)) AS "r_package",
  COUNT(*) AS "cnt"
FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
     LATERAL FLATTEN(input => SPLIT(t."content", '\n')) f
WHERE LOWER(t."sample_path") LIKE '%.r%'        -- .r, .R, .rmd, .Rmd
  AND (f.value ILIKE 'library(%' OR f.value ILIKE 'require(%')
GROUP BY "r_package"
ORDER BY "cnt" DESC
LIMIT 20;
```

```sql
-- 10. Combine Python & R results to find the second‑most frequent import/load overall
WITH py AS (
  SELECT 
    LOWER(REGEXP_SUBSTR(f.value::STRING, 'import\\s+([a-zA-Z0-9_\\.]+)', 1, 1, 'e', 1)) AS lib
  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS p,
       LATERAL FLATTEN(input => SPLIT(p."content", '\n')) f
  WHERE p."sample_path" ILIKE '%.py'
    AND f.value ILIKE 'import %'
),
r AS (
  SELECT 
    LOWER(REGEXP_SUBSTR(f.value::STRING, '(library|require)\\s*\\(\\s*([a-zA-Z0-9_\\.]+)', 1, 1, 'e', 2)) AS lib
  FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS q,
       LATERAL FLATTEN(input => SPLIT(q."content", '\n')) f
  WHERE LOWER(q."sample_path") LIKE '%.r%'
    AND (f.value ILIKE 'library(%' OR f.value ILIKE 'require(%')
),
tot AS (
  SELECT lib FROM py
  UNION ALL
  SELECT lib FROM r
)
SELECT 
  lib AS "library_or_module",
  COUNT(*) AS "total_occurrences"
FROM tot
WHERE lib IS NOT NULL
GROUP BY lib
ORDER BY "total_occurrences" DESC
LIMIT 20;
```

Each successive query digs a little deeper—starting with a simple inspection of the files, then isolating lines that look like imports, extracting module names, counting them, and finally consolidating Python and R together so you can inspect the most common and, by ordering, pick out which one is in second place.
