```sql
--Description: Extract R package names from lines that contain library(...) or require(...).  
--We split each *.R / *.r / *.Rmd / *.rmd file into lines, look for the substring
--“library(” or “require(”, then use a regex whose first capture group returns
--the package name; finally we show 20 examples.
SELECT
       REGEXP_SUBSTR(line.value::STRING ,
                     '(?:library|require)\\s*\\(\\s*([A-Za-z0-9_.]+)',
                     1, 1, 'e', 1)  AS "r_package"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS c,
       LATERAL FLATTEN(input => SPLIT(c."content", '\n')) AS line
WHERE (c."sample_path" ILIKE '%.r'   OR c."sample_path" ILIKE '%.R'   OR
       c."sample_path" ILIKE '%.rmd' OR c."sample_path" ILIKE '%.Rmd')
  AND (line.value::STRING ILIKE '%library(%' OR line.value::STRING ILIKE '%require(%')
LIMIT 20;
```

```sql
--Description: Combine Python and R imports, count how many times each library is referenced, 
--and list the 20 most frequent ones.  For Python we capture the module that follows either 
--“import <mod>” or “from <mod> import …”; for R we capture the package inside 
--library()/require().  Relaxed substring filters make sure lines are picked up.
SELECT "lib_name", COUNT(*) AS "usage"
FROM (
    /* Python libraries */
    SELECT COALESCE(
             REGEXP_SUBSTR(line.value::STRING , '\\bimport\\s+([A-Za-z0-9_]+)', 1, 1, 'e', 1),
             REGEXP_SUBSTR(line.value::STRING , '\\bfrom\\s+([A-Za-z0-9_]+)',   1, 1, 'e', 1)
           ) AS "lib_name"
    FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS p,
           LATERAL FLATTEN(input => SPLIT(p."content", '\n')) AS line
    WHERE  p."sample_path" ILIKE '%.py'
      AND (line.value::STRING ILIKE '%import %' OR line.value::STRING ILIKE 'from % import%')

    UNION ALL

    /* R libraries */
    SELECT REGEXP_SUBSTR(line.value::STRING ,
                         '(?:library|require)\\s*\\(\\s*([A-Za-z0-9_.]+)',
                         1, 1, 'e', 1) AS "lib_name"
    FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS r,
           LATERAL FLATTEN(input => SPLIT(r."content", '\n')) AS line
    WHERE (r."sample_path" ILIKE '%.r' OR r."sample_path" ILIKE '%.R' OR 
           r."sample_path" ILIKE '%.rmd' OR r."sample_path" ILIKE '%.Rmd')
      AND (line.value::STRING ILIKE '%library(%' OR line.value::STRING ILIKE '%require(%')
) AS all_libs
WHERE "lib_name" IS NOT NULL
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

