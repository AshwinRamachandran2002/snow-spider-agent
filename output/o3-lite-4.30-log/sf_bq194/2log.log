```sql
--Description: Determine the frequency of every library/module referenced in Python (*.py)
--via “import …” or “from … import …” and in R files (*.r / *.R / *.rmd / *.Rmd)
--via library(...) or require(...).  We extract the module/package name with separate
--regexes (avoiding Snowflake’s issue with non‑capturing groups), merge both languages,
--count occurrences, and list the 20 most frequent names.  The 2nd row of the result
--will be the second‑most imported/loaded library in the sample dataset.
WITH libs AS (
    /* ---------- Python modules ---------- */
    SELECT COALESCE(
               REGEXP_SUBSTR(line.value::STRING , '\\bimport\\s+([A-Za-z0-9_]+)', 1, 1, 'e', 1),
               REGEXP_SUBSTR(line.value::STRING , '\\bfrom\\s+([A-Za-z0-9_]+)',   1, 1, 'e', 1)
           ) AS lib_name
    FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS p,
           LATERAL FLATTEN(input => SPLIT(p."content", '\n')) AS line
    WHERE  p."sample_path" ILIKE '%.py'
      AND (line.value::STRING ILIKE '%import %' OR line.value::STRING ILIKE 'from % import%')

    UNION ALL

    /* ---------- R packages ---------- */
    SELECT COALESCE(
               REGEXP_SUBSTR(line.value::STRING , 'library\\s*\\(\\s*([A-Za-z0-9_.]+)', 1, 1, 'e', 1),
               REGEXP_SUBSTR(line.value::STRING , 'require\\s*\\(\\s*([A-Za-z0-9_.]+)', 1, 1, 'e', 1)
           ) AS lib_name
    FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS r,
           LATERAL FLATTEN(input => SPLIT(r."content", '\n')) AS line
    WHERE (r."sample_path" ILIKE '%.r'   OR r."sample_path" ILIKE '%.R'
        OR r."sample_path" ILIKE '%.rmd' OR r."sample_path" ILIKE '%.Rmd')
      AND (line.value::STRING ILIKE '%library(%' OR line.value::STRING ILIKE '%require(%')
)
SELECT lib_name,
       COUNT(*) AS usage
FROM   libs
WHERE  lib_name IS NOT NULL
GROUP BY lib_name
ORDER BY usage DESC
LIMIT 20;
```
