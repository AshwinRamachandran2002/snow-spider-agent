Begin Exploring Related Columns
Relevant columns and their potential usage  
• "sample_path" (GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS) : identify file‑type by extension (*.py, *.r, *.R, *.Rmd, *.ipynb).  
• "content" (GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS) : hold the source text in which import / library statements can be parsed.  
• "id" (GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS ↔ GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES) : joins the file list with the file body if needed.  
• "path" (GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES) : an alternative place to filter by file extension when content is not yet loaded.  
• "repo_name" (in both tables) : optional grouping key to see which projects use a given package.  

Basic conditions that will be useful  
• "sample_path" ILIKE '%.py'  ––– select Python files  
• "sample_path" ILIKE '%.r' OR ILIKE '%.R' OR ILIKE '%.rmd' OR ILIKE '%.Rmd' ––– select R files  
• "sample_path" ILIKE '%.ipynb' ––– select notebooks (JSON; still look for "import ")  
• REGEXP_LIKE(line.value::STRING , '^\s*import\s+') ––– find Python import lines  
• REGEXP_LIKE(line.value::STRING , '^\s*(library|require)\s*\(') ––– find R library calls  

Below are ten incremental Snowflake SQL queries (LIMIT 20 in each) that explore the data and finally compute the most‑imported libraries.  
Every identifier is enclosed in double quotes per requirement.  

```sql
-- 1. List a few Python‑source files that exist in the sample set
SELECT DISTINCT 
       "sample_repo_name",
       "sample_path"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE  "sample_path" ILIKE '%.py'
LIMIT 20;
```

```sql
-- 2. Inspect the first 20 lines of Python code for one such file
SELECT  line.value::STRING        AS "code_line"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c,
        LATERAL FLATTEN(input => SPLIT(c."content", '\n')) line
WHERE   c."sample_path" ILIKE '%.py'
LIMIT 20;
```

```sql
-- 3. Show only those lines that actually begin with a Python 'import' statement
SELECT  line.value::STRING        AS "import_line"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c,
        LATERAL FLATTEN(input => SPLIT(c."content", '\n')) line
WHERE   c."sample_path" ILIKE '%.py'
  AND   REGEXP_LIKE(line.value::STRING , '^\s*import\s+')
LIMIT 20;
```

```sql
-- 4. Extract the primary module name from each Python 'import' statement
SELECT  REGEXP_SUBSTR(line.value::STRING , '^\s*import\s+([A-Za-z0-9_]+)', 1, 1, 'e', 1)  AS "py_module"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c,
        LATERAL FLATTEN(input => SPLIT(c."content", '\n')) line
WHERE   c."sample_path" ILIKE '%.py'
  AND   REGEXP_LIKE(line.value::STRING , '^\s*import\s+')
LIMIT 20;
```

```sql
-- 5. Top 20 most‑imported Python modules (frequency count)
SELECT  REGEXP_SUBSTR(line.value::STRING , '^\s*import\s+([A-Za-z0-9_]+)', 1, 1, 'e', 1)    AS "py_module",
        COUNT(*)                                                                              AS "cnt"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS c,
        LATERAL FLATTEN(input => SPLIT(c."content", '\n')) line
WHERE   c."sample_path" ILIKE '%.py'
  AND   REGEXP_LIKE(line.value::STRING , '^\s*import\s+')
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 6. Look at every Python file that imports the popular module 'numpy'
SELECT DISTINCT 
       c."sample_repo_name",
       c."sample_path"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS c,
       LATERAL FLATTEN(input => SPLIT(c."content", '\n')) line
WHERE  c."sample_path" ILIKE '%.py'
  AND  REGEXP_LIKE(line.value::STRING , '^\s*import\s+numpy\b')
LIMIT 20;
```

```sql
-- 7. Quickly list R / Rmd files present in the sample
SELECT DISTINCT 
       "sample_repo_name",
       "sample_path"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE  "sample_path" ILIKE '%.r' 
    OR "sample_path" ILIKE '%.R' 
    OR "sample_path" ILIKE '%.rmd' 
    OR "sample_path" ILIKE '%.Rmd'
LIMIT 20;
```

```sql
-- 8. Extract package names from R 'library(...)' or 'require(...)' calls
SELECT  REGEXP_SUBSTR(line.value::STRING , '^\s*(library|require)\s*\(\s*([A-Za-z0-9_.]+)', 1, 1, 'e', 2) AS "r_package"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS c,
        LATERAL FLATTEN(input => SPLIT(c."content", '\n')) line
WHERE  (c."sample_path" ILIKE '%.r' OR c."sample_path" ILIKE '%.R' OR c."sample_path" ILIKE '%.rmd' OR c."sample_path" ILIKE '%.Rmd')
  AND   REGEXP_LIKE(line.value::STRING , '^\s*(library|require)\s*\(')
LIMIT 20;
```

```sql
-- 9. Combine Python and R imports into one list for a cross‑language view
SELECT "lib_name", COUNT(*) AS "usage"
FROM (
        -- Python part
        SELECT REGEXP_SUBSTR(line.value::STRING , '^\s*import\s+([A-Za-z0-9_]+)', 1, 1, 'e', 1) AS "lib_name"
        FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS p,
               LATERAL FLATTEN(input => SPLIT(p."content", '\n')) line
        WHERE  p."sample_path" ILIKE '%.py'
          AND  REGEXP_LIKE(line.value::STRING , '^\s*import\s+')
        
        UNION ALL
        
        -- R part
        SELECT REGEXP_SUBSTR(line.value::STRING , '^\s*(library|require)\s*\(\s*([A-Za-z0-9_.]+)', 1, 1, 'e', 2) AS "lib_name"
        FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS r,
               LATERAL FLATTEN(input => SPLIT(r."content", '\n')) line
        WHERE (r."sample_path" ILIKE '%.r' OR r."sample_path" ILIKE '%.R' OR r."sample_path" ILIKE '%.rmd' OR r."sample_path" ILIKE '%.Rmd')
          AND  REGEXP_LIKE(line.value::STRING , '^\s*(library|require)\s*\(')
     ) t
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 10. Final: determine the 2nd most frequently imported/loaded library overall
WITH lib_freq AS (
    SELECT "lib_name", COUNT(*) AS "usage"
    FROM (
            SELECT REGEXP_SUBSTR(line.value::STRING , '^\s*import\s+([A-Za-z0-9_]+)', 1, 1, 'e', 1) AS "lib_name"
            FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS p,
                   LATERAL FLATTEN(input => SPLIT(p."content", '\n')) line
            WHERE  p."sample_path" ILIKE '%.py'
              AND  REGEXP_LIKE(line.value::STRING , '^\s*import\s+')
            
            UNION ALL
            
            SELECT REGEXP_SUBSTR(line.value::STRING , '^\s*(library|require)\s*\(\s*([A-Za-z0-9_.]+)', 1, 1, 'e', 2) AS "lib_name"
            FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS r,
                   LATERAL FLATTEN(input => SPLIT(r."content", '\n')) line
            WHERE (r."sample_path" ILIKE '%.r' OR r."sample_path" ILIKE '%.R' OR r."sample_path" ILIKE '%.rmd' OR r."sample_path" ILIKE '%.Rmd')
              AND  REGEXP_LIKE(line.value::STRING , '^\s*(library|require)\s*\(')
         ) t
    GROUP BY 1
)
SELECT  "lib_name", "usage"
FROM    lib_freq
ORDER BY "usage" DESC
LIMIT 20;
```  

These step‑wise queries let you explore, extract, and aggregate import statements until the second‑most frequently referenced Python/R library emerges.
