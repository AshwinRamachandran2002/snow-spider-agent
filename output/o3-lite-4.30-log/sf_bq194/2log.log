```sql
--Description: Extract the module name that follows either “import <name>” or “from <name> import”
--inside any Python (*.py) file.  We split each file’s text into lines, apply two regex patterns,
--use COALESCE to keep whichever matches, then discard nulls and list 20 sample module names.
SELECT
       py.py_module
FROM (
    SELECT COALESCE(
             REGEXP_SUBSTR(line.value::STRING , '\\bimport\\s+([A-Za-z0-9_]+)', 1, 1, 'e', 1),
             REGEXP_SUBSTR(line.value::STRING , '\\bfrom\\s+([A-Za-z0-9_]+)',   1, 1, 'e', 1)
           ) AS py_module
    FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS c,
           LATERAL FLATTEN(input => SPLIT(c."content", '\n')) AS line
    WHERE  c."sample_path" ILIKE '%.py'
      AND (line.value::STRING ILIKE '%import %' OR line.value::STRING ILIKE 'from % import%')
) py
WHERE py.py_module IS NOT NULL
LIMIT 20;
