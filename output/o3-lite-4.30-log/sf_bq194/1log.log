-- 9) Combine Python + R imports into one list and rank them
WITH py AS (
      SELECT REGEXP_SUBSTR(f.value::STRING,
                           'import\\s+([A-Za-z0-9_\\.]+)',
                           1, 1, 'e', 1) AS m
      FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
             LATERAL FLATTEN(input => SPLIT(t."content", '\n')) f
      WHERE  t."sample_path" ILIKE '%.py'
        AND  f.value ILIKE '%import %'
), r AS (
      SELECT REGEXP_SUBSTR(f.value::STRING,
                           '(library|require)\\s*\\(\\s*([A-Za-z0-9_\\.]+)',
                           1, 1, 'e', 2) AS m
      FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
             LATERAL FLATTEN(input => SPLIT(t."content", '\n')) f
      WHERE  (t."sample_path" ILIKE '%.r'
              OR t."sample_path" ILIKE '%.R'
              OR t."sample_path" ILIKE '%.rmd'
              OR t."sample_path" ILIKE '%.Rmd')
        AND  (f.value ILIKE 'library(%'
              OR f.value ILIKE 'require(%')
)
SELECT  m AS imported_module,
        COUNT(*) AS usage_cnt
FROM ( SELECT m FROM py UNION ALL SELECT m FROM r )
WHERE  m IS NOT NULL
GROUP BY m
ORDER BY usage_cnt DESC
LIMIT 20;
