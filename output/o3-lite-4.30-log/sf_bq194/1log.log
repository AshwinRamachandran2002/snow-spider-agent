2025-05-01 01:00:53 - Thread-161 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
• "sample_path": filter to Python, R/ Rmd, and IPython‑notebook files by file‑name extension.  
• "content": scan the file text to pull out import / library / require statements.  
• "sample_repo_name": (optional) let us de‑duplicate by repository when we count modules.  
• "id": join‑key and uniqueness (usually not needed for the counting task).  

Typical conditions we will need  
• "sample_path" ILIKE '%.py'  (or %.r / %.Rmd / %.ipynb, etc.)  
• REGEXP_… or POSITION() on "content" to find import / library / require strings.  

Below are ten exploratory Snowflake SQL queries (all capped with LIMIT 20 rows) that progress from simple inspection to a final “second‑most‑frequent import” query.  
All identifiers are wrapped in double quotes exactly as they exist in the catalogue.

```sql
-- 1) List a few Python files that exist in the sample contents table
SELECT DISTINCT
       "sample_repo_name",
       "sample_path"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE  "sample_path" ILIKE '%.py'
LIMIT  20;
```

```sql
-- 2) List a few R / Rmd files
SELECT DISTINCT
       "sample_repo_name",
       "sample_path"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE  "sample_path" ILIKE '%.r'
   OR  "sample_path" ILIKE '%.R'
   OR  "sample_path" ILIKE '%.rmd'
   OR  "sample_path" ILIKE '%.Rmd'
LIMIT  20;
```

```sql
-- 3) List a few Jupyter notebooks
SELECT DISTINCT
       "sample_repo_name",
       "sample_path"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS
WHERE  "sample_path" ILIKE '%.ipynb'
LIMIT  20;
```

```sql
-- 4) Pull Python code lines that contain the word “import ”
SELECT  t."sample_repo_name",
        t."sample_path",
        f.value::STRING      AS "code_line"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
        LATERAL FLATTEN( input => SPLIT(t."content", '\n') ) f
WHERE   t."sample_path" ILIKE '%.py'
  AND   f.value ILIKE '%import %'
LIMIT  20;
```

```sql
-- 5) Extract the first module that follows the word “import”
SELECT  REGEXP_SUBSTR(f.value::STRING,
                      'import\\s+([A-Za-z0-9_\\.]+)',
                      1, 1, 'e', 1)      AS "imported_module"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
        LATERAL FLATTEN( input => SPLIT(t."content", '\n') ) f
WHERE   t."sample_path" ILIKE '%.py'
  AND   f.value ILIKE '%import %'
LIMIT  20;
```

```sql
-- 6) Extract the module after “from <module> import …” (Python)
SELECT  REGEXP_SUBSTR(f.value::STRING,
                      'from\\s+([A-Za-z0-9_\\.]+)\\s+import',
                      1, 1, 'e', 1)      AS "imported_module"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
        LATERAL FLATTEN( input => SPLIT(t."content", '\n') ) f
WHERE   t."sample_path" ILIKE '%.py'
  AND   f.value ILIKE 'from %import%'
LIMIT  20;
```

```sql
-- 7) Extract library names in R:  library(<module>) or require(<module>)
SELECT  REGEXP_SUBSTR(f.value::STRING,
                      '(library|require)\\s*\\(\\s*([A-Za-z0-9_\\.]+)',
                      1, 1, 'e', 2)      AS "imported_module"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
        LATERAL FLATTEN( input => SPLIT(t."content", '\n') ) f
WHERE   ( t."sample_path" ILIKE '%.r'
          OR t."sample_path" ILIKE '%.R'
          OR t."sample_path" ILIKE '%.rmd'
          OR t."sample_path" ILIKE '%.Rmd' )
  AND   ( f.value ILIKE 'library(%'
          OR f.value ILIKE 'require(%' )
LIMIT  20;
```

```sql
-- 8) Count the frequency of each Python imported module
SELECT  imported_module,
        COUNT(*)      AS usage_cnt
FROM  (
        SELECT  REGEXP_SUBSTR(f.value::STRING,
                              'import\\s+([A-Za-z0-9_\\.]+)',
                              1, 1, 'e', 1)  AS imported_module
        FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
                LATERAL FLATTEN( input => SPLIT(t."content", '\n') ) f
        WHERE   t."sample_path" ILIKE '%.py'
          AND   f.value ILIKE '%import %'
      )
WHERE  imported_module IS NOT NULL
GROUP BY imported_module
ORDER BY usage_cnt DESC
LIMIT 20;
```

```sql
-- 9) Combine Python + R imports into one list and rank them
WITH py AS (
      SELECT REGEXP_SUBSTR(f.value::STRING,
                           'import\\s+([A-Za-z0-9_\\.]+)',
                           1, 1, 'e', 1) AS m
      FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
             LATERAL FLATTEN(input => SPLIT(t."content", '\n')) f
      WHERE  t."sample_path" ILIKE '%.py'
        AND  f.value ILIKE '%import %'
), r AS (
      SELECT REGEXP_SUBSTR(f.value::STRING,
                           '(library|require)\\s*\\(\\s*([A-Za-z0-9_\\.]+)',
                           1, 1, 'e', 2) AS m
      FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
             LATERAL FLATTEN(input => SPLIT(t."content", '\n')) f
      WHERE  (t."sample_path" ILIKE '%.r'
              OR t."sample_path" ILIKE '%.R'
              OR t."sample_path" ILIKE '%.rmd'
              OR t."sample_path" ILIKE '%.Rmd')
        AND  (f.value ILIKE 'library(%'
              OR f.value ILIKE 'require(%')
)
SELECT  m AS imported_module,
        COUNT(*) AS usage_cnt
FROM ( SELECT m FROM py UNION ALL SELECT m FROM r )
WHERE  m IS NOT NULL
GROUP BY m
ORDER BY usage_cnt DESC
LIMIT 20;
```

```sql
-- 10) Return the second‑most‑frequently imported/loaded module/library
WITH combined AS (
      /* Bring together Python, R/Rmd and (optionally) notebook %load lines */
      SELECT REGEXP_SUBSTR(f.value::STRING,
                           'import\\s+([A-Za-z0-9_\\.]+)',
                           1, 1, 'e', 1)      AS mod
      FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
             LATERAL FLATTEN(input => SPLIT(t."content", '\n')) f
      WHERE  t."sample_path" ILIKE '%.py'
        AND  f.value ILIKE '%import %'

      UNION ALL

      SELECT REGEXP_SUBSTR(f.value::STRING,
                           '(library|require)\\s*\\(\\s*([A-Za-z0-9_\\.]+)',
                           1, 1, 'e', 2)       AS mod
      FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS t,
             LATERAL FLATTEN(input => SPLIT(t."content", '\n')) f
      WHERE  (t."sample_path" ILIKE '%.r'
              OR t."sample_path" ILIKE '%.R'
              OR t."sample_path" ILIKE '%.rmd'
              OR t."sample_path" ILIKE '%.Rmd')
        AND  (f.value ILIKE 'library(%'
              OR f.value ILIKE 'require(%')
)
SELECT  mod      AS imported_module,
        COUNT(*) AS usage_cnt
FROM    combined
WHERE   mod IS NOT NULL
GROUP BY mod
QUALIFY  ROW_NUMBER() OVER (ORDER BY usage_cnt DESC) = 2;
```
