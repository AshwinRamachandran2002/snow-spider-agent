Query:
-- 7. Description: How many season‑5 matches each player *appeared* in (using player_match).
SELECT pm."player_id",
       COUNT(DISTINCT pm."match_id") AS "matches_played_s5"
FROM   "player_match" AS pm
WHERE  pm."match_id" IN (
           SELECT "match_id"
           FROM "match"
           WHERE "season_id" = 5
       )
GROUP BY pm."player_id"
LIMIT 20;
