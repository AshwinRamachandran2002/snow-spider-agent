Query:
-- 9. Description: Compute batting average (runs per match) and show top 20 players.
SELECT  sub."player_id",
        sub."total_runs_season5",
        sub."matches_played_s5",
        sub."total_runs_season5" * 1.0 / sub."matches_played_s5" AS "batting_average"
FROM (
        /* same subquery as #8 */
        SELECT  r."player_id",
                r."total_runs_season5",
                m."matches_played_s5"
        FROM  (
                SELECT bb."striker" AS "player_id",
                       SUM(bs."runs_scored") AS "total_runs_season5"
                FROM   "ball_by_ball"  AS bb
                JOIN   "batsman_scored" AS bs
                       ON  bb."match_id" = bs."match_id"
                       AND bb."over_id"  = bs."over_id"
                       AND bb."ball_id"  = bs."ball_id"
                WHERE  bb."match_id" IN (
                           SELECT "match_id"
                           FROM "match"
                           WHERE "season_id" = 5
                       )
                GROUP BY bb."striker"
             ) AS r
        JOIN (
                SELECT pm."player_id",
                       COUNT(DISTINCT pm."match_id") AS "matches_played_s5"
                FROM   "player_match" AS pm
                WHERE  pm."match_id" IN (
                           SELECT "match_id"
                           FROM "match"
                           WHERE "season_id" = 5
                       )
                GROUP BY pm."player_id"
             ) AS m
             ON r."player_id" = m."player_id"
     ) AS sub
ORDER BY "batting_average" DESC
LIMIT 20;
