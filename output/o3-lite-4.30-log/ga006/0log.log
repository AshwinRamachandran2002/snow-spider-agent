```sql
-- 6. Aggregate purchase revenue per user‑session (Nov only)
SELECT user_pseudo_id,
       ep.value.int_value  AS ga_session_id,
       SUM(ecommerce.purchase_revenue_in_usd) AS session_revenue_usd
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
     UNNEST(event_params) AS ep
WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND event_name = 'purchase'
  AND ecommerce.purchase_revenue_in_usd IS NOT NULL
  AND ep.key = 'ga_session_id'
GROUP BY user_pseudo_id, ga_session_id
LIMIT 20;
```

```sql
-- 7. Count how many purchase sessions each user had in November
WITH per_session AS (
  SELECT user_pseudo_id,
         ep.value.int_value AS ga_session_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(event_params) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'purchase'
    AND ecommerce.purchase_revenue_in_usd IS NOT NULL
    AND ep.key = 'ga_session_id'
  GROUP BY user_pseudo_id, ga_session_id
)
SELECT user_pseudo_id,
       COUNT(*) AS purchase_sessions
FROM per_session
GROUP BY user_pseudo_id
HAVING purchase_sessions > 1
LIMIT 20;
```

```sql
-- 8. Compute total and average revenue per session for users with >1 purchase sessions
WITH per_session AS (
  SELECT user_pseudo_id,
         ep.value.int_value AS ga_session_id,
         SUM(ecommerce.purchase_revenue_in_usd) AS session_revenue_usd
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(event_params) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'purchase'
    AND ecommerce.purchase_revenue_in_usd IS NOT NULL
    AND ep.key = 'ga_session_id'
  GROUP BY user_pseudo_id, ga_session_id
),
qualified_users AS (
  SELECT user_pseudo_id
  FROM per_session
  GROUP BY user_pseudo_id
  HAVING COUNT(*) > 1
)
SELECT ps.user_pseudo_id,
       AVG(ps.session_revenue_usd) AS avg_purchase_rev_usd
FROM per_session AS ps
JOIN qualified_users AS qu
  ON ps.user_pseudo_id = qu.user_pseudo_id
GROUP BY ps.user_pseudo_id
LIMIT 20;
```

```sql
-- 9. Same as #8 but showing also number of purchase sessions
WITH per_session AS (
  SELECT user_pseudo_id,
         ep.value.int_value AS ga_session_id,
         SUM(ecommerce.purchase_revenue_in_usd) AS session_revenue_usd
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
       UNNEST(event_params) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'purchase'
    AND ecommerce.purchase_revenue_in_usd IS NOT NULL
    AND ep.key = 'ga_session_id'
  GROUP BY user_pseudo_id, ga_session_id
),
per_user AS (
  SELECT user_pseudo_id,
         COUNT(*) AS purchase_sessions,
         AVG(session_revenue_usd) AS avg_rev_usd
  FROM per_session
  GROUP BY user_pseudo_id
  HAVING purchase_sessions > 1
)
SELECT *
FROM per_user
ORDER BY avg_rev_usd DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER QUERY:
--    Average purchase‑revenue‑in‑USD per session for each user who had >1 purchase sessions (Nov 1–30 2020)
WITH purchase_sessions AS (
  SELECT
      user_pseudo_id,
      ep.value.int_value AS ga_session_id,
      SUM(ecommerce.purchase_revenue_in_usd) AS session_revenue_usd
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  CROSS JOIN UNNEST(event_params) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'purchase'
    AND ecommerce.purchase_revenue_in_usd IS NOT NULL
    AND ep.key = 'ga_session_id'
  GROUP BY user_pseudo_id, ga_session_id
),
users_more_than_one AS (
  SELECT user_pseudo_id
  FROM purchase_sessions
  GROUP BY user_pseudo_id
  HAVING COUNT(DISTINCT ga_session_id) > 1
)
SELECT
    ps.user_pseudo_id,
    AVG(ps.session_revenue_usd) AS avg_purchase_revenue_per_session_usd
FROM purchase_sessions AS ps
JOIN users_more_than_one AS u
  ON ps.user_pseudo_id = u.user_pseudo_id
GROUP BY ps.user_pseudo_id
ORDER BY avg_purchase_revenue_per_session_usd DESC
LIMIT 20;
```
