),
raw_purchase AS (
    SELECT
        user_pseudo_id,
        (
          SELECT ep.value.int_value
          FROM UNNEST(event_params) AS ep
          WHERE ep.key = 'ga_session_id'
          LIMIT 1
        ) AS ga_session_id,
        ecommerce.purchase_revenue_in_usd AS purchase_revenue_usd
    FROM union_events
    WHERE event_name = 'purchase'
      AND ecommerce.purchase_revenue_in_usd IS NOT NULL
),
session_revenue AS (
    SELECT
        user_pseudo_id,
        ga_session_id,
        SUM(purchase_revenue_usd) AS session_revenue_usd
    FROM raw_purchase
    WHERE ga_session_id IS NOT NULL
    GROUP BY user_pseudo_id, ga_session_id
),
eligible_users AS (
    SELECT user_pseudo_id
    FROM session_revenue
    GROUP BY user_pseudo_id
    HAVING COUNT(*) > 1          -- more than one distinct purchase session
)
SELECT
    sr.user_pseudo_id,
    ROUND(AVG(sr.session_revenue_usd), 4) AS avg_purchase_revenue_usd_per_session
FROM session_revenue AS sr
JOIN eligible_users AS eu
  ON sr.user_pseudo_id = eu.user_pseudo_id
GROUP BY sr.user_pseudo_id
ORDER BY avg_purchase_revenue_usd_per_session DESC, sr.user_pseudo_id;
