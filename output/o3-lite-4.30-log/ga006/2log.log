```sql
--Description:
-- Calculate, for 1 – 30 Nov 2020, each user’s average purchase revenue (USD) per
-- session, but only for users who made purchases in more than one session.
-- Steps
-- 1. Wildcard‑scan all November 2020 tables (`events_202011*`).
-- 2. Keep rows with event_date between 20201101‑20201130, event_name = 'purchase',
--    non‑NULL ecommerce.purchase_revenue_in_usd, and a present ga_session_id
--    (extracted from event_params).
-- 3. Aggregate purchase revenue at the session level (user_pseudo_id +
--    ga_session_id).  This handles multiple purchase events in the same session.
-- 4. Aggregate again at the user level to compute the average revenue per session
--    and retain only users with more than one distinct purchase session.
WITH purchase_events AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
       FROM UNNEST(event_params) AS ep
       WHERE ep.key = 'ga_session_id') AS ga_session_id,
    ecommerce.purchase_revenue_in_usd AS purchase_usd
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  WHERE event_date BETWEEN '20201101' AND '20201130'
        AND event_name = 'purchase'
        AND ecommerce.purchase_revenue_in_usd IS NOT NULL
),
session_totals AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    SUM(purchase_usd) AS session_revenue_usd
  FROM purchase_events
  WHERE ga_session_id IS NOT NULL
  GROUP BY user_pseudo_id, ga_session_id
)
SELECT
  user_pseudo_id,
  AVG(session_revenue_usd) AS avg_purchase_revenue_usd_per_session
FROM session_totals
GROUP BY user_pseudo_id
HAVING COUNT(DISTINCT ga_session_id) > 1
ORDER BY avg_purchase_revenue_usd_per_session DESC;
```
