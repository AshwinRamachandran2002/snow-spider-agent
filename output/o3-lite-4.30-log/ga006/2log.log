```sql
-- 5. Pull purchase revenue together with user_pseudo_id and ga_session_id for one table
SELECT
  user_pseudo_id,
  ep.value.int_value        AS ga_session_id,
  ecommerce.purchase_revenue_in_usd AS purchase_usd
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201105`,
     UNNEST(event_params) AS ep
WHERE event_name = 'purchase'
  AND ep.key = 'ga_session_id'
  AND ecommerce.purchase_revenue_in_usd IS NOT NULL
LIMIT 20;
```

```sql
-- 6. Same as #5 but union two days with a wildcard suffix filter
SELECT
  user_pseudo_id,
  ep.value.int_value AS ga_session_id,
  ecommerce.purchase_revenue_in_usd AS purchase_usd
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
WHERE _TABLE_SUFFIX IN ('20201106','20201107')         -- only two days
  AND event_name = 'purchase'
  AND ecommerce.purchase_revenue_in_usd IS NOT NULL
  AND EXISTS (SELECT 1 FROM UNNEST(event_params) ep WHERE ep.key='ga_session_id')
LIMIT 20;
