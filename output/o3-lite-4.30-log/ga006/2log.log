```sql
-- 9. Average purchase revenue per session for each user (all November),
--    keep users who had more than one purchase session
WITH session_rev AS (
  SELECT
    user_pseudo_id,
    (SELECT ep.value.int_value
       FROM UNNEST(event_params) ep
       WHERE ep.key = 'ga_session_id') AS ga_session_id,
    ecommerce.purchase_revenue_in_usd AS purchase_usd
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'purchase'
    AND ecommerce.purchase_revenue_in_usd IS NOT NULL
),
per_session AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    SUM(purchase_usd) AS session_revenue_usd
  FROM session_rev
  GROUP BY user_pseudo_id, ga_session_id
)
SELECT
  user_pseudo_id,
  AVG(session_revenue_usd) AS avg_purchase_usd_per_session
FROM per_session
GROUP BY user_pseudo_id
HAVING COUNT(DISTINCT ga_session_id) > 1
LIMIT 20;
