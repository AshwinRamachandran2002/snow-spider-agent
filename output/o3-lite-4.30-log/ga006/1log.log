    GROUP BY user_pseudo_id, ga_session_id )
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
--Description: 9) FINAL LOGIC (users with >1 purchase session) – average revenue per purchase session.
SELECT user_pseudo_id,
       AVG(session_revenue_usd) AS avg_purchase_rev_per_session
FROM (
    SELECT user_pseudo_id,
           ga_session_id,
           SUM(ecommerce.purchase_revenue_in_usd) AS session_revenue_usd
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
         UNNEST(event_params) AS ep
    WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
      AND event_name = 'purchase'
      AND ecommerce.purchase_revenue_in_usd IS NOT NULL
      AND ep.key = 'ga_session_id'
    GROUP BY user_pseudo_id, ga_session_id )
GROUP BY user_pseudo_id
HAVING COUNT(*) > 1
ORDER BY avg_purchase_rev_per_session DESC
LIMIT 20;
```

```sql
--Description: 10) Same as #9 but rewritten with CTEs for clarity.
WITH purchase_events AS (
  SELECT user_pseudo_id,
         ep.value.int_value AS ga_session_id,
         ecommerce.purchase_revenue_in_usd
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
       UNNEST(event_params) AS ep
  WHERE _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'purchase'
    AND ecommerce.purchase_revenue_in_usd IS NOT NULL
    AND ep.key = 'ga_session_id'
),
session_level AS (
  SELECT user_pseudo_id,
         ga_session_id,
         SUM(ecommerce.purchase_revenue_in_usd) AS session_revenue_usd
  FROM purchase_events
  GROUP BY user_pseudo_id, ga_session_id
)
SELECT user_pseudo_id,
       AVG(session_revenue_usd) AS avg_purchase_rev_per_session
FROM session_level
GROUP BY user_pseudo_id
HAVING COUNT(*) > 1
ORDER BY avg_purchase_rev_per_session DESC
LIMIT 20;
```

