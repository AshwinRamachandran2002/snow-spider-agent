```sql
/*  Thinking process (embedded as comments):
    Goal  : For 1–30 Nov 2020 list every user_pseudo_id that had
            more than one purchase session and show the average
            purchase revenue (USD) per session.
    Tables: Daily GA4 export tables whose names start with events_202011*.
    Steps :
      1. Read only tables whose _TABLE_SUFFIX is between 20201101‑20201130.
      2. Keep rows where event_name = 'purchase' and purchase_revenue_in_usd IS NOT NULL.
      3. Unnest event_params, retain the element whose key = 'ga_session_id';
         its value.int_value is the session identifier.
      4. Aggregate revenue at the (user_pseudo_id, ga_session_id) level
         → session_revenue_usd.
      5. From those session‑level rows, compute
         a) number_of_purchase_sessions per user,
         b) avg_purchase_rev_per_session (AVG of session_revenue_usd).
      6. Keep only users with number_of_purchase_sessions > 1.
      7. Order by avg_purchase_rev_per_session DESC and display a sample (LIMIT 20).
*/
WITH purchase_events AS (
  SELECT
    user_pseudo_id,
    -- extract ga_session_id from event_params
    ep.value.int_value AS ga_session_id,
    ecommerce.purchase_revenue_in_usd
  FROM
    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
    UNNEST(event_params) AS ep
  WHERE
    _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND event_name = 'purchase'
    AND ecommerce.purchase_revenue_in_usd IS NOT NULL
    AND ep.key = 'ga_session_id'
),
session_level AS (
  SELECT
    user_pseudo_id,
    ga_session_id,
    SUM(ecommerce.purchase_revenue_in_usd) AS session_revenue_usd
  FROM purchase_events
  GROUP BY user_pseudo_id, ga_session_id
)
SELECT
  user_pseudo_id,
  AVG(session_revenue_usd)                     AS avg_purchase_rev_per_session_usd,
  COUNT(*)                                     AS number_of_purchase_sessions
FROM session_level
GROUP BY user_pseudo_id
HAVING number_of_purchase_sessions > 1
ORDER BY avg_purchase_rev_per_session_usd DESC
LIMIT 20;
```
