Successfully corrected. SQL:
--Description:  We want, for each 2023 observation date in California (GEO_ID = 'geoId/06'),
--              the cumulative “near‑default” mortgage ratio—that is, the sum of:
--              • Percent 90‑180 Days Past Due
--              • Percent in Forbearance
--              • Percent in the Process of Foreclosure / Bankruptcy / Deed‑in‑Lieu
--              We:
--              1. Pull the three variable groups from the attributes table, limiting to the
--                 “All Mortgages” market so every metric is on the same loan universe.
--              2. Join to the timeseries table, filtering to 2023 and California.
--              3. Pivot the three components into columns and add their sum.
--              (LIMIT 20 just shows the first 20 dated rows.)
WITH target_vars AS (
    SELECT
        "VARIABLE",
        CASE
            WHEN "VARIABLE_GROUP" = 'Percent 90 to 180 Days Past Due Date'                   THEN 'pct_90_180'
            WHEN "VARIABLE_GROUP" = 'Percent in Forbearance'                                THEN 'pct_forbearance'
            WHEN "VARIABLE_GROUP" = 'Percent in Foreclosure, Bankruptcy & Deed in Lieu'     THEN 'pct_foreclosure'
        END AS grp
    FROM US_REAL_ESTATE.CYBERSYN.FHFA_MORTGAGE_PERFORMANCE_ATTRIBUTES
    WHERE "VARIABLE_GROUP" IN ( 'Percent 90 to 180 Days Past Due Date',
                                'Percent in Forbearance',
                                'Percent in Foreclosure, Bankruptcy & Deed in Lieu')
      AND "MARKET" = 'All Mortgages'
)
SELECT
    t."DATE",
    MAX(CASE WHEN v.grp = 'pct_90_180'       THEN t."VALUE" END) AS "pct_90_180_past_due",
    MAX(CASE WHEN v.grp = 'pct_forbearance'  THEN t."VALUE" END) AS "pct_in_forbearance",
    MAX(CASE WHEN v.grp = 'pct_foreclosure'  THEN t."VALUE" END) AS "pct_in_foreclosure",
    -- cumulative ratio of mortgages near default
    SUM(t."VALUE")                                               AS "cumulative_near_default_ratio"
FROM US_REAL_ESTATE.CYBERSYN.FHFA_MORTGAGE_PERFORMANCE_TIMESERIES t
JOIN target_vars v
  ON t."VARIABLE" = v."VARIABLE"
WHERE t."GEO_ID" = 'geoId/06'
  AND t."DATE" BETWEEN '2023-01-01' AND '2023-12-31'
GROUP BY t."DATE"
ORDER BY t."DATE"
LIMIT 20;
