```sql
/*  Cumulative “near‑default” mortgage ratio in California (geoId/06) for every
    2023 observation date.  The ratio is the sum of the statewide (“All Mortgages”)
    percentages that are:
        • 90‑to‑180 days past‑due
        • in forbearance
        • in foreclosure / bankruptcy / deed‑in‑lieu
*/
WITH relevant_variables AS (
    SELECT "VARIABLE"
    FROM US_REAL_ESTATE.CYBERSYN.FHFA_MORTGAGE_PERFORMANCE_ATTRIBUTES
    WHERE "MARKET" = 'All Mortgages'
      AND "VARIABLE_GROUP" IN (
            'Percent 90 to 180 Days Past Due Date',
            'Percent in Forbearance',
            'Percent in Foreclosure, Bankruptcy & Deed in Lieu'
      )
)
SELECT
    t."DATE"                           AS record_date,
    ROUND(SUM(t."VALUE"), 4)           AS cumulative_near_default_ratio
FROM US_REAL_ESTATE.CYBERSYN.FHFA_MORTGAGE_PERFORMANCE_TIMESERIES t
JOIN relevant_variables rv
          ON t."VARIABLE" = rv."VARIABLE"
WHERE t."GEO_ID" = 'geoId/06'          -- California
  AND t."DATE" BETWEEN '2023-01-01' AND '2023-12-31'
GROUP BY t."DATE"
ORDER BY t."DATE"
;
```
