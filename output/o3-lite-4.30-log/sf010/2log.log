```sql
--Description:  (Query 7)  Show the three “near‑default” indicator series side‑by‑side for
--               each 2023 observation date in California.  Broader wildcard patterns are
--               used so foreclosure‑type variables that include Bankruptcy or Deed‑in‑Lieu
--               are captured.  The query pivots the three components into columns.
SELECT
    t."DATE",
    MAX(CASE WHEN t."VARIABLE" ILIKE 'Percent_90_to_180_Days_Past_Due_Date_%'
             THEN t."VALUE" END)                                             AS "pct_90_180_past_due",
    MAX(CASE WHEN t."VARIABLE" ILIKE 'Percent_in_Forbearance_%'
             THEN t."VALUE" END)                                             AS "pct_in_forbearance",
    MAX(CASE WHEN t."VARIABLE" ILIKE '%Foreclosure%'
          OR  t."VARIABLE" ILIKE '%Bankruptcy%'
          OR  t."VARIABLE" ILIKE '%Deed%' 
             THEN t."VALUE" END)                                             AS "pct_in_foreclosure",
    -- optional cumulative column
    MAX(CASE WHEN t."VARIABLE" ILIKE 'Percent_90_to_180_Days_Past_Due_Date_%'
             THEN t."VALUE" END)
  + MAX(CASE WHEN t."VARIABLE" ILIKE 'Percent_in_Forbearance_%'
             THEN t."VALUE" END)
  + MAX(CASE WHEN t."VARIABLE" ILIKE '%Foreclosure%'
          OR  t."VARIABLE" ILIKE '%Bankruptcy%'
          OR  t."VARIABLE" ILIKE '%Deed%' 
             THEN t."VALUE" END)                                             AS "cumulative_near_default_ratio"
FROM US_REAL_ESTATE.CYBERSYN.FHFA_MORTGAGE_PERFORMANCE_TIMESERIES t
WHERE t."GEO_ID" = 'geoId/06'
  AND t."DATE" BETWEEN '2023-01-01' AND '2023-12-31'
  AND (
          t."VARIABLE" ILIKE 'Percent_90_to_180_Days_Past_Due_Date_%'
       OR t."VARIABLE" ILIKE 'Percent_in_Forbearance_%'
       OR t."VARIABLE" ILIKE '%Foreclosure%'
       OR t."VARIABLE" ILIKE '%Bankruptcy%'
       OR t."VARIABLE" ILIKE '%Deed%'
      )
GROUP BY t."DATE"
ORDER BY t."DATE"
LIMIT 20;
```

```sql
--Description:  (Query 8)  Compute the cumulative “near‑default” mortgage ratio for each
--               2023 California date by summing the three components.  Uses broad wildcard
--               filters to catch all foreclosure‑related variables.
WITH base AS (
    SELECT
        "DATE",
        CASE
            WHEN "VARIABLE" ILIKE 'Percent_90_to_180_Days_Past_Due_Date_%' THEN 'past_due'
            WHEN "VARIABLE" ILIKE 'Percent_in_Forbearance_%'               THEN 'forbearance'
            WHEN "VARIABLE" ILIKE '%Foreclosure%'
              OR "VARIABLE" ILIKE '%Bankruptcy%'
              OR "VARIABLE" ILIKE '%Deed%'                                 THEN 'foreclosure'
        END AS grp,
        "VALUE"
    FROM US_REAL_ESTATE.CYBERSYN.FHFA_MORTGAGE_PERFORMANCE_TIMESERIES
    WHERE "GEO_ID" = 'geoId/06'
      AND "DATE" BETWEEN '2023-01-01' AND '2023-12-31'
      AND (
              "VARIABLE" ILIKE 'Percent_90_to_180_Days_Past_Due_Date_%'
           OR "VARIABLE" ILIKE 'Percent_in_Forbearance_%'
           OR "VARIABLE" ILIKE '%Foreclosure%'
           OR "VARIABLE" ILIKE '%Bankruptcy%'
           OR "VARIABLE" ILIKE '%Deed%'
          )
)
SELECT
    "DATE",
    SUM(CASE WHEN grp = 'past_due'     THEN "VALUE" END) AS "pct_90_180_past_due",
    SUM(CASE WHEN grp = 'forbearance'  THEN "VALUE" END) AS "pct_in_forbearance",
    SUM(CASE WHEN grp = 'foreclosure'  THEN "VALUE" END) AS "pct_in_foreclosure",
    SUM("VALUE")                                         AS "cumulative_near_default_ratio"
FROM base
GROUP BY "DATE"
ORDER BY "DATE"
LIMIT 20;
```

