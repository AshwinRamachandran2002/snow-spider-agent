```sql
-- 7) Description:  Show the three indicator series side‑by‑side for each 2023 date
SELECT  t."DATE",
        MAX(CASE WHEN t."VARIABLE" ILIKE 'Percent_90_to_180_Days_Past_Due_Date_%' THEN t."VALUE" END)  AS "pct_90_180_past_due",
        MAX(CASE WHEN t."VARIABLE" ILIKE 'Percent_in_Forbearance_%'                 THEN t."VALUE" END)  AS "pct_in_forbearance",
        MAX(CASE WHEN t."VARIABLE" ILIKE 'Percent_in_Foreclosure%'                  THEN t."VALUE" END)  AS "pct_in_foreclosure"
FROM US_REAL_ESTATE.CYBERSYN.FHFA_MORTGAGE_PERFORMANCE_TIMESERIES t
WHERE t."GEO_ID" = 'geoId/06'
  AND t."DATE" BETWEEN '2023-01-01' AND '2023-12-31'
  AND (  t."VARIABLE" ILIKE 'Percent_90_to_180_Days_Past_Due_Date_%'
      OR t."VARIABLE" ILIKE 'Percent_in_Forbearance_%'
      OR t."VARIABLE" ILIKE 'Percent_in_Foreclosure%' )
GROUP BY t."DATE"
ORDER BY t."DATE"
LIMIT 20;
```

```sql
-- 8) Description:  Calculate cumulative “near‑default” ratio (simple sum of the three components)
WITH base AS (
    SELECT "DATE",
           CASE
               WHEN "VARIABLE" ILIKE 'Percent_90_to_180_Days_Past_Due_Date_%' THEN 'past_due'
               WHEN "VARIABLE" ILIKE 'Percent_in_Forbearance_%'               THEN 'forbearance'
               WHEN "VARIABLE" ILIKE 'Percent_in_Foreclosure%'                THEN 'foreclosure'
           END AS grp,
           "VALUE"
    FROM US_REAL_ESTATE.CYBERSYN.FHFA_MORTGAGE_PERFORMANCE_TIMESERIES
    WHERE "GEO_ID" = 'geoId/06'
      AND "DATE" BETWEEN '2023-01-01' AND '2023-12-31'
      AND (  "VARIABLE" ILIKE 'Percent_90_to_180_Days_Past_Due_Date_%'
          OR "VARIABLE" ILIKE 'Percent_in_Forbearance_%'
          OR "VARIABLE" ILIKE 'Percent_in_Foreclosure%' )
)
SELECT "DATE",
       SUM(CASE WHEN grp='past_due'     THEN "VALUE" END) AS "pct_90_180_past_due",
       SUM(CASE WHEN grp='forbearance'  THEN "VALUE" END) AS "pct_in_forbearance",
       SUM(CASE WHEN grp='foreclosure'  THEN "VALUE" END) AS "pct_in_foreclosure",
       SUM("VALUE")                                       AS "cumulative_near_default_ratio"
FROM base
GROUP BY "DATE"
ORDER BY "DATE"
LIMIT 20;
```

```sql
-- 9) Description:  Same calculation, but explicitly joining the attributes table and limiting to “Overall Market”
WITH target_vars AS (
    SELECT "VARIABLE"
    FROM US_REAL_ESTATE.CYBERSYN.FHFA_MORTGAGE_PERFORMANCE_ATTRIBUTES
    WHERE "VARIABLE_GROUP" IN ('Percent 90 to 180 Days Past Due Date',
                               'Percent in Forbearance',
                               'Percent in Foreclosure, Bankruptcy & Deed in Lieu')
      AND "MARKET" = 'Overall Market'
)
SELECT  t."DATE",
        SUM(CASE WHEN a."VARIABLE_GROUP" = 'Percent 90 to 180 Days Past Due Date'                THEN t."VALUE" END) AS "pct_90_180_past_due",
        SUM(CASE WHEN a."VARIABLE_GROUP" = 'Percent in Forbearance'                             THEN t."VALUE" END) AS "pct_in_forbearance",
        SUM(CASE WHEN a."VARIABLE_GROUP" = 'Percent in Foreclosure, Bankruptcy & Deed in Lieu'  THEN t."VALUE" END) AS "pct_in_foreclosure",
        SUM(t."VALUE") AS "cumulative_near_default_ratio"
FROM US_REAL_ESTATE.CYBERSYN.FHFA_MORTGAGE_PERFORMANCE_TIMESERIES t
JOIN US_REAL_ESTATE.CYBERSYN.FHFA_MORTGAGE_PERFORMANCE_ATTRIBUTES a
      ON t."VARIABLE" = a."VARIABLE"
WHERE t."GEO_ID" = 'geoId/06'
  AND t."DATE" BETWEEN '2023-01-01' AND '2023-12-31'
  AND t."VARIABLE" IN (SELECT "VARIABLE" FROM target_vars)
GROUP BY t."DATE"
ORDER BY t."DATE"
LIMIT 20;
```

```sql
-- 10) Description:  Add a running average of the cumulative ratio across 2023 observation dates
WITH target AS (
    SELECT  t."DATE",
            a."VARIABLE_GROUP",
            t."VALUE"
    FROM US_REAL_ESTATE.CYBERSYN.FHFA_MORTGAGE_PERFORMANCE_TIMESERIES t
    JOIN US_REAL_ESTATE.CYBERSYN.FHFA_MORTGAGE_PERFORMANCE_ATTRIBUTES a
      ON t."VARIABLE" = a."VARIABLE"
    WHERE t."GEO_ID" = 'geoId/06'
      AND t."DATE" BETWEEN '2023-01-01' AND '2023-12-31'
      AND a."MARKET" = 'Overall Market'
      AND a."VARIABLE_GROUP" IN ('Percent 90 to 180 Days Past Due Date',
                                 'Percent in Forbearance',
                                 'Percent in Foreclosure, Bankruptcy & Deed in Lieu')
)
SELECT "DATE",
       SUM("VALUE")                                              AS "cumulative_near_default_ratio",
       AVG(SUM("VALUE")) OVER (ORDER BY "DATE" 
                               ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) 
                                                               AS "running_avg_ratio_2023"
FROM target
GROUP BY "DATE"
ORDER BY "DATE"
LIMIT 20;
```

