Begin Exploring Related Columns
Relevant columns and how they can be used  

races.year : season to group all race–level data.  
constructor_standings.constructor_id / points : team points earned (cumulative – take MAX per season).  
driver_standings.driver_id / points : driver points (cumulative – take MAX per season).  
results.race_id / driver_id / constructor_id : lets us attach every driver‑standing row to the constructor he was driving for at that race.  
constructors.constructor_id / name : human‑readable constructor name.

Typical conditions  
• Join driver_standings → results on (race_id , driver_id) to know which constructor the driver belonged to in that race.  
• Join every race‑related table to races on race_id to expose the season (year).  
• Aggregate with MAX(points) to capture the season‑ending totals (those are the largest cumulative values).  
• Aggregate by (constructor_id , year) to keep season scope.  
• Finally add the driver MAX and constructor MAX to obtain “combined points”; sort and keep the three highest rows.

Ten exploratory → final SQL queries
(each limited to 20 rows for safety)

```sql
-- 1. Distinct seasons that exist in the data
SELECT DISTINCT "year"
FROM "races"
ORDER BY "year"
LIMIT 20;
```

```sql
-- 2. Quick look at raw constructor‑standings rows
SELECT *
FROM "constructor_standings"
LIMIT 20;
```

```sql
-- 3. Constructors that appear in constructor_standings
SELECT DISTINCT c."constructor_id",
       c."name"
FROM   "constructors"            AS c
JOIN   "constructor_standings"   AS cs
  ON   cs."constructor_id" = c."constructor_id"
LIMIT 20;
```

```sql
-- 4. Attach every driver‑standing row to the constructor for that race
SELECT ds."race_id",
       ds."driver_id",
       r."constructor_id",
       ds."points"
FROM   "driver_standings" AS ds
JOIN   "results"          AS r
  ON   r."race_id"  = ds."race_id"
 AND   r."driver_id" = ds."driver_id"
LIMIT 20;
```

```sql
-- 5. Same as (4) but with the season revealed
SELECT ra."year",
       ds."driver_id",
       r."constructor_id",
       ds."points"
FROM   "driver_standings" AS ds
JOIN   "results"          AS r
  ON   r."race_id"  = ds."race_id"
 AND   r."driver_id" = ds."driver_id"
JOIN   "races"            AS ra
  ON   ra."race_id" = ds."race_id"
LIMIT 20;
```

```sql
-- 6. Best (maximum) driver points per constructor‑season
SELECT ra."year",
       r."constructor_id",
       MAX(ds."points")          AS "best_driver_pts"
FROM   "driver_standings" AS ds
JOIN   "results"          AS r
  ON   r."race_id"  = ds."race_id"
 AND   r."driver_id" = ds."driver_id"
JOIN   "races"            AS ra
  ON   ra."race_id" = ds."race_id"
GROUP BY ra."year", r."constructor_id"
LIMIT 20;
```

```sql
-- 7. Team (constructor) season points – maximum cumulative value in that year
SELECT ra."year",
       cs."constructor_id",
       MAX(cs."points")          AS "team_pts"
FROM   "constructor_standings" AS cs
JOIN   "races"                 AS ra
  ON   ra."race_id" = cs."race_id"
GROUP BY ra."year", cs."constructor_id"
LIMIT 20;
```

```sql
-- 8. Combine the two seasonal aggregates into one table
WITH best_driver AS (
       SELECT ra."year",
              r."constructor_id",
              MAX(ds."points") AS "best_driver_pts"
       FROM   "driver_standings" AS ds
       JOIN   "results"          AS r
         ON   r."race_id"  = ds."race_id"
        AND  r."driver_id" = ds."driver_id"
       JOIN   "races"            AS ra
         ON   ra."race_id" = ds."race_id"
       GROUP BY ra."year", r."constructor_id"
),
team_points AS (
       SELECT ra."year",
              cs."constructor_id",
              MAX(cs."points") AS "team_pts"
       FROM   "constructor_standings" AS cs
       JOIN   "races"                 AS ra
         ON   ra."race_id" = cs."race_id"
       GROUP BY ra."year", cs."constructor_id"
)
SELECT bd."year",
       bd."constructor_id",
       bd."best_driver_pts",
       tp."team_pts",
       bd."best_driver_pts" + tp."team_pts" AS "combined_pts"
FROM   best_driver AS bd
JOIN   team_points AS tp
  ON   tp."year"          = bd."year"
 AND  tp."constructor_id" = bd."constructor_id"
LIMIT 20;
```

```sql
-- 9. Add readable constructor name to the combined table
WITH combined AS (
       -- reuse CTE from query (8)
       WITH best_driver AS (
              SELECT ra."year",
                     r."constructor_id",
                     MAX(ds."points") AS "best_driver_pts"
              FROM   "driver_standings" AS ds
              JOIN   "results"          AS r
                ON   r."race_id"  = ds."race_id"
               AND  r."driver_id" = ds."driver_id"
              JOIN   "races"            AS ra
                ON   ra."race_id" = ds."race_id"
              GROUP BY ra."year", r."constructor_id"
       ),
       team_points AS (
              SELECT ra."year",
                     cs."constructor_id",
                     MAX(cs."points") AS "team_pts"
              FROM   "constructor_standings" AS cs
              JOIN   "races"                 AS ra
                ON   ra."race_id" = cs."race_id"
              GROUP BY ra."year", cs."constructor_id"
       )
       SELECT bd."year",
              bd."constructor_id",
              bd."best_driver_pts" + tp."team_pts" AS "combined_pts"
       FROM   best_driver AS bd
       JOIN   team_points AS tp
         ON   tp."year"          = bd."year"
        AND  tp."constructor_id" = bd."constructor_id"
)
SELECT c."name",
       comb."year",
       comb."combined_pts"
FROM   combined      AS comb
JOIN   "constructors" AS c
  ON   c."constructor_id" = comb."constructor_id"
LIMIT 20;
```

```sql
-- 10. Final answer: the three constructor‑season combinations
--     with the largest “best driver + team” points total
WITH best_driver AS (
       SELECT ra."year",
              r."constructor_id",
              MAX(ds."points") AS "best_driver_pts"
       FROM   "driver_standings" AS ds
       JOIN   "results"          AS r
         ON   r."race_id"  = ds."race_id"
        AND  r."driver_id" = ds."driver_id"
       JOIN   "races"            AS ra
         ON   ra."race_id" = ds."race_id"
       GROUP BY ra."year", r."constructor_id"
),
team_points AS (
       SELECT ra."year",
              cs."constructor_id",
              MAX(cs."points") AS "team_pts"
       FROM   "constructor_standings" AS cs
       JOIN   "races"                 AS ra
         ON   ra."race_id" = cs."race_id"
       GROUP BY ra."year", cs."constructor_id"
),
combined AS (
       SELECT bd."year",
              bd."constructor_id",
              bd."best_driver_pts" + tp."team_pts" AS "combined_pts"
       FROM   best_driver AS bd
       JOIN   team_points AS tp
         ON   tp."year"          = bd."year"
        AND  tp."constructor_id" = bd."constructor_id"
)
SELECT c."name"             AS "constructor_name",
       comb."year",
       comb."combined_pts"
FROM   combined      AS comb
JOIN   "constructors" AS c
  ON   c."constructor_id" = comb."constructor_id"
ORDER BY comb."combined_pts" DESC
LIMIT 3;
```
