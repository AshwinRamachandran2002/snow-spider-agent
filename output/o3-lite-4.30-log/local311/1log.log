-- 8. 2009 – combined (team + best driver) points for every constructor
SELECT c.name,
       combo.constructor_points,
       combo.best_driver_points,
       combo.constructor_points + combo.best_driver_points AS combined_points
FROM (
    /* team points */
    SELECT cs.constructor_id,
           cs.points                              AS constructor_points,
           ( SELECT MAX(ds.points)
             FROM driver_standings ds
             JOIN results res ON res.race_id = cs.race_id
                              AND res.driver_id = ds.driver_id
                              AND res.constructor_id = cs.constructor_id
             WHERE ds.race_id = cs.race_id
           )                                      AS best_driver_points
    FROM races r
    JOIN constructor_standings cs ON cs.race_id = r.race_id
    WHERE r.year = 2009
      AND r.round = (SELECT MAX(round) FROM races WHERE year = 2009)
) AS combo
JOIN constructors c ON c.constructor_id = combo.constructor_id
ORDER BY combined_points DESC
LIMIT 20;
