Relevant columns and their potential usage  

• races.year – to identify the season.  
• races.round – to detect the last round of every season (championship totals are stored after the last race).  
• races.race_id – join‑key to the *…_standings* tables.  
• constructor_standings.constructor_id – the team whose points we want.  
• constructor_standings.points – constructor / team points after a given race.  
• driver_standings.driver_id – driver whose points we want.  
• driver_standings.points – driver championship points after a given race.  
• results.constructor_id – lets us map every driver (in driver_standings) to the constructor they drove for in that race/season.  
• constructors.name (or constructors_ext.short_name) – readable constructor name to show in the final answer.  
• Condition clue – pick only the last race of each year, because that row contains the season‑total points (e.g. r.round = (SELECT MAX(round) …)).  

Below are ten exploratory → increasingly complex SQL queries (each limited to 20 rows) that lead up to the final answer.  

```sql
-- 1. Get a feel for the seasons that exist
SELECT DISTINCT "year"
FROM "races"
ORDER BY "year"
LIMIT 20;
```

```sql
-- 2. See the last round number held in each season
SELECT "year", MAX("round") AS "last_round"
FROM "races"
GROUP BY "year"
ORDER BY "year"
LIMIT 20;
```

```sql
-- 3. Retrieve the constructor‑standing rows of the last race of 1‑2 test seasons
SELECT cs."race_id", r."year", cs."constructor_id", cs."points"
FROM   "constructor_standings" AS cs
JOIN   "races"                AS r ON r."race_id" = cs."race_id"
WHERE  r."year" IN (2008, 2009)
  AND  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
ORDER BY r."year", cs."points" DESC
LIMIT 20;
```

```sql
-- 4. Look at driver‑standing rows (season totals) of the last race of 2008‑2009
SELECT ds."race_id", r."year", ds."driver_id", ds."points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r ON r."race_id" = ds."race_id"
WHERE  r."year" IN (2008, 2009)
  AND  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
ORDER BY r."year", ds."points" DESC
LIMIT 20;
```

```sql
-- 5. Map each of those driver‑standing rows to the constructor they drove for
SELECT r."year",
       ds."driver_id",
       res."constructor_id",
       ds."points"
FROM   "driver_standings"  AS ds
JOIN   "races"             AS r   ON r."race_id" = ds."race_id"
JOIN   "results"           AS res ON res."race_id" = ds."race_id"
                                   AND res."driver_id" = ds."driver_id"
WHERE  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
ORDER BY r."year", ds."points" DESC
LIMIT 20;
```

```sql
-- 6. For every constructor & season: best (max) driver‑points among its drivers
SELECT r."year",
       res."constructor_id",
       MAX(ds."points") AS "best_driver_points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r   ON r."race_id" = ds."race_id"
JOIN   "results"          AS res ON res."race_id" = ds."race_id"
                                   AND res."driver_id" = ds."driver_id"
WHERE  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
GROUP BY r."year", res."constructor_id"
ORDER BY "best_driver_points" DESC
LIMIT 20;
```

```sql
-- 7. Get the team (constructor) points for those same seasons & teams
SELECT r."year",
       cs."constructor_id",
       cs."points" AS "team_points"
FROM   "constructor_standings" AS cs
JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
WHERE  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
ORDER BY r."year", cs."points" DESC
LIMIT 20;
```

```sql
-- 8. Bring best‑driver points together with team points
WITH best_driver AS (
  SELECT r."year",
         res."constructor_id",
         MAX(ds."points") AS "best_driver_points"
  FROM   "driver_standings" AS ds
  JOIN   "races"            AS r   ON r."race_id" = ds."race_id"
  JOIN   "results"          AS res ON res."race_id" = ds."race_id"
                                     AND res."driver_id" = ds."driver_id"
  WHERE  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
  GROUP BY r."year", res."constructor_id"
)
SELECT bd."year",
       bd."constructor_id",
       bd."best_driver_points",
       cs."points" AS "team_points",
       (bd."best_driver_points" + cs."points") AS "combined_points"
FROM   best_driver          AS bd
JOIN   "constructor_standings" AS cs
       ON cs."constructor_id" = bd."constructor_id"
JOIN   "races"              AS r  ON r."race_id" = cs."race_id"
                                   AND r."year"  = bd."year"
WHERE  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
ORDER BY "combined_points" DESC
LIMIT 20;
```

```sql
-- 9. Rank all constructor‑season pairs by the combined points
WITH best_driver AS (
  SELECT r."year",
         res."constructor_id",
         MAX(ds."points") AS "best_driver_points"
  FROM   "driver_standings" AS ds
  JOIN   "races"            AS r   ON r."race_id" = ds."race_id"
  JOIN   "results"          AS res ON res."race_id" = ds."race_id"
                                     AND res."driver_id" = ds."driver_id"
  WHERE  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
  GROUP BY r."year", res."constructor_id"
)
SELECT bd."year",
       bd."constructor_id",
       (bd."best_driver_points" + cs."points") AS "combined_points"
FROM   best_driver          AS bd
JOIN   "constructor_standings" AS cs
       ON cs."constructor_id" = bd."constructor_id"
JOIN   "races"              AS r  ON r."race_id" = cs."race_id"
                                   AND r."year"  = bd."year"
WHERE  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
ORDER BY "combined_points" DESC
LIMIT 20;
```

```sql
-- 10. Final answer: top‑3 constructor‑season combos with readable team names
WITH best_driver AS (
  SELECT r."year",
         res."constructor_id",
         MAX(ds."points") AS "best_driver_points"
  FROM   "driver_standings" AS ds
  JOIN   "races"            AS r   ON r."race_id" = ds."race_id"
  JOIN   "results"          AS res ON res."race_id" = ds."race_id"
                                     AND res."driver_id" = ds."driver_id"
  WHERE  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
  GROUP BY r."year", res."constructor_id"
),
combined AS (
  SELECT bd."year",
         bd."constructor_id",
         (bd."best_driver_points" + cs."points") AS "combined_points"
  FROM   best_driver          AS bd
  JOIN   "constructor_standings" AS cs
         ON cs."constructor_id" = bd."constructor_id"
  JOIN   "races"              AS r  ON r."race_id" = cs."race_id"
                                     AND r."year"  = bd."year"
  WHERE  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
)
SELECT c."name"  AS "constructor",
       cmb."year",
       cmb."combined_points"
FROM   combined  AS cmb
JOIN   "constructors" AS c ON c."constructor_id" = cmb."constructor_id"
ORDER BY cmb."combined_points" DESC
LIMIT 3;
```

