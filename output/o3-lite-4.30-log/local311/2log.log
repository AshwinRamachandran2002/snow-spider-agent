-- 10. Final answer: top‑3 constructor‑season combos with readable team names
WITH best_driver AS (
  SELECT r."year",
         res."constructor_id",
         MAX(ds."points") AS "best_driver_points"
  FROM   "driver_standings" AS ds
  JOIN   "races"            AS r   ON r."race_id" = ds."race_id"
  JOIN   "results"          AS res ON res."race_id" = ds."race_id"
                                     AND res."driver_id" = ds."driver_id"
  WHERE  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
  GROUP BY r."year", res."constructor_id"
),
combined AS (
  SELECT bd."year",
         bd."constructor_id",
         (bd."best_driver_points" + cs."points") AS "combined_points"
  FROM   best_driver          AS bd
  JOIN   "constructor_standings" AS cs
         ON cs."constructor_id" = bd."constructor_id"
  JOIN   "races"              AS r  ON r."race_id" = cs."race_id"
                                     AND r."year"  = bd."year"
  WHERE  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
)
SELECT c."name"  AS "constructor",
       cmb."year",
       cmb."combined_points"
FROM   combined  AS cmb
JOIN   "constructors" AS c ON c."constructor_id" = cmb."constructor_id"
ORDER BY cmb."combined_points" DESC
LIMIT 3;
