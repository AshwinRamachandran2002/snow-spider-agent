        prev_state,
        prev_city,
        cur_state,
        cur_city,
        ((cur_lat - prev_lat)*(cur_lat - prev_lat) +
         (cur_lng - prev_lng)*(cur_lng - prev_lng)) AS dist2
    FROM ordered
