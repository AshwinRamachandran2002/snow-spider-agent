2025-05-01 03:16:55 - Thread-1255 (execute) - INFO - [Successfully corrected]
Successfully corrected. SQL:
--Description ▸ We must find the two consecutive cities that are farthest apart once the rows
--             are ordered by  geolocation_state → geolocation_city → geolocation_zip_code_prefix
--             → geolocation_lat → geolocation_lng.  Using a window (alias w) we grab the previous
--             row’s coordinates with LAG().  SQLite on this platform lacks SQRT/POW, but the pair
--             that maximises the squared Euclidean distance in degrees—(Δlat)² + (Δlng)²—is the
--             same pair that maximises the actual distance, so we work with the squared value.
--             The query returns that single pair (previous city/state and current city/state)
--             together with the distance².
SELECT
       prev_state,
       prev_city,
       geolocation_state  AS curr_state,
       geolocation_city   AS curr_city,
       ((geolocation_lat - prev_lat) * (geolocation_lat - prev_lat) +
        (geolocation_lng - prev_lng) * (geolocation_lng - prev_lng)
       ) AS squared_distance_deg
FROM (
        SELECT
               geolocation_state,
               geolocation_city,
               geolocation_lat,
               geolocation_lng,
               LAG(geolocation_state) OVER w AS prev_state,
               LAG(geolocation_city)  OVER w AS prev_city,
               LAG(geolocation_lat)   OVER w AS prev_lat,
               LAG(geolocation_lng)   OVER w AS prev_lng
        FROM   olist_geolocation
        WINDOW w AS (
               ORDER BY geolocation_state,
                        geolocation_city,
                        geolocation_zip_code_prefix,
                        geolocation_lat,
                        geolocation_lng
        )
) AS ordered_pairs
WHERE prev_lat IS NOT NULL                     -- discard the very first row (no predecessor)
ORDER BY squared_distance_deg DESC
LIMIT 1;
