    geolocation_state AS current_state,
    geolocation_city  AS current_city,
    prev_city,
    MAX(gap_sq)       AS max_gap_sq
FROM (
    SELECT
        geolocation_state,
        geolocation_city,
        LAG(geolocation_city) OVER (ORDER BY geolocation_state,
                                                geolocation_city,
                                                geolocation_zip_code_prefix,
                                                geolocation_lat,
                                                geolocation_lng) AS prev_city,
        ((geolocation_lat - LAG(geolocation_lat) OVER (
                ORDER BY geolocation_state,
                         geolocation_city,
                         geolocation_zip_code_prefix,
                         geolocation_lat,
                         geolocation_lng)) *
         (geolocation_lat - LAG(geolocation_lat) OVER (
                ORDER BY geolocation_state,
                         geolocation_city,
                         geolocation_zip_code_prefix,
                         geolocation_lat,
                         geolocation_lng)) +
         (geolocation_lng - LAG(geolocation_lng) OVER (
                ORDER BY geolocation_state,
                         geolocation_city,
                         geolocation_zip_code_prefix,
                         geolocation_lat,
                         geolocation_lng)) *
         (geolocation_lng - LAG(geolocation_lng) OVER (
                ORDER BY geolocation_state,
                         geolocation_city,
                         geolocation_zip_code_prefix,
                         geolocation_lat,
                         geolocation_lng))
        ) AS gap_sq
    FROM olist_geolocation
) sub
WHERE prev_city IS NOT NULL;
