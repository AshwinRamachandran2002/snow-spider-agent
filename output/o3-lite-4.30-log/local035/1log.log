--Description: Rank all squared distance gaps between consecutive rows (as defined
--             by the required ordering) and return the first 20, largest‑to‑smallest.
--             SQRT was removed; we rank by gap_sq instead.
SELECT *
FROM (
    SELECT
        geolocation_state,
        geolocation_city,
        prev_city,
        gap_sq,
        ROW_NUMBER() OVER (ORDER BY gap_sq DESC) AS gap_rank
    FROM (
        SELECT
            geolocation_state,
            geolocation_city,
            LAG(geolocation_city) OVER (ORDER BY geolocation_state,
                                                   geolocation_city,
                                                   geolocation_zip_code_prefix,
                                                   geolocation_lat,
                                                   geolocation_lng) AS prev_city,
            /* squared distance between current row and previous row */
            ((geolocation_lat - LAG(geolocation_lat) OVER (
                    ORDER BY geolocation_state,
                             geolocation_city,
                             geolocation_zip_code_prefix,
                             geolocation_lat,
                             geolocation_lng)) *
             (geolocation_lat - LAG(geolocation_lat) OVER (
                    ORDER BY geolocation_state,
                             geolocation_city,
                             geolocation_zip_code_prefix,
                             geolocation_lat,
                             geolocation_lng)) +
             (geolocation_lng - LAG(geolocation_lng) OVER (
                    ORDER BY geolocation_state,
                             geolocation_city,
                             geolocation_zip_code_prefix,
                             geolocation_lat,
                             geolocation_lng)) *
             (geolocation_lng - LAG(geolocation_lng) OVER (
                    ORDER BY geolocation_state,
                             geolocation_city,
                             geolocation_zip_code_prefix,
                             geolocation_lat,
                             geolocation_lng))
            ) AS gap_sq
        FROM olist_geolocation
    ) gaps
    WHERE prev_city IS NOT NULL
) ranked
ORDER BY gap_rank
LIMIT 20
