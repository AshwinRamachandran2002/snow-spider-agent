--Description: Compute the maximum squared distance (max_gap_sq) between any
--             two consecutive rows in the ordered sequence.
SELECT
    geolocation_state AS current_state,
    geolocation_city  AS current_city,
    prev_city,
    MAX(gap_sq)       AS max_gap_sq
FROM (
    SELECT
