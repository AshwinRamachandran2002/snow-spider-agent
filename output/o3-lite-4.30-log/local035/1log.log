WITH ordered AS (
    SELECT
        ROW_NUMBER() OVER (
            ORDER BY geolocation_state,
                     geolocation_city,
                     geolocation_zip_code_prefix,
                     geolocation_lat,
                     geolocation_lng
        )                                       AS rn,
