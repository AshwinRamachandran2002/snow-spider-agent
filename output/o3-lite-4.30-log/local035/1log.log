Query:
--Description: Return the consecutive‑row pair (previous & current) that exhibits
--             the largest squared distance gap; includes both cities and gap_sq.
WITH ordered AS (
    SELECT
        ROW_NUMBER() OVER (
            ORDER BY geolocation_state,
                     geolocation_city,
                     geolocation_zip_code_prefix,
                     geolocation_lat,
                     geolocation_lng) AS seq,
        geolocation_state,
        geolocation_city,
        geolocation_zip_code_prefix,
        geolocation_lat,
        geolocation_lng
    FROM olist_geolocation
),
gaps AS (
    SELECT
        cur.seq,
        cur.geolocation_state AS current_state,
        cur.geolocation_city  AS current_city,
        cur.geolocation_lat,
        cur.geolocation_lng,
        prev.geolocation_city AS previous_city,
        prev.geolocation_lat  AS prev_lat,
        prev.geolocation_lng  AS prev_lng,
        ((cur.geolocation_lat - prev.geolocation_lat) *
         (cur.geolocation_lat - prev.geolocation_lat) +
         (cur.geolocation_lng - prev.geolocation_lng) *
         (cur.geolocation_lng - prev.geolocation_lng)) AS gap_sq
    FROM ordered cur
    JOIN ordered prev
      ON prev.seq = cur.seq - 1
)
SELECT *
FROM gaps
ORDER BY gap_sq DESC
LIMIT 20
