-- 10. FINAL ANSWER: the female baby name with the highest Wyoming share in 2021
--    (i.e., the greatest proportion of its total U.S. births occurred in Wyoming)
SELECT
  name,
  SUM(CASE WHEN state = 'WY' THEN number END) AS wy_births,
  SUM(number)                                         AS us_births,
  SAFE_DIVIDE(SUM(CASE WHEN state = 'WY' THEN number END), SUM(number)) AS wy_share
FROM `bigquery-public-data.usa_names.usa_1910_current`
WHERE gender = 'F' AND year = 2021
GROUP BY name
HAVING wy_births IS NOT NULL
ORDER BY wy_share DESC, wy_births DESC
LIMIT 1;
