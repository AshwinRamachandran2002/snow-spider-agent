  wy.name,
  wy.wy_number,
  us.us_number,
  wy.wy_number / us.us_number AS wy_share,
  DENSE_RANK() OVER (ORDER BY wy.wy_number / us.us_number DESC) AS wy_rank
FROM (
  SELECT name, SUM(number) AS wy_number
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE state = 'WY' AND gender = 'F' AND year = 2021
  GROUP BY name
) AS wy
JOIN (
  SELECT name, SUM(number) AS us_number
  FROM `bigquery-public-data.usa_names.usa_1910_current`
  WHERE gender = 'F' AND year = 2021
  GROUP BY name
) AS us
USING (name)
ORDER BY wy_rank
LIMIT 20;
```

