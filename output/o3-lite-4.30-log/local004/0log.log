2025-05-01 03:05:38 - Thread-1177 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
orders."customer_id": customer identifier to group metrics.  
orders."order_id": used to join with payments and to count customer orders.  
orders."order_purchase_timestamp": to find the 1st and last purchase dates and derive the lifespan.  
order_payments."order_id": key to join with orders.  
order_payments."payment_value": amount paid per order; needed for averages and totals.  

Typical conditions  
orders."order_id"  = order_payments."order_id"   -- join orders with their payments.  
No status filter is required by the task (but could be added with orders."order_status" = 'delivered').  

Below are 10 exploratory‑to‑final SQLite queries, each limited to 20 rows where appropriate.

```sql
-- 1. List a sample of customers that have at least one order
SELECT DISTINCT "customer_id"
FROM "orders"
LIMIT 20;
```

```sql
-- 2. Inspect a few orders together with their purchase timestamps
SELECT "order_id",
       "customer_id",
       "order_purchase_timestamp"
FROM "orders"
LIMIT 20;
```

```sql
-- 3. Inspect a few payment records to see the values stored
SELECT "order_id",
       "payment_value"
FROM "order_payments"
LIMIT 20;
```

```sql
-- 4. Join orders with payments to verify the link between the two tables
SELECT o."order_id",
       o."customer_id",
       o."order_purchase_timestamp",
       p."payment_value"
FROM "orders"  AS o
JOIN "order_payments" AS p
  ON o."order_id" = p."order_id"
LIMIT 20;
```

```sql
-- 5. Compute number of orders and total payment per customer (sample)
SELECT o."customer_id",
       COUNT(DISTINCT o."order_id")  AS "num_orders",
       SUM(p."payment_value")        AS "total_payment"
FROM "orders"  AS o
JOIN "order_payments" AS p
  ON o."order_id" = p."order_id"
GROUP BY o."customer_id"
LIMIT 20;
```

```sql
-- 6. Add the average payment per order for each customer (sample)
SELECT o."customer_id",
       COUNT(DISTINCT o."order_id")            AS "num_orders",
       AVG(p."payment_value")                  AS "avg_payment_per_order"
FROM "orders"  AS o
JOIN "order_payments" AS p
  ON o."order_id" = p."order_id"
GROUP BY o."customer_id"
LIMIT 20;
```

```sql
-- 7. Retrieve first and last purchase dates per customer (sample)
SELECT o."customer_id",
       MIN(o."order_purchase_timestamp") AS "first_order",
       MAX(o."order_purchase_timestamp") AS "last_order"
FROM "orders"  AS o
GROUP BY o."customer_id"
LIMIT 20;
```

```sql
-- 8. Calculate customer lifespan in weeks (sample)
SELECT o."customer_id",
       (julianday(MAX(o."order_purchase_timestamp"))
        - julianday(MIN(o."order_purchase_timestamp"))) / 7.0  AS "raw_lifespan_weeks"
FROM "orders" AS o
GROUP BY o."customer_id"
LIMIT 20;
```

```sql
-- 9. Combine order counts, average payment, and lifespan, ordering by highest average payment (top 3)
WITH customer_metrics AS (
  SELECT o."customer_id",
         COUNT(DISTINCT o."order_id")                AS "num_orders",
         AVG(p."payment_value")                      AS "avg_payment_per_order",
         (julianday(MAX(o."order_purchase_timestamp"))
          - julianday(MIN(o."order_purchase_timestamp"))) / 7.0 AS "raw_weeks"
  FROM "orders" AS o
  JOIN "order_payments" AS p
    ON o."order_id" = p."order_id"
  GROUP BY o."customer_id"
)
SELECT "customer_id",
       "num_orders",
       "avg_payment_per_order",
       CASE WHEN "raw_weeks" < 1 THEN 1.0 ELSE "raw_weeks" END AS "lifespan_weeks"
FROM customer_metrics
ORDER BY "avg_payment_per_order" DESC
LIMIT 3;
```

```sql
-- 10. Final answer: number of orders, average payment per order, and lifespan (weeks)
WITH customer_orders AS (
  SELECT o."customer_id",
         COUNT(DISTINCT o."order_id")                AS "num_orders",
         SUM(p."payment_value")                      AS "total_payment",
         AVG(p."payment_value")                      AS "avg_payment_per_order",
         MIN(o."order_purchase_timestamp")           AS "first_order",
         MAX(o."order_purchase_timestamp")           AS "last_order"
  FROM "orders"         AS o
  JOIN "order_payments" AS p
    ON o."order_id" = p."order_id"
  GROUP BY o."customer_id"
), lifespans AS (
  SELECT "customer_id",
         "num_orders",
         "avg_payment_per_order",
         CASE
           WHEN ((julianday("last_order") - julianday("first_order")) / 7.0) < 1
           THEN 1.0
           ELSE  (julianday("last_order") - julianday("first_order")) / 7.0
         END AS "lifespan_weeks"
  FROM customer_orders
)
SELECT "customer_id",
       "num_orders",
       ROUND("avg_payment_per_order", 2) AS "avg_payment_per_order",
       ROUND("lifespan_weeks", 2)        AS "lifespan_weeks"
FROM lifespans
ORDER BY "avg_payment_per_order" DESC
LIMIT 3;
```
