Relevant columns and how they will be used  
(CoC_Number provides the state code – the first two characters.)  

• CoC_Number: derive state abbreviation with SUBSTR(CoC_Number,1,2)  
• Unsheltered_Homeless: unsheltered counts to be summed/compared  
• Count_Year: filter for the two years of interest (2015 and 2018)  

Typical conditions we will need  
• WHERE Count_Year IN (2015,2018)  
• HAVING SUM(Unsheltered_Homeless) > 0            -- avoid ÷0 when 2015 = 0  

Below are ten progressively more‑complex exploratory queries (all limited to a small number of rows) that culminate in the final answer.

```sql
-- 1. Peek at 2015 records: CoC, state, unsheltered counts
SELECT 
  CoC_Number,
  SUBSTR(CoC_Number,1,2) AS state,
  Unsheltered_Homeless,
  Count_Year
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE Count_Year = 2015
LIMIT 20;
```

```sql
-- 2. List all distinct years in the dataset
SELECT DISTINCT Count_Year
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
ORDER BY Count_Year
LIMIT 20;
```

```sql
-- 3. Show the first 20 distinct state abbreviations we can form from CoC_Number
SELECT DISTINCT SUBSTR(CoC_Number,1,2) AS state
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
ORDER BY state
LIMIT 20;
```

```sql
-- 4. National total unsheltered counts for 2015 and 2018
SELECT 
  Count_Year,
  SUM(Unsheltered_Homeless) AS natl_unsheltered
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE Count_Year IN (2015,2018)
GROUP BY Count_Year
ORDER BY Count_Year
LIMIT 20;
```

```sql
-- 5. State‑level unsheltered totals for 2015
SELECT 
  SUBSTR(CoC_Number,1,2) AS state,
  SUM(Unsheltered_Homeless) AS unsheltered_2015
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE Count_Year = 2015
GROUP BY state
ORDER BY state
LIMIT 20;
```

```sql
-- 6. State‑level unsheltered totals for 2018
SELECT 
  SUBSTR(CoC_Number,1,2) AS state,
  SUM(Unsheltered_Homeless) AS unsheltered_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE Count_Year = 2018
GROUP BY state
ORDER BY state
LIMIT 20;
```

```sql
-- 7. Combine the two years and compute each state’s % change
WITH base AS (
  SELECT SUBSTR(CoC_Number,1,2) AS state,
         SUM(CASE WHEN Count_Year=2015 THEN Unsheltered_Homeless END) AS u15,
         SUM(CASE WHEN Count_Year=2018 THEN Unsheltered_Homeless END) AS u18
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE Count_Year IN (2015,2018)
  GROUP BY state
)
SELECT
  state,
  u15,
  u18,
  SAFE_DIVIDE(u18-u15,u15)*100 AS pct_change
FROM base
WHERE u15 > 0
ORDER BY state
LIMIT 20;
```

```sql
-- 8. National average of the state‑level % changes
WITH base AS (
  SELECT SUBSTR(CoC_Number,1,2) AS state,
         SUM(CASE WHEN Count_Year=2015 THEN Unsheltered_Homeless END) AS u15,
         SUM(CASE WHEN Count_Year=2018 THEN Unsheltered_Homeless END) AS u18
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE Count_Year IN (2015,2018)
  GROUP BY state
  HAVING u15 > 0
)
SELECT AVG(SAFE_DIVIDE(u18-u15,u15)*100) AS natl_avg_pct_change
FROM base
LIMIT 20;
```

```sql
-- 9. Difference between each state’s % change and national average
WITH base AS (
  SELECT SUBSTR(CoC_Number,1,2) AS state,
         SUM(CASE WHEN Count_Year=2015 THEN Unsheltered_Homeless END) AS u15,
         SUM(CASE WHEN Count_Year=2018 THEN Unsheltered_Homeless END) AS u18
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE Count_Year IN (2015,2018)
  GROUP BY state
  HAVING u15 > 0
), stats AS (
  SELECT state,
         SAFE_DIVIDE(u18-u15,u15)*100 AS pct_change
  FROM base
), nat AS (
  SELECT AVG(pct_change) AS natl_avg FROM stats
)
SELECT 
  s.state,
  s.pct_change,
  n.natl_avg,
  ABS(s.pct_change - n.natl_avg) AS distance_from_avg
FROM stats s CROSS JOIN nat n
ORDER BY distance_from_avg
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: five states whose % change is closest to the national average
WITH base AS (
  SELECT SUBSTR(CoC_Number,1,2) AS state,
         SUM(CASE WHEN Count_Year=2015 THEN Unsheltered_Homeless END) AS u15,
         SUM(CASE WHEN Count_Year=2018 THEN Unsheltered_Homeless END) AS u18
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE Count_Year IN (2015,2018)
  GROUP BY state
  HAVING u15 > 0
), stats AS (
  SELECT state,
         SAFE_DIVIDE(u18-u15,u15)*100 AS pct_change
  FROM base
), nat AS (
  SELECT AVG(pct_change) AS natl_avg FROM stats
)
SELECT state
FROM (
  SELECT 
    s.state,
    ABS(s.pct_change - n.natl_avg) AS distance_from_avg
  FROM stats s CROSS JOIN nat n
  ORDER BY distance_from_avg
  LIMIT 5
)
LIMIT 5;
```
