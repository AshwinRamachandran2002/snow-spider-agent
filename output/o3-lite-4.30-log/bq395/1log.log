Begin Exploring Related Columns
Below are the columns that matter for the task and how they will be used  

• `CoC_Number` : to parse the 2‑letter state/territory abbreviation (e.g. ‘AK’ in ‘AK‑500’)  
• `Unsheltered_Homeless` : the metric we must aggregate  
• `Count_Year` : to isolate 2015 and 2018 records  
(Everything else in the table is not required for the requested calculation.)

The set of progressively more complex inspection / analysis queries is given next.  
Every query is self–contained, ends with `LIMIT 20`, and is preceded by a short description.

```sql
-- 1) Peek at raw rows to understand the data layout
SELECT *
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
LIMIT 20;
```

```sql
-- 2) See which years are represented in the table
SELECT DISTINCT Count_Year
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
ORDER BY Count_Year
LIMIT 20;
```

```sql
-- 3) Unsheltered homeless totals BY STATE for 2015
SELECT
  SUBSTR(CoC_Number, 1, 2) AS state,
  SUM(Unsheltered_Homeless) AS unsheltered_2015
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE Count_Year = 2015
GROUP BY state
ORDER BY unsheltered_2015 DESC
LIMIT 20;
```

```sql
-- 4) Unsheltered homeless totals BY STATE for 2018
SELECT
  SUBSTR(CoC_Number, 1, 2) AS state,
  SUM(Unsheltered_Homeless) AS unsheltered_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE Count_Year = 2018
GROUP BY state
ORDER BY unsheltered_2018 DESC
LIMIT 20;
```

```sql
-- 5) Combine 2015 and 2018 totals in one result (simple UNION check)
SELECT '2015' AS yr, SUBSTR(CoC_Number,1,2) AS state, SUM(Unsheltered_Homeless) AS total
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE Count_Year = 2015
GROUP BY state
UNION ALL
SELECT '2018', SUBSTR(CoC_Number,1,2), SUM(Unsheltered_Homeless)
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE Count_Year = 2018
GROUP BY state
LIMIT 20;
```

```sql
-- 6) Pivot the two years side‑by‑side for each state
SELECT
  SUBSTR(CoC_Number,1,2) AS state,
  SUM(CASE WHEN Count_Year = 2015 THEN Unsheltered_Homeless END) AS unsheltered_2015,
  SUM(CASE WHEN Count_Year = 2018 THEN Unsheltered_Homeless END) AS unsheltered_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE Count_Year IN (2015, 2018)
GROUP BY state
LIMIT 20;
```

```sql
-- 7) Compute the percentage change from 2015 to 2018 for every state
SELECT
  state,
  SAFE_DIVIDE(unsheltered_2018 - unsheltered_2015, unsheltered_2015) * 100 AS pct_change
FROM (
  SELECT
    SUBSTR(CoC_Number,1,2) AS state,
    SUM(CASE WHEN Count_Year = 2015 THEN Unsheltered_Homeless END) AS unsheltered_2015,
    SUM(CASE WHEN Count_Year = 2018 THEN Unsheltered_Homeless END) AS unsheltered_2018
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE Count_Year IN (2015, 2018)
  GROUP BY state
)
ORDER BY pct_change DESC
LIMIT 20;
```

```sql
-- 8) Derive the national average (mean) of those state percentage changes
WITH state_changes AS (
  SELECT
    SUBSTR(CoC_Number,1,2) AS state,
    SAFE_DIVIDE(
      SUM(CASE WHEN Count_Year = 2018 THEN Unsheltered_Homeless END) -
      SUM(CASE WHEN Count_Year = 2015 THEN Unsheltered_Homeless END),
      SUM(CASE WHEN Count_Year = 2015 THEN Unsheltered_Homeless END)
    ) * 100 AS pct_change
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE Count_Year IN (2015, 2018)
  GROUP BY state
)
SELECT AVG(pct_change) AS national_avg_pct_change
FROM state_changes
LIMIT 20;
```

```sql
-- 9) Attach every state’s pct_change to the national average and compute the absolute distance
WITH state_changes AS (
  SELECT
    SUBSTR(CoC_Number,1,2) AS state,
    SAFE_DIVIDE(
      SUM(CASE WHEN Count_Year = 2018 THEN Unsheltered_Homeless END) -
      SUM(CASE WHEN Count_Year = 2015 THEN Unsheltered_Homeless END),
      SUM(CASE WHEN Count_Year = 2015 THEN Unsheltered_Homeless END)
    ) * 100 AS pct_change
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE Count_Year IN (2015, 2018)
  GROUP BY state
),
national AS (
  SELECT AVG(pct_change) AS nat_avg FROM state_changes
)
SELECT
  s.state,
  s.pct_change,
  n.nat_avg,
  ABS(s.pct_change - n.nat_avg) AS distance_from_avg
FROM state_changes AS s
CROSS JOIN national AS n
ORDER BY distance_from_avg
LIMIT 20;
```

```sql
-- 10) FINAL query – five states whose pct_change is closest to the national average
WITH state_changes AS (
  SELECT
    SUBSTR(CoC_Number,1,2) AS state,
    SAFE_DIVIDE(
      SUM(CASE WHEN Count_Year = 2018 THEN Unsheltered_Homeless END) -
      SUM(CASE WHEN Count_Year = 2015 THEN Unsheltered_Homeless END),
      SUM(CASE WHEN Count_Year = 2015 THEN Unsheltered_Homeless END)
    ) * 100 AS pct_change
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE Count_Year IN (2015, 2018)
  GROUP BY state
),
national AS (
  SELECT AVG(pct_change) AS nat_avg FROM state_changes
)
SELECT
  s.state
FROM state_changes AS s
CROSS JOIN national AS n
ORDER BY ABS(s.pct_change - n.nat_avg)
LIMIT 5;
```
