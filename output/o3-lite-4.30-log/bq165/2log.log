```sql
/*  Per‑band copy‑number frequencies (Amplification, Gain, Loss, Homozygous deletion)
    for: breast carcinoma (Morph = '3111')  OR  adenocarcinoma (Topo = '0401')      */

WITH cohort_cases AS (                                   -- distinct patient cases
  SELECT DISTINCT CONCAT(RefNo,'-',CaseNo) AS case_id
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111'        -- breast cancer
     OR Topo  = '0401'        -- adenocarcinoma
),

band_segments AS (                                       -- map segments to bands
  SELECT
    b.chromosome,
    b.hg38_start,
    b.hg38_stop,
    b.cytoband_name,
    UPPER(cc.Type) AS type_up
  FROM `mitelman-db.prod.CytoConverted`  AS cc
  JOIN `mitelman-db.prod.Cytogen`        AS cy
    ON  cy.RefNo  = cc.RefNo
   AND cy.CaseNo = cc.CaseNo
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON  b.chromosome = cc.Chr
   AND b.hg38_start <= cc.Start
   AND b.hg38_stop  >= cc.End                 -- segment fully within the band
  WHERE cy.Morph = '3111' OR cy.Topo = '0401'
),

raw_counts AS (                                           -- classify copy‑number type
  SELECT
    chromosome,
    cytoband_name,
    hg38_start,
    hg38_stop,

    SUM(CASE WHEN REGEXP_CONTAINS(type_up, r'AMP') THEN 1 ELSE 0 END)      AS cnt_amp,
    SUM(CASE WHEN REGEXP_CONTAINS(type_up, r'GAIN') AND
                   NOT REGEXP_CONTAINS(type_up, r'AMP') THEN 1 ELSE 0 END) AS cnt_gain,
    SUM(CASE WHEN REGEXP_CONTAINS(type_up, r'LOSS') AND
                   NOT REGEXP_CONTAINS(type_up, r'HOM') THEN 1 ELSE 0 END) AS cnt_loss,
    SUM(CASE WHEN REGEXP_CONTAINS(type_up, r'HOM') THEN 1 ELSE 0 END)      AS cnt_homdel
  FROM band_segments
  GROUP BY chromosome, cytoband_name, hg38_start, hg38_stop
),

all_bands AS (                                            -- ensure zero‑filled bands
  SELECT chromosome, cytoband_name, hg38_start, hg38_stop
  FROM `mitelman-db.prod.CytoBands_hg38`
  WHERE REGEXP_CONTAINS(chromosome, r'^chr([1-9]|1[0-9]|2[0-2]|[XY])$')    -- chr1‑22,X,Y
),

tot AS (SELECT COUNT(*) AS total_cases FROM cohort_cases)

SELECT
  ab.cytoband_name                                                    AS chromosome_band,
  ab.hg38_start                                                       AS start_bp,
  ab.hg38_stop                                                        AS end_bp,

  COALESCE(rc.cnt_amp   ,0)                                           AS count_amplifications,
  ROUND(100.0 * COALESCE(rc.cnt_amp,0)    / total_cases, 2)           AS frequency_amplifications,

  COALESCE(rc.cnt_gain  ,0)                                           AS count_gains,
  ROUND(100.0 * COALESCE(rc.cnt_gain,0)   / total_cases, 2)           AS frequency_gains,

  COALESCE(rc.cnt_loss  ,0)                                           AS count_losses,
  ROUND(100.0 * COALESCE(rc.cnt_loss,0)   / total_cases, 2)           AS frequency_losses,

  COALESCE(rc.cnt_homdel,0)                                           AS count_homozygous_deletions,
  ROUND(100.0 * COALESCE(rc.cnt_homdel,0) / total_cases, 2)           AS frequency_homozygous_deletions
FROM all_bands ab
LEFT JOIN raw_counts rc
  ON  rc.chromosome     = ab.chromosome
  AND rc.cytoband_name  = ab.cytoband_name
  AND rc.hg38_start     = ab.hg38_start
  AND rc.hg38_stop      = ab.hg38_stop
CROSS JOIN tot
ORDER BY
  CASE                                                            -- chromosome order
    WHEN ab.chromosome = 'chrX' THEN 23
    WHEN ab.chromosome = 'chrY' THEN 24
    ELSE CAST(REGEXP_REPLACE(ab.chromosome, r'^chr', '') AS INT64)
  END,
  ab.hg38_start;
```
