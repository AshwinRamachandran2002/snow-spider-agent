```sql
/*  Chromosome‑band copy‑number profile for
    – breast carcinoma (Morph = '3111')
    – adenocarcinoma  (Topo  = '0401')
    Counts + frequencies (%, 2 decimals) of
    Amplifications | Gains | Losses | Homozygous deletions            */

WITH cohort_cases AS (               -- unique cases in either cohort
  SELECT DISTINCT CONCAT(RefNo,'-',CaseNo) AS case_id
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111'            -- breast cancer
     OR Topo  = '0401'            -- adenocarcinoma
),

band_segments AS (                  -- CytoConverted segments mapped to one band
  SELECT
    b.chromosome,
    b.hg38_start,
    b.hg38_stop,
    b.cytoband_name,
    UPPER(cc.Type) AS type_up                           -- normalised Type
  FROM `mitelman-db.prod.CytoConverted`  AS cc
  JOIN `mitelman-db.prod.Cytogen`        AS cy
    ON cy.RefNo  = cc.RefNo
   AND cy.CaseNo = cc.CaseNo
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON b.chromosome = cc.Chr
   AND b.hg38_start <= cc.Start
   AND b.hg38_stop  >= cc.End              -- segment fully within the band
  WHERE cy.Morph = '3111' OR cy.Topo = '0401'
),

raw_counts AS (                      -- counts per band (may be missing bands)
  SELECT
    chromosome,
    cytoband_name,
    hg38_start,
    hg38_stop,

    COUNTIF(type_up IN ('AMPLIFICATION','AMP','AMPLIFIED')) AS cnt_amp,
    COUNTIF(type_up = 'GAIN')                               AS cnt_gain,
    COUNTIF(type_up = 'LOSS')                               AS cnt_loss,
    COUNTIF(type_up IN ('HOMLOSS','HOMOZYGOUSDELETION','HOMDEL','HD'))
                                                           AS cnt_homdel
  FROM band_segments
  GROUP BY chromosome, cytoband_name, hg38_start, hg38_stop
),

all_bands AS (                      -- every cytoband on chr1‑22,X,Y
  SELECT
    chromosome,
    cytoband_name,
    hg38_start,
