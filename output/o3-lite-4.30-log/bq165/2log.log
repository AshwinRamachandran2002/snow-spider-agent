-- frequency of copy‑number events per cytogenetic band
WITH
/* all breast‑cancer (Morph = 3111) or adenocarcinoma (Topo = 0401) cases */
cohort_cases AS (                       -- 1 row / patient case
  SELECT DISTINCT CONCAT(RefNo,'-',CaseNo) AS case_id
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111'          -- breast cancer
     OR Topo  = '0401'          -- adenocarcinoma
),

/* every CytoConverted segment that belongs to the above cohort,
   mapped to the band that completely contains the segment           */
band_segments AS (
  SELECT
    b.chromosome,
    b.hg38_start,
    b.hg38_stop,
    b.cytoband_name,
    cc.Type                                -- Amplification | Gain | Loss | HomLoss
  FROM `mitelman-db.prod.CytoConverted`      cc
  JOIN `mitelman-db.prod.Cytogen`            cy
    ON  cy.RefNo  = cc.RefNo
    AND cy.CaseNo = cc.CaseNo
  JOIN `mitelman-db.prod.CytoBands_hg38`     b
    ON  b.chromosome = cc.Chr
    AND b.hg38_start <= cc.Start
    AND b.hg38_stop  >= cc.End              -- segment fully inside the band
  WHERE cy.Morph = '3111' OR cy.Topo = '0401'
)

/* final band‑level summary */
SELECT
  cytoband_name                                                     AS chromosome_band,
  hg38_start                                                        AS start_bp,
  hg38_stop                                                         AS end_bp,

  COUNTIF(Type = 'Amplification')                                   AS count_amplifications,
  ROUND(100 * COUNTIF(Type = 'Amplification') / total_cases, 2)     AS frequency_amplifications,

  COUNTIF(Type = 'Gain')                                            AS count_gains,
  ROUND(100 * COUNTIF(Type = 'Gain') / total_cases, 2)              AS frequency_gains,

  COUNTIF(Type = 'Loss')                                            AS count_losses,
  ROUND(100 * COUNTIF(Type = 'Loss') / total_cases, 2)              AS frequency_losses,

  COUNTIF(Type = 'HomLoss')                                         AS count_homozygous_deletions,
  ROUND(100 * COUNTIF(Type = 'HomLoss') / total_cases, 2)           AS frequency_homozygous_deletions
FROM band_segments
CROSS JOIN (SELECT COUNT(*) AS total_cases FROM cohort_cases)       -- scalar for % calculation
GROUP BY
  chromosome,
  cytoband_name,
  hg38_start,
  hg38_stop,
  total_cases
ORDER BY
  CASE
    WHEN chromosome = 'chrX' THEN 23
    WHEN chromosome = 'chrY' THEN 24
    ELSE CAST(REGEXP_REPLACE(chromosome, r'^chr', '') AS INT64)
  END,
  hg38_start;Empty results in Column ['count_amplifications', 'count_homozygous_deletions']. Please correct them.

