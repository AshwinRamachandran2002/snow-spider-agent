/*  band–level copy‑number profile for breast cancer (Morph = 3111)
    and adenocarcinoma (Topo = 0401)                                */
WITH cohort_cases AS (     -- every distinct patient case
  SELECT DISTINCT CONCAT(RefNo,'-',CaseNo) AS case_id
  FROM `mitelman-db.prod.Cytogen`
  WHERE Morph = '3111'           -- breast carcinoma
     OR Topo  = '0401'           -- adenocarcinoma
),
band_segments AS (         -- CytoConverter segments mapped to one cytogenetic band
  SELECT
    b.chromosome,
    b.hg38_start,
    b.hg38_stop,
    b.cytoband_name,
    cc.Type
  FROM `mitelman-db.prod.CytoConverted`  AS cc
  JOIN `mitelman-db.prod.Cytogen`        AS cy
    ON cy.RefNo  = cc.RefNo
   AND cy.CaseNo = cc.CaseNo
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON b.chromosome = cc.Chr
   AND b.hg38_start <= cc.Start
   AND b.hg38_stop  >= cc.End            -- segment must lie completely in the band
  WHERE cy.Morph = '3111'
     OR cy.Topo  = '0401'
),
per_band AS (              -- raw counts per band, using multiple synonyms
  SELECT
    chromosome,
    cytoband_name,
    hg38_start,
    hg38_stop,
    COUNTIF(Type IN ('Amplification','Amp','Amplified'))                         AS count_amplifications,
    COUNTIF(Type = 'Gain')                                                      AS count_gains,
    COUNTIF(Type = 'Loss')                                                      AS count_losses,
    COUNTIF(Type IN ('HomLoss','HD','HomDel','HomozygousDeletion'))             AS count_homozygous_deletions
  FROM band_segments
  GROUP BY chromosome, cytoband_name, hg38_start, hg38_stop
),
tot AS (SELECT COUNT(*) AS total_cases FROM cohort_cases)

SELECT
  cytoband_name                                                     AS chromosome_band,
  hg38_start                                                        AS start_bp,
  hg38_stop                                                         AS end_bp,

  count_amplifications,
  ROUND(100 * count_amplifications / total_cases, 2)                AS frequency_amplifications,

  count_gains,
  ROUND(100 * count_gains / total_cases, 2)                         AS frequency_gains,

  count_losses,
  ROUND(100 * count_losses / total_cases, 2)                        AS frequency_losses,

  count_homozygous_deletions,
  ROUND(100 * count_homozygous_deletions / total_cases, 2)          AS frequency_homozygous_deletions
FROM per_band, tot
ORDER BY
  CASE                                                            -- chromosome order
    WHEN chromosome = 'chrX' THEN 23
    WHEN chromosome = 'chrY' THEN 24
    ELSE CAST(REGEXP_REPLACE(chromosome, r'^chr', '') AS INT64)
  END,
  hg38_start;
