```sql
/*  Frequency of copy‑number categories per cytogenetic band
    Cohort = breast cancer   (Morph = '3111')
           ∪ adenocarcinoma (Topo  = '0401')
    Categories:
        • Amplification  – gains of >1 copy  (Amp, Amplification, Gain2, Gain3 …)
        • Gain           – single‑copy gain  (Gain)
        • Loss           – single‑copy loss  (Loss)
        • HomDel         – ≥2‑copy loss      (HomDel, Loss2, Loss3 …)
*/

WITH cohort AS (
  SELECT
    cv.RefNo,
    cv.CaseNo,
    cv.InvNo,
    cv.Clone,
    cv.Chr,
    cv.Start,
    cv.End,
    /*  ---- classifying the CNV call ------------------------------------ */
    CASE
      WHEN REGEXP_CONTAINS(cv.Type, r'(?i)^(amp|amplification)$')         THEN 'Amplification'
      WHEN REGEXP_CONTAINS(cv.Type, r'(?i)amp')                           THEN 'Amplification'
      WHEN REGEXP_CONTAINS(cv.Type, r'(?i)^gain[^\w]*[2-9]')              THEN 'Amplification'
      WHEN REGEXP_CONTAINS(cv.Type, r'(?i)^(homdel|homodeletion)$')       THEN 'HomDel'
      WHEN REGEXP_CONTAINS(cv.Type, r'(?i)^loss[^\w]*[2-9]')              THEN 'HomDel'
      WHEN LOWER(cv.Type) = 'gain'                                        THEN 'Gain'
      WHEN LOWER(cv.Type) = 'loss'                                        THEN 'Loss'
      ELSE 'Other'
    END AS class
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN `mitelman-db.prod.Cytogen`       AS cy
    ON cy.RefNo  = cv.RefNo
   AND cy.CaseNo = cv.CaseNo
  WHERE cy.Morph = '3111'          -- breast cancer
     OR cy.Topo  = '0401'          -- adenocarcinoma
),
/* map each copy‑number event to every cytoband it overlaps */
band_map AS (
  SELECT DISTINCT
         CONCAT(RefNo,'_',CaseNo,'_',InvNo,'_',Clone) AS event_id,
         class,
         b.chromosome        AS Chr,
         b.cytoband_name     AS Band,
         b.hg38_start        AS BandStart,
         b.hg38_stop         AS BandStop
  FROM cohort AS c
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON c.Chr   = b.chromosome
   AND c.Start < b.hg38_stop            -- interval and band overlap
   AND c.End   > b.hg38_start
),
/* counts per band */
per_band AS (
  SELECT
    Chr,
    Band,
    BandStart,
    BandStop,
    COUNTIF(class = 'Amplification') AS n_amp,
    COUNTIF(class = 'Gain')          AS n_gain,
    COUNTIF(class = 'Loss')          AS n_loss,
    COUNTIF(class = 'HomDel')        AS n_homdel,
    COUNT(DISTINCT event_id)         AS total_events
  FROM band_map
  GROUP BY Chr, Band, BandStart, BandStop
),
/* percentage frequencies (2 decimal places) */
with_freq AS (
  SELECT
    *,
    ROUND(SAFE_DIVIDE(n_amp   * 100, total_events), 2) AS freq_amp,
    ROUND(SAFE_DIVIDE(n_gain  * 100, total_events), 2) AS freq_gain,
    ROUND(SAFE_DIVIDE(n_loss  * 100, total_events), 2) AS freq_loss,
    ROUND(SAFE_DIVIDE(n_homdel* 100, total_events), 2) AS freq_homdel
  FROM per_band
),
/* chromosome order for sorting (1–22, X=23, Y=24) */
ordered AS (
  SELECT
    *,
    CASE
      WHEN Chr = 'chrX' THEN 23
      WHEN Chr = 'chrY' THEN 24
      ELSE CAST(SUBSTR(Chr, 4) AS INT64)
    END AS chr_ord
  FROM with_freq
)
SELECT
  CONCAT(Chr, ':', Band)          AS chromosome_band,
  BandStart                       AS start_bp,
  BandStop                        AS end_bp,
  n_amp                           AS count_amplifications,
  freq_amp                        AS frequency_amplifications,
  n_gain                          AS count_gains,
  freq_gain                       AS frequency_gains,
  n_loss                          AS count_losses,
  freq_loss                       AS frequency_losses,
  n_homdel                        AS count_homozygous_deletions,
  freq_homdel                     AS frequency_homozygous_deletions
FROM ordered
ORDER BY chr_ord, BandStart, BandStop;
