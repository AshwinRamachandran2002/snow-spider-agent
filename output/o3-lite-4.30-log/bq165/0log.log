/*  Copy‑number event frequency per cytogenetic band for
    breast cancer (Morph = '3111') and adenocarcinoma (Topo = '0401')
*/
WITH cohort AS (
  SELECT
    cv.RefNo,
    cv.CaseNo,
    cv.InvNo,
    cv.Clone,
    cv.Chr,
    cv.Start,
    cv.End,
    /* classify CytoConverter call */
    CASE
      WHEN REGEXP_CONTAINS(cv.Type, r'(?i)amp')                              -- “Amp”, “Amplification”, etc.
        OR (LOWER(cv.Type) LIKE 'gain%' AND LOWER(cv.Type) <> 'gain')        -- “Gain2”, “Gain>1”, …
      THEN 'Amplification'
      WHEN REGEXP_CONTAINS(cv.Type, r'(?i)homdel')                           -- explicit HomDel
        OR (LOWER(cv.Type) LIKE 'loss2%')                                    -- “Loss2…”
        OR (LOWER(cv.Type) LIKE 'loss3%')                                    -- “Loss3…”
      THEN 'HomDel'
      WHEN LOWER(cv.Type) = 'gain'  THEN 'Gain'                              -- single‑copy gain
      WHEN LOWER(cv.Type) = 'loss'  THEN 'Loss'                              -- single‑copy loss
      ELSE 'Other'
    END AS class
  FROM `mitelman-db.prod.CytoConverted` AS cv
  JOIN `mitelman-db.prod.Cytogen`       AS cy
    ON cy.RefNo  = cv.RefNo
   AND cy.CaseNo = cv.CaseNo
  WHERE cy.Morph = '3111'             -- breast cancer
     OR cy.Topo  = '0401'             -- adenocarcinoma
),
/* map every event to the cytoband(s) it overlaps */
band_map AS (
  SELECT DISTINCT
         CONCAT(RefNo,'_',CaseNo,'_',InvNo,'_',Clone) AS event_id,
         class,
         b.chromosome            AS Chr,
         b.cytoband_name         AS Band,
         b.hg38_start            AS BandStart,
         b.hg38_stop             AS BandStop
  FROM cohort AS cv
  JOIN `mitelman-db.prod.CytoBands_hg38` AS b
    ON cv.Chr   = b.chromosome
   AND cv.Start < b.hg38_stop            -- overlap: interval starts before band ends
   AND cv.End   > b.hg38_start           --          and ends after band starts
),
/* counts per band */
per_band AS (
  SELECT
    Chr,
    Band,
    BandStart,
    BandStop,
    COUNTIF(class = 'Amplification') AS n_amp,
    COUNTIF(class = 'Gain')          AS n_gain,
    COUNTIF(class = 'Loss')          AS n_loss,
    COUNTIF(class = 'HomDel')        AS n_homdel,
    COUNT(DISTINCT event_id)         AS total_events
  FROM band_map
  GROUP BY Chr, Band, BandStart, BandStop
),
/* add percentage frequencies (2 decimals) */
with_freq AS (
  SELECT
    *,
    ROUND(100 * n_amp    / total_events, 2) AS freq_amp,
    ROUND(100 * n_gain   / total_events, 2) AS freq_gain,
    ROUND(100 * n_loss   / total_events, 2) AS freq_loss,
    ROUND(100 * n_homdel / total_events, 2) AS freq_homdel
  FROM per_band
),
/* numeric chromosome order for proper sorting */
ordered AS (
  SELECT
    *,
    CASE
      WHEN Chr = 'chrX' THEN 23
      WHEN Chr = 'chrY' THEN 24
      ELSE CAST(SUBSTR(Chr, 4) AS INT64)
    END AS chr_ord
  FROM with_freq
)
SELECT
  CONCAT(Chr, ':', Band)  AS chromosome_band,
  BandStart               AS start_bp,
  BandStop                AS end_bp,
  n_amp                   AS count_amplifications,
  freq_amp                AS frequency_amplifications,
  n_gain                  AS count_gains,
  freq_gain               AS frequency_gains,
  n_loss                  AS count_losses,
  freq_loss               AS frequency_losses,
  n_homdel                AS count_homozygous_deletions,
  freq_homdel             AS frequency_homozygous_deletions
FROM ordered
ORDER BY chr_ord, BandStart, BandStop;
