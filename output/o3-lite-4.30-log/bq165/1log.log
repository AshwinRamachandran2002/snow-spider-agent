  cnt_homdel                                                AS count_homozygous_deletions,
  ROUND(100 * cnt_homdel        / ts.n_cohort_samples, 2)   AS frequency_homozygous_deletions
FROM   band_counts, total_samples ts
/* sort by chromosome ordinal then genomic position */
ORDER BY
  CASE
    WHEN chromosome = 'chrX' THEN 23
    WHEN chromosome = 'chrY' THEN 24
    ELSE CAST(SUBSTR(chromosome, 4) AS INT64)  -- remove 'chr'
  END,
