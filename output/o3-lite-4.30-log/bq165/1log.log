```sql
/* ---------------------------------------------------------------
   Copy‑number events per cytogenetic band for the cohort of
   breast carcinoma (Morph = '3111') and adenocarcinoma (Topo = '0401')

   Output columns (CSV‑style header required by the task):
   chromosome_band,start_bp,end_bp,
   count_amplifications,frequency_amplifications,
   count_gains,frequency_gains,
   count_losses,frequency_losses,
   count_homozygous_deletions,frequency_homozygous_deletions
---------------------------------------------------------------- */
WITH
/* 1. Cohort ------------------------------------------------------- */
cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111'      -- breast carcinoma
     OR  Topo  = '0401'      -- adenocarcinoma
),
/* 2. CytoConverter segments belonging to the cohort -------------- */
raw_seg AS (
  SELECT
    cc.RefNo,
    cc.CaseNo,
    cc.InvNo,
    cc.Clone,
    cc.Chr,
    cc.Start,
    cc.End,
    TRIM(cc.Type) AS raw_type,
    CONCAT(cc.RefNo,'|',cc.CaseNo,'|',cc.InvNo,'|',cc.Clone) AS sample_id
  FROM   `mitelman-db.prod.CytoConverted` cc
  JOIN   cohort USING (RefNo, CaseNo)
),
/* 3. Normalise the event type ------------------------------------ */
seg AS (
  SELECT
    RefNo, CaseNo, InvNo, Clone,
    Chr, Start, End, sample_id,
    CASE
      WHEN LOWER(raw_type) LIKE 'amp%'          THEN 'Amplification'
      WHEN LOWER(raw_type) LIKE 'gain%'         THEN 'Gain'
      WHEN LOWER(raw_type) LIKE 'homozygous%'   THEN 'HomozygousDeletion'
      WHEN LOWER(raw_type) LIKE 'loss%'         THEN 'Loss'
      ELSE NULL
    END AS cnv_type
  FROM raw_seg
  WHERE raw_type IS NOT NULL
),
/* 4. Cohort size (unique samples) -------------------------------- */
cohort_size AS (
  SELECT COUNT(DISTINCT sample_id) AS n_samples FROM seg
),
/* 5. Intersect every segment with cytobands ---------------------- */
band_overlap AS (
  SELECT
    cb.chromosome,
    cb.cytoband_name,
    cb.hg38_start,
    cb.hg38_stop,
    s.cnv_type,
    s.sample_id
  FROM   seg s
  JOIN   `mitelman-db.prod.CytoBands_hg38` cb
         ON cb.chromosome = s.Chr
        AND NOT (s.End < cb.hg38_start OR s.Start > cb.hg38_stop)
  WHERE  s.cnv_type IS NOT NULL
),
/* 6. Count distinct samples per band and CNV class --------------- */
band_counts AS (
  SELECT
    chromosome,
    cytoband_name,
    hg38_start,
    hg38_stop,
    COUNT(DISTINCT IF(cnv_type = 'Amplification'      , sample_id, NULL)) AS cnt_amplifications,
    COUNT(DISTINCT IF(cnv_type = 'Gain'              , sample_id, NULL)) AS cnt_gains,
    COUNT(DISTINCT IF(cnv_type = 'Loss'              , sample_id, NULL)) AS cnt_losses,
    COUNT(DISTINCT IF(cnv_type = 'HomozygousDeletion', sample_id, NULL)) AS cnt_homdels
  FROM band_overlap
  GROUP BY chromosome, cytoband_name, hg38_start, hg38_stop
)
/* 7. Final report ------------------------------------------------- */
SELECT
  CONCAT(chromosome, cytoband_name)                                        AS chromosome_band,
  hg38_start                                                               AS start_bp,
  hg38_stop                                                                AS end_bp,
  COALESCE(cnt_amplifications,0)                                           AS count_amplifications,
  ROUND(100 * COALESCE(cnt_amplifications,0) / cs.n_samples, 2)            AS frequency_amplifications,
  COALESCE(cnt_gains,0)                                                    AS count_gains,
  ROUND(100 * COALESCE(cnt_gains,0)            / cs.n_samples, 2)          AS frequency_gains,
  COALESCE(cnt_losses,0)                                                   AS count_losses,
  ROUND(100 * COALESCE(cnt_losses,0)           / cs.n_samples, 2)          AS frequency_losses,
  COALESCE(cnt_homdels,0)                                                  AS count_homozygous_deletions,
  ROUND(100 * COALESCE(cnt_homdels,0)        / cs.n_samples, 2)            AS frequency_homozygous_deletions
FROM   band_counts, cohort_size cs
ORDER BY
  CASE
    WHEN chromosome = 'chrX' THEN 23
    WHEN chromosome = 'chrY' THEN 24
    ELSE CAST(SUBSTR(chromosome, 4) AS INT64)                              -- 1‑22
  END,
  hg38_start,
  hg38_stop;
