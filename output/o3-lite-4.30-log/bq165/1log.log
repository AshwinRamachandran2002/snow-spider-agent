cohort AS (
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111'        -- breast carcinoma
     OR  Topo  = '0401'        -- adenocarcinoma
),
/* 2. copy‑number segments ----------------------------------------- */
seg AS (
  SELECT
    cc.RefNo,
    cc.CaseNo,
    cc.InvNo,
    cc.Clone,
    cc.Chr,
    cc.Start,
    cc.End,
    cc.Type,   -- Gain, Amplification, Loss, HomozygousDeletion
    CONCAT(cc.RefNo,'|',cc.CaseNo,'|',cc.InvNo,'|',cc.Clone) AS sample_id
  FROM   `mitelman-db.prod.CytoConverted` cc
  JOIN   cohort USING (RefNo, CaseNo)
  WHERE  cc.Type IN ('Gain','Amplification','Loss','HomozygousDeletion')
),
/* 3. total number of distinct samples in cohort ------------------- */
cohort_size AS (
  SELECT COUNT(DISTINCT sample_id) AS n_samples FROM seg
),
/* 4. overlap every segment with every band it intersects ---------- */
band_map AS (
  SELECT
    cb.chromosome,
    cb.cytoband_name,
    cb.hg38_start,
    cb.hg38_stop,
    s.Type,
    s.sample_id
  FROM   seg s
  JOIN   `mitelman-db.prod.CytoBands_hg38` cb
         ON cb.chromosome = s.Chr
        AND NOT (s.End   < cb.hg38_start OR s.Start > cb.hg38_stop)
),
/* 5. count unique samples per band & CNV class -------------------- */
band_counts AS (
  SELECT
    chromosome,
    cytoband_name,
    hg38_start,
    hg38_stop,
    COUNT(DISTINCT IF(Type = 'Amplification'      , sample_id, NULL)) AS cnt_ampl,
    COUNT(DISTINCT IF(Type = 'Gain'              , sample_id, NULL)) AS cnt_gain,
    COUNT(DISTINCT IF(Type = 'Loss'              , sample_id, NULL)) AS cnt_loss,
    COUNT(DISTINCT IF(Type = 'HomozygousDeletion', sample_id, NULL)) AS cnt_homdel
  FROM band_map
  GROUP BY chromosome, cytoband_name, hg38_start, hg38_stop
)
/* 6. final output -------------------------------------------------- */
SELECT
  CONCAT(chromosome, cytoband_name)                             AS chromosome_band,
  hg38_start                                                    AS start_bp,
  hg38_stop                                                     AS end_bp,
  cnt_ampl                                                      AS count_amplifications,
  ROUND(100 * cnt_ampl  / cs.n_samples, 2)                      AS frequency_amplifications,
  cnt_gain                                                      AS count_gains,
  ROUND(100 * cnt_gain  / cs.n_samples, 2)                      AS frequency_gains,
  cnt_loss                                                      AS count_losses,
  ROUND(100 * cnt_loss  / cs.n_samples, 2)                      AS frequency_losses,
  cnt_homdel                                                    AS count_homozygous_deletions,
  ROUND(100 * cnt_homdel/ cs.n_samples, 2)                      AS frequency_homozygous_deletions
FROM   band_counts, cohort_size cs
ORDER BY
  CASE
    WHEN chromosome = 'chrX' THEN 23
    WHEN chromosome = 'chrY' THEN 24
    ELSE CAST(SUBSTR(chromosome, 4) AS INT64)   -- numeric chromosome order
  END,
  hg38_start,
