/*  --------  Chromosomal copy‑number landscape for breast carcinoma (Morph = 3111)
    and adenocarcinoma (Topo = 0401)
    – one line per cytogenetic band
    – absolute number of samples and cohort‑wide frequency (%) for
      Amplification (>1 copy gain), Gain (+1 copy), Loss (‑1 copy),
      HomozygousDeletion (‑2 copies)
--------------------------------------------------------------------- */
WITH
/* ---------- cohort definition ------------------------------------- */
cohort_cases AS (       -- every case that is breast carcinoma OR adenocarcinoma
  SELECT DISTINCT RefNo, CaseNo
  FROM   `mitelman-db.prod.Cytogen`
  WHERE  Morph = '3111'           -- breast carcinoma
     OR  Topo  = '0401'           -- adenocarcinoma
),
/* ---------- all copy‑number segments for that cohort -------------- */
segments AS (
  SELECT
    cc.RefNo,
    cc.CaseNo,
    cc.InvNo,
    cc.Clone,
    cc.Chr,
    cc.Start,
    cc.End,
    cc.Type,                           -- Gain, Amplification, Loss, HomozygousDeletion …
    CONCAT(cc.RefNo,'|',cc.CaseNo,'|',cc.InvNo,'|',cc.Clone) AS sample_key
  FROM   `mitelman-db.prod.CytoConverted` cc
  JOIN   cohort_cases                  USING (RefNo, CaseNo)
  WHERE  cc.Type IN ('Gain','Amplification','Loss','HomozygousDeletion')
),
/* ---------- total number of distinct samples in the cohort -------- */
total_samples AS (
  SELECT COUNT(DISTINCT sample_key) AS n_cohort_samples
  FROM   segments
),
/* ---------- assign every segment to every cytoband it overlaps ---- */
band_assign AS (
  SELECT
    cb.chromosome,
    cb.cytoband_name,
    cb.hg38_start,
    cb.hg38_stop,
    s.Type,
    s.sample_key
  FROM   segments                        AS s
  JOIN   `mitelman-db.prod.CytoBands_hg38` AS cb
         ON cb.chromosome = s.Chr
        AND NOT (s.End   < cb.hg38_start
                 OR s.Start > cb.hg38_stop)   -- overlap test
),
/* ---------- count distinct samples per band and CNV class --------- */
band_counts AS (
  SELECT
    chromosome,
    cytoband_name,
    hg38_start,
    hg38_stop,
    COUNT(DISTINCT IF(Type = 'Amplification'      , sample_key, NULL)) AS cnt_amplification,
    COUNT(DISTINCT IF(Type = 'Gain'              , sample_key, NULL)) AS cnt_gain,
    COUNT(DISTINCT IF(Type = 'Loss'              , sample_key, NULL)) AS cnt_loss,
    COUNT(DISTINCT IF(Type = 'HomozygousDeletion', sample_key, NULL)) AS cnt_homdel
  FROM   band_assign
  GROUP  BY chromosome, cytoband_name, hg38_start, hg38_stop
)
/* ---------- final output ------------------------------------------ */
SELECT
  CONCAT(chromosome, cytoband_name)                         AS chromosome_band,
  hg38_start                                                AS start_bp,
  hg38_stop                                                 AS end_bp,
  cnt_amplification                                         AS count_amplifications,
  ROUND(100 * cnt_amplification / ts.n_cohort_samples, 2)   AS frequency_amplifications,
  cnt_gain                                                  AS count_gains,
  ROUND(100 * cnt_gain           / ts.n_cohort_samples, 2)  AS frequency_gains,
  cnt_loss                                                  AS count_losses,
  ROUND(100 * cnt_loss           / ts.n_cohort_samples, 2)  AS frequency_losses,
  cnt_homdel                                                AS count_homozygous_deletions,
  ROUND(100 * cnt_homdel        / ts.n_cohort_samples, 2)   AS frequency_homozygous_deletions
FROM   band_counts, total_samples ts
/* sort by chromosome ordinal then genomic position */
