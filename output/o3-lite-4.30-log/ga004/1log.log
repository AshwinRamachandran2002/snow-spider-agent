Begin Exploring Related Columns
Relevant columns, why we need them, and typical filters  
• `event_date`: Limit the analysis to December 2020: `WHERE event_date BETWEEN '20201201' AND '20201231'`  
• `event_name`: Separate “page_view” and “purchase” events: `WHERE event_name = 'page_view' …` / `… = 'purchase'`  
• `user_pseudo_id`: Build user‑level aggregates and decide whether a user is a purchaser.  
• `ecommerce.purchase_revenue` (or simply the presence of a `purchase` event): Used only to label purchasers; the amount itself is not required.  
• `event_params`: Optional – extract supporting information such as the page title; handy for quick inspection.  

BigQuery exploration and answer‑building path  
(The dataset is `bigquery-public-data.ga4_obfuscated_sample_ecommerce`.  
Day‑tables are named `events_YYYYMMDD`; we rely on the wildcard syntax `events_*` with `_TABLE_SUFFIX`.)

```sql
--Description:
--1. Quick look at what kinds of events exist on 1 Dec 2020
SELECT DISTINCT event_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
LIMIT 20;
```

```sql
--Description:
--2. Sample 20 page_view events on 1 Dec 2020
SELECT event_date, event_timestamp, user_pseudo_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201201`
WHERE event_name = 'page_view'
LIMIT 20;
```

```sql
--Description:
--3. Sample 20 purchase events on 25 Dec 2020
SELECT event_date, event_timestamp, user_pseudo_id, ecommerce.purchase_revenue
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201225`
WHERE event_name = 'purchase'
LIMIT 20;
```

```sql
--Description:
--4. Peek inside `event_params` for a single page_view (extract page_title if present)
SELECT
  t.event_timestamp,
  ep.value.string_value AS page_title
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201210` AS t
CROSS JOIN UNNEST(t.event_params) AS ep
WHERE t.event_name = 'page_view'
  AND ep.key = 'page_title'
LIMIT 20;
```

```sql
--Description:
--5. Distinct users who bought something at any time in December 2020
SELECT DISTINCT user_pseudo_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND event_name = 'purchase'
LIMIT 20;
```

```sql
--Description:
--6. Count of pageviews per user for each day in December 2020
SELECT
  user_pseudo_id,
  COUNT(*) AS pageviews
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND event_name = 'page_view'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
--Description:
--7. Label every user in December as purchaser (1) / non‑purchaser (0)
SELECT
  user_pseudo_id,
  MAX(CASE WHEN event_name = 'purchase' THEN 1 ELSE 0 END) AS purchaser
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
--Description:
--8. Combine the pageview counts (query 6) with purchaser flags (query 7)
WITH pageviews AS (
  SELECT user_pseudo_id, COUNT(*) AS pv
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND event_name = 'page_view'
  GROUP BY user_pseudo_id
),
buyers AS (
  SELECT user_pseudo_id,
         MAX(CASE WHEN event_name = 'purchase' THEN 1 ELSE 0 END) AS purchaser
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  GROUP BY user_pseudo_id
)
SELECT
  b.user_pseudo_id,
  b.purchaser,
  IFNULL(p.pv,0) AS pageviews_in_dec
FROM buyers AS b
LEFT JOIN pageviews AS p
ON b.user_pseudo_id = p.user_pseudo_id
LIMIT 20;
```

```sql
--Description:
--9. Average December pageviews for purchasers vs non‑purchasers
WITH pageviews AS (
  SELECT user_pseudo_id, COUNT(*) AS pv
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND event_name = 'page_view'
  GROUP BY user_pseudo_id
),
buyers AS (
  SELECT user_pseudo_id,
         MAX(CASE WHEN event_name = 'purchase' THEN 1 ELSE 0 END) AS purchaser
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  GROUP BY user_pseudo_id
)
SELECT
  purchaser,
  AVG(IFNULL(pv,0)) AS avg_pageviews
FROM buyers
LEFT JOIN pageviews USING (user_pseudo_id)
GROUP BY purchaser
LIMIT 20;
```

```sql
--Description:
--10. Put it all together: difference in average pageviews (purchasers – non‑purchasers)
WITH pageviews AS (
  SELECT user_pseudo_id, COUNT(*) AS pv
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND event_name = 'page_view'
  GROUP BY user_pseudo_id
),
buyers AS (
  SELECT user_pseudo_id,
         MAX(CASE WHEN event_name = 'purchase' THEN 1 ELSE 0 END) AS purchaser
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  GROUP BY user_pseudo_id
),
avg_pv AS (
  SELECT
    purchaser,
    AVG(IFNULL(pv,0)) AS avg_pageviews
  FROM buyers
  LEFT JOIN pageviews USING (user_pseudo_id)
  GROUP BY purchaser
)
SELECT
  MAX(CASE WHEN purchaser = 1 THEN avg_pageviews END)
    - MAX(CASE WHEN purchaser = 0 THEN avg_pageviews END) AS diff_pageviews_purch_vs_non
FROM avg_pv
LIMIT 20;
```

