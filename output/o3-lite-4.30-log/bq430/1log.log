```sql
--Description:
-- Attach synthetic publication dates to activities (uses MOD instead of %).
-- Steps:
--   1. Build a doc_dates CTE that calculates p_rank for every document.
--   2. Month  = 1 + FLOOR(p_rank*11)
--   3. Day    = 1 + MOD(FLOOR(p_rank*308), 28)
WITH doc_dates AS (
  SELECT
    doc_id,
    COALESCE(CAST(year AS INT64), 1970)          AS pub_year,
    journal,
    PERCENT_RANK() OVER (
      PARTITION BY journal, COALESCE(year, '1970')
      ORDER BY SAFE_CAST(first_page AS INT64)
    ) AS p_rank
  FROM `bigquery-public-data.ebi_chembl.docs`
)
SELECT
  a.activity_id,
  a.doc_id,
  dd.pub_year,
  1 + CAST(FLOOR(dd.p_rank * 11) AS INT64)                     AS pub_month,
  1 + MOD(CAST(FLOOR(dd.p_rank * 308) AS INT64), 28)           AS pub_day
FROM `bigquery-public-data.ebi_chembl.activities` AS a
JOIN doc_dates AS dd
  ON dd.doc_id = a.doc_id
WHERE a.doc_id IS NOT NULL
LIMIT 20;
```

```sql
--Description:
-- Generate pairs of different molecules measured in the same assay & standard_type,
-- each having non‑null standard_value.
SELECT
  a1.activity_id  AS act_id_1,
  a2.activity_id  AS act_id_2,
  a1.assay_id,
  a1.standard_type,
  a1.standard_value AS value_1,
  a2.standard_value AS value_2
FROM `bigquery-public-data.ebi_chembl.activities` AS a1
JOIN `bigquery-public-data.ebi_chembl.activities` AS a2
  ON a1.assay_id      = a2.assay_id
 AND a1.standard_type = a2.standard_type
 AND a1.molregno     <> a2.molregno
WHERE a1.standard_value IS NOT NULL
  AND a2.standard_value IS NOT NULL
LIMIT 20;
```

```sql
--Description:
-- Classify the change direction (increase / decrease / no‑change) for each activity pair.
WITH paired AS (
  SELECT
    a1.activity_id       AS act_id_1,
    a2.activity_id       AS act_id_2,
    a1.standard_value    AS value_1,
    a2.standard_value    AS value_2,
    a1.standard_relation AS relation_1,
    a2.standard_relation AS relation_2
  FROM `bigquery-public-data.ebi_chembl.activities` AS a1
  JOIN `bigquery-public-data.ebi_chembl.activities` AS a2
    ON a1.assay_id      = a2.assay_id
   AND a1.standard_type = a2.standard_type
   AND a1.molregno     <> a2.molregno
  WHERE a1.standard_value IS NOT NULL
    AND a2.standard_value IS NOT NULL
)
SELECT
  act_id_1,
  act_id_2,
  CASE
    WHEN SAFE_CAST(value_1 AS FLOAT64) < SAFE_CAST(value_2 AS FLOAT64)
         AND relation_1 IN ('=', '<', '<=') 
         AND relation_2 IN ('=', '>', '>=') THEN 'increase'
    WHEN SAFE_CAST(value_1 AS FLOAT64) > SAFE_CAST(value_2 AS FLOAT64)
         AND relation_1 IN ('=', '>', '>=') 
         AND relation_2 IN ('=', '<', '<=') THEN 'decrease'
    WHEN SAFE_CAST(value_1 AS FLOAT64) = SAFE_CAST(value_2 AS FLOAT64)
         AND relation_1 = '=' AND relation_2 = '=' THEN 'no-change'
    ELSE 'uncertain'
  END AS change_class
FROM paired
LIMIT 20;
```

```sql
--Description:
-- Produce deterministic UUIDs for chosen activities using MD5 of the JSON string
-- built from (activity_id, canonical_smiles).
WITH act_struct AS (
  SELECT
    a.activity_id,
    s.canonical_smiles
  FROM `bigquery-public-data.ebi_chembl.activities`          AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_structures` AS s
    USING (molregno)
  WHERE a.activity_id IN ('400977', '794406')   -- sample IDs
)
SELECT
  activity_id,
  MD5(TO_JSON_STRING(STRUCT(activity_id, canonical_smiles))) AS mmp_delta_uuid
FROM act_struct
LIMIT 20;
```
