filtered_acts AS (                     -- activities passing core filters
  SELECT a.*
  FROM `bigquery-public-data.ebi_chembl.activities` AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties` AS p
    ON a.molregno = p.molregno
  WHERE SAFE_CAST(p.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND SAFE_CAST(p.heavy_atoms AS INT64) IS NOT NULL
    AND SAFE_CAST(a.pchembl_value AS FLOAT64) > 10
    AND a.standard_value IS NOT NULL
),
mol_assay_counts AS (                  -- <5 activity records / assay
  SELECT molregno, assay_id, COUNT(*) AS n_act
  FROM filtered_acts
  GROUP BY molregno, assay_id
  HAVING n_act < 5
),
mol_assay_dups AS (                    -- <2 duplicate flags / assay
  SELECT molregno, assay_id,
         SUM(CASE WHEN potential_duplicate = '1' THEN 1 ELSE 0 END) AS dup_cnt
  FROM filtered_acts
  GROUP BY molregno, assay_id
  HAVING dup_cnt < 2
),
usable AS (                            -- final usable activities
  SELECT fa.*
  FROM filtered_acts fa
  JOIN mol_assay_counts c USING (molregno, assay_id)
  JOIN mol_assay_dups  d USING (molregno, assay_id)
)
SELECT
  a.activity_id  AS activity_id_1,
  b.activity_id  AS activity_id_2,
  a.molregno     AS molregno_1,
  b.molregno     AS molregno_2,
  GREATEST(
    SAFE_CAST(p1.heavy_atoms AS INT64),
    SAFE_CAST(p2.heavy_atoms AS INT64)
  )                                    AS max_heavy_atoms,
  GREATEST(a.doc_id, b.doc_id)         AS highest_doc_id,
  GREATEST(d1.pub_date, d2.pub_date)   AS latest_pub_date,
  CASE
    WHEN SAFE_CAST(a.standard_value AS FLOAT64)
         < SAFE_CAST(b.standard_value AS FLOAT64) THEN 'increase'
    WHEN SAFE_CAST(a.standard_value AS FLOAT64)
         > SAFE_CAST(b.standard_value AS FLOAT64) THEN 'decrease'
    ELSE 'no-change'
  END                                   AS change_class,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(a.activity_id, b.activity_id))))
                                         AS mmp_delta_uuid,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(s1.canonical_smiles,
                                   s2.canonical_smiles))))
                                         AS smiles_pair_uuid
FROM usable a
JOIN usable b
  ON a.assay_id      = b.assay_id
 AND a.standard_type = b.standard_type
 AND a.molregno      <> b.molregno
JOIN `bigquery-public-data.ebi_chembl.compound_properties`  AS p1
  ON a.molregno = p1.molregno
JOIN `bigquery-public-data.ebi_chembl.compound_properties`  AS p2
  ON b.molregno = p2.molregno
JOIN `bigquery-public-data.ebi_chembl.compound_structures`  AS s1
  ON a.molregno = s1.molregno
JOIN `bigquery-public-data.ebi_chembl.compound_structures`  AS s2
  ON b.molregno = s2.molregno
LEFT JOIN docs_date d1 ON a.doc_id = d1.doc_id
LEFT JOIN docs_date d2 ON b.doc_id = d2.doc_id
WHERE a.activity_id < b.activity_id      -- remove symmetric duplicates
LIMIT 20;
Results:
