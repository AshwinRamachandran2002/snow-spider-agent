/* ============================================================================
   THINKING PROCESS
   ----------------------------------------------------------------------------
   Goal: Re‑run the synthetic publication‑date calculation while fixing the
         MOD type‑mismatch (MOD expects INT64).  Strategy:

   1. Select a small sample of documents whose journal, year, and first_page
      are present (LIMIT 200 to keep it light).
   2. Within each (journal, year) partition, compute:
        • rk  = rank by first_page
        • tot = total docs in that partition
   3. Convert rank to a percent_rank:
        percent_rank = (rk‑1) / (tot‑1)   (all as FLOAT64)
   4. Derive synthetic_month and synthetic_day:
        month = 1 + FLOOR(11  * percent_rank)
        day   = 1 + MOD( FLOOR(308 * percent_rank)  (cast to INT64), 28 )
      ‑‑ Note: After FLOOR we CAST to INT64 before applying MOD to avoid the
               earlier “No matching signature for function MOD” error.
   5. Present the first 20 rows.

   ========================================================================== */
WITH sel AS (
  SELECT
    doc_id,
    journal,
    year,
    CAST(first_page AS INT64) AS first_page,
    RANK()  OVER (PARTITION BY journal, year ORDER BY CAST(first_page AS INT64)) AS rk,
    COUNT(*) OVER (PARTITION BY journal, year) AS tot
  FROM `bigquery-public-data.ebi_chembl.docs`
  WHERE journal    IS NOT NULL
    AND year       IS NOT NULL
    AND first_page IS NOT NULL
  LIMIT 200
),
ranked AS (
  SELECT
    doc_id,
    journal,
    year,
    first_page,
    rk,
    tot,
    SAFE_DIVIDE(CAST(rk - 1 AS FLOAT64),
                NULLIF(CAST(tot - 1 AS FLOAT64), 0)) AS percent_rank
  FROM sel
)
SELECT
  doc_id,
  journal,
  year,
  first_page,
  rk,
  tot,
  percent_rank,
  1 + CAST(FLOOR(11  * percent_rank) AS INT64)                         AS synthetic_month,
  1 + MOD(CAST(FLOOR(308 * percent_rank) AS INT64), 28)               AS synthetic_day
FROM ranked
LIMIT 20;
