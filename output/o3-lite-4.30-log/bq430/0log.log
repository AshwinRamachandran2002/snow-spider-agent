    journal,
    year,
    first_page_int,
    RANK()  OVER (PARTITION BY journal, year ORDER BY first_page_int) AS rk,
    COUNT(*) OVER (PARTITION BY journal, year)                        AS tot
  FROM docs_numeric
),
pct AS (                           -- C. percent_rank computation
  SELECT
    *,
    SAFE_DIVIDE(CAST(rk - 1 AS FLOAT64),
                NULLIF(CAST(tot - 1 AS FLOAT64), 0)) AS percent_rank
  FROM ranked
)
SELECT                              -- D. final columns + synthetic date
  doc_id,
  journal,
  year,
  first_page_int AS first_page,
  rk,
