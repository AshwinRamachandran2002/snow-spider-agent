```sql
/* ---------------------------------------------------------------------------
   THINKING PROCESS (embedded as comments)
   ---------------------------------------------------------------------------
   Objective
   =========
   • Show how to calculate a synthetic publication date (month & day)
     for ChEMBL documents, following the instructions supplied.

   Key Problems Observed Earlier
   =============================
   1) Some `first_page` values are not numeric (e.g. ‘E204’), so a direct
      CAST to INT64 failed (“Bad int64 value: E204”).
   2) MOD() in BigQuery requires INT64 (or NUMERIC) parameters; our previous
      attempts fed it a FLOAT64, causing a type‑mismatch error.

   Strategy
   ========
   A. Use SAFE_CAST(first_page AS INT64) to convert only rows with numeric
      pages; discard NULL results (non‑numeric pages).
   B. Rank each document inside its (journal, year) group by numeric
      `first_page_int`.
   C. Derive `percent_rank` using FLOAT64 arithmetic.
   D. When mapping `percent_rank` to synthetic_month & synthetic_day
      • Multiply & FLOOR -> still FLOAT64 but an integer value
      • CAST that value to INT64
      • Only then call MOD(…,28).

   Lightweight Demo
   ================
   • Limit source set to 200 docs for speed.
   • Show 20 rows in final output.

   ------------------------------------------------------------------------- */

WITH docs_numeric AS (            -- A. keep docs with numeric first_page only
  SELECT
    doc_id,
    journal,
    year,
    SAFE_CAST(first_page AS INT64) AS first_page_int
  FROM `bigquery-public-data.ebi_chembl.docs`
  WHERE journal IS NOT NULL
    AND year    IS NOT NULL
    AND SAFE_CAST(first_page AS INT64) IS NOT NULL
  LIMIT 200                       -- small sample for demonstration
),
ranked AS (                        -- B. rank within (journal, year)
  SELECT
    doc_id,
    journal,
    year,
    first_page_int,
    RANK()  OVER (PARTITION BY journal, year ORDER BY first_page_int) AS rk,
    COUNT(*) OVER (PARTITION BY journal, year)                        AS tot
  FROM docs_numeric
),
pct AS (                           -- C. percent_rank computation
  SELECT
    *,
    SAFE_DIVIDE(CAST(rk - 1 AS FLOAT64),
                NULLIF(CAST(tot - 1 AS FLOAT64), 0)) AS percent_rank
  FROM ranked
)
SELECT                              -- D. final columns + synthetic date
  doc_id,
  journal,
  year,
  first_page_int AS first_page,
  rk,
  tot,
  percent_rank,
  1 + CAST(FLOOR(11  * percent_rank) AS INT64)          AS synthetic_month,
  1 + MOD(CAST(FLOOR(308 * percent_rank) AS INT64), 28) AS synthetic_day
FROM pct
LIMIT 20;
