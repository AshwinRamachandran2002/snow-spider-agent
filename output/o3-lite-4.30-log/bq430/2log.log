--Description:
-- Single, self‑contained query that accomplishes the whole task and documents
-- the reasoning in‑line.  Steps annotated with numbers:
--   ①  Pick compounds having 10–15 heavy atoms (heavy_ok).
--   ②  Keep activity rows for those compounds where pChEMBL >10 and
--      standard_value is present; carry heavy_atoms forward (good_act).
--   ③  Restrict to (molregno, assay_id) that have <5 total activities and
--      fewer than 2 duplicates (few_act).
--   ④  Compute percent‑rank of every document within its (journal,year)
--      group to create a basis for synthetic month/day (docs_rank).
--   ⑤  Convert percent‑rank to month (1‑12) and day (1‑28), ensuring both
--      MOD() arguments are INT64 (pubdate).
--   ⑥  Form ordered pairs of DIFFERENT molecules tested in the SAME assay
--      & SAME standard_type, join everything, classify change, generate
--      UUIDs, and display 20 sample results.

WITH heavy_ok AS (                -- ① 10‑15 heavy atoms
  SELECT
    molregno,
    CAST(heavy_atoms AS INT64) AS heavy_atoms
  FROM `bigquery-public-data.ebi_chembl.compound_properties`
  WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
),
good_act AS (                     -- ② eligible activities
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    h.heavy_atoms,
    a.doc_id,
    a.standard_type,
    CAST(a.standard_value AS FLOAT64) AS sv,
    CAST(a.pchembl_value  AS FLOAT64) AS pchembl
  FROM `bigquery-public-data.ebi_chembl.activities` a
  JOIN heavy_ok h USING (molregno)
  WHERE a.standard_value IS NOT NULL
    AND CAST(a.pchembl_value AS FLOAT64) > 10
),
few_act AS (                      -- ③ enforce activity/duplicate caps
  SELECT molregno, assay_id
  FROM `bigquery-public-data.ebi_chembl.activities`
  GROUP BY molregno, assay_id
  HAVING COUNT(*) < 5
     AND COUNTIF(potential_duplicate = '1') < 2
),
docs_rank AS (                    -- ④ percent‑rank per (journal,year)
  SELECT
    d.doc_id,
    COALESCE(CAST(d.year AS INT64), 1970) AS yy,
    SAFE_CAST(d.first_page AS INT64)      AS fp,
    d.journal,
    PERCENT_RANK() OVER (
      PARTITION BY d.journal, d.year
      ORDER BY SAFE_CAST(d.first_page AS INT64)
    ) AS pr
  FROM `bigquery-public-data.ebi_chembl.docs` d
),
pubdate AS (                      -- ⑤ convert pr → synthetic date parts
  SELECT
    doc_id,
    yy AS year,
    1 + CAST(FLOOR(pr * 11)  AS INT64)          AS month,
    1 + MOD(CAST(FLOOR(pr * 308) AS INT64), 28) AS day
  FROM docs_rank
)
SELECT
  A.activity_id                                                    AS activity_id_a,
  B.activity_id                                                    AS activity_id_b,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(A.activity_id, B.activity_id)))) AS uuid_from_act,
  S1.canonical_smiles                                              AS smiles_a,
  S2.canonical_smiles                                              AS smiles_b,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(S1.canonical_smiles,
                                   S2.canonical_smiles))))         AS uuid_from_smiles,
  GREATEST(A.heavy_atoms, B.heavy_atoms)                           AS max_heavy_atoms,
  CONCAT(CAST(P.year AS STRING), '-',
         LPAD(CAST(P.month AS STRING), 2, '0'), '-',
         LPAD(CAST(P.day   AS STRING), 2, '0'))                    AS latest_pub_date,
  GREATEST(A.doc_id, B.doc_id)                                     AS highest_doc_id,
  CASE
    WHEN A.sv < B.sv THEN 'increase'
    WHEN A.sv > B.sv THEN 'decrease'
    ELSE 'no-change'
  END                                                              AS standard_change
FROM good_act A
JOIN good_act B
  ON A.assay_id      = B.assay_id
 AND A.standard_type = B.standard_type
 AND A.molregno     <> B.molregno
 AND A.activity_id   <  B.activity_id          -- unique pair order
JOIN few_act F1 ON (F1.molregno = A.molregno AND F1.assay_id = A.assay_id)
JOIN few_act F2 ON (F2.molregno = B.molregno AND F2.assay_id = B.assay_id)
JOIN `bigquery-public-data.ebi_chembl.compound_structures` S1
  ON S1.molregno = A.molregno
JOIN `bigquery-public-data.ebi_chembl.compound_structures` S2
  ON S2.molregno = B.molregno
LEFT JOIN pubdate P
  ON P.doc_id = GREATEST(A.doc_id, B.doc_id)
LIMIT 20;
