Relevant columns and their potential usage  

bigquery-public-data.ebi_chembl.activities  
• activity_id: unique identifier needed to build UUIDs  
• assay_id: filter “same assay” & count activities (< 5 per molecule)  
• molregno: link to compound tables  
• standard_type / standard_value / standard_relation: filter on “same standard type”, non‑NULL value, classify increase / decrease / no‑change  
• pchembl_value: keep rows with value > 10  
• potential_duplicate: let us keep rows with < 2 duplicates (value ‘0’ = not duplicate)  
• doc_id: link to docs table  

bigquery-public-data.ebi_chembl.compound_properties  
• molregno: join key  
• heavy_atoms: filter heavy atom count between 10 and 15; also take MAX(heavy_atoms) per pair  

bigquery-public-data.ebi_chembl.compound_structures  
• molregno: join key  
• canonical_smiles: build UUID based on SMILES pair (second UUID requested)  

bigquery-public-data.ebi_chembl.docs  
• doc_id: join key  
• journal / year / first_page: compute synthetic month & day (latest publication date)  
• title, volume, issue, etc.: not required for the task but available  

Key conditions that will be applied later  
• heavy_atoms BETWEEN 10 AND 15  
• pchembl_value > 10  
• standard_value IS NOT NULL  
• COUNT(activity_id) < 5 per (molregno, assay_id)  
• COUNTIF(potential_duplicate='1') < 2 per (molregno, assay_id)  
• Same assay_id AND same standard_type for the paired rows  
• molregno_a <> molregno_b  

--------------------------------------------------------------------  
10 step‑by‑step BigQuery inspection & building queries (each limited to 20 rows)  

```sql
-- 1️⃣ Description: List compounds whose heavy atom count is between 10 and 15
SELECT molregno, heavy_atoms
FROM `bigquery-public-data.ebi_chembl.compound_properties`
WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
LIMIT 20;
```

```sql
-- 2️⃣ Description: Attach canonical SMILES to those “light” compounds
SELECT p.molregno, p.heavy_atoms, s.canonical_smiles
FROM `bigquery-public-data.ebi_chembl.compound_properties` AS p
JOIN `bigquery-public-data.ebi_chembl.compound_structures` AS s
USING (molregno)
WHERE CAST(p.heavy_atoms AS INT64) BETWEEN 10 AND 15
LIMIT 20;
```

```sql
-- 3️⃣ Description: Look at activity rows for light compounds and check pChEMBL > 10
SELECT a.activity_id, a.assay_id, a.molregno, a.standard_type,
       a.standard_relation, a.standard_value, a.pchembl_value
FROM `bigquery-public-data.ebi_chembl.activities` AS a
WHERE a.molregno IN (
  SELECT molregno
  FROM `bigquery-public-data.ebi_chembl.compound_properties`
  WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
)
  AND CAST(a.pchembl_value AS FLOAT64) > 10
  AND a.standard_value IS NOT NULL
LIMIT 20;
```

```sql
-- 4️⃣ Description: Count how many activities each (molregno, assay_id) owns
SELECT molregno, assay_id, COUNT(*) AS act_in_assay
FROM `bigquery-public-data.ebi_chembl.activities`
GROUP BY molregno, assay_id
HAVING COUNT(*) < 5
LIMIT 20;
```

```sql
-- 5️⃣ Description: Check for duplicates within those counts
SELECT molregno, assay_id,
       COUNTIF(potential_duplicate = '1') AS dup_cnt,
       COUNT(*) AS total
FROM `bigquery-public-data.ebi_chembl.activities`
GROUP BY molregno, assay_id
HAVING dup_cnt < 2
LIMIT 20;
```

```sql
-- 6️⃣ Description: Join docs to compute synthetic month & day (percent‑rank demo)
WITH ranked AS (
  SELECT
    d.doc_id,
    d.journal,
    COALESCE(CAST(d.year AS INT64), 1970) AS yy,
    SAFE_CAST(d.first_page AS INT64) AS fp,
    PERCENT_RANK() OVER (PARTITION BY d.journal, d.year
                         ORDER BY SAFE_CAST(d.first_page AS INT64)) AS pr
  FROM `bigquery-public-data.ebi_chembl.docs` AS d
  WHERE d.journal IS NOT NULL AND d.year IS NOT NULL
)
SELECT
  doc_id,
  yy AS year,
  1 + CAST(FLOOR(pr*11) AS INT64) AS month,
  1 + CAST(MOD(FLOOR(pr*308),28) AS INT64) AS day
FROM ranked
LIMIT 20;
```

```sql
-- 7️⃣ Description: Bring together activities + compound data + doc date in one row
WITH lite AS (
  SELECT molregno, CAST(heavy_atoms AS INT64) AS heavy_atoms
  FROM `bigquery-public-data.ebi_chembl.compound_properties`
  WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
),
dts AS (
  SELECT d.doc_id,
         COALESCE(CAST(d.year AS INT64),1970) AS yy,
         SAFE_CAST(d.first_page AS INT64) AS fp,
         d.journal
  FROM `bigquery-public-data.ebi_chembl.docs` d
)
SELECT a.activity_id, a.assay_id, a.molregno,
       l.heavy_atoms,
       a.standard_type, a.standard_value, a.standard_relation,
       a.pchembl_value, a.doc_id
FROM `bigquery-public-data.ebi_chembl.activities` a
JOIN lite l USING (molregno)
WHERE CAST(a.pchembl_value AS FLOAT64) > 10
  AND a.standard_value IS NOT NULL
LIMIT 20;
```

```sql
-- 8️⃣ Description: Form all distinct pairs (A,B) in the same assay & standard type
WITH base AS (
  SELECT a.activity_id, a.assay_id, a.standard_type,
         a.standard_relation, CAST(a.standard_value AS FLOAT64) AS sv,
         a.molregno, p.heavy_atoms, a.doc_id
  FROM `bigquery-public-data.ebi_chembl.activities` a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties` p
  USING (molregno)
  WHERE CAST(p.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND CAST(a.pchembl_value AS FLOAT64) > 10
    AND a.standard_value IS NOT NULL
)
SELECT
  A.activity_id AS act_id_a,
  B.activity_id AS act_id_b,
  A.assay_id,
  A.standard_type
FROM base A
JOIN base B
  ON A.assay_id = B.assay_id
 AND A.standard_type = B.standard_type
 AND A.molregno <> B.molregno
 AND A.activity_id < B.activity_id            -- avoid duplicates
LIMIT 20;
```

```sql
-- 9️⃣ Description: Classify change (increase / decrease / no‑change) for each pair
WITH base AS (
  SELECT a.activity_id, a.assay_id, a.standard_type,
         a.standard_relation, CAST(a.standard_value AS FLOAT64) AS sv,
         a.molregno
  FROM `bigquery-public-data.ebi_chembl.activities` a
  WHERE a.standard_value IS NOT NULL
    AND CAST(a.pchembl_value AS FLOAT64) > 10
)
SELECT
  A.activity_id, B.activity_id,
  CASE
    WHEN A.sv < B.sv THEN 'increase'
    WHEN A.sv > B.sv THEN 'decrease'
    ELSE 'no-change'
  END AS delta
FROM base A
JOIN base B
  ON A.assay_id = B.assay_id
 AND A.standard_type = B.standard_type
 AND A.activity_id < B.activity_id
LIMIT 20;
```

```sql
-- 🔟 Description: Final (sampled) query producing required columns & UUIDs
WITH heavy_ok AS (
  SELECT molregno, CAST(heavy_atoms AS INT64) AS heavy_atoms
  FROM `bigquery-public-data.ebi_chembl.compound_properties`
  WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
),
good_act AS (
  SELECT a.* EXCEPT(potential_duplicate),
         CAST(a.standard_value AS FLOAT64)   AS sv,
         CAST(a.pchembl_value  AS FLOAT64)   AS pchembl
  FROM `bigquery-public-data.ebi_chembl.activities` a
  JOIN heavy_ok h USING (molregno)
  WHERE a.standard_value IS NOT NULL
    AND CAST(a.pchembl_value AS FLOAT64) > 10
),
few_act AS (      -- <5 activities & <2 duplicates in same assay
  SELECT molregno, assay_id
  FROM `bigquery-public-data.ebi_chembl.activities`
  GROUP BY molregno, assay_id
  HAVING COUNT(*) < 5
     AND COUNTIF(potential_duplicate='1') < 2
),
docs_rank AS (
  SELECT d.*,
         COALESCE(CAST(d.year AS INT64),1970) AS yy,
         SAFE_CAST(d.first_page AS INT64)     AS fp,
         PERCENT_RANK() OVER (PARTITION BY d.journal, d.year
                              ORDER BY SAFE_CAST(d.first_page AS INT64)) AS pr
  FROM `bigquery-public-data.ebi_chembl.docs` d
),
pubdate AS (
  SELECT doc_id,
         yy AS year,
         1 + CAST(FLOOR(pr*11) AS INT64) AS month,
         1 + CAST(MOD(FLOOR(pr*308),28) AS INT64) AS day
  FROM docs_rank
)
SELECT
  A.activity_id            AS activity_id_a,
  B.activity_id            AS activity_id_b,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(A.activity_id, B.activity_id)))) AS uuid_from_act,
  S1.canonical_smiles      AS smiles_a,
  S2.canonical_smiles      AS smiles_b,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(S1.canonical_smiles, S2.canonical_smiles)))) AS uuid_from_smiles,
  GREATEST(A.heavy_atoms, B.heavy_atoms) AS max_heavy_atoms,
  CONCAT(CAST(P.year AS STRING),'-',
         LPAD(CAST(P.month AS STRING),2,'0'),'-',
         LPAD(CAST(P.day   AS STRING),2,'0')) AS latest_pub_date,
  GREATEST(A.doc_id, B.doc_id)            AS highest_doc_id,
  CASE
    WHEN A.sv < B.sv THEN 'increase'
    WHEN A.sv > B.sv THEN 'decrease'
    ELSE 'no-change'
  END                                      AS standard_change
FROM good_act  A
JOIN good_act  B
  ON A.assay_id = B.assay_id
 AND A.standard_type = B.standard_type
 AND A.molregno <> B.molregno
 AND A.activity_id <  B.activity_id         -- pair once
JOIN few_act  F1 USING (molregno, assay_id)
JOIN few_act  F2 ON  F2.molregno = B.molregno AND F2.assay_id = B.assay_id
JOIN `bigquery-public-data.ebi_chembl.compound_structures` S1 ON S1.molregno = A.molregno
JOIN `bigquery-public-data.ebi_chembl.compound_structures` S2 ON S2.molregno = B.molregno
LEFT JOIN pubdate P ON P.doc_id = GREATEST(A.doc_id, B.doc_id)
LIMIT 20;
```

The 10 SQL statements above gradually explore the data, apply the business rules, and finally yield (sampled) pairs of molecules that satisfy all requested constraints, enriched with classification and generated UUIDs.
