--Description: Build a sample list of ChEMBL documents together with a synthetic
--             publication date (year‑month‑day) following the specification.
-- THINKING PROCESS
-- ①  Filter docs that have both journal and year because the ranking rule is
--     defined within each (journal,year) bucket; if either is NULL the fallback
--     date would be 1970‑01‑01, but we only need a demo of the ranking logic.
-- ②  For each such bucket, compute PERCENT_RANK() ordered by first_page
--     (cast to INT64 for numeric ordering).  This gives us pr ∈ [0,1].
-- ③  Year:  use COALESCE(year,1970) to handle any remaining NULL values.
-- ④  Month: floor(pr*11)+1  →  1 through 12.
-- ⑤  Day:   floor(pr*308) gives a FLOAT64; to use MOD() both inputs must be
--           INT64, so cast it first, then MOD(value,28)+1 → 1 through 28.
-- ⑥  Show 20 rows so we can visually confirm results.
WITH ranked AS (
  SELECT
    d.doc_id,
    d.journal,
    COALESCE(CAST(d.year AS INT64), 1970) AS yy,
    SAFE_CAST(d.first_page AS INT64)      AS fp,
    PERCENT_RANK() OVER (
      PARTITION BY d.journal, d.year
      ORDER BY SAFE_CAST(d.first_page AS INT64)
    ) AS pr
  FROM `bigquery-public-data.ebi_chembl.docs` AS d
  WHERE d.journal IS NOT NULL
    AND d.year    IS NOT NULL
)
SELECT
  doc_id,
  yy                                               AS year,
  1 + CAST(FLOOR(pr * 11)  AS INT64)               AS month,
  1 + MOD(CAST(FLOOR(pr * 308) AS INT64), 28)      AS day
FROM ranked
LIMIT 20;
