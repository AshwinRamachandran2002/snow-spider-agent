Query:
-- 9. Description: Count qualifying variants for only the longest reference
WITH longest AS (
    SELECT "name" AS "reference_name", "length"
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_REFERENCE_201703"
    ORDER BY "length" DESC
    LIMIT 1
)
SELECT
    l."reference_name",
    l."length",
    COUNT(DISTINCT t."variant_id") AS "variant_cnt"
FROM longest l
JOIN GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_TRANSCRIPTOME_201703" t
  ON t."reference_name" = l."reference_name",
     LATERAL FLATTEN(input => t."call") gen
WHERE
    (   gen.value:"genotype"[0]::INTEGER > 0
     OR gen.value:"genotype"[1]::INTEGER > 0 )
GROUP BY l."reference_name", l."length"
LIMIT 20;
