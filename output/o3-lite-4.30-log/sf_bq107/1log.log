Query:
-- 10. Description: Final variant density for the longest reference
WITH longest AS (
    SELECT "name" AS "reference_name", "length"
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_REFERENCE_201703"
    ORDER BY "length" DESC
    LIMIT 1
),
var_per_ref AS (
    SELECT
        t."reference_name",
        COUNT(DISTINCT t."variant_id") AS "variant_cnt"
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_TRANSCRIPTOME_201703" t,
         LATERAL FLATTEN(input => t."call") gen
    WHERE
        (   gen.value:"genotype"[0]::INTEGER > 0
         OR gen.value:"genotype"[1]::INTEGER > 0 )
    GROUP BY t."reference_name"
)
SELECT
    l."reference_name",
    l."length",
    v."variant_cnt",
    v."variant_cnt" / l."length"            AS "variant_density"
FROM longest l
LEFT JOIN var_per_ref v
  ON l."reference_name" = v."reference_name"
LIMIT 20;
Answer:
reference_name,length,variant_cnt,variant_density
