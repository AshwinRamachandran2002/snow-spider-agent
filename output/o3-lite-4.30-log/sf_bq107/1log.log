The table structure information is ({database name: {schema name: [table name]}}): 
{'GENOMICS_CANNABIS': {'GENOMICS_CANNABIS': ['MNPR01_REFERENCE_201703', 'MNPR01_TRANSCRIPTOME_201703', 'SAMPLE_INFO_201703', 'CS10_GFF', 'CS3K_PROJECT_INFO', 'CS3K_VCF_CS10_DV090', 'MNPR01_201703']}}
Begin Exploring Related Columns
Relevant columns and their possible uses  

• MNPR01_REFERENCE_201703."length" : reference‑sequence length that we need for the denominator of variant density and to identify the longest reference sequence.  
• MNPR01_REFERENCE_201703."name"   : reference‑sequence identifier; will be joined to the variant tables.  
• MNPR01_TRANSCRIPTOME_201703."reference_name" : reference id on which the variant is found; join to MNPR01_REFERENCE_201703."name".  
• MNPR01_TRANSCRIPTOME_201703."call" : semi‑structured array that stores one element per sample; each element contains the “genotype” array.  A variant is present when at least one allele in any sample has genotype value > 0.  
• MNPR01_TRANSCRIPTOME_201703."variant_id" / "_primary key_" : just to count distinct variants.  
• MNPR01_201703 has the same structure as MNPR01_TRANSCRIPTOME_201703 and can be substituted if genomic rather than transcriptomic calls are required.  
• CS10_GFF, SAMPLE_INFO_201703 and CS3K_* tables are not needed for the density calculation.  

Typical filter / join conditions that may be useful  

1. Join condition  
   MNPR01_TRANSCRIPTOME_201703."reference_name" = MNPR01_REFERENCE_201703."name"  

2. Keep only variants where at least one flattened “genotype” element is > 0  
   WHERE (gen.value:"genotype"[0]::INTEGER > 0 OR gen.value:"genotype"[1]::INTEGER > 0)  

3. Longest reference sequence  
   ORDER BY ref."length" DESC LIMIT 1  

Below are 10 exploratory queries (each with LIMIT 20) that progress from simple inspection to the final variant‑density calculation.  
All columns are enclosed in double–quotes, and JSON is accessed with the ::VARIANT accessor.

```sql
-- 1. Description: Show the 20 longest reference sequences and their lengths
SELECT
    "name",
    "length"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_REFERENCE_201703"
ORDER BY "length" DESC
LIMIT 20;
```

```sql
-- 2. Description: Retrieve the single longest reference sequence
SELECT
    "name",
    "length"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_REFERENCE_201703"
ORDER BY "length" DESC
LIMIT 1;
```

```sql
-- 3. Description: Look at one raw record of the variant table to understand structure
SELECT
    "reference_name",
    "start",
    "end",
    "call"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_TRANSCRIPTOME_201703"
LIMIT 20;
```

```sql
-- 4. Description: Flatten one record to see the keys inside "call"
SELECT
    t."reference_name",
    gen.value AS "call_element"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_TRANSCRIPTOME_201703" t,
     LATERAL FLATTEN(input => t."call") gen
LIMIT 20;
```

```sql
-- 5. Description: Inspect genotypes inside flattened call elements
SELECT
    gen.value:"call_set_name"::STRING         AS "sample",
    gen.value:"genotype"                      AS "genotype_array"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_TRANSCRIPTOME_201703" t,
     LATERAL FLATTEN(input => t."call") gen
LIMIT 20;
```

```sql
-- 6. Description: Count how many variants per reference have at least one non‑zero genotype
SELECT
    t."reference_name",
    COUNT(DISTINCT t."variant_id") AS "variant_cnt"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_TRANSCRIPTOME_201703" t,
     LATERAL FLATTEN(input => t."call") gen
WHERE
    (   gen.value:"genotype"[0]::INTEGER > 0
     OR gen.value:"genotype"[1]::INTEGER > 0 )
GROUP BY t."reference_name"
ORDER BY "variant_cnt" DESC
LIMIT 20;
```

```sql
-- 7. Description: Bring in reference lengths and compute preliminary variant density
SELECT
    ref."name"                         AS "reference_name",
    ref."length",
    var."variant_cnt",
    var."variant_cnt" / ref."length"   AS "variant_density"
FROM (
    SELECT
        t."reference_name",
        COUNT(DISTINCT t."variant_id") AS "variant_cnt"
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_TRANSCRIPTOME_201703" t,
         LATERAL FLATTEN(input => t."call") gen
    WHERE
        (   gen.value:"genotype"[0]::INTEGER > 0
         OR gen.value:"genotype"[1]::INTEGER > 0 )
    GROUP BY t."reference_name"
) var
JOIN GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_REFERENCE_201703" ref
  ON var."reference_name" = ref."name"
ORDER BY "variant_density" DESC
LIMIT 20;
```

```sql
-- 8. Description: Focus on the single longest reference and list its raw variants
SELECT
    t."reference_name",
    t."start",
    t."end",
    t."variant_id"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_TRANSCRIPTOME_201703" t
JOIN (
    SELECT "name"
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_REFERENCE_201703"
    ORDER BY "length" DESC
    LIMIT 1
) mx
  ON t."reference_name" = mx."name"
LIMIT 20;
```

```sql
-- 9. Description: Count qualifying variants for only the longest reference
WITH longest AS (
    SELECT "name" AS "reference_name", "length"
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_REFERENCE_201703"
    ORDER BY "length" DESC
    LIMIT 1
)
SELECT
    l."reference_name",
    l."length",
    COUNT(DISTINCT t."variant_id") AS "variant_cnt"
FROM longest l
JOIN GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_TRANSCRIPTOME_201703" t
  ON t."reference_name" = l."reference_name",
     LATERAL FLATTEN(input => t."call") gen
WHERE
    (   gen.value:"genotype"[0]::INTEGER > 0
     OR gen.value:"genotype"[1]::INTEGER > 0 )
GROUP BY l."reference_name", l."length"
LIMIT 20;
```

```sql
-- 10. Description: Final variant density for the longest reference
WITH longest AS (
    SELECT "name" AS "reference_name", "length"
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_REFERENCE_201703"
    ORDER BY "length" DESC
    LIMIT 1
),
var_per_ref AS (
    SELECT
        t."reference_name",
        COUNT(DISTINCT t."variant_id") AS "variant_cnt"
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS."MNPR01_TRANSCRIPTOME_201703" t,
         LATERAL FLATTEN(input => t."call") gen
    WHERE
        (   gen.value:"genotype"[0]::INTEGER > 0
         OR gen.value:"genotype"[1]::INTEGER > 0 )
    GROUP BY t."reference_name"
)
SELECT
    l."reference_name",
    l."length",
    v."variant_cnt",
    v."variant_cnt" / l."length"            AS "variant_density"
FROM longest l
LEFT JOIN var_per_ref v
  ON l."reference_name" = v."reference_name"
LIMIT 20;
```

These ten queries take you from simple inspection of reference lengths and variant structure to the final calculation of variant density on the longest Cannabis reference sequence.
