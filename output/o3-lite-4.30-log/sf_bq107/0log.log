```sql
--Description (thinking process):
-- We want to count, for every reference contig, how many unique variants are “present”
-- (i.e. at least one genotype allele > 0).  
-- 1. Take table MNPR01_201703 (alias v).  
-- 2. FLATTEN the VARIANT column "call" into individual call‑objects (alias f).  
-- 3. Within each call‑object, FLATTEN its "genotype" array (alias g).  
-- 4. Convert each g.value (a VARIANT) to NUMBER with TRY_CAST to avoid the earlier
--    error; keep only alleles > 0.  
-- 5. Group by reference_name and count DISTINCT variant_id to avoid double‑counting.  
-- 6. Order by the count (descending) and show 20 rows for inspection.
SELECT
       v."reference_name",
       COUNT(DISTINCT v."variant_id") AS "present_variant_cnt"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v,
     LATERAL FLATTEN(input => v."call")            f,
     LATERAL FLATTEN(input => f.value:"genotype")  g
WHERE TRY_CAST(g.value AS NUMBER) > 0
GROUP BY v."reference_name"
ORDER BY "present_variant_cnt" DESC
LIMIT 20;
