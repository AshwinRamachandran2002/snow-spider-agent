     LATERAL FLATTEN(input => v."call")            f,
     LATERAL FLATTEN(input => f.value:"genotype")  g
WHERE TRY_TO_NUMBER(g.value::STRING) > 0
GROUP BY v."reference_name"
ORDER BY "present_variant_cnt" DESC
LIMIT 20;
