```sql
--Description (thinking process):
-- We need the variant density for the longest reference contig.  
--   • CTE “longest” retrieves the single reference with the greatest length.  
--   • CTE “present_vars” selects DISTINCT variant_id / reference_name pairs where
--     at least one genotype allele is > 0 (non‑reference).  We flatten the “call” array
--     then flatten each “genotype” array, convert the VARIANT value to STRING and
--     safely parse it with TRY_TO_NUMBER; alleles that convert to a number > 0 indicate
--     presence.  
--   • Finally we join longest ↔ present_vars, count the present variants, and divide by
--     the contig length to obtain variant_density.
WITH longest AS (
    SELECT "name" AS reference_name,
           "length"
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_REFERENCE_201703
    ORDER BY "length" DESC
    LIMIT 1
),
present_vars AS (
    SELECT DISTINCT
           v."variant_id",
           v."reference_name"
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v,
         LATERAL FLATTEN(input => v."call")            f,
         LATERAL FLATTEN(input => f.value:"genotype")  g
    WHERE TRY_TO_NUMBER(g.value::STRING) > 0
)
SELECT
       l.reference_name,
       l."length",
       COUNT(p.variant_id)                           AS present_variant_cnt,
       COUNT(p.variant_id) / l."length"              AS variant_density
FROM longest l
LEFT JOIN present_vars p
       ON p.reference_name = l.reference_name
GROUP BY l.reference_name, l."length";
```
