Begin Exploring Related Columns
Below are some exploratory Snowflake SQL queries (all limited to 20 rows) that progressively examine the tables/columns needed to compute “variant density of the cannabis reference with the longest reference length”.  
Each query is wrapped in SQL‑style comments that explain why it is useful.

```sql
-- 1) Show the 20 longest reference contigs (name & length)  
SELECT 
  "name",
  "length"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_REFERENCE_201703
ORDER BY "length" DESC
LIMIT 20;
```

```sql
-- 2) Return only the single longest reference contig (max length)  
SELECT 
  "name",
  "length"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_REFERENCE_201703
ORDER BY "length" DESC
LIMIT 1;
```

```sql
-- 3) Count total variant rows per reference in MNPR01_201703  
SELECT 
  v."reference_name",
  COUNT(*) AS "raw_variant_row_cnt"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v
GROUP BY v."reference_name"
ORDER BY "raw_variant_row_cnt" DESC
LIMIT 20;
```

```sql
-- 4) Inspect the structure of the VARIANT column "call" (one row)  
SELECT 
  v."variant_id",
  f.value AS "one_call_json"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v,
     LATERAL FLATTEN(input => v."call") f
LIMIT 20;
```

```sql
-- 5) Pull out genotype arrays found inside each flattened “call” object  
SELECT 
  v."variant_id",
  g.value AS "genotype_value"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v,
     LATERAL FLATTEN(input => v."call") f,
     LATERAL FLATTEN(input => f.value:"genotype") g
LIMIT 20;
```

```sql
-- 6) Identify variant rows where at least one genotype is > 0  
SELECT DISTINCT 
  v."variant_id"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v,
     LATERAL FLATTEN(input => v."call") f,
     LATERAL FLATTEN(input => f.value:"genotype") g
WHERE TRY_TO_NUMBER(g.value) > 0
LIMIT 20;
```

```sql
-- 7) Count such “present” variants per reference contig  
SELECT 
  v."reference_name",
  COUNT(DISTINCT v."variant_id") AS "present_variant_cnt"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v,
     LATERAL FLATTEN(input => v."call") f,
     LATERAL FLATTEN(input => f.value:"genotype") g
WHERE TRY_TO_NUMBER(g.value) > 0
GROUP BY v."reference_name"
ORDER BY "present_variant_cnt" DESC
LIMIT 20;
```

```sql
-- 8) Join the counts (present variants) with reference lengths  
SELECT 
  r."name"                           AS "reference_name",
  r."length",
  pv."present_variant_cnt"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_REFERENCE_201703 r
JOIN (
    SELECT 
      v."reference_name",
      COUNT(DISTINCT v."variant_id") AS "present_variant_cnt"
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v,
         LATERAL FLATTEN(input => v."call") f,
         LATERAL FLATTEN(input => f.value:"genotype") g
    WHERE TRY_TO_NUMBER(g.value) > 0
    GROUP BY v."reference_name"
) pv
  ON r."name" = pv."reference_name"
ORDER BY r."length" DESC
LIMIT 20;
```

```sql
-- 9) Compute variant density (present_variant_cnt / length) for every contig  
SELECT 
  r."name"                           AS "reference_name",
  r."length",
  pv."present_variant_cnt",
  pv."present_variant_cnt" / r."length" AS "variant_density"
FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_REFERENCE_201703 r
JOIN (
    SELECT 
      v."reference_name",
      COUNT(DISTINCT v."variant_id") AS "present_variant_cnt"
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v,
         LATERAL FLATTEN(input => v."call") f,
         LATERAL FLATTEN(input => f.value:"genotype") g
    WHERE TRY_TO_NUMBER(g.value) > 0
    GROUP BY v."reference_name"
) pv
  ON r."name" = pv."reference_name"
ORDER BY "variant_density" DESC
LIMIT 20;
```

```sql
-- 10) Final: variant density for THE longest reference only  
WITH longest_ref AS (
  SELECT "name" AS "reference_name", "length"
  FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_REFERENCE_201703
  ORDER BY "length" DESC
  LIMIT 1
),
present_var AS (
  SELECT 
    v."reference_name",
    COUNT(DISTINCT v."variant_id") AS "present_variant_cnt"
  FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v,
       LATERAL FLATTEN(input => v."call") f,
       LATERAL FLATTEN(input => f.value:"genotype") g
  WHERE TRY_TO_NUMBER(g.value) > 0
  GROUP BY v."reference_name"
)
SELECT 
  l."reference_name",
  l."length",
  p."present_variant_cnt",
  p."present_variant_cnt" / l."length" AS "variant_density"
FROM longest_ref l
LEFT JOIN present_var p
  ON l."reference_name" = p."reference_name";
```

These ten queries progress from basic exploration of reference lengths to filtering on genotype values, joining counts with lengths, and finally computing variant density for the single longest contig.
