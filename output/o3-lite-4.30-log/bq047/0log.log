FROM `bigquery-public-data.noaa_gsod.gsod2013`
WHERE stn = '725030'
  AND temp < 9999.9
LIMIT 20;
```

```sql
-- 3. Build one small union of GSOD tables (2008‑2010) just to preview the combined layout
