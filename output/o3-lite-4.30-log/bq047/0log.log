Query:
--Description: Final screen of all complaint types with ≥ 5 000 total records.
--             For each type we compute:
--               • total complaints,
--               • number of days with valid temperature data,
--               • correlation between daily count & temperature,
--               • correlation between daily share of that type & temperature.
--             We keep only those whose |corr(count,temp)| > 0.5.
WITH wx_union AS (
  SELECT
    PARSE_DATE('%Y%m%d',
               CONCAT(year, LPAD(mo,2,'0'), LPAD(da,2,'0'))) AS obs_date,
    AVG(temp/10.0)                                          AS mean_temp_f
  FROM `bigquery-public-data.noaa_gsod.gsod20*`
  WHERE _TABLE_SUFFIX BETWEEN '08' AND '17'      -- 2008‑2017 tables
    AND stn IN ('725030','744860')               -- airport stations
    AND temp < 9999.9                            -- valid temps
  GROUP BY obs_date
),
daily_311 AS (
  SELECT
    DATE(created_date) AS req_date,
    complaint_type,
    COUNT(*)          AS daily_cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2008-01-01' AND '2017-12-31'
  GROUP BY req_date, complaint_type
),
summary AS (
  SELECT
    d.complaint_type,
    SUM(d.daily_cnt)                            AS total_complaints,
    COUNT(DISTINCT d.req_date)                  AS days_with_complaints,
    CORR(d.daily_cnt, w.mean_temp_f)            AS corr_cnt_temp,
    CORR(d.daily_cnt / NULLIF(t.total,0),
         w.mean_temp_f)                         AS corr_pct_temp
  FROM daily_311 d
  JOIN wx_union w
    ON d.req_date = w.obs_date
  JOIN (
    -- total 311 complaints each day (needed for daily share)
    SELECT req_date, SUM(daily_cnt) AS total
    FROM daily_311
    GROUP BY req_date
  ) t
    ON d.req_date = t.req_date
  GROUP BY d.complaint_type
)
SELECT
  complaint_type,
  total_complaints,
  days_with_complaints,
  ROUND(corr_cnt_temp,4) AS corr_cnt_temp,
  ROUND(corr_pct_temp,4) AS corr_pct_temp
FROM summary
WHERE total_complaints >= 5000
  AND ABS(corr_cnt_temp) > 0.5
ORDER BY ABS(corr_cnt_temp) DESC
LIMIT 20
