       PARSE_DATE('%Y%m%d', CONCAT(year, LPAD(mo,2,'0'), LPAD(da,2,'0'))) AS obs_date,
       temp/10.0 AS mean_temp_f
FROM `bigquery-public-data.noaa_gsod.gsod2008`
WHERE stn IN ('725030','744860') AND temp < 9999.9
UNION ALL
SELECT stn,
       PARSE_DATE('%Y%m%d', CONCAT(year, LPAD(mo,2,'0'), LPAD(da,2,'0'))) AS obs_date,
       temp/10.0 AS mean_temp_f
FROM `bigquery-public-data.noaa_gsod.gsod2009`
WHERE stn IN ('725030','744860') AND temp < 9999.9
UNION ALL
SELECT stn,
       PARSE_DATE('%Y%m%d', CONCAT(year, LPAD(mo,2,'0'), LPAD(da,2,'0'))) AS obs_date,
       temp/10.0 AS mean_temp_f
FROM `bigquery-public-data.noaa_gsod.gsod2010`
WHERE stn IN ('725030','744860') AND temp < 9999.9
LIMIT 20;
```

```sql
-- 4. Daily count of service requests (all types) for a sample month
SELECT DATE(created_date) AS req_date,
       COUNT(*) AS daily_total
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE created_date BETWEEN '2014-07-01' AND '2014-07-31'
GROUP BY req_date
ORDER BY req_date
LIMIT 20;
```

```sql
-- 5. Daily counts per complaint type for the same sample month
SELECT DATE(created_date) AS req_date,
       complaint_type,
       COUNT(*) AS daily_cnt
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE created_date BETWEEN '2014-07-01' AND '2014-07-31'
GROUP BY req_date, complaint_type
ORDER BY req_date, complaint_type
LIMIT 20;
```

```sql
-- 6. Create one‑year (2013) dataset that already joins 311 daily totals with the averaged airport temperature
WITH wx AS (
  SELECT PARSE_DATE('%Y%m%d', CONCAT(year, LPAD(mo,2,'0'), LPAD(da,2,'0'))) AS obs_date,
         AVG(temp/10.0) AS mean_temp_f
  FROM `bigquery-public-data.noaa_gsod.gsod2013`
  WHERE stn IN ('725030','744860') AND temp < 9999.9
  GROUP BY obs_date
),
complaints AS (
  SELECT DATE(created_date) AS req_date,
         COUNT(*) AS total_requests
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2013-01-01' AND '2013-12-31'
  GROUP BY req_date
)
SELECT c.req_date,
       c.total_requests,
       w.mean_temp_f
FROM complaints c
JOIN wx w
  ON c.req_date = w.obs_date
LIMIT 20;
```

```sql
-- 7. Compute per‑day counts for each complaint type (10‑year window) – SMALL SAMPLE
SELECT DATE(created_date) AS req_date,
       complaint_type,
       COUNT(*) AS daily_cnt
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE created_date BETWEEN '2008-01-01' AND '2017-12-31'
GROUP BY req_date, complaint_type
LIMIT 20;
```

```sql
-- 8. For one complaint type (“Noise”) fetch the ready‑to‑correlate table (daily count + temp)
WITH wx AS (
  SELECT PARSE_DATE('%Y%m%d', CONCAT(year, LPAD(mo,2,'0'), LPAD(da,2,'0'))) AS obs_date,
         AVG(temp/10.0) AS mean_temp_f
  FROM (
        -- UNION ALL over 2008‑2017 quickly via _TABLE_SUFFIX wildcard
        SELECT * FROM `bigquery-public-data.noaa_gsod.gsod20*`
       )
  WHERE _TABLE_SUFFIX BETWEEN '08' AND '17'   -- picks 2008‑2017
    AND stn IN ('725030','744860') AND temp < 9999.9
  GROUP BY obs_date
),
noise AS (
  SELECT DATE(created_date) AS req_date,
         COUNT(*) AS daily_cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE complaint_type = 'Noise'
    AND created_date BETWEEN '2008-01-01' AND '2017-12-31'
  GROUP BY req_date
)
SELECT n.req_date, n.daily_cnt, w.mean_temp_f
FROM noise n
JOIN wx w
  ON n.req_date = w.obs_date
LIMIT 20;
```

```sql
-- 9. Compute correlation for one type (“Noise”) to ensure syntax works
WITH wx AS (
  SELECT PARSE_DATE('%Y%m%d', CONCAT(year, LPAD(mo,2,'0'), LPAD(da,2,'0'))) AS obs_date,
         AVG(temp/10.0) AS mean_temp_f
  FROM (
        SELECT * FROM `bigquery-public-data.noaa_gsod.gsod20*`
       )
  WHERE _TABLE_SUFFIX BETWEEN '08' AND '17'
    AND stn IN ('725030','744860') AND temp < 9999.9
  GROUP BY obs_date
),
base AS (
  SELECT DATE(created_date) AS req_date, complaint_type, COUNT(*) AS daily_cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE complaint_type = 'Noise'
    AND created_date BETWEEN '2008-01-01' AND '2017-12-31'
  GROUP BY req_date, complaint_type
)
SELECT
  CORR(b.daily_cnt, w.mean_temp_f) AS pearson_corr
FROM base b
JOIN wx w
  ON b.req_date = w.obs_date;
```

```sql
-- 10. Final‑form query: find every complaint type ≥5 000 rows, compute
--     total complaints, days covered, corr(count,temp), corr(share,temp),
--     and keep only |corr| > 0.5
WITH years AS UNNEST(GENERATE_ARRAY(2008, 2017)) AS yr,
wx_union AS (
  SELECT
    PARSE_DATE('%Y%m%d', CONCAT(year, LPAD(mo,2,'0'), LPAD(da,2,'0'))) AS obs_date,
    AVG(temp/10.0) AS mean_temp_f
  FROM (
        SELECT * FROM `bigquery-public-data.noaa_gsod.gsod20*`
       )
  WHERE CAST(year AS INT64) BETWEEN 2008 AND 2017
    AND stn IN ('725030','744860')
    AND temp < 9999.9
  GROUP BY obs_date
),
daily_311 AS (
  SELECT
    DATE(created_date)                         AS req_date,
    complaint_type,
    COUNT(*)                                   AS daily_cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2008-01-01' AND '2017-12-31'
  GROUP BY req_date, complaint_type
),
summary AS (
  SELECT
    complaint_type,
    SUM(daily_cnt)                                           AS total_complaints,
    COUNT(DISTINCT req_date)                                 AS days_with_complaints,
    CORR(daily_cnt, mean_temp_f)                             AS corr_cnt_temp,
    CORR(daily_cnt / SUM(daily_cnt) OVER (),
         mean_temp_f)                                        AS corr_pct_temp
  FROM daily_311 d
  JOIN wx_union w
    ON d.req_date = w.obs_date
  GROUP BY complaint_type
)
SELECT
  complaint_type,
  total_complaints,
  days_with_complaints,
  ROUND(corr_cnt_temp,4)  AS corr_cnt_temp,
  ROUND(corr_pct_temp,4)  AS corr_pct_temp
FROM summary
WHERE total_complaints >= 5000
  AND ABS(corr_cnt_temp) > 0.5
ORDER BY ABS(corr_cnt_temp) DESC
LIMIT 20;
```

Each query gradually builds the pieces required to answer the full research question, from inspecting raw values, to producing intermediate daily tables, up to the final correlation screen against temperature.
