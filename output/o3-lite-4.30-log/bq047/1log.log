Relevant columns and their potential usage  

311 Service Requests (`bigquery-public-data.new_york.311_service_requests`)  
• `created_date`: to derive the calendar day (`DATE(created_date)`) of each complaint.  
• `complaint_type`: to group and count requests of the same type.  
• `unique_key`: unique id, can be used to count total requests.  
(Other columns hold geo attributes that are not needed for the temperature / correlation task.)

GSOD daily weather (`bigquery-public-data.noaa_gsod.gsodYYYY`)  
• `stn`: WMO/USAF station number – 725030 = LaGuardia, 744860 = JFK.  
• `year`, `mo`, `da`: together with `stn` form the date of record.  
• `temp`: mean air temperature (°F). Needed for correlation.  
• All rows where `temp = 9999.9` must be excluded (missing value).

Typical conditions that will be useful  
• `stn IN ('725030','744860')`  
• `year BETWEEN '2008' AND '2017'`  
• `temp <> 9999.9`  
• `created_date BETWEEN '2008-01-01' AND '2017-12-31'`  

Ten exploratory BigQuery SQL queries (each returns at most 20 rows)

```sql
-- 1) Peek at raw 311 data: a handful of complaints and their timestamps
SELECT unique_key, complaint_type, created_date
FROM `bigquery-public-data.new_york.311_service_requests`
ORDER BY created_date
LIMIT 20;
```

```sql
-- 2) List the 20 most frequent complaint types across the whole table
SELECT complaint_type, COUNT(1) AS total_requests
FROM `bigquery-public-data.new_york.311_service_requests`
GROUP BY complaint_type
ORDER BY total_requests DESC
LIMIT 20;
```

```sql
-- 3) Show daily counts for a sample complaint type (‘Noise - Residential’) in 2010
SELECT DATE(created_date) AS day,
       COUNT(1) AS daily_cnt
FROM `bigquery-public-data.new_york.311_service_requests`
WHERE complaint_type = 'Noise - Residential'
  AND created_date BETWEEN '2010-01-01' AND '2010-12-31'
GROUP BY day
ORDER BY day
LIMIT 20;
```

```sql
-- 4) Verify that GSOD tables contain LaGuardia & JFK in one sample year (2008)
SELECT DISTINCT stn
FROM `bigquery-public-data.noaa_gsod.gsod2008`
WHERE stn IN ('725030','744860');
```

```sql
-- 5) Inspect mean temperatures for LaGuardia in January 2008
SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day,
       temp
FROM `bigquery-public-data.noaa_gsod.gsod2008`
WHERE stn = '725030'
  AND temp <> 9999.9
  AND mo = '01'
ORDER BY day
LIMIT 20;
```

```sql
-- 6) Join daily complaints (all types) with LaGuardia temperature for a sample month
WITH daily_311 AS (
  SELECT DATE(created_date) AS day, COUNT(1) AS total_complaints
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2008-07-01' AND '2008-07-31'
  GROUP BY day )
SELECT d.day, d.total_complaints, g.temp
FROM daily_311 d
JOIN `bigquery-public-data.noaa_gsod.gsod2008` g
  ON g.stn = '725030'
 AND g.temp <> 9999.9
 AND d.day = DATE(CONCAT(g.year,'-',g.mo,'-',g.da))
ORDER BY d.day
LIMIT 20;
```

```sql
-- 7) Compute the daily share (%) of ‘Heat/Hot Water’ complaints in July 2013
WITH daily_tot AS (
  SELECT DATE(created_date) AS day, COUNT(1) AS tot
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2013-07-01' AND '2013-07-31'
  GROUP BY day ),
daily_heat AS (
  SELECT DATE(created_date) AS day, COUNT(1) AS heat_cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE complaint_type = 'Heat/Hot Water'
    AND created_date BETWEEN '2013-07-01' AND '2013-07-31'
  GROUP BY day )
SELECT h.day,
       heat_cnt,
       tot,
       ROUND(100 * heat_cnt / tot,2) AS pct_heat
FROM daily_heat h
JOIN daily_tot t USING(day)
ORDER BY h.day
LIMIT 20;
```

```sql
-- 8) Pearson correlation between LaGuardia temperature and daily total 311 volume in 2009
WITH daily_311 AS (
  SELECT DATE(created_date) AS day, COUNT(1) AS cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2009-01-01' AND '2009-12-31'
  GROUP BY day ),
daily_temp AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day, temp
  FROM `bigquery-public-data.noaa_gsod.gsod2009`
  WHERE stn = '725030' AND temp <> 9999.9 )
SELECT CORR(cnt, temp) AS corr_cnt_temp
FROM daily_311 j
JOIN daily_temp t USING(day);
```

```sql
-- 9) For 2012‑2014: complaint types with >5000 requests and correlation >0.5 (LaGuardia)
WITH dates AS (
  SELECT GENERATE_DATE_ARRAY('2012-01-01','2014-12-31') AS d_arr ),
calendar AS (
  SELECT day FROM dates, UNNEST(d_arr) AS day ),
daily_temp AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day, temp
  FROM `bigquery-public-data.noaa_gsod.gsod2012`  WHERE stn='725030' AND temp<>9999.9
  UNION ALL
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day, temp
  FROM `bigquery-public-data.noaa_gsod.gsod2013`  WHERE stn='725030' AND temp<>9999.9
  UNION ALL
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day, temp
  FROM `bigquery-public-data.noaa_gsod.gsod2014`  WHERE stn='725030' AND temp<>9999.9 ),
daily_311 AS (
  SELECT DATE(created_date) AS day, complaint_type, COUNT(1) AS cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2012-01-01' AND '2014-12-31'
  GROUP BY day, complaint_type ),
summary AS (
  SELECT complaint_type,
         SUM(cnt) AS total,
         CORR(cnt, temp) AS corr_cnt_temp
  FROM daily_311 d
  JOIN daily_temp t USING(day)
  GROUP BY complaint_type )
SELECT *
FROM summary
WHERE total > 5000 AND ABS(corr_cnt_temp) > 0.5
ORDER BY ABS(corr_cnt_temp) DESC
LIMIT 20;
```

```sql
--10) Final-style query skeleton: 2008‑2017, join both airports, produce required metrics
WITH union_temp AS (
  -- grab all valid temps from both airports for 2008‑2017
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day,
         stn,
         temp
  FROM (
    SELECT * FROM `bigquery-public-data.noaa_gsod.gsod2008` UNION ALL
    SELECT * FROM `bigquery-public-data.noaa_gsod.gsod2009` UNION ALL
    SELECT * FROM `bigquery-public-data.noaa_gsod.gsod2010` UNION ALL
    SELECT * FROM `bigquery-public-data.noaa_gsod.gsod2011` UNION ALL
    SELECT * FROM `bigquery-public-data.noaa_gsod.gsod2012` UNION ALL
    SELECT * FROM `bigquery-public-data.noaa_gsod.gsod2013` UNION ALL
    SELECT * FROM `bigquery-public-data.noaa_gsod.gsod2014` UNION ALL
    SELECT * FROM `bigquery-public-data.noaa_gsod.gsod2015` UNION ALL
    SELECT * FROM `bigquery-public-data.noaa_gsod.gsod2016` UNION ALL
    SELECT * FROM `bigquery-public-data.noaa_gsod.gsod2017`
  )
  WHERE stn IN ('725030','744860') AND temp <> 9999.9
), daily_311 AS (
  SELECT DATE(created_date) AS day,
         complaint_type,
         COUNT(1) AS cnt
  FROM `bigquery-public-data.new_york.311_service_requests`
  WHERE created_date BETWEEN '2008-01-01' AND '2017-12-31'
  GROUP BY day, complaint_type
), total_by_type AS (
  SELECT complaint_type, SUM(cnt) AS total_complaints
  FROM daily_311
  GROUP BY complaint_type
  HAVING total_complaints > 5000
), joined AS (
  SELECT d.day,
         d.complaint_type,
         d.cnt,
         t.temp
  FROM daily_311 d
  JOIN union_temp t USING(day)
  JOIN total_by_type u USING(complaint_type)
), daily_tot AS (
  SELECT day, SUM(cnt) AS tot_cnt
  FROM daily_311
  GROUP BY day
)
SELECT j.complaint_type,
       SUM(j.cnt)                                AS total_complaints,
       COUNT(DISTINCT j.day)                     AS days_with_temp,
       ROUND(CORR(j.cnt, j.temp), 4)             AS corr_cnt_temp,
       ROUND(CORR(j.cnt / dt.tot_cnt, j.temp),4) AS corr_pct_temp
FROM joined j
JOIN daily_tot dt ON dt.day = j.day
GROUP BY complaint_type
HAVING ABS(corr_cnt_temp) > 0.5
ORDER BY ABS(corr_cnt_temp) DESC
LIMIT 20;
```

Each successive query builds familiarity with the relevant columns and data needed for the final correlation analysis.
