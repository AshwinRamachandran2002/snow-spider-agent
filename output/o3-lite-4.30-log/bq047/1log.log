```sql
--Description: (9) For 2012‑2014, find complaint types with >5 000 total requests and
--             |correlation|>0.5 between daily count and LaGuardia temperature.
WITH daily_temp AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day,
         temp
  FROM   `bigquery-public-data.noaa_gsod.gsod2012`
  WHERE  stn='725030' AND temp<>9999.9 UNION ALL
  SELECT DATE(CONCAT(year,'-',mo,'-',da)), temp
  FROM   `bigquery-public-data.noaa_gsod.gsod2013`
  WHERE  stn='725030' AND temp<>9999.9 UNION ALL
  SELECT DATE(CONCAT(year,'-',mo,'-',da)), temp
  FROM   `bigquery-public-data.noaa_gsod.gsod2014`
  WHERE  stn='725030' AND temp<>9999.9
),
daily_311 AS (
  SELECT DATE(created_date) AS day,
         complaint_type,
         COUNT(*)           AS cnt
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  created_date BETWEEN '2012-01-01' AND '2014-12-31'
  GROUP  BY day, complaint_type
),
summary AS (
  SELECT complaint_type,
         SUM(cnt)                        AS total_requests,
         CORR(cnt, temp)                 AS corr_cnt_temp
  FROM   daily_311
  JOIN   daily_temp USING(day)
  GROUP  BY complaint_type
)
SELECT *
FROM   summary
WHERE  total_requests > 5000
  AND  ABS(corr_cnt_temp) > 0.5
ORDER BY ABS(corr_cnt_temp) DESC
LIMIT 20;
