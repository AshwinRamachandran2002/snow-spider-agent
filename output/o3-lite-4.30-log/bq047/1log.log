Query:
--Description: (8) Pearson correlation between LaGuardia daily mean temperature
--             and total NYC 311 request volume for calendar year 2010 (first
--             full year with 311 data).  Excludes missing temperature values.
WITH daily_311 AS (
  SELECT DATE(created_date) AS day,
         COUNT(*)           AS cnt
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  created_date BETWEEN '2010-01-01' AND '2010-12-31'
  GROUP  BY day
),
daily_temp AS (
  SELECT DATE(CONCAT(year,'-',mo,'-',da)) AS day,
         temp
  FROM   `bigquery-public-data.noaa_gsod.gsod2010`
  WHERE  stn = '725030'          -- LaGuardia
    AND  temp <> 9999.9          -- valid temps only
)
SELECT ROUND(CORR(cnt, temp), 4) AS corr_cnt_temp
FROM   daily_311
JOIN   daily_temp USING (day)
