--Description: (7) Daily share of ‘HEAT/HOT WATER’ complaints within all 311 requests
--             during July 2013. Counts all requests per day (tot) and the subset that are
--             ‘HEAT/HOT WATER’, then computes the percentage.
WITH daily_tot AS (
  SELECT DATE(created_date) AS day,
         COUNT(*)           AS tot
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  created_date BETWEEN '2013-07-01' AND '2013-07-31'
  GROUP  BY day
),
daily_heat AS (
  SELECT DATE(created_date) AS day,
         COUNT(*)           AS heat_cnt
  FROM   `bigquery-public-data.new_york.311_service_requests`
  WHERE  complaint_type = 'HEAT/HOT WATER'
    AND  created_date BETWEEN '2013-07-01' AND '2013-07-31'
  GROUP  BY day
)
SELECT h.day,
       h.heat_cnt,
       t.tot,
       ROUND(100 * h.heat_cnt / t.tot, 2) AS pct_heat
FROM   daily_heat h
JOIN   daily_tot  t USING(day)
ORDER  BY h.day
LIMIT 20;
