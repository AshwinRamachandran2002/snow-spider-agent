Query:
--Description:
-- #10  Final answer – return the user whose activity spans the most months
--      (highest month_index) but still contains at least one missing month
--      inside that span, meaning they became inactive during the gap.
-- Steps
--   1. user_months : for every row, compute month_index (months since first activity).
--   2. agg         : per user, build an ordered array of month indexes (idxs)
--                    and capture the maximum index (max_idx).
--   3. inactive    : keep only users where ARRAY_LENGTH(idxs) < max_idx + 1,
--                    i.e. at least one expected month is absent.
--   4. Final SELECT: list those users ordered by max_idx DESC and limit to 20.
WITH user_months AS (
  SELECT
    `by`,
    DATE_DIFF(
      DATE_TRUNC(DATE(`timestamp`), MONTH),                         -- record's month
      MIN(DATE_TRUNC(DATE(`timestamp`), MONTH)) OVER (PARTITION BY `by`),
      MONTH
    ) AS month_index
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` < '2024-09-11'
    AND `by` IS NOT NULL
),
agg AS (
  SELECT
    `by`,
    ARRAY_AGG(DISTINCT month_index ORDER BY month_index) AS idxs,
    MAX(month_index)                                     AS max_idx
  FROM user_months
  GROUP BY `by`
),
inactive AS (
  SELECT
    `by`,
    idxs,
    max_idx
  FROM agg
  WHERE ARRAY_LENGTH(idxs) < max_idx + 1     -- at least one missing month
)
SELECT
  `by`    AS user_id,
  max_idx AS last_recorded_month_number
FROM inactive
ORDER BY max_idx DESC
LIMIT 20
