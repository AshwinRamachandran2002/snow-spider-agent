```sql
--Description:
-- Goal: show, for each record, the “month_index” = how many whole months
-- have elapsed since that user’s first month of activity (inclusive).
-- Steps / reasoning:
--   1. In CTE first_months, find every user's earliest month bucket
--      – cast TIMESTAMP to DATE, then DATE_TRUNC to the first day of that month.
--   2. Join the main table back to those first months.
--   3. Compute DATE_DIFF between each record’s own month bucket and the first
--      month bucket. DATE_DIFF with the MONTH part works on DATE values.
--   4. Filter data before 2024‑09‑11 and require non‑NULL authors.
--   5. LIMIT 20 for a quick sample.
WITH first_months AS (
  SELECT
    `by`,
    DATE_TRUNC(DATE(MIN(`timestamp`)), MONTH) AS first_month
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` < '2024-09-11'
    AND `by` IS NOT NULL
  GROUP BY `by`
)
SELECT
  t.`by`,
  DATE_TRUNC(DATE(t.`timestamp`), MONTH)               AS activity_month,
  DATE_DIFF(
    DATE_TRUNC(DATE(t.`timestamp`), MONTH),             -- current record’s month
    f.first_month,                                      -- user’s first month
    MONTH
  ) AS month_index
FROM `bigquery-public-data.hacker_news.full` AS t
JOIN first_months AS f
  USING (`by`)
WHERE t.`timestamp` < '2024-09-11'
  AND t.`by` IS NOT NULL
LIMIT 20;
