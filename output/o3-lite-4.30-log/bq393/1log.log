    DATE_DIFF(
      DATE_TRUNC(DATE(`timestamp`), MONTH),                       -- this record's month
      MIN(DATE_TRUNC(DATE(`timestamp`), MONTH)) OVER              -- user's first month
        (PARTITION BY `by`),
      MONTH
    ) AS month_index
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` < '2024-09-11'
    AND `by` IS NOT NULL
)
SELECT
  `by`,
  ARRAY_AGG(DISTINCT month_index ORDER BY month_index) AS month_indexes
FROM user_months
GROUP BY `by`
