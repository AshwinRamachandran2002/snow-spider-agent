    ARRAY_AGG(DISTINCT month_index ORDER BY month_index) AS idx_arr
  FROM user_months
  GROUP BY `by`
),
calc AS (
  SELECT
    `by`,
    idx_arr,
    ARRAY_LENGTH(idx_arr)                           AS seen_months,
    (SELECT MAX(idx) FROM UNNEST(idx_arr) AS idx)   AS last_idx
  FROM per_user
)
SELECT
  `by`,
  idx_arr,
  seen_months,
  last_idx,
  last_idx + 1                   AS should_have_months,
  last_idx + 1 - seen_months     AS missing_inside_span
FROM calc
WHERE seen_months < last_idx + 1     -- at least one missing month
LIMIT 20;
