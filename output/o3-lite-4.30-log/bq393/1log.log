--        recorded month (DATE_DIFF on DATE‑truncated values).
-- 2. per_user
--      • Aggregate the DISTINCT month_index values for each user into an ordered
--        array (idx_arr).  This array represents the months we actually observe.
-- 3. calc
--      • Derive helper metrics per user:
--          ‑ seen_months = length of idx_arr.
--          ‑ last_idx    = largest month_index present.
--      • A gap exists when seen_months < last_idx + 1 because at least one
--        month between 0 … last_idx is missing from idx_arr.
-- 4. Final SELECT
--      • Return a sample of such users with diagnostics: which indexes exist,
--        how many should exist, and how many are missing.
WITH user_months AS (
  SELECT
    `by`,
    DATE_DIFF(
      DATE_TRUNC(DATE(`timestamp`), MONTH),                        -- this record's month
      MIN(DATE_TRUNC(DATE(`timestamp`), MONTH)) OVER (PARTITION BY `by`),
      MONTH
