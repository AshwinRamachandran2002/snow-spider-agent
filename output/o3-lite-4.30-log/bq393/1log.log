Begin Exploring Related Columns
Relevant columns and how they will be used  

`by`: user / author identifier – grouping key  
`timestamp`: precise activity time – build a month bucket, apply the “up to 2024‑09‑10” cut‑off  
`time`: alternative Unix epoch (not really needed once we have `timestamp`)  
`type`: can be used to keep only real items (OPTIONAL: `type IN ('story','comment','poll','pollopt','job')`)  
`dead`, `deleted`: OPTIONAL filters to ignore removed content  
`id`: uniqueness check if needed for deduplication  

Main conditions that will repeatedly appear  

• `WHERE timestamp < '2024-09-11'` – ignore any future data  
• (optional) `AND deleted IS NOT TRUE AND dead IS NOT TRUE` – ignore removed items  

--------------------------------------------------------------------
10 step‑by‑step exploratory → analytic queries  
(All queries put a hard `LIMIT 20` so they can be run quickly.)

```sql
-- 1. Quick look at authors and dates
SELECT DISTINCT
  `by`,
  DATE(`timestamp`) AS activity_date
FROM `bigquery-public-data.hacker_news.full`
WHERE `timestamp` < '2024-09-11'
LIMIT 20;
```

```sql
-- 2. Same as #1, but show raw TIMESTAMP and TYPE for context
SELECT
  `by`,
  `timestamp`,
  `type`
FROM `bigquery-public-data.hacker_news.full`
WHERE `timestamp` < '2024-09-11'
  AND `by` IS NOT NULL
LIMIT 20;
```

```sql
-- 3. Get one row per user‑month to see how dense the data is
SELECT DISTINCT
  `by`,
  FORMAT_DATE('%Y-%m', DATE_TRUNC(`timestamp`, MONTH)) AS ym
FROM `bigquery-public-data.hacker_news.full`
WHERE `timestamp` < '2024-09-11'
  AND `by` IS NOT NULL
LIMIT 20;
```

```sql
-- 4. Count how many different months each user has activity
SELECT
  `by`,
  COUNT(DISTINCT FORMAT_DATE('%Y-%m', DATE_TRUNC(`timestamp`, MONTH))) AS active_months
FROM `bigquery-public-data.hacker_news.full`
WHERE `timestamp` < '2024-09-11'
  AND `by` IS NOT NULL
GROUP BY `by`
ORDER BY active_months DESC
LIMIT 20;
```

```sql
-- 5. Find every user’s first month (min) and last month (max) of activity
SELECT
  `by`,
  MIN(DATE_TRUNC(`timestamp`, MONTH)) AS first_month_ts,
  MAX(DATE_TRUNC(`timestamp`, MONTH)) AS last_month_ts
FROM `bigquery-public-data.hacker_news.full`
WHERE `timestamp` < '2024-09-11'
  AND `by` IS NOT NULL
GROUP BY `by`
LIMIT 20;
```

```sql
-- 6. Add number of months between first and last activity
SELECT
  `by`,
  DATE_TRUNC(MIN(`timestamp`), MONTH) AS first_month,
  DATE_TRUNC(MAX(`timestamp`), MONTH) AS last_month,
  TIMESTAMP_DIFF(MAX(`timestamp`), MIN(`timestamp`), MONTH) + 1 AS months_span
FROM `bigquery-public-data.hacker_news.full`
WHERE `timestamp` < '2024-09-11'
  AND `by` IS NOT NULL
GROUP BY `by`
LIMIT 20;
```

```sql
-- 7. Prepare list of (user, month_index) actually present
SELECT
  `by`,
  TIMESTAMP_DIFF(DATE_TRUNC(`timestamp`, MONTH),
                 MIN(DATE_TRUNC(`timestamp`, MONTH)) OVER (PARTITION BY `by`),
                 MONTH) AS month_index
FROM `bigquery-public-data.hacker_news.full`
WHERE `timestamp` < '2024-09-11'
  AND `by` IS NOT NULL
LIMIT 20;
```

```sql
-- 8. Gather per‑user arrays of existing month indexes
SELECT
  `by`,
  ARRAY_AGG(DISTINCT
    TIMESTAMP_DIFF(DATE_TRUNC(`timestamp`, MONTH),
                   MIN(DATE_TRUNC(`timestamp`, MONTH)) OVER (PARTITION BY `by`),
                   MONTH)
    ORDER BY 1) AS month_indexes
FROM `bigquery-public-data.hacker_news.full`
WHERE `timestamp` < '2024-09-11'
  AND `by` IS NOT NULL
GROUP BY `by`
LIMIT 20;
```

```sql
-- 9. Detect users that have at least one missing month within span
WITH per_user AS (
  SELECT
    `by`,
    ARRAY_AGG(DISTINCT
      TIMESTAMP_DIFF(DATE_TRUNC(`timestamp`, MONTH),
                     MIN(DATE_TRUNC(`timestamp`, MONTH)) OVER (PARTITION BY `by`),
                     MONTH)
      ORDER BY 1) AS idx_arr
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` < '2024-09-11'
    AND `by` IS NOT NULL
  GROUP BY `by`
)
SELECT
  `by`,
  idx_arr,
  ARRAY_LENGTH(idx_arr) AS seen_months,
  (SELECT MAX(x) FROM UNNEST(idx_arr) AS x) AS last_idx,
  (SELECT MAX(x) FROM UNNEST(GENERATE_ARRAY(0,
        (SELECT MAX(x) FROM UNNEST(idx_arr) AS x))) ) AS should_have,
  (SELECT MAX(x) FROM UNNEST(idx_arr) AS x) - ARRAY_LENGTH(idx_arr) + 1 AS missing_inside_span
FROM per_user
WHERE ARRAY_LENGTH(idx_arr) < (SELECT MAX(x) FROM UNNEST(idx_arr) AS x) + 1
LIMIT 20;
```

```sql
-- 10. FINAL – user with the highest month number who later became inactive
--     (returns that user's id and their highest month_index)
WITH user_months AS (
  SELECT
    `by`,
    TIMESTAMP_DIFF(
      DATE_TRUNC(`timestamp`, MONTH),
      MIN(DATE_TRUNC(`timestamp`, MONTH)) OVER (PARTITION BY `by`),
      MONTH) AS month_index
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` < '2024-09-11'
    AND `by` IS NOT NULL
),
agg AS (
  SELECT
    `by`,
    ARRAY_AGG(DISTINCT month_index ORDER BY month_index) AS idxs,
    MAX(month_index) AS max_idx
  FROM user_months
  GROUP BY `by`
),
inactive AS (
  SELECT
    `by`,
    max_idx
  FROM agg
  WHERE ARRAY_LENGTH(idxs) < max_idx + 1   -- there exists at least one missing month
)
SELECT
  `by`     AS user_id,
  max_idx  AS last_recorded_month_number
FROM inactive
ORDER BY max_idx DESC
LIMIT 20;
--Description:
--Finds the user whose activity spans the most months (max_idx) but still has
--holes inside that span, meaning they became inactive after their last recorded
--month. Shows that user and the month number counted from their first month.
```

