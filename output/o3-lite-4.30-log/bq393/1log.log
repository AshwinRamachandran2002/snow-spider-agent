```sql
--Description:
-- #9  Detect users that have at least one missing month inside their activity span.
-- Steps
--   1. CTE user_months   : compute month_index (months since first activity) for every record.
--   2. CTE per_user      : gather DISTINCT month_index values into an array (idx_arr) per user.
--   3. Final SELECT      : show, for each user, how many months were seen, the
--                          highest index, and how many interior months are missing;
--                          keep only users whose idx_arr length is smaller than
--                          max_idx + 1 (i.e. at least one gap).
WITH user_months AS (
  SELECT
    `by`,
    DATE_DIFF(
      DATE_TRUNC(DATE(`timestamp`), MONTH),                       -- this record’s month
      MIN(DATE_TRUNC(DATE(`timestamp`), MONTH)) OVER (PARTITION BY `by`),
      MONTH
    ) AS month_index
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` < '2024-09-11'
    AND `by` IS NOT NULL
),
per_user AS (
  SELECT
    `by`,
    ARRAY_AGG(DISTINCT month_index) AS idx_arr
  FROM user_months
  GROUP BY `by`
)
SELECT
  `by`,
  idx_arr,
  ARRAY_LENGTH(idx_arr) AS seen_months,
  (SELECT MAX(x) FROM UNNEST(idx_arr) AS x)                         AS last_idx,
  (SELECT MAX(x) FROM UNNEST(GENERATE_ARRAY(0,
        (SELECT MAX(x) FROM UNNEST(idx_arr) AS x))))                AS should_have,
  (SELECT MAX(x) FROM UNNEST(idx_arr) AS x) - ARRAY_LENGTH(idx_arr) + 1
        AS missing_inside_span
FROM per_user
WHERE ARRAY_LENGTH(idx_arr) < (SELECT MAX(x) FROM UNNEST(idx_arr) AS x) + 1
LIMIT 20;
```

```sql
--Description:
-- #10  Final answer – find the user whose activity covers the most months
--       (highest month_index) but still has at least one missing month
--       inside that span (became inactive).
--   1. user_months : compute month_index for every record.
--   2. agg         : per user, collect array of month indexes (idxs) and max_idx.
--   3. inactive    : keep only users where the array length is < max_idx + 1
--                    (i.e. at least one expected month is missing).
--   4. Return the user with the greatest max_idx.
WITH user_months AS (
  SELECT
    `by`,
    DATE_DIFF(
      DATE_TRUNC(DATE(`timestamp`), MONTH),
      MIN(DATE_TRUNC(DATE(`timestamp`), MONTH)) OVER (PARTITION BY `by`),
      MONTH
    ) AS month_index
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` < '2024-09-11'
    AND `by` IS NOT NULL
),
agg AS (
  SELECT
    `by`,
    ARRAY_AGG(DISTINCT month_index) AS idxs,
    MAX(month_index)                AS max_idx
  FROM user_months
  GROUP BY `by`
),
inactive AS (
  SELECT
    `by`,
    max_idx
  FROM agg
  WHERE ARRAY_LENGTH(idxs) < max_idx + 1     -- at least one gap in activity
)
SELECT
  `by`    AS user_id,
  max_idx AS last_recorded_month_number
FROM inactive
ORDER BY max_idx DESC
LIMIT 20;
```
