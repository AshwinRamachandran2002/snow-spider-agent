Query:
--Description: 10) Final – user with the single highest month_number that is missing (inactivity after an active streak).
WITH activity AS (
  SELECT
    `by`,
    DATE_TRUNC(CAST(`timestamp` AS DATE), MONTH) AS mth
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` <= '2024-09-10'
    AND `by` IS NOT NULL
), extremes AS (
  SELECT
    `by`,
    MIN(mth) AS first_mth,
    MAX(mth) AS last_mth
  FROM activity
  GROUP BY `by`
), month_series AS (
  SELECT
    e.`by`,
    mth,
    DATE_DIFF(mth, e.first_mth, MONTH) AS month_number
  FROM   extremes AS e,
         UNNEST(GENERATE_DATE_ARRAY(e.first_mth, e.last_mth, INTERVAL 1 MONTH)) AS mth
), missing AS (
  SELECT
    ms.`by`,
    ms.month_number
  FROM   month_series AS ms
  LEFT  JOIN activity AS a
         ON a.`by` = ms.`by`
        AND a.mth = ms.mth
  WHERE  a.mth IS NULL
), ranked AS (
  SELECT
    `by`,
    MAX(month_number) AS highest_missing_month
  FROM   missing
  GROUP  BY `by`
)
SELECT
  `by`  AS user_id,
  highest_missing_month AS month_number_since_first
FROM   ranked
ORDER  BY highest_missing_month DESC
LIMIT 20
Answer:
user_id,month_number_since_first
