Query:
--Description: 9) For users with at least one inactive month, return their highest missing month_number.
WITH activity AS (
  SELECT
    `by`,
    DATE_TRUNC(CAST(`timestamp` AS DATE), MONTH) AS mth
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` <= '2024-09-10'
    AND `by` IS NOT NULL
), extremes AS (
  SELECT
    `by`,
    MIN(mth) AS first_mth,
    MAX(mth) AS last_mth
  FROM activity
  GROUP BY `by`
), series AS (
  SELECT
    e.`by`,
    mth,
    DATE_DIFF(mth, e.first_mth, MONTH) AS month_number
  FROM   extremes AS e,
         UNNEST(GENERATE_DATE_ARRAY(e.first_mth, e.last_mth, INTERVAL 1 MONTH)) AS mth
), missing AS (
  SELECT
    s.`by`,
    s.month_number
  FROM   series AS s
  LEFT  JOIN activity AS a
         ON a.`by` = s.`by`
        AND a.mth  = s.mth
  WHERE  a.mth IS NULL
)
SELECT
  `by`,
  MAX(month_number) AS max_missing_month_number
FROM   missing
GROUP  BY `by`
ORDER  BY max_missing_month_number DESC
LIMIT 20
