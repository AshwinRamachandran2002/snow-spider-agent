Query:
--Description: 6) 20 users with the highest count of distinct active months (correct as‑is; no TIMESTAMP arithmetic involved).
WITH months AS (
  SELECT
    `by`,
    COUNT(DISTINCT FORMAT_TIMESTAMP('%Y-%m', `timestamp`)) AS active_months
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` <= '2024-09-10'
    AND `by` IS NOT NULL
  GROUP BY `by`
)
SELECT *
FROM   months
ORDER  BY active_months DESC
LIMIT 20
