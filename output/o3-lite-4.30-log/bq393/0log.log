Query:
--Description: 7) Generate each user’s full month series (DATE type) and flag months with no activity.
WITH per_user AS (
  SELECT
    `by`,
    MIN(DATE_TRUNC(CAST(`timestamp` AS DATE), MONTH)) AS first_month,
    MAX(DATE_TRUNC(CAST(`timestamp` AS DATE), MONTH)) AS last_month
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` <= '2024-09-10'
    AND `by` IS NOT NULL
  GROUP BY `by`
), series AS (
  SELECT
    u.`by`,
    mth AS month_bucket
  FROM   per_user AS u,
         UNNEST(GENERATE_DATE_ARRAY(u.first_month, u.last_month, INTERVAL 1 MONTH)) AS mth
)
SELECT
  s.`by`,
  FORMAT_DATE('%Y-%m', s.month_bucket) AS month_bucket,
  COUNT(f.id) = 0 AS is_missing
FROM   series AS s
LEFT  JOIN `bigquery-public-data.hacker_news.full` AS f
       ON  f.`by` = s.`by`
       AND DATE_TRUNC(CAST(f.`timestamp` AS DATE), MONTH) = s.month_bucket
       AND f.`timestamp` <= '2024-09-10'
GROUP BY s.`by`, month_bucket
HAVING is_missing
LIMIT 20
