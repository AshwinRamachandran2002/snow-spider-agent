Query:
--Description: 8) Count how many within‑span months each user missed (no activity rows).
WITH user_span AS (
  SELECT
    `by`,
    MIN(DATE_TRUNC(CAST(`timestamp` AS DATE), MONTH)) AS first_month,
    MAX(DATE_TRUNC(CAST(`timestamp` AS DATE), MONTH)) AS last_month
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` <= '2024-09-10'
    AND `by` IS NOT NULL
  GROUP BY `by`
), all_months AS (
  SELECT
    u.`by`,
    mth AS month_bucket
  FROM   user_span AS u,
         UNNEST(GENERATE_DATE_ARRAY(u.first_month, u.last_month, INTERVAL 1 MONTH)) AS mth
), missing AS (
  SELECT
    a.`by`,
    COUNT(*) AS missing_months
  FROM   all_months AS a
  LEFT  JOIN `bigquery-public-data.hacker_news.full` AS f
         ON f.`by` = a.`by`
        AND DATE_TRUNC(CAST(f.`timestamp` AS DATE), MONTH) = a.month_bucket
        AND f.`timestamp` <= '2024-09-10'
  WHERE f.id IS NULL
  GROUP BY a.`by`
)
SELECT *
FROM   missing
WHERE  missing_months > 0
ORDER  BY missing_months DESC
LIMIT 20
