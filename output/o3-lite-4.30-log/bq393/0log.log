Begin Exploring Related Columns
Relevant columns and their potential usage  
• `by`: identifies the author (user ID) of each row – primary key for all user‐level aggregations.  
• `timestamp`: activity datetime – used to order events, truncate to months, and apply the cut‑off date (`<= '2024‑09‑10'`).  
• `time`: Unix version of `timestamp`; can be ignored when `timestamp` is present.  
• `type`: lets you keep only true user activity (e.g. `type IN ('story','comment','poll','job')`).  
• `deleted`: when TRUE the row is marked deleted – optionally filtered out.  
• `dead`: when TRUE the item is dead – optionally filtered out.  
• `id`: unique per activity – handy for counting rows.  

Typical filter conditions you may combine  
```
WHERE  timestamp <= '2024-09-10'
  AND  by IS NOT NULL
  AND  deleted IS NOT TRUE                    -- ignore deleted rows
  AND  dead    IS NOT TRUE                    -- ignore dead rows
  AND  type    IN ('story','comment','poll')  -- real user activity
```


10 exploratory → analytical queries (each limited to 20 rows)  
```sql
--Description: 1) Show 20 different user IDs that have non‑null activity.
SELECT DISTINCT `by`
FROM   `bigquery-public-data.hacker_news.full`
WHERE  `by` IS NOT NULL
LIMIT  20;
```

```sql
--Description: 2) Earliest and latest activity timestamps for 20 users.
SELECT `by`,
       MIN(`timestamp`) AS first_ts,
       MAX(`timestamp`) AS last_ts
FROM   `bigquery-public-data.hacker_news.full`
WHERE  `by` IS NOT NULL
GROUP  BY `by`
ORDER  BY first_ts
LIMIT  20;
```

```sql
--Description: 3) Sample raw activity rows after 1‑Sep‑2024 cut‑off filter.
SELECT `by`, `timestamp`, `type`, `id`
FROM   `bigquery-public-data.hacker_news.full`
WHERE  `timestamp` <= '2024-09-10'
  AND  `by` IS NOT NULL
ORDER  BY `timestamp` DESC
LIMIT  20;
```

```sql
--Description: 4) Extract the YYYY‑MM bucket and count activities per bucket for one user.
SELECT FORMAT_TIMESTAMP('%Y-%m', `timestamp`) AS year_month,
       COUNT(*) AS posts
FROM   `bigquery-public-data.hacker_news.full`
WHERE  `by` = 'pg'                       -- replace with any user
  AND  `timestamp` <= '2024-09-10'
GROUP  BY year_month
ORDER  BY year_month
LIMIT  20;
```

```sql
--Description: 5) Compute first activity month and the month_number (0‑based) for each row of one user.
SELECT id,
       `timestamp`,
       FORMAT_TIMESTAMP('%Y-%m', `timestamp`)                         AS year_month,
       TIMESTAMP_DIFF(DATE_TRUNC(`timestamp`, MONTH),
                      MIN(DATE_TRUNC(`timestamp`, MONTH)) OVER(), MONTH) AS month_number
FROM   `bigquery-public-data.hacker_news.full`
WHERE  `by` = 'pg'
  AND  `timestamp` <= '2024-09-10'
ORDER  BY `timestamp`
LIMIT  20;
```

```sql
--Description: 6) For 20 users, list how many distinct months they were active.
WITH months AS (
  SELECT `by`,
         COUNT(DISTINCT FORMAT_TIMESTAMP('%Y-%m', `timestamp`)) AS active_months
  FROM   `bigquery-public-data.hacker_news.full`
  WHERE  `timestamp` <= '2024-09-10'
    AND  `by` IS NOT NULL
  GROUP  BY `by`
)
SELECT *
FROM   months
ORDER  BY active_months DESC
LIMIT  20;
```

```sql
--Description: 7) Generate the complete month series between each user’s first and last activity and flag missing months.
WITH per_user AS (
  SELECT `by`,
         MIN(DATE_TRUNC(`timestamp`, MONTH)) AS first_month,
         MAX(DATE_TRUNC(`timestamp`, MONTH)) AS last_month
  FROM   `bigquery-public-data.hacker_news.full`
  WHERE  `timestamp` <= '2024-09-10'
    AND  `by` IS NOT NULL
  GROUP  BY `by`
), series AS (
  SELECT u.`by`,
         mth AS month_bucket
  FROM   per_user AS u,
         UNNEST(GENERATE_DATE_ARRAY(u.first_month, u.last_month, INTERVAL 1 MONTH)) AS mth
)
SELECT s.`by`,
       FORMAT_DATE('%Y-%m', s.month_bucket) AS month_bucket,
       COUNT(f.id) = 0                       AS is_missing
FROM   series AS s
LEFT  JOIN `bigquery-public-data.hacker_news.full` AS f
       ON f.`by` = s.`by`
      AND DATE_TRUNC(f.`timestamp`, MONTH) = s.month_bucket
      AND f.`timestamp` <= '2024-09-10'
GROUP  BY s.`by`, month_bucket
HAVING is_missing
LIMIT  20;
```

```sql
--Description: 8) Count how many missing months each user has within their activity span.
WITH gap AS (
  -- re‑use logic from query 7
  SELECT s.`by`, COUNT(*) AS missing_months
  FROM (
        SELECT u.`by`,
               mth AS month_bucket
        FROM  (
              SELECT `by`,
                     MIN(DATE_TRUNC(`timestamp`, MONTH)) AS first_month,
                     MAX(DATE_TRUNC(`timestamp`, MONTH)) AS last_month
              FROM   `bigquery-public-data.hacker_news.full`
              WHERE  `timestamp` <= '2024-09-10'
                AND  `by` IS NOT NULL
              GROUP  BY `by`
        ) AS u,
        UNNEST(GENERATE_DATE_ARRAY(u.first_month, u.last_month, INTERVAL 1 MONTH)) AS mth
  ) AS s
  LEFT JOIN `bigquery-public-data.hacker_news.full` AS f
         ON f.`by` = s.`by`
        AND DATE_TRUNC(f.`timestamp`, MONTH) = s.month_bucket
        AND f.`timestamp` <= '2024-09-10'
  WHERE f.id IS NULL
  GROUP BY s.`by`
)
SELECT *
FROM   gap
WHERE  missing_months > 0
ORDER  BY missing_months DESC
LIMIT  20;
```

```sql
--Description: 9) For users with any missing month, show the highest month_number that is missing.
WITH activity AS (
  SELECT `by`,
         DATE_TRUNC(`timestamp`, MONTH) AS mth
  FROM   `bigquery-public-data.hacker_news.full`
  WHERE  `timestamp` <= '2024-09-10'
    AND  `by` IS NOT NULL
), extremes AS (
  SELECT `by`,
         MIN(mth) AS first_mth,
         MAX(mth) AS last_mth
  FROM   activity
  GROUP  BY `by`
), series AS (
  SELECT e.`by`,
         mth,
         TIMESTAMP_DIFF(mth, e.first_mth, MONTH) AS month_number
  FROM   extremes AS e,
         UNNEST(GENERATE_DATE_ARRAY(e.first_mth, e.last_mth, INTERVAL 1 MONTH)) AS mth
), missing AS (
  SELECT s.`by`,
         s.month_number
  FROM   series AS s
  LEFT  JOIN activity AS a
         ON a.`by` = s.`by` AND a.mth = s.mth
  WHERE  a.mth IS NULL
)
SELECT `by`,
       MAX(month_number) AS max_missing_month_number
FROM   missing
GROUP  BY `by`
ORDER  BY max_missing_month_number DESC
LIMIT  20;
```

```sql
--Description: 10) FINAL ‑ identify the user with the single highest month_number that later became inactive (no more rows afterwards).
WITH activity AS (
  SELECT `by`,
         DATE_TRUNC(`timestamp`, MONTH) AS mth
  FROM   `bigquery-public-data.hacker_news.full`
  WHERE  `timestamp` <= '2024-09-10'
    AND  `by` IS NOT NULL
), extremes AS (
  SELECT `by`,
         MIN(mth) AS first_mth,
         MAX(mth) AS last_mth
  FROM   activity
  GROUP  BY `by`
), months AS (
  SELECT e.`by`,
         mth,
         TIMESTAMP_DIFF(mth, e.first_mth, MONTH) AS month_number
  FROM   extremes AS e,
         UNNEST(GENERATE_DATE_ARRAY(e.first_mth, e.last_mth, INTERVAL 1 MONTH)) AS mth
), missing AS (
  SELECT m.`by`, m.month_number
  FROM   months AS m
  LEFT  JOIN activity AS a
         ON a.`by` = m.`by` AND a.mth = m.mth
  WHERE  a.mth IS NULL
), ranked AS (
  SELECT `by`,
         MAX(month_number) AS highest_missing_month
  FROM   missing
  GROUP  BY `by`
)
SELECT  `by`              AS user_id,
        highest_missing_month AS month_number_since_first
FROM    ranked
ORDER   BY highest_missing_month DESC
LIMIT   20;
```

