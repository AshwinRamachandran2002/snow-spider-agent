/*  Most‑recent approval date per molecule for company = 'SanofiAventis'  */
SELECT
  CAST(molregno AS STRING)                        AS molregno,
  trade_name,
  approval_date                                   AS most_recent_approval_date
FROM (
  SELECT
    f.molregno,
    p.trade_name,
    DATE(TIMESTAMP(p.approval_date))              AS approval_date,
    ROW_NUMBER() OVER (PARTITION BY f.molregno
                       ORDER BY DATE(TIMESTAMP(p.approval_date)) DESC,
                                p.trade_name)     AS rn
  FROM (
        SELECT product_id, trade_name, approval_date
        FROM `bigquery-public-data.ebi_chembl.products`
        WHERE LOWER(applicant_full_name) = 'sanofiaventis'
        UNION ALL
        SELECT product_id, trade_name, approval_date
        FROM `bigquery-public-data.ebi_chembl.products_23`
        WHERE LOWER(applicant_full_name) = 'sanofiaventis'
       ) AS p
  JOIN (
        SELECT product_id, molregno
        FROM `bigquery-public-data.ebi_chembl.formulations`
        UNION ALL
        SELECT product_id, molregno
        FROM `bigquery-public-data.ebi_chembl.formulations_23`
       ) AS f
  ON p.product_id = f.product_id
)
WHERE rn = 1
ORDER BY molregno;
