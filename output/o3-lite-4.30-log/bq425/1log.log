/*  Latest‑approval SanofiAventis molecules – ChEMBL release 23  */
WITH sa_products AS (
  -- products_23 rows whose applicant_full_name is exactly 'SanofiAventis'
  SELECT
    product_id,
    trade_name,
    DATE(SUBSTR(approval_date,1,10)) AS approval_date
  FROM `bigquery-public-data.ebi_chembl.products_23`
  WHERE TRIM(UPPER(applicant_full_name)) = 'SANOFIAVENTIS'
),
joined AS (
  SELECT
    f.molregno,
    p.trade_name,
    p.approval_date,
    ROW_NUMBER() OVER (PARTITION BY f.molregno
                       ORDER BY p.approval_date DESC, p.trade_name) AS rn
  FROM sa_products AS p
  JOIN `bigquery-public-data.ebi_chembl.formulations_23` AS f
  USING (product_id)
)
SELECT
  CAST(molregno AS STRING)  AS molregno,
  trade_name,
  approval_date            AS most_recent_approval_date
FROM joined
WHERE rn = 1
ORDER BY molregno;
