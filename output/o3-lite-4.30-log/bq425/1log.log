```sql
/* Distinct SanofiAventis molecules with their latest approval date */
WITH sa_products AS (
  -- Products whose applicant_full_name is exactly “SanofiAventis” (case‑insensitive)
  SELECT
    product_id,
    trade_name,
    DATE(TIMESTAMP(approval_date)) AS approval_date
  FROM `bigquery-public-data.ebi_chembl.products`
  WHERE UPPER(applicant_full_name) = 'SANOFIAVENTIS'
  
  UNION ALL
  
  SELECT
    product_id,
    trade_name,
    DATE(TIMESTAMP(approval_date)) AS approval_date
  FROM `bigquery-public-data.ebi_chembl.products_23`
  WHERE UPPER(applicant_full_name) = 'SANOFIAVENTIS'
),
all_formulations AS (
  -- Link every product to its molecule (molregno)
  SELECT product_id, molregno
  FROM `bigquery-public-data.ebi_chembl.formulations`
  
  UNION ALL
  
  SELECT product_id, molregno
  FROM `bigquery-public-data.ebi_chembl.formulations_23`
),
joined AS (
  SELECT
    f.molregno,
    p.trade_name,
    p.approval_date,
    ROW_NUMBER() OVER (PARTITION BY f.molregno
                       ORDER BY p.approval_date DESC, p.trade_name) AS rn
  FROM sa_products        AS p
  JOIN all_formulations   AS f
  USING (product_id)
)
SELECT
  CAST(molregno AS STRING)              AS molregno,
  trade_name,
  approval_date                         AS most_recent_approval_date
FROM joined
WHERE rn = 1
ORDER BY molregno;
```
