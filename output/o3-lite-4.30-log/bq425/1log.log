-- Most‑recently approved SanofiAventis molecules in ChEMBL release 23
WITH sa_products AS (
  SELECT
    f.molregno,
    p.trade_name,
    DATE(TIMESTAMP(p.approval_date)) AS approval_date
  FROM `bigquery-public-data.ebi_chembl.products_23`      AS p
  JOIN `bigquery-public-data.ebi_chembl.formulations_23` AS f
  ON  p.product_id = f.product_id
  WHERE p.applicant_full_name = 'SanofiAventis'           -- exact match
),
ranked AS (
  SELECT
    molregno,
    trade_name,
    approval_date,
    ROW_NUMBER() OVER (PARTITION BY molregno
                       ORDER BY approval_date DESC, trade_name) AS rn
  FROM sa_products
)
SELECT
  CAST(molregno AS STRING)            AS molregno,
  trade_name,
  approval_date                       AS most_recent_approval_date
FROM ranked
WHERE rn = 1
ORDER BY molregno;
