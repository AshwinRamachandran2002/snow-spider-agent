  ON p.product_id = f.product_id
WHERE LOWER(p.applicant_full_name) LIKE '%sanofi%'
LIMIT 20;
```

```sql
--Description: Compute the most recent approval date per molecule for Sanofi‑related
--records in release‑23.
SELECT f.molregno,
       MAX(p.approval_date) AS latest_approval
FROM `bigquery-public-data.ebi_chembl.products_23` AS p
JOIN `bigquery-public-data.ebi_chembl.formulations_23` AS f
  ON p.product_id = f.product_id
WHERE LOWER(p.applicant_full_name) LIKE '%sanofi%'
GROUP BY f.molregno
ORDER BY f.molregno
LIMIT 20;
```

```sql
--Description: Keep only the rows whose approval_date equals the latest for each molecule,
--then emit molecule, trade name, latest approval.  Uses case‑insensitive “sanofi” filter.
WITH latest AS (
  SELECT f.molregno,
         MAX(p.approval_date) AS latest_approval
  FROM `bigquery-public-data.ebi_chembl.products_23` AS p
  JOIN `bigquery-public-data.ebi_chembl.formulations_23` AS f
    ON p.product_id = f.product_id
  WHERE LOWER(p.applicant_full_name) LIKE '%sanofi%'
  GROUP BY f.molregno
)
SELECT l.molregno,
       p.trade_name,
       l.latest_approval
FROM latest AS l
JOIN `bigquery-public-data.ebi_chembl.products_23` AS p
  ON p.approval_date = l.latest_approval
JOIN `bigquery-public-data.ebi_chembl.formulations_23` AS f
  ON f.product_id = p.product_id AND f.molregno = l.molregno
WHERE LOWER(p.applicant_full_name) LIKE '%sanofi%'
LIMIT 20;
```

```sql
--Description: Alternative method—use window MAX() plus ARRAY_AGG to select one
--trade name per molecule at the most recent approval date, still limited to
--Sanofi‑related applicant names.
SELECT molregno,
       ARRAY_AGG(trade_name ORDER BY trade_name LIMIT 1)[OFFSET(0)] AS trade_name,
       latest_approval
FROM (
  SELECT f.molregno,
         p.trade_name,
         p.approval_date,
         MAX(p.approval_date) OVER (PARTITION BY f.molregno) AS latest_approval
  FROM `bigquery-public-data.ebi_chembl.products_23` AS p
  JOIN `bigquery-public-data.ebi_chembl.formulations_23` AS f
    ON p.product_id = f.product_id
  WHERE LOWER(p.applicant_full_name) LIKE '%sanofi%'
)
WHERE approval_date = latest_approval
GROUP BY molregno, latest_approval
ORDER BY molregno
LIMIT 20;
```

```sql
--Description: FINAL—list each distinct molecule linked to any Sanofi entity,
--with one representative trade name and its most recent approval date, using
--release‑23 products and formulations tables.
WITH joined AS (
  SELECT f.molregno,
         p.trade_name,
         p.approval_date
  FROM `bigquery-public-data.ebi_chembl.products_23` AS p
  JOIN `bigquery-public-data.ebi_chembl.formulations_23` AS f
    ON p.product_id = f.product_id
  WHERE LOWER(p.applicant_full_name) LIKE '%sanofi%'
),
ranked AS (
  SELECT molregno,
         trade_name,
         approval_date,
         RANK() OVER (PARTITION BY molregno ORDER BY approval_date DESC, trade_name) AS rnk
  FROM joined
)
SELECT molregno,
       trade_name,
       approval_date AS latest_approval_date
FROM ranked
WHERE rnk = 1
ORDER BY molregno
LIMIT 20;
```
