```sql
WITH products AS (
  SELECT
    product_id,
    trade_name,
    SAFE_CAST(approval_date AS DATE) AS approval_date,
    applicant_full_name
  FROM `bigquery-public-data.ebi_chembl.products`
  UNION ALL
  SELECT
    product_id,
    trade_name,
    SAFE_CAST(approval_date AS DATE) AS approval_date,
    applicant_full_name
  FROM `bigquery-public-data.ebi_chembl.products_23`
),
/* keep only rows whose company name normalises exactly to `SanofiAventis`
   (spaces, dashes and dots are removed, then compared case‑insensitively) */
sanofi_products AS (
  SELECT
    product_id,
    trade_name,
    approval_date
  FROM products
  WHERE REPLACE(
          REGEXP_REPLACE(UPPER(TRIM(applicant_full_name)), r'[\-\.]', ''),
          ' ',
          ''
        ) = 'SANOFIAVENTIS'
),
formulations AS (
  SELECT product_id, molregno FROM `bigquery-public-data.ebi_chembl.formulations`
  UNION ALL
  SELECT product_id, molregno FROM `bigquery-public-data.ebi_chembl.formulations_23`
),
joined AS (
  SELECT
    f.molregno,
    sp.trade_name,
    sp.approval_date
  FROM sanofi_products AS sp
  JOIN formulations  AS f
    ON sp.product_id = f.product_id
),
latest_per_mol AS (
  SELECT
    molregno,
    MAX(approval_date) AS latest_approval_date
  FROM joined
  GROUP BY molregno
)
SELECT
  CAST(l.molregno AS STRING) AS molecule_id,
  ( SELECT ANY_VALUE(j.trade_name)
      FROM joined j
     WHERE j.molregno       = l.molregno
       AND j.approval_date  = l.latest_approval_date
  )                         AS trade_name,
  l.latest_approval_date    AS most_recent_approval_date
FROM latest_per_mol AS l
ORDER BY molecule_id;
```
