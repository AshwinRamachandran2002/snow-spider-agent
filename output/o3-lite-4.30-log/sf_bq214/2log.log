--Description (thinking process embedded):
-- Goal:  (a) identify the single U.S. B2 patent granted 2010‑2014 that has the
--        highest overall forward‑citation count, and
--        (b) within the SAME filing year, find the patent whose abstract/description
--        embedding is most textually similar to that top‑cited patent, regardless of kind.
--
-- Key steps
-- 1. Build `citing_map`: flatten every U.S. patent’s "citation" array, extract the
--    JSON field "publication_number" of each cited reference, and count how many times
--    each publication is cited (forward‑citation frequency).
-- 2. Limit our candidate set to B2 patents granted 2010‑2014, join to `citing_map`,
--    and pick the one with the highest forward‑citation count (`top_p`).
-- 3. Capture its filing year, then look at ALL U.S. patents filed in that year that
--    have embeddings.  For each, compute the dot product similarity against the
--    embedding of `top_p`.  Rank descending, keep the most similar (`most_similar`).
-- 4. Return publication numbers, forward‑citation count, similarity score.
--
-- Notes
-- • DOT_PRODUCT() is assumed to be available in Snowflake for ARRAY<FLOAT> vectors.
-- • Empty citation JSON objects are ignored by requiring a non‑null "publication_number".
-- • Forward‑citation count has no time window (all citations up to present).
WITH citing_map AS (
    SELECT
        f.value:"publication_number"::STRING  AS cited_pub,
        COUNT(*)                              AS fwd_cite_cnt
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
    WHERE p."country_code" = 'US'
      AND f.value:"publication_number" IS NOT NULL
      AND f.value:"publication_number"::STRING <> ''
    GROUP BY f.value:"publication_number"::STRING
),
b2_candidates AS (
    SELECT
        p."publication_number",
        p."filing_date",
        FLOOR(p."filing_date"/10000)      AS file_year,
        COALESCE(cm.fwd_cite_cnt, 0)      AS fwd_cite_cnt
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    LEFT JOIN citing_map cm
           ON cm.cited_pub = p."publication_number"
    WHERE p."country_code" = 'US'
      AND p."kind_code"   = 'B2'
      AND p."grant_date" BETWEEN 20100101 AND 20141231
),
top_p AS (       -- patent with max forward citations
    SELECT *
    FROM b2_candidates
    ORDER BY fwd_cite_cnt DESC
    LIMIT 1
),
top_embed AS (
    SELECT
        tp."publication_number",
        tp."fwd_cite_cnt",
        tp."file_year",
        ae."embedding_v1"                 AS top_vec
    FROM top_p tp
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB ae
          ON ae."publication_number" = tp."publication_number"
),
same_year_embeds AS (
    SELECT
        p."publication_number",
        ae."embedding_v1"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB ae
          ON ae."publication_number" = p."publication_number"
    JOIN top_embed te
          ON FLOOR(p."filing_date"/10000) = te."file_year"
    WHERE p."publication_number" <> te."publication_number"
      AND p."country_code" = 'US'
),
most_similar AS (
    SELECT
        te."publication_number"           AS top_cited_patent,
        te."fwd_cite_cnt",
        sy."publication_number"           AS similar_patent,
        DOT_PRODUCT(sy."embedding_v1", te.top_vec) AS similarity
    FROM top_embed te
    JOIN same_year_embeds sy
      ON TRUE
    ORDER BY similarity DESC
    LIMIT 1
)
SELECT *
FROM most_similar;
