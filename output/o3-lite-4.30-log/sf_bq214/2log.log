--Description (thinking process embedded):
-- Task:  Find the U.S. B2 patent granted 2010‑2014 that receives the greatest
--        number of forward citations made by U.S. patents whose filing dates
--        fall within ±30 (numeric) days of the focal patent’s filing date, then
--        identify the patent filed in the SAME year (any kind) that is most
--        text‑similar to the focal patent (via dot‑product of embeddings).
--
-- Steps
-- 1. citing_pairs  – flatten every U.S. patent’s "citation" array, extract the
--    cited publication number (JSON key "publication_number") and keep its
--    filing_date.  This yields (cited_pub, citing_file).
-- 2. focal_b2      – all U.S. patents of kind B2, granted 2010‑2014, with a
--    non‑null filing_date.
-- 3. focal_counts  – join citing_pairs to focal_b2 and retain citing events
--    whose filing_date is within ±30 days of the focal filing_date; count them.
-- 4. top_p         – select the patent with the maximum of these 30‑day counts.
-- 5. top_embed     – fetch its embedding vector.
-- 6. same_year_set – all U.S. patents (any kind) filed in the SAME filing year
--    and possessing an embedding; exclude the focal patent.
-- 7. most_similar  – compute dot‑product similarity between each candidate’s
--    embedding and the focal’s embedding; keep the highest.
-- 8. Return focal patent number, its 30‑day forward‑citation count, the most
--    similar same‑year patent number, and their similarity score.
WITH citing_pairs AS (
    SELECT
        f.value:"publication_number"::STRING   AS cited_pub,
        c."filing_date"                        AS citing_file
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS c,
         LATERAL FLATTEN(input => c."citation") f
    WHERE c."country_code" = 'US'
      AND c."filing_date"  IS NOT NULL
      AND f.value:"publication_number" IS NOT NULL
      AND f.value:"publication_number"::STRING <> ''
),
focal_b2 AS (
    SELECT
        p."publication_number",
        p."filing_date",
        FLOOR(p."filing_date"/10000)           AS file_year
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    WHERE p."country_code" = 'US'
      AND p."kind_code"   = 'B2'
      AND p."grant_date" BETWEEN 20100101 AND 20141231
      AND p."filing_date" IS NOT NULL
),
focal_counts AS (
    SELECT
        f."publication_number",
        f."filing_date",
        f."file_year",
        COUNT(*) AS fwd_cites_30d
    FROM focal_b2 f
    JOIN citing_pairs cp
      ON cp.cited_pub = f."publication_number"
     AND ABS(cp.citing_file - f."filing_date") <= 30
    GROUP BY f."publication_number", f."filing_date", f."file_year"
),
top_p AS (
    SELECT *
    FROM focal_counts
    ORDER BY fwd_cites_30d DESC
    LIMIT 1
),
top_embed AS (
    SELECT
        tp."publication_number"                AS focal_pub,
        tp."fwd_cites_30d",
        tp."file_year",
        ae."embedding_v1"                      AS focal_vec
    FROM top_p tp
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB ae
      ON ae."publication_number" = tp."publication_number"
),
same_year_set AS (
    SELECT
        p."publication_number",
        ae."embedding_v1"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB ae
      ON ae."publication_number" = p."publication_number"
    JOIN top_embed te
      ON FLOOR(p."filing_date"/10000) = te."file_year"
    WHERE p."publication_number" <> te."focal_pub"
),
most_similar AS (
    SELECT
        te."focal_pub",
        te."fwd_cites_30d",
        sys."publication_number"                          AS similar_pub,
        DOT_PRODUCT(sys."embedding_v1", te.focal_vec)     AS similarity
    FROM top_embed te
    JOIN same_year_set sys
      ON TRUE
    ORDER BY similarity DESC
    LIMIT 1
)
SELECT *
FROM most_similar;
