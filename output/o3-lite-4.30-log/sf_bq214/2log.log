Relevant columns, their potential usage, and the most obvious conditions

• "publication_number": unique identifier of every patent – used for joins and final display  
• "country_code": patent jurisdiction – filter to 'US'  
• "kind_code": document kind – filter to 'B2' (granted US utility)  
• "grant_date": grant (publication) date – restrict to 20100101‑20141231  
• "filing_date": application filing date – used to measure ± 30‑day window for forward citations  
• "citation": VARIANT array containing publication numbers cited BY each patent – after FLATTEN, used to create a forward‑citation count (by matching our candidate’s number to the citing patent’s list)  
• "family_id": allows aggregation across simple‑family if desired (not needed here, but sometimes helpful)  
• "embedding_v1" (in ABS_AND_EMB): vector of floats – used to compute cosine/dot‑product similarity between patents  
• "abstract" / "title" (ABS_AND_EMB): only for human diagnostic checks  
• "application_kind": can be checked for 'A' (utility application) though "kind_code"='B2' already implies a US utility grant  
• "grant_date", "filing_date": numeric YYYYMMDD – date filters, time‑difference calculation  
• "art_unit", "ipc", "cpc": other technology classifications – not necessary for requested answer but sometimes convenient for tie‑breaking / exploration  

Typical conditions  
• WHERE "country_code" = 'US'  
• AND   "kind_code"   = 'B2'  
• AND   "grant_date" BETWEEN 20100101 AND 20141231  
• In forward‑citation sub‑query: difference between citing patent’s "filing_date" and focal patent’s "filing_date" ≤ 30  

Below are 10 exploratory Snowflake SQL snippets (LIMIT 20) that progressively build toward the final result.  
All column names are enclosed in double quotes; comments precede each query.

```sql
-- 1. Description: List a few U.S. B2 utility patents granted between 2010‑2014
SELECT 
    "publication_number",
    "grant_date",
    "filing_date",
    "kind_code"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
WHERE "country_code" = 'US'
  AND "kind_code" = 'B2'
  AND "grant_date" BETWEEN 20100101 AND 20141231
LIMIT 20;
```

```sql
-- 2. Description: Distinct grant years of U.S. B2 patents in 2010‑2014 span
SELECT DISTINCT 
       FLOOR("grant_date"/10000) AS "grant_year"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
WHERE "country_code" = 'US'
  AND "kind_code" = 'B2'
  AND "grant_date" BETWEEN 20100101 AND 20141231
LIMIT 20;
```

```sql
-- 3. Description: Inspect the structure of the "citation" array for one random patent
SELECT 
    t."publication_number",
    f.value AS "raw_citation"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."citation") f
WHERE t."publication_number" = 'US-7650331-B1' -- replace with any example if empty
LIMIT 20;
```

```sql
-- 4. Description: Count forward citations that EACH U.S. patent (any kind) makes to others
SELECT 
    citing."publication_number"       AS "citing_pub",
    f.value::STRING                   AS "cited_pub"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS citing,
     LATERAL FLATTEN(input => citing."citation") f
WHERE citing."country_code" = 'US'
LIMIT 20;
```

```sql
-- 5. Description: Forward‑citation counts received by U.S. B2 patents (no time limit)
WITH cited_map AS (
    SELECT 
        f.value::STRING                      AS "cited_pub",
        COUNT(*) AS "forward_cite_cnt"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS citing,
         LATERAL FLATTEN(input => citing."citation") f
    WHERE citing."country_code" = 'US'
    GROUP BY f.value
)
SELECT 
    p."publication_number",
    cm."forward_cite_cnt"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
LEFT JOIN cited_map cm
       ON cm."cited_pub" = p."publication_number"
WHERE p."country_code" = 'US'
  AND p."kind_code" = 'B2'
  AND p."grant_date" BETWEEN 20100101 AND 20141231
ORDER BY cm."forward_cite_cnt" DESC NULLS LAST
LIMIT 20;
```

```sql
-- 6. Description: Forward citations RECEIVED within 30 days of the focal patent’s filing date
WITH citing_pairs AS (
    SELECT 
        citing."publication_number"     AS "citing_pub",
        f.value::STRING                 AS "cited_pub",
        citing."filing_date"            AS "citing_file"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS citing,
         LATERAL FLATTEN(input => citing."citation") f
    WHERE citing."country_code" = 'US'
),
focal AS (
    SELECT 
        "publication_number",
        "filing_date"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE "country_code" = 'US'
      AND "kind_code"   = 'B2'
      AND "grant_date" BETWEEN 20100101 AND 20141231
)
SELECT 
    focal."publication_number"           AS "focal_pub",
    COUNT(*)                             AS "fwd_cites_in_30d"
FROM focal
JOIN citing_pairs
  ON citing_pairs."cited_pub" = focal."publication_number"
 WHERE ABS(citing_pairs."citing_file" - focal."filing_date") <= 30
GROUP BY focal."publication_number"
ORDER BY "fwd_cites_in_30d" DESC
LIMIT 20;
```

```sql
-- 7. Description: Retrieve embedding vectors for patents filed in 2012
SELECT 
    a."publication_number",
    a."embedding_v1"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
  ON a."publication_number" = p."publication_number"
WHERE p."country_code" = 'US'
  AND p."filing_date" BETWEEN 20120101 AND 20121231
LIMIT 20;
```

```sql
-- 8. Description: Compute naive dot‑product similarity between two arbitrary 2012 patents (for demo)
WITH pair AS (
    SELECT 
        a1."publication_number" AS "pub1",
        a2."publication_number" AS "pub2",
        DOT_PRODUCT(a1."embedding_v1", a2."embedding_v1") AS "dot_sim"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a1
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a2
      ON TRUE
    WHERE a1."publication_number" <> a2."publication_number"
      AND a1."publication_number"  IN (SELECT "publication_number" 
                                        FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS 
                                        WHERE "filing_date" BETWEEN 20120101 AND 20121231 LIMIT 1)
      AND a2."publication_number"  IN (SELECT "publication_number" 
                                        FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS 
                                        WHERE "filing_date" BETWEEN 20120101 AND 20121231 LIMIT 1)
)
SELECT * FROM pair LIMIT 20;
```

```sql
-- 9. Description: For each filing year 2010‑2014, pull the B2 patent with most 30‑day forward cites
WITH citing_pairs AS (
    SELECT 
        citing."publication_number"     AS "citing_pub",
        f.value::STRING                 AS "cited_pub",
        citing."filing_date"            AS "citing_file"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS citing,
         LATERAL FLATTEN(input => citing."citation") f
    WHERE citing."country_code" = 'US'
),
focal AS (
    SELECT 
        "publication_number",
        "filing_date",
        FLOOR("filing_date"/10000) AS "file_year"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE "country_code" = 'US'
      AND "kind_code"   = 'B2'
      AND "grant_date" BETWEEN 20100101 AND 20141231
)
SELECT 
    focal."file_year",
    focal."publication_number",
    COUNT(*) AS "fwd_cites_30d"
FROM focal
JOIN citing_pairs
  ON citing_pairs."cited_pub" = focal."publication_number"
 WHERE ABS(citing_pairs."citing_file" - focal."filing_date") <= 30
GROUP BY focal."file_year", focal."publication_number"
QUALIFY ROW_NUMBER() OVER (PARTITION BY focal."file_year" 
                           ORDER BY COUNT(*) DESC) = 1
LIMIT 20;
```

```sql
-- 10. Description: FINAL‑style query – returns the single focal patent (2010‑2014) 
--     with the overall highest 30‑day forward cites and the most similar same‑year patent
WITH citing_pairs AS (
    SELECT 
        citing."publication_number"     AS "citing_pub",
        f.value::STRING                 AS "cited_pub",
        citing."filing_date"            AS "citing_file"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS citing,
         LATERAL FLATTEN(input => citing."citation") f
    WHERE citing."country_code" = 'US'
),
focal_rank AS (
    SELECT 
        p."publication_number",
        p."filing_date",
        FLOOR(p."filing_date"/10000) AS "file_year",
        COUNT(*) AS "fwd_cites_30d"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN citing_pairs
      ON citing_pairs."cited_pub" = p."publication_number"
     AND ABS(citing_pairs."citing_file" - p."filing_date") <= 30
    WHERE p."country_code" = 'US'
      AND p."kind_code"   = 'B2'
      AND p."grant_date" BETWEEN 20100101 AND 20141231
    GROUP BY p."publication_number", p."filing_date"
    ORDER BY "fwd_cites_30d" DESC
    LIMIT 1
),
same_year AS (
    SELECT 
        a."publication_number",
        DOT_PRODUCT(a."embedding_v1", b."embedding_v1") AS "dot_sim"
    FROM focal_rank fr
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p2
      ON FLOOR(p2."filing_date"/10000) = fr."file_year"
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
      ON a."publication_number" = p2."publication_number"
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB b
      ON b."publication_number" = fr."publication_number"
    WHERE p2."publication_number" <> fr."publication_number"
    ORDER BY "dot_sim" DESC
    LIMIT 1
)
SELECT 
    fr."publication_number"         AS "top_cited_B2_patent",
    fr."fwd_cites_30d",
    sy."publication_number"         AS "most_similar_same_year",
    sy."dot_sim"
FROM focal_rank fr
CROSS JOIN same_year sy
LIMIT 20;
```

