--Description:
-- Locate the U.S. B2 patent (grant‑year 2010‑2014) that receives the largest
-- number of forward citations made by other U.S. patents whose filing dates are
-- within ±30 days of the focal patent’s filing date, then find (via dot‑product
-- on embeddings) the most text‑similar U.S. patent filed in the same year.
--
-- Logical flow (mirrored by CTEs):
-- 1. citing_pairs   – Flatten every U.S. patent’s “citation” array, extract each
--    cited publication number (JSON key "publication_number") together with the
--    citing patent’s filing_date.
-- 2. focal_b2       – All U.S. B2 patents granted 2010‑2014 with valid filing_date.
-- 3. counts_30d     – Join citing_pairs to focal_b2 where ABS(citing_file ‑ filing_date)
--    ≤ 30; count citations for each focal patent.
-- 4. top_p          – Select the B2 patent with the highest 30‑day citation count.
-- 5. top_embed      – Fetch its embedding vector.
-- 6. same_year_vecs – All U.S. patents (any kind) filed in the same filing year
--    that have embeddings (excluding the focal patent).
-- 7. most_similar   – Compute DOT_PRODUCT similarity against the focal vector and
--    keep the highest‑scoring patent.
WITH citing_pairs AS (
    SELECT
        f.value:"publication_number"::STRING  AS cited_pub,
        p."filing_date"                       AS citing_file
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
    WHERE p."country_code" = 'US'
      AND p."filing_date" IS NOT NULL
      AND f.value:"publication_number" IS NOT NULL
      AND f.value:"publication_number"::STRING <> ''
),
focal_b2 AS (
    SELECT
        pub."publication_number",
        pub."filing_date",
        FLOOR(pub."filing_date" / 10000)      AS file_year
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS pub
    WHERE pub."country_code" = 'US'
      AND pub."kind_code"   = 'B2'
      AND pub."grant_date" BETWEEN 20100101 AND 20141231
      AND pub."filing_date" IS NOT NULL
),
counts_30d AS (
    SELECT
        f."publication_number",
        f."filing_date",
        f."file_year",
        COUNT(*)                              AS fwd_cites_30d
    FROM focal_b2 f
    JOIN citing_pairs cp
      ON cp.cited_pub = f."publication_number"
     AND ABS(cp.citing_file - f."filing_date") <= 30
    GROUP BY f."publication_number", f."filing_date", f."file_year"
),
top_p AS (
    SELECT *
    FROM counts_30d
    ORDER BY fwd_cites_30d DESC
    LIMIT 1
),
top_embed AS (
    SELECT
        tp."publication_number"              AS focal_pub,
        tp."fwd_cites_30d",
        tp."file_year",
        emb."embedding_v1"                   AS focal_vec
    FROM top_p tp
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB emb
      ON emb."publication_number" = tp."publication_number"
),
same_year_vecs AS (
    SELECT
        p2."publication_number",
        emb2."embedding_v1"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p2
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB emb2
      ON emb2."publication_number" = p2."publication_number"
    JOIN top_embed te
      ON FLOOR(p2."filing_date" / 10000) = te."file_year"
    WHERE p2."publication_number" <> te."focal_pub"
),
most_similar AS (
    SELECT
        te."focal_pub",
        te."fwd_cites_30d",
        sv."publication_number"                    AS similar_pub,
        DOT_PRODUCT(sv."embedding_v1", te.focal_vec) AS similarity
    FROM top_embed te
    JOIN same_year_vecs sv
      ON TRUE
    ORDER BY similarity DESC
    LIMIT 1
)
SELECT *
FROM most_similar;
