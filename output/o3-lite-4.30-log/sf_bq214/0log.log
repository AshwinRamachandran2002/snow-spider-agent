--Description: 8. Compute the dot‑product similarity between two specific patents.  
--             The FLATTEN output column is referenced as e.index (unquoted) to avoid
--             identifier errors.  Replace the two publication numbers with real ones
--             before running the query.
WITH emb1 AS (
    SELECT 
           e.index                 AS dim,    -- dimension
           e.value::FLOAT          AS v1
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
    CROSS  JOIN LATERAL FLATTEN(input => a."embedding_v1") e
    WHERE  a."publication_number" = 'US-REPLACE1-B2'   -- patent A
),
emb2 AS (
    SELECT 
           e.index                 AS dim,
           e.value::FLOAT          AS v2
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
    CROSS  JOIN LATERAL FLATTEN(input => a."embedding_v1") e
    WHERE  a."publication_number" = 'US-REPLACE2-A1'   -- patent B
)
SELECT SUM(e1.v1 * e2.v2) AS "dot_similarity"
FROM   emb1 e1
JOIN   emb2 e2
       ON e1.dim = e2.dim
