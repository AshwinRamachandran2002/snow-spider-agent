Query:
--Description: End‑to‑end workflow –
--   (i) Among 2010‑2014 U.S. utility‑grant patents (kind_code = 'B2'), locate the single patent
--       that receives the highest number of forward citations filed within 730 days of its own
--       filing date.  
--   (ii) Retrieve that leader’s text embedding and compute dot‑product similarity with every other
--        patent filed in the same calendar year that has an embedding, returning the single most
--        similar patent and the similarity score.  All FLATTEN index references are written as
--        e.index (unquoted) to avoid identifier‑name errors.

WITH patt AS (             -- eligible US‑B2 utility patents
    SELECT "publication_number",
           "filing_date",
           "title_localized"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE  "country_code"     = 'US'
      AND  "kind_code"        = 'B2'
      AND  "application_kind" = 'A'
      AND  "filing_date" BETWEEN 20100101 AND 20141231
),
fw AS (               -- every citation edge with citing filing dates
    SELECT
           f.value:"publication_number"::STRING AS cited_pub,
           t."filing_date"                      AS citing_filing_dt
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t
    CROSS  JOIN LATERAL FLATTEN(input => t."citation") f
    WHERE  t."citation" IS NOT NULL
      AND  t."filing_date" > 0
),
top_fw AS (           -- single patent with the most forward cites within 730 days
    SELECT
           p."publication_number",
           p."filing_date",
           p."title_localized",
           COUNT(*) AS fw_730d
    FROM   patt p
    JOIN   fw   ON fw.cited_pub = p."publication_number"
    WHERE  (fw.citing_filing_dt - p."filing_date") BETWEEN 1 AND 730
    GROUP BY 1,2,3
    ORDER BY fw_730d DESC
    LIMIT 1
),
emb_f AS (            -- explode embedding of the forward‑citation leader
    SELECT
           e.index        AS dim,
           e.value::FLOAT AS v_f,
           t."publication_number",
           t."filing_date"
    FROM   top_fw t
    JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
           ON a."publication_number" = t."publication_number"
    CROSS  JOIN LATERAL FLATTEN(input => a."embedding_v1") e
),
candidates AS (       -- all other patents from the same filing year with embeddings
    SELECT p."publication_number"
    FROM   top_fw t
    JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
           ON FLOOR(p."filing_date" / 10000) = FLOOR(t."filing_date" / 10000)
    WHERE  p."publication_number" <> t."publication_number"
      AND  p."publication_number" IN (
            SELECT "publication_number"
            FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB )
),
sim AS (              -- compute dot‑product similarity scores
    SELECT
           c."publication_number" AS cand_pub,
           SUM(ef.v_f * ec.value::FLOAT) AS dot_sim
    FROM   candidates c
    JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a2
           ON c."publication_number" = a2."publication_number"
    CROSS  JOIN LATERAL FLATTEN(input => a2."embedding_v1") ec
    JOIN   emb_f ef
           ON ef.dim = ec.index
    GROUP BY c."publication_number"
    ORDER BY dot_sim DESC
    LIMIT 1
)
SELECT
       t."publication_number"      AS fw_leader,
       t."title_localized"         AS fw_leader_title,
       t.fw_730d                   AS forward_cites_730d,
       s.cand_pub                  AS most_similar_pub,
       s.dot_sim                   AS similarity_score
FROM   top_fw t
CROSS JOIN sim s
LIMIT 20
