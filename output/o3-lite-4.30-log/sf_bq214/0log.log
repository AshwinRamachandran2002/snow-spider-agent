```sql
--Description: Check that forward‑citation links exist and measure how quickly they occur.  
--             For every US patent filed 2010‑2014 that cites someone else, compare its filing
--             date to the filing date of each cited US‑B2 utility patent from the same period.
--             Compute the time lag (in days) between the citing and the cited filing dates,
--             then list 20 examples with the smallest positive lags to confirm that citations
--             can indeed arrive very soon after a patent is filed.
WITH cited AS (   -- universe of potential US‑B2 utility patents that may be cited
    SELECT "publication_number","filing_date"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE  "country_code"     = 'US'
      AND  "kind_code"        = 'B2'
      AND  "application_kind" = 'A'
      AND  "filing_date"      BETWEEN 20100101 AND 20141231
),
edges AS (        -- citation edges originating from any US patent filed 2010‑2014
    SELECT  
           p."publication_number"                      AS "citing_pub",
           p."filing_date"                             AS "citing_filing_dt",
           f.value:"publication_number"::STRING        AS "cited_pub"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."citation") f
    WHERE  p."country_code" = 'US'
      AND  p."citation" IS NOT NULL
      AND  p."filing_date" BETWEEN 20100101 AND 20141231
),
matched AS (      -- keep only edges where the cited document is a US‑B2 utility patent
    SELECT  
           e."citing_pub",
           c."publication_number"                      AS "fw_target",
           e."citing_filing_dt",
           c."filing_date"                             AS "cited_filing_dt",
           e."citing_filing_dt" - c."filing_date"      AS "lag_days"
    FROM   edges e
    JOIN   cited c ON c."publication_number" = e."cited_pub"
    WHERE  e."citing_filing_dt" > c."filing_date"      -- ensure positive lag
)
SELECT 
       "citing_pub",
       "fw_target"        AS "cited_pub",
       "cited_filing_dt",
       "citing_filing_dt",
       "lag_days"
FROM   matched
ORDER BY "lag_days"       -- smallest lags first
LIMIT 20;
