```sql
--Description: 6. For each filing year 2010‑2014, identify the US‑B2 utility patent that attracts the
--             largest number of forward citations within 365 days (one‑year window) of its own filing
--             date.  A wider window replaces the 30‑day filter that produced no rows.  Filing year is
--             extracted with integer division to avoid DATE functions.
WITH patt AS (   -- candidate “cited” patents
    SELECT "publication_number","filing_date"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE  "country_code"='US' AND "kind_code"='B2' AND "application_kind"='A'
      AND  "filing_date" BETWEEN 20100101 AND 20141231
),
fw AS (           -- citation edges with valid filing dates
    SELECT 
           f.value:"publication_number"::STRING AS "cited_pub",
           t."filing_date"                      AS "citing_filing_dt"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."citation") f
    WHERE  t."citation" IS NOT NULL
      AND  t."filing_date" > 0
)
SELECT  
       FLOOR(p."filing_date"/10000)             AS "filing_year",
       p."publication_number",
       COUNT(*)                                 AS "fw_cites_365d"
FROM   patt p
JOIN   fw  ON fw."cited_pub" = p."publication_number"
WHERE  fw."citing_filing_dt" BETWEEN p."filing_date" AND p."filing_date" + 365
GROUP BY 1,2
QUALIFY ROW_NUMBER() OVER (PARTITION BY "filing_year" ORDER BY COUNT(*) DESC) = 1
ORDER BY "filing_year"
LIMIT 20;
```

