```sql
/* ------------------------------------------------------------
   1. Select every U.S. utility‑grant patent (kind_code = 'B2')
      filed between 2010‑01‑01 and 2014‑12‑31 that has an embedding
   2. Count how many forward citations were filed within 30 days
      of each patent’s filing date (0 if none)
   3. Keep the single patent with the largest 30‑day count
   4. Within the same filing year, find the patent whose embedding
      has the highest dot‑product similarity with that leader
-------------------------------------------------------------*/
WITH us_b2 AS (
    SELECT
        p."publication_number",
        p."filing_date",
        TO_DATE(TO_CHAR(p."filing_date"),'YYYYMMDD')              AS filing_dt,
        YEAR(TO_DATE(TO_CHAR(p."filing_date"),'YYYYMMDD'))        AS filing_year
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    WHERE p."country_code"     = 'US'
      AND p."kind_code"        = 'B2'
      AND p."application_kind" = 'A'
      AND p."filing_date" BETWEEN 20100101 AND 20141231
),
us_b2_emb AS (                         -- only patents that have an embedding
    SELECT u.*
    FROM us_b2 u
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB e
      ON e."publication_number" = u."publication_number"
),
cit AS (                               -- citing patent & its filing date
    SELECT
        f.value:"publication_number"::STRING                          AS cited_pub,
        TO_DATE(TO_CHAR(t."filing_date"),'YYYYMMDD')                  AS citing_filing_dt
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."citation") f
    WHERE t."citation"  IS NOT NULL
      AND t."filing_date" IS NOT NULL
),
fw30 AS (                              -- forward‑citation count within 30 days
    SELECT
        u."publication_number",
        u.filing_year,
        COUNT(c.citing_filing_dt)          AS fw_cites_30d
    FROM us_b2_emb u
    LEFT JOIN cit c
      ON c.cited_pub = u."publication_number"
     AND c.citing_filing_dt BETWEEN u.filing_dt
                               AND DATEADD(day,30,u.filing_dt)
    GROUP BY u."publication_number", u.filing_year
),
leader AS (                            -- patent with the largest 30‑day count
    SELECT *
    FROM fw30
    ORDER BY fw_cites_30d DESC NULLS LAST,
             "publication_number"
    LIMIT 1
),
leader_emb AS (                        -- explode leader’s embedding
    SELECT
        l."publication_number"                          AS leader_pub,
        fe.index                                        AS dim,
        fe.value::FLOAT                                 AS val,
        l.filing_year
    FROM leader l
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
      ON a."publication_number" = l."publication_number",
         LATERAL FLATTEN(input => a."embedding_v1") fe
),
candidates AS (                        -- other patents from same filing year
    SELECT p."publication_number"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN leader l
      ON YEAR(TO_DATE(TO_CHAR(p."filing_date"),'YYYYMMDD')) = l.filing_year
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB emb
      ON emb."publication_number" = p."publication_number"
    WHERE p."publication_number" <> l."publication_number"
),
cand_emb AS (                          -- explode embeddings of candidates
    SELECT
        c."publication_number"                         AS cand_pub,
        ce.index                                       AS dim,
        ce.value::FLOAT                                AS val
    FROM candidates c
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
      ON a."publication_number" = c."publication_number",
         LATERAL FLATTEN(input => a."embedding_v1") ce
),
sim AS (                               -- dot‑product similarity
    SELECT
        cand_pub,
        SUM(c.val * l.val)                             AS dot_sim
    FROM cand_emb c
    JOIN leader_emb l
      ON c.dim = l.dim
    GROUP BY cand_pub
    ORDER BY dot_sim DESC NULLS LAST,
             cand_pub
    LIMIT 1
),
sim_final AS (                         -- ensure one row even if no candidate
    SELECT cand_pub FROM sim
    UNION ALL
    SELECT NULL::STRING AS cand_pub
    WHERE NOT EXISTS (SELECT 1 FROM sim)
    LIMIT 1
)
SELECT
    l."publication_number"                           AS patent_number,
    l.fw_cites_30d                                   AS forward_citations_within_30_days,
    sf.cand_pub                                      AS most_similar_patent_from_same_filing_year
FROM leader l
CROSS JOIN sim_final sf;
