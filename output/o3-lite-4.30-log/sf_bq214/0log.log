```sql
--Description: 5. Forward citations received within 30 days of filing for US‑B2 utility patents (2010‑2014).
--             Both the set of potential “cited” patents (patt) and the citing pool (fw) require non‑null citations.
WITH patt AS (
    SELECT "publication_number","filing_date"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE  "country_code"     = 'US'
      AND  "kind_code"        = 'B2'
      AND  "application_kind" = 'A'
      AND  "filing_date"      BETWEEN 20100101 AND 20141231
),
fw AS (
    SELECT f.value:"publication_number"::STRING AS "cited_pub",
           t."publication_number"               AS "citing_pub",
           t."filing_date"                      AS "citing_filing_dt"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."citation") f
    WHERE  t."citation" IS NOT NULL
)
SELECT 
       p."publication_number",
       COUNT(*) AS "fw_cites_30d"
FROM   patt p
JOIN   fw   ON fw."cited_pub" = p."publication_number"
WHERE  fw."citing_filing_dt" BETWEEN p."filing_date" AND p."filing_date" + 30
GROUP BY p."publication_number"
ORDER BY "fw_cites_30d" DESC
LIMIT 20;
```

```sql
--Description: 6. For each filing year 2010‑2014, find the patent with the highest 30‑day forward‑citation count.
--             Use integer arithmetic (filing_date/10000) to derive the year because the field is numeric.
WITH patt AS (
    SELECT "publication_number","filing_date"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE  "country_code"='US' AND "kind_code"='B2' AND "application_kind"='A'
      AND  "filing_date" BETWEEN 20100101 AND 20141231
),
fw AS (
    SELECT f.value:"publication_number"::STRING AS "cited_pub",
           t."publication_number"               AS "citing_pub",
           t."filing_date"                      AS "citing_filing_dt"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."citation") f
    WHERE  t."citation" IS NOT NULL
)
SELECT  
       FLOOR(p."filing_date"/10000)             AS "filing_year",
       p."publication_number",
       COUNT(*)                                 AS "fw_cites_30d"
FROM   patt p
JOIN   fw  ON fw."cited_pub" = p."publication_number"
WHERE  fw."citing_filing_dt" BETWEEN p."filing_date" AND p."filing_date" + 30
GROUP BY 1,2
QUALIFY ROW_NUMBER() OVER (PARTITION BY "filing_year" ORDER BY COUNT(*) DESC) = 1
ORDER BY "filing_year"
LIMIT 20;
```

