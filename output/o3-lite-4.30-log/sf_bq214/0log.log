```sql
--Description: 8. Compute dot‑product similarity for two specific patents by intersecting their embedding indices.
WITH emb1 AS (
    SELECT e."index", e.value::FLOAT AS v1
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
           LATERAL FLATTEN(input => a."embedding_v1") e
    WHERE  a."publication_number" = 'US-8XXXXXX-B2'   -- patent A
),
emb2 AS (
    SELECT e."index", e.value::FLOAT AS v2
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
           LATERAL FLATTEN(input => a."embedding_v1") e
    WHERE  a."publication_number" = 'US-8YYYYYY-A1'   -- patent B
)
SELECT SUM(e1.v1 * e2.v2) AS "dot_similarity"
FROM   emb1 e1
JOIN   emb2 e2 USING ("index");
```

```sql
--Description: 9. For a focal patent, find the most similar patent filed in the same year (any kind_code);
--             year computed with division to avoid DATE functions.
WITH focal AS (
    SELECT 'US-8ZZZZZZ-B2' AS "focal_pub"
),
f_info AS (
    SELECT p."publication_number", p."filing_date"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN   focal f ON p."publication_number" = f."focal_pub"
),
emb_f AS (
    SELECT e."index", e.value::FLOAT AS v_f
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
           LATERAL FLATTEN(input => a."embedding_v1") e,
           focal f
    WHERE  a."publication_number" = f."focal_pub"
),
candidates AS (
    SELECT p."publication_number"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN   f_info fi 
           ON FLOOR(p."filing_date"/10000) = FLOOR(fi."filing_date"/10000)
    WHERE  p."publication_number" <> fi."publication_number"
      AND  p."publication_number" IN (
            SELECT "publication_number" FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB)
),
sim AS (
    SELECT c."publication_number" AS cand,
           SUM(ef.v_f * ec.value::FLOAT) AS dot_sim
    FROM   candidates c
    JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a2
           ON c."publication_number" = a2."publication_number",
         LATERAL FLATTEN(input => a2."embedding_v1") ec
    JOIN   emb_f ef USING ("index")
    GROUP BY c."publication_number"
)
SELECT *
FROM   sim
ORDER BY dot_sim DESC
LIMIT 20;
```

```sql
--Description: 10. Final end‑to‑end query.  (i) Identify the single US‑B2 utility patent (2010‑2014)
--             with the most forward citations within 30 days of filing, using numeric date arithmetic.
--             (ii) Find the most similar patent filed the same year (any kind_code) and report similarity.
WITH patt AS (   -- eligible patents
    SELECT "publication_number","filing_date","title_localized"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE  "country_code"='US' AND "kind_code"='B2' AND "application_kind"='A'
      AND  "filing_date" BETWEEN 20100101 AND 20141231
),
fw AS (           -- citing relationships; only rows with citations
    SELECT f.value:"publication_number"::STRING AS "cited_pub",
           t."publication_number"               AS "citing_pub",
           t."filing_date"                      AS "citing_filing_dt"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."citation") f
    WHERE  t."citation" IS NOT NULL
),
top_fw AS (       -- patent with global maximum within‑30‑day forward citations
    SELECT p."publication_number",
           p."filing_date",
           p."title_localized",
           COUNT(*) AS fw_30d
    FROM   patt p
    JOIN   fw   ON fw."cited_pub" = p."publication_number"
    WHERE  fw."citing_filing_dt" BETWEEN p."filing_date" AND p."filing_date" + 30
    GROUP BY 1,2,3
    ORDER BY fw_30d DESC
    LIMIT 1
),
emb_f AS (        -- embeddings of that forward‑citation leader
    SELECT e."index", e.value::FLOAT AS v_f,
           t."publication_number", t."filing_date"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
           LATERAL FLATTEN(input => a."embedding_v1") e
    JOIN   top_fw t ON a."publication_number" = t."publication_number"
),
candidates AS (   -- patents filed in the same calendar year with embeddings
    SELECT p."publication_number"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN   top_fw t 
           ON FLOOR(p."filing_date"/10000) = FLOOR(t."filing_date"/10000)
    WHERE  p."publication_number" <> t."publication_number"
      AND  p."publication_number" IN (
            SELECT "publication_number"
            FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB )
),
sim AS (          -- similarity scores
    SELECT c."publication_number" AS cand,
           SUM(ef.v_f * ec.value::FLOAT) AS dot_sim
    FROM   candidates c
    JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a2
           ON c."publication_number" = a2."publication_number",
         LATERAL FLATTEN(input => a2."embedding_v1") ec
    JOIN   emb_f ef USING ("index")
    GROUP BY c."publication_number"
    ORDER BY dot_sim DESC
    LIMIT 1
)
SELECT 
       t."publication_number"        AS fw_leader,
       t."title_localized"           AS fw_leader_title,
       t.fw_30d                      AS forward_cites_30d,
       s.cand                        AS most_similar_pub,
       s.dot_sim                     AS similarity_score
FROM   top_fw t
CROSS JOIN sim s
LIMIT 20;
