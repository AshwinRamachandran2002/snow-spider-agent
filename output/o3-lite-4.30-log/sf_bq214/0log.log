```sql
--Description: 3. Extract cited publication numbers & citation dates for a sample of US B2 utility patents
--             filed 2010‑2014, but only from documents whose "citation" field is non‑null to avoid empty output.
SELECT  
       t."publication_number"                       AS "citing_pub",
       f.value:"publication_number"::STRING         AS "cited_pub",
       f.value:"date"::NUMBER                       AS "citation_date"
FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."citation") f
WHERE  t."country_code"     = 'US'
  AND  t."kind_code"        = 'B2'
  AND  t."application_kind" = 'A'
  AND  t."citation"         IS NOT NULL
  AND  t."filing_date"      BETWEEN 20100101 AND 20141231
LIMIT 20;
```

```sql
--Description: 4. Count how often each patent is cited (forward citations) across the whole corpus,
--             restricting the scan to rows where "citation" is not null.
WITH cites AS (
    SELECT  
           f.value:"publication_number"::STRING  AS "cited_pub",
           COUNT(*)                              AS "fw_cites"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."citation") f
