--Description: 7. Retrieve and explode embedding vectors for patents filed in 2012 (numeric year via
--             integer division).  Require that the embedding array is present to avoid null rows.
SELECT  
       a."publication_number",
       e.value::FLOAT  AS "coord",
       e."index"       AS "dim"
FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
       LATERAL FLATTEN(input => a."embedding_v1") e
JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
       ON a."publication_number" = p."publication_number"
WHERE  FLOOR(p."filing_date"/10000) = 2012
  AND  a."embedding_v1" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 8. Compute the dot‑product similarity between two user‑specified patents by intersecting
--             their embedding dimensions.  Replace the placeholder publication numbers with real ones
--             before execution.
WITH emb1 AS (
    SELECT e."index", e.value::FLOAT AS v1
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
           LATERAL FLATTEN(input => a."embedding_v1") e
    WHERE  a."publication_number" = 'US-REPLACE1-B2'   -- patent A
),
emb2 AS (
    SELECT e."index", e.value::FLOAT AS v2
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
           LATERAL FLATTEN(input => a."embedding_v1") e
    WHERE  a."publication_number" = 'US-REPLACE2-A1'   -- patent B
)
SELECT SUM(e1.v1 * e2.v2) AS "dot_similarity"
FROM   emb1 e1
JOIN   emb2 e2 USING ("index");
```

```sql
--Description: 9. Given a focal patent, find the most similar other patent filed in the same calendar year
--             (any kind_code) by maximum dot‑product.  Substitute the focal publication number before use.
WITH focal AS (
    SELECT 'US-REPLACE-FOCAL' AS "focal_pub"
),
f_info AS (
    SELECT p."publication_number", p."filing_date"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN   focal f ON p."publication_number" = f."focal_pub"
),
emb_f AS (        -- embedding of the focal patent
    SELECT e."index", e.value::FLOAT AS v_f
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
           LATERAL FLATTEN(input => a."embedding_v1") e,
           focal f
    WHERE  a."publication_number" = f."focal_pub"
),
candidates AS (   -- all other patents from same year with embeddings
    SELECT p."publication_number"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN   f_info fi 
           ON FLOOR(p."filing_date"/10000) = FLOOR(fi."filing_date"/10000)
    WHERE  p."publication_number" <> fi."publication_number"
      AND  p."publication_number" IN (
            SELECT "publication_number"
            FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB )
),
sim AS (          -- similarity scores
    SELECT c."publication_number" AS cand,
           SUM(ef.v_f * ec.value::FLOAT) AS dot_sim
    FROM   candidates c
    JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a2
           ON c."publication_number" = a2."publication_number",
         LATERAL FLATTEN(input => a2."embedding_v1") ec
    JOIN   emb_f ef USING ("index")
    GROUP BY c."publication_number"
)
SELECT *
FROM   sim
ORDER BY dot_sim DESC
LIMIT 20;
```

```sql
--Description: 10. End‑to‑end: (i) locate the single US‑B2 utility patent (2010‑2014) with the most
--             forward citations within 365 days of filing; (ii) return that patent’s title, citation
--             count, and the publication number of the most text‑similar patent filed the same year,
--             along with their similarity score.
WITH patt AS (   -- eligible US‑B2 utility patents
    SELECT "publication_number","filing_date","title_localized"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE  "country_code"='US' AND "kind_code"='B2' AND "application_kind"='A'
      AND  "filing_date" BETWEEN 20100101 AND 20141231
),
fw AS (           -- all citation edges with valid filing dates
    SELECT 
           f.value:"publication_number"::STRING AS "cited_pub",
           t."filing_date"                      AS "citing_filing_dt"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."citation") f
    WHERE  t."citation" IS NOT NULL
      AND  t."filing_date" > 0
),
top_fw AS (       -- the single patent with the most forward citations in 365 days
    SELECT p."publication_number",
           p."filing_date",
           p."title_localized",
           COUNT(*) AS fw_365d
    FROM   patt p
    JOIN   fw   ON fw."cited_pub" = p."publication_number"
    WHERE  fw."citing_filing_dt" BETWEEN p."filing_date" AND p."filing_date" + 365
    GROUP BY 1,2,3
    ORDER BY fw_365d DESC
    LIMIT 1
),
emb_f AS (        -- embedding of that leader patent
    SELECT e."index", e.value::FLOAT AS v_f,
           t."publication_number", t."filing_date"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
           LATERAL FLATTEN(input => a."embedding_v1") e
    JOIN   top_fw t ON a."publication_number" = t."publication_number"
),
candidates AS (   -- same‑year patents with embeddings, excluding the leader
    SELECT p."publication_number"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN   top_fw t 
           ON FLOOR(p."filing_date"/10000) = FLOOR(t."filing_date"/10000)
    WHERE  p."publication_number" <> t."publication_number"
      AND  p."publication_number" IN (
            SELECT "publication_number"
            FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB )
),
sim AS (          -- compute similarity scores
    SELECT c."publication_number" AS cand,
           SUM(ef.v_f * ec.value::FLOAT) AS dot_sim
    FROM   candidates c
    JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a2
           ON c."publication_number" = a2."publication_number",
         LATERAL FLATTEN(input => a2."embedding_v1") ec
    JOIN   emb_f ef USING ("index")
    GROUP BY c."publication_number"
    ORDER BY dot_sim DESC
    LIMIT 1
)
SELECT 
       t."publication_number"        AS fw_leader,
       t."title_localized"           AS fw_leader_title,
       t.fw_365d                     AS forward_cites_365d,
       s.cand                        AS most_similar_pub,
       s.dot_sim                     AS similarity_score
FROM   top_fw t
CROSS JOIN sim s
LIMIT 20;
```
