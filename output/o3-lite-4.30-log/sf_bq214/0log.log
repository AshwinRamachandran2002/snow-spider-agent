Begin Exploring Related Columns
Relevant columns and their potential usage  
• "country_code": filter United‑States patents (value = 'US').  
• "kind_code": identify B‑series grants (value = 'B2').  
• "application_kind": keep utility patents (value = 'A').  
• "filing_date": restrict to 20100101‑20141231 and build the 30‑day window.  
• "grant_date": additional check that the patent is granted.  
• "publication_number": unique patent key, needed for every join.  
• "citation": VARIANT that stores individual citation objects; flattening it reveals which earlier patents this document cites.  
   – Inside the flattened object look at `"publication_number"` (the cited patent) and `"date"` (citation date).  
• "embedding_v1" (ABS_AND_EMB): numerical vector used to compute cosine / dot‑product similarity.  
• "title" / "abstract": human‑readable context.  

Typical conditions we will need  
country_code = 'US'  
kind_code   = 'B2'  
application_kind = 'A'  
filing_date BETWEEN 20100101 AND 20141231  

Below are ten Snowflake SQL snippets (each limited to 20 rows) that progress from basic exploration to a final query that simultaneously (i) finds the 2010‑2014 US‑B2 patent with the most forward citations within 30 days of its filing date, and (ii) retrieves the most similar patent (embedding similarity) filed in the same year, independent of kind_code.

```sql
-- 1. Description: List a few US utility‑grant patents (kind_code B2) filed in 2010‑2014
SELECT 
       "publication_number",
       "filing_date",
       "grant_date",
       "kind_code"
FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
WHERE  "country_code"      = 'US'
  AND  "kind_code"         = 'B2'
  AND  "application_kind"  = 'A'
  AND  "filing_date" BETWEEN 20100101 AND 20141231
LIMIT 20;
```

```sql
-- 2. Description: Inspect the structure of the "citation" array for one random patent
SELECT 
       "publication_number",
       f.value
FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."citation") f
WHERE  t."publication_number" = 'US-8000000-B2'   -- replace with a real pub number
LIMIT 20;
```

```sql
-- 3. Description: Extract cited publication numbers + citation date for sample patents
SELECT 
       t."publication_number"         AS "citing_pub",
       f.value:"publication_number"::STRING  AS "cited_pub",
       f.value:"date"::NUMBER         AS "citation_date"
FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."citation") f
WHERE  t."country_code" = 'US'
  AND  t."kind_code"    = 'B2'
  AND  t."filing_date" BETWEEN 20100101 AND 20141231
LIMIT 20;
```

```sql
-- 4. Description: Count how often each US‑B2 patent is cited by *any* other patent
--                 (this is a backward‑looking count for the citing patent, but forward for the cited one)
WITH cites AS (
    SELECT 
           f.value:"publication_number"::STRING  AS "cited_pub",
           COUNT(*)                              AS "fw_cites"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."citation") f
    GROUP BY 1
)
SELECT * FROM cites
LIMIT 20;
```

```sql
-- 5. Description: Forward citations that occurred within 30 days of the *cited* patent's filing date
WITH patt AS (
    SELECT "publication_number","filing_date"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE  "country_code"     = 'US'
      AND  "kind_code"        = 'B2'
      AND  "application_kind" = 'A'
      AND  "filing_date" BETWEEN 20100101 AND 20141231
),
fw AS (
    SELECT f.value:"publication_number"::STRING AS "cited_pub",
           t."publication_number"               AS "citing_pub",
           t."filing_date"                      AS "citing_filing_dt"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."citation") f
)
SELECT 
       p."publication_number",
       COUNT(*) AS "fw_cites_30d"
FROM   patt p
JOIN   fw   ON fw."cited_pub" = p."publication_number"
WHERE  fw."citing_filing_dt" BETWEEN p."filing_date" AND p."filing_date" + 30
GROUP BY p."publication_number"
ORDER BY "fw_cites_30d" DESC
LIMIT 20;
```

```sql
-- 6. Description: Identify, for each filing year (2010‑2014), the patent with max 30‑day forward cites
WITH patt AS (
    SELECT "publication_number","filing_date"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE  "country_code"='US' AND "kind_code"='B2' AND "application_kind"='A'
          AND "filing_date" BETWEEN 20100101 AND 20141231
),
fw AS (
    SELECT f.value:"publication_number"::STRING AS "cited_pub",
           t."publication_number"               AS "citing_pub",
           t."filing_date"                      AS "citing_filing_dt"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."citation") f
)
SELECT 
       YEAR(p."filing_date")                    AS "filing_year",
       p."publication_number",
       COUNT(*) AS "fw_cites_30d"
FROM   patt p
JOIN   fw  ON fw."cited_pub" = p."publication_number"
WHERE  fw."citing_filing_dt" BETWEEN p."filing_date" AND p."filing_date" + 30
GROUP BY 1,2
QUALIFY ROW_NUMBER() OVER (PARTITION BY "filing_year" ORDER BY COUNT(*) DESC) = 1
ORDER BY "filing_year"
LIMIT 20;
```

```sql
-- 7. Description: Fetch embeddings for patents filed in 2012 (sample) and explode them
SELECT 
       a."publication_number",
       e.value::FLOAT AS "coord",
       e."index"      AS "dim"
FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
       LATERAL FLATTEN(input => a."embedding_v1") e
JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
       ON a."publication_number" = p."publication_number"
WHERE  YEAR(p."filing_date") = 2012
LIMIT 20;
```

```sql
-- 8. Description: Compute pair‑wise similarity (dot product) for two specific patents of the same year
WITH emb1 AS (
    SELECT e."index", e.value::FLOAT AS v1
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
           LATERAL FLATTEN(input => a."embedding_v1") e
    WHERE  a."publication_number" = 'US-8XXXXXX-B2'          -- patent A
),
emb2 AS (
    SELECT e."index", e.value::FLOAT AS v2
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
           LATERAL FLATTEN(input => a."embedding_v1") e
    WHERE  a."publication_number" = 'US-8YYYYYY-A1'          -- patent B
)
SELECT SUM(e1.v1 * e2.v2) AS "dot_similarity"
FROM   emb1 e1
JOIN   emb2 e2 USING ("index");
```

```sql
-- 9. Description: For one focal patent get the *most* similar patent filed in the same year (any type)
WITH focal AS (
    SELECT 'US-8ZZZZZZ-B2' AS "focal_pub", YEAR(2012) AS "yr"        -- replace with real
), emb_f AS (
    SELECT e."index", e.value::FLOAT AS v_f
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
           LATERAL FLATTEN(input => a."embedding_v1") e, focal f
    WHERE  a."publication_number" = f."focal_pub"
), candidates AS (
    SELECT p."publication_number"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p, focal f
    WHERE  YEAR(p."filing_date") = f."yr"
      AND  p."publication_number" <> f."focal_pub"
      AND  p."publication_number" IN (
                SELECT "publication_number" 
                FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB)
), sim AS (
    SELECT c."publication_number" AS cand,
           SUM(ef.v_f * ec.value::FLOAT) AS dot_sim
    FROM   candidates c
    JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a2
           ON c."publication_number" = a2."publication_number"
    ,      LATERAL FLATTEN(input => a2."embedding_v1") ec
    JOIN   emb_f ef USING ("index")
    GROUP BY c."publication_number"
)
SELECT *
FROM   sim
ORDER BY dot_sim DESC
LIMIT 20;
```

```sql
--10. Description: Final query –
--     (i) pick the single US‑B2 utility patent (2010‑2014) with the highest number of 30‑day forward citations,
--    (ii) return its title, forward‑citation count, and the publication_number of the single most‑similar
--         patent filed in the same year (any kind_code), together with their similarity score.
WITH patt AS (
    SELECT "publication_number","filing_date","title_localized"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS
    WHERE  "country_code"='US' AND "kind_code"='B2' AND "application_kind"='A'
          AND "filing_date" BETWEEN 20100101 AND 20141231
),
fw AS (
    SELECT f.value:"publication_number"::STRING AS "cited_pub",
           t."publication_number"               AS "citing_pub",
           t."filing_date"                      AS "citing_filing_dt"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."citation") f
),
top_fw AS (   -- patent with the most forward cites in 30 days over the whole 2010‑2014 window
    SELECT p."publication_number",
           p."filing_date",
           p."title_localized",
           COUNT(*) AS fw_30d
    FROM   patt p
    JOIN   fw   ON fw."cited_pub" = p."publication_number"
    WHERE  fw."citing_filing_dt" BETWEEN p."filing_date" AND p."filing_date" + 30
    GROUP BY 1,2,3
    ORDER BY fw_30d DESC
    LIMIT 1
),
emb_f AS (
    SELECT e."index", e.value::FLOAT AS v_f, t."publication_number", t."filing_date"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a,
           LATERAL FLATTEN(input => a."embedding_v1") e
    JOIN   top_fw t ON a."publication_number" = t."publication_number"
),
candidates AS (
    SELECT p."publication_number"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    JOIN   top_fw t ON YEAR(p."filing_date") = YEAR(t."filing_date")
    WHERE  p."publication_number" <> t."publication_number"
      AND  p."publication_number" IN (
            SELECT "publication_number" FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB)
),
sim AS (
    SELECT c."publication_number" AS cand,
           SUM(ef.v_f * ec.value::FLOAT) AS dot_sim
    FROM   candidates c
    JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a2
           ON c."publication_number" = a2."publication_number"
    ,      LATERAL FLATTEN(input => a2."embedding_v1") ec
    JOIN   emb_f ef USING ("index")
    GROUP BY c."publication_number"
    ORDER BY dot_sim DESC
    LIMIT 1
)
SELECT 
       t."publication_number"        AS fw_leader,
       t."title_localized"           AS fw_leader_title,
       t.fw_30d                      AS forward_cites_30d,
       s.cand                        AS most_similar_pub,
       s.dot_sim                     AS similarity_score
FROM   top_fw t
CROSS JOIN sim s
LIMIT 20;
```

