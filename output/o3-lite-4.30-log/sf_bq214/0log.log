```sql
/*  -----------------------------------------------------------
    1) pick every U.S. utility‑grant patent (kind_code = 'B2')
       filed between 2010‑01‑01 and 2014‑12‑31
    2) count how many forward‑citation *filings* occur within
       30 calendar days of its own filing date
    3) keep only patents that possess a text‑embedding
    4) choose the single patent with the largest 30‑day count
    5) inside the same filing year, locate the patent whose
       embedding has the highest dot‑product similarity with
       the leader’s embedding
    ----------------------------------------------------------- */
WITH us_b2 AS (   -- candidate patents
    SELECT
        p."publication_number",
        p."filing_date",
        TO_DATE(TO_CHAR(p."filing_date"),'YYYYMMDD')          AS filing_dt,
        YEAR(TO_DATE(TO_CHAR(p."filing_date"),'YYYYMMDD'))    AS filing_year
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
    WHERE p."country_code"     = 'US'
      AND p."kind_code"        = 'B2'
      AND p."application_kind" = 'A'
      AND p."filing_date" BETWEEN 20100101 AND 20141231
),
cit AS (          -- each citation edge with citing patent’s filing date
    SELECT
        f.value:"publication_number"::STRING                                AS cited_pub,
        TO_DATE(TO_CHAR(t."filing_date"),'YYYYMMDD')                        AS citing_filing_dt
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."citation") f
    WHERE t."citation" IS NOT NULL
      AND t."filing_date"  IS NOT NULL
),
fw30 AS (         -- forward‑citation counts within 30 days, only for patents with embeddings
    SELECT
        u."publication_number",
        u.filing_year,
        COUNT(*) AS fw_cites_30d
    FROM us_b2 u
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB emb
          ON emb."publication_number" = u."publication_number"
    JOIN cit
          ON cit.cited_pub = u."publication_number"
         AND cit.citing_filing_dt BETWEEN u.filing_dt
                                       AND DATEADD(day,30,u.filing_dt)
    GROUP BY u."publication_number", u.filing_year
),
leader AS (       -- patent with the maximum 30‑day forward citations
    SELECT *
    FROM fw30
    ORDER BY fw_cites_30d DESC NULLS LAST,
             "publication_number"
    LIMIT 1
),
leader_emb AS (   -- explode leader’s embedding
    SELECT
        l."publication_number"                         AS leader_pub,
        e.index                                        AS dim,
        e.value::FLOAT                                 AS val
    FROM leader l
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
          ON a."publication_number" = l."publication_number",
         LATERAL FLATTEN(input => a."embedding_v1") e
),
candidates AS (   -- every other patent filed in the same year with an embedding
    SELECT p."publication_number"
    FROM leader l
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
          ON YEAR(TO_DATE(TO_CHAR(p."filing_date"),'YYYYMMDD')) = l.filing_year
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB emb
          ON emb."publication_number" = p."publication_number"
    WHERE p."publication_number" <> l."publication_number"
),
cand_emb AS (     -- explode embeddings of all same‑year candidates
    SELECT
        c."publication_number"                        AS cand_pub,
        e.index                                       AS dim,
        e.value::FLOAT                                AS val
    FROM candidates c
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB a
          ON a."publication_number" = c."publication_number",
         LATERAL FLATTEN(input => a."embedding_v1") e
),
similarity AS (   -- dot‑product similarity between leader and each candidate
    SELECT
        c.cand_pub,
        SUM(c.val * l.val)                            AS dot_sim
    FROM cand_emb c
    JOIN leader_emb l
          ON c.dim = l.dim
    GROUP BY c.cand_pub
    ORDER BY dot_sim DESC NULLS LAST,
             c.cand_pub
    LIMIT 1
)
SELECT
    l."publication_number"   AS patent_number,
    l.fw_cites_30d           AS forward_citations_within_30_days,
    s.cand_pub               AS most_similar_patent_from_same_filing_year
FROM leader     l
JOIN similarity s ON 1=1
LIMIT 1;
```

