```sql
--Description: 7) For each filing year (2010‑2014), find the US‑granted B2 patent
--with the largest total number of cited references (backward citations).  
--We avoid the non‑existent “cited_by / date” path and instead simply count how
--many patent‑type citation objects appear.  The filing year is extracted from
--the numeric YYYYMMDD “filing_date”.

WITH yr_counts AS (
  SELECT
      CAST(FLOOR(t."filing_date" / 10000) AS INT) AS "filing_year",
      t."publication_number",
      COUNT(*)                                 AS "num_citations"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."citation") c
  WHERE t."country_code"    = 'US'
    AND t."kind_code"       = 'B2'
    AND t."publication_date" BETWEEN 20100101 AND 20141231
    AND c.value:"publication_number" IS NOT NULL          -- keep patent refs
  GROUP BY 1,2
)
SELECT *
FROM (
  SELECT
      "filing_year",
      "publication_number",
      "num_citations",
      ROW_NUMBER() OVER (PARTITION BY "filing_year" ORDER BY "num_citations" DESC) AS rn
  FROM yr_counts
) q
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: 8) Retrieve embeddings for US patents whose filing year is 2012.  
--Year is derived from numeric “filing_date”; embeddings will later be used for
--similarity calculations.

SELECT
    e."publication_number",
    e."embedding_v1"
FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB       e
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS      p
      ON e."publication_number" = p."publication_number"
WHERE p."country_code" = 'US'
  AND CAST(FLOOR(p."filing_date" / 10000) AS INT) = 2012
LIMIT 20;
```

```sql
--Description: 9) Compute a simple dot‑product similarity between a focal patent
--and other patents filed in the same year (2012).  Replace
--'US‑XXXXXXXX‑B2' with an actual publication number.  We drop the sub‑select
--that relied on YEAR() and instead use the pre‑joined filing year.

WITH focal AS (
  SELECT *
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB
  WHERE "publication_number" = 'US-XXXXXXXX-B2'          -- <‑‑ supply real pub #
)
SELECT
    focal."publication_number"                    AS "focal_pub",
    other."publication_number"                    AS "other_pub",
    DOT_PRODUCT(focal."embedding_v1", other."embedding_v1") AS "sim_score"
FROM focal
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB other
     ON TRUE
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p_other
     ON other."publication_number" = p_other."publication_number"
WHERE other."publication_number" <> focal."publication_number"
  AND CAST(FLOOR(p_other."filing_date" / 10000) AS INT) = 2012
ORDER BY "sim_score" DESC
LIMIT 20;
```

```sql
--Description: 10) End‑to‑end demo: pick, among 2010‑2014 US‑granted B2 patents,
--the one with the most cited references (backward) in its filing year, then return
--the single most text‑similar patent (any kind) from the same filing year using
--embedding dot product.  Forward‑citation filters are removed because the data
--lack those fields.

WITH cite_counts AS (
  SELECT
      t."publication_number",
      t."filing_date",
      CAST(FLOOR(t."filing_date" / 10000) AS INT)  AS "filing_year",
      COUNT(*)                                    AS "num_citations"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."citation") c
  WHERE t."country_code" = 'US'
    AND t."kind_code"    = 'B2'
    AND t."publication_date" BETWEEN 20100101 AND 20141231
    AND c.value:"publication_number" IS NOT NULL
  GROUP BY 1,2,3
),
max_per_year AS (
  SELECT *
  FROM (
    SELECT
        "publication_number",
        "filing_date",
        "filing_year",
        "num_citations",
        ROW_NUMBER() OVER (PARTITION BY "filing_year" ORDER BY "num_citations" DESC) AS rn
    FROM cite_counts
  ) q
  WHERE rn = 1
  LIMIT 1                                        -- pick just one of the five years
),
same_year_emb AS (
  SELECT
      e."publication_number",
      e."embedding_v1"
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB e
  JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
        ON e."publication_number" = p."publication_number"
  JOIN max_per_year m
        ON CAST(FLOOR(p."filing_date" / 10000) AS INT) = m."filing_year"
)
SELECT
    m."publication_number"                                           AS "max_cited_patent",
    s."publication_number"                                           AS "most_similar_patent",
    DOT_PRODUCT(m_emb."embedding_v1", s."embedding_v1")              AS "similarity_score"
FROM max_per_year m
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB m_emb
     ON m."publication_number" = m_emb."publication_number"
JOIN same_year_emb s
     ON s."publication_number" <> m."publication_number"
ORDER BY "similarity_score" DESC
LIMIT 20;
```
