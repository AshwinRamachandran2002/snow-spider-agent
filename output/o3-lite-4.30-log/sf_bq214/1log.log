```sql
--Description:  Find, by manual dot‑product, the 20 U.S. patents filed in 2012 that are
--most text‑similar to the focal patent US‑8928276‑B2.
--Thinking process:
-- • The embeddings live in ABS_AND_EMB; filings years are taken from PUBLICATIONS.
-- • Because Snowflake lacks a DOT_PRODUCT function, flatten both vectors to (index,value),
--   join on the index, multiply, and sum → similarity score.
-- • Steps:
--     1) focal     – retrieve the focal vector.
--     2) others    – retrieve vectors for every other 2012‑filed patent.
--     3) focal_vec – flatten focal embedding.
--     4) other_vec – flatten each other embedding.
--     5) aggregate dot product, rank, return top 20.

WITH focal AS (       -- 1. focal patent embedding
    SELECT "embedding_v1"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB
    WHERE "publication_number" = 'US-8928276-B2'
),
others AS (           -- 2. embeddings for all other 2012‑filed U.S. patents
    SELECT e."publication_number",
           e."embedding_v1"
    FROM   PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB e
    JOIN   PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
           ON e."publication_number" = p."publication_number"
    WHERE  CAST(FLOOR(p."filing_date" / 10000) AS INT) = 2012
      AND  e."publication_number" <> 'US-8928276-B2'
),
focal_vec AS (        -- 3. flatten focal vector to (idx, val)
    SELECT fv.seq::INT   AS idx,
           fv.value::FLOAT AS val_focal
    FROM   focal f,
           LATERAL FLATTEN(input => f."embedding_v1") fv
),
other_vec AS (        -- 4. flatten each other vector to (pub, idx, val)
    SELECT o."publication_number",
           ov.seq::INT    AS idx,
           ov.value::FLOAT AS val_other
    FROM   others o,
           LATERAL FLATTEN(input => o."embedding_v1") ov
)
-- 5. join on idx, multiply values, sum to get dot product, rank
SELECT
    ov."publication_number"                  AS "other_pub",
    SUM(fv.val_focal * ov.val_other)         AS "similarity_score"
FROM focal_vec fv
JOIN other_vec ov
  ON fv.idx = ov.idx
GROUP BY ov."publication_number"
ORDER BY "similarity_score" DESC
LIMIT 20;
```
