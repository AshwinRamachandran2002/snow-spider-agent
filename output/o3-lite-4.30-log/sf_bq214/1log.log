```sql
--Description:
--End‑to‑end workflow in a single query.
--1. From US‑granted B2 patents issued 2010‑2014, pick the single patent that contains
--   the largest number of backward patent citations (most “publication_number” items
--   in its citation array).  Call this the *focal patent*.
--2. Determine the focal patent’s filing year (YYYY derived from its numeric filing_date).
--3. Collect embeddings for every other patent (any kind / kind_code) that shares that
--   same filing year.
--4. Compute the dot‑product similarity between the focal patent’s embedding and each
--   cohort patent’s embedding by flattening both vectors, aligning on the element
--   index (“seq”), multiplying, and summing products.
--5. Return the 20 most similar cohort patents together with their similarity scores.

WITH cite_counts AS (               -- count backward citations for candidate patents
    SELECT
        t."publication_number",
        t."filing_date",
        CAST(FLOOR(t."filing_date" / 10000) AS INT) AS "filing_year",
        COUNT(*)                                   AS "num_citations"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."citation") c
    WHERE t."country_code" = 'US'
      AND t."kind_code"    = 'B2'
      AND t."publication_date" BETWEEN 20100101 AND 20141231
      AND c.value:"publication_number" IS NOT NULL          -- keep patent refs
    GROUP BY 1,2,3
), focal AS (                       -- select the single most‑cited patent overall
    SELECT
        cc."publication_number",
        cc."filing_year",
        e."embedding_v1"
    FROM cite_counts cc
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB e
         ON cc."publication_number" = e."publication_number"
    ORDER BY cc."num_citations" DESC
    LIMIT 1
), cohort AS (                      -- embeddings of all other patents from same filing year
    SELECT
        e."publication_number",
        e."embedding_v1"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB e
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
         ON e."publication_number" = p."publication_number"
    JOIN focal f
         ON CAST(FLOOR(p."filing_date" / 10000) AS INT) = f."filing_year"
    WHERE e."publication_number" <> (SELECT "publication_number" FROM focal)
)
SELECT
    c."publication_number"                                AS "similar_patent",
    SUM(f_elem.value::FLOAT * c_elem.value::FLOAT)        AS "similarity_score"
FROM focal f,
     LATERAL FLATTEN(input => f."embedding_v1")    f_elem
JOIN cohort c,
     LATERAL FLATTEN(input => c."embedding_v1")    c_elem
       ON f_elem.seq = c_elem.seq                 -- align vector indices
GROUP BY c."publication_number"
ORDER BY "similarity_score" DESC
LIMIT 20;
```
