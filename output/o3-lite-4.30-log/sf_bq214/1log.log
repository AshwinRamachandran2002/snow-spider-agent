--Description: 9) Compute a simple dot‑product similarity between a focal patent
--and other patents filed in the same year (2012).  Replace
--'US‑XXXXXXXX‑B2' with an actual publication number.  We drop the sub‑select
--that relied on YEAR() and instead use the pre‑joined filing year.

WITH focal AS (
  SELECT *
  FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB
  WHERE "publication_number" = 'US-XXXXXXXX-B2'          -- <‑‑ supply real pub #
)
SELECT
    focal."publication_number"                    AS "focal_pub",
    other."publication_number"                    AS "other_pub",
    DOT_PRODUCT(focal."embedding_v1", other."embedding_v1") AS "sim_score"
FROM focal
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB other
     ON TRUE
JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p_other
     ON other."publication_number" = p_other."publication_number"
WHERE other."publication_number" <> focal."publication_number"
  AND CAST(FLOOR(p_other."filing_date" / 10000) AS INT) = 2012
ORDER BY "sim_score" DESC
LIMIT 20
