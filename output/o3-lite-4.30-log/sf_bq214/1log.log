```sql
--Description:
--We want to discover, among all U.S. patents filed in 2012, which ones are most
--text‑similar to the focal patent US‑8928276‑B2.  Because Snowflake has no built‑in
--DOT_PRODUCT function, we compute the dot product manually:
--  • Flatten the focal embedding → (idx , val)
--  • Flatten each candidate’s embedding → (publication_number , idx , val)
--  • Join on idx, multiply the two scalars, sum across dimensions.
--The query proceeds in four CTEs:
--  1) focal … fetch the single focal embedding.
--  2) others … fetch embeddings of every other 2012‑filed patent.
--  3) focal_flat … flatten the focal vector.
--  4) others_flat … flatten each “other” vector.
--Finally, we aggregate to obtain similarity scores and list the 20 closest patents.

WITH focal AS (                       -- 1. focal patent embedding
    SELECT 
        "embedding_v1"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB
    WHERE "publication_number" = 'US-8928276-B2'
),
others AS (                           -- 2. embeddings of all other 2012‑filed patents
    SELECT 
        e."publication_number",
        e."embedding_v1"
    FROM PATENTS_GOOGLE.PATENTS_GOOGLE.ABS_AND_EMB e
    JOIN PATENTS_GOOGLE.PATENTS_GOOGLE.PUBLICATIONS p
          ON e."publication_number" = p."publication_number"
    WHERE CAST(FLOOR(p."filing_date" / 10000) AS INT) = 2012
      AND e."publication_number" <> 'US-8928276-B2'
),
focal_flat AS (                       -- 3. flatten focal vector
    SELECT 
        f_elem.seq        AS idx,
        f_elem.value::FLOAT  AS val
    FROM focal f
    ,    LATERAL FLATTEN( input => f."embedding_v1") f_elem
),
others_flat AS (                      -- 4. flatten others
    SELECT
        o."publication_number",
        o_elem.seq        AS idx,
        o_elem.value::FLOAT  AS val
    FROM others o
    ,    LATERAL FLATTEN( input => o."embedding_v1") o_elem
)
SELECT
    of."publication_number"                 AS "other_pub",
    SUM(ff.val * of.val)                    AS "similarity_score"
FROM focal_flat ff
JOIN others_flat of
  ON ff.idx = of.idx                        -- align vector element index
GROUP BY of."publication_number"
ORDER BY "similarity_score" DESC
LIMIT 20;
```
