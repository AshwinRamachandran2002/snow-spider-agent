          ON s."MetricID"      = z."MetricID"
         AND s."StateAbbrev"   = 'NY'
WHERE g."PreferredStateAbbrev" = 'NY'
  AND z."MetricID"             = 'B08303_013E'   -- 60 minutes or more commuters
ORDER BY z."CensusValueByZip" DESC
LIMIT 20;
