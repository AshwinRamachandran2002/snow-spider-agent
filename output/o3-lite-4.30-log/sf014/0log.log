```sql
--Description: 10) FINAL — combine everything: highest‑value NY Zip, its commuter count (> 1 hour), plus the New York benchmark & total population.
SELECT TOP 1
       z."ZipCode",
       z."CensusValueByZip"             AS "Total_Commuters_Over_1_Hour",
