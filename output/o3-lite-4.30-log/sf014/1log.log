           ON f."ZipCode" = g."ZipCode"
    WHERE  f."MetricID" = 'XXX'
      AND  g."PreferredStateAbbrev" = 'NY'
    ORDER  BY f."CensusValueByZip" DESC
    LIMIT 1
)
SELECT 
       z."ZipCode",
       z."Commuters_>1Hr",
       sb."StateBenchmarkValue"    AS "NY_State_Commuters_>1Hr",
