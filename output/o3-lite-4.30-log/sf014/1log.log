Below are the columns that will most likely be needed and WHY they matter  

• Dim_CensusMetrics."MetricID": locate the metric(s) that represent “commuters travelling > 1 hour”  
• Dim_CensusMetrics."MetricTableDesc", "Descriptor1‑3": text fields to search for “travel time to work”, “60 minutes”, “90 minutes”, etc.  
• Fact_CensusValues_ACS2021_ByZip."MetricID": connects ZIP–level values to the commuting metric(s) we identify  
• Fact_CensusValues_ACS2021_ByZip."ZipCode": ZIP‑Code for each record  
• Fact_CensusValues_ACS2021_ByZip."CensusValueByZip": the commuter counts we want to compare  
• LU_GeographyExpanded."ZipCode": join handle so we can filter to ZIP codes that belong to New York  
• LU_GeographyExpanded."PreferredStateAbbrev": ‘NY’ filter for New York only  
• Fact_StateBenchmark_ACS2021."MetricID": same commuting metric(s) so we can pull state benchmark numbers  
• Fact_StateBenchmark_ACS2021."StateAbbrev", "StateBenchmarkValue", "TotalStatePopulation": state‑level reference values  

Typical conditions you will see below  

• WHERE "MetricTableDesc" ILIKE '%travel%time%work%'  
• WHERE "Descriptor1" ILIKE '%60%' OR "Descriptor1" ILIKE '%90%'  
• WHERE g."PreferredStateAbbrev" = 'NY'  
• WHERE sb."StateAbbrev" = 'NY'  

Ten exploratory‑to‑solution SQL snippets (every query limited to 20 rows for safety)  
```sql
-- 1. Description: Find any metric tables that talk about travel time to work
SELECT DISTINCT 
       m."MetricTableID",
       m."MetricTableDesc"
FROM   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."Dim_CensusMetrics" m
WHERE  m."MetricTableDesc" ILIKE '%travel%time%work%'
LIMIT 20;

-- 2. Description: List all metric rows whose descriptor mentions 60, 90, or 'minutes'
SELECT 
       m."MetricID",
       m."Descriptor1",
       m."Descriptor2",
       m."Descriptor3",
       m."MetricTableDesc"
FROM   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."Dim_CensusMetrics" m
WHERE  (m."Descriptor1" ILIKE '%60%' 
        OR m."Descriptor2" ILIKE '%60%' 
        OR m."Descriptor3" ILIKE '%60%' 
        OR m."Descriptor1" ILIKE '%90%' 
        OR m."Descriptor2" ILIKE '%90%' 
        OR m."Descriptor3" ILIKE '%90%')
  AND  m."MetricTableDesc" ILIKE '%travel%time%work%'
LIMIT 20;

-- 3. Description: Distinct metric IDs for commuters with travel time ≥60 minutes
SELECT DISTINCT 
       m."MetricID"
FROM   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."Dim_CensusMetrics" m
WHERE  (m."Descriptor1" ILIKE '%60%' OR m."Descriptor1" ILIKE '%90%')
   OR  (m."Descriptor2" ILIKE '%60%' OR m."Descriptor2" ILIKE '%90%')
   OR  (m."Descriptor3" ILIKE '%60%' OR m."Descriptor3" ILIKE '%90%')
  AND  m."MetricTableDesc" ILIKE '%travel%time%work%'
LIMIT 20;

-- 4. Description: Example ZIP‑level commuter counts for one candidate metric (replace XXX with a real MetricID from query 3)
SELECT 
       f."ZipCode",
       f."MetricID",
       f."CensusValueByZip"
FROM   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021_ByZip" f
WHERE  f."MetricID" = 'XXX'          -- put concrete MetricID
LIMIT 20;

-- 5. Description: Top 20 ZIP codes nationwide for that metric
SELECT 
       f."ZipCode",
       f."CensusValueByZip"          AS "Commuters_>1Hr"
FROM   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021_ByZip" f
WHERE  f."MetricID" = 'XXX'
ORDER  BY "Commuters_>1Hr" DESC
LIMIT 20;

-- 6. Description: Join ZIP geography to filter only New York ZIP codes
SELECT 
       f."ZipCode",
       g."PreferredStateAbbrev",
       f."CensusValueByZip" AS "Commuters_>1Hr"
FROM   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021_ByZip"  f
JOIN   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."LU_GeographyExpanded"            g
       ON f."ZipCode" = g."ZipCode"
WHERE  f."MetricID" = 'XXX'
  AND  g."PreferredStateAbbrev" = 'NY'
LIMIT 20;

-- 7. Description: For NY only, rank ZIPs by number of commuters travelling ≥60 min
SELECT 
       f."ZipCode",
       f."CensusValueByZip" AS "Commuters_>1Hr",
       ROW_NUMBER() OVER (ORDER BY f."CensusValueByZip" DESC) AS "Rank_in_NY"
FROM   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021_ByZip" f
JOIN   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."LU_GeographyExpanded"           g
       ON f."ZipCode" = g."ZipCode"
WHERE  f."MetricID" = 'XXX'
  AND  g."PreferredStateAbbrev" = 'NY'
ORDER BY "Commuters_>1Hr" DESC
LIMIT 20;

-- 8. Description: If there are two metrics (e.g., 60‑89 min and 90+ min), sum them
WITH ny_commuters AS (
  SELECT 
         f."ZipCode",
         SUM(f."CensusValueByZip") AS "Total_Commuters_>1Hr"
  FROM   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021_ByZip" f
  JOIN   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."LU_GeographyExpanded"           g
         ON f."ZipCode" = g."ZipCode"
  WHERE  f."MetricID" IN ('XXX','YYY')          -- e.g., 60‑89 min AND 90+ min
    AND  g."PreferredStateAbbrev" = 'NY'
  GROUP BY f."ZipCode"
)
SELECT *
FROM   ny_commuters
ORDER  BY "Total_Commuters_>1Hr" DESC
LIMIT 20;

-- 9. Description: Pull New York state benchmark figure for the same commuting metric
SELECT 
       sb."MetricID",
       sb."StateBenchmarkValue"    AS "NY_State_Commuters_>1Hr",
       sb."TotalStatePopulation"
FROM   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."Fact_StateBenchmark_ACS2021" sb
WHERE  sb."StateAbbrev" = 'NY'
  AND  sb."MetricID"   = 'XXX'
LIMIT 20;

--10. Description: Combine ZIP result with state benchmark to surface final answer candidate
WITH ny_zip_max AS (
    SELECT 
           f."ZipCode",
           f."CensusValueByZip" AS "Commuters_>1Hr"
    FROM   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."Fact_CensusValues_ACS2021_ByZip" f
    JOIN   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."LU_GeographyExpanded"           g
           ON f."ZipCode" = g."ZipCode"
    WHERE  f."MetricID" = 'XXX'
      AND  g."PreferredStateAbbrev" = 'NY'
    ORDER  BY f."CensusValueByZip" DESC
    LIMIT 1
)
SELECT 
       z."ZipCode",
       z."Commuters_>1Hr",
       sb."StateBenchmarkValue"    AS "NY_State_Commuters_>1Hr",
       sb."TotalStatePopulation"
FROM   ny_zip_max                                   z
JOIN   "CENSUS_GALAXY__AIML_MODEL_DATA_ENRICHMENT_SAMPLE"."PUBLIC"."Fact_StateBenchmark_ACS2021" sb
       ON sb."StateAbbrev" = 'NY'
      AND sb."MetricID"   = 'XXX'
LIMIT 20;
