WHERE event_date = '20180915'
  AND event_name = 'EVENT_FOUND'                -- replace
  AND (SELECT value.string_value FROM UNNEST(event_params)
       WHERE key = 'mode') = 'quick_play'
LIMIT 20;
```

```sql
-- 6. Retrieve only the columns we will really need.
SELECT
  (SELECT value.string_value FROM UNNEST(event_params)
   WHERE key = 'board_type')  AS board_type,
  (SELECT COALESCE(value.int_value, value.float_value, value.double_value)
