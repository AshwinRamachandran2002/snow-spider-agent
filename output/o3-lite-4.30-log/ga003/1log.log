LIMIT 20;
```

```sql
-- 8. Distinct user / board pairs to avoid counting multiple events in the same session
SELECT
  param_board.value.string_value   AS board_type,
  AVG(score_per_user)              AS avg_score_per_user
FROM (
  SELECT
    `user_pseudo_id`,
    param_board.value.string_value              AS board_type,
    AVG(CAST(param_score.value.int_value AS FLOAT64)) AS score_per_user
  FROM   `firebase-public-project.analytics_153293282.events_20180915`,
         UNNEST(`event_params`) AS param_board
  JOIN   UNNEST(`event_params`) AS param_score
  WHERE  `event_date` = '20180915'
    AND  `event_name` = 'quick_play_complete'
    AND  param_board.key = 'board_type'
    AND  param_score.key = 'score'
  GROUP BY `user_pseudo_id`, board_type
)
GROUP BY board_type
LIMIT 20;
```

```sql
-- 9. Slice further by hour (optional exploration)
SELECT
  FORMAT_TIMESTAMP('%H', TIMESTAMP_MICROS(`event_timestamp`)) AS hour_of_day,
  param_board.value.string_value                              AS board_type,
