    board.value.string_value                                 AS board_type,
    AVG(CAST(COALESCE(val.value.int_value,
                      val.value.float_value,
                      val.value.double_value) AS FLOAT64))   AS score_per_user
  FROM  `firebase-public-project.analytics_153293282.events_20180915`,
        UNNEST(event_params) AS board
  JOIN  UNNEST(event_params) AS val
  WHERE LOWER(event_name) LIKE '%quickplay%'
    AND board.key = 'board'
    AND val.key   = 'value'
  GROUP BY user_pseudo_id, board_type
)
GROUP BY board_type
LIMIT 20
