Begin Exploring Related Columns
Relevant columns and why they matter  
• `event_date` : restrict the analysis to 20180915 (15‑Sep‑2018).  
• `event_name` : locate the event that represents a Quick‑Play completion (e.g. “quickplay_complete”, “level_complete_quickplay”, …).  
• `event_params` : nested key/value pairs that usually contain  
 – `board_type` (STRING) → which board was used  
 – `score` or `score_final` (INT64/FLOAT64) → the player’s score  
• `user_pseudo_id` (optionally) : de‑duplicate or count unique users if needed.

Typical filter / join conditions  
```sql
WHERE event_date = '20180915'
  AND event_name LIKE '%quick%'
  AND ep.key IN ('board_type','score')
```

Below are ten exploratory → analytical BigQuery queries (all limited to 20 rows) to arrive at “average score per board type on 15‑Sep‑2018”.

```sql
-- 1.  What events were fired on 15‑Sep‑2018?
SELECT DISTINCT event_name
FROM   `firebase-public-project.analytics_153293282.events_20180915`
WHERE  event_date = '20180915'
LIMIT  20;
```

```sql
-- 2.  List the most common keys inside event_params for each event
SELECT  event_name,
        ep.key,
        COUNT(*) AS occurrences
FROM   `firebase-public-project.analytics_153293282.events_20180915`,
       UNNEST(event_params) AS ep
WHERE  event_date = '20180915'
GROUP  BY event_name, ep.key
ORDER  BY occurrences DESC
LIMIT  20;
```

```sql
-- 3.  Peek at one possible Quick‑Play completion event and its params
SELECT  event_timestamp,
        ep.key,
        ep.value.string_value    AS s_val,
        ep.value.int_value       AS i_val,
        ep.value.float_value     AS f_val
FROM   `firebase-public-project.analytics_153293282.events_20180915`,
       UNNEST(event_params) AS ep
WHERE  event_date  = '20180915'
  AND  event_name  = 'quickplay_complete'     -- <‑‑ change if 2. shows a different name
LIMIT  20;
```

```sql
-- 4.  Extract board_type values found inside Quick‑Play completion events
SELECT DISTINCT
       ep.value.string_value AS board_type
FROM   `firebase-public-project.analytics_153293282.events_20180915`,
       UNNEST(event_params) AS ep
WHERE  event_date  = '20180915'
  AND  event_name  = 'quickplay_complete'
  AND  ep.key      = 'board_type'
LIMIT  20;
```

```sql
-- 5.  Extract numeric score values for the same event
SELECT
       ep.value.int_value    AS score_int,
       ep.value.float_value  AS score_float,
       ep.value.double_value AS score_double
FROM   `firebase-public-project.analytics_153293282.events_20180915`,
       UNNEST(event_params) AS ep
WHERE  event_date  = '20180915'
  AND  event_name  = 'quickplay_complete'
  AND  ep.key IN ('score','score_final')
LIMIT  20;
```

```sql
-- 6.  Combine board_type and score for each completion row
SELECT  e.user_pseudo_id,
        bt.value.string_value                     AS board_type,
        COALESCE(sc.value.int_value,
                 sc.value.float_value,
                 sc.value.double_value)           AS score
FROM   `firebase-public-project.analytics_153293282.events_20180915` AS e
CROSS  JOIN UNNEST(e.event_params) AS bt
CROSS  JOIN UNNEST(e.event_params) AS sc
WHERE  e.event_date   = '20180915'
  AND  e.event_name   = 'quickplay_complete'
  AND  bt.key         = 'board_type'
  AND  sc.key IN ('score','score_final')
LIMIT  20;
```

```sql
-- 7.  Raw distribution of scores by board_type (no aggregation)
SELECT  board_type,
        score
FROM  (
        SELECT bt.value.string_value AS board_type,
               COALESCE(sc.value.int_value,
                        sc.value.float_value,
                        sc.value.double_value) AS score
        FROM   `firebase-public-project.analytics_153293282.events_20180915` e
        CROSS  JOIN UNNEST(e.event_params) bt
        CROSS  JOIN UNNEST(e.event_params) sc
        WHERE  e.event_date = '20180915'
          AND  e.event_name = 'quickplay_complete'
          AND  bt.key = 'board_type'
          AND  sc.key IN ('score','score_final')
      )
LIMIT 20;
```

```sql
-- 8.  Average score per board_type (simple aggregation)
SELECT  board_type,
        AVG(score) AS avg_score
FROM  (
        SELECT bt.value.string_value AS board_type,
               COALESCE(sc.value.int_value,
                        sc.value.float_value,
                        sc.value.double_value) AS score
        FROM   `firebase-public-project.analytics_153293282.events_20180915` e
        CROSS  JOIN UNNEST(e.event_params) bt
        CROSS  JOIN UNNEST(e.event_params) sc
        WHERE  e.event_date = '20180915'
          AND  e.event_name = 'quickplay_complete'
          AND  bt.key = 'board_type'
          AND  sc.key IN ('score','score_final')
      )
GROUP BY board_type
LIMIT 20;
```

```sql
-- 9.  Same as (8) but counting completions too
SELECT  board_type,
        COUNT(*)  AS completions,
        AVG(score) AS avg_score
FROM  (
        SELECT bt.value.string_value AS board_type,
               COALESCE(sc.value.int_value,
                        sc.value.float_value,
                        sc.value.double_value) AS score
        FROM   `firebase-public-project.analytics_153293282.events_20180915` e
        CROSS  JOIN UNNEST(e.event_params) bt
        CROSS  JOIN UNNEST(e.event_params) sc
        WHERE  e.event_date = '20180915'
          AND  e.event_name = 'quickplay_complete'
          AND  bt.key = 'board_type'
          AND  sc.key IN ('score','score_final')
      )
GROUP BY board_type
ORDER BY avg_score DESC
LIMIT 20;
```

```sql
--10. Final answer: average score per board_type, unique players basis
SELECT  board_type,
        COUNT(DISTINCT user_pseudo_id) AS unique_players,
        AVG(score)                     AS avg_score
FROM  (
        SELECT e.user_pseudo_id,
               bt.value.string_value AS board_type,
               COALESCE(sc.value.int_value,
                        sc.value.float_value,
                        sc.value.double_value) AS score
        FROM   `firebase-public-project.analytics_153293282.events_20180915` e
        CROSS  JOIN UNNEST(e.event_params) bt
        CROSS  JOIN UNNEST(e.event_params) sc
        WHERE  e.event_date = '20180915'
          AND  e.event_name = 'quickplay_complete'
          AND  bt.key = 'board_type'
          AND  sc.key IN ('score','score_final')
      )
GROUP BY board_type
ORDER BY avg_score DESC
LIMIT 20;
```

