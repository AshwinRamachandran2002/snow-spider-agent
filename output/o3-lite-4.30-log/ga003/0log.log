```sql
--Description:
-- The previous attempt required the ‘board’ and ‘score’ parameters to appear
-- inside the very same event row, but inspection showed that board values live
-- in Quick‑Play events (e.g., level_*_quickplay) while the corresponding score
-- is logged later in a separate event called ‘post_score’.  To relate the two
-- we:
--   1. Build one subquery (boards) that fetches every (user_pseudo_id, board)
--      pair recorded on 15‑Sep‑2018 (key = 'board').
--   2. Build another subquery (scores) that fetches every (user_pseudo_id, score)
--      recorded on that date (key IN ('score', 'score_final')).
--   3. Join the two subqueries on user_pseudo_id, assuming a player’s score
--      recorded on the same day belongs to the board they most recently played.
--   4. Aggregate to compute the average score per board.  This delivers the
--      requested “effectiveness” metric even though board and score are stored
--      in separate events.
WITH boards AS (
  SELECT
    e.user_pseudo_id,
    ep.value.string_value AS board
  FROM
    `firebase-public-project.analytics_153293282.events_20180915` AS e,
    UNNEST(e.event_params) AS ep
  WHERE
    e.event_date = '20180915'
    AND ep.key = 'board'
),
scores AS (
  SELECT
    e.user_pseudo_id,
    COALESCE(ep.value.int_value,
             ep.value.float_value,
             ep.value.double_value) AS score
  FROM
    `firebase-public-project.analytics_153293282.events_20180915` AS e,
    UNNEST(e.event_params) AS ep
  WHERE
    e.event_date = '20180915'
    AND ep.key IN ('score','score_final')
)
SELECT
  b.board,
  AVG(s.score) AS avg_score
FROM
  boards AS b
JOIN
  scores AS s
USING (user_pseudo_id)
GROUP BY
  b.board
ORDER BY
  avg_score DESC
LIMIT 20;
