-- Earlier filters on event_name (e.g., “quick” or “level_complete_quickplay”)
-- produced empty results, so this query removes the event_name condition
-- entirely.  It looks at every event that occurred on 15‑Sep‑2018, pairs the
-- parameter key ‘board’ with the parameter key ‘score’ found in the same
-- event row, and then computes the average score for each board.  This gives
-- us the overall effectiveness of each board type on that date, regardless
-- of which specific event recorded the data.
SELECT
  bt.value.string_value                                                 AS board,
  AVG(
      COALESCE(sc.value.int_value,
               sc.value.float_value,
               sc.value.double_value)
  )                                                                     AS avg_score
FROM
  `firebase-public-project.analytics_153293282.events_20180915` AS e
CROSS JOIN UNNEST(e.event_params) AS bt
CROSS JOIN UNNEST(e.event_params) AS sc
WHERE
  e.event_date = '20180915'
  AND bt.key = 'board'
  AND sc.key = 'score'
GROUP BY
  board
ORDER BY
  avg_score DESC
LIMIT 20;
```
