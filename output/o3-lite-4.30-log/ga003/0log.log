```sql
--Description / Thinking process:
-- We are interested in 2018‑09‑15 only → event_date = '20180915'.
-- A “quick play mode completion” event name typically contains the word “quick”,
-- so we retain rows where LOWER(event_name) LIKE '%quick%'.
-- The two pieces of information we need (board_type, score) live inside event_params,
-- an ARRAY of STRUCT<key,value>.  We therefore UNNEST twice:
--   1. bt  → the element whose key = 'board_type'
--   2. sc  → the element whose key = 'score'
-- The numeric score can appear in int_value, float_value, or double_value,
-- so COALESCE them into a single column.
-- Finally, group by board_type and compute AVG(score) to obtain
-- the average score for each board type on that date.
SELECT
  bt.value.string_value                                                  AS board_type,
  AVG(
      COALESCE(sc.value.int_value,
               sc.value.float_value,
               sc.value.double_value)
  )                                                                      AS avg_score
FROM
  `firebase-public-project.analytics_153293282.events_20180915` AS e
CROSS JOIN UNNEST(e.event_params) AS bt
CROSS JOIN UNNEST(e.event_params) AS sc
WHERE
  e.event_date = '20180915'
  AND LOWER(e.event_name) LIKE '%quick%'
  AND bt.key = 'board_type'
  AND sc.key = 'score'
GROUP BY
  board_type
ORDER BY
  avg_score DESC
LIMIT 20;
```
