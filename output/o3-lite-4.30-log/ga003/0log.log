```sql
--Description:
-- Objective: compute the average score obtained for each “board” in
--            Quick‑Play completions on 15‑Sep‑2018.
-- Reasoning steps
--   1. Completions are represented by the event_name ‘level_complete_quickplay’.
--   2. Inside each event’s event_params array:
--        • key = 'board'  → identifies the board used.
--        • key = 'score'  → holds the player’s numeric score.
--   3. UNNEST event_params twice so we can isolate the ‘board’ element (alias bt)
--      and the ‘score’ element (alias sc) for every row.
--   4. COALESCE the three numeric fields (int_value / float_value / double_value)
--      to obtain a single score value.
--   5. Group by board and calculate AVG(score).  Show the 20 rows (if fewer,
--      BigQuery will return whatever exists).
SELECT
  bt.value.string_value                                                 AS board,
  AVG(
      COALESCE(sc.value.int_value,
               sc.value.float_value,
               sc.value.double_value)
  )                                                                     AS avg_score
FROM
  `firebase-public-project.analytics_153293282.events_20180915` AS e
CROSS JOIN UNNEST(e.event_params) AS bt
CROSS JOIN UNNEST(e.event_params) AS sc
WHERE
  e.event_date = '20180915'
  AND e.event_name = 'level_complete_quickplay'
  AND bt.key = 'board'
  AND sc.key = 'score'
GROUP BY
  board
ORDER BY
  avg_score DESC
LIMIT 20;
```
