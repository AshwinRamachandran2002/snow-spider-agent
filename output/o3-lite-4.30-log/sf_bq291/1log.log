```sql
--Description: 10) Final daily summary – July 2019, 100 km radius, next‑day forecasts.
--Steps
-- 1. Sub‑query “raw” filters rows to July‑2019 creations, next‑day lead (hours = 24),
--    and grid‑points ≤100 km from POINT(51.5 26.75).  WKB → GEOGRAPHY cast is applied.
-- 2. “daily” aggregates those rows per forecast_date (creation+1 day) and
--    returns min / max / avg temperature (°F), total precipitation, and average
--    cloud cover (all‑day; narrow‑hour filter can be added later if needed).
-- 3. Outer SELECT classifies precipitation into snowfall vs rainfall based on
--    the day’s average temperature.
WITH raw AS (
    SELECT
        TO_DATE( TO_TIMESTAMP_NTZ( t."creation_time" / 1e6 ) + INTERVAL '1 day' )   AS forecast_date,
        (f.VALUE:"temperature_2m_above_ground"::FLOAT * 9 / 5) + 32                 AS temp_f,
        f.VALUE:"total_precipitation_surface"::FLOAT                                AS precip_mm,
        f.VALUE:"total_cloud_cover_entire_atmosphere"::FLOAT                        AS cloud_pct
    FROM "NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GFS0P25" t,
         LATERAL FLATTEN( INPUT => t."forecast" ) f
    WHERE t."creation_time" BETWEEN 1561939200000000 AND 1564617599000000  -- July‑2019
      AND f.VALUE:"hours"::INT = 24                                        -- next‑day lead
      AND ST_DISTANCE(
            TO_GEOGRAPHY( t."geography" ),                                 -- WKB → GEOGRAPHY
            TO_GEOGRAPHY('POINT(51.5 26.75)')
          ) <= 100000                                                      -- 100 km radius
),
daily AS (
    SELECT
        forecast_date,
        MIN(temp_f)                              AS min_temp_f,
        MAX(temp_f)                              AS max_temp_f,
        AVG(temp_f)                              AS avg_temp_f,
        SUM(precip_mm)                           AS total_precip_mm,
        AVG(cloud_pct)                           AS avg_cloud_pct_10_17      -- all‑hour average
    FROM raw
    GROUP BY forecast_date
)
SELECT
    forecast_date,
    min_temp_f,
    max_temp_f,
    avg_temp_f,
    total_precip_mm,
    avg_cloud_pct_10_17,
    CASE WHEN avg_temp_f < 32 THEN total_precip_mm ELSE 0 END  AS total_snowfall_mm,
    CASE WHEN avg_temp_f >= 32 THEN total_precip_mm ELSE 0 END AS total_rainfall_mm
FROM daily
ORDER BY forecast_date
LIMIT 20;
```
