```sql
--Description / Thinking process:
-- We want next‑day (lead‑hour = 24) forecast data that was CREATED during July 2019
-- and whose grid‑point is within 5 km of latitude 26.75, longitude 51.5.
--  • Time window (micro‑seconds since epoch):
--        2019‑07‑01 00:00:00  → 1561939200000000
--        2019‑07‑31 23:59:59  → 1564617599000000
--  • Spatial test: the column "geography" is BINARY (WKB).  Wrap it with
--        TO_GEOGRAPHY() so ST_DISTANCE can compare it with the reference point.
--  • Flatten the VARIANT array "forecast" so each element (one lead hour) is a row.
--  • Filter elements where "hours" = 24.
--  • Return key fields (temp, precip, cloud cover) as a sanity check.
SELECT
    t."creation_time",
    f.VALUE:"hours"::INT                                 AS "hours",
    f.VALUE:"temperature_2m_above_ground"::FLOAT         AS "temp_c",
    f.VALUE:"total_precipitation_surface"::FLOAT         AS "precip_mm",
    f.VALUE:"total_cloud_cover_entire_atmosphere"::FLOAT AS "cloud_pct"
FROM
    "NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GFS0P25" AS t,
    LATERAL FLATTEN(INPUT => t."forecast") AS f
WHERE
    t."creation_time" BETWEEN 1561939200000000 AND 1564617599000000     -- July 2019
    AND f.VALUE:"hours"::INT = 24                                        -- next‑day lead
    AND ST_DISTANCE(
            TO_GEOGRAPHY(t."geography"),                                 -- convert WKB
            TO_GEOGRAPHY('POINT(51.5 26.75)')
        ) <= 5000                                                        -- 5 km radius
LIMIT 20;
```
