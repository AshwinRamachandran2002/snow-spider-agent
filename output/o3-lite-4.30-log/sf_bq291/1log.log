WITH target_point AS (
    SELECT TO_GEOGRAPHY('POINT(51.5 26.75)') AS geom
),
raw AS (
    SELECT
        TO_DATE(TO_TIMESTAMP_NTZ(t."creation_time" / 1000000) + INTERVAL '1 day')
                                                            AS forecast_date,
        f.VALUE:"hours"::INT                                 AS hour_lead,
        (f.VALUE:"temperature_2m_above_ground"::FLOAT * 9/5)+32
                                                            AS temp_f,
        f.VALUE:"total_precipitation_surface"::FLOAT         AS precip_mm,
        f.VALUE:"total_cloud_cover_entire_atmosphere"::FLOAT AS cloud_pct
    FROM "NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GFS0P25" t,
         target_point tp,
         LATERAL FLATTEN(INPUT => t."forecast") f
    WHERE t."creation_time" BETWEEN 1561939200000000              -- 2019‑07‑01 00:00:00
                               AND     1564617599000000           -- 2019‑07‑31 23:59:59
      AND f.VALUE:"hours"::INT BETWEEN 24 AND 41                  -- next‑day hours
      AND ST_DISTANCE(TO_GEOGRAPHY(t."geography"), tp.geom) <= 5000
),
daily AS (
    SELECT
        forecast_date,
        MAX(temp_f)                                                      AS max_temp_f,
        MIN(temp_f)                                                      AS min_temp_f,
        AVG(temp_f)                                                      AS avg_temp_f,
        SUM(precip_mm)                                                   AS total_precipitation_mm,
        AVG(CASE WHEN hour_lead BETWEEN 34 AND 41 THEN cloud_pct END)    AS avg_cloud_cover_pct
    FROM raw
    GROUP BY forecast_date
)
SELECT
    TO_CHAR(forecast_date, 'YYYY-MM-DD')                                           AS forecast_date,
    ROUND(max_temp_f, 4)                                                           AS max_temp_f,
    ROUND(min_temp_f, 4)                                                           AS min_temp_f,
    ROUND(avg_temp_f, 4)                                                           AS avg_temp_f,
    ROUND(total_precipitation_mm, 4)                                               AS total_precipitation_mm,
    ROUND(avg_cloud_cover_pct, 4)                                                  AS avg_cloud_cover_pct,
    ROUND(CASE WHEN avg_temp_f < 32 THEN total_precipitation_mm ELSE 0 END, 4)     AS total_snowfall_mm,
    ROUND(CASE WHEN avg_temp_f >= 32 THEN total_precipitation_mm ELSE 0 END, 4)    AS total_rainfall_mm
FROM daily
ORDER BY forecast_date;
```
