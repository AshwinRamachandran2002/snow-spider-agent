```sql
--Description: 6) Limit to the next‑day forecasts (lead‑hour = 24).
SELECT 
  t."creation_time",
  f.VALUE:"hours"::INT                               AS "hours",
  f.VALUE:"temperature_2m_above_ground"::FLOAT       AS "temp_c",
  f.VALUE:"total_precipitation_surface"::FLOAT       AS "precip_mm"
FROM "NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GFS0P25" t,
     LATERAL FLATTEN(INPUT => t."forecast") f
WHERE t."creation_time" BETWEEN 1561939200000000 AND 1564617599000000
  AND f.VALUE:"hours"::INT = 24
LIMIT 20;
```

```sql
--Description: 7) Add geography filter – only grid‑points within 5 km of 26.75 / 51.5.
SELECT 
  t."creation_time",
  f.VALUE:"hours"::INT                              AS "hours",
  f.VALUE:"temperature_2m_above_ground"::FLOAT      AS "temp_c",
  f.VALUE:"total_precipitation_surface"::FLOAT      AS "precip_mm"
FROM "NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GFS0P25" t,
     LATERAL FLATTEN(INPUT => t."forecast") f
WHERE t."creation_time" BETWEEN 1561939200000000 AND 1564617599000000
  AND f.VALUE:"hours"::INT = 24
  AND ST_DISTANCE(t."geography", TO_GEOGRAPHY('POINT(51.5 26.75)')) <= 5000
LIMIT 20;
```

```sql
--Description: 8) Convert temperature to °F and show cloud cover & snowfall/rainfall indicators.
SELECT 
  t."creation_time",
  (f.VALUE:"temperature_2m_above_ground"::FLOAT * 9.0/5.0) + 32          AS "temp_f",
  f.VALUE:"total_cloud_cover_entire_atmosphere"::FLOAT                   AS "cloud_pct",
  f.VALUE:"snowfall_surface"::FLOAT                                      AS "snow_mm",
  f.VALUE:"total_precipitation_surface"::FLOAT                           AS "precip_mm"
FROM "NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GFS0P25" t,
     LATERAL FLATTEN(INPUT => t."forecast") f
WHERE t."creation_time" BETWEEN 1561939200000000 AND 1564617599000000
  AND f.VALUE:"hours"::INT = 24
  AND ST_DISTANCE(t."geography", TO_GEOGRAPHY('POINT(51.5 26.75)')) <= 5000
LIMIT 20;
```

```sql
--Description: 9) Aggregate per creation date (which will correspond to the forecast date‑1).
SELECT 
  TO_DATE(TO_TIMESTAMP_NTZ("creation_time"/1e6))                             AS "creation_date",
  MIN( (f.VALUE:"temperature_2m_above_ground"::FLOAT * 9/5) + 32 )           AS "min_temp_f",
  MAX( (f.VALUE:"temperature_2m_above_ground"::FLOAT * 9/5) + 32 )           AS "max_temp_f",
  AVG( (f.VALUE:"temperature_2m_above_ground"::FLOAT * 9/5) + 32 )           AS "avg_temp_f",
  SUM( f.VALUE:"total_precipitation_surface"::FLOAT )                        AS "total_precip_mm"
FROM "NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GFS0P25" t,
     LATERAL FLATTEN(INPUT => t."forecast") f
WHERE t."creation_time" BETWEEN 1561939200000000 AND 1564617599000000
  AND f.VALUE:"hours"::INT = 24
  AND ST_DISTANCE(t."geography", TO_GEOGRAPHY('POINT(51.5 26.75)')) <= 5000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 10) Final daily summary – July 2019, 5 km radius, next‑day forecast.
SELECT
  TO_DATE(TO_TIMESTAMP_NTZ(t."creation_time"/1e6) + INTERVAL '1 day')       AS "forecast_date",
  MIN( temp_f )                                                             AS "min_temp_f",
  MAX( temp_f )                                                             AS "max_temp_f",
  AVG( temp_f )                                                             AS "avg_temp_f",
  SUM( precip_mm )                                                          AS "total_precip_mm",
  AVG( cloud_pct )                                                          AS "avg_cloud_pct_10_17",
  SUM( CASE WHEN avg_temp_f < 32 THEN precip_mm ELSE 0 END )                AS "total_snowfall_mm",
  SUM( CASE WHEN avg_temp_f >= 32 THEN precip_mm ELSE 0 END )               AS "total_rainfall_mm"
FROM (
  SELECT
    t."creation_time",
    f.VALUE:"hours"::INT                                                    AS "hours",
    (f.VALUE:"temperature_2m_above_ground"::FLOAT * 9/5) + 32               AS "temp_f",
    f.VALUE:"total_precipitation_surface"::FLOAT                            AS "precip_mm",
    f.VALUE:"total_cloud_cover_entire_atmosphere"::FLOAT                    AS "cloud_pct"
  FROM "NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GFS0P25" t,
       LATERAL FLATTEN(INPUT => t."forecast") f
  WHERE t."creation_time" BETWEEN 1561939200000000 AND 1564617599000000
    AND f.VALUE:"hours"::INT = 24
    AND ST_DISTANCE(t."geography", TO_GEOGRAPHY('POINT(51.5 26.75)')) <= 5000
) x
QUALIFY 1=1  -- keeps sub‑query structure; nothing to filter here
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

