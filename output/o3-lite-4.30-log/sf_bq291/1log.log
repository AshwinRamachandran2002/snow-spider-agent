--Description:  Look for any NOAA‑GFS grid‑points located within 100 km of
--POINT(51.5 E 26.75 N), without imposing date or lead‑hour filters.  
--This confirms that the dataset contains cells close to the target location
--before stricter conditions are added later.  We convert the WKB “geography”
--column to GEOGRAPHY for ST_DISTANCE, and display the grid‑point’s latitude,
--longitude, distance (metres), forecast lead‑hour, and temperature (°C).

SELECT
    t."creation_time",
    ST_Y( TO_GEOGRAPHY(t."geography") )                      AS "lat",
    ST_X( TO_GEOGRAPHY(t."geography") )                      AS "lon",
    ST_DISTANCE(
        TO_GEOGRAPHY(t."geography"),
        TO_GEOGRAPHY('POINT(51.5 26.75)')
    )                                                        AS "distance_m",
    f.VALUE:"hours"::INT                                     AS "hours",
    f.VALUE:"temperature_2m_above_ground"::FLOAT             AS "temp_c"
FROM
    "NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GFS0P25" AS t,
    LATERAL FLATTEN(INPUT => t."forecast") AS f
WHERE
    ST_DISTANCE(
        TO_GEOGRAPHY(t."geography"),
        TO_GEOGRAPHY('POINT(51.5 26.75)')
    ) <= 100000           -- 100 km radius
LIMIT 20;
