```sql
--Description: Verify that July‑2019 forecasts include next‑day (24‑hour lead) grid‑
--points in the wider vicinity (≤250 km) of 26.75 N 51.5 E.  
--If results appear, we can later narrow the radius.  
--Steps embedded in query:  
-- 1) Filter "creation_time" to July‑2019 (micro‑seconds epoch).  
-- 2) Flatten the "forecast" array and keep only elements where "hours" = 24.  
-- 3) Convert the WKB "geography" column with TO_GEOGRAPHY so spatial functions work.  
-- 4) Use ST_DISTANCE to keep cells within 250 000 m (≈250 km).  
-- 5) Show lat/lon (extracted with ST_Y/ST_X) plus a couple of weather fields.

SELECT
    t."creation_time",
    ST_Y(TO_GEOGRAPHY(t."geography"))                    AS "lat",
    ST_X(TO_GEOGRAPHY(t."geography"))                    AS "lon",
    f.VALUE:"hours"::INT                                 AS "hours",
    f.VALUE:"temperature_2m_above_ground"::FLOAT         AS "temp_c",
    f.VALUE:"total_precipitation_surface"::FLOAT         AS "precip_mm"
FROM
    "NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GFS0P25" AS t,
    LATERAL FLATTEN(INPUT => t."forecast") AS f
WHERE
    t."creation_time" BETWEEN 1561939200000000   -- 2019‑07‑01
                          AND 1564617599000000   -- 2019‑07‑31 23:59:59
    AND f.VALUE:"hours"::INT = 24               -- next‑day forecast lead
    AND ST_DISTANCE(
            TO_GEOGRAPHY(t."geography"),
            TO_GEOGRAPHY('POINT(51.5 26.75)')
        ) <= 250000                             -- 250 km search radius
LIMIT 20;
