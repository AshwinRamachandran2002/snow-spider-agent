      AND f.VALUE:"hours"::INT = 24                                            -- next‑day lead
      AND ST_DISTANCE(
            TO_GEOGRAPHY( t."geography" ),                                     -- cast WKB → GEOGRAPHY
            TO_GEOGRAPHY('POINT(51.5 26.75)')
          ) <= 5000                                                            -- 5 km radius
) x
GROUP BY 1
ORDER BY 1
LIMIT 20;
