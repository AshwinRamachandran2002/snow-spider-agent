--Description: 10) Final daily summary – July 2019, 5 km radius, next‑day forecast (geography cast fixed).
SELECT
    TO_DATE( TO_TIMESTAMP_NTZ(t."creation_time" / 1e6) + INTERVAL '1 day' )    AS "forecast_date",
    MIN( temp_f )                                                              AS "min_temp_f",
