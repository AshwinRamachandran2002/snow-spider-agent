```sql
-- 10. Description: (Outline of final full answer) Daily summary for every July‑2019 forecast day, 
--                  including rain vs. snow separation and daytime cloud cover.
WITH target_runs AS (
    SELECT *
    FROM NOAA_GLOBAL_FORECAST_SYSTEM.NOAA_GLOBAL_FORECAST_SYSTEM.NOAA_GFS0P25
    WHERE "creation_time" BETWEEN 1561939200000000 AND 1564617599000000
      AND ST_DISTANCE(
            TO_GEOGRAPHY('POINT(51.5 26.75)'),
            TO_GEOGRAPHY("geography")
          ) <= 5000
), flat AS (
    SELECT
        TO_DATE( TO_TIMESTAMP_LTZ( f.value:"time"::NUMBER / 1000000 ) )   AS forecast_date,
        f.value:"hours"::NUMBER                                          AS hours,
        f.value:"temperature_2m_above_ground"::FLOAT                     AS temp_K,
        f.value:"total_precipitation_surface"::FLOAT                     AS precip_mm,
        f.value:"snowfall_surface"::FLOAT                                AS snowfall_mm,
        f.value:"cloud_cover_total_cloud_layer"::FLOAT                   AS cloud_pct,
        f.value:"time"::NUMBER                                           AS utc_valid_micro
    FROM target_runs r,
         LATERAL FLATTEN( input => r."forecast" ) f
    WHERE f.value:"hours"::NUMBER = 24          -- next‑day forecast only
)
SELECT
    forecast_date,
    MAX( temp_K ) - 273.15                                      AS max_temp_C,
    MIN( temp_K ) - 273.15                                      AS min_temp_C,
    AVG( temp_K ) - 273.15                                      AS avg_temp_C,
    SUM( precip_mm )                                            AS total_precip_mm,
    AVG( CASE
            WHEN DATE_PART('hour', TO_TIMESTAMP_LTZ(utc_valid_micro/1000000) )
                 BETWEEN 10 AND 17 THEN cloud_pct
        END )                                                   AS avg_cloud_pct_10to17,
    SUM( CASE WHEN (temp_K - 273.15) < 0 THEN snowfall_mm END ) AS total_snow_mm,
    SUM( CASE WHEN (temp_K - 273.15) >= 0 THEN precip_mm END )  AS total_rain_mm
FROM flat
GROUP BY forecast_date
ORDER BY forecast_date
LIMIT 20;
```

