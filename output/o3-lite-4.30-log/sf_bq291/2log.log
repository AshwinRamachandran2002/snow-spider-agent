```sql
--Description: Aggregate max/min/avg temperature and total precipitation & snowfall
--             for one forecast day within 200‑km of POINT(26.75 51.5), using
--             24‑hour lead forecasts issued in July‑2019.
SELECT
    TO_DATE( TO_TIMESTAMP_LTZ( f.value:"time"::NUMBER / 1000000 ) )      AS "forecast_date",
    MAX( f.value:"temperature_2m_above_ground"::FLOAT - 273.15 )         AS "max_temp_C",
    MIN( f.value:"temperature_2m_above_ground"::FLOAT - 273.15 )         AS "min_temp_C",
    AVG( f.value:"temperature_2m_above_ground"::FLOAT - 273.15 )         AS "avg_temp_C",
    SUM( f.value:"total_precipitation_surface"::FLOAT )                  AS "precip_mm",
    SUM( f.value:"snowfall_surface"::FLOAT )                             AS "snowfall_mm"
FROM NOAA_GLOBAL_FORECAST_SYSTEM.NOAA_GLOBAL_FORECAST_SYSTEM.NOAA_GFS0P25 t,
     LATERAL FLATTEN( input => t."forecast" ) f
WHERE f.value:"hours"::NUMBER = 24
  AND ST_DISTANCE(
        TO_GEOGRAPHY('POINT(26.75 51.5)'),      -- lat lon
        TO_GEOGRAPHY(t."geography")
      ) <= 200000               -- 200‑km radius
  AND t."creation_time" BETWEEN 1561939200000000 AND 1564617599000000
GROUP BY 1
LIMIT 20;
```

```sql
--Description: Full daily weather summary for July‑2019 within 200‑km of
--             POINT(26.75 51.5).  Separates rain vs. snow, provides daytime
--             (10–17 local) average cloud cover, and uses next‑day (24‑hour)
--             forecasts that were created during July‑2019.
WITH target_runs AS (
    SELECT *
    FROM NOAA_GLOBAL_FORECAST_SYSTEM.NOAA_GLOBAL_FORECAST_SYSTEM.NOAA_GFS0P25
    WHERE "creation_time" BETWEEN 1561939200000000 AND 1564617599000000
      AND ST_DISTANCE(
            TO_GEOGRAPHY('POINT(26.75 51.5)'),   -- lat lon
            TO_GEOGRAPHY("geography")
          ) <= 200000           -- 200‑km radius
), flat AS (
    SELECT
        TO_DATE( TO_TIMESTAMP_LTZ( f.value:"time"::NUMBER / 1000000 ) )   AS forecast_date,
        f.value:"temperature_2m_above_ground"::FLOAT                     AS temp_K,
        f.value:"total_precipitation_surface"::FLOAT                     AS precip_mm,
        f.value:"snowfall_surface"::FLOAT                                AS snowfall_mm,
        f.value:"cloud_cover_total_cloud_layer"::FLOAT                   AS cloud_pct,
        f.value:"time"::NUMBER                                           AS utc_valid_micro
    FROM target_runs r,
         LATERAL FLATTEN( input => r."forecast" ) f
    WHERE f.value:"hours"::NUMBER = 24          -- next‑day forecast only
)
SELECT
    forecast_date,
    MAX( temp_K ) - 273.15                                      AS max_temp_C,
    MIN( temp_K ) - 273.15                                      AS min_temp_C,
    AVG( temp_K ) - 273.15                                      AS avg_temp_C,
    SUM( precip_mm )                                            AS total_precip_mm,
    AVG( CASE
            WHEN DATE_PART('hour', TO_TIMESTAMP_LTZ(utc_valid_micro/1000000) )
                 BETWEEN 10 AND 17 THEN cloud_pct
        END )                                                   AS avg_cloud_pct_10to17,
    SUM( CASE WHEN (temp_K - 273.15) < 273.15 THEN snowfall_mm END )     AS total_snow_mm,
    SUM( CASE WHEN (temp_K - 273.15) >= 273.15 THEN precip_mm  END )     AS total_rain_mm
FROM flat
GROUP BY forecast_date
ORDER BY forecast_date
LIMIT 20;
```
