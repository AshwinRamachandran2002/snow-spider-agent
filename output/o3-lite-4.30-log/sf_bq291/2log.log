--             radius around POINT(26.75 51.5) which is wide enough to include
--             nearby grid‑nodes, and display temperature values for inspection.
SELECT
    TO_DATE( TO_TIMESTAMP_LTZ( f.value:"time"::NUMBER / 1000000 ) ) AS "forecast_date",
    f.value:"temperature_2m_above_ground"::FLOAT                   AS "temp_K"
FROM NOAA_GLOBAL_FORECAST_SYSTEM.NOAA_GLOBAL_FORECAST_SYSTEM.NOAA_GFS0P25 t,
     LATERAL FLATTEN( input => t."forecast" ) f
WHERE f.value:"hours"::NUMBER = 24
