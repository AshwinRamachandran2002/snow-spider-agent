```sql
WITH base AS (
    SELECT
        f.value:"hours"::INT                                  AS lead_hr,
        f.value:"temperature_2m_above_ground"::FLOAT          AS temp_c,
        f.value:"total_precipitation_surface"::FLOAT          AS precip_mm,
        f.value:"total_cloud_cover_entire_atmosphere"::FLOAT  AS cloud_pct,
        (f.value:"time"::NUMBER) / 1000000                    AS valid_time_sec
    FROM "NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GFS0P25" g,
         LATERAL FLATTEN ( INPUT => g."forecast" ) f
    WHERE ST_DISTANCE(
              TO_GEOGRAPHY(g."geography"),
              TO_GEOGRAPHY('POINT(51.5 26.75)')
          ) <= 5000
      AND g."creation_time" BETWEEN 1561939200000000          -- 2019‑07‑01 00:00:00 UTC
                              AND 1564617599000000          -- 2019‑07‑31 23:59:59 UTC
      AND f.value:"hours"::INT BETWEEN 24 AND 47              -- next‑day forecasts
),
daily AS (
    SELECT
        TO_DATE(TO_TIMESTAMP(valid_time_sec))                                  AS forecast_date,
        MAX(temp_c)                                                            AS max_temp_c,
        MIN(temp_c)                                                            AS min_temp_c,
        AVG(temp_c)                                                            AS avg_temp_c,
        SUM(precip_mm)                                                         AS total_precip_mm,
        AVG(CASE WHEN lead_hr BETWEEN 26 AND 33 THEN cloud_pct END)            AS avg_cloud_cover_pct
    FROM base
    GROUP BY forecast_date
    HAVING forecast_date BETWEEN '2019-07-01' AND '2019-07-31'
)
SELECT
    forecast_date,
    ROUND(max_temp_c * 9/5 + 32, 4)                                            AS max_temp_f,
    ROUND(min_temp_c * 9/5 + 32, 4)                                            AS min_temp_f,
    ROUND(avg_temp_c * 9/5 + 32, 4)                                            AS avg_temp_f,
    ROUND(total_precip_mm, 4)                                                  AS total_precipitation_mm,
    ROUND(avg_cloud_cover_pct, 4)                                              AS avg_cloud_cover_pct,
    ROUND(CASE WHEN (avg_temp_c * 9/5 + 32) < 32  THEN total_precip_mm END, 4) AS total_snowfall_mm,
    ROUND(CASE WHEN (avg_temp_c * 9/5 + 32) >= 32 THEN total_precip_mm END, 4) AS total_rainfall_mm
FROM daily
ORDER BY forecast_date;
```
