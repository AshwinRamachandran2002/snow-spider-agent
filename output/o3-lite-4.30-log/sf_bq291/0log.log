/*  Daily weather summary – July 2019, 5‑km radius around 26.75 N 51.5 E  */
WITH base AS (
    SELECT
        /* valid date of the forecast element                                    */
        TO_DATE(
            TO_TIMESTAMP_NTZ( (f.value:"time"::NUMBER) / 1000000 )
        )                                                    AS "forecast_date",

        /* lead time (must be 24‑47 h → “next day”)                              */
        f.value:"hours"::INT                                 AS "lead_hr",

        /* basic weather variables                                               */
        f.value:"temperature_2m_above_ground"::FLOAT         AS "temp_c",
        f.value:"total_precipitation_surface"::FLOAT         AS "precip_mm",

        /* cloud‑cover key can vary slightly; pick the first non‑NULL            */
        COALESCE(
            f.value:"total_cloud_cover_entire_atmosphere"::FLOAT,
            f.value:"cloud_cover"::FLOAT
        )                                                    AS "cloud_pct"
    FROM "NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GLOBAL_FORECAST_SYSTEM"."NOAA_GFS0P25" g,
         LATERAL FLATTEN (INPUT => g."forecast") f
    WHERE g."creation_time"
              BETWEEN 1561939200000000 AND 1564617599000000          -- 2019‑07‑01 .. 2019‑07‑31 (µs)
      AND f.value:"hours"::INT BETWEEN 24 AND 47                     -- only “next‑day” forecast hours
      AND COALESCE(g."geography", g."geography_polygon") IS NOT NULL
      AND ST_DISTANCE(
              TO_GEOGRAPHY( COALESCE(g."geography", g."geography_polygon") ),
              TO_GEOGRAPHY('POINT(51.5 26.75)')
          ) <= 5000                                                  -- within 5 km of the target point
),
daily AS (
    SELECT
        "forecast_date",
        MAX("temp_c")                                                AS "max_temp_c",
        MIN("temp_c")                                                AS "min_temp_c",
        AVG("temp_c")                                                AS "avg_temp_c",
        SUM("precip_mm")                                             AS "total_precip_mm",
        AVG(
            CASE WHEN "lead_hr" BETWEEN 26 AND 33 THEN "cloud_pct" END
        )                                                            AS "avg_cloud_cover_pct"
    FROM base
    GROUP BY "forecast_date"
    HAVING "forecast_date" BETWEEN '2019-07-01' AND '2019-07-31'
)
SELECT
    "forecast_date",
    ROUND("max_temp_c" * 9 / 5 + 32, 4)                              AS "max_temp_f",
    ROUND("min_temp_c" * 9 / 5 + 32, 4)                              AS "min_temp_f",
    ROUND("avg_temp_c" * 9 / 5 + 32, 4)                              AS "avg_temp_f",
    ROUND("total_precip_mm", 4)                                      AS "total_precipitation_mm",
    ROUND("avg_cloud_cover_pct", 4)                                  AS "avg_cloud_cover_pct",
    ROUND(
        CASE WHEN ("avg_temp_c" * 9 / 5 + 32) < 32
             THEN "total_precip_mm" END, 4
    )                                                                AS "total_snowfall_mm",
    ROUND(
        CASE WHEN ("avg_temp_c" * 9 / 5 + 32) >= 32
             THEN "total_precip_mm" END, 4
    )                                                                AS "total_rainfall_mm"
FROM daily
ORDER BY "forecast_date";
