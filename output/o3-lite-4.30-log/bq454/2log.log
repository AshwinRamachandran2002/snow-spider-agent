```sql
--Description: 5) Join the exploded variant–sample pairs to `sample_info`
--             to attach super‑population information.
SELECT
  v.reference_name,
  v.start,
  s.Super_Population,
  c.call_set_name AS sample
FROM
  `genomics-public-data.1000_genomes.variants` AS v,
  UNNEST(v.call) AS c
JOIN
