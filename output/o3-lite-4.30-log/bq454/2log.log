```sql
--Description: 8) Bucket common variants by the number of AFR samples that share them.
SELECT
  n_carriers,
  COUNT(*) AS afr_variant_cnt
FROM (
  SELECT
    v.reference_name,
    v.start,
    COUNT(DISTINCT c.call_set_name) AS n_carriers
  FROM
    `genomics-public-data.1000_genomes.variants` AS v,
    UNNEST(v.call) AS c
  JOIN
    `genomics-public-data.1000_genomes.sample_info` AS s
  ON
    s.Sample = c.call_set_name
  WHERE
    v.reference_name NOT IN ('X', 'Y', 'MT')
    AND v.AF >= 0.05
    AND s.Super_Population = 'AFR'
    AND EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0)
  GROUP BY
    v.reference_name,
    v.start
)
GROUP BY
  n_carriers
ORDER BY
  n_carriers
LIMIT 20;
```

```sql
--Description: 9) Extend the carrier‑count bucketing to every super‑population.
SELECT
  s.Super_Population,
  COUNT(DISTINCT s.Sample) AS pop_size,
  n_carriers,
  COUNT(*) AS variant_cnt
FROM (
  SELECT
    v.reference_name,
    v.start,
    c.call_set_name,
    s.Super_Population
  FROM
    `genomics-public-data.1000_genomes.variants` AS v,
    UNNEST(v.call) AS c
  JOIN
    `genomics-public-data.1000_genomes.sample_info` AS s
  ON
    s.Sample = c.call_set_name
  WHERE
    v.reference_name NOT IN ('X', 'Y', 'MT')
    AND v.AF >= 0.05
    AND EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0)
) AS x
JOIN (
  -- Carriers per (variant, super‑population)
  SELECT
    reference_name,
    start,
    Super_Population,
    COUNT(DISTINCT call_set_name) AS n_carriers
  FROM (
    SELECT
      v.reference_name,
      v.start,
      c.call_set_name,
      s.Super_Population
    FROM
      `genomics-public-data.1000_genomes.variants` AS v,
      UNNEST(v.call) AS c
    JOIN
      `genomics-public-data.1000_genomes.sample_info` AS s
    ON
      s.Sample = c.call_set_name
    WHERE
      v.reference_name NOT IN ('X', 'Y', 'MT')
      AND v.AF >= 0.05
      AND EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0)
  )
  GROUP BY
    reference_name,
    start,
    Super_Population
) USING(reference_name, start, Super_Population)
GROUP BY
  s.Super_Population,
  n_carriers
ORDER BY
  s.Super_Population,
  n_carriers
LIMIT 20;
```

```sql
--Description: 10) Final‑shape query – for each super‑population, show population size,
--              the carrier count bucket, and number of common variants in that bucket.
SELECT
  sp.Super_Population,
  pop_size,
  TRUE  AS is_common_AF_ge_0_05,
  n_carriers AS samples_with_variant,
  COUNT(*)   AS variants_shared_by_that_many
FROM (
  -- Total sample counts per super‑population
  SELECT
    Super_Population,
    COUNT(*) AS pop_size
  FROM
    `genomics-public-data.1000_genomes.sample_info`
  GROUP BY
    Super_Population
) AS sp
JOIN (
  -- Carriers per variant per super‑population
  SELECT
    reference_name,
    start,
    Super_Population,
    COUNT(DISTINCT call_set_name) AS n_carriers
  FROM (
    SELECT
      v.reference_name,
      v.start,
      c.call_set_name,
      s.Super_Population
    FROM
      `genomics-public-data.1000_genomes.variants` AS v,
      UNNEST(v.call) AS c
    JOIN
      `genomics-public-data.1000_genomes.sample_info` AS s
    ON
      s.Sample = c.call_set_name
    WHERE
      v.reference_name NOT IN ('X', 'Y', 'MT')
      AND v.AF >= 0.05
      AND EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0)
  )
  GROUP BY
    reference_name,
    start,
    Super_Population
) AS vpop
ON
  sp.Super_Population = vpop.Super_Population
GROUP BY
  sp.Super_Population,
  pop_size,
  n_carriers
ORDER BY
  sp.Super_Population,
  n_carriers
LIMIT 20;
```
