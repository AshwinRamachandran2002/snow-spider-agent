--             at least one alternate allele.
SELECT
  reference_name,
  start,
  c.call_set_name AS sample,
  c.genotype       AS gt
FROM
  `genomics-public-data.1000_genomes.variants`,
  UNNEST(call) AS c
WHERE
  reference_name NOT IN ('X', 'Y', 'MT')
  AND EXISTS (SELECT g FROM UNNEST(c.genotype) AS g WHERE g > 0)
LIMIT 20;
