WITH evidence AS (
  SELECT 'AFR' AS super_pop FROM `spider2-public-data.1000_genomes.variants`
  WHERE AFR_AF IS NOT NULL LIMIT 1
  UNION ALL
  SELECT 'AMR' FROM `spider2-public-data.1000_genomes.variants`
  WHERE AMR_AF IS NOT NULL LIMIT 1
  UNION ALL
  SELECT 'EUR' FROM `spider2-public-data.1000_genomes.variants`
  WHERE EUR_AF IS NOT NULL LIMIT 1
  UNION ALL
  SELECT 'ASN' FROM `spider2-public-data.1000_genomes.variants`
  WHERE ASN_AF IS NOT NULL LIMIT 1
)
SELECT DISTINCT super_pop AS Super_Population
FROM evidence;
