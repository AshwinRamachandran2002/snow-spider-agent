```sql
--Description: Produce a histogram for each super‑population showing how many
--             common autosomal variants (AF ≥ 0.05) are shared by exactly N
--             carrier samples. Steps:
--             1) pop_size CTE — count total samples per super‑population
--                using the public `sample_info` table.
--             2) var_carriers CTE — for each variant within each super‑population,
--                count distinct samples whose genotype array contains at least one
--                alternate allele (>0).  Limit to autosomes (exclude X, Y, MT) and
--                to common variants (AF ≥ 0.05).
--             3) Join var_carriers to pop_size; aggregate to obtain, for every
--                (Super_Population, n_carriers) bucket, the number of variants in
--                that bucket (variant_cnt).  LIMIT 20 is a preview safeguard.
WITH pop_size AS (
  SELECT
    Super_Population,
    COUNT(*) AS pop_size
  FROM
    `genomics-public-data.1000_genomes.sample_info`
  GROUP BY
    Super_Population
),
var_carriers AS (
  SELECT
    v.reference_name,
    v.start,
    s.Super_Population,
    COUNT(DISTINCT c.call_set_name) AS n_carriers
  FROM
    `genomics-public-data.1000_genomes.variants` AS v
  JOIN
    UNNEST(v.call) AS c
  JOIN
    `genomics-public-data.1000_genomes.sample_info` AS s
  ON
    s.Sample = c.call_set_name
  WHERE
    v.reference_name NOT IN ('X', 'Y', 'MT')            -- autosomal only
    AND v.AF >= 0.05                                     -- common variants
    AND EXISTS (SELECT g FROM UNNEST(c.genotype) AS g    -- sample carries alt allele
                WHERE g > 0)
  GROUP BY
    v.reference_name,
    v.start,
    s.Super_Population
)
SELECT
  vc.Super_Population,
  ps.pop_size,
  vc.n_carriers,
  COUNT(*) AS variant_cnt
FROM
  var_carriers AS vc
JOIN
  pop_size AS ps
ON
  vc.Super_Population = ps.Super_Population
GROUP BY
  vc.Super_Population,
  ps.pop_size,
  vc.n_carriers
ORDER BY
  vc.Super_Population,
  vc.n_carriers
LIMIT 20;
