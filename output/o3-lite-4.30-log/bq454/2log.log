--Description: Final‑shape query.  For each super‑population we: (1) count total
--             samples (pop_size), (2) compute, for every common autosomal variant
--             (AF ≥ 0.05), how many samples within that super‑population carry at
--             least one alternate allele (n_carriers), and (3) build a histogram
--             showing how many variants fall into each n_carriers bucket
--             (variants_shared_by_that_many).  The flag is_common_AF_ge_0_05 is
--             always TRUE because the filter enforces the AF threshold.
WITH pop_size AS (
  SELECT
    Super_Population,
    COUNT(*) AS pop_size
  FROM
    `genomics-public-data.1000_genomes.sample_info`
  GROUP BY
    Super_Population
),
var_carriers AS (
  SELECT
    v.reference_name,
    v.start,
    s.Super_Population,
    COUNT(DISTINCT c.call_set_name) AS n_carriers
  FROM
    `genomics-public-data.1000_genomes.variants` AS v
  JOIN
    UNNEST(v.call) AS c
  JOIN
    `genomics-public-data.1000_genomes.sample_info` AS s
  ON
    s.Sample = c.call_set_name
  WHERE
    v.reference_name NOT IN ('X', 'Y', 'MT')            -- autosomal only
    AND v.AF >= 0.05                                     -- common variants
    AND EXISTS (SELECT g FROM UNNEST(c.genotype) AS g    -- carrier has alt allele
                WHERE g > 0)
  GROUP BY
    v.reference_name,
    v.start,
    s.Super_Population
)
SELECT
  vc.Super_Population,
  ps.pop_size,
  TRUE  AS is_common_AF_ge_0_05,
  vc.n_carriers AS samples_with_variant,
  COUNT(*)      AS variants_shared_by_that_many
FROM
  var_carriers AS vc
JOIN
  pop_size     AS ps
ON
  vc.Super_Population = ps.Super_Population
GROUP BY
  vc.Super_Population,
  ps.pop_size,
  vc.n_carriers
ORDER BY
  vc.Super_Population,
  vc.n_carriers
LIMIT 20;
