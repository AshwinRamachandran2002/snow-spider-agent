  JOIN UNNEST(v.call)            AS c                                    -- per‑sample calls
  JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS s
    ON s.sample = c.name                                                 -- map call → metadata
  WHERE SAFE_CAST(v.reference_name AS INT64) BETWEEN 1 AND 22            -- autosomes only
    AND ab.AF >= 0.05                                                    -- common variants
    AND (SELECT COUNTIF(g > 0) FROM UNNEST(c.genotype) AS g) > 0         -- carrier of ALT
  GROUP BY v.reference_name, v.start_position, s.super_population
)
SELECT
  pv.super_population,
  ps.population_size,
  TRUE  AS is_common_variant,                 -- AF filter ensures common status
  pv.sample_count_sharing_variant             AS sample_count_sharing_variant,
  COUNT(*)                                    AS variant_count
FROM per_variant AS pv
JOIN pop_size    AS ps
  ON ps.super_population = pv.super_population
GROUP BY
  pv.super_population,
  ps.population_size,
  is_common_variant,
  pv.sample_count_sharing_variant
ORDER BY
  pv.super_population,
  pv.sample_count_sharing_variant;
