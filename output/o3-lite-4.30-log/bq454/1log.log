```sql
--Description: Join each sample call that carries ≥ 1 ALT allele to its super‑population
-- Strategy:
--   • Unnest `alternate_bases` as ab to access AF and filter for common variants (AF ≥ 0.05).
--   • Unnest `call` as c to reach per‑sample genotype data.
--   • Keep autosomal chromosomes (1‑22) via SAFE_CAST on `reference_name`.
--   • Retain only calls where at least one allele index > 0, meaning the sample
--     carries an alternate allele.
--   • Join to the public sample‑metadata table to fetch the super‑population.
SELECT
  v.reference_name,
  v.start_position,
  c.name              AS sample_name,
  s.super_population
FROM
  `bigquery-public-data.human_genome_variants.1000_genomes_phase_3_variants_20150220` AS v
JOIN UNNEST(v.alternate_bases) AS ab
JOIN UNNEST(v.call)            AS c
JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS s
  ON s.sample = c.name
WHERE SAFE_CAST(v.reference_name AS INT64) BETWEEN 1 AND 22
  AND ab.AF >= 0.05
  AND (SELECT COUNTIF(g > 0) FROM UNNEST(c.genotype) AS g) > 0
LIMIT 20;
```

```sql
--Description: For every variant & super‑population, count how many samples have ≥ 1 ALT allele
-- (Uses the same AF filter logic as above, aggregating by variant and super‑population.)
SELECT
  v.reference_name,
  v.start_position,
  s.super_population,
  COUNT(*) AS n_samples_with_alt
FROM
  `bigquery-public-data.human_genome_variants.1000_genomes_phase_3_variants_20150220` AS v
JOIN UNNEST(v.alternate_bases) AS ab
JOIN UNNEST(v.call)            AS c
JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS s
  ON s.sample = c.name
WHERE SAFE_CAST(v.reference_name AS INT64) BETWEEN 1 AND 22
  AND ab.AF >= 0.05
  AND (SELECT COUNTIF(g > 0) FROM UNNEST(c.genotype) AS g) > 0
GROUP BY
  v.reference_name,
  v.start_position,
  s.super_population
LIMIT 20;
```

```sql
--Description: For each super‑population, bucket variants by the number of samples that share them
WITH per_variant AS (
  SELECT
    v.reference_name,
    v.start_position,
    s.super_population,
    COUNT(*) AS n_samples_with_alt
  FROM
    `bigquery-public-data.human_genome_variants.1000_genomes_phase_3_variants_20150220` AS v
  JOIN UNNEST(v.alternate_bases) AS ab
  JOIN UNNEST(v.call)            AS c
  JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS s
    ON s.sample = c.name
  WHERE SAFE_CAST(v.reference_name AS INT64) BETWEEN 1 AND 22
    AND ab.AF >= 0.05
    AND (SELECT COUNTIF(g > 0) FROM UNNEST(c.genotype) AS g) > 0
  GROUP BY
    v.reference_name,
    v.start_position,
    s.super_population
)
SELECT
  super_population,
  n_samples_with_alt,
  COUNT(*) AS n_variants
FROM per_variant
GROUP BY super_population, n_samples_with_alt
ORDER BY super_population, n_samples_with_alt
LIMIT 20;
```

```sql
--Description: Add population size & a “Common” flag; count variants by samples‑sharing bin
WITH pop_size AS (
  SELECT
    super_population,
    COUNT(*) AS pop_total
  FROM `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`
  GROUP BY super_population
),
per_variant AS (
  SELECT
    v.reference_name,
    v.start_position,
    TRUE                    AS is_common,      -- AF filter ensures common status
    s.super_population,
    COUNT(*) AS n_samples_with_alt
  FROM
    `bigquery-public-data.human_genome_variants.1000_genomes_phase_3_variants_20150220` AS v
  JOIN UNNEST(v.alternate_bases) AS ab
  JOIN UNNEST(v.call)            AS c
  JOIN `bigquery-public-data.human_genome_variants.1000_genomes_sample_info` AS s
    ON s.sample = c.name
  WHERE SAFE_CAST(v.reference_name AS INT64) BETWEEN 1 AND 22
    AND ab.AF >= 0.05
    AND (SELECT COUNTIF(g > 0) FROM UNNEST(c.genotype) AS g) > 0
  GROUP BY v.reference_name, v.start_position, s.super_population
)
SELECT
  pv.super_population,
  ps.pop_total                 AS population_size,
  pv.is_common                 AS common_variant,
  pv.n_samples_with_alt        AS samples_sharing_variant,
  COUNT(*)                     AS variants_count
FROM per_variant AS pv
JOIN pop_size    AS ps
  ON ps.super_population = pv.super_population
GROUP BY
  pv.super_population,
  ps.pop_total,
  pv.is_common,
  pv.n_samples_with_alt
ORDER BY
  pv.super_population,
  pv.n_samples_with_alt
LIMIT 20;
```
