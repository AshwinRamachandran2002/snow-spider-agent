WITH pop_size AS (
  -- total number of samples in each super‑population
  SELECT
    `Super_Population`                 AS super_population,
    COUNT(*)                           AS population_size
  FROM `spider2-public-data.1000_genomes.sample_info`
  GROUP BY super_population
),
per_variant AS (
  -- for every autosomal, common (AF ≥ 0.05) variant, count how many
  -- samples in each super‑population carry ≥1 alternate allele
  SELECT
    v.`reference_name`,
    v.`start`,
    s.`Super_Population`               AS super_population,
    COUNT(*)                           AS sample_count_sharing_variant
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.`call`) AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.`Sample` = c.`call_set_name`
  WHERE SAFE_CAST(v.`reference_name` AS INT64) BETWEEN 1 AND 22    -- autosomes only
    AND v.`AF` >= 0.05                                             -- common variants
    -- keep only samples with at least one ALT allele
    AND (SELECT COUNTIF(g > 0) FROM UNNEST(c.genotype) AS g) > 0
  GROUP BY v.`reference_name`, v.`start`, super_population
)
SELECT
