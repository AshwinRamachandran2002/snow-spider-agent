Begin Exploring Related Columns
Below are 10 exploratory‑to‑analytic queries that gradually build the logic required for the requested analysis.  
(Replace or remove the `LIMIT 20` clauses when you are ready to run the full workflow.)

```sql
-- 1. Description: List all super‑population codes that exist in the sample_info
SELECT DISTINCT `Super_Population`
FROM `spider2-public-data.1000_genomes.sample_info`
LIMIT 20;
```

```sql
-- 2. Description: Count of samples (population size) for every super‑population
SELECT
  `Super_Population`,
  COUNT(*) AS pop_size
FROM `spider2-public-data.1000_genomes.sample_info`
GROUP BY `Super_Population`
LIMIT 20;
```

```sql
-- 3. Description: See the distinct chromosome (reference_name) values that occur in the variants table
SELECT DISTINCT `reference_name`
FROM `spider2-public-data.1000_genomes.variants`
LIMIT 20;
```

```sql
-- 4. Description: Simple count of variants on each AUTOSOMAL chromosome only (1‑22)
SELECT
  `reference_name`,
  COUNT(*) AS variant_cnt
FROM `spider2-public-data.1000_genomes.variants`
WHERE `reference_name` IN UNNEST(GENERATE_ARRAY(1,22))
GROUP BY `reference_name`
ORDER BY `reference_name`
LIMIT 20;
```

```sql
-- 5. Description: Inspect how a call record looks (chromosome 1, first 20 rows)
SELECT
  `reference_name`,
  `start`,
  c.call_set_name      AS sample_id,
  c.genotype           AS gt
FROM `spider2-public-data.1000_genomes.variants`,
     UNNEST(`call`) AS c
WHERE `reference_name` = '1'
LIMIT 20;
```

```sql
-- 6. Description: Autosomal variants whose overall allele‑frequency (AF) >= 0.05
SELECT
  `reference_name`,
  `start`,
  `AF`
FROM `spider2-public-data.1000_genomes.variants`
WHERE `reference_name` IN UNNEST(GENERATE_ARRAY(1,22))
  AND `AF` >= 0.05
LIMIT 20;
```

```sql
-- 7. Description: Join each sample call that carries ≥1 ALT allele to its super‑population
SELECT
  v.`reference_name`,
  v.`start`,
  c.call_set_name        AS sample_id,
  s.`Super_Population`
FROM `spider2-public-data.1000_genomes.variants` AS v
JOIN UNNEST(v.`call`) AS c
JOIN `spider2-public-data.1000_genomes.sample_info` AS s
  ON s.`Sample` = c.call_set_name
WHERE v.`reference_name` IN UNNEST(GENERATE_ARRAY(1,22))
  AND v.`AF` >= 0.05
  -- keep only samples with a non‑reference allele
  AND (SELECT COUNTIF(g > 0) FROM UNNEST(c.genotype) AS g) > 0
LIMIT 20;
```

```sql
-- 8. Description: For every variant & super‑population, count how many samples have ≥1 ALT allele
SELECT
  v.`reference_name`,
  v.`start`,
  v.`AF`,
  s.`Super_Population`,
  COUNT(*) AS n_samples_with_alt
FROM `spider2-public-data.1000_genomes.variants` AS v
JOIN UNNEST(v.`call`) AS c
JOIN `spider2-public-data.1000_genomes.sample_info` AS s
  ON s.`Sample` = c.call_set_name
WHERE v.`reference_name` IN UNNEST(GENERATE_ARRAY(1,22))
  AND v.`AF` >= 0.05
  AND (SELECT COUNTIF(g > 0) FROM UNNEST(c.genotype) AS g) > 0
GROUP BY v.`reference_name`, v.`start`, v.`AF`, s.`Super_Population`
LIMIT 20;
```

```sql
-- 9. Description: For each super‑population, bucket variants by the number of samples that share them
WITH per_variant AS (
  SELECT
    v.`reference_name`,
    v.`start`,
    s.`Super_Population`,
    COUNT(*) AS n_samples_with_alt
  FROM `spider2-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.`call`) AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.`Sample` = c.call_set_name
  WHERE v.`reference_name` IN UNNEST(GENERATE_ARRAY(1,22))
    AND v.`AF` >= 0.05
    AND (SELECT COUNTIF(g > 0) FROM UNNEST(c.genotype) AS g) > 0
  GROUP BY v.`reference_name`, v.`start`, s.`Super_Population`
)
SELECT
  `Super_Population`,
  n_samples_with_alt,
  COUNT(*) AS n_variants
FROM per_variant
GROUP BY `Super_Population`, n_samples_with_alt
ORDER BY `Super_Population`, n_samples_with_alt
LIMIT 20;
```

```sql
-- 10. Description (FINAL): Add population size & a “Common” flag; count variants by samples‑sharing bin
WITH pop_size AS (
  SELECT `Super_Population`, COUNT(*) AS pop_total
  FROM `spider2-public-data.1000_genomes.sample_info`
  GROUP BY `Super_Population`
),
per_variant AS (
  SELECT
    v.`reference_name`,
    v.`start`,
    v.`AF` >= 0.05 AS is_common,
    s.`Super_Population`,
    COUNT(*) AS n_samples_with_alt
  FROM `spider2-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.`call`) AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.`Sample` = c.call_set_name
  WHERE v.`reference_name` IN UNNEST(GENERATE_ARRAY(1,22))    -- autosomes only
    AND v.`AF` >= 0.05                                         -- common variants only
    AND (SELECT COUNTIF(g > 0) FROM UNNEST(c.genotype) AS g) > 0
  GROUP BY v.`reference_name`, v.`start`, is_common, s.`Super_Population`
)
SELECT
  pv.`Super_Population`,
  ps.pop_total                      AS population_size,
  pv.is_common                      AS common_variant,   -- always TRUE in this filtered run
  pv.n_samples_with_alt             AS samples_sharing_variant,
  COUNT(*)                          AS variants_count
FROM per_variant AS pv
JOIN pop_size  AS ps
  ON ps.`Super_Population` = pv.`Super_Population`
GROUP BY pv.`Super_Population`,
         ps.pop_total,
         pv.is_common,
         pv.n_samples_with_alt
ORDER BY pv.`Super_Population`,
         pv.n_samples_with_alt
LIMIT 20;
```

Column relevance recap  
• sample_info.Super_Population: identify each sample’s super‑population  
• sample_info.Sample            : (primary key) to join with calls  
• variants.reference_name       : to restrict to chromosomes 1‑22 (autosomes)  
• variants.AF                   : allele‑frequency; filter for ≥0.05 (common)  
• variants.call[...]            : ARRAY of per‑sample genotypes; check for any ALT allele (>0)  
• pop_size.pop_total            : total population size per super‑population  
• Aggregated counts             : (# samples that share a variant) vs (# variants)

These queries can be executed sequentially—adjust or remove the `LIMIT` clauses when you run the full analysis.
