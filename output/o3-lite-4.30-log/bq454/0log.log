  FROM
    `genomics-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  JOIN
    `genomics-public-data.1000_genomes.sample_info` AS s
  ON
    s.Sample = c.call_set_name
  WHERE
    reference_name NOT IN ('X','Y','MT')
    AND (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) > 0
  GROUP BY
    reference_name, start, s.Super_Population
)
SELECT
  pv.Super_Population,
  pv.carriers_in_pop,
  COUNT(*) AS variants_with_that_carrier_count
FROM
  per_variant AS pv
JOIN
  pop_sizes  AS ps
ON
  ps.Super_Population = pv.Super_Population
WHERE
  pv.carriers_in_pop / (2 * ps.pop_size) >= 0.05   -- common variants only
GROUP BY
  pv.Super_Population, pv.carriers_in_pop
ORDER BY
  pv.Super_Population, pv.carriers_in_pop
LIMIT 20;
