```sql
--Description: Inspect the call structure for a handful of autosomal variants, showing
--             sample ID and the raw genotype array for each call.  The column `end`
--             is a SQL keyword, so it is wrapped in back‑ticks and aliased.
SELECT
  reference_name,
  start,
  `end` AS end_position,
  c.call_set_name,
  c.genotype
FROM
  `genomics-public-data.1000_genomes.variants`,
  UNNEST(call) AS c
WHERE
  reference_name NOT IN ('X','Y','MT')
LIMIT 20;
```

```sql
--Description: For 20 autosomal variants, count how many distinct samples carry at least
--             one alternate allele (i.e., any genotype entry > 0).
SELECT
  reference_name,
  start,
  COUNT(DISTINCT c.call_set_name) AS carrier_count
FROM
  `genomics-public-data.1000_genomes.variants`,
  UNNEST(call) AS c
WHERE
  reference_name NOT IN ('X','Y','MT')
  AND (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) > 0
GROUP BY
  reference_name, start
LIMIT 20;
```

```sql
--Description: Join variant calls to sample metadata to learn the super‑population
--             for each sample observed in the calls.
SELECT
  c.call_set_name,
  s.Super_Population
FROM
  `genomics-public-data.1000_genomes.variants`,
  UNNEST(call) AS c
JOIN
  `genomics-public-data.1000_genomes.sample_info` AS s
ON
  s.Sample = c.call_set_name
WHERE
  reference_name NOT IN ('X','Y','MT')
LIMIT 20;
```

```sql
--Description: For every autosomal variant, count how many carriers it has within
--             each super‑population.
SELECT
  reference_name,
  start,
  s.Super_Population,
  COUNT(DISTINCT c.call_set_name) AS carriers_in_pop
FROM
  `genomics-public-data.1000_genomes.variants`,
  UNNEST(call) AS c
JOIN
  `genomics-public-data.1000_genomes.sample_info` AS s
ON
  s.Sample = c.call_set_name
WHERE
  reference_name NOT IN ('X','Y','MT')
  AND (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) > 0
GROUP BY
  reference_name, start, s.Super_Population
LIMIT 20;
```

```sql
--Description: Compute empirical allele frequency per variant within each
--             super‑population by combining carrier counts with population size.
WITH pop_sizes AS (
  SELECT
    Super_Population,
    COUNT(*) AS pop_size
  FROM
    `genomics-public-data.1000_genomes.sample_info`
  GROUP BY
    Super_Population
),
per_variant AS (
  SELECT
    reference_name,
    start,
    s.Super_Population,
    COUNT(DISTINCT c.call_set_name) AS carriers_in_pop
  FROM
    `genomics-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  JOIN
    `genomics-public-data.1000_genomes.sample_info` AS s
  ON
    s.Sample = c.call_set_name
  WHERE
    reference_name NOT IN ('X','Y','MT')
    AND (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) > 0
  GROUP BY
    reference_name, start, s.Super_Population
)
SELECT
  v.reference_name,
  v.start,
  v.Super_Population,
  v.carriers_in_pop,
  p.pop_size,
  ROUND(v.carriers_in_pop / (2 * p.pop_size), 4) AS empirical_AF
FROM
  per_variant AS v
JOIN
  pop_sizes AS p
ON
  p.Super_Population = v.Super_Population
LIMIT 20;
```

```sql
--Description: Build a histogram, per super‑population, of how many common variants
--             (empirical AF ≥ 0.05) are shared by exactly N carriers.
WITH pop_sizes AS (
  SELECT
    Super_Population,
    COUNT(*) AS pop_size
  FROM
    `genomics-public-data.1000_genomes.sample_info`
  GROUP BY
    Super_Population
),
per_variant AS (
  SELECT
    reference_name,
    start,
    s.Super_Population,
    COUNT(DISTINCT c.call_set_name) AS carriers_in_pop
  FROM
    `genomics-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  JOIN
    `genomics-public-data.1000_genomes.sample_info` AS s
  ON
    s.Sample = c.call_set_name
  WHERE
    reference_name NOT IN ('X','Y','MT')
    AND (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) > 0
  GROUP BY
    reference_name, start, s.Super_Population
)
SELECT
  pv.Super_Population,
  pv.carriers_in_pop,
  COUNT(*) AS variants_with_that_carrier_count
FROM
  per_variant AS pv
JOIN
  pop_sizes  AS ps
ON
  ps.Super_Population = pv.Super_Population
WHERE
  pv.carriers_in_pop / (2 * ps.pop_size) >= 0.05
GROUP BY
  pv.Super_Population, pv.carriers_in_pop
ORDER BY
  pv.Super_Population, pv.carriers_in_pop
LIMIT 20;
```

```sql
--Description: Final summary—within each super‑population, report population size,
--             carrier count per variant, a flag for commonness (AF ≥ 0.05), and
--             how many variants fall into each category.
WITH pop_sizes AS (
  SELECT
    Super_Population,
    COUNT(*) AS pop_size
  FROM
    `genomics-public-data.1000_genomes.sample_info`
  GROUP BY
    Super_Population
),
per_variant AS (
  SELECT
    reference_name,
    start,
    s.Super_Population,
    COUNT(DISTINCT c.call_set_name) AS carriers_in_pop
  FROM
    `genomics-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  JOIN
    `genomics-public-data.1000_genomes.sample_info` AS s
  ON
    s.Sample = c.call_set_name
  WHERE
    reference_name NOT IN ('X','Y','MT')
    AND (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) > 0
  GROUP BY
    reference_name, start, s.Super_Population
),
flagged AS (
  SELECT
    pv.*,
    ps.pop_size,
    pv.carriers_in_pop / (2 * ps.pop_size) >= 0.05 AS is_common
  FROM
    per_variant AS pv
  JOIN
    pop_sizes   AS ps
  ON
    ps.Super_Population = pv.Super_Population
)
SELECT
  Super_Population,
  pop_size,
  is_common,
  carriers_in_pop,
  COUNT(*) AS variants_count
FROM
  flagged
GROUP BY
  Super_Population, pop_size, is_common, carriers_in_pop
ORDER BY
  Super_Population, carriers_in_pop
LIMIT 20;
```
