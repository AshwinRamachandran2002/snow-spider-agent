```sql
--Description: Compute empirical allele frequency (AF) per variant within each
--             super‑population by adding pop‑size information.
WITH pop_sizes AS (
  SELECT
    Super_Population,
    COUNT(*) AS pop_size
  FROM
    `genomics-public-data.1000_genomes.sample_info`
  GROUP BY
    Super_Population
),
per_variant AS (
  SELECT
    reference_name,
    start,
    s.Super_Population,
    COUNT(DISTINCT c.call_set_name) AS carriers_in_pop
  FROM
    `genomics-public-data.1000_genomes.variants`,
    UNNEST(call) AS c
  JOIN
    `genomics-public-data.1000_genomes.sample_info` AS s
  ON
    s.Sample = c.call_set_name
  WHERE
    reference_name NOT IN ('X','Y','MT')
    AND (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) > 0
  GROUP BY
    reference_name, start, s.Super_Population
)
SELECT
  v.reference_name,
  v.start,
  v.Super_Population,
  v.carriers_in_pop,
  p.pop_size,
  ROUND(v.carriers_in_pop / (2 * p.pop_size), 4) AS empirical_AF
FROM
  per_variant AS v
JOIN
  pop_sizes   AS p
ON
  p.Super_Population = v.Super_Population
LIMIT 20;
