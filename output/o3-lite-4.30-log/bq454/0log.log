    s.Sample = c.call_set_name
  WHERE
    reference_name NOT IN ('X','Y','MT')
    AND (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) > 0
  GROUP BY
    reference_name, start, s.Super_Population
),
flagged AS (
  SELECT
    pv.*,
    ps.pop_size,
    pv.carriers_in_pop / (2 * ps.pop_size) >= 0.05 AS is_common
  FROM
    per_variant AS pv
  JOIN
    pop_sizes   AS ps
  ON
    ps.Super_Population = pv.Super_Population
)
SELECT
  Super_Population,
  pop_size,
  is_common,
  carriers_in_pop,
  COUNT(*) AS variants_count
FROM
  flagged
GROUP BY
  Super_Population, pop_size, is_common, carriers_in_pop
ORDER BY
  Super_Population, carriers_in_pop
LIMIT 20;
