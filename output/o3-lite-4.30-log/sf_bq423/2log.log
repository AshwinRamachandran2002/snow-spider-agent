```

```sql
-- 7. Description: Flatten region_stats for Croatian impressions and look at dates / availability flag
SELECT c."creative_id",
       r.value:"region_code"::STRING              AS "region_code",
       r.value:"first_shown"::DATE                AS "first_shown",
       r.value:"last_shown"::DATE                 AS "last_shown",
       r.value:"times_shown_availability_date"    AS "ts_avail_date"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS" c,
     LATERAL FLATTEN(input => PARSE_JSON(c."region_stats")) r
WHERE r.value:"region_code" = 'HR'
LIMIT 20;
```

```sql
-- 8. Description: Collect image Health ads that meet all time & availability constraints in Croatia
SELECT c."creative_id",
       c."creative_page_url",
       r.value:"first_shown"::DATE                AS "first_shown",
       r.value:"last_shown"::DATE                 AS "last_shown",
       r.value:"times_shown_upper_bound"::NUMBER  AS "ts_upper",
       r.value:"times_shown_availability_date"    AS "ts_avail_date"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS" c,
     LATERAL FLATTEN(input => PARSE_JSON(c."region_stats")) r
WHERE r.value:"region_code" = 'HR'
  AND r.value:"first_shown"::DATE  > '2023-01-01'
  AND r.value:"last_shown"::DATE   < '2024-01-01'
  AND r.value:"times_shown_availability_date" IS NULL
  AND c."ad_format_type" = 'IMAGE'
  AND c."topic" ILIKE '%Health%'
  AND c."advertiser_location" = 'CY'
  AND c."advertiser_verification_status" = 'VERIFIED'
LIMIT 20;
```

```sql
-- 9. Description: Attach audience selection filters to ensure no method is unused
SELECT c."creative_id",
       c."creative_page_url",
       r.value:"times_shown_upper_bound"::NUMBER AS "ts_upper"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS" c,
     LATERAL FLATTEN(input => PARSE_JSON(c."region_stats")) r
WHERE r.value:"region_code" = 'HR'
  AND r.value:"first_shown"::DATE  > '2023-01-01'
  AND r.value:"last_shown"::DATE   < '2024-01-01'
  AND r.value:"times_shown_availability_date" IS NULL
  AND c."ad_format_type" = 'IMAGE'
  AND c."topic" ILIKE '%Health%'
  AND c."advertiser_location" = 'CY'
  AND c."advertiser_verification_status" = 'VERIFIED'
  AND PARSE_JSON(c."audience_selection_approach_info"):"demographic_info"    <> 'NOT_USED'
  AND PARSE_JSON(c."audience_selection_approach_info"):"geo_location"        <> 'NOT_USED'
  AND PARSE_JSON(c."audience_selection_approach_info"):"contextual_signals"  <> 'NOT_USED'
  AND PARSE_JSON(c."audience_selection_approach_info"):"customer_lists"      <> 'NOT_USED'
  AND PARSE_JSON(c."audience_selection_approach_info"):"topics"              <> 'NOT_USED'
LIMIT 20;
```

```sql
--10. Description: Final query – pick the Croatian Health image ad (Cyprus advertiser, verified, etc.)
--                 with the highest upper bound of times shown and return its creative_page_url
SELECT c."creative_page_url"
FROM "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS" c,
     LATERAL FLATTEN(input => PARSE_JSON(c."region_stats")) r
WHERE r.value:"region_code" = 'HR'
  AND r.value:"first_shown"::DATE  > '2023-01-01'
  AND r.value:"last_shown"::DATE   < '2024-01-01'
  AND r.value:"times_shown_availability_date" IS NULL
  AND c."ad_format_type" = 'IMAGE'
  AND c."topic" ILIKE '%Health%'
  AND c."advertiser_location" = 'CY'
  AND c."advertiser_verification_status" = 'VERIFIED'
  AND PARSE_JSON(c."audience_selection_approach_info"):"demographic_info"    <> 'NOT_USED'
  AND PARSE_JSON(c."audience_selection_approach_info"):"geo_location"        <> 'NOT_USED'
  AND PARSE_JSON(c."audience_selection_approach_info"):"contextual_signals"  <> 'NOT_USED'
  AND PARSE_JSON(c."audience_selection_approach_info"):"customer_lists"      <> 'NOT_USED'
  AND PARSE_JSON(c."audience_selection_approach_info"):"topics"              <> 'NOT_USED'
ORDER BY r.value:"times_shown_upper_bound"::NUMBER DESC
LIMIT 1;
```

