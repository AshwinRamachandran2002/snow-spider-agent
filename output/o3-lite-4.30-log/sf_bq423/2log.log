--Description: Identify image‑type Health ads from Cyprus‑based, verified advertisers
--             that were displayed in Croatia during 2023 (first_shown > 2023‑01‑01 and
--             last_shown < 2024‑01‑01) and whose impression numbers are already
--             available (times_shown_availability_date IS NULL).  In addition, confirm
--             that every audience‑selection method (demographic_info, geo_location,
--             contextual_signals, customer_lists, topics_of_interest) was actually
--             USED (≠ 'CRITERIA_UNUSED').  Finally order by the Croatian
--             times_shown_upper_bound to see the most‑shown creative on top.
SELECT
       c."creative_page_url",
       c."creative_id",
       r.value:"times_shown_upper_bound"::NUMBER AS "ts_upper",
       r.value:"first_shown"::DATE              AS "first_shown",
       r.value:"last_shown"::DATE               AS "last_shown"
FROM   "GOOGLE_ADS"."GOOGLE_ADS_TRANSPARENCY_CENTER"."CREATIVE_STATS"  c,
       LATERAL FLATTEN(input => PARSE_JSON(c."region_stats"))           r
WHERE  r.value:"region_code" = 'HR'                                            -- Croatia
  AND  r.value:"first_shown"::DATE  > '2023-01-01'                             -- after Jan‑1‑23
  AND  r.value:"last_shown"::DATE   < '2024-01-01'                             -- before Jan‑1‑24
  AND  r.value:"times_shown_availability_date" IS NULL                         -- data available
  AND  c."ad_format_type"                 = 'IMAGE'                            -- image ads
  AND  c."topic"                           ILIKE '%Health%'                    -- Health topic
  AND  c."advertiser_location"             = 'CY'                              -- Cyprus advertiser
  AND  c."advertiser_verification_status"  = 'VERIFIED'                        -- verified
  AND  PARSE_JSON(c."audience_selection_approach_info"):"demographic_info"::STRING    <> 'CRITERIA_UNUSED'
  AND  PARSE_JSON(c."audience_selection_approach_info"):"geo_location"::STRING        <> 'CRITERIA_UNUSED'
  AND  PARSE_JSON(c."audience_selection_approach_info"):"contextual_signals"::STRING  <> 'CRITERIA_UNUSED'
  AND  PARSE_JSON(c."audience_selection_approach_info"):"customer_lists"::STRING      <> 'CRITERIA_UNUSED'
  AND  PARSE_JSON(c."audience_selection_approach_info"):"topics_of_interest"::STRING  <> 'CRITERIA_UNUSED'
ORDER BY "ts_upper" DESC
LIMIT 20;
```
