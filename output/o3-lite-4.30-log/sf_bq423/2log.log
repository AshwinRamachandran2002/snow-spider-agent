2. "topic" ILIKE '%Health%'  
3. "advertiser_verification_status" = 'VERIFIED'  
4. "advertiser_location" = 'CY'  
5. JSON inside "audience_selection_approach_info" shows every required method not equal to 'NOT_USED'  
6. JSON inside "region_stats" has a row whose "region_code" = 'HR', "times_shown_availability_date" IS NULL, "first_shown" > '2023‑01‑01', "last_shown" < '2024‑01‑01'  
