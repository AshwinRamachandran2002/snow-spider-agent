```

```sql
-- 6. Description: Check which Cyprus‑based image ads satisfy every audience selection criterion
SELECT "creative_id",
       PARSE_JSON("audience_selection_approach_info"):"demographic_info"      AS "demographic_info",
       PARSE_JSON("audience_selection_approach_info"):"geo_location"          AS "geo_location",
       PARSE_JSON("audience_selection_approach_info"):"contextual_signals"    AS "contextual_signals",
       PARSE_JSON("audience_selection_approach_info"):"customer_lists"        AS "customer_lists",
       PARSE_JSON("audience_selection_approach_info"):"topics"                AS "topics"
