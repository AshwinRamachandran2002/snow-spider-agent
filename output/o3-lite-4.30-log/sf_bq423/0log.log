```sql
--Thinking process:
--• Goal → keep only ads where every required audience‑selection method is actually used.
--• Column audience_selection_approach_info is VARIANT, so we can pull each key with the : operator.
--• If a key is missing (NULL) or set to the literal string 'UNUSED', that method is not used → exclude.
--• COALESCE(value , 'UNUSED') converts a missing key to 'UNUSED', allowing a single comparison <> 'UNUSED'.
--• Return creative_id plus the raw JSON column so we can visually inspect the values; limit 20 rows.
SELECT  "creative_id",
        "audience_selection_approach_info"
FROM    GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER."CREATIVE_STATS"
WHERE   COALESCE("audience_selection_approach_info":"demographic_info"::STRING     , 'UNUSED') <> 'UNUSED'
  AND   COALESCE("audience_selection_approach_info":"geo_location"::STRING        , 'UNUSED') <> 'UNUSED'
  AND   COALESCE("audience_selection_approach_info":"contextual_signals"::STRING  , 'UNUSED') <> 'UNUSED'
  AND   COALESCE("audience_selection_approach_info":"customer_lists"::STRING      , 'UNUSED') <> 'UNUSED'
  AND   COALESCE("audience_selection_approach_info":"topics_of_interest"::STRING  , 'UNUSED') <> 'UNUSED'
LIMIT 20;
