Query:
--10. Description: Final query – Health IMAGE ad from Cyprus verified advertiser, served in Croatia (HR),
--                  correct date window, times_shown data available, all targeting methods used.
--                  Retrieves the creative_page_url having highest times_shown_upper_bound
SELECT t."creative_page_url"
FROM GOOGLE_ADS.GOOGLE_ADS_TRANSPARENCY_CENTER.CREATIVE_STATS t,
     LATERAL FLATTEN(input => t."region_stats"::VARIANT) r,
     LATERAL FLATTEN(input => ARRAY_CONSTRUCT(t."audience_selection_approach_info"::VARIANT)) a
WHERE t."topic" ILIKE '%health%'
  AND t."ad_format_type" = 'IMAGE'
  AND t."advertiser_verification_status" = 'VERIFIED'
  AND t."advertiser_location" = 'CY'
  -- Region filters
  AND r.value:"region_code"::STRING = 'HR'
  AND r.value:"first_shown"::DATE > '2023-01-01'
  AND r.value:"last_shown" ::DATE < '2024-01-01'
  AND r.value:"times_shown_availability_date" IS NULL
  -- Targeting methods must not be UNUSED
  AND (a.value:"demographic_info"::STRING     ILIKE '%UNUSED%')        = FALSE
  AND (a.value:"geo_location"::STRING         ILIKE '%UNUSED%')        = FALSE
  AND (a.value:"contextual_signals"::STRING   ILIKE '%UNUSED%')        = FALSE
  AND (a.value:"customer_lists"::STRING       ILIKE '%UNUSED%')        = FALSE
  AND (a.value:"topics_of_interest"::STRING   ILIKE '%UNUSED%')        = FALSE
ORDER BY r.value:"times_shown_upper_bound"::NUMBER DESC
LIMIT 1;
