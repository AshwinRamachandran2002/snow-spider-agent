        MAX(TRY_CAST("Exposure"       AS FLOAT)) - MIN(TRY_CAST("Exposure"       AS FLOAT)) AS exposure_diff
    FROM ct_nlst
    GROUP BY "PatientID", "SeriesInstanceUID"
),
per_patient AS (     -- aggregate to patient level
    SELECT
