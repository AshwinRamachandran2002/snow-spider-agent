        AVG(series_size_mib)                                                     AS avg_series_size_mib,
        MAX(slice_diff)    - MIN(slice_diff)                                     AS slice_interval_tolerance,
        MAX(exposure_diff) - MIN(exposure_diff)                                  AS exposure_tolerance
    FROM per_series
    GROUP BY "PatientID"
),
avg_top_slice AS (   -- average series size of top‑3 patients by slice‑interval tolerance
