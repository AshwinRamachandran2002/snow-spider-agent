FROM IDC.IDC_V17.DICOM_ALL
WHERE "collection_id" = 'nlst'
LIMIT 20;
```

```sql
-- 3) Description: Peek at a handful of NLST–CT rows, focusing on patient & series identifiers.
SELECT 
  "PatientID",
  "SeriesInstanceUID",
  "StudyInstanceUID",
  "instance_size"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "collection_id" = 'nlst'
  AND "Modality" = 'CT'
LIMIT 20;
```

```sql
-- 4) Description: Explore raw distinct values of SpacingBetweenSlices for NLST CT images.
SELECT DISTINCT "SpacingBetweenSlices"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "collection_id" = 'nlst'
  AND "Modality" = 'CT'
  AND "SpacingBetweenSlices" IS NOT NULL
LIMIT 20;
```

```sql
-- 5) Description: Show numeric conversion test of SpacingBetweenSlices (NULL means bad/blank rows).
SELECT 
  "SpacingBetweenSlices",
  TRY_CAST("SpacingBetweenSlices" AS FLOAT)   AS "spacing_mm"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "collection_id" = 'nlst'
  AND "Modality" = 'CT'
  AND "SpacingBetweenSlices" IS NOT NULL
LIMIT 20;
```

```sql
-- 6) Description: Explore distinct Exposure values (raw) for NLST CT images.
SELECT DISTINCT "Exposure"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "collection_id" = 'nlst'
  AND "Modality" = 'CT'
  AND "Exposure" IS NOT NULL
LIMIT 20;
```

```sql
-- 7) Description: Show Exposure after safe numeric cast for sanity check.
SELECT 
  "Exposure",
  TRY_CAST("Exposure" AS FLOAT) AS "exposure_numeric"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "collection_id" = 'nlst'
  AND "Modality" = 'CT'
  AND "Exposure" IS NOT NULL
LIMIT 20;
```

```sql
-- 8) Description: Compute min & max numeric SpacingBetweenSlices and their difference at series level.
SELECT 
  "SeriesInstanceUID",
  MIN(TRY_CAST("SpacingBetweenSlices" AS FLOAT)) AS "min_spacing",
  MAX(TRY_CAST("SpacingBetweenSlices" AS FLOAT)) AS "max_spacing",
  MAX(TRY_CAST("SpacingBetweenSlices" AS FLOAT)) 
    - MIN(TRY_CAST("SpacingBetweenSlices" AS FLOAT)) AS "spacing_diff"
FROM IDC.IDC_V17.DICOM_ALL
WHERE "collection_id" = 'nlst'
  AND "Modality" = 'CT'
  AND TRY_CAST("SpacingBetweenSlices" AS FLOAT) IS NOT NULL
GROUP BY "SeriesInstanceUID"
LIMIT 20;
```

```sql
-- 9) Description: Aggregate those series‑level spacing differences up to patient level.
SELECT
  "PatientID",
  MIN(series_stats."spacing_diff") AS "min_series_spacing_diff",
  MAX(series_stats."spacing_diff") AS "max_series_spacing_diff",
  MAX(series_stats."spacing_diff") - MIN(series_stats."spacing_diff") AS "slice_interval_tolerance"
FROM (
  SELECT 
    "PatientID",
    "SeriesInstanceUID",
    MAX(TRY_CAST("SpacingBetweenSlices" AS FLOAT))
      - MIN(TRY_CAST("SpacingBetweenSlices" AS FLOAT)) AS "spacing_diff"
  FROM IDC.IDC_V17.DICOM_ALL
  WHERE "collection_id" = 'nlst'
    AND "Modality" = 'CT'
    AND TRY_CAST("SpacingBetweenSlices" AS FLOAT) IS NOT NULL
  GROUP BY "PatientID", "SeriesInstanceUID"
) series_stats
GROUP BY "PatientID"
ORDER BY "slice_interval_tolerance" DESC
LIMIT 20;
```

```sql
-- 10) Description: Single query blueprint that produces both requested metrics:
--   * top‑3 patients by slice‑interval tolerance
--   * top‑3 patients by exposure range
-- It also calculates average series size (MiB) per patient.
-- NOTE: This blueprint is limited to 20 rows merely for sampling;
-- remove LIMIT to get the full result set when running for real.
WITH ct_nlst AS (
  SELECT *
  FROM IDC.IDC_V17.DICOM_ALL
  WHERE "collection_id" = 'nlst'
    AND "Modality" = 'CT'
),
per_series AS (
  SELECT
    "PatientID",
    "SeriesInstanceUID",
    SUM("instance_size")/1048576.0                           AS "series_size_MiB",
    MAX(TRY_CAST("SpacingBetweenSlices" AS FLOAT))
      - MIN(TRY_CAST("SpacingBetweenSlices" AS FLOAT))       AS "series_spacing_diff",
    MAX(TRY_CAST("Exposure"            AS FLOAT))
      - MIN(TRY_CAST("Exposure"        AS FLOAT))            AS "series_exposure_diff"
  FROM ct_nlst
  GROUP BY "PatientID", "SeriesInstanceUID"
),
per_patient AS (
  SELECT
    "PatientID",
    AVG("series_size_MiB")                                   AS "avg_series_size_MiB",
    MAX("series_spacing_diff") - MIN("series_spacing_diff")  AS "slice_interval_tolerance",
    MAX("series_exposure_diff") - MIN("series_exposure_diff")AS "exposure_tolerance"
  FROM per_series
  GROUP BY "PatientID"
)
SELECT 
  'Top 3 by Slice Interval'       AS "group_label",
  "PatientID",
  "avg_series_size_MiB"
FROM per_patient
QUALIFY ROW_NUMBER() OVER (ORDER BY "slice_interval_tolerance" DESC) <= 3

UNION ALL

SELECT 
  'Top 3 by Max Exposure'         AS "group_label",
  "PatientID",
  "avg_series_size_MiB"
FROM per_patient
QUALIFY ROW_NUMBER() OVER (ORDER BY "exposure_tolerance"   DESC) <= 3
LIMIT 20;
```

