--Description: 
-- 10) Complete blueprint query (now using SliceThickness instead of SpacingBetweenSlices) that
--     produces the requested two groups of patients and their average series size in MiB.
--     Limited to 20 rows for sampling; remove LIMIT for full result.
WITH ct_nlst AS (  -- base NLST CT data
  SELECT *
  FROM IDC.IDC_V17.DICOM_ALL
  WHERE "collection_id" = 'nlst'
    AND "Modality"      = 'CT'
), 
per_series AS (     -- metrics calculated per series
  SELECT
    "PatientID",
    "SeriesInstanceUID",
    SUM("instance_size")/1048576.0                           AS "series_size_MiB",
    MAX(TRY_CAST("SliceThickness" AS FLOAT))
      - MIN(TRY_CAST("SliceThickness" AS FLOAT))             AS "series_slice_diff",
    MAX(TRY_CAST("Exposure" AS FLOAT))
      - MIN(TRY_CAST("Exposure" AS FLOAT))                   AS "series_exposure_diff"
  FROM ct_nlst
  GROUP BY "PatientID", "SeriesInstanceUID"
),
per_patient AS (    -- aggregate to patient level
  SELECT
    "PatientID",
    AVG("series_size_MiB")                                   AS "avg_series_size_MiB",
    MAX("series_slice_diff") - MIN("series_slice_diff")      AS "slice_interval_tolerance",
    MAX("series_exposure_diff") - MIN("series_exposure_diff")AS "exposure_tolerance"
  FROM per_series
  GROUP BY "PatientID"
)
SELECT 
  'Top 3 by Slice Interval' AS "group_label",
  "PatientID",
  "avg_series_size_MiB"
FROM per_patient
QUALIFY ROW_NUMBER() OVER (ORDER BY "slice_interval_tolerance" DESC) <= 3

UNION ALL

SELECT 
  'Top 3 by Max Exposure'   AS "group_label",
  "PatientID",
  "avg_series_size_MiB"
FROM per_patient
QUALIFY ROW_NUMBER() OVER (ORDER BY "exposure_tolerance" DESC) <= 3
LIMIT 20
