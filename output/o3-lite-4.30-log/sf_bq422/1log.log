--Description: 
-- 9) Aggregate the series‑level slice thickness differences up to patient level.
SELECT
  "PatientID",
  MIN(series_stats."slice_thk_diff") AS "min_series_slice_diff",
  MAX(series_stats."slice_thk_diff") AS "max_series_slice_diff",
  MAX(series_stats."slice_thk_diff") - MIN(series_stats."slice_thk_diff") 
    AS "slice_interval_tolerance"
FROM (
  SELECT 
    "PatientID",
    "SeriesInstanceUID",
    MAX(TRY_CAST("SliceThickness" AS FLOAT))
      - MIN(TRY_CAST("SliceThickness" AS FLOAT)) AS "slice_thk_diff"
  FROM IDC.IDC_V17.DICOM_ALL
  WHERE "collection_id" = 'nlst'
    AND "Modality"      = 'CT'
    AND TRY_CAST("SliceThickness" AS FLOAT) IS NOT NULL
  GROUP BY "PatientID", "SeriesInstanceUID"
) series_stats
GROUP BY "PatientID"
ORDER BY "slice_interval_tolerance" DESC
LIMIT 20
