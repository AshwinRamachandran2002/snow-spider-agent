The table structure information is ({database name: {schema name: [table name]}}): 
{'GENOMICS_CANNABIS': {'GENOMICS_CANNABIS': ['MNPR01_REFERENCE_201703', 'MNPR01_TRANSCRIPTOME_201703', 'SAMPLE_INFO_201703', 'CS10_GFF', 'CS3K_PROJECT_INFO', 'CS3K_VCF_CS10_DV090', 'MNPR01_201703']}}
Begin Exploring Related Columns
Relevant columns and their possible roles  

• "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703"."name":  primary key for every reference sequence – join‑key to variant tables.  
• "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703"."length":  sequence length – denominator for a density calculation.  
• "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"."reference_name":  sequence identifier attached to every genomic‑variant – join‑key to reference table.  
• "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"."variant_id" (or any field, e.g. "start"): each row is one variant – allows us to count variants per reference sequence.  
• "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_TRANSCRIPTOME_201703"."reference_name":   same purpose when working with the transcriptome VCF (optional alternative source).

Typical conditions  
• Equality join between reference and variant tables on sequence name.  
• GROUP BY "reference_name" to count variants.  
• ORDER BY variant_count / length DESC to discover the sequence with highest variant density.

--------------------------------------------------------------------
Example Snowflake queries – from exploratory to the final answer
--------------------------------------------------------------------

```sql
-- 1. Peek at reference sequences and their lengths
SELECT 
    "name",
    "length"
FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703"
LIMIT 20;
```

```sql
-- 2. How many reference sequences are available?
SELECT 
    COUNT(*) AS "num_sequences"
FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703"
LIMIT 20;
```

```sql
-- 3. Show a sample of genomic variants to confirm column names
SELECT 
    "reference_name",
    "start",
    "end"
FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"
LIMIT 20;
```

```sql
-- 4. Distinct reference names that appear in the variant table
SELECT DISTINCT 
    "reference_name"
FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"
LIMIT 20;
```

```sql
-- 5. Top 20 reference sequences by raw variant count
SELECT 
    "reference_name",
    COUNT(*) AS "variant_count"
FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"
GROUP BY "reference_name"
ORDER BY "variant_count" DESC
LIMIT 20;
```

```sql
-- 6. Variant density (variants per base) using the genomic VCF
SELECT 
    r."name"                              AS "reference_name",
    COUNT(v."reference_name")             AS "variant_count",
    r."length",
    COUNT(v."reference_name") / r."length"::FLOAT AS "variant_density"
FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703"  r
LEFT JOIN "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"       v
       ON r."name" = v."reference_name"
GROUP BY r."name", r."length"
ORDER BY "variant_density" DESC
LIMIT 20;
```

```sql
-- 7. Same density calculation but scaled to variants per kilobase (Kb)
SELECT 
    r."name"                                                        AS "reference_name",
    COUNT(v."reference_name")                                       AS "variant_count",
    r."length",
    (COUNT(v."reference_name") / r."length"::FLOAT) * 1000          AS "variants_per_kb"
FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703"  r
LEFT JOIN "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"       v
       ON r."name" = v."reference_name"
GROUP BY r."name", r."length"
ORDER BY "variants_per_kb" DESC
LIMIT 20;
```

```sql
-- 8. Variant‑density calculation using the transcriptome VCF instead
SELECT 
    r."name"                              AS "reference_name",
    COUNT(t."reference_name")             AS "variant_count",
    r."length",
    COUNT(t."reference_name") / r."length"::FLOAT AS "variant_density"
FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703"      r
LEFT JOIN "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_TRANSCRIPTOME_201703" t
       ON r."name" = t."reference_name"
GROUP BY r."name", r."length"
ORDER BY "variant_density" DESC
LIMIT 20;
```

```sql
-- 9. Identify the single reference sequence with the highest genomic variant density
SELECT 
    r."name"                              AS "reference_name",
    COUNT(v."reference_name")             AS "variant_count",
    r."length",
    COUNT(v."reference_name") / r."length"::FLOAT AS "variant_density"
FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703"  r
LEFT JOIN "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"       v
       ON r."name" = v."reference_name"
GROUP BY r."name", r."length"
ORDER BY "variant_density" DESC
LIMIT 1;
```

```sql
-- 10. (Optional) Store the highest‑density reference in a temp table for downstream work
CREATE OR REPLACE TEMP TABLE highest_density_reference AS
SELECT 
    r."name",
    COUNT(v."reference_name") AS "variant_count",
    r."length",
    COUNT(v."reference_name") / r."length"::FLOAT AS "variant_density"
FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703"  r
LEFT JOIN "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"       v
       ON r."name" = v."reference_name"
GROUP BY r."name", r."length"
ORDER BY "variant_density" DESC
LIMIT 1;
```

