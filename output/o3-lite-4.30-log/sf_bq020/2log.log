Begin Exploring Related Columns
Relevant columns and their possible usage  

• MNPR01_201703."reference_name" : contig / reference sequence name found in every variant row – use to count how many variants fall on each reference sequence.  
• MNPR01_REFERENCE_201703."name" : contig / reference sequence name in the assembly – joins to the variant table.  
• MNPR01_REFERENCE_201703."length" : length of each reference sequence – denominator when computing variant‑per‑base (variant density).  

(Variant density = variant_count ÷ length)

Below are ten exploratory Snowflake SQL queries (in order from the simplest “what’s in this column?” to the final query that returns the reference sequence with the highest variant density).  
All identifiers are wrapped in double quotes, and every SELECT is capped with LIMIT 20 to stay lightweight while you explore.

```sql
-- 1) Peek at the first 20 reference sequences and their lengths
SELECT "name",
       "length"
FROM   "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703"
LIMIT  20;
```

```sql
-- 2) Inspect distinct reference names present in the main variant table
SELECT DISTINCT "reference_name"
FROM   "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"
LIMIT  20;
```

```sql
-- 3) Quick count of variants per reference sequence (raw numbers only)
SELECT   "reference_name",
         COUNT(*) AS "variant_count"
FROM     "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"
GROUP BY "reference_name"
ORDER BY "variant_count" DESC
LIMIT    20;
```

```sql
-- 4) Combine counts with contig length to see density (variants per bp)
SELECT   r."name",
         r."length",
         COUNT(v."reference_name") AS "variant_count",
         COUNT(v."reference_name") / r."length" AS "variant_density"
FROM     "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"  v
JOIN     "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703" r
       ON v."reference_name" = r."name"
GROUP BY r."name", r."length"
ORDER BY "variant_density" DESC
LIMIT    20;
```

```sql
-- 5) Same as #4 but show the *lowest* densities (to compare)
SELECT   r."name",
         r."length",
         COUNT(v."reference_name") AS "variant_count",
         COUNT(v."reference_name") / r."length" AS "variant_density"
FROM     "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"  v
JOIN     "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703" r
       ON v."reference_name" = r."name"
GROUP BY r."name", r."length"
ORDER BY "variant_density" ASC
LIMIT    20;
```

```sql
-- 6) Repeat #3 for the transcriptome‑specific variant table
SELECT   "reference_name",
         COUNT(*) AS "variant_count"
FROM     "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_TRANSCRIPTOME_201703"
GROUP BY "reference_name"
ORDER BY "variant_count" DESC
LIMIT    20;
```

```sql
-- 7) Compute variant density for the transcriptome dataset
SELECT   r."name",
         r."length",
         COUNT(t."reference_name") AS "variant_count",
         COUNT(t."reference_name") / r."length" AS "variant_density"
FROM     "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_TRANSCRIPTOME_201703" t
JOIN     "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703"      r
       ON t."reference_name" = r."name"
GROUP BY r."name", r."length"
ORDER BY "variant_density" DESC
LIMIT    20;
```

```sql
-- 8) Merge both variant tables to see an overall count per reference
WITH all_variants AS (
    SELECT "reference_name" FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"
    UNION ALL
    SELECT "reference_name" FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_TRANSCRIPTOME_201703"
)
SELECT   "reference_name",
         COUNT(*) AS "variant_count"
FROM     all_variants
GROUP BY "reference_name"
ORDER BY "variant_count" DESC
LIMIT    20;
```

```sql
-- 9) Overall variant density using the combined variant set (#8)  
WITH all_variants AS (
    SELECT "reference_name" FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"
    UNION ALL
    SELECT "reference_name" FROM "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_TRANSCRIPTOME_201703"
)
SELECT   r."name",
         r."length",
         COUNT(a."reference_name") AS "variant_count",
         COUNT(a."reference_name") / r."length" AS "variant_density"
FROM     all_variants a
JOIN     "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703" r
       ON a."reference_name" = r."name"
GROUP BY r."name", r."length"
ORDER BY "variant_density" DESC
LIMIT    20;
```

```sql
-- 10) FINAL: return only the reference sequence that has the highest variant density (main genome variant table)
SELECT   r."name"          AS "reference_sequence_with_highest_variant_density",
         r."length",
         COUNT(v."reference_name")                    AS "variant_count",
         COUNT(v."reference_name") / r."length"       AS "variant_density"
FROM     "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_201703"  v
JOIN     "GENOMICS_CANNABIS"."GENOMICS_CANNABIS"."MNPR01_REFERENCE_201703" r
       ON v."reference_name" = r."name"
GROUP BY r."name", r."length"
ORDER BY "variant_density" DESC
LIMIT    20;   -- keep 20 for inspection; change to 1 if you only want the single top record
```

