Begin Exploring Related Columns
Relevant tables / columns and why they matter  
• olist_orders  
  – order_id : connects each order to its payments and items.  
  – customer_id : links an order to a customer record.  
  – order_status : we will keep only rows where order_status = 'delivered'.  
• olist_customers  
  – customer_id : joins to olist_orders.  
  – customer_unique_id : user‑level identifier on which we must rank.  
  – customer_city / customer_state : requested in the final output.  
• olist_order_payments  
  – order_id : joins to olist_orders.  
  – payment_value : monetary value to be averaged per customer.  

Key conditions that will be used  
• olist_orders.order_status = 'delivered' (restrict to delivered orders).  

Ten exploratory → final SQL queries
(they get progressively more complex; each returns ≤ 20 rows for inspection)

```sql
-- 1. Distinct order statuses that exist in the data
SELECT DISTINCT "order_status"
FROM "olist_orders"
LIMIT 20;
```

```sql
-- 2. Sample of delivered orders with the related consumer identifiers
SELECT  o."order_id",
        o."customer_id",
        c."customer_unique_id",
        o."order_status"
FROM    "olist_orders"  AS o
JOIN    "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
WHERE   o."order_status" = 'delivered'
LIMIT 20;
```

```sql
-- 3. How many delivered orders each customer_unique_id has
SELECT  c."customer_unique_id",
        COUNT(*) AS delivered_orders
FROM    "olist_orders"  AS o
JOIN    "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
WHERE   o."order_status" = 'delivered'
GROUP BY c."customer_unique_id"
ORDER BY delivered_orders DESC
LIMIT 20;
```

```sql
-- 4. Total payment per order (irrespective of status)
SELECT  "order_id",
        SUM("payment_value") AS total_payment
FROM    "olist_order_payments"
GROUP BY "order_id"
LIMIT 20;
```

```sql
-- 5. Payment totals only for delivered orders
SELECT  o."order_id",
        SUM(p."payment_value") AS total_payment
FROM    "olist_orders"         AS o
JOIN    "olist_order_payments" AS p
       ON o."order_id" = p."order_id"
WHERE   o."order_status" = 'delivered'
GROUP BY o."order_id"
LIMIT 20;
```

```sql
-- 6. Average payment value per customer_unique_id (delivered orders only)
SELECT  c."customer_unique_id",
        AVG(op.total_payment) AS avg_payment
FROM   (SELECT  o."order_id",
               o."customer_id",
               SUM(p."payment_value") AS total_payment
        FROM    "olist_orders"         AS o
        JOIN    "olist_order_payments" AS p
               ON o."order_id" = p."order_id"
        WHERE   o."order_status" = 'delivered'
        GROUP BY o."order_id", o."customer_id") AS op
JOIN    "olist_customers" AS c
       ON op."customer_id" = c."customer_id"
GROUP BY c."customer_unique_id"
LIMIT 20;
```

```sql
-- 7. Top customers by number of delivered orders
SELECT  c."customer_unique_id",
        COUNT(DISTINCT o."order_id") AS delivered_orders
FROM    "olist_orders"  AS o
JOIN    "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
WHERE   o."order_status" = 'delivered'
GROUP BY c."customer_unique_id"
ORDER BY delivered_orders DESC
LIMIT 10;
```

```sql
-- 8. Combine counts, average payment, and location – take top‑3
SELECT  res."customer_unique_id",
        res.delivered_orders,
        res.avg_payment,
        res.customer_city,
        res.customer_state
FROM   (
        SELECT  cu."customer_unique_id",
                COUNT(DISTINCT o."order_id")            AS delivered_orders,
                AVG(pay.total_payment)                  AS avg_payment,
                MAX(cu."customer_city")   AS customer_city,
                MAX(cu."customer_state")  AS customer_state
        FROM    "olist_orders"         AS o
        JOIN    "olist_customers"      AS cu
               ON o."customer_id" = cu."customer_id"
        JOIN   (SELECT  "order_id",
                       SUM("payment_value") AS total_payment
                FROM    "olist_order_payments"
                GROUP BY "order_id") AS pay
               ON o."order_id" = pay."order_id"
        WHERE   o."order_status" = 'delivered'
        GROUP BY cu."customer_unique_id"
      ) AS res
ORDER BY res.delivered_orders DESC
LIMIT 3;
```

```sql
-- 9. Same as #8 but expressed with CTEs for readability
WITH delivered_orders AS (
     SELECT  "order_id",
             "customer_id"
     FROM    "olist_orders"
     WHERE   "order_status" = 'delivered'
),
payments AS (
     SELECT  "order_id",
             SUM("payment_value") AS total_payment
     FROM    "olist_order_payments"
     GROUP BY "order_id"
),
customer_stats AS (
     SELECT  c."customer_unique_id",
             COUNT(d."order_id")                AS delivered_orders,
             AVG(p.total_payment)               AS avg_payment,
             MAX(c."customer_city")  AS customer_city,
             MAX(c."customer_state") AS customer_state
     FROM    delivered_orders d
     JOIN    payments         p ON d."order_id"  = p."order_id"
     JOIN    "olist_customers" c ON d."customer_id" = c."customer_id"
     GROUP BY c."customer_unique_id"
)
SELECT *
FROM   customer_stats
ORDER BY delivered_orders DESC
LIMIT 3;
```

```sql
-- 10. Quick check: top 20 customer_unique_id purely by delivered order count
SELECT  c."customer_unique_id",
        COUNT(DISTINCT o."order_id") AS num_delivered_orders
FROM    "olist_orders"  AS o
JOIN    "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
WHERE   o."order_status" = 'delivered'
GROUP BY c."customer_unique_id"
ORDER BY num_delivered_orders DESC
LIMIT 20;
```
