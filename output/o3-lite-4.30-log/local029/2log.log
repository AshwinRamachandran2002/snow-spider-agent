  – order_id: link to payments table  
  – customer_id: link to customers table  
  – order_status: filter to delivered orders (`order_status = 'delivered'`)  

• olist_customers  
  – customer_id: link to orders table  
  – customer_unique_id: customer we must rank by  
  – customer_city / customer_state: requested output columns  

• olist_order_payments  
  – order_id: link to orders table  
  – payment_value: used to compute the average payment per customer_unique_id  

SQL‑exploration (10 queries, each limited to 20 rows)

```sql
-- 1. Inspect the different order statuses that exist
SELECT DISTINCT "order_status"
FROM "olist_orders"
LIMIT 20;
```

```sql
-- 2. Look at a few delivered orders with their customer_id
SELECT "order_id", "customer_id", "order_status"
FROM "olist_orders"
WHERE "order_status" = 'delivered'
LIMIT 20;
```

```sql
-- 3. Map some customer_id values to their customer_unique_id
SELECT "customer_id", "customer_unique_id"
FROM "olist_customers"
LIMIT 20;
```

```sql
-- 4. Find cases where the same customer_unique_id has several customer_id values
SELECT "customer_unique_id",
       COUNT(DISTINCT "customer_id") AS id_cnt
FROM "olist_customers"
GROUP BY "customer_unique_id"
HAVING id_cnt > 1
LIMIT 20;
```

```sql
-- 5. Count delivered orders per customer_unique_id
SELECT c."customer_unique_id",
       COUNT(*) AS delivered_orders
FROM   "olist_orders"  o
JOIN   "olist_customers" c
       ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY delivered_orders DESC
LIMIT 20;
```

```sql
-- 6. Show the top‑10 customers by number of delivered orders (only the id and count)
SELECT c."customer_unique_id",
       COUNT(*) AS delivered_orders
FROM   "olist_orders"  o
JOIN   "olist_customers" c
       ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY delivered_orders DESC
LIMIT 10;
```

```sql
-- 7. Inspect payments for one high‑volume customer (replace XXX with an id from query 6)
SELECT p."order_id", p."payment_value"
FROM   "olist_order_payments" p
WHERE  p."order_id" IN (
        SELECT o."order_id"
        FROM   "olist_orders" o
        JOIN   "olist_customers" c
               ON o."customer_id" = c."customer_id"
        WHERE  o."order_status" = 'delivered'
          AND  c."customer_unique_id" = 'XXX'
      )
LIMIT 20;
```

```sql
-- 8. Compute average payment value per customer_unique_id
SELECT c."customer_unique_id",
       AVG(p."payment_value") AS avg_payment
FROM   "olist_orders"  o
JOIN   "olist_customers" c
       ON o."customer_id" = c."customer_id"
JOIN   "olist_order_payments" p
       ON o."order_id" = p."order_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
LIMIT 20;
```

```sql
-- 9. Bring in customer city and state with the average payment
SELECT c."customer_unique_id",
       MIN(c."customer_city")  AS customer_city,   -- expect same city/state per unique_id
       MIN(c."customer_state") AS customer_state,
       AVG(p."payment_value")  AS avg_payment
FROM   "olist_orders"  o
JOIN   "olist_customers" c
       ON o."customer_id" = c."customer_id"
JOIN   "olist_order_payments" p
       ON o."order_id" = p."order_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: top‑3 customer_unique_id with the most delivered orders,
--                  showing average payment, city, and state
SELECT
    c."customer_unique_id",
    COUNT(*)                       AS delivered_order_cnt,
    AVG(p."payment_value")         AS avg_payment_value,
    MIN(c."customer_city")         AS customer_city,
    MIN(c."customer_state")        AS customer_state
FROM   "olist_orders"  o
JOIN   "olist_customers" c
       ON o."customer_id" = c."customer_id"
JOIN   "olist_order_payments" p
       ON o."order_id" = p."order_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY delivered_order_cnt DESC
LIMIT 3;
```

