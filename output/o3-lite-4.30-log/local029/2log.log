--                 appears under multiple customer_id values).  We join:
--                 1) olist_orders  (to filter delivered orders)
--                 2) olist_customers (to translate customer_id → customer_unique_id / city / state)
--                 3) olist_order_payments (to aggregate payment_value per order)
--             Finally we order by delivered_order_cnt desc and keep the top‑3.
SELECT
    c."customer_unique_id",
    COUNT(*)                       AS delivered_order_cnt,
    AVG(p."payment_value")         AS avg_payment_value,
