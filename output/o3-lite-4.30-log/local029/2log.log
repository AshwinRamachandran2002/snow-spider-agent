```sql
--Description: Compute the average payment value for each customer_unique_id,
--             considering only delivered orders.  We join orders ➜ customers ➜ payments,
--             filter on order_status = 'delivered', then aggregate by customer_unique_id.
SELECT
    c."customer_unique_id",
    AVG(p."payment_value") AS avg_payment
FROM   "olist_orders"          AS o
JOIN   "olist_customers"       AS c  ON c."customer_id" = o."customer_id"
JOIN   "olist_order_payments"  AS p  ON p."order_id"    = o."order_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
LIMIT 20;
```

```sql
--Description: Show, for every customer_unique_id, the city, state, and average payment
--             value across their delivered orders.  MIN() is used for city/state because
--             a customer_unique_id should map to a single location; it also satisfies the
--             GROUP BY requirements in SQLite.
SELECT
    c."customer_unique_id",
    MIN(c."customer_city")   AS customer_city,
    MIN(c."customer_state")  AS customer_state,
    AVG(p."payment_value")   AS avg_payment
FROM   "olist_orders"          AS o
JOIN   "olist_customers"       AS c  ON c."customer_id" = o."customer_id"
JOIN   "olist_order_payments"  AS p  ON p."order_id"    = o."order_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
LIMIT 20;
```

```sql
--Description: Final query – retrieve the three customers (customer_unique_id) with the
--             highest number of delivered orders, along with their order count,
--             average payment value, city, and state.
SELECT
    c."customer_unique_id",
    COUNT(*)                       AS delivered_order_cnt,
    AVG(p."payment_value")         AS avg_payment_value,
    MIN(c."customer_city")         AS customer_city,
    MIN(c."customer_state")        AS customer_state
FROM   "olist_orders"          AS o
JOIN   "olist_customers"       AS c  ON c."customer_id" = o."customer_id"
JOIN   "olist_order_payments"  AS p  ON p."order_id"    = o."order_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_unique_id"
ORDER  BY delivered_order_cnt DESC
LIMIT 3;
```
