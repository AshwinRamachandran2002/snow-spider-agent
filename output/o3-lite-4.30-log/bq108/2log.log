Relevant columns and why they matter  

state_number + consecutive_number: composite key that uniquely identifies each accident in both tables – used for joining  
month_of_crash (accident_2015): lets us keep only January‑through‑August crashes (values 1‑8)  
person_number (person_2015): used to count distinct people in an accident  
injury_severity (person_2015): code 4 = “Severe injury” – filter/aggregate to find multiple severe‑injury victims in the same accident  

Typical conditions we will need  

acc.month_of_crash BETWEEN 1 AND 8               -- Jan‑Aug 2015  
per.injury_severity = 4                          -- severe injury  
COUNT(DISTINCT per.person_number) > 1            -- more than one person in an accident  
COUNTIF(per.injury_severity = 4) > 1             -- more than one severe injury in an accident  

Below are ten BigQuery‑SQL snippets (all different, each capped with LIMIT 20) that build up to the final percentage calculation.

```sql
-- 1. Sample January‑August crashes (accident table only)
SELECT state_number, consecutive_number, month_of_crash
FROM `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS acc
WHERE month_of_crash BETWEEN 1 AND 8
LIMIT 20;
```

```sql
-- 2. Distribution of injury_severity codes in the person table for Jan‑Aug
SELECT injury_severity, COUNT(*) AS cnt
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` AS per
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS acc
  USING (state_number, consecutive_number)
WHERE acc.month_of_crash BETWEEN 1 AND 8
GROUP BY injury_severity
ORDER BY cnt DESC
LIMIT 20;
```

```sql
-- 3. Show persons (with their injury codes) that belong to Jan‑Aug crashes
SELECT per.state_number, per.consecutive_number, per.person_number, per.injury_severity
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` AS per
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS acc
  USING (state_number, consecutive_number)
WHERE acc.month_of_crash BETWEEN 1 AND 8
LIMIT 20;
```

```sql
-- 4. Count of distinct persons in each Jan‑Aug accident
SELECT per.state_number, per.consecutive_number,
       COUNT(DISTINCT per.person_number) AS persons_in_accident
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` AS per
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS acc
  USING (state_number, consecutive_number)
WHERE acc.month_of_crash BETWEEN 1 AND 8
GROUP BY per.state_number, per.consecutive_number
LIMIT 20;
```

```sql
-- 5. Count of severe‑injury persons in each Jan‑Aug accident
SELECT per.state_number, per.consecutive_number,
       COUNTIF(per.injury_severity = 4) AS severe_inj_cnt
FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` AS per
JOIN `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS acc
  USING (state_number, consecutive_number)
WHERE acc.month_of_crash BETWEEN 1 AND 8
GROUP BY per.state_number, per.consecutive_number
LIMIT 20;
```

```sql
-- 6. List accidents that involve >1 distinct person
SELECT acc_id.*
FROM (
  SELECT per.state_number, per.consecutive_number,
         COUNT(DISTINCT per.person_number) AS person_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` AS per
  JOIN `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS acc
    USING (state_number, consecutive_number)
  WHERE acc.month_of_crash BETWEEN 1 AND 8
  GROUP BY per.state_number, per.consecutive_number
) acc_id
WHERE person_cnt > 1
LIMIT 20;
```

```sql
-- 7. List accidents that have >1 severe‑injury person
SELECT sev_acc.*
FROM (
  SELECT per.state_number, per.consecutive_number,
         COUNTIF(per.injury_severity = 4) AS sev_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` AS per
  JOIN `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` AS acc
    USING (state_number, consecutive_number)
  WHERE acc.month_of_crash BETWEEN 1 AND 8
  GROUP BY per.state_number, per.consecutive_number
) sev_acc
WHERE sev_cnt > 1
LIMIT 20;
```

```sql
-- 8. Counts needed for the percentage (denominator & numerator side by side)
WITH base AS (
  SELECT per.state_number, per.consecutive_number,
         COUNT(DISTINCT per.person_number)                         AS person_cnt,
         COUNTIF(per.injury_severity = 4)                          AS sev_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` per
  JOIN `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` acc
        USING (state_number, consecutive_number)
  WHERE acc.month_of_crash BETWEEN 1 AND 8
  GROUP BY per.state_number, per.consecutive_number
)
SELECT
  COUNTIF(person_cnt > 1) AS accidents_with_gt1_person,
  COUNTIF(person_cnt > 1 AND sev_cnt > 1) AS acc_with_gt1_severe
FROM base
LIMIT 20;
```

```sql
-- 9. Same as #8 but also computing the fraction
WITH base AS (
  SELECT per.state_number, per.consecutive_number,
         COUNT(DISTINCT per.person_number) AS person_cnt,
         COUNTIF(per.injury_severity = 4)  AS sev_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` per
  JOIN `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` acc
        USING (state_number, consecutive_number)
  WHERE acc.month_of_crash BETWEEN 1 AND 8
  GROUP BY per.state_number, per.consecutive_number
)
SELECT
  COUNTIF(person_cnt > 1)                                   AS denom_total_acc,
  COUNTIF(person_cnt > 1 AND sev_cnt > 1)                   AS num_acc_sev,
  SAFE_DIVIDE(COUNTIF(person_cnt > 1 AND sev_cnt > 1),
              COUNTIF(person_cnt > 1))                      AS raw_fraction
FROM base
LIMIT 20;
```

```sql
-- 10. Final answer: percentage of Jan‑Aug 2015 multi‑person accidents
--      that had >1 severe‑injury victim (rounded to 2 decimals)
WITH base AS (
  SELECT per.state_number, per.consecutive_number,
         COUNT(DISTINCT per.person_number) AS person_cnt,
         COUNTIF(per.injury_severity = 4)  AS sev_cnt
  FROM `bigquery-public-data.nhtsa_traffic_fatalities.person_2015` per
  JOIN `bigquery-public-data.nhtsa_traffic_fatalities.accident_2015` acc
        USING (state_number, consecutive_number)
  WHERE acc.month_of_crash BETWEEN 1 AND 8
  GROUP BY per.state_number, per.consecutive_number
)
SELECT
  ROUND(
    100 * SAFE_DIVIDE(
            COUNTIF(person_cnt > 1 AND sev_cnt > 1),
            COUNTIF(person_cnt > 1)
         ), 2
  ) AS pct_acc_with_multiple_severe_injuries
FROM base
LIMIT 20;
```
