```sql
--Description: 1) UNNEST the `vep` array to locate every chromosome‑17 variant whose annotation
--                SYMBOL equals 'BRCA1'; aggregate to obtain the gene’s genomic span
--                (minimum start_position and maximum end_position).  
--             2) Using those bounds, rescan the same table, restrict to variants whose
--                start_position lies inside the BRCA1 span, UNNEST `vep` again, keep only
--                annotations whose Consequence contains 'missense_variant' and that provide
--                a Protein_position.  
--             3) Cast Protein_position to INT64 so it can be sorted numerically; pick the
--                smallest one.  
--             4) Return the gene boundaries together with that first missense
--                Protein_position.
WITH brca1_bounds AS (
  SELECT
    MIN(g.start_position) AS min_start_position,
    MAX(g.end_position)   AS max_end_position
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS g
  CROSS JOIN UNNEST(g.vep) AS v
  WHERE v.SYMBOL = 'BRCA1'
),
first_missense AS (
  SELECT
    CAST(v2.Protein_position AS INT64) AS prot_pos
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS g2
  CROSS JOIN UNNEST(g2.vep) AS v2
  JOIN brca1_bounds b
    ON g2.start_position BETWEEN b.min_start_position AND b.max_end_position
  WHERE v2.Consequence LIKE '%missense_variant%'
    AND v2.Protein_position IS NOT NULL
  ORDER BY prot_pos
  LIMIT 1
)
SELECT
  b.min_start_position,
  b.max_end_position,
  f.prot_pos AS first_missense_protein_position
FROM brca1_bounds b
CROSS JOIN first_missense f;
