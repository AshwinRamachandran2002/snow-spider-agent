```sql
--Description: One query accomplishes all tasks. 
-- 1) CTE brca1_bounds: determine the genomic span of BRCA1 on chr17 by selecting rows
--    whose VEP array contains at least one element with SYMBOL='BRCA1'; aggregate to
--    MIN(start_position) and MAX(end_position).
-- 2) CTE missense: within those bounds, unnest VEP again, keep annotations whose
--    Consequence includes 'missense_variant' and have a non‑NULL Protein_position;
--    cast Protein_position to INT64 and collect distinct values.
-- 3) Final SELECT returns the gene bounds plus the smallest (earliest) missense
--    Protein_position.
WITH brca1_bounds AS (
  SELECT
    MIN(start_position) AS gene_start,
    MAX(end_position)   AS gene_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
  WHERE EXISTS (
    SELECT 1
    FROM UNNEST(vep) AS v
    WHERE v.SYMBOL = 'BRCA1'
  )
),
missense AS (
  SELECT DISTINCT
    CAST(v.Protein_position AS INT64) AS prot_pos
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17` AS g
  CROSS JOIN UNNEST(g.vep) AS v
  CROSS JOIN brca1_bounds b
  WHERE g.start_position BETWEEN b.gene_start AND b.gene_end
    AND v.Consequence LIKE '%missense_variant%'
    AND v.Protein_position IS NOT NULL
)
SELECT
  gene_start AS min_start_position,
  gene_end   AS max_end_position,
  (SELECT prot_pos FROM missense ORDER BY prot_pos LIMIT 1) AS first_missense_protein_position
FROM brca1_bounds;
