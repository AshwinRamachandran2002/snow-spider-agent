Begin Exploring Related Columns
Relevant columns and their potential usage  
• `start_position`: genomic left coordinate of a variant – needed to locate variants inside the BRCA1 span.  
• `end_position`: genomic right coordinate of a variant – needed (together with start_position) to delimit the whole BRCA1 span.  
• `vep` (ARRAY<STRUCT<…>>): holds one VEP record per alternate allele.  
  – `vep.SYMBOL`: gene symbol to find the BRCA1 annotations.  
  – `vep.Consequence`: functional consequence(s); will be searched for the text “missense_variant”.  
  – `vep.Protein_position`: protein residue position (e.g. “125/1863”).  
Conditions that will be used  
• `EXISTS(SELECT 1 FROM UNNEST(vep) v WHERE v.SYMBOL='BRCA1')` – variant is annotated to BRCA1.  
• `v.Consequence LIKE '%missense_variant%'` – keep only missense consequences.  
• Coordinates between the previously found MIN(start_position) and MAX(end_position).  

Below are ten progressively‑complex BigQuery queries (all limited to 20 rows for exploration) finishing with the final answer query.  
Replace nothing – identifiers are already fully‑qualified.

```sql
-- 1. Description: peek at raw rows in the chromosome‑17 table
SELECT *
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
LIMIT 20;
```

```sql
-- 2. Description: explode the VEP array to inspect gene symbols and consequences
SELECT v.SYMBOL, v.Consequence
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(vep) AS v
LIMIT 20;
```

```sql
-- 3. Description: list a few rows whose VEP annotations mention BRCA1
SELECT start_position, end_position, v.SYMBOL, v.Consequence
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`,
     UNNEST(vep) AS v
WHERE v.SYMBOL = 'BRCA1'
LIMIT 20;
```

```sql
-- 4. Description: obtain the smallest start_position of any BRCA1‑annotated variant
SELECT MIN(start_position) AS min_start
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
WHERE EXISTS (
  SELECT 1 FROM UNNEST(vep) v WHERE v.SYMBOL = 'BRCA1'
);
```

```sql
-- 5. Description: obtain the largest end_position of any BRCA1‑annotated variant
SELECT MAX(end_position) AS max_end
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
WHERE EXISTS (
  SELECT 1 FROM UNNEST(vep) v WHERE v.SYMBOL = 'BRCA1'
);
```

```sql
-- 6. Description: show all variants whose coordinates fall in the BRCA1 span
WITH brca1_span AS (
  SELECT
    MIN(start_position) AS min_start,
    MAX(end_position)   AS max_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
  WHERE EXISTS (
    SELECT 1 FROM UNNEST(vep) v WHERE v.SYMBOL = 'BRCA1'
  )
)
SELECT start_position, end_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`, brca1_span
WHERE start_position BETWEEN brca1_span.min_start AND brca1_span.max_end
LIMIT 20;
```

```sql
-- 7. Description: retrieve Protein_position values for missense variants in the BRCA1 region
WITH brca1_span AS (
  SELECT MIN(start_position) AS min_start,
         MAX(end_position)   AS max_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
  WHERE EXISTS (SELECT 1 FROM UNNEST(vep) v WHERE v.SYMBOL = 'BRCA1')
)
SELECT DISTINCT v.Protein_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`, brca1_span,
     UNNEST(vep) AS v
WHERE start_position BETWEEN brca1_span.min_start AND brca1_span.max_end
  AND v.Consequence LIKE '%missense_variant%'
LIMIT 20;
```

```sql
-- 8. Description: same as #7 but order numerically by the residue (cast left part before '/')
WITH brca1_span AS (
  SELECT MIN(start_position) AS min_start,
         MAX(end_position)   AS max_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
  WHERE EXISTS (SELECT 1 FROM UNNEST(vep) v WHERE v.SYMBOL = 'BRCA1')
)
SELECT DISTINCT v.Protein_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`, brca1_span,
     UNNEST(vep) AS v
WHERE start_position BETWEEN brca1_span.min_start AND brca1_span.max_end
  AND v.Consequence LIKE '%missense_variant%'
ORDER BY CAST(SPLIT(v.Protein_position, '/')[OFFSET(0)] AS INT64)
LIMIT 20;
```

```sql
-- 9. Description: pull min & max coordinates plus the sorted protein positions in one shot
WITH brca1_variants AS (
  SELECT *
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
  WHERE EXISTS (SELECT 1 FROM UNNEST(vep) v WHERE v.SYMBOL = 'BRCA1')
), span AS (
  SELECT MIN(start_position) AS min_start,
         MAX(end_position)   AS max_end
  FROM brca1_variants
)
SELECT DISTINCT v.Protein_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`, span,
     UNNEST(vep) AS v
WHERE start_position BETWEEN span.min_start AND span.max_end
  AND v.Consequence LIKE '%missense_variant%'
ORDER BY CAST(SPLIT(v.Protein_position, '/')[OFFSET(0)] AS INT64)
LIMIT 20;
```

```sql
-- 10. Description: FINAL ANSWER – first Protein_position of missense_variant
WITH brca1_span AS (
  SELECT
    MIN(start_position) AS min_start,
    MAX(end_position)   AS max_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
  WHERE EXISTS (
    SELECT 1 FROM UNNEST(vep) v WHERE v.SYMBOL = 'BRCA1'
  )
)
SELECT DISTINCT v.Protein_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`, brca1_span,
     UNNEST(vep) AS v
WHERE start_position BETWEEN brca1_span.min_start AND brca1_span.max_end
  AND v.Consequence LIKE '%missense_variant%'
ORDER BY CAST(SPLIT(v.Protein_position, '/')[OFFSET(0)] AS INT64)
LIMIT 1;
```
