--Description:
-- 1. Expand the VEP annotations in two stages:
--      • UNNEST(alternate_bases)  → one row per alternate allele.
--      • UNNEST(ab.vep)           → one row per VEP annotation of that allele.
-- 2. Restrict to annotations whose gene SYMBOL is exactly 'BRCA1'.
-- 3. Compute the genomic span that contains every BRCA1‑annotated variant
--    (MIN start_position, MAX end_position).
-- 4. Re‑scan the table, keep only variants whose coordinates sit inside that span,
--    and from their VEP records keep those whose Consequence includes
--    the substring 'missense_variant'.
-- 5. Extract Protein_position, order numerically on the residue number that
--    precedes the '/' character, and return the first (smallest) value.
WITH brca1_span AS (
  SELECT
    MIN(start_position) AS min_start,
    MAX(end_position)   AS max_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
  CROSS JOIN UNNEST(alternate_bases) AS ab
  CROSS JOIN UNNEST(ab.vep)          AS v
  WHERE v.SYMBOL = 'BRCA1'
)
SELECT DISTINCT v.Protein_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
CROSS JOIN UNNEST(alternate_bases) AS ab
CROSS JOIN UNNEST(ab.vep)          AS v
CROSS JOIN brca1_span
WHERE start_position BETWEEN brca1_span.min_start AND brca1_span.max_end
  AND v.Consequence LIKE '%missense_variant%'
ORDER BY CAST(SPLIT(v.Protein_position, '/')[OFFSET(0)] AS INT64)
LIMIT 1;
