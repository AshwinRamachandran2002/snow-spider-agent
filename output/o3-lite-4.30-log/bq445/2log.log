FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
WHERE EXISTS (
  SELECT 1 FROM UNNEST(vep) v WHERE v.SYMBOL = 'BRCA1'
);
```

```sql
-- 6. Description: show all variants whose coordinates fall in the BRCA1 span
WITH brca1_span AS (
  SELECT
    MIN(start_position) AS min_start,
    MAX(end_position)   AS max_end
  FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`
  WHERE EXISTS (
    SELECT 1 FROM UNNEST(vep) v WHERE v.SYMBOL = 'BRCA1'
  )
)
SELECT start_position, end_position
FROM `bigquery-public-data.gnomAD.v2_1_1_genomes__chr17`, brca1_span
WHERE start_position BETWEEN brca1_span.min_start AND brca1_span.max_end
LIMIT 20;
