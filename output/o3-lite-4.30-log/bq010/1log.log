```sql
--Description:  Each session has an ARRAY field `hits`, so we UNNEST that first.
--              Product titles can live in two places:
--                • `h.item.productName`  (classic commerce “ITEM” hits, a single STRUCT)
--                • `h.product`           (enhanced‑ecommerce, a repeated ARRAY)
--              We therefore LEFT JOIN‑UNNEST the repeated `h.product` array and take the
--              first non‑null name from either location with COALESCE.  The query scans
--              every ga_sessions_* table (no date filter, to make sure data exists) and
--              returns up to 20 distinct names that contain the word “henley”.
SELECT DISTINCT
       COALESCE(pr.v2ProductName,
                pr.productName,
                h.item.productName) AS product_name
FROM  `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s,
      UNNEST(s.hits)                      AS h
LEFT JOIN UNNEST(h.product)               AS pr
WHERE COALESCE(pr.v2ProductName,
               pr.productName,
               h.item.productName) IS NOT NULL
  AND LOWER(COALESCE(pr.v2ProductName,
                     pr.productName,
                     h.item.productName)) LIKE '%henley%'
LIMIT 20;
```
