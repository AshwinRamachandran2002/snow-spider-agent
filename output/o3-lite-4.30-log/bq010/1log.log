--              distinct visitor IDs that bought the exact product
--              “YouTube Men’s Vintage Henley”.  Limited to 20 rows for preview.
SELECT DISTINCT fullVisitorId
FROM (
  SELECT
    s.fullVisitorId,
    REPLACE(
      COALESCE(p.v2ProductName,
               p.productName,
               h.item.productName),
      '’', '''') AS prod_name
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s
  CROSS JOIN UNNEST(s.hits)      AS h
  LEFT  JOIN UNNEST(h.product)   AS p
  WHERE _TABLE_SUFFIX BETWEEN '20170701' AND '20170731'
) AS all_prods
WHERE LOWER(prod_name) = 'youtube men''s vintage henley'
LIMIT 20;
