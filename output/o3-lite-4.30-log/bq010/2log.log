--Description: 10) Full report: for Henley buyers, show top‑N non‑Henley
--products with total quantity and revenue (USD), ordered by quantity.
WITH buyers AS (
  SELECT DISTINCT s.fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  CROSS JOIN UNNEST(s.hits)    AS h
