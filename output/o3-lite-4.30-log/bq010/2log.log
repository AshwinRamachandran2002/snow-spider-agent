```sql
--Description: 4) For every visitor who purchased a Henley in July‑2017
--(identified by case‑insensitive match on “henley” and completed‑purchase
--action_type = '6'), list the other products (not Henley) they also bought in
--completed‑purchase hits, along with quantity.
WITH buyers AS (
  SELECT DISTINCT s.fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  CROSS JOIN UNNEST(s.hits)    AS h
  CROSS JOIN UNNEST(h.product) AS p
  WHERE LOWER(p.v2ProductName) LIKE '%henley%'
    AND h.eCommerceAction.action_type = '6'
)
SELECT
  s.fullVisitorId,
  p.v2ProductName AS product_name,
  p.productQuantity
FROM buyers
JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  ON s.fullVisitorId = buyers.fullVisitorId
CROSS JOIN UNNEST(s.hits)    AS h
CROSS JOIN UNNEST(h.product) AS p
WHERE LOWER(p.v2ProductName) NOT LIKE '%henley%'
  AND h.eCommerceAction.action_type = '6'
LIMIT 20;
```

```sql
--Description: 5) For each Henley buyer, count how many distinct OTHER products
--they purchased (completed‑purchase hits only).
WITH buyers AS (
  SELECT DISTINCT s.fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  CROSS JOIN UNNEST(s.hits)    AS h
  CROSS JOIN UNNEST(h.product) AS p
  WHERE LOWER(p.v2ProductName) LIKE '%henley%'
    AND h.eCommerceAction.action_type = '6'
)
SELECT
  buyers.fullVisitorId,
  COUNT(DISTINCT p.v2ProductName) AS other_products
FROM buyers
JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  ON s.fullVisitorId = buyers.fullVisitorId
CROSS JOIN UNNEST(s.hits)    AS h
CROSS JOIN UNNEST(h.product) AS p
WHERE LOWER(p.v2ProductName) NOT LIKE '%henley%'
  AND h.eCommerceAction.action_type = '6'
GROUP BY buyers.fullVisitorId
LIMIT 20;
```

```sql
--Description: 6) Aggregate total quantity sold for each non‑Henley product
--among visitors who bought a Henley (completed‑purchase hits).
WITH buyers AS (
  SELECT DISTINCT s.fullVisitorId
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  CROSS JOIN UNNEST(s.hits)    AS h
  CROSS JOIN UNNEST(h.product) AS p
  WHERE LOWER(p.v2ProductName) LIKE '%henley%'
    AND h.eCommerceAction.action_type = '6'
)
SELECT
  p.v2ProductName AS product_name,
  SUM(p.productQuantity) AS total_qty
FROM buyers
JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  ON s.fullVisitorId = buyers.fullVisitorId
CROSS JOIN UNNEST(s.hits)    AS h
CROSS JOIN UNNEST(h.product) AS p
WHERE LOWER(p.v2ProductName) NOT LIKE '%henley%'
  AND h.eCommerceAction.action_type = '6'
GROUP BY product_name
ORDER BY total_qty DESC
LIMIT 20;
```

