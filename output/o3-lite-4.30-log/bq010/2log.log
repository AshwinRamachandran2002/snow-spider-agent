Begin Exploring Related Columns
Relevant columns for the task  
• `date`: filter to July‑2017 sessions (`BETWEEN '20170701' AND '20170731'`).  
• `fullVisitorId`: identifies the customer; lets us collect all of a customer’s purchases.  
• `hits.item.productName`: the name of each product purchased inside a session (via UNNEST).  
• `hits.item.itemQuantity`: quantity of a product bought in that hit (to measure “top‑selling”).  
• `hits.item.itemRevenue`: revenue of a product in that hit (alternative “top‑selling” metric).  
• (optional) `hits.eCommerceAction.action_type`: value = 6 marks a completed purchase.

Typical conditions  
• `LOWER(hits.item.productName) LIKE '%henley%'` (find the item).  
• `hits.eCommerceAction.action_type = 6` (keep only completed purchases).  
• `date BETWEEN '20170701' AND '20170731'` (restrict to July 2017).  
• `hits.item.productName <> 'YouTube Men’s Vintage Henley'` (exclude the focal sku).

Below are ten step‑by‑step exploratory queries (each different, all LIMITED 20) that gradually build toward the final answer.

```sql
-- 1. Peek at a few product names in July‑2017 purchases
SELECT DISTINCT hits.item.productName
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*`,
     UNNEST(hits) AS h,
     UNNEST(h.item) AS item
WHERE item.productName IS NOT NULL
LIMIT 20;
```

```sql
-- 2. Find sessions where the Vintage Henley was bought in July‑2017
SELECT DISTINCT fullVisitorId, date, item.itemQuantity
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*`,
     UNNEST(hits) AS h,
     UNNEST(h.item) AS item
WHERE LOWER(item.productName) LIKE '%vintage%henley%'
  AND h.eCommerceAction.action_type = 6
LIMIT 20;
```

```sql
-- 3. List all customers (visitors) who bought the Vintage Henley in July‑2017
SELECT DISTINCT fullVisitorId
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*`,
     UNNEST(hits) AS h,
     UNNEST(h.item) AS item
WHERE item.productName = 'YouTube Men’s Vintage Henley'
  AND h.eCommerceAction.action_type = 6
LIMIT 20;
```

```sql
-- 4. Show *other* items these same customers bought in July‑2017 (no Henley)
SELECT fullVisitorId,
       item.productName,
       item.itemQuantity
FROM (
    SELECT DISTINCT fullVisitorId
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*`,
         UNNEST(hits) AS h,
         UNNEST(h.item) AS item
    WHERE item.productName = 'YouTube Men’s Vintage Henley'
      AND h.eCommerceAction.action_type = 6
) AS buyers
JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  ON s.fullVisitorId = buyers.fullVisitorId,
  UNNEST(s.hits) AS h2,
  UNNEST(h2.item) AS item
WHERE item.productName <> 'YouTube Men’s Vintage Henley'
  AND h2.eCommerceAction.action_type = 6
LIMIT 20;
```

```sql
-- 5. Quick count of how many distinct products each buyer purchased (excluding Henley)
SELECT buyers.fullVisitorId,
       COUNT(DISTINCT item.productName) AS other_products
FROM (
    SELECT DISTINCT fullVisitorId
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*`,
         UNNEST(hits) AS h,
         UNNEST(h.item) AS item
    WHERE item.productName = 'YouTube Men’s Vintage Henley'
      AND h.eCommerceAction.action_type = 6
) AS buyers
JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  ON s.fullVisitorId = buyers.fullVisitorId,
  UNNEST(s.hits) AS h2,
  UNNEST(h2.item) AS item
WHERE item.productName <> 'YouTube Men’s Vintage Henley'
  AND h2.eCommerceAction.action_type = 6
GROUP BY buyers.fullVisitorId
LIMIT 20;
```

```sql
-- 6. Aggregate quantity sold for each non‑Henley product among those customers
SELECT item.productName,
       SUM(item.itemQuantity) AS total_qty
FROM (
    SELECT DISTINCT fullVisitorId
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*`,
         UNNEST(hits) AS h,
         UNNEST(h.item) AS item
    WHERE item.productName = 'YouTube Men’s Vintage Henley'
      AND h.eCommerceAction.action_type = 6
) AS buyers
JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  ON s.fullVisitorId = buyers.fullVisitorId,
  UNNEST(s.hits) AS h2,
  UNNEST(h2.item) AS item
WHERE item.productName <> 'YouTube Men’s Vintage Henley'
  AND h2.eCommerceAction.action_type = 6
GROUP BY item.productName
ORDER BY total_qty DESC
LIMIT 20;
```

```sql
-- 7. Same as #6 but rank by revenue instead of quantity
SELECT item.productName,
       SUM(item.itemRevenue) / 1000000 AS total_revenue_usd
FROM (
    SELECT DISTINCT fullVisitorId
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*`,
         UNNEST(hits) AS h,
         UNNEST(h.item) AS item
    WHERE item.productName = 'YouTube Men’s Vintage Henley'
      AND h.eCommerceAction.action_type = 6
) AS buyers
JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  ON s.fullVisitorId = buyers.fullVisitorId,
  UNNEST(s.hits) AS h2,
  UNNEST(h2.item) AS item
WHERE item.productName <> 'YouTube Men’s Vintage Henley'
  AND h2.eCommerceAction.action_type = 6
GROUP BY item.productName
ORDER BY total_revenue_usd DESC
LIMIT 20;
```

```sql
-- 8. Identify the single top‑selling product by quantity (excluding Henley)
SELECT item.productName
FROM (
    SELECT DISTINCT fullVisitorId
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*`,
         UNNEST(hits) AS h,
         UNNEST(h.item) AS item
    WHERE item.productName = 'YouTube Men’s Vintage Henley'
      AND h.eCommerceAction.action_type = 6
) AS buyers
JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  ON s.fullVisitorId = buyers.fullVisitorId,
  UNNEST(s.hits) AS h2,
  UNNEST(h2.item) AS item
WHERE item.productName <> 'YouTube Men’s Vintage Henley'
  AND h2.eCommerceAction.action_type = 6
GROUP BY item.productName
ORDER BY SUM(item.itemQuantity) DESC
LIMIT 1;
```

```sql
-- 9. Same logic but choose the top product by revenue
SELECT item.productName
FROM (
    SELECT DISTINCT fullVisitorId
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*`,
         UNNEST(hits) AS h,
         UNNEST(h.item) AS item
    WHERE item.productName = 'YouTube Men’s Vintage Henley'
      AND h.eCommerceAction.action_type = 6
) AS buyers
JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  ON s.fullVisitorId = buyers.fullVisitorId,
  UNNEST(s.hits) AS h2,
  UNNEST(h2.item) AS item
WHERE item.productName <> 'YouTube Men’s Vintage Henley'
  AND h2.eCommerceAction.action_type = 6
GROUP BY item.productName
ORDER BY SUM(item.itemRevenue) DESC
LIMIT 1;
```

```sql
-- 10. Full final report: top‑N products with both quantity & revenue, ranked by qty
SELECT item.productName,
       SUM(item.itemQuantity)        AS qty_sold,
       SUM(item.itemRevenue)/1e6     AS revenue_usd
FROM (
    SELECT DISTINCT fullVisitorId
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*`,
         UNNEST(hits) AS h,
         UNNEST(h.item) AS item
    WHERE item.productName = 'YouTube Men’s Vintage Henley'
      AND h.eCommerceAction.action_type = 6
) AS buyers
JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
  ON s.fullVisitorId = buyers.fullVisitorId,
  UNNEST(s.hits) AS h2,
  UNNEST(h2.item) AS item
WHERE item.productName <> 'YouTube Men’s Vintage Henley'
  AND h2.eCommerceAction.action_type = 6
GROUP BY item.productName
ORDER BY qty_sold DESC
LIMIT 20;
```

These queries progress from simple exploration (#1) to the final answer candidates (#8–#10), all working only with the permitted tables and columns.
Refined SQLs and results:
Query:
--Description: 2) Find sessions where the Vintage Henley was bought in July‑2017.
--   • UNNEST hits  ➜  h
--   • UNNEST h.product (array)  ➜  p
--   • Identify the product via LOWER(p.v2ProductName) LIKE '%vintage%henley%'
--   • Keep only completed‑purchase hits (action_type = '6')
SELECT DISTINCT
       s.fullVisitorId,
       s.date,
       p.productQuantity
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_201707*` AS s
CROSS JOIN UNNEST(s.hits)    AS h
CROSS JOIN UNNEST(h.product) AS p
WHERE LOWER(p.v2ProductName) LIKE '%vintage%henley%'
  AND h.eCommerceAction.action_type = '6'
LIMIT 20
