--Description: #9 – UNPIVOT 2014 & latest rows, then compute growth rate list for all metrics
WITH base AS (
  SELECT report_year,
         race_asian            AS asian,
         race_black            AS black,
         race_hispanic_latinx  AS latinx,
         race_native_american  AS native_american,
         race_white            AS white,
