Begin Exploring Related Columns
Relevant table & columns for the request  

bigquery-public-data.google_dei.dar_non_intersectional_representation  
• workforce : potential usage  → filter to the “overall” workforce  
• report_year : potential usage  → filter to 2014 and 2024 (start / end year)  
• race_asian, race_black, race_hispanic_latinx, race_native_american, race_white : potential usage  → 2014 vs 2024 representation shares for racial groups  
• gender_us_women, gender_us_men, gender_global_women, gender_global_men : potential usage  → 2014 vs 2024 representation shares for gender groups  

Typical conditions that will be used  
WHERE workforce = 'overall'  
AND   report_year IN (2014, 2024)  

Below are ten illustrative BigQuery queries (from inspection to final growth‑rate calculation).  
Each query returns ≤ 20 rows and is accompanied by a short description.

```sql
-- 1. Description: see every workforce category that exists in the table
SELECT DISTINCT `workforce`
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
LIMIT 20;
```

```sql
-- 2. Description: inspect the 2014 row for the overall workforce
SELECT *
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
  AND `report_year` = 2014
LIMIT 20;
```

```sql
-- 3. Description: inspect the 2024 row for the overall workforce
SELECT *
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
  AND `report_year` = 2024
LIMIT 20;
```

```sql
-- 4. Description: compare the 2014 and 2024 values side‑by‑side
SELECT `report_year`,
       `race_asian`,
       `race_black`,
       `race_hispanic_latinx`,
       `race_native_american`,
       `race_white`,
       `gender_us_women`,
       `gender_us_men`,
       `gender_global_women`,
       `gender_global_men`
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
  AND `report_year` IN (2014, 2024)
ORDER BY `report_year`
LIMIT 20;
```

```sql
-- 5. Description: pull only the racial columns for the two years
SELECT `report_year`,
       `race_asian`,
       `race_black`,
       `race_hispanic_latinx`,
       `race_native_american`,
       `race_white`
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
  AND `report_year` IN (2014, 2024)
ORDER BY `report_year`
LIMIT 20;
```

```sql
-- 6. Description: compute the raw change (absolute increase) from 2014→2024
WITH yr AS (
  SELECT *
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE `workforce` = 'overall'
    AND `report_year` IN (2014, 2024)
)
SELECT
  MAX(CASE WHEN report_year = 2024 THEN race_asian END)  - 
  MAX(CASE WHEN report_year = 2014 THEN race_asian END)  AS asian_change,
  MAX(CASE WHEN report_year = 2024 THEN race_black END)  - 
  MAX(CASE WHEN report_year = 2014 THEN race_black END)  AS black_change,
  MAX(CASE WHEN report_year = 2024 THEN race_hispanic_latinx END)  - 
  MAX(CASE WHEN report_year = 2014 THEN race_hispanic_latinx END)  AS latinx_change,
  MAX(CASE WHEN report_year = 2024 THEN race_native_american END)  - 
  MAX(CASE WHEN report_year = 2014 THEN race_native_american END)  AS native_change,
  MAX(CASE WHEN report_year = 2024 THEN race_white END)  - 
  MAX(CASE WHEN report_year = 2014 THEN race_white END)  AS white_change
FROM yr
LIMIT 20;
```

```sql
-- 7. Description: calculate percentage growth for the race columns
WITH yr AS (
  SELECT *
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE `workforce` = 'overall'
    AND `report_year` IN (2014, 2024)
)
SELECT
  (MAX(CASE WHEN report_year = 2024 THEN race_asian END) /
   MAX(CASE WHEN report_year = 2014 THEN race_asian END) - 1) AS asian_growth_rate,
  (MAX(CASE WHEN report_year = 2024 THEN race_black END) /
   MAX(CASE WHEN report_year = 2014 THEN race_black END) - 1) AS black_growth_rate,
  (MAX(CASE WHEN report_year = 2024 THEN race_hispanic_latinx END) /
   MAX(CASE WHEN report_year = 2014 THEN race_hispanic_latinx END) - 1) AS latinx_growth_rate,
  (MAX(CASE WHEN report_year = 2024 THEN race_native_american END) /
   MAX(CASE WHEN report_year = 2014 THEN race_native_american END) - 1) AS native_growth_rate,
  (MAX(CASE WHEN report_year = 2024 THEN race_white END) /
   MAX(CASE WHEN report_year = 2014 THEN race_white END) - 1) AS white_growth_rate
FROM yr
LIMIT 20;
```

```sql
-- 8. Description: percentage growth for U.S. and global gender columns
WITH yr AS (
  SELECT *
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE `workforce` = 'overall'
    AND `report_year` IN (2014, 2024)
)
SELECT
  (MAX(CASE WHEN report_year = 2024 THEN gender_us_women END) /
   MAX(CASE WHEN report_year = 2014 THEN gender_us_women END) - 1) AS us_women_growth,
  (MAX(CASE WHEN report_year = 2024 THEN gender_us_men END) /
   MAX(CASE WHEN report_year = 2014 THEN gender_us_men END) - 1) AS us_men_growth,
  (MAX(CASE WHEN report_year = 2024 THEN gender_global_women END) /
   MAX(CASE WHEN report_year = 2014 THEN gender_global_women END) - 1) AS global_women_growth,
  (MAX(CASE WHEN report_year = 2024 THEN gender_global_men END) /
   MAX(CASE WHEN report_year = 2014 THEN gender_global_men END) - 1) AS global_men_growth
FROM yr
LIMIT 20;
```

```sql
-- 9. Description: UNPIVOT the 2014 & 2024 rows then calculate growth in a single list
WITH base AS (
  SELECT `report_year`,
         `race_asian`            AS asian,
         `race_black`            AS black,
         `race_hispanic_latinx`  AS latinx,
         `race_native_american`  AS native_american,
         `race_white`            AS white,
         `gender_us_women`       AS us_women,
         `gender_us_men`         AS us_men,
         `gender_global_women`   AS global_women,
         `gender_global_men`     AS global_men
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
    AND report_year IN (2014, 2024)
)
SELECT metric,
       MAX(CASE WHEN report_year = 2014 THEN val END) AS value_2014,
       MAX(CASE WHEN report_year = 2024 THEN val END) AS value_2024,
       (MAX(CASE WHEN report_year = 2024 THEN val END) /
        MAX(CASE WHEN report_year = 2014 THEN val END) - 1) AS growth_rate
FROM base
UNPIVOT (val FOR metric IN (asian, black, latinx, native_american,
                            white, us_women, us_men,
                            global_women, global_men))
GROUP BY metric
ORDER BY metric
LIMIT 20;
```

```sql
-- 10. Description: FINAL QUERY – returns one row with growth rates for all nine metrics
WITH yr AS (
  SELECT *
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE `workforce` = 'overall'
    AND `report_year` IN (2014, 2024)
)
SELECT
  (MAX(CASE WHEN report_year = 2024 THEN race_asian END) /
   MAX(CASE WHEN report_year = 2014 THEN race_asian END) - 1) AS asian_growth_rate,
  (MAX(CASE WHEN report_year = 2024 THEN race_black END) /
   MAX(CASE WHEN report_year = 2014 THEN race_black END) - 1) AS black_growth_rate,
  (MAX(CASE WHEN report_year = 2024 THEN race_hispanic_latinx END) /
   MAX(CASE WHEN report_year = 2014 THEN race_hispanic_latinx END) - 1) AS latinx_growth_rate,
  (MAX(CASE WHEN report_year = 2024 THEN race_native_american END) /
