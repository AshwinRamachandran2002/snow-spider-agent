  100 * (MAX(CASE WHEN report_year <> 2014 THEN race_hispanic_latinx END) -
         MAX(CASE WHEN report_year  = 2014 THEN race_hispanic_latinx END)) /
        MAX(CASE WHEN report_year  = 2014 THEN race_hispanic_latinx END)  AS pct_growth_latinx,

  100 * (MAX(CASE WHEN report_year <> 2014 THEN race_native_american END) -
         MAX(CASE WHEN report_year  = 2014 THEN race_native_american END)) /
        MAX(CASE WHEN report_year  = 2014 THEN race_native_american END)  AS pct_growth_native_american,

  100 * (MAX(CASE WHEN report_year <> 2014 THEN race_white END) -
         MAX(CASE WHEN report_year  = 2014 THEN race_white END)) /
        MAX(CASE WHEN report_year  = 2014 THEN race_white END)            AS pct_growth_white,

  100 * (MAX(CASE WHEN report_year <> 2014 THEN gender_us_women END) -
         MAX(CASE WHEN report_year  = 2014 THEN gender_us_women END)) /
        MAX(CASE WHEN report_year  = 2014 THEN gender_us_women END)       AS pct_growth_us_women,

  100 * (MAX(CASE WHEN report_year <> 2014 THEN gender_us_men END) -
         MAX(CASE WHEN report_year  = 2014 THEN gender_us_men END)) /
        MAX(CASE WHEN report_year  = 2014 THEN gender_us_men END)         AS pct_growth_us_men,

  100 * (MAX(CASE WHEN report_year <> 2014 THEN gender_global_women END) -
