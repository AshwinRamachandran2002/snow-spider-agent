Begin Exploring Related Columns
Relevant columns & why they matter  

race_asian: 2014‑2024 share of Asians in the overall U.S. Google workforce (needed for growth rate).  
race_black: idem for Black Googlers.  
race_hispanic_latinx: idem for Latinx Googlers.  
race_native_american: idem for Native‑American Googlers.  
race_white: idem for White Googlers.  
gender_us_women: share of U.S. women Googlers (overall workforce).  
gender_us_men: share of U.S. men Googlers (overall workforce).  
gender_global_women: share of women worldwide.  
gender_global_men: share of men worldwide.  
report_year: filter to the start (2014) and end (2024) years and order the series.  
workforce: must equal 'overall' so we stay with the total company workforce.  

Typical filter that will be used  
WHERE workforce = 'overall'  
  AND report_year BETWEEN 2014 AND 2024  

Below are 10 exploratory → analytic queries (all limited to 20 rows). Replace project id if necessary.

```sql
-- 1. Description: list all workforce categories available in the representation table.  
SELECT DISTINCT `workforce`
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
LIMIT 20;
```

```sql
-- 2. Description: list the years that have “overall” records so we know our boundaries.  
SELECT DISTINCT `report_year`
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
ORDER BY `report_year`
LIMIT 20;
```

```sql
-- 3. Description: full racial & gender split for the baseline year 2014, overall workforce.  
SELECT *
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
  AND `report_year` = 2014
LIMIT 20;
```

```sql
-- 4. Description: full racial & gender split for the comparison year 2024, overall workforce.  
SELECT *
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
  AND `report_year` = 2024
LIMIT 20;
```

```sql
-- 5. Description: year‑by‑year trend (2014‑2024) for Asian and Black representation only.  
SELECT `report_year`, `race_asian`, `race_black`
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
  AND `report_year` BETWEEN 2014 AND 2024
ORDER BY `report_year`
LIMIT 20;
```

```sql
-- 6. Description: same period but gender (U.S.) shares, rounded to two decimals.  
SELECT `report_year`,
       ROUND(`gender_us_women`, 4) AS women_us,
       ROUND(`gender_us_men`,   4) AS men_us
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
  AND `report_year` BETWEEN 2014 AND 2024
ORDER BY `report_year`
LIMIT 20;
```

```sql
-- 7. Description: difference (2024 – 2014) in each column using conditional aggregation.  
SELECT
  MAX(CASE WHEN `report_year` = 2014 THEN `race_asian`           END) AS asian_2014,
  MAX(CASE WHEN `report_year` = 2024 THEN `race_asian`           END) AS asian_2024,
  MAX(CASE WHEN `report_year` = 2024 THEN `race_asian` END) -
  MAX(CASE WHEN `report_year` = 2014 THEN `race_asian` END)       AS asian_abs_change,
  MAX(CASE WHEN `report_year` = 2014 THEN `gender_us_women`      END) AS women_us_2014,
  MAX(CASE WHEN `report_year` = 2024 THEN `gender_us_women`      END) AS women_us_2024,
  MAX(CASE WHEN `report_year` = 2024 THEN `gender_us_women` END) -
  MAX(CASE WHEN `report_year` = 2014 THEN `gender_us_women` END)  AS women_us_abs_change
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
  AND `report_year` IN (2014, 2024)
LIMIT 20;
```

```sql
-- 8. Description: compute percentage‑growth (relative) between 2014 and 2024 for every target column.  
SELECT
  100 *
  ( MAX(CASE WHEN `report_year` = 2024 THEN `race_asian` END) -
    MAX(CASE WHEN `report_year` = 2014 THEN `race_asian` END) )
  / MAX(CASE WHEN `report_year` = 2014 THEN `race_asian` END)     AS pct_growth_asian,
  100 *
  ( MAX(CASE WHEN `report_year` = 2024 THEN `race_black` END) -
    MAX(CASE WHEN `report_year` = 2014 THEN `race_black` END) )
  / MAX(CASE WHEN `report_year` = 2014 THEN `race_black` END)     AS pct_growth_black,
  100 *
  ( MAX(CASE WHEN `report_year` = 2024 THEN `race_hispanic_latinx` END) -
    MAX(CASE WHEN `report_year` = 2014 THEN `race_hispanic_latinx` END) )
  / MAX(CASE WHEN `report_year` = 2014 THEN `race_hispanic_latinx` END) AS pct_growth_latinx,
  100 *
  ( MAX(CASE WHEN `report_year` = 2024 THEN `race_native_american` END) -
    MAX(CASE WHEN `report_year` = 2014 THEN `race_native_american` END) )
  / MAX(CASE WHEN `report_year` = 2014 THEN `race_native_american` END) AS pct_growth_native_american,
  100 *
  ( MAX(CASE WHEN `report_year` = 2024 THEN `race_white` END) -
    MAX(CASE WHEN `report_year` = 2014 THEN `race_white` END) )
  / MAX(CASE WHEN `report_year` = 2014 THEN `race_white` END)     AS pct_growth_white,
  100 *
  ( MAX(CASE WHEN `report_year` = 2024 THEN `gender_us_women` END) -
    MAX(CASE WHEN `report_year` = 2014 THEN `gender_us_women` END) )
  / MAX(CASE WHEN `report_year` = 2014 THEN `gender_us_women` END) AS pct_growth_us_women,
  100 *
  ( MAX(CASE WHEN `report_year` = 2024 THEN `gender_us_men` END) -
    MAX(CASE WHEN `report_year` = 2014 THEN `gender_us_men` END) )
  / MAX(CASE WHEN `report_year` = 2014 THEN `gender_us_men` END)   AS pct_growth_us_men,
  100 *
  ( MAX(CASE WHEN `report_year` = 2024 THEN `gender_global_women` END) -
    MAX(CASE WHEN `report_year` = 2014 THEN `gender_global_women` END) )
  / MAX(CASE WHEN `report_year` = 2014 THEN `gender_global_women` END) AS pct_growth_global_women,
  100 *
  ( MAX(CASE WHEN `report_year` = 2024 THEN `gender_global_men` END) -
    MAX(CASE WHEN `report_year` = 2014 THEN `gender_global_men` END) )
  / MAX(CASE WHEN `report_year` = 2014 THEN `gender_global_men` END)   AS pct_growth_global_men
FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
WHERE `workforce` = 'overall'
  AND `report_year` IN (2014, 2024)
LIMIT 20;
```

```sql
-- 9. Description: same growth‑rate calculation but with a reusable window (LAG) for every year.  
WITH base AS (
  SELECT `report_year`,
         `workforce`,
         `race_asian`, `race_black`, `race_hispanic_latinx`, `race_native_american`, `race_white`,
         `gender_us_women`, `gender_us_men`, `gender_global_women`, `gender_global_men`,
         LAG(`race_asian`)  OVER (ORDER BY `report_year`) AS prev_race_asian,
         LAG(`race_black`)  OVER (ORDER BY `report_year`) AS prev_race_black,
         LAG(`gender_us_women`) OVER (ORDER BY `report_year`) AS prev_women_us
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE `workforce` = 'overall'
    AND `report_year` BETWEEN 2014 AND 2024
)
SELECT *
FROM base
LIMIT 20;
```

```sql
--10. Description: final single‑row result giving absolute & % growth from 2014→2024 for every asked metric.  
WITH yrs AS (
  SELECT *
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE `workforce` = 'overall'
    AND `report_year` IN (2014, 2024)
)
SELECT
  -- absolute changes
  MAX(CASE WHEN `report_year` = 2024 THEN `race_asian` END) -
  MAX(CASE WHEN `report_year` = 2014 THEN `race_asian` END)           AS asian_abs_growth,
  MAX(CASE WHEN `report_year` = 2024 THEN `race_black` END) -
  MAX(CASE WHEN `report_year` = 2014 THEN `race_black` END)           AS black_abs_growth,
  MAX(CASE WHEN `report_year` = 2024 THEN `race_hispanic_latinx` END) -
  MAX(CASE WHEN `report_year` = 2014 THEN `race_hispanic_latinx` END) AS latinx_abs_growth,
  MAX(CASE WHEN `report_year` = 2024 THEN `race_native_american` END) -
  MAX(CASE WHEN `report_year` = 2014 THEN `race_native_american` END) AS native_abs_growth,
  MAX(CASE WHEN `report_year` = 2024 THEN `race_white` END) -
  MAX(CASE WHEN `report_year` = 2014 THEN `race_white` END)           AS white_abs_growth,
  MAX(CASE WHEN `report_year` = 2024 THEN `gender_us_women` END) -
  MAX(CASE WHEN `report_year` = 2014 THEN `gender_us_women` END)      AS us_women_abs_growth,
  MAX(CASE WHEN `report_year` = 2024 THEN `gender_us_men` END) -
  MAX(CASE WHEN `report_year` = 2014 THEN `gender_us_men` END)        AS us_men_abs_growth,
  MAX(CASE WHEN `report_year` = 2024 THEN `gender_global_women` END) -
  MAX(CASE WHEN `report_year` = 2014 THEN `gender_global_women` END)  AS global_women_abs_growth,
  MAX(CASE WHEN `report_year` = 2024 THEN `gender_global_men` END) -
  MAX(CASE WHEN `report_year` = 2014 THEN `gender_global_men` END)    AS global_men_abs_growth,

  -- % changes
  100 * (MAX(CASE WHEN `report_year` = 2024 THEN `race_asian` END) -
         MAX(CASE WHEN `report_year` = 2014 THEN `race_asian` END)) /
        MAX(CASE WHEN `report_year` = 2014 THEN `race_asian` END)      AS asian_pct_growth,
  100 * (MAX(CASE WHEN `report_year` = 2024 THEN `race_black` END) -
         MAX(CASE WHEN `report_year` = 2014 THEN `race_black` END)) /
        MAX(CASE WHEN `report_year` = 2014 THEN `race_black` END)      AS black_pct_growth,
  100 * (MAX(CASE WHEN `report_year` = 2024 THEN `race_hispanic_latinx` END) -
         MAX(CASE WHEN `report_year` = 2014 THEN `race_hispanic_latinx` END)) /
        MAX(CASE WHEN `report_year` = 2014 THEN `race_hispanic_latinx` END) AS latinx_pct_growth,
  100 * (MAX(CASE WHEN `report_year` = 2024 THEN `race_native_american` END) -
         MAX(CASE WHEN `report_year` = 2014 THEN `race_native_american` END)) /
        MAX(CASE WHEN `report_year` = 2014 THEN `race_native_american` END) AS native_pct_growth,
  100 * (MAX(CASE WHEN `report_year` = 2024 THEN `race_white` END) -
         MAX(CASE WHEN `report_year` = 2014 THEN `race_white` END)) /
        MAX(CASE WHEN `report_year` = 2014 THEN `race_white` END)      AS white_pct_growth,
  100 * (MAX(CASE WHEN `report_year` = 2024 THEN `gender_us_women` END) -
         MAX(CASE WHEN `report_year` = 2014 THEN `gender_us_women` END)) /
        MAX(CASE WHEN `report_year` = 2014 THEN `gender_us_women` END) AS us_women_pct_growth,
  100 * (MAX(CASE WHEN `report_year` = 2024 THEN `gender_us_men` END) -
         MAX(CASE WHEN `report_year` = 2014 THEN `gender_us_men` END)) /
        MAX(CASE WHEN `report_year` = 2014 THEN `gender_us_men` END)   AS us_men_pct_growth,
  100 * (MAX(CASE WHEN `report_year` = 2024 THEN `gender_global_women` END) -
         MAX(CASE WHEN `report_year` = 2014 THEN `gender_global_women` END)) /
        MAX(CASE WHEN `report_year` = 2014 THEN `gender_global_women` END) AS global_women_pct_growth,
  100 * (MAX(CASE WHEN `report_year` = 2024 THEN `gender_global_men` END) -
         MAX(CASE WHEN `report_year` = 2014 THEN `gender_global_men` END)) /
        MAX(CASE WHEN `report_year` = 2014 THEN `gender_global_men` END)   AS global_men_pct_growth
FROM yrs
LIMIT 20;
```

