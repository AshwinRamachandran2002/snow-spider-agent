  SELECT MAX(report_year) AS end_year
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
    AND report_year <= 2024
),
start AS (
  SELECT
    race_asian           AS asian_start,
    race_black           AS black_start,
    race_hispanic_latinx AS latinx_start,
    race_native_american AS native_start,
    race_white           AS white_start,
    gender_us_women      AS us_women_start,
    gender_us_men        AS us_men_start,
    gender_global_women  AS global_women_start,
    gender_global_men    AS global_men_start
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
    AND report_year = 2014
),
finish AS (
  SELECT
    race_asian           AS asian_end,
    race_black           AS black_end,
    race_hispanic_latinx AS latinx_end,
    race_native_american AS native_end,
    race_white           AS white_end,
    gender_us_women      AS us_women_end,
    gender_us_men        AS us_men_end,
    gender_global_women  AS global_women_end,
    gender_global_men    AS global_men_end
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  JOIN finish_year ON report_year = end_year
  WHERE workforce = 'overall'
)
