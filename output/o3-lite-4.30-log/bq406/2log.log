--Description: 1) Identify the earliest (start_year) and latest (end_year) years that
--   contain rows for the “overall” workforce in the Google DEI representation table.
--2) Grab those two rows (start_data and end_data) and calculate the growth
--   rate for every demographic column between the two endpoints:
--         (value_end - value_start) / value_start
--   This yields a single record with growth rates for Asians, Black, Latinx,
--   Native American, White, U.S. women/men, and global women/men.

WITH year_bounds AS (
  SELECT
    MIN(report_year) AS start_year,
    MAX(report_year) AS end_year
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
),
start_data AS (
  SELECT d.*
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation` AS d
  JOIN year_bounds y ON d.report_year = y.start_year
  WHERE d.workforce = 'overall'
),
end_data AS (
  SELECT d.*
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation` AS d
  JOIN year_bounds y ON d.report_year = y.end_year
  WHERE d.workforce = 'overall'
)
SELECT
  y.start_year,
  y.end_year,
  (e.race_asian           - s.race_asian)            / s.race_asian            AS asian_growth_rate,
  (e.race_black           - s.race_black)            / s.race_black            AS black_growth_rate,
  (e.race_hispanic_latinx - s.race_hispanic_latinx)  / s.race_hispanic_latinx  AS latinx_growth_rate,
  (e.race_native_american - s.race_native_american)  / s.race_native_american  AS native_american_growth_rate,
  (e.race_white           - s.race_white)            / s.race_white            AS white_growth_rate,
  (e.gender_us_women      - s.gender_us_women)       / s.gender_us_women       AS us_women_growth_rate,
  (e.gender_us_men        - s.gender_us_men)         / s.gender_us_men         AS us_men_growth_rate,
  (e.gender_global_women  - s.gender_global_women)   / s.gender_global_women   AS global_women_growth_rate,
  (e.gender_global_men    - s.gender_global_men)     / s.gender_global_men     AS global_men_growth_rate
FROM start_data s
CROSS JOIN end_data e
CROSS JOIN year_bounds y;
