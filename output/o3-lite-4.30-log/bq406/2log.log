--Description: 7) Compute growth rates for each race category (dynamic earliest → latest years) in the overall workforce.
WITH bounds AS (
  SELECT MIN(report_year) AS start_year,
         MAX(report_year) AS end_year
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation`
  WHERE workforce = 'overall'
),
start_row AS (
  SELECT d.*
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation` AS d
  JOIN bounds b ON d.report_year = b.start_year
  WHERE d.workforce = 'overall'
),
end_row AS (
  SELECT d.*
  FROM `bigquery-public-data.google_dei.dar_non_intersectional_representation` AS d
  JOIN bounds b ON d.report_year = b.end_year
  WHERE d.workforce = 'overall'
)
SELECT
  (e.race_asian           - s.race_asian)            / s.race_asian           AS asian_growth_rate,
  (e.race_black           - s.race_black)            / s.race_black           AS black_growth_rate,
  (e.race_hispanic_latinx - s.race_hispanic_latinx)  / s.race_hispanic_latinx AS latinx_growth_rate,
  (e.race_native_american - s.race_native_american)  / s.race_native_american AS native_growth_rate,
  (e.race_white           - s.race_white)            / s.race_white           AS white_growth_rate
FROM start_row AS s
CROSS JOIN end_row  AS e
