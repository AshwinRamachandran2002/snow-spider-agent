Begin Exploring Related Columns
Relevant tables & columns and their potential usage  

bigquery-public-data.the_met.objects  
• object_id: join key to images table  
• department: filter rows to “Photographs”  
• object_name: look for the word “Photograph”  
• title: return artwork title  
• artist_display_name: filter out “Unknown”; return artist name  
• object_end_date: be ≤ 1839  
• medium: return medium description  

bigquery-public-data.the_met.images  
• object_id: join key to objects table  
• original_image_url: return image url  


Typical conditions  
• department = 'Photographs'  
• LOWER(object_name) LIKE '%photograph%'  
• artist_display_name IS NOT NULL AND LOWER(artist_display_name) NOT LIKE '%unknown%'  
• object_end_date <= 1839  


Ten exploratory‑to‑final queries
```sql
-- 1. Quick look at departments that contain “Photograph”
SELECT DISTINCT department
FROM `bigquery-public-data.the_met.objects`
WHERE LOWER(department) LIKE '%photo%'
LIMIT 20;
```

```sql
-- 2. Count objects in the Photographs department
SELECT COUNT(*) AS cnt
FROM `bigquery-public-data.the_met.objects`
WHERE department = 'Photographs';
```

```sql
-- 3. See some object_names that mention photograph
SELECT object_id, object_name
FROM `bigquery-public-data.the_met.objects`
WHERE department = 'Photographs'
  AND LOWER(object_name) LIKE '%photograph%'
LIMIT 20;
```

```sql
-- 4. Check how many of those have “Unknown” artists
SELECT COUNT(*) AS unknown_cnt
FROM `bigquery-public-data.the_met.objects`
WHERE department = 'Photographs'
  AND LOWER(object_name) LIKE '%photograph%'
  AND (artist_display_name IS NULL OR LOWER(artist_display_name) LIKE '%unknown%');
```

```sql
-- 5. Preview objects that satisfy dept, name, known artist
SELECT object_id, title, artist_display_name, object_end_date
FROM `bigquery-public-data.the_met.objects`
WHERE department = 'Photographs'
  AND LOWER(object_name) LIKE '%photograph%'
  AND artist_display_name IS NOT NULL
  AND LOWER(artist_display_name) NOT LIKE '%unknown%'
LIMIT 20;
```

```sql
-- 6. Add date filter (object_end_date <= 1839)
SELECT object_id, title, artist_display_name, object_end_date
FROM `bigquery-public-data.the_met.objects`
WHERE department = 'Photographs'
  AND LOWER(object_name) LIKE '%photograph%'
  AND artist_display_name IS NOT NULL
  AND LOWER(artist_display_name) NOT LIKE '%unknown%'
  AND object_end_date <= 1839
LIMIT 20;
```

```sql
-- 7. Join images to get image URLs (one row per image)
SELECT o.object_id,
       o.title,
       o.artist_display_name,
       o.medium,
       i.original_image_url
FROM `bigquery-public-data.the_met.objects` AS o
JOIN `bigquery-public-data.the_met.images`  AS i
  ON o.object_id = i.object_id
WHERE o.department = 'Photographs'
  AND LOWER(o.object_name) LIKE '%photograph%'
  AND o.artist_display_name IS NOT NULL
  AND LOWER(o.artist_display_name) NOT LIKE '%unknown%'
  AND o.object_end_date <= 1839
LIMIT 20;
```

```sql
-- 8. Same as #7 but DISTINCT to avoid duplicates when multiple images share fields
SELECT DISTINCT
       o.title,
       o.artist_display_name,
       o.medium
FROM `bigquery-public-data.the_met.objects` AS o
WHERE o.department = 'Photographs'
  AND LOWER(o.object_name) LIKE '%photograph%'
  AND o.artist_display_name IS NOT NULL
  AND LOWER(o.artist_display_name) NOT LIKE '%unknown%'
  AND o.object_end_date <= 1839
LIMIT 20;
```

```sql
-- 9. Aggregate multiple image URLs per object into an array
SELECT o.title,
       o.artist_display_name AS artist_name,
       o.medium,
       ARRAY_AGG(i.original_image_url ORDER BY i.original_image_url) AS image_urls
FROM `bigquery-public-data.the_met.objects`  AS o
JOIN `bigquery-public-data.the_met.images`   AS i
  ON o.object_id = i.object_id
WHERE o.department = 'Photographs'
  AND LOWER(o.object_name) LIKE '%photograph%'
  AND o.artist_display_name IS NOT NULL
  AND LOWER(o.artist_display_name) NOT LIKE '%unknown%'
  AND o.object_end_date <= 1839
GROUP BY o.title, artist_name, o.medium
LIMIT 20;
```

```sql
-- 10. Final answer: titles, artist names, mediums, and image URLs
SELECT
  o.title                                   AS title,
  o.artist_display_name                     AS artist_name,
  o.medium                                  AS medium,
  i.original_image_url                      AS original_image_url
FROM `bigquery-public-data.the_met.objects` AS o
JOIN `bigquery-public-data.the_met.images`  AS i
  ON o.object_id = i.object_id
WHERE o.department = 'Photographs'
  AND LOWER(o.object_name) LIKE '%photograph%'
  AND o.artist_display_name IS NOT NULL
  AND LOWER(o.artist_display_name) NOT LIKE '%unknown%'
  AND o.object_end_date <= 1839
ORDER BY o.title
LIMIT 20;
```
