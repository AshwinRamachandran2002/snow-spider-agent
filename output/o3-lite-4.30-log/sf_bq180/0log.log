SELECT 
       module              AS module_name,
       frequency           AS module_frequency
FROM (
        /* Count occurrences of each extracted module/package */
        SELECT 
               module,
               COUNT(*)    AS frequency
        FROM (
                 /* -------- Python: import / from‑import -------- */
                 SELECT REGEXP_SUBSTR(c."content",
                                      '\\b(import|from)\\s+([A-Za-z_][A-Za-z0-9_\\.]*)',
                                      1, 1, 'e', 2)  AS module
                 FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
                 JOIN   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
                        ON c."id" = f."id"
                 WHERE  f."path" ILIKE '%.py'

                 UNION ALL

                 /* -------- R: library() / require() -------- */
                 SELECT REGEXP_SUBSTR(c."content",
                                      '\\b(library|require)\\s*\\(\\s*["'']?([A-Za-z0-9_\\.]+)',
                                      1, 1, 'e', 2)  AS module
                 FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
                 JOIN   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
                        ON c."id" = f."id"
                 WHERE  f."path" ILIKE '%.r'
             ) extracted
        WHERE  module IS NOT NULL
        GROUP BY module
     ) counted
ORDER BY 
         frequency DESC NULLS LAST,
         module_name        -- secondary alphabetical ordering
LIMIT 5;
```
