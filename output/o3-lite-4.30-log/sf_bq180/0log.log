```sql
WITH python_modules AS (
    SELECT REGEXP_SUBSTR(c."content",
                         '\\b(import|from)\\s+([A-Za-z_][A-Za-z0-9_\\.]+)',
                         1, SEQ4(), 'e', 2) AS module
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES      f
    JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS   c
          ON c."id" = f."id"
    CROSS JOIN TABLE(GENERATOR(ROWCOUNT => 100))
    WHERE f."path" ILIKE '%.py'
),
r_packages AS (
    SELECT REGEXP_SUBSTR(c."content",
                         '\\b(library|require)\\s*\\(\\s*["'']?([A-Za-z0-9_\\.]+)',
                         1, SEQ4(), 'e', 2) AS module
    FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES      f
    JOIN GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS   c
          ON c."id" = f."id"
    CROSS JOIN TABLE(GENERATOR(ROWCOUNT => 100))
    WHERE f."path" ILIKE '%.r'
),
all_modules AS (
    SELECT module FROM python_modules
    UNION ALL
    SELECT module FROM r_packages
)
SELECT 
       module                         AS module_name,
       COUNT(*)::NUMBER(38,4)         AS module_frequency
FROM   all_modules
WHERE  module IS NOT NULL
GROUP  BY module
ORDER  BY module_frequency DESC NULLS LAST,
          module_name
LIMIT 5;
```
