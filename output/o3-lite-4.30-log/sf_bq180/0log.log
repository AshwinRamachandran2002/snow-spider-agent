```sql
--Description: Combine Python and R script analysis.  
-- 1) Join SAMPLE_FILES with SAMPLE_CONTENTS so we have both the file path (to filter by
--    language) and the text (to inspect).  
-- 2) For Python files (*.py) capture the first token after “import ” or “from ” using
--    REGEXP_SUBSTR; this represents the imported module.  
-- 3) For R files (*.r / *.R) capture the package name that appears in library() or
--    require() calls.  
-- 4) UNION ALL both result sets, discard NULL captures, aggregate, and return the five
--    most frequently referenced module / package names across the two languages.
SELECT  "module",
        COUNT(*) AS "frequency"
FROM   (
        -----------------------------------------------------------------
        -- Python (*.py) – grab module name after import / from statements
        -----------------------------------------------------------------
        SELECT REGEXP_SUBSTR(c."content",
                             '\\b(import|from)\\s+([A-Za-z0-9_\\.]+)',
                             1, 1, 'e', 2)  AS "module"
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"    f
        JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
               ON c."id" = f."id"
        WHERE  f."path" ILIKE '%.py'

        UNION ALL

        -----------------------------------------------------------------
        -- R (*.r / *.R) – grab package name inside library()/require()
        -----------------------------------------------------------------
        SELECT REGEXP_SUBSTR(c."content",
                             '\\b(library|require)\\s*\\(\\s*["'']?([A-Za-z0-9_\\.]+)',
                             1, 1, 'e', 2)  AS "module"
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"    f
        JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" c
               ON c."id" = f."id"
        WHERE  f."path" ILIKE '%.r'
      ) AS combined
WHERE  "module" IS NOT NULL
GROUP BY "module"
ORDER BY "frequency" DESC
LIMIT 5;
```
