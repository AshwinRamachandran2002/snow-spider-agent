```sql
--Description: 10) End‑to‑end aggregation – count how many times each Python
--             module or R package is referenced (imports, library/require).
--             Replaces non‑capturing groups with regular ones and specifies
--             sub‑expression 2 to return the name.
SELECT  "module",
        COUNT(*) AS "freq"
FROM   (
        /* Python modules */
        SELECT LOWER(
                 REGEXP_SUBSTR(
                   l.value::STRING,
                   '\\b(from|import)\\s+([A-Za-z0-9_\\.]+)',
                   1, 1, 'i', 2   -- capture group 2 = module name
                 )
               ) AS "module"
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc,
               LATERAL FLATTEN(input => SPLIT(sc."content", '\n')) l
        WHERE  sc."sample_path" ILIKE '%.py'

        UNION ALL

        /* R packages */
        SELECT LOWER(
                 REGEXP_SUBSTR(
                   l.value::STRING,
                   '(library|require)\\s*\\(\\s*([A-Za-z0-9_\\.]+)',
                   1, 1, 'i', 2   -- capture group 2 = package name
                 )
               ) AS "module"
        FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc,
               LATERAL FLATTEN(input => SPLIT(sc."content", '\n')) l
        WHERE  sc."sample_path" ILIKE '%.r'
       ) AS all_calls
WHERE   "module" IS NOT NULL
GROUP BY "module"
ORDER BY "freq" DESC
LIMIT 20;
```
