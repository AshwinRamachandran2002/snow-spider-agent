```sql
--Description: Extract distinct top‑level module names that appear in Python
--             `import ...` or `from ... import ...` statements.  We work
--             entirely inside SAMPLE_CONTENTS (no join needed), split each
--             Python file into individual lines via LATERAL FLATTEN, and use
--             the six‑parameter form of REGEXP_SUBSTR so the **first capture
--             group** (the module name) is returned.  Lines that do not match
--             yield NULL and are filtered out.  Finally we show up to 20
--             distinct module names for inspection.
WITH py_lines AS (
    SELECT TRIM(f.value)::STRING AS line
    FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc,
           LATERAL FLATTEN(input => SPLIT(sc."content", '\n')) f
    WHERE  sc."sample_path" ILIKE '%.py'
)
SELECT DISTINCT
       LOWER(
           REGEXP_SUBSTR(
               line,
               '\\b(?:from|import)\\s+([A-Za-z0-9_\\.]+)',
               1, 1,     -- start at pos 1, take 1st occurrence
               'i',      -- case‑insensitive
               1         -- return 1st capture group (module name)
           )
       ) AS "module"
