Begin Exploring Related Columns
Below are the main columns that will be useful for eventually finding the most common imported / required modules, together with typical filter conditions you will probably apply.

• "path": lets us restrict to Python (*.py) and R (*.r) source files.  
  Condition idea → WHERE "path" ILIKE '%.py'   or   WHERE "path" ILIKE '%.r'

• "id": content hash that ties a row in GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES to the actual code in GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS.  
  Condition idea → JOIN … ON sf."id" = sc."id"

• "content": full source code text, needed to GREP‑like search for
  – Python:  ‘import ’ / ‘from ’  
  – R:        ‘library(’ / ‘require(’

No JSON‑formatted columns are involved, so no LATERAL FLATTEN is needed.



-- ‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑-
-- Ten exploratory Snowflake SQL queries
-- ‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑‑-

```sql
--Description: 1) Peek at 20 distinct Python file paths
SELECT DISTINCT "path"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.py'
LIMIT 20;
```

```sql
--Description: 2) Peek at 20 distinct R file paths
SELECT DISTINCT "path"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.r'
LIMIT 20;
```

```sql
--Description: 3) Show a Python file together with its SHA‑1 id so we can join to contents
SELECT "repo_name", "path", "id"
FROM "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "path" ILIKE '%.py'
LIMIT 20;
```

```sql
--Description: 4) Join one Python file to its actual source text
SELECT sf."repo_name",
       sf."path",
       sc."content"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  sf
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc
       ON sf."id" = sc."id"
WHERE  sf."path" ILIKE '%.py'
LIMIT 20;
```

```sql
--Description: 5) Pull out just the lines that look like Python 'import' statements
SELECT sf."path",
       REGEXP_SUBSTR(sc."content", '^(.*import .*?)$', 1, 1, 'm') AS "import_line"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"      sf
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   sc
       ON sf."id" = sc."id"
WHERE  sf."path" ILIKE '%.py'
LIMIT 20;
```

```sql
--Description: 6) Pull out Python 'from X import Y' lines
SELECT sf."path",
       REGEXP_SUBSTR(sc."content", '^(.*from .*? import .*?)$', 1, 1, 'm') AS "from_line"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"      sf
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   sc
       ON sf."id" = sc."id"
WHERE  sf."path" ILIKE '%.py'
LIMIT 20;
```

```sql
--Description: 7) Show R 'library()' / 'require()' calls
SELECT sf."path",
       REGEXP_SUBSTR(sc."content", '^(.*(library|require)\\s*\\(.*?\\).*)$', 1, 1, 'mi') AS "library_line"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"      sf
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   sc
       ON sf."id" = sc."id"
WHERE  sf."path" ILIKE '%.r'
LIMIT 20;
```

```sql
--Description: 8) Make a very rough count of how many import‑style statements appear in each Python file
SELECT sf."path",
       REGEXP_COUNT(sc."content", '\\n\\s*(import|from)\\s+', 'mi') AS "import_ct"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"  sf
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc
       ON sf."id" = sc."id"
WHERE  sf."path" ILIKE '%.py'
ORDER BY "import_ct" DESC
LIMIT 20;
```

```sql
--Description: 9) Prototype extraction of a single module name from Python 'import' lines
SELECT DISTINCT
       TRIM(REGEXP_REPLACE(REGEXP_SUBSTR(sc."content",
              '\\n\\s*(?:from|import)\\s+([A-Za-z0-9_\\.]+)', 1, s.seq, 'mi'), 
              '\\n|\\r', '')) AS "module"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"    sf,
       LATERAL GENERATOR(ROW_NUMBER() OVER()) s        -- small helper to iterate REGEXP_SUBSTR
JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc
       ON sf."id" = sc."id"
WHERE  sf."path" ILIKE '%.py'
LIMIT 20;
```

```sql
--Description: 10) Very rough end‑to‑end draft: count module occurrences for both languages
SELECT "module", COUNT(*) AS "freq"
FROM (
      -- Python modules
      SELECT LOWER(REGEXP_SUBSTR(line, '^(?:from|import)\\s+([A-Za-z0-9_\\.]+)', 1, 1, 'i', 1)) AS module
      FROM (
            SELECT SPLIT(sc."content", '\n') AS lines
            FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"      sf
            JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   sc
                   ON sf."id" = sc."id"
            WHERE  sf."path" ILIKE '%.py'
      ), LATERAL FLATTEN(input => lines) f, LATERAL (
            SELECT f.value::STRING AS line
      )

      UNION ALL

      -- R packages
      SELECT LOWER(REGEXP_SUBSTR(line, '(?:library|require)\\s*\\(\\s*([A-Za-z0-9_\\.]+)', 1, 1, 'i', 1)) AS module
      FROM (
            SELECT SPLIT(sc."content", '\n') AS lines
            FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"      sf
            JOIN   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   sc
                   ON sf."id" = sc."id"
            WHERE  sf."path" ILIKE '%.r'
      ), LATERAL FLATTEN(input => lines) f, LATERAL (
            SELECT f.value::STRING AS line
      )
)
WHERE "module" IS NOT NULL
GROUP BY "module"
ORDER BY "freq" DESC
LIMIT 20;
```

