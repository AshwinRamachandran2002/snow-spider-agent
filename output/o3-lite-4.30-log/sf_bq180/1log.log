Query:
--Description: 9) Prototype – extract distinct top‑level module names referenced
--             in Python `import` / `from` lines (no unsupported “?:” syntax).
--             Uses two capture groups; sub‑expression index 2 returns module.
SELECT DISTINCT
       LOWER(
           REGEXP_SUBSTR(
               l.value::STRING,
               '\\b(from|import)\\s+([A-Za-z0-9_\\.]+)',  -- two captures
               1, 1, 'i', 2                                -- return 2nd group
           )
       ) AS "module"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc,
       LATERAL FLATTEN(input => SPLIT(sc."content", '\n')) l
WHERE  sc."sample_path" ILIKE '%.py'
  AND  l.value::STRING ILIKE '%import%'
LIMIT 20
