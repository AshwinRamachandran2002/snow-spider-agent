--Description: Earlier attempts using line‑anchored patterns returned no data,
--             suggesting that many R scripts may indent or otherwise format
--             their package‑loading calls differently.  To confirm whether any
--             R files actually contain `library()` or `require()`, this query
--             relaxes the criteria by:
--               • Filtering files by extension “.r”.
--               • Joining to the content table via the SHA‑1 “id”.
--               • Searching the entire file text (ILIKE) for either substring
--                 “library(” or “require(”.
--             For a quick visual check we also extract (via REGEXP_SUBSTR) the
--             first such call that appears, regardless of indentation.
SELECT  sf."path",
        REGEXP_SUBSTR(
            sc."content",
            '(library|require)\\s*\\(\\s*[A-Za-z0-9_\\.]+',
            1, 1, 'mi'
        ) AS "first_pkg_call"
FROM    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_FILES"    sf
JOIN    "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc
        ON sf."id" = sc."id"
WHERE   sf."path" ILIKE '%.r'
  AND  (sc."content" ILIKE '%library(%'
        OR sc."content" ILIKE '%require(%')
LIMIT 20;
