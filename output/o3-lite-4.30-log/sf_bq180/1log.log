--Description: 9) Prototype: extract distinct top‑level module names referenced
--             in Python `import` / `from` lines, again reading directly from
--             SAMPLE_CONTENTS and splitting each file into lines.
SELECT DISTINCT
       LOWER(
           REGEXP_SUBSTR(l.value::STRING,
                          '\\b(?:from|import)\\s+([A-Za-z0-9_\\.]+)',
                          1, 1, 'i', 1)
       ) AS "module"
FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS"   sc,
       LATERAL FLATTEN(input => SPLIT(sc."content", '\n')) l
WHERE  sc."sample_path" ILIKE '%.py'
