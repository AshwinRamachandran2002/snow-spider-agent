```sql
--Description: Extract distinct module names that appear in Python `import` or
--             `from … import` statements without using the unsupported
--             non‑capturing group syntax.  Strategy:
--               1) Select every “.py” file in SAMPLE_CONTENTS.
--               2) Split each file into individual lines via LATERAL FLATTEN.
--               3) For each line, use REGEXP_SUBSTR with two capturing groups:
--                    • group 1 captures the keyword  (from|import)
--                    • group 2 captures the module name
--                  Asking for capture‑group 2 returns only the module name.
--               4) Lower‑case, drop NULLs, and show 20 unique modules.
WITH py_lines AS (
    SELECT f.value::STRING AS line
    FROM   "GITHUB_REPOS"."GITHUB_REPOS"."SAMPLE_CONTENTS" sc,
           LATERAL FLATTEN(input => SPLIT(sc."content", '\n')) f
    WHERE  sc."sample_path" ILIKE '%.py'
)
SELECT DISTINCT
       LOWER(
           REGEXP_SUBSTR(
               line,
               '\\b(from|import)\\s+([A-Za-z0-9_\\.]+)',
               1,        -- start position
               1,        -- first occurrence
               'i',      -- case‑insensitive
               2         -- return 2nd capture group (module name)
           )
       ) AS "module"
FROM   py_lines
WHERE  "module" IS NOT NULL
LIMIT 20;
```
