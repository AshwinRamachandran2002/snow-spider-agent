```sql
--Description: 8. Extract up to 20 lines from R scripts that contain the keyword
--             “library(”.  The search is case‑insensitive (%library(%).  An INNER
--             JOIN is kept because we do need the file contents to scan, but the
--             ILIKE pattern is widened to “%library(%” so more matches are likely.
SELECT  f."path"                     AS "file",
        line.value::STRING           AS "code_line"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
JOIN    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
        ON f."id" = c."id",
        LATERAL FLATTEN( INPUT => SPLIT(c."content", '\n') ) line
WHERE   (f."path" ILIKE '%.r' OR f."path" ILIKE '%.R')
  AND   line.value::STRING ILIKE '%library(%'
LIMIT   20;
```

```sql
--Description: 9. Pull distinct library() statements and associated package names
--             from R scripts.  The first REGEXP_SUBSTR returns the complete
--             “library(pkg)” snippet; the second (capturing group 1) isolates
--             just the package name.  The pattern is case‑insensitive via ILIKE.
SELECT DISTINCT
       REGEXP_SUBSTR(line.value::STRING,
                     'library\\s*\\(\\s*([A-Za-z0-9_\\.]+)',
                     1, 1, 'e')  AS "raw_stmt",
       REGEXP_SUBSTR(line.value::STRING,
                     'library\\s*\\(\\s*([A-Za-z0-9_]+)',
                     1, 1, 'e', 1) AS "package"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
JOIN   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
       ON f."id" = c."id",
       LATERAL FLATTEN( INPUT => SPLIT(c."content", '\n') ) line
WHERE  (f."path" ILIKE '%.r' OR f."path" ILIKE '%.R')
  AND  line.value::STRING ILIKE '%library(%'
LIMIT  20;
```

```sql
--Description: 10. Combine Python and R extractions, counting the 20 most frequent
--             module/package names.  The R extraction has been simplified to
--             keep the correct capture index (1).  The ILIKE pattern for R now
--             uses “%library(%” to broaden matches.
WITH py AS (
    SELECT LOWER(
           REGEXP_SUBSTR(line.value::STRING,
                         '^\\s*(from|import)\\s+([A-Za-z0-9_]+)',
                         1, 1, 'e', 2) ) AS name
    FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
    JOIN   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
           ON f."id" = c."id",
           LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) line
    WHERE  f."path" ILIKE '%.py'
      AND (line.value::STRING ILIKE 'import %'
           OR line.value::STRING ILIKE 'from %')
), r AS (
    SELECT LOWER(
           REGEXP_SUBSTR(line.value::STRING,
                         'library\\s*\\(\\s*([A-Za-z0-9_]+)',
                         1, 1, 'e', 1) ) AS name
    FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
    JOIN   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
           ON f."id" = c."id",
           LATERAL FLATTEN(INPUT => SPLIT(c."content", '\n')) line
    WHERE  (f."path" ILIKE '%.r' OR f."path" ILIKE '%.R')
      AND  line.value::STRING ILIKE '%library(%'
)
SELECT  name,
        COUNT(*) AS occurrences
FROM   (SELECT * FROM py UNION ALL SELECT * FROM r)
WHERE   name IS NOT NULL
GROUP  BY name
ORDER  BY occurrences DESC
LIMIT  20;
```
