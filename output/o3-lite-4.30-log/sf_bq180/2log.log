```sql
--Description: Determine whether any file in the sample (regardless of extension)
--             contains an R‑style package‑loading call “library(…)”.  We
--             1) join file metadata (SAMPLE_FILES) to stored text (SAMPLE_CONTENTS),
--             2) filter on the substring “library(” in a case‑insensitive way,
--             3) extract the first matching call with REGEXP_SUBSTR for context,
--             4) limit to 20 rows for quick inspection.  This broad search
--             confirms if such statements exist at all before narrowing filters.
SELECT  f."path" AS "file",
        REGEXP_SUBSTR(c."content",
                      'library\\s*\\([^\\n]*',
                      1, 1, 'i') AS "code_line"
FROM    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS   c
JOIN    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES      f
       ON c."id" = f."id"
WHERE   c."content" ILIKE '%library(%'
LIMIT   20;
```
