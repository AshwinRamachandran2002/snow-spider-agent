```sql
-- 9. Description: Draft extraction of package names from R library() calls
SELECT DISTINCT
       REGEXP_SUBSTR(line.value::STRING,
                     'library\\s*\\(\\s*([A-Za-z0-9_\\.]+)',
                     1, 1, 'e', 1)           AS "raw_stmt",
       REGEXP_SUBSTR(line.value::STRING,
                     'library\\s*\\(\\s*([A-Za-z0-9_]+)',
                     1, 1, 'e', 2)           AS "package"
FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES    f
JOIN   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS c
       ON f."id" = c."id",
       LATERAL FLATTEN( INPUT => SPLIT(c."content", '\n') ) line
WHERE  f."path" ILIKE '%.r'
  AND  line.value::STRING ILIKE 'library(%'
LIMIT  20;
```

```sql
-- 10. Description: Combine Python & R extractions and tally module/package counts (top 20, not final 5)
WITH py AS (
  SELECT
    LOWER( REGEXP_SUBSTR(line.value::STRING,
                         '^(?:from|import)\\s+([A-Za-z0-9_]+)',
                         1, 1, 'e', 2) )  AS "name"
  FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES    f
  JOIN   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS c
         ON f."id" = c."id",
         LATERAL FLATTEN( INPUT => SPLIT(c."content", '\n') ) line
  WHERE  f."path" ILIKE '%.py'
    AND  ( line.value::STRING ILIKE 'import %'
           OR line.value::STRING ILIKE 'from %' )
    AND  "name" IS NOT NULL
), r AS (
  SELECT
    LOWER( REGEXP_SUBSTR(line.value::STRING,
                         'library\\s*\\(\\s*([A-Za-z0-9_]+)',
                         1, 1, 'e', 2) )   AS "name"
  FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES    f
  JOIN   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS c
         ON f."id" = c."id",
         LATERAL FLATTEN( INPUT => SPLIT(c."content", '\n') ) line
  WHERE  f."path" ILIKE '%.r'
    AND  line.value::STRING ILIKE 'library(%'
    AND  "name" IS NOT NULL
)
SELECT "name",
       COUNT(*) AS "occurrences"
FROM   (SELECT * FROM py UNION ALL SELECT * FROM r)
GROUP  BY 1
ORDER  BY 2 DESC
LIMIT  20;
```

These queries step from simple inspection to an aggregated count that can be refined to return the top 5 module / package names as required.
