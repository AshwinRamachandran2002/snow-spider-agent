JOIN    GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS   c
       ON f."id" = c."id"
WHERE   LOWER(f."path") LIKE '%.r'      -- restrict to R scripts
  AND  (c."content" ILIKE '%library(%'  -- file contains a load statement
        OR c."content" ILIKE '%require(%')
LIMIT   20;
