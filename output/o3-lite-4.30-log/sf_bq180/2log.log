```sql
--Description: Identify the five most frequently imported / loaded modules
--             across Python (.py) and R (.r) files in the sample.
--             ──────────────────────────────────────────────────────────
--   1. py CTE: for every Python file, split its text into lines, retain
--      lines that look like “import X” or “from X”, then pull out X
--      (1st identifier after the keyword).  The REGEXP_SUBSTR call
--      requests capturing group 2 (the module name) and converts it to
--      lower‑case for uniform counting.
--   2. r  CTE: for every R file, do the same but look for
--      “library(X)” and capture X (group 1).
--   3. UNION ALL the two lists, aggregate, order by frequency, and keep
--      the top five names.
WITH py AS (
    SELECT
        LOWER(
            REGEXP_SUBSTR(
                line.value::STRING,
                '^\\s*(from|import)\\s+([A-Za-z0-9_]+)',   -- group 2 = module
                1, 1, 'e', 2)
        ) AS name
    FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
    JOIN   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
           ON f."id" = c."id",
           LATERAL FLATTEN(input => SPLIT(c."content", '\n')) line
    WHERE  f."path" ILIKE '%.py'
      AND ( line.value::STRING ILIKE 'import %'
            OR line.value::STRING ILIKE 'from %' )
      AND  REGEXP_SUBSTR(
                line.value::STRING,
                '^\\s*(from|import)\\s+([A-Za-z0-9_]+)',
                1, 1, 'e', 2) IS NOT NULL
), r AS (
    SELECT
        LOWER(
            REGEXP_SUBSTR(
                line.value::STRING,
                'library\\s*\\(\\s*([A-Za-z0-9_]+)',       -- group 1 = package
                1, 1, 'e', 1)
        ) AS name
    FROM   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_FILES     f
    JOIN   GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS  c
           ON f."id" = c."id",
           LATERAL FLATTEN(input => SPLIT(c."content", '\n')) line
    WHERE  f."path" ILIKE '%.r'
      AND  line.value::STRING ILIKE 'library(%'
      AND  REGEXP_SUBSTR(
                line.value::STRING,
                'library\\s*\\(\\s*([A-Za-z0-9_]+)',
                1, 1, 'e', 1) IS NOT NULL
)
SELECT  name,
        COUNT(*) AS occurrences
FROM    (SELECT * FROM py UNION ALL SELECT * FROM r)
GROUP BY name
ORDER BY occurrences DESC
LIMIT 5;
```
