Relevant columns & their potential use  
• TOKENS."symbol": find ERC‑20 contract(s) whose symbol is ‘BNB’.  
• TOKENS."address": the contract address(es) belonging to BNB; used to filter TOKEN_TRANSFERS.  
• TOKEN_TRANSFERS."token_address": match with BNB contract address to isolate BNB transfers.  
• TOKEN_TRANSFERS."from_address": address that sent BNB – used to total tokens sent.  
• TOKEN_TRANSFERS."to_address": address that received BNB – used to total tokens received.  
• TOKEN_TRANSFERS."value": raw token amount (string). Cast to NUMBER and divide by 10^18 to get human units.  
• TOKEN_TRANSFERS."block_timestamp" & "block_number": optional time / block filters.  

Typical conditions  
• TOKENS."symbol" ILIKE '%BNB%'                        – locate the BNB contract.  
• TOKEN_TRANSFERS."token_address" IN (<BNB address>)   – keep only BNB transfers.  
• TOKEN_TRANSFERS."from_address" <> '0x0000000000000000000000000000000000000000'  
• TOKEN_TRANSFERS."to_address"   <> '0x0000000000000000000000000000000000000000'  

Below are ten exploratory Snowflake SQL queries (simple → complex) that step through the logic needed to calculate circulating supply.  
(Adjust the contract address identified in Q1/Q2 if multiple BNB rows appear.)

```sql
--1. Description: peek at all ERC‑20 tokens whose symbol contains ‘BNB’.
SELECT *
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
WHERE "symbol" ILIKE '%BNB%'
LIMIT 20;
```

```sql
--2. Description: grab the distinct contract address(es) for BNB from the TOKENS table.
SELECT DISTINCT "address"      AS "bnb_contract_address",
       "block_number",
       "block_timestamp"
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
WHERE "symbol" ILIKE '%BNB%'
LIMIT 20;
```

```sql
--3. Description: display a few raw TOKEN_TRANSFERS rows that reference the BNB contract.
SELECT *
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS" t
WHERE t."token_address" IN (   --use addresses returned in query 2
      SELECT DISTINCT "address"
      FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
      WHERE "symbol" ILIKE '%BNB%' )
LIMIT 20;
```

```sql
--4. Description: count how many BNB transfer logs exist overall.
SELECT COUNT(*) AS "bnb_transfer_count"
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
WHERE "token_address" IN (
      SELECT DISTINCT "address"
      FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
      WHERE "symbol" ILIKE '%BNB%' );
```

```sql
--5. Description: show total BNB (raw Wei‑style units) that has ever moved through TOKEN_TRANSFERS.
SELECT SUM(TRY_TO_DECIMAL("value")) AS "total_bnb_raw"
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
WHERE "token_address" IN (
      SELECT DISTINCT "address"
      FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
      WHERE "symbol" ILIKE '%BNB%' );
```

```sql
--6. Description: total BNB each address ever RECEIVED (exclude zero address).
SELECT "to_address",
       SUM(TRY_TO_DECIMAL("value") / 1e18) AS "bnb_received"
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
WHERE "token_address" IN (
      SELECT DISTINCT "address"
      FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
      WHERE "symbol" ILIKE '%BNB%' )
  AND "to_address" <> '0x0000000000000000000000000000000000000000'
GROUP BY "to_address"
ORDER BY "bnb_received" DESC
LIMIT 20;
```

```sql
--7. Description: total BNB each address ever SENT (exclude zero address).
SELECT "from_address",
       SUM(TRY_TO_DECIMAL("value") / 1e18) AS "bnb_sent"
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
WHERE "token_address" IN (
      SELECT DISTINCT "address"
      FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
      WHERE "symbol" ILIKE '%BNB%' )
  AND "from_address" <> '0x0000000000000000000000000000000000000000'
GROUP BY "from_address"
ORDER BY "bnb_sent" DESC
LIMIT 20;
```

```sql
--8. Description: combine sent vs. received to compute net balance per address.
WITH
recv AS (
  SELECT "to_address"  AS addr,
         SUM(TRY_TO_DECIMAL("value")) AS recv_raw
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
  WHERE "token_address" IN (
        SELECT DISTINCT "address"
        FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
        WHERE "symbol" ILIKE '%BNB%' )
    AND "to_address" <> '0x0000000000000000000000000000000000000000'
  GROUP BY "to_address"
),
sent AS (
  SELECT "from_address" AS addr,
         SUM(TRY_TO_DECIMAL("value")) AS sent_raw
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
  WHERE "token_address" IN (
        SELECT DISTINCT "address"
        FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
        WHERE "symbol" ILIKE '%BNB%' )
    AND "from_address" <> '0x0000000000000000000000000000000000000000'
  GROUP BY "from_address"
)
SELECT r.addr                                       AS "address",
       COALESCE(r.recv_raw, 0)  - COALESCE(s.sent_raw, 0) AS "net_raw_units",
       (COALESCE(r.recv_raw, 0) - COALESCE(s.sent_raw, 0)) / 1e18  AS "net_bnb"
FROM recv r
LEFT JOIN sent s  ON r.addr = s.addr
UNION
SELECT s.addr,
       -s.sent_raw        AS net_raw_units,
       (-s.sent_raw) / 1e18 AS net_bnb
FROM sent s
LEFT JOIN recv r ON r.addr = s.addr
WHERE r.addr IS NULL
ORDER BY "net_bnb" DESC
LIMIT 20;
```

```sql
--9. Description: filter the previous result to keep only non‑zero positive balances.
WITH
balances AS (  --re‑use query 8 logic
  WITH
  recv AS (
    SELECT "to_address" AS addr,
           SUM(TRY_TO_DECIMAL("value")) AS recv_raw
    FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
    WHERE "token_address" IN (
          SELECT DISTINCT "address"
          FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
          WHERE "symbol" ILIKE '%BNB%' )
      AND "to_address" <> '0x0000000000000000000000000000000000000000'
    GROUP BY "to_address"
  ),
  sent AS (
    SELECT "from_address" AS addr,
           SUM(TRY_TO_DECIMAL("value")) AS sent_raw
    FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
    WHERE "token_address" IN (
          SELECT DISTINCT "address"
          FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
          WHERE "symbol" ILIKE '%BNB%' )
      AND "from_address" <> '0x0000000000000000000000000000000000000000'
    GROUP BY "from_address"
  )
  SELECT r.addr                                       AS address,
         COALESCE(r.recv_raw,0) - COALESCE(s.sent_raw,0)  AS net_raw
  FROM recv r LEFT JOIN sent s ON r.addr = s.addr
  UNION
  SELECT s.addr,
         -s.sent_raw AS net_raw
  FROM sent s LEFT JOIN recv r ON r.addr = s.addr
  WHERE r.addr IS NULL
)
SELECT address,
       net_raw / 1e18 AS net_bnb
FROM balances
WHERE net_raw <> 0
ORDER BY net_bnb DESC
LIMIT 20;
```

```sql
--10. Description: final step – sum positive net balances to obtain total circulating BNB (in 10^18 units).
WITH
balances AS (
  --(same CTE as in query 9)
  WITH
  recv AS (
    SELECT "to_address" AS addr,
           SUM(TRY_TO_DECIMAL("value")) AS recv_raw
    FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
    WHERE "token_address" IN (
          SELECT DISTINCT "address"
          FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
          WHERE "symbol" ILIKE '%BNB%' )
      AND "to_address" <> '0x0000000000000000000000000000000000000000'
    GROUP BY "to_address"
  ),
  sent AS (
    SELECT "from_address" AS addr,
           SUM(TRY_TO_DECIMAL("value")) AS sent_raw
    FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
    WHERE "token_address" IN (
          SELECT DISTINCT "address"
          FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
          WHERE "symbol" ILIKE '%BNB%' )
      AND "from_address" <> '0x0000000000000000000000000000000000000000'
    GROUP BY "from_address"
  )
  SELECT r.addr                                       AS address,
         COALESCE(r.recv_raw,0) - COALESCE(s.sent_raw,0)  AS net_raw
  FROM recv r LEFT JOIN sent s ON r.addr = s.addr
  UNION
  SELECT s.addr,
         -s.sent_raw AS net_raw
  FROM sent s LEFT JOIN recv r ON r.addr = s.addr
  WHERE r.addr IS NULL
)
SELECT SUM(net_raw) / 1e18  AS "circulating_bnb_in_units"
FROM balances
WHERE net_raw > 0    --only positive balances constitute circulating supply
LIMIT 20;
```

These ten queries progress from identifying the BNB contract to computing its aggregate circulating supply, all while excluding any interaction with the zero address.
