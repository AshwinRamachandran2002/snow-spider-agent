```

```sql
--Description:  (#7) Compute TOTAL SENT (raw wei units) per address for the same “BNB”‑symbol tokens,
--              excluding the zero address as sender.
SELECT tt."from_address"                     AS "holder",
       SUM( SAFE_CAST(tt."value" AS NUMBER) ) AS "total_sent_raw"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"  tt
JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"            tk
       ON tt."token_address" = tk."address"
WHERE  tk."symbol" ILIKE '%BNB%'
  AND  tt."from_address" <> '0x0000000000000000000000000000000000000000'
GROUP BY tt."from_address"
LIMIT 20;
```

```sql
--Description:  (#8) Combine received and sent aggregates to derive NET BALANCE (raw units)
--              for every address involved with tokens whose symbol contains “BNB”.
WITH rcv AS (
      SELECT tt."to_address" AS "addr",
             SUM( SAFE_CAST(tt."value" AS NUMBER) ) AS "recv_raw"
      FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"  tt
      JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"            tk
             ON tt."token_address" = tk."address"
      WHERE  tk."symbol" ILIKE '%BNB%'
        AND  tt."to_address" <> '0x0000000000000000000000000000000000000000'
      GROUP BY tt."to_address"
), snd AS (
      SELECT tt."from_address" AS "addr",
             SUM( SAFE_CAST(tt."value" AS NUMBER) ) AS "sent_raw"
      FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"  tt
      JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"            tk
             ON tt."token_address" = tk."address"
      WHERE  tk."symbol" ILIKE '%BNB%'
        AND  tt."from_address" <> '0x0000000000000000000000000000000000000000'
      GROUP BY tt."from_address"
)
SELECT COALESCE(rcv."addr", snd."addr")                     AS "address",
       COALESCE(rcv."recv_raw", 0) - COALESCE(snd."sent_raw", 0) AS "balance_raw"
FROM   rcv
FULL OUTER JOIN snd ON rcv."addr" = snd."addr"
LIMIT 20;
```

```sql
--Description:  (#9) Sum all POSITIVE balances (raw units) across addresses to estimate the
--              total on‑chain supply for tokens with symbol containing “BNB”.
WITH balances AS (
     WITH rcv AS (
           SELECT tt."to_address" AS "addr",
                  SUM( SAFE_CAST(tt."value" AS NUMBER) ) AS "recv_raw"
           FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"  tt
           JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"            tk
                  ON tt."token_address" = tk."address"
           WHERE  tk."symbol" ILIKE '%BNB%'
             AND  tt."to_address" <> '0x0000000000000000000000000000000000000000'
           GROUP BY tt."to_address"
     ), snd AS (
           SELECT tt."from_address" AS "addr",
                  SUM( SAFE_CAST(tt."value" AS NUMBER) ) AS "sent_raw"
           FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"  tt
           JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"            tk
                  ON tt."token_address" = tk."address"
           WHERE  tk."symbol" ILIKE '%BNB%'
             AND  tt."from_address" <> '0x0000000000000000000000000000000000000000'
           GROUP BY tt."from_address"
     )
     SELECT COALESCE(rcv."addr", snd."addr") AS "holder",
            COALESCE(rcv."recv_raw", 0) - COALESCE(snd."sent_raw", 0) AS "balance_raw"
     FROM   rcv
     FULL OUTER JOIN snd ON rcv."addr" = snd."addr"
)
SELECT SUM("balance_raw") AS "total_supply_raw"
FROM   balances
WHERE  "balance_raw" > 0
LIMIT 20;
```

```sql
--Description:  (#10) Convert the raw total supply (wei) into human‑readable units by dividing
--              by 10^18.  This gives an approximate circulating supply for all “BNB”‑named tokens.
