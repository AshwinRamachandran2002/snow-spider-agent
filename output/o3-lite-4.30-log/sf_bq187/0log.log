/*  Return the circulating supply of the canonical ERC‑20 “BNB” token            */
/*  – sum of every non‑zero address balance (total received − total sent)        */
/*  – result converted from raw units to human units by dividing by 10^18        */

WITH bnb_token AS (           -- pick the first‑seen BNB contract on Ethereum
    SELECT  "address" AS token_address
    FROM    ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"
    WHERE   "symbol" = 'BNB'
    QUALIFY ROW_NUMBER() OVER (ORDER BY "block_number" ASC NULLS LAST) = 1
),

received AS (                 -- aggregate all BNB received by each address
    SELECT  "to_address"                        AS addr,
            SUM( TRY_TO_NUMBER("value") )       AS recv_raw
    FROM    ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS" tt
    JOIN    bnb_token bt
            ON  tt."token_address" = bt.token_address
    WHERE   "to_address" <> '0x0000000000000000000000000000000000000000'
    GROUP BY "to_address"
),

sent AS (                     -- aggregate all BNB sent by each address
    SELECT  "from_address"                      AS addr,
            SUM( TRY_TO_NUMBER("value") )       AS sent_raw
    FROM    ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS" tt
    JOIN    bnb_token bt
            ON  tt."token_address" = bt.token_address
    WHERE   "from_address" <> '0x0000000000000000000000000000000000000000'
    GROUP BY "from_address"
),

balances AS (                 -- net balance per address
    SELECT  COALESCE(r.addr, s.addr)                            AS holder,
            COALESCE(r.recv_raw, 0) - COALESCE(s.sent_raw, 0)   AS balance_raw
    FROM    received r
    FULL OUTER JOIN sent s ON r.addr = s.addr
)

SELECT
    'BNB'                                                         AS token,
    SUM(balance_raw) / POWER(10, 18)                              AS circulating_supply
FROM balances
WHERE balance_raw > 0;
```
