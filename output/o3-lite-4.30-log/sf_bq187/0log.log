The table structure information is ({database name: {schema name: [table name]}}): 
{'ETHEREUM_BLOCKCHAIN': {'ETHEREUM_BLOCKCHAIN': ['BLOCKS', 'TOKENS', 'TRACES', 'CONTRACTS', 'LOGS', 'TOKEN_TRANSFERS', 'TRANSACTIONS']}}
Begin Exploring Related Columns
Relevant columns and their possible usage  
TOKENS."symbol": locate the exact row that represents the BNB ERC‑20 token.  
TOKENS."address": obtain the contract address of BNB (needed to filter transfers).  
TOKENS."decimals": confirm the token uses 18 decimals (most likely 18 ⇒ 10^18 divisor).  
TOKEN_TRANSFERS."token_address": keep only rows that belong to the BNB contract.  
TOKEN_TRANSFERS."from_address": address that sent BNB – used to total “outflow”.  
TOKEN_TRANSFERS."to_address": address that received BNB – used to total “inflow”.  
TOKEN_TRANSFERS."value": raw on‑chain amount transferred; will be cast to NUMERIC / FLOAT and scaled by 10^18.  
TOKEN_TRANSFERS."block_timestamp", "block_number": optional if you want to restrict to a period (not needed for full supply).  

Key conditions that will be reused  
1. TOKENS."symbol" = 'BNB' (or ILIKE '%BNB%') to isolate the token row.  
2. TOKEN_TRANSFERS."token_address" = <bnb_contract_address>.  
3. Exclude the zero address on both sides:  
   "from_address" <> '0x0000000000000000000000000000000000000000'  
   AND "to_address" <> '0x0000000000000000000000000000000000000000'  

Below are ten exploratory→analytical Snowflake SQL snippets (each ends with `LIMIT 20`) that gradually build up to the final circulating‑supply calculation.  Every identifier is wrapped in double quotes as requested.

```sql
-- 1) Description: List all distinct symbols that look like BNB in the TOKENS table
SELECT DISTINCT "symbol"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"
WHERE "symbol" ILIKE '%BNB%'
LIMIT 20;
```

```sql
-- 2) Description: Fetch the contract address, decimals and name for rows whose symbol is exactly 'BNB'
SELECT "address", "decimals", "name", "block_number"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"
WHERE "symbol" = 'BNB'
LIMIT 20;
```

```sql
-- 3) Description: Count how many BNB token rows exist to be sure there's only one canonical contract
SELECT COUNT(*) AS "bnb_token_rows"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"
WHERE "symbol" = 'BNB'
LIMIT 20;
```

```sql
-- 4) Description: Peek at a few raw TOKEN_TRANSFERS rows that involve the BNB contract
SELECT "transaction_hash",
       "from_address",
       "to_address",
       "value",
       "block_number"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"
WHERE "token_address" = '<bnb_contract_address>'
LIMIT 20;
```

```sql
-- 5) Description: How many DISTINCT addresses have ever appeared either as sender or receiver of BNB?
SELECT COUNT(DISTINCT "addr") AS "distinct_participants"
FROM (
      SELECT "from_address" AS "addr"
      FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"
      WHERE "token_address" = '<bnb_contract_address>'
      UNION
      SELECT "to_address" AS "addr"
      FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"
      WHERE "token_address" = '<bnb_contract_address>'
     )
WHERE "addr" <> '0x0000000000000000000000000000000000000000'
LIMIT 20;
```

```sql
-- 6) Description: Aggregate TOTAL RECEIVED per address (exclude zero‑address as recipient)
SELECT "to_address"              AS "holder",
       SUM( SAFE_CAST("value" AS NUMBER) ) AS "total_received_raw"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"
WHERE "token_address" = '<bnb_contract_address>'
  AND "to_address"   <> '0x0000000000000000000000000000000000000000'
GROUP BY "to_address"
LIMIT 20;
```

```sql
-- 7) Description: Aggregate TOTAL SENT per address (exclude zero‑address as sender)
SELECT "from_address"            AS "holder",
       SUM( SAFE_CAST("value" AS NUMBER) ) AS "total_sent_raw"
FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"
WHERE "token_address" = '<bnb_contract_address>'
  AND "from_address" <> '0x0000000000000000000000000000000000000000'
GROUP BY "from_address"
LIMIT 20;
```

```sql
-- 8) Description: Combine received & sent to compute NET BALANCE for every address
WITH rcv AS (
      SELECT "to_address"   AS "addr",
             SUM( SAFE_CAST("value" AS NUMBER) ) AS "recv_raw"
      FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"
      WHERE "token_address" = '<bnb_contract_address>'
        AND "to_address"   <> '0x0000000000000000000000000000000000000000'
      GROUP BY "to_address"
), snd AS (
      SELECT "from_address" AS "addr",
             SUM( SAFE_CAST("value" AS NUMBER) ) AS "sent_raw"
      FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"
      WHERE "token_address" = '<bnb_contract_address>'
        AND "from_address" <> '0x0000000000000000000000000000000000000000'
      GROUP BY "from_address"
)
SELECT COALESCE(rcv."addr", snd."addr")                AS "address",
       COALESCE(rcv."recv_raw", 0) - COALESCE(snd."sent_raw", 0) AS "balance_raw"
FROM rcv
FULL OUTER JOIN snd ON rcv."addr" = snd."addr"
LIMIT 20;
```

```sql
-- 9) Description: Retain only addresses with positive balances and sum up the balances
WITH balances AS (
     /* same CTE as step 8 */
     WITH rcv AS (
           SELECT "to_address" AS "addr",
                  SUM( SAFE_CAST("value" AS NUMBER) ) AS "recv_raw"
           FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"
           WHERE "token_address" = '<bnb_contract_address>'
             AND "to_address"   <> '0x0000000000000000000000000000000000000000'
           GROUP BY "to_address"
     ), snd AS (
           SELECT "from_address" AS "addr",
                  SUM( SAFE_CAST("value" AS NUMBER) ) AS "sent_raw"
           FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"
           WHERE "token_address" = '<bnb_contract_address>'
             AND "from_address" <> '0x0000000000000000000000000000000000000000'
           GROUP BY "from_address"
     )
     SELECT COALESCE(rcv."addr", snd."addr") AS "holder",
            COALESCE(rcv."recv_raw", 0) - COALESCE(snd."sent_raw", 0) AS "balance_raw"
     FROM rcv
     FULL OUTER JOIN snd ON rcv."addr" = snd."addr"
)
SELECT SUM("balance_raw") AS "total_supply_raw"
FROM balances
WHERE "balance_raw" > 0
LIMIT 20;
```

```sql
-- 10) Description: Final circulating supply in “human units” (divide by 10^18). One row result.
WITH balances AS (
     /* identical logic as in step 9 */
     WITH rcv AS (
           SELECT "to_address" AS "addr",
                  SUM( SAFE_CAST("value" AS NUMBER) ) AS "recv_raw"
           FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"
           WHERE "token_address" = '<bnb_contract_address>'
             AND "to_address"   <> '0x0000000000000000000000000000000000000000'
           GROUP BY "to_address"
     ), snd AS (
           SELECT "from_address" AS "addr",
                  SUM( SAFE_CAST("value" AS NUMBER) ) AS "sent_raw"
           FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"
           WHERE "token_address" = '<bnb_contract_address>'
             AND "from_address" <> '0x0000000000000000000000000000000000000000'
           GROUP BY "from_address"
     )
     SELECT COALESCE(rcv."addr", snd."addr") AS "holder",
            COALESCE(rcv."recv_raw", 0) - COALESCE(snd."sent_raw", 0) AS "balance_raw"
     FROM rcv
     FULL OUTER JOIN snd ON rcv."addr" = snd."addr"
)
SELECT ( SUM("balance_raw") / POWER(10, 18) ) AS "bnb_circulating_supply"
FROM balances
WHERE "balance_raw" > 0
LIMIT 20;
```

