--Description:  (#9) Sum only POSITIVE net balances (raw Wei) across all addresses to obtain
--              the on‑chain supply for every token whose symbol contains “BNB”.
WITH bnb_tokens AS (
    SELECT "address"
    FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"
    WHERE  "symbol" ILIKE '%BNB%'
),
rcv AS (
    SELECT tt."to_address" AS "addr",
           SUM( TRY_TO_NUMBER(tt."value") ) AS "recv_raw"
    FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS" tt
    JOIN   bnb_tokens bt
           ON tt."token_address" = bt."address"
    WHERE  tt."to_address" <> '0x0000000000000000000000000000000000000000'
    GROUP BY tt."to_address"
),
snd AS (
    SELECT tt."from_address" AS "addr",
           SUM( TRY_TO_NUMBER(tt."value") ) AS "sent_raw"
    FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS" tt
    JOIN   bnb_tokens bt
           ON tt."token_address" = bt."address"
    WHERE  tt."from_address" <> '0x0000000000000000000000000000000000000000'
    GROUP BY tt."from_address"
),
balances AS (
    SELECT COALESCE(rcv."addr", snd."addr") AS "holder",
           COALESCE(rcv."recv_raw", 0) - COALESCE(snd."sent_raw", 0) AS "balance_raw"
    FROM   rcv
    FULL OUTER JOIN snd ON rcv."addr" = snd."addr"
)
SELECT SUM("balance_raw") AS "total_supply_raw"
FROM   balances
WHERE  "balance_raw" > 0
LIMIT 20
