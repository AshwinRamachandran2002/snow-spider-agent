           JOIN   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"            tk
                  ON tt."token_address" = tk."address"
           WHERE  tk."symbol" ILIKE '%BNB%'
             AND  tt."from_address" <> '0x0000000000000000000000000000000000000000'
           GROUP BY tt."from_address"
     )
     SELECT COALESCE(rcv."addr", snd."addr") AS "holder",
            COALESCE(rcv."recv_raw", 0) - COALESCE(snd."sent_raw", 0) AS "balance_raw"
     FROM   rcv
     FULL OUTER JOIN snd ON rcv."addr" = snd."addr"
)
SELECT ( SUM("balance_raw") / POWER(10, 18) ) AS "bnb_circulating_supply"
FROM   balances
WHERE  "balance_raw" > 0
LIMIT 20;
