Query:
--Description:  (#7) Compute TOTAL SENT (raw Wei) per non‑zero sender address for all
--              transfers involving tokens whose symbol text contains “BNB”.
WITH bnb_tokens AS (
    SELECT "address"
    FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"
    WHERE  "symbol" ILIKE '%BNB%'
)
SELECT
       tt."from_address"                  AS "holder",
       SUM( TRY_TO_NUMBER(tt."value") )   AS "total_sent_raw"
FROM   ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"  tt
JOIN   bnb_tokens  bt
       ON tt."token_address" = bt."address"
WHERE  tt."from_address" <> '0x0000000000000000000000000000000000000000'
GROUP BY tt."from_address"
LIMIT 20
