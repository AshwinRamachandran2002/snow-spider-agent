--Description:  (#5) Count how many distinct non‑zero addresses have appeared as either sender
--              or receiver in transfers of ANY token whose symbol contains “BNB”.
SELECT COUNT(DISTINCT "addr") AS "distinct_participants"
FROM (
        SELECT tt."from_address" AS "addr"
        FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"  tt
        JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"            tk
             ON tt."token_address" = tk."address"
        WHERE tk."symbol" ILIKE '%BNB%'

        UNION

        SELECT tt."to_address" AS "addr"
        FROM ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKEN_TRANSFERS"  tt
        JOIN ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN."TOKENS"            tk
             ON tt."token_address" = tk."address"
        WHERE tk."symbol" ILIKE '%BNB%'
     ) AS u
WHERE "addr" <> '0x0000000000000000000000000000000000000000'
LIMIT 20
