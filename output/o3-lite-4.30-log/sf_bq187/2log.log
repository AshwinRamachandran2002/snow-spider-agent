Begin Exploring Related Columns
Relevant columns & their potential usage for computing circulating supply of “BNB”

• ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKENS  
  - "symbol": identify the token symbol ‘BNB’.  
  - "address": obtain the corresponding token contract address that will be used in TOKEN_TRANSFERS filtering.  
  - "block_number", "block_timestamp": (optional) check creation time of the contract in case multiple “BNB” contracts exist.  

• ETHEREUM_BLOCKCHAIN.ETHEREUM_BLOCKCHAIN.TOKEN_TRANSFERS  
  - "token_address": filter rows that belong to the BNB contract address.  
  - "from_address": address that sends BNB (used to calculate total‑sent per address).  
  - "to_address": address that receives BNB (used to calculate total‑received per address).  
  - "value": amount transferred, stored as TEXT, must be cast to a numeric type; later divide by 10^18 to convert from wei‑like units to whole tokens.  
  - "block_number", "block_timestamp": (optional) for time‑series checks or to limit to a certain snapshot date.  

Conditions commonly used  
1. "symbol" ILIKE '%BNB%' in TOKENS to locate candidate contracts.  
2. "token_address" = '<bnb_contract_address>' in TOKEN_TRANSFERS to restrict transfers to the chosen token.  
3. Exclude zero address on both sides: "from_address" <> '0x0000000000000000000000000000000000000000' and "to_address" <> '0x0000000000000000000000000000000000000000'.  

--------------------------------------------------------------------
Ten exploratory Snowflake SQL queries
--------------------------------------------------------------------

```sql
--Description: 1) Inspect all token symbols that look like BNB
SELECT DISTINCT "symbol", "name", "address"
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
WHERE "symbol" ILIKE '%BNB%'
LIMIT 20;
```

```sql
--Description: 2) Retrieve full metadata of the main BNB token candidate (replace address after inspection)
SELECT *
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"
WHERE "symbol" = 'BNB'
LIMIT 20;
```

```sql
--Description: 3) Preview first 20 transfers for the chosen BNB contract address
SELECT *
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
WHERE "token_address" = '<bnb_contract_address>'
LIMIT 20;
```

```sql
--Description: 4) Same preview but exclude any involvement of the zero‑address
SELECT *
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
WHERE "token_address" = '<bnb_contract_address>'
  AND "from_address" <> '0x0000000000000000000000000000000000000000'
  AND "to_address"   <> '0x0000000000000000000000000000000000000000'
LIMIT 20;
```

```sql
--Description: 5) Calculate total BNB received per address (top 20)
SELECT "to_address"      AS "address",
       SUM(TRY_TO_DECIMAL("value")) AS "total_received_raw"
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
WHERE "token_address" = '<bnb_contract_address>'
  AND "to_address" <> '0x0000000000000000000000000000000000000000'
GROUP BY "to_address"
ORDER BY "total_received_raw" DESC
LIMIT 20;
```

```sql
--Description: 6) Calculate total BNB sent per address (top 20)
SELECT "from_address"    AS "address",
       SUM(TRY_TO_DECIMAL("value")) AS "total_sent_raw"
FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
WHERE "token_address" = '<bnb_contract_address>'
  AND "from_address" <> '0x0000000000000000000000000000000000000000'
GROUP BY "from_address"
ORDER BY "total_sent_raw" DESC
LIMIT 20;
```

```sql
--Description: 7) Compute net BNB balance (received − sent) per address and show top holders
WITH
recv AS (
  SELECT "to_address" AS "addr",
         SUM(TRY_TO_DECIMAL("value")) AS "rec"
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
  WHERE "token_address" = '<bnb_contract_address>'
    AND "to_address" <> '0x0000000000000000000000000000000000000000'
  GROUP BY "to_address"
),
sent AS (
  SELECT "from_address" AS "addr",
         SUM(TRY_TO_DECIMAL("value")) AS "sen"
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
  WHERE "token_address" = '<bnb_contract_address>'
    AND "from_address" <> '0x0000000000000000000000000000000000000000'
  GROUP BY "from_address"
)
SELECT r."addr",
       COALESCE(r."rec",0) - COALESCE(s."sen",0) AS "balance_raw"
FROM recv r
LEFT JOIN sent s
  ON r."addr" = s."addr"
WHERE COALESCE(r."rec",0) - COALESCE(s."sen",0) <> 0
ORDER BY "balance_raw" DESC
LIMIT 20;
```

```sql
--Description: 8) Same as 7 but convert raw wei‑like units to token units (dividing by 1e18)
WITH
recv AS (
  SELECT "to_address" AS "addr",
         SUM(TRY_TO_DECIMAL("value")) AS "rec"
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
  WHERE "token_address" = '<bnb_contract_address>'
    AND "to_address" <> '0x0000000000000000000000000000000000000000'
  GROUP BY "to_address"
),
sent AS (
  SELECT "from_address" AS "addr",
         SUM(TRY_TO_DECIMAL("value")) AS "sen"
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
  WHERE "token_address" = '<bnb_contract_address>'
    AND "from_address" <> '0x0000000000000000000000000000000000000000'
  GROUP BY "from_address"
)
SELECT r."addr",
       (COALESCE(r."rec",0) - COALESCE(s."sen",0)) / POW(10,18) AS "balance_token_units"
FROM recv r
LEFT JOIN sent s
  ON r."addr" = s."addr"
WHERE (COALESCE(r."rec",0) - COALESCE(s."sen",0)) <> 0
ORDER BY "balance_token_units" DESC
LIMIT 20;
```

```sql
--Description: 9) Total circulating BNB supply (sum of all positive/negative balances) in original raw units
WITH
recv AS (
  SELECT "to_address" AS "addr",
         SUM(TRY_TO_DECIMAL("value")) AS "rec"
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
  WHERE "token_address" = '<bnb_contract_address>'
    AND "to_address" <> '0x0000000000000000000000000000000000000000'
  GROUP BY "to_address"
),
sent AS (
  SELECT "from_address" AS "addr",
         SUM(TRY_TO_DECIMAL("value")) AS "sen"
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
  WHERE "token_address" = '<bnb_contract_address>'
    AND "from_address" <> '0x0000000000000000000000000000000000000000'
  GROUP BY "from_address"
),
balances AS (
  SELECT COALESCE(r."addr",s."addr") AS "addr",
         COALESCE(r."rec",0) - COALESCE(s."sen",0) AS "balance_raw"
  FROM recv r
  FULL JOIN sent s
    ON r."addr" = s."addr"
)
SELECT SUM("balance_raw") AS "circulating_supply_raw"
FROM balances
WHERE "balance_raw" <> 0
LIMIT 20;
```

```sql
--Description: 10) Final circulating supply in token units (divide by 1e18)
WITH
recv AS (
  SELECT "to_address" AS "addr",
         SUM(TRY_TO_DECIMAL("value")) AS "rec"
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
  WHERE "token_address" = '<bnb_contract_address>'
    AND "to_address" <> '0x0000000000000000000000000000000000000000'
  GROUP BY "to_address"
),
sent AS (
  SELECT "from_address" AS "addr",
         SUM(TRY_TO_DECIMAL("value")) AS "sen"
  FROM "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS"
  WHERE "token_address" = '<bnb_contract_address>'
    AND "from_address" <> '0x0000000000000000000000000000000000000000'
  GROUP BY "from_address"
),
balances AS (
  SELECT COALESCE(r."addr",s."addr") AS "addr",
         COALESCE(r."rec",0) - COALESCE(s."sen",0) AS "bal_raw"
  FROM recv r
  FULL JOIN sent s
    ON r."addr" = s."addr"
  WHERE COALESCE(r."rec",0) - COALESCE(s."sen",0) <> 0
)
SELECT SUM("bal_raw") / POW(10,18) AS "circulating_supply_bnb"
FROM balances
LIMIT 20;
```

