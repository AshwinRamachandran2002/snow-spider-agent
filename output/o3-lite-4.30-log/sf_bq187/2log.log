    GROUP  BY tt."to_address"
), sent AS (
    SELECT tt."from_address" AS addr,
           SUM(TRY_TO_DECIMAL(tt."value")) AS sen
    FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS" tt
    JOIN   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"          tk
           ON tt."token_address" = tk."address"
    WHERE  tk."symbol" = 'BNB'
      AND  tt."from_address" <> '0x0000000000000000000000000000000000000000'
    GROUP  BY tt."from_address"
)
