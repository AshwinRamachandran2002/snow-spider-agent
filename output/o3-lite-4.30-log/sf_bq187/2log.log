    JOIN   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"          tk
           ON tt."token_address" = tk."address"
    WHERE  tk."symbol" = 'BNB'
      AND  tt."to_address" <> '0x0000000000000000000000000000000000000000'
    GROUP  BY tt."to_address"
), sent AS (
    SELECT tt."from_address" AS addr,
           SUM(TRY_TO_DECIMAL(tt."value")) AS sen
    FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS" tt
    JOIN   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"          tk
           ON tt."token_address" = tk."address"
    WHERE  tk."symbol" = 'BNB'
      AND  tt."from_address" <> '0x0000000000000000000000000000000000000000'
    GROUP  BY tt."from_address"
)
SELECT r.addr,
       (COALESCE(r.rec,0) - COALESCE(s.sen,0)) / POW(10,18) AS balance_token_units
FROM   recv r
LEFT  JOIN sent s ON r.addr = s.addr
WHERE  (COALESCE(r.rec,0) - COALESCE(s.sen,0)) <> 0
ORDER  BY balance_token_units DESC
LIMIT  20;
```

```sql
--Description: 9) Total circulating BNB supply in raw units by summing net balances of
--all non‑zero addresses across every token whose symbol is “BNB”.
WITH recv AS (
    SELECT tt."to_address" AS addr,
           SUM(TRY_TO_DECIMAL(tt."value")) AS rec
    FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS" tt
    JOIN   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"          tk
           ON tt."token_address" = tk."address"
    WHERE  tk."symbol" = 'BNB'
      AND  tt."to_address" <> '0x0000000000000000000000000000000000000000'
    GROUP  BY tt."to_address"
), sent AS (
    SELECT tt."from_address" AS addr,
           SUM(TRY_TO_DECIMAL(tt."value")) AS sen
    FROM   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKEN_TRANSFERS" tt
    JOIN   "ETHEREUM_BLOCKCHAIN"."ETHEREUM_BLOCKCHAIN"."TOKENS"          tk
           ON tt."token_address" = tk."address"
    WHERE  tk."symbol" = 'BNB'
      AND  tt."from_address" <> '0x0000000000000000000000000000000000000000'
    GROUP  BY tt."from_address"
), balances AS (
    SELECT COALESCE(r.addr,s.addr) AS addr,
           COALESCE(r.rec,0) - COALESCE(s.sen,0) AS balance_raw
    FROM   recv r
    FULL  JOIN sent s ON r.addr = s.addr
)
SELECT SUM(balance_raw) AS circulating_supply_raw
FROM   balances
WHERE  balance_raw <> 0;
