-- 7. Conversion rate by marketing channel
WITH
  v AS (
    SELECT DISTINCT fullVisitorId, channelGrouping
    FROM `data-to-insights.ecommerce.web_analytics`
  ),
  p AS (
    SELECT DISTINCT fullVisitorId, channelGrouping
    FROM `data-to-insights.ecommerce.web_analytics`
    WHERE totals.transactions IS NOT NULL
  )
SELECT
  v.channelGrouping,
  COUNT(DISTINCT p.fullVisitorId) AS purchasers,
  COUNT(DISTINCT v.fullVisitorId) AS visitors,
  SAFE_DIVIDE(COUNT(DISTINCT p.fullVisitorId), COUNT(DISTINCT v.fullVisitorId)) AS conversion_rate
FROM v
LEFT JOIN p USING(fullVisitorId, channelGrouping)
GROUP BY channelGrouping
LIMIT 20;
