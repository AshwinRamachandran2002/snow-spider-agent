2025-05-01 02:56:42 - Thread-1088 (execute) - INFO - [Exploration]
Relevant columns & their potential usage  
• `fullVisitorId`: uniquely identifies a visitor – use COUNT(DISTINCT fullVisitorId) to count visitors / purchasers.  
• `totals.transactions`: lives inside the STRUCT `totals`; # of transactions in the session – if NOT NULL the visitor is a purchaser; use SUM / AVG for transaction‑based metrics.  
• `date`: STRING (YYYYMMDD) – optional time breakdowns (daily / monthly).  
• `channelGrouping`: high‑level marketing channel – optional channel level conversion analysis.  
Conditions commonly used  
• Identify purchasers → `totals.transactions IS NOT NULL`.  
• Identify visitors  → no condition (all rows), but deduplicate by `fullVisitorId`.  

Below are ten BigQuery SQL snippets – from simple inspection to the final computation – each limited to 20 rows (except the final full answer) and fully qualified with back‑ticked identifiers.

```sql
-- 1. Peek at visitor IDs and their transaction counts
SELECT
  fullVisitorId,
  totals.transactions
FROM `data-to-insights.ecommerce.web_analytics`
LIMIT 20;
```

```sql
-- 2. Inspect only those sessions that produced a transaction
SELECT
  fullVisitorId,
  totals.transactions
FROM `data-to-insights.ecommerce.web_analytics`
WHERE totals.transactions IS NOT NULL
LIMIT 20;
```

```sql
-- 3. Count distinct visitors (any activity)
SELECT
  COUNT(DISTINCT fullVisitorId) AS unique_visitors
FROM `data-to-insights.ecommerce.web_analytics`;
```

```sql
-- 4. Count distinct purchasers (≥ 1 transaction recorded)
SELECT
  COUNT(DISTINCT fullVisitorId) AS unique_purchasers
FROM `data-to-insights.ecommerce.web_analytics`
WHERE totals.transactions IS NOT NULL;
```

```sql
-- 5. Gather all transactions per purchaser
SELECT
  fullVisitorId,
  SUM(totals.transactions) AS transactions_per_visitor
FROM `data-to-insights.ecommerce.web_analytics`
WHERE totals.transactions IS NOT NULL
GROUP BY fullVisitorId
LIMIT 20;
```

```sql
-- 6. Compute average transactions per purchaser
SELECT
  AVG(transactions_per_visitor) AS avg_txn_per_purchaser
FROM (
  SELECT
    fullVisitorId,
    SUM(totals.transactions) AS transactions_per_visitor
  FROM `data-to-insights.ecommerce.web_analytics`
  WHERE totals.transactions IS NOT NULL
  GROUP BY fullVisitorId
);
```

```sql
-- 7. Conversion rate by marketing channel
WITH
  v AS (
    SELECT DISTINCT fullVisitorId, channelGrouping
    FROM `data-to-insights.ecommerce.web_analytics`
  ),
  p AS (
    SELECT DISTINCT fullVisitorId, channelGrouping
    FROM `data-to-insights.ecommerce.web_analytics`
    WHERE totals.transactions IS NOT NULL
  )
SELECT
  v.channelGrouping,
  COUNT(DISTINCT p.fullVisitorId) AS purchasers,
  COUNT(DISTINCT v.fullVisitorId) AS visitors,
  SAFE_DIVIDE(COUNT(DISTINCT p.fullVisitorId), COUNT(DISTINCT v.fullVisitorId)) AS conversion_rate
FROM v
LEFT JOIN p USING(fullVisitorId, channelGrouping)
GROUP BY channelGrouping
LIMIT 20;
```

```sql
-- 8. Monthly conversion trend
WITH
  visitors AS (
    SELECT DISTINCT
      SUBSTR(date, 1, 6) AS ym,       -- YYYYMM
      fullVisitorId
    FROM `data-to-insights.ecommerce.web_analytics`
  ),
  purchasers AS (
    SELECT DISTINCT
      SUBSTR(date, 1, 6) AS ym,
      fullVisitorId
    FROM `data-to-insights.ecommerce.web_analytics`
    WHERE totals.transactions IS NOT NULL
  )
SELECT
  ym,
  COUNT(DISTINCT purchasers.fullVisitorId) AS purchasers,
  COUNT(DISTINCT visitors.fullVisitorId)  AS visitors,
  SAFE_DIVIDE(COUNT(DISTINCT purchasers.fullVisitorId),
              COUNT(DISTINCT visitors.fullVisitorId))      AS conversion_rate
FROM visitors
LEFT JOIN purchasers USING(fullVisitorId, ym)
GROUP BY ym
ORDER BY ym
LIMIT 20;
```

```sql
-- 9. Device category impact on conversion
WITH
  base AS (
    SELECT
      fullVisitorId,
      device.deviceCategory AS device_cat,
      totals.transactions
    FROM `data-to-insights.ecommerce.web_analytics`
  )
SELECT
  device_cat,
  COUNT(DISTINCT IF(transactions IS NOT NULL, fullVisitorId, NULL)) AS purchasers,
  COUNT(DISTINCT fullVisitorId) AS visitors,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(transactions IS NOT NULL, fullVisitorId, NULL)),
    COUNT(DISTINCT fullVisitorId)
  ) AS conversion_rate
FROM base
GROUP BY device_cat
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER – overall conversion rate & average transactions per purchaser
WITH
  -- All unique visitors
  visitors AS (
    SELECT DISTINCT fullVisitorId
    FROM `data-to-insights.ecommerce.web_analytics`
  ),
  -- All unique purchasers + their total transactions
  purchasers AS (
    SELECT
      fullVisitorId,
      SUM(totals.transactions) AS total_transactions
    FROM `data-to-insights.ecommerce.web_analytics`
    WHERE totals.transactions IS NOT NULL
    GROUP BY fullVisitorId
  )
SELECT
  (SELECT COUNT(*) FROM purchasers)                    AS unique_purchasers,
  (SELECT COUNT(*) FROM visitors)                      AS unique_visitors,
  SAFE_DIVIDE(
    (SELECT COUNT(*) FROM purchasers),
    (SELECT COUNT(*) FROM visitors)
  )                                                    AS conversion_rate,
  AVG(total_transactions)                              AS avg_transactions_per_purchaser
FROM purchasers;
```
