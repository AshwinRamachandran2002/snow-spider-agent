```sql
--Description: 9) Add cumulative distance (km) at each point for that storm.
WITH third_storm AS (
  /* same CTE logic as before to get the sid */
  WITH seg AS (
    SELECT
      sid,
      iso_time,
      latitude,
      longitude,
      ST_DISTANCE(
          ST_GEOGPOINT(longitude, latitude),
          ST_GEOGPOINT(LAG(longitude) OVER w, LAG(latitude) OVER w)
      ) AS segment_m
    FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
    WHERE basin = 'NA' AND season = '2020'
    WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
  ),
  tot AS (
    SELECT sid, SUM(segment_m) AS tot_m
    FROM seg
    GROUP BY sid
  )
  SELECT sid FROM tot ORDER BY tot_m DESC OFFSET 2 LIMIT 1
),
path AS (
  SELECT
    h.sid,
    h.iso_time,
    h.latitude,
    h.longitude,
    COALESCE(
      ST_DISTANCE(
        ST_GEOGPOINT(h.longitude, h.latitude),
        ST_GEOGPOINT(LAG(h.longitude) OVER w, LAG(h.latitude) OVER w)
      ), 0
    ) AS segment_m,
    h.usa_wind
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes` h
  WHERE h.sid = (SELECT sid FROM third_storm)
  WINDOW w AS (PARTITION BY h.sid ORDER BY h.iso_time)
)
SELECT
  sid,
  iso_time,
  latitude,
  longitude,
  ROUND(SUM(segment_m) OVER (ORDER BY iso_time)/1000, 2) AS cumulative_km,
  usa_wind
FROM path
ORDER BY iso_time
LIMIT 20;
```

