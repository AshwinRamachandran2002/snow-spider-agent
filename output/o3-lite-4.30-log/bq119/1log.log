```sql
--Description: One self‑contained query that
--  • scans every 2020 North‑Atlantic hurricane fix,
--  • measures the great‑circle distance (metres) between consecutive fixes,
--  • aggregates those distances to rank storms by total path length,
--  • selects the storm whose total distance is 3rd‑largest,
--  • and finally returns that storm’s full track in time order, adding
--    a running cumulative distance in kilometres plus the U.S.‑reported
--    maximum sustained wind (usa_wind) at each fix.
WITH seg AS (
  -- Each track‑point plus segment distance to the previous point
  SELECT
    sid,
    iso_time,
    latitude,
    longitude,
    COALESCE(
      ST_DISTANCE(
        ST_GEOGPOINT(longitude, latitude),
        ST_GEOGPOINT(
          LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time),
          LAG(latitude)  OVER (PARTITION BY sid ORDER BY iso_time)
        )
      ), 0
    ) AS segment_m,
    usa_wind
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE basin = 'NA'
    AND season = '2020'
),
tot AS (
  -- Total travel distance per storm
  SELECT sid, SUM(segment_m) AS tot_m
  FROM seg
  GROUP BY sid
),
third AS (
  -- SID of the 3rd‑longest storm
  SELECT sid
  FROM tot
  ORDER BY tot_m DESC
  LIMIT 1 OFFSET 2
)
SELECT
  s.sid,
  s.iso_time,
  s.latitude,
  s.longitude,
  ROUND(SUM(s.segment_m) OVER (PARTITION BY s.sid ORDER BY s.iso_time)/1000, 2)
      AS cumulative_km,
  s.usa_wind
FROM seg AS s
WHERE s.sid = (SELECT sid FROM third)
ORDER BY s.iso_time;
