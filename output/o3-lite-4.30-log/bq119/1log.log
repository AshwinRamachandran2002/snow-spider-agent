```

```sql
--Description: 5) Compute segment‑by‑segment distances for one sample storm (‘AL’ prefix).
SELECT
  sid,
  iso_time,
  latitude,
  longitude,
  ST_DISTANCE(
      ST_GEOGPOINT(longitude, latitude),
      ST_GEOGPOINT(LAG(longitude) OVER w, LAG(latitude) OVER w)
  ) AS segment_m
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE basin = 'NA' AND season = '2020' AND sid LIKE '%AL%'
WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
LIMIT 20;
```

```sql
--Description: 6) Total travel distance (km) for every 2020 N. Atlantic storm.
WITH seg AS (
  SELECT
    sid,
    ST_DISTANCE(
        ST_GEOGPOINT(longitude, latitude),
        ST_GEOGPOINT(LAG(longitude) OVER w, LAG(latitude) OVER w)
    ) AS segment_m
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE basin = 'NA' AND season = '2020'
  WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
)
SELECT
  sid,
  ROUND(SUM(segment_m)/1000, 1) AS total_km
FROM seg
GROUP BY sid
ORDER BY total_km DESC
LIMIT 20;
```

```sql
--Description: 7) Pick the storm with the third‑longest path (id + distance).
WITH seg AS (
  SELECT
    sid,
    ST_DISTANCE(
        ST_GEOGPOINT(longitude, latitude),
        ST_GEOGPOINT(LAG(longitude) OVER w, LAG(latitude) OVER w)
    ) AS segment_m
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE basin = 'NA' AND season = '2020'
  WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
),
tot AS (
  SELECT sid, SUM(segment_m) AS tot_m
  FROM seg
  GROUP BY sid
)
SELECT sid, ROUND(tot_m/1000,1) AS total_km
FROM tot
ORDER BY tot_m DESC
OFFSET 2 LIMIT 1;      -- 3rd longest
```

```sql
--Description: 8) Retrieve every track‑point for that 3rd‑longest storm (raw).
WITH third AS (
  -- Re‑use query (7) to isolate the correct sid
  WITH seg AS (
    SELECT
      sid,
      ST_DISTANCE(
          ST_GEOGPOINT(longitude, latitude),
          ST_GEOGPOINT(LAG(longitude) OVER w, LAG(latitude) OVER w)
      ) AS segment_m
    FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
    WHERE basin = 'NA' AND season = '2020'
    WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
  ),
  tot AS (
    SELECT sid, SUM(segment_m) AS tot_m
    FROM seg
    GROUP BY sid
  )
  SELECT sid FROM tot ORDER BY tot_m DESC OFFSET 2 LIMIT 1
)
SELECT *
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE sid IN (SELECT sid FROM third)
ORDER BY iso_time
LIMIT 20;
```

```sql
--Description: 9) Add cumulative distance (km) at each point for that storm.
WITH third_storm AS (
  /* same CTE logic as before to get the sid */
  WITH seg AS (
    SELECT
      sid,
      iso_time,
      latitude,
      longitude,
      ST_DISTANCE(
          ST_GEOGPOINT(longitude, latitude),
          ST_GEOGPOINT(LAG(longitude) OVER w, LAG(latitude) OVER w)
      ) AS segment_m
    FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
    WHERE basin = 'NA' AND season = '2020'
    WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
  ),
  tot AS (
    SELECT sid, SUM(segment_m) AS tot_m
    FROM seg
    GROUP BY sid
  )
  SELECT sid FROM tot ORDER BY tot_m DESC OFFSET 2 LIMIT 1
),
path AS (
  SELECT
    h.sid,
    h.iso_time,
    h.latitude,
    h.longitude,
    COALESCE(
      ST_DISTANCE(
        ST_GEOGPOINT(h.longitude, h.latitude),
        ST_GEOGPOINT(LAG(h.longitude) OVER w, LAG(h.latitude) OVER w)
      ), 0
    ) AS segment_m,
    h.usa_wind
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes` h
  WHERE h.sid = (SELECT sid FROM third_storm)
  WINDOW w AS (PARTITION BY h.sid ORDER BY h.iso_time)
)
SELECT
  sid,
  iso_time,
  latitude,
  longitude,
  ROUND(SUM(segment_m) OVER (ORDER BY iso_time)/1000, 2) AS cumulative_km,
  usa_wind
FROM path
ORDER BY iso_time
LIMIT 20;
```

```sql
--Description: 10) Final answer: full path, cumulative travel distance (km), and max sustained
-- wind (usa_wind) for the 3rd longest‑travelling North‑Atlantic hurricane of 2020.
WITH seg AS (
  SELECT
    sid,
    iso_time,
    latitude,
    longitude,
    COALESCE(
      ST_DISTANCE(
        ST_GEOGPOINT(longitude, latitude),
        ST_GEOGPOINT(LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time),
                      LAG(latitude)  OVER (PARTITION BY sid ORDER BY iso_time))
      ), 0
    ) AS segment_m,
    usa_wind
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE basin = 'NA' AND season = '2020'
),
tot AS (
  SELECT sid, SUM(segment_m) AS tot_m
  FROM seg
  GROUP BY sid
),
third_sid AS (
  SELECT sid
  FROM tot
  ORDER BY tot_m DESC
  OFFSET 2 LIMIT 1      -- third longest
),
path AS (
  SELECT *
  FROM seg
  WHERE sid = (SELECT sid FROM third_sid)
)
SELECT
  sid,
  iso_time,
  latitude,
  longitude,
  ROUND(SUM(segment_m) OVER (ORDER BY iso_time)/1000, 2) AS cumulative_km,
  usa_wind
FROM path
ORDER BY iso_time;
```




