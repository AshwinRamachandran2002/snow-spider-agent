```sql
--Description: 6) Total travel distance (km) for every 2020 N. Atlantic storm.
WITH seg AS (
  SELECT
    sid,
    ST_DISTANCE(
        ST_GEOGPOINT(longitude, latitude),
        ST_GEOGPOINT(LAG(longitude) OVER w, LAG(latitude) OVER w)
    ) AS segment_m
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE basin = 'NA' AND season = '2020'
  WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
)
SELECT
  sid,
  ROUND(SUM(segment_m)/1000, 1) AS total_km
FROM seg
GROUP BY sid
ORDER BY total_km DESC
LIMIT 20;
