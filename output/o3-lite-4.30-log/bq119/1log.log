  FROM seg
  WHERE sid = (SELECT sid FROM third_sid)
)
SELECT
  sid,
  iso_time,
  latitude,
  longitude,
  ROUND(SUM(segment_m) OVER (ORDER BY iso_time)/1000, 2) AS cumulative_km,
  usa_wind
FROM path
ORDER BY iso_time;
