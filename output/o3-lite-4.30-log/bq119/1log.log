--Description: 9) For that 3rd‑longest storm, list each fix with cumulative distance (km)
-- and the U.S.‑agency maximum sustained wind at that time.
WITH third_storm AS (
  /* Obtain the SID of the 3rd‑longest storm */
  WITH seg AS (
    SELECT
      sid,
      ST_DISTANCE(
        ST_GEOGPOINT(longitude, latitude),
        ST_GEOGPOINT(
          LAG(longitude) OVER (PARTITION BY sid ORDER BY iso_time),
          LAG(latitude)  OVER (PARTITION BY sid ORDER BY iso_time)
        )
      ) AS segment_m
    FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
    WHERE basin = 'NA' AND season = '2020'
  ),
  tot AS (
    SELECT sid, SUM(segment_m) AS tot_m
    FROM seg
    GROUP BY sid
  )
  SELECT sid
  FROM tot
  ORDER BY tot_m DESC
  LIMIT 1 OFFSET 2
),
path AS (
  /* Build segment distances for that storm */
  SELECT
    h.sid,
    h.iso_time,
    h.latitude,
    h.longitude,
    COALESCE(
      ST_DISTANCE(
        ST_GEOGPOINT(h.longitude, h.latitude),
        ST_GEOGPOINT(
          LAG(h.longitude) OVER (PARTITION BY h.sid ORDER BY h.iso_time),
          LAG(h.latitude)  OVER (PARTITION BY h.sid ORDER BY h.iso_time)
        )
      ), 0
    ) AS segment_m,
    h.usa_wind
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes` AS h
  WHERE h.sid = (SELECT sid FROM third_storm)
)
SELECT
  sid,
  iso_time,
  latitude,
  longitude,
  ROUND(SUM(segment_m) OVER (ORDER BY iso_time) / 1000, 2) AS cumulative_km,
  usa_wind
FROM path
ORDER BY iso_time
LIMIT 20;
