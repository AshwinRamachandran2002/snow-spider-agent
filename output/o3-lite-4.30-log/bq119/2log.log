Query:
--Description: (#10) Final answer – full track of the 3rd‑longest‑distance 2020 North‑Atlantic hurricane with cumulative km and wind
WITH storm_points AS (
  SELECT
    sid,
    iso_time,
    latitude,
    longitude,
    usa_wind,
    ST_GEOGPOINT(longitude, latitude) AS geo
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE basin = 'NA'
    AND season = '2020'
    AND latitude  IS NOT NULL
    AND longitude IS NOT NULL
),
leg_dist AS (
  SELECT
    sid,
    iso_time,
    latitude,
    longitude,
    usa_wind,
    ST_DISTANCE(
      geo,
      LAG(geo) OVER (PARTITION BY sid ORDER BY iso_time)
    ) AS leg_m
  FROM storm_points
),
totals AS (                 -- total metres per storm
  SELECT sid, SUM(leg_m) AS total_m
  FROM leg_dist
  GROUP BY sid
),
third_longest AS (          -- pick 3rd‑longest
  SELECT sid
  FROM totals
  ORDER BY total_m DESC
  LIMIT 1 OFFSET 2          -- LIMIT first, then OFFSET
),
track AS (                  -- build cumulative km
  SELECT
    l.sid,
    l.iso_time,
    l.latitude,
    l.longitude,
    l.usa_wind,
    SUM(IFNULL(l.leg_m,0)) OVER (PARTITION BY l.sid ORDER BY l.iso_time) / 1000.0
      AS cumulative_km
  FROM leg_dist l
  JOIN third_longest USING (sid)
)
SELECT
  sid                       AS storm_id,
  iso_time,
  latitude,
  longitude,
  ROUND(cumulative_km,1)    AS cumulative_distance_km,
  usa_wind                  AS max_sustained_wind_kt
FROM track
ORDER BY iso_time
