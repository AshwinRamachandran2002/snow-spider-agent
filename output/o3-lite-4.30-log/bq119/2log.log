```sql
--Description: One self‑contained query (with inline commentary = “thinking process”) that
-- ① filters 2020 North‑Atlantic hurricane fixes,
-- ② computes point‑to‑point leg distances,
-- ③ ranks storms by total distance to find the 3rd‑longest traveller,
-- ④ outputs that storm’s full track with cumulative distance (km) and U.S.‑agency wind (kt).

WITH
/* Step‑1: pull 2020 NA track points that have coordinates */
pts AS (
  SELECT
    sid,
    iso_time,
    latitude,
    longitude,
    usa_wind,
    ST_GEOGPOINT(longitude, latitude) AS geo          -- convert to GEOGRAPHY point
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE basin  = 'NA'
    AND season = '2020'
    AND latitude  IS NOT NULL
    AND longitude IS NOT NULL
),

/* Step‑2: distance between consecutive fixes (metres) */
legs AS (
  SELECT
    sid,
    iso_time,
    latitude,
    longitude,
    usa_wind,
    ST_DISTANCE(
      geo,
      LAG(geo) OVER (PARTITION BY sid ORDER BY iso_time)
    ) AS leg_m
  FROM pts
),

/* Step‑3: total travel per storm; rank descending; pick 3rd place */
ranked AS (
  SELECT
    sid,
    SUM(leg_m) AS tot_m,
    DENSE_RANK() OVER (ORDER BY SUM(leg_m) DESC) AS rnk
  FROM legs
  GROUP BY sid
),
target_sid AS (
  SELECT sid
  FROM ranked
  WHERE rnk = 3    -- 3rd‑longest
),

/* Step‑4: cumulative km along that storm’s path */
track AS (
  SELECT
    l.sid,
    l.iso_time,
    l.latitude,
    l.longitude,
    l.usa_wind,
    SUM(IFNULL(l.leg_m,0)) OVER (PARTITION BY l.sid ORDER BY l.iso_time) / 1000.0
      AS cumulative_km
  FROM legs l
  JOIN target_sid USING (sid)
)

/* Final result */
SELECT
  sid                                   AS storm_id,
  iso_time,
  latitude,
  longitude,
  ROUND(cumulative_km,1)                AS cumulative_distance_km,
  usa_wind                              AS max_sustained_wind_kt
FROM track
ORDER BY iso_time;
```
