Query:
--Description: (#9) Preview first 20 fixes for the storm that ranked 3rd in total travel distance (cumulative‑km shown)
WITH storm_id AS (   -- fetch SID of the 3rd‑longest traveller
  WITH p AS (
    SELECT
      sid,
      iso_time,
      ST_GEOGPOINT(longitude, latitude) AS geo
    FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
    WHERE basin = 'NA'
      AND season = '2020'
      AND latitude  IS NOT NULL
      AND longitude IS NOT NULL
  ),
  legs AS (
    SELECT
      sid,
      ST_DISTANCE(geo,
                  LAG(geo) OVER (PARTITION BY sid ORDER BY iso_time)) AS leg_m
    FROM p
  ),
  tot AS (
    SELECT sid, SUM(leg_m) AS tot_m
    FROM legs
    GROUP BY sid
  )
  SELECT sid
  FROM tot
  ORDER BY tot_m DESC
  LIMIT 1 OFFSET 2        -- LIMIT then OFFSET  → 3rd place
),
points AS (               -- fixes for that storm
  SELECT
    h.sid,
    h.iso_time,
    h.latitude,
    h.longitude,
    h.usa_wind,
    ST_GEOGPOINT(h.longitude, h.latitude) AS geo
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes` h
  JOIN storm_id USING (sid)
  WHERE h.latitude  IS NOT NULL
    AND h.longitude IS NOT NULL
),
legs AS (
  SELECT
    *,
    ST_DISTANCE(
      geo,
      LAG(geo) OVER (PARTITION BY sid ORDER BY iso_time)
    ) AS leg_m
  FROM points
)
SELECT
  sid,
  iso_time,
  latitude,
  longitude,
  ROUND(
    SUM(IFNULL(leg_m,0)) OVER (PARTITION BY sid ORDER BY iso_time) / 1000,
    1
  ) AS cumulative_km,
  usa_wind
FROM legs
ORDER BY iso_time
LIMIT 20
