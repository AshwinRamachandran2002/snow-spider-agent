  SELECT
    *,
    ST_DISTANCE(
      ST_GEOGPOINT(longitude, latitude),
      ST_GEOGPOINT(LAG(longitude) OVER w,
                   LAG(latitude)  OVER w)
    ) / 1000 AS leg_km           -- kilometres
  FROM base
  WINDOW w AS (PARTITION BY sid ORDER BY iso_time)
),
totals AS (
  -- 3. total track length per storm
  SELECT
    sid,
    SUM(leg_km) AS total_km
  FROM legs
  GROUP BY sid
),
ranked AS (
  -- 4. rank storms by travel distance (longest = 1)
  SELECT
    sid,
    total_km,
    DENSE_RANK() OVER (ORDER BY total_km DESC) AS rnk
  FROM totals
),
target_sid AS (
  -- 5. keep the storm(s) ranked 3rd
  SELECT sid
  FROM ranked
  WHERE rnk = 3
),
track AS (
  -- 6. cumulative distance along the chosen storm track
  SELECT
    l.sid,
    l.iso_time,
    l.latitude,
    l.longitude,
    COALESCE(
      ROUND(
        SUM(l.leg_km) OVER (PARTITION BY l.sid ORDER BY l.iso_time),
        4
      ),
      0
    ) AS cumulative_travel_distance_km,
    l.usa_wind AS max_sustained_wind_speed_kt
  FROM legs AS l
  JOIN target_sid USING (sid)
)
-- 7. final output
SELECT
  CONCAT(CAST(latitude AS STRING), ',', CAST(longitude AS STRING)) AS travel_coordinates,
  cumulative_travel_distance_km,
  max_sustained_wind_speed_kt
FROM track
ORDER BY iso_time;
