Begin Exploring Related Columns
Relevant columns and their usage / possible filters
• sid: unique storm identifier – GROUP BY and filter for a single storm  
• season: 4‑digit year – filter season = '2020'  
• basin: storm basin – filter basin = 'NA' (North Atlantic)  
• track_type: track quality – usually keep only 'main'  
• iso_time: UTC timestamp – extract the year and order the track chronologically  
• latitude / longitude: build GEOGRAPHY points, measure great‑circle distance  
• usa_wind: 1‑minute maximum sustained wind speed – display at every fix  
• usa_status or wmo_wind (optional): alternate intensity fields  
Conditions that will be handy  
• WHERE basin = 'NA' AND season = '2020' AND track_type = 'main'  
• Partition / order by sid, iso_time to compute distances  
• Use LAG(...) OVER (PARTITION BY sid ORDER BY iso_time) to get the previous point  

Ten exploratory → final SQL queries
```sql
-- 1. Description: List the distinct basins in the hurricanes table.
SELECT DISTINCT `basin`
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
LIMIT 20;
```

```sql
-- 2. Description: How many fixes are there in the North Atlantic main tracks during 2020?
SELECT COUNT(*) AS fixes_2020_NA
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE `basin` = 'NA'
  AND `season` = '2020'
  AND `track_type` = 'main'
LIMIT 20;
```

```sql
-- 3. Description: Show all 2020 North‑Atlantic storm IDs (sid) and how many fixes each contains.
SELECT `sid`, COUNT(*) AS points
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE `basin` = 'NA'
  AND `season` = '2020'
  AND `track_type` = 'main'
GROUP BY `sid`
ORDER BY points DESC
LIMIT 20;
```

```sql
-- 4. Description: Peek at one storm’s track – first 20 rows for the alphabetically first sid.
SELECT `sid`, `iso_time`, `latitude`, `longitude`, `usa_wind`
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE `sid` = (
    SELECT MIN(`sid`) FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
    WHERE `basin` = 'NA' AND `season` = '2020' AND `track_type` = 'main')
ORDER BY `iso_time`
LIMIT 20;
```

```sql
-- 5. Description: Compute segment distances (km) for one sample storm to verify math.
SELECT `sid`, `iso_time`,
       ST_DISTANCE(
           ST_GEOGPOINT(`longitude`, `latitude`),
           ST_GEOGPOINT(LAG(`longitude`) OVER w,
                         LAG(`latitude`)  OVER w) )/1000 AS leg_km
FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
WHERE `sid` = (
    SELECT MIN(`sid`) FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
    WHERE `basin` = 'NA' AND `season` = '2020' AND `track_type` = 'main')
WINDOW w AS (PARTITION BY `sid` ORDER BY `iso_time`)
ORDER BY `iso_time`
LIMIT 20;
```

```sql
-- 6. Description: Total travel distance per 2020 NA storm (km), ordered longest → shortest.
WITH legs AS (
  SELECT `sid`,
         ST_DISTANCE(
           ST_GEOGPOINT(`longitude`, `latitude`),
           ST_GEOGPOINT(LAG(`longitude`) OVER w,
                         LAG(`latitude`)  OVER w))/1000 AS leg_km
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE `basin` = 'NA' AND `season` = '2020' AND `track_type` = 'main'
  WINDOW w AS (PARTITION BY `sid` ORDER BY `iso_time`)
)
SELECT `sid`, ROUND(SUM(leg_km),1) AS total_km
FROM legs
GROUP BY `sid`
ORDER BY total_km DESC
LIMIT 20;
```

```sql
-- 7. Description: Pick the 3rd longest‑distance storm sid in 2020 North Atlantic.
WITH ranked AS (
  SELECT `sid`,
         SUM(leg_km) AS total_km,
         DENSE_RANK() OVER (ORDER BY SUM(leg_km) DESC) AS rnk
  FROM (
      SELECT `sid`,
             ST_DISTANCE(
               ST_GEOGPOINT(`longitude`, `latitude`),
               ST_GEOGPOINT(LAG(`longitude`) OVER w,
                             LAG(`latitude`)  OVER w))/1000 AS leg_km
      FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
      WHERE `basin` = 'NA' AND `season` = '2020' AND `track_type` = 'main'
      WINDOW w AS (PARTITION BY `sid` ORDER BY `iso_time`)
  )
  GROUP BY `sid`
)
SELECT `sid`, ROUND(total_km,1) AS total_km
FROM ranked
WHERE rnk = 3
LIMIT 20;
```

```sql
-- 8. Description: Show the full ordered track for that 3rd‑longest storm (no distances yet).
WITH third AS (
  SELECT `sid`
  FROM (
    SELECT `sid`,
           DENSE_RANK() OVER (ORDER BY SUM(leg_km) DESC) AS rnk
    FROM (
        SELECT `sid`,
               ST_DISTANCE(
                 ST_GEOGPOINT(`longitude`, `latitude`),
                 ST_GEOGPOINT(LAG(`longitude`) OVER w,
                               LAG(`latitude`)  OVER w))/1000 AS leg_km
        FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
        WHERE `basin` = 'NA' AND `season` = '2020' AND `track_type` = 'main'
        WINDOW w AS (PARTITION BY `sid` ORDER BY `iso_time`)
    )
    GROUP BY `sid`
  )
  WHERE rnk = 3
)
SELECT h.`sid`, h.`iso_time`, h.`latitude`, h.`longitude`, h.`usa_wind`
FROM `bigquery-public-data.noaa_hurricanes.hurricanes` AS h
JOIN third USING (`sid`)
ORDER BY h.`iso_time`
LIMIT 20;
```

```sql
-- 9. Description: Add cumulative distance (km) along the track for the 3rd‑longest storm.
WITH third AS (
  SELECT `sid`
  FROM (
    SELECT `sid`,
           DENSE_RANK() OVER (ORDER BY SUM(leg_km) DESC) AS rnk
    FROM (
        SELECT `sid`,
               ST_DISTANCE(
                 ST_GEOGPOINT(`longitude`, `latitude`),
                 ST_GEOGPOINT(LAG(`longitude`) OVER w,
                               LAG(`latitude`)  OVER w))/1000 AS leg_km
        FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
        WHERE `basin` = 'NA' AND `season` = '2020' AND `track_type` = 'main'
        WINDOW w AS (PARTITION BY `sid` ORDER BY `iso_time`)
    )
    GROUP BY `sid`
  )
  WHERE rnk = 3
), track AS (
  SELECT h.*,
         ST_DISTANCE(
           ST_GEOGPOINT(`longitude`, `latitude`),
           ST_GEOGPOINT(LAG(`longitude`) OVER w,
                         LAG(`latitude`)  OVER w))/1000 AS leg_km
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes` AS h
  JOIN third USING (`sid`)
  WINDOW w AS (PARTITION BY h.`sid` ORDER BY h.`iso_time`)
)
SELECT `sid`, `iso_time`, `latitude`, `longitude`,
       ROUND(SUM(leg_km) OVER (PARTITION BY `sid` ORDER BY `iso_time`),1) AS cum_km,
       `usa_wind`
FROM track
ORDER BY `iso_time`
LIMIT 20;
```

```sql
-- 10. Description: FINAL – full answer query (still capped to 20 rows for preview).
WITH base AS (
  SELECT *
  FROM `bigquery-public-data.noaa_hurricanes.hurricanes`
  WHERE `basin` = 'NA' AND `season` = '2020' AND `track_type` = 'main'
), legs AS (
  SELECT *,
         ST_DISTANCE(
           ST_GEOGPOINT(`longitude`, `latitude`),
           ST_GEOGPOINT(LAG(`longitude`) OVER w,
                         LAG(`latitude`)  OVER w))/1000 AS leg_km
  FROM base
  WINDOW w AS (PARTITION BY `sid` ORDER BY `iso_time`)
), ranked AS (
  SELECT `sid`,
         SUM(leg_km) AS total_km,
         DENSE_RANK() OVER (ORDER BY SUM(leg_km) DESC) AS rnk
  FROM legs
  GROUP BY `sid`
), target AS (
  SELECT `sid`
  FROM ranked
  WHERE rnk = 3
)
SELECT l.`sid`,
       l.`iso_time`,
       l.`latitude`,
       l.`longitude`,
       ROUND(SUM(l.leg_km) OVER(PARTITION BY l.`sid` ORDER BY l.`iso_time`),1) AS cumulative_distance_km,
       l.`usa_wind` AS max_sustained_wind_kt
FROM legs AS l
JOIN target USING (`sid`)
ORDER BY l.`iso_time`
LIMIT 20;
```

