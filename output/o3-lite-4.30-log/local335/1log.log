-- 10. One‑shot: across all seasons ≥2001, count how many times each constructor
-- supplied the driver(s) with the fewest positive points, then list top five
WITH final_races AS (
    SELECT year,
           MAX(round) AS final_round,
           MAX(race_id) AS final_race_id
    FROM races
    WHERE year >= 2001
    GROUP BY year
),
fewest_pts AS (
    SELECT fr.year,
           ds.driver_id,
           ds.points,
           r.constructor_id
    FROM final_races AS fr
    JOIN driver_standings AS ds ON ds.race_id = fr.final_race_id
    JOIN results          AS r  ON r.race_id  = ds.race_id
                                AND r.driver_id = ds.driver_id
    WHERE ds.points > 0
      AND ds.points = (
            SELECT MIN(points)
            FROM driver_standings
            WHERE race_id = fr.final_race_id
              AND points > 0
      )
)
SELECT c.name AS constructor_name,
       COUNT(*) AS seasons_as_lowest_points_constructor
FROM fewest_pts
JOIN constructors AS c ON c.constructor_id = fewest_pts.constructor_id
GROUP BY fewest_pts.constructor_id
ORDER BY seasons_as_lowest_points_constructor DESC, constructor_name
LIMIT 20
