```sql
--Description: (#5)  For every season from 2001 on, find the fewest points scored by any
--                 driver who actually scored points that year.
SELECT
       x.year,
       MIN(x.driver_pts) AS min_points_among_scorers
FROM (
       SELECT  r.year,
               res.driver_id,
               SUM(res.points) AS driver_pts
       FROM    results AS res
       JOIN    races   AS r ON r.race_id = res.race_id
       WHERE   r.year >= 2001
       GROUP   BY r.year, res.driver_id
       HAVING  SUM(res.points) > 0              -- keep only point‑scorers
     ) AS x
GROUP BY x.year
ORDER BY x.year
LIMIT 20;
```

```sql
--Description: (#6)  For the 2009 season, list the driver(s) whose point total equals that
--                 season’s minimum among point‑scoring drivers.
WITH driver_totals AS (
     SELECT  r.year,
             res.driver_id,
             SUM(res.points) AS driver_pts
     FROM    results AS res
     JOIN    races   AS r ON r.race_id = res.race_id
     WHERE   r.year = 2009
     GROUP   BY r.year, res.driver_id
     HAVING  SUM(res.points) > 0
),
year_min AS (
     SELECT year, MIN(driver_pts) AS min_pts
     FROM   driver_totals
     GROUP  BY year
)
SELECT dt.year,
       dt.driver_id,
       dt.driver_pts
FROM   driver_totals AS dt
JOIN   year_min      AS ym USING (year)
WHERE  dt.driver_pts = ym.min_pts
LIMIT  20;
```

```sql
--Description: (#7)  Still for 2009, attach the “main constructor” (the constructor on
--                 which each minimum‑points driver scored the most points).
WITH driver_totals AS (
     SELECT  r.year,
             res.driver_id,
             SUM(res.points) AS driver_pts
     FROM    results AS res
     JOIN    races   AS r ON r.race_id = res.race_id
     WHERE   r.year = 2009
     GROUP   BY r.year, res.driver_id
     HAVING  SUM(res.points) > 0
),
main_team AS (
     SELECT  r.year,
             res.driver_id,
             res.constructor_id,
             SUM(res.points) AS pts_for_team,
             ROW_NUMBER() OVER (
                 PARTITION BY r.year, res.driver_id
                 ORDER BY SUM(res.points) DESC
             ) AS rn                        -- rn = 1 ⇒ constructor with most points
     FROM    results AS res
     JOIN    races   AS r ON r.race_id = res.race_id
     WHERE   r.year = 2009
     GROUP   BY r.year, res.driver_id, res.constructor_id
),
min_drivers AS (
     SELECT dt.*
     FROM   driver_totals dt
     JOIN  (SELECT year, MIN(driver_pts) AS m 
            FROM driver_totals GROUP BY year) mm
       ON  dt.year = mm.year AND dt.driver_pts = mm.m
)
SELECT  md.year,
        md.driver_id,
        ct.name  AS constructor_name,
        md.driver_pts
FROM    min_drivers  AS md
JOIN    main_team    AS mt ON mt.year = md.year
                          AND mt.driver_id = md.driver_id
                          AND mt.rn = 1                 -- pick main constructor
JOIN    constructors AS ct ON ct.constructor_id = mt.constructor_id
LIMIT   20;
