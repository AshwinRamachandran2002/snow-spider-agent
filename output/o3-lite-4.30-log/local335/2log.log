```sql
--Description / thinking process:
-- Goal: replicate query #4 but fix the incorrect HAVING placement error.
-- Steps:
--   • Work inside a sub‑query “t” that produces one row per driver for season 2009:
--       – JOIN results → races to restrict to 2009 races.
--       – GROUP BY (year, driver_id) to calculate each driver’s season‑total points.
--       – Within the SELECT list, use a correlated sub‑query to discover which
--         constructor supplied the greatest number of those points (call it
--         main_constructor_id).  The correlated sub‑query again looks at 2009
--         results for the same driver, groups by constructor_id, orders by the
--         SUM(points) descending, and returns the constructor_id with the most
--         points; LIMIT 1 breaks ties arbitrarily.
--   • After the sub‑query, filter out drivers with zero points using WHERE
--     (HAVING can’t be used because the outer query itself is not aggregated).
--   • Order by driver_points ascending so the smallest totals appear first
--     and cap output to 20 rows for inspection.

SELECT
       t.year,
       t.driver_id,
       t.main_constructor_id,
       t.driver_points
FROM (
     SELECT
            r.year,
            res.driver_id,
            /* constructor that contributed the most points to this driver in 2009 */
            ( SELECT res2.constructor_id
              FROM   results AS res2
              JOIN   races   AS r2 ON r2.race_id = res2.race_id
              WHERE  r2.year        = r.year
                AND  res2.driver_id = res.driver_id
              GROUP  BY res2.constructor_id
              ORDER  BY SUM(res2.points) DESC
              LIMIT  1
            ) AS main_constructor_id,
            SUM(res.points) AS driver_points
     FROM   results AS res
     JOIN   races   AS r ON r.race_id = res.race_id
     WHERE  r.year = 2009
     GROUP  BY r.year, res.driver_id
) AS t
WHERE  t.driver_points > 0          -- keep only point‑scoring drivers
ORDER  BY t.driver_points           -- smallest totals first
LIMIT  20;
