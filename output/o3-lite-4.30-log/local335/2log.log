Relevant tables / columns and how they will likely be used  

• races.year – identify the season (used in all joins; filter WHERE year >= 2001).  
• races.race_id – join‐key that ties every race of a season to results / driver_standings.  
• results.driver_id – which driver scored the points.  
• results.constructor_id – which constructor the driver was classified under in that race.  
• results.points – points scored in that race (to be summed to season totals).  
• constructors.constructor_id / constructors.name – turn constructor_id into a readable team name.  
• drivers.driver_id / drivers.surname / … – only needed when checking which driver has the fewest points in a season (optional for the final answer).  

Basic conditions / joins that will repeatedly appear  

• JOIN races   ON races.race_id  = results.race_id  
• JOIN constructors USING (constructor_id)  
• WHERE races.year >= 2001              -- only seasons since 2001  
• GROUP BY races.year, results.driver_id (or constructor_id)  
• HAVING SUM(results.points) > 0        -- keep only point‑scorers  

Below are 10 exploratory SQL statements (all limited to 20 rows) that gradually build up the information pathway from simple inspection to the pieces needed for the final computation.

```sql
-- 1. List all seasons available from 2001 onward
SELECT DISTINCT year
FROM races
WHERE year >= 2001
ORDER BY year
LIMIT 20;
```

```sql
-- 2. Inspect how many races per season we have after 2001
SELECT year,
       COUNT(*) AS race_count
FROM races
WHERE year >= 2001
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
-- 3. Show one season’s worth of driver‑level point totals (here: 2009)  
SELECT r.year,
       dr.driver_id,
       SUM(res.points) AS season_points
FROM results  AS res
JOIN races    AS r   ON r.race_id = res.race_id
JOIN drivers  AS dr  ON dr.driver_id = res.driver_id
WHERE r.year = 2009
GROUP BY r.year, dr.driver_id
HAVING season_points > 0
ORDER BY season_points
LIMIT 20;
```

```sql
-- 4. Same as #3 but also show the *constructor_id* on which each driver scored the most
--    points that season (proxy for “main constructor”).
SELECT t.year,
       t.driver_id,
       t.main_constructor_id,
       t.driver_points
FROM (
    SELECT r.year,
           res.driver_id,
           -- constructor with the max points for this driver in that season
           (SELECT res2.constructor_id
            FROM results AS res2
            JOIN races   AS r2 ON r2.race_id = res2.race_id
            WHERE r2.year = r.year
              AND res2.driver_id = res.driver_id
            GROUP BY res2.constructor_id
            ORDER BY SUM(res2.points) DESC
            LIMIT 1) AS main_constructor_id,
           SUM(res.points) AS driver_points
    FROM results AS res
    JOIN races   AS r ON r.race_id = res.race_id
    WHERE r.year = 2009
    GROUP BY r.year, res.driver_id
) AS t
HAVING t.driver_points > 0
ORDER BY t.driver_points
LIMIT 20;
```

```sql
-- 5. For every season since 2001, find the minimum points scored by any point‑scoring driver
SELECT r.year,
       MIN(driver_pts) AS min_points_among_scorers
FROM (
    SELECT r.year,
           res.driver_id,
           SUM(res.points) AS driver_pts
    FROM results AS res
    JOIN races   AS r ON r.race_id = res.race_id
    WHERE r.year >= 2001
    GROUP BY r.year, res.driver_id
    HAVING driver_pts > 0
) AS x
GROUP BY r.year
ORDER BY r.year
LIMIT 20;
```

```sql
-- 6. For one year (2009) list the driver(s) who match that minimum
WITH driver_totals AS (
    SELECT r.year,
           res.driver_id,
           SUM(res.points) AS driver_pts
    FROM results AS res
    JOIN races   AS r ON r.race_id = res.race_id
    WHERE r.year = 2009
    GROUP BY r.year, res.driver_id
    HAVING driver_pts > 0
),
year_min AS (
    SELECT year, MIN(driver_pts) AS min_pts
    FROM driver_totals
    GROUP BY year
)
SELECT dt.year,
       dt.driver_id,
       dt.driver_pts
FROM driver_totals AS dt
JOIN year_min     AS ym USING (year)
WHERE dt.driver_pts = ym.min_pts
LIMIT 20;
```

```sql
-- 7. Attach constructor(s) (main constructor proxy) for those minimum drivers, 2009 example
WITH driver_totals AS (
    SELECT r.year,
           res.driver_id,
           SUM(res.points) AS driver_pts
    FROM results AS res
    JOIN races   AS r ON r.race_id = res.race_id
    WHERE r.year = 2009
    GROUP BY r.year, res.driver_id
    HAVING driver_pts > 0
),
main_team AS (
    SELECT r.year,
           res.driver_id,
           res.constructor_id,
           SUM(res.points) AS pts_for_team,
           ROW_NUMBER() OVER (
                PARTITION BY r.year, res.driver_id
                ORDER BY SUM(res.points) DESC
           ) AS rn
    FROM results AS res
    JOIN races   AS r ON r.race_id = res.race_id
    WHERE r.year = 2009
    GROUP BY r.year, res.driver_id, res.constructor_id
),
min_drivers AS (
    SELECT dt.*
    FROM driver_totals dt
    JOIN (SELECT year, MIN(driver_pts) AS m FROM driver_totals GROUP BY year) mm
      ON dt.year = mm.year AND dt.driver_pts = mm.m
)
SELECT md.year,
       md.driver_id,
       ct.name AS constructor_name,
       md.driver_pts
FROM min_drivers   AS md
JOIN main_team     AS mt  ON mt.year = md.year
                         AND mt.driver_id = md.driver_id
                         AND mt.rn = 1          -- pick main constructor
JOIN constructors  AS ct  ON ct.constructor_id = mt.constructor_id
LIMIT 20;
```

```sql
-- 8. Repeat #7 for all years >=2001; output one row per season giving the constructor
--    whose driver(s) had the fewest points
WITH driver_totals AS (
    SELECT r.year,
           res.driver_id,
           SUM(res.points) AS driver_pts
    FROM results AS res
    JOIN races   AS r ON r.race_id = res.race_id
    WHERE r.year >= 2001
    GROUP BY r.year, res.driver_id
    HAVING driver_pts > 0
),
year_mins AS (
    SELECT year, MIN(driver_pts) AS min_pts
    FROM driver_totals
    GROUP BY year
),
min_drivers AS (
    SELECT dt.year, dt.driver_id, dt.driver_pts
    FROM driver_totals dt
    JOIN year_mins ym
      ON dt.year = ym.year AND dt.driver_pts = ym.min_pts
),
main_team AS (
    SELECT r.year,
           res.driver_id,
           res.constructor_id,
           SUM(res.points)  AS pts_for_team,
           ROW_NUMBER() OVER (
               PARTITION BY r.year, res.driver_id
               ORDER BY SUM(res.points) DESC
           ) AS rn
    FROM results AS res
    JOIN races   AS r ON r.race_id = res.race_id
    WHERE r.year >= 2001
    GROUP BY r.year, res.driver_id, res.constructor_id
)
SELECT md.year,
       c.name AS constructor_name,
       md.driver_pts
FROM min_drivers md
JOIN main_team   mt ON mt.year = md.year
                   AND mt.driver_id = md.driver_id
                   AND mt.rn = 1
JOIN constructors c ON c.constructor_id = mt.constructor_id
ORDER BY md.year
LIMIT 20;
```

```sql
-- 9. Count, across all seasons >=2001, how many times each constructor appears in the set
--    of “driver(s) with the fewest points”.
WITH driver_totals AS (
    SELECT r.year,
           res.driver_id,
           SUM(res.points) AS driver_pts
    FROM results AS res
    JOIN races   AS r ON r.race_id = res.race_id
    WHERE r.year >= 2001
    GROUP BY r.year, res.driver_id
    HAVING driver_pts > 0
),
year_mins AS (
    SELECT year, MIN(driver_pts) AS min_pts
    FROM driver_totals
    GROUP BY year
),
min_drivers AS (
    SELECT dt.year, dt.driver_id, dt.driver_pts
    FROM driver_totals dt
    JOIN year_mins ym
      ON dt.year = ym.year AND dt.driver_pts = ym.min_pts
),
main_team AS (
    SELECT r.year,
           res.driver_id,
           res.constructor_id,
           SUM(res.points) AS pts_for_team,
           ROW_NUMBER() OVER (
               PARTITION BY r.year, res.driver_id
               ORDER BY SUM(res.points) DESC
           ) AS rn
    FROM results AS res
    JOIN races   AS r ON r.race_id = res.race_id
    WHERE r.year >= 2001
    GROUP BY r.year, res.driver_id, res.constructor_id
)
SELECT c.name              AS constructor_name,
       COUNT(*)            AS seasons_with_min_driver
FROM min_drivers md
JOIN main_team   mt ON mt.year = md.year
                   AND mt.driver_id = md.driver_id
                   AND mt.rn = 1
JOIN constructors c ON c.constructor_id = mt.constructor_id
GROUP BY c.name
ORDER BY seasons_with_min_driver DESC, constructor_name
LIMIT 20;
