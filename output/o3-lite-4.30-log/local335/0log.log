```sql
--Description / thinking process:
--Goal: Find the five constructors that MOST OFTEN had the driver who finished a season (since 2001) 
--with the fewest points among all drivers who scored at least one point that year.
--
--CTE‑by‑CTE approach:
-- 1) season_driver_pts      : total season points for every driver (only >0 pts).
-- 2) season_min             : minimum of those totals in each year.
-- 3) underperf_drivers      : driver(s) whose total equals that minimum for the year.
-- 4) driver_constructor_pts : for each (year, driver, constructor) sum the points the driver scored
--                             with that constructor (handles mid‑season team changes).
-- 5) ranked                 : within each (year, driver) keep the constructor(s) with which
--                             the driver scored the MOST points (ties kept).
-- 6) fewest_pts_constructors: list of (year, constructor) pairs responsible for the “minimum‑points” driver(s).
-- 7) final SELECT           : count distinct seasons per constructor, order desc, return top‑5.
WITH season_driver_pts AS (
    SELECT r.year,
           res.driver_id,
           SUM(res.points) AS tot_pts
    FROM results AS res
    JOIN races   AS r ON r.race_id = res.race_id
    WHERE r.year >= 2001
    GROUP BY r.year, res.driver_id
    HAVING tot_pts > 0                       -- only point‑scorers
),
season_min AS (
    SELECT year,
           MIN(tot_pts) AS min_pts
    FROM season_driver_pts
    GROUP BY year
),
underperf_drivers AS (
    SELECT sdp.year,
           sdp.driver_id
    FROM season_driver_pts sdp
    JOIN season_min sm
      ON sm.year = sdp.year
     AND sm.min_pts = sdp.tot_pts           -- drivers with the seasonal minimum
),
driver_constructor_pts AS (
    SELECT r.year,
           res.driver_id,
           res.constructor_id,
           SUM(res.points) AS c_pts
    FROM results res
    JOIN races  r ON r.race_id = res.race_id
    GROUP BY r.year, res.driver_id, res.constructor_id
),
ranked AS (
    SELECT dcp.*,
           MAX(c_pts) OVER (PARTITION BY year, driver_id) AS mx
    FROM driver_constructor_pts dcp
),
fewest_pts_constructors AS (
    SELECT ud.year,
           r.constructor_id
    FROM underperf_drivers ud
    JOIN ranked r
      ON r.year      = ud.year
     AND r.driver_id = ud.driver_id
     AND r.c_pts     = r.mx                 -- constructor(s) with most of that driver's points
)
SELECT c.name                                AS constructor_name,
       COUNT(DISTINCT fpc.year)              AS seasons_with_lowest_scoring_driver
FROM fewest_pts_constructors fpc
JOIN constructors c ON c.constructor_id = fpc.constructor_id
GROUP BY fpc.constructor_id
ORDER BY seasons_with_lowest_scoring_driver DESC, constructor_name
LIMIT 5;
