Relevant columns and their potential usage
• races.year : season filter ( >= 2001).  
• races.race_id : joins results / driver_standings to the season.  
• results.driver_id : driver whose points we aggregate for the year.  
• results.constructor_id : constructor that scored the points for that driver.  
• results.points : race‑by‑race points to be summed to a season total.  
• driver_standings.points : alternate source for a driver’s season total (value in the last race of the year).  
• constructors.constructor_id : join key to results.  
• constructors.name : full constructor name to be displayed.  

Typical conditions you’ll need  
• races.year >= 2001  
• results.points > 0  (only point‑scoring drivers)  
• HAVING SUM(results.points) > 0  (same idea after aggregation)  

Ten exploratory queries (each limited to 20 rows)

```sql
-- 1. Seasons on record from 2001 onward
SELECT DISTINCT year
FROM races
WHERE year >= 2001
ORDER BY year
LIMIT 20;
```

```sql
-- 2. A glance at race‑by‑race driver points for the 2001 season
SELECT DISTINCT r.year, res.driver_id, res.points
FROM results AS res
JOIN races AS r ON r.race_id = res.race_id
WHERE r.year = 2001
LIMIT 20;
```

```sql
-- 3. Total points per driver for one season (2001) – only point scorers
SELECT r.year,
       res.driver_id,
       SUM(res.points) AS total_pts
FROM results AS res
JOIN races  AS r ON r.race_id = res.race_id
WHERE r.year = 2001
GROUP BY r.year, res.driver_id
HAVING total_pts > 0
LIMIT 20;
```

```sql
-- 4. Minimum total points scored by any point‑scoring driver in each season since 2001
WITH season_driver_pts AS (
  SELECT r.year,
         res.driver_id,
         SUM(res.points) AS tot
  FROM results res
  JOIN races  r ON r.race_id = res.race_id
  WHERE r.year >= 2001
  GROUP BY r.year, res.driver_id
  HAVING tot > 0
)
SELECT year, MIN(tot) AS min_pts
FROM season_driver_pts
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
-- 5. Drivers who actually posted that minimum in 2001
WITH season_driver_pts AS (
  SELECT r.year,
         res.driver_id,
         SUM(res.points) AS tot
  FROM results res
  JOIN races  r ON r.race_id = res.race_id
  WHERE r.year = 2001
  GROUP BY r.year, res.driver_id
  HAVING tot > 0
),
min_val AS (
  SELECT MIN(tot) AS m FROM season_driver_pts
)
SELECT DISTINCT sdp.driver_id, sdp.tot
FROM season_driver_pts sdp, min_val
WHERE sdp.tot = min_val.m
LIMIT 20;
```

```sql
-- 6. Constructor(s) each of those minimum‑point drivers scored the MOST points with in that same season (2001 example)
WITH driver_constr_pts AS (
  SELECT r.year,
         res.driver_id,
         res.constructor_id,
         SUM(res.points) AS c_pts
  FROM results res
  JOIN races  r ON r.race_id = res.race_id
  WHERE r.year = 2001
  GROUP BY r.year, res.driver_id, res.constructor_id
),
ranked AS (
  SELECT dcp.*,
         MAX(c_pts) OVER (PARTITION BY year, driver_id) AS max_cp
  FROM driver_constr_pts dcp
)
SELECT DISTINCT rc.driver_id,
       rc.constructor_id,
       rc.c_pts AS points_with_team
FROM ranked rc
WHERE rc.c_pts = rc.max_cp
LIMIT 20;
```

```sql
-- 7. Same logic but for every season since 2001 – map each “fewest‑points” driver to ONE constructor
WITH season_driver_pts AS (
  SELECT r.year,
         res.driver_id,
         SUM(res.points) AS tot
  FROM results res
  JOIN races  r ON r.race_id = res.race_id
  WHERE r.year >= 2001
  GROUP BY r.year, res.driver_id
  HAVING tot > 0
),
season_min AS (
  SELECT year, MIN(tot) AS min_pts
  FROM season_driver_pts
  GROUP BY year
),
underperf AS (
  SELECT sdp.year, sdp.driver_id
  FROM season_driver_pts sdp
  JOIN season_min sm
       ON sm.year = sdp.year AND sm.min_pts = sdp.tot
),
driver_constr_pts AS (
  SELECT r.year,
         res.driver_id,
         res.constructor_id,
         SUM(res.points) AS c_pts
  FROM results res
  JOIN races  r ON r.race_id = res.race_id
  GROUP BY r.year, res.driver_id, res.constructor_id
),
preferred_constr AS (
  SELECT dcp.*,
         MAX(c_pts) OVER (PARTITION BY year, driver_id) AS mx
  FROM driver_constr_pts dcp
)
SELECT DISTINCT up.year,
       pc.driver_id,
       pc.constructor_id,
       pc.c_pts
FROM underperf up
JOIN preferred_constr pc
     ON pc.year = up.year
    AND pc.driver_id = up.driver_id
    AND pc.c_pts  = pc.mx
ORDER BY up.year
LIMIT 20;
```

```sql
-- 8. Count how many seasons each constructor appears in that “fewest‑points” list
WITH fewest_pts_drivers AS (
  -- (use query 7 but without the final LIMIT)
  SELECT up.year,
         pc.constructor_id
  FROM (
      /* underperforming drivers per season */
      WITH season_driver_pts AS (
        SELECT r.year,
               res.driver_id,
               SUM(res.points) AS tot
        FROM results res
        JOIN races  r ON r.race_id = res.race_id
        WHERE r.year >= 2001
        GROUP BY r.year, res.driver_id
        HAVING tot > 0
      ),
      season_min AS (
        SELECT year, MIN(tot) AS min_pts
        FROM season_driver_pts
        GROUP BY year
      ),
      underperf AS (
        SELECT sdp.year, sdp.driver_id
        FROM season_driver_pts sdp
        JOIN season_min sm
          ON sm.year = sdp.year AND sm.min_pts = sdp.tot
      )
      SELECT up.year, up.driver_id
      FROM underperf up
  ) AS up
  JOIN (
      /* pick main constructor for each driver/year */
      WITH driver_constr_pts AS (
        SELECT r.year,
               res.driver_id,
               res.constructor_id,
               SUM(res.points) AS c_pts
        FROM results res
        JOIN races  r ON r.race_id = res.race_id
        GROUP BY r.year, res.driver_id, res.constructor_id
      ),
      ranked AS (
        SELECT dcp.*,
               MAX(c_pts) OVER (PARTITION BY year, driver_id) AS mx
        FROM driver_constr_pts dcp
      )
      SELECT year, driver_id, constructor_id
      FROM ranked
      WHERE c_pts = mx
  ) pc
    ON pc.year = up.year AND pc.driver_id = up.driver_id
)
SELECT constructor_id,
       COUNT(DISTINCT year) AS seasons_as_lowest
FROM fewest_pts_drivers
GROUP BY constructor_id
ORDER BY seasons_as_lowest DESC
LIMIT 20;
```

```sql
-- 9. Attach constructor names to those counts (top 20 just to inspect)
WITH constructor_counts AS (
  /* query 8 without LIMIT */
  SELECT constructor_id,
         COUNT(DISTINCT year) AS seasons_as_lowest
  FROM (
      /* derived table fewest_pts_drivers from query 8 */
  ) 
  GROUP BY constructor_id
)
SELECT c.name,
       cc.seasons_as_lowest
FROM constructor_counts cc
JOIN constructors c ON c.constructor_id = cc.constructor_id
ORDER BY cc.seasons_as_lowest DESC, c.name
LIMIT 20;
```

```sql
-- 10. Final answer: the five constructors with the MOST seasons
WITH season_driver_pts AS (
  SELECT r.year,
         res.driver_id,
         SUM(res.points) AS tot
  FROM results res
  JOIN races  r ON r.race_id = res.race_id
  WHERE r.year >= 2001
  GROUP BY r.year, res.driver_id
  HAVING tot > 0
),
season_min AS (
  SELECT year, MIN(tot) AS min_pts
  FROM season_driver_pts
  GROUP BY year
),
underperf AS (
  SELECT sdp.year, sdp.driver_id
  FROM season_driver_pts sdp
  JOIN season_min sm
    ON sm.year = sdp.year AND sm.min_pts = sdp.tot
),
driver_constr_pts AS (
  SELECT r.year,
         res.driver_id,
         res.constructor_id,
         SUM(res.points) AS c_pts
  FROM results res
  JOIN races  r ON r.race_id = res.race_id
  GROUP BY r.year, res.driver_id, res.constructor_id
),
ranked AS (
  SELECT dcp.*,
         MAX(c_pts) OVER (PARTITION BY year, driver_id) AS mx
  FROM driver_constr_pts dcp
),
underperf_constr AS (
  SELECT up.year,
         r.constructor_id
  FROM underperf up
  JOIN ranked r
    ON r.year = up.year
   AND r.driver_id = up.driver_id
   AND r.c_pts   = r.mx
)
SELECT c.name                                   AS constructor_name,
       COUNT(DISTINCT uc.year)                  AS seasons_with_lowest_points
FROM underperf_constr uc
JOIN constructors       c ON c.constructor_id = uc.constructor_id
GROUP BY uc.constructor_id
ORDER BY seasons_with_lowest_points DESC, c.name
LIMIT 5;
```

The last query delivers the requested top‑five constructors along with how many seasons (since 2001) one of their drivers finished the year with the fewest points among all point‑scoring drivers.
