--Description:  Corrected “final answer” query (previous #10). 
--It returns the five constructors that most frequently had, since 2001, the driver who ended
--the season with the FEWEST points among all point‑scoring drivers.
--CTE flow:
-- 1) season_driver_pts   – season‑total points for every driver (>0 pts only).
-- 2) season_min          – minimum of those totals per season.
-- 3) underperf_drivers   – driver(s) who equal that minimum.
-- 4) driver_constructor_pts – points each of those drivers scored for every constructor that year.
-- 5) ranked              – per (year, driver) keep constructor(s) with which driver scored MOST points.
-- 6) underperf_constr    – (year, constructor) pairs tied to the minimum‑points driver(s).
--Final SELECT counts how many distinct seasons each constructor appears and shows the top five.
WITH season_driver_pts AS (
    SELECT r.year,
           res.driver_id,
           SUM(res.points) AS tot_pts
    FROM results AS res
    JOIN races   AS r ON r.race_id = res.race_id
    WHERE r.year >= 2001
    GROUP BY r.year, res.driver_id
    HAVING tot_pts > 0
),
season_min AS (
    SELECT year,
           MIN(tot_pts) AS min_pts
    FROM season_driver_pts
    GROUP BY year
),
underperf_drivers AS (
    SELECT sdp.year,
           sdp.driver_id
    FROM season_driver_pts sdp
    JOIN season_min sm
      ON sm.year = sdp.year
     AND sm.min_pts = sdp.tot_pts
),
driver_constructor_pts AS (
    SELECT r.year,
           res.driver_id,
           res.constructor_id,
           SUM(res.points) AS c_pts
    FROM results res
    JOIN races  r ON r.race_id = res.race_id
    GROUP BY r.year, res.driver_id, res.constructor_id
),
ranked AS (
    SELECT dcp.*,
           MAX(c_pts) OVER (PARTITION BY year, driver_id) AS mx
    FROM driver_constructor_pts dcp
),
underperf_constr AS (
    SELECT ud.year,
           r.constructor_id
    FROM underperf_drivers ud
    JOIN ranked r
      ON r.year      = ud.year
     AND r.driver_id = ud.driver_id
     AND r.c_pts     = r.mx
)
SELECT c.name                                AS constructor_name,
       COUNT(DISTINCT uc.year)               AS seasons_with_lowest_scoring_driver
FROM underperf_constr uc
JOIN constructors c ON c.constructor_id = uc.constructor_id
GROUP BY uc.constructor_id
ORDER BY seasons_with_lowest_scoring_driver DESC, constructor_name
LIMIT 5
