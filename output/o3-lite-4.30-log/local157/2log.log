Begin Exploring Related Columns
Relevant columns and their potential usages  
• “ticker”: identifies each cryptocurrency – required for grouping and window calculations  
• “market_date”: trade‑date in DD‑MM‑YYYY text form – needed for the Aug‑01 to Aug‑10, 2021 filter and chronological ordering  
• “volume”: traded volume as a text string that can end with “K” or “M” or “‑” – must be converted to a pure number before calculating percent change  
Conditions that will be used  
• Convert “volume” to a numeric value:  
  ‑ “582.04K”  →  582.04 × 1 000  
  ‑ “1.2M”      →  1.2 × 1 000 000  
  ‑ “‑”          →  0  
• Keep rows whose market_date is between ‘01‑08‑2021’ and ‘10‑08‑2021’ (inclusive)  
• When looking for the “previous day’s volume”, skip rows where the converted volume is 0  

Exploratory SQLs (each limited to 20 rows)

```sql
-- 1. Distinct tickers in the bitcoin_prices table
SELECT DISTINCT "ticker"
FROM "bitcoin_prices"
LIMIT 20;
```

```sql
-- 2. Inspect a few raw volume strings to understand their formats
SELECT "ticker", "market_date", "volume"
FROM "bitcoin_prices"
LIMIT 20;
```

```sql
-- 3. Check which rows fall in the 1‑Aug‑2021 to 10‑Aug‑2021 window
SELECT "ticker", "market_date", "volume"
FROM "bitcoin_prices"
WHERE "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
LIMIT 20;
```

```sql
-- 4. Look at volumes ending in 'K'
SELECT "ticker", "market_date", "volume"
FROM "bitcoin_prices"
WHERE "volume" LIKE '%K'
LIMIT 20;
```

```sql
-- 5. Look at volumes ending in 'M'
SELECT "ticker", "market_date", "volume"
FROM "bitcoin_prices"
WHERE "volume" LIKE '%M'
LIMIT 20;
```

```sql
-- 6. Find rows where volume is recorded as '-' (treated as zero)
SELECT "ticker", "market_date", "volume"
FROM "bitcoin_prices"
WHERE "volume" = '-'
LIMIT 20;
```

```sql
-- 7. Convert volume strings to a pure numeric column (quick test)
SELECT "ticker",
       "volume",
       CASE
         WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL)*1000
         WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL)*1000000
         WHEN "volume" = '-'     THEN 0
         ELSE CAST("volume" AS REAL)
       END AS "volume_num"
FROM "bitcoin_prices"
LIMIT 20;
```

```sql
-- 8. Preview converted numeric volumes for 1‑Aug‑2021 to 10‑Aug‑2021
SELECT "ticker",
       "market_date",
       CASE
         WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL)*1000
         WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL)*1000000
         WHEN "volume" = '-'     THEN 0
         ELSE CAST("volume" AS REAL)
       END AS "volume_num"
FROM "bitcoin_prices"
WHERE "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
LIMIT 20;
```

```sql
-- 9. Attach previous non‑zero volume using LAG (window) for a quick check
WITH v AS (
  SELECT "ticker",
         "market_date",
         CASE
           WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL)*1000
           WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL)*1000000
           WHEN "volume" = '-'     THEN 0
           ELSE CAST("volume" AS REAL)
         END AS "vol_num"
  FROM "bitcoin_prices"
  WHERE "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
)
SELECT "ticker",
       "market_date",
       "vol_num",
       LAG("vol_num") OVER (PARTITION BY "ticker" ORDER BY "market_date") AS "prev_raw"
FROM v
LIMIT 20;
```

```sql
-- 10. Final calculation: daily % change in trading volume (skip zero volumes for “prev”)
WITH vols AS (
  SELECT "ticker",
         "market_date",
         CASE
           WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL)*1000
           WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL)*1000000
           WHEN "volume" = '-'     THEN 0
           ELSE CAST("volume" AS REAL)
         END AS "vol_num"
  FROM "bitcoin_prices"
  WHERE "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
),
non_zero AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY "ticker" ORDER BY "market_date") AS rn
  FROM vols
  WHERE "vol_num" <> 0
),
joined AS (
  SELECT v.*,
         (SELECT nz."vol_num"
            FROM non_zero nz
           WHERE nz."ticker" = v."ticker"
             AND nz.rn = (
                 SELECT rn FROM non_zero
                 WHERE "ticker" = v."ticker"
                   AND "market_date" = v."market_date"
             ) - 1
         ) AS "prev_non_zero"
  FROM vols v
)
SELECT "ticker",
       "market_date",
       "vol_num",
       "prev_non_zero",
       CASE
         WHEN "prev_non_zero" IS NOT NULL
              AND "prev_non_zero" <> 0
         THEN ROUND(100.0 * ("vol_num" - "prev_non_zero") / "prev_non_zero", 2)
       END AS "pct_change"
FROM joined
ORDER BY "ticker", "market_date"
LIMIT 20;
```
