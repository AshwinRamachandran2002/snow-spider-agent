WITH raw AS (   -- convert volume strings and create sortable ISO date
    SELECT
        "ticker",
        "market_date",
        substr("market_date",7,4) || '-' || substr("market_date",4,2) || '-' || substr("market_date",1,2) AS iso_date,
        CASE
            WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL)*1000
            WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL)*1000000
            WHEN "volume" = '-'     THEN 0
            ELSE CAST("volume" AS REAL)
        END AS vol_num
    FROM "bitcoin_prices"
),
vols AS (        -- keep all data up to 10‑Aug‑2021 so a “previous” value exists
    SELECT *
    FROM raw
    WHERE iso_date <= '2021-08-10'
),
non_zero AS (    -- only non‑zero volumes get a row number for “previous” lookup
    SELECT
        ticker,
        iso_date,
        vol_num,
        ROW_NUMBER() OVER (PARTITION BY ticker ORDER BY iso_date) AS rn
    FROM vols
    WHERE vol_num <> 0
),
calc AS (        -- attach the previous non‑zero volume
    SELECT
        v.ticker,
        v.iso_date,
        v."market_date",
        v.vol_num,
        p.vol_num AS prev_vol
    FROM vols v
    LEFT JOIN non_zero n
           ON n.ticker = v.ticker
          AND n.iso_date = v.iso_date
    LEFT JOIN non_zero p
           ON p.ticker = n.ticker
          AND p.rn     = n.rn - 1          -- previous non‑zero row
    WHERE v.iso_date BETWEEN '2021-08-01' AND '2021-08-10'
)
SELECT
    ticker,
    "market_date" AS date,
    ROUND(100.0 * (vol_num - prev_vol) / prev_vol, 4) AS volume_pct_change
FROM calc
WHERE prev_vol IS NOT NULL        -- drop first row where change can’t be computed
ORDER BY
    ticker,
    iso_date;
```
