Query:
--Description: Add a LAG window function to see the previous day’s numeric volume (prev_vol_raw)
--for every ticker within 01‑10 Aug 2021.  Zero‑volume rows from the base CTE are kept so we can
--inspect them, although later logic will disregard zeros when finding the last non‑zero volume.
WITH base AS (
    SELECT
        "ticker",
        date(substr("market_date",7,4) || '-' ||
             substr("market_date",4,2) || '-' ||
             substr("market_date",1,2)) AS "parsed_date",
        "market_date",
        CASE
            WHEN "volume" = '-'     THEN 0
            WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
            WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
            ELSE CAST("volume" AS REAL)
        END AS "vol_num"
    FROM   "bitcoin_prices"
    WHERE  "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
)
SELECT
    ticker,
    market_date,
    vol_num,
    LAG(vol_num) OVER (PARTITION BY ticker ORDER BY parsed_date) AS "prev_vol_raw"
FROM   base
ORDER  BY ticker, parsed_date
LIMIT 20
