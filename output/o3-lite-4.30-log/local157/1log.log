Query:
--Description: Produce the final result set for 01‑10 Aug 2021 that calculates the daily percentage
--change in trading volume relative to the most recent prior non‑zero volume.  If the previous non‑
--zero volume is 0 or NULL, pct_change_volume is returned as NULL.  Result is ordered by ticker and
--date.
WITH base AS (
    SELECT
        "ticker",
        date(substr("market_date",7,4) || '-' ||
             substr("market_date",4,2) || '-' ||
             substr("market_date",1,2)) AS "parsed_date",
        "market_date",
        CASE
            WHEN "volume" = '-'     THEN 0
            WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
            WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
            ELSE CAST("volume" AS REAL)
        END AS "vol_num"
    FROM   "bitcoin_prices"
    WHERE  "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
),
non_zero AS (
    SELECT
        *,
        MAX(CASE WHEN vol_num > 0 THEN parsed_date END)
            OVER (PARTITION BY ticker
                  ORDER BY parsed_date
                  ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS "prev_good_date"
    FROM base
),
paired AS (
    SELECT
        cur.ticker,
        cur.market_date,
        cur.vol_num  AS today_vol,
        prev.vol_num AS prev_non_zero_vol
    FROM   non_zero AS cur
    LEFT   JOIN base AS prev
           ON prev.ticker      = cur.ticker
          AND prev.parsed_date = cur.prev_good_date
)
SELECT
    ticker,
    market_date,
    today_vol,
    prev_non_zero_vol,
    CASE
        WHEN prev_non_zero_vol IS NULL OR prev_non_zero_vol = 0
             THEN NULL
        ELSE ROUND((today_vol - prev_non_zero_vol) * 100.0 / prev_non_zero_vol, 2)
    END AS "pct_change_volume"
FROM   paired
ORDER  BY ticker,
          date(substr(market_date,7,4) || '-' ||
               substr(market_date,4,2) || '-' ||
               substr(market_date,1,2))
LIMIT 20
