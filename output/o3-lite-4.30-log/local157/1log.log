Begin Exploring Related Columns
Relevant tables and columns for the task  
bitcoin_prices.ticker        : group/partition identifier for each crypto asset  
bitcoin_prices.market_date   : filter to 01‑08‑2021 → 10‑08‑2021 and order chronologically  
bitcoin_prices.volume        : volume string that must be cleaned  
─ conditions ─  
• market_date BETWEEN '01-08-2021' AND '10-08-2021'  
• volume <> '-'  (treat ‘‑’ as 0, but do not use those 0‑rows as previous‑day reference)  

Below are ten exploratory SQL statements – from very simple inspection through to the full step that returns the required result.  
(Every query is limited to 20 rows so it can be run safely in any environment.)

```sql
-- 1. List all distinct tickers in the bitcoin_prices table
SELECT DISTINCT "ticker"
FROM "bitcoin_prices"
LIMIT 20;
```

```sql
-- 2. Inspect what the raw market_date values look like
SELECT DISTINCT "market_date"
FROM "bitcoin_prices"
WHERE "market_date" LIKE '%-08-2021'
ORDER BY "market_date" ASC
LIMIT 20;
```

```sql
-- 3. Take a quick look at raw volume strings for early‑August 2021
SELECT "ticker",
       "market_date",
       "volume"
FROM   "bitcoin_prices"
WHERE  "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER  BY "ticker", "market_date"
LIMIT 20;
```

```sql
-- 4. Convert the TEXT volume into a numeric value (K=thousand, M=million, '-'=0)
SELECT "ticker",
       "market_date",
       "volume"                                          AS "vol_raw",
       CASE
           WHEN "volume" = '-'                  THEN 0
           WHEN "volume" LIKE '%K'              THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
           WHEN "volume" LIKE '%M'              THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
           ELSE CAST("volume" AS REAL)
       END                                            AS "vol_num"
FROM   "bitcoin_prices"
WHERE  "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
LIMIT 20;
```

```sql
-- 5. Show the rows whose numeric volume is actually zero
SELECT "ticker",
       "market_date",
       "volume" AS "vol_raw"
FROM   "bitcoin_prices"
WHERE  "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
  AND  ( "volume" = '-' OR "volume" = '0' )
ORDER  BY "ticker", "market_date"
LIMIT 20;
```

```sql
-- 6. Bring in a parsed_date column so window functions sort correctly
SELECT "ticker",
       date(substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2)) AS "parsed_date",
       "market_date",
       CASE
           WHEN "volume" = '-'                  THEN 0
           WHEN "volume" LIKE '%K'              THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
           WHEN "volume" LIKE '%M'              THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
           ELSE CAST("volume" AS REAL)
       END AS "vol_num"
FROM   "bitcoin_prices"
WHERE  "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER  BY "ticker", "parsed_date"
LIMIT 20;
```

```sql
-- 7. Use a window‐function LAG to look at the previous day's numeric volume
--    (still includes zero‑volume days so that we can later decide whether to ignore them)
WITH base AS (
    SELECT "ticker",
           date(substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2)) AS "parsed_date",
           "market_date",
           CASE
               WHEN "volume" = '-'                  THEN 0
               WHEN "volume" LIKE '%K'              THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
               WHEN "volume" LIKE '%M'              THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
               ELSE CAST("volume" AS REAL)
           END AS "vol_num"
    FROM   "bitcoin_prices"
    WHERE  "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
)
SELECT ticker,
       market_date,
       vol_num,
       LAG(vol_num) OVER (PARTITION BY ticker ORDER BY parsed_date) AS "prev_vol_raw"
FROM   base
ORDER  BY ticker, parsed_date
LIMIT 20;
```

```sql
-- 8. Find EACH row’s most recent *non‑zero* previous volume for that ticker
WITH base AS (
    SELECT "ticker",
           date(substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2)) AS "parsed_date",
           "market_date",
           CASE
               WHEN "volume" = '-'                  THEN 0
               WHEN "volume" LIKE '%K'              THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
               WHEN "volume" LIKE '%M'              THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
               ELSE CAST("volume" AS REAL)
           END AS "vol_num"
    FROM   "bitcoin_prices"
    WHERE  "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
),
non_zero AS (
    SELECT *,
           MAX(CASE WHEN vol_num > 0 THEN parsed_date END)
           OVER (PARTITION BY ticker
                 ORDER BY parsed_date
                 ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS "prev_good_date"
    FROM   base
)
SELECT *
FROM   non_zero
ORDER  BY ticker, parsed_date
LIMIT 20;
```

```sql
-- 9. Join back to grab the volume of that “prev_good_date”
WITH base AS (
    SELECT "ticker",
           date(substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2)) AS "parsed_date",
           "market_date",
           CASE
               WHEN "volume" = '-'                  THEN 0
               WHEN "volume" LIKE '%K'              THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
               WHEN "volume" LIKE '%M'              THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
               ELSE CAST("volume" AS REAL)
           END AS "vol_num"
    FROM   "bitcoin_prices"
    WHERE  "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
),
non_zero AS (
    SELECT *,
           MAX(CASE WHEN vol_num > 0 THEN parsed_date END)
           OVER (PARTITION BY ticker
                 ORDER BY parsed_date
                 ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS "prev_good_date"
    FROM   base
)
SELECT cur.ticker,
       cur.market_date,
       cur.vol_num                     AS "today_vol",
       prev.vol_num                    AS "prev_good_vol"
FROM   non_zero  AS cur
LEFT   JOIN base AS prev
       ON  prev.ticker      = cur.ticker
       AND prev.parsed_date = cur.prev_good_date
ORDER  BY cur.ticker, cur.parsed_date
LIMIT 20;
```

```sql
-- 10. Final query: compute daily % change from the most recent non‑zero volume
WITH base AS (
    SELECT "ticker",
           date(substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2)) AS "parsed_date",
           "market_date",
           CASE
               WHEN "volume" = '-'                  THEN 0
               WHEN "volume" LIKE '%K'              THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
               WHEN "volume" LIKE '%M'              THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
               ELSE CAST("volume" AS REAL)
           END AS "vol_num"
    FROM   "bitcoin_prices"
    WHERE  "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
),
non_zero AS (
    SELECT *,
           MAX(CASE WHEN vol_num > 0 THEN parsed_date END)
           OVER (PARTITION BY ticker
                 ORDER BY parsed_date
                 ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS "prev_good_date"
    FROM   base
),
paired AS (
    SELECT cur.ticker,
           cur.market_date,
           cur.vol_num             AS today_vol,
           prev.vol_num            AS prev_non_zero_vol
    FROM   non_zero  AS cur
    LEFT   JOIN base AS prev
           ON  prev.ticker      = cur.ticker
           AND prev.parsed_date = cur.prev_good_date
)
SELECT ticker,
       market_date,
       today_vol,
       prev_non_zero_vol,
       CASE 
           WHEN prev_non_zero_vol IS NULL OR prev_non_zero_vol = 0 THEN NULL
           ELSE ROUND( (today_vol - prev_non_zero_vol) * 100.0 / prev_non_zero_vol , 2)
       END AS "pct_change_volume"
FROM   paired
ORDER  BY ticker, date(substr(market_date,7,4)||'-'||substr(market_date,4,2)||'-'||substr(market_date,1,2))
LIMIT 20;
```

These incremental queries show each transformation step needed to arrive at the requested daily percentage‑change in trading volume for every ticker between 1 – 10 Aug 2021, while honouring all data‑cleaning rules.
