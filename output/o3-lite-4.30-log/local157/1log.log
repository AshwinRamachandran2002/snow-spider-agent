Query:
--Description: Create a base set for 01‑10 Aug 2021 with a proper date column (parsed_date) and a numeric
--volume (vol_num).  Placeholder volumes ('-' or '0') are converted to 0 and everything else is
--converted from K or M to an absolute number.  The output is ordered so later steps can apply
--window functions correctly.
SELECT
    "ticker",
    date(substr("market_date",7,4) || '-' ||
         substr("market_date",4,2) || '-' ||
         substr("market_date",1,2))           AS "parsed_date",
    "market_date",
    CASE
        WHEN "volume" = '-'       THEN 0
        WHEN "volume" LIKE '%K'   THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
        WHEN "volume" LIKE '%M'   THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
        ELSE CAST("volume" AS REAL)
    END                                       AS "vol_num"
FROM   "bitcoin_prices"
WHERE  "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER  BY "ticker", "parsed_date"
LIMIT 20
