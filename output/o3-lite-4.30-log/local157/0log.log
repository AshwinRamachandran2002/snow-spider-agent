2025-05-01 03:25:29 - Thread-1405 (execute) - INFO - [Exploration]
Relevant columns for the requirement  
• ticker : used to partition the calculation by crypto‐asset  
• market_date : used to restrict the window to 1‑Aug‑2021 … 10‑Aug‑2021 and to order observations chronologically  
• volume : raw text we must normalise ( “K” -> ×1 000, “M” -> ×1 000 000, “–” → 0 ) before the %Δ calculation  
(Numeric columns price, open, high, low can help us verify ordering but are not strictly required.)  

Typical filter conditions we will repeatedly need  
1. substr(market_date,4,7)= '08-2021'  → keeps August‑2021 only  
2. cast(substr(market_date,1,2) AS INTEGER) BETWEEN 1 AND 10  → keeps 01‑Aug ..10‑Aug  
3. volume <> '-'  → keeps non‑zero rows when we need “previous non‑zero volume”  
4. ticker = 'BTC' (or other ticker)  → isolates one asset for spot checks  

Below are ten exploratory SQL queries that graduate from very simple inspection to the full percentage‑change step.  All of them use LIMIT 20 to avoid flooding the output.  (Double‑quotes enclose identifiers to stay SQLite‑safe.)

```sql
-- 1. Distinct crypto tickers present in the bitcoin_prices table
SELECT DISTINCT "ticker"
FROM "bitcoin_prices"
LIMIT 20;
```

```sql
-- 2. Distinct market_date values that fall in August‑2021
SELECT DISTINCT "market_date"
FROM "bitcoin_prices"
WHERE substr("market_date",4,7) = '08-2021'
ORDER BY "market_date"
LIMIT 20;
```

```sql
-- 3. Quick look at the raw volume strings for the target window
SELECT DISTINCT "ticker", "market_date", "volume"
FROM "bitcoin_prices"
WHERE substr("market_date",4,7) = '08-2021'
  AND CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
ORDER BY "ticker","market_date"
LIMIT 20;
```

```sql
-- 4. Inspect how many different "suffix" patterns (K,M,‑,plain) exist
SELECT DISTINCT
       CASE
           WHEN "volume" LIKE '%K' THEN 'K'
           WHEN "volume" LIKE '%M' THEN 'M'
           WHEN "volume" = '-'      THEN 'dash'
           ELSE 'plain'
       END AS volume_suffix
FROM "bitcoin_prices"
LIMIT 20;
```

```sql
-- 5. Convert volume strings to a numeric value (one ticker only for testing)
SELECT "ticker",
       "market_date",
       "volume",
       CASE
           WHEN "volume" = '-'                      THEN 0
           WHEN "volume" LIKE '%K'                  THEN
                    CAST(REPLACE("volume",'K','') AS REAL) * 1000
           WHEN "volume" LIKE '%M'                  THEN
                    CAST(REPLACE("volume",'M','') AS REAL) * 1000000
           ELSE CAST("volume" AS REAL)
       END AS numeric_volume
FROM "bitcoin_prices"
WHERE "ticker" = 'BTC'
  AND substr("market_date",4,7) = '08-2021'
  AND CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
ORDER BY "market_date"
LIMIT 20;
```

```sql
-- 6. Bring in the previous day's (chronological) numeric_volume with a window function
SELECT "ticker",
       "market_date",
       CASE
           WHEN "volume" = '-'                      THEN 0
           WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL)*1000
           WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL)*1000000
           ELSE CAST("volume" AS REAL)
       END AS numeric_volume,
       LAG(
           CASE
               WHEN "volume" = '-'                      THEN 0
               WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL)*1000
               WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL)*1000000
               ELSE CAST("volume" AS REAL)
           END
       ) OVER (PARTITION BY "ticker"
               ORDER BY DATE(substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2))
       )  AS prev_day_volume
FROM "bitcoin_prices"
WHERE "ticker" = 'BTC'
  AND substr("market_date",4,7) = '08-2021'
  AND CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
ORDER BY "market_date"
LIMIT 20;
```

```sql
-- 7. Same as 6 but ignore rows where current numeric_volume = 0
--    (preparing for “previous non‑zero volume” logic)
SELECT *
FROM (
    SELECT "ticker",
           "market_date",
           CASE
               WHEN "volume" = '-'                      THEN 0
               WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL)*1000
               WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL)*1000000
               ELSE CAST("volume" AS REAL)
           END AS numeric_volume
    FROM "bitcoin_prices"
    WHERE substr("market_date",4,7) = '08-2021'
      AND CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
      AND "ticker" = 'BTC'
)
WHERE numeric_volume <> 0
ORDER BY "market_date"
LIMIT 20;
```

```sql
-- 8. Percentage change in numeric_volume for BTC,
--    comparing to the *previous non‑zero* day using a self‑join
WITH cleaned AS (
    SELECT "ticker",
           "market_date",
           CASE
               WHEN "volume" = '-'                      THEN 0
               WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL)*1000
               WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL)*1000000
               ELSE CAST("volume" AS REAL)
           END AS numeric_volume
    FROM "bitcoin_prices"
    WHERE "ticker" = 'BTC'
      AND substr("market_date",4,7) = '08-2021'
      AND CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
),
non_zero AS (
    SELECT *
    FROM cleaned
    WHERE numeric_volume <> 0
)
SELECT curr."ticker",
       curr."market_date",
       curr.numeric_volume,
       prev.numeric_volume AS prev_nonzero_volume,
       ROUND(
           100.0 * (curr.numeric_volume - prev.numeric_volume) / prev.numeric_volume,
           2
       ) AS pct_change
FROM non_zero AS curr
LEFT JOIN non_zero AS prev
  ON prev."ticker" = curr."ticker"
 AND DATE(prev.market_date,'+0 days') = DATE(curr.market_date,'-1 day')
ORDER BY curr."market_date"
LIMIT 20;
```

```sql
-- 9. Compute the %Δ for every ticker inside the target window (simpler approach – previous *calendar* day)
WITH cleaned AS (
    SELECT "ticker",
           "market_date",
           CASE
               WHEN "volume" = '-'                      THEN 0
               WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL)*1000
               WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL)*1000000
               ELSE CAST("volume" AS REAL)
           END AS numeric_volume
    FROM "bitcoin_prices"
    WHERE substr("market_date",4,7) = '08-2021'
      AND CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
),
non_zero AS (
    SELECT *
    FROM cleaned
    WHERE numeric_volume <> 0
)
SELECT curr."ticker",
       curr."market_date",
       curr.numeric_volume,
       prev.numeric_volume AS prev_nonzero_volume,
       ROUND(
           100.0 * (curr.numeric_volume - prev.numeric_volume) / prev.numeric_volume,
           2
       ) AS pct_change
FROM non_zero AS curr
LEFT JOIN non_zero AS prev
  ON prev."ticker"      = curr."ticker"
 AND DATE(substr(prev.market_date,7,4)||'-'||substr(prev.market_date,4,2)||'-'||substr(prev.market_date,1,2))
     = DATE(substr(curr.market_date,7,4)||'-'||substr(curr.market_date,4,2)||'-'||substr(curr.market_date,1,2),'-1 day')
ORDER BY curr."ticker",
         DATE(substr(curr.market_date,7,4)||'-'||substr(curr.market_date,4,2)||'-'||substr(curr.market_date,1,2))
LIMIT 20;
```

```sql
-- 10. Final, fully‑specified query requested in the task statement:
--     daily % change in trading volume for each ticker, 1‑10 Aug 2021,
--     using previous *non‑zero* volume, ordered by ticker & date.
WITH raw AS (
    SELECT "ticker",
           "market_date",
           -- normalise the volume strings
           CASE
               WHEN "volume" = '-'                      THEN 0
               WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL)*1000
               WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL)*1000000
               ELSE CAST("volume" AS REAL)
           END AS numeric_volume
    FROM "bitcoin_prices"
    WHERE substr("market_date",4,7) = '08-2021'
      AND CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
), non_zero AS (
    SELECT *
    FROM raw
    WHERE numeric_volume <> 0
), prev_lookup AS (
    SELECT a."ticker",
           a."market_date",
           a.numeric_volume,
           -- get the most recent prior non‑zero date’s volume via correlated sub‑query
           (
               SELECT b.numeric_volume
               FROM non_zero b
               WHERE b."ticker" = a."ticker"
                 AND DATE(substr(b.market_date,7,4)||'-'||substr(b.market_date,4,2)||'-'||substr(b.market_date,1,2))
                     <  DATE(substr(a.market_date,7,4)||'-'||substr(a.market_date,4,2)||'-'||substr(a.market_date,1,2))
               ORDER BY DATE(substr(b.market_date,7,4)||'-'||substr(b.market_date,4,2)||'-'||substr(b.market_date,1,2)) DESC
               LIMIT 1
           ) AS prev_nonzero_volume
    FROM non_zero a
)
SELECT "ticker",
       "market_date",
       numeric_volume,
       prev_nonzero_volume,
       CASE
           WHEN prev_nonzero_volume IS NULL THEN NULL
           ELSE ROUND(100.0 * (numeric_volume - prev_nonzero_volume) / prev_nonzero_volume,2)
       END AS pct_change_volume
FROM prev_lookup
ORDER BY "ticker",
         DATE(substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2))
LIMIT 20;
```
