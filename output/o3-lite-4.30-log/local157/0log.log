    WHERE "ticker" = 'BTC'
      AND substr("market_date",4,7) = '08-2021'
      AND CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
),
non_zero AS (
    SELECT *
    FROM cleaned
    WHERE numeric_volume <> 0
)
SELECT curr."ticker",
       curr."market_date",
       curr.numeric_volume,
       prev.numeric_volume AS prev_nonzero_volume,
       ROUND(
           100.0 * (curr.numeric_volume - prev.numeric_volume) / prev.numeric_volume,
           2
       ) AS pct_change
FROM non_zero AS curr
LEFT JOIN non_zero AS prev
  ON prev."ticker" = curr."ticker"
 AND DATE(prev.market_date,'+0 days') = DATE(curr.market_date,'-1 day')
ORDER BY curr."market_date"
LIMIT 20;
