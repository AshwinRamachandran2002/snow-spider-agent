                WHERE   b.ticker = a.ticker
                  AND   DATE(substr(b.market_date,7,4)||'-'||substr(b.market_date,4,2)||'-'||substr(b.market_date,1,2))
                        < DATE(substr(a.market_date,7,4)||'-'||substr(a.market_date,4,2)||'-'||substr(a.market_date,1,2))
