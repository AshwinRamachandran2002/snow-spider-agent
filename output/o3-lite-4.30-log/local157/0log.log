SELECT  ticker,
        market_date                 AS date,
        CASE
             WHEN prev_nonzero_volume IS NULL THEN NULL
             ELSE ROUND(100.0 * (numeric_volume - prev_nonzero_volume) / prev_nonzero_volume, 4)
        END                         AS volume_pct_change
