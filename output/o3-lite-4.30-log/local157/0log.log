```sql
-- 10. Final, fully‑specified query requested in the task statement:
--     daily % change in trading volume for each ticker, 1‑10 Aug 2021,
--     using previous *non‑zero* volume, ordered by ticker & date.
WITH raw AS (
    SELECT "ticker",
           "market_date",
           -- normalise the volume strings
           CASE
               WHEN "volume" = '-'                      THEN 0
               WHEN "volume" LIKE '%K' THEN CAST(REPLACE("volume",'K','') AS REAL)*1000
               WHEN "volume" LIKE '%M' THEN CAST(REPLACE("volume",'M','') AS REAL)*1000000
               ELSE CAST("volume" AS REAL)
           END AS numeric_volume
    FROM "bitcoin_prices"
    WHERE substr("market_date",4,7) = '08-2021'
      AND CAST(substr("market_date",1,2) AS INTEGER) BETWEEN 1 AND 10
), non_zero AS (
    SELECT *
    FROM raw
    WHERE numeric_volume <> 0
), prev_lookup AS (
    SELECT a."ticker",
           a."market_date",
           a.numeric_volume,
           -- get the most recent prior non‑zero date’s volume via correlated sub‑query
           (
               SELECT b.numeric_volume
               FROM non_zero b
               WHERE b."ticker" = a."ticker"
                 AND DATE(substr(b.market_date,7,4)||'-'||substr(b.market_date,4,2)||'-'||substr(b.market_date,1,2))
                     <  DATE(substr(a.market_date,7,4)||'-'||substr(a.market_date,4,2)||'-'||substr(a.market_date,1,2))
               ORDER BY DATE(substr(b.market_date,7,4)||'-'||substr(b.market_date,4,2)||'-'||substr(b.market_date,1,2)) DESC
               LIMIT 1
           ) AS prev_nonzero_volume
    FROM non_zero a
)
SELECT "ticker",
       "market_date",
       numeric_volume,
       prev_nonzero_volume,
       CASE
           WHEN prev_nonzero_volume IS NULL THEN NULL
           ELSE ROUND(100.0 * (numeric_volume - prev_nonzero_volume) / prev_nonzero_volume,2)
       END AS pct_change_volume
FROM prev_lookup
ORDER BY "ticker",
         DATE(substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2))
LIMIT 20;
```
