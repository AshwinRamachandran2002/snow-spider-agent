```sql
/* ---------------------------------------------------------------------------
   Find every clone that simultaneously shows
     (1) chr‑13 loss covering 48 303 751–48 481 890
     (2) chr‑17 loss covering 7 668 421–7 687 490
     (3) chr‑11 gain covering 108 223 067–108 369 102
   and return one summary row per clone with the segment coordinates
   and the short karyotype description.
--------------------------------------------------------------------------- */
WITH
/* chr‑13 loss segments that satisfy the positional window */
chr13_loss AS (
  SELECT
    RefNo,
    CaseNo,
    InvNo,
    Clone,
    MIN(Start) AS chr13_start,
    MAX(End)   AS chr13_end
  FROM `mitelman-db.prod.CytoConverted`
  WHERE ChrOrd = 13
    AND Type   = 'Loss'
    AND Start <= 48303751
    AND End   >= 48481890
  GROUP BY RefNo, CaseNo, InvNo, Clone
),

/* chr‑17 loss segments that satisfy the positional window */
chr17_loss AS (
  SELECT
    RefNo,
    CaseNo,
    InvNo,
    Clone,
    MIN(Start) AS chr17_start,
    MAX(End)   AS chr17_end
  FROM `mitelman-db.prod.CytoConverted`
  WHERE ChrOrd = 17
    AND Type   = 'Loss'
    AND Start <=  7668421
    AND End   >=  7687490
  GROUP BY RefNo, CaseNo, InvNo, Clone
),

/* chr‑11 gain segments that satisfy the positional window */
chr11_gain AS (
  SELECT
    RefNo,
    CaseNo,
    InvNo,
    Clone,
    MIN(Start) AS chr11_start,
    MAX(End)   AS chr11_end
  FROM `mitelman-db.prod.CytoConverted`
  WHERE ChrOrd = 11
    AND Type   = 'Gain'
    AND Start <= 108223067
    AND End   >= 108369102
  GROUP BY RefNo, CaseNo, InvNo, Clone
)

/* -------- combine clones that harbour ALL three events ------------------- */
SELECT
  c13.RefNo                     AS case_reference,
  c13.CaseNo                    AS case_number,
  c13.InvNo                     AS investigation_number,
  c13.Clone                     AS clone_name,

  13                            AS chr13_ord,
  c13.chr13_start,
  c13.chr13_end,

  17                            AS chr17_ord,
  c17.chr17_start,
  c17.chr17_end,

  11                            AS chr11_ord,
  c11.chr11_start,
  c11.chr11_end,

  kc.CloneShort                 AS karyotype_short
FROM chr13_loss  AS c13
JOIN chr17_loss  AS c17 USING (RefNo, CaseNo, InvNo, Clone)
JOIN chr11_gain  AS c11 USING (RefNo, CaseNo, InvNo, Clone)
LEFT JOIN `mitelman-db.prod.KaryClone` AS kc
       ON kc.RefNo   = c13.RefNo
      AND kc.CaseNo  = c13.CaseNo
      AND kc.InvNo   = c13.InvNo
      AND kc.CloneNo = c13.Clone
ORDER BY
  case_reference,
  case_number,
  investigation_number,
  clone_name;
```
