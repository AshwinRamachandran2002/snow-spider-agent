```sql
WITH
/* --- keep only segments that fulfil each of the three positional criteria --- */
chr13_loss AS (
  SELECT RefNo, CaseNo, InvNo, Clone, ChrOrd, `Start`, `End`
  FROM `mitelman-db.prod.CytoConverted`
  WHERE ChrOrd = 13
    AND Type   = 'Loss'
    AND `Start` <= 48303751
    AND `End`   >= 48481890
),
chr17_loss AS (
  SELECT RefNo, CaseNo, InvNo, Clone, ChrOrd, `Start`, `End`
  FROM `mitelman-db.prod.CytoConverted`
  WHERE ChrOrd = 17
    AND Type   = 'Loss'
    AND `Start` <=  7668421
    AND `End`   >=  7687490
),
chr11_gain AS (
  SELECT RefNo, CaseNo, InvNo, Clone, ChrOrd, `Start`, `End`
  FROM `mitelman-db.prod.CytoConverted`
  WHERE ChrOrd = 11
    AND Type   = 'Gain'
    AND `Start` <= 108223067
    AND `End`   >= 108369102
),

/* --- identify clones that have ALL three alterations --- */
qualified_clones AS (
  SELECT DISTINCT RefNo, CaseNo, InvNo, Clone
  FROM chr13_loss
  INNER JOIN chr17_loss USING (RefNo, CaseNo, InvNo, Clone)
  INNER JOIN chr11_gain USING (RefNo, CaseNo, InvNo, Clone)
),

/* --- pick ONE representative segment per chromosome for each clone --------- */
best_chr13 AS (
  SELECT *
  FROM (
    SELECT *, ROW_NUMBER() OVER (
            PARTITION BY RefNo, CaseNo, InvNo, Clone
            ORDER BY (`End` - `Start`) DESC                   -- longest interval first
         ) AS rn
    FROM chr13_loss
  )
  WHERE rn = 1
),
best_chr17 AS (
  SELECT *
  FROM (
    SELECT *, ROW_NUMBER() OVER (
            PARTITION BY RefNo, CaseNo, InvNo, Clone
            ORDER BY (`End` - `Start`) DESC
         ) AS rn
    FROM chr17_loss
  )
  WHERE rn = 1
),
best_chr11 AS (
  SELECT *
  FROM (
    SELECT *, ROW_NUMBER() OVER (
            PARTITION BY RefNo, CaseNo, InvNo, Clone
            ORDER BY (`End` - `Start`) DESC
         ) AS rn
    FROM chr11_gain
  )
  WHERE rn = 1
)

/* --- final result ---------------------------------------------------------- */
SELECT
  q.RefNo                    AS case_reference,
  q.CaseNo                   AS case_number,
  q.InvNo                    AS investigation_number,
  q.Clone                    AS clone_name,

  -- chr‑13 loss details
  b13.ChrOrd                 AS chr13_ord,
  b13.`Start`                AS chr13_start,
  b13.`End`                  AS chr13_end,

  -- chr‑17 loss details
  b17.ChrOrd                 AS chr17_ord,
  b17.`Start`                AS chr17_start,
  b17.`End`                  AS chr17_end,

  -- chr‑11 gain details
  b11.ChrOrd                 AS chr11_ord,
  b11.`Start`                AS chr11_start,
  b11.`End`                  AS chr11_end,

  kc.CloneShort              AS karyotype_short
FROM qualified_clones AS q
JOIN best_chr13  AS b13 USING (RefNo, CaseNo, InvNo, Clone)
JOIN best_chr17  AS b17 USING (RefNo, CaseNo, InvNo, Clone)
JOIN best_chr11  AS b11 USING (RefNo, CaseNo, InvNo, Clone)
LEFT JOIN `mitelman-db.prod.KaryClone` AS kc
       ON kc.RefNo   = q.RefNo
      AND kc.CaseNo  = q.CaseNo
      AND kc.InvNo   = q.InvNo
      AND kc.CloneNo = q.Clone
ORDER BY
  case_reference,
  case_number,
  investigation_number,
  clone_name;
