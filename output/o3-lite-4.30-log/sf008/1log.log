    JOIN metro m
      ON gr."GEO_ID" = m."METRO_GEO_ID"
    WHERE gr."RELATIONSHIP_TYPE" = 'Contains'
      AND gr."RELATED_LEVEL"    = 'County'
),
/* ---------------- total AGI inflow into those counties ---------------- */
agi_totals AS (
    SELECT  "DATE",
            SUM("VALUE") AS "TOTAL_AGI_INFLOW_USD"
