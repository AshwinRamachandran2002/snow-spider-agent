--Description: 🔟  Compute the percent change in total AGI inflow for Arizona (state‑level proxy
--              for the Phoenix metro) from the 2022 to 2023 tax years using the “all ages, all
--              AGI classes” inflow variable.
WITH inflow AS (
    SELECT
        "DATE",
        "VALUE"
    FROM   "US_REAL_ESTATE"."CYBERSYN"."IRS_MIGRATION_BY_CHARACTERISTIC_TIMESERIES"
    WHERE
        "GEO_ID"   = 'geoId/04'   -- State of Arizona
        AND "VARIABLE" = 'Inflow_Returns_–_adjusted_gross_income_from_Year_1,_all_ages,_All_AGI_classes'
        AND "DATE" IN ('2022-12-31','2023-12-31')
)
SELECT
    (MAX(CASE WHEN "DATE" = '2023-12-31' THEN "VALUE" END) -
     MAX(CASE WHEN "DATE" = '2022-12-31' THEN "VALUE" END))
     / MAX(CASE WHEN "DATE" = '2022-12-31' THEN "VALUE" END) * 100.0
     AS "INCOME_INFLOW_PCT_CHANGE_2023"
FROM inflow
