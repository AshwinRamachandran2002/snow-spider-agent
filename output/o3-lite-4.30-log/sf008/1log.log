--Description: 9️⃣  Compute the 2023 percent change for the Phoenix metro’s seasonally adjusted
--              purchase‑only HPI by comparing the series’ minimum and maximum 2023 values (works
--              for either monthly or quarterly data captured in query #8).
WITH hpi AS (
    SELECT "DATE","VALUE"
    FROM   "US_REAL_ESTATE"."CYBERSYN"."FHFA_HOUSE_PRICE_TIMESERIES"
    WHERE  "GEO_ID"  = 'geoId/C38060'
      AND  "VARIABLE" ILIKE '%purchase-only%SA%'
      AND  "DATE" BETWEEN '2023-01-01' AND '2023-12-31'
)
SELECT
      (MAX("VALUE") - MIN("VALUE")) / MIN("VALUE") * 100.0
      AS "HPI_PCT_CHANGE_2023"
FROM  hpi
