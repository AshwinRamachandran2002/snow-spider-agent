Relevant columns and how they will be used  

• GEOGRAPHY_INDEX."GEO_NAME": locate the exact text string that represents “Phoenix‑Mesa‑Scottsdale, AZ Metro Area”.  
• GEOGRAPHY_INDEX."GEO_ID": obtain the geographic identifier that will be reused in all fact tables.  
• FHFA_HOUSE_PRICE_ATTRIBUTES."VARIABLE", "VARIABLE_NAME", "SEASONALLY_ADJUSTED", "PROPERTY_CLASSIFICATION": find the exact variable code for the “purchase‑only” & “seasonally adjusted” house‑price index.  
• FHFA_HOUSE_PRICE_TIMESERIES."GEO_ID", "VARIABLE", "DATE", "VALUE": pull the index levels on 2023‑01‑31 and 2023‑12‑31, then derive % change.  
• IRS_MIGRATION_BY_CHARACTERISTIC_ATTRIBUTES."VARIABLE", "VARIABLE_NAME": identify variables that contain “…Inflow…adjusted gross income…”.  
• IRS_MIGRATION_BY_CHARACTERISTIC_TIMESERIES."GEO_ID", "VARIABLE", "DATE", "VALUE": pull the gross‑income‑inflow dollars on 2022‑12‑31 and 2023‑12‑31, then derive % change.  
Conditions you will probably use  

• GEOGRAPHY_INDEX."GEO_NAME" ILIKE '%Phoenix%Scottsdale%'  
• FHFA_HOUSE_PRICE_ATTRIBUTES."VARIABLE_NAME" ILIKE '%purchase%only%Seasonally Adjusted%'  
• IRS_MIGRATION_BY_CHARACTERISTIC_ATTRIBUTES."VARIABLE_NAME" ILIKE '%Inflow%adjusted gross income%'  
• Fact tables WHERE "GEO_ID" = '<Phoenix‑GEO_ID>' AND "DATE" IN ('2023‑01‑31','2023‑12‑31') (HPI) or ('2022‑12‑31','2023‑12‑31') (IRS migration).  

Below are 10 progressively richer exploratory queries (all return at most 20 rows).  
Replace <Phoenix‑GEO_ID> with the identifier you find in query 1.  

```sql
-- 1️⃣  Description: Find the GEO_ID for the Phoenix‑Mesa‑Scottsdale, AZ metro (CBSA/Metropolitan area)
SELECT DISTINCT 
       "GEO_ID",
       "GEO_NAME"
FROM   "US_REAL_ESTATE"."CYBERSYN"."GEOGRAPHY_INDEX"
WHERE  "GEO_NAME" ILIKE '%Phoenix%Mesa%Scottsdale%'
LIMIT  20;

-- 2️⃣  Description: List all FHFA purchase‑only, seasonally‑adjusted variables
SELECT DISTINCT 
       "VARIABLE",
       "VARIABLE_NAME",
       "SEASONALLY_ADJUSTED",
       "PROPERTY_CLASSIFICATION"
FROM   "US_REAL_ESTATE"."CYBERSYN"."FHFA_HOUSE_PRICE_ATTRIBUTES"
WHERE  "VARIABLE_NAME" ILIKE '%purchase-only%' 
  AND  "SEASONALLY_ADJUSTED" = TRUE
LIMIT  20;

-- 3️⃣  Description: Preview monthly HPI values for Phoenix metro in 2023
SELECT 
       "DATE",
       "VALUE",
       "UNIT"
FROM   "US_REAL_ESTATE"."CYBERSYN"."FHFA_HOUSE_PRICE_TIMESERIES"
WHERE  "GEO_ID" = '<Phoenix‑GEO_ID>'
  AND  "VARIABLE" = 'FHFA_HPI_traditional_purchase-only_monthly_SA'
  AND  "DATE" BETWEEN '2023-01-01' AND '2023-12-31'
ORDER  BY "DATE"
LIMIT  20;

-- 4️⃣  Description: Pull HPI values only on 2023‑01‑31 and 2023‑12‑31
SELECT 
       "DATE",
       "VALUE"
FROM   "US_REAL_ESTATE"."CYBERSYN"."FHFA_HOUSE_PRICE_TIMESERIES"
WHERE  "GEO_ID"  = '<Phoenix‑GEO_ID>'
  AND  "VARIABLE" = 'FHFA_HPI_traditional_purchase-only_monthly_SA'
  AND  "DATE" IN ('2023-01-31','2023-12-31')
ORDER  BY "DATE"
LIMIT  20;

-- 5️⃣  Description: Show all IRS migration variables that track inflow AGI dollars
SELECT DISTINCT 
       "VARIABLE",
       "VARIABLE_NAME"
FROM   "US_REAL_ESTATE"."CYBERSYN"."IRS_MIGRATION_BY_CHARACTERISTIC_ATTRIBUTES"
WHERE  "VARIABLE_NAME" ILIKE '%Inflow%adjusted gross income%'
LIMIT  20;

-- 6️⃣  Description: Inspect Phoenix inflow AGI values for all age/AGI sub‑segments for 2023
SELECT 
       "DATE",
       "VARIABLE_NAME",
       "VALUE",
       "UNIT"
FROM   "US_REAL_ESTATE"."CYBERSYN"."IRS_MIGRATION_BY_CHARACTERISTIC_TIMESERIES"
WHERE  "GEO_ID" = '<Phoenix‑GEO_ID>'
  AND  "DATE"  = '2023-12-31'
  AND  "VARIABLE" IN (
        SELECT "VARIABLE"
        FROM   "US_REAL_ESTATE"."CYBERSYN"."IRS_MIGRATION_BY_CHARACTERISTIC_ATTRIBUTES"
        WHERE  "VARIABLE_NAME" ILIKE '%Inflow%adjusted gross income%'
      )
LIMIT  20;

-- 7️⃣  Description: Compare inflow AGI totals for 2022 vs 2023 for each variable
SELECT 
       "VARIABLE",
       "DATE",
       "VALUE"
FROM   "US_REAL_ESTATE"."CYBERSYN"."IRS_MIGRATION_BY_CHARACTERISTIC_TIMESERIES"
WHERE  "GEO_ID" = '<Phoenix‑GEO_ID>'
  AND  "DATE" IN ('2022-12-31','2023-12-31')
  AND  "VARIABLE" IN (
        SELECT "VARIABLE"
        FROM   "US_REAL_ESTATE"."CYBERSYN"."IRS_MIGRATION_BY_CHARACTERISTIC_ATTRIBUTES"
        WHERE  "VARIABLE_NAME" ILIKE '%Inflow%adjusted gross income%'
      )
ORDER  BY "VARIABLE","DATE"
LIMIT  20;

-- 8️⃣  Description: Aggregate total inflow AGI dollars for 2022‑12‑31 and 2023‑12‑31
SELECT 
       "DATE",
       SUM("VALUE") AS "TOTAL_INFLOW_AGI_USD"
FROM   "US_REAL_ESTATE"."CYBERSYN"."IRS_MIGRATION_BY_CHARACTERISTIC_TIMESERIES"
WHERE  "GEO_ID" = '<Phoenix‑GEO_ID>'
  AND  "DATE" IN ('2022-12-31','2023-12-31')
  AND  "VARIABLE" IN (
        SELECT "VARIABLE"
        FROM   "US_REAL_ESTATE"."CYBERSYN"."IRS_MIGRATION_BY_CHARACTERISTIC_ATTRIBUTES"
        WHERE  "VARIABLE_NAME" ILIKE '%Inflow%adjusted gross income%'
      )
GROUP  BY "DATE"
ORDER  BY "DATE"
LIMIT  20;

-- 9️⃣  Description: Calculate 2023 % change for inflow AGI (subquery version)
SELECT 
       ROUND(100.0 * (t23."TOTAL_USD" - t22."TOTAL_USD") / NULLIF(t22."TOTAL_USD",0), 2) AS "PCT_CHANGE_INFLOW_AGI_2023"
FROM (
    SELECT SUM("VALUE") AS "TOTAL_USD"
    FROM   "US_REAL_ESTATE"."CYBERSYN"."IRS_MIGRATION_BY_CHARACTERISTIC_TIMESERIES"
    WHERE  "GEO_ID" = '<Phoenix‑GEO_ID>' AND "DATE" = '2022-12-31'
      AND  "VARIABLE" IN (
           SELECT "VARIABLE"
           FROM   "US_REAL_ESTATE"."CYBERSYN"."IRS_MIGRATION_BY_CHARACTERISTIC_ATTRIBUTES"
           WHERE  "VARIABLE_NAME" ILIKE '%Inflow%adjusted gross income%'
         )
)  t22
JOIN (
    SELECT SUM("VALUE") AS "TOTAL_USD"
    FROM   "US_REAL_ESTATE"."CYBERSYN"."IRS_MIGRATION_BY_CHARACTERISTIC_TIMESERIES"
    WHERE  "GEO_ID" = '<Phoenix‑GEO_ID>' AND "DATE" = '2023-12-31'
      AND  "VARIABLE" IN (
           SELECT "VARIABLE"
           FROM   "US_REAL_ESTATE"."CYBERSYN"."IRS_MIGRATION_BY_CHARACTERISTIC_ATTRIBUTES"
           WHERE  "VARIABLE_NAME" ILIKE '%Inflow%adjusted gross income%'
         )
)  t23
ON 1 = 1
LIMIT 20;

-- 🔟  Description: Calculate 2023 % change for HPI purchase‑only SA index
SELECT 
       ROUND(100.0 * (end2023."VALUE" - beg2023."VALUE") / NULLIF(beg2023."VALUE",0), 2) AS "PCT_CHANGE_HPI_2023"
FROM (
     SELECT "VALUE"
     FROM   "US_REAL_ESTATE"."CYBERSYN"."FHFA_HOUSE_PRICE_TIMESERIES"
     WHERE  "GEO_ID"  = '<Phoenix‑GEO_ID>'
       AND  "VARIABLE" = 'FHFA_HPI_traditional_purchase-only_monthly_SA'
       AND  "DATE" = '2023-01-31'
) beg2023
JOIN (
     SELECT "VALUE"
     FROM   "US_REAL_ESTATE"."CYBERSYN"."FHFA_HOUSE_PRICE_TIMESERIES"
     WHERE  "GEO_ID"  = '<Phoenix‑GEO_ID>'
       AND  "VARIABLE" = 'FHFA_HPI_traditional_purchase-only_monthly_SA'
       AND  "DATE" = '2023-12-31'
) end2023
ON 1 = 1
LIMIT 20;
