```sql
--Description: Calculate the % change in the seasonally‑adjusted purchase‑only HPI
--between January and December 2023 for Phoenix‑Mesa‑Scottsdale.
WITH hpi AS (
  SELECT t."DATE",
         t."VALUE"
  FROM US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_TIMESERIES  t
  JOIN US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_ATTRIBUTES a
    ON t."VARIABLE" = a."VARIABLE"
  WHERE a."SEASONALLY_ADJUSTED" = TRUE
    AND a."VARIABLE_NAME" ILIKE '%purchase-only%'
    AND t."GEO_ID" IN (
          SELECT "GEO_ID"
          FROM US_REAL_ESTATE.CYBERSYN.GEOGRAPHY_INDEX
          WHERE "GEO_NAME" ILIKE '%Phoenix%Mesa%Scottsdale%'
        )
    AND t."DATE" IN ('2023-01-31','2023-12-31')
)
SELECT 100 * (MAX(CASE WHEN "DATE"='2023-12-31' THEN "VALUE" END) -
              MAX(CASE WHEN "DATE"='2023-01-31' THEN "VALUE" END))
          / NULLIF(MAX(CASE WHEN "DATE"='2023-01-31' THEN "VALUE" END),0)
       AS "PCT_CHG_HPI_PURCHASE_ONLY_SA_2023"
FROM hpi
LIMIT 20;
