```sql
--Description: List every FHFA house‑price variable that is seasonally adjusted AND whose
--description mentions “purchase‑only” so we can later pick the correct code.
SELECT DISTINCT "VARIABLE",
       "VARIABLE_NAME"
FROM US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_ATTRIBUTES
WHERE "VARIABLE_NAME" ILIKE '%purchase-only%'
  AND "SEASONALLY_ADJUSTED" = TRUE
LIMIT 20;
```

```sql
--Description: Preview 2023 seasonally‑adjusted purchase‑only HPI values for the
--Phoenix‑Mesa‑Scottsdale metro.  The GEO_ID is fetched on‑the‑fly from GEOGRAPHY_INDEX
--instead of hard‑coding.  The VARIABLE is limited to purchase‑only + SA via join.
SELECT t."DATE",
       t."VALUE",
       t."UNIT"
FROM US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_TIMESERIES  t
JOIN US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_ATTRIBUTES a
  ON t."VARIABLE" = a."VARIABLE"
WHERE a."SEASONALLY_ADJUSTED" = TRUE
  AND a."VARIABLE_NAME" ILIKE '%purchase-only%'
  AND t."GEO_ID" IN (
        SELECT "GEO_ID"
        FROM US_REAL_ESTATE.CYBERSYN.GEOGRAPHY_INDEX
        WHERE "GEO_NAME" ILIKE '%Phoenix%Mesa%Scottsdale%'
      )
  AND t."DATE" BETWEEN '2023-01-01' AND '2023-12-31'
ORDER BY t."DATE"
LIMIT 20;
```

```sql
--Description: Pull the first and last monthly SA purchase‑only HPI values in 2023 for
--Phoenix‑Mesa‑Scottsdale by using window functions.  GEO_ID and VARIABLE are obtained
--dynamically as in the prior query.
WITH hpi AS (
  SELECT t."DATE",
         t."VALUE"
  FROM US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_TIMESERIES  t
  JOIN US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_ATTRIBUTES a
    ON t."VARIABLE" = a."VARIABLE"
  WHERE a."SEASONALLY_ADJUSTED" = TRUE
    AND a."VARIABLE_NAME" ILIKE '%purchase-only%'
    AND t."GEO_ID" IN (
          SELECT "GEO_ID"
          FROM US_REAL_ESTATE.CYBERSYN.GEOGRAPHY_INDEX
          WHERE "GEO_NAME" ILIKE '%Phoenix%Mesa%Scottsdale%'
        )
    AND t."DATE" BETWEEN '2023-01-01' AND '2023-12-31'
)
SELECT FIRST_VALUE("VALUE") OVER(ORDER BY "DATE") AS "VALUE_2023_01",
       LAST_VALUE("VALUE")  OVER(ORDER BY "DATE" ROWS BETWEEN UNBOUNDED PRECEDING
                                                AND UNBOUNDED FOLLOWING) AS "VALUE_2023_12",
       "DATE"
FROM hpi
ORDER BY "DATE"
LIMIT 20;
```

