--Description: Compute the 2023 percentage change in gross‑income inflow for Arizona
--using the same state‑level series obtained above.
SELECT 100 *
       (MAX(CASE WHEN "DATE" = '2023-12-31' THEN "VALUE" END) -
        MAX(CASE WHEN "DATE" = '2022-12-31' THEN "VALUE" END))
       / NULLIF(MAX(CASE WHEN "DATE" = '2022-12-31' THEN "VALUE" END), 0)
       AS "PCT_CHG_GROSS_INCOME_INFLOW_2023"
FROM US_REAL_ESTATE.CYBERSYN.IRS_MIGRATION_BY_CHARACTERISTIC_TIMESERIES
WHERE "GEO_ID" = 'geoId/04'
  AND "VARIABLE" ILIKE 'Inflow%adjusted_gross_income%All_AGI_classes%'
  AND "DATE" IN ('2022-12-31','2023-12-31')
