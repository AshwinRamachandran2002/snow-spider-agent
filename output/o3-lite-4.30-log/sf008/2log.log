Query:
--Description: Pull the first and last seasonally‑adjusted purchase‑only FHFA HPI values
--recorded in 2023 for the Phoenix‑Mesa‑Chandler, AZ metro (GEO_ID = geoId/C38060).  
--Using the known GEO_ID directly avoids the empty‑result issue that arose with a sub‑query.
WITH hpi AS (
    SELECT t."DATE",
           t."VALUE"
    FROM US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_TIMESERIES  t
    JOIN US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_ATTRIBUTES a
      ON t."VARIABLE" = a."VARIABLE"
    WHERE t."GEO_ID" = 'geoId/C38060'
      AND a."SEASONALLY_ADJUSTED" = TRUE
      AND a."VARIABLE_NAME" ILIKE '%purchase-only%'
      AND t."DATE" BETWEEN '2023-01-01' AND '2023-12-31'
)
SELECT FIRST_VALUE("VALUE") OVER (ORDER BY "DATE")                                  AS "VALUE_2023_START",
       LAST_VALUE("VALUE")  OVER (ORDER BY "DATE" ROWS BETWEEN UNBOUNDED PRECEDING
                                                    AND UNBOUNDED FOLLOWING)        AS "VALUE_2023_END",
       "DATE"
FROM hpi
ORDER BY "DATE"
LIMIT 20
