WITH metro AS (                           -- Phoenix‑Mesa‑Scottsdale, AZ MSA
    SELECT 'geoId/C38060' AS "GEO_ID"
),
/*-----------------------------------------------------
 | 1) All counties contained within the metro area
 *----------------------------------------------------*/
metro_counties AS (
    SELECT DISTINCT "RELATED_GEO_ID" AS "COUNTY_GEO_ID"
    FROM US_REAL_ESTATE.CYBERSYN.GEOGRAPHY_RELATIONSHIPS
    WHERE "GEO_ID"          = (SELECT "GEO_ID" FROM metro)
      AND "RELATIONSHIP_TYPE" = 'Contains'
      AND "RELATED_LEVEL"     = 'County'
),
/*-----------------------------------------------------
 | 2) Total adjusted‑gross‑income inflow (USD)
 *----------------------------------------------------*/
gross AS (
    SELECT
        SUM(CASE WHEN t."DATE" = '2022-12-31' THEN COALESCE(t."VALUE",0) END) AS "INFLOW_2022",
        SUM(CASE WHEN t."DATE" = '2023-12-31' THEN COALESCE(t."VALUE",0) END) AS "INFLOW_2023"
    FROM US_REAL_ESTATE.CYBERSYN.IRS_MIGRATION_BY_CHARACTERISTIC_TIMESERIES      t
    JOIN metro_counties                                                          c
         ON t."GEO_ID" = c."COUNTY_GEO_ID"
    JOIN US_REAL_ESTATE.CYBERSYN.IRS_MIGRATION_BY_CHARACTERISTIC_ATTRIBUTES      a
         ON t."VARIABLE" = a."VARIABLE"
    WHERE a."RETURN_GROUP"  ILIKE 'Inflow%'          -- inflow series
      AND a."UNIT"           = 'USD'                 -- dollar amounts
      AND a."INCOME_BRACKET" = 'All AGI classes'     -- total AGI
      AND t."DATE" IN ('2022-12-31','2023-12-31')
),
/*-----------------------------------------------------
 | 3) Seasonally‑adjusted purchase‑only FHFA HPI
 *----------------------------------------------------*/
hpi AS (
    SELECT
        MAX(CASE WHEN "DATE" = '2023-01-31' THEN "VALUE" END) AS "HPI_START_2023",
        MAX(CASE WHEN "DATE" = '2023-12-31' THEN "VALUE" END) AS "HPI_END_2023"
    FROM US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_TIMESERIES
    WHERE "GEO_ID"  = (SELECT "GEO_ID" FROM metro)
      AND "VARIABLE" = 'FHFA_HPI_traditional_purchase-only_monthly_SA'
      AND "DATE" IN ('2023-01-31','2023-12-31')
),
/*-----------------------------------------------------
 | 4) Percentage‑change calculations
 *----------------------------------------------------*/
calc AS (
    SELECT
        ROUND(
            100 * ("INFLOW_2023" - "INFLOW_2022") / NULLIF("INFLOW_2022",0)
        , 4) AS "GROSS_PCT_CHG",
        ROUND(
            100 * ("HPI_END_2023" - "HPI_START_2023") / NULLIF("HPI_START_2023",0)
        , 4) AS "HPI_PCT_CHG"
    FROM gross, hpi
)
/*-----------------------------------------------------
 | 5) Final tidy output
 *----------------------------------------------------*/
SELECT 'gross_income_inflow'                    AS metric,
       "GROSS_PCT_CHG"                         AS percentage_change
FROM   calc
UNION ALL
SELECT 'seasonally_adjusted_purchase_only_hpi'  AS metric,
       "HPI_PCT_CHG"                           AS percentage_change
FROM   calc;
