--Description: Calculate the 2023 percentage change in the seasonally‑adjusted
--purchase‑only FHFA HPI for the Phoenix‑Mesa‑Chandler metro (geoId/C38060) by
--comparing the earliest and latest 2023 quarterly observations.
WITH hpi AS (
    SELECT t."DATE",
           t."VALUE"
    FROM US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_TIMESERIES  t
    JOIN US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_ATTRIBUTES a
      ON t."VARIABLE" = a."VARIABLE"
    WHERE t."GEO_ID" = 'geoId/C38060'
      AND a."SEASONALLY_ADJUSTED" = TRUE
      AND a."VARIABLE_NAME" ILIKE '%purchase-only%'
      AND t."DATE" IN ('2023-03-31','2023-12-31')  -- quarterly series dates
)
SELECT 100 *
       (MAX(CASE WHEN "DATE" = '2023-12-31' THEN "VALUE" END) -
        MAX(CASE WHEN "DATE" = '2023-03-31' THEN "VALUE" END))
       / NULLIF(MAX(CASE WHEN "DATE" = '2023-03-31' THEN "VALUE" END), 0)
       AS "PCT_CHG_HPI_PURCHASE_ONLY_SA_2023"
FROM hpi
