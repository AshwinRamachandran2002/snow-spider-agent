```sql
--Description: Consolidated query returning both percentage changes (gross‑income inflow
--and SA purchase‑only HPI) for Phoenix‑Mesa‑Scottsdale during 2023.
WITH metro AS (
  SELECT "GEO_ID"
  FROM US_REAL_ESTATE.CYBERSYN.GEOGRAPHY_INDEX
  WHERE "GEO_NAME" ILIKE '%Phoenix%Mesa%Scottsdale%'
  LIMIT 1
),
gross AS (
  SELECT 100 * (MAX(CASE WHEN "DATE"='2023-12-31' THEN "VALUE" END) -
                MAX(CASE WHEN "DATE"='2022-12-31' THEN "VALUE" END))
              / NULLIF(MAX(CASE WHEN "DATE"='2022-12-31' THEN "VALUE" END),0)
          AS "GROSS_INCOME_INFLOW_PCT_CHG_2023"
  FROM US_REAL_ESTATE.CYBERSYN.IRS_MIGRATION_BY_CHARACTERISTIC_TIMESERIES g, metro m
  WHERE g."GEO_ID"  = m."GEO_ID"
    AND g."VARIABLE" = 'Inflow_Returns_–_adjusted_gross_income_from_Year_2,_All_AGI_classes' -- replace if needed
    AND g."DATE" IN ('2022-12-31','2023-12-31')
),
hpi AS (
  SELECT 100 * (MAX(CASE WHEN t."DATE"='2023-12-31' THEN t."VALUE" END) -
                MAX(CASE WHEN t."DATE"='2023-01-31' THEN t."VALUE" END))
              / NULLIF(MAX(CASE WHEN t."DATE"='2023-01-31' THEN t."VALUE" END),0)
          AS "HPI_PURCHASE_ONLY_SA_PCT_CHG_2023"
  FROM US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_TIMESERIES  t
  JOIN US_REAL_ESTATE.CYBERSYN.FHFA_HOUSE_PRICE_ATTRIBUTES a
    ON t."VARIABLE" = a."VARIABLE", metro m
  WHERE a."SEASONALLY_ADJUSTED" = TRUE
    AND a."VARIABLE_NAME" ILIKE '%purchase-only%'
    AND t."GEO_ID" = m."GEO_ID"
    AND t."DATE" IN ('2023-01-31','2023-12-31')
)
SELECT *
FROM gross, hpi
LIMIT 20;
```
