WITH session_bounds AS (
    -- first & last event time per session, duration converted to seconds
    SELECT
        "session_id",
        MIN("created_at")                                           AS session_start,
        MAX("created_at")                                           AS session_end,
        (MAX("created_at") - MIN("created_at")) / 1_000_000.0       AS duration_seconds
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
    GROUP BY "session_id"
),
session_browser AS (
    -- attach the browser of the session (taken from the first event)
    SELECT
        e."browser",
        sb.duration_seconds
    FROM session_bounds sb
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS e
      ON e."session_id" = sb."session_id"
     AND e."created_at" = sb.session_start      -- first event in the session
),
browser_stats AS (
    -- average duration & session count per browser, keep those with >10 sessions
    SELECT
        "browser",
        AVG(duration_seconds) AS avg_session_seconds,
        COUNT(*)              AS session_cnt
    FROM session_browser
    GROUP BY "browser"
    HAVING COUNT(*) > 10
)
-- final 3 browsers with the shortest average session duration
SELECT
    "browser",
    ROUND(avg_session_seconds, 2) AS average_session_duration_seconds
FROM browser_stats
ORDER BY avg_session_seconds
LIMIT 3;
