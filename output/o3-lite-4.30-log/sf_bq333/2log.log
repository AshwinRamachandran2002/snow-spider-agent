Relevant tables & columns for the task  

• EVENTS."browser": Browser name; used for grouping, filtering (more than 10 sessions)  
• EVENTS."session_id": Unique session identifier; used to aggregate events into sessions  
• EVENTS."created_at": Event timestamp (µ‑seconds from Unix epoch); used to find earliest vs. latest event per session and to calculate the session’s duration in seconds  
Potential conditions  
• WHERE EVENTS."browser" IS NOT NULL                      – exclude missing browser names  
• HAVING COUNT(DISTINCT "session_id") > 10                – only keep browsers with >10 sessions  
• DATEDIFF('second', MIN("created_at")/1e6, MAX("created_at")/1e6) – session duration in seconds  

────────────────────────────────────────────────────────
Exploratory & progressively‑complex Snowflake SQL queries  
(Each limited to 20 rows to keep result sets small.)

```sql
-- 1. Description: Peek at 20 distinct browser names that exist in EVENTS
SELECT DISTINCT "browser"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
WHERE "browser" IS NOT NULL
LIMIT 20;
```

```sql
-- 2. Description: Count how many raw event rows each browser generated
SELECT "browser",
       COUNT(*)                            AS "event_row_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
WHERE "browser" IS NOT NULL
GROUP BY "browser"
ORDER BY "event_row_cnt" DESC
LIMIT 20;
```

```sql
-- 3. Description: Count how many distinct sessions exist per browser
SELECT "browser",
       COUNT(DISTINCT "session_id")       AS "session_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
WHERE "browser" IS NOT NULL
GROUP BY "browser"
ORDER BY "session_cnt" DESC
LIMIT 20;
```

```sql
-- 4. Description: Inspect a few full sessions (all events) for a single browser
SELECT *
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
WHERE "browser" = (SELECT "browser"
                   FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
                   WHERE "browser" IS NOT NULL
                   LIMIT 1)          -- pick one browser
ORDER BY "session_id", "created_at"
LIMIT 20;
```

```sql
-- 5. Description: Show min & max timestamps plus duration (seconds) for 20 sessions
SELECT "session_id",
       MIN("created_at")                              AS "first_event",
       MAX("created_at")                              AS "last_event",
       (MAX("created_at") - MIN("created_at")) / 1e6  AS "duration_sec"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
WHERE "browser" IS NOT NULL
GROUP BY "session_id"
ORDER BY "duration_sec"
LIMIT 20;
```

```sql
-- 6. Description: Compute average session duration for every browser (all sessions)
WITH session_durations AS (
    SELECT "browser",
           "session_id",
           (MAX("created_at") - MIN("created_at")) / 1e6 AS "duration_sec"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
    WHERE "browser" IS NOT NULL
    GROUP BY "browser", "session_id"
)
SELECT "browser",
       AVG("duration_sec")         AS "avg_session_sec",
       COUNT(*)                    AS "session_cnt"
FROM session_durations
GROUP BY "browser"
ORDER BY "avg_session_sec"
LIMIT 20;
```

```sql
-- 7. Description: Same as #6 but only keep browsers with >10 sessions
WITH session_durations AS (
    SELECT "browser",
           "session_id",
           (MAX("created_at") - MIN("created_at")) / 1e6 AS "duration_sec"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
    WHERE "browser" IS NOT NULL
    GROUP BY "browser", "session_id"
)
SELECT "browser",
       AVG("duration_sec")         AS "avg_session_sec",
       COUNT(*)                    AS "session_cnt"
FROM session_durations
GROUP BY "browser"
HAVING COUNT(*) > 10
ORDER BY "avg_session_sec"
LIMIT 20;
```

```sql
-- 8. Description: Identify the three browsers with the shortest average session duration (>10 sessions)
WITH session_durations AS (
    SELECT "browser",
           "session_id",
           (MAX("created_at") - MIN("created_at")) / 1e6 AS "duration_sec"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
    WHERE "browser" IS NOT NULL
    GROUP BY "browser", "session_id"
),
avg_by_browser AS (
    SELECT "browser",
           AVG("duration_sec") AS "avg_session_sec",
           COUNT(*)           AS "session_cnt"
    FROM session_durations
    GROUP BY "browser"
    HAVING COUNT(*) > 10
)
SELECT "browser",
       "avg_session_sec",
       "session_cnt"
FROM avg_by_browser
ORDER BY "avg_session_sec" ASC
LIMIT 3;
```

```sql
-- 9. Description: Show distribution of session duration (quartiles) for those three browsers
WITH session_durations AS (
    SELECT "browser",
           "session_id",
           (MAX("created_at") - MIN("created_at")) / 1e6 AS "duration_sec"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
    WHERE "browser" IS NOT NULL
    GROUP BY "browser", "session_id"
),
top3 AS (
    SELECT "browser"
    FROM (
        SELECT "browser",
               AVG((MAX("created_at") - MIN("created_at")) / 1e6) AS avg_sec
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
        WHERE "browser" IS NOT NULL
        GROUP BY "browser", "session_id"
        QUALIFY COUNT(*) OVER (PARTITION BY "browser") > 10
    )
    GROUP BY "browser"
    ORDER BY avg_sec
    LIMIT 3
)
SELECT d."browser",
       APPROX_PERCENTILE("duration_sec", 0.25) AS "p25",
       APPROX_PERCENTILE("duration_sec", 0.50) AS "median",
       APPROX_PERCENTILE("duration_sec", 0.75) AS "p75"
FROM session_durations d
JOIN top3 t USING ("browser")
GROUP BY d."browser"
LIMIT 20;
```

```sql
--10. Description: List 20 example sessions (id & duration) for the single quickest browser
WITH session_durations AS (
    SELECT "browser",
           "session_id",
           (MAX("created_at") - MIN("created_at")) / 1e6 AS "duration_sec"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
    WHERE "browser" IS NOT NULL
    GROUP BY "browser", "session_id"
),
quickest AS (
    SELECT "browser"
    FROM session_durations
    GROUP BY "browser"
    HAVING COUNT(*) > 10
    ORDER BY AVG("duration_sec")
    LIMIT 1
)
SELECT d."browser",
       d."session_id",
       d."duration_sec"
FROM session_durations d
JOIN quickest q USING ("browser")
ORDER BY d."duration_sec"
LIMIT 20;
```

