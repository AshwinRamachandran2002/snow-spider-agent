--Description: List 20 sessions (ID & duration, in seconds) for the browser that
--             has the overall shortest average session duration among browsers
--             with more than 10 sessions.
--             Steps:
--             1. Compute duration_sec for every (browser, session_id) pair.
--             2. Determine the single “quickest” browser (shortest avg duration).
--             3. Return 20 of that browser’s sessions ordered by duration.
WITH session_durations AS (          -- Step 1: per‑session durations
    SELECT
        "browser",
        "session_id",
        (MAX("created_at") - MIN("created_at")) / 1e6 AS "duration_sec"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
    WHERE "browser" IS NOT NULL
    GROUP BY "browser", "session_id"
),
quickest_browser AS (                -- Step 2: find the quickest browser
    SELECT
        "browser",
        AVG("duration_sec") AS avg_sec
    FROM session_durations
    GROUP BY "browser"
    HAVING COUNT(*) > 10             -- only browsers with >10 sessions
    ORDER BY avg_sec                 -- shortest average on top
    LIMIT 1
)
SELECT                                -- Step 3: show 20 example sessions
    d."browser",
    d."session_id",
    d."duration_sec"
FROM session_durations d
JOIN quickest_browser q
  ON d."browser" = q."browser"
ORDER BY d."duration_sec"
LIMIT 20;
