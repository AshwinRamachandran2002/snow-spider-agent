Query:
-- 8. Description: Identify the three browsers with the shortest average session duration (>10 sessions)
WITH session_durations AS (
    SELECT "browser",
           "session_id",
           (MAX("created_at") - MIN("created_at")) / 1e6 AS "duration_sec"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
    WHERE "browser" IS NOT NULL
    GROUP BY "browser", "session_id"
),
avg_by_browser AS (
    SELECT "browser",
           AVG("duration_sec") AS "avg_session_sec",
           COUNT(*)           AS "session_cnt"
    FROM session_durations
    GROUP BY "browser"
    HAVING COUNT(*) > 10
)
SELECT "browser",
       "avg_session_sec",
       "session_cnt"
FROM avg_by_browser
ORDER BY "avg_session_sec" ASC
LIMIT 3;
