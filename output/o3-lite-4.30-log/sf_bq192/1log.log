```sql
--Description: 10) Compute a combined “activity_score” (forks*10 + issues*5 + watchers)
--for each qualifying repository in April 2022; return the top 20.
WITH
accepted_repos AS (      -- licence + Python file filter
    SELECT DISTINCT
        l."repo_name"
    FROM GITHUB_REPOS_DATE.GITHUB_REPOS.LICENSES     l
    JOIN GITHUB_REPOS_DATE.GITHUB_REPOS.SAMPLE_FILES f
      ON l."repo_name" = f."repo_name"
    WHERE l."license" IN ('artistic-2.0','isc','mit','apache-2.0')
      AND f."ref"  = 'refs/heads/master'
      AND f."path" ILIKE '%.py'
),
issue_cnt AS (           -- IssuesEvent counts
    SELECT
        "repo":"name"::STRING  AS "repo_name",
        COUNT(*)               AS "issue_event_cnt"
    FROM GITHUB_REPOS_DATE.YEAR._2022
    WHERE "public" = TRUE
      AND "type"   = 'IssuesEvent'
      AND TO_TIMESTAMP("created_at" / 1000000)
            BETWEEN '2022-04-01' AND '2022-05-01'
    GROUP BY
        "repo":"name"::STRING
),
fork_cnt AS (            -- ForkEvent counts
    SELECT
        "repo":"name"::STRING  AS "repo_name",
        COUNT(*)               AS "fork_event_cnt"
    FROM GITHUB_REPOS_DATE.YEAR._2022
    WHERE "public" = TRUE
      AND "type"   = 'ForkEvent'
      AND TO_TIMESTAMP("created_at" / 1000000)
            BETWEEN '2022-04-01' AND '2022-05-01'
    GROUP BY
        "repo":"name"::STRING
)
SELECT
    a."repo_name",
    COALESCE(r."watch_count",0)          AS "watch_cnt",
    COALESCE(i."issue_event_cnt",0)      AS "issue_cnt",
    COALESCE(f."fork_event_cnt",0)       AS "fork_cnt",
    ( COALESCE(f."fork_event_cnt",0)*10
      + COALESCE(i."issue_event_cnt",0)*5
      + COALESCE(r."watch_count",0) )    AS "activity_score"
FROM accepted_repos               a
LEFT JOIN GITHUB_REPOS_DATE.GITHUB_REPOS.SAMPLE_REPOS r
       ON a."repo_name" = r."repo_name"
LEFT JOIN issue_cnt                i
       ON a."repo_name" = i."repo_name"
LEFT JOIN fork_cnt                 f
       ON a."repo_name" = f."repo_name"
ORDER BY
    "activity_score" DESC
LIMIT 20;
```
