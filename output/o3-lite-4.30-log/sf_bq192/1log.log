```sql
--Description: 9) Join watch counts with licence + Python filter to shortlist repos.
SELECT 
    r."repo_name",
    r."watch_count"
FROM GITHUB_REPOS_DATE.GITHUB_REPOS.SAMPLE_REPOS    r
JOIN (
    SELECT DISTINCT l."repo_name"
    FROM GITHUB_REPOS_DATE.GITHUB_REPOS.LICENSES l
    JOIN GITHUB_REPOS_DATE.GITHUB_REPOS.SAMPLE_FILES f
      ON l."repo_name" = f."repo_name"
    WHERE l."license" IN ('artistic-2.0', 'isc', 'mit', 'apache-2.0')
      AND f."ref" = 'refs/heads/master'
      AND f."path" ILIKE '%.py'
) ok
  ON r."repo_name" = ok."repo_name"
ORDER BY r."watch_count" DESC
LIMIT 20;
```

```sql
--Description: 10) Final combined activity metric (watches + issues + forks) for April‑2022.
SELECT 
    base."repo_name",
    COALESCE(r."watch_count",0)                    AS "watch_cnt",
    COALESCE(iss."issue_event_cnt",0)              AS "issue_cnt",
    COALESCE(fk."fork_event_cnt",0)                AS "fork_cnt",
    (COALESCE(fk."fork_event_cnt",0)*10 +
     COALESCE(iss."issue_event_cnt",0)*5 +
     COALESCE(r."watch_count",0) )                 AS "activity_score"
FROM (
    SELECT DISTINCT l."repo_name"
    FROM GITHUB_REPOS_DATE.GITHUB_REPOS.LICENSES l
    JOIN GITHUB_REPOS_DATE.GITHUB_REPOS.SAMPLE_FILES f
      ON l."repo_name" = f."repo_name"
    WHERE l."license" IN ('artistic-2.0', 'isc', 'mit', 'apache-2.0')
      AND f."ref" = 'refs/heads/master'
      AND f."path" ILIKE '%.py'
) base
LEFT JOIN GITHUB_REPOS_DATE.GITHUB_REPOS.SAMPLE_REPOS r
       ON base."repo_name" = r."repo_name"
LEFT JOIN (
    --Issue counts in April 2022
    SELECT 
        "repo":"name"::STRING AS "repo_name",
        COUNT(*)              AS "issue_event_cnt"
    FROM GITHUB_REPOS_DATE.YEAR._2022
    WHERE "public" = TRUE
      AND "type" = 'IssuesEvent'
      AND TO_TIMESTAMP("created_at"/1000000) BETWEEN '2022-04-01' AND '2022-05-01'
    GROUP BY "repo":"name"::STRING
) iss
       ON base."repo_name" = iss."repo_name"
LEFT JOIN (
    --Fork counts in April 2022
    SELECT 
        "repo":"name"::STRING AS "repo_name",
        COUNT(*)              AS "fork_event_cnt"
    FROM GITHUB_REPOS_DATE.YEAR._2022
    WHERE "public" = TRUE
      AND "type" = 'ForkEvent'
      AND TO_TIMESTAMP("created_at"/1000000) BETWEEN '2022-04-01' AND '2022-05-01'
    GROUP BY "repo":"name"::STRING
) fk
       ON base."repo_name" = fk."repo_name"
ORDER BY "activity_score" DESC
LIMIT 20;
```

The last query surfaces the most active Python repositories in April 2022 while honouring the licence filter and combining watcher, issue, and fork signals; the top row returned is the candidate “most active” repository.
