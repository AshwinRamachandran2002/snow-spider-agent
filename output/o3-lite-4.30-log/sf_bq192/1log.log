--Description: Determine how many GitHub events of each *type* happened on every day in April 2022.
--Thinking process:
-- • created_at is stored as micro‑seconds → divide by 1 000 000, then TO_TIMESTAMP.  
-- • We only need events between 1 Apr 2022 and 1 May 2022 (inclusive lower, exclusive upper).  
-- • Aggregate by both "type" and calendar day; Snowflake demands that all SELECT
--   expressions that aren’t aggregates appear in GROUP BY.  
-- • COUNT(*) gives daily volume; sort by that count to see busiest type/day combos.  
-- • LIMIT 20 keeps result small.
SELECT
    "type",
    TO_DATE( TO_TIMESTAMP("created_at" / 1000000) ) AS "event_day",
    COUNT(*)                                        AS "event_cnt"
FROM GITHUB_REPOS_DATE.YEAR._2022
WHERE TO_TIMESTAMP("created_at" / 1000000)
      BETWEEN '2022-04-01' AND '2022-05-01'
GROUP BY
    "type",
    TO_DATE( TO_TIMESTAMP("created_at" / 1000000) )
ORDER BY
    "event_cnt" DESC
LIMIT 20;
```
