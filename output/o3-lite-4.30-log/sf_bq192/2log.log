Query:
--Description: Final metric—combine watchers, issue counts and fork counts for April‑2022 and return the most active Python repo with an approved licence.
WITH valid_licences AS (
    SELECT "repo_name"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LICENSES"
    WHERE  UPPER("license") IN ('ARTISTIC-2.0','ISC','MIT','APACHE-2.0')
),
has_py_files AS (
    SELECT DISTINCT "repo_name"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES"
    WHERE  "ref" = 'refs/heads/master'
      AND  "path" ILIKE '%.py'
),
issues AS (
    SELECT "repo":"name"::STRING AS "repo_name",
           COUNT(DISTINCT "id") AS "issue_cnt"
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022"
    WHERE  "type" = 'IssuesEvent'
      AND  "created_at" BETWEEN 1648771200000000 AND 1651363200000000
    GROUP  BY 1
),
forks AS (
    SELECT "repo":"name"::STRING AS "repo_name",
           COUNT(DISTINCT "id") AS "fork_cnt"
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022"
    WHERE  "type" = 'ForkEvent'
      AND  "created_at" BETWEEN 1648771200000000 AND 1651363200000000
    GROUP  BY 1
)
SELECT
       sr."repo_name",
       COALESCE(fk."fork_cnt",  0) AS "forks",
       COALESCE(isu."issue_cnt",0) AS "issues",
       sr."watch_count"            AS "watches",
       (COALESCE(fk."fork_cnt",0) + COALESCE(isu."issue_cnt",0) + sr."watch_count") AS "activity_score"
FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_REPOS" sr
JOIN   valid_licences vl ON sr."repo_name" = vl."repo_name"
JOIN   has_py_files   hp ON sr."repo_name" = hp."repo_name"
LEFT   JOIN forks     fk ON sr."repo_name" = fk."repo_name"
LEFT   JOIN issues    isu ON sr."repo_name" = isu."repo_name"
ORDER  BY "activity_score" DESC
LIMIT 1
Answer:
repo_name,forks,issues,watches,activity_score
