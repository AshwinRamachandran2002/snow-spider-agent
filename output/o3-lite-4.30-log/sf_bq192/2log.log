Relevant columns and their potential usage  

GITHUB_REPOS_DATE.GITHUB_REPOS.LICENSES  
• "repo_name": repository identifier – join key.  
• "license": filter to open‑source licences of interest (`artistic-2.0`, `isc`, `mit`, `apache-2.0`).  

GITHUB_REPOS_DATE.GITHUB_REPOS.SAMPLE_REPOS  
• "repo_name": join key.  
• "watch_count": indicator of popularity (watchers).  

GITHUB_REPOS_DATE.GITHUB_REPOS.SAMPLE_FILES  
• "repo_name": join key.  
• "ref": branch name – keep only `"refs/heads/master"`.  
• "path": file path – keep only rows that end with `.py` (Python source).  

GITHUB_REPOS_DATE.YEAR."_2022"  
• "repo": VARIANT – contains `"name"` (repository name) used as join key.  
• "type": event type – count `"IssuesEvent"` for issues and `"ForkEvent"` for forks.  
• "created_at": numeric timestamp – restrict to April 2022 ( `1648771200000000` ≤ created_at < `1651363200000000`, assuming micro‑seconds).  

-------------------------------------------------------------------
Example exploration & building‑block queries  
(Each query returns ≤ 20 rows; adjust database / schema / table names exactly as shown.)

```sql
-- 1. Inspect licences that match the required list
SELECT DISTINCT
       "license"
FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LICENSES"
WHERE  "license" ILIKE ANY (ARRAY['artistic-2.0','isc','mit','apache-2.0'])
LIMIT  20;
```

```sql
-- 2. Show repos that use one of those licences
SELECT DISTINCT
       "repo_name",
       "license"
FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LICENSES"
WHERE  "license" IN ('artistic-2.0','isc','mit','apache-2.0')
LIMIT  20;
```

```sql
-- 3. Quick look at watch counts for a few repos
SELECT
       "repo_name",
       "watch_count"
FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_REPOS"
ORDER  BY "watch_count" DESC
LIMIT  20;
```

```sql
-- 4. Get repos that actually contain *.py files on the master branch
SELECT DISTINCT
       "repo_name"
FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE  "ref" = 'refs/heads/master'
  AND  "path" ILIKE '%.py'
LIMIT  20;
```

```sql
-- 5. Peak inside YEAR 2022 table to understand the structure of `repo`
SELECT
       "repo",
       "type",
       "created_at"
FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022"
LIMIT  20;
```

```sql
-- 6. List a few April‑2022 issue events with repo names extracted
SELECT
       "repo":"name"::STRING  AS "repo_name",
       "type",
       "created_at"
FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022"
WHERE  "type" = 'IssuesEvent'
  AND  "created_at" BETWEEN 1648771200000000 AND 1651363200000000   -- 2022‑04‑01 to 2022‑04‑30 μs
LIMIT  20;
```

```sql
-- 7. Count April‑2022 issue events per repo
SELECT
       "repo":"name"::STRING              AS "repo_name",
       COUNT(DISTINCT "id")               AS "issue_events"
FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022"
WHERE  "type" = 'IssuesEvent'
  AND  "created_at" BETWEEN 1648771200000000 AND 1651363200000000
GROUP  BY 1
ORDER  BY 2 DESC
LIMIT  20;
```

```sql
-- 8. Count April‑2022 fork events per repo
SELECT
       "repo":"name"::STRING              AS "repo_name",
       COUNT(DISTINCT "id")               AS "fork_events"
FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022"
WHERE  "type" = 'ForkEvent'
  AND  "created_at" BETWEEN 1648771200000000 AND 1651363200000000
GROUP  BY 1
ORDER  BY 2 DESC
LIMIT  20;
```

```sql
-- 9. Combine issue & fork counts for April‑2022
WITH issues AS (
    SELECT "repo":"name"::STRING AS "repo_name",
           COUNT(DISTINCT "id")  AS "issues_cnt"
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022"
    WHERE  "type" = 'IssuesEvent'
      AND  "created_at" BETWEEN 1648771200000000 AND 1651363200000000
    GROUP  BY 1
),
forks AS (
    SELECT "repo":"name"::STRING AS "repo_name",
           COUNT(DISTINCT "id")  AS "forks_cnt"
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022"
    WHERE  "type" = 'ForkEvent'
      AND  "created_at" BETWEEN 1648771200000000 AND 1651363200000000
    GROUP  BY 1
)
SELECT i."repo_name",
       i."issues_cnt",
       f."forks_cnt"
FROM   issues i
LEFT   JOIN forks f USING ("repo_name")
ORDER  BY (COALESCE(i."issues_cnt",0)+COALESCE(f."forks_cnt",0)) DESC
LIMIT  20;
```

```sql
-- 10. Final query: most active Python repo in April‑2022 (watchers + issues + forks)
WITH valid_licences AS (
    SELECT "repo_name"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LICENSES"
    WHERE  "license" IN ('artistic-2.0','isc','mit','apache-2.0')
),
has_py_files AS (
    SELECT DISTINCT "repo_name"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES"
    WHERE  "ref" = 'refs/heads/master'
      AND  "path" ILIKE '%.py'
),
issues AS (
    SELECT "repo":"name"::STRING  AS "repo_name",
           COUNT(DISTINCT "id")   AS "issue_cnt"
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022"
    WHERE  "type" = 'IssuesEvent'
      AND  "created_at" BETWEEN 1648771200000000 AND 1651363200000000
    GROUP  BY 1
),
forks AS (
    SELECT "repo":"name"::STRING  AS "repo_name",
           COUNT(DISTINCT "id")   AS "fork_cnt"
    FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022"
    WHERE  "type" = 'ForkEvent'
      AND  "created_at" BETWEEN 1648771200000000 AND 1651363200000000
    GROUP  BY 1
)
SELECT
       sr."repo_name",
       COALESCE(fk."fork_cnt",0)     AS "forks",
       COALESCE(isu."issue_cnt",0)   AS "issues",
       sr."watch_count"              AS "watches",
       (COALESCE(fk."fork_cnt",0) + COALESCE(isu."issue_cnt",0) + sr."watch_count") AS "activity_score"
FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_REPOS"  sr
JOIN   valid_licences  vl  ON sr."repo_name" = vl."repo_name"
JOIN   has_py_files    hp  ON sr."repo_name" = hp."repo_name"
LEFT   JOIN forks      fk  ON sr."repo_name" = fk."repo_name"
LEFT   JOIN issues     isu ON sr."repo_name" = isu."repo_name"
ORDER  BY "activity_score" DESC
LIMIT  1;
```

The last query produces the repository name plus its watcher, issue, fork counts, and the combined activity score—revealing the single most active Python project meeting all stated conditions.
