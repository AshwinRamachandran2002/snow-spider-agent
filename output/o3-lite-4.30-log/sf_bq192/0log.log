```sql
--Description: Aggregate watches, issues, and forks per repo for April 2022 (microsecond timestamps, no FLATTEN)
WITH events AS (
    SELECT
        t."repo":"name"::STRING                        AS "repo_name",
        CASE WHEN t."type" = 'WatchEvent'                         THEN 1 ELSE 0 END AS w,
        CASE WHEN t."type" IN ('IssuesEvent','IssueCommentEvent') THEN 1 ELSE 0 END AS i,
        CASE WHEN t."type" = 'ForkEvent'                          THEN 1 ELSE 0 END AS f
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2022" t
    WHERE t."created_at" BETWEEN 1648771200000000 AND 1651363199000000
)
SELECT
       "repo_name",
       SUM(w) AS "watch_events",
       SUM(i) AS "issue_events",
       SUM(f) AS "fork_events"
FROM   events
GROUP  BY 1
ORDER  BY "fork_events" DESC, "issue_events" DESC, "watch_events" DESC
LIMIT 20;
```

```sql
--Description: Join April 2022 activity (microseconds) with repositories that hold an approved license
WITH activity AS (
    SELECT
        t."repo":"name"::STRING                               AS "repo_name",
        SUM(CASE WHEN t."type" = 'WatchEvent'  THEN 1 ELSE 0 END)                        AS w,
        SUM(CASE WHEN t."type" IN ('IssuesEvent','IssueCommentEvent') THEN 1 ELSE 0 END) AS i,
        SUM(CASE WHEN t."type" = 'ForkEvent'   THEN 1 ELSE 0 END)                        AS f
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2022" t
    WHERE t."created_at" BETWEEN 1648771200000000 AND 1651363199000000
    GROUP BY t."repo":"name"::STRING
), good_license AS (
    SELECT "repo_name"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LICENSES"
    WHERE  "license" IN ('artistic-2.0','isc','mit','apache-2.0')
)
SELECT
       a."repo_name",
       a.w AS "watch_events",
       a.i AS "issue_events",
       a.f AS "fork_events",
       (a.w + a.i + a.f) AS "total_score"
FROM   activity a
JOIN   good_license g
       ON a."repo_name" = g."repo_name"
ORDER  BY "total_score" DESC
LIMIT 20;
```

```sql
--Description: Final selection – most active Python repos in April 2022 with approved licenses
WITH py_repos AS (
    SELECT DISTINCT "repo_name"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES"
    WHERE  "ref" = 'refs/heads/master'
      AND  "path" ILIKE '%.py'
), good_license AS (
    SELECT "repo_name"
    FROM   "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LICENSES"
    WHERE  "license" IN ('artistic-2.0','isc','mit','apache-2.0')
), activity AS (
    SELECT
        t."repo":"name"::STRING                                AS "repo_name",
        SUM(CASE WHEN t."type" = 'ForkEvent'  THEN 1 ELSE 0 END)                         AS "forks",
        SUM(CASE WHEN t."type" IN ('IssuesEvent','IssueCommentEvent') THEN 1 ELSE 0 END) AS "issues",
        SUM(CASE WHEN t."type" = 'WatchEvent' THEN 1 ELSE 0 END)                         AS "watches"
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2022" t
    WHERE t."created_at" BETWEEN 1648771200000000 AND 1651363199000000
    GROUP BY t."repo":"name"::STRING
)
SELECT
       a."repo_name",
       a."forks",
       a."issues",
       a."watches",
       (a."forks" + a."issues" + a."watches") AS "total_activity"
FROM   activity     a
JOIN   good_license l  ON a."repo_name" = l."repo_name"
JOIN   py_repos    p  ON a."repo_name" = p."repo_name"
ORDER  BY "total_activity" DESC
LIMIT 20;
```
