Begin Exploring Related Columns
Relevant columns and their potential usage  

• GITHUB_REPOS_DATE.GITHUB_REPOS.LICENSES  
  – "repo_name" : repository identifier for later JOINs.  
  – "license"   : filter to Artistic‑2.0, ISC, MIT, Apache‑2.0.  

• GITHUB_REPOS_DATE.GITHUB_REPOS.SAMPLE_FILES  
  – "repo_name" : repository identifier.  
  – "path"      : check that at least one file ends with “.py”.  
  – "ref"       : keep only "refs/heads/master".  

• GITHUB_REPOS_DATE.YEAR._2022  
  – "type"      : event kind (IssuesEvent, WatchEvent, ForkEvent…).  
  – "created_at": event time‑stamp; restrict to April 2022.  
  – "repo"      : VARIANT; flatten to get repo name for aggregation.  

• (optionally) GITHUB_REPOS_DATE.GITHUB_REPOS.SAMPLE_REPOS  
  – "repo_name" : identifier.  
  – "watch_count": static GitHub watch counter; may complement WatchEvent counts.  

--------------------------------------------------------------------
Ten exploratory → analytical SQLs (each returns ≤ 20 rows)  
--------------------------------------------------------------------

```sql
-- 1. Description: Show distinct licenses that appear in the LICENSES table
SELECT DISTINCT "license"
FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LICENSES"
LIMIT 20;
```

```sql
-- 2. Description: Preview Python files that live on the master branch
SELECT DISTINCT "repo_name", "path"
FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES"
WHERE "ref" = 'refs/heads/master'
  AND "path" ILIKE '%.py'
LIMIT 20;
```

```sql
-- 3. Description: Inspect the structure of the “repo” VARIANT column in the 2022 events table
SELECT f.value
FROM "GITHUB_REPOS_DATE"."YEAR"."_2022" t,
     LATERAL FLATTEN(input => t."repo") f
LIMIT 20;
```

```sql
-- 4. Description: Extract repository names from the 2022 events table (any month)  
SELECT DISTINCT
       f.value:"name"::STRING AS "repo_name"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2022" t,
     LATERAL FLATTEN(input => t."repo") f
LIMIT 20;
```

```sql
-- 5. Description: Count WatchEvent occurrences per repo during April 2022  
SELECT
    f.value:"name"::STRING AS "repo_name",
    COUNT(*)                 AS "watch_events"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2022" t,
     LATERAL FLATTEN(input => t."repo") f
WHERE t."type" = 'WatchEvent'
  AND t."created_at" BETWEEN 1648771200 AND 1651363199   -- 2022‑04‑01 … 2022‑04‑30 (epoch secs)
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 6. Description: Count Issues‑related events per repo in April 2022  
SELECT
    f.value:"name"::STRING AS "repo_name",
    COUNT(*)               AS "issue_events"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2022" t,
     LATERAL FLATTEN(input => t."repo") f
WHERE t."type" IN ('IssuesEvent', 'IssueCommentEvent')
  AND t."created_at" BETWEEN 1648771200 AND 1651363199
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 7. Description: Count ForkEvent occurrences per repo in April 2022  
SELECT
    f.value:"name"::STRING AS "repo_name",
    COUNT(*)               AS "fork_events"
FROM "GITHUB_REPOS_DATE"."YEAR"."_2022" t,
     LATERAL FLATTEN(input => t."repo") f
WHERE t."type" = 'ForkEvent'
  AND t."created_at" BETWEEN 1648771200 AND 1651363199
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 8. Description: Aggregate watches, issues, and forks for April 2022 into a single table  
WITH events AS (
    SELECT
        f.value:"name"::STRING          AS "repo_name",
        CASE WHEN t."type" = 'WatchEvent' THEN 1 ELSE 0 END AS w,
        CASE WHEN t."type" IN ('IssuesEvent','IssueCommentEvent') THEN 1 ELSE 0 END AS i,
        CASE WHEN t."type" = 'ForkEvent'  THEN 1 ELSE 0 END AS f
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2022" t,
         LATERAL FLATTEN(input => t."repo") f
    WHERE t."created_at" BETWEEN 1648771200 AND 1651363199
)
SELECT
    "repo_name",
    SUM(w) AS "watch_events",
    SUM(i) AS "issue_events",
    SUM(f) AS "fork_events"
FROM events
GROUP BY 1
ORDER BY "fork_events" DESC, "issue_events" DESC, "watch_events" DESC
LIMIT 20;
```

```sql
-- 9. Description: Join aggregated April‑2022 activity with allowed licenses  
WITH activity AS (
    SELECT
        "repo_name",
        SUM(CASE WHEN "type"='WatchEvent' THEN 1 END) AS w,
        SUM(CASE WHEN "type" IN ('IssuesEvent','IssueCommentEvent') THEN 1 END) AS i,
        SUM(CASE WHEN "type"='ForkEvent' THEN 1 END) AS f
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2022" t,
         LATERAL FLATTEN(input => t."repo") f
    WHERE t."created_at" BETWEEN 1648771200 AND 1651363199
    GROUP BY "repo_name"
), good_license AS (
    SELECT "repo_name"
    FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LICENSES"
    WHERE "license" IN ('artistic-2.0','isc','mit','apache-2.0')
)
SELECT a.*, (f + i + w) AS total_score
FROM activity a
JOIN good_license g USING ("repo_name")
ORDER BY total_score DESC
LIMIT 20;
```

```sql
-- 10. Description: Final selection – repositories that (a) have .py files on master, 
-- (b) carry an approved license, and (c) rank highest by combined April‑2022 activity
WITH py_repos AS (
    SELECT DISTINCT "repo_name"
    FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."SAMPLE_FILES"
    WHERE "ref" = 'refs/heads/master'
      AND "path" ILIKE '%.py'
), good_license AS (
    SELECT "repo_name"
    FROM "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LICENSES"
    WHERE "license" IN ('artistic-2.0','isc','mit','apache-2.0')
), activity AS (
    SELECT
        f.value:"name"::STRING                         AS "repo_name",
        SUM(CASE WHEN t."type"='ForkEvent'  THEN 1 END) AS "forks",
        SUM(CASE WHEN t."type" IN ('IssuesEvent','IssueCommentEvent') THEN 1 END) AS "issues",
        SUM(CASE WHEN t."type"='WatchEvent' THEN 1 END) AS "watches"
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2022" t,
         LATERAL FLATTEN(input => t."repo") f
    WHERE t."created_at" BETWEEN 1648771200 AND 1651363199
    GROUP BY "repo_name"
)
SELECT
    a."repo_name",
    a."forks",
    a."issues",
    a."watches",
    (a."forks" + a."issues" + a."watches") AS "total_activity"
FROM activity a
JOIN good_license l   ON a."repo_name" = l."repo_name"
JOIN py_repos  p      ON a."repo_name" = p."repo_name"
ORDER BY "total_activity" DESC
LIMIT 20;
```

