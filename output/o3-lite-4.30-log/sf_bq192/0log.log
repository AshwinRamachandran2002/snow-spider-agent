```sql
--Description: Count ForkEvent occurrences per repo in April 2022 (microsecond timestamps, direct repo name extraction)
SELECT
       t."repo":"name"::STRING AS "repo_name",
       COUNT(*)                AS "fork_events"
FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022" t
WHERE  t."type" = 'ForkEvent'
  AND  t."created_at" BETWEEN 1648771200000000 AND 1651363199000000   -- 2022‑04‑01…30 (µs)
