Begin Exploring Related Columns
Relevant columns and their potential usage  
• customer_transactions.customer_id: uniquely identifies each customer for grouping, cumulative balance and final growth‑rate calculation  
• customer_transactions.txn_date: used to bucket every transaction into its month; we will convert it to the first day of the month (e.g. date(txn_date,'start of month'))  
• customer_transactions.txn_type: tells whether the row is a ‘deposit’ (positive) or a ‘withdrawal’ (negative) – needed to build the monthly net amount  
• customer_transactions.txn_amount: the numerical value we will add (or subtract) when building the monthly net  
Conditions that will frequently be used  
• WHERE "txn_type" IN ('deposit','withdrawal') – ignore any other txn types if they exist  
• Converting each txn_date to the first‑of‑month anchor, e.g. date("txn_date",'start of month') AS "month_start"  

Below are ten exploratory → progressively‑complex SQL queries (LIMIT 20) that surface the data we need and finally answer the request.

```sql
-- 1. Description: Peek at a few distinct customer ids
SELECT DISTINCT "customer_id"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 2. Description: Discover the different transaction types recorded
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 3. Description: View a sample of raw transactions for one customer
SELECT *
FROM "customer_transactions"
WHERE "customer_id" = (
      SELECT "customer_id" FROM "customer_transactions" LIMIT 1
)
LIMIT 20;
```

```sql
-- 4. Description: List the first day of the month each transaction falls into
SELECT
       "customer_id",
       date("txn_date",'start of month') AS "month_start",
       "txn_type",
       "txn_amount"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 5. Description: Create the monthly net amount (deposit=+, withdrawal=-) for every customer‑month
SELECT
       "customer_id",
       date("txn_date",'start of month') AS "month_start",
       SUM(CASE WHEN "txn_type"='deposit'
                THEN  "txn_amount"
                ELSE - "txn_amount"
           END) AS "monthly_net"
FROM   "customer_transactions"
WHERE  "txn_type" IN ('deposit','withdrawal')
GROUP  BY "customer_id", date("txn_date",'start of month')
LIMIT 20;
```

```sql
-- 6. Description: Produce each customer’s running (cumulative) closing balance by month
SELECT
       "customer_id",
       "month_start",
       SUM("monthly_net") OVER (
             PARTITION BY "customer_id"
             ORDER BY "month_start"
       ) AS "closing_balance"
FROM (
       SELECT
              "customer_id",
              date("txn_date",'start of month') AS "month_start",
              SUM(CASE WHEN "txn_type"='deposit'
                       THEN  "txn_amount"
                       ELSE - "txn_amount"
                  END) AS "monthly_net"
       FROM   "customer_transactions"
       WHERE  "txn_type" IN ('deposit','withdrawal')
       GROUP  BY "customer_id", date("txn_date",'start of month')
) AS m
LIMIT 20;
```

```sql
-- 7. Description: Retrieve the latest two months per customer along with their balances
WITH balances AS (
     SELECT
            "customer_id",
            "month_start",
            SUM("monthly_net") OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "month_start"
            ) AS "closing_balance",
            ROW_NUMBER() OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "month_start" DESC
            ) AS rn
     FROM (
            SELECT
                   "customer_id",
                   date("txn_date",'start of month') AS "month_start",
                   SUM(CASE WHEN "txn_type"='deposit'
                            THEN  "txn_amount"
                            ELSE - "txn_amount"
                       END) AS "monthly_net"
            FROM   "customer_transactions"
            WHERE  "txn_type" IN ('deposit','withdrawal')
            GROUP  BY "customer_id", date("txn_date",'start of month')
     )
)
SELECT *
FROM balances
WHERE rn <= 2
LIMIT 20;
```

```sql
-- 8. Description: Calculate each customer’s most recent monthly growth rate
WITH balances AS (
     SELECT
            "customer_id",
            "month_start",
            SUM("monthly_net") OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "month_start"
            ) AS "closing_balance",
            ROW_NUMBER() OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "month_start" DESC
            ) AS rn
     FROM (
            SELECT
                   "customer_id",
                   date("txn_date",'start of month') AS "month_start",
                   SUM(CASE WHEN "txn_type"='deposit'
                            THEN  "txn_amount"
                            ELSE - "txn_amount"
                       END) AS "monthly_net"
            FROM   "customer_transactions"
            WHERE  "txn_type" IN ('deposit','withdrawal')
            GROUP  BY "customer_id", date("txn_date",'start of month')
     )
),
pivot AS (
     SELECT
            "customer_id",
            MAX(CASE WHEN rn = 1 THEN "closing_balance" END) AS current_bal,
            MAX(CASE WHEN rn = 2 THEN "closing_balance" END) AS prev_bal
     FROM balances
     GROUP BY "customer_id"
)
SELECT
       "customer_id",
       current_bal,
       prev_bal,
       CASE
            WHEN IFNULL(prev_bal,0)=0
            THEN current_bal * 100.0
            ELSE (current_bal - prev_bal) * 100.0 / ABS(prev_bal)
       END AS growth_rate_pct
FROM   pivot
LIMIT 20;
```

```sql
-- 9. Description: Flag customers whose most‑recent growth rate exceeds 5%
WITH balances AS (
     SELECT
            "customer_id",
            "month_start",
            SUM("monthly_net") OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "month_start"
            ) AS "closing_balance",
            ROW_NUMBER() OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "month_start" DESC
            ) AS rn
     FROM (
            SELECT
                   "customer_id",
                   date("txn_date",'start of month') AS "month_start",
                   SUM(CASE WHEN "txn_type"='deposit'
                            THEN  "txn_amount"
                            ELSE - "txn_amount"
                       END) AS "monthly_net"
            FROM   "customer_transactions"
            WHERE  "txn_type" IN ('deposit','withdrawal')
            GROUP  BY "customer_id", date("txn_date",'start of month')
     )
),
pivot AS (
     SELECT
            "customer_id",
            MAX(CASE WHEN rn = 1 THEN "closing_balance" END) AS current_bal,
            MAX(CASE WHEN rn = 2 THEN "closing_balance" END) AS prev_bal
     FROM balances
     GROUP BY "customer_id"
),
growth AS (
     SELECT
            "customer_id",
            CASE
                 WHEN IFNULL(prev_bal,0)=0
                 THEN current_bal * 100.0
                 ELSE (current_bal - prev_bal) * 100.0 / ABS(prev_bal)
            END AS growth_rate_pct
     FROM pivot
)
SELECT *
FROM growth
WHERE growth_rate_pct > 5
LIMIT 20;
```

```sql
-- 10. Description: Compute the percentage of all customers whose latest‑month growth rate > 5%
WITH balances AS (
     SELECT
            "customer_id",
            "month_start",
            SUM("monthly_net") OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "month_start"
            ) AS "closing_balance",
            ROW_NUMBER() OVER (
                  PARTITION BY "customer_id"
                  ORDER BY "month_start" DESC
            ) AS rn
     FROM (
            SELECT
