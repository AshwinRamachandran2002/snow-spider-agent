2025-05-01 03:19:35 - Thread-1331 (execute) - INFO - [Exploration]
Relevant columns and their potential usage  
• customer_transactions.customer_id: identify each customer  
• customer_transactions.txn_date: determine the month of every transaction (we will normalise to the first day of that month)  
• customer_transactions.txn_type: distinguish “deposit” (positive) from “withdrawal” (negative) transactions  
• customer_transactions.txn_amount: value to sum (signed + / –) when building monthly net amounts  

Typical conditions that will be useful  
• WHERE "txn_type" = 'deposit' or 'withdrawal'  
• Converting the original "txn_date" (`YYYY‑MM‑DD`) into the first day of that month with substr() ➜ substr(txn_date,1,7)||'-01'  

Below are ten exploratory SQL queries (all SELECT‑only, each different, capped at 20 rows) that walk from basic inspection through to building the information needed for the requested analysis.

```sql
-- 1. Distinct transaction types to confirm the value labels we must handle
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 2. Sample of customer IDs that exist in the data
SELECT DISTINCT "customer_id"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 3. Distinct year‑month strings found in the data (helps confirm date format)
SELECT DISTINCT substr("txn_date",1,7) AS "year_month"
FROM "customer_transactions"
ORDER BY "year_month" ASC
LIMIT 20;
```

```sql
-- 4. Preview raw transactions (customer, date, type, amount)
SELECT "customer_id",
       "txn_date",
       "txn_type",
       "txn_amount"
FROM "customer_transactions"
ORDER BY "txn_date" ASC
LIMIT 20;
```

```sql
-- 5. Create the “month_start” column (first day of month) for a few rows
SELECT "customer_id",
       substr("txn_date",1,7)||'-01' AS "month_start",
       "txn_type",
       "txn_amount"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 6. Monthly net amount for one sample customer (sign flip for withdrawals)
SELECT substr("txn_date",1,7)||'-01' AS "month_start",
       SUM(CASE
               WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
               WHEN "txn_type" = 'withdrawal' THEN -("txn_amount")
           END) AS "net_amount"
FROM "customer_transactions"
WHERE "customer_id" = (SELECT DISTINCT "customer_id" FROM "customer_transactions" LIMIT 1)
GROUP BY "month_start"
ORDER BY "month_start"
LIMIT 20;
```

```sql
-- 7. Running closing balance per month for the same sample customer
SELECT "month_start",
       SUM("net_amount") OVER (ORDER BY "month_start") AS "closing_balance"
FROM (
      SELECT substr("txn_date",1,7)||'-01' AS "month_start",
             SUM(CASE
                     WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                     WHEN "txn_type" = 'withdrawal' THEN -("txn_amount")
                 END) AS "net_amount"
      FROM "customer_transactions"
      WHERE "customer_id" = (SELECT DISTINCT "customer_id" FROM "customer_transactions" LIMIT 1)
      GROUP BY "month_start"
) AS m
ORDER BY "month_start"
LIMIT 20;
```

```sql
-- 8. For every customer, find their most‑recent month and the immediately prior month’s closing balances
WITH monthly_nets AS (
    SELECT "customer_id",
           substr("txn_date",1,7)||'-01' AS "month_start",
           SUM(CASE
                   WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                   WHEN "txn_type" = 'withdrawal' THEN -("txn_amount")
               END) AS "net_amount"
    FROM "customer_transactions"
    GROUP BY "customer_id", "month_start"
),
running_balance AS (
    SELECT "customer_id",
           "month_start",
           SUM("net_amount") OVER (PARTITION BY "customer_id"
                                   ORDER BY "month_start") AS "closing_balance"
    FROM monthly_nets
),
ranked_months AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "customer_id" ORDER BY "month_start" DESC) AS rn
    FROM running_balance
)
SELECT *
FROM ranked_months
WHERE rn <= 2
ORDER BY "customer_id", "month_start" DESC
LIMIT 20;
```

```sql
-- 9. Compute most‑recent month’s growth rate for each customer
WITH monthly_nets AS (
    SELECT "customer_id",
           substr("txn_date",1,7)||'-01' AS "month_start",
           SUM(CASE
                   WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                   WHEN "txn_type" = 'withdrawal' THEN -("txn_amount")
               END) AS "net_amount"
    FROM "customer_transactions"
    GROUP BY "customer_id", "month_start"
),
running_balance AS (
    SELECT "customer_id",
           "month_start",
           SUM("net_amount") OVER (PARTITION BY "customer_id"
                                   ORDER BY "month_start") AS "closing_balance"
    FROM monthly_nets
),
ranked_months AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "customer_id" ORDER BY "month_start" DESC) AS rn
    FROM running_balance
),
most_recent AS (
    SELECT * FROM ranked_months WHERE rn = 1
),
prior_month AS (
    SELECT * FROM ranked_months WHERE rn = 2
)
SELECT mr."customer_id",
       mr."closing_balance"   AS "latest_closing",
       pm."closing_balance"   AS "prev_closing",
       CASE
           WHEN pm."closing_balance" = 0 OR pm."closing_balance" IS NULL
                THEN mr."closing_balance"*100.0
           ELSE (mr."closing_balance" - pm."closing_balance")*100.0 / ABS(pm."closing_balance")
       END AS "growth_rate_%"
FROM most_recent mr
LEFT JOIN prior_month pm
      ON mr."customer_id" = pm."customer_id"
LIMIT 20;
```

```sql
-- 10. Percentage of customers whose most recent month shows growth > 5%
WITH monthly_nets AS (
    SELECT "customer_id",
           substr("txn_date",1,7)||'-01' AS "month_start",
           SUM(CASE
                   WHEN "txn_type" = 'deposit'    THEN  "txn_amount"
                   WHEN "txn_type" = 'withdrawal' THEN -("txn_amount")
               END) AS "net_amount"
    FROM "customer_transactions"
    GROUP BY "customer_id", "month_start"
),
running_balance AS (
    SELECT "customer_id",
           "month_start",
           SUM("net_amount") OVER (PARTITION BY "customer_id"
                                   ORDER BY "month_start") AS "closing_balance"
    FROM monthly_nets
),
ranked_months AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "customer_id" ORDER BY "month_start" DESC) AS rn
    FROM running_balance
),
most_recent AS (
    SELECT * FROM ranked_months WHERE rn = 1
),
prior_month AS (
    SELECT * FROM ranked_months WHERE rn = 2
),
growth_calc AS (
    SELECT mr."customer_id",
           CASE
               WHEN pm."closing_balance" = 0 OR pm."closing_balance" IS NULL
                    THEN mr."closing_balance"*100.0
               ELSE (mr."closing_balance" - pm."closing_balance")*100.0 / ABS(pm."closing_balance")
           END AS "growth_rate_%"
    FROM most_recent mr
    LEFT JOIN prior_month pm
          ON mr."customer_id" = pm."customer_id"
)
SELECT ROUND(100.0 * SUM(CASE WHEN "growth_rate_%"> 5 THEN 1 ELSE 0 END)
                 / COUNT(*), 2) AS "pct_customers_growth_gt_5"
FROM growth_calc
LIMIT 20;
```
