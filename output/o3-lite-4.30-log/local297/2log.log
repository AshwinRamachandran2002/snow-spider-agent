Relevant columns and their possible usage
customer_transactions.customer_id: unique identifier to group each customer’s activity  
customer_transactions.txn_date: transaction date – used to derive the first day of each month (yyyy‑mm‑01)  
customer_transactions.txn_type: shows whether the record is a deposit (positive) or withdrawal (negative)  
customer_transactions.txn_amount: amount to be summed (+ for deposits, – for withdrawals)  

Typical filter / join conditions  
• txn_type IN ('deposit','withdrawal') – only money movements are needed  
• GROUP BY customer_id, month_start – to obtain the monthly net position  

Below are ten exploratory → progressively‑complex SQL queries (SQLite syntax, all capped at 20 rows) that walk from basic inspection to the final result that answers the task.  

```sql
-- 1.  Check every type of money‑movement that exists
SELECT DISTINCT "txn_type"
FROM "customer_transactions"
LIMIT 20;
```

```sql
-- 2.  See which calendar years appear in the data set
SELECT DISTINCT substr("txn_date",1,4) AS "calendar_year"
FROM "customer_transactions"
ORDER BY "calendar_year"
LIMIT 20;
```

```sql
-- 3.  Peek at a few transactions for three random customers
SELECT "customer_id",
       "txn_date",
       "txn_type",
       "txn_amount"
FROM   "customer_transactions"
WHERE  "customer_id" IN (SELECT DISTINCT "customer_id"
                         FROM "customer_transactions"
                         LIMIT 3)
ORDER BY "customer_id","txn_date"
LIMIT 20;
```

```sql
-- 4.  Derive the first day of the month for every transaction
SELECT "customer_id",
       "txn_date",
       substr("txn_date",1,7) || '-01' AS "month_start"
FROM   "customer_transactions"
LIMIT 20;
```

```sql
-- 5.  Monthly net amount (deposit = +, withdrawal = –)
SELECT "customer_id",
       substr("txn_date",1,7) || '-01' AS "month_start",
       SUM(CASE WHEN "txn_type"='deposit'
                THEN  "txn_amount"
                ELSE - "txn_amount" END) AS "net_amount"
FROM   "customer_transactions"
GROUP  BY "customer_id", "month_start"
ORDER  BY "customer_id", "month_start"
LIMIT 20;
```

```sql
-- 6.  Add each customer’s running closing balance
WITH monthly_net AS (
  SELECT "customer_id",
         substr("txn_date",1,7) || '-01' AS "month_start",
         SUM(CASE WHEN "txn_type"='deposit'
                  THEN  "txn_amount"
                  ELSE - "txn_amount" END) AS "net_amount"
  FROM   "customer_transactions"
  GROUP  BY "customer_id", "month_start"
)
SELECT "customer_id",
       "month_start",
       "net_amount",
       SUM("net_amount") OVER (
            PARTITION BY "customer_id"
            ORDER BY      "month_start"
       ) AS "closing_balance"
FROM   monthly_net
ORDER  BY "customer_id", "month_start"
LIMIT 20;
```

```sql
-- 7.  Compute growth rate month‑on‑month for every customer
WITH monthly_net AS (
  SELECT "customer_id",
         substr("txn_date",1,7) || '-01' AS "month_start",
         SUM(CASE WHEN "txn_type"='deposit'
                  THEN  "txn_amount"
                  ELSE - "txn_amount" END) AS "net_amount"
  FROM   "customer_transactions"
  GROUP  BY "customer_id", "month_start"
),
running_bal AS (
  SELECT "customer_id",
         "month_start",
         SUM("net_amount") OVER (
              PARTITION BY "customer_id"
              ORDER BY      "month_start"
         ) AS "closing_balance"
  FROM   monthly_net
),
growth AS (
  SELECT "customer_id",
         "month_start",
         "closing_balance",
         LAG("closing_balance") OVER (
              PARTITION BY "customer_id"
              ORDER BY      "month_start"
         ) AS "prev_balance"
  FROM   running_bal
)
SELECT "customer_id",
       "month_start",
       "closing_balance",
       "prev_balance",
       100.0 * 
       CASE 
            WHEN "prev_balance" = 0 OR "prev_balance" IS NULL
                 THEN "closing_balance"
            ELSE ("closing_balance" - "prev_balance") / "prev_balance"
       END AS "growth_rate_pct"
FROM   growth
ORDER  BY "customer_id", "month_start"
LIMIT 20;
```

```sql
-- 8.  Identify each customer’s most‑recent month & its growth rate
WITH monthly_net AS (
  SELECT "customer_id",
         substr("txn_date",1,7) || '-01' AS "month_start",
         SUM(CASE WHEN "txn_type"='deposit'
                  THEN  "txn_amount"
                  ELSE - "txn_amount" END) AS "net_amount"
  FROM   "customer_transactions"
  GROUP  BY "customer_id", "month_start"
),
running_bal AS (
  SELECT "customer_id",
         "month_start",
         SUM("net_amount") OVER (
              PARTITION BY "customer_id"
              ORDER BY      "month_start"
         ) AS "closing_balance"
  FROM   monthly_net
),
growth AS (
  SELECT "customer_id",
         "month_start",
         "closing_balance",
         LAG("closing_balance") OVER (
              PARTITION BY "customer_id"
              ORDER BY      "month_start"
         ) AS "prev_balance"
  FROM   running_bal
),
growth_rate AS (
  SELECT "customer_id",
         "month_start",
         100.0 * 
         CASE 
              WHEN "prev_balance" = 0 OR "prev_balance" IS NULL
                   THEN "closing_balance"
              ELSE ("closing_balance" - "prev_balance") / "prev_balance"
         END AS "growth_rate_pct",
         ROW_NUMBER() OVER (
              PARTITION BY "customer_id"
              ORDER BY      "month_start" DESC
         ) AS "rn"
  FROM   growth
)
SELECT "customer_id",
       "month_start"      AS "most_recent_month",
       "growth_rate_pct"
FROM   growth_rate
WHERE  "rn" = 1
LIMIT 20;
```

```sql
-- 9.  Count customers whose latest month grew by more than 5 %
WITH monthly_net AS (
  SELECT "customer_id",
         substr("txn_date",1,7) || '-01' AS "month_start",
         SUM(CASE WHEN "txn_type"='deposit'
                  THEN  "txn_amount"
                  ELSE - "txn_amount" END) AS "net_amount"
  FROM   "customer_transactions"
  GROUP  BY "customer_id", "month_start"
),
running_bal AS (
  SELECT "customer_id",
         "month_start",
         SUM("net_amount") OVER (
              PARTITION BY "customer_id"
              ORDER BY      "month_start"
         ) AS "closing_balance"
  FROM   monthly_net
),
growth AS (
  SELECT "customer_id",
         "month_start",
         "closing_balance",
         LAG("closing_balance") OVER (
              PARTITION BY "customer_id"
              ORDER BY      "month_start"
         ) AS "prev_balance"
  FROM   running_bal
),
growth_rate AS (
  SELECT "customer_id",
         "month_start",
         100.0 * 
         CASE 
              WHEN "prev_balance" = 0 OR "prev_balance" IS NULL
                   THEN "closing_balance"
              ELSE ("closing_balance" - "prev_balance") / "prev_balance"
         END AS "growth_rate_pct",
         ROW_NUMBER() OVER (
              PARTITION BY "customer_id"
              ORDER BY      "month_start" DESC
         ) AS "rn"
  FROM   growth
)
SELECT COUNT(*) AS "customers_over_5pct_growth"
FROM   growth_rate
WHERE  "rn" = 1
  AND   "growth_rate_pct" > 5;
```

```sql
--10.  Final percentage of customers whose latest month’s growth > 5 %
WITH monthly_net AS (
  SELECT "customer_id",
         substr("txn_date",1,7) || '-01' AS "month_start",
         SUM(CASE WHEN "txn_type"='deposit'
                  THEN  "txn_amount"
                  ELSE - "txn_amount" END) AS "net_amount"
  FROM   "customer_transactions"
  GROUP  BY "customer_id", "month_start"
),
running_bal AS (
  SELECT "customer_id",
         "month_start",
         SUM("net_amount") OVER (
              PARTITION BY "customer_id"
              ORDER BY      "month_start"
         ) AS "closing_balance"
  FROM   monthly_net
),
growth AS (
  SELECT "customer_id",
         "month_start",
         "closing_balance",
         LAG("closing_balance") OVER (
              PARTITION BY "customer_id"
              ORDER BY      "month_start"
         ) AS "prev_balance"
  FROM   running_bal
),
growth_rate AS (
  SELECT "customer_id",
         "month_start",
         100.0 *
         CASE 
              WHEN "prev_balance" = 0 OR "prev_balance" IS NULL
                   THEN "closing_balance"
              ELSE ("closing_balance" - "prev_balance") / "prev_balance"
         END AS "growth_rate_pct",
         ROW_NUMBER() OVER (
              PARTITION BY "customer_id"
              ORDER BY      "month_start" DESC
         ) AS "rn"
  FROM   growth
),
flags AS (
  SELECT "customer_id",
         CASE WHEN "growth_rate_pct" > 5 THEN 1 ELSE 0 END AS "gt5"
  FROM   growth_rate
  WHERE  "rn" = 1
)
SELECT ROUND(100.0 * SUM("gt5") / COUNT(*), 2) AS "pct_of_customers_gt5_growth"
FROM   flags
LIMIT 20;
```

Each query builds on the last, culminating in a single statement that returns the requested percentage of customers whose most‑recent month exhibits a growth rate exceeding 5 %.
