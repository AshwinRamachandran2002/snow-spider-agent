```sql
--Description: Spatial lookup for trip destination coordinates – convert each ZIP polygon to GEOGRAPHY so it can be compared with the destination point.
SELECT
    t."end_station_latitude",
    t."end_station_longitude",
    g."zip_code"
FROM NEW_YORK_CITIBIKE_1.NEW_YORK_CITIBIKE.CITIBIKE_TRIPS AS t
JOIN NEW_YORK_CITIBIKE_1.GEO_US_BOUNDARIES.ZIP_CODES     AS g
  ON ST_WITHIN(
       ST_MAKEPOINT(t."end_station_longitude", t."end_station_latitude"),
       TO_GEOGRAPHY(g."zip_code_geom"))
WHERE g."state_code" = 'NY'
LIMIT 20;
```

```sql
--Description: Daily weather summary for Central Park in 2014 (WBAN 94728) – unchanged because no spatial comparison is involved.
SELECT
  "year",
  "mo",
  "da",
  ROUND(AVG("temp"), 1)        AS "avg_temp_f",
  ROUND(AVG("wdsp"::FLOAT), 1) AS "avg_wind_knots",
  ROUND(AVG("prcp"), 2)        AS "avg_prcp_in"
FROM NEW_YORK_CITIBIKE_1.NOAA_GSOD.GSOD2014
WHERE "wban" = '94728'
GROUP BY "year", "mo", "da"
ORDER BY "year", "mo", "da"
LIMIT 20;
```

```sql
--Description: Prototype full join counting 2014 trips between origin & destination neighborhoods – CAST both origin and destination ZIP polygons to GEOGRAPHY for valid spatial comparisons.
SELECT
  src_nbhd."neighborhood" AS "start_neighborhood",
  dst_nbhd."neighborhood" AS "end_neighborhood",
  COUNT(*)                AS "trip_cnt"
FROM NEW_YORK_CITIBIKE_1.NEW_YORK_CITIBIKE.CITIBIKE_TRIPS AS t
/* origin ZIP */
JOIN NEW_YORK_CITIBIKE_1.GEO_US_BOUNDARIES.ZIP_CODES AS g_src
  ON ST_WITHIN(
       ST_MAKEPOINT(t."start_station_longitude", t."start_station_latitude"),
       TO_GEOGRAPHY(g_src."zip_code_geom"))
JOIN NEW_YORK_CITIBIKE_1.CYCLISTIC.ZIP_CODES           AS src_nbhd
  ON g_src."zip_code" = src_nbhd."zip"::TEXT
/* destination ZIP */
JOIN NEW_YORK_CITIBIKE_1.GEO_US_BOUNDARIES.ZIP_CODES AS g_dst
  ON ST_WITHIN(
       ST_MAKEPOINT(t."end_station_longitude", t."end_station_latitude"),
       TO_GEOGRAPHY(g_dst."zip_code_geom"))
JOIN NEW_YORK_CITIBIKE_1.CYCLISTIC.ZIP_CODES           AS dst_nbhd
  ON g_dst."zip_code" = dst_nbhd."zip"::TEXT
/* calendar‑year 2014 (timestamps are in micro‑seconds) */
WHERE t."starttime" BETWEEN 1388534400000000 AND 1420070399000000
GROUP BY 1, 2
LIMIT 20;
```
