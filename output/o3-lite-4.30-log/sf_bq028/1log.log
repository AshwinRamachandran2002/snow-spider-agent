{'DEPS_DEV_V1': {'DEPS_DEV_V1': ['PACKAGEVERSIONTOPROJECT', 'PROJECTS', 'NUGETREQUIREMENTS', 'DEPENDENCYGRAPHEDGES', 'PACKAGEVERSIONS', 'SNAPSHOTS', 'ADVISORIES', 'DEPENDENTS', 'PACKAGEVERSIONHASHES', 'DEPENDENCIES']}}
Begin Exploring Related Columns
Potentially useful columns and their purposes  
• PACKAGEVERSIONTOPROJECT."System": keep only NPM rows  
• PACKAGEVERSIONTOPROJECT."ProjectType": keep only GITHUB rows  
• PACKAGEVERSIONTOPROJECT."Name": package name to aggregate on  
• PACKAGEVERSIONTOPROJECT."Version": NPM version that maps to a GitHub repo  
• PACKAGEVERSIONTOPROJECT."ProjectName": GitHub repository full‑name, to join with PROJECTS  
• PACKAGEVERSIONTOPROJECT."SnapshotAt": pick the newest mapping if needed  
  
• PROJECTS."Type": keep only GITHUB rows  
• PROJECTS."StarsCount": popularity metric  
• PROJECTS."Name": GitHub repository full‑name, to join with PACKAGEVERSIONTOPROJECT  
• PROJECTS."SnapshotAt": pick the newest project snapshot if needed  
  
• PACKAGEVERSIONS."System": keep only NPM rows  
• PACKAGEVERSIONS."Name": package name  
• PACKAGEVERSIONS."Version": version string  
• PACKAGEVERSIONS."VersionInfo":"IsRelease": flag for release vs pre‑release  
• PACKAGEVERSIONS."VersionInfo":"Ordinal": helps pick the most recent version among releases  
• PACKAGEVERSIONS."SnapshotAt": pick the newest package snapshot if needed  

Typical conditions  
• WHERE "System" = 'NPM'  
• WHERE "ProjectType" = 'GITHUB' or  "Type" = 'GITHUB'  
• WHERE "VersionInfo":"IsRelease"::BOOLEAN = TRUE  
• Restrict to the last snapshot per table (e.g. use MAX("SnapshotAt"))  

Below are 10 exploratory Snowflake SQL queries (each limited to 20 rows) that move step‑by‑step from simple inspection to a final query able to list the eight most‑starred NPM packages (latest release only).  
Every column name is enclosed in double quotes and queries are annotated.

```sql
-- 1. Description: peek at rows that link NPM packages to GitHub repositories
SELECT *
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"
WHERE "System" = 'NPM'
  AND "ProjectType" = 'GITHUB'
LIMIT 20;
```

```sql
-- 2. Description: inspect VersionInfo to see the "IsRelease" flag & ordinal values
SELECT
  "Name",
  "Version",
  "VersionInfo":"IsRelease"::BOOLEAN AS "IsRelease",
  "VersionInfo":"Ordinal"::NUMBER  AS "Ordinal"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
WHERE "System" = 'NPM'
LIMIT 20;
```

```sql
-- 3. Description: list distinct GitHub repos with their star counts
SELECT DISTINCT
  "Name"           AS "Repo",
  "StarsCount"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"
WHERE "Type" = 'GITHUB'
ORDER BY "StarsCount" DESC
LIMIT 20;
```

```sql
-- 4. Description: join package→project mapping with GitHub projects to see stars per package+version
SELECT
  pvtp."Name"          AS "Package",
  pvtp."Version",
  proj."StarsCount",
  proj."Name"          AS "Repo"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"  pvtp
JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"                 proj
  ON proj."Name" = pvtp."ProjectName"
WHERE pvtp."System" = 'NPM'
  AND pvtp."ProjectType" = 'GITHUB'
  AND proj."Type" = 'GITHUB'
ORDER BY proj."StarsCount" DESC
LIMIT 20;
```

```sql
-- 5. Description: add release‑only filter by joining PACKAGEVERSIONS with its IsRelease flag
SELECT
  pvtp."Name"          AS "Package",
  pvtp."Version",
  proj."StarsCount",
  proj."Name"          AS "Repo"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"  pvtp
JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"          pv
  ON pv."Name" = pvtp."Name"
 AND pv."Version" = pvtp."Version"
 AND pv."System"  = 'NPM'
JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"                 proj
  ON proj."Name" = pvtp."ProjectName"
WHERE pvtp."System" = 'NPM'
  AND pvtp."ProjectType" = 'GITHUB'
  AND proj."Type" = 'GITHUB'
  AND pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE
ORDER BY proj."StarsCount" DESC
LIMIT 20;
```

```sql
-- 6. Description: pick the latest release version (highest ordinal) for each package
WITH latest_release AS (
  SELECT
    "Name",
    MAX("VersionInfo":"Ordinal"::NUMBER) AS "MaxOrdinal"
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
  WHERE "System" = 'NPM'
    AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
  GROUP BY "Name"
)
SELECT
  pv."Name"      AS "Package",
  pv."Version",
  pv."VersionInfo":"Ordinal"::NUMBER AS "Ordinal"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pv
JOIN latest_release lr
  ON lr."Name" = pv."Name"
 AND lr."MaxOrdinal" = pv."VersionInfo":"Ordinal"::NUMBER
WHERE pv."System" = 'NPM'
  AND pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE
LIMIT 20;
```

```sql
-- 7. Description: combine latest release (by ordinal) with repo stars
WITH latest_release AS (
  SELECT
    "Name",
    MAX("VersionInfo":"Ordinal"::NUMBER) AS "MaxOrdinal"
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
  WHERE "System" = 'NPM'
    AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
  GROUP BY "Name"
),
latest_versions AS (
  SELECT
    pv."Name",
    pv."Version"
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pv
  JOIN latest_release lr
    ON lr."Name" = pv."Name"
   AND lr."MaxOrdinal" = pv."VersionInfo":"Ordinal"::NUMBER
  WHERE pv."System" = 'NPM'
    AND pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE
)
SELECT
  lv."Name"                  AS "Package",
  lv."Version",
  proj."StarsCount",
  proj."Name"                AS "Repo"
FROM latest_versions                 lv
JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT" pvtp
  ON pvtp."Name"    = lv."Name"
 AND pvtp."Version" = lv."Version"
 AND pvtp."System"  = 'NPM'
JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS" proj
  ON proj."Name" = pvtp."ProjectName"
WHERE proj."Type" = 'GITHUB'
ORDER BY proj."StarsCount" DESC
LIMIT 20;
```

```sql
-- 8. Description: restrict to latest snapshot of PROJECTS to avoid duplicates
WITH latest_projects AS (
  SELECT
    "Name",
    MAX("SnapshotAt") AS "LatestSnap"
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"
  WHERE "Type" = 'GITHUB'
  GROUP BY "Name"
),
proj_stars AS (
  SELECT p.*
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS" p
  JOIN latest_projects lp
    ON lp."Name" = p."Name"
   AND lp."LatestSnap" = p."SnapshotAt"
),
latest_release AS (
  SELECT
    "Name",
    MAX("VersionInfo":"Ordinal"::NUMBER) AS "MaxOrdinal"
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
  WHERE "System" = 'NPM'
    AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
  GROUP BY "Name"
),
latest_versions AS (
  SELECT
    pv."Name",
    pv."Version"
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pv
  JOIN latest_release lr
    ON lr."Name" = pv."Name"
   AND lr."MaxOrdinal" = pv."VersionInfo":"Ordinal"::NUMBER
  WHERE pv."System" = 'NPM'
    AND pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE
)
SELECT
  lv."Name"          AS "Package",
  lv."Version",
  ps."StarsCount",
  ps."Name"          AS "Repo"
FROM latest_versions               lv
JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"  pvtp
  ON pvtp."Name"    = lv."Name"
 AND pvtp."Version" = lv."Version"
 AND pvtp."System"  = 'NPM'
JOIN proj_stars                    ps
  ON ps."Name" = pvtp."ProjectName"
ORDER BY ps."StarsCount" DESC
LIMIT 20;
```

```sql
-- 9. Description: apply DISTINCT to avoid duplicate package records before ranking
WITH latest_projects AS (
  SELECT
    "Name",
    MAX("SnapshotAt") AS "LatestSnap"
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"
  WHERE "Type" = 'GITHUB'
  GROUP BY "Name"
),
proj_stars AS (
  SELECT p."Name",
         p."StarsCount"
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS" p
  JOIN latest_projects lp
    ON lp."Name" = p."Name"
   AND lp."LatestSnap" = p."SnapshotAt"
),
latest_release AS (
  SELECT
    "Name",
    MAX("VersionInfo":"Ordinal"::NUMBER) AS "MaxOrdinal"
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
  WHERE "System" = 'NPM'
    AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
  GROUP BY "Name"
),
latest_versions AS (
  SELECT DISTINCT
    pv."Name",
    pv."Version"
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pv
  JOIN latest_release lr
    ON lr."Name" = pv."Name"
   AND lr."MaxOrdinal" = pv."VersionInfo":"Ordinal"::NUMBER
  WHERE pv."System" = 'NPM'
    AND pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE
)
SELECT DISTINCT
  lv."Name"          AS "Package",
  lv."Version",
  ps."StarsCount"
FROM latest_versions               lv
JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"  pvtp
  ON pvtp."Name"    = lv."Name"
 AND pvtp."Version" = lv."Version"
 AND pvtp."System"  = 'NPM'
JOIN proj_stars                    ps
  ON ps."Name" = pvtp."ProjectName"
ORDER BY ps."StarsCount" DESC
LIMIT 20;
```

