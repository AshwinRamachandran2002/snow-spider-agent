/* Top‑8 NPM packages (latest stable release only) ranked by GitHub stars */
WITH latest_release AS (          -- highest release‑ordinal for every NPM package
    SELECT
        "Name",
        MAX("VersionInfo":"Ordinal"::NUMBER) AS "MaxOrdinal"
    FROM  DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
    WHERE "System" = 'NPM'
      AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
      AND "Name" NOT LIKE '%>%'              -- ignore synthetic “pkg>a>b” names
    GROUP BY "Name"
),
latest_versions AS (              -- concrete version string that owns that ordinal
    SELECT
        pv."Name",
        pv."Version"
    FROM  DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv
    JOIN  latest_release lr
          ON  lr."Name"       = pv."Name"
         AND lr."MaxOrdinal"  = pv."VersionInfo":"Ordinal"::NUMBER
    WHERE pv."System" = 'NPM'
      AND pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE
),
latest_projects AS (              -- most‑recent snapshot for every GitHub repo
    SELECT
        "Name",
        MAX("SnapshotAt") AS "LatestSnap"
    FROM  DEPS_DEV_V1.DEPS_DEV_V1.PROJECTS
    WHERE "Type" = 'GITHUB'
    GROUP BY "Name"
),
project_stars AS (                -- star counts from that latest snapshot
    SELECT
        p."Name",
        p."StarsCount"
    FROM  DEPS_DEV_V1.DEPS_DEV_V1.PROJECTS p
    JOIN  latest_projects lp
          ON lp."Name"       = p."Name"
         AND lp."LatestSnap" = p."SnapshotAt"
    WHERE p."StarsCount" IS NOT NULL
),
pkg_repo AS (                     -- map package‑version → GitHub repo → stars
    SELECT
        lv."Name"        AS "Package",
        lv."Version",
        ps."StarsCount"
    FROM  latest_versions lv
    JOIN  DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT pvtp
          ON  pvtp."Name"    = lv."Name"
         AND pvtp."Version" = lv."Version"
