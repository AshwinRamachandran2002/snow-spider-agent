WITH latest_release AS (   -- one latest *official* release per NPM package
    SELECT
        "Name",
        "Version"
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
    WHERE "System" = 'NPM'
      AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY "Name"
        ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC
    ) = 1
),
latest_project AS (        -- freshest GitHub snapshot per repository
    SELECT
        "Name"    AS "ProjectName",
        "StarsCount"
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"
    WHERE "Type" = 'GITHUB'
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY "Name"
        ORDER BY "SnapshotAt" DESC
    ) = 1
),
joined AS (                -- link package → repo and attach star counts
    SELECT
        lr."Name"        AS package_name,
        lr."Version"     AS latest_version,
        lp."StarsCount"  AS github_stars
    FROM latest_release lr
    JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT" pvtp
      ON pvtp."System"      = 'NPM'
     AND pvtp."ProjectType" = 'GITHUB'
     AND pvtp."Name"        = lr."Name"
     AND pvtp."Version"     = lr."Version"
    JOIN latest_project lp
      ON lp."ProjectName"   = pvtp."ProjectName"
)
SELECT
    package_name,
    latest_version,
    github_stars
FROM joined
-- eliminate any duplicate mappings that may exist
QUALIFY ROW_NUMBER() OVER (
    PARTITION BY package_name
    ORDER BY github_stars DESC
) = 1
ORDER BY github_stars DESC NULLS LAST, package_name
LIMIT 8;
