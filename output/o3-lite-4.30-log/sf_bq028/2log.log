2025-05-01 01:59:26 - Thread-606 (execute) - INFO - [Exploration]
Relevant columns & their potential usage  
• PACKAGEVERSIONTOPROJECT."System":   keep only the NPM ecosystem.  
• PACKAGEVERSIONTOPROJECT."Name":     package name to be ranked.  
• PACKAGEVERSIONTOPROJECT."Version":  concrete version string.  
• PACKAGEVERSIONTOPROJECT."ProjectType":  keep only rows whose value is 'GITHUB'.  
• PACKAGEVERSIONTOPROJECT."ProjectName":  GitHub repository slug to join with PROJECTS.  
• PACKAGEVERSIONTOPROJECT."SnapshotAt":   optional – helps preferring the newest mapping.  

• PACKAGEVERSIONS."Name":          package name (to get one row‑per‑package).  
• PACKAGEVERSIONS."Version":       version string (will be the “latest release”).  
• PACKAGEVERSIONS."System":        filter NPM only.  
• PACKAGEVERSIONS."VersionInfo":   VARIANT that contains "IsRelease" and "Ordinal" – lets us keep only real releases and pick the highest ordinal (latest).  

• PROJECTS."Name":         GitHub repository slug (same value as "ProjectName").  
• PROJECTS."StarsCount":   popularity metric to rank by.  
• PROJECTS."SnapshotAt":   pick the freshest repository snapshot.  
• PROJECTS."Type":         make sure it is 'GITHUB'.  

Typical conditions  
• pv."System" = 'NPM'  
• pvtp."ProjectType" = 'GITHUB'  
• pvs."VersionInfo":"IsRelease"::BOOLEAN = TRUE  
• Use QUALIFY ROW_NUMBER() … ORDER BY pvs."VersionInfo":"Ordinal" DESC to keep latest release per package.  
• Use QUALIFY ROW_NUMBER() … ORDER BY pr."SnapshotAt" DESC to keep newest project snapshot.  

Below are ten exploratory ‑‑> final Snowflake SQL queries (each different, 20‑row limits added).  
All identifiers are double‑quoted and fully‑qualified.

```sql
-- 1) Description: peek at some mappings between NPM package versions and GitHub projects
SELECT *
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"
WHERE "System" = 'NPM'
LIMIT 20;
```

```sql
-- 2) Description: list distinct ecosystems present in PACKAGEVERSIONTOPROJECT
SELECT DISTINCT "System"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"
LIMIT 20;
```

```sql
-- 3) Description: count how many package→project links we have for the NPM system
SELECT COUNT(*) AS "RowsForNPM"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"
WHERE "System" = 'NPM';
```

```sql
-- 4) Description: explore GitHub projects and their star counts (latest snapshot per repo)
SELECT pr."Name",
       pr."StarsCount",
       pr."SnapshotAt"
FROM (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"
    WHERE "Type" = 'GITHUB'
) pr
WHERE rn = 1
ORDER BY pr."StarsCount" DESC
LIMIT 20;
```

```sql
-- 5) Description: sample NPM package versions that are marked as official releases
SELECT pvs."Name",
       pvs."Version",
       pvs."VersionInfo":"IsRelease"::BOOLEAN AS "IsRelease",
       pvs."VersionInfo":"Ordinal"::NUMBER   AS "Ordinal"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"  pvs
WHERE pvs."System" = 'NPM'
  AND pvs."VersionInfo":"IsRelease"::BOOLEAN = TRUE
LIMIT 20;
```

```sql
-- 6) Description: keep only the latest release (highest Ordinal) per NPM package
SELECT *
FROM (
    SELECT pvs.*,
           pvs."VersionInfo":"Ordinal"::NUMBER AS "Ordinal",
           ROW_NUMBER() OVER (PARTITION BY pvs."Name"
                              ORDER BY pvs."VersionInfo":"Ordinal"::NUMBER DESC) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pvs
    WHERE pvs."System" = 'NPM'
      AND pvs."VersionInfo":"IsRelease"::BOOLEAN = TRUE
) latest
WHERE rn = 1
LIMIT 20;
```

```sql
-- 7) Description: join latest‑release packages to their GitHub repository links
WITH latest_release AS (
    SELECT pvs."Name",
           pvs."Version",
           ROW_NUMBER() OVER (PARTITION BY pvs."Name"
                              ORDER BY pvs."VersionInfo":"Ordinal"::NUMBER DESC) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pvs
    WHERE pvs."System" = 'NPM'
      AND pvs."VersionInfo":"IsRelease"::BOOLEAN = TRUE
)
SELECT lr."Name"  AS "Package",
       lr."Version",
       pvtp."ProjectName",
       pvtp."ProjectType"
FROM latest_release   lr
JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT" pvtp
  ON  pvtp."System" = 'NPM'
  AND pvtp."Name"   = lr."Name"
  AND pvtp."Version"= lr."Version"
WHERE lr.rn = 1
  AND pvtp."ProjectType" = 'GITHUB'
LIMIT 20;
```

```sql
-- 8) Description: attach star counts (freshest repo snapshot) to latest releases
WITH latest_release AS (
    SELECT pvs."Name",
           pvs."Version",
           ROW_NUMBER() OVER (PARTITION BY pvs."Name"
                              ORDER BY pvs."VersionInfo":"Ordinal"::NUMBER DESC) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pvs
    WHERE pvs."System" = 'NPM'
      AND pvs."VersionInfo":"IsRelease"::BOOLEAN = TRUE
),
latest_projects AS (
    SELECT pr."Name"       AS "ProjectName",
           pr."StarsCount",
           ROW_NUMBER() OVER (PARTITION BY pr."Name" ORDER BY pr."SnapshotAt" DESC) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS" pr
    WHERE pr."Type" = 'GITHUB'
)
SELECT lr."Name"     AS "Package",
       lr."Version",
       lp."StarsCount"
FROM latest_release lr
JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT" pvtp
     ON pvtp."System" = 'NPM'
    AND pvtp."Name"   = lr."Name"
    AND pvtp."Version"= lr."Version"
JOIN latest_projects lp
     ON lp."ProjectName" = pvtp."ProjectName"
WHERE lr.rn = 1
  AND lp.rn = 1
ORDER BY lp."StarsCount" DESC
LIMIT 20;
```

```sql
-- 9) Description: show distribution of star counts among NPM packages (bucketed)
WITH ranked AS (
    -- (same sub-query as previous step)
    SELECT lr."Name",
           lr."Version",
           lp."StarsCount"
    FROM (
        SELECT pvs."Name",
               pvs."Version",
               ROW_NUMBER() OVER (PARTITION BY pvs."Name"
                                  ORDER BY pvs."VersionInfo":"Ordinal"::NUMBER DESC) AS rn
        FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pvs
        WHERE pvs."System" = 'NPM'
          AND pvs."VersionInfo":"IsRelease"::BOOLEAN = TRUE
    ) lr
    JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT" pvtp
         ON pvtp."System" = 'NPM'
        AND pvtp."Name"   = lr."Name"
        AND pvtp."Version"= lr."Version"
    JOIN (
        SELECT pr."Name",
               pr."StarsCount",
               ROW_NUMBER() OVER (PARTITION BY pr."Name" ORDER BY pr."SnapshotAt" DESC) AS rn
        FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS" pr
        WHERE pr."Type" = 'GITHUB'
    ) lp
         ON lp."Name" = pvtp."ProjectName"
    WHERE lr.rn = 1
      AND lp.rn = 1
)
SELECT
    CASE
        WHEN "StarsCount" >= 50000 THEN '50k+'
        WHEN "StarsCount" >= 10000 THEN '10k‑49,999'
        WHEN "StarsCount" >= 1000  THEN '1k‑9,999'
        ELSE '<1k'
    END AS "StarBucket",
    COUNT(*) AS "Packages"
FROM ranked
GROUP BY "StarBucket"
ORDER BY 2 DESC
LIMIT 20;
```

```sql
-- 10) Description: FINAL – top 8 most‑starred NPM packages (latest release only)
WITH latest_release AS (
    SELECT pvs."Name",
           pvs."Version",
           ROW_NUMBER() OVER (PARTITION BY pvs."Name"
                              ORDER BY pvs."VersionInfo":"Ordinal"::NUMBER DESC) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" pvs
    WHERE pvs."System" = 'NPM'
      AND pvs."VersionInfo":"IsRelease"::BOOLEAN = TRUE
),
latest_projects AS (
    SELECT pr."Name"       AS "ProjectName",
           pr."StarsCount",
           ROW_NUMBER() OVER (PARTITION BY pr."Name" ORDER BY pr."SnapshotAt" DESC) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS" pr
    WHERE pr."Type" = 'GITHUB'
)
SELECT lr."Name"   AS "Package",
       lr."Version",
       lp."StarsCount"
FROM latest_release lr
JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT" pvtp
     ON pvtp."System" = 'NPM'
    AND pvtp."Name"   = lr."Name"
    AND pvtp."Version"= lr."Version"
JOIN latest_projects lp
     ON lp."ProjectName" = pvtp."ProjectName"
WHERE lr.rn = 1
  AND lp.rn = 1
ORDER BY lp."StarsCount" DESC
LIMIT 8;
```

