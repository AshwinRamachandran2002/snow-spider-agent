WITH latest_release AS (   -- one latest *official* release per NPM package
    SELECT
        "Name",
        "Version"
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
    WHERE "System" = 'NPM'
      AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY "Name"
        ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC
    ) = 1
),
latest_project AS (        -- freshest GitHub snapshot per repository
    SELECT
        "Name"    AS "ProjectName",
        "StarsCount"
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"
    WHERE "Type" = 'GITHUB'
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY "Name"
        ORDER BY "SnapshotAt" DESC
    ) = 1
),
joined AS (                -- link package → repo and attach star counts
    SELECT
        lr."Name"        AS package_name,
        lr."Version"     AS latest_version,
