The table structure information is ({database name: {schema name: [table name]}}): 
{'DEPS_DEV_V1': {'DEPS_DEV_V1': ['PACKAGEVERSIONTOPROJECT', 'PROJECTS', 'NUGETREQUIREMENTS', 'DEPENDENCYGRAPHEDGES', 'PACKAGEVERSIONS', 'SNAPSHOTS', 'ADVISORIES', 'DEPENDENTS', 'PACKAGEVERSIONHASHES', 'DEPENDENCIES']}}
Begin Exploring Related Columns
Relevant columns and their potential usage  
• PACKAGEVERSIONTOPROJECT."System": limit to NPM packages  
• PACKAGEVERSIONTOPROJECT."Name" / "Version": the concrete package and specific version that appears in a GitHub project  
• PACKAGEVERSIONTOPROJECT."ProjectType": keep rows where the project really is on GitHub (='GITHUB')  
• PACKAGEVERSIONTOPROJECT."ProjectName": GitHub repo in the classic owner/repo format; can be joined to PROJECTS."Name"  
• PROJECTS."StarsCount": popularity metric requested in the task  
• PROJECTS."SnapshotAt": lets us keep only the most‑recent snapshot of the GitHub statistics  
• PACKAGEVERSIONS."VersionInfo": JSON; its key "IsRelease" tells whether the row is a release version (true) or e.g. a pre‑release  
• PACKAGEVERSIONS."Name", "Version", "System": to pick the newest release for each NPM package  
• SNAPSHOTS."Time": helps identify the latest snapshot timestamp for the various fact tables  

Typical conditions that may be used  
• PACKAGEVERSIONTOPROJECT."System" = 'NPM'  
• PACKAGEVERSIONTOPROJECT."ProjectType" = 'GITHUB'  
• PROJECTS."SnapshotAt" = (SELECT MAX("SnapshotAt") …) — keep latest repo stats  
• PACKAGEVERSIONS."VersionInfo":"IsRelease"::BOOLEAN = TRUE — keep only release versions  
• PACKAGEVERSIONS."SnapshotAt" = (SELECT MAX("SnapshotAt") …) — keep the newest version metadata  

Below are ten exploratory SQL statements (each LIMIT 20) that gradually build up to the final analytical query.  
All identifiers are enclosed in double quotes, comments start with “--”.

```sql
--1. Description: What package ecosystems appear in PACKAGEVERSIONTOPROJECT?
SELECT DISTINCT "System"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"
LIMIT 20;
```

```sql
--2. Description: Show a sample of NPM rows that map a package version to a GitHub repo.
SELECT *
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT"
WHERE "System" = 'NPM'
  AND "ProjectType" = 'GITHUB'
LIMIT 20;
```

```sql
--3. Description: Inspect recent GitHub snapshot rows (stars, forks, etc.).
SELECT *
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"
ORDER BY "SnapshotAt" DESC
LIMIT 20;
```

```sql
--4. Description: Grab the single most‑recent snapshot timestamp contained in PROJECTS.
SELECT MAX("SnapshotAt") AS "LatestProjectsSnapshot"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS";
```

```sql
--5. Description: Sample GitHub projects with their star counts from the latest snapshot only.
SELECT "Name", "StarsCount", "ForksCount"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"
WHERE "SnapshotAt" = (
    SELECT MAX("SnapshotAt") 
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"
)
ORDER BY "StarsCount" DESC
LIMIT 20;
```

```sql
--6. Description: Look at PACKAGEVERSIONS rows for NPM packages and expose the “IsRelease” flag.
SELECT "Name",
       "Version",
       "VersionInfo":"IsRelease"::BOOLEAN AS "IsRelease",
       "SnapshotAt"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
WHERE "System" = 'NPM'
LIMIT 20;
```

```sql
--7. Description: Verify that “IsRelease = TRUE” exists and fetch the newest snapshot for PACKAGEVERSIONS.
SELECT *
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
WHERE "System" = 'NPM'
  AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
ORDER BY "SnapshotAt" DESC
LIMIT 20;
```

```sql
--8. Description: For each NPM package, pick the newest release version (dense_rank() over SnapshotAt).
WITH latest_release AS (
    SELECT "Name",
           "Version",
           ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
    WHERE "System" = 'NPM'
      AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
)
SELECT *
FROM latest_release
WHERE rn = 1
LIMIT 20;
```

```sql
--9. Description: Join mappings (PACKAGEVERSIONTOPROJECT) with GitHub projects to get stars for each package version.
WITH latest_projects AS (
    SELECT *
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"
    WHERE "SnapshotAt" = (SELECT MAX("SnapshotAt") FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS")
)
SELECT pvt."Name"        AS "Package",
       pvt."Version",
       lp."Name"         AS "Repo",
       lp."StarsCount"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT" pvt
JOIN latest_projects lp
      ON lp."Name" = pvt."ProjectName"
WHERE pvt."System" = 'NPM'
  AND pvt."ProjectType" = 'GITHUB'
LIMIT 20;
```

```sql
--10. Description: Combine the newest release version per NPM package with its GitHub star count, then rank by popularity.
WITH latest_release AS (
    SELECT "Name",
           "Version",
           ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
    WHERE "System" = 'NPM'
      AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
),
latest_projects AS (
    SELECT *
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS"
    WHERE "SnapshotAt" = (SELECT MAX("SnapshotAt") FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PROJECTS")
),
pkg_repo AS (
    SELECT pvt."Name"  AS "Package",
           pvt."Version",
           pvt."ProjectName" AS "Repo"
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONTOPROJECT" pvt
    WHERE pvt."System" = 'NPM'
      AND pvt."ProjectType" = 'GITHUB'
)
SELECT lr."Name"          AS "Package",
       lr."Version",
       lp."StarsCount"
FROM latest_release lr
JOIN pkg_repo pr
      ON lr."Name" = pr."Package"  AND lr."Version" = pr."Version"
JOIN latest_projects lp
      ON lp."Name" = pr."Repo"
WHERE lr.rn = 1
ORDER BY lp."StarsCount" DESC
LIMIT 20;
```

