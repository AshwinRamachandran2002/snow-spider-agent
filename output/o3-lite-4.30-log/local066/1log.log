--Description: FINAL answer – net quantity of every ingredient actually used in delivered pizzas.
--Re‑implemented without generate_series by using a recursive splitter.
WITH delivered_orders AS (
    SELECT order_id
    FROM   pizza_clean_runner_orders
    WHERE  cancellation IS NULL
),
order_recipes AS (
    SELECT c.order_id,
           pr.toppings
    FROM   pizza_clean_customer_orders AS c
    JOIN   delivered_orders d USING(order_id)
    JOIN   pizza_recipes    pr USING(pizza_id)
),
-- Recursive CTE to split comma‑separated topping list into rows
split(order_id, topping_id, rest) AS (
    -- anchor: first token
    SELECT order_id,
           CAST(trim(substr(toppings || ',', 1,
                            instr(toppings || ',', ',') - 1)) AS INTEGER) AS topping_id,
           substr(toppings || ',', instr(toppings || ',', ',') + 1)        AS rest
    FROM   order_recipes
    UNION ALL
    -- recursive: peel the next token
    SELECT order_id,
           CAST(trim(substr(rest, 1,
                            instr(rest, ',') - 1)) AS INTEGER)             AS topping_id,
           substr(rest, instr(rest, ',') + 1)                              AS rest
    FROM   split
    WHERE  rest <> ''
),
recipe_qty AS (           -- +1 for each default recipe topping
    SELECT topping_id, COUNT(*) AS qty
    FROM   split
    GROUP  BY topping_id
),
extras_qty AS (           -- +extras_count for extras
    SELECT extras AS topping_id,
           SUM(extras_count) AS qty
    FROM   pizza_get_extras
    WHERE  order_id IN (SELECT order_id FROM delivered_orders)
    GROUP  BY extras
),
exclusions_qty AS (       -- –total_exclusions for exclusions
    SELECT exclusions AS topping_id,
          -SUM(total_exclusions) AS qty
    FROM   pizza_get_exclusions
    WHERE  order_id IN (SELECT order_id FROM delivered_orders)
    GROUP  BY exclusions
),
all_movements AS (
    SELECT * FROM recipe_qty
    UNION ALL
    SELECT * FROM extras_qty
    UNION ALL
    SELECT * FROM exclusions_qty
),
final_totals AS (
    SELECT topping_id,
           SUM(qty) AS total_quantity
    FROM   all_movements
    GROUP  BY topping_id
)
SELECT pt.topping_name AS ingredient,
       ft.total_quantity
FROM   final_totals ft
JOIN   pizza_toppings pt USING(topping_id)
ORDER  BY ft.total_quantity DESC
