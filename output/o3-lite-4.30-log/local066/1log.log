['pizza_names', 'companies_funding', 'pizza_customer_orders', 'pizza_toppings', 'trees', 'pizza_recipes', 'statistics', 'income_trees', 'pizza_clean_runner_orders', 'pizza_runner_orders', 'word_list', 'companies_dates', 'pizza_get_extras', 'pizza_get_exclusions', 'pizza_clean_customer_orders', 'companies_industries', 'pizza_runners']
Begin Exploring Related Columns
Relevant columns and possible use  
• pizza_clean_runner_orders.order_id – identify orders that were really delivered  
  – condition: cancellation IS NULL (i.e., not cancelled)  
• pizza_clean_customer_orders.order_id / pizza_clean_customer_orders.pizza_id – link each delivered order to its pizza recipe  
• pizza_recipes.pizza_id / pizza_recipes.toppings – list of default topping‑IDs for every pizza  
• pizza_toppings.topping_id / pizza_toppings.topping_name – turn every topping‑ID into a human readable ingredient name  
• pizza_get_extras.order_id / pizza_get_extras.extras / pizza_get_extras.extras_count – extra toppings a customer requested; add these quantities  
• pizza_get_exclusions.order_id / pizza_get_exclusions.exclusions / pizza_get_exclusions.total_exclusions – toppings a customer removed; subtract these quantities  

The core logic will therefore be:  
1. keep only the orders that were picked up (not cancelled)  
2. explode the comma‑separated toppings field so we get one row per (order, topping_id) coming from the pizza recipe  
3. add extra toppings rows (respecting extras_count)  
4. subtract the excluded toppings rows (respecting total_exclusions)  
5. aggregate everything by topping_id and convert to topping_name  

Below are ten exploratory SQL queries, from very simple inspections to the final all‑in‑one answer.  
(The queries use SQLite syntax; LIMIT 20 is added where the result could be long.)

```sql
-- 1.  Show a sample of runner records to check the cancellation flag
SELECT *
FROM pizza_clean_runner_orders
LIMIT 20;
```

```sql
-- 2.  List the distinct orders that were actually delivered
SELECT DISTINCT order_id
FROM pizza_clean_runner_orders
WHERE cancellation IS NULL
LIMIT 20;
```

```sql
-- 3.  See which pizzas were in those delivered orders
SELECT c.order_id,
       c.pizza_id
FROM   pizza_clean_customer_orders AS c
JOIN   pizza_clean_runner_orders  AS r
       ON r.order_id = c.order_id
WHERE  r.cancellation IS NULL
LIMIT 20;
```

```sql
-- 4.  Look at the raw recipe‑topping strings for the pizzas we delivered
SELECT DISTINCT c.pizza_id,
       pr.toppings
FROM   pizza_clean_customer_orders AS c
JOIN   pizza_clean_runner_orders  AS r  ON r.order_id = c.order_id
JOIN   pizza_recipes             AS pr ON pr.pizza_id = c.pizza_id
WHERE  r.cancellation IS NULL
LIMIT 20;
```

```sql
-- 5.  Inspect how extras are stored for delivered orders
SELECT *
FROM   pizza_get_extras
WHERE  order_id IN (
          SELECT order_id
          FROM   pizza_clean_runner_orders
          WHERE  cancellation IS NULL
       )
LIMIT 20;
```

```sql
-- 6.  Inspect how exclusions are stored for delivered orders
SELECT *
FROM   pizza_get_exclusions
WHERE  order_id IN (
          SELECT order_id
          FROM   pizza_clean_runner_orders
          WHERE  cancellation IS NULL
       )
LIMIT 20;
```

```sql
-- 7.  Count how many times each topping appears in the recipes
--     (ignoring extras / exclusions for the moment)
WITH delivered_orders AS (
    SELECT order_id
    FROM   pizza_clean_runner_orders
    WHERE  cancellation IS NULL
),
raw_pairs AS (
    -- split the comma list into rows; the replace/remove trick gets rid of the blanks
    SELECT c.order_id,
           CAST(trim(substr(
                pr.toppings,
                instr(pr.toppings || ',', ',') * (n-1) + 1,
                instr(substr(pr.toppings || ',', instr(pr.toppings || ',', ',')*(n-1)+1), ',')-1
           )) AS INTEGER) AS topping_id
    FROM  pizza_clean_customer_orders AS c
    JOIN  delivered_orders           AS d ON d.order_id = c.order_id
    JOIN  pizza_recipes              AS pr ON pr.pizza_id = c.pizza_id,
          generate_series(1, 20) AS n   -- 20 is wider than any pizza topping list length
    WHERE  n <= (length(pr.toppings) - length(replace(pr.toppings, ',', '')) + 1)
)
SELECT topping_id,
       COUNT(*) AS recipe_qty
FROM   raw_pairs
GROUP  BY topping_id
ORDER  BY recipe_qty DESC
LIMIT 20;
```

```sql
-- 8.  Count total extras for delivered orders
SELECT extras AS topping_id,
       SUM(extras_count) AS extras_qty
FROM   pizza_get_extras
WHERE  order_id IN (
          SELECT order_id
          FROM   pizza_clean_runner_orders
          WHERE  cancellation IS NULL
       )
GROUP BY extras
ORDER BY extras_qty DESC
LIMIT 20;
```

```sql
-- 9.  Count total exclusions for delivered orders
SELECT exclusions AS topping_id,
       SUM(total_exclusions) AS exclusion_qty
FROM   pizza_get_exclusions
WHERE  order_id IN (
          SELECT order_id
          FROM   pizza_clean_runner_orders
          WHERE  cancellation IS NULL
       )
GROUP BY exclusions
ORDER BY exclusion_qty DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER –
--     Total quantity of each ingredient actually used after
--     adding extras and subtracting exclusions
WITH delivered_orders AS (
    SELECT order_id
    FROM   pizza_clean_runner_orders
    WHERE  cancellation IS NULL
),

-- split the recipe topping list into rows
recipe_pairs AS (
    SELECT c.order_id,
           CAST(trim(substr(
                pr.toppings,
                instr(pr.toppings || ',', ',') * (n-1) + 1,
                instr(substr(pr.toppings || ',', instr(pr.toppings || ',', ',')*(n-1)+1), ',')-1
           )) AS INTEGER) AS topping_id,
           1 AS qty
    FROM  pizza_clean_customer_orders AS c
    JOIN  delivered_orders           AS d ON d.order_id = c.order_id
    JOIN  pizza_recipes              AS pr ON pr.pizza_id = c.pizza_id,
          generate_series(1, 20) AS n
    WHERE  n <= (length(pr.toppings) - length(replace(pr.toppings, ',', '')) + 1)
),

-- extras rows – positive quantities
extra_pairs AS (
    SELECT order_id,
           extras  AS topping_id,
           extras_count AS qty
    FROM   pizza_get_extras
    WHERE  order_id IN (SELECT order_id FROM delivered_orders)
),

-- exclusion rows – negative quantities
exclusion_pairs AS (
    SELECT order_id,
           exclusions        AS topping_id,
          -total_exclusions  AS qty          -- minus sign!
    FROM   pizza_get_exclusions
    WHERE  order_id IN (SELECT order_id FROM delivered_orders)
),

-- union everything together
all_movements AS (
    SELECT topping_id, qty FROM recipe_pairs
    UNION ALL
    SELECT topping_id, qty FROM extra_pairs
    UNION ALL
    SELECT topping_id, qty FROM exclusion_pairs
)

SELECT  pt.topping_name      AS ingredient,
        SUM(a.qty)           AS total_quantity
FROM    all_movements AS a
JOIN    pizza_toppings AS pt ON pt.topping_id = a.topping_id
GROUP   BY pt.topping_name
ORDER   BY total_quantity DESC;
```

The last query returns exactly the requested summary: one row per ingredient (topping_name) and the total number of units actually used in all pizzas we delivered, after applying customer‑specific extras and exclusions.
