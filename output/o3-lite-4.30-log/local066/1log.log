```sql
--Description / thinking process: 
--Goal: total quantity of each topping actually used in pizzas that were delivered.
--Plan, each step as a CTE:
--1) delivered_orders   – keep only orders whose runner record shows no cancellation.
--2) order_recipes      – attach every delivered order to its pizza’s recipe (comma list of topping IDs).
--3) split              – recursively de‑nest the comma list so we have one row per (order_id, topping_id); each counts +1.
--4) extras_qty         – extras table: sum extra toppings per topping_id (positive qty).
--5) exclusions_qty     – exclusions table: sum excluded toppings per topping_id (negative qty).
--6) movements          – union recipe rows, extras, exclusions → net movements.
--7) final_totals       – aggregate by topping_id, convert to topping_name, order by most used.
WITH delivered_orders AS (
    SELECT order_id
    FROM   pizza_clean_runner_orders
    WHERE  cancellation IS NULL
),
order_recipes AS (
    SELECT c.order_id,
           pr.toppings
    FROM   pizza_clean_customer_orders AS c
    JOIN   delivered_orders           d USING(order_id)
    JOIN   pizza_recipes              pr USING(pizza_id)
),
--recursive splitter: turns "1, 2, 3" → separate rows
split(order_id, topping_id, rest) AS (
    SELECT order_id,
           CAST(trim(substr(toppings || ',', 1,
                   instr(toppings || ',', ',') - 1)) AS INTEGER)  AS topping_id,
           substr(toppings || ',', instr(toppings || ',', ',')+1) AS rest
    FROM   order_recipes
    UNION ALL
    SELECT order_id,
           CAST(trim(substr(rest, 1,
                   instr(rest, ',') - 1)) AS INTEGER)             AS topping_id,
           substr(rest, instr(rest, ',') + 1)                    AS rest
    FROM   split
    WHERE  rest <> ''
),
recipe_qty AS (         -- +1 per default recipe topping
    SELECT topping_id, COUNT(*) AS qty
    FROM   split
    GROUP  BY topping_id
),
extras_qty AS (         -- +extras_count
    SELECT extras AS topping_id,
           SUM(extras_count) AS qty
    FROM   pizza_get_extras
    WHERE  order_id IN (SELECT order_id FROM delivered_orders)
    GROUP  BY extras
),
exclusions_qty AS (     -- -total_exclusions
    SELECT exclusions AS topping_id,
          -SUM(total_exclusions) AS qty
    FROM   pizza_get_exclusions
    WHERE  order_id IN (SELECT order_id FROM delivered_orders)
    GROUP  BY exclusions
),
movements AS (
    SELECT * FROM recipe_qty
    UNION ALL
    SELECT * FROM extras_qty
    UNION ALL
    SELECT * FROM exclusions_qty
),
final_totals AS (
    SELECT topping_id,
           SUM(qty) AS total_quantity
    FROM   movements
    GROUP  BY topping_id
)
SELECT pt.topping_name AS ingredient,
       ft.total_quantity
FROM   final_totals ft
JOIN   pizza_toppings pt USING(topping_id)
ORDER  BY ft.total_quantity DESC;
```
