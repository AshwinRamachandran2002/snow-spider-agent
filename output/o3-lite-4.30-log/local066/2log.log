Relevant tables / columns and why they matter  
• pizza_customer_orders.order_id : primary key to link each customer order  
• pizza_customer_orders.pizza_id : identifies the pizza that was ordered  
• pizza_runner_orders.order_id : lets us see which orders were actually delivered  
• pizza_runner_orders.cancellation : keep only rows where cancellation IS NULL (delivered orders)  
• pizza_recipes.pizza_id : joins to pizza_customer_orders so we can see which toppings belong to each pizza type  
• pizza_recipes.toppings : a comma‑separated list of topping_id values that appear on that pizza  
• pizza_toppings.topping_id : numeric code found inside pizza_recipes.toppings  
• pizza_toppings.topping_name : the human‑readable ingredient name we finally want to count  

(Everything else in the schema is irrelevant to “total quantity of each ingredient used in delivered pizzas”.)

Typical filter  
WHERE r.cancellation IS NULL          -- only finished deliveries  

–––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
Below are ten exploratory SQL statements (from very simple to the final answer).  
All statements use SQLite syntax, each description is written immediately above the query, and every query shows no more than 20 rows.

```sql
--1. Peek at the raw customer orders (first 20 rows)
SELECT *
FROM pizza_customer_orders
LIMIT 20;
```

```sql
--2. Which orders actually reached the customer (not cancelled)?
SELECT DISTINCT order_id
FROM pizza_runner_orders
WHERE cancellation IS NULL
LIMIT 20;
```

```sql
--3. See the pizza types that appear in delivered orders
SELECT DISTINCT c.pizza_id
FROM pizza_customer_orders  AS c
JOIN pizza_runner_orders    AS r USING (order_id)
WHERE r.cancellation IS NULL
LIMIT 20;
```

```sql
--4. Look up recipe strings for those pizza_ids
SELECT DISTINCT p.pizza_id,
       p.toppings
FROM   pizza_recipes         AS p
JOIN   pizza_customer_orders AS c USING (pizza_id)
JOIN   pizza_runner_orders   AS r USING (order_id)
WHERE  r.cancellation IS NULL
LIMIT 20;
```

```sql
--5. Display just one sample recipe split into individual topping_ids
WITH RECURSIVE split(id, rest, topping_id) AS (
    SELECT p.pizza_id,
           TRIM(p.toppings),                     -- full list
           CAST(substr(TRIM(p.toppings),1,
                instr(TRIM(p.toppings),',')-1) AS INTEGER)
    FROM pizza_recipes p
    WHERE p.pizza_id = 1                        -- sample pizza
  UNION ALL
    SELECT id,
           CASE WHEN instr(rest,',')=0 THEN ''
                ELSE substr(rest, instr(rest,',')+1) END,
           CAST(CASE WHEN instr(rest,',')=0
                     THEN rest
                     ELSE substr(rest,1,instr(rest,',')-1) END AS INTEGER)
    FROM split
    WHERE rest <> ''
)
SELECT topping_id
FROM split
WHERE topping_id IS NOT NULL
LIMIT 20;
```

```sql
--6. Translate a few topping_ids into names
SELECT t.topping_id,
       t.topping_name
FROM   pizza_toppings AS t
WHERE  t.topping_id IN (1,2,3,4,5,6)
LIMIT 20;
```

```sql
--7. Combine everything (delivered orders only) and list each topping for each order
WITH delivered AS (
    SELECT c.order_id, c.pizza_id
    FROM   pizza_customer_orders c
    JOIN   pizza_runner_orders   r USING (order_id)
    WHERE  r.cancellation IS NULL
),
recipe_split AS (
    --explode the comma list into rows
    WITH RECURSIVE split(order_id, topping_list, topping_id) AS (
        SELECT d.order_id,
               TRIM(pr.toppings),
               CAST(substr(TRIM(pr.toppings),1,
                    instr(TRIM(pr.toppings),',')-1) AS INTEGER)
        FROM   delivered d
        JOIN   pizza_recipes pr USING (pizza_id)
      UNION ALL
        SELECT order_id,
               CASE WHEN instr(topping_list,',')=0 THEN ''
                    ELSE substr(topping_list, instr(topping_list,',')+1) END,
               CAST(CASE WHEN instr(topping_list,',')=0
                         THEN topping_list
                         ELSE substr(topping_list,1,
                                     instr(topping_list,',')-1) END AS INTEGER)
        FROM   split
        WHERE  topping_list <> ''
    )
    SELECT order_id, topping_id
    FROM   split
    WHERE  topping_id IS NOT NULL
)
SELECT *
FROM   recipe_split
LIMIT 20;
```

```sql
--8. How many total toppings rows did we generate (sanity check)
WITH delivered AS (
    SELECT c.order_id, c.pizza_id
    FROM   pizza_customer_orders c
    JOIN   pizza_runner_orders   r USING (order_id)
    WHERE  r.cancellation IS NULL
),
recipe_split AS (
    -- same exploding logic as earlier
    WITH RECURSIVE split(order_id, topping_list, topping_id) AS (
        SELECT d.order_id,
               TRIM(pr.toppings),
               CAST(substr(TRIM(pr.toppings),1,
                    instr(TRIM(pr.toppings),',')-1) AS INTEGER)
        FROM   delivered d
        JOIN   pizza_recipes pr USING (pizza_id)
      UNION ALL
        SELECT order_id,
               CASE WHEN instr(topping_list,',')=0 THEN ''
                    ELSE substr(topping_list, instr(topping_list,',')+1) END,
               CAST(CASE WHEN instr(topping_list,',')=0
                         THEN topping_list
                         ELSE substr(topping_list,1,
                                     instr(topping_list,',')-1) END AS INTEGER)
        FROM   split
        WHERE  topping_list <> ''
    )
    SELECT topping_id
    FROM   split
    WHERE  topping_id IS NOT NULL
)
SELECT COUNT(*) AS total_topping_rows
FROM   recipe_split;
```

```sql
--9. Aggregate counts of each topping_id
WITH delivered AS (
    SELECT c.order_id, c.pizza_id
    FROM   pizza_customer_orders c
    JOIN   pizza_runner_orders   r USING (order_id)
    WHERE  r.cancellation IS NULL
),
recipe_split AS (
    -- explode lists into rows
    WITH RECURSIVE split(order_id, topping_list, topping_id) AS (
        SELECT d.order_id,
               TRIM(pr.toppings),
               CAST(substr(TRIM(pr.toppings),1,
                    instr(TRIM(pr.toppings),',')-1) AS INTEGER)
        FROM   delivered d
        JOIN   pizza_recipes pr USING (pizza_id)
      UNION ALL
        SELECT order_id,
               CASE WHEN instr(topping_list,',')=0 THEN ''
                    ELSE substr(topping_list, instr(topping_list,',')+1) END,
               CAST(CASE WHEN instr(topping_list,',')=0
                         THEN topping_list
                         ELSE substr(topping_list,1,
                                     instr(topping_list,',')-1) END AS INTEGER)
        FROM   split
        WHERE  topping_list <> ''
    )
    SELECT topping_id
    FROM   split
    WHERE  topping_id IS NOT NULL
)
SELECT topping_id,
       COUNT(*) AS uses
FROM   recipe_split
GROUP  BY topping_id
ORDER  BY uses DESC
LIMIT 20;
```

```sql
--10. FINAL ANSWER – ingredient names with total quantity used in delivered pizzas
WITH delivered AS (
    SELECT c.order_id, c.pizza_id
    FROM   pizza_customer_orders c
    JOIN   pizza_runner_orders   r USING (order_id)
    WHERE  r.cancellation IS NULL
),
recipe_split AS (
    -- explode topping lists for every delivered pizza
    WITH RECURSIVE split(order_id, topping_list, topping_id) AS (
        SELECT d.order_id,
               TRIM(pr.toppings),
               CAST(substr(TRIM(pr.toppings),1,
                    instr(TRIM(pr.toppings),',')-1) AS INTEGER)
        FROM   delivered d
        JOIN   pizza_recipes pr USING (pizza_id)
      UNION ALL
        SELECT order_id,
               CASE WHEN instr(topping_list,',')=0 THEN ''
                    ELSE substr(topping_list, instr(topping_list,',')+1) END,
               CAST(CASE WHEN instr(topping_list,',')=0
                         THEN topping_list
                         ELSE substr(topping_list,1,
                                     instr(topping_list,',')-1) END AS INTEGER)
        FROM   split
        WHERE  topping_list <> ''
    )
    SELECT topping_id
    FROM   split
    WHERE  topping_id IS NOT NULL
)
SELECT t.topping_name  AS ingredient,
       COUNT(*)        AS quantity
FROM   recipe_split   rs
JOIN   pizza_toppings t  USING (topping_id)
GROUP  BY t.topping_name
ORDER  BY quantity DESC
LIMIT 20;
```

Run the final query (10) to obtain the requested “ingredient name + total quantity used” summary for every topping appearing in delivered pizzas.
