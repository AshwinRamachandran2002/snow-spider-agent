WITH delivered AS (
    /* orders that were actually delivered (not cancelled) */
    SELECT c.order_id,
           c.pizza_id
    FROM   pizza_customer_orders  AS c
    JOIN   pizza_runner_orders    AS r
           ON r.order_id = c.order_id
    WHERE  r.cancellation IS NULL
),
/* break the comma‑separated recipe strings into one row per topping */
RECURSIVE split(order_id, rest, topping_id) AS (
    SELECT d.order_id,
           TRIM(pr.toppings)                                                       AS rest,
           CAST(                                /* first value in the list        */
                CASE WHEN instr(TRIM(pr.toppings),',') = 0
                     THEN TRIM(pr.toppings)
                     ELSE substr(TRIM(pr.toppings),1,instr(TRIM(pr.toppings),',')-1)
                END AS INTEGER)                                                   AS topping_id
    FROM   delivered        AS d
    JOIN   pizza_recipes    AS pr
           ON pr.pizza_id = d.pizza_id

    UNION ALL

    SELECT order_id,
           CASE WHEN instr(rest,',') = 0                     /* drop first element */
                THEN ''
                ELSE substr(rest, instr(rest,',') + 1)
           END                                               AS rest,
           CAST(                                             /* next element       */
                CASE WHEN instr(rest,',') = 0
                     THEN TRIM(rest)
                     ELSE substr(TRIM(rest),1,instr(TRIM(rest),',')-1)
                END AS INTEGER)                              AS topping_id
    FROM   split
    WHERE  rest <> ''
),
all_toppings AS (
    SELECT topping_id
    FROM   split
    WHERE  topping_id IS NOT NULL
)
SELECT t.topping_name  AS ingredient,
       COUNT(*)        AS total_quantity
FROM   all_toppings    at
JOIN   pizza_toppings  t  ON t.topping_id = at.topping_id
GROUP  BY t.topping_name
ORDER  BY total_quantity DESC;
```
