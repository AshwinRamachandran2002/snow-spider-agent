--9. Aggregate counts of each topping_id
WITH delivered AS (
    SELECT c.order_id, c.pizza_id
    FROM   pizza_customer_orders c
    JOIN   pizza_runner_orders   r USING (order_id)
    WHERE  r.cancellation IS NULL
),
recipe_split AS (
    -- explode lists into rows
    WITH RECURSIVE split(order_id, topping_list, topping_id) AS (
        SELECT d.order_id,
               TRIM(pr.toppings),
               CAST(substr(TRIM(pr.toppings),1,
                    instr(TRIM(pr.toppings),',')-1) AS INTEGER)
        FROM   delivered d
        JOIN   pizza_recipes pr USING (pizza_id)
      UNION ALL
        SELECT order_id,
               CASE WHEN instr(topping_list,',')=0 THEN ''
                    ELSE substr(topping_list, instr(topping_list,',')+1) END,
               CAST(CASE WHEN instr(topping_list,',')=0
                         THEN topping_list
                         ELSE substr(topping_list,1,
                                     instr(topping_list,',')-1) END AS INTEGER)
        FROM   split
        WHERE  topping_list <> ''
    )
    SELECT topping_id
    FROM   split
    WHERE  topping_id IS NOT NULL
)
SELECT topping_id,
       COUNT(*) AS uses
FROM   recipe_split
GROUP  BY topping_id
ORDER  BY uses DESC
LIMIT 20;
