--Description: Count how many ForkEvent, IssuesEvent, and WatchEvent records each repo received
--             in April 2022.  The created_at field is stored in micro‑seconds, therefore we use
--             1648771200×1e6 .. 1651363199×1e6.  Return the top‑20 repos by event count.
SELECT 
       t."repo":"name"::STRING AS "repo_name",
       COUNT(*)               AS "april_2022_event_count"
FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022" t
WHERE  t."type" IN ('ForkEvent', 'IssuesEvent', 'WatchEvent')
  AND  t."created_at" BETWEEN 1648771200000000   -- 2022‑04‑01 00:00:00 UTC
                          AND 1651363199000000   -- 2022‑04‑30 23:59:59 UTC
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20
