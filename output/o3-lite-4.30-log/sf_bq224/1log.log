--Description: Final query — find the single repository that has an approved license and achieved
--             the highest combined total of forks, issues, and watches during April 2022.
SELECT 
       e."repo_name",
       SUM(e."event_cnt") AS "total_april_2022_events"
FROM (
      SELECT 
             t."repo":"name"::STRING AS "repo_name",
             COUNT(*)                AS "event_cnt"
      FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022" t
      WHERE  t."type" IN ('ForkEvent', 'IssuesEvent', 'WatchEvent')
        AND  t."created_at" BETWEEN 1648771200000000   -- 2022‑04‑01
                               AND 1651363199000000   -- 2022‑04‑30
      GROUP BY 1
     ) e
JOIN "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LICENSES" l
  ON e."repo_name" = l."repo_name"
WHERE l."license" IN ('mit','apache-2.0','gpl-3.0','bsd-3-clause','epl-2.0')  -- extend to full approved list
GROUP BY 1
ORDER BY 2 DESC
LIMIT 1
