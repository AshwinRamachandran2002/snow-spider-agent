--             whose license is on an (example) approved list.  Show the top‑20 by total events.
SELECT 
       e."repo_name",
       SUM(e."event_cnt") AS "total_april_2022_events"
FROM (
      SELECT 
             t."repo":"name"::STRING AS "repo_name",
             COUNT(*)                AS "event_cnt"
      FROM   "GITHUB_REPOS_DATE"."YEAR"."_2022" t
      WHERE  t."type" IN ('ForkEvent', 'IssuesEvent', 'WatchEvent')
        AND  t."created_at" BETWEEN 1648771200000000   -- 2022‑04‑01
                               AND 1651363199000000   -- 2022‑04‑30
      GROUP BY 1
     ) e
