```sql
-- Thinking process:
-- • We need April‑2022 activity, so restrict created_at to micro‑second epoch range for that month.
-- • The YEAR."_2022" table stores every GitHub event for 2022; keep only ForkEvent, IssuesEvent, WatchEvent.
-- • Extract repo name from the VARIANT column "repo":"name".
-- • Aggregate counts of each event type per repo (CTE apr22).
-- • Join to LICENSES so we keep only repos that actually have a recorded license.
-- • Filter license strings to those approved in licenses.md (apache, mit, gpl, bsd, mpl, epl) using
--   case‑insensitive REGEXP_LIKE.
-- • Compute total_activity = forks + issues + watches.
-- • Order descending and LIMIT 20 to see the top repositories.
WITH apr22 AS (
    SELECT
        "repo":"name"::STRING                                   AS "repo_name",
        SUM(CASE WHEN "type" = 'ForkEvent'   THEN 1 ELSE 0 END) AS "forks",
        SUM(CASE WHEN "type" = 'IssuesEvent' THEN 1 ELSE 0 END) AS "issues",
        SUM(CASE WHEN "type" = 'WatchEvent'  THEN 1 ELSE 0 END) AS "watches"
    FROM "GITHUB_REPOS_DATE"."YEAR"."_2022"
    WHERE "type" IN ('ForkEvent','IssuesEvent','WatchEvent')
      AND "created_at" BETWEEN 1648771200000000   -- 2022‑04‑01 00:00:00 µs
                           AND 1651363199000000   -- 2022‑04‑30 23:59:59 µs
    GROUP BY 1
)
SELECT
    a."repo_name",
    a."forks",
    a."issues",
    a."watches",
    (a."forks" + a."issues" + a."watches") AS "total_activity",
    l."license"
FROM apr22                                         a
JOIN "GITHUB_REPOS_DATE"."GITHUB_REPOS"."LICENSES" l
  ON a."repo_name" = l."repo_name"
WHERE REGEXP_LIKE(l."license", '(apache|mit|gpl|bsd|mpl|epl)', 'i')
ORDER BY "total_activity" DESC
LIMIT 20;
```
