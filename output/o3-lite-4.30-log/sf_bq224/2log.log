```sql
-- 5. Description:  Count how many different event kinds occurred in April 2022.
SELECT t."type",
       COUNT(*) AS "event_count"
FROM GITHUB_REPOS_DATE.YEAR."_2022" t
WHERE DATE_FROM_PARTS(1970,1,1) + t."created_at"/86400 BETWEEN '2022-04-01' AND '2022-04-30'
GROUP BY t."type"
ORDER BY "event_count" DESC
LIMIT 20;
```

```sql
-- 6. Description:  List 20 ForkEvents in April 2022 and the affected repository.
SELECT
       f.value:"name"::STRING AS "repo_name",
       t."created_at"
FROM GITHUB_REPOS_DATE.YEAR."_2022" t,
     LATERAL FLATTEN(input => ARRAY_CONSTRUCT(t."repo")) f
WHERE t."type" = 'ForkEvent'
  AND DATE_FROM_PARTS(1970,1,1) + t."created_at"/86400 BETWEEN '2022-04-01' AND '2022-04-30'
LIMIT 20;
```

```sql
-- 7. Description:  Aggregate April 2022 ForkEvents, WatchEvents, and IssuesEvents per repo.
SELECT
       f.value:"name"::STRING AS "repo_name",
       COUNT_IF(t."type" = 'ForkEvent')   AS "forks",
       COUNT_IF(t."type" = 'WatchEvent')  AS "watches",
       COUNT_IF(t."type" = 'IssuesEvent') AS "issues"
FROM GITHUB_REPOS_DATE.YEAR."_2022" t,
     LATERAL FLATTEN(input => ARRAY_CONSTRUCT(t."repo")) f
WHERE t."type" IN ('ForkEvent','WatchEvent','IssuesEvent')
  AND DATE_FROM_PARTS(1970,1,1) + t."created_at"/86400 BETWEEN '2022-04-01' AND '2022-04-30'
GROUP BY "repo_name"
LIMIT 20;
```

```sql
-- 8. Description:  Same as #7 but joined with LICENSES to keep only licensed repos.
WITH april AS (
  SELECT
         f.value:"name"::STRING AS "repo_name",
         t."type"
  FROM GITHUB_REPOS_DATE.YEAR."_2022" t,
       LATERAL FLATTEN(input => ARRAY_CONSTRUCT(t."repo")) f
  WHERE t."type" IN ('ForkEvent','WatchEvent','IssuesEvent')
    AND DATE_FROM_PARTS(1970,1,1) + t."created_at"/86400 BETWEEN '2022-04-01' AND '2022-04-30'
)
SELECT
       a."repo_name",
       SUM(CASE WHEN a."type"='ForkEvent'   THEN 1 ELSE 0 END) AS "forks",
       SUM(CASE WHEN a."type"='WatchEvent'  THEN 1 ELSE 0 END) AS "watches",
       SUM(CASE WHEN a."type"='IssuesEvent' THEN 1 ELSE 0 END) AS "issues"
FROM april a
JOIN GITHUB_REPOS_DATE.GITHUB_REPOS.LICENSES l
  ON a."repo_name" = l."repo_name"
GROUP BY a."repo_name"
LIMIT 20;
```

```sql
-- 9. Description:  Include license string and total engagement (fork+watch+issue) for April 2022.
WITH april AS (
  SELECT
         f.value:"name"::STRING AS "repo_name",
         t."type"
  FROM GITHUB_REPOS_DATE.YEAR."_2022" t,
       LATERAL FLATTEN(input => ARRAY_CONSTRUCT(t."repo")) f
  WHERE t."type" IN ('ForkEvent','WatchEvent','IssuesEvent')
    AND DATE_FROM_PARTS(1970,1,1) + t."created_at"/86400 BETWEEN '2022-04-01' AND '2022-04-30'
)
SELECT
       a."repo_name",
       l."license",
       COUNT(*) AS "total_events"
FROM april a
JOIN GITHUB_REPOS_DATE.GITHUB_REPOS.LICENSES l
  ON a."repo_name" = l."repo_name"
GROUP BY a."repo_name", l."license"
ORDER BY "total_events" DESC
LIMIT 20;
```

```sql
-- 10. Description:  Retrieve the single repository (with approved license) having the highest
--      combined total of forks, issues, and watches in April 2022.
WITH april AS (
  SELECT
         f.value:"name"::STRING AS "repo_name",
         t."type"
  FROM GITHUB_REPOS_DATE.YEAR."_2022" t,
       LATERAL FLATTEN(input => ARRAY_CONSTRUCT(t."repo")) f
  WHERE t."type" IN ('ForkEvent','WatchEvent','IssuesEvent')
    AND DATE_FROM_PARTS(1970,1,1) + t."created_at"/86400 BETWEEN '2022-04-01' AND '2022-04-30'
),
agg AS (
  SELECT
         a."repo_name",
         COUNT(*) AS "total_events"
  FROM april a
  JOIN GITHUB_REPOS_DATE.GITHUB_REPOS.LICENSES l
    ON a."repo_name" = l."repo_name"
  -- add any explicit “approved” license list if desired, e.g. WHERE l."license" IN (...)
  GROUP BY a."repo_name"
)
SELECT *
FROM agg
ORDER BY "total_events" DESC
LIMIT 20;
```

