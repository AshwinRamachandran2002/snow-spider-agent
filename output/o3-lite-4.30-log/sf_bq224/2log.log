--Description:  #6 – List 20 ForkEvents that occurred in April 2022 and show the affected repository plus the event time.
SELECT
       f.value:"name"::STRING                                   AS "repo_name",
       TO_TIMESTAMP_NTZ(t."created_at" / 1000000)              AS "event_time"
FROM GITHUB_REPOS_DATE.YEAR."_2022" t,
     LATERAL FLATTEN(input => ARRAY_CONSTRUCT(t."repo")) f
WHERE t."type" = 'ForkEvent'
  AND TO_DATE(TO_TIMESTAMP_NTZ(t."created_at" / 1000000))
      BETWEEN '2022-04-01' AND '2022-04-30'
LIMIT 20
